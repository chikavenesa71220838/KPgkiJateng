// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  namaUser  String   @default("")
  emailUser String   @unique @default("")
  password  String?
  googleId  String   @unique @default("")
  role      String?  @default("jemaat")
  profile   Profile? @relation("Profile_user")
}

model Profile {
  id                   String  @id @default(cuid())
  alamat               String  @default("")
  nomorWa              String  @default("")
  jenisKelamin         String?
  pendidikan           String  @default("")
  pekerjaan            String  @default("")
  tanggalLahir         String  @default("")
  statusPernikahan     String?
  domisili             String  @default("")
  statusKeanggotaan    String?
  fotoProfil_id        String?
  fotoProfil_filesize  Int?
  fotoProfil_width     Int?
  fotoProfil_height    Int?
  fotoProfil_extension String?
  user                 User?   @relation("Profile_user", fields: [userId], references: [id])
  userId               String? @unique @map("user")
}

model KategoriWarta {
  id    String  @id @default(cuid())
  nama  String  @unique @default("")
  warta Warta[] @relation("Warta_kategori")
}

model Warta {
  id                 String         @id @default(cuid())
  kategori           KategoriWarta? @relation("Warta_kategori", fields: [kategoriId], references: [id])
  kategoriId         String?        @map("kategori")
  judul              String         @default("")
  masaBerlaku        String?
  tanggalPelaksanaan DateTime?
  isiWarta           String         @default("")
  file_filesize      Int?
  file_filename      String?
  createdAt          DateTime?      @default(now())

  @@index([kategoriId])
}

model Pengkhotbah {
  id             String         @id @default(cuid())
  foto_id        String?
  foto_filesize  Int?
  foto_width     Int?
  foto_height    Int?
  foto_extension String?
  nama           String         @default("")
  kontak         String         @default("")
  detailIbadah   DetailIbadah[] @relation("DetailIbadah_pengkhotbah")
}

model JadwalIbadah {
  id           String         @id @default(cuid())
  tanggal      String
  topik        String         @default("")
  detailIbadah DetailIbadah[] @relation("DetailIbadah_jadwal")
}

model DetailIbadah {
  id               String        @id @default(cuid())
  jam              String        @default("")
  pengkhotbah      Pengkhotbah?  @relation("DetailIbadah_pengkhotbah", fields: [pengkhotbahId], references: [id])
  pengkhotbahId    String?       @map("pengkhotbah")
  banner_id        String?
  banner_filesize  Int?
  banner_width     Int?
  banner_height    Int?
  banner_extension String?
  jadwal           JadwalIbadah? @relation("DetailIbadah_jadwal", fields: [jadwalId], references: [id])
  jadwalId         String?       @map("jadwal")

  @@index([pengkhotbahId])
  @@index([jadwalId])
}

model AyatHarian {
  id      String   @id @default(cuid())
  book    String   @default("")
  chapter String   @default("")
  verse   String   @default("")
  text    String   @default("")
  tanggal DateTime @default(now())
}

model Pendeta {
  id              String  @id @default(cuid())
  foto_id         String?
  foto_filesize   Int?
  foto_width      Int?
  foto_height     Int?
  foto_extension  String?
  nama            String  @default("")
  email           String  @unique @default("")
  kontak          String  @default("")
  sejakKapanAktif String
  gereja          Gereja? @relation("Pendeta_gereja", fields: [gerejaId], references: [id])
  gerejaId        String? @map("gereja")

  @@index([gerejaId])
}

model Gereja {
  id               String    @id @default(cuid())
  gambar_id        String?
  gambar_filesize  Int?
  gambar_width     Int?
  gambar_height    Int?
  gambar_extension String?
  nama             String    @default("")
  alamat           String    @default("")
  operational      String    @default("")
  telepon          String    @default("")
  linkWhatsapp     String    @default("")
  linkInstagram    String    @default("")
  linkYoutube      String    @default("")
  linkFacebook     String    @default("")
  linkEmail        String    @default("")
  sejarah          String    @default("")
  pendeta          Pendeta[] @relation("Pendeta_gereja")
}
