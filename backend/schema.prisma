// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  namaUser  String   @default("")
  emailUser String   @unique @default("")
  googleId  String   @unique @default("")
  role      String?  @default("jemaat")
  profile   Profile? @relation("Profile_user")
}

model Profile {
  id     String  @id @default(cuid())
  alamat String  @default("")
  noHp   String  @default("")
  user   User?   @relation("Profile_user", fields: [userId], references: [id])
  userId String? @unique @map("user")
}

model Warta {
  id                 String    @id @default(cuid())
  kategori           String    @default("")
  judul              String    @default("")
  masaBerlaku        DateTime
  tanggalPelaksanaan DateTime
  file_filesize      Int?
  file_filename      String?
  createdAt          DateTime? @default(now())
}

model JadwalIbadah {
  id           String         @id @default(cuid())
  tanggal      String
  topik        String         @default("")
  detailIbadah DetailIbadah[] @relation("DetailIbadah_jadwal")
}

model DetailIbadah {
  id               String        @id @default(cuid())
  jam              String        @default("")
  pengkhotbah      String        @default("")
  banner_id        String?
  banner_filesize  Int?
  banner_width     Int?
  banner_height    Int?
  banner_extension String?
  jadwal           JadwalIbadah? @relation("DetailIbadah_jadwal", fields: [jadwalId], references: [id])
  jadwalId         String?       @map("jadwal")

  @@index([jadwalId])
}
