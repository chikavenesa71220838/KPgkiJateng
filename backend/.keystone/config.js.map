   "ayat": 77,
   "firman": "dan untuk korban keselamatan dua ekor lembu, lima ekor domba jantan, lima ekor kambing jantan dan lima ekor domba berumur setahun. Itulah persembahan Pagiel bin Okhran."
 },
 {
   "id": 3930,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 78,
   "firman": "Pada hari kedua belas: pemimpin bani Naftali, Ahira bin Enan."
 },
 {
   "id": 3931,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 79,
   "firman": "Persembahannya ialah satu pinggan perak, seratus tiga puluh syikal timbangannya, dan satu bokor penyiraman dari perak, tujuh puluh syikal beratnya, ditimbang menurut syikal kudus, keduanya berisi tepung yang terbaik, diolah dengan minyak, untuk korban sajian;"
 },
 {
   "id": 3932,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 80,
   "firman": "satu cawan, sepuluh syikal emas beratnya, berisi ukupan;"
 },
 {
   "id": 3933,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 81,
   "firman": "seekor lembu jantan muda, seekor domba jantan dan seekor domba berumur setahun, untuk korban bakaran;"
 },
 {
   "id": 3934,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 82,
   "firman": "seekor kambing jantan untuk korban penghapus dosa;"
 },
 {
   "id": 3935,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 83,
   "firman": "dan untuk korban keselamatan dua ekor lembu, lima ekor domba jantan, lima ekor kambing jantan dan lima ekor domba berumur setahun. Itulah persembahan Ahira bin Enan."
 },
 {
   "id": 3936,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 84,
   "firman": "Itulah persembahan pentahbisan mezbah pada hari mezbah itu diurapi, dari pihak para pemimpin Israel, yaitu dua belas pinggan perak, dua belas bokor penyiraman dari perak, dua belas cawan emas."
 },
 {
   "id": 3937,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 85,
   "firman": "Beratnya tiap-tiap pinggan adalah seratus tiga puluh syikal perak, dan beratnya tiap-tiap bokor penyiraman adalah tujuh puluh syikal; segala perak perkakas-perkakas itu ada dua ribu empat ratus syikal beratnya, ditimbang menurut syikal kudus."
 },
 {
   "id": 3938,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 86,
   "firman": "Selanjutnya dua belas cawan emas berisi ukupan, tiap-tiap cawan sepuluh syikal beratnya, ditimbang menurut syikal kudus; segala emas cawan itu ada seratus dua puluh syikal beratnya."
 },
 {
   "id": 3939,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 87,
   "firman": "Segala hewan untuk korban bakaran itu ialah dua belas ekor lembu jantan, dua belas ekor domba jantan, dua belas ekor domba berumur setahun, dengan korban sajiannya; juga dua belas ekor kambing jantan untuk korban penghapus dosa."
 },
 {
   "id": 3940,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 88,
   "firman": "Segala hewan korban keselamatan itu ialah dua puluh empat ekor lembu jantan, enam puluh ekor domba jantan, enam puluh ekor kambing jantan, enam puluh ekor domba berumur setahun. Itulah persembahan pentahbisan mezbah, sesudah mezbah itu diurapi."
 },
 {
   "id": 3941,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 89,
   "firman": "Apabila Musa masuk ke dalam Kemah Pertemuan untuk berbicara dengan Dia, maka ia mendengar suara yang berfirman kepadanya dari atas tutup pendamaian, yang di atas tabut hukum Allah, dari antara kedua kerub itu; demikianlah Ia berfirman kepadanya."
 },
 {
   "id": 3942,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3943,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada Harun dan katakanlah kepadanya: Apabila engkau memasang lampu-lampu itu, haruslah ketujuh lampu itu menerangi yang di sebelah depan kandil.\""
 },
 {
   "id": 3944,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 3,
   "firman": "Demikianlah diperbuat Harun. Di sebelah depan kandil dipasangnyalah lampu-lampunya, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3945,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 4,
   "firman": "Dan beginilah kandil itu dibuat: dari emas tempaan; kandil itu tempaan, baik kakinya maupun kembangnya; sesuai dengan apa yang telah diperlihatkan TUHAN kepada Musa, demikianlah kandil itu dibuatnya."
 },
 {
   "id": 3946,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 5,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3947,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 6,
   "firman": "\"Ambillah orang Lewi dari tengah-tengah orang Israel dan tahirkanlah mereka."
 },
 {
   "id": 3948,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 7,
   "firman": "Beginilah harus kaulakukan kepada mereka untuk mentahirkan mereka: percikkanlah kepada mereka air penghapus dosa, kemudian haruslah mereka mencukur seluruh tubuhnya dan mencuci pakaiannya dan dengan demikian mentahirkan dirinya."
 },
 {
   "id": 3949,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 8,
   "firman": "Sesudah itu haruslah mereka mengambil seekor lembu jantan muda dengan korban sajiannya dari tepung yang terbaik, diolah dengan minyak, juga seekor lembu jantan muda yang lain haruslah kauambil untuk korban penghapus dosa."
 },
 {
   "id": 3950,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 9,
   "firman": "Selanjutnya haruslah kausuruh orang Lewi mendekat ke depan Kemah Pertemuan, dan kaupanggil berkumpul segenap umat Israel."
 },
 {
   "id": 3951,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 10,
   "firman": "Apabila engkau telah menyuruh orang Lewi mendekat ke hadapan TUHAN, maka haruslah orang Israel meletakkan tangannya atas orang Lewi itu,"
 },
 {
   "id": 3952,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 11,
   "firman": "dan Harun harus mengunjukkan orang Lewi itu sebagai persembahan unjukan dari antara orang Israel di hadapan TUHAN, dan demikianlah mereka diuntukkan melakukan pekerjaan jabatannya bagi TUHAN."
 },
 {
   "id": 3953,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 12,
   "firman": "Setelah orang Lewi meletakkan tangannya atas kepala lembu-lembu jantan muda itu, maka haruslah yang seekor diolah sebagai korban penghapus dosa dan yang lain sebagai korban bakaran bagi TUHAN untuk mengadakan pendamaian bagi orang Lewi."
 },
 {
   "id": 3954,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 13,
   "firman": "Maka haruslah engkau menghadapkan orang Lewi kepada Harun dengan anak-anaknya dan mengunjukkan mereka sebagai persembahan unjukan bagi TUHAN."
 },
 {
   "id": 3955,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 14,
   "firman": "Demikianlah harus engkau mentahirkan mereka dari tengah-tengah orang Israel, supaya orang Lewi itu menjadi kepunyaan-Ku."
 },
 {
   "id": 3956,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 15,
   "firman": "Barulah sesudah itu orang Lewi boleh masuk untuk melakukan pekerjaan jabatannya pada Kemah Pertemuan, sesudah engkau mentahirkan mereka dan mengunjukkan mereka sebagai persembahan unjukan."
 },
 {
   "id": 3957,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 16,
   "firman": "Sebab mereka harus diserahkan dengan sepenuhnya kepada-Ku dari tengah-tengah orang Israel; ganti semua yang terdahulu lahir dari kandungan, yakni semua anak sulung yang ada pada orang Israel, telah Kuambil mereka bagi-Ku."
 },
 {
   "id": 3958,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 17,
   "firman": "Sebab semua anak sulung yang ada pada orang Israel, baik dari manusia maupun dari hewan, adalah kepunyaan-Ku; pada waktu Aku membunuh semua anak sulung di tanah Mesir, Aku telah menguduskan semuanya bagi-Ku."
 },
 {
   "id": 3959,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 18,
   "firman": "Maka Aku mengambil orang Lewi ganti semua anak sulung yang ada pada orang Israel,"
 },
 {
   "id": 3960,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 19,
   "firman": "dan Aku menyerahkan orang Lewi dari tengah-tengah orang Israel sebagai pemberian kepada Harun dan anak-anaknya untuk melakukan segala pekerjaan jabatan bagi orang Israel di Kemah Pertemuan, dan untuk mengadakan pendamaian bagi orang Israel, supaya orang Israel jangan kena tulah apabila mereka mendekat ke tempat kudus.\""
 },
 {
   "id": 3961,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 20,
   "firman": "Lalu Musa, Harun dan segenap umat Israel melakukan yang demikian kepada orang Lewi; tepat seperti yang diperintahkan TUHAN kepada Musa mengenai orang Lewi, demikianlah dilakukan orang Israel kepada mereka."
 },
 {
   "id": 3962,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 21,
   "firman": "Orang Lewi itu menghapus dosa dari dirinya dan mencuci pakaian mereka, kemudian Harun mengunjukkan mereka sebagai persembahan unjukan di hadapan TUHAN, dan mengadakan pendamaian bagi mereka sambil mentahirkan mereka."
 },
 {
   "id": 3963,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 22,
   "firman": "Sesudah itu masuklah orang Lewi untuk melakukan pekerjaan jabatan mereka di Kemah Pertemuan, di bawah pengawasan Harun dan anak-anaknya. Seperti yang diperintahkan TUHAN kepada Musa mengenai orang Lewi, demikianlah dilakukan kepada mereka."
 },
 {
   "id": 3964,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 23,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3965,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 24,
   "firman": "\"Inilah yang berlaku bagi orang Lewi: setiap orang yang berumur dua puluh lima tahun ke atas wajib bertugas, supaya ia bekerja pada Kemah Pertemuan,"
 },
 {
   "id": 3966,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 25,
   "firman": "tetapi jika ia berumur lima puluh tahun haruslah ia dibebaskan dari pekerjaan itu, sehingga tak usah ia bekerja lebih lama lagi."
 },
 {
   "id": 3967,
   "kitab": "Bil",
   "pasal": 8,
   "ayat": 26,
   "firman": "Ia boleh membantu saudara-saudaranya di Kemah Pertemuan dalam menjalankan tugas mereka, tetapi tidak usah lagi ia menjabat pekerjaan itu. Demikianlah harus kaulakukan kepada orang Lewi mengenai tugas mereka.\""
 },
 {
   "id": 3968,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa di padang gurun Sinai, pada bulan yang pertama tahun yang kedua sesudah mereka keluar dari tanah Mesir:"
 },
 {
   "id": 3969,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 2,
   "firman": "\"Orang Israel harus merayakan Paskah pada waktunya;"
 },
 {
   "id": 3970,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 3,
   "firman": "pada hari yang keempat belas bulan ini, pada waktu senja, haruslah kamu merayakannya pada waktu yang ditetapkan, menurut segala ketetapan dan peraturannya haruslah kamu merayakannya.\""
 },
 {
   "id": 3971,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 4,
   "firman": "Lalu Musa menyuruh orang Israel merayakan Paskah."
 },
 {
   "id": 3972,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 5,
   "firman": "Maka mereka merayakan Paskah pada bulan yang pertama, pada hari yang keempat belas bulan itu, pada waktu senja, di padang gurun Sinai; tepat seperti yang diperintahkan TUHAN kepada Musa, demikianlah dilakukan orang Israel."
 },
 {
   "id": 3973,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 6,
   "firman": "Tetapi ada beberapa orang yang najis oleh karena mayat, sehingga tidak dapat merayakan Paskah pada hari itu. Mereka datang menghadap Musa dan Harun pada hari itu juga,"
 },
 {
   "id": 3974,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 7,
   "firman": "lalu berkata kepadanya: \"Sungguhpun kami najis oleh karena mayat, dengan dasar apakah kami dicegah mempersembahkan persembahan bagi TUHAN di tengah-tengah orang Israel pada waktu yang ditetapkan?\""
 },
 {
   "id": 3975,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 8,
   "firman": "Lalu jawab Musa kepada mereka: \"Tunggulah dahulu, aku hendak mendengar apa yang akan diperintahkan TUHAN mengenai kamu.\""
 },
 {
   "id": 3976,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 9,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 3977,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 10,
   "firman": "\"Katakanlah kepada orang Israel: Apabila salah seorang di antara kamu atau keturunanmu najis oleh karena mayat, atau berada dalam perjalanan jauh, maka ia harus juga merayakan Paskah bagi TUHAN."
 },
 {
   "id": 3978,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 11,
   "firman": "Pada bulan yang kedua, pada hari yang keempat belas, pada waktu senja, haruslah orang-orang itu merayakannya; beserta roti yang tidak beragi dan sayur pahit haruslah mereka memakannya."
 },
 {
   "id": 3979,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 12,
   "firman": "Janganlah mereka meninggalkan sebagian dari padanya sampai pagi, dan satu tulangpun tidak boleh dipatahkan mereka. Menurut segala ketetapan Paskah haruslah mereka merayakannya."
 },
 {
   "id": 3980,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 13,
   "firman": "Sebaliknya orang yang tidak najis, dan tidak dalam perjalanan, tetapi lalai merayakan Paskah, orang itu harus dilenyapkan dari antara orang-orang sebangsanya, sebab ia tidak mempersembahkan persembahan yang kepada TUHAN pada waktunya; orang itu akan menanggung akibat dosanya."
 },
 {
   "id": 3981,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 14,
   "firman": "Apabila seorang asing yang telah menetap padamu hendak merayakan Paskah bagi TUHAN, maka haruslah ia merayakannya menurut segala ketetapan dan peraturan Paskah. Satu ketetapan harus berlaku bagi kamu, baik bagi orang asing maupun bagi orang Israel asli.\""
 },
 {
   "id": 3982,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 15,
   "firman": "Pada hari didirikan Kemah Suci, maka awan itu menutupi Kemah Suci, kemah hukum Allah; dan pada waktu malam sampai pagi awan itu ada di atas Kemah Suci, kelihatan seperti api."
 },
 {
   "id": 3983,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 16,
   "firman": "Demikianlah selalu terjadi: awan itu menutupi Kemah, dan pada waktu malam kelihatan seperti api."
 },
 {
   "id": 3984,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 17,
   "firman": "Dan setiap kali awan itu naik dari atas Kemah, maka orang Israelpun berangkatlah, dan di tempat awan itu diam, di sanalah orang Israel berkemah."
 },
 {
   "id": 3985,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 18,
   "firman": "Atas titah TUHAN orang Israel berangkat dan atas titah TUHAN juga mereka berkemah; selama awan itu diam di atas Kemah Suci, mereka tetap berkemah."
 },
 {
   "id": 3986,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 19,
   "firman": "Apabila awan itu lama tinggal di atas Kemah Suci, maka orang Israel memelihara kewajibannya kepada TUHAN, dan tidaklah mereka berangkat."
 },
 {
   "id": 3987,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 20,
   "firman": "Ada kalanya awan itu hanya tinggal beberapa hari di atas Kemah Suci; maka atas titah TUHAN mereka berkemah dan atas titah TUHAN juga mereka berangkat."
 },
 {
   "id": 3988,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 21,
   "firman": "Ada kalanya awan itu tinggal dari petang sampai pagi; ketika awan itu naik pada waktu pagi, merekapun berangkatlah; baik pada waktu siang baik pada waktu malam, apabila awan itu naik, merekapun berangkatlah."
 },
 {
   "id": 3989,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 22,
   "firman": "Berapa lamapun juga awan itu diam di atas Kemah Suci, baik dua hari, baik sebulan atau lebih lama, maka orang Israel tetap berkemah dan tidak berangkat; tetapi apabila awan itu naik, barulah mereka berangkat."
 },
 {
   "id": 3990,
   "kitab": "Bil",
   "pasal": 9,
   "ayat": 23,
   "firman": "Atas titah TUHAN mereka berkemah dan atas titah TUHAN juga mereka berangkat; mereka memelihara kewajibannya kepada TUHAN, menurut titah TUHAN dengan perantaraan Musa."
 },
 {
   "id": 3991,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3992,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 2,
   "firman": "\"Buatlah dua nafiri dari perak. Dari perak tempaan harus kaubuat itu, supaya dipergunakan untuk memanggil umat Israel dan untuk menyuruh laskar-laskarnya berangkat."
 },
 {
   "id": 3993,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 3,
   "firman": "Apabila kedua nafiri itu ditiup, segenap umat itu harus berkumpul kepadamu di depan pintu Kemah Pertemuan."
 },
 {
   "id": 3994,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 4,
   "firman": "Jikalau hanya satu saja ditiup, maka para pemimpin, para kepala pasukan Israel harus berkumpul kepadamu."
 },
 {
   "id": 3995,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 5,
   "firman": "Apabila kamu meniup tanda semboyan, maka haruslah berangkat laskar-laskar yang berkemah di sebelah timur;"
 },
 {
   "id": 3996,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 6,
   "firman": "apabila kamu meniup tanda semboyan kedua kalinya, maka haruslah berangkat laskar-laskar yang berkemah di sebelah selatan. Jadi tanda semboyan harus ditiup untuk menyuruh mereka berangkat;"
 },
 {
   "id": 3997,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 7,
   "firman": "tetapi untuk menyuruh jemaah itu berkumpul kamu harus meniup saja tanpa memberi tanda semboyan."
 },
 {
   "id": 3998,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 8,
   "firman": "Nafiri-nafiri itu harus ditiup oleh anak-anak imam Harun; itulah yang harus menjadi ketetapan untuk selama-lamanya bagimu turun-temurun."
 },
 {
   "id": 3999,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 9,
   "firman": "Dan apabila kamu maju berperang di negerimu melawan musuh yang menyesakkan kamu, kamu harus memberi tanda semboyan dengan nafiri, supaya kamu diingat di hadapan TUHAN, Allahmu, dan diselamatkan dari pada musuhmu."
 },
 {
   "id": 4000,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 10,
   "firman": "Juga pada hari-hari kamu bersukaria, pada perayaan-perayaanmu dan pada bulan-bulan barumu haruslah kamu meniup nafiri itu pada waktu mempersembahkan korban-korban bakaranmu dan korban-korban keselamatanmu; maksudnya supaya kamu diingat di hadapan Allahmu; Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 4001,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 11,
   "firman": "Pada tahun yang kedua, pada bulan yang kedua, pada tanggal dua puluh bulan itu, naiklah awan itu dari atas Kemah Suci, tempat hukum Allah."
 },
 {
   "id": 4002,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lalu berangkatlah orang Israel dari padang gurun Sinai menurut aturan keberangkatan mereka, kemudian diamlah awan itu di padang gurun Paran."
 },
 {
   "id": 4003,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 13,
   "firman": "Itulah pertama kali mereka berangkat menurut titah TUHAN dengan perantaraan Musa."
 },
 {
   "id": 4004,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 14,
   "firman": "Terdahulu berangkatlah laskar yang di bawah panji-panji bani Yehuda menurut pasukan mereka; yang mengepalai laskar itu ialah Nahason bin Aminadab;"
 },
 {
   "id": 4005,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 15,
   "firman": "yang mengepalai laskar suku bani Isakhar ialah Netaneel bin Zuar;"
 },
 {
   "id": 4006,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 16,
   "firman": "yang mengepalai laskar suku bani Zebulon ialah Eliab bin Helon."
 },
 {
   "id": 4007,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 17,
   "firman": "Sesudah itu Kemah Suci dibongkar, dan berangkatlah bani Gerson dan bani Merari yang mengangkat Kemah Suci itu."
 },
 {
   "id": 4008,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 18,
   "firman": "Kemudian berangkatlah laskar yang di bawah panji-panji Ruben menurut pasukan mereka; yang mengepalai laskar itu ialah Elizur bin Syedeur;"
 },
 {
   "id": 4009,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 19,
   "firman": "yang mengepalai laskar suku bani Simeon ialah Selumiel bin Zurisyadai;"
 },
 {
   "id": 4010,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 20,
   "firman": "yang mengepalai laskar suku bani Gad ialah Elyasaf bin Rehuel."
 },
 {
   "id": 4011,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 21,
   "firman": "Sesudah itu berangkatlah orang Kehat, yang mengangkat barang-barang tempat kudus; Kemah Suci sudah dipasang sebelum mereka datang."
 },
 {
   "id": 4012,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 22,
   "firman": "Kemudian berangkatlah laskar yang di bawah panji-panji bani Efraim menurut pasukan mereka;"
 },
 {
   "id": 4013,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 23,
   "firman": "yang mengepalai laskar itu ialah Elisama bin Amihud; yang mengepalai laskar suku bani Manasye ialah Gamaliel bin Pedazur;"
 },
 {
   "id": 4014,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 24,
   "firman": "yang mengepalai laskar suku bani Benyamin ialah Abidan bin Gideoni."
 },
 {
   "id": 4015,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 25,
   "firman": "Sebagai barisan penutup semua laskar itu berangkatlah laskar yang di bawah panji-panji bani Dan menurut pasukan mereka; yang mengepalai laskar itu ialah Ahiezer bin Amisyadai;"
 },
 {
   "id": 4016,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 26,
   "firman": "yang mengepalai laskar suku bani Asyer ialah Pagiel bin Okhran;"
 },
 {
   "id": 4017,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 27,
   "firman": "yang mengepalai laskar suku bani Naftali ialah Ahira bin Enan."
 },
 {
   "id": 4018,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 28,
   "firman": "Itulah aturan keberangkatan orang Israel menurut pasukan mereka, ketika mereka berangkat."
 },
 {
   "id": 4019,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 29,
   "firman": "Lalu berkatalah Musa kepada Hobab anak Rehuel orang Midian, mertua Musa: \"Kami berangkat ke tempat yang dimaksud TUHAN ketika Ia berfirman: Aku akan memberikannya kepadamu. Sebab itu ikutlah bersama-sama dengan kami, maka kami akan berbuat baik kepadamu, sebab TUHAN telah menjanjikan yang baik tentang Israel.\""
 },
 {
   "id": 4020,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 30,
   "firman": "Tetapi jawabnya kepada Musa: \"Aku tidak ikut, melainkan aku hendak pergi ke negeriku dan kepada sanak saudaraku.\""
 },
 {
   "id": 4021,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 31,
   "firman": "Kata Musa: \"Janganlah kiranya tinggalkan kami, sebab engkaulah yang tahu, bagaimana kami berkemah di padang gurun, maka engkau dapat menjadi penunjuk jalan bagi kami."
 },
 {
   "id": 4022,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 32,
   "firman": "Jika engkau ikut bersama-sama dengan kami, maka kebaikan yang akan dilakukan TUHAN kepada kami akan kami lakukan juga kepadamu.\""
 },
 {
   "id": 4023,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 33,
   "firman": "Lalu berangkatlah mereka dari gunung TUHAN dan berjalan tiga hari perjalanan jauhnya, sedang tabut perjanjian TUHAN berangkat di depan mereka dan berjalan tiga hari perjalanan jauhnya untuk mencari tempat perhentian bagi mereka."
 },
 {
   "id": 4024,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 34,
   "firman": "Dan awan TUHAN ada di atas mereka pada siang hari, apabila mereka berangkat dari tempat perkemahan."
 },
 {
   "id": 4025,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 35,
   "firman": "Apabila tabut itu berangkat, berkatalah Musa: \"Bangkitlah, TUHAN, supaya musuh-Mu berserak dan orang-orang yang membenci Engkau melarikan diri dari hadapan-Mu.\""
 },
 {
   "id": 4026,
   "kitab": "Bil",
   "pasal": 10,
   "ayat": 36,
   "firman": "Dan apabila tabut itu berhenti, berkatalah ia: \"Kembalilah, TUHAN, kepada umat Israel yang beribu-ribu laksa ini.\""
 },
 {
   "id": 4027,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 1,
   "firman": "Pada suatu kali bangsa itu bersungut-sungut di hadapan TUHAN tentang nasib buruk mereka, dan ketika TUHAN mendengarnya bangkitlah murka-Nya, kemudian menyalalah api TUHAN di antara mereka dan merajalela di tepi tempat perkemahan."
 },
 {
   "id": 4028,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 2,
   "firman": "Lalu berteriaklah bangsa itu kepada Musa, dan Musa berdoa kepada TUHAN; maka padamlah api itu."
 },
 {
   "id": 4029,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 3,
   "firman": "Sebab itu orang menamai tempat itu Tabera, karena telah menyala api TUHAN di antara mereka."
 },
 {
   "id": 4030,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 4,
   "firman": "Orang-orang bajingan yang ada di antara mereka kemasukan nafsu rakus; dan orang Israelpun menangislah pula serta berkata: \"Siapakah yang akan memberi kita makan daging?"
 },
 {
   "id": 4031,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 5,
   "firman": "Kita teringat kepada ikan yang kita makan di Mesir dengan tidak bayar apa-apa, kepada mentimun dan semangka, bawang prei, bawang merah dan bawang putih."
 },
 {
   "id": 4032,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 6,
   "firman": "Tetapi sekarang kita kurus kering, tidak ada sesuatu apapun, kecuali manna ini saja yang kita lihat.\""
 },
 {
   "id": 4033,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 7,
   "firman": "Adapun manna itu seperti ketumbar dan kelihatannya seperti damar bedolah."
 },
 {
   "id": 4034,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 8,
   "firman": "Bangsa itu berlari kian ke mari untuk memungutnya, lalu menggilingnya dengan batu kilangan atau menumbuknya dalam lumpang. Mereka memasaknya dalam periuk dan membuatnya menjadi roti bundar; rasanya seperti rasa panganan yang digoreng."
 },
 {
   "id": 4035,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dan apabila embun turun di tempat perkemahan pada waktu malam, maka turunlah juga manna di situ."
 },
 {
   "id": 4036,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 10,
   "firman": "Ketika Musa mendengar bangsa itu, yaitu orang-orang dari setiap kaum, menangis di depan pintu kemahnya, bangkitlah murka TUHAN dengan sangat, dan hal itu dipandang jahat oleh Musa."
 },
 {
   "id": 4037,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 11,
   "firman": "Lalu berkatalah Musa kepada TUHAN: \"Mengapa Kauperlakukan hamba-Mu ini dengan buruk dan mengapa aku tidak mendapat kasih karunia di mata-Mu, sehingga Engkau membebankan kepadaku tanggung jawab atas seluruh bangsa ini?"
 },
 {
   "id": 4038,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 12,
   "firman": "Akukah yang mengandung seluruh bangsa ini atau akukah yang melahirkannya, sehingga Engkau berkata kepadaku: Pangkulah dia seperti pak pengasuh memangku anak yang menyusu, berjalan ke tanah yang Kaujanjikan dengan bersumpah kepada nenek moyangnya?"
 },
 {
   "id": 4039,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 13,
   "firman": "Dari manakah aku mengambil daging untuk diberikan kepada seluruh bangsa ini? Sebab mereka menangis kepadaku dengan berkata: Berilah kami daging untuk dimakan."
 },
 {
   "id": 4040,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 14,
   "firman": "Aku seorang diri tidak dapat memikul tanggung jawab atas seluruh bangsa ini, sebab terlalu berat bagiku."
 },
 {
   "id": 4041,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 15,
   "firman": "Jika Engkau berlaku demikian kepadaku, sebaiknya Engkau membunuh aku saja, jika aku mendapat kasih karunia di mata-Mu, supaya aku tidak harus melihat celakaku.\""
 },
 {
   "id": 4042,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 16,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa: \"Kumpulkanlah di hadapan-Ku dari antara para tua-tua Israel tujuh puluh orang, yang kauketahui menjadi tua-tua bangsa dan pengatur pasukannya, kemudian bawalah mereka ke Kemah Pertemuan, supaya mereka berdiri di sana bersama-sama dengan engkau."
 },
 {
   "id": 4043,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 17,
   "firman": "Maka Aku akan turun dan berbicara dengan engkau di sana, lalu sebagian dari Roh yang hinggap padamu itu akan Kuambil dan Kutaruh atas mereka, maka mereka bersama-sama dengan engkau akan memikul tanggung jawab atas bangsa itu, jadi tidak usah lagi engkau seorang diri memikulnya."
 },
 {
   "id": 4044,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 18,
   "firman": "Tetapi kepada bangsa itu haruslah kaukatakan: Kuduskanlah dirimu untuk besok, maka kamu akan makan daging; sebab kamu telah menangis di hadapan TUHAN dengan berkata: Siapakah yang akan memberi kami makan daging? Begitu baik keadaan kita di Mesir, bukan? --TUHAN akan memberi kamu daging untuk dimakan."
 },
 {
   "id": 4045,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 19,
   "firman": "Bukan hanya satu hari kamu akan memakannya, bukan dua hari, bukan lima hari, bukan sepuluh hari, bukan dua puluh hari,"
 },
 {
   "id": 4046,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 20,
   "firman": "tetapi genap sebulan lamanya, sampai keluar dari dalam hidungmu dan sampai kamu muak--karena kamu telah menolak TUHAN yang ada di tengah-tengah kamu dan menangis di hadapan-Nya dengan berkata: Untuk apakah kita keluar dari Mesir?\""
 },
 {
   "id": 4047,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 21,
   "firman": "Tetapi kata Musa: \"Bangsa yang ada bersama aku ini berjumlah enam ratus ribu orang berjalan kaki, namun Engkau berfirman: Daging akan Kuberikan kepada mereka, dan genap sebulan lamanya mereka akan memakannya!"
 },
 {
   "id": 4048,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 22,
   "firman": "Dapatkah sekian banyak kambing domba dan lembu sapi disembelih bagi mereka, sehingga mereka mendapat cukup? Atau dapatkah ditangkap segala ikan di laut bagi mereka, sehingga mereka mendapat cukup?\""
 },
 {
   "id": 4049,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 23,
   "firman": "Tetapi TUHAN menjawab Musa: \"Masakan kuasa TUHAN akan kurang untuk melakukan itu? Sekarang engkau akan melihat apakah firman-Ku terjadi kepadamu atau tidak!\""
 },
 {
   "id": 4050,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 24,
   "firman": "Setelah Musa datang ke luar, disampaikannya firman TUHAN itu kepada bangsa itu. Ia mengumpulkan tujuh puluh orang dari para tua-tua bangsa itu dan menyuruh mereka berdiri di sekeliling kemah."
 },
 {
   "id": 4051,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 25,
   "firman": "Lalu turunlah TUHAN dalam awan dan berbicara kepada Musa, kemudian diambil-Nya sebagian dari Roh yang hinggap padanya, dan ditaruh-Nya atas ketujuh puluh tua-tua itu; ketika Roh itu hinggap pada mereka, kepenuhanlah mereka seperti nabi, tetapi sesudah itu tidak lagi."
 },
 {
   "id": 4052,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 26,
   "firman": "Masih ada dua orang tinggal di tempat perkemahan; yang seorang bernama Eldad, yang lain bernama Medad. Ketika Roh itu hinggap pada mereka--mereka itu termasuk orang-orang yang dicatat, tetapi tidak turut pergi ke kemah--maka kepenuhanlah mereka seperti nabi di tempat perkemahan."
 },
 {
   "id": 4053,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 27,
   "firman": "Lalu berlarilah seorang muda memberitahukan kepada Musa: \"Eldad dan Medad kepenuhan seperti nabi di tempat perkemahan.\""
 },
 {
   "id": 4054,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 28,
   "firman": "Maka menjawablah Yosua bin Nun, yang sejak mudanya menjadi abdi Musa: \"Tuanku Musa, cegahlah mereka!\""
 },
 {
   "id": 4055,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 29,
   "firman": "Tetapi Musa berkata kepadanya: \"Apakah engkau begitu giat mendukung diriku? Ah, kalau seluruh umat TUHAN menjadi nabi, oleh karena TUHAN memberi Roh-Nya hinggap kepada mereka!\""
 },
 {
   "id": 4056,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 30,
   "firman": "Kemudian kembalilah Musa ke tempat perkemahan, dia dan para tua-tua Israel."
 },
 {
   "id": 4057,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 31,
   "firman": "Lalu bertiuplah angin yang dari TUHAN asalnya; dibawanyalah burung-burung puyuh dari sebelah laut, dan dihamburkannya ke atas tempat perkemahan dan di sekelilingnya, kira-kira sehari perjalanan jauhnya ke segala penjuru, dan kira-kira dua hasta tingginya dari atas muka bumi."
 },
 {
   "id": 4058,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 32,
   "firman": "Lalu sepanjang hari dan sepanjang malam itu dan sepanjang hari esoknya bangkitlah bangsa itu mengumpulkan burung-burung puyuh itu--setiap orang sedikit-dikitnya mengumpulkan sepuluh homer--,kemudian mereka menyebarkannya lebar-lebar sekeliling tempat perkemahan."
 },
 {
   "id": 4059,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 33,
   "firman": "Selagi daging itu ada di mulut mereka, sebelum dikunyah, maka bangkitlah murka TUHAN terhadap bangsa itu dan TUHAN memukul bangsa itu dengan suatu tulah yang sangat besar."
 },
 {
   "id": 4060,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 34,
   "firman": "Sebab itu dinamailah tempat itu Kibrot-Taawa, karena di sanalah dikuburkan orang-orang yang bernafsu rakus."
 },
 {
   "id": 4061,
   "kitab": "Bil",
   "pasal": 11,
   "ayat": 35,
   "firman": "Dari Kibrot-Taawa berangkatlah bangsa itu ke Hazerot dan mereka tinggal di situ."
 },
 {
   "id": 4062,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 1,
   "firman": "Miryam serta Harun mengatai Musa berkenaan dengan perempuan Kush yang diambilnya, sebab memang ia telah mengambil seorang perempuan Kush."
 },
 {
   "id": 4063,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 2,
   "firman": "Kata mereka: \"Sungguhkah TUHAN berfirman dengan perantaraan Musa saja? Bukankah dengan perantaraan kita juga Ia berfirman?\" Dan kedengaranlah hal itu kepada TUHAN."
 },
 {
   "id": 4064,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 3,
   "firman": "Adapun Musa ialah seorang yang sangat lembut hatinya, lebih dari setiap manusia yang di atas muka bumi."
 },
 {
   "id": 4065,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 4,
   "firman": "Lalu berfirmanlah TUHAN dengan tiba-tiba kepada Musa, Harun dan Miryam: \"Keluarlah kamu bertiga ke Kemah Pertemuan.\" Maka keluarlah mereka bertiga."
 },
 {
   "id": 4066,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 5,
   "firman": "Lalu turunlah TUHAN dalam tiang awan, dan berdiri di pintu kemah itu, lalu memanggil Harun dan Miryam; maka tampillah mereka keduanya."
 },
 {
   "id": 4067,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 6,
   "firman": "Lalu berfirmanlah Ia: \"Dengarlah firman-Ku ini. Jika di antara kamu ada seorang nabi, maka Aku, TUHAN menyatakan diri-Ku kepadanya dalam penglihatan, Aku berbicara dengan dia dalam mimpi."
 },
 {
   "id": 4068,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 7,
   "firman": "Bukan demikian hamba-Ku Musa, seorang yang setia dalam segenap rumah-Ku."
 },
 {
   "id": 4069,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 8,
   "firman": "Berhadap-hadapan Aku berbicara dengan dia, terus terang, bukan dengan teka-teki, dan ia memandang rupa TUHAN. Mengapakah kamu tidak takut mengatai hamba-Ku Musa?\""
 },
 {
   "id": 4070,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 9,
   "firman": "Sebab itu bangkitlah murka TUHAN terhadap mereka, lalu pergilah Ia."
 },
 {
   "id": 4071,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 10,
   "firman": "Dan ketika awan telah naik dari atas kemah, maka tampaklah Miryam kena kusta, putih seperti salju; ketika Harun berpaling kepada Miryam, maka dilihatnya, bahwa dia kena kusta!"
 },
 {
   "id": 4072,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 11,
   "firman": "Lalu kata Harun kepada Musa: \"Ah tuanku, janganlah kiranya timpakan kepada kami dosa ini, yang kami perbuat dalam kebodohan kami."
 },
 {
   "id": 4073,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 12,
   "firman": "Janganlah kiranya dibiarkan dia sebagai anak gugur, yang pada waktu keluar dari kandungan ibunya sudah setengah busuk dagingnya.\""
 },
 {
   "id": 4074,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 13,
   "firman": "Lalu berserulah Musa kepada TUHAN: \"Ya Allah, sembuhkanlah kiranya dia.\""
 },
 {
   "id": 4075,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 14,
   "firman": "Kemudian berfirmanlah TUHAN kepada Musa: \"Sekiranya ayahnya meludahi mukanya, tidakkah ia mendapat malu selama tujuh hari? Biarlah dia selama tujuh hari dikucilkan ke luar tempat perkemahan, kemudian bolehlah ia diterima kembali.\""
 },
 {
   "id": 4076,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 15,
   "firman": "Jadi dikucilkanlah Miryam ke luar tempat perkemahan tujuh hari lamanya, dan bangsa itu tidak berangkat sebelum Miryam diterima kembali."
 },
 {
   "id": 4077,
   "kitab": "Bil",
   "pasal": 12,
   "ayat": 16,
   "firman": "Kemudian berangkatlah mereka dari Hazerot dan berkemah di padang gurun Paran."
 },
 {
   "id": 4078,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4079,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 2,
   "firman": "\"Suruhlah beberapa orang mengintai tanah Kanaan, yang akan Kuberikan kepada orang Israel; dari setiap suku nenek moyang mereka haruslah kausuruh seorang, semuanya pemimpin-pemimpin di antara mereka.\""
 },
 {
   "id": 4080,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 3,
   "firman": "Lalu Musa menyuruh mereka dari padang gurun Paran, sesuai dengan titah TUHAN; semua orang itu adalah kepala-kepala di antara orang Israel."
 },
 {
   "id": 4081,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 4,
   "firman": "Dan inilah nama-nama mereka: Dari suku Ruben: Syamua bin Zakur;"
 },
 {
   "id": 4082,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 5,
   "firman": "dari suku Simeon: Safat bin Hori;"
 },
 {
   "id": 4083,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 6,
   "firman": "dari suku Yehuda: Kaleb bin Yefune;"
 },
 {
   "id": 4084,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 7,
   "firman": "dari suku Isakhar: Yigal bin Yusuf;"
 },
 {
   "id": 4085,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 8,
   "firman": "dari suku Efraim: Hosea bin Nun;"
 },
 {
   "id": 4086,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 9,
   "firman": "dari suku Benyamin: Palti bin Rafu;"
 },
 {
   "id": 4087,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 10,
   "firman": "dari suku Zebulon: Gadiel bin Sodi;"
 },
 {
   "id": 4088,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 11,
   "firman": "dari suku Yusuf, yakni dari suku Manasye: Gadi bin Susi;"
 },
 {
   "id": 4089,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 12,
   "firman": "dari suku Dan: Amiel bin Gemali;"
 },
 {
   "id": 4090,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 13,
   "firman": "dari suku Asyer: Setur bin Mikhael;"
 },
 {
   "id": 4091,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 14,
   "firman": "dari suku Naftali: Nahbi bin Wofsi;"
 },
 {
   "id": 4092,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 15,
   "firman": "dari suku Gad: Guel bin Makhi."
 },
 {
   "id": 4093,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 16,
   "firman": "Itulah nama orang-orang yang disuruh Musa untuk mengintai negeri itu; dan Musa menamai Hosea bin Nun itu Yosua."
 },
 {
   "id": 4094,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 17,
   "firman": "Maka Musa menyuruh mereka untuk mengintai tanah Kanaan, katanya kepada mereka: \"Pergilah dari sini ke Tanah Negeb dan naiklah ke pegunungan,"
 },
 {
   "id": 4095,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 18,
   "firman": "dan amat-amatilah bagaimana keadaan negeri itu, apakah bangsa yang mendiaminya kuat atau lemah, apakah mereka sedikit atau banyak;"
 },
 {
   "id": 4096,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 19,
   "firman": "dan bagaimana negeri yang didiaminya, apakah baik atau buruk, bagaimana kota-kota yang didiaminya, apakah mereka diam di tempat-tempat yang terbuka atau di tempat-tempat yang berkubu,"
 },
 {
   "id": 4097,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 20,
   "firman": "dan bagaimana tanah itu, apakah gemuk atau kurus, apakah ada di sana pohon-pohonan atau tidak. Tabahkanlah hatimu dan bawalah sedikit dari hasil negeri itu.\" Waktu itu ialah musim hulu hasil anggur."
 },
 {
   "id": 4098,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 21,
   "firman": "Mereka pergi ke sana, lalu mengintai negeri itu mulai dari padang gurun Zin sampai ke Rehob, ke jalan yang menuju ke Hamat."
 },
 {
   "id": 4099,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 22,
   "firman": "Mereka berjalan melalui Tanah Negeb, lalu sampai ke Hebron; di sana ada Ahiman, Sesai dan Talmai, keturunan Enak. Hebron didirikan tujuh tahun lebih dahulu dari Soan di Mesir."
 },
 {
   "id": 4100,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 23,
   "firman": "Ketika mereka sampai ke lembah Eskol, dipotong merekalah di sana suatu cabang dengan setandan buah anggurnya, lalu berdualah mereka menggandarnya; juga mereka membawa beberapa buah delima dan buah ara."
 },
 {
   "id": 4101,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 24,
   "firman": "Tempat itu dinamai orang lembah Eskol, karena tandan buah anggur yang dipotong orang Israel di sana."
 },
 {
   "id": 4102,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 25,
   "firman": "Sesudah lewat empat puluh hari pulanglah mereka dari pengintaian negeri itu,"
 },
 {
   "id": 4103,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 26,
   "firman": "dan langsung datang kepada Musa, Harun dan segenap umat Israel di Kadesh, di padang gurun Paran. Mereka membawa pulang kabar kepada keduanya dan kepada segenap umat itu dan memperlihatkan kepada sekaliannya hasil negeri itu."
 },
 {
   "id": 4104,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 27,
   "firman": "Mereka menceritakan kepadanya: \"Kami sudah masuk ke negeri, ke mana kausuruh kami, dan memang negeri itu berlimpah-limpah susu dan madunya, dan inilah hasilnya."
 },
 {
   "id": 4105,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 28,
   "firman": "Hanya, bangsa yang diam di negeri itu kuat-kuat dan kota-kotanya berkubu dan sangat besar, juga keturunan Enak telah kami lihat di sana."
 },
 {
   "id": 4106,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 29,
   "firman": "Orang Amalek diam di Tanah Negeb, orang Het, orang Yebus dan orang Amori diam di pegunungan, orang Kanaan diam sepanjang laut dan sepanjang tepi sungai Yordan.\""
 },
 {
   "id": 4107,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 30,
   "firman": "Kemudian Kaleb mencoba menenteramkan hati bangsa itu di hadapan Musa, katanya: \"Tidak! Kita akan maju dan menduduki negeri itu, sebab kita pasti akan mengalahkannya!\""
 },
 {
   "id": 4108,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 31,
   "firman": "Tetapi orang-orang yang pergi ke sana bersama-sama dengan dia berkata: \"Kita tidak dapat maju menyerang bangsa itu, karena mereka lebih kuat dari pada kita.\""
 },
 {
   "id": 4109,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 32,
   "firman": "Juga mereka menyampaikan kepada orang Israel kabar busuk tentang negeri yang diintai mereka, dengan berkata: \"Negeri yang telah kami lalui untuk diintai adalah suatu negeri yang memakan penduduknya, dan semua orang yang kami lihat di sana adalah orang-orang yang tinggi-tinggi perawakannya."
 },
 {
   "id": 4110,
   "kitab": "Bil",
   "pasal": 13,
   "ayat": 33,
   "firman": "Juga kami lihat di sana orang-orang raksasa, orang Enak yang berasal dari orang-orang raksasa, dan kami lihat diri kami seperti belalang, dan demikian juga mereka terhadap kami.\""
 },
 {
   "id": 4111,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 1,
   "firman": "Lalu segenap umat itu mengeluarkan suara nyaring dan bangsa itu menangis pada malam itu."
 },
 {
   "id": 4112,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 2,
   "firman": "Bersungut-sungutlah semua orang Israel kepada Musa dan Harun; dan segenap umat itu berkata kepada mereka: \"Ah, sekiranya kami mati di tanah Mesir, atau di padang gurun ini!"
 },
 {
   "id": 4113,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 3,
   "firman": "Mengapakah TUHAN membawa kami ke negeri ini, supaya kami tewas oleh pedang, dan isteri serta anak-anak kami menjadi tawanan? Bukankah lebih baik kami pulang ke Mesir?\""
 },
 {
   "id": 4114,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 4,
   "firman": "Dan mereka berkata seorang kepada yang lain: \"Baiklah kita mengangkat seorang pemimpin, lalu pulang ke Mesir.\""
 },
 {
   "id": 4115,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 5,
   "firman": "Lalu sujudlah Musa dan Harun di depan mata seluruh jemaah Israel yang berkumpul di situ."
 },
 {
   "id": 4116,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi Yosua bin Nun dan Kaleb bin Yefune, yang termasuk orang-orang yang telah mengintai negeri itu, mengoyakkan pakaiannya,"
 },
 {
   "id": 4117,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 7,
   "firman": "dan berkata kepada segenap umat Israel: \"Negeri yang kami lalui untuk diintai itu adalah luar biasa baiknya."
 },
 {
   "id": 4118,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 8,
   "firman": "Jika TUHAN berkenan kepada kita, maka Ia akan membawa kita masuk ke negeri itu dan akan memberikannya kepada kita, suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 4119,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 9,
   "firman": "Hanya, janganlah memberontak kepada TUHAN, dan janganlah takut kepada bangsa negeri itu, sebab mereka akan kita telan habis. Yang melindungi mereka sudah meninggalkan mereka, sedang TUHAN menyertai kita; janganlah takut kepada mereka.\""
 },
 {
   "id": 4120,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 10,
   "firman": "Lalu segenap umat itu mengancam hendak melontari kedua orang itu dengan batu. Tetapi tampaklah kemuliaan TUHAN di Kemah Pertemuan kepada semua orang Israel."
 },
 {
   "id": 4121,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 11,
   "firman": "TUHAN berfirman kepada Musa: \"Berapa lama lagi bangsa ini menista Aku, dan berapa lama lagi mereka tidak mau percaya kepada-Ku, sekalipun sudah ada segala tanda mujizat yang Kulakukan di tengah-tengah mereka!"
 },
 {
   "id": 4122,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 12,
   "firman": "Aku akan memukul mereka dengan penyakit sampar dan melenyapkan mereka, tetapi engkau akan Kubuat menjadi bangsa yang lebih besar dan lebih kuat dari pada mereka.\""
 },
 {
   "id": 4123,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 13,
   "firman": "Lalu berkatalah Musa kepada TUHAN: \"Jikalau hal itu kedengaran kepada orang Mesir, padahal Engkau telah menuntun bangsa ini dengan kekuatan-Mu dari tengah-tengah mereka,"
 },
 {
   "id": 4124,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 14,
   "firman": "mereka akan berceritera kepada penduduk negeri ini, yang telah mendengar bahwa Engkau, TUHAN, ada di tengah-tengah bangsa ini, dan bahwa Engkau, TUHAN, menampakkan diri-Mu kepada mereka dengan berhadapan muka, waktu awan-Mu berdiri di atas mereka dan waktu Engkau berjalan mendahului mereka di dalam tiang awan pada waktu siang dan di dalam tiang api pada waktu malam."
 },
 {
   "id": 4125,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 15,
   "firman": "Jadi jikalau Engkau membunuh bangsa ini sampai habis, maka bangsa-bangsa yang mendengar kabar tentang Engkau itu nanti berkata:"
 },
 {
   "id": 4126,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 16,
   "firman": "Oleh karena TUHAN tidak berkuasa membawa bangsa ini masuk ke negeri yang dijanjikan-Nya dengan bersumpah kepada mereka, maka Ia menyembelih mereka di padang gurun."
 },
 {
   "id": 4127,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 17,
   "firman": "Jadi sekarang, biarlah kiranya kekuatan TUHAN itu nyata kebesarannya, seperti yang Kaufirmankan:"
 },
 {
   "id": 4128,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 18,
   "firman": "TUHAN itu berpanjangan sabar dan kasih setia-Nya berlimpah-limpah, Ia mengampuni kesalahan dan pelanggaran, tetapi sekali-kali tidak membebaskan orang yang bersalah dari hukuman, bahkan Ia membalaskan kesalahan bapa kepada anak-anaknya, kepada keturunan yang ketiga dan keempat."
 },
 {
   "id": 4129,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 19,
   "firman": "Ampunilah kiranya kesalahan bangsa ini sesuai dengan kebesaran kasih setia-Mu, seperti Engkau telah mengampuni bangsa ini mulai dari Mesir sampai ke mari.\""
 },
 {
   "id": 4130,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 20,
   "firman": "Berfirmanlah TUHAN: \"Aku mengampuninya sesuai dengan permintaanmu."
 },
 {
   "id": 4131,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 21,
   "firman": "Hanya, demi Aku yang hidup dan kemuliaan TUHAN memenuhi seluruh bumi:"
 },
 {
   "id": 4132,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 22,
   "firman": "Semua orang yang telah melihat kemuliaan-Ku dan tanda-tanda mujizat yang Kuperbuat di Mesir dan di padang gurun, namun telah sepuluh kali mencobai Aku dan tidak mau mendengarkan suara-Ku,"
 },
 {
   "id": 4133,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 23,
   "firman": "pastilah tidak akan melihat negeri yang Kujanjikan dengan bersumpah kepada nenek moyang mereka! Semua yang menista Aku ini tidak akan melihatnya."
 },
 {
   "id": 4134,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 24,
   "firman": "Tetapi hamba-Ku Kaleb, karena lain jiwa yang ada padanya dan ia mengikut Aku dengan sepenuhnya, akan Kubawa masuk ke negeri yang telah dimasukinya itu, dan keturunannya akan memilikinya."
 },
 {
   "id": 4135,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 25,
   "firman": "Orang Amalek dan orang Kanaan diam di lembah. Sebab itu berpalinglah besok dan berangkatlah ke padang gurun, ke arah Laut Teberau.\""
 },
 {
   "id": 4136,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 26,
   "firman": "Lagi berfirmanlah TUHAN kepada Musa dan Harun:"
 },
 {
   "id": 4137,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 27,
   "firman": "\"Berapa lama lagi umat yang jahat ini akan bersungut-sungut kepada-Ku? Segala sesuatu yang disungut-sungutkan orang Israel kepada-Ku telah Kudengar."
 },
 {
   "id": 4138,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 28,
   "firman": "Katakanlah kepada mereka: Demi Aku yang hidup, demikianlah firman TUHAN, bahwasanya seperti yang kamu katakan di hadapan-Ku, demikianlah akan Kulakukan kepadamu."
 },
 {
   "id": 4139,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 29,
   "firman": "Di padang gurun ini bangkai-bangkaimu akan berhantaran, yakni semua orang di antara kamu yang dicatat, semua tanpa terkecuali yang berumur dua puluh tahun ke atas, karena kamu telah bersungut-sungut kepada-Ku."
 },
 {
   "id": 4140,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 30,
   "firman": "Bahwasanya kamu ini tidak akan masuk ke negeri yang dengan mengangkat sumpah telah Kujanjikan akan Kuberi kamu diami, kecuali Kaleb bin Yefune dan Yosua bin Nun!"
 },
 {
   "id": 4141,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 31,
   "firman": "Tentang anak-anakmu yang telah kamu katakan: Mereka akan menjadi tawanan, merekalah yang akan Kubawa masuk, supaya mereka mengenal negeri yang telah kamu hinakan itu."
 },
 {
   "id": 4142,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 32,
   "firman": "Tetapi mengenai kamu, bangkai-bangkaimu akan berhantaran di padang gurun ini,"
 },
 {
   "id": 4143,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 33,
   "firman": "dan anak-anakmu akan mengembara sebagai penggembala di padang gurun empat puluh tahun lamanya dan akan menanggung akibat ketidaksetiaan, sampai bangkai-bangkaimu habis di padang gurun."
 },
 {
   "id": 4144,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 34,
   "firman": "Sesuai dengan jumlah hari yang kamu mengintai negeri itu, yakni empat puluh hari, satu hari dihitung satu tahun, jadi empat puluh tahun lamanya kamu harus menanggung akibat kesalahanmu, supaya kamu tahu rasanya, jika Aku berbalik dari padamu:"
 },
 {
   "id": 4145,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 35,
   "firman": "Aku, TUHAN, yang berkata demikian. Sesungguhnya Aku akan melakukan semuanya itu kepada segenap umat yang jahat ini yang telah bersepakat melawan Aku. Di padang gurun ini mereka akan habis dan di sinilah mereka akan mati.\""
 },
 {
   "id": 4146,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 36,
   "firman": "Adapun orang-orang yang telah disuruh Musa untuk mengintai negeri itu, yang sudah pulang dan menyebabkan segenap umat itu bersungut-sungut kepada Musa dengan menyampaikan kabar busuk tentang negeri itu,"
 },
 {
   "id": 4147,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 37,
   "firman": "orang-orang itu mati, kena tulah di hadapan TUHAN."
 },
 {
   "id": 4148,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 38,
   "firman": "Tetapi yang tinggal hidup dari orang-orang yang telah pergi mengintai negeri itu hanyalah Yosua bin Nun dan Kaleb bin Yefune."
 },
 {
   "id": 4149,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 39,
   "firman": "Setelah Musa menyampaikan perkataan ini kepada semua orang Israel, maka berkabunglah bangsa itu dengan sangat."
 },
 {
   "id": 4150,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 40,
   "firman": "Dan keesokan harinya bangunlah mereka pagi-pagi hendak naik ke puncak gunung sambil berkata: \"Sekarang kita hendak maju ke negeri yang difirmankan TUHAN itu; memang kita telah berbuat dosa.\""
 },
 {
   "id": 4151,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 41,
   "firman": "Tetapi kata Musa: \"Mengapakah kamu hendak melanggar titah TUHAN? Hal itu tidak akan berhasil."
 },
 {
   "id": 4152,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 42,
   "firman": "Janganlah maju, sebab TUHAN tidak ada di tengah-tengahmu, supaya jangan kamu dikalahkan oleh musuhmu,"
 },
 {
   "id": 4153,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 43,
   "firman": "sebab orang Amalek dan orang Kanaan ada di sana di depanmu dan kamu akan tewas oleh pedang; dari sebab kamu berbalik membelakangi TUHAN, maka TUHAN tidak akan menyertai kamu.\""
 },
 {
   "id": 4154,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 44,
   "firman": "Meskipun demikian, mereka nekat naik ke puncak gunung itu, tetapi tabut perjanjian TUHAN dan Musa juga tidaklah meninggalkan tempat perkemahan."
 },
 {
   "id": 4155,
   "kitab": "Bil",
   "pasal": 14,
   "ayat": 45,
   "firman": "Lalu turunlah orang Amalek dan orang Kanaan yang mendiami pegunungan itu dan menyerang mereka; kemudian orang-orang itu mencerai-beraikan mereka sampai ke Horma."
 },
 {
   "id": 4156,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4157,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila kamu masuk ke negeri yang akan Kuberikan kepadamu menjadi tempat kediamanmu,"
 },
 {
   "id": 4158,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 3,
   "firman": "dan kamu hendak mempersembahkan korban api-apian bagi TUHAN, dari lembu sapi atau kambing domba, baik korban bakaran atau korban sembelihan, baik untuk membayar suatu nazar khusus, atau sebagai persembahan sukarela atau pada waktu perayaan-perayaanmu, dan dengan demikian menyediakan bau yang menyenangkan bagi TUHAN,"
 },
 {
   "id": 4159,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 4,
   "firman": "maka orang yang mempersembahkan persembahannya itu kepada TUHAN, haruslah mempersembahkan sebagai korban sajian sepersepuluh efa tepung yang terbaik, diolah dengan seperempat hin minyak."
 },
 {
   "id": 4160,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 5,
   "firman": "Dan beserta korban bakaran atau korban sembelihan itu engkau harus juga mempersembahkan seperempat hin anggur sebagai korban curahan, untuk setiap ekor domba yang dipersembahkan."
 },
 {
   "id": 4161,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 6,
   "firman": "Tetapi jikalau persembahanmu itu seekor domba jantan, engkau harus mempersembahkan sebagai korban sajian dua persepuluh efa tepung yang terbaik, diolah dengan sepertiga hin minyak,"
 },
 {
   "id": 4162,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 7,
   "firman": "dan sebagai korban curahan haruslah kaupersembahkan sepertiga hin anggur, menjadi bau yang menyenangkan bagi TUHAN."
 },
 {
   "id": 4163,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dan apabila engkau mengolah seekor lembu, sebagai korban bakaran atau sebagai korban sembelihan, baik untuk membayar suatu nazar khusus maupun sebagai korban keselamatan bagi TUHAN,"
 },
 {
   "id": 4164,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 9,
   "firman": "maka beserta lembu itu haruslah dipersembahkan sebagai korban sajian tiga persepuluh efa tepung yang terbaik, diolah dengan setengah hin minyak,"
 },
 {
   "id": 4165,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 10,
   "firman": "dan sebagai korban curahan haruslah kaupersembahkan setengah hin anggur. Itulah korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 4166,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 11,
   "firman": "Demikianlah harus diperbuat untuk setiap ekor lembu dan untuk setiap ekor domba jantan dan untuk setiap ekor domba atau kambing."
 },
 {
   "id": 4167,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 12,
   "firman": "Berapapun jumlah hewan yang kamu olah, untuk setiap hewan itu harus kamu perbuat demikian juga."
 },
 {
   "id": 4168,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 13,
   "firman": "Setiap orang Israel asli haruslah berbuat demikian, apabila ia mempersembahkan korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 4169,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 14,
   "firman": "Dan apabila seorang asing telah menetap padamu, atau seorang lain yang tinggal di antara kamu atau di antara keturunanmu kelak, hendak mempersembahkan korban api-apian yang baunya menyenangkan bagi TUHAN, maka seperti yang kamu perbuat, demikianlah harus diperbuatnya."
 },
 {
   "id": 4170,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 15,
   "firman": "Mengenai jemaah itu, haruslah ada satu ketetapan bagi kamu dan bagi orang asing yang tinggal padamu; itulah suatu ketetapan untuk selama-lamanya bagi kamu turun-temurun: kamu dan orang asing haruslah sama di hadapan TUHAN."
 },
 {
   "id": 4171,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 16,
   "firman": "Satu hukum dan satu peraturan berlaku bagi kamu dan bagi orang asing yang tinggal padamu.\""
 },
 {
   "id": 4172,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 17,
   "firman": "Lagi berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 4173,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 18,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila kamu masuk ke negeri, ke mana kamu akan Kubawa,"
 },
 {
   "id": 4174,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 19,
   "firman": "maka apabila kamu makan roti hasil negeri itu haruslah kamu mempersembahkan persembahan khusus bagi TUHAN."
 },
 {
   "id": 4175,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 20,
   "firman": "Tepung jelaimu yang mula-mula haruslah kamu persembahkan sebagai persembahan khusus berupa roti bundar; sama seperti persembahan khusus dari hasil tempat pengirikanmu, demikianlah harus kamu mempersembahkannya."
 },
 {
   "id": 4176,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 21,
   "firman": "Dari tepung jelaimu yang mula-mula haruslah kamu menyerahkan persembahan khusus kepada TUHAN, turun-temurun.\""
 },
 {
   "id": 4177,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 22,
   "firman": "\"Apabila kamu dengan tidak sengaja melalaikan salah satu dari segala perintah ini, yang telah difirmankan TUHAN kepada Musa,"
 },
 {
   "id": 4178,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 23,
   "firman": "yakni dari segala yang diperintahkan TUHAN kepadamu dengan perantaraan Musa, mulai dari hari TUHAN memberikan perintah-perintah-Nya dan seterusnya turun-temurun,"
 },
 {
   "id": 4179,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 24,
   "firman": "dan apabila hal itu diperbuat di luar pengetahuan umat ini, tidak dengan sengaja, maka haruslah segenap umat mengolah seekor lembu jantan muda sebagai korban bakaran menjadi bau yang menyenangkan bagi TUHAN, serta dengan korban sajiannya dan korban curahannya, sesuai dengan peraturan; juga seekor kambing jantan sebagai korban penghapus dosa."
 },
 {
   "id": 4180,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 25,
   "firman": "Maka haruslah imam mengadakan pendamaian bagi segenap umat Israel, sehingga mereka beroleh pengampunan, sebab hal itu terjadi tidak dengan sengaja, dan karena mereka telah membawa persembahan-persembahan mereka sebagai korban api-apian bagi TUHAN, juga korban penghapus dosa mereka di hadapan TUHAN, karena hal yang tidak disengaja itu."
 },
 {
   "id": 4181,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 26,
   "firman": "Segenap umat Israel akan beroleh pengampunan, juga orang asing yang tinggal di tengah-tengahmu, karena hal itu dilakukan oleh seluruh bangsa itu dengan tidak sengaja."
 },
 {
   "id": 4182,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 27,
   "firman": "Apabila satu orang saja berbuat dosa dengan tidak sengaja, maka haruslah ia mempersembahkan kambing betina berumur setahun sebagai korban penghapus dosa;"
 },
 {
   "id": 4183,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 28,
   "firman": "dan imam haruslah mengadakan pendamaian di hadapan TUHAN bagi orang yang dengan tidak sengaja berbuat dosa itu, sehingga orang itu beroleh pengampunan karena telah diadakan pendamaian baginya."
 },
 {
   "id": 4184,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 29,
   "firman": "Baik bagi orang Israel asli maupun bagi orang asing yang tinggal di tengah-tengah kamu, satu hukum saja berlaku bagi mereka berkenaan dengan orang yang berbuat dosa dengan tidak sengaja."
 },
 {
   "id": 4185,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 30,
   "firman": "Tetapi orang yang berbuat sesuatu dengan sengaja, baik orang Israel asli, baik orang asing, orang itu menjadi penista TUHAN, ia harus dilenyapkan dari tengah-tengah bangsanya,"
 },
 {
   "id": 4186,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 31,
   "firman": "sebab ia telah memandang hina terhadap firman TUHAN dan merombak perintah-Nya; pastilah orang itu dilenyapkan, kesalahannya akan tertimpa atasnya.\""
 },
 {
   "id": 4187,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 32,
   "firman": "Ketika orang Israel ada di padang gurun, didapati merekalah seorang yang mengumpulkan kayu api pada hari Sabat."
 },
 {
   "id": 4188,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 33,
   "firman": "Lalu orang-orang yang mendapati dia sedang mengumpulkan kayu api itu, menghadapkan dia kepada Musa dan Harun dan segenap umat itu."
 },
 {
   "id": 4189,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 34,
   "firman": "Orang itu dimasukkan dalam tahanan, oleh karena belum ditentukan apa yang harus dilakukan kepadanya."
 },
 {
   "id": 4190,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 35,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa: \"Orang itu pastilah dihukum mati; segenap umat Israel harus melontari dia dengan batu di luar tempat perkemahan.\""
 },
 {
   "id": 4191,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 36,
   "firman": "Lalu segenap umat menggiring dia ke luar tempat perkemahan, kemudian dia dilontari dengan batu, sehingga ia mati, seperti yang difirmankan TUHAN kepada Musa."
 },
 {
   "id": 4192,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 37,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4193,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 38,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka, bahwa mereka harus membuat jumbai-jumbai pada punca baju mereka, turun-temurun, dan dalam jumbai-jumbai punca itu haruslah dibubuh benang ungu kebiru-biruan."
 },
 {
   "id": 4194,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 39,
   "firman": "Maka jumbai itu akan mengingatkan kamu, apabila kamu melihatnya, kepada segala perintah TUHAN, sehingga kamu melakukannya dan tidak lagi menuruti hatimu atau matamu sendiri, seperti biasa kamu perbuat dalam ketidaksetiaanmu terhadap TUHAN."
 },
 {
   "id": 4195,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 40,
   "firman": "Maksudnya supaya kamu mengingat dan melakukan segala perintah-Ku dan menjadi kudus bagi Allahmu."
 },
 {
   "id": 4196,
   "kitab": "Bil",
   "pasal": 15,
   "ayat": 41,
   "firman": "Akulah TUHAN, Allahmu, yang telah membawa kamu keluar dari tanah Mesir, supaya Aku menjadi Allah bagimu; Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 4197,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 1,
   "firman": "Korah bin Yizhar bin Kehat bin Lewi, beserta Datan dan Abiram, anak-anak Eliab, dan On bin Pelet, ketiganya orang Ruben, mengajak orang-orang"
 },
 {
   "id": 4198,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 2,
   "firman": "untuk memberontak melawan Musa, beserta dua ratus lima puluh orang Israel, pemimpin-pemimpin umat itu, yaitu orang-orang yang dipilih oleh rapat, semuanya orang-orang yang kenamaan."
 },
 {
   "id": 4199,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 3,
   "firman": "Maka mereka berkumpul mengerumuni Musa dan Harun, serta berkata kepada keduanya: \"Sekarang cukuplah itu! Segenap umat itu adalah orang-orang kudus, dan TUHAN ada di tengah-tengah mereka. Mengapakah kamu meninggi-ninggikan diri di atas jemaah TUHAN?\""
 },
 {
   "id": 4200,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 4,
   "firman": "Ketika Musa mendengar hal itu, sujudlah ia."
 },
 {
   "id": 4201,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 5,
   "firman": "Dan ia berkata kepada Korah dan segenap kumpulannya: \"Besok pagi TUHAN akan memberitahukan, siapa kepunyaan-Nya, dan siapa yang kudus, dan Ia akan memperbolehkan orang itu mendekat kepada-Nya; orang yang akan dipilih-Nya akan diperbolehkan-Nya mendekat kepada-Nya."
 },
 {
   "id": 4202,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 6,
   "firman": "Perbuatlah begini: ambillah perbaraan-perbaraan, hai Korah, dan kamu segenap kumpulannya,"
 },
 {
   "id": 4203,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 7,
   "firman": "bubuhlah api ke dalamnya dan taruhlah ukupan di atasnya, di hadapan TUHAN pada esok hari, dan orang yang akan dipilih TUHAN, dialah yang kudus. Cukuplah itu, hai orang-orang Lewi!\""
 },
 {
   "id": 4204,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lalu berkatalah Musa kepada Korah: \"Cobalah dengar, hai orang-orang Lewi!"
 },
 {
   "id": 4205,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 9,
   "firman": "Belum cukupkah bagimu, bahwa kamu dipisahkan oleh Allah Israel dari umat Israel dan diperbolehkan mendekat kepada-Nya, supaya kamu melakukan pekerjaan pada Kemah Suci TUHAN dan bertugas bagi umat itu untuk melayani mereka,"
 },
 {
   "id": 4206,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 10,
   "firman": "dan bahwa engkau diperbolehkan mendekat bersama-sama dengan semua saudaramu bani Lewi? Dan sekarang mau pula kamu menuntut pangkat imam lagi?"
 },
 {
   "id": 4207,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 11,
   "firman": "Sebab itu, engkau ini dengan segenap kumpulanmu, kamu bersepakat melawan TUHAN. Karena siapakah Harun, sehingga kamu bersungut-sungut kepadanya?\""
 },
 {
   "id": 4208,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 12,
   "firman": "Adapun Musa telah menyuruh orang untuk memanggil Datan dan Abiram, anak-anak Eliab, tetapi jawab mereka: \"Kami tidak mau datang."
 },
 {
   "id": 4209,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 13,
   "firman": "Belum cukupkah, bahwa engkau memimpin kami keluar dari suatu negeri yang berlimpah-limpah susu dan madunya untuk membiarkan kami mati di padang gurun, sehingga masih juga engkau menjadikan dirimu tuan atas kami?"
 },
 {
   "id": 4210,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 14,
   "firman": "Sungguh, engkau tidak membawa kami ke negeri yang berlimpah-limpah susu dan madunya, ataupun memberikan kepada kami ladang-ladang dan kebun-kebun anggur sebagai milik pusaka. Masakan engkau dapat mengelabui mata orang-orang ini? Kami tidak mau datang.\""
 },
 {
   "id": 4211,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu sangat marahlah Musa dan ia berkata kepada TUHAN: \"Janganlah perhatikan segala persembahan mereka. Belum pernah kuambil satu ekor keledaipun dari mereka, dan belum pernah kulakukan yang jahat kepada seseorangpun dari mereka.\""
 },
 {
   "id": 4212,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 16,
   "firman": "Lalu berkatalah Musa kepada Korah: \"Engkau ini dengan segenap kumpulanmu harus menghadap TUHAN, engkau dan mereka dan Harun, pada esok hari."
 },
 {
   "id": 4213,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 17,
   "firman": "Baiklah kamu masing-masing membawa perbaraannya membubuh ukupan di atasnya, lalu kamu mempersembahkan masing-masing perbaraannya ke hadapan TUHAN, dua ratus lima puluh perbaraan; juga engkau ini dan Harun masing-masing harus membawa perbaraannya.\""
 },
 {
   "id": 4214,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 18,
   "firman": "Maka mereka masing-masing membawa perbaraannya, membubuh api ke dalamnya, menaruh ukupan di atasnya, lalu berdirilah mereka di depan pintu Kemah Pertemuan, juga Musa dan Harun."
 },
 {
   "id": 4215,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 19,
   "firman": "Ketika Korah mengumpulkan segenap umat itu melawan mereka berdua di depan pintu Kemah Pertemuan, tampaklah kemuliaan TUHAN kepada segenap umat itu."
 },
 {
   "id": 4216,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 20,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa dan Harun:"
 },
 {
   "id": 4217,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 21,
   "firman": "\"Pisahkanlah dirimu dari tengah-tengah umat ini, supaya Kuhancurkan mereka dalam sekejap mata.\""
 },
 {
   "id": 4218,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 22,
   "firman": "Tetapi sujudlah mereka berdua dan berkata: \"Ya Allah, Allah dari roh segala makhluk! Satu orang saja berdosa, masakan Engkau murka terhadap segenap perkumpulan ini?\""
 },
 {
   "id": 4219,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 23,
   "firman": "Maka berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 4220,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 24,
   "firman": "\"Katakanlah kepada umat itu: Pergilah dari sekeliling tempat kediaman Korah, Datan dan Abiram.\""
 },
 {
   "id": 4221,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 25,
   "firman": "Lalu pergilah Musa kepada Datan dan Abiram, dan para tua-tua Israel mengikuti dia."
 },
 {
   "id": 4222,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 26,
   "firman": "Berkatalah ia kepada umat itu: \"Baiklah kamu menjauh dari kemah orang-orang fasik ini dan janganlah kamu kena kepada sesuatu apapun dari kepunyaan mereka, supaya kamu jangan mati lenyap oleh karena segala dosa mereka.\""
 },
 {
   "id": 4223,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 27,
   "firman": "Maka pergilah mereka dari sekeliling tempat kediaman Korah, Datan dan Abiram. Keluarlah Datan dan Abiram, lalu berdiri di depan pintu kemah mereka bersama-sama dengan isterinya, para anaknya dan anak-anak yang kecil."
 },
 {
   "id": 4224,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 28,
   "firman": "Sesudah itu berkatalah Musa: \"Dari hal inilah kamu akan tahu, bahwa aku diutus TUHAN untuk melakukan segala perbuatan ini, dan hal itu bukanlah dari hatiku sendiri:"
 },
 {
   "id": 4225,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 29,
   "firman": "jika orang-orang ini nanti mati seperti matinya setiap manusia, dan mereka mengalami yang dialami setiap manusia, maka aku tidak diutus TUHAN."
 },
 {
   "id": 4226,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 30,
   "firman": "Tetapi, jika TUHAN akan menjadikan sesuatu yang belum pernah terjadi, dan tanah mengangakan mulutnya dan menelan mereka beserta segala kepunyaan mereka, sehingga mereka hidup-hidup turun ke dunia orang mati, maka kamu akan tahu, bahwa orang-orang ini telah menista TUHAN.\""
 },
 {
   "id": 4227,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 31,
   "firman": "Baru saja ia selesai mengucapkan segala perkataan itu, maka terbelahlah tanah yang di bawah mereka,"
 },
 {
   "id": 4228,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 32,
   "firman": "dan bumi membuka mulutnya dan menelan mereka dengan seisi rumahnya dan dengan semua orang yang ada pada Korah dan dengan segala harta milik mereka."
 },
 {
   "id": 4229,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 33,
   "firman": "Demikianlah mereka dengan semua orang yang ada pada mereka turun hidup-hidup ke dunia orang mati; dan bumi menutupi mereka, sehingga mereka binasa dari tengah-tengah jemaah itu."
 },
 {
   "id": 4230,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 34,
   "firman": "Dan semua orang Israel yang di sekeliling mereka berlarian mendengar teriak mereka, sebab kata mereka: \"Jangan-jangan bumi menelan kita juga!\""
 },
 {
   "id": 4231,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 35,
   "firman": "Lagi keluarlah api, berasal dari pada TUHAN, lalu memakan habis kedua ratus lima puluh orang yang mempersembahkan ukupan itu."
 },
 {
   "id": 4232,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 36,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4233,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 37,
   "firman": "\"Katakanlah kepada Eleazar, anak imam Harun, supaya ia mengangkat perbaraan-perbaraan dari antara kebakaran itu, lalu hamburkanlah api itu jauh-jauh, karena semuanya itu kudus,"
 },
 {
   "id": 4234,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 38,
   "firman": "yakni perbaraan orang-orang berdosa yang telah membayarkan nyawanya, kemudian semuanya itu harus ditempa tipis-tipis menjadi salut mezbah, sebab telah dibawa ke hadapan TUHAN oleh orang-orang itu, jadi semuanya itu kudus; dengan demikian hal itu menjadi tanda bagi orang Israel.\""
 },
 {
   "id": 4235,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 39,
   "firman": "Maka imam Eleazar mengambil perbaraan-perbaraan tembaga yang telah dibawa oleh orang-orang yang terbakar itu, lalu ditempa menjadi salut mezbah."
 },
 {
   "id": 4236,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 40,
   "firman": "Itu menjadi suatu peringatan bagi orang Israel, supaya jangan tampil orang awam yang bukan dari keturunan Harun untuk membakar ukupan di hadapan TUHAN, dan jangan ia menjadi seperti Korah dan kumpulannya--seperti yang difirmankan TUHAN kepadanya dengan perantaraan Musa."
 },
 {
   "id": 4237,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 41,
   "firman": "Tetapi pada keesokan harinya bersungut-sungutlah segenap umat Israel kepada Musa dan Harun, kata mereka: \"Kamu telah membunuh umat TUHAN.\""
 },
 {
   "id": 4238,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 42,
   "firman": "Ketika umat itu berkumpul melawan Musa dan Harun, dan mereka memalingkan mukanya ke arah Kemah Pertemuan, maka kelihatanlah awan itu menutupinya dan tampaklah kemuliaan TUHAN."
 },
 {
   "id": 4239,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 43,
   "firman": "Lalu pergilah Musa dan Harun ke depan Kemah Pertemuan."
 },
 {
   "id": 4240,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 44,
   "firman": "Maka berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 4241,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 45,
   "firman": "\"Pergilah dari tengah-tengah umat ini, supaya Kuhancurkan mereka dalam sekejap mata.\" Lalu sujudlah mereka."
 },
 {
   "id": 4242,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 46,
   "firman": "Berkatalah Musa kepada Harun: \"Ambillah perbaraan, bubuhlah api ke dalamnya dari atas mezbah, dan taruhlah ukupan, dan pergilah dengan segera kepada umat itu dan adakanlah pendamaian bagi mereka, sebab murka TUHAN telah berkobar, dan tulah sedang mulai.\""
 },
 {
   "id": 4243,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 47,
   "firman": "Maka Harun mengambil perbaraan, seperti yang dikatakan Musa, dan berlarilah ia ke tengah-tengah jemaah itu, dan tampaklah tulah telah mulai di antara bangsa itu; lalu dibubuhnyalah ukupan dan diadakannyalah pendamaian bagi bangsa itu."
 },
 {
   "id": 4244,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 48,
   "firman": "Ketika ia berdiri di antara orang-orang mati dan orang-orang hidup, berhentilah tulah itu."
 },
 {
   "id": 4245,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 49,
   "firman": "Dan mereka yang mati kena tulah itu ada empat belas ribu tujuh ratus orang banyaknya, belum terhitung orang-orang yang mati karena perkara Korah."
 },
 {
   "id": 4246,
   "kitab": "Bil",
   "pasal": 16,
   "ayat": 50,
   "firman": "Ketika Harun kembali kepada Musa di depan pintu Kemah Pertemuan, tulah itu telah berhenti."
 },
 {
   "id": 4247,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4248,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel dan suruhlah mereka memberikan kepadamu satu tongkat untuk setiap suku. Semua pemimpin mereka harus memberikannya, suku demi suku, seluruhnya dua belas tongkat. Lalu tuliskanlah nama setiap pemimpin pada tongkatnya."
 },
 {
   "id": 4249,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 3,
   "firman": "Pada tongkat Lewi harus kautuliskan nama Harun. Bagi setiap kepala suku harus ada satu tongkat."
 },
 {
   "id": 4250,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 4,
   "firman": "Kemudian haruslah kauletakkan semuanya itu di dalam Kemah Pertemuan di hadapan tabut hukum, tempat Aku biasa bertemu dengan kamu."
 },
 {
   "id": 4251,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 5,
   "firman": "Dan orang yang Kupilih, tongkat orang itulah akan bertunas; demikianlah Aku hendak meredakan sungut-sungut yang diucapkan mereka kepada kamu, sehingga tidak usah Kudengar lagi.\""
 },
 {
   "id": 4252,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 6,
   "firman": "Setelah Musa berbicara kepada orang Israel, maka semua pemimpin mereka memberikan kepadanya satu tongkat dari setiap pemimpin, menurut suku-suku mereka, dua belas tongkat, dan tongkat Harun ada di antara tongkat-tongkat itu."
 },
 {
   "id": 4253,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 7,
   "firman": "Musa meletakkan tongkat-tongkat itu di hadapan TUHAN dalam kemah hukum Allah."
 },
 {
   "id": 4254,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 8,
   "firman": "Ketika Musa keesokan harinya masuk ke dalam kemah hukum itu, maka tampaklah tongkat Harun dari keturunan Lewi telah bertunas, mengeluarkan kuntum, mengembangkan bunga dan berbuahkan buah badam."
 },
 {
   "id": 4255,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 9,
   "firman": "Kemudian Musa membawa semua tongkat itu keluar dari hadapan TUHAN kepada seluruh orang Israel; mereka melihatnya lalu mengambil tongkatnya masing-masing."
 },
 {
   "id": 4256,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 10,
   "firman": "TUHAN berfirman kepada Musa: \"Kembalikanlah tongkat Harun ke hadapan tabut hukum untuk disimpan menjadi tanda bagi orang-orang durhaka, sehingga engkau mengakhiri sungut-sungut mereka dan tidak Kudengar lagi, supaya mereka jangan mati.\""
 },
 {
   "id": 4257,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dan Musa berbuat demikian; seperti yang diperintahkan TUHAN kepadanya, demikianlah diperbuatnya."
 },
 {
   "id": 4258,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 12,
   "firman": "Tetapi orang Israel berkata kepada Musa: \"Sesungguhnya kami akan mati, kami akan binasa, kami semuanya akan binasa."
 },
 {
   "id": 4259,
   "kitab": "Bil",
   "pasal": 17,
   "ayat": 13,
   "firman": "Siapapun juga yang mendekat ke Kemah Suci TUHAN, niscayalah ia akan mati. Haruskah kami habis binasa?\""
 },
 {
   "id": 4260,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Harun: \"Engkau ini dan anak-anakmu beserta seluruh sukumu haruslah menanggung akibat setiap kesalahan terhadap tempat kudus; sedang hanya engkau beserta anak-anakmulah yang harus menanggung akibat setiap kesalahan yang dilakukan dalam jabatanmu sebagai imam."
 },
 {
   "id": 4261,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 2,
   "firman": "Suruhlah juga saudara-saudaramu, suku Lewi, suku bapa leluhurmu, mendekat bersama-sama dengan engkau, supaya mereka menggabungkan diri kepadamu dan melayani engkau, apabila engkau ini beserta anak-anakmu ada di depan kemah hukum."
 },
 {
   "id": 4262,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 3,
   "firman": "Mereka harus melakukan kewajiban mereka kepadamu, dan kewajiban mereka mengenai kemah seluruhnya; hanya kepada perkakas tempat kudus dan kepada mezbah janganlah mereka mendekat, nanti mereka mati, baik mereka maupun kamu."
 },
 {
   "id": 4263,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 4,
   "firman": "Mereka harus menggabungkan diri kepadamu dan melakukan kewajiban mereka mengenai Kemah Pertemuan sesuai dengan segala pekerjaan pada kemah itu; tetapi orang awam jangan mendekat kepadamu."
 },
 {
   "id": 4264,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 5,
   "firman": "Dan kamu ini haruslah melakukan kewajibanmu mengenai tempat kudus dan kewajibanmu mengenai mezbah, supaya orang Israel jangan lagi tertimpa oleh murka."
 },
 {
   "id": 4265,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 6,
   "firman": "Sesungguhnya Aku ini telah mengambil saudara-saudaramu, orang Lewi, dari tengah-tengah orang Israel sebagai pemberian kepadamu, sebagai orang-orang yang diserahkan kepada TUHAN, untuk melakukan pekerjaan pada Kemah Pertemuan;"
 },
 {
   "id": 4266,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 7,
   "firman": "tetapi engkau ini beserta anak-anakmu harus memegang jabatanmu sebagai imam dalam segala hal yang berkenaan dengan mezbah dan dengan segala sesuatu yang ada di belakang tabir, dan kamu harus mengerjakannya; sebagai suatu jabatan pemberian Aku memberikan kepadamu jabatanmu sebagai imam itu; tetapi orang awam yang mendekat harus dihukum mati.\""
 },
 {
   "id": 4267,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 8,
   "firman": "Lagi berfirmanlah TUHAN kepada Harun: \"Sesungguhnya Aku ini telah menyerahkan kepadamu pemeliharaan persembahan-persembahan khusus yang kepada-Ku; semua persembahan kudus orang Israel Kuberikan kepadamu dan kepada anak-anakmu sebagai bagianmu; itulah suatu ketetapan untuk selama-lamanya."
 },
 {
   "id": 4268,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 9,
   "firman": "Inilah bagianmu dari segala persembahan-persembahan yang maha kudus itu, yaitu dari bagian yang tidak harus dibakar: segala persembahan mereka yang berupa korban sajian, korban penghapus dosa dan korban penebus salah, yang dibayar mereka kepada-Ku; itulah bagian maha kudus yang menjadi bagianmu dan bagian anak-anakmu."
 },
 {
   "id": 4269,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 10,
   "firman": "Sebagai bagian maha kudus haruslah kamu memakannya; semua orang laki-laki boleh memakannya; haruslah itu bagian kudus bagimu."
 },
 {
   "id": 4270,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 11,
   "firman": "Dan inipun adalah bagianmu: persembahan khusus dari pemberian mereka yang lain, termasuk segala persembahan unjukan orang Israel; semuanya itu Kuberikan kepadamu dan kepada anak-anakmu laki-laki dan perempuan bersama-sama dengan engkau; itulah suatu ketetapan untuk selama-lamanya. Setiap orang yang tahir dari seisi rumahmu boleh memakannya."
 },
 {
   "id": 4271,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 12,
   "firman": "Segala yang terbaik dari minyak dan segala yang terbaik dari anggur dan dari gandum, yakni yang sebagai hasil pertamanya dipersembahkan mereka kepada TUHAN, Aku berikan kepadamu."
 },
 {
   "id": 4272,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 13,
   "firman": "Hulu hasil dari segala yang tumbuh di tanahnya yang dipersembahkan mereka kepada TUHAN adalah juga bagianmu; setiap orang yang tahir dari seisi rumahmu boleh memakannya."
 },
 {
   "id": 4273,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 14,
   "firman": "Semua yang dikhususkan bagi TUHAN di antara orang Israel menjadi bagianmu."
 },
 {
   "id": 4274,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 15,
   "firman": "Semua yang terdahulu lahir dari kandungan segala yang hidup, yang dipersembahkan mereka kepada TUHAN, baik dari manusia maupun dari binatang, adalah bagianmu; hanya haruslah kamu menebus anak sulung manusia, juga anak sulung binatang yang najis haruslah kamu tebus."
 },
 {
   "id": 4275,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 16,
   "firman": "Mengenai uang tebusannya, dari sejak berumur satu bulan haruslah kautebus menurut nilainya, yakni lima syikal perak ditimbang menurut syikal kudus; syikal ini dua puluh gera beratnya."
 },
 {
   "id": 4276,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 17,
   "firman": "Tetapi anak sulung lembu, domba atau kambing janganlah kautebus; semuanya itu kudus; darahnya haruslah kausiramkan pada mezbah dan lemaknya kaubakar sebagai korban api-apian menjadi bau yang menyenangkan bagi TUHAN;"
 },
 {
   "id": 4277,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 18,
   "firman": "tetapi dagingnya adalah bagianmu sama seperti dada persembahan dan paha kanan."
 },
 {
   "id": 4278,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 19,
   "firman": "Segala persembahan khusus, yakni persembahan kudus yang dipersembahkan orang Israel kepada TUHAN, Aku berikan kepadamu dan kepada anak-anakmu laki-laki dan perempuan bersama-sama dengan engkau; itulah suatu ketetapan untuk selama-lamanya; itulah suatu perjanjian garam untuk selama-lamanya di hadapan TUHAN bagimu serta bagi keturunanmu.\""
 },
 {
   "id": 4279,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 20,
   "firman": "TUHAN berfirman kepada Harun: \"Di negeri mereka engkau tidak akan mendapat milik pusaka dan tidak akan beroleh bagian di tengah-tengah mereka; Akulah bagianmu dan milik pusakamu di tengah-tengah orang Israel."
 },
 {
   "id": 4280,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 21,
   "firman": "Mengenai bani Lewi, sesungguhnya Aku berikan kepada mereka segala persembahan persepuluhan di antara orang Israel sebagai milik pusakanya, untuk membalas pekerjaan yang dilakukan mereka, pekerjaan pada Kemah Pertemuan."
 },
 {
   "id": 4281,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 22,
   "firman": "Maka janganlah lagi orang Israel mendekat kepada Kemah Pertemuan, sehingga mereka mendatangkan dosa kepada dirinya, lalu mati;"
 },
 {
   "id": 4282,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 23,
   "firman": "tetapi orang Lewi, merekalah yang harus melakukan pekerjaan pada Kemah Pertemuan dan mereka harus menanggung akibat kesalahan mereka; itulah suatu ketetapan untuk selama-lamanya bagimu turun-temurun. Mereka tidak akan mendapat milik pusaka di tengah-tengah orang Israel,"
 },
 {
   "id": 4283,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 24,
   "firman": "sebab persembahan persepuluhan yang dipersembahkan orang Israel kepada TUHAN sebagai persembahan khusus Kuberikan kepada orang Lewi sebagai milik pusakanya; itulah sebabnya Aku telah berfirman tentang mereka: Mereka tidak akan mendapat milik pusaka di tengah-tengah orang Israel.\""
 },
 {
   "id": 4284,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 25,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4285,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 26,
   "firman": "\"Lagi haruslah engkau berbicara kepada orang Lewi dan berkata kepada mereka: Apabila kamu menerima dari pihak orang Israel persembahan persepuluhan yang Kuberikan kepadamu dari pihak mereka sebagai milik pusakamu, maka haruslah kamu mempersembahkan sebagian dari padanya sebagai persembahan khusus kepada TUHAN, yakni persembahan persepuluhanmu dari persembahan persepuluhan itu,"
 },
 {
   "id": 4286,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 27,
   "firman": "dan persembahan itu akan diperhitungkan sebagai persembahan khususmu, sama seperti gandum dari tempat pengirikan dan sama seperti hasil dari tempat pemerasan anggur."
 },
 {
   "id": 4287,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 28,
   "firman": "Secara demikian kamupun harus mempersembahkan sebagai persembahan khusus kepada TUHAN sebagian dari segala persembahan persepuluhan yang kamu terima dari pihak orang Israel. Dan yang dipersembahkan dari padanya sebagai persembahan khusus kepada TUHAN haruslah kamu serahkan kepada imam Harun."
 },
 {
   "id": 4288,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 29,
   "firman": "Dari segala yang diserahkan kepadamu, yakni dari segala yang terbaik di antaranya, haruslah kamu mempersembahkan seluruh persembahan khusus kepada TUHAN, sebagai bagian kudus dari padanya."
 },
 {
   "id": 4289,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 30,
   "firman": "Lagi haruslah engkau berkata kepada mereka: Apabila kamu mengkhususkan yang terbaik dari padanya, maka bagi orang Lewi haruslah hal itu dihitungkan sebagai hasil tempat pengirikan dan hasil tempat pemerasan anggur;"
 },
 {
   "id": 4290,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 31,
   "firman": "kamu boleh memakannya di setiap tempat, kamu dan seisi rumahmu, sebab upahmulah itu, untuk membalas pekerjaanmu di Kemah Pertemuan."
 },
 {
   "id": 4291,
   "kitab": "Bil",
   "pasal": 18,
   "ayat": 32,
   "firman": "Dan dalam hal itu kamu tidak akan mendatangkan dosa kepada dirimu, asal kamu mengkhususkan yang terbaik dari padanya; demikianlah kamu tidak akan melanggar kekudusan persembahan-persembahan kudus orang Israel, dan kamu tidak akan mati.\""
 },
 {
   "id": 4292,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 4293,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 2,
   "firman": "\"Inilah ketetapan hukum yang diperintahkan TUHAN dengan berfirman: Katakanlah kepada orang Israel, supaya mereka membawa kepadamu seekor lembu betina merah yang tidak bercela, yang tidak ada cacatnya dan yang belum pernah kena kuk."
 },
 {
   "id": 4294,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 3,
   "firman": "Dan haruslah kamu memberikannya kepada imam Eleazar, maka lembu itu harus dibawa ke luar tempat perkemahan, lalu disembelih di depan imam."
 },
 {
   "id": 4295,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 4,
   "firman": "Kemudian imam Eleazar harus mengambil dengan jarinya sedikit dari darah lembu itu, lalu haruslah ia memercikkan sedikit ke arah sebelah depan Kemah Pertemuan sampai tujuh kali."
 },
 {
   "id": 4296,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 5,
   "firman": "Sesudah itu haruslah lembu itu dibakar habis di depan mata imam; kulitnya, dagingnya dan darahnya haruslah dibakar habis bersama-sama dengan kotorannya."
 },
 {
   "id": 4297,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 6,
   "firman": "Dan imam haruslah mengambil kayu aras, hisop dan kain kirmizi dan melemparkannya ke tengah-tengah api yang membakar habis lembu itu."
 },
 {
   "id": 4298,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 7,
   "firman": "Kemudian haruslah imam mencuci pakaiannya dan membasuh tubuhnya dengan air, sesudah itu masuk ke tempat perkemahan, dan imam itu najis sampai matahari terbenam."
 },
 {
   "id": 4299,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 8,
   "firman": "Orang yang membakar habis lembu itu haruslah mencuci pakaiannya dengan air dan membasuh tubuhnya dengan air, dan ia najis sampai matahari terbenam."
 },
 {
   "id": 4300,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 9,
   "firman": "Maka seorang yang tahir haruslah mengumpulkan abu lembu itu dan menaruhnya pada suatu tempat yang tahir di luar tempat perkemahan, supaya semuanya itu tinggal tersimpan bagi umat Israel untuk membuat air pentahiran; itulah penghapus dosa."
 },
 {
   "id": 4301,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 10,
   "firman": "Dan orang yang mengumpulkan abu lembu itu haruslah mencuci pakaiannya, dan ia najis sampai matahari terbenam. Itulah suatu ketetapan untuk selama-lamanya bagi orang Israel dan bagi orang asing yang tinggal di tengah-tengahmu."
 },
 {
   "id": 4302,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 11,
   "firman": "Orang yang kena kepada mayat, ia najis tujuh hari lamanya."
 },
 {
   "id": 4303,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 12,
   "firman": "Ia harus menghapus dosa dari dirinya dengan air itu pada hari yang ketiga, dan pada hari yang ketujuh ia tahir. Tetapi jika pada hari yang ketiga ia tidak menghapus dosa dari dirinya, maka tidaklah ia tahir pada hari yang ketujuh."
 },
 {
   "id": 4304,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 13,
   "firman": "Setiap orang yang kena kepada mayat, yaitu tubuh manusia yang telah mati, dan tidak menghapus dosa dari dirinya, ia menajiskan Kemah Suci TUHAN, dan orang itu haruslah dilenyapkan dari Israel; karena air pentahiran tidak disiramkan kepadanya, maka ia najis; kenajisannya masih melekat padanya."
 },
 {
   "id": 4305,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 14,
   "firman": "Inilah hukumnya, apabila seseorang mati dalam suatu kemah: setiap orang yang masuk ke dalam kemah itu dan segala yang di dalam kemah itu najis tujuh hari lamanya;"
 },
 {
   "id": 4306,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 15,
   "firman": "setiap bejana yang terbuka yang tidak ada kain penutup terikat di atasnya adalah najis."
 },
 {
   "id": 4307,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 16,
   "firman": "Juga setiap orang yang di padang, yang kena kepada seorang yang mati terbunuh oleh pedang, atau kepada mayat, atau kepada tulang-tulang seorang manusia, atau kepada kubur, orang itu najis tujuh hari lamanya."
 },
 {
   "id": 4308,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 17,
   "firman": "Bagi orang yang najis haruslah diambil sedikit abu dari korban penghapus dosa yang dibakar habis, lalu di dalam bejana abu itu dibubuhi air mengalir."
 },
 {
   "id": 4309,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 18,
   "firman": "Kemudian seorang yang tahir haruslah mengambil hisop, mencelupkannya ke dalam air itu dan memercikkannya ke atas kemah dan ke atas segala bejana dan ke atas orang-orang yang ada di sana, dan ke atas orang yang telah kena kepada tulang-tulang, atau kepada orang yang mati terbunuh, atau kepada mayat, atau kepada kubur itu;"
 },
 {
   "id": 4310,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 19,
   "firman": "orang yang tahir itu haruslah memercik kepada orang yang najis itu pada hari yang ketiga dan pada hari yang ketujuh, dan pada hari yang ketujuh itu haruslah ia menghapus dosa orang itu; dan orang yang najis itu haruslah mencuci pakaiannya dan membasuh badannya dengan air, lalu ia tahir pada waktu matahari terbenam."
 },
 {
   "id": 4311,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 20,
   "firman": "Tetapi orang yang telah najis, dan tidak menghapus dosa dari dirinya, orang itu harus dilenyapkan dari tengah-tengah jemaah itu, karena ia telah menajiskan tempat kudus TUHAN; air pentahiran tidak ada disiramkan kepadanya, jadi ia tetap najis."
 },
 {
   "id": 4312,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 21,
   "firman": "Itulah yang harus menjadi ketetapan bagi mereka untuk selama-lamanya. Orang yang menyiramkan air penyuci itu, ia harus mencuci pakaiannya, dan orang yang kena kepada air penyuci itu, ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 4313,
   "kitab": "Bil",
   "pasal": 19,
   "ayat": 22,
   "firman": "Segala yang diraba orang yang najis itu menjadi najis dan orang yang kena kepadanya menjadi najis juga sampai matahari terbenam.\""
 },
 {
   "id": 4314,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 1,
   "firman": "Kemudian sampailah orang Israel, yakni segenap umat itu, ke padang gurun Zin, dalam bulan pertama, lalu tinggallah bangsa itu di Kadesh. Matilah Miryam di situ dan dikuburkan di situ."
 },
 {
   "id": 4315,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 2,
   "firman": "Pada suatu kali, ketika tidak ada air bagi umat itu, berkumpullah mereka mengerumuni Musa dan Harun,"
 },
 {
   "id": 4316,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 3,
   "firman": "dan bertengkarlah bangsa itu dengan Musa, katanya: \"Sekiranya kami mati binasa pada waktu saudara-saudara kami mati binasa di hadapan TUHAN!"
 },
 {
   "id": 4317,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 4,
   "firman": "Mengapa kamu membawa jemaah TUHAN ke padang gurun ini, supaya kami dan ternak kami mati di situ?"
 },
 {
   "id": 4318,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 5,
   "firman": "Mengapa kamu memimpin kami keluar dari Mesir, untuk membawa kami ke tempat celaka ini, yang bukan tempat menabur, tanpa pohon ara, anggur dan delima, bahkan air minumpun tidak ada?\""
 },
 {
   "id": 4319,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 6,
   "firman": "Maka pergilah Musa dan Harun dari umat itu ke pintu Kemah Pertemuan, lalu sujud. Kemudian tampaklah kemuliaan TUHAN kepada mereka."
 },
 {
   "id": 4320,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 7,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4321,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 8,
   "firman": "\"Ambillah tongkatmu itu dan engkau dan Harun, kakakmu, harus menyuruh umat itu berkumpul; katakanlah di depan mata mereka kepada bukit batu itu supaya diberi airnya; demikianlah engkau mengeluarkan air dari bukit batu itu bagi mereka dan memberi minum umat itu serta ternaknya.\""
 },
 {
   "id": 4322,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 9,
   "firman": "Lalu Musa mengambil tongkat itu dari hadapan TUHAN, seperti yang diperintahkan-Nya kepadanya."
 },
 {
   "id": 4323,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 10,
   "firman": "Ketika Musa dan Harun telah mengumpulkan jemaah itu di depan bukit batu itu, berkatalah ia kepada mereka: \"Dengarlah kepadaku, hai orang-orang durhaka, apakah kami harus mengeluarkan air bagimu dari bukit batu ini?\""
 },
 {
   "id": 4324,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 11,
   "firman": "Sesudah itu Musa mengangkat tangannya, lalu memukul bukit batu itu dengan tongkatnya dua kali, maka keluarlah banyak air, sehingga umat itu dan ternak mereka dapat minum."
 },
 {
   "id": 4325,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 12,
   "firman": "Tetapi TUHAN berfirman kepada Musa dan Harun: \"Karena kamu tidak percaya kepada-Ku dan tidak menghormati kekudusan-Ku di depan mata orang Israel, itulah sebabnya kamu tidak akan membawa jemaah ini masuk ke negeri yang akan Kuberikan kepada mereka.\""
 },
 {
   "id": 4326,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 13,
   "firman": "Itulah mata air Meriba, tempat orang Israel bertengkar dengan TUHAN dan Ia menunjukkan kekudusan-Nya di antara mereka."
 },
 {
   "id": 4327,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 14,
   "firman": "Kemudian Musa mengirim utusan dari Kadesh kepada raja Edom dengan pesan: \"Beginilah perkataan saudaramu Israel: Engkau tahu segala kesusahan yang telah menimpa kami,"
 },
 {
   "id": 4328,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 15,
   "firman": "bahwa nenek moyang kami pergi ke Mesir, dan kami lama diam di Mesir dan kami dan nenek moyang kami diperlakukan dengan jahat oleh orang Mesir;"
 },
 {
   "id": 4329,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 16,
   "firman": "bahwa kami berteriak kepada TUHAN, dan Ia mendengarkan suara kami, mengutus seorang malaikat dan menuntun kami keluar dari Mesir. Sekarang ini kami ada di Kadesh, sebuah kota di tepi perbatasanmu."
 },
 {
   "id": 4330,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 17,
   "firman": "Izinkanlah kiranya kami melalui negerimu; kami tidak akan berjalan melalui ladang-ladang dan kebun-kebun anggurmu dan kami tidak akan minum air sumurmu; jalan besar saja akan kami jalani dengan tidak menyimpang ke kanan atau ke kiri, sampai kami melalui batas daerahmu.\""
 },
 {
   "id": 4331,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 18,
   "firman": "Tetapi orang Edom berkata kepada mereka: \"Tidak boleh kamu melalui daerah kami, nanti kami keluar menjumpai kamu dengan pedang!\""
 },
 {
   "id": 4332,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 19,
   "firman": "Lalu berkatalah orang Israel kepadanya: \"Kami akan berjalan melalui jalan raya, dan jika kami dan ternak kami minum airmu, maka kami akan membayar uangnya, asal kami diizinkan lalu dengan berjalan kaki, hanya itu saja.\""
 },
 {
   "id": 4333,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 20,
   "firman": "Tetapi jawab mereka: \"Tidak boleh kamu lalu.\" Maka keluarlah orang Edom menghadapi mereka dengan banyak rakyatnya dan dengan tentara yang kuat."
 },
 {
   "id": 4334,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 21,
   "firman": "Ketika orang Edom tidak mau mengizinkan orang Israel lalu dari daerahnya, maka orang Israel menyimpang meninggalkannya."
 },
 {
   "id": 4335,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 22,
   "firman": "Setelah mereka berangkat dari Kadesh, sampailah segenap umat Israel ke gunung Hor."
 },
 {
   "id": 4336,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 23,
   "firman": "Lalu berkatalah TUHAN kepada Musa dan Harun dekat gunung Hor, di perbatasan tanah Edom:"
 },
 {
   "id": 4337,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 24,
   "firman": "\"Harun akan dikumpulkan kepada kaum leluhurnya, sebab ia tidak akan masuk ke negeri yang Kuberikan kepada orang Israel, karena kamu berdua telah mendurhaka kepada titah-Ku dekat mata air Meriba."
 },
 {
   "id": 4338,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 25,
   "firman": "Panggillah Harun dan Eleazar, anaknya, dan bawalah mereka naik ke gunung Hor;"
 },
 {
   "id": 4339,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 26,
   "firman": "tanggalkanlah pakaian Harun dan kenakanlah itu kepada Eleazar, anaknya, kemudian Harun akan dikumpulkan kepada kaum leluhurnya dan mati di sana.\""
 },
 {
   "id": 4340,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 27,
   "firman": "Lalu Musa melakukan seperti yang diperintahkan TUHAN. Mereka naik ke gunung Hor sedang segenap umat itu memandangnya."
 },
 {
   "id": 4341,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 28,
   "firman": "Musa menanggalkan pakaian Harun dan mengenakannya kepada Eleazar, anaknya. Lalu matilah Harun di puncak gunung itu, kemudian Musa dengan Eleazar turun dari gunung itu."
 },
 {
   "id": 4342,
   "kitab": "Bil",
   "pasal": 20,
   "ayat": 29,
   "firman": "Ketika segenap umat itu melihat, bahwa Harun telah mati, maka seluruh orang Israel menangisi Harun tiga puluh hari lamanya."
 },
 {
   "id": 4343,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 1,
   "firman": "Raja negeri Arad, orang Kanaan yang tinggal di Tanah Negeb, mendengar, bahwa Israel datang dari jalan Atarim, lalu ia berperang melawan Israel, dan diangkutnya beberapa orang tawanan dari pada mereka."
 },
 {
   "id": 4344,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 2,
   "firman": "Maka bernazarlah orang Israel kepada TUHAN, katanya: \"Jika Engkau serahkan bangsa ini sama sekali ke dalam tangan kami, kami akan menumpas kota-kota mereka sampai binasa.\""
 },
 {
   "id": 4345,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 3,
   "firman": "TUHAN mendengarkan permintaan orang Israel, lalu menyerahkan orang Kanaan itu; kemudian orang-orang itu dan kota-kotanya ditumpas sampai binasa. Itulah sebabnya tempat itu dinamai Horma."
 },
 {
   "id": 4346,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 4,
   "firman": "Setelah mereka berangkat dari gunung Hor, berjalan ke arah Laut Teberau untuk mengelilingi tanah Edom, maka bangsa itu tidak dapat lagi menahan hati di tengah jalan."
 },
 {
   "id": 4347,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 5,
   "firman": "Lalu mereka berkata-kata melawan Allah dan Musa: \"Mengapa kamu memimpin kami keluar dari Mesir? Supaya kami mati di padang gurun ini? Sebab di sini tidak ada roti dan tidak ada air, dan akan makanan hambar ini kami telah muak.\""
 },
 {
   "id": 4348,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 6,
   "firman": "Lalu TUHAN menyuruh ular-ular tedung ke antara bangsa itu, yang memagut mereka, sehingga banyak dari orang Israel yang mati."
 },
 {
   "id": 4349,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 7,
   "firman": "Kemudian datanglah bangsa itu mendapatkan Musa dan berkata: \"Kami telah berdosa, sebab kami berkata-kata melawan TUHAN dan engkau; berdoalah kepada TUHAN, supaya dijauhkan-Nya ular-ular ini dari pada kami.\" Lalu Musa berdoa untuk bangsa itu."
 },
 {
   "id": 4350,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 8,
   "firman": "Maka berfirmanlah TUHAN kepada Musa: \"Buatlah ular tedung dan taruhlah itu pada sebuah tiang; maka setiap orang yang terpagut, jika ia melihatnya, akan tetap hidup.\""
 },
 {
   "id": 4351,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 9,
   "firman": "Lalu Musa membuat ular tembaga dan menaruhnya pada sebuah tiang; maka jika seseorang dipagut ular, dan ia memandang kepada ular tembaga itu, tetaplah ia hidup."
 },
 {
   "id": 4352,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 10,
   "firman": "Kemudian berangkatlah orang Israel, lalu berkemah di Obot."
 },
 {
   "id": 4353,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 11,
   "firman": "Berangkatlah mereka dari Obot, lalu berkemah dekat reruntuhan di Abarim, di padang gurun yang di sebelah timur Moab."
 },
 {
   "id": 4354,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 12,
   "firman": "Dari situ berangkatlah mereka, lalu berkemah di lembah Zered."
 },
 {
   "id": 4355,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 13,
   "firman": "Dari situ berangkatlah mereka, lalu berkemah di seberang sungai Arnon yang di padang gurun dan yang keluar dari daerah orang Amori, sebab sungai Arnon ialah batas Moab, di antara orang Moab dan orang Amori."
 },
 {
   "id": 4356,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 14,
   "firman": "Itulah sebabnya dikatakan dalam kitab peperangan TUHAN: \"Waheb di Sufa dan lembah-lembah ke sungai Arnon,"
 },
 {
   "id": 4357,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 15,
   "firman": "dan lereng lembah-lembah; lereng itu terbentang ke tempat di mana terletak kota Ar, dan bersandar pada batas daerah Moab.\""
 },
 {
   "id": 4358,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 16,
   "firman": "Dari sana mereka ke Beer. Inilah sumur di mana TUHAN berfirman kepada Musa: \"Kumpulkanlah bangsa itu, maka Aku akan memberikan air kepada mereka.\""
 },
 {
   "id": 4359,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 17,
   "firman": "Pada waktu itu orang Israel menyanyikan nyanyian ini: \"Berbual-buallah, hai sumur! Mari kita bernyanyi-nyanyi berbalas-balasan karena sumur yang digali oleh raja-raja,"
 },
 {
   "id": 4360,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 18,
   "firman": "yang dikorek oleh kaum bangsawan di antara bangsa itu dengan tongkat-tongkat kerajaan, dengan tongkat-tongkat mereka.\" Dan dari padang gurun mereka ke Matana;"
 },
 {
   "id": 4361,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 19,
   "firman": "dari Matana ke Nahaliel; dari Nahaliel ke Bamot;"
 },
 {
   "id": 4362,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 20,
   "firman": "dari Bamot ke lembah yang di daerah Moab, dekat puncak gunung Pisga yang menghadap Padang Belantara."
 },
 {
   "id": 4363,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 21,
   "firman": "Kemudian orang Israel mengirim utusan kepada Sihon, raja orang Amori, dengan pesan:"
 },
 {
   "id": 4364,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 22,
   "firman": "\"Izinkanlah kami melalui negerimu; kami tidak akan menyimpang masuk ke ladang-ladang dan kebun-kebun anggurmu, kami tidak akan minum air sumurmu, di jalan besar saja kami akan berjalan, sampai kami melalui batas daerahmu.\""
 },
 {
   "id": 4365,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 23,
   "firman": "Tetapi Sihon tidak mengizinkan orang Israel berjalan melalui daerahnya, bahkan ia mengumpulkan seluruh laskarnya, lalu keluar ke padang gurun menghadapi orang Israel, dan sesampainya di Yahas berperanglah ia melawan orang Israel."
 },
 {
   "id": 4366,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 24,
   "firman": "Tetapi orang Israel mengalahkan dia dengan mata pedang dan menduduki negerinya dari sungai Arnon sampai ke sungai Yabok, sampai kepada bani Amon, sebab batas daerah bani Amon itu kuat."
 },
 {
   "id": 4367,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 25,
   "firman": "Dan orang Israel merebut segala kota itu, lalu menetaplah mereka di segala kota orang Amori, di Hesybon dan segala anak kotanya."
 },
 {
   "id": 4368,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 26,
   "firman": "Sebab Hesybon ialah kota kediaman Sihon, raja orang Amori; raja ini tadinya berperang melawan raja Moab yang lalu, dan merebut dari tangannya seluruh negerinya sampai ke sungai Arnon."
 },
 {
   "id": 4369,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 27,
   "firman": "Itulah sebabnya penyair-penyair berkata: \"Datanglah ke Hesybon, baiklah dibangun dan baiklah diperkuat kota kediaman Sihon itu!"
 },
 {
   "id": 4370,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 28,
   "firman": "Sebab api keluar dari Hesybon, nyala dari kota kediaman Sihon, yang memakan habis Ar-Moab, yang berkuasa atas bukit-bukit di sepanjang sungai Arnon."
 },
 {
   "id": 4371,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 29,
   "firman": "Celakalah engkau, ya Moab; binasa engkau, ya bangsa Kamos! Ia membuat anak-anaknya lelaki menjadi orang-orang pelarian, dan anak-anaknya perempuan menjadi tawanan kepada Sihon, raja orang Amori."
 },
 {
   "id": 4372,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 30,
   "firman": "Kita telah menembaki mereka, Hesybon binasa sampai ke Dibon, dan kita menanduskannya sampai ke Nofah, yang terbentang sampai ke Medeba.\""
 },
 {
   "id": 4373,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 31,
   "firman": "Demikianlah orang Israel diam di negeri orang Amori."
 },
 {
   "id": 4374,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 32,
   "firman": "Setelah Musa menyuruh orang mengintai kota Yaezer, mereka merebut segala anak kota Yaezer dan menghalau orang-orang Amori yang ada di situ."
 },
 {
   "id": 4375,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 33,
   "firman": "Kemudian berpalinglah mereka dan maju ke arah Basan. Lalu Og, raja Basan, beserta segala rakyatnya maju ke Edrei menjumpai mereka untuk berperang."
 },
 {
   "id": 4376,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 34,
   "firman": "Tetapi TUHAN berfirman kepada Musa: \"Janganlah takut kepadanya, sebab Aku menyerahkan dia dengan seluruh rakyatnya dan negerinya ke dalam tanganmu, dan haruslah kaulakukan kepadanya seperti yang kaulakukan kepada Sihon, raja orang Amori, yang diam di Hesybon.\""
 },
 {
   "id": 4377,
   "kitab": "Bil",
   "pasal": 21,
   "ayat": 35,
   "firman": "Maka mereka mengalahkan dia dan anak-anaknya dan seluruh rakyatnya, sehingga seorangpun dari mereka tidak ada yang dibiarkan terlepas; lalu mereka menduduki negerinya."
 },
 {
   "id": 4378,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 1,
   "firman": "Kemudian berangkatlah orang Israel, dan berkemah di dataran Moab, di daerah seberang sungai Yordan dekat Yerikho."
 },
 {
   "id": 4379,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 2,
   "firman": "Balak bin Zipor melihat segala yang dilakukan Israel kepada orang Amori."
 },
 {
   "id": 4380,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 3,
   "firman": "Maka sangat gentarlah orang Moab terhadap bangsa itu, karena jumlahnya banyak, lalu muak dan takutlah orang Moab karena orang Israel."
 },
 {
   "id": 4381,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 4,
   "firman": "Lalu berkatalah orang Moab kepada para tua-tua Midian: \"Tentu saja laskar besar itu akan membabat habis segala sesuatu yang di sekeliling kita, seperti lembu membabat habis tumbuh-tumbuhan hijau di padang.\" Adapun pada waktu itu Balak bin Zipor menjadi raja Moab."
 },
 {
   "id": 4382,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 5,
   "firman": "Raja ini mengirim utusan kepada Bileam bin Beor, ke Petor yang di tepi sungai Efrat, ke negeri teman-teman sebangsanya, untuk memanggil dia, dengan pesan: \"Ketahuilah, ada suatu bangsa keluar dari Mesir; sungguh, sampai tertutup permukaan bumi olehnya, dan mereka sedang berkemah di depanku."
 },
 {
   "id": 4383,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 6,
   "firman": "Karena itu, datanglah dan kutuk bangsa itu bagiku, sebab mereka lebih kuat dari padaku; mungkin aku sanggup mengalahkannya dan menghalaunya dari negeri ini, sebab aku tahu: siapa yang kauberkati, dia beroleh berkat, dan siapa yang kaukutuk, dia kena kutuk.\""
 },
 {
   "id": 4384,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 7,
   "firman": "Lalu berangkatlah para tua-tua Moab dan para tua-tua Midian dengan membawa di tangannya upah penenung; setelah mereka sampai kepada Bileam, disampaikanlah kepadanya pesan Balak."
 },
 {
   "id": 4385,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 8,
   "firman": "Lalu berkatalah Bileam kepada mereka: \"Bermalamlah di sini pada malam ini, maka aku akan memberi jawab kepadamu, sesuai dengan apa yang akan difirmankan TUHAN kepadaku.\" Maka tinggallah pemuka-pemuka Moab itu pada Bileam."
 },
 {
   "id": 4386,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 9,
   "firman": "Kemudian datanglah Allah kepada Bileam serta berfirman: \"Siapakah orang-orang yang bersama-sama dengan engkau itu?\""
 },
 {
   "id": 4387,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 10,
   "firman": "Dan berkatalah Bileam kepada Allah: \"Balak bin Zipor, raja Moab, mengutus orang kepadaku dengan pesan:"
 },
 {
   "id": 4388,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 11,
   "firman": "Ketahuilah, ada bangsa yang keluar dari Mesir, dan permukaan bumi tertutup olehnya; karena itu, datanglah, serapahlah mereka bagiku, mungkin aku akan sanggup berperang melawan mereka dan menghalau mereka.\""
 },
 {
   "id": 4389,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 12,
   "firman": "Lalu berfirmanlah Allah kepada Bileam: \"Janganlah engkau pergi bersama-sama dengan mereka, janganlah engkau mengutuk bangsa itu, sebab mereka telah diberkati.\""
 },
 {
   "id": 4390,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 13,
   "firman": "Bangunlah Bileam pada waktu pagi, lalu berkata kepada pemuka-pemuka Balak: \"Pulanglah ke negerimu, sebab TUHAN tidak mengizinkan aku pergi bersama-sama dengan kamu.\""
 },
 {
   "id": 4391,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 14,
   "firman": "Lalu berangkatlah pemuka-pemuka Moab itu dan setelah mereka sampai kepada Balak, berkatalah mereka: \"Bileam menolak datang bersama-sama dengan kami.\""
 },
 {
   "id": 4392,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 15,
   "firman": "Tetapi Balak mengutus pula pemuka-pemuka lebih banyak dan lebih terhormat dari yang pertama."
 },
 {
   "id": 4393,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 16,
   "firman": "Setelah mereka sampai kepada Bileam, berkatalah mereka kepadanya: \"Beginilah kata Balak bin Zipor: Janganlah biarkan dirimu terhalang-halang untuk datang kepadaku,"
 },
 {
   "id": 4394,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 17,
   "firman": "sebab aku akan memberi upahmu sangat banyak, dan apapun yang kauminta dari padaku, aku akan mengabulkannya. Datanglah, dan serapahlah bangsa itu bagiku.\""
 },
 {
   "id": 4395,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 18,
   "firman": "Tetapi Bileam menjawab kepada pegawai-pegawai Balak: \"Sekalipun Balak memberikan kepadaku emas dan perak seistana penuh, aku tidak akan sanggup berbuat sesuatu, yang kecil atau yang besar, yang melanggar titah TUHAN, Allahku."
 },
 {
   "id": 4396,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 19,
   "firman": "Oleh sebab itu, baiklah kamupun tinggal di sini pada malam ini, supaya aku tahu, apakah pula yang akan difirmankan TUHAN kepadaku.\""
 },
 {
   "id": 4397,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 20,
   "firman": "Datanglah Allah kepada Bileam pada waktu malam serta berfirman kepadanya: \"Jikalau orang-orang itu memang sudah datang untuk memanggil engkau, bangunlah, pergilah bersama-sama dengan mereka, tetapi hanya apa yang akan Kufirmankan kepadamu harus kaulakukan.\""
 },
 {
   "id": 4398,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 21,
   "firman": "Lalu bangunlah Bileam pada waktu pagi, dipelanainyalah keledainya yang betina, dan pergi bersama-sama dengan pemuka-pemuka Moab."
 },
 {
   "id": 4399,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 22,
   "firman": "Tetapi bangkitlah murka Allah ketika ia pergi, dan berdirilah Malaikat TUHAN di jalan sebagai lawannya. Bileam mengendarai keledainya yang betina dan dua orang bujangnya ada bersama-sama dengan dia."
 },
 {
   "id": 4400,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 23,
   "firman": "Ketika keledai itu melihat Malaikat TUHAN berdiri di jalan, dengan pedang terhunus di tangan-Nya, menyimpanglah keledai itu dari jalan dan masuk ke ladang. Maka Bileam memukul keledai itu untuk memalingkannya kembali ke jalan."
 },
 {
   "id": 4401,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 24,
   "firman": "Kemudian pergilah Malaikat TUHAN berdiri pada jalan yang sempit di antara kebun-kebun anggur dengan tembok sebelah-menyebelah."
 },
 {
   "id": 4402,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 25,
   "firman": "Ketika keledai itu melihat Malaikat TUHAN, ditekankannyalah dirinya kepada tembok, sehingga kaki Bileam terhimpit kepada tembok. Maka ia memukulnya pula."
 },
 {
   "id": 4403,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 26,
   "firman": "Berjalanlah pula Malaikat TUHAN terus dan berdirilah Ia pada suatu tempat yang sempit, yang tidak ada jalan untuk menyimpang ke kanan atau ke kiri."
 },
 {
   "id": 4404,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 27,
   "firman": "Melihat Malaikat TUHAN meniaraplah keledai itu dengan Bileam masih di atasnya. Maka bangkitlah amarah Bileam, lalu dipukulnyalah keledai itu dengan tongkat."
 },
 {
   "id": 4405,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 28,
   "firman": "Ketika itu TUHAN membuka mulut keledai itu, sehingga ia berkata kepada Bileam: \"Apakah yang kulakukan kepadamu, sampai engkau memukul aku tiga kali?\""
 },
 {
   "id": 4406,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 29,
   "firman": "Jawab Bileam kepada keledai itu: \"Karena engkau mempermain-mainkan aku; seandainya ada pedang di tanganku, tentulah engkau kubunuh sekarang.\""
 },
 {
   "id": 4407,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 30,
   "firman": "Tetapi keledai itu berkata kepada Bileam: \"Bukankah aku ini keledaimu yang kautunggangi selama hidupmu sampai sekarang? Pernahkah aku berbuat demikian kepadamu?\" Jawabnya: \"Tidak.\""
 },
 {
   "id": 4408,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 31,
   "firman": "Kemudian TUHAN menyingkapkan mata Bileam; dilihatnyalah Malaikat TUHAN dengan pedang terhunus di tangan-Nya berdiri di jalan, lalu berlututlah ia dan sujud."
 },
 {
   "id": 4409,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 32,
   "firman": "Berfirmanlah Malaikat TUHAN kepadanya: \"Apakah sebabnya engkau memukul keledaimu sampai tiga kali? Lihat, Aku keluar sebagai lawanmu, sebab jalan ini pada pemandangan-Ku menuju kepada kebinasaan."
 },
 {
   "id": 4410,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 33,
   "firman": "Ketika keledai ini melihat Aku, telah tiga kali ia menyimpang dari hadapan-Ku; jika ia tidak menyimpang dari hadapan-Ku, tentulah engkau yang Kubunuh pada waktu itu juga dan dia Kubiarkan hidup.\""
 },
 {
   "id": 4411,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 34,
   "firman": "Lalu berkatalah Bileam kepada Malaikat TUHAN: \"Aku telah berdosa, karena aku tidak mengetahui, bahwa Engkau ini berdiri di jalan menentang aku. Maka sekarang, jika hal itu jahat di mata-Mu, aku mau pulang.\""
 },
 {
   "id": 4412,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 35,
   "firman": "Tetapi Malaikat TUHAN berfirman kepada Bileam: \"Pergilah bersama-sama dengan orang-orang itu, tetapi hanyalah perkataan yang akan Kukatakan kepadamu harus kaukatakan.\" Sesudah itu pergilah Bileam bersama-sama dengan pemuka-pemuka Balak itu."
 },
 {
   "id": 4413,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 36,
   "firman": "Ketika Balak mendengar, bahwa Bileam datang, keluarlah ia menyongsong dia sampai ke Kota Moab di perbatasan sungai Arnon, pada ujung perbatasan itu."
 },
 {
   "id": 4414,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 37,
   "firman": "Dan berkatalah Balak kepada Bileam: \"Bukankah aku sudah mengutus orang memanggil engkau? Mengapakah engkau tidak hendak datang kepadaku? Sungguhkah tidak sanggup aku memberi upahmu?\""
 },
 {
   "id": 4415,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 38,
   "firman": "Tetapi berkatalah Bileam kepada Balak: \"Ini aku sudah datang kepadamu sekarang; tetapi akan mungkinkah aku dapat mengatakan apa-apa? Perkataan yang akan ditaruh Allah ke dalam mulutku, itulah yang akan kukatakan.\""
 },
 {
   "id": 4416,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 39,
   "firman": "Lalu pergilah Bileam bersama-sama dengan Balak dan sampailah mereka ke Kiryat-Huzot."
 },
 {
   "id": 4417,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 40,
   "firman": "Balak mengorbankan beberapa ekor lembu sapi dan kambing domba dan mengirimkan sebagian kepada Bileam dan kepada pemuka-pemuka yang bersama-sama dengan dia."
 },
 {
   "id": 4418,
   "kitab": "Bil",
   "pasal": 22,
   "ayat": 41,
   "firman": "Keesokan harinya Balak mengambil Bileam dan membawa dia mendaki bukit Baal. Dari situ dilihatnyalah bagian yang paling ujung dari bangsa Israel."
 },
 {
   "id": 4419,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 1,
   "firman": "Lalu berkatalah Bileam kepada Balak: \"Dirikanlah bagiku di sini tujuh mezbah dan siapkanlah bagiku di sini tujuh ekor lembu jantan dan tujuh ekor domba jantan.\""
 },
 {
   "id": 4420,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 2,
   "firman": "Balak melakukan seperti yang dikatakan Bileam, maka Balak dan Bileam mempersembahkan seekor lembu jantan dan seekor domba jantan di atas setiap mezbah itu."
 },
 {
   "id": 4421,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 3,
   "firman": "Sesudah itu berkatalah Bileam kepada Balak: \"Berdirilah di samping korban bakaranmu, tetapi aku ini hendak pergi; mungkin TUHAN akan datang menemui aku, dan perkataan apapun yang dinyatakan-Nya kepadaku, akan kuberitahukan kepadamu.\" Lalu pergilah ia ke atas sebuah bukit yang gundul."
 },
 {
   "id": 4422,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 4,
   "firman": "Maka Allah menemui Bileam, lalu Bileam berkata kepada-Nya: \"Ketujuh mezbah itu telah kuatur, dan kupersembahkan seekor lembu jantan dan seekor domba jantan di atas setiap mezbah.\""
 },
 {
   "id": 4423,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 5,
   "firman": "Kemudian TUHAN menaruh perkataan ke dalam mulut Bileam dan berfirman: \"Kembalilah kepada Balak dan katakanlah demikian.\""
 },
 {
   "id": 4424,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 6,
   "firman": "Ketika ia kembali, maka Balak masih berdiri di situ di samping korban bakarannya, bersama dengan semua pemuka Moab."
 },
 {
   "id": 4425,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 7,
   "firman": "Lalu Bileam mengucapkan sanjaknya, katanya: \"Dari Aram aku disuruh datang oleh Balak, raja Moab, dari gunung-gunung sebelah timur: Datanglah, katanya, kutuklah bagiku Yakub, dan datanglah, kutuklah Israel."
 },
 {
   "id": 4426,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 8,
   "firman": "Bagaimanakah aku menyerapah yang tidak diserapah Allah? Bagaimanakah aku mengutuk yang tidak dikutuk TUHAN?"
 },
 {
   "id": 4427,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 9,
   "firman": "Sebab dari puncak gunung-gunung batu aku melihat mereka, dari bukit-bukit aku memandang mereka. Lihat, suatu bangsa yang diam tersendiri dan tidak mau dihitung di antara bangsa-bangsa kafir."
 },
 {
   "id": 4428,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 10,
   "firman": "Siapakah yang menghitung debu Yakub dan siapakah yang membilang bondongan-bondongan Israel? Sekiranya aku mati seperti matinya orang-orang jujur dan sekiranya ajalku seperti ajal mereka!\""
 },
 {
   "id": 4429,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 11,
   "firman": "Lalu berkatalah Balak kepada Bileam: \"Apakah yang kaulakukan kepadaku ini? Untuk menyerapah musuhkulah aku menjemput engkau, tetapi sebaliknya engkau memberkati mereka.\""
 },
 {
   "id": 4430,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 12,
   "firman": "Tetapi ia menjawab: \"Bukankah aku harus berawas-awas, supaya mengatakan apa yang ditaruh TUHAN ke dalam mulutku?\""
 },
 {
   "id": 4431,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 13,
   "firman": "Lalu Balak berkata kepadanya: \"Baiklah pergi bersama-sama dengan aku ke tempat lain, dan dari sana engkau dapat melihat bangsa itu; engkau akan melihat hanya bagiannya yang paling ujung, tetapi seluruhnya tidak akan kaulihat; serapahlah mereka dari situ bagiku.\""
 },
 {
   "id": 4432,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 14,
   "firman": "Lalu dibawanyalah dia ke Padang Pengintai, ke puncak gunung Pisga; ia mendirikan tujuh mezbah dan mempersembahkan seekor lembu jantan dan seekor domba jantan di atas setiap mezbah itu."
 },
 {
   "id": 4433,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 15,
   "firman": "Kemudian berkatalah ia kepada Balak: \"Berdirilah di sini di samping korban bakaranmu, sedang aku hendak bertemu dengan TUHAN di situ.\""
 },
 {
   "id": 4434,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 16,
   "firman": "Lalu TUHAN menemui Bileam dan menaruh perkataan ke dalam mulutnya, dan berfirman: \"Kembalilah kepada Balak dan katakanlah demikian.\""
 },
 {
   "id": 4435,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 17,
   "firman": "Ketika ia sampai kepadanya, Balak masih berdiri di samping korban bakarannya bersama-sama dengan pemuka-pemuka Moab. Berkatalah Balak kepadanya: \"Apakah yang difirmankan TUHAN?\""
 },
 {
   "id": 4436,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 18,
   "firman": "Lalu diucapkannyalah sanjaknya, katanya: \"Bangunlah, hai Balak, dan dengarlah; pasanglah telingamu mendengarkan aku, ya anak Zipor."
 },
 {
   "id": 4437,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 19,
   "firman": "Allah bukanlah manusia, sehingga Ia berdusta bukan anak manusia, sehingga Ia menyesal. Masakan Ia berfirman dan tidak melakukannya, atau berbicara dan tidak menepatinya?"
 },
 {
   "id": 4438,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 20,
   "firman": "Ketahuilah, aku mendapat perintah untuk memberkati, dan apabila Dia memberkati, maka aku tidak dapat membalikkannya."
 },
 {
   "id": 4439,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 21,
   "firman": "Tidak ada ditengok kepincangan di antara keturunan Yakub, dan tidak ada dilihat kesukaran di antara orang Israel. TUHAN, Allah mereka, menyertai mereka, dan sorak-sorak karena Raja ada di antara mereka."
 },
 {
   "id": 4440,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 22,
   "firman": "Allah, yang membawa mereka keluar dari Mesir, adalah bagi mereka seperti tanduk kekuatan lembu hutan,"
 },
 {
   "id": 4441,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 23,
   "firman": "sebab tidak ada mantera yang mempan terhadap Yakub, ataupun tenungan yang mempan terhadap Israel. Pada waktunya akan dikatakan kepada Yakub, begitu juga kepada Israel, keajaiban yang diperbuat Allah:"
 },
 {
   "id": 4442,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 24,
   "firman": "Lihat, suatu bangsa, yang bangkit seperti singa betina, dan yang berdiri tegak seperti singa jantan, yang tidak membaringkan dirinya, sebelum ia memakan mangsanya dan meminum darah dari yang mati dibunuhnya.\""
 },
 {
   "id": 4443,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 25,
   "firman": "Lalu berkatalah Balak kepada Bileam: \"Jika sekali-kali tidak mau engkau menyerapah mereka, janganlah sekali-kali memberkatinya.\""
 },
 {
   "id": 4444,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 26,
   "firman": "Tetapi Bileam menjawab Balak: \"Bukankah telah kukatakan kepadamu: Segala yang akan difirmankan TUHAN, itulah yang akan kulakukan.\""
 },
 {
   "id": 4445,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 27,
   "firman": "Kemudian berkatalah Balak kepada Bileam: \"Marilah aku akan membawa engkau ke tempat lain; mungkin benar di mata Allah bahwa engkau menyerapah mereka bagiku dari tempat itu.\""
 },
 {
   "id": 4446,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 28,
   "firman": "Lalu Balak membawa Bileam ke puncak gunung Peor, yang menghadap Padang Belantara."
 },
 {
   "id": 4447,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 29,
   "firman": "Berkatalah Bileam kepada Balak: \"Dirikanlah bagiku di sini tujuh mezbah dan siapkanlah di sini bagiku tujuh ekor lembu jantan dan tujuh ekor domba jantan.\""
 },
 {
   "id": 4448,
   "kitab": "Bil",
   "pasal": 23,
   "ayat": 30,
   "firman": "Lalu Balak melakukan seperti yang dikatakan Bileam, maka ia mempersembahkan seekor lembu jantan dan seekor domba jantan di atas setiap mezbah itu."
 },
 {
   "id": 4449,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 1,
   "firman": "Ketika dilihat Bileam, bahwa baik di mata TUHAN untuk memberkati Israel, ia tidak mencarikan pertanda lagi seperti yang sudah-sudah, tetapi ia menghadapkan mukanya ke arah padang gurun."
 },
 {
   "id": 4450,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 2,
   "firman": "Ketika Bileam memandang ke depan dan melihat orang Israel berkemah menurut suku mereka, maka Roh Allah menghinggapi dia."
 },
 {
   "id": 4451,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 3,
   "firman": "Lalu diucapkannyalah sanjaknya, katanya: \"Tutur kata Bileam bin Beor, tutur kata orang yang terbuka matanya;"
 },
 {
   "id": 4452,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 4,
   "firman": "tutur kata orang yang mendengar firman Allah, yang melihat penglihatan dari Yang Mahakuasa sambil rebah, namun dengan mata tersingkap."
 },
 {
   "id": 4453,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 5,
   "firman": "Alangkah indahnya kemah-kemahmu, hai Yakub, dan tempat-tempat kediamanmu, hai Israel!"
 },
 {
   "id": 4454,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 6,
   "firman": "Sebagai lembah yang membentang semuanya; sebagai taman di tepi sungai; sebagai pohon gaharu yang ditanam TUHAN; sebagai pohon aras di tepi air."
 },
 {
   "id": 4455,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 7,
   "firman": "Air mengalir dari timbanya, dan benihnya mendapat air banyak-banyak. Rajanya akan naik tinggi melebihi Agag, dan kerajaannya akan dimuliakan."
 },
 {
   "id": 4456,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 8,
   "firman": "Allah, yang membawa mereka keluar dari Mesir, adalah bagi mereka seperti tanduk kekuatan lembu hutan. Bangsa-bangsa yang menjadi lawannya akan ditelannya habis, dan tulang-tulang mereka akan dihancurkannya dan akan ditembaknya tembus dengan panah-panahnya."
 },
 {
   "id": 4457,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 9,
   "firman": "Ia meniarap dan merebahkan diri sebagai singa jantan, dan sebagai singa betina; siapakah yang berani membangunkannya? Diberkatilah orang yang memberkati engkau, dan terkutuklah orang yang mengutuk engkau!\""
 },
 {
   "id": 4458,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 10,
   "firman": "Lalu bangkitlah amarah Balak terhadap Bileam dan dengan meremas-remas jarinya berkatalah ia kepada Bileam: \"Untuk menyerapah musuhku aku memanggil engkau, tetapi sebaliknya sampai tiga kali engkau memberkati mereka."
 },
 {
   "id": 4459,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 11,
   "firman": "Oleh sebab itu, enyahlah engkau ke tempat kediamanmu; aku telah berkata kepadamu aku telah bermaksud memberi banyak upah kepadamu, tetapi TUHAN telah mencegah engkau memperolehnya.\""
 },
 {
   "id": 4460,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 12,
   "firman": "Tetapi berkatalah Bileam kepada Balak: \"Bukankah telah kukatakan juga kepada utusan-utusan yang kaukirim kepadaku:"
 },
 {
   "id": 4461,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 13,
   "firman": "Sekalipun Balak memberikan kepadaku emas dan perak seistana penuh, aku tidak akan sanggup melanggar titah TUHAN dengan berbuat baik atau jahat atas kemauanku sendiri; apa yang akan difirmankan TUHAN, itulah yang akan kukatakan."
 },
 {
   "id": 4462,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 14,
   "firman": "Dan sekarang, aku ini sudah hendak pergi kepada bangsaku; marilah kuberitahukan kepadamu apa yang akan dilakukan bangsa itu kepada bangsamu di kemudian hari.\""
 },
 {
   "id": 4463,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 15,
   "firman": "Lalu diucapkannyalah sanjaknya, katanya: \"Tutur kata Bileam bin Beor, tutur kata orang yang terbuka matanya;"
 },
 {
   "id": 4464,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 16,
   "firman": "tutur kata orang yang mendengar firman Allah, dan yang beroleh pengenalan akan Yang Mahatinggi, yang melihat penglihatan dari Yang Mahakuasa, sambil rebah, namun dengan mata tersingkap."
 },
 {
   "id": 4465,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 17,
   "firman": "Aku melihat dia, tetapi bukan sekarang; aku memandang dia, tetapi bukan dari dekat; bintang terbit dari Yakub, tongkat kerajaan timbul dari Israel, dan meremukkan pelipis-pelipis Moab, dan menghancurkan semua anak Set."
 },
 {
   "id": 4466,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 18,
   "firman": "Maka Edom akan menjadi tanah pendudukan dan Seir akan menjadi tanah pendudukan--musuh-musuhnya itu. Tetapi Israel akan melakukan perbuatan-perbuatan yang gagah perkasa,"
 },
 {
   "id": 4467,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 19,
   "firman": "dan dari Yakub akan timbul seorang penguasa, yang akan membinasakan orang-orang yang melarikan diri dari kota.\""
 },
 {
   "id": 4468,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 20,
   "firman": "Ketika ia melihat orang Amalek, diucapkannyalah sanjaknya, katanya: \"Yang pertama di antara bangsa-bangsa ialah Amalek, tetapi akhirnya ia akan sampai kepada kebinasaan.\""
 },
 {
   "id": 4469,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 21,
   "firman": "Ketika ia melihat orang Keni, diucapkannyalah sanjaknya, katanya: \"Kokoh tempat kediamanmu, tertaruh di atas bukit batu sarangmu,"
 },
 {
   "id": 4470,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 22,
   "firman": "namun orang Keni akan hapus; berapa lama lagi maka Asyur akan menawan engkau?\""
 },
 {
   "id": 4471,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 23,
   "firman": "Diucapkannyalah juga sanjaknya, katanya: \"Celaka! Siapakah yang akan hidup, apabila Allah melakukan hal itu?"
 },
 {
   "id": 4472,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 24,
   "firman": "Tetapi kapal-kapal akan datang dari pantai orang Kitim, mereka akan menindas Asyur dan menindas Heber, lalu iapun juga akan sampai kepada kebinasaan.\""
 },
 {
   "id": 4473,
   "kitab": "Bil",
   "pasal": 24,
   "ayat": 25,
   "firman": "Lalu bersiaplah Bileam dan pulang ke tempat kediamannya; dan Balakpun pergilah juga."
 },
 {
   "id": 4474,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 1,
   "firman": "Sementara Israel tinggal di Sitim, mulailah bangsa itu berzinah dengan perempuan-perempuan Moab."
 },
 {
   "id": 4475,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 2,
   "firman": "Perempuan-perempuan ini mengajak bangsa itu ke korban sembelihan bagi allah mereka, lalu bangsa itu turut makan dari korban itu dan menyembah allah orang-orang itu."
 },
 {
   "id": 4476,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 3,
   "firman": "Ketika Israel berpasangan dengan Baal-Peor, bangkitlah murka TUHAN terhadap Israel;"
 },
 {
   "id": 4477,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 4,
   "firman": "lalu berfirmanlah TUHAN kepada Musa: \"Tangkaplah semua orang yang mengepalai bangsa itu dan gantunglah mereka di hadapan TUHAN di tempat terang, supaya murka TUHAN yang bernyala-nyala itu surut dari pada Israel.\""
 },
 {
   "id": 4478,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 5,
   "firman": "Lalu berkatalah Musa kepada hakim-hakim Israel: \"Baiklah masing-masing kamu membunuh orang-orangnya yang telah berpasangan dengan Baal-Peor.\""
 },
 {
   "id": 4479,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 6,
   "firman": "Kebetulan datanglah salah seorang Israel membawa seorang perempuan Midian kepada sanak saudaranya dengan dilihat Musa dan segenap umat Israel yang sedang bertangis-tangisan di depan pintu Kemah Pertemuan."
 },
 {
   "id": 4480,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 7,
   "firman": "Ketika hal itu dilihat oleh Pinehas, anak Eleazar, anak imam Harun, bangunlah ia dari tengah-tengah umat itu dan mengambil sebuah tombak di tangannya,"
 },
 {
   "id": 4481,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 8,
   "firman": "mengejar orang Israel itu sampai ke ruang tengah, dan menikam mereka berdua, yakni orang Israel dan perempuan itu, pada perutnya. Maka berhentilah tulah itu menimpa orang Israel."
 },
 {
   "id": 4482,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 9,
   "firman": "Orang yang mati karena tulah itu ada dua puluh empat ribu orang banyaknya."
 },
 {
   "id": 4483,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 10,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4484,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 11,
   "firman": "\"Pinehas, anak Eleazar, anak imam Harun, telah menyurutkan murka-Ku dari pada orang Israel, oleh karena ia begitu giat membela kehormatan-Ku di tengah-tengah mereka, sehingga tidaklah Kuhabisi orang Israel dalam cemburu-Ku."
 },
 {
   "id": 4485,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 12,
   "firman": "Sebab itu katakanlah: Sesungguhnya Aku berikan kepadanya perjanjian keselamatan yang dari pada-Ku"
 },
 {
   "id": 4486,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 13,
   "firman": "untuk menjadi perjanjian mengenai keimaman selama-lamanya bagi dia dan bagi keturunannya, karena ia telah begitu giat membela Allahnya dan telah mengadakan pendamaian bagi orang Israel.\""
 },
 {
   "id": 4487,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 14,
   "firman": "Nama orang Israel yang mati terbunuh bersama-sama dengan perempuan Midian itu ialah Zimri bin Salu, pemimpin salah satu puak orang Simeon,"
 },
 {
   "id": 4488,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 15,
   "firman": "dan nama perempuan Midian yang mati terbunuh itu ialah Kozbi binti Zur; Zur itu adalah seorang kepala kaum--yaitu puak--di Midian."
 },
 {
   "id": 4489,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 16,
   "firman": "Kemudian berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 4490,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 17,
   "firman": "\"Lawanlah orang Midian itu, dan tewaskanlah mereka,"
 },
 {
   "id": 4491,
   "kitab": "Bil",
   "pasal": 25,
   "ayat": 18,
   "firman": "sebab mereka telah melawan kamu dengan daya upaya yang dirancang mereka terhadap kamu dalam hal Peor dan dalam hal Kozbi, saudara mereka, yakni anak perempuan seorang pemimpin Midian; Kozbi itu mati terbunuh pada waktu turunnya tulah karena Peor itu.\""
 },
 {
   "id": 4492,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 1,
   "firman": "Sesudah tulah itu berfirmanlah TUHAN kepada Musa dan kepada Eleazar, anak imam Harun:"
 },
 {
   "id": 4493,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 2,
   "firman": "\"Hitunglah jumlah segenap umat Israel, yang berumur dua puluh tahun ke atas menurut suku mereka, semua orang yang sanggup berperang di antara orang Israel.\""
 },
 {
   "id": 4494,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 3,
   "firman": "Lalu berkatalah Musa dan imam Eleazar kepada mereka di dataran Moab, di tepi sungai Yordan dekat Yerikho:"
 },
 {
   "id": 4495,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 4,
   "firman": "\"Hitunglah jumlah semua orang yang berumur dua puluh tahun ke atas!\" --seperti yang diperintahkan TUHAN kepada Musa. Inilah orang Israel yang telah keluar dari tanah Mesir:"
 },
 {
   "id": 4496,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 5,
   "firman": "Ruben ialah anak sulung Israel; bani Ruben ialah dari Henokh kaum orang Henokh; dari Palu kaum orang Palu;"
 },
 {
   "id": 4497,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 6,
   "firman": "dari Hezron kaum orang Hezron dan dari Karmi kaum orang Karmi."
 },
 {
   "id": 4498,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 7,
   "firman": "Itulah kaum-kaum orang Ruben, dan orang-orang yang dicatat dari mereka berjumlah empat puluh tiga ribu tujuh ratus tiga puluh orang."
 },
 {
   "id": 4499,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 8,
   "firman": "Adapun anak Palu ialah Eliab,"
 },
 {
   "id": 4500,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 9,
   "firman": "dan anak-anak Eliab ialah Nemuel, Datan dan Abiram. Datan dan Abiram, orang-orang yang dipilih oleh umat itu, ialah orang-orang yang telah membantah Musa dan Harun dalam kumpulan Korah, ketika mereka membantah TUHAN,"
 },
 {
   "id": 4501,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 10,
   "firman": "tetapi bumi membuka mulutnya dan menelan mereka bersama-sama dengan Korah, ketika kumpulan itu mati, ketika kedua ratus lima puluh orang itu dimakan api, sehingga mereka menjadi peringatan."
 },
 {
   "id": 4502,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 11,
   "firman": "Tetapi anak-anak Korah tidaklah mati."
 },
 {
   "id": 4503,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 12,
   "firman": "Bani Simeon, menurut kaum mereka, ialah: dari Nemuel kaum orang Nemuel; dari Yamin kaum orang Yamin; dari Yakhin kaum orang Yakhin;"
 },
 {
   "id": 4504,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 13,
   "firman": "dari Zerah kaum orang Zerah dan dari Saul kaum orang Saul."
 },
 {
   "id": 4505,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 14,
   "firman": "Itulah kaum-kaum orang Simeon, dua puluh dua ribu dua ratus orang banyaknya."
 },
 {
   "id": 4506,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 15,
   "firman": "Bani Gad, menurut kaum mereka, ialah: dari Zefon kaum orang Zefon; dari Hagi kaum orang Hagi; dari Syuni kaum orang Syuni;"
 },
 {
   "id": 4507,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 16,
   "firman": "dari Ozni kaum orang Ozni, dari Eri kaum orang Eri;"
 },
 {
   "id": 4508,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 17,
   "firman": "dari Arod kaum orang Arod dan dari Areli kaum orang Areli."
 },
 {
   "id": 4509,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 18,
   "firman": "Itulah kaum-kaum bani Gad, dan orang-orang yang dicatat dari mereka berjumlah empat puluh ribu lima ratus orang."
 },
 {
   "id": 4510,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 19,
   "firman": "Anak-anak Yehuda ialah: Er dan Onan; tetapi Er dan Onan itu mati di tanah Kanaan."
 },
 {
   "id": 4511,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 20,
   "firman": "Bani Yehuda, menurut kaum mereka, ialah: dari Syela kaum orang Syela; dari Peres kaum orang Peres dan dari Zerah kaum orang Zerah."
 },
 {
   "id": 4512,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 21,
   "firman": "Bani Peres ialah: dari Hezron kaum orang Hezron dan dari Hamul kaum orang Hamul."
 },
 {
   "id": 4513,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 22,
   "firman": "Itulah kaum-kaum Yehuda, dan orang-orang yang dicatat dari mereka berjumlah tujuh puluh enam ribu lima ratus orang."
 },
 {
   "id": 4514,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 23,
   "firman": "Bani Isakhar, menurut kaum mereka, ialah: dari Tola kaum orang Tola; dari Pua kaum orang Pua;"
 },
 {
   "id": 4515,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 24,
   "firman": "dari Yasub kaum orang Yasub dan dari Simron kaum orang Simron."
 },
 {
   "id": 4516,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 25,
   "firman": "Itulah kaum-kaum Isakhar, dan orang-orang yang dicatat dari mereka, berjumlah enam puluh empat ribu tiga ratus orang."
 },
 {
   "id": 4517,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 26,
   "firman": "Bani Zebulon, menurut kaum mereka, ialah: dari Sered kaum orang Sered; dari Elon kaum orang Elon dan dari Yahleel kaum orang Yahleel."
 },
 {
   "id": 4518,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 27,
   "firman": "Itulah kaum-kaum orang Zebulon, dan orang-orang yang dicatat dari mereka berjumlah enam puluh ribu lima ratus orang."
 },
 {
   "id": 4519,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 28,
   "firman": "Keturunan Yusuf, menurut kaum mereka, ialah orang Manasye dan orang Efraim."
 },
 {
   "id": 4520,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 29,
   "firman": "Bani Manasye ialah: dari Makhir kaum orang Makhir; dan Makhir beranakkan Gilead; dari Gilead kaum orang Gilead."
 },
 {
   "id": 4521,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 30,
   "firman": "Inilah bani Gilead: dari Iezer kaum orang Iezer; dari Helek kaum orang Helek;"
 },
 {
   "id": 4522,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 31,
   "firman": "dari Asriel kaum orang Asriel; dari Sekhem kaum orang Sekhem;"
 },
 {
   "id": 4523,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 32,
   "firman": "dari Semida kaum orang Semida dan dari Hefer kaum orang Hefer."
 },
 {
   "id": 4524,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 33,
   "firman": "Adapun Zelafehad bin Hefer tidak mempunyai anak laki-laki, tetapi anak perempuan saja, dan nama anak-anak perempuan Zelafehad ialah Mahla, Noa, Hogla, Milka dan Tirza."
 },
 {
   "id": 4525,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 34,
   "firman": "Itulah kaum-kaum Manasye, dan orang-orang yang dicatat dari mereka berjumlah lima puluh dua ribu tujuh ratus orang."
 },
 {
   "id": 4526,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 35,
   "firman": "Inilah bani Efraim, menurut kaum mereka: dari Sutelah kaum orang Sutelah; dari Bekher kaum orang Bekher dan dari Tahan kaum orang Tahan."
 },
 {
   "id": 4527,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 36,
   "firman": "Dan inilah bani Sutelah: dari Eran kaum orang Eran."
 },
 {
   "id": 4528,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 37,
   "firman": "Itulah kaum-kaum bani Efraim, dan orang-orang yang dicatat dari mereka berjumlah tiga puluh dua ribu lima ratus orang banyaknya. Itulah bani Yusuf menurut kaum mereka."
 },
 {
   "id": 4529,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 38,
   "firman": "Bani Benyamin, menurut kaum mereka, ialah: dari Bela kaum orang Bela; dari Asybel kaum orang Asybel; dari Ahiram kaum orang Ahiram;"
 },
 {
   "id": 4530,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 39,
   "firman": "dari Sefufam kaum orang Sefufam dan dari Hufam kaum orang Hufam."
 },
 {
   "id": 4531,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 40,
   "firman": "Dan anak-anak Bela ialah Ared dan Naaman; dari Ared kaum orang Ared dan dari Naaman kaum orang Naaman."
 },
 {
   "id": 4532,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 41,
   "firman": "Itulah bani Benyamin menurut kaum mereka, dan orang-orang yang dicatat dari mereka berjumlah empat puluh lima ribu enam ratus orang."
 },
 {
   "id": 4533,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 42,
   "firman": "Inilah bani Dan, menurut kaum mereka: dari Suham kaum orang Suham. Itulah kaum-kaum Dan menurut kaum mereka."
 },
 {
   "id": 4534,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 43,
   "firman": "Segala kaum orang Suham, orang-orang yang dicatat dari mereka berjumlah enam puluh empat ribu empat ratus orang."
 },
 {
   "id": 4535,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 44,
   "firman": "Bani Asyer, menurut kaum mereka, ialah: dari Yimna kaum orang Yimna; dari Yiswi kaum orang Yiswi dan dari Beria kaum orang Beria."
 },
 {
   "id": 4536,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 45,
   "firman": "Mengenai bani Beria: dari Heber kaum orang Heber dan dari Malkiel kaum orang Malkiel."
 },
 {
   "id": 4537,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 46,
   "firman": "Dan nama anak perempuan Asyer ialah Serah."
 },
 {
   "id": 4538,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 47,
   "firman": "Itulah kaum-kaum bani Asyer, dan orang-orang yang dicatat dari mereka berjumlah lima puluh tiga ribu empat ratus orang."
 },
 {
   "id": 4539,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 48,
   "firman": "Bani Naftali, menurut kaum mereka, ialah: dari Yahzeel kaum orang Yahzeel; dari Guni kaum orang Guni;"
 },
 {
   "id": 4540,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 49,
   "firman": "dari Yezer kaum orang Yezer dan dari Syilem kaum orang Syilem."
 },
 {
   "id": 4541,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 50,
   "firman": "Itulah kaum-kaum Naftali menurut kaum mereka, dan orang-orang yang dicatat dari mereka berjumlah empat puluh lima ribu empat ratus orang."
 },
 {
   "id": 4542,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 51,
   "firman": "Itulah orang-orang yang dicatat dari orang Israel, enam ratus satu ribu tujuh ratus tiga puluh orang banyaknya."
 },
 {
   "id": 4543,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 52,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4544,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 53,
   "firman": "\"Kepada suku-suku itulah harus dibagikan tanah itu menjadi milik pusaka menurut nama-nama yang dicatat;"
 },
 {
   "id": 4545,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 54,
   "firman": "kepada yang besar jumlahnya haruslah engkau memberikan milik pusaka yang besar dan kepada yang kecil jumlahnya haruslah engkau memberikan milik pusaka yang kecil; kepada setiap suku sesuai dengan jumlah orang-orangnya yang dicatat haruslah diberikan milik pusaka."
 },
 {
   "id": 4546,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 55,
   "firman": "Tetapi tanah itu harus dibagikan dengan membuang undi; menurut nama suku-suku nenek moyang mereka haruslah mereka mendapat milik pusaka;"
 },
 {
   "id": 4547,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 56,
   "firman": "seperti yang ditunjukkan undian haruslah dibagikan milik pusaka setiap suku, di antara yang besar dan yang kecil jumlahnya.\""
 },
 {
   "id": 4548,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 57,
   "firman": "Inilah orang-orang yang dicatat dari orang Lewi, menurut kaum mereka: dari Gerson kaum orang Gerson; dari Kehat kaum orang Kehat dan dari Merari kaum orang Merari."
 },
 {
   "id": 4549,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 58,
   "firman": "Inilah kaum-kaum Lewi: kaum orang Libni, kaum orang Hebron, kaum orang Mahli, kaum orang Musi dan kaum orang Korah. Adapun Kehat beranakkan Amram."
 },
 {
   "id": 4550,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 59,
   "firman": "Dan nama isteri Amram ialah Yokhebed, anak perempuan Lewi, yang dilahirkan bagi Lewi di Mesir; dan bagi Amram perempuan itu melahirkan Harun dan Musa dan Miryam, saudara mereka yang perempuan."
 },
 {
   "id": 4551,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 60,
   "firman": "Pada Harun lahir Nadab dan Abihu, Eleazar dan Itamar."
 },
 {
   "id": 4552,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 61,
   "firman": "Tetapi Nadab dan Abihu mati, ketika mereka mempersembahkan persembahan api yang asing ke hadapan TUHAN."
 },
 {
   "id": 4553,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 62,
   "firman": "Dan orang-orang yang dicatat dari mereka berjumlah dua puluh tiga ribu orang, semuanya laki-laki, yang berumur satu bulan ke atas, sebab mereka tidak dicatat bersama-sama dengan orang Israel, karena mereka tidak diberikan milik pusaka di tengah-tengah orang Israel."
 },
 {
   "id": 4554,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 63,
   "firman": "Itulah orang-orang yang dicatat oleh Musa dan imam Eleazar, ketika keduanya mencatat orang-orang Israel di dataran Moab di tepi sungai Yordan dekat Yerikho."
 },
 {
   "id": 4555,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 64,
   "firman": "Di antara mereka tidak ada terdapat seorangpun yang dicatat Musa dan imam Harun, ketika keduanya mencatat orang Israel di padang gurun Sinai"
 },
 {
   "id": 4556,
   "kitab": "Bil",
   "pasal": 26,
   "ayat": 65,
   "firman": "sebab TUHAN telah berfirman tentang mereka: \"Pastilah mereka mati di padang gurun.\" Dari mereka itu tidak ada seorangpun yang masih tinggal hidup selain dari Kaleb bin Yefune dan Yosua bin Nun."
 },
 {
   "id": 4557,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 1,
   "firman": "Kemudian mendekatlah anak-anak perempuan Zelafehad bin Hefer bin Gilead bin Makhir bin Manasye dari kaum Manasye bin Yusuf--nama anak-anaknya itu adalah: Mahla, Noa, Hogla, Milka dan Tirza--"
 },
 {
   "id": 4558,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 2,
   "firman": "dan berdiri di depan Musa dan imam Eleazar, dan di depan para pemimpin dan segenap umat itu dekat pintu Kemah Pertemuan, serta berkata:"
 },
 {
   "id": 4559,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 3,
   "firman": "\"Ayah kami telah mati di padang gurun, walaupun ia tidak termasuk ke dalam kumpulan yang bersepakat melawan TUHAN, ke dalam kumpulan Korah, tetapi ia telah mati karena dosanya sendiri, dan ia tidak mempunyai anak laki-laki."
 },
 {
   "id": 4560,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 4,
   "firman": "Mengapa nama ayah kami harus hapus dari tengah-tengah kaumnya, oleh karena ia tidak mempunyai anak laki-laki? Berilah kami tanah milik di antara saudara-saudara ayah kami.\""
 },
 {
   "id": 4561,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 5,
   "firman": "Lalu Musa menyampaikan perkara mereka itu ke hadapan TUHAN."
 },
 {
   "id": 4562,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 6,
   "firman": "Maka berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 4563,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 7,
   "firman": "\"Perkataan anak-anak perempuan Zelafehad itu benar; memang engkau harus memberikan tanah milik pusaka kepadanya di tengah-tengah saudara-saudara ayahnya; engkau harus memindahkan kepadanya hak atas milik pusaka ayahnya."
 },
 {
   "id": 4564,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 8,
   "firman": "Dan kepada orang Israel engkau harus berkata: Apabila seseorang mati dengan tidak mempunyai anak laki-laki, maka haruslah kamu memindahkan hak atas milik pusakanya kepada anaknya yang perempuan."
 },
 {
   "id": 4565,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 9,
   "firman": "Apabila ia tidak mempunyai anak perempuan, maka haruslah kamu memberikan milik pusakanya itu kepada saudara-saudaranya yang laki-laki."
 },
 {
   "id": 4566,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 10,
   "firman": "Dan apabila ia tidak mempunyai saudara-saudara lelaki, maka haruslah kamu memberikan milik pusakanya itu kepada saudara-saudara lelaki ayahnya."
 },
 {
   "id": 4567,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 11,
   "firman": "Dan apabila ayahnya tidak mempunyai saudara-saudara lelaki, maka haruslah kamu memberikan milik pusakanya itu kepada kerabatnya yang terdekat dari antara kaumnya, supaya dimilikinya.\" Itulah yang harus menjadi ketetapan hukum bagi orang Israel, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4568,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 12,
   "firman": "TUHAN berfirman kepada Musa: \"Naiklah ke gunung Abarim ini, dan pandanglah negeri yang Kuberikan kepada orang Israel."
 },
 {
   "id": 4569,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 13,
   "firman": "Sesudah engkau memandangnya, maka engkaupun juga akan dikumpulkan kepada kaum leluhurmu, sama seperti Harun, abangmu, dahulu."
 },
 {
   "id": 4570,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 14,
   "firman": "Karena pada waktu pembantahan umat itu di padang gurun Zin, kamu berdua telah memberontak terhadap titah-Ku untuk menyatakan kekudusan-Ku di depan mata mereka dengan air itu.\" Itulah mata air Meriba dekat Kadesh di padang gurun Zin."
 },
 {
   "id": 4571,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 15,
   "firman": "Lalu berkatalah Musa kepada TUHAN:"
 },
 {
   "id": 4572,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 16,
   "firman": "\"Biarlah TUHAN, Allah dari roh segala makhluk, mengangkat atas umat ini seorang"
 },
 {
   "id": 4573,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 17,
   "firman": "yang mengepalai mereka waktu keluar dan masuk, dan membawa mereka keluar dan masuk, supaya umat TUHAN jangan hendaknya seperti domba-domba yang tidak mempunyai gembala.\""
 },
 {
   "id": 4574,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 18,
   "firman": "Lalu TUHAN berfirman kepada Musa: \"Ambillah Yosua bin Nun, seorang yang penuh roh, letakkanlah tanganmu atasnya,"
 },
 {
   "id": 4575,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 19,
   "firman": "suruhlah ia berdiri di depan imam Eleazar dan di depan segenap umat, lalu berikanlah kepadanya perintahmu di depan mata mereka itu"
 },
 {
   "id": 4576,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 20,
   "firman": "dan berilah dia sebagian dari kewibawaanmu, supaya segenap umat Israel mendengarkan dia."
 },
 {
   "id": 4577,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 21,
   "firman": "Ia harus berdiri di depan imam Eleazar, supaya Eleazar menanyakan keputusan Urim bagi dia di hadapan TUHAN; atas titahnya mereka akan keluar dan atas titahnya mereka akan masuk, ia beserta semua orang Israel, segenap umat itu.\""
 },
 {
   "id": 4578,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 22,
   "firman": "Maka Musa melakukan seperti yang diperintahkan TUHAN kepadanya. Ia memanggil Yosua dan menyuruh dia berdiri di depan imam Eleazar dan di depan segenap umat itu,"
 },
 {
   "id": 4579,
   "kitab": "Bil",
   "pasal": 27,
   "ayat": 23,
   "firman": "lalu ia meletakkan tangannya atas Yosua dan memberikan kepadanya perintahnya, seperti yang difirmankan TUHAN dengan perantaraan Musa."
 },
 {
   "id": 4580,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4581,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 2,
   "firman": "\"Perintahkanlah kepada orang Israel dan katakanlah kepada mereka: Dengan setia dan pada waktu yang ditetapkan haruslah kamu mempersembahkan persembahan-persembahan kepada-Ku sebagai santapan-Ku, berupa korban api-apian yang baunya menyenangkan bagi-Ku."
 },
 {
   "id": 4582,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 3,
   "firman": "Katakanlah kepada mereka: Inilah korban api-apian yang harus kamu persembahkan kepada TUHAN: dua ekor domba berumur setahun yang tidak bercela setiap hari sebagai korban bakaran yang tetap;"
 },
 {
   "id": 4583,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 4,
   "firman": "domba yang satu haruslah kauolah pada waktu pagi, domba yang lain haruslah kauolah pada waktu senja."
 },
 {
   "id": 4584,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 5,
   "firman": "Juga sepersepuluh efa tepung yang terbaik untuk korban sajian, diolah dengan seperempat hin minyak tumbuk."
 },
 {
   "id": 4585,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 6,
   "firman": "Itulah korban bakaran yang tetap yang diolah pertama kali di atas gunung Sinai menjadi bau yang menyenangkan, suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 4586,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 7,
   "firman": "Dan korban curahannya ialah seperempat hin untuk setiap domba; curahkanlah minuman yang memabukkan sebagai korban curahan bagi TUHAN di tempat kudus."
 },
 {
   "id": 4587,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 8,
   "firman": "Dan domba yang lain haruslah kauolah pada waktu senja; sama seperti korban sajian pada waktu pagi dan sama seperti korban curahannya haruslah engkau mengolahnya sebagai korban api-apian yang baunya menyenangkan bagi TUHAN.\""
 },
 {
   "id": 4588,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 9,
   "firman": "\"Pada hari Sabat: dua ekor domba berumur setahun yang tidak bercela, dan dua persepuluh efa tepung yang terbaik sebagai korban sajian, diolah dengan minyak, serta dengan korban curahannya."
 },
 {
   "id": 4589,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 10,
   "firman": "Itulah korban bakaran Sabat pada tiap-tiap Sabat, di samping korban bakaran yang tetap dan korban curahannya."
 },
 {
   "id": 4590,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 11,
   "firman": "Pada bulan barumu haruslah kamu mempersembahkan sebagai korban bakaran kepada TUHAN: dua ekor lembu jantan muda, seekor domba jantan, tujuh ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4591,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 12,
   "firman": "dan juga tiga persepuluh efa tepung yang terbaik sebagai korban sajian, diolah dengan minyak, untuk tiap-tiap lembu jantan, serta dua persepuluh efa tepung yang terbaik sebagai korban sajian, diolah dengan minyak, untuk domba jantan yang seekor itu,"
 },
 {
   "id": 4592,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 13,
   "firman": "serta sepersepuluh efa tepung yang terbaik sebagai korban sajian, diolah dengan minyak, untuk tiap-tiap domba; itulah suatu korban bakaran, bau yang menyenangkan, suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 4593,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 14,
   "firman": "Dan korban-korban curahannya haruslah untuk seekor lembu jantan setengah hin anggur, untuk seekor domba jantan sepertiga hin dan untuk seekor domba seperempat hin. Itulah korban bakaran pada setiap bulan baru dalam setahun."
 },
 {
   "id": 4594,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 15,
   "firman": "Dan seekor kambing jantan haruslah diolah menjadi korban penghapus dosa bagi TUHAN, serta dengan korban curahannya, di samping korban bakaran yang tetap.\""
 },
 {
   "id": 4595,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 16,
   "firman": "\"Dalam bulan yang pertama, pada hari yang keempat belas bulan itu, ada Paskah bagi TUHAN."
 },
 {
   "id": 4596,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 17,
   "firman": "Pada hari yang kelima belas bulan itu ada hari raya; tujuh hari lamanya harus dimakan roti yang tidak beragi."
 },
 {
   "id": 4597,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 18,
   "firman": "Pada hari yang pertama ada pertemuan kudus, maka tidak boleh kamu melakukan sesuatu pekerjaan berat,"
 },
 {
   "id": 4598,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 19,
   "firman": "dan haruslah kamu mempersembahkan kepada TUHAN sebagai korban api-apian, sebagai korban bakaran: dua ekor lembu jantan muda, seekor domba jantan dan tujuh ekor domba berumur setahun; haruslah kamu ambil yang tidak bercela."
 },
 {
   "id": 4599,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 20,
   "firman": "Sebagai korban sajiannya haruslah kamu olah tepung yang terbaik diolah dengan minyak, yakni tiga persepuluh efa untuk seekor lembu jantan dan dua persepuluh efa untuk seekor domba jantan;"
 },
 {
   "id": 4600,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 21,
   "firman": "sepersepuluh efa harus kauolah untuk setiap domba dari ketujuh ekor domba itu."
 },
 {
   "id": 4601,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 22,
   "firman": "Selanjutnya seekor kambing jantan sebagai korban penghapus dosa untuk mengadakan pendamaian bagimu;"
 },
 {
   "id": 4602,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 23,
   "firman": "selain dari korban bakaran pagi yang termasuk korban bakaran yang tetap haruslah kamu mengolah semuanya itu."
 },
 {
   "id": 4603,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 24,
   "firman": "Secara demikian haruslah setiap hari selama tujuh hari kamu olah santapan berupa korban api-apian yang baunya menyenangkan bagi TUHAN; di samping korban bakaran yang tetap haruslah itu diolah, serta dengan korban curahannya."
 },
 {
   "id": 4604,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 25,
   "firman": "Dan pada hari yang ketujuh haruslah kamu mengadakan pertemuan yang kudus, maka tidak boleh kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 4605,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 26,
   "firman": "Pada hari hulu hasil, pada waktu kamu mempersembahkan korban sajian baru kepada TUHAN, pada hari raya lepas tujuh minggu, haruslah kamu mengadakan pertemuan kudus, maka tidak boleh kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 4606,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 27,
   "firman": "Pada waktu itu haruslah kamu mempersembahkan sebagai korban bakaran menjadi bau yang menyenangkan bagi TUHAN: dua ekor lembu jantan muda, seekor domba jantan, tujuh ekor domba berumur setahun;"
 },
 {
   "id": 4607,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 28,
   "firman": "juga sebagai korban sajiannya: tepung yang terbaik, diolah dengan minyak, yakni tiga persepuluh efa untuk setiap ekor lembu jantan, dua persepuluh efa untuk domba jantan yang seekor itu,"
 },
 {
   "id": 4608,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 29,
   "firman": "sepersepuluh efa untuk setiap domba dari ketujuh ekor domba itu;"
 },
 {
   "id": 4609,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 30,
   "firman": "seekor kambing jantan untuk mengadakan pendamaian bagimu."
 },
 {
   "id": 4610,
   "kitab": "Bil",
   "pasal": 28,
   "ayat": 31,
   "firman": "Selain dari korban bakaran yang tetap dan korban sajiannya, haruslah kamu mengolah semuanya itu, serta dengan korban-korban curahannya. Haruslah kamu ambil yang tidak bercela."
 },
 {
   "id": 4611,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 1,
   "firman": "Pada bulan yang ketujuh, pada tanggal satu bulan itu, haruslah kamu mengadakan pertemuan yang kudus, maka tidak boleh kamu melakukan sesuatu pekerjaan berat; itulah hari peniupan serunai bagimu."
 },
 {
   "id": 4612,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 2,
   "firman": "Pada waktu itu haruslah kamu mengolah sebagai korban bakaran menjadi bau yang menyenangkan bagi TUHAN: seekor lembu jantan muda, seekor domba jantan, tujuh ekor domba berumur setahun yang tidak bercela;"
 },
 {
   "id": 4613,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 3,
   "firman": "juga sebagai korban sajiannya: tepung yang terbaik, diolah dengan minyak, yakni tiga persepuluh efa untuk lembu jantan itu, dua persepuluh efa untuk domba jantan itu"
 },
 {
   "id": 4614,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 4,
   "firman": "dan sepersepuluh efa untuk setiap domba dari ketujuh ekor domba itu;"
 },
 {
   "id": 4615,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 5,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa untuk mengadakan pendamaian bagimu,"
 },
 {
   "id": 4616,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 6,
   "firman": "selain dari korban bakaran bulan baru serta dengan korban sajiannya, dan korban bakaran yang tetap serta dengan korban sajiannya dan korban-korban curahannya, sesuai dengan peraturannya, menjadi bau yang menyenangkan, suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 4617,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 7,
   "firman": "Pada hari yang kesepuluh bulan yang ketujuh itu haruslah kamu mengadakan pertemuan yang kudus dan merendahkan dirimu dengan berpuasa, maka tidak boleh kamu melakukan sesuatu pekerjaan."
 },
 {
   "id": 4618,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 8,
   "firman": "Pada waktu itu haruslah kamu mempersembahkan sebagai korban bakaran kepada TUHAN, sebagai bau yang menyenangkan: seekor lembu jantan muda, seekor domba jantan, tujuh ekor domba berumur setahun; haruslah tidak bercela semuanya itu;"
 },
 {
   "id": 4619,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 9,
   "firman": "juga sebagai korban sajiannya: tepung yang terbaik, diolah dengan minyak, yakni tiga persepuluh efa untuk lembu jantan itu, dua persepuluh efa untuk domba jantan yang seekor itu,"
 },
 {
   "id": 4620,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 10,
   "firman": "sepersepuluh efa untuk setiap domba dari ketujuh ekor domba itu;"
 },
 {
   "id": 4621,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 11,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari pada korban penghapus dosa pembawa pendamaian dan korban bakaran yang tetap serta dengan korban sajiannya dan korban-korban curahannya."
 },
 {
   "id": 4622,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 12,
   "firman": "Pada hari yang kelima belas bulan yang ketujuh itu haruslah kamu mengadakan pertemuan yang kudus, maka tidak boleh kamu melakukan sesuatu pekerjaan berat; haruslah kamu mengadakan perayaan bagi TUHAN, tujuh hari lamanya."
 },
 {
   "id": 4623,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 13,
   "firman": "Pada waktu itu haruslah kamu mempersembahkan sebagai korban bakaran, sebagai korban api-apian yang baunya menyenangkan bagi TUHAN: tiga belas ekor lembu jantan muda, dua ekor domba jantan, empat belas ekor domba berumur setahun; haruslah tidak bercela semuanya itu;"
 },
 {
   "id": 4624,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 14,
   "firman": "juga sebagai korban sajiannya: tepung yang terbaik, diolah dengan minyak, yakni tiga persepuluh efa untuk setiap lembu dari ketiga belas ekor lembu jantan itu, dua persepuluh efa untuk setiap domba dari kedua ekor domba jantan itu,"
 },
 {
   "id": 4625,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 15,
   "firman": "dan sepersepuluh efa untuk setiap domba dari keempat belas ekor domba itu;"
 },
 {
   "id": 4626,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 16,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4627,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 17,
   "firman": "Pada hari yang kedua: dua belas ekor lembu jantan muda, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4628,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 18,
   "firman": "serta dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4629,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 19,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap serta dengan korban sajiannya dan korban-korban curahannya."
 },
 {
   "id": 4630,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 20,
   "firman": "Pada hari yang ketiga: sebelas ekor lembu jantan, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4631,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 21,
   "firman": "serta dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4632,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 22,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap serta dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4633,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 23,
   "firman": "Pada hari yang keempat: sepuluh ekor lembu jantan, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4634,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 24,
   "firman": "serta dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4635,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 25,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4636,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 26,
   "firman": "Pada hari yang kelima: sembilan ekor lembu jantan, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4637,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 27,
   "firman": "serta dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4638,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 28,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap serta dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4639,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 29,
   "firman": "Pada hari yang keenam: delapan ekor lembu jantan, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4640,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 30,
   "firman": "serta dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4641,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 31,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap dengan korban sajiannya dan korban-korban curahannya."
 },
 {
   "id": 4642,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 32,
   "firman": "Pada hari yang ketujuh: tujuh ekor lembu jantan, dua ekor domba jantan, empat belas ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4643,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 33,
   "firman": "serta dengan korban sajiannya, dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturannya;"
 },
 {
   "id": 4644,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 34,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4645,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 35,
   "firman": "Pada hari yang kedelapan haruslah kamu mengadakan perkumpulan raya, maka tidak boleh kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 4646,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 36,
   "firman": "Pada waktu itu haruslah kamu mempersembahkan sebagai korban bakaran, sebagai korban api-apian yang baunya menyenangkan bagi TUHAN: seekor lembu jantan, seekor domba jantan, tujuh ekor domba berumur setahun yang tidak bercela,"
 },
 {
   "id": 4647,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 37,
   "firman": "dengan korban sajiannya dan korban-korban curahannya, yakni untuk lembu-lembu jantan, untuk domba-domba jantan dan untuk domba-domba muda itu, menurut jumlah yang sesuai dengan peraturan;"
 },
 {
   "id": 4648,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 38,
   "firman": "dan seekor kambing jantan sebagai korban penghapus dosa, selain dari korban bakaran yang tetap serta dengan korban sajiannya dan korban curahannya."
 },
 {
   "id": 4649,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 39,
   "firman": "Itulah semuanya yang harus kamu olah bagi TUHAN pada hari-hari rayamu sebagai korban-korban bakaranmu, korban-korban sajianmu, korban-korban curahanmu dan korban-korban keselamatanmu, selain dari korban-korban nazarmu dan korban-korban sukarelamu.\""
 },
 {
   "id": 4650,
   "kitab": "Bil",
   "pasal": 29,
   "ayat": 40,
   "firman": "Lalu berbicaralah Musa kepada orang Israel sesuai dengan segala yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4651,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 1,
   "firman": "Musa berkata kepada kepala-kepala suku Israel, demikian: \"Inilah yang diperintahkan TUHAN."
 },
 {
   "id": 4652,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 2,
   "firman": "Apabila seorang laki-laki bernazar atau bersumpah kepada TUHAN, sehingga ia mengikat dirinya kepada suatu janji, maka janganlah ia melanggar perkataannya itu; haruslah ia berbuat tepat seperti yang diucapkannya."
 },
 {
   "id": 4653,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 3,
   "firman": "Tetapi apabila seorang perempuan bernazar kepada TUHAN dan mengikat dirinya kepada suatu janji di rumah ayahnya, yakni pada waktu ia masih gadis,"
 },
 {
   "id": 4654,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 4,
   "firman": "dan ayahnya mendengar nazar dan janji yang mengikat diri anaknya itu, tetapi ayahnya tidak berkata apa-apa kepadanya, maka segala nazarnya itu akan tetap berlaku dan setiap janji mengikat dirinya akan tetap berlaku juga."
 },
 {
   "id": 4655,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 5,
   "firman": "Tetapi jika ayahnya melarang dia pada waktu mendengar itu, maka segala nazar dan janji yang mengikat diri anaknya itu tidak akan berlaku; dan TUHAN akan mengampuni perempuan itu, sebab ayahnya telah melarang dia."
 },
 {
   "id": 4656,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 6,
   "firman": "Tetapi jika perempuan itu bersuami, dan ia masih berhutang karena salah satu nazar atau salah satu janji yang diucapkan begitu saja dan yang mengikat dirinya,"
 },
 {
   "id": 4657,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 7,
   "firman": "dan suaminya mendengar tentang hal itu, tetapi tidak berkata apa-apa kepadanya pada waktu mendengarnya, maka nazarnya itu akan tetap berlaku dan janji yang mengikat dirinya akan tetap berlaku juga."
 },
 {
   "id": 4658,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 8,
   "firman": "Tetapi apabila suaminya itu, pada waktu mendengarnya, melarang dia, maka ia telah membatalkan nazar yang menjadi hutang isterinya dan janji yang diucapkan begitu saja dan yang mengikat isterinya; dan TUHAN akan mengampuni isterinya itu."
 },
 {
   "id": 4659,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 9,
   "firman": "Mengenai nazar seorang janda atau seorang perempuan yang diceraikan, segala apa yang mengikat dirinya akan tetap berlaku baginya."
 },
 {
   "id": 4660,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 10,
   "firman": "Jika seorang perempuan di rumah suaminya bernazar atau mengikat dirinya kepada suatu janji dengan bersumpah,"
 },
 {
   "id": 4661,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 11,
   "firman": "dan suaminya mendengarnya, tetapi tidak berkata apa-apa kepadanya dan tidak melarang dia, maka segala nazar perempuan itu akan tetap berlaku, dan setiap janji yang mengikat diri perempuan itu akan tetap berlaku juga."
 },
 {
   "id": 4662,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 12,
   "firman": "Tetapi jika suaminya itu membatalkannya dengan tegas pada waktu mendengarnya, maka ucapan apapun yang keluar dari mulutnya, baik nazar maupun janji, tidak akan berlaku; suaminya telah membatalkannya, dan TUHAN akan mengampuni isterinya itu."
 },
 {
   "id": 4663,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 13,
   "firman": "Setiap nazar dan setiap janji sumpah perempuan itu untuk merendahkan diri dengan berpuasa, dapat dinyatakan berlaku oleh suaminya atau dapat dibatalkan oleh suaminya."
 },
 {
   "id": 4664,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 14,
   "firman": "Tetapi apabila suaminya sama sekali tidak berkata apa-apa kepadanya dari hari ke hari, maka dengan demikian ia telah menyatakan berlaku segala nazar isterinya atau segala ikatan janji yang menjadi hutang isterinya; ia telah menyatakannya berlaku, karena ia tidak berkata apa-apa kepadanya pada waktu mendengarnya."
 },
 {
   "id": 4665,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 15,
   "firman": "Tetapi jika ia baru membatalkannya beberapa lama setelah didengarnya, maka ia akan menanggung akibat kesalahan isterinya.\""
 },
 {
   "id": 4666,
   "kitab": "Bil",
   "pasal": 30,
   "ayat": 16,
   "firman": "Itulah ketetapan-ketetapan yang diperintahkan TUHAN kepada Musa, yakni antara seorang suami dengan isterinya, dan antara seorang ayah dengan anaknya perempuan pada waktu ia masih gadis di rumah ayahnya."
 },
 {
   "id": 4667,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4668,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 2,
   "firman": "\"Lakukanlah pembalasan orang Israel kepada orang Midian; kemudian engkau akan dikumpulkan kepada kaum leluhurmu.\""
 },
 {
   "id": 4669,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 3,
   "firman": "Lalu berkatalah Musa kepada bangsa itu: \"Baiklah sejumlah orang dari antaramu mempersenjatai diri untuk berperang, supaya mereka melawan Midian untuk menjalankan pembalasan TUHAN terhadap Midian."
 },
 {
   "id": 4670,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 4,
   "firman": "Dari setiap suku di antara segala suku Israel haruslah kamu menyuruh seribu orang untuk berperang.\""
 },
 {
   "id": 4671,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 5,
   "firman": "Demikianlah diserahkan dari kaum-kaum Israel seribu orang dari tiap-tiap suku, jadi dua belas ribu orang bersenjata untuk berperang."
 },
 {
   "id": 4672,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 6,
   "firman": "Lalu Musa menyuruh mereka untuk berperang, seribu orang dari tiap-tiap suku, bersama-sama dengan Pinehas, anak imam Eleazar, untuk berperang, dengan membawa perkakas tempat kudus dan nafiri-nafiri pemberi tanda semboyan."
 },
 {
   "id": 4673,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 7,
   "firman": "Kemudian berperanglah mereka melawan Midian, seperti yang diperintahkan TUHAN kepada Musa, lalu membunuh semua laki-laki mereka."
 },
 {
   "id": 4674,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 8,
   "firman": "Selain dari orang-orang yang mati terbunuh itu, merekapun membunuh juga raja-raja Midian, yakni Ewi, Rekem, Zur, Hur dan Reba, kelima raja Midian, juga Bileam bin Beor dibunuh mereka dengan pedang."
 },
 {
   "id": 4675,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 9,
   "firman": "Kemudian Israel menawan perempuan-perempuan Midian dan anak-anak mereka; juga segala hewan, segala ternak dan segenap kekayaan mereka dijarah,"
 },
 {
   "id": 4676,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 10,
   "firman": "dan segala kota kediaman serta segala tempat perkemahan mereka dibakar."
 },
 {
   "id": 4677,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 11,
   "firman": "Kemudian diambillah seluruh jarahan dan seluruh rampasan berupa manusia dan hewan itu,"
 },
 {
   "id": 4678,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 12,
   "firman": "dan dibawalah orang-orang tawanan, rampasan dan jarahan itu kepada Musa dan imam Eleazar dan kepada umat Israel, ke tempat perkemahan di dataran Moab yang di tepi sungai Yordan dekat Yerikho."
 },
 {
   "id": 4679,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 13,
   "firman": "Lalu pergilah Musa dan imam Eleazar dan semua pemimpin umat itu sampai ke luar tempat perkemahan untuk menyongsong mereka."
 },
 {
   "id": 4680,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 14,
   "firman": "Maka gusarlah Musa kepada para pemimpin tentara itu, kepada para kepala pasukan seribu dan para kepala pasukan seratus, yang pulang dari peperangan,"
 },
 {
   "id": 4681,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 15,
   "firman": "dan Musa berkata kepada mereka: \"Kamu biarkankah semua perempuan hidup?"
 },
 {
   "id": 4682,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 16,
   "firman": "Bukankah perempuan-perempuan ini, atas nasihat Bileam, menjadi sebabnya orang Israel berubah setia terhadap TUHAN dalam hal Peor, sehingga tulah turun ke antara umat TUHAN."
 },
 {
   "id": 4683,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 17,
   "firman": "Maka sekarang bunuhlah semua laki-laki di antara anak-anak mereka, dan juga semua perempuan yang pernah bersetubuh dengan laki-laki haruslah kamu bunuh."
 },
 {
   "id": 4684,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 18,
   "firman": "Tetapi semua orang muda di antara perempuan yang belum pernah bersetubuh dengan laki-laki haruslah kamu biarkan hidup bagimu."
 },
 {
   "id": 4685,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 19,
   "firman": "Tetapi kamu ini, berkemahlah tujuh hari lamanya di luar tempat perkemahan; setiap orang yang telah membunuh orang dan setiap orang yang kena kepada orang yang mati terbunuh haruslah menghapus dosa dari dirinya pada hari yang ketiga dan pada hari yang ketujuh, kamu sendiri dan orang-orang tawananmu;"
 },
 {
   "id": 4686,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 20,
   "firman": "juga setiap pakaian dan setiap barang kulit dan setiap barang yang dibuat dari bulu kambing dan setiap barang kayu haruslah disucikan.\""
 },
 {
   "id": 4687,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 21,
   "firman": "Lalu berkatalah imam Eleazar kepada para prajurit, yang telah pergi bertempur itu: \"Inilah ketetapan hukum yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4688,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 22,
   "firman": "Hanya emas dan perak, tembaga, besi, timah putih dan timah hitam,"
 },
 {
   "id": 4689,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 23,
   "firman": "segala yang tahan api, haruslah kamu lakukan dari api, supaya menjadi tahir; tetapi semuanya itu haruslah juga disucikan dengan air penyuci; dan segala yang tidak tahan api haruslah kamu lalukan dari air."
 },
 {
   "id": 4690,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 24,
   "firman": "Lagipula kamu harus mencuci pakaianmu pada hari yang ketujuh, supaya kamu tahir, dan kemudian bolehlah kamu masuk ke tempat perkemahan.\""
 },
 {
   "id": 4691,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 25,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4692,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 26,
   "firman": "\"Hitunglah jumlah rampasan yang telah diangkut, yang berupa manusia dan hewan--engkau ini dan imam Eleazar serta kepala-kepala puak umat itu."
 },
 {
   "id": 4693,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 27,
   "firman": "Lalu bagi dualah rampasan itu, kepada pasukan bersenjata yang telah keluar berperang, dan kepada segenap umat yang lain."
 },
 {
   "id": 4694,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 28,
   "firman": "Dan engkau harus mengkhususkan upeti bagi TUHAN dari para prajurit yang keluar bertempur itu, yakni satu dari setiap lima ratus, baik dari manusia, baik dari lembu, dari keledai dan dari kambing domba;"
 },
 {
   "id": 4695,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 29,
   "firman": "dari yang setengah yang telah didapat mereka haruslah engkau mengambilnya, lalu menyerahkannya kepada imam Eleazar, sebagai persembahan khusus bagi TUHAN."
 },
 {
   "id": 4696,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 30,
   "firman": "Tetapi dari yang setengah lagi yang untuk orang Israel lain haruslah engkau mengambil satu ambilan dari setiap lima puluh, baik dari manusia, baik dari lembu, dari keledai dan dari kambing domba, jadi dari segala hewan, lalu menyerahkan semuanya kepada orang Lewi yang memelihara Kemah Suci TUHAN.\""
 },
 {
   "id": 4697,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 31,
   "firman": "Kemudian Musa dan imam Eleazar melakukan seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4698,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 32,
   "firman": "Adapun rampasan, yakni yang masih tinggal dari apa yang telah dijarah laskar itu berjumlah: enam ratus tujuh puluh lima ribu ekor kambing domba"
 },
 {
   "id": 4699,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 33,
   "firman": "dan tujuh puluh dua ribu ekor lembu,"
 },
 {
   "id": 4700,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 34,
   "firman": "dan enam puluh satu ribu ekor keledai,"
 },
 {
   "id": 4701,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 35,
   "firman": "selanjutnya orang-orang, yaitu perempuan-perempuan yang belum pernah bersetubuh dengan laki-laki, seluruhnya tiga puluh dua ribu orang."
 },
 {
   "id": 4702,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 36,
   "firman": "Yang setengah yang menjadi bagian orang-orang yang telah keluar berperang itu jumlahnya tiga ratus tiga puluh tujuh ribu lima ratus ekor kambing domba,"
 },
 {
   "id": 4703,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 37,
   "firman": "jadi upeti bagi TUHAN dari kambing domba itu ada enam ratus tujuh puluh lima ekor;"
 },
 {
   "id": 4704,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 38,
   "firman": "lembu-lembu tiga puluh enam ribu ekor, jadi upetinya bagi TUHAN ada tujuh puluh dua ekor;"
 },
 {
   "id": 4705,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 39,
   "firman": "keledai-keledai tiga puluh ribu lima ratus ekor, jadi upetinya bagi TUHAN ada enam puluh satu ekor;"
 },
 {
   "id": 4706,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 40,
   "firman": "dan orang-orang enam belas ribu orang, jadi upetinya bagi TUHAN tiga puluh dua orang."
 },
 {
   "id": 4707,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 41,
   "firman": "Lalu Musa menyerahkan upeti yang dikhususkan bagi TUHAN itu kepada imam Eleazar, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4708,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 42,
   "firman": "Yang setengah lagi yang menjadi bagian orang Israel lain, yang dipisahkan Musa dari bagian orang-orang yang telah berperang itu,"
 },
 {
   "id": 4709,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 43,
   "firman": "yaitu yang setengah yang menjadi bagian umat yang lain itu: domba-domba tiga ratus tiga puluh tujuh ribu lima ratus ekor,"
 },
 {
   "id": 4710,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 44,
   "firman": "lembu-lembu tiga puluh enam ribu ekor,"
 },
 {
   "id": 4711,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 45,
   "firman": "keledai-keledai tiga puluh ribu lima ratus ekor,"
 },
 {
   "id": 4712,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 46,
   "firman": "dan orang-orang enam belas ribu orang."
 },
 {
   "id": 4713,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 47,
   "firman": "Lalu Musa mengambil dari yang setengah yang menjadi bagian orang Israel lain itu satu ambilan dari setiap lima puluh, baik dari manusia baik dari hewan, kemudian menyerahkan semuanya kepada orang Lewi yang memelihara Kemah Suci, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 4714,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 48,
   "firman": "Lalu mendekatlah para pemimpin tentara, yakni kepala-kepala pasukan seribu dan kepala-kepala pasukan seratus, kepada Musa"
 },
 {
   "id": 4715,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 49,
   "firman": "serta berkata kepadanya: \"Hamba-hambamu ini telah menghitung jumlah prajurit yang ada di bawah kuasa kami dan dari mereka tidak ada seorangpun yang hilang."
 },
 {
   "id": 4716,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 50,
   "firman": "Sebab itu kami mempersembahkan sebagai persembahan kepada TUHAN apa yang didapat masing-masing, yakni barang-barang emas, gelang kaki, gelang tangan, cincin meterai, anting-anting dan kerongsang untuk mengadakan pendamaian bagi nyawa kami di hadapan TUHAN.\""
 },
 {
   "id": 4717,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 51,
   "firman": "Maka Musa dan imam Eleazar menerima dari mereka emas itu, semuanya barang-barang tempaan."
 },
 {
   "id": 4718,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 52,
   "firman": "Dan segala emas persembahan khusus yang dipersembahkan mereka kepada TUHAN, yakni yang dari pihak kepala-kepala pasukan seribu dan kepala-kepala pasukan seratus, ada enam belas ribu tujuh ratus lima puluh syikal beratnya."
 },
 {
   "id": 4719,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 53,
   "firman": "Tetapi prajurit-prajurit itu masing-masing telah mengambil jarahan bagi dirinya sendiri."
 },
 {
   "id": 4720,
   "kitab": "Bil",
   "pasal": 31,
   "ayat": 54,
   "firman": "Setelah Musa dan imam Eleazar menerima emas itu dari pihak kepala-kepala pasukan seribu dan kepala-kepala pasukan seratus, maka mereka membawanya ke dalam Kemah Pertemuan sebagai peringatan di hadapan TUHAN untuk mengingat orang Israel."
 },
 {
   "id": 4721,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 1,
   "firman": "Adapun bani Ruben dan bani Gad ternaknya banyak, bahkan sangat banyak sekali. Ketika mereka melihat tanah Yaezer dan tanah Gilead, tampaklah tempat itu tempat yang baik untuk peternakan."
 },
 {
   "id": 4722,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 2,
   "firman": "Lalu datanglah bani Gad dan bani Ruben dan berkata kepada Musa, imam Eleazar dan para pemimpin umat itu:"
 },
 {
   "id": 4723,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 3,
   "firman": "\"Atarot, Dibon, Yaezer, Nimra, Hesybon, Eleale, Sebam, Nebo dan Beon,"
 },
 {
   "id": 4724,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 4,
   "firman": "negeri yang telah dikalahkan oleh TUHAN untuk umat Israel, itulah suatu negeri yang baik untuk peternakan dan hamba-hambamu ini memang ada ternaknya.\""
 },
 {
   "id": 4725,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 5,
   "firman": "Lagi kata mereka: \"Jika kami mendapat kasihmu, biarlah negeri ini diberikan kepada hamba-hambamu ini sebagai milik; janganlah kami harus pindah ke seberang sungai Yordan.\""
 },
 {
   "id": 4726,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 6,
   "firman": "Jawab Musa kepada bani Gad dan bani Ruben itu: \"Masakan saudara-saudaramu pergi berperang dan kamu tinggal di sini?"
 },
 {
   "id": 4727,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 7,
   "firman": "Mengapa kamu hendak membuat enggan hati orang Israel untuk menyeberang ke negeri yang diberikan TUHAN kepada mereka?"
 },
 {
   "id": 4728,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 8,
   "firman": "Demikian juga dilakukan bapa-bapamu, ketika aku menyuruh mereka dari Kadesh-Barnea untuk melihat-lihat negeri itu;"
 },
 {
   "id": 4729,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 9,
   "firman": "mereka berjalan sampai ke lembah Eskol, melihat-lihat negeri dan membuat enggan hati orang Israel, sehingga mereka tidak mau pergi ke negeri yang diberikan TUHAN kepada mereka."
 },
 {
   "id": 4730,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 10,
   "firman": "Maka bangkitlah murka TUHAN pada waktu itu dan Ia bersumpah:"
 },
 {
   "id": 4731,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 11,
   "firman": "Bahwasanya orang-orang yang telah berjalan dari Mesir, yang berumur dua puluh tahun ke atas, tidak akan melihat negeri yang Kujanjikan dengan bersumpah kepada Abraham, Ishak dan Yakub, oleh karena mereka tidak mengikut Aku dengan sepenuh hatinya,"
 },
 {
   "id": 4732,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 12,
   "firman": "kecuali Kaleb bin Yefune, orang Kenas itu, dan Yosua bin Nun, sebab keduanya mengikut TUHAN dengan sepenuh hatinya."
 },
 {
   "id": 4733,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 13,
   "firman": "Sebab itu bangkitlah murka TUHAN kepada orang Israel, sehingga Ia membuat mereka mengembara di padang gurun empat puluh tahun lamanya, sampai habis mati segenap angkatan yang telah berbuat jahat di mata TUHAN."
 },
 {
   "id": 4734,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 14,
   "firman": "Dan sekarang kamu bangkit ganti bapa-bapamu, suatu kawanan orang-orang berdosa, untuk menambah lagi murka TUHAN yang menyala-nyala kepada orang Israel itu."
 },
 {
   "id": 4735,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 15,
   "firman": "Jika kamu berbalik membelakangi Dia, maka kamu akan lebih lama lagi dibiarkan-Nya tinggal di padang gurun dan kamu akan membawa kemusnahan atas seluruh bangsa ini.\""
 },
 {
   "id": 4736,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 16,
   "firman": "Tetapi mendekatlah mereka kepadanya serta berkata: \"Kami hendak mendirikan kandang-kandang kambing domba di sini untuk ternak kami dan kota-kota untuk anak-anak kami,"
 },
 {
   "id": 4737,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 17,
   "firman": "tetapi kami sendiri akan mempersenjatai diri dan dengan bersegera kami akan berjalan di depan orang Israel, sampai kami membawa mereka ke tempatnya; sementara itu anak-anak kami akan tinggal dalam kota-kota yang berkubu oleh karena penduduk negeri ini;"
 },
 {
   "id": 4738,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 18,
   "firman": "kami tidak akan pulang ke rumah kami, sampai setiap orang Israel memperoleh milik pusakanya;"
 },
 {
   "id": 4739,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 19,
   "firman": "sebab kami tidak mau menerima milik pusaka di seberang sungai Yordan sana dan seterusnya, apabila kami mendapat milik pusaka di seberang sungai Yordan sini, di sebelah timur.\""
 },
 {
   "id": 4740,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 20,
   "firman": "Lalu berkatalah Musa kepada mereka: \"Jika kamu hendak berbuat demikian, jika kamu hendak mempersenjatai diri untuk berperang di hadapan TUHAN,"
 },
 {
   "id": 4741,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 21,
   "firman": "dan setiap orang dari kamu yang telah bersenjata hendak menyeberangi sungai Yordan di hadapan TUHAN, sampai Ia menghalau musuh-musuh-Nya dari hadapan-Nya,"
 },
 {
   "id": 4742,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 22,
   "firman": "sehingga negeri itu takluk ke hadapan TUHAN, dan jika kemudian kamu pulang, maka akan bebaslah kamu dari kewajibanmu kepada TUHAN dan kepada Israel, dan negeri inipun akan menjadi milikmu di hadapan TUHAN."
 },
 {
   "id": 4743,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 23,
   "firman": "Tetapi jika kamu tidak berbuat demikian, sesungguhnya kamu berdosa kepada TUHAN, dan kamu akan mengalami, bahwa dosamu itu akan menimpa kamu."
 },
 {
   "id": 4744,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 24,
   "firman": "Dirikanlah kota-kota bagi anak-anakmu dan kandang-kandang bagi kambing dombamu, dan perbuatlah apa yang telah kamu ucapkan.\""
 },
 {
   "id": 4745,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 25,
   "firman": "Maka berkatalah bani Gad dan bani Ruben itu kepada Musa: \"Hamba-hambamu ini akan berbuat seperti yang diperintahkan tuanku."
 },
 {
   "id": 4746,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 26,
   "firman": "Anak-anak dan isteri-isteri kami, ternak dan hewan kami akan tinggal di sini di kota-kota Gilead,"
 },
 {
   "id": 4747,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 27,
   "firman": "tetapi hamba-hambamu ini akan menyeberang di hadapan TUHAN untuk bertempur, yakni setiap orang yang bersenjata untuk berperang, seperti yang dikatakan tuanku.\""
 },
 {
   "id": 4748,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 28,
   "firman": "Lalu Musa memberi perintah mengenai mereka kepada imam Eleazar dan kepada Yosua bin Nun, dan kepada kepala-kepala puak dari suku-suku Israel,"
 },
 {
   "id": 4749,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 29,
   "firman": "kata Musa kepada mereka: \"Jika bani Gad dan bani Ruben itu telah menyeberangi sungai Yordan bersama-sama dengan kamu untuk berperang di hadapan TUHAN, yakni semuanya orang yang bersenjata untuk berperang, dan jika negeri itu telah takluk kepadamu, maka haruslah kamu memberikan tanah Gilead kepada mereka sebagai milik."
 },
 {
   "id": 4750,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 30,
   "firman": "Tetapi jika mereka tidak menyeberang dengan bersenjata bersama-sama dengan kamu, maka haruslah mereka menerima tanah miliknya di tengah-tengahmu di tanah Kanaan.\""
 },
 {
   "id": 4751,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 31,
   "firman": "Lalu bani Gad dan bani Ruben itu menjawab: \"Apa yang difirmankan TUHAN kepada hamba-hambamu ini akan kami lakukan."
 },
 {
   "id": 4752,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 32,
   "firman": "Kami sendiri akan menyeberang dengan bersenjata di hadapan TUHAN ke tanah Kanaan, tetapi bagi kami tetaplah tanah milik pusaka kami di seberang sungai Yordan sini.\""
 },
 {
   "id": 4753,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 33,
   "firman": "Lalu Musa memberikan kepada mereka, kepada bani Gad, kepada bani Ruben dan kepada setengah suku Manasye bin Yusuf: kerajaan Sihon, raja orang Amori, dan kerajaan Og, raja Basan, yakni negeri mereka beserta kota-kotanya di seluruh negeri itu, dengan daerah-daerah setiap kota itu."
 },
 {
   "id": 4754,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 34,
   "firman": "Maka bani Gad membangun kota-kota Dibon, Atarot, Aroer,"
 },
 {
   "id": 4755,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 35,
   "firman": "Atarot-Sofan, Yaezer, Yogbeha,"
 },
 {
   "id": 4756,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 36,
   "firman": "Bet-Nimra, Bet-Haran, sebagai kota-kota yang berkubu dan sebagai tempat kandang-kandang kambing domba."
 },
 {
   "id": 4757,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 37,
   "firman": "Dan bani Ruben membangun kota-kota Hesybon, Eleale, Kiryataim,"
 },
 {
   "id": 4758,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 38,
   "firman": "Nebo, Baal-Meon, --dengan mengganti nama-namanya--dan Sibma; dan mereka memberi nama lain kepada kota-kota yang dibangun mereka itu."
 },
 {
   "id": 4759,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 39,
   "firman": "Bani Makhir bin Manasye pergi ke Gilead; mereka merebutnya dan menghalaukan orang Amori yang ada di sana."
 },
 {
   "id": 4760,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 40,
   "firman": "Lalu Musa memberikan Gilead kepada Makhir bin Manasye dan diamlah ia di sana."
 },
 {
   "id": 4761,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 41,
   "firman": "Yair, anak Manasye, pergi merebut dusun-dusunnya dan menamainya Hawot-Yair."
 },
 {
   "id": 4762,
   "kitab": "Bil",
   "pasal": 32,
   "ayat": 42,
   "firman": "Nobah pergi merebut Kenat dengan segala anak kotanya dan menamainya Nobah menurut namanya sendiri."
 },
 {
   "id": 4763,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 1,
   "firman": "Inilah tempat-tempat persinggahan orang Israel, setelah mereka keluar dari tanah Mesir, pasukan demi pasukan, di bawah pimpinan Musa dan Harun;"
 },
 {
   "id": 4764,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 2,
   "firman": "Musa menuliskan perjalanan mereka dari tempat persinggahan ke tempat persinggahan sesuai dengan titah TUHAN; dan inilah tempat-tempat persinggahan mereka dalam perjalanan mereka:"
 },
 {
   "id": 4765,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 3,
   "firman": "Mereka berangkat dari Rameses pada bulan yang pertama, pada hari yang kelima belas bulan yang pertama itu; pada hari sesudah Paskah berjalanlah orang Israel keluar, oleh tangan yang dinaikkan, di depan mata semua orang Mesir,"
 },
 {
   "id": 4766,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 4,
   "firman": "sementara orang Mesir sedang menguburkan orang-orang yang telah dibunuh TUHAN di antara mereka, yakni semua anak sulung; sebab TUHAN telah menjatuhkan hukuman-hukuman kepada para allah mereka."
 },
 {
   "id": 4767,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 5,
   "firman": "Berangkatlah orang Israel dari Rameses, lalu berkemah di Sukot."
 },
 {
   "id": 4768,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 6,
   "firman": "Mereka berangkat dari Sukot, lalu berkemah di Etam yang di tepi padang gurun."
 },
 {
   "id": 4769,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 7,
   "firman": "Mereka berangkat dari Etam, lalu balik kembali ke Pi-Hahirot yang di depan Baal-Zefon, kemudian berkemah di tentangan Migdol."
 },
 {
   "id": 4770,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 8,
   "firman": "Mereka berangkat dari Pi-Hahirot dan lewat dari tengah-tengah laut ke padang gurun, lalu mereka berjalan tiga hari perjalanan jauhnya di padang gurun Etam, kemudian mereka berkemah di Mara."
 },
 {
   "id": 4771,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 9,
   "firman": "Mereka berangkat dari Mara, lalu sampai ke Elim; di Elim ada dua belas mata air dan tujuh puluh pohon korma; di sanalah mereka berkemah."
 },
 {
   "id": 4772,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 10,
   "firman": "Mereka berangkat dari Elim, lalu berkemah di tepi Laut Teberau."
 },
 {
   "id": 4773,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 11,
   "firman": "Mereka berangkat dari Laut Teberau, lalu berkemah di padang gurun Sin."
 },
 {
   "id": 4774,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 12,
   "firman": "Mereka berangkat dari padang gurun Sin, lalu berkemah di Dofka."
 },
 {
   "id": 4775,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 13,
   "firman": "Mereka berangkat dari Dofka, lalu berkemah di Alus."
 },
 {
   "id": 4776,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 14,
   "firman": "Mereka berangkat dari Alus, lalu berkemah di Rafidim, dan di sana tidak ada air minum untuk bangsa itu."
 },
 {
   "id": 4777,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 15,
   "firman": "Mereka berangkat dari Rafidim, lalu berkemah di padang gurun Sinai."
 },
 {
   "id": 4778,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 16,
   "firman": "Mereka berangkat dari padang gurun Sinai, lalu berkemah di Kibrot-Taawa."
 },
 {
   "id": 4779,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 17,
   "firman": "Mereka berangkat dari Kibrot-Taawa, lalu berkemah di Hazerot."
 },
 {
   "id": 4780,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 18,
   "firman": "Mereka berangkat dari Hazerot, lalu berkemah di Ritma."
 },
 {
   "id": 4781,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 19,
   "firman": "Mereka berangkat dari Ritma, lalu berkemah di Rimon-Peros."
 },
 {
   "id": 4782,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 20,
   "firman": "Mereka berangkat dari Rimon-Peros, lalu berkemah di Libna."
 },
 {
   "id": 4783,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 21,
   "firman": "Mereka berangkat dari Libna, lalu berkemah di Risa."
 },
 {
   "id": 4784,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 22,
   "firman": "Mereka berangkat dari Risa, lalu berkemah di Kehelata."
 },
 {
   "id": 4785,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 23,
   "firman": "Mereka berangkat dari Kehelata, lalu berkemah di Har-Syafer."
 },
 {
   "id": 4786,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 24,
   "firman": "Mereka berangkat dari Har-Syafer, lalu berkemah di Harada."
 },
 {
   "id": 4787,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 25,
   "firman": "Mereka berangkat dari Harada, lalu berkemah di Makhelot."
 },
 {
   "id": 4788,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 26,
   "firman": "Mereka berangkat dari Makhelot, lalu berkemah di Tahat."
 },
 {
   "id": 4789,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 27,
   "firman": "Mereka berangkat dari Tahat, lalu berkemah di Tarah."
 },
 {
   "id": 4790,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 28,
   "firman": "Mereka berangkat dari Tarah, lalu berkemah di Mitka."
 },
 {
   "id": 4791,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 29,
   "firman": "Mereka berangkat dari Mitka, lalu berkemah di Hasmona."
 },
 {
   "id": 4792,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 30,
   "firman": "Mereka berangkat dari Hasmona, lalu berkemah di Moserot."
 },
 {
   "id": 4793,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 31,
   "firman": "Mereka berangkat dari Moserot, lalu berkemah di Bene-Yaakan."
 },
 {
   "id": 4794,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 32,
   "firman": "Mereka berangkat dari Bene-Yaakan, lalu berkemah di Hor-Gidgad."
 },
 {
   "id": 4795,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 33,
   "firman": "Mereka berangkat dari Hor-Gidgad, lalu berkemah di Yotbata."
 },
 {
   "id": 4796,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 34,
   "firman": "Mereka berangkat dari Yotbata, lalu berkemah di Abrona."
 },
 {
   "id": 4797,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 35,
   "firman": "Mereka berangkat dari Abrona, lalu berkemah di Ezion-Geber."
 },
 {
   "id": 4798,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 36,
   "firman": "Mereka berangkat dari Ezion-Geber, lalu berkemah di padang gurun Zin, yaitu Kadesh."
 },
 {
   "id": 4799,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 37,
   "firman": "Mereka berangkat dari Kadesh, lalu berkemah di gunung Hor, di perbatasan tanah Edom."
 },
 {
   "id": 4800,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 38,
   "firman": "Ketika itu imam Harun naik ke gunung Hor sesuai dengan titah TUHAN, dan di situ ia mati pada tahun keempat puluh sesudah orang Israel keluar dari tanah Mesir, pada bulan yang kelima, pada tanggal satu bulan itu;"
 },
 {
   "id": 4801,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 39,
   "firman": "Harun berumur seratus dua puluh tiga tahun, ketika ia mati di gunung Hor."
 },
 {
   "id": 4802,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 40,
   "firman": "Pada waktu itu raja negeri Arad, orang Kanaan itu, yang tinggal di Tanah Negeb di tanah Kanaan, mendengar kabar tentang kedatangan orang Israel."
 },
 {
   "id": 4803,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 41,
   "firman": "Berangkatlah mereka dari gunung Hor, lalu berkemah di Zalmona."
 },
 {
   "id": 4804,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 42,
   "firman": "Mereka berangkat dari Zalmona, lalu berkemah di Funon."
 },
 {
   "id": 4805,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 43,
   "firman": "Mereka berangkat dari Funon, lalu berkemah di Obot."
 },
 {
   "id": 4806,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 44,
   "firman": "Mereka berangkat dari Obot, lalu berkemah dekat reruntuhan di Abarim di daerah Moab."
 },
 {
   "id": 4807,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 45,
   "firman": "Mereka berangkat dari reruntuhan itu, lalu berkemah di Dibon-Gad."
 },
 {
   "id": 4808,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 46,
   "firman": "Mereka berangkat dari Dibon-Gad, lalu berkemah di Almon-Diblataim."
 },
 {
   "id": 4809,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 47,
   "firman": "Mereka berangkat dari Almon-Diblataim, lalu berkemah di pegunungan Abarim di depan Nebo."
 },
 {
   "id": 4810,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 48,
   "firman": "Mereka berangkat dari pegunungan Abarim, lalu berkemah di dataran Moab di tepi sungai Yordan dekat Yerikho."
 },
 {
   "id": 4811,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 49,
   "firman": "Mereka berkemah di tepi sungai Yordan, dari Bet-Yesimot sampai ke Abel-Sitim di dataran Moab."
 },
 {
   "id": 4812,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 50,
   "firman": "TUHAN berfirman kepada Musa di dataran Moab di tepi sungai Yordan dekat Yerikho:"
 },
 {
   "id": 4813,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 51,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila kamu menyeberangi sungai Yordan ke tanah Kanaan,"
 },
 {
   "id": 4814,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 52,
   "firman": "maka haruslah kamu menghalau semua penduduk negeri itu dari depanmu dan membinasakan segala batu berukir kepunyaan mereka; juga haruslah kamu membinasakan segala patung tuangan mereka dan memusnahkan segala bukit pengorbanan mereka."
 },
 {
   "id": 4815,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 53,
   "firman": "Haruslah kamu menduduki negeri itu dan diam di sana, sebab kepadamulah Kuberikan negeri itu untuk diduduki."
 },
 {
   "id": 4816,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 54,
   "firman": "Maka haruslah kamu membagi negeri itu sebagai milik pusaka dengan membuang undi menurut kaummu: kepada yang besar jumlahnya haruslah kamu memberikan milik pusaka yang besar, dan kepada yang kecil jumlahnya haruslah kamu memberikan milik pusaka yang kecil; yang ditunjuk oleh undi bagi masing-masing, itulah bagian undiannya; menurut suku nenek moyangmu haruslah kamu membagi milik pusaka itu."
 },
 {
   "id": 4817,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 55,
   "firman": "Tetapi jika kamu tidak menghalau penduduk negeri itu dari depanmu, maka orang-orang yang kamu tinggalkan hidup dari mereka akan menjadi seperti selumbar di matamu dan seperti duri yang menusuk lambungmu, dan mereka akan menyesatkan kamu di negeri yang kamu diami itu."
 },
 {
   "id": 4818,
   "kitab": "Bil",
   "pasal": 33,
   "ayat": 56,
   "firman": "Maka akan Kulakukan kepadamu seperti yang Kurancang melakukan kepada mereka.\""
 },
 {
   "id": 4819,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4820,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 2,
   "firman": "\"Perintahkanlah kepada orang Israel dan katakanlah kepada mereka: Apabila kamu masuk ke negeri Kanaan, maka inilah negeri yang akan jatuh kepadamu sebagai milik pusaka, yakni tanah Kanaan menurut batas-batasnya."
 },
 {
   "id": 4821,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 3,
   "firman": "Adapun sisi selatanmu ialah dari padang gurun Zin menyusur Edom, maka batas selatanmu mulai dari ujung Laut Asin di sebelah timur."
 },
 {
   "id": 4822,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 4,
   "firman": "Lalu batasmu membelok di selatan pendakian Akrabim, terus ke Zin dan berakhir di sebelah selatan Kadesh-Barnea. Sesudah itu ia mencapai Hazar-Adar, dan terus ke Azmon."
 },
 {
   "id": 4823,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 5,
   "firman": "Kemudian batas itu membelok dari Azmon ke sungai Mesir dan berakhir ke laut."
 },
 {
   "id": 4824,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 6,
   "firman": "Batas baratmu ialah laut besar dan pantainya; itulah batas baratmu."
 },
 {
   "id": 4825,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 7,
   "firman": "Inilah batas utaramu: mulai dari laut besar haruslah kamu buat tanda batas ke gunung Hor,"
 },
 {
   "id": 4826,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 8,
   "firman": "dari gunung Hor harus kamu buat tanda batas ke jalan yang menuju ke Hamat, lalu batas itu mencapai Zedad."
 },
 {
   "id": 4827,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 9,
   "firman": "Kemudian batas itu mencapai Zifron dan berakhir di Hazar-Enan; itulah batas utaramu."
 },
 {
   "id": 4828,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 10,
   "firman": "Sebagai batasmu di sebelah timur haruslah kamu membuat tanda batas dari Hazar-Enan ke Sefam."
 },
 {
   "id": 4829,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 11,
   "firman": "Dari Sefam batas itu turun ke Ribla, di sebelah timur Ain; kemudian batas itu turun lagi dan mencapai tebing danau Kineret di sebelah timur."
 },
 {
   "id": 4830,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 12,
   "firman": "Lalu batas itu turun ke sungai Yordan dan berakhir di Laut Asin. Itulah negerimu menurut batas-batasnya sekeliling.\""
 },
 {
   "id": 4831,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 13,
   "firman": "Musa memerintahkan kepada orang Israel: \"Itulah negeri yang akan kamu bagi sebagai milik pusaka dengan membuang undi, yang diperintahkan TUHAN untuk diberikan kepada suku yang sembilan setengah itu."
 },
 {
   "id": 4832,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 14,
   "firman": "Sebab suku bani Ruben menurut puak-puak mereka dan suku bani Gad menurut puak-puak mereka telah menerima milik pusakanya; juga suku Manasye yang setengah itu telah menerimanya."
 },
 {
   "id": 4833,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 15,
   "firman": "Dua setengah suku itu telah menerima milik pusaka mereka di seberang sungai Yordan di dekat Yerikho, ke sebelah timur.\""
 },
 {
   "id": 4834,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 16,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4835,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 17,
   "firman": "\"Inilah nama orang-orang yang harus membagikan tanah itu kepadamu sebagai milik pusaka: imam Eleazar dan Yosua bin Nun."
 },
 {
   "id": 4836,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 18,
   "firman": "Lagi haruslah kamu mengambil seorang pemimpin dari setiap suku untuk membagikan tanah itu sebagai milik pusaka."
 },
 {
   "id": 4837,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 19,
   "firman": "Inilah nama orang-orang itu: dari suku Yehuda: Kaleb bin Yefune;"
 },
 {
   "id": 4838,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 20,
   "firman": "dari suku bani Simeon: Samuel bin Amihud;"
 },
 {
   "id": 4839,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 21,
   "firman": "dari suku Benyamin: Elidad bin Kislon;"
 },
 {
   "id": 4840,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 22,
   "firman": "dari suku bani Dan seorang pemimpin: Buki bin Yogli;"
 },
 {
   "id": 4841,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 23,
   "firman": "dari anak-anak Yusuf, yakni dari suku bani Manasye seorang pemimpin Haniel bin Efod;"
 },
 {
   "id": 4842,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 24,
   "firman": "dan dari suku bani Efraim seorang pemimpin: Kemuel bin Siftan;"
 },
 {
   "id": 4843,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 25,
   "firman": "dari suku bani Zebulon seorang pemimpin: Elisafan bin Parnah;"
 },
 {
   "id": 4844,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 26,
   "firman": "dari suku bani Isakhar seorang pemimpin: Paltiel bin Azan;"
 },
 {
   "id": 4845,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 27,
   "firman": "dari suku bani Asyer seorang pemimpin: Ahihud bin Selomi;"
 },
 {
   "id": 4846,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 28,
   "firman": "dari suku bani Naftali seorang pemimpin: Pedael bin Amihud."
 },
 {
   "id": 4847,
   "kitab": "Bil",
   "pasal": 34,
   "ayat": 29,
   "firman": "Itulah orang-orang yang diperintahkan TUHAN untuk membagikan milik pusaka kepada orang Israel di tanah Kanaan.\""
 },
 {
   "id": 4848,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa di dataran Moab di tepi sungai Yordan di dekat Yerikho:"
 },
 {
   "id": 4849,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 2,
   "firman": "\"Perintahkanlah kepada orang Israel, supaya dari milik pusaka kepunyaannya diberikan mereka kota-kota kepada orang Lewi untuk didiami; juga haruslah kamu memberikan kepada orang Lewi tanah-tanah penggembalaan yang di sekeliling kota-kota itu."
 },
 {
   "id": 4850,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 3,
   "firman": "Kota-kota itu akan menjadi kepunyaan mereka untuk didiami dan tanah-tanah penggembalaannya untuk hewan yang mereka miliki dan untuk segala ternak mereka yang lain."
 },
 {
   "id": 4851,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 4,
   "firman": "Tanah-tanah penggembalaan kota-kota yang harus kamu berikan kepada orang Lewi itu ialah dari tembok kota ke luar seribu hasta berkeliling."
 },
 {
   "id": 4852,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 5,
   "firman": "Di luar kota itu haruslah kamu mengukur dua ribu hasta di sisi timur dan dua ribu hasta di sisi selatan dan dua ribu hasta di sisi barat dan dua ribu hasta di sisi utara, sehingga kota itu berada di tengah-tengah; itulah bagi mereka tanah-tanah penggembalaan kota-kota."
 },
 {
   "id": 4853,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 6,
   "firman": "Mengenai kota-kota yang harus kamu berikan kepada orang Lewi itu, ialah enam kota perlindungan yang harus kamu berikan, supaya orang pembunuh dapat melarikan diri ke sana; di samping itu haruslah kamu memberikan empat puluh dua kota."
 },
 {
   "id": 4854,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 7,
   "firman": "Segala kota yang harus kamu berikan kepada orang Lewi itu berjumlah empat puluh delapan kota, semuanya dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 4855,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 8,
   "firman": "Mengenai kota-kota yang akan kamu berikan dari tanah milik orang Israel, dari suku yang banyak jumlahnya haruslah kamu ambil banyak, dan dari suku yang sedikit jumlahnya haruslah kamu ambil sedikit. Setiap suku harus memberikan dari kota-kotanya kepada orang Lewi sekadar milik pusaka yang dibagikan kepadanya.\""
 },
 {
   "id": 4856,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 9,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 4857,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 10,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila kamu menyeberangi sungai Yordan ke tanah Kanaan,"
 },
 {
   "id": 4858,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 11,
   "firman": "maka haruslah kamu memilih beberapa kota yang menjadi kota-kota perlindungan bagimu, supaya orang pembunuh yang telah membunuh seseorang dengan tidak sengaja dapat melarikan diri ke sana."
 },
 {
   "id": 4859,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 12,
   "firman": "Kota-kota itu akan menjadi tempat perlindungan bagimu terhadap penuntut balas, supaya pembunuh jangan mati, sebelum ia dihadapkan kepada rapat umat untuk diadili."
 },
 {
   "id": 4860,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 13,
   "firman": "Dan kota-kota yang kamu tentukan itu haruslah enam buah kota perlindungan bagimu."
 },
 {
   "id": 4861,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 14,
   "firman": "Tiga kota harus kamu tentukan di seberang sungai Yordan sini dan tiga kota harus kamu tentukan di tanah Kanaan; semuanya kota-kota perlindungan."
 },
 {
   "id": 4862,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 15,
   "firman": "Keenam kota itu haruslah menjadi tempat perlindungan bagi orang Israel dan bagi orang asing dan pendatang di tengah-tengahmu, supaya setiap orang yang telah membunuh seseorang dengan tidak sengaja dapat melarikan diri ke sana."
 },
 {
   "id": 4863,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 16,
   "firman": "Tetapi jika ia membunuh orang itu dengan benda besi, sehingga orang itu mati, maka ia seorang pembunuh; pastilah pembunuh itu dibunuh."
 },
 {
   "id": 4864,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 17,
   "firman": "Dan jika ia membunuh orang itu dengan batu di tangan yang mungkin menyebabkan matinya seseorang, sehingga orang itu mati, maka ia seorang pembunuh; pastilah pembunuh itu dibunuh."
 },
 {
   "id": 4865,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 18,
   "firman": "Atau jika ia membunuh orang itu dengan benda kayu di tangan yang mungkin menyebabkan matinya seseorang, sehingga orang itu mati, maka ia seorang pembunuh; pastilah pembunuh itu dibunuh."
 },
 {
   "id": 4866,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 19,
   "firman": "Penuntut darahlah yang harus membunuh pembunuh itu; pada waktu bertemu dengan dia ia harus membunuh dia."
 },
 {
   "id": 4867,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 20,
   "firman": "Juga jika ia menumbuk orang itu karena benci atau melempar dia dengan sengaja, sehingga orang itu mati,"
 },
 {
   "id": 4868,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 21,
   "firman": "atau jika ia memukul dia dengan tangannya karena perasaan permusuhan, sehingga orang itu mati, maka pastilah si pemukul itu dibunuh; ia seorang pembunuh; penuntut darah harus membunuh pembunuh itu, pada waktu bertemu dengan dia."
 },
 {
   "id": 4869,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 22,
   "firman": "Tetapi jika ia sekonyong-konyong menumbuk orang itu dengan tidak ada perasaan permusuhan, atau dengan tidak sengaja melemparkan sesuatu benda kepadanya,"
 },
 {
   "id": 4870,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 23,
   "firman": "atau dengan kurang ingat menjatuhkan kepada orang itu sesuatu batu yang mungkin menyebabkan matinya seseorang, sehingga orang itu mati, sedangkan dia tidak merasa bermusuh dengan orang itu dan juga tidak mengikhtiarkan celakanya,"
 },
 {
   "id": 4871,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 24,
   "firman": "maka haruslah rapat umat mengadili antara orang yang membunuh itu dan penuntut darah, menurut hukum-hukum ini,"
 },
 {
   "id": 4872,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 25,
   "firman": "dan haruslah rapat umat membebaskan pembunuh dari tangan penuntut darah, dan haruslah rapat umat mengembalikan dia ke kota perlindungan, ke tempat ia telah melarikan diri; di situlah ia harus tinggal sampai matinya imam besar yang telah diurapi dengan minyak yang kudus."
 },
 {
   "id": 4873,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 26,
   "firman": "Tetapi jika terjadi bahwa pembunuh itu keluar dari batas kota perlindungan, tempat ia melarikan diri,"
 },
 {
   "id": 4874,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 27,
   "firman": "dan penuntut darah mendapat dia di luar batas kota perlindungannya, dan penuntut darah membunuh pembunuh itu, maka tidaklah ia berhutang darah,"
 },
 {
   "id": 4875,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 28,
   "firman": "sebab pembunuh itu wajib tinggal di kota perlindungan sampai matinya imam besar, tetapi sesudah matinya imam besar bolehlah pembunuh itu kembali ke tanah kepunyaannya sendiri."
 },
 {
   "id": 4876,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 29,
   "firman": "Itulah semuanya yang harus menjadi ketetapan hukum bagimu turun-temurun di segala tempat kediamanmu."
 },
 {
   "id": 4877,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 30,
   "firman": "Setiap orang yang telah membunuh seseorang haruslah dibunuh sebagai pembunuh menurut keterangan saksi-saksi, tetapi kalau hanya satu orang saksi saja tidak cukup untuk memberi keterangan terhadap seseorang dalam perkara hukuman mati."
 },
 {
   "id": 4878,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 31,
   "firman": "Janganlah kamu menerima uang tebusan karena nyawa seorang pembunuh yang kesalahannya setimpal dengan hukuman mati, tetapi pastilah ia dibunuh."
 },
 {
   "id": 4879,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 32,
   "firman": "Juga janganlah kamu menerima uang tebusan karena seseorang yang telah melarikan diri ke kota perlindungannya, supaya ia boleh kembali untuk diam di tanahnya sebelum matinya imam besar."
 },
 {
   "id": 4880,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 33,
   "firman": "Jadi janganlah kamu mencemarkan negeri tempat tinggalmu, sebab darah itulah yang mencemarkan negeri itu, maka bagi negeri itu tidak dapat diadakan pendamaian oleh karena darah yang tertumpah di sana, kecuali dengan darah orang yang telah menumpahkannya."
 },
 {
   "id": 4881,
   "kitab": "Bil",
   "pasal": 35,
   "ayat": 34,
   "firman": "Maka janganlah najiskan negeri tempat kedudukanmu, yang di tengah-tengahnya Aku diam, sebab Aku, TUHAN, diam di tengah-tengah orang Israel.\""
 },
 {
   "id": 4882,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 1,
   "firman": "Mendekatlah kepala-kepala puak dari kaum bani Gilead bin Makhir bin Manasye, salah satu dari kaum-kaum keturunan Yusuf, dan berbicara di depan Musa dan pemimpin-pemimpin, kepala-kepala suku orang Israel,"
 },
 {
   "id": 4883,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 2,
   "firman": "kata mereka: \"TUHAN telah memerintahkan tuanku untuk memberikan tanah itu kepada orang Israel sebagai milik pusaka dengan membuang undi, dan oleh TUHAN telah diperintahkan kepada tuanku untuk memberikan milik pusaka Zelafehad, saudara kami, kepada anak-anaknya yang perempuan."
 },
 {
   "id": 4884,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 3,
   "firman": "Tetapi seandainya mereka kawin dengan salah seorang anak laki-laki dari suku lain di antara orang Israel, maka milik pusaka perempuan itu akan dikurangkan dari milik pusaka bapa-bapa kami dan akan ditambahkan kepada milik pusaka suku yang akan dimasukinya, jadi akan dikurangkan dari milik pusaka yang diundikan kepada kami."
 },
 {
   "id": 4885,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 4,
   "firman": "Maka apabila tiba tahun Yobel bagi orang Israel, milik pusaka perempuan itu akan ditambahkan kepada milik pusaka suku yang akan dimasukinya dan akan dikurangkan dari milik pusaka suku nenek moyang kami.\""
 },
 {
   "id": 4886,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 5,
   "firman": "Lalu Musa memerintahkan kepada orang Israel sesuai dengan titah TUHAN: \"Perkataan suku keturunan Yusuf itu benar."
 },
 {
   "id": 4887,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 6,
   "firman": "Inilah firman yang diperintahkan TUHAN mengenai anak-anak perempuan Zelafehad, bunyinya: Mereka boleh kawin dengan siapa saja yang suka kepada mereka, asal mereka kawin di lingkungan salah satu kaum dari suku ayah mereka."
 },
 {
   "id": 4888,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 7,
   "firman": "Sebab milik pusaka orang Israel tidak boleh beralih dari suku ke suku, tetapi orang Israel haruslah masing-masing memegang milik pusaka suku nenek moyangnya."
 },
 {
   "id": 4889,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 8,
   "firman": "Jadi setiap anak perempuan di antara suku-suku orang Israel yang telah mewarisi milik pusaka, haruslah kawin dengan seorang dari salah satu kaum yang termasuk suku ayahnya, supaya setiap orang Israel mewarisi milik pusaka nenek moyangnya."
 },
 {
   "id": 4890,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 9,
   "firman": "Sebab milik pusaka itu tidak boleh beralih dari suku ke suku, tetapi suku-suku orang Israel haruslah masing-masing memegang milik pusakanya sendiri.\""
 },
 {
   "id": 4891,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 10,
   "firman": "Seperti yang diperintahkan TUHAN kepada Musa, demikianlah diperbuat anak-anak perempuan Zelafehad."
 },
 {
   "id": 4892,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 11,
   "firman": "Maka Mahla, Tirza, Hogla, Milka dan Noa, anak-anak perempuan Zelafehad, kawin dengan anak-anak lelaki dari pihak saudara-saudara ayah mereka;"
 },
 {
   "id": 4893,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 12,
   "firman": "mereka kawin dengan laki-laki dari kaum-kaum bani Manasye bin Yusuf, sehingga milik pusaka mereka tetap tinggal pada suku kaum ayahnya."
 },
 {
   "id": 4894,
   "kitab": "Bil",
   "pasal": 36,
   "ayat": 13,
   "firman": "Itulah perintah dan peraturan yang diperintahkan TUHAN kepada orang Israel dengan perantaraan Musa di dataran Moab di tepi sungai Yordan dekat Yerikho."
 },
 {
   "id": 4895,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah perkataan-perkataan yang diucapkan Musa kepada seluruh orang Israel di seberang sungai Yordan, di padang gurun, di Araba-Yordan, di tentangan Suf, antara Paran dengan Tofel, Laban, Hazerot dan Di-Zahab."
 },
 {
   "id": 4896,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 2,
   "firman": "Sebelas hari perjalanan jauhnya dari Horeb sampai Kadesh-Barnea, melalui jalan pegunungan Seir."
 },
 {
   "id": 4897,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 3,
   "firman": "Pada tanggal satu bulan sebelas tahun keempat puluh berbicaralah Musa kepada orang Israel sesuai dengan segala yang diperintahkan TUHAN kepadanya demi mereka,"
 },
 {
   "id": 4898,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 4,
   "firman": "setelah ia memukul kalah Sihon, raja orang Amori, yang diam di Hesybon, dan Og, raja negeri Basan, yang diam di Asytarot, dekat Edrei."
 },
 {
   "id": 4899,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 5,
   "firman": "Di seberang sungai Yordan, di tanah Moab, mulailah Musa menguraikan hukum Taurat ini, katanya:"
 },
 {
   "id": 4900,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 6,
   "firman": "\"TUHAN, Allah kita, telah berfirman kepada kita di Horeb, demikian: Telah cukup lama kamu tinggal di gunung ini."
 },
 {
   "id": 4901,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 7,
   "firman": "Majulah, berangkatlah, pergilah ke pegunungan orang Amori dan kepada semua tetangga mereka di Araba-Yordan, di Pegunungan, di Daerah Bukit, di Tanah Negeb dan di tepi pantai laut, yakni negeri orang Kanaan, dan ke gunung Libanon sampai Efrat, sungai besar itu."
 },
 {
   "id": 4902,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 8,
   "firman": "Ketahuilah, Aku telah menyerahkan negeri itu kepadamu; masukilah, dudukilah negeri yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu, yakni Abraham, Ishak dan Yakub, untuk memberikannya kepada mereka dan kepada keturunannya.\""
 },
 {
   "id": 4903,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 9,
   "firman": "\"Pada waktu itu aku berkata kepadamu, demikian: Seorang diri aku tidak dapat memikul tanggung jawab atas kamu."
 },
 {
   "id": 4904,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 10,
   "firman": "TUHAN, Allahmu, telah membuat kamu banyak dan sesungguhnya, sekarang kamu sudah seperti bintang-bintang di langit banyaknya."
 },
 {
   "id": 4905,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 11,
   "firman": "TUHAN, Allah nenek moyangmu, kiranya menambahi kamu seribu kali lagi dari jumlahmu sekarang dan memberkati kamu seperti yang dijanjikan-Nya kepadamu."
 },
 {
   "id": 4906,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi bagaimana seorang diri aku dapat memikul tanggung jawab atas kesusahanmu, atas bebanmu dan perkaramu?"
 },
 {
   "id": 4907,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kemukakanlah dari suku-sukumu orang-orang yang bijaksana, berakal budi dan berpengalaman, maka aku akan mengangkat mereka menjadi kepala atas kamu."
 },
 {
   "id": 4908,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 14,
   "firman": "Lalu kamu menjawab aku: Memang baik apa yang kauanjurkan untuk dilakukan itu."
 },
 {
   "id": 4909,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 15,
   "firman": "Kemudian aku mengambil kepala-kepala sukumu, yakni orang-orang yang bijaksana dan berpengalaman, lalu aku mengangkat mereka menjadi pemimpin atas kamu, yakni sebagai kepala pasukan seribu, kepala pasukan seratus, kepala pasukan lima puluh dan kepala pasukan sepuluh dan sebagai pengatur pasukan bagi suku-sukumu."
 },
 {
   "id": 4910,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 16,
   "firman": "Dan pada waktu itu aku memerintahkan kepada para hakimmu, demikian: Berilah perhatian kepada perkara-perkara di antara saudara-saudaramu dan berilah keputusan yang adil di dalam perkara-perkara antara seseorang dengan saudaranya atau dengan orang asing yang ada padanya."
 },
 {
   "id": 4911,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 17,
   "firman": "Dalam mengadili jangan pandang bulu. Baik perkara orang kecil maupun perkara orang besar harus kamu dengarkan. Jangan gentar terhadap siapapun, sebab pengadilan adalah kepunyaan Allah. Tetapi perkara yang terlalu sukar bagimu, harus kamu hadapkan kepadaku, supaya aku mendengarnya."
 },
 {
   "id": 4912,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 18,
   "firman": "Demikianlah aku pada waktu itu memerintahkan kepadamu segala hal yang harus kamu lakukan.\""
 },
 {
   "id": 4913,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 19,
   "firman": "\"Kemudian kita berangkat dari Horeb dan berjalan melalui segenap padang gurun yang besar dan dahsyat yang telah kamu lihat itu, ke arah pegunungan orang Amori, seperti yang diperintahkan kepada kita oleh TUHAN, Allah kita; lalu kita sampai ke Kadesh-Barnea."
 },
 {
   "id": 4914,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ketika itu aku berkata kepadamu: Kamu sudah sampai ke pegunungan orang Amori, yang diberikan kepada kita oleh TUHAN, Allah kita."
 },
 {
   "id": 4915,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 21,
   "firman": "Ketahuilah, TUHAN, Allahmu, telah menyerahkan negeri itu kepadamu. Majulah, dudukilah, seperti yang difirmankan kepadamu oleh TUHAN, Allah nenek moyangmu. Janganlah takut dan janganlah patah hati."
 },
 {
   "id": 4916,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 22,
   "firman": "Lalu kamu sekalian mendekati aku dan berkata: Marilah kita menyuruh beberapa orang mendahului kita untuk menyelidiki negeri itu bagi kita dan membawa kabar kepada kita tentang jalan yang akan kita lalui, dan tentang kota-kota yang akan kita datangi."
 },
 {
   "id": 4917,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 23,
   "firman": "Hal itu kupandang baik. Jadi aku memilih dari padamu dua belas orang, dari tiap-tiap suku seorang."
 },
 {
   "id": 4918,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 24,
   "firman": "Mereka pergi dan berjalan ke arah pegunungan, lalu sampai ke lembah Eskol, kemudian menyelidiki negeri itu."
 },
 {
   "id": 4919,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 25,
   "firman": "Maka mereka mengambil buah-buahan negeri itu dan membawanya kepada kita. Pula mereka membawa kabar kepada kita, demikian: Negeri yang diberikan TUHAN, Allah kita, kepada kita itu baik."
 },
 {
   "id": 4920,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 26,
   "firman": "Tetapi kamu tidak mau berjalan ke sana, kamu menentang titah TUHAN, Allahmu."
 },
 {
   "id": 4921,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 27,
   "firman": "Kamu menggerutu di dalam kemahmu serta berkata: Karena TUHAN membenci kita, maka Ia membawa kita keluar dari tanah Mesir untuk menyerahkan kita ke dalam tangan orang Amori, supaya dimusnahkan."
 },
 {
   "id": 4922,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 28,
   "firman": "Ke manakah pula kita maju? Saudara-saudara kita telah membuat hati kita tawar dengan mengatakan: Orang-orang itu lebih besar dan lebih tinggi dari pada kita, kota-kota di sana besar dan kubu-kubunya sampai ke langit, lagipula kami melihat orang-orang Enak di sana."
 },
 {
   "id": 4923,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 29,
   "firman": "Ketika itu aku berkata kepadamu: Janganlah gemetar, janganlah takut kepada mereka;"
 },
 {
   "id": 4924,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 30,
   "firman": "TUHAN, Allahmu, yang berjalan di depanmu, Dialah yang akan berperang untukmu sama seperti yang dilakukan-Nya bagimu di Mesir, di depan matamu,"
 },
 {
   "id": 4925,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 31,
   "firman": "dan di padang gurun, di mana engkau melihat bahwa TUHAN, Allahmu, mendukung engkau, seperti seseorang mendukung anaknya, sepanjang jalan yang kamu tempuh, sampai kamu tiba di tempat ini."
 },
 {
   "id": 4926,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 32,
   "firman": "Tetapi walaupun demikian, kamu tidak percaya kepada TUHAN, Allahmu,"
 },
 {
   "id": 4927,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 33,
   "firman": "yang berjalan di depanmu di perjalanan untuk mencari tempat bagimu, di mana kamu dapat berkemah: dengan api pada waktu malam dan dengan awan pada waktu siang, untuk memperlihatkan kepadamu jalan yang harus kamu tempuh.\""
 },
 {
   "id": 4928,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 34,
   "firman": "\"Ketika TUHAN mendengar gerutumu itu, Ia menjadi murka dan bersumpah:"
 },
 {
   "id": 4929,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 35,
   "firman": "Tidak seorangpun dari orang-orang ini, angkatan yang jahat ini, akan melihat negeri yang baik, yang dengan sumpah Kujanjikan untuk memberikannya kepada nenek moyangmu,"
 },
 {
   "id": 4930,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 36,
   "firman": "kecuali Kaleb bin Yefune. Dialah yang akan melihat negeri itu dan kepadanya dan kepada anak-anaknya akan Kuberikan negeri yang diinjaknya itu, karena dengan sepenuh hati ia mengikuti TUHAN."
 },
 {
   "id": 4931,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 37,
   "firman": "Juga kepadaku TUHAN murka oleh karena kamu, dan Ia berfirman: Juga engkau tidak akan masuk ke sana."
 },
 {
   "id": 4932,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 38,
   "firman": "Yosua bin Nun, pelayanmu, dialah yang akan masuk ke sana. Berilah kepadanya semangat, sebab dialah yang akan memimpin orang Israel sampai mereka memiliki negeri itu."
 },
 {
   "id": 4933,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 39,
   "firman": "Dan anak-anakmu yang kecil, yang kamu katakan akan menjadi rampasan, dan anak-anakmu yang sekarang ini yang belum mengetahui tentang yang baik dan yang jahat, merekalah yang akan masuk ke sana dan kepada merekalah Aku akan memberikannya, dan merekalah yang akan memilikinya."
 },
 {
   "id": 4934,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 40,
   "firman": "Tetapi kamu ini, baliklah, berangkatlah ke padang gurun, ke arah Laut Teberau.\""
 },
 {
   "id": 4935,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 41,
   "firman": "\"Lalu kamu menjawab, katamu kepadaku: Kami berbuat dosa kepada TUHAN. Kami mau maju berperang, menurut segala yang diperintahkan kepada kami oleh TUHAN, Allah kita. Dan setiap orang dari padamu menyandang senjata perangnya, sebab kamu menganggap mudah untuk berjalan maju ke arah pegunungan."
 },
 {
   "id": 4936,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 42,
   "firman": "Tetapi TUHAN berfirman kepadaku: Katakanlah kepada mereka: Janganlah kamu maju dan janganlah kamu berperang, sebab Aku tidak ada di tengah-tengahmu, nanti kamu terpukul kalah oleh musuhmu."
 },
 {
   "id": 4937,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 43,
   "firman": "Dan aku berbicara kepadamu tetapi kamu tidak mendengarkan, kamu menentang titah TUHAN; kamu berlaku terlalu berani dan maju ke arah pegunungan."
 },
 {
   "id": 4938,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 44,
   "firman": "Kemudian orang Amori yang diam di pegunungan itu keluar menyerbu kamu, dan mereka mengejar kamu seperti lebah dan mengalahkan kamu dari Seir sampai Horma."
 },
 {
   "id": 4939,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 45,
   "firman": "Lalu kamu pulang dan menangis di hadapan TUHAN; tetapi TUHAN tidak mendengarkan tangisanmu dan tidak memberi telinga kepada suaramu."
 },
 {
   "id": 4940,
   "kitab": "Ula",
   "pasal": 1,
   "ayat": 46,
   "firman": "Demikianlah kamu lama tinggal di Kadesh, yakni sepanjang waktu kamu tinggal di sana.\""
 },
 {
   "id": 4941,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 1,
   "firman": "\"Kemudian kita balik dan berangkat ke padang gurun, ke arah Laut Teberau, seperti yang difirmankan TUHAN kepadaku. Lama kita berjalan keliling pegunungan Seir."
 },
 {
   "id": 4942,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu berfirmanlah TUHAN kepadaku, demikian:"
 },
 {
   "id": 4943,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 3,
   "firman": "Telah cukup lamanya kamu berjalan keliling pegunungan ini, beloklah sekarang ke utara."
 },
 {
   "id": 4944,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 4,
   "firman": "Perintahkanlah kepada bangsa itu, demikian: Sebentar lagi kamu akan berjalan melalui daerah saudara-saudaramu, bani Esau, yang diam di Seir; mereka akan takut kepadamu. Tetapi hati-hatilah sekali;"
 },
 {
   "id": 4945,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 5,
   "firman": "janganlah menyerang mereka, sebab Aku tidak akan memberikan kepadamu setapak kaki dari negeri mereka, karena kepada Esau telah Kuberikan pegunungan Seir menjadi miliknya."
 },
 {
   "id": 4946,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 6,
   "firman": "Makanan haruslah kamu beli dari mereka dengan uang, supaya kamu dapat makan; juga air haruslah kamu beli dari mereka dengan uang, supaya kamu dapat minum."
 },
 {
   "id": 4947,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 7,
   "firman": "Sebab TUHAN, Allahmu, memberkati engkau dalam segala pekerjaan tanganmu. Ia memperhatikan perjalananmu melalui padang gurun yang besar ini; keempat puluh tahun ini TUHAN, Allahmu, menyertai engkau, dan engkau tidak kekurangan apapun."
 },
 {
   "id": 4948,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 8,
   "firman": "Kemudian kita berjalan terus, meninggalkan daerah saudara-saudara kita, bani Esau yang diam di Seir, meninggalkan jalan dari Araba-Yordan, yakni dari Elat dan Ezion-Geber. Sesudah itu kita belok dan berjalan terus ke arah padang gurun Moab."
 },
 {
   "id": 4949,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 9,
   "firman": "Lalu berfirmanlah TUHAN kepadaku: Janganlah melawan Moab dan janganlah menyerang mereka, sebab Aku tidak akan memberikan kepadamu apapun dari negerinya menjadi milikmu, karena Ar telah Kuberikan kepada bani Lot menjadi miliknya."
 },
 {
   "id": 4950,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 10,
   "firman": "Dahulu orang Emim diam di sana, suatu bangsa yang besar dan banyak jumlahnya, tinggi seperti orang Enak."
 },
 {
   "id": 4951,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 11,
   "firman": "Mereka itupun dikira orang Refaim, seperti juga orang Enak, tetapi orang Moab menyebut mereka orang Emim."
 },
 {
   "id": 4952,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan dahulu di Seir diam orang Hori, tetapi bani Esau telah menduduki daerah mereka, memunahkan mereka dari hadapannya, lalu menetap di sana menggantikan mereka, seperti yang dilakukan orang Israel dengan negeri miliknya yang diberikan TUHAN kepada mereka."
 },
 {
   "id": 4953,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 13,
   "firman": "Jadi sekarang bersiaplah kamu dan seberangilah sungai Zered. Lalu kita menyeberangi sungai Zered."
 },
 {
   "id": 4954,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lamanya kita berjalan sejak dari Kadesh-Barnea sampai kita ada di seberang sungai Zered, ada tiga puluh delapan tahun, sampai seluruh angkatan itu, yakni prajurit, habis binasa dari perkemahan, seperti yang dijanjikan TUHAN dengan sumpah kepada mereka;"
 },
 {
   "id": 4955,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 15,
   "firman": "dan tangan TUHAN juga melawan mereka untuk menghamburkan mereka dari perkemahan, sampai mereka habis binasa."
 },
 {
   "id": 4956,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 16,
   "firman": "Maka ketika dari bangsa itu telah habis binasa semua prajurit,"
 },
 {
   "id": 4957,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 17,
   "firman": "berfirmanlah TUHAN kepadaku:"
 },
 {
   "id": 4958,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 18,
   "firman": "Pada hari ini engkau akan berjalan melintasi perbatasan Moab, yakni Ar,"
 },
 {
   "id": 4959,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 19,
   "firman": "maka engkau sampai ke dekat bani Amon. Janganlah melawan mereka dan janganlah menyerang mereka, sebab Aku tidak akan memberikan kepadamu apapun dari negeri bani Amon itu menjadi milikmu, karena Aku telah memberikannya kepada bani Lot menjadi miliknya."
 },
 {
   "id": 4960,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 20,
   "firman": "--Negeri inipun dikira orang negeri orang Refaim. Dahulu orang Refaim diam di sana, tetapi orang Amon menyebut mereka orang Zamzumim,"
 },
 {
   "id": 4961,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 21,
   "firman": "suatu bangsa yang besar dan banyak jumlahnya, tinggi seperti orang Enak, tetapi TUHAN telah memunahkan mereka dari hadapan bani Amon, sehingga orang-orang ini menduduki daerah mereka dan menetap di sana menggantikan mereka;"
 },
 {
   "id": 4962,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 22,
   "firman": "seperti yang dilakukan TUHAN bagi bani Esau yang diam di Seir, ketika Ia memunahkan orang Hori dari hadapan mereka, sehingga mereka menduduki daerah orang Hori itu dan menetap di sana menggantikan orang-orang itu sampai sekarang."
 },
 {
   "id": 4963,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 23,
   "firman": "Juga orang Awi yang diam di kampung-kampung sampai Gaza, dipunahkan oleh orang Kaftor yang berasal dari Kaftor, lalu orang Kaftor itu menetap di sana menggantikan mereka. --"
 },
 {
   "id": 4964,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 24,
   "firman": "Bersiaplah kamu, berangkatlah dan seberangilah sungai Arnon. Ketahuilah, Aku menyerahkan Sihon, raja Hesybon, orang Amori itu, beserta negerinya ke dalam tanganmu; mulailah menduduki negerinya dan seranglah Sihon."
 },
 {
   "id": 4965,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 25,
   "firman": "Pada hari ini Aku mulai mendatangkan ke atas bangsa-bangsa di seluruh kolong langit keseganan dan ketakutan terhadap kamu, sehingga mereka menggigil dan gemetar karena engkau, apabila mereka mendengar tentang kamu.\""
 },
 {
   "id": 4966,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 26,
   "firman": "\"Kemudian aku menyuruh utusan dari padang gurun Kedemot kepada Sihon, raja Hesybon, menyampaikan pesan perdamaian, bunyinya:"
 },
 {
   "id": 4967,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 27,
   "firman": "Izinkanlah aku berjalan melalui negerimu. Aku akan tetap berjalan mengikuti jalan raya, dengan tidak menyimpang ke kanan atau ke kiri."
 },
 {
   "id": 4968,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 28,
   "firman": "Juallah makanan kepadaku dengan bayaran uang, supaya aku dapat makan, dan berikanlah air kepadaku ganti uang, supaya aku dapat minum; hanya izinkanlah aku lewat dengan berjalan kaki--"
 },
 {
   "id": 4969,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 29,
   "firman": "seperti yang diperbuat kepadaku oleh bani Esau yang diam di Seir dan oleh orang Moab yang diam di Ar--sampai aku menyeberangi sungai Yordan pergi ke negeri yang diberikan kepada kami oleh TUHAN, Allah kami."
 },
 {
   "id": 4970,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 30,
   "firman": "Tetapi Sihon, raja Hesybon, tidak mau memberi kita berjalan melalui daerahnya, sebab TUHAN, Allahmu, membuat dia keras kepala dan tegar hati, dengan maksud menyerahkan dia ke dalam tanganmu, seperti yang terjadi sekarang ini."
 },
 {
   "id": 4971,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 31,
   "firman": "Lalu TUHAN berfirman kepadaku: Ketahuilah, Aku mulai menyerahkan Sihon dan negerinya kepadamu. Mulailah menduduki negerinya supaya menjadi milikmu."
 },
 {
   "id": 4972,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 32,
   "firman": "Kemudian Sihon dan seluruh tentaranya maju mendatangi kita, untuk berperang dekat Yahas,"
 },
 {
   "id": 4973,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 33,
   "firman": "tetapi TUHAN, Allah kita, menyerahkan dia kepada kita, sehingga kita mengalahkan dia dengan anak-anaknya dan seluruh tentaranya."
 },
 {
   "id": 4974,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 34,
   "firman": "Pada waktu itu kita merebut segala kotanya dan menumpas penduduk setiap kota: laki-laki dan perempuan serta anak-anak. Tidak ada seorangpun yang kita biarkan terluput;"
 },
 {
   "id": 4975,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 35,
   "firman": "hanya hewan kita rampas bagi kita sendiri, seperti juga jarahan dari kota-kota yang telah kita rebut."
 },
 {
   "id": 4976,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 36,
   "firman": "Mulai dari Aroer, di tepi sungai Arnon, dan kota di lembah itu, sampai Gilead tidak ada kota yang bentengnya terlalu kuat bagi kita; sebab TUHAN, Allah kita, menyerahkan semuanya kepada kita."
 },
 {
   "id": 4977,
   "kitab": "Ula",
   "pasal": 2,
   "ayat": 37,
   "firman": "Hanya negeri bani Amon tidak engkau dekati, baik sungai Yabok sepanjang tepinya maupun kota-kota di pegunungan, tepat seperti yang dilarang TUHAN, Allah kita.\""
 },
 {
   "id": 4978,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 1,
   "firman": "\"Kemudian beloklah kita dan maju ke arah Basan. Dan Og, raja Basan, dengan seluruh tentaranya maju mendatangi kita, untuk berperang di Edrei."
 },
 {
   "id": 4979,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 2,
   "firman": "Tetapi TUHAN berfirman kepadaku: Janganlah takut kepadanya, sebab Aku menyerahkan dia ke dalam tanganmu beserta seluruh tentaranya dan negerinya, dan perlakukanlah dia seperti yang kaulakukan terhadap Sihon, raja orang Amori, yang diam di Hesybon."
 },
 {
   "id": 4980,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 3,
   "firman": "Dan TUHAN, Allah kita, menyerahkan juga Og, raja Basan, beserta seluruh tentaranya ke dalam tangan kita dan kita mengalahkan dia, sehingga tidak seorangpun luput."
 },
 {
   "id": 4981,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 4,
   "firman": "Pada waktu itu kita merebut segala kotanya; tidak ada kota yang tidak kita rampas dari pada mereka: enam puluh kota, seluruh wilayah Argob, kerajaan Og di Basan."
 },
 {
   "id": 4982,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 5,
   "firman": "Semuanya itu adalah kota berkubu, dengan tembok yang tinggi-tinggi, dengan pintu-pintu gerbang dan palang-palangnya; lain dari pada itu sangat banyak kota yang tidak berkubu."
 },
 {
   "id": 4983,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 6,
   "firman": "Kita menumpas seluruh penduduknya, seperti yang kita lakukan terhadap Sihon, raja Hesybon, dengan menumpas penduduk setiap kota: laki-laki, perempuan dan anak-anak."
 },
 {
   "id": 4984,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 7,
   "firman": "Tetapi segala hewan dan jarahan dari kota-kota itu kita rampas bagi kita sendiri."
 },
 {
   "id": 4985,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 8,
   "firman": "Jadi pada waktu itu dari tangan kedua raja orang Amori itu kita merampas negeri yang di seberang sungai Yordan, mulai dari sungai Arnon sampai gunung Hermon"
 },
 {
   "id": 4986,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 9,
   "firman": "--orang Sidon menyebut Hermon itu Siryon dan orang Amori menyebutnya Senir--,"
 },
 {
   "id": 4987,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 10,
   "firman": "segala kota di dataran tinggi, seluruh Gilead dan seluruh Basan sampai Salkha dan Edrei, kota-kota kerajaan Og di Basan."
 },
 {
   "id": 4988,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 11,
   "firman": "Hanya Og, raja Basan, yang tinggal hidup dari sisa-sisa orang Refaim. Sesungguhnya, ranjangnya adalah ranjang dari besi; bukankah itu masih ada di kota Raba bani Amon? Sembilan hasta panjangnya dan empat hasta lebarnya, menurut hasta biasa.\""
 },
 {
   "id": 4989,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 12,
   "firman": "\"Adapun negeri itu telah kita duduki pada waktu itu; mulai dari Aroer yang di tepi sungai Arnon, beserta setengah dari pegunungan Gilead dengan kota-kotanya aku berikan kepada orang Ruben dan orang Gad;"
 },
 {
   "id": 4990,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 13,
   "firman": "dan yang masih tinggal dari Gilead beserta seluruh Basan, kerajaan Og, yakni seluruh wilayah Argob, aku berikan kepada suku Manasye yang setengah itu. --Seluruh Basan ini disebut negeri orang Refaim. --"
 },
 {
   "id": 4991,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 14,
   "firman": "Yair, anak Manasye, mengambil seluruh wilayah Argob sampai daerah orang Gesur dan orang Maakha, dan menamai daerah itu, yakni Basan, menurut namanya sendiri: Hawot-Yair, sampai sekarang."
 },
 {
   "id": 4992,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 15,
   "firman": "Kepada Makhir kuberikan Gilead."
 },
 {
   "id": 4993,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 16,
   "firman": "Kepada orang Ruben dan kepada orang Gad kuberikan sebagian dari Gilead, sebelah sini sampai sungai Arnon, yakni setengah dari sungai itu dengan daerah pinggirnya, dan sebelah sana sampai sungai Yabok, batas daerah bani Amon;"
 },
 {
   "id": 4994,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 17,
   "firman": "selanjutnya Araba-Yordan dan sungai Yordan dengan daerah pinggirnya, mulai dari Kineret sampai ke Laut Araba, yakni Laut Asin di kaki lereng gunung Pisga ke arah timur."
 },
 {
   "id": 4995,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 18,
   "firman": "Pada waktu itu aku memerintahkan kepadamu, demikian: TUHAN, Allahmu, telah memberikan negeri ini kepadamu untuk dimiliki; namun kamu, yakni semua orang yang gagah perkasa, harus menyeberang dengan bersenjata di depan saudara-saudaramu, orang Israel."
 },
 {
   "id": 4996,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 19,
   "firman": "Hanya isteri dan anak-anakmu serta ternak-ternakmu--aku tahu ada banyak ternak padamu--boleh tinggal di kota-kota yang telah kuberikan kepadamu,"
 },
 {
   "id": 4997,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 20,
   "firman": "sampai TUHAN mengaruniakan keamanan kepada saudara-saudaramu seperti kepadamu, dan merekapun memiliki negeri, yang diberikan TUHAN, Allahmu, kepada mereka di seberang sungai Yordan. Sesudah itu bolehlah kamu pulang, masing-masing ke tanah miliknya yang telah kuberikan kepadamu."
 },
 {
   "id": 4998,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 21,
   "firman": "Dan kepada Yosua kuperintahkan pada waktu itu, demikian: Matamu sendirilah yang melihat segala yang dilakukan TUHAN, Allahmu, terhadap kedua raja itu. Demikianlah akan dilakukan TUHAN terhadap segala kerajaan, ke mana engkau pergi."
 },
 {
   "id": 4999,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 22,
   "firman": "Janganlah takut kepada mereka, sebab TUHAN, Allahmu, Dialah yang berperang untukmu.\""
 },
 {
   "id": 5000,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 23,
   "firman": "\"Juga pada waktu itu aku mohon kasih karunia dari pada TUHAN, demikian:"
 },
 {
   "id": 5001,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 24,
   "firman": "Ya, Tuhan ALLAH, Engkau telah mulai memperlihatkan kepada hamba-Mu ini kebesaran-Mu dan tangan-Mu yang kuat; sebab allah manakah di langit dan di bumi, yang dapat melakukan perbuatan perkasa seperti Engkau?"
 },
 {
   "id": 5002,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 25,
   "firman": "Biarlah aku menyeberang dan melihat negeri yang baik yang di seberang sungai Yordan, tanah pegunungan yang baik itu, dan gunung Libanon."
 },
 {
   "id": 5003,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 26,
   "firman": "Tetapi TUHAN murka terhadap aku oleh karena kamu dan tidaklah mendengarkan permohonanku. TUHAN berfirman kepadaku: Cukup! Jangan lagi bicarakan perkara itu dengan Aku."
 },
 {
   "id": 5004,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 27,
   "firman": "Naiklah ke puncak gunung Pisga dan layangkanlah pandangmu ke barat, ke utara, ke selatan dan ke timur dan lihatlah baik-baik, sebab sungai Yordan ini tidak akan kauseberangi."
 },
 {
   "id": 5005,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 28,
   "firman": "Dan berilah perintah kepada Yosua, kuatkan dan teguhkanlah hatinya, sebab dialah yang akan menyeberang di depan bangsa ini dan dialah yang akan memimpin mereka sampai mereka memiliki negeri yang akan kaulihat itu."
 },
 {
   "id": 5006,
   "kitab": "Ula",
   "pasal": 3,
   "ayat": 29,
   "firman": "Demikianlah kita tinggal di lembah di tentangan Bet-Peor.\""
 },
 {
   "id": 5007,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 1,
   "firman": "\"Maka sekarang, hai orang Israel, dengarlah ketetapan dan peraturan yang kuajarkan kepadamu untuk dilakukan, supaya kamu hidup dan memasuki serta menduduki negeri yang diberikan kepadamu oleh TUHAN, Allah nenek moyangmu."
 },
 {
   "id": 5008,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 2,
   "firman": "Janganlah kamu menambahi apa yang kuperintahkan kepadamu dan janganlah kamu menguranginya, dengan demikian kamu berpegang pada perintah TUHAN, Allahmu, yang kusampaikan kepadamu."
 },
 {
   "id": 5009,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 3,
   "firman": "Matamu sendiri telah melihat apa yang diperbuat TUHAN mengenai Baal-Peor, sebab TUHAN, Allahmu, telah memunahkan dari tengah-tengahmu semua orang yang mengikuti Baal-Peor,"
 },
 {
   "id": 5010,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 4,
   "firman": "sedangkan kamu sekalian yang berpaut pada TUHAN, Allahmu, masih hidup pada hari ini."
 },
 {
   "id": 5011,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 5,
   "firman": "Ingatlah, aku telah mengajarkan ketetapan dan peraturan kepadamu, seperti yang diperintahkan kepadaku oleh TUHAN, Allahku, supaya kamu melakukan yang demikian di dalam negeri, yang akan kamu masuki untuk mendudukinya."
 },
 {
   "id": 5012,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lakukanlah itu dengan setia, sebab itulah yang akan menjadi kebijaksanaanmu dan akal budimu di mata bangsa-bangsa yang pada waktu mendengar segala ketetapan ini akan berkata: Memang bangsa yang besar ini adalah umat yang bijaksana dan berakal budi."
 },
 {
   "id": 5013,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 7,
   "firman": "Sebab bangsa besar manakah yang mempunyai allah yang demikian dekat kepadanya seperti TUHAN, Allah kita, setiap kali kita memanggil kepada-Nya?"
 },
 {
   "id": 5014,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dan bangsa besar manakah yang mempunyai ketetapan dan peraturan demikian adil seperti seluruh hukum ini, yang kubentangkan kepadamu pada hari ini?"
 },
 {
   "id": 5015,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tetapi waspadalah dan berhati-hatilah, supaya jangan engkau melupakan hal-hal yang dilihat oleh matamu sendiri itu, dan supaya jangan semuanya itu hilang dari ingatanmu seumur hidupmu. Beritahukanlah kepada anak-anakmu dan kepada cucu cicitmu semuanya itu,"
 },
 {
   "id": 5016,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 10,
   "firman": "yakni hari itu ketika engkau berdiri di hadapan TUHAN, Allahmu, di Horeb, waktu TUHAN berfirman kepadaku: Suruhlah bangsa itu berkumpul kepada-Ku, maka Aku akan memberi mereka mendengar segala perkataan-Ku, sehingga mereka takut kepada-Ku selama mereka hidup di muka bumi dan mengajarkan demikian kepada anak-anak mereka."
 },
 {
   "id": 5017,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 11,
   "firman": "Lalu kamu mendekat dan berdiri di kaki gunung itu, sedang gunung itu menyala sampai ke pusar langit dalam gelap gulita, awan dan kegelapan."
 },
 {
   "id": 5018,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 12,
   "firman": "Lalu berfirmanlah TUHAN kepadamu dari tengah-tengah api; suara kata-kata kamu dengar, tetapi suatu rupa tidak kamu lihat, hanya ada suara."
 },
 {
   "id": 5019,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 13,
   "firman": "Dan Ia memberitahukan kepadamu perjanjian, yang diperintahkan-Nya kepadamu untuk dilakukan, yakni Kesepuluh Firman dan Ia menuliskannya pada dua loh batu."
 },
 {
   "id": 5020,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 14,
   "firman": "Dan pada waktu itu aku diperintahkan TUHAN untuk mengajarkan kepadamu ketetapan dan peraturan, supaya kamu melakukannya di negeri, ke mana kamu pergi untuk mendudukinya."
 },
 {
   "id": 5021,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 15,
   "firman": "Hati-hatilah sekali--sebab kamu tidak melihat sesuatu rupa pada hari TUHAN berfirman kepadamu di Horeb dari tengah-tengah api--"
 },
 {
   "id": 5022,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 16,
   "firman": "supaya jangan kamu berlaku busuk dengan membuat bagimu patung yang menyerupai berhala apapun: yang berbentuk laki-laki atau perempuan;"
 },
 {
   "id": 5023,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 17,
   "firman": "yang berbentuk binatang yang di bumi, atau berbentuk burung bersayap yang terbang di udara,"
 },
 {
   "id": 5024,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 18,
   "firman": "atau berbentuk binatang yang merayap di muka bumi, atau berbentuk ikan yang ada di dalam air di bawah bumi;"
 },
 {
   "id": 5025,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 19,
   "firman": "dan juga supaya jangan engkau mengarahkan matamu ke langit, sehingga apabila engkau melihat matahari, bulan dan bintang, segenap tentara langit, engkau disesatkan untuk sujud menyembah dan beribadah kepada sekaliannya itu, yang justru diberikan TUHAN, Allahmu, kepada segala bangsa di seluruh kolong langit sebagai bagian mereka,"
 },
 {
   "id": 5026,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 20,
   "firman": "sedangkan TUHAN telah mengambil kamu dan membawa kamu keluar dari dapur peleburan besi, dari Mesir, untuk menjadi umat milik-Nya sendiri, seperti yang terjadi sekarang ini."
 },
 {
   "id": 5027,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 21,
   "firman": "Tetapi TUHAN menjadi murka terhadap aku oleh karena kamu, dan Ia bersumpah, bahwa aku tidak akan menyeberangi sungai Yordan dan tidak akan masuk ke dalam negeri yang baik, yang diberikan TUHAN, Allahmu, kepadamu menjadi milik pusakamu."
 },
 {
   "id": 5028,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 22,
   "firman": "Sebab aku akan mati di negeri ini dan tidak akan menyeberangi sungai Yordan, tetapi kamu akan menyeberanginya dan menduduki negeri yang baik itu."
 },
 {
   "id": 5029,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 23,
   "firman": "Hati-hatilah, supaya jangan kamu melupakan perjanjian TUHAN, Allahmu, yang telah diikat-Nya dengan kamu dan membuat bagimu patung yang menyerupai apapun yang oleh TUHAN, Allahmu, dilarang kauperbuat."
 },
 {
   "id": 5030,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 24,
   "firman": "Sebab TUHAN, Allahmu, adalah api yang menghanguskan, Allah yang cemburu."
 },
 {
   "id": 5031,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 25,
   "firman": "Apabila kamu beranak cucu dan kamu telah tua di negeri itu lalu kamu berlaku busuk dengan membuat patung yang menyerupai apapun juga, dan melakukan apa yang jahat di mata TUHAN, Allahmu, sehingga kamu menimbulkan sakit hati-Nya,"
 },
 {
   "id": 5032,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 26,
   "firman": "maka aku memanggil langit dan bumi menjadi saksi terhadap kamu pada hari ini, bahwa pastilah kamu habis binasa dengan segera dari negeri ke mana kamu menyeberangi sungai Yordan untuk mendudukinya; tidak akan lanjut umurmu di sana, tetapi pastilah kamu punah."
 },
 {
   "id": 5033,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 27,
   "firman": "TUHAN akan menyerakkan kamu di antara bangsa-bangsa dan hanya dengan jumlah yang sedikit kamu akan tinggal di antara bangsa-bangsa, ke mana TUHAN akan menyingkirkan kamu."
 },
 {
   "id": 5034,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 28,
   "firman": "Maka di sana kamu akan beribadah kepada allah, buatan tangan manusia, dari kayu dan batu, yang tidak dapat melihat, tidak dapat mendengar, tidak dapat makan dan tidak dapat mencium."
 },
 {
   "id": 5035,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 29,
   "firman": "Dan baru di sana engkau mencari TUHAN, Allahmu, dan menemukan-Nya, asal engkau menanyakan Dia dengan segenap hatimu dan dengan segenap jiwamu."
 },
 {
   "id": 5036,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 30,
   "firman": "Apabila engkau dalam keadaan terdesak dan segala hal ini menimpa engkau di kemudian hari, maka engkau akan kembali kepada TUHAN, Allahmu, dan mendengarkan suara-Nya."
 },
 {
   "id": 5037,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 31,
   "firman": "Sebab TUHAN, Allahmu, adalah Allah Penyayang, Ia tidak akan meninggalkan atau memusnahkan engkau dan Ia tidak akan melupakan perjanjian yang diikrarkan-Nya dengan sumpah kepada nenek moyangmu."
 },
 {
   "id": 5038,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 32,
   "firman": "Sebab cobalah tanyakan, dari ujung langit ke ujung langit, tentang zaman dahulu, yang ada sebelum engkau, sejak waktu Allah menciptakan manusia di atas bumi, apakah ada pernah terjadi sesuatu hal yang demikian besar atau apakah ada pernah terdengar sesuatu seperti itu."
 },
 {
   "id": 5039,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 33,
   "firman": "Pernahkah suatu bangsa mendengar suara ilahi, yang berbicara dari tengah-tengah api, seperti yang kaudengar dan tetap hidup?"
 },
 {
   "id": 5040,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 34,
   "firman": "Atau pernahkah suatu allah mencoba datang untuk mengambil baginya suatu bangsa dari tengah-tengah bangsa yang lain, dengan cobaan-cobaan, tanda-tanda serta mujizat-mujizat dan peperangan, dengan tangan yang kuat dan lengan yang teracung dan dengan kedahsyatan-kedahsyatan yang besar, seperti yang dilakukan TUHAN, Allahmu, bagimu di Mesir, di depan matamu?"
 },
 {
   "id": 5041,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 35,
   "firman": "Engkau diberi melihatnya untuk mengetahui, bahwa Tuhanlah Allah, tidak ada yang lain kecuali Dia."
 },
 {
   "id": 5042,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 36,
   "firman": "Dari langit Ia membiarkan engkau mendengar suara-Nya untuk mengajari engkau, di bumi Ia membiarkan engkau melihat api-Nya yang besar, dan segala perkataan-Nya kaudengar dari tengah-tengah api."
 },
 {
   "id": 5043,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 37,
   "firman": "Karena Ia mengasihi nenek moyangmu dan memilih keturunan mereka, maka Ia sendiri telah membawa engkau keluar dari Mesir dengan kekuatan-Nya yang besar,"
 },
 {
   "id": 5044,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 38,
   "firman": "untuk menghalau dari hadapanmu bangsa-bangsa yang lebih besar dan lebih kuat dari padamu, untuk membawa engkau masuk ke dalam negeri mereka dan memberikannya kepadamu menjadi milik pusakamu, seperti yang terjadi sekarang ini."
 },
 {
   "id": 5045,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 39,
   "firman": "Sebab itu ketahuilah pada hari ini dan camkanlah, bahwa Tuhanlah Allah yang di langit di atas dan di bumi di bawah, tidak ada yang lain."
 },
 {
   "id": 5046,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 40,
   "firman": "Berpeganglah pada ketetapan dan perintah-Nya yang kusampaikan kepadamu pada hari ini, supaya baik keadaanmu dan keadaan anak-anakmu yang kemudian, dan supaya lanjut umurmu di tanah yang diberikan TUHAN, Allahmu, kepadamu untuk selamanya.\""
 },
 {
   "id": 5047,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 41,
   "firman": "Lalu Musa mengkhususkan tiga kota di seberang sungai Yordan, di sebelah timur,"
 },
 {
   "id": 5048,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 42,
   "firman": "supaya orang yang membunuh sesamanya manusia dengan tidak sengaja dan dengan tidak memusuhinya lebih dahulu, dapat melarikan diri ke sana, sehingga ia, apabila melarikan diri ke salah satu kota itu, dapat tetap hidup."
 },
 {
   "id": 5049,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 43,
   "firman": "Kota-kota itu adalah: Bezer di padang gurun, di daerah dataran tinggi, untuk orang Ruben; Ramot di Gilead untuk orang Gad dan Golan di Basan untuk orang Manasye."
 },
 {
   "id": 5050,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 44,
   "firman": "Inilah hukum Taurat yang dipaparkan Musa kepada orang Israel."
 },
 {
   "id": 5051,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 45,
   "firman": "Inilah peringatan, ketetapan dan peraturan, yang dikatakan Musa kepada orang Israel, dalam perjalanan mereka keluar dari Mesir,"
 },
 {
   "id": 5052,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 46,
   "firman": "di seberang sungai Yordan, di lembah di tentangan Bet-Peor, di negeri Sihon, raja orang Amori, yang diam di Hesybon, yang dipukul kalah oleh Musa dan orang Israel dalam perjalanan mereka keluar dari Mesir."
 },
 {
   "id": 5053,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 47,
   "firman": "Negerinya diduduki mereka, dan juga negeri Og, raja negeri Basan: kedua-duanya raja orang Amori, yang diam di seberang sungai Yordan, di sebelah timur,"
 },
 {
   "id": 5054,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 48,
   "firman": "mulai dari Aroer, di tepi sungai Arnon, sampai gunung Siryon--itulah gunung Hermon--"
 },
 {
   "id": 5055,
   "kitab": "Ula",
   "pasal": 4,
   "ayat": 49,
   "firman": "serta seluruh dataran di seberang sungai Yordan, di sebelah timur, sampai Laut Araba, di kaki lereng gunung Pisga."
 },
 {
   "id": 5056,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 1,
   "firman": "Musa memanggil seluruh orang Israel berkumpul dan berkata kepada mereka: \"Dengarlah, hai orang Israel, ketetapan dan peraturan, yang pada hari ini kuperdengarkan kepadamu, supaya kamu mempelajarinya dan melakukannya dengan setia."
 },
 {
   "id": 5057,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 2,
   "firman": "TUHAN, Allah kita, telah mengikat perjanjian dengan kita di Horeb."
 },
 {
   "id": 5058,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 3,
   "firman": "Bukan dengan nenek moyang kita TUHAN mengikat perjanjian itu, tetapi dengan kita, kita yang ada di sini pada hari ini, kita semuanya yang masih hidup."
 },
 {
   "id": 5059,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 4,
   "firman": "TUHAN telah bicara dengan berhadapan muka dengan kamu di gunung dan di tengah-tengah api--"
 },
 {
   "id": 5060,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 5,
   "firman": "aku pada waktu itu berdiri antara TUHAN dan kamu untuk memberitahukan firman TUHAN kepadamu, sebab kamu takut kepada api dan kamu tidak naik ke gunung--dan Ia berfirman:"
 },
 {
   "id": 5061,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 6,
   "firman": "Akulah TUHAN, Allahmu, yang membawa engkau keluar dari tanah Mesir, dari tempat perbudakan."
 },
 {
   "id": 5062,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 7,
   "firman": "Jangan ada padamu allah lain di hadapan-Ku."
 },
 {
   "id": 5063,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 8,
   "firman": "Jangan membuat bagimu patung yang menyerupai apapun yang ada di langit di atas, atau yang ada di bumi di bawah, atau yang ada di dalam air di bawah bumi."
 },
 {
   "id": 5064,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 9,
   "firman": "Jangan sujud menyembah kepadanya atau beribadah kepadanya, sebab Aku, TUHAN Allahmu, adalah Allah yang cemburu, yang membalaskan kesalahan bapa kepada anak-anaknya dan kepada keturunan yang ketiga dan keempat dari orang-orang yang membenci Aku,"
 },
 {
   "id": 5065,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 10,
   "firman": "tetapi Aku menunjukkan kasih setia kepada beribu-ribu orang, yaitu mereka yang mengasihi Aku dan yang berpegang pada perintah-perintah-Ku."
 },
 {
   "id": 5066,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 11,
   "firman": "Jangan menyebut nama TUHAN, Allahmu, dengan sembarangan, sebab TUHAN akan memandang bersalah orang yang menyebut nama-Nya dengan sembarangan."
 },
 {
   "id": 5067,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 12,
   "firman": "Tetaplah ingat dan kuduskanlah hari Sabat, seperti yang diperintahkan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5068,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 13,
   "firman": "Enam hari lamanya engkau akan bekerja dan melakukan segala pekerjaanmu,"
 },
 {
   "id": 5069,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 14,
   "firman": "tetapi hari ketujuh adalah hari Sabat TUHAN, Allahmu; maka jangan melakukan sesuatu pekerjaan, engkau atau anakmu laki-laki, atau anakmu perempuan, atau hambamu laki-laki, atau hambamu perempuan, atau lembumu, atau keledaimu, atau hewanmu yang manapun, atau orang asing yang di tempat kediamanmu, supaya hambamu laki-laki dan hambamu perempuan berhenti seperti engkau juga."
 },
 {
   "id": 5070,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 15,
   "firman": "Sebab haruslah kauingat, bahwa engkaupun dahulu budak di tanah Mesir dan engkau dibawa keluar dari sana oleh TUHAN, Allahmu dengan tangan yang kuat dan lengan yang teracung; itulah sebabnya TUHAN, Allahmu, memerintahkan engkau merayakan hari Sabat."
 },
 {
   "id": 5071,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 16,
   "firman": "Hormatilah ayahmu dan ibumu, seperti yang diperintahkan kepadamu oleh TUHAN, Allahmu, supaya lanjut umurmu dan baik keadaanmu di tanah yang diberikan TUHAN, Allahmu, kepadamu."
 },
 {
   "id": 5072,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 17,
   "firman": "Jangan membunuh."
 },
 {
   "id": 5073,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 18,
   "firman": "Jangan berzinah."
 },
 {
   "id": 5074,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 19,
   "firman": "Jangan mencuri."
 },
 {
   "id": 5075,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 20,
   "firman": "Jangan mengucapkan saksi dusta tentang sesamamu."
 },
 {
   "id": 5076,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 21,
   "firman": "Jangan mengingini isteri sesamamu, dan jangan menghasratkan rumahnya, atau ladangnya, atau hambanya laki-laki, atau hambanya perempuan, atau lembunya, atau keledainya, atau apapun yang dipunyai sesamamu."
 },
 {
   "id": 5077,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 22,
   "firman": "Firman itulah yang diucapkan TUHAN kepada seluruh jemaahmu dengan suara nyaring di gunung, dari tengah-tengah api, awan dan kegelapan, dan tidak ditambahkan-Nya apa-apa lagi. Ditulis-Nya semuanya pada dua loh batu, lalu diberikan-Nya kepadaku.\""
 },
 {
   "id": 5078,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 23,
   "firman": "\"Ketika kamu mendengar suara itu dari tengah-tengah gelap gulita, sementara gunung itu menyala, maka kamu, yakni semua kepala sukumu dan para tua-tuamu, mendekati aku,"
 },
 {
   "id": 5079,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 24,
   "firman": "dan berkata: Sesungguhnya, TUHAN, Allah kita, telah memperlihatkan kepada kita kemuliaan dan kebesaran-Nya, dan suara-Nya telah kita dengar dari tengah-tengah api. Pada hari ini telah kami lihat, bahwa Allah berbicara dengan manusia dan manusia itu tetap hidup."
 },
 {
   "id": 5080,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 25,
   "firman": "Tetapi sekarang, mengapa kami harus mati? Sebab api yang besar ini akan menghanguskan kami. Apabila kami lebih lama lagi mendengar suara TUHAN, Allah kita, kami akan mati."
 },
 {
   "id": 5081,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 26,
   "firman": "Sebab makhluk manakah yang telah mendengar suara dari Allah yang hidup yang berbicara dari tengah-tengah api, seperti kami dan tetap hidup?"
 },
 {
   "id": 5082,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 27,
   "firman": "Mendekatlah engkau dan dengarkanlah segala yang difirmankan TUHAN, Allah kita, dan engkaulah yang mengatakan kepada kami segala yang difirmankan kepadamu oleh TUHAN, Allah kita, maka kami akan mendengar dan melakukannya."
 },
 {
   "id": 5083,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 28,
   "firman": "Ketika TUHAN mendengar perkataanmu itu, sedang kamu mengatakannya kepadaku, maka berfirmanlah TUHAN kepadaku: Telah Kudengar perkataan bangsa ini yang dikatakan mereka kepadamu. Segala yang dikatakan mereka itu baik."
 },
 {
   "id": 5084,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 29,
   "firman": "Kiranya hati mereka selalu begitu, yakni takut akan Daku dan berpegang pada segala perintah-Ku, supaya baik keadaan mereka dan anak-anak mereka untuk selama-lamanya!"
 },
 {
   "id": 5085,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 30,
   "firman": "Pergilah, katakanlah kepada mereka: Kembalilah ke kemahmu."
 },
 {
   "id": 5086,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 31,
   "firman": "Tetapi engkau, berdirilah di sini bersama-sama dengan Aku, maka Aku hendak mengatakan kepadamu segenap perintah, yakni ketetapan dan peraturan, yang harus kauajarkan kepada mereka, supaya mereka melakukannya di negeri yang Kuberikan kepada mereka untuk dimiliki."
 },
 {
   "id": 5087,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 32,
   "firman": "Maka lakukanlah semuanya itu dengan setia, seperti yang diperintahkan kepadamu oleh TUHAN, Allahmu. Janganlah menyimpang ke kanan atau ke kiri."
 },
 {
   "id": 5088,
   "kitab": "Ula",
   "pasal": 5,
   "ayat": 33,
   "firman": "Segenap jalan, yang diperintahkan kepadamu oleh TUHAN, Allahmu, haruslah kamu jalani, supaya kamu hidup, dan baik keadaanmu serta lanjut umurmu di negeri yang akan kamu duduki.\""
 },
 {
   "id": 5089,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 1,
   "firman": "\"Inilah perintah, yakni ketetapan dan peraturan, yang aku ajarkan kepadamu atas perintah TUHAN, Allahmu, untuk dilakukan di negeri, ke mana kamu pergi untuk mendudukinya,"
 },
 {
   "id": 5090,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 2,
   "firman": "supaya seumur hidupmu engkau dan anak cucumu takut akan TUHAN, Allahmu, dan berpegang pada segala ketetapan dan perintah-Nya yang kusampaikan kepadamu, dan supaya lanjut umurmu."
 },
 {
   "id": 5091,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 3,
   "firman": "Maka dengarlah, hai orang Israel! Lakukanlah itu dengan setia, supaya baik keadaanmu, dan supaya kamu menjadi sangat banyak, seperti yang dijanjikan TUHAN, Allah nenek moyangmu, kepadamu di suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 5092,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dengarlah, hai orang Israel: TUHAN itu Allah kita, TUHAN itu esa!"
 },
 {
   "id": 5093,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 5,
   "firman": "Kasihilah TUHAN, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu dan dengan segenap kekuatanmu."
 },
 {
   "id": 5094,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 6,
   "firman": "Apa yang kuperintahkan kepadamu pada hari ini haruslah engkau perhatikan,"
 },
 {
   "id": 5095,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 7,
   "firman": "haruslah engkau mengajarkannya berulang-ulang kepada anak-anakmu dan membicarakannya apabila engkau duduk di rumahmu, apabila engkau sedang dalam perjalanan, apabila engkau berbaring dan apabila engkau bangun."
 },
 {
   "id": 5096,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 8,
   "firman": "Haruslah juga engkau mengikatkannya sebagai tanda pada tanganmu dan haruslah itu menjadi lambang di dahimu,"
 },
 {
   "id": 5097,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 9,
   "firman": "dan haruslah engkau menuliskannya pada tiang pintu rumahmu dan pada pintu gerbangmu."
 },
 {
   "id": 5098,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 10,
   "firman": "Maka apabila TUHAN, Allahmu, telah membawa engkau masuk ke negeri yang dijanjikan-Nya dengan sumpah kepada nenek moyangmu, yakni Abraham, Ishak dan Yakub, untuk memberikannya kepadamu--kota-kota yang besar dan baik, yang tidak kaudirikan;"
 },
 {
   "id": 5099,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 11,
   "firman": "rumah-rumah, penuh berisi berbagai-bagai barang baik, yang tidak kauisi; sumur-sumur yang tidak kaugali; kebun-kebun anggur dan kebun-kebun zaitun, yang tidak kautanami--dan apabila engkau sudah makan dan menjadi kenyang,"
 },
 {
   "id": 5100,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 12,
   "firman": "maka berhati-hatilah, supaya jangan engkau melupakan TUHAN, yang telah membawa kamu keluar dari tanah Mesir, dari rumah perbudakan."
 },
 {
   "id": 5101,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 13,
   "firman": "Engkau harus takut akan TUHAN, Allahmu; kepada Dia haruslah engkau beribadah dan demi nama-Nya haruslah engkau bersumpah."
 },
 {
   "id": 5102,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 14,
   "firman": "Janganlah kamu mengikuti allah lain, dari antara allah bangsa-bangsa sekelilingmu,"
 },
 {
   "id": 5103,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 15,
   "firman": "sebab TUHAN, Allahmu, adalah Allah yang cemburu di tengah-tengahmu, supaya jangan bangkit murka TUHAN, Allahmu, terhadap engkau, sehingga Ia memunahkan engkau dari muka bumi."
 },
 {
   "id": 5104,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 16,
   "firman": "Janganlah kamu mencobai TUHAN, Allahmu, seperti kamu mencobai Dia di Masa."
 },
 {
   "id": 5105,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 17,
   "firman": "Haruslah kamu berpegang pada perintah, peringatan dan ketetapan TUHAN, Allahmu, yang diperintahkan-Nya kepadamu;"
 },
 {
   "id": 5106,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 18,
   "firman": "haruslah engkau melakukan apa yang benar dan baik di mata TUHAN, supaya baik keadaanmu dan engkau memasuki dan menduduki negeri yang baik, yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu,"
 },
 {
   "id": 5107,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 19,
   "firman": "dengan mengusir semua musuhmu dari hadapanmu, seperti yang difirmankan TUHAN."
 },
 {
   "id": 5108,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 20,
   "firman": "Apabila di kemudian hari anakmu bertanya kepadamu: Apakah peringatan, ketetapan dan peraturan itu, yang diperintahkan kepadamu oleh TUHAN Allah kita?"
 },
 {
   "id": 5109,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 21,
   "firman": "maka haruslah engkau menjawab anakmu itu: Kita dahulu adalah budak Firaun di Mesir, tetapi TUHAN membawa kita keluar dari Mesir dengan tangan yang kuat."
 },
 {
   "id": 5110,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 22,
   "firman": "TUHAN membuat tanda-tanda dan mujizat-mujizat, yang besar dan yang mencelakakan, terhadap Mesir, terhadap Firaun dan seisi rumahnya, di depan mata kita;"
 },
 {
   "id": 5111,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 23,
   "firman": "tetapi kita dibawa-Nya keluar dari sana, supaya kita dapat dibawa-Nya masuk untuk memberikan kepada kita negeri yang telah dijanjikan-Nya dengan sumpah kepada nenek moyang kita."
 },
 {
   "id": 5112,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 24,
   "firman": "TUHAN, Allah kita, memerintahkan kepada kita untuk melakukan segala ketetapan itu dan untuk takut akan TUHAN, Allah kita, supaya senantiasa baik keadaan kita dan supaya Ia membiarkan kita hidup, seperti sekarang ini."
 },
 {
   "id": 5113,
   "kitab": "Ula",
   "pasal": 6,
   "ayat": 25,
   "firman": "Dan kita akan menjadi benar, apabila kita melakukan segenap perintah itu dengan setia di hadapan TUHAN, Allah kita, seperti yang diperintahkan-Nya kepada kita.\""
 },
 {
   "id": 5114,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 1,
   "firman": "\"Apabila TUHAN, Allahmu, telah membawa engkau ke dalam negeri, ke mana engkau masuk untuk mendudukinya, dan Ia telah menghalau banyak bangsa dari depanmu, yakni orang Het, orang Girgasi, orang Amori, orang Kanaan, orang Feris, orang Hewi dan orang Yebus, tujuh bangsa, yang lebih banyak dan lebih kuat dari padamu,"
 },
 {
   "id": 5115,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 2,
   "firman": "dan TUHAN, Allahmu, telah menyerahkan mereka kepadamu, sehingga engkau memukul mereka kalah, maka haruslah kamu menumpas mereka sama sekali. Janganlah engkau mengadakan perjanjian dengan mereka dan janganlah engkau mengasihani mereka."
 },
 {
   "id": 5116,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 3,
   "firman": "Janganlah juga engkau kawin-mengawin dengan mereka: anakmu perempuan janganlah kauberikan kepada anak laki-laki mereka, ataupun anak perempuan mereka jangan kauambil bagi anakmu laki-laki;"
 },
 {
   "id": 5117,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 4,
   "firman": "sebab mereka akan membuat anakmu laki-laki menyimpang dari pada-Ku, sehingga mereka beribadah kepada allah lain. Maka murka TUHAN akan bangkit terhadap kamu dan Ia akan memunahkan engkau dengan segera."
 },
 {
   "id": 5118,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 5,
   "firman": "Tetapi beginilah kamu lakukan terhadap mereka: mezbah-mezbah mereka haruslah kamu robohkan, tugu-tugu berhala mereka kamu remukkan, tiang-tiang berhala mereka kamu hancurkan dan patung-patung mereka kamu bakar habis."
 },
 {
   "id": 5119,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 6,
   "firman": "Sebab engkaulah umat yang kudus bagi TUHAN, Allahmu; engkaulah yang dipilih oleh TUHAN, Allahmu, dari segala bangsa di atas muka bumi untuk menjadi umat kesayangan-Nya."
 },
 {
   "id": 5120,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 7,
   "firman": "Bukan karena lebih banyak jumlahmu dari bangsa manapun juga, maka hati TUHAN terpikat olehmu dan memilih kamu--bukankah kamu ini yang paling kecil dari segala bangsa? --"
 },
 {
   "id": 5121,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 8,
   "firman": "tetapi karena TUHAN mengasihi kamu dan memegang sumpah-Nya yang telah diikrarkan-Nya kepada nenek moyangmu, maka TUHAN telah membawa kamu keluar dengan tangan yang kuat dan menebus engkau dari rumah perbudakan, dari tangan Firaun, raja Mesir."
 },
 {
   "id": 5122,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 9,
   "firman": "Sebab itu haruslah kauketahui, bahwa TUHAN, Allahmu, Dialah Allah, Allah yang setia, yang memegang perjanjian dan kasih setia-Nya terhadap orang yang kasih kepada-Nya dan berpegang pada perintah-Nya, sampai kepada beribu-ribu keturunan,"
 },
 {
   "id": 5123,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 10,
   "firman": "tetapi terhadap diri setiap orang dari mereka yang membenci Dia, Ia melakukan pembalasan dengan membinasakan orang itu. Ia tidak bertangguh terhadap orang yang membenci Dia. Ia langsung mengadakan pembalasan terhadap orang itu."
 },
 {
   "id": 5124,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 11,
   "firman": "Jadi berpeganglah pada perintah, yakni ketetapan dan peraturan yang kusampaikan kepadamu pada hari ini untuk dilakukan.\""
 },
 {
   "id": 5125,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 12,
   "firman": "\"Dan akan terjadi, karena kamu mendengarkan peraturan-peraturan itu serta melakukannya dengan setia, maka terhadap engkau TUHAN, Allahmu, akan memegang perjanjian dan kasih setia-Nya yang diikrarkan-Nya dengan sumpah kepada nenek moyangmu."
 },
 {
   "id": 5126,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 13,
   "firman": "Ia akan mengasihi engkau, memberkati engkau dan membuat engkau banyak; Ia akan memberkati buah kandunganmu dan hasil bumimu, gandum dan anggur serta minyakmu, anak lembu sapimu dan anak kambing dombamu, di tanah yang dijanjikan-Nya dengan sumpah kepada nenek moyangmu untuk memberikannya kepadamu."
 },
 {
   "id": 5127,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 14,
   "firman": "Engkau akan diberkati lebih dari pada segala bangsa: tidak akan ada laki-laki atau perempuan yang mandul di antaramu, ataupun di antara hewanmu."
 },
 {
   "id": 5128,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 15,
   "firman": "TUHAN akan menjauhkan segala penyakit dari padamu, dan tidak ada satu dari wabah celaka yang kaukenal di Mesir itu akan ditimpakan-Nya kepadamu, tetapi Ia akan mendatangkannya kepada semua orang yang membenci engkau."
 },
 {
   "id": 5129,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 16,
   "firman": "Engkau harus melenyapkan segala bangsa yang diserahkan kepadamu oleh TUHAN, Allahmu; janganlah engkau merasa sayang kepada mereka dan janganlah beribadah kepada allah mereka, sebab hal itu akan menjadi jerat bagimu."
 },
 {
   "id": 5130,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 17,
   "firman": "Jika sekiranya engkau berkata dalam hatimu: Bangsa-bangsa ini lebih banyak dari padaku, bagaimanakah aku dapat menghalaukan mereka?"
 },
 {
   "id": 5131,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 18,
   "firman": "maka janganlah engkau takut kepada mereka; ingatlah selalu apa yang dilakukan TUHAN, Allahmu, terhadap Firaun dan seluruh Mesir,"
 },
 {
   "id": 5132,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 19,
   "firman": "yakni cobaan-cobaan besar, yang kaulihat dengan matamu sendiri, tanda-tanda dan mujizat-mujizat, tangan yang kuat dan lengan yang teracung, yang dipakai TUHAN, Allahmu, untuk membawa engkau keluar. Demikianlah juga akan dilakukan TUHAN, Allahmu, terhadap segala bangsa yang engkau takuti."
 },
 {
   "id": 5133,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 20,
   "firman": "Lagipula TUHAN, Allahmu, akan melepaskan tabuhan menyerbu mereka, sampai habis binasa orang-orang yang masih tinggal dan yang menyembunyikan diri terhadap engkau."
 },
 {
   "id": 5134,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 21,
   "firman": "Janganlah gemetar karena mereka, sebab TUHAN, Allahmu, ada di tengah-tengahmu, Allah yang besar dan dahsyat."
 },
 {
   "id": 5135,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 22,
   "firman": "TUHAN, Allahmu, akan menghalau bangsa-bangsa ini dari hadapanmu sedikit demi sedikit; engkau tidak boleh membinasakan mereka dengan segera, supaya jangan binatang hutan menjadi terlalu banyak melebihi engkau."
 },
 {
   "id": 5136,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 23,
   "firman": "Demikianlah TUHAN, Allahmu, akan menyerahkan mereka kepadamu dan akan mengacaukan mereka sama sekali, sampai mereka punah."
 },
 {
   "id": 5137,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 24,
   "firman": "Raja-raja mereka akan diserahkan-Nya ke dalam tanganmu, sehingga engkau menghapuskan nama mereka dari kolong langit; tidak akan ada yang dapat bertahan menghadapi engkau, sampai engkau memunahkan mereka."
 },
 {
   "id": 5138,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 25,
   "firman": "Patung-patung allah mereka haruslah kamu bakar habis; perak dan emas yang ada pada mereka janganlah kauingini dan kauambil bagi dirimu sendiri, supaya jangan engkau terjerat karenanya, sebab hal itu adalah kekejian bagi TUHAN, Allahmu."
 },
 {
   "id": 5139,
   "kitab": "Ula",
   "pasal": 7,
   "ayat": 26,
   "firman": "Dan janganlah engkau membawa sesuatu kekejian masuk ke dalam rumahmu, sehingga engkaupun ditumpas seperti itu; haruslah engkau benar-benar merasa jijik dan keji terhadap hal itu, sebab semuanya itu dikhususkan untuk dimusnahkan.\""
 },
 {
   "id": 5140,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 1,
   "firman": "\"Segenap perintah, yang kusampaikan kepadamu pada hari ini, haruslah kamu lakukan dengan setia, supaya kamu hidup dan bertambah banyak dan kamu memasuki serta menduduki negeri yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu."
 },
 {
   "id": 5141,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 2,
   "firman": "Ingatlah kepada seluruh perjalanan yang kaulakukan atas kehendak TUHAN, Allahmu, di padang gurun selama empat puluh tahun ini dengan maksud merendahkan hatimu dan mencobai engkau untuk mengetahui apa yang ada dalam hatimu, yakni, apakah engkau berpegang pada perintah-Nya atau tidak."
 },
 {
   "id": 5142,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 3,
   "firman": "Jadi Ia merendahkan hatimu, membiarkan engkau lapar dan memberi engkau makan manna, yang tidak kaukenal dan yang juga tidak dikenal oleh nenek moyangmu, untuk membuat engkau mengerti, bahwa manusia hidup bukan dari roti saja, tetapi manusia hidup dari segala yang diucapkan TUHAN."
 },
 {
   "id": 5143,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 4,
   "firman": "Pakaianmu tidaklah menjadi buruk di tubuhmu dan kakimu tidaklah menjadi bengkak selama empat puluh tahun ini."
 },
 {
   "id": 5144,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 5,
   "firman": "Maka haruslah engkau insaf, bahwa TUHAN, Allahmu, mengajari engkau seperti seseorang mengajari anaknya."
 },
 {
   "id": 5145,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 6,
   "firman": "Oleh sebab itu haruslah engkau berpegang pada perintah TUHAN, Allahmu, dengan hidup menurut jalan yang ditunjukkan-Nya dan dengan takut akan Dia."
 },
 {
   "id": 5146,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebab TUHAN, Allahmu, membawa engkau masuk ke dalam negeri yang baik, suatu negeri dengan sungai, mata air dan danau, yang keluar dari lembah-lembah dan gunung-gunung;"
 },
 {
   "id": 5147,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 8,
   "firman": "suatu negeri dengan gandum dan jelainya, dengan pohon anggur, pohon ara dan pohon delimanya; suatu negeri dengan pohon zaitun dan madunya;"
 },
 {
   "id": 5148,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 9,
   "firman": "suatu negeri, di mana engkau akan makan roti dengan tidak usah berhemat, di mana engkau tidak akan kekurangan apapun; suatu negeri, yang batunya mengandung besi dan dari gunungnya akan kaugali tembaga."
 },
 {
   "id": 5149,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 10,
   "firman": "Dan engkau akan makan dan akan kenyang, maka engkau akan memuji TUHAN, Allahmu, karena negeri yang baik yang diberikan-Nya kepadamu itu."
 },
 {
   "id": 5150,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 11,
   "firman": "Hati-hatilah, supaya jangan engkau melupakan TUHAN, Allahmu, dengan tidak berpegang pada perintah, peraturan dan ketetapan-Nya, yang kusampaikan kepadamu pada hari ini;"
 },
 {
   "id": 5151,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 12,
   "firman": "dan supaya, apabila engkau sudah makan dan kenyang, mendirikan rumah-rumah yang baik serta mendiaminya,"
 },
 {
   "id": 5152,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 13,
   "firman": "dan apabila lembu sapimu dan kambing dombamu bertambah banyak dan emas serta perakmu bertambah banyak, dan segala yang ada padamu bertambah banyak,"
 },
 {
   "id": 5153,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 14,
   "firman": "jangan engkau tinggi hati, sehingga engkau melupakan TUHAN, Allahmu, yang membawa engkau keluar dari tanah Mesir, dari rumah perbudakan,"
 },
 {
   "id": 5154,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 15,
   "firman": "dan yang memimpin engkau melalui padang gurun yang besar dan dahsyat itu, dengan ular-ular yang ganas serta kalajengkingnya dan tanahnya yang gersang, yang tidak ada air. Dia yang membuat air keluar bagimu dari gunung batu yang keras,"
 },
 {
   "id": 5155,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 16,
   "firman": "dan yang di padang gurun memberi engkau makan manna, yang tidak dikenal oleh nenek moyangmu, supaya direndahkan-Nya hatimu dan dicobai-Nya engkau, hanya untuk berbuat baik kepadamu akhirnya."
 },
 {
   "id": 5156,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 17,
   "firman": "Maka janganlah kaukatakan dalam hatimu: Kekuasaanku dan kekuatan tangankulah yang membuat aku memperoleh kekayaan ini."
 },
 {
   "id": 5157,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 18,
   "firman": "Tetapi haruslah engkau ingat kepada TUHAN, Allahmu, sebab Dialah yang memberikan kepadamu kekuatan untuk memperoleh kekayaan, dengan maksud meneguhkan perjanjian yang diikrarkan-Nya dengan sumpah kepada nenek moyangmu, seperti sekarang ini."
 },
 {
   "id": 5158,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 19,
   "firman": "Tetapi jika engkau sama sekali melupakan TUHAN, Allahmu, dan mengikuti allah lain, beribadah kepadanya dan sujud menyembah kepadanya, aku memperingatkan kepadamu hari ini, bahwa kamu pasti binasa;"
 },
 {
   "id": 5159,
   "kitab": "Ula",
   "pasal": 8,
   "ayat": 20,
   "firman": "seperti bangsa-bangsa, yang dibinasakan TUHAN di hadapanmu, kamupun akan binasa, sebab kamu tidak mau mendengarkan suara TUHAN, Allahmu.\""
 },
 {
   "id": 5160,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 1,
   "firman": "\"Dengarlah, hai orang Israel! Engkau akan menyeberangi sungai Yordan pada hari ini untuk memasuki serta menduduki daerah bangsa-bangsa yang lebih besar dan lebih kuat dari padamu, yakni kota-kota besar yang kubu-kubunya sampai ke langit--"
 },
 {
   "id": 5161,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 2,
   "firman": "suatu bangsa yang besar dan tinggi, orang Enak, yang kaukenal dan yang tentangnya kaudengar orang berkata: Siapakah yang dapat bertahan menghadapi orang Enak?"
 },
 {
   "id": 5162,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 3,
   "firman": "Maka ketahuilah pada hari ini, bahwa TUHAN, Allahmu, Dialah yang berjalan di depanmu laksana api yang menghanguskan; Dia akan memunahkan mereka dan Dia akan menundukkan mereka di hadapanmu. Demikianlah engkau akan menghalau dan membinasakan mereka dengan segera, seperti yang dijanjikan kepadamu oleh TUHAN."
 },
 {
   "id": 5163,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 4,
   "firman": "Janganlah engkau berkata dalam hatimu, apabila TUHAN, Allahmu, telah mengusir mereka dari hadapanmu: Karena jasa-jasakulah TUHAN membawa aku masuk menduduki negeri ini; padahal karena kefasikan bangsa-bangsa itulah TUHAN menghalau mereka dari hadapanmu."
 },
 {
   "id": 5164,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 5,
   "firman": "Bukan karena jasa-jasamu atau karena kebenaran hatimu engkau masuk menduduki negeri mereka, tetapi karena kefasikan bangsa-bangsa itulah, TUHAN, Allahmu, menghalau mereka dari hadapanmu, dan supaya TUHAN menepati janji yang diikrarkan-Nya dengan sumpah kepada nenek moyangmu, yakni Abraham, Ishak dan Yakub."
 },
 {
   "id": 5165,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 6,
   "firman": "Jadi ketahuilah, bahwa bukan karena jasa-jasamu TUHAN, Allahmu, memberikan kepadamu negeri yang baik itu untuk diduduki. Sesungguhnya engkau bangsa yang tegar tengkuk!\""
 },
 {
   "id": 5166,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 7,
   "firman": "\"Ingatlah, janganlah lupa, bahwa engkau sudah membuat TUHAN, Allahmu, gusar di padang gurun. Sejak engkau keluar dari tanah Mesir sampai kamu tiba di tempat ini, kamu menentang TUHAN."
 },
 {
   "id": 5167,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 8,
   "firman": "Di Horeb kamu sudah membuat TUHAN gusar, bahkan TUHAN begitu murka kepadamu, hingga Ia mau memunahkan kamu."
 },
 {
   "id": 5168,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 9,
   "firman": "Setelah aku mendaki gunung untuk menerima loh-loh batu, loh-loh perjanjian yang diikat TUHAN dengan kamu, maka aku tinggal empat puluh hari empat puluh malam lamanya di gunung itu; roti tidak kumakan dan air tidak kuminum."
 },
 {
   "id": 5169,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 10,
   "firman": "TUHAN memberikan kepadaku kedua loh batu, yang ditulisi jari Allah, di mana ada segala firman yang diucapkan TUHAN kepadamu di gunung itu dari tengah-tengah api, pada hari perkumpulan."
 },
 {
   "id": 5170,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 11,
   "firman": "Sesudah lewat empat puluh hari empat puluh malam itu, maka TUHAN memberikan kepadaku kedua loh batu, loh-loh perjanjian itu."
 },
 {
   "id": 5171,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 12,
   "firman": "Lalu berfirmanlah TUHAN kepadaku: Bangunlah, turunlah dengan segera dari sini, sebab bangsamu, yang kaubawa keluar dari Mesir, telah berlaku busuk; mereka segera menyimpang dari jalan yang Kuperintahkan kepada mereka; mereka telah membuat patung tuangan."
 },
 {
   "id": 5172,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 13,
   "firman": "Lagi TUHAN berfirman kepadaku: Telah Kulihat bangsa ini dan sesungguhnya mereka adalah bangsa yang tegar tengkuk."
 },
 {
   "id": 5173,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 14,
   "firman": "Biarkanlah Aku, maka Aku akan memunahkan mereka dan menghapuskan nama mereka dari kolong langit; tetapi dari padamu akan Kubuat suatu bangsa yang lebih berkuasa dan lebih banyak dari pada bangsa ini."
 },
 {
   "id": 5174,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 15,
   "firman": "Setelah itu berpalinglah aku, lalu turun dari gunung yang sedang menyala itu dengan kedua loh perjanjian di kedua tanganku."
 },
 {
   "id": 5175,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 16,
   "firman": "Lalu aku menyaksikan, bahwa sesungguhnya kamu telah berbuat dosa terhadap TUHAN, Allahmu: kamu telah membuat suatu anak lembu tuangan, kamu telah segera menyimpang dari jalan yang diperintahkan TUHAN kepadamu."
 },
 {
   "id": 5176,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 17,
   "firman": "Maka kupeganglah kuat-kuat kedua loh itu, kulemparkan dari kedua tanganku, kupecahkan di depan matamu."
 },
 {
   "id": 5177,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 18,
   "firman": "Sesudah itu aku sujud di hadapan TUHAN, empat puluh hari empat puluh malam lamanya, seperti yang pertama kali--roti tidak kumakan dan air tidak kuminum--karena segala dosa yang telah kamu perbuat, yakni kamu melakukan apa yang jahat di mata TUHAN, sehingga kamu menimbulkan sakit hati-Nya."
 },
 {
   "id": 5178,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sebab aku gentar karena murka dan kepanasan amarah yang ditimpakan TUHAN kepadamu, sampai Ia mau memunahkan kamu. Tetapi sekali inipun TUHAN mendengarkan aku."
 },
 {
   "id": 5179,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 20,
   "firman": "Juga kepada Harun TUHAN begitu murka, hingga Ia mau membinasakannya; maka pada waktu itu aku berdoa untuk Harun juga."
 },
 {
   "id": 5180,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 21,
   "firman": "Tetapi hasil perbuatanmu yang berdosa, yakni anak lembu itu, kuambil, kubakar, kuhancurkan dan kugiling baik-baik sampai halus, menjadi abu, lalu abunya kulemparkan ke dalam sungai yang mengalir turun dari gunung."
 },
 {
   "id": 5181,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 22,
   "firman": "Juga di Tabera, di Masa dan di Kibrot-Taawa, kamu selalu membuat TUHAN gusar."
 },
 {
   "id": 5182,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 23,
   "firman": "Dan ketika TUHAN menyuruh kamu pergi dari Kadesh-Barnea dengan berfirman: Majulah dan dudukilah negeri yang Kuberikan kepadamu itu, maka kamu menentang titah TUHAN, Allahmu; kamu tidak percaya kepada-Nya dan tidak mendengarkan suara-Nya."
 },
 {
   "id": 5183,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 24,
   "firman": "Bahkan kamu menentang TUHAN, sejak aku mengenal kamu."
 },
 {
   "id": 5184,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 25,
   "firman": "Maka aku sujud di hadapan TUHAN--empat puluh hari empat puluh malam lamanya aku sujud--,karena TUHAN telah berfirman akan memunahkan kamu,"
 },
 {
   "id": 5185,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 26,
   "firman": "dan aku berdoa kepada TUHAN, kataku: Ya, Tuhan ALLAH, janganlah musnahkan umat milik-Mu sendiri, yang Kautebus dengan kebesaran-Mu, dan yang Kaubawa keluar dari Mesir dengan tangan yang kuat."
 },
 {
   "id": 5186,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 27,
   "firman": "Ingatlah kepada hamba-hamba-Mu, kepada Abraham, Ishak dan Yakub; janganlah perhatikan ketegaran bangsa ini ataupun kefasikannya dan dosanya,"
 },
 {
   "id": 5187,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 28,
   "firman": "supaya negeri, dari mana Engkau membawa kami keluar, jangan berkata: Sebab TUHAN tidak dapat membawa mereka masuk ke negeri yang dijanjikan-Nya kepada mereka, dan sebab benci-Nya kepada mereka, maka Ia membawa mereka keluar untuk membunuh mereka di padang gurun."
 },
 {
   "id": 5188,
   "kitab": "Ula",
   "pasal": 9,
   "ayat": 29,
   "firman": "Bukankah mereka itu umat milik-Mu sendiri, yang Kaubawa keluar dengan kekuatan-Mu yang besar dan dengan lengan-Mu yang teracung?\""
 },
 {
   "id": 5189,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 1,
   "firman": "\"Pada waktu itu berfirmanlah TUHAN kepadaku: Pahatlah dua loh batu yang serupa dengan yang mula-mula, naiklah kepada-Ku ke atas gunung, dan buatlah sebuah tabut dari kayu;"
 },
 {
   "id": 5190,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 2,
   "firman": "maka Aku akan menuliskan pada loh itu firman-firman yang ada pada loh yang mula-mula yang telah kaupecahkan itu, kemudian letakkanlah kedua loh ke dalam tabut itu."
 },
 {
   "id": 5191,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 3,
   "firman": "Maka aku membuat sebuah tabut dari kayu penaga dan memahat dua loh batu yang serupa dengan yang mula-mula; kemudian aku mendaki gunung dengan kedua loh itu di tanganku."
 },
 {
   "id": 5192,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 4,
   "firman": "Dan pada loh itu Ia menuliskan, sama dengan tulisan yang mula-mula, Kesepuluh Firman yang telah diucapkan TUHAN kepadamu di atas gunung dari tengah-tengah api pada hari kamu berkumpul; sesudah itu TUHAN memberikannya kepadaku."
 },
 {
   "id": 5193,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 5,
   "firman": "Lalu aku turun kembali dari atas gunung, dan aku meletakkan loh-loh itu ke dalam tabut yang telah kubuat; dan di situlah tempatnya, seperti yang diperintahkan TUHAN kepadaku."
 },
 {
   "id": 5194,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 6,
   "firman": "Maka orang Israel berangkat dari Beerot Bene-Yaakan ke Mosera; di sanalah Harun mati dan dikuburkan; lalu Eleazar, anaknya, menjadi imam menggantikan dia."
 },
 {
   "id": 5195,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 7,
   "firman": "Dari sana mereka berangkat ke Gudgod, dan dari Gudgod ke Yotbata, suatu daerah yang banyak sungainya."
 },
 {
   "id": 5196,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 8,
   "firman": "Pada waktu itu TUHAN menunjuk suku Lewi untuk mengangkut tabut perjanjian TUHAN, untuk bertugas melayani TUHAN dan untuk memberi berkat demi nama-Nya, sampai sekarang."
 },
 {
   "id": 5197,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sebab itu suku Lewi tidak mempunyai bagian milik pusaka bersama-sama dengan saudara-saudaranya; Tuhanlah milik pusakanya, seperti yang difirmankan kepadanya oleh TUHAN, Allahmu."
 },
 {
   "id": 5198,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 10,
   "firman": "Maka aku ini berdiri di atas gunung seperti yang pertama kali, empat puluh hari empat puluh malam lamanya, dan sekali inipun TUHAN mendengarkan aku: TUHAN tidak mau memusnahkan engkau."
 },
 {
   "id": 5199,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 11,
   "firman": "Lalu berfirmanlah TUHAN kepadaku: Bersiaplah, pergilah berjalan di depan bangsa itu, supaya mereka memasuki dan menduduki negeri yang Kujanjikan dengan sumpah kepada nenek moyang mereka untuk memberikannya kepada mereka.\""
 },
 {
   "id": 5200,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 12,
   "firman": "\"Maka sekarang, hai orang Israel, apakah yang dimintakan dari padamu oleh TUHAN, Allahmu, selain dari takut akan TUHAN, Allahmu, hidup menurut segala jalan yang ditunjukkan-Nya, mengasihi Dia, beribadah kepada TUHAN, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu,"
 },
 {
   "id": 5201,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 13,
   "firman": "berpegang pada perintah dan ketetapan TUHAN yang kusampaikan kepadamu pada hari ini, supaya baik keadaanmu."
 },
 {
   "id": 5202,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 14,
   "firman": "Sesungguhnya, TUHAN, Allahmulah yang empunya langit, bahkan langit yang mengatasi segala langit, dan bumi dengan segala isinya;"
 },
 {
   "id": 5203,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 15,
   "firman": "tetapi hanya oleh nenek moyangmulah hati TUHAN terpikat sehingga Ia mengasihi mereka, dan keturunan merekalah, yakni kamu, yang dipilih-Nya dari segala bangsa, seperti sekarang ini."
 },
 {
   "id": 5204,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 16,
   "firman": "Sebab itu sunatlah hatimu dan janganlah lagi kamu tegar tengkuk."
 },
 {
   "id": 5205,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 17,
   "firman": "Sebab TUHAN, Allahmulah Allah segala allah dan Tuhan segala tuhan, Allah yang besar, kuat dan dahsyat, yang tidak memandang bulu ataupun menerima suap;"
 },
 {
   "id": 5206,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 18,
   "firman": "yang membela hak anak yatim dan janda dan menunjukkan kasih-Nya kepada orang asing dengan memberikan kepadanya makanan dan pakaian."
 },
 {
   "id": 5207,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 19,
   "firman": "Sebab itu haruslah kamu menunjukkan kasihmu kepada orang asing, sebab kamupun dahulu adalah orang asing di tanah Mesir."
 },
 {
   "id": 5208,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 20,
   "firman": "Engkau harus takut akan TUHAN, Allahmu, kepada-Nya haruslah engkau beribadah dan berpaut, dan demi nama-Nya haruslah engkau bersumpah."
 },
 {
   "id": 5209,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 21,
   "firman": "Dialah pokok puji-pujianmu dan Dialah Allahmu, yang telah melakukan di antaramu perbuatan-perbuatan yang besar dan dahsyat, yang telah kaulihat dengan matamu sendiri."
 },
 {
   "id": 5210,
   "kitab": "Ula",
   "pasal": 10,
   "ayat": 22,
   "firman": "Dengan tujuh puluh orang nenek moyangmu pergi ke Mesir, tetapi sekarang ini TUHAN, Allahmu, telah membuat engkau banyak seperti bintang-bintang di langit.\""
 },
 {
   "id": 5211,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 1,
   "firman": "\"Haruslah engkau mengasihi TUHAN, Allahmu, dan melakukan dengan setia kewajibanmu terhadap Dia dengan senantiasa berpegang pada segala ketetapan-Nya, peraturan-Nya dan perintah-Nya."
 },
 {
   "id": 5212,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 2,
   "firman": "Kamu tahu sekarang--kukatakan bukan kepada anak-anakmu, yang tidak mengenal dan tidak melihat hajaran TUHAN, Allahmu--kebesaran-Nya, tangan-Nya yang kuat dan lengan-Nya yang teracung,"
 },
 {
   "id": 5213,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 3,
   "firman": "tanda-tanda dan perbuatan-perbuatan yang dilakukan-Nya di Mesir terhadap Firaun, raja Mesir, dan terhadap seluruh negerinya;"
 },
 {
   "id": 5214,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 4,
   "firman": "juga apa yang dilakukan-Nya terhadap pasukan Mesir, dengan kuda-kudanya dan kereta-keretanya, yakni bagaimana Ia membuat air Laut Teberau meluap meliputi mereka, ketika mereka mengejar kamu, sehingga TUHAN membinasakan mereka untuk selamanya;"
 },
 {
   "id": 5215,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 5,
   "firman": "dan apa yang dilakukan-Nya terhadapmu di padang gurun, sampai kamu tiba di tempat ini;"
 },
 {
   "id": 5216,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 6,
   "firman": "pula apa yang dilakukan-Nya terhadap Datan dan Abiram, anak-anak Eliab, anak Ruben, yakni ketika tanah mengangakan mulutnya dan menelan mereka dengan seisi rumahnya, kemah-kemah dan segala yang mengikuti mereka, di tengah-tengah seluruh orang Israel."
 },
 {
   "id": 5217,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 7,
   "firman": "Sebab matamu sendirilah yang telah melihat segala perbuatan besar yang dilakukan TUHAN.\""
 },
 {
   "id": 5218,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 8,
   "firman": "\"Jadi kamu harus berpegang pada seluruh perintah yang kusampaikan kepadamu pada hari ini, supaya kamu kuat untuk memasuki serta menduduki negeri, ke mana kamu pergi mendudukinya,"
 },
 {
   "id": 5219,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 9,
   "firman": "dan supaya lanjut umurmu di tanah yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu untuk memberikannya kepada mereka dan kepada keturunan mereka, suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 5220,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 10,
   "firman": "Sebab negeri, ke mana engkau masuk untuk mendudukinya, bukanlah negeri seperti tanah Mesir, dari mana kamu keluar, yang setelah ditabur dengan benih harus kauairi dengan jerih payah, seakan-akan kebun sayur."
 },
 {
   "id": 5221,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 11,
   "firman": "Tetapi negeri, ke mana kamu pergi untuk mendudukinya, ialah negeri yang bergunung-gunung dan berlembah-lembah, yang mendapat air sebanyak hujan yang turun dari langit;"
 },
 {
   "id": 5222,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 12,
   "firman": "suatu negeri yang dipelihara oleh TUHAN, Allahmu: mata TUHAN, Allahmu, tetap mengawasinya dari awal sampai akhir tahun."
 },
 {
   "id": 5223,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 13,
   "firman": "Jika kamu dengan sungguh-sungguh mendengarkan perintah yang kusampaikan kepadamu pada hari ini, sehingga kamu mengasihi TUHAN, Allahmu, dan beribadah kepada-Nya dengan segenap hatimu dan dengan segenap jiwamu,"
 },
 {
   "id": 5224,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 14,
   "firman": "maka Ia akan memberikan hujan untuk tanahmu pada masanya, hujan awal dan hujan akhir, sehingga engkau dapat mengumpulkan gandummu, anggurmu dan minyakmu,"
 },
 {
   "id": 5225,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 15,
   "firman": "dan Dia akan memberi rumput di padangmu untuk hewanmu, sehingga engkau dapat makan dan menjadi kenyang."
 },
 {
   "id": 5226,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 16,
   "firman": "Hati-hatilah, supaya jangan hatimu terbujuk, sehingga kamu menyimpang dengan beribadah kepada allah lain dan sujud menyembah kepadanya."
 },
 {
   "id": 5227,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 17,
   "firman": "Jika demikian, maka akan bangkitlah murka TUHAN terhadap kamu dan Ia akan menutup langit, sehingga tidak ada hujan dan tanah tidak mengeluarkan hasil, lalu kamu lenyap dengan cepat dari negeri yang baik yang diberikan TUHAN kepadamu."
 },
 {
   "id": 5228,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 18,
   "firman": "Tetapi kamu harus menaruh perkataanku ini dalam hatimu dan dalam jiwamu; kamu harus mengikatkannya sebagai tanda pada tanganmu dan haruslah itu menjadi lambang di dahimu."
 },
 {
   "id": 5229,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 19,
   "firman": "Kamu harus mengajarkannya kepada anak-anakmu dengan membicarakannya, apabila engkau duduk di rumahmu dan apabila engkau sedang dalam perjalanan, apabila engkau berbaring dan apabila engkau bangun;"
 },
 {
   "id": 5230,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 20,
   "firman": "engkau harus menuliskannya pada tiang pintu rumahmu dan pada pintu gerbangmu,"
 },
 {
   "id": 5231,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 21,
   "firman": "supaya panjang umurmu dan umur anak-anakmu di tanah yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu untuk memberikannya kepada mereka, selama ada langit di atas bumi."
 },
 {
   "id": 5232,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 22,
   "firman": "Sebab jika kamu sungguh-sungguh berpegang pada perintah yang kusampaikan kepadamu untuk dilakukan, dengan mengasihi TUHAN, Allahmu, dengan hidup menurut segala jalan yang ditunjukkan-Nya dan dengan berpaut pada-Nya,"
 },
 {
   "id": 5233,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 23,
   "firman": "maka TUHAN akan menghalau segala bangsa ini dari hadapanmu, sehingga kamu menduduki daerah bangsa-bangsa yang lebih besar dan lebih kuat dari padamu."
 },
 {
   "id": 5234,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 24,
   "firman": "Setiap tempat yang diinjak oleh telapak kakimu, kamulah yang akan memilikinya: mulai dari padang gurun sampai gunung Libanon, dan dari sungai itu, yakni sungai Efrat, sampai laut sebelah barat, akan menjadi daerahmu."
 },
 {
   "id": 5235,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 25,
   "firman": "Tidak ada yang akan dapat bertahan menghadapi kamu: TUHAN, Allahmu, akan membuat seluruh negeri yang kauinjak itu menjadi gemetar dan takut kepadamu, seperti yang dijanjikan TUHAN kepadamu."
 },
 {
   "id": 5236,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 26,
   "firman": "Lihatlah, aku memperhadapkan kepadamu pada hari ini berkat dan kutuk:"
 },
 {
   "id": 5237,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 27,
   "firman": "berkat, apabila kamu mendengarkan perintah TUHAN, Allahmu, yang kusampaikan kepadamu pada hari ini;"
 },
 {
   "id": 5238,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 28,
   "firman": "dan kutuk, jika kamu tidak mendengarkan perintah TUHAN, Allahmu, dan menyimpang dari jalan yang kuperintahkan kepadamu pada hari ini, dengan mengikuti allah lain yang tidak kamu kenal."
 },
 {
   "id": 5239,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 29,
   "firman": "Jadi apabila TUHAN, Allahmu, telah membawa engkau ke negeri, yang engkau masuki untuk mendudukinya, maka haruslah engkau mengucapkan berkat di atas gunung Gerizim dan kutuk di atas gunung Ebal."
 },
 {
   "id": 5240,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 30,
   "firman": "Bukankah keduanya terletak di sebelah barat sungai Yordan, di belakang jalan raya sebelah matahari terbenam, di negeri orang Kanaan yang diam di Araba-Yordan, di tentangan Gilgal dekat pohon-pohon tarbantin di More?"
 },
 {
   "id": 5241,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 31,
   "firman": "Sebab kamu ini sebentar lagi hendak menyeberangi sungai Yordan untuk memasuki dan menduduki negeri yang diberikan kepadamu oleh TUHAN, Allahmu; dan bila kamu akan menduduki dan mendiaminya,"
 },
 {
   "id": 5242,
   "kitab": "Ula",
   "pasal": 11,
   "ayat": 32,
   "firman": "maka haruslah kamu melakukan dengan setia segala ketetapan dan peraturan yang kupaparkan kepadamu pada hari ini.\""
 },
 {
   "id": 5243,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 1,
   "firman": "\"Inilah ketetapan dan peraturan yang harus kamu lakukan dengan setia di negeri yang diberikan TUHAN, Allah nenek moyangmu, kepadamu untuk memilikinya, selama kamu hidup di muka bumi."
 },
 {
   "id": 5244,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 2,
   "firman": "Kamu harus memusnahkan sama sekali segala tempat, di mana bangsa-bangsa yang daerahnya kamu duduki itu beribadah kepada allah mereka, yakni di gunung-gunung yang tinggi, di bukit-bukit dan di bawah setiap pohon yang rimbun."
 },
 {
   "id": 5245,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 3,
   "firman": "Mezbah mereka kamu harus robohkan, tugu-tugu berhala mereka kamu remukkan, tiang-tiang berhala mereka kamu bakar habis, patung-patung allah mereka kamu hancurkan, dan nama mereka kamu hapuskan dari tempat itu."
 },
 {
   "id": 5246,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 4,
   "firman": "Jangan kamu berbuat seperti itu terhadap TUHAN, Allahmu."
 },
 {
   "id": 5247,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 5,
   "firman": "Tetapi tempat yang akan dipilih TUHAN, Allahmu, dari segala sukumu sebagai kediaman-Nya untuk menegakkan nama-Nya di sana, tempat itulah harus kamu cari dan ke sanalah harus kamu pergi."
 },
 {
   "id": 5248,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 6,
   "firman": "Ke sanalah harus kamu bawa korban bakaran dan korban sembelihanmu, persembahan persepuluhanmu dan persembahan khususmu, korban nazarmu dan korban sukarelamu, anak-anak sulung lembu sapimu dan kambing dombamu."
 },
 {
   "id": 5249,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 7,
   "firman": "Di sanalah kamu makan di hadapan TUHAN, Allahmu, dan bersukaria, kamu dan seisi rumahmu, karena dalam segala usahamu engkau diberkati oleh TUHAN, Allahmu."
 },
 {
   "id": 5250,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 8,
   "firman": "Jangan kamu melakukan apapun yang kita lakukan di sini sekarang, yakni masing-masing berbuat segala sesuatu yang dipandangnya benar."
 },
 {
   "id": 5251,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 9,
   "firman": "Sebab hingga sekarang kamu belum sampai ke tempat perhentian dan ke milik pusaka yang diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5252,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 10,
   "firman": "Tetapi apabila nanti sudah kamu seberangi sungai Yordan dan kamu diam di negeri yang diberikan TUHAN, Allahmu, kepadamu untuk dimiliki, dan apabila Ia mengaruniakan kepadamu keamanan dari segala musuhmu di sekelilingmu, dan kamu diam dengan tenteram,"
 },
 {
   "id": 5253,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 11,
   "firman": "maka ke tempat yang dipilih TUHAN, Allahmu, untuk membuat nama-Nya diam di sana, haruslah kamu bawa semuanya yang kuperintahkan kepadamu, yakni korban bakaran dan korban sembelihanmu, persembahan persepuluhanmu dan persembahan khususmu dan segala korban nazarmu yang terpilih, yang kamu nazarkan kepada TUHAN."
 },
 {
   "id": 5254,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 12,
   "firman": "Kamu harus bersukaria di hadapan TUHAN, Allahmu, kamu ini, anakmu laki-laki dan anakmu perempuan, hambamu laki-laki dan hambamu perempuan, dan orang Lewi yang di dalam tempatmu, sebab orang Lewi tidak mendapat bagian milik pusaka bersama-sama kamu."
 },
 {
   "id": 5255,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 13,
   "firman": "Hati-hatilah, supaya jangan engkau mempersembahkan korban-korban bakaranmu di sembarang tempat yang kaulihat;"
 },
 {
   "id": 5256,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 14,
   "firman": "tetapi di tempat yang akan dipilih TUHAN di daerah salah satu sukumu, di sanalah harus kaupersembahkan korban bakaranmu, dan di sanalah harus kaulakukan segala yang kuperintahkan kepadamu."
 },
 {
   "id": 5257,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 15,
   "firman": "Tetapi engkau boleh menyembelih dan memakan daging sesuka hatimu, sesuai dengan berkat TUHAN, Allahmu, yang diberikan-Nya kepadamu di segala tempatmu. Orang najis ataupun orang tahir boleh memakannya, seperti juga daging kijang atau daging rusa;"
 },
 {
   "id": 5258,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 16,
   "firman": "hanya darahnya janganlah kaumakan, tetapi harus kaucurahkan ke bumi seperti air."
 },
 {
   "id": 5259,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 17,
   "firman": "Di dalam tempatmu tidak boleh kaumakan persembahan persepuluhan dari gandummu, dari anggurmu dan minyakmu, ataupun dari anak-anak sulung lembu sapimu dan kambing dombamu, ataupun sesuatu dari korban yang akan kaunazarkan, ataupun dari korban sukarelamu, ataupun persembahan khususmu."
 },
 {
   "id": 5260,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 18,
   "firman": "Tetapi di hadapan TUHAN, Allahmu, haruslah engkau memakannya, di tempat yang akan dipilih TUHAN, Allahmu, engkau ini, anakmu laki-laki dan anakmu perempuan, hambamu laki-laki dan hambamu perempuan, dan orang Lewi yang di dalam tempatmu, dan haruslah engkau bersukaria di hadapan TUHAN, Allahmu, karena segala usahamu."
 },
 {
   "id": 5261,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 19,
   "firman": "Hati-hatilah, supaya jangan engkau melalaikan orang Lewi, selama engkau ada di tanahmu."
 },
 {
   "id": 5262,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 20,
   "firman": "Apabila TUHAN, Allahmu, telah meluaskan daerahmu nanti, seperti yang dijanjikan-Nya kepadamu dan engkau berpikir: Aku mau makan daging, karena engkau ingin makan daging, maka bolehlah engkau makan daging sesuka hatimu."
 },
 {
   "id": 5263,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 21,
   "firman": "Apabila tempat yang akan dipilih TUHAN, Allahmu, untuk menegakkan nama-Nya di sana, terlalu jauh dari tempatmu, maka engkau boleh menyembelih dari lembu sapimu dan kambing dombamu yang diberikan TUHAN kepadamu, seperti yang kuperintahkan kepadamu, dan memakan dagingnya di tempatmu sesuka hatimu."
 },
 {
   "id": 5264,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 22,
   "firman": "Tetapi engkau harus memakan dagingnya, seperti memakan daging kijang atau daging rusa; baik orang najis maupun orang tahir boleh memakannya."
 },
 {
   "id": 5265,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 23,
   "firman": "Tetapi jagalah baik-baik, supaya jangan engkau memakan darahnya, sebab darah ialah nyawa, maka janganlah engkau memakan nyawa bersama-sama dengan daging."
 },
 {
   "id": 5266,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 24,
   "firman": "Janganlah engkau memakannya; engkau harus mencurahkannya ke bumi seperti air."
 },
 {
   "id": 5267,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 25,
   "firman": "Janganlah engkau memakannya, supaya baik keadaanmu dan keadaan anak-anakmu yang kemudian, apabila engkau melakukan apa yang benar di mata TUHAN."
 },
 {
   "id": 5268,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 26,
   "firman": "Tetapi persembahan kudusmu yang ada padamu dan korban nazarmu haruslah kaubawa ke tempat yang akan dipilih TUHAN;"
 },
 {
   "id": 5269,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 27,
   "firman": "engkau harus mengolah korban bakaranmu, daging dan darahnya, di atas mezbah TUHAN, Allahmu, dan darah korban sembelihanmu haruslah dicurahkan ke atas mezbah TUHAN, Allahmu, tetapi dagingnya boleh kaumakan."
 },
 {
   "id": 5270,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 28,
   "firman": "Dengarkanlah baik-baik segala yang kuperintahkan kepadamu, supaya baik keadaanmu dan keadaan anak-anakmu yang kemudian untuk selama-lamanya, apabila engkau melakukan apa yang baik dan benar di mata TUHAN, Allahmu.\""
 },
 {
   "id": 5271,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 29,
   "firman": "\"Apabila TUHAN, Allahmu, telah melenyapkan dari hadapanmu bangsa-bangsa yang daerahnya kaumasuki untuk mendudukinya, dan apabila engkau sudah menduduki daerahnya dan diam di negerinya,"
 },
 {
   "id": 5272,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 30,
   "firman": "maka hati-hatilah, supaya jangan engkau kena jerat dan mengikuti mereka, setelah mereka dipunahkan dari hadapanmu, dan supaya jangan engkau menanya-nanya tentang allah mereka dengan berkata: Bagaimana bangsa-bangsa ini beribadah kepada allah mereka? Akupun mau berlaku begitu."
 },
 {
   "id": 5273,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 31,
   "firman": "Jangan engkau berbuat seperti itu terhadap TUHAN, Allahmu; sebab segala yang menjadi kekejian bagi TUHAN, apa yang dibenci-Nya, itulah yang dilakukan mereka bagi allah mereka; bahkan anak-anaknya lelaki dan anak-anaknya perempuan dibakar mereka dengan api bagi allah mereka."
 },
 {
   "id": 5274,
   "kitab": "Ula",
   "pasal": 12,
   "ayat": 32,
   "firman": "Segala yang kuperintahkan kepadamu haruslah kamu lakukan dengan setia, janganlah engkau menambahinya ataupun menguranginya."
 },
 {
   "id": 5275,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 1,
   "firman": "Apabila di tengah-tengahmu muncul seorang nabi atau seorang pemimpi, dan ia memberitahukan kepadamu suatu tanda atau mujizat,"
 },
 {
   "id": 5276,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 2,
   "firman": "dan apabila tanda atau mujizat yang dikatakannya kepadamu itu terjadi, dan ia membujuk: Mari kita mengikuti allah lain, yang tidak kaukenal, dan mari kita berbakti kepadanya,"
 },
 {
   "id": 5277,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 3,
   "firman": "maka janganlah engkau mendengarkan perkataan nabi atau pemimpi itu; sebab TUHAN, Allahmu, mencoba kamu untuk mengetahui, apakah kamu sungguh-sungguh mengasihi TUHAN, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu."
 },
 {
   "id": 5278,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 4,
   "firman": "TUHAN, Allahmu, harus kamu ikuti, kamu harus takut akan Dia, kamu harus berpegang pada perintah-Nya, suara-Nya harus kamu dengarkan, kepada-Nya harus kamu berbakti dan berpaut."
 },
 {
   "id": 5279,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 5,
   "firman": "Nabi atau pemimpi itu haruslah dihukum mati, karena ia telah mengajak murtad terhadap TUHAN, Allahmu, yang telah membawa kamu keluar dari tanah Mesir dan yang menebus engkau dari rumah perbudakan--dengan maksud untuk menyesatkan engkau dari jalan yang diperintahkan TUHAN, Allahmu, kepadamu untuk dijalani. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu."
 },
 {
   "id": 5280,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 6,
   "firman": "Apabila saudaramu laki-laki, anak ibumu, atau anakmu laki-laki atau anakmu perempuan atau isterimu sendiri atau sahabat karibmu membujuk engkau diam-diam, katanya: Mari kita berbakti kepada allah lain yang tidak dikenal olehmu ataupun oleh nenek moyangmu,"
 },
 {
   "id": 5281,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 7,
   "firman": "salah satu allah bangsa-bangsa sekelilingmu, baik yang dekat kepadamu maupun yang jauh dari padamu, dari ujung bumi ke ujung bumi,"
 },
 {
   "id": 5282,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 8,
   "firman": "maka janganlah engkau mengalah kepadanya dan janganlah mendengarkan dia. Janganlah engkau merasa sayang kepadanya, janganlah mengasihani dia dan janganlah menutupi salahnya,"
 },
 {
   "id": 5283,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 9,
   "firman": "tetapi bunuhlah dia! Pertama-tama tanganmu sendirilah yang bergerak untuk membunuh dia, kemudian seluruh rakyat."
 },
 {
   "id": 5284,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 10,
   "firman": "Engkau harus melempari dia dengan batu, sehingga mati, karena ia telah berikhtiar menyesatkan engkau dari pada TUHAN, Allahmu, yang telah membawa engkau keluar dari tanah Mesir, dari rumah perbudakan."
 },
 {
   "id": 5285,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 11,
   "firman": "Maka seluruh orang Israel akan mendengar dan menjadi takut, sehingga mereka tidak akan melakukan lagi perbuatan jahat seperti itu di tengah-tengahmu."
 },
 {
   "id": 5286,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 12,
   "firman": "Apabila di salah satu kota yang diberikan TUHAN, Allahmu, kepadamu untuk diam di sana, kaudengar orang berkata:"
 },
 {
   "id": 5287,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 13,
   "firman": "Ada orang-orang dursila tampil dari tengah-tengahmu, yang telah menyesatkan penduduk kota mereka dengan berkata: Mari kita berbakti kepada allah lain yang tidak kamu kenal,"
 },
 {
   "id": 5288,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 14,
   "firman": "maka haruslah engkau memeriksa, menyelidiki dan menanyakan baik-baik. Jikalau ternyata benar dan sudah pasti, bahwa kekejian itu dilakukan di tengah-tengahmu,"
 },
 {
   "id": 5289,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 15,
   "firman": "maka bunuhlah dengan mata pedang penduduk kota itu, dan tumpaslah dengan mata pedang kota itu serta segala isinya dan hewannya."
 },
 {
   "id": 5290,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 16,
   "firman": "Seluruh jarahan harus kaukumpulkan di tengah-tengah lapangan dan harus kaubakar habis kota dengan seluruh jarahan itu sebagai korban bakaran yang lengkap bagi TUHAN, Allahmu. Semuanya itu akan tetap menjadi timbunan puing untuk selamanya dan tidak akan dibangun kembali."
 },
 {
   "id": 5291,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 17,
   "firman": "Dari barang-barang yang dikhususkan itu janganlah apapun melekat pada tanganmu, supaya TUHAN berhenti dari murka-Nya yang bernyala-nyala itu, menunjukkan belas kasihan-Nya kepadamu, mengasihani engkau dan membuat jumlahmu banyak, seperti yang dijanjikan-Nya dengan sumpah kepada nenek moyangmu."
 },
 {
   "id": 5292,
   "kitab": "Ula",
   "pasal": 13,
   "ayat": 18,
   "firman": "Sebab dengan demikian engkau mendengarkan suara TUHAN, Allahmu, untuk berpegang pada segala perintah-Nya, yang kusampaikan kepadamu pada hari ini, dengan melakukan apa yang benar di mata TUHAN, Allahmu.\""
 },
 {
   "id": 5293,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 1,
   "firman": "\"Kamulah anak-anak TUHAN, Allahmu; janganlah kamu menoreh-noreh dirimu ataupun menggundul rambut di atas dahimu karena kematian seseorang;"
 },
 {
   "id": 5294,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 2,
   "firman": "sebab engkaulah umat yang kudus bagi TUHAN, Allahmu, dan engkau dipilih TUHAN untuk menjadi umat kesayangan-Nya dari antara segala bangsa yang di atas muka bumi.\""
 },
 {
   "id": 5295,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 3,
   "firman": "\"Janganlah engkau memakan sesuatu yang merupakan kekejian."
 },
 {
   "id": 5296,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 4,
   "firman": "Inilah binatang-binatang berkaki empat yang boleh kamu makan: lembu, domba dan kambing;"
 },
 {
   "id": 5297,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 5,
   "firman": "rusa, kijang, rusa dandi, kambing hutan, kijang gunung, lembu hutan dan domba hutan."
 },
 {
   "id": 5298,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 6,
   "firman": "Setiap binatang berkaki empat yang berkuku belah--yaitu yang kukunya bersela panjang menjadi dua--dan yang memamah biak di antara binatang-binatang berkaki empat, itu boleh kamu makan."
 },
 {
   "id": 5299,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 7,
   "firman": "Tetapi inilah yang tidak boleh kamu makan dari antara yang memamah biak atau dari antara yang berbelah dan bersela kukunya: unta, kelinci hutan dan marmot, karena semuanya itu memang memamah biak, tetapi tidak berkuku belah; haram semuanya itu bagimu."
 },
 {
   "id": 5300,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 8,
   "firman": "Juga babi hutan, karena memang berkuku belah, tetapi tidak memamah biak; haram itu bagimu. Daging binatang-binatang itu janganlah kamu makan dan janganlah kamu terkena bangkainya."
 },
 {
   "id": 5301,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 9,
   "firman": "Inilah yang boleh kamu makan dari segala yang hidup di dalam air; segala yang bersirip dan bersisik boleh kamu makan,"
 },
 {
   "id": 5302,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 10,
   "firman": "tetapi segala yang tidak bersirip atau bersisik janganlah kamu makan; haram semuanya itu bagimu."
 },
 {
   "id": 5303,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 11,
   "firman": "Setiap burung yang tidak haram boleh kamu makan."
 },
 {
   "id": 5304,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 12,
   "firman": "Tetapi yang berikut janganlah kamu makan: burung rajawali, ering janggut dan elang laut;"
 },
 {
   "id": 5305,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 13,
   "firman": "elang merah, elang hitam dan burung dendang menurut jenisnya;"
 },
 {
   "id": 5306,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 14,
   "firman": "setiap burung gagak menurut jenisnya;"
 },
 {
   "id": 5307,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 15,
   "firman": "burung unta, burung hantu, camar dan elang sikap menurut jenisnya;"
 },
 {
   "id": 5308,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 16,
   "firman": "burung pungguk, burung hantu besar, burung hantu putih;"
 },
 {
   "id": 5309,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 17,
   "firman": "burung undan, burung ering dan burung dendang air;"
 },
 {
   "id": 5310,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 18,
   "firman": "burung ranggung, dan bangau menurut jenisnya, meragai dan kelelawar."
 },
 {
   "id": 5311,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 19,
   "firman": "Juga segala binatang mengeriap yang bersayap, itupun haram bagimu, jangan dimakan."
 },
 {
   "id": 5312,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 20,
   "firman": "Segala burung yang tidak haram boleh kamu makan."
 },
 {
   "id": 5313,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 21,
   "firman": "Janganlah kamu memakan bangkai apapun, tetapi boleh kauberikan kepada pendatang yang di dalam tempatmu untuk dimakan, atau boleh kaujual kepada orang asing; sebab engkaulah umat yang kudus bagi TUHAN, Allahmu. Janganlah kaumasak anak kambing dalam air susu induknya.\""
 },
 {
   "id": 5314,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 22,
   "firman": "\"Haruslah engkau benar-benar mempersembahkan sepersepuluh dari seluruh hasil benih yang tumbuh di ladangmu, tahun demi tahun."
 },
 {
   "id": 5315,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 23,
   "firman": "Di hadapan TUHAN, Allahmu, di tempat yang akan dipilih-Nya untuk membuat nama-Nya diam di sana, haruslah engkau memakan persembahan persepuluhan dari gandummu, dari anggurmu dan minyakmu, ataupun dari anak-anak sulung lembu sapimu dan kambing dombamu, supaya engkau belajar untuk selalu takut akan TUHAN, Allahmu."
 },
 {
   "id": 5316,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 24,
   "firman": "Apabila, dalam hal engkau diberkati TUHAN, Allahmu, jalan itu terlalu jauh bagimu, sehingga engkau tidak dapat mengangkutnya, karena tempat yang akan dipilih TUHAN untuk menegakkan nama-Nya di sana terlalu jauh dari tempatmu,"
 },
 {
   "id": 5317,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 25,
   "firman": "maka haruslah engkau menguangkannya dan membawa uang itu dalam bungkusan dan pergi ke tempat yang akan dipilih TUHAN, Allahmu,"
 },
 {
   "id": 5318,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 26,
   "firman": "dan haruslah engkau membelanjakan uang itu untuk segala yang disukai hatimu, untuk lembu sapi atau kambing domba, untuk anggur atau minuman yang memabukkan, atau apapun yang diingini hatimu, dan haruslah engkau makan di sana di hadapan TUHAN, Allahmu dan bersukaria, engkau dan seisi rumahmu."
 },
 {
   "id": 5319,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 27,
   "firman": "Juga orang Lewi yang diam di dalam tempatmu janganlah kauabaikan, sebab ia tidak mendapat bagian milik pusaka bersama-sama engkau."
 },
 {
   "id": 5320,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 28,
   "firman": "Pada akhir tiga tahun engkau harus mengeluarkan segala persembahan persepuluhan dari hasil tanahmu dalam tahun itu dan menaruhnya di dalam kotamu;"
 },
 {
   "id": 5321,
   "kitab": "Ula",
   "pasal": 14,
   "ayat": 29,
   "firman": "maka orang Lewi, karena ia tidak mendapat bagian milik pusaka bersama-sama engkau, dan orang asing, anak yatim dan janda yang di dalam tempatmu, akan datang makan dan menjadi kenyang, supaya TUHAN, Allahmu, memberkati engkau di dalam segala usaha yang dikerjakan tanganmu.\""
 },
 {
   "id": 5322,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 1,
   "firman": "\"Pada akhir tujuh tahun engkau harus mengadakan penghapusan hutang."
 },
 {
   "id": 5323,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 2,
   "firman": "Inilah cara penghapusan itu: setiap orang yang berpiutang harus menghapuskan apa yang dipinjamkannya kepada sesamanya; janganlah ia menagih dari sesamanya atau saudaranya, karena telah dimaklumkan penghapusan hutang demi TUHAN."
 },
 {
   "id": 5324,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 3,
   "firman": "Dari seorang asing boleh kautagih, tetapi piutangmu kepada saudaramu haruslah kauhapuskan."
 },
 {
   "id": 5325,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 4,
   "firman": "Maka tidak akan ada orang miskin di antaramu, sebab sungguh TUHAN akan memberkati engkau di negeri yang diberikan TUHAN, Allahmu, kepadamu untuk menjadi milik pusaka,"
 },
 {
   "id": 5326,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 5,
   "firman": "asal saja engkau mendengarkan baik-baik suara TUHAN, Allahmu, dan melakukan dengan setia segenap perintah yang kusampaikan kepadamu pada hari ini."
 },
 {
   "id": 5327,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 6,
   "firman": "Apabila TUHAN, Allahmu, memberkati engkau, seperti yang dijanjikan-Nya kepadamu, maka engkau akan memberi pinjaman kepada banyak bangsa, tetapi engkau sendiri tidak akan meminta pinjaman; engkau akan menguasai banyak bangsa, tetapi mereka tidak akan menguasai engkau."
 },
 {
   "id": 5328,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 7,
   "firman": "Jika sekiranya ada di antaramu seorang miskin, salah seorang saudaramu di dalam salah satu tempatmu, di negeri yang diberikan kepadamu oleh TUHAN, Allahmu, maka janganlah engkau menegarkan hati ataupun menggenggam tangan terhadap saudaramu yang miskin itu,"
 },
 {
   "id": 5329,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 8,
   "firman": "tetapi engkau harus membuka tangan lebar-lebar baginya dan memberi pinjaman kepadanya dengan limpahnya, cukup untuk keperluannya, seberapa ia perlukan."
 },
 {
   "id": 5330,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 9,
   "firman": "Hati-hatilah, supaya jangan timbul di dalam hatimu pikiran dursila, demikian: Sudah dekat tahun ketujuh, tahun penghapusan hutang, dan engkau menjadi kesal terhadap saudaramu yang miskin itu dan engkau tidak memberikan apa-apa kepadanya, maka ia berseru kepada TUHAN tentang engkau, dan hal itu menjadi dosa bagimu."
 },
 {
   "id": 5331,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 10,
   "firman": "Engkau harus memberi kepadanya dengan limpahnya dan janganlah hatimu berdukacita, apabila engkau memberi kepadanya, sebab oleh karena hal itulah TUHAN, Allahmu, akan memberkati engkau dalam segala pekerjaanmu dan dalam segala usahamu."
 },
 {
   "id": 5332,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 11,
   "firman": "Sebab orang-orang miskin tidak hentinya akan ada di dalam negeri itu; itulah sebabnya aku memberi perintah kepadamu, demikian: Haruslah engkau membuka tangan lebar-lebar bagi saudaramu, yang tertindas dan yang miskin di negerimu.\""
 },
 {
   "id": 5333,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 12,
   "firman": "\"Apabila seorang saudaramu menjual dirinya kepadamu, baik seorang laki-laki Ibrani ataupun seorang perempuan Ibrani, maka ia akan bekerja padamu enam tahun lamanya, tetapi pada tahun yang ketujuh engkau harus melepaskan dia sebagai orang merdeka."
 },
 {
   "id": 5334,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 13,
   "firman": "Dan apabila engkau melepaskan dia sebagai orang merdeka, maka janganlah engkau melepaskan dia dengan tangan hampa,"
 },
 {
   "id": 5335,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 14,
   "firman": "engkau harus dengan limpahnya memberi bekal kepadanya dari kambing dombamu, dari tempat pengirikanmu dan dari tempat pemerasanmu, sesuai dengan berkat yang diberikan kepadamu oleh TUHAN, Allahmu, haruslah kauberikan kepadanya."
 },
 {
   "id": 5336,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 15,
   "firman": "Haruslah kauingat, bahwa engkaupun dahulu budak di tanah Mesir dan engkau ditebus TUHAN, Allahmu; itulah sebabnya aku memberi perintah itu kepadamu pada hari ini."
 },
 {
   "id": 5337,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 16,
   "firman": "Tetapi apabila dia berkata kepadamu: Aku tidak mau keluar meninggalkan engkau, karena ia mengasihi engkau dan keluargamu, sebab baik keadaannya padamu,"
 },
 {
   "id": 5338,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 17,
   "firman": "maka engkau harus mengambil sebuah penusuk dan menindik telinganya pada pintu, sehingga ia menjadi budakmu untuk selama-lamanya. Demikian juga kauperbuat kepada budakmu perempuan."
 },
 {
   "id": 5339,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 18,
   "firman": "Janganlah merasa susah, apabila engkau melepaskan dia sebagai orang merdeka, sebab enam tahun lamanya ia telah bekerja padamu dengan jasa dua kali upah seorang pekerja harian. Maka TUHAN, Allahmu, akan memberkati engkau dalam segala sesuatu yang kaukerjakan.\""
 },
 {
   "id": 5340,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 19,
   "firman": "\"Segala anak sulung jantan yang lahir di antara lembu sapimu dan kambing dombamu, haruslah kaukuduskan bagi TUHAN, Allahmu; janganlah engkau memakai anak sulung lembumu, dan janganlah engkau menggunting bulu anak sulung dombamu."
 },
 {
   "id": 5341,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 20,
   "firman": "Di hadapan TUHAN, Allahmu, engkau harus memakan dagingnya tahun demi tahun di tempat yang akan dipilih TUHAN, engkau ini dan seisi rumahmu."
 },
 {
   "id": 5342,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 21,
   "firman": "Tetapi apabila ada cacatnya, jika timpang atau buta, bahkan cacat apapun yang buruk, maka janganlah engkau menyembelihnya bagi TUHAN, Allahmu."
 },
 {
   "id": 5343,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 22,
   "firman": "Di dalam tempatmu boleh engkau, baik orang najis maupun orang tahir, memakan dagingnya, seperti daging kijang atau daging rusa."
 },
 {
   "id": 5344,
   "kitab": "Ula",
   "pasal": 15,
   "ayat": 23,
   "firman": "Hanya darahnya janganlah kaumakan; haruslah kaucurahkan ke tanah seperti air.\""
 },
 {
   "id": 5345,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 1,
   "firman": "\"Ingatlah akan bulan Abib dan rayakanlah Paskah bagi TUHAN, Allahmu, sebab dalam bulan Abib itulah TUHAN, Allahmu, membawa engkau keluar dari Mesir pada waktu malam."
 },
 {
   "id": 5346,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 2,
   "firman": "Maka engkau harus menyembelih kambing domba dan lembu sapi sebagai korban Paskah bagi TUHAN, Allahmu, di tempat yang akan dipilih TUHAN untuk membuat nama-Nya diam di sana."
 },
 {
   "id": 5347,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 3,
   "firman": "Janganlah engkau makan sesuatu yang beragi besertanya; tujuh hari lamanya engkau harus makan roti yang tidak beragi besertanya, yakni roti penderitaan, sebab dengan buru-buru engkau keluar dari tanah Mesir. Maksudnya supaya seumur hidupmu engkau teringat akan hari engkau keluar dari tanah Mesir."
 },
 {
   "id": 5348,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 4,
   "firman": "Janganlah terdapat padamu ragi di seluruh daerahmu, tujuh hari lamanya; dan dari daging hewan yang kausembelih pada waktu petang pada hari pertama, janganlah ada yang bermalam sampai pagi."
 },
 {
   "id": 5349,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 5,
   "firman": "Engkau tidak boleh mempersembahkan korban Paskah di salah satu tempat yang diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5350,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 6,
   "firman": "Tetapi di tempat yang akan dipilih TUHAN, Allahmu, untuk membuat nama-Nya diam di sana, engkau harus mempersembahkan korban Paskah itu pada waktu senja, ketika matahari terbenam, bertepatan dengan saat engkau keluar dari Mesir."
 },
 {
   "id": 5351,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 7,
   "firman": "Engkau harus memasaknya dan memakannya di tempat yang akan dipilih TUHAN, Allahmu; kemudian paginya engkau harus pulang kembali ke kemahmu."
 },
 {
   "id": 5352,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 8,
   "firman": "Enam hari lamanya engkau harus makan roti yang tidak beragi dan pada hari yang ketujuh harus ada perkumpulan raya bagi TUHAN, Allahmu; maka janganlah engkau melakukan pekerjaan."
 },
 {
   "id": 5353,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 9,
   "firman": "Tujuh minggu harus kauhitung: pada waktu orang mulai menyabit gandum yang belum dituai, haruslah engkau mulai menghitung tujuh minggu itu."
 },
 {
   "id": 5354,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 10,
   "firman": "Kemudian haruslah engkau merayakan hari raya Tujuh Minggu bagi TUHAN, Allahmu, sekedar persembahan sukarela yang akan kauberikan, sesuai dengan berkat yang diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5355,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 11,
   "firman": "Haruslah engkau bersukaria di hadapan TUHAN, Allahmu, engkau ini dan anakmu laki-laki serta anakmu perempuan, hambamu laki-laki dan hambamu perempuan, dan orang Lewi yang di dalam tempatmu, dan orang asing, anak yatim dan janda, yang di tengah-tengahmu, di tempat yang akan dipilih TUHAN, Allahmu, untuk membuat nama-Nya diam di sana."
 },
 {
   "id": 5356,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 12,
   "firman": "Haruslah kauingat, bahwa engkaupun dahulu budak di Mesir, dan haruslah engkau melakukan ketetapan ini dengan setia."
 },
 {
   "id": 5357,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 13,
   "firman": "Hari raya Pondok Daun haruslah kaurayakan tujuh hari lamanya, apabila engkau selesai mengumpulkan hasil tempat pengirikanmu dan tempat pemerasanmu."
 },
 {
   "id": 5358,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 14,
   "firman": "Haruslah engkau bersukaria pada hari rayamu itu, engkau ini dan anakmu laki-laki serta anakmu perempuan, hambamu laki-laki dan hambamu perempuan, dan orang Lewi, orang asing, anak yatim dan janda yang di dalam tempatmu."
 },
 {
   "id": 5359,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 15,
   "firman": "Tujuh hari lamanya harus engkau mengadakan perayaan bagi TUHAN, Allahmu, di tempat yang akan dipilih TUHAN; sebab TUHAN, Allahmu, akan memberkati engkau dalam segala hasil tanahmu dan dalam segala usahamu, sehingga engkau dapat bersukaria dengan sungguh-sungguh."
 },
 {
   "id": 5360,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 16,
   "firman": "Tiga kali setahun setiap orang laki-laki di antaramu harus menghadap hadirat TUHAN, Allahmu, ke tempat yang akan dipilih-Nya, yakni pada hari raya Roti Tidak Beragi, pada hari raya Tujuh Minggu dan pada hari raya Pondok Daun. Janganlah ia menghadap hadirat TUHAN dengan tangan hampa,"
 },
 {
   "id": 5361,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 17,
   "firman": "tetapi masing-masing dengan sekedar persembahan, sesuai dengan berkat yang diberikan kepadamu oleh TUHAN, Allahmu.\""
 },
 {
   "id": 5362,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 18,
   "firman": "\"Hakim-hakim dan petugas-petugas haruslah kauangkat di segala tempat yang diberikan TUHAN, Allahmu, kepadamu, menurut suku-sukumu; mereka harus menghakimi bangsa itu dengan pengadilan yang adil."
 },
 {
   "id": 5363,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 19,
   "firman": "Janganlah memutarbalikkan keadilan, janganlah memandang bulu dan janganlah menerima suap, sebab suap membuat buta mata orang-orang bijaksana dan memutarbalikkan perkataan orang-orang yang benar."
 },
 {
   "id": 5364,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 20,
   "firman": "Semata-mata keadilan, itulah yang harus kaukejar, supaya engkau hidup dan memiliki negeri yang diberikan kepadamu oleh TUHAN, Allahmu.\""
 },
 {
   "id": 5365,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 21,
   "firman": "\"Janganlah engkau menanam sesuatu pohon sebagai tiang berhala di samping mezbah TUHAN, Allahmu, mezbah yang akan kaubuat bagimu."
 },
 {
   "id": 5366,
   "kitab": "Ula",
   "pasal": 16,
   "ayat": 22,
   "firman": "Janganlah juga kaudirikan bagimu tugu berhala, yang dibenci oleh TUHAN, Allahmu."
 },
 {
   "id": 5367,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 1,
   "firman": "Janganlah engkau mempersembahkan bagi TUHAN, Allahmu, lembu atau domba, yang ada cacatnya, atau sesuatu yang buruk; sebab yang demikian adalah kekejian bagi TUHAN, Allahmu.\""
 },
 {
   "id": 5368,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 2,
   "firman": "\"Apabila di tengah-tengahmu di salah satu tempatmu yang diberikan kepadamu oleh TUHAN, Allahmu, ada terdapat seorang laki-laki atau perempuan yang melakukan apa yang jahat di mata TUHAN, Allahmu, dengan melangkahi perjanjian-Nya,"
 },
 {
   "id": 5369,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 3,
   "firman": "dan yang pergi beribadah kepada allah lain dan sujud menyembah kepadanya, atau kepada matahari atau bulan atau segenap tentara langit, hal yang telah Kularang itu;"
 },
 {
   "id": 5370,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 4,
   "firman": "dan apabila hal itu diberitahukan atau terdengar kepadamu, maka engkau harus memeriksanya baik-baik. Jikalau ternyata benar dan sudah pasti, bahwa kekejian itu dilakukan di antara orang Israel,"
 },
 {
   "id": 5371,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 5,
   "firman": "maka engkau harus membawa laki-laki atau perempuan yang telah melakukan perbuatan jahat itu ke luar ke pintu gerbang, kemudian laki-laki atau perempuan itu harus kaulempari dengan batu sampai mati."
 },
 {
   "id": 5372,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 6,
   "firman": "Atas keterangan dua atau tiga orang saksi haruslah mati dibunuh orang yang dihukum mati; atas keterangan satu orang saksi saja janganlah ia dihukum mati."
 },
 {
   "id": 5373,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 7,
   "firman": "Saksi-saksi itulah yang pertama-tama menggerakkan tangan mereka untuk membunuh dia, kemudian seluruh rakyat. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu.\""
 },
 {
   "id": 5374,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 8,
   "firman": "\"Apabila sesuatu perkara terlalu sukar bagimu untuk diputuskan, misalnya bunuh-membunuh, tuntut-menuntut, atau luka-melukai--perkara pendakwaan di dalam tempatmu--maka haruslah engkau pergi menghadap ke tempat yang akan dipilih TUHAN, Allahmu;"
 },
 {
   "id": 5375,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 9,
   "firman": "haruslah engkau pergi kepada imam-imam orang Lewi dan kepada hakim yang ada pada waktu itu, dan meminta putusan. Mereka akan memberitahukan kepadamu keputusan hakim."
 },
 {
   "id": 5376,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 10,
   "firman": "Dan engkau harus berbuat menurut keputusan yang diberitahukan mereka kepadamu dari tempat yang akan dipilih TUHAN; engkau harus melakukan dengan setia segala yang ditunjukkan mereka kepadamu."
 },
 {
   "id": 5377,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 11,
   "firman": "Menurut petunjuk yang diberikan mereka kepadamu dan menurut keputusan yang dikatakan mereka kepadamu haruslah engkau berbuat; janganlah engkau menyimpang ke kanan atau ke kiri dari keputusan yang diberitahukan mereka kepadamu."
 },
 {
   "id": 5378,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 12,
   "firman": "Orang yang berlaku terlalu berani dengan tidak mendengarkan perkataan imam yang berdiri di sana sebagai pelayan TUHAN, Allahmu, ataupun perkataan hakim, maka orang itu harus mati. Demikianlah harus kauhapuskan yang jahat itu dari antara orang Israel."
 },
 {
   "id": 5379,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 13,
   "firman": "Maka seluruh bangsa itu akan mendengar dan menjadi takut dan tidak lagi berlaku terlalu berani.\""
 },
 {
   "id": 5380,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 14,
   "firman": "\"Apabila engkau telah masuk ke negeri yang diberikan kepadamu oleh TUHAN, Allahmu, dan telah mendudukinya dan diam di sana, kemudian engkau berkata: Aku mau mengangkat raja atasku, seperti segala bangsa yang di sekelilingku,"
 },
 {
   "id": 5381,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 15,
   "firman": "maka hanyalah raja yang dipilih TUHAN, Allahmu, yang harus kauangkat atasmu. Dari tengah-tengah saudara-saudaramu haruslah engkau mengangkat seorang raja atasmu; seorang asing yang bukan saudaramu tidaklah boleh kauangkat atasmu."
 },
 {
   "id": 5382,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 16,
   "firman": "Hanya, janganlah ia memelihara banyak kuda dan janganlah ia mengembalikan bangsa ini ke Mesir untuk mendapat banyak kuda, sebab TUHAN telah berfirman kepadamu: Janganlah sekali-kali kamu kembali melalui jalan ini lagi."
 },
 {
   "id": 5383,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 17,
   "firman": "Juga janganlah ia mempunyai banyak isteri, supaya hatinya jangan menyimpang; emas dan perakpun janganlah ia kumpulkan terlalu banyak."
 },
 {
   "id": 5384,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 18,
   "firman": "Apabila ia duduk di atas takhta kerajaan, maka haruslah ia menyuruh menulis baginya salinan hukum ini menurut kitab yang ada pada imam-imam orang Lewi."
 },
 {
   "id": 5385,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 19,
   "firman": "Itulah yang harus ada di sampingnya dan haruslah ia membacanya seumur hidupnya untuk belajar takut akan TUHAN, Allahnya, dengan berpegang pada segala isi hukum dan ketetapan ini untuk dilakukannya,"
 },
 {
   "id": 5386,
   "kitab": "Ula",
   "pasal": 17,
   "ayat": 20,
   "firman": "supaya jangan ia tinggi hati terhadap saudara-saudaranya, supaya jangan ia menyimpang dari perintah itu ke kanan atau ke kiri, agar lama ia memerintah, ia dan anak-anaknya di tengah-tengah orang Israel.\""
 },
 {
   "id": 5387,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 1,
   "firman": "\"Imam-imam orang Lewi, seluruh suku Lewi, janganlah mendapat bagian milik pusaka bersama-sama orang Israel; dari korban api-apian kepada TUHAN dan apa yang menjadi milik-Nya harus mereka mendapat rezeki."
 },
 {
   "id": 5388,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 2,
   "firman": "Janganlah ia mempunyai milik pusaka di tengah-tengah saudara-saudaranya; Tuhanlah milik pusakanya, seperti yang dijanjikan-Nya kepadanya."
 },
 {
   "id": 5389,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 3,
   "firman": "Inilah hak imam terhadap kaum awam, terhadap mereka yang mempersembahkan korban sembelihan, baik lembu maupun domba: kepada imam haruslah diberikan paha depan, kedua rahang dan perut besar."
 },
 {
   "id": 5390,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 4,
   "firman": "Hasil pertama dari gandummu, dari anggurmu dan minyakmu, dan bulu guntingan pertama dari dombamu haruslah kauberikan kepadanya."
 },
 {
   "id": 5391,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 5,
   "firman": "Sebab dialah yang dipilih oleh TUHAN, Allahmu, dari segala sukumu, supaya ia senantiasa melayani TUHAN dan menyelenggarakan kebaktian demi nama-Nya, ia dan anak-anaknya."
 },
 {
   "id": 5392,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 6,
   "firman": "Apabila seorang Lewi datang dari tempat manapun di Israel, di mana ia tinggal sebagai pendatang, dan dengan sepenuh hati masuk ke tempat yang akan dipilih TUHAN,"
 },
 {
   "id": 5393,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 7,
   "firman": "dan menyelenggarakan kebaktian demi nama TUHAN, Allahnya, sama seperti semua saudaranya, orang-orang Lewi, yang melayani TUHAN di sana,"
 },
 {
   "id": 5394,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 8,
   "firman": "maka haruslah mereka mendapat rezeki yang sama, dengan tidak terhitung apa yang ia peroleh dengan menjual harta nenek moyangnya.\""
 },
 {
   "id": 5395,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 9,
   "firman": "\"Apabila engkau sudah masuk ke negeri yang diberikan kepadamu oleh TUHAN, Allahmu, maka janganlah engkau belajar berlaku sesuai dengan kekejian yang dilakukan bangsa-bangsa itu."
 },
 {
   "id": 5396,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 10,
   "firman": "Di antaramu janganlah didapati seorangpun yang mempersembahkan anaknya laki-laki atau anaknya perempuan sebagai korban dalam api, ataupun seorang yang menjadi petenung, seorang peramal, seorang penelaah, seorang penyihir,"
 },
 {
   "id": 5397,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 11,
   "firman": "seorang pemantera, ataupun seorang yang bertanya kepada arwah atau kepada roh peramal atau yang meminta petunjuk kepada orang-orang mati."
 },
 {
   "id": 5398,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 12,
   "firman": "Sebab setiap orang yang melakukan hal-hal ini adalah kekejian bagi TUHAN, dan oleh karena kekejian-kekejian inilah TUHAN, Allahmu, menghalau mereka dari hadapanmu."
 },
 {
   "id": 5399,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 13,
   "firman": "Haruslah engkau hidup dengan tidak bercela di hadapan TUHAN, Allahmu."
 },
 {
   "id": 5400,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 14,
   "firman": "Sebab bangsa-bangsa yang daerahnya akan kaududuki ini mendengarkan kepada peramal atau petenung, tetapi engkau ini tidak diizinkan TUHAN, Allahmu, melakukan yang demikian."
 },
 {
   "id": 5401,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 15,
   "firman": "Seorang nabi dari tengah-tengahmu, dari antara saudara-saudaramu, sama seperti aku, akan dibangkitkan bagimu oleh TUHAN, Allahmu; dialah yang harus kamu dengarkan."
 },
 {
   "id": 5402,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 16,
   "firman": "Tepat seperti yang kamu minta dahulu kepada TUHAN, Allahmu, di gunung Horeb, pada hari perkumpulan, dengan berkata: Tidak mau aku mendengar lagi suara TUHAN, Allahku, dan api yang besar ini tidak mau aku melihatnya lagi, supaya jangan aku mati."
 },
 {
   "id": 5403,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 17,
   "firman": "Lalu berkatalah TUHAN kepadaku: Apa yang dikatakan mereka itu baik;"
 },
 {
   "id": 5404,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 18,
   "firman": "seorang nabi akan Kubangkitkan bagi mereka dari antara saudara mereka, seperti engkau ini; Aku akan menaruh firman-Ku dalam mulutnya, dan ia akan mengatakan kepada mereka segala yang Kuperintahkan kepadanya."
 },
 {
   "id": 5405,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 19,
   "firman": "Orang yang tidak mendengarkan segala firman-Ku yang akan diucapkan nabi itu demi nama-Ku, dari padanya akan Kutuntut pertanggungjawaban."
 },
 {
   "id": 5406,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 20,
   "firman": "Tetapi seorang nabi, yang terlalu berani untuk mengucapkan demi nama-Ku perkataan yang tidak Kuperintahkan untuk dikatakan olehnya, atau yang berkata demi nama allah lain, nabi itu harus mati."
 },
 {
   "id": 5407,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 21,
   "firman": "Jika sekiranya kamu berkata dalam hatimu: Bagaimanakah kami mengetahui perkataan yang tidak difirmankan TUHAN? --"
 },
 {
   "id": 5408,
   "kitab": "Ula",
   "pasal": 18,
   "ayat": 22,
   "firman": "apabila seorang nabi berkata demi nama TUHAN dan perkataannya itu tidak terjadi dan tidak sampai, maka itulah perkataan yang tidak difirmankan TUHAN; dengan terlalu berani nabi itu telah mengatakannya, maka janganlah gentar kepadanya.\""
 },
 {
   "id": 5409,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 1,
   "firman": "\"Apabila TUHAN, Allahmu, sudah melenyapkan bangsa-bangsa yang negerinya diberikan kepadamu oleh TUHAN, Allahmu, dan engkau sudah menduduki daerah mereka dan diam di kota-kota dan rumah-rumah mereka,"
 },
 {
   "id": 5410,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 2,
   "firman": "maka engkau harus mengkhususkan tiga kota di dalam negeri yang diberikan TUHAN, Allahmu, kepadamu untuk diduduki."
 },
 {
   "id": 5411,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 3,
   "firman": "Engkau harus menetapkan jauhnya jalan, dan membagi dalam tiga bagian wilayah negeri yang diberikan TUHAN, Allahmu, untuk dimiliki olehmu, supaya setiap pembunuh dapat melarikan diri ke sana."
 },
 {
   "id": 5412,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 4,
   "firman": "Inilah ketentuan mengenai pembunuh yang melarikan diri ke sana dan boleh tinggal hidup: apabila ia membunuh sesamanya manusia dengan tidak sengaja dan dengan tidak membenci dia sebelumnya,"
 },
 {
   "id": 5413,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 5,
   "firman": "misalnya apabila seseorang pergi ke hutan dengan temannya untuk membelah kayu, ketika tangannya mengayunkan kapak untuk menebang pohon kayu, mata kapak terlucut dari gagangnya, lalu mengenai temannya sehingga mati, maka ia boleh melarikan diri ke salah satu kota itu dan tinggal hidup."
 },
 {
   "id": 5414,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 6,
   "firman": "Maksudnya supaya jangan penuntut tebusan darah sementara hatinya panas dapat mengejar pembunuh itu, karena jauhnya perjalanan, menangkapnya dan membunuhnya, padahal pembunuh itu tidak patut mendapat hukuman mati, karena ia tidak membenci dia sebelumnya."
 },
 {
   "id": 5415,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 7,
   "firman": "Itulah sebabnya aku memberi perintah kepadamu, demikian: tiga kota haruslah kaukhususkan."
 },
 {
   "id": 5416,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 8,
   "firman": "Dan jika TUHAN, Allahmu, sudah meluaskan daerahmu nanti, seperti yang dijanjikan-Nya dengan sumpah kepada nenek moyangmu, dan sudah memberikan kepadamu seluruh negeri yang dikatakan-Nya akan diberikan kepada nenek moyangmu,"
 },
 {
   "id": 5417,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 9,
   "firman": "--apabila engkau melakukan dengan setia perintah ini, yang kusampaikan kepadamu pada hari ini, dengan mengasihi TUHAN, Allahmu, dan dengan senantiasa hidup menurut jalan yang ditunjukkan-Nya--maka haruslah engkau menambah tiga kota lagi kepada yang tiga itu,"
 },
 {
   "id": 5418,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 10,
   "firman": "supaya jangan tercurah darah orang yang tidak bersalah di negeri yang diberikan TUHAN, Allahmu, kepadamu menjadi milikmu dan hutang darah melekat kepadamu."
 },
 {
   "id": 5419,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 11,
   "firman": "Tetapi apabila seseorang membenci sesamanya manusia, dan dengan bersembunyi menantikan dia, lalu bangun menyerang dan memukul dia, sehingga mati, kemudian melarikan diri ke salah satu kota itu,"
 },
 {
   "id": 5420,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 12,
   "firman": "maka haruslah para tua-tua kotanya menyuruh mengambil dia dari sana dan menyerahkan dia kepada penuntut tebusan darah, supaya ia mati dibunuh."
 },
 {
   "id": 5421,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 13,
   "firman": "Janganlah engkau merasa sayang kepadanya. Demikianlah harus kauhapuskan darah orang yang tidak bersalah dari antara orang Israel, supaya baik keadaanmu.\""
 },
 {
   "id": 5422,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 14,
   "firman": "\"Janganlah menggeser batas tanah sesamamu yang telah ditetapkan oleh orang-orang dahulu di dalam milik pusaka yang akan kaumiliki di negeri yang diberikan TUHAN, Allahmu, kepadamu untuk menjadi milikmu.\""
 },
 {
   "id": 5423,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 15,
   "firman": "\"Satu orang saksi saja tidak dapat menggugat seseorang mengenai perkara kesalahan apapun atau dosa apapun yang mungkin dilakukannya; baru atas keterangan dua atau tiga orang saksi perkara itu tidak disangsikan."
 },
 {
   "id": 5424,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 16,
   "firman": "Apabila seorang saksi jahat menggugat seseorang untuk menuduh dia mengenai suatu pelanggaran,"
 },
 {
   "id": 5425,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 17,
   "firman": "maka kedua orang yang mempunyai perkara itu haruslah berdiri di hadapan TUHAN, di hadapan imam-imam dan hakim-hakim yang ada pada waktu itu."
 },
 {
   "id": 5426,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 18,
   "firman": "Maka hakim-hakim itu harus memeriksanya baik-baik, dan apabila ternyata, bahwa saksi itu seorang saksi dusta dan bahwa ia telah memberi tuduhan dusta terhadap saudaranya,"
 },
 {
   "id": 5427,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 19,
   "firman": "maka kamu harus memperlakukannya sebagaimana ia bermaksud memperlakukan saudaranya. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu."
 },
 {
   "id": 5428,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 20,
   "firman": "Maka orang-orang lain akan mendengar dan menjadi takut, sehingga mereka tidak akan melakukan lagi perbuatan jahat seperti itu di tengah-tengahmu."
 },
 {
   "id": 5429,
   "kitab": "Ula",
   "pasal": 19,
   "ayat": 21,
   "firman": "Janganlah engkau merasa sayang kepadanya, sebab berlaku: nyawa ganti nyawa, mata ganti mata, gigi ganti gigi, tangan ganti tangan, kaki ganti kaki.\""
 },
 {
   "id": 5430,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 1,
   "firman": "\"Apabila engkau keluar berperang melawan musuhmu, dan engkau melihat kuda dan kereta, yakni tentara yang lebih banyak dari padamu, maka janganlah engkau takut kepadanya, sebab TUHAN, Allahmu, yang telah menuntun engkau keluar dari tanah Mesir, menyertai engkau."
 },
 {
   "id": 5431,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 2,
   "firman": "Apabila kamu menghadapi pertempuran, maka seorang imam harus tampil ke depan dan berbicara kepada rakyat,"
 },
 {
   "id": 5432,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 3,
   "firman": "dengan berkata kepada mereka: Dengarlah, hai orang Israel! Kamu sekarang menghadapi pertempuran melawan musuhmu; janganlah lemah hatimu, janganlah takut, janganlah gentar dan janganlah gemetar karena mereka,"
 },
 {
   "id": 5433,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 4,
   "firman": "sebab TUHAN, Allahmu, Dialah yang berjalan menyertai kamu untuk berperang bagimu melawan musuhmu, dengan maksud memberikan kemenangan kepadamu."
 },
 {
   "id": 5434,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 5,
   "firman": "Para pengatur pasukan haruslah berbicara kepada tentara, demikian: Siapakah orang yang telah mendirikan rumah baru, tetapi belum menempatinya? Ia boleh pergi dan pulang ke rumahnya, supaya jangan ia mati dalam pertempuran dan orang lain yang menempatinya."
 },
 {
   "id": 5435,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 6,
   "firman": "Dan siapa telah membuat kebun anggur, tetapi belum mengecap hasilnya? Ia boleh pergi dan pulang ke rumahnya, supaya jangan ia mati dalam pertempuran dan orang lain yang mengecap hasilnya."
 },
 {
   "id": 5436,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 7,
   "firman": "Dan siapa telah bertunangan dengan seorang perempuan, tetapi belum mengawininya? Ia boleh pergi dan pulang ke rumahnya, supaya jangan ia mati dalam pertempuran dan orang lain yang mengawininya."
 },
 {
   "id": 5437,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 8,
   "firman": "Lagi para pengatur pasukan itu harus berbicara kepada tentara demikian: Siapa takut dan lemah hati? Ia boleh pergi dan pulang ke rumahnya, supaya hati saudara-saudaranya jangan tawar seperti hatinya."
 },
 {
   "id": 5438,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 9,
   "firman": "Apabila para pengatur pasukan selesai berbicara kepada tentara, maka haruslah ditunjuk kepala-kepala pasukan untuk mengepalai tentara."
 },
 {
   "id": 5439,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 10,
   "firman": "Apabila engkau mendekati suatu kota untuk berperang melawannya, maka haruslah engkau menawarkan perdamaian kepadanya."
 },
 {
   "id": 5440,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 11,
   "firman": "Apabila kota itu menerima tawaran perdamaian itu dan dibukanya pintu gerbang bagimu, maka haruslah semua orang yang terdapat di situ melakukan pekerjaan rodi bagimu dan menjadi hamba kepadamu."
 },
 {
   "id": 5441,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 12,
   "firman": "Tetapi apabila kota itu tidak mau berdamai dengan engkau, melainkan mengadakan pertempuran melawan engkau, maka haruslah engkau mengepungnya;"
 },
 {
   "id": 5442,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 13,
   "firman": "dan setelah TUHAN, Allahmu, menyerahkannya ke dalam tanganmu, maka haruslah engkau membunuh seluruh penduduknya yang laki-laki dengan mata pedang."
 },
 {
   "id": 5443,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 14,
   "firman": "Hanya perempuan, anak-anak, hewan dan segala yang ada di kota itu, yakni seluruh jarahan itu, boleh kaurampas bagimu sendiri, dan jarahan yang dari musuhmu ini, yang diberikan kepadamu oleh TUHAN, Allahmu, boleh kaupergunakan."
 },
 {
   "id": 5444,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 15,
   "firman": "Demikianlah harus kaulakukan terhadap segala kota yang sangat jauh letaknya dari tempatmu, yang tidak termasuk kota-kota bangsa-bangsa di sini."
 },
 {
   "id": 5445,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 16,
   "firman": "Tetapi dari kota-kota bangsa-bangsa itu yang diberikan TUHAN, Allahmu, kepadamu menjadi milik pusakamu, janganlah kaubiarkan hidup apapun yang bernafas,"
 },
 {
   "id": 5446,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 17,
   "firman": "melainkan kautumpas sama sekali, yakni orang Het, orang Amori, orang Kanaan, orang Feris, orang Hewi, dan orang Yebus, seperti yang diperintahkan kepadamu oleh TUHAN, Allahmu,"
 },
 {
   "id": 5447,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 18,
   "firman": "supaya mereka jangan mengajar kamu berbuat sesuai dengan segala kekejian, yang dilakukan mereka bagi allah mereka, sehingga kamu berbuat dosa kepada TUHAN, Allahmu."
 },
 {
   "id": 5448,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 19,
   "firman": "Apabila dalam memerangi suatu kota, engkau lama mengepungnya untuk direbut, maka tidak boleh engkau merusakkan pohon-pohon sekelilingnya dengan mengayunkan kapak kepadanya; buahnya boleh kaumakan, tetapi batangnya janganlah kautebang; sebab, pohon yang di padang itu bukan manusia, jadi tidak patut ikut kaukepung."
 },
 {
   "id": 5449,
   "kitab": "Ula",
   "pasal": 20,
   "ayat": 20,
   "firman": "Hanya pohon-pohon, yang engkau tahu tidak menghasilkan makanan, boleh kaurusakkan dan kautebang untuk mendirikan pagar pengepungan terhadap kota yang berperang melawan engkau, sampai kota itu jatuh.\""
 },
 {
   "id": 5450,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 1,
   "firman": "\"Apabila di tanah yang diberikan TUHAN, Allahmu, kepadamu untuk menjadi milikmu, terdapat seorang yang mati terbunuh di padang, dengan tidak diketahui siapa yang membunuhnya,"
 },
 {
   "id": 5451,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 2,
   "firman": "maka haruslah para tua-tuamu dan para hakimmu keluar mengukur jarak ke kota-kota yang di sekeliling orang yang terbunuh itu."
 },
 {
   "id": 5452,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 3,
   "firman": "Kota yang ternyata paling dekat dengan tempat orang yang terbunuh itu, para tua-tua kota itulah harus mengambil seekor lembu betina yang muda, yang belum pernah dipakai, yang belum pernah menghela dengan kuk."
 },
 {
   "id": 5453,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 4,
   "firman": "Para tua-tua kota itu haruslah membawa lembu muda itu ke suatu lembah yang selalu berair dan yang belum pernah dikerjakan atau ditaburi, dan di sana di lembah itu haruslah mereka mematahkan batang leher lembu muda itu."
 },
 {
   "id": 5454,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 5,
   "firman": "Imam-imam bani Lewi haruslah tampil ke depan, sebab merekalah yang dipilih TUHAN, Allahmu, untuk melayani Dia dan untuk memberi berkat demi nama TUHAN; menurut putusan merekalah setiap perkara dan setiap hal luka-melukai harus diselesaikan."
 },
 {
   "id": 5455,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 6,
   "firman": "Dan semua tua-tua dari kota yang paling dekat dengan tempat orang yang terbunuh itu, haruslah membasuh tangannya di atas lembu muda yang batang lehernya dipatahkan di lembah itu,"
 },
 {
   "id": 5456,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 7,
   "firman": "dan mereka harus memberi pernyataan dengan mengatakan: Tangan kami tidak mencurahkan darah ini dan mata kami tidak melihatnya."
 },
 {
   "id": 5457,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 8,
   "firman": "Adakanlah pendamaian bagi umat-Mu Israel yang telah Kautebus itu, TUHAN, dan janganlah timpakan darah orang yang tidak bersalah ke tengah-tengah umat-Mu Israel. Maka karena darah itu telah diadakan pendamaian bagi mereka."
 },
 {
   "id": 5458,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 9,
   "firman": "Demikianlah engkau harus menghapuskan darah orang yang tidak bersalah itu dari tengah-tengahmu, sebab dengan demikian engkau melakukan apa yang benar di mata TUHAN.\""
 },
 {
   "id": 5459,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 10,
   "firman": "\"Apabila engkau keluar berperang melawan musuhmu, dan TUHAN, Allahmu, menyerahkan mereka ke dalam tanganmu dan engkau menjadikan mereka tawanan,"
 },
 {
   "id": 5460,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 11,
   "firman": "dan engkau melihat di antara tawanan itu seorang perempuan yang elok, sehingga hatimu mengingini dia dan engkau mau mengambil dia menjadi isterimu,"
 },
 {
   "id": 5461,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 12,
   "firman": "maka haruslah engkau membawa dia ke dalam rumahmu. Perempuan itu harus mencukur rambutnya, memotong kukunya,"
 },
 {
   "id": 5462,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 13,
   "firman": "menanggalkan pakaian yang dipakainya pada waktu ditawan, dan tinggal di rumahmu untuk menangisi ibu bapanya sebulan lamanya. Sesudah demikian, bolehlah engkau menghampiri dia dan menjadi suaminya, sehingga ia menjadi isterimu."
 },
 {
   "id": 5463,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 14,
   "firman": "Apabila engkau tidak suka lagi kepadanya, maka haruslah engkau membiarkan dia pergi sesuka hatinya; tidak boleh sekali-kali engkau menjual dia dengan bayaran uang; tidak boleh engkau memperlakukan dia sebagai budak, sebab engkau telah memaksa dia.\""
 },
 {
   "id": 5464,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 15,
   "firman": "\"Apabila seorang mempunyai dua orang isteri, yang seorang dicintai dan yang lain tidak dicintainya, dan mereka melahirkan anak-anak lelaki baginya, baik isteri yang dicintai maupun isteri yang tidak dicintai, dan anak sulung adalah dari isteri yang tidak dicintai,"
 },
 {
   "id": 5465,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 16,
   "firman": "maka pada waktu ia membagi warisan harta kepunyaannya kepada anak-anaknya itu, tidaklah boleh ia memberikan bagian anak sulung kepada anak dari isteri yang dicintai merugikan anak dari isteri yang tidak dicintai, yang adalah anak sulung."
 },
 {
   "id": 5466,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 17,
   "firman": "Tetapi ia harus mengakui anak yang sulung, anak dari isteri yang tidak dicintai itu, dengan memberikan kepadanya dua bagian dari segala kepunyaannya, sebab dialah kegagahannya yang pertama-tama: dialah yang empunya hak kesulungan.\""
 },
 {
   "id": 5467,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 18,
   "firman": "\"Apabila seseorang mempunyai anak laki-laki yang degil dan membangkang, yang tidak mau mendengarkan perkataan ayahnya dan ibunya, dan walaupun mereka menghajar dia, tidak juga ia mendengarkan mereka,"
 },
 {
   "id": 5468,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 19,
   "firman": "maka haruslah ayahnya dan ibunya memegang dia dan membawa dia keluar kepada para tua-tua kotanya di pintu gerbang tempat kediamannya,"
 },
 {
   "id": 5469,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 20,
   "firman": "dan harus berkata kepada para tua-tua kotanya: Anak kami ini degil dan membangkang, ia tidak mau mendengarkan perkataan kami, ia seorang pelahap dan peminum."
 },
 {
   "id": 5470,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 21,
   "firman": "Maka haruslah semua orang sekotanya melempari anak itu dengan batu, sehingga ia mati. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu; dan seluruh orang Israel akan mendengar dan menjadi takut.\""
 },
 {
   "id": 5471,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 22,
   "firman": "\"Apabila seseorang berbuat dosa yang sepadan dengan hukuman mati, lalu ia dihukum mati, kemudian kaugantung dia pada sebuah tiang,"
 },
 {
   "id": 5472,
   "kitab": "Ula",
   "pasal": 21,
   "ayat": 23,
   "firman": "maka janganlah mayatnya dibiarkan semalam-malaman pada tiang itu, tetapi haruslah engkau menguburkan dia pada hari itu juga, sebab seorang yang digantung terkutuk oleh Allah; janganlah engkau menajiskan tanah yang diberikan TUHAN, Allahmu, kepadamu menjadi milik pusakamu.\""
 },
 {
   "id": 5473,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 1,
   "firman": "\"Apabila engkau melihat, bahwa lembu atau domba saudaramu tersesat, janganlah engkau pura-pura tidak tahu; haruslah engkau benar-benar mengembalikannya kepada saudaramu itu."
 },
 {
   "id": 5474,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 2,
   "firman": "Dan apabila saudaramu itu tidak tinggal dekat denganmu dan engkau tidak mengenalnya, maka haruslah engkau membawa hewan itu ke dalam rumahmu dan haruslah itu tinggal padamu, sampai saudaramu itu datang mencarinya; engkau harus mengembalikannya kepadanya."
 },
 {
   "id": 5475,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 3,
   "firman": "Demikianlah harus kauperbuat dengan keledainya, demikianlah kauperbuat dengan pakaiannya, demikianlah kauperbuat dengan setiap barang yang hilang dari saudaramu dan yang kautemui; tidak boleh engkau pura-pura tidak tahu."
 },
 {
   "id": 5476,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 4,
   "firman": "Apabila engkau melihat keledai saudaramu atau lembunya rebah di jalan, janganlah engkau pura-pura tidak tahu; engkau harus benar-benar menolong membangunkannya bersama-sama dengan saudaramu itu.\""
 },
 {
   "id": 5477,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 5,
   "firman": "\"Seorang perempuan janganlah memakai pakaian laki-laki dan seorang laki-laki janganlah mengenakan pakaian perempuan, sebab setiap orang yang melakukan hal ini adalah kekejian bagi TUHAN, Allahmu."
 },
 {
   "id": 5478,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 6,
   "firman": "Apabila engkau menemui di jalan sarang burung di salah satu pohon atau di tanah dengan anak-anak burung atau telur-telur di dalamnya, dan induknya sedang duduk mendekap anak-anak atau telur-telur itu, maka janganlah engkau mengambil induk itu bersama-sama dengan anak-anaknya."
 },
 {
   "id": 5479,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 7,
   "firman": "Setidak-tidaknya induk itu haruslah kaulepaskan, tetapi anak-anaknya boleh kauambil. Maksudnya supaya baik keadaanmu dan lanjut umurmu."
 },
 {
   "id": 5480,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 8,
   "firman": "Apabila engkau mendirikan rumah yang baru, maka haruslah engkau memagari sotoh rumahmu, supaya jangan kaudatangkan hutang darah kepada rumahmu itu, apabila ada seorang jatuh dari atasnya."
 },
 {
   "id": 5481,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 9,
   "firman": "Janganlah kautaburi kebun anggurmu dengan dua jenis benih, supaya seluruh hasil benih yang kautaburkan dan hasil kebun anggurmu jangan menjadi milik tempat kudus."
 },
 {
   "id": 5482,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 10,
   "firman": "Janganlah engkau membajak dengan lembu dan keledai bersama-sama."
 },
 {
   "id": 5483,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 11,
   "firman": "Janganlah engkau memakai pakaian yang dua jenis bahannya, yakni bulu domba dan lenan bersama-sama."
 },
 {
   "id": 5484,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 12,
   "firman": "Haruslah engkau membuat tali yang terpilin pada keempat punca kain penutup tubuhmu.\""
 },
 {
   "id": 5485,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 13,
   "firman": "\"Apabila seseorang mengambil isteri dan setelah menghampiri perempuan itu, menjadi benci kepadanya,"
 },
 {
   "id": 5486,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 14,
   "firman": "menuduhkan kepadanya perbuatan yang kurang senonoh dan membusukkan namanya dengan berkata: Perempuan ini kuambil menjadi isteriku, tetapi ketika ia kuhampiri, tidak ada kudapati padanya tanda-tanda keperawanan--"
 },
 {
   "id": 5487,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 15,
   "firman": "maka haruslah ayah dan ibu gadis itu memperlihatkan tanda-tanda keperawanan gadis itu kepada para tua-tua kota di pintu gerbang."
 },
 {
   "id": 5488,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 16,
   "firman": "Dan ayah si gadis haruslah berkata kepada para tua-tua itu: Aku telah memberikan anakku kepada laki-laki ini menjadi isterinya, lalu ia menjadi benci kepadanya,"
 },
 {
   "id": 5489,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 17,
   "firman": "dan ketahuilah, ia menuduhkan perbuatan yang kurang senonoh dengan berkata: Tidak ada kudapati tanda-tanda keperawanan pada anakmu. Tetapi inilah tanda-tanda keperawanan anakku itu. Lalu haruslah mereka membentangkan kain itu di depan para tua-tua kota."
 },
 {
   "id": 5490,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 18,
   "firman": "Maka haruslah para tua-tua kota itu mengambil laki-laki itu, menghajar dia,"
 },
 {
   "id": 5491,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 19,
   "firman": "mendenda dia seratus syikal perak dan memberikan perak itu kepada ayah si gadis--karena laki-laki itu telah membusukkan nama seorang perawan Israel. Perempuan itu haruslah tetap menjadi isterinya; selama hidupnya tidak boleh laki-laki itu menyuruh dia pergi."
 },
 {
   "id": 5492,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 20,
   "firman": "Tetapi jika tuduhan itu benar dan tidak didapati tanda-tanda keperawanan pada si gadis,"
 },
 {
   "id": 5493,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 21,
   "firman": "maka haruslah si gadis dibawa ke luar ke depan pintu rumah ayahnya, dan orang-orang sekotanya haruslah melempari dia dengan batu, sehingga mati--sebab dia telah menodai orang Israel dengan bersundal di rumah ayahnya. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu."
 },
 {
   "id": 5494,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 22,
   "firman": "Apabila seseorang kedapatan tidur dengan seorang perempuan yang bersuami, maka haruslah keduanya dibunuh mati: laki-laki yang telah tidur dengan perempuan itu dan perempuan itu juga. Demikianlah harus kauhapuskan yang jahat itu dari antara orang Israel."
 },
 {
   "id": 5495,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 23,
   "firman": "Apabila ada seorang gadis yang masih perawan dan yang sudah bertunangan--jika seorang laki-laki bertemu dengan dia di kota dan tidur dengan dia,"
 },
 {
   "id": 5496,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 24,
   "firman": "maka haruslah mereka keduanya kamu bawa ke luar ke pintu gerbang kota dan kamu lempari dengan batu, sehingga mati: gadis itu, karena walaupun di kota, ia tidak berteriak-teriak, dan laki-laki itu, karena ia telah memperkosa isteri sesamanya manusia. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu."
 },
 {
   "id": 5497,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 25,
   "firman": "Tetapi jikalau di padang laki-laki itu bertemu dengan gadis yang telah bertunangan itu, memaksa gadis itu tidur dengan dia, maka hanyalah laki-laki yang tidur dengan gadis itu yang harus mati,"
 },
 {
   "id": 5498,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 26,
   "firman": "tetapi gadis itu janganlah kauapa-apakan. Gadis itu tidak ada dosanya yang sepadan dengan hukuman mati, sebab perkara ini sama dengan perkara seseorang yang menyerang sesamanya manusia dan membunuhnya."
 },
 {
   "id": 5499,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 27,
   "firman": "Sebab laki-laki itu bertemu dengan dia di padang; walaupun gadis yang bertunangan itu berteriak-teriak, tetapi tidak ada yang datang menolongnya."
 },
 {
   "id": 5500,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 28,
   "firman": "Apabila seseorang bertemu dengan seorang gadis, yang masih perawan dan belum bertunangan, memaksa gadis itu tidur dengan dia, dan keduanya kedapatan--"
 },
 {
   "id": 5501,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 29,
   "firman": "maka haruslah laki-laki yang sudah tidur dengan gadis itu memberikan lima puluh syikal perak kepada ayah gadis itu, dan gadis itu haruslah menjadi isterinya, sebab laki-laki itu telah memperkosa dia; selama hidupnya tidak boleh laki-laki itu menyuruh dia pergi."
 },
 {
   "id": 5502,
   "kitab": "Ula",
   "pasal": 22,
   "ayat": 30,
   "firman": "Seorang laki-laki janganlah mengambil isteri ayahnya dan jangan menyingkapkan punca kain ayahnya.\""
 },
 {
   "id": 5503,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 1,
   "firman": "\"Orang yang hancur buah pelirnya atau yang terpotong kemaluannya, janganlah masuk jemaah TUHAN."
 },
 {
   "id": 5504,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 2,
   "firman": "Seorang anak haram janganlah masuk jemaah TUHAN, bahkan keturunannya yang kesepuluhpun tidak boleh masuk jemaah TUHAN."
 },
 {
   "id": 5505,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 3,
   "firman": "Seorang Amon atau seorang Moab janganlah masuk jemaah TUHAN, bahkan keturunannya yang kesepuluhpun tidak boleh masuk jemaah TUHAN sampai selama-lamanya,"
 },
 {
   "id": 5506,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 4,
   "firman": "karena mereka tidak menyongsong kamu dengan roti dan air pada waktu perjalananmu keluar dari Mesir, dan karena mereka mengupah Bileam bin Beor dari Petor di Aram-Mesopotamia melawan engkau, supaya dikutukinya engkau."
 },
 {
   "id": 5507,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 5,
   "firman": "Tetapi TUHAN, Allahmu, tidak mau mendengarkan Bileam dan TUHAN, Allahmu, telah mengubah kutuk itu menjadi berkat bagimu, karena TUHAN, Allahmu, mengasihi engkau."
 },
 {
   "id": 5508,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 6,
   "firman": "Selama engkau hidup, janganlah engkau mengikhtiarkan kesejahteraan dan kebahagiaan mereka sampai selama-lamanya."
 },
 {
   "id": 5509,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 7,
   "firman": "Janganlah engkau menganggap keji orang Edom, sebab dia saudaramu. Janganlah engkau menganggap keji orang Mesir, sebab engkaupun dahulu adalah orang asing di negerinya."
 },
 {
   "id": 5510,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 8,
   "firman": "Anak-anak yang lahir bagi mereka dalam keturunan yang ketiga, boleh masuk jemaah TUHAN.\""
 },
 {
   "id": 5511,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 9,
   "firman": "\"Apabila engkau maju dengan tentaramu melawan musuhmu, maka haruslah engkau menjaga diri terhadap segala yang jahat."
 },
 {
   "id": 5512,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 10,
   "firman": "Apabila ada di antaramu seorang laki-laki yang tidak tahir disebabkan oleh sesuatu yang terjadi atasnya pada malam hari, maka haruslah ia pergi ke luar perkemahan, janganlah ia masuk ke dalam perkemahan."
 },
 {
   "id": 5513,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 11,
   "firman": "Kemudian menjelang senja haruslah ia mandi dengan air, dan pada waktu matahari terbenam, ia boleh masuk kembali ke dalam perkemahan."
 },
 {
   "id": 5514,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 12,
   "firman": "Di luar perkemahan itu haruslah ada bagimu suatu tempat ke mana engkau pergi untuk kada hajat."
 },
 {
   "id": 5515,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 13,
   "firman": "Di antara perlengkapanmu haruslah ada padamu sekop kecil dan apabila engkau jongkok kada hajat, haruslah engkau menggali lobang dengan itu dan menimbuni kotoranmu."
 },
 {
   "id": 5516,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 14,
   "firman": "Sebab TUHAN, Allahmu, berjalan dari tengah-tengah perkemahanmu untuk melepaskan engkau dan menyerahkan musuhmu kepadamu; sebab itu haruslah perkemahanmu itu kudus, supaya jangan Ia melihat sesuatu yang tidak senonoh di antaramu, lalu berbalik dari padamu.\""
 },
 {
   "id": 5517,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 15,
   "firman": "\"Janganlah kauserahkan kepada tuannya seorang budak yang melarikan diri dari tuannya kepadamu."
 },
 {
   "id": 5518,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 16,
   "firman": "Bersama-sama engkau ia boleh tinggal, di tengah-tengahmu, di tempat yang dipilihnya di salah satu tempatmu, yang dirasanya baik; janganlah engkau menindas dia.\""
 },
 {
   "id": 5519,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 17,
   "firman": "\"Di antara anak-anak perempuan Israel janganlah ada pelacur bakti, dan di antara anak-anak lelaki Israel janganlah ada semburit bakti."
 },
 {
   "id": 5520,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 18,
   "firman": "Janganlah kaubawa upah sundal atau uang semburit ke dalam rumah TUHAN, Allahmu, untuk menepati salah satu nazar, sebab keduanya itu adalah kekejian bagi TUHAN, Allahmu.\""
 },
 {
   "id": 5521,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 19,
   "firman": "\"Janganlah engkau membungakan kepada saudaramu, baik uang maupun bahan makanan atau apapun yang dapat dibungakan."
 },
 {
   "id": 5522,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 20,
   "firman": "Dari orang asing boleh engkau memungut bunga, tetapi dari saudaramu janganlah engkau memungut bunga--supaya TUHAN, Allahmu, memberkati engkau dalam segala usahamu di negeri yang engkau masuki untuk mendudukinya.\""
 },
 {
   "id": 5523,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 21,
   "firman": "\"Apabila engkau bernazar kepada TUHAN, Allahmu, janganlah engkau menunda-nunda memenuhinya, sebab tentulah TUHAN, Allahmu, akan menuntutnya dari padamu, sehingga hal itu menjadi dosa bagimu."
 },
 {
   "id": 5524,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 22,
   "firman": "Tetapi apabila engkau tidak bernazar, maka hal itu bukan menjadi dosa bagimu."
 },
 {
   "id": 5525,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 23,
   "firman": "Apa yang keluar dari bibirmu haruslah kaulakukan dengan setia, sebab dengan sukarela kaunazarkan kepada TUHAN, Allahmu, sesuatu yang kaukatakan dengan mulutmu sendiri.\""
 },
 {
   "id": 5526,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 24,
   "firman": "\"Apabila engkau melalui kebun anggur sesamamu, engkau boleh makan buah anggur sepuas-puas hatimu, tetapi tidak boleh kaumasukkan ke dalam bungkusanmu."
 },
 {
   "id": 5527,
   "kitab": "Ula",
   "pasal": 23,
   "ayat": 25,
   "firman": "Apabila engkau melalui ladang gandum sesamamu yang belum dituai, engkau boleh memetik bulir-bulirnya dengan tanganmu, tetapi sabit tidak boleh kauayunkan kepada gandum sesamamu itu.\""
 },
 {
   "id": 5528,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 1,
   "firman": "\"Apabila seseorang mengambil seorang perempuan dan menjadi suaminya, dan jika kemudian ia tidak menyukai lagi perempuan itu, sebab didapatinya yang tidak senonoh padanya, lalu ia menulis surat cerai dan menyerahkannya ke tangan perempuan itu, sesudah itu menyuruh dia pergi dari rumahnya,"
 },
 {
   "id": 5529,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 2,
   "firman": "dan jika perempuan itu keluar dari rumahnya dan pergi dari sana, lalu menjadi isteri orang lain,"
 },
 {
   "id": 5530,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 3,
   "firman": "dan jika laki-laki yang kemudian ini tidak cinta lagi kepadanya, lalu menulis surat cerai dan menyerahkannya ke tangan perempuan itu serta menyuruh dia pergi dari rumahnya, atau jika laki-laki yang kemudian mengambil dia menjadi isterinya itu mati,"
 },
 {
   "id": 5531,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 4,
   "firman": "maka suaminya yang pertama, yang telah menyuruh dia pergi itu, tidak boleh mengambil dia kembali menjadi isterinya, setelah perempuan itu dicemari; sebab hal itu adalah kekejian di hadapan TUHAN. Janganlah engkau mendatangkan dosa atas negeri yang diberikan TUHAN, Allahmu, kepadamu menjadi milik pusakamu."
 },
 {
   "id": 5532,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 5,
   "firman": "Apabila baru saja seseorang mengambil isteri, janganlah ia keluar bersama-sama dengan tentara maju berperang atau dibebankan sesuatu pekerjaan; satu tahun lamanya ia harus dibebaskan untuk keperluan rumah tangganya dan menyukakan hati perempuan yang telah diambilnya menjadi isterinya.\""
 },
 {
   "id": 5533,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 6,
   "firman": "\"Janganlah mengambil kilangan atau batu kilangan atas sebagai gadai, karena yang demikian itu mengambil nyawa orang sebagai gadai."
 },
 {
   "id": 5534,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 7,
   "firman": "Apabila seseorang kedapatan sedang menculik orang, salah seorang saudaranya, dari antara orang Israel, lalu memperlakukan dia sebagai budak dan menjual dia, maka haruslah penculik itu mati. Demikianlah harus kauhapuskan yang jahat itu dari tengah-tengahmu."
 },
 {
   "id": 5535,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 8,
   "firman": "Hati-hatilah dalam hal penyakit kusta dan lakukanlah dengan tepat segala yang diajarkan imam-imam orang Lewi kepadamu; apa yang kuperintahkan kepada mereka haruslah kamu lakukan dengan setia."
 },
 {
   "id": 5536,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 9,
   "firman": "Ingatlah apa yang dilakukan TUHAN, Allahmu, kepada Miryam pada waktu perjalananmu keluar dari Mesir."
 },
 {
   "id": 5537,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 10,
   "firman": "Apabila engkau meminjamkan sesuatu kepada sesamamu, janganlah engkau masuk ke rumahnya untuk mengambil gadai dari padanya."
 },
 {
   "id": 5538,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 11,
   "firman": "Haruslah engkau tinggal berdiri di luar, dan orang yang kauberi pinjaman itu haruslah membawa gadai itu ke luar kepadamu."
 },
 {
   "id": 5539,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 12,
   "firman": "Jika ia seorang miskin, janganlah engkau tidur dengan barang gadaiannya;"
 },
 {
   "id": 5540,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 13,
   "firman": "kembalikanlah gadaian itu kepadanya pada waktu matahari terbenam, supaya ia dapat tidur dengan memakai kainnya sendiri dan memberkati engkau. Maka engkau akan menjadi benar di hadapan TUHAN, Allahmu."
 },
 {
   "id": 5541,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 14,
   "firman": "Janganlah engkau memeras pekerja harian yang miskin dan menderita, baik ia saudaramu maupun seorang asing yang ada di negerimu, di dalam tempatmu."
 },
 {
   "id": 5542,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 15,
   "firman": "Pada hari itu juga haruslah engkau membayar upahnya sebelum matahari terbenam; ia mengharapkannya, karena ia orang miskin; supaya ia jangan berseru kepada TUHAN mengenai engkau dan hal itu menjadi dosa bagimu."
 },
 {
   "id": 5543,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 16,
   "firman": "Janganlah ayah dihukum mati karena anaknya, janganlah juga anak dihukum mati karena ayahnya; setiap orang harus dihukum mati karena dosanya sendiri."
 },
 {
   "id": 5544,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 17,
   "firman": "Janganlah engkau memperkosa hak orang asing dan anak yatim; juga janganlah engkau mengambil pakaian seorang janda menjadi gadai."
 },
 {
   "id": 5545,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 18,
   "firman": "Haruslah kauingat, bahwa engkaupun dahulu budak di Mesir dan engkau ditebus TUHAN, Allahmu, dari sana; itulah sebabnya aku memerintahkan engkau melakukan hal ini."
 },
 {
   "id": 5546,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 19,
   "firman": "Apabila engkau menuai di ladangmu, lalu terlupa seberkas di ladang, maka janganlah engkau kembali untuk mengambilnya; itulah bagian orang asing, anak yatim dan janda--supaya TUHAN, Allahmu, memberkati engkau dalam segala pekerjaanmu."
 },
 {
   "id": 5547,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 20,
   "firman": "Apabila engkau memetik hasil pohon zaitunmu dengan memukul-mukulnya, janganlah engkau memeriksa dahan-dahannya sekali lagi; itulah bagian orang asing, anak yatim dan janda."
 },
 {
   "id": 5548,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 21,
   "firman": "Apabila engkau mengumpulkan hasil kebun anggurmu, janganlah engkau mengadakan pemetikan sekali lagi; itulah bagian orang asing, anak yatim dan janda."
 },
 {
   "id": 5549,
   "kitab": "Ula",
   "pasal": 24,
   "ayat": 22,
   "firman": "Haruslah kauingat, bahwa engkaupun dahulu budak di tanah Mesir; itulah sebabnya aku memerintahkan engkau melakukan hal ini.\""
 },
 {
   "id": 5550,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 1,
   "firman": "\"Apabila ada perselisihan di antara beberapa orang, lalu mereka pergi ke pengadilan, dan mereka diadili dengan dinyatakannya siapa yang benar dan siapa yang salah,"
 },
 {
   "id": 5551,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 2,
   "firman": "maka jika orang yang bersalah itu layak dipukul, haruslah hakim menyuruh dia meniarap dan menyuruh orang memukuli dia di depannya dengan sejumlah dera setimpal dengan kesalahannya."
 },
 {
   "id": 5552,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 3,
   "firman": "Empat puluh kali harus orang itu dipukuli, jangan lebih; supaya jangan saudaramu menjadi rendah di matamu, apabila ia dipukul lebih banyak lagi."
 },
 {
   "id": 5553,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 4,
   "firman": "Janganlah engkau memberangus mulut lembu yang sedang mengirik.\""
 },
 {
   "id": 5554,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 5,
   "firman": "\"Apabila orang-orang yang bersaudara tinggal bersama-sama dan seorang dari pada mereka mati dengan tidak meninggalkan anak laki-laki, maka janganlah isteri orang yang mati itu kawin dengan orang di luar lingkungan keluarganya; saudara suaminya haruslah menghampiri dia dan mengambil dia menjadi isterinya dan dengan demikian melakukan kewajiban perkawinan ipar."
 },
 {
   "id": 5555,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 6,
   "firman": "Maka anak sulung yang nanti dilahirkan perempuan itu haruslah dianggap sebagai anak saudara yang sudah mati itu, supaya nama itu jangan terhapus dari antara orang Israel."
 },
 {
   "id": 5556,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 7,
   "firman": "Tetapi jika orang itu tidak suka mengambil isteri saudaranya, maka haruslah isteri saudaranya itu pergi ke pintu gerbang menghadap para tua-tua serta berkata: Iparku menolak menegakkan nama saudaranya di antara orang Israel, ia tidak mau melakukan kewajiban perkawinan ipar dengan aku."
 },
 {
   "id": 5557,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 8,
   "firman": "Kemudian para tua-tua kotanya haruslah memanggil orang itu dan berbicara dengan dia. Jika ia tetap berpendirian dengan mengatakan: Aku tidak suka mengambil dia sebagai isteri--"
 },
 {
   "id": 5558,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 9,
   "firman": "maka haruslah isteri saudaranya itu datang kepadanya di hadapan para tua-tua, menanggalkan kasut orang itu dari kakinya, meludahi mukanya sambil menyatakan: Beginilah harus dilakukan kepada orang yang tidak mau membangun keturunan saudaranya."
 },
 {
   "id": 5559,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 10,
   "firman": "Dan di antara orang Israel namanya haruslah disebut: Kaum yang kasutnya ditanggalkan orang.\""
 },
 {
   "id": 5560,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 11,
   "firman": "\"Apabila dua orang berkelahi dan isteri yang seorang datang mendekat untuk menolong suaminya dari tangan orang yang memukulnya, dan perempuan itu mengulurkan tangannya dan menangkap kemaluan orang itu,"
 },
 {
   "id": 5561,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 12,
   "firman": "maka haruslah kaupotong tangan perempuan itu; janganlah engkau merasa sayang kepadanya.\""
 },
 {
   "id": 5562,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 13,
   "firman": "\"Janganlah ada di dalam pundi-pundimu dua macam batu timbangan, yang besar dan yang kecil."
 },
 {
   "id": 5563,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 14,
   "firman": "Janganlah ada di dalam rumahmu dua macam efa, yang besar dan yang kecil."
 },
 {
   "id": 5564,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 15,
   "firman": "Haruslah ada padamu batu timbangan yang utuh dan tepat; haruslah ada padamu efa yang utuh dan tepat--supaya lanjut umurmu di tanah yang diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5565,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 16,
   "firman": "Sebab setiap orang yang melakukan hal yang demikian, setiap orang yang berbuat curang, adalah kekejian bagi TUHAN, Allahmu.\""
 },
 {
   "id": 5566,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 17,
   "firman": "\"Ingatlah apa yang dilakukan orang Amalek kepadamu pada waktu perjalananmu keluar dari Mesir;"
 },
 {
   "id": 5567,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 18,
   "firman": "bahwa engkau didatangi mereka di jalan dan semua orang lemah pada barisan belakangmu dihantam mereka, sedang engkau lelah dan lesu. Mereka tidak takut akan Allah."
 },
 {
   "id": 5568,
   "kitab": "Ula",
   "pasal": 25,
   "ayat": 19,
   "firman": "Maka apabila TUHAN, Allahmu, sudah mengaruniakan keamanan kepadamu dari pada segala musuhmu di sekeliling, di negeri yang diberikan TUHAN, Allahmu, kepadamu untuk dimiliki sebagai milik pusaka, maka haruslah engkau menghapuskan ingatan kepada Amalek dari kolong langit. Janganlah lupa!\""
 },
 {
   "id": 5569,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 1,
   "firman": "\"Apabila engkau telah masuk ke negeri yang diberikan TUHAN, Allahmu, kepadamu menjadi milik pusakamu, dan engkau telah mendudukinya dan diam di sana,"
 },
 {
   "id": 5570,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 2,
   "firman": "maka haruslah engkau membawa hasil pertama dari bumi yang telah kaukumpulkan dari tanahmu yang diberikan kepadamu oleh TUHAN, Allahmu, dan haruslah engkau menaruhnya dalam bakul, kemudian pergi ke tempat yang akan dipilih TUHAN, Allahmu, untuk membuat nama-Nya diam di sana."
 },
 {
   "id": 5571,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 3,
   "firman": "Dan sesampainya kepada imam yang ada pada waktu itu, haruslah engkau berkata kepadanya: Aku memberitahukan pada hari ini kepada TUHAN, Allahmu, bahwa aku telah masuk ke negeri yang dijanjikan TUHAN dengan sumpah kepada nenek moyang kita untuk memberikannya kepada kita."
 },
 {
   "id": 5572,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 4,
   "firman": "Maka imam harus menerima bakul itu dari tanganmu dan meletakkannya di depan mezbah TUHAN, Allahmu."
 },
 {
   "id": 5573,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 5,
   "firman": "Kemudian engkau harus menyatakan di hadapan TUHAN, Allahmu, demikian: Bapaku dahulu seorang Aram, seorang pengembara. Ia pergi ke Mesir dengan sedikit orang saja dan tinggal di sana sebagai orang asing, tetapi di sana ia menjadi suatu bangsa yang besar, kuat dan banyak jumlahnya."
 },
 {
   "id": 5574,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 6,
   "firman": "Ketika orang Mesir menganiaya dan menindas kami dan menyuruh kami melakukan pekerjaan yang berat,"
 },
 {
   "id": 5575,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 7,
   "firman": "maka kami berseru kepada TUHAN, Allah nenek moyang kami, lalu TUHAN mendengar suara kami dan melihat kesengsaraan dan kesukaran kami dan penindasan terhadap kami."
 },
 {
   "id": 5576,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 8,
   "firman": "Lalu TUHAN membawa kami keluar dari Mesir dengan tangan yang kuat dan lengan yang teracung, dengan kedahsyatan yang besar dan dengan tanda-tanda serta mujizat-mujizat."
 },
 {
   "id": 5577,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 9,
   "firman": "Ia membawa kami ke tempat ini, dan memberikan kepada kami negeri ini, suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 5578,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 10,
   "firman": "Oleh sebab itu, di sini aku membawa hasil pertama dari bumi yang telah Kauberikan kepadaku, ya TUHAN. Kemudian engkau harus meletakkannya di hadapan TUHAN, Allahmu; engkau harus sujud di hadapan TUHAN, Allahmu,"
 },
 {
   "id": 5579,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 11,
   "firman": "dan haruslah engkau, orang Lewi dan orang asing yang ada di tengah-tengahmu bersukaria karena segala yang baik yang diberikan TUHAN, Allahmu, kepadamu dan kepada seisi rumahmu.\""
 },
 {
   "id": 5580,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 12,
   "firman": "\"Apabila dalam tahun yang ketiga, tahun persembahan persepuluhan, engkau sudah selesai mengambil segala persembahan persepuluhan dari hasil tanahmu, maka haruslah engkau memberikannya kepada orang Lewi, orang asing, anak yatim dan kepada janda, supaya mereka dapat makan di dalam tempatmu dan menjadi kenyang."
 },
 {
   "id": 5581,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 13,
   "firman": "Dan haruslah engkau berkata di hadapan TUHAN, Allahmu: Telah kupindahkan persembahan kudus itu dari rumahku, juga telah kuberikan kepada orang Lewi, dan kepada orang asing, anak yatim dan kepada janda, tepat seperti perintah yang telah Kauberikan kepadaku. Tidak kulangkahi atau kulupakan sesuatu dari perintah-Mu itu."
 },
 {
   "id": 5582,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 14,
   "firman": "Pada waktu aku berkabung sesuatu tidak kumakan dari persembahan kudus itu, pada waktu aku najis sesuatu tidak kujauhkan dari padanya, juga sesuatu tidak kupersembahkan dari padanya kepada orang mati, tetapi aku mendengarkan suara TUHAN, Allahku, aku berbuat sesuai dengan segala yang Kauperintahkan kepadaku."
 },
 {
   "id": 5583,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 15,
   "firman": "Jenguklah dari tempat kediaman-Mu yang kudus, dari dalam sorga, dan berkatilah umat-Mu Israel, dan tanah yang telah Kauberikan kepada kami, seperti yang telah Kaujanjikan dengan sumpah kepada nenek moyang kami--suatu negeri yang berlimpah-limpah susu dan madunya.\""
 },
 {
   "id": 5584,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 16,
   "firman": "\"Pada hari ini TUHAN, Allahmu, memerintahkan engkau melakukan ketetapan dan peraturan ini; lakukanlah semuanya itu dengan setia, dengan segenap hatimu dan segenap jiwamu."
 },
 {
   "id": 5585,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 17,
   "firman": "Engkau telah menerima janji dari pada TUHAN pada hari ini, bahwa Ia akan menjadi Allahmu, dan engkaupun akan hidup menurut jalan yang ditunjukkan-Nya dan berpegang pada ketetapan, perintah serta peraturan-Nya, dan mendengarkan suara-Nya."
 },
 {
   "id": 5586,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 18,
   "firman": "Dan TUHAN telah menerima janji dari padamu pada hari ini, bahwa engkau akan menjadi umat kesayangan-Nya, seperti yang dijanjikan-Nya kepadamu, dan bahwa engkau akan berpegang pada segala perintah-Nya,"
 },
 {
   "id": 5587,
   "kitab": "Ula",
   "pasal": 26,
   "ayat": 19,
   "firman": "dan Iapun akan mengangkat engkau di atas segala bangsa yang telah dijadikan-Nya, untuk menjadi terpuji, ternama dan terhormat. Maka engkau akan menjadi umat yang kudus bagi TUHAN, Allahmu, seperti yang dijanjikan-Nya.\""
 },
 {
   "id": 5588,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 1,
   "firman": "Lagi Musa dan para tua-tua Israel memerintahkan kepada bangsa itu: \"Berpeganglah pada segenap perintah yang kusampaikan kepadamu pada hari ini."
 },
 {
   "id": 5589,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 2,
   "firman": "Dan pada hari kamu menyeberangi sungai Yordan ke negeri yang diberikan kepadamu oleh TUHAN, Allahmu, maka haruslah engkau menegakkan batu-batu besar, dan mengapurnya,"
 },
 {
   "id": 5590,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 3,
   "firman": "lalu pada batu itu haruslah kautuliskan segala perkataan hukum Taurat ini, sesudah engkau menyeberang, supaya engkau masuk ke negeri yang diberikan kepadamu oleh TUHAN, Allahmu, suatu negeri yang berlimpah-limpah susu dan madunya, seperti yang dijanjikan kepadamu oleh TUHAN, Allah nenek moyangmu."
 },
 {
   "id": 5591,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 4,
   "firman": "Dan sesudah kamu menyeberangi sungai Yordan, maka haruslah batu-batu itu, yang telah kuperintahkan kepadamu pada hari ini, kamu tegakkan di gunung Ebal dan kaukapuri."
 },
 {
   "id": 5592,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 5,
   "firman": "Juga haruslah kaudirikan di sana mezbah bagi TUHAN, Allahmu, suatu mezbah dari batu yang tidak boleh kauolah dengan perkakas besi."
 },
 {
   "id": 5593,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 6,
   "firman": "Dari batu yang tidak dipahat haruslah kaudirikan mezbah TUHAN, Allahmu, itu dan di atasnya haruslah kaupersembahkan korban bakaran kepada TUHAN, Allahmu."
 },
 {
   "id": 5594,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 7,
   "firman": "Juga haruslah engkau mempersembahkan korban keselamatan, memakannya di sana dan bersukaria di hadapan TUHAN, Allahmu."
 },
 {
   "id": 5595,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 8,
   "firman": "Selanjutnya haruslah engkau menuliskan pada batu-batu itu segala perkataan hukum Taurat ini dengan jelas dan terang.\""
 },
 {
   "id": 5596,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 9,
   "firman": "Juga berbicaralah Musa dan imam-imam orang Lewi kepada seluruh orang Israel: \"Diamlah dan dengarlah, hai orang Israel. Pada hari ini engkau telah menjadi umat TUHAN, Allahmu."
 },
 {
   "id": 5597,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 10,
   "firman": "Sebab itu engkau harus mendengarkan suara TUHAN, Allahmu, dan melakukan perintah dan ketetapan-Nya, yang kusampaikan kepadamu pada hari ini.\""
 },
 {
   "id": 5598,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 11,
   "firman": "Pada hari itu Musa memberi perintah kepada bangsa itu:"
 },
 {
   "id": 5599,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 12,
   "firman": "\"Sesudah kamu menyeberangi sungai Yordan, maka mereka inilah yang harus berdiri di gunung Gerizim untuk memberkati bangsa itu, yakni suku Simeon, Lewi, Yehuda, Isakhar, Yusuf dan Benyamin."
 },
 {
   "id": 5600,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 13,
   "firman": "Dan mereka inilah yang harus berdiri di gunung Ebal untuk mengutuki, yakni suku Ruben, Gad, Asyer, Zebulon, Dan serta Naftali."
 },
 {
   "id": 5601,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 14,
   "firman": "Maka haruslah orang-orang Lewi mulai bicara dan mengatakan kepada seluruh orang Israel dengan suara nyaring:"
 },
 {
   "id": 5602,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 15,
   "firman": "Terkutuklah orang yang membuat patung pahatan atau patung tuangan, suatu kekejian bagi TUHAN, buatan tangan seorang tukang, dan yang mendirikannya dengan tersembunyi. Dan seluruh bangsa itu haruslah menjawab: Amin!"
 },
 {
   "id": 5603,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 16,
   "firman": "Terkutuklah orang yang memandang rendah ibu dan bapanya. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5604,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 17,
   "firman": "Terkutuklah orang yang menggeser batas tanah sesamanya manusia. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5605,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 18,
   "firman": "Terkutuklah orang yang membawa seorang buta ke jalan yang sesat. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5606,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 19,
   "firman": "Terkutuklah orang yang memperkosa hak orang asing, anak yatim dan janda. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5607,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 20,
   "firman": "Terkutuklah orang yang tidur dengan isteri ayahnya, sebab ia telah menyingkapkan punca kain ayahnya. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5608,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 21,
   "firman": "Terkutuklah orang yang tidur dengan binatang apapun. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5609,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 22,
   "firman": "Terkutuklah orang yang tidur dengan saudaranya perempuan, anak ayah atau anak ibunya. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5610,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 23,
   "firman": "Terkutuklah orang yang tidur dengan mertuanya perempuan. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5611,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 24,
   "firman": "Terkutuklah orang yang membunuh sesamanya manusia dengan tersembunyi. Dan seluruh bangsa itu haruslah berkata: Amin!"
 },
 {
   "id": 5612,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 25,
   "firman": "Terkutuklah orang yang menerima suap untuk membunuh seseorang yang tidak bersalah. Dan seluruh bangsa itu harus berkata: Amin!"
 },
 {
   "id": 5613,
   "kitab": "Ula",
   "pasal": 27,
   "ayat": 26,
   "firman": "Terkutuklah orang yang tidak menepati perkataan hukum Taurat ini dengan perbuatan. Dan seluruh bangsa itu haruslah berkata: Amin!\""
 },
 {
   "id": 5614,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 1,
   "firman": "\"Jika engkau baik-baik mendengarkan suara TUHAN, Allahmu, dan melakukan dengan setia segala perintah-Nya yang kusampaikan kepadamu pada hari ini, maka TUHAN, Allahmu, akan mengangkat engkau di atas segala bangsa di bumi."
 },
 {
   "id": 5615,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 2,
   "firman": "Segala berkat ini akan datang kepadamu dan menjadi bagianmu, jika engkau mendengarkan suara TUHAN, Allahmu:"
 },
 {
   "id": 5616,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 3,
   "firman": "Diberkatilah engkau di kota dan diberkatilah engkau di ladang."
 },
 {
   "id": 5617,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 4,
   "firman": "Diberkatilah buah kandunganmu, hasil bumimu dan hasil ternakmu, yakni anak lembu sapimu dan kandungan kambing dombamu."
 },
 {
   "id": 5618,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 5,
   "firman": "Diberkatilah bakulmu dan tempat adonanmu."
 },
 {
   "id": 5619,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 6,
   "firman": "Diberkatilah engkau pada waktu masuk dan diberkatilah engkau pada waktu keluar."
 },
 {
   "id": 5620,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 7,
   "firman": "TUHAN akan membiarkan musuhmu yang maju berperang melawan engkau, terpukul kalah olehmu. Bersatu jalan mereka akan menyerangi engkau, tetapi bertujuh jalan mereka akan lari dari depanmu."
 },
 {
   "id": 5621,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 8,
   "firman": "TUHAN akan memerintahkan berkat ke atasmu di dalam lumbungmu dan di dalam segala usahamu; Ia akan memberkati engkau di negeri yang diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5622,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 9,
   "firman": "TUHAN akan menetapkan engkau sebagai umat-Nya yang kudus, seperti yang dijanjikan-Nya dengan sumpah kepadamu, jika engkau berpegang pada perintah TUHAN, Allahmu, dan hidup menurut jalan yang ditunjukkan-Nya."
 },
 {
   "id": 5623,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 10,
   "firman": "Maka segala bangsa di bumi akan melihat, bahwa nama TUHAN telah disebut atasmu, dan mereka akan takut kepadamu."
 },
 {
   "id": 5624,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 11,
   "firman": "Juga TUHAN akan melimpahi engkau dengan kebaikan dalam buah kandunganmu, dalam hasil ternakmu dan dalam hasil bumimu--di tanah yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu untuk memberikannya kepadamu."
 },
 {
   "id": 5625,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 12,
   "firman": "TUHAN akan membuka bagimu perbendaharaan-Nya yang melimpah, yakni langit, untuk memberi hujan bagi tanahmu pada masanya dan memberkati segala pekerjaanmu, sehingga engkau memberi pinjaman kepada banyak bangsa, tetapi engkau sendiri tidak meminta pinjaman."
 },
 {
   "id": 5626,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 13,
   "firman": "TUHAN akan mengangkat engkau menjadi kepala dan bukan menjadi ekor, engkau akan tetap naik dan bukan turun, apabila engkau mendengarkan perintah TUHAN, Allahmu, yang kusampaikan pada hari ini kaulakukan dengan setia,"
 },
 {
   "id": 5627,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 14,
   "firman": "dan apabila engkau tidak menyimpang ke kanan atau ke kiri dari segala perintah yang kuberikan kepadamu pada hari ini, dengan mengikuti allah lain dan beribadah kepadanya.\""
 },
 {
   "id": 5628,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 15,
   "firman": "\"Tetapi jika engkau tidak mendengarkan suara TUHAN, Allahmu, dan tidak melakukan dengan setia segala perintah dan ketetapan-Nya, yang kusampaikan kepadamu pada hari ini, maka segala kutuk ini akan datang kepadamu dan mencapai engkau:"
 },
 {
   "id": 5629,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 16,
   "firman": "Terkutuklah engkau di kota dan terkutuklah engkau di ladang."
 },
 {
   "id": 5630,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 17,
   "firman": "Terkutuklah bakulmu dan tempat adonanmu."
 },
 {
   "id": 5631,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 18,
   "firman": "Terkutuklah buah kandunganmu, hasil bumimu, anak lembu sapimu dan kandungan kambing dombamu."
 },
 {
   "id": 5632,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 19,
   "firman": "Terkutuklah engkau pada waktu masuk dan terkutuklah engkau pada waktu keluar."
 },
 {
   "id": 5633,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 20,
   "firman": "TUHAN akan mendatangkan kutuk, huru-hara dan penghajaran ke antaramu dalam segala usaha yang kaukerjakan, sampai engkau punah dan binasa dengan segera karena jahat perbuatanmu, sebab engkau telah meninggalkan Aku."
 },
 {
   "id": 5634,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 21,
   "firman": "TUHAN akan melekatkan penyakit sampar kepadamu, sampai dihabiskannya engkau dari tanah, ke mana engkau pergi untuk mendudukinya."
 },
 {
   "id": 5635,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 22,
   "firman": "TUHAN akan menghajar engkau dengan batuk kering, demam, demam kepialu, sakit radang, kekeringan, hama dan penyakit gandum; semuanya itu akan memburu engkau sampai engkau binasa."
 },
 {
   "id": 5636,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 23,
   "firman": "Juga langit yang di atas kepalamu akan menjadi tembaga dan tanah yang di bawahpun menjadi besi."
 },
 {
   "id": 5637,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 24,
   "firman": "TUHAN akan menurunkan hujan abu dan debu ke atas negerimu; dari langit akan turun semuanya itu ke atasmu, sampai engkau punah."
 },
 {
   "id": 5638,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 25,
   "firman": "TUHAN akan membiarkan engkau terpukul kalah oleh musuhmu. Bersatu jalan engkau akan keluar menyerang mereka, tetapi bertujuh jalan engkau akan lari dari depan mereka, sehingga engkau menjadi kengerian bagi segala kerajaan di bumi."
 },
 {
   "id": 5639,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 26,
   "firman": "Mayatmu akan menjadi makanan segala burung di udara serta binatang-binatang di bumi, dengan tidak ada yang mengganggunya."
 },
 {
   "id": 5640,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 27,
   "firman": "TUHAN akan menghajar engkau dengan barah Mesir, dengan borok, dengan kedal dan kudis, yang dari padanya engkau tidak dapat sembuh."
 },
 {
   "id": 5641,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 28,
   "firman": "TUHAN akan menghajar engkau dengan kegilaan, kebutaan dan kehilangan akal,"
 },
 {
   "id": 5642,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 29,
   "firman": "sehingga engkau meraba-raba pada waktu tengah hari, seperti seorang buta meraba-raba di dalam gelap; perjalananmu tidak akan beruntung, tetapi engkau selalu diperas dan dirampasi, dengan tidak ada seorang yang datang menolong."
 },
 {
   "id": 5643,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 30,
   "firman": "Engkau akan bertunangan dengan seorang perempuan, tetapi orang lain akan menidurinya. Engkau akan mendirikan rumah, tetapi tidak akan mendiaminya. Engkau akan membuat kebun anggur, tetapi tidak akan mengecap hasilnya."
 },
 {
   "id": 5644,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 31,
   "firman": "Lembumu akan disembelih orang di depan matamu, tetapi engkau tidak akan memakan dagingnya. Keledaimu akan dirampas dari depanmu, dan tidak akan dikembalikan kepadamu. Kambing dombamu akan diberikan kepada musuhmu dengan tidak ada orang yang datang menolong engkau."
 },
 {
   "id": 5645,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 32,
   "firman": "Anak-anakmu lelaki dan anak-anakmu perempuan akan diserahkan kepada bangsa lain, sedang engkau melihatnya dengan matamu sendiri, dan sehari-harian engkau rindu kepada mereka, dengan tidak dapat berbuat apa-apa."
 },
 {
   "id": 5646,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 33,
   "firman": "Suatu bangsa yang tidak kaukenal akan memakan hasil bumimu dan segala hasil jerih payahmu; engkau akan selalu ditindas dan diinjak."
 },
 {
   "id": 5647,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 34,
   "firman": "Engkau akan menjadi gila karena apa yang dilihat matamu."
 },
 {
   "id": 5648,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 35,
   "firman": "TUHAN akan menghajar engkau dengan barah jahat, yang dari padanya engkau tidak dapat sembuh, pada lutut dan pahamu, bahkan dari telapak kakimu sampai kepada batu kepalamu."
 },
 {
   "id": 5649,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 36,
   "firman": "TUHAN akan membawa engkau dengan raja yang kauangkat atasmu itu kepada suatu bangsa yang tidak dikenal olehmu ataupun oleh nenek moyangmu; di sanalah engkau akan beribadah kepada allah lain, kepada kayu dan batu."
 },
 {
   "id": 5650,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 37,
   "firman": "Engkau akan menjadi kedahsyatan, kiasan dan sindiran di antara segala bangsa, ke mana TUHAN akan menyingkirkan engkau."
 },
 {
   "id": 5651,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 38,
   "firman": "Banyak benih yang akan kaubawa ke ladang, tetapi sedikit hasil yang akan kaukumpulkan, sebab belalang akan menghabiskannya."
 },
 {
   "id": 5652,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 39,
   "firman": "Kebun-kebun anggur akan kaubuat dan kauusahakan, tetapi engkau tidak akan meminum atau menyimpan anggur, sebab ulat akan memakannya."
 },
 {
   "id": 5653,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 40,
   "firman": "Pohon-pohon zaitun akan kaupunyai di seluruh daerahmu, tetapi engkau tidak akan berurap dengan minyaknya; sebab buah zaitunmu akan gugur."
 },
 {
   "id": 5654,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 41,
   "firman": "Engkau akan mendapat anak-anak lelaki dan anak-anak perempuan, tetapi mereka bukan bagi dirimu, sebab mereka akan menjadi tawanan."
 },
 {
   "id": 5655,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 42,
   "firman": "Segala pohon-pohonmu dan hasil bumimu akan diduduki oleh kawanan belalang."
 },
 {
   "id": 5656,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 43,
   "firman": "Orang asing yang ada di tengah-tengahmu akan menjadi makin tinggi mengatasi engkau, tetapi engkau menjadi makin rendah."
 },
 {
   "id": 5657,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 44,
   "firman": "Ia akan memberi pinjaman kepadamu, tetapi engkau tidak akan memberi pinjaman kepadanya; ia akan menjadi kepala, tetapi engkau akan menjadi ekor."
 },
 {
   "id": 5658,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 45,
   "firman": "Segala kutuk itu akan datang ke atasmu, memburu engkau dan mencapai engkau, sampai engkau punah, karena engkau tidak mendengarkan suara TUHAN, Allahmu dan tidak berpegang pada perintah dan ketetapan yang diperintahkan-Nya kepadamu;"
 },
 {
   "id": 5659,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 46,
   "firman": "semuanya itu akan menjadi tanda dan mujizat di antaramu dan di antara keturunanmu untuk selamanya.\""
 },
 {
   "id": 5660,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 47,
   "firman": "\"Karena engkau tidak mau menjadi hamba kepada TUHAN, Allahmu, dengan sukacita dan gembira hati walaupun kelimpahan akan segala-galanya,"
 },
 {
   "id": 5661,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 48,
   "firman": "maka dengan menanggung lapar dan haus, dengan telanjang dan kekurangan akan segala-galanya engkau akan menjadi hamba kepada musuh yang akan disuruh TUHAN melawan engkau. Ia akan membebankan kuk besi ke atas tengkukmu, sampai engkau dipunahkan-Nya."
 },
 {
   "id": 5662,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 49,
   "firman": "TUHAN akan mendatangkan kepadamu suatu bangsa dari jauh, dari ujung bumi, seperti rajawali yang datang menyambar; suatu bangsa yang bahasanya engkau tidak mengerti,"
 },
 {
   "id": 5663,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 50,
   "firman": "suatu bangsa yang garang mukanya, yang tidak menghiraukan orang tua-tua dan tidak merasa kasihan kepada anak-anak;"
 },
 {
   "id": 5664,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 51,
   "firman": "yang akan memakan habis hasil ternakmu dan hasil bumimu, sampai engkau punah; yang tidak akan meninggalkan bagimu gandum, air anggur atau minyak, ataupun anak lembu sapimu atau anak kambing dombamu, sampai engkau dibinasakannya."
 },
 {
   "id": 5665,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 52,
   "firman": "Engkau akan ditekannya di segala tempatmu, sampai runtuh tembok-tembokmu yang tinggi dan berkubu, yang kaupercayai itu di seluruh negerimu, bahkan engkau akan ditekan di dalam segala tempatmu, di seluruh negeri yang telah diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 5666,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 53,
   "firman": "Dan engkau akan memakan buah kandunganmu, yakni daging anak-anakmu lelaki dan anak-anakmu perempuan yang diberikan kepadamu oleh TUHAN, Allahmu, --dalam keadaan susah dan sulit yang ditimbulkan musuhmu kepadamu."
 },
 {
   "id": 5667,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 54,
   "firman": "Dan orang laki-laki yang paling lemah dan paling manja di antaramu akan kesal terhadap saudaranya atau terhadap isterinya sendiri atau terhadap anak-anaknya yang masih tinggal padanya,"
 },
 {
   "id": 5668,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 55,
   "firman": "sehingga kepada salah seorang dari mereka itu ia tidak mau memberikan sedikitpun dari daging anak-anaknya yang dimakannya, karena tidak ada lagi sesuatu yang ditinggalkan baginya, dalam keadaan susah dan sulit yang ditimbulkan musuhmu kepadamu di segala tempatmu."
 },
 {
   "id": 5669,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 56,
   "firman": "Perempuan yang lemah dan manja di antaramu, yang tidak pernah mencoba menjejakkan telapak kakinya ke tanah karena sifatnya yang manja dan lemah itu, akan kesal terhadap suaminya sendiri atau terhadap anaknya laki-laki atau anaknya perempuan,"
 },
 {
   "id": 5670,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 57,
   "firman": "karena uri yang keluar dari kandungannya ataupun karena anak-anak yang dilahirkannya; sebab karena kekurangan segala-galanya ia akan memakannya dengan sembunyi-sembunyi, dalam keadaan susah dan sulit yang ditimbulkan musuhmu kepadamu di dalam tempatmu."
 },
 {
   "id": 5671,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 58,
   "firman": "Jika engkau tidak melakukan dengan setia segala perkataan hukum Taurat yang tertulis dalam kitab ini, dan engkau tidak takut akan Nama yang mulia dan dahsyat ini, yakni akan TUHAN, Allahmu,"
 },
 {
   "id": 5672,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 59,
   "firman": "maka TUHAN akan menimpakan pukulan-pukulan yang ajaib kepadamu, dan kepada keturunanmu, yakni pukulan-pukulan yang keras lagi lama dan penyakit-penyakit yang jahat lagi lama."
 },
 {
   "id": 5673,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 60,
   "firman": "Ia akan mendatangkan pula segala wabah Mesir yang kautakuti itu kepadamu, sehingga semuanya itu melekat padamu."
 },
 {
   "id": 5674,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 61,
   "firman": "Juga berbagai-bagai penyakit dan pukulan, yang tidak tertulis dalam kitab Taurat ini, akan ditimbulkan TUHAN menimpa engkau, sampai engkau punah."
 },
 {
   "id": 5675,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 62,
   "firman": "Dari pada kamu hanya sedikit orang yang tertinggal, padahal kamu dahulu seperti bintang-bintang di langit banyaknya--karena engkau tidak mendengarkan suara TUHAN, Allahmu."
 },
 {
   "id": 5676,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 63,
   "firman": "Seperti TUHAN bergirang karena kamu untuk berbuat baik kepadamu dan membuat kamu banyak, demikianlah TUHAN akan bergirang karena kamu untuk membinasakan dan memunahkan kamu, dan kamu akan dicabut dari tanah, ke mana engkau pergi untuk mendudukinya."
 },
 {
   "id": 5677,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 64,
   "firman": "TUHAN akan menyerakkan engkau ke antara segala bangsa dari ujung bumi ke ujung bumi; di sanalah engkau akan beribadah kepada allah lain yang tidak dikenal olehmu ataupun oleh nenek moyangmu, yakni kepada kayu dan batu."
 },
 {
   "id": 5678,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 65,
   "firman": "Engkau tidak akan mendapat ketenteraman di antara bangsa-bangsa itu dan tidak akan ada tempat berjejak bagi telapak kakimu; TUHAN akan memberikan di sana kepadamu hati yang gelisah, mata yang penuh rindu dan jiwa yang merana."
 },
 {
   "id": 5679,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 66,
   "firman": "Hidupmu akan terkatung-katung, siang dan malam engkau akan terkejut dan kuatir akan hidupmu."
 },
 {
   "id": 5680,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 67,
   "firman": "Pada waktu pagi engkau akan berkata: Ah, kalau malam sekarang! dan pada waktu malam engkau akan berkata: Ah, kalau pagi sekarang! karena kejut memenuhi hatimu, dan karena apa yang dilihat matamu."
 },
 {
   "id": 5681,
   "kitab": "Ula",
   "pasal": 28,
   "ayat": 68,
   "firman": "TUHAN akan membawa engkau kembali ke Mesir dengan kapal, melalui jalan yang telah Kukatakan kepadamu: Engkau tidak akan melihatnya lagi, dan di sana kamu akan menawarkan diri kepada musuhmu sebagai budak lelaki dan budak perempuan, tetapi tidak ada pembeli.\""
 },
 {
   "id": 5682,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 1,
   "firman": "Inilah perkataan perjanjian yang diikat Musa dengan orang Israel di tanah Moab sesuai dengan perintah TUHAN, selain perjanjian yang telah diikat-Nya dengan mereka di gunung Horeb."
 },
 {
   "id": 5683,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 2,
   "firman": "Musa memanggil seluruh orang Israel berkumpul, lalu berkata kepada mereka: \"Sudah kamu lihat segala yang dilakukan TUHAN di tanah Mesir di depan matamu terhadap Firaun dan terhadap semua pegawainya dan terhadap seluruh negerinya:"
 },
 {
   "id": 5684,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 3,
   "firman": "cobaan-cobaan yang besar yang telah dilihat oleh matamu sendiri, tanda-tanda dan mujizat-mujizat yang besar itu."
 },
 {
   "id": 5685,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 4,
   "firman": "Tetapi sampai sekarang ini TUHAN tidak memberi kamu akal budi untuk mengerti atau mata untuk melihat atau telinga untuk mendengar."
 },
 {
   "id": 5686,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 5,
   "firman": "Empat puluh tahun lamanya Aku memimpin kamu berjalan melalui padang gurun; pakaianmu tidak menjadi rusak di tubuhmu, dan kasutmu tidak menjadi rusak di kakimu."
 },
 {
   "id": 5687,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 6,
   "firman": "Roti tidak kamu makan, anggur atau minuman yang memabukkan tidak kamu minum--supaya kamu tahu bahwa Akulah TUHAN, Allahmu."
 },
 {
   "id": 5688,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 7,
   "firman": "Ketika kamu sudah sampai ke tempat ini, maka keluarlah Sihon, raja Hesybon, dan Og, raja Basan, mendatangi kita untuk berperang, dan kita memukul mereka kalah,"
 },
 {
   "id": 5689,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 8,
   "firman": "merebut negeri mereka dan memberikannya kepada orang Ruben, kepada orang Gad, dan kepada suku Manasye yang setengah itu menjadi milik pusaka mereka."
 },
 {
   "id": 5690,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 9,
   "firman": "Sebab itu lakukanlah perkataan perjanjian ini dengan setia, supaya kamu beruntung dalam segala yang kamu lakukan."
 },
 {
   "id": 5691,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 10,
   "firman": "Kamu sekalian pada hari ini berdiri di hadapan TUHAN, Allahmu: para kepala sukumu, para tua-tuamu dan para pengatur pasukanmu, semua laki-laki Israel,"
 },
 {
   "id": 5692,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 11,
   "firman": "anak-anakmu, perempuan-perempuanmu dan orang-orang asing dalam perkemahanmu, bahkan tukang-tukang belah kayu dan tukang-tukang timba air di antaramu,"
 },
 {
   "id": 5693,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 12,
   "firman": "untuk masuk ke dalam perjanjian TUHAN, Allahmu, yakni sumpah janji-Nya, yang diikat TUHAN, Allahmu, dengan engkau pada hari ini,"
 },
 {
   "id": 5694,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 13,
   "firman": "supaya Ia mengangkat engkau sebagai umat-Nya pada hari ini dan supaya Ia menjadi Allahmu, seperti yang difirmankan-Nya kepadamu dan seperti yang dijanjikan-Nya dengan sumpah kepada nenek moyangmu, yakni kepada Abraham, Ishak dan Yakub."
 },
 {
   "id": 5695,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 14,
   "firman": "Bukan hanya dengan kamu saja aku mengikat perjanjian dan sumpah janji ini,"
 },
 {
   "id": 5696,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 15,
   "firman": "tetapi dengan setiap orang yang ada di sini pada hari ini bersama-sama dengan kita, yang berdiri di hadapan TUHAN, Allah kita, dan juga dengan setiap orang yang tidak ada di sini pada hari ini bersama-sama dengan kita."
 },
 {
   "id": 5697,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 16,
   "firman": "Sebab kamu ini tahu, bagaimana kita diam di tanah Mesir dan bagaimana kita berjalan dari tengah-tengah segala bangsa yang negerinya kamu lalui,"
 },
 {
   "id": 5698,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 17,
   "firman": "dan kamu sudah melihat dewa kejijikan dan berhala mereka, yakni kayu dan batu, emas dan perak itu, yang ada terdapat pada mereka."
 },
 {
   "id": 5699,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 18,
   "firman": "Sebab itu janganlah di antaramu ada laki-laki atau perempuan, kaum keluarga atau suku yang hatinya pada hari ini berpaling meninggalkan TUHAN, Allah kita, untuk pergi berbakti kepada allah bangsa-bangsa itu; janganlah di antaramu ada akar yang menghasilkan racun atau ipuh."
 },
 {
   "id": 5700,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 19,
   "firman": "Tetapi apabila seseorang pada waktu mendengar perkataan sumpah serapah ini menyangka dirinya tetap diberkati, dengan berkata: Aku akan selamat, walaupun aku berlaku degil--dengan demikian dilenyapkannya baik tanah yang kegenangan maupun yang kekeringan--"
 },
 {
   "id": 5701,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 20,
   "firman": "maka TUHAN tidak akan mau mengampuni orang itu, tetapi murka dan cemburu TUHAN akan menyala atasnya pada waktu itu; segenap sumpah serapah yang tertulis dalam kitab ini akan menghinggapi dia, dan TUHAN akan menghapuskan namanya dari kolong langit."
 },
 {
   "id": 5702,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 21,
   "firman": "TUHAN akan memisahkan orang itu dari segala suku Israel supaya dia mendapat celaka, sesuai dengan segala sumpah serapah perjanjian yang tertulis dalam kitab hukum Taurat ini."
 },
 {
   "id": 5703,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 22,
   "firman": "Maka keturunan yang akan datang, yakni anak-anakmu yang bangkit sesudah kamu, dan orang asing yang datang dari negeri jauh akan berkata--apabila mereka melihat hajaran dan penyakit yang dijatuhkan TUHAN ke negeri itu,"
 },
 {
   "id": 5704,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 23,
   "firman": "seluruh tanahnya yang telah hangus oleh belerang dan garam, yang tidak ditaburi, tidak menumbuhkan apa-apa dan tidak ada tumbuh-tumbuhan apapun yang timbul dari padanya, seperti pada waktu ditunggangbalikkan-Nya Sodom, Gomora, Adma dan Zeboim, yakni yang ditunggangbalikkan TUHAN dalam murka dan kepanasan amarah-Nya--"
 },
 {
   "id": 5705,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 24,
   "firman": "bahkan segala bangsa akan berkata: Apakah sebabnya TUHAN berbuat demikian kepada negeri ini? Apakah artinya murka yang hebat bernyala-nyala ini?"
 },
 {
   "id": 5706,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 25,
   "firman": "Maka orang akan menjawab: Sebab mereka itu telah melalaikan perjanjian TUHAN, Allah nenek moyang mereka, yakni perjanjian yang diikat-Nya dengan mereka ketika mereka dibawa-Nya keluar dari tanah Mesir,"
 },
 {
   "id": 5707,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 26,
   "firman": "dan sebab mereka itu sudah pergi berbakti kepada allah lain dan sujud menyembah kepadanya, yakni allah yang tidak dikenal mereka dan yang tidak diberikan TUHAN kepada mereka sebagai bagiannya."
 },
 {
   "id": 5708,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 27,
   "firman": "Itulah sebabnya murka TUHAN bangkit terhadap negeri ini, sehingga didatangkan ke atasnya segala kutuk yang tertulis dalam kitab ini:"
 },
 {
   "id": 5709,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 28,
   "firman": "TUHAN telah menyentakkan mereka dari tanah mereka dalam murka dan kepanasan amarah dan gusar-Nya yang hebat, lalu melemparkan mereka ke negeri lain, seperti yang terjadi sekarang ini."
 },
 {
   "id": 5710,
   "kitab": "Ula",
   "pasal": 29,
   "ayat": 29,
   "firman": "Hal-hal yang tersembunyi ialah bagi TUHAN, Allah kita, tetapi hal-hal yang dinyatakan ialah bagi kita dan bagi anak-anak kita sampai selama-lamanya, supaya kita melakukan segala perkataan hukum Taurat ini.\""
 },
 {
   "id": 5711,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 1,
   "firman": "\"Maka apabila segala hal ini berlaku atasmu, yakni berkat dan kutuk yang telah kuperhadapkan kepadamu itu, dan engkau menjadi sadar dalam hatimu di tengah-tengah segala bangsa, ke mana TUHAN, Allahmu, menghalau engkau,"
 },
 {
   "id": 5712,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 2,
   "firman": "dan apabila engkau berbalik kepada TUHAN, Allahmu, dan mendengarkan suara-Nya sesuai dengan segala yang kuperintahkan kepadamu pada hari ini, baik engkau maupun anak-anakmu, dengan segenap hatimu dan dengan segenap jiwamu,"
 },
 {
   "id": 5713,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 3,
   "firman": "maka TUHAN, Allahmu, akan memulihkan keadaanmu dan akan menyayangi engkau. Ia akan mengumpulkan engkau kembali dari segala bangsa, ke mana TUHAN, Allahmu, telah menyerakkan engkau."
 },
 {
   "id": 5714,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 4,
   "firman": "Sekalipun orang-orang yang terhalau dari padamu ada di ujung langit, dari sanapun TUHAN, Allahmu, akan mengumpulkan engkau kembali dan dari sanapun Ia akan mengambil engkau."
 },
 {
   "id": 5715,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 5,
   "firman": "TUHAN, Allahmu, akan membawa engkau masuk ke negeri yang sudah dimiliki nenek moyangmu, dan engkaupun akan memilikinya pula. Ia akan berbuat baik kepadamu dan membuat engkau banyak melebihi nenek moyangmu."
 },
 {
   "id": 5716,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 6,
   "firman": "Dan TUHAN, Allahmu, akan menyunat hatimu dan hati keturunanmu, sehingga engkau mengasihi TUHAN, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu, supaya engkau hidup."
 },
 {
   "id": 5717,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 7,
   "firman": "TUHAN, Allahmu, akan menjatuhkan segala sumpah serapah itu kepada musuhmu dan pembencimu, yang telah mengejar engkau."
 },
 {
   "id": 5718,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 8,
   "firman": "Engkau akan mendengarkan kembali suara TUHAN dan melakukan segala perintah-Nya yang kusampaikan kepadamu pada hari ini."
 },
 {
   "id": 5719,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 9,
   "firman": "TUHAN, Allahmu, akan melimpahi engkau dengan kebaikan dalam segala pekerjaanmu, dalam buah kandunganmu, dalam hasil ternakmu dan dalam hasil bumimu, sebab TUHAN, Allahmu, akan bergirang kembali karena engkau dalam keberuntunganmu, seperti Ia bergirang karena nenek moyangmu dahulu--"
 },
 {
   "id": 5720,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 10,
   "firman": "apabila engkau mendengarkan suara TUHAN, Allahmu, dengan berpegang pada perintah dan ketetapan-Nya, yang tertulis dalam kitab Taurat ini dan apabila engkau berbalik kepada TUHAN, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu.\""
 },
 {
   "id": 5721,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 11,
   "firman": "\"Sebab perintah ini, yang kusampaikan kepadamu pada hari ini, tidaklah terlalu sukar bagimu dan tidak pula terlalu jauh."
 },
 {
   "id": 5722,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 12,
   "firman": "Tidak di langit tempatnya, sehingga engkau berkata: Siapakah yang akan naik ke langit untuk mengambilnya bagi kita dan memperdengarkannya kepada kita, supaya kita melakukannya?"
 },
 {
   "id": 5723,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 13,
   "firman": "Juga tidak di seberang laut tempatnya, sehingga engkau berkata: Siapakah yang akan menyeberang ke seberang laut untuk mengambilnya bagi kita dan memperdengarkannya kepada kita, supaya kita melakukannya?"
 },
 {
   "id": 5724,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 14,
   "firman": "Tetapi firman ini sangat dekat kepadamu, yakni di dalam mulutmu dan di dalam hatimu, untuk dilakukan."
 },
 {
   "id": 5725,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 15,
   "firman": "Ingatlah, aku menghadapkan kepadamu pada hari ini kehidupan dan keberuntungan, kematian dan kecelakaan,"
 },
 {
   "id": 5726,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 16,
   "firman": "karena pada hari ini aku memerintahkan kepadamu untuk mengasihi TUHAN, Allahmu, dengan hidup menurut jalan yang ditunjukkan-Nya dan berpegang pada perintah, ketetapan dan peraturan-Nya, supaya engkau hidup dan bertambah banyak dan diberkati oleh TUHAN, Allahmu, di negeri ke mana engkau masuk untuk mendudukinya."
 },
 {
   "id": 5727,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 17,
   "firman": "Tetapi jika hatimu berpaling dan engkau tidak mau mendengar, bahkan engkau mau disesatkan untuk sujud menyembah kepada allah lain dan beribadah kepadanya,"
 },
 {
   "id": 5728,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 18,
   "firman": "maka aku memberitahukan kepadamu pada hari ini, bahwa pastilah kamu akan binasa; tidak akan lanjut umurmu di tanah, ke mana engkau pergi, menyeberangi sungai Yordan untuk mendudukinya."
 },
 {
   "id": 5729,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 19,
   "firman": "Aku memanggil langit dan bumi menjadi saksi terhadap kamu pada hari ini: kepadamu kuperhadapkan kehidupan dan kematian, berkat dan kutuk. Pilihlah kehidupan, supaya engkau hidup, baik engkau maupun keturunanmu,"
 },
 {
   "id": 5730,
   "kitab": "Ula",
   "pasal": 30,
   "ayat": 20,
   "firman": "dengan mengasihi TUHAN, Allahmu, mendengarkan suara-Nya dan berpaut pada-Nya, sebab hal itu berarti hidupmu dan lanjut umurmu untuk tinggal di tanah yang dijanjikan TUHAN dengan sumpah kepada nenek moyangmu, yakni kepada Abraham, Ishak dan Yakub, untuk memberikannya kepada mereka.\""
 },
 {
   "id": 5731,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 1,
   "firman": "Kemudian pergilah Musa, lalu mengatakan segala perkataan ini kepada seluruh orang Israel."
 },
 {
   "id": 5732,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 2,
   "firman": "Berkatalah ia kepada mereka: \"Aku sekarang berumur seratus dua puluh tahun; aku tidak dapat giat lagi, dan TUHAN telah berfirman kepadaku: Sungai Yordan ini tidak akan kauseberangi."
 },
 {
   "id": 5733,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 3,
   "firman": "TUHAN, Allahmu, Dialah yang akan menyeberang di depanmu; Dialah yang akan memunahkan bangsa-bangsa itu dari hadapanmu, sehingga engkau dapat memiliki negeri mereka; Yosua, dialah yang akan menyeberang di depanmu, seperti yang difirmankan TUHAN."
 },
 {
   "id": 5734,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 4,
   "firman": "Dan TUHAN akan melakukan terhadap mereka seperti yang dilakukan-Nya terhadap Sihon dan Og, raja-raja orang Amori, yang telah dipunahkan-Nya itu, dan terhadap negeri mereka."
 },
 {
   "id": 5735,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 5,
   "firman": "TUHAN akan menyerahkan mereka kepadamu dan haruslah kamu melakukan kepada mereka tepat seperti perintah yang kusampaikan kepadamu."
 },
 {
   "id": 5736,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 6,
   "firman": "Kuatkan dan teguhkanlah hatimu, janganlah takut dan jangan gemetar karena mereka, sebab TUHAN, Allahmu, Dialah yang berjalan menyertai engkau; Ia tidak akan membiarkan engkau dan tidak akan meninggalkan engkau.\""
 },
 {
   "id": 5737,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 7,
   "firman": "Lalu Musa memanggil Yosua dan berkata kepadanya di depan seluruh orang Israel: \"Kuatkan dan teguhkanlah hatimu, sebab engkau akan masuk bersama-sama dengan bangsa ini ke negeri yang dijanjikan TUHAN dengan sumpah kepada nenek moyang mereka untuk memberikannya kepada mereka, dan engkau akan memimpin mereka sampai mereka memilikinya."
 },
 {
   "id": 5738,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 8,
   "firman": "Sebab TUHAN, Dia sendiri akan berjalan di depanmu, Dia sendiri akan menyertai engkau, Dia tidak akan membiarkan engkau dan tidak akan meninggalkan engkau; janganlah takut dan janganlah patah hati.\""
 },
 {
   "id": 5739,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 9,
   "firman": "Setelah hukum Taurat itu dituliskan Musa, maka diberikannyalah kepada imam-imam bani Lewi, yang mengangkut tabut perjanjian TUHAN, dan kepada segala tua-tua Israel."
 },
 {
   "id": 5740,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 10,
   "firman": "Dan Musa memerintahkan kepada mereka, demikian: \"Pada akhir tujuh tahun, pada waktu yang telah ditetapkan dalam tahun penghapusan hutang, yakni hari raya Pondok Daun,"
 },
 {
   "id": 5741,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 11,
   "firman": "apabila seluruh orang Israel datang menghadap hadirat TUHAN, Allahmu, di tempat yang akan dipilih-Nya, maka haruslah engkau membacakan hukum Taurat ini di depan seluruh orang Israel."
 },
 {
   "id": 5742,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 12,
   "firman": "Seluruh bangsa itu berkumpul, laki-laki, perempuan dan anak-anak, dan orang asing yang diam di dalam tempatmu, supaya mereka mendengarnya dan belajar takut akan TUHAN, Allahmu, dan mereka melakukan dengan setia segala perkataan hukum Taurat ini,"
 },
 {
   "id": 5743,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 13,
   "firman": "dan supaya anak-anak mereka, yang tidak mengetahuinya, dapat mendengarnya dan belajar takut akan TUHAN, Allahmu, --selama kamu hidup di tanah, ke mana kamu pergi, menyeberangi sungai Yordan untuk mendudukinya.\""
 },
 {
   "id": 5744,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 14,
   "firman": "Kemudian berfirmanlah TUHAN kepada Musa: \"Sesungguhnya sudah dekat waktunya bahwa engkau akan mati; maka panggillah Yosua dan berdirilah bersama-sama dengan dia dalam Kemah Pertemuan, supaya Aku memberi perintah kepadanya.\" Lalu pergilah Musa dan Yosua berdiri dalam Kemah Pertemuan."
 },
 {
   "id": 5745,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 15,
   "firman": "Dan TUHAN menampakkan diri di kemah itu dalam tiang awan, dan tiang awan itu berdiri pada pintu kemah."
 },
 {
   "id": 5746,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 16,
   "firman": "TUHAN berfirman kepada Musa: \"Ketahuilah, engkau akan mendapat perhentian bersama-sama dengan nenek moyangmu dan bangsa ini akan bangkit dan berzinah dengan mengikuti allah asing yang ada di negeri, ke mana mereka akan masuk; mereka akan meninggalkan Aku dan mengingkari perjanjian-Ku yang Kuikat dengan mereka."
 },
 {
   "id": 5747,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 17,
   "firman": "Pada waktu itu murka-Ku akan bernyala-nyala terhadap mereka, Aku akan meninggalkan mereka dan menyembunyikan wajah-Ku terhadap mereka, sehingga mereka termakan habis dan banyak kali ditimpa malapetaka serta kesusahan. Maka pada waktu itu mereka akan berkata: Bukankah malapetaka itu menimpa kita, oleh sebab Allah kita tidak ada di tengah-tengah kita?"
 },
 {
   "id": 5748,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 18,
   "firman": "Tetapi Aku akan menyembunyikan wajah-Ku sama sekali pada waktu itu, karena segala kejahatan yang telah dilakukan mereka: yakni mereka telah berpaling kepada allah lain."
 },
 {
   "id": 5749,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 19,
   "firman": "Oleh sebab itu tuliskanlah nyanyian ini dan ajarkanlah kepada orang Israel, letakkanlah di dalam mulut mereka, supaya nyanyian ini menjadi saksi bagi-Ku terhadap orang Israel."
 },
 {
   "id": 5750,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 20,
   "firman": "Sebab Aku akan membawa mereka ke tanah yang Kujanjikan dengan sumpah kepada nenek moyang mereka, yakni tanah yang berlimpah-limpah susu dan madunya; mereka akan makan dan kenyang dan menjadi gemuk, tetapi mereka akan berpaling kepada allah lain dan beribadah kepadanya. Aku ini akan dinista mereka dan perjanjian-Ku akan diingkari mereka."
 },
 {
   "id": 5751,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 21,
   "firman": "Maka apabila banyak kali mereka ditimpa malapetaka serta kesusahan, maka nyanyian ini akan menjadi kesaksian terhadap mereka, sebab nyanyian ini akan tetap melekat pada bibir keturunan mereka. Sebab Aku tahu niat yang dikandung mereka pada hari ini, sebelum Aku membawa mereka ke negeri yang Kujanjikan dengan sumpah kepada mereka.\""
 },
 {
   "id": 5752,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 22,
   "firman": "Maka Musa menuliskan nyanyian ini dan mengajarkannya kepada orang Israel."
 },
 {
   "id": 5753,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 23,
   "firman": "Kepada Yosua bin Nun diberi-Nya perintah, firman-Nya: \"Kuatkan dan teguhkanlah hatimu, sebab engkau akan membawa orang Israel ke negeri yang Kujanjikan dengan sumpah kepada mereka, dan Aku akan menyertai engkau.\""
 },
 {
   "id": 5754,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 24,
   "firman": "Ketika Musa selesai menuliskan perkataan hukum Taurat itu dalam sebuah kitab sampai perkataan yang penghabisan,"
 },
 {
   "id": 5755,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 25,
   "firman": "maka Musa memerintahkan kepada orang-orang Lewi pengangkut tabut perjanjian TUHAN, demikian:"
 },
 {
   "id": 5756,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 26,
   "firman": "\"Ambillah kitab Taurat ini dan letakkanlah di samping tabut perjanjian TUHAN, Allahmu, supaya menjadi saksi di situ terhadap engkau."
 },
 {
   "id": 5757,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 27,
   "firman": "Sebab aku mengenal kedegilan dan tegar tengkukmu. Sedangkan sekarang, selagi aku hidup bersama-sama dengan kamu, kamu sudah menunjukkan kedegilanmu terhadap TUHAN, terlebih lagi nanti sesudah aku mati."
 },
 {
   "id": 5758,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 28,
   "firman": "Suruhlah berkumpul kepadaku segala tua-tua sukumu dan para pengatur pasukanmu, maka aku akan mengatakan hal yang berikut kepada mereka dan memanggil langit dan bumi menjadi saksi terhadap mereka."
 },
 {
   "id": 5759,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 29,
   "firman": "Sebab aku tahu, bahwa sesudah aku mati, kamu akan berlaku sangat busuk dan akan menyimpang dari jalan yang telah kuperintahkan kepadamu. Sebab itu di kemudian hari malapetaka akan menimpa kamu, apabila kamu berbuat yang jahat di mata TUHAN, dan menimbulkan sakit hati-Nya dengan perbuatan tanganmu.\""
 },
 {
   "id": 5760,
   "kitab": "Ula",
   "pasal": 31,
   "ayat": 30,
   "firman": "Lalu Musa menyampaikan ke telinga seluruh jemaah Israel nyanyian ini sampai perkataan yang penghabisan."
 },
 {
   "id": 5761,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 1,
   "firman": "\"Pasanglah telingamu, hai langit, aku mau berbicara, dan baiklah bumi mendengarkan ucapan mulutku."
 },
 {
   "id": 5762,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 2,
   "firman": "Mudah-mudahan pengajaranku menitik laksana hujan, perkataanku menetes laksana embun, laksana hujan renai ke atas tunas muda, dan laksana dirus hujan ke atas tumbuh-tumbuhan."
 },
 {
   "id": 5763,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 3,
   "firman": "Sebab nama TUHAN akan kuserukan: Berilah hormat kepada Allah kita,"
 },
 {
   "id": 5764,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 4,
   "firman": "Gunung Batu, yang pekerjaan-Nya sempurna, karena segala jalan-Nya adil, Allah yang setia, dengan tiada kecurangan, adil dan benar Dia."
 },
 {
   "id": 5765,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 5,
   "firman": "Berlaku busuk terhadap Dia, mereka yang bukan lagi anak-anak-Nya, yang merupakan noda, suatu angkatan yang bengkok dan belat-belit."
 },
 {
   "id": 5766,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 6,
   "firman": "Demikianlah engkau mengadakan pembalasan terhadap TUHAN, hai bangsa yang bebal dan tidak bijaksana? Bukankah Ia Bapamu yang mencipta engkau, yang menjadikan dan menegakkan engkau?"
 },
 {
   "id": 5767,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 7,
   "firman": "Ingatlah kepada zaman dahulu kala, perhatikanlah tahun-tahun keturunan yang lalu, tanyakanlah kepada ayahmu, maka ia memberitahukannya kepadamu, kepada para tua-tuamu, maka mereka mengatakannya kepadamu."
 },
 {
   "id": 5768,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 8,
   "firman": "Ketika Sang Mahatinggi membagi-bagikan milik pusaka kepada bangsa-bangsa, ketika Ia memisah-misah anak-anak manusia, maka Ia menetapkan wilayah bangsa-bangsa menurut bilangan anak-anak Israel."
 },
 {
   "id": 5769,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 9,
   "firman": "Tetapi bagian TUHAN ialah umat-Nya, Yakub ialah milik yang ditetapkan bagi-Nya."
 },
 {
   "id": 5770,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 10,
   "firman": "Didapati-Nya dia di suatu negeri, di padang gurun, di tengah-tengah ketandusan dan auman padang belantara. Dikelilingi-Nya dia dan diawasi-Nya, dijaga-Nya sebagai biji mata-Nya."
 },
 {
   "id": 5771,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 11,
   "firman": "Laksana rajawali menggoyangbangkitkan isi sarangnya, melayang-layang di atas anak-anaknya, mengembangkan sayapnya, menampung seekor, dan mendukungnya di atas kepaknya,"
 },
 {
   "id": 5772,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 12,
   "firman": "demikianlah TUHAN sendiri menuntun dia, dan tidak ada allah asing menyertai dia."
 },
 {
   "id": 5773,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 13,
   "firman": "Dibuat-Nya dia berkendaraan mengatasi bukit-bukit di bumi, dan memakan hasil dari ladang; dibuat-Nya dia mengisap madu dari bukit batu, dan minyak dari gunung batu yang keras,"
 },
 {
   "id": 5774,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 14,
   "firman": "dadih dari lembu sapi dan susu kambing domba, dengan lemak anak-anak domba; dan domba-domba jantan dari Basan dan kambing-kambing jantan, dengan gandum yang terbaik; juga darah buah anggur yang berbuih engkau minum."
 },
 {
   "id": 5775,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 15,
   "firman": "Lalu menjadi gemuklah Yesyurun, dan menendang ke belakang, --bertambah gemuk engkau, gendut dan tambun--dan ia meninggalkan Allah yang telah menjadikan dia, ia memandang rendah gunung batu keselamatannya."
 },
 {
   "id": 5776,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 16,
   "firman": "Mereka membangkitkan cemburu-Nya dengan allah asing, mereka menimbulkan sakit hati-Nya dengan dewa kekejian,"
 },
 {
   "id": 5777,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 17,
   "firman": "mereka mempersembahkan korban kepada roh-roh jahat yang bukan Allah, kepada allah yang tidak mereka kenal, allah baru yang belum lama timbul, yang kepadanya nenek moyangmu tidak gentar."
 },
 {
   "id": 5778,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 18,
   "firman": "Gunung batu yang memperanakkan engkau, telah kaulalaikan, dan telah kaulupakan Allah yang melahirkan engkau."
 },
 {
   "id": 5779,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 19,
   "firman": "Ketika TUHAN melihat hal itu, maka Ia menolak mereka, karena Ia sakit hati oleh anak-anaknya lelaki dan perempuan."
 },
 {
   "id": 5780,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 20,
   "firman": "Ia berfirman: Aku hendak menyembunyikan wajah-Ku terhadap mereka, dan melihat bagaimana kesudahan mereka, sebab mereka itu suatu angkatan yang bengkok, anak-anak yang tidak mempunyai kesetiaan."
 },
 {
   "id": 5781,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 21,
   "firman": "Mereka membangkitkan cemburu-Ku dengan yang bukan Allah, mereka menimbulkan sakit hati-Ku dengan berhala mereka. Sebab itu Aku akan membangkitkan cemburu mereka dengan yang bukan umat, dan akan menyakiti hati mereka dengan bangsa yang bebal."
 },
 {
   "id": 5782,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 22,
   "firman": "Sebab api telah dinyalakan oleh murka-Ku, dan bernyala-nyala sampai ke bagian dunia orang mati yang paling bawah; api itu memakan bumi dengan hasilnya, dan menghanguskan dasar gunung-gunung."
 },
 {
   "id": 5783,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 23,
   "firman": "Aku akan menimbun malapetaka ke atas mereka, seluruh anak panah-Ku akan Kutembakkan kepada mereka."
 },
 {
   "id": 5784,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 24,
   "firman": "Apabila mereka sudah lemas karena lapar dan merana oleh demam yang membara, dan oleh penyakit sampar, maka Aku akan melepaskan taring binatang buas kepada mereka, dengan racun binatang yang menjalar di dalam debu."
 },
 {
   "id": 5785,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 25,
   "firman": "Pedang di luar rumah dan kengerian di dalam kamar akan melenyapkan teruna maupun dara, anak menyusu serta orang ubanan."
 },
 {
   "id": 5786,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 26,
   "firman": "Seharusnya Aku berfirman: Aku meniupkan mereka, melenyapkan ingatan kepada mereka dari antara manusia,"
 },
 {
   "id": 5787,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 27,
   "firman": "tetapi Aku kuatir disakiti hati-Ku oleh musuh, jangan-jangan lawan mereka salah mengerti, jangan-jangan mereka berkata: Tangan kami jaya, bukanlah TUHAN yang melakukan semuanya ini."
 },
 {
   "id": 5788,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 28,
   "firman": "Sebab mereka itu suatu bangsa yang tidak punya pertimbangan, dan tidak ada pengertian pada mereka."
 },
 {
   "id": 5789,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 29,
   "firman": "Sekiranya mereka bijaksana, tentulah mereka mengerti hal ini, dan memperhatikan kesudahan mereka."
 },
 {
   "id": 5790,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 30,
   "firman": "Bagaimana mungkin satu orang dapat mengejar seribu orang, dan dua orang dapat membuat lari sepuluh ribu orang, kalau tidak gunung batu mereka telah menjual mereka, dan TUHAN telah menyerahkan mereka!"
 },
 {
   "id": 5791,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 31,
   "firman": "Sebab bukanlah seperti gunung batu kita gunung batu orang-orang itu; musuh kita boleh menjadi hakim!"
 },
 {
   "id": 5792,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 32,
   "firman": "Sesungguhnya, pohon anggur mereka berasal dari pohon anggur Sodom, dan dari kebun-kebun Gomora; buah anggur mereka adalah buah anggur yang beracun, pahit gugusan-gugusannya."
 },
 {
   "id": 5793,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 33,
   "firman": "Air anggur mereka adalah racun ular, dan bisa ular tedung yang keras ganas."
 },
 {
   "id": 5794,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 34,
   "firman": "Bukankah hal itu tersimpan pada-Ku, termeterai dalam perbendaharaan-Ku?"
 },
 {
   "id": 5795,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 35,
   "firman": "Hak-Kulah dendam dan pembalasan, pada waktu kaki mereka goyang, sebab hari bencana bagi mereka telah dekat, akan segera datang apa yang telah disediakan bagi mereka."
 },
 {
   "id": 5796,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 36,
   "firman": "Sebab TUHAN akan memberi keadilan kepada umat-Nya, dan akan merasa sayang kepada hamba-hamba-Nya; apabila dilihat-Nya, bahwa kekuatan mereka sudah lenyap, dan baik hamba maupun orang merdeka sudah tiada."
 },
 {
   "id": 5797,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 37,
   "firman": "Maka Ia akan berfirman: Di manakah allah mereka, --gunung batu tempat mereka berlindung--"
 },
 {
   "id": 5798,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 38,
   "firman": "yang memakan lemak dari korban sembelihan mereka, meminum anggur dari korban curahan mereka? Biarlah mereka bangkit untuk menolong kamu, sehingga kamu mendapat perlindungan."
 },
 {
   "id": 5799,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 39,
   "firman": "Lihatlah sekarang, bahwa Aku, Akulah Dia. Tidak ada Allah kecuali Aku. Akulah yang mematikan dan yang menghidupkan, Aku telah meremukkan, tetapi Akulah yang menyembuhkan, dan seorangpun tidak ada yang dapat melepaskan dari tangan-Ku."
 },
 {
   "id": 5800,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 40,
   "firman": "Sesungguhnya, Aku mengangkat tangan-Ku ke langit, dan berfirman: Demi Aku yang hidup selama-lamanya,"
 },
 {
   "id": 5801,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 41,
   "firman": "apabila Aku mengasah pedang-Ku yang berkilat-kilat, dan tangan-Ku memegang penghukuman, maka Aku membalas dendam kepada lawan-Ku, dan mengadakan pembalasan kepada yang membenci Aku."
 },
 {
   "id": 5802,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 42,
   "firman": "Aku akan memabukkan anak panah-Ku dengan darah, dan pedang-Ku akan memakan daging: darah orang-orang yang mati tertikam dan orang-orang yang tertawan, dari kepala-kepala musuh yang berambut panjang."
 },
 {
   "id": 5803,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 43,
   "firman": "Bersorak-sorailah, hai bangsa-bangsa karena umat-Nya, sebab Ia membalaskan darah hamba-hamba-Nya, Ia membalas dendam kepada lawan-Nya, dan mengadakan pendamaian bagi tanah umat-Nya.\""
 },
 {
   "id": 5804,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 44,
   "firman": "Lalu datanglah Musa bersama-sama dengan Yosua bin Nun dan menyampaikan ke telinga bangsa itu segala perkataan nyanyian tadi."
 },
 {
   "id": 5805,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 45,
   "firman": "Setelah Musa selesai menyampaikan segala perkataan itu kepada seluruh orang Israel,"
 },
 {
   "id": 5806,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 46,
   "firman": "berkatalah ia kepada mereka: \"Perhatikanlah segala perkataan yang kuperingatkan kepadamu pada hari ini, supaya kamu memerintahkannya kepada anak-anakmu untuk melakukan dengan setia segala perkataan hukum Taurat ini."
 },
 {
   "id": 5807,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 47,
   "firman": "Sebab perkataan ini bukanlah perkataan hampa bagimu, tetapi itulah hidupmu, dan dengan perkataan ini akan lanjut umurmu di tanah, ke mana kamu pergi, menyeberangi sungai Yordan untuk mendudukinya.\""
 },
 {
   "id": 5808,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 48,
   "firman": "Pada hari itulah juga TUHAN berfirman kepada Musa:"
 },
 {
   "id": 5809,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 49,
   "firman": "\"Naiklah ke atas pegunungan Abarim, ke atas gunung Nebo, yang di tanah Moab, di tentangan Yerikho, dan pandanglah tanah Kanaan yang Kuberikan kepada orang Israel menjadi miliknya,"
 },
 {
   "id": 5810,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 50,
   "firman": "kemudian engkau akan mati di atas gunung yang akan kaunaiki itu, supaya engkau dikumpulkan kepada kaum leluhurmu, sama seperti Harun, kakakmu, sudah meninggal di gunung Hor dan dikumpulkan kepada kaum leluhurnya--"
 },
 {
   "id": 5811,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 51,
   "firman": "oleh sebab kamu telah berubah setia terhadap Aku di tengah-tengah orang Israel, dekat mata air Meriba di Kadesh di padang gurun Zin, dan oleh sebab kamu tidak menghormati kekudusan-Ku di tengah-tengah orang Israel."
 },
 {
   "id": 5812,
   "kitab": "Ula",
   "pasal": 32,
   "ayat": 52,
   "firman": "Engkau boleh melihat negeri itu terbentang di depanmu, tetapi tidak boleh masuk ke sana, ke negeri yang Kuberikan kepada orang Israel.\""
 },
 {
   "id": 5813,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 1,
   "firman": "Inilah berkat yang diberikan Musa, abdi Allah itu, kepada orang Israel sebelum ia mati."
 },
 {
   "id": 5814,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 2,
   "firman": "Berkatalah ia: \"TUHAN datang dari Sinai dan terbit kepada mereka dari Seir; Ia tampak bersinar dari pegunungan Paran dan datang dari tengah-tengah puluhan ribu orang yang kudus; di sebelah kanan-Nya tampak kepada mereka api yang menyala."
 },
 {
   "id": 5815,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 3,
   "firman": "Sungguh Ia mengasihi umat-Nya; semua orang-Nya yang kudus--di dalam tangan-Mulah mereka, pada kaki-Mulah mereka duduk, menangkap sesuatu dari firman-Mu."
 },
 {
   "id": 5816,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 4,
   "firman": "Musa telah memerintahkan hukum Taurat kepada kita, suatu milik bagi jemaah Yakub."
 },
 {
   "id": 5817,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 5,
   "firman": "Ia menjadi raja di Yesyurun, ketika kepala-kepala bangsa datang berkumpul, yakni segala suku Israel bersama-sama."
 },
 {
   "id": 5818,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 6,
   "firman": "Biarlah Ruben hidup dan jangan mati, tetapi biarlah orang-orangnya sedikit jumlahnya.\""
 },
 {
   "id": 5819,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 7,
   "firman": "Dan inilah tentang Yehuda. Katanya: \"Dengarlah, ya TUHAN, suara Yehuda dan bawalah dia kepada bangsanya. Berjuanglah baginya dengan tangan-Mu, dan jadilah Engkau penolongnya melawan musuhnya.\""
 },
 {
   "id": 5820,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 8,
   "firman": "Tentang Lewi ia berkata: \"Biarlah Tumim dan Urim-Mu menjadi kepunyaan orang yang Kaukasihi, yang telah Kaucoba di Masa, dengan siapa Engkau berbantah dekat mata air Meriba;"
 },
 {
   "id": 5821,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 9,
   "firman": "yang berkata tentang ayahnya dan tentang ibunya: aku tidak mengindahkan mereka; ia yang tidak mau kenal saudara-saudaranya dan acuh tak acuh terhadap anak-anaknya. Sebab orang-orang Lewi itu berpegang pada firman-Mu dan menjaga perjanjian-Mu;"
 },
 {
   "id": 5822,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 10,
   "firman": "mereka mengajarkan peraturan-peraturan-Mu kepada Yakub, hukum-Mu kepada Israel; mereka menaruh ukupan wangi-wangian di depan-Mu dan korban yang terbakar seluruhnya di atas mezbah-Mu."
 },
 {
   "id": 5823,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 11,
   "firman": "Berkatilah, ya TUHAN, kekuatannya dan berkenanlah kepada pekerjaannya. Remukkanlah pinggang orang yang melawan dia dan yang membenci dia, sehingga mereka tidak dapat bangkit.\""
 },
 {
   "id": 5824,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 12,
   "firman": "Tentang Benyamin ia berkata: \"Kekasih TUHAN yang diam pada-Nya dengan tenteram! TUHAN melindungi dia setiap waktu dan diam di antara lereng-lereng gunungnya.\""
 },
 {
   "id": 5825,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 13,
   "firman": "Tentang Yusuf ia berkata: \"Kiranya negerinya diberkati oleh TUHAN dengan yang terbaik dari langit, dengan air embun, dan dengan air samudera raya yang ada di bawah;"
 },
 {
   "id": 5826,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 14,
   "firman": "dengan yang terbaik dari yang dihasilkan matahari, dan dengan yang terbaik dari yang ditumbuhkan bulan;"
 },
 {
   "id": 5827,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 15,
   "firman": "dengan yang terutama dari gunung-gunung yang sejak dahulu, dan dengan yang terbaik dari bukit-bukit yang berabad-abad,"
 },
 {
   "id": 5828,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 16,
   "firman": "dan dengan yang terbaik dari bumi serta segala isinya; dengan perkenanan Dia yang diam dalam semak duri. Biarlah itu semuanya turun ke atas kepala Yusuf, ke atas batu kepala orang yang teristimewa di antara saudara-saudaranya."
 },
 {
   "id": 5829,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 17,
   "firman": "Anak sulung lembu sapinya adalah kegemilangannya dan tanduk-tanduknya seperti tanduk-tanduk lembu hutan; dengan itu ia akan menanduk bangsa-bangsa, seluruh bumi, dari ujung ke ujung. Itulah orang Efraim yang puluhan ribu, dan itulah orang Manasye yang ribuan.\""
 },
 {
   "id": 5830,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 18,
   "firman": "Tentang Zebulon ia berkata: \"Bersukacitalah, hai Zebulon, atas perjalanan-perjalananmu, dan engkaupun, hai Isakhar, atas kemah-kemahmu."
 },
 {
   "id": 5831,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 19,
   "firman": "Bangsa-bangsa akan dipanggil mereka datang ke gunung; di sanalah mereka akan mempersembahkan korban sembelihan yang benar, sebab mereka akan mengisap kelimpahan laut dan harta yang terpendam di dalam pasir.\""
 },
 {
   "id": 5832,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 20,
   "firman": "Tentang Gad ia berkata: \"Terpujilah Dia yang memberi kelapangan kepada Gad. Seperti singa betina ia diam dan menerkam lengan, bahkan batu kepala."
 },
 {
   "id": 5833,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 21,
   "firman": "Ia memilih bagian yang terutama, sebab di sanalah tersimpan bagian panglima; ia datang kepada para kepala bangsa itu; dilakukannya kebenaran TUHAN serta penghukuman-penghukuman-Nya bersama-sama dengan orang Israel.\""
 },
 {
   "id": 5834,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 22,
   "firman": "Tentang Dan ia berkata: \"Adapun Dan ialah anak singa yang melompat keluar dari Basan.\""
 },
 {
   "id": 5835,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 23,
   "firman": "Tentang Naftali ia berkata: \"Naftali kenyang dengan perkenanan dan penuh dengan berkat TUHAN; milikilah tasik dan wilayah sebelah selatan.\""
 },
 {
   "id": 5836,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 24,
   "firman": "Tentang Asyer ia berkata: \"Diberkatilah Asyer di antara anak-anak lelaki; biarlah ia disukai oleh saudara-saudaranya, dan biarlah ia mencelupkan kakinya ke dalam minyak."
 },
 {
   "id": 5837,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 25,
   "firman": "Biarlah dari besi dan dari tembaga palang pintumu, selama umurmu kiranya kekuatanmu."
 },
 {
   "id": 5838,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 26,
   "firman": "Tidak ada yang seperti Allah, hai Yesyurun. Ia berkendaraan melintasi langit sebagai penolongmu dan dalam kejayaan-Nya melintasi awan-awan."
 },
 {
   "id": 5839,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 27,
   "firman": "Allah yang abadi adalah tempat perlindunganmu, dan di bawahmu ada lengan-lengan yang kekal. Ia mengusir musuh dari depanmu dan berfirman: Punahkanlah!"
 },
 {
   "id": 5840,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 28,
   "firman": "Maka Israel diam dengan tenteram dan sumber Yakub diam tidak terganggu di dalam suatu negeri yang ada gandum dan anggur; bahkan langitnya menitikkan embun."
 },
 {
   "id": 5841,
   "kitab": "Ula",
   "pasal": 33,
   "ayat": 29,
   "firman": "Berbahagialah engkau, hai Israel; siapakah yang sama dengan engkau? Suatu bangsa yang diselamatkan oleh TUHAN, perisai pertolongan dan pedang kejayaanmu. Sebab itu musuhmu akan tunduk menjilat kepadamu, dan engkau akan berjejak di bukit-bukit mereka.\""
 },
 {
   "id": 5842,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 1,
   "firman": "Kemudian naiklah Musa dari dataran Moab ke atas gunung Nebo, yakni ke atas puncak Pisga, yang di tentangan Yerikho, lalu TUHAN memperlihatkan kepadanya seluruh negeri itu: daerah Gilead sampai ke kota Dan,"
 },
 {
   "id": 5843,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 2,
   "firman": "seluruh Naftali, tanah Efraim dan Manasye, seluruh tanah Yehuda sampai laut sebelah barat,"
 },
 {
   "id": 5844,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 3,
   "firman": "Tanah Negeb dan lembah Yordan, lembah Yerikho, kota pohon korma itu, sampai Zoar."
 },
 {
   "id": 5845,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 4,
   "firman": "Dan berfirmanlah TUHAN kepadanya: \"Inilah negeri yang Kujanjikan dengan sumpah kepada Abraham, Ishak dan Yakub; demikian: Kepada keturunanmulah akan Kuberikan negeri itu. Aku mengizinkan engkau melihatnya dengan matamu sendiri, tetapi engkau tidak akan menyeberang ke sana.\""
 },
 {
   "id": 5846,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 5,
   "firman": "Lalu matilah Musa, hamba TUHAN itu, di sana di tanah Moab, sesuai dengan firman TUHAN."
 },
 {
   "id": 5847,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 6,
   "firman": "Dan dikuburkan-Nyalah dia di suatu lembah di tanah Moab, di tentangan Bet-Peor, dan tidak ada orang yang tahu kuburnya sampai hari ini."
 },
 {
   "id": 5848,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 7,
   "firman": "Musa berumur seratus dua puluh tahun, ketika ia mati; matanya belum kabur dan kekuatannya belum hilang."
 },
 {
   "id": 5849,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 8,
   "firman": "Orang Israel menangisi Musa di dataran Moab tiga puluh hari lamanya. Maka berakhirlah hari-hari tangis perkabungan karena Musa itu."
 },
 {
   "id": 5850,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 9,
   "firman": "Dan Yosua bin Nun penuh dengan roh kebijaksanaan, sebab Musa telah meletakkan tangannya ke atasnya. Sebab itu orang Israel mendengarkan dia dan melakukan seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 5851,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 10,
   "firman": "Seperti Musa yang dikenal TUHAN dengan berhadapan muka, tidak ada lagi nabi yang bangkit di antara orang Israel,"
 },
 {
   "id": 5852,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 11,
   "firman": "dalam hal segala tanda dan mujizat, yang dilakukannya atas perintah TUHAN di tanah Mesir terhadap Firaun dan terhadap semua pegawainya dan seluruh negerinya,"
 },
 {
   "id": 5853,
   "kitab": "Ula",
   "pasal": 34,
   "ayat": 12,
   "firman": "dan dalam hal segala perbuatan kekuasaan dan segala kedahsyatan yang besar yang dilakukan Musa di depan seluruh orang Israel."
 },
 {
   "id": 5854,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 1,
   "firman": "Sesudah Musa hamba TUHAN itu mati, berfirmanlah TUHAN kepada Yosua bin Nun, abdi Musa itu, demikian:"
 },
 {
   "id": 5855,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Hamba-Ku Musa telah mati; sebab itu bersiaplah sekarang, seberangilah sungai Yordan ini, engkau dan seluruh bangsa ini, menuju negeri yang akan Kuberikan kepada mereka, kepada orang Israel itu."
 },
 {
   "id": 5856,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 3,
   "firman": "Setiap tempat yang akan diinjak oleh telapak kakimu Kuberikan kepada kamu, seperti yang telah Kujanjikan kepada Musa."
 },
 {
   "id": 5857,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dari padang gurun dan gunung Libanon yang sebelah sana itu sampai ke sungai besar, yakni sungai Efrat, seluruh tanah orang Het, sampai ke Laut Besar di sebelah matahari terbenam, semuanya itu akan menjadi daerahmu."
 },
 {
   "id": 5858,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 5,
   "firman": "Seorangpun tidak akan dapat bertahan menghadapi engkau seumur hidupmu; seperti Aku menyertai Musa, demikianlah Aku akan menyertai engkau; Aku tidak akan membiarkan engkau dan tidak akan meninggalkan engkau."
 },
 {
   "id": 5859,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kuatkan dan teguhkanlah hatimu, sebab engkaulah yang akan memimpin bangsa ini memiliki negeri yang Kujanjikan dengan bersumpah kepada nenek moyang mereka untuk diberikan kepada mereka."
 },
 {
   "id": 5860,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 7,
   "firman": "Hanya, kuatkan dan teguhkanlah hatimu dengan sungguh-sungguh, bertindaklah hati-hati sesuai dengan seluruh hukum yang telah diperintahkan kepadamu oleh hamba-Ku Musa; janganlah menyimpang ke kanan atau ke kiri, supaya engkau beruntung, ke manapun engkau pergi."
 },
 {
   "id": 5861,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 8,
   "firman": "Janganlah engkau lupa memperkatakan kitab Taurat ini, tetapi renungkanlah itu siang dan malam, supaya engkau bertindak hati-hati sesuai dengan segala yang tertulis di dalamnya, sebab dengan demikian perjalananmu akan berhasil dan engkau akan beruntung."
 },
 {
   "id": 5862,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 9,
   "firman": "Bukankah telah Kuperintahkan kepadamu: kuatkan dan teguhkanlah hatimu? Janganlah kecut dan tawar hati, sebab TUHAN, Allahmu, menyertai engkau, ke manapun engkau pergi.\""
 },
 {
   "id": 5863,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 10,
   "firman": "Lalu Yosua memberi perintah kepada pengatur-pengatur pasukan bangsa itu, katanya:"
 },
 {
   "id": 5864,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 11,
   "firman": "\"Jalanilah seluruh perkemahan dan perintahkanlah kepada bangsa itu, demikian: Sediakanlah bekalmu, sebab dalam tiga hari kamu akan menyeberangi sungai Yordan ini untuk pergi menduduki negeri yang akan diberikan TUHAN, Allahmu, kepadamu untuk diduduki.\""
 },
 {
   "id": 5865,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 12,
   "firman": "Kepada orang Ruben, kepada orang Gad dan kepada suku Manasye yang setengah itu berkatalah Yosua, demikian:"
 },
 {
   "id": 5866,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 13,
   "firman": "\"Ingatlah kepada perkataan yang dipesankan Musa, hamba TUHAN itu, kepadamu, yakni: TUHAN, Allahmu, mengaruniakan keamanan kepadamu dan memberikan kepadamu negeri ini;"
 },
 {
   "id": 5867,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 14,
   "firman": "perempuan-perempuan dan anak-anak di antara kamu dan ternakmu boleh tinggal di negeri yang diberikan Musa kepadamu di seberang sungai Yordan, tetapi kamu, semua pahlawan yang gagah perkasa, haruslah menyeberang di depan saudara-saudaramu dengan bersenjata, dan haruslah menolong mereka,"
 },
 {
   "id": 5868,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 15,
   "firman": "sampai TUHAN mengaruniakan keamanan kepada saudara-saudaramu seperti kepada kamu juga, dan mereka juga menduduki negeri yang akan diberikan kepada mereka oleh TUHAN, Allahmu. Kemudian bolehlah kamu pulang kembali ke negerimu sendiri dan menduduki negeri yang diberikan Musa, hamba TUHAN itu, kepadamu di seberang sungai Yordan, di sebelah matahari terbit.\""
 },
 {
   "id": 5869,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 16,
   "firman": "Lalu mereka menjawab Yosua, katanya: \"Segala yang kauperintahkan kepada kami akan kami lakukan dan ke manapun kami akan kausuruh, kami akan pergi;"
 },
 {
   "id": 5870,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 17,
   "firman": "sama seperti kami mendengarkan perintah Musa, demikianlah kami akan mendengarkan perintahmu. Hanya, TUHAN, Allahmu, kiranya menyertai engkau, seperti Ia menyertai Musa."
 },
 {
   "id": 5871,
   "kitab": "Yos",
   "pasal": 1,
   "ayat": 18,
   "firman": "Setiap orang yang menentang perintahmu dan tidak mendengarkan perkataanmu, apapun yang kauperintahkan kepadanya, dia akan dihukum mati. Hanya, kuatkan dan teguhkanlah hatimu!\""
 },
 {
   "id": 5872,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 1,
   "firman": "Yosua bin Nun dengan diam-diam melepas dari Sitim dua orang pengintai, katanya: \"Pergilah, amat-amatilah negeri itu dan kota Yerikho.\" Maka pergilah mereka dan sampailah mereka ke rumah seorang perempuan sundal, yang bernama Rahab, lalu tidur di situ."
 },
 {
   "id": 5873,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 2,
   "firman": "Kemudian diberitahukanlah kepada raja Yerikho, demikian: \"Tadi malam ada orang datang ke mari dari orang Israel untuk menyelidik negeri ini.\""
 },
 {
   "id": 5874,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 3,
   "firman": "Maka raja Yerikho menyuruh orang kepada Rahab, mengatakan: \"Bawalah ke luar orang-orang yang datang kepadamu itu, yang telah masuk ke dalam rumahmu, sebab mereka datang untuk menyelidik seluruh negeri ini.\""
 },
 {
   "id": 5875,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 4,
   "firman": "Tetapi perempuan itu telah membawa dan menyembunyikan kedua orang itu. Berkatalah ia: \"Memang, orang-orang itu telah datang kepadaku, tetapi aku tidak tahu dari mana mereka,"
 },
 {
   "id": 5876,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 5,
   "firman": "dan ketika pintu gerbang hendak ditutup menjelang malam, maka keluarlah orang-orang itu; aku tidak tahu, ke mana orang-orang itu pergi. Segeralah kejar mereka, tentulah kamu dapat menyusul mereka.\""
 },
 {
   "id": 5877,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tetapi perempuan itu telah menyuruh keduanya naik ke sotoh rumah dan menyembunyikan mereka di bawah timbunan batang rami, yang ditebarkan di atas sotoh itu."
 },
 {
   "id": 5878,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 7,
   "firman": "Maka pergilah orang-orang itu, mengejar mereka ke arah sungai Yordan, ke tempat-tempat penyeberangan, dan ditutuplah pintu gerbang, segera sesudah pengejar-pengejar itu keluar."
 },
 {
   "id": 5879,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 8,
   "firman": "Tetapi sebelum kedua orang itu tidur, naiklah perempuan itu mendapatkan mereka di atas sotoh"
 },
 {
   "id": 5880,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 9,
   "firman": "dan berkata kepada orang-orang itu: \"Aku tahu, bahwa TUHAN telah memberikan negeri ini kepada kamu dan bahwa kengerian terhadap kamu telah menghinggapi kami dan segala penduduk negeri ini gemetar menghadapi kamu."
 },
 {
   "id": 5881,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 10,
   "firman": "Sebab kami mendengar, bahwa TUHAN telah mengeringkan air Laut Teberau di depan kamu, ketika kamu berjalan keluar dari Mesir, dan apa yang kamu lakukan kepada kedua raja orang Amori yang di seberang sungai Yordan itu, yakni kepada Sihon dan Og, yang telah kamu tumpas."
 },
 {
   "id": 5882,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 11,
   "firman": "Ketika kami mendengar itu, tawarlah hati kami dan jatuhlah semangat setiap orang menghadapi kamu, sebab TUHAN, Allahmu, ialah Allah di langit di atas dan di bumi di bawah."
 },
 {
   "id": 5883,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 12,
   "firman": "Maka sekarang, bersumpahlah kiranya demi TUHAN, bahwa karena aku telah berlaku ramah terhadapmu, kamu juga akan berlaku ramah terhadap kaum keluargaku; dan berikanlah kepadaku suatu tanda yang dapat dipercaya,"
 },
 {
   "id": 5884,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 13,
   "firman": "bahwa kamu akan membiarkan hidup ayah dan ibuku, saudara-saudaraku yang laki-laki dan yang perempuan dan semua orang-orang mereka dan bahwa kamu akan menyelamatkan nyawa kami dari maut.\""
 },
 {
   "id": 5885,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lalu jawab kedua orang itu kepadanya: \"Nyawa kamilah jaminan bagi kamu, asal jangan kaukabarkan perkara kami ini; apabila TUHAN nanti memberikan negeri ini kepada kami, maka kami akan menunjukkan terima kasih dan setia kami kepadamu.\""
 },
 {
   "id": 5886,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 15,
   "firman": "Kemudian perempuan itu menurunkan mereka dengan tali melalui jendela, sebab rumahnya itu letaknya pada tembok kota, jadi pada tembok itulah ia diam."
 },
 {
   "id": 5887,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 16,
   "firman": "Berkatalah ia kepada mereka: \"Pergilah ke pegunungan, supaya pengejar-pengejar itu jangan menemui kamu, dan bersembunyilah di sana tiga hari lamanya, sampai pengejar-pengejar itu pulang; kemudian bolehlah kamu melanjutkan perjalananmu.\""
 },
 {
   "id": 5888,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 17,
   "firman": "Kedua orang itu berkata kepadanya: \"Kami akan bebas dari sumpah kami ini kepadamu, yang telah kausuruh kami ikrarkan--"
 },
 {
   "id": 5889,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 18,
   "firman": "sesungguhnya, apabila kami memasuki negeri ini, haruslah tali dari benang kirmizi ini kauikatkan pada jendela tempat engkau menurunkan kami, dan ayahmu serta ibumu, saudara-saudaramu serta seluruh kaum keluargamu kaukumpulkan di rumahmu."
 },
 {
   "id": 5890,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 19,
   "firman": "Setiap orang yang keluar nanti dari pintu rumahmu, harus sendiri menanggung akibatnya, kalau darahnya tertumpah, dan kami tidak bersalah; tetapi siapapun juga yang ada di dalam rumahmu, jika ada orang yang menciderainya, kamilah yang menanggung akibat pertumpahan darahnya."
 },
 {
   "id": 5891,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 20,
   "firman": "Tetapi jika engkau mengabarkan perkara kami ini, maka bebaslah kami dari sumpah kepadamu itu, yang telah kausuruh kami ikrarkan.\""
 },
 {
   "id": 5892,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 21,
   "firman": "Perempuan itupun berkata: \"Seperti yang telah kamu katakan, demikianlah akan terjadi.\" Sesudah itu dilepasnyalah orang-orang itu pergi, maka berangkatlah mereka. Kemudian perempuan itu mengikatkan tali kirmizi itu pada jendela."
 },
 {
   "id": 5893,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 22,
   "firman": "Merekapun pergilah dan tiba di pegunungan. Mereka tinggal di sana tiga hari lamanya, sampai pengejar-pengejar itu pulang. Pengejar-pengejar itu telah mencari di mana-mana sepanjang jalan tanpa menemukan mereka."
 },
 {
   "id": 5894,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 23,
   "firman": "Maka pulanglah kedua orang itu, mereka turun dari pegunungan, lalu menyeberang dan sampai kepada Yosua bin Nun, kemudian mereka ceritakan segala pengalaman mereka."
 },
 {
   "id": 5895,
   "kitab": "Yos",
   "pasal": 2,
   "ayat": 24,
   "firman": "Kata mereka kepada Yosua: \"TUHAN telah menyerahkan seluruh negeri ini ke dalam tangan kita, bahkan seluruh penduduk negeri itu gemetar menghadapi kita.\""
 },
 {
   "id": 5896,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 1,
   "firman": "Yosua bangun pagi-pagi, lalu ia dan semua orang Israel berangkat dari Sitim, dan sampailah mereka ke sungai Yordan, maka bermalamlah mereka di sana, sebelum menyeberang."
 },
 {
   "id": 5897,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 2,
   "firman": "Setelah lewat tiga hari, para pengatur pasukan menjalani seluruh perkemahan,"
 },
 {
   "id": 5898,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 3,
   "firman": "dan memberi perintah kepada bangsa itu, katanya: \"Segera sesudah kamu melihat tabut perjanjian TUHAN, Allahmu, yang diangkat para imam, yang memang suku Lewi, maka kamu harus juga berangkat dari tempatmu dan mengikutinya--"
 },
 {
   "id": 5899,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 4,
   "firman": "hanya antara kamu dan tabut itu harus ada jarak kira-kira dua ribu hasta panjangnya, janganlah mendekatinya--maksudnya supaya kamu mengetahui jalan yang harus kamu tempuh, sebab jalan itu belum pernah kamu lalui dahulu.\""
 },
 {
   "id": 5900,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 5,
   "firman": "Berkatalah Yosua kepada bangsa itu: \"Kuduskanlah dirimu, sebab besok TUHAN akan melakukan perbuatan yang ajaib di antara kamu.\""
 },
 {
   "id": 5901,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 6,
   "firman": "Dan kepada para imam itu Yosua berkata, demikian: \"Angkatlah tabut perjanjian dan menyeberanglah di depan bangsa itu.\" Maka mereka mengangkat tabut perjanjian dan berjalan di depan bangsa itu."
 },
 {
   "id": 5902,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 7,
   "firman": "Dan TUHAN berfirman kepada Yosua: \"Pada hari inilah Aku mulai membesarkan namamu di mata seluruh orang Israel, supaya mereka tahu, bahwa seperti dahulu Aku menyertai Musa, demikianlah Aku akan menyertai engkau."
 },
 {
   "id": 5903,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 8,
   "firman": "Maka kauperintahkanlah kepada para imam pengangkat tabut perjanjian itu, demikian: Setelah kamu sampai ke tepi air sungai Yordan, haruslah kamu tetap berdiri di sungai Yordan itu.\""
 },
 {
   "id": 5904,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 9,
   "firman": "Lalu berkatalah Yosua kepada orang Israel: \"Datanglah dekat dan dengarkanlah firman TUHAN, Allahmu.\""
 },
 {
   "id": 5905,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 10,
   "firman": "Lagi kata Yosua: \"Dari hal inilah akan kamu ketahui, bahwa Allah yang hidup ada di tengah-tengah kamu dan bahwa sungguh-sungguh akan dihalau-Nya orang Kanaan, orang Het, orang Hewi, orang Feris, orang Girgasi, orang Amori dan orang Yebus itu dari depan kamu:"
 },
 {
   "id": 5906,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 11,
   "firman": "sesungguhnya, tabut perjanjian Tuhan semesta bumi berjalan menyeberang di depan kamu, masuk ke sungai Yordan."
 },
 {
   "id": 5907,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 12,
   "firman": "Maka sekarang, pilihlah dua belas orang dari suku-suku Israel, seorang dari tiap-tiap suku."
 },
 {
   "id": 5908,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 13,
   "firman": "Segera sesudah kaki para imam pengangkat tabut TUHAN, Tuhan semesta bumi, berhenti di dalam air sungai Yordan, maka air sungai Yordan itu akan terputus; air yang turun dari hulu akan berhenti mengalir menjadi bendungan.\""
 },
 {
   "id": 5909,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 14,
   "firman": "Ketika bangsa itu berangkat dari tempat perkemahan mereka untuk menyeberangi sungai Yordan, para imam pengangkat tabut perjanjian itu berjalan di depan bangsa itu."
 },
 {
   "id": 5910,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 15,
   "firman": "Segera sesudah para pengangkat tabut itu sampai ke sungai Yordan, dan para imam pengangkat tabut itu mencelupkan kakinya ke dalam air di tepi sungai itu--sungai Yordan itu sebak sampai meluap sepanjang tepinya selama musim menuai--"
 },
 {
   "id": 5911,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 16,
   "firman": "maka berhentilah air itu mengalir. Air yang turun dari hulu melonjak menjadi bendungan, jauh sekali, di dekat Adam, kota yang terletak di sebelah Sartan, sedang air yang turun ke Laut Araba itu, yakni Laut Asin, terputus sama sekali. Lalu menyeberanglah bangsa itu, di tentangan Yerikho."
 },
 {
   "id": 5912,
   "kitab": "Yos",
   "pasal": 3,
   "ayat": 17,
   "firman": "Tetapi para imam pengangkat tabut perjanjian TUHAN itu tetap berdiri di tanah yang kering, di tengah-tengah sungai Yordan, sedang seluruh bangsa Israel menyeberang di tanah yang kering, sampai seluruh bangsa itu selesai menyeberangi sungai Yordan."
 },
 {
   "id": 5913,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 1,
   "firman": "Setelah seluruh bangsa itu selesai menyeberangi sungai Yordan, berfirmanlah TUHAN kepada Yosua, demikian:"
 },
 {
   "id": 5914,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 2,
   "firman": "\"Pilihlah dari bangsa itu dua belas orang, seorang dari tiap-tiap suku,"
 },
 {
   "id": 5915,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 3,
   "firman": "dan perintahkanlah kepada mereka, demikian: Angkatlah dua belas batu dari sini, dari tengah-tengah sungai Yordan ini, dari tempat berjejak kaki para imam itu, bawalah semuanya itu ke seberang dan letakkanlah di tempat kamu akan bermalam nanti malam.\""
 },
 {
   "id": 5916,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 4,
   "firman": "Lalu Yosua memanggil kedua belas orang yang ditetapkannya dari orang Israel itu, seorang dari tiap-tiap suku,"
 },
 {
   "id": 5917,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 5,
   "firman": "dan Yosua berkata kepada mereka: \"Menyeberanglah di depan tabut TUHAN, Allahmu, ke tengah-tengah sungai Yordan, dan angkatlah masing-masing sebuah batu ke atas bahumu, menurut bilangan suku orang Israel,"
 },
 {
   "id": 5918,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 6,
   "firman": "supaya ini menjadi tanda di tengah-tengah kamu. Jika anak-anakmu bertanya di kemudian hari: Apakah artinya batu-batu ini bagi kamu?"
 },
 {
   "id": 5919,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 7,
   "firman": "maka haruslah kamu katakan kepada mereka: Bahwa air sungai Yordan terputus di depan tabut perjanjian TUHAN; ketika tabut itu menyeberangi sungai Yordan, air sungai Yordan itu terputus. Sebab itu batu-batu ini akan menjadi tanda peringatan bagi orang Israel untuk selama-lamanya.\""
 },
 {
   "id": 5920,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 8,
   "firman": "Maka orang Israel itu melakukan seperti yang diperintahkan Yosua. Mereka mengangkat dua belas batu dari tengah-tengah sungai Yordan, seperti yang difirmankan TUHAN kepada Yosua, menurut jumlah suku Israel. Semuanya itu dibawa merekalah ke seberang, ke tempat bermalam, dan diletakkan di situ."
 },
 {
   "id": 5921,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 9,
   "firman": "Pula Yosua menegakkan dua belas batu di tengah-tengah sungai Yordan itu, di tempat bekas berjejak kaki para imam pengangkat tabut perjanjian itu. Batu-batu itu masih ada di sana sampai sekarang."
 },
 {
   "id": 5922,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 10,
   "firman": "Para imam pengangkat tabut itu tinggal berdiri di tengah-tengah sungai Yordan, sampai selesai dilakukan segala yang diperintahkan TUHAN kepada Yosua untuk disampaikan kepada bangsa itu, sesuai dengan segala yang diperintahkan Musa kepada Yosua. Maka menyeberanglah bangsa itu dengan cepat-cepat."
 },
 {
   "id": 5923,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 11,
   "firman": "Ketika seluruh bangsa itu selesai menyeberang, maka menyeberanglah tabut TUHAN itu serta para imam di depan mata bangsa itu."
 },
 {
   "id": 5924,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 12,
   "firman": "Juga bani Ruben, bani Gad dan suku Manasye yang setengah itu menyeberang, dengan bersenjata, di depan orang Israel itu, seperti yang dikatakan Musa kepada mereka."
 },
 {
   "id": 5925,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 13,
   "firman": "Kira-kira empat puluh ribu orang yang siap untuk berperang menyeberang di hadapan TUHAN ke dataran Yerikho untuk berperang."
 },
 {
   "id": 5926,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 14,
   "firman": "Pada waktu itulah TUHAN membesarkan nama Yosua di mata seluruh orang Israel, sehingga mereka takut kepadanya, seperti mereka takut kepada Musa seumur hidupnya."
 },
 {
   "id": 5927,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 15,
   "firman": "Berfirmanlah TUHAN kepada Yosua, demikian:"
 },
 {
   "id": 5928,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 16,
   "firman": "\"Perintahkanlah para imam pengangkat tabut hukum Allah itu supaya naik dari sungai Yordan.\""
 },
 {
   "id": 5929,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 17,
   "firman": "Maka Yosua memerintahkan kepada para imam itu, demikian: \"Keluarlah dari sungai Yordan.\""
 },
 {
   "id": 5930,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 18,
   "firman": "Ketika para imam, pengangkat tabut perjanjian TUHAN itu, keluar dari tengah-tengah sungai Yordan, dan baru saja kaki para imam itu dijejakkan di tanah yang kering, maka berbaliklah air sungai Yordan itu ke tempatnya dan mengalir seperti dahulu dengan meluap sepanjang tepinya."
 },
 {
   "id": 5931,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 19,
   "firman": "Bangsa itu telah keluar dari sungai Yordan pada tanggal sepuluh bulan pertama dan mereka berkemah di Gilgal, di batas timur Yerikho."
 },
 {
   "id": 5932,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 20,
   "firman": "Kedua belas batu yang diambil dari sungai Yordan itu ditegakkan oleh Yosua di Gilgal."
 },
 {
   "id": 5933,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 21,
   "firman": "Dan berkatalah ia kepada orang Israel, demikian: \"Apabila di kemudian hari anak-anakmu bertanya kepada ayahnya: Apakah arti batu-batu ini?"
 },
 {
   "id": 5934,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 22,
   "firman": "maka haruslah kamu beritahukan kepada anak-anakmu, begini: Israel telah menyeberangi sungai Yordan ini di tanah yang kering! --"
 },
 {
   "id": 5935,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 23,
   "firman": "sebab TUHAN, Allahmu, telah mengeringkan di depan kamu air sungai Yordan, sampai kamu dapat menyeberang seperti yang telah dilakukan TUHAN, Allahmu, dengan Laut Teberau, yang telah dikeringkan-Nya di depan kita, sampai kita dapat menyeberang,"
 },
 {
   "id": 5936,
   "kitab": "Yos",
   "pasal": 4,
   "ayat": 24,
   "firman": "supaya semua bangsa di bumi tahu, bahwa kuat tangan TUHAN, dan supaya mereka selalu takut kepada TUHAN, Allahmu.\""
 },
 {
   "id": 5937,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 1,
   "firman": "Ketika semua raja orang Amori di sebelah barat sungai Yordan dan semua raja orang Kanaan di tepi laut mendengar, bahwa TUHAN telah mengeringkan air sungai Yordan di depan orang Israel, sampai mereka dapat menyeberang, tawarlah hati mereka dan hilanglah semangat mereka menghadapi orang Israel itu."
 },
 {
   "id": 5938,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 2,
   "firman": "Pada waktu itu berfirmanlah TUHAN kepada Yosua: \"Buatlah pisau dari batu dan sunatlah lagi orang Israel itu, untuk kedua kalinya.\""
 },
 {
   "id": 5939,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 3,
   "firman": "Lalu Yosua membuat pisau dari batu dan disunatnyalah orang Israel itu di Bukit Kulit Khatan."
 },
 {
   "id": 5940,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 4,
   "firman": "Inilah sebabnya Yosua menyunat mereka: semua orang yang keluar dari Mesir, yakni yang laki-laki, semua prajurit, telah mati di padang gurun di tengah jalan, setelah mereka keluar dari Mesir."
 },
 {
   "id": 5941,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 5,
   "firman": "Sebab, semua orang yang keluar dari Mesir itu telah bersunat, tetapi semua orang yang lahir di padang gurun dalam perjalanan sejak keluar dari Mesir, belum disunat."
 },
 {
   "id": 5942,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 6,
   "firman": "Sebab empat puluh tahun lamanya orang Israel itu berjalan melalui padang gurun, sampai habis mati seluruh bangsa itu, yakni prajurit yang keluar dari Mesir, yang tidak mendengarkan firman TUHAN. Kepada mereka itu TUHAN telah bersumpah, bahwa Ia tidak akan mengizinkan mereka melihat negeri yang dijanjikan TUHAN dengan bersumpah kepada nenek moyang mereka akan memberikannya kepada kita, suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 5943,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 7,
   "firman": "Tetapi anak-anak mereka yang telah dijadikan-Nya ganti mereka, mereka itulah yang disunat Yosua, sebab mereka belum bersunat, karena mereka tidak disunat dalam perjalanan."
 },
 {
   "id": 5944,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 8,
   "firman": "Setelah seluruh bangsa itu selesai disunat, maka tinggallah mereka di tempatnya masing-masing di perkemahan itu, sampai mereka sembuh."
 },
 {
   "id": 5945,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dan berfirmanlah TUHAN kepada Yosua: \"Hari ini telah Kuhapuskan cela Mesir itu dari padamu.\" Itulah sebabnya nama tempat itu disebut Gilgal sampai sekarang."
 },
 {
   "id": 5946,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sementara berkemah di Gilgal, orang Israel itu merayakan Paskah pada hari yang keempat belas bulan itu, pada waktu petang, di dataran Yerikho."
 },
 {
   "id": 5947,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 11,
   "firman": "Lalu pada hari sesudah Paskah mereka makan hasil negeri itu, yakni roti yang tidak beragi dan bertih gandum, pada hari itu juga."
 },
 {
   "id": 5948,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 12,
   "firman": "Lalu berhentilah manna itu, pada keesokan harinya setelah mereka makan hasil negeri itu. Jadi orang Israel tidak beroleh manna lagi, tetapi dalam tahun itu mereka makan yang dihasilkan tanah Kanaan."
 },
 {
   "id": 5949,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 13,
   "firman": "Ketika Yosua dekat Yerikho, ia melayangkan pandangnya, dilihatnya seorang laki-laki berdiri di depannya dengan pedang terhunus di tangannya. Yosua mendekatinya dan bertanya kepadanya: \"Kawankah engkau atau lawan?\""
 },
 {
   "id": 5950,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 14,
   "firman": "Jawabnya: \"Bukan, tetapi akulah Panglima Balatentara TUHAN. Sekarang aku datang.\" Lalu sujudlah Yosua dengan mukanya ke tanah, menyembah dan berkata kepadanya: \"Apakah yang akan dikatakan tuanku kepada hambanya ini?\""
 },
 {
   "id": 5951,
   "kitab": "Yos",
   "pasal": 5,
   "ayat": 15,
   "firman": "Dan Panglima Balatentara TUHAN itu berkata kepada Yosua: \"Tanggalkanlah kasutmu dari kakimu, sebab tempat engkau berdiri itu kudus.\" Dan Yosua berbuat demikian."
 },
 {
   "id": 5952,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 1,
   "firman": "Dalam pada itu Yerikho telah menutup pintu gerbangnya; telah tertutup kota itu karena orang Israel; tidak ada orang keluar atau masuk."
 },
 {
   "id": 5953,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 2,
   "firman": "Berfirmanlah TUHAN kepada Yosua: \"Ketahuilah, Aku serahkan ke tanganmu Yerikho ini beserta rajanya dan pahlawan-pahlawannya yang gagah perkasa."
 },
 {
   "id": 5954,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 3,
   "firman": "Haruslah kamu mengelilingi kota itu, yakni semua prajurit harus mengedari kota itu sekali saja; demikianlah harus engkau perbuat enam hari lamanya,"
 },
 {
   "id": 5955,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 4,
   "firman": "dan tujuh orang imam harus membawa tujuh sangkakala tanduk domba di depan tabut. Tetapi pada hari yang ketujuh, tujuh kali kamu harus mengelilingi kota itu sedang para imam meniup sangkakala."
 },
 {
   "id": 5956,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 5,
   "firman": "Apabila sangkakala tanduk domba itu panjang bunyinya dan kamu mendengar bunyi sangkakala itu, maka haruslah seluruh bangsa bersorak dengan sorak yang nyaring, maka tembok kota itu akan runtuh, lalu bangsa itu harus memanjatnya, masing-masing langsung ke depan.\""
 },
 {
   "id": 5957,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 6,
   "firman": "Kemudian Yosua bin Nun memanggil para imam dan berkata kepada mereka: \"Angkatlah tabut perjanjian itu dan tujuh orang imam harus membawa tujuh sangkakala tanduk domba di depan tabut TUHAN.\""
 },
 {
   "id": 5958,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 7,
   "firman": "Dan kepada bangsa itu dikatakannya: \"Majulah, kelilingilah kota itu, dan orang-orang bersenjata harus berjalan di depan tabut TUHAN.\""
 },
 {
   "id": 5959,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 8,
   "firman": "Segera sesudah Yosua berkata kepada bangsa itu, maka berjalanlah maju ketujuh orang imam, yang membawa ketujuh sangkakala tanduk domba itu di hadapan TUHAN, lalu mereka meniup sangkakala, sedang tabut perjanjian TUHAN mengikut mereka."
 },
 {
   "id": 5960,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dan orang-orang bersenjata berjalan di depan para imam yang meniup sangkakala dan barisan penutup mengikut tabut itu, sedang sangkakala terus-menerus ditiup."
 },
 {
   "id": 5961,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 10,
   "firman": "Tetapi Yosua telah memerintahkan kepada bangsa itu, demikian: \"Janganlah bersorak dan janganlah perdengarkan suaramu, sepatah katapun janganlah keluar dari mulutmu sampai pada hari aku mengatakan kepadamu: Bersoraklah! --maka kamu harus bersorak.\""
 },
 {
   "id": 5962,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 11,
   "firman": "Demikianlah tabut TUHAN mengelilingi kota itu, mengedarinya sekali saja. Kemudian kembalilah mereka ke tempat perkemahan dan bermalam di tempat perkemahan itu."
 },
 {
   "id": 5963,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 12,
   "firman": "Keesokan harinya Yosua bangun pagi-pagi, lalu para imam mengangkat tabut TUHAN."
 },
 {
   "id": 5964,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 13,
   "firman": "Maka berjalanlah juga ketujuh orang imam, yang membawa ketujuh sangkakala tanduk domba itu di depan tabut TUHAN, sambil berjalan mereka meniup sangkakala, sedang orang-orang bersenjata berjalan di depan mereka dan barisan penutup mengikut tabut TUHAN, sementara sangkakala terus-menerus ditiup."
 },
 {
   "id": 5965,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 14,
   "firman": "Demikianlah pada hari kedua mereka mengelilingi kota itu sekali saja, lalu pulang ke tempat perkemahan. Dan begitulah dilakukan mereka enam hari lamanya."
 },
 {
   "id": 5966,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 15,
   "firman": "Tetapi pada hari yang ketujuh mereka bangun pagi-pagi, ketika fajar menyingsing, dan mengelilingi kota tujuh kali dengan cara yang sama; hanya pada hari itu mereka mengelilingi kota itu tujuh kali."
 },
 {
   "id": 5967,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 16,
   "firman": "Lalu pada ketujuh kalinya, ketika para imam meniup sangkakala, berkatalah Yosua kepada bangsa itu: \"Bersoraklah, sebab TUHAN telah menyerahkan kota ini kepadamu!"
 },
 {
   "id": 5968,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 17,
   "firman": "Dan kota itu dengan segala isinya akan dikhususkan bagi TUHAN untuk dimusnahkan; hanya Rahab, perempuan sundal itu, akan tetap hidup, ia dengan semua orang yang bersama-sama dengan dia dalam rumah itu, karena ia telah menyembunyikan orang suruhan yang kita suruh."
 },
 {
   "id": 5969,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 18,
   "firman": "Tetapi kamu ini, jagalah dirimu terhadap barang-barang yang dikhususkan untuk dimusnahkan, supaya jangan kamu mengambil sesuatu dari barang-barang yang dikhususkan itu setelah mengkhususkannya dan dengan demikian membawa kemusnahan atas perkemahan orang Israel dan mencelakakannya."
 },
 {
   "id": 5970,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 19,
   "firman": "Segala emas dan perak serta barang-barang tembaga dan besi adalah kudus bagi TUHAN; semuanya itu akan dimasukkan ke dalam perbendaharaan TUHAN.\""
 },
 {
   "id": 5971,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 20,
   "firman": "Lalu bersoraklah bangsa itu, sedang sangkakala ditiup; segera sesudah bangsa itu mendengar bunyi sangkakala, bersoraklah mereka dengan sorak yang nyaring. Maka runtuhlah tembok itu, lalu mereka memanjat masuk ke dalam kota, masing-masing langsung ke depan, dan merebut kota itu."
 },
 {
   "id": 5972,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 21,
   "firman": "Mereka menumpas dengan mata pedang segala sesuatu yang di dalam kota itu, baik laki-laki maupun perempuan, baik tua maupun muda, sampai kepada lembu, domba dan keledai."
 },
 {
   "id": 5973,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 22,
   "firman": "Tetapi kepada kedua orang pengintai negeri itu Yosua berkata: \"Masuklah ke dalam rumah perempuan sundal itu dan bawalah ke luar perempuan itu dan semua orang yang bersama-sama dengan dia, seperti yang telah kamu janjikan dengan bersumpah kepadanya.\""
 },
 {
   "id": 5974,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 23,
   "firman": "Lalu masuklah kedua pengintai muda itu dan membawa ke luar Rahab dan ayahnya, ibunya, saudara-saudaranya dan semua orang yang bersama-sama dengan dia, bahkan seluruh kaumnya dibawa mereka ke luar, lalu mereka menunjukkan kepadanya tempat tinggal di luar perkemahan orang Israel."
 },
 {
   "id": 5975,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 24,
   "firman": "Tetapi kota itu dan segala sesuatu yang ada di dalamnya dibakar mereka dengan api; hanya emas dan perak, barang-barang tembaga dan besi ditaruh mereka di dalam perbendaharaan rumah TUHAN."
 },
 {
   "id": 5976,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 25,
   "firman": "Demikianlah Rahab, perempuan sundal itu dan keluarganya serta semua orang yang bersama-sama dengan dia dibiarkan hidup oleh Yosua. Maka diamlah perempuan itu di tengah-tengah orang Israel sampai sekarang, karena ia telah menyembunyikan orang suruhan yang disuruh Yosua mengintai Yerikho."
 },
 {
   "id": 5977,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 26,
   "firman": "Pada waktu itu bersumpahlah Yosua, katanya: \"Terkutuklah di hadapan TUHAN orang yang bangkit untuk membangun kembali kota Yerikho ini; dengan membayarkan nyawa anaknya yang sulung ia akan meletakkan dasar kota itu dan dengan membayarkan nyawa anaknya yang bungsu ia akan memasang pintu gerbangnya!\""
 },
 {
   "id": 5978,
   "kitab": "Yos",
   "pasal": 6,
   "ayat": 27,
   "firman": "Dan TUHAN menyertai Yosua dan terdengarlah kabar tentang dia di seluruh negeri itu."
 },
 {
   "id": 5979,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 1,
   "firman": "Tetapi orang Israel berubah setia dengan mengambil barang-barang yang dikhususkan itu, karena Akhan bin Karmi bin Zabdi bin Zerah, dari suku Yehuda, mengambil sesuatu dari barang-barang yang dikhususkan itu. Lalu bangkitlah murka TUHAN terhadap orang Israel."
 },
 {
   "id": 5980,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 2,
   "firman": "Yosua menyuruh orang dari Yerikho ke Ai, yang letaknya dekat Bet-Awen, di sebelah timur Betel, dan berkata kepada mereka, demikian: \"Pergilah ke sana dan intailah negeri itu.\" Maka pergilah orang-orang itu ke sana dan mengintai kota Ai."
 },
 {
   "id": 5981,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 3,
   "firman": "Kemudian kembalilah mereka kepada Yosua dan berkata kepadanya: \"Tidak usah seluruh bangsa itu pergi, biarlah hanya kira-kira dua atau tiga ribu orang pergi untuk menggempur Ai itu; janganlah kaususahkan seluruh bangsa itu dengan berjalan ke sana, sebab orang-orang di sana sedikit saja.\""
 },
 {
   "id": 5982,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 4,
   "firman": "Maka berangkatlah kira-kira tiga ribu orang dari bangsa itu ke sana; tetapi mereka melarikan diri di depan orang-orang Ai."
 },
 {
   "id": 5983,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 5,
   "firman": "Sebab orang-orang Ai menewaskan kira-kira tiga puluh enam orang dari mereka; orang-orang Israel itu dikejar dari depan pintu gerbang kota itu sampai ke Syebarim dan dipukul kalah di lereng. Lalu tawarlah hati bangsa itu amat sangat."
 },
 {
   "id": 5984,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 6,
   "firman": "Yosuapun mengoyakkan jubahnya dan sujudlah ia dengan mukanya sampai ke tanah di depan tabut TUHAN hingga petang, bersama dengan para tua-tua orang Israel, sambil menaburkan debu di atas kepalanya."
 },
 {
   "id": 5985,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 7,
   "firman": "Dan berkatalah Yosua: \"Ah, Tuhanku ALLAH, mengapa Engkau menyuruh bangsa ini menyeberangi sungai Yordan? supaya kami diserahkan kepada orang Amori untuk dibinasakan? Lebih baik kalau kami putuskan tadinya untuk tinggal di seberang sungai Yordan itu!"
 },
 {
   "id": 5986,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 8,
   "firman": "O Tuhan, apakah yang akan kukatakan, setelah orang Israel lari membelakangi musuhnya?"
 },
 {
   "id": 5987,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 9,
   "firman": "Apabila hal itu terdengar oleh orang Kanaan dan seluruh penduduk negeri ini, maka mereka akan mengepung kami dan melenyapkan nama kami dari bumi ini. Dan apakah yang akan Kaulakukan untuk memulihkan nama-Mu yang besar itu?\""
 },
 {
   "id": 5988,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 10,
   "firman": "Lalu berfirmanlah TUHAN kepada Yosua: \"Bangunlah! Mengapa engkau sujud demikian?"
 },
 {
   "id": 5989,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 11,
   "firman": "Orang Israel telah berbuat dosa, mereka melanggar perjanjian-Ku yang Kuperintahkan kepada mereka, mereka mengambil sesuatu dari barang-barang yang dikhususkan itu, mereka mencurinya, mereka menyembunyikannya dan mereka menaruhnya di antara barang-barangnya."
 },
 {
   "id": 5990,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 12,
   "firman": "Sebab itu orang Israel tidak dapat bertahan menghadapi musuhnya. Mereka membelakangi musuhnya, sebab mereka itupun dikhususkan untuk ditumpas. Aku tidak akan menyertai kamu lagi jika barang-barang yang dikhususkan itu tidak kamu punahkan dari tengah-tengahmu."
 },
 {
   "id": 5991,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 13,
   "firman": "Bangunlah, kuduskanlah bangsa itu dan katakan: Kuduskanlah dirimu untuk esok hari, sebab, demikianlah firman TUHAN, Allah Israel: Hai, orang Israel ada barang-barang yang dikhususkan di tengah-tengahmu; kamu tidak akan dapat bertahan menghadapi musuhmu, sebelum barang-barang yang dikhususkan itu kamu jauhkan dari tengah-tengah kamu."
 },
 {
   "id": 5992,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 14,
   "firman": "Besok pagi kamu harus tampil ke muka suku demi suku dan suku yang ditunjuk oleh TUHAN harus tampil ke muka kaum demi kaum, dan kaum yang ditunjuk oleh TUHAN harus tampil ke muka keluarga demi keluarga dan keluarga yang ditunjuk oleh TUHAN harus tampil ke muka seorang demi seorang."
 },
 {
   "id": 5993,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 15,
   "firman": "Dan siapa yang didapati menyimpan barang-barang yang dikhususkan itu, akan dibakar dengan api, ia dan segala sesuatu yang ada padanya, sebab ia telah melanggar perjanjian TUHAN dan berbuat noda di antara orang Israel.\""
 },
 {
   "id": 5994,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 16,
   "firman": "Keesokan harinya bangunlah Yosua pagi-pagi, lalu menyuruh orang Israel tampil ke muka suku demi suku, maka didapatilah suku Yehuda."
 },
 {
   "id": 5995,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 17,
   "firman": "Ketika disuruhnya tampil ke muka kaum-kaum Yehuda, maka didapatinya kaum Zerah. Ketika disuruhnya tampil ke muka kaum Zerah, seorang demi seorang, maka didapatilah Zabdi."
 },
 {
   "id": 5996,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 18,
   "firman": "Ketika disuruhnya keluarga orang itu tampil ke muka, seorang demi seorang, maka didapatilah Akhan bin Karmi bin Zabdi bin Zerah, dari suku Yehuda."
 },
 {
   "id": 5997,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 19,
   "firman": "Berkatalah Yosua kepada Akhan: \"Anakku, hormatilah TUHAN, Allah Israel, dan mengakulah di hadapan-Nya; katakanlah kepadaku apa yang kauperbuat, jangan sembunyikan kepadaku.\""
 },
 {
   "id": 5998,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 20,
   "firman": "Lalu Akhan menjawab Yosua, katanya: \"Benar, akulah yang berbuat dosa terhadap TUHAN, Allah Israel, sebab beginilah perbuatanku:"
 },
 {
   "id": 5999,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 21,
   "firman": "aku melihat di antara barang-barang jarahan itu jubah yang indah, buatan Sinear, dan dua ratus syikal perak dan sebatang emas yang lima puluh syikal beratnya; aku mengingininya, maka kuambil; semuanya itu disembunyikan di dalam kemahku dalam tanah, dan perak itu di bawah sekali.\""
 },
 {
   "id": 6000,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 22,
   "firman": "Lalu Yosua menyuruh orang segera pergi ke kemah itu, dan sesungguhnya, semuanya itu disembunyikan dalam kemah Akhan, dan perak itu ada di bawah sekali."
 },
 {
   "id": 6001,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 23,
   "firman": "Maka mereka mengambil semuanya itu dari dalam kemah, lalu membawanya kepada Yosua dan kepada semua orang Israel, dan mencurahkannya di hadapan TUHAN."
 },
 {
   "id": 6002,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 24,
   "firman": "Kemudian Yosua, beserta seluruh Israel mengambil Akhan bin Zerah, dan perak, jubah dan emas sebatang itu, anak-anaknya yang laki-laki dan perempuan, lembunya, keledainya dan kambing dombanya, kemahnya dan segala kepunyaannya, lalu semuanya itu dibawa ke lembah Akhor."
 },
 {
   "id": 6003,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 25,
   "firman": "Berkatalah Yosua: \"Seperti engkau mencelakakan kami, maka TUHAN pun mencelakakan engkau pada hari ini.\" Lalu seluruh Israel melontari dia dengan batu, semuanya itu dibakar dengan api dan dilempari dengan batu."
 },
 {
   "id": 6004,
   "kitab": "Yos",
   "pasal": 7,
   "ayat": 26,
   "firman": "Sesudah itu didirikanlah di atasnya suatu timbunan batu yang besar, yang masih ada sampai sekarang. Lalu surutlah murka TUHAN yang bernyala-nyala itu. Oleh sebab itu nama tempat itu sampai sekarang disebutkan lembah Akhor."
 },
 {
   "id": 6005,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 1,
   "firman": "Kemudian berfirmanlah TUHAN kepada Yosua: \"Janganlah takut dan janganlah tawar hati; bawalah seluruh tentara dan bersiaplah, majulah ke Ai. Ketahuilah, Aku serahkan kepadamu raja negeri Ai, rakyatnya, kotanya dan negerinya,"
 },
 {
   "id": 6006,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 2,
   "firman": "dan haruslah kaulakukan kepada Ai dan rajanya, seperti yang kaulakukan kepada Yerikho dan rajanya; hanya barang-barangnya dan ternaknya boleh kamu jarah. Suruhlah orang bersembunyi di belakang kota itu.\""
 },
 {
   "id": 6007,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 3,
   "firman": "Lalu bersiaplah Yosua beserta seluruh tentara untuk pergi ke Ai. Yosua memilih tiga puluh ribu orang, pahlawan-pahlawan yang gagah perkasa, mereka disuruhnya pergi pada waktu malam"
 },
 {
   "id": 6008,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 4,
   "firman": "dan kepada mereka diperintahkannya, katanya: \"Ketahuilah, kamu harus bersembunyi di belakang kota itu untuk menyerangnya, janganlah terlalu jauh dari kota itu, dan bersiap-siaplah kamu sekalian."
 },
 {
   "id": 6009,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 5,
   "firman": "Aku dan semua orang yang bersama-sama dengan aku akan mendekati kota itu; apabila mereka keluar menyerbu kami, seperti yang pertama kali, maka kami akan melarikan diri dari hadapan mereka."
 },
 {
   "id": 6010,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 6,
   "firman": "Jadi mereka akan keluar menyusul kami, sehingga kami memancing mereka jauh dari kota itu, sebab mereka akan berkata: orang-orang itu melarikan diri dari hadapan kita seperti yang pertama kali. Jika kami melarikan diri dari hadapan mereka,"
 },
 {
   "id": 6011,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 7,
   "firman": "maka kamu harus bangun dari tempat persembunyianmu itu untuk menduduki kota itu, dan TUHAN, Allahmu, akan menyerahkannya ke dalam tanganmu."
 },
 {
   "id": 6012,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 8,
   "firman": "Segera setelah kamu merebut kota itu, haruslah kamu membakarnya; sesuai dengan firman TUHAN kamu harus melakukan semuanya itu; ingatlah, itulah perintahku kepadamu.\""
 },
 {
   "id": 6013,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 9,
   "firman": "Demikianlah Yosua menyuruh mereka pergi, lalu berjalanlah mereka ke tempat persembunyian dan tinggal di antara Betel dan Ai, di sebelah barat Ai. Tetapi Yosua bermalam di tengah-tengah rakyat pada malam itu."
 },
 {
   "id": 6014,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 10,
   "firman": "Keesokan harinya Yosua bangun pagi-pagi, lalu diperiksanyalah barisan bangsa itu dan berjalanlah ia maju beserta para tua-tua orang Israel di depan bangsa itu ke Ai."
 },
 {
   "id": 6015,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 11,
   "firman": "Juga seluruh tentara yang bersama-sama dengan dia berjalan maju; mereka maju mendekat, lalu sampai ke tentangan kota itu, kemudian berkemahlah mereka di sebelah utara Ai, sehingga lembah itu ada di antara mereka dan Ai."
 },
 {
   "id": 6016,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 12,
   "firman": "Yosua telah mengambil kira-kira lima ribu orang, lalu disuruhnya mereka bersembunyi di antara Betel dan Ai, di sebelah barat kota itu."
 },
 {
   "id": 6017,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 13,
   "firman": "Beginilah rakyat itu diatur: seluruh tentara itu di sebelah utara kota dengan barisan belakang di sebelah barat kota. Pada malam itu berjalanlah Yosua melalui lembah itu."
 },
 {
   "id": 6018,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 14,
   "firman": "Pagi-pagi, ketika raja negeri Ai melihat hal itu, maka ia dan seluruh rakyatnya, orang-orang kota itu, segera keluar berperang, menyerbu orang Israel, ke lereng di seberang dataran itu; raja itu tidak tahu, bahwa ada orang bersembunyi di belakang kota."
 },
 {
   "id": 6019,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 15,
   "firman": "Yosua dan seluruh orang Israel itu berlaku seolah-olah dipukul mundur oleh mereka, lalu melarikan diri ke arah padang gurun."
 },
 {
   "id": 6020,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 16,
   "firman": "Sebab itu semua orang yang ada di kota dikerahkan untuk mengejar orang Israel. Maka mereka mengejar Yosua, sehingga makin jauhlah mereka terpancing dari kota."
 },
 {
   "id": 6021,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 17,
   "firman": "Seorangpun tidak tertinggal lagi di Ai dan Betel yang tidak keluar memburu orang Israel. Mereka meninggalkan kota itu terbuka, karena mereka mengejar orang Israel."
 },
 {
   "id": 6022,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 18,
   "firman": "Lalu berfirmanlah TUHAN kepada Yosua: \"Acungkanlah lembing yang ada di tanganmu ke arah Ai, sebab Aku menyerahkan kota itu ke dalam tanganmu.\" Maka Yosua mengacungkan lembing yang di tangannya ke arah kota itu."
 },
 {
   "id": 6023,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 19,
   "firman": "Ketika diacungkannya tangannya, maka segeralah bangun orang-orang yang bersembunyi itu dari tempatnya, mereka berlari memasuki kota, merebutnya, lalu segera membakar kota itu."
 },
 {
   "id": 6024,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 20,
   "firman": "Ketika orang Ai berpaling menoleh ke belakang, tampaklah asap kota itu naik membubung ke langit; mereka tidak sempat melarikan diri ke manapun juga, sebab rakyat yang tadinya lari ke padang gurun, berbalik melawan pengejar-pengejarnya."
 },
 {
   "id": 6025,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 21,
   "firman": "Ketika Yosua dan seluruh Israel melihat, bahwa orang-orang yang bersembunyi itu telah merebut kota dan bahwa asap kota itu naik membubung, berbaliklah mereka, lalu menewaskan orang-orang Ai."
 },
 {
   "id": 6026,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 22,
   "firman": "Sementara itu juga keluar orang-orang Israel yang lain dari dalam kota menyerbu orang-orang Ai, sehingga terjepit di tengah-tengah orang Israel itu, yang ini dari sini dan yang itu dari sana; orang-orang Ai ditewaskan, sehingga seorangpun dari mereka tidak ada yang dibiarkan terlepas atau luput."
 },
 {
   "id": 6027,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 23,
   "firman": "Tetapi raja Ai ditangkap mereka hidup-hidup dan dihadapkan kepada Yosua."
 },
 {
   "id": 6028,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 24,
   "firman": "Segera sesudah orang Israel selesai membunuh seluruh penduduk kota Ai di padang terbuka ke mana orang Israel mengejar mereka, dan orang-orang ini semuanya tewas oleh mata pedang sampai orang yang penghabisan, maka seluruh Israel kembali ke Ai dan memukul kota itu dengan mata pedang."
 },
 {
   "id": 6029,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 25,
   "firman": "Jumlah semua orang yang tewas pada hari itu, baik laki-laki maupun perempuan, ada dua belas ribu orang, semuanya orang Ai."
 },
 {
   "id": 6030,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 26,
   "firman": "Dan Yosua tidak menarik tangannya yang mengacungkan lembing itu, sebelum seluruh penduduk kota Ai ditumpasnya."
 },
 {
   "id": 6031,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 27,
   "firman": "Hanya ternak dan barang-barang kota itu dijarah oleh orang Israel, sesuai dengan firman TUHAN, yang diperintahkan-Nya kepada Yosua."
 },
 {
   "id": 6032,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 28,
   "firman": "Yosua membakar Ai dan membuatnya menjadi timbunan puing untuk selama-lamanya, menjadi tempat yang tandus sampai sekarang."
 },
 {
   "id": 6033,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 29,
   "firman": "Dan raja Ai digantungnya pada sebuah tiang sampai petang. Ketika matahari terbenam, Yosua memerintahkan orang menurunkan mayat itu dari tiang, lalu dilemparkan di depan pintu gerbang kota, kemudian didirikan oranglah di atasnya suatu timbunan batu yang besar, yang masih ada sampai sekarang."
 },
 {
   "id": 6034,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 30,
   "firman": "Pada waktu itulah Yosua mendirikan mezbah di gunung Ebal bagi TUHAN, Allah Israel,"
 },
 {
   "id": 6035,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 31,
   "firman": "seperti yang diperintahkan Musa, hamba TUHAN, kepada orang Israel, menurut apa yang tertulis dalam kitab hukum Musa: suatu mezbah dari batu-batu yang tidak dipahat, yang tidak diolah dengan perkakas besi apapun. Di atasnyalah mereka mempersembahkan korban bakaran kepada TUHAN dan mengorbankan korban keselamatan."
 },
 {
   "id": 6036,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 32,
   "firman": "Dan di sanalah di atas batu-batu itu, dituliskan Yosua salinan hukum Musa, yang dituliskannya di depan orang Israel."
 },
 {
   "id": 6037,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 33,
   "firman": "Seluruh orang Israel, para tua-tuanya, para pengatur pasukannya dan para hakimnya berdiri sebelah-menyebelah tabut, berhadapan dengan para imam yang memang suku Lewi, para pengangkat tabut perjanjian TUHAN itu, baik pendatang maupun anak negeri, setengahnya menghadap ke gunung Gerizim dan setengahnya lagi menghadap ke gunung Ebal, seperti yang dahulu diperintahkan oleh Musa, hamba TUHAN, apabila orang memberkati bangsa Israel."
 },
 {
   "id": 6038,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 34,
   "firman": "Sesudah itu dibacakannyalah segala perkataan hukum Taurat, berkatnya dan kutuknya, sesuai dengan segala apa yang tertulis dalam kitab hukum."
 },
 {
   "id": 6039,
   "kitab": "Yos",
   "pasal": 8,
   "ayat": 35,
   "firman": "Tidak ada sepatah katapun dari segala apa yang diperintahkan Musa yang tidak dibacakan oleh Yosua kepada seluruh jemaah Israel dan kepada perempuan-perempuan dan anak-anak dan kepada pendatang yang ikut serta."
 },
 {
   "id": 6040,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 1,
   "firman": "Ketika terdengar oleh raja-raja di sebelah barat sungai Yordan, di Pegunungan, di Daerah Bukit dan sepanjang tepi pantai Laut Besar sampai ke seberang gunung Libanon, yakni raja-raja orang Het, orang Amori, orang Kanaan, orang Feris, orang Hewi dan orang Yebus,"
 },
 {
   "id": 6041,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 2,
   "firman": "bergabunglah mereka dengan seia sekata untuk memerangi Yosua dan orang Israel."
 },
 {
   "id": 6042,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 3,
   "firman": "Tetapi ketika terdengar kepada penduduk negeri Gibeon apa yang dilakukan Yosua terhadap Yerikho dan Ai,"
 },
 {
   "id": 6043,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 4,
   "firman": "maka merekapun bertindak dengan memakai akal: mereka pergi menyediakan bekal, mengambil karung yang buruk-buruk untuk dimuatkan ke atas keledai mereka dan kirbat anggur yang buruk-buruk, yang robek dan dijahit kembali,"
 },
 {
   "id": 6044,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 5,
   "firman": "dan kasut yang buruk-buruk dan ditambal untuk dikenakan pada kaki mereka dan pakaian yang buruk-buruk untuk dikenakan oleh mereka, sedang segala roti bekal mereka telah kering, tinggal remah-remah belaka."
 },
 {
   "id": 6045,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 6,
   "firman": "Demikianlah mereka pergi kepada Yosua, ke tempat perkemahan di Gilgal. Berkatalah mereka kepadanya dan kepada orang-orang Israel itu: \"Kami ini datang dari negeri jauh; maka sekarang ikatlah perjanjian dengan kami.\""
 },
 {
   "id": 6046,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 7,
   "firman": "Tetapi berkatalah orang-orang Israel kepada orang-orang Hewi itu: \"Barangkali kamu ini diam di tengah-tengah kami, bagaimana mungkin kami mengikat perjanjian dengan kamu?\""
 },
 {
   "id": 6047,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 8,
   "firman": "Lalu kata mereka kepada Yosua: \"Kami ini hamba-hambamu.\" Tanya Yosua: \"Siapakah kamu ini dan dari manakah kamu datang?\""
 },
 {
   "id": 6048,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 9,
   "firman": "Jawab mereka kepadanya: \"Dari negeri yang sangat jauh hamba-hambamu ini datang karena nama TUHAN, Allahmu, sebab kami telah mendengar kabar tentang Dia, yakni segala yang dilakukan-Nya di Mesir,"
 },
 {
   "id": 6049,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 10,
   "firman": "dan segala yang dilakukan-Nya terhadap kedua raja orang Amori itu di seberang sungai Yordan, Sihon, raja Hesybon, dan Og, raja Basan, yang diam di Asytarot."
 },
 {
   "id": 6050,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 11,
   "firman": "Sebab itu para tua-tua kami dan seluruh penduduk negeri kami berkata kepada kami, demikian: Bawalah bekal untuk di jalan dan pergilah menemui mereka dan berkatalah kepada mereka: Kami ini hamba-hambamu, maka sekarang ikatlah perjanjian dengan kami."
 },
 {
   "id": 6051,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 12,
   "firman": "Inilah roti kami: masih panas ketika kami bawa sebagai bekal dari rumah pada hari kami berangkat berjalan mendapatkan kamu, tetapi sekarang, lihatlah, telah kering dan tinggal remah-remah belaka."
 },
 {
   "id": 6052,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 13,
   "firman": "Inilah kirbat-kirbat anggur, yang masih baru ketika kami mengisinya, tetapi lihatlah, telah robek; dan inilah pakaian dan kasut kami, semuanya telah buruk-buruk karena perjalanan yang sangat jauh itu.\""
 },
 {
   "id": 6053,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 14,
   "firman": "Lalu orang-orang Israel mengambil bekal orang-orang itu, tetapi tidak meminta keputusan TUHAN."
 },
 {
   "id": 6054,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 15,
   "firman": "Maka Yosua mengadakan persahabatan dengan mereka dan mengikat perjanjian dengan mereka, bahwa ia akan membiarkan mereka hidup; dan para pemimpin umat itu bersumpah kepada mereka."
 },
 {
   "id": 6055,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 16,
   "firman": "Tetapi setelah lewat tiga hari, sesudah orang Israel mengikat perjanjian dengan orang-orang itu, terdengarlah oleh mereka, bahwa orang-orang itu tinggal dekat mereka, bahkan diam di tengah-tengah mereka."
 },
 {
   "id": 6056,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 17,
   "firman": "Sebab orang Israel berangkat pergi dan pada hari ketiga sampai ke kota-kota orang-orang itu; adapun kota-kota itu ialah Gibeon, Kefira, Beerot dan Kiryat-Yearim."
 },
 {
   "id": 6057,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 18,
   "firman": "Orang Israel tidak menewaskan, sebab para pemimpin umat telah bersumpah kepada mereka demi TUHAN, Allah Israel. Lalu bersungut-sungutlah segenap umat kepada para pemimpin."
 },
 {
   "id": 6058,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 19,
   "firman": "Berkatalah pemimpin-pemimpin itu kepada seluruh umat: \"Kami telah bersumpah kepada mereka demi TUHAN, Allah Israel; oleh sebab itu kita tidak dapat mengusik mereka."
 },
 {
   "id": 6059,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 20,
   "firman": "Beginilah akan kita perlakukan mereka: membiarkan mereka hidup, supaya kita jangan tertimpa murka karena sumpah yang telah kita ikrarkan itu kepada mereka.\""
 },
 {
   "id": 6060,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 21,
   "firman": "Lagi kata para pemimpin kepada mereka: \"Biarlah mereka hidup.\" Maka merekapun dijadikan tukang belah kayu dan tukang timba air untuk segenap umat, seperti yang ditetapkan oleh para pemimpin mengenai mereka."
 },
 {
   "id": 6061,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 22,
   "firman": "Lalu Yosua memanggil mereka dan berkata kepada mereka, demikian: \"Mengapa kamu menipu kami dengan berkata: Kami ini tinggal sangat jauh dari pada kamu, padahal kamu diam di tengah-tengah kami?"
 },
 {
   "id": 6062,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 23,
   "firman": "Oleh sebab itu, terkutuklah kamu dan tak putus-putusnya kamu menjadi hamba, tukang belah kayu dan tukang timba air untuk rumah Allahku.\""
 },
 {
   "id": 6063,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 24,
   "firman": "Jawab mereka kepada Yosua, katanya: \"Sebab telah dikabarkan dengan sungguh-sungguh kepada hamba-hambamu ini, bahwa TUHAN, Allahmu, memerintahkan kepada Musa hamba-Nya, memberikan seluruh negeri itu kepadamu dan memunahkan seluruh penduduk negeri itu dari depan kamu, maka sangatlah kami takut kehilangan nyawa, menghadapi kamu; itulah sebabnya kami melakukan yang demikian."
 },
 {
   "id": 6064,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 25,
   "firman": "Maka sekarang, kami ini dalam tanganmu; perlakukanlah kami seperti yang kaupandang baik dan benar untuk dilakukan kepada kami.\""
 },
 {
   "id": 6065,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 26,
   "firman": "Demikianlah dilakukannya kepada mereka. Dilepaskannyalah mereka dari tangan orang-orang Israel, sehingga mereka tidak dibunuh."
 },
 {
   "id": 6066,
   "kitab": "Yos",
   "pasal": 9,
   "ayat": 27,
   "firman": "Dan pada waktu itu Yosua menjadikan mereka tukang belah kayu dan tukang timba air untuk umat itu dan untuk mezbah TUHAN, sampai sekarang, di tempat yang akan dipilih-Nya."
 },
 {
   "id": 6067,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 1,
   "firman": "Setelah terdengar oleh Adoni-Zedek, raja Yerusalem, bahwa Yosua telah merebut Ai dan telah menumpasnya--seperti yang dilakukannya terhadap Yerikho dan terhadap rajanya, demikianlah juga dilakukannya terhadap Ai dan terhadap rajanya--dan bahwa penduduk kota Gibeon telah mengadakan ikatan persahabatan dengan orang Israel dan diam di tengah-tengah mereka,"
 },
 {
   "id": 6068,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 2,
   "firman": "maka sangat takutlah orang, sebab Gibeon itu kota yang besar, seperti salah satu kota kerajaan, bahkan lebih besar dari Ai, dan semua orangnya adalah pahlawan."
 },
 {
   "id": 6069,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 3,
   "firman": "Sebab itu Adoni-Zedek, raja Yerusalem, menyuruh orang kepada Hoham, raja Hebron, kepada Piream, raja Yarmut, kepada Yafia, raja Lakhis, dan kepada Debir, raja Eglon, mengatakan:"
 },
 {
   "id": 6070,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 4,
   "firman": "\"Datanglah kepadaku dan bantulah aku, supaya kita menggempur Gibeon, karena telah mengadakan ikatan persahabatan dengan Yosua dan orang Israel.\""
 },
 {
   "id": 6071,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 5,
   "firman": "Lalu kelima raja orang Amori itu berkumpul dan bergerak maju: raja Yerusalem, raja Hebron, raja Yarmut, raja Lakhis dan raja Eglon, mereka beserta seluruh tentara mereka. Mereka berkemah mengepung Gibeon dan berperang melawannya."
 },
 {
   "id": 6072,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 6,
   "firman": "Lalu orang-orang Gibeon itu menyuruh orang kepada Yosua, ke tempat perkemahan di Gilgal, mengatakan: \"Jangan menarik tanganmu dari pada hamba-hambamu ini. Datanglah dengan segera kepada kami, lepaskanlah kami dan bantulah kami, sebab semua raja orang Amori, yang diam di pegunungan, telah bergabung melawan kami.\""
 },
 {
   "id": 6073,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 7,
   "firman": "Lalu Yosua bergerak maju dari Gilgal, dia dan seluruh tentara yang bersama-sama dengan dia, semuanya pahlawan yang gagah perkasa."
 },
 {
   "id": 6074,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 8,
   "firman": "Berfirmanlah TUHAN kepada Yosua: \"Janganlah takut kepada mereka, sebab Aku menyerahkan mereka kepadamu. Tidak seorangpun dari mereka yang akan dapat bertahan menghadapi engkau.\""
 },
 {
   "id": 6075,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 9,
   "firman": "Lalu Yosua menyerang mereka dengan tiba-tiba, setelah semalam-malaman bergerak maju dari Gilgal."
 },
 {
   "id": 6076,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 10,
   "firman": "Dan TUHAN mengacaukan mereka di depan orang Israel, sehingga Yosua menimbulkan kekalahan yang besar di antara mereka dekat Gibeon, mengejar mereka ke arah pendakian Bet-Horon dan memukul mereka mundur sampai dekat Azeka dan Makeda."
 },
 {
   "id": 6077,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 11,
   "firman": "Sedang mereka melarikan diri di depan orang Israel dan baru di lereng Bet-Horon, maka TUHAN melempari mereka dengan batu-batu besar dari langit, sampai ke Azeka, sehingga mereka mati. Yang mati kena hujan batu itu ada lebih banyak dari yang dibunuh oleh orang Israel dengan pedang."
 },
 {
   "id": 6078,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lalu Yosua berbicara kepada TUHAN pada hari TUHAN menyerahkan orang Amori itu kepada orang Israel; ia berkata di hadapan orang Israel: \"Matahari, berhentilah di atas Gibeon dan engkau, bulan, di atas lembah Ayalon!\""
 },
 {
   "id": 6079,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 13,
   "firman": "Maka berhentilah matahari dan bulanpun tidak bergerak, sampai bangsa itu membalaskan dendamnya kepada musuhnya. Bukankah hal itu telah tertulis dalam Kitab Orang Jujur? Matahari tidak bergerak di tengah langit dan lambat-lambat terbenam kira-kira sehari penuh."
 },
 {
   "id": 6080,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 14,
   "firman": "Belum pernah ada hari seperti itu, baik dahulu maupun kemudian, bahwa TUHAN mendengarkan permohonan seorang manusia secara demikian, sebab yang berperang untuk orang Israel ialah TUHAN."
 },
 {
   "id": 6081,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kemudian Yosua dan seluruh orang Israel yang menyertainya pulang kembali ke tempat perkemahan di Gilgal."
 },
 {
   "id": 6082,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 16,
   "firman": "Kelima raja itu melarikan diri dan bersembunyi di dalam gua di Makeda."
 },
 {
   "id": 6083,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 17,
   "firman": "Kepada Yosua dikabarkan, demikian: \"Kelima raja itu telah ditemukan bersembunyi di dalam gua di Makeda.\""
 },
 {
   "id": 6084,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lalu berkatalah Yosua: \"Gulingkanlah batu-batu yang besar ke mulut gua itu dan tempatkanlah di sana orang untuk menjaga mereka."
 },
 {
   "id": 6085,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 19,
   "firman": "Tetapi kamu, janganlah kamu berhenti, kejarlah musuhmu dan hantamlah barisan belakangnya; janganlah biarkan mereka masuk ke dalam kota-kota mereka, sebab TUHAN, Allahmu, menyerahkan mereka kepadamu!\""
 },
 {
   "id": 6086,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 20,
   "firman": "Setelah Yosua dan orang Israel selesai menimbulkan kekalahan yang besar sekali di antara mereka, sampai mereka dihancurkan sama sekali--beberapa orang dari mereka dapat lolos dan masuk ke kota-kota yang diperkuat--"
 },
 {
   "id": 6087,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 21,
   "firman": "pulanglah seluruh bangsa itu dengan selamat kepada Yosua ke tempat perkemahan, di Makeda. Tidak ada seorangpun yang berani melemparkan kata-kata ancaman terhadap orang Israel."
 },
 {
   "id": 6088,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 22,
   "firman": "Kemudian berkatalah Yosua: \"Bukalah mulut gua dan keluarkanlah kelima raja itu dari dalam dan bawa kepadaku.\""
 },
 {
   "id": 6089,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 23,
   "firman": "Dilakukan oranglah demikian, kelima raja itu dikeluarkan dari gua itu dan dibawa kepadanya: raja Yerusalem, raja Hebron, raja Yarmut, raja Lakhis dan raja Eglon."
 },
 {
   "id": 6090,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 24,
   "firman": "Setelah raja-raja itu dikeluarkan dan dibawa kepada Yosua, maka Yosuapun memanggil semua orang Israel berkumpul dan berkata kepada para panglima tentara, yang ikut berperang bersama-sama dengan dia: \"Marilah dekat, taruhlah kakimu ke atas tengkuk raja-raja ini.\" Maka datanglah mereka dekat dan menaruh kakinya ke atas tengkuk raja-raja itu."
 },
 {
   "id": 6091,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 25,
   "firman": "Lalu berkatalah Yosua kepada mereka: \"Janganlah takut dan janganlah tawar hati, kuatkan dan teguhkanlah hatimu, sebab secara itulah akan dilakukan TUHAN kepada semua musuhmu, yang kamu perangi.\""
 },
 {
   "id": 6092,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 26,
   "firman": "Sesudah itu Yosua membunuh raja-raja itu, dan menggantung mereka pada lima tiang, dan mereka tinggal tergantung pada tiang-tiang itu sampai matahari terbenam."
 },
 {
   "id": 6093,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 27,
   "firman": "Tetapi menjelang matahari terbenam, atas perintah Yosua mayat mereka diturunkan dari tiang-tiang itu, dan dilemparkan ke dalam gua, tempat mereka bersembunyi. Lalu mulut gua itu ditutupi orang dengan batu-batu besar, yang masih ada sampai sekarang."
 },
 {
   "id": 6094,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 28,
   "firman": "Pada hari itu Yosua merebut Makeda dan kota itu dipukulnya dengan mata pedang, juga rajanya; kota itu dan semua makhluk yang ada di dalamnya ditumpasnya, tidak ada seorangpun yang dibiarkannya lolos, dan raja Makeda, diperlakukannya seperti telah diperlakukannya raja Yerikho."
 },
 {
   "id": 6095,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 29,
   "firman": "Kemudian Yosua dengan seluruh Israel berjalan terus dari Makeda ke Libna, lalu memerangi Libna."
 },
 {
   "id": 6096,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 30,
   "firman": "Dan TUHAN menyerahkan kota itu juga kepada orang Israel, beserta rajanya. Yosua memukul kota itu dan semua makhluk yang ada di dalamnya dengan mata pedang, tidak ada seorangpun di dalamnya yang dibiarkannya lolos, dan rajanya itu, diperlakukannya seperti telah diperlakukannya raja Yerikho."
 },
 {
   "id": 6097,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 31,
   "firman": "Kemudian Yosua dengan seluruh Israel berjalan terus dari Libna ke Lakhis, lalu berkemah mengepung kota itu dan berperang melawannya."
 },
 {
   "id": 6098,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 32,
   "firman": "Dan TUHAN menyerahkan Lakhis kepada orang Israel. Yosua merebut kota itu pada hari yang kedua. Kota itu dan semua makhluk yang ada di dalamnya dipukulnya dengan mata pedang, tepat seperti yang dilakukannya terhadap Libna."
 },
 {
   "id": 6099,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 33,
   "firman": "Lalu Horam, raja Gezer, maju untuk membantu Lakhis, tetapi Yosua menewaskan dia dan rakyatnya, sehingga tidak ada seorangpun padanya yang dibiarkannya lolos."
 },
 {
   "id": 6100,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 34,
   "firman": "Kemudian Yosua dengan seluruh Israel berjalan terus dari Lakhis ke Eglon, lalu mereka berkemah mengepung kota itu dan berperang melawannya."
 },
 {
   "id": 6101,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 35,
   "firman": "Kota itu direbut mereka pada hari itu juga dan dipukul dengan mata pedang. Semua makhluk yang ada di dalamnya ditumpasnya pada hari itu, tepat seperti yang dilakukan terhadap Lakhis."
 },
 {
   "id": 6102,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 36,
   "firman": "Kemudian Yosua dengan seluruh Israel bergerak maju dari Eglon ke Hebron, lalu berperang melawannya."
 },
 {
   "id": 6103,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 37,
   "firman": "Negeri itu direbut mereka dan dipukul dengan mata pedang, juga rajanya dan segala kotanya dan semua makhluk yang ada di dalamnya, tidak seorangpun yang dibiarkannya lolos, tepat seperti yang dilakukannya terhadap Eglon. Kota itu dan semua makhluk yang ada di dalamnya ditumpasnya."
 },
 {
   "id": 6104,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 38,
   "firman": "Kemudian Yosua dengan seluruh Israel kembali ke Debir, lalu berperang melawannya."
 },
 {
   "id": 6105,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 39,
   "firman": "Negeri itu beserta rajanya dan segala kotanya direbutnya, dan dipukul dengan mata pedang. Semua makhluk yang ada di dalamnya ditumpas mereka, tidak seorangpun yang dibiarkannya lolos; seperti yang dilakukannya terhadap Hebron, demikianlah dilakukan terhadap Debir beserta rajanya, sama seperti yang dilakukannya terhadap Libna beserta rajanya."
 },
 {
   "id": 6106,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 40,
   "firman": "Demikianlah Yosua mengalahkan seluruh negeri itu, Pegunungan, Tanah Negeb, Daerah Bukit dan Lereng Gunung, beserta semua raja mereka. Tidak seorangpun yang dibiarkannya lolos, tetapi ditumpasnya semua yang bernafas, seperti yang diperintahkan TUHAN, Allah Israel."
 },
 {
   "id": 6107,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 41,
   "firman": "Yosua menewaskan mereka dari Kadesh-Barnea sampai Gaza, juga seluruh tanah Gosyen sampai Gibeon."
 },
 {
   "id": 6108,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 42,
   "firman": "Semua raja ini dan negeri mereka telah dikalahkan Yosua sekaligus, sebab yang berperang untuk orang Israel ialah TUHAN, Allah Israel."
 },
 {
   "id": 6109,
   "kitab": "Yos",
   "pasal": 10,
   "ayat": 43,
   "firman": "Kemudian Yosua dengan seluruh Israel pulang kembali ke tempat perkemahan di Gilgal."
 },
 {
   "id": 6110,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 1,
   "firman": "Setelah hal itu terdengar kepada Yabin, raja Hazor, diutusnyalah orang kepada Yobab, raja Madon, dan kepada raja negeri Simron, kepada raja negeri Akhsaf,"
 },
 {
   "id": 6111,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 2,
   "firman": "serta kepada raja-raja yang di sebelah utara, di Pegunungan, di Araba-Yordan di sebelah selatan Kinerot, di Daerah Bukit dan di tanah bukit Dor di sebelah barat,"
 },
 {
   "id": 6112,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 3,
   "firman": "yakni raja-raja orang Kanaan di sebelah timur dan di sebelah barat, orang Amori, orang Het, orang Feris, orang Yebus di pegunungan dan orang Hewi di kaki gunung Hermon, di tanah Mizpa."
 },
 {
   "id": 6113,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 4,
   "firman": "Kemudian keluarlah raja-raja ini bersama-sama semua tentaranya, amat banyak rakyat, seperti pasir di tepi laut banyaknya, beserta sangat banyak kuda dan kereta."
 },
 {
   "id": 6114,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 5,
   "firman": "Raja-raja ini bersekutu dan datang berkemah bersama-sama dekat mata air Merom untuk memerangi orang Israel."
 },
 {
   "id": 6115,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 6,
   "firman": "Lalu TUHAN berkata kepada Yosua: \"Janganlah takut menghadapi mereka, sebab besok kira-kira waktu ini Aku menyerahkan mereka mati terbunuh semuanya kepada orang Israel. Kuda mereka haruslah kamu lumpuhkan dan kereta mereka haruslah kamu bakar dengan api.\""
 },
 {
   "id": 6116,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 7,
   "firman": "Lalu Yosua dengan seluruh tentaranya mendatangi mereka dengan tiba-tiba dekat mata air Merom, dan menyerbu mereka."
 },
 {
   "id": 6117,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 8,
   "firman": "Dan TUHAN menyerahkan mereka kepada orang Israel. Mereka dikalahkan dan dikejar sampai Sidon-Besar dan sampai Misrefot-Maim, dan sampai lembah Mizpa yang di sebelah timur. Demikianlah mereka dihancurkan, sehingga tidak seorangpun dari mereka yang dibiarkan lolos."
 },
 {
   "id": 6118,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 9,
   "firman": "Yosua melakukan terhadap mereka seperti yang difirmankan TUHAN kepadanya: kuda mereka dilumpuhkan dan kereta mereka dibakar dengan api."
 },
 {
   "id": 6119,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 10,
   "firman": "Pada waktu itu Yosua kembali, direbutnya Hazor, dan rajanya dibunuhnya dengan mata pedang. Sebab Hazor pada waktu dahulu adalah yang terutama di antara segala kerajaan itu."
 },
 {
   "id": 6120,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 11,
   "firman": "Semua makhluk yang ada di dalamnya dibunuhnya dengan mata pedang, sambil menumpas orang-orang itu. Tidak ada yang tinggal hidup dari semua yang bernafas dan Hazor dibakarnya."
 },
 {
   "id": 6121,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 12,
   "firman": "Selanjutnya segala kota kepunyaan raja-raja itu dan semua rajanya dikalahkan Yosua dan dibunuhnya dengan mata pedang. Mereka ditumpasnya seperti yang diperintahkan Musa, hamba TUHAN itu."
 },
 {
   "id": 6122,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 13,
   "firman": "Tetapi kota-kota yang letaknya di atas bukit-bukit puing tidaklah dibakar oleh orang Israel, hanya Hazor saja yang dibakar oleh Yosua."
 },
 {
   "id": 6123,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 14,
   "firman": "Segala barang dari kota-kota itu serta ternaknya telah dijarah orang Israel. Tetapi manusia semuanya dibunuh mereka dengan mata pedang, sehingga orang-orang itu dipunahkan mereka. Tidak ada yang ditinggalkan hidup dari semua yang bernafas."
 },
 {
   "id": 6124,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 15,
   "firman": "Seperti yang diperintahkan TUHAN kepada Musa, hamba-Nya itu, demikianlah diperintahkan Musa kepada Yosua dan seperti itulah dilakukan Yosua: tidak ada sesuatu yang diabaikannya dari segala yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 6125,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 16,
   "firman": "Demikianlah Yosua merebut seluruh negeri itu, pegunungan, seluruh Tanah Negeb, seluruh tanah Gosyen, Daerah Bukit, serta Araba-Yordan, dan Pegunungan Israel dengan tanah rendahnya;"
 },
 {
   "id": 6126,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 17,
   "firman": "mulai dari Pegunungan Gundul, yang mendaki ke arah Seir, sampai ke Baal-Gad di lembah gunung Libanon, di kaki gunung Hermon. Semua rajanya ditangkapnya, dan dibunuhnya."
 },
 {
   "id": 6127,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 18,
   "firman": "Lama Yosua melakukan perang melawan semua raja itu."
 },
 {
   "id": 6128,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 19,
   "firman": "Tidak ada satu kotapun yang mengadakan ikatan persahabatan dengan orang Israel, selain dari pada orang Hewi yang diam di Gibeon itu, semuanya telah direbut mereka dengan berperang."
 },
 {
   "id": 6129,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 20,
   "firman": "Karena TUHAN yang menyebabkan hati orang-orang itu menjadi keras, sehingga mereka berperang melawan orang Israel, supaya mereka ditumpas, dan jangan dikasihani, tetapi dipunahkan, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 6130,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 21,
   "firman": "Pada waktu itu Yosua datang dan melenyapkan orang Enak dari pegunungan, dari Hebron, Debir dan Anab, dari seluruh pegunungan Yehuda dan dari seluruh pegunungan Israel. Mereka dan kota-kota mereka ditumpas oleh Yosua."
 },
 {
   "id": 6131,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 22,
   "firman": "Tidak ada lagi orang Enak ditinggalkan hidup di negeri orang Israel; hanya di Gaza, di Gat dan di Asdod masih ada yang tertinggal."
 },
 {
   "id": 6132,
   "kitab": "Yos",
   "pasal": 11,
   "ayat": 23,
   "firman": "Demikianlah Yosua merebut seluruh negeri itu sesuai dengan segala yang difirmankan TUHAN kepada Musa. Dan Yosuapun memberikan negeri itu kepada orang Israel menjadi milik pusaka mereka, menurut pembagian suku mereka. Lalu amanlah negeri itu, berhenti dari berperang."
 },
 {
   "id": 6133,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 1,
   "firman": "Inilah raja-raja negeri yang dikalahkan oleh orang Israel dan yang negerinya diduduki mereka di seberang Yordan ke arah matahari terbit, dari sungai Arnon sampai gunung Hermon, serta seluruh Araba-Yordan ke arah timur:"
 },
 {
   "id": 6134,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 2,
   "firman": "yakni Sihon, raja orang Amori, yang diam di Hesybon, yang memerintah atas suatu daerah dari Aroer, yang letaknya di tepi sungai Arnon, pada pertengahan sungai itu, ditambah setengah Gilead, sampai sungai Yabok, batas daerah bani Amon,"
 },
 {
   "id": 6135,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 3,
   "firman": "dan atas Araba-Yordan sampai sebelah timur danau Kinerot dan sampai sebelah timur Laut Araba, yakni Laut Asin, ke arah Bet-Yesimot dan ke arah selatan sampai kaki lereng-lereng gunung Pisga."
 },
 {
   "id": 6136,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 4,
   "firman": "Selanjutnya daerah Og, raja Basan, seorang dari sisa-sisa orang Refaim. Raja ini diam di Asytarot dan di Edrei,"
 },
 {
   "id": 6137,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 5,
   "firman": "dan memerintah atas gunung Hermon, atas Salkha dan atas seluruh Basan sampai daerah orang Gesur dan orang Maakha dan atas setengah Gilead, sampai daerah Sihon, raja Hesybon."
 },
 {
   "id": 6138,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 6,
   "firman": "Musa, hamba TUHAN itu, beserta orang Israel, telah mengalahkan mereka, dan Musa, hamba TUHAN itu, telah memberikan daerah itu kepada orang Ruben, orang Gad dan suku Manasye yang setengah itu, menjadi milik mereka."
 },
 {
   "id": 6139,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 7,
   "firman": "Inilah raja negeri yang dikalahkan oleh Yosua dan oleh orang Israel di sebelah barat sungai Yordan, dari Baal-Gad di lembah gunung Libanon sampai Pegunungan Gundul, yang mendaki ke arah Seir--negeri ini diberikan Yosua kepada suku-suku Israel menjadi miliknya, menurut pembagiannya,"
 },
 {
   "id": 6140,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 8,
   "firman": "di Pegunungan, di Daerah Bukit, di Araba-Yordan, di Lereng Gunung, di Padang Gurun dan di Tanah Negeb, yakni di negeri orang Het, orang Amori, orang Kanaan, orang Feris, orang Hewi dan orang Yebus--:"
 },
 {
   "id": 6141,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 9,
   "firman": "Raja negeri Yerikho, satu; raja negeri Ai, di sebelah Betel, satu;"
 },
 {
   "id": 6142,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 10,
   "firman": "raja negeri Yerusalem, satu; raja negeri Hebron, satu;"
 },
 {
   "id": 6143,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 11,
   "firman": "raja negeri Yarmut, satu; raja negeri Lakhis, satu;"
 },
 {
   "id": 6144,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 12,
   "firman": "raja negeri Eglon, satu; raja negeri Gezer, satu;"
 },
 {
   "id": 6145,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 13,
   "firman": "raja negeri Debir, satu; raja negeri Geder, satu;"
 },
 {
   "id": 6146,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 14,
   "firman": "raja negeri Horma, satu; raja negeri Arad, satu;"
 },
 {
   "id": 6147,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 15,
   "firman": "raja negeri Libna, satu; raja negeri Adulam, satu;"
 },
 {
   "id": 6148,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 16,
   "firman": "raja negeri Makeda, satu; raja negeri Betel, satu;"
 },
 {
   "id": 6149,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 17,
   "firman": "raja negeri Tapuah, satu; raja negeri Hefer, satu;"
 },
 {
   "id": 6150,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 18,
   "firman": "raja negeri Afek, satu; raja negeri Lasaron, satu;"
 },
 {
   "id": 6151,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 19,
   "firman": "raja negeri Madon, satu; raja negeri Hazor, satu;"
 },
 {
   "id": 6152,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 20,
   "firman": "raja negeri Simron Meron, satu; raja negeri Akhsaf, satu;"
 },
 {
   "id": 6153,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 21,
   "firman": "raja negeri Taanakh, satu; raja negeri Megido, satu;"
 },
 {
   "id": 6154,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 22,
   "firman": "raja negeri Kedesh, satu; raja negeri Yokneam di dekat gunung Karmel, satu;"
 },
 {
   "id": 6155,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 23,
   "firman": "raja negeri Dor di tanah bukit Dor, satu; raja negeri Goyim di Galilea, satu;"
 },
 {
   "id": 6156,
   "kitab": "Yos",
   "pasal": 12,
   "ayat": 24,
   "firman": "raja negeri Tirza, satu; jadi jumlah semua raja itu, tiga puluh satu orang."
 },
 {
   "id": 6157,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 1,
   "firman": "Setelah Yosua menjadi tua dan lanjut umurnya, berfirmanlah TUHAN kepadanya: \"Engkau telah tua dan lanjut umur, dan dari negeri ini masih amat banyak yang belum diduduki."
 },
 {
   "id": 6158,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 2,
   "firman": "Inilah negeri yang tertinggal: segenap wilayah orang Filistin dan seluruh negeri orang Gesur,"
 },
 {
   "id": 6159,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 3,
   "firman": "mulai dari sungai Sikhor di sebelah timur Mesir sampai ke daerah Ekron ke arah utara--semuanya itu terhitung tanah orang Kanaan--;ada lima raja kota orang Filistin, yakni di Gaza, di Asdod, di Askelon, di Gat dan di Ekron--;dan orang Awi"
 },
 {
   "id": 6160,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 4,
   "firman": "di sebelah selatan; seluruh negeri orang Kanaan dan Meara, kepunyaan orang Sidon, sampai ke Afek, sampai ke daerah orang Amori;"
 },
 {
   "id": 6161,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 5,
   "firman": "selanjutnya negeri orang Gebal dan seluruh gunung Libanon di sebelah matahari terbit, mulai dari Baal-Gad di kaki gunung Hermon sampai ke jalan yang menuju ke Hamat;"
 },
 {
   "id": 6162,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 6,
   "firman": "semua orang yang diam di pegunungan, mulai dari gunung Libanon sampai ke Misrefot-Maim; semua orang Sidon. Aku sendiri akan menghalau mereka dari depan orang Israel; hanya undikanlah dahulu negeri itu di antara orang Israel menjadi milik pusaka mereka, seperti yang Kuperintahkan kepadamu."
 },
 {
   "id": 6163,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 7,
   "firman": "Oleh sebab itu, bagikanlah negeri ini kepada suku yang sembilan itu dan kepada suku Manasye yang setengah itu menjadi milik pusaka mereka.\""
 },
 {
   "id": 6164,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 8,
   "firman": "Bersama-sama dengan suku Manasye yang setengah lagi, orang Ruben dan orang Gad telah menerima milik pusaka mereka, yang telah diberikan Musa kepada mereka di sebelah timur sungai Yordan, seperti yang ditentukan Musa, hamba TUHAN itu, kepada mereka,"
 },
 {
   "id": 6165,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 9,
   "firman": "yakni mulai dari Aroer, yang di tepi sungai Arnon, kota pada pertengahan sungai itu, dan seluruh dataran tinggi, dari Medeba sampai ke Dibon;"
 },
 {
   "id": 6166,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 10,
   "firman": "dan segala kota Sihon, raja orang Amori, yang berkerajaan di Hesybon, sampai ke daerah orang Amon;"
 },
 {
   "id": 6167,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 11,
   "firman": "selanjutnya Gilead dan daerah orang Gesur dan orang Maakha, serta seluruh gunung Hermon dan seluruh tanah Basan sampai ke Salkha,"
 },
 {
   "id": 6168,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 12,
   "firman": "seluruh kerajaan Og di Basan, yang memerintah di Asytarot dan Edrei, dialah yang tinggal hidup dari sisa-sisa orang Refaim yang telah dikalahkan dan dihalau oleh Musa."
 },
 {
   "id": 6169,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 13,
   "firman": "Tetapi orang Israel tidak menghalau orang Gesur dan orang Maakha itu, sehingga Gesur dan Maakha masih tetap diam di tengah-tengah Israel sampai sekarang."
 },
 {
   "id": 6170,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 14,
   "firman": "Hanya kepada suku Lewi tidak diberikan milik pusaka: yang menjadi milik pusakanya ialah TUHAN, Allah Israel, seperti yang dijanjikan-Nya kepada mereka."
 },
 {
   "id": 6171,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 15,
   "firman": "Kepada suku bani Ruben, menurut kaum-kaum mereka, telah diberikan Musa bagian ini:"
 },
 {
   "id": 6172,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 16,
   "firman": "daerah kepunyaan mereka mulai dari Aroer yang di tepi sungai Arnon, kota pada pertengahan sungai itu, dan seluruh dataran tinggi dekat Medeba;"
 },
 {
   "id": 6173,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 17,
   "firman": "Hesybon dan segala kotanya, yang di dataran tinggi, yakni Dibon, Bamot-Baal, Bet-Baal-Meon,"
 },
 {
   "id": 6174,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 18,
   "firman": "Yahas, Kedemot, Mefaat,"
 },
 {
   "id": 6175,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kiryataim, Sibma, Zeret-Hasahar di atas gunung di lembah itu,"
 },
 {
   "id": 6176,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 20,
   "firman": "Bet-Peor, lereng-lereng gunung Pisga, Bet-Yesimot,"
 },
 {
   "id": 6177,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 21,
   "firman": "selanjutnya segala kota di dataran tinggi itu dan seluruh kerajaan Sihon, raja orang Amori, yang memerintah di Hesybon, yang dikalahkan oleh Musa; bersama-sama dia juga dikalahkannya raja-raja Midian, yakni Ewi, Rekem, Zur, Hur dan Reba, raja-raja bawahan Sihon, penduduk negeri itu."
 },
 {
   "id": 6178,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 22,
   "firman": "Juga Bileam bin Beor, juru tenung itu, telah dibunuh oleh orang Israel dengan pedang, beserta orang-orang yang telah mati tertikam oleh mereka."
 },
 {
   "id": 6179,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 23,
   "firman": "Jadi batas daerah bani Ruben ialah sungai Yordan dengan daerah pinggirnya. Itulah milik pusaka bani Ruben menurut kaum-kaum mereka, yakni kota-kota dengan desa-desanya."
 },
 {
   "id": 6180,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 24,
   "firman": "Kepada suku Gad, yakni kepada bani Gad menurut kaum-kaum mereka, telah diberikan Musa bagian ini:"
 },
 {
   "id": 6181,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 25,
   "firman": "daerah kepunyaan mereka ialah Yaezer dan segala kota negeri Gilead, serta setengah negeri orang Amon sampai ke Aroer, yang di sebelah timur Raba,"
 },
 {
   "id": 6182,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 26,
   "firman": "yakni mulai dari Hesybon sampai ke Ramat-Mizpa dan Betonim, dan dari Mahanaim sampai ke daerah Debir;"
 },
 {
   "id": 6183,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 27,
   "firman": "dan di lembah: Bet-Haram, Bet-Nimra, Sukot dan Zafon, sisa kerajaan Sihon, raja Hesybon; sungai Yordan dengan daerah pinggirnya, sampai ke ujung danau Kineret, di sebelah timur sungai Yordan."
 },
 {
   "id": 6184,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 28,
   "firman": "Itulah milik pusaka bani Gad menurut kaum-kaum mereka, yakni kota-kota dengan desa-desanya."
 },
 {
   "id": 6185,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 29,
   "firman": "Kepada suku Manasye yang setengah itu, yakni kepada puak bani Manasye yang setengah itu, menurut kaum-kaum mereka, telah diberikan Musa bagian ini:"
 },
 {
   "id": 6186,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 30,
   "firman": "daerah mereka mulai dari Mahanaim: seluruh Basan, seluruh kerajaan Og, raja Basan, dan segenap Hawot-Yair, yang di Basan itu, enam puluh kota banyaknya;"
 },
 {
   "id": 6187,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 31,
   "firman": "selanjutnya setengah Gilead, Asytarot dan Edrei, kota-kota kerajaan Og di Basan, menjadi bagian bani Makhir, anak Manasye, yaitu bagian setengah bani Makhir menurut kaum-kaum mereka."
 },
 {
   "id": 6188,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 32,
   "firman": "Itulah semuanya yang dibagikan Musa sebagai milik pusaka di dataran Moab di sebelah timur sungai Yordan dekat Yerikho."
 },
 {
   "id": 6189,
   "kitab": "Yos",
   "pasal": 13,
   "ayat": 33,
   "firman": "Tetapi kepada suku Lewi Musa tidak memberikan milik pusaka: TUHAN, Allah Israel, Dialah yang menjadi milik pusaka mereka, seperti yang dijanjikan-Nya kepada mereka."
 },
 {
   "id": 6190,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 1,
   "firman": "Inilah semuanya yang diterima oleh orang Israel sebagai milik pusaka di tanah Kanaan, yang telah dibagikan kepada orang Israel oleh imam Eleazar, dan Yosua bin Nun dan para kepala kaum keluarga dari suku-suku mereka,"
 },
 {
   "id": 6191,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 2,
   "firman": "dengan mengundi milik pusaka itu, seperti yang diperintahkan TUHAN dengan perantaraan Musa mengenai suku-suku yang sembilan setengah itu."
 },
 {
   "id": 6192,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 3,
   "firman": "Sebab kepada suku-suku yang dua setengah lagi telah diberikan Musa milik pusaka di seberang sungai Yordan, tetapi kepada orang Lewi tidak diberikannya milik pusaka di tengah-tengah mereka."
 },
 {
   "id": 6193,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 4,
   "firman": "Sebab bani Yusuf merupakan dua suku, Manasye dan Efraim. Maka kepada orang Lewi tidak diberikan bagiannya di negeri itu, selain dari kota-kota untuk didiami, dengan tanah penggembalaannya untuk ternak dan hewan mereka."
 },
 {
   "id": 6194,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 5,
   "firman": "Seperti yang diperintahkan TUHAN kepada Musa, demikianlah diperbuat oleh orang Israel dan dibagi-bagi merekalah negeri itu."
 },
 {
   "id": 6195,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 6,
   "firman": "Bani Yehuda datang menghadap Yosua di Gilgal. Pada waktu itu berkatalah Kaleb bin Yefune, orang Kenas itu, kepadanya: \"Engkau tahu firman yang diucapkan TUHAN kepada Musa, abdi Allah itu, tentang aku dan tentang engkau di Kadesh-Barnea."
 },
 {
   "id": 6196,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 7,
   "firman": "Aku berumur empat puluh tahun, ketika aku disuruh Musa, hamba TUHAN itu, dari Kadesh-Barnea untuk mengintai negeri ini; dan aku pulang membawa kabar kepadanya yang sejujur-jujurnya."
 },
 {
   "id": 6197,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 8,
   "firman": "Sedang saudara-saudaraku, yang bersama-sama pergi ke sana dengan aku, membuat tawar hati bangsa itu, aku tetap mengikuti TUHAN, Allahku, dengan sepenuh hati."
 },
 {
   "id": 6198,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 9,
   "firman": "Pada waktu itu Musa bersumpah, katanya: Sesungguhnya tanah yang diinjak oleh kakimu itu akan menjadi milik pusakamu dan anak-anakmu sampai selama-lamanya, sebab engkau tetap mengikuti TUHAN, Allahku, dengan sepenuh hati."
 },
 {
   "id": 6199,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 10,
   "firman": "Jadi sekarang, sesungguhnya TUHAN telah memelihara hidupku, seperti yang dijanjikan-Nya. Kini sudah empat puluh lima tahun lamanya, sejak diucapkan TUHAN firman itu kepada Musa, dan selama itu orang Israel mengembara di padang gurun. Jadi sekarang, telah berumur delapan puluh lima tahun aku hari ini;"
 },
 {
   "id": 6200,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 11,
   "firman": "pada waktu ini aku masih sama kuat seperti pada waktu aku disuruh Musa; seperti kekuatanku pada waktu itu demikianlah kekuatanku sekarang untuk berperang dan untuk keluar masuk."
 },
 {
   "id": 6201,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 12,
   "firman": "Oleh sebab itu, berikanlah kepadaku pegunungan, yang dijanjikan TUHAN pada waktu itu, sebab engkau sendiri mendengar pada waktu itu, bahwa di sana ada orang Enak dengan kota-kota yang besar dan berkubu. Mungkin TUHAN menyertai aku, sehingga aku menghalau mereka, seperti yang difirmankan TUHAN.\""
 },
 {
   "id": 6202,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 13,
   "firman": "Lalu Yosua memberkati Kaleb bin Yefune, dan diberikannyalah Hebron kepadanya menjadi milik pusakanya."
 },
 {
   "id": 6203,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 14,
   "firman": "Itulah sebabnya Hebron menjadi milik pusaka Kaleb bin Yefune, orang Kenas itu, sampai sekarang ini, karena ia tetap mengikuti TUHAN, Allah Israel, dengan sepenuh hati."
 },
 {
   "id": 6204,
   "kitab": "Yos",
   "pasal": 14,
   "ayat": 15,
   "firman": "Nama Hebron dahulu ialah Kiryat-Arba; Arba ialah orang yang paling besar di antara orang Enak. Dan amanlah negeri itu, berhenti berperang."
 },
 {
   "id": 6205,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 1,
   "firman": "Bagian yang diundikan kepada suku bani Yehuda menurut kaum-kaum mereka adalah sampai ke batas tanah Edom, sampai ke padang gurun Zin ke selatan, di ujung selatan."
 },
 {
   "id": 6206,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 2,
   "firman": "Batas selatan bagi mereka mulai dari ujung Laut Asin, dari teluk yang menghadap ke selatan;"
 },
 {
   "id": 6207,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 3,
   "firman": "lalu keluar pada sebelah selatan pendakian Akrabim, terus ke Zin, naik ke sebelah selatan Kadesh-Barnea, terus ke Hezron, naik ke Adar, membelok ke Karka,"
 },
 {
   "id": 6208,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 4,
   "firman": "terus ke Azmon dan keluar pada sungai tanah Mesir, sehingga batas itu berakhir ke laut. Itulah bagi kamu batas selatan."
 },
 {
   "id": 6209,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 5,
   "firman": "Batas timur ialah Laut Asin sampai ke muara sungai Yordan. Batas pada sisi utara mulai dari teluk di muara sungai Yordan itu:"
 },
 {
   "id": 6210,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 6,
   "firman": "batas itu naik ke Bet-Hogla, melalui sebelah utara Bet-Araba, kemudian batas itu naik ke batu Bohan bin Ruben;"
 },
 {
   "id": 6211,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 7,
   "firman": "lalu dari lembah Akhor batas itu naik ke Debir, dan menuju ke utara ke Gilgal di seberang pendakian Adumim, yang di sebelah selatan sungai. Kemudian batas itu terus ke mata air En-Semes dan keluar ke En-Rogel."
 },
 {
   "id": 6212,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 8,
   "firman": "Kemudian batas itu naik ke lembah Ben-Hinom, di sebelah selatan sepanjang lereng gunung Yebus, itulah Yerusalem; kemudian batas itu naik ke puncak gunung yang di seberang lembah Hinom, di sebelah barat, di ujung utara lembah orang Refaim."
 },
 {
   "id": 6213,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 9,
   "firman": "Kemudian batas itu melengkung dari puncak gunung itu ke mata air Me-Neftoah, lalu keluar ke kota-kota pegunungan Efron; selanjutnya batas itu melengkung ke Baala, itulah Kiryat-Yearim."
 },
 {
   "id": 6214,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 10,
   "firman": "Kemudian batas itu membelok dari Baala ke barat ke pegunungan Seir, terus ke utara ke lereng gunung Yearim, itulah Kesalon, turun ke Bet-Semes dan terus ke Timna."
 },
 {
   "id": 6215,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 11,
   "firman": "Kemudian batas itu keluar ke utara ke lereng gunung Ekron; kemudian batas itu melengkung ke Sikron, terus ke gunung Baala dan keluar dekat Yabneel, sehingga batas itu berakhir di laut."
 },
 {
   "id": 6216,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 12,
   "firman": "Batas barat ialah Laut Besar dan pantainya. Itulah, ke segala penjuru, batas-batas daerah bani Yehuda menurut kaum-kaum mereka."
 },
 {
   "id": 6217,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 13,
   "firman": "Tetapi kepada Kaleb bin Yefune diberikan Yosua sebagian di tengah-tengah bani Yehuda itu, yakni Kiryat-Arba, seperti yang dititahkan TUHAN kepadanya; Arba ialah bapa Enak. Itulah Hebron."
 },
 {
   "id": 6218,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 14,
   "firman": "Dan Kaleb menghalau dari sana ketiga orang Enak, yakni Sesai, Ahiman dan Talmai, anak-anak Enak."
 },
 {
   "id": 6219,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 15,
   "firman": "Dari sana ia maju menyerang penduduk Debir. Nama Debir itu dahulu ialah Kiryat-Sefer."
 },
 {
   "id": 6220,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 16,
   "firman": "Lalu berkatalah Kaleb: \"Siapa yang menggempur Kiryat-Sefer dan merebutnya, kepadanya akan kuberikan Akhsa, anakku, menjadi isterinya.\""
 },
 {
   "id": 6221,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 17,
   "firman": "Dan Otniel, anak Kenas saudara Kaleb, merebut kota itu; lalu Kaleb memberikan kepadanya Akhsa, anaknya, menjadi isterinya."
 },
 {
   "id": 6222,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 18,
   "firman": "Ketika perempuan itu tiba, dibujuknya suaminya untuk meminta ladang kepada ayahnya. Maka turunlah perempuan itu dari keledainya, lalu berkatalah Kaleb kepadanya: \"Ada apa?\""
 },
 {
   "id": 6223,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 19,
   "firman": "Jawabnya: \"Berikanlah kepadaku hadiah; telah kauberikan kepadaku tanah yang gersang, berikanlah juga kepadaku mata air.\" Lalu diberikannyalah kepadanya mata air yang di hulu dan mata air yang di hilir."
 },
 {
   "id": 6224,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 20,
   "firman": "Inilah milik pusaka suku bani Yehuda menurut kaum-kaum mereka."
 },
 {
   "id": 6225,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 21,
   "firman": "Kota-kota suku bani Yehuda yang paling ujung, dekat batas tanah Edom di Tanah Negeb, ialah Kabzeel, Eder, Yagur,"
 },
 {
   "id": 6226,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 22,
   "firman": "Kina, Dimona, Adada,"
 },
 {
   "id": 6227,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 23,
   "firman": "Kedesh, Hazor, Yitnan,"
 },
 {
   "id": 6228,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 24,
   "firman": "Zif, Telem, Bealot,"
 },
 {
   "id": 6229,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 25,
   "firman": "Hazor-Hadata, Keriot-Hezron, itulah Hazor;"
 },
 {
   "id": 6230,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 26,
   "firman": "Amam, Sema, Molada,"
 },
 {
   "id": 6231,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 27,
   "firman": "Hazar-Gada, Hesmon, Bet-Pelet,"
 },
 {
   "id": 6232,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 28,
   "firman": "Hazar-Sual, Bersyeba dan segala anak kotanya,"
 },
 {
   "id": 6233,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 29,
   "firman": "Baala, Iyim, Ezem,"
 },
 {
   "id": 6234,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 30,
   "firman": "Eltolad, Kesil, Horma,"
 },
 {
   "id": 6235,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 31,
   "firman": "Ziklag, Madmana, Sansana,"
 },
 {
   "id": 6236,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 32,
   "firman": "Lebaot, Silhim, Ain dan Rimon; seluruhnya dua puluh sembilan kota dengan desa-desanya."
 },
 {
   "id": 6237,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 33,
   "firman": "Di Daerah Bukit: Esytaol, Zora, Asna,"
 },
 {
   "id": 6238,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 34,
   "firman": "Zanoah, En-Ganim, Tapuah, Enam,"
 },
 {
   "id": 6239,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 35,
   "firman": "Yarmut, Adulam, Sokho, Azeka,"
 },
 {
   "id": 6240,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 36,
   "firman": "Saaraim, Aditaim, Gedera dan Gederotaim; empat belas kota dengan desa-desanya."
 },
 {
   "id": 6241,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 37,
   "firman": "Zenan, Hadasa, Migdal-Gad,"
 },
 {
   "id": 6242,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 38,
   "firman": "Dilean, Mizpa, Yokteel,"
 },
 {
   "id": 6243,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 39,
   "firman": "Lakhis, Bozkat, Eglon,"
 },
 {
   "id": 6244,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 40,
   "firman": "Kabon, Lahmas, Kitlis,"
 },
 {
   "id": 6245,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 41,
   "firman": "Gederot, Bet-Dagon, Naama dan Makeda; enam belas kota dengan desa-desanya."
 },
 {
   "id": 6246,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 42,
   "firman": "Libna, Eter, Asan,"
 },
 {
   "id": 6247,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 43,
   "firman": "Yiftah, Asna, Nezib,"
 },
 {
   "id": 6248,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 44,
   "firman": "Kehila, Akhzib dan Maresa; sembilan kota dengan desa-desanya."
 },
 {
   "id": 6249,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 45,
   "firman": "Ekron dengan segala anak kota dan desanya."
 },
 {
   "id": 6250,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 46,
   "firman": "Mulai dari Ekron sampai ke laut, segala yang di sisi Asdod dan desa-desanya,"
 },
 {
   "id": 6251,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 47,
   "firman": "Asdod dengan segala anak kota dan desa-desanya, Gaza dengan segala anak kota dan desa-desanya, sampai ke sungai tanah Mesir, Laut Besar dan pantainya."
 },
 {
   "id": 6252,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 48,
   "firman": "Lagi di Pegunungan: Samir, Yatir, Sokho,"
 },
 {
   "id": 6253,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 49,
   "firman": "Dana, Kiryat-Sana, itulah Debir;"
 },
 {
   "id": 6254,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 50,
   "firman": "Anab, Estemo, Anim,"
 },
 {
   "id": 6255,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 51,
   "firman": "Gosyen, Holon dan Gilo; sebelas kota dengan desa-desanya;"
 },
 {
   "id": 6256,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 52,
   "firman": "Arab, Duma, Esan,"
 },
 {
   "id": 6257,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 53,
   "firman": "Yanum, Bet-Tapuah, Afeka,"
 },
 {
   "id": 6258,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 54,
   "firman": "Humta, Kiryat-Arba, itulah Hebron, dan Zior; sembilan kota dengan desa-desanya."
 },
 {
   "id": 6259,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 55,
   "firman": "Maon, Karmel, Zif, Yuta,"
 },
 {
   "id": 6260,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 56,
   "firman": "Yizreel, Yokdeam, Zanoah,"
 },
 {
   "id": 6261,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 57,
   "firman": "Kain, Gibea dan Timna; sepuluh kota dengan desa-desanya."
 },
 {
   "id": 6262,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 58,
   "firman": "Halhul, Bet-Zur, Gedor,"
 },
 {
   "id": 6263,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 59,
   "firman": "Maarat, Bet-Anot dan Eltekon; enam kota dengan desa-desanya."
 },
 {
   "id": 6264,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 60,
   "firman": "Kiryat-Baal, itulah Kiryat-Yearim, dan Raba; dua kota dengan desa-desanya."
 },
 {
   "id": 6265,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 61,
   "firman": "Di padang gurun: Bet-Araba, Midin, Sekhakha,"
 },
 {
   "id": 6266,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 62,
   "firman": "Nibsan, Kota Garam dan En-Gedi; enam kota dengan desa-desanya."
 },
 {
   "id": 6267,
   "kitab": "Yos",
   "pasal": 15,
   "ayat": 63,
   "firman": "Tetapi orang Yebus, penduduk kota Yerusalem, tidak dapat dihalau oleh bani Yehuda. Jadi orang Yebus itu masih tetap diam bersama-sama dengan bani Yehuda di Yerusalem sampai sekarang."
 },
 {
   "id": 6268,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 1,
   "firman": "Kemudian keluarlah undian bagi bani Yusuf. Batas mereka mulai dari sungai Yordan dekat Yerikho, di sebelah timur mata-mata air Yerikho, melalui padang gurun, yang naik dari Yerikho ke pegunungan, ke Betel,"
 },
 {
   "id": 6269,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 2,
   "firman": "keluar dari Betel menuju ke Lus, terus ke daerah orang Arki, ke Atarot,"
 },
 {
   "id": 6270,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 3,
   "firman": "turun ke barat ke daerah orang Yaflet, sampai daerah Bet-Horon Hilir dan selanjutnya sampai Gezer dan berakhir di laut."
 },
 {
   "id": 6271,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 4,
   "firman": "Demikianlah bani Yusuf, yakni suku Manasye dan suku Efraim, menerima milik pusaka."
 },
 {
   "id": 6272,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 5,
   "firman": "Daerah bani Efraim menurut kaum-kaum mereka ialah demikian: batas milik pusaka mereka ke timur ialah Atarot-Adar sampai Bet-Horon Hulu."
 },
 {
   "id": 6273,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 6,
   "firman": "Ke barat batas itu keluar di sebelah utara Mikhmetat; kemudian batas itu membelok ke timur ke Taanat-Silo, dan dari sana terus sampai ke sebelah timur Yanoah,"
 },
 {
   "id": 6274,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 7,
   "firman": "turun dari Yanoah ke Atarot dan Naharat, menyinggung daerah Yerikho dan keluar ke sungai Yordan."
 },
 {
   "id": 6275,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 8,
   "firman": "Dari Tapuah batas itu terus ke barat ke sungai Kana dan berakhir ke laut. Itulah milik pusaka suku bani Efraim menurut kaum-kaum mereka."
 },
 {
   "id": 6276,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 9,
   "firman": "Selanjutnya bagi bani Efraim ditentukan kota-kota terpisah di tengah-tengah milik pusaka bani Manasye, segala kota itu dengan desa-desanya."
 },
 {
   "id": 6277,
   "kitab": "Yos",
   "pasal": 16,
   "ayat": 10,
   "firman": "Tetapi orang Kanaan yang diam di Gezer tidaklah dihalau mereka. Jadi orang Kanaan itu masih tetap tinggal di tengah-tengah suku Efraim sampai sekarang, tetapi menjadi budak rodi."
 },
 {
   "id": 6278,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 1,
   "firman": "Bagian undian yang ditentukan bagi suku Manasye, sebab dialah anak sulung Yusuf, ialah demikian: Kepada Makhir, anak sulung Manasye, bapa Gilead, telah diberikan Gilead dan Basan, karena ia seorang tentara."
 },
 {
   "id": 6279,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 2,
   "firman": "Jadi bagian itulah yang ditentukan bagi anak-anak Manasye yang lain, menurut kaum-kaum mereka, yakni bagi bani Abiezer, bani Helek, bani Asriel, bani Sekhem, bani Hefer dan bani Semida; itulah keturunan yang laki-laki dari Manasye bin Yusuf, menurut kaum-kaum mereka."
 },
 {
   "id": 6280,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 3,
   "firman": "Tetapi Zelafehad bin Hefer bin Gilead bin Makhir bin Manasye tidak mempunyai anak laki-laki, tetapi hanya anak perempuan. Inilah nama anak-anaknya itu: Mahla, Noa, Hogla, Milka dan Tirza."
 },
 {
   "id": 6281,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 4,
   "firman": "Mereka datang menghadap imam Eleazar, dan menghadap Yosua bin Nun, serta para pemimpin, dan berkata: \"TUHAN telah memerintahkan kepada Musa untuk memberikan milik pusaka kepada kami di tengah-tengah saudara-saudara kami.\" Sebab itu diberikannya kepada mereka, milik pusaka di tengah-tengah saudara-saudara ayah mereka, sesuai dengan titah TUHAN."
 },
 {
   "id": 6282,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 5,
   "firman": "Demikianlah kepada suku Manasye jatuh sepuluh bidang tanah, selain dari tanah Gilead dan Basan yang di seberang Yordan,"
 },
 {
   "id": 6283,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 6,
   "firman": "sebab anak-anak perempuan Manasye telah menerima milik pusaka di tengah-tengah anak-anaknya lelaki, sedang tanah Gilead ditentukan bagi anak-anak lelaki Manasye yang lain."
 },
 {
   "id": 6284,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 7,
   "firman": "Jadi batas daerah Manasye ialah dari Asyer ke Mikhmetat yang di sebelah timur Sikhem; kemudian batas itu terus ke selatan ke daerah penduduk En-Tapuah."
 },
 {
   "id": 6285,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 8,
   "firman": "Tanah Tapuah adalah kepunyaan suku Manasye, tetapi kota Tapuah, dekat batas daerah Manasye, adalah kepunyaan bani Efraim."
 },
 {
   "id": 6286,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 9,
   "firman": "Kemudian batas itu turun ke sungai Kana, ke sebelah selatan sungai itu. Kota-kota di sana adalah kepunyaan suku Efraim, sekalipun di tengah-tengah kota-kota suku Manasye. Selanjutnya batas daerah Manasye itu lewat dari sebelah utara sungai itu dan berakhir ke laut."
 },
 {
   "id": 6287,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 10,
   "firman": "Ke selatan daerah itu kepunyaan suku Efraim dan ke utara kepunyaan suku Manasye. Batasnya ialah laut; di sebelah utara batas daerah itu menyinggung daerah Asyer, di sebelah timur menyinggung daerah Isakhar."
 },
 {
   "id": 6288,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 11,
   "firman": "Tetapi di daerah Isakhar dan Asyer ada juga kepunyaan suku Manasye, yakni Bet-Sean dengan segala anak kotanya, Yibleam dengan segala anak kotanya, penduduk Dor dengan segala anak kotanya, penduduk En-Dor dengan segala anak kotanya, penduduk Taanakh dengan segala anak kotanya, dan penduduk Megido dengan segala anak kotanya, yakni ketiga daerah bukit itu."
 },
 {
   "id": 6289,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 12,
   "firman": "Tetapi bani Manasye tidak dapat menduduki kota-kota itu, sebab orang Kanaan berhasil untuk tetap diam di negeri itu."
 },
 {
   "id": 6290,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 13,
   "firman": "Setelah orang Israel menjadi kuat, orang Kanaan itu dibuatnya menjadi orang rodi, tetapi tidaklah sama sekali mereka itu dihalaunya."
 },
 {
   "id": 6291,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 14,
   "firman": "Berkatalah bani Yusuf kepada Yosua, demikian: \"Mengapa engkau memberikan kepadaku hanya satu bagian undian dan satu bidang tanah saja menjadi milik pusaka, padahal aku ini bangsa yang banyak jumlahnya, karena TUHAN sampai sekarang memberkati aku?\""
 },
 {
   "id": 6292,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 15,
   "firman": "Jawab Yosua kepada mereka: \"Kalau engkau bangsa yang banyak jumlahnya, pergilah ke hutan dan bukalah tanah bagimu di sana di negeri orang Feris dan orang Refaim, jika pegunungan Efraim terlalu sesak bagimu.\""
 },
 {
   "id": 6293,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 16,
   "firman": "Kemudian berkatalah bani Yusuf: \"Pegunungan itu tidak cukup bagi kami, dan semua orang Kanaan yang diam di dataran itu mempunyai kereta besi, baik yang diam di Bet-Sean dengan segala anak kotanya maupun yang diam di lembah Yizreel.\""
 },
 {
   "id": 6294,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 17,
   "firman": "Lalu berkatalah Yosua kepada keturunan Yusuf, kepada suku Efraim dan suku Manasye: \"Engkau ini bangsa yang banyak jumlahnya dan mempunyai kekuatan yang besar; tidak hanya satu bagian undian ditentukan bagimu,"
 },
 {
   "id": 6295,
   "kitab": "Yos",
   "pasal": 17,
   "ayat": 18,
   "firman": "tetapi pegunungan itu akan ditentukan bagimu juga, dan karena tanah itu hutan, haruslah kamu membukanya; kamu akan memilikinya sampai kepada ujung-ujungnya, sebab kamu akan menghalau orang Kanaan itu, sekalipun mereka mempunyai kereta besi dan sekalipun mereka kuat.\""
 },
 {
   "id": 6296,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 1,
   "firman": "Maka berkumpullah segenap umat Israel di Silo, lalu mereka menempatkan Kemah Pertemuan di sana, karena negeri itu telah takluk kepada mereka."
 },
 {
   "id": 6297,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 2,
   "firman": "Pada waktu itu masih tinggal tujuh suku di antara orang Israel, yang belum mendapat bagian milik pusaka."
 },
 {
   "id": 6298,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 3,
   "firman": "Sebab itu berkatalah Yosua kepada orang Israel: \"Berapa lama lagi kamu bermalas-malas, sehingga tidak pergi menduduki negeri yang telah diberikan kepadamu oleh TUHAN, Allah nenek moyangmu?"
 },
 {
   "id": 6299,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 4,
   "firman": "Ajukanlah tiga orang dari tiap-tiap suku; maka aku akan menyuruh mereka, supaya mereka bersiap untuk menjelajahi negeri itu, mencatat keadaannya, sekadar milik pusaka masing-masing, kemudian kembali kepadaku."
 },
 {
   "id": 6300,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 5,
   "firman": "Sesudah itu mereka akan membaginya di antara mereka menjadi tujuh bagian. Suku Yehuda akan tetap tinggal dalam daerahnya di sebelah selatan dan keturunan Yusuf akan tetap tinggal dalam daerahnya di sebelah utara."
 },
 {
   "id": 6301,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 6,
   "firman": "Kamu catat keadaan negeri itu dalam tujuh bagian dan kamu bawa ke mari kepadaku; lalu aku akan membuang undi di sini bagi kamu di hadapan TUHAN, Allah kita."
 },
 {
   "id": 6302,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 7,
   "firman": "Sebab orang Lewi tidak mendapat bagian di tengah-tengah kamu, karena jabatan sebagai imam TUHAN ialah milik pusaka mereka, sedang suku Gad, suku Ruben dan suku Manasye yang setengah itu telah menerima milik pusaka di sebelah timur sungai Yordan, yang diberikan kepada mereka oleh Musa, hamba TUHAN.\""
 },
 {
   "id": 6303,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 8,
   "firman": "Kemudian bersiaplah orang-orang itu, lalu pergi, sedang Yosua memerintahkan kepada mereka, pada waktu mereka berangkat, supaya mereka mencatat keadaan negeri itu, katanya: \"Pergilah, jelajahilah negeri itu, catatkanlah keadaannya, kemudian kembalilah kepadaku; maka di sini, di Silo, aku akan membuang undi bagi kamu di hadapan TUHAN.\""
 },
 {
   "id": 6304,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 9,
   "firman": "Orang-orang itu pergi dan berjalan melalui negeri itu; mereka mencatat keadaannya dalam suatu daftar, kota demi kota, dalam tujuh bagian, lalu kembali kepada Yosua ke tempat perkemahan di Silo."
 },
 {
   "id": 6305,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 10,
   "firman": "Lalu Yosua membuang undi bagi mereka di Silo, di hadapan TUHAN, dan di sanalah Yosua membagikan negeri itu kepada orang Israel, sesuai dengan pembagian mereka."
 },
 {
   "id": 6306,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 11,
   "firman": "Maka keluarlah undian suku bani Benyamin menurut kaum-kaum mereka, dan daerah yang diundikan kepada mereka terdapat antara daerah bani Yehuda dan daerah bani Yusuf."
 },
 {
   "id": 6307,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 12,
   "firman": "Batas pada sisi utara bagi mereka mulai dari sungai Yordan; kemudian batas itu naik ke lereng gunung di sebelah utara Yerikho, naik ke barat ke pegunungan, dan menuju ke padang gurun Bet-Awen."
 },
 {
   "id": 6308,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 13,
   "firman": "Dari sana batas itu terus ke Lus, ke selatan, ke arah lereng gunung dekat Lus, itulah Betel; kemudian batas itu turun ke Atarot-Adar di pegunungan yang di sebelah selatan Bet-Horon Hilir."
 },
 {
   "id": 6309,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 14,
   "firman": "Kemudian batas itu melengkung, lalu membelok dari pegunungan yang di seberang Bet-Horon di sebelah selatan menuju ke sisi barat daya, dan berakhir di Kiryat-Baal, itulah Kiryat-Yearim, suatu kota bani Yehuda. Itulah sisi barat."
 },
 {
   "id": 6310,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 15,
   "firman": "Sisi selatan mulai dari ujung Kiryat-Yearim, kemudian batas itu menuju ke barat, dan menuju pula ke mata air Me-Neftoah."
 },
 {
   "id": 6311,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 16,
   "firman": "Selanjutnya batas itu turun ke ujung pegunungan yang di tentangan lebak Ben-Hinom, di sebelah utara lembah orang Refaim; kemudian turun ke lebak Hinom, sepanjang lereng gunung Yebus, ke selatan, kemudian turun ke En-Rogel."
 },
 {
   "id": 6312,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 17,
   "firman": "Kemudian melengkung ke utara, menuju ke En-Semes dan menuju pula ke Gelilot di seberang pendakian Adumim, turun ke batu Bohan bin Ruben,"
 },
 {
   "id": 6313,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 18,
   "firman": "terus ke lereng gunung di seberang Bet-Araba ke utara, dan turun ke Araba-Yordan."
 },
 {
   "id": 6314,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 19,
   "firman": "Kemudian batas itu terus ke lereng gunung dekat Bet-Hogla ke utara dan batas itu berakhir ke teluk utara Laut Asin, ke muara sungai Yordan di sebelah selatan. Itulah batas selatan."
 },
 {
   "id": 6315,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 20,
   "firman": "Sungai Yordan ialah batasnya pada sisi timur. Itulah milik pusaka bani Benyamin dengan batas-batasnya ke segala penjuru menurut kaum-kaum mereka."
 },
 {
   "id": 6316,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 21,
   "firman": "Kota-kota suku bani Benyamin menurut kaum-kaum mereka ialah Yerikho, Bet-Hogla, Emek-Kezis,"
 },
 {
   "id": 6317,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 22,
   "firman": "Bet-Araba, Zemaraim, Betel,"
 },
 {
   "id": 6318,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 23,
   "firman": "Haawim, Para, Ofra,"
 },
 {
   "id": 6319,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 24,
   "firman": "Kefar-Haamonai, Ofni dan Geba; dua belas kota dengan desa-desanya."
 },
 {
   "id": 6320,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 25,
   "firman": "Gibeon, Rama, Beerot,"
 },
 {
   "id": 6321,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 26,
   "firman": "Mizpa, Kefira, Moza,"
 },
 {
   "id": 6322,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 27,
   "firman": "Rekem, Yirpeel, Tarala,"
 },
 {
   "id": 6323,
   "kitab": "Yos",
   "pasal": 18,
   "ayat": 28,
   "firman": "Zela, Elef dan Yebus, ialah Yerusalem, Gibeat dan Kiryat; empat belas kota dengan desa-desanya. Itulah milik pusaka bani Benyamin menurut kaum-kaum mereka."
 },
 {
   "id": 6324,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 1,
   "firman": "Undian yang keduapun keluarlah bagi suku Simeon, untuk suku bani Simeon menurut kaum-kaum mereka. Milik pusaka mereka ada di tengah-tengah milik pusaka bani Yehuda."
 },
 {
   "id": 6325,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 2,
   "firman": "Sebagai milik warisan mereka menerima: Bersyeba, Syeba, Molada,"
 },
 {
   "id": 6326,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 3,
   "firman": "Hazar-Sual, Bala, Ezem,"
 },
 {
   "id": 6327,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 4,
   "firman": "Eltolad, Betul, Horma,"
 },
 {
   "id": 6328,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ziklag, Bet-Hamarkabot, Hazar-Susa,"
 },
 {
   "id": 6329,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 6,
   "firman": "Bet-Lebaot dan Saruhen: tiga belas kota dengan desa-desanya."
 },
 {
   "id": 6330,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 7,
   "firman": "En-Rimon, Eter, dan Asan: empat kota dengan desa-desanya;"
 },
 {
   "id": 6331,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 8,
   "firman": "juga segala desa di sekeliling kota-kota tadi, sampai ke Baalat-Beer, yakni Rama yang di Tanah Selatan. Itulah milik pusaka suku bani Simeon menurut kaum-kaum mereka."
 },
 {
   "id": 6332,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 9,
   "firman": "Milik pusaka bani Simeon diambil dari bagian bani Yehuda. Karena bagian bani Yehuda itu terlalu besar bagi mereka, maka bani Simeon menerima milik pusaka di tengah-tengah mereka."
 },
 {
   "id": 6333,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 10,
   "firman": "Undian yang ketigapun keluarlah bagi bani Zebulon menurut kaum-kaum mereka. Batas milik pusaka mereka sampai ke Sarid."
 },
 {
   "id": 6334,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 11,
   "firman": "Ke sebelah barat batas mereka itu naik ke Marala, menyinggung Dabeset, kemudian menyinggung sungai yang mengalir lewat Yokneam."
 },
 {
   "id": 6335,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 12,
   "firman": "Dari Sarid batas itu berbalik ke timur, ke arah matahari terbit, melalui daerah Kislot-Tabor, menuju Dobrat, naik ke Yafia;"
 },
 {
   "id": 6336,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 13,
   "firman": "dari sana terus ke timur, ke arah matahari terbit, ke Gat-Hefer, ke Et-Kazin, menuju ke Rimon, dan melengkung ke Nea."
 },
 {
   "id": 6337,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 14,
   "firman": "Kemudian batas itu membelok mengelilinginya di sebelah utara Hanaton, dan berakhir di lembah Yiftah-El."
 },
 {
   "id": 6338,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 15,
   "firman": "Lagi Katat, Nahalal, Simron, Yidala dan Betlehem; dua belas kota dengan desa-desanya."
 },
 {
   "id": 6339,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 16,
   "firman": "Itulah milik pusaka bani Zebulon menurut kaum-kaum mereka; kota-kota tadi dengan desa-desanya."
 },
 {
   "id": 6340,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 17,
   "firman": "Bagi suku Isakhar keluarlah undian yang keempat, yakni bagi bani Isakhar menurut kaum-kaum mereka."
 },
 {
   "id": 6341,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 18,
   "firman": "Daerah mereka ialah Yizreel, Kesulot, Sunem,"
 },
 {
   "id": 6342,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 19,
   "firman": "Hafaraim, Sion, Anaharat,"
 },
 {
   "id": 6343,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 20,
   "firman": "Rabit, Kisyon, Ebes,"
 },
 {
   "id": 6344,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 21,
   "firman": "Remet, En-Ganim, En-Hada dan Bet-Pazes."
 },
 {
   "id": 6345,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 22,
   "firman": "Batas daerah itu menyinggung Tabor, Sahazima dan Bet-Semes; dan batas daerah mereka berakhir di sungai Yordan; enam belas kota dengan desa-desanya."
 },
 {
   "id": 6346,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 23,
   "firman": "Itulah milik pusaka suku bani Isakhar menurut kaum-kaum mereka, kota-kota itu dengan desa-desanya."
 },
 {
   "id": 6347,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 24,
   "firman": "Undian yang kelimapun keluarlah bagi suku bani Asyer menurut kaum-kaum mereka."
 },
 {
   "id": 6348,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 25,
   "firman": "Daerah mereka ialah Helkat, Hali, Beten, Akhsaf,"
 },
 {
   "id": 6349,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 26,
   "firman": "Alamelekh, Amad dan Misal; dan batasnya menyinggung gunung Karmel dan sungai Libnat di sebelah barat;"
 },
 {
   "id": 6350,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 27,
   "firman": "kemudian berbalik ke arah matahari terbit, ke Bet-Dagon; menyinggung daerah Zebulon dan lembah Yiftah-El di sebelah utara, Bet-Emek dan Nehiel, dan menuju ke Kabul di sebelah utara,"
 },
 {
   "id": 6351,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 28,
   "firman": "dan ke Ebron, Rehob, Hamon dan Kana sampai ke Sidon Besar."
 },
 {
   "id": 6352,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 29,
   "firman": "Kemudian batas itu berbalik ke Rama dan sampai ke kota yang berkubu Tirus, kemudian batas itu berbalik ke Hosa dan berakhir di laut. Lagipula Mahalab, Akhzib,"
 },
 {
   "id": 6353,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 30,
   "firman": "Uma, Afek dan Rehob; dua puluh dua kota dengan desa-desanya."
 },
 {
   "id": 6354,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 31,
   "firman": "Itulah milik pusaka suku bani Asyer menurut kaum-kaum mereka; kota-kota tadi dengan desa-desanya."
 },
 {
   "id": 6355,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 32,
   "firman": "Bagi bani Naftali keluarlah undian yang keenam, yakni bagi bani Naftali menurut kaum-kaum mereka."
 },
 {
   "id": 6356,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 33,
   "firman": "Daerah mereka mulai dari Helef, dari pohon tarbantin di Zaananim, Adami-Nekeb dan Yabneel, sampai ke Lakum, dan berakhir di sungai Yordan."
 },
 {
   "id": 6357,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 34,
   "firman": "Kemudian batas itu berbalik ke barat ke Aznot-Tabor, dari sana menuju ke Hukok, menyinggung daerah Zebulon di sebelah selatan, menyinggung daerah Asyer di sebelah barat dan daerah Yehuda pada sungai Yordan, di sebelah matahari terbit."
 },
 {
   "id": 6358,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 35,
   "firman": "Kota-kota yang berkubu ialah Zidim, Zer, Hamat, Rakat, Kineret,"
 },
 {
   "id": 6359,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 36,
   "firman": "Adama, Rama, Hazor,"
 },
 {
   "id": 6360,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 37,
   "firman": "Kedesh, Edrei, En-Hazor,"
 },
 {
   "id": 6361,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 38,
   "firman": "Yiron, Migdal-El, Horem, Bet-Anat dan Bet-Semes; sembilan belas kota dengan desa-desanya."
 },
 {
   "id": 6362,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 39,
   "firman": "Itulah milik pusaka suku bani Naftali menurut kaum-kaum mereka; kota-kota itu dengan desa-desanya."
 },
 {
   "id": 6363,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 40,
   "firman": "Bagi suku bani Dan menurut kaum-kaum mereka keluarlah undian yang ketujuh."
 },
 {
   "id": 6364,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 41,
   "firman": "Daerah milik pusaka mereka ialah Zora, Esytaol, Ir-Semes,"
 },
 {
   "id": 6365,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 42,
   "firman": "Saalabin, Ayalon, Yitla,"
 },
 {
   "id": 6366,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 43,
   "firman": "Elon, Timna, Ekron,"
 },
 {
   "id": 6367,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 44,
   "firman": "Elteke, Gibeton, Baalat,"
 },
 {
   "id": 6368,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 45,
   "firman": "Yehud, Bene-Berak, Gat-Rimon,"
 },
 {
   "id": 6369,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 46,
   "firman": "Me-Yarkon dan Rakon, bersama-sama dengan daerah di seberang Yafo."
 },
 {
   "id": 6370,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 47,
   "firman": "Karena daerah bani Dan telah menjadi terlalu sempit untuk mereka, maka berjalanlah bani Dan itu maju dan berperang melawan kota Lesem. Mereka merebutnya, memarang penduduknya dengan mata pedang dan mendudukinya. Lalu menetaplah mereka di sana dan menamai Lesem itu Dan menurut nama Dan, bapa leluhur mereka."
 },
 {
   "id": 6371,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 48,
   "firman": "Itulah milik pusaka suku bani Dan menurut kaum-kaum mereka; kota-kota tadi dengan desa-desanya."
 },
 {
   "id": 6372,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 49,
   "firman": "Setelah orang Israel selesai membagikan negeri itu menjadi milik pusaka mereka menurut daerah-daerahnya, maka kepada Yosua bin Nun diberikanlah milik pusaka di tengah-tengah mereka."
 },
 {
   "id": 6373,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 50,
   "firman": "Sesuai dengan titah TUHAN, mereka memberikan kepadanya kota yang dimintanya, yakni Timnat-Serah di pegunungan Efraim. Kota itu dibangunnya dan menetaplah ia di sana."
 },
 {
   "id": 6374,
   "kitab": "Yos",
   "pasal": 19,
   "ayat": 51,
   "firman": "Itulah milik pusaka yang diperundikan di antara suku-suku orang Israel di Silo oleh imam Eleazar, oleh Yosua bin Nun dan oleh para kepala kaum keluarga di hadapan TUHAN di depan pintu Kemah Pertemuan. Demikianlah diselesaikan mereka pembagian negeri itu."
 },
 {
   "id": 6375,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Yosua, demikian:"
 },
 {
   "id": 6376,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel, begini: Tentukanlah bagimu kota-kota perlindungan, yang telah Kusebutkan kepadamu dengan perantaraan Musa,"
 },
 {
   "id": 6377,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 3,
   "firman": "supaya siapa yang membunuh seseorang dengan tidak sengaja, dengan tidak ada niat lebih dahulu, dapat melarikan diri ke sana, sehingga kota-kota itu menjadi tempat perlindungan bagimu terhadap penuntut tebusan darah."
 },
 {
   "id": 6378,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 4,
   "firman": "Apabila ia melarikan diri ke salah satu kota tadi, maka haruslah ia tinggal berdiri di depan pintu gerbang kota dan memberitahukan perkaranya kepada para tua-tua kota. Mereka harus menerima dia dalam kota itu dan memberikan tempat kepadanya, dan ia akan diam pada mereka."
 },
 {
   "id": 6379,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 5,
   "firman": "Apabila penuntut tebusan darah itu mengejar dia, pembunuh itu tidak akan diserahkan mereka ke dalam tangannya, sebab ia telah membunuh sesamanya manusia dengan tidak ada niat lebih dahulu, dan dengan tidak menaruh benci kepadanya lebih dahulu."
 },
 {
   "id": 6380,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 6,
   "firman": "Ia harus tetap diam di kota itu sampai ia dihadapkan kepada rapat jemaah untuk diadili, sampai imam besar yang ada pada waktu itu mati. Maka barulah pembunuh itu boleh pulang ke kotanya dan ke rumahnya, ke kota dari mana ia melarikan diri.\""
 },
 {
   "id": 6381,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 7,
   "firman": "Lalu orang Israel mengkhususkan sebagai kota perlindungan: Kedesh di Galilea, di pegunungan Naftali dan Sikhem, di pegunungan Efraim, dan Kiryat-Arba, itulah Hebron, di pegunungan Yehuda."
 },
 {
   "id": 6382,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 8,
   "firman": "Dan di seberang sungai Yordan, di sebelah timur Yerikho, mereka menentukan Bezer, di padang gurun, di dataran tinggi, dari suku Ruben; dan Ramot di Gilead dari suku Gad, dan Golan di Basan dari suku Manasye."
 },
 {
   "id": 6383,
   "kitab": "Yos",
   "pasal": 20,
   "ayat": 9,
   "firman": "Itulah kota-kota yang ditetapkan bagi semua orang Israel dan bagi pendatang-pendatang yang ada di tengah-tengah mereka, supaya setiap orang yang membunuh seseorang dengan tidak sengaja dapat melarikan diri ke sana dan jangan mati dibunuh oleh tangan penuntut tebusan darah, sebelum ia dihadapkan kepada rapat jemaah."
 },
 {
   "id": 6384,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 1,
   "firman": "Kemudian datanglah para kepala kaum keluarga orang Lewi menghadap imam Eleazar, menghadap Yosua bin Nun, dan menghadap para kepala kaum keluarga di antara suku-suku orang Israel"
 },
 {
   "id": 6385,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 2,
   "firman": "dan berkata kepada mereka di Silo di tanah Kanaan, demikian: \"TUHAN telah memerintahkan dengan perantaraan Musa, supaya diberikan kepada kami kota-kota untuk didiami dan tanah-tanah penggembalaannya untuk ternak kami.\""
 },
 {
   "id": 6386,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 3,
   "firman": "Lalu orang Israel memberikan dari milik pusaka mereka kota-kota yang berikut dengan tanah-tanah penggembalaannya kepada orang Lewi, seperti yang dititahkan TUHAN."
 },
 {
   "id": 6387,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 4,
   "firman": "Lalu keluarlah undian bagi kaum-kaum orang Kehat. Maka di antara orang Lewi anak-anak imam Harun, mendapat dengan undian tiga belas kota dari suku Yehuda, dari suku Simeon dan dari suku Benyamin."
 },
 {
   "id": 6388,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 5,
   "firman": "Kaum-kaum yang lain di antara keturunan Kehat mendapat dengan undian sepuluh kota dari kaum-kaum suku Efraim, dari suku Dan dan dari suku Manasye yang setengah itu."
 },
 {
   "id": 6389,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 6,
   "firman": "Keturunan Gerson mendapat dengan undian tiga belas kota dari kaum-kaum suku Isakhar, dari suku Asyer, dari suku Naftali dan dari setengah suku Manasye yang di Basan itu."
 },
 {
   "id": 6390,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 7,
   "firman": "Keturunan Merari mendapat dengan undian dua belas kota menurut kaum-kaum mereka, dari suku Ruben, dari suku Gad dan dari suku Zebulon."
 },
 {
   "id": 6391,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 8,
   "firman": "Demikianlah diberikan orang Israel kota-kota tadi dengan tanah-tanah penggembalaannya kepada orang Lewi dengan undian seperti yang diperintahkan TUHAN dengan perantaraan Musa."
 },
 {
   "id": 6392,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 9,
   "firman": "Dari suku bani Yehuda dan dari suku bani Simeon diberikan mereka kota-kota yang berikut, yang disebutkan namanya di sini:"
 },
 {
   "id": 6393,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 10,
   "firman": "kepada anak-anak Harun yang dari kaum-kaum orang Kehat yang termasuk bani Lewi, karena bagi merekalah undian yang pertama,"
 },
 {
   "id": 6394,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 11,
   "firman": "kepada mereka diberikan Kiryat-Arba, itulah Hebron--Arba inilah bapa suku Enak--di pegunungan Yehuda, dan tanah-tanah penggembalaan di sekelilingnya;"
 },
 {
   "id": 6395,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 12,
   "firman": "tetapi tanah ladang kota tadi dengan desa-desanya telah diberikan mereka kepada Kaleb bin Yefune menjadi miliknya."
 },
 {
   "id": 6396,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 13,
   "firman": "Kepada anak-anak imam Harun, diberikan mereka Hebron, kota perlindungan untuk pembunuh, dan tanah-tanah penggembalaan kota itu, Libna dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6397,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 14,
   "firman": "Yatir dengan tanah-tanah penggembalaannya, Estemoa dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6398,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 15,
   "firman": "Holon dengan tanah-tanah penggembalaannya, Debir dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6399,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 16,
   "firman": "Ain dengan tanah-tanah penggembalaannya, Yuta dengan tanah-tanah penggembalaannya dan Bet-Semes dengan tanah-tanah penggembalaannya: sembilan kota dari kedua suku itu."
 },
 {
   "id": 6400,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 17,
   "firman": "Dan dari suku Benyamin: Gibeon dengan tanah-tanah penggembalaannya, Geba dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6401,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 18,
   "firman": "Anatot dengan tanah-tanah penggembalaannya dan Almon dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6402,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 19,
   "firman": "Seluruhnya kota-kota kepunyaan anak-anak Harun, para imam itu, ada tiga belas kota dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 6403,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 20,
   "firman": "Kaum-kaum keturunan Kehat, yakni orang Lewi yang masih tinggal dari antara keturunan Kehat, mendapat kota-kota yang dengan undian kepada mereka dari suku Efraim."
 },
 {
   "id": 6404,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 21,
   "firman": "Kepada mereka diberikan Sikhem, kota perlindungan untuk pembunuh, dengan tanah-tanah penggembalaannya, di pegunungan Efraim, Gezer dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6405,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 22,
   "firman": "Kibzaim dengan tanah-tanah penggembalaannya dan Bet-Horon dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6406,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 23,
   "firman": "Dan dari suku Dan: Elteke dengan tanah-tanah penggembalaannya, Gibeton dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6407,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 24,
   "firman": "Ayalon dengan tanah-tanah penggembalaannya dan Gat-Rimon dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6408,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 25,
   "firman": "Dan dari suku Manasye yang setengah itu: Taanakh dengan tanah-tanah penggembalaannya dan Gat-Rimon dengan tanah-tanah penggembalaannya: dua kota."
 },
 {
   "id": 6409,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 26,
   "firman": "Seluruhnya kota-kota itu ada sepuluh, dengan tanah-tanah penggembalaannya, ditentukan bagi kaum-kaum yang masih tinggal dari antara keturunan Kehat."
 },
 {
   "id": 6410,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 27,
   "firman": "Bani Gerson dari kaum-kaum orang Lewi mendapat dari suku Manasye yang setengah lagi: Golan, kota perlindungan untuk pembunuh, di Basan, dengan tanah-tanah penggembalaannya, dan Beestera dengan tanah-tanah penggembalaannya: dua kota."
 },
 {
   "id": 6411,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 28,
   "firman": "Dan dari suku Isakhar: Kisyon dengan tanah-tanah penggembalaannya, Dobrat dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6412,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 29,
   "firman": "Yarmut dengan tanah-tanah penggembalaannya, dan En-Ganim dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6413,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 30,
   "firman": "Dan dari suku Asyer: Misal dengan tanah-tanah penggembalaannya, Abdon dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6414,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 31,
   "firman": "Helkat dengan tanah-tanah penggembalaannya dan Rehob dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6415,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 32,
   "firman": "Dan dari suku Naftali: Kedesh, kota perlindungan untuk pembunuh, di Galilea, dengan tanah-tanah penggembalaannya, Hamot-Dor dengan tanah-tanah penggembalaannya dan Kartan dengan tanah-tanah penggembalaannya: tiga kota."
 },
 {
   "id": 6416,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 33,
   "firman": "Seluruhnya kota-kota kepunyaan orang Gerson menurut kaum-kaum mereka ada tiga belas kota dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 6417,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 34,
   "firman": "Kaum-kaum keturunan Merari, orang Lewi yang masih tinggal, mendapat dari suku Zebulon: Yokneam dengan tanah-tanah penggembalaannya, Karta dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6418,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 35,
   "firman": "Dimna dengan tanah-tanah penggembalaannya dan Nahalal dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6419,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 36,
   "firman": "Dan dari suku Ruben: Bezer dengan tanah-tanah penggembalaannya, Yahas dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6420,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 37,
   "firman": "Kedemot dengan tanah-tanah penggembalaannya dan Mefaat dengan tanah-tanah penggembalaannya: empat kota."
 },
 {
   "id": 6421,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 38,
   "firman": "Dan dari suku Gad: Ramot, kota perlindungan untuk pembunuh, di Gilead, dengan tanah-tanah penggembalaannya, Mahanaim dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 6422,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 39,
   "firman": "Hesybon dengan tanah-tanah penggembalaannya dan Yaezer dengan tanah-tanah penggembalaannya: seluruhnya kota-kota itu ada empat."
 },
 {
   "id": 6423,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 40,
   "firman": "Seluruhnya kota-kota itu ditentukan bagi keturunan Merari menurut kaum-kaum mereka, yakni yang masih tinggal dari kaum-kaum orang Lewi. Bagian undian mereka ada dua belas kota."
 },
 {
   "id": 6424,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 41,
   "firman": "Seluruhnya kota-kota orang Lewi di tengah-tengah milik orang Israel ada empat puluh delapan kota dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 6425,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 42,
   "firman": "Kota-kota itu masing-masing ada tanah-tanah penggembalaannya di sekelilingnya, demikianlah kota-kota tadi seluruhnya."
 },
 {
   "id": 6426,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 43,
   "firman": "Jadi seluruh negeri itu diberikan TUHAN kepada orang Israel, yakni negeri yang dijanjikan-Nya dengan bersumpah untuk diberikan kepada nenek moyang mereka. Mereka menduduki negeri itu dan menetap di sana."
 },
 {
   "id": 6427,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 44,
   "firman": "Dan TUHAN mengaruniakan kepada mereka keamanan ke segala penjuru, tepat seperti yang dijanjikan-Nya dengan bersumpah kepada nenek moyang mereka. Tidak ada seorangpun dari semua musuhnya yang tahan berdiri menghadapi mereka; semua musuhnya diserahkan TUHAN kepada mereka."
 },
 {
   "id": 6428,
   "kitab": "Yos",
   "pasal": 21,
   "ayat": 45,
   "firman": "Dari segala yang baik yang dijanjikan TUHAN kepada kaum Israel, tidak ada yang tidak dipenuhi; semuanya terpenuhi."
 },
 {
   "id": 6429,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu Yosua memanggil orang Ruben, orang Gad dan suku Manasye yang setengah itu,"
 },
 {
   "id": 6430,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 2,
   "firman": "dan berkata kepada mereka: \"Kamu telah memelihara segala yang diperintahkan kepadamu oleh Musa, hamba TUHAN itu, dan telah mendengarkan perkataanku dalam segala yang kuperintahkan kepadamu."
 },
 {
   "id": 6431,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 3,
   "firman": "Kamu tidak meninggalkan saudara-saudaramu selama waktu ini, sampai sekarang, tetapi kamu setia memelihara perintah TUHAN, Allahmu, kepadamu."
 },
 {
   "id": 6432,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 4,
   "firman": "Tetapi sekarang TUHAN, Allahmu, telah mengaruniakan keamanan kepada saudara-saudaramu, seperti yang dijanjikan-Nya kepada mereka. Oleh sebab itu, pulanglah ke kemahmu, ke tanah milikmu, yang telah diberikan kepadamu oleh Musa, hamba TUHAN itu, di seberang Yordan."
 },
 {
   "id": 6433,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 5,
   "firman": "Hanya, lakukanlah dengan sangat setia perintah dan hukum, yang diperintahkan kepadamu oleh Musa, hamba TUHAN itu, yakni mengasihi TUHAN, Allahmu, hidup menurut segala jalan yang ditunjukkan-Nya, tetap mengikuti perintah-Nya, berpaut pada-Nya dan berbakti kepada-Nya dengan segenap hatimu dan dengan segenap jiwamu.\""
 },
 {
   "id": 6434,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 6,
   "firman": "Lalu Yosua memberkati mereka dan melepas mereka pergi. Maka pulanglah mereka ke kemah mereka."
 },
 {
   "id": 6435,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 7,
   "firman": "Kepada suku Manasye yang setengah telah diberikan Musa bagian mereka di Basan; kepada suku yang setengah lagi telah diberikan Yosua bagian mereka di antara saudara-saudara mereka di sebelah barat sungai Yordan. Lagipun ketika Yosua melepas mereka pergi ke kemah mereka, setelah memberkati mereka,"
 },
 {
   "id": 6436,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 8,
   "firman": "maka ia berkata kepada mereka, demikian: \"Pulanglah ke kemahmu dengan kekayaan yang banyak dan dengan sangat banyak ternak, dengan perak, emas, tembaga, besi dan dengan pakaian yang sangat banyak. Bagilah dengan saudara-saudaramu jarahan yang dari musuhmu itu.\""
 },
 {
   "id": 6437,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 9,
   "firman": "Maka pulanglah bani Ruben, bani Gad dan suku Manasye yang setengah itu dan mereka pergi meninggalkan orang Israel, keluar dari Silo di tanah Kanaan untuk pergi ke tanah Gilead, tanah milik mereka yang didiami mereka sesuai dengan titah TUHAN dengan perantaraan Musa."
 },
 {
   "id": 6438,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 10,
   "firman": "Ketika mereka sampai ke Gelilot pada sungai Yordan, yang di tanah Kanaan, maka bani Ruben, bani Gad dan suku Manasye yang setengah itu mendirikan mezbah di sana di tepi sungai Yordan, mezbah yang besar bangunannya."
 },
 {
   "id": 6439,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 11,
   "firman": "Lalu terdengarlah oleh orang Israel itu cakap orang: \"Telah didirikan mezbah oleh bani Ruben, bani Gad dan suku Manasye yang setengah itu, mezbah menghadap ke tanah Kanaan, di Gelilot pada sungai Yordan, di sebelah wilayah orang Israel.\""
 },
 {
   "id": 6440,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 12,
   "firman": "Ketika hal itu terdengar oleh orang Israel, berkumpullah segenap umat Israel di Silo, untuk maju memerangi mereka."
 },
 {
   "id": 6441,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 13,
   "firman": "Kemudian orang Israel mengutus kepada bani Ruben, kepada bani Gad dan kepada suku Manasye yang setengah itu, ke tanah Gilead, imam Pinehas bin Eleazar,"
 },
 {
   "id": 6442,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 14,
   "firman": "dan bersama-sama dengan dia sepuluh pemimpin, yakni seorang pemimpin kaum keluarga sebagai wakil tiap-tiap suku Israel. Masing-masing mereka itu kepala kaum keluarganya di antara kaum-kaum orang Israel."
 },
 {
   "id": 6443,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 15,
   "firman": "Setelah mereka sampai kepada bani Ruben, kepada bani Gad dan kepada suku Manasye yang setengah itu di tanah Gilead, berkatalah mereka kepada orang-orang itu, demikian:"
 },
 {
   "id": 6444,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 16,
   "firman": "\"Beginilah kata segenap umat TUHAN: Apa macam perbuatanmu yang tidak setia ini terhadap Allah Israel, dengan sekarang berbalik dari pada TUHAN dan mendirikan mezbah bagimu, dengan demikian memberontak terhadap TUHAN pada hari ini?"
 },
 {
   "id": 6445,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 17,
   "firman": "Belum cukupkah bagi kita noda yang di Peor itu, yang dari padanya kita belum mentahirkan diri sampai hari ini dan yang menyebabkan umat TUHAN kena tulah,"
 },
 {
   "id": 6446,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 18,
   "firman": "sehingga kamu berbalik pula sekarang ini membelakangi TUHAN? Jika kamu hari ini memberontak terhadap TUHAN, maka besok Ia akan murka kepada segenap umat Israel."
 },
 {
   "id": 6447,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 19,
   "firman": "Akan tetapi, jika sekiranya tanah milikmu itu najis, marilah menyeberang ke tanah milik TUHAN, tempat kedudukan Kemah Suci TUHAN, dan menetaplah di tengah-tengah kami. Tetapi janganlah memberontak terhadap TUHAN dan janganlah memberontak terhadap kami, dengan mendirikan mezbah bagimu sendiri, selain dari mezbah TUHAN, Allah kita."
 },
 {
   "id": 6448,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 20,
   "firman": "Ketika Akhan bin Zerah berubah setia dengan mengambil barang-barang yang dikhususkan, bukankah segenap umat Israel kena murka? Bukan orang itu saja yang mati karena dosanya.\""
 },
 {
   "id": 6449,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 21,
   "firman": "Lalu jawab bani Ruben, bani Gad dan suku Manasye yang setengah itu, katanya kepada para kepala kaum-kaum orang Israel:"
 },
 {
   "id": 6450,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 22,
   "firman": "\"Allah segala allah, TUHAN, Allah segala allah, TUHAN, Dialah yang mengetahui, dan patutlah orang Israel mengetahuinya juga! Jika sekiranya hal ini terjadi dengan maksud memberontak atau dengan maksud berubah setia terhadap TUHAN--biarlah jangan TUHAN selamatkan kami pada hari ini."
 },
 {
   "id": 6451,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 23,
   "firman": "Jika sekiranya kami mendirikan mezbah untuk berbalik dari pada TUHAN, untuk mempersembahkan korban bakaran dan korban sajian di atasnya serta korban keselamatan di atasnya, biarlah TUHAN sendiri yang menuntut balas terhadap kami."
 },
 {
   "id": 6452,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 24,
   "firman": "Tetapi sesungguhnya, kami telah melakukannya karena cemas. Sebab pikir kami: Di kemudian hari anak-anak kamu mungkin berkata kepada anak-anak kami, demikian: Apakah sangkut pautmu dengan TUHAN, Allah Israel?"
 },
 {
   "id": 6453,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 25,
   "firman": "Bukankah TUHAN telah menentukan sungai Yordan sebagai batas antara kami dan kamu, hai orang bani Ruben dan bani Gad! Kamu tidak mempunyai bagian akan TUHAN. Demikianlah mungkin anak-anak kamu membuat anak-anak kami berhenti dari pada takut akan TUHAN."
 },
 {
   "id": 6454,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 26,
   "firman": "Sebab itu kata kami: Biarlah kita mendirikan mezbah itu bagi kita! Bukanlah untuk korban bakaran dan bukanlah untuk korban sembelihan,"
 },
 {
   "id": 6455,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 27,
   "firman": "tetapi supaya mezbah itu menjadi saksi antara kami dan kamu, dan antara keturunan kita kemudian, bahwa kami tetap beribadah kepada TUHAN di hadapan-Nya dengan korban bakaran, korban sembelihan dan korban keselamatan kami. Jadi tidaklah mungkin anak-anak kamu di kemudian hari berkata kepada anak-anak kami: Kamu tidak mempunyai bagian pada TUHAN."
 },
 {
   "id": 6456,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 28,
   "firman": "Lagi kata kami: Apabila di kemudian hari demikian dikatakan mereka kepada kita dan kepada keturunan kita, maka kita akan berkata: Tengoklah bangunan tiruan mezbah TUHAN itu, yang telah dibuat oleh nenek moyang kami. Bukan untuk korban bakaran dan bukan untuk korban sembelihan, tetapi mezbah itu menjadi saksi antara kami dan kamu."
 },
 {
   "id": 6457,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 29,
   "firman": "Jauhlah dari pada kami untuk memberontak terhadap TUHAN, dan untuk berbalik dari pada TUHAN pada hari ini dengan mendirikan mezbah untuk korban bakaran, korban sajian atau korban sembelihan, mezbah yang bukan mezbah TUHAN, Allah kita, yang ada di depan Kemah Suci-Nya!\""
 },
 {
   "id": 6458,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 30,
   "firman": "Setelah imam Pinehas dan para pemimpin umat serta para kepala kaum-kaum orang Israel yang bersama-sama dengan dia, mendengar perkataan yang dikatakan oleh bani Ruben, bani Gad dan bani Manasye itu, maka mereka menganggap hal itu baik."
 },
 {
   "id": 6459,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 31,
   "firman": "Kemudian berkatalah imam Pinehas bin Eleazar kepada bani Ruben, bani Gad dan bani Manasye: \"Sekarang tahulah kami bahwa TUHAN ada di tengah-tengah kita, sebab tidaklah kamu berubah setia terhadap TUHAN. Dengan demikian kamu telah melepaskan orang Israel dari hukuman TUHAN.\""
 },
 {
   "id": 6460,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 32,
   "firman": "Sesudah itu imam Pinehas bin Eleazar serta para pemimpin itu meninggalkan bani Ruben dan bani Gad di tanah Gilead, pulang ke Kanaan kepada orang Israel, lalu disampaikanlah berita itu kepada mereka."
 },
 {
   "id": 6461,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 33,
   "firman": "Hal itu dipandang baik oleh orang Israel, sehingga orang Israel memuji Allah dan tidak lagi berkata hendak maju memerangi mereka untuk memusnahkan negeri yang didiami bani Ruben dan bani Gad itu."
 },
 {
   "id": 6462,
   "kitab": "Yos",
   "pasal": 22,
   "ayat": 34,
   "firman": "Dan bani Ruben dan bani Gad menamai mezbah itu: Saksi, karena inilah saksi antara kita, bahwa TUHAN itulah Allah."
 },
 {
   "id": 6463,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 1,
   "firman": "Lama setelah TUHAN mengaruniakan keamanan kepada orang Israel ke segala penjuru terhadap semua musuhnya, dan ketika Yosua telah tua dan lanjut umur,"
 },
 {
   "id": 6464,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 2,
   "firman": "dipanggilnya seluruh orang Israel, para tua-tuanya, para kepalanya, para hakimnya dan para pengatur pasukannya dan berkata kepada mereka: \"Aku telah tua dan sangat lanjut umur,"
 },
 {
   "id": 6465,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 3,
   "firman": "dan kamu ini telah melihat segala yang dilakukan TUHAN, Allahmu, kepada semua bangsa di sini demi kamu, sebab TUHAN, Allahmu, Dialah yang telah berperang bagi kamu."
 },
 {
   "id": 6466,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 4,
   "firman": "Ingatlah, aku telah membagikan dengan membuang undi bangsa-bangsa yang masih tinggal ini kepada suku-sukumu menjadi milik pusakamu, seperti juga semua bangsa yang telah kulenyapkan hari itu, mulai dari sungai Yordan sampai ke Laut Besar di sebelah matahari terbenam."
 },
 {
   "id": 6467,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 5,
   "firman": "Dan TUHAN, Allahmu, Dialah yang akan mengusir dan menghalau mereka dari depanmu, sehingga kamu menduduki negeri mereka, seperti yang dijanjikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 6468,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 6,
   "firman": "Kuatkanlah benar-benar hatimu dalam memelihara dan melakukan segala yang tertulis dalam kitab hukum Musa, supaya kamu jangan menyimpang ke kanan atau ke kiri,"
 },
 {
   "id": 6469,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 7,
   "firman": "dan supaya kamu jangan bergaul dengan bangsa-bangsa yang masih tinggal di antaramu itu, serta mengakui nama allah mereka dan bersumpah demi nama itu, dan beribadah atau sujud menyembah kepada mereka."
 },
 {
   "id": 6470,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 8,
   "firman": "Tetapi kamu harus berpaut pada TUHAN, Allahmu, seperti yang kamu lakukan sampai sekarang."
 },
 {
   "id": 6471,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 9,
   "firman": "Bukankah TUHAN telah menghalau bangsa-bangsa yang besar dan kuat dari depanmu, dan akan kamu ini, seorangpun tidak ada yang tahan menghadapi kamu sampai sekarang."
 },
 {
   "id": 6472,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 10,
   "firman": "Satu orang saja dari pada kamu dapat mengejar seribu orang, sebab TUHAN Allahmu, Dialah yang berperang bagi kamu, seperti yang dijanjikan-Nya kepadamu."
 },
 {
   "id": 6473,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 11,
   "firman": "Maka demi nyawamu, bertekunlah mengasihi TUHAN, Allahmu."
 },
 {
   "id": 6474,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 12,
   "firman": "Sebab jika kamu berbalik dan berpaut kepada sisa bangsa-bangsa ini yang masih tinggal di antara kamu, kawin-mengawin dengan mereka serta bergaul dengan mereka dan mereka dengan kamu,"
 },
 {
   "id": 6475,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 13,
   "firman": "maka ketahuilah dengan sesungguhnya, bahwa TUHAN, Allahmu, tidak akan menghalau lagi bangsa-bangsa itu dari depanmu. Tetapi mereka akan menjadi perangkap dan jerat bagimu, menjadi cambuk pada lambungmu dan duri di matamu, sampai kamu binasa dari tanah yang baik ini, yang telah diberikan kepadamu oleh TUHAN, Allahmu."
 },
 {
   "id": 6476,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 14,
   "firman": "Maka sekarang, sebentar lagi aku akan menempuh jalan segala yang fana. Sebab itu insaflah dengan segenap hatimu dan segenap jiwamu, bahwa satupun dari segala yang baik yang telah dijanjikan kepadamu oleh TUHAN, Allahmu, tidak ada yang tidak dipenuhi. Semuanya telah digenapi bagimu. Tidak ada satupun yang tidak dipenuhi."
 },
 {
   "id": 6477,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 15,
   "firman": "Tetapi seperti telah datang atas kamu segala yang baik, yang telah dijanjikan kepadamu oleh TUHAN, Allahmu, demikianlah TUHAN akan mendatangkan atas kamu segala yang tidak baik sampai Ia telah memusnahkan kamu dari tanah yang baik ini, yang diberikan kepadamu oleh TUHAN, Allahmu,"
 },
 {
   "id": 6478,
   "kitab": "Yos",
   "pasal": 23,
   "ayat": 16,
   "firman": "apabila kamu melangkahi perjanjian, yang telah diperintahkan kepadamu oleh TUHAN, Allahmu, dan pergi beribadah kepada allah lain dan sujud menyembah kepada mereka. Maka murka TUHAN akan bangkit terhadap kamu, sehingga kamu segera binasa dari negeri yang baik, yang telah diberikan-Nya kepadamu.\""
 },
 {
   "id": 6479,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 1,
   "firman": "Kemudian Yosua mengumpulkan semua suku orang Israel di Sikhem. Dipanggilnya para tua-tua orang Israel, para kepalanya, para hakimnya dan para pengatur pasukannya, lalu mereka berdiri di hadapan Allah."
 },
 {
   "id": 6480,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 2,
   "firman": "Berkatalah Yosua kepada seluruh bangsa itu: \"Beginilah firman TUHAN, Allah Israel: Dahulu kala di seberang sungai Efrat, di situlah diam nenek moyangmu, yakni Terah, ayah Abraham dan ayah Nahor, dan mereka beribadah kepada allah lain."
 },
 {
   "id": 6481,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 3,
   "firman": "Tetapi Aku mengambil Abraham, bapamu itu, dari seberang sungai Efrat, dan menyuruh dia menjelajahi seluruh tanah Kanaan. Aku membuat banyak keturunannya dan memberikan Ishak kepadanya."
 },
 {
   "id": 6482,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 4,
   "firman": "Kepada Ishak Kuberikan Yakub dan Esau. Kepada Esau Kuberikan pegunungan Seir menjadi miliknya, sedang Yakub serta anak-anaknya pergi ke Mesir."
 },
 {
   "id": 6483,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 5,
   "firman": "Lalu Aku mengutus Musa serta Harun dan menulahi Mesir, seperti yang Kulakukan di tengah-tengah mereka, kemudian Aku membawa kamu keluar."
 },
 {
   "id": 6484,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 6,
   "firman": "Setelah Aku membawa nenek moyangmu keluar dari Mesir dan kamu sampai ke laut, lalu orang Mesir mengejar nenek moyangmu dengan kereta dan orang berkuda ke Laut Teberau."
 },
 {
   "id": 6485,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 7,
   "firman": "Sebab itu berteriak-teriaklah mereka kepada TUHAN, maka diadakan-Nya gelap antara kamu dan orang Mesir itu dan didatangkan-Nya air laut atas mereka, sehingga mereka diliputi. Dan matamu sendiri telah melihat, apa yang Kulakukan terhadap Mesir. Sesudah itu lama kamu diam di padang gurun."
 },
 {
   "id": 6486,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 8,
   "firman": "Aku membawa kamu ke negeri orang Amori yang diam di seberang sungai Yordan, dan ketika mereka berperang melawan kamu, mereka Kuserahkan ke dalam tanganmu, sehingga kamu menduduki negerinya, sedang mereka Kupunahkan dari depan kamu."
 },
 {
   "id": 6487,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 9,
   "firman": "Ketika itu Balak bin Zipor, raja Moab, bangkit berperang melawan orang Israel. Disuruhnya memanggil Bileam bin Beor untuk mengutuki kamu."
 },
 {
   "id": 6488,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 10,
   "firman": "Tetapi Aku tidak mau mendengarkan Bileam, sehingga iapun memberkati kamu. Demikianlah Aku melepaskan kamu dari tangannya."
 },
 {
   "id": 6489,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 11,
   "firman": "Setelah kamu menyeberangi sungai Yordan dan sampai ke Yerikho, berperanglah melawan kamu warga-warga kota Yerikho, orang Amori, orang Feris, orang Kanaan, orang Het, orang Girgasi, orang Hewi dan orang Yebus, tetapi mereka itu Kuserahkan ke dalam tanganmu."
 },
 {
   "id": 6490,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 12,
   "firman": "Kemudian Aku melepaskan tabuhan mendahului kamu dan binatang-binatang ini menghalau mereka dari depanmu, seperti kedua raja orang Amori itu. Sesungguhnya, bukan oleh pedangmu dan bukan pula oleh panahmu."
 },
 {
   "id": 6491,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 13,
   "firman": "Demikianlah Kuberikan kepadamu negeri yang kamu peroleh tanpa bersusah-susah dan kota-kota yang tidak kamu dirikan, tetapi kamulah yang diam di dalamnya; juga kebun-kebun anggur dan kebun-kebun zaitun yang tidak kamu tanami, kamulah yang makan hasilnya."
 },
 {
   "id": 6492,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 14,
   "firman": "Oleh sebab itu, takutlah akan TUHAN dan beribadahlah kepada-Nya dengan tulus ikhlas dan setia. Jauhkanlah allah yang kepadanya nenek moyangmu telah beribadah di seberang sungai Efrat dan di Mesir, dan beribadahlah kepada TUHAN."
 },
 {
   "id": 6493,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 15,
   "firman": "Tetapi jika kamu anggap tidak baik untuk beribadah kepada TUHAN, pilihlah pada hari ini kepada siapa kamu akan beribadah; allah yang kepadanya nenek moyangmu beribadah di seberang sungai Efrat, atau allah orang Amori yang negerinya kamu diami ini. Tetapi aku dan seisi rumahku, kami akan beribadah kepada TUHAN!\""
 },
 {
   "id": 6494,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 16,
   "firman": "Lalu bangsa itu menjawab: \"Jauhlah dari pada kami meninggalkan TUHAN untuk beribadah kepada allah lain!"
 },
 {
   "id": 6495,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 17,
   "firman": "Sebab TUHAN, Allah kita, Dialah yang telah menuntun kita dan nenek moyang kita dari tanah Mesir, dari rumah perbudakan, dan yang telah melakukan tanda-tanda mujizat yang besar ini di depan mata kita sendiri, dan yang telah melindungi kita sepanjang jalan yang kita tempuh, dan di antara semua bangsa yang kita lalui,"
 },
 {
   "id": 6496,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 18,
   "firman": "TUHAN menghalau semua bangsa dan orang Amori, penduduk negeri ini, dari depan kita. Kamipun akan beribadah kepada TUHAN, sebab Dialah Allah kita.\""
 },
 {
   "id": 6497,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 19,
   "firman": "Tetapi Yosua berkata kepada bangsa itu: \"Tidaklah kamu sanggup beribadah kepada TUHAN, sebab Dialah Allah yang kudus, Dialah Allah yang cemburu. Ia tidak akan mengampuni kesalahan dan dosamu."
 },
 {
   "id": 6498,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 20,
   "firman": "Apabila kamu meninggalkan TUHAN dan beribadah kepada allah asing, maka Ia akan berbalik dari padamu dan melakukan yang tidak baik kepada kamu serta membinasakan kamu, setelah Ia melakukan yang baik kepada kamu dahulu.\""
 },
 {
   "id": 6499,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 21,
   "firman": "Tetapi bangsa itu berkata kepada Yosua: \"Tidak, hanya kepada TUHAN saja kami akan beribadah.\""
 },
 {
   "id": 6500,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 22,
   "firman": "Kemudian berkatalah Yosua kepada bangsa itu: \"Kamulah saksi terhadap kamu sendiri, bahwa kamu telah memilih TUHAN untuk beribadah kepada-Nya.\" Jawab mereka: \"Kamilah saksi!\""
 },
 {
   "id": 6501,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 23,
   "firman": "Ia berkata: \"Maka sekarang, jauhkanlah allah asing yang ada di tengah-tengah kamu dan condongkanlah hatimu kepada TUHAN, Allah Israel.\""
 },
 {
   "id": 6502,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 24,
   "firman": "Lalu jawab bangsa itu kepada Yosua: \"Kepada TUHAN, Allah kita, kami akan beribadah, dan firman-Nya akan kami dengarkan.\""
 },
 {
   "id": 6503,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 25,
   "firman": "Pada hari itu juga Yosua mengikat perjanjian dengan bangsa itu dan membuat ketetapan dan peraturan bagi mereka di Sikhem."
 },
 {
   "id": 6504,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 26,
   "firman": "Yosua menuliskan semuanya itu dalam kitab hukum Allah, lalu ia mengambil batu yang besar dan mendirikannya di sana, di bawah pohon besar, di tempat kudus TUHAN."
 },
 {
   "id": 6505,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 27,
   "firman": "Kata Yosua kepada seluruh bangsa itu: \"Sesungguhnya batu inilah akan menjadi saksi terhadap kita, sebab telah didengarnya segala firman TUHAN yang diucapkan-Nya kepada kita. Sebab itu batu ini akan menjadi saksi terhadap kamu, supaya kamu jangan menyangkal Allahmu.\""
 },
 {
   "id": 6506,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 28,
   "firman": "Sesudah itu Yosua melepas bangsa itu pergi, masing-masing ke milik pusakanya."
 },
 {
   "id": 6507,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 29,
   "firman": "Dan sesudah peristiwa-peristiwa ini, maka matilah Yosua bin Nun, hamba TUHAN itu, ketika berumur seratus sepuluh tahun."
 },
 {
   "id": 6508,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 30,
   "firman": "Lalu ia dikuburkan di daerah milik pusakanya, di Timnat-Serah yang di pegunungan Efraim, di sebelah utara gunung Gaas."
 },
 {
   "id": 6509,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 31,
   "firman": "Orang Israel beribadah kepada TUHAN sepanjang zaman Yosua dan sepanjang zaman para tua-tua yang hidup lebih lama dari pada Yosua, dan yang mengenal segenap perbuatan yang dilakukan TUHAN bagi orang Israel."
 },
 {
   "id": 6510,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 32,
   "firman": "Tulang-tulang Yusuf, yang dibawa orang Israel dari Mesir, dikuburkan mereka di Sikhem, di tanah milik yang dibeli Yakub dengan harga seratus kesita dari anak-anak Hemor, bapa Sikhem, dan yang ditentukan bagi bani Yusuf menjadi milik pusaka mereka."
 },
 {
   "id": 6511,
   "kitab": "Yos",
   "pasal": 24,
   "ayat": 33,
   "firman": "Juga Eleazar bin Harun mati, dan dia dikuburkan di bukit yang diberikan kepada Pinehas, anaknya itu, di pegunungan Efraim."
 },
 {
   "id": 6512,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 1,
   "firman": "Sesudah Yosua mati, orang Israel bertanya kepada TUHAN: \"Siapakah dari pada kami yang harus lebih dahulu maju menghadapi orang Kanaan untuk berperang melawan mereka?\""
 },
 {
   "id": 6513,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 2,
   "firman": "Firman TUHAN: \"Suku Yehudalah yang harus maju; sesungguhnya telah Kuserahkan negeri itu ke dalam tangannya.\""
 },
 {
   "id": 6514,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 3,
   "firman": "Lalu berkatalah Yehuda kepada Simeon, saudaranya itu: \"Majulah bersama-sama dengan aku ke bagian yang telah diundikan kepadaku dan baiklah kita berperang melawan orang Kanaan, maka akupun akan maju bersama-sama dengan engkau ke bagian yang telah diundikan kepadamu.\" Lalu Simeon maju bersama-sama dengan dia."
 },
 {
   "id": 6515,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 4,
   "firman": "Maka majulah suku Yehuda, lalu TUHAN menyerahkan orang Kanaan dan orang Feris ke dalam tangan mereka, dan mereka memukul kalah orang-orang itu dekat Bezek, sepuluh ribu orang banyaknya."
 },
 {
   "id": 6516,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 5,
   "firman": "Di Bezek mereka menjumpai Adoni-Bezek dan berperang melawan dia, dan mereka memukul kalah orang Kanaan dan orang Feris."
 },
 {
   "id": 6517,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 6,
   "firman": "Tetapi Adoni-Bezek melarikan diri, lalu mereka mengejarnya, menangkapnya dan memotong ibu jari dari tangannya dan dari kakinya."
 },
 {
   "id": 6518,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 7,
   "firman": "Kata Adoni-Bezek: \"Ada tujuh puluh raja dengan terpotong ibu jari tangan dan kakinya memungut sisa-sisa makanan di bawah mejaku; sesuai dengan yang kulakukan itu, demikianlah dibalaskan Allah kepadaku.\" Kemudian ia dibawa ke Yerusalem dan mati di sana."
 },
 {
   "id": 6519,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sesudah itu bani Yehuda berperang melawan Yerusalem, merebutnya lalu memukulnya dengan mata pedang dan memusnahkan kota itu dengan api."
 },
 {
   "id": 6520,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 9,
   "firman": "Kemudian bani Yehuda maju berperang melawan orang Kanaan, yang diam di pegunungan, di Tanah Negeb dan di Daerah Bukit."
 },
 {
   "id": 6521,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 10,
   "firman": "Lalu suku Yehuda bergerak menyerang orang Kanaan yang diam di Hebron--nama Hebron dahulu adalah Kiryat-Arba--dan memukul kalah Sesai, Ahiman dan Talmai."
 },
 {
   "id": 6522,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 11,
   "firman": "Dari sana mereka bergerak menyerang penduduk Debir. Nama Debir dahulu adalah Kiryat-Sefer."
 },
 {
   "id": 6523,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 12,
   "firman": "Berkatalah Kaleb: \"Siapa yang mengalahkan dan merebut Kiryat-Sefer, kepadanya akan kuberikan Akhsa, anakku, menjadi isterinya.\""
 },
 {
   "id": 6524,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 13,
   "firman": "Dan Otniel, anak Kenas adik Kaleb, merebut kota itu; lalu Kaleb memberikan Akhsa, anaknya, kepadanya menjadi isterinya."
 },
 {
   "id": 6525,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 14,
   "firman": "Ketika perempuan itu tiba, dibujuknya suaminya untuk meminta sebidang ladang kepada ayahnya. Maka turunlah perempuan itu dari keledainya, lalu berkatalah Kaleb kepadanya: \"Ada apa?\""
 },
 {
   "id": 6526,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 15,
   "firman": "Jawabnya kepadanya: \"Berikanlah kepadaku suatu hadiah; telah kauberikan kepadaku tanah yang gersang, berikanlah juga kepadaku mata air.\" Lalu Kaleb memberikan kepadanya mata air yang di hulu dan mata air yang di hilir."
 },
 {
   "id": 6527,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 16,
   "firman": "Keturunan Hobab, ipar Musa, orang Keni itu, maju bersama-sama dengan bani Yehuda dari kota pohon korma ke padang gurun Yehuda di Tanah Negeb dekat Arad; lalu mereka menetap di antara penduduk di sana."
 },
 {
   "id": 6528,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 17,
   "firman": "Yehuda maju bersama-sama dengan Simeon, saudaranya itu, lalu mereka memukul kalah orang Kanaan, penduduk Zefat; mereka menumpas kota itu. Sebab itu kota itu dinamai Horma."
 },
 {
   "id": 6529,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 18,
   "firman": "Selanjutnya suku Yehuda merebut Gaza dengan daerahnya, Askelon dengan daerahnya dan Ekron dengan daerahnya."
 },
 {
   "id": 6530,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 19,
   "firman": "Dan TUHAN menyertai suku Yehuda, sehingga mereka menduduki pegunungan itu; tetapi mereka tidak dapat menghalau penduduk yang di lembah, sebab orang-orang ini mempunyai kereta-kereta besi."
 },
 {
   "id": 6531,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 20,
   "firman": "Kepada Kaleb telah diberikan Hebron, seperti yang dikatakan Musa dahulu, dan dari sana telah dihalaukannya anak Enak yang tiga itu."
 },
 {
   "id": 6532,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 21,
   "firman": "Tetapi orang Yebus, penduduk kota Yerusalem, tidak dihalau oleh bani Benyamin, jadi orang Yebus itu masih diam bersama-sama dengan bani Benyamin di Yerusalem sampai sekarang."
 },
 {
   "id": 6533,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 22,
   "firman": "Keturunan Yusuf juga maju menyerang Betel, dan TUHAN menyertai mereka."
 },
 {
   "id": 6534,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 23,
   "firman": "Keturunan Yusuf menyuruh orang mengintai Betel itu--nama kota itu dahulu adalah Lus."
 },
 {
   "id": 6535,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 24,
   "firman": "Ketika pengintai-pengintai itu melihat seorang keluar dari kota itu, maka berkatalah mereka kepadanya: \"Tolong tunjukkan bagaimana kami dapat memasuki kota ini, maka kami akan memperlakukan engkau sebagai sahabat.\""
 },
 {
   "id": 6536,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 25,
   "firman": "Lalu ditunjukkannyalah kepada mereka bagaimana mereka dapat memasuki kota itu, dan mereka memukul kota itu dengan mata pedang, tetapi orang itu dengan seluruh kaumnya dibiarkan mereka pergi."
 },
 {
   "id": 6537,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 26,
   "firman": "Orang itu pergi ke negeri orang Het dan mendirikan di sana sebuah kota yang dinamainya Lus. Demikianlah nama kota itu sampai sekarang."
 },
 {
   "id": 6538,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 27,
   "firman": "Suku Manasye tidak menghalau penduduk Bet-Sean dan penduduk segala anak kotanya, penduduk Taanakh dengan segala anak kotanya, penduduk Dor dengan segala anak kotanya, penduduk Yibleam dengan segala anak kotanya, dan penduduk Megido dengan segala anak kotanya, sebab orang Kanaan itu berkeras untuk tetap diam di negeri itu."
 },
 {
   "id": 6539,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 28,
   "firman": "Setelah orang Israel menjadi kuat, mereka membuat orang Kanaan itu menjadi orang rodi dan tidak menghalau mereka sama sekali."
 },
 {
   "id": 6540,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 29,
   "firman": "Suku Efraimpun tidak menghalau orang Kanaan yang diam di Gezer, sehingga orang Kanaan itu tetap diam di tengah-tengah mereka di Gezer."
 },
 {
   "id": 6541,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 30,
   "firman": "Suku Zebulon tidak menghalau penduduk Kitron dan penduduk Nahalol, sehingga orang Kanaan itu tetap diam di tengah-tengah mereka, walaupun sebagai orang rodi."
 },
 {
   "id": 6542,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 31,
   "firman": "Suku Asyer tidak menghalau penduduk Ako, penduduk Sidon serta Ahlab, Akhzib, Helba, Afek dan Rehob,"
 },
 {
   "id": 6543,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 32,
   "firman": "sehingga orang Asyer itu diam di tengah-tengah orang Kanaan, penduduk asli di negeri itu, sebab orang-orang itu tidak dihalaunya."
 },
 {
   "id": 6544,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 33,
   "firman": "Suku Naftali tidak menghalau penduduk Bet-Semes dan penduduk Bet-Anat, sehingga mereka diam di tengah-tengah orang Kanaan, penduduk asli di negeri itu; tetapi penduduk Bet-Semes dan Bet-Anat itu menjadi orang rodi bagi mereka."
 },
 {
   "id": 6545,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 34,
   "firman": "Orang Amori mendesak bani Dan ke sebelah pegunungan dan tidak membiarkan mereka turun ke lembah,"
 },
 {
   "id": 6546,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 35,
   "firman": "dan orang Amori itu berkeras untuk tetap diam di Har-Heres, di Ayalon dan di Saalbim, walaupun mereka mendapat tekanan berat dari keturunan Yusuf, sebab mereka menjadi orang rodi."
 },
 {
   "id": 6547,
   "kitab": "Hak",
   "pasal": 1,
   "ayat": 36,
   "firman": "Daerah orang Amori itu mulai dari pendakian Akrabim, dari Sela, terus ke atas."
 },
 {
   "id": 6548,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 1,
   "firman": "Lalu Malaikat TUHAN pergi dari Gilgal ke Bokhim dan berfirman: \"Telah Kutuntun kamu keluar dari Mesir dan Kubawa ke negeri yang Kujanjikan dengan bersumpah kepada nenek moyangmu, dan Aku telah berfirman: Aku tidak akan membatalkan perjanjian-Ku dengan kamu untuk selama-lamanya,"
 },
 {
   "id": 6549,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 2,
   "firman": "tetapi janganlah kamu mengikat perjanjian dengan penduduk negeri ini; mezbah mereka haruslah kamu robohkan. Tetapi kamu tidak mendengarkan firman-Ku. Mengapa kamu perbuat demikian?"
 },
 {
   "id": 6550,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 3,
   "firman": "Lagi Aku telah berfirman: Aku tidak akan menghalau orang-orang itu dari depanmu, tetapi mereka akan menjadi musuhmu dan segala allah mereka akan menjadi jerat bagimu.\""
 },
 {
   "id": 6551,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 4,
   "firman": "Setelah Malaikat TUHAN mengucapkan firman itu kepada seluruh Israel, menangislah bangsa itu dengan keras."
 },
 {
   "id": 6552,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 5,
   "firman": "Maka tempat itu dinamai Bokhim. Lalu mereka mempersembahkan korban di sana kepada TUHAN."
 },
 {
   "id": 6553,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 6,
   "firman": "Setelah Yosua melepas bangsa itu pergi, maka pergilah orang Israel itu, masing-masing ke milik pusakanya, untuk memiliki negeri itu."
 },
 {
   "id": 6554,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 7,
   "firman": "Dan bangsa itu beribadah kepada TUHAN sepanjang zaman Yosua dan sepanjang zaman para tua-tua yang hidup lebih lama dari pada Yosua, dan yang telah melihat segenap perbuatan yang besar, yang dilakukan TUHAN bagi orang Israel."
 },
 {
   "id": 6555,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 8,
   "firman": "Dan Yosua bin Nun, hamba TUHAN itu, mati pada umur seratus sepuluh tahun;"
 },
 {
   "id": 6556,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 9,
   "firman": "ia dikuburkan di daerah milik pusakanya di Timnat-Heres, di pegunungan Efraim, di sebelah utara gunung Gaas."
 },
 {
   "id": 6557,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 10,
   "firman": "Setelah seluruh angkatan itu dikumpulkan kepada nenek moyangnya, bangkitlah sesudah mereka itu angkatan yang lain, yang tidak mengenal TUHAN ataupun perbuatan yang dilakukan-Nya bagi orang Israel."
 },
 {
   "id": 6558,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 11,
   "firman": "Lalu orang Israel melakukan apa yang jahat di mata TUHAN dan mereka beribadah kepada para Baal."
 },
 {
   "id": 6559,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 12,
   "firman": "Mereka meninggalkan TUHAN, Allah nenek moyang mereka yang telah membawa mereka keluar dari tanah Mesir, lalu mengikuti allah lain, dari antara allah bangsa-bangsa di sekeliling mereka, dan sujud menyembah kepadanya, sehingga mereka menyakiti hati TUHAN."
 },
 {
   "id": 6560,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 13,
   "firman": "Demikianlah mereka meninggalkan TUHAN dan beribadah kepada Baal dan para Asytoret."
 },
 {
   "id": 6561,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 14,
   "firman": "Maka bangkitlah murka TUHAN terhadap orang Israel. Ia menyerahkan mereka ke dalam tangan perampok dan menjual mereka kepada musuh di sekeliling mereka, sehingga mereka tidak sanggup lagi menghadapi musuh mereka."
 },
 {
   "id": 6562,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 15,
   "firman": "Setiap kali mereka maju, tangan TUHAN melawan mereka dan mendatangkan malapetaka kepada mereka, sesuai dengan apa yang telah diperingatkan kepada mereka oleh TUHAN dengan sumpah, sehingga mereka sangat terdesak."
 },
 {
   "id": 6563,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 16,
   "firman": "Maka TUHAN membangkitkan hakim-hakim, yang menyelamatkan mereka dari tangan perampok itu."
 },
 {
   "id": 6564,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi juga para hakim itu tidak mereka hiraukan, karena mereka berzinah dengan mengikuti allah lain dan sujud menyembah kepadanya. Mereka segera menyimpang dari jalan yang ditempuh oleh nenek moyangnya yang mendengarkan perintah TUHAN; mereka melakukan yang tidak patut."
 },
 {
   "id": 6565,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 18,
   "firman": "Setiap kali apabila TUHAN membangkitkan seorang hakim bagi mereka, maka TUHAN menyertai hakim itu dan menyelamatkan mereka dari tangan musuh mereka selama hakim itu hidup; sebab TUHAN berbelas kasihan mendengar rintihan mereka karena orang-orang yang mendesak dan menindas mereka."
 },
 {
   "id": 6566,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 19,
   "firman": "Tetapi apabila hakim itu mati, kembalilah mereka berlaku jahat, lebih jahat dari nenek moyang mereka, dengan mengikuti allah lain, beribadah kepadanya dan sujud menyembah kepadanya; dalam hal apapun mereka tidak berhenti dengan perbuatan dan kelakuan mereka yang tegar itu."
 },
 {
   "id": 6567,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 20,
   "firman": "Apabila murka TUHAN bangkit terhadap orang Israel, berfirmanlah Ia: \"Karena bangsa ini melanggar perjanjian yang telah Kuperintahkan kepada nenek moyang mereka, dan tidak mendengarkan firman-Ku,"
 },
 {
   "id": 6568,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 21,
   "firman": "maka Akupun tidak mau menghalau lagi dari depan mereka satupun dari bangsa-bangsa yang ditinggalkan Yosua pada waktu matinya,"
 },
 {
   "id": 6569,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 22,
   "firman": "supaya dengan perantaraan bangsa-bangsa itu Aku mencobai orang Israel, apakah mereka tetap hidup menurut jalan yang ditunjukkan TUHAN, seperti yang dilakukan oleh nenek moyang mereka, atau tidak.\""
 },
 {
   "id": 6570,
   "kitab": "Hak",
   "pasal": 2,
   "ayat": 23,
   "firman": "Demikianlah TUHAN membiarkan bangsa-bangsa itu tinggal dengan tidak segera menghalau mereka; mereka tidak diserahkan-Nya ke dalam tangan Yosua."
 },
 {
   "id": 6571,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 1,
   "firman": "Inilah bangsa-bangsa yang dibiarkan TUHAN tinggal untuk mencobai orang Israel itu dengan perantaraan mereka, yakni semua orang Israel yang tidak mengenal perang Kanaan."
 },
 {
   "id": 6572,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 2,
   "firman": "--Maksudnya hanyalah, supaya keturunan-keturunan orang Israel yang tidak mengenal perang yang sudah-sudah, dilatih berperang oleh TUHAN."
 },
 {
   "id": 6573,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 3,
   "firman": "Yang tinggal ialah kelima raja kota orang Filistin dan semua orang Kanaan, orang Sidon dan orang Hewi, yang mendiami pegunungan Libanon, dari gunung Baal-Hermon sampai ke jalan yang menuju ke Hamat."
 },
 {
   "id": 6574,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mereka itu ada di sana, supaya Ia mencobai orang Israel dengan perantaraan mereka untuk mengetahui, apakah mereka mendengarkan perintah yang diberikan TUHAN kepada nenek moyang mereka dengan perantaraan Musa."
 },
 {
   "id": 6575,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 5,
   "firman": "Demikianlah orang Israel itu diam di tengah-tengah orang Kanaan, orang Het, orang Amori, orang Feris, orang Hewi dan orang Yebus."
 },
 {
   "id": 6576,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 6,
   "firman": "Mereka mengambil anak-anak perempuan, orang-orang itu menjadi isteri mereka dan memberikan anak-anak perempuan mereka kepada anak-anak lelaki orang-orang itu, serta beribadah kepada allah orang-orang itu."
 },
 {
   "id": 6577,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 7,
   "firman": "Orang Israel melakukan apa yang jahat di mata TUHAN, mereka melupakan TUHAN, Allah mereka, dan beribadah kepada para Baal dan para Asyera."
 },
 {
   "id": 6578,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 8,
   "firman": "Lalu bangkitlah murka TUHAN terhadap orang Israel, sehingga Ia menjual mereka kepada Kusyan-Risyataim, raja Aram-Mesopotamia dan orang Israel menjadi takluk kepada Kusyan-Risyataim delapan tahun lamanya."
 },
 {
   "id": 6579,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 9,
   "firman": "Lalu berserulah orang Israel kepada TUHAN, maka TUHAN membangkitkan seorang penyelamat bagi orang Israel, yakni Otniel, anak Kenas adik Kaleb."
 },
 {
   "id": 6580,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 10,
   "firman": "Roh TUHAN menghinggapi dia dan ia menghakimi orang Israel. Ia maju berperang, lalu TUHAN menyerahkan Kusyan-Risyataim, raja Aram, ke dalam tangannya, sehingga ia mengalahkan Kusyan-Risyataim."
 },
 {
   "id": 6581,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 11,
   "firman": "Lalu amanlah negeri itu empat puluh tahun lamanya. Kemudian matilah Otniel anak Kenas."
 },
 {
   "id": 6582,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 12,
   "firman": "Tetapi orang Israel melakukan pula apa yang jahat di mata TUHAN; lalu Eglon, raja Moab, diberi TUHAN kuasa atas orang Israel, oleh sebab mereka telah melakukan apa yang jahat di mata TUHAN."
 },
 {
   "id": 6583,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 13,
   "firman": "Raja ini mengajak bani Amon dan bani Amalek menjadi sekutunya. Lalu majulah ia dan memukul orang Israel kalah. Kota pohon korma diduduki mereka."
 },
 {
   "id": 6584,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 14,
   "firman": "Delapan belas tahun lamanya orang Israel menjadi takluk kepada Eglon, raja Moab."
 },
 {
   "id": 6585,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 15,
   "firman": "Lalu orang Israel berseru kepada TUHAN, maka TUHAN membangkitkan bagi mereka seorang penyelamat yakni Ehud, anak Gera, orang Benyamin, seorang yang kidal. Dengan perantaraannya orang Israel biasa mengirimkan upeti kepada Eglon, raja Moab."
 },
 {
   "id": 6586,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 16,
   "firman": "Dan Ehud membuat pedang yang bermata dua, yang panjangnya hampir sehasta, disandangnyalah itu di bawah pakaiannya, pada pangkal paha kanannya."
 },
 {
   "id": 6587,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 17,
   "firman": "Kemudian ia menyampaikan upeti kepada Eglon, raja Moab. Adapun Eglon itu seorang yang sangat gendut."
 },
 {
   "id": 6588,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 18,
   "firman": "Setelah Ehud selesai menyampaikan upeti itu, disuruhnya pembawa-pembawa upeti itu pulang,"
 },
 {
   "id": 6589,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 19,
   "firman": "tetapi ia sendiri berhenti pada batu-batu berpahat yang di dekat Gilgal, dan kembali menghadap raja. Berkatalah ia: \"Ada pesan rahasia yang kubawa untuk tuanku, ya raja.\" Kata Eglon: \"Diamlah dahulu!\" Maka semua orang yang berdiri di depannya itu pergi ke luar."
 },
 {
   "id": 6590,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 20,
   "firman": "Lalu Ehud masuk mendapatkan dia, sedang ia duduk sendirian di kamar atas di rumah peranginannya. Berkatalah Ehud: \"Ada firman Allah yang kubawa untuk tuanku.\" Lalu bangunlah ia berdiri dari tempat duduknya."
 },
 {
   "id": 6591,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 21,
   "firman": "Kemudian Ehud mengulurkan tangan kirinya, dihunusnya pedang itu dari pangkal paha kanannya dan ditikamkannya ke perut raja,"
 },
 {
   "id": 6592,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 22,
   "firman": "sehingga hulunya beserta mata pedang itu masuk. Lemak menutupi mata pedang itu, sebab pedang itu tidak dicabutnya dari perut raja. Lalu keluarlah ia melalui pintu belakang."
 },
 {
   "id": 6593,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 23,
   "firman": "Demikianlah Ehud sampai ke serambi; pintu kamar atas itu ditutup dan dikuncinya setelah ia keluar."
 },
 {
   "id": 6594,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 24,
   "firman": "Baru saja ia keluar, datanglah hamba-hamba raja melihat, tetapi pintu kamar atas itu terkunci. Lalu berkatalah mereka: \"Tentulah ia membuang air di kamar rumah peranginan itu.\""
 },
 {
   "id": 6595,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 25,
   "firman": "Lalu mereka menunggu-nunggu sampai menjadi bingung, tetapi raja tidak membuka pintu kamar atas itu. Kemudian mereka mengambil kunci, membuka pintu, maka tampaklah tuan mereka mati tergeletak di lantai."
 },
 {
   "id": 6596,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 26,
   "firman": "Sedang mereka berlambat-lambat, Ehud meloloskan diri; ia lewat dari batu-batu berpahat dan meloloskan diri ke arah Seira."
 },
 {
   "id": 6597,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 27,
   "firman": "Setelah ia sampai ke sana, ditiupnyalah sangkakala di pegunungan Efraim, lalu turunlah orang Israel bersama-sama dengan dia dari pegunungan itu, dan ia sendiri di depan."
 },
 {
   "id": 6598,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 28,
   "firman": "Berkatalah ia kepada mereka: \"Ikutlah aku, sebab TUHAN telah menyerahkan musuhmu, orang-orang Moab itu, ke dalam tanganmu.\" Maka turunlah mereka mengikuti dia, lalu mereka merebut tempat penyeberangan sungai Yordan ke Moab dan tidak seorangpun dibiarkan mereka menyeberang."
 },
 {
   "id": 6599,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 29,
   "firman": "Pada waktu itu mereka menewaskan kira-kira sepuluh ribu orang dari Moab, semuanya orang yang tegap dan tangkas, seorangpun tidak ada yang lolos."
 },
 {
   "id": 6600,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 30,
   "firman": "Demikianlah pada hari itu Moab ditundukkan oleh Israel, maka amanlah tanah itu, delapan puluh tahun lamanya."
 },
 {
   "id": 6601,
   "kitab": "Hak",
   "pasal": 3,
   "ayat": 31,
   "firman": "Sesudah dia, bangkitlah Samgar bin Anat; ia menewaskan orang Filistin dengan tongkat penghalau lembu, enam ratus orang banyaknya. Demikianlah ia juga menyelamatkan orang Israel."
 },
 {
   "id": 6602,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 1,
   "firman": "Setelah Ehud mati, orang Israel melakukan pula apa yang jahat di mata TUHAN."
 },
 {
   "id": 6603,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 2,
   "firman": "Lalu TUHAN menyerahkan mereka ke dalam tangan Yabin, raja Kanaan, yang memerintah di Hazor. Panglima tentaranya ialah Sisera yang diam di Haroset-Hagoyim."
 },
 {
   "id": 6604,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu orang Israel berseru kepada TUHAN, sebab Sisera mempunyai sembilan ratus kereta besi dan dua puluh tahun lamanya ia menindas orang Israel dengan keras."
 },
 {
   "id": 6605,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 4,
   "firman": "Pada waktu itu Debora, seorang nabiah, isteri Lapidot, memerintah sebagai hakim atas orang Israel."
 },
 {
   "id": 6606,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 5,
   "firman": "Ia biasa duduk di bawah pohon korma Debora antara Rama dan Betel di pegunungan Efraim, dan orang Israel menghadap dia untuk berhakim kepadanya."
 },
 {
   "id": 6607,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 6,
   "firman": "Ia menyuruh memanggil Barak bin Abinoam dari Kedesh di daerah Naftali, lalu berkata kepadanya: \"Bukankah TUHAN, Allah Israel, memerintahkan demikian: Majulah, bergeraklah menuju gunung Tabor dengan membawa sepuluh ribu orang bani Naftali dan bani Zebulon bersama-sama dengan engkau,"
 },
 {
   "id": 6608,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 7,
   "firman": "dan Aku akan menggerakkan Sisera, panglima tentara Yabin, dengan kereta-keretanya dan pasukan-pasukannya menuju engkau ke sungai Kison dan Aku akan menyerahkan dia ke dalam tanganmu.\""
 },
 {
   "id": 6609,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 8,
   "firman": "Jawab Barak kepada Debora: \"Jika engkau turut maju akupun maju, tetapi jika engkau tidak turut maju akupun tidak maju.\""
 },
 {
   "id": 6610,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 9,
   "firman": "Kata Debora: \"Baik, aku turut! Hanya, engkau tidak akan mendapat kehormatan dalam perjalanan yang engkau lakukan ini, sebab TUHAN akan menyerahkan Sisera ke dalam tangan seorang perempuan.\" Lalu Debora bangun berdiri dan pergi bersama-sama dengan Barak ke Kedesh."
 },
 {
   "id": 6611,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 10,
   "firman": "Barak mengerahkan suku Zebulon dan suku Naftali ke Kedesh, maka sepuluh ribu orang maju mengikuti dia; juga Debora maju bersama-sama dengan dia."
 },
 {
   "id": 6612,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 11,
   "firman": "Adapun Heber, orang Keni itu, telah memisahkan diri dari suku Keni, dari anak-anak Hobab ipar Musa, dan telah berpindah-pindah memasang kemahnya sampai ke pohon tarbantin di Zaanaim yang dekat Kedesh."
 },
 {
   "id": 6613,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 12,
   "firman": "Setelah dikabarkan kepada Sisera, bahwa Barak bin Abinoam telah maju ke gunung Tabor,"
 },
 {
   "id": 6614,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 13,
   "firman": "dikerahkannyalah segala keretanya, sembilan ratus kereta besi, dan seluruh rakyat yang bersama-sama dengan dia, dari Haroset-Hagoyim ke sungai Kison."
 },
 {
   "id": 6615,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 14,
   "firman": "Lalu berkatalah Debora kepada Barak: \"Bersiaplah, sebab inilah harinya TUHAN menyerahkan Sisera ke dalam tanganmu. Bukankah TUHAN telah maju di depan engkau?\" Lalu turunlah Barak dari gunung Tabor dan sepuluh ribu orang mengikuti dia,"
 },
 {
   "id": 6616,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 15,
   "firman": "dan TUHAN mengacaukan Sisera serta segala keretanya dan seluruh tentaranya oleh mata pedang di depan Barak, sehingga Sisera turun dari keretanya dan melarikan diri dengan berjalan kaki."
 },
 {
   "id": 6617,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 16,
   "firman": "Lalu Barak mengejar kereta-kereta dan tentara itu sampai ke Haroset-Hagoyim, dan seluruh tentara Sisera tewas oleh mata pedang; tidak ada seorangpun yang tinggal hidup."
 },
 {
   "id": 6618,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 17,
   "firman": "Tetapi Sisera dengan berjalan kaki melarikan diri ke kemah Yael, isteri Heber, orang Keni itu, sebab ada perhubungan baik antara Yabin, raja Hazor, dengan keluarga Heber, orang Keni itu."
 },
 {
   "id": 6619,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 18,
   "firman": "Yael itupun keluar mendapatkan Sisera, dan berkata kepadanya: \"Singgahlah, tuanku, silakan masuk. Jangan takut.\" Lalu singgahlah ia ke dalam kemah perempuan itu dan perempuan itu menutupi dia dengan selimut."
 },
 {
   "id": 6620,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 19,
   "firman": "Kemudian berkatalah ia kepada perempuan itu: \"Berilah kiranya aku minum air sedikit, aku haus.\" Lalu perempuan itu membuka kirbat susu, diberinyalah dia minum dan diselimutinya pula."
 },
 {
   "id": 6621,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 20,
   "firman": "Lagi katanya kepada perempuan itu: \"Berdirilah di depan pintu kemah dan apabila ada orang datang dan bertanya kepadamu: Ada orang di sini?, maka jawablah: Tidak ada.\""
 },
 {
   "id": 6622,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 21,
   "firman": "Tetapi Yael, isteri Heber, mengambil patok kemah, diambilnya pula palu, mendekatinya diam-diam, lalu dilantaknyalah patok itu masuk ke dalam pelipisnya sampai tembus ke tanah--sebab ia telah tidur nyenyak karena lelahnya--maka matilah orang itu."
 },
 {
   "id": 6623,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 22,
   "firman": "Pada waktu itu muncullah Barak yang mengejar Sisera. Keluarlah Yael mendapatkan dia dan berkata kepadanya: \"Mari, aku akan menunjukkan kepadamu orang yang kaucari itu.\" Lalu masuklah Barak ke dalam dan tampaklah Sisera mati tergeletak dengan patok dalam pelipisnya."
 },
 {
   "id": 6624,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 23,
   "firman": "Demikianlah Allah pada hari itu menundukkan Yabin, raja Kanaan, di depan orang Israel."
 },
 {
   "id": 6625,
   "kitab": "Hak",
   "pasal": 4,
   "ayat": 24,
   "firman": "Dan kekuasaan orang Israel kian keras menekan Yabin, raja Kanaan, sampai mereka melenyapkan Yabin, raja Kanaan itu."
 },
 {
   "id": 6626,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 1,
   "firman": "Pada hari itu bernyanyilah Debora dan Barak bin Abinoam, demikian:"
 },
 {
   "id": 6627,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 2,
   "firman": "Karena pahlawan-pahlawan di Israel siap berperang, karena bangsa itu menawarkan dirinya dengan sukarela, pujilah TUHAN!"
 },
 {
   "id": 6628,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 3,
   "firman": "Dengarlah, ya raja-raja! Pasanglah telingamu, ya pemuka-pemuka! Kalau aku, aku mau bernyanyi bagi TUHAN, bermazmur bagi TUHAN, Allah Israel."
 },
 {
   "id": 6629,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 4,
   "firman": "TUHAN, ketika Engkau bergerak dari Seir, ketika Engkau melangkah maju dari daerah Edom, bergoncanglah bumi, tirislah juga langit, juga awan tiris airnya;"
 },
 {
   "id": 6630,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 5,
   "firman": "gunung-gunung--yakni Sinai--bergoyang di hadapan TUHAN, di hadapan TUHAN, Allah Israel."
 },
 {
   "id": 6631,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 6,
   "firman": "Dalam zaman Samgar bin Anat, dalam zaman Yael, kafilah tidak ada lagi dan orang-orang yang dalam perjalanan terpaksa menempuh jalan yang berbelit-belit."
 },
 {
   "id": 6632,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 7,
   "firman": "Penduduk pedusunan diam-diam saja di Israel, ya mereka diam-diam, sampai engkau bangkit, Debora, bangkit sebagai ibu di Israel."
 },
 {
   "id": 6633,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 8,
   "firman": "Ketika orang memilih allah baru, maka terjadilah perang di pintu gerbang. Sesungguhnya, perisai ataupun tombak tidak terlihat di antara empat puluh ribu orang di Israel."
 },
 {
   "id": 6634,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 9,
   "firman": "Hatiku tertuju kepada para panglima Israel, kepada mereka yang menawarkan dirinya dengan sukarela di antara bangsa itu. Pujilah TUHAN!"
 },
 {
   "id": 6635,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 10,
   "firman": "Kamu, yang menunggang keledai betina putih, kamu, yang duduk di atas permadani, kamu, yang berjalan di jalan, ceriterakanlah hal itu!"
 },
 {
   "id": 6636,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 11,
   "firman": "Di tempat-tempat penimbaan air, menurut suara orang-orang yang berdendang, di sanalah orang menyanyikan perbuatan TUHAN yang adil, perbuatan-Nya yang adil terhadap orang-orang-Nya di pedusunan di Israel. Pada waktu itu turunlah umat TUHAN ke pintu gerbang."
 },
 {
   "id": 6637,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 12,
   "firman": "Bangunlah, bangunlah, Debora! Bangunlah, bangunlah, nyanyikanlah suatu nyanyian! Bangkitlah, Barak! dan giringlah tawananmu, hai anak Abinoam!"
 },
 {
   "id": 6638,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 13,
   "firman": "Lalu turunlah para bangsawan yang terluput, umat TUHAN turun bagi-Nya sebagai pahlawan."
 },
 {
   "id": 6639,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 14,
   "firman": "Dari suku Efraim mereka datang ke lembah, mengikuti engkau, ya suku Benyamin, dengan laskarmu; dari suku Makhir turunlah para panglima dan dari suku Zebulon orang-orang pembawa tongkat pengerah."
 },
 {
   "id": 6640,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 15,
   "firman": "Juga para pemimpin suku Isakhar menyertai Debora, dan seperti Isakhar, demikianlah Naftali menyertai Barak. Mereka menyusul dia dan menyerbu masuk lembah. Tetapi pihak pasukan-pasukan suku Ruben ada banyak pertimbangan."
 },
 {
   "id": 6641,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 16,
   "firman": "Mengapa engkau tinggal duduk di antara kandang-kandang sambil mendengarkan seruling pemanggil kawanan? Di pihak pasukan-pasukan suku Ruben ada banyak pertimbangan!"
 },
 {
   "id": 6642,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 17,
   "firman": "Orang Gilead tinggal diam di seberang sungai Yordan; dan suku Dan, mengapa mereka tinggal dekat kapal-kapal? Suku Asyer duduk di tepi pantai laut, tinggal diam di teluk-teluknya."
 },
 {
   "id": 6643,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 18,
   "firman": "Tetapi suku Zebulon ialah bangsa yang berani mempertaruhkan nyawanya, demikian juga suku Naftali, di tempat-tempat tinggi di padang."
 },
 {
   "id": 6644,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 19,
   "firman": "Raja-raja datang dan berperang, pada waktu itu raja-raja Kanaan berperang dekat Taanakh, pada mata air di Megido, tetapi perak sebagai rampasan tidak diperoleh mereka."
 },
 {
   "id": 6645,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 20,
   "firman": "Dari langit berperang bintang-bintang, dari peredarannya mereka memerangi Sisera."
 },
 {
   "id": 6646,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 21,
   "firman": "Sungai Kison menghanyutkan musuh, Kison, sungai yang terkenal dari dahulu kala itu. --Majulah sekuat tenaga, hai jiwaku! --"
 },
 {
   "id": 6647,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 22,
   "firman": "Ketika itu menderaplah telapak kuda, karena berpacu lari kuda-kudanya."
 },
 {
   "id": 6648,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 23,
   "firman": "\"Kutukilah kota Meros!\" firman Malaikat TUHAN, \"kutukilah habis-habisan penduduknya, karena mereka tidak datang membantu TUHAN, membantu TUHAN sebagai pahlawan.\""
 },
 {
   "id": 6649,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 24,
   "firman": "Diberkatilah Yael, isteri Heber, orang Keni itu, melebihi perempuan-perempuan lain, diberkatilah ia, melebihi perempuan-perempuan yang di dalam kemah."
 },
 {
   "id": 6650,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 25,
   "firman": "Air diminta orang itu, tetapi susu diberikannya; dalam cawan yang indah disuguhkannya dadih."
 },
 {
   "id": 6651,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 26,
   "firman": "Tangannya diulurkannya mengambil patok, tangan kanannya mengambil tukul tukang, ditukulnya Sisera, dihancurkannya kepalanya, diremukkan dan ditembusnya pelipisnya."
 },
 {
   "id": 6652,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 27,
   "firman": "Dekat kakinya orang itu rebah, tewas tergeletak, dekat kakinya orang itu rebah dan tewas, di tempat ia rebah, di sanalah orang itu tewas, digagahi."
 },
 {
   "id": 6653,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 28,
   "firman": "Dari jendela ibu Sisera menjenguk dan berseru dari tingkap: \"Mengapa keretanya tak kunjung datang? Mengapa kereta-keretanya belum kedengaran?\""
 },
 {
   "id": 6654,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 29,
   "firman": "Yang paling bijak di antara dayang-dayangnya menjawabnya, dan ia sendiri juga membalas perkataannya itu:"
 },
 {
   "id": 6655,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 30,
   "firman": "\"Bukankah mereka mendapat jarahan dan membagi-baginya, gadis seorang dua untuk setiap orang jarahan kain berwarna sehelai dua untuk Sisera, jarahan kain sulaman aneka warna sehelai dua untuk leherku?\""
 },
 {
   "id": 6656,
   "kitab": "Hak",
   "pasal": 5,
   "ayat": 31,
   "firman": "Demikianlah akan binasa segala musuh-Mu, ya TUHAN! Tetapi orang yang mengasihi-Nya bagaikan matahari terbit dalam kemegahannya. Lalu amanlah negeri itu empat puluh tahun lamanya."
 },
 {
   "id": 6657,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 1,
   "firman": "Tetapi orang Israel melakukan apa yang jahat di mata TUHAN; sebab itu TUHAN menyerahkan mereka ke dalam tangan orang Midian, tujuh tahun lamanya,"
 },
 {
   "id": 6658,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 2,
   "firman": "dan selama itu orang Midian berkuasa atas orang Israel. Karena takutnya kepada orang Midian itu, maka orang Israel membuat tempat-tempat perlindungan di pegunungan, yakni gua-gua dan kubu-kubu."
 },
 {
   "id": 6659,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 3,
   "firman": "Setiap kali orang Israel selesai menabur, datanglah orang Midian, orang Amalek dan orang-orang dari sebelah timur, lalu maju mendatangi mereka;"
 },
 {
   "id": 6660,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 4,
   "firman": "berkemahlah orang-orang itu di daerah mereka, dan memusnahkan hasil tanah itu sampai ke dekat Gaza, dan tidak meninggalkan bahan makanan apapun di Israel, juga domba, atau lembu atau keledaipun tidak."
 },
 {
   "id": 6661,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 5,
   "firman": "Sebab orang-orang itu datang maju dengan ternaknya dan kemahnya, dan datangnya itu berbanyak-banyak seperti belalang. Orang-orangnya dan unta-untanya tidak terhitung banyaknya, sekaliannya datang ke negeri itu untuk memusnahkannya,"
 },
 {
   "id": 6662,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 6,
   "firman": "sehingga orang Israel menjadi sangat melarat oleh perbuatan orang Midian itu. Lalu berserulah orang Israel kepada TUHAN."
 },
 {
   "id": 6663,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 7,
   "firman": "Ketika orang Israel berseru kepada TUHAN karena orang Midian itu,"
 },
 {
   "id": 6664,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 8,
   "firman": "maka TUHAN mengutus seorang nabi kepada orang Israel, yang berkata kepada mereka: \"Beginilah firman TUHAN, Allah Israel: Akulah yang menuntun kamu keluar dari Mesir dan yang membawa kamu keluar dari rumah perbudakan."
 },
 {
   "id": 6665,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 9,
   "firman": "Aku melepaskan kamu dari tangan orang Mesir dan dari tangan semua orang yang menindas kamu, bahkan Aku menghalau mereka dari depanmu dan negeri mereka Kuberikan kepadamu."
 },
 {
   "id": 6666,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 10,
   "firman": "Dan Aku telah berfirman kepadamu: Akulah TUHAN, Allahmu, maka janganlah kamu menyembah allah orang Amori, yang negerinya kamu diami ini. Tetapi kamu tidak mendengarkan firman-Ku itu.\""
 },
 {
   "id": 6667,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 11,
   "firman": "Kemudian datanglah Malaikat TUHAN dan duduk di bawah pohon tarbantin di Ofra, kepunyaan Yoas, orang Abiezer itu, sedang Gideon, anaknya, mengirik gandum dalam tempat pemerasan anggur agar tersembunyi bagi orang Midian."
 },
 {
   "id": 6668,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 12,
   "firman": "Malaikat TUHAN menampakkan diri kepadanya dan berfirman kepadanya, demikian: \"TUHAN menyertai engkau, ya pahlawan yang gagah berani.\""
 },
 {
   "id": 6669,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 13,
   "firman": "Jawab Gideon kepada-Nya: \"Ah, tuanku, jika TUHAN menyertai kami, mengapa semuanya ini menimpa kami? Di manakah segala perbuatan-perbuatan-Nya yang ajaib yang diceritakan oleh nenek moyang kami kepada kami, ketika mereka berkata: Bukankah TUHAN telah menuntun kita keluar dari Mesir? Tetapi sekarang TUHAN membuang kami dan menyerahkan kami ke dalam cengkeraman orang Midian.\""
 },
 {
   "id": 6670,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 14,
   "firman": "Lalu berpalinglah TUHAN kepadanya dan berfirman: \"Pergilah dengan kekuatanmu ini dan selamatkanlah orang Israel dari cengkeraman orang Midian. Bukankah Aku mengutus engkau!\""
 },
 {
   "id": 6671,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 15,
   "firman": "Tetapi jawabnya kepada-Nya: \"Ah Tuhanku, dengan apakah akan kuselamatkan orang Israel? Ketahuilah, kaumku adalah yang paling kecil di antara suku Manasye dan akupun seorang yang paling muda di antara kaum keluargaku.\""
 },
 {
   "id": 6672,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 16,
   "firman": "Berfirmanlah TUHAN kepadanya: \"Tetapi Akulah yang menyertai engkau, sebab itu engkau akan memukul kalah orang Midian itu sampai habis.\""
 },
 {
   "id": 6673,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 17,
   "firman": "Maka jawabnya kepada-Nya: \"Jika sekiranya aku mendapat kasih karunia di mata-Mu, maka berikanlah kepadaku tanda, bahwa Engkau sendirilah yang berfirman kepadaku."
 },
 {
   "id": 6674,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 18,
   "firman": "Janganlah kiranya pergi dari sini, sampai aku datang kepada-Mu membawa persembahanku dan meletakkannya di hadapan-Mu.\" Firman-Nya: \"Aku akan tinggal, sampai engkau kembali.\""
 },
 {
   "id": 6675,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 19,
   "firman": "Masuklah Gideon ke dalam, lalu mengolah seekor anak kambing dan roti yang tidak beragi dari seefa tepung; ditaruhnya daging itu ke dalam bakul dan kuahnya ke dalam periuk, dibawanya itu kepada-Nya ke bawah pohon tarbantin, lalu disuguhkannya."
 },
 {
   "id": 6676,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 20,
   "firman": "Berfirmanlah Malaikat Allah kepadanya: \"Ambillah daging dan roti yang tidak beragi itu, letakkanlah ke atas batu ini, dan curahkan kuahnya.\" Maka diperbuatnya demikian."
 },
 {
   "id": 6677,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 21,
   "firman": "Dan Malaikat TUHAN mengulurkan tongkat yang ada di tangan-Nya; dengan ujungnya disinggung-Nya daging dan roti itu; maka timbullah api dari batu itu dan memakan habis daging dan roti itu. Kemudian hilanglah Malaikat TUHAN dari pandangannya."
 },
 {
   "id": 6678,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 22,
   "firman": "Maka tahulah Gideon, bahwa itulah Malaikat TUHAN, lalu katanya: \"Celakalah aku, Tuhanku ALLAH! sebab memang telah kulihat Malaikat TUHAN dengan berhadapan muka.\""
 },
 {
   "id": 6679,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 23,
   "firman": "Tetapi berfirmanlah TUHAN kepadanya: \"Selamatlah engkau! Jangan takut, engkau tidak akan mati.\""
 },
 {
   "id": 6680,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 24,
   "firman": "Lalu Gideon mendirikan mezbah di sana bagi TUHAN dan menamainya: TUHAN itu keselamatan. Mezbah itu masih ada sampai sekarang di Ofra, kota orang Abiezer."
 },
 {
   "id": 6681,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 25,
   "firman": "Pada malam itu juga TUHAN berfirman kepadanya: \"Ambillah seekor lembu jantan kepunyaan ayahmu, yakni lembu jantan yang kedua, berumur tujuh tahun, runtuhkanlah mezbah Baal kepunyaan ayahmu dan tebanglah tiang berhala yang di dekatnya."
 },
 {
   "id": 6682,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 26,
   "firman": "Kemudian dirikanlah mezbah bagi TUHAN, Allahmu, di atas kubu pertahanan ini dengan disusun baik, lalu ambillah lembu jantan yang kedua dan persembahkanlah korban bakaran dengan kayu tiang berhala yang akan kautebang itu.\""
 },
 {
   "id": 6683,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 27,
   "firman": "Kemudian Gideon membawa sepuluh orang hambanya dan diperbuatnyalah seperti yang difirmankan TUHAN kepadanya. Tetapi karena ia takut kepada kaum keluarganya dan kepada orang-orang kota itu untuk melakukan hal itu pada waktu siang, maka dilakukannyalah pada waktu malam."
 },
 {
   "id": 6684,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 28,
   "firman": "Ketika orang-orang kota itu bangun pagi-pagi, tampaklah telah dirobohkan mezbah Baal itu, telah ditebang tiang berhala yang di dekatnya dan telah dikorbankan lembu jantan yang kedua di atas mezbah yang didirikan itu."
 },
 {
   "id": 6685,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 29,
   "firman": "Berkatalah mereka seorang kepada yang lain: \"Siapakah yang melakukan hal itu?\" Setelah diperiksa dan ditanya-tanya, maka kata orang: \"Gideon bin Yoas, dialah yang melakukan hal itu.\""
 },
 {
   "id": 6686,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 30,
   "firman": "Sesudah itu berkatalah orang-orang kota itu kepada Yoas: \"Bawalah anakmu itu ke luar; dia harus mati, karena ia telah merobohkan mezbah Baal dan karena ia telah menebang tiang berhala yang di dekatnya.\""
 },
 {
   "id": 6687,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 31,
   "firman": "Tetapi jawab Yoas kepada semua orang yang mengerumuninya itu: \"Kamu mau berjuang membela Baal? Atau kamu mau menolong dia? Siapa yang berjuang membela Baal akan dihukum mati sebelum pagi. Jika Baal itu allah, biarlah ia berjuang membela dirinya sendiri, setelah mezbahnya dirobohkan orang.\""
 },
 {
   "id": 6688,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 32,
   "firman": "Dan pada hari itu diberikan oranglah nama Yerubaal kepada Gideon, karena kata orang: \"Biarlah Baal berjuang dengan dia, setelah dirobohkannya mezbahnya itu.\""
 },
 {
   "id": 6689,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 33,
   "firman": "Seluruh orang Midian dan orang Amalek dan orang-orang dari sebelah timur telah berkumpul bersama-sama; mereka telah menyeberang dan berkemah di lembah Yizreel."
 },
 {
   "id": 6690,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 34,
   "firman": "Pada waktu itu Roh TUHAN menguasai Gideon; ditiupnyalah sangkakala dan orang-orang Abiezer dikerahkan untuk mengikuti dia."
 },
 {
   "id": 6691,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 35,
   "firman": "Juga dikirimnya pesan kepada seluruh suku Manasye dan orang-orang inipun dikerahkan untuk mengikuti dia. Dikirimnya pula pesan kepada suku Asyer, Zebulon dan Naftali, dan orang-orang inipun maju untuk menggabungkan diri dengan mereka."
 },
 {
   "id": 6692,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 36,
   "firman": "Kemudian berkatalah Gideon kepada Allah: \"Jika Engkau mau menyelamatkan orang Israel dengan perantaraanku, seperti yang Kaufirmankan itu,"
 },
 {
   "id": 6693,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 37,
   "firman": "maka aku membentangkan guntingan bulu domba di tempat pengirikan; apabila hanya di atas guntingan bulu itu ada embun, tetapi seluruh tanah di situ tinggal kering, maka tahulah aku, bahwa Engkau mau menyelamatkan orang Israel dengan perantaraanku, seperti yang Kaufirmankan.\""
 },
 {
   "id": 6694,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 38,
   "firman": "Dan demikianlah terjadi; sebab keesokan harinya pagi-pagi ia bangun, dipulasnya guntingan bulu itu dan diperasnya air embun dari guntingan bulu itu, secawan penuh air."
 },
 {
   "id": 6695,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 39,
   "firman": "Lalu berkatalah Gideon kepada Allah: \"Janganlah kiranya murka-Mu bangkit terhadap aku, apabila aku berkata lagi, sekali ini saja; biarkanlah aku satu kali lagi saja mengambil percobaan dengan guntingan bulu itu: sekiranya yang kering hanya guntingan bulu itu, dan di atas seluruh tanah itu ada embun.\""
 },
 {
   "id": 6696,
   "kitab": "Hak",
   "pasal": 6,
   "ayat": 40,
   "firman": "Dan demikianlah diperbuat Allah pada malam itu, sebab hanya guntingan bulu itu yang kering, dan di atas seluruh tanah itu ada embun."
 },
 {
   "id": 6697,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 1,
   "firman": "Adapun Yerubaal--itulah Gideon--bangun pagi-pagi dengan segala rakyat yang bersama-sama dengan dia, lalu mereka berkemah dekat mata air Harod; perkemahan orang Midian itu ada di sebelah utaranya, dekat bukit More, di lembah."
 },
 {
   "id": 6698,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 2,
   "firman": "Berfirmanlah TUHAN kepada Gideon: \"Terlalu banyak rakyat yang bersama-sama dengan engkau itu dari pada yang Kuhendaki untuk menyerahkan orang Midian ke dalam tangan mereka, jangan-jangan orang Israel memegah-megahkan diri terhadap Aku, sambil berkata: Tanganku sendirilah yang menyelamatkan aku."
 },
 {
   "id": 6699,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 3,
   "firman": "Maka sekarang, serukanlah kepada rakyat itu, demikian: Siapa yang takut dan gentar, biarlah ia pulang, enyah dari pegunungan Gilead.\" Lalu pulanglah dua puluh dua ribu orang dari rakyat itu dan tinggallah sepuluh ribu orang."
 },
 {
   "id": 6700,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 4,
   "firman": "Tetapi TUHAN berfirman kepada Gideon: \"Masih terlalu banyak rakyat; suruhlah mereka turun minum air, maka Aku akan menyaring mereka bagimu di sana. Siapa yang Kufirmankan kepadamu: Inilah orang yang akan pergi bersama-sama dengan engkau, dialah yang akan pergi bersama-sama dengan engkau, tetapi barangsiapa yang Kufirmankan kepadamu: Inilah orang yang tidak akan pergi bersama-sama dengan engkau, dialah yang tidak akan pergi.\""
 },
 {
   "id": 6701,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 5,
   "firman": "Lalu Gideon menyuruh rakyat itu turun minum air, dan berfirmanlah TUHAN kepadanya: \"Barangsiapa yang menghirup air dengan lidahnya seperti anjing menjilat, haruslah kaukumpulkan tersendiri, demikian juga semua orang yang berlutut untuk minum.\""
 },
 {
   "id": 6702,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 6,
   "firman": "Jumlah orang yang menghirup dengan membawa tangannya ke mulutnya, ada tiga ratus orang, tetapi yang lain dari rakyat itu semuanya berlutut minum air."
 },
 {
   "id": 6703,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 7,
   "firman": "Lalu berfirmanlah TUHAN kepada Gideon: \"Dengan ketiga ratus orang yang menghirup itu akan Kuselamatkan kamu: Aku akan menyerahkan orang Midian ke dalam tanganmu; tetapi yang lain dari rakyat itu semuanya boleh pergi, masing-masing ke tempat kediamannya.\""
 },
 {
   "id": 6704,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dari rakyat itu mereka mengambil bekal dan sangkakala; demikianlah seluruh orang Israel disuruhnya pergi, masing-masing ke kemahnya, tetapi ketiga ratus orang itu ditahannya. Adapun perkemahan orang Midian ada di bawahnya, di lembah."
 },
 {
   "id": 6705,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 9,
   "firman": "Pada malam itu berfirmanlah TUHAN kepadanya: \"Bangunlah, turunlah menyerbu perkemahan itu, sebab telah Kuserahkan itu ke dalam tanganmu."
 },
 {
   "id": 6706,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 10,
   "firman": "Tetapi jika engkau takut untuk turun menyerbu, turunlah bersama dengan Pura, bujangmu, ke perkemahan itu;"
 },
 {
   "id": 6707,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 11,
   "firman": "maka kaudengarlah apa yang mereka katakan; kemudian engkau akan mendapat keberanian untuk turun menyerbu perkemahan itu.\" Lalu turunlah ia bersama dengan Pura, bujangnya itu, sampai kepada penjagaan terdepan laskar di perkemahan itu."
 },
 {
   "id": 6708,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 12,
   "firman": "Adapun orang Midian dan orang Amalek dan semua orang dari sebelah timur itu bergelimpangan di lembah itu, seperti belalang banyaknya, dan unta mereka tidak terhitung, seperti pasir di tepi laut banyaknya."
 },
 {
   "id": 6709,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 13,
   "firman": "Ketika Gideon sampai ke situ, kebetulan ada seorang menceritakan mimpinya kepada temannya, katanya: \"Aku bermimpi: tampak sekeping roti jelai terguling masuk ke perkemahan orang Midian; setelah sampai ke kemah ini, dilanggarnyalah kemah ini, sehingga roboh, dan dibongkar-bangkirkannya, demikianlah kemah ini habis runtuh.\""
 },
 {
   "id": 6710,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 14,
   "firman": "Lalu temannya menjawab: \"Ini tidak lain dari pedang Gideon bin Yoas, orang Israel itu; Allah telah menyerahkan orang Midian dan seluruh perkemahan ini ke dalam tangannya.\""
 },
 {
   "id": 6711,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 15,
   "firman": "Segera sesudah Gideon mendengar mimpi itu diceritakan dengan maknanya, sujudlah ia menyembah. Kemudian pulanglah ia ke perkemahan orang Israel, lalu berkata: \"Bangunlah, sebab TUHAN telah menyerahkan perkemahan orang Midian ke dalam tanganmu.\""
 },
 {
   "id": 6712,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 16,
   "firman": "Sesudah itu dibaginyalah ketiga ratus orang itu dalam tiga pasukan dan ke tangan mereka semuanya diberikannya sangkakala dan buyung kosong dengan suluh di dalam buyung itu."
 },
 {
   "id": 6713,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 17,
   "firman": "Dan berkatalah ia kepada mereka: \"Perhatikanlah aku dan lakukanlah seperti yang kulakukan. Maka apabila aku sampai ke ujung perkemahan itu, haruslah kamu lakukan seperti yang kulakukan."
 },
 {
   "id": 6714,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 18,
   "firman": "Apabila aku dan semua orang yang bersama dengan aku meniup sangkakala, maka haruslah kamu juga meniup sangkakala sekeliling seluruh perkemahan itu, dan berseru: 'Demi TUHAN dan demi Gideon!'\""
 },
 {
   "id": 6715,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 19,
   "firman": "Lalu Gideon dan keseratus orang yang bersama-sama dengan dia sampai ke ujung perkemahan itu pada waktu permulaan giliran jaga tengah malam, ketika penjaga-penjaga baru saja ditempatkan. Lalu mereka meniup sangkakala sambil memecahkan buyung yang di tangan mereka."
 },
 {
   "id": 6716,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 20,
   "firman": "Demikianlah ketiga pasukan itu bersama-sama meniup sangkakala, dan memecahkan buyung dengan memegang obor di tangan kirinya dan sangkakala di tangan kanannya untuk ditiup, serta berseru: \"Pedang demi TUHAN dan demi Gideon!\""
 },
 {
   "id": 6717,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 21,
   "firman": "Sementara itu tinggallah mereka berdiri, masing-masing di tempatnya, sekeliling perkemahan itu, tetapi seluruh tentara musuh menjadi kacau balau, berteriak-teriak dan melarikan diri."
 },
 {
   "id": 6718,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 22,
   "firman": "Sedang ketiga ratus orang itu meniup sangkakala, maka di perkemahan itu TUHAN membuat pedang yang seorang diarahkan kepada yang lain, lalu larilah tentara itu sampai ke Bet-Sita ke arah Zerera sampai ke pinggir Abel-Mehola dekat Tabat."
 },
 {
   "id": 6719,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 23,
   "firman": "Kemudian dikerahkanlah orang-orang Israel dari suku Naftali dan dari suku Asyer dan dari segenap suku Manasye, lalu mereka mengejar orang Midian itu."
 },
 {
   "id": 6720,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 24,
   "firman": "Gideon menyuruh juga orang ke seluruh pegunungan Efraim dengan pesan: \"Turunlah menghadapi orang Midian, dan dudukilah segala batang air sampai ke Bet-Bara, dan juga sungai Yordan.\" Maka semua orang Efraim dikerahkan, lalu mereka menduduki segala batang air sampai ke Bet-Bara, juga sungai Yordan."
 },
 {
   "id": 6721,
   "kitab": "Hak",
   "pasal": 7,
   "ayat": 25,
   "firman": "Mereka berhasil menawan dua raja Midian, yakni Oreb dan Zeeb. Oreb dibunuh di gunung batu Oreb dan Zeeb dibunuh dalam tempat pemerasan anggur Zeeb. Mereka mengejar orang Midian itu, lalu mereka membawa kepala Oreb dan kepala Zeeb kepada Gideon di seberang sungai Yordan."
 },
 {
   "id": 6722,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 1,
   "firman": "Lalu berkatalah orang-orang Efraim kepada Gideon: \"Apa macam perbuatanmu ini terhadap kami! Mengapa engkau tidak memanggil kami, ketika engkau pergi berperang melawan orang Midian?\" Lalu mereka menyesali dia dengan sangat."
 },
 {
   "id": 6723,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 2,
   "firman": "Jawabnya kepada mereka: \"Apa perbuatanku dalam hal ini, jika dibandingkan dengan kamu? Bukankah pemetikan susulan oleh suku Efraim lebih baik hasilnya dari panen buah anggur kaum Abiezer?"
 },
 {
   "id": 6724,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 3,
   "firman": "Allah telah menyerahkan kedua raja Midian itu, yakni Oreb dan Zeeb, ke dalam tanganmu; apa yang telah dapat kucapai, jika dibandingkan dengan kamu?\" Setelah ia berkata demikian, maka redalah marah mereka terhadap dia."
 },
 {
   "id": 6725,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 4,
   "firman": "Ketika Gideon sampai ke sungai Yordan, menyeberanglah ia dan ketiga ratus orang yang bersama-sama dengan dia, meskipun masih lelah, namun mengejar juga."
 },
 {
   "id": 6726,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 5,
   "firman": "Dan berkatalah ia kepada orang-orang Sukot: \"Tolong berikan beberapa roti untuk rakyat yang mengikuti aku ini, sebab mereka telah lelah, dan aku sedang mengejar Zebah dan Salmuna, raja-raja Midian.\""
 },
 {
   "id": 6727,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 6,
   "firman": "Tetapi jawab para pemuka di Sukot itu: \"Sudahkah Zebah dan Salmuna itu ada dalam tanganmu, sehingga kami harus memberikan roti kepada tentaramu?\""
 },
 {
   "id": 6728,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 7,
   "firman": "Lalu kata Gideon: \"Kalau begitu, apabila TUHAN menyerahkan Zebah dan Salmuna ke dalam tanganku, aku akan menggaruk tubuhmu dengan duri padang gurun dan onak.\""
 },
 {
   "id": 6729,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 8,
   "firman": "Maka berjalanlah ia dari sana ke Pnuel, dan berkata demikian juga kepada orang-orang Pnuel, tetapi orang-orang inipun menjawabnya seperti orang-orang Sukot."
 },
 {
   "id": 6730,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 9,
   "firman": "Lalu berkatalah ia juga kepada orang-orang Pnuel: \"Apabila aku kembali dengan selamat, maka aku akan merobohkan menara ini.\""
 },
 {
   "id": 6731,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 10,
   "firman": "Sementara itu Zebah dan Salmuna ada di Karkor bersama-sama dengan tentara mereka, kira-kira lima belas ribu orang banyaknya, yakni semua orang yang masih tinggal hidup dari seluruh tentara orang-orang dari sebelah timur; banyaknya yang tewas ada seratus dua puluh ribu orang yang bersenjatakan pedang."
 },
 {
   "id": 6732,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 11,
   "firman": "Gideon maju melalui jalan orang-orang yang diam di dalam kemah di sebelah timur Nobah dan Yogbeha, lalu memukul kalah tentara itu, ketika tentara itu menyangka dirinya aman."
 },
 {
   "id": 6733,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 12,
   "firman": "Zebah dan Salmuna melarikan diri, tetapi Gideon mengejar mereka dan menawan kedua raja Midian itu, yakni Zebah dan Salmuna, sedang seluruh tentara itu diceraiberaikannya."
 },
 {
   "id": 6734,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 13,
   "firman": "Kemudian kembalilah Gideon bin Yoas dari peperangan dengan melalui pendakian Heres;"
 },
 {
   "id": 6735,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 14,
   "firman": "ditangkapnyalah seorang muda dari penduduk Sukot. Setelah ditanyai, orang itu menuliskan nama para pemuka dan para tua-tua di Sukot untuk Gideon, tujuh puluh tujuh orang banyaknya."
 },
 {
   "id": 6736,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 15,
   "firman": "Lalu pergilah Gideon kepada orang-orang Sukot sambil berkata: \"Inilah Zebah dan Salmuna yang karenanya kamu telah mencela aku dengan berkata: Sudahkah Zebah dan Salmuna itu ada dalam tanganmu, sehingga kami harus memberikan roti kepada orang-orangmu yang lelah itu?\""
 },
 {
   "id": 6737,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 16,
   "firman": "Lalu ia mengumpulkan para tua-tua kota itu, ia mengambil duri padang gurun dan onak, dan menghajar orang-orang Sukot dengan itu."
 },
 {
   "id": 6738,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 17,
   "firman": "Juga menara Pnuel dirobohkannya dan dibunuhnya orang-orang kota itu."
 },
 {
   "id": 6739,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 18,
   "firman": "Kemudian bertanyalah ia kepada Zebah dan Salmuna: \"Di manakah orang-orang yang telah kamu bunuh di Tabor itu?\" Jawab mereka: \"Mereka itu serupa dengan engkau, sikap mereka masing-masing seperti anak raja.\""
 },
 {
   "id": 6740,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 19,
   "firman": "Lalu kata Gideon: \"Saudara-saudarakulah itu, anak-anak ibuku! Demi TUHAN yang hidup, seandainya kamu membiarkan mereka hidup, aku tidak akan membunuh kamu.\""
 },
 {
   "id": 6741,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 20,
   "firman": "Katanya kepada Yeter, anak sulungnya: \"Bangunlah, bunuhlah mereka.\" Tetapi orang muda itu tidak menghunus pedangnya, karena ia takut, sebab ia masih muda."
 },
 {
   "id": 6742,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 21,
   "firman": "Lalu kata Zebah dan Salmuna: \"Bangunlah engkau sendiri dan paranglah kami, sebab seperti orangnya, demikian pula kekuatannya.\" Maka bangunlah Gideon, dibunuhnya Zebah dan Salmuna, kemudian diambilnya bulan-bulanan yang ada pada leher unta mereka."
 },
 {
   "id": 6743,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 22,
   "firman": "Kemudian berkatalah orang Israel kepada Gideon: \"Biarlah engkau memerintah kami, baik engkau baik anakmu maupun cucumu, sebab engkaulah yang telah menyelamatkan kami dari tangan orang Midian.\""
 },
 {
   "id": 6744,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 23,
   "firman": "Jawab Gideon kepada mereka: \"Aku tidak akan memerintah kamu dan juga anakku tidak akan memerintah kamu tetapi TUHAN yang memerintah kamu.\""
 },
 {
   "id": 6745,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 24,
   "firman": "Selanjutnya kata Gideon kepada mereka: \"Satu hal saja yang kuminta kepadamu: Baiklah kamu masing-masing memberikan anting-anting dari jarahannya.\" --Karena musuh itu beranting-anting mas, sebab mereka orang Ismael."
 },
 {
   "id": 6746,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 25,
   "firman": "Jawab mereka: \"Kami mau memberikannya dengan suka hati.\" Dan setelah dihamparkan sehelai kain, maka masing-masing melemparkan anting-anting dari jarahannya ke atas kain itu."
 },
 {
   "id": 6747,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 26,
   "firman": "Adapun berat anting-anting emas yang dimintanya itu ada seribu tujuh ratus syikal emas, belum terhitung bulan-bulanan, perhiasan telinga dan pakaian kain ungu muda yang dipakai oleh raja-raja Midian, dan belum terhitung kalung rantai yang ada pada leher unta mereka."
 },
 {
   "id": 6748,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 27,
   "firman": "Kemudian Gideon membuat efod dari semuanya itu dan menempatkannya di kotanya, di Ofra. Di sanalah orang Israel berlaku serong dengan menyembah efod itu; inilah yang menjadi jerat bagi Gideon dan seisi rumahnya."
 },
 {
   "id": 6749,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 28,
   "firman": "Demikianlah orang Midian tunduk kepada orang Israel dan tidak dapat menegakkan kepalanya lagi; maka amanlah negeri itu empat puluh tahun lamanya pada zaman Gideon."
 },
 {
   "id": 6750,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 29,
   "firman": "Lalu Yerubaal bin Yoas pergilah dan diam di rumahnya sendiri."
 },
 {
   "id": 6751,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 30,
   "firman": "Gideon mempunyai tujuh puluh anak laki-laki, semuanya anak kandungnya, sebab ia beristeri banyak;"
 },
 {
   "id": 6752,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 31,
   "firman": "juga gundiknya yang tinggal di Sikhem melahirkan seorang anak laki-laki baginya, lalu ia memberikan nama Abimelekh kepada anak itu."
 },
 {
   "id": 6753,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 32,
   "firman": "Gideon bin Yoas mati pada waktu rambutnya telah putih, lalu dikuburkan dalam kubur Yoas, ayahnya, di Ofra kota orang Abiezer."
 },
 {
   "id": 6754,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 33,
   "firman": "Setelah Gideon mati, kembalilah orang Israel berjalan serong dengan mengikuti para Baal dan membuat Baal-Berit menjadi allah mereka;"
 },
 {
   "id": 6755,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 34,
   "firman": "orang Israel tidak ingat kepada TUHAN, Allah mereka, yang telah melepaskan mereka dari tangan semua musuhnya di sekelilingnya,"
 },
 {
   "id": 6756,
   "kitab": "Hak",
   "pasal": 8,
   "ayat": 35,
   "firman": "juga tidak menunjukkan terima kasihnya kepada keturunan Yerubaal-Gideon seimbang dengan segala yang baik yang telah dilakukannya kepada orang Israel."
 },
 {
   "id": 6757,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 1,
   "firman": "Adapun Abimelekh bin Yerubaal pergi ke Sikhem kepada saudara-saudara ibunya dan berkata kepada mereka dan kepada seluruh kaum dari pihak keluarga ibunya:"
 },
 {
   "id": 6758,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 2,
   "firman": "\"Tolong katakan kepada seluruh warga kota Sikhem: Manakah yang lebih baik bagimu: tujuh puluh orang memerintah kamu, yaitu semua anak Yerubaal, atau satu orang? Dan ingat juga, bahwa aku darah dagingmu.\""
 },
 {
   "id": 6759,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 3,
   "firman": "Lalu saudara-saudara ibunya mengatakan hal ihwalnya kepada seluruh warga kota Sikhem, maka condonglah hati orang-orang itu untuk mengikuti Abimelekh, sebab kata mereka: \"Memang ia saudara kita.\""
 },
 {
   "id": 6760,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 4,
   "firman": "Sesudah itu mereka memberikan kepadanya tujuh puluh uang perak dari kuil Baal-Berit, lalu Abimelekh memberi perak itu sebagai upah kepada petualang-petualang dan orang-orang nekat supaya mengikuti dia."
 },
 {
   "id": 6761,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 5,
   "firman": "Ia pergi ke rumah ayahnya di Ofra, lalu membunuh saudara-saudaranya, anak-anak Yerubaal, tujuh puluh orang, di atas satu batu. Tetapi Yotam, anak bungsu Yerubaal tinggal hidup, karena ia menyembunyikan diri."
 },
 {
   "id": 6762,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 6,
   "firman": "Kemudian berkumpullah seluruh warga kota Sikhem dan seluruh Bet-Milo; mereka pergi menobatkan Abimelekh menjadi raja dekat pohon tarbantin di tugu peringatan yang di Sikhem."
 },
 {
   "id": 6763,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 7,
   "firman": "Setelah hal itu dikabarkan kepada Yotam, pergilah ia ke gunung Gerizim dan berdiri di atasnya, lalu berserulah ia dengan suara nyaring kepada mereka: \"Dengarkanlah aku, kamu warga kota Sikhem, maka Allah akan mendengarkan kamu juga."
 },
 {
   "id": 6764,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 8,
   "firman": "Sekali peristiwa pohon-pohon pergi mengurapi yang akan menjadi raja atas mereka. Kata mereka kepada pohon zaitun: Jadilah raja atas kami!"
 },
 {
   "id": 6765,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 9,
   "firman": "Tetapi jawab pohon zaitun itu kepada mereka: Masakan aku meninggalkan minyakku yang dipakai untuk menghormati Allah dan manusia, dan pergi melayang di atas pohon-pohon?"
 },
 {
   "id": 6766,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 10,
   "firman": "Lalu kata pohon-pohon itu kepada pohon ara: Marilah, jadilah raja atas kami!"
 },
 {
   "id": 6767,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 11,
   "firman": "Tetapi jawab pohon ara itu kepada mereka: Masakan aku meninggalkan manisanku dan buah-buahku yang baik, dan pergi melayang di atas pohon-pohon?"
 },
 {
   "id": 6768,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 12,
   "firman": "Lalu kata pohon-pohon itu kepada pohon anggur: Marilah, jadilah raja atas kami!"
 },
 {
   "id": 6769,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 13,
   "firman": "Tetapi jawab pohon anggur itu kepada mereka: Masakan aku meninggalkan air buah anggurku, yang menyukakan hati Allah dan manusia, dan pergi melayang di atas pohon-pohon?"
 },
 {
   "id": 6770,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 14,
   "firman": "Lalu kata segala pohon itu kepada semak duri: Marilah, jadilah raja atas kami!"
 },
 {
   "id": 6771,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 15,
   "firman": "Jawab semak duri itu kepada pohon-pohon itu: Jika kamu sungguh-sungguh mau mengurapi aku menjadi raja atas kamu, datanglah berlindung di bawah naunganku; tetapi jika tidak, biarlah api keluar dari semak duri dan memakan habis pohon-pohon aras yang di gunung Libanon."
 },
 {
   "id": 6772,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 16,
   "firman": "Maka sekarang, jika kamu berlaku setia dan tulus ikhlas dengan membuat Abimelekh menjadi raja, dan jika kamu berbuat yang baik kepada Yerubaal dan kepada keturunannya dan jika kamu membalaskan kepadanya seimbang dengan jasanya--"
 },
 {
   "id": 6773,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 17,
   "firman": "bukankah ayahku telah berperang membela kamu dan menyabung nyawanya, dan telah melepaskan kamu dari tangan orang Midian,"
 },
 {
   "id": 6774,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 18,
   "firman": "padahal kamu sekarang memberontak terhadap keturunan ayahku dan membunuh anak-anaknya, tujuh puluh orang banyaknya, di atas satu batu, serta membuat Abimelekh anak seorang budaknya perempuan menjadi raja atas warga kota Sikhem, karena ia saudaramu--"
 },
 {
   "id": 6775,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 19,
   "firman": "jadi jika kamu pada hari ini berlaku setia dan tulus ikhlas kepada Yerubaal dan keturunannya, maka silakanlah kamu bersukacita atas Abimelekh dan silakanlah ia bersukacita atas kamu."
 },
 {
   "id": 6776,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 20,
   "firman": "Tetapi jika tidak demikian, maka biarlah api keluar dari pada Abimelekh dan memakan habis warga kota Sikhem dan juga Bet-Milo, dan biarlah api keluar dari pada warga kota Sikhem dan juga dari Bet-Milo dan memakan habis Abimelekh.\""
 },
 {
   "id": 6777,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 21,
   "firman": "Kemudian larilah Yotam; ia melarikan diri ke Beer, dan tinggal di sana karena takut kepada Abimelekh, saudaranya itu."
 },
 {
   "id": 6778,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 22,
   "firman": "Setelah tiga tahun lamanya Abimelekh memerintah atas orang Israel,"
 },
 {
   "id": 6779,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 23,
   "firman": "maka Allah membangkitkan semangat jahat di antara Abimelekh dan warga kota Sikhem, sehingga warga kota Sikhem itu menjadi tidak setia kepada Abimelekh,"
 },
 {
   "id": 6780,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 24,
   "firman": "supaya kekerasan terhadap ketujuh puluh anak Yerubaal dibalaskan dan darah mereka ditimpakan kepada Abimelekh, saudara mereka yang telah membunuh mereka dan kepada warga kota Sikhem yang membantu dia membunuh saudara-saudaranya itu."
 },
 {
   "id": 6781,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 25,
   "firman": "Sebab warga kota Sikhem itu menempatkan orang untuk menghadang dia di puncak gunung dan merampas setiap orang yang melewati mereka melalui jalan itu. Hal itu dikabarkan kepada Abimelekh."
 },
 {
   "id": 6782,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sementara itu Gaal bin Ebed beserta saudara-saudaranya telah datang dan pindah ke kota Sikhem. Warga kota Sikhem percaya kepadanya,"
 },
 {
   "id": 6783,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 27,
   "firman": "jadi pergilah mereka ke ladang; mereka mengumpulkan hasil kebun anggur mereka, dan mengirik memerasnya, lalu mengadakan perayaan. Mereka masuk ke kuil allah mereka dan makan minum sambil mengutuki Abimelekh."
 },
 {
   "id": 6784,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 28,
   "firman": "Berkatalah Gaal bin Ebed: \"Siapa itu Abimelekh dan siapa kita orang Sikhem, maka kita menjadi hambanya? Bukankah anak Yerubaal dan Zebul, wakilnya, menjadi hamba orang-orang Hemor, ayah Sikhem, jadi mengapakah kita menjadi hambanya?"
 },
 {
   "id": 6785,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 29,
   "firman": "Sekiranya orang-orang kota ini ada di dalam tanganku, maka tentulah aku mengenyahkan Abimelekh.\" Lalu berkatalah ia ke arah Abimelekh: \"Perkuatlah tentaramu dan majulah!\""
 },
 {
   "id": 6786,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 30,
   "firman": "Ketika Zebul, penguasa kota itu mendengar perkataan Gaal bin Ebed, bangkitlah amarahnya."
 },
 {
   "id": 6787,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 31,
   "firman": "Ia mengirim utusan kepada Abimelekh di Aruma dengan pesan: \"Gaal bin Ebed dan saudara-saudaranya telah datang ke Sikhem dan ketahuilah mereka menghasut kota itu melawan engkau."
 },
 {
   "id": 6788,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 32,
   "firman": "Oleh sebab itu, berangkatlah pada waktu malam, engkau dan rakyat yang bersama-sama dengan engkau itu, dan adakanlah penghadangan di padang."
 },
 {
   "id": 6789,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 33,
   "firman": "Esoknya pagi-pagi, pada waktu matahari terbit, haruslah engkau menyerbu kota itu. Dan jika ia dan orang-orangnya keluar melawan engkau, maka engkau dapat berbuat kepadanya sesuai dengan keadaan yang kaudapati.\""
 },
 {
   "id": 6790,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 34,
   "firman": "Sebab itu berangkatlah Abimelekh pada waktu malam beserta segala rakyat yang bersama-sama dengan dia, lalu mereka mengadakan penghadangan dalam empat pasukan untuk melawan Sikhem."
 },
 {
   "id": 6791,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 35,
   "firman": "Ketika Gaal bin Ebed pergi ke luar dan berdiri di depan pintu gerbang kota itu, Abimelekh kebetulan bangun dari tempat penghadangannya beserta rakyat yang bersama-sama dengan dia."
 },
 {
   "id": 6792,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 36,
   "firman": "Ketika Gaal melihat rakyat itu, berkatalah ia kepada Zebul: \"Lihat, ada orang banyak turun dari puncak gunung.\" Jawab Zebul kepadanya: \"Itu bayang-bayang gunung, yang kausangka manusia.\""
 },
 {
   "id": 6793,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 37,
   "firman": "Kata Gaal sekali lagi: \"Lihat, ada orang banyak turun dari gunung Pusat Tanah dan satu kelompok datang dari jalan Pohon Tarbantin Peramal.\""
 },
 {
   "id": 6794,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 38,
   "firman": "Jawab Zebul kepadanya: \"Di manakah mulutmu itu yang mengatakan: Siapa itu Abimelekh, maka kita menjadi hambanya? Bukankah ini orang-orang yang telah kauhina itu? Majulah sekarang untuk memerangi mereka.\""
 },
 {
   "id": 6795,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 39,
   "firman": "Maka majulah Gaal dengan dipandangi oleh warga kota Sikhem, lalu berperang melawan Abimelekh."
 },
 {
   "id": 6796,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 40,
   "firman": "Tetapi Abimelekh mengejar dia, dan ia melarikan diri dari depannya, dan banyaklah orang tewas sampai di depan pintu gerbang."
 },
 {
   "id": 6797,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 41,
   "firman": "Adapun Abimelekh tinggal di Aruma, tetapi Zebul mengusir Gaal dan saudara-saudaranya, sehingga mereka ini tidak dapat tinggal di Sikhem."
 },
 {
   "id": 6798,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 42,
   "firman": "Keesokan harinya orang-orang kota itu pergi ke ladang. Setelah hal ini dikabarkan kepada Abimelekh,"
 },
 {
   "id": 6799,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 43,
   "firman": "dibawanyalah rakyatnya, dibaginya dalam tiga pasukan, lalu mereka mengadakan penghadangan di padang. Ketika dilihatnya, bahwa orang-orang kota itu keluar dari dalam kota, bangunlah ia menyerang mereka serta menewaskan mereka."
 },
 {
   "id": 6800,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 44,
   "firman": "Abimelekh dan pasukan yang bersama-sama dengan dia menyerbu dan menduduki pintu gerbang kota, sedang kedua pasukan lain itu menyerbu dan menewaskan semua orang yang ada di padang."
 },
 {
   "id": 6801,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 45,
   "firman": "Sehari-harian itu Abimelekh berperang melawan kota itu; ia merebut kota itu dan membunuh orang-orang yang di dalamnya; kemudian dirobohkannya kota itu dan ditaburinya dengan garam."
 },
 {
   "id": 6802,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 46,
   "firman": "Mendengar itu masuklah seluruh warga kota Menara-Sikhem ke dalam liang di bawah kuil El-Berit."
 },
 {
   "id": 6803,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 47,
   "firman": "Dikabarkanlah kepada Abimelekh, bahwa seluruh warga kota Menara-Sikhem telah berhimpun di sana."
 },
 {
   "id": 6804,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 48,
   "firman": "Lalu Abimelekh dan seluruh rakyat yang bersama-sama dengan dia naik ke gunung Zalmon. Abimelekh mengambil kapak, lalu memotong dahan-dahan kayu, mengangkatnya dan meletakkannya ke atas bahunya sambil berkata kepada rakyatnya yang bersama-sama dengan dia: \"Turutilah dengan segera perbuatanku yang kamu lihat ini.\""
 },
 {
   "id": 6805,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 49,
   "firman": "Kemudian rakyat itu juga masing-masing memotong dahan-dahan, lalu mengikuti Abimelekh, meletakkan dahan-dahan itu di atas liang dan membakar liang itu di atas kepala orang-orang itu. Demikianlah semua penduduk kota Menara-Sikhem juga mati, kira-kira seribu orang laki-laki dan perempuan."
 },
 {
   "id": 6806,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 50,
   "firman": "Selanjutnya Abimelekh pergi ke Tebes; ia mengepung Tebes, lalu merebutnya."
 },
 {
   "id": 6807,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 51,
   "firman": "Tetapi ada sebuah menara yang kuat di tengah-tengah kota, dan semua laki-laki dan perempuan, seluruh warga kota itu, melarikan diri ke situ; mereka menutup pintu di belakangnya dan naik ke atas sotoh menara itu."
 },
 {
   "id": 6808,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 52,
   "firman": "Lalu sampailah Abimelekh ke menara itu, menyerangnya, dan dapat menerobos sampai ke pintu menara itu untuk membakarnya."
 },
 {
   "id": 6809,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 53,
   "firman": "Tetapi seorang perempuan menimpakan sebuah batu kilangan kepada kepala Abimelekh dan memecahkan batu kepalanya."
 },
 {
   "id": 6810,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 54,
   "firman": "Dengan segera dipanggilnya bujang pembawa senjatanya dan berkata kepadanya: \"Hunuslah pedangmu dan bunuhlah aku, supaya jangan orang berkata tentang aku: Seorang perempuan membunuh dia.\" Lalu bujangnya itu menikam dia, sehingga mati."
 },
 {
   "id": 6811,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 55,
   "firman": "Setelah dilihat oleh orang Israel, bahwa Abimelekh telah mati, pergilah mereka, masing-masing ke tempat kediamannya."
 },
 {
   "id": 6812,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 56,
   "firman": "Demikianlah Allah membalaskan kejahatan yang dilakukan oleh Abimelekh kepada ayahnya, yaitu pembunuhan atas ketujuh puluh saudaranya;"
 },
 {
   "id": 6813,
   "kitab": "Hak",
   "pasal": 9,
   "ayat": 57,
   "firman": "juga segala kejahatan orang-orang Sikhem ditimpakan kembali oleh Allah kepada kepala mereka sendiri. Demikianlah kutuk Yotam bin Yerubaal mengenai mereka."
 },
 {
   "id": 6814,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 1,
   "firman": "Sesudah Abimelekh, bangkitlah Tola bin Pua bin Dodo, seorang Isakhar, untuk menyelamatkan orang Israel. Ia diam di Samir, di pegunungan Efraim"
 },
 {
   "id": 6815,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 2,
   "firman": "dan ia memerintah sebagai hakim atas orang Israel dua puluh tiga tahun lamanya; kemudian matilah ia, lalu dikuburkan di Samir."
 },
 {
   "id": 6816,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 3,
   "firman": "Sesudah dia, bangkitlah Yair, orang Gilead, yang memerintah sebagai hakim atas orang Israel dua puluh dua tahun lamanya."
 },
 {
   "id": 6817,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 4,
   "firman": "Ia mempunyai tiga puluh anak laki-laki, yang mengendarai tiga puluh ekor keledai jantan, dan mereka mempunyai tiga puluh kota, yang sampai sekarang disebutkan orang Hawot-Yair, di tanah Gilead."
 },
 {
   "id": 6818,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 5,
   "firman": "Lalu matilah Yair dan dikuburkan di Kamon."
 },
 {
   "id": 6819,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 6,
   "firman": "Orang Israel itu melakukan pula apa yang jahat di mata TUHAN; mereka beribadah kepada para Baal dan para Asytoret, kepada para allah orang Aram, para allah orang Sidon, para allah orang Moab, para allah bani Amon dan para allah orang Filistin, tetapi TUHAN ditinggalkan mereka dan kepada Dia mereka tidak beribadah."
 },
 {
   "id": 6820,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 7,
   "firman": "Lalu bangkitlah murka TUHAN terhadap orang Israel, dan Ia menyerahkan mereka ke dalam tangan orang Filistin dan bani Amon."
 },
 {
   "id": 6821,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 8,
   "firman": "Dalam tahun itu juga orang Israel ditindas dan diinjak mereka; delapan belas tahun lamanya mereka memperlakukan demikian semua orang Israel yang di seberang sungai Yordan di tanah orang Amori yang di Gilead."
 },
 {
   "id": 6822,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 9,
   "firman": "Dan bani Amonpun menyeberangi sungai Yordan untuk berperang melawan suku Yehuda, suku Benyamin dan keturunan Efraim, sehingga orang Israel sangat terdesak."
 },
 {
   "id": 6823,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 10,
   "firman": "Lalu berserulah orang Israel kepada TUHAN, katanya: \"Kami telah berbuat dosa terhadap Engkau, sebab kami telah meninggalkan Allah kami lalu beribadah kepada para Baal.\""
 },
 {
   "id": 6824,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 11,
   "firman": "Tetapi firman TUHAN kepada orang Israel: \"Bukankah Aku yang telah menyelamatkan kamu dari tangan orang Mesir, orang Amori, bani Amon, orang Filistin,"
 },
 {
   "id": 6825,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 12,
   "firman": "orang Sidon, suku Amalek dan suku Maon yang menindas kamu, ketika kamu berseru kepada-Ku?"
 },
 {
   "id": 6826,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 13,
   "firman": "Tetapi kamu telah meninggalkan Aku dan beribadah kepada allah lain; sebab itu Aku tidak akan menyelamatkan kamu lagi."
 },
 {
   "id": 6827,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 14,
   "firman": "Pergi sajalah berseru kepada para allah yang telah kamu pilih itu; biar merekalah yang menyelamatkan kamu, pada waktu kamu terdesak.\""
 },
 {
   "id": 6828,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kata orang Israel kepada TUHAN: \"Kami telah berbuat dosa. Lakukanlah kepada kami segala yang baik di mata-Mu. Hanya tolonglah kiranya kami sekarang ini!\""
 },
 {
   "id": 6829,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 16,
   "firman": "Dan mereka menjauhkan para allah asing dari tengah-tengah mereka, lalu mereka beribadah kepada TUHAN. Maka TUHAN tidak dapat lagi menahan hati-Nya melihat kesukaran mereka."
 },
 {
   "id": 6830,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 17,
   "firman": "Kemudian bani Amon dikerahkan dan berkemah di Gilead, sedang orang Israel berkumpul dan berkemah di Mizpa."
 },
 {
   "id": 6831,
   "kitab": "Hak",
   "pasal": 10,
   "ayat": 18,
   "firman": "Maka para pemimpin bangsa di Gilead berkata seorang kepada yang lain: \"Siapakah orang yang berani memulai peperangan melawan bani Amon itu? Dialah yang harus menjadi kepala atas seluruh penduduk Gilead.\""
 },
 {
   "id": 6832,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 1,
   "firman": "Adapun Yefta, orang Gilead itu, adalah seorang pahlawan yang gagah perkasa, tetapi ia anak seorang perempuan sundal; ayah Yefta ialah Gilead."
 },
 {
   "id": 6833,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 2,
   "firman": "Juga isteri Gilead melahirkan anak-anak lelaki baginya. Setelah besar anak-anak isterinya ini, maka mereka mengusir Yefta, katanya kepadanya: \"Engkau tidak mendapat milik pusaka dalam keluarga kami, sebab engkau anak dari perempuan lain.\""
 },
 {
   "id": 6834,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 3,
   "firman": "Maka larilah Yefta dari saudara-saudaranya itu dan diam di tanah Tob; di sana berkumpullah kepadanya petualang-petualang yang pergi merampok bersama-sama dengan dia."
 },
 {
   "id": 6835,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 4,
   "firman": "Beberapa waktu kemudian bani Amon berperang melawan orang Israel."
 },
 {
   "id": 6836,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 5,
   "firman": "Dan ketika bani Amon itu berperang melawan orang Israel, pergilah para tua-tua Gilead menjemput Yefta dari tanah Tob."
 },
 {
   "id": 6837,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 6,
   "firman": "Kata mereka kepada Yefta: \"Mari, jadilah panglima kami dan biarlah kita berperang melawan bani Amon.\""
 },
 {
   "id": 6838,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 7,
   "firman": "Tetapi kata Yefta kepada para tua-tua Gilead itu: \"Bukankah kamu sendiri membenci aku dan mengusir aku dari keluargaku? Mengapa kamu datang sekarang kepadaku, pada waktu kamu terdesak?\""
 },
 {
   "id": 6839,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 8,
   "firman": "Kemudian berkatalah para tua-tua Gilead kepada Yefta: \"Memang, kami datang kembali sekarang kepadamu, ikutilah kami dan berperanglah melawan bani Amon, maka engkau akan menjadi kepala atas kami, atas seluruh penduduk Gilead.\""
 },
 {
   "id": 6840,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 9,
   "firman": "Kata Yefta kepada para tua-tua Gilead: \"Jadi, jika kamu membawa aku kembali untuk berperang melawan bani Amon, dan TUHAN menyerahkan mereka kepadaku, maka akulah yang akan menjadi kepala atas kamu?\""
 },
 {
   "id": 6841,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 10,
   "firman": "Lalu kata para tua-tua Gilead kepada Yefta: \"Demi TUHAN yang mendengarkannya sebagai saksi antara kita: Kami akan berbuat seperti katamu itu.\""
 },
 {
   "id": 6842,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 11,
   "firman": "Maka Yefta ikut dengan para tua-tua Gilead, lalu bangsa itu mengangkat dia menjadi kepala dan panglima mereka. Tetapi Yefta membawa seluruh perkaranya itu ke hadapan TUHAN, di Mizpa."
 },
 {
   "id": 6843,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 12,
   "firman": "Kemudian Yefta mengirim utusan kepada raja bani Amon dengan pesan: \"Apakah urusanmu dengan aku, sehingga engkau mendatangi aku untuk memerangi negeriku?\""
 },
 {
   "id": 6844,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 13,
   "firman": "Jawab raja bani Amon kepada utusan Yefta: \"Orang Israel, ketika berjalan keluar dari Mesir, telah merampas tanahku, dari sungai Arnon sampai ke sungai Yabok dan sampai ke sungai Yordan. Maka sekarang, kembalikanlah semuanya itu dengan jalan damai.\""
 },
 {
   "id": 6845,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 14,
   "firman": "Lalu Yefta mengirim pula utusan kepada raja bani Amon"
 },
 {
   "id": 6846,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 15,
   "firman": "dengan pesan: \"Beginilah kata Yefta: orang Israel tidak merampas tanah orang Moab atau tanah bani Amon."
 },
 {
   "id": 6847,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 16,
   "firman": "Sebab ketika berjalan keluar dari Mesir, orang Israel melalui padang gurun sampai ke Laut Teberau dan tiba di Kadesh."
 },
 {
   "id": 6848,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 17,
   "firman": "Ketika itu orang Israel mengirim utusan kepada raja negeri Edom dengan permintaan: Izinkanlah kiranya kami berjalan melalui negerimu ini. Tetapi raja negeri Edom tidak mau mendengar. Mereka mengirim juga utusan kepada raja negeri Moab, tetapi raja ini menolak. Maka orang Israel tinggal di Kadesh."
 },
 {
   "id": 6849,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 18,
   "firman": "Kemudian mereka berjalan melalui padang gurun, menempuh jalan keliling tanah Edom dan tanah Moab, lalu sampai ke sebelah timur tanah Moab, maka berkemahlah mereka di seberang sungai Arnon, dengan tidak masuk daerah Moab, sebab sungai Arnon itulah batas daerah Moab."
 },
 {
   "id": 6850,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 19,
   "firman": "Lalu orang Israel mengirim utusan kepada Sihon, raja orang Amori, raja di Hesybon, dan orang Israel meminta kepadanya: Izinkanlah kiranya kami berjalan melalui negerimu ini sampai ke tempat yang kami tuju."
 },
 {
   "id": 6851,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 20,
   "firman": "Tetapi Sihon tidak percaya kepada orang Israel yang hendak berjalan melalui daerahnya itu, maka dikumpulkannyalah seluruh rakyatnya. Ia berkemah di Yahas, lalu berperang melawan orang Israel."
 },
 {
   "id": 6852,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 21,
   "firman": "Tetapi TUHAN, Allah Israel, menyerahkan Sihon dengan seluruh rakyatnya ke dalam tangan orang Israel, dan mereka dikalahkan, sehingga orang Israel menduduki seluruh negeri kepunyaan orang Amori, penduduk negeri itu."
 },
 {
   "id": 6853,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 22,
   "firman": "Demikianlah dimiliki orang Israel seluruh daerah orang Amori itu, dari sungai Arnon sampai ke sungai Yabok dan dari padang gurun sampai ke sungai Yordan."
 },
 {
   "id": 6854,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 23,
   "firman": "Maka sekarang TUHAN, Allah Israel, telah merebut milik orang Amori, bagi Israel, umat-Nya. Apakah engkau hendak memiliki pula tanah mereka itu?"
 },
 {
   "id": 6855,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 24,
   "firman": "Bukankah engkau akan memiliki apa yang diberi oleh Kamos, allahmu? Demikianlah kami memiliki segala yang direbut bagi kami oleh TUHAN, Allah kami."
 },
 {
   "id": 6856,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 25,
   "firman": "Lagipula, apakah engkau lebih baik dari Balak bin Zipor, raja Moab? Pernahkah ia menuntut hak kepada orang Israel atau pernahkah ia berperang melawan mereka?"
 },
 {
   "id": 6857,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 26,
   "firman": "Ketika orang Israel diam di Hesybon dengan segala anak kotanya, di Aroer dengan segala anak kotanya, dan di segala kota sepanjang kedua tepi sungai Arnon selama tiga ratus tahun, mengapa pada waktu itu engkau tidak melepaskan kota-kota itu?"
 },
 {
   "id": 6858,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 27,
   "firman": "Jadi aku tidak bersalah terhadap engkau, tetapi engkau berbuat jahat terhadap aku dengan berperang melawan aku. TUHAN, Hakim itu, Dialah yang menjadi hakim pada hari ini antara orang Israel dan bani Amon.\""
 },
 {
   "id": 6859,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 28,
   "firman": "Tetapi raja bani Amon tidak mendengarkan perkataan yang disampaikan kepadanya oleh utusan-utusan Yefta."
 },
 {
   "id": 6860,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 29,
   "firman": "Lalu Roh TUHAN menghinggapi Yefta; ia berjalan melalui daerah Gilead dan daerah Manasye, kemudian melalui Mizpa di Gilead, dan dari Mizpa di Gilead ia berjalan terus ke daerah bani Amon."
 },
 {
   "id": 6861,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 30,
   "firman": "Lalu bernazarlah Yefta kepada TUHAN, katanya: \"Jika Engkau sungguh-sungguh menyerahkan bani Amon itu ke dalam tanganku,"
 },
 {
   "id": 6862,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 31,
   "firman": "maka apa yang keluar dari pintu rumahku untuk menemui aku, pada waktu aku kembali dengan selamat dari bani Amon, itu akan menjadi kepunyaan TUHAN, dan aku akan mempersembahkannya sebagai korban bakaran.\""
 },
 {
   "id": 6863,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 32,
   "firman": "Kemudian Yefta berjalan terus untuk berperang melawan bani Amon, dan TUHAN menyerahkan mereka ke dalam tangannya."
 },
 {
   "id": 6864,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 33,
   "firman": "Ia menimbulkan kekalahan yang amat besar di antara mereka, mulai dari Aroer sampai dekat Minit--dua puluh kota banyaknya--dan sampai ke Abel-Keramim, sehingga bani Amon itu ditundukkan di depan orang Israel."
 },
 {
   "id": 6865,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 34,
   "firman": "Ketika Yefta pulang ke Mizpa ke rumahnya, tampaklah anaknya perempuan keluar menyongsong dia dengan memukul rebana serta menari-nari. Dialah anaknya yang tunggal; selain dari dia tidak ada anaknya laki-laki atau perempuan."
 },
 {
   "id": 6866,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 35,
   "firman": "Demi dilihatnya dia, dikoyakkannyalah bajunya, sambil berkata: \"Ah, anakku, engkau membuat hatiku hancur luluh dan engkaulah yang mencelakakan aku; aku telah membuka mulutku bernazar kepada TUHAN, dan tidak dapat aku mundur.\""
 },
 {
   "id": 6867,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 36,
   "firman": "Tetapi jawabnya kepadanya: \"Bapa, jika engkau telah membuka mulutmu bernazar kepada TUHAN, maka perbuatlah kepadaku sesuai dengan nazar yang kauucapkan itu, karena TUHAN telah mengadakan bagimu pembalasan terhadap musuhmu, yakni bani Amon itu.\""
 },
 {
   "id": 6868,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 37,
   "firman": "Lagi katanya kepada ayahnya: \"Hanya izinkanlah aku melakukan hal ini: berilah keluasan kepadaku dua bulan lamanya, supaya aku pergi mengembara ke pegunungan dan menangisi kegadisanku bersama-sama dengan teman-temanku.\""
 },
 {
   "id": 6869,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 38,
   "firman": "Jawab Yefta: \"Pergilah,\" dan ia membiarkan dia pergi dua bulan lamanya. Maka pergilah gadis itu bersama-sama dengan teman-temannya menangisi kegadisannya di pegunungan."
 },
 {
   "id": 6870,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 39,
   "firman": "Setelah lewat kedua bulan itu, kembalilah ia kepada ayahnya, dan ayahnya melakukan kepadanya apa yang telah dinazarkannya itu; jadi gadis itu tidak pernah kenal laki-laki. Dan telah menjadi adat di Israel,"
 },
 {
   "id": 6871,
   "kitab": "Hak",
   "pasal": 11,
   "ayat": 40,
   "firman": "bahwa dari tahun ke tahun anak-anak perempuan orang Israel selama empat hari setahun meratapi anak perempuan Yefta, orang Gilead itu."
 },
 {
   "id": 6872,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 1,
   "firman": "Dikerahkanlah orang Efraim, lalu mereka bergerak ke Zafon. Dan mereka berkata kepada Yefta: \"Mengapa engkau bergerak untuk memerangi bani Amon dengan tidak memanggil kami untuk maju bersama-sama dengan engkau? Sebab itu kami akan membakar rumahmu bersama-sama kamu!\""
 },
 {
   "id": 6873,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 2,
   "firman": "Tetapi jawab Yefta kepada mereka: \"Aku dan rakyatku telah terlibat dalam peperangan yang hebat dengan bani Amon; lalu aku memanggil kamu, tetapi kamu tidak datang menyelamatkan aku dari tangan mereka."
 },
 {
   "id": 6874,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 3,
   "firman": "Ketika kulihat, bahwa tidak ada yang datang menyelamatkan aku, maka aku mempertaruhkan nyawaku dan aku pergi melawan bani Amon itu, dan TUHAN menyerahkan mereka ke dalam tanganku. Mengapa pada hari ini kamu mendatangi aku untuk berperang melawan aku?\""
 },
 {
   "id": 6875,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 4,
   "firman": "Kemudian Yefta mengumpulkan semua orang Gilead, lalu mereka berperang melawan suku Efraim. Dan orang-orang Gilead mengalahkan suku Efraim itu. Sebab orang-orang itu mengatakan: \"Kamulah orang-orang yang telah lari dari suku Efraim!\" --kaum Gilead itu ada di tengah-tengah suku Efraim dan suku Manasye--."
 },
 {
   "id": 6876,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 5,
   "firman": "Untuk menghadapi suku Efraim itu, maka orang Gilead menduduki tempat-tempat penyeberangan sungai Yordan. Apabila dari suku Efraim ada yang lari dan berkata: \"Biarkanlah aku menyeberang,\" maka orang Gilead berkata kepadanya: \"Orang Efraimkah engkau?\" Dan jika ia menjawab: \"Bukan,\""
 },
 {
   "id": 6877,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 6,
   "firman": "maka mereka berkata kepadanya: \"Coba katakan dahulu: syibolet.\" Jika ia berkata: sibolet, jadi tidak dapat mengucapkannya dengan tepat, maka mereka menangkap dia dan menyembelihnya dekat tempat-tempat penyeberangan sungai Yordan itu. Pada waktu itu tewaslah dari suku Efraim empat puluh dua ribu orang."
 },
 {
   "id": 6878,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 7,
   "firman": "Yefta memerintah sebagai hakim atas orang Israel enam tahun lamanya. Kemudian matilah Yefta, orang Gilead itu, lalu dikuburkan di sebuah kota di daerah Gilead."
 },
 {
   "id": 6879,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 8,
   "firman": "Sesudah dia, maka Ebzan dari Betlehem memerintah sebagai hakim atas orang Israel."
 },
 {
   "id": 6880,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 9,
   "firman": "Ia mempunyai tiga puluh anak laki-laki. Tiga puluh anaknya perempuan dikawinkannya ke luar kaumnya dan tiga puluh anak perempuan diambilnya dari luar kaumnya untuk anak-anaknya lelaki itu. Ia memerintah atas orang Israel tujuh tahun lamanya."
 },
 {
   "id": 6881,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 10,
   "firman": "Kemudian matilah Ebzan, lalu dikuburkan di Betlehem."
 },
 {
   "id": 6882,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 11,
   "firman": "Sesudah dia, maka Elon orang Zebulon memerintah sebagai hakim atas orang Israel. Ia memerintah atas orang Israel sepuluh tahun lamanya."
 },
 {
   "id": 6883,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 12,
   "firman": "Kemudian matilah Elon, orang Zebulon itu, lalu dikuburkan di Ayalon, di tanah Zebulon."
 },
 {
   "id": 6884,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 13,
   "firman": "Sesudah dia, maka Abdon bin Hilel, orang Piraton, memerintah sebagai hakim atas orang Israel."
 },
 {
   "id": 6885,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 14,
   "firman": "Ia mempunyai empat puluh anak laki-laki dan tiga puluh cucu laki-laki, yang mengendarai tujuh puluh ekor keledai jantan. Ia memerintah atas orang Israel delapan tahun lamanya."
 },
 {
   "id": 6886,
   "kitab": "Hak",
   "pasal": 12,
   "ayat": 15,
   "firman": "Kemudian matilah Abdon bin Hilel, orang Piraton itu, lalu dikuburkan di Piraton, di tanah Efraim, di pegunungan orang Amalek."
 },
 {
   "id": 6887,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 1,
   "firman": "Orang Israel melakukan pula apa yang jahat di mata TUHAN; sebab itu TUHAN menyerahkan mereka ke dalam tangan orang Filistin empat puluh tahun lamanya."
 },
 {
   "id": 6888,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 2,
   "firman": "Pada waktu itu ada seorang dari Zora, dari keturunan orang Dan, namanya Manoah; isterinya mandul, tidak beranak."
 },
 {
   "id": 6889,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 3,
   "firman": "Dan Malaikat TUHAN menampakkan diri kepada perempuan itu dan berfirman kepadanya, demikian: \"Memang engkau mandul, tidak beranak, tetapi engkau akan mengandung dan melahirkan seorang anak laki-laki."
 },
 {
   "id": 6890,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 4,
   "firman": "Oleh sebab itu, peliharalah dirimu, jangan minum anggur atau minuman yang memabukkan dan jangan makan sesuatu yang haram."
 },
 {
   "id": 6891,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 5,
   "firman": "Sebab engkau akan mengandung dan melahirkan seorang anak laki-laki; kepalanya takkan kena pisau cukur, sebab sejak dari kandungan ibunya anak itu akan menjadi seorang nazir Allah dan dengan dia akan mulai penyelamatan orang Israel dari tangan orang Filistin.\""
 },
 {
   "id": 6892,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 6,
   "firman": "Kemudian perempuan itu datang kepada suaminya dan berkata: \"Telah datang kepadaku seorang abdi Allah, yang rupanya sebagai rupa malaikat Allah, amat menakutkan. Tidak kutanyakan dari mana datangnya, dan tidak juga diberitahukannya namanya kepadaku."
 },
 {
   "id": 6893,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 7,
   "firman": "Tetapi ia berkata kepadaku: Engkau akan mengandung dan melahirkan seorang anak laki-laki; oleh sebab itu janganlah minum anggur atau minuman yang memabukkan dan janganlah makan sesuatu yang haram, sebab sejak dari kandungan ibunya sampai pada hari matinya, anak itu akan menjadi seorang nazir Allah.\""
 },
 {
   "id": 6894,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 8,
   "firman": "Lalu Manoah memohon kepada TUHAN, katanya: \"Ya Tuhan, berilah kiranya abdi Allah, yang Kauutus itu, datang pula kepada kami dan mengajar kami, apa yang harus kami perbuat kepada anak yang akan lahir itu.\""
 },
 {
   "id": 6895,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 9,
   "firman": "Maka Allah mendengarkan permohonan Manoah, sehingga Malaikat Allah datang pula kepada perempuan itu, ketika ia duduk di padang dan ketika Manoah, suaminya itu, tidak ada bersama-sama dengan dia."
 },
 {
   "id": 6896,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kemudian perempuan itu segera berlari memberitahukan kepada suaminya, katanya kepadanya: \"Orang yang datang kepadaku baru-baru ini menampakkan diri pula kepadaku.\""
 },
 {
   "id": 6897,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 11,
   "firman": "Lalu bangunlah Manoah dan mengikuti isterinya. Setelah sampai kepada orang itu, berkatalah ia kepadanya: \"Engkaukah orang yang telah berbicara kepada perempuan ini?\" Jawabnya: \"Benar!\""
 },
 {
   "id": 6898,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 12,
   "firman": "Lalu kata Manoah: \"Dan apabila terjadi yang Kaukatakan itu, bagaimanakah nanti cara hidup anak itu dan tingkah lakunya?\""
 },
 {
   "id": 6899,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 13,
   "firman": "Jawab Malaikat TUHAN itu kepada Manoah: \"Perempuan itu harus memelihara diri terhadap semua yang Kukatakan kepadanya."
 },
 {
   "id": 6900,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 14,
   "firman": "Janganlah ia makan sesuatu yang berasal dari pohon anggur; anggur atau minuman yang memabukkan tidak boleh diminumnya dan sesuatu yang haram tidak boleh dimakannya. Ia harus berpegang pada segala yang Kuperintahkan kepadanya.\""
 },
 {
   "id": 6901,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 15,
   "firman": "Kata Manoah kepada Malaikat TUHAN itu: \"Perkenankanlah kami menahan Engkau di sini, supaya kami mengolah anak kambing bagi-Mu.\""
 },
 {
   "id": 6902,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 16,
   "firman": "Tetapi jawab Malaikat TUHAN itu kepada Manoah: \"Sekalipun engkau menahan Aku di sini, hidanganmu itu tidak akan Kumakan. Tetapi jika engkau hendak mengolahnya menjadi korban bakaran, persembahkanlah itu kepada TUHAN.\" Sebab Manoah tidak mengetahui, bahwa Dia itu Malaikat TUHAN."
 },
 {
   "id": 6903,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 17,
   "firman": "Kemudian berkatalah Manoah kepada Malaikat TUHAN itu: \"Siapakah nama-Mu, sebab apabila terjadi yang Kaukatakan itu, maka kami hendak memuliakan Engkau.\""
 },
 {
   "id": 6904,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 18,
   "firman": "Tetapi jawab malaikat TUHAN itu kepadanya: \"Mengapa engkau juga menanyakan nama-Ku? Bukankah nama itu ajaib?\""
 },
 {
   "id": 6905,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 19,
   "firman": "Sesudah itu Manoah mengambil seekor anak kambing dan korban sajian, lalu mempersembahkannya kepada TUHAN di atas batu. Lalu diperbuat-Nya keajaiban, sementara Manoah dan isterinya memandanginya."
 },
 {
   "id": 6906,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 20,
   "firman": "Sedang nyala api itu naik ke langit dari mezbah, maka naiklah Malaikat TUHAN dalam nyala api mezbah itu. Ketika Manoah dan isterinya melihat hal ini, sujudlah mereka dengan mukanya sampai ke tanah."
 },
 {
   "id": 6907,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 21,
   "firman": "Sejak itu Malaikat TUHAN tidak lagi menampakkan diri kepada Manoah dan isterinya. Maka tahulah Manoah, bahwa Dia itu Malaikat TUHAN."
 },
 {
   "id": 6908,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 22,
   "firman": "Berkatalah Manoah kepada isterinya: \"Kita pasti mati, sebab kita telah melihat Allah.\""
 },
 {
   "id": 6909,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 23,
   "firman": "Tetapi jawab isterinya kepadanya: \"Seandainya TUHAN hendak membunuh kita, maka tidaklah Ia menerima korban bakaran dan korban sajian dari tangan kita dan tidaklah Ia memperlihatkan semuanya itu kepada kita dan tidaklah Ia memperdengarkan hal-hal yang demikian kepada kita pada waktu sekarang ini.\""
 },
 {
   "id": 6910,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 24,
   "firman": "Lalu perempuan itu melahirkan seorang anak laki-laki dan memberi nama Simson kepadanya. Anak itu menjadi besar dan TUHAN memberkati dia."
 },
 {
   "id": 6911,
   "kitab": "Hak",
   "pasal": 13,
   "ayat": 25,
   "firman": "Mulailah hatinya digerakkan oleh Roh TUHAN di Mahane-Dan yang terletak di antara Zora dan Esytaol."
 },
 {
   "id": 6912,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 1,
   "firman": "Simson pergi ke Timna dan di situ ia melihat seorang gadis Filistin."
 },
 {
   "id": 6913,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 2,
   "firman": "Ia pulang dan memberitahukan kepada ayahnya dan ibunya: \"Di Timna aku melihat seorang gadis Filistin. Tolong, ambillah dia menjadi isteriku.\""
 },
 {
   "id": 6914,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 3,
   "firman": "Tetapi ayahnya dan ibunya berkata kepadanya: \"Tidak adakah di antara anak-anak perempuan sanak saudaramu atau di antara seluruh bangsa kita seorang perempuan, sehingga engkau pergi mengambil isteri dari orang Filistin, orang-orang yang tidak bersunat itu?\" Tetapi jawab Simson kepada ayahnya: \"Ambillah dia bagiku, sebab dia kusukai.\""
 },
 {
   "id": 6915,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 4,
   "firman": "Tetapi ayahnya dan ibunya tidak tahu bahwa hal itu dari pada TUHAN asalnya: sebab memang Simson harus mencari gara-gara terhadap orang Filistin. Karena pada masa itu orang Filistin menguasai orang Israel."
 },
 {
   "id": 6916,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 5,
   "firman": "Lalu pergilah Simson beserta ayahnya dan ibunya ke Timna. Ketika mereka sampai ke kebun-kebun anggur di Timna, maka seekor singa muda mendatangi Simson dengan mengaum."
 },
 {
   "id": 6917,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 6,
   "firman": "Pada waktu itu berkuasalah Roh TUHAN atas dia, sehingga singa itu dicabiknya seperti orang mencabik anak kambing--tanpa apa-apa di tangannya. Tetapi tidak diceriterakannya kepada ayahnya atau ibunya apa yang dilakukannya itu."
 },
 {
   "id": 6918,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 7,
   "firman": "Maka pergilah ia ke sana, lalu bercakap-cakap dengan perempuan itu, sebab Simson suka kepadanya."
 },
 {
   "id": 6919,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 8,
   "firman": "Setelah beberapa waktu kembalilah ia ke sana untuk kawin dengan perempuan itu; dan ketika ia menyimpang dari jalan untuk melihat bangkai singa itu, tampaklah ada kawanan lebah pada kerangka singa itu dan juga madu."
 },
 {
   "id": 6920,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 9,
   "firman": "Dikeruknya madu itu ke dalam tangannya dan sambil memakannya ia berjalan terus, kemudian pergilah ia kepada ayahnya dan ibunya, dan memberikannya juga kepada mereka, lalu mereka memakannya. Tetapi tidak diceriterakannya kepada mereka, bahwa madu itu dikeruknya dari kerangka singa."
 },
 {
   "id": 6921,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 10,
   "firman": "Setelah ayahnya pergi kepada perempuan itu, Simson mengadakan perjamuan di sana, sebab demikianlah biasanya dilakukan orang-orang muda."
 },
 {
   "id": 6922,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 11,
   "firman": "Ketika mereka melihat dia, dipilihlah tiga puluh orang kawan untuk menemani dia."
 },
 {
   "id": 6923,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 12,
   "firman": "Kata Simson kepada mereka: \"Aku mau mengatakan suatu teka-teki kepada kamu. Jika kamu dapat memberi jawabnya yang tepat kepadaku dalam tujuh hari selama perjamuan ini berlangsung dan menebaknya, maka aku akan memberikan kepadamu tiga puluh pakaian lenan dan tiga puluh pakaian kebesaran."
 },
 {
   "id": 6924,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 13,
   "firman": "Tetapi jika kamu tidak dapat memberi jawabnya kepadaku, maka kamulah yang harus memberikan tiga puluh pakaian dalam dan tiga puluh pakaian kebesaran kepadaku.\" Kata mereka kepadanya: \"Katakanlah teka-tekimu itu, supaya kami dengar.\""
 },
 {
   "id": 6925,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 14,
   "firman": "Lalu katanya kepada mereka: \"Dari yang makan keluar makanan, dari yang kuat keluar manisan.\" Ada tiga hari lamanya mereka tidak dapat memberi jawab teka-teki itu."
 },
 {
   "id": 6926,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 15,
   "firman": "Pada hari ketujuh berkatalah mereka kepada isteri Simson: \"Bujuklah suamimu, supaya diberitahukannya kepada kami jawab teka-teki itu; kalau tidak, kami akan membakar engkau beserta seisi rumah ayahmu. Apakah engkau mengundang kami untuk membuat kami menjadi miskin? Tidak, bukan?\""
 },
 {
   "id": 6927,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 16,
   "firman": "Lalu menangislah isteri Simson itu sambil memeluk Simson, katanya: \"Engkau benci saja kepadaku, dan tidak cinta kepadaku; suatu teka-teki kaukatakan kepada orang-orang sebangsaku, tetapi jawabnya tidak kauberitahukan kepadaku.\" Sahutnya kepadanya: \"Sedangkan kepada ayahku dan ibuku tidak kuberitahukan, masakan kepada engkau akan kuberitahukan?\""
 },
 {
   "id": 6928,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 17,
   "firman": "Tetapi isterinya itu menangis di sampingnya selama ketujuh hari mereka mengadakan perjamuan itu. Pada hari yang ketujuh diberitahukannyalah kepadanya, karena ia merengek-rengek kepadanya, kemudian perempuan itu memberitahukan jawab teka-teki itu kepada orang-orang sebangsanya."
 },
 {
   "id": 6929,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 18,
   "firman": "Lalu pada hari yang ketujuh itu, sebelum matahari terbenam, berkatalah orang-orang kota itu kepadanya: \"Apakah yang lebih manis dari pada madu? Apakah yang lebih kuat dari pada singa?\" Sahutnya kepada mereka: \"Kalau kamu tidak membajak dengan lembu betinaku, pasti kamu tidak menebak teka-tekiku.\""
 },
 {
   "id": 6930,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 19,
   "firman": "Maka berkuasalah Roh TUHAN atas dia, lalu pergilah ia ke Askelon dan dibunuhnya tiga puluh orang di sana, diambilnya pakaian mereka dan diberikannya pakaian-pakaian kebesaran itu kepada orang-orang yang dapat memberi jawab teka-teki itu. Tetapi amarahnya masih juga bernyala-nyala, lalu pulanglah ia ke rumah ayahnya."
 },
 {
   "id": 6931,
   "kitab": "Hak",
   "pasal": 14,
   "ayat": 20,
   "firman": "Maka diberikanlah isteri Simson itu kepada kawannya, bekas pengiringnya."
 },
 {
   "id": 6932,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 1,
   "firman": "Beberapa waktu kemudian, dalam musim menuai gandum, pergilah Simson mengunjungi isterinya, dengan membawa seekor anak kambing, serta berkata: \"Aku mau ke kamar mendapatkan isteriku.\" Tetapi ayah perempuan itu tidak membiarkan dia masuk."
 },
 {
   "id": 6933,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 2,
   "firman": "Kata ayah perempuan itu: \"Aku telah menyangka, bahwa engkau benci sama sekali kepadanya, sebab itu aku memberikannya kepada kawanmu. Bukankah adiknya lebih cantik dari padanya? Baiklah kauambil itu bagimu sebagai gantinya.\""
 },
 {
   "id": 6934,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 3,
   "firman": "Lalu kata Simson kepadanya: \"Sekali ini aku tidak bersalah terhadap orang Filistin, apabila aku mendatangkan celaka kepada mereka.\""
 },
 {
   "id": 6935,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 4,
   "firman": "Maka pergilah Simson, ditangkapnya tiga ratus anjing hutan, diambilnya obor, diikatnya ekor dengan ekor dan ditaruhnya sebuah obor di antara tiap-tiap dua ekor."
 },
 {
   "id": 6936,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 5,
   "firman": "Kemudian dinyalakannyalah obor itu dan dilepaskannya anjing-anjing hutan itu ke gandum yang belum dituai kepunyaan orang Filistin, sehingga terbakarlah tumpukan-tumpukan gandum dan gandum yang belum dituai dan kebun-kebun pohon zaitun."
 },
 {
   "id": 6937,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 6,
   "firman": "Berkatalah orang Filistin: \"Siapakah yang melakukan ini?\" Orang menjawab: \"Simson, menantu orang Timna itu, sebab orang itu telah mengambil isteri Simson dan memberikannya kepada kawannya.\" Kemudian pergilah orang Filistin ke sana dan membakar perempuan itu beserta ayahnya."
 },
 {
   "id": 6938,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 7,
   "firman": "Lalu berkatalah Simson kepada mereka: \"Jika kamu berbuat demikian, sesungguhnya aku takkan berhenti sebelum aku membalaskannya kepada kamu.\""
 },
 {
   "id": 6939,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dan dengan pukulan yang hebat ia meremukkan tulang-tulang mereka. Lalu pergilah ia dan tinggal dalam gua di bukit batu Etam."
 },
 {
   "id": 6940,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 9,
   "firman": "Lalu majulah orang Filistin dan berkemah di daerah Yehuda serta memencar ke Lehi."
 },
 {
   "id": 6941,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 10,
   "firman": "Berkatalah orang-orang Yehuda: \"Mengapa kamu maju menyerang kami?\" Lalu jawab mereka: \"Kami maju untuk mengikat Simson dan memperlakukan dia seperti dia memperlakukan kami.\""
 },
 {
   "id": 6942,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 11,
   "firman": "Kemudian turunlah tiga ribu orang dari suku Yehuda ke gua di gunung batu Etam dan berkata kepada Simson: \"Tidakkah kauketahui, bahwa orang Filistin berkuasa atas kita? Apakah juga yang telah kauperbuat terhadap kami?\" Tetapi jawabnya kepada mereka: \"Seperti mereka memperlakukan aku, demikianlah aku memperlakukan mereka.\""
 },
 {
   "id": 6943,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 12,
   "firman": "Kata mereka kepadanya: \"Kami datang ke sini untuk mengikat dan menyerahkan engkau ke dalam tangan orang Filistin.\" Tetapi jawab Simson kepada mereka: \"Bersumpahlah kepadaku, bahwa kamu sendiri tidak akan menyerang aku.\""
 },
 {
   "id": 6944,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 13,
   "firman": "Lalu kata mereka kepadanya: \"Tidak, kami hanya mau mengikat engkau dan menyerahkan engkau ke dalam tangan mereka, tetapi membunuh engkau kami tidak mau.\" Maka mereka mengikat dia dengan dua tali baru dan membawa dia dari bukit batu itu."
 },
 {
   "id": 6945,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 14,
   "firman": "Setelah ia sampai ke Lehi dan orang-orang Filistin mendatangi dia dengan bersorak-sorak, maka berkuasalah Roh TUHAN atas dia dan tali-tali pada tangannya menjadi seperti batang rami yang telah habis dimakan api dan segala pengikatnya hancur tanggal dari tangannya."
 },
 {
   "id": 6946,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 15,
   "firman": "Kemudian ia menemui sebuah tulang rahang keledai yang masih baru, diulurkannya tangannya, dipungutnya dan dipukulnya mati seribu orang dengan tulang itu."
 },
 {
   "id": 6947,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 16,
   "firman": "Berkatalah Simson: \"Dengan rahang keledai bangsa keledai itu kuhajar, dengan rahang keledai seribu orang kupukul.\""
 },
 {
   "id": 6948,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 17,
   "firman": "Setelah berkata demikian, dilemparnya tulang rahang itu dari tangannya. Kemudian dinamailah tempat itu Ramat Lehi."
 },
 {
   "id": 6949,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 18,
   "firman": "Ketika ia sangat haus, berserulah ia kepada TUHAN: \"Oleh tangan hamba-Mu ini telah Kauberikan kemenangan yang besar itu, masakan sekarang aku akan mati kehausan dan jatuh ke dalam tangan orang-orang yang tidak bersunat itu!\""
 },
 {
   "id": 6950,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 19,
   "firman": "Kemudian Allah membelah liang batu yang di Lehi itu, dan keluarlah air dari situ. Ia minum, lalu menjadi kuat dan segar kembali. Sebab itu dinamailah mata air itu Mata Air Penyeru, yang sampai sekarang masih ada di Lehi."
 },
 {
   "id": 6951,
   "kitab": "Hak",
   "pasal": 15,
   "ayat": 20,
   "firman": "Ia memerintah sebagai hakim atas orang Israel dalam zaman orang Filistin, dua puluh tahun lamanya."
 },
 {
   "id": 6952,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 1,
   "firman": "Pada suatu kali, ketika Simson pergi ke Gaza, dilihatnya di sana seorang perempuan sundal, lalu menghampiri dia."
 },
 {
   "id": 6953,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 2,
   "firman": "Ketika diberitahukan kepada orang-orang Gaza: \"Simson telah datang ke sini,\" maka mereka mengepung tempat itu dan siap menghadang dia semalam-malaman itu di pintu gerbang kota, tetapi semalam-malaman itu mereka tidak berbuat apa-apa, karena pikirnya: \"Nanti pada waktu fajar kita akan membunuh dia.\""
 },
 {
   "id": 6954,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 3,
   "firman": "Tetapi Simson tidur di situ sampai tengah malam. Pada waktu tengah malam bangunlah ia, dipegangnya kedua daun pintu gerbang kota itu dan kedua tiang pintu, dicabutnyalah semuanya beserta palangnya, diletakkannya di atas kedua bahunya, lalu semuanya itu diangkatnya ke puncak gunung yang berhadapan dengan Hebron."
 },
 {
   "id": 6955,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 4,
   "firman": "Sesudah itu Simson jatuh cinta kepada seorang perempuan dari lembah Sorek yang namanya Delila."
 },
 {
   "id": 6956,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 5,
   "firman": "Lalu datanglah raja-raja kota orang Filistin kepada perempuan itu sambil berkata: \"Cobalah bujuk dia untuk mengetahui karena apakah kekuatannya demikian besar, dan dengan apakah kami dapat mengalahkan dia dan mengikat dia untuk menundukkannya. Maka kami masing-masing akan memberikan seribu seratus uang perak kepadamu.\""
 },
 {
   "id": 6957,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 6,
   "firman": "Lalu berkatalah Delila kepada Simson: \"Ceritakanlah kiranya kepadaku, karena apakah kekuatanmu demikian besar, dan dengan apakah engkau harus diikat untuk ditundukkan?\""
 },
 {
   "id": 6958,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 7,
   "firman": "Jawab Simson kepadanya: \"Jika aku diikat dengan tujuh tali busur yang baru, yang belum kering, maka aku akan menjadi lemah dan menjadi seperti orang lain manapun juga.\""
 },
 {
   "id": 6959,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lalu raja-raja kota orang Filistin membawa tujuh tali busur yang baru yang belum kering kepada perempuan itu dan ia mengikat Simson dengan tali-tali itu,"
 },
 {
   "id": 6960,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 9,
   "firman": "sedang di kamarnya ada orang bersiap-siap. Kemudian berserulah perempuan itu kepadanya: \"Orang-orang Filistin menyergap engkau, Simson!\" Tetapi ia memutuskan tali-tali busur itu seperti tali rami yang terbakar putus, apabila kena api. Dan tidaklah ketahuan di mana duduk kekuatannya itu."
 },
 {
   "id": 6961,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 10,
   "firman": "Kemudian berkatalah Delila kepada Simson: \"Sesungguhnya engkau telah mempermain-mainkan dan membohongi aku. Sekarang ceritakanlah kiranya kepadaku dengan apa engkau dapat diikat.\""
 },
 {
   "id": 6962,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 11,
   "firman": "Jawabnya kepadanya: \"Jika aku diikat erat-erat dengan tali baru, yang belum terpakai untuk pekerjaan apapun, maka aku akan menjadi lemah dan menjadi seperti orang lain manapun juga.\""
 },
 {
   "id": 6963,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 12,
   "firman": "Kemudian Delila mengambil tali baru, diikatnyalah dia dengan tali-tali itu dan berseru kepadanya: \"Orang-orang Filistin menyergap engkau, Simson!\" --di kamar ada orang bersiap-siap--tetapi tali-tali itu diputuskannya tanggal dari tangannya seperti benang saja."
 },
 {
   "id": 6964,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 13,
   "firman": "Berkatalah Delila kepada Simson: \"Sampai sekarang engkau telah mempermain-mainkan dan membohongi aku. Ceritakanlah kepadaku dengan apakah engkau dapat diikat.\" Jawabnya kepadanya: \"Kalau engkau menenun ketujuh rambut jalinku bersama-sama dengan lungsin lalu mengokohkannya dengan patok, maka aku akan menjadi lemah dan menjadi seperti orang lain manapun juga.\""
 },
 {
   "id": 6965,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 14,
   "firman": "Kemudian perempuan itu mengokohkan lagi tenunan itu dengan patok, lalu berserulah ia kepadanya: \"Orang-orang Filistin menyergap engkau, Simson.\" Tetapi ketika ia terjaga dari tidurnya, disentaknya lepas patok tenunan dan lungsin itu."
 },
 {
   "id": 6966,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 15,
   "firman": "Berkatalah perempuan itu kepadanya: \"Bagaimana mungkin engkau berkata: Aku cinta kepadamu, padahal hatimu tidak tertuju kepadaku? Sekarang telah tiga kali engkau mempermain-mainkan aku dan tidak mau menceritakan kepadaku, karena apakah kekuatanmu demikian besar.\""
 },
 {
   "id": 6967,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 16,
   "firman": "Lalu setelah perempuan itu berhari-hari merengek-rengek kepadanya dan terus mendesak-desak dia, ia tidak dapat lagi menahan hati, sehingga ia mau mati rasanya."
 },
 {
   "id": 6968,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 17,
   "firman": "Maka diceritakannyalah kepadanya segala isi hatinya, katanya: \"Kepalaku tidak pernah kena pisau cukur, sebab sejak dari kandungan ibuku aku ini seorang nazir Allah. Jika kepalaku dicukur, maka kekuatanku akan lenyap dari padaku, dan aku menjadi lemah dan sama seperti orang-orang lain.\""
 },
 {
   "id": 6969,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 18,
   "firman": "Ketika dilihat Delila, bahwa segala isi hatinya telah diceritakannya kepadanya, disuruhnyalah memanggil raja-raja kota orang Filistin, katanya: \"Sekali ini lagi datanglah ke mari, sebab ia telah menceritakan segala isi hatinya kepadaku.\" Lalu datanglah raja-raja kota orang Filistin itu kepadanya sambil membawa uang itu."
 },
 {
   "id": 6970,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 19,
   "firman": "Sesudah itu dibujuknya Simson tidur di pangkuannya, lalu dipanggilnya seorang dan disuruhnya mencukur ketujuh rambut jalinnya, sehingga mulailah Simson ditundukkan oleh perempuan itu, sebab kekuatannya telah lenyap dari padanya."
 },
 {
   "id": 6971,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 20,
   "firman": "Lalu berserulah perempuan itu: \"Orang Filistin menyergap engkau, Simson!\" Maka terjagalah ia dari tidurnya serta katanya: \"Seperti yang sudah-sudah, aku akan bebas dan akan meronta lepas.\" Tetapi tidaklah diketahuinya, bahwa TUHAN telah meninggalkan dia."
 },
 {
   "id": 6972,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 21,
   "firman": "Orang Filistin itu menangkap dia, mencungkil kedua matanya dan membawanya ke Gaza. Di situ ia dibelenggu dengan dua rantai tembaga dan pekerjaannya di penjara ialah menggiling."
 },
 {
   "id": 6973,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 22,
   "firman": "Tetapi rambutnya mulai tumbuh pula sesudah dicukur."
 },
 {
   "id": 6974,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 23,
   "firman": "Sesudah itu berkumpullah raja-raja kota orang Filistin untuk mengadakan perayaan korban sembelihan yang besar kepada Dagon, allah mereka, dan untuk bersukaria; kata mereka: \"Telah diserahkan oleh allah kita ke dalam tangan kita Simson, musuh kita.\""
 },
 {
   "id": 6975,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 24,
   "firman": "Dan ketika orang banyak melihat Simson, mereka memuji allah mereka, sambil berseru: \"Telah diserahkan oleh allah kita ke dalam tangan kita musuh kita, perusak tanah kita, dan yang membunuh banyak teman kita.\""
 },
 {
   "id": 6976,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 25,
   "firman": "Ketika hati mereka riang gembira, berkatalah mereka: \"Panggillah Simson untuk melawak bagi kita.\" Simson dipanggil dari penjara, lalu ia melawak di depan mereka, kemudian mereka menyuruh dia berdiri di antara tiang-tiang."
 },
 {
   "id": 6977,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 26,
   "firman": "Berkatalah Simson kepada anak yang menuntun dia: \"Lepaskan aku dan biarkanlah aku meraba-raba tiang-tiang penyangga rumah ini, supaya aku dapat bersandar padanya.\""
 },
 {
   "id": 6978,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 27,
   "firman": "Adapun gedung itu penuh dengan laki-laki dan perempuan; segala raja kota orang Filistin ada di sana, dan di atas sotoh ada kira-kira tiga ribu orang laki-laki dan perempuan, yang menonton lawak Simson itu."
 },
 {
   "id": 6979,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 28,
   "firman": "Berserulah Simson kepada TUHAN, katanya: \"Ya Tuhan ALLAH, ingatlah kiranya kepadaku dan buatlah aku kuat, sekali ini saja, ya Allah, supaya dengan satu pembalasan juga kubalaskan kedua mataku itu kepada orang Filistin.\""
 },
 {
   "id": 6980,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 29,
   "firman": "Kemudian Simson merangkul kedua tiang yang paling tengah, penyangga rumah itu, lalu bertopang kepada tiang yang satu dengan tangan kanannya dan kepada tiang yang lain dengan tangan kirinya."
 },
 {
   "id": 6981,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 30,
   "firman": "Berkatalah Simson: \"Biarlah kiranya aku mati bersama-sama orang Filistin ini.\" Lalu membungkuklah ia sekuat-kuatnya, maka rubuhlah rumah itu menimpa raja-raja kota itu dan seluruh orang banyak yang ada di dalamnya. Yang mati dibunuhnya pada waktu matinya itu lebih banyak dari pada yang dibunuhnya pada waktu hidupnya."
 },
 {
   "id": 6982,
   "kitab": "Hak",
   "pasal": 16,
   "ayat": 31,
   "firman": "Sesudah itu datanglah ke sana saudara-saudaranya dan seluruh keluarganya, mereka mengangkat dia dan membawanya dari sana, lalu menguburkannya di antara Zora dan Esytaol di dalam kubur Manoah, ayahnya. Dia memerintah sebagai hakim atas orang Israel dua puluh tahun lamanya."
 },
 {
   "id": 6983,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 1,
   "firman": "Ada seorang dari pegunungan Efraim, Mikha namanya."
 },
 {
   "id": 6984,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 2,
   "firman": "Berkatalah ia kepada ibunya: \"Uang perak yang seribu seratus itu, yang diambil orang dari padamu dan yang karena itu kauucapkan kutuk--aku sendiri mendengar ucapanmu itu--memang uang itu ada padaku, akulah yang mengambilnya.\" Lalu kata ibunya: \"Diberkatilah kiranya anakku oleh TUHAN.\""
 },
 {
   "id": 6985,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 3,
   "firman": "Sesudah itu dikembalikannyalah uang perak yang seribu seratus itu kepada ibunya. Tetapi ibunya berkata: \"Aku mau menguduskan uang itu bagi TUHAN, aku menyerahkannya untuk anakku, supaya dibuat patung pahatan dan patung tuangan dari pada uang itu. Maka sekarang, uang itu kukembalikan kepadamu.\""
 },
 {
   "id": 6986,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 4,
   "firman": "Tetapi orang itu mengembalikan uang itu kepada ibunya, lalu perempuan itu mengambil dua ratus uang perak dan memberikannya kepada tukang perak, yang membuat patung pahatan dan patung tuangan dari pada uang itu; lalu patung itu ditaruh di rumah Mikha."
 },
 {
   "id": 6987,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 5,
   "firman": "Mikha ini mempunyai kuil. Dibuatnyalah efod dan terafim, ditahbiskannya salah seorang anaknya laki-laki, yang menjadi imamnya."
 },
 {
   "id": 6988,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 6,
   "firman": "Pada zaman itu tidak ada raja di antara orang Israel; setiap orang berbuat apa yang benar menurut pandangannya sendiri."
 },
 {
   "id": 6989,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 7,
   "firman": "Maka ada seorang muda dari Betlehem-Yehuda, dari kaum Yehuda; ia seorang Lewi dan tinggal di sana sebagai pendatang."
 },
 {
   "id": 6990,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 8,
   "firman": "Lalu orang itu keluar dari kota Betlehem-Yehuda untuk menetap sebagai pendatang di mana saja ia mendapat tempat; dan dalam perjalanannya itu sampailah ia ke pegunungan Efraim di rumah Mikha."
 },
 {
   "id": 6991,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 9,
   "firman": "Bertanyalah Mikha kepadanya: \"Engkau dari mana?\" Jawabnya kepadanya: \"Aku orang Lewi dari Betlehem-Yehuda, dan aku pergi untuk menetap sebagai pendatang di mana saja aku mendapat tempat.\""
 },
 {
   "id": 6992,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 10,
   "firman": "Lalu kata Mikha kepadanya: \"Tinggallah padaku dan jadilah bapak dan imam bagiku; maka setiap tahun aku akan memberikan kepadamu sepuluh uang perak, sepasang pakaian serta makananmu.\""
 },
 {
   "id": 6993,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 11,
   "firman": "Orang Lewi itu setuju untuk tinggal padanya. Maka orang muda itu menjadi seperti salah seorang anaknya sendiri."
 },
 {
   "id": 6994,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 12,
   "firman": "Mikha mentahbiskan orang Lewi itu; orang muda itu menjadi imamnya dan diam di rumah Mikha."
 },
 {
   "id": 6995,
   "kitab": "Hak",
   "pasal": 17,
   "ayat": 13,
   "firman": "Lalu kata Mikha: \"Sekarang tahulah aku, bahwa TUHAN akan berbuat baik kepadaku, karena ada seorang Lewi menjadi imamku.\""
 },
 {
   "id": 6996,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 1,
   "firman": "Pada zaman itu tidak ada raja di antara orang Israel dan pada zaman itu suku Dan sedang mencari milik pusaka untuk menetap, sebab sampai hari itu mereka belum juga mendapat bagian milik pusaka di tengah-tengah suku-suku Israel."
 },
 {
   "id": 6997,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 2,
   "firman": "Sebab itu bani Dan menyuruh dari kaumnya lima orang dari seluruh jumlah mereka, semuanya orang-orang yang gagah perkasa, yang berasal dari Zora dan Esytaol, untuk mengintai negeri itu dan menyelidikinya, serta berkata kepada mereka: \"Pergilah menyelidiki negeri itu.\" Ketika orang-orang itu sampai ke pegunungan Efraim di rumah Mikha, bermalamlah mereka di sana."
 },
 {
   "id": 6998,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 3,
   "firman": "Ketika mereka ada dekat rumah Mikha itu, dikenal merekalah logat orang muda suku Lewi itu, lalu singgahlah mereka ke sana dan berkata kepadanya: \"Siapakah yang membawa engkau ke mari? Apakah pekerjaanmu dan urusanmu di sini?\""
 },
 {
   "id": 6999,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 4,
   "firman": "Katanya kepada mereka: \"Begini begitulah dilakukan Mikha kepadaku; ia menggaji aku dan aku menjadi imamnya.\""
 },
 {
   "id": 7000,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 5,
   "firman": "Kata mereka kepadanya: \"Tanyakanlah kiranya kepada Allah, supaya kami ketahui apakah perjalanan yang kami tempuh ini akan berhasil.\""
 },
 {
   "id": 7001,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 6,
   "firman": "Kata imam itu kepada mereka: \"Pergilah dengan selamat! Perjalanan yang kamu tempuh itu dipandang baik oleh TUHAN.\""
 },
 {
   "id": 7002,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 7,
   "firman": "Sesudah itu pergilah kelima orang itu, lalu sampailah mereka ke Lais. Dilihat merekalah, bahwa rakyat yang diam di sana hidup dengan tenteram, menurut adat orang Sidon, aman dan tenteram. Orang-orang itu tidak kekurangan apapun yang ada di muka bumi, malah kaya harta. Mereka tinggal jauh dari orang Sidon dan tidak bergaul dengan siapapun juga."
 },
 {
   "id": 7003,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 8,
   "firman": "Setelah mereka kembali kepada saudara-saudara sesukunya di Zora dan Esytaol, berkatalah saudara-saudara sesukunya kepada mereka: \"Apakah yang kamu dapati di sana?\""
 },
 {
   "id": 7004,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 9,
   "firman": "Jawab mereka: \"Bersiaplah, marilah kita maju menyerang mereka, sebab kami telah melihat negeri itu, dan memang sangat baik. Masakan kamu tinggal diam! Janganlah bermalas-malas untuk pergi memasuki dan menduduki negeri itu."
 },
 {
   "id": 7005,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 10,
   "firman": "Apabila kamu memasukinya kamu mendapati rakyat yang hidup dengan tenteram, dan negeri itu luas ke sebelah kiri dan ke sebelah kanan. Sesungguhnya, Allah telah menyerahkannya ke dalam tanganmu; itulah tempat yang tidak kekurangan apapun yang ada di muka bumi.\""
 },
 {
   "id": 7006,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 11,
   "firman": "Lalu berangkatlah dari sana, dari Zora dan Esytaol, enam ratus orang dari kaum suku Dan, diperlengkapi dengan senjata."
 },
 {
   "id": 7007,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 12,
   "firman": "Mereka maju, lalu berkemah di Kiryat-Yearim di Yehuda. Itulah sebabnya tempat itu disebut Mahane-Dan sampai sekarang; letaknya di sebelah barat Kiryat-Yearim."
 },
 {
   "id": 7008,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 13,
   "firman": "Dari sana mereka bergerak terus ke pegunungan Efraim dan sampai di rumah Mikha."
 },
 {
   "id": 7009,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 14,
   "firman": "Lalu berbicaralah kelima orang yang telah pergi mengintai daerah Lais itu, katanya kepada saudara-saudara sesukunya: \"Tahukah kamu, bahwa dalam rumah-rumah ini ada efod, terafim, patung pahatan dan patung tuangan? Oleh sebab itu, insafilah apa yang akan kamu perbuat!\""
 },
 {
   "id": 7010,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 15,
   "firman": "Kemudian mereka menuju ke tempat itu, lalu sampai di rumah orang muda suku Lewi itu, di rumah Mikha, dan menanyakan apakah ia selamat."
 },
 {
   "id": 7011,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 16,
   "firman": "Sementara keenam ratus orang dari bani Dan yang diperlengkapi dengan senjata itu tinggal berdiri di pintu gerbang,"
 },
 {
   "id": 7012,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 17,
   "firman": "maka kelima orang yang telah pergi mengintai negeri itu berjalan terus, masuk ke dalam lalu mengambil patung pahatan, efod, terafim dan patung tuangan itu. Adapun imam itu berdiri di pintu gerbang bersama-sama dengan keenam ratus orang yang diperlengkapi dengan senjata itu."
 },
 {
   "id": 7013,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 18,
   "firman": "Tetapi, setelah yang lain-lain itu masuk ke dalam rumah Mikha dan mengambil patung pahatan, efod, terafim dan patung tuangan itu, berkatalah imam itu kepada mereka: \"Berbuat apakah kamu ini?\""
 },
 {
   "id": 7014,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 19,
   "firman": "Tetapi jawab mereka kepadanya: \"Diamlah, tutup mulut, ikutlah kami dan jadilah bapak dan imam kami. Apakah yang lebih baik bagimu: menjadi imam untuk seisi rumah satu orang atau menjadi imam untuk suatu suku dan kaum di antara orang Israel?\""
 },
 {
   "id": 7015,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 20,
   "firman": "Maka gembiralah hati imam itu, diambilnyalah efod, terafim dan patung pahatan itu, lalu masuk ke tengah-tengah orang banyak."
 },
 {
   "id": 7016,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 21,
   "firman": "Kemudian berbaliklah mereka dan pergi, dengan anak-anak, ternak dan barang-barang yang berharga ditempatkan di depan mereka."
 },
 {
   "id": 7017,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 22,
   "firman": "Ketika mereka telah jauh dari rumah Mikha, dikerahkanlah orang-orang dari rumah-rumah yang di dekat rumah Mikha dan orang-orang itu mengejar bani Dan itu."
 },
 {
   "id": 7018,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 23,
   "firman": "Mereka memanggil-manggil bani Dan, maka berbaliklah orang-orang itu dan berkata kepada Mikha: \"Mau apa engkau dengan mengerahkan orang?\" Lalu jawabnya:"
 },
 {
   "id": 7019,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 24,
   "firman": "\"Allahku yang kubuat serta imam juga kamu ambil, lalu kamu pergi. Apakah lagi yang masih tinggal padaku? Bagaimana perkataanmu itu kepadaku: Mau apa engkau?\""
 },
 {
   "id": 7020,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 25,
   "firman": "Berkatalah bani Dan kepadanya: \"Janganlah suaramu kedengaran lagi kepada kami, nanti ada orang yang menyerang engkau karena sakit hati dan dengan demikian engkau serta seisi rumahmu kehilangan nyawa.\""
 },
 {
   "id": 7021,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 26,
   "firman": "Lalu bani Dan melanjutkan perjalanannya, dan Mikha, setelah dilihatnya mereka itu lebih kuat dari padanya, berpalinglah ia pulang ke rumahnya."
 },
 {
   "id": 7022,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 27,
   "firman": "Lalu bani Dan, dengan membawa barang-barang yang dibuat Mikha, juga imamnya, mendatangi Lais, yakni rakyat yang hidup dengan aman dan tenteram. Mereka memukul orang-orang itu dengan mata pedang dan kotanya dibakar."
 },
 {
   "id": 7023,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 28,
   "firman": "Tidak ada orang yang datang menolong, sebab kota itu jauh dari Sidon dan orang-orang kota itu tidak bergaul dengan siapapun juga. Letak kota itu di lembah Bet-Rehob. Kemudian bani Dan membangun kota itu kembali dan diam di sana."
 },
 {
   "id": 7024,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 29,
   "firman": "Mereka menamai kota itu Dan, menurut nama bapa leluhur mereka, yakni Dan, yang lahir bagi Israel, tetapi nama kota itu dahulu adalah Lais."
 },
 {
   "id": 7025,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 30,
   "firman": "Bani Dan menegakkan bagi mereka sendiri patung pahatan itu, lalu Yonatan bin Gersom bin Musa bersama-sama dengan anak-anaknya menjadi imam bagi suku Dan, sampai penduduk negeri itu diangkut sebagai orang buangan."
 },
 {
   "id": 7026,
   "kitab": "Hak",
   "pasal": 18,
   "ayat": 31,
   "firman": "Demikianlah mereka menempatkan bagi mereka sendiri patung pahatan yang telah dibuat Mikha itu, dan patung itu ada di sana selama rumah Allah ada di Silo."
 },
 {
   "id": 7027,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 1,
   "firman": "Terjadilah pada zaman itu, ketika tidak ada raja di Israel, bahwa di balik pegunungan Efraim ada seorang Lewi tinggal sebagai pendatang. Ia mengambil seorang gundik dari Betlehem-Yehuda."
 },
 {
   "id": 7028,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 2,
   "firman": "Tetapi gundiknya itu berlaku serong terhadap dia dan pergi dari padanya ke rumah ayahnya di Betlehem-Yehuda, lalu tinggal di sana empat bulan lamanya."
 },
 {
   "id": 7029,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 3,
   "firman": "Berkemaslah suaminya itu, lalu pergi menyusul perempuan itu untuk membujuk dia dan membawanya kembali; bersama-sama dia bujangnya dan sepasang keledai. Ketika perempuan muda itu membawa dia masuk ke rumah ayahnya, dan ketika ayah itu melihat dia, maka bersukacitalah ia mendapatkannya."
 },
 {
   "id": 7030,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 4,
   "firman": "Mertuanya, ayah perempuan muda itu, tidak membiarkan dia pergi, sehingga ia tinggal tiga hari lamanya pada ayah itu; mereka makan, minum dan bermalam di sana."
 },
 {
   "id": 7031,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 5,
   "firman": "Tetapi pada hari yang keempat, ketika mereka bangun pagi-pagi dan ketika orang Lewi itu berkemas untuk pergi, berkatalah ayah perempuan muda itu kepada menantunya: \"Segarkanlah dirimu dahulu dengan sekerat roti, kemudian bolehlah kamu pergi.\""
 },
 {
   "id": 7032,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 6,
   "firman": "Jadi duduklah mereka, lalu makan dan minumlah keduanya bersama-sama. Kata ayah perempuan muda itu kepada laki-laki itu: \"Baiklah putuskan untuk tinggal bermalam dan biarlah hatimu gembira.\""
 },
 {
   "id": 7033,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 7,
   "firman": "Tetapi ketika orang itu bangun untuk pergi juga, mertuanya itu mendesaknya, sehingga ia tinggal pula di sana bermalam."
 },
 {
   "id": 7034,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 8,
   "firman": "Pada hari yang kelima, ketika ia bangun pagi-pagi untuk pergi, berkatalah ayah perempuan muda itu: \"Mari, segarkanlah dirimu dahulu, dan tinggallah sebentar lagi, sampai matahari surut.\" Lalu makanlah mereka keduanya."
 },
 {
   "id": 7035,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 9,
   "firman": "Ketika orang itu bangun untuk pergi, bersama dengan gundiknya dan bujangnya, berkatalah mertuanya, ayah perempuan muda itu, kepadanya: \"Lihatlah, matahari telah mulai turun menjelang petang; baiklah tinggal bermalam, lihat, matahari hampir terbenam, tinggallah di sini bermalam dan biarlah hatimu gembira; maka besok kamu dapat bangun pagi-pagi untuk berjalan dan pulang ke rumahmu.\""
 },
 {
   "id": 7036,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 10,
   "firman": "Tetapi orang itu tidak mau tinggal bermalam; ia berkemas, lalu pergi. Demikian sampailah ia di daerah yang berhadapan dengan Yebus--itulah Yerusalem--;bersama-sama dengan dia ada sepasang keledai yang berpelana dan gundiknya juga."
 },
 {
   "id": 7037,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 11,
   "firman": "Ketika mereka dekat ke Yebus dan ketika matahari telah sangat rendah, berkatalah bujang itu kepada tuannya: \"Marilah kita singgah di kota orang Yebus ini dan bermalam di situ.\""
 },
 {
   "id": 7038,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 12,
   "firman": "Tetapi tuannya menjawabnya: \"Kita tidak akan singgah di kota asing yang bukan kepunyaan orang Israel, tetapi kita akan berjalan terus sampai ke Gibea.\""
 },
 {
   "id": 7039,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 13,
   "firman": "Lagi katanya kepada bujangnya: \"Marilah kita berjalan sampai ke salah satu tempat yang di sana dan bermalam di Gibea atau di Rama.\""
 },
 {
   "id": 7040,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 14,
   "firman": "Lalu berjalanlah mereka melanjutkan perjalanannya, dan matahari terbenam, ketika mereka dekat Gibea kepunyaan suku Benyamin."
 },
 {
   "id": 7041,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 15,
   "firman": "Sebab itu singgahlah mereka di Gibea, lalu masuk untuk bermalam di situ, dan setelah sampai, duduklah mereka di tanah lapang kota. Tetapi tidak ada seorangpun yang mengajak mereka ke rumah untuk bermalam."
 },
 {
   "id": 7042,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 16,
   "firman": "Tetapi datanglah pada malam itu seorang tua, yang pulang dari pekerjaannya di ladang. Orang itu berasal dari pegunungan Efraim dan tinggal di Gibea sebagai pendatang, tetapi penduduk tempat itu adalah orang Benyamin."
 },
 {
   "id": 7043,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 17,
   "firman": "Ketika ia mengangkat mukanya dan melihat orang yang dalam perjalanan itu di tanah lapang kota, berkatalah orang tua itu: \"Ke manakah engkau pergi dan dari manakah engkau datang?\""
 },
 {
   "id": 7044,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 18,
   "firman": "Jawabnya kepadanya: \"Kami sedang dalam perjalanan dari Betlehem-Yehuda ke balik pegunungan Efraim. Dari sanalah aku berasal; aku tadinya pergi ke Betlehem-Yehuda dan sekarang sedang berjalan pulang ke rumah. Tetapi tidak ada orang yang mengajak aku ke rumahnya,"
 },
 {
   "id": 7045,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 19,
   "firman": "walaupun ada padaku jerami dan makanan untuk keledai kami, pula roti dan anggur untuk aku sendiri, untuk hambamu perempuan ini dan untuk bujang yang bersama-sama dengan hambamu ini; kami tidak kekurangan sesuatu.\""
 },
 {
   "id": 7046,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 20,
   "firman": "Lalu berkatalah orang tua itu: \"Jangan kuatir! Segala yang engkau perlukan biarlah aku yang menanggung, tetapi janganlah engkau bermalam di tanah lapang kota ini.\""
 },
 {
   "id": 7047,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 21,
   "firman": "Sesudah itu dibawanyalah dia masuk ke rumahnya, lalu keledai-keledai diberinya makan; maka merekapun membasuh kaki, makan dan minum."
 },
 {
   "id": 7048,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 22,
   "firman": "Tetapi sementara mereka menggembirakan hatinya, datanglah orang-orang kota itu, orang-orang dursila, mengepung rumah itu. Mereka menggedor-gedor pintu sambil berkata kepada orang tua, pemilik rumah itu: \"Bawalah ke luar orang yang datang ke rumahmu itu, supaya kami pakai dia.\""
 },
 {
   "id": 7049,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 23,
   "firman": "Lalu keluarlah pemilik rumah itu menemui mereka dan berkata kepada mereka: \"Tidak, saudara-saudaraku, janganlah kiranya berbuat jahat; karena orang ini telah masuk ke rumahku, janganlah kamu berbuat noda."
 },
 {
   "id": 7050,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 24,
   "firman": "Tetapi ada anakku perempuan, yang masih perawan, dan juga gundik orang itu, baiklah kubawa keduanya ke luar; perkosalah mereka dan perbuatlah dengan mereka apa yang kamu pandang baik, tetapi terhadap orang ini janganlah kamu berbuat noda.\""
 },
 {
   "id": 7051,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 25,
   "firman": "Tetapi orang-orang itu tidak mau mendengarkan perkataannya. Lalu orang Lewi itu menangkap gundiknya dan membawanya kepada mereka ke luar, kemudian mereka bersetubuh dengan perempuan itu dan semalam-malaman itu mereka mempermainkannya, sampai pagi. Barulah pada waktu fajar menyingsing mereka melepaskan perempuan itu."
 },
 {
   "id": 7052,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 26,
   "firman": "Menjelang pagi perempuan itu datang kembali, tetapi ia jatuh rebah di depan pintu rumah orang itu, tempat tuannya bermalam, dan ia tergeletak di sana sampai fajar."
 },
 {
   "id": 7053,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 27,
   "firman": "Pada waktu tuannya bangun pagi-pagi, dibukanya pintu rumah dan pergi ke luar untuk melanjutkan perjalanannya, tetapi tampaklah perempuan itu, gundiknya, tergeletak di depan pintu rumah dengan tangannya pada ambang pintu."
 },
 {
   "id": 7054,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 28,
   "firman": "Berkatalah ia kepada perempuan itu: \"Bangunlah, marilah kita pergi.\" Tetapi tidak ada jawabnya. Lalu diangkatnyalah mayat itu ke atas keledai, berkemaslah ia, kemudian pergi ke tempat kediamannya."
 },
 {
   "id": 7055,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 29,
   "firman": "Sesampai di rumah, diambilnyalah pisau, dipegangnyalah mayat gundiknya, dipotong-potongnya menurut tulang-tulangnya menjadi dua belas potongan, lalu dikirimnya ke seluruh daerah orang Israel."
 },
 {
   "id": 7056,
   "kitab": "Hak",
   "pasal": 19,
   "ayat": 30,
   "firman": "Dan setiap orang yang melihatnya, berkata: \"Hal yang demikian belum pernah terjadi dan belum pernah terlihat, sejak orang Israel berangkat keluar dari tanah Mesir sampai sekarang. Perhatikanlah itu, pertimbangkanlah, lalu berbicaralah!\""
 },
 {
   "id": 7057,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 1,
   "firman": "Lalu majulah semua orang Israel; dari Dan sampai Bersyeba dan juga dari tanah Gilead berkumpullah umat itu secara serentak menghadap TUHAN di Mizpa."
 },
 {
   "id": 7058,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 2,
   "firman": "Maka berdirilah para pemuka dari seluruh bangsa itu, dari segala suku orang Israel, memimpin jemaah umat Allah yang jumlahnya empat ratus ribu orang berjalan kaki, yang bersenjatakan pedang."
 },
 {
   "id": 7059,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 3,
   "firman": "Kedengaranlah kepada bani Benyamin, bahwa orang Israel telah maju ke Mizpa. Berkatalah orang Israel: \"Ceritakan bagaimana kejahatan itu terjadi.\""
 },
 {
   "id": 7060,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 4,
   "firman": "Lalu orang Lewi, suami perempuan yang terbunuh itu, menjawab: \"Aku sampai dengan gundikku di Gibea kepunyaan suku Benyamin untuk bermalam di sana."
 },
 {
   "id": 7061,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 5,
   "firman": "Lalu warga-warga kota Gibea itu mendatangi aku dan mengepung rumah itu pada malam hari untuk menyerang aku. Mereka bermaksud membunuh aku, tetapi gundikku diperkosa mereka, sehingga mati."
 },
 {
   "id": 7062,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 6,
   "firman": "Maka kuambillah mayat gundikku, kupotong-potong dia dan kukirimkan ke seluruh daerah milik pusaka orang Israel, sebab orang-orang itu telah berbuat mesum dan berbuat noda di antara orang Israel."
 },
 {
   "id": 7063,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 7,
   "firman": "Sekarang kamu sekalian, orang Israel, telah ada di sini. Berikanlah di sini pertimbanganmu dan nasihatmu.\""
 },
 {
   "id": 7064,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 8,
   "firman": "Kemudian bangunlah seluruh bangsa itu dengan serentak, sambil berkata: \"Seorangpun dari pada kita takkan pergi ke kemahnya, seorangpun dari pada kita takkan pulang ke rumahnya."
 },
 {
   "id": 7065,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 9,
   "firman": "Inilah yang akan kita lakukan kepada Gibea; memeranginya, dengan membuang undi!"
 },
 {
   "id": 7066,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 10,
   "firman": "Kita akan memilih dari seluruh suku Israel sepuluh orang dari tiap-tiap seratus, seratus orang dari tiap-tiap seribu, seribu orang dari tiap-tiap sepuluh ribu, untuk mengambil bekal bagi laskar ini, supaya sesudah mereka datang, dilakukan kepada Gibea-Benyamin setimpal dengan segala perbuatan noda yang telah diperbuat mereka di antara orang Israel.\""
 },
 {
   "id": 7067,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 11,
   "firman": "Demikianlah orang Israel berkumpul melawan kota itu, semuanya bersekutu dengan serentak."
 },
 {
   "id": 7068,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 12,
   "firman": "Kemudian suku-suku Israel mengirim orang kepada seluruh suku Benyamin dengan pesan: \"Apa macam kejahatan yang terjadi di antara kamu itu!"
 },
 {
   "id": 7069,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 13,
   "firman": "Maka sekarang, serahkanlah orang-orang itu, yakni orang-orang dursila yang di Gibea itu, supaya kami menghukum mati mereka dan dengan demikian menghapuskan yang jahat itu dari antara orang Israel.\" Tetapi bani Benyamin tidak mau mendengarkan perkataan saudara-saudaranya, orang Israel itu."
 },
 {
   "id": 7070,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 14,
   "firman": "Sebaliknya, bani Benyamin dari kota-kota lain berkumpul di Gibea untuk maju berperang melawan orang Israel."
 },
 {
   "id": 7071,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 15,
   "firman": "Pada hari itu dihitunglah jumlah bani Benyamin dari kota-kota lain itu: dua puluh enam ribu orang yang bersenjatakan pedang, belum termasuk penduduk Gibea, yang terhitung tujuh ratus orang pilihan banyaknya."
 },
 {
   "id": 7072,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 16,
   "firman": "Dari segala laskar ini ada tujuh ratus orang pilihan yang kidal, dan setiap orang dari mereka dapat mengumban dengan tidak pernah meleset sampai sehelai rambutpun."
 },
 {
   "id": 7073,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 17,
   "firman": "Juga orang-orang Israel dihitung jumlahnya; dengan tidak termasuk suku Benyamin ada empat ratus ribu orang yang bersenjatakan pedang; semuanya itu prajurit."
 },
 {
   "id": 7074,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 18,
   "firman": "Lalu orang Israel berangkat dan maju ke Betel. Di sana mereka bertanya kepada Allah: \"Siapakah dari kami yang lebih dahulu maju berperang melawan bani Benyamin?\" Jawab TUHAN: \"Suku Yehudalah lebih dahulu.\""
 },
 {
   "id": 7075,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 19,
   "firman": "Lalu orang-orang Israel bangun pagi-pagi dan berkemah mengepung Gibea."
 },
 {
   "id": 7076,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 20,
   "firman": "Kemudian majulah orang-orang Israel berperang melawan suku Benyamin; orang-orang Israel mengatur barisan perangnya melawan mereka dekat Gibea."
 },
 {
   "id": 7077,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 21,
   "firman": "Juga bani Benyamin maju menyerang dari Gibea dan menggugurkan ke bumi dua puluh dua ribu orang dari antara orang Israel pada hari itu."
 },
 {
   "id": 7078,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 22,
   "firman": "Tetapi laskar orang Israel mengumpulkan segenap kekuatannya, lalu mengatur pula barisan perangnya di tempat mereka mengatur barisannya semula."
 },
 {
   "id": 7079,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 23,
   "firman": "Kemudian pergilah orang-orang Israel, lalu menangis di hadapan TUHAN sampai petang, sesudah itu mereka bertanya kepada TUHAN: \"Akan pergi pulakah kami berperang melawan bani Benyamin, saudara kami itu?\" Jawab TUHAN: \"Majulah melawan mereka.\""
 },
 {
   "id": 7080,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 24,
   "firman": "Tetapi ketika orang-orang Israel pada hari kedua sampai di dekat bani Benyamin,"
 },
 {
   "id": 7081,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 25,
   "firman": "maka pada hari kedua itu majulah suku Benyamin dari Gibea menyerbu mereka, dan digugurkannya pula ke bumi delapan belas ribu orang di antara orang-orang Israel; semuanya orang-orang yang bersenjatakan pedang."
 },
 {
   "id": 7082,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 26,
   "firman": "Kemudian pergilah semua orang Israel, yakni seluruh bangsa itu, lalu sampai di Betel; di sana mereka tinggal menangis di hadapan TUHAN, berpuasa sampai senja pada hari itu dan mempersembahkan korban bakaran dan korban keselamatan di hadapan TUHAN."
 },
 {
   "id": 7083,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 27,
   "firman": "Dan orang-orang Israel bertanya kepada TUHAN--pada waktu itu ada di sana tabut perjanjian Allah,"
 },
 {
   "id": 7084,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 28,
   "firman": "dan Pinehas bin Eleazar bin Harun menjadi imam Allah pada waktu itu--kata mereka: \"Haruskah kami maju sekali lagi untuk berperang melawan bani Benyamin, saudara kami itu, atau haruskah kami hentikan itu?\" Jawab TUHAN: \"Majulah, sebab besok Aku akan menyerahkan mereka ke dalam tanganmu.\""
 },
 {
   "id": 7085,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 29,
   "firman": "Lalu orang Israel menempatkan penghadang-penghadang sekeliling Gibea."
 },
 {
   "id": 7086,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 30,
   "firman": "Pada hari ketiga majulah orang-orang Israel melawan bani Benyamin dan mengatur barisannya melawan Gibea seperti yang sudah-sudah."
 },
 {
   "id": 7087,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 31,
   "firman": "Maka majulah bani Benyamin menyerbu laskar itu; mereka terpancing dari kota, dan seperti yang sudah-sudah, mereka mulai menyerang laskar itu pada kedua jalan raya--yang satu menuju ke Betel, dan yang lain ke Gibea melalui padang--sehingga terbunuh beberapa orang, kira-kira tiga puluh orang di antara orang Israel."
 },
 {
   "id": 7088,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 32,
   "firman": "Maka kata bani Benyamin: \"Orang-orang itu telah terpukul kalah oleh kita seperti semula.\" Tetapi orang-orang Israel telah bermupakat lebih dahulu: \"Marilah kita lari dan memancing mereka dari kota ke jalan-jalan raya.\""
 },
 {
   "id": 7089,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 33,
   "firman": "Jadi orang Israel bangun dari tempatnya dan mengatur barisannya di Baal-Tamar, sedang orang Israel yang menghadang itu tiba-tiba keluar dari tempatnya, yakni tempat terbuka dekat Geba,"
 },
 {
   "id": 7090,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 34,
   "firman": "dan sampai di depan Gibea, sebanyak sepuluh ribu orang pilihan dari seluruh Israel. Pertempuran itu dahsyat, tetapi bani Benyamin tidak tahu bahwa malapetaka datang menimpa mereka."
 },
 {
   "id": 7091,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 35,
   "firman": "TUHAN membuat suku Benyamin terpukul kalah oleh orang Israel, dan pada hari itu orang-orang Israel memusnahkan dari antara suku Benyamin dua puluh lima ribu seratus orang, semuanya orang-orang yang bersenjatakan pedang."
 },
 {
   "id": 7092,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 36,
   "firman": "Bani Benyamin melihat, bahwa mereka telah terpukul kalah. Sementara orang-orang Israel agak mundur di depan suku Benyamin--sebab mereka mempercayai penghadang-penghadang yang ditempatkan mereka untuk menyerang Gibea--"
 },
 {
   "id": 7093,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 37,
   "firman": "maka segeralah penghadang-penghadang itu menyerbu Gibea. Mereka bergerak maju dan memukul seluruh kota itu dengan mata pedang."
 },
 {
   "id": 7094,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 38,
   "firman": "Tetapi orang-orang Israel telah bermupakat dengan penghadang-penghadang itu untuk menaikkan gumpalan asap tebal dari kota itu."
 },
 {
   "id": 7095,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 39,
   "firman": "Ketika orang-orang Israel mundur dalam pertempuran itu, maka suku Benyamin mulai menyerang orang Israel, sehingga terbunuh kira-kira tiga puluh orang, karena pikir mereka: \"Tentulah orang-orang itu terpukul kalah sama sekali oleh kita seperti dalam pertempuran yang dahulu.\""
 },
 {
   "id": 7096,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 40,
   "firman": "Tetapi pada waktu itu mulailah gumpalan asap naik dari kota itu seperti tiang asap. Suku Benyamin menoleh ke belakang dan tampaklah kota itu seluruhnya terbakar, apinya naik ke langit."
 },
 {
   "id": 7097,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 41,
   "firman": "Lagipula orang-orang Israel maju lagi. Maka gemetarlah orang-orang Benyamin itu, sebab mereka melihat, bahwa malapetaka datang menimpa mereka."
 },
 {
   "id": 7098,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 42,
   "firman": "Jadi larilah mereka dari depan orang-orang Israel itu, ke arah padang gurun, tetapi pertempuran itu tidak dapat dihindari mereka, lalu orang-orang dari kota-kota menghabisi mereka di tengah-tengahnya."
 },
 {
   "id": 7099,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 43,
   "firman": "Mereka mengepung suku Benyamin itu, mengejarnya dengan tak henti-hentinya dan melandanya sampai di depan Gibea, di sebelah timur."
 },
 {
   "id": 7100,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 44,
   "firman": "Dari bani Benyamin ada tewas delapan belas ribu orang, semuanya orang-orang gagah perkasa."
 },
 {
   "id": 7101,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 45,
   "firman": "Yang lain berpaling lari ke padang gurun, ke bukit batu Rimon. Tetapi di jalan-jalan raya masih diadakan penyabitan susulan di antara mereka: lima ribu orang; mereka diburu sampai ke Gideom dan dipukul mati dua ribu orang dari mereka."
 },
 {
   "id": 7102,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 46,
   "firman": "Maka yang tewas dari suku Benyamin pada hari itu seluruhnya berjumlah dua puluh lima ribu orang yang bersenjatakan pedang, semuanya orang-orang gagah perkasa."
 },
 {
   "id": 7103,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 47,
   "firman": "Tetapi enam ratus orang berpaling lari ke padang gurun, ke bukit batu Rimon, dan tinggal empat bulan lamanya di bukit batu itu."
 },
 {
   "id": 7104,
   "kitab": "Hak",
   "pasal": 20,
   "ayat": 48,
   "firman": "Tetapi orang-orang Israel kembali kepada bani Benyamin dan memukul mereka dengan mata pedang, baik manusia baik hewan dan segala sesuatu yang terdapat di sana. Juga segala kota yang terdapat di sana mereka musnahkan dengan api."
 },
 {
   "id": 7105,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 1,
   "firman": "Orang-orang Israel telah bersumpah di Mizpa, demikian: \"Seorangpun dari kita takkan memberikan anaknya perempuan kepada seorang Benyamin menjadi isterinya.\""
 },
 {
   "id": 7106,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 2,
   "firman": "Ketika bangsa itu datang ke Betel dan tinggal di situ di hadapan Allah sampai petang, maka merekapun menyaringkan suaranya menangis dengan sangat keras,"
 },
 {
   "id": 7107,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 3,
   "firman": "katanya: \"Mengapa, ya TUHAN, Allah Israel, terjadi hal yang begini di antara orang Israel, yakni bahwa hari ini satu suku dari antara orang Israel hilang?\""
 },
 {
   "id": 7108,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 4,
   "firman": "Keesokan harinya pagi-pagi maka bangsa itu mendirikan mezbah di situ, lalu mempersembahkan korban bakaran dan korban keselamatan."
 },
 {
   "id": 7109,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 5,
   "firman": "Pada waktu itu berkatalah orang-orang Israel: \"Siapakah dari seluruh suku Israel yang tidak ikut datang dengan jemaah ini untuk menghadap TUHAN?\" Sebab mereka telah bersumpah dengan sungguh-sungguh mengenai orang yang tidak datang menghadap TUHAN di Mizpa, demikian: \"Pastilah ia dihukum mati.\""
 },
 {
   "id": 7110,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 6,
   "firman": "Orang-orang Israel merasa kasihan terhadap suku Benyamin, saudaranya itu, maka kata mereka: \"Hari ini ada satu suku terputus dari orang Israel."
 },
 {
   "id": 7111,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 7,
   "firman": "Apakah yang dapat kita lakukan kepada orang-orang yang tinggal itu dalam hal mencarikan isteri, karena kitalah yang bersumpah demi TUHAN untuk tidak memberikan seorangpun dari anak-anak perempuan kita kepada mereka menjadi isterinya?\""
 },
 {
   "id": 7112,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 8,
   "firman": "Sebab itu berkatalah mereka: \"Dari suku-suku Israel adakah satu yang tidak datang menghadap TUHAN di Mizpa?\" Lalu tampaklah, bahwa dari Yabesh-Gilead tidak ada seorangpun yang datang ke perkemahan jemaah itu."
 },
 {
   "id": 7113,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 9,
   "firman": "Lalu diperiksa jumlah bangsa itu, dan tampaklah tidak hadir seorangpun dari penduduk Yabesh-Gilead."
 },
 {
   "id": 7114,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 10,
   "firman": "Maka perkumpulan itu menyuruh ke situ dua belas ribu orang dari orang-orang gagah perkasa dengan memerintahkan kepada mereka, demikian: \"Pergilah, pukullah penduduk Yabesh-Gilead dengan mata pedang, juga perempuan-perempuan dan anak-anak."
 },
 {
   "id": 7115,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 11,
   "firman": "Tetapi perbuatlah begini: hanya semua laki-laki sajalah dan semua perempuan yang telah pernah tidur dengan laki-laki harus kamu tumpas.\""
 },
 {
   "id": 7116,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 12,
   "firman": "Mereka menjumpai di antara penduduk Yabesh-Gilead empat ratus orang anak gadis, perawan yang belum pernah tidur dengan orang laki-laki, lalu gadis-gadis itu dibawa mereka ke perkemahan di Silo, di tanah Kanaan."
 },
 {
   "id": 7117,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 13,
   "firman": "Sesudah itu segenap umat itu menyuruh orang membawa pesan kepada bani Benyamin yang ada di bukit batu Rimon, lalu memaklumkan damai kepada mereka."
 },
 {
   "id": 7118,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 14,
   "firman": "Pada waktu itu kembalilah suku Benyamin, dan kepada mereka diberikan perempuan-perempuan yang telah dibiarkan hidup dari antara perempuan Yabesh-Gilead; tetapi belum cukup juga jumlahnya bagi mereka."
 },
 {
   "id": 7119,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 15,
   "firman": "Maka bangsa itu merasa kasihan kepada suku Benyamin, karena TUHAN telah membuat keretakan di antara suku-suku Israel."
 },
 {
   "id": 7120,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 16,
   "firman": "Kemudian berkatalah para tua-tua umat itu: \"Apakah yang dapat kita lakukan kepada yang tinggal ini dalam hal mencarikan isteri? Sebab perempuan-perempuan telah punah dari antara suku Benyamin.\""
 },
 {
   "id": 7121,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 17,
   "firman": "Lagi kata mereka: \"Warisan orang-orang yang terluput itu haruslah tetap tinggal pada suku Benyamin, supaya jangan ada suku yang terhapus dari antara orang Israel."
 },
 {
   "id": 7122,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 18,
   "firman": "Tetapi kita ini tidak dapat memberikan isteri kepada mereka dari anak-anak perempuan kita.\" Sebab orang-orang Israel telah bersumpah, demikian: \"Terkutuklah orang yang memberikan isteri kepada suku Benyamin!\""
 },
 {
   "id": 7123,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 19,
   "firman": "Lalu kata mereka pula: \"Setiap tahun ada perayaan bagi TUHAN di Silo yang letaknya di sebelah utara Betel, di sebelah timur jalan raya yang menuju dari Betel ke Sikhem dan di sebelah selatan Lebona.\""
 },
 {
   "id": 7124,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 20,
   "firman": "Maka mereka berpesan kepada bani Benyamin, demikian: \"Pergilah menghadang di kebun-kebun anggur."
 },
 {
   "id": 7125,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 21,
   "firman": "Perhatikanlah baik-baik; maka apabila anak-anak perempuan Silo keluar untuk menari-nari, baiklah kamu keluar dari kebun-kebun anggur itu, dan masing-masing melarikan seorang dari anak-anak perempuan Silo itu menjadi isterinya dan pergi ke tanah Benyamin."
 },
 {
   "id": 7126,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 22,
   "firman": "Apabila ayah atau saudaranya laki-laki datang untuk menuntutnya kepada kami, maka kami akan berkata kepada mereka: Serahkanlah mereka itu kepada kami dengan rela hati, sebab dalam pertempuran kita tidak dapat menangkap seorang perempuan untuk menjadi isteri mereka masing-masing. Memang kamu ini tidak memberikan anak-anak gadis itu kepada mereka; sebab seandainya demikian, kamu bersalah.\""
 },
 {
   "id": 7127,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 23,
   "firman": "Jadi bani Benyamin berbuat demikian; dari gadis-gadis yang menari-nari yang dirampas itu mereka mengambil perempuan, jumlahnya sama dengan jumlah mereka, kemudian pulanglah mereka ke milik pusakanya lalu membangun kota-kotanya kembali dan diam di sana."
 },
 {
   "id": 7128,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 24,
   "firman": "Pada waktu itu pergilah orang Israel dari sana, masing-masing menurut suku dan kaumnya; mereka masing-masing berangkat dari sana ke milik pusakanya."
 },
 {
   "id": 7129,
   "kitab": "Hak",
   "pasal": 21,
   "ayat": 25,
   "firman": "Pada zaman itu tidak ada raja di antara orang Israel; setiap orang berbuat apa yang benar menurut pandangannya sendiri."
 },
 {
   "id": 7130,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada zaman para hakim memerintah ada kelaparan di tanah Israel. Lalu pergilah seorang dari Betlehem-Yehuda beserta isterinya dan kedua anaknya laki-laki ke daerah Moab untuk menetap di sana sebagai orang asing."
 },
 {
   "id": 7131,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 2,
   "firman": "Nama orang itu ialah Elimelekh, nama isterinya Naomi dan nama kedua anaknya Mahlon dan Kilyon, semuanya orang-orang Efrata dari Betlehem-Yehuda; dan setelah sampai ke daerah Moab, diamlah mereka di sana."
 },
 {
   "id": 7132,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kemudian matilah Elimelekh, suami Naomi, sehingga perempuan itu tertinggal dengan kedua anaknya."
 },
 {
   "id": 7133,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 4,
   "firman": "Keduanya mengambil perempuan Moab: yang pertama bernama Orpa, yang kedua bernama Rut; dan mereka diam di situ kira-kira sepuluh tahun lamanya."
 },
 {
   "id": 7134,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lalu matilah juga keduanya, yakni Mahlon dan Kilyon, sehingga perempuan itu kehilangan kedua anaknya dan suaminya."
 },
 {
   "id": 7135,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kemudian berkemaslah ia dengan kedua menantunya dan ia pulang dari daerah Moab, sebab di daerah Moab ia mendengar bahwa TUHAN telah memperhatikan umat-Nya dan memberikan makanan kepada mereka."
 },
 {
   "id": 7136,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 7,
   "firman": "Maka berangkatlah ia dari tempat tinggalnya itu, bersama-sama dengan kedua menantunya. Ketika mereka sedang di jalan untuk pulang ke tanah Yehuda,"
 },
 {
   "id": 7137,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 8,
   "firman": "berkatalah Naomi kepada kedua menantunya itu: \"Pergilah, pulanglah masing-masing ke rumah ibunya; TUHAN kiranya menunjukkan kasih-Nya kepadamu, seperti yang kamu tunjukkan kepada orang-orang yang telah mati itu dan kepadaku;"
 },
 {
   "id": 7138,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 9,
   "firman": "kiranya atas karunia TUHAN kamu mendapat tempat perlindungan, masing-masing di rumah suaminya.\" Lalu diciumnyalah mereka, tetapi mereka menangis dengan suara keras"
 },
 {
   "id": 7139,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 10,
   "firman": "dan berkata kepadanya: \"Tidak, kami ikut dengan engkau pulang kepada bangsamu.\""
 },
 {
   "id": 7140,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 11,
   "firman": "Tetapi Naomi berkata: \"Pulanglah, anak-anakku, mengapakah kamu turut dengan aku? Bukankah tidak akan ada lagi anak laki-laki yang kulahirkan untuk dijadikan suamimu nanti?"
 },
 {
   "id": 7141,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 12,
   "firman": "Pulanglah, anak-anakku, pergilah, sebab sudah terlalu tua aku untuk bersuami. Seandainya pikirku: Ada harapan bagiku, dan sekalipun malam ini aku bersuami, bahkan sekalipun aku masih melahirkan anak laki-laki,"
 },
 {
   "id": 7142,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 13,
   "firman": "masakan kamu menanti sampai mereka dewasa? Masakan karena itu kamu harus menahan diri dan tidak bersuami? Janganlah kiranya demikian, anak-anakku, bukankah jauh lebih pahit yang aku alami dari pada kamu, sebab tangan TUHAN teracung terhadap aku?\""
 },
 {
   "id": 7143,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 14,
   "firman": "Menangis pula mereka dengan suara keras, lalu Orpa mencium mertuanya itu minta diri, tetapi Rut tetap berpaut padanya."
 },
 {
   "id": 7144,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 15,
   "firman": "Berkatalah Naomi: \"Telah pulang iparmu kepada bangsanya dan kepada para allahnya; pulanglah mengikuti iparmu itu.\""
 },
 {
   "id": 7145,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 16,
   "firman": "Tetapi kata Rut: \"Janganlah desak aku meninggalkan engkau dan pulang dengan tidak mengikuti engkau; sebab ke mana engkau pergi, ke situ jugalah aku pergi, dan di mana engkau bermalam, di situ jugalah aku bermalam: bangsamulah bangsaku dan Allahmulah Allahku;"
 },
 {
   "id": 7146,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 17,
   "firman": "di mana engkau mati, akupun mati di sana, dan di sanalah aku dikuburkan. Beginilah kiranya TUHAN menghukum aku, bahkan lebih lagi dari pada itu, jikalau sesuatu apapun memisahkan aku dari engkau, selain dari pada maut!\""
 },
 {
   "id": 7147,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 18,
   "firman": "Ketika Naomi melihat, bahwa Rut berkeras untuk ikut bersama-sama dengan dia, berhentilah ia berkata-kata kepadanya."
 },
 {
   "id": 7148,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 19,
   "firman": "Dan berjalanlah keduanya sampai mereka tiba di Betlehem. Ketika mereka masuk ke Betlehem, gemparlah seluruh kota itu karena mereka, dan perempuan-perempuan berkata: \"Naomikah itu?\""
 },
 {
   "id": 7149,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 20,
   "firman": "Tetapi ia berkata kepada mereka: \"Janganlah sebutkan aku Naomi; sebutkanlah aku Mara, sebab Yang Mahakuasa telah melakukan banyak yang pahit kepadaku."
 },
 {
   "id": 7150,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 21,
   "firman": "Dengan tangan yang penuh aku pergi, tetapi dengan tangan yang kosong TUHAN memulangkan aku. Mengapakah kamu menyebutkan aku Naomi, karena TUHAN telah naik saksi menentang aku dan Yang Mahakuasa telah mendatangkan malapetaka kepadaku.\""
 },
 {
   "id": 7151,
   "kitab": "Rut",
   "pasal": 1,
   "ayat": 22,
   "firman": "Demikianlah Naomi pulang bersama-sama dengan Rut, perempuan Moab itu, menantunya, yang turut pulang dari daerah Moab. Dan sampailah mereka ke Betlehem pada permulaan musim menuai jelai."
 },
 {
   "id": 7152,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 1,
   "firman": "Naomi itu mempunyai seorang sanak dari pihak suaminya, seorang yang kaya raya dari kaum Elimelekh, namanya Boas."
 },
 {
   "id": 7153,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 2,
   "firman": "Maka Rut, perempuan Moab itu, berkata kepada Naomi: \"Biarkanlah aku pergi ke ladang memungut bulir-bulir jelai di belakang orang yang murah hati kepadaku.\" Dan sahut Naomi kepadanya: \"Pergilah, anakku.\""
 },
 {
   "id": 7154,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 3,
   "firman": "Pergilah ia, lalu sampai di ladang dan memungut jelai di belakang penyabit-penyabit; kebetulan ia berada di tanah milik Boas, yang berasal dari kaum Elimelekh."
 },
 {
   "id": 7155,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 4,
   "firman": "Lalu datanglah Boas dari Betlehem. Ia berkata kepada penyabit-penyabit itu: \"TUHAN kiranya menyertai kamu.\" Jawab mereka kepadanya: \"TUHAN kiranya memberkati tuan!\""
 },
 {
   "id": 7156,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 5,
   "firman": "Lalu kata Boas kepada bujangnya yang mengawasi penyabit-penyabit itu: \"Dari manakah perempuan ini?\""
 },
 {
   "id": 7157,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 6,
   "firman": "Bujang yang mengawasi penyabit-penyabit itu menjawab: \"Dia adalah seorang perempuan Moab, dia pulang bersama-sama dengan Naomi dari daerah Moab."
 },
 {
   "id": 7158,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tadi ia berkata: Izinkanlah kiranya aku memungut dan mengumpulkan jelai dari antara berkas-berkas jelai ini di belakang penyabit-penyabit. Begitulah ia datang dan terus sibuk dari pagi sampai sekarang dan seketikapun ia tidak berhenti.\""
 },
 {
   "id": 7159,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 8,
   "firman": "Sesudah itu berkatalah Boas kepada Rut: \"Dengarlah dahulu, anakku! Tidak usah engkau pergi memungut jelai ke ladang lain dan tidak usah juga engkau pergi dari sini, tetapi tetaplah dekat pengerja-pengerja perempuan."
 },
 {
   "id": 7160,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 9,
   "firman": "Lihat saja ke ladang yang sedang disabit orang itu. Ikutilah perempuan-perempuan itu dari belakang. Sebab aku telah memesankan kepada pengerja-pengerja lelaki jangan mengganggu engkau. Jika engkau haus, pergilah ke tempayan-tempayan dan minumlah air yang dicedok oleh pengerja-pengerja itu.\""
 },
 {
   "id": 7161,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 10,
   "firman": "Lalu sujudlah Rut menyembah dengan mukanya sampai ke tanah dan berkata kepadanya: \"Mengapakah aku mendapat belas kasihan dari padamu, sehingga tuan memperhatikan aku, padahal aku ini seorang asing?\""
 },
 {
   "id": 7162,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 11,
   "firman": "Boas menjawab: \"Telah dikabarkan orang kepadaku dengan lengkap segala sesuatu yang engkau lakukan kepada mertuamu sesudah suamimu mati, dan bagaimana engkau meninggalkan ibu bapamu dan tanah kelahiranmu serta pergi kepada suatu bangsa yang dahulu tidak engkau kenal."
 },
 {
   "id": 7163,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 12,
   "firman": "TUHAN kiranya membalas perbuatanmu itu, dan kepadamu kiranya dikaruniakan upahmu sepenuhnya oleh TUHAN, Allah Israel, yang di bawah sayap-Nya engkau datang berlindung.\""
 },
 {
   "id": 7164,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 13,
   "firman": "Kemudian berkatalah Rut: \"Memang aku mendapat belas kasihan dari padamu, ya tuanku, sebab tuan telah menghiburkan aku dan telah menenangkan hati hambamu ini, walaupun aku tidak sama seperti salah seorang hamba-hambamu perempuan.\""
 },
 {
   "id": 7165,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 14,
   "firman": "Ketika sudah waktu makan, berkatalah Boas kepadanya: \"Datanglah ke mari, makanlah roti ini dan celupkanlah suapmu ke dalam cuka ini.\" Lalu duduklah ia di sisi penyabit-penyabit itu, dan Boas mengunjukkan bertih gandum kepadanya; makanlah Rut sampai kenyang, bahkan ada sisanya."
 },
 {
   "id": 7166,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 15,
   "firman": "Setelah ia bangun untuk memungut pula, maka Boas memerintahkan kepada pengerja-pengerjanya: \"Dari antara berkas-berkas itupun ia boleh memungut, janganlah ia diganggu;"
 },
 {
   "id": 7167,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 16,
   "firman": "bahkan haruslah kamu dengan sengaja menarik sedikit-sedikit dari onggokan jelai itu untuk dia dan meninggalkannya, supaya dipungutnya; janganlah berlaku kasar terhadap dia.\""
 },
 {
   "id": 7168,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 17,
   "firman": "Maka ia memungut di ladang sampai petang; lalu ia mengirik yang dipungutnya itu, dan ada kira-kira seefa jelai banyaknya."
 },
 {
   "id": 7169,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 18,
   "firman": "Diangkatnyalah itu, lalu masuklah ia ke kota. Ketika mertuanya melihat apa yang dipungutnya itu, dan ketika dikeluarkannya dan diberikannya kepada mertuanya sisa yang ada setelah kenyang itu,"
 },
 {
   "id": 7170,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 19,
   "firman": "maka berkatalah mertuanya kepadanya: \"Di mana engkau memungut dan di mana engkau bekerja hari ini? Diberkatilah kiranya orang yang telah memperhatikan engkau itu!\" Lalu diceritakannyalah kepada mertuanya itu pada siapa ia bekerja, katanya: \"Nama orang pada siapa aku bekerja hari ini ialah Boas.\""
 },
 {
   "id": 7171,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sesudah itu berkatalah Naomi kepada menantunya: \"Diberkatilah kiranya orang itu oleh TUHAN yang rela mengaruniakan kasih setia-Nya kepada orang-orang yang hidup dan yang mati.\" Lagi kata Naomi kepadanya: \"Orang itu kaum kerabat kita, dialah salah seorang yang wajib menebus kita.\""
 },
 {
   "id": 7172,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 21,
   "firman": "Lalu kata Rut, perempuan Moab itu: \"Lagipula ia berkata kepadaku: Tetaplah dekat pengerja-pengerjaku sampai mereka menyelesaikan seluruh penyabitan ladangku.\""
 },
 {
   "id": 7173,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 22,
   "firman": "Lalu berkatalah Naomi kepada Rut, menantunya itu: \"Ya anakku, sebaiknya engkau keluar bersama-sama dengan pengerja-pengerjanya perempuan, supaya engkau jangan disusahi orang di ladang lain.\""
 },
 {
   "id": 7174,
   "kitab": "Rut",
   "pasal": 2,
   "ayat": 23,
   "firman": "Demikianlah Rut tetap dekat pada pengerja-pengerja perempuan Boas untuk memungut, sampai musim menuai jelai dan musim menuai gandum telah berakhir. Dan selama itu ia tinggal pada mertuanya."
 },
 {
   "id": 7175,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 1,
   "firman": "Lalu Naomi, mertuanya itu, berkata kepadanya: \"Anakku, apakah tidak ada baiknya jika aku mencari tempat perlindungan bagimu supaya engkau berbahagia?"
 },
 {
   "id": 7176,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 2,
   "firman": "Maka sekarang, bukankah Boas, yang pengerja-pengerjanya perempuan telah kautemani itu, adalah sanak kita? Dia pada malam ini menampi jelai di tempat pengirikan;"
 },
 {
   "id": 7177,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 3,
   "firman": "maka mandilah dan beruraplah, pakailah pakaian bagusmu dan pergilah ke tempat pengirikan itu. Tetapi janganlah engkau ketahuan kepada orang itu, sebelum ia selesai makan dan minum."
 },
 {
   "id": 7178,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 4,
   "firman": "Jika ia membaringkan diri tidur, haruslah engkau perhatikan baik-baik tempat ia berbaring; kemudian datanglah dekat, singkapkanlah selimut dari kakinya dan berbaringlah di sana. Maka ia akan memberitahukan kepadamu apa yang harus kaulakukan.\""
 },
 {
   "id": 7179,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 5,
   "firman": "Lalu kata Rut kepadanya: \"Segala yang engkau katakan itu akan kulakukan.\""
 },
 {
   "id": 7180,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sesudah itu pergilah ia ke tempat pengirikan dan dilakukannyalah tepat seperti yang diperintahkan mertuanya kepadanya."
 },
 {
   "id": 7181,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 7,
   "firman": "Setelah Boas habis makan dan minum dan hatinya gembira, datanglah ia untuk membaringkan diri tidur pada ujung timbunan jelai itu. Kemudian datanglah perempuan itu dekat dengan diam-diam, disingkapkannyalah selimut dari kaki Boas dan berbaringlah ia di situ."
 },
 {
   "id": 7182,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 8,
   "firman": "Pada waktu tengah malam dengan terkejut terjagalah orang itu, lalu meraba-raba ke sekelilingnya, dan ternyata ada seorang perempuan berbaring di sebelah kakinya."
 },
 {
   "id": 7183,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 9,
   "firman": "Bertanyalah ia: \"Siapakah engkau ini?\" Jawabnya: \"Aku Rut, hambamu: kembangkanlah kiranya sayapmu melindungi hambamu ini, sebab engkaulah seorang kaum yang wajib menebus kami.\""
 },
 {
   "id": 7184,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 10,
   "firman": "Lalu katanya: \"Diberkatilah kiranya engkau oleh TUHAN, ya anakku! Sekarang engkau menunjukkan kasihmu lebih nyata lagi dari pada yang pertama kali itu, karena engkau tidak mengejar-ngejar orang-orang muda, baik yang miskin maupun yang kaya."
 },
 {
   "id": 7185,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 11,
   "firman": "Oleh sebab itu, anakku, janganlah takut; segala yang kaukatakan itu akan kulakukan kepadamu; sebab setiap orang dalam kota kami tahu, bahwa engkau seorang perempuan baik-baik."
 },
 {
   "id": 7186,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 12,
   "firman": "Maka sekarang, memang aku seorang kaum yang wajib menebus, tetapi walaupun demikian masih ada lagi seorang penebus, yang lebih dekat dari padaku."
 },
 {
   "id": 7187,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tinggallah di sini malam ini; dan besok pagi, jika ia mau menebus engkau, baik, biarlah ia menebus; tetapi jika ia tidak suka menebus engkau, maka akulah yang akan menebus engkau, demi TUHAN yang hidup. Berbaring sajalah tidur sampai pagi.\""
 },
 {
   "id": 7188,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 14,
   "firman": "Jadi berbaringlah ia tidur di sebelah kakinya sampai pagi; lalu bangunlah ia, sebelum orang dapat kenal-mengenal, sebab kata Boas: \"Janganlah diketahui orang, bahwa seorang perempuan datang ke tempat pengirikan.\""
 },
 {
   "id": 7189,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 15,
   "firman": "Lagi katanya: \"Berikanlah selendang yang engkau pakai itu dan tadahkanlah itu.\" Lalu ditadahkannya selendang itu. Kemudian ditakarnyalah enam takar jelai ke dalam selendang itu. Sesudah itu pergilah Boas ke kota."
 },
 {
   "id": 7190,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 16,
   "firman": "Setelah perempuan itu sampai kepada mertuanya, berkatalah mertuanya itu: \"Bagaimana, anakku?\" Lalu diceritakannyalah semua yang dilakukan orang itu kepadanya"
 },
 {
   "id": 7191,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 17,
   "firman": "serta berkata: \"Yang enam takar jelai ini diberikannya kepadaku, sebab katanya: Engkau tidak boleh pulang kepada mertuamu dengan tangan hampa.\""
 },
 {
   "id": 7192,
   "kitab": "Rut",
   "pasal": 3,
   "ayat": 18,
   "firman": "Lalu kata mertuanya itu: \"Duduk sajalah menanti, anakku, sampai engkau mengetahui, bagaimana kesudahan perkara itu; sebab orang itu tidak akan berhenti, sebelum diselesaikannya perkara itu pada hari ini juga.\""
 },
 {
   "id": 7193,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 1,
   "firman": "Boas telah pergi ke pintu gerbang dan duduk di sana. Kebetulan lewatlah penebus yang disebutkan Boas itu. Lalu berkatalah Boas: \"Hai saudara, datanglah dahulu ke mari, duduklah di sini.\" Maka datanglah ia, lalu duduk."
 },
 {
   "id": 7194,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 2,
   "firman": "Kemudian dipilihnyalah sepuluh orang dari para tua-tua kota itu, dan berkata: \"Duduklah kamu di sini.\" Maka duduklah mereka."
 },
 {
   "id": 7195,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu berkatalah ia kepada penebus itu: \"Tanah milik kepunyaan saudara kita Elimelekh hendak dijual oleh Naomi, yang telah pulang dari daerah Moab."
 },
 {
   "id": 7196,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 4,
   "firman": "Jadi pikirku: baik juga hal itu kusampaikan kepadamu sebagai berikut: Belilah tanah itu di depan orang-orang yang duduk di sini dan di depan para tua-tua bangsa kita. Jika engkau mau menebusnya, tebuslah; tetapi jika engkau tidak mau menebusnya, beritahukanlah kepadaku, supaya aku tahu, sebab tidak ada orang yang dapat menebusnya kecuali engkau, dan sesudah engkau: aku.\" Lalu berkatalah ia: \"Aku akan menebusnya.\""
 },
 {
   "id": 7197,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 5,
   "firman": "Tetapi kata Boas: \"Pada waktu engkau membeli tanah itu dari tangan Naomi, engkau memperoleh Rut juga, perempuan Moab, isteri orang yang telah mati itu, untuk menegakkan nama orang itu di atas milik pusakanya.\""
 },
 {
   "id": 7198,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lalu berkatalah penebus itu: \"Jika demikian, aku ini tidak dapat menebusnya, sebab aku akan merusakkan milik pusakaku sendiri. Aku mengharap engkau menebus apa yang seharusnya aku tebus, sebab aku tidak dapat menebusnya.\""
 },
 {
   "id": 7199,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 7,
   "firman": "Beginilah kebiasaan dahulu di Israel dalam hal menebus dan menukar: setiap kali orang hendak menguatkan sesuatu perkara, maka yang seorang menanggalkan kasutnya sebelah dan memberikannya kepada yang lain. Demikianlah caranya orang mensahkan perkara di Israel."
 },
 {
   "id": 7200,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 8,
   "firman": "Lalu penebus itu berkata kepada Boas: \"Engkau saja yang membelinya.\" Dan ditanggalkannyalah kasutnya."
 },
 {
   "id": 7201,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 9,
   "firman": "Kemudian berkatalah Boas kepada para tua-tua dan kepada semua orang di situ: \"Kamulah pada hari ini menjadi saksi, bahwa segala milik Elimelekh dan segala milik Kilyon dan Mahlon, aku beli dari tangan Naomi;"
 },
 {
   "id": 7202,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 10,
   "firman": "juga Rut, perempuan Moab itu, isteri Mahlon, aku peroleh menjadi isteriku untuk menegakkan nama orang yang telah mati itu di atas milik pusakanya. Demikianlah nama orang itu tidak akan lenyap dari antara saudara-saudaranya dan dari antara warga kota. Kamulah pada hari ini menjadi saksi.\""
 },
 {
   "id": 7203,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 11,
   "firman": "Dan seluruh orang banyak yang hadir di pintu gerbang, dan para tua-tua berkata: \"Kamilah menjadi saksi. TUHAN kiranya membuat perempuan yang akan masuk ke rumahmu itu sama seperti Rahel dan Lea, yang keduanya telah membangunkan umat Israel. Biarlah engkau menjadi makmur di Efrata dan biarlah namamu termasyhur di Betlehem,"
 },
 {
   "id": 7204,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 12,
   "firman": "keturunanmu kiranya menjadi seperti keturunan Peres yang dilahirkan Tamar bagi Yehuda oleh karena anak-anak yang akan diberikan TUHAN kepadamu dari perempuan muda ini!\""
 },
 {
   "id": 7205,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 13,
   "firman": "Lalu Boas mengambil Rut dan perempuan itu menjadi isterinya dan dihampirinyalah dia. Maka atas karunia TUHAN perempuan itu mengandung, lalu melahirkan seorang anak laki-laki."
 },
 {
   "id": 7206,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 14,
   "firman": "Sebab itu perempuan-perempuan berkata kepada Naomi: \"Terpujilah TUHAN, yang telah rela menolong engkau pada hari ini dengan seorang penebus. Termasyhurlah kiranya nama anak itu di Israel."
 },
 {
   "id": 7207,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 15,
   "firman": "Dan dialah yang akan menyegarkan jiwamu dan memelihara engkau pada waktu rambutmu telah putih; sebab menantumu yang mengasihi engkau telah melahirkannya, perempuan yang lebih berharga bagimu dari tujuh anak laki-laki.\""
 },
 {
   "id": 7208,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 16,
   "firman": "Dan Naomi mengambil anak itu serta meletakkannya pada pangkuannya dan dialah yang mengasuhnya."
 },
 {
   "id": 7209,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 17,
   "firman": "Dan tetangga-tetangga perempuan memberi nama kepada anak itu, katanya: \"Pada Naomi telah lahir seorang anak laki-laki\"; lalu mereka menyebutkan namanya Obed. Dialah ayah Isai, ayah Daud."
 },
 {
   "id": 7210,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 18,
   "firman": "Inilah keturunan Peres: Peres memperanakkan Hezron,"
 },
 {
   "id": 7211,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 19,
   "firman": "Hezron memperanakkan Ram, Ram memperanakkan Aminadab,"
 },
 {
   "id": 7212,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 20,
   "firman": "Aminadab memperanakkan Nahason, Nahason memperanakkan Salmon,"
 },
 {
   "id": 7213,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 21,
   "firman": "Salmon memperanakkan Boas, Boas memperanakkan Obed,"
 },
 {
   "id": 7214,
   "kitab": "Rut",
   "pasal": 4,
   "ayat": 22,
   "firman": "Obed memperanakkan Isai dan Isai memperanakkan Daud."
 },
 {
   "id": 7215,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ada seorang laki-laki dari Ramataim-Zofim, dari pegunungan Efraim, namanya Elkana bin Yeroham bin Elihu bin Tohu bin Zuf, seorang Efraim."
 },
 {
   "id": 7216,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 2,
   "firman": "Orang ini mempunyai dua isteri: yang seorang bernama Hana dan yang lain bernama Penina; Penina mempunyai anak, tetapi Hana tidak."
 },
 {
   "id": 7217,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 3,
   "firman": "Orang itu dari tahun ke tahun pergi meninggalkan kotanya untuk sujud menyembah dan mempersembahkan korban kepada TUHAN semesta alam di Silo. Di sana yang menjadi imam TUHAN ialah kedua anak Eli, Hofni dan Pinehas."
 },
 {
   "id": 7218,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 4,
   "firman": "Pada hari Elkana mempersembahkan korban, diberikannyalah kepada Penina, isterinya, dan kepada semua anaknya yang laki-laki dan perempuan masing-masing sebagian."
 },
 {
   "id": 7219,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 5,
   "firman": "Meskipun ia mengasihi Hana, ia memberikan kepada Hana hanya satu bagian, sebab TUHAN telah menutup kandungannya."
 },
 {
   "id": 7220,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 6,
   "firman": "Tetapi madunya selalu menyakiti hatinya supaya ia gusar, karena TUHAN telah menutup kandungannya."
 },
 {
   "id": 7221,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 7,
   "firman": "Demikianlah terjadi dari tahun ke tahun; setiap kali Hana pergi ke rumah TUHAN, Penina menyakiti hati Hana, sehingga ia menangis dan tidak mau makan."
 },
 {
   "id": 7222,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 8,
   "firman": "Lalu Elkana, suaminya, berkata kepadanya: \"Hana, mengapa engkau menangis dan mengapa engkau tidak mau makan? Mengapa hatimu sedih? Bukankah aku lebih berharga bagimu dari pada sepuluh anak laki-laki?\""
 },
 {
   "id": 7223,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 9,
   "firman": "Pada suatu kali, setelah mereka habis makan dan minum di Silo, berdirilah Hana, sedang imam Eli duduk di kursi dekat tiang pintu bait suci TUHAN,"
 },
 {
   "id": 7224,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 10,
   "firman": "dan dengan hati pedih ia berdoa kepada TUHAN sambil menangis tersedu-sedu."
 },
 {
   "id": 7225,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 11,
   "firman": "Kemudian bernazarlah ia, katanya: \"TUHAN semesta alam, jika sungguh-sungguh Engkau memperhatikan sengsara hamba-Mu ini dan mengingat kepadaku dan tidak melupakan hamba-Mu ini, tetapi memberikan kepada hamba-Mu ini seorang anak laki-laki, maka aku akan memberikan dia kepada TUHAN untuk seumur hidupnya dan pisau cukur tidak akan menyentuh kepalanya.\""
 },
 {
   "id": 7226,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 12,
   "firman": "Ketika perempuan itu terus-menerus berdoa di hadapan TUHAN, maka Eli mengamat-amati mulut perempuan itu;"
 },
 {
   "id": 7227,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 13,
   "firman": "dan karena Hana berkata-kata dalam hatinya dan hanya bibirnya saja bergerak-gerak, tetapi suaranya tidak kedengaran, maka Eli menyangka perempuan itu mabuk."
 },
 {
   "id": 7228,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 14,
   "firman": "Lalu kata Eli kepadanya: \"Berapa lama lagi engkau berlaku sebagai orang mabuk? Lepaskanlah dirimu dari pada mabukmu.\""
 },
 {
   "id": 7229,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 15,
   "firman": "Tetapi Hana menjawab: \"Bukan, tuanku, aku seorang perempuan yang sangat bersusah hati; anggur ataupun minuman yang memabukkan tidak kuminum, melainkan aku mencurahkan isi hatiku di hadapan TUHAN."
 },
 {
   "id": 7230,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 16,
   "firman": "Janganlah anggap hambamu ini seorang perempuan dursila; sebab karena besarnya cemas dan sakit hati aku berbicara demikian lama.\""
 },
 {
   "id": 7231,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 17,
   "firman": "Jawab Eli: \"Pergilah dengan selamat, dan Allah Israel akan memberikan kepadamu apa yang engkau minta dari pada-Nya.\""
 },
 {
   "id": 7232,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sesudah itu berkatalah perempuan itu: \"Biarlah hambamu ini mendapat belas kasihan dari padamu.\" Lalu keluarlah perempuan itu, ia mau makan dan mukanya tidak muram lagi."
 },
 {
   "id": 7233,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 19,
   "firman": "Keesokan harinya bangunlah mereka itu pagi-pagi, lalu sujud menyembah di hadapan TUHAN; kemudian pulanglah mereka ke rumahnya di Rama. Ketika Elkana bersetubuh dengan Hana, isterinya, TUHAN ingat kepadanya."
 },
 {
   "id": 7234,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 20,
   "firman": "Maka setahun kemudian mengandunglah Hana dan melahirkan seorang anak laki-laki. Ia menamai anak itu Samuel, sebab katanya: \"Aku telah memintanya dari pada TUHAN.\""
 },
 {
   "id": 7235,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 21,
   "firman": "Elkana, laki-laki itu, pergi dengan seisi rumahnya mempersembahkan korban sembelihan tahunan dan korban nazarnya kepada TUHAN."
 },
 {
   "id": 7236,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tetapi Hana tidak ikut pergi, sebab katanya kepada suaminya: \"Nanti apabila anak itu cerai susu, aku akan mengantarkan dia, maka ia akan menghadap ke hadirat TUHAN dan tinggal di sana seumur hidupnya.\""
 },
 {
   "id": 7237,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 23,
   "firman": "Kemudian Elkana, suaminya itu, berkata kepadanya: \"Perbuatlah apa yang kaupandang baik; tinggallah sampai engkau menyapih dia; hanya, TUHAN kiranya menepati janji-Nya.\" Jadi tinggallah perempuan itu dan menyusui anaknya sampai disapihnya."
 },
 {
   "id": 7238,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 24,
   "firman": "Setelah perempuan itu menyapih anaknya, dibawanyalah dia, dengan seekor lembu jantan yang berumur tiga tahun, satu efa tepung dan sebuyung anggur, lalu diantarkannya ke dalam rumah TUHAN di Silo. Waktu itu masih kecil betul kanak-kanak itu."
 },
 {
   "id": 7239,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 25,
   "firman": "Setelah mereka menyembelih lembu, mereka mengantarkan kanak-kanak itu kepada Eli;"
 },
 {
   "id": 7240,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 26,
   "firman": "lalu kata perempuan itu: \"Mohon bicara tuanku, demi tuanku hidup, akulah perempuan yang dahulu berdiri di sini dekat tuanku untuk berdoa kepada TUHAN."
 },
 {
   "id": 7241,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 27,
   "firman": "Untuk mendapat anak inilah aku berdoa, dan TUHAN telah memberikan kepadaku, apa yang kuminta dari pada-Nya."
 },
 {
   "id": 7242,
   "kitab": "1Sa",
   "pasal": 1,
   "ayat": 28,
   "firman": "Maka akupun menyerahkannya kepada TUHAN; seumur hidup terserahlah ia kiranya kepada TUHAN.\" Lalu sujudlah mereka di sana menyembah kepada TUHAN."
 },
 {
   "id": 7243,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 1,
   "firman": "Lalu berdoalah Hana, katanya: \"Hatiku bersukaria karena TUHAN, tanduk kekuatanku ditinggikan oleh TUHAN; mulutku mencemoohkan musuhku, sebab aku bersukacita karena pertolongan-Mu."
 },
 {
   "id": 7244,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tidak ada yang kudus seperti TUHAN, sebab tidak ada yang lain kecuali Engkau dan tidak ada gunung batu seperti Allah kita."
 },
 {
   "id": 7245,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 3,
   "firman": "Janganlah kamu selalu berkata sombong, janganlah caci maki keluar dari mulutmu. Karena TUHAN itu Allah yang mahatahu, dan oleh Dia perbuatan-perbuatan diuji."
 },
 {
   "id": 7246,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 4,
   "firman": "Busur pada pahlawan telah patah, tetapi orang-orang yang terhuyung-huyung, pinggangnya berikatkan kekuatan."
 },
 {
   "id": 7247,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 5,
   "firman": "Siapa yang kenyang dahulu, sekarang menyewakan dirinya karena makanan, tetapi orang yang lapar dahulu, sekarang boleh beristirahat. Bahkan orang yang mandul melahirkan tujuh anak, tetapi orang yang banyak anaknya, menjadi layu."
 },
 {
   "id": 7248,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 6,
   "firman": "TUHAN mematikan dan menghidupkan, Ia menurunkan ke dalam dunia orang mati dan mengangkat dari sana."
 },
 {
   "id": 7249,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 7,
   "firman": "TUHAN membuat miskin dan membuat kaya; Ia merendahkan, dan meninggikan juga."
 },
 {
   "id": 7250,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 8,
   "firman": "Ia menegakkan orang yang hina dari dalam debu, dan mengangkat orang yang miskin dari lumpur, untuk mendudukkan dia bersama-sama dengan para bangsawan, dan membuat dia memiliki kursi kehormatan. Sebab TUHAN mempunyai alas bumi; dan di atasnya Ia menaruh daratan."
 },
 {
   "id": 7251,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 9,
   "firman": "Langkah kaki orang-orang yang dikasihi-Nya dilindungi-Nya, tetapi orang-orang fasik akan mati binasa dalam kegelapan, sebab bukan oleh karena kekuatannya sendiri seseorang berkuasa."
 },
 {
   "id": 7252,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 10,
   "firman": "Orang yang berbantah dengan TUHAN akan dihancurkan; atas mereka Ia mengguntur di langit. TUHAN mengadili bumi sampai ke ujung-ujungnya; Ia memberi kekuatan kepada raja yang diangkat-Nya dan meninggikan tanduk kekuatan orang yang diurapi-Nya.\""
 },
 {
   "id": 7253,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 11,
   "firman": "Lalu pulanglah Elkana ke Rama tetapi anak itu menjadi pelayan TUHAN di bawah pengawasan imam Eli."
 },
 {
   "id": 7254,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 12,
   "firman": "Adapun anak-anak lelaki Eli adalah orang-orang dursila; mereka tidak mengindahkan TUHAN,"
 },
 {
   "id": 7255,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 13,
   "firman": "ataupun batas hak para imam terhadap bangsa itu. Setiap kali seseorang mempersembahkan korban sembelihan, sementara daging itu dimasak, datanglah bujang imam membawa garpu bergigi tiga di tangannya"
 },
 {
   "id": 7256,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 14,
   "firman": "dan dicucukkannya ke dalam bejana atau ke dalam kuali atau ke dalam belanga atau ke dalam periuk. Segala yang ditarik dengan garpu itu ke atas, diambil imam itu untuk dirinya sendiri. Demikianlah mereka memperlakukan semua orang Israel yang datang ke sana, ke Silo."
 },
 {
   "id": 7257,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 15,
   "firman": "Bahkan sebelum lemaknya dibakar, bujang imam itu datang, lalu berkata kepada orang yang mempersembahkan korban itu: \"Berikanlah daging kepada imam untuk dipanggang, sebab ia tidak mau menerima dari padamu daging yang dimasak, hanya yang mentah saja.\""
 },
 {
   "id": 7258,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 16,
   "firman": "Apabila orang itu menjawabnya: \"Bukankah lemak itu harus dibakar dahulu, kemudian barulah ambil bagimu sesuka hatimu,\" maka berkatalah ia kepada orang itu: \"Sekarang juga harus kauberikan, kalau tidak, aku akan mengambilnya dengan kekerasan.\""
 },
 {
   "id": 7259,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 17,
   "firman": "Dengan demikian sangat besarlah dosa kedua orang muda itu di hadapan TUHAN, sebab mereka memandang rendah korban untuk TUHAN."
 },
 {
   "id": 7260,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 18,
   "firman": "Adapun Samuel menjadi pelayan di hadapan TUHAN; ia masih anak-anak, yang tubuhnya berlilitkan baju efod dari kain lenan."
 },
 {
   "id": 7261,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 19,
   "firman": "Setiap tahun ibunya membuatkan dia jubah kecil dan membawa jubah itu kepadanya, apabila ia bersama-sama suaminya pergi mempersembahkan korban sembelihan tahunan."
 },
 {
   "id": 7262,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 20,
   "firman": "Lalu Eli memberkati Elkana dan isterinya, katanya: \"TUHAN kiranya memberikan keturunan kepadamu dari perempuan ini pengganti yang telah diserahkannya kepada TUHAN.\" Sesudah itu pulanglah mereka ke tempat kediamannya."
 },
 {
   "id": 7263,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 21,
   "firman": "Dan TUHAN mengindahkan Hana, sehingga dia mengandung dan melahirkan tiga anak laki-laki dan dua anak perempuan lagi. Sementara itu makin besarlah Samuel yang muda itu di hadapan TUHAN."
 },
 {
   "id": 7264,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 22,
   "firman": "Eli telah sangat tua. Apabila didengarnya segala sesuatu yang dilakukan anak-anaknya terhadap semua orang Israel dan bahwa mereka itu tidur dengan perempuan-perempuan yang melayani di depan pintu Kemah Pertemuan,"
 },
 {
   "id": 7265,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 23,
   "firman": "berkatalah ia kepada mereka: \"Mengapa kamu melakukan hal-hal yang begitu, sehingga kudengar dari segenap bangsa ini tentang perbuatan-perbuatanmu yang jahat itu?"
 },
 {
   "id": 7266,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 24,
   "firman": "Janganlah begitu, anak-anakku. Bukan kabar baik yang kudengar itu bahwa kamu menyebabkan umat TUHAN melakukan pelanggaran."
 },
 {
   "id": 7267,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 25,
   "firman": "Jika seseorang berdosa terhadap seorang yang lain, maka Allah yang akan mengadili; tetapi jika seseorang berdosa terhadap TUHAN, siapakah yang menjadi perantara baginya?\" Tetapi tidaklah didengarkan mereka perkataan ayahnya itu, sebab TUHAN hendak mematikan mereka."
 },
 {
   "id": 7268,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 26,
   "firman": "Tetapi Samuel yang muda itu, semakin besar dan semakin disukai, baik di hadapan TUHAN maupun di hadapan manusia."
 },
 {
   "id": 7269,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 27,
   "firman": "Seorang abdi Allah datang kepada Eli dan berkata kepadanya: \"Beginilah firman TUHAN: Bukankah dengan nyata Aku menyatakan diri-Ku kepada nenek moyangmu, ketika mereka masih di Mesir dan takluk kepada keturunan Firaun?"
 },
 {
   "id": 7270,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 28,
   "firman": "Dan Aku telah memilihnya dari segala suku Israel menjadi imam bagi-Ku, supaya ia mempersembahkan korban di atas mezbah-Ku, membakar ukupan dan memakai baju efod di hadapan-Ku; kepada kaummu telah Kuserahkan segala korban api-apian orang Israel."
 },
 {
   "id": 7271,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 29,
   "firman": "Mengapa engkau memandang dengan loba kepada korban sembelihan-Ku dan korban sajian-Ku, yang telah Kuperintahkan, dan mengapa engkau menghormati anak-anakmu lebih dari pada-Ku, sambil kamu menggemukkan dirimu dengan bagian yang terbaik dari setiap korban sajian umat-Ku Israel?"
 },
 {
   "id": 7272,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 30,
   "firman": "Sebab itu--demikianlah firman TUHAN, Allah Israel--sesungguhnya Aku telah berjanji: Keluargamu dan kaummu akan hidup di hadapan-Ku selamanya, tetapi sekarang--demikianlah firman TUHAN--:Jauhlah hal itu dari pada-Ku! Sebab siapa yang menghormati Aku, akan Kuhormati, tetapi siapa yang menghina Aku, akan dipandang rendah."
 },
 {
   "id": 7273,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 31,
   "firman": "Sesungguhnya akan datang waktunya, bahwa Aku akan mematahkan tangan kekuatanmu dan tangan kekuatan kaummu, sehingga tidak ada seorang kakek dalam keluargamu."
 },
 {
   "id": 7274,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 32,
   "firman": "Maka engkau akan memandang dengan mata bermusuhan kepada segala kebaikan yang akan Kulakukan kepada Israel dan dalam keluargamu takkan ada seorang kakek untuk selamanya."
 },
 {
   "id": 7275,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 33,
   "firman": "Tetapi seorang dari padamu yang tidak Kulenyapkan dari lingkungan mezbah-Ku akan membuat matamu rusak dan jiwamu merana; segala tambahan keluargamu akan mati oleh pedang lawan."
 },
 {
   "id": 7276,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 34,
   "firman": "Inilah yang akan menjadi tanda bagimu, yakni apa yang akan terjadi kepada kedua anakmu itu, Hofni dan Pinehas: pada hari yang sama keduanya akan mati."
 },
 {
   "id": 7277,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 35,
   "firman": "Dan Aku akan mengangkat bagi-Ku seorang imam kepercayaan, yang berlaku sesuai dengan hati-Ku dan jiwa-Ku, dan Aku akan membangunkan baginya keturunan yang teguh setia, sehingga ia selalu hidup di hadapan orang yang Kuurapi."
 },
 {
   "id": 7278,
   "kitab": "1Sa",
   "pasal": 2,
   "ayat": 36,
   "firman": "Kemudian siapa yang masih tinggal hidup dari keturunanmu akan datang sujud menyembah kepadanya meminta sekeping uang perak atau sepotong roti, dan akan berkata: Tempatkanlah kiranya aku dalam salah satu golongan imam itu, supaya aku dapat makan sekerat roti.\""
 },
 {
   "id": 7279,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 1,
   "firman": "Samuel yang muda itu menjadi pelayan TUHAN di bawah pengawasan Eli. Pada masa itu firman TUHAN jarang; penglihatan-penglihatanpun tidak sering."
 },
 {
   "id": 7280,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 2,
   "firman": "Pada suatu hari Eli, yang matanya mulai kabur dan tidak dapat melihat dengan baik, sedang berbaring di tempat tidurnya."
 },
 {
   "id": 7281,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 3,
   "firman": "Lampu rumah Allah belum lagi padam. Samuel telah tidur di dalam bait suci TUHAN, tempat tabut Allah."
 },
 {
   "id": 7282,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 4,
   "firman": "Lalu TUHAN memanggil: \"Samuel! Samuel!\", dan ia menjawab: \"Ya, bapa.\""
 },
 {
   "id": 7283,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 5,
   "firman": "Lalu berlarilah ia kepada Eli, serta katanya: \"Ya, bapa, bukankah bapa memanggil aku?\" Tetapi Eli berkata: \"Aku tidak memanggil; tidurlah kembali.\" Lalu pergilah ia tidur."
 },
 {
   "id": 7284,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 6,
   "firman": "Dan TUHAN memanggil Samuel sekali lagi. Samuelpun bangunlah, lalu pergi mendapatkan Eli serta berkata: \"Ya, bapa, bukankah bapa memanggil aku?\" Tetapi Eli berkata: \"Aku tidak memanggil, anakku; tidurlah kembali.\""
 },
 {
   "id": 7285,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 7,
   "firman": "Samuel belum mengenal TUHAN; firman TUHAN belum pernah dinyatakan kepadanya."
 },
 {
   "id": 7286,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 8,
   "firman": "Dan TUHAN memanggil Samuel sekali lagi, untuk ketiga kalinya. Iapun bangunlah, lalu pergi mendapatkan Eli serta katanya: \"Ya, bapa, bukankah bapa memanggil aku?\" Lalu mengertilah Eli, bahwa Tuhanlah yang memanggil anak itu."
 },
 {
   "id": 7287,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 9,
   "firman": "Sebab itu berkatalah Eli kepada Samuel: \"Pergilah tidur dan apabila Ia memanggil engkau, katakanlah: Berbicaralah, TUHAN, sebab hamba-Mu ini mendengar.\" Maka pergilah Samuel dan tidurlah ia di tempat tidurnya."
 },
 {
   "id": 7288,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 10,
   "firman": "Lalu datanglah TUHAN, berdiri di sana dan memanggil seperti yang sudah-sudah: \"Samuel! Samuel!\" Dan Samuel menjawab: \"Berbicaralah, sebab hamba-Mu ini mendengar.\""
 },
 {
   "id": 7289,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 11,
   "firman": "Lalu berfirmanlah TUHAN kepada Samuel: \"Ketahuilah, Aku akan melakukan sesuatu di Israel, sehingga setiap orang yang mendengarnya, akan bising kedua telinganya."
 },
 {
   "id": 7290,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 12,
   "firman": "Pada waktu itu Aku akan menepati kepada Eli segala yang telah Kufirmankan tentang keluarganya, dari mula sampai akhir."
 },
 {
   "id": 7291,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 13,
   "firman": "Sebab telah Kuberitahukan kepadanya, bahwa Aku akan menghukum keluarganya untuk selamanya karena dosa yang telah diketahuinya, yakni bahwa anak-anaknya telah menghujat Allah, tetapi ia tidak memarahi mereka!"
 },
 {
   "id": 7292,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 14,
   "firman": "Sebab itu Aku telah bersumpah kepada keluarga Eli, bahwa dosa keluarga Eli takkan dihapuskan dengan korban sembelihan atau dengan korban sajian untuk selamanya.\""
 },
 {
   "id": 7293,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 15,
   "firman": "Samuel tidur sampai pagi; kemudian dibukanya pintu rumah TUHAN. Samuel segan memberitahukan penglihatan itu kepada Eli."
 },
 {
   "id": 7294,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 16,
   "firman": "Tetapi Eli memanggil Samuel, katanya: \"Samuel, anakku.\" Jawab Samuel: \"Ya, bapa.\""
 },
 {
   "id": 7295,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 17,
   "firman": "Kata Eli: \"Apakah yang disampaikan-Nya kepadamu? Janganlah kausembunyikan kepadaku. Kiranya beginilah Allah menghukum engkau, bahkan lebih lagi dari pada itu, jika engkau menyembunyikan sepatah katapun kepadaku dari apa yang disampaikan-Nya kepadamu itu.\""
 },
 {
   "id": 7296,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 18,
   "firman": "Lalu Samuel memberitahukan semuanya itu kepadanya dengan tidak menyembunyikan sesuatupun. Kemudian Eli berkata: \"Dia TUHAN, biarlah diperbuat-Nya apa yang dipandang-Nya baik.\""
 },
 {
   "id": 7297,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 19,
   "firman": "Dan Samuel makin besar dan TUHAN menyertai dia dan tidak ada satupun dari firman-Nya itu yang dibiarkan-Nya gugur."
 },
 {
   "id": 7298,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 20,
   "firman": "Maka tahulah seluruh Israel dari Dan sampai Bersyeba, bahwa kepada Samuel telah dipercayakan jabatan nabi TUHAN."
 },
 {
   "id": 7299,
   "kitab": "1Sa",
   "pasal": 3,
   "ayat": 21,
   "firman": "Dan TUHAN selanjutnya menampakkan diri di Silo, sebab Ia menyatakan diri di Silo kepada Samuel dengan perantaraan firman-Nya."
 },
 {
   "id": 7300,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 1,
   "firman": "Dan perkataan Samuel sampai ke seluruh Israel."
 },
 {
   "id": 7302,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 2,
   "firman": "Orang Filistin mengatur barisannya berhadapan dengan orang Israel. Ketika pertempuran menghebat, terpukullah kalah orang Israel oleh orang Filistin, yang menewaskan kira-kira empat ribu orang di medan pertempuran itu."
 },
 {
   "id": 7303,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 3,
   "firman": "Ketika tentara itu kembali ke perkemahan, berkatalah para tua-tua Israel: \"Mengapa TUHAN membuat kita terpukul kalah oleh orang Filistin pada hari ini? Marilah kita mengambil dari Silo tabut perjanjian TUHAN, supaya Ia datang ke tengah-tengah kita dan melepaskan kita dari tangan musuh kita.\""
 },
 {
   "id": 7304,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 4,
   "firman": "Kemudian bangsa itu menyuruh orang ke Silo, lalu mereka mengangkat dari sana tabut perjanjian TUHAN semesta alam, yang bersemayam di atas para kerub; kedua anak Eli, Hofni dan Pinehas, ada di sana dekat tabut perjanjian Allah itu."
 },
 {
   "id": 7305,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 5,
   "firman": "Segera sesudah tabut perjanjian TUHAN sampai ke perkemahan, bersoraklah seluruh orang Israel dengan nyaring, sehingga bumi bergetar."
 },
 {
   "id": 7306,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 6,
   "firman": "Dan orang Filistin yang mendengar bunyi sorak itu berkata: \"Apakah bunyi sorak yang nyaring di perkemahan orang Ibrani itu?\" Ketika diketahui mereka, bahwa tabut TUHAN telah sampai ke perkemahan itu,"
 },
 {
   "id": 7307,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 7,
   "firman": "ketakutanlah orang Filistin, sebab kata mereka: \"Allah mereka telah datang ke perkemahan itu,\" dan mereka berkata: \"Celakalah kita, sebab seperti itu belum pernah terjadi dahulu."
 },
 {
   "id": 7308,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 8,
   "firman": "Celakalah kita! Siapakah yang menolong kita dari tangan Allah yang maha dahsyat ini? Inilah juga Allah, yang telah menghajar orang Mesir dengan berbagai-bagai tulah di padang gurun."
 },
 {
   "id": 7309,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 9,
   "firman": "Kuatkanlah hatimu dan berlakulah seperti laki-laki, hai orang Filistin, supaya kamu jangan menjadi budak orang Ibrani itu, seperti mereka dahulu menjadi budakmu. Berlakulah seperti laki-laki dan berperanglah!\""
 },
 {
   "id": 7310,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 10,
   "firman": "Lalu berperanglah orang Filistin, sehingga orang Israel terpukul kalah. Mereka melarikan diri masing-masing ke kemahnya. Amatlah besar kekalahan itu: dari pihak Israel gugur tiga puluh ribu orang pasukan berjalan kaki."
 },
 {
   "id": 7311,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 11,
   "firman": "Lagipula tabut Allah dirampas dan kedua anak Eli, Hofni dan Pinehas, tewas."
 },
 {
   "id": 7312,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 12,
   "firman": "Seorang dari suku Benyamin lari dari barisan pertempuran dan pada hari itu juga ia sampai ke Silo dengan pakaian terkoyak-koyak dan dengan tanah di kepalanya."
 },
 {
   "id": 7313,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 13,
   "firman": "Ketika ia sampai, Eli sedang duduk di kursi di tepi jalan menunggu-nunggu, sebab hatinya berdebar-debar karena tabut Allah itu. Ketika orang itu masuk ke kota dan menceritakan kabar itu, berteriaklah seluruh kota itu."
 },
 {
   "id": 7314,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 14,
   "firman": "Ketika Eli mendengar bunyi teriakan itu, bertanyalah ia: \"Keributan apakah itu?\" Lalu bersegeralah orang itu mendapatkan Eli dan memberitahukannya kepadanya."
 },
 {
   "id": 7315,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 15,
   "firman": "Eli sudah sembilan puluh delapan tahun umurnya dan matanya sudah bular, sehingga ia tidak dapat melihat lagi."
 },
 {
   "id": 7316,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 16,
   "firman": "Kata orang itu kepada Eli: \"Aku datang dari medan pertempuran; baru hari ini aku melarikan diri dari medan pertempuran.\" Kata Eli: \"Bagaimana keadaannya, anakku?\""
 },
 {
   "id": 7317,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 17,
   "firman": "Jawab pembawa kabar itu: \"Orang Israel melarikan diri dari hadapan orang Filistin; kekalahan yang besar telah diderita oleh rakyat; lagipula kedua anakmu, Hofni dan Pinehas, telah tewas, dan tabut Allah sudah dirampas.\""
 },
 {
   "id": 7318,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 18,
   "firman": "Ketika disebutnya tabut Allah itu, jatuhlah Eli telentang dari kursi di sebelah pintu gerbang, batang lehernya patah dan ia mati. Sebab telah tua dan gemuk orangnya. Empat puluh tahun lamanya ia memerintah sebagai hakim atas orang Israel."
 },
 {
   "id": 7319,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 19,
   "firman": "Adapun menantunya perempuan, isteri Pinehas, sudah hamil tua. Ketika didengarnya kabar itu, bahwa tabut Allah telah dirampas dan mertuanya laki-laki serta suaminya telah mati, duduklah ia berlutut, lalu bersalin, sebab ia kedatangan sakit beranak."
 },
 {
   "id": 7320,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 20,
   "firman": "Ketika ia hampir mati, berkatalah perempuan-perempuan yang berdiri di dekatnya: \"Janganlah takut, sebab engkau telah melahirkan seorang anak laki-laki.\" Tetapi ia tidak menjawab dan tidak memperhatikannya."
 },
 {
   "id": 7321,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 21,
   "firman": "Ia menamai anak itu Ikabod, katanya: \"Telah lenyap kemuliaan dari Israel\" --karena tabut Allah sudah dirampas dan karena mertuanya dan suaminya."
 },
 {
   "id": 7322,
   "kitab": "1Sa",
   "pasal": 4,
   "ayat": 22,
   "firman": "Katanya: \"Telah lenyap kemuliaan dari Israel, sebab tabut Allah telah dirampas.\""
 },
 {
   "id": 7323,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 1,
   "firman": "Sesudah orang Filistin merampas tabut Allah, maka mereka membawanya dari Eben-Haezer ke Asdod."
 },
 {
   "id": 7324,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 2,
   "firman": "Orang Filistin mengambil tabut Allah itu, dibawanya masuk ke kuil Dagon dan diletakkannya di sisi Dagon."
 },
 {
   "id": 7325,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 3,
   "firman": "Ketika orang-orang Asdod bangun pagi-pagi pada keesokan harinya, tampaklah Dagon terjatuh dengan mukanya ke tanah di hadapan tabut TUHAN; lalu mereka mengambil Dagon dan mengembalikannya ke tempatnya."
 },
 {
   "id": 7326,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 4,
   "firman": "Tetapi ketika keesokan harinya mereka bangun pagi-pagi, tampaklah Dagon terjatuh dengan mukanya ke tanah di hadapan tabut TUHAN, tetapi kepala Dagon dan kedua belah tangannya terpenggal dan terpelanting ke ambang pintu, hanya badan Dagon itu yang masih tinggal."
 },
 {
   "id": 7327,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 5,
   "firman": "Itulah sebabnya para imam Dagon dan semua orang yang masuk ke dalam kuil Dagon tidak menginjak ambang pintu rumah Dagon yang di Asdod, sampai hari ini."
 },
 {
   "id": 7328,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 6,
   "firman": "Tangan TUHAN menekan orang-orang Asdod itu dengan berat dan Ia membingungkan mereka: Ia menghajar mereka dengan borok-borok, baik Asdod maupun daerahnya."
 },
 {
   "id": 7329,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 7,
   "firman": "Ketika dilihat orang-orang Asdod, bahwa demikian halnya, berkatalah mereka: \"Tabut Allah Israel tidak boleh tinggal pada kita, sebab tangan-Nya keras melawan kita dan melawan Dagon, allah kita.\""
 },
 {
   "id": 7330,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 8,
   "firman": "Sebab itu mereka memanggil berkumpul kepadanya semua raja kota orang Filistin dan berkata: \"Apakah yang akan kita lakukan dengan tabut Allah Israel itu?\" Lalu kata mereka: \"Tabut Allah Israel harus dipindahkan ke Gat.\" Jadi mereka memindahkan tabut Allah Israel itu ke sana."
 },
 {
   "id": 7331,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 9,
   "firman": "Tetapi setelah mereka memindahkannya, maka tangan TUHAN mendatangkan kegemparan yang sangat besar atas kota itu; Ia menghajar orang-orang kota itu, anak-anak dan orang dewasa, sehingga timbul borok-borok pada mereka."
 },
 {
   "id": 7332,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 10,
   "firman": "Lalu mereka mengantarkan tabut Allah itu ke Ekron. Tetapi sesampai tabut Allah itu di Ekron, berteriaklah orang Ekron itu, demikian: \"Mereka memindahkan tabut Allah Israel itu kepada kita untuk mematikan kita dan bangsa kita.\""
 },
 {
   "id": 7333,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 11,
   "firman": "Sebab itu mereka memanggil berkumpul semua raja kota orang Filistin itu dan berkata: \"Antarkanlah tabut Allah Israel itu; biarlah itu kembali ke tempatnya, supaya jangan dimatikannya kita dan bangsa kita.\" Sebab di seluruh kota itu ada kegemparan maut; tangan Allah menekan orang-orang di sana dengan sangat berat:"
 },
 {
   "id": 7334,
   "kitab": "1Sa",
   "pasal": 5,
   "ayat": 12,
   "firman": "orang-orang yang tidak mati, dihajar dengan borok-borok, sehingga teriakan kota itu naik ke langit."
 },
 {
   "id": 7335,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 1,
   "firman": "Setelah tujuh bulan lamanya tabut TUHAN itu ada di daerah orang Filistin,"
 },
 {
   "id": 7336,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 2,
   "firman": "maka orang Filistin itu memanggil para imam dan para petenung, lalu berkata kepada mereka: \"Apakah yang harus kami lakukan dengan tabut TUHAN itu? Beritahukanlah kepada kami, bagaimana kami harus mengantarkannya kembali ke tempatnya.\""
 },
 {
   "id": 7337,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 3,
   "firman": "Lalu kata mereka: \"Apabila kamu mengantarkan tabut Allah Israel itu, maka janganlah kamu mengantarkannya dengan tangan hampa, melainkan haruslah kamu membayar tebusan salah kepada-Nya; maka kamu akan menjadi sembuh dan kamu akan mengetahui, mengapa tangan-Nya tidak undur dari padamu.\""
 },
 {
   "id": 7338,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sesudah itu bertanyalah mereka: \"Apakah tebusan salah yang harus kami bayar kepada-Nya?\" Jawab mereka: \"Menurut jumlah raja-raja kota orang Filistin, lima borok emas dan lima tikus emas, sebab tulah yang sama menimpa kamu sekalian dan raja-raja kotamu."
 },
 {
   "id": 7339,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 5,
   "firman": "Jadi buatlah gambar borok-borokmu dan gambar tikus yang merusak tanahmu, dan sampaikanlah hormatmu kepada Allah Israel. Mungkin Ia akan mengangkat dari padamu, dari pada allahmu dan dari pada tanahmu tangan-Nya yang menekan dengan berat."
 },
 {
   "id": 7340,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 6,
   "firman": "Mengapa kamu berkeras hati, sama seperti orang Mesir dan Firaun berkeras hati? Bukankah mereka membiarkan bangsa itu pergi, ketika Ia mempermain-mainkan mereka?"
 },
 {
   "id": 7341,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 7,
   "firman": "Oleh sebab itu ambillah dan siapkanlah sebuah kereta baru dengan dua ekor lembu yang menyusui, yang belum pernah kena kuk, pasanglah kedua lembu itu pada kereta, tetapi bawalah anak-anaknya kembali ke rumah, supaya jangan mengikutinya lagi."
 },
 {
   "id": 7342,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 8,
   "firman": "Kemudian ambillah tabut TUHAN, muatkanlah itu ke atas kereta dan letakkanlah benda-benda emas, yang harus kamu bayar kepada-Nya sebagai tebusan salah, ke dalam suatu peti di sisinya. Dan biarkanlah tabut itu pergi."
 },
 {
   "id": 7343,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 9,
   "firman": "Perhatikanlah: apabila tabut itu mengambil jalan ke daerahnya, ke Bet-Semes, maka Dialah itu yang telah mendatangkan malapetaka yang hebat ini kepada kita. Dan jika tidak, maka kita mengetahui, bahwa bukanlah tangan-Nya yang telah menimpa kita; kebetulan saja hal itu terjadi kepada kita.\""
 },
 {
   "id": 7344,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 10,
   "firman": "Demikianlah diperbuat orang-orang itu. Mereka mengambil dua ekor lembu yang menyusui, dipasangnya pada kereta, tetapi anak-anaknya ditahan di rumah."
 },
 {
   "id": 7345,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 11,
   "firman": "Mereka meletakkan tabut TUHAN ke atas kereta, juga peti berisi tikus-tikus emas dan gambar benjol-benjol mereka."
 },
 {
   "id": 7346,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 12,
   "firman": "Lembu-lembu itu langsung mengikuti jalan yang ke Bet-Semes; melalui satu jalan raya, sambil menguak dengan tidak menyimpang ke kanan atau ke kiri, sedang raja-raja kota orang Filistin itu berjalan di belakangnya sampai ke daerah Bet-Semes."
 },
 {
   "id": 7347,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 13,
   "firman": "Orang-orang Bet-Semes sedang menuai gandum di lembah. Ketika mereka mengangkat muka, maka tampaklah kepada mereka tabut itu, lalu bersukacitalah mereka melihatnya."
 },
 {
   "id": 7348,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 14,
   "firman": "Kereta itu sampai ke ladang Yosua, orang Bet-Semes itu, dan berhenti di sana. Di sana ada batu besar. Mereka membelah kayu kereta itu dan mereka mempersembahkan lembu-lembu sebagai korban bakaran kepada TUHAN."
 },
 {
   "id": 7349,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 15,
   "firman": "Orang-orang suku Lewi menurunkan tabut TUHAN dengan peti yang ada di sebelahnya, yang di dalamnya ada benda-benda emas itu, lalu menaruhnya di atas batu besar itu, dan pada hari itu orang-orang Bet-Semes mempersembahkan korban bakaran dan korban sembelihan kepada TUHAN."
 },
 {
   "id": 7350,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 16,
   "firman": "Ketika kelima raja kota orang Filistin melihat hal itu, pulanglah mereka ke Ekron pada hari itu juga."
 },
 {
   "id": 7351,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 17,
   "firman": "Inilah benjol-benjol emas yang dibayar orang Filistin kepada TUHAN sebagai tebusan salah: dari Asdod satu, dari Gaza satu, dari Askelon satu, dari Gat satu, dari Ekron satu;"
 },
 {
   "id": 7352,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 18,
   "firman": "lagi tikus-tikus emas menurut jumlah segala kota orang Filistin kepunyaan kelima raja kota itu, baik kota-kota yang berkubu maupun dusun-dusun sekitarnya; dan batu besar, yang di atasnya diletakkan mereka tabut TUHAN, di ladang Yosua, orang Bet-Semes itu, adalah saksi sampai hari ini."
 },
 {
   "id": 7353,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 19,
   "firman": "Dan Ia membunuh beberapa orang Bet-Semes, karena mereka melihat ke dalam tabut TUHAN; Ia membunuh tujuh puluh orang dari rakyat itu. Rakyat itu berkabung, karena TUHAN telah menghajar mereka dengan dahsyatnya."
 },
 {
   "id": 7354,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 20,
   "firman": "Dan orang-orang Bet-Semes berkata: \"Siapakah yang tahan berdiri di hadapan TUHAN, Allah yang kudus ini? Kepada siapakah Ia akan berangkat meninggalkan kita?\""
 },
 {
   "id": 7355,
   "kitab": "1Sa",
   "pasal": 6,
   "ayat": 21,
   "firman": "Lalu mereka mengirim utusan kepada penduduk Kiryat-Yearim dengan pesan: \"Orang Filistin telah mengembalikan tabut TUHAN; datanglah dan angkutlah itu kepadamu.\""
 },
 {
   "id": 7356,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 1,
   "firman": "Lalu orang-orang Kiryat-Yearim datang, mereka mengangkut tabut TUHAN itu dan membawanya ke dalam rumah Abinadab yang di atas bukit. Dan Eleazar, anaknya, mereka kuduskan untuk menjaga tabut TUHAN itu."
 },
 {
   "id": 7357,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 2,
   "firman": "Sejak saat tabut itu tinggal di Kiryat-Yearim berlalulah waktu yang cukup lama, yakni dua puluh tahun, dan seluruh kaum Israel mengeluh kepada TUHAN."
 },
 {
   "id": 7358,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 3,
   "firman": "Lalu berkatalah Samuel kepada seluruh kaum Israel demikian: \"Jika kamu berbalik kepada TUHAN dengan segenap hati, maka jauhkanlah para allah asing dan para Asytoret dari tengah-tengahmu dan tujukan hatimu kepada TUHAN dan beribadahlah hanya kepada-Nya; maka Ia akan melepaskan kamu dari tangan orang Filistin.\""
 },
 {
   "id": 7359,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 4,
   "firman": "Kemudian orang-orang Israel menjauhkan para Baal dan para Asytoret dan beribadah hanya kepada TUHAN."
 },
 {
   "id": 7360,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 5,
   "firman": "Lalu berkatalah Samuel: \"Kumpulkanlah segenap orang Israel ke Mizpa; maka aku akan berdoa untuk kamu kepada TUHAN.\""
 },
 {
   "id": 7361,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 6,
   "firman": "Setelah berkumpul di Mizpa, mereka menimba air dan mencurahkannya di hadapan TUHAN. Mereka juga berpuasa pada hari itu dan berkata di sana: \"Kami telah berdosa kepada TUHAN.\" Dan Samuel menghakimi orang Israel di Mizpa."
 },
 {
   "id": 7362,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 7,
   "firman": "Ketika didengar orang Filistin, bahwa orang Israel telah berkumpul di Mizpa, majulah raja-raja kota orang Filistin mendatangi orang Israel. Serta didengar orang Israel demikian, maka ketakutanlah mereka terhadap orang Filistin."
 },
 {
   "id": 7363,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 8,
   "firman": "Lalu kata orang Israel kepada Samuel: \"Janganlah berhenti berseru bagi kami kepada TUHAN, Allah kita, supaya Ia menyelamatkan kami dari tangan orang Filistin itu.\""
 },
 {
   "id": 7364,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 9,
   "firman": "Sesudah itu Samuel mengambil seekor anak domba yang menyusu, lalu mempersembahkan seluruhnya kepada TUHAN sebagai korban bakaran. Dan ketika Samuel berseru kepada TUHAN bagi orang Israel, maka TUHAN menjawab dia."
 },
 {
   "id": 7365,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 10,
   "firman": "Sedang Samuel mempersembahkan korban bakaran itu, majulah orang Filistin berperang melawan orang Israel. Tetapi pada hari itu TUHAN mengguntur dengan bunyi yang hebat ke atas orang Filistin dan mengacaukan mereka, sehingga mereka terpukul kalah oleh orang Israel."
 },
 {
   "id": 7366,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 11,
   "firman": "Keluarlah orang-orang Israel dari Mizpa, mengejar orang Filistin itu dan memukul mereka kalah sampai hilir Bet-Kar."
 },
 {
   "id": 7367,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 12,
   "firman": "Kemudian Samuel mengambil sebuah batu dan mendirikannya antara Mizpa dan Yesana; ia menamainya Eben-Haezer, katanya: \"Sampai di sini TUHAN menolong kita.\""
 },
 {
   "id": 7368,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 13,
   "firman": "Demikianlah orang Filistin itu ditundukkan dan tidak lagi memasuki daerah Israel. Tangan TUHAN melawan orang Filistin seumur hidup Samuel,"
 },
 {
   "id": 7369,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 14,
   "firman": "dan kota-kota yang diambil orang Filistin dari pada Israel, kembali pula kepada Israel, mulai dari Ekron sampai Gat; dan orang Israel merebut daerah sekitarnya dari tangan orang Filistin. Antara orang Israel dan orang Amori ada damai."
 },
 {
   "id": 7370,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 15,
   "firman": "Samuel memerintah sebagai hakim atas orang Israel seumur hidupnya."
 },
 {
   "id": 7371,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dari tahun ke tahun ia berkeliling ke Betel, Gilgal dan Mizpa, dan memerintah atas orang Israel di segala tempat itu,"
 },
 {
   "id": 7372,
   "kitab": "1Sa",
   "pasal": 7,
   "ayat": 17,
   "firman": "lalu ia kembali ke Rama, sebab di sanalah rumahnya dan di sanalah ia memerintah atas orang Israel; dan di sana ia mendirikan mezbah bagi TUHAN."
 },
 {
   "id": 7373,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 1,
   "firman": "Setelah Samuel menjadi tua, diangkatnyalah anak-anaknya laki-laki menjadi hakim atas orang Israel."
 },
 {
   "id": 7374,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 2,
   "firman": "Nama anaknya yang sulung ialah Yoel, dan nama anaknya yang kedua ialah Abia; keduanya menjadi hakim di Bersyeba."
 },
 {
   "id": 7375,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 3,
   "firman": "Tetapi anak-anaknya itu tidak hidup seperti ayahnya; mereka mengejar laba, menerima suap dan memutarbalikkan keadilan."
 },
 {
   "id": 7376,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 4,
   "firman": "Sebab itu berkumpullah semua tua-tua Israel; mereka datang kepada Samuel di Rama"
 },
 {
   "id": 7377,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 5,
   "firman": "dan berkata kepadanya: \"Engkau sudah tua dan anak-anakmu tidak hidup seperti engkau; maka angkatlah sekarang seorang raja atas kami untuk memerintah kami, seperti pada segala bangsa-bangsa lain.\""
 },
 {
   "id": 7378,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 6,
   "firman": "Waktu mereka berkata: \"Berikanlah kepada kami seorang raja untuk memerintah kami,\" perkataan itu mengesalkan Samuel, maka berdoalah Samuel kepada TUHAN."
 },
 {
   "id": 7379,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 7,
   "firman": "TUHAN berfirman kepada Samuel: \"Dengarkanlah perkataan bangsa itu dalam segala hal yang dikatakan mereka kepadamu, sebab bukan engkau yang mereka tolak, tetapi Akulah yang mereka tolak, supaya jangan Aku menjadi raja atas mereka."
 },
 {
   "id": 7380,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 8,
   "firman": "Tepat seperti yang dilakukan mereka kepada-Ku sejak hari Aku menuntun mereka keluar dari Mesir sampai hari ini, yakni meninggalkan Daku dan beribadah kepada allah lain, demikianlah juga dilakukan mereka kepadamu."
 },
 {
   "id": 7381,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 9,
   "firman": "Oleh sebab itu dengarkanlah permintaan mereka, hanya peringatkanlah mereka dengan sungguh-sungguh dan beritahukanlah kepada mereka apa yang menjadi hak raja yang akan memerintah mereka.\""
 },
 {
   "id": 7382,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 10,
   "firman": "Dan Samuel menyampaikan segala firman TUHAN kepada bangsa itu, yang meminta seorang raja kepadanya,"
 },
 {
   "id": 7383,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 11,
   "firman": "katanya: \"Inilah yang menjadi hak raja yang akan memerintah kamu itu: anak-anakmu laki-laki akan diambilnya dan dipekerjakannya pada keretanya dan pada kudanya, dan mereka akan berlari di depan keretanya;"
 },
 {
   "id": 7384,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 12,
   "firman": "ia akan menjadikan mereka kepala pasukan seribu dan kepala pasukan lima puluh; mereka akan membajak ladangnya dan mengerjakan penuaian baginya; senjata-senjatanya dan perkakas keretanya akan dibuat mereka."
 },
 {
   "id": 7385,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 13,
   "firman": "Anak-anakmu perempuan akan diambilnya sebagai juru campur rempah-rempah, juru masak dan juru makanan."
 },
 {
   "id": 7386,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 14,
   "firman": "Selanjutnya dari ladangmu, kebun anggurmu dan kebun zaitunmu akan diambilnya yang paling baik dan akan diberikannya kepada pegawai-pegawainya"
 },
 {
   "id": 7387,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 15,
   "firman": "dari gandummu dan hasil kebun anggurmu akan diambilnya sepersepuluh dan akan diberikannya kepada pegawai-pegawai istananya dan kepada pegawai-pegawainya yang lain."
 },
 {
   "id": 7388,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 16,
   "firman": "Budak-budakmu laki-laki dan budak-budakmu perempuan, ternakmu yang terbaik dan keledai-keledaimu akan diambilnya dan dipakainya untuk pekerjaannya."
 },
 {
   "id": 7389,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 17,
   "firman": "Dari kambing dombamu akan diambilnya sepersepuluh, dan kamu sendiri akan menjadi budaknya."
 },
 {
   "id": 7390,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 18,
   "firman": "Pada waktu itu kamu akan berteriak karena rajamu yang kamu pilih itu, tetapi TUHAN tidak akan menjawab kamu pada waktu itu.\""
 },
 {
   "id": 7391,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 19,
   "firman": "Tetapi bangsa itu menolak mendengarkan perkataan Samuel dan mereka berkata: \"Tidak, harus ada raja atas kami;"
 },
 {
   "id": 7392,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 20,
   "firman": "maka kamipun akan sama seperti segala bangsa-bangsa lain; raja kami akan menghakimi kami dan memimpin kami dalam perang.\""
 },
 {
   "id": 7393,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 21,
   "firman": "Samuel mendengar segala perkataan bangsa itu, dan menyampaikannya kepada TUHAN."
 },
 {
   "id": 7394,
   "kitab": "1Sa",
   "pasal": 8,
   "ayat": 22,
   "firman": "TUHAN berfirman kepada Samuel: \"Dengarkanlah permintaan mereka dan angkatlah seorang raja bagi mereka.\" Kemudian berkatalah Samuel kepada orang-orang Israel itu: \"Pergilah, masing-masing ke kotanya.\""
 },
 {
   "id": 7395,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 1,
   "firman": "Ada seorang dari daerah Benyamin, namanya Kish bin Abiel, bin Zeror, bin Bekhorat, bin Afiah, seorang suku Benyamin, seorang yang berada."
 },
 {
   "id": 7396,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 2,
   "firman": "Orang ini ada anaknya laki-laki, namanya Saul, seorang muda yang elok rupanya; tidak ada seorangpun dari antara orang Israel yang lebih elok dari padanya: dari bahu ke atas ia lebih tinggi dari pada setiap orang sebangsanya."
 },
 {
   "id": 7397,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 3,
   "firman": "Kish, ayah Saul itu, kehilangan keledai-keledai betinanya. Sebab itu berkatalah Kish kepada Saul, anaknya: \"Ambillah salah seorang bujang, bersiaplah dan pergilah mencari keledai-keledai itu.\""
 },
 {
   "id": 7398,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 4,
   "firman": "Lalu mereka berjalan melalui pegunungan Efraim; juga mereka berjalan melalui tanah Salisa, tetapi tidak menemuinya. Kemudian mereka berjalan melalui tanah Sahalim, tetapi keledai-keledai itu tidak ada; kemudian mereka berjalan melalui tanah Benyamin, tetapi tidak menemuinya."
 },
 {
   "id": 7399,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 5,
   "firman": "Ketika mereka sampai ke tanah Zuf, berkatalah Saul kepada bujangnya yang bersama-sama dengan dia: \"Mari, kita pulang. Nanti ayahku tidak lagi memikirkan keledai-keledai itu, tetapi kuatir mengenai kita.\""
 },
 {
   "id": 7400,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 6,
   "firman": "Tetapi orang ini berkata kepadanya: \"Tunggu, di kota ini ada seorang abdi Allah, seorang yang terhormat; segala yang dikatakannya pasti terjadi. Marilah kita pergi ke sana sekarang juga, mungkin ia dapat memberitahukan kepada kita tentang perjalanan yang kita tempuh ini.\""
 },
 {
   "id": 7401,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 7,
   "firman": "Jawab Saul kepada bujangnya itu: \"Tetapi kalau kita pergi, apakah yang kita bawa kepada orang itu? Sebab roti di kantong kita telah habis, dan tidak ada pemberian untuk dibawa kepada abdi Allah itu. Apakah yang ada pada kita?\""
 },
 {
   "id": 7402,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 8,
   "firman": "Jawab bujang itu pula kepada Saul: \"Masih ada padaku seperempat syikal perak; itu dapat aku berikan kepada abdi Allah itu, maka ia akan memberitahukan kepada kita tentang perjalanan kita.\""
 },
 {
   "id": 7403,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 9,
   "firman": "--Dahulu di antara orang Israel, apabila seseorang pergi menanyakan petunjuk Allah, ia berkata begini: \"Mari kita pergi kepada pelihat,\" sebab nabi yang sekarang ini disebutkan dahulu pelihat. --"
 },
 {
   "id": 7404,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 10,
   "firman": "Kemudian berkatalah Saul kepada bujangnya itu: \"Pikiranmu itu baik. Mari kita pergi.\" Maka pergilah mereka ke kota, ke tempat abdi Allah itu."
 },
 {
   "id": 7405,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 11,
   "firman": "Ketika mereka naik jalan pendakian ke kota itu, mereka bertemu dengan gadis-gadis yang keluar hendak menimba air. Mereka bertanya kepada gadis-gadis itu: \"Pelihat ada di sini?\""
 },
 {
   "id": 7406,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 12,
   "firman": "Jawab gadis-gadis itu kepada mereka: \"Ya, ada, baru saja ia mendahului kamu, cepat-cepatlah sekarang. Ia datang ke kota hari ini, karena ada perjamuan korban untuk orang banyak di bukit pada hari ini."
 },
 {
   "id": 7407,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 13,
   "firman": "Apabila kamu masuk ke kota, kamu akan segera menjumpainya, sebelum ia naik ke bukit untuk makan. Sebab orang banyak tidak akan makan, sebelum ia datang; karena dialah yang memberkati korban, kemudian barulah para undangan makan. Pergilah sekarang, sebab kamu akan menjumpainya dengan segera.\""
 },
 {
   "id": 7408,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 14,
   "firman": "Maka naiklah mereka ke kota, dan ketika mereka masuk kota, Samuel yang berjalan keluar untuk naik ke bukit, berpapasan dengan mereka."
 },
 {
   "id": 7409,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 15,
   "firman": "Tetapi TUHAN telah menyatakan kepada Samuel, sehari sebelum kedatangan Saul, demikian:"
 },
 {
   "id": 7410,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 16,
   "firman": "\"Besok kira-kira waktu ini Aku akan menyuruh kepadamu seorang laki-laki dari tanah Benyamin; engkau akan mengurapi dia menjadi raja atas umat-Ku Israel dan ia akan menyelamatkan umat-Ku dari tangan orang Filistin. Sebab Aku telah memperhatikan sengsara umat-Ku itu, karena teriakannya telah sampai kepada-Ku.\""
 },
 {
   "id": 7411,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 17,
   "firman": "Ketika Samuel melihat Saul, maka berfirmanlah TUHAN kepadanya: \"Inilah orang yang Kusebutkan kepadamu itu; orang ini akan memegang tampuk pemerintahan atas umat-Ku.\""
 },
 {
   "id": 7412,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 18,
   "firman": "Dalam pada itu Saul, datang mendekati Samuel di tengah pintu gerbang dan berkata: \"Maaf, di mana rumah pelihat itu?\""
 },
 {
   "id": 7413,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 19,
   "firman": "Jawab Samuel kepada Saul, katanya: \"Akulah pelihat itu. Naiklah mendahului aku ke bukit. Hari ini kamu makan bersama-sama dengan daku; besok pagi aku membiarkan engkau pergi dan aku akan memberitahukan kepadamu segala sesuatu yang ada dalam hatimu."
 },
 {
   "id": 7414,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 20,
   "firman": "Adapun keledai-keledaimu, yang telah hilang tiga hari lamanya sampai sekarang, janganlah engkau kuatir, sebab telah diketemukan. Tetapi siapakah yang memiliki segala yang diingini orang Israel? Bukankah itu ada padamu dan pada seluruh kaum keluargamu?\""
 },
 {
   "id": 7415,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 21,
   "firman": "Tetapi jawab Saul: \"Bukankah aku seorang suku Benyamin, suku yang terkecil di Israel? Dan bukankah kaumku yang paling hina dari segala kaum suku Benyamin? Mengapa bapa berkata demikian kepadaku?\""
 },
 {
   "id": 7416,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 22,
   "firman": "Sesudah itu Samuel mengajak Saul dan bujangnya, dibawanya ke pendopo dan diberikannya kepada mereka tempat utama di depan para undangan, yang banyaknya kira-kira tiga puluh orang."
 },
 {
   "id": 7417,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 23,
   "firman": "Berkatalah Samuel kepada juru masak: \"Berikanlah sekarang bagian yang kuberikan kepadamu tadi, dengan pesan: Simpanlah ini dahulu.\""
 },
 {
   "id": 7418,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 24,
   "firman": "Lalu juru masak itu menghidangkan paha dan apa yang termasuk ke situ dan meletakkannya ke depan Saul. Dan Samuel berkata: \"Lihat, yang tinggal ini diletakkan ke depanmu; makanlah, sebab telah disimpan bagimu untuk perayaan ini, ketika aku berkata: Aku telah mengundang orang banyak.\" Demikianlah pada hari itu Saul makan bersama-sama dengan Samuel."
 },
 {
   "id": 7419,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 25,
   "firman": "Sesudah itu turunlah mereka dari bukit ke kota. Dan Samuel bercakap-cakap dengan Saul di atas sotoh."
 },
 {
   "id": 7420,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 26,
   "firman": "Mereka bangun pagi-pagi, dan ketika fajar menyingsing, Samuel memanggil Saul yang ada di atas sotoh itu, katanya: \"Bangunlah, aku akan mengantarkan engkau.\" Lalu Saul bangun dan mereka keduanya pergi ke luar, yakni ia dan Samuel."
 },
 {
   "id": 7421,
   "kitab": "1Sa",
   "pasal": 9,
   "ayat": 27,
   "firman": "Ketika mereka turun sampai ke ujung kota, berkatalah Samuel kepada Saul: \"Katakanlah kepada bujang itu, supaya ia pergi mendahului kita, tetapi berhentilah engkau sebentar, maka aku akan memberitahukan kepadamu firman Allah.\""
 },
 {
   "id": 7422,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 1,
   "firman": "Lalu Samuel mengambil buli-buli berisi minyak, dituangnyalah ke atas kepala Saul, diciumnyalah dia sambil berkata: \"Bukankah TUHAN telah mengurapi engkau menjadi raja atas umat-Nya Israel? Engkau akan memegang tampuk pemerintahan atas umat TUHAN, dan engkau akan menyelamatkannya dari tangan musuh-musuh di sekitarnya. Inilah tandanya bagimu, bahwa TUHAN telah mengurapi engkau menjadi raja atas milik-Nya sendiri:"
 },
 {
   "id": 7423,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 2,
   "firman": "Apabila engkau pada hari ini pergi meninggalkan aku, maka engkau akan bertemu dengan dua orang laki-laki di dekat kubur Rahel, di daerah Benyamin, di Zelzah. Mereka akan berkata kepadamu: Keledai-keledai yang engkau cari itu telah diketemukan; dan ayahmu tidak memikirkan keledai-keledai itu lagi, tetapi ia kuatir mengenai kamu, katanya: Apakah yang akan kuperbuat untuk anakku itu?"
 },
 {
   "id": 7424,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 3,
   "firman": "Dari sana engkau akan berjalan terus lagi dan sampai ke pohon tarbantin Tabor, maka di sana engkau akan ditemui oleh tiga orang laki-laki yang naik menghadap Allah di Betel; seorang membawa tiga ekor anak kambing, seorang membawa tiga ketul roti dan yang lain lagi sebuyung anggur."
 },
 {
   "id": 7425,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 4,
   "firman": "Mereka akan memberi salam kepadamu dan memberikan kepadamu dua ketul roti yang akan kauterima dari mereka."
 },
 {
   "id": 7426,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 5,
   "firman": "Sesudah itu engkau akan sampai ke Gibea Allah, tempat kedudukan pasukan orang Filistin. Dan apabila engkau masuk kota, engkau akan berjumpa di sana dengan serombongan nabi, yang turun dari bukit pengorbanan dengan gambus, rebana, suling dan kecapi di depan mereka; mereka sendiri akan kepenuhan seperti nabi."
 },
 {
   "id": 7427,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 6,
   "firman": "Maka Roh TUHAN akan berkuasa atasmu; engkau akan kepenuhan bersama-sama dengan mereka dan berubah menjadi manusia lain."
 },
 {
   "id": 7428,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 7,
   "firman": "Apabila tanda-tanda ini terjadi kepadamu, lakukanlah apa saja yang didapat oleh tanganmu, sebab Allah menyertai engkau."
 },
 {
   "id": 7429,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 8,
   "firman": "Engkau harus pergi ke Gilgal mendahului aku, dan camkanlah, aku akan datang kepadamu untuk mempersembahkan korban bakaran dan korban keselamatan. Engkau harus menunggu tujuh hari lamanya, sampai aku datang kepadamu dan memberitahukan kepadamu apa yang harus kaulakukan.\""
 },
 {
   "id": 7430,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sedang ia berpaling untuk pergi meninggalkan Samuel, maka Allah mengubah hatinya menjadi lain. Dan segala tanda-tanda yang tersebut itu terjadi pada hari itu juga."
 },
 {
   "id": 7431,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 10,
   "firman": "Ketika mereka sampai di Gibea dari sana, maka bertemulah ia dengan serombongan nabi; Roh Allah berkuasa atasnya dan Saul turut kepenuhan seperti nabi di tengah-tengah mereka."
 },
 {
   "id": 7432,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 11,
   "firman": "Dan semua orang yang mengenalnya dari dahulu melihat dengan heran, bahwa ia bernubuat bersama-sama dengan nabi-nabi itu; lalu berkatalah orang banyak yang satu kepada yang lain: \"Apakah gerangan yang terjadi dengan anak Kish itu? Apa Saul juga termasuk golongan nabi?\""
 },
 {
   "id": 7433,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lalu seorang dari tempat itu menjawab: \"Siapakah bapa mereka?\" --Itulah sebabnya menjadi peribahasa: Apa Saul juga termasuk golongan nabi?"
 },
 {
   "id": 7434,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 13,
   "firman": "Setelah habis ia kepenuhan seperti nabi, pulanglah ia."
 },
 {
   "id": 7435,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 14,
   "firman": "Dan paman Saul berkata kepadanya dan bujangnya: \"Dari mana kamu?\" Jawabnya: \"Mencari keledai-keledai itu, tetapi ketika tidak terlihat, maka kami pergi kepada Samuel.\""
 },
 {
   "id": 7436,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kemudian paman Saul itu berkata: \"Coba ceritakan kepadaku apa yang dikatakan Samuel kepada kamu.\""
 },
 {
   "id": 7437,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 16,
   "firman": "Kata Saul kepada pamannya itu: \"Terus saja diberitahukannya kepada kami, bahwa keledai-keledai itu telah diketemukan.\" Tetapi perihal menjadi raja yang telah dikatakan Samuel kepadanya, tidak diceritakan kepadanya."
 },
 {
   "id": 7438,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 17,
   "firman": "Kemudian Samuel mengerahkan bangsa itu ke hadapan TUHAN di Mizpa"
 },
 {
   "id": 7439,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 18,
   "firman": "dan ia berkata kepada orang Israel itu: \"Beginilah firman TUHAN, Allah Israel: Aku telah menuntun orang Israel keluar dari Mesir dan telah melepaskan kamu dari tangan orang Mesir dan dari tangan segala kerajaan yang menindas kamu."
 },
 {
   "id": 7440,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 19,
   "firman": "Tetapi sekarang kamu menolak Allahmu yang menyelamatkan kamu dari segala malapetaka dan kesusahanmu, dengan berkata: Tidak, angkatlah seorang raja atas kami. Maka sebab itu, berdirilah kamu di hadapan TUHAN, menurut sukumu dan menurut kaummu.\""
 },
 {
   "id": 7441,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 20,
   "firman": "Lalu Samuel menyuruh segala suku Israel tampil ke muka, maka didapati suku Benyamin."
 },
 {
   "id": 7442,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 21,
   "firman": "Sesudah itu disuruhnyalah suku Benyamin tampil ke muka menurut kaum keluarganya, maka didapati kaum keluarga Matri. Akhirnya disuruhnyalah kaum keluarga Matri tampil ke muka seorang demi seorang, maka didapati Saul bin Kish. Tetapi ketika ia dicari, ia tidak diketemukan."
 },
 {
   "id": 7443,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 22,
   "firman": "Sebab itu ditanyakan pulalah kepada TUHAN: \"Apa orang itu juga datang ke mari?\" TUHAN menjawab: \"Sesungguhnya ia bersembunyi di antara barang-barang.\""
 },
 {
   "id": 7444,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 23,
   "firman": "Berlarilah orang ke sana dan mengambilnya dari sana, dan ketika ia berdiri di tengah-tengah orang-orang sebangsanya, ternyata ia dari bahu ke atas lebih tinggi dari pada setiap orang sebangsanya."
 },
 {
   "id": 7445,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 24,
   "firman": "Dan Samuel berkata kepada seluruh bangsa itu: \"Kamu lihatkah orang yang dipilih TUHAN itu? Sebab tidak ada seorangpun yang sama seperti dia di antara seluruh bangsa itu.\" Lalu bersoraklah seluruh bangsa itu, demikian: \"Hidup raja!\""
 },
 {
   "id": 7446,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 25,
   "firman": "Kemudian Samuel menguraikan kepada bangsa itu tentang hak-hak kerajaan, menuliskannya pada suatu piagam dan meletakkannya di hadapan TUHAN; sesudah itu Samuel menyuruh seluruh bangsa itu pulang, masing-masing ke rumahnya."
 },
 {
   "id": 7447,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 26,
   "firman": "Saulpun pulang ke rumahnya, ke Gibea, dan bersama-sama dengan dia ikut pergi orang-orang gagah perkasa yang hatinya telah digerakkan Allah."
 },
 {
   "id": 7448,
   "kitab": "1Sa",
   "pasal": 10,
   "ayat": 27,
   "firman": "Tetapi orang-orang dursila berkata: \"Masakan orang ini dapat menyelamatkan kita!\" Mereka menghina dia dan tidak membawa persembahan kepadanya. Tetapi ia pura-pura tuli."
 },
 {
   "id": 7449,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 1,
   "firman": "Maka Nahas, orang Amon itu, bergerak maju dan berkemah mengepung Yabesh-Gilead. Lalu berkatalah semua orang Yabesh itu kepada Nahas: \"Adakanlah perjanjian dengan kami, maka kami akan takluk kepadamu.\""
 },
 {
   "id": 7450,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 2,
   "firman": "Tetapi Nahas, orang Amon itu, berkata kepada mereka: \"Dengan syarat inilah aku akan mengadakan perjanjian dengan kamu, bahwa tiap mata kananmu akan kucungkil; dengan demikian aku mendatangkan malu kepada segenap orang Israel.\""
 },
 {
   "id": 7451,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 3,
   "firman": "Para tua-tua Yabesh berkata kepadanya: \"Berilah kelonggaran kepada kami tujuh hari lamanya, supaya kami mengirim utusan ke seluruh daerah Israel; dan jika tidak ada seorangpun yang menyelamatkan kami, maka kami akan keluar menyerahkan diri kepadamu.\""
 },
 {
   "id": 7452,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 4,
   "firman": "Ketika para utusan itu sampai di Gibea-Saul, dan menyampaikan hal itu kepada bangsa itu, menangislah bangsa itu dengan suara nyaring."
 },
 {
   "id": 7453,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 5,
   "firman": "Saul baru saja datang dari padang dengan berjalan di belakang lembunya, dan ia bertanya: \"Ada apa dengan orang-orang itu, sehingga mereka menangis?\" Mereka menceritakan kepadanya kabar orang-orang Yabesh itu."
 },
 {
   "id": 7454,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 6,
   "firman": "Ketika Saul mendengar kabar itu, maka berkuasalah Roh Allah atas dia, dan menyala-nyalalah amarahnya dengan sangat."
 },
 {
   "id": 7455,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 7,
   "firman": "Diambilnyalah sepasang lembu, dipotong-potongnya, lalu potongan-potongan itu dikirimkannya ke seluruh daerah Israel dengan perantaraan utusan, pesannya: \"Siapa yang tidak maju mengikuti Saul dan mengikuti Samuel, lembu-lembunya akan diperlakukan juga demikian.\" Lalu TUHAN mendatangkan ketakutan kepada bangsa itu, sehingga majulah mereka serentak."
 },
 {
   "id": 7456,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 8,
   "firman": "Ketika Saul memeriksa barisan mereka di Bezek, maka ada tiga ratus ribu orang Israel dan tiga puluh ribu orang Yehuda."
 },
 {
   "id": 7457,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 9,
   "firman": "Kepada para utusan yang datang itu dikatakan: \"Beginilah kamu katakan kepada orang-orang Yabesh-Gilead: Besok pada waktu panas teriknya matahari akan datang bagimu penyelamatan.\" Ketika para utusan kembali dan memberitahukan hal itu kepada orang-orang Yabesh, bersukacitalah mereka."
 },
 {
   "id": 7458,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 10,
   "firman": "Lalu orang-orang Yabesh itu berkata kepada Nahas: \"Besok kami akan keluar menyerahkan diri kepadamu; maka bolehlah kamu lakukan terhadap kami apapun yang kamu pandang baik.\""
 },
 {
   "id": 7459,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 11,
   "firman": "Keesokan harinya Saul membagi rakyat itu menjadi tiga pasukan. Mereka itu masuk ke tengah-tengah perkemahan musuh pada waktu kawal pagi dan memukul kalah orang-orang Amon sebelum hari panas; dan terserak-seraklah orang-orang yang lolos itu, sehingga di antara mereka tidak ada tinggal dua orang bersama-sama."
 },
 {
   "id": 7460,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 12,
   "firman": "Lalu berkatalah bangsa itu kepada Samuel: \"Siapakah yang telah berkata: Masakan Saul menjadi raja atas kita? Serahkanlah orang-orang itu, supaya kami membunuhnya.\""
 },
 {
   "id": 7461,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 13,
   "firman": "Tetapi kata Saul: \"Pada hari ini seorangpun tidak boleh dibunuh, sebab pada hari ini TUHAN telah mewujudkan keselamatan kepada Israel.\""
 },
 {
   "id": 7462,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 14,
   "firman": "Dan Samuel berkata kepada bangsa itu: \"Marilah kita pergi ke Gilgal dan membaharui jabatan raja di sana.\""
 },
 {
   "id": 7463,
   "kitab": "1Sa",
   "pasal": 11,
   "ayat": 15,
   "firman": "Lalu pergilah seluruh bangsa itu ke Gilgal dan menjadikan Saul raja di sana di hadapan TUHAN di Gilgal, dan mereka mempersembahkan di sana korban keselamatan di hadapan TUHAN, dan bersukarialah di sana Saul dan semua orang Israel dengan sangat."
 },
 {
   "id": 7464,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 1,
   "firman": "Berkatalah Samuel kepada seluruh orang Israel: \"Telah kudengarkan segala permintaanmu yang kamu sampaikan kepadaku, dan seorang raja telah kuangkat atasmu."
 },
 {
   "id": 7465,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 2,
   "firman": "Maka sekarang raja itulah yang menjadi pemimpinmu; tetapi aku ini telah menjadi tua dan beruban, dan bukankah anak-anakku laki-laki ada di antara kamu? Akulah yang menjadi pemimpinmu dari sejak mudaku sampai hari ini."
 },
 {
   "id": 7466,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 3,
   "firman": "Di sini aku berdiri. Berikanlah kesaksian menentang aku di hadapan TUHAN dan di hadapan orang yang diurapi-Nya: Lembu siapakah yang telah kuambil? Keledai siapakah yang telah kuambil? Siapakah yang telah kuperas? Siapakah yang telah kuperlakukan dengan kekerasan? Dari tangan siapakah telah kuterima sogok sehingga aku harus tutup mata? Aku akan mengembalikannya kepadamu.\""
 },
 {
   "id": 7467,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 4,
   "firman": "Jawab mereka: \"Engkau tidak memeras kami dan engkau tidak memperlakukan kami dengan kekerasan dan engkau tidak menerima apa-apa dari tangan siapapun.\""
 },
 {
   "id": 7468,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 5,
   "firman": "Lalu berkatalah ia kepada mereka: \"TUHAN menjadi saksi kepada kamu, dan orang yang diurapi-Nyapun menjadi saksi pada hari ini, bahwa kamu tidak mendapat apa-apa dalam tanganku.\" Jawab mereka: \"Dia menjadi saksi.\""
 },
 {
   "id": 7469,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 6,
   "firman": "Lalu berkatalah Samuel kepada bangsa itu: \"Tuhanlah saksi, yang mengangkat Musa dan Harun dan yang menuntun nenek moyangmu keluar dari tanah Mesir."
 },
 {
   "id": 7470,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 7,
   "firman": "Maka sebab itu, berdirilah supaya aku bersama-sama dengan kamu berhakim di hadapan TUHAN mengenai segala perbuatan keselamatan TUHAN yang telah dikerjakan-Nya kepadamu dan kepada nenek moyangmu."
 },
 {
   "id": 7471,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 8,
   "firman": "Ketika Yakub datang ke Mesir dan nenek moyangmu berseru-seru kepada TUHAN, maka TUHAN mengutus Musa dan Harun, yang membawa nenek moyangmu keluar dari Mesir, dan membiarkan mereka diam di tempat ini."
 },
 {
   "id": 7472,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 9,
   "firman": "Tetapi mereka melupakan TUHAN, Allah mereka, dan Ia menyerahkan mereka ke dalam tangan Sisera, panglima tentara di Hazor, dan ke dalam tangan orang Filistin dan raja Moab, yang berperang melawan mereka."
 },
 {
   "id": 7473,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 10,
   "firman": "Mereka berseru-seru kepada TUHAN, katanya: Kami telah berdosa, sebab kami telah meninggalkan TUHAN dan beribadah kepada para Baal dan para Asytoret; maka sekarang lepaskanlah kami dari tangan musuh kami, maka kami akan beribadah kepada-Mu."
 },
 {
   "id": 7474,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 11,
   "firman": "Sesudah itu TUHAN mengutus Yerubaal, Barak, Yefta dan Samuel, dan melepaskan kamu dari tangan musuh di sekelilingmu, sehingga kamu diam dengan tenteram."
 },
 {
   "id": 7475,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 12,
   "firman": "Tetapi ketika kamu melihat, bahwa Nahas, raja bani Amon, mendatangi kamu, maka kamu berkata kepadaku: Tidak, seorang raja harus memerintah kami, padahal TUHAN, Allahmu, adalah rajamu."
 },
 {
   "id": 7476,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 13,
   "firman": "Maka sebab itu, lihat itu raja yang telah kamu pilih, yang kamu minta. Sesungguhnya TUHAN telah mengangkat raja atasmu,"
 },
 {
   "id": 7477,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 14,
   "firman": "asal saja kamu takut akan TUHAN, beribadah kepada-Nya, mendengarkan firman-Nya dan tidak menentang titah TUHAN, dan baik kamu, maupun raja yang akan memerintah kamu itu mengikuti TUHAN, Allahmu!"
 },
 {
   "id": 7478,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 15,
   "firman": "Tetapi jika kamu tidak mendengarkan firman TUHAN dan kamu menentang titah TUHAN, maka tangan TUHAN akan melawan kamu dan melawan rajamu."
 },
 {
   "id": 7479,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 16,
   "firman": "Sekarang tinggallah berdiri dan lihatlah perkara yang besar yang akan dilakukan TUHAN di depan matamu ini."
 },
 {
   "id": 7480,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 17,
   "firman": "Bukankah sekarang musim menuai gandum? Aku akan berseru kepada TUHAN, supaya Ia memberikan guruh dan hujan. Lihatlah dan sadarlah, bahwa besar kejahatan yang telah kamu lakukan itu di mata TUHAN dengan meminta raja bagimu.\""
 },
 {
   "id": 7481,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 18,
   "firman": "Lalu berserulah Samuel kepada TUHAN, maka TUHAN memberikan pada hari itu guruh dan hujan, sehingga sangat takutlah seluruh bangsa itu kepada TUHAN dan kepada Samuel."
 },
 {
   "id": 7482,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 19,
   "firman": "Berkatalah seluruh bangsa itu kepada Samuel: \"Berdoalah untuk hamba-hambamu ini kepada TUHAN, Allahmu, supaya jangan kami mati, sebab dengan meminta raja bagi kami, kami menambah dosa kami dengan kejahatan ini.\""
 },
 {
   "id": 7483,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 20,
   "firman": "Dan berkatalah Samuel kepada bangsa itu: \"Jangan takut; memang kamu telah melakukan segala kejahatan ini, tetapi janganlah berhenti mengikuti TUHAN, melainkan beribadahlah kepada TUHAN dengan segenap hatimu."
 },
 {
   "id": 7484,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 21,
   "firman": "Janganlah menyimpang untuk mengejar dewa kesia-siaan yang tidak berguna dan tidak dapat menolong karena semuanya itu adalah kesia-siaan belaka."
 },
 {
   "id": 7485,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 22,
   "firman": "Sebab TUHAN tidak akan membuang umat-Nya, sebab nama-Nya yang besar. Bukankah TUHAN telah berkenan untuk membuat kamu menjadi umat-Nya?"
 },
 {
   "id": 7486,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 23,
   "firman": "Mengenai aku, jauhlah dari padaku untuk berdosa kepada TUHAN dengan berhenti mendoakan kamu; aku akan mengajarkan kepadamu jalan yang baik dan lurus."
 },
 {
   "id": 7487,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 24,
   "firman": "Hanya takutlah akan TUHAN dan setialah beribadah kepada-Nya dengan segenap hatimu, sebab ketahuilah, betapa besarnya hal-hal yang dilakukan-Nya di antara kamu."
 },
 {
   "id": 7488,
   "kitab": "1Sa",
   "pasal": 12,
   "ayat": 25,
   "firman": "Tetapi jika kamu terus berbuat jahat, maka kamu akan dilenyapkan, baik kamu maupun rajamu itu.\""
 },
 {
   "id": 7489,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 1,
   "firman": "Saul berumur sekian tahun ketika ia menjadi raja; dua tahun ia memerintah atas Israel."
 },
 {
   "id": 7490,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 2,
   "firman": "Saul memilih tiga ribu orang dari antara orang Israel; dua ribu orang ada bersama-sama dengan Saul di Mikhmas dan di pegunungan Betel, sedang seribu orang ada bersama-sama dengan Yonatan di Gibea Benyamin, tetapi selebihnya dari rakyat itu disuruhnya pulang, masing-masing ke kemahnya."
 },
 {
   "id": 7491,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 3,
   "firman": "Yonatan memukul kalah pasukan pendudukan orang Filistin yang ada di Geba; dan hal itu terdengar oleh orang Filistin. Karena itu Saul menyuruh meniup sangkakala di seluruh negeri, sebab pikirnya: \"Biarlah orang Ibrani mendengarnya.\""
 },
 {
   "id": 7492,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 4,
   "firman": "Demikianlah seluruh orang Israel mendengar kabar, bahwa Saul telah memukul kalah pasukan pendudukan orang Filistin dan dengan demikian orang Israel dibenci oleh orang Filistin. Kemudian dikerahkanlah rakyat itu untuk mengikuti Saul ke Gilgal."
 },
 {
   "id": 7493,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 5,
   "firman": "Adapun orang Filistin telah berkumpul untuk berperang melawan orang Israel. Dengan tiga ribu kereta, enam ribu orang pasukan berkuda dan pasukan berjalan kaki sebanyak pasir di tepi laut mereka bergerak maju dan berkemah di Mikhmas, di sebelah timur Bet-Awen."
 },
 {
   "id": 7494,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 6,
   "firman": "Ketika dilihat orang-orang Israel, bahwa mereka terjepit--sebab rakyat memang terdesak--maka larilah rakyat bersembunyi di gua, keluk batu, bukit batu, liang batu dan perigi;"
 },
 {
   "id": 7495,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 7,
   "firman": "malah ada orang Ibrani yang menyeberangi arungan sungai Yordan menuju tanah Gad dan Gilead, sedang Saul masih di Gilgal dan seluruh rakyat mengikutinya dengan gemetar."
 },
 {
   "id": 7496,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 8,
   "firman": "Ia menunggu tujuh hari lamanya sampai waktu yang ditentukan Samuel. Tetapi ketika Samuel tidak datang ke Gilgal, mulailah rakyat itu berserak-serak meninggalkan dia."
 },
 {
   "id": 7497,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sebab itu Saul berkata: \"Bawalah kepadaku korban bakaran dan korban keselamatan itu.\" Lalu ia mempersembahkan korban bakaran."
 },
 {
   "id": 7498,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 10,
   "firman": "Baru saja ia habis mempersembahkan korban bakaran, maka tampaklah Samuel datang. Saul pergi menyongsongnya untuk memberi salam kepadanya."
 },
 {
   "id": 7499,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 11,
   "firman": "Tetapi kata Samuel: \"Apa yang telah kauperbuat?\" Jawab Saul: \"Karena aku melihat rakyat itu berserak-serak meninggalkan aku dan engkau tidak datang pada waktu yang telah ditentukan, padahal orang Filistin telah berkumpul di Mikhmas,"
 },
 {
   "id": 7500,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 12,
   "firman": "maka pikirku: Sebentar lagi orang Filistin akan menyerang aku di Gilgal, padahal aku belum memohonkan belas kasihan TUHAN; sebab itu aku memberanikan diri, lalu mempersembahkan korban bakaran.\""
 },
 {
   "id": 7501,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 13,
   "firman": "Kata Samuel kepada Saul: \"Perbuatanmu itu bodoh. Engkau tidak mengikuti perintah TUHAN, Allahmu, yang diperintahkan-Nya kepadamu; sebab sedianya TUHAN mengokohkan kerajaanmu atas orang Israel untuk selama-lamanya."
 },
 {
   "id": 7502,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tetapi sekarang kerajaanmu tidak akan tetap. TUHAN telah memilih seorang yang berkenan di hati-Nya dan TUHAN telah menunjuk dia menjadi raja atas umat-Nya, karena engkau tidak mengikuti apa yang diperintahkan TUHAN kepadamu.\""
 },
 {
   "id": 7503,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 15,
   "firman": "Kemudian berangkatlah Samuel dan pergi dari Gilgal ke Gibea Benyamin. Tetapi Saul memeriksa barisan rakyat yang ada bersama-sama dengan dia itu: kira-kira enam ratus orang banyaknya."
 },
 {
   "id": 7504,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 16,
   "firman": "Saul dan Yonatan, anaknya, dan rakyat yang ada bersama-sama dengan mereka, tinggal di Geba-Benyamin, sedang orang Filistin berkemah di Mikhmas."
 },
 {
   "id": 7505,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 17,
   "firman": "Maka keluarlah orang-orang penjarah dari perkemahan orang Filistin dalam tiga gerombolan: gerombolan yang satu mengambil jalan ke Ofra, ke daerah Syual;"
 },
 {
   "id": 7506,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 18,
   "firman": "gerombolan yang kedua mengambil jalan ke Bet-Horon, dan gerombolan yang satu lagi mengambil jalan ke perbatasan yang menghadap ke lembah Zeboim arah ke padang gurun."
 },
 {
   "id": 7507,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 19,
   "firman": "Seorang tukang besi tidak terdapat di seluruh negeri Israel, sebab orang Filistin berkata: \"Jangan-jangan orang Ibrani membuat pedang atau tombak.\""
 },
 {
   "id": 7508,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 20,
   "firman": "Jadi semua orang Israel harus pergi kepada orang Filistin untuk mengasah mata bajaknya, beliungnya, kapaknya atau aritnya masing-masing--"
 },
 {
   "id": 7509,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 21,
   "firman": "adapun bayarannya ialah dua pertiga syikal untuk mata bajak dan beliung, dan sepertiga syikal untuk mengasah kapak dan untuk memasang kusa--"
 },
 {
   "id": 7510,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 22,
   "firman": "sehingga pada hari pertempuran itu sebilah pedang atau lembingpun tidak terdapat pada seluruh rakyat yang ada bersama Saul dan Yonatan. Tetapi Saul dan Yonatan, anaknya itu, masih mempunyainya."
 },
 {
   "id": 7511,
   "kitab": "1Sa",
   "pasal": 13,
   "ayat": 23,
   "firman": "Dan suatu pasukan pengawal orang Filistin telah keluar ke pelintasan gunung di Mikhmas."
 },
 {
   "id": 7512,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 1,
   "firman": "Pada suatu hari Yonatan bin Saul berkata kepada bujang pembawa senjatanya: \"Mari kita menyeberang ke dekat pasukan pengawal orang Filistin yang di sebelah sana.\" Tetapi tidak diberitahukannya hal itu kepada ayahnya."
 },
 {
   "id": 7513,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 2,
   "firman": "Adapun Saul duduk di ujung Gibea di bawah pohon delima yang di Migron. Dan rakyat yang ada bersama-sama dengan dia itu, kira-kira enam ratus orang banyaknya."
 },
 {
   "id": 7514,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 3,
   "firman": "Ahia, anak Ahitub, saudara Ikabod, anak Pinehas, anak Eli, imam TUHAN di Silo, dialah yang memakai baju efod pada waktu itu. Tetapi rakyat tidak tahu tentang perginya Yonatan itu."
 },
 {
   "id": 7515,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 4,
   "firman": "Di antara pelintasan-pelintasan bukit, yang dicoba Yonatan menyeberanginya ke arah pasukan pengawal orang Filistin, ada ujung bukit batu di sebelah sini dan ada ujung bukit batu di sebelah sana: yang satu bernama Bozes, yang lain bernama Sene."
 },
 {
   "id": 7516,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 5,
   "firman": "Ujung yang satu berdiri di sebelah utara di tentangan Mikhmas, yang lain di sebelah selatan di tentangan Geba."
 },
 {
   "id": 7517,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 6,
   "firman": "Berkatalah Yonatan kepada bujang pembawa senjatanya itu: \"Mari kita menyeberang ke dekat pasukan pengawal orang-orang yang tidak bersunat ini. Mungkin TUHAN akan bertindak untuk kita, sebab bagi TUHAN tidak sukar untuk menolong, baik dengan banyak orang maupun dengan sedikit orang.\""
 },
 {
   "id": 7518,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 7,
   "firman": "Lalu jawab pembawa senjatanya itu kepadanya: \"Lakukanlah niat hatimu itu; sungguh, aku sepakat.\""
 },
 {
   "id": 7519,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 8,
   "firman": "Kata Yonatan: \"Perhatikan, kita menyeberang ke dekat orang-orang itu dan memperlihatkan diri kepada mereka."
 },
 {
   "id": 7520,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 9,
   "firman": "Apabila kata mereka kepada kita begini: Berhentilah, sampai kami datang padamu, maka kita tinggal berdiri di tempat kita dan tidak naik mendapatkan mereka,"
 },
 {
   "id": 7521,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 10,
   "firman": "tetapi apabila kata mereka begini: Naiklah ke mari, maka kita akan naik, sebab kalau demikian TUHAN telah menyerahkan mereka ke dalam tangan kita. Itulah tandanya bagi kita.\""
 },
 {
   "id": 7522,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 11,
   "firman": "Ketika mereka keduanya memperlihatkan diri kepada pasukan pengawal orang Filistin, berkatalah orang Filistin itu: \"Lihat, orang-orang Ibrani keluar dari lobang-lobang tempat mereka bersembunyi.\""
 },
 {
   "id": 7523,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 12,
   "firman": "Orang-orang dari pasukan pengawal itu berseru kepada Yonatan dan pembawa senjatanya, katanya: \"Naiklah ke mari, maka kami akan menghajar kamu.\" Lalu kata Yonatan kepada pembawa senjatanya: \"Naiklah mengikuti aku, sebab TUHAN telah menyerahkan mereka ke dalam tangan orang Israel.\""
 },
 {
   "id": 7524,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 13,
   "firman": "Maka naiklah Yonatan merangkak ke atas, dengan diikuti oleh pembawa senjatanya. Orang-orang itu tewas terparang oleh Yonatan, sedang pembawa senjatanya membunuh mereka dari belakangnya."
 },
 {
   "id": 7525,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 14,
   "firman": "Kekalahan yang pertama ini, yang ditimbulkan Yonatan dan pembawa senjatanya itu, besarnya kira-kira dua puluh orang dalam jarak kira-kira setengah alur dari sepembajakan ladang."
 },
 {
   "id": 7526,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 15,
   "firman": "Lalu timbullah kegentaran di perkemahan, di padang dan di antara seluruh rakyat. Juga pasukan pengawal dan penjarah-penjarah itu gentar, dan bumi gemetar, sehingga menjadi kegentaran yang dari Allah."
 },
 {
   "id": 7527,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 16,
   "firman": "Ketika peninjau-peninjau Saul di Gibea Benyamin melihat hal itu--dan sesungguhnya, orang ramai seperti ombak berjalan ke sana ke mari--"
 },
 {
   "id": 7528,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 17,
   "firman": "berkatalah Saul kepada tentara yang bersama-sama dengan dia itu: \"Periksalah barisan dan lihatlah siapa yang pergi dari pada kita.\" Mereka memeriksa barisan, dan ternyata Yonatan dan pembawa senjatanya tidak ada."
 },
 {
   "id": 7529,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 18,
   "firman": "Lalu kata Saul kepada Ahia: \"Bawalah baju efod ke mari.\" Karena pada waktu itu dialah yang memakai baju efod di antara orang Israel."
 },
 {
   "id": 7530,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 19,
   "firman": "Tetapi sedang Saul berbicara kepada imam itu, maka kian lama kian bertambahlah keributan di perkemahan orang Filistin, sehingga Saul berkata pula kepada imam itu: \"Biarlah!\""
 },
 {
   "id": 7531,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 20,
   "firman": "Kemudian berkumpullah Saul dan seluruh rakyat yang bersama-sama dengan dia itu; dan ketika mereka sampai ke tempat pertempuran, tampaklah setiap orang menikam temannya dengan pedang, suatu huru-hara yang sangat besar."
 },
 {
   "id": 7532,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 21,
   "firman": "Lagipula orang-orang Ibrani yang telah lama tinggal pada orang Filistin dan yang telah ikut maju dalam tentara mereka, mereka juga berbalik untuk bergabung dengan orang-orang Israel yang ada bersama-sama dengan Saul dan Yonatan."
 },
 {
   "id": 7533,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 22,
   "firman": "Bahkan, ketika semua orang Israel yang telah bersembunyi di pegunungan Efraim, mendengar bahwa orang Filistin telah lari, orang-orang itupun bergabung dengan mereka dalam pertempuran."
 },
 {
   "id": 7534,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 23,
   "firman": "Demikianlah TUHAN menyelamatkan orang Israel pada hari itu. Pertempuran itu meluas sampai lewat Bet-Awen."
 },
 {
   "id": 7535,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 24,
   "firman": "Ketika orang-orang Israel terdesak pada hari itu, Saul menyuruh rakyat mengucapkan kutuk, katanya: \"Terkutuklah orang yang memakan sesuatu sebelum matahari terbenam dan sebelum aku membalas dendam terhadap musuhku.\" Sebab itu tidak ada seorangpun dari rakyat yang memakan sesuatu."
 },
 {
   "id": 7536,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 25,
   "firman": "Dan seluruh orang itu sampailah ke suatu hutan dan di sana ada madu di tanah."
 },
 {
   "id": 7537,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 26,
   "firman": "Ketika rakyat sampai ke hutan itu, tampaklah ada di sana madu meleleh, tetapi tidak ada seorangpun yang mencedoknya ke mulutnya dengan tangan, sebab rakyat takut kepada sumpah itu."
 },
 {
   "id": 7538,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 27,
   "firman": "Tetapi Yonatan tidak mendengar, bahwa ayahnya telah menyuruh rakyat bersumpah. Ia mengulurkan tongkat yang ada di tangannya dan mencelupkan ujungnya ke dalam sarang madu; kemudian ia mencedoknya ke mulutnya dengan tangan, lalu matanya menjadi terang lagi."
 },
 {
   "id": 7539,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 28,
   "firman": "Dan seorang dari rakyat berbicara, katanya: \"Ayahmu telah menyuruh rakyat bersumpah dengan bersungguh-sungguh, katanya: Terkutuklah orang yang memakan sesuatu pada hari ini; sebab itu rakyat letih lesu.\""
 },
 {
   "id": 7540,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 29,
   "firman": "Lalu kata Yonatan: \"Ayahku mencelakakan negeri; coba lihat, bagaimana terangnya mataku, setelah aku merasai sedikit dari madu ini."
 },
 {
   "id": 7541,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 30,
   "firman": "Apalagi, jika sekiranya rakyat pada hari ini boleh makan dengan bebas dari jarahan musuhnya, yang telah didapatnya! Tetapi sekarang tidaklah besar kekalahan di antara orang Filistin.\""
 },
 {
   "id": 7542,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 31,
   "firman": "Dan pada hari itu mereka memukul kalah orang Filistin dari Mikhmas sampai ke Ayalon. Rakyat sudah sangat letih lesu,"
 },
 {
   "id": 7543,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 32,
   "firman": "sebab itu rakyat menyambar jarahan; mereka mengambil kambing domba, lembu dan anak lembu, menyembelihnya begitu saja di atas tanah, dan memakannya dengan darahnya."
 },
 {
   "id": 7544,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 33,
   "firman": "Lalu diberitahukanlah kepada Saul, demikian: \"Lihat, rakyat berdosa terhadap TUHAN dengan memakannya dengan darahnya.\" Dan ia berkata: \"Kamu berbuat khianat; gulingkanlah sekarang juga sebuah batu besar ke mari.\""
 },
 {
   "id": 7545,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 34,
   "firman": "Kata Saul pula: \"Berserak-seraklah di antara rakyat dan katakan kepada mereka: Setiap orang harus membawa lembunya atau dombanya kepadaku; sembelihlah itu di sini, maka kamu boleh memakannya. Tetapi janganlah berdosa terhadap TUHAN dengan memakannya dengan darahnya.\" Lalu setiap orang dari seluruh rakyat membawa serta pada malam itu lembunya, dan mereka menyembelihnya di sana."
 },
 {
   "id": 7546,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 35,
   "firman": "Saul mendirikan mezbah bagi TUHAN; inilah mezbah yang mula-mula sekali didirikannya bagi TUHAN."
 },
 {
   "id": 7547,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 36,
   "firman": "Lagi kata Saul: \"Marilah kita pada malam ini mengejar orang Filistin dan menjarahi mereka sampai fajar menyingsing dan janganlah kita biarkan hidup seorangpun dari mereka.\" Jawab mereka itu: \"Perbuatlah apa yang kaupandang baik.\" Tetapi imam berkata: \"Marilah kita dahulu tampil menghadap Allah di sini.\""
 },
 {
   "id": 7548,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 37,
   "firman": "Saul bertanya kepada Allah: \"Bolehkah aku mengejar orang Filistin itu? Akan Kauserahkankah mereka ke dalam tangan orang Israel?\" Tetapi pada hari itu Ia tidak menjawab Saul."
 },
 {
   "id": 7549,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 38,
   "firman": "Lalu kata Saul: \"Datanglah ke mari, kamu segala pemuka rakyat; berusahalah mengetahui apa sebab dosa ini terjadi pada hari ini."
 },
 {
   "id": 7550,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 39,
   "firman": "Sebab demi TUHAN yang hidup, yang menyelamatkan orang Israel, sekalipun itu disebabkan oleh Yonatan, anakku, maka ia pasti akan mati.\" Tetapi seorangpun dari seluruh rakyat tidak ada yang menjawabnya."
 },
 {
   "id": 7551,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 40,
   "firman": "Kemudian berkatalah ia kepada seluruh orang Israel: \"Kamu berdiri di sebelah yang satu dan aku serta anakku Yonatan akan berdiri di sebelah yang lain.\" Lalu jawab rakyat kepada Saul: \"Perbuatlah apa yang kaupandang baik.\""
 },
 {
   "id": 7552,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 41,
   "firman": "Lalu berkatalah Saul: \"Ya, TUHAN, Allah Israel, mengapa Engkau tidak menjawab hamba-Mu pada hari ini? Jika kesalahan itu ada padaku atau pada anakku Yonatan, ya TUHAN, Allah Israel, tunjukkanlah kiranya Urim; tetapi jika kesalahan itu ada pada umat-Mu Israel, tunjukkanlah Tumim.\" Lalu didapati Yonatan dan Saul, tetapi rakyat itu terluput."
 },
 {
   "id": 7553,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 42,
   "firman": "Kata Saul: \"Buanglah undi antara aku dan anakku Yonatan.\" Lalu didapati Yonatan."
 },
 {
   "id": 7554,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 43,
   "firman": "Kata Saul kepada Yonatan: \"Beritahukanlah kepadaku apa yang telah kauperbuat.\" Lalu Yonatan memberitahukan kepadanya, katanya: \"Memang, aku telah merasai sedikit madu dengan ujung tongkat yang ada di tanganku. Aku bersedia untuk mati.\""
 },
 {
   "id": 7555,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 44,
   "firman": "Kata Saul: \"Beginilah kiranya Allah menghukum aku, bahkan lebih lagi dari pada itu. Sesungguhnya, Yonatan, engkau harus mati.\""
 },
 {
   "id": 7556,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 45,
   "firman": "Tetapi rakyat berkata kepada Saul: \"Masakan Yonatan harus mati, dia yang telah mendapat kemenangan yang besar ini di Israel? Jauhlah yang demikian! Demi TUHAN yang hidup, sehelai rambutpun dari kepalanya takkan jatuh ke bumi! Sebab dengan pertolongan Allah juga dilakukannya hal itu pada hari ini.\" Demikianlah rakyat membebaskan Yonatan, sehingga ia tidak harus mati."
 },
 {
   "id": 7557,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 46,
   "firman": "Maka pulanglah Saul setelah mengejar orang Filistin, dan orang Filistin itupun kembali ke tempat kediamannya."
 },
 {
   "id": 7558,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 47,
   "firman": "Setelah Saul mendapat jabatan raja atas Israel, maka berperanglah ia ke segala penjuru melawan segala musuhnya: melawan Moab, bani Amon, Edom, raja-raja negeri Zoba dan orang Filistin. Dan ke manapun ia pergi, ia selalu mendapat kemenangan."
 },
 {
   "id": 7559,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 48,
   "firman": "Ia melakukan perbuatan-perbuatan yang gagah perkasa, memukul kalah orang Amalek, dan melepaskan Israel dari tangan orang-orang yang merampasi mereka."
 },
 {
   "id": 7560,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 49,
   "firman": "Anak-anak lelaki Saul ialah Yonatan, Yiswi dan Malkisua. Nama kedua anaknya yang perempuan: yang tertua bernama Merab, yang termuda bernama Mikhal."
 },
 {
   "id": 7561,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 50,
   "firman": "Isteri Saul bernama Ahinoam, anak Ahimaas. Panglima tentaranya bernama Abner, anak Ner, paman Saul."
 },
 {
   "id": 7562,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 51,
   "firman": "Kish, ayah Saul, dan Ner, ayah Abner, adalah anak-anak Abiel."
 },
 {
   "id": 7563,
   "kitab": "1Sa",
   "pasal": 14,
   "ayat": 52,
   "firman": "Hebat peperangan melawan orang Filistin selama zaman Saul. Dan semua pahlawan dan orang gagah perkasa, yang dilihat Saul, dikumpulkannya kepadanya."
 },
 {
   "id": 7564,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 1,
   "firman": "Berkatalah Samuel kepada Saul: \"Aku telah diutus oleh TUHAN untuk mengurapi engkau menjadi raja atas Israel, umat-Nya; oleh sebab itu, dengarkanlah bunyi firman TUHAN."
 },
 {
   "id": 7565,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN semesta alam: Aku akan membalas apa yang dilakukan orang Amalek kepada orang Israel, karena orang Amalek menghalang-halangi mereka, ketika orang Israel pergi dari Mesir."
 },
 {
   "id": 7566,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 3,
   "firman": "Jadi pergilah sekarang, kalahkanlah orang Amalek, tumpaslah segala yang ada padanya, dan janganlah ada belas kasihan kepadanya. Bunuhlah semuanya, laki-laki maupun perempuan, kanak-kanak maupun anak-anak yang menyusu, lembu maupun domba, unta maupun keledai.\""
 },
 {
   "id": 7567,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 4,
   "firman": "Lalu Saul memanggil rakyat berkumpul dan memeriksa barisan mereka di Telaim: ada dua ratus ribu orang pasukan berjalan kaki dan sepuluh ribu orang Yehuda."
 },
 {
   "id": 7568,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 5,
   "firman": "Setelah Saul sampai ke kota orang Amalek, disuruhnyalah orang-orang menghadang di lembah."
 },
 {
   "id": 7569,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 6,
   "firman": "Berkatalah Saul kepada orang Keni: \"Berangkatlah, menjauhlah, pergilah dari tengah-tengah orang Amalek, supaya jangan kulenyapkan kamu bersama-sama dengan mereka. Bukankah kamu telah menunjukkan persahabatanmu kepada semua orang Israel, ketika mereka pergi dari Mesir?\" Sesudah itu menjauhlah orang Keni dari tengah-tengah orang Amalek."
 },
 {
   "id": 7570,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 7,
   "firman": "Lalu Saul memukul kalah orang Amalek mulai dari Hawila sampai ke Syur, yang di sebelah timur Mesir."
 },
 {
   "id": 7571,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 8,
   "firman": "Agag, raja orang Amalek, ditangkapnya hidup-hidup, tetapi segenap rakyatnya ditumpasnya dengan mata pedang."
 },
 {
   "id": 7572,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 9,
   "firman": "Tetapi Saul dan rakyat itu menyelamatkan Agag dan kambing domba dan lembu-lembu yang terbaik dan tambun, pula anak domba dan segala yang berharga: tidak mau mereka menumpas semuanya itu. Tetapi segala hewan yang tidak berharga dan yang buruk, itulah yang ditumpas mereka."
 },
 {
   "id": 7573,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 10,
   "firman": "Lalu datanglah firman TUHAN kepada Samuel, demikian:"
 },
 {
   "id": 7574,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 11,
   "firman": "\"Aku menyesal, karena Aku telah menjadikan Saul raja, sebab ia telah berbalik dari pada Aku dan tidak melaksanakan firman-Ku.\" Maka sakit hatilah Samuel dan ia berseru-seru kepada TUHAN semalam-malaman."
 },
 {
   "id": 7575,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 12,
   "firman": "Lalu Samuel bangun pagi-pagi untuk bertemu dengan Saul, tetapi diberitahukan kepada Samuel, demikian: \"Saul telah ke Karmel tadi dan telah didirikannya baginya suatu tanda peringatan; kemudian ia balik dan mengambil jurusan ke Gilgal.\""
 },
 {
   "id": 7576,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 13,
   "firman": "Ketika Samuel sampai kepada Saul, berkatalah Saul kepadanya: \"Diberkatilah kiranya engkau oleh TUHAN; aku telah melaksanakan firman TUHAN.\""
 },
 {
   "id": 7577,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 14,
   "firman": "Tetapi kata Samuel: \"Kalau begitu apakah bunyi kambing domba, yang sampai ke telingaku, dan bunyi lembu-lembu yang kudengar itu?\""
 },
 {
   "id": 7578,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 15,
   "firman": "Jawab Saul: \"Semuanya itu dibawa dari pada orang Amalek, sebab rakyat menyelamatkan kambing domba dan lembu-lembu yang terbaik dengan maksud untuk mempersembahkan korban kepada TUHAN, Allahmu; tetapi selebihnya telah kami tumpas.\""
 },
 {
   "id": 7579,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 16,
   "firman": "Lalu berkatalah Samuel kepada Saul: \"Sudahlah! Aku akan memberitahukan kepadamu apa yang difirmankan TUHAN kepadaku tadi malam.\" Kata Saul kepadanya: \"Katakanlah.\""
 },
 {
   "id": 7580,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 17,
   "firman": "Sesudah itu berkatalah Samuel: \"Bukankah engkau, walaupun engkau kecil pada pemandanganmu sendiri, telah menjadi kepala atas suku-suku Israel? Dan bukankah TUHAN telah mengurapi engkau menjadi raja atas Israel?"
 },
 {
   "id": 7581,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 18,
   "firman": "TUHAN telah menyuruh engkau pergi, dengan pesan: Pergilah, tumpaslah orang-orang berdosa itu, yakni orang Amalek, berperanglah melawan mereka sampai engkau membinasakan mereka."
 },
 {
   "id": 7582,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 19,
   "firman": "Mengapa engkau tidak mendengarkan suara TUHAN? Mengapa engkau mengambil jarahan dan melakukan apa yang jahat di mata TUHAN?\""
 },
 {
   "id": 7583,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 20,
   "firman": "Lalu kata Saul kepada Samuel: \"Aku memang mendengarkan suara TUHAN dan mengikuti jalan yang telah disuruh TUHAN kepadaku dan aku membawa Agag, raja orang Amalek, tetapi orang Amalek itu sendiri telah kutumpas."
 },
 {
   "id": 7584,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 21,
   "firman": "Tetapi rakyat mengambil dari jarahan itu kambing domba dan lembu-lembu yang terbaik dari yang dikhususkan untuk ditumpas itu, untuk mempersembahkan korban kepada TUHAN, Allahmu, di Gilgal.\""
 },
 {
   "id": 7585,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 22,
   "firman": "Tetapi jawab Samuel: \"Apakah TUHAN itu berkenan kepada korban bakaran dan korban sembelihan sama seperti kepada mendengarkan suara TUHAN? Sesungguhnya, mendengarkan lebih baik dari pada korban sembelihan, memperhatikan lebih baik dari pada lemak domba-domba jantan."
 },
 {
   "id": 7586,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 23,
   "firman": "Sebab pendurhakaan adalah sama seperti dosa bertenung dan kedegilan adalah sama seperti menyembah berhala dan terafim. Karena engkau telah menolak firman TUHAN, maka Ia telah menolak engkau sebagai raja.\""
 },
 {
   "id": 7587,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 24,
   "firman": "Berkatalah Saul kepada Samuel: \"Aku telah berdosa, sebab telah kulangkahi titah TUHAN dan perkataanmu; tetapi aku takut kepada rakyat, karena itu aku mengabulkan permintaan mereka."
 },
 {
   "id": 7588,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 25,
   "firman": "Maka sekarang, ampunilah kiranya dosaku; kembalilah bersama-sama dengan aku, maka aku akan sujud menyembah kepada TUHAN.\""
 },
 {
   "id": 7589,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 26,
   "firman": "Tetapi jawab Samuel kepada Saul: \"Aku tidak akan kembali bersama-sama dengan engkau, sebab engkau telah menolak firman TUHAN; sebab itu TUHAN telah menolak engkau, sebagai raja atas Israel.\""
 },
 {
   "id": 7590,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 27,
   "firman": "Ketika Samuel berpaling hendak pergi, maka Saul memegang punca jubah Samuel, tetapi terkoyak."
 },
 {
   "id": 7591,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 28,
   "firman": "Kemudian berkatalah Samuel kepadanya: \"TUHAN telah mengoyakkan dari padamu jabatan raja atas Israel pada hari ini dan telah memberikannya kepada orang lain yang lebih baik dari padamu."
 },
 {
   "id": 7592,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 29,
   "firman": "Lagi Sang Mulia dari Israel tidak berdusta dan Ia tidak tahu menyesal; sebab Ia bukan manusia yang harus menyesal.\""
 },
 {
   "id": 7593,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 30,
   "firman": "Tetapi kata Saul: \"Aku telah berdosa; tetapi tunjukkanlah juga hormatmu kepadaku sekarang di depan para tua-tua bangsaku dan di depan orang Israel. Kembalilah bersama-sama dengan aku, maka aku akan sujud menyembah kepada TUHAN, Allahmu.\""
 },
 {
   "id": 7594,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 31,
   "firman": "Sesudah itu kembalilah Samuel mengikuti Saul. Dan Saul sujud menyembah kepada TUHAN."
 },
 {
   "id": 7595,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 32,
   "firman": "Lalu berkatalah Samuel: \"Bawa ke mari Agag, raja Amalek itu.\" Dengan gembira Agag pergi kepadanya, sebab pikirnya: \"Sesungguhnya, kepahitan maut telah lewat.\""
 },
 {
   "id": 7596,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 33,
   "firman": "Tetapi kata Samuel: \"Seperti pedangmu membuat perempuan-perempuan kehilangan anak, demikianlah ibumu akan kehilangan anak di antara perempuan-perempuan.\" Sesudah itu Samuel mencincang Agag di hadapan TUHAN di Gilgal."
 },
 {
   "id": 7597,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 34,
   "firman": "Kemudian Samuel pergi ke Rama, tetapi Saul pergi ke rumahnya, di Gibea-Saul."
 },
 {
   "id": 7598,
   "kitab": "1Sa",
   "pasal": 15,
   "ayat": 35,
   "firman": "Sampai hari matinya Samuel tidak melihat Saul lagi, tetapi Samuel berdukacita karena Saul. Dan TUHAN menyesal, karena Ia menjadikan Saul raja atas Israel."
 },
 {
   "id": 7599,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Samuel: \"Berapa lama lagi engkau berdukacita karena Saul? Bukankah ia telah Kutolak sebagai raja atas Israel? Isilah tabung tandukmu dengan minyak dan pergilah. Aku mengutus engkau kepada Isai, orang Betlehem itu, sebab di antara anak-anaknya telah Kupilih seorang raja bagi-Ku.\""
 },
 {
   "id": 7600,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 2,
   "firman": "Tetapi Samuel berkata: \"Bagaimana mungkin aku pergi? Jika Saul mendengarnya, ia akan membunuh aku.\" Firman TUHAN: \"Bawalah seekor lembu muda dan katakan: Aku datang untuk mempersembahkan korban kepada TUHAN."
 },
 {
   "id": 7601,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 3,
   "firman": "Kemudian undanglah Isai ke upacara pengorbanan itu, lalu Aku akan memberitahukan kepadamu apa yang harus kauperbuat. Urapilah bagi-Ku orang yang akan Kusebut kepadamu.\""
 },
 {
   "id": 7602,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 4,
   "firman": "Samuel berbuat seperti yang difirmankan TUHAN dan tibalah ia di kota Betlehem. Para tua-tua di kota itu datang mendapatkannya dengan gemetar dan berkata: \"Adakah kedatanganmu ini membawa selamat?\""
 },
 {
   "id": 7603,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 5,
   "firman": "Jawabnya: \"Ya, benar! Aku datang untuk mempersembahkan korban kepada TUHAN. Kuduskanlah dirimu, dan datanglah dengan daku ke upacara pengorbanan ini.\" Kemudian ia menguduskan Isai dan anak-anaknya yang laki-laki dan mengundang mereka ke upacara pengorbanan itu."
 },
 {
   "id": 7604,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 6,
   "firman": "Ketika mereka itu masuk dan Samuel melihat Eliab, lalu pikirnya: \"Sungguh, di hadapan TUHAN sekarang berdiri yang diurapi-Nya.\""
 },
 {
   "id": 7605,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 7,
   "firman": "Tetapi berfirmanlah TUHAN kepada Samuel: \"Janganlah pandang parasnya atau perawakan yang tinggi, sebab Aku telah menolaknya. Bukan yang dilihat manusia yang dilihat Allah; manusia melihat apa yang di depan mata, tetapi TUHAN melihat hati.\""
 },
 {
   "id": 7606,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lalu Isai memanggil Abinadab dan menyuruhnya lewat di depan Samuel, tetapi Samuel berkata: \"Orang inipun tidak dipilih TUHAN.\""
 },
 {
   "id": 7607,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 9,
   "firman": "Kemudian Isai menyuruh Syama lewat, tetapi Samuel berkata: \"Orang inipun tidak dipilih TUHAN.\""
 },
 {
   "id": 7608,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 10,
   "firman": "Demikianlah Isai menyuruh ketujuh anaknya lewat di depan Samuel, tetapi Samuel berkata kepada Isai: \"Semuanya ini tidak dipilih TUHAN.\""
 },
 {
   "id": 7609,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 11,
   "firman": "Lalu Samuel berkata kepada Isai: \"Inikah anakmu semuanya?\" Jawabnya: \"Masih tinggal yang bungsu, tetapi sedang menggembalakan kambing domba.\" Kata Samuel kepada Isai: \"Suruhlah memanggil dia, sebab kita tidak akan duduk makan, sebelum ia datang ke mari.\""
 },
 {
   "id": 7610,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 12,
   "firman": "Kemudian disuruhnyalah menjemput dia. Ia kemerah-merahan, matanya indah dan parasnya elok. Lalu TUHAN berfirman: \"Bangkitlah, urapilah dia, sebab inilah dia.\""
 },
 {
   "id": 7611,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 13,
   "firman": "Samuel mengambil tabung tanduk yang berisi minyak itu dan mengurapi Daud di tengah-tengah saudara-saudaranya. Sejak hari itu dan seterusnya berkuasalah Roh TUHAN atas Daud. Lalu berangkatlah Samuel menuju Rama."
 },
 {
   "id": 7612,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 14,
   "firman": "Tetapi Roh TUHAN telah mundur dari pada Saul, dan sekarang ia diganggu oleh roh jahat yang dari pada TUHAN."
 },
 {
   "id": 7613,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu berkatalah hamba-hamba Saul kepadanya: \"Ketahuilah, roh jahat yang dari pada Allah mengganggu engkau;"
 },
 {
   "id": 7614,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 16,
   "firman": "baiklah tuanku menitahkan hamba-hambamu yang di depanmu ini mencari seorang yang pandai main kecapi. Apabila roh jahat yang dari pada Allah itu hinggap padamu, haruslah ia main kecapi, maka engkau merasa nyaman.\""
 },
 {
   "id": 7615,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 17,
   "firman": "Berkatalah Saul kepada hamba-hambanya itu: \"Carilah bagiku seorang yang dapat main kecapi dengan baik, dan bawalah dia kepadaku.\""
 },
 {
   "id": 7616,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 18,
   "firman": "Lalu jawab salah seorang hamba itu, katanya: \"Sesungguhnya, aku telah melihat salah seorang anak laki-laki Isai, orang Betlehem itu, yang pandai main kecapi. Ia seorang pahlawan yang gagah perkasa, seorang prajurit, yang pandai bicara, elok perawakannya; dan TUHAN menyertai dia.\""
 },
 {
   "id": 7617,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 19,
   "firman": "Kemudian Saul mengirim suruhan kepada Isai dengan pesan: \"Suruhlah kepadaku anakmu Daud, yang ada pada kambing domba itu.\""
 },
 {
   "id": 7618,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 20,
   "firman": "Lalu Isai mengambil seekor keledai yang dimuati roti, sekirbat anggur dan seekor anak kambing, maka dikirimkannyalah itu kepada Saul dengan perantaraan Daud, anaknya."
 },
 {
   "id": 7619,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 21,
   "firman": "Demikianlah Daud sampai kepada Saul dan menjadi pelayannya. Saul sangat mengasihinya, dan ia menjadi pembawa senjatanya."
 },
 {
   "id": 7620,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 22,
   "firman": "Sebab itu Saul menyuruh orang kepada Isai mengatakan: \"Biarkanlah Daud tetap menjadi pelayanku, sebab aku suka kepadanya.\""
 },
 {
   "id": 7621,
   "kitab": "1Sa",
   "pasal": 16,
   "ayat": 23,
   "firman": "Dan setiap kali apabila roh yang dari pada Allah itu hinggap pada Saul, maka Daud mengambil kecapi dan memainkannya; Saul merasa lega dan nyaman, dan roh yang jahat itu undur dari padanya."
 },
 {
   "id": 7622,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 1,
   "firman": "Orang Filistin mengumpulkan tentaranya untuk berperang; mereka berkumpul di Sokho yang di tanah Yehuda dan berkemah antara Sokho dan Azeka di Efes-Damim."
 },
 {
   "id": 7623,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 2,
   "firman": "Saul dan orang-orang Israel juga berkumpul dan berkemah di Lembah Tarbantin; mereka mengatur barisan perangnya berhadapan dengan orang Filistin."
 },
 {
   "id": 7624,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 3,
   "firman": "Orang Filistin berdiri di bukit sebelah sini dan orang Israel berdiri di bukit sebelah sana, dan lembah ada di antara mereka."
 },
 {
   "id": 7625,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 4,
   "firman": "Lalu tampillah keluar seorang pendekar dari tentara orang Filistin. Namanya Goliat, dari Gat. Tingginya enam hasta sejengkal."
 },
 {
   "id": 7626,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 5,
   "firman": "Ketopong tembaga ada di kepalanya, dan ia memakai baju zirah yang bersisik; berat baju zirah ini lima ribu syikal tembaga."
 },
 {
   "id": 7627,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 6,
   "firman": "Dia memakai penutup kaki dari tembaga, dan di bahunya ia memanggul lembing tembaga."
 },
 {
   "id": 7628,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 7,
   "firman": "Gagang tombaknya seperti pesa tukang tenun, dan mata tombaknya itu enam ratus syikal besi beratnya. Dan seorang pembawa perisai berjalan di depannya."
 },
 {
   "id": 7629,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 8,
   "firman": "Ia berdiri dan berseru kepada barisan Israel, katanya kepada mereka: \"Mengapa kamu keluar untuk mengatur barisan perangmu? Bukankah aku seorang Filistin dan kamu adalah hamba Saul? Pilihlah bagimu seorang, dan biarlah ia turun mendapatkan daku."
 },
 {
   "id": 7630,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 9,
   "firman": "Jika ia dapat berperang melawan aku dan mengalahkan aku, maka kami akan menjadi hambamu; tetapi jika aku dapat mengungguli dia dan mengalahkannya, maka kamu akan menjadi hamba kami dan takluk kepada kami.\""
 },
 {
   "id": 7631,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 10,
   "firman": "Pula kata orang Filistin itu: \"Aku menantang hari ini barisan Israel; berikanlah kepadaku seorang, supaya kami berperang seorang lawan seorang.\""
 },
 {
   "id": 7632,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 11,
   "firman": "Ketika Saul dan segenap orang Israel mendengar perkataan orang Filistin itu, maka cemaslah hati mereka dan sangat ketakutan."
 },
 {
   "id": 7633,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 12,
   "firman": "Daud adalah anak seorang dari Efrata, dari Betlehem-Yehuda, yang bernama Isai. Isai mempunyai delapan anak laki-laki. Pada zaman Saul orang itu telah tua dan lanjut usianya."
 },
 {
   "id": 7634,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 13,
   "firman": "Ketiga anak Isai yang besar-besar telah pergi berperang mengikuti Saul; nama ketiga anaknya yang pergi berperang itu ialah Eliab, anak sulung, anak yang kedua ialah Abinadab, dan anak yang ketiga adalah Syama."
 },
 {
   "id": 7635,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 14,
   "firman": "Daudlah yang bungsu. Jadi ketiga anak yang besar-besar itu pergi mengikuti Saul."
 },
 {
   "id": 7636,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 15,
   "firman": "Tetapi Daud selalu pulang dari pada Saul untuk menggembalakan domba ayahnya di Betlehem."
 },
 {
   "id": 7637,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 16,
   "firman": "Orang Filistin itu maju mendekat pada pagi hari dan pada petang hari. Demikianlah ia tampil ke depan empat puluh hari lamanya."
 },
 {
   "id": 7638,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 17,
   "firman": "Isai berkata kepada Daud, anaknya: \"Ambillah untuk kakak-kakakmu bertih gandum ini seefa dan roti yang sepuluh ini; bawalah cepat-cepat ke perkemahan, kepada kakak-kakakmu."
 },
 {
   "id": 7639,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 18,
   "firman": "Dan baiklah sampaikan keju yang sepuluh ini kepada kepala pasukan seribu. Tengoklah apakah kakak-kakakmu selamat dan bawalah pulang suatu tanda dari mereka."
 },
 {
   "id": 7640,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 19,
   "firman": "Saul dan mereka itu dan semua orang Israel ada di Lembah Tarbantin tengah berperang melawan orang Filistin.\""
 },
 {
   "id": 7641,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 20,
   "firman": "Lalu Daud bangun pagi-pagi, ditinggalkannyalah kambing dombanya pada seorang penjaga, lalu mengangkat muatan dan pergi, seperti yang diperintahkan Isai kepadanya. Sampailah ia ke perkemahan, ketika tentara keluar untuk mengatur barisannya dan mengangkat sorak perang."
 },
 {
   "id": 7642,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 21,
   "firman": "Orang Israel dan orang Filistin itu mengatur barisannya, barisan berhadapan dengan barisan."
 },
 {
   "id": 7643,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 22,
   "firman": "Lalu Daud menurunkan barang-barangnya dan meninggalkannya di tangan penjaga barang-barang tentara. Berlari-larilah Daud ke tempat barisan; sesampai di sana, bertanyalah ia kepada kakak-kakaknya apakah mereka selamat."
 },
 {
   "id": 7644,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 23,
   "firman": "Sedang ia berbicara dengan mereka, tampillah maju pendekar itu. Namanya Goliat, orang Filistin dari Gat, dari barisan orang Filistin. Ia mengucapkan kata-kata yang tadi juga, dan Daud mendengarnya."
 },
 {
   "id": 7645,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 24,
   "firman": "Ketika semua orang Israel melihat orang itu, larilah mereka dari padanya dengan sangat ketakutan."
 },
 {
   "id": 7646,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 25,
   "firman": "Berkatalah orang-orang Israel itu: \"Sudahkah kamu lihat orang yang maju itu? Sesungguhnya ia maju untuk mencemoohkan orang Israel! Orang yang mengalahkan dia akan dianugerahi raja kekayaan yang besar, raja akan memberikan anaknya yang perempuan kepadanya dan kaum keluarganya akan dibebaskannya dari pajak di Israel.\""
 },
 {
   "id": 7647,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 26,
   "firman": "Lalu berkatalah Daud kepada orang-orang yang berdiri di dekatnya: \"Apakah yang akan dilakukan kepada orang yang mengalahkan orang Filistin itu dan yang menghindarkan cemooh dari Israel? Siapakah orang Filistin yang tak bersunat ini, sampai ia berani mencemoohkan barisan dari pada Allah yang hidup?\""
 },
 {
   "id": 7648,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 27,
   "firman": "Rakyat itupun menjawabnya dengan perkataan tadi: \"Begitulah akan dilakukan kepada orang yang mengalahkan dia.\""
 },
 {
   "id": 7649,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 28,
   "firman": "Ketika Eliab, kakaknya yang tertua, mendengar perkataan Daud kepada orang-orang itu, bangkitlah amarah Eliab kepada Daud sambil berkata: \"Mengapa engkau datang? Dan pada siapakah kautinggalkan kambing domba yang dua tiga ekor itu di padang gurun? Aku kenal sifat pemberanimu dan kejahatan hatimu: engkau datang ke mari dengan maksud melihat pertempuran.\""
 },
 {
   "id": 7650,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 29,
   "firman": "Tetapi jawab Daud: \"Apa yang telah kuperbuat? Hanya bertanya saja!\""
 },
 {
   "id": 7651,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 30,
   "firman": "Lalu berpalinglah ia dari padanya kepada orang lain dan menanyakan yang sama. Dan rakyat memberi jawab kepadanya seperti tadi."
 },
 {
   "id": 7652,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 31,
   "firman": "Terdengarlah kepada orang perkataan yang diucapkan oleh Daud, lalu diberitahukanlah kepada Saul. Dan Saul menyuruh memanggil dia."
 },
 {
   "id": 7653,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 32,
   "firman": "Berkatalah Daud kepada Saul: \"Janganlah seseorang menjadi tawar hati karena dia; hambamu ini akan pergi melawan orang Filistin itu.\""
 },
 {
   "id": 7654,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 33,
   "firman": "Tetapi Saul berkata kepada Daud: \"Tidak mungkin engkau dapat menghadapi orang Filistin itu untuk melawan dia, sebab engkau masih muda, sedang dia sejak dari masa mudanya telah menjadi prajurit.\""
 },
 {
   "id": 7655,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 34,
   "firman": "Tetapi Daud berkata kepada Saul: \"Hambamu ini biasa menggembalakan kambing domba ayahnya. Apabila datang singa atau beruang, yang menerkam seekor domba dari kawanannya,"
 },
 {
   "id": 7656,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 35,
   "firman": "maka aku mengejarnya, menghajarnya dan melepaskan domba itu dari mulutnya. Kemudian apabila ia berdiri menyerang aku, maka aku menangkap janggutnya lalu menghajarnya dan membunuhnya."
 },
 {
   "id": 7657,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 36,
   "firman": "Baik singa maupun beruang telah dihajar oleh hambamu ini. Dan orang Filistin yang tidak bersunat itu, ia akan sama seperti salah satu dari pada binatang itu, karena ia telah mencemooh barisan dari pada Allah yang hidup.\""
 },
 {
   "id": 7658,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 37,
   "firman": "Pula kata Daud: \"TUHAN yang telah melepaskan aku dari cakar singa dan dari cakar beruang, Dia juga akan melepaskan aku dari tangan orang Filistin itu.\" Kata Saul kepada Daud: \"Pergilah! TUHAN menyertai engkau.\""
 },
 {
   "id": 7659,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 38,
   "firman": "Lalu Saul mengenakan baju perangnya kepada Daud, ditaruhnya ketopong tembaga di kepalanya dan dikenakannya baju zirah kepadanya."
 },
 {
   "id": 7660,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 39,
   "firman": "Lalu Daud mengikatkan pedangnya di luar baju perangnya, kemudian ia berikhtiar berjalan, sebab belum pernah dicobanya. Maka berkatalah Daud kepada Saul: \"Aku tidak dapat berjalan dengan memakai ini, sebab belum pernah aku mencobanya.\" Kemudian ia menanggalkannya."
 },
 {
   "id": 7661,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 40,
   "firman": "Lalu Daud mengambil tongkatnya di tangannya, dipilihnya dari dasar sungai lima batu yang licin dan ditaruhnya dalam kantung gembala yang dibawanya, yakni tempat batu-batu, sedang umbannya dipegangnya di tangannya. Demikianlah ia mendekati orang Filistin itu."
 },
 {
   "id": 7662,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 41,
   "firman": "Orang Filistin itu kian dekat menghampiri Daud dan di depannya orang yang membawa perisainya."
 },
 {
   "id": 7663,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 42,
   "firman": "Ketika orang Filistin itu menujukan pandangnya ke arah Daud serta melihat dia, dihinanya Daud itu karena ia masih muda, kemerah-merahan dan elok parasnya."
 },
 {
   "id": 7664,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 43,
   "firman": "Orang Filistin itu berkata kepada Daud: \"Anjingkah aku, maka engkau mendatangi aku dengan tongkat?\" Lalu demi para allahnya orang Filistin itu mengutuki Daud."
 },
 {
   "id": 7665,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 44,
   "firman": "Pula orang Filistin itu berkata kepada Daud: \"Hadapilah aku, maka aku akan memberikan dagingmu kepada burung-burung di udara dan kepada binatang-binatang di padang.\""
 },
 {
   "id": 7666,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 45,
   "firman": "Tetapi Daud berkata kepada orang Filistin itu: \"Engkau mendatangi aku dengan pedang dan tombak dan lembing, tetapi aku mendatangi engkau dengan nama TUHAN semesta alam, Allah segala barisan Israel yang kautantang itu."
 },
 {
   "id": 7667,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 46,
   "firman": "Hari ini juga TUHAN akan menyerahkan engkau ke dalam tanganku dan aku akan mengalahkan engkau dan memenggal kepalamu dari tubuhmu; hari ini juga aku akan memberikan mayatmu dan mayat tentara orang Filistin kepada burung-burung di udara dan kepada binatang-binatang liar, supaya seluruh bumi tahu, bahwa Israel mempunyai Allah,"
 },
 {
   "id": 7668,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 47,
   "firman": "dan supaya segenap jemaah ini tahu, bahwa TUHAN menyelamatkan bukan dengan pedang dan bukan dengan lembing. Sebab di tangan Tuhanlah pertempuran dan Iapun menyerahkan kamu ke dalam tangan kami.\""
 },
 {
   "id": 7669,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 48,
   "firman": "Ketika orang Filistin itu bergerak maju untuk menemui Daud, maka segeralah Daud berlari ke barisan musuh untuk menemui orang Filistin itu;"
 },
 {
   "id": 7670,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 49,
   "firman": "lalu Daud memasukkan tangannya dalam kantungnya, diambilnyalah sebuah batu dari dalamnya, diumbannya, maka kenalah dahi orang Filistin itu, sehingga batu itu terbenam ke dalam dahinya, dan terjerumuslah ia dengan mukanya ke tanah."
 },
 {
   "id": 7671,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 50,
   "firman": "Demikianlah Daud mengalahkan orang Filistin itu dengan umban dan batu; ia mengalahkan orang Filistin itu dan membunuhnya, tanpa pedang di tangan."
 },
 {
   "id": 7672,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 51,
   "firman": "Daud berlari mendapatkan orang Filistin itu, lalu berdiri di sebelahnya; diambilnyalah pedangnya, dihunusnya dari sarungnya, lalu menghabisi dia. Dipancungnyalah kepalanya dengan pedang itu. Ketika orang-orang Filistin melihat, bahwa pahlawan mereka telah mati, maka larilah mereka."
 },
 {
   "id": 7673,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 52,
   "firman": "Maka bangkitlah orang-orang Israel dan Yehuda, mereka bersorak-sorak lalu mengejar orang-orang Filistin sampai dekat Gat dan sampai pintu gerbang Ekron. Dan orang-orang yang terbunuh dari orang Filistin bergelimpangan di jalan ke Saaraim, sampai Gat dan sampai Ekron."
 },
 {
   "id": 7674,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 53,
   "firman": "Kemudian pulanglah orang Israel dari pemburuan hebat atas orang Filistin, lalu menjarah perkemahan mereka."
 },
 {
   "id": 7675,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 54,
   "firman": "Dan Daud mengambil kepala orang Filistin yang dipancungnya itu dan membawanya ke Yerusalem, tetapi senjata-senjata orang itu ditaruhnya dalam kemahnya."
 },
 {
   "id": 7676,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 55,
   "firman": "Ketika Saul melihat Daud pergi menemui orang Filistin itu, berkatalah ia kepada Abner, panglima tentaranya: \"Anak siapakah orang muda itu, Abner?\" Jawab Abner: \"Demi tuanku hidup, ya raja, sesungguhnya aku tidak tahu.\""
 },
 {
   "id": 7677,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 56,
   "firman": "Kemudian raja berkata: \"Tanyakanlah, anak siapakah orang muda itu.\""
 },
 {
   "id": 7678,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 57,
   "firman": "Ketika Daud kembali sesudah mengalahkan orang Filistin itu, maka Abner memanggilnya dan membawanya menghadap Saul, sedang kepala orang Filistin itu masih ada di tangannya."
 },
 {
   "id": 7679,
   "kitab": "1Sa",
   "pasal": 17,
   "ayat": 58,
   "firman": "Kata Saul kepadanya: \"Anak siapakah engkau, ya orang muda?\" Jawab Daud: \"Anak hamba tuanku, Isai, orang Betlehem itu.\""
 },
 {
   "id": 7680,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 1,
   "firman": "Ketika Daud habis berbicara dengan Saul, berpadulah jiwa Yonatan dengan jiwa Daud; dan Yonatan mengasihi dia seperti jiwanya sendiri."
 },
 {
   "id": 7681,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 2,
   "firman": "Pada hari itu Saul membawa dia dan tidak membiarkannya pulang ke rumah ayahnya."
 },
 {
   "id": 7682,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 3,
   "firman": "Yonatan mengikat perjanjian dengan Daud, karena ia mengasihi dia seperti dirinya sendiri."
 },
 {
   "id": 7683,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 4,
   "firman": "Yonatan menanggalkan jubah yang dipakainya, dan memberikannya kepada Daud, juga baju perangnya, sampai pedangnya, panahnya dan ikat pinggangnya."
 },
 {
   "id": 7684,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 5,
   "firman": "Daud maju berperang dan selalu berhasil ke mana juga Saul menyuruhnya, sehingga Saul mengangkat dia mengepalai para prajurit. Hal ini dipandang baik oleh seluruh rakyat dan juga oleh pegawai-pegawai Saul."
 },
 {
   "id": 7685,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 6,
   "firman": "Tetapi pada waktu mereka pulang, ketika Daud kembali sesudah mengalahkan orang Filistin itu, keluarlah orang-orang perempuan dari segala kota Israel menyongsong raja Saul sambil menyanyi dan menari-nari dengan memukul rebana, dengan bersukaria dan dengan membunyikan gerincing;"
 },
 {
   "id": 7686,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 7,
   "firman": "dan perempuan yang menari-nari itu menyanyi berbalas-balasan, katanya: \"Saul mengalahkan beribu-ribu musuh, tetapi Daud berlaksa-laksa.\""
 },
 {
   "id": 7687,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 8,
   "firman": "Lalu bangkitlah amarah Saul dengan sangat; dan perkataan itu menyebalkan hatinya, sebab pikirnya: \"Kepada Daud diperhitungkan mereka berlaksa-laksa, tetapi kepadaku diperhitungkannya beribu-ribu; akhir-akhirnya jabatan raja itupun jatuh kepadanya.\""
 },
 {
   "id": 7688,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 9,
   "firman": "Sejak hari itu maka Saul selalu mendengki Daud."
 },
 {
   "id": 7689,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 10,
   "firman": "Keesokan harinya roh jahat yang dari pada Allah itu berkuasa atas Saul, sehingga ia kerasukan di tengah-tengah rumah, sedang Daud main kecapi seperti sehari-hari. Adapun Saul ada tombak di tangannya."
 },
 {
   "id": 7690,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 11,
   "firman": "Saul melemparkan tombak itu, karena pikirnya: \"Baiklah aku menancapkan Daud ke dinding.\" Tetapi Daud mengelakkannya sampai dua kali."
 },
 {
   "id": 7691,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 12,
   "firman": "Saul menjadi takut kepada Daud, karena TUHAN menyertai Daud, sedang dari pada Saul Ia telah undur."
 },
 {
   "id": 7692,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 13,
   "firman": "Sebab itu Saul menjauhkan Daud dari dekatnya dan mengangkat dia menjadi kepala pasukan seribu, sehingga ia berada di depan dalam segala gerakan tentara."
 },
 {
   "id": 7693,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 14,
   "firman": "Daud berhasil di segala perjalanannya, sebab TUHAN menyertai dia."
 },
 {
   "id": 7694,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 15,
   "firman": "Ketika dilihat Saul, bahwa Daud sangat berhasil, makin takutlah ia kepadanya;"
 },
 {
   "id": 7695,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 16,
   "firman": "tetapi seluruh orang Israel dan orang Yehuda mengasihi Daud, karena ia memimpin segala gerakan mereka."
 },
 {
   "id": 7696,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 17,
   "firman": "Berkatalah Saul kepada Daud: \"Ini dia anakku perempuan yang tertua, Merab; dia akan kuberikan kepadamu menjadi isterimu, hanya jadilah bagiku seorang yang gagah perkasa dan lakukanlah perang TUHAN.\" Sebab pikir Saul: \"Janganlah tanganku memukul dia, tetapi biarlah ia dipukul oleh tangan orang Filistin.\""
 },
 {
   "id": 7697,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 18,
   "firman": "Tetapi Daud berkata kepada Saul: \"Siapakah aku dan siapakah sanak saudaraku, kaum ayahku, di antara orang Israel, sehingga aku menjadi menantu raja?\""
 },
 {
   "id": 7698,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 19,
   "firman": "Tetapi ketika tiba waktunya untuk memberikan Merab, anak Saul itu, kepada Daud, maka anak perempuan itu diberikan kepada Adriel, orang Mehola, menjadi isterinya."
 },
 {
   "id": 7699,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 20,
   "firman": "Tetapi Mikhal, anak perempuan Saul, jatuh cinta kepada Daud; ketika hal itu diberitahukan kepada Saul, maka iapun menyetujuinya;"
 },
 {
   "id": 7700,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 21,
   "firman": "sebab pikir Saul: \"Baiklah Mikhal kuberikan kepadanya; biarlah ia menjadi jerat bagi Daud, dan biarlah tangan orang Filistin memukul dia!\" Lalu berkatalah Saul kepada Daud untuk kedua kalinya: \"Pada hari ini engkau boleh menjadi menantuku.\""
 },
 {
   "id": 7701,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 22,
   "firman": "Lagi Saul memerintahkan kepada para pegawainya: \"Katakanlah kepada Daud dengan diam-diam, demikian: Sesungguhnya, raja suka kepadamu dan para pegawainya mengasihi engkau; maka sebab itu, jadilah engkau menantu raja.\""
 },
 {
   "id": 7702,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 23,
   "firman": "Lalu para pegawai Saul menyampaikan perkataan itu kepada Daud, tetapi Daud menjawab: \"Perkara ringankah pada pemandanganmu menjadi menantu raja? Bukankah aku seorang yang miskin dan rendah?\""
 },
 {
   "id": 7703,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 24,
   "firman": "Para pegawai Saul memberitahukan kepada raja, katanya: \"Demikianlah jawab yang diberi Daud.\""
 },
 {
   "id": 7704,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 25,
   "firman": "Kemudian berkatalah Saul: \"Beginilah kamu katakan kepada Daud: Raja tidak menghendaki mas kawin selain dari seratus kulit khatan orang Filistin sebagai pembalasan kepada musuh raja.\" Saul bermaksud untuk menjatuhkan Daud dengan perantaraan orang Filistin."
 },
 {
   "id": 7705,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 26,
   "firman": "Ketika para pegawainya memberitahukan perkataan itu kepada Daud, maka setujulah Daud menjadi menantu raja. Waktunya belum genap,"
 },
 {
   "id": 7706,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 27,
   "firman": "tetapi Daud sudah bersiap, ia pergi dengan orang-orangnya dan menewaskan dari orang Filistin itu dua ratus orang serta membawa kulit khatan mereka; dan dalam jumlah yang genap diberikan merekalah semuanya itu kepada raja, supaya Daud menjadi menantu raja. Kemudian Saul memberikan Mikhal, anaknya, kepadanya menjadi isterinya."
 },
 {
   "id": 7707,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 28,
   "firman": "Lalu mengertilah Saul dan tahulah ia, bahwa TUHAN menyertai Daud, dan bahwa seluruh orang Israel mengasihi Daud."
 },
 {
   "id": 7708,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 29,
   "firman": "Maka makin takutlah Saul kepada Daud. Saul tetap menjadi musuh Daud seumur hidupnya."
 },
 {
   "id": 7709,
   "kitab": "1Sa",
   "pasal": 18,
   "ayat": 30,
   "firman": "Apabila raja-raja orang Filistin maju berperang, setiap kali mereka maju berperang, maka Daud lebih berhasil dari semua pegawai Saul, sehingga namanya sangat masyhur."
 },
 {
   "id": 7710,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 1,
   "firman": "Saul mengatakan kepada Yonatan, anaknya, dan kepada semua pegawainya, bahwa Daud harus dibunuh. Tetapi Yonatan, anak Saul, sangat suka kepada Daud,"
 },
 {
   "id": 7711,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 2,
   "firman": "sehingga Yonatan memberitahukan kepada Daud: \"Ayahku Saul berikhtiar untuk membunuh engkau; oleh sebab itu, hati-hatilah besok pagi, duduklah di suatu tempat perlindungan dan bersembunyilah di sana."
 },
 {
   "id": 7712,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 3,
   "firman": "Aku akan keluar dan berdiri di sisi ayahku di padang tempatmu itu. Maka aku akan berbicara dengan ayahku perihalmu; aku akan melihat bagaimana keadaannya, lalu memberitahukannya kepadamu.\""
 },
 {
   "id": 7713,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 4,
   "firman": "Lalu Yonatan mengatakan yang baik tentang Daud kepada Saul, ayahnya, katanya: \"Janganlah raja berbuat dosa terhadap Daud, hambanya, sebab ia tidak berbuat dosa terhadapmu; bukankah apa yang diperbuatnya sangat baik bagimu!"
 },
 {
   "id": 7714,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ia telah mempertaruhkan nyawanya dan telah mengalahkan orang Filistin itu, dan TUHAN telah memberikan kemenangan yang besar kepada seluruh Israel. Engkau sudah melihatnya dan bersukacita karenanya. Mengapa engkau hendak berbuat dosa terhadap darah orang yang tidak bersalah dengan membunuh Daud tanpa alasan?\""
 },
 {
   "id": 7715,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 6,
   "firman": "Saul mendengarkan perkataan Yonatan dan Saul bersumpah: \"Demi TUHAN yang hidup, ia tidak akan dibunuh.\""
 },
 {
   "id": 7716,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 7,
   "firman": "Lalu Yonatan memanggil Daud dan Yonatan memberitahukan kepadanya segala perkataan itu. Yonatan membawa Daud kepada Saul dan ia bekerja padanya seperti dahulu."
 },
 {
   "id": 7717,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 8,
   "firman": "Ketika perang pecah pula, maka majulah Daud dan berperang melawan orang Filistin; ia menimbulkan kekalahan besar di antara mereka, sehingga mereka melarikan diri dari depannya."
 },
 {
   "id": 7718,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 9,
   "firman": "Tetapi roh jahat yang dari pada TUHAN hinggap pada Saul, ketika ia duduk di rumahnya, dengan tombaknya di tangannya; dan Daud sedang main kecapi."
 },
 {
   "id": 7719,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 10,
   "firman": "Lalu Saul berikhtiar menancapkan Daud ke dinding dengan tombaknya, tetapi Daud mengelakkan tikaman Saul, sehingga Saul mengenai dinding dengan tombak itu. Sesudah itu Daud melarikan diri dan luputlah ia pada malam itu."
 },
 {
   "id": 7720,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 11,
   "firman": "Kemudian Saul mengirim orang-orang suruhan ke rumah Daud untuk mengamat-amatinya dan untuk membunuh dia pada waktu pagi. Tetapi Mikhal, isteri Daud, memberitahukan kepadanya, demikian: \"Jika engkau tidak dapat meluputkan dirimu malam ini, maka besok engkau akan dibunuh.\""
 },
 {
   "id": 7721,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 12,
   "firman": "Lalu Mikhal menurunkan Daud dari jendela, ia pergi melarikan diri dan luputlah ia."
 },
 {
   "id": 7722,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 13,
   "firman": "Sesudah itu Mikhal mengambil terafim dan menaruhnya di tempat tidur; ditaruhnya sehelai tenunan bulu kambing di bagian kepala dan ditutupinya dengan selimut."
 },
 {
   "id": 7723,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 14,
   "firman": "Lalu Saul mengirim orang-orang suruhan untuk mengambil Daud, tetapi perempuan itu berkata: \"Ia sakit.\""
 },
 {
   "id": 7724,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 15,
   "firman": "Sesudah itu Saul mengirim orang-orang suruhan itu untuk melihat Daud, katanya: \"Bawalah dia di atas tempat tidur itu ke mari, supaya ia dibunuh.\""
 },
 {
   "id": 7725,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 16,
   "firman": "Lalu masuklah para suruhan itu ke dalam, dan tampaklah ada terafim di tempat tidur dengan sehelai tenunan bulu kambing di bagian kepala."
 },
 {
   "id": 7726,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 17,
   "firman": "Berkatalah Saul kepada Mikhal: \"Mengapa engkau menipu aku demikian itu dan melepas musuhku pergi, sehingga ia luput?\" Tetapi jawab Mikhal kepada Saul: \"Ia berkata kepadaku: Biarkanlah aku pergi, apa perlunya aku membunuh engkau?\""
 },
 {
   "id": 7727,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 18,
   "firman": "Setelah Daud melarikan diri dan luput, sampailah ia kepada Samuel di Rama dan memberitahukan kepadanya segala yang dilakukan Saul kepadanya. Kemudian pergilah ia bersama-sama dengan Samuel dan tinggallah mereka di Nayot."
 },
 {
   "id": 7728,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 19,
   "firman": "Ketika diberitahukan kepada Saul, demikian: \"Ketahuilah, Daud ada di Nayot, dekat Rama,\""
 },
 {
   "id": 7729,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 20,
   "firman": "maka Saul mengirim orang-orang suruhan untuk mengambil Daud. Tetapi orang-orang ini melihat sekumpulan nabi kepenuhan, dengan dikepalai oleh Samuel. Dan Roh Allah hinggap pada orang-orang suruhan Saul, sehingga merekapun kepenuhan seperti nabi."
 },
 {
   "id": 7730,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 21,
   "firman": "Lalu hal itu diberitahukan kepada Saul; ia mengirim orang-orang suruhan yang lain, tetapi orang-orang itupun juga kepenuhan seperti nabi. Saul mengirim sekali lagi orang-orang suruhan, rombongan yang ketiga, dan orang-orang inipun juga kepenuhan."
 },
 {
   "id": 7731,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 22,
   "firman": "Lalu ia sendiri pergi ke Rama. Sesampainya ke dekat perigi besar yang di Sekhu, bertanyalah ia, katanya: \"Di mana Samuel dan Daud?\" Jawab orang: \"Ada di Nayot, dekat Rama.\""
 },
 {
   "id": 7732,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 23,
   "firman": "Lalu pergilah ia ke sana, ke Nayot, dekat Rama dan pada diapun hinggaplah Roh Allah, dan selama ia melanjutkan perjalanannya ia kepenuhan seperti nabi, hingga ia sampai ke Nayot dekat Rama."
 },
 {
   "id": 7733,
   "kitab": "1Sa",
   "pasal": 19,
   "ayat": 24,
   "firman": "Iapun menanggalkan pakaiannya, dan iapun juga kepenuhan di depan Samuel. Ia rebah terhantar dengan telanjang sehari-harian dan semalam-malaman itu. Itulah sebabnya orang berkata: \"Apakah juga Saul termasuk golongan nabi?\""
 },
 {
   "id": 7734,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 1,
   "firman": "Maka larilah Daud dari Nayot, dekat Rama; sampailah ia kepada Yonatan, lalu berkata: \"Apakah yang telah kuperbuat? Apakah kesalahanku dan apakah dosaku terhadap ayahmu, sehingga ia ingin mencabut nyawaku?\""
 },
 {
   "id": 7735,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 2,
   "firman": "Tetapi Yonatan berkata kepadanya: \"Jauhlah yang demikian itu! engkau tidak akan mati dibunuh. Ingatlah, ayahku tidak berbuat sesuatu, baik perkara besar maupun perkara kecil, dengan tidak menyatakannya kepadaku. Mengapa ayahku harus menyembunyikan perkara ini kepadaku? Tidak mungkin!\""
 },
 {
   "id": 7736,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 3,
   "firman": "Tetapi Daud menjawab, katanya: \"Ayahmu tahu benar, bahwa engkau suka kepadaku. Sebab itu pikirnya: Tidak boleh Yonatan mengetahui hal ini, nanti ia bersusah hati. Namun, demi TUHAN yang hidup dan demi hidupmu, hanya satu langkah jaraknya antara aku dan maut.\""
 },
 {
   "id": 7737,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 4,
   "firman": "Yonatan berkata kepada Daud: \"Apapun kehendak hatimu, aku akan melakukannya bagimu.\""
 },
 {
   "id": 7738,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 5,
   "firman": "Lalu kata Daud kepada Yonatan: \"Kautahu, besok bulan baru, maka sebenarnya aku harus duduk makan bersama-sama dengan raja. Jika engkau membiarkan aku pergi, maka aku akan bersembunyi di padang sampai lusa petang."
 },
 {
   "id": 7739,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 6,
   "firman": "Apabila ayahmu menanyakan aku, haruslah kaukatakan: Daud telah meminta dengan sangat kepadaku untuk pergi dengan segera ke Betlehem, kotanya, karena di sana ada upacara pengorbanan tahunan bagi segenap kaumnya."
 },
 {
   "id": 7740,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 7,
   "firman": "Jika begini dikatakannya: Baiklah! maka hambamu ini selamat. Tetapi jika amarahnya bangkit dengan segera, ketahuilah, bahwa ia telah mengambil keputusan untuk mendatangkan celaka."
 },
 {
   "id": 7741,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 8,
   "firman": "Jika demikian, tunjukkanlah kesetiaanmu kepada hambamu ini, sebab engkau telah mengikat perjanjian di hadapan TUHAN dengan hambamu ini. Tetapi jika ada kesalahan padaku, engkau sendirilah membunuh aku. Mengapa engkau harus menyerahkan aku kepada ayahmu?\""
 },
 {
   "id": 7742,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 9,
   "firman": "Tetapi jawab Yonatan: \"Jauhlah yang demikian itu! Sebab jika kuketahui dengan pasti, bahwa ayahku telah mengambil keputusan untuk mendatangkan celaka kepadamu, masakan aku tidak memberitahukannya kepadamu?\""
 },
 {
   "id": 7743,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 10,
   "firman": "Lalu bertanyalah Daud kepada Yonatan: \"Siapakah yang akan memberitahukan kepadaku, apabila ayahmu menjawab engkau dengan keras?\""
 },
 {
   "id": 7744,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 11,
   "firman": "Kata Yonatan kepada Daud: \"Marilah kita keluar ke padang.\" Maka keluarlah keduanya ke padang."
 },
 {
   "id": 7745,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 12,
   "firman": "Lalu berkatalah Yonatan kepada Daud: \"Demi TUHAN, Allah Israel, besok atau lusa kira-kira waktu ini aku akan memeriksa perasaan ayahku. Apabila baik keadaannya bagi Daud, masakan aku tidak akan menyuruh orang kepadamu dan memberitahukannya kepadamu?"
 },
 {
   "id": 7746,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 13,
   "firman": "Tetapi apabila ayahku memandang baik untuk mendatangkan celaka kepadamu, beginilah kiranya TUHAN menghukum Yonatan, bahkan lebih lagi dari pada itu, sekiranya aku tidak menyatakannya kepadamu dan membiarkan engkau pergi, sehingga engkau dapat berjalan dengan selamat. TUHAN kiranya menyertai engkau, seperti Ia menyertai ayahku dahulu."
 },
 {
   "id": 7747,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 14,
   "firman": "Jika aku masih hidup, bukankah engkau akan menunjukkan kepadaku kasih setia TUHAN? Tetapi jika aku sudah mati,"
 },
 {
   "id": 7748,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 15,
   "firman": "janganlah engkau memutuskan kasih setiamu terhadap keturunanku sampai selamanya. Dan apabila TUHAN melenyapkan setiap orang dari musuh Daud dari muka bumi,"
 },
 {
   "id": 7749,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 16,
   "firman": "janganlah nama Yonatan terhapus dari keturunan Daud, melainkan kiranya TUHAN menuntut balas dari pada musuh-musuh Daud.\""
 },
 {
   "id": 7750,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 17,
   "firman": "Dan Yonatan menyuruh Daud sekali lagi bersumpah demi kasihnya kepadanya, sebab ia mengasihi Daud seperti dirinya sendiri."
 },
 {
   "id": 7751,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 18,
   "firman": "Kemudian berkatalah Yonatan kepadanya: \"Besok bulan baru; maka engkau nanti akan ditanyakan, sebab tempat dudukmu akan tinggal kosong."
 },
 {
   "id": 7752,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 19,
   "firman": "Tetapi lusa engkau pasti akan dicari; engkau harus datang ke tempat engkau bersembunyi pada hari peristiwa itu, dan duduklah dekat bukit batu."
 },
 {
   "id": 7753,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 20,
   "firman": "Maka aku akan memanahkan tiga anak panah ke samping batu itu, seolah-olah aku membidik suatu sasaran."
 },
 {
   "id": 7754,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 21,
   "firman": "Dan ketahuilah, aku akan menyuruh bujangku: Pergilah mencari anak-anak panah itu. Jika tegas kukatakan kepada bujang itu: Lihat anak-anak panah itu lebih ke mari, ambillah! --maka datanglah, sebab, demi TUHAN yang hidup, engkau selamat dan tidak ada bahaya apa-apa."
 },
 {
   "id": 7755,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 22,
   "firman": "Tetapi jika begini kukatakan kepada orang muda itu: Lihat anak-anak panah itu lebih ke sana! --maka pergilah, sebab TUHAN menyuruh engkau pergi."
 },
 {
   "id": 7756,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 23,
   "firman": "Tentang hal yang kita janjikan itu, antara aku dan engkau, sesungguhnya, TUHAN ada di antara aku dan engkau sampai selamanya.\""
 },
 {
   "id": 7757,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 24,
   "firman": "Sesudah itu bersembunyilah Daud di padang. Ketika bulan baru tiba, duduklah raja pada meja untuk makan."
 },
 {
   "id": 7758,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 25,
   "firman": "Raja duduk di tempatnya seperti biasa, dekat dinding. Yonatan berhadapan dengan dia, Abner duduk di sisi Saul, tetapi tempat Daud tinggal kosong."
 },
 {
   "id": 7759,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 26,
   "firman": "Dan Saul tidak berkata apa-apa pada hari itu, sebab pikirnya: \"Barangkali ada sesuatu yang terjadi kepadanya; mungkin ia tidak tahir; ya, tentu ia tidak tahir.\""
 },
 {
   "id": 7760,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 27,
   "firman": "Tetapi pada hari sesudah bulan baru itu, pada hari yang kedua, ketika tempat Daud masih tinggal kosong, bertanyalah Saul kepada Yonatan, anaknya: \"Mengapa anak Isai tidak datang makan, baik kemarin maupun hari ini?\""
 },
 {
   "id": 7761,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 28,
   "firman": "Jawab Yonatan kepada Saul: \"Daud telah meminta dengan sangat kepadaku untuk pergi ke Betlehem,"
 },
 {
   "id": 7762,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 29,
   "firman": "katanya: Biarkanlah aku pergi, sebab ada upacara pengorbanan bagi kaum kami di kota, dan saudara-saudaraku sendirilah yang memanggil aku. Oleh sebab itu, jika engkau mengasihi aku, berilah izin kepadaku untuk menengok saudara-saudaraku. Itulah sebabnya ia tidak datang ke perjamuan raja.\""
 },
 {
   "id": 7763,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 30,
   "firman": "Lalu bangkitlah amarah Saul kepada Yonatan, katanya kepadanya: \"Anak sundal yang kurang ajar! Bukankah aku tahu, bahwa engkau telah memilih pihak anak Isai dan itu noda bagi kau sendiri dan bagi perut ibumu?"
 },
 {
   "id": 7764,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 31,
   "firman": "Sebab sesungguhnya selama anak Isai itu hidup di muka bumi, engkau dan kerajaanmu tidak akan kokoh. Dan sekarang suruhlah orang memanggil dan membawa dia kepadaku, sebab ia harus mati.\""
 },
 {
   "id": 7765,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 32,
   "firman": "Tetapi Yonatan menjawab Saul, ayahnya itu, katanya kepadanya: \"Mengapa ia harus dibunuh? Apa yang dilakukannya?\""
 },
 {
   "id": 7766,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 33,
   "firman": "Lalu Saul melemparkan tombaknya kepada Yonatan untuk membunuhnya. Maka tahulah Yonatan, bahwa ayahnya telah mengambil keputusan untuk membunuh Daud."
 },
 {
   "id": 7767,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 34,
   "firman": "Sebab itu Yonatan bangkit dan meninggalkan perjamuan itu dengan kemarahan yang bernyala-nyala. Pada hari yang kedua bulan baru itu ia tidak makan apa-apa, sebab ia bersusah hati karena Daud, sebab ayahnya telah menghina Daud."
 },
 {
   "id": 7768,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 35,
   "firman": "Pada waktu pagi keluarlah Yonatan ke padang bersama-sama seorang budak kecil sesuai dengan janjinya kepada Daud."
 },
 {
   "id": 7769,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 36,
   "firman": "Berkatalah ia kepada budaknya: \"Larilah, carilah anak-anak panah yang kupanahkan.\" Baru saja budak itu berlari, maka Yonatan melepaskan sebatang anak panah lewat kepala budak itu."
 },
 {
   "id": 7770,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 37,
   "firman": "Ketika budak itu sampai ke tempat letaknya anak panah yang dilepaskan Yonatan itu, maka berserulah Yonatan dari belakang budak itu, katanya: \"Bukankah anak panah itu lebih ke sana?\""
 },
 {
   "id": 7771,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 38,
   "firman": "Kemudian berserulah Yonatan dari belakang budak itu: \"Ayo, cepat, jangan berdiri saja!\" Lalu budak Yonatan memungut anak panah itu dan kembali kepada tuannya."
 },
 {
   "id": 7772,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 39,
   "firman": "Tetapi budak itu tidak tahu apa-apa, hanya Yonatan dan Daudlah yang mengetahui hal itu."
 },
 {
   "id": 7773,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 40,
   "firman": "Sesudah itu Yonatan memberikan senjatanya kepada budak yang menyertai dia, dan berkata kepadanya: \"Pergilah, bawalah ke kota.\""
 },
 {
   "id": 7774,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 41,
   "firman": "Maka pulanglah budak itu, lalu tampillah Daud dari sebelah bukit batu; ia sujud dengan mukanya ke tanah dan menyembah tiga kali. Mereka bercium-ciuman dan bertangis-tangisan. Akhirnya Daud dapat menahan diri."
 },
 {
   "id": 7775,
   "kitab": "1Sa",
   "pasal": 20,
   "ayat": 42,
   "firman": "Kemudian berkatalah Yonatan kepada Daud: \"Pergilah dengan selamat; bukankah kita berdua telah bersumpah demi nama TUHAN, demikian: TUHAN akan ada di antara aku dan engkau serta di antara keturunanku dan keturunanmu sampai selamanya.\" (20-43) Setelah itu bangunlah Daud dan pergi; dan Yonatanpun pulang ke kota."
 },
 {
   "id": 7776,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 1,
   "firman": "Sampailah Daud ke Nob kepada Ahimelekh, imam itu. Dengan gemetar Ahimelekh pergi menemui Daud dan berkata kepadanya: \"Mengapa engkau seorang diri dan tidak ada orang bersama-sama dengan engkau?\""
 },
 {
   "id": 7777,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 2,
   "firman": "Jawab Daud kepada imam Ahimelekh: \"Raja menugaskan sesuatu kepadaku, katanya kepadaku: Siapapun juga tidak boleh mengetahui sesuatu dari hal yang kusuruh kepadamu dan yang kutugaskan kepadamu ini. Sebab itu orang-orangku telah kusuruh pergi ke suatu tempat."
 },
 {
   "id": 7778,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 3,
   "firman": "Maka sekarang, apa yang ada padamu? Berikanlah kepadaku lima roti atau apapun yang ada.\""
 },
 {
   "id": 7779,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 4,
   "firman": "Lalu jawab imam itu kepada Daud: \"Tidak ada roti biasa padaku, hanya roti kudus yang ada; asal saja orang-orangmu itu menjaga diri terhadap perempuan.\""
 },
 {
   "id": 7780,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 5,
   "firman": "Daud menjawab imam itu, katanya kepadanya: \"Memang, kami tidak diperbolehkan bergaul dengan perempuan, seperti sediakala apabila aku maju berperang. Tubuh orang-orangku itu tahir, sekalipun pada perjalanan biasa, apalagi pada hari ini, masing-masing mereka tahir tubuhnya.\""
 },
 {
   "id": 7781,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 6,
   "firman": "Lalu imam itu memberikan kepadanya roti kudus itu, karena tidak ada roti di sana kecuali roti sajian; roti itu biasa diangkat orang dari hadapan TUHAN, supaya pada hari roti itu diambil, ditaruh lagi roti baru."
 },
 {
   "id": 7782,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 7,
   "firman": "Maka pada hari itu juga ada di sana salah seorang pegawai Saul, yang dikhususkan melayani TUHAN; namanya Doeg, seorang Edom, pengawas atas gembala-gembala Saul."
 },
 {
   "id": 7783,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 8,
   "firman": "Berkatalah Daud kepada Ahimelekh: \"Tidak adakah padamu di sini tombak atau pedang? Sebab baik pedangku maupun senjataku, tidak dapat kubawa, karena perintah raja itu mendesak.\""
 },
 {
   "id": 7784,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 9,
   "firman": "Kemudian berkatalah imam itu: \"Pedang Goliat, orang Filistin, yang kaupukul kalah di Lembah Tarbantin, itulah yang ada di sini, terbungkus dalam kain di belakang efod itu. Jika engkau hendak mengambilnya, ambillah; yang lain tidak ada, hanya ini.\" Kata Daud: \"Tidak ada yang seperti itu; berikanlah itu kepadaku.\""
 },
 {
   "id": 7785,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 10,
   "firman": "Kemudian bersiaplah Daud dan larilah ia pada hari itu juga dari Saul; sampailah ia kepada Akhis, raja kota Gat."
 },
 {
   "id": 7786,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 11,
   "firman": "Pegawai-pegawai Akhis berkata kepada tuannya: \"Bukankah ini Daud raja negeri itu? Bukankah tentang dia orang-orang menyanyi berbalas-balasan sambil menari-nari, demikian: Saul mengalahkan beribu-ribu musuh, tetapi Daud berlaksa-laksa?\""
 },
 {
   "id": 7787,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 12,
   "firman": "Daud memperhatikan perkataan itu, dan dia menjadi takut sekali kepada Akhis, raja kota Gat itu."
 },
 {
   "id": 7788,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 13,
   "firman": "Sebab itu ia berlaku seperti orang yang sakit ingatan di depan mata mereka dan berbuat pura-pura gila di dekat mereka; ia menggores-gores pintu gerbang dan membiarkan ludahnya meleleh ke janggutnya."
 },
 {
   "id": 7789,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 14,
   "firman": "Lalu berkatalah Akhis kepada para pegawainya: \"Tidakkah kamu lihat, bahwa orang itu gila? Mengapa kamu membawa dia kepadaku?"
 },
 {
   "id": 7790,
   "kitab": "1Sa",
   "pasal": 21,
   "ayat": 15,
   "firman": "Kekurangan orang gilakah aku, maka kamu bawa orang ini kepadaku supaya ia menunjukkan gilanya dekat aku? Patutkah orang yang demikian masuk ke rumahku?\""
 },
 {
   "id": 7791,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu Daud pergi dari sana dan melarikan diri ke gua Adulam. Ketika saudara-saudaranya dan seluruh keluarganya mendengar hal itu, pergilah mereka ke sana mendapatkan dia."
 },
 {
   "id": 7792,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 2,
   "firman": "Berhimpunlah juga kepadanya setiap orang yang dalam kesukaran, setiap orang yang dikejar-kejar tukang piutang, setiap orang yang sakit hati, maka ia menjadi pemimpin mereka. Bersama-sama dengan dia ada kira-kira empat ratus orang."
 },
 {
   "id": 7793,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 3,
   "firman": "Dari sana Daud pergi ke Mizpa di Moab dan berkata kepada raja negeri Moab: \"Izinkanlah ayahku dan ibuku tinggal padamu, sampai aku tahu, apa yang dilakukan Allah kepadaku.\""
 },
 {
   "id": 7794,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 4,
   "firman": "Lalu diantarkannyalah mereka kepada raja negeri Moab, dan mereka tinggal bersama dia selama Daud ada di kubu gunung."
 },
 {
   "id": 7795,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 5,
   "firman": "Tetapi Gad, nabi itu, berkata kepada Daud: \"Janganlah tinggal di kubu gunung itu, pergilah dan pulanglah ke tanah Yehuda.\" Lalu pergilah Daud dan masuk ke hutan Keret."
 },
 {
   "id": 7796,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 6,
   "firman": "Hal itu terdengar oleh Saul, sebab Daud dan orang-orang yang bersama-sama dengan dia telah diketahui tempatnya. Adapun Saul ada di Gibea, sedang duduk di bawah pohon tamariska di bukit, dengan tombaknya di tangan dan semua pegawainya berdiri di dekatnya."
 },
 {
   "id": 7797,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 7,
   "firman": "Lalu berkatalah Saul kepada para pegawainya yang berdiri di dekatnya: \"Cobalah dengar, ya orang-orang Benyamin! Apakah anak Isai itu juga akan memberikan kepada kamu sekalian ladang dan kebun anggur, apakah ia akan mengangkat kamu sekalian menjadi kepala atas pasukan seribu dan atas pasukan seratus,"
 },
 {
   "id": 7798,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 8,
   "firman": "sehingga kamu sekalian mengadakan persepakatan melawan aku dan tidak ada seorangpun yang menyatakan kepadaku, bahwa anakku mengikat diri dengan anak Isai itu? Tidak ada seorangpun dari kamu yang cemas karena aku, atau yang menyatakan kepadaku, bahwa anakku telah menghasut pegawaiku melawan aku menjadi penghadang seperti sekarang ini.\""
 },
 {
   "id": 7799,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 9,
   "firman": "Lalu menjawablah Doeg, orang Edom itu, yang berdiri dekat para pegawai Saul, katanya: \"Telah kulihat, bahwa anak Isai itu datang ke Nob, kepada Ahimelekh bin Ahitub."
 },
 {
   "id": 7800,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 10,
   "firman": "Ia menanyakan TUHAN bagi Daud dan memberikan bekal kepadanya; juga pedang Goliat, orang Filistin itu, diberikannya kepadanya.\""
 },
 {
   "id": 7801,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 11,
   "firman": "Lalu raja menyuruh memanggil Ahimelekh bin Ahitub, imam itu, bersama-sama dengan seluruh keluarganya, para imam yang di Nob; dan datanglah sekaliannya menghadap raja."
 },
 {
   "id": 7802,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 12,
   "firman": "Kata Saul: \"Cobalah dengar, ya anak Ahitub!\" Jawabnya: \"Ya, tuanku.\""
 },
 {
   "id": 7803,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 13,
   "firman": "Kemudian bertanyalah Saul kepadanya: \"Mengapa kamu mengadakan persepakatan melawan aku, engkau dengan anak Isai itu, dengan memberikan roti dan pedang kepadanya, menanyakan Allah baginya, sehingga ia bangkit melawan aku menjadi penghadang seperti sekarang ini?\""
 },
 {
   "id": 7804,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 14,
   "firman": "Lalu Ahimelekh menjawab raja: \"Tetapi siapakah di antara segala pegawaimu yang dapat dipercaya seperti Daud, apalagi ia menantu raja dan kepala para pengawalmu, dan dihormati dalam rumahmu?"
 },
 {
   "id": 7805,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 15,
   "firman": "Bukan ini pertama kali aku menanyakan Allah bagi dia. Sekali-kali tidak! Janganlah kiranya raja melontarkan tuduhan kepada hambamu ini, bahkan kepada seluruh keluargaku, sebab hambamu ini tidak tahu apa-apa tentang semuanya itu, baik tentang perkara kecil maupun perkara besar.\""
 },
 {
   "id": 7806,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 16,
   "firman": "Tetapi raja berkata: \"Engkau mesti dibunuh, Ahimelekh, engkau dan seluruh keluargamu.\""
 },
 {
   "id": 7807,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 17,
   "firman": "Lalu raja memerintahkan kepada bentara yang berdiri di dekatnya: \"Majulah dan bunuhlah para imam TUHAN itu sebab mereka membantu Daud; sebab walaupun mereka tahu, bahwa ia melarikan diri, mereka tidak memberitahukan hal itu kepadaku.\" Tetapi para pegawai raja tidak mau mengangkat tangannya untuk memarang imam-imam TUHAN itu."
 },
 {
   "id": 7808,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 18,
   "firman": "Lalu berkatalah raja kepada Doeg: \"Majulah engkau dan paranglah para imam itu.\" Maka majulah Doeg, orang Edom itu, lalu memarang para imam itu. Ia membunuh pada hari itu delapan puluh lima orang, yang memakai baju efod dari kain lenan."
 },
 {
   "id": 7809,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 19,
   "firman": "Juga penduduk Nob, kota imam itu, dibunuh raja dengan mata pedang; laki-laki maupun perempuan, kanak-kanak maupun anak yang menyusu, pula lembu, keledai dan domba dibunuhnya dengan mata pedang."
 },
 {
   "id": 7810,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 20,
   "firman": "Tetapi seorang anak Ahimelekh bin Ahitub, namanya Abyatar luput; ia melarikan diri menjadi pengikut Daud."
 },
 {
   "id": 7811,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 21,
   "firman": "Ketika Abyatar memberitahukan kepada Daud, bahwa Saul telah membunuh para imam TUHAN,"
 },
 {
   "id": 7812,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 22,
   "firman": "berkatalah Daud kepada Abyatar: \"Memang pada hari itu juga ketika Doeg, orang Edom itu, ada di sana, aku telah tahu, bahwa pasti ia akan memberitahukannya kepada Saul. Akulah sebab utama dari pada kematian seluruh keluargamu."
 },
 {
   "id": 7813,
   "kitab": "1Sa",
   "pasal": 22,
   "ayat": 23,
   "firman": "Tinggallah padaku, janganlah takut; sebab siapa yang ingin mencabut nyawamu, ia juga ingin mencabut nyawaku; di dekatku engkau aman.\""
 },
 {
   "id": 7814,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 1,
   "firman": "Diberitahukanlah kepada Daud, begini: \"Ketahuilah, orang Filistin berperang melawan kota Kehila dan menjarah tempat-tempat pengirikan.\""
 },
 {
   "id": 7815,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 2,
   "firman": "Lalu bertanyalah Daud kepada TUHAN: \"Apakah aku akan pergi mengalahkan orang Filistin itu?\" Jawab TUHAN kepada Daud: \"Pergilah, kalahkanlah orang Filistin itu dan selamatkanlah Kehila.\""
 },
 {
   "id": 7816,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 3,
   "firman": "Tetapi orang-orang Daud berkata kepadanya: \"Ingatlah, sedangkan di sini di Yehuda kita sudah dalam ketakutan, apalagi kalau kita pergi ke Kehila, melawan barisan perang orang Filistin.\""
 },
 {
   "id": 7817,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 4,
   "firman": "Lalu bertanya pulalah Daud kepada TUHAN, maka TUHAN menjawab dia, firman-Nya: \"Bersiaplah, pergilah ke Kehila, sebab Aku akan menyerahkan orang Filistin itu ke dalam tanganmu.\""
 },
 {
   "id": 7818,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 5,
   "firman": "Kemudian pergilah Daud dengan orang-orangnya ke Kehila; ia berperang melawan orang Filistin itu, dihalaunya ternak mereka dan ditimbulkannya kekalahan besar di antara mereka. Demikianlah Daud menyelamatkan penduduk Kehila."
 },
 {
   "id": 7819,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 6,
   "firman": "Ketika Abyatar bin Ahimelekh melarikan diri kepada Daud ke Kehila, ia turun dengan membawa efod di tangannya."
 },
 {
   "id": 7820,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 7,
   "firman": "Kepada Saul diberitahukan, bahwa Daud telah masuk Kehila. Lalu berkatalah Saul: \"Allah telah menyerahkan dia ke dalam tanganku, sebab dengan masuk ke dalam kota yang berpintu dan berpalang ia telah mengurung dirinya.\""
 },
 {
   "id": 7821,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 8,
   "firman": "Maka Saul memanggil seluruh rakyat pergi berperang ke Kehila dan mengepung Daud dengan orang-orangnya."
 },
 {
   "id": 7822,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 9,
   "firman": "Ketika diketahui Daud, bahwa Saul berniat jahat terhadap dia, berkatalah ia kepada imam Abyatar: \"Bawalah efod itu ke mari.\""
 },
 {
   "id": 7823,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 10,
   "firman": "Berkatalah Daud: \"TUHAN, Allah Israel, hamba-Mu ini telah mendengar kabar pasti, bahwa Saul berikhtiar untuk datang ke Kehila dan memusnahkan kota ini oleh karena aku."
 },
 {
   "id": 7824,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 11,
   "firman": "Akan diserahkan oleh warga-warga kota Kehila itukah aku ke dalam tangannya? Akan datangkah Saul seperti yang telah didengar oleh hamba-Mu ini? TUHAN, Allah Israel, beritahukanlah kiranya kepada hamba-Mu ini.\" Jawab TUHAN: \"Ia akan datang.\""
 },
 {
   "id": 7825,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 12,
   "firman": "Kemudian bertanyalah Daud: \"Akan diserahkan oleh warga-warga kota Kehila itukah aku dengan orang-orangku ke dalam tangan Saul?\" Firman TUHAN: \"Akan mereka serahkan.\""
 },
 {
   "id": 7826,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 13,
   "firman": "Lalu bersiaplah Daud dan orang-orangnya, kira-kira enam ratus orang banyaknya, mereka keluar dari Kehila dan pergi ke mana saja mereka dapat pergi. Apabila kepada Saul diberitahukan, bahwa Daud telah meluputkan diri dari Kehila, maka tidak jadilah ia maju berperang."
 },
 {
   "id": 7827,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 14,
   "firman": "Maka Daud tinggal di padang gurun, di tempat-tempat perlindungan. Ia tinggal di pegunungan, di padang gurun Zif. Dan selama waktu itu Saul mencari dia, tetapi Allah tidak menyerahkan dia ke dalam tangannya."
 },
 {
   "id": 7828,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 15,
   "firman": "Daud takut, karena Saul telah keluar dengan maksud mencabut nyawanya. Ketika Daud ada di padang gurun Zif di Koresa,"
 },
 {
   "id": 7829,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 16,
   "firman": "maka bersiaplah Yonatan, anak Saul, lalu pergi kepada Daud di Koresa. Ia menguatkan kepercayaan Daud kepada Allah"
 },
 {
   "id": 7830,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 17,
   "firman": "dan berkata kepadanya: \"Janganlah takut, sebab tangan ayahku Saul tidak akan menangkap engkau; engkau akan menjadi raja atas Israel, dan aku akan menjadi orang kedua di bawahmu. Juga ayahku Saul telah mengetahui yang demikian itu.\""
 },
 {
   "id": 7831,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 18,
   "firman": "Kemudian kedua orang itu mengikat perjanjian di hadapan TUHAN. Dan Daud tinggal di Koresa, tetapi Yonatan pulang ke rumahnya."
 },
 {
   "id": 7832,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 19,
   "firman": "Tetapi beberapa orang Zif pergi menghadap Saul di Gibea dan berkata: \"Daud menyembunyikan diri dekat kami di kubu-kubu gunung dekat Koresa, di bukit Hakhila, di sebelah selatan padang belantara."
 },
 {
   "id": 7833,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 20,
   "firman": "Oleh sebab itu, jika tuanku raja berkenan datang, silakanlah datang; tanggungan kamilah untuk menyerahkan dia ke dalam tangan raja.\""
 },
 {
   "id": 7834,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 21,
   "firman": "Berkatalah Saul: \"Diberkatilah kiranya kamu oleh TUHAN, karena kamu menunjukkan sayangmu kepadaku."
 },
 {
   "id": 7835,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 22,
   "firman": "Baiklah pergi, carilah kepastian lagi, berusahalah mengetahui di mana ia berada dan siapa yang telah melihat dia di sana; sebab telah dikatakan orang kepadaku, bahwa ia sangat cerdik."
 },
 {
   "id": 7836,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 23,
   "firman": "Berusahalah mengetahui segala tempat persembunyiannya. Kemudian datanglah kembali kepadaku dengan kabar yang pasti; dan aku akan pergi bersama-sama dengan kamu. Sesungguhnya, jika ia ada di dalam negeri, maka aku akan meneliti dia di antara segala ribuan orang Yehuda.\""
 },
 {
   "id": 7837,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 24,
   "firman": "Lalu berkemaslah mereka pergi ke Zif, mendahului Saul. Daud dan orang-orangnya ada di padang gurun Maon, di dataran di sebelah selatan padang belantara."
 },
 {
   "id": 7838,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 25,
   "firman": "Ketika Saul dengan orang-orangnya pergi mencari Daud, diberitahukanlah hal itu kepada Daud, lalu pergilah ia ke gunung batu dan tinggal di padang gurun Maon. Saul mendengar hal itu, lalu mengejar Daud di padang gurun Maon;"
 },
 {
   "id": 7839,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 26,
   "firman": "Saul berjalan dari sisi gunung sebelah sini dan Daud dengan orang-orangnya dari sisi gunung sebelah sana. Daud cepat-cepat mengelakkan Saul; tetapi Saul dengan orang-orangnya sudah hampir mengepung Daud serta orang-orangnya untuk menangkap mereka,"
 },
 {
   "id": 7840,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 27,
   "firman": "ketika seorang suruhan datang kepada Saul dengan pesan: \"Segeralah undur, sebab orang Filistin telah menyerbu negeri.\""
 },
 {
   "id": 7841,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 28,
   "firman": "Maka berhentilah Saul mengejar Daud dan pergi menghadapi orang Filistin. Itulah sebabnya orang menyebut tempat itu: Gunung Batu Keluputan."
 },
 {
   "id": 7842,
   "kitab": "1Sa",
   "pasal": 23,
   "ayat": 29,
   "firman": "(24-1) Daud pergi dari sana, lalu tinggal di kubu-kubu gunung di En-Gedi."
 },
 {
   "id": 7843,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 1,
   "firman": "(24-2) Ketika Saul pulang sesudah memburu orang Filistin itu, diberitahukanlah kepadanya, demikian: \"Ketahuilah, Daud ada di padang gurun En-Gedi.\""
 },
 {
   "id": 7844,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 2,
   "firman": "(24-3) Kemudian Saul mengambil tiga ribu orang yang terpilih dari seluruh orang Israel, lalu pergi mencari Daud dan orang-orangnya di gunung batu Kambing Hutan."
 },
 {
   "id": 7845,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 3,
   "firman": "(24-4) Ia sampai ke kandang-kandang domba di tepi jalan. Di sana ada gua dan Saul masuk ke dalamnya untuk membuang hajat, tetapi Daud dan orang-orangnya duduk di bagian belakang gua itu."
 },
 {
   "id": 7846,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 4,
   "firman": "(24-5) Lalu berkatalah orang-orangnya kepada Daud: \"Telah tiba hari yang dikatakan TUHAN kepadamu: Sesungguhnya, Aku menyerahkan musuhmu ke dalam tanganmu, maka perbuatlah kepadanya apa yang kaupandang baik.\" Maka Daud bangun, lalu memotong punca jubah Saul dengan diam-diam."
 },
 {
   "id": 7847,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 5,
   "firman": "(24-6) Kemudian berdebar-debarlah hati Daud, karena ia telah memotong punca Saul;"
 },
 {
   "id": 7848,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 6,
   "firman": "(24-7) lalu berkatalah ia kepada orang-orangnya: \"Dijauhkan Tuhanlah kiranya dari padaku untuk melakukan hal yang demikian kepada tuanku, kepada orang yang diurapi TUHAN, yakni menjamah dia, sebab dialah orang yang diurapi TUHAN.\""
 },
 {
   "id": 7849,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 7,
   "firman": "(24-8) Dan Daud mencegah orang-orangnya dengan perkataan itu; ia tidak mengizinkan mereka bangkit menyerang Saul. Sementara itu Saul telah bangun meninggalkan gua itu hendak melanjutkan perjalanannya."
 },
 {
   "id": 7850,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 8,
   "firman": "(24-9) Kemudian bangunlah Daud, ia keluar dari dalam gua itu dan berseru kepada Saul dari belakang, katanya: \"Tuanku raja!\" Saul menoleh ke belakang, lalu Daud berlutut dengan mukanya ke tanah dan sujud menyembah."
 },
 {
   "id": 7851,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 9,
   "firman": "(24-10) Lalu berkatalah Daud kepada Saul: \"Mengapa engkau mendengarkan perkataan orang-orang yang mengatakan: Sesungguhnya Daud mengikhtiarkan celakamu?"
 },
 {
   "id": 7852,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 10,
   "firman": "(24-11) Ketahuilah, pada hari ini matamu sendiri melihat, bahwa TUHAN sekarang menyerahkan engkau ke dalam tanganku dalam gua itu; ada orang yang telah menyuruh aku membunuh engkau, tetapi aku merasa sayang kepadamu karena pikirku: Aku tidak akan menjamah tuanku itu, sebab dialah orang yang diurapi TUHAN."
 },
 {
   "id": 7853,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 11,
   "firman": "(24-12) Lihatlah dahulu, ayahku, lihatlah kiranya punca jubahmu dalam tanganku ini! Sebab dari kenyataan bahwa aku memotong punca jubahmu dengan tidak membunuh engkau, dapatlah kauketahui dan kaulihat, bahwa tanganku bersih dari pada kejahatan dan pengkhianatan, dan bahwa aku tidak berbuat dosa terhadap engkau, walaupun engkau ini mengejar-ngejar aku untuk mencabut nyawaku."
 },
 {
   "id": 7854,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 12,
   "firman": "(24-13) TUHAN kiranya menjadi hakim di antara aku dan engkau, TUHAN kiranya membalaskan aku kepadamu, tetapi tanganku tidak akan memukul engkau;"
 },
 {
   "id": 7855,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 13,
   "firman": "(24-14) seperti peribahasa orang tua-tua mengatakan: Dari orang fasik timbul kefasikan. Tetapi tanganku tidak akan memukul engkau."
 },
 {
   "id": 7856,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 14,
   "firman": "(24-15) Terhadap siapakah raja Israel keluar berperang? Siapakah yang kaukejar? Anjing mati! Seekor kutu saja!"
 },
 {
   "id": 7857,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 15,
   "firman": "(24-16) Sebab itu TUHAN kiranya menjadi hakim yang memutuskan antara aku dan engkau; Dia kiranya memperhatikannya, memperjuangkan perkaraku dan memberi keadilan kepadaku dengan melepaskan aku dari tanganmu.\""
 },
 {
   "id": 7858,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 16,
   "firman": "(24-17) Setelah Daud selesai menyampaikan perkataan itu kepada Saul, berkatalah Saul: \"Suaramukah itu, ya anakku Daud?\" Sesudah itu dengan suara nyaring menangislah Saul."
 },
 {
   "id": 7859,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 17,
   "firman": "(24-18) Katanya kepada Daud: \"Engkau lebih benar dari pada aku, sebab engkau telah melakukan yang baik kepadaku, padahal aku melakukan yang jahat kepadamu."
 },
 {
   "id": 7860,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 18,
   "firman": "(24-19) Telah kautunjukkan pada hari ini, betapa engkau telah melakukan yang baik kepadaku: walaupun TUHAN telah menyerahkan aku ke dalam tanganmu, engkau tidak membunuh aku."
 },
 {
   "id": 7861,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 19,
   "firman": "(24-20) Apabila seseorang mendapat musuhnya, masakan dilepaskannya dia berjalan dengan selamat? TUHAN kiranya membalaskan kepadamu kebaikan ganti apa yang kaulakukan kepadaku pada hari ini."
 },
 {
   "id": 7862,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 20,
   "firman": "(24-21) Oleh karena itu, sesungguhnya aku tahu, bahwa engkau pasti menjadi raja dan jabatan raja Israel akan tetap kokoh dalam tanganmu."
 },
 {
   "id": 7863,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 21,
   "firman": "(24-22) Oleh sebab itu, bersumpahlah kepadaku demi TUHAN, bahwa engkau tidak akan melenyapkan keturunanku dan tidak akan menghapuskan namaku dari kaum keluargaku.\""
 },
 {
   "id": 7864,
   "kitab": "1Sa",
   "pasal": 24,
   "ayat": 22,
   "firman": "(24-23) Lalu bersumpahlah Daud kepada Saul. Kemudian pulanglah Saul ke rumahnya, sedang Daud dan orang-orangnya pergi ke kubu gunung."
 },
 {
   "id": 7865,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 1,
   "firman": "Dan matilah Samuel; seluruh orang Israel berkumpul meratapi dia dan menguburkan dia di rumahnya di Rama. Dan Daud berkemas, lalu pergi ke padang gurun Paran."
 },
 {
   "id": 7866,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 2,
   "firman": "Ketika itu ada seorang laki-laki di Maon, yang mempunyai perusahaan di Karmel. Orang itu sangat kaya: ia mempunyai tiga ribu ekor domba dan seribu ekor kambing. Ia ada di Karmel pada pengguntingan bulu domba-dombanya."
 },
 {
   "id": 7867,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 3,
   "firman": "Nama orang itu Nabal dan nama isterinya Abigail. Perempuan itu bijak dan cantik, tetapi laki-laki itu kasar dan jahat kelakuannya. Ia seorang keturunan Kaleb."
 },
 {
   "id": 7868,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 4,
   "firman": "Ketika didengar Daud di padang gurun, bahwa Nabal sedang menggunting bulu domba-dombanya,"
 },
 {
   "id": 7869,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 5,
   "firman": "maka Daud menyuruh sepuluh orang dan kepada orang-orang itu Daud berkata: \"Pergilah ke Karmel dan temuilah Nabal. Tanyakanlah keselamatannya atas namaku"
 },
 {
   "id": 7870,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 6,
   "firman": "dan sampaikanlah salam ini kepadanya: Selamat! Selamatlah engkau, selamatlah keluargamu, selamatlah segala yang ada padamu."
 },
 {
   "id": 7871,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 7,
   "firman": "Baru-baru ini aku mendengar bahwa engkau mengadakan pengguntingan bulu domba. Adapun gembala-gembalamu yang ada dengan kami, tidak kami ganggu dan tidak ada sesuatu yang hilang dari pada mereka selama mereka ada di Karmel."
 },
 {
   "id": 7872,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 8,
   "firman": "Tanyakanlah kepada orang-orangmu, mereka tentu akan memberitahukan kepadamu. Sebab itu biarlah orang-orang ini mendapat belas kasihanmu; bukankah kami ini datang pada hari raya? Berikanlah kepada hamba-hambamu ini dan kepada anakmu Daud apa yang ada padamu.\""
 },
 {
   "id": 7873,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 9,
   "firman": "Ketika orang-orang Daud sampai ke sana, berkatalah mereka kepada Nabal atas nama Daud tepat seperti yang dikatakan kepada mereka, kemudian mereka menanti."
 },
 {
   "id": 7874,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 10,
   "firman": "Tetapi Nabal menjawab anak buah Daud itu, katanya: \"Siapakah Daud? Siapakah anak Isai itu? Pada waktu sekarang ini ada banyak hamba-hamba yang lari dari tuannya."
 },
 {
   "id": 7875,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 11,
   "firman": "Masakan aku mengambil rotiku, air minumku dan hewan bantaian yang kubantai bagi orang-orang pengguntingku untuk memberikannya kepada orang-orang yang aku tidak tahu dari mana mereka datang?\""
 },
 {
   "id": 7876,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 12,
   "firman": "Lalu orang-orang Daud itu berbalik pulang dan setelah sampai, mereka memberitahukan kepadanya tepat seperti yang dikatakan kepada mereka."
 },
 {
   "id": 7877,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 13,
   "firman": "Kemudian berkatalah Daud kepada orang-orangnya: \"Kamu masing-masing, sandanglah pedang!\" Lalu mereka masing-masing menyandang pedangnya; Daud sendiripun menyandang pedangnya. Sesudah itu kira-kira empat ratus orang maju mengikuti Daud, sedang dua ratus orang tinggal menjaga barang-barang."
 },
 {
   "id": 7878,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 14,
   "firman": "Tetapi kepada Abigail, isteri Nabal, telah diberitahukan oleh salah seorang bujangnya, katanya: \"Ketahuilah, Daud menyuruh orang dari padang gurun untuk memberi salam kepada tuan kita, tetapi ia memaki-maki mereka."
 },
 {
   "id": 7879,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 15,
   "firman": "Padahal orang-orang itu sangat baik kepada kami; mereka tidak mengganggu kami dan kami tidak kehilangan apa-apa selama kami lalu-lalang di dekat mereka, ketika kami ada di ladang."
 },
 {
   "id": 7880,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 16,
   "firman": "Mereka seperti pagar tembok sekeliling kami siang malam, selama kami menggembalakan domba-domba di dekat mereka."
 },
 {
   "id": 7881,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 17,
   "firman": "Oleh sebab itu, pikirkanlah dan pertimbangkanlah apa yang harus kauperbuat, sebab telah diputuskan bahwa celaka akan didatangkan kepada tuan kita dan kepada seisi rumahnya, dan ia seorang yang dursila, sehingga orang tidak dapat berbicara dengan dia.\""
 },
 {
   "id": 7882,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 18,
   "firman": "Lalu segeralah Abigail mengambil dua ratus roti, dua buyung anggur, lima domba yang telah diolah, lima sukat bertih gandum, seratus buah kue kismis dan dua ratus kue ara, dimuatnyalah semuanya ke atas keledai,"
 },
 {
   "id": 7883,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 19,
   "firman": "lalu berkata kepada bujang-bujangnya: \"Berjalanlah mendahului aku; aku segera menyusul kamu.\" Tetapi Nabal, suaminya, tidaklah diberitahunya."
 },
 {
   "id": 7884,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 20,
   "firman": "Ketika perempuan itu dengan menunggang keledainya, turun dengan terlindung oleh gunung, tampaklah Daud dan orang-orangnya turun ke arahnya, dan perempuan itu bertemu dengan mereka."
 },
 {
   "id": 7885,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 21,
   "firman": "Daud tadinya telah berkata: \"Sia-sialah aku melindungi segala kepunyaan orang ini di padang gurun, sehingga tidak ada sesuatupun yang hilang dari segala kepunyaannya; ia membalas kebaikanku dengan kejahatan."
 },
 {
   "id": 7886,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 22,
   "firman": "Beginilah kiranya Allah menghukum Daud, bahkan lebih lagi dari pada itu, jika kutinggalkan hidup sampai pagi seorang laki-laki sajapun dari semua yang ada padanya.\""
 },
 {
   "id": 7887,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 23,
   "firman": "Ketika Abigail melihat Daud, segeralah ia turun dari atas keledainya, lalu sujud menyembah di depan Daud dengan mukanya sampai ke tanah."
 },
 {
   "id": 7888,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 24,
   "firman": "Ia sujud pada kaki Daud serta berkata: \"Aku sajalah, ya tuanku, yang menanggung kesalahan itu. Izinkanlah hambamu ini berbicara kepadamu, dan dengarkanlah perkataan hambamu ini."
 },
 {
   "id": 7889,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 25,
   "firman": "Janganlah kiranya tuanku mengindahkan Nabal, orang yang dursila itu, sebab seperti namanya demikianlah ia: Nabal namanya dan bebal orangnya. Tetapi aku, hambamu ini, tidak melihat orang-orang yang tuanku suruh."
 },
 {
   "id": 7890,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 26,
   "firman": "Oleh sebab itu, tuanku, demi TUHAN yang hidup dan demi hidupmu yang dicegah TUHAN dari pada melakukan hutang darah dan dari pada bertindak sendiri dalam mencari keadilan, biarlah menjadi sama seperti Nabal musuhmu dan orang yang bermaksud jahat terhadap tuanku!"
 },
 {
   "id": 7891,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 27,
   "firman": "Oleh sebab itu, pemberian yang dibawa kepada tuanku oleh budakmu ini, biarlah diberikan kepada orang-orang yang mengikuti tuanku."
 },
 {
   "id": 7892,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 28,
   "firman": "Ampunilah kiranya kecerobohan hambamu ini, sebab pastilah TUHAN akan membangun bagi tuanku keturunan yang teguh, karena tuanku ini melakukan perang TUHAN dan tidak ada yang jahat terdapat padamu selama hidupmu."
 },
 {
   "id": 7893,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 29,
   "firman": "Jika sekiranya ada seorang bangkit mengejar engkau dan ingin mencabut nyawamu, maka nyawa tuanku akan terbungkus dalam bungkusan tempat orang-orang hidup pada TUHAN, Allahmu, tetapi nyawa para musuhmu akan diumbankan-Nya dari dalam salang umban."
 },
 {
   "id": 7894,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 30,
   "firman": "Apabila TUHAN melakukan kepada tuanku sesuai dengan segala kebaikan yang difirmankan-Nya kepadamu dan menunjuk engkau menjadi raja atas Israel,"
 },
 {
   "id": 7895,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 31,
   "firman": "maka tak usahlah tuanku bersusah hati dan menyesal karena menumpahkan darah tanpa alasan, dan karena tuanku bertindak sendiri dalam mencari keadilan. Dan apabila TUHAN berbuat baik kepada tuanku, ingatlah kepada hambamu ini.\""
 },
 {
   "id": 7896,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 32,
   "firman": "Lalu berkatalah Daud kepada Abigail: \"Terpujilah TUHAN, Allah Israel, yang mengutus engkau menemui aku pada hari ini;"
 },
 {
   "id": 7897,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 33,
   "firman": "terpujilah kebijakanmu dan terpujilah engkau sendiri, bahwa engkau pada hari ini menahan aku dari pada melakukan hutang darah dan dari pada bertindak sendiri dalam mencari keadilan."
 },
 {
   "id": 7898,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 34,
   "firman": "Tetapi demi TUHAN, Allah Israel yang hidup, yang mencegah aku dari pada berbuat jahat kepadamu--jika engkau tadinya tidak segera datang menemui aku, pasti tidak akan ada seorang laki-lakipun tinggal hidup pada Nabal sampai fajar menyingsing.\""
 },
 {
   "id": 7899,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 35,
   "firman": "Lalu Daud menerima dari perempuan itu apa yang dibawanya untuk dia, dan berkata kepadanya: \"Pulanglah dengan selamat ke rumahmu; lihatlah, aku mendengarkan perkataanmu dan menerima permintaanmu dengan baik.\""
 },
 {
   "id": 7900,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 36,
   "firman": "Sampailah Abigail kepada Nabal dan tampaklah, Nabal mengadakan perjamuan di rumahnya, seperti perjamuan raja-raja. Nabal riang gembira dan mabuk sekali. Sebab itu tidaklah diceriterakan perempuan itu sepatah katapun kepadanya, sampai fajar menyingsing."
 },
 {
   "id": 7901,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 37,
   "firman": "Tetapi pada waktu pagi, ketika sudah hilang mabuk Nabal itu, diceriterakanlah kepadanya oleh isterinya segala perkara itu. Lalu terhentilah jantungnya dalam dada dan ia membatu."
 },
 {
   "id": 7902,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 38,
   "firman": "Dan kira-kira sepuluh hari sesudah itu TUHAN memukul Nabal, sehingga ia mati."
 },
 {
   "id": 7903,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 39,
   "firman": "Ketika didengar Daud, bahwa Nabal telah mati, berkatalah ia: \"Terpujilah TUHAN, yang membela aku dalam perkara penghinaan Nabal terhadap aku dan yang mencegah hamba-Nya dari pada berbuat jahat. TUHAN telah membalikkan kejahatan Nabal ke atas kepalanya sendiri.\" Kemudian Daud menyuruh orang untuk berbicara dengan Abigail tentang mengambil dia menjadi isterinya."
 },
 {
   "id": 7904,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 40,
   "firman": "Para hamba Daud datang kepada Abigail di Karmel dan berkata kepadanya, demikian: \"Daud menyuruh kami kepadamu untuk mengambil engkau menjadi isterinya.\""
 },
 {
   "id": 7905,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 41,
   "firman": "Lalu bangkitlah perempuan itu berdiri, sujudlah ia menyembah dengan mukanya ke tanah sambil berkata: \"Sesungguhnya, hambamu ini ingin menjadi budak yang membasuh kaki para hamba tuanku itu.\""
 },
 {
   "id": 7906,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 42,
   "firman": "Kemudian berkemaslah Abigail dengan segera; ia menunggang keledainya, dengan diiringi lima orang pelayan perempuan. Ia mengikuti suruhan Daud itu dan menjadi isteri Daud."
 },
 {
   "id": 7907,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 43,
   "firman": "Juga Ahinoam dari Yizreel telah diambil Daud menjadi isterinya; kedua perempuan itu menjadi isterinya."
 },
 {
   "id": 7908,
   "kitab": "1Sa",
   "pasal": 25,
   "ayat": 44,
   "firman": "Tetapi Saul telah memberikan Mikhal, anaknya perempuan, isteri Daud, kepada Palti bin Lais, yang dari Galim itu."
 },
 {
   "id": 7909,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 1,
   "firman": "Datanglah orang Zif kepada Saul di Gibea serta berkata: \"Daud menyembunyikan diri di bukit Hakhila di padang belantara.\""
 },
 {
   "id": 7910,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 2,
   "firman": "Lalu berkemaslah Saul dan turun ke padang gurun Zif dengan tiga ribu orang yang terpilih dari orang Israel untuk mencari Daud di padang gurun Zif."
 },
 {
   "id": 7911,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 3,
   "firman": "Berkemahlah Saul di bukit Hakhila yang di tepi jalan di padang belantara, sedang Daud tinggal di padang gurun. Ketika diketahui Daud, bahwa Saul datang mengikuti dia ke padang gurun,"
 },
 {
   "id": 7912,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 4,
   "firman": "disuruhnyalah pengintai-pengintai, maka diketahuinyalah, bahwa Saul benar-benar datang."
 },
 {
   "id": 7913,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 5,
   "firman": "Berkemaslah Daud, lalu sampai ke tempat Saul berkemah. Waktu Daud melihat tempat Saul berbaring dengan Abner bin Ner, panglima tentaranya, --Saul berbaring di tengah-tengah perkemahan, sedang rakyat berkemah sekelilingnya--"
 },
 {
   "id": 7914,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 6,
   "firman": "berbicaralah Daud kepada Ahimelekh, orang Het itu, dan kepada Abisai, anak Zeruya, saudara Yoab, katanya: \"Siapa turun bersama-sama dengan aku kepada Saul ke tempat perkemahan itu?\" Jawab Abisai: \"Aku turun bersama-sama dengan engkau.\""
 },
 {
   "id": 7915,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 7,
   "firman": "Datanglah Daud dengan Abisai kepada rakyat itu pada waktu malam, dan tampaklah di sana Saul berbaring tidur di tengah-tengah perkemahan, dengan tombaknya terpancung di tanah pada sebelah kepalanya, sedang Abner dan rakyat itu berbaring sekelilingnya."
 },
 {
   "id": 7916,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 8,
   "firman": "Lalu berkatalah Abisai kepada Daud: \"Pada hari ini Allah telah menyerahkan musuhmu ke dalam tanganmu, oleh sebab itu izinkanlah kiranya aku menancapkan dia ke tanah dengan tombak ini, dengan satu tikaman saja, tidak usah dia kutancapkan dua kali.\""
 },
 {
   "id": 7917,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 9,
   "firman": "Tetapi kata Daud kepada Abisai: \"Jangan musnahkan dia, sebab siapakah yang dapat menjamah orang yang diurapi TUHAN, dan bebas dari hukuman?\""
 },
 {
   "id": 7918,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 10,
   "firman": "Lagi kata Daud: \"Demi TUHAN yang hidup, niscaya TUHAN akan membunuh dia: entah karena sampai ajalnya dan ia mati, entah karena ia pergi berperang dan hilang lenyap di sana."
 },
 {
   "id": 7919,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 11,
   "firman": "Kiranya TUHAN menjauhkan dari padaku untuk menjamah orang yang diurapi TUHAN. Ambillah sekarang tombak yang ada di sebelah kepalanya dan kendi itu, dan marilah kita pergi.\""
 },
 {
   "id": 7920,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 12,
   "firman": "Kemudian Daud mengambil tombak dan kendi itu dari sebelah kepala Saul, lalu mereka pergi. Tidak ada yang melihatnya, tidak ada yang mengetahuinya, tidak ada yang terbangun, sebab sekaliannya tidur, karena TUHAN membuat mereka tidur nyenyak."
 },
 {
   "id": 7921,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 13,
   "firman": "Setelah Daud sampai ke seberang, berdirilah ia jauh-jauh di puncak gunung, sehingga ada jarak yang besar antara mereka."
 },
 {
   "id": 7922,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 14,
   "firman": "Dan berserulah Daud kepada tentara itu dan kepada Abner bin Ner, katanya: \"Tidakkah engkau menjawab, Abner?\" Maka jawab Abner, katanya: \"Siapakah engkau ini yang berseru-seru kepada raja?\""
 },
 {
   "id": 7923,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 15,
   "firman": "Kemudian berkatalah Daud kepada Abner: \"Apakah engkau ini bukan laki-laki? Siapakah yang seperti engkau di antara orang Israel? Mengapa engkau tidak mengawal tuanmu raja? Sebab ada seorang dari rakyat yang datang untuk memusnahkan raja, tuanmu itu."
 },
 {
   "id": 7924,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 16,
   "firman": "Tidak baik hal yang kauperbuat itu. Demi TUHAN yang hidup, kamu ini harus mati, karena kamu tidak mengawal tuanmu, orang yang diurapi TUHAN itu. Sekarang, lihatlah, di mana tombak raja dan kendi yang ada di sebelah kepalanya?\""
 },
 {
   "id": 7925,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 17,
   "firman": "Saul mengenal suara Daud, lalu ia berkata: \"Suaramukah itu, anakku Daud?\" Jawab Daud: \"Suaraku, tuanku raja.\""
 },
 {
   "id": 7926,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 18,
   "firman": "Lalu berkatalah ia: \"Mengapa pula tuanku mengejar hambanya ini? Apa yang telah kuperbuat? Apakah kejahatan yang melekat pada tanganku?"
 },
 {
   "id": 7927,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 19,
   "firman": "Oleh sebab itu, kiranya tuanku raja mendengarkan perkataan hambanya ini. Jika TUHAN yang membujuk engkau melawan aku, maka biarlah Ia mencium bau korban persembahan; tetapi jika itu anak-anak manusia, terkutuklah mereka di hadapan TUHAN, karena mereka sekarang mengusir aku, sehingga aku tidak mendapat bagian dari pada milik TUHAN, dengan berkata: Pergilah, beribadahlah kepada allah lain."
 },
 {
   "id": 7928,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 20,
   "firman": "Sebab itu, janganlah kiranya darahku tertumpah ke tanah, jauh dari hadapan TUHAN. Sebab raja Israel keluar untuk mencabut nyawaku, seperti orang memburu seekor ayam hutan di gunung-gunung.\""
 },
 {
   "id": 7929,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 21,
   "firman": "Lalu berkatalah Saul: \"Aku telah berbuat dosa, pulanglah, anakku Daud, sebab aku tidak akan berbuat jahat lagi kepadamu, karena nyawaku pada hari ini berharga di matamu. Sesungguhnya, perbuatanku itu bodoh dan aku sesat sama sekali.\""
 },
 {
   "id": 7930,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 22,
   "firman": "Tetapi Daud menjawab: \"Inilah tombak itu, ya tuanku raja! Baiklah salah seorang dari orang-orangmu menyeberang untuk mengambilnya."
 },
 {
   "id": 7931,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 23,
   "firman": "TUHAN akan membalas kebenaran dan kesetiaan setiap orang, sebab TUHAN menyerahkan engkau pada hari ini ke dalam tanganku, tetapi aku tidak mau menjamah orang yang diurapi TUHAN."
 },
 {
   "id": 7932,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 24,
   "firman": "Dan sesungguhnya, seperti nyawamu pada hari ini berharga di mataku, demikianlah hendaknya nyawaku berharga di mata TUHAN, dan hendaknya Ia melepaskan aku dari segala kesusahan.\""
 },
 {
   "id": 7933,
   "kitab": "1Sa",
   "pasal": 26,
   "ayat": 25,
   "firman": "Lalu berkatalah Saul kepada Daud: \"Diberkatilah kiranya engkau, anakku Daud. Apa juapun yang kauperbuat, pastilah engkau sanggup melakukannya.\" Lalu pergilah Daud meneruskan perjalanannya dan pulanglah Saul ke tempatnya."
 },
 {
   "id": 7934,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 1,
   "firman": "Tetapi Daud berpikir dalam hatinya: \"Bagaimanapun juga pada suatu hari aku akan binasa oleh tangan Saul. Jadi tidak ada yang lebih baik bagiku selain meluputkan diri dengan segera ke negeri orang Filistin; maka tidak ada harapan bagi Saul untuk mencari aku lagi di seluruh daerah Israel dan aku akan terluput dari tangannya.\""
 },
 {
   "id": 7935,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 2,
   "firman": "Bersiaplah Daud, lalu berjalan ke sana, ia dan keenam ratus orang yang bersama-sama dengan dia itu, kepada Akhis bin Maokh, raja kota Gat."
 },
 {
   "id": 7936,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 3,
   "firman": "Daud dan semua orangnya menetap pada Akhis di Gat, masing-masing dengan rumah tangganya; Daud dengan kedua orang isterinya, yakni Ahinoam, perempuan Yizreel, dan Abigail, bekas isteri Nabal, perempuan Karmel."
 },
 {
   "id": 7937,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 4,
   "firman": "Setelah diberitahukan kepada Saul, bahwa Daud telah melarikan diri ke Gat, ia tidak lagi mencarinya."
 },
 {
   "id": 7938,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 5,
   "firman": "Berkatalah Daud kepada Akhis: \"Jika kiranya aku mendapat belas kasihanmu, biarlah diberikan kepadaku tempat di salah satu kota di tanah datar, supaya aku tinggal di sana. Mengapa hambamu ini tinggal padamu di kota kerajaan ini?\""
 },
 {
   "id": 7939,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 6,
   "firman": "Maka pada hari itu Akhis memberikan Ziklag kepadanya; itulah sebabnya Ziklag menjadi kepunyaan raja-raja Yehuda sampai sekarang."
 },
 {
   "id": 7940,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 7,
   "firman": "Dan lamanya Daud tinggal di daerah orang Filistin adalah satu tahun empat bulan."
 },
 {
   "id": 7941,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 8,
   "firman": "Maka Daud dan orang-orangnya bergerak maju dan menyerbu orang Gesur, orang Girzi dan orang Amalek; sebab orang-orang inilah penduduk negeri itu yang membentang dari Telam ke arah Syur sampai tanah Mesir."
 },
 {
   "id": 7942,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 9,
   "firman": "Apabila Daud memusnahkan negeri itu, seorangpun tidak dibiarkannya hidup, baik laki-laki maupun perempuan; ia merampas kambing domba, lembu, keledai, unta dan pakaian, kemudian pulanglah ia dan kembali kepada Akhis."
 },
 {
   "id": 7943,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 10,
   "firman": "Jika Akhis bertanya: \"Di mana kamu menyerbu pada hari ini?\" maka jawab Daud: \"Di Tanah Negeb Yehuda,\" atau: \"Di Tanah Negeb orang Yerahmeel,\" atau: \"Di Tanah Negeb orang Keni.\""
 },
 {
   "id": 7944,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 11,
   "firman": "Daud tidak membiarkan hidup seorangpun, baik laki-laki maupun perempuan, untuk dibawa ke Gat, sebab pikirnya: \"Jangan-jangan mereka mengabarkan tentang kami, dengan berkata: Beginilah dilakukan Daud.\" Itulah kebiasaannya, selama ia tinggal di daerah orang Filistin."
 },
 {
   "id": 7945,
   "kitab": "1Sa",
   "pasal": 27,
   "ayat": 12,
   "firman": "Tetapi Akhis mempercayai Daud, sebab pikirnya: \"Tentulah ia telah membuat diri dibenci di antara orang Israel, bangsanya; ia akan menjadi hambaku sampai selamanya.\""
 },
 {
   "id": 7946,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 1,
   "firman": "Pada waktu itu orang Filistin mengerahkan tentaranya untuk berperang melawan orang Israel. Lalu berkatalah Akhis kepada Daud: \"Ketahuilah baik-baik, bahwa engkau beserta orang-orangmu harus maju berperang bersama-sama dengan aku dalam tentara.\""
 },
 {
   "id": 7947,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 2,
   "firman": "Jawab Daud kepada Akhis: \"Baik, engkau akan tahu, apa yang dapat diperbuat hambamu ini.\" Lalu Akhis berkata kepada Daud: \"Sebab itu aku mengangkat engkau menjadi pengawalku sendiri sampai selamanya.\""
 },
 {
   "id": 7948,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 3,
   "firman": "Adapun Samuel sudah mati. Seluruh orang Israel sudah meratapi dia dan mereka telah menguburkan dia di Rama, di kotanya. Dan Saul telah menyingkirkan dari dalam negeri para pemanggil arwah dan roh peramal."
 },
 {
   "id": 7949,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 4,
   "firman": "Orang Filistin itu berkumpul, lalu bergerak maju, dan berkemah dekat Sunem. Saul mengumpulkan seluruh orang Israel, lalu mereka berkemah di Gilboa."
 },
 {
   "id": 7950,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 5,
   "firman": "Ketika Saul melihat tentara Filistin itu, maka takutlah ia dan hatinya sangat gemetar."
 },
 {
   "id": 7951,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 6,
   "firman": "Dan Saul bertanya kepada TUHAN, tetapi TUHAN tidak menjawab dia, baik dengan mimpi, baik dengan Urim, baik dengan perantaraan para nabi."
 },
 {
   "id": 7952,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 7,
   "firman": "Lalu berkatalah Saul kepada para pegawainya: \"Carilah bagiku seorang perempuan yang sanggup memanggil arwah; maka aku hendak pergi kepadanya dan meminta petunjuk kepadanya.\" Para pegawainya menjawab dia: \"Di En-Dor ada seorang perempuan yang sanggup memanggil arwah.\""
 },
 {
   "id": 7953,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 8,
   "firman": "Lalu menyamarlah Saul, ia mengenakan pakaian lain dan pergilah ia dengan dua orang. Ketika mereka pada waktu malam sampai kepada perempuan itu, berkatalah Saul: \"Cobalah engkau menenung bagiku dengan perantaraan arwah, dan panggillah supaya muncul kepadaku orang yang akan kusebut kepadamu.\""
 },
 {
   "id": 7954,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 9,
   "firman": "Tetapi perempuan itu menjawabnya: \"Tentu engkau mengetahui apa yang diperbuat Saul, bahwa ia telah melenyapkan dari dalam negeri para pemanggil arwah dan roh peramal. Mengapa engkau memasang jerat terhadap nyawaku untuk membunuh aku?\""
 },
 {
   "id": 7955,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 10,
   "firman": "Lalu bersumpahlah Saul kepadanya demi TUHAN, katanya: \"Demi TUHAN yang hidup, tidak akan ada kesalahan tertimpa kepadamu karena perkara ini.\""
 },
 {
   "id": 7956,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 11,
   "firman": "Sesudah itu bertanyalah perempuan itu: \"Siapakah yang harus kupanggil supaya muncul kepadamu?\" Jawabnya: \"Panggillah Samuel supaya muncul kepadaku.\""
 },
 {
   "id": 7957,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 12,
   "firman": "Ketika perempuan itu melihat Samuel, berteriaklah ia dengan suara nyaring. Lalu perempuan itu berkata kepada Saul, demikian: \"Mengapa engkau menipu aku? Engkau sendirilah Saul!\""
 },
 {
   "id": 7958,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 13,
   "firman": "Maka berbicaralah raja kepadanya: \"Janganlah takut; tetapi apakah yang kaulihat?\" Perempuan itu menjawab Saul: \"Aku melihat sesuatu yang ilahi muncul dari dalam bumi.\""
 },
 {
   "id": 7959,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 14,
   "firman": "Kemudian bertanyalah ia kepada perempuan itu: \"Bagaimana rupanya?\" Jawabnya: \"Ada seorang tua muncul, berselubungkan jubah.\" Maka tahulah Saul, bahwa itulah Samuel, lalu berlututlah ia dengan mukanya sampai ke tanah dan sujud menyembah."
 },
 {
   "id": 7960,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 15,
   "firman": "Sesudah itu berbicaralah Samuel kepada Saul: \"Mengapa engkau mengganggu aku dengan memanggil aku muncul?\" Kata Saul: \"Aku sangat dalam keadaan terjepit: orang Filistin berperang melawan aku, dan Allah telah undur dari padaku. Ia tidak menjawab aku lagi, baik dengan perantaraan nabi maupun dengan mimpi. Sebab itu aku memanggil engkau, supaya engkau memberitahukan kepadaku, apa yang harus kuperbuat.\""
 },
 {
   "id": 7961,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 16,
   "firman": "Lalu berbicaralah Samuel: \"Mengapa engkau bertanya kepadaku, padahal TUHAN telah undur dari padamu dan telah menjadi musuhmu?"
 },
 {
   "id": 7962,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 17,
   "firman": "TUHAN telah melakukan kepadamu seperti yang difirmankan-Nya dengan perantaraanku, yakni TUHAN telah mengoyakkan kerajaan dari tanganmu dan telah memberikannya kepada orang lain, kepada Daud."
 },
 {
   "id": 7963,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 18,
   "firman": "Karena engkau tidak mendengarkan suara TUHAN dan tidak melaksanakan murka-Nya yang bernyala-nyala itu atas Amalek, itulah sebabnya TUHAN melakukan hal itu kepadamu pada hari ini."
 },
 {
   "id": 7964,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 19,
   "firman": "Juga orang Israel bersama-sama dengan engkau akan diserahkan TUHAN ke dalam tangan orang Filistin, dan besok engkau serta anak-anakmu sudah ada bersama-sama dengan daku. Juga tentara Israel akan diserahkan TUHAN ke dalam tangan orang Filistin.\""
 },
 {
   "id": 7965,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 20,
   "firman": "Pada saat itu juga rebahlah Saul memanjang ke tanah sebab ia sangat ketakutan oleh karena perkataan Samuel itu. Juga tidak ada lagi kekuatannya, karena sehari semalam itu ia tidak makan apa-apa."
 },
 {
   "id": 7966,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 21,
   "firman": "Perempuan itu mendekati Saul lalu melihat, bahwa Saul sangat terkejut. Kemudian berkatalah perempuan itu kepadanya: \"Lihat, budakmu ini telah mendengarkan permintaanmu; aku telah mempertaruhkan nyawaku dan mendengarkan perkataan yang kaukatakan kepadaku."
 },
 {
   "id": 7967,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 22,
   "firman": "Oleh sebab itu, kiranya engkaupun mendengarkan permintaan budakmu ini. Izinkanlah aku menyajikan kepadamu sepotong roti; makanlah, supaya ada kekuatanmu, apabila engkau berjalan pula.\""
 },
 {
   "id": 7968,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 23,
   "firman": "Tetapi Saul menolak dan berkata: \"Aku tidak mau makan.\" Tetapi ketika para pegawainya serta perempuan itu juga mendesak, maka didengarkannyalah permintaan mereka, lalu bangkitlah ia dari tanah dan duduk di balai-balai."
 },
 {
   "id": 7969,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 24,
   "firman": "Perempuan itu mempunyai seekor anak lembu tambun di rumahnya maka segeralah ia menyembelih itu. Ia mengambil tepung, diremasnya dan dibakarnya menjadi roti yang tidak beragi."
 },
 {
   "id": 7970,
   "kitab": "1Sa",
   "pasal": 28,
   "ayat": 25,
   "firman": "Dihidangkannyalah semuanya itu ke depan Saul dan ke depan para pegawainya, lalu mereka makan. Kemudian bangkitlah mereka dan pergi pada malam itu juga."
 },
 {
   "id": 7971,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 1,
   "firman": "Orang Filistin mengumpulkan segala tentara mereka ke Afek, sedang orang Israel berkemah dekat mata air yang di Yizreel."
 },
 {
   "id": 7972,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 2,
   "firman": "Maka ketika raja-raja kota orang Filistin berjalan lewat dalam pasukan-pasukan seratus dan seribu, dan ketika juga Daud beserta orang-orangnya berjalan lewat di belakangnya bersama-sama dengan Akhis,"
 },
 {
   "id": 7973,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 3,
   "firman": "berkatalah para panglima orang Filistin itu: \"Apa gunanya orang-orang Ibrani ini?\" Jawab Akhis kepada para panglima orang Filistin itu: \"Bukankah dia itu Daud, hamba Saul, raja Israel, yang sudah satu dua tahun bersama-sama dengan aku, tanpa kudapati sesuatupun kesalahan padanya sejak saat ia membelot sampai hari ini?\""
 },
 {
   "id": 7974,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 4,
   "firman": "Tetapi para panglima orang Filistin itu menjadi marah kepadanya; serta berkata kepadanya: \"Suruhlah orang itu pulang, supaya ia kembali ke tempat, yang kautunjukkan kepadanya, dan janganlah ia pergi berperang, bersama-sama dengan kita, supaya jangan ia menjadi lawan kita dalam peperangan. Sebab dengan apakah orang ini dapat menyukakan hati tuannya, kecuali dengan memberi kepala-kepala orang-orang ini?"
 },
 {
   "id": 7975,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 5,
   "firman": "Bukankah dia ini Daud yang dinyanyikan orang secara berbalas-balasan sambil menari-nari, demikian: Saul mengalahkan beribu-ribu musuh, tetapi Daud berlaksa-laksa?\""
 },
 {
   "id": 7976,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 6,
   "firman": "Lalu Akhis memanggil Daud, dan berkata kepadanya: \"Demi TUHAN yang hidup, engkau ini orang jujur dan aku memandang baik, jika engkau keluar masuk bersama-sama dengan aku dalam tentara, sebab aku tidak mendapati sesuatu kejahatan padamu, sejak saat engkau datang kepadaku sampai hari ini; tetapi engkau ini tidak disukai oleh raja-raja kota."
 },
 {
   "id": 7977,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 7,
   "firman": "Sebab itu, pulanglah, pergilah dengan selamat dan jangan lakukan apa yang jahat di mata raja-raja kota orang Filistin itu.\""
 },
 {
   "id": 7978,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 8,
   "firman": "Tetapi Daud berkata kepada Akhis: \"Apa yang telah kuperbuat? Dan kesalahan apa yang kaudapati pada hambamu ini, sejak saat aku menjadi hamba kepadamu, sampai hari ini, sehingga aku tidak boleh ikut pergi berperang melawan musuh tuanku raja?\""
 },
 {
   "id": 7979,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 9,
   "firman": "Lalu Akhis menjawab Daud: \"Aku tahu, engkau ini memang kusukai seperti utusan Allah. Hanya, para panglima orang Filistin telah berkata: Ia tidak boleh pergi berperang bersama-sama dengan kita."
 },
 {
   "id": 7980,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 10,
   "firman": "Jadi, bangunlah pagi-pagi beserta orang-orang tuanmu ini yang datang bersama-sama dengan engkau; bangunlah kamu pagi-pagi, segera sesudah hari cukup terang bagimu, dan pergilah.\""
 },
 {
   "id": 7981,
   "kitab": "1Sa",
   "pasal": 29,
   "ayat": 11,
   "firman": "Lalu bangunlah Daud dan orang-orangnya pagi-pagi untuk berjalan pulang ke negeri orang Filistin, sedang orang Filistin itu bergerak maju ke Yizreel."
 },
 {
   "id": 7982,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 1,
   "firman": "Ketika Daud serta orang-orangnya sampai ke Ziklag pada hari yang ketiga, orang Amalek telah menyerbu Tanah Negeb dan Ziklag; Ziklag telah dikalahkan oleh mereka dan dibakar habis."
 },
 {
   "id": 7983,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 2,
   "firman": "Perempuan-perempuan dan semua orang yang ada di sana, tua dan muda, telah ditawan mereka, dengan tidak membunuh seorangpun; mereka menggiring sekaliannya, kemudian meneruskan perjalanannya."
 },
 {
   "id": 7984,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 3,
   "firman": "Ketika Daud dan orang-orangnya sampai ke kota itu, tampaklah kota itu terbakar habis, dan isteri mereka serta anak mereka yang laki-laki dan perempuan telah ditawan."
 },
 {
   "id": 7985,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 4,
   "firman": "Lalu menangislah Daud dan rakyat yang bersama-sama dengan dia itu dengan nyaring, sampai mereka tidak kuat lagi menangis."
 },
 {
   "id": 7986,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 5,
   "firman": "Juga kedua isteri Daud ditawan, yakni Ahinoam, perempuan Yizreel, dan Abigail, bekas isteri Nabal, orang Karmel itu."
 },
 {
   "id": 7987,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 6,
   "firman": "Dan Daud sangat terjepit, karena rakyat mengatakan hendak melempari dia dengan batu. Seluruh rakyat itu telah pedih hati, masing-masing karena anaknya laki-laki dan perempuan. Tetapi Daud menguatkan kepercayaannya kepada TUHAN, Allahnya."
 },
 {
   "id": 7988,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 7,
   "firman": "Lalu Daud memberi perintah kepada imam Abyatar bin Ahimelekh: \"Bawalah efod itu kepadaku.\" Maka Abyatar membawa efod itu kepada Daud."
 },
 {
   "id": 7989,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 8,
   "firman": "Kemudian bertanyalah Daud kepada TUHAN, katanya: \"Haruskah aku mengejar gerombolan itu? Akan dapatkah mereka kususul?\" Dan Ia berfirman kepadanya: \"Kejarlah, sebab sesungguhnya, engkau akan dapat menyusul mereka dan melepaskan para tawanan.\""
 },
 {
   "id": 7990,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 9,
   "firman": "Lalu pergilah Daud beserta keenam ratus orang yang bersama-sama dengan dia, dan sampailah mereka ke sungai Besor. Sementara orang-orang yang mau tinggal di belakang berhenti di sana,"
 },
 {
   "id": 7991,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 10,
   "firman": "maka Daud melanjutkan pengejaran itu beserta empat ratus orang. Dua ratus orang yang terlalu lelah untuk menyeberangi sungai Besor itu, berhenti di sana."
 },
 {
   "id": 7992,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 11,
   "firman": "Kemudian mereka menemui seorang Mesir di padang lalu membawanya kepada Daud. Mereka memberi dia roti, lalu makanlah ia, kemudian mereka memberi dia minum air,"
 },
 {
   "id": 7993,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 12,
   "firman": "dan memberikan kepadanya sepotong kue ara dan dua buah kue kismis, dan setelah dimakannya, ia segar kembali, sebab ia tidak makan dan minum selama tiga hari tiga malam."
 },
 {
   "id": 7994,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 13,
   "firman": "Kemudian bertanyalah Daud kepadanya: \"Budak siapakah engkau dan dari manakah engkau?\" Jawabnya: \"Aku ini seorang pemuda Mesir, budak kepunyaan seorang Amalek. Tuanku meninggalkan aku, karena tiga hari yang lalu aku jatuh sakit."
 },
 {
   "id": 7995,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 14,
   "firman": "Kami telah menyerbu Tanah Negeb orang Kreti dan daerah Yehuda dan Tanah Negeb Kaleb, dan Ziklag telah kami bakar habis.\""
 },
 {
   "id": 7996,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 15,
   "firman": "Daud bertanya kepadanya: \"Dapatkah engkau menunjuk jalan kepadaku ke gerombolan itu?\" Katanya: \"Bersumpahlah kepadaku demi Allah, bahwa engkau tidak akan membunuh aku, dan tidak akan menyerahkan aku ke dalam tangan tuanku itu, maka aku akan menunjuk jalan kepadamu ke gerombolan itu.\""
 },
 {
   "id": 7997,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 16,
   "firman": "Ia menunjuk jalan kepada Daud ke sana, dan tampaklah orang-orang itu berpencar-pencar di atas seluruh daerah itu, sambil makan, minum dan mengadakan perayaan karena jarahan yang besar, yang telah dirampas mereka dari tanah orang Filistin dan dari tanah Yehuda."
 },
 {
   "id": 7998,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 17,
   "firman": "Dan pada keesokan harinya Daud menghancurkan mereka dari pagi-pagi buta sampai matahari terbenam; tidak ada seorangpun dari mereka yang lolos, kecuali empat ratus orang muda yang melarikan diri dengan menunggang unta."
 },
 {
   "id": 7999,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 18,
   "firman": "Daud melepaskan semua apa yang dirampas oleh orang Amalek itu; juga kedua isterinya dapat dilepaskan Daud."
 },
 {
   "id": 8000,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 19,
   "firman": "Tidak ada yang hilang pada mereka, dari hal yang kecil sampai hal yang besar, sampai anak laki-laki dan anak perempuan, dan dari jarahan sampai segala sesuatu yang telah dirampas mereka; semuanya itu dibawa Daud kembali."
 },
 {
   "id": 8001,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 20,
   "firman": "Daud mengambil segala kambing domba dan lembu; semuanya itu digiring mereka di hadapannya, serta berkata: \"Inilah jarahan Daud.\""
 },
 {
   "id": 8002,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 21,
   "firman": "Ketika Daud sampai kepada kedua ratus orang yang telah terlalu lelah untuk mengikuti Daud, yang telah dibiarkannya tinggal di dekat sungai Besor, maka keluarlah orang-orang ini menyongsong Daud dan menyongsong rakyat yang bersama-sama dengan dia. Daud mendekati orang-orang itu dan memberi salam kepada mereka."
 },
 {
   "id": 8003,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 22,
   "firman": "Kemudian mulailah berbicara semua orang jahat dan orang dursila di antara orang-orang, yang ikut pergi bersama-sama dengan Daud itu, katanya: \"Karena mereka tidak ikut pergi bersama-sama dengan kita, janganlah kita berikan kepada mereka apa-apa dari jarahan yang kita selamatkan itu, kecuali kepada masing-masing mereka isterinya dan anak-anaknya. Itu boleh mereka bawa, dan biarlah mereka pergi!\""
 },
 {
   "id": 8004,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 23,
   "firman": "Tetapi Daud berkata: \"Janganlah kamu, saudara-saudaraku, berbuat demikian, dengan apa yang diberikan TUHAN kepada kita; sebab Ia telah melindungi kita, dan menyerahkan ke dalam tangan kita gerombolan yang menyerang kita."
 },
 {
   "id": 8005,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 24,
   "firman": "Siapa yang mau mendengarkan kamu dalam perkara ini? Sebab, bagian orang yang tinggal di dekat barang-barang adalah sama seperti bagian orang yang pergi berperang; itu akan dibagi sama-sama.\""
 },
 {
   "id": 8006,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 25,
   "firman": "Dan demikianlah halnya sejak hari itu dan seterusnya; hal itu ditentukannya menjadi ketetapan dan peraturan bagi orang Israel sampai sekarang."
 },
 {
   "id": 8007,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 26,
   "firman": "Ketika Daud sampai ke Ziklag, dikirimnyalah sebagian dari jarahan itu kepada para tua-tua di Yehuda, kepada teman-temannya, dengan pesan: \"Inilah pemberian kepadamu dari jarahan yang dirampas dari musuh TUHAN,\""
 },
 {
   "id": 8008,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 27,
   "firman": "yakni kepada yang di Betel, kepada yang di Ramot di Tanah Selatan, kepada yang di Yatir,"
 },
 {
   "id": 8009,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 28,
   "firman": "kepada yang di Aroer, kepada yang di Sifmot, kepada yang di Estemoa,"
 },
 {
   "id": 8010,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 29,
   "firman": "kepada yang di Rakhal, kepada yang di kota-kota orang Yerahmeel, kepada yang di kota-kota orang Keni,"
 },
 {
   "id": 8011,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 30,
   "firman": "kepada yang di Horma, kepada yang di Bor-Asan, kepada yang di Atakh,"
 },
 {
   "id": 8012,
   "kitab": "1Sa",
   "pasal": 30,
   "ayat": 31,
   "firman": "kepada yang di Hebron dan kepada segala tempat di mana Daud dengan orang-orangnya mengembara."
 },
 {
   "id": 8013,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 1,
   "firman": "Sementara itu orang Filistin berperang melawan orang Israel. Orang-orang Israel melarikan diri dari hadapan orang Filistin dan banyak yang mati terbunuh di pegunungan Gilboa."
 },
 {
   "id": 8014,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 2,
   "firman": "Orang Filistin terus mengejar Saul dan anak-anaknya dan menewaskan Yonatan, Abinadab dan Malkisua, anak-anak Saul."
 },
 {
   "id": 8015,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 3,
   "firman": "Kemudian makin beratlah pertempuran itu bagi Saul; para pemanah menjumpainya, dan melukainya dengan parah."
 },
 {
   "id": 8016,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 4,
   "firman": "Lalu berkatalah Saul kepada pembawa senjatanya: \"Hunuslah pedangmu dan tikamlah aku, supaya jangan datang orang-orang yang tidak bersunat ini menikam aku dan memperlakukan aku sebagai permainan.\" Tetapi pembawa senjatanya tidak mau, karena ia sangat segan. Kemudian Saul mengambil pedang itu dan menjatuhkan dirinya ke atasnya."
 },
 {
   "id": 8017,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 5,
   "firman": "Ketika pembawa senjatanya melihat, bahwa Saul telah mati, iapun menjatuhkan dirinya ke atas pedangnya, lalu mati bersama-sama dengan Saul."
 },
 {
   "id": 8018,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 6,
   "firman": "Jadi Saul, ketiga anaknya dan pembawa senjatanya, dan seluruh tentaranya sama-sama mati pada hari itu."
 },
 {
   "id": 8019,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 7,
   "firman": "Ketika dilihat orang-orang Israel, yang di seberang lembah dan yang di seberang sungai Yordan, bahwa tentara Israel telah melarikan diri, dan bahwa Saul serta anak-anaknya sudah mati, maka mereka meninggalkan kota-kota mereka lalu melarikan diri juga; kemudian datanglah orang Filistin dan menetap di sana."
 },
 {
   "id": 8020,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 8,
   "firman": "Ketika keesokan harinya orang Filistin datang merampasi orang-orang yang mati terbunuh itu, didapati mereka Saul dan ketiga anaknya tergelimpang di pegunungan Gilboa."
 },
 {
   "id": 8021,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 9,
   "firman": "Mereka memancung kepala Saul, merampas senjata-senjatanya dan menyuruh orang berkeliling di negeri orang Filistin untuk menyampaikan kabar itu di kuil berhalanya dan kepada rakyat."
 },
 {
   "id": 8022,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 10,
   "firman": "Kemudian mereka menaruh senjata-senjata Saul di kuil Asytoret, dan mayatnya dipakukan mereka di tembok kota Bet-Sean."
 },
 {
   "id": 8023,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 11,
   "firman": "Ketika penduduk Yabesh-Gilead mendengar tentang apa yang telah dilakukan orang Filistin kepada Saul,"
 },
 {
   "id": 8024,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 12,
   "firman": "maka bersiaplah segenap orang gagah perkasa, mereka berjalan terus semalam-malaman, lalu mengambil mayat Saul dan mayat anak-anaknya dari tembok kota Bet-Sean. Kemudian pulanglah mereka ke Yabesh dan membakar mayat-mayat itu di sana."
 },
 {
   "id": 8025,
   "kitab": "1Sa",
   "pasal": 31,
   "ayat": 13,
   "firman": "Mereka mengambil tulang-tulangnya lalu menguburkannya di bawah pohon tamariska di Yabesh. Sesudah itu berpuasalah mereka tujuh hari lamanya."
 },
 {
   "id": 8026,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 1,
   "firman": "Setelah Saul mati, dan ketika Daud kembali sesudah memukul kalah orang Amalek dan tinggal dua hari di Ziklag,"
 },
 {
   "id": 8027,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 2,
   "firman": "maka datanglah pada hari ketiga seorang dari tentara, dari pihak Saul, dengan pakaian terkoyak-koyak dan tanah di atas kepala. Ketika ia sampai kepada Daud, sujudlah ia ke tanah dan menyembah."
 },
 {
   "id": 8028,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 3,
   "firman": "Bertanyalah Daud kepadanya: \"Dari manakah engkau?\" Jawabnya kepadanya: \"Aku lolos dari tentara Israel.\""
 },
 {
   "id": 8029,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 4,
   "firman": "Bertanyalah pula Daud kepadanya: \"Apakah yang terjadi? Coba ceriterakan kepadaku.\" Jawabnya: \"Rakyat telah melarikan diri dari pertempuran; bukan saja banyak dari rakyat yang gugur dan mati, tetapi Saul dan Yonatan, anaknya, juga sudah mati.\""
 },
 {
   "id": 8030,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lalu Daud berkata kepada orang muda yang membawa kabar kepadanya itu: \"Bagaimana kauketahui, bahwa Saul dan Yonatan, anaknya, sudah mati?\""
 },
 {
   "id": 8031,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 6,
   "firman": "Orang muda yang membawa kabar kepadanya itu berkata: \"Kebetulan aku ada di pegunungan Gilboa; maka tampaklah Saul bertelekan pada tombaknya, sedang kereta-kereta dan orang-orang berkuda mengejarnya."
 },
 {
   "id": 8032,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 7,
   "firman": "Ketika menoleh ke belakang, ia melihat aku, lalu memanggil aku; dan aku berkata: Ya tuanku."
 },
 {
   "id": 8033,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 8,
   "firman": "Ia bertanya kepadaku: Siapakah engkau? Jawabku kepadanya: Aku seorang Amalek."
 },
 {
   "id": 8034,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 9,
   "firman": "Lalu katanya kepadaku: Datanglah ke mari dan bunuhlah aku, sebab kekejangan telah menyerang aku, tetapi aku masih bernyawa."
 },
 {
   "id": 8035,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 10,
   "firman": "Aku datang ke dekatnya dan membunuh dia, sebab aku tahu, ia tidak dapat hidup terus setelah jatuh. Aku mengambil jejamang yang ada di kepalanya, dan gelang yang ada pada lengannya, dan inilah dia kubawa kepada tuanku.\""
 },
 {
   "id": 8036,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 11,
   "firman": "Lalu Daud memegang pakaiannya dan mengoyakkannya; dan semua orang yang bersama-sama dengan dia berbuat demikian juga."
 },
 {
   "id": 8037,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 12,
   "firman": "Dan mereka meratap, menangis dan berpuasa sampai matahari terbenam karena Saul, karena Yonatan, anaknya, karena umat TUHAN dan karena kaum Israel, sebab mereka telah gugur oleh pedang."
 },
 {
   "id": 8038,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kemudian bertanyalah Daud kepada orang muda yang membawa kabar itu kepadanya: \"Asalmu dari mana?\" Jawabnya: \"Aku ini anak perantau, orang Amalek.\""
 },
 {
   "id": 8039,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 14,
   "firman": "Kemudian berkatalah Daud kepadanya: \"Bagaimana? Tidakkah engkau segan mengangkat tanganmu memusnahkan orang yang diurapi TUHAN?\""
 },
 {
   "id": 8040,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 15,
   "firman": "Lalu Daud memanggil salah seorang dari anak buahnya dan berkata: \"Ke mari, paranglah dia.\" Orang itu memarangnya, sehingga mati."
 },
 {
   "id": 8041,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 16,
   "firman": "Dan Daud berkata kepadanya: \"Kautanggung sendiri darahmu, sebab mulutmulah yang menjadi saksi menentang engkau, karena berkata: Aku telah membunuh orang yang diurapi TUHAN.\""
 },
 {
   "id": 8042,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 17,
   "firman": "Daud menyanyikan nyanyian ratapan ini karena Saul dan Yonatan, anaknya,"
 },
 {
   "id": 8043,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 18,
   "firman": "dan ia memberi perintah untuk mengajarkan nyanyian ini kepada bani Yehuda; itu ada tertulis dalam Kitab Orang Jujur."
 },
 {
   "id": 8044,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 19,
   "firman": "Kepermaianmu, hai Israel, mati terbunuh di bukit-bukitmu! Betapa gugur para pahlawan!"
 },
 {
   "id": 8045,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 20,
   "firman": "Janganlah kabarkan itu di Gat, janganlah beritakan itu di lorong-lorong Askelon, supaya jangan bersukacita anak-anak perempuan orang Filistin, supaya jangan beria-ria anak-anak perempuan orang-orang yang tidak bersunat!"
 },
 {
   "id": 8046,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 21,
   "firman": "Hai gunung-gunung di Gilboa! jangan ada embun, jangan ada hujan di atas kamu, hai padang-padang pembawa kematian! Sebab di sanalah perisai para pahlawan dilumuri, perisai Saul yang tidak diurapi dengan minyak."
 },
 {
   "id": 8047,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tanpa darah orang-orang yang mati terbunuh dan tanpa lemak para pahlawan panah Yonatan tidak pernah berpaling pulang, dan pedang Saul tidak kembali dengan hampa."
 },
 {
   "id": 8048,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 23,
   "firman": "Saul dan Yonatan, orang-orang yang dicintai dan yang ramah, dalam hidup dan matinya tidak terpisah. Mereka lebih cepat dari burung rajawali, mereka lebih kuat dari singa."
 },
 {
   "id": 8049,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 24,
   "firman": "Hai anak-anak perempuan Israel, menangislah karena Saul, yang mendandani kamu dengan pakaian mewah dari kain kirmizi, yang menyematkan perhiasan emas pada pakaianmu."
 },
 {
   "id": 8050,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 25,
   "firman": "Betapa gugur para pahlawan di tengah-tengah pertempuran! Yonatan mati terbunuh di bukit-bukitmu."
 },
 {
   "id": 8051,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 26,
   "firman": "Merasa susah aku karena engkau, saudaraku Yonatan, engkau sangat ramah kepadaku; bagiku cintamu lebih ajaib dari pada cinta perempuan."
 },
 {
   "id": 8052,
   "kitab": "2Sa",
   "pasal": 1,
   "ayat": 27,
   "firman": "Betapa gugur para pahlawan dan musnah senjata-senjata perang!"
 },
 {
   "id": 8053,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 1,
   "firman": "Kemudian bertanyalah Daud kepada TUHAN, katanya: \"Apakah aku harus pergi ke salah satu kota di Yehuda?\" Firman TUHAN kepadanya: \"Pergilah.\" Lalu kata Daud: \"Ke mana aku pergi?\" Firman-Nya: \"Ke Hebron.\""
 },
 {
   "id": 8054,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu pergilah Daud ke sana dengan kedua isterinya: Ahinoam, perempuan Yizreel, dan Abigail, bekas isteri Nabal, orang Karmel itu."
 },
 {
   "id": 8055,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 3,
   "firman": "Juga Daud membawa serta orang-orangnya yang mengiringinya masing-masing dengan rumah tangganya, dan menetaplah mereka di kota-kota Hebron."
 },
 {
   "id": 8056,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 4,
   "firman": "Kemudian datanglah orang-orang Yehuda, lalu mengurapi Daud di sana menjadi raja atas kaum Yehuda. Ketika kepada Daud diberitahukan bahwa orang-orang Yabesh-Gilead menguburkan Saul,"
 },
 {
   "id": 8057,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 5,
   "firman": "maka Daud mengirim orang kepada orang-orang Yabesh-Gilead dengan pesan: \"Diberkatilah kamu oleh TUHAN, karena kamu telah menunjukkan kasihmu kepada tuanmu, Saul, dengan menguburkannya."
 },
 {
   "id": 8058,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 6,
   "firman": "Oleh sebab itu, TUHAN kiranya menunjukkan kasih dan setia-Nya kepadamu. Akupun akan berbuat kebaikan yang sama kepadamu, karena kamu telah melakukan hal yang demikian."
 },
 {
   "id": 8059,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 7,
   "firman": "Kuatkanlah hatimu sekarang dan jadilah orang-orang yang gagah perkasa, sekalipun tuanmu Saul sudah mati; dan aku telah diurapi oleh kaum Yehuda menjadi raja atas mereka.\""
 },
 {
   "id": 8060,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 8,
   "firman": "Abner bin Ner, panglima Saul, telah mengambil Isyboset, anak Saul, dan membawanya ke Mahanaim"
 },
 {
   "id": 8061,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 9,
   "firman": "serta menjadikannya raja atas Gilead, atas orang Asyuri, atas Yizreel, atas Efraim dan atas Benyamin, bahkan atas seluruh Israel."
 },
 {
   "id": 8062,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 10,
   "firman": "Isyboset bin Saul berumur empat puluh tahun pada waktu ia menjadi raja atas Israel dan ia memerintah dua tahun lamanya. Hanyalah kaum Yehuda yang mengikuti Daud."
 },
 {
   "id": 8063,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dan lamanya Daud memerintah di Hebron atas kaum Yehuda adalah tujuh tahun dan enam bulan."
 },
 {
   "id": 8064,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 12,
   "firman": "Lalu Abner bin Ner dengan anak buah Isyboset bin Saul bergerak maju dari Mahanaim ke Gibeon."
 },
 {
   "id": 8065,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 13,
   "firman": "Juga Yoab, anak Zeruya, dan anak buah Daud bergerak maju. Mereka saling bertemu di telaga Gibeon, lalu tinggal di sana, pihak yang satu di tepi telaga sebelah sini, dan pihak yang lain di tepi telaga sebelah sana."
 },
 {
   "id": 8066,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 14,
   "firman": "Berkatalah Abner kepada Yoab: \"Biarlah orang-orang muda tampil dan mengadakan pertandingan di depan kita.\" Jawab Yoab: \"Baik.\""
 },
 {
   "id": 8067,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 15,
   "firman": "Lalu tampillah mereka dan berjalan lewat dengan dihitung: dua belas orang dari suku Benyamin, dari Isyboset, anak Saul, dan dua belas orang dari anak buah Daud."
 },
 {
   "id": 8068,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 16,
   "firman": "Kemudian mereka masing-masing menangkap kepala lawannya, dan menikamkan pedangnya ke lambung lawannya, sehingga rebahlah mereka bersama-sama. Sebab itu tempat itu disebutkan orang Helkat-Hazurim; letaknya dekat Gibeon."
 },
 {
   "id": 8069,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 17,
   "firman": "Pada hari itu pertempuran sangat hebat, dan Abner serta orang-orang Israel terpukul kalah oleh anak buah Daud."
 },
 {
   "id": 8070,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 18,
   "firman": "Ketiga anak laki-laki Zeruya, yakni Yoab, Abisai dan Asael ada di sana; Asael cepat larinya seperti kijang di padang."
 },
 {
   "id": 8071,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 19,
   "firman": "Asael mengejar Abner dan tidak menyimpang ke kanan atau ke kiri dalam membuntutinya."
 },
 {
   "id": 8072,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 20,
   "firman": "Lalu Abner berpaling ke belakang dan bertanya: \"Engkaukah itu Asael?\" Jawabnya: \"Ya, aku.\""
 },
 {
   "id": 8073,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 21,
   "firman": "Kemudian berkatalah Abner kepadanya: \"Menyimpanglah ke kiri atau ke kanan, tangkaplah salah seorang dari orang-orang muda itu dan ambillah senjatanya.\" Tetapi Asael tidak mau berhenti membuntuti Abner."
 },
 {
   "id": 8074,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 22,
   "firman": "Berkatalah sekali lagi Abner kepada Asael: \"Berhentilah membuntuti aku. Apa aku harus memukul engkau sampai jatuh? Bagaimana aku dapat memandang muka Yoab, abangmu itu?\""
 },
 {
   "id": 8075,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 23,
   "firman": "Tetapi Asael menolak berhenti. Lalu Abner menusuk ke belakang ke perut Asael dengan tombaknya, sehingga tombak itu menembus belakangnya; dan rebahlah ia di sana dan mati di tempat itu juga. Semua orang yang datang ke tempat Asael rebah dan mati itu, berhenti di sana."
 },
 {
   "id": 8076,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tetapi Yoab dan Abisai mengejar Abner. Ketika matahari masuk dan mereka sampai ke dekat bukit Ama, yang ada di sebelah timur Giah, ke arah padang gurun Gibeon,"
 },
 {
   "id": 8077,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 25,
   "firman": "berhimpunlah bani Benyamin di belakang Abner menjadi satu gabungan dan bersiap-siap di puncak sebuah bukit."
 },
 {
   "id": 8078,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 26,
   "firman": "Berserulah Abner kepada Yoab: \"Haruskah pedang makan terus-menerus? Tidak tahukah engkau, bahwa kepahitan datang pada akhirnya? Berapa lama lagi engkau tidak mau mengatakan kepada rakyat itu, supaya mereka berhenti memburu saudara-saudaranya?\""
 },
 {
   "id": 8079,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 27,
   "firman": "Jawab Yoab: \"Demi Allah yang hidup, sekiranya engkau berbicara tadi, maka tentulah sudah dari tadi pagi rakyat menarik diri dari memburu saudara-saudaranya.\""
 },
 {
   "id": 8080,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 28,
   "firman": "Lalu Yoab meniup sangkakala dan seluruh rakyat berhenti; mereka tidak lagi mengejar orang Israel dan tidak berperang lagi."
 },
 {
   "id": 8081,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 29,
   "firman": "Semalam-malaman Abner dan orang-orangnya berjalan melalui Araba-Yordan, menyeberangi sungai Yordan, berjalan terus hampir sepanjang siang, lalu sampai ke Mahanaim."
 },
 {
   "id": 8082,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 30,
   "firman": "Ketika Yoab berhenti memburu Abner dan menghimpunkan seluruh rakyat, ternyata sembilan belas orang dari anak buah Daud hilang termasuk Asael."
 },
 {
   "id": 8083,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 31,
   "firman": "Tetapi anak buah Daud menewaskan dari suku Benyamin, dari orang-orang Abner, tiga ratus enam puluh orang."
 },
 {
   "id": 8084,
   "kitab": "2Sa",
   "pasal": 2,
   "ayat": 32,
   "firman": "Mereka mengangkat mayat Asael dan menguburkannya di dalam kubur ayahnya yang di Betlehem. Kemudian berjalanlah Yoab dan orang-orangnya semalam-malaman itu dan sampai ke Hebron, ketika hari sudah terang."
 },
 {
   "id": 8085,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 1,
   "firman": "Peperangan antara keluarga Saul dan keluarga Daud berlarut-larut; Daud kian lama kian kuat, sedang keluarga Saul kian lama kian lemah."
 },
 {
   "id": 8086,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 2,
   "firman": "Di Hebron lahirlah bagi Daud anak-anak lelaki. Anak sulungnya ialah Amnon, dari Ahinoam, perempuan Yizreel;"
 },
 {
   "id": 8087,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 3,
   "firman": "anaknya yang kedua ialah Kileab, dari Abigail, bekas isteri Nabal, orang Karmel; yang ketiga ialah Absalom, anak dari Maakha, anak perempuan Talmai raja Gesur;"
 },
 {
   "id": 8088,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 4,
   "firman": "yang keempat ialah Adonia, anak dari Hagit; yang kelima ialah Sefaca, anak Abital;"
 },
 {
   "id": 8089,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 5,
   "firman": "dan yang keenam ialah Yitream, dari Egla, isteri Daud. Semuanya ini dilahirkan bagi Daud di Hebron."
 },
 {
   "id": 8090,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 6,
   "firman": "Selama ada peperangan antara keluarga Saul dan keluarga Daud, maka Abner makin mendapat pengaruh di antara keluarga Saul."
 },
 {
   "id": 8091,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 7,
   "firman": "Saul mempunyai gundik yang bernama Rizpa; dia anak perempuan Aya. Berkatalah Isyboset kepada Abner: \"Mengapa kauhampiri gundik ayahku?\""
 },
 {
   "id": 8092,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 8,
   "firman": "Lalu sangat marahlah Abner karena perkataan Isyboset itu, katanya: \"Kepala anjing dari Yehudakah aku? Sampai sekarang aku masih menunjukkan kesetiaanku kepada keluarga Saul, ayahmu, kepada saudara-saudaranya dan kepada sahabat-sahabatnya, dan aku tidak membiarkan engkau jatuh ke tangan Daud, tetapi sekarang engkau menuduh aku berlaku salah dengan seorang perempuan?"
 },
 {
   "id": 8093,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 9,
   "firman": "Kiranya Allah menghukum Abner, bahkan lebih lagi dari pada itu, jika tidak kulakukan kepada Daud seperti yang dijanjikan TUHAN dengan bersumpah kepadanya,"
 },
 {
   "id": 8094,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 10,
   "firman": "yakni memindahkan kerajaan dari keluarga Saul dan mendirikan takhta kerajaan Daud atas Israel dan atas Yehuda, dari Dan sampai Bersyeba.\""
 },
 {
   "id": 8095,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 11,
   "firman": "Dan Isyboset tidak dapat lagi menjawab sepatah katapun kepada Abner, karena takutnya kepadanya."
 },
 {
   "id": 8096,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 12,
   "firman": "Lalu Abner mengirim utusan kepada Daud dengan pesan: \"Milik siapakah negeri ini? Adakanlah perjanjian dengan aku, maka sesungguhnya aku akan membantu engkau untuk membawa seluruh orang Israel memihak kepadamu.\""
 },
 {
   "id": 8097,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 13,
   "firman": "Jawab Daud: \"Baik, aku akan mengadakan perjanjian dengan engkau, hanya satu hal kuminta dari padamu, yakni engkau tidak akan menghadap aku, kecuali jika engkau membawa lebih dahulu Mikhal, anak perempuan Saul, apabila engkau datang menghadap aku.\""
 },
 {
   "id": 8098,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 14,
   "firman": "Daud mengirim utusan juga kepada Isyboset, anak Saul, dengan pesan: \"Berikanlah isteriku Mikhal, yang telah kuperoleh dengan seratus kulit khatan orang Filistin.\""
 },
 {
   "id": 8099,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 15,
   "firman": "Lalu Isyboset menyuruh mengambil perempuan itu dari pada suaminya, yakni Paltiel bin Lais."
 },
 {
   "id": 8100,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 16,
   "firman": "Dan suaminya berjalan bersama-sama dengan dia, sambil mengikuti dia dengan menangis sampai ke Bahurim. Lalu berkatalah Abner kepadanya: \"Ayo, pulanglah.\" Maka pulanglah ia."
 },
 {
   "id": 8101,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sementara itu berundinglah Abner dengan para tua-tua orang Israel, katanya: \"Telah lama kamu menghendaki Daud menjadi raja atas kamu."
 },
 {
   "id": 8102,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 18,
   "firman": "Maka sekarang bertindaklah, sebab TUHAN sudah berfirman tentang Daud, demikian: Dengan perantaraan hamba-Ku Daud Aku akan menyelamatkan umat-Ku Israel dari tangan orang Filistin dan dari tangan semua musuhnya.\""
 },
 {
   "id": 8103,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 19,
   "firman": "Abner berbicara dengan orang Benyamin; pula Abner pergi membicarakan dengan Daud di Hebron segala yang sudah dipandang baik oleh orang Israel dan oleh seluruh kaum Benyamin."
 },
 {
   "id": 8104,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 20,
   "firman": "Ketika Abner datang kepada Daud di Hebron bersama-sama dua puluh orang, maka Daud mengadakan perjamuan bagi Abner dan orang-orang yang menyertainya."
 },
 {
   "id": 8105,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 21,
   "firman": "Berkatalah Abner kepada Daud: \"Baiklah aku bersiap untuk pergi mengumpulkan seluruh orang Israel kepada tuanku raja, supaya mereka mengadakan perjanjian dengan tuanku dan tuanku menjadi raja atas segala yang dikehendaki hatimu.\" Lalu Daud membiarkan Abner pergi dan berjalanlah ia dengan selamat."
 },
 {
   "id": 8106,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 22,
   "firman": "Anak buah Daud dan Yoab baru saja pulang setelah mengadakan penggerebekan dan mereka membawa pulang jarahan yang banyak. Tetapi Abner tidak lagi bersama-sama Daud di Hebron, sebab ia telah dilepasnya pergi dengan selamat."
 },
 {
   "id": 8107,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 23,
   "firman": "Ketika Yoab bersama dengan segenap tentaranya sudah pulang, diberitahukan kepada Yoab, demikian: \"Abner bin Ner telah datang kepada raja dan ia sudah dibiarkannya pergi dengan selamat.\""
 },
 {
   "id": 8108,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 24,
   "firman": "Kemudian pergilah Yoab kepada raja, katanya: \"Apakah yang telah kauperbuat? Abner telah datang kepadamu; mengapa engkau membiarkannya begitu saja?"
 },
 {
   "id": 8109,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 25,
   "firman": "Apakah engkau tidak kenal Abner bin Ner itu. Ia datang untuk memperdaya engkau dan untuk mengetahui gerak-gerikmu dan untuk mengetahui segala yang hendak kaulakukan.\""
 },
 {
   "id": 8110,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 26,
   "firman": "Sesudah itu keluarlah Yoab meninggalkan Daud dan menyuruh orang menyusul Abner, lalu mereka membawanya kembali dari perigi Sira tanpa diketahui Daud."
 },
 {
   "id": 8111,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 27,
   "firman": "Ketika Abner kembali ke Hebron, maka Yoab membawanya sebentar ke samping di tengah-tengah pintu gerbang itu, seakan-akan hendak berbicara dengan dia dengan diam-diam; kemudian ditikamnyalah dia di sana pada perutnya, sehingga mati, membalas darah Asael, adiknya."
 },
 {
   "id": 8112,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 28,
   "firman": "Ketika hal itu didengar Daud kemudian, berkatalah ia: \"Aku dan kerajaanku tidak bersalah di hadapan TUHAN sampai selama-lamanya terhadap darah Abner bin Ner itu."
 },
 {
   "id": 8113,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 29,
   "firman": "Biarlah itu ditanggung oleh Yoab sendiri dan seluruh kaum keluarganya. Biarlah dalam keturunan Yoab tidak putus-putusnya ada orang yang mengeluarkan lelehan, yang sakit kusta, yang bertongkat, yang tewas oleh pedang atau yang kekurangan makanan.\""
 },
 {
   "id": 8114,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 30,
   "firman": "Demikianlah Yoab dan Abisai, adiknya, membunuh Abner, karena ia telah membunuh Asael, adik mereka, di Gibeon dalam pertempuran."
 },
 {
   "id": 8115,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 31,
   "firman": "Dan berkatalah Daud kepada Yoab dan kepada segala rakyat yang bersama-sama dengan dia: \"Koyakkanlah pakaianmu dan lilitkanlah pada tubuhmu kain kabung dan merataplah di depan mayat Abner.\" Raja Daud sendiripun berjalan di belakang usungan mayat."
 },
 {
   "id": 8116,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 32,
   "firman": "Ketika orang menguburkan Abner di Hebron, maka menangislah raja dengan suara nyaring pada kubur Abner dan seluruh rakyatpun menangis."
 },
 {
   "id": 8117,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 33,
   "firman": "Karena Abner raja mengucapkan nyanyian ratapan ini: \"Apakah Abner harus mati seperti orang bebal?"
 },
 {
   "id": 8118,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 34,
   "firman": "Tanganmu tidak terikat dan kakimu tidak dirantai. Engkau gugur seperti orang gugur oleh orang-orang durjana.\" Dan seluruh rakyat itu makin menangis karena dia."
 },
 {
   "id": 8119,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 35,
   "firman": "Seluruh rakyat datang menawarkan kepada Daud untuk makan roti selagi hari siang, tetapi Daud bersumpah, katanya: \"Kiranya Allah menghukum aku, bahkan lebih lagi dari pada itu, jika sebelum matahari terbenam aku mengecap roti atau apapun.\""
 },
 {
   "id": 8120,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 36,
   "firman": "Ketika seluruh rakyat melihat hal itu, mereka menganggap hal itu baik, seperti segala sesuatu yang dilakukan raja dianggap baik oleh seluruh rakyat."
 },
 {
   "id": 8121,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 37,
   "firman": "Maka tahulah seluruh rakyat dan seluruh Israel pada hari itu, bahwa pembunuhan Abner bin Ner bukanlah rancangan raja."
 },
 {
   "id": 8122,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 38,
   "firman": "Kemudian berkatalah raja kepada para pegawainya: \"Tidak tahukah kamu, bahwa pada hari ini gugur seorang pemimpin, seorang besar, di Israel?"
 },
 {
   "id": 8123,
   "kitab": "2Sa",
   "pasal": 3,
   "ayat": 39,
   "firman": "Tetapi aku ini sekarang masih lemah, sekalipun sudah diurapi menjadi raja, sedang orang-orang itu, yakni anak-anak Zeruya, melebihi aku dalam kekerasan. Kiranya TUHAN membalas kepada orang yang berbuat jahat setimpal dengan kejahatannya.\""
 },
 {
   "id": 8124,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ketika didengar anak Saul, bahwa Abner sudah mati di Hebron, maka hilanglah keberaniannya, dan terkejutlah seluruh orang Israel."
 },
 {
   "id": 8125,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 2,
   "firman": "Anak Saul mempunyai dua orang sebagai kepala gerombolan, yang satu bernama Baana dan yang kedua bernama Rekhab, keduanya anak Rimon, orang Benyamin dari Beerot. --Sebab Beerotpun terhitung daerah Benyamin."
 },
 {
   "id": 8126,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 3,
   "firman": "Orang Beerot sudah melarikan diri ke Gitaim dan menjadi pendatang di sana sampai sekarang. --"
 },
 {
   "id": 8127,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 4,
   "firman": "Yonatan, anak Saul, mempunyai seorang anak laki-laki, yang cacat kakinya. Ia berumur lima tahun, ketika datang kabar tentang Saul dan Yonatan dari Yizreel. Inang pengasuhnya mengangkat dia pada waktu itu, lalu lari, tetapi karena terburu-buru larinya, anak itu jatuh dan menjadi timpang. Ia bernama Mefiboset."
 },
 {
   "id": 8128,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 5,
   "firman": "Anak-anak Rimon, orang Beerot itu, yakni Rekhab dan Baana, pergi, lalu sampai pada waktu hari panas terik ke rumah Isyboset, ketika ia sedang berbaring siang hari."
 },
 {
   "id": 8129,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 6,
   "firman": "Kebetulan penjaga pintu rumah itu mengantuk dan tertidur, ketika sedang membersihkan gandum. Demikianlah Rekhab dan Baana menyusup ke dalam."
 },
 {
   "id": 8130,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 7,
   "firman": "Mereka masuk ke dalam rumah itu, ketika Isyboset sedang berbaring di atas tempat tidurnya di dalam kamar tidurnya, membunuh dia lalu memenggal kepalanya. Mereka membawa kepalanya itu, lalu berjalan semalam-malaman melalui jalan dari Araba-Yordan."
 },
 {
   "id": 8131,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 8,
   "firman": "Kepala Isyboset itu dibawa mereka kepada Daud di Hebron dan mereka berkata kepada raja: \"Inilah kepala Isyboset, anak Saul, musuhmu itu, yang ingin mencabut nyawamu; TUHAN pada hari ini telah membiarkan tuanku raja mengadakan pembalasan atas Saul dan atas keturunannya.\""
 },
 {
   "id": 8132,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tetapi Daud menjawab Rekhab dan Baana, saudaranya, anak-anak Rimon, orang Beerot itu, katanya kepada mereka: \"Demi TUHAN yang hidup, yang telah membebaskan nyawaku dari segala kesesakan!"
 },
 {
   "id": 8133,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 10,
   "firman": "Ketika ada orang yang membawa kabar kepadaku demikian: Saul sudah mati! dan memandang dirinya sebagai orang yang menyampaikan kabar baik, maka aku menangkap dan membunuh dia di Ziklag, dan dengan demikian aku memberikan kepadanya upah kabarnya;"
 },
 {
   "id": 8134,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 11,
   "firman": "terlebih lagi sekarang, setelah orang-orang fasik membunuh seorang yang benar, di rumahnya di atas tempat tidurnya, tidakkah aku menuntut darahnya dari pada kamu dan melenyapkan kamu dari muka bumi?\""
 },
 {
   "id": 8135,
   "kitab": "2Sa",
   "pasal": 4,
   "ayat": 12,
   "firman": "Sesudah itu Daud memberi perintah kepada anak buahnya untuk membunuh mereka; tangan dan kaki mereka dipotong, kemudian mayat mereka digantung di tepi telaga di Hebron. Tetapi kepala Isyboset diambil dan dikuburkan di dalam kubur Abner di Hebron."
 },
 {
   "id": 8136,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 1,
   "firman": "Lalu datanglah segala suku Israel kepada Daud di Hebron dan berkata: \"Ketahuilah, kami ini darah dagingmu."
 },
 {
   "id": 8137,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 2,
   "firman": "Telah lama, ketika Saul memerintah atas kami, engkaulah yang memimpin segala gerakan orang Israel. Dan TUHAN telah berfirman kepadamu: Engkaulah yang harus menggembalakan umat-Ku Israel, dan engkaulah yang menjadi raja atas Israel.\""
 },
 {
   "id": 8138,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 3,
   "firman": "Maka datanglah semua tua-tua Israel menghadap raja di Hebron, lalu raja Daud mengadakan perjanjian dengan mereka di Hebron di hadapan TUHAN; kemudian mereka mengurapi Daud menjadi raja atas Israel."
 },
 {
   "id": 8139,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 4,
   "firman": "Daud berumur tiga puluh tahun, pada waktu ia menjadi raja; empat puluh tahun lamanya ia memerintah."
 },
 {
   "id": 8140,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 5,
   "firman": "Di Hebron ia memerintah atas Yehuda tujuh tahun enam bulan, dan di Yerusalem ia memerintah tiga puluh tiga tahun atas seluruh Israel dan Yehuda."
 },
 {
   "id": 8141,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 6,
   "firman": "Lalu raja dengan orang-orangnya pergi ke Yerusalem, menyerang orang Yebus, penduduk negeri itu. Mereka itu berkata kepada Daud: \"Engkau tidak sanggup masuk ke mari; orang-orang buta dan orang-orang timpang akan mengenyahkan engkau!\" Maksud mereka: Daud tidak sanggup masuk ke mari."
 },
 {
   "id": 8142,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 7,
   "firman": "Tetapi Daud merebut kubu pertahanan Sion, yaitu kota Daud."
 },
 {
   "id": 8143,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 8,
   "firman": "Daud telah berkata pada waktu itu: \"Siapa yang hendak memukul kalah orang Yebus, haruslah ia masuk melalui saluran air itu; hati Daud benci kepada orang-orang timpang dan orang-orang buta.\" Sebab itu orang berkata: \"Orang-orang buta dan orang-orang timpang tidak boleh masuk bait.\""
 },
 {
   "id": 8144,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dan Daud menetap di kubu pertahanan itu dan menamainya: Kota Daud. Ia memperkuatnya sekelilingnya, mulai dari Milo ke bagian dalam."
 },
 {
   "id": 8145,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 10,
   "firman": "Lalu makin lama makin besarlah kuasa Daud, sebab TUHAN, Allah semesta alam, menyertainya."
 },
 {
   "id": 8146,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 11,
   "firman": "Hiram, raja negeri Tirus, mengirim utusan kepada Daud dan kayu alas, tukang-tukang kayu dan tukang-tukang batu; mereka mendirikan istana bagi Daud."
 },
 {
   "id": 8147,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 12,
   "firman": "Lalu tahulah Daud, bahwa TUHAN telah menegakkan dia sebagai raja atas Israel dan telah mengangkat martabat pemerintahannya oleh karena Israel, umat-Nya."
 },
 {
   "id": 8148,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 13,
   "firman": "Daud mengambil lagi beberapa gundik dan isteri dari Yerusalem, setelah ia datang dari Hebron dan bagi Daud masih lahir lagi anak-anak lelaki dan perempuan."
 },
 {
   "id": 8149,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 14,
   "firman": "Inilah nama anak-anak yang lahir bagi dia di Yerusalem: Syamua, Sobab, Natan, Salomo,"
 },
 {
   "id": 8150,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 15,
   "firman": "Yibhar, Elisua, Nefeg, Yafia,"
 },
 {
   "id": 8151,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 16,
   "firman": "Elisama, Elyada dan Elifelet."
 },
 {
   "id": 8152,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 17,
   "firman": "Ketika didengar orang Filistin, bahwa Daud telah diurapi menjadi raja atas Israel, maka majulah semua orang Filistin untuk menangkap Daud. Tetapi Daud mendengar hal itu, lalu ia pergi ke kubu pertahanan."
 },
 {
   "id": 8153,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 18,
   "firman": "Ketika orang Filistin itu datang dan memencar di lembah Refaim,"
 },
 {
   "id": 8154,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 19,
   "firman": "bertanyalah Daud kepada TUHAN: \"Apakah aku harus maju melawan orang Filistin itu? Akan Kauserahkankah mereka ke dalam tanganku?\" TUHAN menjawab Daud: \"Majulah, sebab Aku pasti akan menyerahkan orang Filistin itu ke dalam tanganmu.\""
 },
 {
   "id": 8155,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 20,
   "firman": "Lalu datanglah Daud di Baal-Perasim dan memukul mereka kalah di sana. Berkatalah ia: \"TUHAN telah menerobos musuhku di depanku seperti air menerobos.\" Sebab itu orang menamakan tempat itu Baal-Perasim."
 },
 {
   "id": 8156,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 21,
   "firman": "Orang Filistin itu meninggalkan berhalanya di sana, lalu Daud dan orang-orangnya mengangkatnya."
 },
 {
   "id": 8157,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 22,
   "firman": "Ketika orang Filistin maju sekali lagi dan memencar di lembah Refaim,"
 },
 {
   "id": 8158,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 23,
   "firman": "maka bertanyalah Daud kepada TUHAN, dan Ia menjawab: \"Janganlah maju, tetapi buatlah gerakan lingkaran sampai ke belakang mereka, sehingga engkau dapat menyerang mereka dari jurusan pohon-pohon kertau."
 },
 {
   "id": 8159,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 24,
   "firman": "Dan bila engkau mendengar bunyi derap langkah di puncak pohon-pohon kertau itu, maka haruslah engkau bertindak cepat, sebab pada waktu itu TUHAN telah keluar berperang di depanmu untuk memukul kalah tentara orang Filistin.\""
 },
 {
   "id": 8160,
   "kitab": "2Sa",
   "pasal": 5,
   "ayat": 25,
   "firman": "Dan Daud berbuat demikian, seperti yang diperintahkan TUHAN kepadanya, maka ia memukul kalah orang Filistin, mulai dari Geba sampai dekat Gezer."
 },
 {
   "id": 8161,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 1,
   "firman": "Daud mengumpulkan pula semua orang pilihan di antara orang Israel, tiga puluh ribu orang banyaknya."
 },
 {
   "id": 8162,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 2,
   "firman": "Kemudian bersiaplah Daud, lalu berjalan dari Baale-Yehuda dengan seluruh rakyat yang menyertainya, untuk mengangkut dari sana tabut Allah, yang disebut dengan nama TUHAN semesta alam yang bertakhta di atas kerubim."
 },
 {
   "id": 8163,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 3,
   "firman": "Mereka menaikkan tabut Allah itu ke dalam kereta yang baru setelah mengangkatnya dari rumah Abinadab yang di atas bukit. Lalu Uza dan Ahyo, anak-anak Abinadab, mengantarkan kereta itu."
 },
 {
   "id": 8164,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 4,
   "firman": "Uza berjalan di samping tabut Allah itu, sedang Ahyo berjalan di depan tabut itu."
 },
 {
   "id": 8165,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 5,
   "firman": "Daud dan seluruh kaum Israel menari-nari di hadapan TUHAN dengan sekuat tenaga, diiringi nyanyian, kecapi, gambus, rebana, kelentung dan ceracap."
 },
 {
   "id": 8166,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 6,
   "firman": "Ketika mereka sampai ke tempat pengirikan Nakhon, maka Uza mengulurkan tangannya kepada tabut Allah itu, lalu memegangnya, karena lembu-lembu itu tergelincir."
 },
 {
   "id": 8167,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 7,
   "firman": "Maka bangkitlah murka TUHAN terhadap Uza, lalu Allah membunuh dia di sana karena keteledorannya itu; ia mati di sana dekat tabut Allah itu."
 },
 {
   "id": 8168,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 8,
   "firman": "Daud menjadi marah, karena TUHAN telah menyambar Uza demikian hebatnya; maka tempat itu disebut orang Peres-Uza sampai sekarang."
 },
 {
   "id": 8169,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 9,
   "firman": "Pada waktu itu Daud menjadi takut kepada TUHAN, lalu katanya: \"Bagaimana tabut TUHAN itu dapat sampai kepadaku?\""
 },
 {
   "id": 8170,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 10,
   "firman": "Sebab itu Daud tidak mau memindahkan tabut TUHAN itu ke tempatnya, ke kota Daud, tetapi Daud menyimpang dan membawanya ke rumah Obed-Edom, orang Gat itu."
 },
 {
   "id": 8171,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 11,
   "firman": "Tiga bulan lamanya tabut Tuhan itu tinggal di rumah Obed-Edom, orang Gat itu, dan TUHAN memberkati Obed-Edom dan seisi rumahnya."
 },
 {
   "id": 8172,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 12,
   "firman": "Diberitahukanlah kepada raja Daud, demikian: \"TUHAN memberkati seisi rumah Obed-Edom dan segala yang ada padanya oleh karena tabut Allah itu.\" Lalu Daud pergi mengangkut tabut Allah itu dari rumah Obed-Edom ke kota Daud dengan sukacita."
 },
 {
   "id": 8173,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 13,
   "firman": "Apabila pengangkat-pengangkat tabut TUHAN itu melangkah maju enam langkah, maka ia mengorbankan seekor lembu dan seekor anak lembu gemukan."
 },
 {
   "id": 8174,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 14,
   "firman": "Dan Daud menari-nari di hadapan TUHAN dengan sekuat tenaga; ia berbaju efod dari kain lenan."
 },
 {
   "id": 8175,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 15,
   "firman": "Daud dan seluruh orang Israel mengangkut tabut TUHAN itu dengan diiringi sorak dan bunyi sangkakala."
 },
 {
   "id": 8176,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 16,
   "firman": "Ketika tabut TUHAN itu masuk ke kota Daud, maka Mikhal, anak perempuan Saul, menjenguk dari jendela, lalu melihat raja Daud meloncat-loncat serta menari-nari di hadapan TUHAN. Sebab itu ia memandang rendah Daud dalam hatinya."
 },
 {
   "id": 8177,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 17,
   "firman": "Tabut TUHAN itu dibawa masuk, lalu diletakkan di tempatnya, di dalam kemah yang dibentangkan Daud untuk itu, kemudian Daud mempersembahkan korban bakaran dan korban keselamatan di hadapan TUHAN."
 },
 {
   "id": 8178,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 18,
   "firman": "Setelah Daud selesai mempersembahkan korban bakaran dan korban keselamatan, diberkatinyalah bangsa itu demi nama TUHAN semesta alam."
 },
 {
   "id": 8179,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 19,
   "firman": "Lalu dibagikannya kepada seluruh bangsa itu, kepada seluruh khalayak ramai Israel, baik laki-laki maupun perempuan, kepada masing-masing seketul roti bundar, sekerat daging, dan sepotong kue kismis. Sesudah itu pergilah seluruh bangsa itu, masing-masing ke rumahnya."
 },
 {
   "id": 8180,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 20,
   "firman": "Ketika Daud pulang untuk memberi salam kepada seisi rumahnya, maka keluarlah Mikhal binti Saul mendapatkan Daud, katanya: \"Betapa raja orang Israel, yang menelanjangi dirinya pada hari ini di depan mata budak-budak perempuan para hambanya, merasa dirinya terhormat pada hari ini, seperti orang hina dengan tidak malu-malu menelanjangi dirinya!\""
 },
 {
   "id": 8181,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 21,
   "firman": "Tetapi berkatalah Daud kepada Mikhal: \"Di hadapan TUHAN, yang telah memilih aku dengan menyisihkan ayahmu dan segenap keluarganya untuk menunjuk aku menjadi raja atas umat TUHAN, yakni atas Israel, --di hadapan TUHAN aku menari-nari,"
 },
 {
   "id": 8182,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 22,
   "firman": "bahkan aku akan menghinakan diriku lebih dari pada itu; engkau akan memandang aku rendah, tetapi bersama-sama budak-budak perempuan yang kaukatakan itu, bersama-sama merekalah aku mau dihormati.\""
 },
 {
   "id": 8183,
   "kitab": "2Sa",
   "pasal": 6,
   "ayat": 23,
   "firman": "Mikhal binti Saul tidak mendapat anak sampai hari matinya."
 },
 {
   "id": 8184,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 1,
   "firman": "Ketika raja telah menetap di rumahnya dan TUHAN telah mengaruniakan keamanan kepadanya terhadap semua musuhnya di sekeliling,"
 },
 {
   "id": 8185,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 2,
   "firman": "berkatalah raja kepada nabi Natan: \"Lihatlah, aku ini diam dalam rumah dari kayu aras, padahal tabut Allah diam di bawah tenda.\""
 },
 {
   "id": 8186,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 3,
   "firman": "Lalu berkatalah Natan kepada raja: \"Baik, lakukanlah segala sesuatu yang dikandung hatimu, sebab TUHAN menyertai engkau.\""
 },
 {
   "id": 8187,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 4,
   "firman": "Tetapi pada malam itu juga datanglah firman TUHAN kepada Natan, demikian:"
 },
 {
   "id": 8188,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 5,
   "firman": "\"Pergilah, katakanlah kepada hamba-Ku Daud: Beginilah firman TUHAN: Masakan engkau yang mendirikan rumah bagi-Ku untuk Kudiami?"
 },
 {
   "id": 8189,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 6,
   "firman": "Aku tidak pernah diam dalam rumah sejak Aku menuntun orang Israel dari Mesir sampai hari ini, tetapi Aku selalu mengembara dalam kemah sebagai kediaman."
 },
 {
   "id": 8190,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 7,
   "firman": "Selama Aku mengembara bersama-sama seluruh orang Israel, pernahkah Aku mengucapkan firman kepada salah seorang hakim orang Israel, yang Kuperintahkan menggembalakan umat-Ku Israel, demikian: Mengapa kamu tidak mendirikan bagi-Ku rumah dari kayu aras?"
 },
 {
   "id": 8191,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 8,
   "firman": "Oleh sebab itu, beginilah kaukatakan kepada hamba-Ku Daud: Beginilah firman TUHAN semesta alam: Akulah yang mengambil engkau dari padang, ketika menggiring kambing domba, untuk menjadi raja atas umat-Ku Israel."
 },
 {
   "id": 8192,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 9,
   "firman": "Aku telah menyertai engkau di segala tempat yang kaujalani dan telah melenyapkan segala musuhmu dari depanmu. Aku membuat besar namamu seperti nama orang-orang besar yang ada di bumi."
 },
 {
   "id": 8193,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 10,
   "firman": "Aku menentukan tempat bagi umat-Ku Israel dan menanamkannya, sehingga ia dapat diam di tempatnya sendiri dengan tidak lagi dikejutkan dan tidak pula ditindas oleh orang-orang lalim seperti dahulu,"
 },
 {
   "id": 8194,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 11,
   "firman": "sejak Aku mengangkat hakim-hakim atas umat-Ku Israel. Aku mengaruniakan keamanan kepadamu dari pada semua musuhmu. Juga diberitahukan TUHAN kepadamu: TUHAN akan memberikan keturunan kepadamu."
 },
 {
   "id": 8195,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 12,
   "firman": "Apabila umurmu sudah genap dan engkau telah mendapat perhentian bersama-sama dengan nenek moyangmu, maka Aku akan membangkitkan keturunanmu yang kemudian, anak kandungmu, dan Aku akan mengokohkan kerajaannya."
 },
 {
   "id": 8196,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 13,
   "firman": "Dialah yang akan mendirikan rumah bagi nama-Ku dan Aku akan mengokohkan takhta kerajaannya untuk selama-lamanya."
 },
 {
   "id": 8197,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 14,
   "firman": "Aku akan menjadi Bapanya, dan ia akan menjadi anak-Ku. Apabila ia melakukan kesalahan, maka Aku akan menghukum dia dengan rotan yang dipakai orang dan dengan pukulan yang diberikan anak-anak manusia."
 },
 {
   "id": 8198,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 15,
   "firman": "Tetapi kasih setia-Ku tidak akan hilang dari padanya, seperti yang Kuhilangkan dari pada Saul, yang telah Kujauhkan dari hadapanmu."
 },
 {
   "id": 8199,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 16,
   "firman": "Keluarga dan kerajaanmu akan kokoh untuk selama-lamanya di hadapan-Ku, takhtamu akan kokoh untuk selama-lamanya.\""
 },
 {
   "id": 8200,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 17,
   "firman": "Tepat seperti perkataan ini dan tepat seperti penglihatan ini Natan berbicara kepada Daud."
 },
 {
   "id": 8201,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 18,
   "firman": "Lalu masuklah raja Daud ke dalam, kemudian duduklah ia di hadapan TUHAN sambil berkata: \"Siapakah aku ini, ya Tuhan ALLAH, dan siapakah keluargaku, sehingga Engkau membawa aku sampai sedemikian ini?"
 },
 {
   "id": 8202,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 19,
   "firman": "Dan hal ini masih kurang di mata-Mu, ya Tuhan ALLAH; sebab itu Engkau telah berfirman juga tentang keluarga hamba-Mu ini dalam masa yang masih jauh dan telah memperlihatkan kepadaku serentetan manusia yang akan datang, ya Tuhan ALLAH."
 },
 {
   "id": 8203,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 20,
   "firman": "Apakah yang dapat dikatakan Daud kepada-Mu lebih lagi dari pada itu. Bukankah Engkau yang mengenal hamba-Mu ini, ya Tuhan ALLAH?"
 },
 {
   "id": 8204,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 21,
   "firman": "Oleh karena firman-Mu dan menurut hati-Mu Engkau telah melakukan segala perkara yang besar ini dengan memberitahukannya kepada hamba-Mu ini."
 },
 {
   "id": 8205,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 22,
   "firman": "Sebab itu Engkau besar, ya Tuhan ALLAH, sebab tidak ada yang sama seperti Engkau dan tidak ada Allah selain Engkau menurut segala yang kami tangkap dengan telinga kami."
 },
 {
   "id": 8206,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 23,
   "firman": "Dan bangsa manakah di bumi seperti umat-Mu Israel, yang Allahnya pergi membebaskannya menjadi umat-Nya, untuk mendapat nama bagi-Nya dengan melakukan perbuatan-perbuatan yang besar dan dahsyat bagi mereka, dan dengan menghalau bangsa-bangsa dan para allah mereka dari depan umat-Nya?"
 },
 {
   "id": 8207,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 24,
   "firman": "Engkau telah mengokohkan bagi-Mu umat-Mu Israel menjadi umat-Mu untuk selama-lamanya, dan Engkau, ya TUHAN, menjadi Allah mereka."
 },
 {
   "id": 8208,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 25,
   "firman": "Dan sekarang, ya TUHAN Allah, tepatilah untuk selama-lamanya janji yang Kauucapkan mengenai hamba-Mu ini dan mengenai keluarganya dan lakukanlah seperti yang Kaujanjikan itu."
 },
 {
   "id": 8209,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 26,
   "firman": "Maka nama-Mu akan menjadi besar untuk selama-lamanya, sehingga orang berkata: TUHAN semesta alam ialah Allah atas Israel; maka keluarga hamba-Mu Daud akan tetap kokoh di hadapan-Mu."
 },
 {
   "id": 8210,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 27,
   "firman": "Sebab Engkau, TUHAN semesta alam, Allah Israel, telah menyatakan kepada hamba-Mu ini, demikian: Aku akan membangun keturunan bagimu. Itulah sebabnya hamba-Mu ini telah memberanikan diri untuk memanjatkan doa ini kepada-Mu."
 },
 {
   "id": 8211,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 28,
   "firman": "Oleh sebab itu, ya Tuhan ALLAH, Engkaulah Allah dan segala firman-Mulah kebenaran; Engkau telah menjanjikan perkara yang baik ini kepada hamba-Mu."
 },
 {
   "id": 8212,
   "kitab": "2Sa",
   "pasal": 7,
   "ayat": 29,
   "firman": "Kiranya Engkau sekarang berkenan memberkati keluarga hamba-Mu ini, supaya tetap ada di hadapan-Mu untuk selama-lamanya. Sebab, ya Tuhan ALLAH, Engkau sendirilah yang berfirman dan oleh karena berkat-Mu keluarga hamba-Mu ini diberkati untuk selama-lamanya.\""
 },
 {
   "id": 8213,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 1,
   "firman": "Sesudah itu Daud memukul kalah orang Filistin dan menundukkan mereka; lalu Daud mengambil kendali pemerintahan atas ibu kota dari tangan orang Filistin."
 },
 {
   "id": 8214,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 2,
   "firman": "Dan ia memukul kalah orang Moab, lalu sambil menyuruh mereka berbaring di tanah ia mengukur tempat mereka dengan tali; diukurnya dua kali panjang tali itu untuk mematikan dan satu tali penuh untuk membiarkan hidup. Maka orang Moab takluk kepada Daud dan harus mempersembahkan upeti."
 },
 {
   "id": 8215,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 3,
   "firman": "Selanjutnya Daud memukul kalah Hadadezer bin Rehob, raja Zoba, ketika ia pergi memulihkan kekuasaannya pada sungai Efrat."
 },
 {
   "id": 8216,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 4,
   "firman": "Daud menawan dari padanya seribu tujuh ratus orang pasukan berkuda dan dua puluh ribu orang pasukan berjalan kaki, lalu Daud menyuruh memotong urat keting segala kuda kereta, tetapi dengan meninggalkan seratus ekor kuda kereta."
 },
 {
   "id": 8217,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 5,
   "firman": "Lalu orang Aram dari Damsyik datang menolong Hadadezer, raja Zoba, tetapi dari antara orang Aram itu Daud menewaskan dua puluh dua ribu orang."
 },
 {
   "id": 8218,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 6,
   "firman": "Kemudian Daud menempatkan pasukan-pasukan pendudukan di daerah orang Aram dari Damsyik. Orang Aram itu takluk kepada Daud dan harus mempersembahkan upeti. TUHAN memberi kemenangan kepada Daud ke manapun ia pergi berperang."
 },
 {
   "id": 8219,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sesudah itu Daud mengangkut perisai-perisai emas yang dipakai oleh anak buah Hadadezer, lalu membawanya ke Yerusalem."
 },
 {
   "id": 8220,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 8,
   "firman": "Dan dari Betah dan dari Berotai, yaitu kota-kotanya Hadadezer, raja Daud mengangkut amat banyak tembaga."
 },
 {
   "id": 8221,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 9,
   "firman": "Ketika didengar Tou, raja Hamat, bahwa Daud telah memukul kalah seluruh tentara Hadadezer,"
 },
 {
   "id": 8222,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 10,
   "firman": "maka Tou mengutus Yoram, anaknya, kepada raja Daud untuk menyampaikan salam dan mengucapkan selamat kepadanya, karena ia telah berperang melawan Hadadezer dan memukul dia kalah, sebab Hadadezer sering memerangi Tou. Dan Yoram membawa barang-barang perak, emas dan tembaga."
 },
 {
   "id": 8223,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 11,
   "firman": "Juga barang-barang ini dikhususkan raja Daud bagi TUHAN, bersama-sama perak dan emas yang berasal dari segala bangsa yang ditaklukkannya,"
 },
 {
   "id": 8224,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 12,
   "firman": "yakni perak dan emas dari orang Aram, dari orang Moab, dari bani Amon, dari orang Filistin, dari orang Amalek, dan dari jarahan yang dirampas dari Hadadezer bin Rehob, raja Zoba."
 },
 {
   "id": 8225,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 13,
   "firman": "Demikianlah Daud mendapat nama, dan ketika ia pulang, ia menewaskan delapan belas ribu orang Edom di Lembah Asin."
 },
 {
   "id": 8226,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 14,
   "firman": "Lalu ia menempatkan pasukan-pasukan pendudukan di Edom; di seluruh Edom ditempatkannya pasukan-pasukan pendudukan, sehingga seluruh Edom diperbudak oleh Daud. TUHAN memberi kemenangan kepada Daud ke manapun ia pergi berperang."
 },
 {
   "id": 8227,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 15,
   "firman": "Demikianlah Daud telah memerintah atas seluruh Israel, dan menegakkan keadilan dan kebenaran bagi seluruh bangsanya."
 },
 {
   "id": 8228,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 16,
   "firman": "Yoab, anak Zeruya, menjadi panglima; Yosafat bin Ahilud menjadi bendahara negara;"
 },
 {
   "id": 8229,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 17,
   "firman": "Zadok bin Ahitub dan Ahimelekh bin Abyatar menjadi imam; Seraya menjadi panitera negara;"
 },
 {
   "id": 8230,
   "kitab": "2Sa",
   "pasal": 8,
   "ayat": 18,
   "firman": "Benaya bin Yoyada menjadi panglima orang Kreti dan orang Pleti; dan anak-anak Daud menjadi imam."
 },
 {
   "id": 8231,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 1,
   "firman": "Berkatalah Daud: \"Masih adakah orang yang tinggal dari keluarga Saul? Maka aku akan menunjukkan kasihku kepadanya oleh karena Yonatan.\""
 },
 {
   "id": 8232,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 2,
   "firman": "Adapun keluarga Saul mempunyai seorang hamba, yang bernama Ziba. Ia dipanggil menghadap Daud, lalu raja bertanya kepadanya: \"Engkaukah Ziba?\" Jawabnya: \"Hamba tuanku.\""
 },
 {
   "id": 8233,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 3,
   "firman": "Kemudian berkatalah raja: \"Tidak adakah lagi orang yang tinggal dari keluarga Saul? Aku hendak menunjukkan kepadanya kasih yang dari Allah.\" Lalu berkatalah Ziba kepada raja: \"Masih ada seorang anak laki-laki Yonatan, yang cacat kakinya.\""
 },
 {
   "id": 8234,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 4,
   "firman": "Tanya raja kepadanya: \"Di manakah ia?\" Jawab Ziba kepada raja: \"Dia ada di rumah Makhir bin Amiel, di Lodebar.\""
 },
 {
   "id": 8235,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 5,
   "firman": "Sesudah itu raja Daud menyuruh mengambil dia dari rumah Makhir bin Amiel, dari Lodebar."
 },
 {
   "id": 8236,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 6,
   "firman": "Dan Mefiboset bin Yonatan bin Saul masuk menghadap Daud, ia sujud dan menyembah. Kata Daud: \"Mefiboset!\" Jawabnya: \"Inilah hamba tuanku.\""
 },
 {
   "id": 8237,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 7,
   "firman": "Kemudian berkatalah Daud kepadanya: \"Janganlah takut, sebab aku pasti akan menunjukkan kasihku kepadamu oleh karena Yonatan, ayahmu; aku akan mengembalikan kepadamu segala ladang Saul, nenekmu, dan engkau akan tetap makan sehidangan dengan aku.\""
 },
 {
   "id": 8238,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 8,
   "firman": "Lalu sujudlah Mefiboset dan berkata: \"Apakah hambamu ini, sehingga engkau menghiraukan anjing mati seperti aku?\""
 },
 {
   "id": 8239,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 9,
   "firman": "Lalu raja memanggil Ziba, hamba Saul itu, dan berkata kepadanya: \"Segala sesuatu yang adalah milik Saul dan milik seluruh keluarganya kuberikan kepada cucu tuanmu itu."
 },
 {
   "id": 8240,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 10,
   "firman": "Engkau harus mengerjakan tanah baginya, engkau, anak-anakmu dan hamba-hambamu, dan harus membawa masuk tuaiannya, supaya cucu tuanmu itu ada makanannya. Mefiboset, cucu tuanmu itu, akan tetap makan sehidangan dengan aku.\" Ziba mempunyai lima belas orang anak laki-laki dan dua puluh orang hamba."
 },
 {
   "id": 8241,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 11,
   "firman": "Berkatalah Ziba kepada raja: \"Hambamu ini akan melakukan tepat seperti yang diperintahkan tuanku raja kepadanya.\" Dan Mefiboset makan sehidangan dengan Daud sebagai salah seorang anak raja."
 },
 {
   "id": 8242,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 12,
   "firman": "Mefiboset mempunyai seorang anak laki-laki yang kecil, yang bernama Mikha. Semua orang yang diam di rumah Ziba adalah hamba-hamba Mefiboset."
 },
 {
   "id": 8243,
   "kitab": "2Sa",
   "pasal": 9,
   "ayat": 13,
   "firman": "Demikianlah Mefiboset diam di Yerusalem, sebab ia tetap makan sehidangan dengan raja. Adapun kedua kakinya timpang."
 },
 {
   "id": 8244,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 1,
   "firman": "Sesudah itu matilah raja bani Amon; dan Hanun, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 8245,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 2,
   "firman": "Lalu berkatalah Daud: \"Aku akan menunjukkan persahabatan kepada Hanun bin Nahas, sama seperti ayahnya telah menunjukkan persahabatan kepadaku.\" Sebab itu Daud menyuruh menyampaikan pesan turut berdukacita kepadanya dengan perantaraan pegawai-pegawainya karena kematian ayahnya. Tetapi ketika pegawai-pegawai Daud sampai ke negeri bani Amon itu,"
 },
 {
   "id": 8246,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 3,
   "firman": "berkatalah pemuka-pemuka bani Amon itu kepada Hanun, tuan mereka: \"Apakah menurut anggapanmu Daud hendak menghormati ayahmu, karena ia telah mengutus kepadamu orang-orang yang menyampaikan pesan turut berdukacita? Bukankah dengan maksud untuk menyelidik kota ini, untuk mengintainya dan menghancurkannya maka Daud mengutus pegawai-pegawainya itu kepadamu?\""
 },
 {
   "id": 8247,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 4,
   "firman": "Lalu Hanun menyuruh menangkap pegawai-pegawai Daud itu, disuruhnya mencukur setengah dari janggut mereka dan memotong pakaian mereka pada bagian tengah sampai pantat mereka, kemudian dilepasnya mereka."
 },
 {
   "id": 8248,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 5,
   "firman": "Hal ini diberitahukan kepada Daud, lalu disuruhnya orang menemui mereka, sebab orang-orang itu sangat dipermalukan. Raja berkata: \"Tinggallah di Yerikho sampai janggutmu itu tumbuh, kemudian datanglah kembali.\""
 },
 {
   "id": 8249,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 6,
   "firman": "Setelah dilihat bani Amon, bahwa mereka dibenci Daud, maka bani Amon itu menyuruh orang menyewa dari orang Aram-Bet-Rehob dan orang Aram dari Zoba dua puluh ribu orang pasukan berjalan kaki, dari raja negeri Maakha seribu orang dan dari orang-orang Tob dua belas ribu orang."
 },
 {
   "id": 8250,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 7,
   "firman": "Ketika Daud mendengar hal itu, disuruhnyalah Yoab maju dengan segenap pasukan pahlawan."
 },
 {
   "id": 8251,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 8,
   "firman": "Lalu bani Amon maju, diaturnya barisan perangnya di depan pintu gerbang, sedang orang Aram dari Zoba dan dari Rehob dan orang-orang Tob dan Maakha ada tersendiri di padang."
 },
 {
   "id": 8252,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 9,
   "firman": "Ketika Yoab melihat, bahwa serangan itu mengancam dia dari depan dan dari belakang, maka dipilihnyalah sebagian dari orang pilihan Israel, lalu ia mengatur barisan mereka berhadapan dengan orang Aram itu."
 },
 {
   "id": 8253,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 10,
   "firman": "Selebihnya dari rakyat itu ditempatkannya di bawah pimpinan Abisai, adiknya, yang mengatur barisan mereka berhadapan dengan bani Amon itu."
 },
 {
   "id": 8254,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 11,
   "firman": "Lalu berkatalah Yoab: \"Jika orang Aram itu lebih kuat dari padaku, maka haruslah engkau menolong aku, tetapi jika bani Amon itu lebih kuat dari padamu, maka aku akan datang menolong engkau."
 },
 {
   "id": 8255,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 12,
   "firman": "Kuatkanlah hatimu dan marilah kita menguatkan hati untuk bangsa kita dan untuk kota-kota Allah kita. TUHAN kiranya melakukan yang baik di mata-Nya.\""
 },
 {
   "id": 8256,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 13,
   "firman": "Lalu Yoab dan tentara yang bersama-sama dengan dia maju berperang melawan orang Aram dan orang-orang itu melarikan diri dari hadapannya."
 },
 {
   "id": 8257,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 14,
   "firman": "Ketika bani Amon melihat, bahwa orang Aram sudah melarikan diri, maka merekapun larilah dari hadapan Abisai dan masuk ke dalam kota. Sesudah itu pulanglah Yoab setelah memerangi bani Amon dan sampailah ia ke Yerusalem."
 },
 {
   "id": 8258,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 15,
   "firman": "Ketika orang Aram melihat, bahwa mereka telah terpukul kalah oleh orang Israel, maka berkumpullah mereka bersama-sama."
 },
 {
   "id": 8259,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 16,
   "firman": "Juga Hadadezer menyuruh orang Aram yang di seberang sungai Efrat maju berperang; mereka sampai ke Helam di bawah pimpinan Sobakh, panglima tentara Hadadezer."
 },
 {
   "id": 8260,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 17,
   "firman": "Setelah hal itu diberitahukan kepada Daud, maka dikumpulkannya seluruh orang Israel, diseberanginya sungai Yordan, lalu sampai ke Helam. Orang Aram mengatur barisannya berhadapan dengan Daud dan bertempur melawan dia,"
 },
 {
   "id": 8261,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 18,
   "firman": "tetapi orang Aram itu lari dari hadapan orang Israel, dan Daud membunuh dari orang Aram itu tujuh ratus ekor kuda kereta dan empat puluh ribu orang pasukan berkuda. Sobakh, panglima tentara mereka, dilukainya sedemikian, hingga ia mati di sana."
 },
 {
   "id": 8262,
   "kitab": "2Sa",
   "pasal": 10,
   "ayat": 19,
   "firman": "Ketika dilihat semua raja, yang takluk kepada Hadadezer, bahwa mereka telah terpukul kalah oleh orang Israel, maka mereka mengadakan perdamaian dengan orang Israel dan takluk kepada mereka; sesudah itu takutlah orang Aram memberi pertolongan lagi kepada bani Amon."
 },
 {
   "id": 8263,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 1,
   "firman": "Pada pergantian tahun, pada waktu raja-raja biasanya maju berperang, maka Daud menyuruh Yoab maju beserta orang-orangnya dan seluruh orang Israel. Mereka memusnahkan bani Amon dan mengepung kota Raba, sedang Daud sendiri tinggal di Yerusalem."
 },
 {
   "id": 8264,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 2,
   "firman": "Sekali peristiwa pada waktu petang, ketika Daud bangun dari tempat pembaringannya, lalu berjalan-jalan di atas sotoh istana, tampak kepadanya dari atas sotoh itu seorang perempuan sedang mandi; perempuan itu sangat elok rupanya."
 },
 {
   "id": 8265,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 3,
   "firman": "Lalu Daud menyuruh orang bertanya tentang perempuan itu dan orang berkata: \"Itu adalah Batsyeba binti Eliam, isteri Uria orang Het itu.\""
 },
 {
   "id": 8266,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 4,
   "firman": "Sesudah itu Daud menyuruh orang mengambil dia. Perempuan itu datang kepadanya, lalu Daud tidur dengan dia. Perempuan itu baru selesai membersihkan diri dari kenajisannya. Kemudian pulanglah perempuan itu ke rumahnya."
 },
 {
   "id": 8267,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 5,
   "firman": "Lalu mengandunglah perempuan itu dan disuruhnya orang memberitahukan kepada Daud, demikian: \"Aku mengandung.\""
 },
 {
   "id": 8268,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 6,
   "firman": "Lalu Daud menyuruh orang kepada Yoab mengatakan: \"Suruhlah Uria, orang Het itu, datang kepadaku.\" Maka Yoab menyuruh Uria menghadap Daud."
 },
 {
   "id": 8269,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 7,
   "firman": "Ketika Uria masuk menghadap dia, bertanyalah Daud tentang keadaan Yoab dan tentara dan keadaan perang."
 },
 {
   "id": 8270,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 8,
   "firman": "Kemudian berkatalah Daud kepada Uria: \"Pergilah ke rumahmu dan basuhlah kakimu.\" Ketika Uria keluar dari istana, maka orang menyusul dia dengan membawa hadiah raja."
 },
 {
   "id": 8271,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 9,
   "firman": "Tetapi Uria membaringkan diri di depan pintu istana bersama-sama hamba tuannya dan tidak pergi ke rumahnya."
 },
 {
   "id": 8272,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 10,
   "firman": "Diberitahukan kepada Daud, demikian: \"Uria tidak pergi ke rumahnya.\" Lalu berkatalah Daud kepada Uria: \"Bukankah engkau baru pulang dari perjalanan? Mengapa engkau tidak pergi ke rumahmu?\""
 },
 {
   "id": 8273,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 11,
   "firman": "Tetapi Uria berkata kepada Daud: \"Tabut serta orang Israel dan orang Yehuda diam dalam pondok, juga tuanku Yoab dan hamba-hamba tuanku sendiri berkemah di padang; masakan aku pulang ke rumahku untuk makan minum dan tidur dengan isteriku? Demi hidupmu dan demi nyawamu, aku takkan melakukan hal itu!\""
 },
 {
   "id": 8274,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 12,
   "firman": "Kata Daud kepada Uria: \"Tinggallah hari ini di sini. Besok aku akan melepas engkau pergi.\" Jadi Uria tinggal di Yerusalem pada hari itu. Keesokan harinya"
 },
 {
   "id": 8275,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 13,
   "firman": "Daud memanggil dia untuk makan dan minum dengan dia, dan Daud membuatnya mabuk. Pada waktu malam keluarlah Uria untuk berbaring tidur di tempat tidurnya, bersama-sama hamba-hamba tuannya. Ia tidak pergi ke rumahnya."
 },
 {
   "id": 8276,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 14,
   "firman": "Paginya Daud menulis surat kepada Yoab dan mengirimkannya dengan perantaraan Uria."
 },
 {
   "id": 8277,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 15,
   "firman": "Ditulisnya dalam surat itu, demikian: \"Tempatkanlah Uria di barisan depan dalam pertempuran yang paling hebat, kemudian kamu mengundurkan diri dari padanya, supaya ia terbunuh mati.\""
 },
 {
   "id": 8278,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 16,
   "firman": "Pada waktu Yoab mengepung kota Raba, ia menyuruh Uria pergi ke tempat yang diketahuinya ada lawan yang gagah perkasa."
 },
 {
   "id": 8279,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 17,
   "firman": "Ketika orang-orang kota itu keluar menyerang dan berperang melawan Yoab, maka gugurlah beberapa orang dari tentara, dari anak buah Daud; juga Uria, orang Het itu, mati."
 },
 {
   "id": 8280,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 18,
   "firman": "Kemudian Yoab menyuruh orang memberitahukan kepada Daud jalannya pertempuran itu."
 },
 {
   "id": 8281,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 19,
   "firman": "Ia memerintahkan kepada suruhan itu, demikian: \"Jika engkau sudah selesai mengabarkan jalannya pertempuran itu kepada raja,"
 },
 {
   "id": 8282,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 20,
   "firman": "dan jikalau raja menjadi geram dan berkata kepadamu: Mengapa kamu demikian dekat ke kota itu untuk berperang? Tidakkah kamu tahu, bahwa orang akan memanah dari atas tembok?"
 },
 {
   "id": 8283,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 21,
   "firman": "Siapakah yang menewaskan Abimelekh bin Yerubeset? Bukankah seorang perempuan menimpakan batu kilangan kepadanya dari atas tembok, sehingga ia mati di Tebes? Mengapa kamu demikian dekat ke tembok itu? --maka haruslah engkau berkata: Juga hambamu Uria, orang Het itu, sudah mati.\""
 },
 {
   "id": 8284,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 22,
   "firman": "Lalu pergilah suruhan itu dan sesampainya ia memberitahukan kepada Daud segala yang diperintahkan Yoab kepadanya."
 },
 {
   "id": 8285,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 23,
   "firman": "Suruhan itu berkata kepada Daud: \"Orang-orang itu lebih kuat dari pada kami dan keluar menyerang kami di padang. Tetapi kami mendesak mereka kembali sampai ke lobang pintu gerbang."
 },
 {
   "id": 8286,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 24,
   "firman": "Pada waktu itu pemanah-pemanah menembak kepada hamba-hambamu dari atas tembok, sehingga beberapa dari hamba raja mati; juga hambamu Uria, orang Het itu, sudah mati.\""
 },
 {
   "id": 8287,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 25,
   "firman": "Kemudian berkatalah Daud kepada suruhan itu: \"Beginilah kaukatakan kepada Yoab: Janganlah sebal hatimu karena perkara ini, sebab sudah biasa pedang makan orang ini atau orang itu. Sebab itu perhebatlah seranganmu terhadap kota itu dan runtuhkanlah itu. Demikianlah kau harus kuatkan hatinya!\""
 },
 {
   "id": 8288,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 26,
   "firman": "Ketika didengar isteri Uria, bahwa Uria, suaminya, sudah mati, maka merataplah ia karena kematian suaminya itu."
 },
 {
   "id": 8289,
   "kitab": "2Sa",
   "pasal": 11,
   "ayat": 27,
   "firman": "Setelah lewat waktu berkabung, maka Daud menyuruh membawa perempuan itu ke rumahnya. Perempuan itu menjadi isterinya dan melahirkan seorang anak laki-laki baginya. Tetapi hal yang telah dilakukan Daud itu adalah jahat di mata TUHAN."
 },
 {
   "id": 8290,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 1,
   "firman": "TUHAN mengutus Natan kepada Daud. Ia datang kepada Daud dan berkata kepadanya: \"Ada dua orang dalam suatu kota: yang seorang kaya, yang lain miskin."
 },
 {
   "id": 8291,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 2,
   "firman": "Si kaya mempunyai sangat banyak kambing domba dan lembu sapi;"
 },
 {
   "id": 8292,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 3,
   "firman": "si miskin tidak mempunyai apa-apa, selain dari seekor anak domba betina yang kecil, yang dibeli dan dipeliharanya. Anak domba itu menjadi besar padanya bersama-sama dengan anak-anaknya, makan dari suapnya dan minum dari pialanya dan tidur di pangkuannya, seperti seorang anak perempuan baginya."
 },
 {
   "id": 8293,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 4,
   "firman": "Pada suatu waktu orang kaya itu mendapat tamu; dan ia merasa sayang mengambil seekor dari kambing dombanya atau lembunya untuk memasaknya bagi pengembara yang datang kepadanya itu. Jadi ia mengambil anak domba betina kepunyaan si miskin itu, dan memasaknya bagi orang yang datang kepadanya itu.\""
 },
 {
   "id": 8294,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 5,
   "firman": "Lalu Daud menjadi sangat marah karena orang itu dan ia berkata kepada Natan: \"Demi TUHAN yang hidup: orang yang melakukan itu harus dihukum mati."
 },
 {
   "id": 8295,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 6,
   "firman": "Dan anak domba betina itu harus dibayar gantinya empat kali lipat, karena ia telah melakukan hal itu dan oleh karena ia tidak kenal belas kasihan.\""
 },
 {
   "id": 8296,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 7,
   "firman": "Kemudian berkatalah Natan kepada Daud: \"Engkaulah orang itu! Beginilah firman TUHAN, Allah Israel: Akulah yang mengurapi engkau menjadi raja atas Israel dan Akulah yang melepaskan engkau dari tangan Saul."
 },
 {
   "id": 8297,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 8,
   "firman": "Telah Kuberikan isi rumah tuanmu kepadamu, dan isteri-isteri tuanmu ke dalam pangkuanmu. Aku telah memberikan kepadamu kaum Israel dan Yehuda; dan seandainya itu belum cukup, tentu Kutambah lagi ini dan itu kepadamu."
 },
 {
   "id": 8298,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 9,
   "firman": "Mengapa engkau menghina TUHAN dengan melakukan apa yang jahat di mata-Nya? Uria, orang Het itu, kaubiarkan ditewaskan dengan pedang; isterinya kauambil menjadi isterimu, dan dia sendiri telah kaubiarkan dibunuh oleh pedang bani Amon."
 },
 {
   "id": 8299,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 10,
   "firman": "Oleh sebab itu, pedang tidak akan menyingkir dari keturunanmu sampai selamanya, karena engkau telah menghina Aku dan mengambil isteri Uria, orang Het itu, untuk menjadi isterimu."
 },
 {
   "id": 8300,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 11,
   "firman": "Beginilah firman TUHAN: Bahwasanya malapetaka akan Kutimpakan ke atasmu yang datang dari kaum keluargamu sendiri. Aku akan mengambil isteri-isterimu di depan matamu dan memberikannya kepada orang lain; orang itu akan tidur dengan isteri-isterimu di siang hari."
 },
 {
   "id": 8301,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 12,
   "firman": "Sebab engkau telah melakukannya secara tersembunyi, tetapi Aku akan melakukan hal itu di depan seluruh Israel secara terang-terangan.\""
 },
 {
   "id": 8302,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 13,
   "firman": "Lalu berkatalah Daud kepada Natan: \"Aku sudah berdosa kepada TUHAN.\" Dan Natan berkata kepada Daud: \"TUHAN telah menjauhkan dosamu itu: engkau tidak akan mati."
 },
 {
   "id": 8303,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 14,
   "firman": "Walaupun demikian, karena engkau dengan perbuatan ini telah sangat menista TUHAN, pastilah anak yang lahir bagimu itu akan mati.\""
 },
 {
   "id": 8304,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 15,
   "firman": "Kemudian pergilah Natan ke rumahnya. Dan TUHAN menulahi anak yang dilahirkan bekas isteri Uria bagi Daud, sehingga sakit."
 },
 {
   "id": 8305,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 16,
   "firman": "Lalu Daud memohon kepada Allah oleh karena anak itu, ia berpuasa dengan tekun dan apabila ia masuk ke dalam, semalam-malaman itu ia berbaring di tanah."
 },
 {
   "id": 8306,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 17,
   "firman": "Maka datanglah kepadanya para tua-tua yang di rumahnya untuk meminta ia bangun dari lantai, tetapi ia tidak mau; juga ia tidak makan bersama-sama dengan mereka."
 },
 {
   "id": 8307,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 18,
   "firman": "Pada hari yang ketujuh matilah anak itu. Dan pegawai-pegawai Daud takut memberitahukan kepadanya, bahwa anak itu sudah mati. Sebab mereka berkata: \"Ketika anak itu masih hidup, kita telah berbicara kepadanya, tetapi ia tidak menghiraukan perkataan kita. Bagaimana kita dapat mengatakan kepadanya: anak itu sudah mati? Jangan-jangan ia mencelakakan diri!\""
 },
 {
   "id": 8308,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 19,
   "firman": "Ketika Daud melihat, bahwa pegawai-pegawainya berbisik-bisik, mengertilah ia, bahwa anak itu sudah mati. Lalu Daud bertanya kepada pegawai-pegawainya: \"Sudah matikah anak itu?\" Jawab mereka: \"Sudah.\""
 },
 {
   "id": 8309,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 20,
   "firman": "Lalu Daud bangun dari lantai, ia mandi dan berurap dan bertukar pakaian; ia masuk ke dalam rumah TUHAN dan sujud menyembah. Sesudah itu pulanglah ia ke rumahnya, dan atas permintaannya dihidangkan kepadanya roti, lalu ia makan."
 },
 {
   "id": 8310,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 21,
   "firman": "Berkatalah pegawai-pegawainya kepadanya: \"Apakah artinya hal yang kauperbuat ini? Oleh karena anak yang masih hidup itu, engkau berpuasa dan menangis, tetapi sesudah anak itu mati, engkau bangun dan makan!\""
 },
 {
   "id": 8311,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 22,
   "firman": "Jawabnya: \"Selagi anak itu hidup, aku berpuasa dan menangis, karena pikirku: siapa tahu TUHAN mengasihani aku, sehingga anak itu tetap hidup."
 },
 {
   "id": 8312,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 23,
   "firman": "Tetapi sekarang ia sudah mati, mengapa aku harus berpuasa? Dapatkah aku mengembalikannya lagi? Aku yang akan pergi kepadanya, tetapi ia tidak akan kembali kepadaku.\""
 },
 {
   "id": 8313,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 24,
   "firman": "Kemudian Daud menghibur hati Batsyeba, isterinya; ia menghampiri perempuan itu dan tidur dengan dia, dan perempuan itu melahirkan seorang anak laki-laki, lalu Daud memberi nama Salomo kepada anak itu. TUHAN mengasihi anak ini"
 },
 {
   "id": 8314,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 25,
   "firman": "dan dengan perantaraan nabi Natan Ia menyuruh menamakan anak itu Yedija, oleh karena TUHAN."
 },
 {
   "id": 8315,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 26,
   "firman": "Yoab berperang melawan Raba, kota bani Amon dan ia merebut kota kerajaan."
 },
 {
   "id": 8316,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 27,
   "firman": "Lalu Yoab menyuruh orang kepada Daud dengan pesan: \"Aku berperang melawan kota Raba, dan telah merebut pula kota air."
 },
 {
   "id": 8317,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 28,
   "firman": "Oleh sebab itu, kumpulkanlah sisa tentara, kepunglah kota itu dan rebutlah, supaya jangan aku yang merebut kota itu dan jangan namaku menjadi juga nama kota itu.\""
 },
 {
   "id": 8318,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 29,
   "firman": "Sesudah itu Daud mengumpulkan seluruh tentara, ia berangkat ke kota Raba dan berperang melawannya, lalu merebutnya."
 },
 {
   "id": 8319,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 30,
   "firman": "Ia mengambil mahkota dari kepala raja mereka, beratnya setalenta emas, bertatahkan sebuah batu permata yang mahal dan itu dikenakan pada kepala Daud. Juga diangkutnya banyak sekali jarahan dari kota itu."
 },
 {
   "id": 8320,
   "kitab": "2Sa",
   "pasal": 12,
   "ayat": 31,
   "firman": "Penduduk kota itu diangkutnya dan dipaksanya bekerja dengan gergaji, penggerek besi dan kapak; juga dipekerjakannya mereka di tempat pembuatan batu bata. Demikianlah juga diperlakukan Daud segala kota bani Amon. Sesudah itu pulanglah Daud dengan seluruh tentara ke Yerusalem."
 },
 {
   "id": 8321,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 1,
   "firman": "Sesudah itu terjadilah yang berikut. Absalom bin Daud mempunyai seorang adik perempuan yang cantik, namanya Tamar; dan Amnon bin Daud jatuh cinta kepadanya."
 },
 {
   "id": 8322,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 2,
   "firman": "Hati Amnon sangat tergoda, sehingga ia jatuh sakit karena Tamar, saudaranya itu, sebab anak perempuan itu masih perawan dan menurut anggapan Amnon mustahil untuk melakukan sesuatu terhadap dia."
 },
 {
   "id": 8323,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 3,
   "firman": "Amnon mempunyai seorang sahabat bernama Yonadab, anak Simea kakak Daud. Yonadab itu seorang yang sangat cerdik."
 },
 {
   "id": 8324,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 4,
   "firman": "Katanya kepada Amnon: \"Hai anak raja, mengapa engkau demikian merana setiap pagi? Tidakkah lebih baik engkau memberitahukannya kepadaku?\" Kata Amnon kepadanya: \"Aku cinta kepada Tamar, adik perempuan Absalom, saudaraku itu.\""
 },
 {
   "id": 8325,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 5,
   "firman": "Lalu berkatalah Yonadab kepadanya: \"Berbaringlah di tempat tidurmu dan berbuat pura-pura sakit. Apabila ayahmu datang menengok engkau, maka haruslah engkau berkata kepadanya: Izinkanlah adikku Tamar datang memberi aku makan. Apabila ia menyediakan makanan di depan mataku, sehingga aku dapat melihatnya, maka aku akan memakannya dari tangannya.\""
 },
 {
   "id": 8326,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 6,
   "firman": "Sesudah itu berbaringlah Amnon dan berbuat pura-pura sakit. Ketika raja datang menengok dia, berkatalah Amnon kepada raja: \"Izinkanlah adikku Tamar datang membuat barang dua kue di depan mataku, supaya aku memakannya dari tangannya.\""
 },
 {
   "id": 8327,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 7,
   "firman": "Lalu Daud menyuruh orang kepada Tamar, ke rumahnya, dengan pesan: \"Pergilah ke rumah Amnon, kakakmu dan sediakanlah makanan baginya.\""
 },
 {
   "id": 8328,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 8,
   "firman": "Maka Tamar pergi ke rumah Amnon, kakaknya, yang sedang berbaring-baring, lalu anak perempuan itu mengambil adonan, meremasnya dan membuat kue di depan matanya, kemudian dibakarnya kue itu."
 },
 {
   "id": 8329,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sesudah itu gadis itu mengambil kuali dan mengeluarkan isinya di depan Amnon, tetapi ia tidak mau makan. Berkatalah Amnon: \"Suruhlah setiap orang keluar meninggalkan aku.\" Lalu keluarlah setiap orang meninggalkan dia."
 },
 {
   "id": 8330,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 10,
   "firman": "Lalu berkatalah Amnon kepada Tamar: \"Bawalah makanan itu ke dalam kamar, supaya aku memakannya dari tanganmu.\" Tamar mengambil kue yang disediakannya itu, lalu membawanya kepada Amnon, kakaknya, ke dalam kamar."
 },
 {
   "id": 8331,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 11,
   "firman": "Ketika gadis itu menghidangkannya kepadanya supaya ia makan, dipegangnyalah gadis itu dan berkata kepadanya: \"Marilah tidur dengan aku, adikku.\""
 },
 {
   "id": 8332,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 12,
   "firman": "Tetapi gadis itu berkata kepadanya: \"Tidak kakakku, jangan perkosa aku, sebab orang tidak berlaku seperti itu di Israel. Janganlah berbuat noda seperti itu."
 },
 {
   "id": 8333,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 13,
   "firman": "Dan aku, ke manakah kubawa kecemaranku? Dan engkau ini, engkau akan dianggap sebagai orang yang bebal di Israel. Oleh sebab itu, berbicaralah dengan raja, sebab ia tidak akan menolak memberikan aku kepadamu.\""
 },
 {
   "id": 8334,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tetapi Amnon tidak mau mendengarkan perkataannya, dan sebab ia lebih kuat dari padanya, diperkosanyalah dia, lalu tidur dengan dia."
 },
 {
   "id": 8335,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 15,
   "firman": "Kemudian timbullah kebencian yang sangat besar pada Amnon terhadap gadis itu, bahkan lebih besar benci yang dirasanya kepada gadis itu dari pada cinta yang dirasanya sebelumnya. Lalu Amnon berkata kepadanya: \"Bangunlah, enyahlah!\""
 },
 {
   "id": 8336,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 16,
   "firman": "Lalu berkatalah gadis itu kepadanya: \"Tidak kakakku, sebab menyuruh aku pergi adalah lebih jahat dari pada apa yang telah kaulakukan kepadaku tadi.\" Tetapi Amnon tidak mau mendengarkan dia."
 },
 {
   "id": 8337,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 17,
   "firman": "Dipanggilnya orang muda yang melayani dia, katanya: \"Suruhlah perempuan ini pergi dari padaku dan kuncilah pintu di belakangnya.\""
 },
 {
   "id": 8338,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 18,
   "firman": "Gadis itu memakai baju kurung yang maha indah; sebab demikianlah puteri-puteri raja yang masih perawan berpakaikan baju kurung panjang. Kemudian pelayan itu menyuruh dia keluar, lalu mengunci pintu di belakangnya."
 },
 {
   "id": 8339,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 19,
   "firman": "Lalu Tamar menaruh abu di atas kepalanya, mengoyakkan baju kurung yang maha indah yang dipakainya, meletakkan tangannya di atas kepalanya dan pergilah ia sambil meratap dengan nyaring."
 },
 {
   "id": 8340,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 20,
   "firman": "Bertanyalah Absalom, kakaknya, kepadanya: \"Apakah Amnon, kakakmu itu, bersetubuh dengan engkau? Maka sekarang, adikku, diamlah saja, bukankah ia kakakmu, janganlah begitu memikirkan perkara itu.\" Lalu Tamar tinggal di rumah Absalom, kakaknya itu, seorang diri."
 },
 {
   "id": 8341,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 21,
   "firman": "Ketika segala perkara itu didengar raja Daud sangat marahlah ia."
 },
 {
   "id": 8342,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 22,
   "firman": "Dan Absalom tidak berkata-kata dengan Amnon, baik tentang yang jahat maupun tentang yang baik, tetapi Absalom membenci Amnon, sebab ia telah memperkosa Tamar, adiknya."
 },
 {
   "id": 8343,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 23,
   "firman": "Sesudah lewat dua tahun, Absalom mengadakan pengguntingan bulu domba di Baal-Hazor yang dekat kota Efraim. Lalu Absalom mengundang semua anak raja."
 },
 {
   "id": 8344,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 24,
   "firman": "Kemudian Absalom menghadap raja, lalu berkata: \"Hambamu ini mengadakan pengguntingan bulu domba. Kiranya raja dan pegawai-pegawainya ikut bersama-sama dengan hambamu ini.\""
 },
 {
   "id": 8345,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 25,
   "firman": "Tetapi raja berkata kepada Absalom: \"Maaf, anakku, jangan kami semua pergi, supaya kami jangan menyusahkan engkau.\" Lalu Absalom mendesak, tetapi raja tidak mau pergi, ia hanya memberi restu kepadanya."
 },
 {
   "id": 8346,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 26,
   "firman": "Kemudian berkatalah Absalom: \"Kalau tidak, izinkanlah kakakku Amnon pergi beserta kami.\" Tetapi raja menjawabnya: \"Apa gunanya ia pergi bersama-sama dengan engkau?\""
 },
 {
   "id": 8347,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 27,
   "firman": "Tetapi ketika Absalom mendesak, diizinkannyalah Amnon dan semua anak raja pergi beserta dia."
 },
 {
   "id": 8348,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 28,
   "firman": "Lalu Absalom memerintahkan orang-orangnya, demikian: \"Perhatikan! Apabila hati Amnon menjadi gembira karena anggur, dan aku berkata kepadamu: Paranglah Amnon, maka haruslah kamu membunuh dia. Jangan takut. Bukankah aku yang memerintahkannya kepadamu? Kuatkanlah hatimu dan tunjukkanlah dirimu sebagai orang yang gagah perkasa!\""
 },
 {
   "id": 8349,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 29,
   "firman": "Orang-orang Absalom memperlakukan Amnon seperti yang diperintahkan Absalom. Lalu bangunlah semua anak raja itu, mereka menaiki bagalnya masing-masing dan melarikan diri."
 },
 {
   "id": 8350,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 30,
   "firman": "Mereka masih di tengah jalan, ketika kabar sampai kepada Daud, demikian: \"Absalom telah membunuh semua anak raja, tidak ada seorangpun dari mereka yang lolos.\""
 },
 {
   "id": 8351,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 31,
   "firman": "Lalu bangunlah raja, dikoyakkannya pakaiannya dan berbaring di lantai, dan semua pegawainya yang hadir padanya mengoyakkan pakaian mereka."
 },
 {
   "id": 8352,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 32,
   "firman": "Maka berbicaralah Yonadab, anak Simea, kakak Daud, katanya: \"Janganlah tuanku menyangka, bahwa semua orang muda anak-anak raja itu, telah dibunuh. Hanya Amnon yang mati, sebab hal itu telah terlihat pada air muka Absalom, sejak Amnon memperkosa Tamar, adiknya."
 },
 {
   "id": 8353,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 33,
   "firman": "Jadi, janganlah tuanku raja menaruh pikiran dalam hatinya, bahwa semua anak raja itu sudah mati, sebab hanya Amnon yang mati.\""
 },
 {
   "id": 8354,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 34,
   "firman": "Absalom melarikan diri. Ketika orang yang berjaga-jaga melayangkan pandangnya, maka terlihatlah olehnya sejumlah besar orang datang dari jurusan Horonaim, sepanjang sisi pegunungan."
 },
 {
   "id": 8355,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 35,
   "firman": "Berkatalah Yonadab kepada raja: \"Lihat, anak-anak raja datang! Benar seperti kata hambamu ini.\""
 },
 {
   "id": 8356,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 36,
   "firman": "Baru saja ia habis berkata, datanglah anak-anak raja itu. Mereka menangis dengan suara nyaring. Juga raja dan semua pegawainya menangis dengan amat keras."
 },
 {
   "id": 8357,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 37,
   "firman": "Absalom telah melarikan diri dan telah pergi kepada Talmai bin Amihur, raja negeri Gesur. Dan Daud berdukacita berhari-hari lamanya karena anaknya itu."
 },
 {
   "id": 8358,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 38,
   "firman": "Absalom telah melarikan diri dan telah pergi ke Gesur; ia tinggal di sana tiga tahun lamanya."
 },
 {
   "id": 8359,
   "kitab": "2Sa",
   "pasal": 13,
   "ayat": 39,
   "firman": "Lalu raja tidak lagi marah terhadap Absalom, sebab kesedihan hatinya karena kematian Amnon telah surut."
 },
 {
   "id": 8360,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 1,
   "firman": "Ketika Yoab, anak Zeruya, mengetahui, bahwa hati raja merindukan Absalom,"
 },
 {
   "id": 8361,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 2,
   "firman": "maka ia menyuruh orang ke Tekoa menjemput dari sana seorang perempuan yang bijaksana, lalu ia berkata kepada perempuan itu: \"Berlakulah pura-pura berkabung, dan pakailah pakaian berkabung, janganlah berurap dengan minyak, dan berlakulah seperti seorang perempuan yang telah lama berkabung karena seorang mati."
 },
 {
   "id": 8362,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 3,
   "firman": "Kemudian masuklah menghadap raja dan berbicaralah kepadanya seperti ini\" --lalu Yoab menaruh perkataannya ke dalam mulut perempuan itu."
 },
 {
   "id": 8363,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 4,
   "firman": "Ketika perempuan Tekoa itu masuk menghadap raja, sujudlah ia dengan mukanya ke tanah dan menyembah, sambil berkata: \"Tolonglah, ya tuanku raja!\""
 },
 {
   "id": 8364,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 5,
   "firman": "Raja bertanya kepadanya: \"Ada apa?\" Jawabnya: \"Ah, aku ini seorang janda, sebab suamiku sudah mati."
 },
 {
   "id": 8365,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 6,
   "firman": "Hambamu ini mempunyai dua orang anak laki-laki; mereka berkelahi di padang dan karena tidak ada yang memisahkan, maka yang satu memukul yang lain dan membunuh dia."
 },
 {
   "id": 8366,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 7,
   "firman": "Dan sekarang seluruh kaum keluarga bangkit melawan hambamu ini, dan mereka berkata: Serahkanlah orang yang membunuh saudaranya itu, supaya kami menghukum dia mati ganti nyawa saudaranya yang telah dibunuhnya itu, dan supaya kami memunahkan juga ahli waris itu. Mereka hendak memunahkan keturunanku yang masih tersisa itu dengan tidak meninggalkan nama atau keturunan bagi suamiku di muka bumi.\""
 },
 {
   "id": 8367,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 8,
   "firman": "Lalu berbicaralah raja kepada perempuan itu: \"Pulanglah ke rumahmu, mengenai engkau akan kuberi perintah.\""
 },
 {
   "id": 8368,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 9,
   "firman": "Perempuan Tekoa itu berkata kepada raja: \"Aku dan keluargaku akan menanggung kesalahan itu, ya tuanku raja, tetapi raja dan takhtanya tak bersalah.\""
 },
 {
   "id": 8369,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 10,
   "firman": "Lalu berkatalah raja: \"Jika ada orang yang mengatakan apa-apa lagi terhadap engkau, bawalah orang itu menghadap aku, maka ia tidak akan mengusik engkau lagi.\""
 },
 {
   "id": 8370,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 11,
   "firman": "Kata perempuan itu: \"Kiranya raja ingat kepada TUHAN, Allahmu, supaya si penuntut tebusan darah jangan terlalu banyak menimbulkan kemusnahan dan supaya mereka jangan memunahkan anakku itu.\" Lalu berkatalah raja: \"Demi TUHAN yang hidup--sehelai rambutpun dari kepala anakmu itu takkan jatuh ke bumi!\""
 },
 {
   "id": 8371,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 12,
   "firman": "Kemudian berkatalah perempuan itu: \"Izinkanlah hambamu ini berkata sepatah kata lagi kepada tuanku raja.\" Jawabnya: \"Katakanlah.\""
 },
 {
   "id": 8372,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 13,
   "firman": "Berkatalah perempuan itu: \"Mengapa raja merancang hal yang demikian terhadap umat Allah? Oleh karena tuanku mengucapkan perkataan ini, maka tuanku sendirilah yang bersalah dengan tidak mengizinkan pulang orang yang telah dibuangnya."
 },
 {
   "id": 8373,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 14,
   "firman": "Sebab kita pasti mati, kita seperti air yang tercurah ke bumi, yang tidak terkumpulkan. Tetapi Allah tidak mengambil nyawa orang, melainkan Ia merancang supaya seorang yang terbuang jangan tinggal terbuang dari pada-Nya."
 },
 {
   "id": 8374,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 15,
   "firman": "Maka sekarang, aku datang mengatakan perkataan ini kepada tuanku raja karena orang banyak itu telah menakut-nakuti aku. Sebab itu pikir hambamu ini: baiklah aku berbicara dahulu dengan raja, mungkin raja mengabulkan permohonan hambanya ini;"
 },
 {
   "id": 8375,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 16,
   "firman": "sebab raja akan mendengarkan aku dan akan melepaskan hambanya ini dari tangan orang yang hendak memunahkan aku dan anakku bersama-sama dari milik pusaka Allah."
 },
 {
   "id": 8376,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 17,
   "firman": "Juga hambamu ini berpikir: perkataan tuanku raja tentulah akan menenangkan hati, sebab seperti malaikat Allah, demikianlah tuanku raja, yang dapat membeda-bedakan apa yang baik dan jahat. Dan TUHAN, Allahmu, kiranya menyertai tuanku.\""
 },
 {
   "id": 8377,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 18,
   "firman": "Lalu raja menjawab, katanya kepada perempuan itu: \"Baiklah jangan sembunyikan kepadaku apa yang hendak kutanyakan kepadamu.\" Kata perempuan itu: \"Berkatalah kiranya tuanku raja!\""
 },
 {
   "id": 8378,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 19,
   "firman": "Kemudian bertanyalah raja: \"Adakah Yoab campur tangan dengan engkau dalam semuanya ini?\" Perempuan itu menjawab: \"Demi hidupmu, tuanku raja, tidaklah mungkin untuk menyimpang ke kanan atau ke kiri dari segala yang tuanku raja katakan. Sesungguhnya hambamu Yoab yang memerintahkan daku; dialah yang menaruh ke dalam mulut hambamu segala perkataan ini."
 },
 {
   "id": 8379,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 20,
   "firman": "Dengan maksud untuk mengubah rupa perkara itu maka hambamu Yoab melakukan perkara ini. Tetapi tuanku bijaksana sama seperti malaikat Allah, sehingga mengetahui semua yang terjadi di bumi.\""
 },
 {
   "id": 8380,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 21,
   "firman": "Sesudah itu berkatalah raja kepada Yoab: \"Baik, kukabulkan permohonan ini. Pergilah, bawalah kembali orang muda Absalom itu.\""
 },
 {
   "id": 8381,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 22,
   "firman": "Lalu sujudlah Yoab dengan mukanya ke tanah dan menyembah sambil memohon berkat bagi raja. Dan Yoab berkata: \"Pada hari ini hambamu mengetahui bahwa tuanku raja suka kepada hamba, karena tuanku telah mengabulkan permohonan hambamu ini.\""
 },
 {
   "id": 8382,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 23,
   "firman": "Lalu bangunlah Yoab, ia pergi ke Gesur dan membawa Absalom ke Yerusalem."
 },
 {
   "id": 8383,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 24,
   "firman": "Tetapi berkatalah raja: \"Ia harus pergi ke rumahnya sendiri, jangan ia datang ke hadapanku.\" Jadi pergilah Absalom ke rumahnya sendiri dan tidak datang ke hadapan raja."
 },
 {
   "id": 8384,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 25,
   "firman": "Di seluruh Israel tidak ada yang begitu banyak dipuji kecantikannya seperti Absalom. Dari telapak kakinya sampai ujung kepalanya tidak ada cacat padanya."
 },
 {
   "id": 8385,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 26,
   "firman": "Apabila ia mencukur rambutnya--pada akhir tiap-tiap tahun ia mencukurnya karena menjadi terlalu berat baginya--maka ditimbangnya rambutnya itu, dua ratus syikal beratnya, menurut batu timbangan raja."
 },
 {
   "id": 8386,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 27,
   "firman": "Bagi Absalom lahir tiga orang anak laki-laki dan seorang anak perempuan, yang bernama Tamar. Ia seorang perempuan yang cantik."
 },
 {
   "id": 8387,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 28,
   "firman": "Setelah Absalom diam di Yerusalem genap dua tahun lamanya, dengan tidak datang ke hadapan raja,"
 },
 {
   "id": 8388,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 29,
   "firman": "maka Absalom menyuruh memanggil Yoab untuk diutus kepada raja. Tetapi ia tidak mau datang kepadanya. Kemudian disuruhnya memanggil dia lagi, untuk kedua kalinya, tetapi ia tidak mau datang."
 },
 {
   "id": 8389,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 30,
   "firman": "Lalu berkatalah ia kepada hamba-hambanya: \"Lihat, ladang Yoab ada di sisi ladangku dan di sana ada jelainya. Pergilah, bakarlah itu.\" Maka hamba-hamba Absalom membakar ladang itu."
 },
 {
   "id": 8390,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 31,
   "firman": "Lalu Yoab pergi mendapatkan Absalom ke rumahnya, dan bertanya kepadanya: \"Mengapa hamba-hambamu membakar ladang kepunyaanku itu?\""
 },
 {
   "id": 8391,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 32,
   "firman": "Jawab Absalom kepada Yoab: \"Ya, aku telah menyuruh orang kepadamu mengatakan: datanglah ke mari, supaya aku mengutus engkau kepada raja untuk mengatakan: apa gunanya aku datang dari Gesur? Lebih baik aku masih tinggal di sana. Maka sekarang, aku mau datang ke hadapan raja. Jika aku bersalah, biarlah ia menghukum aku mati.\""
 },
 {
   "id": 8392,
   "kitab": "2Sa",
   "pasal": 14,
   "ayat": 33,
   "firman": "Kemudian masuklah Yoab menghadap raja dan memberitahukan hal itu kepadanya. Raja memanggil Absalom, dan ia masuk menghadap raja, lalu sujud ke hadapan raja dengan mukanya ke tanah; lalu raja mencium Absalom."
 },
 {
   "id": 8393,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 1,
   "firman": "Sesudah itu Absalom menyediakan baginya sebuah kereta serta kuda dan lima puluh orang yang berlari di depannya."
 },
 {
   "id": 8394,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 2,
   "firman": "Maka setiap pagi berdirilah Absalom di tepi jalan yang menuju pintu gerbang. Setiap orang yang mempunyai perkara dan yang mau masuk menghadap raja untuk diadili perkaranya, orang itu dipanggil Absalom dan ditanyai: \"Dari kota manakah engkau?\" Apabila ia menjawab: \"Hambamu ini datang dari suku Israel anu,\""
 },
 {
   "id": 8395,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 3,
   "firman": "maka berkatalah Absalom kepadanya: \"Lihat, perkaramu itu baik dan benar, tetapi dari pihak raja tidak ada seorangpun yang mau mendengarkan engkau.\""
 },
 {
   "id": 8396,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 4,
   "firman": "Lagi kata Absalom: \"Sekiranya aku diangkat menjadi hakim di negeri ini! Maka setiap orang yang mempunyai perkara atau pertikaian hukum boleh datang kepadaku, dan aku akan menyelesaikan perkaranya dengan adil.\""
 },
 {
   "id": 8397,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 5,
   "firman": "Apabila seseorang datang mendekat untuk sujud menyembah kepadanya, maka diulurkannyalah tangannya, dipegangnya orang itu dan diciumnya."
 },
 {
   "id": 8398,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 6,
   "firman": "Cara yang demikianlah diperbuat Absalom kepada semua orang Israel yang mau masuk menghadap untuk diadili perkaranya oleh raja, dan demikianlah Absalom mencuri hati orang-orang Israel."
 },
 {
   "id": 8399,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 7,
   "firman": "Sesudah lewat empat tahun bertanyalah Absalom kepada raja: \"Izinkanlah aku pergi, supaya di Hebron aku bayar nazarku, yang telah kuikrarkan kepada TUHAN."
 },
 {
   "id": 8400,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 8,
   "firman": "Sebab hambamu ini, ketika masih tinggal di Gesur, di Aram, telah bernazar, demikian: Jika TUHAN sungguh-sungguh memulangkan aku ke Yerusalem, maka aku akan beribadah kepada TUHAN.\""
 },
 {
   "id": 8401,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 9,
   "firman": "Lalu berkatalah raja kepadanya: \"Pergilah dengan selamat.\" Maka berkemaslah Absalom dan pergi ke Hebron."
 },
 {
   "id": 8402,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 10,
   "firman": "Dalam pada itu Absalom telah mengirim utusan-utusan rahasia kepada segenap suku Israel dengan pesan: \"Segera sesudah kamu mendengar bunyi sangkakala, berserulah: Absalom sudah menjadi raja di Hebron!\""
 },
 {
   "id": 8403,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 11,
   "firman": "Beserta Absalom turut pergi dua ratus orang dari Yerusalem, orang-orang undangan yang turut pergi tanpa curiga dan tanpa mengetahui apapun tentang perkara itu."
 },
 {
   "id": 8404,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 12,
   "firman": "Ketika Absalom hendak mempersembahkan korban, disuruhnya datang Ahitofel, orang Gilo itu, penasihat Daud, dari Gilo, kotanya. Demikianlah persepakatan gelap itu menjadi kuat, dan makin banyaklah rakyat yang memihak Absalom."
 },
 {
   "id": 8405,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 13,
   "firman": "Lalu datanglah seseorang mengabarkan kepada Daud, katanya: \"Hati orang Israel telah condong kepada Absalom.\""
 },
 {
   "id": 8406,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 14,
   "firman": "Kemudian berbicaralah Daud kepada semua pegawainya yang ada bersama-sama dengan dia di Yerusalem: \"Bersiaplah, marilah kita melarikan diri, sebab jangan-jangan kita tidak akan luput dari pada Absalom. Pergilah dengan segera, supaya ia jangan dapat lekas menyusul kita, dan mendatangkan celaka atas kita dan memukul kota ini dengan mata pedang!\""
 },
 {
   "id": 8407,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 15,
   "firman": "Para pegawai raja berkata kepada raja: \"Terserah kepada tuanku raja! Hamba-hambamu ini siap!\""
 },
 {
   "id": 8408,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 16,
   "firman": "Lalu keluarlah raja dan seisi rumahnya mengiringi dia; sepuluh orang gundik ditinggalkan raja untuk menunggui istana."
 },
 {
   "id": 8409,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 17,
   "firman": "Maka keluarlah raja dan seluruh orang-orangnya mengiringi dia. Dekat rumah yang terakhir mereka berhenti"
 },
 {
   "id": 8410,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 18,
   "firman": "sedang semua pegawainya berjalan melewatinya, juga semua orang Kreti dan semua orang Pleti. Juga semua orang Gat, enam ratus orang banyaknya, yang mengiringi dia sejak dari Gat, berjalan melewati raja."
 },
 {
   "id": 8411,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 19,
   "firman": "Lalu bertanyalah raja kepada Itai, orang Gat itu: \"Mengapa pula engkau berjalan beserta kami? Pulanglah dan tinggallah bersama-sama raja, sebab engkau orang asing, lagipula engkau orang buangan dari tempat asalmu."
 },
 {
   "id": 8412,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 20,
   "firman": "Baru kemarin engkau datang, masakan pada hari ini aku akan membawa engkau mengembara bersama-sama kami, padahal aku harus pergi entah ke mana. Pulanglah dan bawalah juga saudara-saudaramu pulang; mudah-mudahan TUHAN menunjukkan kasih dan setia kepadamu!\""
 },
 {
   "id": 8413,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 21,
   "firman": "Tetapi Itai menjawab raja: \"Demi TUHAN yang hidup, dan demi hidup tuanku raja, di mana tuanku raja ada, baik hidup atau mati, di situ hambamu juga ada.\""
 },
 {
   "id": 8414,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 22,
   "firman": "Lalu berkatalah Daud kepada Itai: \"Jika demikian, berjalanlah lewat.\" Kemudian lewatlah Itai, orang Gat itu, bersama-sama dengan semua orangnya dan semua anak yang menyertai dia."
 },
 {
   "id": 8415,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 23,
   "firman": "Seluruh negeri menangis dengan suara keras, ketika seluruh rakyat berjalan lewat. Raja menyeberangi sungai Kidron dan seluruh rakyat berjalan ke arah padang gurun."
 },
 {
   "id": 8416,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 24,
   "firman": "Dan lihat, juga Zadok ada di sana beserta semua orang Lewi pengangkat tabut perjanjian Allah. Mereka meletakkan tabut Allah itu--juga Abyatar ikut datang--sampai seluruh rakyat dari kota selesai menyeberang."
 },
 {
   "id": 8417,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 25,
   "firman": "Lalu berkatalah raja kepada Zadok: \"Bawalah tabut Allah itu kembali ke kota; jika aku mendapat kasih karunia di mata TUHAN, maka Ia akan mengizinkan aku kembali, sehingga aku akan melihatnya lagi, juga tempat kediamannya."
 },
 {
   "id": 8418,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 26,
   "firman": "Tetapi jika Ia berfirman, begini: Aku tidak berkenan kepadamu, maka aku bersedia, biarlah dilakukan-Nya kepadaku apa yang baik di mata-Nya.\""
 },
 {
   "id": 8419,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 27,
   "firman": "Lagi berkatalah raja kepada Zadok, imam itu: \"Jadi, engkau dan Abyatar, pulanglah ke kota dengan selamat beserta anakmu masing-masing, yakni Ahimaas anakmu dan Yonatan, anak Abyatar."
 },
 {
   "id": 8420,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 28,
   "firman": "Ketahuilah, aku akan menanti di dekat tempat-tempat penyeberangan ke padang gurun, sampai ada kabar dari kamu untuk memberitahu aku.\""
 },
 {
   "id": 8421,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 29,
   "firman": "Lalu Zadok dan Abyatar membawa tabut Allah itu kembali ke Yerusalem dan tinggallah mereka di sana."
 },
 {
   "id": 8422,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 30,
   "firman": "Daud mendaki bukit Zaitun sambil menangis, kepalanya berselubung dan ia berjalan dengan tidak berkasut. Juga seluruh rakyat yang bersama-sama dengan dia masing-masing berselubung kepalanya, dan mereka mendaki sambil menangis."
 },
 {
   "id": 8423,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 31,
   "firman": "Ketika kepada Daud dikabarkan, demikian: \"Ahitofel ada di antara orang-orang yang bersepakat dengan Absalom,\" maka berkatalah Daud: \"Gagalkanlah kiranya nasihat Ahitofel itu, ya TUHAN.\""
 },
 {
   "id": 8424,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 32,
   "firman": "Ketika Daud sampai ke puncak, ke tempat orang sujud menyembah kepada Allah, maka datanglah Husai, orang Arki, mendapatkan dia dengan jubah yang terkoyak dan dengan tanah di atas kepala."
 },
 {
   "id": 8425,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 33,
   "firman": "Berkatalah Daud kepadanya: \"Jika engkau turut dengan aku, maka engkau menjadi beban kepadaku nanti,"
 },
 {
   "id": 8426,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 34,
   "firman": "tetapi jika engkau kembali ke kota dan berkata kepada Absalom: Aku ini hambamu, ya raja, sejak dahulu aku hamba ayahmu, tetapi sekarang aku menjadi hambamu, --dengan demikian engkau dapat membatalkan nasihat Ahitofel demi aku."
 },
 {
   "id": 8427,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 35,
   "firman": "Bukankah Zadok dan Abyatar, imam-imam itu, ada bersama-sama engkau di sana? Jadi segala yang kaudengar dari dalam istana raja, haruslah kauberitahukan kepada Zadok dan Abyatar, imam-imam itu."
 },
 {
   "id": 8428,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 36,
   "firman": "Ingatlah, di sana bersama-sama dengan mereka ada kedua anak mereka, Ahimaas anak Zadok dan Yonatan anak Abyatar; dengan perantaraan mereka haruslah kamu kirimkan kepadaku segala hal yang kamu dengar.\""
 },
 {
   "id": 8429,
   "kitab": "2Sa",
   "pasal": 15,
   "ayat": 37,
   "firman": "Dan tibalah Husai, sahabat Daud, di Yerusalem tepat pada waktu Absalom masuk ke kota itu."
 },
 {
   "id": 8430,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 1,
   "firman": "Ketika Daud baru saja melewati puncak, datanglah Ziba, hamba Mefiboset, mendapatkan dia membawa sepasang keledai yang berpelana, dengan muatan dua ratus ketul roti, seratus buah kue kismis, seratus buah-buahan musim panas dan sebuyung anggur."
 },
 {
   "id": 8431,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 2,
   "firman": "Lalu bertanyalah raja kepada Ziba: \"Apakah maksudmu dengan semuanya ini?\" Jawab Ziba: \"Keledai-keledai ini bagi keluarga raja untuk ditunggangi; roti dan buah-buahan ini bagi orang-orangmu untuk dimakan; dan anggur ini untuk diminum di padang gurun oleh orang-orang yang sudah lelah.\""
 },
 {
   "id": 8432,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 3,
   "firman": "Kemudian bertanyalah raja: \"Di manakah anak tuanmu?\" Jawab Ziba kepada raja: \"Ia ada di Yerusalem, sebab katanya: Pada hari ini kaum Israel akan mengembalikan kepadaku kerajaan ayahku.\""
 },
 {
   "id": 8433,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 4,
   "firman": "Lalu berkatalah raja kepada Ziba: \"Kalau begitu, kepunyaanmulah segala kepunyaan Mefiboset.\" Kata Ziba: \"Aku tunduk! Biarlah kiranya aku tetap mendapat kasih di matamu, ya tuanku raja.\""
 },
 {
   "id": 8434,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 5,
   "firman": "Ketika raja Daud telah sampai ke Bahurim, keluarlah dari sana seorang dari kaum keluarga Saul; ia bernama Simei bin Gera. Sambil mendekati raja, ia terus-menerus mengutuk."
 },
 {
   "id": 8435,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 6,
   "firman": "Daud dan semua pegawai raja Daud dilemparinya dengan batu, walaupun segenap tentara dan semua pahlawan berjalan di kiri kanannya."
 },
 {
   "id": 8436,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 7,
   "firman": "Beginilah perkataan Simei pada waktu ia mengutuk: \"Enyahlah, enyahlah, engkau penumpah darah, orang dursila!"
 },
 {
   "id": 8437,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 8,
   "firman": "TUHAN telah membalas kepadamu segala darah keluarga Saul, yang engkau gantikan menjadi raja, TUHAN telah menyerahkan kedudukan raja kepada anakmu Absalom. Sesungguhnya, engkau sekarang dirundung malang, karena engkau seorang penumpah darah.\""
 },
 {
   "id": 8438,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 9,
   "firman": "Lalu berkatalah Abisai, anak Zeruya, kepada raja: \"Mengapa anjing mati ini mengutuki tuanku raja? Izinkanlah aku menyeberang dan memenggal kepalanya.\""
 },
 {
   "id": 8439,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 10,
   "firman": "Tetapi kata raja: \"Apakah urusanku dengan kamu, hai anak-anak Zeruya? Biarlah ia mengutuk! Sebab apabila TUHAN berfirman kepadanya: Kutukilah Daud, siapakah yang akan bertanya: mengapa engkau berbuat demikian?\""
 },
 {
   "id": 8440,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 11,
   "firman": "Pula kata Daud kepada Abisai dan kepada semua pegawainya: \"Sedangkan anak kandungku ingin mencabut nyawaku, terlebih lagi sekarang orang Benyamin ini! Biarkanlah dia dan biarlah ia mengutuk, sebab TUHAN yang telah berfirman kepadanya demikian."
 },
 {
   "id": 8441,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 12,
   "firman": "Mungkin TUHAN akan memperhatikan kesengsaraanku ini dan TUHAN membalas yang baik kepadaku sebagai ganti kutuk orang itu pada hari ini.\""
 },
 {
   "id": 8442,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 13,
   "firman": "Demikianlah Daud melanjutkan perjalanannya dengan orang-orangnya, sedang Simei berjalan terus di lereng gunung bertentangan dengan dia dan sambil berjalan ia mengutuk, melemparinya dengan batu dan menimbulkan debu."
 },
 {
   "id": 8443,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 14,
   "firman": "Dengan lelah sampailah raja dan seluruh rakyat yang ada bersama-sama dengan dia ke Yordan, lalu mereka beristirahat di sana."
 },
 {
   "id": 8444,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 15,
   "firman": "Maka Absalom dan seluruh rakyat, orang-orang Israel, sampailah ke Yerusalem, dan Ahitofel ada bersama-sama dengan dia."
 },
 {
   "id": 8445,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 16,
   "firman": "Ketika Husai, orang Arki, sahabat Daud itu, sampai kepada Absalom, berkatalah Husai kepada Absalom: \"Hiduplah raja! Hiduplah raja!\""
 },
 {
   "id": 8446,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 17,
   "firman": "Berkatalah Absalom kepada Husai: \"Inikah kesetiaanmu kepada sahabatmu? Mengapa engkau tidak pergi menyertai sahabatmu itu?\""
 },
 {
   "id": 8447,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 18,
   "firman": "Lalu berkatalah Husai kepada Absalom: \"Tidak, tetapi dia yang dipilih oleh TUHAN dan oleh rakyat ini dan oleh setiap orang Israel, dialah yang memiliki aku dan bersama-sama dengan dialah aku akan tinggal."
 },
 {
   "id": 8448,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 19,
   "firman": "Lagipula, kepada siapakah aku memperhambakan diri? Bukankah kepada anaknya? Sebagaimana aku memperhambakan diri kepada ayahmu, demikianlah aku memperhambakan diri kepadamu.\""
 },
 {
   "id": 8449,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 20,
   "firman": "Kemudian berkatalah Absalom kepada Ahitofel: \"Berilah nasihat; apakah yang harus kita perbuat?\""
 },
 {
   "id": 8450,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 21,
   "firman": "Lalu jawab Ahitofel kepada Absalom: \"Hampirilah gundik-gundik ayahmu yang ditinggalkannya untuk menunggui istana. Apabila seluruh Israel mendengar, bahwa engkau telah membuat dirimu dibenci oleh ayahmu, maka segala orang yang menyertai engkau, akan dikuatkan hatinya.\""
 },
 {
   "id": 8451,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 22,
   "firman": "Maka dibentangkanlah kemah bagi Absalom di atas sotoh, lalu Absalom menghampiri gundik-gundik ayahnya di depan mata seluruh Israel."
 },
 {
   "id": 8452,
   "kitab": "2Sa",
   "pasal": 16,
   "ayat": 23,
   "firman": "Pada waktu itu nasihat yang diberikan Ahitofel adalah sama dengan petunjuk yang dimintakan dari pada Allah; demikianlah dinilai setiap nasihat Ahitofel, baik oleh Daud maupun oleh Absalom."
 },
 {
   "id": 8453,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 1,
   "firman": "Berkatalah Ahitofel kepada Absalom: \"Izinkanlah aku memilih dua belas ribu orang, maka aku akan bersiap dan mengejar Daud pada malam ini juga."
 },
 {
   "id": 8454,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 2,
   "firman": "Aku akan mendatangi dia, selagi ia lesu dan lemah semangatnya, dan mengejutkan dia; seluruh rakyat yang ada bersama-sama dengan dia akan melarikan diri, maka aku dapat menewaskan raja sendiri."
 },
 {
   "id": 8455,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 3,
   "firman": "Demikianlah aku akan membawa pulang seluruh rakyat itu kepadamu seperti seorang mempelai perempuan kembali kepada suaminya. Jadi, engkau mencari nyawa satu orang saja, sedang seluruh rakyat tetap selamat.\""
 },
 {
   "id": 8456,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 4,
   "firman": "Perkataan ini disetujui oleh Absalom dan oleh semua tua-tua Israel."
 },
 {
   "id": 8457,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 5,
   "firman": "Tetapi berkatalah Absalom: \"Panggillah juga Husai, orang Arki itu, supaya kita mendengar apa yang hendak dikatakannya.\""
 },
 {
   "id": 8458,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 6,
   "firman": "Ketika Husai datang kepada Absalom, berkatalah Absalom kepadanya, demikian: \"Beginilah perkataan yang dikatakan Ahitofel; apakah kita turut nasihatnya? Jika tidak, katakanlah.\""
 },
 {
   "id": 8459,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 7,
   "firman": "Lalu berkatalah Husai kepada Absalom: \"Nasihat yang diberikan Ahitofel kali ini tidak baik.\""
 },
 {
   "id": 8460,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 8,
   "firman": "Kata Husai pula: \"Engkau tahu, bahwa ayahmu dan orang-orangnya adalah pahlawan, dan bahwa mereka sakit hati seperti beruang yang kehilangan anak di padang. Lagipula ayahmu adalah seorang prajurit sejati; ia tidak akan membiarkan rakyat tidur."
 },
 {
   "id": 8461,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 9,
   "firman": "Tentulah ia sekarang bersembunyi dalam salah satu lobang atau di salah satu tempat. Apabila pada penyerangan pertama beberapa orang tewas dan ada orang mendengar hal itu, maka orang akan berkata: Rakyat yang telah mengikut Absalom sudah menderita kekalahan."
 },
 {
   "id": 8462,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 10,
   "firman": "Maka seorang gagah perkasa sekalipun yang hatinya seperti hati singa akan tawar hati sama sekali, sebab seluruh Israel tahu, bahwa ayahmu itu seorang pahlawan dan orang-orang yang bersama-sama dia adalah orang gagah perkasa."
 },
 {
   "id": 8463,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 11,
   "firman": "Sebab itu kunasihatkan: Suruhlah seluruh Israel dari Dan sampai Bersyeba berkumpul kepadamu, seperti pasir di tepi laut banyaknya dan engkau sendiri juga harus turut bertempur."
 },
 {
   "id": 8464,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 12,
   "firman": "Apabila kita mendatangi dia di salah satu tempat, di mana ia terdapat, maka kita akan menyergapnya, seperti embun jatuh ke bumi, sehingga tidak ada yang lolos, baik dia maupun orang-orang yang menyertainya."
 },
 {
   "id": 8465,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 13,
   "firman": "Dan jika ia mengundurkan diri ke suatu kota, maka seluruh Israel akan mengikat kota itu dengan tali, dan kita akan menyeretnya sampai ke sungai, hingga batu kecilpun tidak terdapat lagi di sana.\""
 },
 {
   "id": 8466,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 14,
   "firman": "Lalu berkatalah Absalom dan setiap orang Israel: \"Nasihat Husai, orang Arki itu, lebih baik dari pada nasihat Ahitofel.\" Sebab TUHAN telah memutuskan, bahwa nasihat Ahitofel yang baik itu digagalkan, dengan maksud supaya TUHAN mendatangkan celaka kepada Absalom."
 },
 {
   "id": 8467,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 15,
   "firman": "Sesudah itu berkatalah Husai kepada Zadok dan kepada Abyatar, imam-imam itu: \"Ini dan itu dinasihatkan Ahitofel kepada Absalom dan kepada para tua-tua Israel, tetapi ini dan itu kunasihatkan."
 },
 {
   "id": 8468,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 16,
   "firman": "Oleh sebab itu, suruhlah dengan segera memberitahukan kepada Daud, demikian: Pada malam ini janganlah bermalam di tempat-tempat penyeberangan ke padang gurun, tetapi menyeberanglah dengan segera, supaya jangan raja dan seluruh rakyat yang bersama-sama dengan dia itu ditelan habis.\""
 },
 {
   "id": 8469,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 17,
   "firman": "Yonatan dan Ahimaas menunggu di En-Rogel, dan setiap kali ada seorang budak perempuan yang datang membawa kabar kepada mereka; dan merekapun langsung memberitahu raja Daud, sebab mereka tidak boleh dilihat memasuki kota."
 },
 {
   "id": 8470,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 18,
   "firman": "Tetapi seorang anak melihat mereka, lalu memberitahu Absalom. Jadi pergilah keduanya dengan segera, dan sampailah mereka ke rumah seseorang di Bahurim yang mempunyai sumur di halamannya; maka turunlah mereka ke dalamnya."
 },
 {
   "id": 8471,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 19,
   "firman": "Kemudian perempuan itu mengambil kain tudungan, membentangkannya di atas mulut sumur itu dan menaburkan butir-butir gandum di atasnya, sehingga tidak kelihatan apa-apa."
 },
 {
   "id": 8472,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 20,
   "firman": "Sampailah orang-orang Absalom kepada perempuan itu di rumahnya, lalu bertanya: \"Di manakah Ahimaas dan Yonatan?\" Jawab perempuan itu kepada mereka: \"Mereka telah menyeberangi sungai itu.\" Kemudian mereka mencari, tetapi tidak mendapatnya, lalu pulanglah mereka ke Yerusalem."
 },
 {
   "id": 8473,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 21,
   "firman": "Setelah orang-orang itu pergi, keluarlah keduanya dari sumur, lalu pergi memberitahu raja Daud, kata mereka kepada Daud: \"Bersiaplah dan seberangilah dengan segera sungai ini, sebab ini dan itu dinasihatkan Ahitofel terhadap kamu.\""
 },
 {
   "id": 8474,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 22,
   "firman": "Lalu bersiaplah Daud dan seluruh rakyat yang bersama-sama dengan dia, dan mereka menyeberangi sungai Yordan. Pada waktu fajar tidak ada seorangpun yang ketinggalan, yang tidak menyeberangi sungai Yordan."
 },
 {
   "id": 8475,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 23,
   "firman": "Ketika dilihat Ahitofel, bahwa nasihatnya tidak dipedulikan, dipasangnyalah pelana keledainya, lalu berangkatlah ia ke rumahnya, ke kotanya; ia mengatur urusan rumah tangganya, kemudian menggantung diri. Demikianlah ia mati, lalu ia dikuburkan dalam kuburan ayahnya."
 },
 {
   "id": 8476,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 24,
   "firman": "Maka sampailah Daud ke Mahanaim, ketika Absalom menyeberangi sungai Yordan dengan seluruh orang Israel yang menyertainya."
 },
 {
   "id": 8477,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 25,
   "firman": "Absalom telah mengangkat Amasa menggantikan Yoab untuk mengepalai tentara. Amasa adalah anak seorang yang bernama Yitra, seorang Ismael yang telah memperisteri Abigal binti Nahas, saudara perempuan Zeruya ibu Yoab."
 },
 {
   "id": 8478,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 26,
   "firman": "Lalu orang Israel dan Absalom berkemah di tanah Gilead."
 },
 {
   "id": 8479,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 27,
   "firman": "Ketika Daud tiba di Mahanaim, maka Sobi bin Nahas, dari Raba, kota bani Amon, dan Makhir bin Amiel, dari Lodebar, dan Barzilai, orang Gilead, dari Rogelim, membawa"
 },
 {
   "id": 8480,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 28,
   "firman": "tempat tidur, pasu, periuk belanga, juga gandum, jelai, tepung, bertih gandum, kacang babi, kacang merah besar, kacang merah kecil,"
 },
 {
   "id": 8481,
   "kitab": "2Sa",
   "pasal": 17,
   "ayat": 29,
   "firman": "madu, dadih, kambing domba dan keju lembu bagi Daud dan bagi rakyat yang bersama-sama dengan dia, untuk dimakan, sebab kata mereka: \"Rakyat ini tentu telah menjadi lapar, lelah dan haus di padang gurun.\""
 },
 {
   "id": 8482,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 1,
   "firman": "Daud memeriksa barisan tentara yang bersama-sama dengan dia, kemudian ia mengangkat kepala pasukan seribu dan kepala pasukan seratus atas mereka."
 },
 {
   "id": 8483,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 2,
   "firman": "Lalu Daud menyuruh tentara itu maju berperang, sepertiga di bawah perintah Yoab, sepertiga lagi di bawah perintah Abisai, anak Zeruya, adik Yoab, dan sepertiga lainnya di bawah perintah Itai, orang Gat itu. Lalu berkatalah raja kepada rakyat: \"Aku juga akan maju berperang bersama-sama dengan kamu.\""
 },
 {
   "id": 8484,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 3,
   "firman": "Tetapi tentara itu berkata: \"Janganlah tuanku maju berperang; sebab apabila kami terpaksa melarikan diri, maka mereka tidak akan menghiraukan kami; bahkan sekalipun mati separuh dari pada kami, mereka tidak akan menghiraukan kami; tetapi tuanku sama harganya dengan sepuluh ribu orang dari pada kami. Sebab itu, adalah lebih baik, bahwa tuanku bersedia menolong kami dari kota.\""
 },
 {
   "id": 8485,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 4,
   "firman": "Kemudian berkatalah raja kepada mereka: \"Apa yang kamu pandang baik akan kuperbuat.\" Lalu berdirilah raja di sisi pintu gerbang dan seluruh tentara itu berjalan ke luar, beratus-ratus dan beribu-ribu."
 },
 {
   "id": 8486,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 5,
   "firman": "Dan raja memerintahkan kepada Yoab, Abisai dan Itai, demikian: \"Perlakukanlah Absalom, orang muda itu dengan lunak karena aku.\" Dan seluruh tentara mendengar, ketika raja memberi perintah itu kepada semua kepala pasukan mengenai Absalom."
 },
 {
   "id": 8487,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 6,
   "firman": "Lalu tentara itu maju ke padang menyerang orang Israel, dan terjadilah pertempuran di hutan Efraim."
 },
 {
   "id": 8488,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 7,
   "firman": "Tentara Israel terpukul kalah di sana oleh orang-orang Daud, dan pada hari itu terjadilah di sana pertumpahan darah yang dahsyat: dua puluh ribu orang tewas."
 },
 {
   "id": 8489,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 8,
   "firman": "Kemudian pertempuran meluas dari sana meliputi seluruh daerah itu, dan hutan itu memakan lebih banyak orang di antara tentara dari pada yang dimakan pedang pada hari itu."
 },
 {
   "id": 8490,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 9,
   "firman": "Kebetulan Absalom bertemu dengan orang-orang Daud. Adapun Absalom menunggangi bagal. Ketika bagal itu lewat di bawah jalinan dahan-dahan pohon tarbantin yang besar, tersangkutlah kepalanya pada pohon tarbantin itu, sehingga ia tergantung antara langit dan bumi, sedang bagal yang dikendarainya berlari terus."
 },
 {
   "id": 8491,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 10,
   "firman": "Seseorang melihatnya, lalu memberitahu Yoab, katanya: \"Aku melihat Absalom tergantung pada pohon tarbantin.\""
 },
 {
   "id": 8492,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 11,
   "firman": "Yoab berkata kepada orang yang memberitahu kepadanya itu: \"Apa? Jika engkau melihatnya, mengapa engkau tidak membanting dia ke tanah di tempat itu juga? Maka selayaknya aku memberi engkau sepuluh syikal perak dan satu ikat pinggang.\""
 },
 {
   "id": 8493,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 12,
   "firman": "Tetapi orang itu berkata kepada Yoab: \"Sekalipun aku mendapat seribu syikal perak di telapak tanganku, takkan aku menjamah anak raja itu, sebab di depan telinga kamilah raja memberi perintah kepadamu dan kepada Abisai dan kepada Itai, katanya: Lindungilah Absalom orang muda itu, karena aku."
 },
 {
   "id": 8494,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 13,
   "firman": "Sebaliknya, jika aku mencabut nyawanya dengan khianat tidak ada sesuatupun yang tinggal tersembunyi kepada raja--maka engkau akan menjauhkan diri.\""
 },
 {
   "id": 8495,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 14,
   "firman": "Tetapi Yoab berkata: \"Aku tidak mau membuang-buang waktu dengan kau seperti ini.\" Lalu diambilnyalah tiga lembing dalam tangannya dan ditikamkannya ke dada Absalom, sedang ia masih hidup di tengah-tengah dahan pohon tarbantin itu."
 },
 {
   "id": 8496,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 15,
   "firman": "Kemudian sepuluh bujang, pembawa senjata Yoab, mengelilingi Absalom, lalu memukul dan membunuh dia."
 },
 {
   "id": 8497,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 16,
   "firman": "Sesudah itu Yoab meniup sangkakala, sehingga tentara berhenti mengejar orang Israel; sebab Yoab mau menahan tentaranya itu."
 },
 {
   "id": 8498,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 17,
   "firman": "Lalu mereka mengambil mayat Absalom dan melemparkannya ke dalam lobang yang besar di hutan itu, kemudian mereka mendirikan di atasnya timbunan batu yang sangat besar. Dan seluruh orang Israel melarikan diri, masing-masing ke kemahnya."
 },
 {
   "id": 8499,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 18,
   "firman": "Sewaktu hidupnya Absalom telah mendirikan bagi dirinya sendiri tugu yang sekarang ada di Lembah Raja, sebab katanya: \"Aku tidak ada anak laki-laki untuk melanjutkan ingatan kepada namaku.\" Dan ia telah menamai tugu itu menurut namanya sendiri; sebab itu sampai hari ini tugu itu dinamai orang: tugu peringatan Absalom."
 },
 {
   "id": 8500,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 19,
   "firman": "Kemudian berkatalah Ahimaas bin Zadok: \"Biarlah aku berlari menyampaikan kabar yang baik itu kepada raja, bahwa TUHAN telah memberi keadilan kepadanya dengan melepaskan dia dari tangan musuhnya.\""
 },
 {
   "id": 8501,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 20,
   "firman": "Tetapi berkatalah Yoab kepadanya: \"Pada hari ini bukan engkau yang menjadi pembawa kabar, pada hari lain boleh engkau yang menyampaikan kabar, tetapi pada hari ini engkau tidak akan menyampaikan kabar karena anak raja sudah mati.\""
 },
 {
   "id": 8502,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 21,
   "firman": "Lalu berkatalah Yoab kepada seorang Etiopia: \"Pergilah, beritahukanlah kepada raja apa yang kaulihat.\" Orang Etiopia itu sujud menyembah kepada Yoab, lalu berlari pergi."
 },
 {
   "id": 8503,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 22,
   "firman": "Tetapi berkatalah sekali lagi Ahimaas bin Zadok kepada Yoab: \"Apapun yang terjadi, izinkanlah juga aku berlari pergi menyusul orang Etiopia itu.\" Tetapi kata Yoab: \"Mengapa juga engkau mau berlari pergi, anakku? Apakah engkau membawa kabar yang menguntungkanmu?\""
 },
 {
   "id": 8504,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 23,
   "firman": "Jawabnya: \"Apapun yang terjadi, aku mau berlari pergi.\" Lalu berkatalah Yoab kepadanya: \"Kalau demikian larilah.\" Maka berlarilah Ahimaas mengambil jalan dari Lembah Yordan, sehingga ia mendahului orang Etiopia itu."
 },
 {
   "id": 8505,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 24,
   "firman": "Adapun Daud duduk di antara kedua pintu gerbang sedang penjaga naik ke sotoh pintu gerbang itu, di atas tembok. Ketika ia melayangkan pandangnya, dilihatnyalah orang datang berlari, seorang diri saja."
 },
 {
   "id": 8506,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 25,
   "firman": "Berserulah penjaga memberitahu raja, lalu raja berkata: \"Jika ia seorang diri, maka kabar yang baiklah disampaikannya.\" Sementara orang itu mendekat,"
 },
 {
   "id": 8507,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 26,
   "firman": "penjaga itu melihat seorang lain datang berlari, lalu penjaga itu menyerukan kepada penunggu pintu gerbang, katanya: \"Lihat, ada lagi orang datang berlari, seorang diri.\" Berkatalah raja: \"Itupun pembawa kabar yang baik.\""
 },
 {
   "id": 8508,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 27,
   "firman": "Sesudah itu berkatalah penjaga: \"Aku lihat cara berlari orang yang pertama itu seperti cara berlari Ahimaas bin Zadok.\" Berkatalah raja: \"Itu orang baik, ia datang membawa kabar yang baik.\""
 },
 {
   "id": 8509,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 28,
   "firman": "Lalu Ahimaas berseru, katanya kepada raja: \"Selamat!\" Kemudian sujudlah ia menyembah kepada raja dengan mukanya ke tanah serta berkata: \"Terpujilah TUHAN, Allahmu, yang telah menyerahkan orang-orang yang menggerakkan tangannya melawan tuanku raja.\""
 },
 {
   "id": 8510,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 29,
   "firman": "Lalu bertanyalah raja: \"Selamatkah Absalom, orang muda itu?\" Jawab Ahimaas: \"Aku melihat keributan yang besar, ketika Yoab menyuruh pergi hamba raja, hambamu ini, tetapi aku tidak tahu apa itu.\""
 },
 {
   "id": 8511,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 30,
   "firman": "Kemudian berkatalah raja: \"Pergilah ke samping, berdirilah di sini.\" Ia pergi ke samping dan tinggal berdiri."
 },
 {
   "id": 8512,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 31,
   "firman": "Maka datanglah orang Etiopia itu. Kata orang Etiopia itu: \"Tuanku raja mendapat kabar yang baik, sebab TUHAN telah memberi keadilan kepadamu pada hari ini dengan melepaskan tuanku dari tangan semua orang yang bangkit menentang tuanku.\""
 },
 {
   "id": 8513,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 32,
   "firman": "Tetapi bertanyalah raja kepada orang Etiopia itu: \"Selamatkah Absalom, orang muda itu?\" Jawab orang Etiopia itu: \"Biarlah seperti orang muda itu musuh tuanku raja dan semua orang yang bangkit menentang tuanku untuk berbuat jahat.\""
 },
 {
   "id": 8514,
   "kitab": "2Sa",
   "pasal": 18,
   "ayat": 33,
   "firman": "Maka terkejutlah raja dan dengan sedih ia naik ke anjung pintu gerbang lalu menangis. Dan beginilah perkataannya sambil berjalan: \"Anakku Absalom, anakku, anakku Absalom! Ah, kalau aku mati menggantikan engkau, Absalom, anakku, anakku!\""
 },
 {
   "id": 8515,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 1,
   "firman": "Lalu diberitahukanlah kepada Yoab: \"Ketahuilah, raja menangis dan berkabung karena Absalom.\""
 },
 {
   "id": 8516,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 2,
   "firman": "Pada hari itulah kemenangan menjadi perkabungan bagi seluruh tentara, sebab pada hari itu tentara itu mendengar orang berkata: \"Raja bersusah hati karena anaknya.\""
 },
 {
   "id": 8517,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 3,
   "firman": "Sebab itu tentara itu masuk kota dengan diam-diam pada hari itu, seperti tentara yang kena malu kembali dengan diam-diam karena melarikan diri dari pertempuran."
 },
 {
   "id": 8518,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 4,
   "firman": "Raja menyelubungi mukanya, dan dengan suara nyaring merataplah raja: \"Anakku Absalom, Absalom, anakku, anakku!\""
 },
 {
   "id": 8519,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 5,
   "firman": "Lalu masuklah Yoab menghadap raja di kediamannya serta berkata: \"Pada hari ini engkau mempermalukan semua hambamu, yang telah menyelamatkan nyawamu pada hari ini dan nyawa anak-anakmu laki-laki dan perempuan dan nyawa isteri-isterimu dan nyawa gundik-gundikmu,"
 },
 {
   "id": 8520,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 6,
   "firman": "dengan mencintai orang-orang yang benci kepadamu, dan dengan membenci orang-orang yang cinta kepadamu! Karena pada hari ini engkau menunjukkan bahwa panglima-panglima dan anak buah tidak berarti apa-apa bagimu. Bahkan aku mengerti pada hari ini, bahwa seandainya Absalom masih hidup dan kami semua mati pada hari ini, maka hal itu kaupandang baik."
 },
 {
   "id": 8521,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 7,
   "firman": "Oleh sebab itu, bangunlah, pergilah ke luar dan berbicaralah menenangkan hati orang-orangmu. Sebab aku bersumpah demi TUHAN, apabila engkau tidak keluar, maka seorangpun tidak akan ada yang tinggal bersama-sama dengan engkau pada malam ini; dan hal ini berarti celaka bagimu melebihi segala celaka yang telah kaualami sejak kecilmu sampai sekarang.\""
 },
 {
   "id": 8522,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 8,
   "firman": "Lalu bangunlah raja dan duduk di pintu gerbang. Maka diberitahukanlah kepada seluruh rakyat, demikian: \"Ketahuilah, raja duduk di pintu gerbang.\" Kemudian datanglah seluruh rakyat itu menghadap raja. Adapun orang Israel sudah melarikan diri, masing-masing ke kemahnya."
 },
 {
   "id": 8523,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 9,
   "firman": "Seluruh rakyat dari semua suku Israel berbantah-bantah, katanya: \"Raja telah melepaskan kita dari tangan musuh kita, dialah yang telah menyelamatkan kita dari tangan orang Filistin. Dan sekarang ia sudah melarikan diri dari dalam negeri karena Absalom;"
 },
 {
   "id": 8524,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 10,
   "firman": "tetapi Absalom yang telah kita urapi untuk memerintah kita, sudah mati dalam pertempuran. Maka sekarang, mengapa kamu berdiam diri dengan tidak membawa raja kembali?\""
 },
 {
   "id": 8525,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 11,
   "firman": "Raja Daud telah menyuruh orang kepada Zadok dan Abyatar, imam-imam itu, dengan pesan: \"Berbicaralah kepada para tua-tua Yehuda, demikian: Mengapa kamu menjadi yang terakhir untuk membawa raja kembali ke istananya?\" Sebab perkataan seluruh Israel telah sampai kepada raja."
 },
 {
   "id": 8526,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 12,
   "firman": "\"Kamulah saudara-saudaraku, kamulah darah dagingku; mengapa kamu menjadi yang terakhir untuk membawa raja kembali?"
 },
 {
   "id": 8527,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 13,
   "firman": "Dan kepada Amasa haruslah kamu katakan: Bukankah engkau darah dagingku? Beginilah kiranya Allah menghukum aku, bahkan lebih lagi dari pada itu, jika engkau tidak tetap menjadi panglimaku menggantikan Yoab.\""
 },
 {
   "id": 8528,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 14,
   "firman": "Demikianlah dibelokkannya hati semua orang Yehuda secara serentak, sehingga mereka menyuruh menyampaikan kepada raja pesan ini: \"Kembalilah, tuanku dan semua anak buahmu.\""
 },
 {
   "id": 8529,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 15,
   "firman": "Lalu berangkatlah raja pulang dan sampailah ia ke tepi sungai Yordan. Sementara itu orang Yehuda telah sampai ke Gilgal untuk menyongsong raja dan untuk membawa raja menyeberang sungai Yordan."
 },
 {
   "id": 8530,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 16,
   "firman": "Juga Simei bin Gera, orang Benyamin yang dari Bahurim itu, cepat-cepat datang bersama-sama dengan orang-orang Yehuda untuk menyongsong raja Daud."
 },
 {
   "id": 8531,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 17,
   "firman": "Juga ada seribu orang dari daerah Benyamin bersama-sama dengan dia. Dan Ziba, hamba keluarga Saul, dan kelima belas anaknya laki-laki dan kedua puluh hambanya bersama-sama dengan dia datang tergesa-gesa ke sungai Yordan mendahului raja,"
 },
 {
   "id": 8532,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 18,
   "firman": "lalu menyeberang dari tempat penyeberangan untuk menyeberangkan keluarga raja dan untuk melakukan apa yang dipandangnya baik. Maka Simei bin Gera sujud di depan raja, ketika raja hendak menyeberangi sungai Yordan,"
 },
 {
   "id": 8533,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 19,
   "firman": "dan berkata kepada raja: \"Janganlah kiranya tuanku tetap memandang aku bersalah, dan janganlah kiranya tuanku mengingat kesalahan yang dilakukan hambamu ini pada hari tuanku raja keluar dari Yerusalem; janganlah kiranya raja memperhatikannya lagi."
 },
 {
   "id": 8534,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 20,
   "firman": "Sebab hambamu ini tahu bahwa hamba telah berbuat dosa; dan lihatlah, pada hari ini akulah yang pertama-tama datang dari seluruh keturunan Yusuf untuk menyongsong tuanku raja.\""
 },
 {
   "id": 8535,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 21,
   "firman": "Lalu berbicaralah Abisai, anak Zeruya, katanya: \"Bukankah Simei patut dihukum mati karena ia telah mengutuki orang yang diurapi TUHAN?\""
 },
 {
   "id": 8536,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 22,
   "firman": "Tetapi Daud berkata: \"Apakah urusanku dengan kamu, hai anak-anak Zeruya, sehingga kamu pada hari ini menjadi lawanku? Masakan pada hari ini seorang dihukum mati di Israel! Sebab bukankah aku tahu, bahwa aku pada hari ini adalah raja atas Israel?\""
 },
 {
   "id": 8537,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 23,
   "firman": "Kemudian berkatalah raja kepada Simei: \"Engkau tidak akan mati.\" Lalu raja bersumpah kepadanya."
 },
 {
   "id": 8538,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 24,
   "firman": "Juga Mefiboset bin Saul menyongsong raja. Ia tidak membersihkan kakinya dan tidak memelihara janggutnya dan pakaiannya tidak dicucinya sejak raja pergi sampai hari ia pulang dengan selamat."
 },
 {
   "id": 8539,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 25,
   "firman": "Ketika ia dari Yerusalem menyongsong raja, bertanyalah raja kepadanya: \"Mengapa engkau tidak pergi bersama-sama dengan aku, Mefiboset?\""
 },
 {
   "id": 8540,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 26,
   "firman": "Jawabnya: \"Ya tuanku raja, aku ditipu hambaku. Sebab hambamu ini berkata kepadanya: Pelanailah keledai bagiku, supaya aku menungganginya dan pergi bersama-sama dengan raja! --sebab hambamu ini timpang."
 },
 {
   "id": 8541,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 27,
   "firman": "Ia telah memfitnahkan hambamu ini kepada tuanku raja. Tetapi tuanku raja adalah seperti malaikat Allah; sebab itu perbuatlah apa yang tuanku pandang baik."
 },
 {
   "id": 8542,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 28,
   "firman": "Walaupun seluruh kaum keluargaku tidak lain dari orang-orang yang patut dihukum mati oleh tuanku raja, tuanku telah mengangkat hambamu ini di antara orang-orang yang menerima rezeki dari istanamu. Apakah hakku lagi dan untuk apa aku mengadakan tuntutan lagi kepada raja?\""
 },
 {
   "id": 8543,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 29,
   "firman": "Tetapi raja berkata kepadanya: \"Apa gunanya engkau berkata-kata lagi tentang halmu? Aku telah memutuskan: Engkau dan Ziba harus berbagi ladang itu.\""
 },
 {
   "id": 8544,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 30,
   "firman": "Lalu berkatalah Mefiboset kepada raja: \"Biarlah ia mengambil semuanya, sebab tuanku raja sudah pulang dengan selamat.\""
 },
 {
   "id": 8545,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 31,
   "firman": "Juga Barzilai, orang Gilead itu, telah datang dari Ragelim dan ikut bersama-sama raja ke sungai Yordan untuk mengantarkannya sampai di sana."
 },
 {
   "id": 8546,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 32,
   "firman": "Barzilai itu sudah sangat tua, delapan puluh tahun umurnya. Ia menyediakan makanan bagi raja selama ia tinggal di Mahanaim, sebab ia seorang yang sangat kaya."
 },
 {
   "id": 8547,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 33,
   "firman": "Berkatalah raja kepada Barzilai: \"Ikutlah aku, aku akan memelihara engkau di tempatku di Yerusalem.\""
 },
 {
   "id": 8548,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 34,
   "firman": "Tetapi Barzilai menjawab raja: \"Berapa tahun lagikah aku hidup, sehingga aku harus pergi bersama-sama dengan raja ke Yerusalem?"
 },
 {
   "id": 8549,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 35,
   "firman": "Sekarang ini aku telah berumur delapan puluh tahun; masakan aku masih dapat membedakan antara yang baik dan yang tidak baik? Atau masih dapatkah hambamu ini merasai apa yang hamba makan atau apa yang hamba minum? Atau masih dapatkah aku mendengarkan suara penyanyi laki-laki dan penyanyi perempuan? Apa gunanya hambamu ini lagi menjadi beban bagi tuanku raja?"
 },
 {
   "id": 8550,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 36,
   "firman": "Sepotong jalan saja hambamu ini berjalan ke seberang sungai Yordan bersama-sama dengan raja. Mengapa raja memberikan ganjaran yang sedemikian kepadaku?"
 },
 {
   "id": 8551,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 37,
   "firman": "Biarkanlah hambamu ini pulang, sehingga aku dapat mati di kotaku sendiri, dekat kubur ayahku dan ibuku. Tetapi inilah hambamu Kimham, ia boleh ikut dengan tuanku raja; perbuatlah kepadanya apa yang tuanku pandang baik.\""
 },
 {
   "id": 8552,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 38,
   "firman": "Lalu berbicaralah raja: \"Baiklah Kimham ikut dengan aku; aku akan berbuat kepadanya apa yang kaupandang baik, dan segala yang kaukehendaki dari padaku akan kulakukan untukmu.\""
 },
 {
   "id": 8553,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 39,
   "firman": "Kemudian seluruh rakyat menyeberangi sungai Yordan. Juga raja menyeberang, setelah berpamitan dengan Barzilai dengan ciuman. Lalu orang inipun pulanglah ke tempat kediamannya."
 },
 {
   "id": 8554,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 40,
   "firman": "Sesudah itu berjalanlah raja terus ke Gilgal, dan Kimham ikut dengan dia. Seluruh rakyat Yehuda bersama-sama setengah dari rakyat Israel telah mengantarkan raja."
 },
 {
   "id": 8555,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 41,
   "firman": "Tetapi seluruh orang Israel datang menghadap raja dan berkata kepada raja: \"Mengapa saudara-saudara kami, orang-orang Yehuda itu, menculik raja dan membawa dia menyeberangi sungai Yordan dengan keluarganya dan semua orang Daud yang menyertai dia?\""
 },
 {
   "id": 8556,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 42,
   "firman": "Lalu semua orang Yehuda menjawab orang-orang Israel itu: \"Oleh karena raja kerabat kami. Mengapa kamu menjadi marah karena hal ini? Apakah kami makan apa-apa atas biaya raja? Apakah kami mendapat keuntungan?\""
 },
 {
   "id": 8557,
   "kitab": "2Sa",
   "pasal": 19,
   "ayat": 43,
   "firman": "Tetapi orang-orang Israel itu menjawab orang-orang Yehuda: \"Kami sepuluh kali lebih berhak atas raja. Sebagai anak sulung kami melebihi kamu. Mengapa kamu memandang kami rendah? Bukankah kami yang pertama-tama harus membawa raja kami kembali?\" Tetapi perkataan orang-orang Yehuda itu lebih pedas dari pada perkataan orang-orang Israel."
 },
 {
   "id": 8558,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 1,
   "firman": "Kebetulan ada di sana seorang dursila, bernama Seba bin Bikri, orang Benyamin. Ia meniup sangkakala serta berkata: \"Kita tidak memperoleh bagian dari pada Daud. Kita tidak memperoleh warisan dari anak Isai itu. Masing-masing ke kemahnya, hai orang Israel!\""
 },
 {
   "id": 8559,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 2,
   "firman": "Lalu semua orang Israel itu meninggalkan Daud dan mengikuti Seba bin Bikri, sedangkan orang-orang Yehuda tetap berpaut kepada raja mereka, mengikutinya dari sungai Yordan sampai Yerusalem."
 },
 {
   "id": 8560,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 3,
   "firman": "Sampailah Daud ke istananya di Yerusalem, lalu raja mengambil kesepuluh gundik yang ditinggalkannya untuk menunggui istana, kemudian dimasukkannya mereka dalam sebuah rumah di bawah penjagaan. Ia memelihara mereka, tetapi tidak dihampirinya. Mereka tetap terasing seperti janda sampai hari mati mereka."
 },
 {
   "id": 8561,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 4,
   "firman": "Berkatalah raja kepada Amasa: \"Kerahkanlah bagiku orang-orang Yehuda dalam tiga hari, kemudian menghadaplah lagi ke mari!\""
 },
 {
   "id": 8562,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 5,
   "firman": "Lalu pergilah Amasa mengerahkan orang Yehuda, tetapi ia menunda-nunda tugas itu sampai melewati waktu yang ditetapkan raja baginya."
 },
 {
   "id": 8563,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 6,
   "firman": "Lalu berkatalah Daud kepada Abisai: \"Sekarang Seba bin Bikri lebih berbahaya bagi kita dari pada Absalom; jadi engkau, bawalah orang-orang tuanmu ini dan kejarlah dia, supaya jangan ia mencapai kota yang berkubu, dan dengan demikian ia luput dari pada kita.\""
 },
 {
   "id": 8564,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 7,
   "firman": "Lalu Yoab, orang Kreti dan orang Pleti dan semua pahlawan keluar menyusul dia. Mereka keluar dari Yerusalem untuk mengejar Seba bin Bikri."
 },
 {
   "id": 8565,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 8,
   "firman": "Ketika mereka sampai ke batu besar yang di Gibeon, maka Amasa sudah tiba di sana lebih dahulu dari pada mereka. Adapun Yoab mengenakan pakaian perang dan di luarnya ada ikat pinggang dengan pedang bersarung terpaut pada pinggangnya. Ketika ia tampil ke muka terjatuhlah pedang itu."
 },
 {
   "id": 8566,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 9,
   "firman": "Berkatalah Yoab kepada Amasa: \"Engkau baik-baik, saudaraku?\" Sementara itu tangan kanan Yoab memegang janggut Amasa untuk mencium dia."
 },
 {
   "id": 8567,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 10,
   "firman": "Amasa tidak awas terhadap pedang yang ada di tangan Yoab itu; Yoab menikam pedang itu ke perutnya, sehingga isi perutnya tertumpah ke tanah. Tidak usah dia ditikamnya dua kali, sebab ia sudah mati. Lalu Yoab dan Abisai, adiknya, terus mengejar Seba bin Bikri."
 },
 {
   "id": 8568,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 11,
   "firman": "Dan seorang dari orang-orang Yoab tinggal berdiri di dekat mayat itu, sambil berkata: \"Siapa yang suka kepada Yoab dan siapa yang memihak kepada Daud, baiklah mengikuti Yoab!\""
 },
 {
   "id": 8569,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 12,
   "firman": "Dalam pada itu Amasa terguling mati dalam darahnya di tengah-tengah jalan raya. Ketika orang itu melihat, bahwa seluruh rakyat berdiri menonton, maka disingkirkannya mayat Amasa dari jalan raya ke padang, lalu dihamparkannya kain di atasnya, karena dilihatnya, bahwa setiap orang yang datang ke sana berdiri menonton."
 },
 {
   "id": 8570,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 13,
   "firman": "Setelah dijauhkannya mayat itu dari jalan raya, maka semua orang itu berjalan terus mengikuti Yoab untuk mengejar Seba bin Bikri."
 },
 {
   "id": 8571,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 14,
   "firman": "Seba telah melintasi daerah semua suku Israel menuju Abel-Bet-Maakha. Dan semua orang Bikri telah berkumpul dan mengikuti dia."
 },
 {
   "id": 8572,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 15,
   "firman": "Tetapi sampailah orang-orang Yoab, lalu mengepung dia di Abel-Bet-Maakha; mereka menimbun tanah menjadi tembok terhadap kota ini dan tembok ini merapat sampai ke tembok luar sedang seluruh rakyat yang bersama-sama dengan Yoab menggali tembok kota itu untuk meruntuhkannya."
 },
 {
   "id": 8573,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 16,
   "firman": "Lalu berserulah seorang perempuan bijaksana dari kota itu: \"Dengar! Dengar! Katakanlah kepada Yoab: Mendekatlah ke mari, supaya aku berbicara dengan engkau.\""
 },
 {
   "id": 8574,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 17,
   "firman": "Maka mendekatlah Yoab kepada perempuan itu. Bertanyalah perempuan itu: \"Engkaukah Yoab?\" Jawabnya: \"Benar!\" Lalu berkatalah perempuan itu kepadanya: \"Dengarkanlah perkataan hambamu ini!\" Jawabnya: \"Baik!\""
 },
 {
   "id": 8575,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 18,
   "firman": "Kemudian berkatalah perempuan itu: \"Dahulu biasa orang berkata begini: Baiklah orang minta petunjuk di Abel dan di Dan, apakah sudah dihapuskan"
 },
 {
   "id": 8576,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 19,
   "firman": "apa yang telah ditetapkan oleh orang-orang yang setia di Israel! Tetapi engkau ini berikhtiar membinasakan suatu kota, apalagi suatu kota induk di Israel. Mengapa engkau hendak menelan habis milik pusaka TUHAN?\""
 },
 {
   "id": 8577,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 20,
   "firman": "Lalu Yoab menjawab: \"Jauhlah, jauhlah dari padaku untuk menelan dan memusnahkan!"
 },
 {
   "id": 8578,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 21,
   "firman": "Bukanlah begitu halnya. Tetapi seorang dari pegunungan Efraim, yang bernama Seba bin Bikri, telah menggerakkan tangannya melawan raja Daud; serahkanlah dia seorang diri, maka aku akan undur dari kota ini.\" Lalu berkatalah perempuan itu kepada Yoab: \"Baik, kepalanya akan dilemparkan kepadamu dari belakang tembok ini.\""
 },
 {
   "id": 8579,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 22,
   "firman": "Kemudian masuklah pula perempuan itu dan berbicara kepada seluruh rakyat dengan bijaksana; sesudah itu mereka memenggal kepala Seba bin Bikri dan melemparkannya kepada Yoab. Yoab meniup sangkakala, lalu berserak-seraklah mereka meninggalkan kota itu, masing-masing ke tempatnya. Maka pulanglah Yoab ke Yerusalem kepada raja."
 },
 {
   "id": 8580,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 23,
   "firman": "Yoab menjadi kepala atas segenap tentara Israel, dan Benaya bin Yoyada menjadi kepala atas orang Kreti dan orang Pleti."
 },
 {
   "id": 8581,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 24,
   "firman": "Adoram menjadi kepala orang rodi dan Yosafat bin Ahilud menjadi bendahara negara."
 },
 {
   "id": 8582,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 25,
   "firman": "Seya menjadi panitera negara; Zadok dan Abyatar menjadi imam."
 },
 {
   "id": 8583,
   "kitab": "2Sa",
   "pasal": 20,
   "ayat": 26,
   "firman": "Juga Ira, orang Yair itu menjadi imam pada Daud."
 },
 {
   "id": 8584,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 1,
   "firman": "Dalam zaman Daud terjadilah kelaparan selama tiga tahun berturut-turut, lalu Daud pergi menanyakan petunjuk TUHAN. Berfirmanlah TUHAN: \"Pada Saul dan keluarganya melekat hutang darah, karena ia telah membunuh orang-orang Gibeon.\""
 },
 {
   "id": 8585,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 2,
   "firman": "Lalu raja memanggil orang-orang Gibeon dan berkata kepada mereka, --orang-orang Gibeon itu tidak termasuk orang Israel, tetapi termasuk sisa-sisa orang Amori dan walaupun orang Israel telah bersumpah kepada mereka, Saul berikhtiar membasmi mereka dalam kegiatannya untuk kepentingan orang Israel dan Yehuda, --"
 },
 {
   "id": 8586,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 3,
   "firman": "Daud berkata kepada orang-orang Gibeon itu: \"Apakah yang dapat kuperbuat bagimu dan dengan apakah dapat kuadakan penebusan, supaya kamu memberkati milik pusaka TUHAN?\""
 },
 {
   "id": 8587,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 4,
   "firman": "Lalu berkatalah orang-orang Gibeon itu kepadanya: \"Bukanlah perkara emas dan perak urusan kami dengan Saul serta keluarganya, juga bukanlah urusan kami untuk membunuh seseorang di antara orang Israel.\" Tetapi kata Daud: \"Apakah yang kamu kehendaki akan kuperbuat bagimu?\""
 },
 {
   "id": 8588,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 5,
   "firman": "Sesudah itu berkatalah mereka kepada raja: \"Dari orang yang hendak membinasakan kami dan yang bermaksud memunahkan kami, sehingga kami tidak mendapat tempat di manapun di daerah Israel,"
 },
 {
   "id": 8589,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 6,
   "firman": "biarlah diserahkan tujuh orang anaknya laki-laki kepada kami, supaya kami menggantung mereka di hadapan TUHAN di Gibeon, di bukit TUHAN.\" Lalu berkatalah raja: \"Aku akan menyerahkan mereka.\""
 },
 {
   "id": 8590,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 7,
   "firman": "Tetapi raja merasa sayang kepada Mefiboset bin Yonatan bin Saul, karena sumpah demi TUHAN ada di antara mereka, di antara Daud dan Yonatan bin Saul."
 },
 {
   "id": 8591,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 8,
   "firman": "Lalu raja mengambil kedua anak laki-laki Rizpa binti Aya, yang dilahirkannya bagi Saul, yakni Armoni dan Mefiboset, dan kelima anak laki-laki Merab binti Saul, yang dilahirkannya bagi Adriel bin Barzilai, orang Mehola itu,"
 },
 {
   "id": 8592,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 9,
   "firman": "kemudian diserahkannyalah mereka ke dalam tangan orang-orang Gibeon itu. Orang-orang ini menggantung mereka di atas bukit, di hadapan TUHAN. Ketujuh orang itu tewas bersama-sama. Mereka telah dihukum mati pada awal musim menuai, pada permulaan musim menuai jelai."
 },
 {
   "id": 8593,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 10,
   "firman": "Lalu Rizpa binti Aya mengambil kain karung, dan membentangkannya bagi dirinya di atas gunung batu, dari permulaan musim menuai sampai tercurah air dari langit ke atas mayat mereka; ia tidak membiarkan burung-burung di udara mendatangi mayat mereka pada siang hari, ataupun binatang-binatang di hutan pada malam hari."
 },
 {
   "id": 8594,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 11,
   "firman": "Ketika diberitahukan kepada Daud apa yang diperbuat Rizpa binti Aya, gundik Saul itu,"
 },
 {
   "id": 8595,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 12,
   "firman": "maka pergilah Daud mengambil tulang-tulang Saul dan tulang-tulang Yonatan, anaknya, dari warga-warga kota Yabesh-Gilead, yang telah mencuri tulang-tulang itu dari tanah lapang di Bet-San, tempat orang Filistin menggantung mereka, ketika orang Filistin memukul Saul kalah di Gilboa."
 },
 {
   "id": 8596,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 13,
   "firman": "Ia membawa dari sana tulang-tulang Saul dan tulang-tulang Yonatan, anaknya. Dikumpulkanlah juga tulang-tulang orang-orang yang digantung tadi,"
 },
 {
   "id": 8597,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 14,
   "firman": "lalu dikuburkan bersama-sama tulang-tulang Saul dan Yonatan, anaknya, di tanah Benyamin, di Zela, di dalam kubur Kish, ayahnya. Orang melakukan segala sesuatu yang diperintahkan raja, maka sesudah itu Allah mengabulkan doa untuk negeri itu."
 },
 {
   "id": 8598,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 15,
   "firman": "Ketika terjadi lagi peperangan antara orang Filistin dan orang Israel, maka berangkatlah Daud bersama-sama dengan orang-orangnya, lalu berperang melawan orang Filistin, sampai Daud menjadi letih lesu."
 },
 {
   "id": 8599,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 16,
   "firman": "Yisbi-Benob, yang termasuk keturunan raksasa--berat tombaknya tiga ratus syikal tembaga dan ia menyandang pedang yang baru--menyangka dapat menewaskan Daud."
 },
 {
   "id": 8600,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 17,
   "firman": "Tetapi Abisai, anak Zeruya, datang menolong Daud, lalu merobohkan dan membunuh orang Filistin itu. Pada waktu itu orang-orang Daud memohon dengan sangat kepadanya, kata mereka: \"Janganlah lagi engkau maju berperang bersama-sama dengan kami, supaya keturunan Israel jangan punah bersama-sama engkau.\""
 },
 {
   "id": 8601,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 18,
   "firman": "Sesudah itu terjadi lagi pertempuran melawan orang Filistin di Gob; pada waktu itu Sibkhai, orang Husa, memukul kalah Saf, yang termasuk keturunan raksasa."
 },
 {
   "id": 8602,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 19,
   "firman": "Dan terjadi lagi pertempuran melawan orang Filistin, di Gob; Elhanan bin Yaare-Oregim, orang Betlehem itu, menewaskan Goliat, orang Gat itu, yang gagang tombaknya seperti pesa tukang tenun."
 },
 {
   "id": 8603,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 20,
   "firman": "Lalu terjadi lagi pertempuran di Gat; dan di sana ada seorang yang tinggi perawakannya, yang tangannya dan kakinya masing-masing berjari enam: dua puluh empat seluruhnya; juga orang ini termasuk keturunan raksasa."
 },
 {
   "id": 8604,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 21,
   "firman": "Ia mengolok-olok orang Israel, maka Yonatan, anak Simea kakak Daud, menewaskannya."
 },
 {
   "id": 8605,
   "kitab": "2Sa",
   "pasal": 21,
   "ayat": 22,
   "firman": "Keempat orang ini termasuk keturunan raksasa di Gat; mereka tewas oleh tangan Daud dan oleh tangan orang-orangnya."
 },
 {
   "id": 8606,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 1,
   "firman": "Daud mengatakan perkataan nyanyian ini kepada TUHAN pada waktu TUHAN telah melepaskan dia dari cengkeraman semua musuhnya dan dari cengkeraman Saul."
 },
 {
   "id": 8607,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 2,
   "firman": "Ia berkata: \"Ya, TUHAN, bukit batuku, kubu pertahananku dan penyelamatku,"
 },
 {
   "id": 8608,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 3,
   "firman": "Allahku, gunung batuku, tempat aku berlindung, perisaiku, tanduk keselamatanku, kota bentengku, tempat pelarianku, juruselamatku; Engkau menyelamatkan aku dari kekerasan."
 },
 {
   "id": 8609,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 4,
   "firman": "Terpujilah TUHAN, seruku; maka akupun selamat dari pada musuhku."
 },
 {
   "id": 8610,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 5,
   "firman": "Sesungguhnya gelora-gelora maut telah mengelilingi aku, banjir-banjir jahanam telah menimpa aku,"
 },
 {
   "id": 8611,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 6,
   "firman": "tali-tali dunia orang mati telah membelit aku, perangkap-perangkap maut terpasang di depanku."
 },
 {
   "id": 8612,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 7,
   "firman": "Ketika aku dalam kesesakan, aku berseru kepada TUHAN, kepada Allahku aku berseru. Dan Ia mendengar suaraku dari bait-Nya, teriakku minta tolong masuk ke telinga-Nya."
 },
 {
   "id": 8613,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 8,
   "firman": "Lalu bergoyang dan bergoncanglah bumi, dasar-dasar langit gemetar dan bergoyang, oleh karena bernyala-nyala murka-Nya."
 },
 {
   "id": 8614,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 9,
   "firman": "Asap membubung dari hidung-Nya, api menjilat keluar dari mulut-Nya, bara menyala keluar dari pada-Nya."
 },
 {
   "id": 8615,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 10,
   "firman": "Ia menekukkan langit, lalu turun, kekelaman ada di bawah kaki-Nya."
 },
 {
   "id": 8616,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 11,
   "firman": "Ia mengendarai kerub, lalu terbang, dan tampak di atas sayap angin."
 },
 {
   "id": 8617,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 12,
   "firman": "Dan Ia membuat kegelapan di sekeliling-Nya menjadi pondok-Nya: air hujan yang gelap, awan yang tebal."
 },
 {
   "id": 8618,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 13,
   "firman": "Karena sinar kilat di hadapan-Nya bara api menjadi menyala."
 },
 {
   "id": 8619,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 14,
   "firman": "TUHAN mengguntur dari langit, Yang Mahatinggi memperdengarkan suara-Nya."
 },
 {
   "id": 8620,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 15,
   "firman": "Dilepaskan-Nya panah-panah, sehingga diserakkan-Nya mereka, yakni kilat-kilat, sehingga dikacaukan-Nya mereka."
 },
 {
   "id": 8621,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 16,
   "firman": "Lalu kelihatanlah dasar-dasar laut, alas-alas dunia tersingkap karena hardikan TUHAN karena hembusan nafas dari hidung-Nya."
 },
 {
   "id": 8622,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 17,
   "firman": "Ia menjangkau dari tempat tinggi, mengambil aku, menarik aku dari banjir."
 },
 {
   "id": 8623,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 18,
   "firman": "Ia melepaskan aku dari musuhku yang gagah, dari pada orang-orang yang membenci aku, karena mereka terlalu kuat bagiku."
 },
 {
   "id": 8624,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 19,
   "firman": "Mereka menghadang aku pada hari sialku, tetapi TUHAN adalah sandaran bagiku;"
 },
 {
   "id": 8625,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 20,
   "firman": "Ia membawa aku keluar ke tempat lapang, Ia menyelamatkan aku, karena Ia berkenan kepadaku."
 },
 {
   "id": 8626,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 21,
   "firman": "TUHAN memperlakukan aku sesuai dengan kebenaranku; Ia membalas kepadaku sesuai dengan kesucian tanganku,"
 },
 {
   "id": 8627,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 22,
   "firman": "sebab aku tetap mengikuti jalan TUHAN dan tidak menjauhkan diri dari Allahku sebagai orang fasik."
 },
 {
   "id": 8628,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 23,
   "firman": "Sebab segala hukum-Nya kuperhatikan, dan dari ketetapan-Nya aku tidak menyimpang;"
 },
 {
   "id": 8629,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 24,
   "firman": "aku berlaku tidak bercela kepada-Nya dan menjaga diri terhadap kesalahan."
 },
 {
   "id": 8630,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 25,
   "firman": "Karena itu TUHAN membalas kepadaku sesuai dengan kebenaranku, sesuai dengan kesucianku di depan mata-Nya."
 },
 {
   "id": 8631,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 26,
   "firman": "Terhadap orang yang setia Engkau berlaku setia, terhadap orang yang tidak bercela Engkau berlaku tidak bercela,"
 },
 {
   "id": 8632,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 27,
   "firman": "terhadap orang yang suci Engkau berlaku suci, tetapi terhadap orang yang bengkok Engkau berlaku belat-belit."
 },
 {
   "id": 8633,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 28,
   "firman": "Bangsa yang tertindas Engkau selamatkan, tetapi mata-Mu melawan orang-orang yang tinggi hati, supaya mereka Kaurendahkan."
 },
 {
   "id": 8634,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 29,
   "firman": "Karena Engkaulah pelitaku, ya TUHAN, dan TUHAN menyinari kegelapanku."
 },
 {
   "id": 8635,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 30,
   "firman": "Karena dengan Engkau aku berani menghadapi gerombolan, dengan Allahku aku berani melompati tembok."
 },
 {
   "id": 8636,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 31,
   "firman": "Adapun Allah, jalan-Nya sempurna; sabda TUHAN itu murni; Dia menjadi perisai bagi semua orang yang berlindung pada-Nya."
 },
 {
   "id": 8637,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 32,
   "firman": "Sebab siapakah Allah selain dari TUHAN, dan siapakah gunung batu selain dari Allah kita?"
 },
 {
   "id": 8638,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 33,
   "firman": "Allah, Dialah yang menjadi tempat pengungsianku yang kuat dan membuat jalanku rata;"
 },
 {
   "id": 8639,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 34,
   "firman": "yang membuat kakiku seperti kaki rusa dan membuat aku berdiri di bukit;"
 },
 {
   "id": 8640,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 35,
   "firman": "yang mengajar tanganku berperang, sehingga lenganku dapat melengkungkan busur tembaga."
 },
 {
   "id": 8641,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 36,
   "firman": "Juga Kauberikan kepadaku perisai keselamatan-Mu, dan kebaikan-Mu telah membuat aku besar."
 },
 {
   "id": 8642,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 37,
   "firman": "Kauberikan tempat lapang untuk langkahku, dan mata kakiku tidak goyah."
 },
 {
   "id": 8643,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 38,
   "firman": "Aku mengejar musuhku sampai mereka kupunahkan, dan tidak berbalik sebelum mereka kuhabiskan;"
 },
 {
   "id": 8644,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 39,
   "firman": "aku menghabiskan dan meremukkan mereka, sehingga mereka tidak bangkit lagi, dan mereka rebah di bawah kakiku."
 },
 {
   "id": 8645,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 40,
   "firman": "Engkau telah mengikat pinggangku dengan keperkasaan untuk berperang, Engkau tundukkan ke bawah kuasaku orang yang bangkit melawan aku."
 },
 {
   "id": 8646,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 41,
   "firman": "Kaubuat musuhku lari dari padaku, orang-orang yang membenci aku, mereka kubinasakan."
 },
 {
   "id": 8647,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 42,
   "firman": "Mereka berteriak minta tolong, tetapi tidak ada yang menyelamatkan, mereka berteriak kepada TUHAN, tetapi Ia tidak menjawab mereka."
 },
 {
   "id": 8648,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 43,
   "firman": "Aku menggiling mereka halus-halus seperti debu tanah, aku menumbuk mereka dan menginjak-injak mereka seperti lumpur di jalan."
 },
 {
   "id": 8649,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 44,
   "firman": "Dan Engkau meluputkan aku dari perbantahan bangsaku; Engkau memelihara aku sebagai kepala atas bangsa-bangsa; bangsa yang tidak kukenal menjadi hambaku;"
 },
 {
   "id": 8650,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 45,
   "firman": "orang-orang asing tunduk menjilat kepadaku, baru saja telinga mereka mendengar, mereka taat kepadaku."
 },
 {
   "id": 8651,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 46,
   "firman": "Orang-orang asing pucat layu dan keluar dari kota kubunya dengan gemetar."
 },
 {
   "id": 8652,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 47,
   "firman": "TUHAN hidup! Terpujilah gunung batuku, dan ditinggikanlah kiranya Allah gunung batu keselamatanku,"
 },
 {
   "id": 8653,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 48,
   "firman": "Allah, yang telah mengadakan pembalasan bagiku, yang telah membawa bangsa-bangsa ke bawah kuasaku,"
 },
 {
   "id": 8654,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 49,
   "firman": "dan yang telah membebaskan aku dari pada musuhku. Dan Engkau telah meninggikan aku mengatasi mereka yang bangkit melawan aku; Engkau telah melepaskan aku dari para penindas."
 },
 {
   "id": 8655,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 50,
   "firman": "Sebab itu aku mau menyanyikan syukur bagi-Mu, ya TUHAN, di antara bangsa-bangsa, dan aku mau menyanyikan mazmur bagi nama-Mu."
 },
 {
   "id": 8656,
   "kitab": "2Sa",
   "pasal": 22,
   "ayat": 51,
   "firman": "Ia mengaruniakan keselamatan yang besar kepada raja yang diangkat-Nya, dan menunjukkan kasih setia kepada orang yang diurapi-Nya, kepada Daud dan anak cucunya untuk selamanya.\""
 },
 {
   "id": 8657,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 1,
   "firman": "Inilah perkataan Daud yang terakhir: \"Tutur kata Daud bin Isai dan tutur kata orang yang diangkat tinggi, orang yang diurapi Allah Yakub, pemazmur yang disenangi di Israel:"
 },
 {
   "id": 8658,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 2,
   "firman": "Roh TUHAN berbicara dengan perantaraanku, firman-Nya ada di lidahku;"
 },
 {
   "id": 8659,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 3,
   "firman": "Allah Israel berfirman, gunung batu Israel berkata kepadaku: Apabila seorang memerintah manusia dengan adil, memerintah dengan takut akan Allah,"
 },
 {
   "id": 8660,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 4,
   "firman": "ia bersinar seperti fajar di waktu pagi, pagi yang tidak berawan, yang sesudah hujan membuat berkilauan rumput muda di tanah."
 },
 {
   "id": 8661,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 5,
   "firman": "Bukankah seperti itu keluargaku di hadapan Allah? Sebab Ia menegakkan bagiku suatu perjanjian kekal, teratur dalam segala-galanya dan terjamin. Sebab segala keselamatanku dan segala kesukaanku bukankah Dia yang menumbuhkannya?"
 },
 {
   "id": 8662,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 6,
   "firman": "Tetapi orang-orang yang dursila mereka semuanya seperti duri yang dihamburkan; sesungguhnya, mereka tidak terpegang oleh tangan:"
 },
 {
   "id": 8663,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 7,
   "firman": "tidak ada orang yang dapat mengusik mereka, kecuali dengan sebatang besi atau gagang tombak, dan dengan api mereka dibakar habis!\""
 },
 {
   "id": 8664,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 8,
   "firman": "Inilah nama para pahlawan yang mengiringi Daud: Isybaal, orang Hakhmoni, kepala triwira; ia mengayunkan tombaknya melawan delapan ratus orang yang tertikam mati dalam satu pertempuran."
 },
 {
   "id": 8665,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 9,
   "firman": "Dan sesudah dia, Eleazar anak Dodo, anak seorang Ahohi; ia termasuk ketiga pahlawan itu. Ia ada bersama-sama Daud, ketika mereka mengolok-olok orang Filistin, yang telah berkumpul di sana untuk berperang, padahal orang-orang Israel telah mengundurkan diri."
 },
 {
   "id": 8666,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 10,
   "firman": "Tetapi ia bangkit dan membunuh demikian banyak orang Filistin sampai tangannya lesu dan tinggal melekat pada pedangnya. TUHAN memberikan pada hari itu kemenangan yang besar. Rakyat datang kembali mengikuti dia, hanya untuk merampas."
 },
 {
   "id": 8667,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 11,
   "firman": "Sesudah dia, Sama, anak Age, orang Harari. Ketika orang Filistin berkumpul di Lehi--di sana ada sebidang tanah ladang penuh kacang merah--dan tentara telah melarikan diri dari hadapan orang Filistin,"
 },
 {
   "id": 8668,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 12,
   "firman": "maka berdirilah ia di tengah-tengah ladang itu, ia dapat mempertahankannya dan memukul kalah orang Filistin. Demikianlah diberikan TUHAN kemenangan yang besar."
 },
 {
   "id": 8669,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 13,
   "firman": "Sekali datanglah tiga orang dari ketiga puluh kepala mendapatkan Daud, menjelang musim menuai, dekat gua Adulam, sedang sepasukan orang Filistin berkemah di lembah Refaim."
 },
 {
   "id": 8670,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 14,
   "firman": "Pada waktu itu Daud ada di dalam kubu gunung dan pasukan pendudukan orang Filistin pada waktu itu ada di Betlehem."
 },
 {
   "id": 8671,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 15,
   "firman": "Lalu timbullah keinginan pada Daud, dan ia berkata: \"Sekiranya ada orang yang memberi aku minum air dari perigi Betlehem yang ada dekat pintu gerbang!\""
 },
 {
   "id": 8672,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 16,
   "firman": "Lalu ketiga pahlawan itu menerobos perkemahan orang Filistin, mereka menimba air dari perigi Betlehem yang ada dekat pintu gerbang, mengangkatnya dan membawanya kepada Daud. Tetapi Daud tidak mau meminumnya, melainkan mempersembahkannya sebagai korban curahan kepada TUHAN,"
 },
 {
   "id": 8673,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 17,
   "firman": "katanya: \"Jauhlah dari padaku, ya TUHAN, untuk berbuat demikian! Bukankah ini darah orang-orang yang telah pergi dengan mempertaruhkan nyawanya?\" Dan tidak mau ia meminumnya. Itulah yang dilakukan ketiga pahlawan itu."
 },
 {
   "id": 8674,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 18,
   "firman": "Abisai, adik Yoab, anak Zeruya, dialah kepala ketiga puluh orang itu. Dan dialah yang mengayunkan tombaknya melawan tiga ratus orang yang mati ditikamnya; ia mendapat nama di antara ketiga puluh orang itu."
 },
 {
   "id": 8675,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 19,
   "firman": "Bukankah ia yang paling dihormati di antara ketiga puluh orang itu? Memang ia menjadi pemimpin mereka, tetapi ia tidak dapat menyamai triwira itu."
 },
 {
   "id": 8676,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 20,
   "firman": "Selanjutnya Benaya bin Yoyada, anak seorang yang gagah perkasa, yang besar jasanya, yang berasal dari Kabzeel; ia menewaskan kedua pahlawan besar dari Moab. Juga pernah ia turun ke dalam lobang dan membunuh seekor singa pada suatu hari bersalju."
 },
 {
   "id": 8677,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 21,
   "firman": "Pula ia membunuh seorang Mesir, seorang yang tinggi perawakannya; di tangan orang Mesir itu ada tombak, tetapi ia mendatanginya dengan tongkat, merampas tombak itu dari tangan orang Mesir itu, lalu membunuh orang itu dengan tombaknya sendiri."
 },
 {
   "id": 8678,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 22,
   "firman": "Itulah yang diperbuat Benaya bin Yoyada; ia mendapat nama di antara ketiga puluh pahlawan itu."
 },
 {
   "id": 8679,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 23,
   "firman": "Di antara ketiga puluh orang itu ia paling dihormati, tetapi ia tidak dapat menyamai triwira. Dan Daud mengangkat dia mengepalai pengawalnya."
 },
 {
   "id": 8680,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 24,
   "firman": "Asael, saudara Yoab, ada di antara ketiga puluh orang itu; selanjutnya Elhanan bin Dodo, dari Betlehem;"
 },
 {
   "id": 8681,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 25,
   "firman": "Sama, orang Harod; Elika, orang Harod;"
 },
 {
   "id": 8682,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 26,
   "firman": "Heles, orang Palti; Ira anak Ikesh orang Tekoa;"
 },
 {
   "id": 8683,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 27,
   "firman": "Abiezer, orang Anatot; Mebunai, orang Husa;"
 },
 {
   "id": 8684,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 28,
   "firman": "Zalmon, orang Ahohi; Maharai, orang Netofa;"
 },
 {
   "id": 8685,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 29,
   "firman": "Heleb anak Baana orang Netofa; Itai bin Ribai, dari Gibea orang Benyamin;"
 },
 {
   "id": 8686,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 30,
   "firman": "Benaya, orang Piraton; Hidai dari lembah-lembah Gaas;"
 },
 {
   "id": 8687,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 31,
   "firman": "Abialbon, orang Bet-Araba; Azmawet, orang Bahurim;"
 },
 {
   "id": 8688,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 32,
   "firman": "Elyahba, orang Saalbon; Yasyen, orang Guni; Yonatan"
 },
 {
   "id": 8689,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 33,
   "firman": "anak Sama orang Harari; Ahiam bin Sarar, orang Harari;"
 },
 {
   "id": 8690,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 34,
   "firman": "Elifelet anak Ahasbai orang Maakha; Eliam anak Ahitofel orang Gilo;"
 },
 {
   "id": 8691,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 35,
   "firman": "Hezrai, orang Karmel; Paerai, orang Arbi;"
 },
 {
   "id": 8692,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 36,
   "firman": "Yigal bin Natan, dari Zoba; Bani, orang Gad;"
 },
 {
   "id": 8693,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 37,
   "firman": "Zelek, orang Amon; Naharai, orang Beerot, pembawa senjata Yoab anak Zeruya;"
 },
 {
   "id": 8694,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 38,
   "firman": "Ira, orang Yetri; Gareb, orang Yetri;"
 },
 {
   "id": 8695,
   "kitab": "2Sa",
   "pasal": 23,
   "ayat": 39,
   "firman": "Uria, orang Het, semuanya tiga puluh tujuh orang."
 },
 {
   "id": 8696,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 1,
   "firman": "Bangkitlah pula murka TUHAN terhadap orang Israel; Ia menghasut Daud melawan mereka, firman-Nya: \"Pergilah, hitunglah orang Israel dan orang Yehuda.\""
 },
 {
   "id": 8697,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 2,
   "firman": "Lalu berkatalah raja kepada Yoab dan para panglima tentara yang bersama-sama dengan dia: \"Jelajahilah segenap suku Israel dari Dan sampai Bersyeba; adakanlah pendaftaran di antara rakyat, supaya aku tahu jumlah mereka.\""
 },
 {
   "id": 8698,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 3,
   "firman": "Lalu berkatalah Yoab kepada raja: \"Kiranya TUHAN, Allahmu, menambahi rakyat seratus kali lipat dari pada yang ada sekarang, dan semoga mata tuanku raja sendiri melihatnya. Tetapi mengapa tuanku raja menghendaki hal ini?\""
 },
 {
   "id": 8699,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 4,
   "firman": "Namun titah raja itu terpaksa diikuti oleh Yoab dan oleh para panglima tentara. Maka pergilah Yoab dan panglima-panglima tentara itu atas perintah raja untuk mengadakan pendaftaran di antara bangsa Israel."
 },
 {
   "id": 8700,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 5,
   "firman": "Mereka menyeberangi sungai Yordan, lalu mulai dari Aroer dan dari kota yang terletak di tengah-tengah lembah ke arah Gad dan Yaezer."
 },
 {
   "id": 8701,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 6,
   "firman": "Kemudian sampailah mereka ke Gilead dan ke Kadesh di negeri orang Het. Selanjutnya sampailah mereka ke Dan dan dari Dan mengambil jurusan Sidon."
 },
 {
   "id": 8702,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 7,
   "firman": "Kemudian sampailah mereka ke tempat yang berkubu, Tirus, dan ke segala kota orang Hewi dan orang Kanaan; akhirnya tibalah mereka di bagian selatan Yehuda, di Bersyeba."
 },
 {
   "id": 8703,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 8,
   "firman": "Setelah mereka menjelajah seluruh negeri itu, sampailah mereka kembali ke Yerusalem setelah lewat sembilan bulan dan dua puluh hari."
 },
 {
   "id": 8704,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 9,
   "firman": "Lalu Yoab memberitahukan kepada raja hasil pendaftaran rakyat. Orang Israel ada delapan ratus ribu orang perangnya yang dapat memegang pedang; dan orang Yehuda ada lima ratus ribu."
 },
 {
   "id": 8705,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 10,
   "firman": "Tetapi berdebar-debarlah hati Daud, setelah ia menghitung rakyat, lalu berkatalah Daud kepada TUHAN: \"Aku telah sangat berdosa karena melakukan hal ini; maka sekarang, TUHAN, jauhkanlah kiranya kesalahan hamba-Mu, sebab perbuatanku itu sangat bodoh.\""
 },
 {
   "id": 8706,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 11,
   "firman": "Setelah Daud bangun dari pada waktu pagi, datanglah firman TUHAN kepada nabi Gad, pelihat Daud, demikian:"
 },
 {
   "id": 8707,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 12,
   "firman": "\"Pergilah, katakanlah kepada Daud: Beginilah firman TUHAN: tiga perkara Kuhadapkan kepadamu; pilihlah salah satu dari padanya, maka Aku akan melakukannya kepadamu.\""
 },
 {
   "id": 8708,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 13,
   "firman": "Kemudian datanglah Gad kepada Daud, memberitahukan kepadanya dengan berkata kepadanya: \"Akan datangkah menimpa engkau tiga tahun kelaparan di negerimu? Atau maukah engkau melarikan diri tiga bulan lamanya dari hadapan lawanmu, sedang mereka itu mengejar engkau? Atau, akan adakah tiga hari penyakit sampar di negerimu? Maka sekarang, pikirkanlah dan timbanglah, jawab apa yang harus kusampaikan kepada Yang mengutus aku.\""
 },
 {
   "id": 8709,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 14,
   "firman": "Lalu berkatalah Daud kepada Gad: \"Sangat susah hatiku, biarlah kiranya kita jatuh ke dalam tangan TUHAN, sebab besar kasih sayang-Nya; tetapi janganlah aku jatuh ke dalam tangan manusia.\""
 },
 {
   "id": 8710,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 15,
   "firman": "Jadi TUHAN mendatangkan penyakit sampar kepada orang Israel dari pagi hari sampai waktu yang ditetapkan, maka matilah dari antara bangsa itu, dari Dan sampai Bersyeba, tujuh puluh ribu orang."
 },
 {
   "id": 8711,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 16,
   "firman": "Ketika malaikat mengacungkan tangannya ke Yerusalem untuk memusnahkannya, maka menyesallah TUHAN karena malapetaka itu, lalu Ia berfirman kepada malaikat yang mendatangkan kemusnahan kepada bangsa itu: \"Cukup! Turunkanlah sekarang tanganmu itu.\" Pada waktu itu malaikat TUHAN itu ada dekat tempat pengirikan Arauna, orang Yebus."
 },
 {
   "id": 8712,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 17,
   "firman": "Dan berkatalah Daud kepada TUHAN, ketika dilihatnya malaikat yang tengah memusnahkan bangsa itu, demikian: \"Sesungguhnya, aku telah berdosa, dan aku telah membuat kesalahan, tetapi domba-domba ini, apakah yang dilakukan mereka? Biarlah kiranya tangan-Mu menimpa aku dan kaum keluargaku.\""
 },
 {
   "id": 8713,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 18,
   "firman": "Pada hari itu datanglah Gad kepada Daud dan berkata kepadanya: \"Pergilah, dirikanlah mezbah bagi TUHAN di tempat pengirikan Arauna, orang Yebus itu.\""
 },
 {
   "id": 8714,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 19,
   "firman": "Lalu pergilah Daud, sesuai dengan perkataan Gad, seperti yang diperintahkan TUHAN."
 },
 {
   "id": 8715,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 20,
   "firman": "Ketika Arauna menjenguk dan melihat raja dengan pegawai-pegawainya mendapatkannya, pergilah Arauna ke luar, lalu sujud kepada raja dengan mukanya ke tanah."
 },
 {
   "id": 8716,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 21,
   "firman": "Bertanyalah Arauna: \"Mengapa tuanku raja datang kepada hambanya ini?\" Jawab Daud: \"Untuk membeli tempat pengirikan ini dari padamu dengan maksud mendirikan mezbah bagi TUHAN, supaya tulah ini berhenti menimpa rakyat.\""
 },
 {
   "id": 8717,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 22,
   "firman": "Lalu berkatalah Arauna kepada Daud: \"Baiklah tuanku raja mengambilnya dan mempersembahkan apa yang dipandangnya baik; lihatlah, itu ada lembu-lembu untuk korban bakaran, dan eretan-eretan pengirik dan alat perkakas lembu untuk kayu bakar."
 },
 {
   "id": 8718,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 23,
   "firman": "Semuanya ini, ya raja, diberikan Arauna kepada raja.\" Arauna berkata pula kepada raja: \"Kiranya TUHAN, Allahmu, berkenan kepadamu.\""
 },
 {
   "id": 8719,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 24,
   "firman": "Tetapi berkatalah raja kepada Arauna: \"Bukan begitu, melainkan aku mau membelinya dari padamu dengan membayar harganya, sebab aku tidak mau mempersembahkan kepada TUHAN, Allahku, korban bakaran dengan tidak membayar apa-apa.\" Sesudah itu Daud membeli tempat pengirikan dan lembu-lembu itu dengan harga lima puluh syikal perak."
 },
 {
   "id": 8720,
   "kitab": "2Sa",
   "pasal": 24,
   "ayat": 25,
   "firman": "Lalu Daud mendirikan di sana mezbah bagi TUHAN dan mempersembahkan korban bakaran dan korban keselamatan. Maka TUHAN mengabulkan doa untuk negeri itu, dan tulah itu berhenti menimpa orang Israel."
 },
 {
   "id": 8721,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 1,
   "firman": "Raja Daud telah tua dan lanjut umurnya, dan biarpun ia diselimuti, badannya tetap dingin."
 },
 {
   "id": 8722,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 2,
   "firman": "Lalu para pegawainya berkata kepadanya: \"Hendaklah dicari bagi tuanku raja seorang perawan yang muda, untuk melayani dan merawat raja; biarlah ia berbaring di pangkuanmu, sehingga badan tuanku raja menjadi panas.\""
 },
 {
   "id": 8723,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 3,
   "firman": "Maka di seluruh daerah Israel dicarilah seorang gadis yang cantik, dan didapatlah Abisag, gadis Sunem, lalu dibawa kepada raja."
 },
 {
   "id": 8724,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 4,
   "firman": "Gadis itu amat cantik, dan ia menjadi perawat raja dan melayani dia, tetapi raja tidak bersetubuh dengan dia."
 },
 {
   "id": 8725,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lalu Adonia, anak Hagit, meninggikan diri dengan berkata: \"Aku ini mau menjadi raja.\" Ia melengkapi dirinya dengan kereta-kereta dan orang-orang berkuda serta lima puluh orang yang berlari di depannya."
 },
 {
   "id": 8726,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 6,
   "firman": "Selama hidup Adonia ayahnya belum pernah menegor dia dengan ucapan: \"Mengapa engkau berbuat begitu?\" Iapun sangat elok perawakannya dan dia adalah anak pertama sesudah Absalom."
 },
 {
   "id": 8727,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 7,
   "firman": "Maka berundinglah ia dengan Yoab, anak Zeruya dan dengan imam Abyatar dan mereka menjadi pengikut dan pembantu Adonia."
 },
 {
   "id": 8728,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 8,
   "firman": "Tetapi imam Zadok dan Benaya bin Yoyada dan nabi Natan dan Simei dan Rei dan para pahlawan Daud tidak memihak kepada Adonia."
 },
 {
   "id": 8729,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sesudah itu Adonia mempersembahkan domba, lembu dan ternak gemukan sebagai korban dekat batu Zohelet yang ada di samping En-Rogel, lalu mengundang semua saudaranya, anak-anak raja, dan semua orang Yehuda, pegawai-pegawai raja;"
 },
 {
   "id": 8730,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 10,
   "firman": "tetapi nabi Natan dan Benaya dan para pahlawan dan Salomo, adiknya, tidak diundangnya."
 },
 {
   "id": 8731,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 11,
   "firman": "Lalu berkatalah Natan kepada Batsyeba, ibu Salomo: \"Tidakkah engkau mendengar, bahwa Adonia anak Hagit, telah menjadi raja, sedang tuan kita Daud tidak mengetahuinya?"
 },
 {
   "id": 8732,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 12,
   "firman": "Karena itu, baiklah kuberi nasihat kepadamu, supaya engkau dapat menyelamatkan nyawamu dan nyawa anakmu Salomo."
 },
 {
   "id": 8733,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 13,
   "firman": "Pergilah masuk menghadap raja Daud dan katakan kepadanya: Bukankah tuanku sendiri, ya rajaku, telah bersumpah kepada hambamu ini: Anakmu Salomo, akan menjadi raja sesudah aku dan dialah yang akan duduk di atas takhtaku? Mengapakah sekarang Adonia menjadi raja?"
 },
 {
   "id": 8734,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 14,
   "firman": "Dan selagi engkau berbicara di sana dengan raja, akupun akan masuk pula dan menyokong perkataanmu itu.\""
 },
 {
   "id": 8735,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 15,
   "firman": "Jadi masuklah Batsyeba menghadap raja ke dalam kamarnya. Waktu itu raja sudah sangat tua dan Abisag, gadis Sunem itu, melayani raja."
 },
 {
   "id": 8736,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 16,
   "firman": "Lalu Batsyeba berlutut dan sujud menyembah kepada raja. Raja bertanya: \"Ada yang kauingini?\""
 },
 {
   "id": 8737,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 17,
   "firman": "Lalu perempuan itu berkata kepadanya: \"Tuanku sendiri telah bersumpah demi TUHAN, Allahmu, kepada hambamu ini: Anakmu Salomo akan menjadi raja sesudah aku, dan ia akan duduk di atas takhtaku."
 },
 {
   "id": 8738,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 18,
   "firman": "Tetapi sekarang, lihatlah, Adonia telah menjadi raja, sedang tuanku raja sendiri tidak mengetahuinya."
 },
 {
   "id": 8739,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 19,
   "firman": "Ia telah menyembelih banyak lembu, ternak gemukan dan domba, dan telah mengundang semua anak raja dan imam Abyatar dan Yoab, panglima itu, tetapi hambamu Salomo tidak diundangnya."
 },
 {
   "id": 8740,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 20,
   "firman": "Dan kepadamulah, ya tuanku raja, tertuju mata seluruh orang Israel, supaya engkau memberitahukan kepada mereka siapa yang akan duduk di atas takhta tuanku raja sesudah tuanku."
 },
 {
   "id": 8741,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 21,
   "firman": "Nanti aku ini dan anakku Salomo dituduh bersalah segera sesudah tuanku raja mendapat perhentian bersama-sama dengan nenek moyangnya.\""
 },
 {
   "id": 8742,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 22,
   "firman": "Selagi Batsyeba berbicara dengan raja, datanglah nabi Natan."
 },
 {
   "id": 8743,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 23,
   "firman": "Diberitahukan kepada raja: \"Itu ada nabi Natan.\" Masuklah ia menghadap raja, lalu sujud menyembah kepada raja dengan mukanya sampai ke tanah."
 },
 {
   "id": 8744,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 24,
   "firman": "Natan berkata: \"Ya tuanku raja, tuanku sendirilah rupa-rupanya yang telah berkata: Adonia akan menjadi raja sesudah aku dan ia akan duduk di atas takhtaku!"
 },
 {
   "id": 8745,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 25,
   "firman": "Sebab pada hari ini ia telah menyembelih banyak lembu, ternak gemukan dan domba; ia mengundang semua anak raja, para panglima dan imam Abyatar, dan sesungguhnya mereka sedang makan minum di depannya sambil berseru: Hidup raja Adonia!"
 },
 {
   "id": 8746,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 26,
   "firman": "Tetapi hambamu ini, dan imam Zadok dan Benaya bin Yoyada dan hambamu Salomo tidak diundangnya."
 },
 {
   "id": 8747,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 27,
   "firman": "Jika hal ini terjadi dari pihak tuanku raja, maka engkau tidak memberitahu hamba-hambamu ini, siapa yang akan duduk di atas takhta tuanku raja sesudah tuanku.\""
 },
 {
   "id": 8748,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 28,
   "firman": "Lalu raja Daud menjawab, katanya: \"Panggillah Batsyeba.\" Perempuan itu masuk menghadap raja dan berdiri di depannya."
 },
 {
   "id": 8749,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 29,
   "firman": "Lalu raja bersumpah dan berkata: \"Demi TUHAN yang hidup, yang telah membebaskan nyawaku dari segala kesesakan,"
 },
 {
   "id": 8750,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 30,
   "firman": "pada hari ini aku akan melaksanakan apa yang kujanjikan kepadamu demi TUHAN, Allah Israel, dengan sumpah ini: Anakmu Salomo akan menjadi raja sesudah aku, dan dialah yang akan duduk di atas takhtaku menggantikan aku.\""
 },
 {
   "id": 8751,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 31,
   "firman": "Lalu Batsyeba berlutut dengan mukanya sampai ke tanah; ia sujud menyembah kepada raja dan berkata: \"Hidup tuanku raja Daud untuk selama-lamanya!\""
 },
 {
   "id": 8752,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 32,
   "firman": "Lagi kata raja Daud: \"Panggillah imam Zadok, nabi Natan dan Benaya bin Yoyada.\" Mereka masuk menghadap raja,"
 },
 {
   "id": 8753,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 33,
   "firman": "dan raja berkata kepada mereka: \"Bawalah para pegawai tuanmu ini, naikkan anakku Salomo ke atas bagal betina kendaraanku sendiri, dan bawa dia ke Gihon."
 },
 {
   "id": 8754,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 34,
   "firman": "Imam Zadok dan nabi Natan harus mengurapi dia di sana menjadi raja atas Israel; kemudian kamu meniup sangkakala dan berseru: Hidup raja Salomo!"
 },
 {
   "id": 8755,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 35,
   "firman": "Sesudah itu kamu berjalan pulang dengan mengiring dia; lalu ia akan masuk dan duduk di atas takhtaku, sebab dialah yang harus naik takhta menggantikan aku, dan dialah yang kutunjuk menjadi raja atas Israel dan Yehuda.\""
 },
 {
   "id": 8756,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 36,
   "firman": "Lalu Benaya bin Yoyada menjawab raja: \"Amin! Demikianlah kiranya firman TUHAN, Allah tuanku raja!"
 },
 {
   "id": 8757,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 37,
   "firman": "Seperti TUHAN menyertai tuanku raja, demikianlah kiranya Ia menyertai Salomo; semoga Ia membuat takhta Salomo lebih agung dari takhta tuanku raja Daud.\""
 },
 {
   "id": 8758,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 38,
   "firman": "Lalu pergilah imam Zadok, nabi Natan dan Benaya bin Yoyada, dengan orang Kreti dan orang Pleti, mereka menaikkan Salomo ke atas bagal betina raja Daud dan membawanya ke Gihon."
 },
 {
   "id": 8759,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 39,
   "firman": "Imam Zadok telah membawa tabung tanduk berisi minyak dari dalam kemah, lalu diurapinya Salomo. Kemudian sangkakala ditiup, dan seluruh rakyat berseru: \"Hidup raja Salomo!\""
 },
 {
   "id": 8760,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 40,
   "firman": "Sesudah itu seluruh rakyat berjalan di belakangnya sambil membunyikan suling dan sambil bersukaria ramai-ramai, sampai seakan-akan bumi terbelah oleh suara mereka."
 },
 {
   "id": 8761,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 41,
   "firman": "Hal itu kedengaran kepada Adonia dan kepada semua undangan yang bersama-sama dengan dia, ketika mereka baru habis makan. Ketika Yoab mendengar bunyi sangkakala itu, ia berkata: \"Apakah sebabnya kota begitu ribut?\""
 },
 {
   "id": 8762,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 42,
   "firman": "Selagi ia berbicara, datanglah Yonatan anak imam Abyatar. Lalu Adonia berkata: \"Masuklah, sebab engkau seorang kesatria dan tentulah engkau membawa kabar baik.\""
 },
 {
   "id": 8763,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 43,
   "firman": "Tetapi Yonatan menjawab Adonia: \"Tidak! Tuan kita raja Daud telah mengangkat Salomo menjadi raja."
 },
 {
   "id": 8764,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 44,
   "firman": "Raja telah menyuruh supaya imam Zadok, dan nabi Natan dan Benaya bin Yoyada, dengan orang Kreti dan orang Pleti, menyertai Salomo dan mereka menaikkan dia ke atas bagal betina raja."
 },
 {
   "id": 8765,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 45,
   "firman": "Imam Zadok, dan nabi Natan mengurapi dia di Gihon menjadi raja, dan dari sana mereka sudah pulang dengan bersukaria, sehingga kota menjadi ribut, itulah bunyi yang kamu dengar tadi."
 },
 {
   "id": 8766,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 46,
   "firman": "Salomo sekarang duduk di atas takhta kerajaan;"
 },
 {
   "id": 8767,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 47,
   "firman": "juga pegawai-pegawai raja telah datang mengucap selamat kepada tuan kita raja Daud, dengan berkata: Kiranya Allahmu membuat nama Salomo lebih masyhur dari pada namamu dan takhtanya lebih agung dari pada takhtamu. Dan rajapun telah sujud menyembah di atas tempat tidurnya,"
 },
 {
   "id": 8768,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 48,
   "firman": "dan beginilah katanya: Terpujilah TUHAN, Allah Israel, yang pada hari ini telah memberi seorang duduk di atas takhtaku yang aku sendiri masih boleh saksikan.\""
 },
 {
   "id": 8769,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 49,
   "firman": "Maka semua undangan Adonia itu terkejut, lalu bangkit dan masing-masing pergi menurut jalannya."
 },
 {
   "id": 8770,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 50,
   "firman": "Takutlah Adonia kepada Salomo, sebab itu ia segera pergi memegang tanduk-tanduk mezbah."
 },
 {
   "id": 8771,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 51,
   "firman": "Lalu diberitahukanlah kepada Salomo: \"Ternyata Adonia takut kepada raja Salomo, dan ia telah memegang tanduk-tanduk mezbah, serta berkata: Biarlah raja Salomo lebih dahulu bersumpah mengenai aku, bahwa ia takkan membunuh hambanya ini dengan pedang.\""
 },
 {
   "id": 8772,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 52,
   "firman": "Lalu kata Salomo: \"Jika ia berlaku sebagai kesatria, maka sehelai rambutpun dari kepalanya tidak akan jatuh ke bumi, tetapi jika ternyata ia bermaksud jahat, haruslah ia dibunuh.\""
 },
 {
   "id": 8773,
   "kitab": "1Ra",
   "pasal": 1,
   "ayat": 53,
   "firman": "Dan raja Salomo menyuruh orang menjemput dia dari mezbah itu. Ketika ia masuk, sujudlah ia menyembah kepada raja Salomo, lalu Salomo berkata kepadanya: \"Pergilah ke rumahmu.\""
 },
 {
   "id": 8774,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 1,
   "firman": "Ketika saat kematian Daud mendekat, ia berpesan kepada Salomo, anaknya:"
 },
 {
   "id": 8775,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 2,
   "firman": "\"Aku ini akan menempuh jalan segala yang fana, maka kuatkanlah hatimu dan berlakulah seperti laki-laki."
 },
 {
   "id": 8776,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 3,
   "firman": "Lakukanlah kewajibanmu dengan setia terhadap TUHAN, Allahmu, dengan hidup menurut jalan yang ditunjukkan-Nya, dan dengan tetap mengikuti segala ketetapan, perintah, peraturan dan ketentuan-Nya, seperti yang tertulis dalam hukum Musa, supaya engkau beruntung dalam segala yang kaulakukan dan dalam segala yang kautuju,"
 },
 {
   "id": 8777,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 4,
   "firman": "dan supaya TUHAN menepati janji yang diucapkan-Nya tentang aku, yakni: Jika anak-anakmu laki-laki tetap hidup di hadapan-Ku dengan setia, dengan segenap hati dan dengan segenap jiwa, maka keturunanmu takkan terputus dari takhta kerajaan Israel."
 },
 {
   "id": 8778,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dan lagi engkaupun mengetahui apa yang dilakukan kepadaku oleh Yoab, anak Zeruya, apa yang dilakukannya kepada kedua panglima Israel, yakni Abner bin Ner dan Amasa bin Yeter. Ia membunuh mereka dan menumpahkan darah dalam zaman damai seakan-akan ada perang, sehingga sabuk pinggangnya dan kasut kakinya berlumuran darah."
 },
 {
   "id": 8779,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 6,
   "firman": "Maka bertindaklah dengan bijaksana dan janganlah biarkan yang ubanan itu turun dengan selamat ke dalam dunia orang mati."
 },
 {
   "id": 8780,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tetapi kepada anak-anak Barzilai, orang Gilead itu, haruslah kautunjukkan kemurahan hati. Biarlah mereka termasuk golongan yang mendapat makanan dari mejamu, sebab merekapun menunjukkan kesetiaannya dengan menyambut aku pada waktu aku melarikan diri dari depan kakakmu Absalom."
 },
 {
   "id": 8781,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 8,
   "firman": "Juga masih ada padamu Simei bin Gera, orang Benyamin, dari Bahurim. Dialah yang mengutuki aku dengan kutuk yang kejam pada waktu aku pergi ke Mahanaim, tetapi kemudian ia datang menyongsong aku di sungai Yordan dan aku telah bersumpah kepadanya demi TUHAN: Takkan kubunuh engkau dengan pedang!"
 },
 {
   "id": 8782,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sekarang janganlah bebaskan dia dari hukuman, sebab engkau seorang yang bijaksana dan tahu apa yang harus kaulakukan kepadanya untuk membuat yang ubanan itu turun dengan berdarah ke dalam dunia orang mati.\""
 },
 {
   "id": 8783,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 10,
   "firman": "Kemudian Daud mendapat perhentian bersama-sama nenek moyangnya, dan ia dikuburkan di kota Daud."
 },
 {
   "id": 8784,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dan Daud memerintah orang Israel selama empat puluh tahun; di Hebron ia memerintah tujuh tahun, dan di Yerusalem ia memerintah tiga puluh tiga tahun."
 },
 {
   "id": 8785,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 12,
   "firman": "Salomo duduk di atas takhta Daud, ayahnya, dan kerajaannya sangat kokoh."
 },
 {
   "id": 8786,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 13,
   "firman": "Pada suatu hari Adonia, anak Hagit, masuk menghadap Batsyeba, ibu Salomo, lalu perempuan itu berkata: \"Apakah engkau datang dengan maksud damai?\" Jawabnya: \"Ya, damai!\""
 },
 {
   "id": 8787,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 14,
   "firman": "Kemudian katanya: \"Ada sesuatu yang hendak kukatakan kepadamu.\" Jawab perempuan itu: \"Katakanlah!\""
 },
 {
   "id": 8788,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 15,
   "firman": "Lalu katanya: \"Engkau sendiri tahu bahwa akulah yang berhak atas kedudukan raja, dan bahwa seluruh Israel mengharapkan, supaya aku menjadi raja; tetapi sebaliknya kedudukan raja jatuh kepada adikku, sebab dari Tuhanlah ia mendapatnya."
 },
 {
   "id": 8789,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 16,
   "firman": "Dan sekarang, satu permintaan saja kusampaikan kepadamu; janganlah tolak permintaanku.\" Jawab perempuan itu kepadanya: \"Katakanlah!\""
 },
 {
   "id": 8790,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 17,
   "firman": "Maka katanya: \"Bicarakanlah kiranya dengan raja Salomo, sebab ia tidak akan menolak permintaanmu, supaya Abisag, gadis Sunem itu, diberikannya kepadaku menjadi isteriku.\""
 },
 {
   "id": 8791,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 18,
   "firman": "Jawab Batsyeba: \"Baik, aku akan membicarakan hal itu untuk engkau dengan raja.\""
 },
 {
   "id": 8792,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 19,
   "firman": "Batsyeba masuk menghadap raja Salomo untuk membicarakan hal itu untuk Adonia, lalu bangkitlah raja mendapatkannya serta tunduk menyembah kepadanya; kemudian duduklah ia di atas takhtanya dan ia menyuruh meletakkan kursi untuk bunda raja, lalu perempuan itu duduk di sebelah kanannya."
 },
 {
   "id": 8793,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 20,
   "firman": "Berkatalah perempuan itu: \"Suatu permintaan kecil saja yang kusampaikan kepadamu, janganlah tolak permintaanku.\" Jawab raja kepadanya: \"Mintalah, ya ibu, sebab aku tidak akan menolak permintaanmu.\""
 },
 {
   "id": 8794,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 21,
   "firman": "Kata perempuan itu: \"Biarlah Abisag, gadis Sunem itu, diberikan kepada kakakmu Adonia menjadi isterinya.\""
 },
 {
   "id": 8795,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 22,
   "firman": "Tetapi raja Salomo menjawab ibunya: \"Mengapa engkau meminta hanya Abisag, gadis Sunem itu, untuk Adonia? Minta jugalah untuknya kedudukan raja! Bukankah dia saudaraku yang lebih tua, dan di pihaknya ada imam Abyatar dan Yoab, anak Zeruya?\""
 },
 {
   "id": 8796,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 23,
   "firman": "Lalu bersumpahlah raja Salomo demi TUHAN: \"Beginilah kiranya Allah menghukum aku, bahkan lebih dari pada itu, jika Adonia tidak membayarkan nyawanya dengan permintaan ini!"
 },
 {
   "id": 8797,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 24,
   "firman": "Oleh sebab itu, demi TUHAN yang hidup, yang menegakkan aku dan mendudukkan aku di atas takhta Daud, ayahku, dan yang membuat bagiku suatu keluarga seperti yang dijanjikan-Nya: pada hari ini juga Adonia harus dibunuh.\""
 },
 {
   "id": 8798,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 25,
   "firman": "Lalu raja Salomo menyerahkan hal itu kepada Benaya bin Yoyada; orang ini memancung dia sehingga mati."
 },
 {
   "id": 8799,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 26,
   "firman": "Dan kepada imam Abyatar raja berkata: \"Pergilah ke Anatot, ke tanah milikmu, sebab engkau patut dihukum mati, tetapi pada hari ini aku tidak akan membunuh engkau, oleh karena engkau telah mengangkat tabut Tuhan ALLAH di depan Daud, ayahku, dan oleh karena engkau telah turut menderita dalam segala sengsara yang diderita ayahku.\""
 },
 {
   "id": 8800,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 27,
   "firman": "Lalu Salomo memecat Abyatar dari jabatannya sebagai imam TUHAN. Dengan demikian Salomo memenuhi firman TUHAN yang telah dikatakan-Nya di Silo mengenai keluarga Eli."
 },
 {
   "id": 8801,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 28,
   "firman": "Ketika kabar itu sampai kepada Yoab--memang Yoab telah memihak kepada Adonia, sekalipun ia tidak memihak kepada Absalom--maka larilah Yoab ke kemah TUHAN, lalu memegang tanduk-tanduk mezbah."
 },
 {
   "id": 8802,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 29,
   "firman": "Kemudian diberitahukanlah kepada Salomo, bahwa Yoab sudah lari ke kemah TUHAN, dan telah ada di samping mezbah. Lalu Salomo menyuruh Benaya bin Yoyada: \"Pergilah, pancung dia.\""
 },
 {
   "id": 8803,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 30,
   "firman": "Benaya masuk ke dalam kemah TUHAN serta berkata kepadanya: \"Beginilah kata raja: Keluarlah.\" Jawabnya: \"Tidak, sebab di sinilah aku mau mati.\" Lalu Benaya menyampaikan jawab itu kepada raja, katanya: \"Beginilah kata Yoab dan beginilah jawabnya kepadaku.\""
 },
 {
   "id": 8804,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 31,
   "firman": "Kata raja kepadanya: \"Perbuatlah seperti yang dikatakannya; pancunglah dia dan kuburkanlah dia; dengan demikian engkau menjauhkan dari padaku dan dari pada kaumku noda darah yang ditumpahkan Yoab dengan tidak beralasan."
 },
 {
   "id": 8805,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 32,
   "firman": "Dan TUHAN akan menanggungkan darahnya kepadanya sendiri, karena ia telah membunuh dua orang yang lebih benar dan lebih baik dari padanya. Ia membunuh mereka dengan pedang, dengan tidak diketahui ayahku Daud, yaitu Abner bin Ner, panglima Israel, dan Amasa bin Yeter, panglima Yehuda."
 },
 {
   "id": 8806,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 33,
   "firman": "Demikianlah darah mereka akan ditanggungkan kepada Yoab dan keturunannya untuk selama-lamanya, tetapi Daud dan keturunannya dan keluarganya dan takhtanya akan mendapat selamat dari pada TUHAN sampai selama-lamanya.\""
 },
 {
   "id": 8807,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 34,
   "firman": "Maka berangkatlah Benaya bin Yoyada, lalu memancung dan membunuh Yoab, kemudian dia dikuburkan di rumahnya sendiri di padang gurun."
 },
 {
   "id": 8808,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 35,
   "firman": "Raja mengangkat Benaya bin Yoyada menggantikan Yoab menjadi kepala tentara; dan raja mengangkat imam Zadok menggantikan Abyatar."
 },
 {
   "id": 8809,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 36,
   "firman": "Kemudian raja menyuruh memanggil Simei, dan berkata kepadanya: \"Dirikanlah bagimu sebuah rumah di Yerusalem, diamlah di sana, dan janganlah keluar dari sana ke mana-manapun."
 },
 {
   "id": 8810,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 37,
   "firman": "Sebab ketahuilah sungguh-sungguh, bahwa pada waktu engkau keluar dan menyeberangi sungai Kidron, pastilah engkau mati dibunuh dan darahmu akan ditanggungkan kepadamu sendiri.\""
 },
 {
   "id": 8811,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 38,
   "firman": "Lalu berkatalah Simei kepada raja: \"Baiklah demikian! Seperti yang tuanku raja katakan, demikianlah akan dilakukan hambamu ini.\" Lalu Simei diam di Yerusalem beberapa waktu lamanya."
 },
 {
   "id": 8812,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 39,
   "firman": "Dan sesudah lewat tiga tahun, terjadilah bahwa dua orang hamba Simei lari kepada Akhis bin Maakha, raja Gat, lalu diberitahukan kepada Simei: \"Ketahuilah, kedua orang hambamu ada di Gat.\""
 },
 {
   "id": 8813,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 40,
   "firman": "Maka berkemaslah Simei, dipelanainya keledainya, dan pergilah ia ke Gat, kepada Akhis, untuk mencari hambanya itu. Lalu Simei pulang dan membawa mereka dari Gat."
 },
 {
   "id": 8814,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 41,
   "firman": "Ketika diberitahukan kepada Salomo, bahwa tadinya Simei pergi dari Yerusalem ke Gat dan sekarang sudah pulang,"
 },
 {
   "id": 8815,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 42,
   "firman": "maka raja menyuruh memanggil Simei dan berkata kepadanya: \"Bukankah aku telah menyuruh engkau bersumpah demi TUHAN dan telah memperingatkan engkau, begini: Ketahuilah sungguh-sungguh, bahwa pada waktu engkau keluar dan pergi ke mana-manapun, pastilah engkau mati dibunuh! Dan engkau telah menjawab: Baiklah demikian, aku akan mentaatinya."
 },
 {
   "id": 8816,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 43,
   "firman": "Mengapa engkau tidak menepati sumpah demi TUHAN itu dan juga perintah yang kuperintahkan kepadamu?\""
 },
 {
   "id": 8817,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 44,
   "firman": "Kemudian kata raja kepada Simei: \"Engkau sendiri tahu dalam hatimu segala kejahatan yang kauperbuat kepada Daud, ayahku, maka TUHAN telah menanggungkan kejahatanmu itu kepadamu sendiri."
 },
 {
   "id": 8818,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 45,
   "firman": "Tetapi diberkatilah kiranya raja Salomo dan kokohlah takhta Daud di hadapan TUHAN sampai selama-lamanya.\""
 },
 {
   "id": 8819,
   "kitab": "1Ra",
   "pasal": 2,
   "ayat": 46,
   "firman": "Raja memberi perintah kepada Benaya bin Yoyada, lalu keluarlah Benaya, dipancungnya Simei sehingga mati. Demikianlah kerajaan itu kokoh di tangan Salomo."
 },
 {
   "id": 8820,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 1,
   "firman": "Lalu Salomo menjadi menantu Firaun, raja Mesir; ia mengambil anak Firaun, dan membawanya ke kota Daud, sampai ia selesai mendirikan istananya dan rumah TUHAN dan tembok sekeliling Yerusalem."
 },
 {
   "id": 8821,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 2,
   "firman": "Hanya, bangsa itu masih mempersembahkan korban di bukit-bukit pengorbanan, sebab belum ada didirikan rumah untuk nama TUHAN sampai pada waktu itu."
 },
 {
   "id": 8822,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 3,
   "firman": "Dan Salomo menunjukkan kasihnya kepada TUHAN dengan hidup menurut ketetapan-ketetapan Daud, ayahnya; hanya, ia masih mempersembahkan korban sembelihan dan ukupan di bukit-bukit pengorbanan."
 },
 {
   "id": 8823,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 4,
   "firman": "Pada suatu hari raja pergi ke Gibeon untuk mempersembahkan korban, sebab di situlah bukit pengorbanan yang paling besar; seribu korban bakaran dipersembahkan Salomo di atas mezbah itu."
 },
 {
   "id": 8824,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 5,
   "firman": "Di Gibeon itu TUHAN menampakkan diri kepada Salomo dalam mimpi pada waktu malam. Berfirmanlah Allah: \"Mintalah apa yang hendak Kuberikan kepadamu.\""
 },
 {
   "id": 8825,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lalu Salomo berkata: \"Engkaulah yang telah menunjukkan kasih setia-Mu yang besar kepada hamba-Mu Daud, ayahku, sebab ia hidup di hadapan-Mu dengan setia, benar dan jujur terhadap Engkau; dan Engkau telah menjamin kepadanya kasih setia yang besar itu dengan memberikan kepadanya seorang anak yang duduk di takhtanya seperti pada hari ini."
 },
 {
   "id": 8826,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 7,
   "firman": "Maka sekarang, ya TUHAN, Allahku, Engkaulah yang mengangkat hamba-Mu ini menjadi raja menggantikan Daud, ayahku, sekalipun aku masih sangat muda dan belum berpengalaman."
 },
 {
   "id": 8827,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 8,
   "firman": "Demikianlah hamba-Mu ini berada di tengah-tengah umat-Mu yang Kaupilih, suatu umat yang besar, yang tidak terhitung dan tidak terkira banyaknya."
 },
 {
   "id": 8828,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 9,
   "firman": "Maka berikanlah kepada hamba-Mu ini hati yang faham menimbang perkara untuk menghakimi umat-Mu dengan dapat membedakan antara yang baik dan yang jahat, sebab siapakah yang sanggup menghakimi umat-Mu yang sangat besar ini?\""
 },
 {
   "id": 8829,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 10,
   "firman": "Lalu adalah baik di mata Tuhan bahwa Salomo meminta hal yang demikian."
 },
 {
   "id": 8830,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 11,
   "firman": "Jadi berfirmanlah Allah kepadanya: \"Oleh karena engkau telah meminta hal yang demikian dan tidak meminta umur panjang atau kekayaan atau nyawa musuhmu, melainkan pengertian untuk memutuskan hukum,"
 },
 {
   "id": 8831,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 12,
   "firman": "maka sesungguhnya Aku melakukan sesuai dengan permintaanmu itu, sesungguhnya Aku memberikan kepadamu hati yang penuh hikmat dan pengertian, sehingga sebelum engkau tidak ada seorangpun seperti engkau, dan sesudah engkau takkan bangkit seorangpun seperti engkau."
 },
 {
   "id": 8832,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 13,
   "firman": "Dan juga apa yang tidak kauminta Aku berikan kepadamu, baik kekayaan maupun kemuliaan, sehingga sepanjang umurmu takkan ada seorangpun seperti engkau di antara raja-raja."
 },
 {
   "id": 8833,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan jika engkau hidup menurut jalan yang Kutunjukkan dan tetap mengikuti segala ketetapan dan perintah-Ku, sama seperti ayahmu Daud, maka Aku akan memperpanjang umurmu.\""
 },
 {
   "id": 8834,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 15,
   "firman": "Lalu terjagalah Salomo; ternyata ia bermimpi. Sekembalinya ke Yerusalem, berdirilah ia di hadapan tabut perjanjian Tuhan, dipersembahkannya korban-korban bakaran dan korban-korban keselamatan, kemudian ia mengadakan perjamuan bagi semua pegawainya."
 },
 {
   "id": 8835,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 16,
   "firman": "Pada waktu itu masuklah dua orang perempuan sundal menghadap raja, lalu mereka berdiri di depannya."
 },
 {
   "id": 8836,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 17,
   "firman": "Kata perempuan yang satu: \"Ya tuanku! aku dan perempuan ini diam dalam satu rumah, dan aku melahirkan anak, pada waktu dia ada di rumah itu."
 },
 {
   "id": 8837,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 18,
   "firman": "Kemudian pada hari ketiga sesudah aku, perempuan inipun melahirkan anak; kami sendirian, tidak ada orang luar bersama-sama kami dalam rumah, hanya kami berdua saja dalam rumah."
 },
 {
   "id": 8838,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 19,
   "firman": "Pada waktu malam anak perempuan ini mati, karena ia menidurinya."
 },
 {
   "id": 8839,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 20,
   "firman": "Pada waktu tengah malam ia bangun, lalu mengambil anakku dari sampingku; sementara hambamu ini tidur, dibaringkannya anakku itu di pangkuannya, sedang anaknya yang mati itu dibaringkannya di pangkuanku."
 },
 {
   "id": 8840,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 21,
   "firman": "Ketika aku bangun pada waktu pagi untuk menyusui anakku, tampaklah anak itu sudah mati, tetapi ketika aku mengamat-amati dia pada waktu pagi itu, tampaklah bukan dia anak yang kulahirkan.\""
 },
 {
   "id": 8841,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 22,
   "firman": "Kata perempuan yang lain itu: \"Bukan! anakkulah yang hidup dan anakmulah yang mati.\" Tetapi perempuan yang pertama berkata pula: \"Bukan! anakmulah yang mati dan anakkulah yang hidup.\" Begitulah mereka bertengkar di depan raja."
 },
 {
   "id": 8842,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 23,
   "firman": "Lalu berkatalah raja: \"Yang seorang berkata: Anakkulah yang hidup ini dan anakmulah yang mati. Yang lain berkata: Bukan! Anakmulah yang mati dan anakkulah yang hidup.\""
 },
 {
   "id": 8843,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 24,
   "firman": "Sesudah itu raja berkata: \"Ambilkan aku pedang,\" lalu dibawalah pedang ke depan raja."
 },
 {
   "id": 8844,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 25,
   "firman": "Kata raja: \"Penggallah anak yang hidup itu menjadi dua dan berikanlah setengah kepada yang satu dan yang setengah lagi kepada yang lain.\""
 },
 {
   "id": 8845,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 26,
   "firman": "Maka kata perempuan yang empunya anak yang hidup itu kepada raja, sebab timbullah belas kasihannya terhadap anaknya itu, katanya: \"Ya tuanku! Berikanlah kepadanya bayi yang hidup itu, jangan sekali-kali membunuh dia.\" Tetapi yang lain itu berkata: \"Supaya jangan untukku ataupun untukmu, penggallah!\""
 },
 {
   "id": 8846,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 27,
   "firman": "Tetapi raja menjawab, katanya: \"Berikanlah kepadanya bayi yang hidup itu, jangan sekali-kali membunuh dia; dia itulah ibunya.\""
 },
 {
   "id": 8847,
   "kitab": "1Ra",
   "pasal": 3,
   "ayat": 28,
   "firman": "Ketika seluruh orang Israel mendengar keputusan hukum yang diberikan raja, maka takutlah mereka kepada raja, sebab mereka melihat, bahwa hikmat dari pada Allah ada dalam hatinya untuk melakukan keadilan."
 },
 {
   "id": 8848,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 1,
   "firman": "Maka Salomo menjadi raja atas seluruh Israel."
 },
 {
   "id": 8849,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 2,
   "firman": "Inilah para pembesarnya: Azarya bin Zadok menjadi imam;"
 },
 {
   "id": 8850,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 3,
   "firman": "Elihoref dan Ahia, anak-anak Sisa menjadi panitera negara; Yosafat bin Ahilud menjadi bendahara negara;"
 },
 {
   "id": 8851,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 4,
   "firman": "Benaya bin Yoyada menjadi panglima; Zadok dan Abyatar menjadi imam."
 },
 {
   "id": 8852,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 5,
   "firman": "Azarya bin Natan mengawasi para kepala daerah; Zabut bin Natan, seorang imam, menjadi sahabat raja;"
 },
 {
   "id": 8853,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 6,
   "firman": "Ahisar menjadi kepala istana; Adoniram bin Abda menjadi kepala rodi."
 },
 {
   "id": 8854,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 7,
   "firman": "Salomo mempunyai dua belas orang kepala daerah atas seluruh Israel yang harus menjamin makanan raja dan seisi istananya: adalah tanggungan tiap-tiap kepala daerah untuk menjamin makanan selama sebulan dalam setahun."
 },
 {
   "id": 8855,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 8,
   "firman": "Inilah nama-nama mereka: Ben-Hur di pegunungan Efraim;"
 },
 {
   "id": 8856,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 9,
   "firman": "Ben-Deker di Makas, di Saalbim, di Bet-Semes dan di Elon-Bet-Hanan;"
 },
 {
   "id": 8857,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 10,
   "firman": "Ben-Hesed di Arubot; wilayahnya ialah Sokho dan seluruh tanah Hefer;"
 },
 {
   "id": 8858,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 11,
   "firman": "Ben-Abinadab memegang seluruh tanah bukit Dor, dan Tafat binti Salomo menjadi isterinya;"
 },
 {
   "id": 8859,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 12,
   "firman": "Baana bin Ahilud memegang Taanakh, Megido dan seluruh Bet-Sean yang di sebelah Sartan di sebelah hilir Yizreel, dari Bet-Sean sampai Abel-Mehola sampai ke seberang Yokmeam."
 },
 {
   "id": 8860,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 13,
   "firman": "Selanjutnya Ben-Geber di Ramot-Gilead; wilayahnya ialah Hawot-Yair yang di Gilead; Yair ialah anak Manasye. Juga wilayah Argob yang di Basan dipegangnya, enam puluh kota besar, berpagar tembok dan berpalang pintu tembaga;"
 },
 {
   "id": 8861,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 14,
   "firman": "Ahinadab bin Ido memegang Mahanaim."
 },
 {
   "id": 8862,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 15,
   "firman": "Selanjutnya Ahimaas di Naftali; ia juga mengambil seorang anak Salomo menjadi isterinya, yakni Basmat."
 },
 {
   "id": 8863,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 16,
   "firman": "Selanjutnya Baana bin Husai di Asyer dan di Alot."
 },
 {
   "id": 8864,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 17,
   "firman": "Lalu Yosafat bin Paruah di Isakhar"
 },
 {
   "id": 8865,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 18,
   "firman": "dan Simei bin Ela di Benyamin."
 },
 {
   "id": 8866,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 19,
   "firman": "Geber bin Uri di tanah Gilead memegang tanah Sihon, raja orang Amori, dan tanah Og, raja Basan; dan dialah satu-satunya kepala daerah yang ada di tanah itu."
 },
 {
   "id": 8867,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 20,
   "firman": "Orang Yehuda dan orang Israel jumlahnya seperti pasir di tepi laut. Mereka makan dan minum serta bersukaria."
 },
 {
   "id": 8868,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 21,
   "firman": "Maka Salomo berkuasa atas segala kerajaan mulai dari sungai Efrat sampai negeri orang Filistin dan sampai ke tapal batas Mesir. Mereka menyampaikan upeti dan tetap takluk kepada Salomo seumur hidupnya."
 },
 {
   "id": 8869,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 22,
   "firman": "Adapun persediaan makanan yang diperlukan Salomo untuk sehari ialah tiga puluh kor tepung yang terbaik dan enam puluh kor tepung biasa,"
 },
 {
   "id": 8870,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 23,
   "firman": "sepuluh ekor lembu gemukan dan dua puluh lembu gembalaan dan seratus ekor domba, belum terhitung rusa, kijang, rusa dandi dan gangsa piaraan,"
 },
 {
   "id": 8871,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 24,
   "firman": "sebab ia berkuasa atas seluruh tanah di sebelah sini sungai Efrat, mulai dari Tifsah sampai ke Gaza, dan atas semua raja di sebelah sini sungai Efrat; ia dikaruniai damai di seluruh negerinya,"
 },
 {
   "id": 8872,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 25,
   "firman": "sehingga orang Yehuda dan orang Israel diam dengan tenteram, masing-masing di bawah pohon anggur dan pohon aranya, dari Dan sampai Bersyeba seumur hidup Salomo."
 },
 {
   "id": 8873,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 26,
   "firman": "Lagipula Salomo mempunyai kuda empat puluh ribu kandang untuk kereta-keretanya dan dua belas ribu orang berkuda."
 },
 {
   "id": 8874,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 27,
   "firman": "Dan para kepala daerah itu menjamin makanan raja Salomo serta semua orang yang ikut makan dari meja raja Salomo. Mereka membawanya masing-masing dalam bulan gilirannya dengan tidak mengurangi sesuatu apapun."
 },
 {
   "id": 8875,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 28,
   "firman": "Jelai dan jerami untuk kuda-kuda biasa dan kuda-kuda teji dibawa mereka ke tempat yang semestinya, masing-masing menurut tanggungannya."
 },
 {
   "id": 8876,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 29,
   "firman": "Dan Allah memberikan kepada Salomo hikmat dan pengertian yang amat besar, serta akal yang luas seperti dataran pasir di tepi laut,"
 },
 {
   "id": 8877,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 30,
   "firman": "sehingga hikmat Salomo melebihi hikmat segala bani Timur dan melebihi segala hikmat orang Mesir."
 },
 {
   "id": 8878,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 31,
   "firman": "Ia lebih bijaksana dari pada semua orang, dari pada Etan, orang Ezrahi itu, dan dari pada Heman, Kalkol dan Darda, anak-anak Mahol; sebab itu ia mendapat nama di antara segala bangsa sekelilingnya."
 },
 {
   "id": 8879,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 32,
   "firman": "Ia menggubah tiga ribu amsal, dan nyanyiannya ada seribu lima."
 },
 {
   "id": 8880,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 33,
   "firman": "Ia bersajak tentang pohon-pohonan, dari pohon aras yang di gunung Libanon sampai kepada hisop yang tumbuh pada dinding batu; ia berbicara juga tentang hewan dan tentang burung-burung dan tentang binatang melata dan tentang ikan-ikan."
 },
 {
   "id": 8881,
   "kitab": "1Ra",
   "pasal": 4,
   "ayat": 34,
   "firman": "Maka datanglah orang dari segala bangsa mendengarkan hikmat Salomo, dan ia menerima upeti dari semua raja-raja di bumi, yang telah mendengar tentang hikmatnya itu."
 },
 {
   "id": 8882,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 1,
   "firman": "Hiram, raja Tirus, mengutus pegawai-pegawainya kepada Salomo, karena didengarnya, bahwa Salomo telah diurapi menjadi raja menggantikan ayahnya, sebab Hiram senantiasa bersahabat dengan Daud."
 },
 {
   "id": 8883,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 2,
   "firman": "Lalu Salomo mengutus orang kepada Hiram dengan pesan:"
 },
 {
   "id": 8884,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 3,
   "firman": "\"Engkau tahu bahwa Daud, ayahku, tidak dapat mendirikan sebuah rumah bagi nama TUHAN, Allahnya, oleh karena musuh-musuhnya memerangi dia dari segala jurusan, sampai TUHAN menyerahkan mereka ke bawah telapak kakinya."
 },
 {
   "id": 8885,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 4,
   "firman": "Tetapi sekarang, TUHAN, Allahku, telah mengaruniakan keamanan kepadaku di mana-mana, tidak ada lagi lawan dan tidak ada lagi malapetaka menimpa."
 },
 {
   "id": 8886,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 5,
   "firman": "Dan ketahuilah, aku berpikir-pikir hendak mendirikan sebuah rumah bagi nama TUHAN, Allahku, seperti yang dijanjikan TUHAN kepada Daud, ayahku, demikian: Anakmu yang hendak Kududukkan nanti di atas takhtamu menggantikan engkau, dialah yang akan mendirikan rumah itu bagi nama-Ku."
 },
 {
   "id": 8887,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 6,
   "firman": "Oleh sebab itu, perintahkanlah orang menebang bagiku pohon-pohon aras dari gunung Libanon, dan biarlah hamba-hambaku membantu hamba-hambamu, dan upah hamba-hambamu akan kubayar kepadamu seberapa juga kauminta, sebab engkau tahu, bahwa di antara kami tidak ada seorangpun yang pandai menebang pohon sama seperti orang Sidon.\""
 },
 {
   "id": 8888,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 7,
   "firman": "Maka segera sesudah Hiram mendengar pesan dari Salomo itu, ia sangat bersukacita serta berkata: \"Terpujilah TUHAN pada hari ini, karena Ia telah memberikan kepada Daud seorang anak yang bijaksana untuk mengepalai bangsa yang besar ini.\""
 },
 {
   "id": 8889,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 8,
   "firman": "Lalu Hiram mengutus orang kepada Salomo mengatakan: \"Aku telah mendengar pesan yang kausuruh sampaikan kepadaku. Tentang kayu aras dan kayu sanobar aku akan melakukan segala yang kaukehendaki."
 },
 {
   "id": 8890,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 9,
   "firman": "Hamba-hambaku akan membawanya turun dari gunung Libanon ke laut dan aku akan mengikatnya menjadi rakit-rakit di laut untuk dibawa sampai ke tempat yang akan kautunjukkan kepadaku; kemudian akan kusuruh bongkar semuanya di sana, sehingga engkau dapat mengangkutnya. Sementara itu engkau hendaknya menyediakan makanan bagi seisi istanaku seberapa yang kukehendaki.\""
 },
 {
   "id": 8891,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 10,
   "firman": "Demikianlah Hiram memberikan kayu aras dan kayu sanobar kepada Salomo seberapa yang dikehendakinya."
 },
 {
   "id": 8892,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 11,
   "firman": "Lalu Salomo memberikan kepada Hiram dua puluh ribu kor gandum, bahan makanan bagi seisi istananya dan dua puluh kor minyak tumbuk; demikianlah diberikan Salomo kepada Hiram tahun demi tahun."
 },
 {
   "id": 8893,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 12,
   "firman": "Dan TUHAN memberikan hikmat kepada Salomo seperti yang dijanjikan-Nya kepadanya; maka damaipun ada antara Hiram dan Salomo, lalu mereka berdua mengadakan perjanjian."
 },
 {
   "id": 8894,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 13,
   "firman": "Raja Salomo mengerahkan orang rodi dari antara seluruh Israel, maka orang rodi itu ada tiga puluh ribu orang."
 },
 {
   "id": 8895,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 14,
   "firman": "Ia menyuruh mereka ke gunung Libanon, sepuluh ribu orang dalam sebulan berganti-ganti: selama sebulan mereka ada di Libanon, selama dua bulan di rumah. Adoniram menjadi kepala rodi."
 },
 {
   "id": 8896,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 15,
   "firman": "Lagipula Salomo mempunyai tujuh puluh ribu kuli dan delapan puluh ribu tukang pahat di pegunungan,"
 },
 {
   "id": 8897,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 16,
   "firman": "belum terhitung para mandur kepala Salomo yang mengepalai pekerjaan itu, yakni tiga ribu tiga ratus orang banyaknya, yang mengawasi rakyat yang mengerjakan pekerjaan itu."
 },
 {
   "id": 8898,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 17,
   "firman": "Dan raja memerintahkan supaya mereka melinggis batu yang besar, batu yang mahal-mahal untuk membuat dasar rumah itu dari batu pahat."
 },
 {
   "id": 8899,
   "kitab": "1Ra",
   "pasal": 5,
   "ayat": 18,
   "firman": "Maka tukang-tukang Salomo dan tukang-tukang Hiram serta orang-orang Gebal memahat dan menyediakan kayu dan batu untuk mendirikan rumah itu."
 },
 {
   "id": 8900,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 1,
   "firman": "Dan terjadilah pada tahun keempat ratus delapan puluh sesudah orang Israel keluar dari tanah Mesir, pada tahun keempat sesudah Salomo menjadi raja atas Israel, dalam bulan Ziw, yakni bulan yang kedua, maka Salomo mulai mendirikan rumah bagi TUHAN."
 },
 {
   "id": 8901,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 2,
   "firman": "Rumah yang didirikan raja Salomo bagi TUHAN itu enam puluh hasta panjangnya dan dua puluh hasta lebarnya dan tiga puluh hasta tingginya."
 },
 {
   "id": 8902,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 3,
   "firman": "Balai di sebelah depan ruang besar rumah itu dua puluh hasta panjangnya, menurut lebar rumah itu, dan sepuluh hasta lebarnya ke sebelah depan rumah itu."
 },
 {
   "id": 8903,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dibuatnya juga pada rumah itu jendela-jendela yang rapat bidainya."
 },
 {
   "id": 8904,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 5,
   "firman": "Pada dinding rumah itu sekelilingnya didirikannya kamar tambahan, sekeliling ruang besar dan ruang belakang, dan seluruhnya dibuatnya bertingkat-tingkat."
 },
 {
   "id": 8905,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 6,
   "firman": "Tingkat bawah lima hasta lebarnya, yang tengah enam hasta dan yang ketiga tujuh hasta, sebab telah dibuatnya ceruk-ceruk pada rumah itu sekeliling sebelah luar, sehingga dinding rumah itu tidak usah dilobangi."
 },
 {
   "id": 8906,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 7,
   "firman": "Pada waktu rumah itu didirikan, dipakailah batu-batu yang telah disiapkan di penggalian, sehingga tidak kedengaran palu atau kapak atau sesuatu perkakas besipun selama pembangunan rumah itu."
 },
 {
   "id": 8907,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 8,
   "firman": "Pintu tingkat bawah ada pada lambung kanan rumah itu, dan orang naik dengan tangga-tangga pilin ke tingkat tengah dan dari tingkat tengah ke tingkat yang ketiga."
 },
 {
   "id": 8908,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 9,
   "firman": "Setelah ia selesai mendirikan rumah itu, dibuatnyalah langit-langit rumah itu dari bingkai dan pemapan dari kayu aras."
 },
 {
   "id": 8909,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 10,
   "firman": "Dan setelah ia mendirikan kamar tambahan itu pada rumah itu sekeliling, yakni setiap tingkat lima hasta tingginya, maka rumah itu ditutupinya dengan kayu aras."
 },
 {
   "id": 8910,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 11,
   "firman": "Kemudian datanglah firman TUHAN kepada Salomo, demikian:"
 },
 {
   "id": 8911,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 12,
   "firman": "\"Mengenai rumah yang sedang kaudirikan ini, jika engkau hidup menurut segala ketetapan-Ku dan melakukan segala peraturan-Ku dan tetap mengikuti segala perintah-Ku dan tidak menyimpang dari padanya, maka Aku akan menepati janji-Ku kepadamu yang telah Kufirmankan kepada Daud, ayahmu,"
 },
 {
   "id": 8912,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 13,
   "firman": "yakni bahwa Aku akan diam di tengah-tengah orang Israel dan tidak hendak meninggalkan umat-Ku Israel.\""
 },
 {
   "id": 8913,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 14,
   "firman": "Setelah Salomo selesai mendirikan rumah itu,"
 },
 {
   "id": 8914,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 15,
   "firman": "ia melapisi dinding rumah itu dari dalam dengan papan kayu aras; dari lantai sampai ke balok langit-langit dilapisinya dengan kayu aras, tetapi lantai rumah itu dilapisinya dengan papan kayu sanobar."
 },
 {
   "id": 8915,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 16,
   "firman": "Kemudian disekatnyalah dua puluh hasta bagian belakang rumah itu dengan papan kayu aras, dari lantai sampai ke balok-balok; lalu dibuatnyalah ruang itu menjadi ruang belakang, menjadi tempat maha kudus."
 },
 {
   "id": 8916,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 17,
   "firman": "Dan empat puluh hasta panjangnya ruang yang di depan ruang belakang itu, yakni ruang besar."
 },
 {
   "id": 8917,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 18,
   "firman": "Kayu aras sebelah dalam rumah itu berukirkan buah labu dan bunga mengembang; semuanya ditutupi kayu aras, tidak ada batu kelihatan."
 },
 {
   "id": 8918,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 19,
   "firman": "Demikianlah dilengkapinya ruang belakang di dalam rumah itu, di sebelah dalam sekali, supaya di sana ditaruh tabut perjanjian TUHAN."
 },
 {
   "id": 8919,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 20,
   "firman": "Ruang belakang itu dua puluh hasta panjangnya dan dua puluh hasta lebarnya dan dua puluh hasta tingginya. Ia melapisinya dengan emas kertas, lalu ia membuat mezbah dari kayu aras di depannya."
 },
 {
   "id": 8920,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 21,
   "firman": "Sesudah Salomo melapisi rumah itu dari dalam dengan emas kertas, direntangkannyalah tabir pada rantai-rantai emas yang di depan ruang belakang itu, lalu ruang itu dilapisinya dengan emas."
 },
 {
   "id": 8921,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 22,
   "firman": "Seluruh rumah itu dilapisinya dengan emas, ya rumah itu seluruhnya; juga seluruh mezbah yang di depan ruang belakang itu dilapisinya dengan emas."
 },
 {
   "id": 8922,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 23,
   "firman": "Selanjutnya di dalam ruang belakang itu dibuatnya dua kerub dari kayu minyak, masing-masing sepuluh hasta tingginya."
 },
 {
   "id": 8923,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 24,
   "firman": "Sayap yang satu dari kerub itu lima hasta panjangnya dan sayap yang lain juga lima hasta, sehingga dari ujung sayap yang satu sampai ke ujung sayap yang lain sepuluh hasta panjangnya."
 },
 {
   "id": 8924,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 25,
   "firman": "Juga kerub yang kedua adalah sepuluh hasta panjangnya; dan kedua kerub itu sama ukuran dan sama potongan badannya."
 },
 {
   "id": 8925,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 26,
   "firman": "Tinggi kerub yang satu sepuluh hasta dan demikian juga kerub yang kedua."
 },
 {
   "id": 8926,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 27,
   "firman": "Maka ditaruhnyalah kerub-kerub itu di tengah-tengah ruang yang di sebelah dalam sekali; kerub-kerub itu mengembangkan sayapnya, sehingga kerub yang satu menyentuh dinding dengan sayapnya dan kerub yang kedua menyentuh dinding yang lain, sedang sayap-sayap yang arah ke tengah rumah itu bersentuhan ujungnya."
 },
 {
   "id": 8927,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 28,
   "firman": "Dan kerub-kerub itu dilapisinya dengan emas."
 },
 {
   "id": 8928,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 29,
   "firman": "Dan pada segala dinding rumah itu berkeliling ia mengukir gambar kerub, pohon korma dan bunga mengembang, baik di ruang sebelah dalam maupun di ruang sebelah luar."
 },
 {
   "id": 8929,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 30,
   "firman": "Juga lantai rumah itu dilapisinya dengan emas, baik di ruang sebelah dalam maupun di ruang sebelah luar."
 },
 {
   "id": 8930,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 31,
   "firman": "Sebagai pintu masuk ke ruang belakang dibuatnyalah pintu dari kayu minyak; ambang dan tiangnya merupakan segi lima."
 },
 {
   "id": 8931,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 32,
   "firman": "Pada kedua daun pintu yang dari kayu minyak itu ia mengukir gambar kerub, pohon korma dan bunga mengembang, kemudian dilapisinya dengan emas; juga pada kerub dan pada pohon korma itu disalutkannya emas."
 },
 {
   "id": 8932,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 33,
   "firman": "Demikian juga untuk pintu masuk ke ruang besar itu dibuatnya tiang-tiang dari kayu minyak yang merupakan segi empat;"
 },
 {
   "id": 8933,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 34,
   "firman": "dan dua pintu dari kayu sanobar; kedua papan pintu dari pintu yang satu dapat dilipat dan demikian juga kedua papan pintu yang lain."
 },
 {
   "id": 8934,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 35,
   "firman": "Lalu diukirnyalah padanya kerub, pohon korma dan bunga mengembang, kemudian dilapisinya pintu itu dengan emas pipih pada gambar ukiran itu."
 },
 {
   "id": 8935,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 36,
   "firman": "Ia mendirikan tembok pelataran dalam dari tiga jajar batu pahat dan dari satu jajar balok kayu aras."
 },
 {
   "id": 8936,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 37,
   "firman": "Dalam tahun yang keempat, dalam bulan Ziw, diletakkanlah dasar rumah TUHAN,"
 },
 {
   "id": 8937,
   "kitab": "1Ra",
   "pasal": 6,
   "ayat": 38,
   "firman": "dan dalam tahun yang kesebelas, dalam bulan Bul, yaitu bulan kedelapan, selesailah rumah itu dengan segala bagian-bagiannya dan sesuai dengan segala rancangannya; jadi tujuh tahun lamanya ia mendirikan rumah itu."
 },
 {
   "id": 8938,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 1,
   "firman": "Salomo mendirikan istananya sampai tiga belas tahun lamanya, barulah selesai seluruh istananya itu."
 },
 {
   "id": 8939,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 2,
   "firman": "Ia mendirikan gedung \"Hutan Libanon\", seratus hasta panjangnya dan lima puluh hasta lebarnya dan tiga puluh hasta tingginya, disangga oleh tiga jajar tiang kayu aras dengan ganja kayu aras di atas tiang itu."
 },
 {
   "id": 8940,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 3,
   "firman": "Gedung itu ditutup dari atas dengan langit-langit kayu aras, di atas balok-balok melintang yang disangga oleh tiang-tiang itu, empat puluh lima jumlahnya, yakni lima belas sejajar."
 },
 {
   "id": 8941,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 4,
   "firman": "Ada pula tiga jajar jendela berbidai, jendela berhadapan dengan jendela, tiga kali."
 },
 {
   "id": 8942,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 5,
   "firman": "Dan semua pintu dan jendela segi empat bangunnya; jendela berhadapan dengan jendela, tiga kali."
 },
 {
   "id": 8943,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 6,
   "firman": "Ia membuat juga Balai Saka, lima puluh hasta panjangnya dan tiga puluh hasta lebarnya, dengan di sebelah depannya sebuah balai lagi yang bertiang dan bertangga di sebelah depannya."
 },
 {
   "id": 8944,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 7,
   "firman": "Dibuatnya juga Balai Singgasana, tempat ia memutuskan hukum, balai pengadilan, yang ditutupi dengan kayu aras dari lantai sampai ke balok langit-langit."
 },
 {
   "id": 8945,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dan gedung kediamannya sendiri, di pelataran yang lain, lebih ke sebelah dalam lagi dari balai itu, adalah sama buatannya. Dan bagi anak Firaun, yang diambil Salomo menjadi isterinya, dibuatnya juga sebuah gedung sama dengan balai itu."
 },
 {
   "id": 8946,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 9,
   "firman": "Tembok dari semuanya ini dibuat dari batu yang mahal-mahal, yang sesuai dengan ukuran batu pahat digergaji dengan gergaji dari sebelah dalam dan dari sebelah luar, dari dasar sampai ke atas, dan juga dari tembok luar sampai kepada tembok pelataran besar."
 },
 {
   "id": 8947,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 10,
   "firman": "Bahkan dasar gedung-gedung itu dari batu yang mahal-mahal, batu yang besar-besar, batu yang sepuluh hasta dan batu yang delapan hasta."
 },
 {
   "id": 8948,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 11,
   "firman": "Di bagian atas ada batu yang mahal-mahal, berukuran batu pahat, dan kayu aras juga."
 },
 {
   "id": 8949,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 12,
   "firman": "Sekeliling pelataran besar ada tembok dari tiga jajar batu pahat dan satu jajar balok kayu aras; demikian juga sekeliling pelataran dalam rumah TUHAN dan balainya."
 },
 {
   "id": 8950,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 13,
   "firman": "Kemudian raja Salomo menyuruh orang menjemput Hiram dari Tirus."
 },
 {
   "id": 8951,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 14,
   "firman": "Dia adalah anak seorang janda dari suku Naftali, sedang ayahnya orang Tirus, tukang tembaga; ia penuh dengan keahlian, pengertian dan pengetahuan untuk melakukan segala pekerjaan tembaga; ia datang kepada raja Salomo, lalu melakukan segala pekerjaan itu bagi raja."
 },
 {
   "id": 8952,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 15,
   "firman": "Ia membentuk dua tiang tembaga, tinggi tiang yang satu delapan belas hasta dan dapat dililit oleh tali yang dua belas hasta panjangnya; tiang yang kedua demikian juga."
 },
 {
   "id": 8953,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dibuatnya juga dua ganja untuk ditaruh di kepala tiang-tiang itu, dari tembaga tuangan, tinggi ganja yang satu lima hasta dan tinggi ganja yang kedua lima hasta."
 },
 {
   "id": 8954,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 17,
   "firman": "Dibuatnya pula dua jala-jala untuk ganja yang ada di kepala tiang itu--jala-jala itu semacam kawat berpilin, semacam untaian rantai--satu jala-jala untuk ganja yang satu dan satu jala-jala untuk ganja yang kedua."
 },
 {
   "id": 8955,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 18,
   "firman": "Kemudian dibuatnya juga buah-buah delima, dua jajar berkeliling pada jala-jala yang satu, untuk menutupi ganja yang di ujung tiang itu, dan demikian pula dibuatnya pada ganja yang kedua."
 },
 {
   "id": 8956,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 19,
   "firman": "Dan ganja yang di kepala tiang dekat balai depan itu berbentuk bunga bakung, tingginya empat hasta,"
 },
 {
   "id": 8957,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 20,
   "firman": "yakni ganja-ganja yang di atas kedua tiang itu, di sebelah atas sekali, lewat jala-jala yang meliliti perut ganja itu; dan buah-buah delima ada dua ratus berjajar berkeliling pada ganja yang satu, demikian juga pada yang kedua."
 },
 {
   "id": 8958,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 21,
   "firman": "Kemudian tiang-tiang itu didirikannya dekat balai ruang besar. Ketika ia mendirikan tiang kanan, ia menamainya Yakhin; ketika ia mendirikan tiang kiri, ia menamainya Boas."
 },
 {
   "id": 8959,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 22,
   "firman": "Dan setelah bentukan bunga bakung itu ditaruh di kepala tiang-tiang itu, maka siaplah pekerjaan membuat tiang-tiang itu."
 },
 {
   "id": 8960,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 23,
   "firman": "Kemudian dibuatnyalah \"laut\" tuangan yang sepuluh hasta dari tepi ke tepi, bundar keliling, lima hasta tingginya, dan yang dapat dililit berkeliling oleh tali yang tiga puluh hasta panjangnya."
 },
 {
   "id": 8961,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 24,
   "firman": "Dan di bawah tepinya ada gambar buah labu yang mengelilinginya sama sekali, sepuluh dalam sehasta, merangkum \"laut\" itu berkeliling; labu itu dua jajar, dituang setuangan dengan bejana itu."
 },
 {
   "id": 8962,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 25,
   "firman": "\"Laut\" itu menumpang di atas dua belas lembu, tiga menghadap ke utara dan tiga menghadap ke barat, tiga menghadap ke selatan dan tiga menghadap ke timur; \"laut\" itu menumpang di atasnya, sedang segala buntut lembu itu menuju ke dalam."
 },
 {
   "id": 8963,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 26,
   "firman": "Tebal \"laut\" itu setapak tangan dan tepinya serupa tepi piala, seperti bunga bakung yang berkembang. \"Laut\" itu dapat memuat dua ribu bat air."
 },
 {
   "id": 8964,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 27,
   "firman": "Selanjutnya dibuatnya sepuluh kereta penopang dari tembaga, satu kereta empat hasta panjangnya, empat hasta lebarnya dan tiga hasta tingginya."
 },
 {
   "id": 8965,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 28,
   "firman": "Beginilah bentuk kereta penopang itu: ada papan penutupnya dan papan itu diapit oleh bingkai."
 },
 {
   "id": 8966,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 29,
   "firman": "Dan pada papan penutup yang diapit oleh bingkai itu ada singa, lembu dan kerub, dan demikian juga pada bingkai itu; di sebelah atas dan di sebelah bawah singa dan lembu itu ada karangan-karangan bunga yang tergantung."
 },
 {
   "id": 8967,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 30,
   "firman": "Pada satu kereta penopang ada empat roda tembaga dengan poros tembaga; dan pada keempat penjurunya ada sangga untuk menyangga bejana pembasuhan; sangga-sangga itu dituang dan di sebelah luar setiap sangga ada karangan bunga."
 },
 {
   "id": 8968,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 31,
   "firman": "Dan mulut kereta penopang itu ada di sebelah dalam sangga-sangga itu, menonjol ke atas satu hasta; mulutnya itu bundar, buatannya sebagai tumpuan, dan dalamnya satu setengah hasta; juga pada mulutnya itu ada ukiran, tetapi papan-papan penutupnya empat persegi, jadi tidak bundar."
 },
 {
   "id": 8969,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 32,
   "firman": "Keempat roda itu ada di bawah papan penutup, dan tangan-tangan roda itu ada pada kereta penopang itu; dan tinggi satu roda ialah satu setengah hasta."
 },
 {
   "id": 8970,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 33,
   "firman": "Dan buatan roda itu seperti buatan roda kereta; tetapi tangan-tangannya, lingkarnya, jari-jarinya dan napnya, semuanya tuangan."
 },
 {
   "id": 8971,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 34,
   "firman": "Keempat sangga pada keempat sudut setiap kereta penopang adalah seiras dengan kereta itu."
 },
 {
   "id": 8972,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 35,
   "firman": "Dan di sebelah atas kereta penopang itu ada leher bundar berkeliling, setengah hasta tingginya; di sebelah atas kereta itu ada pula topang-topang dan papan penutup yang seiras dengan dia."
 },
 {
   "id": 8973,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 36,
   "firman": "Maka pada muka topang-topangnya itu dan pada papan-papan penutupnya diukirkannyalah kerub, singa dan pohon korma, masing-masing menurut tempat yang ada, dan karangan bunga sekeliling."
 },
 {
   "id": 8974,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 37,
   "firman": "Demikianlah dikerjakannya kesepuluh kereta penopang itu; tuangannya sama, ukurannya sama dan potongannya sama semuanya."
 },
 {
   "id": 8975,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 38,
   "firman": "Lagipula dibuatnya sepuluh bejana pembasuhan dari tembaga: setiap bejana dapat memuat empat puluh bat air, setiap bejana empat hasta besarnya dan ada satu bejana di atas setiap kereta dari kesepuluh kereta penopang itu."
 },
 {
   "id": 8976,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 39,
   "firman": "Lima kereta penopang ditaruhnya pada sisi kanan rumah itu dan lima pada sisi kirinya; tetapi \"laut\" itu ditaruhnya pada sisi kanan rumah itu, arah tenggara."
 },
 {
   "id": 8977,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 40,
   "firman": "Dan Hiram membuat juga kuali-kuali, penyodok-penyodok dan bokor-bokor penyiraman. Demikianlah Hiram menyelesaikan segala pekerjaan yang harus dilakukannya bagi raja Salomo di rumah TUHAN,"
 },
 {
   "id": 8978,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 41,
   "firman": "yakni kedua tiang dengan kedua bulatan ganja yang di kepala tiang itu, dan kedua jala-jala yang menutup kedua bulatan ganja itu;"
 },
 {
   "id": 8979,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 42,
   "firman": "keempat ratus buah delima untuk kedua jala-jala itu, dua jajar buah delima untuk satu jala-jala guna menutupi kedua bulatan ganja yang di atas tiang itu;"
 },
 {
   "id": 8980,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 43,
   "firman": "kesepuluh kereta penopang dan kesepuluh bejana pembasuhan yang di atas kereta itu;"
 },
 {
   "id": 8981,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 44,
   "firman": "\"laut\" yang satu itu dan kedua belas lembu yang di bawah \"laut\" itu;"
 },
 {
   "id": 8982,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 45,
   "firman": "kuali-kuali, penyodok-penyodok dan bokor-bokor penyiraman; segala perlengkapan yang dibuat Hiram bagi raja Salomo di rumah TUHAN itu adalah dari tembaga yang diupam."
 },
 {
   "id": 8983,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 46,
   "firman": "Raja menuang semuanya itu di Lembah Yordan di dalam tanah liat antara Sukot dan Sartan."
 },
 {
   "id": 8984,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 47,
   "firman": "Dan Salomo membiarkan segala perlengkapan itu tidak ditimbang karena jumlahnya yang amat besar; berat tembaga itu tidaklah terhitung."
 },
 {
   "id": 8985,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 48,
   "firman": "Salomo membuat juga segala perlengkapan yang ada di rumah TUHAN, yakni mezbah emas dan meja emas tempat menaruh roti sajian;"
 },
 {
   "id": 8986,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 49,
   "firman": "kandil-kandil dari emas murni, lima di sebelah kanan dan lima di sebelah kiri, di depan ruang belakang; kembang-kembangnya, lampu-lampunya dan sepit-sepitnya, dari emas;"
 },
 {
   "id": 8987,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 50,
   "firman": "pasu-pasunya, pisau-pisaunya, bokor-bokor penyiramannya, cawan-cawannya dan perbaraan-perbaraannya, dari emas murni; engsel-engsel untuk pintu ruang dalam, yakni tempat maha kudus, dan engsel-engsel untuk pintu ruang besar Bait Suci, dari emas."
 },
 {
   "id": 8988,
   "kitab": "1Ra",
   "pasal": 7,
   "ayat": 51,
   "firman": "Maka genaplah segala pekerjaan yang dilakukan Salomo di rumah TUHAN itu. Kemudian Salomo memasukkan barang-barang kudus Daud, ayahnya, dan menaruh perak, emas dan barang-barang itu dalam perbendaharaan rumah TUHAN."
 },
 {
   "id": 8989,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada waktu itu raja Salomo menyuruh para tua-tua Israel dan semua kepala suku, yakni para pemimpin puak orang Israel, berkumpul di hadapannya di Yerusalem, untuk mengangkut tabut perjanjian TUHAN dari kota Daud, yaitu Sion."
 },
 {
   "id": 8990,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 2,
   "firman": "Maka pada hari raya di bulan Etanim, yakni bulan ketujuh, berkumpullah di hadapan raja Salomo semua orang Israel."
 },
 {
   "id": 8991,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 3,
   "firman": "Setelah semua tua-tua Israel datang, maka imam-imam mengangkat tabut itu."
 },
 {
   "id": 8992,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 4,
   "firman": "Mereka mengangkut tabut TUHAN dan Kemah Pertemuan dan segala barang kudus yang ada dalam kemah itu; semuanya itu diangkut oleh imam-imam dan orang-orang Lewi."
 },
 {
   "id": 8993,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 5,
   "firman": "Tetapi raja Salomo dan segenap umat Israel yang sudah berkumpul di hadapannya, berdiri bersama-sama dengan dia di depan tabut itu, dan mempersembahkan kambing domba dan lembu sapi yang tidak terhitung dan tidak terbilang banyaknya."
 },
 {
   "id": 8994,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 6,
   "firman": "Kemudian imam-imam membawa tabut perjanjian TUHAN itu ke tempatnya, di ruang belakang rumah itu, di tempat maha kudus, tepat di bawah sayap kerub-kerub;"
 },
 {
   "id": 8995,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 7,
   "firman": "sebab kerub-kerub itu mengembangkan kedua sayapnya di atas tempat tabut itu, sehingga kerub-kerub itu menudungi tabut serta kayu-kayu pengusungnya dari atas."
 },
 {
   "id": 8996,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 8,
   "firman": "Kayu-kayu pengusung itu demikian panjangnya, sehingga ujungnya kelihatan dari tempat kudus, yang di depan ruang belakang itu, tetapi tidak kelihatan dari luar; dan di situlah tempatnya sampai hari ini."
 },
 {
   "id": 8997,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 9,
   "firman": "Dalam tabut itu tidak ada apa-apa selain dari kedua loh batu yang diletakkan Musa ke dalamnya di gunung Horeb, yakni loh-loh batu bertuliskan perjanjian yang diadakan TUHAN dengan orang Israel pada waktu perjalanan mereka keluar dari tanah Mesir."
 },
 {
   "id": 8998,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 10,
   "firman": "Ketika imam-imam keluar dari tempat kudus, datanglah awan memenuhi rumah TUHAN,"
 },
 {
   "id": 8999,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 11,
   "firman": "sehingga imam-imam tidak tahan berdiri untuk menyelenggarakan kebaktian oleh karena awan itu, sebab kemuliaan TUHAN memenuhi rumah TUHAN."
 },
 {
   "id": 9000,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 12,
   "firman": "Pada waktu itu berkatalah Salomo: \"TUHAN telah menetapkan matahari di langit, tetapi Ia memutuskan untuk diam dalam kekelaman."
 },
 {
   "id": 9001,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 13,
   "firman": "Sekarang, aku telah mendirikan rumah kediaman bagi-Mu, tempat Engkau menetap selama-lamanya.\""
 },
 {
   "id": 9002,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 14,
   "firman": "Kemudian berpalinglah raja lalu memberkati seluruh jemaah Israel, sedang segenap jemaah Israel berdiri."
 },
 {
   "id": 9003,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 15,
   "firman": "Ia berkata: \"Terpujilah TUHAN, Allah Israel, yang telah menyelesaikan dengan tangan-Nya apa yang difirmankan-Nya dengan mulut-Nya kepada Daud, ayahku, demikian:"
 },
 {
   "id": 9004,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 16,
   "firman": "Sejak Aku membawa umat-Ku Israel keluar dari Mesir, tidak ada kota yang Kupilih di antara segala suku Israel untuk mendirikan rumah di sana sebagai tempat kediaman nama-Ku, tetapi Aku telah memilih Daud untuk berkuasa atas umat-Ku Israel.\""
 },
 {
   "id": 9005,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 17,
   "firman": "Lalu raja melanjutkan: \"Ketika Daud, ayahku bermaksud mendirikan rumah untuk nama TUHAN, Allah Israel,"
 },
 {
   "id": 9006,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 18,
   "firman": "berfirmanlah TUHAN kepadanya: Engkau bermaksud mendirikan rumah untuk nama-Ku, dan maksudmu itu memanglah baik;"
 },
 {
   "id": 9007,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 19,
   "firman": "hanya, bukanlah engkau yang akan mendirikan rumah itu, melainkan anak kandungmu yang akan lahir kelak, dialah yang akan mendirikan rumah itu untuk nama-Ku."
 },
 {
   "id": 9008,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 20,
   "firman": "Jadi TUHAN telah menepati janji yang telah diucapkan-Nya; aku telah bangkit menggantikan Daud, ayahku, dan telah duduk di atas takhta kerajaan Israel, seperti yang difirmankan TUHAN: aku telah mendirikan rumah ini untuk nama TUHAN, Allah Israel,"
 },
 {
   "id": 9009,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 21,
   "firman": "dan telah menyediakan di sana tempat untuk tabut, yang memuat perjanjian yang telah diadakan TUHAN dengan nenek moyang kita, ketika mereka dibawa-Nya keluar dari tanah Mesir.\""
 },
 {
   "id": 9010,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 22,
   "firman": "Kemudian berdirilah Salomo di depan mezbah TUHAN di hadapan segenap jemaah Israel, ditadahkannyalah tangannya ke langit,"
 },
 {
   "id": 9011,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 23,
   "firman": "lalu berkata: \"Ya TUHAN, Allah Israel! Tidak ada Allah seperti Engkau di langit di atas dan di bumi di bawah; Engkau yang memelihara perjanjian dan kasih setia kepada hamba-hamba-Mu yang dengan segenap hatinya hidup di hadapan-Mu;"
 },
 {
   "id": 9012,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 24,
   "firman": "Engkau yang tetap berpegang pada janji-Mu terhadap hamba-Mu Daud, ayahku, dan yang telah menggenapi dengan tangan-Mu apa yang Kaufirmankan dengan mulut-Mu, seperti yang terjadi pada hari ini."
 },
 {
   "id": 9013,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 25,
   "firman": "Maka sekarang, ya TUHAN, Allah Israel, peliharalah apa yang Kaujanjikan kepada hamba-Mu Daud, ayahku, dengan berkata: Keturunanmu takkan terputus di hadapan-Ku dan tetap akan duduk di atas takhta kerajaan Israel, asal anak-anakmu tetap hidup di hadapan-Ku sama seperti engkau hidup di hadapan-Ku."
 },
 {
   "id": 9014,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 26,
   "firman": "Maka sekarang, ya Allah Israel, biarlah kiranya menjadi nyata keteguhan janji yang telah Kauucapkan kepada hamba-Mu Daud, ayahku."
 },
 {
   "id": 9015,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 27,
   "firman": "Tetapi benarkah Allah hendak diam di atas bumi? Sesungguhnya langit, bahkan langit yang mengatasi segala langitpun tidak dapat memuat Engkau, terlebih lagi rumah yang kudirikan ini."
 },
 {
   "id": 9016,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 28,
   "firman": "Maka berpalinglah kepada doa dan permohonan hamba-Mu ini, ya TUHAN Allahku, dengarkanlah seruan dan doa yang hamba-Mu panjatkan di hadapan-Mu pada hari ini!"
 },
 {
   "id": 9017,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 29,
   "firman": "Kiranya mata-Mu terbuka terhadap rumah ini, siang dan malam, terhadap tempat yang Kaukatakan: nama-Ku akan tinggal di sana; dengarkanlah doa yang hamba-Mu panjatkan di tempat ini."
 },
 {
   "id": 9018,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 30,
   "firman": "Dan dengarkanlah permohonan hamba-Mu dan umat-Mu Israel yang mereka panjatkan di tempat ini; bahwa Engkau juga yang mendengarnya di tempat kediaman-Mu di sorga; dan apabila Engkau mendengarnya, maka Engkau akan mengampuni."
 },
 {
   "id": 9019,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 31,
   "firman": "Jika seseorang telah berdosa kepada temannya, lalu diwajibkan mengangkat sumpah dengan mengutuk dirinya, dan dia datang bersumpah ke depan mezbah-Mu di dalam rumah ini,"
 },
 {
   "id": 9020,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 32,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga dan bertindak serta mengadili hamba-hamba-Mu, yakni menyatakan bersalah orang yang bersalah dengan menanggungkan perbuatannya kepada orang itu sendiri, tetapi menyatakan benar orang yang benar dengan memberi pembalasan kepadanya yang sesuai dengan kebenarannya."
 },
 {
   "id": 9021,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 33,
   "firman": "Apabila umat-Mu Israel terpukul kalah oleh musuhnya karena mereka berdosa kepada-Mu, kemudian mereka berbalik kepada-Mu dan mengakui nama-Mu, dan mereka berdoa dan memohon kepada-Mu di rumah ini,"
 },
 {
   "id": 9022,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 34,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga dan mengampuni dosa umat-Mu Israel dan mengembalikan mereka ke tanah yang telah Kauberikan kepada nenek moyang mereka."
 },
 {
   "id": 9023,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 35,
   "firman": "Apabila langit tertutup, sehingga tidak ada hujan, sebab mereka berdosa kepada-Mu, lalu mereka berdoa di tempat ini dan mengakui nama-Mu dan mereka berbalik dari dosanya, sebab Engkau telah menindas mereka,"
 },
 {
   "id": 9024,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 36,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga dan mengampuni dosa hamba-hamba-Mu, umat-Mu Israel, --karena Engkaulah yang menunjukkan kepada mereka jalan yang baik yang harus mereka ikuti--dan Engkau kiranya memberikan hujan kepada tanah-Mu yang telah Kauberikan kepada umat-Mu menjadi milik pusaka."
 },
 {
   "id": 9025,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 37,
   "firman": "Apabila di negeri ini ada kelaparan, apabila ada penyakit sampar, hama dan penyakit gandum, belalang, atau belalang pelahap, apabila musuh menyesakkan mereka di salah satu kota mereka, apabila ada tulah atau penyakit apapun,"
 },
 {
   "id": 9026,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 38,
   "firman": "lalu seseorang atau segenap umat-Mu Israel ini memanjatkan doa dan permohonan di rumah ini dengan menadahkan tangannya--karena mereka masing-masing mengenal apa yang merisaukan hatinya sendiri--"
 },
 {
   "id": 9027,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 39,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga, tempat kediaman-Mu yang tetap, dan Engkau kiranya mengampuni, bertindak, dan membalaskan kepada setiap orang sesuai dengan segala kelakuannya, karena engkau mengenal hatinya--sebab Engkau sajalah yang mengenal hati semua anak manusia, --"
 },
 {
   "id": 9028,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 40,
   "firman": "supaya mereka takut akan Engkau selama mereka hidup di atas tanah yang telah Kauberikan kepada nenek moyang kami."
 },
 {
   "id": 9029,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 41,
   "firman": "Juga apabila seorang asing, yang tidak termasuk umat-Mu Israel, datang dari negeri jauh oleh karena nama-Mu, --"
 },
 {
   "id": 9030,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 42,
   "firman": "sebab orang akan mendengar tentang nama-Mu yang besar dan tentang tangan-Mu yang kuat dan lengan-Mu yang teracung--dan ia datang berdoa di rumah ini,"
 },
 {
   "id": 9031,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 43,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga, tempat kediaman-Mu yang tetap, dan Engkau kiranya bertindak sesuai dengan segala yang diserukan kepada-Mu oleh orang asing itu, supaya segala bangsa di bumi mengenal nama-Mu, sehingga mereka takut akan Engkau sama seperti umat-Mu Israel dan sehingga mereka tahu, bahwa nama-Mu telah diserukan atas rumah yang telah kudirikan ini."
 },
 {
   "id": 9032,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 44,
   "firman": "Apabila umat-Mu keluar untuk berperang melawan musuhnya, ke arah manapun Engkau menyuruh mereka, dan apabila mereka berdoa kepada TUHAN dengan berkiblat ke kota yang telah Kaupilih dan ke rumah yang telah kudirikan bagi nama-Mu,"
 },
 {
   "id": 9033,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 45,
   "firman": "maka Engkau kiranya mendengarkan di sorga doa dan permohonan mereka dan Engkau kiranya memberikan keadilan kepada mereka."
 },
 {
   "id": 9034,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 46,
   "firman": "Apabila mereka berdosa kepada-Mu--karena tidak ada manusia yang tidak berdosa--dan Engkau murka kepada mereka dan menyerahkan mereka kepada musuh, sehingga mereka diangkut tertawan ke negeri musuh yang jauh atau yang dekat,"
 },
 {
   "id": 9035,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 47,
   "firman": "dan apabila mereka sadar kembali dalam hatinya di negeri tempat mereka tertawan, dan mereka berbalik, dan memohon kepada-Mu di negeri orang-orang yang mengangkut mereka tertawan, dengan berkata: Kami telah berdosa, bersalah, dan berbuat fasik,"
 },
 {
   "id": 9036,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 48,
   "firman": "apabila mereka berbalik kepada-Mu dengan segenap hatinya dan dengan segenap jiwanya di negeri musuh yang mengangkut mereka tertawan, dan apabila mereka berdoa kepada-Mu dengan berkiblat ke negeri mereka yang telah Kauberikan kepada nenek moyang mereka, ke kota yang telah Kaupilih dan ke rumah yang telah kudirikan bagi nama-Mu,"
 },
 {
   "id": 9037,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 49,
   "firman": "maka Engkau kiranya mendengarkan di sorga, tempat kediaman-Mu yang tetap, kepada doa dan permohonan mereka dan Engkau kiranya memberikan keadilan kepada mereka."
 },
 {
   "id": 9038,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 50,
   "firman": "Engkau kiranya mengampuni umat-Mu yang telah berdosa kepada-Mu, mengampuni segala pelanggaran yang dilakukan mereka kepada-Mu, dan kiranya Engkau membuat mereka menjadi kesayangan orang-orang yang mengangkut mereka tertawan, sehingga orang-orang itu menyayangi mereka,"
 },
 {
   "id": 9039,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 51,
   "firman": "sebab mereka itu umat-Mu dan milik kepunyaan-Mu yang telah Kaubawa keluar dari Mesir dari tengah-tengah dapur peleburan besi."
 },
 {
   "id": 9040,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 52,
   "firman": "Hendaklah mata-Mu terbuka terhadap permohonan hamba-Mu dan terhadap permohonan umat-Mu Israel dan hendaklah Engkau mendengarkan mereka seberapa kali mereka berseru kepada-Mu."
 },
 {
   "id": 9041,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 53,
   "firman": "Sebab Engkaulah yang memisahkan mereka bagi-Mu menjadi milik kepunyaan-Mu dari antara segala bangsa di bumi, seperti yang telah Kaufirmankan dengan perantaraan Musa, hamba-Mu, pada waktu Engkau membawa nenek moyang kami keluar dari Mesir, ya Tuhan ALLAH!\""
 },
 {
   "id": 9042,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 54,
   "firman": "Ketika Salomo selesai memanjatkan segala doa dan permohonan itu kepada TUHAN, bangkitlah ia dari depan mezbah TUHAN setelah berlutut dengan menadahkan tangannya ke langit."
 },
 {
   "id": 9043,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 55,
   "firman": "Maka berdirilah ia dan memberkati segenap jemaah Israel dengan suara nyaring, katanya:"
 },
 {
   "id": 9044,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 56,
   "firman": "\"Terpujilah TUHAN yang memberikan tempat perhentian kepada umat-Nya Israel tepat seperti yang difirmankan-Nya; dari segala yang baik, yang telah dijanjikan-Nya dengan perantaraan Musa, hamba-Nya, tidak ada satupun yang tidak dipenuhi."
 },
 {
   "id": 9045,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 57,
   "firman": "Kiranya TUHAN, Allah kita, menyertai kita sebagaimana Ia telah menyertai nenek moyang kita, janganlah Ia meninggalkan kita dan janganlah Ia membuangkan kita,"
 },
 {
   "id": 9046,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 58,
   "firman": "tetapi hendaklah dicondongkan-Nya hati kita kepada-Nya untuk hidup menurut segala jalan yang ditunjukkan-Nya, dan untuk tetap mengikuti segala perintah-Nya dan ketetapan-Nya dan peraturan-Nya yang telah diperintahkan-Nya kepada nenek moyang kita."
 },
 {
   "id": 9047,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 59,
   "firman": "Hendaklah perkataan yang telah kupohonkan tadi di hadapan TUHAN, dekat pada TUHAN, Allah kita, siang dan malam, supaya Ia memberikan keadilan kepada hamba-Nya dan kepada umat-Nya Israel menurut yang perlu pada setiap hari,"
 },
 {
   "id": 9048,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 60,
   "firman": "supaya segala bangsa di bumi tahu, bahwa Tuhanlah Allah, dan tidak ada yang lain,"
 },
 {
   "id": 9049,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 61,
   "firman": "dan hendaklah kamu berpaut kepada TUHAN, Allah kita, dengan sepenuh hatimu dan dengan hidup menurut segala ketetapan-Nya dan dengan tetap mengikuti segala perintah-Nya seperti pada hari ini.\""
 },
 {
   "id": 9050,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 62,
   "firman": "Lalu raja bersama-sama segenap Israel mempersembahkan korban sembelihan di hadapan TUHAN."
 },
 {
   "id": 9051,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 63,
   "firman": "Sebagai korban keselamatannya kepada TUHAN Salomo mempersembahkan dua puluh dua ribu ekor lembu sapi dan seratus dua puluh ribu ekor kambing domba. Demikianlah raja dan segenap Israel mentahbiskan rumah TUHAN itu."
 },
 {
   "id": 9052,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 64,
   "firman": "Pada hari itu juga raja menguduskan pertengahan pelataran yang di depan rumah TUHAN, sebab di situlah ia mempersembahkan korban bakaran, korban sajian dan segala lemak korban keselamatan, sebab mezbah tembaga yang di hadapan TUHAN itu terlalu kecil untuk memuat korban bakaran dan korban sajian dan segala lemak korban keselamatan itu."
 },
 {
   "id": 9053,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 65,
   "firman": "Lalu Salomo mengadakan perayaan pada waktu itu juga, di hadapan TUHAN, Allah kita, selama tujuh hari, bersama-sama dengan seluruh Israel, suatu jemaah yang besar, dari jalan masuk ke Hamat sampai sungai Mesir."
 },
 {
   "id": 9054,
   "kitab": "1Ra",
   "pasal": 8,
   "ayat": 66,
   "firman": "Pada hari yang kedelapan disuruhnya bangsa itu pergi, maka mereka memohon berkat untuk raja, lalu pulang ke kemah mereka sambil bersukacita dan bergembira atas segala kebaikan yang telah dilakukan TUHAN kepada Daud, hamba-Nya, dan kepada orang Israel, umat-Nya."
 },
 {
   "id": 9055,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 1,
   "firman": "Ketika Salomo selesai mendirikan rumah TUHAN dan istana raja dan membuat segala yang diinginkannya,"
 },
 {
   "id": 9056,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 2,
   "firman": "maka TUHAN menampakkan diri kepada Salomo untuk kedua kalinya seperti Ia sudah menampakkan diri kepadanya di Gibeon."
 },
 {
   "id": 9057,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 3,
   "firman": "Firman TUHAN kepadanya: \"Telah Kudengar doa dan permohonanmu yang kausampaikan ke hadapan-Ku; Aku telah menguduskan rumah yang kaudirikan ini untuk membuat nama-Ku tinggal di situ sampai selama-lamanya, maka mata-Ku dan hati-Ku akan ada di situ sepanjang masa."
 },
 {
   "id": 9058,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 4,
   "firman": "Mengenai engkau, jika engkau hidup di hadapan-Ku sama seperti Daud, ayahmu, dengan tulus hati dan dengan benar, dan berbuat sesuai dengan segala yang Kuperintahkan kepadamu, dan jika engkau tetap mengikuti segala ketetapan dan peraturan-Ku,"
 },
 {
   "id": 9059,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 5,
   "firman": "maka Aku akan meneguhkan takhta kerajaanmu atas Israel untuk selama-lamanya seperti yang telah Kujanjikan kepada Daud, ayahmu, dengan berkata: Keturunanmu takkan terputus dari takhta kerajaan Israel."
 },
 {
   "id": 9060,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 6,
   "firman": "Tetapi jika kamu ini dan anak-anakmu berbalik dari pada-Ku dan tidak berpegang pada segala perintah dan ketetapan-Ku yang telah Kuberikan kepadamu, dan pergi beribadah kepada allah lain dan sujud menyembah kepadanya,"
 },
 {
   "id": 9061,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 7,
   "firman": "maka Aku akan melenyapkan orang Israel dari atas tanah yang telah Kuberikan kepada mereka, dan rumah yang telah Kukuduskan bagi nama-Ku itu, akan Kubuang dari hadapan-Ku, maka Israel akan menjadi kiasan dan sindiran di antara segala bangsa."
 },
 {
   "id": 9062,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dan rumah ini akan menjadi reruntuhan, sehingga setiap orang yang lewat akan tertegun, bersuit, dan berkata: Apakah sebabnya TUHAN berbuat yang demikian kepada negeri ini dan kepada rumah ini?"
 },
 {
   "id": 9063,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 9,
   "firman": "Maka orang akan berkata: Sebab mereka meninggalkan TUHAN, Allah mereka, yang membawa nenek moyang mereka keluar dari tanah Mesir dan sebab mereka berpegang pada allah lain dan sujud menyembah kepadanya dan beribadah kepadanya. Itulah sebabnya TUHAN mendatangkan segala malapetaka ini ke atas mereka.\""
 },
 {
   "id": 9064,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 10,
   "firman": "Setelah lewat dua puluh tahun selesailah Salomo mendirikan kedua rumah itu, yakni rumah TUHAN dan istana raja."
 },
 {
   "id": 9065,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 11,
   "firman": "Oleh karena Hiram, raja Tirus, telah membantu Salomo dengan kayu aras, kayu sanobar, dan emas, sebanyak yang dikehendakinya, maka pada waktu itu raja Salomo memberikan kepada Hiram dua puluh kota di negeri Galilea."
 },
 {
   "id": 9066,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 12,
   "firman": "Tetapi ketika Hiram datang dari Tirus untuk melihat-lihat kota-kota yang diberikan Salomo kepadanya itu, maka semuanya kurang menyenangkan hatinya."
 },
 {
   "id": 9067,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 13,
   "firman": "Sebab itu ia berkata: \"Macam apakah kota-kota yang telah kauberikan kepadaku ini, hai saudaraku?\" Maka orang menyebutkannya tanah Kabul sampai hari ini."
 },
 {
   "id": 9068,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 14,
   "firman": "Adapun Hiram telah mengirim kepada raja seratus dua puluh talenta emas."
 },
 {
   "id": 9069,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 15,
   "firman": "Beginilah hal orang-orang rodi yang telah dikerahkan oleh raja Salomo. Mereka dikerahkan untuk mendirikan rumah TUHAN, dan istana raja, dan Milo, dan tembok Yerusalem, dan juga untuk memperkuat Hazor, Megido dan Gezer."
 },
 {
   "id": 9070,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 16,
   "firman": "--Sebab Firaun, raja Mesir, telah maju berperang dan merebut Gezer, lalu membakarnya dan membunuh orang-orang Kanaan yang diam di kota itu. Kemudian diberikannya kota itu sebagai hadiah kawin kepada anaknya, isteri Salomo,"
 },
 {
   "id": 9071,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 17,
   "firman": "maka Salomo memperkuat Gezer--.Lagipula ada orang rodi yang dikerahkan di Bet-Horon Hilir,"
 },
 {
   "id": 9072,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 18,
   "firman": "di Baalat, di Tamar di padang gurun, yang ada di negeri Yehuda,"
 },
 {
   "id": 9073,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 19,
   "firman": "dan di segala kota perbekalan kepunyaan Salomo, di kota-kota tempat kereta, di kota-kota tempat orang berkuda dan di mana saja Salomo menginginkan mendirikan sesuatu di Yerusalem atau di gunung Libanon, atau di segenap negeri kekuasaannya."
 },
 {
   "id": 9074,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 20,
   "firman": "Semua orang yang masih tinggal dari orang Amori, orang Het, orang Feris, orang Hewi dan orang Yebus, yang tidak termasuk orang Israel,"
 },
 {
   "id": 9075,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 21,
   "firman": "yakni mereka yang masih tinggal di negeri itu dari keturunan bangsa-bangsa itu dan yang tidak dapat ditumpas oleh orang Israel, merekalah yang dikerahkan Salomo untuk menjadi budak rodi; demikianlah mereka sampai hari ini."
 },
 {
   "id": 9076,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 22,
   "firman": "Tetapi orang Israel tidak ada yang dijadikan budak oleh Salomo, melainkan mereka menjadi prajurit, pegawai, pembesar, perwira, atau panglima atas pasukan kereta dan pasukan berkuda."
 },
 {
   "id": 9077,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 23,
   "firman": "Inilah pemimpin-pemimpin umum yang mengepalai pekerjaan Salomo: lima ratus lima puluh orang memerintah rakyat yang melakukan pekerjaan itu."
 },
 {
   "id": 9078,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 24,
   "firman": "Segera sesudah anak Firaun pindah dari kota Daud ke rumah yang telah didirikan Salomo baginya, Salomopun mendirikan Milo."
 },
 {
   "id": 9079,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 25,
   "firman": "Tiga kali setahun Salomo mempersembahkan korban-korban bakaran dan korban-korban keselamatan di atas mezbah yang didirikannya bagi TUHAN, dan ia membakar korban api-apiannya di hadapan TUHAN. Demikianlah ia menyelesaikan rumah itu."
 },
 {
   "id": 9080,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 26,
   "firman": "Raja Salomo membuat juga kapal-kapal di Ezion-Geber yang ada di dekat Elot, di tepi Laut Teberau, di tanah Edom."
 },
 {
   "id": 9081,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 27,
   "firman": "Dengan kapal-kapal itu Hiram mengirim anak buahnya, yaitu anak-anak kapal yang tahu tentang laut, menyertai anak buah Salomo."
 },
 {
   "id": 9082,
   "kitab": "1Ra",
   "pasal": 9,
   "ayat": 28,
   "firman": "Mereka sampai ke Ofir dan dari sana mereka mengambil empat ratus dua puluh talenta emas, yang mereka bawa kepada raja Salomo."
 },
 {
   "id": 9083,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 1,
   "firman": "Ketika ratu negeri Syeba mendengar kabar tentang Salomo, berhubung dengan nama TUHAN, maka datanglah ia hendak mengujinya dengan teka-teki."
 },
 {
   "id": 9084,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 2,
   "firman": "Ia datang ke Yerusalem dengan pasukan pengiring yang sangat besar, dengan unta-unta yang membawa rempah-rempah, sangat banyak emas dan batu permata yang mahal-mahal. Setelah ia sampai kepada Salomo, dikatakannyalah segala yang ada dalam hatinya kepadanya."
 },
 {
   "id": 9085,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 3,
   "firman": "Dan Salomo menjawab segala pertanyaan ratu itu; bagi raja tidak ada yang tersembunyi, yang tidak dapat dijawabnya untuk ratu itu."
 },
 {
   "id": 9086,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 4,
   "firman": "Ketika ratu negeri Syeba melihat segala hikmat Salomo dan rumah yang telah didirikannya,"
 },
 {
   "id": 9087,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 5,
   "firman": "makanan di mejanya, cara duduk pegawai-pegawainya, cara pelayan-pelayannya melayani dan berpakaian, minumannya dan korban bakaran yang biasa dipersembahkannya di rumah TUHAN, maka tercenganglah ratu itu."
 },
 {
   "id": 9088,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 6,
   "firman": "Dan ia berkata kepada raja: \"Benar juga kabar yang kudengar di negeriku tentang engkau dan tentang hikmatmu,"
 },
 {
   "id": 9089,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 7,
   "firman": "tetapi aku tidak percaya perkataan-perkataan itu sampai aku datang dan melihatnya dengan mataku sendiri; sungguh setengahnyapun belum diberitahukan kepadaku; dalam hal hikmat dan kemakmuran, engkau melebihi kabar yang kudengar."
 },
 {
   "id": 9090,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 8,
   "firman": "Berbahagialah para isterimu, berbahagialah para pegawaimu ini yang selalu melayani engkau dan menyaksikan hikmatmu!"
 },
 {
   "id": 9091,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 9,
   "firman": "Terpujilah TUHAN, Allahmu, yang telah berkenan kepadamu sedemikian, hingga Ia mendudukkan engkau di atas takhta kerajaan Israel! Karena TUHAN mengasihi orang Israel untuk selama-lamanya, maka Ia telah mengangkat engkau menjadi raja untuk melakukan keadilan dan kebenaran.\""
 },
 {
   "id": 9092,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 10,
   "firman": "Lalu diberikannyalah kepada raja seratus dua puluh talenta emas, dan sangat banyak rempah-rempah dan batu permata yang mahal-mahal; tidak pernah datang lagi begitu banyak rempah-rempah seperti yang diberikan ratu negeri Syeba kepada raja Salomo itu."
 },
 {
   "id": 9093,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 11,
   "firman": "Lagipula kapal-kapal Hiram, yang mengangkut emas dari Ofir, membawa dari Ofir sangat banyak kayu cendana dan batu permata yang mahal-mahal."
 },
 {
   "id": 9094,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 12,
   "firman": "Raja mengerjakan kayu cendana itu menjadi langkan untuk rumah TUHAN dan untuk istana raja, dan juga menjadi kecapi dan gambus untuk para penyanyi; kayu cendana seperti itu tidak datang dan tidak kelihatan lagi sampai hari ini."
 },
 {
   "id": 9095,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 13,
   "firman": "Raja Salomo memberikan kepada ratu negeri Syeba segala yang dikehendakinya dan yang dimintanya, selain apa yang telah diberikannya kepadanya sebagaimana layak bagi raja Salomo. Lalu ratu itu berangkat pulang ke negerinya bersama-sama dengan pegawai-pegawainya."
 },
 {
   "id": 9096,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 14,
   "firman": "Adapun emas, yang dibawa kepada Salomo dalam satu tahun ialah seberat enam ratus enam puluh enam talenta,"
 },
 {
   "id": 9097,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 15,
   "firman": "belum terhitung yang didapat dari saudagar-saudagar dan dari pedagang-pedagang dan dari semua raja Arab dan bupati-bupati di negeri itu."
 },
 {
   "id": 9098,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 16,
   "firman": "Raja Salomo membuat dua ratus perisai besar dari emas tempaan, enam ratus syikal emas dipakainya untuk setiap perisai besar;"
 },
 {
   "id": 9099,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 17,
   "firman": "ia membuat juga tiga ratus perisai kecil dari emas tempaan, tiga mina emas dipakainya untuk setiap perisai kecil; lalu raja menaruh semuanya itu di dalam gedung \"Hutan Libanon\"."
 },
 {
   "id": 9100,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 18,
   "firman": "Juga raja membuat takhta besar dari gading, yang disalutnya dengan emas tua."
 },
 {
   "id": 9101,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 19,
   "firman": "Takhta itu enam tingkatnya; pada takhta itu ada di sebelah belakang sebuah kepala bundar, dan pada kedua sisi tempat duduk ada kelek-kelek. Di samping kelek-kelek itu berdiri dua singa,"
 },
 {
   "id": 9102,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 20,
   "firman": "sedang dua belas singa berdiri di atas keenam tingkat itu sebelah-menyebelah; belum pernah diperbuat yang demikian bagi sesuatu kerajaan."
 },
 {
   "id": 9103,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 21,
   "firman": "Segala perkakas minuman raja Salomo dari emas dan segala barang di gedung \"Hutan Libanon\" itu dari emas murni; tidak ada barang perak, sebab orang menganggap perak tidak berharga pada zaman Salomo."
 },
 {
   "id": 9104,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 22,
   "firman": "Sebab di laut raja mempunyai kapal-kapal Tarsis bergabung dengan kapal-kapal Hiram; dan sekali tiga tahun kapal-kapal Tarsis itu datang membawa emas dan perak serta gading; juga kera dan burung merak."
 },
 {
   "id": 9105,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 23,
   "firman": "Raja Salomo melebihi semua raja di bumi dalam hal kekayaan dan hikmat."
 },
 {
   "id": 9106,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 24,
   "firman": "Seluruh bumi berikhtiar menghadap Salomo untuk menyaksikan hikmat yang telah ditaruh Allah di dalam hatinya."
 },
 {
   "id": 9107,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 25,
   "firman": "Mereka datang masing-masing membawa persembahannya, yakni barang-barang perak dan barang-barang emas, pakaian, senjata, rempah-rempah, kuda dan bagal, dan begitulah tahun demi tahun."
 },
 {
   "id": 9108,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 26,
   "firman": "Salomo mengumpulkan juga kereta dan orang berkuda, sehingga ia mempunyai seribu empat ratus kereta dan dua belas ribu orang berkuda, yang semuanya ditempatkan dalam kota-kota kereta dan dekat raja di Yerusalem."
 },
 {
   "id": 9109,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 27,
   "firman": "Raja membuat banyaknya perak di Yerusalem sama seperti batu, dan banyaknya pohon kayu aras sama seperti pohon ara yang tumbuh di Daerah Bukit."
 },
 {
   "id": 9110,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 28,
   "firman": "Kuda untuk Salomo didatangkan dari Misraim dan dari Kewe; saudagar-saudagar raja membelinya dari Kewe dengan harga pasar."
 },
 {
   "id": 9111,
   "kitab": "1Ra",
   "pasal": 10,
   "ayat": 29,
   "firman": "Sebuah kereta yang didatangkan dari Misraim berharga sampai enam ratus syikal perak, dan seekor kuda sampai seratus lima puluh syikal; dan begitu juga melalui mereka dikeluarkan semuanya itu kepada semua raja orang Het dan kepada raja-raja Aram."
 },
 {
   "id": 9112,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 1,
   "firman": "Adapun raja Salomo mencintai banyak perempuan asing. Di samping anak Firaun ia mencintai perempuan-perempuan Moab, Amon, Edom, Sidon dan Het,"
 },
 {
   "id": 9113,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 2,
   "firman": "padahal tentang bangsa-bangsa itu TUHAN telah berfirman kepada orang Israel: \"Janganlah kamu bergaul dengan mereka dan merekapun janganlah bergaul dengan kamu, sebab sesungguhnya mereka akan mencondongkan hatimu kepada allah-allah mereka.\" Hati Salomo telah terpaut kepada mereka dengan cinta."
 },
 {
   "id": 9114,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 3,
   "firman": "Ia mempunyai tujuh ratus isteri dari kaum bangsawan dan tiga ratus gundik; isteri-isterinya itu menarik hatinya dari pada TUHAN."
 },
 {
   "id": 9115,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 4,
   "firman": "Sebab pada waktu Salomo sudah tua, isteri-isterinya itu mencondongkan hatinya kepada allah-allah lain, sehingga ia tidak dengan sepenuh hati berpaut kepada TUHAN, Allahnya, seperti Daud, ayahnya."
 },
 {
   "id": 9116,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 5,
   "firman": "Demikianlah Salomo mengikuti Asytoret, dewi orang Sidon, dan mengikuti Milkom, dewa kejijikan sembahan orang Amon,"
 },
 {
   "id": 9117,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 6,
   "firman": "dan Salomo melakukan apa yang jahat di mata TUHAN, dan ia tidak dengan sepenuh hati mengikuti TUHAN, seperti Daud, ayahnya."
 },
 {
   "id": 9118,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 7,
   "firman": "Pada waktu itu Salomo mendirikan bukit pengorbanan bagi Kamos, dewa kejijikan sembahan orang Moab, di gunung di sebelah timur Yerusalem dan bagi Molokh, dewa kejijikan sembahan bani Amon."
 },
 {
   "id": 9119,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 8,
   "firman": "Demikian juga dilakukannya bagi semua isterinya, orang-orang asing itu, yang mempersembahkan korban ukupan dan korban sembelihan kepada allah-allah mereka."
 },
 {
   "id": 9120,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 9,
   "firman": "Sebab itu TUHAN menunjukkan murka-Nya kepada Salomo, sebab hatinya telah menyimpang dari pada TUHAN, Allah Israel, yang telah dua kali menampakkan diri kepadanya,"
 },
 {
   "id": 9121,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 10,
   "firman": "dan yang telah memerintahkan kepadanya dalam hal ini supaya jangan mengikuti allah-allah lain, akan tetapi ia tidak berpegang pada yang diperintahkan TUHAN."
 },
 {
   "id": 9122,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 11,
   "firman": "Lalu berfirmanlah TUHAN kepada Salomo: \"Oleh karena begitu kelakuanmu, yakni engkau tidak berpegang pada perjanjian dan segala ketetapan-Ku yang telah Kuperintahkan kepadamu, maka sesungguhnya Aku akan mengoyakkan kerajaan itu dari padamu dan akan memberikannya kepada hambamu."
 },
 {
   "id": 9123,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 12,
   "firman": "Hanya, pada waktu hidupmu ini Aku belum mau melakukannya oleh karena Daud, ayahmu; dari tangan anakmulah Aku akan mengoyakkannya."
 },
 {
   "id": 9124,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 13,
   "firman": "Namun demikian, kerajaan itu tidak seluruhnya akan Kukoyakkan dari padanya, satu suku akan Kuberikan kepada anakmu oleh karena hamba-Ku Daud dan oleh karena Yerusalem yang telah Kupilih.\""
 },
 {
   "id": 9125,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 14,
   "firman": "Kemudian TUHAN membangkitkan seorang lawan Salomo, yakni Hadad, orang Edom; ia dari keturunan raja Edom."
 },
 {
   "id": 9126,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 15,
   "firman": "Sesudah Daud memukul kalah orang Edom, maka panglima Yoab pergi menguburkan orang-orang yang mati terbunuh, lalu menewaskan semua laki-laki di Edom;"
 },
 {
   "id": 9127,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 16,
   "firman": "enam bulan lamanya Yoab diam di sana dengan seluruh Israel, sampai dilenyapkannya semua laki-laki di Edom."
 },
 {
   "id": 9128,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 17,
   "firman": "Tetapi Hadad melarikan diri bersama-sama dengan beberapa orang Edom dari pegawai-pegawai ayahnya, dan mengungsi ke Mesir; adapun Hadad itu masih sangat muda."
 },
 {
   "id": 9129,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 18,
   "firman": "Mereka berangkat dari Midian, lalu sampai ke Paran; mereka membawa beberapa orang dari Paran, lalu mereka sampai ke Mesir kepada Firaun, raja Mesir. Ia ini memberikan rumah kepada Hadad, menentukan belanjanya dan menyerahkan sebidang tanah kepadanya."
 },
 {
   "id": 9130,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 19,
   "firman": "Hadad demikian disayangi Firaun, sehingga diberikannya kepadanya seorang isteri, yakni adik isterinya sendiri, adik permaisuri Tahpenes."
 },
 {
   "id": 9131,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 20,
   "firman": "Lalu adik Tahpenes itu melahirkan baginya seorang anak laki-laki, Genubat namanya, dan Tahpenes menyapih dia di istana Firaun, sehingga Genubat ada di istana Firaun di tengah-tengah anak-anak Firaun sendiri."
 },
 {
   "id": 9132,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 21,
   "firman": "Ketika didengar Hadad di Mesir, bahwa Daud telah mendapat perhentian bersama-sama dengan nenek moyangnya dan bahwa panglima Yoab sudah mati juga, maka berkatalah Hadad kepada Firaun: \"Biarkanlah aku pergi ke negeriku.\""
 },
 {
   "id": 9133,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 22,
   "firman": "Lalu bertanyalah Firaun kepadanya: \"Tetapi kekurangan apakah engkau padaku ini, maka engkau tiba-tiba berniat pergi ke negerimu?\" Jawabnya: \"Aku tidak kekurangan apapun, namun demikian, biarkanlah juga aku pergi.\""
 },
 {
   "id": 9134,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 23,
   "firman": "Allah membangkitkan pula seorang lawan Salomo, yakni Rezon bin Elyada, yang telah melarikan diri dari tuannya, yakni Hadadezer, raja Zoba."
 },
 {
   "id": 9135,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 24,
   "firman": "Ia mengumpulkan orang-orang, lalu menjadi kepala gerombolan. Ketika Daud hendak membunuh mereka, maka pergilah mereka ke Damsyik; mereka diam di sana dan di situlah mereka mengangkat Rezon menjadi raja."
 },
 {
   "id": 9136,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 25,
   "firman": "Dialah yang menjadi lawan Israel sepanjang umur Salomo; ia mendatangkan malapetaka sama seperti Hadad. Ia muak akan orang Israel dan menjadi raja atas Aram."
 },
 {
   "id": 9137,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 26,
   "firman": "Juga Yerobeam bin Nebat, seorang Efraim dari Zereda, seorang pegawai Salomo, nama ibunya Zerua, seorang janda, memberontak terhadap raja."
 },
 {
   "id": 9138,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 27,
   "firman": "Inilah alasannya, mengapa ia memberontak terhadap raja: Salomo mendirikan Milo, dan ia menutup tembusan tembok kota Daud, ayahnya."
 },
 {
   "id": 9139,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 28,
   "firman": "Yerobeam adalah seorang tangkas; ketika Salomo melihat, bahwa orang muda itu seorang yang rajin bekerja, maka ditempatkannyalah dia mengawasi semua pekerja wajib dari keturunan Yusuf."
 },
 {
   "id": 9140,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 29,
   "firman": "Pada waktu itu, ketika Yerobeam keluar dari Yerusalem, nabi Ahia, orang Silo itu, mendatangi dia di jalan dengan berselubungkan kain baru. Dan hanya mereka berdua ada di padang."
 },
 {
   "id": 9141,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 30,
   "firman": "Ahia memegang kain baru yang di badannya, lalu dikoyakkannya menjadi dua belas koyakan;"
 },
 {
   "id": 9142,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 31,
   "firman": "dan ia berkata kepada Yerobeam: \"Ambillah bagimu sepuluh koyakan, sebab beginilah firman TUHAN, Allah Israel: Sesungguhnya Aku akan mengoyakkan kerajaan itu dari tangan Salomo dan akan memberikan kepadamu sepuluh suku."
 },
 {
   "id": 9143,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 32,
   "firman": "Tetapi satu suku akan tetap padanya oleh karena hamba-Ku Daud dan oleh karena Yerusalem, kota yang Kupilih itu dari segala suku Israel."
 },
 {
   "id": 9144,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 33,
   "firman": "Sebabnya ialah karena ia telah meninggalkan Aku dan sujud menyembah kepada Asytoret, dewi orang Sidon, kepada Kamos, allah orang Moab dan kepada Milkom, allah bani Amon, dan ia tidak hidup menurut jalan yang Kutunjukkan dengan melakukan apa yang benar di mata-Ku dan dengan tetap mengikuti segala ketetapan dan peraturan-Ku, seperti Daud, ayahnya."
 },
 {
   "id": 9145,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 34,
   "firman": "Bukan dari tangannya akan Kuambil seluruh kerajaan itu; Aku akan membiarkan dia tetap menjadi raja seumur hidupnya, oleh karena hamba-Ku Daud yang telah Kupilih dan yang tetap mengikuti segala perintah dan ketetapan-Ku."
 },
 {
   "id": 9146,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 35,
   "firman": "Tetapi dari tangan anaknyalah Aku akan mengambil kerajaan itu dan akan memberikannya kepadamu, yakni sepuluh suku."
 },
 {
   "id": 9147,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 36,
   "firman": "Dan kepada anaknya akan Kuberikan satu suku, supaya hamba-Ku Daud selalu mempunyai keturunan di hadapan-Ku di Yerusalem, kota yang Kupilih bagi-Ku supaya nama-Ku tinggal di sana."
 },
 {
   "id": 9148,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 37,
   "firman": "Maka engkau ini akan Kuambil, supaya engkau memerintah atas segala yang dikehendaki hatimu dan menjadi raja atas Israel."
 },
 {
   "id": 9149,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 38,
   "firman": "Dan jika engkau mendengarkan segala yang Kuperintahkan kepadamu dan hidup menurut jalan yang Kutunjukkan dan melakukan apa yang benar di mata-Ku dengan tetap mengikuti segala ketetapan dan perintah-Ku seperti yang telah dilakukan oleh hamba-Ku Daud, maka Aku akan menyertai engkau dan Aku akan membangunkan bagimu suatu keluarga yang teguh seperti yang Kubangunkan bagi Daud, dan Aku akan memberikan orang Israel kepadamu."
 },
 {
   "id": 9150,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 39,
   "firman": "Dan untuk itu Aku akan merendahkan keturunan Daud, tetapi bukan untuk selamanya.\""
 },
 {
   "id": 9151,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 40,
   "firman": "Lalu Salomo berikhtiar membunuh Yerobeam, tetapi Yerobeam bangkit dan melarikan diri ke Mesir, kepada Sisak, raja Mesir, dan di Mesirlah ia tinggal sampai Salomo mati."
 },
 {
   "id": 9152,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 41,
   "firman": "Selebihnya dari riwayat Salomo dan segala yang dilakukannya dan hikmatnya, bukankah semuanya itu tertulis dalam kitab riwayat Salomo?"
 },
 {
   "id": 9153,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 42,
   "firman": "Lamanya Salomo memerintah di Yerusalem atas seluruh Israel ialah empat puluh tahun."
 },
 {
   "id": 9154,
   "kitab": "1Ra",
   "pasal": 11,
   "ayat": 43,
   "firman": "Kemudian Salomo mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di kota Daud, ayahnya. Maka Rehabeam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9155,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 1,
   "firman": "Kemudian Rehabeam pergi ke Sikhem, sebab seluruh Israel telah datang ke Sikhem untuk menobatkan dia menjadi raja."
 },
 {
   "id": 9156,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 2,
   "firman": "Segera sesudah hal itu kedengaran kepada Yerobeam bin Nebat--pada waktu itu dia masih ada di Mesir, sebab ia melarikan diri ke sana dari hadapan raja Salomo--maka kembalilah ia dari Mesir."
 },
 {
   "id": 9157,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 3,
   "firman": "Orang menyuruh memanggil dia, lalu datanglah Yerobeam dengan segenap jemaah Israel dan berkata kepada Rehabeam:"
 },
 {
   "id": 9158,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 4,
   "firman": "\"Ayahmu telah memberatkan tanggungan kami, maka sekarang ringankanlah pekerjaan yang sukar yang dibebankan ayahmu dan tanggungan yang berat yang dipikulkannya kepada kami, supaya kami menjadi hambamu.\""
 },
 {
   "id": 9159,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 5,
   "firman": "Tetapi ia menjawab mereka: \"Pergilah sampai lusa, kemudian kembalilah kepadaku.\" Lalu pergilah rakyat itu."
 },
 {
   "id": 9160,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 6,
   "firman": "Sesudah itu Rehabeam meminta nasihat dari para tua-tua yang selama hidup Salomo mendampingi Salomo, ayahnya, katanya: \"Apakah nasihatmu untuk menjawab rakyat itu?\""
 },
 {
   "id": 9161,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 7,
   "firman": "Mereka berkata: \"Jika hari ini engkau mau menjadi hamba rakyat, mau mengabdi kepada mereka dan menjawab mereka dengan kata-kata yang baik, maka mereka menjadi hamba-hambamu sepanjang waktu.\""
 },
 {
   "id": 9162,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 8,
   "firman": "Tetapi ia mengabaikan nasihat yang diberikan para tua-tua itu, lalu ia meminta nasihat kepada orang-orang muda yang sebaya dengan dia dan yang mendampinginya,"
 },
 {
   "id": 9163,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 9,
   "firman": "katanya kepada mereka: \"Apakah nasihatmu, supaya kita dapat menjawab rakyat yang mengatakan kepadaku: Ringankanlah tanggungan yang dipikulkan kepada kami oleh ayahmu?\""
 },
 {
   "id": 9164,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 10,
   "firman": "Lalu orang-orang muda yang sebaya dengan dia itu berkata: \"Beginilah harus kaukatakan kepada rakyat yang telah berkata kepadamu: Ayahmu telah memberatkan tanggungan kami, tetapi engkau ini, berilah keringanan kepada kami--beginilah harus kaukatakan kepada mereka: Kelingkingku lebih besar dari pada pinggang ayahku!"
 },
 {
   "id": 9165,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 11,
   "firman": "Maka sekarang, ayahku telah membebankan kepada kamu tanggungan yang berat, tetapi aku akan menambah tanggungan kamu; ayahku telah menghajar kamu dengan cambuk, tetapi aku akan menghajar kamu dengan cambuk yang berduri besi.\""
 },
 {
   "id": 9166,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 12,
   "firman": "Pada hari lusanya datanglah Yerobeam dengan segenap rakyat kepada Rehabeam, seperti yang dikatakan raja: \"Kembalilah kepadaku pada hari lusa.\""
 },
 {
   "id": 9167,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 13,
   "firman": "Raja menjawab rakyat itu dengan keras; ia telah mengabaikan nasihat yang diberikan para tua-tua kepadanya;"
 },
 {
   "id": 9168,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 14,
   "firman": "ia mengatakan kepada mereka menurut nasihat orang-orang muda: \"Ayahku telah memberatkan tanggungan kamu, tetapi aku akan menambah tanggunganmu itu; ayahku telah menghajar kamu dengan cambuk, tetapi aku akan menghajar kamu dengan cambuk yang berduri besi.\""
 },
 {
   "id": 9169,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 15,
   "firman": "Jadi raja tidak mendengarkan permintaan rakyat, sebab hal itu merupakan perubahan yang disebabkan TUHAN, supaya TUHAN menepati firman yang diucapkan-Nya dengan perantaraan Ahia, orang Silo, kepada Yerobeam bin Nebat."
 },
 {
   "id": 9170,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 16,
   "firman": "Setelah seluruh Israel melihat, bahwa raja tidak mendengarkan permintaan mereka, maka rakyat menjawab raja: \"Bagian apakah kita dapat dari pada Daud? Kita tidak memperoleh warisan dari anak Isai itu! Ke kemahmu, hai orang Israel! Uruslah sekarang rumahmu sendiri, hai Daud!\" Maka pergilah orang Israel ke kemahnya,"
 },
 {
   "id": 9171,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 17,
   "firman": "sehingga Rehabeam menjadi raja hanya atas orang Israel yang diam di kota-kota Yehuda."
 },
 {
   "id": 9172,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 18,
   "firman": "Kemudian raja Rehabeam mengutus Adoram yang menjadi kepala rodi, tetapi seluruh Israel melontari dia dengan batu, sehingga mati, bahkan raja Rehabeam hampir-hampir tidak dapat menaiki keretanya untuk melarikan diri ke Yerusalem."
 },
 {
   "id": 9173,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 19,
   "firman": "Demikianlah mulanya orang Israel memberontak terhadap keluarga Daud sampai hari ini."
 },
 {
   "id": 9174,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 20,
   "firman": "Segera sesudah seluruh Israel mendengar, bahwa Yerobeam sudah pulang, maka mereka menyuruh memanggil dia ke pertemuan jemaah, lalu mereka menobatkan dia menjadi raja atas seluruh Israel. Tidak ada lagi yang mengikuti keluarga Daud selain dari suku Yehuda saja."
 },
 {
   "id": 9175,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 21,
   "firman": "Ketika Rehabeam datang ke Yerusalem, ia mengumpulkan segenap kaum Yehuda dan suku Benyamin, seratus delapan puluh ribu teruna yang sanggup berperang untuk memerangi kaum Israel dengan maksud mengembalikan kerajaan itu kepada Rehabeam, anak Salomo."
 },
 {
   "id": 9176,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 22,
   "firman": "Tetapi datanglah firman Allah kepada Semaya, abdi Allah, demikian:"
 },
 {
   "id": 9177,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 23,
   "firman": "\"Katakanlah kepada Rehabeam, anak Salomo, raja Yehuda, dan kepada segenap kaum Yehuda dan Benyamin dan kepada selebihnya dari bangsa itu:"
 },
 {
   "id": 9178,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 24,
   "firman": "Beginilah firman TUHAN: Janganlah kamu maju dan janganlah kamu berperang melawan saudara-saudaramu, orang Israel. Pulanglah masing-masing ke rumahnya, sebab Akulah yang menyebabkan hal ini terjadi.\" Maka mereka mendengarkan firman TUHAN dan pergilah mereka pulang sesuai dengan firman TUHAN itu."
 },
 {
   "id": 9179,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 25,
   "firman": "Kemudian Yerobeam memperkuat Sikhem di pegunungan Efraim, lalu diam di sana. Ia keluar dari sana, lalu memperkuat Pnuel."
 },
 {
   "id": 9180,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 26,
   "firman": "Maka berkatalah Yerobeam dalam hatinya: \"Kini mungkin kerajaan itu kembali kepada keluarga Daud."
 },
 {
   "id": 9181,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 27,
   "firman": "Jika bangsa itu pergi mempersembahkan korban sembelihan di rumah TUHAN di Yerusalem, maka tentulah hati bangsa ini akan berbalik kepada tuan mereka, yaitu Rehabeam, raja Yehuda, kemudian mereka akan membunuh aku dan akan kembali kepada Rehabeam, raja Yehuda.\""
 },
 {
   "id": 9182,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 28,
   "firman": "Sesudah menimbang-nimbang, maka raja membuat dua anak lembu jantan dari emas dan ia berkata kepada mereka: \"Sudah cukup lamanya kamu pergi ke Yerusalem. Hai Israel, lihatlah sekarang allah-allahmu, yang telah menuntun engkau keluar dari tanah Mesir.\""
 },
 {
   "id": 9183,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 29,
   "firman": "Lalu ia menaruh lembu yang satu di Betel dan yang lain ditempatkannya di Dan."
 },
 {
   "id": 9184,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 30,
   "firman": "Maka hal itu menyebabkan orang berdosa, sebab rakyat pergi ke Betel menyembah patung yang satu dan ke Dan menyembah patung yang lain."
 },
 {
   "id": 9185,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 31,
   "firman": "Ia membuat juga kuil-kuil di atas bukit-bukit pengorbanan, dan mengangkat imam-imam dari kalangan rakyat yang bukan dari bani Lewi."
 },
 {
   "id": 9186,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 32,
   "firman": "Kemudian Yerobeam menentukan suatu hari raya pada hari yang kelima belas bulan kedelapan, sama seperti hari raya yang di Yehuda, dan ia sendiri naik tangga mezbah itu. Begitulah dibuatnya di Betel, yakni ia mempersembahkan korban kepada anak-anak lembu yang telah dibuatnya itu, dan ia menugaskan di Betel imam-imam bukit pengorbanan yang telah diangkatnya."
 },
 {
   "id": 9187,
   "kitab": "1Ra",
   "pasal": 12,
   "ayat": 33,
   "firman": "Ia naik tangga mezbah yang dibuatnya di Betel itu pada hari yang kelima belas dalam bulan yang kedelapan, dalam bulan yang telah direncanakannya dalam hatinya sendiri; ia menentukan suatu hari raya bagi orang Israel dan ia naik tangga mezbah itu untuk membakar korban."
 },
 {
   "id": 9188,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 1,
   "firman": "Sedang Yerobeam berdiri di atas mezbah itu sambil membakar korban, maka atas perintah TUHAN datanglah seorang abdi Allah dari Yehuda ke Betel."
 },
 {
   "id": 9189,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 2,
   "firman": "Lalu atas perintah TUHAN berserulah orang itu terhadap mezbah itu, katanya: \"Hai mezbah, hai mezbah! Beginilah firman TUHAN: Bahwasanya seorang anak akan lahir pada keluarga Daud, Yosia namanya; ia akan menyembelih di atasmu imam-imam bukit pengorbanan yang membakar korban di atasmu, juga tulang-tulang manusia akan dibakar di atasmu.\""
 },
 {
   "id": 9190,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 3,
   "firman": "Pada waktu itu juga ia memberitahukan suatu tanda ajaib, katanya: \"Inilah tanda ajaib, bahwa TUHAN telah berfirman: Bahwasanya mezbah itu akan pecah, sehingga tercurah abu yang di atasnya.\""
 },
 {
   "id": 9191,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 4,
   "firman": "Demi raja Yerobeam mendengar perkataan abdi Allah yang diserukannya terhadap mezbah di Betel itu, ia mengulurkan tangannya dari atas mezbah dan berkata: \"Tangkaplah dia!\" Tetapi tangan yang diulurkannya terhadap orang itu menjadi kejang, sehingga tidak dapat ditariknya kembali."
 },
 {
   "id": 9192,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 5,
   "firman": "Mezbah itupun pecahlah, sehingga abu yang di atasnya tercurah, sesuai dengan tanda ajaib yang diberitahukan abdi Allah itu atas perintah TUHAN."
 },
 {
   "id": 9193,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 6,
   "firman": "Lalu berbicaralah raja dan berkata kepada abdi Allah itu: \"Mohonkanlah belas kasihan TUHAN, Allahmu, dan berdoalah untukku, supaya tanganku dapat kembali.\" Dan abdi Allah itu memohonkan belas kasihan TUHAN, maka tangan raja itu dapat kembali dan menjadi seperti semula."
 },
 {
   "id": 9194,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 7,
   "firman": "Kemudian berbicaralah raja kepada abdi Allah itu: \"Marilah bersama-sama dengan aku ke rumah, segarkan badanmu, sesudah itu aku hendak memberikan suatu hadiah kepadamu.\""
 },
 {
   "id": 9195,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 8,
   "firman": "Tetapi abdi Allah itu berkata kepada raja: \"Sekalipun setengah dari istanamu kauberikan kepadaku, aku tidak mau singgah kepadamu; juga aku tidak mau makan roti atau minum air di tempat ini."
 },
 {
   "id": 9196,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sebab beginilah diperintahkan kepadaku atas firman TUHAN: Jangan makan roti atau minum air dan jangan kembali melalui jalan yang telah kautempuh itu.\""
 },
 {
   "id": 9197,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 10,
   "firman": "Lalu pergilah ia melalui jalan lain dan tidak kembali melalui jalan yang telah diambilnya untuk datang ke Betel."
 },
 {
   "id": 9198,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 11,
   "firman": "Di Betel diam seorang nabi tua. Anak-anaknya datang menceritakan kepadanya segala perbuatan yang dilakukan abdi Allah pada hari itu di Betel. Mereka menceriterakan juga kepada ayah mereka perkataan yang dikatakannya kepada raja."
 },
 {
   "id": 9199,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 12,
   "firman": "Kemudian ayah mereka bertanya: \"Dari jalan manakah ia pergi?\" Lalu anak-anaknya menunjukkan kepadanya jalan yang diambil abdi Allah yang datang dari Yehuda itu."
 },
 {
   "id": 9200,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 13,
   "firman": "Ia berkata kepada anak-anaknya: \"Pelanai keledai bagiku!\" Mereka memelanai keledai baginya, lalu ia menunggangnya"
 },
 {
   "id": 9201,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 14,
   "firman": "dan pergi mengikuti abdi Allah itu dan mendapatinya duduk di bawah sebuah pohon besar. Ia bertanya kepadanya: \"Engkaukah abdi Allah yang telah datang dari Yehuda?\" Jawabnya: \"Ya, akulah itu.\""
 },
 {
   "id": 9202,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 15,
   "firman": "Katanya kepadanya: \"Marilah bersama-sama aku ke rumah untuk makan roti.\""
 },
 {
   "id": 9203,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 16,
   "firman": "Tetapi jawabnya: \"Aku tidak dapat kembali bersama-sama engkau dan singgah kepadamu; aku tidak dapat makan roti atau minum air bersama-sama engkau di tempat ini,"
 },
 {
   "id": 9204,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 17,
   "firman": "sebab telah diperintahkan kepadaku atas firman TUHAN: Jangan makan roti atau minum air di sana. Jangan berjalan pulang melalui jalan yang telah kauambil itu.\""
 },
 {
   "id": 9205,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 18,
   "firman": "Lalu jawabnya kepadanya: \"Akupun seorang nabi juga seperti engkau, dan atas perintah TUHAN seorang malaikat telah berkata kepadaku: Bawa dia pulang bersama-sama engkau ke rumahmu, supaya ia makan roti dan minum air.\" Tetapi ia berbohong kepadanya."
 },
 {
   "id": 9206,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kemudian orang itu kembali bersama-sama dia, lalu makan roti dan minum air di rumahnya."
 },
 {
   "id": 9207,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 20,
   "firman": "Sedang mereka duduk menghadapi meja, datanglah firman TUHAN kepada nabi yang telah membawa dia pulang."
 },
 {
   "id": 9208,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 21,
   "firman": "Ia berseru kepada abdi Allah yang telah datang dari Yehuda: \"Beginilah firman TUHAN: Karena engkau telah memberontak terhadap titah TUHAN dan tidak berpegang pada segala perintah yang diperintahkan kepadamu oleh TUHAN, Allahmu,"
 },
 {
   "id": 9209,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 22,
   "firman": "tetapi kembali dan makan roti dan minum air di tempat ini walaupun Ia telah berfirman kepadamu: Jangan makan roti atau minum air, --maka mayatmu tidak akan masuk ke dalam kubur nenek moyangmu.\""
 },
 {
   "id": 9210,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 23,
   "firman": "Setelah orang itu makan roti dan minum air, dipelanailah keledai baginya."
 },
 {
   "id": 9211,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 24,
   "firman": "Orang itu pergi, tetapi di tengah jalan ia diserang seekor singa dan mati diterkam. Mayatnya tercampak di jalan dan keledai itu berdiri di sampingnya; singa itupun berdiri di samping mayat itu."
 },
 {
   "id": 9212,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 25,
   "firman": "Orang-orang yang lewat melihat mayat itu tercampak di jalan dan singa berdiri di sampingnya. Dan mereka menceriterakannya di kota tempat kediaman nabi tua itu."
 },
 {
   "id": 9213,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 26,
   "firman": "Ketika hal itu kedengaran kepada nabi yang telah membujuk dia berbalik kembali, ia berkata: \"Dialah abdi Allah yang telah memberontak terhadap titah TUHAN. TUHAN menyerahkan dia kepada singa, yang mencabik dan membunuhnya sesuai dengan firman TUHAN yang diucapkan-Nya kepadanya.\""
 },
 {
   "id": 9214,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 27,
   "firman": "Lalu berbicaralah ia kepada anak-anaknya: \"Pelanailah keledai bagiku.\" Dan mereka memelanainya."
 },
 {
   "id": 9215,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 28,
   "firman": "Kemudian ia pergi dan menemukan mayat orang itu tercampak di jalan, sedang keledai dan singa berdiri di sampingnya. Singa itu tidak memakan mayat itu dan tidak mencabik keledai itu."
 },
 {
   "id": 9216,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 29,
   "firman": "Nabi tua itu mengangkat mayat abdi Allah itu, menaruhnya ke atas keledai dan membawanya kembali ke kotanya sendiri untuk diratapi dan dikuburkan."
 },
 {
   "id": 9217,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 30,
   "firman": "Mayat orang itu dikuburkannya di dalam kuburnya sendiri, maka diratapilah dia: \"Wahai, saudaraku!\""
 },
 {
   "id": 9218,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 31,
   "firman": "Setelah ia menguburkannya, ia berkata kepada anak-anaknya: \"Kalau aku mati, kuburkanlah aku dalam kubur ini bersama dengan abdi Allah itu, dan taruhlah tulang-tulangku di sisi tulang-tulangnya."
 },
 {
   "id": 9219,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 32,
   "firman": "Sebab perkataan yang atas perintah TUHAN telah diserukannya terhadap mezbah yang di Betel itu dan terhadap segala kuil di bukit-bukit pengorbanan yang di kota-kota Samaria akan betul-betul terjadi.\""
 },
 {
   "id": 9220,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 33,
   "firman": "Sesudah peristiwa inipun Yerobeam tidak berbalik dari kelakuannya yang jahat itu, tetapi mengangkat pula imam-imam dari kalangan rakyat untuk bukit-bukit pengorbanan. Siapa yang mau saja, ditahbiskannya menjadi imam untuk bukit-bukit pengorbanan."
 },
 {
   "id": 9221,
   "kitab": "1Ra",
   "pasal": 13,
   "ayat": 34,
   "firman": "Dan tindakan itu menjadi dosa bagi keluarga Yerobeam, sehingga mereka dilenyapkan dan dipunahkan dari muka bumi."
 },
 {
   "id": 9222,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 1,
   "firman": "Pada waktu itu Abia, anak Yerobeam, jatuh sakit."
 },
 {
   "id": 9223,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 2,
   "firman": "Lalu Yerobeam berkata kepada isterinya: \"Berkemaslah! Menyamarlah, supaya jangan diketahui orang, bahwa engkau isteri Yerobeam, dan pergilah ke Silo. Bukankah di sana tinggal nabi Ahia! Dialah yang telah mengatakan tentang aku, bahwa aku akan menjadi raja atas bangsa ini."
 },
 {
   "id": 9224,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 3,
   "firman": "Bawalah sepuluh roti, kue kismis, dan sebuli-buli air madu, dan pergilah kepadanya. Dia akan memberitahukan kepadamu, apa yang akan terjadi dengan anak ini.\""
 },
 {
   "id": 9225,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 4,
   "firman": "Isteri Yerobeam berbuat demikian. Ia berkemas, pergi ke Silo dan masuk ke rumah Ahia. Ahia tidak dapat melihat lagi, sebab matanya sudah kabur karena ia sudah tua."
 },
 {
   "id": 9226,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 5,
   "firman": "Tetapi TUHAN telah berfirman kepada Ahia: \"Bahwasanya isteri Yerobeam datang untuk menanyakan kepadamu perihal anaknya, sebab anak itu sedang sakit. Begini-begini harus kaukatakan kepadanya.\" Ketika perempuan itu masuk, berbuatlah ia seolah-olah ia orang lain."
 },
 {
   "id": 9227,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi segera sesudah Ahia mendengar bunyi langkah perempuan itu, sementara melangkah masuk pintu, berkatalah ia: \"Masuklah, hai isteri Yerobeam! Mengapakah engkau berbuat seolah-olah engkau orang lain? Aku disuruh menyampaikan pesan yang keras kepadamu."
 },
 {
   "id": 9228,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 7,
   "firman": "Pergilah, katakan kepada Yerobeam: Beginilah firman TUHAN, Allah Israel: Aku telah meninggikan engkau dari tengah-tengah bangsa itu, dan mengangkat engkau menjadi raja atas umat-Ku Israel;"
 },
 {
   "id": 9229,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 8,
   "firman": "Aku telah mengoyakkan kerajaan dari keluarga Daud dan memberikannya kepadamu, tetapi engkau tidak seperti hamba-Ku Daud yang tetap mentaati segala perintah-Ku dan mengikuti Aku dengan segenap hatinya dan hanya melakukan apa yang benar di mata-Ku."
 },
 {
   "id": 9230,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 9,
   "firman": "Sebab engkau telah melakukan perbuatan jahat lebih dari semua orang yang mendahului engkau dan telah membuat bagimu allah lain dan patung-patung tuangan, sehingga engkau menimbulkan sakit hati-Ku, bahkan engkau telah membelakangi Aku."
 },
 {
   "id": 9231,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 10,
   "firman": "Maka Aku akan mendatangkan malapetaka kepada keluarga Yerobeam. Aku akan melenyapkan dari pada Yerobeam setiap orang laki-laki, baik yang tinggi maupun yang rendah kedudukannya di Israel. Aku akan menyapu keluarga Yerobeam seperti orang menyapu tahi sampai habis."
 },
 {
   "id": 9232,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 11,
   "firman": "Setiap orang dari pada Yerobeam yang mati di kota akan dimakan anjing dan yang mati di padang akan dimakan burung yang di udara. Sebab TUHAN telah mengatakannya."
 },
 {
   "id": 9233,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 12,
   "firman": "Tetapi bangunlah dan pulang ke rumahmu. Pada saat kakimu melangkah masuk kota, anak itu akan mati."
 },
 {
   "id": 9234,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 13,
   "firman": "Seluruh Israel akan meratapi dia dan menguburkan dia, sebab hanya dialah dari pada keluarga Yerobeam yang akan mendapat kubur, sebab di antara keluarga Yerobeam hanya padanyalah terdapat sesuatu yang baik di mata TUHAN, Allah Israel."
 },
 {
   "id": 9235,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 14,
   "firman": "Dan TUHAN akan membangkitkan bagi-Nya seorang raja atas Israel yang akan melenyapkan keluarga Yerobeam--seperti kenyataan sekarang ini."
 },
 {
   "id": 9236,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 15,
   "firman": "Kemudian TUHAN akan menghajar orang Israel, sehingga tergoyah-goyah seperti gelagah di air dan Ia akan menyentakkan mereka dari pada tanah yang baik ini yang telah diberikan-Nya kepada nenek moyang mereka; Ia akan menyerakkan mereka ke seberang sungai Efrat sana, oleh karena mereka telah membuat tiang-tiang berhala mereka dan dengan demikian menyakiti hati TUHAN."
 },
 {
   "id": 9237,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 16,
   "firman": "Ia akan lepas tangan terhadap orang Israel oleh karena dosa-dosa yang telah dilakukan Yerobeam dan yang mengakibatkan orang Israel berdosa pula.\""
 },
 {
   "id": 9238,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 17,
   "firman": "Sesudah itu bangkitlah isteri Yerobeam dan pergi, lalu sampailah ia ke Tirza. Pada saat ia masuk melangkahi ambang pintu rumah, matilah anak itu."
 },
 {
   "id": 9239,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 18,
   "firman": "Mereka menguburkannya, dan seluruh Israel meratapi dia sesuai dengan firman TUHAN yang diucapkan-Nya dengan perantaraan hamba-Nya, nabi Ahia."
 },
 {
   "id": 9240,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 19,
   "firman": "Selebihnya dari riwayat Yerobeam, bagaimana ia berperang dan bagaimana ia memerintah, sesungguhnya semuanya itu tertulis dalam kitab sejarah raja-raja Israel."
 },
 {
   "id": 9241,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 20,
   "firman": "Lamanya Yerobeam memerintah ada dua puluh dua tahun, kemudian ia mendapat perhentian bersama-sama dengan nenek moyangnya. Maka anaknya menjadi raja menggantikan dia."
 },
 {
   "id": 9242,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 21,
   "firman": "Adapun Rehabeam, anak Salomo, ia memerintah di Yehuda. Rehabeam berumur empat puluh satu tahun pada waktu ia menjadi raja, dan tujuh belas tahun lamanya ia memerintah di Yerusalem, kota yang dipilih TUHAN dari antara segala suku Israel untuk membuat nama-Nya tinggal di sana. Nama ibunya ialah Naama, seorang perempuan Amon."
 },
 {
   "id": 9243,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 22,
   "firman": "Tetapi orang Yehuda melakukan apa yang jahat di mata TUHAN dan mereka menimbulkan cemburu-Nya dengan dosa yang diperbuat mereka, lebih dari pada segala yang dilakukan nenek moyang mereka."
 },
 {
   "id": 9244,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 23,
   "firman": "Sebab merekapun juga mendirikan tempat-tempat pengorbanan dan tugu-tugu berhala dan tiang-tiang berhala di atas setiap bukit yang tinggi dan di bawah setiap pohon yang rimbun."
 },
 {
   "id": 9245,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 24,
   "firman": "Bahkan ada pelacuran bakti di negeri itu. Mereka berlaku sesuai dengan segala perbuatan keji bangsa-bangsa yang telah dihalau TUHAN dari orang Israel."
 },
 {
   "id": 9246,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 25,
   "firman": "Tetapi pada tahun kelima zaman raja Rehabeam, majulah Sisak, raja Mesir, menyerang Yerusalem."
 },
 {
   "id": 9247,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 26,
   "firman": "Ia merampas barang-barang perbendaharaan rumah TUHAN dan barang-barang perbendaharaan rumah raja; semuanya dirampasnya. Ia merampas juga segala perisai emas yang dibuat Salomo."
 },
 {
   "id": 9248,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 27,
   "firman": "Sebagai gantinya raja Rehabeam membuat perisai-perisai tembaga, yang dipercayakannya kepada pemimpin-pemimpin bentara yang menjaga pintu istana raja."
 },
 {
   "id": 9249,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 28,
   "firman": "Setiap kali raja masuk ke rumah TUHAN, bentara-bentara membawa masuk perisai-perisai itu, dan mereka pula yang mengembalikannya ke kamar jaga para bentara."
 },
 {
   "id": 9250,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 29,
   "firman": "Selebihnya dari riwayat Rehabeam dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9251,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 30,
   "firman": "Dan terus-menerus perang ada antara Rehabeam dan Yerobeam."
 },
 {
   "id": 9252,
   "kitab": "1Ra",
   "pasal": 14,
   "ayat": 31,
   "firman": "Kemudian Rehabeam mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud. Nama ibunya ialah Naama, seorang perempuan Amon. Maka Abiam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9253,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 1,
   "firman": "Dalam tahun kedelapan belas zaman raja Yerobeam bin Nebat menjadi rajalah Abiam atas Yehuda."
 },
 {
   "id": 9254,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 2,
   "firman": "Tiga tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Maakha, anak Abisalom."
 },
 {
   "id": 9255,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 3,
   "firman": "Abiam hidup dalam segala dosa yang telah dilakukan ayahnya sebelumnya, dan ia tidak dengan sepenuh hati berpaut kepada TUHAN, Allahnya, seperti Daud, moyangnya."
 },
 {
   "id": 9256,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 4,
   "firman": "Tetapi oleh karena Daud maka TUHAN, Allahnya, memberikan keturunan kepadanya di Yerusalem dengan mengangkat anaknya menggantikan dia dan dengan membiarkan Yerusalem berdiri,"
 },
 {
   "id": 9257,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 5,
   "firman": "karena Daud telah melakukan apa yang benar di mata TUHAN dan tidak menyimpang dari segala yang diperintahkan-Nya kepadanya seumur hidupnya, kecuali dalam perkara Uria, orang Het itu."
 },
 {
   "id": 9258,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 6,
   "firman": "Dan ada perang antara Rehabeam dan Yerobeam, seumur hidupnya."
 },
 {
   "id": 9259,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 7,
   "firman": "Selebihnya dari riwayat Abiam dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda? Dan ada perang antara Abiam dan Yerobeam."
 },
 {
   "id": 9260,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 8,
   "firman": "Kemudian Abiam mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di kota Daud. Maka Asa, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9261,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 9,
   "firman": "Dalam tahun kedua puluh zaman Yerobeam, raja Israel, Asa menjadi raja atas Yehuda."
 },
 {
   "id": 9262,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 10,
   "firman": "Empat puluh satu tahun lamanya ia memerintah di Yerusalem. Nama neneknya yang perempuan ialah Maakha, anak Abisalom."
 },
 {
   "id": 9263,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 11,
   "firman": "Asa melakukan apa yang benar di mata TUHAN seperti Daud, bapa leluhurnya."
 },
 {
   "id": 9264,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 12,
   "firman": "Ia menyingkirkan pelacuran bakti dari negeri itu dan menjauhkan segala berhala yang dibuat oleh nenek moyangnya."
 },
 {
   "id": 9265,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 13,
   "firman": "Bahkan ia memecat Maakha, neneknya, dari pangkat ibu suri, karena neneknya itu membuat patung Asyera yang keji. Asa merobohkan patung yang keji itu dan membakarnya di lembah Kidron."
 },
 {
   "id": 9266,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 14,
   "firman": "Sekalipun bukit-bukit pengorbanan tidak dijauhkan, namun Asa berpaut kepada TUHAN dengan segenap hatinya sepanjang umurnya."
 },
 {
   "id": 9267,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 15,
   "firman": "Ia membawa persembahan-persembahan kudus ayahnya dan persembahan-persembahan kudusnya sendiri ke rumah TUHAN, yakni emas dan perak serta barang-barang lain."
 },
 {
   "id": 9268,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 16,
   "firman": "Dan ada perang antara Asa dan Baesa, raja Israel, sepanjang umur mereka."
 },
 {
   "id": 9269,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 17,
   "firman": "Baesa, raja Israel, maju berperang melawan Yehuda, dan ia memperkuat Rama, dengan maksud mencegah lalu lintas kepada Asa, raja Yehuda."
 },
 {
   "id": 9270,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 18,
   "firman": "Tetapi Asa mengambil segala emas dan perak yang masih tinggal dalam perbendaharaan rumah TUHAN dan dalam perbendaharaan rumah raja dan menyerahkannya kepada pegawainya. Kemudian raja Asa mengutus mereka kepada Benhadad bin Tabrimon bin Hezion, raja Aram yang diam di Damsyik, dengan membawa pesan:"
 },
 {
   "id": 9271,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 19,
   "firman": "\"Ada perjanjian antara aku dan engkau, antara ayahku dan ayahmu. Di sini kukirim kepadamu suatu bingkisan, yakni emas dan perak. Marilah, batalkanlah perjanjianmu dengan Baesa, raja Israel, supaya ia undur dari padaku.\""
 },
 {
   "id": 9272,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 20,
   "firman": "Lalu Benhadad mendengarkan permintaan raja Asa; ia menyuruh panglima-panglimanya menyerang kota-kota Israel dan ia mengalahkan Iyon, Dan, Abel-Bet-Maakha dan seluruh Kinerot serta seluruh tanah Naftali."
 },
 {
   "id": 9273,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 21,
   "firman": "Segera sesudah Baesa mendengar hal itu, ia berhenti memperkuat Rama dan ia menetap di Tirza."
 },
 {
   "id": 9274,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 22,
   "firman": "Tetapi raja Asa mengerahkan segenap orang Yehuda, seorangpun tiada yang terkecuali; mereka harus mengangkat batu dan kayu yang dipergunakan Baesa untuk memperkuat Rama. Raja Asa mempergunakannya untuk memperkuat Geba-Benyamin dan Mizpa."
 },
 {
   "id": 9275,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 23,
   "firman": "Selebihnya dari seluruh riwayat Asa dan segala kepahlawanannya dan segala yang dilakukannya dan kota-kota yang diperkuatnya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda? Tetapi pada masa tuanya ia menderita sakit pada kedua kakinya."
 },
 {
   "id": 9276,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 24,
   "firman": "Kemudian Asa mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud, bapa leluhurnya. Maka Yosafat, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9277,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 25,
   "firman": "Nadab, anak Yerobeam, menjadi raja atas Israel dalam tahun kedua zaman Asa, raja Yehuda. Ia memerintah atas Israel dua tahun lamanya."
 },
 {
   "id": 9278,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 26,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, serta hidup menurut tingkah laku ayahnya dan menurut dosa ayahnya, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9279,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 27,
   "firman": "Dan Baesa bin Ahia, dari kaum Isakhar, mengadakan persepakatan melawan dia. Baesa menewaskan dia di Gibeton yang termasuk wilayah orang Filistin, sedang Nadab dan seluruh Israel mengepung Gibeton itu."
 },
 {
   "id": 9280,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 28,
   "firman": "Baesa membunuh dia dalam tahun ketiga zaman Asa, raja Yehuda, dan menjadi raja menggantikan dia."
 },
 {
   "id": 9281,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 29,
   "firman": "Segera sesudah ia menjadi raja, ia membunuh seluruh keluarga Yerobeam; tidak ada yang bernafas yang ditinggalkannya hidup dari pada Yerobeam, sampai dipunahkannya semuanya, sesuai dengan firman TUHAN yang diucapkan-Nya dengan perantaraan hamba-Nya Ahia, orang Silo itu,"
 },
 {
   "id": 9282,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 30,
   "firman": "oleh karena dosa-dosa yang telah dilakukan Yerobeam, yang mengakibatkan orang Israel berdosa pula, oleh sebab sakit hati yang ditimbulkannya pada TUHAN, Allah Israel."
 },
 {
   "id": 9283,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 31,
   "firman": "Selebihnya dari riwayat Nadab dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9284,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 32,
   "firman": "Dan ada perang antara Asa dan Baesa, raja Israel, sepanjang umur mereka."
 },
 {
   "id": 9285,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 33,
   "firman": "Dalam tahun ketiga zaman Asa, raja Yehuda, Baesa bin Ahia menjadi raja atas seluruh Israel di Tirza. Ia memerintah dua puluh empat tahun lamanya."
 },
 {
   "id": 9286,
   "kitab": "1Ra",
   "pasal": 15,
   "ayat": 34,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN serta hidup menurut tingkah laku Yerobeam dan menurut dosanya yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9287,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 1,
   "firman": "Kemudian datanglah firman TUHAN kepada Yehu bin Hanani melawan Baesa, bunyinya:"
 },
 {
   "id": 9288,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 2,
   "firman": "\"Oleh karena engkau telah Kutinggikan dari debu dan Kuangkat menjadi raja atas umat-Ku Israel, tetapi engkau telah hidup seperti Yerobeam dan telah menyuruh umat-Ku Israel berdosa, sehingga mereka menimbulkan sakit hati-Ku dengan dosa mereka,"
 },
 {
   "id": 9289,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 3,
   "firman": "maka sesungguhnya Aku akan menyapu bersih Baesa dan keluarganya, kemudian Aku akan membuat keluargamu seperti keluarga Yerobeam bin Nebat."
 },
 {
   "id": 9290,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 4,
   "firman": "Siapa yang mati dari pada Baesa di kota, akan dimakan anjing dan yang mati dari padanya di padang akan dimakan burung yang di udara.\""
 },
 {
   "id": 9291,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 5,
   "firman": "Selebihnya dari riwayat Baesa dan apa yang dilakukannya dan kepahlawanannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9292,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 6,
   "firman": "Kemudian Baesa mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di Tirza. Maka Ela, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9293,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 7,
   "firman": "Juga dengan perantaraan nabi Yehu bin Hanani firman TUHAN telah datang melawan Baesa dan melawan keluarganya, baik karena segala yang jahat yang telah dilakukannya di mata TUHAN, sehingga ia menimbulkan sakit hati TUHAN dengan perbuatan tangannya, dan dengan demikian menjadi sama seperti keluarga Yerobeam, maupun oleh karena ia telah membunuh Yerobeam."
 },
 {
   "id": 9294,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 8,
   "firman": "Dalam tahun kedua puluh enam zaman Asa, raja Yehuda, Ela, anak Baesa, menjadi raja atas Israel di Tirza. Ia memerintah dua tahun lamanya."
 },
 {
   "id": 9295,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 9,
   "firman": "Zimri, pegawainya yang menjadi panglima atas setengah dari pasukan kereta, mengadakan persepakatan melawan dia. Ketika ia minum-minum sampai mabuk di Tirza, di rumah Arza yang menjadi kepala istana di Tirza,"
 },
 {
   "id": 9296,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 10,
   "firman": "datanglah Zimri, lalu membunuh dia dalam tahun kedua puluh tujuh zaman Asa, raja Yehuda, dan ia menjadi raja menggantikan dia."
 },
 {
   "id": 9297,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 11,
   "firman": "Pada waktu ia menjadi raja itu, segera sesudah ia duduk di atas takhtanya, ia membunuh seluruh keluarga Baesa. Tidak ada seorang laki-lakipun dari padanya yang ditinggalkannya hidup, juga kaumnya, dan teman-temannya."
 },
 {
   "id": 9298,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 12,
   "firman": "Demikianlah Zimri memunahkan seluruh keluarga Baesa, sesuai dengan firman TUHAN yang diucapkan-Nya kepada Baesa dengan perantaraan nabi Yehu,"
 },
 {
   "id": 9299,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 13,
   "firman": "oleh karena segala dosa yang telah dilakukan Baesa dan Ela, anaknya, yang mengakibatkan orang Israel berdosa pula, sehingga mereka menimbulkan sakit hati TUHAN, Allah Israel, dengan dewa-dewa kesia-siaan mereka."
 },
 {
   "id": 9300,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 14,
   "firman": "Selebihnya dari riwayat Ela dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9301,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 15,
   "firman": "Dalam tahun kedua puluh tujuh zaman Asa, raja Yehuda, Zimri menjadi raja. Ia memerintah tujuh hari lamanya di Tirza, sedang rakyat berkemah mengepung Gibeton yang termasuk wilayah orang Filistin."
 },
 {
   "id": 9302,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 16,
   "firman": "Setelah rakyat yang berkemah itu mendengar orang mengatakan: \"Zimri telah mengadakan persepakatan, dan iapun telah membunuh raja,\" maka pada hari itu juga, di tempat perkemahan, seluruh Israel menobatkan Omri, panglima tentara, menjadi raja atas Israel."
 },
 {
   "id": 9303,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 17,
   "firman": "Kemudian Omri dengan seluruh Israel maju dari Gibeton, dan mereka mengepung Tirza."
 },
 {
   "id": 9304,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 18,
   "firman": "Segera sesudah Zimri melihat, bahwa kota itu telah direbut, masuklah ia ke dalam puri istana raja, lalu membakar istana raja itu sedang ia sendiri ada di dalamnya, dan ia mati,"
 },
 {
   "id": 9305,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 19,
   "firman": "oleh karena dosa-dosa yang telah dilakukannya dengan melakukan apa yang jahat di mata TUHAN serta hidup menurut tingkah laku Yerobeam dan menurut dosa Yerobeam yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9306,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 20,
   "firman": "Selebihnya dari riwayat Zimri dan persepakatan yang diadakannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9307,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 21,
   "firman": "Pada waktu itu bangsa Israel terbagi dua. Sebagian dari bangsa itu mengikuti Tibni bin Ginat, dan bermaksud mengangkat dia menjadi raja, dan sebagian lagi mengikuti Omri."
 },
 {
   "id": 9308,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 22,
   "firman": "Tetapi rakyat yang mengikuti Omri lebih kuat dari pada rakyat yang mengikuti Tibni bin Ginat. Sesudah Tibni mati, maka Omri menjadi raja."
 },
 {
   "id": 9309,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 23,
   "firman": "Dalam tahun ketiga puluh satu zaman Asa, raja Yehuda, Omri menjadi raja atas Israel dan ia memerintah dua belas tahun lamanya. Di Tirza ia memerintah enam tahun lamanya."
 },
 {
   "id": 9310,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 24,
   "firman": "Kemudian ia membeli gunung Samaria dari pada Semer dengan dua talenta perak. Ia mendirikan suatu kota di gunung itu dan menamainya Samaria, menurut nama Semer, pemilik gunung itu."
 },
 {
   "id": 9311,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 25,
   "firman": "Omri melakukan apa yang jahat di mata TUHAN dan ia melakukan kejahatan lebih dari pada segala orang yang mendahuluinya."
 },
 {
   "id": 9312,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 26,
   "firman": "Ia hidup menurut segala tingkah laku Yerobeam bin Nebat dan menurut dosa Yerobeam yang mengakibatkan orang Israel berdosa pula, sehingga mereka menimbulkan sakit hati TUHAN, Allah Israel, dengan dewa-dewa kesia-siaan mereka."
 },
 {
   "id": 9313,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 27,
   "firman": "Selebihnya dari riwayat Omri, apa yang dilakukannya dan kepahlawanannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9314,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 28,
   "firman": "Kemudian Omri mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di Samaria. Maka Ahab, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9315,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 29,
   "firman": "Ahab, anak Omri, menjadi raja atas Israel dalam tahun ketiga puluh delapan zaman Asa, raja Yehuda. Dan Ahab bin Omri memerintah dua puluh dua tahun lamanya atas Israel di Samaria."
 },
 {
   "id": 9316,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 30,
   "firman": "Ahab bin Omri melakukan apa yang jahat di mata TUHAN lebih dari pada semua orang yang mendahuluinya."
 },
 {
   "id": 9317,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 31,
   "firman": "Seakan-akan belum cukup ia hidup dalam dosa-dosa Yerobeam bin Nebat, maka ia mengambil pula Izebel, anak Etbaal, raja orang Sidon, menjadi isterinya, sehingga ia pergi beribadah kepada Baal dan sujud menyembah kepadanya."
 },
 {
   "id": 9318,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 32,
   "firman": "Kemudian ia membuat mezbah untuk Baal itu di kuil Baal yang didirikannya di Samaria."
 },
 {
   "id": 9319,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 33,
   "firman": "Sesudah itu Ahab membuat patung Asyera, dan Ahab melanjutkan bertindak demikian, sehingga ia menimbulkan sakit hati TUHAN, Allah Israel, lebih dari semua raja-raja Israel yang mendahuluinya."
 },
 {
   "id": 9320,
   "kitab": "1Ra",
   "pasal": 16,
   "ayat": 34,
   "firman": "Pada zamannya itu Hiel, orang Betel, membangun kembali Yerikho. Dengan membayarkan nyawa Abiram, anaknya yang sulung, ia meletakkan dasar kota itu, dan dengan membayarkan nyawa Segub, anaknya yang bungsu, ia memasang pintu gerbangnya, sesuai dengan firman TUHAN yang diucapkan-Nya dengan perantaraan Yosua bin Nun."
 },
 {
   "id": 9321,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 1,
   "firman": "Lalu berkatalah Elia, orang Tisbe, dari Tisbe-Gilead, kepada Ahab: \"Demi Tuhan yang hidup, Allah Israel, yang kulayani, sesungguhnya tidak akan ada embun atau hujan pada tahun-tahun ini, kecuali kalau kukatakan.\""
 },
 {
   "id": 9322,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 2,
   "firman": "Kemudian datanglah firman TUHAN kepadanya:"
 },
 {
   "id": 9323,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 3,
   "firman": "\"Pergilah dari sini, berjalanlah ke timur dan bersembunyilah di tepi sungai Kerit di sebelah timur sungai Yordan."
 },
 {
   "id": 9324,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 4,
   "firman": "Engkau dapat minum dari sungai itu, dan burung-burung gagak telah Kuperintahkan untuk memberi makan engkau di sana.\""
 },
 {
   "id": 9325,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 5,
   "firman": "Lalu ia pergi dan ia melakukan seperti firman TUHAN; ia pergi dan diam di tepi sungai Kerit di sebelah timur sungai Yordan."
 },
 {
   "id": 9326,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 6,
   "firman": "Pada waktu pagi dan petang burung-burung gagak membawa roti dan daging kepadanya, dan ia minum dari sungai itu."
 },
 {
   "id": 9327,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 7,
   "firman": "Tetapi sesudah beberapa waktu, sungai itu menjadi kering, sebab hujan tiada turun di negeri itu."
 },
 {
   "id": 9328,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 8,
   "firman": "Maka datanglah firman TUHAN kepada Elia:"
 },
 {
   "id": 9329,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 9,
   "firman": "\"Bersiaplah, pergi ke Sarfat yang termasuk wilayah Sidon, dan diamlah di sana. Ketahuilah, Aku telah memerintahkan seorang janda untuk memberi engkau makan.\""
 },
 {
   "id": 9330,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 10,
   "firman": "Sesudah itu ia bersiap, lalu pergi ke Sarfat. Setelah ia sampai ke pintu gerbang kota itu, tampaklah di sana seorang janda sedang mengumpulkan kayu api. Ia berseru kepada perempuan itu, katanya: \"Cobalah ambil bagiku sedikit air dalam kendi, supaya aku minum.\""
 },
 {
   "id": 9331,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 11,
   "firman": "Ketika perempuan itu pergi mengambilnya, ia berseru lagi: \"Cobalah ambil juga bagiku sepotong roti.\""
 },
 {
   "id": 9332,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 12,
   "firman": "Perempuan itu menjawab: \"Demi TUHAN, Allahmu, yang hidup, sesungguhnya tidak ada roti padaku sedikitpun, kecuali segenggam tepung dalam tempayan dan sedikit minyak dalam buli-buli. Dan sekarang aku sedang mengumpulkan dua tiga potong kayu api, kemudian aku mau pulang dan mengolahnya bagiku dan bagi anakku, dan setelah kami memakannya, maka kami akan mati.\""
 },
 {
   "id": 9333,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 13,
   "firman": "Tetapi Elia berkata kepadanya: \"Janganlah takut, pulanglah, buatlah seperti yang kaukatakan, tetapi buatlah lebih dahulu bagiku sepotong roti bundar kecil dari padanya, dan bawalah kepadaku, kemudian barulah kaubuat bagimu dan bagi anakmu."
 },
 {
   "id": 9334,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 14,
   "firman": "Sebab beginilah firman TUHAN, Allah Israel: Tepung dalam tempayan itu tidak akan habis dan minyak dalam buli-buli itupun tidak akan berkurang sampai pada waktu TUHAN memberi hujan ke atas muka bumi.\""
 },
 {
   "id": 9335,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 15,
   "firman": "Lalu pergilah perempuan itu dan berbuat seperti yang dikatakan Elia; maka perempuan itu dan dia serta anak perempuan itu mendapat makan beberapa waktu lamanya."
 },
 {
   "id": 9336,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 16,
   "firman": "Tepung dalam tempayan itu tidak habis dan minyak dalam buli-buli itu tidak berkurang seperti firman TUHAN yang diucapkan-Nya dengan perantaraan Elia."
 },
 {
   "id": 9337,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 17,
   "firman": "Sesudah itu anak dari perempuan pemilik rumah itu jatuh sakit dan sakitnya itu sangat keras sampai tidak ada nafasnya lagi."
 },
 {
   "id": 9338,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 18,
   "firman": "Kata perempuan itu kepada Elia: \"Apakah maksudmu datang ke mari, ya abdi Allah? Singgahkah engkau kepadaku untuk mengingatkan kesalahanku dan untuk menyebabkan anakku mati?\""
 },
 {
   "id": 9339,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 19,
   "firman": "Kata Elia kepadanya: \"Berikanlah anakmu itu kepadaku.\" Elia mengambilnya dari pangkuan perempuan itu dan membawanya naik ke kamarnya di atas, dan membaringkan anak itu di tempat tidurnya."
 },
 {
   "id": 9340,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 20,
   "firman": "Sesudah itu ia berseru kepada TUHAN, katanya: \"Ya TUHAN, Allahku! Apakah Engkau menimpakan kemalangan ini atas janda ini juga, yang menerima aku sebagai penumpang, dengan membunuh anaknya?\""
 },
 {
   "id": 9341,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 21,
   "firman": "Lalu ia mengunjurkan badannya di atas anak itu tiga kali, dan berseru kepada TUHAN, katanya: \"Ya TUHAN, Allahku! Pulangkanlah kiranya nyawa anak ini ke dalam tubuhnya.\""
 },
 {
   "id": 9342,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 22,
   "firman": "TUHAN mendengarkan permintaan Elia itu, dan nyawa anak itu pulang ke dalam tubuhnya, sehingga ia hidup kembali."
 },
 {
   "id": 9343,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 23,
   "firman": "Elia mengambil anak itu; ia membawanya turun dari kamar atas ke dalam rumah dan memberikannya kepada ibunya. Kata Elia: \"Ini anakmu, ia sudah hidup!\""
 },
 {
   "id": 9344,
   "kitab": "1Ra",
   "pasal": 17,
   "ayat": 24,
   "firman": "Kemudian kata perempuan itu kepada Elia: \"Sekarang aku tahu, bahwa engkau abdi Allah dan firman TUHAN yang kauucapkan itu adalah benar.\""
 },
 {
   "id": 9345,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 1,
   "firman": "Dan sesudah beberapa lama, datanglah firman TUHAN kepada Elia dalam tahun yang ketiga: \"Pergilah, perlihatkanlah dirimu kepada Ahab, sebab Aku hendak memberi hujan ke atas muka bumi.\""
 },
 {
   "id": 9346,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 2,
   "firman": "Lalu pergilah Elia memperlihatkan diri kepada Ahab. Adapun kelaparan itu berat di Samaria."
 },
 {
   "id": 9347,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 3,
   "firman": "Sebab itu Ahab telah memanggil Obaja yang menjadi kepala istana. Obaja itu seorang yang sungguh-sungguh takut akan TUHAN."
 },
 {
   "id": 9348,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 4,
   "firman": "Karena pada waktu Izebel melenyapkan nabi-nabi TUHAN, Obaja mengambil seratus orang nabi, lalu menyembunyikan mereka lima puluh lima puluh sekelompok dalam gua dan mengurus makanan dan minuman mereka."
 },
 {
   "id": 9349,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 5,
   "firman": "Ahab berkata kepada Obaja: \"Jelajahilah negeri ini dan pergi ke segala mata air dan ke semua sungai; barangkali kita menemukan rumput, sehingga kita dapat menyelamatkan kuda dan bagal, dan tidak usah kita memotong seekorpun dari hewan itu.\""
 },
 {
   "id": 9350,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 6,
   "firman": "Lalu mereka membagi-bagi tanah itu untuk menjelajahinya. Ahab pergi seorang diri ke arah yang satu dan Obaja pergi ke arah yang lain."
 },
 {
   "id": 9351,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 7,
   "firman": "Sedang Obaja di tengah jalan, ia bertemu dengan Elia. Setelah mengenali dia, ia sujud serta bertanya: \"Engkaukah ini, hai tuanku Elia?\""
 },
 {
   "id": 9352,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 8,
   "firman": "Jawab Elia kepadanya: \"Benar! Pergilah, katakan kepada tuanmu: Elia ada.\""
 },
 {
   "id": 9353,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 9,
   "firman": "Tetapi jawab Obaja: \"Apakah dosa yang telah kuperbuat, maka engkau hendak menyerahkan hambamu ini kepada Ahab, supaya aku dibunuhnya?"
 },
 {
   "id": 9354,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 10,
   "firman": "Demi TUHAN, Allahmu, yang hidup, sesungguhnya tidak ada bangsa atau kerajaan, yang tidak didatangi suruhan tuanku Ahab untuk mencari engkau. Dan apabila orang berkata: Ia tidak ada, maka ia menyuruh kerajaan atau bangsa itu bersumpah, bahwa engkau tidak ditemukan di sana."
 },
 {
   "id": 9355,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 11,
   "firman": "Dan sekarang engkau berkata: Pergilah, katakan kepada tuanmu: Elia ada."
 },
 {
   "id": 9356,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 12,
   "firman": "Mungkin terjadi, apabila aku sudah pergi dari padamu, Roh TUHAN mengangkat engkau ke tempat yang tidak kuketahui. Kalau aku sampai kepada Ahab untuk memberitahukannya dan engkau tidak didapatinya, tentulah ia akan membunuh aku, padahal hambamu ini dari sejak kecil takut akan TUHAN."
 },
 {
   "id": 9357,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 13,
   "firman": "Tidakkah diberitahukan kepada tuanku apa yang telah kulakukan pada waktu Izebel membunuh nabi-nabi TUHAN, bagaimana aku menyembunyikan seratus orang nabi-nabi TUHAN dalam gua, lima puluh lima puluh sekelompok dan mengurus makanan dan minuman mereka?"
 },
 {
   "id": 9358,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 14,
   "firman": "Dan sekarang, mengapa engkau ini berkata: Pergilah, katakan kepada tuanmu: Elia ada! Ia pasti akan membunuh aku.\""
 },
 {
   "id": 9359,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 15,
   "firman": "Jawab Elia: \"Demi TUHAN semesta alam yang hidup, yang kulayani, sesungguhnya hari ini juga aku akan memperlihatkan diri kepadanya.\""
 },
 {
   "id": 9360,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 16,
   "firman": "Lalu pergilah Obaja menemui Ahab dan memberitahukan hal itu kepadanya. Kemudian Ahab pergi menemui Elia."
 },
 {
   "id": 9361,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 17,
   "firman": "Segera sesudah Ahab melihat Elia, ia berkata kepadanya: \"Engkaukah itu, yang mencelakakan Israel?\""
 },
 {
   "id": 9362,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 18,
   "firman": "Jawab Elia kepadanya: \"Bukan aku yang mencelakakan Israel, melainkan engkau ini dan kaum keluargamu, sebab kamu telah meninggalkan perintah-perintah TUHAN dan engkau ini telah mengikuti para Baal."
 },
 {
   "id": 9363,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 19,
   "firman": "Sebab itu, suruhlah mengumpulkan seluruh Israel ke gunung Karmel, juga nabi-nabi Baal yang empat ratus lima puluh orang itu dan nabi-nabi Asyera yang empat ratus itu, yang mendapat makan dari meja istana Izebel.\""
 },
 {
   "id": 9364,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 20,
   "firman": "Ahab mengirim orang ke seluruh Israel dan mengumpulkan nabi-nabi itu ke gunung Karmel."
 },
 {
   "id": 9365,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 21,
   "firman": "Lalu Elia mendekati seluruh rakyat itu dan berkata: \"Berapa lama lagi kamu berlaku timpang dan bercabang hati? Kalau TUHAN itu Allah, ikutilah Dia, dan kalau Baal, ikutilah dia.\" Tetapi rakyat itu tidak menjawabnya sepatah katapun."
 },
 {
   "id": 9366,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 22,
   "firman": "Lalu Elia berkata kepada rakyat itu: \"Hanya aku seorang diri yang tinggal sebagai nabi TUHAN, padahal nabi-nabi Baal itu ada empat ratus lima puluh orang banyaknya."
 },
 {
   "id": 9367,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 23,
   "firman": "Namun, baiklah diberikan kepada kami dua ekor lembu jantan; biarlah mereka memilih seekor lembu, memotong-motongnya, menaruhnya ke atas kayu api, tetapi mereka tidak boleh menaruh api. Akupun akan mengolah lembu yang seekor lagi, meletakkannya ke atas kayu api dan juga tidak akan menaruh api."
 },
 {
   "id": 9368,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 24,
   "firman": "Kemudian biarlah kamu memanggil nama allahmu dan akupun akan memanggil nama TUHAN. Maka allah yang menjawab dengan api, dialah Allah!\" Seluruh rakyat menyahut, katanya: \"Baiklah demikian!\""
 },
 {
   "id": 9369,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 25,
   "firman": "Kemudian Elia berkata kepada nabi-nabi Baal itu: \"Pilihlah seekor lembu dan olahlah itu dahulu, karena kamu ini banyak. Sesudah itu panggillah nama allahmu, tetapi kamu tidak boleh menaruh api.\""
 },
 {
   "id": 9370,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 26,
   "firman": "Mereka mengambil lembu yang diberikan kepada mereka, mengolahnya dan memanggil nama Baal dari pagi sampai tengah hari, katanya: \"Ya Baal, jawablah kami!\" Tetapi tidak ada suara, tidak ada yang menjawab. Sementara itu mereka berjingkat-jingkat di sekeliling mezbah yang dibuat mereka itu."
 },
 {
   "id": 9371,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 27,
   "firman": "Pada waktu tengah hari Elia mulai mengejek mereka, katanya: \"Panggillah lebih keras, bukankah dia allah? Mungkin ia merenung, mungkin ada urusannya, mungkin ia bepergian; barangkali ia tidur, dan belum terjaga.\""
 },
 {
   "id": 9372,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 28,
   "firman": "Maka mereka memanggil lebih keras serta menoreh-noreh dirinya dengan pedang dan tombak, seperti kebiasaan mereka, sehingga darah bercucuran dari tubuh mereka."
 },
 {
   "id": 9373,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 29,
   "firman": "Sesudah lewat tengah hari, mereka kerasukan sampai waktu mempersembahkan korban petang, tetapi tidak ada suara, tidak ada yang menjawab, tidak ada tanda perhatian."
 },
 {
   "id": 9374,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 30,
   "firman": "Kata Elia kepada seluruh rakyat itu: \"Datanglah dekat kepadaku!\" Maka mendekatlah seluruh rakyat itu kepadanya. Lalu ia memperbaiki mezbah TUHAN yang telah diruntuhkan itu."
 },
 {
   "id": 9375,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 31,
   "firman": "Kemudian Elia mengambil dua belas batu, menurut jumlah suku keturunan Yakub. --Kepada Yakub ini telah datang firman TUHAN: \"Engkau akan bernama Israel.\" --"
 },
 {
   "id": 9376,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 32,
   "firman": "Ia mendirikan batu-batu itu menjadi mezbah demi nama TUHAN dan membuat suatu parit sekeliling mezbah itu yang dapat memuat dua sukat benih."
 },
 {
   "id": 9377,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 33,
   "firman": "Ia menyusun kayu api, memotong lembu itu dan menaruh potongan-potongannya di atas kayu api itu."
 },
 {
   "id": 9378,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 34,
   "firman": "Sesudah itu ia berkata: \"Penuhilah empat buyung dengan air, dan tuangkan ke atas korban bakaran dan ke atas kayu api itu!\" Kemudian katanya: \"Buatlah begitu untuk kedua kalinya!\" Dan mereka berbuat begitu untuk kedua kalinya. Kemudian katanya: \"Buatlah begitu untuk ketiga kalinya!\" Dan mereka berbuat begitu untuk ketiga kalinya,"
 },
 {
   "id": 9379,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 35,
   "firman": "sehingga air mengalir sekeliling mezbah itu; bahkan parit itupun penuh dengan air."
 },
 {
   "id": 9380,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 36,
   "firman": "Kemudian pada waktu mempersembahkan korban petang, tampillah nabi Elia dan berkata: \"Ya TUHAN, Allah Abraham, Ishak dan Israel, pada hari ini biarlah diketahui orang, bahwa Engkaulah Allah di tengah-tengah Israel dan bahwa aku ini hamba-Mu dan bahwa atas firman-Mulah aku melakukan segala perkara ini."
 },
 {
   "id": 9381,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 37,
   "firman": "Jawablah aku, ya TUHAN, jawablah aku, supaya bangsa ini mengetahui, bahwa Engkaulah Allah, ya TUHAN, dan Engkaulah yang membuat hati mereka tobat kembali.\""
 },
 {
   "id": 9382,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 38,
   "firman": "Lalu turunlah api TUHAN menyambar habis korban bakaran, kayu api, batu dan tanah itu, bahkan air yang dalam parit itu habis dijilatnya."
 },
 {
   "id": 9383,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 39,
   "firman": "Ketika seluruh rakyat melihat kejadian itu, sujudlah mereka serta berkata: \"TUHAN, Dialah Allah! TUHAN, Dialah Allah!\""
 },
 {
   "id": 9384,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 40,
   "firman": "Kata Elia kepada mereka: \"Tangkaplah nabi-nabi Baal itu, seorangpun dari mereka tidak boleh luput.\" Setelah ditangkap, Elia membawa mereka ke sungai Kison dan menyembelih mereka di sana."
 },
 {
   "id": 9385,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 41,
   "firman": "Kemudian berkatalah Elia kepada Ahab: \"Pergilah, makanlah dan minumlah, sebab bunyi derau hujan sudah kedengaran.\""
 },
 {
   "id": 9386,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 42,
   "firman": "Lalu Ahab pergi untuk makan dan minum. Tetapi Elia naik ke puncak gunung Karmel, lalu ia membungkuk ke tanah, dengan mukanya di antara kedua lututnya."
 },
 {
   "id": 9387,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 43,
   "firman": "Setelah itu ia berkata kepada bujangnya: \"Naiklah ke atas, lihatlah ke arah laut.\" Bujang itu naik ke atas, ia melihat dan berkata: \"Tidak ada apa-apa.\" Kata Elia: \"Pergilah sekali lagi.\" Demikianlah sampai tujuh kali."
 },
 {
   "id": 9388,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 44,
   "firman": "Pada ketujuh kalinya berkatalah bujang itu: \"Wah, awan kecil sebesar telapak tangan timbul dari laut.\" Lalu kata Elia: \"Pergilah, katakan kepada Ahab: Pasang keretamu dan turunlah, jangan sampai engkau terhalang oleh hujan.\""
 },
 {
   "id": 9389,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 45,
   "firman": "Maka dalam sekejap mata langit menjadi kelam oleh awan badai, lalu turunlah hujan yang lebat. Ahab naik kereta lalu pergi ke Yizreel."
 },
 {
   "id": 9390,
   "kitab": "1Ra",
   "pasal": 18,
   "ayat": 46,
   "firman": "Tetapi kuasa TUHAN berlaku atas Elia. Ia mengikat pinggangnya dan berlari mendahului Ahab sampai ke jalan yang menuju Yizreel."
 },
 {
   "id": 9391,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 1,
   "firman": "Ketika Ahab memberitahukan kepada Izebel segala yang dilakukan Elia dan perihal Elia membunuh semua nabi itu dengan pedang,"
 },
 {
   "id": 9392,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 2,
   "firman": "maka Izebel menyuruh seorang suruhan mengatakan kepada Elia: \"Beginilah kiranya para allah menghukum aku, bahkan lebih lagi dari pada itu, jika besok kira-kira pada waktu ini aku tidak membuat nyawamu sama seperti nyawa salah seorang dari mereka itu.\""
 },
 {
   "id": 9393,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 3,
   "firman": "Maka takutlah ia, lalu bangkit dan pergi menyelamatkan nyawanya; dan setelah sampai ke Bersyeba, yang termasuk wilayah Yehuda, ia meninggalkan bujangnya di sana."
 },
 {
   "id": 9394,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 4,
   "firman": "Tetapi ia sendiri masuk ke padang gurun sehari perjalanan jauhnya, lalu duduk di bawah sebuah pohon arar. Kemudian ia ingin mati, katanya: \"Cukuplah itu! Sekarang, ya TUHAN, ambillah nyawaku, sebab aku ini tidak lebih baik dari pada nenek moyangku.\""
 },
 {
   "id": 9395,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 5,
   "firman": "Sesudah itu ia berbaring dan tidur di bawah pohon arar itu. Tetapi tiba-tiba seorang malaikat menyentuh dia serta berkata kepadanya: \"Bangunlah, makanlah!\""
 },
 {
   "id": 9396,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 6,
   "firman": "Ketika ia melihat sekitarnya, maka pada sebelah kepalanya ada roti bakar, dan sebuah kendi berisi air. Lalu ia makan dan minum, kemudian berbaring pula."
 },
 {
   "id": 9397,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 7,
   "firman": "Tetapi malaikat TUHAN datang untuk kedua kalinya dan menyentuh dia serta berkata: \"Bangunlah, makanlah! Sebab kalau tidak, perjalananmu nanti terlalu jauh bagimu.\""
 },
 {
   "id": 9398,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 8,
   "firman": "Maka bangunlah ia, lalu makan dan minum, dan oleh kekuatan makanan itu ia berjalan empat puluh hari empat puluh malam lamanya sampai ke gunung Allah, yakni gunung Horeb."
 },
 {
   "id": 9399,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 9,
   "firman": "Di sana masuklah ia ke dalam sebuah gua dan bermalam di situ. Maka firman TUHAN datang kepadanya, demikian: \"Apakah kerjamu di sini, hai Elia?\""
 },
 {
   "id": 9400,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 10,
   "firman": "Jawabnya: \"Aku bekerja segiat-giatnya bagi TUHAN, Allah semesta alam, karena orang Israel meninggalkan perjanjian-Mu, meruntuhkan mezbah-mezbah-Mu dan membunuh nabi-nabi-Mu dengan pedang; hanya aku seorang dirilah yang masih hidup dan mereka ingin mencabut nyawaku.\""
 },
 {
   "id": 9401,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 11,
   "firman": "Lalu firman-Nya: \"Keluarlah dan berdiri di atas gunung itu di hadapan TUHAN!\" Maka TUHAN lalu! Angin besar dan kuat, yang membelah gunung-gunung dan memecahkan bukit-bukit batu, mendahului TUHAN. Tetapi tidak ada TUHAN dalam angin itu. Dan sesudah angin itu datanglah gempa. Tetapi tidak ada TUHAN dalam gempa itu."
 },
 {
   "id": 9402,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 12,
   "firman": "Dan sesudah gempa itu datanglah api. Tetapi tidak ada TUHAN dalam api itu. Dan sesudah api itu datanglah bunyi angin sepoi-sepoi basa."
 },
 {
   "id": 9403,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 13,
   "firman": "Segera sesudah Elia mendengarnya, ia menyelubungi mukanya dengan jubahnya, lalu pergi ke luar dan berdiri di pintu gua itu. Maka datanglah suara kepadanya yang berbunyi: \"Apakah kerjamu di sini, hai Elia?\""
 },
 {
   "id": 9404,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 14,
   "firman": "Jawabnya: \"Aku bekerja segiat-giatnya bagi TUHAN, Allah semesta alam, karena orang Israel meninggalkan perjanjian-Mu, meruntuhkan mezbah-mezbah-Mu dan membunuh nabi-nabi-Mu dengan pedang; hanya aku seorang dirilah yang masih hidup, dan mereka ingin mencabut nyawaku.\""
 },
 {
   "id": 9405,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 15,
   "firman": "Firman TUHAN kepadanya: \"Pergilah, kembalilah ke jalanmu, melalui padang gurun ke Damsyik, dan setelah engkau sampai, engkau harus mengurapi Hazael menjadi raja atas Aram."
 },
 {
   "id": 9406,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 16,
   "firman": "Juga Yehu, cucu Nimsi, haruslah kauurapi menjadi raja atas Israel, dan Elisa bin Safat, dari Abel-Mehola, harus kauurapi menjadi nabi menggantikan engkau."
 },
 {
   "id": 9407,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 17,
   "firman": "Maka siapa yang terluput dari pedang Hazael akan dibunuh oleh Yehu; dan siapa yang terluput dari pedang Yehu akan dibunuh oleh Elisa."
 },
 {
   "id": 9408,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 18,
   "firman": "Tetapi Aku akan meninggalkan tujuh ribu orang di Israel, yakni semua orang yang tidak sujud menyembah Baal dan yang mulutnya tidak mencium dia.\""
 },
 {
   "id": 9409,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 19,
   "firman": "Setelah Elia pergi dari sana, ia bertemu dengan Elisa bin Safat yang sedang membajak dengan dua belas pasang lembu, sedang ia sendiri mengemudikan yang kedua belas. Ketika Elia lalu dari dekatnya, ia melemparkan jubahnya kepadanya."
 },
 {
   "id": 9410,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 20,
   "firman": "Lalu Elisa meninggalkan lembu itu dan berlari mengikuti Elia, katanya: \"Biarkanlah aku mencium ayahku dan ibuku dahulu, lalu aku akan mengikuti engkau.\" Jawabnya kepadanya: \"Baiklah, pulang dahulu, dan ingatlah apa yang telah kuperbuat kepadamu.\""
 },
 {
   "id": 9411,
   "kitab": "1Ra",
   "pasal": 19,
   "ayat": 21,
   "firman": "Lalu berbaliklah ia dari pada Elia, ia mengambil pasangan lembu itu, menyembelihnya dan memasak dagingnya dengan bajak lembu itu sebagai kayu api; ia memberikan daging itu kepada orang-orangnya, kemudian makanlah mereka. Sesudah itu bersiaplah ia, lalu mengikuti Elia dan menjadi pelayannya."
 },
 {
   "id": 9412,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 1,
   "firman": "Benhadad, raja Aram, mengumpulkan seluruh tentaranya, tiga puluh dua orang raja bersama-sama dia beserta kuda dan kereta. Lalu ia maju, ia mengepung Samaria dan memeranginya."
 },
 {
   "id": 9413,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 2,
   "firman": "Kemudian ia mengirim utusan ke kota itu, kepada Ahab, raja Israel,"
 },
 {
   "id": 9414,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 3,
   "firman": "dengan pesan: \"Beginilah pesan Benhadad: Emasmu dan perakmu adalah milikku, dan juga isteri-isteri dan anak-anakmu yang cantik-cantik adalah milikku.\""
 },
 {
   "id": 9415,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 4,
   "firman": "Raja Israel menjawab, katanya: \"Seperti bicaramu itulah, ya tuanku raja. Aku ini dengan segala yang ada padaku adalah milikmu!\""
 },
 {
   "id": 9416,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 5,
   "firman": "Sesudah itu utusan-utusan itu kembali dan berkata: \"Beginilah pesan Benhadad: Memang aku telah menyuruh orang kepadamu mengatakan: Emas dan perakmu, isteri-isteri dan anak-anakmu harus kauserahkan kepadaku,"
 },
 {
   "id": 9417,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 6,
   "firman": "tetapi besok kira-kira pada waktu ini, aku akan menyuruh pegawai-pegawaiku kepadamu dan mereka akan menggeledah rumahmu dan rumah pegawai-pegawaimu, maka segala yang mereka lihat dan ingini akan mereka ambil dan mereka bawa.\""
 },
 {
   "id": 9418,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 7,
   "firman": "Lalu raja Israel memanggil semua tua-tua negeri itu dan berkata: \"Camkanlah, orang ini mengikhtiarkan kecelakaan kita, sebab ia telah menyuruh orang kepadaku meminta isteri-isteriku, anak-anakku, emas dan perakku, dan aku tidak menolak memberikannya kepadanya.\""
 },
 {
   "id": 9419,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 8,
   "firman": "Lalu kata semua tua-tua dan segenap rakyat itu kepadanya: \"Jangan dengarkan, jangan luluskan!\""
 },
 {
   "id": 9420,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 9,
   "firman": "Sebab itu ia berkata kepada utusan-utusan Benhadad: \"Katakanlah kepada tuanku raja: Segala yang pertama kali kausuruhkan kepada hambamu ini, aku akan melakukannya, tetapi tuntutan yang kemudian ini tidak dapat kupenuhi.\" Lalu pergilah utusan-utusan itu dan menyampaikan jawab itu kepada Benhadad."
 },
 {
   "id": 9421,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 10,
   "firman": "Benhadad menyuruh orang kepada Ahab dengan pesan: \"Beginilah kiranya para allah menghukum aku, bahkan lebih lagi dari pada itu, jika rakyat yang mengikut aku masih dapat menjemput segenggam penuh debu puing Samaria!\""
 },
 {
   "id": 9422,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 11,
   "firman": "Tetapi raja Israel menjawab, katanya: \"Katakanlah! Orang yang baru menyandangkan pedang janganlah memegahkan diri seperti orang yang sudah menanggalkannya.\""
 },
 {
   "id": 9423,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 12,
   "firman": "Segera sesudah Benhadad mendengar perkataan itu, pada waktu ia sedang minum-minum dengan raja-raja di pondok, berkatalah ia kepada pegawai-pegawainya: \"Aturlah barisanmu,\" lalu mereka mengatur barisannya melawan kota itu."
 },
 {
   "id": 9424,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 13,
   "firman": "Tetapi tiba-tiba tampillah seorang nabi kepada Ahab, raja Israel, serta berkata: \"Beginilah firman TUHAN: Sudahkah kaulihat semua orang yang sangat ramai itu? Bahwasanya pada hari ini Aku akan menyerahkan mereka ke dalam tanganmu, supaya engkau tahu, bahwa Akulah TUHAN.\""
 },
 {
   "id": 9425,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 14,
   "firman": "Lalu bertanyalah Ahab: \"Dengan bantuan siapa?\" Jawabnya: \"Beginilah firman TUHAN: Dengan bantuan orang-orang muda pengiring kepala-kepala daerah.\" Tanyanya pula: \"Siapakah yang akan memulai perang?\" Jawabnya: \"Engkau!\""
 },
 {
   "id": 9426,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 15,
   "firman": "Kemudian ia menghitung jumlah orang-orang muda pengiring kepala-kepala daerah itu. Ada dua ratus tiga puluh dua orang banyaknya dan sesudah mereka itu ia menghitung jumlah seluruh rakyat, yakni segenap orang Israel. Ada tujuh ribu orang banyaknya."
 },
 {
   "id": 9427,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 16,
   "firman": "Lalu mereka maju menyerang pada waktu tengah hari, sementara Benhadad minum-minum sampai mabuk di pondoknya, bersama dengan ketiga puluh dua raja yang membantunya."
 },
 {
   "id": 9428,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 17,
   "firman": "Ketika orang-orang muda pengiring kepala-kepala daerah itu maju menyerang lebih dahulu, maka Benhadad menyuruh orang menyelidiknya, dan mereka memberitahukan kepadanya, demikian: \"Ada orang-orang maju menyerang dari Samaria.\""
 },
 {
   "id": 9429,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 18,
   "firman": "Lalu katanya: \"Entah mereka datang dengan maksud damai, entah dengan maksud perang, tangkaplah mereka hidup-hidup!\""
 },
 {
   "id": 9430,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 19,
   "firman": "Sementara itu keluarlah mereka itu dari dalam kota, yakni orang-orang muda pengiring kepala-kepala daerah dan juga tentara yang mengikuti mereka."
 },
 {
   "id": 9431,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 20,
   "firman": "Lalu mereka masing-masing membunuh lawan yang dihadapinya, sehingga orang Aram itu melarikan diri dan dikejar oleh orang Israel. Tetapi Benhadad, raja Aram dapat meluputkan diri dengan naik kuda, beserta sejumlah orang berkuda."
 },
 {
   "id": 9432,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 21,
   "firman": "Juga raja Israel maju, lalu memusnahkan kuda dan kereta itu dan mendatangkan kekalahan yang besar kepada orang Aram."
 },
 {
   "id": 9433,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 22,
   "firman": "Lalu tampillah nabi itu kepada raja Israel dan berkata kepadanya: \"Baiklah, kuatkanlah hatimu, pertimbangkan dan pikirkanlah apa yang harus kauperbuat, sebab pada pergantian tahun raja Aram akan maju menyerang engkau.\""
 },
 {
   "id": 9434,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 23,
   "firman": "Pegawai-pegawai raja Aram berkata kepadanya: \"Allah mereka ialah allah gunung; itulah sebabnya mereka lebih kuat dari pada kita. Tetapi apabila kita berperang melawan mereka di tanah rata, pastilah kita lebih kuat dari pada mereka."
 },
 {
   "id": 9435,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 24,
   "firman": "Bertindaklah begini: Pecatlah raja-raja itu masing-masing dari kedudukannya, dan angkatlah bupati-bupati menggantikan mereka."
 },
 {
   "id": 9436,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 25,
   "firman": "Lalu kerahkanlah tentara sebanyak tentara yang telah gugur dari pihakmu itu, demikian pula kuda dan kereta sebanyak yang dahulu. Marilah kita berperang melawan mereka di tanah rata, pastilah kita lebih kuat dari pada mereka.\" Raja mendengarkan usul mereka, dan bertindak demikian."
 },
 {
   "id": 9437,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 26,
   "firman": "Dalam tahun yang berikutnya Benhadad memeriksa barisan orang Aram, lalu ia maju ke Afek untuk berperang melawan orang Israel."
 },
 {
   "id": 9438,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 27,
   "firman": "Orang Israelpun memeriksa barisannya dan setelah dibekali mereka berangkat menghadapi orang Aram. Orang Israel berkemah di hadapan mereka seperti dua kawanan kambing, sedang orang Aram telah datang membanjiri negeri itu."
 },
 {
   "id": 9439,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 28,
   "firman": "Maka tampillah abdi Allah dan berkata kepada raja Israel: \"Beginilah firman TUHAN: Oleh karena orang Aram itu telah berkata: TUHAN ialah allah gunung dan bukan allah dataran, maka Aku akan menyerahkan seluruh tentara yang besar itu ke dalam tanganmu, supaya kamu tahu, bahwa Akulah TUHAN.\""
 },
 {
   "id": 9440,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 29,
   "firman": "Tujuh hari lamanya mereka berkemah berhadap-hadapan. Tetapi pada hari yang ketujuh mulailah pertempuran, dan pada suatu hari orang Israel menewaskan seratus ribu orang berjalan kaki dari orang Aram itu."
 },
 {
   "id": 9441,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 30,
   "firman": "Orang-orang yang masih tinggal melarikan diri ke Afek, ke dalam kota, tetapi temboknya roboh menimpa kedua puluh tujuh ribu orang yang masih tinggal itu. Sementara itu Benhadad melarikan diri dan masuk ke kota, dan bersembunyi dari satu kamar ke kamar yang lain."
 },
 {
   "id": 9442,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 31,
   "firman": "Lalu berkatalah pegawai-pegawainya kepadanya: \"Ketahuilah, kami telah mendengar, bahwa raja-raja kaum Israel itu adalah raja-raja pemurah. Marilah kita menaruh kain kabung pada pinggang kita dan tali pada kepala kita, dan dengan demikian keluar menghadap raja Israel; barangkali ia akan menyelamatkan nyawamu.\""
 },
 {
   "id": 9443,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 32,
   "firman": "Lalu mereka melilitkan kain kabung pada pinggang mereka dan tali pada kepala mereka, kemudian mereka pergi menghadap raja Israel sambil berkata: \"Hambamu Benhadad berkata: Kiranya tuanku membiarkan aku hidup.\" Jawabnya: \"Masih hidupkah dia? Dia saudaraku.\""
 },
 {
   "id": 9444,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 33,
   "firman": "Orang-orang itu menganggap hal itu sebagai tanda yang baik, maka segeralah mereka berpegang pada perkataannya itu, lalu berkata: \"Memang saudaramu Benhadad!\" Sesudah itu berkatalah Ahab: \"Pergilah, ambil dia!\" Jadi keluarlah Benhadad mendapatkan dia, lalu diajak naik ke atas kereta."
 },
 {
   "id": 9445,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 34,
   "firman": "Kata Benhadad kepadanya: \"Kota-kota yang telah diambil bapaku dari pihak bapamu akan kukembalikan; engkau boleh juga membuat pasar bagimu di Damsyik, seperti yang dibuat bapaku di Samaria.\" \"Dan aku sendiri,\" kata Ahab, \"akan membiarkan engkau pergi dengan perjanjian.\" Lalu ia mengadakan perjanjian dengan dia dan membiarkannya pergi."
 },
 {
   "id": 9446,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 35,
   "firman": "Seorang dari rombongan nabi berkata kepada temannya atas perintah TUHAN: \"Pukullah aku!\" Tetapi orang itu menolak memukulnya."
 },
 {
   "id": 9447,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 36,
   "firman": "Lalu ia berkata kepadanya: \"Oleh sebab engkau tidak mendengarkan suara TUHAN, ketahuilah, apabila engkau pergi dari padaku, seekor singa akan menerkam engkau.\" Dan ketika orang itu pergi dari padanya, maka seekor singa bertemu dengan dia, lalu menerkam dia."
 },
 {
   "id": 9448,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 37,
   "firman": "Kemudian nabi itu bertemu dengan orang lain, lalu ia berkata: \"Pukullah aku!\" Orang itu memukul dan melukai dia."
 },
 {
   "id": 9449,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 38,
   "firman": "Sesudah itu nabi itu pergi dan berdiri menantikan raja di jalan, sambil menyamar dengan membubuh kain pembalut pada matanya."
 },
 {
   "id": 9450,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 39,
   "firman": "Pada waktu raja lewat, ia mengadukan halnya kepada raja, katanya: \"Ketika hambamu ini maju ke tengah pertempuran, tiba-tiba ada seorang meninggalkan barisan dan membawa seorang kepadaku sambil berkata: Jagalah orang ini, jika ia hilang dengan cara bagaimanapun juga, maka nyawamu adalah ganti nyawanya, atau engkau harus membayar setalenta perak."
 },
 {
   "id": 9451,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 40,
   "firman": "Ketika hambamu ini repot sana sini, orang itu menghilang.\" Kemudian raja Israel itu berkata kepadanya: \"Begitu jugalah hukumanmu, engkau sendiri telah menetapkannya.\""
 },
 {
   "id": 9452,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 41,
   "firman": "Lalu segeralah ia membuka kain pembalut itu dari matanya, sehingga raja Israel mengenali dia sebagai seorang dari rombongan nabi."
 },
 {
   "id": 9453,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 42,
   "firman": "Kata nabi itu kepadanya: \"Beginilah firman TUHAN: Oleh karena engkau telah membiarkan lolos orang yang dikhususkan bagi-Ku untuk ditumpas, maka nyawamu adalah ganti nyawanya dan rakyatmu ganti rakyatnya.\""
 },
 {
   "id": 9454,
   "kitab": "1Ra",
   "pasal": 20,
   "ayat": 43,
   "firman": "Lalu raja Israel pergi ke istananya dengan kesal hati dan gusar, maka sampailah ia di Samaria."
 },
 {
   "id": 9455,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 1,
   "firman": "Sesudah itu terjadilah hal yang berikut. Nabot, orang Yizreel, mempunyai kebun anggur di Yizreel, di samping istana Ahab, raja Samaria."
 },
 {
   "id": 9456,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 2,
   "firman": "Berkatalah Ahab kepada Nabot: \"Berikanlah kepadaku kebun anggurmu itu, supaya kujadikan kebun sayur, sebab letaknya dekat rumahku. Aku akan memberikan kepadamu kebun anggur yang lebih baik dari pada itu sebagai gantinya, atau jikalau engkau lebih suka, aku akan membayar harganya kepadamu dengan uang.\""
 },
 {
   "id": 9457,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 3,
   "firman": "Jawab Nabot kepada Ahab: \"Kiranya TUHAN menghindarkan aku dari pada memberikan milik pusaka nenek moyangku kepadamu!\""
 },
 {
   "id": 9458,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 4,
   "firman": "Lalu masuklah Ahab ke dalam istananya dengan kesal hati dan gusar karena perkataan yang dikatakan Nabot, orang Yizreel itu, kepadanya: \"Tidak akan kuberikan kepadamu milik pusaka nenek moyangku.\" Maka berbaringlah ia di tempat tidurnya dan menelungkupkan mukanya dan tidak mau makan."
 },
 {
   "id": 9459,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 5,
   "firman": "Lalu datanglah Izebel, isterinya, dan berkata kepadanya: \"Apa sebabnya hatimu kesal, sehingga engkau tidak makan?\""
 },
 {
   "id": 9460,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 6,
   "firman": "Lalu jawabnya kepadanya: \"Sebab aku telah berkata kepada Nabot, orang Yizreel itu: Berikanlah kepadaku kebun anggurmu dengan bayaran uang atau jika engkau lebih suka, aku akan memberikan kebun anggur kepadamu sebagai gantinya. Tetapi sahutnya: Tidak akan kuberikan kepadamu kebun anggurku itu.\""
 },
 {
   "id": 9461,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 7,
   "firman": "Kata Izebel, isterinya, kepadanya: \"Bukankah engkau sekarang yang memegang kuasa raja atas Israel? Bangunlah, makanlah dan biarlah hatimu gembira! Aku akan memberikan kepadamu kebun anggur Nabot, orang Yizreel itu.\""
 },
 {
   "id": 9462,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 8,
   "firman": "Kemudian ia menulis surat atas nama Ahab, memeteraikannya dengan meterai raja, lalu mengirim surat itu kepada tua-tua dan pemuka-pemuka yang diam sekota dengan Nabot."
 },
 {
   "id": 9463,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 9,
   "firman": "Dalam surat itu ditulisnya demikian: \"Maklumkanlah puasa dan suruhlah Nabot duduk paling depan di antara rakyat."
 },
 {
   "id": 9464,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 10,
   "firman": "Suruh jugalah dua orang dursila duduk menghadapinya, dan mereka harus naik saksi terhadap dia, dengan mengatakan: Engkau telah mengutuk Allah dan raja. Sesudah itu bawalah dia ke luar dan lemparilah dia dengan batu sampai mati.\""
 },
 {
   "id": 9465,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 11,
   "firman": "Orang-orang sekotanya, yakni tua-tua dan pemuka-pemuka, yang diam di kotanya itu, melakukan seperti yang diperintahkan Izebel kepada mereka, seperti yang tertulis dalam surat yang dikirimkannya kepada mereka."
 },
 {
   "id": 9466,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 12,
   "firman": "Mereka memaklumkan puasa dan menyuruh Nabot duduk paling depan di antara rakyat."
 },
 {
   "id": 9467,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 13,
   "firman": "Kemudian datanglah dua orang, yakni orang-orang dursila itu, lalu duduk menghadapi Nabot. Orang-orang dursila itu naik saksi terhadap Nabot di depan rakyat, katanya: \"Nabot telah mengutuk Allah dan raja.\" Sesudah itu mereka membawa dia ke luar kota, lalu melempari dia dengan batu sampai mati."
 },
 {
   "id": 9468,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 14,
   "firman": "Setelah itu mereka menyuruh orang kepada Izebel mengatakan: \"Nabot sudah dilempari sampai mati.\""
 },
 {
   "id": 9469,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 15,
   "firman": "Segera sesudah Izebel mendengar, bahwa Nabot sudah dilempari sampai mati, berkatalah Izebel kepada Ahab: \"Bangunlah, ambillah kebun anggur Nabot, orang Yizreel itu, menjadi milikmu, karena Nabot yang menolak memberikannya kepadamu dengan bayaran uang, sudah tidak hidup lagi; ia sudah mati.\""
 },
 {
   "id": 9470,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 16,
   "firman": "Segera sesudah Ahab mendengar, bahwa Nabot sudah mati, ia bangun dan pergi ke kebun anggur Nabot, orang Yizreel itu, untuk mengambil kebun itu menjadi miliknya."
 },
 {
   "id": 9471,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 17,
   "firman": "Tetapi datanglah firman TUHAN kepada Elia, orang Tisbe itu, bunyinya:"
 },
 {
   "id": 9472,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 18,
   "firman": "\"Bangunlah, pergilah menemui Ahab, raja Israel yang di Samaria. Ia telah pergi ke kebun anggur Nabot untuk mengambil kebun itu menjadi miliknya."
 },
 {
   "id": 9473,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 19,
   "firman": "Katakanlah kepadanya, demikian: Beginilah firman TUHAN: Engkau telah membunuh serta merampas juga! Katakan pula kepadanya: Beginilah firman TUHAN: Di tempat anjing telah menjilat darah Nabot, di situ jugalah anjing akan menjilat darahmu.\""
 },
 {
   "id": 9474,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 20,
   "firman": "Kata Ahab kepada Elia: \"Sekarang engkau mendapat aku, hai musuhku?\" Jawabnya: \"Memang sekarang aku mendapat engkau, karena engkau sudah memperbudak diri dengan melakukan apa yang jahat di mata TUHAN."
 },
 {
   "id": 9475,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 21,
   "firman": "Sesungguhnya, Aku akan mendatangkan malapetaka kepadamu, Aku akan menyapu engkau dan melenyapkan setiap orang laki-laki dari keluarga Ahab, baik yang tinggi maupun yang rendah kedudukannya di Israel."
 },
 {
   "id": 9476,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 22,
   "firman": "Dan Aku akan memperlakukan keluargamu sama seperti keluarga Yerobeam bin Nebat dan seperti keluarga Baesa bin Ahia, oleh karena engkau menimbulkan sakit hati-Ku, dan oleh karena engkau mengakibatkan orang Israel berbuat dosa."
 },
 {
   "id": 9477,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 23,
   "firman": "Juga mengenai Izebel TUHAN telah berfirman: Anjing akan memakan Izebel di tembok luar Yizreel."
 },
 {
   "id": 9478,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 24,
   "firman": "Siapa dari keluarga Ahab yang mati di kota akan dimakan anjing dan yang mati di padang akan dimakan burung di udara.\""
 },
 {
   "id": 9479,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 25,
   "firman": "Sesungguhnya tidak pernah ada orang seperti Ahab yang memperbudak diri dengan melakukan apa yang jahat di mata TUHAN, karena ia telah dibujuk oleh Izebel, isterinya."
 },
 {
   "id": 9480,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 26,
   "firman": "Bahkan ia telah berlaku sangat keji dengan mengikuti berhala-berhala, tepat seperti yang dilakukan oleh orang Amori yang telah dihalau TUHAN dari depan orang Israel."
 },
 {
   "id": 9481,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 27,
   "firman": "Segera sesudah Ahab mendengar perkataan itu, ia mengoyakkan pakaiannya, mengenakan kain kabung pada tubuhnya dan berpuasa. Bahkan ia tidur dengan memakai kain kabung, dan berjalan dengan langkah lamban."
 },
 {
   "id": 9482,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 28,
   "firman": "Lalu datanglah firman TUHAN kepada Elia, orang Tisbe itu:"
 },
 {
   "id": 9483,
   "kitab": "1Ra",
   "pasal": 21,
   "ayat": 29,
   "firman": "\"Sudahkah kaulihat, bahwa Ahab merendahkan diri di hadapan-Ku? Oleh karena ia telah merendahkan diri di hadapan-Ku, maka Aku tidak akan mendatangkan malapetaka dalam zamannya; barulah dalam zaman anaknya Aku akan mendatangkan malapetaka atas keluarganya.\""
 },
 {
   "id": 9484,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 1,
   "firman": "Tiga tahun lamanya orang tinggal aman dengan tidak ada perang antara Aram dan Israel."
 },
 {
   "id": 9485,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 2,
   "firman": "Pada tahun yang ketiga pergilah Yosafat, raja Yehuda, kepada raja Israel."
 },
 {
   "id": 9486,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 3,
   "firman": "Berkatalah raja Israel kepada pegawai-pegawainya: \"Tahukah kamu, bahwa Ramot-Gilead sebenarnya milik kita? Tetapi kita tinggal diam saja dan tidak merebutnya dari tangan raja negeri Aram.\""
 },
 {
   "id": 9487,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 4,
   "firman": "Lalu katanya kepada Yosafat: \"Maukah engkau pergi bersama-sama aku untuk memerangi Ramot-Gilead?\" Jawab Yosafat kepada raja Israel: \"Kita sama-sama, aku dan engkau, rakyatku dan rakyatmu, kudaku dan kudamu.\""
 },
 {
   "id": 9488,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 5,
   "firman": "Tetapi Yosafat berkata kepada raja Israel: \"Baiklah tanyakan dahulu firman TUHAN.\""
 },
 {
   "id": 9489,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 6,
   "firman": "Lalu raja Israel mengumpulkan para nabi, kira-kira empat ratus orang banyaknya, kemudian bertanyalah ia kepada mereka: \"Apakah aku boleh pergi berperang melawan Ramot-Gilead atau aku membatalkannya?\" Jawab mereka: \"Majulah! Tuhan akan menyerahkannya ke dalam tangan raja.\""
 },
 {
   "id": 9490,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 7,
   "firman": "Tetapi Yosafat bertanya: \"Tidak adakah lagi di sini seorang nabi TUHAN, supaya dengan perantaraannya kita dapat meminta petunjuk?\""
 },
 {
   "id": 9491,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 8,
   "firman": "Jawab raja Israel kepada Yosafat: \"Masih ada seorang lagi yang dengan perantaraannya dapat diminta petunjuk TUHAN. Tetapi aku membenci dia, sebab tidak pernah ia menubuatkan yang baik tentang aku, melainkan malapetaka. Orang itu ialah Mikha bin Yimla.\" Kata Yosafat: \"Janganlah raja berkata demikian.\""
 },
 {
   "id": 9492,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 9,
   "firman": "Kemudian raja Israel memanggil seorang pegawai istana, katanya: \"Jemputlah Mikha bin Yimla dengan segera!\""
 },
 {
   "id": 9493,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 10,
   "firman": "Sementara raja Israel dan Yosafat, raja Yehuda, duduk masing-masing di atas takhtanya dengan pakaian kebesaran, di suatu tempat pengirikan di depan pintu gerbang Samaria, sedang semua nabi itu bernubuat di depan mereka,"
 },
 {
   "id": 9494,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 11,
   "firman": "maka Zedekia bin Kenaana membuat tanduk-tanduk besi, lalu berkata: \"Beginilah firman TUHAN: Dengan ini engkau akan menanduk Aram sampai engkau menghabiskan mereka.\""
 },
 {
   "id": 9495,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 12,
   "firman": "Juga semua nabi itu bernubuat demikian, katanya: \"Majulah ke Ramot-Gilead, dan engkau akan beruntung; TUHAN akan menyerahkannya ke dalam tangan raja.\""
 },
 {
   "id": 9496,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 13,
   "firman": "Suruhan yang pergi memanggil Mikha itu, berkata kepadanya: \"Ketahuilah, nabi-nabi itu sudah sepakat meramalkan yang baik bagi raja, hendaklah engkau juga berbicara seperti salah seorang dari pada mereka dan meramalkan yang baik.\""
 },
 {
   "id": 9497,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 14,
   "firman": "Tetapi Mikha menjawab: \"Demi TUHAN yang hidup, sesungguhnya, apa yang akan difirmankan TUHAN kepadaku, itulah yang akan kukatakan.\""
 },
 {
   "id": 9498,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 15,
   "firman": "Setelah ia sampai kepada raja, bertanyalah raja kepadanya: \"Mikha, apakah kami boleh pergi berperang melawan Ramot-Gilead atau kami membatalkannya?\" Jawabnya kepadanya: \"Majulah dan engkau akan beruntung, sebab TUHAN akan menyerahkannya ke dalam tangan raja.\""
 },
 {
   "id": 9499,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 16,
   "firman": "Tetapi raja berkata kepadanya: \"Sampai berapa kali aku menyuruh engkau bersumpah, supaya engkau mengatakan kepadaku tidak lain dari kebenaran demi nama TUHAN?\""
 },
 {
   "id": 9500,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 17,
   "firman": "Lalu jawabnya: \"Telah kulihat seluruh Israel bercerai-berai di gunung-gunung seperti domba-domba yang tidak mempunyai gembala, sebab itu TUHAN berfirman: Mereka ini tidak punya tuan; baiklah masing-masing pulang ke rumahnya dengan selamat.\""
 },
 {
   "id": 9501,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 18,
   "firman": "Kemudian raja Israel berkata kepada Yosafat: \"Bukankah telah kukatakan kepadamu: Tidak pernah ia menubuatkan yang baik tentang aku, melainkan hanya malapetaka?\""
 },
 {
   "id": 9502,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 19,
   "firman": "Kata Mikha: \"Sebab itu dengarkanlah firman TUHAN. Aku telah melihat TUHAN sedang duduk di atas takhta-Nya dan segenap tentara sorga berdiri di dekat-Nya, di sebelah kanan-Nya dan di sebelah kiri-Nya."
 },
 {
   "id": 9503,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 20,
   "firman": "Dan TUHAN berfirman: Siapakah yang akan membujuk Ahab untuk maju berperang, supaya ia tewas di Ramot-Gilead? Maka yang seorang berkata begini, yang lain berkata begitu."
 },
 {
   "id": 9504,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 21,
   "firman": "Kemudian tampillah suatu roh, lalu berdiri di hadapan TUHAN. Ia berkata: Aku ini akan membujuknya. TUHAN bertanya kepadanya: Dengan apa?"
 },
 {
   "id": 9505,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 22,
   "firman": "Jawabnya: Aku akan keluar dan menjadi roh dusta dalam mulut semua nabinya. Ia berfirman: Biarlah engkau membujuknya, dan engkau akan berhasil pula. Keluarlah dan perbuatlah demikian!"
 },
 {
   "id": 9506,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 23,
   "firman": "Karena itu, sesungguhnya TUHAN telah menaruh roh dusta ke dalam mulut semua nabimu ini, sebab TUHAN telah menetapkan untuk menimpakan malapetaka kepadamu.\""
 },
 {
   "id": 9507,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 24,
   "firman": "Sesudah itu tampillah Zedekia bin Kenaana, ditamparnyalah pipi Mikha serta berkata: \"Mana boleh Roh TUHAN pindah dari padaku untuk berbicara kepadamu?\""
 },
 {
   "id": 9508,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 25,
   "firman": "Tetapi Mikha menjawab: \"Sesungguhnya engkau akan melihatnya pada hari engkau lari dari satu kamar ke kamar yang lain untuk menyembunyikan diri.\""
 },
 {
   "id": 9509,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 26,
   "firman": "Berkatalah raja Israel: \"Tangkaplah Mikha, bawa dia kembali kepada Amon, penguasa kota, dan kepada Yoas, anak raja,"
 },
 {
   "id": 9510,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 27,
   "firman": "dan katakan: Beginilah titah raja: Masukkan orang ini dalam penjara dan beri dia makan roti dan minum air serba sedikit sampai aku pulang dengan selamat.\""
 },
 {
   "id": 9511,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 28,
   "firman": "Tetapi jawab Mikha: \"Jika benar-benar engkau pulang dengan selamat, tentulah TUHAN tidak berfirman dengan perantaraanku!\" Lalu disambungnya: \"Dengarlah, hai bangsa-bangsa sekalian!\""
 },
 {
   "id": 9512,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 29,
   "firman": "Sesudah itu majulah raja Israel dengan Yosafat, raja Yehuda, ke Ramot-Gilead."
 },
 {
   "id": 9513,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 30,
   "firman": "Raja Israel berkata kepada Yosafat: \"Aku akan menyamar dan masuk pertempuran, tetapi engkau, pakailah pakaian kebesaranmu.\" Lalu menyamarlah raja Israel, kemudian masuk ke pertempuran."
 },
 {
   "id": 9514,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 31,
   "firman": "Adapun raja negeri Aram telah memberi perintah kepada para panglima pasukan keretanya, tiga puluh dua orang banyaknya, demikian: \"Janganlah kamu berperang melawan sembarang orang, melainkan melawan raja Israel saja.\""
 },
 {
   "id": 9515,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 32,
   "firman": "Segera sesudah para panglima pasukan kereta itu melihat Yosafat, mereka berkata: \"Itu pasti raja Israel!\" Lalu majulah mereka untuk menyerang dia, tetapi Yosafat berteriak."
 },
 {
   "id": 9516,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 33,
   "firman": "Segera sesudah para panglima pasukan kereta itu melihat, bahwa dia bukanlah raja Israel, maka undurlah mereka dari padanya."
 },
 {
   "id": 9517,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 34,
   "firman": "Tetapi seseorang menarik panahnya dan menembak dengan sembarangan saja dan mengenai raja Israel di antara sambungan baju zirahnya. Kemudian ia berkata kepada pengemudi keretanya: \"Putar! Bawa aku keluar dari pertempuran, sebab aku sudah luka.\""
 },
 {
   "id": 9518,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 35,
   "firman": "Tetapi pertempuran itu bertambah seru pada hari itu, dan raja tetap ditopang berdiri di dalam kereta berhadapan dengan orang Aram itu, sampai ia mati pada waktu petang. Darahnya mengalir dari lukanya ke dalam palung kereta."
 },
 {
   "id": 9519,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 36,
   "firman": "Kira-kira pada waktu matahari terbenam terdengarlah teriakan di sepanjang barisan tentara itu: \"Masing-masing ke kotanya, masing-masing ke negerinya!"
 },
 {
   "id": 9520,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 37,
   "firman": "Raja sudah mati!\" Maka pulanglah mereka ke Samaria, lalu mereka menguburkan raja di Samaria."
 },
 {
   "id": 9521,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 38,
   "firman": "Ketika kereta itu dicuci di tepi telaga Samaria, maka darah raja dijilat anjing, sedang perempuan-perempuan sundal mandi di tempat itu, sesuai dengan firman TUHAN yang telah diucapkan-Nya."
 },
 {
   "id": 9522,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 39,
   "firman": "Selebihnya dari riwayat Ahab dan segala yang dilakukannya serta istana gading dan segala kota yang didirikannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9523,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 40,
   "firman": "Demikianlah Ahab mendapat perhentian bersama-sama dengan nenek moyangnya. Maka Ahazia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9524,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 41,
   "firman": "Yosafat, anak Asa, menjadi raja atas Yehuda dalam tahun keempat zaman Ahab, raja Israel."
 },
 {
   "id": 9525,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 42,
   "firman": "Yosafat berumur tiga puluh lima tahun pada waktu ia menjadi raja dan dua puluh lima tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Azuba, anak Silhi."
 },
 {
   "id": 9526,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 43,
   "firman": "Ia hidup mengikuti jejak Asa, ayahnya; ia tidak menyimpang dari padanya dan melakukan apa yang benar di mata TUHAN. (22-44) Hanya bukit-bukit pengorbanan tidak dijauhkan. Orang masih mempersembahkan dan membakar korban di bukit-bukit itu."
 },
 {
   "id": 9527,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 44,
   "firman": "(22-45) Dan Yosafat hidup dalam damai dengan raja Israel."
 },
 {
   "id": 9528,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 45,
   "firman": "(22-46) Selebihnya dari riwayat Yosafat dan kepahlawanan yang dilakukannya dan bagaimana ia berperang, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9529,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 46,
   "firman": "(22-47) Dan sisa pelacuran bakti yang masih tinggal dalam zaman Asa, ayahnya, dihapuskannya dari negeri itu."
 },
 {
   "id": 9530,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 47,
   "firman": "(22-48) Tidak ada raja di Edom, karena itu yang menjadi raja ialah seorang kepala daerah."
 },
 {
   "id": 9531,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 48,
   "firman": "(22-49) Yosafat membuat kapal-kapal Tarsis untuk pergi ke Ofir mengambil emas, tetapi kapal-kapal itu tidak jadi pergi ke sana, sebab kapal-kapal itu pecah di Ezion-Geber."
 },
 {
   "id": 9532,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 49,
   "firman": "(22-50) Pada waktu itu Ahazia, anak Ahab, berkata kepada Yosafat: \"Baiklah anak buahku pergi bersama-sama anak buahmu dengan kapal-kapal itu.\" Tetapi Yosafat tidak mau."
 },
 {
   "id": 9533,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 50,
   "firman": "(22-51) Kemudian Yosafat mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud, bapa leluhurnya. Maka Yoram, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9534,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 51,
   "firman": "(22-52) Ahazia, anak Ahab, menjadi raja atas Israel di Samaria dalam tahun ketujuh belas zaman Yosafat, raja Yehuda, dan ia memerintah atas Israel dua tahun lamanya."
 },
 {
   "id": 9535,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 52,
   "firman": "(22-53) Ia melakukan apa yang jahat di mata TUHAN dan hidup menurut kelakuan ayahnya dan ibunya dan Yerobeam bin Nebat, yang telah mengakibatkan orang Israel berdosa."
 },
 {
   "id": 9536,
   "kitab": "1Ra",
   "pasal": 22,
   "ayat": 53,
   "firman": "(22-54) Ia beribadah kepada Baal dan sujud menyembah kepadanya dan dengan demikian ia menimbulkan sakit hati TUHAN, Allah Israel, tepat seperti yang dilakukan ayahnya."
 },
 {
   "id": 9537,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 1,
   "firman": "Sesudah Ahab mati, maka memberontaklah Moab terhadap Israel."
 },
 {
   "id": 9538,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 2,
   "firman": "Pada suatu hari jatuhlah Ahazia dari kisi-kisi kamar atasnya yang ada di Samaria, lalu menjadi sakit. Kemudian dikirimnyalah utusan-utusan dengan pesan: \"Pergilah, mintalah petunjuk kepada Baal-Zebub, allah di Ekron, apakah aku akan sembuh dari penyakit ini.\""
 },
 {
   "id": 9539,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 3,
   "firman": "Tetapi berfirmanlah Malaikat TUHAN kepada Elia, orang Tisbe itu: \"Bangunlah, berangkatlah menemui utusan-utusan raja Samaria dan katakan kepada mereka: Apakah tidak ada Allah di Israel, sehingga kamu ini pergi untuk meminta petunjuk kepada Baal-Zebub, allah di Ekron?"
 },
 {
   "id": 9540,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 4,
   "firman": "Sebab itu beginilah firman TUHAN: Engkau tidak akan bangun lagi dari tempat tidur, di mana engkau berbaring, sebab engkau pasti akan mati.\" Lalu pergilah Elia."
 },
 {
   "id": 9541,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sesudah utusan-utusan itu kembali kepada raja, berkatalah ia kepada mereka: \"Mengapa kamu kembali?\""
 },
 {
   "id": 9542,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 6,
   "firman": "Jawab mereka kepadanya: \"Ada seorang datang menemui kami dan berkata kepada kami: Pergilah, kembalilah kepada raja yang telah menyuruh kamu, dan katakanlah kepadanya: Beginilah firman TUHAN: Apakah tidak ada Allah di Israel, sehingga engkau menyuruh meminta petunjuk kepada Baal-Zebub, allah di Ekron? Sebab itu engkau tidak akan bangun lagi dari tempat tidur di mana engkau berbaring, sebab engkau pasti akan mati.\""
 },
 {
   "id": 9543,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 7,
   "firman": "Lalu bertanyalah ia kepada mereka: \"Bagaimanakah rupa orang yang telah datang menemui kamu itu dan yang mengatakan perkataan ini kepadamu?\""
 },
 {
   "id": 9544,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 8,
   "firman": "Jawab mereka kepadanya: \"Seorang yang memakai pakaian bulu, dan ikat pinggang kulit terikat pada pinggangnya.\" Maka berkatalah ia: \"Itu Elia, orang Tisbe!\""
 },
 {
   "id": 9545,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sesudah itu disuruhnyalah kepada Elia seorang perwira dengan kelima puluh anak buahnya. Orang itu naik menjumpai Elia yang sedang duduk di atas puncak bukit. Berkatalah orang itu kepadanya: \"Hai abdi Allah, raja bertitah: Turunlah!\""
 },
 {
   "id": 9546,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 10,
   "firman": "Tetapi Elia menjawab, katanya kepada perwira itu: \"Kalau benar aku abdi Allah, biarlah turun api dari langit memakan engkau habis dengan kelima puluh anak buahmu.\" Maka turunlah api dari langit memakan dia habis dengan kelima puluh anak buahnya."
 },
 {
   "id": 9547,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 11,
   "firman": "Kemudian raja menyuruh pula kepadanya seorang perwira yang lain dengan kelima puluh anak buahnya. Lalu orang itu berkata kepada Elia: \"Hai abdi Allah, beginilah titah raja: Segeralah turun!\""
 },
 {
   "id": 9548,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi Elia menjawab mereka: \"Kalau benar aku abdi Allah, biarlah turun api dari langit memakan engkau habis dengan kelima puluh anak buahmu!\" Maka turunlah api Allah dari langit memakan dia habis dengan kelima puluh anak buahnya."
 },
 {
   "id": 9549,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kemudian raja menyuruh pula seorang perwira yang ketiga dengan kelima puluh anak buahnya. Lalu naiklah perwira yang ketiga itu dan sesudah sampai, berlututlah ia di depan Elia, serta memohon belas kasihan kepadanya, katanya: \"Ya abdi Allah, biarlah kiranya nyawaku dan nyawa kelima puluh orang hamba-hambamu ini berharga di matamu."
 },
 {
   "id": 9550,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 14,
   "firman": "Bukankah api sudah turun dari langit memakan habis kedua perwira yang dahulu dengan kelima puluh anak buah mereka? Tetapi sekarang biarlah nyawaku berharga di matamu.\""
 },
 {
   "id": 9551,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 15,
   "firman": "Maka berfirmanlah Malaikat TUHAN kepada Elia: \"Turunlah bersama-sama dia, janganlah takut kepadanya!\" Lalu bangunlah Elia dan turun bersama-sama dia menghadap raja."
 },
 {
   "id": 9552,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 16,
   "firman": "Berkatalah Elia kepada raja: \"Beginilah firman TUHAN: Oleh karena engkau telah mengirim utusan-utusan untuk meminta petunjuk kepada Baal-Zebub, allah di Ekron, seolah-olah tidak ada Allah di Israel untuk ditanyakan firman-Nya, maka sebab itu engkau tidak akan bangun lagi dari tempat tidur, di mana engkau berbaring, sebab engkau pasti akan mati.\""
 },
 {
   "id": 9553,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 17,
   "firman": "Maka matilah raja sesuai dengan firman TUHAN yang dikatakan oleh Elia. Maka Yoram menjadi raja menggantikan dia dalam tahun kedua zaman Yoram bin Yosafat, raja Yehuda, sebab Ahazia tidak mempunyai anak laki-laki."
 },
 {
   "id": 9554,
   "kitab": "2Ra",
   "pasal": 1,
   "ayat": 18,
   "firman": "Selebihnya dari riwayat Ahazia, apa yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9555,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 1,
   "firman": "Menjelang saatnya TUHAN hendak menaikkan Elia ke sorga dalam angin badai, Elia dan Elisa sedang berjalan dari Gilgal."
 },
 {
   "id": 9556,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 2,
   "firman": "Berkatalah Elia kepada Elisa: \"Baiklah tinggal di sini, sebab TUHAN menyuruh aku ke Betel.\" Tetapi Elisa menjawab: \"Demi TUHAN yang hidup dan demi hidupmu sendiri, sesungguhnya aku tidak akan meninggalkan engkau.\" Lalu pergilah mereka ke Betel."
 },
 {
   "id": 9557,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 3,
   "firman": "Pada waktu itu keluarlah rombongan nabi yang ada di Betel mendapatkan Elisa, lalu berkatalah mereka kepadanya: \"Sudahkah engkau tahu, bahwa pada hari ini tuanmu akan diambil dari padamu oleh TUHAN terangkat ke sorga?\" Jawabnya: \"Aku juga tahu, diamlah!\""
 },
 {
   "id": 9558,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 4,
   "firman": "Berkatalah Elia kepadanya: \"Hai Elisa, baiklah tinggal di sini, sebab TUHAN menyuruh aku ke Yerikho.\" Tetapi jawabnya: \"Demi TUHAN yang hidup dan demi hidupmu sendiri, sesungguhnya aku tidak akan meninggalkan engkau.\" Lalu sampailah mereka di Yerikho."
 },
 {
   "id": 9559,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 5,
   "firman": "Pada waktu itu mendekatlah rombongan nabi yang ada di Yerikho kepada Elisa serta berkata kepadanya: \"Sudahkah engkau tahu, bahwa pada hari ini tuanmu akan diambil dari padamu oleh TUHAN terangkat ke sorga?\" Jawabnya: \"Aku juga tahu, diamlah!\""
 },
 {
   "id": 9560,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 6,
   "firman": "Berkatalah Elia kepadanya: \"Baiklah tinggal di sini, sebab TUHAN menyuruh aku ke sungai Yordan.\" Jawabnya: \"Demi TUHAN yang hidup dan demi hidupmu sendiri, sesungguhnya aku tidak akan meninggalkan engkau.\" Lalu berjalanlah keduanya."
 },
 {
   "id": 9561,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 7,
   "firman": "Lima puluh orang dari rombongan nabi itu ikut berjalan, tetapi mereka berdiri memandang dari jauh, ketika keduanya berdiri di tepi sungai Yordan."
 },
 {
   "id": 9562,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 8,
   "firman": "Lalu Elia mengambil jubahnya, digulungnya, dipukulkannya ke atas air itu, maka terbagilah air itu ke sebelah sini dan ke sebelah sana, sehingga menyeberanglah keduanya dengan berjalan di tanah yang kering."
 },
 {
   "id": 9563,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 9,
   "firman": "Dan sesudah mereka sampai di seberang, berkatalah Elia kepada Elisa: \"Mintalah apa yang hendak kulakukan kepadamu, sebelum aku terangkat dari padamu.\" Jawab Elisa: \"Biarlah kiranya aku mendapat dua bagian dari rohmu.\""
 },
 {
   "id": 9564,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 10,
   "firman": "Berkatalah Elia: \"Yang kauminta itu adalah sukar. Tetapi jika engkau dapat melihat aku terangkat dari padamu, akan terjadilah kepadamu seperti yang demikian, dan jika tidak, tidak akan terjadi.\""
 },
 {
   "id": 9565,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 11,
   "firman": "Sedang mereka berjalan terus sambil berkata-kata, tiba-tiba datanglah kereta berapi dengan kuda berapi memisahkan keduanya, lalu naiklah Elia ke sorga dalam angin badai."
 },
 {
   "id": 9566,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 12,
   "firman": "Ketika Elisa melihat itu, maka berteriaklah ia: \"Bapaku, bapaku! Kereta Israel dan orang-orangnya yang berkuda!\" Kemudian tidak dilihatnya lagi, lalu direnggutkannya pakaiannya dan dikoyakkannya menjadi dua koyakan."
 },
 {
   "id": 9567,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sesudah itu dipungutnya jubah Elia yang telah terjatuh, lalu ia berjalan hendak pulang dan berdiri di tepi sungai Yordan."
 },
 {
   "id": 9568,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 14,
   "firman": "Ia mengambil jubah Elia yang telah terjatuh itu, dipukulkannya ke atas air itu sambil berseru: \"Di manakah TUHAN, Allah Elia?\" Ia memukul air itu, lalu terbagi ke sebelah sini dan ke sebelah sana, maka menyeberanglah Elisa."
 },
 {
   "id": 9569,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ketika rombongan nabi yang dari Yerikho itu melihat dia dari jauh, mereka berkata: \"Roh Elia telah hinggap pada Elisa.\" Mereka datang menemui dia, lalu sujudlah mereka kepadanya sampai ke tanah."
 },
 {
   "id": 9570,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 16,
   "firman": "Mereka berkata: \"Coba lihat! Di antara hamba-hambamu ini ada lima puluh orang laki-laki, orang-orang tangkas. Biarlah mereka itu pergi mencari tuanmu, jangan-jangan ia diangkat oleh Roh TUHAN dan dilemparkan-Nya ke atas salah satu gunung atau ke dalam salah satu lembah.\" Elisa menjawab: \"Janganlah suruh pergi!\""
 },
 {
   "id": 9571,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi ketika mereka mendesak-desak dia sampai memalukan, maka berkatalah ia: \"Suruhlah pergi!\" Mereka menyuruh lima puluh orang. Orang-orang ini mencari tiga hari lamanya, tetapi tidak bertemu dengan Elia."
 },
 {
   "id": 9572,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 18,
   "firman": "Ketika mereka kembali kepada Elisa yang masih tinggal di kota Yerikho, berkatalah ia kepada mereka: \"Bukankah telah kukatakan kepadamu: Jangan pergi?\""
 },
 {
   "id": 9573,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 19,
   "firman": "Berkatalah penduduk kota itu kepada Elisa: \"Cobalah lihat! Letaknya kota ini baik, seperti tuanku lihat, tetapi airnya tidak baik dan di negeri ini sering ada keguguran bayi.\""
 },
 {
   "id": 9574,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 20,
   "firman": "Jawabnya: \"Ambillah sebuah pinggan baru bagiku dan taruhlah garam ke dalamnya.\" Maka mereka membawa pinggan itu kepadanya."
 },
 {
   "id": 9575,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 21,
   "firman": "Kemudian pergilah ia ke mata air mereka dan melemparkan garam itu ke dalamnya serta berkata: \"Beginilah firman TUHAN: Telah Kusehatkan air ini, maka tidak akan terjadi lagi olehnya kematian atau keguguran bayi.\""
 },
 {
   "id": 9576,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 22,
   "firman": "Demikianlah air itu menjadi sehat sampai hari ini sesuai dengan firman yang telah disampaikan Elisa."
 },
 {
   "id": 9577,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 23,
   "firman": "Elisa pergi dari sana ke Betel. Dan sedang ia mendaki, maka keluarlah anak-anak dari kota itu, lalu mencemoohkan dia serta berseru kepadanya: \"Naiklah botak, naiklah botak!\""
 },
 {
   "id": 9578,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 24,
   "firman": "Lalu berpalinglah ia ke belakang, dan ketika ia melihat mereka, dikutuknyalah mereka demi nama TUHAN. Maka keluarlah dua ekor beruang dari hutan, lalu mencabik-cabik dari mereka empat puluh dua orang anak."
 },
 {
   "id": 9579,
   "kitab": "2Ra",
   "pasal": 2,
   "ayat": 25,
   "firman": "Dari sana pergilah ia ke gunung Karmel dan dari sana pula kembalilah ia ke Samaria."
 },
 {
   "id": 9580,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 1,
   "firman": "Yoram, anak Ahab, menjadi raja di Samaria atas Israel dalam tahun kedelapan belas zaman Yosafat, raja Yehuda, dan ia memerintah dua belas tahun lamanya."
 },
 {
   "id": 9581,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, tetapi bukan seperti ayahnya dan seperti ibunya: ia menjauhkan tugu berhala Baal yang didirikan ayahnya."
 },
 {
   "id": 9582,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 3,
   "firman": "Namun demikian, ia masih berpaut kepada dosa Yerobeam bin Nebat yang mengakibatkan orang Israel berdosa pula; ia tidak menjauhinya."
 },
 {
   "id": 9583,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mesa, raja Moab, adalah seorang peternak domba; sebagai upeti ia membayar kepada raja Israel seratus ribu anak domba dan bulu dari seratus ribu domba jantan."
 },
 {
   "id": 9584,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 5,
   "firman": "Tetapi segera sesudah Ahab mati, memberontaklah raja Moab terhadap raja Israel."
 },
 {
   "id": 9585,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 6,
   "firman": "Keluarlah raja Yoram pada waktu itu dari Samaria, lalu ia memeriksa barisan seluruh orang Israel."
 },
 {
   "id": 9586,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 7,
   "firman": "Selanjutnya ia menyuruh orang kepada Yosafat, raja Yehuda, dengan pesan: \"Raja Moab telah memberontak terhadap aku! Maukah engkau bersama-sama aku berperang melawan Moab?\" Jawabnya: \"Aku akan maju. Kita sama-sama, aku dan engkau, rakyatku dan rakyatmu, kudaku dan kudamu.\""
 },
 {
   "id": 9587,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 8,
   "firman": "Lagi ia bertanya: \"Melalui jalan manakah kita akan maju?\" Jawabnya: \"Melalui padang gurun Edom!\""
 },
 {
   "id": 9588,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 9,
   "firman": "Maka berjalanlah raja Israel dan raja Yehuda dan raja Edom. Tetapi sesudah mereka berkeliling tujuh hari perjalanan jauhnya, maka tidak terdapat air untuk tentara dan untuk hewan yang mengikuti mereka."
 },
 {
   "id": 9589,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 10,
   "firman": "Lalu berkatalah raja Israel: \"Wahai, TUHAN telah memanggil ketiga raja ini untuk menyerahkan mereka ke dalam tangan Moab!\""
 },
 {
   "id": 9590,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 11,
   "firman": "Tetapi bertanyalah Yosafat: \"Tidak adakah di sini seorang nabi TUHAN, supaya dengan perantaraannya kita meminta petunjuk TUHAN?\" Lalu salah seorang pegawai raja Israel menjawab, katanya: \"Di sini ada Elisa bin Safat, yang dahulu melayani Elia.\""
 },
 {
   "id": 9591,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 12,
   "firman": "Berkatalah Yosafat: \"Memang padanya ada firman TUHAN.\" Sesudah itu pergilah raja Israel dan Yosafat dan raja Edom kepada Elisa."
 },
 {
   "id": 9592,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tetapi berkatalah Elisa kepada raja Israel: \"Apakah urusanku dengan engkau? Pergilah kepada para nabi ayahmu dan kepada para nabi ibumu.\" Jawab raja Israel kepadanya: \"Jangan begitu, sebab TUHAN memanggil ketiga raja ini untuk menyerahkan mereka ke dalam tangan orang Moab!\""
 },
 {
   "id": 9593,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 14,
   "firman": "Berkatalah Elisa: \"Demi TUHAN semesta alam yang hidup, yang di hadapan-Nya aku menjadi pelayan: jika tidak karena Yosafat, raja Yehuda, maka sesungguhnya aku ini tidak akan memandang dan melihat kepadamu."
 },
 {
   "id": 9594,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 15,
   "firman": "Maka sekarang, jemputlah bagiku seorang pemetik kecapi.\" Pada waktu pemetik kecapi itu bermain kecapi, maka kekuasaan TUHAN meliputi dia."
 },
 {
   "id": 9595,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 16,
   "firman": "Kemudian berkatalah ia: \"Beginilah firman TUHAN: Biarlah di lembah ini dibuat parit-parit,"
 },
 {
   "id": 9596,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 17,
   "firman": "sebab beginilah firman TUHAN: Kamu tidak akan mendapat angin dan hujan, namun lembah ini akan penuh dengan air, sehingga kamu serta ternak sembelihan dan hewan pengangkut dapat minum."
 },
 {
   "id": 9597,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan itupun adalah perkara ringan di mata TUHAN; juga orang Moab akan diserahkan-Nya ke dalam tanganmu."
 },
 {
   "id": 9598,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 19,
   "firman": "Kamu akan memusnahkan segala kota yang berkubu dan segala kota pilihan; kamu akan menumbangkan segala pohon yang baik; kamu akan menutup segala mata air dan kamu akan merusakkan segala ladang yang baik dengan batu-batu.\""
 },
 {
   "id": 9599,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 20,
   "firman": "Keesokan harinya ketika orang mempersembahkan korban, datanglah dengan tiba-tiba air dari arah Edom, lalu penuhlah negeri itu dengan air."
 },
 {
   "id": 9600,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 21,
   "firman": "Ketika didengar seluruh orang Moab, bahwa ketiga raja itu telah maju memerangi mereka, maka dikerahkanlah semua orang yang masih sanggup menyandang pedang, bahkan orang-orang yang lebih tua juga, kemudian mereka ditempatkan di tepi perbatasan."
 },
 {
   "id": 9601,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 22,
   "firman": "Keesokan harinya pagi-pagi, ketika matahari bersinar atas permukaan air itu, tampaklah kepada orang Moab itu, bahwa air di sebelah depannya merah seperti darah."
 },
 {
   "id": 9602,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 23,
   "firman": "Lalu berserulah mereka: \"Itu darah! Tentulah raja-raja itu telah berbunuh-bunuhan, yang seorang membunuh yang lain. Maka sekarang, marilah menjarah, hai orang-orang Moab!\""
 },
 {
   "id": 9603,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 24,
   "firman": "Tetapi ketika mereka sampai ke perkemahan orang Israel, maka bangkitlah orang Israel itu, lalu memukul orang-orang Moab, sehingga mereka lari dari situ. Dan makin jauhlah mereka menerobos ke dalam Moab sambil menewaskan orang-orang Moab itu."
 },
 {
   "id": 9604,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 25,
   "firman": "Mereka meruntuhkan kota-kota dan menutupi setiap ladang yang baik dengan batu, karena setiap orang melemparkan batu ke atasnya. Mereka menutup segala mata air dan menumbangkan segala pohon yang baik, sampai hanya Kir-Hareset saja yang ditinggalkan, tetapi kota ini ditembaki oleh orang-orang pengumban dari segala penjuru."
 },
 {
   "id": 9605,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 26,
   "firman": "Ketika raja Moab melihat, bahwa peperangan itu terlalu berat baginya, diambilnyalah tujuh ratus orang pemegang pedang bersama-sama dia untuk menerobos ke jurusan raja Edom, tetapi tidak berhasil."
 },
 {
   "id": 9606,
   "kitab": "2Ra",
   "pasal": 3,
   "ayat": 27,
   "firman": "Kemudian ia mengambil anaknya yang sulung yang akan menjadi raja menggantikan dia, lalu mempersembahkannya sebagai korban bakaran di atas pagar tembok. Tetapi kegusaran besar menimpa orang Israel, sehingga mereka berangkat meninggalkan dia dan pulang ke negeri mereka."
 },
 {
   "id": 9607,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 1,
   "firman": "Salah seorang dari isteri-isteri para nabi mengadukan halnya kepada Elisa, sambil berseru: \"Hambamu, suamiku, sudah mati dan engkau ini tahu, bahwa hambamu itu takut akan TUHAN. Tetapi sekarang, penagih hutang sudah datang untuk mengambil kedua orang anakku menjadi budaknya.\""
 },
 {
   "id": 9608,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 2,
   "firman": "Jawab Elisa kepadanya: \"Apakah yang dapat kuperbuat bagimu? Beritahukanlah kepadaku apa-apa yang kaupunya di rumah.\" Berkatalah perempuan itu: \"Hambamu ini tidak punya sesuatu apapun di rumah, kecuali sebuah buli-buli berisi minyak.\""
 },
 {
   "id": 9609,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu berkatalah Elisa: \"Pergilah, mintalah bejana-bejana dari luar, dari pada segala tetanggamu, bejana-bejana kosong, tetapi jangan terlalu sedikit."
 },
 {
   "id": 9610,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 4,
   "firman": "Kemudian masuklah, tutuplah pintu sesudah engkau dan anak-anakmu masuk, lalu tuanglah minyak itu ke dalam segala bejana. Mana yang penuh, angkatlah!\""
 },
 {
   "id": 9611,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 5,
   "firman": "Pergilah perempuan itu dari padanya; ditutupnyalah pintu sesudah ia dan anak-anaknya masuk; dan anak-anaknya mendekatkan bejana-bejana kepadanya, sedang ia terus menuang."
 },
 {
   "id": 9612,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 6,
   "firman": "Ketika bejana-bejana itu sudah penuh, berkatalah perempuan itu kepada anaknya: \"Dekatkanlah kepadaku sebuah bejana lagi,\" tetapi jawabnya kepada ibunya: \"Tidak ada lagi bejana.\" Lalu berhentilah minyak itu mengalir."
 },
 {
   "id": 9613,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 7,
   "firman": "Kemudian pergilah perempuan itu memberitahukannya kepada abdi Allah, dan orang ini berkata: \"Pergilah, juallah minyak itu, bayarlah hutangmu, dan hiduplah dari lebihnya, engkau serta anak-anakmu.\""
 },
 {
   "id": 9614,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 8,
   "firman": "Pada suatu hari Elisa pergi ke Sunem. Di sana tinggal seorang perempuan kaya yang mengundang dia makan. Dan seberapa kali ia dalam perjalanan, singgahlah ia ke sana untuk makan."
 },
 {
   "id": 9615,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 9,
   "firman": "Berkatalah perempuan itu kepada suaminya: \"Sesungguhnya aku sudah tahu bahwa orang yang selalu datang kepada kita itu adalah abdi Allah yang kudus."
 },
 {
   "id": 9616,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 10,
   "firman": "Baiklah kita membuat sebuah kamar atas yang kecil yang berdinding batu, dan baiklah kita menaruh di sana baginya sebuah tempat tidur, sebuah meja, sebuah kursi dan sebuah kandil, maka apabila ia datang kepada kita, ia boleh masuk ke sana.\""
 },
 {
   "id": 9617,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 11,
   "firman": "Pada suatu hari datanglah ia ke sana, lalu masuklah ia ke kamar atas itu dan tidur di situ."
 },
 {
   "id": 9618,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 12,
   "firman": "Kemudian berkatalah ia kepada Gehazi, bujangnya: \"Panggillah perempuan Sunem itu.\" Lalu dipanggilnyalah perempuan itu dan dia berdiri di depan Gehazi."
 },
 {
   "id": 9619,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 13,
   "firman": "Elisa telah berkata kepada Gehazi: \"Cobalah katakan kepadanya: Sesungguhnya engkau telah sangat bersusah-susah seperti ini untuk kami. Apakah yang dapat kuperbuat bagimu? Adakah yang dapat kubicarakan tentang engkau kepada raja atau kepala tentara?\" Jawab perempuan itu: \"Aku ini tinggal di tengah-tengah kaumku!\""
 },
 {
   "id": 9620,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 14,
   "firman": "Kemudian berkatalah Elisa: \"Apakah yang dapat kuperbuat baginya?\" Jawab Gehazi: \"Ah, ia tidak mempunyai anak, dan suaminya sudah tua.\""
 },
 {
   "id": 9621,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 15,
   "firman": "Lalu berkatalah Elisa: \"Panggillah dia!\" Dan sesudah dipanggilnya, berdirilah perempuan itu di pintu."
 },
 {
   "id": 9622,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 16,
   "firman": "Berkatalah Elisa: \"Pada waktu seperti ini juga, tahun depan, engkau ini akan menggendong seorang anak laki-laki.\" Tetapi jawab perempuan itu: \"Janganlah tuanku, ya abdi Allah, janganlah berdusta kepada hambamu ini!\""
 },
 {
   "id": 9623,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 17,
   "firman": "Mengandunglah perempuan itu, lalu melahirkan seorang anak laki-laki pada waktu seperti itu juga, pada tahun berikutnya, seperti yang dikatakan Elisa kepadanya."
 },
 {
   "id": 9624,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 18,
   "firman": "Setelah anak itu menjadi besar, pada suatu hari keluarlah ia mendapatkan ayahnya, di antara penyabit-penyabit gandum."
 },
 {
   "id": 9625,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 19,
   "firman": "Tiba-tiba menjeritlah ia kepada ayahnya: \"Aduh kepalaku, kepalaku!\" Lalu kata ayahnya kepada seorang bujang: \"Angkatlah dia dan bawa kepada ibunya!\""
 },
 {
   "id": 9626,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 20,
   "firman": "Diangkatnyalah dia, dibawanya pulang kepada ibunya. Duduklah dia di pangkuan ibunya sampai tengah hari, tetapi sesudah itu matilah dia."
 },
 {
   "id": 9627,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 21,
   "firman": "Lalu naiklah perempuan itu, dibaringkannyalah dia di atas tempat tidur abdi Allah itu, ditutupnyalah pintu dan pergi, sehingga anak itu saja di dalam kamar."
 },
 {
   "id": 9628,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 22,
   "firman": "Sesudah itu ia memanggil suaminya serta berkata: \"Suruh kepadaku salah seorang bujang dengan membawa seekor keledai betina; aku mau pergi dengan segera kepada abdi Allah itu, dan akan terus pulang.\""
 },
 {
   "id": 9629,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 23,
   "firman": "Berkatalah suaminya: \"Mengapakah pada hari ini engkau hendak pergi kepadanya? Padahal sekarang bukan bulan baru dan bukan hari Sabat.\" Jawab perempuan itu: \"Jangan kuatir.\""
 },
 {
   "id": 9630,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 24,
   "firman": "Dipelanainyalah keledai itu dan berkatalah ia kepada bujangnya: \"Tuntunlah dan majulah, jangan tahan-tahan aku dalam perjalananku, kecuali apabila kukatakan kepadamu.\""
 },
 {
   "id": 9631,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 25,
   "firman": "Demikianlah perempuan itu berangkat dan pergi kepada abdi Allah di gunung Karmel. Segera sesudah abdi Allah melihat dia dari jauh, berkatalah ia kepada Gehazi, bujangnya: \"Lihat, perempuan Sunem itu datang!"
 },
 {
   "id": 9632,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 26,
   "firman": "Larilah menyongsongnya dan katakanlah kepadanya: Selamatkah engkau, selamatkah suamimu, selamatkah anak itu?\" Jawab perempuan itu: \"Selamat!\""
 },
 {
   "id": 9633,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 27,
   "firman": "Dan sesudah ia sampai ke gunung itu, dipegangnyalah kaki abdi Allah itu, tetapi Gehazi mendekat hendak mengusir dia. Lalu berkatalah abdi Allah: \"Biarkanlah dia, hatinya pedih! TUHAN menyembunyikan hal ini dari padaku, tidak memberitahukannya kepadaku.\""
 },
 {
   "id": 9634,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 28,
   "firman": "Lalu berkatalah perempuan itu: \"Adakah kuminta seorang anak laki-laki dari pada tuanku? Bukankah telah kukatakan: Jangan aku diberi harapan kosong?\""
 },
 {
   "id": 9635,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 29,
   "firman": "Maka berkatalah Elisa kepada Gehazi: \"Ikatlah pinggangmu, bawalah tongkatku di tanganmu dan pergilah. Apabila engkau bertemu dengan seseorang, janganlah beri salam kepadanya dan apabila seseorang memberi salam kepadamu, janganlah balas dia, kemudian taruhlah tongkatku ini di atas anak itu.\""
 },
 {
   "id": 9636,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 30,
   "firman": "Tetapi berkatalah ibu anak itu: \"Demi TUHAN yang hidup dan demi hidupmu sendiri, sesungguhnya aku tidak akan meninggalkan engkau.\" Lalu bangunlah Elisa dan berjalan mengikuti perempuan itu."
 },
 {
   "id": 9637,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 31,
   "firman": "Adapun Gehazi telah berjalan mendahului mereka dan telah menaruh tongkat di atas anak itu, tetapi tidak ada suara, dan tidak ada tanda hidup. Lalu kembalilah ia menemui Elisa serta memberitahukan kepadanya, katanya: \"Anak itu tidak bangun!\""
 },
 {
   "id": 9638,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 32,
   "firman": "Dan ketika Elisa masuk ke rumah, ternyata anak itu sudah mati dan terbaring di atas tempat tidurnya."
 },
 {
   "id": 9639,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 33,
   "firman": "Sesudah ia masuk, ditutupnyalah pintu, sehingga ia sendiri dengan anak itu di dalam kamar, kemudian berdoalah ia kepada TUHAN."
 },
 {
   "id": 9640,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 34,
   "firman": "Lalu ia membaringkan dirinya di atas anak itu dengan mulutnya di atas mulut anak itu, dan matanya di atas mata anak itu, serta telapak tangannya di atas telapak tangan anak itu; dan karena ia meniarap di atas anak itu, maka menjadi panaslah badan anak itu."
 },
 {
   "id": 9641,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 35,
   "firman": "Sesudah itu ia berdiri kembali dan berjalan dalam rumah itu sekali ke sana dan sekali ke sini, kemudian meniarap pulalah ia di atas anak itu. Maka bersinlah anak itu sampai tujuh kali, lalu membuka matanya."
 },
 {
   "id": 9642,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 36,
   "firman": "Kemudian Elisa memanggil Gehazi dan berkata: \"Panggillah perempuan Sunem itu!\" Dipanggilnyalah dia, lalu datanglah ia kepadanya, maka berkatalah Elisa: \"Angkatlah anakmu ini!\""
 },
 {
   "id": 9643,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 37,
   "firman": "Masuklah perempuan itu, lalu tersungkur di depan kaki Elisa dan sujud menyembah dengan mukanya sampai ke tanah. Kemudian diangkatnyalah anaknya, lalu keluar."
 },
 {
   "id": 9644,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 38,
   "firman": "Elisa kembali ke Gilgal pada waktu ada kelaparan di negeri itu. Dan ketika pada suatu kali rombongan nabi duduk di depannya, berkatalah ia kepada bujangnya: \"Taruhlah kuali yang paling besar di atas api dan masaklah sesuatu makanan bagi rombongan nabi itu.\""
 },
 {
   "id": 9645,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 39,
   "firman": "Lalu keluarlah seorang dari mereka ke ladang untuk mengumpulkan sayur-sayuran; ia menemui pohon sulur-suluran liar dan memetik dari padanya labu liar, serangkul penuh dalam jubahnya. Sesudah ia pulang, teruslah ia mengiris-irisnya ke dalam kuali masakan tadi, sebab mereka tidak mengenalnya."
 },
 {
   "id": 9646,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 40,
   "firman": "Kemudian dicedoklah dari masakan tadi bagi orang-orang itu untuk dimakan dan segera sesudah mereka memakannya, berteriaklah mereka serta berkata: \"Maut ada dalam kuali itu, hai abdi Allah!\" Dan tidak tahan mereka memakannya."
 },
 {
   "id": 9647,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 41,
   "firman": "Tetapi berkatalah Elisa: \"Ambillah tepung!\" Dilemparkannyalah itu ke dalam kuali serta berkata: \"Cedoklah sekarang bagi orang-orang ini, supaya mereka makan!\" Maka tidak ada lagi sesuatu bahaya dalam kuali itu."
 },
 {
   "id": 9648,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 42,
   "firman": "Datanglah seseorang dari Baal-Salisa dengan membawa bagi abdi Allah roti hulu hasil, yaitu dua puluh roti jelai serta gandum baru dalam sebuah kantong. Lalu berkatalah Elisa: \"Berilah itu kepada orang-orang ini, supaya mereka makan.\""
 },
 {
   "id": 9649,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 43,
   "firman": "Tetapi pelayannya itu berkata: \"Bagaimanakah aku dapat menghidangkan ini di depan seratus orang?\" Jawabnya: \"Berikanlah kepada orang-orang itu, supaya mereka makan, sebab beginilah firman TUHAN: Orang akan makan, bahkan akan ada sisanya.\""
 },
 {
   "id": 9650,
   "kitab": "2Ra",
   "pasal": 4,
   "ayat": 44,
   "firman": "Lalu dihidangkannyalah di depan mereka, maka makanlah mereka dan ada sisanya, sesuai dengan firman TUHAN."
 },
 {
   "id": 9651,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 1,
   "firman": "Naaman, panglima raja Aram, adalah seorang terpandang di hadapan tuannya dan sangat disayangi, sebab oleh dia TUHAN telah memberikan kemenangan kepada orang Aram. Tetapi orang itu, seorang pahlawan tentara, sakit kusta."
 },
 {
   "id": 9652,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 2,
   "firman": "Orang Aram pernah keluar bergerombolan dan membawa tertawan seorang anak perempuan dari negeri Israel. Ia menjadi pelayan pada isteri Naaman."
 },
 {
   "id": 9653,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 3,
   "firman": "Berkatalah gadis itu kepada nyonyanya: \"Sekiranya tuanku menghadap nabi yang di Samaria itu, maka tentulah nabi itu akan menyembuhkan dia dari penyakitnya.\""
 },
 {
   "id": 9654,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 4,
   "firman": "Lalu pergilah Naaman memberitahukan kepada tuannya, katanya: \"Begini-beginilah dikatakan oleh gadis yang dari negeri Israel itu.\""
 },
 {
   "id": 9655,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 5,
   "firman": "Maka jawab raja Aram: \"Baik, pergilah dan aku akan mengirim surat kepada raja Israel.\" Lalu pergilah Naaman dan membawa sebagai persembahan sepuluh talenta perak dan enam ribu syikal emas dan sepuluh potong pakaian."
 },
 {
   "id": 9656,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 6,
   "firman": "Ia menyampaikan surat itu kepada raja Israel, yang berbunyi: \"Sesampainya surat ini kepadamu, maklumlah kiranya, bahwa aku menyuruh kepadamu Naaman, pegawaiku, supaya engkau menyembuhkan dia dari penyakit kustanya.\""
 },
 {
   "id": 9657,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 7,
   "firman": "Segera sesudah raja Israel membaca surat itu, dikoyakkannyalah pakaiannya serta berkata: \"Allahkah aku ini yang dapat mematikan dan menghidupkan, sehingga orang ini mengirim pesan kepadaku, supaya kusembuhkan seorang dari penyakit kustanya? Tetapi sesungguhnya, perhatikanlah dan lihatlah, ia mencari gara-gara terhadap aku.\""
 },
 {
   "id": 9658,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 8,
   "firman": "Segera sesudah didengar Elisa, abdi Allah itu, bahwa raja Israel mengoyakkan pakaiannya, dikirimnyalah pesan kepada raja, bunyinya: \"Mengapa engkau mengoyakkan pakaianmu? Biarlah ia datang kepadaku, supaya ia tahu bahwa ada seorang nabi di Israel.\""
 },
 {
   "id": 9659,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kemudian datanglah Naaman dengan kudanya dan keretanya, lalu berhenti di depan pintu rumah Elisa."
 },
 {
   "id": 9660,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 10,
   "firman": "Elisa menyuruh seorang suruhan kepadanya mengatakan: \"Pergilah mandi tujuh kali dalam sungai Yordan, maka tubuhmu akan pulih kembali, sehingga engkau menjadi tahir.\""
 },
 {
   "id": 9661,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 11,
   "firman": "Tetapi pergilah Naaman dengan gusar sambil berkata: \"Aku sangka bahwa setidak-tidaknya ia datang ke luar dan berdiri memanggil nama TUHAN, Allahnya, lalu menggerak-gerakkan tangannya di atas tempat penyakit itu dan dengan demikian menyembuhkan penyakit kustaku!"
 },
 {
   "id": 9662,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 12,
   "firman": "Bukankah Abana dan Parpar, sungai-sungai Damsyik, lebih baik dari segala sungai di Israel? Bukankah aku dapat mandi di sana dan menjadi tahir?\" Kemudian berpalinglah ia dan pergi dengan panas hati."
 },
 {
   "id": 9663,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 13,
   "firman": "Tetapi pegawai-pegawainya datang mendekat serta berkata kepadanya: \"Bapak, seandainya nabi itu menyuruh perkara yang sukar kepadamu, bukankah bapak akan melakukannya? Apalagi sekarang, ia hanya berkata kepadamu: Mandilah dan engkau akan menjadi tahir.\""
 },
 {
   "id": 9664,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 14,
   "firman": "Maka turunlah ia membenamkan dirinya tujuh kali dalam sungai Yordan, sesuai dengan perkataan abdi Allah itu. Lalu pulihlah tubuhnya kembali seperti tubuh seorang anak dan ia menjadi tahir."
 },
 {
   "id": 9665,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 15,
   "firman": "Kemudian kembalilah ia dengan seluruh pasukannya kepada abdi Allah itu. Setelah sampai, tampillah ia ke depan Elisa dan berkata: \"Sekarang aku tahu, bahwa di seluruh bumi tidak ada Allah kecuali di Israel. Karena itu terimalah kiranya suatu pemberian dari hambamu ini!\""
 },
 {
   "id": 9666,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 16,
   "firman": "Tetapi Elisa menjawab: \"Demi TUHAN yang hidup, yang di hadapan-Nya aku menjadi pelayan, sesungguhnya aku tidak akan menerima apa-apa.\" Dan walaupun Naaman mendesaknya supaya menerima sesuatu, ia tetap menolak."
 },
 {
   "id": 9667,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 17,
   "firman": "Akhirnya berkatalah Naaman: \"Jikalau demikian, biarlah diberikan kepada hambamu ini tanah sebanyak muatan sepasang bagal, sebab hambamu ini tidak lagi akan mempersembahkan korban bakaran atau korban sembelihan kepada allah lain kecuali kepada TUHAN."
 },
 {
   "id": 9668,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 18,
   "firman": "Dan kiranya TUHAN mengampuni hambamu ini dalam perkara yang berikut: Apabila tuanku masuk ke kuil Rimon untuk sujud menyembah di sana, dan aku menjadi pengapitnya, sehingga aku harus ikut sujud menyembah dalam kuil Rimon itu, kiranya TUHAN mengampuni hambamu ini dalam hal itu.\""
 },
 {
   "id": 9669,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 19,
   "firman": "Maka berkatalah Elisa kepadanya: \"Pergilah dengan selamat!\" Setelah Naaman berjalan tidak berapa jauh dari padanya,"
 },
 {
   "id": 9670,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 20,
   "firman": "berpikirlah Gehazi, bujang Elisa, abdi Allah: \"Sesungguhnya tuanku terlalu menyegani Naaman, orang Aram ini, dengan tidak menerima persembahan yang dibawanya. Demi TUHAN yang hidup, sesungguhnya aku akan berlari mengejar dia dan akan menerima sesuatu dari padanya.\""
 },
 {
   "id": 9671,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 21,
   "firman": "Lalu Gehazi mengejar Naaman dari belakang. Ketika Naaman melihat ada orang berlari-lari mengejarnya, turunlah ia dengan segera dari atas kereta untuk mendapatkan dia dan berkata: \"Selamat!\""
 },
 {
   "id": 9672,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 22,
   "firman": "Jawabnya: \"Selamat! Tuanku Elisa menyuruh aku mengatakan: Baru saja datang kepadaku dua orang muda dari pegunungan Efraim dari antara rombongan nabi. Baiklah berikan kepada mereka setalenta perak dan dua potong pakaian.\""
 },
 {
   "id": 9673,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 23,
   "firman": "Naaman berkata: \"Silakan, ambillah dua talenta.\" Naaman mendesak dia, dan membungkus dua talenta perak dalam dua pundi-pundi dan dua potong pakaian, lalu memberikannya kepada dua bujangnya; mereka ini mengangkut semuanya di depan Gehazi."
 },
 {
   "id": 9674,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 24,
   "firman": "Setelah mereka sampai ke bukit, disambutnyalah dari tangan mereka, disimpannya di rumah, dan disuruhnya kedua orang itu pergi, maka pergilah mereka."
 },
 {
   "id": 9675,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 25,
   "firman": "Baru saja Gehazi masuk dan tampil ke depan tuannya, berkatalah Elisa kepadanya: \"Dari mana, Gehazi?\" Jawabnya: \"Hambamu ini tidak pergi ke mana-mana!\""
 },
 {
   "id": 9676,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 26,
   "firman": "Tetapi kata Elisa kepadanya: \"Bukankah hatiku ikut pergi, ketika orang itu turun dari atas keretanya mendapatkan engkau? Maka sekarang, engkau telah menerima perak dan dengan itu dapat memperoleh kebun-kebun, kebun zaitun, kebun anggur, kambing domba, lembu sapi, budak laki-laki dan budak perempuan,"
 },
 {
   "id": 9677,
   "kitab": "2Ra",
   "pasal": 5,
   "ayat": 27,
   "firman": "tetapi penyakit kusta Naaman akan melekat kepadamu dan kepada anak cucumu untuk selama-lamanya.\" Maka keluarlah Gehazi dari depannya dengan kena kusta, putih seperti salju."
 },
 {
   "id": 9678,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 1,
   "firman": "Pada suatu hari berkatalah rombongan nabi kepada Elisa: \"Cobalah lihat, tempat tinggal kami di dekatmu ini adalah terlalu sesak bagi kami."
 },
 {
   "id": 9679,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 2,
   "firman": "Baiklah kami pergi ke sungai Yordan dan masing-masing mengambil satu balok dari sana, supaya kami membuat tempat tinggal untuk kami.\" Jawab Elisa: \"Pergilah!\""
 },
 {
   "id": 9680,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 3,
   "firman": "Lalu berkatalah seorang: \"Silakan, ikutlah dengan hamba-hambamu ini.\" Jawabnya: \"Baik aku akan ikut.\""
 },
 {
   "id": 9681,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 4,
   "firman": "Maka ikutlah ia dengan mereka. Setelah mereka sampai di sungai Yordan, merekapun menebang pohon-pohon."
 },
 {
   "id": 9682,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 5,
   "firman": "Dan terjadilah, ketika seorang sedang menumbangkan sebatang pohon, jatuhlah mata kapaknya ke dalam air. Lalu berteriak-teriaklah ia: \"Wahai tuanku! Itu barang pinjaman!\""
 },
 {
   "id": 9683,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 6,
   "firman": "Tetapi berkatalah abdi Allah: \"Ke mana jatuhnya?\" Lalu orang itu menunjukkan tempat itu kepadanya. Kemudian Elisa memotong sepotong kayu, lalu dilemparkannya ke sana, maka timbullah mata kapak itu dibuatnya."
 },
 {
   "id": 9684,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 7,
   "firman": "Lalu katanya: \"Ambillah.\" Orang itu mengulurkan tangannya dan mengambilnya."
 },
 {
   "id": 9685,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 8,
   "firman": "Raja negeri Aram sedang berperang melawan Israel. Ia berunding dengan pegawai-pegawainya, lalu katanya: \"Ke tempat ini dan itu haruslah kamu turun menghadang.\""
 },
 {
   "id": 9686,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi abdi Allah menyuruh orang kepada raja Israel mengatakan: \"Awas, jangan lewat dari tempat itu, sebab orang Aram sudah turun menghadang ke sana.\""
 },
 {
   "id": 9687,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 10,
   "firman": "Sebab itu raja Israel menyuruh orang-orang ke tempat yang disebutkan abdi Allah kepadanya. Demikianlah Elisa memperingatkan kepadanya, supaya berawas-awas di sana, bukan sekali dua kali saja."
 },
 {
   "id": 9688,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 11,
   "firman": "Lalu mengamuklah hati raja Aram tentang hal itu, maka dipanggilnyalah pegawai-pegawainya, katanya kepada mereka: \"Tidakkah dapat kamu memberitahukan kepadaku siapa dari kita memihak kepada raja Israel?\""
 },
 {
   "id": 9689,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 12,
   "firman": "Tetapi berkatalah salah seorang pegawainya: \"Tidak tuanku raja, melainkan Elisa, nabi yang di Israel, dialah yang memberitahukan kepada raja Israel tentang perkataan yang diucapkan oleh tuanku di kamar tidurmu.\""
 },
 {
   "id": 9690,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 13,
   "firman": "Berkatalah raja: \"Pergilah melihat, di mana dia, supaya aku menyuruh orang menangkap dia.\" Lalu diberitahukanlah kepadanya: \"Dia ada di Dotan.\""
 },
 {
   "id": 9691,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 14,
   "firman": "Maka dikirimnyalah ke sana kuda serta kereta dan tentara yang besar. Sampailah mereka pada waktu malam, lalu mengepung kota itu."
 },
 {
   "id": 9692,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 15,
   "firman": "Ketika pelayan abdi Allah bangun pagi-pagi dan pergi ke luar, maka tampaklah suatu tentara dengan kuda dan kereta ada di sekeliling kota itu. Lalu berkatalah bujangnya itu kepadanya: \"Celaka tuanku! Apakah yang akan kita perbuat?\""
 },
 {
   "id": 9693,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 16,
   "firman": "Jawabnya: \"Jangan takut, sebab lebih banyak yang menyertai kita dari pada yang menyertai mereka.\""
 },
 {
   "id": 9694,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 17,
   "firman": "Lalu berdoalah Elisa: \"Ya TUHAN: Bukalah kiranya matanya, supaya ia melihat.\" Maka TUHAN membuka mata bujang itu, sehingga ia melihat. Tampaklah gunung itu penuh dengan kuda dan kereta berapi sekeliling Elisa."
 },
 {
   "id": 9695,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 18,
   "firman": "Ketika orang-orang Aram itu turun mendatangi dia, berdoalah Elisa kepada TUHAN: \"Butakanlah kiranya mata orang-orang ini.\" Maka dibutakan-Nyalah mata mereka, sesuai dengan doa Elisa."
 },
 {
   "id": 9696,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 19,
   "firman": "Kemudian berkatalah Elisa kepada mereka: \"Bukan ini jalannya dan bukan ini kotanya. Ikutlah aku, maka aku akan mengantarkan kamu kepada orang yang kamu cari.\" Lalu diantarkannya mereka ke Samaria."
 },
 {
   "id": 9697,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 20,
   "firman": "Segera sesudah mereka sampai ke Samaria berkatalah Elisa: \"Ya TUHAN, bukalah mata orang-orang ini, supaya mereka melihat.\" Lalu TUHAN membuka mata mereka, sehingga mereka melihat, dan heran, mereka ada di tengah-tengah Samaria."
 },
 {
   "id": 9698,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 21,
   "firman": "Lalu bertanyalah raja Israel kepada Elisa, tatkala melihat mereka: \"Kubunuhkah mereka, bapak?\""
 },
 {
   "id": 9699,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 22,
   "firman": "Tetapi jawabnya: \"Jangan! Biasakah kaubunuh yang kautawan dengan pedangmu dan dengan panahmu? Tetapi hidangkanlah makanan dan minuman di depan mereka, supaya mereka makan dan minum, lalu pulang kepada tuan mereka.\""
 },
 {
   "id": 9700,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 23,
   "firman": "Disediakannyalah bagi mereka jamuan yang besar, maka makan dan minumlah mereka. Sesudah itu dibiarkannyalah mereka pulang kepada tuan mereka. Sejak itu tidak ada lagi gerombolan-gerombolan Aram memasuki negeri Israel."
 },
 {
   "id": 9701,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 24,
   "firman": "Sesudah itu Benhadad, raja Aram, menghimpunkan seluruh tentaranya, lalu maju mengepung Samaria."
 },
 {
   "id": 9702,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 25,
   "firman": "Maka terjadilah kelaparan hebat di Samaria selama mereka mengepungnya, sehingga sebuah kepala keledai berharga delapan puluh syikal perak dan seperempat kab tahi merpati berharga lima syikal perak."
 },
 {
   "id": 9703,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 26,
   "firman": "Suatu kali ketika raja Israel berjalan di atas tembok, datanglah seorang perempuan mengadukan halnya kepada raja, sambil berseru: \"Tolonglah, ya tuanku raja!\""
 },
 {
   "id": 9704,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 27,
   "firman": "Jawabnya: \"Jika TUHAN tidak menolong engkau, dengan apakah aku dapat menolong engkau? Dengan hasil pengirikankah atau hasil pemerasan anggur?\""
 },
 {
   "id": 9705,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 28,
   "firman": "Kemudian bertanyalah raja kepadanya: \"Ada apa?\" Jawab perempuan itu: \"Perempuan ini berkata kepadaku: Berilah anakmu laki-laki, supaya kita makan dia pada hari ini, dan besok akan kita makan anakku laki-laki."
 },
 {
   "id": 9706,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 29,
   "firman": "Jadi kami memasak anakku dan memakan dia. Tetapi ketika aku berkata kepadanya pada hari berikutnya: Berilah anakmu, supaya kita makan dia, maka perempuan ini menyembunyikan anaknya.\""
 },
 {
   "id": 9707,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 30,
   "firman": "Tatkala raja mendengar perkataan perempuan itu, dikoyakkannyalah pakaiannya; dan sedang ia berjalan di atas tembok, kelihatanlah kepada orang banyak, bahwa ia memakai kain kabung pada kulit tubuhnya."
 },
 {
   "id": 9708,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 31,
   "firman": "Lalu berkatalah raja: \"Beginilah kiranya Allah menghukum aku, bahkan lebih dari pada itu, jika masih tinggal kepala Elisa bin Safat di atas tubuhnya pada hari ini.\""
 },
 {
   "id": 9709,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 32,
   "firman": "Adapun Elisa, duduk-duduk di rumahnya, dan para tua-tua duduk bersama-sama dia. Raja menyuruh seorang berjalan mendahuluinya, tetapi sebelum suruhan itu sampai kepada Elisa, Elisa sudah berkata kepada para tua-tua itu: \"Tahukah kamu, bahwa si pembunuh itu menyuruh orang untuk memenggal kepalaku? Awas-awaslah, apabila suruhan itu datang, segeralah tutup pintu dan tahanlah dia supaya orang itu jangan masuk. Bukankah sudah kedengaran bunyi langkah tuannya di belakangnya?\""
 },
 {
   "id": 9710,
   "kitab": "2Ra",
   "pasal": 6,
   "ayat": 33,
   "firman": "Selagi ia berbicara dengan mereka, datanglah raja mendapatkan dia. Berkatalah raja kepadanya: \"Sesungguhnya, malapetaka ini adalah dari pada TUHAN. Mengapakah aku berharap kepada TUHAN lagi?\""
 },
 {
   "id": 9711,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 1,
   "firman": "Lalu berkatalah Elisa: \"Dengarlah firman TUHAN. Beginilah firman TUHAN: Besok kira-kira waktu ini sesukat tepung yang terbaik akan berharga sesyikal dan dua sukat jelai akan berharga sesyikal di pintu gerbang Samaria.\""
 },
 {
   "id": 9712,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 2,
   "firman": "Tetapi perwira, yang menjadi ajudan raja, menjawab abdi Allah, katanya: \"Sekalipun TUHAN membuat tingkap-tingkap di langit, masakan hal itu mungkin terjadi?\" Jawab abdi Allah: \"Sesungguhnya, engkau akan melihatnya dengan matamu sendiri, tetapi tidak akan makan apa-apa dari padanya.\""
 },
 {
   "id": 9713,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 3,
   "firman": "Empat orang yang sakit kusta ada di depan pintu gerbang. Berkatalah yang seorang kepada yang lain: \"Mengapakah kita duduk-duduk di sini sampai mati?"
 },
 {
   "id": 9714,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 4,
   "firman": "Jika kita berkata: Baiklah kita masuk ke kota, padahal dalam kota ada kelaparan, kita akan mati di sana. Dan jika kita tinggal di sini, kita akan mati juga. Jadi sekarang, marilah kita menyeberang ke perkemahan tentara Aram. Jika mereka membiarkan kita hidup, kita akan hidup, dan jika mereka mematikan kita, kita akan mati.\""
 },
 {
   "id": 9715,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 5,
   "firman": "Lalu pada waktu senja bangkitlah mereka masuk ke tempat perkemahan orang Aram. Tetapi ketika mereka sampai ke pinggir tempat perkemahan orang Aram itu, tampaklah tidak ada orang di sana."
 },
 {
   "id": 9716,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 6,
   "firman": "Sebab TUHAN telah membuat tentara Aram itu mendengar bunyi kereta, bunyi kuda, bunyi tentara yang besar, sehingga berkatalah yang seorang kepada yang lain: \"Sesungguhnya raja Israel telah mengupah raja-raja orang Het dan raja-raja orang Misraim melawan kita, supaya mereka menyerang kita.\""
 },
 {
   "id": 9717,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 7,
   "firman": "Karena itu bangkitlah mereka melarikan diri pada waktu senja dengan meninggalkan kemah dan kuda dan keledai mereka serta tempat perkemahan itu dengan begitu saja; mereka melarikan diri menyelamatkan nyawanya."
 },
 {
   "id": 9718,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 8,
   "firman": "Ketika orang-orang yang sakit kusta itu sampai ke pinggir tempat perkemahan, masuklah mereka ke dalam sebuah kemah, lalu makan dan minum. Sesudah itu mereka mengangkut dari sana emas dan perak dan pakaian, kemudian pergilah mereka menyembunyikannya. Lalu datanglah mereka kembali, masuk ke dalam kemah yang lain dan mengangkut juga barang-barang dari sana, kemudian pergilah mereka menyembunyikannya."
 },
 {
   "id": 9719,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 9,
   "firman": "Lalu berkatalah yang seorang kepada yang lain: \"Tidak patut yang kita lakukan ini. Hari ini ialah hari kabar baik, tetapi kita ini tinggal diam saja. Apabila kita menanti sampai terang pagi, maka hukuman akan menimpa kita. Jadi sekarang, marilah kita pergi menghadap untuk memberitahukan hal itu ke istana raja.\""
 },
 {
   "id": 9720,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 10,
   "firman": "Mereka pergi, lalu berseru kepada penunggu pintu gerbang kota dan menceritakan kepada orang-orang itu, katanya: \"Kami sudah masuk ke tempat perkemahan orang Aram, dan ternyata tidak ada orang di sana, dan tidak ada suara manusia kedengaran, hanya ada kuda dan keledai tertambat dan kemah-kemah ditinggalkan dengan begitu saja.\""
 },
 {
   "id": 9721,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 11,
   "firman": "Para penunggu pintu gerbang menyerukan dan memberitahukan hal itu ke istana raja."
 },
 {
   "id": 9722,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 12,
   "firman": "Sekalipun masih malam, raja bangun juga, lalu berkata kepada para pegawainya: \"Baiklah kuterangkan kepadamu apa maksud orang Aram itu terhadap kita. Mereka tahu bahwa kita ini menderita kelaparan, sebab itu mereka keluar dari tempat perkemahan untuk menyembunyikan diri di padang, sambil berpikir: Apabila orang Israel keluar dari dalam kota, kita akan menangkap mereka hidup-hidup, kemudian kita masuk ke dalam kota.\""
 },
 {
   "id": 9723,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 13,
   "firman": "Lalu salah seorang pegawainya menjawab: \"Baiklah kita ambil lima ekor dari kuda yang masih tinggal di dalam kota ini; tentulah keadaannya seperti seluruh khalayak ramai Israel yang sudah habis mati itu! Biarlah kita suruh saja orang pergi, supaya kita lihat.\""
 },
 {
   "id": 9724,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 14,
   "firman": "Sesudah itu mereka mengambil dua kereta kuda, kemudian raja menyuruh mereka menyusul tentara Aram sambil berkata: \"Pergilah melihatnya!\""
 },
 {
   "id": 9725,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 15,
   "firman": "Lalu pergilah mereka menyusul orang-orang itu sampai ke sungai Yordan, dan tampaklah seluruh jalan itu penuh dengan pakaian dan perkakas yang dilemparkan oleh orang Aram pada waktu mereka lari terburu-buru. Kemudian pulanglah suruhan-suruhan itu dan menceritakan hal itu kepada raja."
 },
 {
   "id": 9726,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 16,
   "firman": "Maka keluarlah penduduk kota itu menjarah tempat perkemahan orang Aram. Karena itu sesukat tepung yang terbaik berharga sesyikal dan dua sukat jelai berharga sesyikal, sesuai dengan firman TUHAN."
 },
 {
   "id": 9727,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 17,
   "firman": "Adapun raja telah menempatkan perwira yang menjadi ajudannya itu mengawasi pintu gerbang, tetapi rakyat menginjak-injak dia di pintu gerbang, lalu ia mati sesuai dengan perkataan abdi Allah yang mengatakannya pada waktu raja datang mendapatkan dia."
 },
 {
   "id": 9728,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 18,
   "firman": "Dan terjadi juga seperti yang dikatakan abdi Allah itu kepada raja: \"Dua sukat jelai akan berharga sesyikal dan sesukat tepung yang terbaik akan berharga sesyikal, besok kira-kira waktu ini di pintu gerbang Samaria.\""
 },
 {
   "id": 9729,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 19,
   "firman": "Pada waktu itu si perwira menjawab abdi Allah itu: \"Sekalipun TUHAN membuat tingkap-tingkap di langit, masakan hal itu mungkin terjadi?\", tetapi Elisa berkata: \"Sesungguhnya engkau akan melihatnya dengan matamu sendiri, tetapi tidak akan makan apa-apa dari padanya.\""
 },
 {
   "id": 9730,
   "kitab": "2Ra",
   "pasal": 7,
   "ayat": 20,
   "firman": "Demikianlah terjadi kepada orang itu: Rakyat menginjak-injak dia di pintu gerbang, lalu matilah ia."
 },
 {
   "id": 9731,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 1,
   "firman": "Elisa telah berbicara kepada perempuan yang anaknya dihidupkannya kembali, katanya: \"Berkemaslah dan pergilah bersama-sama dengan keluargamu, dan tinggallah di mana saja engkau dapat menetap sebagai pendatang, sebab TUHAN telah mendatangkan kelaparan, yang pasti menimpa negeri ini tujuh tahun lamanya.\""
 },
 {
   "id": 9732,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 2,
   "firman": "Lalu berkemaslah perempuan itu dan dilakukannyalah seperti perkataan abdi Allah itu. Ia pergi bersama-sama dengan keluarganya, lalu tinggal menetap sebagai pendatang di negeri orang Filistin tujuh tahun lamanya."
 },
 {
   "id": 9733,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 3,
   "firman": "Dan setelah lewat ketujuh tahun itu, pulanglah perempuan itu dari negeri orang Filistin. Kemudian ia pergi mengadukan perihal rumahnya dan ladangnya kepada raja."
 },
 {
   "id": 9734,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 4,
   "firman": "Raja sedang berbicara kepada Gehazi, bujang abdi Allah itu, katanya: \"Cobalah ceritakan kepadaku tentang segala perbuatan besar yang dilakukan Elisa.\""
 },
 {
   "id": 9735,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 5,
   "firman": "Sedang ia menceritakan kepada raja tentang Elisa menghidupkan anak yang sudah mati itu, tampaklah perempuan yang anaknya dihidupkan itu datang mengadukan perihal rumahnya dan ladangnya kepada raja. Lalu berkatalah Gehazi: \"Ya tuanku raja! Inilah perempuan itu dan inilah anaknya yang dihidupkan Elisa.\""
 },
 {
   "id": 9736,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 6,
   "firman": "Lalu raja bertanya-tanya, dan perempuan itu menceritakan semuanya kepadanya. Kemudian raja menugaskan seorang pegawai istana menyertai perempuan itu dengan pesan: \"Pulangkanlah segala miliknya dan segala hasil ladang itu sejak ia meninggalkan negeri ini sampai sekarang.\""
 },
 {
   "id": 9737,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 7,
   "firman": "Elisa masuk ke Damsyik, dan pada waktu itu Benhadad, raja Aram, sedang sakit. Ketika dikabarkan kepada raja: \"Sudah datang abdi Allah ke mari,\""
 },
 {
   "id": 9738,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 8,
   "firman": "berkatalah ia kepada Hazael: \"Ambillah persembahan, pergilah menyongsong abdi Allah itu dan mintalah petunjuk TUHAN dengan perantaraannya: Sembuhkah aku dari penyakit ini?\""
 },
 {
   "id": 9739,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 9,
   "firman": "Lalu pergilah Hazael menyongsong dia, diambilnyalah persembahan berupa segala barang yang indah-indah dari Damsyik, sebanyak muatan empat puluh ekor unta. Sesudah sampai, tampillah ia ke depan Elisa dan berkata: \"Anakmu Benhadad, raja Aram, menyuruh aku menanyakan kepadamu: Apakah aku akan sembuh dari penyakit ini?\""
 },
 {
   "id": 9740,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 10,
   "firman": "Jawab Elisa kepadanya: \"Pergilah, katakanlah kepadanya: Pastilah engkau sembuh. Namun demikian, TUHAN telah memperlihatkan kepadaku, bahwa ia pasti mati dibunuh.\""
 },
 {
   "id": 9741,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 11,
   "firman": "Elisa menatap dengan lama ke depan, lalu menangislah abdi Allah itu."
 },
 {
   "id": 9742,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 12,
   "firman": "Hazael berkata: \"Mengapa tuanku menangis?\" Jawab Elisa: \"Sebab aku tahu bagaimana malapetaka yang akan kaulakukan kepada orang Israel: kotanya yang berkubu akan kaucampakkan ke dalam api, terunanya akan kaubunuh dengan pedang, bayinya akan kauremukkan dan perempuannya yang mengandung akan kaubelah.\""
 },
 {
   "id": 9743,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 13,
   "firman": "Sesudah itu berkatalah Hazael: \"Tetapi apakah hambamu ini, yang tidak lain dari anjing saja, sehingga ia dapat melakukan hal sehebat itu?\" Jawab Elisa: \"TUHAN telah memperlihatkan kepadaku, bahwa engkau akan menjadi raja atas Aram.\""
 },
 {
   "id": 9744,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 14,
   "firman": "Lalu ia pergi dan meninggalkan Elisa dan setelah ia sampai kepada tuannya, berkatalah raja kepadanya: \"Apakah dikatakan Elisa kepadamu?\" Jawabnya: \"Ia berkata kepadaku, bahwa pastilah engkau sembuh.\""
 },
 {
   "id": 9745,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 15,
   "firman": "Tetapi keesokan harinya ia mengambil sehelai selimut yang telah dicelupkannya ke dalam air dan membentangkannya ke atas muka raja. Jadi matilah raja, dan Hazael menjadi raja menggantikan dia."
 },
 {
   "id": 9746,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 16,
   "firman": "Dalam tahun kelima zaman Yoram, anak Ahab raja Israel--pada waktu itu Yosafat adalah raja Yehuda--Yoram, anak Yosafat raja Yehuda menjadi raja."
 },
 {
   "id": 9747,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 17,
   "firman": "Ia berumur tiga puluh dua tahun pada waktu ia menjadi raja dan delapan tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 9748,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 18,
   "firman": "Ia hidup menurut kelakuan raja-raja Israel seperti yang dilakukan keluarga Ahab, sebab yang menjadi isterinya adalah anak Ahab. Ia melakukan apa yang jahat di mata TUHAN."
 },
 {
   "id": 9749,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 19,
   "firman": "Namun demikian, TUHAN tidak mau memusnahkan Yehuda oleh karena Daud, hamba-Nya, sesuai dengan yang dijanjikan-Nya kepada Daud, bahwa Ia hendak memberikan keturunan kepadanya dan kepada anak-anaknya untuk selama-lamanya."
 },
 {
   "id": 9750,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 20,
   "firman": "Pada zamannya memberontaklah Edom dan melepaskan diri dari kekuasaan Yehuda dan mereka mengangkat seorang raja atas mereka sendiri."
 },
 {
   "id": 9751,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 21,
   "firman": "Maka majulah Yoram ke Zair bersama-sama dengan seluruh keretanya; pada waktu malam bangunlah ia, lalu bersama-sama dengan para panglima pasukan kereta ia menerobos barisan orang Edom yang mengepung dia, tetapi rakyatnya melarikan diri pulang ke kemahnya."
 },
 {
   "id": 9752,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 22,
   "firman": "Demikianlah Edom memberontak dan terlepas dari kekuasaan Yehuda sampai sekarang ini. Lalu Libnapun memberontak pada masa itu juga."
 },
 {
   "id": 9753,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 23,
   "firman": "Selebihnya dari riwayat Yoram dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9754,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 24,
   "firman": "Kemudian Yoram mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud. Maka Ahazia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9755,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 25,
   "firman": "Dalam tahun kedua belas zaman Yoram, anak Ahab raja Israel, Ahazia, anak Yoram raja Yehuda, menjadi raja."
 },
 {
   "id": 9756,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 26,
   "firman": "Ia berumur dua puluh dua tahun pada waktu ia menjadi raja dan setahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Atalya, cucu Omri raja Israel."
 },
 {
   "id": 9757,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 27,
   "firman": "Ia hidup menurut kelakuan keluarga Ahab dan ia melakukan apa yang jahat di mata TUHAN sama seperti keluarga Ahab, sebab ia adalah seorang menantu dari keluarga itu."
 },
 {
   "id": 9758,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 28,
   "firman": "Ia pergi bersama-sama Yoram bin Ahab untuk berperang melawan Hazael, raja Aram, di Ramot-Gilead. Tetapi orang-orang Aram melukai Yoram."
 },
 {
   "id": 9759,
   "kitab": "2Ra",
   "pasal": 8,
   "ayat": 29,
   "firman": "Kemudian pulanglah raja Yoram ke Yizreel, supaya diobati luka-lukanya yang ditimbulkan orang Aram di Rama pada waktu ia berperang melawan Hazael, raja Aram. Dan Ahazia, anak Yoram raja Yehuda, pergi menjenguk Yoram bin Ahab di Yizreel, karena dia sakit."
 },
 {
   "id": 9760,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 1,
   "firman": "Kemudian nabi Elisa memanggil salah seorang dari rombongan nabi dan berkata kepadanya: \"Ikatlah pinggangmu, bawalah buli-buli berisi minyak ini dan pergilah ke Ramot-Gilead."
 },
 {
   "id": 9761,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 2,
   "firman": "Apabila engkau sampai ke sana, carilah Yehu bin Yosafat bin Nimsi; masuklah, ajak dia bangkit dari tengah-tengah temannya dan bawalah dia ke ruang dalam."
 },
 {
   "id": 9762,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 3,
   "firman": "Kemudian ambillah buli-buli berisi minyak itu, lalu tuangkan isinya ke atas kepalanya dan katakan: Beginilah firman TUHAN: Telah Kuurapi engkau menjadi raja atas Israel! Sesudah itu bukalah pintu, larilah dan jangan berlambat-lambat.\""
 },
 {
   "id": 9763,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 4,
   "firman": "Lalu nabi muda itu pergi ke Ramot-Gilead."
 },
 {
   "id": 9764,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 5,
   "firman": "Setelah ia sampai, maka tampaklah panglima-panglima tentara sedang duduk berkumpul. Lalu ia berkata: \"Ada pesan kubawa untukmu, ya panglima!\" Yehu bertanya: \"Untuk siapa dari kami sekalian?\" Jawabnya: \"Untukmu, ya panglima!\""
 },
 {
   "id": 9765,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 6,
   "firman": "Lalu bangkitlah Yehu dan masuk ke dalam rumah. Nabi muda itu menuang minyak ke atas kepala Yehu serta berkata kepadanya: \"Beginilah firman TUHAN, Allah Israel: Telah Kuurapi engkau menjadi raja atas umat TUHAN, yaitu orang Israel."
 },
 {
   "id": 9766,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 7,
   "firman": "Maka engkau akan membunuh keluarga tuanmu Ahab dan dengan demikian Aku membalaskan kepada Izebel darah hamba-hamba-Ku, nabi-nabi itu, bahkan darah semua hamba TUHAN."
 },
 {
   "id": 9767,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dan segenap keluarga Ahab akan binasa; dan Aku akan melenyapkan dari pada Ahab setiap orang laki-laki, baik yang tinggi maupun yang rendah kedudukannya di Israel."
 },
 {
   "id": 9768,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 9,
   "firman": "Dan Aku akan memperlakukan keluarga Ahab sama seperti keluarga Yerobeam bin Nebat dan sama seperti keluarga Baesa bin Ahia."
 },
 {
   "id": 9769,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 10,
   "firman": "Izebel akan dimakan anjing di kebun di luar Yizreel dengan tidak ada orang yang menguburkannya.\" Kemudian nabi itu membuka pintu, lalu lari."
 },
 {
   "id": 9770,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 11,
   "firman": "Apabila Yehu keluar mendapatkan pegawai-pegawai tuannya, berkatalah seorang kepadanya: \"Apa kabar? Mengapa orang gila itu datang kepadamu?\" Jawabnya kepada mereka: \"Kamu sendiri mengenal orang itu dengan omongannya!\""
 },
 {
   "id": 9771,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 12,
   "firman": "Tetapi mereka berkata: \"Dusta! Cobalah beritahukan kepada kami!\" Lalu katanya: \"Begini-beginilah dikatakannya kepadaku: Demikianlah firman TUHAN: Telah Kuurapi engkau menjadi raja atas Israel.\""
 },
 {
   "id": 9772,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 13,
   "firman": "Segeralah mereka masing-masing mengambil pakaiannya dan membentangkannya di hadapan kakinya begitu saja di atas tangga, kemudian mereka meniup sangkakala serta berseru: \"Yehu raja!\""
 },
 {
   "id": 9773,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 14,
   "firman": "Demikianlah Yehu bin Yosafat bin Nimsi mengadakan persepakatan melawan Yoram. --Adapun Yoram sedang berjaga-jaga di Ramot-Gilead, bersama-sama dengan segenap orang Israel menghadapi Hazael, raja Aram."
 },
 {
   "id": 9774,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 15,
   "firman": "Tetapi raja Yoram sendiri telah pulang ke Yizreel, supaya luka-lukanya diobati, yang ditimbulkan orang Aram pada waktu ia berperang melawan Hazael, raja Aram. --Yehu berkata: \"Jika kamu sudah setuju, janganlah biarkan siapapun meloloskan diri dari kota untuk memberitahukan hal itu ke Yizreel.\""
 },
 {
   "id": 9775,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 16,
   "firman": "Kemudian Yehu naik kereta dan pergi ke Yizreel, sebab Yoram berbaring sakit di sana. Juga Ahazia, raja Yehuda, datang menjenguk Yoram."
 },
 {
   "id": 9776,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 17,
   "firman": "Ketika jaga yang sedang berdiri di atas menara di Yizreel, melihat pasukan Yehu datang, berserulah ia: \"Ada kulihat suatu pasukan.\" Berkatalah Yoram: \"Ambillah seorang penunggang kuda, suruhlah ia menemui mereka serta menanyakan: apakah ini kabar damai?\""
 },
 {
   "id": 9777,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 18,
   "firman": "Lalu pergilah penunggang kuda itu untuk menemuinya dan berkata: \"Beginilah tanya raja: apakah ini kabar damai?\" Jawab Yehu: \"Damai? Bukan urusanmu! Baliklah, ikutlah aku!\" Dan jaga itu memberitahukan: \"Suruhan sudah sampai kepada mereka, tetapi ia tidak pulang.\""
 },
 {
   "id": 9778,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 19,
   "firman": "Disuruhnyalah penunggang kuda yang kedua dan setelah sampai kepada mereka berkatalah ia: \"Beginilah tanya raja: apakah ini kabar damai?\" Jawab Yehu: \"Damai? Bukan urusanmu! Baliklah, ikutlah aku!\""
 },
 {
   "id": 9779,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 20,
   "firman": "Dan jaga itu memberitahukan: \"Sudah sampai ia kepada mereka, tetapi ia tidak pulang! Dan cara memacunya adalah seperti cara Yehu, cucu Nimsi, memacu, sebab ia memacu seperti orang gila.\""
 },
 {
   "id": 9780,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 21,
   "firman": "Sesudah itu berkatalah Yoram: \"Pasanglah kereta!\", lalu orang memasang keretanya. Maka keluarlah Yoram, raja Israel, dan Ahazia, raja Yehuda, masing-masing naik keretanya; mereka keluar menemui Yehu, lalu menjumpai dia di kebun Nabot, orang Yizreel itu."
 },
 {
   "id": 9781,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 22,
   "firman": "Tatkala Yoram melihat Yehu, bertanyalah ia: \"Apakah ini kabar damai, hai Yehu?\" Jawabnya: \"Bagaimana ada damai, selama sundal dan orang sihir ibumu Izebel begitu banyak!\""
 },
 {
   "id": 9782,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 23,
   "firman": "Segera Yoram berputar dan mau melarikan diri sambil berseru kepada Ahazia: \"Itu tipu, Ahazia!\""
 },
 {
   "id": 9783,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 24,
   "firman": "Tetapi Yehu menarik busurnya dengan sepenuh kekuatannya, lalu memanah Yoram di antara kedua bahunya, sehingga anak panah itu menembus jantungnya, maka rebahlah ia di dalam keretanya."
 },
 {
   "id": 9784,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 25,
   "firman": "Kemudian berkatalah Yehu kepada Bidkar, perwiranya: \"Angkat dan lemparkanlah mayatnya ke kebun Nabot, orang Yizreel itu, sebab ketahuilah, bahwa pada waktu aku dan engkau berdampingan menunggang kuda mengikuti Ahab, ayahnya, maka TUHAN telah mengucapkan terhadap dia hukuman ini:"
 },
 {
   "id": 9785,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sesungguhnya, Aku telah melihat darah Nabot dan darah anak-anaknya tadi malam, demikianlah firman TUHAN, maka Aku akan membalaskannya kepadamu di kebun ini, demikianlah firman TUHAN. Oleh sebab itu angkat dan lemparkanlah mayatnya ke kebun ini, sesuai dengan firman TUHAN.\""
 },
 {
   "id": 9786,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 27,
   "firman": "Ketika Ahazia, raja Yehuda, melihat itu, maka iapun melarikan diri ke arah Bet-Hagan, tetapi Yehu mengejarnya sambil berkata: \"Panahlah dia juga!\" Maka mereka memanah dia di atas keretanya di pendakian ke Gur dekat Yibleam. Ia lari ke Megido dan mati di sana."
 },
 {
   "id": 9787,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 28,
   "firman": "Para pegawainya mengangkut mayatnya ke Yerusalem, lalu mereka menguburkan dia dalam kuburnya sendiri, di samping nenek moyangnya di kota Daud."
 },
 {
   "id": 9788,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 29,
   "firman": "Adapun Ahazia menjadi raja atas Yehuda dalam tahun kesebelas zaman Yoram bin Ahab."
 },
 {
   "id": 9789,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 30,
   "firman": "Sampailah Yehu ke Yizreel. Ketika Izebel mendengar itu, ia mencalak matanya, dihiasinyalah kepalanya, lalu ia menjenguk dari jendela."
 },
 {
   "id": 9790,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 31,
   "firman": "Pada waktu Yehu masuk pintu gerbang, berserulah Izebel: \"Bagaimana, selamatkah Zimri, pembunuh tuannya itu?\""
 },
 {
   "id": 9791,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 32,
   "firman": "Yehu mengangkat kepalanya melihat ke jendela itu dan berkata: \"Siapa yang di pihakku? Siapa?\" Dan ketika dua tiga orang pegawai istana menjenguk kepadanya,"
 },
 {
   "id": 9792,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 33,
   "firman": "ia berseru: \"Jatuhkanlah dia!\" Mereka menjatuhkan dia, sehingga darahnya memercik ke dinding dan ke kuda; mayatnyapun terinjak-injak."
 },
 {
   "id": 9793,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 34,
   "firman": "Yehu masuk ke dalam, lalu makan dan minum. Kemudian ia berkata: \"Baiklah urus mayat orang yang terkutuk itu dan kuburkanlah dia, sebab ia memang anak raja.\""
 },
 {
   "id": 9794,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 35,
   "firman": "Mereka pergi untuk menguburkannya, tetapi mereka tidak menjumpai mayatnya, hanya kepala dan kedua kaki dan kedua telapak tangannya."
 },
 {
   "id": 9795,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 36,
   "firman": "Mereka kembali memberitahukannya kepada Yehu, lalu ia berkata: \"Memang begitulah firman TUHAN yang diucapkan-Nya dengan perantaraan hamba-Nya, Elia, orang Tisbe itu: Di kebun di luar Yizreel akan dimakan anjing daging Izebel;"
 },
 {
   "id": 9796,
   "kitab": "2Ra",
   "pasal": 9,
   "ayat": 37,
   "firman": "maka mayat Izebel akan terhampar di kebun di luar Yizreel seperti pupuk di ladang, sehingga tidak ada orang yang dapat berkata: Inilah Izebel.\""
 },
 {
   "id": 9797,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 1,
   "firman": "Ahab mempunyai tujuh puluh orang anak laki-laki di Samaria. Yehu menulis surat, dan mengirimnya ke Samaria, kepada pembesar kota itu, kepada para tua-tua dan kepada para pengasuh anak-anak Ahab, bunyinya:"
 },
 {
   "id": 9798,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 2,
   "firman": "\"Sekarang, segera sesudah surat ini sampai kepadamu, kamu yang mempunyai anak-anak tuanmu di bawah pengawasanmu, lagipula mempunyai kereta dan kuda dan kota yang berkubu serta senjata,"
 },
 {
   "id": 9799,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 3,
   "firman": "maka pilihlah seorang yang terbaik dan yang paling tepat dari antara anak-anak tuanmu, lalu dudukkanlah dia di atas takhta ayahnya, kemudian berperanglah membela keluarga tuanmu.\""
 },
 {
   "id": 9800,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 4,
   "firman": "Tetapi mereka sangat takut dan berkata: \"Sedangkan kedua raja itu tidak dapat bertahan menghadapinya, bagaimana mungkin kita ini dapat bertahan?\""
 },
 {
   "id": 9801,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 5,
   "firman": "Sebab itu kepala istana dan kepala kota, juga para tua-tua dan para pengasuh mengirim pesan kepada Yehu, bunyinya: \"Kami ini hamba-hambamu dan segala yang kaukatakan kepada kami akan kami lakukan; kami tidak hendak mengangkat seseorang menjadi raja; lakukanlah apa yang baik menurut pemandanganmu.\""
 },
 {
   "id": 9802,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 6,
   "firman": "Kemudian Yehu menulis surat untuk kedua kalinya kepada mereka, bunyinya: \"Jika kamu memihak kepadaku dan mau menurut perkataanku, ambillah kepala anak-anak tuanmu dan datanglah kepadaku besok kira-kira waktu ini ke Yizreel.\" Adapun ketujuh puluh anak raja itu tinggal bersama-sama orang-orang besar di kota itu, yang mendidik mereka."
 },
 {
   "id": 9803,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 7,
   "firman": "Tatkala surat itu sampai kepada mereka, mereka mengambil anak-anak raja itu, menyembelih ketujuh puluh orang itu, menaruh kepala orang-orang itu ke dalam keranjang dan mengirimkan semuanya kepada Yehu di Yizreel."
 },
 {
   "id": 9804,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 8,
   "firman": "Ketika suruhan datang memberitahukan kepadanya: \"Telah dibawa orang kepala anak-anak raja itu,\" berkatalah Yehu: \"Susunlah semuanya menjadi dua timbunan di depan pintu gerbang sampai pagi.\""
 },
 {
   "id": 9805,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 9,
   "firman": "Pada paginya keluarlah Yehu, berdirilah ia, lalu berkata kepada segenap orang banyak: \"Kamu ini tidak bersalah. Memang akulah yang telah mengadakan persepakatan melawan tuanku dan telah membunuh dia; tetapi semua orang ini, siapakah yang membunuh mereka?"
 },
 {
   "id": 9806,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 10,
   "firman": "Ketahuilah sekarang, bahwa firman TUHAN yang telah diucapkan TUHAN tentang keluarga Ahab, tidak ada yang tidak dipenuhi, TUHAN telah melakukan apa yang difirmankan-Nya dengan perantaraan Elia, hamba-Nya.\""
 },
 {
   "id": 9807,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 11,
   "firman": "Lalu Yehu membunuh semua orang yang masih tinggal dari keluarga Ahab yang di Yizreel, juga semua orang besarnya, orang-orang kepercayaannya dan imam-imamnya; tidak ada padanya seorangpun yang ditinggalkan Yehu hidup."
 },
 {
   "id": 9808,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 12,
   "firman": "Kemudian bangkitlah Yehu pergi ke Samaria. Di jalan dekat Bet-Eked, perkampungan para gembala,"
 },
 {
   "id": 9809,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 13,
   "firman": "bertemulah ia dengan sanak saudara Ahazia, raja Yehuda, lalu ia bertanya: \"Siapakah kamu ini?\" Jawab mereka: \"Kami adalah sanak saudara Ahazia dan kami datang untuk memberi salam kepada anak-anak raja dan anak-anak ibu suri.\""
 },
 {
   "id": 9810,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 14,
   "firman": "Berkatalah Yehu: \"Tangkaplah mereka hidup-hidup!\" Lalu ditangkaplah mereka hidup-hidup dan disembelih dekat perigi Bet-Eked, empat puluh dua orang, dan tidak ada seorangpun ditinggalkannya hidup dari pada mereka."
 },
 {
   "id": 9811,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 15,
   "firman": "Setelah pergi dari sana, bertemulah ia dengan Yonadab bin Rekhab yang datang menyongsong dia. Ia memberi salam kepadanya serta berkata: \"Apakah hatimu jujur kepadaku seperti hatiku terhadap engkau?\" Jawab Yonadab: \"Ya!\" \"Jika ya, berilah tanganmu!\" Maka diberinyalah tangannya, lalu Yehu mengajak dia naik ke sampingnya ke dalam kereta."
 },
 {
   "id": 9812,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 16,
   "firman": "Berkatalah Yehu: \"Marilah bersama-sama aku, supaya engkau melihat bagaimana giatku untuk TUHAN.\" Demikianlah Yehu membawa dia dalam keretanya."
 },
 {
   "id": 9813,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 17,
   "firman": "Setelah Yehu sampai di Samaria, maka ia membunuh semua orang yang masih tinggal dari keluarga Ahab di Samaria; ia memunahkannya, sesuai dengan firman yang diucapkan TUHAN kepada Elia."
 },
 {
   "id": 9814,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 18,
   "firman": "Kemudian Yehu mengumpulkan seluruh rakyat, lalu berkata kepada mereka: \"Adapun Ahab masih kurang beribadah kepada Baal, tetapi Yehu mau lebih hebat beribadah kepadanya."
 },
 {
   "id": 9815,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 19,
   "firman": "Oleh sebab itu, panggillah menghadap aku semua nabi Baal, semua orang yang beribadah kepadanya dan semua imamnya, seorangpun tidak boleh tidak hadir, sebab aku hendak mempersembahkan korban yang besar kepada Baal. Setiap orang yang tidak hadir tidak akan tinggal hidup.\" Tetapi perbuatan ini adalah akal Yehu supaya ia membinasakan orang-orang yang beribadah kepada Baal."
 },
 {
   "id": 9816,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 20,
   "firman": "Selanjutnya Yehu berkata: \"Tentukanlah hari raya perkumpulan kudus bagi Baal!\" Lalu mereka memaklumkannya."
 },
 {
   "id": 9817,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 21,
   "firman": "Yehu mengirim orang ke seluruh Israel, maka datanglah seluruh orang yang beribadah kepada Baal, tidak seorangpun yang ketinggalan. Lalu masuklah semuanya ke dalam rumah Baal, sehingga rumah itu penuh sesak dari ujung ke ujung."
 },
 {
   "id": 9818,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 22,
   "firman": "Kemudian berkatalah Yehu kepada orang yang mengepalai gudang pakaian: \"Keluarkanlah pakaian untuk setiap orang yang beribadah kepada Baal!\" Maka dikeluarkannyalah pakaian bagi mereka."
 },
 {
   "id": 9819,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 23,
   "firman": "Sesudah itu masuklah Yehu dan Yonadab bin Rekhab ke dalam rumah Baal, lalu berkatalah ia kepada orang-orang penyembah Baal di situ: \"Periksalah dan lihatlah, supaya jangan ada di antara kamu di sini seorangpun dari hamba-hamba TUHAN, melainkan hanya orang-orang yang beribadah kepada Baal.\""
 },
 {
   "id": 9820,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 24,
   "firman": "Lalu masuklah mereka untuk mempersembahkan korban sembelihan dan korban bakaran. Adapun Yehu telah menempatkan delapan puluh orang di luar dan telah berkata: \"Siapa yang membiarkan lolos seorangpun dari orang-orang yang kuserahkan ke dalam tanganmu, nyawanyalah ganti nyawa orang itu.\""
 },
 {
   "id": 9821,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 25,
   "firman": "Setelah Yehu selesai mempersembahkan korban bakaran, berkatalah ia kepada bentara-bentara dan kepada perwira-perwira: \"Masuklah, bunuhlah mereka, seorangpun tidak boleh lolos!\" Maka dibunuhlah mereka dengan mata pedang, lalu mayatnya dibuang; kemudian masuklah bentara-bentara dan perwira-perwira itu ke gedung rumah Baal."
 },
 {
   "id": 9822,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 26,
   "firman": "Mereka mengeluarkan tiang berhala rumah Baal itu, lalu dibakar."
 },
 {
   "id": 9823,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 27,
   "firman": "Mereka merobohkan tugu berhala Baal itu, merobohkan juga rumah Baal, dan membuatnya menjadi jamban; begitulah sampai hari ini."
 },
 {
   "id": 9824,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 28,
   "firman": "Demikianlah Yehu memunahkan Baal dari Israel."
 },
 {
   "id": 9825,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 29,
   "firman": "Hanya, Yehu tidak menjauh dari dosa-dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula, yakni dosa penyembahan anak-anak lembu emas yang di Betel dan yang di Dan."
 },
 {
   "id": 9826,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 30,
   "firman": "Berfirmanlah TUHAN kepada Yehu: \"Oleh karena engkau telah berbuat baik dengan melakukan apa yang benar di mata-Ku, dan telah berbuat kepada keluarga Ahab tepat seperti yang dikehendaki hati-Ku, maka anak-anakmu akan duduk di atas takhta Israel sampai keturunan yang keempat.\""
 },
 {
   "id": 9827,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 31,
   "firman": "Tetapi Yehu tidak tetap hidup menurut hukum TUHAN, Allah Israel, dengan segenap hatinya; ia tidak menjauh dari dosa-dosa Yerobeam yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9828,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 32,
   "firman": "Pada zaman itu mulailah TUHAN menggunting daerah Israel, sebab Hazael mengalahkan mereka di seluruh daerah Israel"
 },
 {
   "id": 9829,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 33,
   "firman": "di sebelah timur sungai Yordan dengan merebut seluruh tanah Gilead, tanah orang Gad, orang Ruben dan orang Manasye, mulai dari Aroer yang di tepi sungai Arnon, baik Gilead maupun Basan."
 },
 {
   "id": 9830,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 34,
   "firman": "Selebihnya dari riwayat Yehu dan segala yang dilakukannya dan segala kepahlawanannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9831,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 35,
   "firman": "Kemudian Yehu mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di Samaria, maka Yoahas, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9832,
   "kitab": "2Ra",
   "pasal": 10,
   "ayat": 36,
   "firman": "Adapun lamanya Yehu menjadi raja atas Israel di Samaria adalah dua puluh delapan tahun."
 },
 {
   "id": 9833,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 1,
   "firman": "Ketika Atalya, ibu Ahazia, melihat bahwa anaknya sudah mati, maka bangkitlah ia membinasakan semua keturunan raja."
 },
 {
   "id": 9834,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 2,
   "firman": "Tetapi Yoseba, anak perempuan raja Yoram, saudara perempuan Ahazia, mengambil Yoas bin Ahazia, menculik dia dari tengah-tengah anak-anak raja yang hendak dibunuh itu, memasukkan dia dengan inang penyusunya ke dalam gudang tempat tidur, dan menyembunyikan dia terhadap Atalya, sehingga dia tidak dibunuh."
 },
 {
   "id": 9835,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 3,
   "firman": "Maka tinggallah dia enam tahun lamanya bersama-sama perempuan itu dengan bersembunyi di rumah TUHAN, sementara Atalya memerintah negeri."
 },
 {
   "id": 9836,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 4,
   "firman": "Dalam tahun yang ketujuh Yoyada mengundang para kepala pasukan seratus dari orang Kari dan dari pasukan bentara penunggu. Disuruhnyalah mereka datang kepadanya di rumah TUHAN, lalu diikatnya perjanjian dengan mereka dengan menyuruh mereka bersumpah di rumah TUHAN. Kemudian diperlihatkannyalah anak raja itu kepada mereka."
 },
 {
   "id": 9837,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 5,
   "firman": "Sesudah itu ia memerintahkan kepada mereka: \"Inilah yang harus kamu lakukan: sepertiga dari kamu, yakni yang selesai bertugas pada hari Sabat di sini, tetapi mengawal di istana raja--"
 },
 {
   "id": 9838,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 6,
   "firman": "sepertiga lagi ada di pintu gerbang Sur dan sepertiga pula di pintu gerbang di belakang para bentara penunggu--haruslah mengawal di istana;"
 },
 {
   "id": 9839,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 7,
   "firman": "dan kedua regu dari pada kamu, yakni semua orang yang bertugas di sini pada hari Sabat dan mengawal di rumah TUHAN,"
 },
 {
   "id": 9840,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 8,
   "firman": "haruslah mengelilingi raja dari segala penjuru, masing-masing dengan senjatanya di tangannya, dan siapa yang mendatangi barisan haruslah mati dibunuh. Dan baiklah kamu menyertai raja setiap kali ia keluar atau masuk.\""
 },
 {
   "id": 9841,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 9,
   "firman": "Para kepala pasukan seratus itu melakukan tepat seperti yang diperintahkan imam Yoyada. Masing-masing mengambil orang-orangnya yang selesai bertugas pada hari Sabat bersama-sama dengan orang-orang yang masuk bertugas pada hari itu, lalu datanglah mereka kepada imam Yoyada."
 },
 {
   "id": 9842,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 10,
   "firman": "Imam memberikan kepada para kepala pasukan seratus itu tombak-tombak dan perisai-perisai kepunyaan raja Daud yang ada di rumah TUHAN."
 },
 {
   "id": 9843,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 11,
   "firman": "Kemudian para bentara itu, masing-masing dengan senjatanya di tangannya, mengambil tempatnya di lambung kanan sampai ke lambung kiri rumah itu, dengan mengelilingi mezbah dan rumah itu untuk melindungi raja."
 },
 {
   "id": 9844,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 12,
   "firman": "Sesudah itu Yoyada membawa anak raja itu ke luar, mengenakan jejamang kepadanya dan memberikan hukum Allah kepadanya. Mereka menobatkan dia menjadi raja serta mengurapinya, dan sambil bertepuk tangan berserulah mereka: \"Hiduplah raja!\""
 },
 {
   "id": 9845,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 13,
   "firman": "Ketika Atalya mendengar suara bentara-bentara penunggu dan rakyat, pergilah ia mendapatkan rakyat itu ke dalam rumah TUHAN."
 },
 {
   "id": 9846,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 14,
   "firman": "Lalu dilihatnyalah raja berdiri dekat tiang menurut kebiasaan, sedang para pemimpin dengan para pemegang nafiri ada dekat raja. Dan seluruh rakyat negeri bersukaria sambil meniup nafiri. Maka Atalya mengoyakkan pakaiannya sambil berseru: \"Khianat, khianat!\""
 },
 {
   "id": 9847,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 15,
   "firman": "Tetapi imam Yoyada memerintahkan para kepala pasukan seratus, yakni orang-orang yang mengepalai tentara, katanya kepada mereka: \"Bawalah dia keluar dari barisan! Siapa yang memihak kepadanya bunuhlah dengan pedang!\" Sebab tadinya imam itu telah berkata: \"Janganlah ia dibunuh di rumah TUHAN!\""
 },
 {
   "id": 9848,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 16,
   "firman": "Lalu mereka menangkap perempuan itu. Pada waktu ia masuk ke istana raja dengan melalui pintu bagi kuda, dibunuhlah dia di situ."
 },
 {
   "id": 9849,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 17,
   "firman": "Kemudian Yoyada mengikat perjanjian antara TUHAN dengan raja dan rakyat, bahwa mereka menjadi umat TUHAN; juga antara raja dengan rakyat."
 },
 {
   "id": 9850,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 18,
   "firman": "Sesudah itu masuklah seluruh rakyat negeri ke rumah Baal, lalu merobohkannya; mereka memecahkan sama sekali mezbah-mezbahnya dan patung-patung dan membunuh Matan, imam Baal, di depan mezbah-mezbah itu. Kemudian imam Yoyada mengangkat penjaga-penjaga untuk rumah TUHAN."
 },
 {
   "id": 9851,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 19,
   "firman": "Sesudah itu ia mengajak para kepala pasukan seratus orang-orang Kari dan para bentara penunggu dan seluruh rakyat negeri, lalu mereka membawa raja turun dari rumah TUHAN; mereka masuk ke istana raja melalui pintu gerbang para bentara; kemudian duduklah raja di atas takhta kerajaan."
 },
 {
   "id": 9852,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 20,
   "firman": "Bersukarialah seluruh rakyat negeri dan amanlah kota itu, setelah Atalya mati dibunuh dengan pedang di istana raja."
 },
 {
   "id": 9853,
   "kitab": "2Ra",
   "pasal": 11,
   "ayat": 21,
   "firman": "Yoas berumur tujuh tahun pada waktu ia menjadi raja."
 },
 {
   "id": 9854,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 1,
   "firman": "Dalam tahun ketujuh zaman Yehu, Yoas menjadi raja dan empat puluh tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Zibya, dari Bersyeba."
 },
 {
   "id": 9855,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 2,
   "firman": "Yoas melakukan apa yang benar di mata TUHAN seumur hidupnya, selama imam Yoyada mengajar dia."
 },
 {
   "id": 9856,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 3,
   "firman": "Namun demikian, bukit-bukit pengorbanan tidaklah dijauhkan. Bangsa itu masih mempersembahkan dan membakar korban di bukit-bukit itu."
 },
 {
   "id": 9857,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 4,
   "firman": "Berkatalah Yoas kepada para imam: \"Segala uang yang dibawa ke dalam rumah TUHAN sebagai persembahan kudus, yakni uang masuk untuk pencatatan jiwa, uang tebusan jiwa menurut penilaian yang berlaku untuk seseorang, dan segala uang yang dibawa ke dalam rumah TUHAN karena dorongan hati seseorang,"
 },
 {
   "id": 9858,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 5,
   "firman": "baiklah para imam sendiri menerimanya, masing-masing dari kenalannya, dan memakainya untuk memperbaiki yang rusak pada rumah itu, di mana saja terdapat kerusakan.\""
 },
 {
   "id": 9859,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 6,
   "firman": "Tetapi dalam tahun kedua puluh tiga zaman raja Yoas para imam belum juga memperbaiki kerusakan rumah itu."
 },
 {
   "id": 9860,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 7,
   "firman": "Sebab itu raja Yoas memanggil imam Yoyada, dan imam-imam lain serta berkata kepada mereka: \"Mengapa kamu tidak perbaiki kerusakan rumah itu? Maka sekarang, tidak boleh lagi kamu menerima uang dari kenalan-kenalanmu, tetapi serahkanlah itu untuk memperbaiki kerusakan rumah itu.\""
 },
 {
   "id": 9861,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 8,
   "firman": "Lalu setujulah para imam itu untuk tidak menerima uang dari rakyat, tetapi merekapun tidak usah lagi memperbaiki kerusakan rumah itu."
 },
 {
   "id": 9862,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 9,
   "firman": "Kemudian imam Yoyada mengambil sebuah peti, membuat lobang pada tutupnya dan menaruhnya di samping mezbah, di sebelah kanan apabila orang masuk ke rumah TUHAN. Para imam penjaga pintu menaruh ke dalamnya segala uang yang dibawa orang ke dalam rumah TUHAN."
 },
 {
   "id": 9863,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 10,
   "firman": "Dan apabila dilihat mereka bahwa sudah banyak uang dalam peti itu, maka datanglah panitera raja beserta imam besar, lalu membungkus dan menghitung uang yang terdapat dalam rumah TUHAN itu."
 },
 {
   "id": 9864,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 11,
   "firman": "Mereka menyerahkan jumlah uang yang ditentukan ke tangan para pekerja yang diangkat mengawasi rumah TUHAN, dan mereka ini membayarkannya kepada tukang-tukang kayu, kepada tukang-tukang bangunan yang mengerjakan rumah TUHAN itu,"
 },
 {
   "id": 9865,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 12,
   "firman": "kepada tukang-tukang tembok dan kepada tukang-tukang pemahat batu; mereka memakainya juga bagi pembelian kayu dan batu pahat untuk memperbaiki rumah TUHAN dan bagi segala pengeluaran untuk memperbaiki rumah itu."
 },
 {
   "id": 9866,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 13,
   "firman": "Tetapi untuk rumah TUHAN tidaklah dibuat pasu perak, pisau, bokor penyiraman, nafiri, atau sesuatu perkakas emas dan perak dari uang yang telah dibawa ke dalam rumah TUHAN itu."
 },
 {
   "id": 9867,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 14,
   "firman": "Melainkan mereka menyerahkannya kepada para pekerja, supaya dipakai memperbaiki rumah TUHAN."
 },
 {
   "id": 9868,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 15,
   "firman": "Mereka kemudian tidak mengadakan perhitungan dengan orang-orang yang diserahi uang itu untuk memberikannya kepada tukang-tukang, sebab mereka bekerja dengan jujur."
 },
 {
   "id": 9869,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 16,
   "firman": "Tetapi uang korban penebus salah dan uang korban penghapus dosa tidaklah dibawa ke dalam rumah TUHAN; semuanya itu adalah bagian para imam."
 },
 {
   "id": 9870,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 17,
   "firman": "Pada waktu itu majulah Hazael, raja Aram, diperanginyalah Gat dan direbutnya. Kemudian Hazael berniat menyerang Yerusalem,"
 },
 {
   "id": 9871,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 18,
   "firman": "tetapi Yoas, raja Yehuda, mengambil segala persembahan kudus yang telah dikuduskan oleh para leluhurnya yakni Yosafat, Yoram dan Ahazia, raja-raja Yehuda, dan persembahan-persembahan kudusnya sendiri, juga segala emas yang terdapat dalam perbendaharaan rumah TUHAN dan istana raja. Dikirimkannyalah semuanya itu kepada Hazael, raja Aram, maka tidak jadi lagi Hazael menyerang Yerusalem."
 },
 {
   "id": 9872,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 19,
   "firman": "Selebihnya dari riwayat Yoas dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9873,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 20,
   "firman": "Pegawai-pegawainya bangkit mengadakan persepakatan, lalu membunuh Yoas di rumah Milo yang letaknya di penurunan ke Sila."
 },
 {
   "id": 9874,
   "kitab": "2Ra",
   "pasal": 12,
   "ayat": 21,
   "firman": "Yozakar, anak Simeat, dan Yozabad, anak Somer, ialah pegawai-pegawainya yang membunuh dia. Lalu ia dikuburkan di samping nenek moyangnya di kota Daud, maka Amazia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9875,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 1,
   "firman": "Dalam tahun kedua puluh tiga zaman Yoas bin Ahazia, raja Yehuda, Yoahas, anak Yehu, menjadi raja atas Israel di Samaria; ia memerintah tujuh belas tahun lamanya."
 },
 {
   "id": 9876,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, dan ia hidup menuruti dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula. Ia tidak menjauhinya."
 },
 {
   "id": 9877,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 3,
   "firman": "Sebab itu bangkitlah murka TUHAN terhadap Israel, lalu diserahkan-Nyalah mereka ke dalam tangan Hazael, raja Aram, dan ke dalam tangan Benhadad, anak Hazael, selama zaman itu."
 },
 {
   "id": 9878,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 4,
   "firman": "Tetapi kemudian Yoahas memohon belas kasihan TUHAN, dan TUHAN mendengarkan dia, sebab Ia telah melihat, bagaimana beratnya orang Israel ditindas oleh raja Aram."
 },
 {
   "id": 9879,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 5,
   "firman": "--TUHAN memberikan kepada orang Israel seorang penolong, sehingga mereka lepas dari tangan Aram dan dapat duduk di kemah-kemah mereka seperti yang sudah-sudah."
 },
 {
   "id": 9880,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 6,
   "firman": "Hanya mereka tidak menjauh dari dosa-dosa keluarga Yerobeam, yang mengakibatkan orang Israel berdosa pula, melainkan mereka terus hidup dalam dosa itu. Juga patung Asyera masih berdiri di Samaria. --"
 },
 {
   "id": 9881,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 7,
   "firman": "Sebab tidak ada laskar ditinggalkan pada Yoahas, selain dari lima puluh orang berkuda dan sepuluh kereta dan sepuluh ribu orang berjalan kaki, sebab raja Aram telah membinasakan mereka dan meniupkan mereka seperti abu pengirikan."
 },
 {
   "id": 9882,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 8,
   "firman": "Selebihnya dari riwayat Yoahas dan segala yang dilakukannya dan kepahlawanannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9883,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 9,
   "firman": "Kemudian Yoahas mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di Samaria. Maka Yoas, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9884,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 10,
   "firman": "Dalam tahun ketiga puluh tujuh zaman Yoas, raja Yehuda, Yoas anak Yoahas, menjadi raja atas Israel di Samaria. Ia memerintah enam belas tahun lamanya."
 },
 {
   "id": 9885,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 11,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN. Ia tidak menjauh dari segala dosa yang disuruh Yerobeam bin Nebat dilakukan orang Israel, tetapi terus hidup dalam dosa itu."
 },
 {
   "id": 9886,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 12,
   "firman": "Selebihnya dari riwayat Yoas dan segala yang dilakukannya dan kepahlawanannya, bagaimana ia berperang melawan Amazia, raja Yehuda, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9887,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 13,
   "firman": "Setelah Yoas mendapat perhentian bersama-sama dengan nenek moyangnya, maka duduklah Yerobeam di atas takhta ayahnya. Dan Yoas dikuburkan di Samaria di samping raja Israel."
 },
 {
   "id": 9888,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 14,
   "firman": "Ketika Elisa menderita sakit yang menyebabkan kematiannya, datanglah Yoas, raja Israel, kepadanya dan menangis oleh karena dia, katanya: \"Bapaku, bapaku! Kereta Israel dan orang-orangnya yang berkuda!\""
 },
 {
   "id": 9889,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 15,
   "firman": "Berkatalah Elisa kepadanya: \"Ambillah busur dan anak-anak panah!\" Lalu diambillah busur dan anak-anak panah."
 },
 {
   "id": 9890,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 16,
   "firman": "Berkatalah ia kepada raja Israel: \"Tariklah busurmu!\" Lalu ia menarik busurnya, tetapi Elisa menaruh tangannya di atas tangan raja,"
 },
 {
   "id": 9891,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 17,
   "firman": "serta berkata: \"Bukalah jendela yang di sebelah timur!\" Dan ketika dibukanya, berkatalah Elisa: \"Panahlah!\" Lalu dipanahnya. Kemudian berkatalah Elisa: \"Itulah anak panah kemenangan dari pada TUHAN, anak panah kemenangan terhadap Aram. Engkau akan mengalahkan Aram di Afek sampai habis lenyap.\""
 },
 {
   "id": 9892,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 18,
   "firman": "Sesudah itu berkatalah ia: \"Ambillah anak-anak panah itu!\" Lalu diambilnya. Setelah diambilnya, berkatalah Elisa kepada raja Israel: \"Pukulkanlah itu ke tanah!\" Lalu dipukulkannya tiga kali, kemudian ia berhenti."
 },
 {
   "id": 9893,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 19,
   "firman": "Tetapi gusarlah abdi Allah itu kepadanya serta berkata: \"Seharusnya engkau memukul lima atau enam kali! Dengan berbuat demikian engkau akan memukul Aram sampai habis lenyap. Tetapi sekarang, hanya tiga kali saja engkau akan memukul Aram.\""
 },
 {
   "id": 9894,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 20,
   "firman": "Sesudah itu matilah Elisa, lalu ia dikuburkan. Adapun gerombolan Moab sering memasuki negeri itu pada pergantian tahun."
 },
 {
   "id": 9895,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 21,
   "firman": "Pada suatu kali orang sedang menguburkan mayat. Ketika mereka melihat gerombolan datang, dicampakkan merekalah mayat itu ke dalam kubur Elisa, lalu pergi. Dan demi mayat itu kena kepada tulang-tulang Elisa, maka hiduplah ia kembali dan bangun berdiri."
 },
 {
   "id": 9896,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 22,
   "firman": "Hazael, raja Aram, menindas orang Israel sepanjang umur Yoahas."
 },
 {
   "id": 9897,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 23,
   "firman": "Tetapi TUHAN mengasihani serta menyayangi mereka, dan Ia berpaling kepada mereka oleh karena perjanjian-Nya dengan Abraham, Ishak dan Yakub, jadi Ia tidak mau memusnahkan mereka dan belum membuang mereka pada waktu itu dari hadapan-Nya."
 },
 {
   "id": 9898,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 24,
   "firman": "Kemudian matilah Hazael, raja Aram, maka Benhadad, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9899,
   "kitab": "2Ra",
   "pasal": 13,
   "ayat": 25,
   "firman": "Yoas bin Yoahas merebut kembali dari tangan Benhadad bin Hazael kota-kota yang dalam peperangan direbut Benhadad dari tangan Yoahas, ayah Yoas. Tiga kali Yoas mengalahkan dia dan mendapat kembali kota-kota Israel."
 },
 {
   "id": 9900,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 1,
   "firman": "Dalam tahun kedua zaman Yoas bin Yoahas, raja Israel, Amazia, anak Yoas raja Yehuda menjadi raja."
 },
 {
   "id": 9901,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 2,
   "firman": "Ia berumur dua puluh lima tahun pada waktu ia menjadi raja dan dua puluh sembilan tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yoadan, dari Yerusalem."
 },
 {
   "id": 9902,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 3,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, hanya bukan seperti Daud, bapa leluhurnya. Ia berbuat tepat seperti yang diperbuat Yoas, ayahnya."
 },
 {
   "id": 9903,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 4,
   "firman": "Namun demikian, bukit-bukit pengorbanan tidaklah dijauhkan. Bangsa itu masih mempersembahkan dan membakar korban di bukit-bukit itu."
 },
 {
   "id": 9904,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 5,
   "firman": "Segera sesudah kuasa kerajaan itu kokoh di tangannya, dibunuhnyalah pegawai-pegawainya yang telah membunuh raja, yaitu ayahnya."
 },
 {
   "id": 9905,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi anak-anak para pembunuh itu tidak dihukum mati olehnya, seperti yang tertulis dalam kitab Taurat Musa, di mana TUHAN telah memberi perintah: \"Janganlah ayah dihukum mati karena anaknya, janganlah juga anak dihukum mati karena ayahnya, melainkan setiap orang harus dihukum mati karena dosanya sendiri.\""
 },
 {
   "id": 9906,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 7,
   "firman": "Ia mengalahkan Edom di Lembah Asin, sepuluh ribu orang banyaknya, dan merebut Sela dalam peperangan itu, lalu dinamainyalah kota itu Yokteel; begitulah sampai hari ini."
 },
 {
   "id": 9907,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 8,
   "firman": "Pada waktu itu Amazia menyuruh utusan kepada Yoas bin Yoahas bin Yehu, raja Israel, mengatakan: \"Mari kita mengadu tenaga!\""
 },
 {
   "id": 9908,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 9,
   "firman": "Tetapi Yoas, raja Israel, menyuruh orang kepada Amazia, raja Yehuda, mengatakan: \"Rumput duri yang di gunung Libanon mengirim pesan kepada pohon aras yang di gunung Libanon, bunyinya: Berikanlah anakmu perempuan kepada anakku laki-laki menjadi isterinya. Tetapi binatang-binatang hutan yang ada di gunung Libanon itu berjalan lewat dari sana, lalu menginjak rumput duri itu."
 },
 {
   "id": 9909,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 10,
   "firman": "Memang engkau telah mengalahkan Edom, sebab itu engkau menjadi tinggi hati. Cukuplah bagimu mendapat kehormatan itu dan tinggallah di rumahmu. Untuk apa engkau menantang malapetaka, sehingga engkau jatuh dan Yehuda bersama-sama engkau?\""
 },
 {
   "id": 9910,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 11,
   "firman": "Tetapi Amazia tidak mau mendengarkan, sebab itu majulah Yoas, raja Israel, lalu mengadu tenagalah mereka, ia dan Amazia, raja Yehuda, di Bet-Semes yang termasuk wilayah Yehuda."
 },
 {
   "id": 9911,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 12,
   "firman": "Yehuda terpukul kalah oleh Israel, sehingga masing-masing lari ke kemahnya."
 },
 {
   "id": 9912,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 13,
   "firman": "Yoas, raja Israel menangkap Amazia, raja Yehuda, anak Yoas bin Ahazia, di Bet-Semes. Lalu Yoas masuk ke Yerusalem, dan membongkar tembok Yerusalem dari Pintu Gerbang Efraim sampai ke Pintu Gerbang Sudut, empat ratus hasta panjangnya."
 },
 {
   "id": 9913,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 14,
   "firman": "Sesudah itu ia mengambil segala emas dan perak dan segala perkakas yang terdapat dalam rumah TUHAN dan dalam perbendaharaan istana raja, juga orang-orang sandera, kemudian pulanglah ia ke Samaria."
 },
 {
   "id": 9914,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 15,
   "firman": "Selebihnya dari riwayat Yoas, apa yang dilakukannya dan kepahlawanannya dan bagaimana ia berperang melawan Amazia, raja Yehuda, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9915,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 16,
   "firman": "Kemudian Yoas mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di Samaria di samping raja-raja Israel. Maka Yerobeam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9916,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 17,
   "firman": "Amazia bin Yoas, raja Yehuda, masih hidup lima belas tahun lamanya sesudah matinya Yoas bin Yoahas, raja Israel."
 },
 {
   "id": 9917,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 18,
   "firman": "Selebihnya dari riwayat Amazia, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9918,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 19,
   "firman": "Di Yerusalem orang mengadakan persepakatan melawan dia, sebab itu larilah ia ke Lakhis. Tetapi mereka menyuruh mengejar dia ke Lakhis, lalu dibunuhlah dia di sana."
 },
 {
   "id": 9919,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 20,
   "firman": "Diangkutlah dia dengan kuda, lalu dikuburkan di Yerusalem di samping nenek moyangnya di kota Daud."
 },
 {
   "id": 9920,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 21,
   "firman": "Segenap bangsa Yehuda mengambil Azarya, yang masih berumur enam belas tahun dan mengangkat dia menjadi raja menggantikan ayahnya, Amazia."
 },
 {
   "id": 9921,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 22,
   "firman": "Ia memperkuat Elat dan mengembalikannya kepada Yehuda, sesudah raja mendapat perhentian bersama-sama dengan nenek moyangnya."
 },
 {
   "id": 9922,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 23,
   "firman": "Dalam tahun kelima belas zaman Amazia bin Yoas, raja Yehuda, Yerobeam, anak Yoas, raja Israel, menjadi raja di Samaria. Ia memerintah empat puluh satu tahun lamanya."
 },
 {
   "id": 9923,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 24,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN. Ia tidak menjauh dari segala dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9924,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 25,
   "firman": "Ia mengembalikan daerah Israel, dari jalan masuk ke Hamat sampai ke Laut Araba sesuai dengan firman TUHAN, Allah Israel, yang telah diucapkan-Nya dengan perantaraan hamba-Nya, nabi Yunus bin Amitai dari Gat-Hefer."
 },
 {
   "id": 9925,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 26,
   "firman": "Sebab TUHAN telah melihat betapa pahitnya kesengsaraan orang Israel itu: sudah habis lenyap baik yang tinggi maupun yang rendah kedudukannya, dan tidak ada penolong bagi orang Israel."
 },
 {
   "id": 9926,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 27,
   "firman": "Tetapi TUHAN tidak mengatakan bahwa Ia akan menghapuskan nama Israel dari kolong langit; jadi Ia menolong mereka dengan perantaraan Yerobeam bin Yoas."
 },
 {
   "id": 9927,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 28,
   "firman": "Selebihnya dari riwayat Yerobeam dan segala yang dilakukannya dan kepahlawanannya, bagaimana ia berperang, dan bagaimana ia mengembalikan Damsyik dan Hamat-Yehuda ke dalam Israel, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9928,
   "kitab": "2Ra",
   "pasal": 14,
   "ayat": 29,
   "firman": "Kemudian Yerobeam mendapat perhentian bersama-sama dengan nenek moyangnya, raja-raja Israel. Maka Zakharia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9929,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 1,
   "firman": "Dalam tahun kedua puluh tujuh zaman Yerobeam, raja Israel, Azarya, anak Amazia raja Yehuda menjadi raja."
 },
 {
   "id": 9930,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 2,
   "firman": "Ia berumur enam belas tahun pada waktu ia menjadi raja dan lima puluh dua tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yekholya, dari Yerusalem."
 },
 {
   "id": 9931,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 3,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Amazia, ayahnya."
 },
 {
   "id": 9932,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 4,
   "firman": "Namun demikian, bukit-bukit pengorbanan tidaklah dijauhkan. Bangsa itu masih mempersembahkan dan membakar korban di bukit-bukit itu."
 },
 {
   "id": 9933,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 5,
   "firman": "Maka TUHAN menimpakan tulah kepada raja, sehingga ia sakit kusta sampai hari kematiannya, dan tinggal dalam sebuah rumah pengasingan. Dan Yotam, anak raja, mengepalai istana dan menjalankan pemerintahan atas rakyat negeri itu."
 },
 {
   "id": 9934,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 6,
   "firman": "Selebihnya dari riwayat Azarya, dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9935,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 7,
   "firman": "Kemudian Azarya mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud. Maka Yotam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9936,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dalam tahun ketiga puluh delapan zaman Azarya, raja Yehuda, Zakharia, anak Yerobeam, menjadi raja atas Israel di Samaria. Ia memerintah enam bulan lamanya."
 },
 {
   "id": 9937,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 9,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN seperti yang telah dilakukan oleh nenek moyangnya. Ia tidak menjauh dari dosa-dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9938,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 10,
   "firman": "Salum bin Yabesh mengikat persepakatan melawan dia, membunuh dia di Yibleam, kemudian menjadi raja menggantikan dia."
 },
 {
   "id": 9939,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 11,
   "firman": "Selebihnya dari riwayat Zakharia, sesungguhnya semuanya itu tertulis dalam kitab sejarah raja-raja Israel."
 },
 {
   "id": 9940,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 12,
   "firman": "Bukankah begini firman TUHAN yang diucapkan-Nya kepada Yehu: \"Anak-anakmu sampai kepada keturunan yang keempat akan duduk di atas takhta Israel!\" Dan terjadilah demikian."
 },
 {
   "id": 9941,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 13,
   "firman": "Salum bin Yabesh menjadi raja dalam tahun yang ketiga puluh sembilan zaman Uzia, raja Yehuda. Ia memerintah sebulan lamanya di Samaria."
 },
 {
   "id": 9942,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 14,
   "firman": "Sesudah itu majulah Menahem bin Gadi dari Tirza, lalu sampai ke Samaria. Ia membunuh Salum bin Yabesh di Samaria, kemudian menjadi raja menggantikan dia."
 },
 {
   "id": 9943,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 15,
   "firman": "Selebihnya dari riwayat Salum dan persepakatan yang diadakannya, sesungguhnya semuanya itu tertulis dalam kitab sejarah raja-raja Israel."
 },
 {
   "id": 9944,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 16,
   "firman": "Pada waktu itu, dengan mulai dari Tirza, Menahem memusnahkan Tifsah dan semua orang yang ada di dalamnya serta daerahnya, sebab orang tidak membuka pintu kota baginya. Maka dimusnahkannyalah kota itu dan dibelahnya semua perempuannya yang mengandung."
 },
 {
   "id": 9945,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 17,
   "firman": "Dalam tahun ketiga puluh sembilan zaman Azarya, raja Yehuda, Menahem bin Gadi menjadi raja atas Israel. Ia memerintah sepuluh tahun lamanya di Samaria."
 },
 {
   "id": 9946,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 18,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN. Sepanjang umurnya ia tidak menjauh dari dosa-dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9947,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 19,
   "firman": "Pul, raja Asyur, datang menyerang negeri itu, lalu Menahem memberi seribu talenta perak kepada Pul, supaya dibantunya dia mengokohkan kerajaan itu di tangannya."
 },
 {
   "id": 9948,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 20,
   "firman": "Menahem mengeluarkan uang ini atas beban Israel dan atas beban semua orang yang kaya raya untuk diberikan kepada raja Asyur: lima puluh syikal perak dari setiap orang. Lalu pulanglah raja Asyur dan ia tidak tinggal di sana, di negeri itu."
 },
 {
   "id": 9949,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 21,
   "firman": "Selebihnya dari riwayat Menahem dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Israel?"
 },
 {
   "id": 9950,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 22,
   "firman": "Kemudian Menahem mendapat perhentian bersama-sama dengan nenek moyangnya. Maka Pekahya, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9951,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 23,
   "firman": "Dalam tahun kelima puluh zaman Azarya, raja Yehuda, Pekahya, anak Menahem, menjadi raja atas Israel di Samaria. Ia memerintah dua tahun lamanya."
 },
 {
   "id": 9952,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 24,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN. Ia tidak menjauh dari dosa-dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9953,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 25,
   "firman": "Lalu perwiranya, yakni Pekah bin Remalya, mengadakan persepakatan melawan dia dan membunuh dia di Samaria di puri istana raja; beserta dia ada Argob dan Arye serta lima puluh orang dari bani Gilead; dibunuhnyalah Pekahya, kemudian menjadi raja menggantikan dia."
 },
 {
   "id": 9954,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 26,
   "firman": "Selebihnya dari riwayat Pekahya dan segala yang dilakukannya, sesungguhnya semuanya itu tertulis dalam kitab sejarah raja-raja Israel."
 },
 {
   "id": 9955,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 27,
   "firman": "Dalam tahun kelima puluh dua zaman Azarya, raja Yehuda, Pekah bin Remalya menjadi raja atas orang Israel di Samaria. Ia memerintah dua puluh tahun lamanya."
 },
 {
   "id": 9956,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 28,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN. Ia tidak menjauh dari dosa-dosa Yerobeam bin Nebat, yang mengakibatkan orang Israel berdosa pula."
 },
 {
   "id": 9957,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 29,
   "firman": "Dalam zaman Pekah, raja Israel, datanglah Tiglat-Pileser, raja Asyur; direbutnyalah Iyon, Abel-Bet-Maakha, Yanoah, Kedesh dan Hazor, Gilead dan Galilea, seluruh tanah Naftali, lalu diangkutnyalah penduduknya ke Asyur ke dalam pembuangan."
 },
 {
   "id": 9958,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 30,
   "firman": "Hosea bin Ela mengadakan persepakatan melawan Pekah bin Remalya; dibunuhnyalah dia, kemudian dia menjadi raja menggantikannya dalam tahun kedua puluh zaman Yotam bin Uzia."
 },
 {
   "id": 9959,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 31,
   "firman": "Selebihnya dari riwayat Pekah dan segala yang dilakukannya, sesungguhnya semuanya itu tertulis dalam kitab sejarah raja-raja Israel."
 },
 {
   "id": 9960,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 32,
   "firman": "Dalam tahun kedua zaman Pekah bin Remalya, raja Israel, Yotam, anak Uzia raja Yehuda menjadi raja."
 },
 {
   "id": 9961,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 33,
   "firman": "Ia berumur dua puluh lima tahun pada waktu ia menjadi raja dan enam belas tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yerusa, anak Zadok."
 },
 {
   "id": 9962,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 34,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Uzia, ayahnya."
 },
 {
   "id": 9963,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 35,
   "firman": "Namun demikian, bukit-bukit pengorbanan tidaklah dijauhkan. Bangsa itu masih mempersembahkan dan membakar korban di bukit-bukit itu. Ia mendirikan Pintu Gerbang Tinggi di rumah TUHAN."
 },
 {
   "id": 9964,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 36,
   "firman": "Selebihnya dari riwayat Yotam, apa yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9965,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 37,
   "firman": "Mulai zaman itu TUHAN menyuruh Rezin, raja Aram, dan Pekah bin Remalya, menyerang Yehuda."
 },
 {
   "id": 9966,
   "kitab": "2Ra",
   "pasal": 15,
   "ayat": 38,
   "firman": "Kemudian Yotam mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud, bapa leluhurnya. Maka Ahas, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9967,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 1,
   "firman": "Dalam tahun ketujuh belas zaman Pekah bin Remalya, Ahas anak Yotam raja Yehuda menjadi raja."
 },
 {
   "id": 9968,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 2,
   "firman": "Ahas berumur dua puluh tahun pada waktu ia menjadi raja dan enam belas tahun lamanya ia memerintah di Yerusalem. Ia tidak melakukan apa yang benar di mata TUHAN, Allahnya, seperti Daud, bapa leluhurnya,"
 },
 {
   "id": 9969,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 3,
   "firman": "tetapi ia hidup menurut kelakuan raja-raja Israel, bahkan dia mempersembahkan anaknya sebagai korban dalam api, sesuai dengan perbuatan keji bangsa-bangsa yang telah dihalau TUHAN dari depan orang Israel."
 },
 {
   "id": 9970,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 4,
   "firman": "Ia mempersembahkan dan membakar korban di bukit-bukit pengorbanan dan di atas tempat-tempat yang tinggi dan di bawah setiap pohon yang rimbun."
 },
 {
   "id": 9971,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 5,
   "firman": "Pada waktu itu majulah Rezin, raja Aram, dan Pekah bin Remalya, raja Israel, untuk memerangi Yerusalem. Dan mereka mengepung Ahas, tetapi mereka tidak dapat mengalahkan dia."
 },
 {
   "id": 9972,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 6,
   "firman": "Pada masa itu Rezin, raja Aram, mengembalikan Elat kepada Edom, lalu ia mengusir orang-orang Yehuda dari Elat. Datanglah orang-orang Edom ke Elat dan diam di sana sampai hari ini."
 },
 {
   "id": 9973,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 7,
   "firman": "Ahas menyuruh utusan-utusan kepada Tiglat-Pileser, raja Asyur, mengatakan: \"Aku ini hambamu dan anakmu. Majulah dan selamatkanlah aku dari tangan raja Aram dan dari tangan raja Israel, yang telah bangkit menyerang aku.\""
 },
 {
   "id": 9974,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 8,
   "firman": "Ahas mengambil perak dan emas yang terdapat dalam rumah TUHAN dan dalam perbendaharaan istana raja, dan mengirimnya kepada raja Asyur sebagai persembahan."
 },
 {
   "id": 9975,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 9,
   "firman": "Maka raja Asyur mendengarkan permintaannya dan maju melawan Damsyik, merebutnya dan mengangkut penduduknya tertawan ke Kir, tetapi Rezin dibunuhnya."
 },
 {
   "id": 9976,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 10,
   "firman": "Sesudah itu pergilah raja Ahas menemui Tiglat-Pileser, raja Asyur, ke Damsyik. Setelah raja Ahas melihat mezbah yang ada di Damsyik, dikirimnyalah kepada imam Uria ukuran dan bagan mezbah itu, menurut buatannya yang tepat."
 },
 {
   "id": 9977,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 11,
   "firman": "Lalu imam Uria mendirikan mezbah; tepat seperti keterangan yang dikirimkan raja Ahas dari Damsyik, demikianlah dibuat imam Uria menjelang datangnya raja Ahas dari Damsyik."
 },
 {
   "id": 9978,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 12,
   "firman": "Setelah raja pulang dari Damsyik, maka raja melihat mezbah itu. Lalu mendekatlah raja kepada mezbah itu, naik ke atasnya,"
 },
 {
   "id": 9979,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 13,
   "firman": "membakar korban bakarannya dan korban sajiannya, mencurahkan korban curahannya di atas mezbah itu, dan menyiramkan darah korban keselamatannya kepadanya."
 },
 {
   "id": 9980,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 14,
   "firman": "Tetapi ia menyuruh menggeser mezbah tembaga yang ada di hadapan TUHAN dari depan rumah TUHAN, dari antara mezbah baru dengan rumah itu, dan menaruhnya di sebelah utara mezbah baru itu."
 },
 {
   "id": 9981,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 15,
   "firman": "Kemudian raja Ahas memerintahkan kepada imam Uria: \"Bakarlah di atas mezbah besar itu korban bakaran pagi dan korban sajian petang, juga korban bakaran dan korban sajian raja, lagi korban bakaran dan korban sajian dan korban-korban curahan seluruh rakyat negeri; dan siramkanlah kepadanya segenap darah korban bakaran dan segenap darah korban sembelihan; tetapi mezbah tembaga itu adalah urusanku.\""
 },
 {
   "id": 9982,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 16,
   "firman": "Lalu imam Uria melakukan tepat seperti yang diperintahkan raja Ahas."
 },
 {
   "id": 9983,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 17,
   "firman": "Sesudah itu raja Ahas memotong papan penutup kereta penopang dan menyingkirkan bejana pembasuhan dari atasnya, juga \"laut\" itu diturunkannya dari atas lembu tembaga yang mendukungnya dan ditaruhnya di atas alas batu."
 },
 {
   "id": 9984,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 18,
   "firman": "Selanjutnya, demi raja Asyur, disingkirkannya dari rumah TUHAN serambi tertutup untuk hari Sabat yang telah didirikan pada rumah TUHAN, juga pintu masuk untuk raja yang di sebelah luar."
 },
 {
   "id": 9985,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 19,
   "firman": "Selebihnya dari riwayat Ahas dan apa yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 9986,
   "kitab": "2Ra",
   "pasal": 16,
   "ayat": 20,
   "firman": "Kemudian Ahas mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud. Maka Hizkia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 9987,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 1,
   "firman": "Dalam tahun kedua belas zaman Ahas, raja Yehuda, Hosea bin Ela menjadi raja di Samaria atas Israel. Ia memerintah sembilan tahun lamanya."
 },
 {
   "id": 9988,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, tetapi bukan seperti raja-raja Israel yang mendahului dia."
 },
 {
   "id": 9989,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 3,
   "firman": "Salmaneser, raja Asyur maju melawan dia; Hosea takluk kepadanya serta membayar upeti."
 },
 {
   "id": 9990,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 4,
   "firman": "Tetapi kedapatanlah oleh raja Asyur, bahwa di pihak Hosea ada persepakatan, karena Hosea telah mengirimkan utusan-utusan kepada So, raja Mesir, dan tidak mempersembahkan lagi upeti kepada raja Asyur, seperti biasanya tahun demi tahun; sebab itu raja Asyur menangkap dia dan membelenggu dia dalam penjara."
 },
 {
   "id": 9991,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 5,
   "firman": "Kemudian majulah raja Asyur menjelajah seluruh negeri itu, ia menyerang Samaria dan mengepungnya tiga tahun lamanya."
 },
 {
   "id": 9992,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 6,
   "firman": "Dalam tahun kesembilan zaman Hosea maka raja Asyur merebut Samaria. Ia mengangkut orang-orang Israel ke Asyur ke dalam pembuangan dan menyuruh mereka tinggal di Halah, di tepi sungai Habor, yakni sungai negeri Gozan, dan di kota-kota orang Madai."
 },
 {
   "id": 9993,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 7,
   "firman": "Hal itu terjadi, karena orang Israel telah berdosa kepada TUHAN, Allah mereka, yang telah menuntun mereka dari tanah Mesir dari kekuasaan Firaun, raja Mesir, dan karena mereka telah menyembah allah lain,"
 },
 {
   "id": 9994,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 8,
   "firman": "dan telah hidup menurut adat istiadat bangsa-bangsa yang telah dihalau TUHAN dari depan orang Israel, dan menurut ketetapan yang telah dibuat raja-raja Israel."
 },
 {
   "id": 9995,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 9,
   "firman": "Dan orang Israel telah menjalankan hal-hal yang tidak patut terhadap TUHAN, Allah mereka. Mereka mendirikan bukit-bukit pengorbanan di manapun mereka diam, baik dekat menara penjagaan maupun di kota yang berkubu;"
 },
 {
   "id": 9996,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 10,
   "firman": "mereka mendirikan tugu-tugu berhala dan tiang-tiang berhala di atas setiap bukit yang tinggi dan di bawah setiap pohon yang rimbun;"
 },
 {
   "id": 9997,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 11,
   "firman": "di sana di atas segala bukit itu mereka membakar korban seperti bangsa-bangsa yang telah diangkut TUHAN tertawan dari depan mereka; mereka melakukan hal-hal yang jahat sehingga mereka menimbulkan sakit hati TUHAN;"
 },
 {
   "id": 9998,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 12,
   "firman": "mereka beribadah kepada berhala-berhala, walaupun TUHAN telah berfirman kepada mereka: \"Janganlah kamu berbuat seperti itu!\""
 },
 {
   "id": 9999,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 13,
   "firman": "TUHAN telah memperingatkan kepada orang Israel dan kepada orang Yehuda dengan perantaraan semua nabi dan semua tukang tilik: \"Berbaliklah kamu dari pada jalan-jalanmu yang jahat itu dan tetaplah ikuti segala perintah dan ketetapan-Ku, sesuai dengan segala undang-undang yang telah Kuperintahkan kepada nenek moyangmu dan yang telah Kusampaikan kepada mereka dengan perantaraan hamba-hamba-Ku, para nabi.\""
 },
 {
   "id": 10000,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 14,
   "firman": "Tetapi mereka tidak mau mendengarkan, melainkan mereka menegarkan tengkuknya seperti nenek moyangnya yang tidak percaya kepada TUHAN, Allah mereka."
 },
 {
   "id": 10001,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 15,
   "firman": "Mereka menolak ketetapan-Nya dan perjanjian-Nya, yang telah diadakan dengan nenek moyang mereka, juga peraturan-peraturan-Nya yang telah diperingatkan-Nya kepada mereka; mereka mengikuti dewa kesia-siaan, sehingga mereka mengikuti bangsa-bangsa yang di sekeliling mereka, walaupun TUHAN telah memerintahkan kepada mereka: janganlah berbuat seperti mereka itu."
 },
 {
   "id": 10002,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 16,
   "firman": "Mereka telah meninggalkan segala perintah TUHAN, Allah mereka, dan telah membuat dua anak lembu tuangan; juga mereka membuat patung Asyera, sujud menyembah kepada segenap tentara langit dan beribadah kepada Baal."
 },
 {
   "id": 10003,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 17,
   "firman": "Tambahan pula mereka mempersembahkan anak-anaknya sebagai korban dalam api dan melakukan tenung dan telaah dan memperbudak diri dengan melakukan yang jahat di mata TUHAN, sehingga mereka menimbulkan sakit hati-Nya."
 },
 {
   "id": 10004,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 18,
   "firman": "Sebab itu TUHAN sangat murka kepada Israel, dan menjauhkan mereka dari hadapan-Nya; tidak ada yang tinggal kecuali suku Yehuda saja. --"
 },
 {
   "id": 10005,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 19,
   "firman": "Juga Yehuda tidak berpegang pada perintah TUHAN, Allah mereka, tetapi mereka hidup menurut ketetapan yang telah dibuat Israel,"
 },
 {
   "id": 10006,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 20,
   "firman": "jadi TUHAN menolak segenap keturunan Israel: Ia menindas mereka dan menyerahkan mereka ke dalam tangan perampok-perampok, sampai habis mereka dibuang-Nya dari hadapan-Nya. --"
 },
 {
   "id": 10007,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 21,
   "firman": "Ketika Ia mengoyakkan Israel dari pada keluarga Daud, maka mereka mengangkat Yerobeam bin Nebat menjadi raja, tetapi Yerobeam membuat orang Israel menyimpang dari pada mengikuti TUHAN dan mengakibatkan mereka melakukan dosa yang besar."
 },
 {
   "id": 10008,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 22,
   "firman": "Demikianlah orang Israel hidup menurut segala dosa yang telah dilakukan Yerobeam; mereka tidak menjauhinya,"
 },
 {
   "id": 10009,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 23,
   "firman": "sampai TUHAN menjauhkan orang Israel dari hadapan-Nya seperti yang telah difirmankan-Nya dengan perantaraan semua hamba-Nya, para nabi. Orang Israel diangkut dari tanahnya ke Asyur ke dalam pembuangan. Demikianlah sampai hari ini."
 },
 {
   "id": 10010,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 24,
   "firman": "Raja Asyur mengangkut orang dari Babel, dari Kuta, dari Awa, dari Hamat dan Sefarwaim, lalu menyuruh mereka diam di kota-kota Samaria menggantikan orang Israel; maka orang-orang itupun menduduki Samaria dan diam di kota-kotanya."
 },
 {
   "id": 10011,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 25,
   "firman": "Pada mulanya waktu mereka diam di sana tidaklah mereka takut kepada TUHAN, sebab itu TUHAN melepaskan singa-singa ke antara mereka yang membunuh beberapa orang di antara mereka."
 },
 {
   "id": 10012,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 26,
   "firman": "Lalu berkatalah orang kepada raja Asyur: \"Bangsa-bangsa yang tuanku angkut tertawan dan yang tuanku suruh diam di kota-kota Samaria tidaklah mengenal hukum beribadah kepada Allah negeri itu, sebab itu dilepaskan-Nyalah singa-singa ke antara mereka yang sesungguhnya membunuh mereka, oleh karena mereka tidak mengenal hukum beribadah kepada Allah negeri itu.\""
 },
 {
   "id": 10013,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 27,
   "firman": "Lalu raja Asyur memberi perintah: \"Suruhlah pergi ke sana salah seorang imam yang telah kamu angkut dari sana ke dalam pembuangan. Biarlah ia pergi dan diam di sana dan mengajarkan kepada mereka hukum beribadah kepada Allah negeri itu!\""
 },
 {
   "id": 10014,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 28,
   "firman": "Salah seorang imam yang telah mereka angkut dari Samaria ke dalam pembuangan pergi dan diam di Betel. Ia mengajarkan kepada mereka bagaimana seharusnya berbakti kepada TUHAN."
 },
 {
   "id": 10015,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 29,
   "firman": "Tetapi setiap bangsa itu telah membuat allahnya sendiri dan menempatkannya di kuil di atas bukit-bukit pengorbanan, yang dibuat oleh orang-orang Samaria; setiap bangsa bertindak demikian di kota-kota yang mereka diami:"
 },
 {
   "id": 10016,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 30,
   "firman": "orang-orang Babel membuat patung Sukot-Benot, orang-orang Kuta membuat patung Nergal, orang-orang Hamat membuat patung Asima,"
 },
 {
   "id": 10017,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 31,
   "firman": "dan orang-orang Awa membuat patung Nibhas dan Tartak. Orang-orang Sefarwaim membakar anak-anak mereka sebagai korban bagi Adramelekh dan Anamelekh, para allah di Sefarwaim."
 },
 {
   "id": 10018,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 32,
   "firman": "Di samping itu mereka berbakti kepada TUHAN dan mengangkat dari kalangan mereka imam untuk bukit-bukit pengorbanan, maka orang-orang inilah yang melakukan ibadah bagi mereka di kuil di atas bukit-bukit pengorbanan itu."
 },
 {
   "id": 10019,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 33,
   "firman": "Mereka berbakti kepada TUHAN, tetapi dalam pada itu mereka beribadah kepada allah mereka sesuai dengan adat bangsa-bangsa yang dari antaranya mereka diangkut tertawan."
 },
 {
   "id": 10020,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 34,
   "firman": "Sampai hari ini mereka berbuat sesuai dengan adat yang dahulu. Mereka tidak berbakti kepada TUHAN dan tidak berbuat sesuai dengan ketetapan, hukum, undang-undang dan perintah yang diperintahkan TUHAN kepada anak-anak Yakub yang telah dinamai-Nya Israel."
 },
 {
   "id": 10021,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 35,
   "firman": "TUHAN telah mengadakan perjanjian dengan mereka dan memberi perintah kepada mereka: \"Janganlah berbakti kepada allah lain, janganlah sujud menyembah kepadanya, janganlah beribadah kepadanya dan janganlah mempersembahkan korban kepadanya."
 },
 {
   "id": 10022,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 36,
   "firman": "Tetapi TUHAN yang menuntun kamu dari tanah Mesir dengan kekuatan yang besar dan dengan tangan yang teracung, kepada-Nyalah kamu harus berbakti, kepada-Nyalah kamu harus sujud menyembah dan mempersembahkan korban."
 },
 {
   "id": 10023,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 37,
   "firman": "Tetapi kamu harus berpegang kepada ketetapan-ketetapan, peraturan-peraturan, hukum dan perintah yang telah ditulis-Nya bagimu dengan melakukannya senantiasa dengan setia, dan janganlah kamu berbakti kepada allah-allah lain."
 },
 {
   "id": 10024,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 38,
   "firman": "Janganlah kamu melupakan perjanjian yang telah Kuadakan dengan kamu dan janganlah kamu berbakti kepada allah lain,"
 },
 {
   "id": 10025,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 39,
   "firman": "melainkan kepada TUHAN, Allahmu, kamu harus berbakti, maka Ia akan melepaskan kamu dari tangan semua musuhmu.\""
 },
 {
   "id": 10026,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 40,
   "firman": "Tetapi mereka tidak mau mendengarkan, melainkan mereka berbuat sesuai dengan adat mereka yang dahulu."
 },
 {
   "id": 10027,
   "kitab": "2Ra",
   "pasal": 17,
   "ayat": 41,
   "firman": "Demikianlah bangsa-bangsa ini berbakti kepada TUHAN, tetapi dalam pada itu mereka beribadah juga kepada patung-patung mereka; baik anak-anak mereka maupun cucu cicit mereka melakukan seperti yang telah dilakukan nenek moyang mereka, sampai hari ini."
 },
 {
   "id": 10028,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 1,
   "firman": "Maka dalam tahun ketiga zaman Hosea bin Ela, raja Israel, Hizkia, anak Ahas raja Yehuda menjadi raja."
 },
 {
   "id": 10029,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 2,
   "firman": "Ia berumur dua puluh lima tahun pada waktu ia menjadi raja dan dua puluh sembilan tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Abi, anak Zakharia."
 },
 {
   "id": 10030,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 3,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Daud, bapa leluhurnya."
 },
 {
   "id": 10031,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 4,
   "firman": "Dialah yang menjauhkan bukit-bukit pengorbanan dan yang meremukkan tugu-tugu berhala dan yang menebang tiang-tiang berhala dan yang menghancurkan ular tembaga yang dibuat Musa, sebab sampai pada masa itu orang Israel memang masih membakar korban bagi ular itu yang namanya disebut Nehustan."
 },
 {
   "id": 10032,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 5,
   "firman": "Ia percaya kepada TUHAN, Allah Israel, dan di antara semua raja-raja Yehuda, baik yang sesudah dia maupun yang sebelumnya, tidak ada lagi yang sama seperti dia."
 },
 {
   "id": 10033,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 6,
   "firman": "Ia berpaut kepada TUHAN, tidak menyimpang dari pada mengikuti Dia dan ia berpegang pada perintah-perintah TUHAN yang telah diperintahkan-Nya kepada Musa."
 },
 {
   "id": 10034,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 7,
   "firman": "Maka TUHAN menyertai dia; ke manapun juga ia pergi berperang, ia beruntung. Ia memberontak kepada raja Asyur dan tidak lagi takluk kepadanya."
 },
 {
   "id": 10035,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 8,
   "firman": "Dialah yang mengalahkan orang Filistin sampai ke Gaza dan memusnahkan daerahnya, baik menara-menara penjagaan maupun kota-kota yang berkubu."
 },
 {
   "id": 10036,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 9,
   "firman": "Dalam tahun keempat zaman raja Hizkia--itulah tahun ketujuh zaman Hosea bin Ela, raja Israel--majulah Salmaneser, raja Asyur, menyerang Samaria dan mengepungnya."
 },
 {
   "id": 10037,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 10,
   "firman": "Direbutlah itu sesudah lewat tiga tahun; dalam tahun keenam zaman Hizkia--itulah tahun kesembilan zaman Hosea, raja Israel--direbutlah Samaria."
 },
 {
   "id": 10038,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 11,
   "firman": "Raja Asyur mengangkut orang Israel ke dalam pembuangan ke Asyur dan menempatkan mereka di Halah, pada sungai Habor, yakni sungai negeri Gozan, dan di kota-kota orang Madai,"
 },
 {
   "id": 10039,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 12,
   "firman": "oleh karena mereka tidak mau mendengarkan suara TUHAN, Allah mereka, dan melanggar perjanjian-Nya, yakni segala yang diperintahkan oleh Musa, hamba TUHAN; mereka tidak mau mendengarkannya dan tidak mau melakukannya."
 },
 {
   "id": 10040,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 13,
   "firman": "Dalam tahun keempat belas zaman raja Hizkia majulah Sanherib, raja Asyur, menyerang segala kota berkubu negeri Yehuda, lalu merebutnya."
 },
 {
   "id": 10041,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 14,
   "firman": "Hizkia, raja Yehuda, mengutus orang kepada raja Asyur di Lakhis dengan pesan: \"Aku telah berbuat dosa; undurlah dari padaku; apapun yang kaubebankan kepadaku akan kupikul.\" Kemudian raja Asyur membebankan kepada Hizkia, raja Yehuda, tiga ratus talenta perak dan tiga puluh talenta emas."
 },
 {
   "id": 10042,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 15,
   "firman": "Hizkia memberikan segala perak yang terdapat dalam rumah TUHAN dan dalam perbendaharaan istana raja."
 },
 {
   "id": 10043,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 16,
   "firman": "Pada waktu itu Hizkia mengerat emas dari pintu-pintu dan dari jenang-jenang pintu bait TUHAN, yang telah dilapis oleh Hizkia, raja Yehuda; diberikannyalah semuanya kepada raja Asyur."
 },
 {
   "id": 10044,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 17,
   "firman": "Sesudah itu raja Asyur mengirim panglima, kepala istana dan juru minuman agung dari Lakhis kepada raja Hizkia di Yerusalem disertai suatu tentara yang besar. Mereka maju dan sampai ke Yerusalem. Setelah mereka maju dan sampai di situ, mereka mengambil tempat dekat saluran kolam atas yang di jalan raja pada Padang Tukang Penatu."
 },
 {
   "id": 10045,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 18,
   "firman": "Dan ketika mereka memanggil-manggil kepada raja, keluarlah mendapatkan mereka Elyakim bin Hilkia, kepala istana, dan Sebna, panitera negara, serta Yoah bin Asaf, bendahara negara."
 },
 {
   "id": 10046,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 19,
   "firman": "Lalu berkatalah juru minuman agung kepada mereka: \"Baiklah katakan kepada Hizkia: Beginilah kata raja agung, raja Asyur: Kepercayaan macam apakah yang kaupegang ini?"
 },
 {
   "id": 10047,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 20,
   "firman": "Kaukira bahwa hanya ucapan bibir saja dapat merupakan siasat dan kekuatan untuk perang! Sekarang, kepada siapa engkau berharap, maka engkau memberontak terhadap aku?"
 },
 {
   "id": 10048,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 21,
   "firman": "Sesungguhnya, engkau berharap kepada tongkat bambu yang patah terkulai itu, yaitu Mesir, yang akan menusuk dan menembus tangan orang yang bertopang kepadanya. Begitulah keadaan Firaun, raja Mesir, bagi semua orang yang berharap kepadanya."
 },
 {
   "id": 10049,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 22,
   "firman": "Dan apabila kamu berkata kepadaku: Kami berharap kepada TUHAN, Allah kami, --bukankah Dia itu yang bukit-bukit pengorbanan-Nya dan mezbah-mezbah-Nya telah dijauhkan oleh Hizkia sambil berkata kepada Yehuda dan Yerusalem: Di depan mezbah yang di Yerusalem inilah kamu harus sujud menyembah!"
 },
 {
   "id": 10050,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 23,
   "firman": "Maka sekarang, baiklah bertaruh dengan tuanku, raja Asyur: Aku akan memberikan dua ribu ekor kuda kepadamu, jika engkau sanggup memberikan dari pihakmu orang-orang yang mengendarainya."
 },
 {
   "id": 10051,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 24,
   "firman": "Bagaimanakah mungkin engkau memukul mundur satu orang perwira tuanku yang paling kecil? Padahal engkau berharap kepada Mesir dalam hal kereta dan orang-orang berkuda!"
 },
 {
   "id": 10052,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 25,
   "firman": "Sekarangpun, adakah di luar kehendak TUHAN aku maju melawan tempat ini untuk memusnahkannya? TUHAN telah berfirman kepadaku: Majulah menyerang negeri itu dan musnahkanlah itu!\""
 },
 {
   "id": 10053,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 26,
   "firman": "Lalu berkatalah Elyakim bin Hilkia, Sebna dan Yoah kepada juru minuman agung: \"Silakan berbicara dalam bahasa Aram kepada hamba-hambamu ini, sebab kami mengerti; tetapi janganlah berbicara dengan kami dalam bahasa Yehuda sambil didengar oleh rakyat yang ada di atas tembok.\""
 },
 {
   "id": 10054,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 27,
   "firman": "Tetapi juru minuman agung berkata kepada mereka: \"Adakah tuanku mengutus aku untuk mengucapkan perkataan-perkataan ini hanya kepada tuanmu dan kepadamu saja? Bukankah juga kepada orang-orang yang duduk di atas tembok, yang memakan tahinya dan meminum air kencingnya bersama-sama dengan kamu?\""
 },
 {
   "id": 10055,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 28,
   "firman": "Kemudian berdirilah juru minuman agung dan berserulah ia dengan suara nyaring dalam bahasa Yehuda. Ia berkata: \"Dengarlah perkataan raja agung, raja Asyur!"
 },
 {
   "id": 10056,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 29,
   "firman": "Beginilah kata raja: Janganlah Hizkia memperdayakan kamu, sebab ia tidak sanggup melepaskan kamu dari tanganku!"
 },
 {
   "id": 10057,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 30,
   "firman": "Janganlah Hizkia mengajak kamu berharap kepada TUHAN dengan mengatakan: Tentulah TUHAN akan melepaskan kita; dan kota ini tidak akan diserahkan ke dalam tangan raja Asyur."
 },
 {
   "id": 10058,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 31,
   "firman": "Janganlah dengarkan Hizkia, sebab beginilah kata raja Asyur: Adakanlah perjanjian penyerahan dengan aku dan datanglah ke luar kepadaku, maka setiap orang dari padamu akan makan dari pohon anggurnya dan dari pohon aranya serta minum dari sumurnya,"
 },
 {
   "id": 10059,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 32,
   "firman": "sampai aku datang dan membawa kamu ke suatu negeri seperti negerimu ini, suatu negeri yang bergandum dan berair anggur, suatu negeri yang beroti dan berkebun anggur, suatu negeri yang berpohon zaitun, berminyak dan bermadu; dengan demikian kamu hidup dan tidak mati. Tetapi janganlah dengarkan Hizkia, sebab ia membujuk kamu dengan mengatakan: TUHAN akan melepaskan kita!"
 },
 {
   "id": 10060,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 33,
   "firman": "Apakah pernah para allah bangsa-bangsa melepaskan negerinya masing-masing dari tangan raja Asyur?"
 },
 {
   "id": 10061,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 34,
   "firman": "Di manakah para allah negeri Hamat dan Arpad? Di manakah para allah negeri Sefarwaim, Hena dan Iwa? Apakah mereka telah melepaskan Samaria dari tanganku?"
 },
 {
   "id": 10062,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 35,
   "firman": "Siapakah di antara semua allah negeri-negeri yang telah melepaskan negeri mereka dari tanganku, sehingga TUHAN sanggup melepaskan Yerusalem dari tanganku?\""
 },
 {
   "id": 10063,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 36,
   "firman": "Tetapi rakyat itu berdiam diri dan tidak menjawab dia sepatah katapun, sebab ada perintah raja, bunyinya: \"Jangan kamu menjawab dia!\""
 },
 {
   "id": 10064,
   "kitab": "2Ra",
   "pasal": 18,
   "ayat": 37,
   "firman": "Kemudian pergilah Elyakim bin Hilkia, kepala istana, dan Sebna, panitera negara, dan Yoah bin Asaf, bendahara negara, menghadap Hizkia, dengan pakaian yang dikoyakkan, lalu memberitahukan kepadanya perkataan juru minuman agung."
 },
 {
   "id": 10065,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 1,
   "firman": "Segera sesudah raja Hizkia mendengar itu, dikoyakkannyalah pakaiannya dan diselubunginyalah badannya dengan kain kabung, lalu masuklah ia ke rumah TUHAN."
 },
 {
   "id": 10066,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 2,
   "firman": "Disuruhnyalah juga Elyakim, kepala istana, Sebna, panitera negara, dan yang tua-tua di antara para imam, dengan berselubungkan kain kabung, kepada nabi Yesaya bin Amos."
 },
 {
   "id": 10067,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 3,
   "firman": "Berkatalah mereka kepadanya: \"Beginilah kata Hizkia: Hari ini hari kesesakan, hari hukuman dan penistaan; sebab sudah datang waktunya untuk melahirkan anak, tetapi tidak ada kekuatan untuk melahirkannya."
 },
 {
   "id": 10068,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 4,
   "firman": "Mungkin TUHAN, Allahmu, sudah mendengar segala perkataan juru minuman agung yang telah diutus oleh raja Asyur, tuannya, untuk mencela Allah yang hidup, sehingga TUHAN, Allahmu, mau memberi hukuman karena perkataan-perkataan yang telah didengar-Nya. Maka baiklah engkau menaikkan doa untuk sisa yang masih tinggal ini!\""
 },
 {
   "id": 10069,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ketika pegawai-pegawai raja Hizkia sampai kepada Yesaya,"
 },
 {
   "id": 10070,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 6,
   "firman": "berkatalah Yesaya kepada mereka: \"Beginilah kamu katakan kepada tuanmu: Beginilah firman TUHAN: Janganlah engkau takut terhadap perkataan yang kaudengar yang telah diucapkan oleh budak-budak raja Asyur untuk menghujat Aku."
 },
 {
   "id": 10071,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 7,
   "firman": "Sesungguhnya, Aku akan menyuruh suatu roh masuk di dalamnya, sehingga ia mendengar suatu kabar dan pulang ke negerinya; Aku akan membuat dia mati rebah oleh pedang di negerinya sendiri.\""
 },
 {
   "id": 10072,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 8,
   "firman": "Ketika juru minuman agung pulang, didapatinyalah raja Asyur berperang melawan Libna; sebab sudah didengarnya bahwa raja telah berangkat dari Lakhis."
 },
 {
   "id": 10073,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 9,
   "firman": "Dalam pada itu raja mendengar tentang Tirhaka, raja Etiopia, berita yang demikian: \"Sesungguhnya, ia telah keluar berperang melawan engkau,\" maka disuruhnyalah kembali utusan-utusan kepada Hizkia dengan pesan:"
 },
 {
   "id": 10074,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 10,
   "firman": "\"Beginilah harus kamu katakan kepada Hizkia, raja Yehuda: Janganlah Allahmu yang kaupercayai itu memperdayakan engkau dengan menjanjikan: Yerusalem tidak akan diserahkan ke tangan raja Asyur."
 },
 {
   "id": 10075,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 11,
   "firman": "Sesungguhnya, engkau ini telah mendengar tentang yang dilakukan raja-raja Asyur kepada segala negeri, yakni bahwa mereka telah menumpasnya; masakan engkau ini akan dilepaskan?"
 },
 {
   "id": 10076,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 12,
   "firman": "Sudahkah para allah dari bangsa-bangsa, yang telah dimusnahkan oleh nenek moyangku, dapat melepaskan mereka, yakni Gozan, Haran, Rezef dan bani Eden yang di Telasar?"
 },
 {
   "id": 10077,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 13,
   "firman": "Di manakah raja negeri Hamat dan Arpad, raja kota Sefarwaim, raja negeri Hena dan Iwa?\""
 },
 {
   "id": 10078,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 14,
   "firman": "Hizkia menerima surat itu dari tangan para utusan, lalu membacanya; kemudian pergilah ia ke rumah TUHAN dan membentangkan surat itu di hadapan TUHAN."
 },
 {
   "id": 10079,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 15,
   "firman": "Hizkia berdoa di hadapan TUHAN dengan berkata: \"Ya TUHAN, Allah Israel, yang bertakhta di atas kerubim! Hanya Engkau sendirilah Allah segala kerajaan di bumi; Engkaulah yang menjadikan langit dan bumi."
 },
 {
   "id": 10080,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 16,
   "firman": "Sendengkanlah telinga-Mu, ya TUHAN, dan dengarlah; bukalah mata-Mu, ya TUHAN, dan lihatlah; dengarlah perkataan Sanherib yang telah dikirimnya untuk mengaibkan Allah yang hidup."
 },
 {
   "id": 10081,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 17,
   "firman": "Ya TUHAN, memang raja-raja Asyur telah memusnahkan bangsa-bangsa dan negeri-negeri mereka"
 },
 {
   "id": 10082,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 18,
   "firman": "dan menaruh para allah mereka ke dalam api, sebab mereka bukanlah Allah, hanya buatan tangan manusia, kayu dan batu; sebab itu dapat dibinasakan orang."
 },
 {
   "id": 10083,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 19,
   "firman": "Maka sekarang, ya TUHAN, Allah kami, selamatkanlah kiranya kami dari tangannya, supaya segala kerajaan di bumi mengetahui, bahwa hanya Engkau sendirilah Allah, ya TUHAN.\""
 },
 {
   "id": 10084,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 20,
   "firman": "Lalu Yesaya bin Amos menyuruh orang kepada Hizkia mengatakan: \"Beginilah firman TUHAN, Allah Israel: Apa yang telah kaudoakan kepada-Ku mengenai Sanherib, raja Asyur, telah Kudengar."
 },
 {
   "id": 10085,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 21,
   "firman": "Inilah firman yang telah diucapkan TUHAN mengenai dia: Anak dara, yaitu puteri Sion, telah menghina engkau, telah mengolok-olokkan engkau; dan puteri Yerusalem telah geleng-geleng kepala di belakangmu."
 },
 {
   "id": 10086,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 22,
   "firman": "Siapakah yang engkau cela dan engkau hujat? Terhadap siapakah engkau menyaringkan suaramu, dan memandang dengan sombong? Terhadap Yang Mahakudus Allah Israel!"
 },
 {
   "id": 10087,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 23,
   "firman": "Dengan perantaraan utusan-utusanmu engkau telah mencela Tuhan, dan engkau telah berkata: Dengan banyaknya keretaku aku naik ke tempat-tempat tinggi di pegunungan, ke tempat yang paling jauh di gunung Libanon; aku telah menebang pohon-pohon arasnya yang tinggi besar, pohon-pohon sanobarnya yang terpilih; aku telah masuk ke tempat permalaman yang paling ujung, ke hutan pohon-pohonannya yang lebat."
 },
 {
   "id": 10088,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 24,
   "firman": "Aku ini telah menggali air dan telah minum air asing, dan aku telah mengeringkan dengan telapak kakiku segala sungai di Mesir."
 },
 {
   "id": 10089,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 25,
   "firman": "Bukankah telah kaudengar, bahwa Aku telah menentukannya dari jauh hari, dan telah merancangnya pada zaman purbakala? Sekarang Aku mewujudkannya, bahwa engkau membuat sunyi senyap kota-kota yang berkubu menjadi timbunan batu."
 },
 {
   "id": 10090,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 26,
   "firman": "Sedang penduduknya yang tak berdaya menjadi terkejut dan malu; mereka menjadi seperti tumbuh-tumbuhan di padang dan seperti rumput hijau, seperti rumput di atas sotoh, atau gandum yang layu sebelum ia masak."
 },
 {
   "id": 10091,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 27,
   "firman": "Aku tahu, jika engkau bangun atau duduk jika keluar atau masuk, atau jika engkau mengamuk terhadap Aku."
 },
 {
   "id": 10092,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 28,
   "firman": "Oleh karena engkau telah mengamuk terhadap Aku, dan kata-kata keangkuhanmu telah naik sampai ke telinga-Ku, maka Aku akan menaruh kelikir-Ku pada hidungmu dan kekang-Ku pada bibirmu, dan Aku akan memulangkan engkau melalui jalan, dari mana engkau datang."
 },
 {
   "id": 10093,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 29,
   "firman": "Dan inilah yang akan menjadi tanda bagimu, hai Hizkia: Dalam tahun ini orang makan apa yang tumbuh sendiri, dan dalam tahun yang kedua, apa yang tumbuh dari tanaman yang pertama, tetapi dalam tahun yang ketiga, menaburlah kamu, menuai, membuat kebun anggur dan memakan buahnya."
 },
 {
   "id": 10094,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 30,
   "firman": "Dan orang-orang yang terluput di antara kaum Yehuda, yaitu orang-orang yang masih tertinggal, akan berakar pula ke bawah dan menghasilkan buah ke atas."
 },
 {
   "id": 10095,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 31,
   "firman": "Sebab dari Yerusalem akan keluar orang-orang yang tertinggal dan dari gunung Sion orang-orang yang terluput; giat cemburu TUHAN semesta alam akan melakukan hal ini."
 },
 {
   "id": 10096,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 32,
   "firman": "Sebab itu beginilah firman TUHAN mengenai raja Asyur: Ia tidak akan masuk ke kota ini dan tidak akan menembakkan panah ke sana; juga ia tidak akan mendatanginya dengan perisai dan tidak akan menimbun tanah menjadi tembok untuk mengepungnya."
 },
 {
   "id": 10097,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 33,
   "firman": "Melalui jalan, dari mana ia datang, ia akan pulang, tetapi ke kota ini ia tidak akan masuk, demikianlah firman TUHAN."
 },
 {
   "id": 10098,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 34,
   "firman": "Dan Aku akan memagari kota ini untuk menyelamatkannya, oleh karena Aku dan oleh karena Daud, hamba-Ku.\""
 },
 {
   "id": 10099,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 35,
   "firman": "Maka pada malam itu keluarlah Malaikat TUHAN, lalu dibunuh-Nyalah seratus delapan puluh lima ribu orang di dalam perkemahan Asyur. Keesokan harinya pagi-pagi tampaklah, semuanya bangkai orang-orang mati belaka!"
 },
 {
   "id": 10100,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 36,
   "firman": "Sebab itu berangkatlah Sanherib, raja Asyur, dan pulang, lalu tinggallah ia di Niniwe."
 },
 {
   "id": 10101,
   "kitab": "2Ra",
   "pasal": 19,
   "ayat": 37,
   "firman": "Pada suatu kali ketika ia sujud menyembah di dalam kuil Nisrokh, allahnya, maka Adramelekh dan Sarezer, anak-anaknya, membunuh dia dengan pedang, dan mereka meloloskan diri ke tanah Ararat. Kemudian Esarhadon, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10102,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada hari-hari itu Hizkia jatuh sakit dan hampir mati. Lalu datanglah nabi Yesaya bin Amos, dan berkata kepadanya: \"Beginilah firman TUHAN: Sampaikanlah pesan terakhir kepada keluargamu, sebab engkau akan mati, tidak akan sembuh lagi.\""
 },
 {
   "id": 10103,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 2,
   "firman": "Lalu Hizkia memalingkan mukanya ke arah dinding dan ia berdoa kepada TUHAN:"
 },
 {
   "id": 10104,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 3,
   "firman": "\"Ah TUHAN, ingatlah kiranya, bahwa aku telah hidup di hadapan-Mu dengan setia dan dengan tulus hati dan bahwa aku telah melakukan apa yang baik di mata-Mu.\" Kemudian menangislah Hizkia dengan sangat."
 },
 {
   "id": 10105,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 4,
   "firman": "Tetapi Yesaya belum lagi keluar dari pelataran tengah, tiba-tiba datanglah firman TUHAN kepadanya:"
 },
 {
   "id": 10106,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 5,
   "firman": "\"Baliklah dan katakanlah kepada Hizkia, raja umat-Ku: Beginilah firman TUHAN, Allah Daud, bapa leluhurmu: Telah Kudengar doamu dan telah Kulihat air matamu; sesungguhnya Aku akan menyembuhkan engkau; pada hari yang ketiga engkau akan pergi ke rumah TUHAN."
 },
 {
   "id": 10107,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 6,
   "firman": "Aku akan memperpanjang hidupmu lima belas tahun lagi dan Aku akan melepaskan engkau dan kota ini dari tangan raja Asyur; Aku akan memagari kota ini oleh karena Aku dan oleh karena Daud, hamba-Ku.\""
 },
 {
   "id": 10108,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 7,
   "firman": "Kemudian berkatalah Yesaya: \"Ambillah sebuah kue ara!\" Lalu orang mengambilnya dan ditaruh pada barah itu, maka sembuhlah ia."
 },
 {
   "id": 10109,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 8,
   "firman": "Sebelum itu Hizkia telah berkata kepada Yesaya: \"Apakah yang akan menjadi tanda bahwa TUHAN akan menyembuhkan aku dan bahwa aku akan pergi ke rumah TUHAN pada hari yang ketiga?\""
 },
 {
   "id": 10110,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 9,
   "firman": "Yesaya menjawab: \"Inilah yang akan menjadi tanda bagimu dari TUHAN, bahwa TUHAN akan melakukan apa yang telah dijanjikan-Nya: Akan majukah bayang-bayang itu sepuluh tapak atau akan mundur sepuluh tapak?\""
 },
 {
   "id": 10111,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 10,
   "firman": "Hizkia berkata: \"Itu perkara ringan bagi bayang-bayang itu untuk memanjang sepuluh tapak! Sebaliknya, biarlah bayang-bayang itu mundur ke belakang sepuluh tapak.\""
 },
 {
   "id": 10112,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 11,
   "firman": "Lalu berserulah nabi Yesaya kepada TUHAN, maka dibuat-Nyalah bayang-bayang itu mundur ke belakang sepuluh tapak, yang sudah dijalani bayang-bayang itu pada penunjuk matahari buatan Ahas."
 },
 {
   "id": 10113,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 12,
   "firman": "Pada waktu itu Merodakh-Baladan bin Baladan, raja Babel, menyuruh orang membawa surat dan pemberian kepada Hizkia, sebab telah didengarnya bahwa Hizkia sakit tadinya."
 },
 {
   "id": 10114,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 13,
   "firman": "Hizkia bersukacita atas kedatangan mereka, lalu diperlihatkannyalah kepada mereka segenap gedung harta bendanya, emas dan perak, rempah-rempah dan minyak yang berharga, gedung persenjataannya dan segala yang terdapat dalam perbendaharaannya. Tidak ada barang yang tidak diperlihatkan Hizkia kepada mereka di istananya dan di seluruh daerah kekuasaannya."
 },
 {
   "id": 10115,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 14,
   "firman": "Kemudian datanglah nabi Yesaya kepada raja Hizkia dan bertanya kepadanya: \"Apakah yang telah dikatakan orang-orang ini? Dan dari manakah mereka datang?\" Jawab Hizkia: \"Mereka datang dari negeri yang jauh, dari Babel!\""
 },
 {
   "id": 10116,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 15,
   "firman": "Lalu tanyanya lagi: \"Apakah yang telah dilihat mereka di istanamu?\" Jawab Hizkia: \"Semua yang ada di istanaku telah mereka lihat. Tidak ada barang yang tidak kuperlihatkan kepada mereka di perbendaharaanku.\""
 },
 {
   "id": 10117,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 16,
   "firman": "Lalu Yesaya berkata kepada Hizkia: \"Dengarkanlah firman TUHAN!"
 },
 {
   "id": 10118,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 17,
   "firman": "Sesungguhnya, suatu masa akan datang, bahwa segala yang ada dalam istanamu dan yang disimpan oleh nenek moyangmu sampai hari ini akan diangkut ke Babel. Tidak ada barang yang akan ditinggalkan, demikianlah firman TUHAN."
 },
 {
   "id": 10119,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 18,
   "firman": "Dan dari keturunanmu yang akan kauperoleh, akan diambil orang untuk menjadi sida-sida di istana raja Babel.\""
 },
 {
   "id": 10120,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 19,
   "firman": "Hizkia menjawab kepada Yesaya: \"Sungguh baik firman TUHAN yang engkau ucapkan itu!\" Tetapi pikirnya: \"Asal ada damai dan keamanan seumur hidupku!\""
 },
 {
   "id": 10121,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 20,
   "firman": "Selebihnya dari riwayat Hizkia, segala kepahlawanannya dan bagaimana ia membuat kolam dan saluran air dan mengalirkan air ke dalam kota, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 10122,
   "kitab": "2Ra",
   "pasal": 20,
   "ayat": 21,
   "firman": "Kemudian Hizkia mendapat perhentian bersama-sama dengan nenek moyangnya. Maka Manasye, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10123,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 1,
   "firman": "Manasye berumur dua belas tahun pada waktu ia menjadi raja dan lima puluh lima tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Hefzibah."
 },
 {
   "id": 10124,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, sesuai dengan perbuatan keji bangsa-bangsa yang telah dihalau TUHAN dari depan orang Israel."
 },
 {
   "id": 10125,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 3,
   "firman": "Ia mendirikan kembali bukit-bukit pengorbanan yang telah dimusnahkan oleh Hizkia, ayahnya; ia membangun mezbah-mezbah untuk Baal, membuat patung Asyera seperti yang dilakukan Ahab, raja Israel, dan sujud menyembah kepada segenap tentara langit dan beribadah kepadanya."
 },
 {
   "id": 10126,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 4,
   "firman": "Ia mendirikan mezbah-mezbah di rumah TUHAN, walaupun sehubungan dengan rumah itu TUHAN telah berfirman: \"Di Yerusalem Aku akan menaruh nama-Ku!\""
 },
 {
   "id": 10127,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 5,
   "firman": "Dan ia mendirikan juga mezbah-mezbah bagi segenap tentara langit di kedua pelataran rumah TUHAN."
 },
 {
   "id": 10128,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 6,
   "firman": "Bahkan, ia mempersembahkan anaknya sebagai korban dalam api, melakukan ramal dan telaah, dan menghubungi para pemanggil arwah dan para pemanggil roh peramal. Ia melakukan banyak yang jahat di mata TUHAN, sehingga ia menimbulkan sakit hati-Nya."
 },
 {
   "id": 10129,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 7,
   "firman": "Ia menaruh juga patung Asyera yang telah dibuatnya dalam rumah, walaupun sehubungan dengan rumah itu TUHAN telah berfirman kepada Daud dan kepada Salomo, anaknya: \"Dalam rumah ini dan di Yerusalem, yang telah Kupilih dari antara segala suku Israel, Aku akan menaruh nama-Ku untuk selama-lamanya!"
 },
 {
   "id": 10130,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 8,
   "firman": "Aku tidak akan membiarkan bangsa Israel lagi dibawa keluar dari tanah yang telah Kuberikan kepada nenek moyang mereka, asal saja mereka tetap berbuat tepat seperti yang telah Kuperintahkan kepada mereka dan tepat menurut hukum yang telah diperintahkan kepada mereka oleh hamba-Ku Musa.\""
 },
 {
   "id": 10131,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 9,
   "firman": "Tetapi mereka tidak mau mendengarkan, dan Manasye menyesatkan mereka, sehingga mereka melakukan yang jahat lebih dari pada bangsa-bangsa yang telah dipunahkan TUHAN dari hadapan orang Israel."
 },
 {
   "id": 10132,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 10,
   "firman": "Kemudian berfirmanlah TUHAN dengan perantaraan para hamba-Nya, yakni para nabi:"
 },
 {
   "id": 10133,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 11,
   "firman": "\"Oleh karena Manasye, raja Yehuda, telah melakukan kekejian-kekejian ini, berbuat jahat lebih dari pada segala yang telah dilakukan oleh orang Amori yang mendahului dia, dan dengan berhala-berhalanya ia telah mengakibatkan orang Yehuda berdosa pula,"
 },
 {
   "id": 10134,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 12,
   "firman": "sebab itu beginilah firman TUHAN, Allah Israel: Sesungguhnya Aku akan mendatangkan malapetaka atas Yerusalem dan Yehuda, sehingga setiap orang yang mendengarnya akan bising kedua telinganya."
 },
 {
   "id": 10135,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 13,
   "firman": "Dan Aku akan merentangkan atas Yerusalem tali pengukur sama seperti atas Samaria dan tali unting-unting sama seperti atas keluarga Ahab; dan Aku akan menghapuskan Yerusalem seperti orang menghapus pinggan, yakni habis dihapus, dibalikkan pula menungging."
 },
 {
   "id": 10136,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 14,
   "firman": "Aku akan membuangkan sisa milik pusaka-Ku dan akan menyerahkan mereka ke dalam tangan musuh-musuh mereka, sehingga mereka menjadi jarahan dan menjadi rampasan bagi semua musuh mereka,"
 },
 {
   "id": 10137,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 15,
   "firman": "oleh karena mereka telah melakukan apa yang jahat di mata-Ku dan dengan demikian mereka menimbulkan sakit hati-Ku, mulai dari hari nenek moyang mereka keluar dari Mesir sampai hari ini.\""
 },
 {
   "id": 10138,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 16,
   "firman": "Lagipula Manasye mencurahkan darah orang yang tidak bersalah sedemikian banyak, hingga dipenuhinya Yerusalem dari ujung ke ujung, belum termasuk dosa-dosanya yang mengakibatkan orang Yehuda berdosa pula dengan berbuat apa yang jahat di mata TUHAN."
 },
 {
   "id": 10139,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 17,
   "firman": "Selebihnya dari riwayat Manasye, segala yang dilakukannya dan dosa-dosa yang diperbuatnya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 10140,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 18,
   "firman": "Kemudian Manasye mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di taman istananya, di taman Uza. Maka Amon, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10141,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 19,
   "firman": "Amon berumur dua puluh dua tahun pada waktu ia menjadi raja dan dua tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Mesulemet binti Harus, dari Yotba."
 },
 {
   "id": 10142,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 20,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN seperti yang telah dilakukan Manasye, ayahnya."
 },
 {
   "id": 10143,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 21,
   "firman": "Ia hidup sama seperti ayahnya dahulu sambil beribadah kepada berhala-berhala yang disembah oleh ayahnya dan sujud menyembah kepada mereka."
 },
 {
   "id": 10144,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 22,
   "firman": "Ia meninggalkan TUHAN, Allah nenek moyangnya dan tidak hidup menurut kehendak TUHAN."
 },
 {
   "id": 10145,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 23,
   "firman": "Dan pegawai-pegawai Amon mengadakan persepakatan melawan dia dan membunuh raja di istananya."
 },
 {
   "id": 10146,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 24,
   "firman": "Tetapi rakyat negeri itu membunuh semua orang yang mengadakan persepakatan melawan raja Amon; dan rakyat negeri itu mengangkat Yosia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10147,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 25,
   "firman": "Selebihnya dari riwayat Amon, apa yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 10148,
   "kitab": "2Ra",
   "pasal": 21,
   "ayat": 26,
   "firman": "Kemudian ia dikuburkan dalam kuburnya di taman Uza. Maka Yosia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10149,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 1,
   "firman": "Yosia berumur delapan tahun pada waktu ia menjadi raja dan tiga puluh satu tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yedida binti Adaya, dari Bozkat."
 },
 {
   "id": 10150,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 2,
   "firman": "Ia melakukan apa yang benar di mata TUHAN dan hidup sama seperti Daud, bapa leluhurnya, dan tidak menyimpang ke kanan atau ke kiri."
 },
 {
   "id": 10151,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 3,
   "firman": "Dalam tahun yang kedelapan belas zaman raja Yosia maka raja menyuruh Safan bin Azalya bin Mesulam, panitera itu, ke rumah TUHAN, katanya:"
 },
 {
   "id": 10152,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 4,
   "firman": "\"Pergilah kepada imam besar Hilkia; suruhlah ia menyerahkan seluruh uang yang telah dibawa ke dalam rumah TUHAN yang telah dikumpulkan dari pihak rakyat oleh penjaga-penjaga pintu;"
 },
 {
   "id": 10153,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 5,
   "firman": "baiklah itu diberikan mereka ke tangan para pekerja yang diangkat untuk mengawasi rumah TUHAN, supaya diberikan kepada tukang-tukang yang ada di rumah TUHAN untuk memperbaiki kerusakan rumah itu,"
 },
 {
   "id": 10154,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 6,
   "firman": "yaitu kepada tukang-tukang kayu, tukang-tukang bangunan dan tukang-tukang tembok, juga bagi pembelian kayu dan batu pahat untuk memperbaiki rumah itu."
 },
 {
   "id": 10155,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 7,
   "firman": "Tetapi tidak usahlah mengadakan perhitungan dengan mereka mengenai uang yang diberikan ke tangan mereka, sebab mereka bekerja dengan jujur.\""
 },
 {
   "id": 10156,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 8,
   "firman": "Berkatalah imam besar Hilkia, kepada Safan, panitera itu: \"Telah kutemukan kitab Taurat itu di rumah TUHAN!\" Lalu Hilkia memberikan kitab itu kepada Safan, dan Safan terus membacanya."
 },
 {
   "id": 10157,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 9,
   "firman": "Kemudian Safan, panitera itu, masuk menghadap raja, disampaikannyalah kabar tentang itu kepada raja: \"Hamba-hambamu ini telah mengambil seluruh uang yang terdapat di rumah TUHAN dan memberikannya ke tangan para pekerja yang diangkat mengawasi rumah itu.\""
 },
 {
   "id": 10158,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 10,
   "firman": "Safan, panitera itu, memberitahukan juga kepada raja: \"Imam Hilkia telah memberikan kitab kepadaku,\" lalu Safan membacakannya di depan raja."
 },
 {
   "id": 10159,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 11,
   "firman": "Segera sesudah raja mendengar perkataan kitab Taurat itu, dikoyakkannyalah pakaiannya."
 },
 {
   "id": 10160,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 12,
   "firman": "Kemudian raja memberi perintah kepada imam Hilkia, kepada Ahikam bin Safan, kepada Akhbor bin Mikha, kepada Safan, panitera itu, dan kepada Asaya, hamba raja, katanya:"
 },
 {
   "id": 10161,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 13,
   "firman": "\"Pergilah, mintalah petunjuk TUHAN bagiku, bagi rakyat dan bagi seluruh Yehuda, tentang perkataan kitab yang ditemukan ini, sebab hebat kehangatan murka TUHAN yang bernyala-nyala terhadap kita, oleh karena nenek moyang kita tidak mendengarkan perkataan kitab ini dengan berbuat tepat seperti yang tertulis di dalamnya.\""
 },
 {
   "id": 10162,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 14,
   "firman": "Maka pergilah imam Hilkia, Ahikam, Akhbor, Safan dan Asaya kepada nabiah Hulda, isteri seorang yang mengurus pakaian-pakaian, yaitu Salum bin Tikwa bin Harhas; nabiah itu tinggal di Yerusalem, di perkampungan baru. Mereka memberitakan semuanya kepadanya."
 },
 {
   "id": 10163,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 15,
   "firman": "Perempuan itu menjawab mereka: \"Beginilah firman TUHAN, Allah Israel! Katakanlah kepada orang yang menyuruh kamu kepada-Ku!"
 },
 {
   "id": 10164,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 16,
   "firman": "Beginilah firman TUHAN: Sesungguhnya Aku akan mendatangkan malapetaka atas tempat ini dan atas penduduknya, yakni segala perkataan kitab yang telah dibaca oleh raja Yehuda;"
 },
 {
   "id": 10165,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 17,
   "firman": "karena mereka meninggalkan Aku dan membakar korban kepada allah lain dengan maksud menimbulkan sakit hati-Ku dengan segala pekerjaan tangan mereka; sebab itu kehangatan murka-Ku akan bernyala-nyala terhadap tempat ini dengan tidak padam-padam."
 },
 {
   "id": 10166,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 18,
   "firman": "Tetapi kepada raja Yehuda, yang telah menyuruh kamu untuk meminta petunjuk TUHAN, harus kamu katakan demikian: Beginilah firman TUHAN, Allah Israel: Mengenai perkataan yang telah kaudengar itu,"
 },
 {
   "id": 10167,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 19,
   "firman": "oleh karena engkau sudah menyesal dan engkau merendahkan diri di hadapan TUHAN pada waktu engkau mendengar hukuman yang Kufirmankan terhadap tempat ini dan terhadap penduduknya, bahwa mereka akan mendahsyatkan dan menjadi kutuk, dan oleh karena engkau mengoyakkan pakaianmu dan menangis di hadapan-Ku, Akupun telah mendengarnya, demikianlah firman TUHAN,"
 },
 {
   "id": 10168,
   "kitab": "2Ra",
   "pasal": 22,
   "ayat": 20,
   "firman": "sebab itu, sesungguhnya Aku akan mengumpulkan engkau kepada nenek moyangmu, dan engkau akan dikebumikan ke dalam kuburmu dengan damai, dan matamu tidak akan melihat segala malapetaka yang akan Kudatangkan atas tempat ini.\" Lalu mereka menyampaikan jawab itu kepada raja."
 },
 {
   "id": 10169,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 1,
   "firman": "Sesudah itu raja menyuruh orang mengumpulkan semua tua-tua Yehuda dan Yerusalem."
 },
 {
   "id": 10170,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 2,
   "firman": "Kemudian pergilah raja ke rumah TUHAN dan bersama-sama dia semua orang Yehuda dan semua penduduk Yerusalem, para imam, para nabi dan seluruh orang awam, dari yang kecil sampai yang besar. Dengan didengar mereka ia membacakan segala perkataan dari kitab perjanjian yang ditemukan di rumah TUHAN itu."
 },
 {
   "id": 10171,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 3,
   "firman": "Sesudah itu berdirilah raja dekat tiang dan diadakannyalah perjanjian di hadapan TUHAN untuk hidup dengan mengikuti TUHAN, dan tetap menuruti perintah-perintah-Nya, peraturan-peraturan-Nya dan ketetapan-ketetapan-Nya dengan segenap hati dan dengan segenap jiwa dan untuk menepati perkataan perjanjian yang tertulis dalam kitab itu. Dan seluruh rakyat turut mendukung perjanjian itu."
 },
 {
   "id": 10172,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 4,
   "firman": "Raja memberi perintah kepada imam besar Hilkia dan kepada para imam tingkat dua dan kepada para penjaga pintu untuk mengeluarkan dari bait TUHAN segala perkakas yang telah dibuat untuk Baal dan Asyera dan untuk segala tentara langit, lalu dibakarnyalah semuanya itu di luar kota Yerusalem di padang-padang Kidron, dan diangkutnyalah abunya ke Betel."
 },
 {
   "id": 10173,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 5,
   "firman": "Ia memberhentikan para imam dewa asing yang telah diangkat oleh raja-raja Yehuda untuk membakar korban di bukit pengorbanan di kota-kota Yehuda dan di sekitar Yerusalem, juga orang-orang yang membakar korban untuk Baal, untuk dewa matahari, untuk dewa bulan, untuk rasi-rasi bintang dan untuk segenap tentara langit."
 },
 {
   "id": 10174,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 6,
   "firman": "Dibawanyalah tiang-tiang berhala dari rumah TUHAN ke luar kota Yerusalem, ke sungai Kidron, lalu dibakarnya di situ dan ditumbuknya halus-halus menjadi abu, kemudian dicampakkannyalah abunya ke atas kuburan rakyat jelata."
 },
 {
   "id": 10175,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 7,
   "firman": "Ia merobohkan petak-petak pelacuran bakti yang ada di rumah TUHAN, tempat orang-orang perempuan bertenun sarung untuk Asyera."
 },
 {
   "id": 10176,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 8,
   "firman": "Disuruhnyalah datang semua imam dari kota-kota Yehuda, lalu ia menajiskan bukit-bukit pengorbanan, tempat para imam itu membakar korban, dari Geba sampai Bersyeba; dirobohkannya pula bukit-bukit pengorbanan di pintu-pintu gerbang yang ada dekat lobang pintu gerbang Yosua, penguasa kota itu, yang ada pada sebelah kiri kalau orang memasuki pintu gerbang kota itu."
 },
 {
   "id": 10177,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 9,
   "firman": "Tetapi para imam bukit-bukit pengorbanan itu tidak boleh naik ke mezbah TUHAN di Yerusalem, hanya mereka boleh memakan roti yang tidak beragi di tengah-tengah saudara-saudara mereka."
 },
 {
   "id": 10178,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 10,
   "firman": "Ia menajiskan juga Tofet yang ada di lembah Ben-Hinom, supaya jangan orang mempersembahkan anak-anaknya sebagai korban dalam api untuk dewa Molokh."
 },
 {
   "id": 10179,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 11,
   "firman": "Dibuangnyalah kuda-kuda yang ditaruh oleh raja-raja Yehuda untuk dewa matahari di pintu masuk ke rumah TUHAN, dekat bilik Natan-Melekh, pegawai istana, yang tinggal di gedung samping; juga kereta-kereta dewa matahari dibakarnya dengan api."
 },
 {
   "id": 10180,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 12,
   "firman": "Mezbah-mezbah, yang ada di atas sotoh, tempat peranginan Ahas, yang dibuat oleh raja-raja Yehuda, dan mezbah-mezbah, yang dibuat Manasye di kedua pelataran rumah TUHAN, dirobohkan oleh raja, dan diremukkan di sana, lalu dicampakkannya abunya ke sungai Kidron."
 },
 {
   "id": 10181,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 13,
   "firman": "Bukit-bukit pengorbanan yang ada di sebelah timur Yerusalem di sebelah selatan bukit Kebusukan dan yang didirikan oleh Salomo, raja Israel, untuk Asytoret, dewa kejijikan sembahan orang Sidon, dan untuk Kamos, dewa kejijikan sembahan Moab, dan untuk Milkom, dewa kekejian sembahan orang Amon, dinajiskan oleh raja."
 },
 {
   "id": 10182,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 14,
   "firman": "Ia memecahkan tugu-tugu berhala dan menebang tiang-tiang berhala, lalu ditimbuninya tempat-tempat itu penuh dengan tulang-tulang manusia."
 },
 {
   "id": 10183,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 15,
   "firman": "Juga mezbah yang ada di Betel, bukit pengorbanan yang dibuat oleh Yerobeam bin Nebat yang mengakibatkan orang Israel berdosa, mezbah dan bukit pengorbanan itupun dirobohkannya dan batu-batunya dipecahkannya, lalu ditumbuknya halus-halus menjadi abu, dan dibakarnyalah tiang berhala."
 },
 {
   "id": 10184,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 16,
   "firman": "Dan ketika Yosia berpaling, dilihatnyalah kuburan-kuburan yang ada di gunung di sana, lalu menyuruh orang mengambil tulang-tulang dari kuburan-kuburan itu, membakarnya di atas mezbah dan menajiskannya, sesuai dengan firman TUHAN yang telah diserukan oleh abdi Allah yang telah menyerukan hal-hal ini."
 },
 {
   "id": 10185,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 17,
   "firman": "Ia berkata: \"Apakah tanda keramat yang kulihat ini?\" Lalu orang-orang di kota itu menjawab dia: \"Itulah kuburan abdi Allah yang sudah datang dari Yehuda dan yang telah menyerukan segala hal yang telah kaulakukan terhadap mezbah Betel ini!\""
 },
 {
   "id": 10186,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 18,
   "firman": "Lalu katanya: \"Biarkanlah itu, janganlah ada orang yang menjamah tulang-tulangnya!\" Jadi mereka tidak mengganggu tulang-tulangnya dan tulang-tulang nabi yang telah datang dari Samaria itu."
 },
 {
   "id": 10187,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 19,
   "firman": "Juga segala kuil di bukit-bukit pengorbanan yang di kota-kota Samaria yang dibuat oleh raja-raja Israel untuk menimbulkan sakit hati TUHAN, dijauhkan oleh Yosia dan dalam hal ini ia bertindak tepat seperti tindakannya di Betel."
 },
 {
   "id": 10188,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 20,
   "firman": "Ia menyembelih di atas mezbah-mezbah itu semua imam bukit-bukit pengorbanan yang ada di sana dan dibakarnya tulang-tulang manusia di atasnya, lalu pulanglah ia ke Yerusalem."
 },
 {
   "id": 10189,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 21,
   "firman": "Kemudian raja memberi perintah kepada seluruh bangsa itu: \"Rayakanlah Paskah bagi TUHAN, Allahmu, seperti yang tertulis dalam kitab perjanjian ini!\""
 },
 {
   "id": 10190,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 22,
   "firman": "Sebab tidak pernah lagi dirayakan Paskah seperti itu sejak zaman para hakim yang memerintah atas Israel dan sepanjang zaman raja-raja Israel dan raja-raja Yehuda."
 },
 {
   "id": 10191,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 23,
   "firman": "Tetapi barulah dalam tahun kedelapan belas zaman raja Yosia Paskah ini dirayakan bagi TUHAN di Yerusalem."
 },
 {
   "id": 10192,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 24,
   "firman": "Para pemanggil arwah, dan para pemanggil roh peramal, juga terafim, berhala-berhala dan segala dewa kejijikan yang terlihat di tanah Yehuda dan di Yerusalem, dihapuskan oleh Yosia dengan maksud menepati perkataan Taurat yang tertulis dalam kitab yang telah didapati oleh imam Hilkia di rumah TUHAN."
 },
 {
   "id": 10193,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 25,
   "firman": "Sebelum dia tidak ada raja seperti dia yang berbalik kepada TUHAN dengan segenap hatinya, dengan segenap jiwanya dan dengan segenap kekuatannya, sesuai dengan segala Taurat Musa; dan sesudah dia tidak ada bangkit lagi yang seperti dia."
 },
 {
   "id": 10194,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 26,
   "firman": "Tetapi TUHAN tidak beralih dari murka-Nya yang sangat bernyala-nyala itu yang telah bangkit terhadap Yehuda oleh karena segala sakit hati-Nya yang ditimbulkan Manasye."
 },
 {
   "id": 10195,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 27,
   "firman": "Lalu berfirmanlah TUHAN: \"Juga orang Yehuda akan Kujauhkan dari hadapan-Ku seperti Aku menjauhkan orang Israel, dan Aku akan membuang kota yang Kupilih ini, yakni Yerusalem, dan rumah ini, walaupun Aku telah berfirman tentangnya: Nama-Ku akan tinggal di sana!\""
 },
 {
   "id": 10196,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 28,
   "firman": "Selebihnya dari riwayat Yosia dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 10197,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 29,
   "firman": "Dalam zamannya itu majulah Firaun Nekho, raja Mesir, melawan raja Asyur di tepi sungai Efrat; raja Yosia pergi menghadapi dia; tetapi Firaun membunuhnya di Megido, segera sesudah ia melihatnya."
 },
 {
   "id": 10198,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 30,
   "firman": "Pegawai-pegawainya mengangkut mayatnya dengan kereta dari Megido dan membawanya ke Yerusalem, kemudian mereka menguburkannya dalam kuburnya sendiri. Maka rakyat negeri itu menjemput Yoahas, anak Yosia, mengurapi dia dan mengangkat dia menjadi raja menggantikan ayahnya."
 },
 {
   "id": 10199,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 31,
   "firman": "Yoahas berumur dua puluh tiga tahun pada waktu ia menjadi raja dan tiga bulan lamanya ia memerintah di Yerusalem. Nama ibunya ialah Hamutal binti Yeremia, dari Libna."
 },
 {
   "id": 10200,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 32,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN tepat seperti yang dilakukan oleh nenek moyangnya."
 },
 {
   "id": 10201,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 33,
   "firman": "Firaun Nekho mengurung dia di Ribla, di tanah Hamat, supaya jangan ia memerintah di Yerusalem; lagi Firaun membebankan kepada negeri itu denda sebesar seratus talenta perak dan sepuluh talenta emas."
 },
 {
   "id": 10202,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 34,
   "firman": "Firaun Nekho mengangkat Elyakim, anak Yosia, menjadi raja menggantikan Yosia, ayahnya, dan menukar namanya dengan Yoyakim. Tetapi Yoahas dibawanya; Yoahas tiba di Mesir dan mati di sana."
 },
 {
   "id": 10203,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 35,
   "firman": "Yoyakim memberi emas dan perak itu kepada Firaun, tetapi ia menarik pajak dari negeri supaya dapat memberi uang itu, sesuai dengan titah Firaun. Ia menagih emas dan perak itu dari rakyat negeri, dari setiap orang menurut jumlah ketetapan pajaknya, untuk memberikannya kepada Firaun Nekho."
 },
 {
   "id": 10204,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 36,
   "firman": "Yoyakim berumur dua puluh lima tahun pada waktu ia menjadi raja dan sebelas tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Zebuda binti Pedaya, dari Ruma."
 },
 {
   "id": 10205,
   "kitab": "2Ra",
   "pasal": 23,
   "ayat": 37,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN tepat seperti yang dilakukan oleh nenek moyangnya."
 },
 {
   "id": 10206,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 1,
   "firman": "Dalam zamannya majulah berperang Nebukadnezar, raja Babel, lalu Yoyakim menjadi takluk kepadanya tiga tahun lamanya; tetapi kemudian Yoyakim berbalik dan memberontak terhadap dia."
 },
 {
   "id": 10207,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 2,
   "firman": "TUHAN menyuruh gerombolan-gerombolan Kasdim, gerombolan-gerombolan Aram, gerombolan-gerombolan Moab dan gerombolan-gerombolan bani Amon melawan Yoyakim; Ia menyuruh mereka melawan Yehuda untuk membinasakannya sesuai dengan firman TUHAN yang diucapkan-Nya dengan perantaraan para hamba-Nya, yaitu para nabi."
 },
 {
   "id": 10208,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 3,
   "firman": "Sungguh, hal itu terjadi kepada Yehuda sesuai dengan titah TUHAN untuk menjauhkan mereka dari hadapan-Nya oleh karena dosa-dosa Manasye, setimpal dengan segala yang dilakukannya,"
 },
 {
   "id": 10209,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 4,
   "firman": "dan juga oleh karena darah orang yang tidak bersalah yang telah ditumpahkannya, sebab ia telah membuat Yerusalem penuh dengan darah orang yang tidak bersalah, dan TUHAN tidak mau mengampuninya."
 },
 {
   "id": 10210,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 5,
   "firman": "Selebihnya dari riwayat Yoyakim dan segala yang dilakukannya, bukankah semuanya itu tertulis dalam kitab sejarah raja-raja Yehuda?"
 },
 {
   "id": 10211,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 6,
   "firman": "Kemudian Yoyakim mendapat perhentian bersama-sama dengan nenek moyangnya, maka Yoyakhin, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 10212,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 7,
   "firman": "Raja Mesir tidak lagi keluar berperang dari negerinya, sebab raja Babel telah merebut segala yang termasuk wilayah raja Mesir mulai dari sungai Mesir sampai ke sungai Efrat."
 },
 {
   "id": 10213,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 8,
   "firman": "Yoyakhin berumur delapan belas tahun pada waktu ia menjadi raja dan tiga bulan lamanya ia memerintah di Yerusalem. Nama ibunya ialah Nehusta binti Elnatan, dari Yerusalem."
 },
 {
   "id": 10214,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 9,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN tepat seperti yang dilakukan ayahnya."
 },
 {
   "id": 10215,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 10,
   "firman": "Pada waktu itu majulah orang-orang Nebukadnezar, raja Babel, menyerang Yerusalem dan kota itu dikepung."
 },
 {
   "id": 10216,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 11,
   "firman": "Juga Nebukadnezar, raja Babel, datang menyerang kota itu, sedang orang-orangnya mengepungnya."
 },
 {
   "id": 10217,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 12,
   "firman": "Lalu keluarlah Yoyakhin, raja Yehuda, mendapatkan raja Babel, ia sendiri, ibunya, pegawai-pegawainya, para pembesarnya dan pegawai-pegawai istananya. Raja Babel menangkap dia pada tahun yang kedelapan dari pemerintahannya."
 },
 {
   "id": 10218,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 13,
   "firman": "Ia mengeluarkan dari sana segala barang perbendaharaan rumah TUHAN dan barang-barang perbendaharaan istana raja; juga dikeratnya emas dari segala perkakas emas yang dibuat oleh Salomo, raja Israel, di bait TUHAN seperti yang telah difirmankan TUHAN."
 },
 {
   "id": 10219,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 14,
   "firman": "Ia mengangkut seluruh penduduk Yerusalem ke dalam pembuangan, semua panglima dan semua pahlawan yang gagah perkasa, sepuluh ribu orang tawanan, juga semua tukang dan pandai besi; tidak ada yang ditinggalkan kecuali orang-orang lemah dari rakyat negeri."
 },
 {
   "id": 10220,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 15,
   "firman": "Ia mengangkut Yoyakhin ke dalam pembuangan ke Babel, juga ibunda raja, isteri-isteri raja, pegawai-pegawai istananya dan orang-orang berkuasa di negeri itu dibawanya sebagai orang buangan dari Yerusalem ke Babel."
 },
 {
   "id": 10221,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 16,
   "firman": "Semua orang yang gagah perkasa, tujuh ribu orang banyaknya, para tukang dan para pandai besi, seribu orang banyaknya, sekalian pahlawan yang sanggup berperang, dibawa oleh raja Babel sebagai orang buangan ke Babel."
 },
 {
   "id": 10222,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 17,
   "firman": "Kemudian raja Babel mengangkat Matanya, paman Yoyakhin, menjadi raja menggantikan dia dan menukar namanya menjadi Zedekia."
 },
 {
   "id": 10223,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 18,
   "firman": "Zedekia berumur dua puluh satu tahun pada waktu ia menjadi raja dan sebelas tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Hamutal binti Yeremia, dari Libna."
 },
 {
   "id": 10224,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 19,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN tepat seperti yang dilakukan Yoyakim."
 },
 {
   "id": 10225,
   "kitab": "2Ra",
   "pasal": 24,
   "ayat": 20,
   "firman": "Sebab oleh karena murka Tuhanlah terjadi hal itu terhadap Yerusalem dan Yehuda, yakni bahwa Ia sampai membuang mereka dari hadapan-Nya. Zedekia memberontak terhadap raja Babel."
 },
 {
   "id": 10226,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 1,
   "firman": "Maka pada tahun kesembilan dari pemerintahannya, dalam bulan yang kesepuluh, pada tanggal sepuluh bulan itu, datanglah Nebukadnezar, raja Babel, dengan segala tentaranya menyerang Yerusalem. Ia berkemah mengepungnya dan mendirikan tembok pengepungan sekelilingnya."
 },
 {
   "id": 10227,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 2,
   "firman": "Demikianlah kota itu terkepung sampai tahun yang kesebelas zaman raja Zedekia."
 },
 {
   "id": 10228,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 3,
   "firman": "Pada tanggal sembilan bulan yang keempat, ketika kelaparan sudah merajalela di kota itu dan tidak ada lagi makanan pada rakyat negeri itu,"
 },
 {
   "id": 10229,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 4,
   "firman": "maka dibelah oranglah tembok kota itu dan semua tentara melarikan diri malam-malam melalui pintu gerbang antara kedua tembok yang ada di dekat taman raja, sekalipun orang Kasdim mengepung kota itu sekeliling. Mereka lari menuju ke Araba-Yordan."
 },
 {
   "id": 10230,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 5,
   "firman": "Tetapi tentara Kasdim mengejar raja dari belakang dan mencapai dia di dataran Yerikho; segala tentaranya telah berserak-serak meninggalkan dia."
 },
 {
   "id": 10231,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 6,
   "firman": "Mereka menangkap raja dan membawa dia kepada raja Babel di Ribla, yang menjatuhkan hukuman atas dia."
 },
 {
   "id": 10232,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 7,
   "firman": "Orang menyembelih anak-anak Zedekia di depan matanya, kemudian dibutakannyalah mata Zedekia, lalu dia dibelenggu dengan rantai tembaga dan dibawa ke Babel."
 },
 {
   "id": 10233,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 8,
   "firman": "Dalam bulan yang kelima pada tanggal tujuh bulan itu--itulah tahun kesembilan belas zaman raja Nebukadnezar, raja Babel--datanglah Nebuzaradan, kepala pasukan pengawal, pegawai raja Babel, ke Yerusalem."
 },
 {
   "id": 10234,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 9,
   "firman": "Ia membakar rumah TUHAN, rumah raja dan semua rumah di Yerusalem; semua rumah orang-orang besar dibakarnya dengan api."
 },
 {
   "id": 10235,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 10,
   "firman": "Tembok sekeliling kota Yerusalem dirobohkan oleh semua tentara Kasdim yang ada bersama-sama dengan kepala pasukan pengawal itu."
 },
 {
   "id": 10236,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 11,
   "firman": "Sisa-sisa rakyat yang masih tinggal di kota itu dan para pembelot yang menyeberang ke pihak raja Babel dan sisa-sisa khalayak ramai diangkut ke dalam pembuangan oleh Nebuzaradan, kepala pasukan pengawal itu."
 },
 {
   "id": 10237,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 12,
   "firman": "Hanya beberapa orang miskin dari negeri itu ditinggalkan oleh kepala pasukan pengawal itu untuk menjadi tukang-tukang kebun anggur dan peladang-peladang."
 },
 {
   "id": 10238,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 13,
   "firman": "Juga tiang-tiang tembaga yang ada di rumah TUHAN dan kereta penopang dan \"laut\" tembaga yang ada di rumah TUHAN dipecahkan oleh orang Kasdim dan tembaganya diangkut mereka ke Babel."
 },
 {
   "id": 10239,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 14,
   "firman": "Kuali-kuali, penyodok-penyodok, pisau-pisau dan cawan-cawan dan segala perkakas tembaga yang dipakai untuk menyelenggarakan kebaktian, diambil mereka,"
 },
 {
   "id": 10240,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 15,
   "firman": "juga perbaraan-perbaraan dan bokor-bokor penyiraman, baik segala yang dari emas maupun segala yang dari perak, diambil oleh kepala pasukan pengawal itu."
 },
 {
   "id": 10241,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 16,
   "firman": "Adapun kedua tiang, \"laut\" yang satu itu, kereta penopang yang dibuat oleh Salomo untuk rumah TUHAN, tiada tertimbang tembaga segala perkakas ini."
 },
 {
   "id": 10242,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 17,
   "firman": "Delapan belas hasta tingginya tiang yang satu, dan di atasnya ada ganja dari tembaga; tinggi ganja itu tiga hasta dan jala-jala dan buah-buah delima ada di atas ganja itu sekeliling, semuanya itu tembaga. Dan seperti itu juga tiang yang kedua, disertai jala-jala."
 },
 {
   "id": 10243,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 18,
   "firman": "Lalu kepala pasukan pengawal itu menangkap Seraya, imam kepala, dan Zefanya, imam tingkat dua dan ketiga orang penjaga pintu."
 },
 {
   "id": 10244,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 19,
   "firman": "Dari kota itu ditangkapnya seorang pegawai istana yang diangkat mengepalai tentara, dan lima orang pelayan pribadi raja yang terdapat di kota itu, dan panitera panglima tentara yang mengerahkan rakyat negeri menjadi tentara, dan enam puluh orang dari rakyat negeri yang terdapat di kota itu."
 },
 {
   "id": 10245,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 20,
   "firman": "Nebuzaradan, kepala pasukan pengawal, menangkap mereka dan membawa mereka kepada raja Babel, di Ribla."
 },
 {
   "id": 10246,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 21,
   "firman": "Lalu raja Babel menyuruh membunuh mereka di Ribla, di tanah Hamat. Demikianlah orang Yehuda diangkut ke dalam pembuangan dari tanahnya."
 },
 {
   "id": 10247,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 22,
   "firman": "Tentang rakyat yang masih tinggal di tanah Yehuda yang ditinggalkan oleh Nebukadnezar, raja Babel, diangkatnyalah atas mereka Gedalya bin Ahikam bin Safan."
 },
 {
   "id": 10248,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 23,
   "firman": "Ketika semua panglima tentara dengan orang-orangnya mendengar bahwa raja Babel telah mengangkat Gedalya, maka pergilah mereka kepada Gedalya, ke Mizpa, yaitu Ismael bin Netanya, Yohanan bin Kareah, Seraya bin Tanhumet, orang Netofa itu, dan Yaazanya, anak seorang Maakha, bersama dengan anak buahnya."
 },
 {
   "id": 10249,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 24,
   "firman": "Lalu bersumpahlah Gedalya kepada mereka dan anak buah mereka, katanya kepada mereka: \"Janganlah kamu takut terhadap pegawai-pegawai orang Kasdim itu; tinggallah di negeri ini dan takluklah kepada raja Babel, maka keadaanmu akan menjadi baik.\""
 },
 {
   "id": 10250,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 25,
   "firman": "Tetapi dalam bulan yang ketujuh datanglah Ismael bin Netanya bin Elisama, seorang yang asalnya dari keturunan raja, dan sepuluh orang bersama-sama dengan dia; mereka membunuh Gedalya dan orang-orang Yehuda dan orang-orang Kasdim yang ada bersama-sama dengan dia di Mizpa."
 },
 {
   "id": 10251,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 26,
   "firman": "Maka bangkitlah seluruh rakyat, dari yang kecil sampai yang besar, serta panglima-panglima tentara, lalu larilah mereka ke Mesir, sebab mereka takut terhadap orang Kasdim itu."
 },
 {
   "id": 10252,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 27,
   "firman": "Kemudian dalam tahun ketiga puluh tujuh sesudah Yoyakhin, raja Yehuda dibuang, dalam bulan yang kedua belas, pada tanggal dua puluh tujuh bulan itu, maka Ewil-Merodakh, raja Babel, dalam tahun ia menjadi raja, menunjukkan belas kasihannya kepada Yoyakhin, raja Yehuda, dengan melepaskannya dari penjara."
 },
 {
   "id": 10253,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 28,
   "firman": "Ewil-Merodakh berbicara baik-baik dengan dia dan memberi kedudukan kepadanya lebih tinggi dari pada kedudukan raja-raja yang bersama-sama dengan dia di Babel;"
 },
 {
   "id": 10254,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 29,
   "firman": "ia boleh mengganti pakaian penjaranya dan boleh selalu makan roti di hadapan raja selama hidupnya."
 },
 {
   "id": 10255,
   "kitab": "2Ra",
   "pasal": 25,
   "ayat": 30,
   "firman": "Dan tentang belanjanya, raja selalu memberikannya kepadanya, sekadar yang perlu tiap-tiap hari, selama hidupnya."
 },
 {
   "id": 10256,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 1,
   "firman": "Adam, Set, Enos,"
 },
 {
   "id": 10257,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kenan, Mahalaleel, Yared,"
 },
 {
   "id": 10258,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 3,
   "firman": "Henokh, Metusalah, Lamekh,"
 },
 {
   "id": 10259,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 4,
   "firman": "Nuh, Sem, Ham dan Yafet."
 },
 {
   "id": 10260,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 5,
   "firman": "Keturunan Yafet ialah Gomer, Magog, Madai, Yawan, Tubal, Mesekh dan Tiras."
 },
 {
   "id": 10261,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 6,
   "firman": "Keturunan Gomer ialah Askenas, Difat dan Togarma."
 },
 {
   "id": 10262,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 7,
   "firman": "Keturunan Yawan ialah Elisa, Tarsis, orang Kitim dan orang Rodanim."
 },
 {
   "id": 10263,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 8,
   "firman": "Keturunan Ham ialah Kush, Misraim, Put dan Kanaan."
 },
 {
   "id": 10264,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 9,
   "firman": "Keturunan Kush ialah Seba, Hawila, Sabta, Raema dan Sabtekha; keturunan Raema ialah Syeba dan Dedan."
 },
 {
   "id": 10265,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 10,
   "firman": "Kush memperanakkan Nimrod; dialah orang yang mula-mula sekali berkuasa di bumi."
 },
 {
   "id": 10266,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 11,
   "firman": "Misraim memperanakkan orang Ludim, orang Anamim, orang Lehabim, orang Naftuhim,"
 },
 {
   "id": 10267,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 12,
   "firman": "orang Patrusim, orang Kasluhim--dari mereka inilah berasal orang Filistin--dan orang Kaftorim."
 },
 {
   "id": 10268,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kanaan memperanakkan Sidon, anak sulungnya dan Het,"
 },
 {
   "id": 10269,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 14,
   "firman": "serta orang Yebusi, orang Amori, orang Girgasi,"
 },
 {
   "id": 10270,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 15,
   "firman": "orang Hewi, orang Arki, orang Sini,"
 },
 {
   "id": 10271,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 16,
   "firman": "orang Arwadi, orang Semari dan orang Hamati."
 },
 {
   "id": 10272,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 17,
   "firman": "Keturunan Sem ialah Elam, Asyur, Arpakhsad, Lud, Aram, Us, Hul, Geter dan Mesekh."
 },
 {
   "id": 10273,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 18,
   "firman": "Arpakhsad memperanakkan Selah, dan Selah memperanakkan Eber."
 },
 {
   "id": 10274,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 19,
   "firman": "Bagi Eber lahir dua anak laki-laki; nama yang seorang ialah Peleg, sebab dalam zamannya penduduk bumi terbagi, dan nama adiknya ialah Yoktan."
 },
 {
   "id": 10275,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 20,
   "firman": "Yoktan memperanakkan Almodad, Selef, Hazar-Mawet, Yerah,"
 },
 {
   "id": 10276,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 21,
   "firman": "Hadoram, Uzal, Dikla,"
 },
 {
   "id": 10277,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 22,
   "firman": "Ebal, Abimael, Syeba,"
 },
 {
   "id": 10278,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 23,
   "firman": "Ofir, Hawila dan Yobab; itulah semuanya anak-anak Yoktan."
 },
 {
   "id": 10279,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 24,
   "firman": "Sem, Arpakhsad, Selah,"
 },
 {
   "id": 10280,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 25,
   "firman": "Eber, Peleg, Rehu,"
 },
 {
   "id": 10281,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 26,
   "firman": "Serug, Nahor, Terah,"
 },
 {
   "id": 10282,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 27,
   "firman": "Abram, itulah Abraham."
 },
 {
   "id": 10283,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 28,
   "firman": "Anak-anak Abraham ialah Ishak dan Ismael."
 },
 {
   "id": 10284,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 29,
   "firman": "Inilah keturunan mereka: anak sulung Ismael ialah Nebayot, lalu Kedar, Adbeel, Mibsam,"
 },
 {
   "id": 10285,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 30,
   "firman": "Misyma, Duma, Masa, Hadad, Tema,"
 },
 {
   "id": 10286,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 31,
   "firman": "Yetur, Nafish dan Kedma; mereka itulah anak-anak Ismael."
 },
 {
   "id": 10287,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 32,
   "firman": "Keturunan Ketura, gundik Abraham: perempuan itu melahirkan Zimran, Yoksan, Medan, Midian, Isybak dan Suah. Anak-anak Yoksan ialah Syeba dan Dedan."
 },
 {
   "id": 10288,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 33,
   "firman": "Anak-anak Midian ialah: Efa, Efer, Hanokh, Abida dan Eldaa. Itulah semuanya keturunan Ketura."
 },
 {
   "id": 10289,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 34,
   "firman": "Abraham memperanakkan Ishak. Anak-anak Ishak ialah Esau dan Israel."
 },
 {
   "id": 10290,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 35,
   "firman": "Anak-anak Esau ialah Elifas, Rehuel, Yeush, Yaelam dan Korah."
 },
 {
   "id": 10291,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 36,
   "firman": "Anak-anak Elifas ialah Teman, Omar, Zefi, Gaetam, Kenas, Timna dan Amalek."
 },
 {
   "id": 10292,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 37,
   "firman": "Anak-anak Rehuel ialah Nahat, Zerah, Syama dan Miza."
 },
 {
   "id": 10293,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 38,
   "firman": "Anak-anak Seir ialah Lotan, Syobal, Zibeon, Ana, Disyon, Ezer dan Disyan."
 },
 {
   "id": 10294,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 39,
   "firman": "Anak-anak Lotan ialah Hori dan Homam; adik perempuan Lotan ialah Timna."
 },
 {
   "id": 10295,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 40,
   "firman": "Anak-anak Syobal ialah Alyan, Manahat, Ebal, Syefi dan Onam; anak-anak Zibeon ialah Aya dan Ana."
 },
 {
   "id": 10296,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 41,
   "firman": "Keturunan Ana ialah Disyon; anak-anak Disyon ialah Hamran, Esyban, Yitran dan Keran."
 },
 {
   "id": 10297,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 42,
   "firman": "Anak-anak Ezer ialah Bilhan, Zaawan dan Yaakan. Anak-anak Disyan ialah Us dan Aran."
 },
 {
   "id": 10298,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 43,
   "firman": "Inilah raja-raja yang memerintah di tanah Edom, sebelum seorang raja dari orang Israel memerintah: Bela bin Beor, dan kotanya bernama Dinhaba."
 },
 {
   "id": 10299,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 44,
   "firman": "Setelah Bela mati, Yobab bin Zerah, dari Bozra, menjadi raja menggantikan dia."
 },
 {
   "id": 10300,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 45,
   "firman": "Setelah Yobab mati, Husyam, dari negeri orang Teman, menjadi raja menggantikan dia."
 },
 {
   "id": 10301,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 46,
   "firman": "Setelah Husyam mati, Hadad bin Bedad menjadi raja menggantikan dia; dialah yang memukul kalah orang Midian di daerah Moab, dan kotanya bernama Awit."
 },
 {
   "id": 10302,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 47,
   "firman": "Setelah Hadad mati, Samla, dari Masyreka menjadi raja menggantikan dia."
 },
 {
   "id": 10303,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 48,
   "firman": "Setelah Samla mati, Saul, dari Rehobot-Sungai, menjadi raja menggantikan dia."
 },
 {
   "id": 10304,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 49,
   "firman": "Setelah Saul mati, Baal-Hanan bin Akhbor menjadi raja menggantikan dia."
 },
 {
   "id": 10305,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 50,
   "firman": "Setelah Baal-Hanan mati, Hadad menjadi raja menggantikan dia, dan kotanya bernama Pahi dan isterinya bernama Mehetabeel binti Matred binti Mezahab."
 },
 {
   "id": 10306,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 51,
   "firman": "Setelah Hadad mati, maka yang menjadi kepala-kepala kaum di Edom ialah kepala kaum Timna, kepala kaum Alya, kepala kaum Yetet,"
 },
 {
   "id": 10307,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 52,
   "firman": "kepala kaum Oholibama, kepala kaum Ela, kepala kaum Pinon,"
 },
 {
   "id": 10308,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 53,
   "firman": "kepala kaum Kenas, kepala kaum Teman, kepala kaum Mibzar,"
 },
 {
   "id": 10309,
   "kitab": "1Ta",
   "pasal": 1,
   "ayat": 54,
   "firman": "kepala kaum Magdiel dan kepala kaum Iram. Itulah kepala-kepala kaum di Edom."
 },
 {
   "id": 10310,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 1,
   "firman": "Inilah anak-anak Israel: Ruben, Simeon, Lewi, Yehuda, Isakhar, Zebulon,"
 },
 {
   "id": 10311,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 2,
   "firman": "Dan, Yusuf, Benyamin, Naftali, Gad dan Asyer."
 },
 {
   "id": 10312,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 3,
   "firman": "Anak-anak Yehuda ialah Er, Onan dan Syela, tiga orang, yang lahir bagi dia dari anak perempuan Syua perempuan Kanaan itu. Tetapi Er, anak sulung Yehuda itu, adalah jahat di mata TUHAN, maka Ia membunuhnya."
 },
 {
   "id": 10313,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 4,
   "firman": "Tamar, menantu perempuan Yehuda, melahirkan baginya Peres dan Zerah. Semuanya anak-anak Yehuda ada lima orang."
 },
 {
   "id": 10314,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 5,
   "firman": "Anak-anak Peres ialah Hezron dan Hamul."
 },
 {
   "id": 10315,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 6,
   "firman": "Anak-anak Zerah ialah Zimri, Etan, Heman, Kalkol dan Dara. Semuanya lima orang."
 },
 {
   "id": 10316,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 7,
   "firman": "Keturunan Karmi ialah Ahar, yang mencelakakan orang Israel karena ia tidak taat dalam hal barang-barang yang dikhususkan itu."
 },
 {
   "id": 10317,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 8,
   "firman": "Keturunan Etan ialah Azarya."
 },
 {
   "id": 10318,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 9,
   "firman": "Anak-anak yang lahir bagi Hezron ialah Yerahmeel, Ram dan Khelubai."
 },
 {
   "id": 10319,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ram memperanakkan Aminadab, dan Aminadab memperanakkan Nahason, pemimpin bani Yehuda."
 },
 {
   "id": 10320,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 11,
   "firman": "Nahason memperanakkan Salma dan Salma memperanakkan Boas."
 },
 {
   "id": 10321,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 12,
   "firman": "Boas memperanakkan Obed dan Obed memperanakkan Isai."
 },
 {
   "id": 10322,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 13,
   "firman": "Isai memperanakkan Eliab, anak sulungnya, dan Abinadab, anak yang kedua, Simea, anak yang ketiga,"
 },
 {
   "id": 10323,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 14,
   "firman": "Netaneel, anak yang keempat, Radai, anak yang kelima,"
 },
 {
   "id": 10324,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ozem, anak yang keenam, dan Daud, anak yang ketujuh;"
 },
 {
   "id": 10325,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 16,
   "firman": "saudara-saudara perempuan mereka ialah Zeruya dan Abigail. Anak-anak Zeruya ialah Abisai, Yoab dan Asael, tiga orang."
 },
 {
   "id": 10326,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 17,
   "firman": "Abigail melahirkan Amasa dan ayah Amasa ialah Yeter, orang Ismael itu."
 },
 {
   "id": 10327,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 18,
   "firman": "Kaleb bin Hezron memperanakkan Yeriot dari Azuba, isterinya; dan inilah anak-anak perempuan itu: Yesyer, Sobab dan Ardon."
 },
 {
   "id": 10328,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 19,
   "firman": "Sesudah Azuba mati, Kaleb mengawini Efrat yang melahirkan Hur baginya."
 },
 {
   "id": 10329,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 20,
   "firman": "Hur memperanakkan Uri dan Uri memperanakkan Bezaleel."
 },
 {
   "id": 10330,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 21,
   "firman": "Sesudah itu Hezron menghampiri anak perempuan Makhir, bapa Gilead. Ia mengawini perempuan itu ketika ia berumur enam puluh tahun. Perempuan itu melahirkan Segub baginya."
 },
 {
   "id": 10331,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 22,
   "firman": "Segub memperanakkan Yair yang mempunyai dua puluh tiga perkampungan di tanah Gilead."
 },
 {
   "id": 10332,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 23,
   "firman": "Tetapi Gesur dan Aram merebut Hawot-Yair dari pada mereka, juga Kenat dan tempat-tempat jajahannya, enam puluh perkampungan. Itulah semuanya keturunan Makhir, bapa Gilead."
 },
 {
   "id": 10333,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 24,
   "firman": "Sesudah Hezron mati, Kaleb menghampiri Efrata--dia adalah isteri Hezron, ayahnya--maka perempuan itu melahirkan baginya Asyhur, bapa Tekoa."
 },
 {
   "id": 10334,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 25,
   "firman": "Anak-anak Yerahmeel, anak sulung Hezron, ialah Ram, anak sulung, Buna, Oren, Ozem dan Ahia."
 },
 {
   "id": 10335,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 26,
   "firman": "Tetapi Yerahmeel mempunyai seorang isteri lain, bernama Atara; dialah ibu Onam."
 },
 {
   "id": 10336,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 27,
   "firman": "Anak-anak Ram, anak sulung Yerahmeel, ialah Maas, Yamin dan Eker."
 },
 {
   "id": 10337,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 28,
   "firman": "Anak-anak Onam ialah Samai dan Yada, dan anak-anak Samai ialah Nadab dan Abisur."
 },
 {
   "id": 10338,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 29,
   "firman": "Nama isteri Abisur ialah Abihail yang melahirkan Ahban dan Molid baginya."
 },
 {
   "id": 10339,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 30,
   "firman": "Anak-anak Nadab ialah Seled dan Apaim; Seled mati dengan tidak mempunyai anak."
 },
 {
   "id": 10340,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 31,
   "firman": "Keturunan Apaim ialah Yisei, dan keturunan Yisei ialah Sesan, dan keturunan Sesan ialah Ahlai."
 },
 {
   "id": 10341,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 32,
   "firman": "Anak-anak Yada, adik Samai, ialah Yeter dan Yonatan; Yeter mati dengan tidak mempunyai anak."
 },
 {
   "id": 10342,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 33,
   "firman": "Anak-anak Yonatan ialah Pelet dan Zaza. Itulah keturunan Yerahmeel."
 },
 {
   "id": 10343,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 34,
   "firman": "Sesan tidak mempunyai anak laki-laki, hanya anak-anak perempuan; tetapi Sesan mempunyai seorang budak laki-laki, orang Mesir, yang bernama Yarha."
 },
 {
   "id": 10344,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 35,
   "firman": "Jadi Sesan memberi anaknya kepada Yarha, budaknya itu, menjadi isteri, lalu perempuan itu melahirkan Atai baginya."
 },
 {
   "id": 10345,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 36,
   "firman": "Atai memperanakkan Natan, dan Natan memperanakkan Zabad."
 },
 {
   "id": 10346,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 37,
   "firman": "Zabad memperanakkan Eflal, dan Eflal memperanakkan Obed."
 },
 {
   "id": 10347,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 38,
   "firman": "Obed memperanakkan Yehu, dan Yehu memperanakkan Azarya."
 },
 {
   "id": 10348,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 39,
   "firman": "Azarya memperanakkan Heles, dan Heles memperanakkan Elasa."
 },
 {
   "id": 10349,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 40,
   "firman": "Elasa memperanakkan Sismai, dan Sismai memperanakkan Salum."
 },
 {
   "id": 10350,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 41,
   "firman": "Salum memperanakkan Yekamya, dan Yekamya memperanakkan Elisama."
 },
 {
   "id": 10351,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 42,
   "firman": "Keturunan Kaleb, adik Yerahmeel, ialah Mesa, anak sulungnya, bapa Zif, dan anak-anak Maresa, bapa Hebron."
 },
 {
   "id": 10352,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 43,
   "firman": "Anak-anak Hebron ialah Korah, Tapuah, Rekem dan Sema."
 },
 {
   "id": 10353,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 44,
   "firman": "Sema memperanakkan Raham, bapa Yorkeam, dan Rekem memperanakkan Samai."
 },
 {
   "id": 10354,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 45,
   "firman": "Anak Samai ialah Maon, dan Maon ialah bapa Bet-Zur."
 },
 {
   "id": 10355,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 46,
   "firman": "Efa, gundik Kaleb, melahirkan Haran, Moza dan Gazes; Haran memperanakkan Gazes."
 },
 {
   "id": 10356,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 47,
   "firman": "Anak-anak Yohdai ialah Regem, Yotam, Gesan, Pelet, Efa dan Saaf."
 },
 {
   "id": 10357,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 48,
   "firman": "Gundik Kaleb, yakni Maakha, melahirkan Seber dan Tirhana."
 },
 {
   "id": 10358,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 49,
   "firman": "Perempuan itu melahirkan juga Saaf, bapa Madmana, dan Sewa, bapa Makhbena dan bapa Gibea; anak perempuan Kaleb ialah Akhsa."
 },
 {
   "id": 10359,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 50,
   "firman": "Itulah keturunan Kaleb. Anak-anak Hur, anak sulung Efrata, ialah Sobal, bapa Kiryat-Yearim,"
 },
 {
   "id": 10360,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 51,
   "firman": "Salma, bapa Betlehem dan Haref, bapa Bet-Gader."
 },
 {
   "id": 10361,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 52,
   "firman": "Sobal, bapa Kiryat-Yearim, mempunyai keturunan, yakni Haroe dan setengah orang Menuhot."
 },
 {
   "id": 10362,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 53,
   "firman": "Dan kaum-kaum Kiryat-Yearim ialah orang Yetri, orang Puti, orang Sumati dan orang Misrai; dari mereka inilah berasal orang Zora dan orang Esytaol."
 },
 {
   "id": 10363,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 54,
   "firman": "Keturunan Salma ialah Betlehem, orang Netofa, Atarot-Bet-Yoab dan setengah orang Manahti, yakni orang Zori."
 },
 {
   "id": 10364,
   "kitab": "1Ta",
   "pasal": 2,
   "ayat": 55,
   "firman": "Dan kaum-kaum para ahli surat, yang diam di Yabes, ialah orang Tirati, orang Simati, dan orang Sukhati. Mereka itulah orang Keni keturunan Hamat bapa keluarga Rekhab."
 },
 {
   "id": 10365,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 1,
   "firman": "Inilah anak-anak Daud yang lahir bagi dia di Hebron; anak sulung ialah Amnon, dari Ahinoam, perempuan Yizreel; anak yang kedua ialah Daniel, dari Abigail, perempuan Karmel;"
 },
 {
   "id": 10366,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 2,
   "firman": "anak yang ketiga ialah Absalom, anak Maakha, yakni anak perempuan Talmai, raja Gesur; anak yang keempat ialah Adonia, anak Hagit;"
 },
 {
   "id": 10367,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 3,
   "firman": "anak yang kelima ialah Sefaca, dari Abital; anak yang keenam ialah Yitream, dari Egla, isterinya itu."
 },
 {
   "id": 10368,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 4,
   "firman": "Enam orang lahir bagi dia di Hebron, di mana ia memerintah tujuh tahun enam bulan lamanya; dan tiga puluh tiga tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 10369,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 5,
   "firman": "Inilah yang lahir bagi dia di Yerusalem: Simea, Sobab, Natan dan Salomo, empat orang dari Batsyua binti Amiel,"
 },
 {
   "id": 10370,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 6,
   "firman": "lalu Yibhar, Elisama, Elifelet,"
 },
 {
   "id": 10371,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 7,
   "firman": "Nogah, Nefeg, Yafia,"
 },
 {
   "id": 10372,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 8,
   "firman": "Elisama, Elyada dan Elifelet, sembilan orang."
 },
 {
   "id": 10373,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 9,
   "firman": "Semuanya itu anak-anak Daud, belum terhitung anak-anak dari gundik-gundik. Tamar ialah saudara perempuan mereka."
 },
 {
   "id": 10374,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 10,
   "firman": "Keturunan Salomo ialah Rehabeam; anak orang ini ialah Abia; anak orang ini ialah Asa; anak orang ini ialah Yosafat;"
 },
 {
   "id": 10375,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 11,
   "firman": "anak orang ini ialah Yoram; anak orang ini ialah Ahazia; anak orang ini ialah Yoas;"
 },
 {
   "id": 10376,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 12,
   "firman": "anak orang ini ialah Amazia; anak orang ini ialah Azarya; anak orang ini ialah Yotam;"
 },
 {
   "id": 10377,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 13,
   "firman": "anak orang ini ialah Ahas; anak orang ini ialah Hizkia; anak orang ini ialah Manasye;"
 },
 {
   "id": 10378,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 14,
   "firman": "anak orang ini ialah Amon; anak orang ini ialah Yosia."
 },
 {
   "id": 10379,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 15,
   "firman": "Anak-anak Yosia: anak sulung ialah Yohanan, anak yang kedua ialah Yoyakim, anak yang ketiga ialah Zedekia dan anak yang keempat ialah Salum."
 },
 {
   "id": 10380,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 16,
   "firman": "Keturunan Yoyakim ialah Yekhonya, anaknya itu, dan anak orang ini ialah Zedekia."
 },
 {
   "id": 10381,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 17,
   "firman": "Anak-anak Yekhonya, orang kurungan itu, ialah Sealtiel, anaknya,"
 },
 {
   "id": 10382,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 18,
   "firman": "lalu Malkhiram, Pedaya, Syenasar, Yekamya, Hosama dan Nedabya."
 },
 {
   "id": 10383,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 19,
   "firman": "Anak-anak Pedaya ialah Zerubabel dan Simei, dan anak-anak Zerubabel ialah Mesulam dan Hananya; Selomit ialah saudara perempuan mereka;"
 },
 {
   "id": 10384,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 20,
   "firman": "lalu Hasuba, Ohel, Berekhya, Hasaja dan Yusab-Hesed, lima orang."
 },
 {
   "id": 10385,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 21,
   "firman": "Anak-anak Hananya ialah Pelaca dan Yesaya; anak orang ini ialah Refaya; anak orang ini ialah Arnan; anak orang ini ialah Obaja, dan anak orang ini ialah Sekhanya."
 },
 {
   "id": 10386,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 22,
   "firman": "Anak-anak Sekhanya ialah Semaya, dan anak-anak Semaya ialah Hatus, Yigal, Bariah, Nearya dan Safat, enam orang."
 },
 {
   "id": 10387,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 23,
   "firman": "Anak-anak Nearya ialah Elyoenai, Hizkia, dan Azrikam, tiga orang."
 },
 {
   "id": 10388,
   "kitab": "1Ta",
   "pasal": 3,
   "ayat": 24,
   "firman": "Anak-anak Elyoenai ialah Hodawya, Elyasib, Pelaya, Akub, Yohanan, Delaya dan Anani, tujuh orang."
 },
 {
   "id": 10389,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 1,
   "firman": "Anak-anak Yehuda ialah Peres, Hezron, Karmi, Hur dan Syobal."
 },
 {
   "id": 10390,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 2,
   "firman": "Reaya, anak Syobal, memperanakkan Yahat, dan Yahat memperanakkan Ahumai dan Lahad. Itulah kaum-kaum orang Zora."
 },
 {
   "id": 10391,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 3,
   "firman": "Inilah anak-anak Etam: Yizreel, Isma dan Idbas; nama saudara perempuan mereka ialah Hazelelponi;"
 },
 {
   "id": 10392,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 4,
   "firman": "lalu Pnuel, bapa Gedor, dan Ezer, bapa Husa. Itulah keturunan Hur, anak sulung Efrata, bapa Betlehem."
 },
 {
   "id": 10393,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 5,
   "firman": "Asyur, bapa Tekoa, mempunyai dua isteri, yakni Hela dan Naara."
 },
 {
   "id": 10394,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 6,
   "firman": "Naara melahirkan baginya Ahuzam, Hefer, Temeni dan orang Ahastari. Itulah anak-anak Naara."
 },
 {
   "id": 10395,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 7,
   "firman": "Anak-anak Hela ialah Zeret, Yezohar dan Etnan."
 },
 {
   "id": 10396,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 8,
   "firman": "Kos memperanakkan Anub, Hazobeba dan kaum-kaum Aharhel bin Harum."
 },
 {
   "id": 10397,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 9,
   "firman": "Yabes lebih dimuliakan dari pada saudara-saudaranya; nama Yabes itu diberi ibunya kepadanya sebab katanya: \"Aku telah melahirkan dia dengan kesakitan.\""
 },
 {
   "id": 10398,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 10,
   "firman": "Yabes berseru kepada Allah Israel, katanya: \"Kiranya Engkau memberkati aku berlimpah-limpah dan memperluas daerahku, dan kiranya tangan-Mu menyertai aku, dan melindungi aku dari pada malapetaka, sehingga kesakitan tidak menimpa aku!\" Dan Allah mengabulkan permintaannya itu."
 },
 {
   "id": 10399,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 11,
   "firman": "Kelub, saudara Suha, memperanakkan Mehir, dialah ayah Eston;"
 },
 {
   "id": 10400,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 12,
   "firman": "dan Eston memperanakkan Bet-Rafa, Paseah dan Tehina, bapa Ir-Nahas. Itulah orang-orang Rekha."
 },
 {
   "id": 10401,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 13,
   "firman": "Anak-anak Kenas ialah Otniel dan Seraya; dan anak-anak Otniel ialah Hatat dan Meonotai;"
 },
 {
   "id": 10402,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 14,
   "firman": "dan Meonotai memperanakkan Ofra. Seraya memperanakkan Yoab, bapa Lembah Tukang-tukang, karena mereka adalah tukang-tukang."
 },
 {
   "id": 10403,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 15,
   "firman": "Anak-anak Kaleb bin Yefune ialah Iru, Ela dan Naam; dan keturunan Ela ialah Kenas."
 },
 {
   "id": 10404,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 16,
   "firman": "Anak-anak Yehaleleel ialah Zif, Zifa, Tireya dan Asareel."
 },
 {
   "id": 10405,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 17,
   "firman": "Anak-anak Ezra ialah Yeter, Mered, Efer dan Yalon. Itulah anak-anak Bica, puteri Firaun yang telah dikawini Mered. Perempuan ini melahirkan Miryam, Samai dan Yisbah, bapa Estemoa."
 },
 {
   "id": 10406,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 18,
   "firman": "Isteri Mered, perempuan Yehuda itu, melahirkan Yered, bapa Gedor, dan Heber, bapa Sokho, dan Yekutiel, bapa Zanoah."
 },
 {
   "id": 10407,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 19,
   "firman": "Anak-anak isteri Hodia, saudara perempuan Naham, ialah Abu Kehila, orang Garmi itu, dan Estemoa, orang Maakha itu."
 },
 {
   "id": 10408,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 20,
   "firman": "Anak-anak Simon ialah Amnon, Rina, Benhanan dan Tilon. Anak-anak Yisei ialah Zohet dan Ben-Zohet."
 },
 {
   "id": 10409,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 21,
   "firman": "Keturunan Sela, anak Yehuda, ialah Er, bapa Lekha, dan Lada, bapa Maresa, dan kaum-kaum para pengusaha kain lenan halus di Bet-Asybea,"
 },
 {
   "id": 10410,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 22,
   "firman": "lalu Yokim dan orang-orang Kozeba, lagi Yoas dan Saraf yang menguasai Moab dan kemudian pulang ke Betlehem; --riwayat-riwayat ini tua."
 },
 {
   "id": 10411,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 23,
   "firman": "Mereka ini adalah tukang-tukang periuk yang diam di Netaim dan Gedera; mereka diam di sana dan bekerja untuk raja."
 },
 {
   "id": 10412,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 24,
   "firman": "Anak-anak Simeon ialah Nemuel, Yamin, Yarib, Zerah dan Saul;"
 },
 {
   "id": 10413,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 25,
   "firman": "anak orang ini ialah Salum; anak orang ini ialah Mibsam; anak orang ini ialah Misma."
 },
 {
   "id": 10414,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 26,
   "firman": "Keturunan Misma ialah Hamuel, anaknya; anak orang ini ialah Zakur; anak orang ini ialah Simei."
 },
 {
   "id": 10415,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 27,
   "firman": "Simei mempunyai enam belas orang anak laki-laki dan enam orang anak perempuan; tetapi saudara-saudaranya tidak mempunyai banyak anak; seluruh kaum mereka tidak bertambah banyak seperti bani Yehuda."
 },
 {
   "id": 10416,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 28,
   "firman": "Mereka diam di Bersyeba, Molada, Hazar-Sual,"
 },
 {
   "id": 10417,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 29,
   "firman": "Bilha, Ezem, Tolad,"
 },
 {
   "id": 10418,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 30,
   "firman": "Betuel, Horma, Ziklag,"
 },
 {
   "id": 10419,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 31,
   "firman": "Bet-Markabot, Hazar-Susim, Bet-Biri dan di Saaraim. Itulah kota-kota mereka sampai Daud menjadi raja."
 },
 {
   "id": 10420,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 32,
   "firman": "Dan desa-desanya ialah Etam, Ain, Rimon, Tokhen dan Asan, lima perkampungan;"
 },
 {
   "id": 10421,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 33,
   "firman": "juga segala desanya yang di sekitar perkampungan-perkampungan itu sampai ke Baal. Itulah tempat-tempat kediaman mereka dan mereka mempunyai silsilahnya sendiri."
 },
 {
   "id": 10422,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 34,
   "firman": "Dan Mesobab, Yamlekh, Yosa bin Amazia,"
 },
 {
   "id": 10423,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 35,
   "firman": "Yoel, Yehu bin Yosibya bin Seraya bin Asiel,"
 },
 {
   "id": 10424,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 36,
   "firman": "Elyoenai, Yaakoba, Yesohaya, Asaya, Adiel, Yesimiel, Benaya,"
 },
 {
   "id": 10425,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 37,
   "firman": "Ziza bin Sifei bin Alon bin Yedaya bin Simri bin Semaya--"
 },
 {
   "id": 10426,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 38,
   "firman": "orang-orang ini yang disebutkan dengan nama-namanya adalah pemimpin-pemimpin di antara kaum-kaum mereka. Keluarga-keluarga mereka makin bertambah banyak."
 },
 {
   "id": 10427,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 39,
   "firman": "Oleh sebab itu mereka pindah ke arah Gedor sampai ke sebelah timur lembah untuk mencari padang rumput bagi kambing domba mereka."
 },
 {
   "id": 10428,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 40,
   "firman": "Mereka menemui padang rumput yang gemuk dan baik; negeri itu luas, aman dan sentosa; orang-orang yang diam di sana sebelum mereka berasal dari Ham."
 },
 {
   "id": 10429,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 41,
   "firman": "Orang-orang yang namanya tertulis ini datang dalam zaman Hizkia, raja Yehuda, dan memusnahkan kemah-kemah orang Ham dan orang Meunim yang terdapat di sana dan menumpas mereka; demikianlah sampai hari ini. Kemudian mereka menduduki tempat orang-orang itu, sebab di sana ada padang rumput bagi kambing domba mereka."
 },
 {
   "id": 10430,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 42,
   "firman": "Dan sebagian dari mereka, dari bani Simeon, sebanyak lima ratus orang, pindah ke pegunungan Seir. Sebagai kepala mereka ialah Pelaca, Nearya, Refaya dan Uziel, anak-anak Yisei."
 },
 {
   "id": 10431,
   "kitab": "1Ta",
   "pasal": 4,
   "ayat": 43,
   "firman": "Mereka membinasakan sisa orang Amalek yang telah meluputkan diri. Lalu mereka diam di sana sampai hari ini."
 },
 {
   "id": 10432,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 1,
   "firman": "Anak-anak Ruben, anak sulung Israel. Dialah anak sulung, tetapi karena ia telah melanggar kesucian petiduran ayahnya, maka hak kesulungannya diberikan kepada keturunan dari Yusuf, anak Israel juga, sekalipun tidak tercatat dalam silsilah sebagai anak sulung."
 },
 {
   "id": 10433,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 2,
   "firman": "Memang Yehudalah yang melebihi saudara-saudaranya, bahkan salah seorang dari antaranya menjadi raja, tetapi hak sulung itu ada pada Yusuf."
 },
 {
   "id": 10434,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 3,
   "firman": "Anak-anak Ruben, anak sulung Israel, ialah Henokh, Palu, Hezron dan Karmi."
 },
 {
   "id": 10435,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 4,
   "firman": "Keturunan Yoel ialah Semaya, anaknya; anak orang ini ialah Gog, anak orang ini ialah Simei;"
 },
 {
   "id": 10436,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 5,
   "firman": "anak orang ini ialah Mikha; anak orang ini ialah Reaya; anak orang ini ialah Baal;"
 },
 {
   "id": 10437,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 6,
   "firman": "anak orang ini ialah Beera yang diangkut ke dalam pembuangan oleh Tilgat-Pilneser, raja Asyur; dialah pemimpin orang Ruben."
 },
 {
   "id": 10438,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 7,
   "firman": "Saudara-saudaranya menurut kaum-kaumnya, seperti tercatat dalam silsilah menurut keturunan mereka, ialah Yeiel, kepala, lalu Zakharia,"
 },
 {
   "id": 10439,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 8,
   "firman": "dan Bela bin Azas bin Sema bin Yoel; dialah yang diam di Aroer dan wilayahnya sampai ke Nebo dan Baal-Meon."
 },
 {
   "id": 10440,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dan ke sebelah timur wilayahnya sampai ke pinggir padang gurun yang terbentang mulai dari sungai Efrat, sebab ternak mereka telah bertambah banyak di tanah Gilead."
 },
 {
   "id": 10441,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 10,
   "firman": "Di zaman Saul mereka melakukan perang melawan orang Hagri; setelah orang-orang ini jatuh ke dalam tangan mereka, maka mereka diam di kemah-kemah orang-orang itu di seluruh sisi timur Gilead."
 },
 {
   "id": 10442,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 11,
   "firman": "Bani Gad diam berbatasan dengan mereka di tanah Basan sampai Salkha."
 },
 {
   "id": 10443,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 12,
   "firman": "Yoel adalah kepala dan Safam orang kedua; juga Yaenai dan Safat diam di Basan."
 },
 {
   "id": 10444,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 13,
   "firman": "Saudara-saudara mereka menurut puak-puak mereka ialah Mikhael, Mesulam, Syeba, Yorai, Yakan, Ziya dan Eber, tujuh orang."
 },
 {
   "id": 10445,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 14,
   "firman": "Itulah anak-anak Abihail bin Huri bin Yaroah bin Gilead bin Mikhael bin Yesisai bin Yahdo bin Bus."
 },
 {
   "id": 10446,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 15,
   "firman": "Ahi bin Abdiel bin Guni ialah salah seorang kepala puak mereka."
 },
 {
   "id": 10447,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 16,
   "firman": "Mereka diam di Gilead, di Basan, dan di segala anak kotanya dan di segala tanah penggembalaan Saron sampai ke ujung-ujungnya."
 },
 {
   "id": 10448,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 17,
   "firman": "Mereka sekalian dicatat dalam silsilah pada zaman Yotam, raja Yehuda, dan pada zaman Yerobeam, raja Israel."
 },
 {
   "id": 10449,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 18,
   "firman": "Dari bani Ruben, orang Gad dan setengah suku Manasye ada empat puluh empat ribu tujuh ratus enam puluh orang yang sanggup berperang, orang-orang yang tangkas, yang dapat memanggul perisai dan pedang dan melentur busur panah, yang terlatih dalam bertempur."
 },
 {
   "id": 10450,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 19,
   "firman": "Mereka itu melakukan perang melawan orang Hagri, Yetur, Nafish dan Nodab."
 },
 {
   "id": 10451,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 20,
   "firman": "Mereka mendapat bantuan melawan orang-orang itu, sehingga orang Hagri itu dengan semua orang yang mengikutinya menyerahkan diri ke dalam tangan mereka, sebab mereka telah berseru kepada Allah dalam pertempuran itu. Maka Ia mengabulkan permintaan mereka, sebab mereka percaya kepada-Nya."
 },
 {
   "id": 10452,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 21,
   "firman": "Mereka mengangkut ternak orang-orang itu sebagai jarahan: untanya lima puluh ribu ekor, kambing domba dua ratus lima puluh ribu ekor dan keledai dua ribu ekor, juga manusia seratus ribu jiwa."
 },
 {
   "id": 10453,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 22,
   "firman": "Banyak orang yang tewas karena mati terbunuh, sebab pertempuran itu adalah dari pada Allah. Lalu mereka menduduki tempat orang-orang itu sampai waktu pembuangan."
 },
 {
   "id": 10454,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 23,
   "firman": "Setengah suku Manasye diam di negeri itu mulai dari Basan sampai Baal-Hermon, Senir dan gunung Hermon. Mereka sudah banyak jumlahnya."
 },
 {
   "id": 10455,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 24,
   "firman": "Inilah para kepala puak-puak mereka: Hefer, Yisei, Eliel, Azriel, Yeremia, Hodawya dan Yahdiel, orang-orang pahlawan yang gagah perkasa, orang-orang yang kenamaan, para kepala puak-puak mereka."
 },
 {
   "id": 10456,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 25,
   "firman": "Tetapi ketika mereka berubah setia terhadap Allah nenek moyang mereka dan berzinah dengan mengikuti segala allah bangsa-bangsa negeri yang telah dimusnahkan Allah dari depan mereka,"
 },
 {
   "id": 10457,
   "kitab": "1Ta",
   "pasal": 5,
   "ayat": 26,
   "firman": "maka Allah Israel menggerakkan hati Pul, yakni Tilgat-Pilneser, raja Asyur, lalu raja itu mengangkut mereka ke dalam pembuangan, yaitu orang Ruben, orang Gad dan setengah suku Manasye. Ia membawa mereka ke Halah, Habor, Hara dan sungai negeri Gozan; demikianlah mereka ada di sana sampai hari ini."
 },
 {
   "id": 10458,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 1,
   "firman": "Anak-anak Lewi ialah Gerson, Kehat dan Merari."
 },
 {
   "id": 10459,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 2,
   "firman": "Anak-anak Kehat ialah Amram, Yizhar, Hebron dan Uziel."
 },
 {
   "id": 10460,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 3,
   "firman": "Anak-anak Amram ialah Harun, Musa dan Miryam. Anak-anak Harun ialah Nadab, Abihu, Eleazar dan Itamar."
 },
 {
   "id": 10461,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 4,
   "firman": "Eleazar memperanakkan Pinehas; Pinehas memperanakkan Abisua;"
 },
 {
   "id": 10462,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 5,
   "firman": "Abisua memperanakkan Buki; Buki memperanakkan Uzi;"
 },
 {
   "id": 10463,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 6,
   "firman": "Uzi memperanakkan Zerahya; Zerahya memperanakkan Merayot;"
 },
 {
   "id": 10464,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 7,
   "firman": "Merayot memperanakkan Amarya; Amarya memperanakkan Ahitub;"
 },
 {
   "id": 10465,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 8,
   "firman": "Ahitub memperanakkan Zadok; Zadok memperanakkan Ahimaas;"
 },
 {
   "id": 10466,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 9,
   "firman": "Ahimaas memperanakkan Azarya; Azarya memperanakkan Yohanan;"
 },
 {
   "id": 10467,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 10,
   "firman": "Yohanan memperanakkan Azarya; dialah yang memegang jabatan imam di Bait Suci yang didirikan Salomo di Yerusalem."
 },
 {
   "id": 10468,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 11,
   "firman": "Azarya memperanakkan Amarya; Amarya memperanakkan Ahitub;"
 },
 {
   "id": 10469,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 12,
   "firman": "Ahitub memperanakkan Zadok; Zadok memperanakkan Salum;"
 },
 {
   "id": 10470,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 13,
   "firman": "Salum memperanakkan Hilkia; Hilkia memperanakkan Azarya;"
 },
 {
   "id": 10471,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 14,
   "firman": "Azarya memperanakkan Seraya; Seraya memperanakkan Yozadak;"
 },
 {
   "id": 10472,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 15,
   "firman": "Yozadak turut diangkut ketika TUHAN membiarkan orang Yehuda dan Yerusalem diangkut ke dalam pembuangan oleh Nebukadnezar."
 },
 {
   "id": 10473,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 16,
   "firman": "Anak-anak Lewi ialah Gerson, Kehat dan Merari."
 },
 {
   "id": 10474,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 17,
   "firman": "Inilah nama anak-anak Gerson: Libni dan Simei."
 },
 {
   "id": 10475,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 18,
   "firman": "Anak-anak Kehat ialah Amram, Yizhar, Hebron dan Uziel."
 },
 {
   "id": 10476,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 19,
   "firman": "Anak-anak Merari ialah Mahli dan Musi. Inilah kaum-kaum suku Lewi dalam puak-puak mereka:"
 },
 {
   "id": 10477,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 20,
   "firman": "dari pada Gerson ialah Libni, anaknya, dan anak orang ini ialah Yahat, dan anak orang ini ialah Zima,"
 },
 {
   "id": 10478,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 21,
   "firman": "dan anak orang ini ialah Yoah, dan anak orang ini ialah Ido, dan anak orang ini ialah Zerah, dan anak orang ini ialah Yeatrai."
 },
 {
   "id": 10479,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 22,
   "firman": "Keturunan Kehat ialah Aminadab, anaknya, dan anak orang ini ialah Korah, dan anak orang ini ialah Asir,"
 },
 {
   "id": 10480,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 23,
   "firman": "dan anak orang ini ialah Elkana, dan anak orang ini ialah Ebyasaf, dan anak orang ini ialah Asir,"
 },
 {
   "id": 10481,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 24,
   "firman": "dan anak orang ini ialah Tahat, dan anak orang ini ialah Uriel, dan anak orang ini ialah Uzia, dan anak orang ini ialah Saul."
 },
 {
   "id": 10482,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 25,
   "firman": "Anak-anak Elkana ialah Amasai dan Ahimot,"
 },
 {
   "id": 10483,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 26,
   "firman": "dan anak orang ini ialah Elkana, dan anak orang ini ialah Zofai, dan anak orang ini ialah Nahat,"
 },
 {
   "id": 10484,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 27,
   "firman": "dan anak orang ini ialah Eliab, dan anak orang ini ialah Yeroham, dan anak orang ini ialah Elkana."
 },
 {
   "id": 10485,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 28,
   "firman": "Anak-anak Samuel ialah Yoel, anak sulung dan anak yang kedua ialah Abia."
 },
 {
   "id": 10486,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 29,
   "firman": "Keturunan Merari ialah Mahli, dan anak orang ini ialah Libni, anak orang ini ialah Simei, dan anak orang ini ialah Uza,"
 },
 {
   "id": 10487,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 30,
   "firman": "dan anak orang ini ialah Simea, dan anak orang ini ialah Hagia, dan anak orang ini ialah Asaya."
 },
 {
   "id": 10488,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 31,
   "firman": "Inilah orang-orang yang ditugaskan oleh Daud memimpin nyanyian di rumah TUHAN sejak tabut itu mendapat tempat perhentian."
 },
 {
   "id": 10489,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 32,
   "firman": "Di hadapan Kemah Suci, yakni Kemah Pertemuan, mereka melayani sebagai penyanyi sampai Salomo mendirikan rumah TUHAN di Yerusalem. Mereka melakukan tugas jabatannya sesuai dengan peraturannya."
 },
 {
   "id": 10490,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 33,
   "firman": "Inilah orang-orang yang memegang tugas itu dengan anak-anak mereka: dari bani Kehat ialah Heman, penyanyi itu, anak Yoel bin Samuel"
 },
 {
   "id": 10491,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 34,
   "firman": "bin Elkana bin Yeroham bin Eliel bin Toah"
 },
 {
   "id": 10492,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 35,
   "firman": "bin Zuf bin Elkana bin Mahat bin Amasai"
 },
 {
   "id": 10493,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 36,
   "firman": "bin Elkana bin Yoel bin Azaria bin Zefanya"
 },
 {
   "id": 10494,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 37,
   "firman": "bin Tahat bin Asir bin Ebyasaf bin Korah"
 },
 {
   "id": 10495,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 38,
   "firman": "bin Yizhar bin Kehat bin Lewi bin Israel."
 },
 {
   "id": 10496,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 39,
   "firman": "Kemudian di sebelah kanannya berdiri Asaf, saudara sesukunya, yaitu Asaf bin Berekhya bin Simea"
 },
 {
   "id": 10497,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 40,
   "firman": "bin Mikhael bin Baaseya bin Malkia"
 },
 {
   "id": 10498,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 41,
   "firman": "bin Etai bin Zerah bin Adaya"
 },
 {
   "id": 10499,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 42,
   "firman": "bin Etan bin Zima bin Simei"
 },
 {
   "id": 10500,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 43,
   "firman": "bin Yahat bin Gerson bin Lewi."
 },
 {
   "id": 10501,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 44,
   "firman": "Di sebelah kiri berdiri dari bani Merari, saudara-saudara sesuku mereka, Etan bin Kisi bin Abdi bin Malukh"
 },
 {
   "id": 10502,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 45,
   "firman": "bin Hasabya bin Amazia bin Hilkia"
 },
 {
   "id": 10503,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 46,
   "firman": "bin Amzi bin Bani bin Semer"
 },
 {
   "id": 10504,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 47,
   "firman": "bin Mahli bin Musi bin Merari bin Lewi."
 },
 {
   "id": 10505,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 48,
   "firman": "Saudara-saudara sesuku mereka, orang-orang Lewi yang lain, diserahkan melakukan segala pekerjaan di Kemah Suci, rumah Allah."
 },
 {
   "id": 10506,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 49,
   "firman": "Tetapi Harun dan anak-anaknya berkewajiban membakar korban di atas mezbah korban bakaran dan di atas mezbah pembakaran ukupan, dan melakukan segala pekerjaan di tempat maha kudus serta mengadakan pendamaian bagi orang Israel, tepat seperti yang diperintahkan Musa, hamba Allah itu."
 },
 {
   "id": 10507,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 50,
   "firman": "Inilah keturunan Harun: Eleazar, anaknya, dan anak orang ini ialah Pinehas, dan anak orang ini ialah Abisua,"
 },
 {
   "id": 10508,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 51,
   "firman": "dan anak orang ini ialah Buki, dan anak orang ini ialah Uzi, dan anak orang ini ialah Zerahya"
 },
 {
   "id": 10509,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 52,
   "firman": "dan anak orang ini ialah Merayot, dan anak orang ini ialah Amarya, dan anak orang ini ialah Ahitub,"
 },
 {
   "id": 10510,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 53,
   "firman": "dan anak orang ini ialah Zadok, dan anak orang ini ialah Ahimaas."
 },
 {
   "id": 10511,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 54,
   "firman": "Inilah tempat-tempat kediaman mereka menurut tempat-tempat perkemahan mereka di daerah mereka: kepada keturunan Harun yang termasuk kaum orang Kehat--karena bagi merekalah undian yang pertama--"
 },
 {
   "id": 10512,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 55,
   "firman": "kepada mereka diberikan Hebron di tanah Yehuda dengan tanah-tanah penggembalaan di sekelilingnya,"
 },
 {
   "id": 10513,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 56,
   "firman": "tetapi tanah ladang kota tadi dengan desa-desanya telah diberikan kepada Kaleb bin Yefune."
 },
 {
   "id": 10514,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 57,
   "firman": "Kepada keturunan Harun diberikan Hebron kota perlindungan itu, kemudian Libna dengan tanah-tanah penggembalaannya, dan Yatir, lalu Estemoa dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10515,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 58,
   "firman": "Hilen dengan tanah-tanah penggembalaannya, Debir dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10516,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 59,
   "firman": "Asan dengan tanah-tanah penggembalaannya, dan Bet-Semes dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10517,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 60,
   "firman": "dan dari suku Benyamin: Geba dengan tanah-tanah penggembalaannya, Alemet dengan tanah-tanah penggembalaannya dan Anatot dengan tanah-tanah penggembalaannya. Seluruhnya kota-kota mereka ada tiga belas yang dibagikan di antara kaum-kaum mereka."
 },
 {
   "id": 10518,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 61,
   "firman": "Dan keturunan Kehat yang selebihnya mendapat dengan undian sepuluh kota dari kaum suku itu, yakni dari suku Manasye yang setengah itu."
 },
 {
   "id": 10519,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 62,
   "firman": "Kepada keturunan Gerson menurut kaum-kaum mereka diberikan tiga belas kota dari suku Isakhar, dari suku Asyer, dari suku Naftali dan dari suku Manasye yang di Basan."
 },
 {
   "id": 10520,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 63,
   "firman": "Kepada keturunan Merari menurut kaum-kaum mereka diberikan dengan diundi dua belas kota dari suku Ruben, dari suku Gad dan dari suku Zebulon."
 },
 {
   "id": 10521,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 64,
   "firman": "Jadi orang Israel memberikan kepada orang Lewi kota-kota itu dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 10522,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 65,
   "firman": "Mereka memberikan juga dengan diundi kota-kota tadi, yang mereka sebutkan nama-namanya, dari suku bani Yehuda, dari suku bani Simeon dan dari suku bani Benyamin."
 },
 {
   "id": 10523,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 66,
   "firman": "Kaum-kaum yang lain dari keturunan Kehat mendapat kota-kota dari suku Efraim sebagai daerah mereka."
 },
 {
   "id": 10524,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 67,
   "firman": "Kepada mereka diberikan Sikhem, kota perlindungan itu, dengan tanah-tanah penggembalaannya, di pegunungan Efraim, lalu Gezer dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 10525,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 68,
   "firman": "Yokmeam dengan tanah-tanah penggembalaannya, Bet-Horon dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 10526,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 69,
   "firman": "Ayalon dengan tanah-tanah penggembalaannya dan Gat-Rimon dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 10527,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 70,
   "firman": "Dan dari suku Manasye yang setengah itu: Aner dengan tanah-tanah penggembalaannya dan Bileam dengan tanah-tanah penggembalaannya. Jadi kota-kota itu diberikan kepada kaum-kaum yang selebihnya dari keturunan Kehat."
 },
 {
   "id": 10528,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 71,
   "firman": "Keturunan Gerson mendapat dari kaum suku Manasye yang setengah itu; Golan yang di Basan dengan tanah-tanah penggembalaannya, lalu Asytarot dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10529,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 72,
   "firman": "dari suku Isakhar: Kedesh dengan tanah-tanah penggembalaannya; Daberat dengan tanah-tanah pengembalaannya,"
 },
 {
   "id": 10530,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 73,
   "firman": "Ramot dengan tanah-tanah penggembalaannya dan Anem dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10531,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 74,
   "firman": "dari suku Asyer: Masal dengan tanah-tanah penggembalaannya, Abdon dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 10532,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 75,
   "firman": "Hukok dengan tanah-tanah penggembalaannya dan Rehob dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10533,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 76,
   "firman": "dari suku Naftali: Kedesh yang di Galilea dengan tanah-tanah penggembalaannya, Hamon dengan tanah-tanah penggembalaannya dan Kiryataim dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 10534,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 77,
   "firman": "Keturunan Merari yang selebihnya mendapat dari suku Zebulon: Rimono dengan tanah-tanah penggembalaannya dan Tabor dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10535,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 78,
   "firman": "dan di seberang sungai Yordan dekat Yerikho, di sebelah timur sungai Yordan, diberikan dari suku Ruben: Bezer yang di padang gurun dengan tanah-tanah penggembalaannya, Yahas dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 10536,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 79,
   "firman": "Kedemot dengan tanah-tanah penggembalaannya dan Mefaat dengan tanah-tanah penggembalaannya;"
 },
 {
   "id": 10537,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 80,
   "firman": "dan dari suku Gad: Ramot di Gilead dengan tanah-tanah penggembalaannya, Mahanaim dengan tanah-tanah penggembalaannya,"
 },
 {
   "id": 10538,
   "kitab": "1Ta",
   "pasal": 6,
   "ayat": 81,
   "firman": "Hesybon dengan tanah-tanah penggembalaannya dan Yaezer dengan tanah-tanah penggembalaannya."
 },
 {
   "id": 10539,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 1,
   "firman": "Anak-anak Isakhar ialah Tola dan Pua, Yasub dan Simron, empat orang."
 },
 {
   "id": 10540,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 2,
   "firman": "Anak-anak Tola ialah Uzi, Refaya, Yeriel, Yahmai, Yibsam dan Samuel, kepala-kepala puak turunan Tola, pahlawan-pahlawan yang gagah perkasa; menurut daftar keturunan mereka jumlahnya di zaman Daud ada dua puluh dua ribu enam ratus orang."
 },
 {
   "id": 10541,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 3,
   "firman": "Keturunan Uzi ialah Yizrahya dan anak-anak Yizrahya ialah Mikhael, Obaja, Yoel dan Yisia, lima orang, semuanya mereka adalah kepala-kepala."
 },
 {
   "id": 10542,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 4,
   "firman": "Di bawah mereka itu, menurut daftar keturunan dan menurut puak mereka, ada pasukan-pasukan tentara tiga puluh enam ribu orang, sebab isteri dan anak-anak mereka banyak."
 },
 {
   "id": 10543,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 5,
   "firman": "Saudara-saudara sesuku mereka dari segala kaum Isakhar, pahlawan-pahlawan yang gagah perkasa, semuanya ada delapan puluh tujuh ribu orang yang terdaftar dalam silsilah."
 },
 {
   "id": 10544,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 6,
   "firman": "Anak-anak Benyamin ialah Bela, Bekher dan Yediael, tiga orang."
 },
 {
   "id": 10545,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 7,
   "firman": "Anak-anak Bela ialah Ezbon, Uzi, Uziel, Yerimot dan Iri, lima orang, kepala-kepala puak, pahlawan-pahlawan yang gagah perkasa; mereka yang terdaftar dalam silsilah ada dua puluh dua ribu tiga puluh empat orang."
 },
 {
   "id": 10546,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 8,
   "firman": "Anak-anak Bekher ialah Zemira, Yoas, Eliezer, Elyoenai, Omri, Yeremot, Abia, Anatot dan Alemet; sekaliannya itu ialah anak-anak Bekher."
 },
 {
   "id": 10547,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 9,
   "firman": "Mereka yang terdaftar dalam silsilah, menurut keturunan mereka, sebagai kepala-kepala puak mereka, pahlawan-pahlawan yang gagah perkasa, ada dua puluh ribu dua ratus orang."
 },
 {
   "id": 10548,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 10,
   "firman": "Keturunan Yediael ialah Bilhan dan anak-anak Bilhan ialah Yeush, Benyamin, Ehud, Kenaana, Zetan, Tarsis dan Ahisahar."
 },
 {
   "id": 10549,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 11,
   "firman": "Sekaliannya itu ialah keturunan Yediael, kepala-kepala puak mereka, pahlawan-pahlawan yang gagah perkasa; orang-orang yang sanggup berperang ada tujuh belas ribu dua ratus."
 },
 {
   "id": 10550,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 12,
   "firman": "Dan Supim dan Hupim ialah keturunan Ir; Husim ialah keturunan Aher."
 },
 {
   "id": 10551,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 13,
   "firman": "Anak-anak Naftali ialah Yahziel, Guni, Yezer dan Salum, anak-anaknya dari Bilha."
 },
 {
   "id": 10552,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 14,
   "firman": "Keturunan Manasye ialah Asriel yang dilahirkan oleh gundiknya, perempuan Aram itu; perempuan ini melahirkan Makhir, bapa Gilead."
 },
 {
   "id": 10553,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 15,
   "firman": "Makhir mengambil seorang isteri bagi Hupim dan Supim; nama saudaranya perempuan ialah Maakha. Nama anak yang kedua ialah Zelafead. Zelafead hanya mempunyai anak-anak perempuan."
 },
 {
   "id": 10554,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 16,
   "firman": "Tetapi Maakha, isteri Makhir, melahirkan seorang anak laki-laki dan menamainya Peresh; nama saudaranya laki-laki ialah Seres dan anak-anak orang ini ialah Ulam dan Rekem."
 },
 {
   "id": 10555,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 17,
   "firman": "Keturunan Ulam ialah Bedan. Itulah keturunan Gilead bin Makhir bin Manasye."
 },
 {
   "id": 10556,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 18,
   "firman": "Saudaranya perempuan, Molekhet, melahirkan Isyhod, Abiezer dan Mahla."
 },
 {
   "id": 10557,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 19,
   "firman": "Anak-anak Semida ialah Ahyan, Sekhem, Likhi dan Aniam."
 },
 {
   "id": 10558,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 20,
   "firman": "Keturunan Efraim ialah Sutelah, dan anak orang ini ialah Bered, dan anak orang ini ialah Tahat, dan anak orang ini ialah Elada, dan anak orang ini ialah Tahat,"
 },
 {
   "id": 10559,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 21,
   "firman": "dan anak orang ini ialah Zabad, dan anak orang ini ialah Sutelah, kemudian Ezer dan Elad. Mereka dibunuh oleh orang-orang Gat yang lahir di negeri itu, sebab mereka pergi merampas ternak orang-orang itu."
 },
 {
   "id": 10560,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 22,
   "firman": "Efraim, ayah mereka, berkabung berhari-hari lamanya, sehingga saudara-saudaranya datang untuk menghiburkan dia."
 },
 {
   "id": 10561,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 23,
   "firman": "Sesudah itu ia bersetubuh dengan isterinya, lalu mengandunglah perempuan itu dan melahirkan seorang anak laki-laki. Ia menamainya Beria, sebab malapetaka telah menimpa keluarganya."
 },
 {
   "id": 10562,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 24,
   "firman": "Anaknya perempuan ialah Seera yang telah mendirikan Bet-Horon-Hilir dan Bet-Horon-Hulu serta Uzen-Seera."
 },
 {
   "id": 10563,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 25,
   "firman": "Anak laki-laki Beria ialah Refah, lalu Resef; anak orang ini ialah Telah, dan anak orang ini ialah Tahan,"
 },
 {
   "id": 10564,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 26,
   "firman": "dan anak orang ini ialah Ladan, dan anak orang ini ialah Amihud, dan anak orang ini ialah Elisama,"
 },
 {
   "id": 10565,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 27,
   "firman": "dan anak orang ini ialah Nun, dan anak orang ini ialah Yosua."
 },
 {
   "id": 10566,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 28,
   "firman": "Tanah milik mereka dan tempat kediaman mereka ialah Betel dengan segala anak kotanya, Naaran di sebelah timur dan Gezer dengan segala anak kotanya di sebelah barat, kemudian Sikhem dengan segala anak kotanya sampai Aya dengan segala anak kotanya,"
 },
 {
   "id": 10567,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 29,
   "firman": "dan pada perbatasan bani Manasye: Bet-Sean dengan segala anak kotanya, juga Taanakh dengan segala anak kotanya, Megido dengan segala anak kotanya, Dor dengan segala anak kotanya. Di tempat-tempat itulah keturunan Yusuf bin Israel diam."
 },
 {
   "id": 10568,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 30,
   "firman": "Anak-anak Asyer ialah Yimna, Yiswa, Yiswi dan Beria; Serah ialah saudara perempuan mereka."
 },
 {
   "id": 10569,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 31,
   "firman": "Anak-anak Beria ialah Heber dan Malkiel; dialah bapa Birzait."
 },
 {
   "id": 10570,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 32,
   "firman": "Heber memperanakkan Yaflet, Somer dan Hotam serta Sua, saudara perempuan mereka."
 },
 {
   "id": 10571,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 33,
   "firman": "Anak-anak Yaflet ialah Pasakh, Bimhab dan Asywat. Itulah anak-anak Yaflet."
 },
 {
   "id": 10572,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 34,
   "firman": "Anak-anak Semer ialah Ahi, Rohga, Yehuba dan Aram."
 },
 {
   "id": 10573,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 35,
   "firman": "Anak-anak Helem, saudaranya laki-laki, ialah Zofah, Yimna, Seles dan Amal."
 },
 {
   "id": 10574,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 36,
   "firman": "Anak-anak Zofah ialah Suah, Harnefer, Syual, Beri dan Yimra,"
 },
 {
   "id": 10575,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 37,
   "firman": "Bezer, Hod, Sama, Silsa, Yitran dan Beera."
 },
 {
   "id": 10576,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 38,
   "firman": "Anak-anak Yeter ialah Yefune, Pispa dan Ara."
 },
 {
   "id": 10577,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 39,
   "firman": "Anak-anak Ula ialah Arah, Haniel dan Rizya."
 },
 {
   "id": 10578,
   "kitab": "1Ta",
   "pasal": 7,
   "ayat": 40,
   "firman": "Itulah sekaliannya keturunan Asyer, kepala-kepala puak mereka, pahlawan-pahlawan gagah perkasa yang terpilih, pemimpin-pemimpin utama. Jumlah yang terdaftar dalam silsilah mereka sebagai pasukan perang ada dua puluh enam ribu orang."
 },
 {
   "id": 10579,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 1,
   "firman": "Benyamin memperanakkan Bela, anak sulungnya, Asybel, anak yang kedua, Ahrah, anak yang ketiga,"
 },
 {
   "id": 10580,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 2,
   "firman": "Noha, anak yang keempat dan Rafa, anak yang kelima."
 },
 {
   "id": 10581,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 3,
   "firman": "Anak-anak Bela ialah Adar, Gera, Abihud,"
 },
 {
   "id": 10582,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 4,
   "firman": "Abisua, Naaman, Ahoah,"
 },
 {
   "id": 10583,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 5,
   "firman": "Gera, Sefufan dan Huram."
 },
 {
   "id": 10584,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 6,
   "firman": "Inilah anak-anak Ehud; mereka ini adalah kepala-kepala puak penduduk Geba yang diangkut ke dalam pembuangan ke Manahat;"
 },
 {
   "id": 10585,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 7,
   "firman": "Naaman, Ahia dan Gera mengangkut mereka ke dalam pembuangan; dia memperanakkan Uza dan Ahihud."
 },
 {
   "id": 10586,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 8,
   "firman": "Saharaim mendapat anak di daerah Moab, sesudah diusirnya Husim dan Baara, isteri-isterinya."
 },
 {
   "id": 10587,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 9,
   "firman": "Ia mendapat anak dari Hodesh, isterinya, yakni Yobab, Zibya, Mesa, Malkam,"
 },
 {
   "id": 10588,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 10,
   "firman": "Yeus, Sokhya dan Mirma; itulah anak-anaknya, kepala-kepala puak;"
 },
 {
   "id": 10589,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 11,
   "firman": "sebelum itu dari Husim ia telah mendapat anak, yakni Abitub dan Elpaal."
 },
 {
   "id": 10590,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 12,
   "firman": "Anak-anak Elpaal ialah Eber, Misam dan Semed; dia ini mendirikan kota Ono dan kota Lod dengan segala anak kotanya."
 },
 {
   "id": 10591,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 13,
   "firman": "Beria dan Sema adalah kepala-kepala puak penduduk Ayalon; mereka telah menghalau penduduk Gat."
 },
 {
   "id": 10592,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 14,
   "firman": "Ahyo, Sasak, Yeremot,"
 },
 {
   "id": 10593,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 15,
   "firman": "Zebaja, Arad, Eder,"
 },
 {
   "id": 10594,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 16,
   "firman": "Mikhael, Yispa dan Yoha ialah anak-anak Beria."
 },
 {
   "id": 10595,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 17,
   "firman": "Zebaja, Mesulam, Hizki, Heber,"
 },
 {
   "id": 10596,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 18,
   "firman": "Yismerai, Yizlia dan Yobab ialah anak-anak Elpaal."
 },
 {
   "id": 10597,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 19,
   "firman": "Yakim, Zikhri, Zabdi,"
 },
 {
   "id": 10598,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 20,
   "firman": "Elyoenai, Ziletai, Eliel,"
 },
 {
   "id": 10599,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 21,
   "firman": "Adaya, Beraya dan Simrat ialah anak-anak Simei."
 },
 {
   "id": 10600,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 22,
   "firman": "Yispan, Eber, Eliel,"
 },
 {
   "id": 10601,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 23,
   "firman": "Abdon, Zikhri, Hanan,"
 },
 {
   "id": 10602,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 24,
   "firman": "Hananya, Elam, Antotia,"
 },
 {
   "id": 10603,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 25,
   "firman": "Yifdeya dan Pnuel ialah anak-anak Sasak."
 },
 {
   "id": 10604,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 26,
   "firman": "Samserai, Seharya, Atalya,"
 },
 {
   "id": 10605,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 27,
   "firman": "Yaaresya, Elia dan Zikhri ialah anak-anak Yeroham."
 },
 {
   "id": 10606,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 28,
   "firman": "Itulah para kepala puak, para kepala menurut keturunan mereka; mereka ini diam di Yerusalem."
 },
 {
   "id": 10607,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 29,
   "firman": "Tetapi di Gibeon diam bapa Gibeon, yakni Yeiel, dan nama isterinya ialah Maakha."
 },
 {
   "id": 10608,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 30,
   "firman": "Anak sulungnya ialah Abdon, lalu Zur, Kish, Baal, Nadab,"
 },
 {
   "id": 10609,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 31,
   "firman": "Gedor, Ahyo, Zekher"
 },
 {
   "id": 10610,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 32,
   "firman": "dan Miklot yang memperanakkan Simea. Juga mereka ini pergi diam berdekatan dengan saudara-saudara mereka di Yerusalem bersama-sama saudara mereka yang lain."
 },
 {
   "id": 10611,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 33,
   "firman": "Ner memperanakkan Kish; Kish memperanakkan Saul; Saul memperanakkan Yonatan, Malkisua, Abinadab dan Esybaal."
 },
 {
   "id": 10612,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 34,
   "firman": "Anak Yonatan ialah Meribaal dan Meribaal memperanakkan Mikha."
 },
 {
   "id": 10613,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 35,
   "firman": "Anak Mikha ialah Piton, Melekh, Tarea dan Ahas."
 },
 {
   "id": 10614,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 36,
   "firman": "Ahas memperanakkan Yoada; Yoada memperanakkan Alemet, Azmawet dan Zimri; Zimri memperanakkan Moza."
 },
 {
   "id": 10615,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 37,
   "firman": "Moza memperanakkan Bina; anak orang ini ialah Rafa, dan anak orang ini ialah Elasa, dan anak orang ini ialah Azel."
 },
 {
   "id": 10616,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 38,
   "firman": "Azel mempunyai enam orang anak, dan inilah nama-nama mereka: Azrikam, Bokhru, Ismael, Searya, Obaja dan Hanan. Itulah sekaliannya anak-anak Azel."
 },
 {
   "id": 10617,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 39,
   "firman": "Anak-anak Esek, saudaranya, ialah Ulam, anak sulungnya, lalu Yeush, anak yang kedua, dan Elifelet, anak yang ketiga."
 },
 {
   "id": 10618,
   "kitab": "1Ta",
   "pasal": 8,
   "ayat": 40,
   "firman": "Anak-anak Ulam itu adalah orang-orang berani, pahlawan-pahlawan yang gagah perkasa, pemanah-pemanah; anak dan cucu mereka banyak: seratus lima puluh orang. Mereka semuanya itu termasuk bani Benyamin."
 },
 {
   "id": 10619,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 1,
   "firman": "Seluruh orang Israel telah terdaftar dalam silsilah; mereka tertulis dalam kitab raja-raja Israel, sedang orang Yehuda telah diangkut ke dalam pembuangan ke Babel oleh karena perbuatan mereka yang tidak setia."
 },
 {
   "id": 10620,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 2,
   "firman": "Dan orang-orang yang mula-mula menetap kembali di tanah-tanah milik mereka, di kota-kota mereka, ialah orang Israel awam, para imam, orang-orang Lewi dan para budak di bait Allah."
 },
 {
   "id": 10621,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 3,
   "firman": "Di Yerusalem tinggal orang-orang dari bani Yehuda, dari bani Benyamin, dari bani Efraim dan Manasye:"
 },
 {
   "id": 10622,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 4,
   "firman": "Utai bin Amihud bin Omri bin Imri bin Bani, dari keturunan Peres bin Yehuda."
 },
 {
   "id": 10623,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan dari orang Syela ialah Asaya, anak yang sulung, dengan anak-anaknya."
 },
 {
   "id": 10624,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 6,
   "firman": "Dari keturunan Zerah ialah Yeuel dengan sanak saudaranya, enam ratus sembilan puluh orang."
 },
 {
   "id": 10625,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 7,
   "firman": "Dari bani Benyamin ialah Salu bin Mesulam bin Hodawya bin Hasenua,"
 },
 {
   "id": 10626,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 8,
   "firman": "Yibnea bin Yeroham, Ela bin Uzi bin Mikhri dan Mesulam bin Sefaca bin Rehuel bin Yibnia"
 },
 {
   "id": 10627,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 9,
   "firman": "dengan sanak saudara mereka menurut keturunan mereka, sembilan ratus lima puluh enam orang. Semua orang itu adalah kepala puak."
 },
 {
   "id": 10628,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 10,
   "firman": "Dari para imam ialah Yedaya, Yoyarib, Yakhin,"
 },
 {
   "id": 10629,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 11,
   "firman": "Azarya bin Hilkia bin Mesulam bin Zadok bin Merayot bin Ahitub, pemuka rumah Allah,"
 },
 {
   "id": 10630,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 12,
   "firman": "lalu Adaya bin Yeroham bin Pasyhur bin Malkia, dan Masai bin Adiel bin Yahzera bin Mesulam bin Mesilemit bin Imer,"
 },
 {
   "id": 10631,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 13,
   "firman": "dengan sanak saudara mereka, kepala-kepala puak, seribu tujuh ratus enam puluh orang, orang-orang tangkas untuk menyelenggarakan ibadah di rumah Allah."
 },
 {
   "id": 10632,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 14,
   "firman": "Dari orang-orang Lewi ialah Semaya bin Hasub bin Azrikam bin Hasabya, dari keturunan Merari;"
 },
 {
   "id": 10633,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 15,
   "firman": "lalu Bakbakar, Heresh, Galal dan Matanya bin Mikha bin Zikhri bin Asaf,"
 },
 {
   "id": 10634,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 16,
   "firman": "serta Obaja bin Semaya bin Galal bin Yedutun dan Berekhya bin Asa bin Elkana yang diam di desa-desa orang Netofa."
 },
 {
   "id": 10635,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 17,
   "firman": "Penunggu-penunggu pintu gerbang ialah Salum, Akub, Talmon dan Ahiman, dengan sanak saudara mereka; Salum ialah kepala."
 },
 {
   "id": 10636,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 18,
   "firman": "Sampai sekarang mereka ada di pintu gerbang raja di sebelah timur. Merekalah penunggu-penunggu pintu gerbang perkemahan bani Lewi."
 },
 {
   "id": 10637,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 19,
   "firman": "Salum bin Kore bin Ebyasaf bin Korah dan saudara-saudara sepuaknya, yakni orang-orang Korah, mempunyai tugas jabatan sebagai penjaga-penjaga ambang pintu Kemah, seperti bapa-bapa mereka bertugas di perkemahan TUHAN sebagai penjaga-penjaga pintu masuk."
 },
 {
   "id": 10638,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 20,
   "firman": "Pinehas bin Eleazar mengepalai mereka sebelumnya. TUHAN kiranya menyertai dia."
 },
 {
   "id": 10639,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 21,
   "firman": "Zakharia bin Meselemya adalah penunggu pintu Kemah Pertemuan."
 },
 {
   "id": 10640,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 22,
   "firman": "Mereka semuanya yang terpilih menjadi penunggu ambang pintu ada dua ratus dua belas orang. Mereka telah terdaftar dalam silsilah di desa-desa mereka. Daud dan Samuel, pelihat itu, mengangkat mereka dalam jabatan itu."
 },
 {
   "id": 10641,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 23,
   "firman": "Mereka dan anak-anak mereka bertugas menjaga pintu-pintu gerbang rumah TUHAN, yakni Bait Kemah itu."
 },
 {
   "id": 10642,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 24,
   "firman": "Ke arah empat mata angin ditempatkan penunggu-penunggu pintu gerbang itu, yakni ke arah timur, barat, utara dan selatan."
 },
 {
   "id": 10643,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 25,
   "firman": "Dan saudara-saudara mereka yang tinggal di desa-desa mereka, pada waktu-waktu tertentu harus masuk selama tujuh hari untuk bekerja bersama-sama mereka,"
 },
 {
   "id": 10644,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 26,
   "firman": "sedang keempat kepala penunggu pintu gerbang itu memegang jabatan tetap. Mereka adalah orang Lewi dan mengawasi bilik-bilik serta perbendaharaan rumah Allah."
 },
 {
   "id": 10645,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 27,
   "firman": "Mereka bermalam di sekitar rumah Allah itu sebab mereka bertanggung jawab atas penjagaan dan harus membuka pintu setiap pagi."
 },
 {
   "id": 10646,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 28,
   "firman": "Sebagian dari mereka mengurus perkakas ibadah: mereka menghitung perkakas itu pada waktu dimasukkan dan dikeluarkan."
 },
 {
   "id": 10647,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 29,
   "firman": "Sebagian dari mereka ditugaskan mengurus perabotan, yakni segala perabotan tempat kudus, dan mengurus tepung yang terbaik, anggur, minyak, kemenyan dan rempah-rempah,"
 },
 {
   "id": 10648,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 30,
   "firman": "sedangkan beberapa orang imam menyediakan campuran rempah-rempah."
 },
 {
   "id": 10649,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 31,
   "firman": "Matica, salah seorang Lewi, anak sulung Salum, orang Korah itu, mendapat tugas tetap untuk mengolah roti."
 },
 {
   "id": 10650,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 32,
   "firman": "Dan sebagian dari anak-anak orang Kehat, yakni dari sanak saudara mereka, mengurus roti sajian untuk disediakan setiap hari Sabat."
 },
 {
   "id": 10651,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 33,
   "firman": "Dan inilah para penyanyi, kepala-kepala puak orang Lewi, yang diam di bilik-bilik dan bebas dari pekerjaan lain, sebab siang dan malam mereka sibuk dengan pekerjaannya."
 },
 {
   "id": 10652,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 34,
   "firman": "Itulah para kepala puak orang Lewi, para kepala, menurut keturunan mereka; mereka ini diam di Yerusalem."
 },
 {
   "id": 10653,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 35,
   "firman": "Di Gibeon diam bapa Gibeon, yakni Yeiel, dan nama isterinya ialah Maakha."
 },
 {
   "id": 10654,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 36,
   "firman": "Anak sulungnya ialah Abdon, lalu Zur, Kish, Baal, Ner, Nadab,"
 },
 {
   "id": 10655,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 37,
   "firman": "Gedor, Ahyo, Zakharia dan Miklot."
 },
 {
   "id": 10656,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 38,
   "firman": "Miklot memperanakkan Simeam. Juga mereka ini pergi diam berdekatan dengan saudara-saudara mereka di Yerusalem bersama-sama saudara mereka yang lain."
 },
 {
   "id": 10657,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 39,
   "firman": "Ner memperanakkan Kish; Kish memperanakkan Saul; Saul memperanakkan Yonatan, Malkisua, Abinadab dan Esybaal."
 },
 {
   "id": 10658,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 40,
   "firman": "Anak Yonatan ialah Meribaal, dan Meribaal memperanakkan Mikha."
 },
 {
   "id": 10659,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 41,
   "firman": "Anak Mikha ialah Piton, Melekh, Tahrea dan Ahas."
 },
 {
   "id": 10660,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 42,
   "firman": "Ahas memperanakkan Yaera; Yaera memperanakkan Alemet, Azmawet dan Zimri; Zimri memperanakkan Moza."
 },
 {
   "id": 10661,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 43,
   "firman": "Moza memperanakkan Bina, dan anak orang ini ialah Refaya, dan anak orang ini ialah Elasa, dan anak orang ini ialah Azel."
 },
 {
   "id": 10662,
   "kitab": "1Ta",
   "pasal": 9,
   "ayat": 44,
   "firman": "Azel mempunyai enam orang anak dan inilah nama-nama mereka: Azrikam, Bokhru, Ismael, Searya, Obaja dan Hanan. Itulah anak-anak Azel."
 },
 {
   "id": 10663,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 1,
   "firman": "Orang Filistin berperang melawan orang Israel. Orang-orang Israel melarikan diri dari hadapan orang Filistin dan banyak yang mati terbunuh di pegunungan Gilboa."
 },
 {
   "id": 10664,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 2,
   "firman": "Orang Filistin terus mengejar Saul dan anak-anaknya dan menewaskan Yonatan, Abinadab dan Malkisua, anak-anak Saul."
 },
 {
   "id": 10665,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 3,
   "firman": "Kemudian makin beratlah pertempuran itu bagi Saul; para pemanah menjumpainya dan melukainya."
 },
 {
   "id": 10666,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 4,
   "firman": "Lalu berkatalah Saul kepada pembawa senjatanya: \"Hunuslah pedangmu dan tikamlah aku, supaya jangan datang orang-orang yang tidak bersunat ini memperlakukan aku sebagai permainan.\" Tetapi pembawa senjatanya tidak mau, karena ia sangat segan. Kemudian Saul mengambil pedang itu dan menjatuhkan dirinya ke atasnya."
 },
 {
   "id": 10667,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 5,
   "firman": "Ketika pembawa senjatanya melihat, bahwa Saul telah mati, iapun menjatuhkan dirinya ke atas pedangnya, lalu mati."
 },
 {
   "id": 10668,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 6,
   "firman": "Jadi Saul, ketiga anaknya dan segenap keluarganya sama-sama mati."
 },
 {
   "id": 10669,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 7,
   "firman": "Ketika dilihat seluruh orang Israel yang di lembah, bahwa tentara telah melarikan diri, dan bahwa Saul serta anak-anaknya sudah mati, maka mereka meninggalkan kota-kota mereka lalu melarikan diri juga; kemudian datanglah orang Filistin dan menetap di sana."
 },
 {
   "id": 10670,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 8,
   "firman": "Ketika keesokan harinya orang Filistin datang merampasi orang-orang yang mati terbunuh itu, didapati mereka Saul dan anak-anaknya tergelimpang di pegunungan Gilboa."
 },
 {
   "id": 10671,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 9,
   "firman": "Mereka merampasinya dan mengambil kepala Saul dan senjata-senjatanya, lalu menyuruh orang berkeliling di negeri orang Filistin untuk menyampaikan kabar itu kepada berhala-berhala mereka dan kepada rakyat."
 },
 {
   "id": 10672,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 10,
   "firman": "Kemudian mereka menaruh senjata-senjata Saul di kuil allah mereka, tetapi batu kepalanya dipakukan mereka di rumah Dagon."
 },
 {
   "id": 10673,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 11,
   "firman": "Ketika seluruh Yabesh-Gilead mendengar tentang segala yang telah dilakukan orang Filistin terhadap Saul,"
 },
 {
   "id": 10674,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 12,
   "firman": "maka bersiaplah segenap orang gagah perkasa, lalu pergi mengambil mayat Saul dan mayat anak-anaknya. Mereka membawanya ke Yabesh dan menguburkan tulang-tulang mereka di bawah pohon besar, di Yabesh. Sesudah itu berpuasalah mereka tujuh hari lamanya."
 },
 {
   "id": 10675,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 13,
   "firman": "Demikianlah Saul mati karena perbuatannya yang tidak setia terhadap TUHAN, oleh karena ia tidak berpegang pada firman TUHAN, dan juga karena ia telah meminta petunjuk dari arwah,"
 },
 {
   "id": 10676,
   "kitab": "1Ta",
   "pasal": 10,
   "ayat": 14,
   "firman": "dan tidak meminta petunjuk TUHAN. Sebab itu TUHAN membunuh dia dan menyerahkan jabatan raja itu kepada Daud bin Isai."
 },
 {
   "id": 10677,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 1,
   "firman": "Lalu berkumpullah seluruh Israel kepada Daud di Hebron dan berkata: \"Ketahuilah, kami ini darah dagingmu."
 },
 {
   "id": 10678,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 2,
   "firman": "Telah lama, ketika Saul memerintah, engkaulah yang memimpin segala gerakan orang Israel. Dan TUHAN, Allahmu, telah berfirman kepadamu: Engkaulah yang harus menggembalakan umat-Ku Israel, dan engkaulah yang menjadi raja atas umat-Ku Israel.\""
 },
 {
   "id": 10679,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 3,
   "firman": "Maka datanglah semua tua-tua Israel menghadap raja di Hebron, lalu Daud mengadakan perjanjian dengan mereka di Hebron di hadapan TUHAN, kemudian mereka mengurapi Daud menjadi raja atas Israel, seperti yang difirmankan TUHAN dengan perantaraan Samuel."
 },
 {
   "id": 10680,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 4,
   "firman": "Lalu Daud dengan seluruh orang Israel pergi ke Yerusalem; itulah Yebus, dan di sana orang Yebus adalah penduduk negeri itu."
 },
 {
   "id": 10681,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 5,
   "firman": "Penduduk Yebus berkata kepada Daud: \"Engkau tidak sanggup masuk ke mari.\" Tetapi Daud merebut kubu pertahanan Sion, yaitu kota Daud."
 },
 {
   "id": 10682,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 6,
   "firman": "Daud telah berkata: \"Siapa lebih dahulu memukul kalah orang Yebus, ia akan menjadi kepala dan pemimpin.\" Lalu Yoab, anak Zeruya, yang menyerang lebih dahulu, maka ia menjadi kepala."
 },
 {
   "id": 10683,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 7,
   "firman": "Lalu Daud menetap di kubu pertahanan itu, sebab itu orang menamainya: Kota Daud."
 },
 {
   "id": 10684,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 8,
   "firman": "Ia memperkuat kota itu sekelilingnya, mulai dari Milo, bahkan sekelilingnya seluruhnya, sedang Yoab membangun kembali selebihnya dari kota itu."
 },
 {
   "id": 10685,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 9,
   "firman": "Lalu makin lama makin besarlah kuasa Daud, sebab TUHAN semesta alam menyertainya."
 },
 {
   "id": 10686,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 10,
   "firman": "Inilah kepala-kepala para pahlawan yang mengiringi Daud, yang telah memberi dukungan yang kuat kepadanya, bersama-sama seluruh Israel, dalam mencapai kedudukan raja dan yang mengangkat dia sebagai raja, seperti yang difirmankan TUHAN mengenai Israel."
 },
 {
   "id": 10687,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 11,
   "firman": "Inilah daftar para pahlawan yang mengiringi Daud: Yasobam bin Hakhmoni, kepala triwira; ia mengayunkan tombaknya melawan tiga ratus orang yang tertikam mati dalam satu pertempuran."
 },
 {
   "id": 10688,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 12,
   "firman": "Dan sesudah dia, Eleazar anak Dodo, orang Ahohi itu; ia termasuk ketiga pahlawan itu."
 },
 {
   "id": 10689,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 13,
   "firman": "Ia ada bersama-sama Daud di Pas-Damim, ketika orang Filistin berkumpul di sana untuk berperang. Ada sebidang tanah ladang penuh jelai di sana; ketika tentara melarikan diri dari hadapan orang Filistin,"
 },
 {
   "id": 10690,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 14,
   "firman": "maka berdirilah mereka di tengah-tengah ladang itu; mereka dapat mempertahankannya dan memukul kalah orang Filistin. Demikianlah diberikan TUHAN kemenangan yang besar."
 },
 {
   "id": 10691,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 15,
   "firman": "Sekali datanglah tiga orang dari ketiga puluh kepala ke gunung batu mendapatkan Daud dekat gua Adulam, sedang tentara orang Filistin berkemah di lembah Refaim."
 },
 {
   "id": 10692,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 16,
   "firman": "Pada waktu itu Daud ada di dalam kubu gunung dan pasukan pendudukan orang Filistin pada waktu itu ada di Betlehem."
 },
 {
   "id": 10693,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 17,
   "firman": "Lalu timbullah keinginan pada Daud, dan ia berkata: \"Sekiranya ada orang yang memberi aku minum air dari perigi Betlehem yang ada dekat pintu gerbang!\""
 },
 {
   "id": 10694,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 18,
   "firman": "Lalu ketiga orang itu menerobos perkemahan orang Filistin, mereka menimba air dari perigi Betlehem yang ada dekat pintu gerbang, mengangkatnya dan membawanya kepada Daud. Tetapi Daud tidak mau meminumnya, melainkan mempersembahkannya sebagai korban curahan kepada TUHAN,"
 },
 {
   "id": 10695,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 19,
   "firman": "katanya: \"Jauhlah dari padaku, ya Allah, untuk berbuat demikian! Patutkah aku meminum darah taruhan nyawa orang-orang ini? Sebab dengan mempertaruhkan nyawanya mereka membawanya.\" Dan tidak mau ia meminumnya. Itulah yang dilakukan ketiga pahlawan itu."
 },
 {
   "id": 10696,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 20,
   "firman": "Abisai, adik Yoab, dialah kepala ketiga puluh orang itu. Dan dialah yang mengayunkan tombaknya melawan tiga ratus orang yang mati ditikamnya; ia mendapat nama di antara ketiga puluh orang itu."
 },
 {
   "id": 10697,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 21,
   "firman": "Di antara ketiga puluh orang itu ia paling dihormati. Memang ia menjadi pemimpin mereka, tetapi ia tidak dapat menyamai triwira itu."
 },
 {
   "id": 10698,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 22,
   "firman": "Selanjutnya Benaya bin Yoyada, anak seorang yang gagah perkasa, yang besar jasanya, yang berasal dari Kabzeel; ia menewaskan kedua pahlawan besar dari Moab. Juga pernah ia turun ke dalam lobang dan membunuh seekor singa pada suatu hari bersalju."
 },
 {
   "id": 10699,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 23,
   "firman": "Pula ia membunuh seorang Mesir, seorang yang tinggi perawakannya lima hasta tingginya; di tangan orang Mesir itu ada tombak seperti pesa tukang tenun, tetapi ia mendatanginya dengan tongkat, merampas tombak itu dari tangan orang Mesir itu, lalu membunuh orang itu dengan tombaknya sendiri."
 },
 {
   "id": 10700,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 24,
   "firman": "Itulah yang diperbuat Benaya bin Yoyada; ia mendapat nama di antara ketiga puluh pahlawan itu."
 },
 {
   "id": 10701,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 25,
   "firman": "Sesungguhnya, di antara ketiga puluh orang itu ia paling dihormati, tetapi ia tidak dapat menyamai triwira. Dan Daud mengangkat dia mengepalai pengawalnya."
 },
 {
   "id": 10702,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 26,
   "firman": "Pahlawan-pahlawan yang gagah perkasa ialah juga Asael, saudara Yoab, selanjutnya Elhanan bin Dodo, dari Betlehem;"
 },
 {
   "id": 10703,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 27,
   "firman": "Samot, orang Harod; Heles, orang Peloni;"
 },
 {
   "id": 10704,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 28,
   "firman": "Ira anak Ikesh orang Tekoa; Abiezer, orang Anatot;"
 },
 {
   "id": 10705,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 29,
   "firman": "Sibkhai, orang Husa; Ilai, orang Ahohi;"
 },
 {
   "id": 10706,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 30,
   "firman": "Maharai, orang Netofa; Heled bin Baana, orang Netofa;"
 },
 {
   "id": 10707,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 31,
   "firman": "Itai bin ribai, dari Gibea orang Benyamin; Benaya, orang Piraton;"
 },
 {
   "id": 10708,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 32,
   "firman": "Hurai dari lembah-lembah Gaas; Abiel, orang Bet-Araba;"
 },
 {
   "id": 10709,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 33,
   "firman": "Azmawet, orang Bahurim; Elyahba, orang Saalbon;"
 },
 {
   "id": 10710,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 34,
   "firman": "Hasyem orang Gizon; Yonatan bin Sage, orang Harari;"
 },
 {
   "id": 10711,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 35,
   "firman": "Ahiam bin Sakhar, orang Harari; Elifal bin Ur;"
 },
 {
   "id": 10712,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 36,
   "firman": "Hefer, orang Mekherati; Ahia, orang Peloni;"
 },
 {
   "id": 10713,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 37,
   "firman": "Hezro, orang Karmel; Naarai bin Esbai;"
 },
 {
   "id": 10714,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 38,
   "firman": "Yoel, saudara Natan; Mibhar bin Hagri;"
 },
 {
   "id": 10715,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 39,
   "firman": "Zelek, orang Amon; Naharai, orang Beerot, pembawa senjata Yoab anak Zeruya;"
 },
 {
   "id": 10716,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 40,
   "firman": "Ira, orang Yetri; Gareb, orang Yetri;"
 },
 {
   "id": 10717,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 41,
   "firman": "Uria, orang Het; Zabad bin Ahlai;"
 },
 {
   "id": 10718,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 42,
   "firman": "Adina anak Siza orang Ruben, kepala orang-orang Ruben dan beserta dia ada tiga puluh orang;"
 },
 {
   "id": 10719,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 43,
   "firman": "Hanan bin Maakha; Yosafat, orang Mitni;"
 },
 {
   "id": 10720,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 44,
   "firman": "Uzia, orang Asytarot; Syama dan Yeiel, anak-anak Hotam orang Aroer;"
 },
 {
   "id": 10721,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 45,
   "firman": "Yediael bin Simri, dan Yoha, saudaranya, orang Tizi;"
 },
 {
   "id": 10722,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 46,
   "firman": "Eliel, orang Mahawim; Yeribai dan Yosawya, anak-anak Elnaam; Yitma, orang Moab;"
 },
 {
   "id": 10723,
   "kitab": "1Ta",
   "pasal": 11,
   "ayat": 47,
   "firman": "Eliel, Obed dan Yaasiel, orang Mezobaya."
 },
 {
   "id": 10724,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 1,
   "firman": "Inilah orang-orang yang datang kepada Daud di Ziklag, selama ia harus menyingkir karena Saul bin Kish. Merekapun termasuk pahlawan-pahlawan yang membantu dia dalam peperangan."
 },
 {
   "id": 10725,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 2,
   "firman": "Mereka bersenjatakan panah, dan sanggup melontarkan batu dan menembakkan anak-anak panah dari busur dengan tangan kanan atau tangan kiri. Mereka itu dari saudara-saudara sesuku Saul, dari orang Benyamin:"
 },
 {
   "id": 10726,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 3,
   "firman": "Abiezer, kepala, dan Yoas, anak-anak Semaa orang Gibea; Yeziel dan Pelet, anak-anak Azmawet, Berakha dan Yehu, orang Anatot;"
 },
 {
   "id": 10727,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 4,
   "firman": "Yismaya, orang Gibeon, seorang pahlawan di antara ketiga puluh orang itu, yang mengepalai tiga puluh orang; Yeremia, Yehaziel, Yohanan dan Yozabad, orang Gedera;"
 },
 {
   "id": 10728,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 5,
   "firman": "Eluzai, Yerimot, Bealya, Semarya dan Sefaca, orang Harufi;"
 },
 {
   "id": 10729,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 6,
   "firman": "Elkana, Yisia, Azareel, Yoezer dan Yasobam, orang-orang Korah;"
 },
 {
   "id": 10730,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 7,
   "firman": "Yoela, Zebaja, anak-anak Yeroham, dari Gedor."
 },
 {
   "id": 10731,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 8,
   "firman": "Juga dari orang Gad ada yang memisahkan diri dan pergi kepada Daud ke kubu di padang gurun, yakni pahlawan-pahlawan yang gagah perkasa, orang-orang yang sanggup berperang, yang pandai menggunakan perisai dan tombak, dan rupa mereka seperti singa dan cepatnya seperti kijang di atas pegunungan."
 },
 {
   "id": 10732,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 9,
   "firman": "Ezer, kepala, Obaja, orang kedua; Eliab, orang ketiga;"
 },
 {
   "id": 10733,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 10,
   "firman": "Mismana, orang keempat; Yeremia, orang kelima;"
 },
 {
   "id": 10734,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 11,
   "firman": "Atai, orang keenam; Eliel, orang ketujuh;"
 },
 {
   "id": 10735,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 12,
   "firman": "Yohanan, orang kedelapan; Elzabad, orang kesembilan;"
 },
 {
   "id": 10736,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 13,
   "firman": "Yeremia, orang kesepuluh; Makhbanai, orang kesebelas."
 },
 {
   "id": 10737,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 14,
   "firman": "Mereka itulah dari bani Gad, kepala-kepala pasukan; satu orang yang paling kecil sanggup melawan seratus orang, dan yang paling besar sanggup melawan seribu orang."
 },
 {
   "id": 10738,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 15,
   "firman": "Mereka itulah yang menyeberangi sungai Yordan di bulan pertama, sekalipun sungai itu meluap sepanjang tepinya dan merekalah yang menghalau seluruh penduduk lembah ke sebelah timur dan ke sebelah barat."
 },
 {
   "id": 10739,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 16,
   "firman": "Sebagian dari bani Benyamin dan Yehuda datang kepada Daud di kubu itu,"
 },
 {
   "id": 10740,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 17,
   "firman": "lalu keluarlah Daud menyongsong mereka. Berkatalah ia kepada mereka: \"Jika kamu datang kepadaku dengan maksud damai untuk membantu aku, maka aku rela bersekutu dengan kamu, tetapi jika untuk menyerahkan aku dengan tipu muslihat kepada lawanku, sedang aku tidak melakukan kelaliman, maka biarlah Allah nenek moyang kita melihat itu dan menghukum kamu.\""
 },
 {
   "id": 10741,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 18,
   "firman": "Lalu Roh menguasai Amasai, kepala ketiga puluh orang itu: Kami ini bagimu, hai Daud, dan pada pihakmu, hai anak Isai! Sejahtera, sejahtera bagimu dan sejahtera bagi penolongmu, sebab yang menolong engkau ialah Allahmu! Kemudian Daud menyambut mereka dan mengangkat mereka menjadi kepala pasukan."
 },
 {
   "id": 10742,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 19,
   "firman": "Juga dari Manasye ada yang menyeberang memihak kepada Daud, ketika ia bersama-sama orang Filistin memerangi Saul. Sebenarnya ia tidak menolong mereka, sebab setelah mengambil keputusan raja-raja kota orang Filistin itu menyuruh dia pergi, katanya: \"Mungkin, dengan taruhan kepala kita, ia menyeberang memihak kepada tuannya, Saul.\""
 },
 {
   "id": 10743,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 20,
   "firman": "Pada perjalanannya ke Ziklag sebagian dari suku Manasye: Adnah, Yozabad, Yediael, Mikhael, Yozabad, Elihu dan Ziletai, kepala-kepala pasukan seribu suku Manasye menyeberang memihak kepadanya."
 },
 {
   "id": 10744,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 21,
   "firman": "Mereka ini membantu Daud melawan gerombolan, sebab mereka semua adalah pahlawan-pahlawan yang gagah perkasa dan kepala dalam tentara."
 },
 {
   "id": 10745,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 22,
   "firman": "Dari hari ke hari orang datang kepada Daud untuk membantu dia sehingga mereka menjadi tentara yang besar, seperti bala tentara Allah."
 },
 {
   "id": 10746,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 23,
   "firman": "Inilah jumlah pasukan bersenjata untuk berperang yang datang kepada Daud di Hebron untuk menyerahkan jabatan raja dari pada Saul kepada Daud, sesuai dengan titah TUHAN."
 },
 {
   "id": 10747,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 24,
   "firman": "Bani Yehuda yang mengangkat perisai dan tombak ada enam ribu delapan ratus orang yang siap untuk berperang."
 },
 {
   "id": 10748,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 25,
   "firman": "Dari bani Simeon pahlawan-pahlawan yang gagah perkasa untuk berperang ada tujuh ribu seratus orang."
 },
 {
   "id": 10749,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 26,
   "firman": "Dari bani Lewi ada empat ribu enam ratus orang,"
 },
 {
   "id": 10750,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 27,
   "firman": "ditambah dengan Yoyada, pemimpin kaum Harun dan bersama-sama dia ada tiga ribu tujuh ratus orang;"
 },
 {
   "id": 10751,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 28,
   "firman": "selanjutnya Zadok, seorang pahlawan muda yang gagah perkasa dengan dua puluh dua orang pemimpin dari puaknya."
 },
 {
   "id": 10752,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 29,
   "firman": "Dari bani Benyamin, saudara-saudara sesuku Saul, ada tiga ribu orang; sampai pada waktu itu kebanyakan dari mereka masih tetap patuh kepada keluarga Saul."
 },
 {
   "id": 10753,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 30,
   "firman": "Dari bani Efraim dua puluh ribu delapan ratus orang pahlawan yang gagah perkasa, orang-orang yang kenamaan di antara puak-puak mereka."
 },
 {
   "id": 10754,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 31,
   "firman": "Dari suku Manasye, suku yang setengah itu ada delapan belas ribu orang yang ditunjuk dengan disebut namanya untuk pergi mengangkat Daud menjadi raja."
 },
 {
   "id": 10755,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 32,
   "firman": "Dari bani Isakhar orang-orang yang mempunyai pengertian tentang saat-saat yang baik, sehingga mereka mengetahui apa yang harus diperbuat orang Israel: dua ratus orang kepala dengan segala saudara sesukunya yang di bawah perintah mereka."
 },
 {
   "id": 10756,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 33,
   "firman": "Dari Zebulon orang-orang yang sanggup berperang, yang pandai berperang dengan berbagai-bagai senjata: lima puluh ribu orang, yang siap memberi bantuan dengan tidak bercabang hati."
 },
 {
   "id": 10757,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 34,
   "firman": "Dari Naftali seribu orang pemimpin dan bersama-sama mereka tiga puluh tujuh ribu orang yang membawa perisai dan tombak."
 },
 {
   "id": 10758,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 35,
   "firman": "Dari orang Dan orang-orang yang siap untuk berperang: dua puluh delapan ribu enam ratus orang."
 },
 {
   "id": 10759,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 36,
   "firman": "Dari Asyer orang-orang yang sanggup dan pandai untuk berperang: empat puluh ribu orang."
 },
 {
   "id": 10760,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 37,
   "firman": "Dari seberang sungai Yordan, yakni dari orang Ruben, orang Gad dan setengah suku Manasye yang lain, orang-orang yang membawa berbagai-bagai senjata perang: seratus dua puluh ribu orang."
 },
 {
   "id": 10761,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 38,
   "firman": "Sekaliannya itu, prajurit-prajurit, orang-orang dalam barisan tempur, datang ke Hebron dengan tulus hati untuk mengangkat Daud menjadi raja atas seluruh Israel; memang juga seluruh orang Israel yang lain dengan bulat hati hendak mengangkat Daud menjadi raja."
 },
 {
   "id": 10762,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 39,
   "firman": "Mereka tinggal di sana bersama-sama Daud tiga hari lamanya, makan dan minum, sebab saudara-saudara mereka menyajikan makanan bagi mereka."
 },
 {
   "id": 10763,
   "kitab": "1Ta",
   "pasal": 12,
   "ayat": 40,
   "firman": "Juga orang-orang yang tinggal dekat mereka, bahkan dari Isakhar, Zebulon dan Naftali, membawa makanan dengan memakai keledai, unta, bagal dan lembu, yakni bahan makanan tepung, kue ara dan kue kismis, anggur dan minyak, lembu sapi dan kambing domba, dalam jumlah besar, sebab ada sukacita di Israel."
 },
 {
   "id": 10764,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 1,
   "firman": "Daud berunding dengan pemimpin-pemimpin pasukan seribu dan pasukan seratus dan dengan semua pemuka."
 },
 {
   "id": 10765,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 2,
   "firman": "Berkatalah Daud kepada seluruh jemaah Israel: \"Jika kamu anggap baik dan jika diperkenankan TUHAN, Allah kita, baiklah kita menyuruh orang kepada saudara-saudara kita yang masih tinggal di daerah-daerah orang Israel, dan di samping itu kepada para imam dan orang-orang Lewi yang ada di kota-kota yang dikelilingi tanah penggembalaan mereka, supaya mereka berkumpul kepada kita."
 },
 {
   "id": 10766,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 3,
   "firman": "Dan baiklah kita memindahkan tabut Allah kita ke tempat kita, sebab pada zaman Saul kita tidak mengindahkannya.\""
 },
 {
   "id": 10767,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 4,
   "firman": "Maka seluruh jemaah itu berkata, bahwa mereka akan berbuat demikian, sebab usul itu dianggap baik oleh segenap bangsa itu."
 },
 {
   "id": 10768,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 5,
   "firman": "Lalu Daud mengumpulkan semua orang Israel dari sungai Sikhor di Mesir sampai ke jalan yang menuju Hamat, untuk menjemput tabut Allah dari Kiryat-Yearim."
 },
 {
   "id": 10769,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 6,
   "firman": "Lalu Daud dan segenap orang Israel berangkat ke Baala, ke Kiryat-Yearim, yang termasuk wilayah Yehuda, untuk mengangkut dari sana tabut Allah, yang disebut dengan nama TUHAN yang bertakhta di atas kerubim."
 },
 {
   "id": 10770,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 7,
   "firman": "Mereka menaikkan tabut Allah itu ke dalam kereta yang baru dari rumah Abinadab, sedang Uza dan Ahyo mengantarkan kereta itu."
 },
 {
   "id": 10771,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 8,
   "firman": "Daud dan seluruh orang Israel menari-nari di hadapan Allah dengan sekuat tenaga, diiringi nyanyian, kecapi, gambus, rebana, ceracap dan nafiri."
 },
 {
   "id": 10772,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 9,
   "firman": "Ketika mereka sampai ke tempat pengirikan Kidon, maka Uza mengulurkan tangannya memegang tabut itu, karena lembu-lembu itu tergelincir."
 },
 {
   "id": 10773,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 10,
   "firman": "Maka bangkitlah murka TUHAN terhadap Uza, lalu Ia membunuh dia oleh karena Uza telah mengulurkan tangannya kepada tabut itu; ia mati di sana di hadapan Allah."
 },
 {
   "id": 10774,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 11,
   "firman": "Daud menjadi marah, karena TUHAN telah menyambar Uza demikian hebatnya; maka tempat itu disebut orang Peres-Uza sampai sekarang."
 },
 {
   "id": 10775,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 12,
   "firman": "Pada waktu itu Daud menjadi takut kepada Allah, lalu katanya: \"Bagaimanakah aku dapat membawa tabut Allah itu ke tempatku?\""
 },
 {
   "id": 10776,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 13,
   "firman": "Sebab itu Daud tidak mau memindahkan tabut itu ke tempatnya, ke kota Daud, tetapi Daud menyimpang dan membawanya ke rumah Obed-Edom, orang Gat itu."
 },
 {
   "id": 10777,
   "kitab": "1Ta",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tiga bulan lamanya tabut Allah itu tinggal pada keluarga Obed-Edom di rumahnya dan TUHAN memberkati keluarga Obed-Edom dan segala yang dipunyainya."
 },
 {
   "id": 10778,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 1,
   "firman": "Hiram, raja negeri Tirus, mengirim utusan kepada Daud dan kayu aras, tukang-tukang batu dan tukang-tukang kayu untuk mendirikan sebuah istana baginya."
 },
 {
   "id": 10779,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 2,
   "firman": "Lalu tahulah Daud, bahwa TUHAN telah menegakkan dia sebagai raja atas Israel, sebab martabat pemerintahannya terangkat tinggi oleh karena Israel umat-Nya."
 },
 {
   "id": 10780,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 3,
   "firman": "Daud mengambil lagi beberapa isteri di Yerusalem, dan ia memperanakkan lagi anak-anak lelaki dan perempuan."
 },
 {
   "id": 10781,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 4,
   "firman": "Inilah nama anak-anak yang lahir bagi dia di Yerusalem: Syamua, Sobab, Natan, Salomo,"
 },
 {
   "id": 10782,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 5,
   "firman": "Yibhar, Elisua, Elpelet,"
 },
 {
   "id": 10783,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 6,
   "firman": "Nogah, Nefeg, Yafia,"
 },
 {
   "id": 10784,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 7,
   "firman": "Elisama, Beelyada dan Elifelet."
 },
 {
   "id": 10785,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 8,
   "firman": "Ketika didengar orang Filistin, bahwa Daud telah diurapi menjadi raja atas seluruh Israel, maka majulah semua orang Filistin untuk menangkap Daud. Tetapi Daud mendengar hal itu, lalu majulah ia menghadapi mereka."
 },
 {
   "id": 10786,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 9,
   "firman": "Ketika orang Filistin itu datang dan mengadakan penyerbuan di lembah Refaim,"
 },
 {
   "id": 10787,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 10,
   "firman": "bertanyalah Daud kepada Allah: \"Apakah aku harus maju melawan orang Filistin itu dan akan Kauserahkankah mereka ke dalam tanganku?\" TUHAN menjawab: \"Majulah, Aku akan menyerahkan mereka ke dalam tanganmu.\""
 },
 {
   "id": 10788,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 11,
   "firman": "Lalu majulah ia ke Baal-Perasim, dan Daud memukul mereka kalah di sana. Berkatalah Daud: \"Allah telah menerobos musuhku dengan perantaraanku seperti air menerobos.\" Sebab itu orang menamakan tempat itu Baal-Perasim."
 },
 {
   "id": 10789,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 12,
   "firman": "Orang Filistin itu meninggalkan para allahnya di sana, lalu orang Israel membakarnya habis atas perintah Daud."
 },
 {
   "id": 10790,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 13,
   "firman": "Ketika orang Filistin menyerbu sekali lagi di lembah itu,"
 },
 {
   "id": 10791,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 14,
   "firman": "maka bertanyalah lagi Daud kepada Allah, lalu Allah menjawab: \"Janganlah maju di belakang mereka, tetapi buatlah gerakan lingkaran terhadap mereka, sehingga engkau dapat menyerang mereka dari jurusan pohon-pohon kertau."
 },
 {
   "id": 10792,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 15,
   "firman": "Dan bila engkau mendengar bunyi derap langkah di puncak pohon-pohon kertau itu, maka haruslah engkau keluar bertempur, sebab Allah telah keluar berperang di depanmu untuk memukul kalah tentara orang Filistin.\""
 },
 {
   "id": 10793,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dan Daud berbuat seperti yang diperintahkan Allah kepadanya, maka mereka memukul kalah tentara orang Filistin, mulai dari Gibeon sampai Gezer."
 },
 {
   "id": 10794,
   "kitab": "1Ta",
   "pasal": 14,
   "ayat": 17,
   "firman": "Lalu termasyhurlah nama Daud di segala negeri, dan TUHAN mendatangkan rasa takut kepadanya atas segala bangsa."
 },
 {
   "id": 10795,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 1,
   "firman": "Daud membuat bagi dirinya gedung-gedung di kota Daud, lalu ia menyiapkan tempat bagi tabut Allah dan membentangkan kemah untuk itu."
 },
 {
   "id": 10796,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 2,
   "firman": "Ketika itu berkatalah Daud: \"Janganlah ada yang mengangkat tabut Allah selain dari orang Lewi, sebab merekalah yang dipilih TUHAN untuk mengangkat tabut TUHAN dan untuk menyelenggarakannya sampai selama-lamanya.\""
 },
 {
   "id": 10797,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 3,
   "firman": "Kemudian Daud mengumpulkan segenap Israel ke Yerusalem untuk mengangkut tabut TUHAN ke tempat yang telah disiapkannya untuk itu."
 },
 {
   "id": 10798,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 4,
   "firman": "Daud mengumpulkan bani Harun dan orang Lewi:"
 },
 {
   "id": 10799,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 5,
   "firman": "dari bani Kehat: Uriel, seorang pemimpin, dan saudara-saudara sepuaknya: seratus dua puluh orang;"
 },
 {
   "id": 10800,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 6,
   "firman": "dari bani Merari: Asaya, seorang pemimpin, dan saudara-saudara sepuaknya: dua ratus dua puluh orang;"
 },
 {
   "id": 10801,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 7,
   "firman": "dari bani Gerson: Yoel, seorang pemimpin, dan saudara-saudara sepuaknya: seratus tiga puluh orang;"
 },
 {
   "id": 10802,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 8,
   "firman": "dari bani Elsafan: Semaya, seorang pemimpin, dan saudara-saudara sepuaknya: dua ratus orang;"
 },
 {
   "id": 10803,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 9,
   "firman": "dari bani Hebron: Eliel, seorang pemimpin, dan saudara-saudara sepuaknya: delapan puluh orang;"
 },
 {
   "id": 10804,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 10,
   "firman": "dari bani Uziel: Aminadab, seorang pemimpin, dan saudara-saudara sepuaknya: seratus dua belas orang."
 },
 {
   "id": 10805,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 11,
   "firman": "Lalu Daud memanggil Zadok dan Abyatar, imam-imam itu, dan orang-orang Lewi, yakni Uriel, Asaya, Yoel, Semaya, Eliel dan Aminadab,"
 },
 {
   "id": 10806,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 12,
   "firman": "dan berkata kepada mereka: \"Hai kamu ini, para kepala puak dari orang Lewi, kuduskanlah dirimu, kamu ini dan saudara-saudara sepuakmu, supaya kamu mengangkut tabut TUHAN, Allah Israel, ke tempat yang telah kusiapkan untuk itu."
 },
 {
   "id": 10807,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 13,
   "firman": "Sebab oleh karena pada pertama kali kamu tidak hadir, maka TUHAN, Allah kita, telah menyambar di tengah-tengah kita, sebab kita tidak meminta petunjuk-Nya seperti seharusnya.\""
 },
 {
   "id": 10808,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 14,
   "firman": "Jadi para imam dan orang-orang Lewi menguduskan dirinya untuk mengangkut tabut TUHAN, Allah Israel."
 },
 {
   "id": 10809,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 15,
   "firman": "Kemudian bani Lewi mengangkat tabut Allah itu dengan gandar pengusung di atas bahu mereka, seperti yang diperintahkan Musa, sesuai dengan firman TUHAN."
 },
 {
   "id": 10810,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 16,
   "firman": "Daud memerintahkan para kepala orang Lewi itu, supaya mereka menyuruh berdiri saudara-saudara sepuak mereka, yakni para penyanyi, dengan membawa alat-alat musik seperti gambus, kecapi dan ceracap, untuk memperdengarkan dengan nyaring lagu-lagu gembira."
 },
 {
   "id": 10811,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 17,
   "firman": "Maka orang Lewi itu menyuruh berdiri Heman bin Yoel; dan dari saudara-saudara sepuaknya: Asaf bin Berekhya; dari bani Merari, saudara-saudara sepuak mereka: Etan bin Kusaya;"
 },
 {
   "id": 10812,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 18,
   "firman": "dan bersama-sama mereka itu saudara-saudara mereka dari tingkat kedua: Zakharia, Yaaziel, Semiramot, Yehiel, Uni, Eliab, Benaya, Maaseya, Matica, Elifele, Mikneya, dan Obed-Edom serta Yeiel, para penunggu pintu gerbang."
 },
 {
   "id": 10813,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 19,
   "firman": "Para penyanyi, yakni Heman, Asaf dan Etan harus memperdengarkan lagu dengan ceracap tembaga."
 },
 {
   "id": 10814,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 20,
   "firman": "Zakharia, Aziel, Semiramot, Yehiel, Uni, Eliab, Maaseya, Benaya harus memainkan gambus yang tinggi nadanya,"
 },
 {
   "id": 10815,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 21,
   "firman": "sedang Matica, Elifele, Mikneya, Obed-Edom, Yeiel dan Azazya harus memainkan kecapi yang delapan nada lebih rendah tingkatnya untuk mengiringi nyanyian."
 },
 {
   "id": 10816,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 22,
   "firman": "Kenanya, pemimpin orang Lewi, mendapat tugas pengangkutan; ia mengepalai pengangkutan, sebab ia paham dalam hal itu."
 },
 {
   "id": 10817,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 23,
   "firman": "Berekhya dan Elkana adalah penunggu pintu pada tabut;"
 },
 {
   "id": 10818,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 24,
   "firman": "dan Sebanya, Yosafat, Netaneel, Amasai, Zakharia, Benaya dan Eliezer, yakni imam-imam itu, meniup nafiri di hadapan tabut Allah, sedang Obed-Edom dan Yehia adalah penunggu pintu pada tabut itu."
 },
 {
   "id": 10819,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 25,
   "firman": "Maka Daud dan para tua-tua Israel dan para pemimpin pasukan seribu pergi untuk mengangkut tabut perjanjian TUHAN itu dari rumah Obed-Edom dengan sukacita."
 },
 {
   "id": 10820,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 26,
   "firman": "Dan oleh karena Allah menolong orang Lewi yang mengangkat tabut perjanjian TUHAN itu, maka dipersembahkanlah tujuh ekor lembu jantan dan tujuh ekor domba jantan."
 },
 {
   "id": 10821,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 27,
   "firman": "Daud memakai jubah dari kain lenan halus, juga segala orang Lewi yang mengangkat tabut itu dan para penyanyi, dan Kenanya yang mengepalai pengangkutan dan para penyanyi. Daud juga memakai baju efod dari kain lenan."
 },
 {
   "id": 10822,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 28,
   "firman": "Seluruh orang Israel mengangkut tabut perjanjian TUHAN itu dengan diiringi sorak dan bunyi sangkakala, nafiri dan ceracap, sambil memperdengarkan permainan gambus dan kecapi."
 },
 {
   "id": 10823,
   "kitab": "1Ta",
   "pasal": 15,
   "ayat": 29,
   "firman": "Ketika tabut perjanjian TUHAN itu sampai ke kota Daud, maka Mikhal, anak perempuan Saul, menjenguk dari jendela, lalu melihat raja Daud melompat-lompat dan menari-nari. Sebab itu ia memandang rendah Daud dalam hatinya."
 },
 {
   "id": 10824,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 1,
   "firman": "Tabut Allah itu dibawa masuk, lalu diletakkan di tengah-tengah kemah yang dipasang Daud untuk itu, kemudian mereka mempersembahkan korban bakaran dan korban keselamatan di hadapan Allah."
 },
 {
   "id": 10825,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 2,
   "firman": "Setelah Daud selesai mempersembahkan korban bakaran dan korban keselamatan, diberkatinyalah bangsa itu demi nama TUHAN."
 },
 {
   "id": 10826,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 3,
   "firman": "Lalu dibagikannya kepada setiap orang Israel, baik laki-laki maupun perempuan, kepada masing-masing sekeping roti, sekerat daging dan sepotong kue kismis."
 },
 {
   "id": 10827,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 4,
   "firman": "Juga diangkatnya dari orang Lewi itu beberapa orang sebagai pelayan di hadapan tabut TUHAN untuk memasyhurkan TUHAN, Allah Israel dan menyanyikan syukur dan puji-pujian bagi-Nya."
 },
 {
   "id": 10828,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 5,
   "firman": "Kepala ialah Asaf dan sebagai orang kedua ialah Zakharia; lalu Yeiel, Semiramot, Yehiel, Matica, Eliab, Benaya, Obed-Edom dan Yeiel yang harus memainkan gambus dan kecapi, sedang Asaf harus memainkan ceracap"
 },
 {
   "id": 10829,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 6,
   "firman": "dan Benaya serta Yahaziel, imam-imam itu, selalu harus meniup nafiri di hadapan tabut perjanjian Allah itu."
 },
 {
   "id": 10830,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 7,
   "firman": "Kemudian pada hari itu juga, maka Daud untuk pertama kali menyuruh Asaf dan saudara-saudara sepuaknya menyanyikan syukur bagi TUHAN:"
 },
 {
   "id": 10831,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 8,
   "firman": "Bersyukurlah kepada TUHAN, panggillah nama-Nya, perkenalkanlah perbuatan-Nya di antara bangsa-bangsa!"
 },
 {
   "id": 10832,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 9,
   "firman": "Bernyanyilah bagi-Nya, bermazmurlah bagi-Nya, percakapkanlah segala perbuatan-Nya yang ajaib!"
 },
 {
   "id": 10833,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 10,
   "firman": "Bermegahlah di dalam nama-Nya yang kudus, biarlah bersukahati orang-orang yang mencari TUHAN!"
 },
 {
   "id": 10834,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 11,
   "firman": "Carilah TUHAN dan kekuatan-Nya, carilah wajah-Nya selalu!"
 },
 {
   "id": 10835,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 12,
   "firman": "Ingatlah perbuatan-perbuatan ajaib yang dilakukan-Nya, mujizat-mujizat-Nya dan penghukuman-penghukuman yang diucapkan-Nya,"
 },
 {
   "id": 10836,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 13,
   "firman": "hai anak cucu Israel, hamba-Nya, hai anak-anak Yakub, orang-orang pilihan-Nya!"
 },
 {
   "id": 10837,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 14,
   "firman": "Dialah TUHAN, Allah kita, di seluruh bumi berlaku penghukuman-Nya."
 },
 {
   "id": 10838,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 15,
   "firman": "Ia ingat untuk selama-lamanya akan perjanjian-Nya, akan firman yang diperintahkan-Nya kepada seribu angkatan,"
 },
 {
   "id": 10839,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 16,
   "firman": "yang diikat-Nya dengan Abraham, dan akan sumpah-Nya kepada Ishak,"
 },
 {
   "id": 10840,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 17,
   "firman": "diadakan-Nya bagi Yakub menjadi ketetapan, bagi Israel menjadi perjanjian kekal,"
 },
 {
   "id": 10841,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 18,
   "firman": "firman-Nya: \"Kepadamu akan Kuberi tanah Kanaan sebagai milik pusaka yang ditentukan bagimu.\""
 },
 {
   "id": 10842,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 19,
   "firman": "Ketika jumlah mereka tidak seberapa, sedikit saja, dan mereka orang-orang asing di sana,"
 },
 {
   "id": 10843,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 20,
   "firman": "dan mengembara dari bangsa yang satu ke bangsa yang lain, dan dari kerajaan yang satu ke suku bangsa yang lain,"
 },
 {
   "id": 10844,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 21,
   "firman": "Ia tidak membiarkan siapapun memeras mereka; dihukum-Nya raja-raja oleh karena mereka:"
 },
 {
   "id": 10845,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 22,
   "firman": "\"Jangan mengusik orang-orang yang Kuurapi, dan jangan berbuat jahat terhadap nabi-nabi-Ku!\""
 },
 {
   "id": 10846,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 23,
   "firman": "Bernyanyilah bagi TUHAN, hai segenap bumi, kabarkanlah keselamatan yang dari pada-Nya dari hari ke hari."
 },
 {
   "id": 10847,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 24,
   "firman": "Ceritakanlah kemuliaan-Nya di antara bangsa-bangsa dan perbuatan-perbuatan-Nya yang ajaib di antara segala suku bangsa."
 },
 {
   "id": 10848,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 25,
   "firman": "Sebab besar TUHAN dan terpuji sangat, dan lebih dahsyat Ia dari pada segala allah."
 },
 {
   "id": 10849,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 26,
   "firman": "Sebab segala allah bangsa-bangsa adalah berhala, tetapi Tuhanlah yang menjadikan langit."
 },
 {
   "id": 10850,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 27,
   "firman": "Keagungan dan semarak ada di hadapan-Nya, kekuatan dan sukacita ada di tempat-Nya."
 },
 {
   "id": 10851,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 28,
   "firman": "Kepada TUHAN, hai suku-suku bangsa, kepada TUHAN sajalah kemuliaan dan kekuatan!"
 },
 {
   "id": 10852,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 29,
   "firman": "Berilah kepada TUHAN kemuliaan nama-Nya, bawalah persembahan dan masuklah menghadap Dia! Sujudlah menyembah kepada TUHAN dengan berhiaskan kekudusan."
 },
 {
   "id": 10853,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 30,
   "firman": "Gemetarlah di hadapan-Nya hai segenap bumi; sungguh tegak dunia, tidak bergoyang."
 },
 {
   "id": 10854,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 31,
   "firman": "Biarlah langit bersukacita dan bumi bersorak-sorak, biarlah orang berkata di antara bangsa-bangsa: \"TUHAN itu Raja!\""
 },
 {
   "id": 10855,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 32,
   "firman": "Biarlah gemuruh laut serta isinya, biarlah beria-ria padang dan segala yang di atasnya,"
 },
 {
   "id": 10856,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 33,
   "firman": "maka pohon-pohon di hutan bersorak-sorai di hadapan TUHAN, sebab Ia datang untuk menghakimi bumi."
 },
 {
   "id": 10857,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 34,
   "firman": "Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 10858,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 35,
   "firman": "Dan katakanlah: \"Selamatkanlah kami, ya TUHAN Allah, Penyelamat kami, dan kumpulkanlah dan lepaskanlah kami dari antara bangsa-bangsa, supaya kami bersyukur kepada nama-Mu yang kudus, dan bermegah dalam puji-pujian kepada-Mu.\""
 },
 {
   "id": 10859,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 36,
   "firman": "Terpujilah TUHAN, Allah Israel, dari selama-lamanya sampai selama-lamanya. Maka seluruh umat mengatakan: \"Amin! Pujilah TUHAN!\""
 },
 {
   "id": 10860,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 37,
   "firman": "Lalu Daud meninggalkan di sana di hadapan tabut perjanjian TUHAN itu Asaf dan saudara-saudara sepuaknya untuk tetap melayani di hadapan tabut itu seperti yang patut dilakukan setiap hari;"
 },
 {
   "id": 10861,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 38,
   "firman": "juga Obed-Edom dan saudara-saudara sepuaknya yang enam puluh delapan orang itu; Obed-Edom bin Yedutun dan Hosa adalah penunggu-penunggu pintu gerbang."
 },
 {
   "id": 10862,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 39,
   "firman": "Tetapi Zadok, imam itu, dan saudara-saudara sepuaknya, para imam, ditinggalkannya di hadapan Kemah Suci TUHAN di bukit pengorbanan yang di Gibeon,"
 },
 {
   "id": 10863,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 40,
   "firman": "supaya pagi dan petang tetap dipersembahkan korban bakaran kepada TUHAN di atas mezbah korban bakaran, dan supaya dikerjakan segala yang tertulis dalam Taurat TUHAN yang diperintahkan-Nya kepada orang Israel."
 },
 {
   "id": 10864,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 41,
   "firman": "Dan bersama-sama mereka ikut Heman dan Yedutun dan selebihnya dari orang-orang yang terpilih, yang ditunjuk dengan disebut namanya untuk menyanyikan: \"Syukur bagi TUHAN. Bahwasanya untuk selama-lamanya kasih setia-Nya.\""
 },
 {
   "id": 10865,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 42,
   "firman": "Pada Heman dan Yedutun itu ada nafiri dan ceracap untuk para pemain, juga alat-alat musik pengiring nyanyian untuk Allah. Dan anak-anak Yedutun harus menjaga pintu gerbang."
 },
 {
   "id": 10866,
   "kitab": "1Ta",
   "pasal": 16,
   "ayat": 43,
   "firman": "Sesudah itu pergilah seluruh bangsa itu masing-masing ke rumahnya, dan Daud pulang untuk memberi salam kepada seisi rumahnya."
 },
 {
   "id": 10867,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 1,
   "firman": "Setelah Daud menetap di rumahnya, berkatalah ia kepada nabi Natan: \"Lihatlah, aku ini diam dalam rumah dari kayu aras, padahal tabut perjanjian TUHAN itu ada di bawah tenda-tenda.\""
 },
 {
   "id": 10868,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 2,
   "firman": "Lalu berkatalah Natan kepada Daud: \"Lakukanlah segala sesuatu yang dikandung hatimu, sebab Allah menyertai engkau.\""
 },
 {
   "id": 10869,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 3,
   "firman": "Tetapi pada malam itu juga datanglah firman Allah kepada Natan, demikian:"
 },
 {
   "id": 10870,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 4,
   "firman": "\"Pergilah, katakanlah kepada hamba-Ku Daud: Beginilah firman TUHAN: Bukanlah engkau yang akan mendirikan rumah bagi-Ku untuk didiami."
 },
 {
   "id": 10871,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 5,
   "firman": "Aku tidak pernah diam dalam rumah sejak Aku menuntun orang Israel keluar sampai hari ini, tetapi Aku mengembara dari kemah ke kemah, dan dari kediaman ke kediaman."
 },
 {
   "id": 10872,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 6,
   "firman": "Selama Aku mengembara bersama-sama seluruh orang Israel, pernahkah Aku mengucapkan firman kepada salah seorang hakim orang Israel, yang Kuperintahkan menggembalakan umat-Ku, demikian: Mengapa kamu tidak mendirikan bagi-Ku rumah dari kayu aras?"
 },
 {
   "id": 10873,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 7,
   "firman": "Oleh sebab itu, beginilah kaukatakan kepada hamba-Ku Daud: Beginilah firman TUHAN semesta alam: Akulah yang mengambil engkau dari padang, ketika menggiring kambing domba, untuk menjadi raja atas umat-Ku Israel."
 },
 {
   "id": 10874,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 8,
   "firman": "Aku telah menyertai engkau di segala tempat yang kaujalani dan telah melenyapkan segala musuhmu dari depanmu. Aku akan membuat namamu seperti nama orang-orang besar yang ada di bumi."
 },
 {
   "id": 10875,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 9,
   "firman": "Aku akan menentukan tempat bagi umat-Ku Israel dan akan menanamkannya, sehingga ia dapat diam di tempatnya sendiri dengan tidak lagi dikejutkan dan tidak pula ditekan oleh orang-orang lalim seperti dahulu,"
 },
 {
   "id": 10876,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 10,
   "firman": "sejak Aku mengangkat hakim-hakim atas umat-Ku Israel. Aku akan menundukkan segala musuhmu. Juga Aku beritahukan kepadamu: TUHAN akan membangun suatu keturunan bagimu."
 },
 {
   "id": 10877,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 11,
   "firman": "Apabila umurmu sudah genap untuk pergi mengikuti nenek moyangmu, maka Aku akan membangkitkan keturunanmu yang kemudian, salah seorang anakmu sendiri, dan Aku akan mengokohkan kerajaannya."
 },
 {
   "id": 10878,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 12,
   "firman": "Dialah yang akan mendirikan rumah bagi-Ku dan Aku akan mengokohkan takhtanya untuk selama-lamanya."
 },
 {
   "id": 10879,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 13,
   "firman": "Aku akan menjadi Bapanya, dan ia akan menjadi anak-Ku. Tetapi kasih setia-Ku tidak akan Kuhilangkan dari padanya seperti yang Kuhilangkan dari pada orang yang mendahului engkau."
 },
 {
   "id": 10880,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 14,
   "firman": "Dan Aku akan menegakkan dia dalam rumah-Ku dan dalam kerajaan-Ku untuk selama-lamanya dan takhtanya akan kokoh untuk selama-lamanya.\""
 },
 {
   "id": 10881,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 15,
   "firman": "Tepat seperti perkataan ini dan tepat seperti penglihatan ini Natan berbicara kepada Daud."
 },
 {
   "id": 10882,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 16,
   "firman": "Lalu masuklah raja Daud ke dalam, kemudian duduklah ia di hadapan TUHAN sambil berkata: \"Siapakah aku ini, ya TUHAN Allah, dan siapakah keluargaku, sehingga Engkau membawa aku sampai sedemikian ini?"
 },
 {
   "id": 10883,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 17,
   "firman": "Dan hal ini masih kurang di mata-Mu, ya Allah; sebab itu Engkau telah berfirman juga tentang keluarga hamba-Mu ini dalam masa yang masih jauh dan telah memperlihatkan kepadaku serentetan manusia yang akan datang, ya TUHAN Allah."
 },
 {
   "id": 10884,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 18,
   "firman": "Apakah lagi yang dapat ditambahkan Daud kepada-Mu dalam hal Engkau memuliakan hamba-Mu ini? Bukankah Engkau yang mengenal hamba-Mu ini?"
 },
 {
   "id": 10885,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 19,
   "firman": "Ya TUHAN, oleh karena hamba-Mu ini dan menurut hati-Mu Engkau telah melakukan segala perkara yang besar ini dengan memberitahukan segala perkara yang besar itu."
 },
 {
   "id": 10886,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 20,
   "firman": "Ya TUHAN, tidak ada yang sama seperti Engkau dan tidak ada Allah selain Engkau menurut segala yang kami tangkap dengan telinga kami."
 },
 {
   "id": 10887,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 21,
   "firman": "Dan bangsa manakah di bumi seperti umat-Mu Israel, yang Allahnya pergi membebaskannya menjadi umat-Nya, untuk mendapat nama bagi-Mu dengan perbuatan-perbuatan yang besar dan dahsyat, dan dengan menghalau bangsa-bangsa dari depan umat-Mu yang telah Kaubebaskan dari Mesir?"
 },
 {
   "id": 10888,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 22,
   "firman": "Engkau telah membuat umat-Mu Israel menjadi umat-Mu untuk selama-lamanya dan Engkau, ya TUHAN, menjadi Allah mereka."
 },
 {
   "id": 10889,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 23,
   "firman": "Dan sekarang, ya TUHAN, diteguhkanlah untuk selama-lamanya janji yang Kauucapkan mengenai hamba-Mu ini dan mengenai keluarganya dan lakukanlah seperti yang Kaujanjikan itu."
 },
 {
   "id": 10890,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 24,
   "firman": "Maka nama-Mu akan menjadi teguh dan besar untuk selama-lamanya, sehingga orang berkata: TUHAN semesta alam, Allah Israel adalah Allah bagi orang Israel; maka keluarga hamba-Mu Daud akan tetap kokoh di hadapan-Mu."
 },
 {
   "id": 10891,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 25,
   "firman": "Sebab Engkau, ya Allahku, telah menyatakan kepada hamba-Mu ini, bahwa Engkau akan membangun keturunan baginya. Itulah sebabnya hamba-Mu ini telah memberanikan diri untuk memanjatkan doa ke hadapan-Mu."
 },
 {
   "id": 10892,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 26,
   "firman": "Oleh sebab itu, ya TUHAN, Engkaulah Allah dan telah menjanjikan perkara yang baik ini kepada hamba-Mu."
 },
 {
   "id": 10893,
   "kitab": "1Ta",
   "pasal": 17,
   "ayat": 27,
   "firman": "Kiranya Engkau sekarang berkenan memberkati keluarga hamba-Mu ini, supaya tetap ada di hadapan-Mu untuk selama-lamanya. Sebab apa yang Engkau berkati, ya TUHAN, diberkati untuk selama-lamanya.\""
 },
 {
   "id": 10894,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 1,
   "firman": "Sesudah itu Daud memukul kalah orang Filistin dan menundukkan mereka; lalu ia merebut Gat dan segala anak kotanya dari tangan orang Filistin."
 },
 {
   "id": 10895,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 2,
   "firman": "Dan Daud memukul kalah orang Moab, sehingga orang Moab takluk kepadanya dan harus mempersembahkan upeti."
 },
 {
   "id": 10896,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 3,
   "firman": "Selanjutnya Daud memukul kalah Hadadezer, raja Zoba, dekat Hamat, ketika ia pergi menegakkan kekuasaannya pada sungai Efrat."
 },
 {
   "id": 10897,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 4,
   "firman": "Daud merebut dari padanya seribu kereta, tujuh ribu orang pasukan berkuda dan dua puluh ribu orang pasukan berjalan kaki, lalu Daud menyuruh memotong urat keting segala kuda kereta, tetapi dengan meninggalkan seratus ekor kuda kereta."
 },
 {
   "id": 10898,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 5,
   "firman": "Lalu orang Aram dari Damsyik datang menolong Hadadezer, raja Zoba, tetapi dari antara orang Aram itu Daud menewaskan dua puluh dua ribu orang."
 },
 {
   "id": 10899,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 6,
   "firman": "Kemudian Daud menempatkan pasukan-pasukan pendudukan di daerah orang Aram dari Damsyik, dan orang Aram itu menjadi budak Daud yang harus mempersembahkan upeti. TUHAN memberi kemenangan kepada Daud ke manapun ia pergi berperang."
 },
 {
   "id": 10900,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 7,
   "firman": "Sesudah itu Daud mengangkut perisai-perisai emas yang dipakai oleh orang-orang Hadadezer, lalu membawanya ke Yerusalem."
 },
 {
   "id": 10901,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 8,
   "firman": "Dan dari Tibhat dan dari Kun, yaitu kota-kotanya Hadadezer, Daud mengangkut amat banyak tembaga; dari padanya Salomo membuat \"laut\" tembaga, tiang-tiang dan perlengkapan tembaga."
 },
 {
   "id": 10902,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 9,
   "firman": "Ketika didengar Tou, raja Hamat, bahwa Daud telah memukul kalah seluruh tentara Hadadezer, raja Zoba,"
 },
 {
   "id": 10903,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 10,
   "firman": "maka ia mengutus Hadoram, anaknya, kepada raja Daud untuk menyampaikan salam dan mengucapkan selamat kepadanya, karena ia telah berperang melawan Hadadezer dan memukul dia kalah, sebab Hadadezer sering memerangi Tou. Dan Hadoram membawa pelbagai barang-barang emas, perak dan tembaga."
 },
 {
   "id": 10904,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 11,
   "firman": "Juga barang-barang ini dikhususkan raja Daud bagi TUHAN, bersama-sama perak dan emas yang diangkutnya dari segala bangsa, yakni dari orang Edom, dari orang Moab, dari bani Amon, dari orang Filistin dan dari orang Amalek."
 },
 {
   "id": 10905,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 12,
   "firman": "Abisai, anak Zeruya, menewaskan delapan belas ribu orang Edom di Lembah Asin."
 },
 {
   "id": 10906,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 13,
   "firman": "Lalu ia menempatkan pasukan-pasukan pendudukan di Edom, sehingga seluruh Edom diperbudak oleh Daud. TUHAN memberi kemenangan kepada Daud ke manapun ia pergi berperang."
 },
 {
   "id": 10907,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 14,
   "firman": "Demikianlah Daud telah memerintah atas seluruh Israel, dan menegakkan keadilan dan kebenaran bagi seluruh bangsanya."
 },
 {
   "id": 10908,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 15,
   "firman": "Yoab, anak Zeruya, menjadi panglima; Yosafat bin Ahilud menjadi bendahara;"
 },
 {
   "id": 10909,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 16,
   "firman": "Zadok bin Ahitub dan Ahimelekh bin Abyatar menjadi imam; Sausa menjadi panitera;"
 },
 {
   "id": 10910,
   "kitab": "1Ta",
   "pasal": 18,
   "ayat": 17,
   "firman": "Benaya bin Yoyada menjadi panglima orang Kreti dan orang Pleti; dan anak-anak Daud adalah orang-orang utama yang diperbantukan kepada raja."
 },
 {
   "id": 10911,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 1,
   "firman": "Sesudah itu matilah Nahas, raja bani Amon, lalu anaknya menjadi raja menggantikan dia."
 },
 {
   "id": 10912,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 2,
   "firman": "Lalu berkatalah Daud: \"Aku akan menunjukkan persahabatan kepada Hanun bin Nahas, sebab ayahnya telah menunjukkan persahabatan kepadaku.\" Sebab itu Daud mengirim utusan untuk menyampaikan pesan turut berdukacita kepadanya karena kematian ayahnya. Tetapi ketika pegawai-pegawai Daud sampai ke negeri bani Amon itu, kepada Hanun, untuk menyampaikan pesan turut berdukacita kepadanya,"
 },
 {
   "id": 10913,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 3,
   "firman": "berkatalah pemuka-pemuka bani Amon itu kepada Hanun: \"Apakah menurut anggapanmu Daud hendak menghormati ayahmu, karena ia telah mengutus kepadamu orang-orang yang menyampaikan pesan turut berdukacita? Bukankah dengan maksud untuk menyelidik, untuk mengintai dan menghancurkan negeri ini maka pegawai-pegawainya datang kepadamu?\""
 },
 {
   "id": 10914,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 4,
   "firman": "Lalu Hanun menyuruh menangkap pegawai-pegawai Daud itu, disuruhnya mencukur mereka dan memotong pakaian mereka pada bagian tengah sampai pangkal paha mereka, kemudian dilepasnya mereka."
 },
 {
   "id": 10915,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ketika mereka berjalan pulang, diberitahukan kepada Daud tentang orang-orang itu, lalu disuruhnya orang menemui mereka, sebab orang-orang itu sangat dipermalukan. Raja berkata: \"Tinggallah di Yerikho sampai janggutmu itu tumbuh, kemudian datanglah kembali.\""
 },
 {
   "id": 10916,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 6,
   "firman": "Setelah dilihat bani Amon, bahwa mereka telah membuat dirinya dibenci oleh Daud, maka Hanun dan bani Amon itu mengirim seribu talenta perak untuk menyewa kereta dan orang-orang berkuda dari Aram-Mesopotamia, dari Aram-Maakha dan dari Aram-Zoba."
 },
 {
   "id": 10917,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 7,
   "firman": "Mereka menyewa tiga puluh dua ribu kereta, serta raja negeri Maakha dengan tentaranya, yang datang berkemah dekat Medeba. Juga bani Amon itu berkumpul dari kota-kota mereka dan datang untuk berperang."
 },
 {
   "id": 10918,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 8,
   "firman": "Ketika Daud mendengar hal itu, disuruhnyalah Yoab maju dengan segenap tentara dan pahlawan."
 },
 {
   "id": 10919,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 9,
   "firman": "Lalu bani Amon maju, diaturnya barisan perangnya di depan pintu kota, sedang raja-raja yang ikut datang ada tersendiri di padang."
 },
 {
   "id": 10920,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 10,
   "firman": "Ketika Yoab melihat, bahwa serangan itu mengancam dia dari depan dan dari belakang, maka dipilihnyalah sebagian dari orang pilihan Israel, lalu ia mengatur barisan mereka berhadapan dengan orang Aram itu."
 },
 {
   "id": 10921,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 11,
   "firman": "Selebihnya dari rakyat itu ditempatkannya di bawah pimpinan Abisai, adiknya, dan mereka mengatur barisannya berhadapan dengan bani Amon itu."
 },
 {
   "id": 10922,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 12,
   "firman": "Lalu berkatalah Yoab: \"Jika orang Aram itu lebih kuat dari padaku, maka haruslah engkau menolong aku, tetapi jika bani Amon itu lebih kuat dari padamu, maka aku akan menolong engkau."
 },
 {
   "id": 10923,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 13,
   "firman": "Kuatkanlah hatimu dan marilah kita menguatkan hati untuk bangsa kita dan untuk kota-kota Allah kita. TUHAN kiranya melakukan yang baik di mata-Nya.\""
 },
 {
   "id": 10924,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 14,
   "firman": "Lalu Yoab dan tentara yang bersama-sama dengan dia maju menghadapi orang Aram itu untuk berperang dan orang-orang itu melarikan diri dari hadapannya."
 },
 {
   "id": 10925,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 15,
   "firman": "Ketika bani Amon melihat, bahwa orang Aram sudah melarikan diri, maka merekapun larilah dari hadapan Abisai, adik Yoab, dan masuk ke dalam kota. Sesudah itu Yoab pulang ke Yerusalem."
 },
 {
   "id": 10926,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 16,
   "firman": "Ketika orang Aram melihat, bahwa mereka telah terpukul kalah oleh orang Israel, maka mereka mengirim utusan-utusan dan menyuruh orang Aram yang di seberang sungai Efrat maju berperang di bawah pimpinan Sofakh, panglima tentara Hadadezer."
 },
 {
   "id": 10927,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 17,
   "firman": "Setelah hal itu diberitahukan kepada Daud, maka dikumpulkannya seluruh orang Israel, diseberanginya sungai Yordan, lalu sampai ke dekat mereka, dan diaturnya barisannya melawan mereka. Ketika Daud mengatur barisannya berhadapan dengan orang Aram itu untuk berperang, maka mereka bertempur melawan dia,"
 },
 {
   "id": 10928,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 18,
   "firman": "tetapi orang Aram itu lari dari hadapan orang Israel, dan Daud membunuh dari orang Aram itu tujuh ribu ekor kuda kereta dan empat puluh ribu orang pasukan berjalan kaki; juga Sofakh, panglima tentara itu, dibunuhnya."
 },
 {
   "id": 10929,
   "kitab": "1Ta",
   "pasal": 19,
   "ayat": 19,
   "firman": "Ketika dilihat orang-orang yang takluk kepada Hadadezer, bahwa mereka telah terpukul kalah oleh orang Israel, maka mereka mengadakan perdamaian dengan Daud dan takluk kepadanya; sesudah itu orang Aram tidak mau lagi memberi pertolongan kepada bani Amon."
 },
 {
   "id": 10930,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada pergantian tahun, pada waktu raja-raja biasanya maju berperang, maka Yoab membawa keluar bala tentaranya, lalu ia memusnahkan negeri bani Amon, kemudian ia maju dan mengepung kota Raba, sedang Daud sendiri tinggal di Yerusalem. Yoab memukul kalah Raba dan meruntuhkannya."
 },
 {
   "id": 10931,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 2,
   "firman": "Sesudah itu Daud mengambil mahkota dari kepala raja mereka, beratnya ternyata setalenta emas, bertatahkan sebuah batu permata yang mahal dan itu dikenakan pada kepala Daud. Juga diangkutnya banyak sekali jarahan dari kota itu."
 },
 {
   "id": 10932,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 3,
   "firman": "Penduduk kota itu diangkutnya dan dipaksanya bekerja dengan gergaji, penggerek besi dan kapak. Demikianlah juga diperlakukan Daud segala kota bani Amon. Sesudah itu pulanglah Daud dengan seluruh tentara ke Yerusalem."
 },
 {
   "id": 10933,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 4,
   "firman": "Sesudah itu timbullah pertempuran melawan orang Filistin di Gezer; pada waktu itu Sibkhai, orang Husa, memukul kalah Sipai, seorang dari keturunan raksasa, dan mereka ditundukkan."
 },
 {
   "id": 10934,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 5,
   "firman": "Maka terjadilah lagi pertempuran melawan orang Filistin, lalu Elhanan bin Yair menewaskan Lahmi, saudara Goliat, orang Gat itu, yang gagang tombaknya seperti pesa tukang tenun."
 },
 {
   "id": 10935,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 6,
   "firman": "Lalu terjadi lagi pertempuran di Gat; dan di sana ada seorang yang tinggi perawakannya, yang tangannya dan kakinya masing-masing berjari enam: dua puluh empat seluruhnya; juga orang ini termasuk keturunan raksasa."
 },
 {
   "id": 10936,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 7,
   "firman": "Ia mengolok-olok orang Israel, maka Yonatan, anak Simea kakak Daud, menewaskannya."
 },
 {
   "id": 10937,
   "kitab": "1Ta",
   "pasal": 20,
   "ayat": 8,
   "firman": "Orang-orang ini termasuk keturunan raksasa di Gat; mereka tewas oleh tangan Daud dan oleh tangan orang-orangnya."
 },
 {
   "id": 10938,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 1,
   "firman": "Iblis bangkit melawan orang Israel dan ia membujuk Daud untuk menghitung orang Israel."
 },
 {
   "id": 10939,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 2,
   "firman": "Lalu berkatalah Daud kepada Yoab dan kepada para pemuka rakyat: \"Pergilah, hitunglah orang Israel dari Bersyeba sampai Dan, dan bawalah hasilnya kepadaku, supaya aku tahu jumlah mereka.\""
 },
 {
   "id": 10940,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 3,
   "firman": "Lalu berkatalah Yoab: \"Kiranya TUHAN menambahi rakyat-Nya seratus kali lipat dari pada yang ada sekarang. Ya tuanku raja, bukankah mereka sekalian, hamba-hamba tuanku? Mengapa tuanku menuntut hal ini? Mengapa orang Israel harus menanggung kesalahan oleh karena hal itu?\""
 },
 {
   "id": 10941,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 4,
   "firman": "Namun titah raja itu terpaksa diikuti oleh Yoab, maka pergilah Yoab menjelajahi seluruh Israel, kemudian kembali ke Yerusalem."
 },
 {
   "id": 10942,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 5,
   "firman": "Lalu Yoab memberitahukan kepada Daud hasil pendaftaran rakyat. Di antara seluruh orang Israel ada sejuta seratus ribu orang yang dapat memegang pedang, dan orang Yehuda ada empat ratus tujuh puluh ribu orang yang dapat memegang pedang."
 },
 {
   "id": 10943,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 6,
   "firman": "Orang Lewi dan Benyamin tidak dimasukkannya dalam pendaftaran, sebab titah raja itu dianggap keji oleh Yoab."
 },
 {
   "id": 10944,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 7,
   "firman": "Tetapi hal itu jahat di mata Allah, sebab itu dihajar-Nya orang Israel."
 },
 {
   "id": 10945,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 8,
   "firman": "Lalu berkatalah Daud kepada Allah: \"Aku telah sangat berdosa karena melakukan hal ini; maka sekarang, jauhkanlah kiranya kesalahan hamba-Mu, sebab perbuatanku itu sangat bodoh.\""
 },
 {
   "id": 10946,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 9,
   "firman": "Tetapi berfirmanlah TUHAN kepada Gad, pelihat Daud:"
 },
 {
   "id": 10947,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 10,
   "firman": "\"Pergilah, katakanlah kepada Daud: Beginilah firman TUHAN: tiga perkara Kuhadapkan kepadamu; pilihlah salah satu dari padanya, maka Aku akan melakukannya kepadamu.\""
 },
 {
   "id": 10948,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 11,
   "firman": "Kemudian datanglah Gad kepada Daud, lalu berkatalah ia kepadanya: \"Beginilah firman TUHAN: Haruslah engkau memilih:"
 },
 {
   "id": 10949,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 12,
   "firman": "tiga tahun kelaparan atau tiga bulan lamanya melarikan diri dari hadapan lawanmu, sedang pedang musuhmu menyusul engkau, atau tiga hari pedang TUHAN, yakni penyakit sampar, ada di negeri ini, dan malaikat TUHAN mendatangkan kemusnahan di seluruh daerah orang Israel. Maka sekarang, timbanglah jawab apa yang harus kusampaikan kepada Yang mengutus aku.\""
 },
 {
   "id": 10950,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 13,
   "firman": "Lalu berkatalah Daud kepada Gad: \"Sangat susah hatiku, biarlah kiranya aku jatuh ke dalam tangan TUHAN, sebab sangat besar kasih sayang-Nya; tetapi janganlah aku jatuh ke dalam tangan manusia.\""
 },
 {
   "id": 10951,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 14,
   "firman": "Jadi TUHAN mendatangkan penyakit sampar kepada orang Israel, maka tewaslah dari orang Israel tujuh puluh ribu orang."
 },
 {
   "id": 10952,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 15,
   "firman": "Pula Allah mengutus malaikat ke Yerusalem untuk memusnahkannya, dan ketika hendak dimusnahkannya, maka TUHAN melihatnya, lalu menyesallah Ia karena malapetaka yang hendak didatangkan-Nya itu, lalu berfirmanlah Ia kepada malaikat pemusnah itu: \"Cukup! Turunkanlah sekarang tanganmu itu!\" Pada waktu itu malaikat TUHAN itu sedang berdiri dekat tempat pengirikan Ornan, orang Yebus."
 },
 {
   "id": 10953,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 16,
   "firman": "Ketika Daud mengangkat mukanya, maka dilihatnyalah malaikat TUHAN berdiri di antara bumi dan langit, dengan di tangannya pedang terhunus yang diacungkan ke atas Yerusalem. Lalu dengan berpakaian kain kabung sujudlah Daud dan para tua-tua."
 },
 {
   "id": 10954,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 17,
   "firman": "Dan berkatalah Daud kepada Allah: \"Bukankah aku ini yang menyuruh menghitung rakyat dan aku sendirilah yang telah berdosa dan yang melakukan kejahatan, tetapi domba-domba ini, apakah yang dilakukan mereka? Ya TUHAN, Allahku, biarlah kiranya tangan-Mu menimpa aku dan kaum keluargaku, tetapi janganlah tulah menimpa umat-Mu.\""
 },
 {
   "id": 10955,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 18,
   "firman": "Kemudian malaikat TUHAN menyuruh Gad mengatakan kepada Daud, bahwa Daud harus pergi untuk mendirikan mezbah bagi TUHAN di tempat pengirikan Ornan, orang Yebus itu."
 },
 {
   "id": 10956,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 19,
   "firman": "Lalu pergilah Daud, sesuai dengan perkataan Gad yang diucapkannya demi nama TUHAN."
 },
 {
   "id": 10957,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 20,
   "firman": "Ornan sedang mengirik gandum; ketika ia memalingkan diri, dilihatnyalah malaikat itu; keempat anaknya yang bersama-sama dengan dia menyembunyikan diri."
 },
 {
   "id": 10958,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 21,
   "firman": "Ketika Daud sampai kepada Ornan, maka Ornan mengangkat mukanya dan melihat Daud, lalu keluarlah ia dari tempat pengirikan, kemudian sujudlah ia kepada Daud dengan mukanya ke tanah."
 },
 {
   "id": 10959,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 22,
   "firman": "Berkatalah Daud kepada Ornan: \"Berikanlah kepadaku tempat pengirikan ini, supaya aku mendirikan di sini mezbah bagi TUHAN; baiklah berikan itu kepadaku dengan harga penuh, supaya tulah ini berhenti menimpa rakyat.\""
 },
 {
   "id": 10960,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 23,
   "firman": "Jawab Ornan kepada Daud: \"Ambillah, dan baiklah tuanku raja melakukan apa yang dipandangnya baik. Lihatlah, aku berikan lembu ini untuk korban bakaran dan eretan-eretan pengirik ini untuk kayu bakar dan gandum untuk korban sajian, semuanya itu kuberikan.\""
 },
 {
   "id": 10961,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 24,
   "firman": "Tetapi berkatalah raja Daud kepada Ornan: \"Bukan begitu, melainkan aku mau membelinya dengan harga penuh, sebab aku tidak mau mengambil milikmu untuk TUHAN dan tidak mau mempersembahkan korban bakaran dengan tidak membayar apa-apa.\""
 },
 {
   "id": 10962,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 25,
   "firman": "Maka Daud memberikan kepada Ornan sebagai bayaran tempat itu emas seberat enam ratus syikal."
 },
 {
   "id": 10963,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 26,
   "firman": "Lalu Daud mendirikan di sana mezbah bagi TUHAN, mempersembahkan korban bakaran dan korban keselamatan dan memanggil TUHAN. Maka TUHAN menjawab dia dengan menurunkan api dari langit ke atas mezbah korban bakaran itu."
 },
 {
   "id": 10964,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 27,
   "firman": "Lalu berfirmanlah TUHAN kepada malaikat itu supaya dikembalikannya pedangnya ke dalam sarungnya."
 },
 {
   "id": 10965,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 28,
   "firman": "Pada waktu itu juga Daud mempersembahkan korban di sana, ketika ia melihat, bahwa TUHAN telah menjawab dia di tempat pengirikan Ornan, orang Yebus itu."
 },
 {
   "id": 10966,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 29,
   "firman": "Kemah Suci, yang dibuat Musa di padang gurun, dan mezbah korban bakaran pada waktu itu ada di bukit pengorbanan di Gibeon,"
 },
 {
   "id": 10967,
   "kitab": "1Ta",
   "pasal": 21,
   "ayat": 30,
   "firman": "tetapi Daud tidak berani pergi ke sana berhadapan dengan Allah untuk menanyakan petunjuk-Nya, sebab ia takut kepada pedang malaikat TUHAN itu."
 },
 {
   "id": 10968,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu berkatalah Daud: \"Di sinilah rumah TUHAN, Allah kita, dan di sinilah mezbah untuk korban bakaran orang Israel.\""
 },
 {
   "id": 10969,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 2,
   "firman": "Daud menyuruh mengumpulkan orang-orang asing yang ada di negeri orang Israel, lalu ditempatkannya tukang-tukang untuk memahat batu-batu pahat yang akan dipakai untuk mendirikan rumah Allah."
 },
 {
   "id": 10970,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 3,
   "firman": "Selanjutnya Daud menyediakan sangat banyak besi untuk paku-paku bagi daun pintu gerbang dan bagi tupai-tupai, juga sangat banyak tembaga yang tidak tertimbang beratnya,"
 },
 {
   "id": 10971,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 4,
   "firman": "dan kayu aras yang tidak terbilang banyaknya, sebab orang Sidon dan orang Tirus membawa sangat banyak kayu aras bagi Daud."
 },
 {
   "id": 10972,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 5,
   "firman": "Karena pikir Daud: \"Salomo, anakku, masih muda dan kurang berpengalaman, dan rumah yang harus didirikannya bagi TUHAN haruslah luar biasa besarnya sehingga menjadi kenamaan dan termasyhur di segala negeri; sebab itu baiklah aku mengadakan persediaan baginya!\" Lalu Daud membuat sangat banyak persediaan sebelum ia mati."
 },
 {
   "id": 10973,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 6,
   "firman": "Kemudian dipanggilnya Salomo, anaknya, dan diberinya perintah kepadanya untuk mendirikan rumah bagi TUHAN, Allah Israel,"
 },
 {
   "id": 10974,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 7,
   "firman": "kata Daud kepada Salomo: \"Anakku, aku sendiri bermaksud hendak mendirikan rumah bagi nama TUHAN, Allahku,"
 },
 {
   "id": 10975,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 8,
   "firman": "tetapi firman TUHAN datang kepadaku, demikian: Telah kautumpahkan sangat banyak darah dan telah kaulakukan peperangan yang besar; engkau tidak akan mendirikan rumah bagi nama-Ku, sebab sudah banyak darah kautumpahkan ke tanah di hadapan-Ku."
 },
 {
   "id": 10976,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 9,
   "firman": "Sesungguhnya, seorang anak laki-laki akan lahir bagimu; ia akan menjadi seorang yang dikaruniai keamanan. Aku akan mengaruniakan keamanan kepadanya dari segala musuhnya di sekeliling. Ia akan bernama Salomo; sejahtera dan sentosa akan Kuberikan atas Israel pada zamannya."
 },
 {
   "id": 10977,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 10,
   "firman": "Dialah yang akan mendirikan rumah bagi nama-Ku dan dialah yang akan menjadi anak-Ku dan Aku akan menjadi Bapanya; Aku akan mengokohkan takhta kerajaannya atas Israel sampai selama-lamanya."
 },
 {
   "id": 10978,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 11,
   "firman": "Maka sekarang, hai anakku, TUHAN kiranya menyertai engkau, sehingga engkau berhasil mendirikan rumah TUHAN, Allahmu, seperti yang difirmankan-Nya mengenai engkau."
 },
 {
   "id": 10979,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 12,
   "firman": "Hanya, TUHAN kiranya memberikan kepadamu akal budi dan pengertian dan membuat engkau menjadi pemegang perintah atas Israel, supaya engkau memelihara Taurat TUHAN, Allahmu."
 },
 {
   "id": 10980,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 13,
   "firman": "Maka engkau akan berhasil, jika engkau melakukan dengan setia ketetapan-ketetapan dan hukum-hukum yang diperintahkan TUHAN kepada Musa untuk orang Israel. Kuatkan dan teguhkanlah hatimu, janganlah takut dan janganlah tawar hati."
 },
 {
   "id": 10981,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 14,
   "firman": "Sesungguhnya, sekalipun dalam kesusahan, aku telah menyediakan untuk rumah TUHAN itu seratus ribu talenta emas dan sejuta talenta perak dan sangat banyak tembaga dan besi, sehingga beratnya tidak tertimbang; juga aku telah menyediakan kayu dan batu. Tetapi baiklah engkau menambahnya lagi."
 },
 {
   "id": 10982,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 15,
   "firman": "Lagipula engkau mempunyai sangat banyak pekerja, yakni pemahat-pemahat batu, tukang-tukang batu dan kayu dan orang-orang yang ahli dalam segala macam pekerjaan"
 },
 {
   "id": 10983,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 16,
   "firman": "emas, perak, tembaga dan besi, yang tidak terhitung banyaknya. Mulailah bekerja! TUHAN kiranya menyertai engkau!\""
 },
 {
   "id": 10984,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 17,
   "firman": "Dan Daud memberi perintah kepada segala pembesar Israel itu untuk memberi bantuan kepada Salomo, anaknya, katanya:"
 },
 {
   "id": 10985,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 18,
   "firman": "\"Bukankah TUHAN, Allahmu, menyertai kamu dan telah mengaruniakan keamanan kepadamu ke segala penjuru. Sungguh, Ia telah menyerahkan penduduk negeri ini ke dalam tanganku, sehingga negeri ini takluk ke hadapan TUHAN dan kepada umat-Nya."
 },
 {
   "id": 10986,
   "kitab": "1Ta",
   "pasal": 22,
   "ayat": 19,
   "firman": "Maka sekarang, arahkanlah hati dan jiwamu untuk mencari TUHAN, Allahmu. Mulailah mendirikan tempat kudus TUHAN, Allah, supaya tabut perjanjian TUHAN dan perkakas kudus Allah dapat dibawa masuk ke dalam rumah yang didirikan bagi nama TUHAN.\""
 },
 {
   "id": 10987,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 1,
   "firman": "Setelah Daud menjadi tua dan lanjut umur, maka diangkatnya Salomo menjadi raja atas Israel."
 },
 {
   "id": 10988,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 2,
   "firman": "Ia mengumpulkan segala pembesar Israel, juga para imam dan orang-orang Lewi."
 },
 {
   "id": 10989,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 3,
   "firman": "Lalu dihitunglah orang-orang Lewi, yang berumur tiga puluh tahun ke atas, dan jumlah orang-orang mereka, dihitung satu demi satu, ada tiga puluh delapan ribu orang."
 },
 {
   "id": 10990,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 4,
   "firman": "--\"Dari orang-orang ini dua puluh empat ribu orang harus mengawasi pekerjaan di rumah TUHAN; enam ribu orang harus menjadi pengatur dan hakim;"
 },
 {
   "id": 10991,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 5,
   "firman": "empat ribu orang menjadi penunggu pintu gerbang; dan empat ribu orang menjadi pemuji TUHAN dengan alat-alat musik yang telah kubuat untuk melagukan puji-pujian,\" kata Daud."
 },
 {
   "id": 10992,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 6,
   "firman": "Juga Daud membagi-bagi mereka dalam rombongan menurut anak-anak Lewi, yakni Gerson, Kehat dan Merari."
 },
 {
   "id": 10993,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 7,
   "firman": "Termasuk orang Gerson ialah Ladan dan Simei."
 },
 {
   "id": 10994,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 8,
   "firman": "Anak-anak Ladan ialah Yehiel, seorang kepala, serta Zetam dan Yoel, tiga orang."
 },
 {
   "id": 10995,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 9,
   "firman": "Anak-anak Simei ialah Selomit, Haziel dan Haran, tiga orang; orang-orang inilah yang menjadi kepala puak Ladan."
 },
 {
   "id": 10996,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 10,
   "firman": "Anak-anak Simei ialah Yahat, Ziza, Yeush dan Beria; itulah anak-anak Simei, empat orang."
 },
 {
   "id": 10997,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 11,
   "firman": "Yahat ialah kepala dan Ziza orang kedua, tetapi Yeush dan Beria tidak mempunyai banyak anak, maka mereka merupakan hanya satu puak dengan satu jabatan."
 },
 {
   "id": 10998,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 12,
   "firman": "Anak-anak Kehat ialah Amram, Yizhar, Hebron dan Uziel, empat orang."
 },
 {
   "id": 10999,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 13,
   "firman": "Anak-anak Amram ialah Harun dan Musa; Harun ditunjuk untuk mengurus apa yang maha kudus, dia dan keturunannya, sampai selama-lamanya, untuk membakar korban di hadapan TUHAN, untuk melayani Dia dan untuk memberi berkat demi nama-Nya, sampai selama-lamanya."
 },
 {
   "id": 11000,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 14,
   "firman": "Anak-anak Musa, abdi Allah itu, digolongkan kepada suku Lewi."
 },
 {
   "id": 11001,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 15,
   "firman": "Anak-anak Musa ialah Gersom dan Eliezer."
 },
 {
   "id": 11002,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 16,
   "firman": "Anak Gersom ialah Sebuel, seorang kepala."
 },
 {
   "id": 11003,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 17,
   "firman": "Anak Eliezer ialah Rehabya, seorang kepala; Eliezer tidak mempunyai anak-anak lain, tetapi anak-anak Rehabya luar biasa banyaknya."
 },
 {
   "id": 11004,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 18,
   "firman": "Anak Yizhar ialah Selomit, seorang kepala."
 },
 {
   "id": 11005,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 19,
   "firman": "Anak-anak Hebron ialah Yeria, seorang kepala, Amarya, anak yang kedua, Yahaziel, anak yang ketiga dan Yekameam, anak yang keempat."
 },
 {
   "id": 11006,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 20,
   "firman": "Anak-anak Uziel ialah Mikha, seorang kepala, dan Yisia, anak yang kedua."
 },
 {
   "id": 11007,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 21,
   "firman": "Anak-anak Merari ialah Mahli dan Musi. Anak-anak Mahli ialah Eleazar dan Kish."
 },
 {
   "id": 11008,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 22,
   "firman": "Ketika Eleazar mati, ia tidak mempunyai anak laki-laki, hanya anak perempuan, lalu anak-anak Kish, saudara sepupu mereka, mengambil mereka menjadi isteri."
 },
 {
   "id": 11009,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 23,
   "firman": "Anak-anak Musi ialah Mahli, Eder dan Yeremot, tiga orang."
 },
 {
   "id": 11010,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 24,
   "firman": "Itulah bani Lewi menurut puak mereka, kepala-kepala puak mereka, pada waktu mereka dicatat seorang-seorang sesuai dengan bilangan nama mereka, orang demi orang, yang berumur dua puluh tahun atau lebih, merekalah yang harus melakukan pekerjaan untuk ibadah di rumah TUHAN."
 },
 {
   "id": 11011,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 25,
   "firman": "Sebab Daud telah berkata: \"TUHAN, Allah Israel, telah mengaruniakan keamanan kepada umat-Nya, dan Ia diam di Yerusalem sampai selama-lamanya."
 },
 {
   "id": 11012,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 26,
   "firman": "Dengan demikian tidak usah lagi orang Lewi mengangkat Bait Suci dan segala perkakas yang dipakai untuk ibadah di situ.\" --"
 },
 {
   "id": 11013,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 27,
   "firman": "Sebab sesuai dengan titah Daud yang belakangan, mereka yang didaftarkan dari anak-anak Lewi ialah yang berumur dua puluh tahun ke atas. --"
 },
 {
   "id": 11014,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 28,
   "firman": "\"Tugas mereka ialah membantu anak-anak Harun untuk menyelenggarakan ibadah di rumah TUHAN, mengawasi pelataran, bilik-bilik dan pentahiran segala barang kudus serta melakukan pekerjaan yang berhubungan dengan ibadah di rumah Allah."
 },
 {
   "id": 11015,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 29,
   "firman": "Juga mereka harus menyediakan sajian dan tepung yang terbaik untuk korban sajian, roti tipis yang tidak beragi, apa yang dipanggang di atas panggangan, apa yang teraduk dan segala sukatan dan ukuran."
 },
 {
   "id": 11016,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 30,
   "firman": "Selanjutnya mereka bertugas menyanyikan syukur dan puji-pujian bagi TUHAN setiap pagi, demikian juga pada waktu petang"
 },
 {
   "id": 11017,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 31,
   "firman": "dan pada waktu mempersembahkan segala korban bakaran kepada TUHAN, pada hari-hari Sabat, bulan-bulan baru, dan hari-hari raya, menurut jumlah yang sesuai dengan peraturan yang berlaku bagi mereka, sebagai tugas tetap di hadapan TUHAN."
 },
 {
   "id": 11018,
   "kitab": "1Ta",
   "pasal": 23,
   "ayat": 32,
   "firman": "Mereka harus melakukan pemeliharaan Kemah Pertemuan serta tempat kudus dan harus melayani anak-anak Harun, saudara-saudara mereka, untuk menyelenggarakan ibadah di rumah TUHAN.\""
 },
 {
   "id": 11019,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 1,
   "firman": "Inilah rombongan-rombongan anak-anak Harun. Anak-anak Harun ialah Nadab, Abihu, Eleazar dan Itamar."
 },
 {
   "id": 11020,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 2,
   "firman": "Tetapi Nadab dan Abihu mati lebih dahulu dari pada ayah mereka dengan tidak mempunyai anak laki-laki, maka yang memegang jabatan imam ialah Eleazar dan Itamar."
 },
 {
   "id": 11021,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 3,
   "firman": "Daud, bersama-sama Zadok dari bani Eleazar dan Ahimelekh dari bani Itamar, membagi-bagi mereka menurut jabatan mereka dalam penyelenggaraan ibadah."
 },
 {
   "id": 11022,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 4,
   "firman": "Lalu ternyata bahwa di antara keturunan Eleazar ada lebih banyak kepala kaum dari pada di antara keturunan Itamar, sebab itu orang membagi-bagi mereka sebagai berikut: untuk bani Eleazar enam belas orang kepala puak, tetapi untuk bani Itamar delapan orang kepala puak."
 },
 {
   "id": 11023,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 5,
   "firman": "Dan orang membagi-bagi mereka dengan membuang undi tanpa mengadakan perbedaan, sebab ada \"pemimpin-pemimpin kudus\" dan \"pemimpin-pemimpin Allah\", baik di antara keturunan Eleazar maupun di antara keturunan Itamar."
 },
 {
   "id": 11024,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 6,
   "firman": "Dan Semaya bin Netaneel, panitera itu, seorang Lewi, menulis nama mereka di depan raja, di depan pembesar-pembesar, imam Zadok, Ahimelekh bin Abyatar dan di depan kepala-kepala puak para imam dan orang Lewi; setiap kali satu puak diambil dari Eleazar, dan demikian pula satu puak dari Itamar."
 },
 {
   "id": 11025,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 7,
   "firman": "Undian yang pertama jatuh pada Yoyarib; yang kedua pada Yedaya;"
 },
 {
   "id": 11026,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 8,
   "firman": "yang ketiga pada Harim; yang keempat pada Seorim;"
 },
 {
   "id": 11027,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 9,
   "firman": "yang kelima pada Malkia; yang keenam pada Miyamin;"
 },
 {
   "id": 11028,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 10,
   "firman": "yang ketujuh pada Hakos; yang kedelapan pada Abia;"
 },
 {
   "id": 11029,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 11,
   "firman": "yang kesembilan pada Yesua; yang kesepuluh pada Sekhanya;"
 },
 {
   "id": 11030,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 12,
   "firman": "yang kesebelas pada Elyasib; yang kedua belas pada Yakim;"
 },
 {
   "id": 11031,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 13,
   "firman": "yang ketiga belas pada Hupa; yang keempat belas pada Yesebeab;"
 },
 {
   "id": 11032,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 14,
   "firman": "yang kelima belas pada Bilga; yang keenam belas pada Imer;"
 },
 {
   "id": 11033,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 15,
   "firman": "yang ketujuh belas pada Hezir; yang kedelapan belas pada Hapizes;"
 },
 {
   "id": 11034,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 16,
   "firman": "yang kesembilan belas pada Petahya; yang kedua puluh pada Yehezkel;"
 },
 {
   "id": 11035,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 17,
   "firman": "yang kedua puluh satu pada Yakhin; yang kedua puluh dua pada Gamul;"
 },
 {
   "id": 11036,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 18,
   "firman": "yang kedua puluh tiga pada Delaya; yang kedua puluh empat pada Maazya."
 },
 {
   "id": 11037,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 19,
   "firman": "Itulah jabatan mereka dalam menyelenggarakan ibadah setelah mereka masuk rumah TUHAN, sesuai dengan peraturan yang diberikan kepada mereka dengan perantaraan Harun, bapa leluhur mereka, seperti yang diperintahkan kepadanya oleh TUHAN, Allah Israel."
 },
 {
   "id": 11038,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 20,
   "firman": "Golongan yang masih tinggal dari bani Lewi, dari anak-anak Amram ialah Subael, dari anak-anak Subael ialah Yehdeya;"
 },
 {
   "id": 11039,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 21,
   "firman": "dari anak-anak Rehabya ialah Yisia, seorang kepala;"
 },
 {
   "id": 11040,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 22,
   "firman": "dari orang Yizhar ialah Selomot; dari anak-anak Selomot ialah Yahat."
 },
 {
   "id": 11041,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 23,
   "firman": "Anak-anak Hebron ialah Yeria, seorang kepala, Amarya, anak yang kedua, Yahaziel, anak yang ketiga, dan Yekameam, anak yang keempat."
 },
 {
   "id": 11042,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 24,
   "firman": "Anak Uziel ialah Mikha; dari anak-anak Mikha ialah Samir."
 },
 {
   "id": 11043,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 25,
   "firman": "Saudara Mikha ialah Yisia; dari anak-anak Yisia ialah Zakharia."
 },
 {
   "id": 11044,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 26,
   "firman": "Keturunan Merari ialah Mahli dan Musi, juga anak-anak Yaazia, anaknya."
 },
 {
   "id": 11045,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 27,
   "firman": "Keturunan Merari dari pihak Yaazia, anaknya, ialah Syoham, Zakur dan Hibri."
 },
 {
   "id": 11046,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 28,
   "firman": "Dari Mahli ialah Eleazar; dia ini tidak mempunyai anak."
 },
 {
   "id": 11047,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 29,
   "firman": "Dari Kish: anak Kish, yakni Yerahmeel."
 },
 {
   "id": 11048,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 30,
   "firman": "Anak-anak Musi ialah Mahli, Eder dan Yerimot. Itulah bani Lewi menurut puak mereka."
 },
 {
   "id": 11049,
   "kitab": "1Ta",
   "pasal": 24,
   "ayat": 31,
   "firman": "Mereka inipun, sama seperti saudara-saudara sesuku mereka, anak-anak Harun, membuang undi di depan raja Daud, di depan Zadok, Ahimelekh dan para kepala puak, para imam dan orang Lewi. Dalam hal ini seorang kepala puak sama dengan saudaranya yang terkecil."
 },
 {
   "id": 11050,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 1,
   "firman": "Selanjutnya untuk ibadah Daud dan para panglima menunjuk anak-anak Asaf, anak-anak Heman dan anak-anak Yedutun. Mereka bernubuat dengan diiringi kecapi, gambus dan ceracap. Daftar orang-orang yang bekerja dalam ibadah ini ialah yang berikut:"
 },
 {
   "id": 11051,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 2,
   "firman": "dari anak-anak Asaf ialah Zakur, Yusuf, Netanya dan Asarela, anak-anak Asaf di bawah pimpinan Asaf, yang bernubuat dengan petunjuk raja."
 },
 {
   "id": 11052,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 3,
   "firman": "Dari Yedutun ialah anak-anak Yedutun: Gedalya, Zeri, Yesaya, Simei, Hasabya dan Matica, enam orang, di bawah pimpinan ayah mereka, Yedutun, yang bernubuat dengan diiringi kecapi pada waktu menyanyikan syukur dan puji-pujian bagi TUHAN."
 },
 {
   "id": 11053,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 4,
   "firman": "Dari Heman ialah anak-anak Heman: Bukia, Matanya, Uziel, Sebuel, Yerimot, Hananya, Hanani, Eliata, Gidalti, Romamti-Ezer, Yosbekasa, Maloti, Hotir dan Mahaziot."
 },
 {
   "id": 11054,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 5,
   "firman": "Mereka ini sekalian adalah anak-anak Heman, pelihat raja, menurut janji Allah untuk meninggikan tanduk kekuatannya; sebab Allah telah memberikan kepada Heman empat belas orang anak laki-laki dan tiga orang anak perempuan."
 },
 {
   "id": 11055,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 6,
   "firman": "Mereka ini sekalian berada di bawah pimpinan ayah mereka pada waktu menyanyikan nyanyian di rumah TUHAN dengan diiringi ceracap, gambus dan kecapi untuk ibadah di rumah Allah dengan petunjuk raja. Demikianlah keadaan bani Asaf, Yedutun dan Heman."
 },
 {
   "id": 11056,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 7,
   "firman": "Jumlah mereka bersama-sama saudara-saudara mereka yang telah dilatih bernyanyi untuk TUHAN--mereka sekalian adalah ahli seni--ada dua ratus delapan puluh delapan orang."
 },
 {
   "id": 11057,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 8,
   "firman": "Tua dan muda, guru dan murid, membuang undi mengenai tugasnya."
 },
 {
   "id": 11058,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 9,
   "firman": "Lalu jatuhlah undian yang pertama pada Yusuf, orang Asaf; undian yang kedua pada Gedalya dengan saudara-saudaranya dan anak-anaknya, dua belas orang;"
 },
 {
   "id": 11059,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 10,
   "firman": "undian yang ketiga pada Zakur, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11060,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 11,
   "firman": "undian yang keempat pada Yizri, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11061,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 12,
   "firman": "undian yang kelima pada Netanya, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11062,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 13,
   "firman": "undian yang keenam pada Bukia, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11063,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 14,
   "firman": "undian yang ketujuh pada Yesarela, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11064,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 15,
   "firman": "undian yang kedelapan pada Yesaya, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11065,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 16,
   "firman": "undian yang kesembilan pada Matanya, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11066,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 17,
   "firman": "undian yang kesepuluh pada Simei, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11067,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 18,
   "firman": "undian yang kesebelas pada Azareel, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11068,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 19,
   "firman": "undian yang kedua belas pada Hasabya, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11069,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 20,
   "firman": "undian yang ketiga belas pada Subael, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11070,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 21,
   "firman": "undian yang keempat belas pada Matica, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11071,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 22,
   "firman": "undian yang kelima belas pada Yeremot, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11072,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 23,
   "firman": "undian yang keenam belas pada Hananya, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11073,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 24,
   "firman": "undian yang ketujuh belas pada Yosbekasa, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11074,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 25,
   "firman": "undian yang kedelapan belas pada Hanani, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11075,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 26,
   "firman": "undian yang kesembilan belas pada Maloti, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11076,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 27,
   "firman": "undian yang kedua puluh pada Eliata, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11077,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 28,
   "firman": "undian yang kedua puluh satu pada Hotir, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11078,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 29,
   "firman": "undian yang kedua puluh dua pada Gidalti, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11079,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 30,
   "firman": "undian yang kedua puluh tiga pada Mahaziot, anak-anaknya dan saudara-saudaranya, dua belas orang;"
 },
 {
   "id": 11080,
   "kitab": "1Ta",
   "pasal": 25,
   "ayat": 31,
   "firman": "undian yang kedua puluh empat pada Romamti-Ezer, anak-anaknya dan saudara-saudaranya, dua belas orang."
 },
 {
   "id": 11081,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 1,
   "firman": "Tentang rombongan para penunggu pintu: dari orang Korah ialah Meselemya bin Kore dari keturunan Ebyasaf."
 },
 {
   "id": 11082,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 2,
   "firman": "Meselemya mempunyai anak-anak, yakni Zakharia, anak sulung, Yediael, anak yang kedua, Zebaja, anak yang ketiga, Yatniel, anak yang keempat,"
 },
 {
   "id": 11083,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 3,
   "firman": "Elam, anak yang kelima, Yohanan, anak yang keenam, Elyoenai, anak yang ketujuh."
 },
 {
   "id": 11084,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 4,
   "firman": "Obed-Edom mempunyai anak-anak, yakni Semaya, anak sulung, Yozabad, anak yang kedua, Yoah, anak yang ketiga, Sakhar, anak yang keempat, Netaneel, anak yang kelima,"
 },
 {
   "id": 11085,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 5,
   "firman": "Amiel, anak yang keenam, Isakhar, anak yang ketujuh dan Peuletai, anak yang kedelapan, sebab Allah telah memberkati dia."
 },
 {
   "id": 11086,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 6,
   "firman": "Bagi Semaya, anak Obed-Edom itu, lahir anak-anak. Mereka memegang pemerintahan di antara puak mereka, sebab mereka itu adalah pahlawan-pahlawan yang gagah perkasa."
 },
 {
   "id": 11087,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 7,
   "firman": "Anak-anak Semaya ialah Otni, Refael, Obed dan Elzabad serta saudara-saudaranya, yakni Elihu dan Semakhya, orang-orang gagah perkasa."
 },
 {
   "id": 11088,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 8,
   "firman": "Mereka sekalian adalah dari keturunan Obed-Edom, yakni mereka sendiri, anak-anak mereka dan saudara-saudara mereka, masing-masing orang yang gagah perkasa, cakap untuk pekerjaan itu, enam puluh dua orang jumlahnya dari Obed-Edom."
 },
 {
   "id": 11089,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 9,
   "firman": "Dan Meselemya mempunyai delapan belas orang anak dan saudara, orang-orang yang gagah perkasa."
 },
 {
   "id": 11090,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 10,
   "firman": "Hosa dari bani Merari mempunyai anak-anak, yakni Simri, seorang kepala--sebab sekalipun ia bukan anak sulung, tetapi ayahnya mengangkat dia menjadi kepala--"
 },
 {
   "id": 11091,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 11,
   "firman": "Hilkia, anak yang kedua, Tebalya, anak yang ketiga dan Zakharia, anak yang keempat. Semua anak dan saudara Hosa itu ada tiga belas orang."
 },
 {
   "id": 11092,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 12,
   "firman": "Rombongan-rombongan para penunggu pintu itu, yang dibagi menurut kepala kaum, mempunyai tugas melayani di rumah TUHAN, sama seperti saudara-saudara sesuku mereka."
 },
 {
   "id": 11093,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 13,
   "firman": "Untuk setiap pintu gerbang mereka membuang undi, menurut puak-puak mereka, baik puak yang kecil maupun puak yang besar."
 },
 {
   "id": 11094,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 14,
   "firman": "Undian untuk pintu timur jatuh pada Selemya; selanjutnya mereka membuang undi bagi Zakharia, anaknya, seorang penasihat yang berakal budi, lalu jatuhlah undiannya untuk pintu utara."
 },
 {
   "id": 11095,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 15,
   "firman": "Bagi Obed-Edom ialah pintu selatan dan bagi anak-anaknya gudang perlengkapan."
 },
 {
   "id": 11096,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 16,
   "firman": "Bagi Supim dan Hosa ialah pintu barat beserta Pintu Gerbang Syalekhet di jalan raya tanjakan. Penjaga yang satu ditaruh berdampingan dengan penjaga yang lain."
 },
 {
   "id": 11097,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 17,
   "firman": "Di sebelah timur ada enam orang setiap hari, di sebelah utara ada empat orang setiap hari, di sebelah selatan ada empat orang setiap hari, tetapi pada gudang perlengkapan selalu ada dua orang;"
 },
 {
   "id": 11098,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 18,
   "firman": "pada Parbar di sebelah barat: empat orang di jalan raya dan dua orang pada Parbar."
 },
 {
   "id": 11099,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 19,
   "firman": "Itulah rombongan-rombongan para penunggu pintu dari bani Korah dan dari bani Merari."
 },
 {
   "id": 11100,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 20,
   "firman": "Orang-orang Lewi, saudara-saudara sesuku mereka, yang mengawasi perbendaharaan rumah Allah dan yang mengawasi perbendaharaan barang-barang kudus;"
 },
 {
   "id": 11101,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 21,
   "firman": "bani Ladan, yakni keturunan Gerson melalui Ladan, mempunyai orang-orang Yehiel sebagai kepala puak."
 },
 {
   "id": 11102,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 22,
   "firman": "Keturunan Yehiel, yakni Zetam dan Yoel, saudaranya, mengawasi perbendaharaan rumah TUHAN."
 },
 {
   "id": 11103,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 23,
   "firman": "Dari orang Amram, orang Yizhar, orang Hebron dan orang Uziel"
 },
 {
   "id": 11104,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 24,
   "firman": "adalah Sebuel bin Gersom bin Musa yang menjadi kepala perbendaharaan."
 },
 {
   "id": 11105,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 25,
   "firman": "Sanak saudara Sebuel melalui Eliezer ialah Rehabya, anak Eliezer, dan Yesaya, anak Rehabya, dan Yoram, anak Yesaya, dan Zikhri, anak Yoram, dan Selomit, anak Zikhri."
 },
 {
   "id": 11106,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 26,
   "firman": "Selomit ini beserta sanak saudaranya mengawasi perbendaharaan barang-barang kudus yang telah dikuduskan oleh raja Daud dan oleh para kepala puak dan para pemimpin pasukan seribu dan pasukan seratus dan para panglima."
 },
 {
   "id": 11107,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 27,
   "firman": "Mereka telah menguduskannya dari rampasan perang untuk menyemarakkan rumah TUHAN."
 },
 {
   "id": 11108,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 28,
   "firman": "Juga segala yang dikuduskan oleh Samuel, pelihat itu, oleh Saul bin Kish, oleh Abner bin Ner dan oleh Yoab, anak Zeruya, ya segala barang yang dikuduskan ada di bawah pengawasan Selomit beserta sanak saudaranya."
 },
 {
   "id": 11109,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 29,
   "firman": "Dari orang Yizhar adalah Kenanya beserta anak-anaknya yang diserahi tugas luar di Israel, yaitu menjadi pengatur dan hakim."
 },
 {
   "id": 11110,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 30,
   "firman": "Dari orang Hebron adalah Hasabya beserta sanak saudaranya, orang-orang gagah perkasa, seribu tujuh ratus orang jumlahnya, yang diserahi urusan pemerintahan Israel di sebelah barat sungai Yordan dalam segala urusan untuk TUHAN dan segala pekerjaan untuk raja."
 },
 {
   "id": 11111,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 31,
   "firman": "Dari orang Hebron adalah Yeria yang menjadi kepala. Tentang orang Hebron, mengenai keturunannya dan puaknya, dalam tahun keempat puluh zaman pemerintahan Daud diadakan penyelidikan tentang mereka dan ternyata, bahwa di antara mereka ada pahlawan-pahlawan yang gagah perkasa di Yaezer-Gilead."
 },
 {
   "id": 11112,
   "kitab": "1Ta",
   "pasal": 26,
   "ayat": 32,
   "firman": "Sanak saudara Yeria, orang-orang yang gagah perkasa, kepala-kepala puak ada dua ribu tujuh ratus orang. Mereka itu diangkat raja Daud mengawasi orang Ruben, orang Gad dan suku Manasye yang setengah itu dalam segala perkara untuk Allah dan segala perkara untuk raja."
 },
 {
   "id": 11113,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 1,
   "firman": "Adapun orang Israel, inilah daftar para kepala puak, para panglima pasukan seribu dan pasukan seratus dan para pengatur yang melayani raja dalam segala hal mengenai rombongan orang-orang yang bertugas dan libur, bulan demi bulan, sepanjang tahun. Setiap rombongan berjumlah dua puluh empat ribu orang."
 },
 {
   "id": 11114,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 2,
   "firman": "Yang mengepalai rombongan pertama untuk bulan pertama ialah Yasobam bin Zabdiel dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11115,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 3,
   "firman": "Ia dari bani Peres dan mengepalai semua panglima untuk bulan yang pertama."
 },
 {
   "id": 11116,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 4,
   "firman": "Yang mengepalai rombongan bulan yang kedua ialah Dodai, orang Ahohi, sedang pemimpin rombongannya yang berjumlah dua puluh empat ribu orang, adalah Miklot."
 },
 {
   "id": 11117,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 5,
   "firman": "Panglima yang ketiga untuk bulan yang ketiga ialah Benaya, anak imam kepala Yoyada, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11118,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 6,
   "firman": "Benaya ini adalah seorang dari ketiga puluh pahlawan dan mengepalai ketiga puluh orang itu, tetapi yang memegang pimpinan rombongannya ialah Amizabad, anaknya."
 },
 {
   "id": 11119,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 7,
   "firman": "Yang keempat untuk bulan yang keempat ialah Asael, saudara Yoab, kemudian ia digantikan oleh Zebaja, anaknya, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11120,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 8,
   "firman": "Yang kelima untuk bulan yang kelima ialah Samhut orang Yizrah, panglima itu, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11121,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 9,
   "firman": "Yang keenam untuk bulan yang keenam ialah Ira anak Ikesh orang Tekoa dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11122,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 10,
   "firman": "Yang ketujuh untuk bulan yang ketujuh ialah Heles, orang Peloni, dari bani Efraim, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11123,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 11,
   "firman": "Yang kedelapan untuk bulan yang kedelapan ialah Sibkhai, orang Husa dari orang Zerah itu, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11124,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 12,
   "firman": "Yang kesembilan untuk bulan yang kesembilan ialah Abiezer, orang Anatot itu, dari bani Benyamin, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11125,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 13,
   "firman": "Yang kesepuluh untuk bulan yang kesepuluh ialah Maharai, orang Netofa dari orang Zerah itu, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11126,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 14,
   "firman": "Yang kesebelas untuk bulan yang kesebelas ialah Benaya, orang Piraton, dari bani Efraim, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11127,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 15,
   "firman": "Yang kedua belas untuk bulan yang kedua belas ialah Heldai, orang Netofa itu, keturunan Otniel, dan dalam rombongannya ada dua puluh empat ribu orang."
 },
 {
   "id": 11128,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 16,
   "firman": "Yang mengepalai suku-suku Israel: untuk orang Ruben ialah Eliezer bin Zikhri sebagai pemimpin; untuk orang Simeon ialah Sefaca bin Maakha;"
 },
 {
   "id": 11129,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 17,
   "firman": "untuk suku Lewi ialah Hasabya bin Kemuel; untuk keturunan Harun ialah Zadok;"
 },
 {
   "id": 11130,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 18,
   "firman": "untuk suku Yehuda ialah Elihu, salah seorang saudara Daud; untuk suku Isakhar ialah Omri bin Mikhael;"
 },
 {
   "id": 11131,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 19,
   "firman": "untuk suku Zebulon ialah Yismaya bin Obaja; untuk suku Naftali ialah Yerimot bin Azriel;"
 },
 {
   "id": 11132,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 20,
   "firman": "untuk bani Efraim ialah Hosea bin Azazya; untuk setengah suku Manasye ialah Yoel bin Pedaya;"
 },
 {
   "id": 11133,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 21,
   "firman": "untuk setengah suku Manasye yang di Gilead ialah Yido bin Zakharia; untuk suku Benyamin ialah Yaasiel bin Abner;"
 },
 {
   "id": 11134,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 22,
   "firman": "untuk suku Dan ialah Azareel bin Yeroham. Itulah para kepala suku-suku Israel."
 },
 {
   "id": 11135,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 23,
   "firman": "Daud tidak menghitung jumlah orang-orang yang berumur dua puluh tahun ke bawah, sebab TUHAN telah menjanjikan untuk membuat orang Israel sebanyak bintang-bintang di langit."
 },
 {
   "id": 11136,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 24,
   "firman": "Memang Yoab, anak Zeruya, telah mulai menghitung, tetapi ia tidak menyelesaikannya, sebab oleh karena hal itu orang Israel tertimpa murka; dengan demikian jumlah mereka tidak dibukukan dalam kitab sejarah raja Daud."
 },
 {
   "id": 11137,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 25,
   "firman": "Yang mengawasi persediaan raja ialah Azmawet bin Adiel dan yang mengawasi persediaan di luar kota, di kota-kota, di desa-desa dan di dalam menara-menara lumbung ialah Yonatan bin Uzia."
 },
 {
   "id": 11138,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 26,
   "firman": "Yang mengawasi para pekerja di ladang yang harus mengusahakan tanah ialah Ezri bin Kelub."
 },
 {
   "id": 11139,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 27,
   "firman": "Yang mengawasi kebun-kebun anggur ialah Simei, orang Rama. Yang mengawasi hasil kebun anggur untuk persediaan anggur ialah Zabdi, orang Syifmi."
 },
 {
   "id": 11140,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 28,
   "firman": "Yang mengawasi pohon-pohon zaitun dan pohon-pohon ara di Daerah Bukit ialah Baal-Hanan, orang Gederi; yang mengawasi persediaan minyak ialah Yoas."
 },
 {
   "id": 11141,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 29,
   "firman": "Yang mengawasi lembu sapi yang digembalakan di tanah Saron ialah Sitrai, orang Saron; yang mengawasi lembu sapi di lembah-lembah ialah Safat bin Adlai."
 },
 {
   "id": 11142,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 30,
   "firman": "Yang mengawasi unta-unta ialah Obil, orang Ismael; yang mengawasi keledai-keledai betina ialah Yehdeya, orang Meronot."
 },
 {
   "id": 11143,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 31,
   "firman": "Yang mengawasi kambing domba ialah Yazis, orang Hagri. Mereka ini sekalian ialah para pengawas harta milik raja Daud."
 },
 {
   "id": 11144,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 32,
   "firman": "Yonatan, saudara ayah Daud, adalah penasihat; dia seorang cerdas dan ahli kitab. Yehiel bin Hakhmoni membantu anak-anak raja."
 },
 {
   "id": 11145,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 33,
   "firman": "Ahitofel adalah penasihat raja; Husai, orang Arki, adalah sahabat raja."
 },
 {
   "id": 11146,
   "kitab": "1Ta",
   "pasal": 27,
   "ayat": 34,
   "firman": "Yang menggantikan Ahitofel kemudian ialah Yoyada bin Benaya dan Abyatar. Panglima raja ialah Yoab."
 },
 {
   "id": 11147,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 1,
   "firman": "Daud mengumpulkan di Yerusalem segala pembesar Israel, yakni para kepala suku, para pemimpin rombongan orang-orang yang melayani raja, para kepala pasukan seribu dan kepala pasukan seratus, serta para kepala harta benda dan ternak kepunyaan raja dan anak-anaknya; bersama-sama mereka juga para pegawai istana dan para perwira dan semua pahlawan yang gagah perkasa."
 },
 {
   "id": 11148,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 2,
   "firman": "Lalu berdirilah raja Daud dan berkata: \"Dengarlah, hai saudara-saudaraku dan bangsaku! Aku bermaksud hendak mendirikan rumah perhentian untuk tabut perjanjian TUHAN dan untuk tumpuan kaki Allah kita; juga aku telah membuat persediaan untuk mendirikannya."
 },
 {
   "id": 11149,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 3,
   "firman": "Tetapi Allah telah berfirman kepadaku: Engkau tidak akan mendirikan rumah bagi nama-Ku, sebab engkau ini seorang prajurit dan telah menumpahkan darah."
 },
 {
   "id": 11150,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 4,
   "firman": "Namun TUHAN, Allah Israel, telah memilih aku dari antara segenap puakku untuk menjadi raja atas Israel selama-lamanya; sebab Ia telah memilih Yehuda menjadi pemimpin, dan puakku dari antara kaum Yehuda, dan dari antara anak-anak ayahku Ia berkenan kepadaku untuk mengangkat aku sebagai raja atas seluruh Israel."
 },
 {
   "id": 11151,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 5,
   "firman": "Dan dari antara anak-anakku sekalian--sebab banyak anak telah dikaruniakan TUHAN kepadaku--Ia telah memilih anakku Salomo untuk duduk di atas takhta pemerintahan TUHAN atas Israel."
 },
 {
   "id": 11152,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 6,
   "firman": "Ia telah berfirman kepadaku: Salomo, anakmu, dialah yang akan mendirikan rumah-Ku dan pelataran-Ku sebab Aku telah memilih dia menjadi anak-Ku dan Aku akan menjadi bapanya."
 },
 {
   "id": 11153,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 7,
   "firman": "Dan Aku akan mengokohkan kerajaannya sampai selama-lamanya, jika ia bertekun melakukan segala perintah dan peraturan-Ku seperti sekarang ini."
 },
 {
   "id": 11154,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 8,
   "firman": "Maka sekarang, di depan mata seluruh Israel, jemaah TUHAN, dan dengan didengar Allah kita, aku berkata kepadamu: Peliharalah dan tuntutlah segala perintah TUHAN, Allahmu, supaya kamu tetap menduduki negeri yang baik ini dan mewariskannya sampai selama-lamanya kepada anak-anakmu yang kemudian."
 },
 {
   "id": 11155,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 9,
   "firman": "Dan engkau, anakku Salomo, kenallah Allahnya ayahmu dan beribadahlah kepada-Nya dengan tulus ikhlas dan dengan rela hati, sebab TUHAN menyelidiki segala hati dan mengerti segala niat dan cita-cita. Jika engkau mencari Dia, maka Ia berkenan ditemui olehmu, tetapi jika engkau meninggalkan Dia maka Ia akan membuang engkau untuk selamanya."
 },
 {
   "id": 11156,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 10,
   "firman": "Camkanlah sekarang, sebab TUHAN telah memilih engkau untuk mendirikan sebuah rumah menjadi tempat kudus. Kuatkanlah hatimu dan lakukanlah itu.\""
 },
 {
   "id": 11157,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 11,
   "firman": "Lalu Daud menyerahkan kepada Salomo, anaknya, rencana bangunan dari balai Bait Suci dan ruangan-ruangannya, dari perbendaharaannya, kamar-kamar atas dan kamar-kamar dalamnya, serta dari ruangan untuk tutup pendamaian."
 },
 {
   "id": 11158,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 12,
   "firman": "Selanjutnya rencana dari segala yang dipikirkannya mengenai pelataran rumah TUHAN, dan bilik-bilik di sekelilingnya, mengenai perbendaharaan-perbendaharaan rumah Allah dan perbendaharaan-perbendaharaan barang-barang kudus;"
 },
 {
   "id": 11159,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 13,
   "firman": "mengenai rombongan-rombongan para imam dan para orang Lewi dan mengenai segala pekerjaan untuk ibadah di rumah TUHAN dan segala perkakas untuk ibadah di rumah TUHAN."
 },
 {
   "id": 11160,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 14,
   "firman": "Juga ia memberikan emas seberat yang diperlukan untuk segala perkakas pada tiap-tiap ibadah; dan diberikannya perak seberat yang diperlukan untuk segala perkakas perak pada tiap-tiap ibadah,"
 },
 {
   "id": 11161,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 15,
   "firman": "yakni sejumlah emas untuk kandil-kandil emas dan lampu-lampunya yang dari emas, seberat yang diperlukan tiap-tiap kandil dan lampu-lampunya, dan perak untuk kandil perak seberat yang diperlukan perak untuk satu kandil dan lampu-lampunya, sesuai dengan pemakaian tiap-tiap kandil dalam ibadah."
 },
 {
   "id": 11162,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 16,
   "firman": "Kemudian diberikannya sejumlah emas untuk meja-meja roti sajian, meja demi meja, dan perak untuk meja-meja dari perak;"
 },
 {
   "id": 11163,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 17,
   "firman": "selanjutnya emas murni untuk garpu-garpu, dan bokor-bokor penyiraman dan kendi-kendi, juga untuk piala-piala dari emas seberat yang diperlukan untuk tiap-tiap piala, dan perak untuk piala dari perak seberat yang diperlukan untuk tiap-tiap piala;"
 },
 {
   "id": 11164,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 18,
   "firman": "juga emas yang disucikan untuk mezbah pembakaran ukupan seberat yang diperlukan dan emas untuk pembentukan kereta yang menjadi tumpangan kedua kerub, yang mengembangkan sayapnya sambil menudungi tabut perjanjian TUHAN."
 },
 {
   "id": 11165,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 19,
   "firman": "Semuanya itu terdapat dalam tulisan yang diilhamkan kepadaku oleh TUHAN, yang berisi petunjuk tentang segala pelaksanaan rencana itu."
 },
 {
   "id": 11166,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 20,
   "firman": "Lalu berkatalah Daud kepada Salomo, anaknya: \"Kuatkan dan teguhkanlah hatimu, dan lakukanlah itu; janganlah takut dan janganlah tawar hati, sebab TUHAN Allah, Allahku, menyertai engkau. Ia tidak akan membiarkan dan meninggalkan engkau sampai segala pekerjaan untuk ibadah di rumah Allah selesai."
 },
 {
   "id": 11167,
   "kitab": "1Ta",
   "pasal": 28,
   "ayat": 21,
   "firman": "Sesungguhnya, rombongan para imam dan para orang Lewi ada untuk melakukan segala ibadah di rumah Allah, dan ada beberapa sukarelawan yang ahli dalam setiap tugas yang dapat membantu engkau. Juga para pemimpin dan seluruh rakyat ini sepenuhnya ada di bawah perintahmu.\""
 },
 {
   "id": 11168,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 1,
   "firman": "Berkatalah raja Daud kepada segenap jemaah itu: \"Salomo, anakku yang satu-satunya dipilih Allah adalah masih muda dan kurang berpengalaman, sedang pekerjaan ini besar, sebab bukanlah untuk manusia bait itu, melainkan untuk TUHAN Allah."
 },
 {
   "id": 11169,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 2,
   "firman": "Dengan segenap kemampuan aku telah mengadakan persediaan untuk rumah Allahku, yakni emas untuk barang-barang emas, perak untuk barang-barang perak, tembaga untuk barang-barang tembaga, besi untuk barang-barang besi, dan kayu untuk barang-barang kayu, batu permata syoham dan permata tatahan, batu hitam dan batu permata yang berwarna-warna, dan segala macam batu mahal-mahal dan sangat banyak pualam."
 },
 {
   "id": 11170,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 3,
   "firman": "Lagipula oleh karena cintaku kepada rumah Allahku, maka sebagai tambahan pada segala yang telah kusediakan bagi rumah kudus, aku dengan ini memberikan kepada rumah Allahku dari emas dan perak kepunyaanku sendiri"
 },
 {
   "id": 11171,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 4,
   "firman": "tiga ribu talenta emas dari emas Ofir dan tujuh ribu talenta perak murni untuk menyalut dinding ruangan,"
 },
 {
   "id": 11172,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 5,
   "firman": "yakni emas untuk barang-barang emas dan perak untuk barang-barang perak dan untuk segala yang dikerjakan oleh tukang-tukang. Maka siapakah pada hari ini yang rela memberikan persembahan kepada TUHAN?\""
 },
 {
   "id": 11173,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 6,
   "firman": "Lalu para kepala puak dan para kepala suku Israel dan para kepala pasukan seribu dan pasukan seratus dan para pemimpin pekerjaan untuk raja menyatakan kerelaannya."
 },
 {
   "id": 11174,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 7,
   "firman": "Mereka menyerahkan untuk ibadah di rumah Allah lima ribu talenta emas dan sepuluh ribu dirham, sepuluh ribu talenta perak dan delapan belas ribu talenta tembaga serta seratus ribu talenta besi."
 },
 {
   "id": 11175,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 8,
   "firman": "Siapa yang mempunyai batu permata menyerahkannya kepada Yehiel, orang Gerson itu, untuk perbendaharaan rumah TUHAN."
 },
 {
   "id": 11176,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 9,
   "firman": "Bangsa itu bersukacita karena kerelaan mereka masing-masing, sebab dengan tulus hati mereka memberikan persembahan sukarela kepada TUHAN; juga raja Daud sangat bersukacita."
 },
 {
   "id": 11177,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 10,
   "firman": "Lalu Daud memuji TUHAN di depan mata segenap jemaah itu. Berkatalah Daud: \"Terpujilah Engkau, ya TUHAN, Allahnya bapa kami Israel, dari selama-lamanya sampai selama-lamanya."
 },
 {
   "id": 11178,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 11,
   "firman": "Ya TUHAN, punya-Mulah kebesaran dan kejayaan, kehormatan, kemasyhuran dan keagungan, ya, segala-galanya yang ada di langit dan di bumi! Ya TUHAN, punya-Mulah kerajaan dan Engkau yang tertinggi itu melebihi segala-galanya sebagai kepala."
 },
 {
   "id": 11179,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 12,
   "firman": "Sebab kekayaan dan kemuliaan berasal dari pada-Mu dan Engkaulah yang berkuasa atas segala-galanya; dalam tangan-Mulah kekuatan dan kejayaan; dalam tangan-Mulah kuasa membesarkan dan mengokohkan segala-galanya."
 },
 {
   "id": 11180,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 13,
   "firman": "Sekarang, ya Allah kami, kami bersyukur kepada-Mu dan memuji nama-Mu yang agung itu."
 },
 {
   "id": 11181,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 14,
   "firman": "Sebab siapakah aku ini dan siapakah bangsaku, sehingga kami mampu memberikan persembahan sukarela seperti ini? Sebab dari pada-Mulah segala-galanya dan dari tangan-Mu sendirilah persembahan yang kami berikan kepada-Mu."
 },
 {
   "id": 11182,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 15,
   "firman": "Sebab kami adalah orang asing di hadapan-Mu dan orang pendatang sama seperti semua nenek moyang kami; sebagai bayang-bayang hari-hari kami di atas bumi dan tidak ada harapan."
 },
 {
   "id": 11183,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 16,
   "firman": "Ya TUHAN, Allah kami, segala kelimpahan bahan-bahan yang kami sediakan ini untuk mendirikan bagi-Mu rumah bagi nama-Mu yang kudus adalah dari tangan-Mu sendiri dan punya-Mulah segala-galanya."
 },
 {
   "id": 11184,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 17,
   "firman": "Aku tahu, ya Allahku, bahwa Engkau adalah penguji hati dan berkenan kepada keikhlasan, maka akupun mempersembahkan semuanya itu dengan sukarela dan tulus ikhlas. Dan sekarang, umat-Mu yang hadir di sini telah kulihat memberikan persembahan sukarela kepada-Mu dengan sukacita."
 },
 {
   "id": 11185,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 18,
   "firman": "Ya TUHAN, Allah Abraham, Ishak dan Israel, bapa-bapa kami, peliharalah untuk selama-lamanya kecenderungan hati umat-Mu yang demikian ini dan tetaplah tujukan hati mereka kepada-Mu."
 },
 {
   "id": 11186,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 19,
   "firman": "Dan kepada Salomo, anakku, berikanlah hati yang tulus sehingga ia berpegang pada segala perintah-Mu dan peringatan-Mu dan ketetapan-Mu, melakukan segala-galanya dan mendirikan bait yang persiapannya telah kulakukan.\""
 },
 {
   "id": 11187,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 20,
   "firman": "Kemudian berkatalah Daud kepada segenap jemaah itu: \"Pujilah kiranya TUHAN, Allahmu!\" Maka segenap jemaah itu memuji TUHAN, Allah nenek moyang mereka, kemudian mereka berlutut dan sujud kepada TUHAN dan kepada raja."
 },
 {
   "id": 11188,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 21,
   "firman": "Keesokan harinya mereka mempersembahkan korban sembelihan dan korban bakaran kepada TUHAN, yakni seribu ekor lembu, seribu ekor domba jantan dan seribu ekor domba muda, dengan korban-korban curahannya dan sangat banyak korban sembelihan demi seluruh Israel."
 },
 {
   "id": 11189,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 22,
   "firman": "Lalu mereka makan dan minum pada hari itu di hadapan TUHAN dengan sukacita yang besar, kemudian menyatakan untuk kedua kalinya Salomo, anak Daud, sebagai raja dan mengurapi dia bagi TUHAN sebagai raja dan Zadok sebagai imam."
 },
 {
   "id": 11190,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 23,
   "firman": "Kemudian duduklah Salomo sebagai raja menggantikan Daud, ayahnya, di atas takhta yang ditetapkan TUHAN; ia mendapat kemujuran, sehingga setiap orang Israel mendengarkan perkataannya."
 },
 {
   "id": 11191,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 24,
   "firman": "Lalu semua pemimpin dan pahlawan, juga semua anak raja Daud mengakui kekuasaan raja Salomo."
 },
 {
   "id": 11192,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 25,
   "firman": "TUHAN membuat Salomo luar biasa besar di mata seluruh orang Israel dan mengaruniakan kepadanya keagungan kerajaan seperti tidak pernah ada pada semua raja sebelum dia yang memerintah atas Israel."
 },
 {
   "id": 11193,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 26,
   "firman": "Demikianlah Daud bin Isai telah memerintah atas seluruh Israel."
 },
 {
   "id": 11194,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 27,
   "firman": "Ia memerintah atas orang Israel selama empat puluh tahun; di Hebron ia memerintah tujuh tahun dan di Yerusalem ia memerintah tiga puluh tiga tahun."
 },
 {
   "id": 11195,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 28,
   "firman": "Kemudian matilah ia pada waktu telah putih rambutnya, lanjut umurnya, penuh kekayaan dan kemuliaan, kemudian naik rajalah Salomo, anaknya, menggantikan dia."
 },
 {
   "id": 11196,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 29,
   "firman": "Sesungguhnya, riwayat raja Daud dari awal sampai akhir tertulis dalam riwayat Samuel, pelihat itu, dan dalam riwayat nabi Natan, dan dalam riwayat Gad, pelihat itu,"
 },
 {
   "id": 11197,
   "kitab": "1Ta",
   "pasal": 29,
   "ayat": 30,
   "firman": "beserta segala hidupnya sebagai raja dan kepahlawanannya dan keadaan zaman yang dialaminya dan dialami Israel dan segala kerajaan di negeri-negeri lain."
 },
 {
   "id": 11198,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 1,
   "firman": "Salomo, anak Daud, menjadi kuat dalam kedudukannya sebagai raja; TUHAN, Allahnya, menyertai dia dan menjadikan kekuasaannya luar biasa besarnya."
 },
 {
   "id": 11199,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 2,
   "firman": "Salomo memberi perintah kepada seluruh Israel, kepada kepala-kepala pasukan seribu dan pasukan seratus, kepada para hakim dan kepada semua pemimpin di seluruh Israel, yakni para kepala puak."
 },
 {
   "id": 11200,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 3,
   "firman": "Lalu pergilah Salomo bersama-sama dengan segenap jemaah itu ke bukit pengorbanan yang di Gibeon, sebab di situlah Kemah Pertemuan Allah yang dibuat Musa, hamba TUHAN itu, di padang gurun."
 },
 {
   "id": 11201,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 4,
   "firman": "--Tetapi Daud telah mengangkut tabut Allah dari Kiryat-Yearim ke tempat yang disiapkannya bagi tabut itu, --sebab ia telah memasang kemah untuk tabut itu di Yerusalem."
 },
 {
   "id": 11202,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 5,
   "firman": "Namun mezbah tembaga yang dibuat Bezaleel bin Uri bin Hur masih ada di sana di depan Kemah Suci TUHAN. Maka ke sanalah Salomo dan jemaah itu meminta petunjuk TUHAN."
 },
 {
   "id": 11203,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 6,
   "firman": "Salomo mempersembahkan korban di sana di hadapan TUHAN di atas mezbah tembaga yang di depan Kemah Pertemuan itu; ia mempersembahkan seribu korban bakaran di atasnya."
 },
 {
   "id": 11204,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 7,
   "firman": "Pada malam itu juga Allah menampakkan diri kepada Salomo dan berfirman kepadanya: \"Mintalah apa yang hendak Kuberikan kepadamu.\""
 },
 {
   "id": 11205,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 8,
   "firman": "Berkatalah Salomo kepada Allah: \"Engkaulah yang telah menunjukkan kasih setia-Mu yang besar kepada Daud, ayahku, dan telah mengangkat aku menjadi raja menggantikan dia."
 },
 {
   "id": 11206,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 9,
   "firman": "Maka sekarang, ya TUHAN Allah, tunjukkanlah keteguhan janji-Mu kepada Daud, ayahku, sebab Engkaulah yang telah mengangkat aku menjadi raja atas suatu bangsa yang banyaknya seperti debu tanah."
 },
 {
   "id": 11207,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 10,
   "firman": "Berilah sekarang kepadaku hikmat dan pengertian, supaya aku dapat keluar dan masuk sebagai pemimpin bangsa ini, sebab siapakah yang dapat menghakimi umat-Mu yang besar ini?\""
 },
 {
   "id": 11208,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 11,
   "firman": "Berfirmanlah Allah kepada Salomo: \"Oleh karena itu yang kauingini dan engkau tidak meminta kekayaan, harta benda, kemuliaan atau nyawa pembencimu, dan juga tidak meminta umur panjang, tetapi sebaliknya engkau meminta kebijaksanaan dan pengertian untuk dapat menghakimi umat-Ku yang atasnya Aku telah merajakan engkau,"
 },
 {
   "id": 11209,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 12,
   "firman": "maka kebijaksanaan dan pengertian itu diberikan kepadamu; selain itu Aku berikan kepadamu kekayaan, harta benda dan kemuliaan, sebagaimana belum pernah ada pada raja-raja sebelum engkau dan tidak akan ada pada raja-raja sesudah engkau.\""
 },
 {
   "id": 11210,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 13,
   "firman": "Lalu pulanglah Salomo dari bukit pengorbanan yang di Gibeon itu, dari depan Kemah Pertemuan, ke Yerusalem dan ia memerintah atas Israel."
 },
 {
   "id": 11211,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 14,
   "firman": "Salomo mengumpulkan juga kereta-kereta dan orang-orang berkuda, sehingga ia mempunyai seribu empat ratus kereta dan dua belas ribu orang berkuda, yang semuanya ditempatkan dalam kota-kota kereta dan dekat raja di Yerusalem."
 },
 {
   "id": 11212,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 15,
   "firman": "Raja membuat banyaknya emas dan perak di Yerusalem sama seperti batu, dan banyaknya pohon kayu aras sama seperti pohon ara yang tumbuh di Daerah Bukit."
 },
 {
   "id": 11213,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 16,
   "firman": "Kuda untuk Salomo didatangkan dari Misraim dan dari Kewe; saudagar-saudagar raja membelinya dari Kewe dengan harga pasar."
 },
 {
   "id": 11214,
   "kitab": "2Ta",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sebuah kereta yang didatangkan dari Misraim berharga sampai enam ratus syikal perak, dan seekor kuda sampai seratus lima puluh syikal; dan begitu juga melalui mereka dikeluarkan semuanya itu kepada semua raja orang Het dan kepada raja-raja Aram."
 },
 {
   "id": 11215,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 1,
   "firman": "Salomo memerintahkan untuk mendirikan suatu rumah bagi nama TUHAN dan suatu istana kerajaan bagi dirinya sendiri."
 },
 {
   "id": 11216,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 2,
   "firman": "Dan Salomo mengerahkan tujuh puluh ribu kuli, delapan puluh ribu tukang pahat di pegunungan, dan tiga ribu enam ratus mandur untuk mengawasi mereka itu."
 },
 {
   "id": 11217,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 3,
   "firman": "Lalu Salomo mengutus orang kepada Huram, raja negeri Tirus, dengan pesan: \"Perbuatlah terhadap aku seperti yang kauperbuat terhadap ayahku Daud, ketika engkau mengirim kayu aras kepadanya, sehingga ia dapat mendirikan baginya suatu istana untuk tinggal di situ."
 },
 {
   "id": 11218,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 4,
   "firman": "Ketahuilah, aku hendak mendirikan sebuah rumah bagi nama TUHAN, Allahku, untuk menguduskannya bagi Dia, supaya di hadapan-Nya dibakar ukupan dari wangi-wangian, tetap diatur roti sajian dan dipersembahkan korban bakaran pada waktu pagi dan pada waktu petang, pada hari-hari Sabat dan bulan-bulan baru, dan pada perayaan-perayaan yang ditetapkan TUHAN, Allah kami, sebab semuanya itu adalah kewajiban orang Israel untuk selama-lamanya."
 },
 {
   "id": 11219,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dan rumah yang hendak kudirikan itu harus besar, sebab Allah kami lebih besar dari segala allah."
 },
 {
   "id": 11220,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tetapi siapa yang mampu mendirikan suatu rumah bagi Dia, sedangkan langit, bahkan langit yang mengatasi segala langitpun tidak dapat memuat Dia? Dan siapakah aku ini, sehingga aku hendak mendirikan suatu rumah bagi Dia, kecuali sebagai tempat untuk membakar korban di hadapan-Nya?"
 },
 {
   "id": 11221,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 7,
   "firman": "Maka sekarang, kirimlah kepadaku seorang yang ahli mengerjakan emas, perak, tembaga, besi, kain ungu muda, kain kirmizi, kain ungu tua, dan yang juga pandai membuat ukiran, untuk membantu para ahli yang ada padaku di Yehuda dan di Yerusalem, yang telah ditunjuk ayahku Daud."
 },
 {
   "id": 11222,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 8,
   "firman": "Kirim juga kepadaku kayu aras, sanobar dan cendana dari gunung Libanon, sebab aku tahu, bahwa hamba-hambamu pandai menebang pohon dari Libanon. Dalam pada itu hamba-hambaku akan membantu hamba-hambamu"
 },
 {
   "id": 11223,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 9,
   "firman": "untuk menyediakan bagiku sejumlah besar kayu, sebab rumah yang hendak kudirikan itu harus besar dan mentakjubkan."
 },
 {
   "id": 11224,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 10,
   "firman": "Dan untuk tukang-tukang yang menebang pohon kuberikan gandum dua puluh ribu kor, jelai dua puluh ribu kor, anggur dua puluh ribu bat dan minyak dua puluh ribu bat, sebagai bahan makanan bagi hamba-hambamu itu.\""
 },
 {
   "id": 11225,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dan Huram, raja negeri Tirus, mengirim surat balasan kepada Salomo, yang berbunyi: \"Karena TUHAN mengasihi umat-Nya, Ia telah mengangkat engkau menjadi raja atas mereka.\""
 },
 {
   "id": 11226,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 12,
   "firman": "Lalu Huram melanjutkan: \"Terpujilah TUHAN, Allah orang Israel, yang menjadikan langit dan bumi, karena Ia telah memberikan kepada raja Daud seorang anak yang bijaksana, penuh akal budi dan pengertian, yang akan mendirikan suatu rumah bagi TUHAN dan suatu istana kerajaan bagi dirinya sendiri!"
 },
 {
   "id": 11227,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 13,
   "firman": "Maka sekarang aku mengirim seorang ahli, yang penuh pengertian, yakni Huram Abi,"
 },
 {
   "id": 11228,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 14,
   "firman": "anak seorang perempuan dari bani Dan, sedang ayahnya orang Tirus. Ia pandai mengerjakan emas, perak, tembaga, besi, batu, kayu, kain ungu muda, kain ungu tua, lenan halus dan kain kirmizi, dan juga pandai membuat segala jenis ukiran dan segala jenis rancangan yang ditugaskan kepadanya dengan dibantu oleh ahli-ahlimu dan oleh ahli-ahli ayahmu, tuanku Daud."
 },
 {
   "id": 11229,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 15,
   "firman": "Baiklah sekarang tuanku kirim kepada hamba-hamba tuanku gandum dan jelai, minyak dan anggur yang telah tuanku sebutkan itu."
 },
 {
   "id": 11230,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 16,
   "firman": "Dan kami akan menebang kayu dari gunung Libanon sebanyak engkau perlukan dan membawanya kepadamu dengan rakit-rakit melalui laut sampai ke Yafo, dan engkau dapat mengangkutnya ke Yerusalem.\""
 },
 {
   "id": 11231,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 17,
   "firman": "Lalu Salomo menghitung semua orang asing yang laki-laki yang ada di negeri Israel sama seperti yang pernah dilakukan Daud, ayahnya. Maka terdapatlah seratus lima puluh tiga ribu enam ratus orang."
 },
 {
   "id": 11232,
   "kitab": "2Ta",
   "pasal": 2,
   "ayat": 18,
   "firman": "Dan dari antara mereka, tujuh puluh ribu orang dijadikannya kuli, delapan puluh ribu orang tukang pahat di pegunungan, dan tiga ribu enam ratus orang mandur yang harus menyuruh orang-orang itu bekerja."
 },
 {
   "id": 11233,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 1,
   "firman": "Salomo mulai mendirikan rumah TUHAN di Yerusalem di gunung Moria, di mana TUHAN menampakkan diri kepada Daud, ayahnya, di tempat yang ditetapkan Daud, yakni di tempat pengirikan Ornan, orang Yebus itu."
 },
 {
   "id": 11234,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ia mulai mendirikan rumah itu dalam bulan yang kedua, pada tahun keempat pemerintahannya."
 },
 {
   "id": 11235,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 3,
   "firman": "Inilah ukuran dasar yang dipakai Salomo untuk mendirikan rumah Allah: panjangnya enam puluh hasta, menurut ukuran hasta yang lama dan lebarnya dua puluh hasta."
 },
 {
   "id": 11236,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 4,
   "firman": "Balai di sebelah depan ruang besar rumah itu, panjangnya dua puluh hasta, menurut lebar rumah itu, dan tingginya seratus dua puluh hasta. Balai itu dilapisinya dari dalam dengan emas murni."
 },
 {
   "id": 11237,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 5,
   "firman": "Ruang besar dipapaninya dengan kayu sanobar. Kayu itu disaputnya dengan emas tua; kemudian dipasangnya pohon korma dan untaian rantai di atasnya."
 },
 {
   "id": 11238,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 6,
   "firman": "Ruang itu dilapisinya juga dengan batu permata yang mahal-mahal sebagai perhiasan, sedang emasnya emas Parwaim."
 },
 {
   "id": 11239,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 7,
   "firman": "Demikianlah ruang itu, balok-baloknya, ambang-ambangnya, dinding-dindingnya dan pintu-pintunya disaputnya dengan emas dan pada dinding-dindingnya diukirkannya kerub."
 },
 {
   "id": 11240,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 8,
   "firman": "Kemudian ia membuat ruang maha kudus; panjangnya dua puluh hasta, menurut lebar rumah itu, dan lebarnya dua puluh hasta juga. Lalu ia menyaputnya dengan emas tua seberat enam ratus talenta;"
 },
 {
   "id": 11241,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 9,
   "firman": "berat paku-paku lima puluh syikal emas. Juga kamar-kamar atas disaputnya dengan emas."
 },
 {
   "id": 11242,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 10,
   "firman": "Ia membuat dua kerub berupa pahatan di ruang maha kudus dan melapisinya dengan emas."
 },
 {
   "id": 11243,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 11,
   "firman": "Sayap kerub-kerub itu seluruhnya dua puluh hasta panjangnya; sayap yang sebelah kerub yang satu lima hasta panjangnya dan menyentuh dinding ruang, sedang sayapnya yang sebelah lagi juga lima hasta panjangnya dan menyentuh sayap kerub yang lain."
 },
 {
   "id": 11244,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 12,
   "firman": "Begitu pula sayap kerub yang lain itu lima hasta panjangnya dan menyentuh dinding ruang, sedang sayapnya yang sebelah lagi juga lima hasta panjangnya dan bersentuhan dengan sayap kerub yang pertama."
 },
 {
   "id": 11245,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 13,
   "firman": "Jadi sayap kedua kerub itu membentang sepanjang dua puluh hasta, sedang kedua kerub itu berdiri di atas kakinya dan menghadap ruang besar."
 },
 {
   "id": 11246,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 14,
   "firman": "Kemudian ia membuat tabirnya dari kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus, dan menggambarkan kerubim padanya."
 },
 {
   "id": 11247,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 15,
   "firman": "Di depan rumah itu dibuatnya dua tiang, yang tingginya tiga puluh lima hasta, dengan ganja di kepalanya masing-masing setinggi lima hasta."
 },
 {
   "id": 11248,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 16,
   "firman": "Lalu dibuatnya untaian rantai yang dipasangnya sebagai kalung di atas kepala tiang-tiang itu, dan dibuatnya seratus buah delima yang dipasangnya pada untaian rantai itu."
 },
 {
   "id": 11249,
   "kitab": "2Ta",
   "pasal": 3,
   "ayat": 17,
   "firman": "Tiang-tiang itu didirikannya di depan Bait Suci, yang satu di sebelah kanan dan yang lain di sebelah kiri; tiang kanan dinamainya Yakhin, dan tiang kiri Boas."
 },
 {
   "id": 11250,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 1,
   "firman": "Lalu ia membuat mezbah tembaga yang dua puluh hasta panjangnya, dan dua puluh hasta lebarnya dan sepuluh hasta tingginya."
 },
 {
   "id": 11251,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 2,
   "firman": "Kemudian dibuatnyalah \"laut\" tuangan yang sepuluh hasta dari tepi ke tepi, bundar keliling, lima hasta tingginya, dan yang dapat dililit berkeliling oleh tali yang tiga puluh hasta panjangnya."
 },
 {
   "id": 11252,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 3,
   "firman": "Di sebelah bawah tepinya ada gambar lembu-lembu yang mengelilinginya sama sekali, sepuluh dalam sehasta, merangkum \"laut\" itu berkeliling; lembu itu dua jajar, dituang setuangan dengan bejana itu."
 },
 {
   "id": 11253,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 4,
   "firman": "\"Laut\" itu menumpang di atas dua belas lembu, tiga menghadap ke utara dan tiga menghadap ke barat, tiga menghadap ke selatan dan tiga menghadap ke timur; \"laut\" itu menumpang di atasnya, sedang segala buntut lembu itu menuju ke dalam."
 },
 {
   "id": 11254,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 5,
   "firman": "Tebal \"laut\" itu setapak tangan dan tepinya serupa tepi piala, seperti bunga bakung yang berkembang. \"Laut\" itu dapat memuat tiga ribu bat air."
 },
 {
   "id": 11255,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lagipula dibuatnya sepuluh bejana pembasuhan dan ditaruhnya lima pada sisi kanan dan lima pada sisi kiri sebagai tempat pembasuhan; di situ orang membasuh apa yang diperlukan untuk korban bakaran, sedang \"laut\" itu adalah untuk para imam sebagai tempat membasuh."
 },
 {
   "id": 11256,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 7,
   "firman": "Ia membuat sepuluh kandil emas sesuai dengan rancangannya dan menaruhnya di dalam Bait Suci, lima di sebelah kanan dan lima di sebelah kiri."
 },
 {
   "id": 11257,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 8,
   "firman": "Selanjutnya ia membuat sepuluh meja dan menempatkannya di dalam Bait Suci, lima di sebelah kanan dan lima di sebelah kiri; ia membuat pula seratus bokor penyiraman dari emas."
 },
 {
   "id": 11258,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 9,
   "firman": "Ia membuat juga pelataran para imam, halaman besar dan pintu-pintu halaman itu; pintu-pintu itu dilapisinya dengan tembaga."
 },
 {
   "id": 11259,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 10,
   "firman": "\"Laut\" itu ditaruhnya pada sisi kanan, arah tenggara."
 },
 {
   "id": 11260,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 11,
   "firman": "Dan Huram membuat juga kuali-kuali, penyodok-penyodok dan bokor-bokor penyiraman. Demikianlah Huram menyelesaikan pekerjaan yang harus dilakukannya bagi raja Salomo di rumah Allah,"
 },
 {
   "id": 11261,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 12,
   "firman": "yakni kedua tiang, dengan kedua bulatan ganja di kepala tiang itu, kedua jala-jala yang menutup kedua bulatan ganja itu;"
 },
 {
   "id": 11262,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 13,
   "firman": "keempat ratus buah delima untuk kedua jala-jala itu, dua jajar buah delima untuk satu jala-jala guna menutupi kedua bulatan ganja yang di atas tiang itu."
 },
 {
   "id": 11263,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 14,
   "firman": "Juga telah dibuatnya kereta-kereta penopang dan bejana-bejana pembasuhan yang di atas kereta-kereta itu;"
 },
 {
   "id": 11264,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 15,
   "firman": "\"laut\" yang satu itu dan kedua belas lembu di bawahnya."
 },
 {
   "id": 11265,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 16,
   "firman": "Kuali-kuali, penyodok-penyodok, garpu-garpu dan segala perlengkapan lain yang dibuat Huram-Abi bagi raja Salomo untuk rumah TUHAN adalah dari tembaga upaman."
 },
 {
   "id": 11266,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 17,
   "firman": "Raja menuang semuanya itu di Lembah Yordan di dalam tanah liat antara Sukot dan Zereda."
 },
 {
   "id": 11267,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 18,
   "firman": "Salomo membuat segala perlengkapan itu dalam jumlah yang amat besar, sehingga berat tembaga itu tidaklah terhitung."
 },
 {
   "id": 11268,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 19,
   "firman": "Salomo membuat juga segala perlengkapan yang ada di rumah Allah, yakni mezbah dan meja-meja tempat menaruh roti sajian,"
 },
 {
   "id": 11269,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 20,
   "firman": "lagipula kandil-kandil dari emas murni dengan pelita-pelitanya, untuk dinyalakan di depan ruang belakang sesuai dengan peraturan;"
 },
 {
   "id": 11270,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 21,
   "firman": "kembang-kembangnya, pelita-pelitanya dan sepit-sepitnya, dari emas, semuanya dari emas murni;"
 },
 {
   "id": 11271,
   "kitab": "2Ta",
   "pasal": 4,
   "ayat": 22,
   "firman": "pisau-pisaunya, bokor-bokor penyiramannya, cawan-cawannya dan perbaraan-perbaraannya, dari emas murni; juga pintu masuk rumah itu, dan pintu-pintu yang di sebelah dalam ke tempat maha kudus, dan pintu-pintu ke ruang besar Bait Suci, semuanya dari emas."
 },
 {
   "id": 11272,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 1,
   "firman": "Maka selesailah segala pekerjaan yang dilakukan Salomo untuk rumah TUHAN itu. Kemudian Salomo memasukkan barang-barang kudus Daud, ayahnya, dan menaruh perak, emas dan barang-barang itu dalam perbendaharaan rumah Allah."
 },
 {
   "id": 11273,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 2,
   "firman": "Pada waktu itu Salomo menyuruh para tua-tua Israel dan semua kepala suku, para pemimpin puak orang Israel, berkumpul di Yerusalem, untuk mengangkut tabut perjanjian TUHAN dari kota Daud, yaitu Sion."
 },
 {
   "id": 11274,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 3,
   "firman": "Maka pada hari raya di bulan ketujuh berkumpullah di hadapan raja semua orang Israel."
 },
 {
   "id": 11275,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 4,
   "firman": "Setelah semua tua-tua orang Israel datang, maka orang-orang Lewi mengangkat tabut itu."
 },
 {
   "id": 11276,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 5,
   "firman": "Mereka mengangkut tabut itu dan Kemah Pertemuan dan segala barang kudus yang ada dalam kemah itu; semuanya itu diangkut oleh imam-imam dan orang-orang Lewi."
 },
 {
   "id": 11277,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 6,
   "firman": "Tetapi raja Salomo dan segenap umat Israel yang sudah berkumpul di hadapannya, berdiri di depan tabut itu, dan mempersembahkan kambing domba dan lembu sapi yang tidak terhitung dan tidak terbilang banyaknya."
 },
 {
   "id": 11278,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 7,
   "firman": "Kemudian imam-imam membawa tabut perjanjian TUHAN itu ke tempatnya, di ruang belakang rumah itu, di tempat maha kudus, tepat di bawah sayap kerub-kerub;"
 },
 {
   "id": 11279,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 8,
   "firman": "jadi kerub-kerub itu mengembangkan kedua sayapnya di atas tempat tabut itu, sehingga kerub-kerub itu menudungi tabut serta kayu-kayu pengusungnya dari atas."
 },
 {
   "id": 11280,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kayu-kayu pengusung itu demikian panjangnya, sehingga ujungnya kelihatan dari tempat kudus, yang di depan ruang belakang itu, tetapi tidak kelihatan dari luar; dan di situlah tempatnya sampai hari ini."
 },
 {
   "id": 11281,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 10,
   "firman": "Dalam tabut itu tidak ada apa-apa selain dari kedua loh yang ditaruh Musa ke dalamnya di gunung Horeb, ketika TUHAN mengikat perjanjian dengan orang Israel pada waktu perjalanan mereka keluar dari Mesir."
 },
 {
   "id": 11282,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 11,
   "firman": "Lalu para imam keluar dari tempat kudus. Para imam yang ada pada waktu itu semuanya telah menguduskan diri, lepas dari giliran rombongan masing-masing."
 },
 {
   "id": 11283,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 12,
   "firman": "Demikian pula para penyanyi orang Lewi semuanya hadir, yakni Asaf, Heman, Yedutun, beserta anak-anak dan saudara-saudaranya. Mereka berdiri di sebelah timur mezbah, berpakaian lenan halus dan dengan ceracap, gambus dan kecapinya, bersama-sama seratus dua puluh imam peniup nafiri."
 },
 {
   "id": 11284,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 13,
   "firman": "Lalu para peniup nafiri dan para penyanyi itu serentak memperdengarkan paduan suaranya untuk menyanyikan puji-pujian dan syukur kepada TUHAN. Mereka menyaringkan suara dengan nafiri, ceracap dan alat-alat musik sambil memuji TUHAN dengan ucapan: \"Sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya.\" Pada ketika itu rumah itu, yakni rumah TUHAN, dipenuhi awan,"
 },
 {
   "id": 11285,
   "kitab": "2Ta",
   "pasal": 5,
   "ayat": 14,
   "firman": "sehingga imam-imam itu tidak tahan berdiri untuk menyelenggarakan kebaktian oleh karena awan itu, sebab kemuliaan TUHAN memenuhi rumah Allah."
 },
 {
   "id": 11286,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 1,
   "firman": "Pada waktu itu berkatalah Salomo: \"TUHAN telah memutuskan untuk diam dalam kekelaman."
 },
 {
   "id": 11287,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 2,
   "firman": "Sekarang, aku telah mendirikan rumah kediaman bagi-Mu, tempat Engkau menetap selama-lamanya.\""
 },
 {
   "id": 11288,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 3,
   "firman": "Kemudian berpalinglah raja lalu memberkati seluruh jemaah Israel, sedang segenap jemaah Israel berdiri."
 },
 {
   "id": 11289,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 4,
   "firman": "Ia berkata: \"Terpujilah TUHAN, Allah orang Israel, yang telah menyelesaikan dengan tangan-Nya apa yang difirmankan-Nya dengan mulut-Nya kepada Daud, ayahku, demikian:"
 },
 {
   "id": 11290,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 5,
   "firman": "Sejak Aku membawa umat-Ku keluar dari tanah Mesir, tidak ada kota yang Kupilih di antara segala suku Israel untuk mendirikan rumah di sana sebagai tempat kediaman nama-Ku, dan tidak ada orang yang Kupilih untuk menjadi raja atas umat-Ku Israel."
 },
 {
   "id": 11291,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 6,
   "firman": "Tetapi kemudian Aku memilih Yerusalem sebagai tempat kediaman nama-Ku dan memilih Daud untuk berkuasa atas umat-Ku Israel."
 },
 {
   "id": 11292,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 7,
   "firman": "Ketika Daud, ayahku, bermaksud mendirikan rumah untuk nama TUHAN, Allah Israel,"
 },
 {
   "id": 11293,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 8,
   "firman": "berfirmanlah TUHAN kepadanya: Engkau bermaksud mendirikan rumah untuk nama-Ku, dan maksudmu itu memanglah baik;"
 },
 {
   "id": 11294,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 9,
   "firman": "hanya, bukanlah engkau yang akan mendirikan rumah itu, melainkan anak kandungmu yang akan lahir kelak, dialah yang akan mendirikan rumah itu untuk nama-Ku."
 },
 {
   "id": 11295,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 10,
   "firman": "Jadi TUHAN telah menepati janji yang telah diucapkan-Nya; aku telah bangkit menggantikan Daud, ayahku, dan telah duduk di atas takhta kerajaan Israel, seperti yang difirmankan TUHAN; aku telah mendirikan rumah ini untuk nama TUHAN, Allah Israel,"
 },
 {
   "id": 11296,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 11,
   "firman": "dan telah menempatkan di sana tabut, yang memuat perjanjian yang telah diikat TUHAN dengan orang Israel.\""
 },
 {
   "id": 11297,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 12,
   "firman": "Kemudian berdirilah ia di depan mezbah TUHAN di hadapan segenap jemaah Israel, lalu menadahkan tangannya;"
 },
 {
   "id": 11298,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 13,
   "firman": "--karena Salomo telah membuat sebuah mimbar tembaga yang panjangnya lima hasta, lebarnya lima hasta dan tingginya tiga hasta, yang ditaruhnya di halaman--;ia berdiri di atasnya lalu berlutut di hadapan segenap jemaah Israel dan menadahkan tangannya ke langit,"
 },
 {
   "id": 11299,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 14,
   "firman": "sambil berkata: \"Ya TUHAN, Allah Israel! Tidak ada Allah seperti Engkau di langit dan di bumi; Engkau yang memelihara perjanjian dan kasih setia kepada hamba-hamba-Mu yang dengan segenap hatinya hidup di hadapan-Mu;"
 },
 {
   "id": 11300,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 15,
   "firman": "Engkau yang tetap berpegang pada janji-Mu terhadap hamba-Mu Daud, ayahku, dan yang telah menggenapi dengan tangan-Mu apa yang Kaufirmankan dengan mulut-Mu, seperti yang terjadi pada hari ini."
 },
 {
   "id": 11301,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 16,
   "firman": "Maka sekarang, ya TUHAN, Allah Israel, peliharalah apa yang Kaujanjikan kepada hamba-Mu Daud, ayahku, dengan berkata: Keturunanmu takkan terputus di hadapan-Ku dan tetap akan duduk di atas takhta kerajaan Israel, asal anak-anakmu tetap hidup menurut hukum-Ku sama seperti engkau hidup di hadapan-Ku."
 },
 {
   "id": 11302,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 17,
   "firman": "Maka sekarang, ya TUHAN, Allah Israel, biarlah terbukti kebenaran firman-Mu yang telah Kauucapkan kepada hamba-Mu Daud."
 },
 {
   "id": 11303,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 18,
   "firman": "Tetapi benarkah Allah hendak diam bersama dengan manusia di atas bumi? Sesungguhnya langit, bahkan langit yang mengatasi segala langitpun tidaklah dapat memuat Engkau, terlebih lagi rumah yang kudirikan ini."
 },
 {
   "id": 11304,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 19,
   "firman": "Maka berpalinglah kepada doa dan permohonan hamba-Mu ini, ya TUHAN Allahku, dengarkanlah seruan dan doa yang hamba-Mu panjatkan di hadapan-Mu ini!"
 },
 {
   "id": 11305,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 20,
   "firman": "Kiranya mata-Mu terbuka terhadap rumah ini, siang dan malam, terhadap tempat yang Kaukatakan akan menjadi kediaman nama-Mu--dengarkanlah doa yang hamba-Mu panjatkan di tempat ini."
 },
 {
   "id": 11306,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 21,
   "firman": "Dan dengarkanlah permohonan hamba-Mu dan umat-Mu Israel yang mereka panjatkan di tempat ini; bahwa Engkau juga yang mendengarnya dari tempat kediaman-Mu, dari sorga; dan apabila Engkau mendengarnya, maka Engkau akan mengampuni."
 },
 {
   "id": 11307,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 22,
   "firman": "Jika seseorang telah berdosa kepada temannya, lalu diwajibkan mengangkat sumpah dengan mengutuk dirinya, dan ia datang bersumpah ke depan mezbah-Mu di dalam rumah ini,"
 },
 {
   "id": 11308,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 23,
   "firman": "maka Engkaupun hendaklah mendengar dari sorga dan bertindak serta mengadili hamba-hamba-Mu, yakni membalas perbuatan orang bersalah dengan menanggungkannya kepada orang itu sendiri, tetapi membenarkan orang yang benar dengan membalaskan kepadanya sesuai dengan kebenarannya."
 },
 {
   "id": 11309,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 24,
   "firman": "Apabila umat-Mu Israel terpukul kalah oleh musuhnya karena mereka berdosa kepada-Mu, kemudian mereka berbalik dan mengakui nama-Mu, dan mereka berdoa dan memohon di hadapan-Mu di rumah ini,"
 },
 {
   "id": 11310,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 25,
   "firman": "maka Engkaupun kiranya mendengar dari sorga dan mengampuni dosa umat-Mu Israel dan mengembalikan mereka ke tanah yang telah Kauberikan kepada mereka dan nenek moyang mereka."
 },
 {
   "id": 11311,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 26,
   "firman": "Apabila langit tertutup, sehingga tidak ada hujan, sebab mereka berdosa kepada-Mu, lalu mereka berdoa di tempat ini dan mengakui nama-Mu dan mereka berbalik dari dosanya, sebab Engkau telah menindas mereka,"
 },
 {
   "id": 11312,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 27,
   "firman": "maka Engkaupun kiranya mendengarkannya di sorga dan mengampuni dosa hamba-hamba-Mu, umat-Mu Israel, --karena Engkaulah yang menunjukkan kepada mereka jalan yang baik yang harus mereka jalani--dan Engkau kiranya memberikan hujan kepada tanah-Mu yang telah Kauberikan kepada umat-Mu menjadi milik pusaka."
 },
 {
   "id": 11313,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 28,
   "firman": "Apabila ada kelaparan di negeri ini, apabila ada penyakit sampar, hama dan penyakit gandum, belalang dan belalang pelahap, apabila musuh menyesakkan mereka di salah satu kota mereka, apabila ada tulah atau penyakit apapun,"
 },
 {
   "id": 11314,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 29,
   "firman": "lalu seseorang atau segenap umat-Mu Israel memanjatkan doa dan permohonan di rumah ini dengan menadahkan tangannya--karena mereka masing-masing mengenal tulahnya dan penderitaannya sendiri--"
 },
 {
   "id": 11315,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 30,
   "firman": "maka Engkaupun kiranya mendengar dari sorga, tempat kediaman-Mu yang tetap, dan kiranya Engkau mengampuni, dan membalas kepada setiap orang sesuai dengan segala perbuatannya, karena Engkau mengenal hatinya--sebab Engkau sajalah yang mengenal hati anak-anak manusia, --"
 },
 {
   "id": 11316,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 31,
   "firman": "supaya mereka takut akan Engkau dan mengikuti segala jalan yang Engkau tunjukkan selama mereka hidup di atas tanah yang telah Kauberikan kepada nenek moyang kami."
 },
 {
   "id": 11317,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 32,
   "firman": "Juga apabila seorang asing, yang tidak termasuk umat-Mu Israel, datang dari negeri jauh oleh karena nama-Mu yang besar, tangan-Mu yang kuat dan lengan-Mu yang teracung, dan ia datang berdoa di rumah ini,"
 },
 {
   "id": 11318,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 33,
   "firman": "maka Engkaupun kiranya mendengar dari sorga, dari tempat kediaman-Mu yang tetap, dan kiranya Engkau bertindak sesuai dengan segala yang diserukan kepada-Mu oleh orang asing itu, supaya segala bangsa di bumi mengenal nama-Mu, sehingga mereka takut akan Engkau sama seperti umat-Mu Israel, dan sehingga mereka tahu, bahwa nama-Mu telah diserukan atas rumah yang telah kudirikan ini."
 },
 {
   "id": 11319,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 34,
   "firman": "Apabila umat-Mu keluar untuk berperang melawan musuh-musuhnya, ke arah manapun Engkau menyuruh mereka, dan apabila mereka berdoa kepada-Mu dengan berkiblat ke kota yang telah Kaupilih ini dan ke rumah yang telah kudirikan bagi nama-Mu,"
 },
 {
   "id": 11320,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 35,
   "firman": "maka Engkau kiranya mendengar dari sorga doa dan permohonan mereka dan Engkau kiranya memberikan keadilan kepada mereka."
 },
 {
   "id": 11321,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 36,
   "firman": "Apabila mereka berdosa kepada-Mu--karena tidak ada manusia yang tidak berdosa--dan Engkau murka kepada mereka dan menyerahkan mereka kepada musuh, sehingga mereka diangkut tertawan ke negeri yang jauh atau yang dekat,"
 },
 {
   "id": 11322,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 37,
   "firman": "dan apabila mereka sadar kembali dalam hatinya di negeri tempat mereka tertawan, dan mereka berbalik, dan memohon kepada-Mu di negeri tempat mereka tertawan, dengan berkata: Kami telah berdosa, bersalah, dan berbuat fasik,"
 },
 {
   "id": 11323,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 38,
   "firman": "apabila mereka berbalik kepada-Mu dengan segenap hatinya dan dengan segenap jiwanya di negeri orang-orang yang mengangkut mereka tertawan, dan apabila mereka berdoa kepada-Mu dengan berkiblat ke negeri mereka yang telah Kauberikan kepada nenek moyang mereka, ke kota yang telah Kaupilih dan ke rumah yang telah kudirikan bagi nama-Mu,"
 },
 {
   "id": 11324,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 39,
   "firman": "maka Engkau kiranya mendengarkan dari sorga, dari tempat kediaman-Mu yang tetap, kepada doa dan segala permohonan mereka dan kiranya Engkau memberikan keadilan kepada mereka, dan Engkau kiranya mengampuni umat-Mu yang telah berdosa kepada-Mu."
 },
 {
   "id": 11325,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 40,
   "firman": "Sebab itu, ya Allahku, kiranya mata-Mu terbuka dan telinga-Mu menaruh perhatian kepada doa yang dipanjatkan di tempat ini."
 },
 {
   "id": 11326,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 41,
   "firman": "Dan sekarang, bangunlah ya TUHAN Allah, dan pergilah ke tempat perhentian-Mu, Engkau serta tabut kekuatan-Mu! Kiranya, ya TUHAN Allah, imam-imam-Mu berpakaian keselamatan, dan orang-orang yang Kaukasihi bersukacita karena kebaikan-Mu."
 },
 {
   "id": 11327,
   "kitab": "2Ta",
   "pasal": 6,
   "ayat": 42,
   "firman": "Ya TUHAN Allah, janganlah Engkau menolak orang yang telah Kauurapi, ingatlah akan segala kasih setia-Mu kepada Daud, hamba-Mu itu.\""
 },
 {
   "id": 11328,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 1,
   "firman": "Setelah Salomo mengakhiri doanya, apipun turun dari langit memakan habis korban bakaran dan korban-korban sembelihan itu, dan kemuliaan TUHAN memenuhi rumah itu."
 },
 {
   "id": 11329,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 2,
   "firman": "Para imam tidak dapat memasuki rumah TUHAN itu, karena kemuliaan TUHAN memenuhi rumah TUHAN."
 },
 {
   "id": 11330,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 3,
   "firman": "Ketika segenap orang Israel melihat api itu turun dan kemuliaan TUHAN meliputi rumah itu, berlututlah mereka di atas lantai dengan muka mereka sampai ke tanah, lalu sujud menyembah dan menyanyikan syukur bagi TUHAN: \"Sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya.\""
 },
 {
   "id": 11331,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 4,
   "firman": "Lalu raja bersama-sama seluruh bangsa mempersembahkan korban sembelihan di hadapan TUHAN."
 },
 {
   "id": 11332,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 5,
   "firman": "Sebagai korban sembelihan raja Salomo mempersembahkan dua puluh dua ribu ekor lembu sapi dan seratus dua puluh ribu ekor kambing domba. Demikianlah raja dan seluruh bangsa mentahbiskan rumah Allah."
 },
 {
   "id": 11333,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 6,
   "firman": "Para imam telah siap berdiri pada tempat mereka. Begitu pula orang-orang Lewi telah siap dengan alat-alat musik untuk memuliakan TUHAN, yakni alat-alat musik yang dibuat raja Daud untuk mengiringi nyanyian syukur bagi TUHAN: \"Bahwasanya untuk selama-lamanya kasih setia-Nya!\" setiap kali mereka ditugaskan Daud menyanyikan puji-pujian. Dalam pada itu para imam berdiri berhadapan dengan mereka sambil meniup nafiri, sedang segenap orang Israel berdiri."
 },
 {
   "id": 11334,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 7,
   "firman": "Lalu Salomo menguduskan pertengahan pelataran yang di depan rumah TUHAN, sebab di situlah diolahnya segala korban bakaran dan lemak korban keselamatan, sebab mezbah tembaga yang dibuat Salomo tidak dapat memuat korban bakaran dan korban sajian dan segala lemak korban."
 },
 {
   "id": 11335,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dan pada waktu itu juga Salomo mengadakan perayaan Pondok Daun selama tujuh hari, bersama-sama dengan seluruh Israel, suatu jemaah yang amat besar, dari jalan masuk ke Hamat sampai ke sungai Mesir."
 },
 {
   "id": 11336,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 9,
   "firman": "Pada hari yang kedelapan mereka mengadakan perkumpulan raya, karena mereka telah merayakan pentahbisan mezbah selama tujuh hari, dan perayaan Pondok Daun selama tujuh hari."
 },
 {
   "id": 11337,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 10,
   "firman": "Pada hari yang kedua puluh tiga, bulan ketujuh, disuruhnya bangsa itu pulang ke kemah-kemah mereka sambil bersukacita dan bergembira atas kebaikan yang telah dilakukan TUHAN kepada Daud, kepada Salomo, dan kepada orang Israel, umat-Nya."
 },
 {
   "id": 11338,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 11,
   "firman": "Demikianlah Salomo menyelesaikan rumah TUHAN dan istana raja, dan berhasil melaksanakan dalam rumah TUHAN dan dalam istananya segala sesuatu yang timbul dalam hatinya."
 },
 {
   "id": 11339,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 12,
   "firman": "Kemudian TUHAN menampakkan diri kepada Salomo pada malam hari dan berfirman kepadanya: \"Telah Kudengar doamu dan telah Kupilih tempat ini bagi-Ku sebagai rumah persembahan."
 },
 {
   "id": 11340,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 13,
   "firman": "Bilamana Aku menutup langit, sehingga tidak ada hujan, dan bilamana Aku menyuruh belalang memakan habis hasil bumi, dan bilamana Aku melepaskan penyakit sampar di antara umat-Ku,"
 },
 {
   "id": 11341,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 14,
   "firman": "dan umat-Ku, yang atasnya nama-Ku disebut, merendahkan diri, berdoa dan mencari wajah-Ku, lalu berbalik dari jalan-jalannya yang jahat, maka Aku akan mendengar dari sorga dan mengampuni dosa mereka, serta memulihkan negeri mereka."
 },
 {
   "id": 11342,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 15,
   "firman": "Sekarang mata-Ku terbuka dan telinga-Ku menaruh perhatian kepada doa dari tempat ini."
 },
 {
   "id": 11343,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 16,
   "firman": "Sekarang telah Kupilih dan Kukuduskan rumah ini, supaya nama-Ku tinggal di situ untuk selama-lamanya, maka mata-Ku dan hati-Ku akan ada di situ sepanjang masa."
 },
 {
   "id": 11344,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 17,
   "firman": "Mengenai engkau, jika engkau hidup di hadapan-Ku sama seperti Daud, ayahmu, dan berbuat sesuai dengan segala yang Kuperintahkan kepadamu, dan jika engkau tetap mengikuti segala ketetapan dan peraturan-Ku,"
 },
 {
   "id": 11345,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 18,
   "firman": "maka Aku akan meneguhkan takhta kerajaanmu sesuai dengan perjanjian yang telah Kuikat dengan Daud, ayahmu, dengan berkata: Takkan terputus keturunanmu yang memerintah atas Israel."
 },
 {
   "id": 11346,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 19,
   "firman": "Tetapi jika kamu ini berbalik dan meninggalkan segala ketetapan dan perintah-Ku yang telah Kuberikan kepadamu, dan pergi beribadah kepada allah lain dan sujud menyembah kepadanya,"
 },
 {
   "id": 11347,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 20,
   "firman": "maka Aku akan mencabut kamu dari tanah-Ku yang telah Kuberikan kepadamu, dan rumah ini yang telah Kukuduskan bagi nama-Ku, akan Kubuang dari hadapan-Ku, dan akan Kujadikan kiasan dan sindiran di antara segala bangsa."
 },
 {
   "id": 11348,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 21,
   "firman": "Dan setiap orang yang lewat rumah yang amat ditinggikan ini, akan tertegun dan berkata: Apakah sebabnya TUHAN berbuat yang demikian kepada negeri ini dan kepada rumah ini?"
 },
 {
   "id": 11349,
   "kitab": "2Ta",
   "pasal": 7,
   "ayat": 22,
   "firman": "Maka orang akan berkata: Sebab mereka meninggalkan TUHAN, Allah nenek moyang mereka, yang membawa mereka keluar dari tanah Mesir, dan sebab mereka berpegang pada allah lain dan sujud menyembah kepadanya dan beribadah kepadanya. Itulah sebabnya Ia mendatangkan segala malapetaka ini ke atas mereka.\""
 },
 {
   "id": 11350,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 1,
   "firman": "Setelah lewat dua puluh tahun selesailah Salomo mendirikan rumah TUHAN dan istananya sendiri."
 },
 {
   "id": 11351,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 2,
   "firman": "Maka Salomo memperkuat kota-kota yang diberikan Huram kepadanya, dan menyuruh orang Israel menetap di sana."
 },
 {
   "id": 11352,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 3,
   "firman": "Lalu Salomo pergi ke Hamat-Zoba dan menaklukkannya."
 },
 {
   "id": 11353,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 4,
   "firman": "Kemudian ia memperkuat Tadmor di padang gurun dan semua kota perbekalan yang didirikannya di Hamat."
 },
 {
   "id": 11354,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 5,
   "firman": "Ia memperkuat juga Bet-Horon Hulu dan Bet-Horon Hilir menjadi kota kubu yang bertembok, berpintu gerbang dan berpalang,"
 },
 {
   "id": 11355,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 6,
   "firman": "dan juga Baalat, dan segala kota perbekalan kepunyaan Salomo, segala kota tempat kereta, kota-kota tempat orang berkuda dan apa saja yang Salomo ingin mendirikannya di Yerusalem, atau di gunung Libanon, atau di segenap negeri kekuasaannya."
 },
 {
   "id": 11356,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 7,
   "firman": "Semua orang yang masih tinggal dari orang Het, orang Amori, orang Feris, orang Hewi dan orang Yebus, yang tidak termasuk orang Israel,"
 },
 {
   "id": 11357,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 8,
   "firman": "yakni keturunan bangsa-bangsa yang masih tinggal di negeri itu dan yang tidak dibinasakan oleh orang Israel, merekalah yang dikerahkan Salomo untuk menjadi orang rodi; demikianlah mereka sampai hari ini."
 },
 {
   "id": 11358,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 9,
   "firman": "Tetapi orang Israel tidak ada yang dijadikan budak oleh Salomo untuk pekerjaannya, melainkan mereka menjadi prajurit, atau perwira pasukan berkuda, atau panglima atas pasukan kereta dan pasukan berkuda."
 },
 {
   "id": 11359,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 10,
   "firman": "Dan inilah pemimpin-pemimpin umum raja Salomo: dua ratus lima puluh orang yang memerintah rakyat."
 },
 {
   "id": 11360,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dan Salomo memindahkan anak Firaun dari kota Daud ke rumah yang didirikannya baginya, karena katanya: \"Tidak boleh seorang isteriku tinggal dalam istana Daud, raja Israel, karena tempat-tempat yang telah dimasuki tabut TUHAN adalah kudus.\""
 },
 {
   "id": 11361,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 12,
   "firman": "Lalu Salomo mempersembahkan korban-korban bakaran bagi TUHAN di atas mezbah TUHAN yang didirikannya di depan balai Bait Suci,"
 },
 {
   "id": 11362,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 13,
   "firman": "sesuai dengan apa yang menurut perintah Musa ditetapkan sebagai korban untuk setiap hari, yakni pada hari-hari Sabat, pada bulan-bulan baru, dan tiga kali setahun pada hari-hari raya: pada hari raya Roti Tidak Beragi, pada hari raya Tujuh Minggu dan pada hari raya Pondok Daun."
 },
 {
   "id": 11363,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 14,
   "firman": "Dan menurut peraturan Daud, ayahnya, ia menetapkan rombongan para imam dalam tugas jabatan mereka, dan orang-orang Lewi dalam tugas menyanyikan puji-pujian dan menyelenggarakan ibadah di hadapan para imam, setiap hari menurut yang ditetapkan untuk hari itu, dan juga penunggu-penunggu pintu gerbang dalam rombongan mereka untuk setiap pintu gerbang. Karena demikianlah perintah Daud, abdi Allah."
 },
 {
   "id": 11364,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 15,
   "firman": "Mereka tidak menyimpang dari perintah raja mengenai para imam dan orang-orang Lewi dalam perkara apapun, juga mengenai perbendaharaan."
 },
 {
   "id": 11365,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 16,
   "firman": "Maka terlaksanalah segala pekerjaan Salomo, dari hari dasar rumah TUHAN diletakkan sampai kepada hari rumah itu selesai. Dengan demikian selesailah sudah rumah TUHAN."
 },
 {
   "id": 11366,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 17,
   "firman": "Kemudian Salomo pergi ke Ezion-Geber dan ke Elot, yang letaknya di tepi laut, di tanah Edom."
 },
 {
   "id": 11367,
   "kitab": "2Ta",
   "pasal": 8,
   "ayat": 18,
   "firman": "Dengan perantaraan anak buahnya Huram mengirim kapal-kapal kepadanya dan anak buah yang tahu tentang laut. Bersama-sama anak buah Salomo mereka sampai ke Ofir dan dari sana mereka mengambil empat ratus lima puluh talenta emas, yang mereka bawa kepada raja Salomo."
 },
 {
   "id": 11368,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 1,
   "firman": "Ketika ratu negeri Syeba mendengar kabar tentang Salomo, maka dengan pasukan pengiring yang sangat besar dan dengan unta-unta yang membawa rempah-rempah, banyak emas dan batu permata yang mahal-mahal datanglah ia ke Yerusalem hendak menguji Salomo dengan teka-teki. Setelah ia sampai kepada Salomo, dipercakapkannyalah segala yang ada dalam hatinya dengan dia."
 },
 {
   "id": 11369,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 2,
   "firman": "Dan Salomo menjawab segala pertanyaan ratu itu; bagi Salomo tidak ada yang tersembunyi, yang tidak dapat dijawabnya untuk ratu itu."
 },
 {
   "id": 11370,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 3,
   "firman": "Ketika ratu negeri Syeba melihat hikmat Salomo dan rumah yang telah didirikannya,"
 },
 {
   "id": 11371,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 4,
   "firman": "makanan di mejanya, cara duduk pegawai-pegawainya, cara pelayan-pelayannya melayani dan berpakaian, juru-juru minumannya dan pakaian mereka, dan korban bakaran yang biasa dipersembahkannya di rumah TUHAN, maka tercenganglah ratu itu."
 },
 {
   "id": 11372,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan ia berkata kepada raja: \"Benar juga kabar yang kudengar di negeriku tentang engkau dan tentang hikmatmu,"
 },
 {
   "id": 11373,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 6,
   "firman": "tetapi aku tidak percaya perkataan-perkataan mereka sampai aku datang dan melihatnya dengan mataku sendiri; sungguh, setengah dari hikmatmu yang besar itu belum diberitahukan kepadaku; engkau melebihi kabar yang kudengar."
 },
 {
   "id": 11374,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 7,
   "firman": "Berbahagialah orang-orangmu, dan berbahagialah para pegawaimu ini yang selalu melayani engkau dan menyaksikan hikmatmu!"
 },
 {
   "id": 11375,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 8,
   "firman": "Terpujilah TUHAN, Allahmu, yang telah berkenan kepadamu sedemikian, hingga Ia mendudukkan engkau di atas takhta-Nya sebagai raja untuk TUHAN, Allahmu! Karena Allahmu mengasihi orang Israel, maka Ia menetapkan mereka untuk selama-lamanya, dan menjadikan engkau raja atas mereka untuk melakukan keadilan dan kebenaran.\""
 },
 {
   "id": 11376,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 9,
   "firman": "Lalu diberikan kepada raja seratus dua puluh talenta emas, dan sangat banyak rempah-rempah dan batu permata yang mahal-mahal; tidak pernah lagi ada rempah-rempah seperti yang diberikan ratu negeri Syeba kepada raja Salomo itu."
 },
 {
   "id": 11377,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 10,
   "firman": "Lagipula hamba-hamba Huram dan hamba-hamba Salomo, yang membawa emas dari Ofir, membawa juga kayu cendana dan batu permata yang mahal-mahal."
 },
 {
   "id": 11378,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 11,
   "firman": "Raja mengerjakan kayu cendana itu menjadi tangga-tangga untuk rumah TUHAN dan istana raja, dan juga menjadi kecapi dan gambus untuk para penyanyi. Hal seperti itu tidak pernah kelihatan sebelumnya di tanah Yehuda."
 },
 {
   "id": 11379,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 12,
   "firman": "Raja Salomo memberikan kepada ratu negeri Syeba segala yang dikehendakinya dan yang dimintanya, melebihi yang dibawa ratu itu untuk raja. Lalu ratu itu berangkat pulang ke negerinya bersama-sama dengan pegawai-pegawainya."
 },
 {
   "id": 11380,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 13,
   "firman": "Adapun berat emas, yang dibawa kepada Salomo dalam satu tahun ialah seberat enam ratus enam puluh enam talenta,"
 },
 {
   "id": 11381,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 14,
   "firman": "belum terhitung yang dibawa oleh saudagar-saudagar dan pedagang-pedagang; juga semua raja Arab dan bupati-bupati di negeri itu membawa emas dan perak kepada Salomo."
 },
 {
   "id": 11382,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 15,
   "firman": "Raja Salomo membuat dua ratus perisai besar dari emas tempaan, enam ratus syikal emas tempaan dipakainya untuk setiap perisai besar;"
 },
 {
   "id": 11383,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 16,
   "firman": "ia membuat juga tiga ratus perisai kecil dari emas tempaan, tiga ratus syikal emas dipakainya untuk setiap perisai kecil; lalu raja menaruh semuanya itu di dalam gedung \"Hutan Libanon\"."
 },
 {
   "id": 11384,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 17,
   "firman": "Juga raja membuat takhta besar dari gading, yang disalutnya dengan emas murni."
 },
 {
   "id": 11385,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 18,
   "firman": "Takhta itu enam tingkatnya, dan tumpuan kakinya dari emas, yang dipautkan pada takhta itu, dan pada kedua sisi tempat duduk ada kelek-kelek. Di samping kelek-kelek itu berdiri dua singa,"
 },
 {
   "id": 11386,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 19,
   "firman": "sedang dua belas singa berdiri di atas keenam tingkat itu sebelah-menyebelah; belum pernah diperbuat yang demikian bagi sesuatu kerajaan."
 },
 {
   "id": 11387,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 20,
   "firman": "Segala perkakas minuman raja Salomo dari emas dan segala barang di gedung \"Hutan Libanon\" itu dari emas murni; perak tidak dianggap berharga pada zaman Salomo."
 },
 {
   "id": 11388,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 21,
   "firman": "Sebab raja mempunyai kapal-kapal yang berlayar ke Tarsis bersama-sama dengan orang-orang Huram; dan sekali tiga tahun kapal-kapal Tarsis itu datang membawa emas dan perak serta gading; juga kera dan burung merak."
 },
 {
   "id": 11389,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 22,
   "firman": "Raja Salomo melebihi semua raja di bumi dalam hal kekayaan dan hikmat."
 },
 {
   "id": 11390,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 23,
   "firman": "Semua raja di bumi berikhtiar menghadap Salomo untuk menyaksikan hikmat yang telah ditaruh Allah di dalam hatinya."
 },
 {
   "id": 11391,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 24,
   "firman": "Mereka datang masing-masing membawa persembahannya, yakni barang-barang perak dan barang-barang emas, pakaian, senjata, rempah-rempah, kuda dan bagal, dan begitulah tahun demi tahun."
 },
 {
   "id": 11392,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 25,
   "firman": "Salomo mempunyai juga empat ribu kandang untuk kuda-kudanya dan kereta-keretanya dan dua belas ribu orang berkuda, yang ditempatkan dalam kota-kota kereta dan dekat raja di Yerusalem."
 },
 {
   "id": 11393,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 26,
   "firman": "Dan ia memerintah atas semua raja mulai dari sungai Efrat sampai negeri orang Filistin dan sampai ke tapal batas Mesir."
 },
 {
   "id": 11394,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 27,
   "firman": "Raja membuat banyaknya perak di Yerusalem sama seperti batu, dan banyaknya pohon kayu aras sama seperti pohon ara yang tumbuh di Daerah Bukit."
 },
 {
   "id": 11395,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 28,
   "firman": "Kuda untuk Salomo didatangkan dari Misraim dan dari segala negeri."
 },
 {
   "id": 11396,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 29,
   "firman": "Selebihnya dari riwayat Salomo dari awal sampai akhir, bukankah semuanya itu tertulis dalam riwayat nabi Natan dan dalam nubuat Ahia, orang Silo itu, dan dalam penglihatan-penglihatan Ido, pelihat itu, tentang Yerobeam bin Nebat?"
 },
 {
   "id": 11397,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 30,
   "firman": "Salomo memerintah di Yerusalem atas seluruh Israel empat puluh tahun lamanya."
 },
 {
   "id": 11398,
   "kitab": "2Ta",
   "pasal": 9,
   "ayat": 31,
   "firman": "Kemudian Salomo mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di kota Daud, ayahnya. Maka Rehabeam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11399,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 1,
   "firman": "Kemudian Rehabeam pergi ke Sikhem, sebab seluruh Israel telah datang ke Sikhem untuk menobatkan dia menjadi raja."
 },
 {
   "id": 11400,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 2,
   "firman": "Segera sesudah hal itu kedengaran kepada Yerobeam bin Nebat--ia ada di Mesir, sebab ia melarikan diri ke sana dari hadapan raja Salomo--maka kembalilah ia dari Mesir."
 },
 {
   "id": 11401,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 3,
   "firman": "Orang menyuruh memanggil dia, lalu datanglah Yerobeam dengan seluruh orang Israel dan berkata kepada Rehabeam:"
 },
 {
   "id": 11402,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 4,
   "firman": "\"Ayahmu telah memberatkan tanggungan kami, maka sekarang ringankanlah pekerjaan yang sukar yang dibebankan ayahmu dan tanggungan yang berat yang dipikulkannya kepada kami, supaya kami menjadi hambamu.\""
 },
 {
   "id": 11403,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 5,
   "firman": "Tetapi ia menjawab mereka: \"Datanglah kembali kepadaku lusa.\" Lalu pergilah rakyat itu."
 },
 {
   "id": 11404,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 6,
   "firman": "Sesudah itu Rehabeam meminta nasihat dari para tua-tua yang selama hidup Salomo mendampingi Salomo, ayahnya, katanya: \"Apakah nasihatmu untuk menjawab rakyat itu?\""
 },
 {
   "id": 11405,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 7,
   "firman": "Mereka berkata kepadanya: \"Jika engkau mau berlaku ramah terhadap rakyat itu, mau menyenangkan mereka dan mengatakan kata-kata yang baik kepada mereka, maka mereka menjadi hamba-hambamu sepanjang waktu.\""
 },
 {
   "id": 11406,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 8,
   "firman": "Tetapi ia mengabaikan nasihat yang diberikan para tua-tua itu, lalu ia meminta nasihat kepada orang-orang muda yang sebaya dengan dia dan yang mendampinginya,"
 },
 {
   "id": 11407,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 9,
   "firman": "katanya kepada mereka: \"Apakah nasihatmu, supaya kita dapat menjawab rakyat yang mengatakan kepadaku: Ringankanlah tanggungan yang dipikulkan kepada kami oleh ayahmu?\""
 },
 {
   "id": 11408,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 10,
   "firman": "Lalu orang-orang muda yang sebaya dengan dia itu berkata: \"Beginilah harus kaukatakan kepada rakyat yang telah berkata kepadamu: Ayahmu telah memberatkan tanggungan kami, tetapi engkau ini, berilah keringanan kepada kami--beginilah harus kaukatakan kepada mereka: Kelingkingku lebih besar dari pada pinggang ayahku!"
 },
 {
   "id": 11409,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 11,
   "firman": "Maka sekarang, ayahku telah membebankan kepada kamu tanggungan yang berat, tetapi aku akan menambah tanggungan kamu; ayahku telah menghajar kamu dengan cambuk, tetapi aku akan menghajar kamu dengan cambuk yang berduri besi.\""
 },
 {
   "id": 11410,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lusanya datanglah Yerobeam dengan segenap rakyat kepada Rehabeam, seperti yang dikatakan raja: \"Kembalilah kepadaku lusa.\""
 },
 {
   "id": 11411,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 13,
   "firman": "Raja Rehabeam menjawab mereka dengan keras; ia telah mengabaikan nasihat para tua-tua;"
 },
 {
   "id": 11412,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 14,
   "firman": "ia mengatakan kepada mereka menurut nasihat orang-orang muda: \"Ayahku telah memberatkan tanggungan kamu, tetapi aku akan menambahnya; ayahku telah menghajar kamu dengan cambuk, tetapi aku akan menghajar kamu dengan cambuk yang berduri besi.\""
 },
 {
   "id": 11413,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 15,
   "firman": "Jadi raja tidak mendengarkan permintaan rakyat, sebab hal itu merupakan perubahan yang disebabkan Allah, supaya TUHAN menepati firman yang diucapkan-Nya dengan perantaraan Ahia, orang Silo, kepada Yerobeam bin Nebat."
 },
 {
   "id": 11414,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 16,
   "firman": "Setelah seluruh Israel melihat, bahwa raja tidak mendengarkan permintaan mereka, maka rakyat menjawab raja: \"Bagian apakah kita dapat dari pada Daud? Kita tidak memperoleh warisan dari anak Isai itu! Masing-masing ke kemahmu, hai orang Israel! Uruslah sekarang rumahmu sendiri, hai Daud!\" Maka pergilah seluruh orang Israel ke kemahnya,"
 },
 {
   "id": 11415,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 17,
   "firman": "sehingga Rehabeam menjadi raja hanya atas orang Israel yang diam di kota-kota Yehuda."
 },
 {
   "id": 11416,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 18,
   "firman": "Kemudian raja Rehabeam mengutus Hadoram yang menjadi kepala rodi, tetapi orang-orang Israel melontari dia dengan batu, sehingga mati, bahkan raja Rehabeam hampir-hampir tidak dapat menaiki keretanya untuk melarikan diri ke Yerusalem."
 },
 {
   "id": 11417,
   "kitab": "2Ta",
   "pasal": 10,
   "ayat": 19,
   "firman": "Demikianlah mulanya orang Israel memberontak terhadap keluarga Daud sampai hari ini."
 },
 {
   "id": 11418,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 1,
   "firman": "Ketika Rehabeam datang ke Yerusalem, ia mengumpulkan kaum Yehuda dan Benyamin, seratus delapan puluh ribu teruna yang sanggup berperang untuk memerangi orang Israel dengan maksud mengembalikan kerajaan itu kepadanya."
 },
 {
   "id": 11419,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 2,
   "firman": "Tetapi datanglah firman TUHAN kepada Semaya, abdi Allah, demikian:"
 },
 {
   "id": 11420,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 3,
   "firman": "\"Katakanlah kepada Rehabeam, anak Salomo, raja Yehuda, dan kepada segenap orang Israel di Yehuda dan di Benyamin, demikian:"
 },
 {
   "id": 11421,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 4,
   "firman": "Beginilah firman TUHAN: Janganlah kamu maju dan janganlah kamu berperang melawan saudara-saudaramu. Pulanglah masing-masing ke rumahnya, sebab Akulah yang menyebabkan hal ini terjadi.\" Maka mereka mendengarkan firman TUHAN dan pulang dengan tidak pergi menyerang Yerobeam."
 },
 {
   "id": 11422,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 5,
   "firman": "Rehabeam diam di Yerusalem dan memperkuat kota-kota kubu di Yehuda."
 },
 {
   "id": 11423,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 6,
   "firman": "Ia memperkuat Betlehem, Etam, Tekoa,"
 },
 {
   "id": 11424,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 7,
   "firman": "Bet-Zur, Sokho, Adulam,"
 },
 {
   "id": 11425,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 8,
   "firman": "Gat, Mares, Zif,"
 },
 {
   "id": 11426,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 9,
   "firman": "Adoraim, Lakhis, Azeka,"
 },
 {
   "id": 11427,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 10,
   "firman": "Zora, Ayalon dan Hebron, yang terletak di Yehuda dan di Benyamin, sebagai kota-kota berkubu."
 },
 {
   "id": 11428,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 11,
   "firman": "Ia memperkokoh kota-kota kubu itu dan menempatkan di situ kepala-kepala pasukan dengan persediaan makanan, minyak dan anggur;"
 },
 {
   "id": 11429,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 12,
   "firman": "perisai dan tombakpun disediakan di tiap-tiap kota. Ia membuat kota-kota itu amat kokoh. Demikianlah Yehuda dan Benyamin menjadi daerah kekuasaannya."
 },
 {
   "id": 11430,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 13,
   "firman": "Para imam dan orang Lewi di seluruh Israel datang menggabungkan diri dengan dia dari daerah-daerah kediaman mereka."
 },
 {
   "id": 11431,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 14,
   "firman": "Sebab orang Lewi meninggalkan tanah penggembalaan dan milik mereka, lalu pergi ke Yehuda dan Yerusalem, oleh karena Yerobeam dan anak-anaknya melarang mereka memegang jabatan imam TUHAN,"
 },
 {
   "id": 11432,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 15,
   "firman": "dan mengangkat bagi dirinya imam-imam untuk bukit-bukit pengorbanan untuk jin-jin dan untuk anak-anak lembu jantan yang dibuatnya."
 },
 {
   "id": 11433,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 16,
   "firman": "Dari segenap suku Israel orang datang ke Yerusalem mengikuti orang-orang Lewi itu, yakni orang yang telah membulatkan hatinya untuk mencari TUHAN Allah Israel; dan mereka datang untuk mempersembahkan korban kepada TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11434,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 17,
   "firman": "Demikianlah mereka memperkokoh kerajaan Yehuda dan memperkuat pemerintahan Rehabeam bin Salomo selama tiga tahun, karena selama tiga tahun mereka hidup mengikuti jejak Daud dan Salomo."
 },
 {
   "id": 11435,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 18,
   "firman": "Rehabeam mengambil Mahalat, anak Yerimot bin Daud dan Abihail binti Elhiab bin Isai, menjadi isterinya,"
 },
 {
   "id": 11436,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 19,
   "firman": "yang melahirkan baginya anak-anak lelaki ini: Yeush, Semarya dan Zaham."
 },
 {
   "id": 11437,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 20,
   "firman": "Sesudah Mahalat ia mengambil Maakha, anak Absalom, menjadi isterinya, yang melahirkan baginya Abia, Atai, Ziza dan Selomit."
 },
 {
   "id": 11438,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 21,
   "firman": "Rehabeam mencintai Maakha, anak Absalom itu, lebih dari pada semua isteri dan gundiknya--ia mengambil delapan belas isteri dan enam puluh gundik dan memperanakkan dua puluh delapan anak laki-laki dan enam puluh anak perempuan."
 },
 {
   "id": 11439,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 22,
   "firman": "Rehabeam mengangkat Abia, anak Maakha, sebagai pemuka, yakni sebagai pemimpin di antara saudara-saudaranya, karena ia bermaksud menjadikan dia raja."
 },
 {
   "id": 11440,
   "kitab": "2Ta",
   "pasal": 11,
   "ayat": 23,
   "firman": "Oleh sebab itu ia mengambil kebijaksanaan untuk menyebarkan semua anaknya yang lain ke seluruh daerah Yehuda dan Benyamin, ke segala kota kubu. Ia memberikan mereka makanan dengan limpahnya dan menyediakan bagi mereka banyak isteri."
 },
 {
   "id": 11441,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 1,
   "firman": "Rehabeam beserta seluruh Israel meninggalkan hukum TUHAN, ketika kerajaannya menjadi kokoh dan kekuasaannya menjadi teguh."
 },
 {
   "id": 11442,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 2,
   "firman": "Tetapi pada tahun kelima zaman raja Rehabeam, majulah Sisak, raja Mesir, menyerang Yerusalem--karena mereka berubah setia terhadap TUHAN--"
 },
 {
   "id": 11443,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 3,
   "firman": "dengan seribu dua ratus kereta dan enam puluh ribu orang berkuda, sedang rakyat yang mengikutinya dari Mesir, yakni orang Libia, orang Suki dan orang Etiopia, tidak terhitung banyaknya."
 },
 {
   "id": 11444,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 4,
   "firman": "Ia merebut kota-kota benteng yang di Yehuda, bahkan mendekati Yerusalem."
 },
 {
   "id": 11445,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 5,
   "firman": "Nabi Semaya datang kepada Rehabeam dan pemimpin-pemimpin Yehuda yang berkumpul di Yerusalem berhubung dengan ancaman Sisak, dan berkata kepada mereka: \"Beginilah firman TUHAN: Kamu telah meninggalkan Aku, oleh sebab itu Akupun meninggalkan kamu juga dalam kuasa Sisak.\""
 },
 {
   "id": 11446,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 6,
   "firman": "Maka pemimpin-pemimpin Israel dan raja merendahkan diri dan berkata: \"Tuhanlah yang benar!\""
 },
 {
   "id": 11447,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 7,
   "firman": "Ketika TUHAN melihat bahwa mereka merendahkan diri, datanglah firman TUHAN kepada Semaya, bunyinya: \"Mereka telah merendahkan diri, oleh sebab itu Aku tidak akan memusnahkan mereka. Aku segera akan meluputkan mereka dan kehangatan murka-Ku tidak akan dicurahkan atas Yerusalem dengan perantaraan Sisak."
 },
 {
   "id": 11448,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 8,
   "firman": "Tetapi mereka akan menjadi hamba-hambanya, supaya mereka tahu membedakan antara mengabdi kepada-Ku dan mengabdi kepada kerajaan-kerajaan duniawi.\""
 },
 {
   "id": 11449,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 9,
   "firman": "Maka majulah Sisak, raja Mesir itu, menyerang Yerusalem. Ia merampas barang-barang perbendaharaan rumah TUHAN dan barang-barang perbendaharaan rumah raja; semuanya dirampasnya. Ia merampas juga perisai-perisai emas yang dibuat Salomo."
 },
 {
   "id": 11450,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 10,
   "firman": "Sebagai gantinya raja Rehabeam membuat perisai-perisai tembaga, yang dipercayakannya kepada pemimpin-pemimpin bentara yang menjaga pintu istana raja."
 },
 {
   "id": 11451,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 11,
   "firman": "Setiap kali raja masuk ke rumah TUHAN, bentara-bentara datang membawa masuk perisai-perisai itu, dan mereka pula yang mengembalikannya ke kamar jaga para bentara."
 },
 {
   "id": 11452,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 12,
   "firman": "Oleh sebab raja merendahkan diri, surutlah murka TUHAN dari padanya, sehingga ia tidak dimusnahkan-Nya sama sekali. Lagipula masih terdapat hal-hal yang baik di Yehuda."
 },
 {
   "id": 11453,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 13,
   "firman": "Raja Rehabeam menunjukkan dirinya kuat dalam pemerintahannya di Yerusalem. Rehabeam berumur empat puluh satu tahun pada waktu ia menjadi raja, dan tujuh belas tahun lamanya ia memerintah di Yerusalem, kota yang dipilih TUHAN dari antara segala suku Israel untuk membuat nama-Nya tinggal di sana. Nama ibunya ialah Naama, seorang perempuan Amon."
 },
 {
   "id": 11454,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 14,
   "firman": "Ia berbuat yang jahat, karena ia tidak tekun mencari TUHAN."
 },
 {
   "id": 11455,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 15,
   "firman": "Bukankah riwayat Rehabeam dari awal sampai akhir semuanya tertulis dalam riwayat Semaya, nabi itu, dan Ido, pelihat itu, --yang juga memuat daftar silsilah. Antara Rehabeam dan Yerobeam terus-menerus ada perang."
 },
 {
   "id": 11456,
   "kitab": "2Ta",
   "pasal": 12,
   "ayat": 16,
   "firman": "Kemudian Rehabeam mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di kota Daud. Maka Abia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11457,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 1,
   "firman": "Dalam tahun kedelapan belas zaman raja Yerobeam menjadi rajalah Abia atas Yehuda."
 },
 {
   "id": 11458,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 2,
   "firman": "Tiga tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Mikhaya, anak Uriel dari Gibea. Dan ada perang antara Abia dan Yerobeam."
 },
 {
   "id": 11459,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 3,
   "firman": "Abia memulai perang dengan pasukan pahlawan-pahlawan perang, yang jumlahnya empat ratus ribu orang pilihan, sedangkan Yerobeam mengatur barisan perangnya melawan dia dengan delapan ratus ribu orang pilihan, pahlawan-pahlawan yang gagah perkasa."
 },
 {
   "id": 11460,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 4,
   "firman": "Lalu Abia berdiri di atas gunung Zemaraim, yang termasuk pegunungan Efraim, dan berkata: \"Dengarlah kepadaku, Yerobeam dan seluruh Israel!"
 },
 {
   "id": 11461,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 5,
   "firman": "Tidakkah kamu tahu, bahwa TUHAN Allah Israel telah memberikan kuasa kerajaan atas Israel kepada Daud dan anak-anaknya untuk selama-lamanya dengan suatu perjanjian garam?"
 },
 {
   "id": 11462,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 6,
   "firman": "Tetapi Yerobeam bin Nebat, hamba Salomo bin Daud, telah bangkit memberontak melawan tuannya."
 },
 {
   "id": 11463,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 7,
   "firman": "Petualang-petualang, orang-orang dursila, berhimpun padanya; mereka terlalu kuat bagi Rehabeam bin Salomo, yang masih muda dan belum teguh hati, dan yang tidak dapat mempertahankan diri terhadap mereka."
 },
 {
   "id": 11464,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 8,
   "firman": "Tentu kamu menyangka, bahwa kamu dapat mempertahankan diri terhadap kerajaan TUHAN, yang dipegang keturunan Daud, karena jumlah kamu besar dan karena pada kamu ada anak lembu emas yang dibuat Yerobeam untuk kamu menjadi allah."
 },
 {
   "id": 11465,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 9,
   "firman": "Bukankah kamu telah menyingkirkan imam-imam TUHAN, anak-anak Harun itu, dan orang-orang Lewi, lalu mengangkat imam-imam menurut kebiasaan bangsa-bangsa negeri-negeri lain, sehingga setiap orang yang datang untuk ditahbiskan dengan seekor lembu jantan muda dan tujuh ekor domba jantan, dijadikan imam untuk sesuatu yang bukan Allah."
 },
 {
   "id": 11466,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 10,
   "firman": "Tetapi kami ini, Tuhanlah Allah kami, dan kami tidak meninggalkan-Nya. Dan anak-anak Harunlah yang melayani TUHAN sebagai imam, sedang orang Lewi menunaikan tugasnya,"
 },
 {
   "id": 11467,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 11,
   "firman": "yakni setiap pagi dan setiap petang mereka membakar bagi TUHAN korban bakaran dan ukupan dari wangi-wangian, menyusun roti sajian di atas meja yang tahir, dan mengatur kandil emas dengan pelita-pelitanya untuk dinyalakan setiap petang, karena kamilah yang memelihara kewajiban kami terhadap TUHAN, Allah kami, tetapi kamulah yang meninggalkan-Nya."
 },
 {
   "id": 11468,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 12,
   "firman": "Lihatlah, pada pihak kami Allah yang memimpin, sedang imam-imam-Nya siap meniup tanda serangan terhadap kamu dengan nafiri isyarat-isyarat. Hai orang Israel, jangan kamu berperang melawan TUHAN, Allah nenek moyangmu, karena kamu tidak akan beruntung!\""
 },
 {
   "id": 11469,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 13,
   "firman": "Tetapi Yerobeam mengirim suatu pasukan penghadang yang harus membuat gerakan keliling supaya sampai di belakang mereka, sehingga induk pasukannya berada di depan Yehuda dan pasukan-pasukan penghadang di belakang mereka."
 },
 {
   "id": 11470,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 14,
   "firman": "Ketika Yehuda menoleh ke belakang, lihatlah, mereka harus menghadapi pertempuran dari depan dan dari belakang. Mereka berteriak kepada TUHAN, sedang para imam meniup nafiri,"
 },
 {
   "id": 11471,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 15,
   "firman": "dan orang-orang Yehuda memekikkan pekik perang. Pada saat orang-orang Yehuda itu memekikkan pekik perang, Allah memukul kalah Yerobeam dan segenap orang Israel oleh Abia dan Yehuda."
 },
 {
   "id": 11472,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 16,
   "firman": "Orang Israel lari dari depan Yehuda, tetapi Allah menyerahkan mereka ke dalam tangan Yehuda."
 },
 {
   "id": 11473,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 17,
   "firman": "Abia dengan laskarnya mendatangkan kekalahan yang besar kepada mereka. Dari orang Israel mati terbunuh lima ratus ribu orang pilihan."
 },
 {
   "id": 11474,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 18,
   "firman": "Demikianlah orang Israel ditundukkan pada waktu itu, sedang orang Yehuda menjadi kokoh, karena mereka mengandalkan diri kepada TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11475,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 19,
   "firman": "Abia mengejar Yerobeam dan merebut dari padanya beberapa kota, yakni Betel dengan segala anak kotanya, Yesana dengan segala anak kotanya dan Efron dengan segala anak kotanya."
 },
 {
   "id": 11476,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 20,
   "firman": "Tak pernah lagi Yerobeam mendapat kekuatan di zaman Abia. TUHAN memukul dia, sehingga ia mati."
 },
 {
   "id": 11477,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 21,
   "firman": "Abia menunjukkan dirinya kuat. Ia mengambil empat belas isteri dan memperanakkan dua puluh dua anak laki-laki dan enam belas anak perempuan."
 },
 {
   "id": 11478,
   "kitab": "2Ta",
   "pasal": 13,
   "ayat": 22,
   "firman": "Selebihnya dari riwayat Abia, langkah-langkahnya dan titah-titahnya, tertulis dalam kitab sejarah nabi Ido."
 },
 {
   "id": 11479,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 1,
   "firman": "Kemudian Abia mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di kota Daud. Maka Asa, anaknya, menjadi raja menggantikan dia. Pada zaman pemerintahannya negeri itu aman selama sepuluh tahun."
 },
 {
   "id": 11480,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 2,
   "firman": "Asa melakukan apa yang baik dan yang benar di mata TUHAN, Allahnya."
 },
 {
   "id": 11481,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 3,
   "firman": "Ia menjauhkan mezbah-mezbah asing dan bukit-bukit pengorbanan, memecahkan tugu-tugu berhala, dan menghancurkan tiang-tiang berhala."
 },
 {
   "id": 11482,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 4,
   "firman": "Ia memerintahkan orang Yehuda supaya mereka mencari TUHAN, Allah nenek moyang mereka, dan mematuhi hukum dan perintah."
 },
 {
   "id": 11483,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 5,
   "firman": "Ia menjauhkan bukit-bukit pengorbanan dan pedupaan-pedupaan dari segala kota di Yehuda. Dan kerajaanpun aman di bawah pemerintahannya."
 },
 {
   "id": 11484,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 6,
   "firman": "Karena negeri itu aman dan tidak ada yang memeranginya di tahun-tahun itu, ia dapat membangun kota-kota benteng di Yehuda; TUHAN telah mengaruniakan keamanan kepadanya."
 },
 {
   "id": 11485,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 7,
   "firman": "Katanya kepada orang Yehuda: \"Marilah kita memperkuat kota-kota ini dan mengelilinginya dengan tembok beserta menara-menaranya, pintu-pintunya dan palang-palangnya. Negeri ini masih dalam tangan kita, karena kita mencari TUHAN Allah kita dan Ia mencari kita serta mengaruniakan keamanan kepada kita di segala penjuru.\" Maka mereka melaksanakan pembangunan itu dengan berhasil."
 },
 {
   "id": 11486,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 8,
   "firman": "Pasukan-pasukan Asa yang dari Yehuda jumlahnya tiga ratus ribu orang yang membawa perisai besar dan tombak, dan yang dari Benyamin jumlahnya dua ratus delapan puluh ribu orang yang membawa perisai kecil, sebagai pemanah. Mereka semua pahlawan-pahlawan yang gagah perkasa."
 },
 {
   "id": 11487,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 9,
   "firman": "Zerah, orang Etiopia itu, maju berperang melawan mereka dengan tentara sebanyak sejuta orang dan tiga ratus kereta. Ia sampai ke Maresa."
 },
 {
   "id": 11488,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 10,
   "firman": "Lalu Asa maju menghadapinya. Mereka mengatur barisan perangnya di lembah Zefata dekat Maresa."
 },
 {
   "id": 11489,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 11,
   "firman": "Kemudian Asa berseru kepada TUHAN, Allahnya: \"Ya TUHAN, selain dari pada Engkau, tidak ada yang dapat menolong yang lemah terhadap yang kuat. Tolonglah kami ya TUHAN, Allah kami, karena kepada-Mulah kami bersandar dan dengan nama-Mu kami maju melawan pasukan yang besar jumlahnya ini. Ya TUHAN, Engkau Allah kami, jangan biarkan seorang manusia mempunyai kekuatan untuk melawan Engkau!\""
 },
 {
   "id": 11490,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 12,
   "firman": "Dan TUHAN memukul kalah orang-orang Etiopia itu di hadapan Asa dan Yehuda. Orang-orang Etiopia itu lari,"
 },
 {
   "id": 11491,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 13,
   "firman": "lalu dikejar oleh Asa dan laskarnya sampai ke Gerar. Dari orang-orang Etiopia itu amat banyak yang tewas, sehingga tidak ada yang tinggal hidup, karena mereka hancur di hadapan TUHAN dan tentaranya. Orang-orang Yehuda memperoleh jarahan yang sangat besar."
 },
 {
   "id": 11492,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 14,
   "firman": "Mereka mengalahkan semua kota di sekeliling Gerar, karena ketakutan yang dari TUHAN menimpa penduduknya. Mereka menjarahi semua kota itu, karena jarahan yang besar terdapat di situ."
 },
 {
   "id": 11493,
   "kitab": "2Ta",
   "pasal": 14,
   "ayat": 15,
   "firman": "Tenda-tenda pemilik ternakpun direbut mereka, dan banyak kambing domba dan unta diangkutnya sebagai jarahan, lalu mereka kembali ke Yerusalem."
 },
 {
   "id": 11494,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 1,
   "firman": "Azarya bin Oded dihinggapi Roh Allah."
 },
 {
   "id": 11495,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 2,
   "firman": "Ia pergi menemui Asa dan berkata kepadanya: \"Dengarlah kepadaku, Asa dan seluruh Yehuda dan Benyamin! TUHAN beserta dengan kamu bilamana kamu beserta dengan Dia. Bilamana kamu mencari-Nya, Ia berkenan ditemui olehmu, tetapi bilamana kamu meninggalkan-Nya, kamu akan ditinggalkan-Nya."
 },
 {
   "id": 11496,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 3,
   "firman": "Lama sekali Israel tanpa Allah yang benar, tanpa ajaran dari pada imam dan tanpa hukum."
 },
 {
   "id": 11497,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 4,
   "firman": "Tetapi dalam kesesakan mereka berbalik kepada TUHAN, Allah orang Israel. Mereka mencari-Nya, dan Ia berkenan ditemui oleh mereka."
 },
 {
   "id": 11498,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 5,
   "firman": "Pada zaman itu tidak dapat orang pergi dan pulang dengan selamat, karena terdapat kekacauan yang besar di antara segenap penduduk daerah-daerah."
 },
 {
   "id": 11499,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 6,
   "firman": "Bangsa menghancurkan bangsa, kota menghancurkan kota, karena Allah mengacaukan mereka dengan berbagai-bagai kesesakan."
 },
 {
   "id": 11500,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 7,
   "firman": "Tetapi kamu ini, kuatkanlah hatimu, jangan lemah semangatmu, karena ada upah bagi usahamu!\""
 },
 {
   "id": 11501,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 8,
   "firman": "Ketika Asa mendengar perkataan nubuat yang diucapkan oleh nabi Azarya bin Oded itu, ia menguatkan hatinya dan menyingkirkan dewa-dewa kejijikan dari seluruh tanah Yehuda dan Benyamin dan dari kota-kota yang direbutnya di pegunungan Efraim. Ia membaharui mezbah TUHAN yang ada di depan balai Bait Suci TUHAN."
 },
 {
   "id": 11502,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 9,
   "firman": "Ia mengumpulkan seluruh Yehuda dan Benyamin dan orang-orang Efraim, Manasye dan Simeon yang tinggal di antara mereka sebagai orang asing. Sebab dari Israel banyak yang menyeberang memihak kepadanya ketika mereka melihat bahwa TUHAN, Allahnya, beserta dengan dia."
 },
 {
   "id": 11503,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 10,
   "firman": "Mereka berkumpul di Yerusalem pada bulan ketiga tahun kelima belas dari pemerintahan Asa."
 },
 {
   "id": 11504,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 11,
   "firman": "Pada hari itu mereka mempersembahkan kepada TUHAN tujuh ratus lembu sapi dan tujuh ribu kambing domba dari jarahan yang mereka bawa pulang."
 },
 {
   "id": 11505,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 12,
   "firman": "Mereka mengadakan perjanjian untuk mencari TUHAN, Allah nenek moyang mereka, dengan segenap hati dan jiwa."
 },
 {
   "id": 11506,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 13,
   "firman": "Setiap orang, baik anak-anak atau orang dewasa, baik laki-laki atau perempuan, yang tidak mencari TUHAN, Allah Israel, harus dihukum mati."
 },
 {
   "id": 11507,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 14,
   "firman": "Mereka bersumpah setia kepada TUHAN dengan suara yang nyaring, dengan sorak-sorai dan dengan tiupan nafiri dan sangkakala."
 },
 {
   "id": 11508,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 15,
   "firman": "Seluruh Yehuda bersukaria atas sumpah itu, karena dengan segenap hati mereka bersumpah setia dan dengan kehendak yang bulat mereka mencari TUHAN. TUHAN berkenan ditemui oleh mereka dan mengaruniakan keamanan kepada mereka di segala penjuru."
 },
 {
   "id": 11509,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 16,
   "firman": "Bahkan raja Asa memecat Maakha, neneknya, dari pangkat ibu suri, karena neneknya itu membuat patung Asyera yang keji. Asa merobohkan patung yang keji itu, menumbuknya sampai halus dan membakarnya di lembah Kidron."
 },
 {
   "id": 11510,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 17,
   "firman": "Sekalipun bukit-bukit pengorbanan tidak dijauhkan dari Israel, namun hati Asa tulus ikhlas sepanjang umurnya."
 },
 {
   "id": 11511,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 18,
   "firman": "Ia membawa persembahan-persembahan kudus ayahnya dan persembahan-persembahan kudusnya sendiri ke rumah Allah, yakni emas dan perak serta barang-barang lain."
 },
 {
   "id": 11512,
   "kitab": "2Ta",
   "pasal": 15,
   "ayat": 19,
   "firman": "Tidak ada perang sampai pada tahun ketiga puluh lima pemerintahan Asa."
 },
 {
   "id": 11513,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 1,
   "firman": "Pada tahun ketiga puluh enam pemerintahan Asa majulah Baesa, raja Israel, hendak berperang melawan Yehuda. Ia memperkuat Rama dengan maksud mencegah lalu lintas kepada Asa, raja Yehuda."
 },
 {
   "id": 11514,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 2,
   "firman": "Lalu Asa mengeluarkan emas dan perak dari perbendaharaan rumah TUHAN dan dari perbendaharaan rumah raja dan mengirimnya kepada Benhadad, raja Aram yang diam di Damsyik dengan pesan:"
 },
 {
   "id": 11515,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 3,
   "firman": "\"Ada perjanjian antara aku dan engkau, antara ayahku dan ayahmu. Ini kukirim emas dan perak kepadamu. Marilah, batalkanlah perjanjianmu dengan Baesa, raja Israel, supaya ia undur dari padaku.\""
 },
 {
   "id": 11516,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 4,
   "firman": "Lalu Benhadad mendengarkan permintaan raja Asa; ia menyuruh panglima-panglimanya menyerang kota-kota Israel. Dan mereka memukul kalah Iyon, Dan, Abel-Maim dan segala tempat perbekalan kota-kota di Naftali."
 },
 {
   "id": 11517,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 5,
   "firman": "Segera sesudah Baesa mendengar hal itu, ia berhenti memperkuat Rama; ia menghentikan usahanya itu."
 },
 {
   "id": 11518,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 6,
   "firman": "Tetapi raja Asa mengerahkan segenap orang Yehuda, yang harus mengangkat batu dan kayu yang dipergunakan Baesa untuk memperkuat Rama itu. Ia mempergunakannya untuk memperkuat Geba dan Mizpa."
 },
 {
   "id": 11519,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 7,
   "firman": "Pada waktu itu datanglah Hanani, pelihat itu, kepada Asa, raja Yehuda, katanya kepadanya: \"Karena engkau bersandar kepada raja Aram dan tidak bersandar kepada TUHAN Allahmu, oleh karena itu terluputlah tentara raja Aram dari tanganmu."
 },
 {
   "id": 11520,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 8,
   "firman": "Bukankah tentara orang Etiopia dan Libia besar jumlahnya, kereta dan orang berkudanya sangat banyak? Namun TUHAN telah menyerahkan mereka ke dalam tanganmu, karena engkau bersandar kepada-Nya."
 },
 {
   "id": 11521,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 9,
   "firman": "Karena mata TUHAN menjelajah seluruh bumi untuk melimpahkan kekuatan-Nya kepada mereka yang bersungguh hati terhadap Dia. Dalam hal ini engkau telah berlaku bodoh, oleh sebab itu mulai sekarang ini engkau akan mengalami peperangan.\""
 },
 {
   "id": 11522,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 10,
   "firman": "Maka sakit hatilah Asa karena perkataan pelihat itu, sehingga ia memasukkannya ke dalam penjara, sebab memang ia sangat marah terhadap dia karena perkara itu. Pada waktu itu Asa menganiaya juga beberapa orang dari rakyat."
 },
 {
   "id": 11523,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 11,
   "firman": "Sesungguhnya riwayat Asa dari awal sampai akhir tertulis dalam kitab raja-raja Yehuda dan Israel."
 },
 {
   "id": 11524,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 12,
   "firman": "Pada tahun ketiga puluh sembilan pemerintahannya Asa menderita sakit pada kakinya yang kemudian menjadi semakin parah. Namun dalam kesakitannya itu ia tidak mencari pertolongan TUHAN, tetapi pertolongan tabib-tabib."
 },
 {
   "id": 11525,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 13,
   "firman": "Kemudian Asa mendapat perhentian bersama-sama nenek moyangnya. Ia mati pada tahun keempat puluh satu pemerintahannya,"
 },
 {
   "id": 11526,
   "kitab": "2Ta",
   "pasal": 16,
   "ayat": 14,
   "firman": "dan dikuburkan di kuburan yang telah digali baginya di kota Daud. Mereka membaringkannya di atas petiduran yang penuh dengan rempah-rempah dan segala macam rempah-rempah campuran yang dicampur menurut cara pencampur rempah-rempah, lalu menyalakan api yang sangat besar untuk menghormatinya."
 },
 {
   "id": 11527,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 1,
   "firman": "Maka Yosafat, anaknya, menjadi raja menggantikan dia. Sebagai pemimpin Israel ia memperkuat dirinya"
 },
 {
   "id": 11528,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 2,
   "firman": "dengan menempatkan tentara di semua kota yang berkubu di Yehuda dan pasukan-pasukan pendudukan di tanah Yehuda serta di kota-kota Efraim yang direbut oleh Asa, ayahnya."
 },
 {
   "id": 11529,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 3,
   "firman": "Dan TUHAN menyertai Yosafat, karena ia hidup mengikuti jejak yang dahulu dari Daud, bapa leluhurnya, dan tidak mencari Baal-baal,"
 },
 {
   "id": 11530,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 4,
   "firman": "melainkan mencari Allah ayahnya. Ia hidup menurut perintah-perintah-Nya dan tidak berbuat seperti Israel."
 },
 {
   "id": 11531,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 5,
   "firman": "Oleh sebab itu TUHAN mengokohkan kerajaan yang ada di bawah kekuasaannya. Seluruh Yehuda memberikan persembahan kepada Yosafat, sehingga ia menjadi kaya dan sangat terhormat."
 },
 {
   "id": 11532,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 6,
   "firman": "Dengan tabah hati ia hidup menurut jalan yang ditunjukkan TUHAN. Pula ia menjauhkan dari Yehuda segala bukit pengorbanan dan tiang berhala."
 },
 {
   "id": 11533,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 7,
   "firman": "Pada tahun ketiga pemerintahannya ia mengutus beberapa pembesarnya, yakni Benhail, Obaja, Zakharia, Netaneel dan Mikha untuk mengajar di kota-kota Yehuda."
 },
 {
   "id": 11534,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 8,
   "firman": "Bersama-sama mereka turut juga beberapa orang Lewi, yakni Semaya, Netanya, Zebaja, Asael, Semiramot, Yonatan, Adonia, Tobia dan Tob-Adonia disertai imam-imam Elisama dan Yoram."
 },
 {
   "id": 11535,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 9,
   "firman": "Mereka memberikan pelajaran di Yehuda dengan membawa kitab Taurat TUHAN. Mereka mengelilingi semua kota di Yehuda sambil mengajar rakyat."
 },
 {
   "id": 11536,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 10,
   "firman": "Ketakutan yang dari TUHAN menimpa semua kerajaan di negeri-negeri sekeliling Yehuda, sehingga mereka tidak berani berperang melawan Yosafat."
 },
 {
   "id": 11537,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dari antara orang-orang Filistin ada yang membawa kepada Yosafat persembahan, dan perak sebagai upeti. Juga orang-orang Arab membawa kepadanya kambing domba, domba jantan tujuh ribu tujuh ratus ekor dan kambing jantan tujuh ribu tujuh ratus ekor."
 },
 {
   "id": 11538,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 12,
   "firman": "Yosafat makin lama makin kuat, menjadi luar biasa kuat. Di Yehuda ia membangun benteng-benteng dan kota-kota perbekalan."
 },
 {
   "id": 11539,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 13,
   "firman": "Banyak perbekalannya di kota-kota Yehuda. Orang-orang perangnya ada di Yerusalem, semuanya pahlawan yang gagah perkasa."
 },
 {
   "id": 11540,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 14,
   "firman": "Inilah daftar kesatuan mereka menurut puak-puak mereka; panglima-panglima dari Yehuda ialah panglima Adna dengan tiga ratus ribu pahlawan yang gagah perkasa;"
 },
 {
   "id": 11541,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 15,
   "firman": "di samping dia panglima Yohanan dengan dua ratus delapan puluh ribu orang;"
 },
 {
   "id": 11542,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 16,
   "firman": "dan di samping dia Amasia bin Zikhri, yang dengan sukarela telah menyerahkan dirinya kepada TUHAN, dengan dua ratus ribu pahlawan yang gagah perkasa."
 },
 {
   "id": 11543,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 17,
   "firman": "Dan dari Benyamin ialah Elyada, seorang pahlawan yang gagah perkasa, dengan dua ratus ribu orang yang bersenjatakan busur dan perisai."
 },
 {
   "id": 11544,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 18,
   "firman": "Di samping dia Yozabad, dengan seratus delapan puluh ribu orang yang bersenjata untuk berperang."
 },
 {
   "id": 11545,
   "kitab": "2Ta",
   "pasal": 17,
   "ayat": 19,
   "firman": "Mereka itulah yang bertugas pada raja, selain dari pada mereka yang ditempatkan raja di kota-kota yang berkubu di seluruh Yehuda."
 },
 {
   "id": 11546,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 1,
   "firman": "Ketika Yosafat kaya dan sangat terhormat, ia menjadi besan Ahab."
 },
 {
   "id": 11547,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 2,
   "firman": "Beberapa tahun kemudian, pergilah ia kepada Ahab di Samaria. Ahab menyembelih banyak kambing domba dan lembu sapi untuk dia dan rombongannya, dan mengajaknya untuk menyerang Ramot-Gilead."
 },
 {
   "id": 11548,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 3,
   "firman": "Berkatalah Ahab, raja Israel, kepada Yosafat, raja Yehuda: \"Maukah engkau pergi ke Ramot-Gilead bersama-sama aku?\" Jawabnya kepadanya: \"Kita sama-sama, aku dan engkau, rakyatmu dan rakyatku, aku akan bersama-sama engkau di dalam perang.\""
 },
 {
   "id": 11549,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 4,
   "firman": "Tetapi Yosafat berkata kepada raja Israel: \"Baiklah tanyakan dahulu firman TUHAN.\""
 },
 {
   "id": 11550,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 5,
   "firman": "Lalu raja Israel mengumpulkan para nabi, empat ratus orang banyaknya, kemudian bertanyalah ia kepada mereka: \"Apakah kami boleh pergi berperang melawan Ramot-Gilead atau aku membatalkannya?\" Jawab mereka: \"Majulah! Allah akan menyerahkannya ke dalam tangan raja.\""
 },
 {
   "id": 11551,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 6,
   "firman": "Tetapi Yosafat bertanya: \"Tidak adakah lagi di sini seorang nabi TUHAN, supaya dengan perantaraannya kita dapat meminta petunjuk?\""
 },
 {
   "id": 11552,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 7,
   "firman": "Jawab raja Israel kepada Yosafat: \"Masih ada seorang lagi yang dengan perantaraannya dapat diminta petunjuk TUHAN. Tetapi aku membenci dia, sebab tidak pernah ia menubuatkan yang baik tentang aku, melainkan selalu malapetaka. Orang itu ialah Mikha bin Yimla.\" Kata Yosafat: \"Janganlah raja berkata demikian.\""
 },
 {
   "id": 11553,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 8,
   "firman": "Kemudian raja Israel memanggil seorang pegawai istana, katanya: \"Jemputlah Mikha bin Yimla dengan segera!\""
 },
 {
   "id": 11554,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 9,
   "firman": "Sementara raja Israel dan Yosafat, raja Yehuda, duduk masing-masing di atas takhtanya dengan pakaian kebesaran, di suatu tempat pengirikan di depan pintu gerbang Samaria, sedang semua nabi itu bernubuat di depan mereka,"
 },
 {
   "id": 11555,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 10,
   "firman": "maka Zedekia bin Kenaana membuat tanduk-tanduk besi, lalu berkata: \"Beginilah firman TUHAN: Dengan ini engkau akan menanduk Aram sampai engkau menghabiskan mereka.\""
 },
 {
   "id": 11556,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 11,
   "firman": "Juga semua nabi itu bernubuat demikian, katanya: \"Majulah ke Ramot-Gilead, dan engkau akan beruntung; TUHAN akan menyerahkannya ke dalam tangan raja.\""
 },
 {
   "id": 11557,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 12,
   "firman": "Suruhan yang pergi memanggil Mikha itu berkata kepadanya: \"Ketahuilah, nabi-nabi itu sudah sepakat meramalkan yang baik bagi raja, hendaklah engkau juga berbicara seperti salah seorang dari pada mereka dan meramalkan yang baik.\""
 },
 {
   "id": 11558,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 13,
   "firman": "Tetapi Mikha menjawab: \"Demi TUHAN yang hidup, sesungguhnya, apa yang akan difirmankan Allahku, itulah yang akan kukatakan.\""
 },
 {
   "id": 11559,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 14,
   "firman": "Setelah ia sampai kepada raja, bertanyalah raja kepadanya: \"Mikha, apakah kami boleh pergi berperang melawan Ramot-Gilead atau aku membatalkannya?\" Jawabnya: \"Majulah dan kamu akan beruntung, sebab mereka akan diserahkan ke dalam tanganmu!\""
 },
 {
   "id": 11560,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 15,
   "firman": "Tetapi raja berkata kepadanya: \"Sampai berapa kali aku menyuruh engkau bersumpah, supaya engkau mengatakan kepadaku tidak lain dari kebenaran?\""
 },
 {
   "id": 11561,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 16,
   "firman": "Lalu jawabnya: \"Telah kulihat seluruh Israel bercerai-berai di gunung-gunung seperti kambing domba yang tidak mempunyai gembala, sebab itu TUHAN berfirman: Mereka ini tidak punya tuan; baiklah masing-masing pulang ke rumahnya dengan selamat.\""
 },
 {
   "id": 11562,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 17,
   "firman": "Kemudian raja Israel berkata kepada Yosafat: \"Bukankah telah kukatakan kepadamu: Tidak pernah ia menubuatkan yang baik tentang aku, melainkan hanya malapetaka?\""
 },
 {
   "id": 11563,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 18,
   "firman": "Kata Mikha: \"Sebab itu dengarkanlah firman TUHAN. Aku telah melihat TUHAN sedang duduk di atas takhta-Nya dan segenap tentara sorga berdiri di sebelah kanan-Nya dan di sebelah kiri-Nya."
 },
 {
   "id": 11564,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 19,
   "firman": "Dan TUHAN berfirman: Siapakah yang akan membujuk Ahab, raja Israel, untuk maju berperang, supaya ia tewas di Ramot-Gilead? Maka yang seorang berkata begini, yang lain berkata begitu."
 },
 {
   "id": 11565,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 20,
   "firman": "Kemudian tampillah suatu roh, lalu berdiri di hadapan TUHAN. Ia berkata: Aku ini akan membujuknya. TUHAN bertanya kepadanya: Dengan apa?"
 },
 {
   "id": 11566,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 21,
   "firman": "Jawabnya: Aku akan keluar dan menjadi roh dusta dalam mulut semua nabinya. Ia berfirman: Biarlah engkau membujuknya, dan engkau akan berhasil pula. Keluarlah dan perbuatlah demikian!"
 },
 {
   "id": 11567,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 22,
   "firman": "Karena itu, sesungguhnya TUHAN telah menaruh roh dusta ke dalam mulut nabi-nabimu ini, sebab TUHAN telah menetapkan untuk menimpakan malapetaka kepadamu.\""
 },
 {
   "id": 11568,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 23,
   "firman": "Sesudah itu tampillah Zedekia bin Kenaana; ditamparnyalah pipi Mikha serta berkata: \"Bagaimana mungkin Roh TUHAN pindah dari padaku untuk berbicara kepadamu?\""
 },
 {
   "id": 11569,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 24,
   "firman": "Tetapi Mikha menjawab: \"Sesungguhnya engkau akan melihatnya pada hari engkau lari dari satu kamar ke kamar yang lain untuk menyembunyikan diri.\""
 },
 {
   "id": 11570,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 25,
   "firman": "Berkatalah raja Israel: \"Tangkaplah Mikha, bawa dia kembali kepada Amon, penguasa kota, dan kepada Yoas, anak raja,"
 },
 {
   "id": 11571,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 26,
   "firman": "dan katakan: Beginilah titah raja: Masukkan orang ini dalam penjara dan beri dia makan roti dan minum air serba sedikit sampai aku pulang dengan selamat.\""
 },
 {
   "id": 11572,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 27,
   "firman": "Tetapi jawab Mikha: \"Jika benar-benar engkau pulang dengan selamat, tentulah TUHAN tidak berfirman dengan perantaraanku!\" Lalu disambungnya: \"Dengarlah, hai bangsa-bangsa sekalian!\""
 },
 {
   "id": 11573,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 28,
   "firman": "Sesudah itu majulah raja Israel dengan Yosafat, raja Yehuda, ke Ramot-Gilead."
 },
 {
   "id": 11574,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 29,
   "firman": "Raja Israel berkata kepada Yosafat: \"Aku akan menyamar dan masuk pertempuran, tetapi engkau, pakailah pakaian kebesaranmu.\" Lalu menyamarlah raja Israel, kemudian mereka masuk ke pertempuran."
 },
 {
   "id": 11575,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 30,
   "firman": "Adapun raja negeri Aram telah memberi perintah kepada para panglima pasukan keretanya demikian: \"Janganlah kamu berperang melawan sembarang orang, melainkan melawan raja Israel saja.\""
 },
 {
   "id": 11576,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 31,
   "firman": "Segera sesudah para panglima pasukan kereta itu melihat Yosafat, mereka berkata: \"Itu raja Israel!\" Lalu mereka mengepung dia, untuk menyerang dia, tetapi Yosafat berteriak dan TUHAN menolongnya. Allah membujuk mereka pergi dari padanya."
 },
 {
   "id": 11577,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 32,
   "firman": "Segera sesudah para panglima pasukan kereta itu melihat, bahwa dia bukanlah raja Israel, maka undurlah mereka dari padanya."
 },
 {
   "id": 11578,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 33,
   "firman": "Tetapi seseorang menarik panahnya dan menembak dengan sembarangan saja, dan mengenai raja Israel di antara sambungan baju zirahnya. Kemudian ia berkata kepada pengemudi keretanya: \"Putar! Bawa aku keluar dari pertempuran, sebab aku sudah luka.\""
 },
 {
   "id": 11579,
   "kitab": "2Ta",
   "pasal": 18,
   "ayat": 34,
   "firman": "Tetapi pertempuran itu bertambah seru pada hari itu, dan raja Israel tetap berdiri di dalam kereta berhadapan dengan orang Aram itu sampai petang. Ia mati ketika matahari terbenam."
 },
 {
   "id": 11580,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 1,
   "firman": "Yosafat, raja Yehuda, pulang dengan selamat ke istananya di Yerusalem."
 },
 {
   "id": 11581,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 2,
   "firman": "Ketika itu Yehu bin Hanani, pelihat itu, pergi menemuinya dan berkata kepada raja Yosafat: \"Sewajarnyakah engkau menolong orang fasik dan bersahabat dengan mereka yang membenci TUHAN? Karena hal itu TUHAN murka terhadap engkau."
 },
 {
   "id": 11582,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 3,
   "firman": "Namun masih terdapat hal-hal yang baik padamu, karena engkau menghapuskan tiang-tiang berhala dari negeri ini dan mencari Allah dengan tekun.\""
 },
 {
   "id": 11583,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 4,
   "firman": "Yosafat diam di Yerusalem. Ia mengadakan kunjungan pula ke daerah-daerah, dari Bersyeba sampai ke pegunungan Efraim, sambil menyuruh rakyat berbalik kepada TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11584,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ia mengangkat juga hakim-hakim di seluruh negeri, yakni di semua kota yang berkubu di Yehuda, di tiap-tiap kota."
 },
 {
   "id": 11585,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 6,
   "firman": "Berpesanlah ia kepada hakim-hakim itu: \"Pertimbangkanlah apa yang kamu buat, karena bukanlah untuk manusia kamu memutuskan hukum, melainkan untuk TUHAN, yang ada beserta kamu, bila kamu memutuskan hukum."
 },
 {
   "id": 11586,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 7,
   "firman": "Sebab itu, kiranya kamu diliputi oleh rasa takut kepada TUHAN. Bertindaklah dengan seksama, karena berlaku curang, memihak ataupun menerima suap tidak ada pada TUHAN, Allah kita.\""
 },
 {
   "id": 11587,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 8,
   "firman": "Juga di Yerusalem Yosafat mengangkat beberapa orang dari antara orang Lewi, dari antara para imam dan dari antara para kepala puak Israel untuk memberi keputusan dalam hal hukum TUHAN dan dalam hal perselisihan. Mereka berkedudukan di Yerusalem."
 },
 {
   "id": 11588,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 9,
   "firman": "Ia memerintahkan mereka: \"Kamu harus bertindak dengan takut akan TUHAN, dengan setia dan dengan tulus hati, demikian:"
 },
 {
   "id": 11589,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 10,
   "firman": "Dalam setiap perkara, yang disampaikan kepada kamu oleh rekan-rekanmu yang tinggal di kota-kota, yakni perkara-perkara mengenai penumpahan darah atau mengenai hukum, perintah, ketetapan-ketetapan dan peraturan-peraturan hendaklah kamu memperingatkan mereka, supaya mereka jangan bersalah terhadap TUHAN, sehingga murka-Nya menimpa kamu dan rekan-rekanmu. Hendaklah kamu berbuat demikian, dan kamu tidak akan bersalah."
 },
 {
   "id": 11590,
   "kitab": "2Ta",
   "pasal": 19,
   "ayat": 11,
   "firman": "Dengan ini imam kepala Amarya diangkat sebagai ketuamu dalam segala perkara ketuhanan dan Zebaja bin Ismael, pemuka kaum Yehuda, dalam segala perkara kerajaan, sedang orang Lewi akan melayani kamu sebagai pengatur. Bertindaklah dengan tegas! Kiranya TUHAN menyertai orang yang tulus ikhlas.\""
 },
 {
   "id": 11591,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 1,
   "firman": "Setelah itu bani Moab dan bani Amon datang berperang melawan Yosafat bersama-sama sepasukan orang Meunim."
 },
 {
   "id": 11592,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 2,
   "firman": "Datanglah orang memberitahukan Yosafat: \"Suatu laskar yang besar datang dari seberang Laut Asin, dari Edom, menyerang tuanku. Sekarang mereka di Hazezon-Tamar,\" yakni En-Gedi."
 },
 {
   "id": 11593,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 3,
   "firman": "Yosafat menjadi takut, lalu mengambil keputusan untuk mencari TUHAN. Ia menyerukan kepada seluruh Yehuda supaya berpuasa."
 },
 {
   "id": 11594,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 4,
   "firman": "Dan Yehuda berkumpul untuk meminta pertolongan dari pada TUHAN. Mereka datang dari semua kota di Yehuda untuk mencari TUHAN."
 },
 {
   "id": 11595,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 5,
   "firman": "Lalu Yosafat berdiri di tengah-tengah jemaah Yehuda dan Yerusalem di rumah TUHAN, di muka pelataran yang baru"
 },
 {
   "id": 11596,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 6,
   "firman": "dan berkata: \"Ya TUHAN, Allah nenek moyang kami, bukankah Engkau Allah di dalam sorga? Bukankah Engkau memerintah atas segenap kerajaan bangsa? Kuasa dan keperkasaan ada di dalam tangan-Mu, sehingga tidak ada orang yang dapat bertahan melawan Engkau."
 },
 {
   "id": 11597,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 7,
   "firman": "Bukankah Engkau Allah kami yang menghalau penduduk tanah ini dari depan umat-Mu Israel, dan memberikannya kepada keturunan Abraham, sahabat-Mu itu, untuk selama-lamanya?"
 },
 {
   "id": 11598,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 8,
   "firman": "Lalu mereka mendiami tanah itu, dan mendirikan bagi-Mu tempat kudus untuk nama-Mu. Kata mereka:"
 },
 {
   "id": 11599,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 9,
   "firman": "Bila sesuatu malapetaka menimpa kami, yakni pedang, penghukuman, penyakit sampar atau kelaparan, kami akan berdiri di muka rumah ini, di hadapan-Mu, karena nama-Mu tinggal di dalam rumah ini. Dan kami akan berseru kepada-Mu di dalam kesesakan kami, sampai Engkau mendengar dan menyelamatkan kami."
 },
 {
   "id": 11600,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 10,
   "firman": "Sekarang, lihatlah, bani Amon dan Moab, dan orang-orang dari pegunungan Seir ini! Ketika orang Israel datang dari tanah Mesir, Engkau melarang mereka memasuki negerinya. Oleh sebab itu mereka menjauhinya dan tidak memusnahkannya."
 },
 {
   "id": 11601,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 11,
   "firman": "Lihatlah, sebagai pembalasan mereka datang mengusir kami dari tanah milik yang telah Engkau wariskan kepada kami."
 },
 {
   "id": 11602,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 12,
   "firman": "Ya Allah kami, tidakkah Engkau akan menghukum mereka? Karena kami tidak mempunyai kekuatan untuk menghadapi laskar yang besar ini, yang datang menyerang kami. Kami tidak tahu apa yang harus kami lakukan, tetapi mata kami tertuju kepada-Mu.\""
 },
 {
   "id": 11603,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 13,
   "firman": "Sementara itu seluruh Yehuda berdiri di hadapan TUHAN, juga segenap keluarga mereka dengan isteri dan anak-anak mereka."
 },
 {
   "id": 11604,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 14,
   "firman": "Lalu Yahaziel bin Zakharia bin Benaya bin Matanya, seorang Lewi dari bani Asaf, dihinggapi Roh TUHAN di tengah-tengah jemaah,"
 },
 {
   "id": 11605,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 15,
   "firman": "dan berseru: \"Camkanlah, hai seluruh Yehuda dan penduduk Yerusalem dan tuanku raja Yosafat, beginilah firman TUHAN kepadamu: Janganlah kamu takut dan terkejut karena laskar yang besar ini, sebab bukan kamu yang akan berperang melainkan Allah."
 },
 {
   "id": 11606,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 16,
   "firman": "Besok haruslah kamu turun menyerang mereka. Mereka akan mendaki pendakian Zis, dan kamu akan mendapati mereka di ujung lembah, di muka padang gurun Yeruel."
 },
 {
   "id": 11607,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 17,
   "firman": "Dalam peperangan ini tidak usah kamu bertempur. Hai Yehuda dan Yerusalem, tinggallah berdiri di tempatmu, dan lihatlah bagaimana TUHAN memberikan kemenangan kepadamu. Janganlah kamu takut dan terkejut. Majulah besok menghadapi mereka, TUHAN akan menyertai kamu.\""
 },
 {
   "id": 11608,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 18,
   "firman": "Lalu berlututlah Yosafat dengan mukanya ke tanah. Seluruh Yehuda dan penduduk Yerusalempun sujud di hadapan TUHAN dan menyembah kepada-Nya."
 },
 {
   "id": 11609,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 19,
   "firman": "Kemudian orang Lewi dari bani Kehat dan bani Korah bangkit berdiri untuk menyanyikan puji-pujian bagi TUHAN, Allah Israel, dengan suara yang sangat nyaring."
 },
 {
   "id": 11610,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 20,
   "firman": "Keesokan harinya pagi-pagi mereka maju menuju padang gurun Tekoa. Ketika mereka hendak berangkat, berdirilah Yosafat, dan berkata: \"Dengar, hai Yehuda dan penduduk Yerusalem! Percayalah kepada TUHAN, Allahmu, dan kamu akan tetap teguh! Percayalah kepada nabi-nabi-Nya, dan kamu akan berhasil!\""
 },
 {
   "id": 11611,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 21,
   "firman": "Setelah ia berunding dengan rakyat, ia mengangkat orang-orang yang akan menyanyi nyanyian untuk TUHAN dan memuji TUHAN dalam pakaian kudus yang semarak pada waktu mereka keluar di muka orang-orang bersenjata, sambil berkata: \"Nyanyikanlah nyanyian syukur bagi TUHAN, bahwasanya untuk selama-lamanya kasih setia-Nya!\""
 },
 {
   "id": 11612,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 22,
   "firman": "Ketika mereka mulai bersorak-sorai dan menyanyikan nyanyian pujian, dibuat Tuhanlah penghadangan terhadap bani Amon dan Moab, dan orang-orang dari pegunungan Seir, yang hendak menyerang Yehuda, sehingga mereka terpukul kalah."
 },
 {
   "id": 11613,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 23,
   "firman": "Lalu bani Amon dan Moab berdiri menentang penduduk pegunungan Seir hendak menumpas dan memunahkan mereka. Segera sesudah mereka membinasakan penduduk Seir, mereka saling bunuh-membunuh."
 },
 {
   "id": 11614,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 24,
   "firman": "Ketika orang Yehuda tiba di tempat peninjauan di padang gurun, mereka menengok ke tempat laskar itu. Tampaklah semua telah menjadi bangkai berhantaran di tanah, tidak ada yang terluput."
 },
 {
   "id": 11615,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 25,
   "firman": "Lalu Yosafat dan orang-orangnya turun untuk menjarah barang-barang mereka. Mereka menemukan banyak ternak, harta milik, pakaian dan barang-barang berharga. Yang mereka rampas itu lebih banyak dari pada yang dapat dibawa. Tiga hari lamanya mereka menjarah barang-barang itu, karena begitu banyaknya."
 },
 {
   "id": 11616,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 26,
   "firman": "Pada hari keempat mereka berkumpul di Lembah Pujian. Di sanalah mereka memuji TUHAN, dan itulah sebabnya orang menamakan tempat itu Lembah Pujian hingga sekarang."
 },
 {
   "id": 11617,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 27,
   "firman": "Lalu pulanglah sekalian orang Yehuda dan Yerusalem dengan Yosafat di depan. Mereka kembali ke Yerusalem dengan sukacita, karena TUHAN telah membuat mereka bersukacita karena kekalahan musuh mereka."
 },
 {
   "id": 11618,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 28,
   "firman": "Mereka masuk ke Yerusalem dengan gambus dan kecapi dan nafiri, lalu menuju rumah TUHAN."
 },
 {
   "id": 11619,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 29,
   "firman": "Ketakutan yang dari Allah menghinggapi semua kerajaan negeri-negeri lain, ketika mereka mendengar, bahwa TUHAN yang berperang melawan musuh-musuh Israel."
 },
 {
   "id": 11620,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 30,
   "firman": "Dan kerajaan Yosafat amanlah, karena Allahnya mengaruniakan keamanan kepadanya di segala penjuru."
 },
 {
   "id": 11621,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 31,
   "firman": "Yosafat memerintah atas Yehuda. Ia berumur tiga puluh lima tahun pada waktu ia menjadi raja dan dua puluh lima tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Azuba, anak Silhi."
 },
 {
   "id": 11622,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 32,
   "firman": "Ia hidup mengikuti jejak Asa, ayahnya; ia tidak menyimpang dari padanya, dan melakukan apa yang benar di mata TUHAN."
 },
 {
   "id": 11623,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 33,
   "firman": "Hanya bukit-bukit pengorbanan tidak dijauhkan. Bangsa itu belum mengarahkan hatinya kepada Allah nenek moyang mereka."
 },
 {
   "id": 11624,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 34,
   "firman": "Selebihnya dari riwayat Yosafat, dari awal sampai akhir, sesungguhnya semuanya itu tertulis di dalam riwayat Yehu bin Hanani, yang tercantum di dalam kitab raja-raja Israel."
 },
 {
   "id": 11625,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 35,
   "firman": "Kemudian Yosafat, raja Yehuda, bersekutu dengan Ahazia, raja Israel, yang fasik perbuatannya."
 },
 {
   "id": 11626,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 36,
   "firman": "Ia bersekutu dengan Ahazia untuk membuat kapal-kapal yang dapat berlayar ke Tarsis. Kapal-kapal itu dibuat mereka di Ezion-Geber."
 },
 {
   "id": 11627,
   "kitab": "2Ta",
   "pasal": 20,
   "ayat": 37,
   "firman": "Tetapi Eliezer bin Dodawa dari Maresa bernubuat terhadap Yosafat, katanya: \"Karena engkau bersekutu dengan Ahazia, maka TUHAN akan merobohkan pekerjaanmu.\" Lalu kapal-kapal itu pecah, dan tak dapat berlayar ke Tarsis."
 },
 {
   "id": 11628,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 1,
   "firman": "Kemudian Yosafat mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di kota Daud. Maka Yoram, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11629,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 2,
   "firman": "Saudara-saudaranya, anak-anak Yosafat, ialah: Azarya, Yehiel, Zakharia, Azariahu, Mikhael dan Sefaca. Mereka semua anak-anak Yosafat, raja Israel."
 },
 {
   "id": 11630,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 3,
   "firman": "Ayahnya memberikan kepada mereka banyak pemberian, berupa emas dan perak dan barang-barang berharga, juga kota-kota berkubu di Yehuda. Tetapi kedudukan raja diberikannya kepada Yoram, karena dialah anak sulungnya."
 },
 {
   "id": 11631,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 4,
   "firman": "Sesudah Yoram memegang pemerintahan atas kerajaan ayahnya dan merasa dirinya kuat, ia membunuh dengan pedang semua saudaranya dan juga beberapa pembesar Israel."
 },
 {
   "id": 11632,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 5,
   "firman": "Yoram berumur tiga puluh dua tahun pada waktu ia menjadi raja dan delapan tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11633,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 6,
   "firman": "Ia hidup menurut kelakuan raja-raja Israel seperti yang dilakukan keluarga Ahab, sebab yang menjadi isterinya adalah anak Ahab. Ia melakukan apa yang jahat di mata TUHAN."
 },
 {
   "id": 11634,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 7,
   "firman": "Namun demikian, TUHAN tidak mau memusnahkan keluarga Daud oleh karena perjanjian yang diikat-Nya dengan Daud, sesuai dengan yang dijanjikan-Nya, bahwa Ia hendak memberikan keturunan kepadanya dan kepada anak-anaknya untuk selama-lamanya."
 },
 {
   "id": 11635,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 8,
   "firman": "Pada zamannya memberontaklah Edom terhadap kekuasaan Yehuda dan mereka mengangkat seorang raja atas mereka sendiri."
 },
 {
   "id": 11636,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 9,
   "firman": "Maka majulah Yoram dengan panglima-panglimanya serta seluruh keretanya; pada waktu malam bangunlah ia, lalu bersama-sama dengan para panglima pasukan kereta ia menerobos barisan orang Edom yang mengepung dia."
 },
 {
   "id": 11637,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 10,
   "firman": "Demikianlah Edom memberontak kekuasaan Yehuda dan terlepas sampai sekarang ini. Lalu Libnapun memberontak terhadap kekuasaannya pada masa itu juga. Itu disebabkan karena ia telah meninggalkan TUHAN, Allah nenek moyangnya."
 },
 {
   "id": 11638,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 11,
   "firman": "Lagipula ia membuat bukit-bukit pengorbanan di gunung-gunung Yehuda. Ia membujuk penduduk Yerusalem untuk berzinah dan ia menyesatkan Yehuda."
 },
 {
   "id": 11639,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 12,
   "firman": "Lalu sampailah kepadanya sebuah surat dari nabi Elia yang bunyinya: \"Beginilah firman TUHAN, Allah Daud, bapa leluhurmu: Karena engkau tidak hidup mengikuti jejak Yosafat, ayahmu, dan Asa, raja Yehuda,"
 },
 {
   "id": 11640,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 13,
   "firman": "melainkan hidup menurut kelakuan raja-raja Israel dan membujuk Yehuda dan penduduk-penduduk Yerusalem untuk berzinah, sama seperti yang dilakukan keluarga Ahab, dan juga karena engkau telah membunuh saudara-saudaramu, seluruh keluarga ayahmu yang lebih baik dari padamu,"
 },
 {
   "id": 11641,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 14,
   "firman": "maka TUHAN akan mendatangkan tulah besar atas rakyatmu, anak-anakmu, isteri-isterimu, dan atas semua harta milikmu."
 },
 {
   "id": 11642,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 15,
   "firman": "Dan engkau sendiri akan menderita penyakit yang dahsyat, suatu penyakit usus, hingga selang beberapa waktu ususmu keluar oleh karena penyakit itu.\""
 },
 {
   "id": 11643,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 16,
   "firman": "Lalu TUHAN menggerakkan hati orang Filistin dan orang Arab yang tinggal berdekatan dengan orang Etiopia untuk melawan Yoram."
 },
 {
   "id": 11644,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 17,
   "firman": "Maka mereka maju melawan Yehuda, memasukinya dan mengangkut segala harta milik yang terdapat di dalam istana raja sebagai jarahan, juga anak-anak dan isteri-isterinya, sehingga tidak ada seorang anak yang tinggal padanya kecuali Yoahas, anaknya yang bungsu."
 },
 {
   "id": 11645,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 18,
   "firman": "Sesudah semuanya ini TUHAN menulahinya dengan penyakit usus yang tidak dapat sembuh."
 },
 {
   "id": 11646,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 19,
   "firman": "Beberapa waktu berselang, kira-kira sesudah lewat dua tahun, keluarlah ususnya karena penyakitnya itu, lalu ia mati dengan penderitaan yang hebat. Rakyatnya tidak menyalakan api baginya seperti yang diperbuat mereka bagi nenek moyangnya."
 },
 {
   "id": 11647,
   "kitab": "2Ta",
   "pasal": 21,
   "ayat": 20,
   "firman": "Ia berumur tiga puluh dua tahun pada waktu ia menjadi raja dan delapan tahun lamanya ia memerintah di Yerusalem. Ia meninggal dengan tidak dicintai orang. Ia dikuburkan di kota Daud, tetapi tidak di dalam pekuburan raja-raja."
 },
 {
   "id": 11648,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu penduduk Yerusalem mengangkat Ahazia, anaknya yang bungsu, menjadi raja menggantikan dia, karena semua anaknya yang lebih tua umurnya telah dibunuh oleh gerombolan yang datang ke tempat perkemahan bersama-sama orang-orang Arab. Dengan demikian Ahazia, anak Yoram raja Yehuda, menjadi raja."
 },
 {
   "id": 11649,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 2,
   "firman": "Ahazia berumur empat puluh dua tahun pada waktu ia menjadi raja dan setahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Atalya, cucu Omri."
 },
 {
   "id": 11650,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 3,
   "firman": "Iapun hidup menurut kelakuan keluarga Ahab, karena ibunya menasihatinya untuk melakukan yang jahat."
 },
 {
   "id": 11651,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 4,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN sama seperti keluarga Ahab, sebab sesudah ayahnya mati mereka menjadi penasihat-penasihatnya yang mencelakakannya."
 },
 {
   "id": 11652,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 5,
   "firman": "Atas nasihat mereka pula ia pergi bersama-sama Yoram bin Ahab, raja Israel, untuk berperang melawan Hazael, raja Aram, di Ramot-Gilead. Tetapi orang-orang Aram melukai Yoram."
 },
 {
   "id": 11653,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 6,
   "firman": "Kemudian pulanglah ia ke Yizreel untuk diobati oleh karena luka-luka yang didapatnya di Rama pada waktu ia berperang melawan Hazael, raja Aram. Dan Ahazia, anak Yoram raja Yehuda, pergi menjenguk Yoram bin Ahab di Yizreel, karena dia sakit."
 },
 {
   "id": 11654,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 7,
   "firman": "Telah ditentukan Allah, bahwa Ahazia akan menemui ajalnya pada waktu ia mengunjungi Yoram; maka ketika Ahazia datang, pergilah ia bersama-sama Yoram mendapatkan Yehu, cucu Nimsi, yang telah diurapi TUHAN, supaya dialah yang melenyapkan keluarga Ahab."
 },
 {
   "id": 11655,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 8,
   "firman": "Sementara Yehu melakukan penghukuman atas keluarga Ahab, ia menjumpai pembesar-pembesar Yehuda dan anak-anak saudara-saudara Ahazia, yang melayani Ahazia. Juga mereka dibunuhnya."
 },
 {
   "id": 11656,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 9,
   "firman": "Lalu ia mencari Ahazia; Ahazia tertangkap ketika ia bersembunyi di Samaria. Ia dibawa kepada Yehu, lalu dibunuh, tetapi dikuburkan juga, karena kata orang: \"Dia ini cucu Yosafat, yang mencari TUHAN dengan segenap hatinya.\" Dari keluarga Ahazia tidak ada lagi yang sanggup memerintah."
 },
 {
   "id": 11657,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 10,
   "firman": "Ketika Atalya, ibu Ahazia, melihat bahwa anaknya sudah mati, maka bangkitlah ia membinasakan semua keturunan raja dari kaum Yehuda."
 },
 {
   "id": 11658,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 11,
   "firman": "Tetapi Yosabat, anak perempuan raja, mengambil Yoas bin Ahazia, menculik dia dari tengah-tengah anak-anak raja yang hendak dibunuh itu, memasukkan dia dengan inang penyusunya ke dalam gudang tempat tidur. Demikianlah Yosabat, anak perempuan raja Yoram, isteri imam Yoyada, --ia adalah saudara perempuan Ahazia--menyembunyikan dia terhadap Atalya, sehingga ia tidak dibunuh Atalya."
 },
 {
   "id": 11659,
   "kitab": "2Ta",
   "pasal": 22,
   "ayat": 12,
   "firman": "Maka tinggallah Yoas enam tahun lamanya bersama-sama mereka dengan bersembunyi di rumah Allah, sementara Atalya memerintah negeri."
 },
 {
   "id": 11660,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 1,
   "firman": "Tetapi dalam tahun ketujuh Yoyada memberanikan diri dan ia mengadakan persepakatan dengan para kepala pasukan seratus, yakni: Azarya bin Yeroham, Ismael bin Yohanan, Azarya bin Obed. Maaseya bin Adaya, dan Elisafat bin Zikhri."
 },
 {
   "id": 11661,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 2,
   "firman": "Mereka mengelilingi Yehuda dan mengumpulkan orang-orang Lewi dari semua kota di Yehuda serta kepala-kepala puak orang Israel, dan mereka semua datang ke Yerusalem."
 },
 {
   "id": 11662,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 3,
   "firman": "Lalu seluruh jemaah itu mengikat perjanjian dengan raja di rumah Allah. Kata Yoyada kepada mereka: \"Lihatlah, anak raja! Biarlah ia memerintah, seperti yang telah difirmankan TUHAN tentang anak-anak Daud!"
 },
 {
   "id": 11663,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 4,
   "firman": "Inilah yang harus kamu lakukan: sepertiga dari kamu, yakni yang selesai bertugas pada hari Sabat, baik imam maupun orang Lewi, haruslah menjadi penunggu pintu,"
 },
 {
   "id": 11664,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 5,
   "firman": "sepertiga lagi haruslah berada di istana raja, dan sepertiga pula di pintu gerbang Dasar, sedang seluruh rakyat haruslah berada di pelataran rumah TUHAN."
 },
 {
   "id": 11665,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 6,
   "firman": "Siapapun tidak boleh memasuki rumah TUHAN selain dari pada para imam dan orang-orang Lewi yang bertugas. Mereka boleh masuk, karena mereka kudus, tetapi seluruh rakyat haruslah mentaati peraturan TUHAN."
 },
 {
   "id": 11666,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 7,
   "firman": "Dalam pada itu orang-orang Lewi haruslah mengelilingi raja dari segala penjuru, masing-masing dengan senjatanya di tangannya, dan siapa yang memasuki rumah itu haruslah dibunuh. Dan baiklah kamu menyertai raja setiap kali ia keluar atau masuk.\""
 },
 {
   "id": 11667,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 8,
   "firman": "Orang-orang Lewi dan seluruh Yehuda melakukan tepat seperti yang diperintahkan imam Yoyada. Masing-masing mengambil orang-orangnya yang selesai bertugas pada hari Sabat bersama-sama dengan orang-orang yang masuk bertugas pada hari itu, karena imam Yoyada tidak membebaskan rombongan-rombongan itu."
 },
 {
   "id": 11668,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 9,
   "firman": "Lalu imam Yoyada memberikan kepada para kepala pasukan seratus itu tombak-tombak, utar-utar dan perisai-perisai kepunyaan raja Daud yang ada di rumah Allah."
 },
 {
   "id": 11669,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 10,
   "firman": "Ia menempatkan seluruh rakyat, masing-masing dengan lembing di tangannya, di lambung kanan sampai ke lambung kiri rumah itu, dengan mengelilingi mezbah dan rumah itu untuk melindungi raja."
 },
 {
   "id": 11670,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 11,
   "firman": "Sesudah itu Yoyada dan anak-anaknya membawa anak raja itu ke luar, mengenakan jejamang kepadanya dan memberikan hukum Allah kepadanya. Mereka menobatkan dia menjadi raja serta mengurapinya, lalu berserulah rakyat: \"Hiduplah raja!\""
 },
 {
   "id": 11671,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 12,
   "firman": "Ketika Atalya mendengar pekik rakyat yang berlari-lari menyambut raja dan memuji-muji dia, pergilah ia mendapatkan rakyat itu ke dalam rumah TUHAN."
 },
 {
   "id": 11672,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 13,
   "firman": "Lalu dilihatnyalah raja berdiri dekat tiangnya pada jalan masuk, sedang para pemimpin dengan para pemegang nafiri ada dekat raja. Dan seluruh rakyat negeri bersukaria sambil meniup nafiri, sedang para penyanyi dengan alat-alat musik mereka, memimpin nyanyian puji-pujian. Maka Atalya mengoyakkan pakaiannya sambil berkata: \"Khianat, khianat!\""
 },
 {
   "id": 11673,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 14,
   "firman": "Tetapi imam Yoyada menyuruh keluar para kepala pasukan seratus, yakni orang-orang yang mengepalai tentara, katanya kepada mereka: \"Bawalah dia keluar dari antara barisan! Siapa yang memihak kepadanya harus dibunuh dengan pedang!\" Sebab imam itu telah berkata tadinya: \"Jangan kamu membunuhnya di rumah TUHAN!\""
 },
 {
   "id": 11674,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 15,
   "firman": "Lalu mereka menangkap perempuan itu. Pada waktu ia sampai ke jalan masuk istana raja pada pintu gerbang Kuda, dibunuhlah ia di situ."
 },
 {
   "id": 11675,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 16,
   "firman": "Kemudian Yoyada mengikat perjanjian antara dia dengan segenap rakyat dan raja, bahwa mereka menjadi umat TUHAN."
 },
 {
   "id": 11676,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 17,
   "firman": "Sesudah itu masuklah seluruh rakyat ke rumah Baal, lalu merobohkannya; mereka memecahkan mezbah-mezbahnya dan patung-patungnya dan membunuh Matan, imam Baal, di depan mezbah-mezbah itu."
 },
 {
   "id": 11677,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 18,
   "firman": "Kemudian Yoyada menyerahkan pengawasan atas rumah TUHAN kepada imam-imam dan orang-orang Lewi, yang telah dibagi-bagi dalam rombongan oleh Daud untuk bertugas di dalam rumah TUHAN, yakni untuk mempersembahkan korban bakaran kepada TUHAN--seperti tertulis di dalam Taurat Musa--dengan sukaria dan dengan nyanyian menurut petunjuk Daud."
 },
 {
   "id": 11678,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 19,
   "firman": "Juga ditempatkannya penunggu-penunggu pintu pada pintu-pintu gerbang rumah TUHAN, supaya dalam hal apapun juga jangan masuk seseorang yang najis."
 },
 {
   "id": 11679,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 20,
   "firman": "Sesudah itu ia mengajak para kepala pasukan seratus, para pemuka, para pemerintah rakyat dan seluruh rakyat negeri, lalu membawa raja turun dari rumah TUHAN; mereka masuk ke istana raja melalui pintu gerbang Atas, lalu mendudukkan raja ke atas takhta kerajaan."
 },
 {
   "id": 11680,
   "kitab": "2Ta",
   "pasal": 23,
   "ayat": 21,
   "firman": "Bersukarialah seluruh rakyat negeri dan amanlah kota itu, setelah Atalya mati dibunuh dengan pedang."
 },
 {
   "id": 11681,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 1,
   "firman": "Yoas berumur tujuh tahun pada waktu ia menjadi raja, dan empat puluh tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Zibya, dari Bersyeba."
 },
 {
   "id": 11682,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 2,
   "firman": "Yoas melakukan apa yang benar di mata TUHAN selama hidup imam Yoyada."
 },
 {
   "id": 11683,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 3,
   "firman": "Yoyada mengambil dua orang isteri bagi dia; dari mereka ia mendapat anak laki-laki dan anak perempuan."
 },
 {
   "id": 11684,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 4,
   "firman": "Kemudian Yoas bermaksud untuk membaharui rumah TUHAN."
 },
 {
   "id": 11685,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 5,
   "firman": "Ia mengumpulkan para imam dan orang Lewi dan berkata kepada mereka: \"Pergilah kamu ke kota-kota Yehuda dan kumpulkanlah uang dari seluruh orang Israel untuk memperbaiki rumah Allahmu setiap tahun. Lakukanlah hal itu dengan segera!\" Tetapi orang Lewi itu tidak melakukannya dengan segera."
 },
 {
   "id": 11686,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 6,
   "firman": "Lalu raja memanggil imam kepala Yoyada dan bertanya kepadanya: \"Mengapa engkau tidak menuntut kepada orang-orang Lewi untuk membawa dari Yehuda dan dari Yerusalem pajak yang dikenakan Musa, hamba Allah itu, kepada jemaah Israel untuk Kemah tempat hukum Allah?"
 },
 {
   "id": 11687,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 7,
   "firman": "Sebab anak-anak Atalya, perempuan fasik itu, telah membongkar rumah Allah, bahkan memakai barang-barang kudus rumah TUHAN untuk para Baal.\""
 },
 {
   "id": 11688,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 8,
   "firman": "Sesudah itu raja memerintahkan supaya dibuat sebuah peti dan ditempatkan di depan pintu gerbang rumah TUHAN,"
 },
 {
   "id": 11689,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 9,
   "firman": "lalu menyuruh mengumumkan di Yehuda dan di Yerusalem, bahwa orang harus membawa bagi TUHAN pajak yang dikenakan Musa, hamba Allah itu, kepada orang Israel di padang gurun."
 },
 {
   "id": 11690,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 10,
   "firman": "Maka bersukacitalah semua pemimpin dan seluruh rakyat; mereka datang membawa pajaknya dan memasukkannya ke dalam peti itu sampai penuh."
 },
 {
   "id": 11691,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 11,
   "firman": "Setiap kali peti itu dibawa masuk untuk diperiksa oleh orang-orang Lewi atas nama raja, dan apabila mereka melihat bahwa sudah banyak uang di dalamnya, maka datanglah panitera raja dan kuasa usaha imam kepala mengeluarkan isi peti itu; kemudian mereka mengangkat peti itu, lalu menaruhnya pula di tempatnya. Demikianlah mereka lakukan setiap kali, dan banyaklah uang yang dikumpulkan."
 },
 {
   "id": 11692,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 12,
   "firman": "Raja dan Yoyada menyerahkan uang itu kepada mereka yang memanduri pekerjaan pada rumah TUHAN. Mereka ini mengupah tukang-tukang pahat dan tukang-tukang kayu untuk membaharui rumah TUHAN; juga tukang-tukang besi dan tembaga untuk memperbaiki rumah TUHAN."
 },
 {
   "id": 11693,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 13,
   "firman": "Setelah itu mulailah tukang-tukang itu bekerja; pekerjaan perbaikan maju di bawah tangan mereka. Mereka membangun kembali rumah Allah menurut keadaannya semula dan mengokohkannya."
 },
 {
   "id": 11694,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 14,
   "firman": "Setelah mereka selesai, mereka membawa uang yang kelebihan kepada raja dan Yoyada. Uang itu dipakai untuk membuat perkakas-perkakas rumah TUHAN, yakni: perkakas-perkakas untuk penyelenggaraan kebaktian, perkakas-perkakas untuk korban bakaran, juga cawan-cawan dan perkakas-perkakas emas dan perak. Sepanjang umur Yoyada korban bakaran tetap dipersembahkan dalam rumah TUHAN."
 },
 {
   "id": 11695,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 15,
   "firman": "Yoyada menjadi tua, dan lanjut umur, lalu matilah ia. Seratus tiga puluh tahun umurnya ketika ia mati."
 },
 {
   "id": 11696,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 16,
   "firman": "Ia dikuburkan di kota Daud di samping raja-raja, karena perbuatan-perbuatannya yang baik di Israel terhadap Allah dan rumah-Nya."
 },
 {
   "id": 11697,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 17,
   "firman": "Sesudah Yoyada mati, pemimpin-pemimpin Yehuda datang menyembah kepada raja. Sejak itu raja mendengarkan mereka."
 },
 {
   "id": 11698,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 18,
   "firman": "Mereka meninggalkan rumah TUHAN, Allah nenek moyang mereka, lalu beribadah kepada tiang-tiang berhala dan patung-patung berhala. Oleh karena kesalahan itu Yehuda dan Yerusalem tertimpa murka."
 },
 {
   "id": 11699,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 19,
   "firman": "Namun TUHAN mengutus nabi-nabi kepada mereka, supaya mereka berbalik kepada-Nya. Nabi-nabi itu sungguh-sungguh memperingatkan mereka, tetapi mereka tidak mau mendengarkannya."
 },
 {
   "id": 11700,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 20,
   "firman": "Lalu Roh Allah menguasai Zakharia, anak imam Yoyada. Ia tampil di depan rakyat, dan berkata kepada mereka: \"Beginilah firman Allah: Mengapa kamu melanggar perintah-perintah TUHAN, sehingga kamu tidak beruntung? Oleh karena kamu meninggalkan TUHAN, Iapun meninggalkan kamu!\""
 },
 {
   "id": 11701,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 21,
   "firman": "Tetapi mereka mengadakan persepakatan terhadap dia, dan atas perintah raja mereka melontari dia dengan batu di pelataran rumah TUHAN."
 },
 {
   "id": 11702,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 22,
   "firman": "Raja Yoas tidak mengingat kesetiaan yang ditunjukkan Yoyada, ayah Zakharia itu, terhadap dirinya. Ia membunuh anak Yoyada itu, yang pada saat kematiannya berseru: \"Semoga TUHAN melihatnya dan menuntut balas!\""
 },
 {
   "id": 11703,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 23,
   "firman": "Pada pergantian tahun tentara Aram maju menyerang Yoas dan masuk ke Yehuda dan Yerusalem. Dari bangsa itu semua pemimpin habis dibunuh mereka dan segala jarahan dikirim mereka kepada raja negeri Damsyik."
 },
 {
   "id": 11704,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 24,
   "firman": "Walaupun tentara Aram itu datang dengan sedikit orang, namun TUHAN menyerahkan tentara yang sangat besar kepada mereka, karena orang Yehuda telah meninggalkan TUHAN, Allah nenek moyang mereka. Demikianlah orang Aram melakukan penghukuman kepada Yoas."
 },
 {
   "id": 11705,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 25,
   "firman": "Ketika mereka pergi dari padanya, --mereka meninggalkannya dengan luka-luka berat--pegawai-pegawainya mengadakan persepakatan terhadap dia karena darah anak imam Yoyada itu, lalu membunuhnya di atas tempat tidurnya. Ia mati dan dikuburkan di kota Daud, tetapi tidak di pekuburan raja-raja."
 },
 {
   "id": 11706,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 26,
   "firman": "Mereka yang mengadakan persepakatan terhadap dia ialah: Zabad, anak Simeat perempuan Amon, dan Yozabad, anak Simrit perempuan Moab."
 },
 {
   "id": 11707,
   "kitab": "2Ta",
   "pasal": 24,
   "ayat": 27,
   "firman": "Tentang anak-anaknya dan ucapan-ucapan ilahi yang banyak terhadap dia, serta tentang perbaikan rumah Allah, semua itu tertulis dalam tafsiran kitab raja-raja. Maka Amazia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11708,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 1,
   "firman": "Amazia berumur dua puluh lima tahun pada waktu ia menjadi raja dan dua puluh sembilan tahun lamanya ia memerintah di Yerusalem; nama ibunya ialah Yoadan, dari Yerusalem."
 },
 {
   "id": 11709,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 2,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, hanya tidak dengan segenap hati."
 },
 {
   "id": 11710,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 3,
   "firman": "Segera sesudah kuasa kerajaan itu kokoh di tangannya, dibunuhnyalah pegawai-pegawainya yang telah membunuh raja, yaitu ayahnya."
 },
 {
   "id": 11711,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 4,
   "firman": "Tetapi anak-anak mereka tidak dihukum mati olehnya, melainkan ia bertindak sesuai dengan apa yang tertulis dalam Taurat, yakni kitab Musa, di mana TUHAN telah memberi perintah: \"Janganlah ayah mati karena anaknya, janganlah juga anak mati karena ayahnya, melainkan setiap orang harus mati karena dosanya sendiri.\""
 },
 {
   "id": 11712,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 5,
   "firman": "Lalu Amazia mengumpulkan orang Yehuda dan menyuruh mereka, yakni seluruh orang Yehuda dan Benyamin, berdiri menurut puak-puaknya di bawah kepala-kepala pasukan seribu dan kepala-kepala pasukan seratus. Ketika ia menghitung mereka yang berumur dua puluh tahun ke atas, didapatinya tiga ratus ribu teruna yang sanggup keluar berperang dengan tombak dan perisai."
 },
 {
   "id": 11713,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 6,
   "firman": "Selain itu ia menyewa seratus ribu pahlawan yang gagah perkasa dari Israel dengan bayaran seratus talenta perak."
 },
 {
   "id": 11714,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 7,
   "firman": "Tetapi seorang abdi Allah datang kepadanya dan berkata: \"Ya raja, janganlah tentara Israel dibiarkan bergabung kepada tuanku, karena TUHAN tidak menyertai Israel, yakni semua bani Efraim ini."
 },
 {
   "id": 11715,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 8,
   "firman": "Dan jikalau mereka bergabung juga, bagaimanapun juga perbuatan dan kekuatanmu di dalam perang, Allah akan menggelincirkan engkau di depan musuh, sebab Allah mempunyai kuasa untuk menolong dan menggelincirkan!\""
 },
 {
   "id": 11716,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 9,
   "firman": "Lalu kata Amazia kepada abdi Allah itu: \"Bagaimana dengan seratus talenta yang telah kuberikan kepada pasukan-pasukan Israel itu?\" Jawab abdi Allah itu: \"TUHAN dapat memberikan lebih dari pada itu kepadamu!\""
 },
 {
   "id": 11717,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 10,
   "firman": "Kemudian Amazia memisahkan pasukan yang datang bergabung kepadanya dari Efraim, supaya mereka kembali ke tempat tinggalnya. Maka sangat marahlah mereka terhadap Yehuda. Mereka kembali ke tempat tinggalnya dengan marah yang menyala-nyala."
 },
 {
   "id": 11718,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 11,
   "firman": "Amazia mendapat keberanian lalu memimpin rakyatnya ke Lembah Asin dan memukul kalah sepuluh ribu orang dari bani Seir."
 },
 {
   "id": 11719,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 12,
   "firman": "Selain itu sepuluh ribu orang ditawan hidup-hidup oleh bani Yehuda dan dibawa ke suatu puncak bukit batu, lalu mereka dicampakkan dari puncak bukit batu itu, sehingga hancurlah mereka semua."
 },
 {
   "id": 11720,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 13,
   "firman": "Tetapi orang-orang dari pasukan yang dipulangkan Amazia, dan yang tidak diperbolehkan ikut berperang dengan dia, menyerbu kota-kota di Yehuda dari jurusan Samaria sampai ke Bet-Horon, dan menewaskan tiga ribu orang penduduknya dan merampas banyak jarahan."
 },
 {
   "id": 11721,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 14,
   "firman": "Ketika Amazia kembali, setelah mengalahkan orang-orang Edom itu, ia mendirikan para allah bani Seir, yang dibawanya pulang, sebagai allahnya. Ia sujud menyembah kepada allah-allah itu dan membakar korban untuk mereka."
 },
 {
   "id": 11722,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 15,
   "firman": "Maka bangkitlah murka TUHAN terhadap Amazia; Ia menyuruh seorang nabi kepadanya yang berkata: \"Mengapa engkau mencari allah sesuatu bangsa yang tidak dapat melepaskan bangsanya sendiri dari tanganmu?\""
 },
 {
   "id": 11723,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 16,
   "firman": "Waktu nabi sedang berbicara, berkatalah Amazia kepadanya: \"Apakah kami telah mengangkat engkau menjadi penasihat raja? Diamlah! Apakah engkau mau dibunuh?\" Lalu diamlah nabi itu setelah berkata: \"Sekarang aku tahu, bahwa Allah telah menentukan akan membinasakan engkau, karena engkau telah berbuat hal ini, dan tidak mendengarkan nasihatku!\""
 },
 {
   "id": 11724,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 17,
   "firman": "Kemudian Amazia, raja Yehuda, mengadakan perundingan, lalu menyuruh orang kepada Yoas bin Yoahas bin Yehu, raja Israel, mengatakan: \"Mari kita mengadu tenaga!\""
 },
 {
   "id": 11725,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 18,
   "firman": "Tetapi Yoas, raja Israel, menyuruh orang kepada Amazia, raja Yehuda, mengatakan: \"Onak yang di gunung Libanon mengirim pesan kepada pohon aras yang di gunung Libanon, bunyinya: Berikanlah anakmu perempuan kepada anakku laki-laki menjadi isterinya. Tetapi binatang-binatang hutan yang ada di gunung Libanon itu berjalan lewat dari sana, lalu menginjak onak itu."
 },
 {
   "id": 11726,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 19,
   "firman": "Pikirmu, engkau sudah mengalahkan Edom, sebab itu hatimu mengangkat-angkat dirimu untuk mendapat kehormatan. Sekarang, tinggal saja di rumah. Untuk apa engkau menantang malapetaka, sehingga engkau jatuh dan Yehuda bersama-sama engkau?\""
 },
 {
   "id": 11727,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 20,
   "firman": "Tetapi Amazia tidak mau mendengarkan; sebab hal itu telah ditetapkan Allah yang hendak menyerahkan mereka ke dalam tangan Yoas, karena mereka telah mencari allah orang Edom."
 },
 {
   "id": 11728,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 21,
   "firman": "Sebab itu majulah Yoas, raja Israel, lalu mengadu tenagalah mereka, ia dan Amazia, raja Yehuda, di Bet-Semes yang termasuk wilayah Yehuda."
 },
 {
   "id": 11729,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 22,
   "firman": "Yehuda terpukul kalah oleh Israel, sehingga masing-masing lari ke kemahnya."
 },
 {
   "id": 11730,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 23,
   "firman": "Yoas, raja Israel, menangkap Amazia, raja Yehuda, anak Yoas bin Yoahas, di Bet-Semes. Lalu Yoas membawa dia ke Yerusalem. Ia membongkar tembok Yerusalem dari Pintu Gerbang Efraim sampai ke Pintu Gerbang Sudut, empat ratus hasta panjangnya."
 },
 {
   "id": 11731,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 24,
   "firman": "Sesudah itu ia mengambil segala emas dan perak dan segala perkakas yang terdapat dalam rumah Allah dan yang berada di bawah pengawasan keluarga Obed-Edom, juga perbendaharaan istana raja dan orang-orang sandera, kemudian pulanglah ia ke Samaria."
 },
 {
   "id": 11732,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 25,
   "firman": "Amazia bin Yoas, raja Yehuda, masih hidup lima belas tahun lamanya sesudah Yoas bin Yoahas, raja Israel, mati."
 },
 {
   "id": 11733,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 26,
   "firman": "Selebihnya dari riwayat Amazia, dari awal sampai akhir, bukankah semuanya itu tertulis dalam kitab raja-raja Yehuda dan Israel?"
 },
 {
   "id": 11734,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 27,
   "firman": "Sejak Amazia menjauhi TUHAN, orang mengadakan persepakatan melawan dia di Yerusalem, sebab itu larilah ia ke Lakhis. Tetapi mereka menyuruh mengejar dia ke Lakhis, lalu dibunuhlah ia di sana."
 },
 {
   "id": 11735,
   "kitab": "2Ta",
   "pasal": 25,
   "ayat": 28,
   "firman": "Ia diangkut dengan kuda, lalu dikuburkan di samping nenek moyangnya di kota Daud."
 },
 {
   "id": 11736,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 1,
   "firman": "Segenap bangsa Yehuda mengambil Uzia, yang masih berumur enam belas tahun dan menobatkan dia menjadi raja menggantikan ayahnya, Amazia."
 },
 {
   "id": 11737,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 2,
   "firman": "Ia memperkuat Elot dan mengembalikannya kepada Yehuda, sesudah raja mendapat perhentian bersama-sama dengan nenek moyangnya."
 },
 {
   "id": 11738,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 3,
   "firman": "Uzia berumur enam belas tahun pada waktu ia menjadi raja dan lima puluh dua tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yekholya, dari Yerusalem."
 },
 {
   "id": 11739,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 4,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Amazia, ayahnya."
 },
 {
   "id": 11740,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 5,
   "firman": "Ia mencari Allah selama hidup Zakharia, yang mengajarnya supaya takut akan Allah. Dan selama ia mencari TUHAN, Allah membuat segala usahanya berhasil."
 },
 {
   "id": 11741,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 6,
   "firman": "Maka majulah ia berperang melawan orang-orang Filistin dan membongkar tembok Gat, Yabne dan Asdod, lalu mendirikan kota-kota di sekitar Asdod dan di lain-lain wilayah orang Filistin."
 },
 {
   "id": 11742,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 7,
   "firman": "Allah menolongnya terhadap orang Filistin, dan terhadap orang Arab yang tinggal di Gur-Baal, dan terhadap orang Meunim."
 },
 {
   "id": 11743,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 8,
   "firman": "Orang-orang Amon membayar upeti kepada Uzia. Namanya termasyhur sampai ke Mesir, karena kekuatannya yang besar."
 },
 {
   "id": 11744,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 9,
   "firman": "Uzia mendirikan menara di Yerusalem di atas Pintu Gerbang Sudut di atas Pintu Gerbang Lebak dan di atas Penjuru, serta mengokohkannya."
 },
 {
   "id": 11745,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 10,
   "firman": "Ia mendirikan juga menara-menara di padang gurun dan menggali banyak sumur, karena banyak ternaknya, baik di Dataran Rendah maupun di Dataran Tinggi. Juga ia mempunyai petani-petani dan penjaga-penjaga kebun anggur, di gunung-gunung dan di tanah yang subur, karena ia suka pada pertanian."
 },
 {
   "id": 11746,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 11,
   "firman": "Selain itu Uzia mempunyai tentara yang sanggup berperang, yang maju berperang dalam laskar-laskar menurut jumlah anak buah yang dicatat oleh panitera Yeiel dan penata usaha Maaseya, di bawah pimpinan Hananya, salah seorang panglima raja."
 },
 {
   "id": 11747,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 12,
   "firman": "Kepala-kepala puak pahlawan-pahlawan yang gagah perkasa itu seluruhnya berjumlah dua ribu enam ratus orang."
 },
 {
   "id": 11748,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 13,
   "firman": "Di bawah pimpinan mereka terdapat satu balatentara, terdiri dari tiga ratus tujuh ribu lima ratus orang yang gagah perkasa dalam berperang, untuk membantu raja dalam menghadapi musuh."
 },
 {
   "id": 11749,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 14,
   "firman": "Uzia memperlengkapi seluruh tentara itu dengan perisai, tombak, ketopong, baju zirah, busur dan batu umban."
 },
 {
   "id": 11750,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 15,
   "firman": "Ia membuat juga di Yerusalem alat-alat perang, ciptaan seorang ahli, yang dapat menembakkan anak panah dan batu besar, untuk ditempatkan di atas menara-menara dan penjuru-penjuru. Nama raja itu termasyhur sampai ke negeri-negeri yang jauh, karena ia ditolong dengan ajaib sehingga menjadi kuat."
 },
 {
   "id": 11751,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 16,
   "firman": "Setelah ia menjadi kuat, ia menjadi tinggi hati sehingga ia melakukan hal yang merusak. Ia berubah setia kepada TUHAN, Allahnya, dan memasuki bait TUHAN untuk membakar ukupan di atas mezbah pembakaran ukupan."
 },
 {
   "id": 11752,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 17,
   "firman": "Tetapi imam Azarya mengikutinya dari belakang bersama-sama delapan puluh imam TUHAN, orang-orang yang tegas;"
 },
 {
   "id": 11753,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 18,
   "firman": "mereka berdiri di depan raja Uzia dan berkata kepadanya: \"Hai, Uzia, engkau tidak berhak membakar ukupan kepada TUHAN, hanyalah imam-imam keturunan Harun yang telah dikuduskan yang berhak membakar ukupan! Keluarlah dari tempat kudus ini, karena engkau telah berubah setia! Engkau tidak akan memperoleh kehormatan dari TUHAN Allah karena hal ini.\""
 },
 {
   "id": 11754,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 19,
   "firman": "Tetapi Uzia, dengan bokor ukupan di tangannya untuk dibakar menjadi marah. Sementara amarahnya meluap terhadap para imam, timbullah penyakit kusta pada dahinya di hadapan para imam di rumah TUHAN, dekat mezbah pembakaran ukupan."
 },
 {
   "id": 11755,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 20,
   "firman": "Imam kepala Azarya dan semua imam lainnya memandang kepadanya, dan sesungguhnya, ia sakit kusta pada dahinya. Cepat-cepat mereka mengusirnya dari sana, dan ia sendiri tergesa-gesa keluar, karena TUHAN telah menimpakan tulah kepadanya."
 },
 {
   "id": 11756,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 21,
   "firman": "Raja Uzia sakit kusta sampai kepada hari matinya, dan sebagai orang yang sakit kusta ia tinggal dalam sebuah rumah pengasingan, karena ia dikucilkan dari rumah TUHAN. Dan Yotam, anaknya, mengepalai istana raja dan menjalankan pemerintahan atas rakyat negeri itu."
 },
 {
   "id": 11757,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 22,
   "firman": "Selebihnya dari riwayat Uzia, dari awal sampai akhir, ditulis oleh nabi Yesaya bin Amos."
 },
 {
   "id": 11758,
   "kitab": "2Ta",
   "pasal": 26,
   "ayat": 23,
   "firman": "Kemudian Uzia mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di samping nenek moyangnya di ladang dekat pekuburan raja-raja, karena ia berpenyakit kusta, kata orang. Maka Yotam, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11759,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 1,
   "firman": "Yotam berumur dua puluh lima tahun pada waktu ia menjadi raja dan enam belas tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Yerusa, anak Zadok."
 },
 {
   "id": 11760,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 2,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Uzia, ayahnya, hanya ia tidak memasuki Bait TUHAN. Tetapi rakyat masih saja melakukan hal yang merusak."
 },
 {
   "id": 11761,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 3,
   "firman": "Ia mendirikan Pintu Gerbang Tinggi di rumah TUHAN dan mengadakan banyak pembangunan pada tembok Ofel."
 },
 {
   "id": 11762,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 4,
   "firman": "Ia mendirikan juga kota-kota di pegunungan Yehuda dan benteng-benteng serta menara-menara di hutan-hutan."
 },
 {
   "id": 11763,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 5,
   "firman": "Ia berperang melawan raja bani Amon dan mengalahkannya, sehingga pada tahun itu juga bani Amon membayar kepadanya seratus talenta perak, sepuluh ribu kor gandum dan sepuluh ribu kor jelai. Juga pada tahun kedua dan ketiga bani Amon membawa upeti itu kepadanya."
 },
 {
   "id": 11764,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 6,
   "firman": "Yotam menjadi kuat, karena ia mengarahkan hidupnya kepada TUHAN, Allahnya."
 },
 {
   "id": 11765,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 7,
   "firman": "Selebihnya dari riwayat Yotam, segala peperangan dan tingkah langkahnya, sesungguhnya semuanya itu tertulis dalam kitab raja-raja Israel dan Yehuda."
 },
 {
   "id": 11766,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 8,
   "firman": "Ia berumur dua puluh lima tahun pada waktu ia menjadi raja dan enam belas tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11767,
   "kitab": "2Ta",
   "pasal": 27,
   "ayat": 9,
   "firman": "Kemudian Yotam mendapat perhentian bersama-sama nenek moyangnya, dan ia dikuburkan di kota Daud. Maka Ahas, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11768,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 1,
   "firman": "Ahas berumur dua puluh tahun pada waktu ia menjadi raja dan enam belas tahun lamanya ia memerintah di Yerusalem. Ia tidak melakukan apa yang benar di mata TUHAN seperti Daud, bapa leluhurnya,"
 },
 {
   "id": 11769,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 2,
   "firman": "tetapi ia hidup menurut kelakuan raja-raja Israel, bahkan ia membuat patung-patung tuangan untuk para Baal."
 },
 {
   "id": 11770,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 3,
   "firman": "Ia membakar juga korban di Lebak Ben-Hinom dan membakar anak-anaknya sebagai korban dalam api, sesuai dengan perbuatan keji bangsa-bangsa yang telah dihalaukan TUHAN dari depan orang Israel."
 },
 {
   "id": 11771,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 4,
   "firman": "Ia mempersembahkan dan membakar korban di bukit-bukit pengorbanan dan di atas tempat-tempat yang tinggi dan di bawah setiap pohon yang rimbun."
 },
 {
   "id": 11772,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 5,
   "firman": "Sebab itu TUHAN, Allahnya, menyerahkannya ke dalam tangan raja orang Aram. Mereka mengalahkan dia dan menawan banyak orang dari padanya, yang diangkut ke Damsyik. Kemudian ia diserahkan pula ke dalam tangan raja Israel dan mengalami kekalahan yang besar."
 },
 {
   "id": 11773,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 6,
   "firman": "Sebab dalam sehari Pekah bin Remalya menewaskan di Yehuda seratus dua puluh ribu orang, semuanya orang-orang yang tangkas, oleh karena mereka telah meninggalkan TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11774,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 7,
   "firman": "Dan Zikhri, pahlawan dari Efraim, membunuh Maaseya, anak raja, Azrikam, kepala istana, dan Elkana orang kedua di bawah raja."
 },
 {
   "id": 11775,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 8,
   "firman": "Orang Israel menawan dari saudara-saudaranya dua ratus ribu orang, yakni perempuan-perempuan serta anak-anak lelaki dan anak-anak perempuan. Mereka merampas juga banyak harta milik dari pada orang-orang itu, dan membawa rampasan itu ke Samaria."
 },
 {
   "id": 11776,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 9,
   "firman": "Tetapi di sana ada seorang nabi TUHAN yang bernama Oded. Ia pergi menemui tentara yang pulang ke Samaria dan berkata kepada mereka: \"Lihatlah, karena kehangatan murka-Nya kepada Yehuda, TUHAN, Allah nenek moyangmu, menyerahkan mereka ke dalam tanganmu, dan kamu telah mengadakan pembunuhan di antara mereka dengan kegeraman yang sampai ke langit."
 },
 {
   "id": 11777,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 10,
   "firman": "Dan sekarang kamu bermaksud menaklukkan orang Yehuda dan Yerusalem menjadi hambamu laki-laki dan perempuan. Tidak adakah pada kamu sendiri kesalahan yang besar terhadap TUHAN, Allahmu?"
 },
 {
   "id": 11778,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 11,
   "firman": "Maka sekarang, dengarkanlah kataku ini: kembalikanlah orang-orang yang kamu tawan dari saudara-saudaramu itu, karena murka Allah menyala-nyala terhadap kamu.\""
 },
 {
   "id": 11779,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 12,
   "firman": "Lalu bangkitlah beberapa pemimpin bani Efraim, yakni: Azarya bin Yohanan, Berekhya bin Mesilemot, Yehizkia bin Salum dan Amasa bin Hadlai menghadapi orang-orang yang pulang dari perang,"
 },
 {
   "id": 11780,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 13,
   "firman": "dan berkata kepada mereka: \"Jangan bawa tawanan-tawanan itu ke mari, sebab maksudmu itu menjadikan kita bersalah terhadap TUHAN dan menambah dosa dan kesalahan kita! Sudah cukup besar kesalahan kita, dan murka yang menyala-nyala telah menimpa Israel.\""
 },
 {
   "id": 11781,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 14,
   "firman": "Lalu orang-orang yang bersenjata itu meninggalkan tawanan dan barang-barang rampasannya di muka para pemimpin dan seluruh jemaah."
 },
 {
   "id": 11782,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 15,
   "firman": "Dan orang-orang yang ditunjuk dengan disebut namanya bangkit, lalu menjemput para tawanan itu. Semua orang yang telanjang mereka berikan pakaian dari rampasan itu. Orang-orang itu diberi pakaian, kasut, makanan dan minuman. Mereka diurapi dengan minyak dan semua yang terlalu payah untuk berjalan diangkut dengan keledai, dan dibawa ke Yerikho, ke kota pohon korma, dekat saudara-saudara mereka. Sesudah itu orang Israel itu pulang ke Samaria."
 },
 {
   "id": 11783,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 16,
   "firman": "Pada waktu itu raja Ahas menyuruh utusan kepada raja negeri Asyur untuk memohon bantuan."
 },
 {
   "id": 11784,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 17,
   "firman": "Karena orang Edom telah datang pula dan mengalahkan Yehuda serta mengangkut tawanan-tawanan."
 },
 {
   "id": 11785,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 18,
   "firman": "Orang-orang Filistin juga telah menyerbu kota-kota di Daerah Bukit dan di Tanah Negeb Yehuda. Merekapun merebut Bet-Semes, Ayalon, Gederot, Sokho dengan segala anak kotanya, Timna dengan segala anak kotanya dan Gomzo dengan segala anak kotanya, dan menetap di kota-kota itu."
 },
 {
   "id": 11786,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 19,
   "firman": "Demikianlah TUHAN merendahkan Yehuda oleh karena Ahas, raja Israel itu, membiarkan kebiadaban berlaku di Yehuda dan berubah setia kepada TUHAN."
 },
 {
   "id": 11787,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 20,
   "firman": "Maka datanglah Tilgat-Pilneser, raja negeri Asyur, kepadanya, hanya bukan membantu dia, melainkan menyesakkannya."
 },
 {
   "id": 11788,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 21,
   "firman": "Walaupun Ahas merampas barang-barang dari rumah TUHAN, dari rumah raja dan dari rumah-rumah para pemimpin dan menyerahkan semua itu kepada raja negeri Asyur, namun perbuatannya itu tidak menguntungkan dia."
 },
 {
   "id": 11789,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 22,
   "firman": "Dalam keadaan terdesak itu raja Ahas ini, malah semakin berubah setia terhadap TUHAN."
 },
 {
   "id": 11790,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 23,
   "firman": "Ia mempersembahkan korban kepada para allah orang Damsyik yang telah mengalahkan dia. Pikirnya: \"Yang membantu raja-raja orang Aram adalah para allah mereka; kepada merekalah aku akan mempersembahkan korban, supaya mereka membantu aku juga.\" Tetapi allah-allah itulah yang menjadi sebab keruntuhan bagi dia dan bersama-sama dengan dia bagi seluruh Israel."
 },
 {
   "id": 11791,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 24,
   "firman": "Ahas mengumpulkan perkakas-perkakas rumah Allah dan menghancurkannya. Ia menutup pintu rumah TUHAN, lalu membuat mezbah-mezbah bagi dirinya di segenap penjuru Yerusalem."
 },
 {
   "id": 11792,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 25,
   "firman": "Di tiap-tiap kota di Yehuda ia membuat bukit-bukit pengorbanan untuk membakar korban bagi allah lain. Dengan demikian ia menyakiti hati TUHAN, Allah nenek moyangnya."
 },
 {
   "id": 11793,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 26,
   "firman": "Selebihnya dari riwayatnya dan seluruh tingkah langkahnya, dari awal sampai akhir, sesungguhnya semuanya itu tertulis dalam kitab raja-raja Yehuda dan Israel."
 },
 {
   "id": 11794,
   "kitab": "2Ta",
   "pasal": 28,
   "ayat": 27,
   "firman": "Kemudian Ahas mendapat perhentian bersama-sama dengan nenek moyangnya, dan dikuburkan di dalam kota, di Yerusalem; tetapi ia tidak dibawa ke pekuburan raja-raja Israel. Maka Hizkia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11795,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 1,
   "firman": "Hizkia berumur dua puluh lima tahun pada waktu ia menjadi raja dan dua puluh sembilan tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Abia, anak Zakharia."
 },
 {
   "id": 11796,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 2,
   "firman": "Ia melakukan apa yang benar di mata TUHAN, tepat seperti yang dilakukan Daud, bapa leluhurnya."
 },
 {
   "id": 11797,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 3,
   "firman": "Pada tahun pertama pemerintahannya, dalam bulan yang pertama, ia membuka pintu-pintu rumah TUHAN dan memperbaikinya."
 },
 {
   "id": 11798,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 4,
   "firman": "Ia mendatangkan para imam dan orang-orang Lewi, dan mengumpulkan mereka di halaman sebelah timur."
 },
 {
   "id": 11799,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 5,
   "firman": "Katanya kepada mereka: \"Dengarlah, hai orang-orang Lewi! Sekarang kuduskanlah dirimu dan kuduskanlah rumah TUHAN, Allah nenek moyangmu! Keluarkanlah kecemaran dari tempat kudus!"
 },
 {
   "id": 11800,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 6,
   "firman": "Karena nenek moyang kita telah berubah setia. Mereka melakukan apa yang jahat di mata TUHAN, Allah kita, telah meninggalkan-Nya, mereka telah memalingkan muka dari kediaman TUHAN dan membelakangi-Nya."
 },
 {
   "id": 11801,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 7,
   "firman": "Bahkan mereka menutup pintu-pintu balai rumah TUHAN dan memadamkan segala pelita. Mereka tidak membakar korban ukupan dan tidak mempersembahkan korban bakaran bagi Allah orang Israel di tempat kudus,"
 },
 {
   "id": 11802,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 8,
   "firman": "sehingga murka TUHAN menimpa Yehuda dan Yerusalem. Ia membuat mereka menjadi kengerian, kedahsyatan dan sasaran suitan seperti yang kamu lihat dengan matamu sendiri."
 },
 {
   "id": 11803,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 9,
   "firman": "Karena hal itulah nenek moyang kita tewas oleh pedang, dan anak-anak lelaki dan anak-anak perempuan kita beserta isteri-isteri kita menjadi tawanan."
 },
 {
   "id": 11804,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 10,
   "firman": "Sekarang aku bermaksud mengikat perjanjian dengan TUHAN, Allah Israel, supaya murka-Nya yang menyala-nyala itu undur dari pada kita."
 },
 {
   "id": 11805,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 11,
   "firman": "Anak-anakku, sekarang janganlah kamu lengah, karena kamu telah dipilih TUHAN untuk berdiri di hadapan-Nya untuk melayani Dia, untuk menyelenggarakan kebaktian dan membakar korban bagi-Nya.\""
 },
 {
   "id": 11806,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 12,
   "firman": "Lalu bangunlah orang-orang Lewi itu, yakni dari bani Kehat: Mahat bin Amasai dan Yoel bin Azaria, dari bani Merari: Kish bin Abdi dan Azaria bin Yehaleleel, dari orang Gerson: Yoah bin Zima dan Eden bin Yoah,"
 },
 {
   "id": 11807,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 13,
   "firman": "dari bani Elisafan: Simri dan Yeiel, dari bani Asaf: Zakharia dan Matanya,"
 },
 {
   "id": 11808,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 14,
   "firman": "dari bani Heman: Yehiel dan Simei, dan dari bani Yedutun: Semaya dan Uziel."
 },
 {
   "id": 11809,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 15,
   "firman": "Mereka mengumpulkan saudara-saudaranya dan menguduskan dirinya. Kemudian mereka datang menurut perintah raja, sesuai dengan firman TUHAN, lalu mentahirkan rumah TUHAN."
 },
 {
   "id": 11810,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 16,
   "firman": "Sesudah itu masuklah para imam ke bagian dalam rumah TUHAN untuk mentahirkannya. Semua yang najis, yang didapati mereka di dalam bait TUHAN, dibawa ke pelataran rumah TUHAN; orang-orang Lewi menerimanya untuk diangkut ke luar, ke lembah Kidron."
 },
 {
   "id": 11811,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 17,
   "firman": "Pekerjaan menguduskan itu dimulai pada tanggal satu bulan yang pertama. Pada hari kedelapan bulan itu mereka sampai ke balai rumah TUHAN dan menguduskan seluruh rumah TUHAN dalam delapan hari. Mereka selesai pada hari keenam belas bulan pertama."
 },
 {
   "id": 11812,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 18,
   "firman": "Lalu masuklah mereka menghadap raja Hizkia dan berkata: \"Kami telah mentahirkan seluruh rumah TUHAN, juga mezbah korban bakaran dengan segala perkakasnya dan meja roti sajian dengan segala perkakasnya."
 },
 {
   "id": 11813,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 19,
   "firman": "Dan segala perkakas, yang dibuang raja Ahas, ketika ia berubah setia pada masa pemerintahannya, telah kami sediakan dan kami kuduskan. Sekarang semuanya itu ada di depan mezbah TUHAN!\""
 },
 {
   "id": 11814,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 20,
   "firman": "Maka pagi-pagi raja Hizkia mengumpulkan pemimpin-pemimpin kota, dan pergi ke rumah TUHAN."
 },
 {
   "id": 11815,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 21,
   "firman": "Mereka membawa tujuh ekor lembu jantan, tujuh ekor domba jantan, tujuh ekor domba muda dan tujuh ekor kambing jantan sebagai korban penghapus dosa untuk keluarga raja, untuk tempat kudus dan untuk Yehuda. Ia memerintahkan anak-anak Harun, yakni para imam, untuk mempersembahkannya di atas mezbah TUHAN."
 },
 {
   "id": 11816,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 22,
   "firman": "Lalu mereka menyembelih lembu-lembu itu; para imam menerima darahnya dan menyiramkannya pada mezbah. Kemudian mereka, menyembelih domba-domba jantan dan menyiramkan darahnya pada mezbah. Sesudah itu mereka menyembelih domba-domba muda dan menyiramkan darahnya pada mezbah."
 },
 {
   "id": 11817,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 23,
   "firman": "Selanjutnya mereka membawa kambing-kambing jantan yang akan menjadi korban penghapus dosa ke hadapan raja dan jemaah. Mereka meletakkan tangannya ke atas kambing-kambing itu."
 },
 {
   "id": 11818,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 24,
   "firman": "Dan para imam menyembelihnya dan mempersembahkan darahnya di atas mezbah sebagai korban penghapus dosa untuk mengadakan pendamaian bagi seluruh Israel. Sebab raja telah memerintahkan untuk mempersembahkan korban bakaran dan korban penghapus dosa itu bagi seluruh Israel."
 },
 {
   "id": 11819,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 25,
   "firman": "Ia menempatkan orang-orang Lewi di rumah TUHAN dengan ceracap, gambus, dan kecapi sesuai dengan perintah Daud dan Gad, pelihat raja, dan nabi Natan, karena dari Tuhanlah perintah itu, dengan perantaraan nabi-nabi-Nya."
 },
 {
   "id": 11820,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 26,
   "firman": "Maka berdirilah orang-orang Lewi dengan alat-alat musik Daud, demikian pula para imam dengan nafiri."
 },
 {
   "id": 11821,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 27,
   "firman": "Lalu Hizkia memerintahkan untuk mempersembahkan korban bakaran di atas mezbah. Pada saat persembahan korban bakaran dimulai, mulailah pula dinyanyikan nyanyian bagi TUHAN dan dibunyikan nafiri, dengan iringan alat-alat musik Daud, raja Israel."
 },
 {
   "id": 11822,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 28,
   "firman": "Seluruh jemaah sujud menyembah sementara nyanyian dinyanyikan dan nafiri dibunyikan. Semuanya itu berlangsung sampai korban bakaran habis terbakar."
 },
 {
   "id": 11823,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 29,
   "firman": "Sehabis korban bakaran dipersembahkan, raja dan semua orang yang hadir bersama-sama dia berlutut dan sujud menyembah."
 },
 {
   "id": 11824,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 30,
   "firman": "Lalu raja Hizkia dan para pemimpin memerintahkan orang-orang Lewi menyanyikan puji-pujian untuk TUHAN dengan kata-kata Daud dan Asaf, pelihat itu. Maka mereka menyanyikan puji-pujian dengan sukaria, lalu berlutut dan sujud menyembah."
 },
 {
   "id": 11825,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 31,
   "firman": "Kemudian berbicaralah Hizkia: \"Sekarang kamu telah mentahbiskan dirimu untuk TUHAN. Mendekatlah dan bawalah korban-korban sembelihan dan korban-korban syukur ke rumah TUHAN!\" Lalu jemaah membawa korban-korban sembelihan dan korban-korban puji-pujian; setiap orang yang rela hati membawa juga korban-korban bakaran."
 },
 {
   "id": 11826,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 32,
   "firman": "Jumlah korban bakaran yang dibawa jemaah ialah: lembu tujuh puluh ekor, domba jantan seratus ekor dan domba muda dua ratus ekor. Semuanya sebagai korban bakaran bagi TUHAN."
 },
 {
   "id": 11827,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 33,
   "firman": "Persembahan-persembahan kudus terdiri dari: lembu sapi enam ratus ekor dan kambing domba tiga ribu ekor."
 },
 {
   "id": 11828,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 34,
   "firman": "Tetapi jumlah imam terlalu sedikit, sehingga mereka tidak sanggup menguliti semua korban bakaran. Oleh sebab itu saudara-saudara mereka, orang-orang Lewi, membantu mereka sampai pekerjaan itu selesai dan sampai para imam menguduskan dirinya. Sebab orang-orang Lewi itu lebih bersungguh-sungguh menguduskan dirinya dari pada para imam."
 },
 {
   "id": 11829,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 35,
   "firman": "Lagipula korban bakaran itu banyak, dengan segala lemak korban keselamatan dan segala korban curahan pada korban-korban bakaran itu. Demikianlah ibadah di rumah TUHAN ditetapkan kembali."
 },
 {
   "id": 11830,
   "kitab": "2Ta",
   "pasal": 29,
   "ayat": 36,
   "firman": "Hizkia dan seluruh rakyat bersukacita akan apa yang telah ditetapkan Allah bagi bangsa itu, karena hal itu terjadi dengan tak disangka-sangka."
 },
 {
   "id": 11831,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 1,
   "firman": "Kemudian Hizkia mengirim pesan kepada seluruh Israel dan Yehuda, bahkan menulis surat kepada Efraim dan Manasye supaya mereka datang merayakan Paskah bagi TUHAN, Allah orang Israel, di rumah TUHAN di Yerusalem."
 },
 {
   "id": 11832,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 2,
   "firman": "Raja bersama-sama para pemimpin dan seluruh jemaah di Yerusalem merancangkan untuk merayakan Paskah pada bulan kedua,"
 },
 {
   "id": 11833,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 3,
   "firman": "karena mereka tidak dapat merayakannya pada waktunya, sebab para imam belum menguduskan diri dalam jumlah yang cukup dan rakyat belum terkumpul di Yerusalem."
 },
 {
   "id": 11834,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 4,
   "firman": "Rancangan itu diterima baik oleh raja dan seluruh jemaah."
 },
 {
   "id": 11835,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 5,
   "firman": "Mereka memutuskan untuk menyiarkan maklumat di seluruh Israel, dari Bersyeba sampai Dan, supaya masing-masing datang ke Yerusalem merayakan Paskah bagi TUHAN, Allah Israel, karena mereka belum merayakannya secara umum seperti yang ada tertulis."
 },
 {
   "id": 11836,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 6,
   "firman": "Maka berangkatlah pesuruh-pesuruh cepat ke seluruh Israel dan Yehuda membawa surat dari raja dan para pemimpin, dan mengatakan sesuai dengan perintah raja: \"Hai, orang Israel, kembalilah kepada TUHAN, Allah Abraham, Ishak dan Israel, maka Ia akan kembali kepada yang tertinggal dari pada kamu, yakni mereka yang terluput dari tangan raja-raja Asyur."
 },
 {
   "id": 11837,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 7,
   "firman": "Janganlah berlaku seperti nenek moyangmu dan saudara-saudaramu yang berubah setia terhadap TUHAN, Allah nenek moyang mereka, sehingga Ia membuat mereka menjadi kedahsyatan seperti yang kamu lihat sendiri."
 },
 {
   "id": 11838,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 8,
   "firman": "Sekarang, janganlah tegar tengkuk seperti nenek moyangmu. Serahkanlah dirimu kepada TUHAN dan datanglah ke tempat kudus yang telah dikuduskan-Nya untuk selama-lamanya, serta beribadahlah kepada TUHAN, Allahmu, supaya murka-Nya yang menyala-nyala undur dari padamu."
 },
 {
   "id": 11839,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 9,
   "firman": "Karena bilamana kamu kembali kepada TUHAN, maka saudara-saudaramu dan anak-anakmu akan mendapat belas kasihan dari orang-orang yang menawan mereka, sehingga mereka kembali ke negeri ini. Sebab TUHAN, Allahmu, pengasih dan penyayang: Ia tidak akan memalingkan wajah-Nya dari pada kamu, bilamana kamu kembali kepada-Nya!\""
 },
 {
   "id": 11840,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 10,
   "firman": "Ketika pesuruh-pesuruh cepat itu pergi dari kota ke kota, melintasi tanah Efraim dan Manasye sampai ke Zebulon, mereka ditertawakan dan diolok-olok."
 },
 {
   "id": 11841,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 11,
   "firman": "Namun beberapa orang dari Asyer, Manasye dan Zebulon merendahkan diri, dan datang ke Yerusalem."
 },
 {
   "id": 11842,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 12,
   "firman": "Di Yehuda nyata pula tangan Allah yang membulatkan hati mereka untuk melakukan perintah raja dan para pemimpin sesuai dengan firman TUHAN."
 },
 {
   "id": 11843,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 13,
   "firman": "Maka berkumpullah di Yerusalem banyak orang, suatu jemaah yang sangat besar, untuk merayakan hari raya Roti Tidak Beragi pada bulan yang kedua."
 },
 {
   "id": 11844,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 14,
   "firman": "Lalu bangunlah mereka menjauhkan mezbah-mezbah yang ada di Yerusalem; juga semua mezbah korban ukupan disingkirkan dan dibuang ke lembah Kidron."
 },
 {
   "id": 11845,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 15,
   "firman": "Kemudian disembelihlah domba Paskah pada tanggal empat belas bulan kedua. Maka para imam dan orang-orang Lewi merasa malu, lalu menguduskan dirinya dan membawa korban bakaran ke rumah TUHAN."
 },
 {
   "id": 11846,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 16,
   "firman": "Mereka berdiri pada tempatnya menurut peraturan yang berlaku bagi mereka masing-masing, sesuai dengan Taurat Musa, abdi Allah itu; para imam menyiramkan darah yang diterimanya dari orang-orang Lewi."
 },
 {
   "id": 11847,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 17,
   "firman": "Sebab ada banyak di antara jemaah yang tidak menguduskan dirinya, sehingga menjadi tugas orang Lewi untuk menyembelih domba-domba Paskah bagi setiap orang yang tidak dapat menguduskannya bagi TUHAN karena ia tidak tahir."
 },
 {
   "id": 11848,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 18,
   "firman": "Sebab sebagian besar dari rakyat--terutama dari Efraim, Manasye, Isakhar dan Zebulon--tidak mentahirkan diri. Namun mereka memakan Paskah, walaupun tidak sesuai dengan apa yang ada tertulis. Tetapi Hizkia berdoa untuk mereka, katanya: \"TUHAN, yang baik itu, kiranya mengadakan pendamaian bagi semua orang,"
 },
 {
   "id": 11849,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 19,
   "firman": "yang sungguh-sungguh berhasrat mencari Allah, yakni TUHAN, Allah nenek moyangnya, walaupun ketahiran mereka tidak sesuai dengan tempat kudus.\""
 },
 {
   "id": 11850,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 20,
   "firman": "TUHAN mendengar Hizkia dan membiarkan bangsa itu selamat."
 },
 {
   "id": 11851,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 21,
   "firman": "Tujuh hari lamanya orang Israel yang berada di Yerusalem merayakan hari raya Roti Tidak Beragi dengan kesukaan yang besar, sedang orang-orang Lewi dan para imam setiap hari menyanyikan puji-pujian bagi TUHAN dengan sekuat tenaga."
 },
 {
   "id": 11852,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 22,
   "firman": "Hizkia mengucapkan kata-kata pujian kepada semua orang Lewi yang menunjukkan akal budi yang baik dalam melayani TUHAN. Demikianlah orang memakan makanan perayaan selama tujuh hari, sambil mempersembahkan korban keselamatan dan mengucapkan syukur kepada TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11853,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 23,
   "firman": "Kemudian seluruh jemaah sepakat untuk berhari raya tujuh hari lagi. Lalu mereka berhari raya tujuh hari lagi dengan sukaria."
 },
 {
   "id": 11854,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 24,
   "firman": "Sebab Hizkia, raja Yehuda, telah menyumbangkan kepada jemaah seribu ekor lembu jantan dan tujuh ribu kambing domba. Juga para pemimpin menyumbangkan kepada jemaah seribu ekor lembu jantan dan sepuluh ribu ekor kambing domba. Dan sebagian besar para imam telah menguduskan diri."
 },
 {
   "id": 11855,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 25,
   "firman": "Seluruh jemaah Yehuda bersukaria, juga para imam dan orang-orang Lewi, dan seluruh jemaah yang datang dari Israel, serta orang-orang asing, baik yang datang dari tanah Israel, maupun yang tinggal di Yehuda."
 },
 {
   "id": 11856,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 26,
   "firman": "Maka besarlah kesukaan di Yerusalem, karena sejak Salomo bin Daud, raja Israel, tidak pernah terjadi peristiwa semacam itu di Yerusalem."
 },
 {
   "id": 11857,
   "kitab": "2Ta",
   "pasal": 30,
   "ayat": 27,
   "firman": "Sesudah itu para imam Lewi bangun berdiri dan memberkati rakyat. Suara mereka didengar TUHAN dan doa mereka sampai ke tempat kediaman-Nya yang kudus di sorga."
 },
 {
   "id": 11858,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 1,
   "firman": "Setelah semuanya ini diakhiri, seluruh orang Israel yang hadir pergi ke kota-kota di Yehuda, lalu meremukkan segala tugu berhala, menghancurkan segala tiang berhala, dan merobohkan segala bukit pengorbanan dan mezbah di seluruh Yehuda dan Benyamin, juga di Efraim dan Manasye, sampai musnah semuanya. Kemudian pulanglah seluruh orang Israel ke kota-kotanya, ke miliknya masing-masing."
 },
 {
   "id": 11859,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 2,
   "firman": "Hizkia menetapkan rombongan para imam dan orang-orang Lewi, rombongan demi rombongan, masing-masing menurut tugas jabatannya sebagai imam atau sebagai orang Lewi, untuk mempersembahkan korban bakaran dan korban keselamatan, untuk mengucap syukur dan menyanyikan puji-pujian dan untuk melayani di pintu-pintu gerbang di tempat perkemahan TUHAN."
 },
 {
   "id": 11860,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 3,
   "firman": "Raja memberi sumbangan dari harta miliknya untuk korban bakaran, yakni: korban bakaran pada waktu pagi dan pada waktu petang, korban bakaran pada hari-hari Sabat dan pada bulan-bulan baru dan pada hari-hari raya, yang semuanya tertulis di dalam Taurat TUHAN."
 },
 {
   "id": 11861,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 4,
   "firman": "Ia memerintahkan rakyat, yakni penduduk Yerusalem, untuk memberikan sumbangan yang menjadi bagian para imam dan orang-orang Lewi, supaya mereka dapat mencurahkan tenaganya untuk melaksanakan Taurat TUHAN."
 },
 {
   "id": 11862,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 5,
   "firman": "Segera setelah perintah ini tersiar, orang Israel membawa dalam jumlah yang besar hasil pertama dari pada gandum, anggur, minyak, madu dan segala macam hasil bumi. Mereka membawa juga persembahan persepuluhan dari segala sesuatu dalam jumlah yang besar."
 },
 {
   "id": 11863,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 6,
   "firman": "Orang Israel dan orang Yehuda yang tinggal di kota-kota Yehuda juga membawa persembahan persepuluhan yang terdiri dari lembu sapi dan kambing domba, dan persembahan persepuluhan yang terdiri dari persembahan kudus yang telah dikuduskan bagi TUHAN Allah mereka. Semuanya itu diletakkan mereka bertimbun-timbun."
 },
 {
   "id": 11864,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 7,
   "firman": "Mereka mulai membuat timbunan itu pada bulan yang ketiga, dan mereka selesai pada bulan yang ketujuh."
 },
 {
   "id": 11865,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 8,
   "firman": "Hizkia dan para pemimpin datang melihat timbunan itu, dan mereka memuji TUHAN dan umat-Nya, orang Israel."
 },
 {
   "id": 11866,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 9,
   "firman": "Hizkia menanyakan para imam dan orang-orang Lewi tentang timbunan itu,"
 },
 {
   "id": 11867,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 10,
   "firman": "dan dijawab oleh Azarya, imam kepala keturunan Zadok demikian: \"Sejak persembahan khusus mulai dibawa ke rumah TUHAN, kami telah makan sekenyang-kenyangnya, namun sisanya masih banyak. Sebab TUHAN telah memberkati umat-Nya, sehingga tinggal sisa yang banyak ini.\""
 },
 {
   "id": 11868,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 11,
   "firman": "Kemudian Hizkia menyuruh menyediakan bilik-bilik di rumah TUHAN dan mereka menyediakannya."
 },
 {
   "id": 11869,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 12,
   "firman": "Dan dengan setia mereka membawa segala persembahan khusus, persembahan persepuluhan dan persembahan-persembahan kudus itu ke sana. Konanya, seorang Lewi, mengawasi semuanya, dan Simei, saudaranya, adalah orang kedua,"
 },
 {
   "id": 11870,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 13,
   "firman": "sedang Yehiel, Azazya, Nahat, Asael, Yerimot, Yozabad, Eliel, Yismakhya, Mahat dan Benanya adalah penilik di bawah Konanya dan Simei, saudaranya itu, sesuai dengan petunjuk raja Hizkia dan Azarya, kepala rumah Allah."
 },
 {
   "id": 11871,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 14,
   "firman": "Dan Kore bin Yimna, seorang Lewi, penunggu pintu gerbang di sebelah timur, mengawasi pemberian-pemberian sukarela untuk Allah, serta membagi-bagikan persembahan khusus yang untuk TUHAN dan persembahan-persembahan maha kudus."
 },
 {
   "id": 11872,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 15,
   "firman": "Di kota-kota imam ia dibantu dengan setia oleh Eden, Minyamin, Yesua, Semaya, Amarya dan Sekhanya dalam pembagian itu kepada saudara-saudara mereka menurut rombongan, kepada orang dewasa dan anak-anak,"
 },
 {
   "id": 11873,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 16,
   "firman": "kecuali kepada setiap orang yang masuk ke rumah TUHAN, menurut hari-hari yang ditetapkan, menurut tugas jabatan yang ditugaskan kepadanya, dan menurut rombongannya, yakni mereka yang tercatat dalam daftar sebagai laki-laki yang berumur tiga tahun ke atas."
 },
 {
   "id": 11874,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 17,
   "firman": "Para imam dicatat dalam daftar menurut puak-puak mereka, sedang orang-orang Lewi yang berumur dua puluh tahun ke atas dicatat menurut tugas dan rombongan mereka."
 },
 {
   "id": 11875,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 18,
   "firman": "Para imam terdaftar dengan seluruh keluarga mereka, yakni isteri, anak laki-laki dan perempuan, seluruh kaum itu, karena dengan setia mereka menguduskan diri untuk persembahan kudus."
 },
 {
   "id": 11876,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 19,
   "firman": "Bagi keturunan Harun, yakni imam-imam, yang tinggal di padang-padang penggembalaan sekitar kota-kota mereka, di setiap kota ada orang-orang yang ditunjuk dengan disebut namanya, untuk mengadakan pembagian kepada setiap orang laki-laki dari keluarga imam dan kepada setiap orang Lewi yang terdaftar."
 },
 {
   "id": 11877,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 20,
   "firman": "Demikianlah perbuatan Hizkia di seluruh Yehuda. Ia melakukan apa yang baik, apa yang jujur, dan apa yang benar di hadapan TUHAN, Allahnya."
 },
 {
   "id": 11878,
   "kitab": "2Ta",
   "pasal": 31,
   "ayat": 21,
   "firman": "Dalam setiap usaha yang dimulainya untuk pelayanannya terhadap rumah Allah, dan untuk pelaksanaan Taurat dan perintah Allah, ia mencari Allahnya. Semuanya dilakukannya dengan segenap hati, sehingga segala usahanya berhasil."
 },
 {
   "id": 11879,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 1,
   "firman": "Setelah peristiwa yang menunjukkan kesetiaan Hizkia itu datanglah Sanherib, raja Asyur, menyerbu Yehuda. Ia mengepung kota-kota berkubu, dan berniat merebutnya."
 },
 {
   "id": 11880,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 2,
   "firman": "Ketika Hizkia mengetahui, bahwa Sanherib datang hendak memerangi Yerusalem,"
 },
 {
   "id": 11881,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 3,
   "firman": "ia berunding dengan para panglima dan pahlawannya untuk menutup segala mata air yang terdapat di luar kota dan mereka itu bersedia membantunya."
 },
 {
   "id": 11882,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 4,
   "firman": "Maka berkumpullah banyak orang. Mereka menutup semua mata air dan sungai yang mengalir dari tengah-tengah negeri itu. Kata mereka: \"Mengapa raja-raja Asyur harus mendapat banyak air, kalau mereka datang?\""
 },
 {
   "id": 11883,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 5,
   "firman": "Dengan sekuat tenaga Hizkia membangun kembali seluruh tembok yang telah terbongkar, mendirikan menara-menara di atasnya dan tembok yang lain di luarnya. Ia memperkuat juga Milo di kota Daud dan membuat lembing dan perisai dalam jumlah yang besar."
 },
 {
   "id": 11884,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 6,
   "firman": "Ia mengangkat panglima-panglima perang yang mengepalai rakyat, menyuruh mereka berkumpul kepadanya di halaman pintu gerbang kota dan menenangkan hati mereka dengan kata-kata:"
 },
 {
   "id": 11885,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 7,
   "firman": "\"Kuatkanlah dan teguhkanlah hatimu! Janganlah takut dan terkejut terhadap raja Asyur serta seluruh laskar yang menyertainya, karena yang menyertai kita lebih banyak dari pada yang menyertai dia."
 },
 {
   "id": 11886,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 8,
   "firman": "Yang menyertai dia adalah tangan manusia, tetapi yang menyertai kita adalah TUHAN, Allah kita, yang membantu kita dan melakukan peperangan kita.\" Oleh kata-kata Hizkia, raja Yehuda itu, rakyat mendapat kepercayaannya kembali."
 },
 {
   "id": 11887,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 9,
   "firman": "Sesudah itu Sanherib, raja Asyur, yang sedang mengepung Lakhis dengan seluruh kekuatan tentaranya, mengutus beberapa pegawai ke Yerusalem, kepada Hizkia, raja Yehuda, dan kepada semua orang Yehuda yang ada di Yerusalem, dengan pesan:"
 },
 {
   "id": 11888,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 10,
   "firman": "\"Beginilah titah Sanherib, raja Asyur: Apakah yang kamu harapkan, maka kamu tinggal saja di Yerusalem yang terkepung ini?"
 },
 {
   "id": 11889,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 11,
   "firman": "Bukankah Hizkia memperdayakan kamu, supaya kamu mati kelaparan dan kehausan, dengan mengatakan: TUHAN, Allah kita, akan melepaskan kita dari tangan raja Asyur?"
 },
 {
   "id": 11890,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 12,
   "firman": "Bukankah Hizkia ini yang menjauhkan segala bukit pengorbanan dan mezbah TUHAN itu, dan berkata kepada Yehuda dan Yerusalem: Hanya di depan satu mezbah kamu harus sujud menyembah dan membakar korban di atasnya?"
 },
 {
   "id": 11891,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 13,
   "firman": "Tidakkah kamu ketahui apa yang aku dan nenek moyangku lakukan terhadap semua bangsa negeri-negeri lain? Apakah para allah bangsa-bangsa segala negeri itu pernah berhasil melepaskan negeri mereka dari tanganku?"
 },
 {
   "id": 11892,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 14,
   "firman": "Siapa dari pada semua allah bangsa-bangsa yang sudah ditumpas nenek moyangku itu dapat melepaskan bangsanya dari tanganku? Masakan Allahmu dapat melepaskan kamu dari tanganku?"
 },
 {
   "id": 11893,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 15,
   "firman": "Sekarang, janganlah Hizkia memperdayakan dan membujuk kamu seperti ini! Janganlah percaya kepadanya, karena tidak ada allah dari bangsa atau kerajaan manapun yang dapat melepaskan bangsanya dari tanganku dan dari tangan nenek moyangku, lebih-lebih lagi Allahmu itu takkan dapat melepaskan kamu dari tanganku!\""
 },
 {
   "id": 11894,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 16,
   "firman": "Dan masih banyak lagi yang diucapkan pegawai-pegawai Sanherib itu menentang TUHAN Allah dan menentang Hizkia, hamba-Nya."
 },
 {
   "id": 11895,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 17,
   "firman": "Ia menulis juga surat yang penuh cela dan hujat terhadap TUHAN, Allah Israel, bunyinya: \"Sebagaimana para allah bangsa-bangsa segala negeri lain tidak dapat melepaskan bangsanya dari tanganku, demikian pula Allah Hizkia takkan dapat melepaskan bangsa-Nya dari tanganku.\""
 },
 {
   "id": 11896,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 18,
   "firman": "Dan mereka berseru dengan suara nyaring dalam bahasa Yehuda kepada rakyat Yerusalem yang ada di atas tembok, untuk menakutkan dan mengejutkan mereka, supaya mereka dapat merebut kota itu."
 },
 {
   "id": 11897,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 19,
   "firman": "Mereka berbicara tentang Allah Yerusalem seperti tentang para allah bangsa-bangsa di dunia, adalah buatan tangan manusia."
 },
 {
   "id": 11898,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 20,
   "firman": "Tetapi oleh karena itu raja Hizkia dan nabi Yesaya bin Amos berdoa dan berseru kepada sorga."
 },
 {
   "id": 11899,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 21,
   "firman": "Lalu TUHAN mengirim malaikat yang melenyapkan semua pahlawan yang gagah perkasa, pemuka dan panglima yang ada di perkemahan raja Asyur, sehingga ia kemalu-maluan kembali ke negerinya. Kemudian ia ditewaskan dengan pedang oleh anak-anak kandungnya sendiri ketika ia memasuki rumah allahnya."
 },
 {
   "id": 11900,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 22,
   "firman": "Demikianlah TUHAN menyelamatkan Hizkia dan penduduk Yerusalem dari tangan Sanherib, raja Asyur, dan dari tangan semua musuhnya. Dan Ia mengaruniakan keamanan kepada mereka di segala penjuru."
 },
 {
   "id": 11901,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 23,
   "firman": "Banyak orang membawa persembahan ke Yerusalem untuk TUHAN dan barang-barang berharga untuk Hizkia, raja Yehuda itu. Sejak itu ia diagungkan oleh semua bangsa."
 },
 {
   "id": 11902,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 24,
   "firman": "Pada hari-hari itu Hizkia jatuh sakit, sehingga hampir mati. Ia berdoa kepada TUHAN, dan TUHAN berfirman kepadanya dan memberikannya suatu tanda ajaib."
 },
 {
   "id": 11903,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 25,
   "firman": "Tetapi Hizkia tidak berterima kasih atas kebaikan yang ditunjukkan kepadanya, karena ia menjadi angkuh, sehingga ia dan Yehuda dan Yerusalem ditimpa murka."
 },
 {
   "id": 11904,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 26,
   "firman": "Tetapi ia sadar akan keangkuhannya itu dan merendahkan diri bersama-sama dengan penduduk Yerusalem, sehingga murka TUHAN tidak menimpa mereka pada zaman Hizkia."
 },
 {
   "id": 11905,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 27,
   "firman": "Hizkia mendapat kekayaan dan kemuliaan yang sangat besar. Ia membuat perbendaharaan-perbendaharaan untuk emas, perak, batu permata yang mahal-mahal, rempah-rempah, perisai-perisai dan segala macam barang yang indah-indah,"
 },
 {
   "id": 11906,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 28,
   "firman": "juga tempat perbekalan untuk hasil gandum, untuk anggur dan minyak, dan kandang-kandang untuk berbagai jenis hewan besar dan kandang-kandang untuk kawanan kambing domba."
 },
 {
   "id": 11907,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 29,
   "firman": "Ia mendirikan kota-kota, memperoleh banyak kambing domba dan lembu sapi, karena Allah mengaruniakan dia harta milik yang amat besar."
 },
 {
   "id": 11908,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 30,
   "firman": "Hizkia ini juga telah membendung aliran Gihon di sebelah hulu, dan menyalurkannya ke hilir, ke sebelah barat, ke kota Daud. Hizkia berhasil dalam segala usahanya."
 },
 {
   "id": 11909,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 31,
   "firman": "Demikianlah juga ketika utusan-utusan raja-raja Babel datang kepadanya untuk menanyakan tentang tanda ajaib yang telah terjadi di negeri, ketika itu Allah meninggalkan dia untuk mencobainya, supaya diketahui segala isi hatinya."
 },
 {
   "id": 11910,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 32,
   "firman": "Selebihnya dari riwayat Hizkia dan perbuatan-perbuatannya yang setia, sesungguhnya semuanya itu tertulis dalam penglihatan nabi Yesaya bin Amos, dalam kitab raja-raja Yehuda dan Israel."
 },
 {
   "id": 11911,
   "kitab": "2Ta",
   "pasal": 32,
   "ayat": 33,
   "firman": "Kemudian Hizkia mendapat perhentian bersama-sama dengan nenek moyangnya, dan dikuburkan di pendakian ke pekuburan anak-anak Daud. Pada waktu kematiannya seluruh Yehuda dan penduduk Yerusalem memberi penghormatan kepadanya. Maka Manasye, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11912,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 1,
   "firman": "Manasye berumur dua belas tahun pada waktu ia menjadi raja dan lima puluh lima tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11913,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, sesuai dengan perbuatan keji bangsa-bangsa yang telah dihalaukan TUHAN dari depan orang Israel."
 },
 {
   "id": 11914,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 3,
   "firman": "Ia mendirikan kembali bukit-bukit pengorbanan yang telah dirobohkan oleh Hizkia, ayahnya; ia membangun mezbah-mezbah untuk para Baal, membuat patung-patung Asyera dan sujud menyembah kepada segenap tentara langit dan beribadah kepadanya."
 },
 {
   "id": 11915,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 4,
   "firman": "Ia mendirikan mezbah-mezbah di rumah TUHAN, walaupun sehubungan dengan rumah itu TUHAN telah berfirman: \"Di Yerusalem nama-Ku akan tinggal untuk selama-lamanya!\""
 },
 {
   "id": 11916,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 5,
   "firman": "Dan ia mendirikan juga mezbah-mezbah bagi segenap tentara langit di kedua pelataran rumah TUHAN."
 },
 {
   "id": 11917,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 6,
   "firman": "Bahkan, ia mempersembahkan anak-anaknya sebagai korban dalam api di Lebak Ben-Hinom; ia melakukan ramal, telaah dan sihir, dan menghubungi para pemanggil arwah dan para pemanggil roh peramal. Ia melakukan banyak yang jahat di mata TUHAN, sehingga ia menimbulkan sakit hati-Nya."
 },
 {
   "id": 11918,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 7,
   "firman": "Ia menaruh juga patung berhala yang telah dibuatnya dalam rumah Allah, walaupun Allah telah berfirman kepada Daud dan kepada Salomo, anaknya: \"Dalam rumah ini dan di Yerusalem, yang telah Kupilih dari antara segala suku Israel, Aku akan menaruh nama-Ku untuk selama-lamanya!"
 },
 {
   "id": 11919,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 8,
   "firman": "Aku tidak akan membuat pula orang Israel berjejak ke luar dari tanah yang telah Kutentukan untuk nenek moyangmu, asal saja mereka melakukan dengan setia segala yang telah Kuperintahkan kepada mereka dengan perantaraan Musa, yakni segala hukum, ketetapan dan peraturan.\""
 },
 {
   "id": 11920,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 9,
   "firman": "Tetapi Manasye menyesatkan Yehuda dan penduduk Yerusalem, sehingga mereka melakukan yang jahat lebih dari pada bangsa-bangsa yang telah dipunahkan TUHAN dari depan orang Israel."
 },
 {
   "id": 11921,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 10,
   "firman": "Kemudian berfirmanlah TUHAN kepada Manasye dan rakyatnya, tetapi mereka tidak menghiraukannya."
 },
 {
   "id": 11922,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 11,
   "firman": "Oleh sebab itu TUHAN mendatangkan kepada mereka panglima-panglima tentara raja Asyur yang menangkap Manasye dengan kaitan, membelenggunya dengan rantai tembaga dan membawanya ke Babel."
 },
 {
   "id": 11923,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 12,
   "firman": "Dalam keadaan yang terdesak ini, ia berusaha melunakkan hati TUHAN, Allahnya; ia sangat merendahkan diri di hadapan Allah nenek moyangnya,"
 },
 {
   "id": 11924,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 13,
   "firman": "dan berdoa kepada-Nya. Maka TUHAN mengabulkan doanya, dan mendengarkan permohonannya. Ia membawanya kembali ke Yerusalem dan memulihkan kedudukannya sebagai raja. Dan Manasye mengakui, bahwa TUHAN itu Allah."
 },
 {
   "id": 11925,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 14,
   "firman": "Kemudian ia mendirikan tembok luar pada kota Daud, di sebelah Barat Gihon, di lembah, sampai dekat Pintu Gerbang Ikan, mengelilingi Ofel. Tembok itu dibuatnya sangat tinggi. Ia menempatkan juga panglima-panglima perang di tiap kota kubu di Yehuda."
 },
 {
   "id": 11926,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 15,
   "firman": "Ia menjauhkan allah-allah asing dan berhala dari rumah TUHAN, juga segala mezbah yang didirikannya di atas gunung rumah TUHAN dan di Yerusalem, dan membuangnya ke luar kota."
 },
 {
   "id": 11927,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 16,
   "firman": "Ia menegakkan kembali mezbah TUHAN, mempersembahkan korban keselamatan dan korban syukur di atasnya, menyerukan kepada Yehuda untuk beribadah kepada TUHAN, Allah Israel."
 },
 {
   "id": 11928,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 17,
   "firman": "Walaupun demikian, rakyat masih mempersembahkan korban di bukit-bukit pengorbanan, tetapi hanya kepada TUHAN, Allah mereka."
 },
 {
   "id": 11929,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 18,
   "firman": "Selebihnya dari riwayat Manasye, doanya kepada Allahnya, dan ucapan-ucapan para pelihat yang berkata-kata kepadanya dengan nama TUHAN, Allah Israel, sesungguhnya semuanya itu terdapat dalam riwayat raja-raja Israel."
 },
 {
   "id": 11930,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 19,
   "firman": "Doanya dan pengabulan doanya, segala dosa dan ketidaksetiaannya, semua tempat di mana ia telah membangun bukit-bukit pengorbanan serta mendirikan tiang-tiang berhala dan patung-patung sebelum ia merendahkan diri, sesungguhnya semuanya itu tertulis dalam riwayat para pelihat."
 },
 {
   "id": 11931,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 20,
   "firman": "Kemudian Manasye mendapat perhentian bersama-sama dengan nenek moyangnya, dan ia dikuburkan di dalam istananya. Maka Amon, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11932,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 21,
   "firman": "Amon berumur dua puluh dua tahun pada waktu ia menjadi raja dan dua tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11933,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 22,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN seperti yang telah dilakukan Manasye, ayahnya. Amon mempersembahkan korban kepada segala patung yang dibuat Manasye, ayahnya, dan beribadah kepada patung-patung itu."
 },
 {
   "id": 11934,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 23,
   "firman": "Tetapi ia tidak merendahkan diri di hadapan TUHAN seperti Manasye, ayahnya, merendahkan diri, malah Amon makin banyak kesalahannya."
 },
 {
   "id": 11935,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 24,
   "firman": "Maka pegawai-pegawainya mengadakan persepakatan melawan dia, dan membunuhnya di istananya."
 },
 {
   "id": 11936,
   "kitab": "2Ta",
   "pasal": 33,
   "ayat": 25,
   "firman": "Tetapi rakyat negeri itu membunuh semua orang yang mengadakan persepakatan melawan raja Amon; dan rakyat negeri itu mengangkat Yosia, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 11937,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 1,
   "firman": "Yosia berumur delapan tahun pada waktu ia menjadi raja dan tiga puluh satu tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11938,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 2,
   "firman": "Ia melakukan apa yang benar di mata TUHAN dan hidup seperti Daud, bapa leluhurnya, dan tidak menyimpang ke kanan atau ke kiri."
 },
 {
   "id": 11939,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 3,
   "firman": "Pada tahun kedelapan dari pemerintahannya, ketika ia masih muda belia, ia mulai mencari Allah Daud, bapa leluhurnya, dan pada tahun kedua belas ia mulai mentahirkan Yehuda dan Yerusalem dari pada bukit-bukit pengorbanan, tiang-tiang berhala, patung-patung pahatan dan patung-patung tuangan."
 },
 {
   "id": 11940,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 4,
   "firman": "Mezbah-mezbah para Baal dirobohkan di hadapannya; ia menghancurkan pedupaan-pedupaan yang ada di atasnya; ia meremukkan dan menghancurluluhkan tiang-tiang berhala, patung-patung pahatan dan patung-patung tuangan, dan menghamburkannya ke atas kuburan orang-orang yang mempersembahkan korban kepada berhala-berhala itu."
 },
 {
   "id": 11941,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 5,
   "firman": "Tulang-tulang para imam dibakarnya di atas mezbah-mezbah mereka. Demikianlah ia mentahirkan Yehuda dan Yerusalem."
 },
 {
   "id": 11942,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 6,
   "firman": "Juga di kota-kota Manasye, Efraim dan Simeon, sampai di kota-kota Naftali, yang di mana-mana telah menjadi reruntuhan,"
 },
 {
   "id": 11943,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 7,
   "firman": "ia merobohkan segala mezbah dan tiang berhala, meremukkan segala patung pahatan serta menghancurluluhkannya, dan menghancurkan semua pedupaan di seluruh tanah Israel. Sesudah itu ia kembali ke Yerusalem."
 },
 {
   "id": 11944,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 8,
   "firman": "Pada tahun kedelapan belas dari pemerintahannya, setelah selesai mentahirkan negeri dan rumah TUHAN, ia menyuruh Safan bin Azalya, dan Maaseya, penguasa kota, serta Yoah bin Yoahas, bendahara negara, untuk memperbaiki rumah TUHAN, Allahnya."
 },
 {
   "id": 11945,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 9,
   "firman": "Maka datanglah mereka kepada imam besar Hilkia dan menyerahkan kepadanya uang yang telah dibawa ke rumah Allah dan yang telah dikumpulkan oleh orang-orang Lewi, yakni oleh para penjaga pintu, dari orang-orang Manasye dan Efraim, dan dari semua orang yang masih tinggal dari Israel, pula dari seluruh orang Yehuda dan Benyamin, dan dari penduduk Yerusalem."
 },
 {
   "id": 11946,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 10,
   "firman": "Uang itu diberikan mereka ke tangan para pekerja yang diangkat untuk mengawasi rumah TUHAN; dan mereka itu, yang bekerja dalam rumah TUHAN, mengeluarkannya untuk membetulkan dan memperbaiki rumah itu."
 },
 {
   "id": 11947,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 11,
   "firman": "Mereka memberikannya kepada tukang-tukang kayu dan tukang-tukang bangunan, supaya tukang-tukang itu membeli batu pahat dan kayu untuk tupai-tupai dan untuk memasang balok-balok pada gedung-gedung, yang oleh raja-raja Yehuda dibiarkan roboh."
 },
 {
   "id": 11948,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 12,
   "firman": "Orang-orang itu melakukan pekerjaan itu dengan setia. Orang-orang yang diangkat menjadi pengawas mereka ialah: Yahat dan Obaja, orang-orang Lewi dari bani Merari, sedangkan Zakharia dan Mesulam dari bani Kehat mengepalai semua. Dan semua orang Lewi yang pandai memainkan alat-alat musik,"
 },
 {
   "id": 11949,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 13,
   "firman": "mengepalai kuli-kuli dan mengiringi semua tukang dalam pekerjaan apapun. Dari antara orang-orang Lewi itu ada yang menjadi panitera, pengatur atau penunggu pintu gerbang."
 },
 {
   "id": 11950,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 14,
   "firman": "Ketika mereka mengeluarkan uang yang telah dibawa ke rumah TUHAN, imam Hilkia menemukan kitab Taurat TUHAN, yang diberikan dengan perantaraan Musa."
 },
 {
   "id": 11951,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 15,
   "firman": "Maka berkatalah Hilkia kepada Safan, panitera negara itu: \"Aku telah menemukan kitab Taurat di rumah TUHAN!\" Lalu Hilkia memberikan kitab itu kepada Safan,"
 },
 {
   "id": 11952,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 16,
   "firman": "dan Safan membawa kitab itu kepada raja. Ia juga menyampaikan kabar kepada raja: \"Segala sesuatu yang ditugaskan kepada hamba-hambamu, telah mereka laksanakan."
 },
 {
   "id": 11953,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 17,
   "firman": "Mereka telah mengambil seluruh uang yang terdapat di rumah TUHAN dan memberikannya ke tangan para pengawas dan para pekerja.\""
 },
 {
   "id": 11954,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 18,
   "firman": "Safan, panitera negara itu, memberitahukan juga kepada raja: \"Imam Hilkia telah memberikan kitab kepadaku,\" lalu Safan membacakan sebagian di depan raja."
 },
 {
   "id": 11955,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 19,
   "firman": "Segera sesudah raja mendengar perkataan Taurat itu, dikoyakkannyalah pakaiannya."
 },
 {
   "id": 11956,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 20,
   "firman": "Kemudian raja memberi perintah kepada Hilkia, kepada Ahikam bin Safan, kepada Abdon bin Mikha, kepada Safan, panitera negara itu, dan kepada Asaya, hamba raja, katanya:"
 },
 {
   "id": 11957,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 21,
   "firman": "\"Pergilah, mintalah petunjuk TUHAN bagiku, bagi yang masih tinggal di Israel dan di Yehuda tentang perkataan kitab yang ditemukan ini, sebab hebat kehangatan murka TUHAN yang dicurahkan kepada kita, oleh karena nenek moyang kita tidak memelihara firman TUHAN dengan berbuat tepat seperti yang tertulis dalam kitab ini!\""
 },
 {
   "id": 11958,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 22,
   "firman": "Maka pergilah Hilkia dengan orang-orang yang disuruh raja kepada nabiah Hulda, isteri seorang yang mengurus pakaian-pakaian, yaitu Salum bin Tokhat bin Hasra, penunggu pakaian-pakaian; nabiah itu tinggal di Yerusalem, di perkampungan baru. Mereka berbicara kepadanya sebagaimana yang diperintahkan."
 },
 {
   "id": 11959,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 23,
   "firman": "Perempuan itu menjawab mereka: \"Beginilah firman TUHAN, Allah Israel! Katakanlah kepada orang yang menyuruh kamu kepada-Ku!"
 },
 {
   "id": 11960,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 24,
   "firman": "Beginilah firman TUHAN: Sesungguhnya Aku akan mendatangkan malapetaka atas tempat ini dan atas penduduknya, yakni segala kutuk yang tertulis dalam kitab yang telah dibacakan di depan raja Yehuda,"
 },
 {
   "id": 11961,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 25,
   "firman": "karena mereka meninggalkan Aku dan membakar korban kepada allah lain dengan maksud menimbulkan sakit hati-Ku dengan segala pekerjaan tangan mereka; sebab itu nyala murka-Ku akan dicurahkan ke tempat ini dengan tidak padam-padam."
 },
 {
   "id": 11962,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 26,
   "firman": "Tetapi kepada raja Yehuda yang telah menyuruh kamu untuk meminta petunjuk TUHAN, harus kamu katakan demikian: Beginilah firman TUHAN, Allah Israel: Mengenai perkataan yang telah kaudengar itu,"
 },
 {
   "id": 11963,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 27,
   "firman": "oleh karena engkau sudah menyesal dan engkau merendahkan diri di hadapan Allah pada waktu engkau mendengar firman-Nya terhadap tempat ini dan terhadap penduduknya, oleh karena engkau merendahkan diri di hadapan-Ku, mengoyakkan pakaianmu dan menangis di hadapan-Ku, Akupun telah mendengarnya, demikianlah firman TUHAN,"
 },
 {
   "id": 11964,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 28,
   "firman": "maka sesungguhnya Aku akan mengumpulkan engkau kepada nenek moyangmu, dan engkau akan dikebumikan ke dalam kuburmu dengan damai, dan matamu tidak akan melihat segala malapetaka yang akan Kudatangkan atas tempat ini dan atas penduduknya.\" Lalu mereka menyampaikan jawab itu kepada raja."
 },
 {
   "id": 11965,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 29,
   "firman": "Sesudah itu raja menyuruh orang mengumpulkan semua tua-tua Yehuda dan Yerusalem."
 },
 {
   "id": 11966,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 30,
   "firman": "Kemudian pergilah raja ke rumah TUHAN bersama-sama semua orang Yehuda dan penduduk Yerusalem, para imam, orang-orang Lewi, dan seluruh orang awam, baik yang besar maupun yang masih kecil. Dengan didengar mereka ia membacakan segala perkataan dari kitab perjanjian yang ditemukan di rumah TUHAN itu."
 },
 {
   "id": 11967,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 31,
   "firman": "Sesudah itu berdirilah raja pada tempatnya dan diikatnyalah perjanjian di hadapan TUHAN untuk hidup dengan mengikuti TUHAN, dan tetap menuruti perintah-perintah-Nya, peraturan-peraturan-Nya dan ketetapan-ketetapan-Nya dengan segenap hatinya dan dengan segenap jiwanya dan untuk melakukan perkataan perjanjian yang tertulis dalam kitab itu."
 },
 {
   "id": 11968,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 32,
   "firman": "Ia menyuruh semua orang yang berada di Yerusalem dan Benyamin ikut serta dalam perjanjian itu. Dan penduduk Yerusalem berbuat menurut perjanjian Allah, yakni Allah nenek moyang mereka."
 },
 {
   "id": 11969,
   "kitab": "2Ta",
   "pasal": 34,
   "ayat": 33,
   "firman": "Yosia menjauhkan segala dewa kekejian dari semua daerah orang Israel dan menyuruh semua orang yang ada di Israel beribadah kepada TUHAN, Allah mereka. Maka sepanjang hidup Yosia mereka tidak menyimpang mengikuti TUHAN, Allah nenek moyang mereka."
 },
 {
   "id": 11970,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 1,
   "firman": "Kemudian Yosia merayakan Paskah bagi TUHAN di Yerusalem. Domba Paskah disembelih pada tanggal empat belas bulan yang pertama."
 },
 {
   "id": 11971,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 2,
   "firman": "Ia menetapkan tugas para imam, dan mendorong mereka menunaikan tugas jabatannya dalam rumah TUHAN."
 },
 {
   "id": 11972,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 3,
   "firman": "Berkatalah ia kepada orang-orang Lewi yang adalah pengajar seluruh Israel dan orang-orang kudus TUHAN: \"Tempatkanlah tabut kudus itu di dalam rumah yang telah didirikan Salomo bin Daud, raja Israel. Tidak usah lagi kamu mengusungnya. Sekarang layanilah TUHAN, Allahmu, dan Israel, umat-Nya!"
 },
 {
   "id": 11973,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 4,
   "firman": "Bersiaplah menurut puak-puakmu dan menurut rombonganmu sebagaimana yang dituliskan Daud, raja Israel, dan Salomo, anaknya."
 },
 {
   "id": 11974,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 5,
   "firman": "Berdirilah di halaman tempat kudus menurut golongan puak saudara-saudaramu yang lain, yakni kaum awam, dengan satu rombongan puak orang Lewi untuk tiap golongan saudara-saudaramu itu."
 },
 {
   "id": 11975,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 6,
   "firman": "Sembelihlah domba Paskah, kuduskanlah dirimu, dan adakanlah persiapan bagi saudara-saudaramu, supaya dilakukan apa yang difirmankan TUHAN dengan perantaraan Musa.\""
 },
 {
   "id": 11976,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 7,
   "firman": "Yosia menyumbangkan kepada kaum awam sejumlah tiga puluh ribu ekor kambing domba, yakni domba-domba dan kambing-kambing jantan yang muda, semuanya sebagai korban Paskah bagi semua orang yang hadir. Selain itu disumbangkannya tiga ribu ekor lembu. Semuanya itu dari harta milik raja."
 },
 {
   "id": 11977,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 8,
   "firman": "Juga para panglimanya memberi sumbangan sukarela kepada rakyat, para imam, dan orang-orang Lewi. Kemudian Hilkia, Zakharia dan Yehiel, para pemuka rumah Allah, memberi kepada para imam dua ribu enam ratus ekor kambing domba sebagai korban Paskah dan selain itu tiga ratus ekor lembu."
 },
 {
   "id": 11978,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 9,
   "firman": "Lalu Konanya dan kedua saudaranya, Semaya dan Netaneel, serta Hasabya, Yeiel dan Yozabad, para pemimpin orang-orang Lewi, menyumbangkan kepada orang-orang Lewi lima ribu ekor kambing domba sebagai korban Paskah dan selain itu lima ratus ekor lembu."
 },
 {
   "id": 11979,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 10,
   "firman": "Setelah upacara ibadah disiapkan, berdirilah para imam pada tempatnya dan orang-orang Lewi menurut rombongannya sesuai dengan perintah raja."
 },
 {
   "id": 11980,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 11,
   "firman": "Maka disembelihlah domba Paskah, dan para imam menyiramkan darah yang mereka terima dari orang-orang Lewi, sedang orang-orang Lewi menguliti domba itu."
 },
 {
   "id": 11981,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 12,
   "firman": "Tetapi mereka memisahkan korban bakaran untuk diserahkan kepada kaum awam menurut golongan puak mereka, supaya dipersembahkan kepada TUHAN sebagaimana tertulis dalam kitab Musa. Demikian pula dilakukan mereka dengan lembu-lembu."
 },
 {
   "id": 11982,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 13,
   "firman": "Kemudian mereka memasak domba Paskah di atas api sesuai dengan peraturan, sedang persembahan-persembahan kudus mereka masak dalam kuali, belanga dan pinggan, lalu membawanya cepat-cepat kepada segenap kaum awam."
 },
 {
   "id": 11983,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 14,
   "firman": "Kemudian mereka menyediakannya bagi dirinya dan bagi para imam, karena para imam, yakni anak-anak Harun, sampai malam hari sibuk mempersembahkan korban bakaran dan segala lemak. Oleh sebab itu orang-orang Lewi menyediakannya bagi dirinya dan bagi para imam, yakni anak-anak Harun."
 },
 {
   "id": 11984,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 15,
   "firman": "Para penyanyi, yakni bani Asaf, ada pada tempat mereka sesuai dengan perintah Daud, Asaf, Heman dan Yedutun, pelihat raja itu; juga para penunggu pintu gerbang ada pada tiap-tiap pintu gerbang. Mereka tidak usah meninggalkan tugas mereka, karena saudara-saudara mereka, orang-orang Lewi, menyediakannya untuk mereka."
 },
 {
   "id": 11985,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 16,
   "firman": "Demikianlah seluruh upacara ibadah bagi TUHAN disiapkan pada hari itu untuk merayakan Paskah dan untuk mempersembahkan korban bakaran di atas mezbah TUHAN sesuai dengan perintah raja Yosia."
 },
 {
   "id": 11986,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 17,
   "firman": "Pada waktu itu orang Israel yang hadir di situ merayakan Paskah dan hari raya Roti Tidak Beragi selama tujuh hari."
 },
 {
   "id": 11987,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 18,
   "firman": "Paskah semacam itu tidak pernah lagi dirayakan di Israel sejak nabi Samuel. Seorangpun di antara raja-raja orang Israel tidak pernah merayakan Paskah seperti yang dirayakan Yosia dengan para imam dan orang-orang Lewi, dengan seluruh orang Yehuda dan Israel yang dapat hadir, dan dengan penduduk Yerusalem."
 },
 {
   "id": 11988,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 19,
   "firman": "Paskah itu dirayakan pada tahun kedelapan belas pemerintahan Yosia."
 },
 {
   "id": 11989,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 20,
   "firman": "Kemudian dari pada semua ini, setelah Yosia memperbaiki rumah TUHAN, majulah Nekho, raja Mesir, hendak berperang di Karkemis di tepi sungai Efrat. Yosia keluar menghadapinya."
 },
 {
   "id": 11990,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 21,
   "firman": "Ia mengirim utusan kepada Yosia, dengan pesan: \"Apakah urusanmu dengan aku, raja Yehuda? Saat ini aku tidak datang melawan engkau, tetapi melawan keluarga raja yang sedang kuperangi. Allah memerintahkan aku supaya segera bertindak. Hentikanlah niatmu menentang Allah yang menyertai aku, supaya engkau jangan dimusnahkan-Nya!\""
 },
 {
   "id": 11991,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 22,
   "firman": "Tetapi Yosia tidak berpaling dari padanya, melainkan menyamar untuk berperang melawan dia. Ia tidak mengindahkan kata-kata Nekho, yang merupakan pesan Allah, lalu berperang di lembah Megido."
 },
 {
   "id": 11992,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 23,
   "firman": "Maka pemanah-pemanah menembaki raja Yosia, dan raja berseru kepada orang-orangnya: \"Bawa aku dari sini, karena aku luka parah!\""
 },
 {
   "id": 11993,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 24,
   "firman": "Orang-orangnya mengangkatnya dari keretanya, lalu mengangkutnya dengan kereta cadangannya lalu membawanya ke Yerusalem. Kemudian matilah ia, lalu dikuburkan di pekuburan nenek moyangnya. Seluruh Yehuda dan Yerusalem berkabung karena Yosia."
 },
 {
   "id": 11994,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 25,
   "firman": "Yeremia membuat suatu syair ratapan mengenai Yosia. Dan sampai sekarang ini semua penyanyi laki-laki dan penyanyi perempuan menyanyikan syair-syair ratapan mengenai Yosia, dan mereka jadikan itu suatu kebiasaan di Israel. Semuanya itu tertulis dalam Syair-syair Ratapan."
 },
 {
   "id": 11995,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 26,
   "firman": "Selebihnya dari riwayat Yosia dan perbuatan-perbuatannya yang saleh yang sesuai dengan yang ada tertulis dalam Taurat TUHAN,"
 },
 {
   "id": 11996,
   "kitab": "2Ta",
   "pasal": 35,
   "ayat": 27,
   "firman": "yakni, riwayatnya dari awal sampai akhir, sesungguhnya semuanya itu tertulis dalam kitab raja-raja Israel dan Yehuda."
 },
 {
   "id": 11997,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 1,
   "firman": "Rakyat negeri menjemput Yoahas anak Yosia, dan mengangkat dia menjadi raja di Yerusalem menggantikan ayahnya."
 },
 {
   "id": 11998,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 2,
   "firman": "Yoahas berumur dua puluh tiga tahun pada waktu ia menjadi raja dan tiga bulan lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 11999,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 3,
   "firman": "Raja Mesir memecatnya dari pemerintahannya di Yerusalem dan mendenda negeri itu seratus talenta perak dan satu talenta emas."
 },
 {
   "id": 12000,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 4,
   "firman": "Kemudian raja Mesir itu mengangkat Elyakim, saudara Yoahas, menjadi raja atas Yehuda dan Yerusalem, dan menukar namanya dengan Yoyakim. Tetapi Yoahas, saudaranya itu, ditawan oleh Nekho, dan dibawa ke Mesir."
 },
 {
   "id": 12001,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 5,
   "firman": "Yoyakim berumur dua puluh lima tahun pada waktu ia menjadi raja dan sebelas tahun lamanya ia memerintah di Yerusalem. Ia melakukan apa yang jahat di mata TUHAN, Allahnya."
 },
 {
   "id": 12002,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 6,
   "firman": "Nebukadnezar, raja Babel, maju melawan dia, membelenggunya dengan rantai tembaga untuk membawanya ke Babel."
 },
 {
   "id": 12003,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 7,
   "firman": "Juga beberapa perkakas rumah TUHAN dibawa Nebukadnezar ke Babel dan ditempatkan di istananya di Babel."
 },
 {
   "id": 12004,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 8,
   "firman": "Selebihnya dari riwayat Yoyakim, segala kekejian yang dilakukannya dan kesalahan yang ada padanya, sesungguhnya semuanya itu tertulis dalam kitab raja-raja Israel dan Yehuda. Maka Yoyakhin, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 12005,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 9,
   "firman": "Yoyakhin berumur delapan belas tahun pada waktu ia menjadi raja dan tiga bulan sepuluh hari lamanya ia memerintah di Yerusalem. Ia melakukan apa yang jahat di mata TUHAN."
 },
 {
   "id": 12006,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 10,
   "firman": "Pada pergantian tahun raja Nebukadnezar menyuruh membawa dia ke Babel beserta perkakas-perkakas yang indah-indah dari rumah TUHAN dan Zedekia, saudara ayah Yoyakhin, menjadi raja atas Yehuda dan Yerusalem."
 },
 {
   "id": 12007,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 11,
   "firman": "Zedekia berumur dua puluh satu tahun pada waktu ia menjadi raja dan sebelas tahun lamanya ia memerintah di Yerusalem."
 },
 {
   "id": 12008,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 12,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN, Allahnya, dan tidak merendahkan diri di hadapan nabi Yeremia, yang datang membawa pesan TUHAN."
 },
 {
   "id": 12009,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 13,
   "firman": "Lagipula ia memberontak terhadap raja Nebukadnezar, yang telah menyuruhnya bersumpah demi Allah. Ia menegarkan tengkuknya dan mengeraskan hatinya dan tidak berbalik kepada TUHAN, Allah Israel."
 },
 {
   "id": 12010,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 14,
   "firman": "Juga semua pemimpin di antara para imam dan rakyat berkali-kali berubah setia dengan mengikuti segala kekejian bangsa-bangsa lain. Rumah yang dikuduskan TUHAN di Yerusalem itu dinajiskan mereka."
 },
 {
   "id": 12011,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 15,
   "firman": "Namun TUHAN, Allah nenek moyang mereka, berulang-ulang mengirim pesan melalui utusan-utusan-Nya, karena Ia sayang kepada umat-Nya dan tempat kediaman-Nya."
 },
 {
   "id": 12012,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 16,
   "firman": "Tetapi mereka mengolok-olok utusan-utusan Allah itu, menghina segala firman-Nya, dan mengejek nabi-nabi-Nya. Oleh sebab itu murka TUHAN bangkit terhadap umat-Nya, sehingga tidak mungkin lagi pemulihan."
 },
 {
   "id": 12013,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 17,
   "firman": "TUHAN menggerakkan raja orang Kasdim melawan mereka. Raja itu membunuh teruna mereka dengan pedang dalam rumah kudus mereka, dan tidak menyayangkan teruna atau gadis, orang tua atau orang ubanan--semua diserahkan TUHAN ke dalam tangannya."
 },
 {
   "id": 12014,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 18,
   "firman": "Seluruh perkakas rumah Allah, yang besar dan yang kecil, serta harta benda dari rumah TUHAN, harta benda raja dan harta benda para panglimanya, semuanya dibawanya ke Babel."
 },
 {
   "id": 12015,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 19,
   "firman": "Mereka membakar rumah Allah, merobohkan tembok Yerusalem dan membakar segala puri dalam kota itu dengan api, sehingga musnahlah segala perabotannya yang indah-indah."
 },
 {
   "id": 12016,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 20,
   "firman": "Mereka yang masih tinggal dan yang luput dari pedang diangkutnya ke Babel dan mereka menjadi budaknya dan budak anak-anaknya sampai kerajaan Persia berkuasa."
 },
 {
   "id": 12017,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 21,
   "firman": "Dengan demikian genaplah firman TUHAN yang diucapkan Yeremia, sampai tanah itu pulih dari akibat dilalaikannya tahun-tahun sabatnya, karena tanah itu tandus selama menjalani sabat, hingga genaplah tujuh puluh tahun."
 },
 {
   "id": 12018,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 22,
   "firman": "Pada tahun pertama zaman Koresh, raja negeri Persia, TUHAN menggerakkan hati Koresh, raja Persia itu untuk menggenapkan firman yang diucapkan oleh Yeremia, sehingga disiarkan di seluruh kerajaan Koresh secara lisan dan tulisan pengumuman ini:"
 },
 {
   "id": 12019,
   "kitab": "2Ta",
   "pasal": 36,
   "ayat": 23,
   "firman": "\"Beginilah perintah Koresh, raja Persia: Segala kerajaan di bumi telah dikaruniakan kepadaku oleh TUHAN, Allah semesta langit. Ia menugaskan aku untuk mendirikan rumah bagi-Nya di Yerusalem, yang terletak di Yehuda. Siapa di antara kamu termasuk umat-Nya, TUHAN, Allahnya, menyertainya, dan biarlah ia berangkat pulang!\""
 },
 {
   "id": 12020,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada tahun pertama zaman Koresh, raja negeri Persia, TUHAN menggerakkan hati Koresh, raja Persia itu untuk menggenapkan firman yang diucapkan oleh Yeremia, sehingga disiarkan di seluruh kerajaan Koresh secara lisan dan tulisan pengumuman ini:"
 },
 {
   "id": 12021,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Beginilah perintah Koresh, raja Persia: Segala kerajaan di bumi telah dikaruniakan kepadaku oleh TUHAN, Allah semesta langit. Ia menugaskan aku untuk mendirikan rumah bagi-Nya di Yerusalem, yang terletak di Yehuda."
 },
 {
   "id": 12022,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 3,
   "firman": "Siapa di antara kamu termasuk umat-Nya, Allahnya menyertainya! Biarlah ia berangkat pulang ke Yerusalem, yang terletak di Yehuda, dan mendirikan rumah TUHAN. Allah Israel, yakni Allah yang diam di Yerusalem."
 },
 {
   "id": 12023,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan setiap orang yang tertinggal, di manapun ia ada sebagai pendatang, harus disokong oleh penduduk setempat dengan perak dan emas, harta benda dan ternak, di samping persembahan sukarela bagi rumah Allah yang ada di Yerusalem.\""
 },
 {
   "id": 12024,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 5,
   "firman": "Maka berkemaslah kepala-kepala kaum keluarga orang Yehuda dan orang Benyamin, serta para imam dan orang-orang Lewi, yakni setiap orang yang hatinya digerakkan Allah untuk berangkat pulang dan mendirikan rumah TUHAN yang ada di Yerusalem."
 },
 {
   "id": 12025,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan segala orang di sekeliling mereka membantu mereka dengan barang-barang perak, dengan emas, harta benda dan ternak dan dengan pemberian yang indah-indah, selain dari segala sesuatu yang dipersembahkan dengan sukarela."
 },
 {
   "id": 12026,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 7,
   "firman": "Pula raja Koresh menyuruh mengeluarkan perlengkapan rumah TUHAN yang telah diangkut Nebukadnezar dari Yerusalem dan yang ditaruhnya di dalam kuil allahnya."
 },
 {
   "id": 12027,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 8,
   "firman": "Koresh, raja Persia itu, menyuruh mengeluarkan semuanya itu di bawah pengawasan Mitredat, bendahara raja, yang menghitung seluruhnya bagi Sesbazar, pembesar di Yehuda."
 },
 {
   "id": 12028,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 9,
   "firman": "Inilah daftarnya: tiga puluh bokor emas, seribu bokor perak, dua puluh sembilan pisau,"
 },
 {
   "id": 12029,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 10,
   "firman": "tiga puluh piala emas, pula empat ratus sepuluh piala perak, seribu buah barang-barang lain."
 },
 {
   "id": 12030,
   "kitab": "Ezr",
   "pasal": 1,
   "ayat": 11,
   "firman": "Barang-barang emas dan perak itu seluruhnya berjumlah lima ribu empat ratus. Semuanya itu dibawa oleh Sesbazar sewaktu orang-orang buangan itu dibawa pulang dari negeri Babel ke Yerusalem."
 },
 {
   "id": 12031,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 1,
   "firman": "Inilah orang-orang propinsi Yehuda yang berangkat pulang dari pembuangan, yakni para tawanan, yang dahulu diangkut ke Babel oleh Nebukadnezar, raja Babel, dan yang kembali ke Yerusalem dan ke Yehuda, masing-masing ke kotanya."
 },
 {
   "id": 12032,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 2,
   "firman": "Mereka datang bersama-sama Zerubabel, Yesua, Nehemia, Seraya, Reelaya, Mordekhai, Bilsan, Mispar, Bigwai, Rehum dan Baana. Inilah daftar orang-orang bangsa Israel:"
 },
 {
   "id": 12033,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 3,
   "firman": "bani Paros: dua ribu seratus tujuh puluh dua orang;"
 },
 {
   "id": 12034,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 4,
   "firman": "bani Sefaca: tiga ratus tujuh puluh dua orang;"
 },
 {
   "id": 12035,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 5,
   "firman": "bani Arah: tujuh ratus tujuh puluh lima orang;"
 },
 {
   "id": 12036,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 6,
   "firman": "bani Pahat-Moab, yakni anak-anak Yesua dan Yoab: dua ribu delapan ratus dua belas orang;"
 },
 {
   "id": 12037,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 7,
   "firman": "bani Elam: seribu dua ratus lima puluh empat orang;"
 },
 {
   "id": 12038,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 8,
   "firman": "bani Zatu: sembilan ratus empat puluh lima orang;"
 },
 {
   "id": 12039,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 9,
   "firman": "bani Zakai: tujuh ratus enam puluh orang;"
 },
 {
   "id": 12040,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 10,
   "firman": "bani Bani: enam ratus empat puluh dua orang;"
 },
 {
   "id": 12041,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 11,
   "firman": "bani Bebai: enam ratus dua puluh tiga orang;"
 },
 {
   "id": 12042,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 12,
   "firman": "bani Azgad: seribu dua ratus dua puluh dua orang;"
 },
 {
   "id": 12043,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 13,
   "firman": "bani Adonikam: enam ratus enam puluh enam orang;"
 },
 {
   "id": 12044,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 14,
   "firman": "bani Bigwai: dua ribu lima puluh enam orang;"
 },
 {
   "id": 12045,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 15,
   "firman": "bani Adin: empat ratus lima puluh empat orang;"
 },
 {
   "id": 12046,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 16,
   "firman": "bani Ater, yakni bani Hizkia: sembilan puluh delapan orang;"
 },
 {
   "id": 12047,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 17,
   "firman": "bani Bezai: tiga ratus dua puluh tiga orang;"
 },
 {
   "id": 12048,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 18,
   "firman": "bani Yora: seratus dua belas orang;"
 },
 {
   "id": 12049,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 19,
   "firman": "bani Hasum: dua ratus dua puluh tiga orang;"
 },
 {
   "id": 12050,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 20,
   "firman": "bani Gibar: sembilan puluh lima orang;"
 },
 {
   "id": 12051,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 21,
   "firman": "dari Betlehem: seratus dua puluh tiga orang;"
 },
 {
   "id": 12052,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 22,
   "firman": "orang-orang Netofa: lima puluh enam orang;"
 },
 {
   "id": 12053,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 23,
   "firman": "orang-orang Anatot: seratus dua puluh delapan orang;"
 },
 {
   "id": 12054,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 24,
   "firman": "dari Asmawet: empat puluh dua orang;"
 },
 {
   "id": 12055,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 25,
   "firman": "dari Kiryat-Arim, Kefira dan Beerot: tujuh ratus empat puluh tiga orang;"
 },
 {
   "id": 12056,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 26,
   "firman": "dari Rama dan Gaba: enam ratus dua puluh satu orang;"
 },
 {
   "id": 12057,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 27,
   "firman": "orang-orang Mikhmas: seratus dua puluh dua orang;"
 },
 {
   "id": 12058,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 28,
   "firman": "orang-orang Betel dan Ai: dua ratus dua puluh tiga orang;"
 },
 {
   "id": 12059,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 29,
   "firman": "dari Nebo: lima puluh dua orang;"
 },
 {
   "id": 12060,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 30,
   "firman": "bani Magbis: seratus lima puluh enam orang;"
 },
 {
   "id": 12061,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 31,
   "firman": "bani Elam, yakni Elam yang lain: seribu dua ratus lima puluh empat orang;"
 },
 {
   "id": 12062,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 32,
   "firman": "bani Harim: tiga ratus dua puluh orang;"
 },
 {
   "id": 12063,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 33,
   "firman": "orang-orang dari Lod, Hadid dan Ono: tujuh ratus dua puluh lima orang;"
 },
 {
   "id": 12064,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 34,
   "firman": "dari Yerikho: tiga ratus empat puluh lima orang;"
 },
 {
   "id": 12065,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 35,
   "firman": "bani Senaa: tiga ribu enam ratus tiga puluh orang."
 },
 {
   "id": 12066,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 36,
   "firman": "Inilah para imam: bani Yedaya, yakni kaum keluarga Yesua: sembilan ratus tujuh puluh tiga orang;"
 },
 {
   "id": 12067,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 37,
   "firman": "bani Imer: seribu lima puluh dua orang;"
 },
 {
   "id": 12068,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 38,
   "firman": "bani Pasyhur: seribu dua ratus empat puluh tujuh orang;"
 },
 {
   "id": 12069,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 39,
   "firman": "bani Harim: seribu tujuh belas orang."
 },
 {
   "id": 12070,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 40,
   "firman": "Inilah orang-orang Lewi: bani Yesua dan Kadmiel, yakni bani Hodawya: tujuh puluh empat orang."
 },
 {
   "id": 12071,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 41,
   "firman": "Inilah para penyanyi: bani Asaf: seratus dua puluh delapan orang."
 },
 {
   "id": 12072,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 42,
   "firman": "Inilah kaum penunggu pintu gerbang: bani Salum, bani Ater, bani Talmon, bani Akub, bani Hatita, bani Sobai, semuanya seratus tiga puluh sembilan orang."
 },
 {
   "id": 12073,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 43,
   "firman": "Inilah para budak di bait Allah: bani Ziha, bani Hasufa, bani Tabaot;"
 },
 {
   "id": 12074,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 44,
   "firman": "bani Keros, bani Siaha, bani Padon;"
 },
 {
   "id": 12075,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 45,
   "firman": "bani Lebana, bani Hagaba, bani Akub;"
 },
 {
   "id": 12076,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 46,
   "firman": "bani Hagab, bani Samlai, bani Hanan;"
 },
 {
   "id": 12077,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 47,
   "firman": "bani Gidel, bani Gahar, bani Reaya;"
 },
 {
   "id": 12078,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 48,
   "firman": "bani Rezin, bani Nekoda, bani Gazam;"
 },
 {
   "id": 12079,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 49,
   "firman": "bani Uza, bani Paseah, bani Besai;"
 },
 {
   "id": 12080,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 50,
   "firman": "bani Asna, bani Meunim, bani Nefusim;"
 },
 {
   "id": 12081,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 51,
   "firman": "bani Bakbuk, bani Hakufa, bani Harhur;"
 },
 {
   "id": 12082,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 52,
   "firman": "bani Bazlut, bani Mehida, bani Harsa;"
 },
 {
   "id": 12083,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 53,
   "firman": "bani Barkos, bani Sisera, bani Temah;"
 },
 {
   "id": 12084,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 54,
   "firman": "bani Neziah, bani Hatifa."
 },
 {
   "id": 12085,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 55,
   "firman": "Inilah keturunan para hamba Salomo: bani Sotai, bani Soferet, bani Peruda;"
 },
 {
   "id": 12086,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 56,
   "firman": "bani Yaala, bani Darkon, bani Gidel;"
 },
 {
   "id": 12087,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 57,
   "firman": "bani Sefaca, bani Hatil, bani Pokheret-Hazebaim, bani Ami."
 },
 {
   "id": 12088,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 58,
   "firman": "Seluruh budak di bait Allah dan keturunan para hamba Salomo ada tiga ratus sembilan puluh dua orang."
 },
 {
   "id": 12089,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 59,
   "firman": "Inilah orang-orang yang berangkat pulang dari Tel-Melah, Tel-Harsa, Kerub, Adan dan Imer, tetapi mereka tidak dapat menyatakan apakah kaum keluarga dan asal usul mereka termasuk bangsa Israel:"
 },
 {
   "id": 12090,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 60,
   "firman": "bani Delaya, bani Tobia, bani Nekoda, enam ratus lima puluh dua orang;"
 },
 {
   "id": 12091,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 61,
   "firman": "dan dari antara kaum imam: bani Habaya, bani Hakos, bani Barzilai. Barzilai itu memperisteri seorang anak perempuan Barzilai, orang Gilead itu, dan sejak itu ia dinamai menurut nama keluarga itu."
 },
 {
   "id": 12092,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 62,
   "firman": "Mereka itu menyelidiki apakah nama mereka tercatat dalam silsilah, tetapi karena itu tidak didapati, maka mereka dinyatakan tidak tahir untuk jabatan imam."
 },
 {
   "id": 12093,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 63,
   "firman": "Dan tentang mereka diputuskan oleh kepala daerah, bahwa mereka tidak boleh makan dari persembahan maha kudus, sampai ada seorang imam bertindak dengan memegang Urim dan Tumim."
 },
 {
   "id": 12094,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 64,
   "firman": "Seluruh jemaah itu bersama-sama ada empat puluh dua ribu tiga ratus enam puluh orang,"
 },
 {
   "id": 12095,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 65,
   "firman": "selain dari budak mereka laki-laki dan perempuan yang berjumlah tujuh ribu tiga ratus tiga puluh tujuh orang. Pada mereka ada dua ratus penyanyi laki-laki dan perempuan."
 },
 {
   "id": 12096,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 66,
   "firman": "Mereka mempunyai tujuh ratus tiga puluh enam ekor kuda, dua ratus empat puluh lima ekor bagal,"
 },
 {
   "id": 12097,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 67,
   "firman": "empat ratus tiga puluh lima ekor unta, dan enam ribu tujuh ratus dua puluh ekor keledai."
 },
 {
   "id": 12098,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 68,
   "firman": "Beberapa kepala kaum keluarga, tatkala datang ke rumah TUHAN yang di Yerusalem, mempersembahkan persembahan sukarela guna pembangunan rumah Allah pada tempatnya semula."
 },
 {
   "id": 12099,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 69,
   "firman": "Mereka memberi sumbangan sekadar kemampuan mereka untuk perbendaharaan guna pekerjaan itu sebanyak enam puluh satu ribu dirham emas, lima ribu mina perak dan seratus helai kemeja imam."
 },
 {
   "id": 12100,
   "kitab": "Ezr",
   "pasal": 2,
   "ayat": 70,
   "firman": "Adapun para imam dan orang-orang Lewi, dan juga sebagian dari rakyat, serta para penyanyi, para penunggu pintu gerbang dan para budak di bait Allah menetap di kota-kota mereka, demikian juga semua orang Israel yang lain, masing-masing di kota-kotanya sendiri."
 },
 {
   "id": 12101,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 1,
   "firman": "Ketika tiba bulan yang ketujuh, setelah orang Israel menetap di kota-kotanya, maka serentak berkumpullah seluruh rakyat di Yerusalem."
 },
 {
   "id": 12102,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 2,
   "firman": "Maka mulailah Yesua bin Yozadak beserta saudara-saudaranya, para imam itu, dan Zerubabel bin Sealtiel beserta saudara-saudaranya membangun mezbah Allah Israel untuk mempersembahkan korban bakaran di atasnya, sesuai dengan yang ada tertulis dalam kitab Taurat Musa, abdi Allah."
 },
 {
   "id": 12103,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 3,
   "firman": "Mereka mendirikan mezbah itu di tempatnya semula, sungguhpun mereka ketakutan terhadap penduduk negeri, lalu mereka mempersembahkan di atasnya korban bakaran kepada TUHAN, korban bakaran waktu pagi dan waktu petang."
 },
 {
   "id": 12104,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mereka juga mengadakan hari raya Pondok Daun, sesuai dengan yang ada tertulis, dan mempersembahkan korban bakaran hari demi hari menurut jumlah yang sesuai dengan peraturan, yakni setiap hari menurut yang ditetapkan untuk hari itu."
 },
 {
   "id": 12105,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 5,
   "firman": "Dan sejak itu diadakanlah korban bakaran yang tetap, juga korban bakaran pada bulan baru dan pada setiap hari raya yang kudus bagi TUHAN, dan setiap kali orang mempersembahkan persembahan sukarela kepada TUHAN."
 },
 {
   "id": 12106,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sejak hari pertama bulan yang ketujuh mereka mulai mempersembahkan korban bakaran kepada TUHAN, namun dasar bait suci TUHAN belum juga diletakkan."
 },
 {
   "id": 12107,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 7,
   "firman": "Lalu mereka memberikan uang kepada tukang batu dan tukang kayu, sedang kepada orang Sidon dan Tirus makanan dan minuman dan minyak, supaya orang-orang itu membawa kayu aras dari Libanon sampai ke laut dekat Yafo, seperti yang telah diizinkan kepada mereka oleh Koresh, raja negeri Persia."
 },
 {
   "id": 12108,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 8,
   "firman": "Pada tahun yang kedua sesudah mereka sampai ke rumah Allah di Yerusalem, dalam bulan yang kedua, maka Zerubabel bin Sealtiel dan Yesua bin Yozadak beserta saudara-saudara mereka yang lain, yakni para imam dan orang-orang Lewi, dan semua orang yang pulang ke Yerusalem dari tempat tawanan memulai pekerjaan itu. Mereka menugaskan orang-orang Lewi yang berumur dua puluh tahun ke atas untuk mengawasi pekerjaan membangun rumah TUHAN."
 },
 {
   "id": 12109,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 9,
   "firman": "Lalu Yesua serta anak-anak dan saudara-saudaranya dan Kadmiel serta anak-anaknya, orang-orang Yehuda bersama-sama bertindak mengawasi orang-orang yang melakukan pekerjaan membangun rumah Allah. Demikian juga bani Henadad, anak-anak dan saudara-saudara mereka, orang-orang Lewi itu."
 },
 {
   "id": 12110,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 10,
   "firman": "Pada waktu dasar bait suci TUHAN diletakkan oleh tukang-tukang bangunan, maka tampillah para imam dengan memakai pakaian jabatan dan membawa nafiri, dan orang-orang Lewi, bani Asaf, dengan membawa ceracap, untuk memuji-muji TUHAN, menurut petunjuk Daud, raja Israel."
 },
 {
   "id": 12111,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 11,
   "firman": "Secara berbalas-balasan mereka menyanyikan bagi TUHAN nyanyian pujian dan syukur: \"Sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya kepada Israel!\" Dan seluruh umat bersorak-sorai dengan nyaring sambil memuji-muji TUHAN, oleh karena dasar rumah TUHAN telah diletakkan."
 },
 {
   "id": 12112,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 12,
   "firman": "Tetapi banyak di antara para imam, orang-orang Lewi dan kepala-kepala kaum keluarga, orang tua-tua yang pernah melihat rumah yang dahulu, menangis dengan suara nyaring, ketika perletakan dasar rumah ini dilakukan di depan mata mereka, sedang banyak orang bersorak-sorai dengan suara nyaring karena kegirangan."
 },
 {
   "id": 12113,
   "kitab": "Ezr",
   "pasal": 3,
   "ayat": 13,
   "firman": "Orang tidak dapat lagi membedakan mana bunyi sorak-sorai kegirangan dan mana bunyi tangis rakyat, karena rakyat bersorak-sorai dengan suara yang nyaring, sehingga bunyinya kedengaran sampai jauh."
 },
 {
   "id": 12114,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ketika lawan orang Yehuda dan Benyamin mendengar, bahwa orang-orang yang pulang dari pembuangan itu sedang membangun bait suci bagi TUHAN, Allah Israel,"
 },
 {
   "id": 12115,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 2,
   "firman": "maka mereka mendekati Zerubabel serta para kepala kaum keluarga dan berkata kepada mereka: \"Biarlah kami turut membangun bersama-sama dengan kamu, karena kamipun berbakti kepada Allahmu sama seperti kamu; lagipula kami selalu mempersembahkan korban kepada-Nya sejak zaman Esar-Hadon, raja Asyur, yang memindahkan kami ke mari.\""
 },
 {
   "id": 12116,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 3,
   "firman": "Tetapi Zerubabel, Yesua dan para kepala kaum keluarga orang Israel yang lain berkata kepada mereka: \"Bukanlah urusan kita bersama, sehingga kamu dan kami membangun rumah bagi Allah kami, karena kami sendirilah yang hendak membangun bagi TUHAN, Allah Israel, seperti yang diperintahkan kepada kami oleh Koresh, raja negeri Persia.\""
 },
 {
   "id": 12117,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 4,
   "firman": "Maka penduduk negeri itu melemahkan semangat orang-orang Yehuda dan membuat mereka takut membangun."
 },
 {
   "id": 12118,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 5,
   "firman": "Bahkan, selama zaman Koresh, raja negeri Persia, sampai zaman pemerintahan Darius, raja negeri Persia, mereka menyogok para penasihat untuk melawan orang-orang Yehuda itu dan menggagalkan rancangan mereka."
 },
 {
   "id": 12119,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 6,
   "firman": "Pada zaman pemerintahan Ahasyweros, pada permulaan pemerintahannya, mereka menulis surat tuduhan terhadap orang-orang yang telah menetap di Yehuda dan di Yerusalem."
 },
 {
   "id": 12120,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 7,
   "firman": "Dan pada zaman Artahsasta ditulislah surat oleh Bislam, Mitredat dan Tabeel serta rekan-rekannya yang lain kepada Artahsasta, raja negeri Persia. Naskah surat itu ditulis dalam bahasa Aram dengan terjemahannya. (Dalam bahasa Aram:)"
 },
 {
   "id": 12121,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 8,
   "firman": "Rehum, bupati, dan Simsai, panitera, telah menulis surat terhadap Yerusalem kepada raja Artahsasta, yang isinya sebagai berikut."
 },
 {
   "id": 12122,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 9,
   "firman": "--Pada waktu itu ditulislah surat itu oleh Rehum, bupati, dan Simsai, panitera, serta rekan-rekan mereka yang lain, para hakim dan punggawa dan pegawai-pegawai, orang Persia, orang-orang dari Erekh, dari Babel serta orang-orang dari Susan, yaitu orang-orang Elam,"
 },
 {
   "id": 12123,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 10,
   "firman": "dan bangsa-bangsa lain, yang oleh Asnapar yang agung dan mulia itu dipindahkan dan disuruh menetap di kota Samaria dan di daerah yang lain sebelah barat sungai Efrat."
 },
 {
   "id": 12124,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 11,
   "firman": "Inilah salinan surat yang dikirim mereka kepadanya: \"Ke hadapan raja Artahsasta dari hamba-hamba tuanku, orang-orang di daerah sebelah barat sungai Efrat. Maka"
 },
 {
   "id": 12125,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 12,
   "firman": "kiranya raja maklum, bahwa orang-orang Yahudi, yang berangkat dari tuanku ke tempat kami, telah tiba di Yerusalem. Mereka sedang membangun kembali kota yang durhaka dan jahat itu; mereka menyelesaikan pembangunan tembok-tembok dan memperbaiki dasarnya."
 },
 {
   "id": 12126,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 13,
   "firman": "Kiranya raja maklum, bahwa jikalau kota itu sudah dibangun dan tembok-temboknya sudah selesai, orang tidak lagi membayar pajak, upeti atau bea, sehingga kota itu akhirnya mendatangkan kerugian kepada raja-raja."
 },
 {
   "id": 12127,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 14,
   "firman": "Sekarang, oleh karena kami mempunyai hubungan dengan raja dan tidak patut bagi kami melihat raja kena cela, maka oleh sebab itu kami menyuruh orang memberitahukan hal itu kepada raja,"
 },
 {
   "id": 12128,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 15,
   "firman": "supaya diadakan penyelidikan dalam kitab riwayat nenek moyang tuanku. Di dalam kitab riwayat itu tuanku akan mendapati dan mengetahui, bahwa kota itu kota durhaka, yang selalu mendatangkan kerugian kepada raja-raja dan daerah-daerah, dan bahwa orang selalu mengadakan pemberontakan di dalamnya sejak zaman dahulu. Itulah sebabnya maka kota itu dibinasakan."
 },
 {
   "id": 12129,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 16,
   "firman": "Kami ini memberitahukan kepada raja, bahwa jikalau kota itu sudah dibangun kembali dan tembok-temboknya sudah selesai, maka bagi tuanku kelak tidak ada lagi milik di daerah sebelah barat sungai Efrat.\""
 },
 {
   "id": 12130,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 17,
   "firman": "Maka raja mengirim surat jawaban ini: \"Kepada Rehum, bupati, dan Simsai, panitera, serta rekan-rekan mereka yang lain, yang tinggal di Samaria dan di daerah yang lain seberang sungai Efrat. Salam! Maka sekarang,"
 },
 {
   "id": 12131,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 18,
   "firman": "surat yang kamu kirim kepada kami, telah dibacakan kepadaku dengan jelas."
 },
 {
   "id": 12132,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 19,
   "firman": "Lalu atas perintahku telah diadakan penyelidikan, dan didapati, bahwa kota itu sejak zaman dahulu selalu bangkit melawan raja-raja dan bahwa penduduknya selalu mendurhaka dan memberontak."
 },
 {
   "id": 12133,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 20,
   "firman": "Lagipula dahulu ada raja-raja yang berkuasa atas Yerusalem, yang memerintah seluruh daerah seberang sungai Efrat, dan kepada mereka dibayarlah pajak, upeti dan bea."
 },
 {
   "id": 12134,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 21,
   "firman": "Oleh sebab itu, keluarkanlah perintah, untuk menghentikan orang-orang itu, supaya kota itu jangan dibangun kembali, sebelum aku mengeluarkan perintah."
 },
 {
   "id": 12135,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 22,
   "firman": "Dan ingatlah baik-baik supaya jangan kamu perbuat suatu kelalaian dalam perkara ini. Apakah gunanya kerusakan yang menjadi kerugian raja-raja itu bertambah besar?\""
 },
 {
   "id": 12136,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 23,
   "firman": "Maka setelah salinan surat raja Artahsasta dibacakan kepada Rehum, dan Simsai, panitera, serta rekan-rekan mereka, berangkatlah mereka dengan segera ke Yerusalem mendapatkan orang-orang Yahudi, dan dengan kekerasan mereka memaksa orang-orang itu menghentikan pekerjaan itu."
 },
 {
   "id": 12137,
   "kitab": "Ezr",
   "pasal": 4,
   "ayat": 24,
   "firman": "Pada waktu itu terhentilah pekerjaan membangun rumah Allah yang di Yerusalem, dan tetap terhenti sampai tahun yang kedua zaman pemerintahan Darius, raja negeri Persia."
 },
 {
   "id": 12138,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 1,
   "firman": "Tetapi nabi Hagai dan Zakharia bin Ido, kedua nabi itu, bernubuat terhadap orang-orang Yahudi yang tinggal di Yehuda dan di Yerusalem dalam nama Allah Israel, yang menyertai mereka."
 },
 {
   "id": 12139,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 2,
   "firman": "Pada waktu itu mulailah Zerubabel bin Sealtiel dan Yesua bin Yozadak membangun rumah Allah yang ada di Yerusalem. Mereka didampingi dan dibantu oleh nabi-nabi Allah."
 },
 {
   "id": 12140,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 3,
   "firman": "Tetapi pada waktu itu juga datanglah kepada mereka Tatnai, bupati daerah sebelah barat sungai Efrat, bersama-sama dengan Syetar-Boznai dan rekan-rekan mereka, dan beginilah katanya kepada mereka: \"Siapakah yang memberi perintah kepadamu untuk membangun rumah ini dan menyelesaikan tembok ini?\""
 },
 {
   "id": 12141,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 4,
   "firman": "Lalu katanya pula kepada mereka: \"Siapakah nama-nama orang yang mendirikan bangunan ini?\""
 },
 {
   "id": 12142,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 5,
   "firman": "Tetapi mata Allah mengamat-amati para tua-tua orang Yahudi, sehingga mereka tidak dipaksa berhenti oleh orang-orang itu sampai ada berita diterima oleh Darius dan kemudian dikirim kembali surat jawaban mengenai hal itu."
 },
 {
   "id": 12143,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 6,
   "firman": "Inilah salinan surat yang dikirim Tatnai, bupati daerah sebelah barat sungai Efrat, bersama-sama dengan Syetar-Boznai dan rekan-rekannya, para punggawa daerah sebelah barat sungai Efrat, kepada raja Darius."
 },
 {
   "id": 12144,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 7,
   "firman": "Mereka mengirim laporan tertulis kepadanya yang bunyinya sebagai berikut: \"Ke hadapan raja Darius. Salam sejahtera!"
 },
 {
   "id": 12145,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kiranya raja maklum, bahwa kami datang ke daerah Yehuda, ke rumah Allah yang maha besar. Rumah itu sedang dibangun dengan batu yang besar-besar, sedang dindingnya dilapis dengan kayu, dan pekerjaan itu dikerjakan dengan seksama dan berjalan lancar di tangan mereka."
 },
 {
   "id": 12146,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kemudian kami menanyai para tua-tua itu dan beginilah kata kami kepada mereka: Siapakah yang memberi perintah kepadamu untuk membangun rumah ini dan menyelesaikan tembok ini?"
 },
 {
   "id": 12147,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 10,
   "firman": "Lagipula kami tanyakan kepada mereka nama-nama mereka, untuk memberitahukannya kepada tuanku, dengan mencatat nama orang-orang yang mengepalai mereka."
 },
 {
   "id": 12148,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 11,
   "firman": "Inilah jawaban yang diberikan mereka kepada kami: Kami adalah hamba-hamba Allah semesta langit dan bumi, dan kami membangun kembali rumah, yang telah didirikan bertahun-tahun sebelumnya, didirikan dan diselesaikan oleh seorang raja Israel yang agung."
 },
 {
   "id": 12149,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 12,
   "firman": "Tetapi sesudah nenek moyang kami membangkitkan murka Allah semesta langit, mereka diserahkan-Nya ke dalam tangan Nebukadnezar, raja negeri Babel, orang Kasdim, yang merusak rumah itu dan mengangkut bangsa itu sebagai tawanan ke negeri Babel."
 },
 {
   "id": 12150,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 13,
   "firman": "Akan tetapi pada tahun pertama zaman Koresh, raja negeri Babel, dikeluarkanlah perintah oleh raja Koresh untuk membangun rumah Allah ini."
 },
 {
   "id": 12151,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 14,
   "firman": "Juga perlengkapan emas dan perak dari rumah Allah, yang telah diambil oleh Nebukadnezar dari bait suci yang di Yerusalem dan dibawa ke dalam bait suci yang di Babel, diambil pula oleh raja Koresh dari bait suci yang di Babel itu, dan diserahkan kepada seorang yang bernama Sesbazar yang telah diangkatnya menjadi bupati."
 },
 {
   "id": 12152,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 15,
   "firman": "Perintahnya kepadanya: Ambillah perlengkapan ini, pergilah dan taruhlah itu di dalam bait suci yang di Yerusalem, dan biarlah rumah Allah dibangun di tempatnya yang semula."
 },
 {
   "id": 12153,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 16,
   "firman": "Kemudian datanglah Sesbazar, meletakkan dasar rumah Allah yang ada di Yerusalem, dan sejak waktu itu sampai sekarang dikerjakanlah pembangunannya, hanya belum selesai."
 },
 {
   "id": 12154,
   "kitab": "Ezr",
   "pasal": 5,
   "ayat": 17,
   "firman": "Oleh sebab itu, jikalau dianggap baik oleh raja, maka hendaklah diadakan penyelidikan di dalam gedung perbendaharaan raja, di sana, di Babel, apakah pernah dikeluarkan perintah oleh raja Koresh untuk membangun kembali rumah Allah yang di Yerusalem itu. Kemudian keputusan raja tentang hal itu kiranya dikirimkan kepada kami.\""
 },
 {
   "id": 12155,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 1,
   "firman": "Sesudah itu atas perintah raja Darius diadakanlah penyelidikan di perbendaharaan di Babel, di tempat naskah-naskah disimpan."
 },
 {
   "id": 12156,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 2,
   "firman": "Kemudian di Ahmeta, benteng yang di propinsi Media, didapati sebuah gulungan, yang isinya sebagai berikut: \"Piagam:"
 },
 {
   "id": 12157,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 3,
   "firman": "Pada tahun pertama zaman raja Koresh dikeluarkanlah perintah oleh raja Koresh: Mengenai rumah Allah di Yerusalem. Rumah itu haruslah dibangun kembali sebagai tempat orang mempersembahkan korban sembelihan dan korban api-apian; haruslah tingginya enam puluh hasta dan lebarnya enam puluh hasta."
 },
 {
   "id": 12158,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dan haruslah dipasang tiga lapis batu besar-besar dan satu lapis kayu. Biayanya harus dibayar dari perbendaharaan kerajaan."
 },
 {
   "id": 12159,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 5,
   "firman": "Dan juga perlengkapan emas dan perak rumah Allah yang diambil oleh Nebukadnezar dari bait suci yang di Yerusalem dan dibawa ke Babel itu haruslah dikembalikan, supaya kembali pula ke dalam bait suci yang di Yerusalem, ke tempatnya yang semula; dan engkau haruslah menaruhnya di dalam rumah Allah.\""
 },
 {
   "id": 12160,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 6,
   "firman": "\"Oleh sebab itu, hai Tatnai, bupati daerah seberang sungai Efrat, dan Syetar-Boznai serta rekan-rekanmu, para punggawa daerah seberang sungai Efrat, hendaklah kamu menjauhkan diri dari sana."
 },
 {
   "id": 12161,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 7,
   "firman": "Biarkanlah pekerjaan membangun rumah Allah itu. Bupati dan para tua-tua orang Yahudi boleh membangun rumah Allah itu di tempatnya yang semula."
 },
 {
   "id": 12162,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 8,
   "firman": "Lagipula telah dikeluarkan perintah olehku tentang apa yang harus kamu perbuat terhadap para tua-tua orang Yahudi mengenai pembangunan rumah Allah itu, yakni dari pada penghasilan kerajaan, dari pada upeti daerah seberang sungai Efrat, haruslah dengan seksama dan dengan tidak bertangguh diberi biaya kepada orang-orang itu."
 },
 {
   "id": 12163,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dan apa yang diperlukan, yakni lembu jantan muda, domba jantan, anak domba untuk korban bakaran bagi Allah semesta langit, juga gandum, garam, anggur dan minyak, menurut petunjuk para imam yang di Yerusalem, semuanya itu harus diberikan kepada mereka hari demi hari tanpa kelalaian,"
 },
 {
   "id": 12164,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 10,
   "firman": "supaya mereka selalu mempersembahkan korban yang menyenangkan kepada Allah semesta langit dan mendoakan raja serta anak-anaknya."
 },
 {
   "id": 12165,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 11,
   "firman": "Selanjutnya telah dikeluarkan perintah olehku, supaya setiap orang yang melanggar keputusan ini, akan dicabut sebatang tiang dari rumahnya, untuk menyulakannya pada ujung tiang itu dan supaya rumahnya dijadikan reruntuhan oleh karena hal itu."
 },
 {
   "id": 12166,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 12,
   "firman": "Maka Allah, yang sudah membuat nama-Nya diam di sana, biarlah Ia merobohkan setiap raja dan setiap bangsa, yang mengacungkan tangan untuk melanggar keputusan ini dan membinasakan rumah Allah yang di Yerusalem itu. Aku, Darius, yang mengeluarkan perintah ini. Hendaklah itu dilakukan dengan seksama.\""
 },
 {
   "id": 12167,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 13,
   "firman": "Kemudian Tatnai, bupati daerah sebelah barat sungai Efrat, Syetar-Boznai dan rekan-rekan mereka berbuat dengan seksama menurut apa yang diperintahkan raja Darius."
 },
 {
   "id": 12168,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 14,
   "firman": "Para tua-tua orang Yahudi melanjutkan pembangunan itu dengan lancar digerakkan oleh nubuat nabi Hagai dan nabi Zakharia bin Ido. Mereka menyelesaikan pembangunan menurut perintah Allah Israel dan menurut perintah Koresh, Darius dan Artahsasta, raja-raja negeri Persia."
 },
 {
   "id": 12169,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 15,
   "firman": "Maka selesailah rumah itu pada hari yang ketiga bulan Adar, yakni pada tahun yang keenam zaman pemerintahan raja Darius."
 },
 {
   "id": 12170,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 16,
   "firman": "Maka orang Israel, para imam, orang-orang Lewi dan orang-orang lain yang pulang dari pembuangan, merayakan pentahbisan rumah Allah ini dengan sukaria."
 },
 {
   "id": 12171,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 17,
   "firman": "Untuk pentahbisan rumah Allah ini mereka mempersembahkan lembu jantan seratus ekor, domba jantan dua ratus ekor dan anak domba empat ratus ekor; juga kambing jantan sebagai korban penghapus dosa bagi seluruh orang Israel dua belas ekor, menurut bilangan suku Israel."
 },
 {
   "id": 12172,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 18,
   "firman": "Mereka juga menempatkan para imam pada golongan-golongannya dan orang-orang Lewi pada rombongan-rombongannya untuk melakukan ibadah kepada Allah yang diam di Yerusalem, sesuai dengan yang ada tertulis dalam kitab Musa."
 },
 {
   "id": 12173,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 19,
   "firman": "Dan pada tanggal empat belas bulan pertama mereka yang pulang dari pembuangan merayakan Paskah."
 },
 {
   "id": 12174,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 20,
   "firman": "Karena para imam dan orang-orang Lewi bersama-sama mentahirkan diri, sehingga tahirlah mereka sekalian. Demikianlah mereka menyembelih anak domba Paskah bagi semua orang yang pulang dari pembuangan, dan bagi saudara-saudara mereka, yakni para imam, dan bagi dirinya sendiri."
 },
 {
   "id": 12175,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 21,
   "firman": "Orang-orang Israel yang pulang dari pembuangan memakannya dan demikian juga setiap orang yang memisahkan diri dari kenajisan bangsa-bangsa negeri itu lalu menggabungkan diri kepada mereka, untuk berbakti kepada TUHAN, Allah Israel."
 },
 {
   "id": 12176,
   "kitab": "Ezr",
   "pasal": 6,
   "ayat": 22,
   "firman": "Lagipula mereka merayakan hari raya Roti Tidak Beragi dengan sukacita, tujuh hari lamanya, karena TUHAN telah membuat mereka bersukacita; Ia telah memalingkan hati raja negeri Asyur kepada mereka, sehingga raja membantu mereka dalam pekerjaan membangun rumah Allah, yakni Allah Israel."
 },
 {
   "id": 12177,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 1,
   "firman": "Kemudian dari pada semuanya itu, pada zaman pemerintahan Artahsasta, raja negeri Persia, maka berangkatlah Ezra bin Seraya bin Azarya bin Hilkia"
 },
 {
   "id": 12178,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 2,
   "firman": "bin Salum bin Zadok bin Ahitub"
 },
 {
   "id": 12179,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 3,
   "firman": "bin Amarya bin Azarya bin Merayot"
 },
 {
   "id": 12180,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 4,
   "firman": "bin Zerahya bin Uzi bin Buki"
 },
 {
   "id": 12181,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 5,
   "firman": "bin Abisua bin Pinehas bin Eleazar bin Harun, yaitu Harun imam kepala."
 },
 {
   "id": 12182,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 6,
   "firman": "Ezra ini berangkat pulang dari Babel. Ia adalah seorang ahli kitab, mahir dalam Taurat Musa yang diberikan TUHAN, Allah Israel. Dan raja memberi dia segala yang diingininya, oleh karena tangan TUHAN, Allahnya, melindungi dia."
 },
 {
   "id": 12183,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 7,
   "firman": "Juga berangkat pulang ke Yerusalem beberapa rombongan orang Israel dan imam, orang Lewi, penyanyi, penunggu pintu gerbang dan budak di bait Allah pada tahun ketujuh zaman raja Artahsasta."
 },
 {
   "id": 12184,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 8,
   "firman": "Lalu tibalah ia di Yerusalem pada bulan kelima, yakni pada tahun ketujuh zaman raja itu."
 },
 {
   "id": 12185,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 9,
   "firman": "Tepat pada tanggal satu bulan pertama ia memulai perjalanannya pulang dari Babel dan tepat pada tanggal satu bulan kelima ia tiba di Yerusalem, oleh karena tangan murah Allahnya itu melindungi dia."
 },
 {
   "id": 12186,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 10,
   "firman": "Sebab Ezra telah bertekad untuk meneliti Taurat TUHAN dan melakukannya serta mengajar ketetapan dan peraturan di antara orang Israel."
 },
 {
   "id": 12187,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 11,
   "firman": "Inilah salinan surat, yang diberikan raja Artahsasta kepada Ezra, imam dan ahli kitab itu, yang ahli dalam perkataan segala perintah dan ketetapan TUHAN bagi orang Israel:"
 },
 {
   "id": 12188,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 12,
   "firman": "\"Artahsasta, raja segala raja, kepada Ezra, imam dan ahli Taurat Allah semesta langit, dan selanjutnya. Maka sekarang,"
 },
 {
   "id": 12189,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 13,
   "firman": "olehku telah dikeluarkan perintah, bahwa setiap orang di dalam kerajaanku yang termasuk orang Israel awam, atau para imamnya atau orang-orang Lewi, dan yang rela pergi ke Yerusalem, boleh turut pergi dengan engkau."
 },
 {
   "id": 12190,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 14,
   "firman": "Oleh karena engkau disuruh raja serta ketujuh orang penasihatnya untuk mengadakan penyelidikan mengenai Yehuda dan Yerusalem dengan berpedoman kepada hukum Allahmu yang menjadi peganganmu,"
 },
 {
   "id": 12191,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 15,
   "firman": "dan untuk membawa perak dan emas, yang diberikan raja serta para penasihatnya sebagai persembahan sukarela kepada Allah Israel, yang tempat kediaman-Nya di Yerusalem,"
 },
 {
   "id": 12192,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 16,
   "firman": "beserta segala perak dan emas yang akan kauperoleh di seluruh propinsi Babel, dengan persembahan sukarela yang akan dipersembahkan oleh rakyat dan para imam bagi rumah Allah mereka yang ada di Yerusalem,"
 },
 {
   "id": 12193,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 17,
   "firman": "maka oleh karena itu haruslah engkau dengan seksama memakai uang itu untuk membeli lembu-lembu jantan, domba-domba jantan, anak-anak domba dengan korban sajiannya dan korban curahannya, dan haruslah semuanya itu kaupersembahkan di atas mezbah di rumah Allahmu yang ada di Yerusalem."
 },
 {
   "id": 12194,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 18,
   "firman": "Tetapi apa yang dianggap baik olehmu dan oleh saudara-saudaramu untuk diperbuat dengan perak dan emas yang selebihnya, boleh kamu perbuat sesuai dengan kehendak Allahmu."
 },
 {
   "id": 12195,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 19,
   "firman": "Hanya perlengkapan-perlengkapan yang diserahkan kepadamu untuk ibadah di rumah Allahmu, sampaikanlah itu ke hadapan Allah di Yerusalem."
 },
 {
   "id": 12196,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 20,
   "firman": "Dan yang lain yang masih diperlukan untuk rumah Allahmu, yang pembayarannya menjadi tanggunganmu, itu boleh kaubayar dari perbendaharaan kerajaan."
 },
 {
   "id": 12197,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 21,
   "firman": "Kemudian aku, raja Artahsasta, telah mengeluarkan perintah kepada semua bendahara di daerah seberang sungai Efrat, begini: segala yang diminta dari padamu oleh imam Ezra, ahli Taurat Allah semesta langit, haruslah dilaksanakan dengan seksama,"
 },
 {
   "id": 12198,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 22,
   "firman": "dengan memakai perak sampai jumlah seratus talenta, gandum sampai jumlah seratus kor, anggur sampai jumlah seratus bat, minyak sampai jumlah seratus bat, dan garam tidak terbatas."
 },
 {
   "id": 12199,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 23,
   "firman": "Segala sesuatu yang berdasarkan perintah Allah semesta langit, harus dilaksanakan dengan tekun untuk keperluan rumah Allah semesta langit, supaya jangan pemerintahan raja serta anak-anaknya kena murka."
 },
 {
   "id": 12200,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 24,
   "firman": "Lagipula kami beritahukan kepadamu, bahwa tidaklah sah bila para imam, orang Lewi, penyanyi, penunggu pintu gerbang, budak di bait Allah dan para hamba rumah Allah dikenakan pajak, upeti atau bea."
 },
 {
   "id": 12201,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 25,
   "firman": "Maka engkau, hai Ezra, angkatlah pemimpin-pemimpin dan hakim-hakim sesuai dengan hikmat Allahmu yang menjadi peganganmu, supaya mereka menghakimi seluruh rakyat yang diam di daerah seberang sungai Efrat, yakni semua orang yang mengetahui hukum Allahmu; dan orang yang belum mengetahuinya haruslah kauajar."
 },
 {
   "id": 12202,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 26,
   "firman": "Setiap orang, yang tidak melakukan hukum Allahmu dan hukum raja, harus dihukum dengan seksama, baik dengan hukuman mati, maupun dengan pembuangan, dengan hukuman denda atau hukuman penjara.\""
 },
 {
   "id": 12203,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 27,
   "firman": "Terpujilah TUHAN, Allah nenek moyang kita, yang dengan demikian menggerakkan hati raja, sehingga ia menyemarakkan rumah TUHAN yang ada di Yerusalem,"
 },
 {
   "id": 12204,
   "kitab": "Ezr",
   "pasal": 7,
   "ayat": 28,
   "firman": "dan membuat aku disenangi oleh raja dan penasihat-penasihatnya serta segala pembesar raja yang berkuasa! "
 },
 {
   "id": 12206,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 1,
   "firman": "Inilah kepala-kepala kaum keluarga dan silsilah orang-orang yang berangkat pulang bersama-sama aku dari Babel pada zaman pemerintahan raja Artahsasta:"
 },
 {
   "id": 12207,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 2,
   "firman": "dari bani Pinehas: Gersom; dari bani Itamar: Daniel; dari bani Daud: Hatus"
 },
 {
   "id": 12208,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 3,
   "firman": "bin Sekhanya; dari bani Paros: Zakharia, dan bersama-sama dia seratus lima puluh orang laki-laki tercatat di dalam silsilah;"
 },
 {
   "id": 12209,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 4,
   "firman": "dari bani Pahat-Moab: Elyoenai bin Zerahya, dan bersama-sama dia dua ratus orang laki-laki;"
 },
 {
   "id": 12210,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 5,
   "firman": "dari bani Zatu: Sekhanya bin Yahaziel, dan bersama-sama dia tiga ratus orang laki-laki;"
 },
 {
   "id": 12211,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 6,
   "firman": "dan dari bani Adin: Ebed bin Yonatan, dan bersama-sama dia lima puluh orang laki-laki;"
 },
 {
   "id": 12212,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 7,
   "firman": "dari bani Elam: Yesaya bin Atalya, dan bersama-sama dia tujuh puluh orang laki-laki;"
 },
 {
   "id": 12213,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 8,
   "firman": "dan dari bani Sefaca: Zebaja bin Mikhael, dan bersama-sama dia delapan puluh orang laki-laki;"
 },
 {
   "id": 12214,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 9,
   "firman": "dan dari bani Yoab: Obaja bin Yehiel, dan bersama-sama dia dua ratus delapan belas orang laki-laki;"
 },
 {
   "id": 12215,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 10,
   "firman": "dan dari bani Bani: Selomit bin Yosifya, dan bersama-sama dia seratus enam puluh orang laki-laki;"
 },
 {
   "id": 12216,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 11,
   "firman": "dan dari bani Bebai: Zakharia bin Bebai, dan bersama-sama dia dua puluh delapan orang laki-laki;"
 },
 {
   "id": 12217,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 12,
   "firman": "dan dari bani Azgad: Yohanan bin Hakatan, dan bersama-sama dia seratus sepuluh orang laki-laki;"
 },
 {
   "id": 12218,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 13,
   "firman": "dan dari bani Adonikam: yang datang kemudian, dan inilah nama mereka: Elifelet, Yehiel dan Semaya, dan bersama-sama mereka enam puluh orang laki-laki;"
 },
 {
   "id": 12219,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 14,
   "firman": "dan dari bani Bigwai: Utai dan Zabud dan bersama-sama dia tujuh puluh orang laki-laki."
 },
 {
   "id": 12220,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 15,
   "firman": "Aku menghimpunkan mereka dekat sungai yang mengalir ke Ahawa dan di sana kami berkemah tiga hari lamanya. Ketika kuselidiki mereka, ternyata ada orang-orang Israel awam dan imam-imam, tetapi tidak kudapati di antara mereka orang-orang dari bani Lewi."
 },
 {
   "id": 12221,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 16,
   "firman": "Sebab itu aku mengirim Eliezer, Ariel, Semaya, Elnatan, Yarib, Elnatan, Natan, Zakharia, Mesulam, yakni kepala-kepala kaum keluarga, dan Yoyarib dan Elnatan, yakni pengajar-pengajar,"
 },
 {
   "id": 12222,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 17,
   "firman": "dengan suatu pesan untuk Ido, kepala setempat di Kasifya. Aku menaruh perkataan-perkataan ke dalam mulut mereka untuk dikatakan kepada Ido dan saudara-saudaranya, para budak di bait Allah di Kasifya itu, supaya mereka mendatangkan kepada kami orang-orang yang harus menyelenggarakan kebaktian di rumah Allah kami."
 },
 {
   "id": 12223,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 18,
   "firman": "Kemudian karena tangan murah Allah kami itu melindungi kami, didatangkanlah oleh mereka kepada kami orang-orang yang berakal budi dari bani Mahli bin Lewi bin Israel, yakni Serebya dengan anak-anak dan saudara-saudaranya, delapan belas orang;"
 },
 {
   "id": 12224,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 19,
   "firman": "dan Hasabya beserta Yesaya, dari bani Merari, dan saudara-saudaranya dan anak-anak mereka, dua puluh orang;"
 },
 {
   "id": 12225,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 20,
   "firman": "dan dari para budak di bait Allah, yang diberikan Daud dan para pembesar untuk membantu pekerjaan orang-orang Lewi, dua ratus dua puluh orang, yang masing-masing ditunjuk dengan disebut namanya."
 },
 {
   "id": 12226,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 21,
   "firman": "Kemudian di sana, di tepi sungai Ahawa itu, aku memaklumkan puasa supaya kami merendahkan diri di hadapan Allah kami dan memohon kepada-Nya jalan yang aman bagi kami, bagi anak-anak kami dan segala harta benda kami."
 },
 {
   "id": 12227,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 22,
   "firman": "Karena aku malu meminta tentara dan orang-orang berkuda kepada raja untuk mengawal kami terhadap musuh di jalan; sebab kami telah berkata kepada raja, demikian: \"Tangan Allah kami melindungi semua orang yang mencari Dia demi keselamatan mereka, tetapi kuasa murka-Nya menimpa semua orang yang meninggalkan Dia.\""
 },
 {
   "id": 12228,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 23,
   "firman": "Jadi berpuasalah kami dan memohonkan hal itu kepada Allah dan Allah mengabulkan permohonan kami."
 },
 {
   "id": 12229,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 24,
   "firman": "Lalu aku memilih dua belas orang pemuka imam, yakni Serebya dan Hasabya, dan bersama-sama mereka sepuluh orang dari antara saudara-saudara mereka."
 },
 {
   "id": 12230,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 25,
   "firman": "Aku menimbang bagi mereka perak, emas, dan perlengkapan-perlengkapan, yakni persembahan-persembahan khusus bagi rumah Allah kami yang dikhususkan oleh raja serta penasihat-penasihatnya dan pembesar-pembesarnya dan semua orang Israel yang ada di sana."
 },
 {
   "id": 12231,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 26,
   "firman": "Pula aku menimbang untuk menyerahkan ke tangan mereka: perak enam ratus lima puluh talenta, perlengkapan perak seharga seratus talenta, emas seratus talenta,"
 },
 {
   "id": 12232,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 27,
   "firman": "dua puluh piala emas seharga seribu dirham dan dua buah perlengkapan dari pada tembaga murni yang mengkilat dan indah seperti emas."
 },
 {
   "id": 12233,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 28,
   "firman": "Dan aku berkata kepada mereka: \"Kamu kudus bagi TUHAN, dan perlengkapan-perlengkapan inipun kudus, dan perak dan emas ini adalah persembahan sukarela kepada TUHAN, Allah nenek moyangmu;"
 },
 {
   "id": 12234,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 29,
   "firman": "rawatlah dan jagalah itu sampai kamu dapat menimbangnya di depan para pemuka imam serta orang-orang Lewi dan para pemimpin kaum keluarga orang Israel di Yerusalem, di dalam bilik-bilik rumah TUHAN.\""
 },
 {
   "id": 12235,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 30,
   "firman": "Lalu para imam dan orang-orang Lewi menerima perak dan emas dan perlengkapan-perlengkapan yang telah ditimbang itu untuk dibawa ke Yerusalem, ke rumah Allah kami."
 },
 {
   "id": 12236,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 31,
   "firman": "Kemudian berangkatlah kami dari sungai Ahawa pergi ke Yerusalem pada tanggal dua belas bulan pertama untuk berjalan ke Yerusalem, dan tangan Allah kami melindungi kami dan menghindarkan kami dari tangan musuh dan penyamun."
 },
 {
   "id": 12237,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 32,
   "firman": "Maka tibalah kami di Yerusalem. Sesudah kami tinggal di sana selama tiga hari,"
 },
 {
   "id": 12238,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 33,
   "firman": "maka pada hari yang keempat ditimbanglah perak dan emas dan perlengkapan-perlengkapan itu di dalam rumah Allah kami di bawah pengawasan imam Meremot bin Uria, yang didampingi oleh Eleazar bin Pinehas, dan mereka dibantu oleh Yozabad bin Yesua dan Noaja bin Binui, orang-orang Lewi."
 },
 {
   "id": 12239,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 34,
   "firman": "Semuanya dihitung dan ditimbang kembali, dan jumlah timbangannya dibukukan."
 },
 {
   "id": 12240,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 35,
   "firman": "Pada waktu itu juga orang-orang yang telah kembali dari penawanan, yakni mereka yang pulang dari pembuangan, mempersembahkan sebagai korban bakaran kepada Allah Israel: lembu jantan dua belas ekor untuk seluruh Israel, domba jantan sembilan puluh enam ekor, anak domba tujuh puluh tujuh ekor, kambing jantan sebagai korban penghapus dosa dua belas ekor, semuanya itu sebagai korban bakaran bagi TUHAN."
 },
 {
   "id": 12241,
   "kitab": "Ezr",
   "pasal": 8,
   "ayat": 36,
   "firman": "Mereka menyampaikan juga surat perintah raja kepada wakil-wakil raja dan bupati-bupati daerah sebelah barat sungai Efrat, dan orang-orang itu memberi sokongan kepada bangsa kita dan kepada rumah Allah."
 },
 {
   "id": 12242,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 1,
   "firman": "Sesudah semuanya itu terlaksana datanglah para pemuka mendekati aku dan berkata: \"Orang-orang Israel awam, para imam dan orang-orang Lewi tidak memisahkan diri dari penduduk negeri dengan segala kekejiannya, yakni dari orang Kanaan, orang Het, orang Feris, orang Yebus, orang Amon, orang Moab, orang Mesir dan orang Amori."
 },
 {
   "id": 12243,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 2,
   "firman": "Karena mereka telah mengambil isteri dari antara anak perempuan orang-orang itu untuk diri sendiri dan untuk anak-anak mereka, sehingga bercampurlah benih yang kudus dengan penduduk negeri, bahkan para pemuka dan penguasalah yang lebih dahulu melakukan perbuatan tidak setia itu.\""
 },
 {
   "id": 12244,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 3,
   "firman": "Ketika aku mendengar perkataan itu, maka aku mengoyakkan pakaianku dan jubahku dan aku mencabut rambut kepalaku dan janggutku dan duduklah aku tertegun."
 },
 {
   "id": 12245,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 4,
   "firman": "Lalu berkumpullah kepadaku semua orang yang gemetar karena firman Allah Israel, oleh sebab perbuatan tidak setia orang-orang buangan itu, tetapi aku tetap duduk tertegun sampai korban petang."
 },
 {
   "id": 12246,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 5,
   "firman": "Pada waktu korban petang bangkitlah aku dan berhenti menyiksa diriku, lalu aku berlutut dengan pakaianku dan jubahku yang koyak-koyak sambil menadahkan tanganku kepada TUHAN, Allahku,"
 },
 {
   "id": 12247,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 6,
   "firman": "dan kataku: \"Ya Allahku, aku malu dan mendapat cela, sehingga tidak berani menengadahkan mukaku kepada-Mu, ya Allahku, karena dosa kami telah menumpuk mengatasi kepala kami dan kesalahan kami telah membubung ke langit."
 },
 {
   "id": 12248,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 7,
   "firman": "Dari zaman nenek moyang kami sampai hari ini kesalahan kami besar, dan oleh karena dosa kami maka kami sekalian dengan raja-raja dan imam-imam kami diserahkan ke dalam tangan raja-raja negeri, ke dalam kuasa pedang, ke dalam penawanan dan penjarahan, dan penghinaan di depan umum, seperti yang terjadi sekarang ini."
 },
 {
   "id": 12249,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dan sekarang, baru saja kami alami kasih karunia dari pada TUHAN, Allah kami yang meninggalkan pada kami orang-orang yang terluput, dan memberi kami tempat menetap di tempat-Nya yang kudus, sehingga Allah kami membuat mata kami bercahaya dan memberi kami sedikit kelegaan di dalam perbudakan kami."
 },
 {
   "id": 12250,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 9,
   "firman": "Karena sungguhpun kami menjadi budak, tetapi di dalam perbudakan itu kami tidak ditinggalkan Allah kami. Ia membuat kami disayangi oleh raja-raja negeri Persia, sehingga kami mendapat kelegaan untuk membangun rumah Allah kami dan menegakkan kembali reruntuhannya, dan diberi tembok pelindung di Yehuda dan di Yerusalem."
 },
 {
   "id": 12251,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 10,
   "firman": "Tetapi sekarang, ya Allah kami, apa yang akan kami katakan sesudah semuanya itu? Karena kami telah meninggalkan perintah-Mu,"
 },
 {
   "id": 12252,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 11,
   "firman": "yang Kauperintahkan dengan perantaraan hamba-hamba-Mu, para nabi itu, dengan berfirman: Negeri yang kamu masuki untuk diduduki adalah negeri yang cemar oleh karena kecemaran penduduk negeri, yakni oleh karena kekejian yang mereka lakukan dengan segala kenajisan mereka di segenap negeri itu dari ujung ke ujung."
 },
 {
   "id": 12253,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 12,
   "firman": "Jadi sekarang janganlah kamu memberikan anak-anak perempuanmu kepada anak lelaki mereka, ataupun mengambil anak-anak perempuan mereka untuk anak-anak lelakimu. Janganlah kamu mengikhtiarkan kesejahteraan dan kebahagiaan mereka untuk selama-lamanya, supaya kamu menjadi kuat, mengecap hasil tanah yang baik, dan mewariskan tanah itu kepada anak-anakmu untuk selama-lamanya."
 },
 {
   "id": 12254,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 13,
   "firman": "Sesudah semua yang kami alami oleh sebab perbuatan kami yang jahat, dan oleh sebab kesalahan kami yang besar, sedangkan Engkau, ya Allah kami, tidak menghukum setimpal dengan dosa kami, dan masih mengaruniakan kepada kami orang-orang yang terluput sebanyak ini,"
 },
 {
   "id": 12255,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 14,
   "firman": "masakan kami kembali melanggar perintah-Mu dan kawin-mengawin dengan bangsa-bangsa yang keji ini? Tidakkah Engkau akan murka kepada kami sampai kami habis binasa, sehingga tidak ada yang tinggal hidup atau terluput?"
 },
 {
   "id": 12256,
   "kitab": "Ezr",
   "pasal": 9,
   "ayat": 15,
   "firman": "Ya TUHAN, Allah Israel, Engkau maha benar, sebab kami masih dibiarkan tinggal sebagai orang-orang yang terluput, seperti yang terjadi sekarang ini. Lihatlah, kami menghadap hadirat-Mu dengan kesalahan kami. Bahwasanya, dalam keadaan demikian tidak mungkin orang tahan berdiri di hadapan-Mu.\""
 },
 {
   "id": 12257,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 1,
   "firman": "Sementara Ezra berdoa dan mengaku dosa, sambil menangis dengan bersujud di depan rumah Allah, berhimpunlah kepadanya jemaah orang Israel yang sangat besar jumlahnya, laki-laki, perempuan dan anak-anak. Orang-orang itu menangis keras-keras."
 },
 {
   "id": 12258,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 2,
   "firman": "Maka berbicaralah Sekhanya bin Yehiel, dari bani Elam, katanya kepada Ezra: \"Kami telah melakukan perbuatan tidak setia terhadap Allah kita, oleh karena kami telah memperisteri perempuan asing dari antara penduduk negeri. Namun demikian sekarang juga masih ada harapan bagi Israel."
 },
 {
   "id": 12259,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 3,
   "firman": "Marilah kita sekarang mengikat perjanjian dengan Allah kita, bahwa kita akan mengusir semua perempuan itu dengan anak-anak yang dilahirkan mereka, menurut nasihat tuan dan orang-orang yang gemetar karena perintah Allah kita. Dan biarlah orang bertindak menurut hukum Taurat."
 },
 {
   "id": 12260,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 4,
   "firman": "Bangkitlah, karena hal itu adalah tugasmu. Kami akan mendampingi engkau. Kuatkanlah hatimu, dan bertindaklah!\""
 },
 {
   "id": 12261,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 5,
   "firman": "Kemudian bangkitlah Ezra dan menyuruh para pemuka imam dan orang-orang Lewi dan segenap orang Israel bersumpah, bahwa mereka akan berbuat menurut perkataan itu, maka bersumpahlah mereka."
 },
 {
   "id": 12262,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 6,
   "firman": "Sesudah itu Ezra pergi dari depan rumah Allah menuju bilik Yohanan bin Elyasib, dan di sana ia bermalam dengan tidak makan roti dan minum air, sebab ia berkabung karena orang-orang buangan itu telah melakukan perbuatan tidak setia."
 },
 {
   "id": 12263,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 7,
   "firman": "Lalu disiarkanlah pengumuman di Yehuda dan di Yerusalem kepada semua orang yang pulang dari pembuangan untuk berhimpun di Yerusalem."
 },
 {
   "id": 12264,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 8,
   "firman": "Barangsiapa dalam tiga hari tidak datang, maka menurut keputusan para pemimpin dan tua-tua segala hartanya akan disita dan ia akan dikucilkan dari jemaah yang pulang dari pembuangan."
 },
 {
   "id": 12265,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 9,
   "firman": "Lalu berhimpunlah semua orang laki-laki Yehuda dan Benyamin di Yerusalem dalam tiga hari itu, yakni dalam bulan kesembilan pada tanggal dua puluh bulan itu. Seluruh rakyat duduk di halaman rumah Allah, sambil menggigil karena perkara itu dan karena hujan lebat."
 },
 {
   "id": 12266,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 10,
   "firman": "Maka bangkitlah imam Ezra, lalu berkata kepada mereka: \"Kamu telah melakukan perbuatan tidak setia, karena kamu memperisteri perempuan asing dan dengan demikian menambah kesalahan orang Israel."
 },
 {
   "id": 12267,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 11,
   "firman": "Tetapi sekarang mengakulah di hadapan TUHAN, Allah nenek moyangmu, dan lakukanlah apa yang berkenan kepada-Nya dan pisahkanlah dirimu dari penduduk negeri dan perempuan-perempuan asing itu!\""
 },
 {
   "id": 12268,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lalu seluruh jemaah menjawab dan berseru dengan suara nyaring: \"Sesungguhnya, adalah kewajiban kami melakukan seperti katamu itu."
 },
 {
   "id": 12269,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 13,
   "firman": "Tetapi orang-orang ini besar jumlahnya dan sekarang musim hujan, sehingga orang tidak sanggup lagi berdiri di luar. Lagipula pekerjaan itu bukan perkara sehari dua hari, karena dalam hal itu kami telah banyak melakukan pelanggaran."
 },
 {
   "id": 12270,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 14,
   "firman": "Biarlah pemimpin-pemimpin kami bertindak mewakili jemaah seluruhnya, maka setiap orang di kota-kota kami yang memperisteri perempuan asing harus datang menghadap pada waktu-waktu tertentu, dan bersama-sama mereka para tua-tua dan para hakim di tiap-tiap kota, sampai murka Allah kami yang bernyala-nyala karena perkara ini dijauhkan dari kami.\""
 },
 {
   "id": 12271,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 15,
   "firman": "Hanya Yonatan bin Asael, dan Yahzeya bin Tikwa, berdiri menentang perkara itu, disokong oleh Mesulam dan Sabetai, orang Lewi itu."
 },
 {
   "id": 12272,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 16,
   "firman": "Tetapi mereka yang pulang dari pembuangan melakukannya. Maka imam Ezra memilih beberapa orang, kepala-kepala kaum keluarga, masing-masing untuk kaum keluarganya, semuanya dengan namanya disebut. Pada hari pertama bulan kesepuluh mereka bersidang untuk menyelidiki perkara itu,"
 },
 {
   "id": 12273,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 17,
   "firman": "dan mereka menyelesaikan segala urusan mengenai orang yang memperisteri perempuan asing itu pada hari pertama bulan pertama."
 },
 {
   "id": 12274,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 18,
   "firman": "Di antara kaum imam yang memperisteri perempuan asing terdapat: dari bani Yesua bin Yozadak, dengan saudara-saudaranya: Maaseya, Eliezer, Yarib dan Gedalya."
 },
 {
   "id": 12275,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 19,
   "firman": "Dengan memegang tangan, mereka itu berjanji akan mengusir isteri mereka. Dan mereka mempersembahkan seekor domba jantan dari kawanan kambing domba sebagai korban penebus salah karena kesalahan mereka."
 },
 {
   "id": 12276,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 20,
   "firman": "Dari bani Imer: Hanani dan Zebaja;"
 },
 {
   "id": 12277,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 21,
   "firman": "dari bani Harim: Maaseya, Elia, Semaya, Yehiel dan Uzia;"
 },
 {
   "id": 12278,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 22,
   "firman": "dan dari bani Pasyhur: Elyoenai, Maaseya, Ismael, Netaneel, Yozabad dan Elasa."
 },
 {
   "id": 12279,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 23,
   "firman": "Dari orang-orang Lewi: Yozabad, Simei, Kelaya (yakni Kelita), Petahya, Yuda dan Eliezer."
 },
 {
   "id": 12280,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 24,
   "firman": "Dari para penyanyi: Elyasib. Dari para penunggu pintu gerbang: Salum, Telem dan Uri."
 },
 {
   "id": 12281,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 25,
   "firman": "Dari orang-orang Israel yang lain: dari bani Paros: Ramya, Yezia, Malkia, Miyamin, Eleazar, Malkia dan Benaya."
 },
 {
   "id": 12282,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 26,
   "firman": "Dari bani Elam: Matanya, Zakharia, Yehiel, Abdi, Yeremot dan Elia."
 },
 {
   "id": 12283,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 27,
   "firman": "Dari bani Zatu: Elyoenai, Elyasib, Matanya, Yeremot, Zabad dan Aziza."
 },
 {
   "id": 12284,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 28,
   "firman": "Dari bani Bebai: Yohanan, Hananya, Zabai dan Altai."
 },
 {
   "id": 12285,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 29,
   "firman": "Dari bani Bani: Mesulam, Malukh, Adaya, Yasub, Seal dan Yeramot."
 },
 {
   "id": 12286,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 30,
   "firman": "Dari bani Pahat-Moab: Adna dan Kelal, Benaya, Maaseya, Matania, Bezaleel, Binui dan Manasye."
 },
 {
   "id": 12287,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 31,
   "firman": "Dari bani Harim: Eliezer, Yisia, Malkia, Semaya, Simeon,"
 },
 {
   "id": 12288,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 32,
   "firman": "Benyamin, Malukh, dan Semarya."
 },
 {
   "id": 12289,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 33,
   "firman": "Dari bani Hasum: Matnai, Matata, Zabad, Elifelet, Yeremai, Manasye dan Simei."
 },
 {
   "id": 12290,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 34,
   "firman": "Dari bani Bani: Maadai, Amram, Uel,"
 },
 {
   "id": 12291,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 35,
   "firman": "Benaya, Bedeya, Keluhu,"
 },
 {
   "id": 12292,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 36,
   "firman": "Wanya, Meremot, Elyasib,"
 },
 {
   "id": 12293,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 37,
   "firman": "Matanya, Matnai, Yaasai."
 },
 {
   "id": 12294,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 38,
   "firman": "Dari bani Binui: Simei,"
 },
 {
   "id": 12295,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 39,
   "firman": "Selemya, Natan, Adaya,"
 },
 {
   "id": 12296,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 40,
   "firman": "Makhnadbai, Sasai, Sarai,"
 },
 {
   "id": 12297,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 41,
   "firman": "Azareel, Selemya, Semarya,"
 },
 {
   "id": 12298,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 42,
   "firman": "Salum, Amarya dan Yusuf."
 },
 {
   "id": 12299,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 43,
   "firman": "Dari bani Nebo: Yeiel, Matica, Zabad, Zebina, Yadai, Yoel dan Benaya."
 },
 {
   "id": 12300,
   "kitab": "Ezr",
   "pasal": 10,
   "ayat": 44,
   "firman": "Mereka sekalian mengambil sebagai isteri perempuan asing; maka mereka menyuruh pergi isteri-isteri itu dengan anak-anaknya."
 },
 {
   "id": 12301,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 1,
   "firman": "Riwayat Nehemia bin Hakhalya. Pada bulan Kislew tahun kedua puluh, ketika aku ada di puri Susan,"
 },
 {
   "id": 12302,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 2,
   "firman": "datanglah Hanani, salah seorang dari saudara-saudaraku dengan beberapa orang dari Yehuda. Aku menanyakan mereka tentang orang-orang Yahudi yang terluput, yang terhindar dari penawanan dan tentang Yerusalem."
 },
 {
   "id": 12303,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kata mereka kepadaku: \"Orang-orang yang masih tinggal di daerah sana, yang terhindar dari penawanan, ada dalam kesukaran besar dan dalam keadaan tercela. Tembok Yerusalem telah terbongkar dan pintu-pintu gerbangnya telah terbakar.\""
 },
 {
   "id": 12304,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 4,
   "firman": "Ketika kudengar berita ini, duduklah aku menangis dan berkabung selama beberapa hari. Aku berpuasa dan berdoa ke hadirat Allah semesta langit,"
 },
 {
   "id": 12305,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 5,
   "firman": "kataku: \"Ya, TUHAN, Allah semesta langit, Allah yang maha besar dan dahsyat, yang berpegang pada perjanjian dan kasih setia-Nya terhadap orang yang kasih kepada-Nya dan tetap mengikuti perintah-perintah-Nya,"
 },
 {
   "id": 12306,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 6,
   "firman": "berilah telinga-Mu dan bukalah mata-Mu dan dengarkanlah doa hamba-Mu yang sekarang kupanjatkan ke hadirat-Mu siang dan malam bagi orang Israel, hamba-hamba-Mu itu, dengan mengaku segala dosa yang kami orang Israel telah lakukan terhadap-Mu. Juga aku dan kaum keluargaku telah berbuat dosa."
 },
 {
   "id": 12307,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 7,
   "firman": "Kami telah sangat bersalah terhadap-Mu dan tidak mengikuti perintah-perintah, ketetapan-ketetapan dan peraturan-peraturan yang telah Kauperintahkan kepada Musa, hamba-Mu itu."
 },
 {
   "id": 12308,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 8,
   "firman": "Ingatlah akan firman yang Kaupesan kepada Musa, hamba-Mu itu, yakni: Bila kamu berubah setia, kamu akan Kucerai-beraikan di antara bangsa-bangsa."
 },
 {
   "id": 12309,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 9,
   "firman": "Tetapi, bila kamu berbalik kepada-Ku dan tetap mengikuti perintah-perintah-Ku serta melakukannya, maka sekalipun orang-orang buanganmu ada di ujung langit, akan Kukumpulkan mereka kembali dan Kubawa ke tempat yang telah Kupilih untuk membuat nama-Ku diam di sana."
 },
 {
   "id": 12310,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 10,
   "firman": "Bukankah mereka ini hamba-hamba-Mu dan umat-Mu yang telah Kaubebaskan dengan kekuatan-Mu yang besar dan dengan tangan-Mu yang kuat?"
 },
 {
   "id": 12311,
   "kitab": "Neh",
   "pasal": 1,
   "ayat": 11,
   "firman": "Ya, Tuhan, berilah telinga kepada doa hamba-Mu ini dan kepada doa hamba-hamba-Mu yang rela takut akan nama-Mu, dan biarlah hamba-Mu berhasil hari ini dan mendapat belas kasihan dari orang ini.\" Ketika itu aku ini juru minuman raja."
 },
 {
   "id": 12312,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pada bulan Nisan tahun kedua puluh pemerintahan raja Artahsasta, ketika menjadi tugasku untuk menyediakan anggur, aku mengangkat anggur dan menyampaikannya kepada raja. Karena aku kelihatan sedih, yang memang belum pernah terjadi di hadapan raja,"
 },
 {
   "id": 12313,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 2,
   "firman": "bertanyalah ia kepadaku: \"Mengapa mukamu muram, walaupun engkau tidak sakit? Engkau tentu sedih hati.\" Lalu aku menjadi sangat takut."
 },
 {
   "id": 12314,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 3,
   "firman": "Jawabku kepada raja: \"Hiduplah raja untuk selamanya! Bagaimana mukaku tidak akan muram, kalau kota, tempat pekuburan nenek moyangku, telah menjadi reruntuhan dan pintu-pintu gerbangnya habis dimakan api?\""
 },
 {
   "id": 12315,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 4,
   "firman": "Lalu kata raja kepadaku: \"Jadi, apa yang kauinginkan?\" Maka aku berdoa kepada Allah semesta langit,"
 },
 {
   "id": 12316,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 5,
   "firman": "kemudian jawabku kepada raja: \"Jika raja menganggap baik dan berkenan kepada hambamu ini, utuslah aku ke Yehuda, ke kota pekuburan nenek moyangku, supaya aku membangunnya kembali.\""
 },
 {
   "id": 12317,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 6,
   "firman": "Lalu bertanyalah raja kepadaku, sedang permaisuri duduk di sampingnya: \"Berapa lama engkau dalam perjalanan, dan bilakah engkau kembali?\" Dan raja berkenan mengutus aku, sesudah aku menyebut suatu jangka waktu kepadanya."
 },
 {
   "id": 12318,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 7,
   "firman": "Berkatalah aku kepada raja: \"Jika raja menganggap baik, berikanlah aku surat-surat bagi bupati-bupati di daerah seberang sungai Efrat, supaya mereka memperbolehkan aku lalu sampai aku tiba di Yehuda."
 },
 {
   "id": 12319,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 8,
   "firman": "Pula sepucuk surat bagi Asaf, pengawas taman raja, supaya dia memberikan aku kayu untuk memasang balok-balok pada pintu-pintu gerbang di benteng bait suci, untuk tembok kota dan untuk rumah yang akan kudiami.\" Dan raja mengabulkan permintaanku itu, karena tangan Allahku yang murah melindungi aku."
 },
 {
   "id": 12320,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka datanglah aku kepada bupati-bupati di daerah seberang sungai Efrat dan menyerahkan kepada mereka surat-surat raja. Dan raja menyuruh panglima-panglima perang dan orang-orang berkuda menyertai aku."
 },
 {
   "id": 12321,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ketika Sanbalat, orang Horon, dan Tobia, orang Amon, pelayan itu, mendengar hal itu, mereka sangat kesal karena ada orang yang datang mengusahakan kesejahteraan orang Israel."
 },
 {
   "id": 12322,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 11,
   "firman": "Maka tibalah aku di Yerusalem. Sesudah tiga hari aku di sana,"
 },
 {
   "id": 12323,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 12,
   "firman": "bangunlah aku pada malam hari bersama-sama beberapa orang saja yang menyertai aku. Aku tidak beritahukan kepada siapapun rencana yang akan kulakukan untuk Yerusalem, yang diberikan Allahku dalam hatiku. Juga tak ada lain binatang kepadaku kecuali yang kutunggangi."
 },
 {
   "id": 12324,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 13,
   "firman": "Demikian pada malam hari aku keluar melalui pintu gerbang Lebak, ke jurusan mata air Ular Naga dan pintu gerbang Sampah. Aku menyelidiki dengan seksama tembok-tembok Yerusalem yang telah terbongkar dan pintu-pintu gerbangnya yang habis dimakan api."
 },
 {
   "id": 12325,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lalu aku meneruskan perjalananku ke pintu gerbang Mata Air dan ke kolam Raja. Karena binatang yang kutunggangi tidak dapat lalu di tempat itu,"
 },
 {
   "id": 12326,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 15,
   "firman": "aku naik ke atas melalui wadi pada malam hari dan menyelidiki dengan seksama tembok itu. Kemudian aku kembali, lalu masuk melalui pintu gerbang Lebak. Demikianlah aku pulang."
 },
 {
   "id": 12327,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 16,
   "firman": "Para penguasa tidak tahu ke mana aku telah pergi dan apa yang telah kulakukan, karena sampai kini aku belum memberitahukan apa-apa kepada orang Yahudi, baik kepada para imam, maupun kepada para pemuka, kepada para penguasa dan para petugas lainnya."
 },
 {
   "id": 12328,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 17,
   "firman": "Berkatalah aku kepada mereka: \"Kamu lihat kemalangan yang kita alami, yakni Yerusalem telah menjadi reruntuhan dan pintu-pintu gerbangnya telah terbakar. Mari, kita bangun kembali tembok Yerusalem, supaya kita tidak lagi dicela.\""
 },
 {
   "id": 12329,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 18,
   "firman": "Ketika kuberitahukan kepada mereka, betapa murahnya tangan Allahku yang melindungi aku dan juga apa yang dikatakan raja kepadaku, berkatalah mereka: \"Kami siap untuk membangun!\" Dan dengan sekuat tenaga mereka mulai melakukan pekerjaan yang baik itu."
 },
 {
   "id": 12330,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 19,
   "firman": "Ketika Sanbalat, orang Horon, dan Tobia, orang Amon, pelayan itu, dan Gesyem, orang Arab, mendengar itu, mereka mengolok-olokkan dan menghina kami. Kata mereka: \"Apa yang kamu lakukan itu? Apa kamu mau berontak terhadap raja?\""
 },
 {
   "id": 12331,
   "kitab": "Neh",
   "pasal": 2,
   "ayat": 20,
   "firman": "Aku menjawab mereka, kataku: \"Allah semesta langit, Dialah yang membuat kami berhasil! Kami, hamba-hamba-Nya, telah siap untuk membangun. Tetapi kamu tak punya bagian atau hak dan tidak akan diingat di Yerusalem!\""
 },
 {
   "id": 12332,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 1,
   "firman": "Maka bersiaplah imam besar Elyasib dan para imam, saudara-saudaranya, lalu membangun kembali pintu gerbang Domba. Mereka mentahbiskannya dan memasang pintu-pintunya. Mereka mentahbiskannya sampai menara Mea, menara Hananeel."
 },
 {
   "id": 12333,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 2,
   "firman": "Berdekatan dengan mereka orang-orang Yerikho membangun, dan berdekatan dengan orang-orang itu Zakur bin Imri."
 },
 {
   "id": 12334,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 3,
   "firman": "Pintu gerbang Ikan dibangun oleh bani Senaa. Mereka memasang balok-balok lalu memasang pintu-pintunya dengan pengancing-pengancing dan palang-palangnya."
 },
 {
   "id": 12335,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 4,
   "firman": "Berdekatan dengan mereka Meremot bin Uria bin Hakos mengadakan perbaikan, dan berdekatan dengan dia Mesulam bin Berekhya bin Mesezabeel. Berdekatan dengan dia Zadok bin Baana mengadakan perbaikan,"
 },
 {
   "id": 12336,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 5,
   "firman": "dan berdekatan dengan dia orang-orang Tekoa. Hanya pemuka-pemuka mereka tidak mau memberi bahunya untuk pekerjaan tuan mereka."
 },
 {
   "id": 12337,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 6,
   "firman": "Pintu gerbang Lama diperbaiki oleh Yoyada bin Paseah dan Mesulam bin Besoja. Mereka memasang balok-balok lalu memasang pintu-pintunya dengan pengancing-pengancing dan palang-palangnya."
 },
 {
   "id": 12338,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 7,
   "firman": "Berdekatan dengan mereka Melaca, orang Gibeon, dan Yadon, orang Meronot, mengadakan perbaikan beserta orang-orang Gibeon dan Mizpa, yang berada di wilayah kekuasaan bupati daerah sebelah barat sungai Efrat."
 },
 {
   "id": 12339,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 8,
   "firman": "Berdekatan dengan mereka Uziel bin Harhaya, salah seorang tukang emas, mengadakan perbaikan, dan berdekatan dengan dia Hananya, seorang juru campur rempah-rempah. Mereka memperkokoh Yerusalem sampai tembok Lebar."
 },
 {
   "id": 12340,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 9,
   "firman": "Berdekatan dengan mereka Refaya bin Hur, penguasa setengah wilayah Yerusalem yang satu mengadakan perbaikan."
 },
 {
   "id": 12341,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 10,
   "firman": "Berdekatan dengan dia Yedaya bin Harumaf mengadakan perbaikan, tepat di depan rumahnya, dan berdekatan dengan dia Hatus bin Hasabneya."
 },
 {
   "id": 12342,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 11,
   "firman": "Malkia bin Harim dan Hasub bin Pahat-Moab memperbaiki bagian yang lain dan menara Perapian."
 },
 {
   "id": 12343,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 12,
   "firman": "Berdekatan dengan mereka Salum bin Halohesh, penguasa setengah wilayah Yerusalem yang lain mengadakan perbaikan bersama-sama anak-anak perempuannya."
 },
 {
   "id": 12344,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 13,
   "firman": "Pintu gerbang Lebak diperbaiki oleh Hanun dan penduduk Zanoah. Mereka membangunnya kembali dan memasang pintu-pintunya dengan pengancing-pengancing dan palang-palangnya. Pula tembok diperbaiki sepanjang seribu hasta sampai pada pintu gerbang Sampah."
 },
 {
   "id": 12345,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 14,
   "firman": "Pintu gerbang Sampah diperbaiki oleh Malkia bin Rekhab, penguasa wilayah Bet-Kerem. Ia membangunnya kembali dan memasang pintu-pintunya dengan pengancing-pengancing dan palang-palangnya."
 },
 {
   "id": 12346,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 15,
   "firman": "Pintu gerbang Mata Air diperbaiki oleh Salum bin Kolhoze, penguasa wilayah Mizpa. Pintu gerbang itu dibangunnya kembali, diberinya atap dan dipasangnya pintu-pintunya dengan pengancing-pengancing dan palang-palangnya. Juga diperbaikinya tembok kolam penampung air saluran, dekat taman raja sampai pada tangga-tangga yang menurun dari kota Daud."
 },
 {
   "id": 12347,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 16,
   "firman": "Di sampingnya Nehemia bin Azbuk, penguasa setengah wilayah Bet-Zur, mengadakan perbaikan sampai di depan pekuburan Daud dan sampai pada kolam buatan dan rumah para pahlawan."
 },
 {
   "id": 12348,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 17,
   "firman": "Di sampingnya orang-orang Lewi mengadakan perbaikan, yakni Rehum bin Bani, dan berdekatan dengan dia Hasabya, penguasa setengah wilayah Kehila yang satu, untuk wilayahnya."
 },
 {
   "id": 12349,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 18,
   "firman": "Di sampingnya saudara-saudara mereka, yakni Binui bin Henadad, penguasa setengah wilayah Kehila yang lain, mengadakan perbaikan."
 },
 {
   "id": 12350,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 19,
   "firman": "Berdekatan dengan dia Ezer bin Yesua, penguasa Mizpa, memperbaiki bagian yang berikut, di depan pendakian ke gudang senjata, dekat Sudut."
 },
 {
   "id": 12351,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 20,
   "firman": "Di sampingnya Barukh bin Zabai memperbaiki bagian yang berikut, dari Sudut sampai pada pintu masuk rumah imam besar Elyasib."
 },
 {
   "id": 12352,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 21,
   "firman": "Di sampingnya Meremot bin Uria bin Hakos memperbaiki bagian yang berikut, dari pintu masuk rumah Elyasib sampai pada ujung rumah Elyasib."
 },
 {
   "id": 12353,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 22,
   "firman": "Di sampingnya para imam, orang-orang dari Lembah Yordan, mengadakan perbaikan."
 },
 {
   "id": 12354,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 23,
   "firman": "Di samping mereka Benyamin dan Hasub mengadakan perbaikan di depan rumah mereka. Di samping mereka Azarya bin Maaseya bin Ananya mengadakan perbaikan di samping rumahnya."
 },
 {
   "id": 12355,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 24,
   "firman": "Di sampingnya Binui bin Henadad memperbaiki bagian yang berikut, dari rumah Azarya sampai Sudut dan sampai Penjuru."
 },
 {
   "id": 12356,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 25,
   "firman": "Palal bin Uzai mengadakan perbaikan di depan Sudut dan di depan menara yang tinggi yang menonjol dari istana raja, dekat pelataran penjagaan. Di sampingnya Pedaya bin Paros mengadakan perbaikan"
 },
 {
   "id": 12357,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 26,
   "firman": "sampai di depan pintu gerbang Air, di sebelah timur, dan di depan menara yang menonjol. Adapun para budak di bait Allah tinggal di Ofel."
 },
 {
   "id": 12358,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 27,
   "firman": "Di samping Pedaya orang-orang Tekoa memperbaiki bagian yang berikut, dari depan menara besar yang menonjol itu sampai tembok Ofel."
 },
 {
   "id": 12359,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 28,
   "firman": "Mulai dari pintu gerbang Kuda para imam mengadakan perbaikan, masing-masing di depan rumahnya."
 },
 {
   "id": 12360,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 29,
   "firman": "Di samping mereka Zadok bin Imer mengadakan perbaikan di depan rumahnya. Di sampingnya Semaya bin Sekhanya, penjaga pintu gerbang Timur."
 },
 {
   "id": 12361,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 30,
   "firman": "Di sampingnya Hananya bin Selemya dan Hanun, anak Zalaf yang keenam, memperbaiki bagian yang berikut. Di samping mereka Mesulam bin Berekhya mengadakan perbaikan di depan biliknya."
 },
 {
   "id": 12362,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 31,
   "firman": "Di sampingnya Malkia, seorang tukang emas, mengadakan perbaikan sampai pada rumah para budak di bait Allah dan para pedagang, di depan pintu gerbang Pendaftaran dan sampai pada kamar atas di penjuru."
 },
 {
   "id": 12363,
   "kitab": "Neh",
   "pasal": 3,
   "ayat": 32,
   "firman": "Lalu antara kamar atas di penjuru dan pintu gerbang Domba para tukang emas dan para pedagang mengadakan perbaikan."
 },
 {
   "id": 12364,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ketika Sanbalat mendengar, bahwa kami sedang membangun kembali tembok, bangkitlah amarahnya dan ia sangat sakit hati. Ia mengolok-olokkan orang Yahudi"
 },
 {
   "id": 12365,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 2,
   "firman": "dan berkata di hadapan saudara-saudaranya dan tentara Samaria: \"Apa gerangan yang dilakukan orang-orang Yahudi yang lemah ini? Apakah mereka memperkokoh sesuatu? Apakah mereka hendak membawa persembahan? Apakah mereka akan selesai dalam sehari? Apakah mereka akan menghidupkan kembali batu-batu dari timbunan puing yang sudah terbakar habis seperti ini?\""
 },
 {
   "id": 12366,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu berkatalah Tobia, orang Amon itu, yang ada di dekatnya: \"Sekalipun mereka membangun kembali, kalau seekor anjing hutan meloncat dan menyentuhnya, robohlah tembok batu mereka.\""
 },
 {
   "id": 12367,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 4,
   "firman": "Ya, Allah kami, dengarlah bagaimana kami dihina. Balikkanlah cercaan mereka menimpa kepala mereka sendiri dan serahkanlah mereka menjadi jarahan di tanah tempat tawanan."
 },
 {
   "id": 12368,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 5,
   "firman": "Jangan Kaututupi kesalahan mereka, dan dosa mereka jangan Kauhapus dari hadapan-Mu, karena mereka menyakiti hati-Mu dengan sikap mereka terhadap orang-orang yang sedang membangun."
 },
 {
   "id": 12369,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 6,
   "firman": "Tetapi kami terus membangun tembok sampai setengah tinggi dan sampai ujung-ujungnya bertemu, karena seluruh bangsa bekerja dengan segenap hati."
 },
 {
   "id": 12370,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 7,
   "firman": "Ketika Sanbalat dan Tobia serta orang Arab dan orang Amon dan orang Asdod mendengar, bahwa pekerjaan perbaikan tembok Yerusalem maju dan bahwa lobang-lobang tembok mulai tertutup, maka sangat marahlah mereka."
 },
 {
   "id": 12371,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 8,
   "firman": "Mereka semua mengadakan persepakatan bersama untuk memerangi Yerusalem dan mengadakan kekacauan di sana."
 },
 {
   "id": 12372,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tetapi kami berdoa kepada Allah kami, dan mengadakan penjagaan terhadap mereka siang dan malam karena sikap mereka."
 },
 {
   "id": 12373,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 10,
   "firman": "Berkatalah orang Yehuda: \"Kekuatan para pengangkat sudah merosot dan puing masih sangat banyak. Tak sanggup kami membangun kembali tembok ini.\""
 },
 {
   "id": 12374,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 11,
   "firman": "Tetapi lawan-lawan kami berpikir: \"Mereka tidak akan tahu dan tidak akan melihat apa-apa, sampai kita ada di antara mereka, membunuh mereka dan menghentikan pekerjaan itu.\""
 },
 {
   "id": 12375,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 12,
   "firman": "Ketika orang-orang Yahudi yang tinggal dekat mereka sudah sepuluh kali datang memperingatkan kami: \"Mereka akan menyerang kita dari segala tempat tinggal mereka,\""
 },
 {
   "id": 12376,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 13,
   "firman": "maka aku tempatkan rakyat menurut kaum keluarganya dengan pedang, tombak dan panah di bagian-bagian yang paling rendah dari tempat itu, di belakang tembok, di tempat-tempat yang terbuka."
 },
 {
   "id": 12377,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 14,
   "firman": "Kuamati semuanya, lalu bangun berdiri dan berkata kepada para pemuka dan para penguasa dan kepada orang-orang yang lain: \"Jangan kamu takut terhadap mereka! Ingatlah kepada Tuhan yang maha besar dan dahsyat dan berperanglah untuk saudara-saudaramu, untuk anak-anak lelaki dan anak-anak perempuanmu, untuk isterimu dan rumahmu.\""
 },
 {
   "id": 12378,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 15,
   "firman": "Ketika didengar musuh kami, bahwa rencana mereka sudah kami ketahui dan bahwa Allah telah menggagalkannya, maka dapatlah kami semua kembali ke tembok, masing-masing ke pekerjaannya."
 },
 {
   "id": 12379,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sejak hari itu sebagian dari pada anak buahku melakukan pekerjaan, dan sebagian yang lain memegang tombak, perisai dan panah dan mengenakan baju zirah, sedang para pemimpin berdiri di belakang segenap kaum Yehuda"
 },
 {
   "id": 12380,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 17,
   "firman": "yang membangun di tembok. Orang-orang yang memikul dan mengangkut melakukan pekerjaannya dengan satu tangan dan dengan tangan yang lain mereka memegang senjata."
 },
 {
   "id": 12381,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 18,
   "firman": "Setiap orang yang membangun bekerja dengan berikatkan pedang pada pinggangnya, dan di sampingku berdiri peniup sangkakala."
 },
 {
   "id": 12382,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 19,
   "firman": "Berkatalah aku kepada para pemuka dan para penguasa dan kepada orang-orang yang lain: \"Pekerjaan ini besar dan luas, dan kita terpencar pada tembok, yang satu jauh dari pada yang lain."
 },
 {
   "id": 12383,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 20,
   "firman": "Dan kalau kamu mendengar bunyi sangkakala di suatu tempat, berkumpullah ke sana mendapatkan kami. Allah kita akan berperang bagi kita!\""
 },
 {
   "id": 12384,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 21,
   "firman": "Demikianlah kami melakukan pekerjaan itu, sedang sebagian dari pada orang-orang memegang tombak dari merekahnya fajar sampai terbitnya bintang-bintang."
 },
 {
   "id": 12385,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 22,
   "firman": "Pada waktu itu juga aku berikan perintah kepada rakyat: \"Setiap orang dengan anak buahnya harus bermalam di Yerusalem, supaya mereka mengadakan penjagaan bagi kami pada malam hari, dan melakukan pekerjaannya pada siang hari.\""
 },
 {
   "id": 12386,
   "kitab": "Neh",
   "pasal": 4,
   "ayat": 23,
   "firman": "Demikianlah aku sendiri, saudara-saudaraku, anak buahku dan para penjaga yang mengikut aku, kami semua tidak sempat menanggalkan pakaian kami. Setiap orang memegang senjata dengan tangan kanan."
 },
 {
   "id": 12387,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 1,
   "firman": "Maka terdengarlah keluhan yang keras dari rakyat dan juga dari pihak para isteri terhadap sesama orang Yahudi."
 },
 {
   "id": 12388,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 2,
   "firman": "Ada yang berteriak: \"Anak laki-laki dan anak perempuan kami banyak dan kami harus mendapat gandum, supaya kami dapat makan dan hidup.\""
 },
 {
   "id": 12389,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 3,
   "firman": "Dan ada yang berteriak: \"Ladang dan kebun anggur dan rumah kami gadaikan untuk mendapat gandum pada waktu kelaparan.\""
 },
 {
   "id": 12390,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 4,
   "firman": "Juga ada yang berteriak: \"Kami harus meminjam uang untuk membayar pajak yang dikenakan raja atas ladang dan kebun anggur kami."
 },
 {
   "id": 12391,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 5,
   "firman": "Sekarang, walaupun kami ini sedarah sedaging dengan saudara-saudara sebangsa kami dan anak-anak kami sama dengan anak-anak mereka, namun kami terpaksa membiarkan anak-anak lelaki dan anak-anak perempuan kami menjadi budak dan sudah beberapa anak perempuan kami harus membiarkan diri dimiliki orang. Kami tidak dapat berbuat apa-apa, karena ladang dan kebun anggur kami sudah di tangan orang lain.\""
 },
 {
   "id": 12392,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 6,
   "firman": "Maka sangat marahlah aku, ketika kudengar keluhan mereka dan berita-berita itu."
 },
 {
   "id": 12393,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 7,
   "firman": "Setelah berpikir masak-masak, aku menggugat para pemuka dan para penguasa. Kataku kepada mereka: \"Masing-masing kamu telah makan riba dari saudara-saudaramu!\" Lalu kuadakan terhadap mereka suatu sidang jemaah yang besar."
 },
 {
   "id": 12394,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 8,
   "firman": "Berkatalah aku kepada mereka: \"Kami selalu berusaha sedapat-dapatnya untuk menebus sesama orang Yahudi yang dijual kepada bangsa-bangsa lain. Tetapi kamu ini justru menjual saudara-saudaramu, supaya mereka dibeli lagi oleh kami!\" Mereka berdiam diri karena tidak dapat membantah."
 },
 {
   "id": 12395,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kataku: \"Tidaklah patut apa yang kamu lakukan itu! Bukankah kamu harus berlaku dengan takut akan Allah kita untuk menghindarkan diri dari cercaan bangsa-bangsa lain, musuh-musuh kita?"
 },
 {
   "id": 12396,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 10,
   "firman": "Juga aku dan saudara-saudaraku dan anak buahku telah membungakan uang dan gandum pada mereka. Biarlah kita hapuskan hutang mereka itu!"
 },
 {
   "id": 12397,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 11,
   "firman": "Biarlah kamu kembalikan kepada mereka hari ini juga ladang mereka, kebun anggur, kebun zaitun dan rumah mereka, pula hapuskanlah hutang mereka, yakni uang serta gandum, anggur dan minyak yang kamu tagih dari pada mereka!\""
 },
 {
   "id": 12398,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 12,
   "firman": "Berkatalah mereka: \"Itu akan kami kembalikan! Dan kami tidak akan menuntut apa-apa dari mereka. Kami akan lakukan tepat seperti yang engkau perintahkan!\" Lalu aku memanggil para imam dan menyuruh mereka bersumpah, bahwa mereka akan menepati janji mereka."
 },
 {
   "id": 12399,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 13,
   "firman": "Juga kukebas lipatan bajuku sambil berkata: \"Demikianlah setiap orang yang tidak menepati janji ini akan dikebas Allah dari rumahnya dan hasil jerih payahnya. Demikianlah ia dikebas dan menjadi hampa!\" Dan seluruh jemaah berkata: \"Amin,\" lalu memuji-muji TUHAN. Maka rakyat berbuat sesuai dengan janji itu."
 },
 {
   "id": 12400,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 14,
   "firman": "Pula sejak aku diangkat sebagai bupati di tanah Yehuda, yakni dari tahun kedua puluh sampai tahun ketiga puluh dua pemerintahan Artahsasta jadi dua belas tahun lamanya, aku dan saudara-saudaraku tidak pernah mengambil pembagian yang menjadi hak bupati."
 },
 {
   "id": 12401,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 15,
   "firman": "Tetapi para bupati yang sebelumnya, yang mendahului aku, sangat memberatkan beban rakyat. Bupati-bupati itu mengambil dari mereka empat puluh syikal perak sehari untuk bahan makanan dan anggur. Bahkan anak buah mereka merajalela atas rakyat. Tetapi aku tidak berbuat demikian karena takut akan Allah."
 },
 {
   "id": 12402,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 16,
   "firman": "Akupun memulai pekerjaan tembok itu, walaupun aku tidak memperoleh ladang. Dan semua anak buahku dikumpulkan di sana khusus untuk pekerjaan itu."
 },
 {
   "id": 12403,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 17,
   "firman": "Duduk pada mejaku orang-orang Yahudi dan para penguasa, seratus lima puluh orang, selain mereka yang datang kepada kami dari bangsa-bangsa sekeliling kami."
 },
 {
   "id": 12404,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 18,
   "firman": "Yang disediakan sehari atas tanggunganku ialah: seekor lembu, enam ekor kambing domba yang terpilih dan beberapa ekor unggas, dan bermacam-macam anggur dengan berlimpah-limpah setiap sepuluh hari. Namun, dengan semuanya itu, aku tidak menuntut pembagian yang menjadi hak bupati, karena pekerjaan itu sangat menekan rakyat."
 },
 {
   "id": 12405,
   "kitab": "Neh",
   "pasal": 5,
   "ayat": 19,
   "firman": "Ya Allahku, demi kesejahteraanku, ingatlah segala yang kubuat untuk bangsa ini."
 },
 {
   "id": 12406,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 1,
   "firman": "Ketika Sanbalat dan Tobia dan Gesyem, orang Arab itu dan musuh-musuh kami yang lain mendengar, bahwa aku telah selesai membangun kembali tembok, sehingga tidak ada lagi lobang, walaupun sampai waktu itu di pintu-pintu gerbang belum kupasang pintunya,"
 },
 {
   "id": 12407,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 2,
   "firman": "maka Sanbalat dan Gesyem mengutus orang kepadaku dengan pesan: \"Mari, kita mengadakan pertemuan bersama di Kefirim, di lembah Ono!\" Tetapi mereka berniat mencelakakan aku."
 },
 {
   "id": 12408,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 3,
   "firman": "Lalu aku mengirim utusan kepada mereka dengan balasan: \"Aku tengah melakukan suatu pekerjaan yang besar. Aku tidak bisa datang! Untuk apa pekerjaan ini terhenti oleh sebab aku meninggalkannya dan pergi kepada kamu!\""
 },
 {
   "id": 12409,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sampai empat kali mereka mengirim pesan semacam itu kepadaku dan setiap kali aku berikan jawaban yang sama kepada mereka."
 },
 {
   "id": 12410,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 5,
   "firman": "Lalu dengan cara yang sama untuk kelima kalinya Sanbalat mengirim seorang anak buahnya kepadaku yang membawa surat yang terbuka."
 },
 {
   "id": 12411,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 6,
   "firman": "Dalam surat itu tertulis: \"Ada desas-desus di antara bangsa-bangsa dan Gasymu membenarkannya, bahwa engkau dan orang-orang Yahudi berniat untuk memberontak, dan oleh sebab itu membangun kembali tembok. Lagipula, menurut kabar itu, engkau mau menjadi raja mereka."
 },
 {
   "id": 12412,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 7,
   "firman": "Bahkan engkau telah menunjuk nabi-nabi yang harus memberitakan tentang dirimu di Yerusalem, demikian: Ada seorang raja di Yehuda! Sekarang, berita seperti itu akan didengar raja. Oleh sebab itu, mari, kita sama-sama berunding!\""
 },
 {
   "id": 12413,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tetapi aku mengirim orang kepadanya dengan balasan: \"Hal seperti yang kausebut itu tidak pernah ada. Itu isapan jempolmu belaka!\""
 },
 {
   "id": 12414,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 9,
   "firman": "Karena mereka semua mau menakut-nakutkan kami, pikirnya: \"Mereka akan membiarkan pekerjaan itu, sehingga tak dapat diselesaikan.\" Tetapi aku justru berusaha sekuat tenaga."
 },
 {
   "id": 12415,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 10,
   "firman": "Ketika aku pergi ke rumah Semaya bin Delaya bin Mehetabeel, sebab ia berhalangan datang, berkatalah ia: \"Biarlah kita bertemu di rumah Allah, di dalam Bait Suci, dan mengunci pintu-pintunya, karena ada orang yang mau datang membunuh engkau, ya, malam ini mereka mau datang membunuh engkau.\""
 },
 {
   "id": 12416,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 11,
   "firman": "Tetapi kataku: \"Orang manakah seperti aku ini yang akan melarikan diri? Orang manakah seperti aku ini dapat memasuki Bait Suci dan tinggal hidup? Aku tidak pergi!\""
 },
 {
   "id": 12417,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 12,
   "firman": "Karena kuketahui benar, bahwa Allah tidak mengutus dia. Ia mengucapkan nubuat itu terhadap aku, karena disuap Tobia dan Sanbalat."
 },
 {
   "id": 12418,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 13,
   "firman": "Untuk ini ia disuap, supaya aku menjadi takut lalu berbuat demikian, sehingga aku berdosa. Dengan demikian mereka mempunyai kesempatan untuk membusukkan namaku, sehingga dapat mencela aku."
 },
 {
   "id": 12419,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 14,
   "firman": "Ya Allahku, ingatlah bagaimana Tobia dan Sanbalat masing-masing telah bertindak! Pun tindakan nabiah Noaja dan nabi-nabi yang lain yang mau menakut-nakutkan aku."
 },
 {
   "id": 12420,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 15,
   "firman": "Maka selesailah tembok itu pada tanggal dua puluh lima bulan Elul, dalam waktu lima puluh dua hari."
 },
 {
   "id": 12421,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 16,
   "firman": "Ketika semua musuh kami mendengar hal itu, takutlah semua bangsa sekeliling kami. Mereka sangat kehilangan muka dan menjadi sadar, bahwa pekerjaan itu dilaksanakan dengan bantuan Allah kami."
 },
 {
   "id": 12422,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 17,
   "firman": "Pada masa itu pula para pemuka Yehuda mengirim banyak surat kepada Tobia, dan sebaliknya mereka menerima surat-surat dari padanya,"
 },
 {
   "id": 12423,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 18,
   "firman": "karena banyak orang di Yehuda mempunyai ikatan sumpah dengan dia, sebab ia adalah menantu Sekhanya bin Arah, sedang Yohanan, anaknya, mengambil anak Mesulam bin Berekhya sebagai isteri."
 },
 {
   "id": 12424,
   "kitab": "Neh",
   "pasal": 6,
   "ayat": 19,
   "firman": "Juga mereka sebut-sebut segala kebaikan Tobia di mukaku dan segala perkataanku terus dibeberkan kepadanya. Pula Tobia mengirim surat-surat untuk menakut-nakutkan aku."
 },
 {
   "id": 12425,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 1,
   "firman": "Setelah tembok selesai dibangun, aku memasang pintu-pintu. Lalu diangkatlah penunggu-penunggu pintu gerbang, para penyanyi dan orang-orang Lewi."
 },
 {
   "id": 12426,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 2,
   "firman": "Pengawasan atas Yerusalem aku serahkan kepada Hanani, saudaraku, dan kepada Hananya, panglima benteng, karena dia seorang yang dapat dipercaya dan yang takut akan Allah lebih dari pada orang-orang lain."
 },
 {
   "id": 12427,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 3,
   "firman": "Berkatalah aku kepada mereka: \"Pintu-pintu gerbang Yerusalem jangan dibuka sampai matahari panas terik. Dan pintu-pintunya harus ditutup dan dipalangi, sementara orang masih bertugas di tempatnya. Tempatkanlah penjaga-penjaga dari antara penduduk Yerusalem, masing-masing pada tempat-tempat penjagaan dan di depan rumahnya.\""
 },
 {
   "id": 12428,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 4,
   "firman": "Adapun kota itu luas dan besar, tetapi penduduknya sedikit dan rumah-rumah belum dibangun."
 },
 {
   "id": 12429,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 5,
   "firman": "Maka Allahku memberikan dalam hatiku rencana untuk mengumpulkan para pemuka, para penguasa dan rakyat, supaya mereka dicatat dalam silsilah. Lalu kudapati daftar silsilah orang-orang yang lebih dahulu berangkat pulang. Dalam daftar itu kudapati tertulis:"
 },
 {
   "id": 12430,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 6,
   "firman": "Inilah orang-orang propinsi Yehuda yang berangkat pulang dari pembuangan, yakni para tawanan, yang dahulu diangkut oleh Nebukadnezar, raja Babel, dan yang kembali ke Yerusalem dan ke Yehuda, masing-masing ke kotanya."
 },
 {
   "id": 12431,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 7,
   "firman": "Mereka datang bersama-sama Zerubabel, Yesua, Nehemia, Azarya, Raamya, Nahamani, Mordekhai, Bilsan, Misperet, Bigwai, Nehum dan Baana. Inilah daftar orang-orang bangsa Israel:"
 },
 {
   "id": 12432,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 8,
   "firman": "bani Paros: dua ribu seratus tujuh puluh dua orang;"
 },
 {
   "id": 12433,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 9,
   "firman": "bani Sefaca: tiga ratus tujuh puluh dua orang;"
 },
 {
   "id": 12434,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 10,
   "firman": "bani Arakh: enam ratus lima puluh dua orang;"
 },
 {
   "id": 12435,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 11,
   "firman": "bani Pahat-Moab, yakni bani Yesua dan Yoab: dua ribu delapan ratus delapan belas orang;"
 },
 {
   "id": 12436,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 12,
   "firman": "bani Elam: seribu dua ratus lima puluh empat orang;"
 },
 {
   "id": 12437,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 13,
   "firman": "bani Zatu: delapan ratus empat puluh lima orang;"
 },
 {
   "id": 12438,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 14,
   "firman": "bani Zakai: tujuh ratus enam puluh orang;"
 },
 {
   "id": 12439,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 15,
   "firman": "bani Binui: enam ratus empat puluh delapan orang;"
 },
 {
   "id": 12440,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 16,
   "firman": "bani Bebai: enam ratus dua puluh delapan orang;"
 },
 {
   "id": 12441,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 17,
   "firman": "bani Azgad: dua ribu tiga ratus dua puluh dua orang;"
 },
 {
   "id": 12442,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 18,
   "firman": "bani Adonikam: enam ratus enam puluh tujuh orang;"
 },
 {
   "id": 12443,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 19,
   "firman": "bani Bigwai: dua ribu enam puluh tujuh orang;"
 },
 {
   "id": 12444,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 20,
   "firman": "bani Adin: enam ratus lima puluh lima orang;"
 },
 {
   "id": 12445,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 21,
   "firman": "bani Ater, yakni bani Hizkia: sembilan puluh delapan orang;"
 },
 {
   "id": 12446,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 22,
   "firman": "bani Hasum: tiga ratus dua puluh delapan orang;"
 },
 {
   "id": 12447,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 23,
   "firman": "bani Bezai: tiga ratus dua puluh empat orang;"
 },
 {
   "id": 12448,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 24,
   "firman": "bani Harif: seratus dua belas orang;"
 },
 {
   "id": 12449,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 25,
   "firman": "bani Gibeon: sembilan puluh lima orang;"
 },
 {
   "id": 12450,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 26,
   "firman": "orang-orang Betlehem dan Netofa: seratus delapan puluh delapan orang;"
 },
 {
   "id": 12451,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 27,
   "firman": "orang-orang Anatot: seratus dua puluh delapan orang;"
 },
 {
   "id": 12452,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 28,
   "firman": "orang-orang Bet-Azmawet: empat puluh dua orang;"
 },
 {
   "id": 12453,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 29,
   "firman": "orang-orang Kiryat-Yearim, Kefira dan Beerot: tujuh ratus empat puluh tiga orang;"
 },
 {
   "id": 12454,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 30,
   "firman": "orang-orang Rama dan Gaba: enam ratus dua puluh satu orang;"
 },
 {
   "id": 12455,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 31,
   "firman": "orang-orang Mikhmas: seratus dua puluh dua orang;"
 },
 {
   "id": 12456,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 32,
   "firman": "orang-orang Betel dan Ai: seratus dua puluh tiga orang;"
 },
 {
   "id": 12457,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 33,
   "firman": "orang-orang dari Nebo yang lain: lima puluh dua orang;"
 },
 {
   "id": 12458,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 34,
   "firman": "bani Elam, yakni Elam yang lain: seribu dua ratus lima puluh empat orang;"
 },
 {
   "id": 12459,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 35,
   "firman": "bani Harim: tiga ratus dua puluh orang;"
 },
 {
   "id": 12460,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 36,
   "firman": "orang-orang Yerikho: tiga ratus empat puluh lima orang;"
 },
 {
   "id": 12461,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 37,
   "firman": "orang-orang Lod, Hadid dan Ono: tujuh ratus dua puluh satu orang;"
 },
 {
   "id": 12462,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 38,
   "firman": "bani Senaa: tiga ribu sembilan ratus tiga puluh orang."
 },
 {
   "id": 12463,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 39,
   "firman": "Inilah para imam: bani Yedaya, yakni kaum keluarga Yesua: sembilan ratus tujuh puluh tiga orang;"
 },
 {
   "id": 12464,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 40,
   "firman": "bani Imer: seribu lima puluh dua orang;"
 },
 {
   "id": 12465,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 41,
   "firman": "bani Pasyhur: seribu dua ratus empat puluh tujuh orang;"
 },
 {
   "id": 12466,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 42,
   "firman": "bani Harim: seribu tujuh belas orang."
 },
 {
   "id": 12467,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 43,
   "firman": "Inilah orang-orang Lewi: bani Yesua, yakni bani Kadmiel dan bani Hodewa; tujuh puluh empat orang."
 },
 {
   "id": 12468,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 44,
   "firman": "Inilah para penyanyi: bani Asaf: seratus empat puluh delapan orang."
 },
 {
   "id": 12469,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 45,
   "firman": "Inilah para penunggu pintu gerbang: bani Salum, bani Ater, bani Talmon, bani Akub, bani Hatita, bani Sobai: seratus tiga puluh delapan orang."
 },
 {
   "id": 12470,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 46,
   "firman": "Inilah para budak di bait Allah: bani Ziha, bani Hasufa, bani Tabaot;"
 },
 {
   "id": 12471,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 47,
   "firman": "bani Keros, bani Sia, bani Padon;"
 },
 {
   "id": 12472,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 48,
   "firman": "bani Lebana, bani Hagaba, bani Salmai;"
 },
 {
   "id": 12473,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 49,
   "firman": "bani Hanan, bani Gidel, bani Gahar;"
 },
 {
   "id": 12474,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 50,
   "firman": "bani Reaya, bani Rezin, bani Nekoda;"
 },
 {
   "id": 12475,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 51,
   "firman": "bani Gazam, bani Uza, bani Paseah;"
 },
 {
   "id": 12476,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 52,
   "firman": "bani Besai, bani Meunim, bani Nefusim;"
 },
 {
   "id": 12477,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 53,
   "firman": "bani Bakbuk, bani Hakufa, bani Harhur;"
 },
 {
   "id": 12478,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 54,
   "firman": "bani Bazlit, bani Mehida, bani Harsa;"
 },
 {
   "id": 12479,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 55,
   "firman": "bani Barkos, bani Sisera, bani Temah;"
 },
 {
   "id": 12480,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 56,
   "firman": "bani Neziah, bani Hatifa."
 },
 {
   "id": 12481,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 57,
   "firman": "Inilah keturunan para hamba Salomo: bani Sotai, bani Soferet, bani Perida;"
 },
 {
   "id": 12482,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 58,
   "firman": "bani Yaala, bani Darkon, bani Gidel;"
 },
 {
   "id": 12483,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 59,
   "firman": "bani Sefaca, bani Hatil, bani Pokheret-Hazebaim, bani Amon."
 },
 {
   "id": 12484,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 60,
   "firman": "Seluruh budak di bait Allah dan keturunan para hamba Salomo ada tiga ratus sembilan puluh dua orang."
 },
 {
   "id": 12485,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 61,
   "firman": "Inilah orang-orang yang berangkat pulang dari Tel-Melah, Tel-Harsa, Kerub, Adon dan Imer, tetapi mereka tidak dapat menyatakan apakah kaum keluarga dan asal-usul mereka termasuk bangsa Israel:"
 },
 {
   "id": 12486,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 62,
   "firman": "bani Delaya, bani Tobia, bani Nekoda: enam ratus empat puluh dua orang;"
 },
 {
   "id": 12487,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 63,
   "firman": "dan dari antara para imam: bani Habaya, bani Hakos, bani Barzilai. Barzilai itu memperisteri seorang anak perempuan Barzilai, orang Gilead itu, dan sejak itu ia dinamai menurut nama keluarga itu."
 },
 {
   "id": 12488,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 64,
   "firman": "Mereka itu menyelidiki apakah nama mereka tercatat dalam silsilah, tetapi karena itu tidak didapati, maka mereka dinyatakan tidak tahir untuk jabatan imam."
 },
 {
   "id": 12489,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 65,
   "firman": "Dan tentang mereka diputuskan oleh kepala daerah, bahwa mereka tidak boleh makan dari persembahan maha kudus, sampai ada seorang imam bertindak dengan memegang Urim dan Tumim."
 },
 {
   "id": 12490,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 66,
   "firman": "Seluruh jemaah itu bersama-sama ada empat puluh dua ribu tiga ratus enam puluh orang,"
 },
 {
   "id": 12491,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 67,
   "firman": "selain dari budak mereka laki-laki dan perempuan yang berjumlah tujuh ribu tiga ratus tiga puluh tujuh orang. Pada mereka ada dua ratus empat puluh lima penyanyi laki-laki dan perempuan."
 },
 {
   "id": 12492,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 68,
   "firman": "Mereka mempunyai tujuh ratus tiga puluh enam ekor kuda, dua ratus empat puluh lima ekor bagal,"
 },
 {
   "id": 12493,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 69,
   "firman": "empat ratus tiga puluh lima ekor unta dan enam ribu tujuh ratus dua puluh ekor keledai."
 },
 {
   "id": 12494,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 70,
   "firman": "Sebagian dari kepala kaum keluarga memberi sumbangan untuk pekerjaan itu, sedang kepala daerah memberi sumbangan untuk perbendaharaan seribu dirham emas, lima puluh buah bokor penyiraman, dan lima ratus tiga puluh helai kemeja imam."
 },
 {
   "id": 12495,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 71,
   "firman": "Pula beberapa kepala kaum keluarga memberi sumbangan untuk perbendaharaan pekerjaan itu dua puluh ribu dirham emas dan dua ribu dua ratus mina perak."
 },
 {
   "id": 12496,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 72,
   "firman": "Dan yang disumbangkan oleh orang-orang lain adalah: dua puluh ribu dirham emas, dua ribu mina perak dan enam puluh tujuh helai kemeja imam."
 },
 {
   "id": 12497,
   "kitab": "Neh",
   "pasal": 7,
   "ayat": 73,
   "firman": "Adapun para imam dan orang-orang Lewi, para penunggu pintu dan para penyanyi, juga sebagian dari rakyat, para budak di bait Allah dan semua orang Israel yang lain menetap di kota-kota mereka."
 },
 {
   "id": 12499,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 1,
   "firman": "(8-2) maka serentak berkumpullah seluruh rakyat di halaman di depan pintu gerbang Air. Mereka meminta kepada Ezra, ahli kitab itu, supaya ia membawa kitab Taurat Musa, yakni kitab hukum yang diberikan TUHAN kepada Israel."
 },
 {
   "id": 12500,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 2,
   "firman": "(8-3) Lalu pada hari pertama bulan yang ketujuh itu imam Ezra membawa kitab Taurat itu ke hadapan jemaah, yakni baik laki-laki maupun perempuan dan setiap orang yang dapat mendengar dan mengerti."
 },
 {
   "id": 12501,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 3,
   "firman": "(8-4) Ia membacakan beberapa bagian dari pada kitab itu di halaman di depan pintu gerbang Air dari pagi sampai tengah hari di hadapan laki-laki dan perempuan dan semua orang yang dapat mengerti. Dengan penuh perhatian seluruh umat mendengarkan pembacaan kitab Taurat itu."
 },
 {
   "id": 12502,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 4,
   "firman": "(8-5) Ezra, ahli kitab itu, berdiri di atas mimbar kayu yang dibuat untuk peristiwa itu. Di sisinya sebelah kanan berdiri Matica, Sema, Anaya, Uria, Hilkia dan Maaseya, sedang di sebelah kiri berdiri Pedaya, Misael, Malkia, Hasum, Hasbadana, Zakharia dan Mesulam."
 },
 {
   "id": 12503,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 5,
   "firman": "(8-6) Ezra membuka kitab itu di depan mata seluruh umat, karena ia berdiri lebih tinggi dari semua orang itu. Pada waktu ia membuka kitab itu semua orang bangkit berdiri."
 },
 {
   "id": 12504,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 6,
   "firman": "(8-7) Lalu Ezra memuji TUHAN, Allah yang maha besar, dan semua orang menyambut dengan: \"Amin, amin!\", sambil mengangkat tangan. Kemudian mereka berlutut dan sujud menyembah kepada TUHAN dengan muka sampai ke tanah."
 },
 {
   "id": 12505,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 7,
   "firman": "(8-8) Juga Yesua, Bani, Serebya, Yamin, Akub, Sabetai, Hodia, Maaseya, Kelita, Azarya, Yozabad, Hanan, Pelaya, yang adalah orang-orang Lewi, mengajarkan Taurat itu kepada orang-orang itu, sementara orang-orang itu berdiri di tempatnya."
 },
 {
   "id": 12506,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 8,
   "firman": "(8-9) Bagian-bagian dari pada kitab itu, yakni Taurat Allah, dibacakan dengan jelas, dengan diberi keterangan-keterangan, sehingga pembacaan dimengerti."
 },
 {
   "id": 12507,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 9,
   "firman": "(8-10) Lalu Nehemia, yakni kepala daerah itu, dan imam Ezra, ahli kitab itu, dan orang-orang Lewi yang mengajar orang-orang itu, berkata kepada mereka semuanya: \"Hari ini adalah kudus bagi TUHAN Allahmu. Jangan kamu berdukacita dan menangis!\", karena semua orang itu menangis ketika mendengar kalimat-kalimat Taurat itu."
 },
 {
   "id": 12508,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 10,
   "firman": "(8-11) Lalu berkatalah ia kepada mereka: \"Pergilah kamu, makanlah sedap-sedapan dan minumlah minuman manis dan kirimlah sebagian kepada mereka yang tidak sedia apa-apa, karena hari ini adalah kudus bagi Tuhan kita! Jangan kamu bersusah hati, sebab sukacita karena TUHAN itulah perlindunganmu!\""
 },
 {
   "id": 12509,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 11,
   "firman": "(8-12) Juga orang-orang Lewi menyuruh semua orang itu supaya diam dengan kata-kata: \"Tenanglah! Hari ini adalah kudus. Jangan kamu bersusah hati!\""
 },
 {
   "id": 12510,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 12,
   "firman": "(8-13) Maka pergilah semua orang itu untuk makan dan minum, untuk membagi-bagi makanan dan berpesta ria, karena mereka mengerti segala firman yang diberitahukan kepada mereka."
 },
 {
   "id": 12511,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 13,
   "firman": "(8-14) Pada hari yang kedua kepala-kepala kaum keluarga seluruh bangsa, juga para imam dan orang-orang Lewi berkumpul pada Ezra, ahli hukum Taurat itu, untuk menelaah kalimat-kalimat Taurat itu."
 },
 {
   "id": 12512,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 14,
   "firman": "(8-15) Maka didapatinya tertulis dalam hukum yang diberikan TUHAN dengan perantaraan Musa, bahwa orang Israel harus tinggal dalam pondok-pondok pada hari raya bulan yang ketujuh,"
 },
 {
   "id": 12513,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 15,
   "firman": "(8-16) dan bahwa di semua kota mereka dan di Yerusalem harus disampaikan berita dan pengumuman yang berbunyi: \"Pergilah ke gunung, ambillah daun pohon zaitun, daun pohon minyak, daun pohon murad, daun pohon korma dan daun dari pohon-pohon yang rimbun guna membuat pondok-pondok sebagaimana tertulis.\""
 },
 {
   "id": 12514,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 16,
   "firman": "(8-17) Maka pergilah orang mengambil daun-daun itu, lalu membuat pondok-pondok, masing-masing di atas atap rumahnya, di pekarangan mereka, juga di pelataran-pelataran rumah Allah, di lapangan pintu gerbang Air dan di lapangan pintu gerbang Efraim."
 },
 {
   "id": 12515,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 17,
   "firman": "(8-18) Seluruh jemaah yang pulang dari pembuangan itu membuat pondok-pondok dan tinggal di situ. Memang sejak zaman Yosua bin Nun sampai hari itu orang Israel tidak pernah berbuat demikian. Maka diadakanlah pesta ria yang amat besar."
 },
 {
   "id": 12516,
   "kitab": "Neh",
   "pasal": 8,
   "ayat": 18,
   "firman": "(8-19) Bagian-bagian kitab Taurat Allah itu dibacakan tiap hari, dari hari pertama sampai hari terakhir. Tujuh hari lamanya mereka merayakan hari raya itu dan pada hari yang kedelapan ada pertemuan raya sesuai dengan peraturan."
 },
 {
   "id": 12517,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 1,
   "firman": "Pada hari yang kedua puluh empat bulan itu berkumpullah orang Israel dan berpuasa dengan mengenakan kain kabung dan dengan tanah di kepala."
 },
 {
   "id": 12518,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 2,
   "firman": "Keturunan orang Israel memisahkan diri dari semua orang asing, lalu berdiri di tempatnya dan mengaku dosa mereka dan kesalahan nenek moyang mereka."
 },
 {
   "id": 12519,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 3,
   "firman": "Sementara mereka berdiri di tempat, dibacakanlah bagian-bagian dari pada kitab Taurat TUHAN, Allah mereka, selama seperempat hari, sedang seperempat hari lagi mereka mengucapkan pengakuan dan sujud menyembah kepada TUHAN, Allah mereka."
 },
 {
   "id": 12520,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 4,
   "firman": "Di atas tangga tempat orang-orang Lewi berdirilah Yesua, Bani, Kadmiel, Sebanya, Buni, Serebya, Bani dan Kenani. Dengan suara yang nyaring mereka berseru kepada TUHAN, Allah mereka."
 },
 {
   "id": 12521,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan berkatalah Yesua, Kadmiel, Bani, Hasabneya, Serebya, Hodia, Sebanya dan Petahya, orang-orang Lewi itu: \"Bangunlah, pujilah TUHAN Allahmu dari selama-lamanya sampai selama-lamanya! Terpujilah nama-Mu yang mulia, yang ditinggikan mengatasi segala puji dan hormat!\""
 },
 {
   "id": 12522,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 6,
   "firman": "\"Hanya Engkau adalah TUHAN! Engkau telah menjadikan langit, ya langit segala langit dengan segala bala tentaranya, dan bumi dengan segala yang ada di atasnya, dan laut dengan segala yang ada di dalamnya. Engkau memberi hidup kepada semuanya itu dan bala tentara langit sujud menyembah kepada-Mu."
 },
 {
   "id": 12523,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 7,
   "firman": "Engkaulah TUHAN, Allah yang telah memilih Abram dan membawanya keluar dari Ur-Kasdim dan memberikan kepadanya nama Abraham."
 },
 {
   "id": 12524,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 8,
   "firman": "Engkau dapati bahwa hatinya setia terhadap-Mu dan Engkau mengikat perjanjian dengan dia untuk memberikan tanah orang Kanaan, tanah orang Het, tanah orang Amori, tanah orang Feris, tanah orang Yebus dan tanah orang Girgasi kepada keturunannya. Dan Engkau telah menepati janji-Mu, karena Engkau benar."
 },
 {
   "id": 12525,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 9,
   "firman": "Engkau melihat sengsara nenek moyang kami di Mesir dan mendengar teriakan mereka di tepi Laut Teberau."
 },
 {
   "id": 12526,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 10,
   "firman": "Engkau telah memperlihatkan tanda-tanda dan mujizat-mujizat di depan Firaun dan semua pegawainya serta seluruh rakyat negerinya, karena Engkau mengetahui mereka bertindak angkuh terhadap nenek moyang kami. Dengan demikian Engkau telah memasyhurkan nama-Mu sebagaimana nyata hari ini."
 },
 {
   "id": 12527,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 11,
   "firman": "Di hadapan mereka Engkau membelah laut, sehingga mereka dapat menyeberang melalui tempat yang kering di tengah-tengah laut. Tetapi pengejar-pengejar mereka telah Kaucampakkan ke air yang dalam, seperti batu ke air yang dahsyat."
 },
 {
   "id": 12528,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 12,
   "firman": "Dengan tiang awan Engkau memimpin mereka pada siang hari dan dengan tiang api pada malam hari untuk menerangi jalan yang mereka lalui."
 },
 {
   "id": 12529,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 13,
   "firman": "Engkau telah turun ke atas gunung Sinai dan berbicara dengan mereka dari langit dan memberikan mereka peraturan-peraturan yang adil, hukum-hukum yang benar serta ketetapan-ketetapan dan perintah-perintah yang baik."
 },
 {
   "id": 12530,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 14,
   "firman": "Juga Kauberitahukan kepada mereka sabat-Mu yang kudus dan memberikan kepada mereka perintah-perintah, ketetapan-ketetapan dan hukum-Mu dengan perantaraan Musa, hamba-Mu."
 },
 {
   "id": 12531,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 15,
   "firman": "Telah Kauberikan kepada mereka roti dari langit untuk menghilangkan lapar dan air Kaukeluarkan bagi mereka dari gunung batu untuk melepaskan dahaga. Pula Engkau menyuruh mereka memasuki dan menduduki negeri yang dengan mengangkat sumpah telah Kaujanjikan memberikannya kepada mereka."
 },
 {
   "id": 12532,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 16,
   "firman": "Tetapi mereka, nenek moyang kami itu, bertindak angkuh dan bersitegang leher dan tidak patuh kepada perintah-perintah-Mu."
 },
 {
   "id": 12533,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 17,
   "firman": "Mereka menolak untuk patuh dan tidak mengingat perbuatan-perbuatan yang ajaib yang telah Kaubuat di antara mereka. Mereka bersitegang leher malah berkeras kepala untuk kembali ke perbudakan di Mesir. Tetapi Engkaulah Allah yang sudi mengampuni, yang pengasih dan penyayang, yang panjang sabar dan berlimpah kasih setia-Nya. Engkau tidak meninggalkan mereka."
 },
 {
   "id": 12534,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 18,
   "firman": "Bahkan, ketika mereka membuat anak lembu tuangan dan berkata: 'Inilah Allahmu yang menuntun engkau keluar dari Mesir!', dan berbuat nista yang besar,"
 },
 {
   "id": 12535,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 19,
   "firman": "Engkau tidak meninggalkan mereka di padang gurun karena kasih sayang-Mu yang besar. Tiang awan tidak berpindah dari atas mereka pada siang hari untuk memimpin mereka pada perjalanan, begitu juga tiang api pada malam hari untuk menerangi jalan yang mereka lalui."
 },
 {
   "id": 12536,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 20,
   "firman": "Dan Engkau memberikan kepada mereka Roh-Mu yang baik untuk mengajar mereka. Juga manna-Mu tidak Kautahan dari mulut mereka dan Engkau memberikan air kepada mereka untuk melepaskan dahaga."
 },
 {
   "id": 12537,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 21,
   "firman": "Empat puluh tahun lamanya Engkau memberikan mereka makan di padang gurun. Mereka tidak berkekurangan, pakaian mereka tidak rusak, dan kaki mereka tidak bengkak."
 },
 {
   "id": 12538,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 22,
   "firman": "Engkau menyerahkan kepada mereka kerajaan-kerajaan dan bangsa-bangsa dan membagikan itu kepada mereka sebagai daerah perbatasan, sebab mereka duduki tanah dari Sihon, raja negeri Hesbon dan tanah dari Og, raja negeri Basan."
 },
 {
   "id": 12539,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 23,
   "firman": "Engkau membuat anak-anak mereka menjadi banyak seperti bintang-bintang di langit dan membawa mereka ke tanah yang Kausuruh kepada nenek moyang mereka untuk dimasuki dan diduduki."
 },
 {
   "id": 12540,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 24,
   "firman": "Lalu anak-anak itu memasuki dan menduduki tanah itu dan Engkau menundukkan di hadapan mereka penduduk tanah itu, yakni orang-orang Kanaan, dan menyerahkan orang-orang itu, baik raja-raja mereka, maupun bangsa-bangsa tanah itu, ke tangan mereka, supaya orang-orang itu diperlakukan sekehendak hati mereka."
 },
 {
   "id": 12541,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 25,
   "firman": "Mereka merebut kota-kota yang berkubu dan tanah yang subur. Mereka merampas rumah-rumah yang penuh berisi berbagai-bagai barang baik, tempat-tempat air pahatan, kebun-kebun anggur dan kebun-kebun zaitun dan pohon-pohon buah-buahan dalam jumlah yang sangat banyak. Mereka makan dan menjadi kenyang dan gemuk. Mereka hidup mewah karena kebaikan-Mu yang besar."
 },
 {
   "id": 12542,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 26,
   "firman": "Tetapi mereka mendurhaka dan memberontak terhadap-Mu. Mereka membelakangi hukum-Mu dan membunuh nabi-nabi-Mu yang memperingatkan mereka dengan maksud membuat mereka berbalik kepada-Mu. Mereka berbuat nista yang besar."
 },
 {
   "id": 12543,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 27,
   "firman": "Lalu Engkau menyerahkan mereka ke tangan lawan-lawan mereka, yang menyesakkan mereka. Dan pada waktu kesusahan mereka berteriak kepada-Mu, lalu Engkau mendengar dari langit dan karena kasih sayang-Mu yang besar Kauberikan kepada mereka orang-orang yang menyelamatkan mereka dari tangan lawan mereka."
 },
 {
   "id": 12544,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 28,
   "firman": "Tetapi begitu mereka mendapat keamanan, kembali mereka berbuat jahat di hadapan-Mu. Dan Engkau menyerahkan mereka ke tangan musuh-musuh mereka yang menguasai mereka. Kembali mereka berteriak kepada-Mu, dan Engkau mendengar dari langit, lalu menolong mereka berulang kali, karena kasih sayang-Mu."
 },
 {
   "id": 12545,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 29,
   "firman": "Engkau memperingatkan mereka dengan maksud membuat mereka berbalik kepada hukum-Mu. Tetapi mereka bertindak angkuh, mereka tidak patuh kepada perintah-perintah-Mu dan mereka berdosa terhadap peraturan-peraturan-Mu, yang justru memberi hidup kepada orang yang melakukannya. Mereka melintangkan bahu untuk melawan, mereka bersitegang leher dan tidak mau dengar."
 },
 {
   "id": 12546,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 30,
   "firman": "Namun bertahun-tahun lamanya Engkau melanjutkan sabar-Mu terhadap mereka. Dengan Roh-Mu Engkau memperingatkan mereka, yakni dengan perantaraan para nabi-Mu, tetapi mereka tidak menghiraukannya, sehingga Engkau menyerahkan mereka ke tangan bangsa-bangsa segala negeri."
 },
 {
   "id": 12547,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 31,
   "firman": "Tetapi karena kasih sayang-Mu yang besar Engkau tidak membinasakan mereka sama sekali dan tidak meninggalkan mereka, karena Engkaulah Allah yang pengasih dan penyayang."
 },
 {
   "id": 12548,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 32,
   "firman": "Sekarang, ya Allah kami, Allah yang maha besar, kuat dan dahsyat, yang berpegang pada perjanjian dan kasih setia-Nya, janganlah Kaupandang remeh segala kesusahan yang telah dialami oleh kami, oleh raja-raja kami, pemimpin-pemimpin kami, imam-imam kami, nabi-nabi kami dan nenek moyang kami, ya oleh seluruh umat-Mu, sejak zaman raja-raja Asyur sampai hari ini."
 },
 {
   "id": 12549,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 33,
   "firman": "Tetapi Engkaulah yang benar dalam segala hal yang menimpa kami, karena Engkau berlaku setia dan kamilah berbuat fasik."
 },
 {
   "id": 12550,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 34,
   "firman": "Juga raja-raja kami, pemimpin-pemimpin kami, imam-imam kami, dan nenek moyang kami tidak melakukan hukum-Mu. Mereka tidak memperhatikan perintah-perintah-Mu dan peringatan-peringatan-Mu yang Kauberikan kepada mereka."
 },
 {
   "id": 12551,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 35,
   "firman": "Dalam kedudukan sebagai raja mereka tidak mau beribadah kepada-Mu, walaupun Engkau telah mengaruniakan kepada mereka banyak kebaikan dan telah menyediakan bagi mereka tanah yang luas dan subur. Mereka tidak berbalik dari perbuatan-perbuatan mereka yang jahat."
 },
 {
   "id": 12552,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 36,
   "firman": "Lihatlah, sekarang ini kami adalah budak. Ya, di tanah yang Kauberikan kepada nenek moyang kami untuk mengecap hasilnya dan segala kekayaannya kami ini adalah budak."
 },
 {
   "id": 12553,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 37,
   "firman": "Tanah itu menghasilkan banyak bagi raja-raja yang telah Kautetapkan atas kami karena dosa-dosa kami. Mereka itu memerintah sekehendak hati atas diri kami dan ternak kami, sehingga kami dalam kesesakan besar.\""
 },
 {
   "id": 12554,
   "kitab": "Neh",
   "pasal": 9,
   "ayat": 38,
   "firman": "Berdasarkan semuanya ini kami mengikat perjanjian yang teguh yang kami catat dengan dibubuhi meterai para pemimpin kami, orang-orang Lewi kami dan para imam kami."
 },
 {
   "id": 12555,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 1,
   "firman": "Yang membubuhi meterai adalah: kepala daerah Nehemia bin Hakhalya, Zedekia,"
 },
 {
   "id": 12556,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 2,
   "firman": "Seraya, Azarya, Yeremia,"
 },
 {
   "id": 12557,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 3,
   "firman": "Pasyhur, Amarya, Malkia,"
 },
 {
   "id": 12558,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 4,
   "firman": "Hatus, Sebanya, Malukh,"
 },
 {
   "id": 12559,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 5,
   "firman": "Harim, Meremot, Obaja,"
 },
 {
   "id": 12560,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 6,
   "firman": "Daniel, Gineton, Barukh,"
 },
 {
   "id": 12561,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 7,
   "firman": "Mesulam, Abia, Miyamin,"
 },
 {
   "id": 12562,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 8,
   "firman": "Maazya, Bilgai dan Semaya. Itulah para imam."
 },
 {
   "id": 12563,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sedang dari orang-orang Lewi: Yesua bin Azanya, Binui, seorang dari antara anak-anak Henadad, Kadmiel."
 },
 {
   "id": 12564,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 10,
   "firman": "Dan saudara-saudara mereka, yakni: Sebanya, Hodia, Kelita, Pelaya, Hanan,"
 },
 {
   "id": 12565,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 11,
   "firman": "Mikha, Rehob, Hasabya,"
 },
 {
   "id": 12566,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 12,
   "firman": "Zakur, Serebya, Sebanya,"
 },
 {
   "id": 12567,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 13,
   "firman": "Hodia, Bani dan Beninu."
 },
 {
   "id": 12568,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 14,
   "firman": "Dan dari pemimpin-pemimpin bangsa: Paros, Pahat-Moab, Elam, Zatu, Bani,"
 },
 {
   "id": 12569,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 15,
   "firman": "Buni, Azgad, Bebai,"
 },
 {
   "id": 12570,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 16,
   "firman": "Adonia, Bigwai, Adin,"
 },
 {
   "id": 12571,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 17,
   "firman": "Ater, Hizkia, Azur,"
 },
 {
   "id": 12572,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 18,
   "firman": "Hodia, Hasum, Bezai,"
 },
 {
   "id": 12573,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 19,
   "firman": "Harif, Anatot, Nebai,"
 },
 {
   "id": 12574,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 20,
   "firman": "Magpias, Mesulam, Hezir,"
 },
 {
   "id": 12575,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 21,
   "firman": "Mesezabeel, Zadok, Yadua,"
 },
 {
   "id": 12576,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 22,
   "firman": "Pelaca, Hanan, Anaya,"
 },
 {
   "id": 12577,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 23,
   "firman": "Hosea, Hananya, Hasub,"
 },
 {
   "id": 12578,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 24,
   "firman": "Halohesh, Pilha, Sobek,"
 },
 {
   "id": 12579,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 25,
   "firman": "Rehum, Hasabna, Maaseya,"
 },
 {
   "id": 12580,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 26,
   "firman": "Ahia, Hanan, Anan,"
 },
 {
   "id": 12581,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 27,
   "firman": "Malukh, Harim dan Baana."
 },
 {
   "id": 12582,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 28,
   "firman": "Dan orang-orang yang lain, yakni: para imam dan orang-orang Lewi, para penunggu pintu gerbang, para penyanyi, para budak di bait Allah dan segala orang yang memisahkan diri dari penduduk negeri untuk patuh kepada hukum Allah, serta isteri mereka, anak-anak lelaki dan anak-anak perempuan mereka, begitu juga semua orang yang cukup dewasa untuk mengerti,"
 },
 {
   "id": 12583,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 29,
   "firman": "menggabungkan diri dengan saudara-saudara mereka, yakni pemuka-pemuka mereka itu. Mereka bersumpah kutuk untuk hidup menurut hukum Allah yang diberikan dengan perantaraan Musa, hamba Allah itu, dan untuk tetap mengikuti dan melakukan segala perintah TUHAN, yakni Tuhan kami, serta segala peraturan dan ketetapan-Nya."
 },
 {
   "id": 12584,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 30,
   "firman": "Pula kami tidak akan memberi anak-anak perempuan kami kepada penduduk negeri, ataupun mengambil anak-anak perempuan mereka bagi anak-anak lelaki kami."
 },
 {
   "id": 12585,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 31,
   "firman": "Dan bilamana penduduk negeri membawa barang-barang dan berbagai-bagai gandum untuk dijual pada hari Sabat, kami tidak akan membelinya dari mereka pada hari Sabat atau pada hari yang kudus. Dan kami akan membiarkan begitu saja hasil tanah pada tahun yang ketujuh dan tidak akan menagih sesuatu hutang."
 },
 {
   "id": 12586,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 32,
   "firman": "Pula kami mewajibkan diri untuk memberi tiap tahun sepertiga syikal untuk ibadah di rumah Allah kami, yakni:"
 },
 {
   "id": 12587,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 33,
   "firman": "untuk roti sajian, untuk korban sajian yang tetap, untuk korban bakaran yang tetap, untuk hari-hari Sabat, bulan-bulan baru dan masa raya yang tetap, untuk persembahan-persembahan kudus dan korban-korban penghapus dosa, untuk mengadakan pendamaian bagi orang Israel serta segala pekerjaan di rumah Allah kami."
 },
 {
   "id": 12588,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 34,
   "firman": "Pula dengan membuang undi kami, yakni para imam, orang-orang Lewi dan kaum awam, menetapkan suatu cara untuk menyediakan kayu api. Kayu itu harus dibawa ke rumah Allah kami secara bergilir oleh kaum-kaum keluarga kami pada waktu-waktu tertentu setiap tahun, supaya di atas mezbah TUHAN Allah kami ada api yang menyala, seperti tertulis dalam kitab Taurat."
 },
 {
   "id": 12589,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 35,
   "firman": "Lagipula setiap tahun kami akan membawa ke rumah TUHAN hasil yang pertama dari tanah kami dan buah sulung segala pohon."
 },
 {
   "id": 12590,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 36,
   "firman": "Pun kami akan membawa ke rumah Allah kami, yakni kepada para imam yang menyelenggarakan kebaktian di rumah Allah kami, anak-anak sulung kami dan anak-anak sulung ternak kami seperti tertulis dalam kitab Taurat, juga anak-anak sulung lembu kami dan kambing domba kami."
 },
 {
   "id": 12591,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 37,
   "firman": "Dan tepung jelai kami yang mula-mula, dan persembahan-persembahan khusus kami, dan buah segala pohon, dan anggur dan minyak akan kami bawa kepada para imam, ke bilik-bilik rumah Allah kami, dan kepada orang-orang Lewi akan kami bawa persembahan persepuluhan dari tanah kami, karena orang-orang Lewi inilah yang memungut persembahan-persembahan persepuluhan di segala kota pertanian kami."
 },
 {
   "id": 12592,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 38,
   "firman": "Seorang imam, anak Harun, akan menyertai orang-orang Lewi itu, bila mereka memungut persembahan persepuluhan. Dan orang-orang Lewi itu akan membawa persembahan persepuluhan dari pada persembahan persepuluhan itu ke rumah Allah kami, ke bilik-bilik rumah perbendaharaan."
 },
 {
   "id": 12593,
   "kitab": "Neh",
   "pasal": 10,
   "ayat": 39,
   "firman": "Karena orang Israel dan orang Lewi harus membawa persembahan khusus dari pada gandum, anggur dan minyak ke bilik-bilik itu. Di situ ada perkakas-perkakas tempat kudus, pula para imam yang menyelenggarakan kebaktian, para penunggu pintu gerbang dan para penyanyi. Kami tidak akan membiarkan rumah Allah kami."
 },
 {
   "id": 12594,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 1,
   "firman": "Para pemimpin bangsa menetap di Yerusalem, sedang orang-orang lain membuang undi untuk menentukan satu dari sepuluh orang yang harus menetap di Yerusalem, kota yang kudus itu, sedang yang sembilan orang lagi tinggal di kota-kota yang lain."
 },
 {
   "id": 12595,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 2,
   "firman": "Orang-orang memuji setiap orang yang rela menetap di Yerusalem."
 },
 {
   "id": 12596,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 3,
   "firman": "Inilah kepala-kepala propinsi Yehuda yang menetap di Yerusalem, sedang di kota-kota di Yehuda setiap orang, yakni orang-orang Israel awam, para imam, orang-orang Lewi, para budak di bait Allah dan keturunan para hamba Salomo, tinggal di tanah miliknya, di kotanya sendiri."
 },
 {
   "id": 12597,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 4,
   "firman": "Di Yerusalem tinggal orang-orang dari bani Yehuda dan bani Benyamin. Dari anak-anak Yehuda: Ataya bin Uzia bin Zakharia bin Amarya bin Sefaca bin Mahalaleel dari bani Peres,"
 },
 {
   "id": 12598,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 5,
   "firman": "dan Maaseya bin Barukh bin Kolhoze bin Hazaya bin Adaya bin Yoyarib bin Zakharia keturunan orang Syela."
 },
 {
   "id": 12599,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 6,
   "firman": "Semua bani Peres yang tinggal di Yerusalem berjumlah empat ratus enam puluh delapan orang yang gagah perkasa."
 },
 {
   "id": 12600,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 7,
   "firman": "Dan inilah bani Benyamin: Salu bin Mesulam bin Yoed bin Pedaya bin Kolaya bin Maaseya bin Itiel bin Yesaya."
 },
 {
   "id": 12601,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 8,
   "firman": "Dan sesudah dia: Gabai, Salai: sembilan ratus dua puluh delapan orang."
 },
 {
   "id": 12602,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 9,
   "firman": "Yoel bin Zikhri adalah pengawas mereka, sedang Yehuda bin Hasenua adalah wakil penguasa kota."
 },
 {
   "id": 12603,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 10,
   "firman": "Dari para imam: Yedaya bin Yoyarib, Yakhin,"
 },
 {
   "id": 12604,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 11,
   "firman": "Seraya bin Hilkia bin Mesulam bin Zadok bin Merayot bin Ahitub, pemuka rumah Allah,"
 },
 {
   "id": 12605,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 12,
   "firman": "dan saudara-saudara mereka yang bertugas di rumah itu: delapan ratus dua puluh dua orang. Pula Adaya bin Yeroham bin Pelalya bin Amzi bin Zakharia bin Pasyhur bin Malkia"
 },
 {
   "id": 12606,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 13,
   "firman": "dan saudara-saudaranya, kepala-kepala kaum keluarga: dua ratus empat puluh dua orang. Dan Amasai bin Asareel bin Ahzai bin Mesilemot bin Imer,"
 },
 {
   "id": 12607,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 14,
   "firman": "dan saudara-saudara mereka, pahlawan-pahlawan yang gagah perkasa, seratus dua puluh delapan orang dengan Zabdiel bin Gedolim sebagai pengawas mereka."
 },
 {
   "id": 12608,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 15,
   "firman": "Dari orang-orang Lewi: Semaya bin Hasub bin Azrikam bin Hasabya bin Buni."
 },
 {
   "id": 12609,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 16,
   "firman": "Pula Sabetai dan Yozabad, kepala-kepala orang-orang Lewi, yang mengawasi pekerjaan di luar rumah Allah."
 },
 {
   "id": 12610,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 17,
   "firman": "Lalu Matanya bin Mikha bin Zabdi bin Asaf, pemimpin yang mengangkat nyanyian syukur dalam doa, dan Bakbukya, orang kedua di antara saudara-saudaranya, dan Abda bin Samua bin Galal bin Yedutun."
 },
 {
   "id": 12611,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 18,
   "firman": "Semua orang Lewi di kota kudus ada dua ratus delapan puluh empat orang."
 },
 {
   "id": 12612,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 19,
   "firman": "Para penunggu pintu gerbang: Akub dan Talmon dengan saudara-saudara mereka yang mengadakan penjagaan di pintu-pintu gerbang, berjumlah seratus tujuh puluh dua orang."
 },
 {
   "id": 12613,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 20,
   "firman": "Selebihnya dari orang-orang Israel awam dan dari para imam dan orang-orang Lewi ada di semua kota Yehuda, masing-masing di tanah pusakanya."
 },
 {
   "id": 12614,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 21,
   "firman": "Tetapi para budak di bait Allah tinggal di Ofel. Ziha dan Gispa adalah pemimpin para budak di bait Allah itu."
 },
 {
   "id": 12615,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 22,
   "firman": "Pengawas orang-orang Lewi di Yerusalem adalah Uzi bin Bani bin Hasabya bin Matanya bin Mikha dari bani Asaf, yakni para penyanyi yang menyanyi sementara berlangsung kebaktian di rumah Allah."
 },
 {
   "id": 12616,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 23,
   "firman": "Karena mengenai mereka ada perintah raja yang menetapkan peraturan untuk para penyanyi menurut keperluan setiap hari."
 },
 {
   "id": 12617,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 24,
   "firman": "Petahya bin Mesezabeel dari bani Zerah bin Yehuda diperbantukan kepada raja untuk segala urusan mengenai bangsa itu."
 },
 {
   "id": 12618,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 25,
   "firman": "Tentang tempat-tempat kediaman di daerah perladangan, sebagian dari bani Yehuda tinggal di Kiryat-Arba dan segala anak kotanya, di Dibon dan segala anak kotanya dan di Yekabzeel dan desa-desanya;"
 },
 {
   "id": 12619,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 26,
   "firman": "di Yesua, di Molada dan Bet-Pelet,"
 },
 {
   "id": 12620,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 27,
   "firman": "di Hazar-Sual, di Bersyeba dan segala anak kotanya,"
 },
 {
   "id": 12621,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 28,
   "firman": "di Ziklag, di Mekhona dan segala anak kotanya,"
 },
 {
   "id": 12622,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 29,
   "firman": "di En-Rimon, Zora, Yarmut,"
 },
 {
   "id": 12623,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 30,
   "firman": "Zanoah, Adulam dan desa-desanya, di Lakhis dan ladang-ladangnya, dan di Azeka dan segala anak kotanya. Demikianlah mereka berkampung dari Bersyeba sampai lebak Hinom."
 },
 {
   "id": 12624,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 31,
   "firman": "Dan bani Benyamin tinggal mulai dari Geba, di Mikhmas, di Aya, di Betel dan segala anak kotanya,"
 },
 {
   "id": 12625,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 32,
   "firman": "di Anatot, Nob dan Ananya,"
 },
 {
   "id": 12626,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 33,
   "firman": "di Hazor, Rama dan Gitaim,"
 },
 {
   "id": 12627,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 34,
   "firman": "di Hadid, Zeboim dan Nebalat,"
 },
 {
   "id": 12628,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 35,
   "firman": "di Lod dan di Ono, Lembah Tukang-tukang."
 },
 {
   "id": 12629,
   "kitab": "Neh",
   "pasal": 11,
   "ayat": 36,
   "firman": "Beberapa rombongan orang Lewi dari Yehuda bergabung dengan orang Benyamin."
 },
 {
   "id": 12630,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 1,
   "firman": "Inilah para imam dan orang-orang Lewi yang berangkat pulang bersama-sama Zerubabel bin Sealtiel dan Yesua: Seraya, Yeremia, Ezra,"
 },
 {
   "id": 12631,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 2,
   "firman": "Amarya, Malukh, Hatus,"
 },
 {
   "id": 12632,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 3,
   "firman": "Sekhanya, Rehum, Meremot,"
 },
 {
   "id": 12633,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 4,
   "firman": "Ido, Ginetoi, Abia,"
 },
 {
   "id": 12634,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 5,
   "firman": "Miyamin, Maaja, Bilga,"
 },
 {
   "id": 12635,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 6,
   "firman": "Semaya, Yoyarib, Yedaya,"
 },
 {
   "id": 12636,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 7,
   "firman": "Salu, Amok, Hilkia dan Yedaya. Itulah kepala-kepala imam dan saudara-saudara mereka pada zaman Yesua."
 },
 {
   "id": 12637,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 8,
   "firman": "Dari orang-orang Lewi: Yesua, Binui, Kadmiel, Serebya, Yehuda dan Matanya. Matanya ini dan saudara-saudaranya memimpin nyanyian syukur,"
 },
 {
   "id": 12638,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 9,
   "firman": "sementara Bakbukya dan Uni dan saudara-saudara mereka berdiri di hadapan mereka itu menurut kelompok-kelompok tugas."
 },
 {
   "id": 12639,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 10,
   "firman": "Yesua memperanakkan Yoyakim, dan Yoyakim memperanakkan Elyasib, dan Elyasib memperanakkan Yoyada,"
 },
 {
   "id": 12640,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 11,
   "firman": "dan Yoyada memperanakkan Yonatan, dan Yonatan memperanakkan Yadua."
 },
 {
   "id": 12641,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 12,
   "firman": "Pada zaman Yoyakim yang menjadi imam adalah kepala-kepala kaum keluarga ini: Meraya, dari kaum keluarga Seraya, Hananya dari kaum keluarga Yeremia,"
 },
 {
   "id": 12642,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 13,
   "firman": "Mesulam dari kaum keluarga Ezra, Yohanan dari kaum keluarga Amarya,"
 },
 {
   "id": 12643,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 14,
   "firman": "Yonatan dari kaum keluarga Melikhu, Yusuf dari kaum keluarga Sebanya,"
 },
 {
   "id": 12644,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 15,
   "firman": "Adna dari kaum keluarga Harim, Helkai dari kaum keluarga Merayot,"
 },
 {
   "id": 12645,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 16,
   "firman": "Zakharia dari kaum keluarga Ido, Mesulam dari kaum keluarga Gineton,"
 },
 {
   "id": 12646,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 17,
   "firman": "Zikhri dari kaum keluarga Abia, dari kaum keluarga Minyamin, Piltai dari kaum keluarga Moaja,"
 },
 {
   "id": 12647,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 18,
   "firman": "Samua dari kaum keluarga Bilga, Yonatan dari kaum keluarga Semaya,"
 },
 {
   "id": 12648,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 19,
   "firman": "Matnai dari kaum keluarga Yoyarib, Uzi dari kaum keluarga Yedaya,"
 },
 {
   "id": 12649,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 20,
   "firman": "Kalai dari kaum keluarga Salai, Heber dari kaum keluarga Amok,"
 },
 {
   "id": 12650,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 21,
   "firman": "Hasabya dari kaum keluarga Hilkia dan Netaneel dari kaum keluarga Yedaya."
 },
 {
   "id": 12651,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 22,
   "firman": "Tentang orang-orang Lewi, para kepala kaum keluarga mereka tercatat pada zaman Elyasib, Yoyada, Yohanan dan Yadua, sedang para imam tercatat sampai pemerintahan Darius, orang Persia itu."
 },
 {
   "id": 12652,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 23,
   "firman": "Kepala-kepala kaum keluarga anak-anak Lewi tercatat dalam kitab sejarah sampai zaman Yohanan bin Elyasib."
 },
 {
   "id": 12653,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 24,
   "firman": "Inilah para kepala orang-orang Lewi: Hasabya, Serebya, Yesua bin Kadmiel, dan saudara-saudara mereka yang berdiri di hadapan mereka untuk menyanyikan puji-pujian dan syukur sesuai dengan perintah Daud, abdi Allah itu, kelompok di samping kelompok."
 },
 {
   "id": 12654,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 25,
   "firman": "Matanya, Bakbukya, Obaja, Mesulam, Talmon dan Akub adalah penunggu-penunggu pintu gerbang yang mengadakan penjagaan di gudang-gudang perlengkapan pada pintu-pintu gerbang."
 },
 {
   "id": 12655,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 26,
   "firman": "Mereka itu hidup pada zaman Yoyakim bin Yesua bin Yozadak dan pada zaman bupati Nehemia dan imam Ezra, ahli kitab itu."
 },
 {
   "id": 12656,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 27,
   "firman": "Pada pentahbisan tembok Yerusalem orang-orang Lewi dipanggil dari segala tempat mereka dan dibawa ke Yerusalem untuk mengadakan pentahbisan yang meriah dengan ucapan syukur dan kidung, dengan ceracap, gambus dan kecapi."
 },
 {
   "id": 12657,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 28,
   "firman": "Maka berkumpullah kaum penyanyi dari daerah sekitar Yerusalem, dari desa-desa orang Netofa,"
 },
 {
   "id": 12658,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 29,
   "firman": "dari Bet-Gilgal, dari padang Geba dan Asmawet, karena para penyanyi itu telah mendirikan desa-desa sekitar Yerusalem."
 },
 {
   "id": 12659,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 30,
   "firman": "Para imam dan orang-orang Lewi mentahirkan dirinya, lalu mentahirkan seluruh umat itu, dan kemudian pintu-pintu gerbang dan tembok."
 },
 {
   "id": 12660,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 31,
   "firman": "Lalu aku mempersilakan para pemimpin orang Yehuda naik ke atas tembok dan kubentuk dua paduan suara yang besar. Yang satu berarak ke kanan di atas tembok ke jurusan pintu gerbang Sampah."
 },
 {
   "id": 12661,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 32,
   "firman": "Di belakangnya berjalanlah Hosaya dengan sebagian dari para pemimpin orang Yehuda,"
 },
 {
   "id": 12662,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 33,
   "firman": "pula Azarya, Ezra, Mesulam,"
 },
 {
   "id": 12663,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 34,
   "firman": "Yehuda, Benyamin, Semaya dan Yeremia,"
 },
 {
   "id": 12664,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 35,
   "firman": "dan dari kaum imam yang memegang nafiri: Zakharia bin Yonatan bin Semaya bin Matanya bin Mikha bin Zakur bin Asaf,"
 },
 {
   "id": 12665,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 36,
   "firman": "dan saudara-saudaranya, yakni: Semaya, Azareel, Milalai, Gilalai, Maai, Netaneel, Yehuda dan Hanani dengan bunyi-bunyian Daud, abdi Allah itu, sedang Ezra, ahli kitab itu berjalan di depan mereka."
 },
 {
   "id": 12666,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 37,
   "firman": "Lalu pada pintu gerbang Mata Air mereka langsung naik tangga-tangga kota Daud, pada jalan pendakian tembok, lewat istana Daud, dan berjalan sampai pintu gerbang Air, di sebelah Timur."
 },
 {
   "id": 12667,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 38,
   "firman": "Dan paduan suara yang kedua berarak ke kiri dan aku mengikutinya dengan sebagian dari orang-orang itu melalui tembok dan menara Perapian sampai tembok Lebar."
 },
 {
   "id": 12668,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 39,
   "firman": "Lalu kami melalui pintu gerbang Efraim, pintu gerbang Lama, pintu gerbang Ikan, menara Hananeel dan menara Mea sampai pintu gerbang Domba. Mereka berhenti di pintu gerbang Penjagaan."
 },
 {
   "id": 12669,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 40,
   "firman": "Kemudian kedua paduan suara itu berdiri di rumah Allah. Demikian juga aku bersama-sama sebagian dari para penguasa,"
 },
 {
   "id": 12670,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 41,
   "firman": "dan para imam, yakni: Elyakim, Maaseya, Minyamin, Mikha, Elyoenai, Zakharia, Hananya dengan memegang nafiri,"
 },
 {
   "id": 12671,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 42,
   "firman": "dan Maaseya, Semaya, Eleazar, Uzi, Yohanan, Malkia, Elam dan Ezer. Lalu para penyanyi memperdengarkan kidung di bawah pimpinan Yizrahya."
 },
 {
   "id": 12672,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 43,
   "firman": "Pada hari itu mereka mempersembahkan korban yang besar. Mereka bersukaria karena Allah memberi mereka kesukaan yang besar. Juga segala perempuan dan anak-anak bersukaria, sehingga kesukaan Yerusalem terdengar sampai jauh."
 },
 {
   "id": 12673,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 44,
   "firman": "Pada masa itu beberapa orang diangkat untuk mengawasi bilik-bilik perbendaharaan, bilik-bilik untuk persembahan khusus, untuk hasil pertama dan untuk persembahan persepuluhan, supaya sumbangan yang menurut hukum menjadi bagian para imam dan orang-orang Lewi dikumpulkan di bilik-bilik itu sesuai dengan ladang setiap kota. Sebab Yehuda bersukacita karena para imam dan orang-orang Lewi yang bertugas."
 },
 {
   "id": 12674,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 45,
   "firman": "Karena merekalah yang melakukan tugas pelayanan bagi Allah mereka dan tugas pentahiran, demikian juga para penyanyi dan para penunggu pintu gerbang, sesuai dengan perintah Daud dan Salomo, anaknya."
 },
 {
   "id": 12675,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 46,
   "firman": "Karena sudah sejak dahulu, pada zaman Daud dan Asaf, ada pemimpin-pemimpin penyanyi, ada nyanyian pujian dan nyanyian syukur bagi Allah."
 },
 {
   "id": 12676,
   "kitab": "Neh",
   "pasal": 12,
   "ayat": 47,
   "firman": "Pada zaman Zerubabel dan Nehemia semua orang Israel memberikan sumbangan bagi para penyanyi dan para penunggu pintu gerbang sekadar yang perlu tiap-tiap hari dan mempersembahkan persembahan kudus kepada orang-orang Lewi. Dan orang-orang Lewi mempersembahkan persembahan kudus kepada anak-anak Harun."
 },
 {
   "id": 12677,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 1,
   "firman": "Pada masa itu bagian-bagian dari pada kitab Musa dibacakan dengan didengar oleh rakyat. Didapati tertulis dalam kitab itu, bahwa orang Amon dan orang Moab tidak boleh masuk jemaah Allah untuk selamanya."
 },
 {
   "id": 12678,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 2,
   "firman": "Karena mereka tidak menyongsong orang Israel dengan roti dan air, malah mengupah Bileam melawan orang Israel supaya dikutukinya. Tetapi Allah kami mengubah kutuk itu menjadi berkat."
 },
 {
   "id": 12679,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 3,
   "firman": "Ketika mereka mendengar pembacaan Taurat itu mereka memisahkan semua peranakan dari orang Israel."
 },
 {
   "id": 12680,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 4,
   "firman": "Tetapi sebelum masa itu imam Elyasib yang diangkat untuk mengawasi bilik-bilik rumah Allah kami, dan yang mempunyai hubungan erat dengan Tobia,"
 },
 {
   "id": 12681,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 5,
   "firman": "menyediakan sebuah bilik besar bagi Tobia itu. Sebelumnya orang membawa ke bilik itu korban sajian, kemenyan, perkakas-perkakas dan persembahan persepuluhan dari pada gandum, anggur dan minyak yang menjadi hak orang-orang Lewi, para penyanyi dan para penunggu pintu gerbang, dan persembahan khusus bagi para imam."
 },
 {
   "id": 12682,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 6,
   "firman": "Ketika peristiwa itu terjadi aku tidak ada di Yerusalem, karena pada tahun ketiga puluh dua pemerintahan Artahsasta, raja Babel, aku pergi menghadap raja. Tetapi sesudah beberapa waktu aku minta izin dari raja untuk pergi."
 },
 {
   "id": 12683,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 7,
   "firman": "Lalu aku tiba di Yerusalem dan melihat kejahatan yang dibuat Elyasib untuk keuntungan Tobia, sebab bagi Tobia ini telah disediakannya sebuah bilik di pelataran rumah Allah."
 },
 {
   "id": 12684,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 8,
   "firman": "Aku menjadi sangat kesal, lalu kulempar semua perabot rumah Tobia ke luar bilik itu."
 },
 {
   "id": 12685,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 9,
   "firman": "Kemudian kusuruh tahirkan bilik itu, sesudah itu kubawa kembali ke sana perkakas-perkakas rumah Allah, korban sajian dan kemenyan."
 },
 {
   "id": 12686,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 10,
   "firman": "Juga kudapati bahwa sumbangan-sumbangan bagi orang-orang Lewi tidak pernah diberikan, sehingga orang-orang Lewi dan para penyanyi yang bertugas masing-masing lari ke ladangnya."
 },
 {
   "id": 12687,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 11,
   "firman": "Aku menyesali para penguasa, kataku: \"Mengapa rumah Allah dibiarkan begitu saja?\" Lalu kukumpulkan orang-orang Lewi itu dan kukembalikan pada tempatnya."
 },
 {
   "id": 12688,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 12,
   "firman": "Maka seluruh orang Yehuda membawa lagi persembahan persepuluhan dari pada gandum, anggur dan minyak ke perbendaharaan."
 },
 {
   "id": 12689,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 13,
   "firman": "Sebagai pengawas-pengawas perbendaharaan kuangkat imam Selemya dan Zadok, seorang ahli kitab, dan Pedaya, seorang Lewi, sedang Hanan bin Zakur bin Matanya diperbantukan kepada mereka, karena orang-orang itu dianggap setia. Mereka diserahi tugas untuk mengurus pembagian kepada saudara-saudara mereka."
 },
 {
   "id": 12690,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 14,
   "firman": "Ya Allahku, ingatlah kepadaku karena hal itu dan janganlah hapuskan segala perbuatan bakti yang telah kulakukan terhadap rumah Allahku dan segala pelayanan di dalamnya!"
 },
 {
   "id": 12691,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 15,
   "firman": "Pada masa itu kulihat di Yehuda orang-orang mengirik memeras anggur pada hari Sabat, pula orang-orang yang membawa berkas-berkas gandum dan memuatnya di atas keledai, juga anggur, buah anggur dan buah ara dan pelbagai muatan yang mereka bawa ke Yerusalem pada hari Sabat. Aku memperingatkan mereka ketika mereka menjual bahan-bahan makanan."
 },
 {
   "id": 12692,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 16,
   "firman": "Juga orang Tirus yang tinggal di situ membawa ikan dan pelbagai barang dagangan dan menjual itu kepada orang-orang Yehuda pada hari Sabat, bahkan di Yerusalem."
 },
 {
   "id": 12693,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 17,
   "firman": "Lalu aku menyesali pemuka-pemuka orang Yehuda, kataku kepada mereka: \"Kejahatan apa yang kamu lakukan ini dengan melanggar kekudusan hari Sabat?"
 },
 {
   "id": 12694,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 18,
   "firman": "Bukankah nenek moyangmu telah berbuat demikian, sehingga Allah kita mendatangkan seluruh malapetaka ini atas kita dan atas kota ini? Apakah kamu bermaksud memperbesar murka yang menimpa Israel dengan melanggar kekudusan hari Sabat?\""
 },
 {
   "id": 12695,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kalau sudah remang-remang di pintu-pintu gerbang Yerusalem menjelang hari Sabat, kusuruh tutup pintu-pintu dan kuperintahkan supaya jangan dibuka sampai lewat hari Sabat. Dan aku tempatkan beberapa orang dari anak buahku di pintu-pintu gerbang, supaya tidak ada muatan yang masuk pada hari Sabat."
 },
 {
   "id": 12696,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 20,
   "firman": "Tetapi orang-orang yang berdagang dan berjualan rupa-rupa barang itu kemudian bermalam juga di luar tembok Yerusalem satu dua kali."
 },
 {
   "id": 12697,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 21,
   "firman": "Lalu aku memperingatkan mereka, kataku: \"Mengapa kamu bermalam di depan tembok? Kalau kamu berbuat itu sekali lagi akan kukenakan tanganku kepadamu.\" Sejak waktu itu mereka tidak datang lagi pada hari Sabat."
 },
 {
   "id": 12698,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 22,
   "firman": "Juga kusuruh orang-orang Lewi mentahirkan dirinya dan datang menjaga pintu-pintu gerbang untuk menguduskan hari Sabat. Ya Allahku, ingatlah kepadaku juga karena hal itu dan sayangilah aku menurut kasih setia-Mu yang besar!"
 },
 {
   "id": 12699,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 23,
   "firman": "Pada masa itu juga kulihat bahwa beberapa orang Yahudi memperisteri perempuan-perempuan Asdod, perempuan-perempuan Amon atau perempuan-perempuan Moab."
 },
 {
   "id": 12700,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 24,
   "firman": "Sebagian dari anak-anak mereka berbicara bahasa Asdod atau bahasa bangsa lain itu dan tidak tahu berbicara bahasa Yahudi."
 },
 {
   "id": 12701,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 25,
   "firman": "Aku menyesali mereka, kukutuki mereka, dan beberapa orang di antara mereka kupukuli dan kucabut rambutnya dan kusuruh mereka bersumpah demi Allah, demikian: \"Jangan sekali-kali kamu serahkan anak-anak perempuanmu kepada anak-anak lelaki mereka, atau mengambil anak-anak perempuan mereka sebagai isteri untuk anak-anak lelakimu atau untuk dirimu sendiri!"
 },
 {
   "id": 12702,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 26,
   "firman": "Bukankah Salomo, raja Israel, telah berbuat dosa karena hal semacam itu? Walaupun di antara begitu banyak bangsa tidak ada seorang raja seperti dia, yang dikasihi Allahnya dan diangkat oleh Allah itu menjadi raja seluruh Israel, namun diapun terbawa ke dalam dosa oleh perempuan-perempuan asing itu."
 },
 {
   "id": 12703,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 27,
   "firman": "Apakah orang harus mendengar bahwa juga kamu berbuat segala kejahatan yang besar itu, yakni berubah setia terhadap Allah kita karena memperisteri perempuan-perempuan asing?\""
 },
 {
   "id": 12704,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 28,
   "firman": "Seorang dari anak-anak Yoyada bin Elyasib, imam besar itu, adalah menantu Sanbalat, orang Horoni itu. Oleh sebab itu kuusir dia dari padaku."
 },
 {
   "id": 12705,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 29,
   "firman": "Ya Allahku, ingatlah bagaimana mereka mencemarkan jabatan imam serta perjanjian mengenai para imam dan orang-orang Lewi."
 },
 {
   "id": 12706,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 30,
   "firman": "Kutahirkan mereka dari segala sesuatu yang asing dan kutetapkan tugas-tugas untuk para imam dan orang-orang Lewi, masing-masing dalam bidang pekerjaannya,"
 },
 {
   "id": 12707,
   "kitab": "Neh",
   "pasal": 13,
   "ayat": 31,
   "firman": "pula kutetapkan suatu cara untuk menyediakan kayu api pada waktu-waktu tertentu dan untuk hasil-hasil yang pertama. Ya Allahku, ingatlah kepadaku, demi kesejahteraanku!"
 },
 {
   "id": 12708,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada zaman Ahasyweros--dialah Ahasyweros yang merajai seratus dua puluh tujuh daerah mulai dari India sampai ke Etiopia--,"
 },
 {
   "id": 12709,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 2,
   "firman": "pada zaman itu, ketika raja Ahasyweros bersemayam di atas takhta kerajaannya di dalam benteng Susan,"
 },
 {
   "id": 12710,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 3,
   "firman": "pada tahun yang ketiga dalam pemerintahannya, diadakanlah oleh baginda perjamuan bagi semua pembesar dan pegawainya; tentara Persia dan Media, kaum bangsawan dan pembesar daerah hadir di hadapan baginda."
 },
 {
   "id": 12711,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 4,
   "firman": "Di samping itu baginda memamerkan kekayaan kemuliaan kerajaannya dan keindahan kebesarannya yang bersemarak, berhari-hari lamanya, sampai seratus delapan puluh hari."
 },
 {
   "id": 12712,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 5,
   "firman": "Setelah genap hari-hari itu, maka raja mengadakan perjamuan lagi tujuh hari lamanya bagi seluruh rakyatnya yang terdapat di dalam benteng Susan, dari pada orang besar sampai kepada orang kecil, bertempat di pelataran yang ada di taman istana kerajaan."
 },
 {
   "id": 12713,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 6,
   "firman": "Di situ tirai-mirai dari pada kain lenan, mori halus dan kain ungu tua, yang terikat dengan tali lenan halus dan ungu muda bergantung pada tombol-tombol perak di tiang-tiang marmar putih, sedang katil emas dan perak ditempatkan di atas lantai pualam, marmar putih, gewang dan pelinggam."
 },
 {
   "id": 12714,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 7,
   "firman": "Minuman dihidangkan dalam piala emas yang beraneka warna, dan anggurnya ialah anggur minuman raja yang berlimpah-limpah, sebagaimana layak bagi raja."
 },
 {
   "id": 12715,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 8,
   "firman": "Adapun aturan minum ialah: tiada dengan paksa; karena beginilah disyaratkan raja kepada semua bentara dalam, supaya mereka berbuat menurut keinginan tiap-tiap orang."
 },
 {
   "id": 12716,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 9,
   "firman": "Juga Wasti, sang ratu, mengadakan perjamuan bagi semua perempuan di dalam istana raja Ahasyweros."
 },
 {
   "id": 12717,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 10,
   "firman": "Pada hari yang ketujuh, ketika raja riang gembira hatinya karena minum anggur, bertitahlah baginda kepada Mehuman, Bizta, Harbona, Bigta, Abagta, Zetar dan Karkas, yakni ketujuh sida-sida yang bertugas di hadapan raja Ahasyweros,"
 },
 {
   "id": 12718,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 11,
   "firman": "supaya mereka membawa Wasti, sang ratu, dengan memakai mahkota kerajaan, menghadap raja untuk memperlihatkan kecantikannya kepada sekalian rakyat dan pembesar-pembesar, karena sang ratu sangat elok rupanya."
 },
 {
   "id": 12719,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi ratu Wasti menolak untuk menghadap menurut titah raja yang disampaikan oleh sida-sida itu, sehingga sangat geramlah raja dan berapi-apilah murkanya."
 },
 {
   "id": 12720,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 13,
   "firman": "Maka bertanyalah raja kepada orang-orang arif bijaksana, orang-orang yang mengetahui kebiasaan zaman--karena demikianlah biasanya masalah-masalah raja dikemukakan kepada para ahli undang-undang dan hukum;"
 },
 {
   "id": 12721,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 14,
   "firman": "adapun yang terdekat kepada baginda ialah Karsena, Setar, Admata, Tarsis, Meres, Marsena dan Memukan, ketujuh pembesar Persia dan Media, yang boleh memandang wajah raja dan yang mempunyai kedudukan yang tinggi di dalam kerajaan--,tanya raja:"
 },
 {
   "id": 12722,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 15,
   "firman": "\"Apakah yang harus diperbuat atas ratu Wasti menurut undang-undang, karena tidak dilakukannya titah raja Ahasyweros yang disampaikan oleh sida-sida?\""
 },
 {
   "id": 12723,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 16,
   "firman": "Maka sembah Memukan di hadapan raja dan para pembesar itu: \"Wasti, sang ratu, bukan bersalah kepada raja saja, melainkan juga kepada semua pembesar dan segala bangsa yang di dalam segala daerah raja Ahasyweros."
 },
 {
   "id": 12724,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 17,
   "firman": "Karena kelakuan sang ratu itu akan merata kepada semua perempuan, sehingga mereka tidak menghiraukan suaminya, apabila diceritakan orang: Raja Ahasyweros menitahkan, supaya Wasti, sang ratu, dibawa menghadap kepadanya, tetapi ia tidak mau datang."
 },
 {
   "id": 12725,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 18,
   "firman": "Pada hari ini juga isteri para pembesar raja di Persia dan Media yang mendengar tentang kelakuan sang ratu akan berbicara tentang hal itu kepada suaminya, sehingga berlarut-larutlah penghinaan dan kegusaran."
 },
 {
   "id": 12726,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 19,
   "firman": "Jikalau baik pada pemandangan raja, hendaklah dikeluarkan suatu titah kerajaan dari hadapan baginda dan dituliskan di dalam undang-undang Persia dan Media, sehingga tidak dapat dicabut kembali, bahwa Wasti dilarang menghadap raja Ahasyweros, dan bahwa raja akan mengaruniakan kedudukannya sebagai ratu kepada orang lain yang lebih baik dari padanya."
 },
 {
   "id": 12727,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 20,
   "firman": "Bila keputusan yang diambil raja kedengaran di seluruh kerajaannya--alangkah besarnya kerajaan itu! --,maka semua perempuan akan memberi hormat kepada suami mereka, dari pada orang besar sampai kepada orang kecil.\""
 },
 {
   "id": 12728,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 21,
   "firman": "Usul itu dipandang baik oleh raja serta para pembesar, jadi bertindaklah raja sesuai dengan usul Memukan itu."
 },
 {
   "id": 12729,
   "kitab": "Est",
   "pasal": 1,
   "ayat": 22,
   "firman": "Dikirimkanlah oleh baginda surat-surat ke segenap daerah kerajaan, tiap-tiap daerah menurut tulisannya dan tiap-tiap bangsa menurut bahasanya, bunyinya: \"Setiap laki-laki harus menjadi kepala dalam rumah tangganya dan berbicara menurut bahasa bangsanya.\""
 },
 {
   "id": 12730,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 1,
   "firman": "Sesudah peristiwa-peristiwa ini, setelah kepanasan murka raja Ahasyweros surut, terkenanglah baginda kepada Wasti dan yang dilakukannya, dan kepada apa yang diputuskan atasnya."
 },
 {
   "id": 12731,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 2,
   "firman": "Maka sembah para biduanda raja yang bertugas pada baginda: \"Hendaklah orang mencari bagi raja gadis-gadis, yaitu anak-anak dara yang elok rupanya;"
 },
 {
   "id": 12732,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 3,
   "firman": "hendaklah raja menempatkan kuasa-kuasa di segenap daerah kerajaannya, supaya mereka mengumpulkan semua gadis, anak-anak dara yang elok rupanya, di dalam benteng Susan, di balai perempuan, di bawah pengawasan Hegai, sida-sida raja, penjaga para perempuan; hendaklah diberikan wangi-wangian kepada mereka."
 },
 {
   "id": 12733,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 4,
   "firman": "Dan gadis yang terbaik pada pemandangan raja, baiklah dia menjadi ratu ganti Wasti.\" Hal itu dipandang baik oleh raja, dan dilakukanlah demikian."
 },
 {
   "id": 12734,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 5,
   "firman": "Pada waktu itu ada di dalam benteng Susan seorang Yahudi, yang bernama Mordekhai bin Yair bin Simei bin Kish, seorang Benyamin"
 },
 {
   "id": 12735,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 6,
   "firman": "yang diangkut dari Yerusalem sebagai salah seorang buangan yang turut dengan Yekhonya, raja Yehuda, ketika ia diangkut ke dalam pembuangan oleh raja Nebukadnezar, raja Babel."
 },
 {
   "id": 12736,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 7,
   "firman": "Mordekhai itu pengasuh Hadasa, yakni Ester, anak saudara ayahnya, sebab anak itu tidak beribu bapa lagi; gadis itu elok perawakannya dan cantik parasnya. Ketika ibu bapanya mati, ia diangkat sebagai anak oleh Mordekhai."
 },
 {
   "id": 12737,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 8,
   "firman": "Setelah titah dan undang-undang raja tersiar dan banyak gadis dikumpulkan di dalam benteng Susan, di bawah pengawasan Hegai, maka Esterpun dibawa masuk ke dalam istana raja, di bawah pengawasan Hegai, penjaga para perempuan."
 },
 {
   "id": 12738,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka gadis itu sangat baik pada pemandangannya dan menimbulkan kasih sayangnya, sehingga Hegai segera memberikan wangi-wangian dan pelabur kepadanya, dan juga tujuh orang dayang-dayang yang terpilih dari isi istana raja, kemudian memindahkan dia dengan dayang-dayangnya ke bagian yang terbaik di dalam balai perempuan."
 },
 {
   "id": 12739,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ester tidak memberitahukan kebangsaan dan asal usulnya, karena dilarang oleh Mordekhai."
 },
 {
   "id": 12740,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 11,
   "firman": "Tiap-tiap hari berjalan-jalanlah Mordekhai di depan pelataran balai perempuan itu untuk mengetahui bagaimana keadaan Ester dan apa yang akan berlaku atasnya."
 },
 {
   "id": 12741,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 12,
   "firman": "Tiap-tiap kali seorang gadis mendapat giliran untuk masuk menghadap raja Ahasyweros, dan sebelumnya ia dirawat menurut peraturan bagi para perempuan selama dua belas bulan, sebab seluruh waktu itu digunakan untuk pemakaian wangi-wangian: enam bulan untuk memakai minyak mur dan enam bulan lagi untuk memakai minyak kasai serta lain-lain wangi-wangian perempuan."
 },
 {
   "id": 12742,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 13,
   "firman": "Lalu gadis itu masuk menghadap raja, dan segala apa yang dimintanya harus diberikan kepadanya untuk dibawa masuk dari balai perempuan ke dalam istana raja."
 },
 {
   "id": 12743,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 14,
   "firman": "Pada waktu petang ia masuk dan pada waktu pagi ia kembali, tetapi sekali ini ke dalam balai perempuan yang kedua, di bawah pengawasan Saasgas, sida-sida raja, penjaga para gundik. Ia tidak diperkenankan masuk lagi menghadap raja, kecuali jikalau raja berkenan kepadanya dan ia dipanggil dengan disebutkan namanya."
 },
 {
   "id": 12744,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ketika Ester--anak Abihail, yakni saudara ayah Mordekhai yang mengangkat Ester sebagai anak--mendapat giliran untuk masuk menghadap raja, maka ia tidak menghendaki sesuatu apapun selain dari pada yang dianjurkan oleh Hegai, sida-sida raja, penjaga para perempuan. Maka Ester dapat menimbulkan kasih sayang pada semua orang yang melihat dia."
 },
 {
   "id": 12745,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 16,
   "firman": "Demikianlah Ester dibawa masuk menghadap raja Ahasyweros ke dalam istananya pada bulan yang kesepuluh--yakni bulan Tebet--pada tahun yang ketujuh dalam pemerintahan baginda."
 },
 {
   "id": 12746,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 17,
   "firman": "Maka Ester dikasihi oleh baginda lebih dari pada semua perempuan lain, dan ia beroleh sayang dan kasih baginda lebih dari pada semua anak dara lain, sehingga baginda mengenakan mahkota kerajaan ke atas kepalanya dan mengangkat dia menjadi ratu ganti Wasti."
 },
 {
   "id": 12747,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 18,
   "firman": "Kemudian diadakanlah oleh baginda suatu perjamuan bagi semua pembesar dan pegawainya, yakni perjamuan karena Ester, dan baginda menitahkan kebebasan pajak bagi daerah-daerah serta mengaruniakan anugerah, sebagaimana layak bagi raja."
 },
 {
   "id": 12748,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 19,
   "firman": "Selama anak-anak dara dikumpulkan untuk kedua kalinya, Mordekhai duduk di pintu gerbang istana raja."
 },
 {
   "id": 12749,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 20,
   "firman": "Adapun Ester tidak memberitahukan asal usul dan kebangsaannya seperti diperintahkan kepadanya oleh Mordekhai, sebab Ester tetap berbuat menurut perkataan Mordekhai seperti pada waktu ia masih dalam asuhannya."
 },
 {
   "id": 12750,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 21,
   "firman": "Pada waktu itu, ketika Mordekhai duduk di pintu gerbang istana raja, sakit hatilah Bigtan dan Teresh, dua orang sida-sida raja yang termasuk golongan penjaga pintu, lalu berikhtiarlah mereka untuk membunuh raja Ahasyweros."
 },
 {
   "id": 12751,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 22,
   "firman": "Tetapi perkara itu dapat diketahui oleh Mordekhai, lalu diberitahukannyalah kepada Ester, sang ratu, dan Ester mempersembahkannya kepada raja atas nama Mordekhai."
 },
 {
   "id": 12752,
   "kitab": "Est",
   "pasal": 2,
   "ayat": 23,
   "firman": "Perkara itu diperiksa dan ternyata benar, maka kedua orang itu disulakan pada tiang. Dan peristiwa itu dituliskan di dalam kitab sejarah, di hadapan raja."
 },
 {
   "id": 12753,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 1,
   "firman": "Sesudah peristiwa-peristiwa ini maka Haman bin Hamedata, orang Agag, dikaruniailah kebesaran oleh raja Ahasyweros, dan pangkatnya dinaikkan serta kedudukannya ditetapkan di atas semua pembesar yang ada di hadapan baginda."
 },
 {
   "id": 12754,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 2,
   "firman": "Dan semua pegawai raja yang di pintu gerbang istana raja berlutut dan sujud kepada Haman, sebab demikianlah diperintahkan raja tentang dia, tetapi Mordekhai tidak berlutut dan tidak sujud."
 },
 {
   "id": 12755,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 3,
   "firman": "Maka para pegawai raja yang di pintu gerbang istana raja berkata kepada Mordekhai: \"Mengapa engkau melanggar perintah raja?\""
 },
 {
   "id": 12756,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 4,
   "firman": "Setelah mereka menegor dia berhari-hari dengan tidak didengarkannya juga, maka hal itu diberitahukan merekalah kepada Haman untuk melihat, apakah sikap Mordekhai itu dapat tetap, sebab ia telah menceritakan kepada mereka, bahwa ia orang Yahudi."
 },
 {
   "id": 12757,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 5,
   "firman": "Ketika Haman melihat, bahwa Mordekhai tidak berlutut dan sujud kepadanya, maka sangat panaslah hati Haman,"
 },
 {
   "id": 12758,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 6,
   "firman": "tetapi ia menganggap dirinya terlalu hina untuk membunuh hanya Mordekhai saja, karena orang telah memberitahukan kepadanya kebangsaan Mordekhai itu. Jadi Haman mencari ikhtiar memunahkan semua orang Yahudi, yakni bangsa Mordekhai itu, di seluruh kerajaan Ahasyweros."
 },
 {
   "id": 12759,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 7,
   "firman": "Dalam bulan pertama, yakni bulan Nisan, dalam tahun yang kedua belas zaman raja Ahasyweros, orang membuang pur--yakni undi--di depan Haman, hari demi hari dan bulan demi bulan sampai jatuh pada bulan yang kedua belas, yakni bulan Adar."
 },
 {
   "id": 12760,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 8,
   "firman": "Maka sembah Haman kepada raja Ahasyweros: \"Ada suatu bangsa yang hidup tercerai-berai dan terasing di antara bangsa-bangsa di dalam seluruh daerah kerajaan tuanku, dan hukum mereka berlainan dengan hukum segala bangsa, dan hukum raja tidak dilakukan mereka, sehingga tidak patut bagi raja membiarkan mereka leluasa."
 },
 {
   "id": 12761,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 9,
   "firman": "Jikalau baik pada pemandangan raja, hendaklah dikeluarkan surat titah untuk membinasakan mereka; maka hamba akan menimbang perak sepuluh ribu talenta dan menyerahkannya kepada tangan para pejabat yang bersangkutan, supaya mereka memasukkannya ke dalam perbendaharaan raja.\""
 },
 {
   "id": 12762,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 10,
   "firman": "Maka raja mencabut cincin meterainya dari jarinya, lalu diserahkannya kepada Haman bin Hamedata, orang Agag, seteru orang Yahudi itu,"
 },
 {
   "id": 12763,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 11,
   "firman": "kemudian titah raja kepada Haman: \"Perak itu terserah kepadamu, juga bangsa itu untuk kauperlakukan seperti yang kaupandang baik.\""
 },
 {
   "id": 12764,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 12,
   "firman": "Maka dalam bulan yang pertama pada hari yang ketiga belas dipanggillah para panitera raja, lalu, sesuai dengan segala yang diperintahkan Haman, ditulislah surat kepada wakil-wakil raja, kepada setiap bupati yang menguasai daerah dan kepada setiap pembesar bangsa, yakni kepada tiap-tiap daerah menurut tulisannya dan kepada tiap-tiap bangsa menurut bahasanya; surat itu ditulis atas nama raja Ahasyweros dan dimeterai dengan cincin meterai raja."
 },
 {
   "id": 12765,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 13,
   "firman": "Surat-surat itu dikirimkan dengan perantaraan pesuruh-pesuruh cepat ke segala daerah kerajaan, supaya dipunahkan, dibunuh dan dibinasakan semua orang Yahudi dari pada yang muda sampai kepada yang tua, bahkan anak-anak dan perempuan-perempuan, pada satu hari juga, pada tanggal tiga belas bulan yang kedua belas--yakni bulan Adar--,dan supaya dirampas harta milik mereka."
 },
 {
   "id": 12766,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 14,
   "firman": "Salinan surat itu harus diundangkan di dalam tiap-tiap daerah, lalu diumumkan kepada segala bangsa, supaya mereka bersiap-siap untuk hari itu."
 },
 {
   "id": 12767,
   "kitab": "Est",
   "pasal": 3,
   "ayat": 15,
   "firman": "Maka dengan tergesa-gesa berangkatlah pesuruh-pesuruh cepat itu, atas titah raja, dan undang-undang itu dikeluarkan di dalam benteng Susan. Sementara itu raja serta Haman duduk minum-minum, tetapi kota Susan menjadi gempar."
 },
 {
   "id": 12768,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 1,
   "firman": "Setelah Mordekhai mengetahui segala yang terjadi itu, ia mengoyakkan pakaiannya, lalu memakai kain kabung dan abu, kemudian keluar berjalan di tengah-tengah kota, sambil melolong-lolong dengan nyaring dan pedih."
 },
 {
   "id": 12769,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 2,
   "firman": "Dengan demikian datanglah ia sampai ke depan pintu gerbang istana raja, karena seorangpun tidak boleh masuk pintu gerbang istana raja dengan berpakaian kain kabung."
 },
 {
   "id": 12770,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 3,
   "firman": "Di tiap-tiap daerah, ke mana titah dan undang-undang raja telah sampai, ada perkabungan yang besar di antara orang Yahudi disertai puasa dan ratap tangis; oleh banyak orang dibentangkan kain kabung dengan abu sebagai lapik tidurnya."
 },
 {
   "id": 12771,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 4,
   "firman": "Ketika dayang-dayang dan sida-sida Ester memberitahukan hal itu kepadanya, maka sangatlah risau hati sang ratu, lalu dikirimkannyalah pakaian, supaya dipakaikan kepada Mordekhai dan supaya ditanggalkan kain kabungnya dari padanya, tetapi tidak diterimanya."
 },
 {
   "id": 12772,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 5,
   "firman": "Maka Ester memanggil Hatah, salah seorang sida-sida raja yang ditetapkan baginda melayani dia, lalu memberi perintah kepadanya menanyakan Mordekhai untuk mengetahui apa artinya dan apa sebabnya hal itu."
 },
 {
   "id": 12773,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lalu keluarlah Hatah mendapatkan Mordekhai di lapangan kota yang di depan pintu gerbang istana raja,"
 },
 {
   "id": 12774,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 7,
   "firman": "dan Mordekhai menceritakan kepadanya segala yang dialaminya, serta berapa banyaknya perak yang dijanjikan oleh Haman akan ditimbang untuk perbendaharaan raja sebagai harga pembinasaan orang Yahudi."
 },
 {
   "id": 12775,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 8,
   "firman": "Juga salinan surat undang-undang, yang dikeluarkan di Susan untuk memunahkan mereka itu, diserahkannya kepada Hatah, supaya diperlihatkan dan diberitahukan kepada Ester. Lagipula Hatah disuruh menyampaikan pesan kepada Ester, supaya pergi menghadap raja untuk memohon karunianya dan untuk membela bangsanya di hadapan baginda."
 },
 {
   "id": 12776,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 9,
   "firman": "Lalu masuklah Hatah dan menyampaikan perkataan Mordekhai kepada Ester."
 },
 {
   "id": 12777,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 10,
   "firman": "Akan tetapi Ester menyuruh Hatah memberitahukan kepada Mordekhai:"
 },
 {
   "id": 12778,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 11,
   "firman": "\"Semua pegawai raja serta penduduk daerah-daerah kerajaan mengetahui bahwa bagi setiap laki-laki atau perempuan, yang menghadap raja di pelataran dalam dengan tiada dipanggil, hanya berlaku satu undang-undang, yakni hukuman mati. Hanya orang yang kepadanya raja mengulurkan tongkat emas, yang akan tetap hidup. Dan aku selama tiga puluh hari ini tidak dipanggil menghadap raja.\""
 },
 {
   "id": 12779,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 12,
   "firman": "Ketika disampaikan orang perkataan Ester itu kepada Mordekhai,"
 },
 {
   "id": 12780,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 13,
   "firman": "maka Mordekhai menyuruh menyampaikan jawab ini kepada Ester: \"Jangan kira, karena engkau di dalam istana raja, hanya engkau yang akan terluput dari antara semua orang Yahudi."
 },
 {
   "id": 12781,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 14,
   "firman": "Sebab sekalipun engkau pada saat ini berdiam diri saja, bagi orang Yahudi akan timbul juga pertolongan dan kelepasan dari pihak lain, dan engkau dengan kaum keluargamu akan binasa. Siapa tahu, mungkin justru untuk saat yang seperti ini engkau beroleh kedudukan sebagai ratu.\""
 },
 {
   "id": 12782,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 15,
   "firman": "Maka Ester menyuruh menyampaikan jawab ini kepada Mordekhai:"
 },
 {
   "id": 12783,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 16,
   "firman": "\"Pergilah, kumpulkanlah semua orang Yahudi yang terdapat di Susan dan berpuasalah untuk aku; janganlah makan dan janganlah minum tiga hari lamanya, baik waktu malam, baik waktu siang. Aku serta dayang-dayangkupun akan berpuasa demikian, dan kemudian aku akan masuk menghadap raja, sungguhpun berlawanan dengan undang-undang; kalau terpaksa aku mati, biarlah aku mati.\""
 },
 {
   "id": 12784,
   "kitab": "Est",
   "pasal": 4,
   "ayat": 17,
   "firman": "Maka pergilah Mordekhai dan diperbuatnyalah tepat seperti yang dipesankan Ester kepadanya."
 },
 {
   "id": 12785,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 1,
   "firman": "Pada hari yang ketiga Ester mengenakan pakaian ratu, lalu berdirilah ia di pelataran dalam istana raja, tepat di depan istana raja. Raja bersemayam di atas takhta kerajaan di dalam istana, berhadapan dengan pintu istana itu."
 },
 {
   "id": 12786,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 2,
   "firman": "Ketika raja melihat Ester, sang ratu, berdiri di pelataran, berkenanlah raja kepadanya, sehingga raja mengulurkan tongkat emas yang di tangannya ke arah Ester, lalu mendekatlah Ester dan menyentuh ujung tongkat itu."
 },
 {
   "id": 12787,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 3,
   "firman": "Tanya raja kepadanya: \"Apa maksudmu, hai ratu Ester, dan apa keinginanmu? Sampai setengah kerajaan sekalipun akan diberikan kepadamu.\""
 },
 {
   "id": 12788,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 4,
   "firman": "Jawab Ester: \"Jikalau baik pada pemandangan raja, datanglah kiranya raja dengan Haman pada hari ini ke perjamuan yang diadakan oleh hamba bagi raja.\""
 },
 {
   "id": 12789,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 5,
   "firman": "Maka titah raja: \"Suruhlah Haman datang dengan segera, supaya kami memenuhi permintaan Ester.\" Lalu raja datang dengan Haman ke perjamuan yang diadakan oleh Ester."
 },
 {
   "id": 12790,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 6,
   "firman": "Sementara minum anggur bertanyalah raja kepada Ester: \"Apakah permintaanmu? Niscaya akan dikabulkan. Dan apakah keinginanmu? Sampai setengah kerajaan sekalipun akan dipenuhi.\""
 },
 {
   "id": 12791,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 7,
   "firman": "Maka jawab Ester: \"Permintaan dan keinginan hamba ialah:"
 },
 {
   "id": 12792,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 8,
   "firman": "Jikalau hamba mendapat kasih raja, dan jikalau baik pada pemandangan raja mengabulkan permintaan serta memenuhi keinginan hamba, datang pulalah kiranya raja dengan Haman ke perjamuan yang akan hamba adakan bagi raja dan Haman; maka besok akan hamba lakukan yang dikehendaki raja.\""
 },
 {
   "id": 12793,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 9,
   "firman": "Pada hari itu keluarlah Haman dengan hati riang dan gembira; tetapi ketika Haman melihat Mordekhai ada di pintu gerbang istana raja, tidak bangkit dan tidak bergerak menghormati dia, maka sangat panaslah hati Haman kepada Mordekhai."
 },
 {
   "id": 12794,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 10,
   "firman": "Tetapi Haman menahan hatinya, lalu pulanglah ia ke rumahnya dan menyuruh datang sahabat-sahabatnya dan Zeresh, isterinya."
 },
 {
   "id": 12795,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 11,
   "firman": "Maka Haman menceriterakan kepada mereka itu besarnya kekayaannya, banyaknya anaknya laki-laki, dan segala kebesaran yang diberikan raja kepadanya serta kenaikan pangkatnya di atas para pembesar dan pegawai raja."
 },
 {
   "id": 12796,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 12,
   "firman": "Lagi kata Haman: \"Tambahan pula tiada seorangpun diminta oleh Ester, sang ratu, untuk datang bersama-sama dengan raja ke perjamuan yang diadakannya, kecuali aku; dan untuk besokpun aku diundangnya bersama-sama dengan raja."
 },
 {
   "id": 12797,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 13,
   "firman": "Akan tetapi semuanya itu tidak berguna bagiku, selama aku masih melihat si Mordekhai, si Yahudi itu, duduk di pintu gerbang istana raja.\""
 },
 {
   "id": 12798,
   "kitab": "Est",
   "pasal": 5,
   "ayat": 14,
   "firman": "Lalu kata Zeresh, isterinya, dan semua sahabatnya kepadanya: \"Suruhlah orang membuat tiang yang tingginya lima puluh hasta, dan persembahkanlah besok pagi kepada raja, supaya Mordekhai disulakan orang pada tiang itu; kemudian dapatlah engkau dengan bersukacita pergi bersama-sama dengan raja ke perjamuan itu.\" Hal itu dipandang baik oleh Haman, lalu ia menyuruh membuat tiang itu."
 },
 {
   "id": 12799,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 1,
   "firman": "Pada malam itu juga raja tidak dapat tidur. Maka bertitahlah baginda membawa kitab pencatatan sejarah, lalu dibacakan di hadapan raja."
 },
 {
   "id": 12800,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 2,
   "firman": "Dan di situ didapati suatu catatan tentang Mordekhai, yang pernah memberitahukan bahwa Bigtan dan Teresh, dua orang sida-sida raja yang termasuk golongan penjaga pintu, telah berikhtiar membunuh raja Ahasyweros."
 },
 {
   "id": 12801,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 3,
   "firman": "Maka bertanyalah raja: \"Kehormatan dan kebesaran apakah yang dianugerahkan kepada Mordekhai oleh sebab perkara itu?\" Jawab para biduanda raja yang bertugas pada baginda: \"Kepadanya tidak dianugerahkan suatu apapun.\""
 },
 {
   "id": 12802,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 4,
   "firman": "Maka bertanyalah raja: \"Siapakah itu yang ada di pelataran?\" Pada waktu itu Haman baru datang di pelataran luar istana raja untuk memberitahukan kepada baginda, bahwa ia hendak menyulakan Mordekhai pada tiang yang sudah didirikannya untuk dia."
 },
 {
   "id": 12803,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 5,
   "firman": "Lalu jawab para biduanda raja kepada baginda: \"Itulah Haman, ia berdiri di pelataran.\" Maka titah raja: \"Suruhlah dia masuk.\""
 },
 {
   "id": 12804,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 6,
   "firman": "Setelah Haman masuk, bertanyalah raja kepadanya: \"Apakah yang harus dilakukan kepada orang yang raja berkenan menghormatinya?\" Kata Haman dalam hatinya: \"Kepada siapa lagi raja berkenan menganugerahkan kehormatan lebih dari kepadaku?\""
 },
 {
   "id": 12805,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 7,
   "firman": "Oleh karena itu jawab Haman kepada raja: \"Mengenai orang yang raja berkenan menghormatinya,"
 },
 {
   "id": 12806,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 8,
   "firman": "hendaklah diambil pakaian kerajaan yang biasa dipakai oleh raja sendiri, dan lagi kuda yang biasa dikendarai oleh raja sendiri dan yang diberi mahkota kerajaan di kepalanya,"
 },
 {
   "id": 12807,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 9,
   "firman": "dan hendaklah diserahkan pakaian dan kuda itu ke tangan seorang dari antara para pembesar raja, orang-orang bangsawan, lalu hendaklah pakaian itu dikenakan kepada orang yang raja berkenan menghormatinya, kemudian hendaklah ia diarak dengan mengendarai kuda itu melalui lapangan kota sedang orang berseru-seru di depannya: Beginilah dilakukan kepada orang yang raja berkenan menghormatinya!\""
 },
 {
   "id": 12808,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 10,
   "firman": "Maka titah raja kepada Haman: \"Segera ambillah pakaian dan kuda itu, seperti yang kaukatakan itu, dan lakukanlah demikian kepada Mordekhai, orang Yahudi, yang duduk di pintu gerbang istana. Sepatah katapun janganlah kaulalaikan dari pada segala yang kaukatakan itu.\""
 },
 {
   "id": 12809,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 11,
   "firman": "Lalu Haman mengambil pakaian dan kuda itu, dan dikenakannya pakaian itu kepada Mordekhai, kemudian diaraknya Mordekhai melalui lapangan kota itu, sedang ia menyerukan di depannya: \"Beginilah dilakukan kepada orang yang raja berkenan menghormatinya.\""
 },
 {
   "id": 12810,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 12,
   "firman": "Kemudian kembalilah Mordekhai ke pintu gerbang istana raja, tetapi Haman bergesa-gesa pulang ke rumahnya dengan sedih hatinya dan berselubung kepalanya."
 },
 {
   "id": 12811,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan Haman menceritakan kepada Zeresh, isterinya, dan kepada semua sahabatnya apa yang dialaminya. Maka kata para orang arif bijaksana dan Zeresh, isterinya, kepadanya: \"Jikalau Mordekhai, yang di depannya engkau sudah mulai jatuh, adalah keturunan Yahudi, maka engkau tidak akan sanggup melawan dia, malahan engkau akan jatuh benar-benar di depannya.\""
 },
 {
   "id": 12812,
   "kitab": "Est",
   "pasal": 6,
   "ayat": 14,
   "firman": "Selagi mereka itu bercakap-cakap dengan dia, datanglah sida-sida raja, lalu mengantarkan Haman dengan segera ke perjamuan yang diadakan oleh Ester."
 },
 {
   "id": 12813,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 1,
   "firman": "Datanglah raja dengan Haman untuk dijamu oleh Ester, sang ratu."
 },
 {
   "id": 12814,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 2,
   "firman": "Pada hari yang kedua itu, sementara minum anggur, bertanyalah pula raja kepada Ester: \"Apakah permintaanmu, hai ratu Ester? Niscaya akan dikabulkan. Dan apakah keinginanmu? Sampai setengah kerajaan sekalipun akan dipenuhi.\""
 },
 {
   "id": 12815,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 3,
   "firman": "Maka jawab Ester, sang ratu: \"Ya raja, jikalau hamba mendapat kasih raja dan jikalau baik pada pemandangan raja, karuniakanlah kiranya kepada hamba nyawa hamba atas permintaan hamba, dan bangsa hamba atas keinginan hamba."
 },
 {
   "id": 12816,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 4,
   "firman": "Karena kami, hamba serta bangsa hamba, telah terjual untuk dipunahkan, dibunuh dan dibinasakan. Jikalau seandainya kami hanya dijual sebagai budak laki-laki dan perempuan, niscaya hamba akan berdiam diri, tetapi malapetaka ini tiada taranya di antara bencana yang menimpa raja.\""
 },
 {
   "id": 12817,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 5,
   "firman": "Maka bertanyalah raja Ahasyweros kepada Ester, sang ratu: \"Siapakah orang itu dan di manakah dia yang hatinya mengandung niat akan berbuat demikian?\""
 },
 {
   "id": 12818,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 6,
   "firman": "Lalu jawab Ester: \"Penganiaya dan musuh itu, ialah Haman, orang jahat ini!\" Maka Hamanpun sangatlah ketakutan di hadapan raja dan ratu."
 },
 {
   "id": 12819,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 7,
   "firman": "Lalu bangkitlah raja dengan panas hatinya dari pada minum anggur dan keluar ke taman istana; akan tetapi Haman masih tinggal untuk memohon nyawanya kepada Ester, sang ratu, karena ia melihat, bahwa telah putus niat raja untuk mendatangkan celaka kepadanya."
 },
 {
   "id": 12820,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 8,
   "firman": "Ketika raja kembali dari taman istana ke dalam ruangan minum anggur, maka Haman berlutut pada katil tempat Ester berbaring. Maka titah raja: \"Masih jugakah ia hendak menggagahi sang ratu di dalam istanaku sendiri?\" Tatkala titah raja itu keluar dari mulutnya, maka diselubungi oranglah muka Haman."
 },
 {
   "id": 12821,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 9,
   "firman": "Sembah Harbona, salah seorang sida-sida yang di hadapan raja: \"Lagipula tiang yang dibuat Haman untuk Mordekhai, orang yang menyelamatkan raja dengan pemberitahuannya itu, telah berdiri di dekat rumah Haman, lima puluh hasta tingginya.\" Lalu titah raja: \"Sulakan dia pada tiang itu.\""
 },
 {
   "id": 12822,
   "kitab": "Est",
   "pasal": 7,
   "ayat": 10,
   "firman": "Kemudian Haman disulakan pada tiang yang didirikannya untuk Mordekhai. Maka surutlah panas hati raja."
 },
 {
   "id": 12823,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada hari itu juga raja Ahasyweros mengaruniakan harta milik Haman, seteru orang Yahudi, kepada Ester, sang ratu, dan Mordekhai masuk menghadap raja, karena Ester telah memberitahukan apa pertalian Mordekhai dengan dia."
 },
 {
   "id": 12824,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 2,
   "firman": "Maka raja mencabut cincin meterai yang diambil dari pada Haman, lalu diserahkannya kepada Mordekhai; dan Mordekhai diangkat oleh Ester menjadi kuasa atas harta milik Haman."
 },
 {
   "id": 12825,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 3,
   "firman": "Kemudian Ester berkata lagi kepada raja sambil sujud pada kakinya dan menangis memohon karunianya, supaya dibatalkannya maksud jahat Haman, orang Agag itu, serta rancangan yang sudah dibuatnya terhadap orang Yahudi."
 },
 {
   "id": 12826,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 4,
   "firman": "Maka raja mengulurkan tongkat emas kepada Ester, lalu bangkitlah Ester dan berdiri di hadapan raja,"
 },
 {
   "id": 12827,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 5,
   "firman": "serta sembahnya: \"Jikalau baik pada pemandangan raja dan jikalau hamba mendapat kasih raja, dan hal ini kiranya dipandang benar oleh raja dan raja berkenan kepada hamba, maka hendaklah dikeluarkan surat titah untuk menarik kembali surat-surat yang berisi rancangan Haman bin Hamedata, orang Agag itu, yang ditulisnya untuk membinasakan orang Yahudi di dalam semua daerah kerajaan."
 },
 {
   "id": 12828,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 6,
   "firman": "Karena bagaimana hamba dapat melihat malapetaka yang menimpa bangsa hamba dan bagaimana hamba dapat melihat kebinasaan sanak saudara hamba?\""
 },
 {
   "id": 12829,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 7,
   "firman": "Maka jawab raja Ahasyweros kepada Ester, sang ratu, serta kepada Mordekhai, orang Yahudi itu: \"Harta milik Haman telah kukaruniakan kepada Ester, dan Haman sendiri telah disulakan pada tiang karena ia sudah mengacungkan tangannya kepada orang Yahudi."
 },
 {
   "id": 12830,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 8,
   "firman": "Tuliskanlah atas nama raja apa yang kamu pandang baik tentang orang Yahudi dan meteraikanlah surat itu dengan cincin meterai raja, karena surat yang dituliskan atas nama raja dan dimeteraikan dengan cincin meterai raja tidak dapat ditarik kembali.\""
 },
 {
   "id": 12831,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 9,
   "firman": "Pada waktu itu juga dipanggillah para panitera raja, dalam bulan yang ketiga--yakni bulan Siwan--pada tanggal dua puluh tiga, dan sesuai dengan segala yang diperintahkan Mordekhai ditulislah surat kepada orang Yahudi, dan kepada para wakil pemerintah, para bupati dan para pembesar daerah, dari India sampai ke Etiopia, seratus dua puluh tujuh daerah, kepada tiap-tiap daerah menurut tulisannya dan kepada tiap-tiap bangsa menurut bahasanya, dan juga kepada orang Yahudi menurut tulisan dan bahasanya."
 },
 {
   "id": 12832,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 10,
   "firman": "Maka ditulislah pesan atas nama raja Ahasyweros dan dimeterai dengan cincin meterai raja, lalu dengan perantaraan pesuruh-pesuruh cepat yang berkuda, yang mengendarai kuda kerajaan yang tangkas yang diternakkan di pekudaan, dikirimkanlah surat-surat"
 },
 {
   "id": 12833,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 11,
   "firman": "yang isinya: raja mengizinkan orang Yahudi di tiap-tiap kota untuk berkumpul dan mempertahankan nyawanya serta memunahkan, membunuh atau membinasakan segala tentara, bahkan anak-anak dan perempuan-perempuan, dari bangsa dan daerah yang hendak menyerang mereka, dan untuk merampas harta miliknya,"
 },
 {
   "id": 12834,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 12,
   "firman": "pada hari yang sama di segala daerah raja Ahasyweros, pada tanggal tiga belas bulan yang kedua belas, yakni bulan Adar."
 },
 {
   "id": 12835,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 13,
   "firman": "Salinan pesan tertulis itu harus diundangkan di tiap-tiap daerah, lalu diumumkan kepada segala bangsa, dan orang Yahudi harus bersiap-siap untuk hari itu akan melakukan pembalasan kepada musuhnya."
 },
 {
   "id": 12836,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 14,
   "firman": "Maka dengan terburu-buru dan tergesa-gesa berangkatlah pesuruh-pesuruh cepat yang mengendarai kuda kerajaan yang tangkas itu, atas titah raja, dan undang-undang itu dikeluarkan di dalam benteng Susan."
 },
 {
   "id": 12837,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 15,
   "firman": "Dan Mordekhai keluar dari hadapan raja dengan memakai pakaian kerajaan dari pada kain ungu tua dan kain lenan, dengan memakai tajuk emas yang mengagumkan serta jubah dari pada kain lenan halus dan kain ungu muda. Maka kota Susanpun bertempiksoraklah dan bersukaria:"
 },
 {
   "id": 12838,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 16,
   "firman": "orang Yahudi telah beroleh kelapangan hati dan sukacita, kegirangan dan kehormatan."
 },
 {
   "id": 12839,
   "kitab": "Est",
   "pasal": 8,
   "ayat": 17,
   "firman": "Demikian juga di tiap-tiap daerah dan di tiap-tiap kota, di tempat manapun titah dan undang-undang raja telah sampai, ada sukacita dan kegirangan di antara orang Yahudi, dan perjamuan serta hari gembira; dan lagi banyak dari antara rakyat negeri itu masuk Yahudi, karena mereka ditimpa ketakutan kepada orang Yahudi."
 },
 {
   "id": 12840,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 1,
   "firman": "Dalam bulan yang kedua belas--yakni bulan Adar--,pada hari yang ketiga belas, ketika titah serta undang-undang raja akan dilaksanakan, pada hari musuh-musuh orang Yahudi berharap mengalahkan orang Yahudi, terjadilah yang sebaliknya: orang Yahudi mengalahkan pembenci-pembenci mereka."
 },
 {
   "id": 12841,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 2,
   "firman": "Maka berkumpullah orang Yahudi di dalam kota-kotanya di seluruh daerah raja Ahasyweros, untuk membunuh orang-orang yang berikhtiar mencelakakan mereka, dan tiada seorangpun tahan menghadapi mereka, karena ketakutan kepada orang Yahudi telah menimpa segala bangsa itu."
 },
 {
   "id": 12842,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 3,
   "firman": "Dan semua pembesar daerah dan wakil pemerintahan dan bupati serta pejabat kerajaan menyokong orang Yahudi, karena ketakutan kepada Mordekhai telah menimpa mereka."
 },
 {
   "id": 12843,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 4,
   "firman": "Sebab Mordekhai besar kekuasaannya di dalam istana raja dan tersiarlah berita tentang dia ke segenap daerah, karena Mordekhai itu bertambah-tambah besar kekuasaannya."
 },
 {
   "id": 12844,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 5,
   "firman": "Maka orang Yahudi mengalahkan semua musuhnya: mereka memukulnya dengan pedang, membunuh dan membinasakannya; mereka berbuat sekehendak hatinya terhadap pembenci-pembenci mereka."
 },
 {
   "id": 12845,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 6,
   "firman": "Di dalam benteng Susan saja orang Yahudi membunuh dan membinasakan lima ratus orang."
 },
 {
   "id": 12846,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 7,
   "firman": "Juga Parsandata, Dalfon, Aspata,"
 },
 {
   "id": 12847,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 8,
   "firman": "Porata, Adalya, Aridata,"
 },
 {
   "id": 12848,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 9,
   "firman": "Parmasta, Arisai, Aridai dan Waizata,"
 },
 {
   "id": 12849,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 10,
   "firman": "kesepuluh anak laki-laki Haman bin Hamedata, seteru orang Yahudi, dibunuh oleh mereka, tetapi kepada barang rampasan tidaklah mereka mengulurkan tangan."
 },
 {
   "id": 12850,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 11,
   "firman": "Pada hari itu juga jumlah orang-orang yang terbunuh di dalam benteng Susan disampaikan ke hadapan raja."
 },
 {
   "id": 12851,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 12,
   "firman": "Lalu titah raja kepada Ester, sang ratu: \"Di dalam benteng Susan saja orang Yahudi telah membunuh dan membinasakan lima ratus orang beserta kesepuluh anak Haman. Di daerah-daerah kerajaan yang lain, entahlah apa yang diperbuat mereka. Dan apakah permintaanmu sekarang? Niscaya akan dikabulkan. Dan apakah keinginanmu lagi? Niscaya dipenuhi.\""
 },
 {
   "id": 12852,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 13,
   "firman": "Lalu jawab Ester: \"Jikalau baik pada pemandangan raja, diizinkanlah kiranya kepada orang Yahudi yang di Susan untuk berbuat besokpun sesuai dengan undang-undang untuk hari ini, dan kesepuluh anak Haman itu hendaklah disulakan pada tiang.\""
 },
 {
   "id": 12853,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 14,
   "firman": "Rajapun menitahkan berbuat demikian; maka undang-undang itu dikeluarkan di Susan dan kesepuluh anak Haman disulakan orang."
 },
 {
   "id": 12854,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 15,
   "firman": "Jadi berkumpullah orang Yahudi yang di Susan pada hari yang keempat belas bulan Adar juga dan dibunuhnyalah di Susan tiga ratus orang, tetapi kepada barang rampasan tidaklah mereka mengulurkan tangan."
 },
 {
   "id": 12855,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 16,
   "firman": "Orang Yahudi yang lain, yang ada di dalam daerah kerajaan, berkumpul dan mempertahankan nyawanya serta mendapat keamanan terhadap musuhnya; mereka membunuh tujuh puluh lima ribu orang di antara pembenci-pembenci mereka, tetapi kepada barang rampasan tidaklah mereka mengulurkan tangan."
 },
 {
   "id": 12856,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 17,
   "firman": "Hal itu terjadi pada hari yang ketiga belas dalam bulan Adar. Pada hari yang keempat belas berhentilah mereka dan hari itu dijadikan mereka hari perjamuan dan sukacita."
 },
 {
   "id": 12857,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 18,
   "firman": "Akan tetapi orang Yahudi yang di Susan berkumpul, baik pada hari yang ketiga belas, baik pada hari yang keempat belas dalam bulan itu. Lalu berhentilah mereka pada hari yang kelima belas dan hari itu dijadikan mereka hari perjamuan dan sukacita."
 },
 {
   "id": 12858,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 19,
   "firman": "Oleh sebab itu orang Yahudi yang di pedusunan, yakni yang diam di perkampungan merayakan hari yang keempat belas bulan Adar itu sebagai hari sukacita dan hari perjamuan, dan sebagai hari gembira untuk antar-mengantar makanan."
 },
 {
   "id": 12859,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 20,
   "firman": "Maka Mordekhai menuliskan peristiwa itu, lalu mengirimkan surat-surat kepada semua orang Yahudi di seluruh daerah raja Ahasyweros, baik yang dekat baik yang jauh,"
 },
 {
   "id": 12860,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 21,
   "firman": "untuk mewajibkan mereka, supaya tiap-tiap tahun merayakan hari yang keempat belas dan yang kelima belas bulan Adar,"
 },
 {
   "id": 12861,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 22,
   "firman": "karena pada hari-hari itulah orang Yahudi mendapat keamanan terhadap musuhnya dan dalam bulan itulah dukacita mereka berubah menjadi sukacita dan hari perkabungan menjadi hari gembira, dan supaya menjadikan hari-hari itu hari perjamuan dan sukacita dan hari untuk antar-mengantar makanan dan untuk bersedekah kepada orang-orang miskin."
 },
 {
   "id": 12862,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 23,
   "firman": "Maka orang Yahudi menerima sebagai ketetapan apa yang sudah dimulai mereka melakukannya dan apa yang ditulis Mordekhai kepada mereka."
 },
 {
   "id": 12863,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 24,
   "firman": "Sesungguhnya Haman bin Hamedata, orang Agag, seteru semua orang Yahudi itu, telah merancangkan hendak membinasakan orang Yahudi dan diapun telah membuang pur--yakni undi--untuk menghancurkan dan membinasakan mereka,"
 },
 {
   "id": 12864,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 25,
   "firman": "akan tetapi ketika hal itu disampaikan ke hadapan raja, maka dititahkannyalah dengan surat, supaya rancangan jahat yang dibuat Haman terhadap orang Yahudi itu dibalikkan ke atas kepalanya. Maka Haman beserta anak-anaknya disulakan pada tiang."
 },
 {
   "id": 12865,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 26,
   "firman": "Oleh sebab itulah hari-hari itu disebut Purim, menurut kata pur. Oleh sebab itu jugalah, yakni karena seluruh isi surat itu dan karena apa yang dilihat mereka mengenai hal itu dan apa yang dialami mereka,"
 },
 {
   "id": 12866,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 27,
   "firman": "orang Yahudi menerima sebagai kewajiban dan sebagai ketetapan bagi dirinya sendiri dan keturunannya dan bagi sekalian orang yang akan bergabung dengan mereka, bahwa mereka tidak akan melampaui merayakan kedua hari itu tiap-tiap tahun, menurut yang dituliskan tentang itu dan pada waktu yang ditentukan,"
 },
 {
   "id": 12867,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 28,
   "firman": "dan bahwa hari-hari itu akan diperingati dan dirayakan di dalam tiap-tiap angkatan, di dalam tiap-tiap kaum, di tiap-tiap daerah, di tiap-tiap kota, sehingga hari-hari Purim itu tidak akan lenyap dari tengah-tengah orang Yahudi dan peringatannya tidak akan berakhir dari antara keturunan mereka."
 },
 {
   "id": 12868,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 29,
   "firman": "Lalu Ester, sang ratu, anak Abihail, menulis surat, bersama-sama dengan Mordekhai, orang Yahudi itu; surat yang kedua tentang hari raya Purim ini dituliskannya dengan segala ketegasan untuk menguatkannya."
 },
 {
   "id": 12869,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 30,
   "firman": "Lalu dikirimkanlah surat-surat kepada semua orang Yahudi di dalam keseratus dua puluh tujuh daerah kerajaan Ahasyweros, dengan kata-kata salam dan setia,"
 },
 {
   "id": 12870,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 31,
   "firman": "supaya hari-hari Purim itu dirayakan pada waktu yang ditentukan, seperti yang diwajibkan kepada mereka oleh Mordekhai, orang Yahudi itu, dan oleh Ester, sang ratu, dan seperti yang diwajibkan mereka kepada dirinya sendiri serta keturunan mereka, mengenai hal berpuasa dan meratap-ratap."
 },
 {
   "id": 12871,
   "kitab": "Est",
   "pasal": 9,
   "ayat": 32,
   "firman": "Demikianlah perintah Ester menetapkan perihal Purim itu, kemudian dituliskan di dalam kitab."
 },
 {
   "id": 12872,
   "kitab": "Est",
   "pasal": 10,
   "ayat": 1,
   "firman": "Maka raja Ahasyweros mengenakan upeti atas negeri dan daerah-daerah pesisir juga."
 },
 {
   "id": 12873,
   "kitab": "Est",
   "pasal": 10,
   "ayat": 2,
   "firman": "Segala perbuatannya yang hebat serta gagah dan pemberitaan yang seksama tentang kebesaran yang dikaruniakan raja kepada Mordekhai, bukankah semuanya itu tertulis di dalam kitab sejarah raja-raja Media dan Persia?"
 },
 {
   "id": 12874,
   "kitab": "Est",
   "pasal": 10,
   "ayat": 3,
   "firman": "Karena Mordekhai, orang Yahudi itu, menjadi orang kedua di bawah raja Ahasyweros, dan ia dihormati oleh orang Yahudi serta disukai oleh banyak sanak saudaranya, sebab ia mengikhtiarkan yang baik bagi bangsanya dan berbicara untuk keselamatan bagi semua orang sebangsanya."
 },
 {
   "id": 12875,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ada seorang laki-laki di tanah Us bernama Ayub; orang itu saleh dan jujur; ia takut akan Allah dan menjauhi kejahatan."
 },
 {
   "id": 12876,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 2,
   "firman": "Ia mendapat tujuh anak laki-laki dan tiga anak perempuan."
 },
 {
   "id": 12877,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 3,
   "firman": "Ia memiliki tujuh ribu ekor kambing domba, tiga ribu ekor unta, lima ratus pasang lembu, lima ratus keledai betina dan budak-budak dalam jumlah yang sangat besar, sehingga orang itu adalah yang terkaya dari semua orang di sebelah timur."
 },
 {
   "id": 12878,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 4,
   "firman": "Anak-anaknya yang lelaki biasa mengadakan pesta di rumah mereka masing-masing menurut giliran dan ketiga saudara perempuan mereka diundang untuk makan dan minum bersama-sama mereka."
 },
 {
   "id": 12879,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 5,
   "firman": "Setiap kali, apabila hari-hari pesta telah berlalu, Ayub memanggil mereka, dan menguduskan mereka; keesokan harinya, pagi-pagi, bangunlah Ayub, lalu mempersembahkan korban bakaran sebanyak jumlah mereka sekalian, sebab pikirnya: \"Mungkin anak-anakku sudah berbuat dosa dan telah mengutuki Allah di dalam hati.\" Demikianlah dilakukan Ayub senantiasa."
 },
 {
   "id": 12880,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 6,
   "firman": "Pada suatu hari datanglah anak-anak Allah menghadap TUHAN dan di antara mereka datanglah juga Iblis."
 },
 {
   "id": 12881,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 7,
   "firman": "Maka bertanyalah TUHAN kepada Iblis: \"Dari mana engkau?\" Lalu jawab Iblis kepada TUHAN: \"Dari perjalanan mengelilingi dan menjelajah bumi.\""
 },
 {
   "id": 12882,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 8,
   "firman": "Lalu bertanyalah TUHAN kepada Iblis: \"Apakah engkau memperhatikan hamba-Ku Ayub? Sebab tiada seorangpun di bumi seperti dia, yang demikian saleh dan jujur, yang takut akan Allah dan menjauhi kejahatan.\""
 },
 {
   "id": 12883,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 9,
   "firman": "Lalu jawab Iblis kepada TUHAN: \"Apakah dengan tidak mendapat apa-apa Ayub takut akan Allah?"
 },
 {
   "id": 12884,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 10,
   "firman": "Bukankah Engkau yang membuat pagar sekeliling dia dan rumahnya serta segala yang dimilikinya? Apa yang dikerjakannya telah Kauberkati dan apa yang dimilikinya makin bertambah di negeri itu."
 },
 {
   "id": 12885,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 11,
   "firman": "Tetapi ulurkanlah tangan-Mu dan jamahlah segala yang dipunyainya, ia pasti mengutuki Engkau di hadapan-Mu.\""
 },
 {
   "id": 12886,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 12,
   "firman": "Maka firman TUHAN kepada Iblis: \"Nah, segala yang dipunyainya ada dalam kuasamu; hanya janganlah engkau mengulurkan tanganmu terhadap dirinya.\" Kemudian pergilah Iblis dari hadapan TUHAN."
 },
 {
   "id": 12887,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 13,
   "firman": "Pada suatu hari, ketika anak-anaknya yang lelaki dan yang perempuan makan-makan dan minum anggur di rumah saudara mereka yang sulung,"
 },
 {
   "id": 12888,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 14,
   "firman": "datanglah seorang pesuruh kepada Ayub dan berkata: \"Sedang lembu sapi membajak dan keledai-keledai betina makan rumput di sebelahnya,"
 },
 {
   "id": 12889,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 15,
   "firman": "datanglah orang-orang Syeba menyerang dan merampasnya serta memukul penjaganya dengan mata pedang. Hanya aku sendiri yang luput, sehingga dapat memberitahukan hal itu kepada tuan.\""
 },
 {
   "id": 12890,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 16,
   "firman": "Sementara orang itu berbicara, datanglah orang lain dan berkata: \"Api telah menyambar dari langit dan membakar serta memakan habis kambing domba dan penjaga-penjaga. Hanya aku sendiri yang luput, sehingga dapat memberitahukan hal itu kepada tuan.\""
 },
 {
   "id": 12891,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sementara orang itu berbicara, datanglah orang lain dan berkata: \"Orang-orang Kasdim membentuk tiga pasukan, lalu menyerbu unta-unta dan merampasnya serta memukul penjaganya dengan mata pedang. Hanya aku sendiri yang luput, sehingga dapat memberitahukan hal itu kepada tuan.\""
 },
 {
   "id": 12892,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sementara orang itu berbicara, datanglah orang lain dan berkata: \"Anak-anak tuan yang lelaki dan yang perempuan sedang makan-makan dan minum anggur di rumah saudara mereka yang sulung,"
 },
 {
   "id": 12893,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 19,
   "firman": "maka tiba-tiba angin ribut bertiup dari seberang padang gurun; rumah itu dilandanya pada empat penjurunya dan roboh menimpa orang-orang muda itu, sehingga mereka mati. Hanya aku sendiri yang luput, sehingga dapat memberitahukan hal itu kepada tuan.\""
 },
 {
   "id": 12894,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 20,
   "firman": "Maka berdirilah Ayub, lalu mengoyak jubahnya, dan mencukur kepalanya, kemudian sujudlah ia dan menyembah,"
 },
 {
   "id": 12895,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 21,
   "firman": "katanya: \"Dengan telanjang aku keluar dari kandungan ibuku, dengan telanjang juga aku akan kembali ke dalamnya. TUHAN yang memberi, TUHAN yang mengambil, terpujilah nama TUHAN!\""
 },
 {
   "id": 12896,
   "kitab": "Ayb",
   "pasal": 1,
   "ayat": 22,
   "firman": "Dalam kesemuanya itu Ayub tidak berbuat dosa dan tidak menuduh Allah berbuat yang kurang patut."
 },
 {
   "id": 12897,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pada suatu hari datanglah anak-anak Allah menghadap TUHAN dan di antara mereka datang juga Iblis untuk menghadap TUHAN."
 },
 {
   "id": 12898,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 2,
   "firman": "Maka bertanyalah TUHAN kepada Iblis: \"Dari mana engkau?\" Lalu jawab Iblis kepada TUHAN: \"Dari perjalanan mengelilingi dan menjelajah bumi.\""
 },
 {
   "id": 12899,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 3,
   "firman": "Firman TUHAN kepada Iblis: \"Apakah engkau memperhatikan hamba-Ku Ayub? Sebab tiada seorangpun di bumi seperti dia, yang demikian saleh dan jujur, yang takut akan Allah dan menjauhi kejahatan. Ia tetap tekun dalam kesalehannya, meskipun engkau telah membujuk Aku melawan dia untuk mencelakakannya tanpa alasan.\""
 },
 {
   "id": 12900,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 4,
   "firman": "Lalu jawab Iblis kepada TUHAN: \"Kulit ganti kulit! Orang akan memberikan segala yang dipunyainya ganti nyawanya."
 },
 {
   "id": 12901,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi ulurkanlah tangan-Mu dan jamahlah tulang dan dagingnya, ia pasti mengutuki Engkau di hadapan-Mu.\""
 },
 {
   "id": 12902,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 6,
   "firman": "Maka firman TUHAN kepada Iblis: \"Nah, ia dalam kuasamu; hanya sayangkan nyawanya.\""
 },
 {
   "id": 12903,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 7,
   "firman": "Kemudian Iblis pergi dari hadapan TUHAN, lalu ditimpanya Ayub dengan barah yang busuk dari telapak kakinya sampai ke batu kepalanya."
 },
 {
   "id": 12904,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 8,
   "firman": "Lalu Ayub mengambil sekeping beling untuk menggaruk-garuk badannya, sambil duduk di tengah-tengah abu."
 },
 {
   "id": 12905,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka berkatalah isterinya kepadanya: \"Masih bertekunkah engkau dalam kesalehanmu? Kutukilah Allahmu dan matilah!\""
 },
 {
   "id": 12906,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 10,
   "firman": "Tetapi jawab Ayub kepadanya: \"Engkau berbicara seperti perempuan gila! Apakah kita mau menerima yang baik dari Allah, tetapi tidak mau menerima yang buruk?\" Dalam kesemuanya itu Ayub tidak berbuat dosa dengan bibirnya."
 },
 {
   "id": 12907,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 11,
   "firman": "Ketika ketiga sahabat Ayub mendengar kabar tentang segala malapetaka yang menimpa dia, maka datanglah mereka dari tempatnya masing-masing, yakni: Elifas, orang Teman, dan Bildad, orang Suah, serta Zofar, orang Naama. Mereka bersepakat untuk mengucapkan belasungkawa kepadanya dan menghibur dia."
 },
 {
   "id": 12908,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 12,
   "firman": "Ketika mereka memandang dari jauh, mereka tidak mengenalnya lagi. Lalu menangislah mereka dengan suara nyaring. Mereka mengoyak jubahnya, dan menaburkan debu di kepala terhadap langit."
 },
 {
   "id": 12909,
   "kitab": "Ayb",
   "pasal": 2,
   "ayat": 13,
   "firman": "Lalu mereka duduk bersama-sama dia di tanah selama tujuh hari tujuh malam. Seorangpun tidak mengucapkan sepatah kata kepadanya, karena mereka melihat, bahwa sangat berat penderitaannya."
 },
 {
   "id": 12910,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 1,
   "firman": "Sesudah itu Ayub membuka mulutnya dan mengutuki hari kelahirannya."
 },
 {
   "id": 12911,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 2,
   "firman": "Maka berbicaralah Ayub:"
 },
 {
   "id": 12912,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 3,
   "firman": "\"Biarlah hilang lenyap hari kelahiranku dan malam yang mengatakan: Seorang anak laki-laki telah ada dalam kandungan."
 },
 {
   "id": 12913,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 4,
   "firman": "Biarlah hari itu menjadi kegelapan, janganlah kiranya Allah yang di atas menghiraukannya, dan janganlah cahaya terang menyinarinya."
 },
 {
   "id": 12914,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 5,
   "firman": "Biarlah kegelapan dan kekelaman menuntut hari itu, awan-gemawan menudunginya, dan gerhana matahari mengejutkannya."
 },
 {
   "id": 12915,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 6,
   "firman": "Malam itu--biarlah dia dicekam oleh kegelapan; janganlah ia bersukaria pada hari-hari dalam setahun; janganlah ia termasuk bilangan bulan-bulan."
 },
 {
   "id": 12916,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 7,
   "firman": "Ya, biarlah pada malam itu tidak ada yang melahirkan, dan tidak terdengar suara kegirangan."
 },
 {
   "id": 12917,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 8,
   "firman": "Biarlah ia disumpahi oleh para pengutuk hari, oleh mereka yang pandai membangkitkan marah Lewiatan."
 },
 {
   "id": 12918,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 9,
   "firman": "Biarlah bintang-bintang senja menjadi gelap; biarlah ia menantikan terang yang tak kunjung datang, janganlah ia melihat merekahnya fajar,"
 },
 {
   "id": 12919,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 10,
   "firman": "karena tidak ditutupnya pintu kandungan ibuku, dan tidak disembunyikannya kesusahan dari mataku."
 },
 {
   "id": 12920,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 11,
   "firman": "Mengapa aku tidak mati waktu aku lahir, atau binasa waktu aku keluar dari kandungan?"
 },
 {
   "id": 12921,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 12,
   "firman": "Mengapa pangkuan menerima aku; mengapa ada buah dada, sehingga aku dapat menyusu?"
 },
 {
   "id": 12922,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 13,
   "firman": "Jikalau tidak, aku sekarang berbaring dan tenang; aku tertidur dan mendapat istirahat"
 },
 {
   "id": 12923,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 14,
   "firman": "bersama-sama raja-raja dan penasihat-penasihat di bumi, yang mendirikan kembali reruntuhan bagi dirinya,"
 },
 {
   "id": 12924,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 15,
   "firman": "atau bersama-sama pembesar-pembesar yang mempunyai emas, yang memenuhi rumahnya dengan perak."
 },
 {
   "id": 12925,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 16,
   "firman": "Atau mengapa aku tidak seperti anak gugur yang disembunyikan, seperti bayi yang tidak melihat terang?"
 },
 {
   "id": 12926,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 17,
   "firman": "Di sanalah orang fasik berhenti menimbulkan huru-hara, di sanalah mereka yang kehabisan tenaga mendapat istirahat."
 },
 {
   "id": 12927,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan para tawanan bersama-sama menjadi tenang, mereka tidak lagi mendengar suara pengerah."
 },
 {
   "id": 12928,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 19,
   "firman": "Di sana orang kecil dan orang besar sama, dan budak bebas dari pada tuannya."
 },
 {
   "id": 12929,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 20,
   "firman": "Mengapa terang diberikan kepada yang bersusah-susah, dan hidup kepada yang pedih hati;"
 },
 {
   "id": 12930,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 21,
   "firman": "yang menantikan maut, yang tak kunjung tiba, yang mengejarnya lebih dari pada menggali harta terpendam;"
 },
 {
   "id": 12931,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 22,
   "firman": "yang bersukaria dan bersorak-sorai dan senang, bila mereka menemukan kubur;"
 },
 {
   "id": 12932,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 23,
   "firman": "kepada orang laki-laki yang jalannya tersembunyi, yang dikepung Allah?"
 },
 {
   "id": 12933,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 24,
   "firman": "Karena ganti rotiku adalah keluh kesahku, dan keluhanku tercurah seperti air."
 },
 {
   "id": 12934,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 25,
   "firman": "Karena yang kutakutkan, itulah yang menimpa aku, dan yang kucemaskan, itulah yang mendatangi aku."
 },
 {
   "id": 12935,
   "kitab": "Ayb",
   "pasal": 3,
   "ayat": 26,
   "firman": "Aku tidak mendapat ketenangan dan ketenteraman; aku tidak mendapat istirahat, tetapi kegelisahanlah yang timbul.\""
 },
 {
   "id": 12936,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 1,
   "firman": "Maka berbicaralah Elifas, orang Teman:"
 },
 {
   "id": 12937,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 2,
   "firman": "\"Kesalkah engkau, bila orang mencoba berbicara kepadamu? Tetapi siapakah dapat tetap menutup mulutnya?"
 },
 {
   "id": 12938,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sesungguhnya, engkau telah mengajar banyak orang, dan tangan yang lemah telah engkau kuatkan;"
 },
 {
   "id": 12939,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 4,
   "firman": "orang yang jatuh telah dibangunkan oleh kata-katamu, dan lutut yang lemas telah kaukokohkan;"
 },
 {
   "id": 12940,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 5,
   "firman": "tetapi sekarang, dirimu yang tertimpa, dan engkau kesal, dirimu terkena, dan engkau terkejut."
 },
 {
   "id": 12941,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 6,
   "firman": "Bukankah takutmu akan Allah yang menjadi sandaranmu, dan kesalehan hidupmu menjadi pengharapanmu?"
 },
 {
   "id": 12942,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 7,
   "firman": "Camkanlah ini: siapa binasa dengan tidak bersalah dan di manakah orang yang jujur dipunahkan?"
 },
 {
   "id": 12943,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 8,
   "firman": "Yang telah kulihat ialah bahwa orang yang membajak kejahatan dan menabur kesusahan, ia menuainya juga."
 },
 {
   "id": 12944,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 9,
   "firman": "Mereka binasa oleh nafas Allah, dan lenyap oleh hembusan hidung-Nya."
 },
 {
   "id": 12945,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 10,
   "firman": "Singa mengaum, singa meraung--patahlah gigi singa-singa muda."
 },
 {
   "id": 12946,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 11,
   "firman": "Singa binasa karena kekurangan mangsa, dan anak-anak singa betina bercerai-berai."
 },
 {
   "id": 12947,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 12,
   "firman": "Suatu perkataan telah disampaikan kepadaku dengan diam-diam dan telingaku menangkap bisikannya,"
 },
 {
   "id": 12948,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 13,
   "firman": "waktu bermenung oleh sebab khayal malam, ketika tidur nyenyak menghinggapi orang."
 },
 {
   "id": 12949,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 14,
   "firman": "Aku terkejut dan gentar, sehingga tulang-tulangku gemetar."
 },
 {
   "id": 12950,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 15,
   "firman": "Suatu roh melewati aku, tegaklah bulu romaku."
 },
 {
   "id": 12951,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 16,
   "firman": "Ia berhenti, tetapi rupanya tidak dapat kukenal. Suatu sosok ada di depan mataku, suara berbisik-bisik kudengar:"
 },
 {
   "id": 12952,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 17,
   "firman": "Mungkinkah seorang manusia benar di hadapan Allah, mungkinkah seseorang tahir di hadapan Penciptanya?"
 },
 {
   "id": 12953,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 18,
   "firman": "Sesungguhnya, hamba-hamba-Nya tidak dipercayai-Nya, malaikat-malaikat-Nyapun didapati-Nya tersesat,"
 },
 {
   "id": 12954,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 19,
   "firman": "lebih-lebih lagi mereka yang diam dalam pondok tanah liat, yang dasarnya dalam debu, yang mati terpijat seperti gegat."
 },
 {
   "id": 12955,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 20,
   "firman": "Di antara pagi dan petang mereka dihancurkan, dan tanpa dihiraukan mereka binasa untuk selama-lamanya."
 },
 {
   "id": 12956,
   "kitab": "Ayb",
   "pasal": 4,
   "ayat": 21,
   "firman": "Bukankah kemah mereka dicabut? Mereka mati, tetapi tanpa hikmat."
 },
 {
   "id": 12957,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 1,
   "firman": "Berserulah--adakah orang yang menjawab engkau? Dan kepada siapa di antara orang-orang yang kudus engkau akan berpaling?"
 },
 {
   "id": 12958,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 2,
   "firman": "Sesungguhnya, orang bodoh dibunuh oleh sakit hati, dan orang bebal dimatikan oleh iri hati."
 },
 {
   "id": 12959,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 3,
   "firman": "Aku sendiri pernah melihat orang bodoh berakar, tetapi serta-merta kukutuki tempat kediamannya."
 },
 {
   "id": 12960,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 4,
   "firman": "Anak-anaknya selalu tidak tertolong, mereka diinjak-injak di pintu gerbang tanpa ada orang yang melepaskannya."
 },
 {
   "id": 12961,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 5,
   "firman": "Apa yang dituainya, dimakan habis oleh orang yang lapar, bahkan dirampas dari tengah-tengah duri, dan orang-orang yang dahaga mengingini kekayaannya."
 },
 {
   "id": 12962,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 6,
   "firman": "Karena bukan dari debu terbit bencana dan bukan dari tanah tumbuh kesusahan;"
 },
 {
   "id": 12963,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 7,
   "firman": "melainkan manusia menimbulkan kesusahan bagi dirinya, seperti bunga api berjolak tinggi."
 },
 {
   "id": 12964,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tetapi aku, tentu aku akan mencari Allah, dan kepada Allah aku akan mengadukan perkaraku."
 },
 {
   "id": 12965,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 9,
   "firman": "Ia melakukan perbuatan-perbuatan yang besar dan yang tak terduga, serta keajaiban-keajaiban yang tak terbilang banyaknya;"
 },
 {
   "id": 12966,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 10,
   "firman": "Ia memberi hujan ke atas muka bumi dan menjatuhkan air ke atas ladang;"
 },
 {
   "id": 12967,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 11,
   "firman": "Ia menempatkan orang yang hina pada derajat yang tinggi dan orang yang berdukacita mendapat pertolongan yang kuat;"
 },
 {
   "id": 12968,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 12,
   "firman": "Ia menggagalkan rancangan orang cerdik, sehingga usaha tangan mereka tidak berhasil;"
 },
 {
   "id": 12969,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 13,
   "firman": "Ia menangkap orang berhikmat dalam kecerdikannya sendiri, sehingga rancangan orang yang belat-belit digagalkan."
 },
 {
   "id": 12970,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 14,
   "firman": "Pada siang hari mereka tertimpa gelap, dan pada tengah hari mereka meraba-raba seperti pada waktu malam."
 },
 {
   "id": 12971,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 15,
   "firman": "Tetapi Ia menyelamatkan orang-orang miskin dari kedahsyatan mulut mereka, dan dari tangan orang yang kuat."
 },
 {
   "id": 12972,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 16,
   "firman": "Demikianlah ada harapan bagi orang kecil, dan kecurangan tutup mulut."
 },
 {
   "id": 12973,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 17,
   "firman": "Sesungguhnya, berbahagialah manusia yang ditegur Allah; sebab itu janganlah engkau menolak didikan Yang Mahakuasa."
 },
 {
   "id": 12974,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 18,
   "firman": "Karena Dialah yang melukai, tetapi juga yang membebat; Dia yang memukuli, tetapi yang tangan-Nya menyembuhkan pula."
 },
 {
   "id": 12975,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 19,
   "firman": "Dari enam macam kesesakan engkau diluputkan-Nya dan dalam tujuh macam engkau tidak kena malapetaka."
 },
 {
   "id": 12976,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 20,
   "firman": "Pada masa kelaparan engkau dibebaskan-Nya dari maut, dan pada masa perang dari kuasa pedang."
 },
 {
   "id": 12977,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 21,
   "firman": "Dari cemeti lidah engkau terlindung, dan engkau tidak usah takut, bila kemusnahan datang."
 },
 {
   "id": 12978,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 22,
   "firman": "Kemusnahan dan kelaparan akan kautertawakan dan binatang liar tidak akan kautakuti."
 },
 {
   "id": 12979,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 23,
   "firman": "Karena antara engkau dan batu-batu di padang akan ada perjanjian, dan binatang liar akan berdamai dengan engkau."
 },
 {
   "id": 12980,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 24,
   "firman": "Engkau akan mengalami, bahwa kemahmu aman dan apabila engkau memeriksa tempat kediamanmu, engkau tidak akan kehilangan apa-apa."
 },
 {
   "id": 12981,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 25,
   "firman": "Engkau akan mengalami, bahwa keturunanmu menjadi banyak dan bahwa anak cucumu seperti rumput di tanah."
 },
 {
   "id": 12982,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 26,
   "firman": "Dalam usia tinggi engkau akan turun ke dalam kubur, seperti berkas gandum dibawa masuk pada waktunya."
 },
 {
   "id": 12983,
   "kitab": "Ayb",
   "pasal": 5,
   "ayat": 27,
   "firman": "Sesungguhnya, semuanya itu telah kami selidiki, memang demikianlah adanya; dengarkanlah dan camkanlah itu!\""
 },
 {
   "id": 12984,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 1,
   "firman": "Lalu Ayub menjawab:"
 },
 {
   "id": 12985,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 2,
   "firman": "\"Ah, hendaklah kiranya kekesalan hatiku ditimbang, dan kemalanganku ditaruh bersama-sama di atas neraca!"
 },
 {
   "id": 12986,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 3,
   "firman": "Maka beratnya akan melebihi pasir di laut; oleh sebab itu tergesa-gesalah perkataanku."
 },
 {
   "id": 12987,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 4,
   "firman": "Karena anak panah dari Yang Mahakuasa tertancap pada tubuhku, dan racunnya diisap oleh jiwaku; kedahsyatan Allah seperti pasukan melawan aku."
 },
 {
   "id": 12988,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 5,
   "firman": "Meringkikkah keledai liar di tempat rumput muda, atau melenguhkah lembu dekat makanannya?"
 },
 {
   "id": 12989,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 6,
   "firman": "Dapatkah makanan tawar dimakan tanpa garam atau apakah putih telur ada rasanya?"
 },
 {
   "id": 12990,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 7,
   "firman": "Aku tidak sudi menjamahnya, semuanya itu makanan yang memualkan bagiku."
 },
 {
   "id": 12991,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 8,
   "firman": "Ah, kiranya terkabul permintaanku dan Allah memberi apa yang kuharapkan!"
 },
 {
   "id": 12992,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 9,
   "firman": "Kiranya Allah berkenan meremukkan aku, kiranya Ia melepaskan tangan-Nya dan menghabisi nyawaku!"
 },
 {
   "id": 12993,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 10,
   "firman": "Itulah yang masih merupakan hiburan bagiku, bahkan aku akan melompat-lompat kegirangan di waktu kepedihan yang tak kenal belas kasihan, sebab aku tidak pernah menyangkal firman Yang Mahakudus."
 },
 {
   "id": 12994,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 11,
   "firman": "Apakah kekuatanku, sehingga aku sanggup bertahan, dan apakah masa depanku, sehingga aku harus bersabar?"
 },
 {
   "id": 12995,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 12,
   "firman": "Apakah kekuatanku seperti kekuatan batu? Apakah tubuhku dari tembaga?"
 },
 {
   "id": 12996,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 13,
   "firman": "Bukankah tidak ada lagi pertolongan bagiku, dan keselamatan jauh dari padaku?"
 },
 {
   "id": 12997,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 14,
   "firman": "Siapa menahan kasih sayang terhadap sesamanya, melalaikan takut akan Yang Mahakuasa."
 },
 {
   "id": 12998,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 15,
   "firman": "Saudara-saudaraku tidak dapat dipercaya seperti sungai, seperti dasar dari pada sungai yang mengalir lenyap,"
 },
 {
   "id": 12999,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 16,
   "firman": "yang keruh karena air beku, yang di dalamnya salju menjadi cair,"
 },
 {
   "id": 13000,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 17,
   "firman": "yang surut pada musim kemarau, dan menjadi kering di tempatnya apabila kena panas;"
 },
 {
   "id": 13001,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 18,
   "firman": "berkeluk-keluk jalan arusnya, mengalir ke padang tandus, lalu lenyap."
 },
 {
   "id": 13002,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 19,
   "firman": "Kafilah dari Tema mengamat-amatinya dan rombongan dari Syeba mengharapkannya,"
 },
 {
   "id": 13003,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 20,
   "firman": "tetapi mereka kecewa karena keyakinan mereka, mereka tertipu setibanya di sana."
 },
 {
   "id": 13004,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 21,
   "firman": "Demikianlah kamu sekarang bagiku, ketika melihat yang dahsyat, takutlah kamu."
 },
 {
   "id": 13005,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 22,
   "firman": "Pernahkah aku berkata: Berilah aku sesuatu, atau: Berilah aku uang suap dari hartamu,"
 },
 {
   "id": 13006,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 23,
   "firman": "atau: Luputkan aku dari tangan musuh, atau: Tebuslah aku dari tangan orang lalim?"
 },
 {
   "id": 13007,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 24,
   "firman": "Ajarilah aku, maka aku akan diam; dan tunjukkan kepadaku dalam hal apa aku tersesat."
 },
 {
   "id": 13008,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 25,
   "firman": "Alangkah kokohnya kata-kata yang jujur! Tetapi apakah maksud celaan dari pihakmu itu?"
 },
 {
   "id": 13009,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 26,
   "firman": "Apakah kamu bermaksud mencela perkataan? Apakah perkataan orang yang putus asa dianggap angin?"
 },
 {
   "id": 13010,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 27,
   "firman": "Bahkan atas anak yatim kamu membuang undi, dan sahabatmu kamu perlakukan sebagai barang dagangan."
 },
 {
   "id": 13011,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 28,
   "firman": "Tetapi sekarang, berpalinglah kepadaku; aku tidak akan berdusta di hadapanmu."
 },
 {
   "id": 13012,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 29,
   "firman": "Berbaliklah, janganlah terjadi kecurangan, berbaliklah, aku pasti benar."
 },
 {
   "id": 13013,
   "kitab": "Ayb",
   "pasal": 6,
   "ayat": 30,
   "firman": "Apakah ada kecurangan pada lidahku? Apakah langit-langitku tidak dapat membeda-bedakan bencana?\""
 },
 {
   "id": 13014,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 1,
   "firman": "\"Bukankah manusia harus bergumul di bumi, dan hari-harinya seperti hari-hari orang upahan?"
 },
 {
   "id": 13015,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 2,
   "firman": "Seperti kepada seorang budak yang merindukan naungan, seperti kepada orang upahan yang menanti-nantikan upahnya,"
 },
 {
   "id": 13016,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 3,
   "firman": "demikianlah dibagikan kepadaku bulan-bulan yang sia-sia, dan ditentukan kepadaku malam-malam penuh kesusahan."
 },
 {
   "id": 13017,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 4,
   "firman": "Bila aku pergi tidur, maka pikirku: Bilakah aku akan bangun? Tetapi malam merentang panjang, dan aku dicekam oleh gelisah sampai dinihari."
 },
 {
   "id": 13018,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 5,
   "firman": "Berenga dan abu menutupi tubuhku, kulitku menjadi keras, lalu pecah."
 },
 {
   "id": 13019,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 6,
   "firman": "Hari-hariku berlalu lebih cepat dari pada torak, dan berakhir tanpa harapan."
 },
 {
   "id": 13020,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 7,
   "firman": "Ingatlah, bahwa hidupku hanya hembusan nafas; mataku tidak akan lagi melihat yang baik."
 },
 {
   "id": 13021,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 8,
   "firman": "Orang yang memandang aku, tidak akan melihat aku lagi, sementara Engkau memandang aku, aku tidak ada lagi."
 },
 {
   "id": 13022,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 9,
   "firman": "Sebagaimana awan lenyap dan melayang hilang, demikian juga orang yang turun ke dalam dunia orang mati tidak akan muncul kembali."
 },
 {
   "id": 13023,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 10,
   "firman": "Ia tidak lagi kembali ke rumahnya, dan tidak dikenal lagi oleh tempat tinggalnya."
 },
 {
   "id": 13024,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 11,
   "firman": "Oleh sebab itu akupun tidak akan menahan mulutku, aku akan berbicara dalam kesesakan jiwaku, mengeluh dalam kepedihan hatiku."
 },
 {
   "id": 13025,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 12,
   "firman": "Apakah aku ini laut atau naga, sehingga Engkau menempatkan penjaga terhadap aku?"
 },
 {
   "id": 13026,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 13,
   "firman": "Apabila aku berpikir: Tempat tidurku akan memberi aku penghiburan, dan tempat pembaringanku akan meringankan keluh kesahku,"
 },
 {
   "id": 13027,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 14,
   "firman": "maka Engkau mengagetkan aku dengan impian dan mengejutkan aku dengan khayal,"
 },
 {
   "id": 13028,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 15,
   "firman": "sehingga aku lebih suka dicekik dan mati dari pada menanggung kesusahanku."
 },
 {
   "id": 13029,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 16,
   "firman": "Aku jemu, aku tidak mau hidup untuk selama-lamanya. Biarkanlah aku, karena hari-hariku hanya seperti hembusan nafas saja."
 },
 {
   "id": 13030,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 17,
   "firman": "Apakah gerangan manusia, sehingga dia Kauanggap agung, dan Kauperhatikan,"
 },
 {
   "id": 13031,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 18,
   "firman": "dan Kaudatangi setiap pagi, dan Kauuji setiap saat?"
 },
 {
   "id": 13032,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 19,
   "firman": "Bilakah Engkau mengalihkan pandangan-Mu dari padaku, dan membiarkan aku, sehingga aku sempat menelan ludahku?"
 },
 {
   "id": 13033,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 20,
   "firman": "Kalau aku berbuat dosa, apakah yang telah kulakukan terhadap Engkau, ya Penjaga manusia? Mengapa Engkau menjadikan aku sasaran-Mu, sehingga aku menjadi beban bagi diriku?"
 },
 {
   "id": 13034,
   "kitab": "Ayb",
   "pasal": 7,
   "ayat": 21,
   "firman": "Dan mengapa Engkau tidak mengampuni pelanggaranku, dan tidak menghapuskan kesalahanku? Karena sekarang aku terbaring dalam debu, lalu Engkau akan mencari aku, tetapi aku tidak akan ada lagi.\""
 },
 {
   "id": 13035,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 1,
   "firman": "Maka berbicaralah Bildad, orang Suah:"
 },
 {
   "id": 13036,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 2,
   "firman": "\"Berapa lamakah lagi engkau akan berbicara begitu, dan perkataan mulutmu seperti angin yang menderu?"
 },
 {
   "id": 13037,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 3,
   "firman": "Masakan Allah membengkokkan keadilan? Masakan Yang Mahakuasa membengkokkan kebenaran?"
 },
 {
   "id": 13038,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 4,
   "firman": "Jikalau anak-anakmu telah berbuat dosa terhadap Dia, maka Ia telah membiarkan mereka dikuasai oleh pelanggaran mereka."
 },
 {
   "id": 13039,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 5,
   "firman": "Tetapi engkau, kalau engkau mencari Allah, dan memohon belas kasihan dari Yang Mahakuasa,"
 },
 {
   "id": 13040,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 6,
   "firman": "kalau engkau bersih dan jujur, maka tentu Ia akan bangkit demi engkau dan Ia akan memulihkan rumah yang adalah hakmu."
 },
 {
   "id": 13041,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 7,
   "firman": "Maka kedudukanmu yang dahulu akan kelihatan hina, tetapi kedudukanmu yang kemudian akan menjadi sangat mulia."
 },
 {
   "id": 13042,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 8,
   "firman": "Bertanya-tanyalah tentang orang-orang zaman dahulu, dan perhatikanlah apa yang diselidiki para nenek moyang."
 },
 {
   "id": 13043,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 9,
   "firman": "Sebab kita, anak-anak kemarin, tidak mengetahui apa-apa; karena hari-hari kita seperti bayang-bayang di bumi."
 },
 {
   "id": 13044,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 10,
   "firman": "Bukankah mereka yang harus mengajari engkau dan yang harus berbicara kepadamu, dan melahirkan kata-kata dari akal budi mereka?"
 },
 {
   "id": 13045,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dapatkah pandan bertumbuh tinggi, kalau tidak di rawa, atau mensiang bertumbuh subur, kalau tidak di air?"
 },
 {
   "id": 13046,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 12,
   "firman": "Sementara dalam pertumbuhan, sebelum waktunya disabit, layulah ia lebih dahulu dari pada rumput lain."
 },
 {
   "id": 13047,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 13,
   "firman": "Demikianlah pengalaman semua orang yang melupakan Allah; maka lenyaplah harapan orang fasik,"
 },
 {
   "id": 13048,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 14,
   "firman": "yang andalannya seperti benang laba-laba, kepercayaannya seperti sarang laba-laba."
 },
 {
   "id": 13049,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 15,
   "firman": "Ia bersandar pada rumahnya, tetapi rumahnya itu tidak tetap tegak, ia menjadikannya tempat berpegang, tetapi rumah itu tidak tahan."
 },
 {
   "id": 13050,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 16,
   "firman": "Ia seperti tumbuh-tumbuhan yang masih segar di panas matahari, sulurnya menjulur di seluruh taman."
 },
 {
   "id": 13051,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 17,
   "firman": "Akar-akarnya membelit timbunan batu, menyusup ke dalam sela-sela batu itu."
 },
 {
   "id": 13052,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 18,
   "firman": "Tetapi bila ia dicabut dari tempatnya, maka tempatnya itu tidak mengakuinya lagi, katanya: Belum pernah aku melihat engkau!"
 },
 {
   "id": 13053,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 19,
   "firman": "Demikianlah kesukaan hidupnya, dan tumbuh-tumbuhan lain timbul dari tanah."
 },
 {
   "id": 13054,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 20,
   "firman": "Ketahuilah, Allah tidak menolak orang yang saleh, dan Ia tidak memegang tangan orang yang berbuat jahat."
 },
 {
   "id": 13055,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 21,
   "firman": "Ia masih akan membuat mulutmu tertawa dan bibirmu bersorak-sorak."
 },
 {
   "id": 13056,
   "kitab": "Ayb",
   "pasal": 8,
   "ayat": 22,
   "firman": "Pembencimu akan terselubung dengan malu, dan kemah orang fasik akan tidak ada lagi.\""
 },
 {
   "id": 13057,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13058,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 2,
   "firman": "\"Sungguh, aku tahu, bahwa demikianlah halnya, masakan manusia benar di hadapan Allah?"
 },
 {
   "id": 13059,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 3,
   "firman": "Jikalau ia ingin beperkara dengan Allah satu dari seribu kali ia tidak dapat membantah-Nya."
 },
 {
   "id": 13060,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 4,
   "firman": "Allah itu bijak dan kuat, siapakah dapat berkeras melawan Dia, dan tetap selamat?"
 },
 {
   "id": 13061,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dialah yang memindahkan gunung-gunung dengan tidak diketahui orang, yang membongkar-bangkirkannya dalam murka-Nya;"
 },
 {
   "id": 13062,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 6,
   "firman": "yang menggeserkan bumi dari tempatnya, sehingga tiangnya bergoyang-goyang;"
 },
 {
   "id": 13063,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 7,
   "firman": "yang memberi perintah kepada matahari, sehingga tidak terbit, dan mengurung bintang-bintang dengan meterai;"
 },
 {
   "id": 13064,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 8,
   "firman": "yang seorang diri membentangkan langit, dan melangkah di atas gelombang-gelombang laut;"
 },
 {
   "id": 13065,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 9,
   "firman": "yang menjadikan bintang Biduk, bintang Belantik, bintang Kartika, dan gugusan-gugusan bintang Ruang Selatan;"
 },
 {
   "id": 13066,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 10,
   "firman": "yang melakukan perbuatan-perbuatan besar yang tidak terduga, dan keajaiban-keajaiban yang tidak terbilang banyaknya."
 },
 {
   "id": 13067,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 11,
   "firman": "Apabila Ia melewati aku, aku tidak melihat-Nya, dan bila Ia lalu, aku tidak mengetahui."
 },
 {
   "id": 13068,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 12,
   "firman": "Apabila Ia merampas, siapa akan menghalangi-Nya? Siapa akan menegur-Nya: Apa yang Kaulakukan?"
 },
 {
   "id": 13069,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 13,
   "firman": "Allah tidak menahani murka-Nya, di bawah kuasa-Nya para pembantu Rahab membungkuk;"
 },
 {
   "id": 13070,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 14,
   "firman": "lebih-lebih aku, bagaimana aku dapat membantah Dia, memilih kata-kataku di hadapan Dia?"
 },
 {
   "id": 13071,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 15,
   "firman": "Walaupun aku benar, aku tidak mungkin membantah Dia, malah aku harus memohon belas kasihan kepada yang mendakwa aku."
 },
 {
   "id": 13072,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 16,
   "firman": "Bila aku berseru, Ia menjawab; aku tidak dapat percaya, bahwa Ia sudi mendengarkan suaraku;"
 },
 {
   "id": 13073,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 17,
   "firman": "Dialah yang meremukkan aku dalam angin ribut, yang memperbanyak lukaku dengan tidak semena-mena,"
 },
 {
   "id": 13074,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 18,
   "firman": "yang tidak membiarkan aku bernafas, tetapi mengenyangkan aku dengan kepahitan."
 },
 {
   "id": 13075,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 19,
   "firman": "Jika mengenai kekuatan tenaga, Dialah yang mempunyai! Jika mengenai keadilan, siapa dapat menggugat Dia?"
 },
 {
   "id": 13076,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 20,
   "firman": "Sekalipun aku benar, mulutku sendiri akan menyatakan aku tidak benar; sekalipun aku tidak bersalah, Ia akan menyatakan aku bersalah."
 },
 {
   "id": 13077,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 21,
   "firman": "Aku tidak bersalah! Aku tidak pedulikan diriku, aku tidak hiraukan hidupku!"
 },
 {
   "id": 13078,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 22,
   "firman": "Semuanya itu sama saja, itulah sebabnya aku berkata: yang tidak bersalah dan yang bersalah kedua-duanya dibinasakan-Nya."
 },
 {
   "id": 13079,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 23,
   "firman": "Bila cemeti-Nya membunuh dengan tiba-tiba, Ia mengolok-olok keputusasaan orang yang tidak bersalah."
 },
 {
   "id": 13080,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 24,
   "firman": "Bumi telah diserahkan ke dalam tangan orang fasik, dan mata para hakimnya telah ditutup-Nya; kalau bukan oleh Dia, oleh siapa lagi?"
 },
 {
   "id": 13081,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 25,
   "firman": "Hari-hariku berlalu lebih cepat dari pada seorang pelari, lenyap tanpa melihat bahagia,"
 },
 {
   "id": 13082,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 26,
   "firman": "meluncur lewat laksana perahu dari pandan, seperti rajawali yang menyambar mangsanya."
 },
 {
   "id": 13083,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 27,
   "firman": "Bila aku berpikir: Aku hendak melupakan keluh kesahku, mengubah air mukaku, dan bergembira,"
 },
 {
   "id": 13084,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 28,
   "firman": "maka takutlah aku kepada segala kesusahanku; aku tahu, bahwa Engkau tidak akan menganggap aku tidak bersalah."
 },
 {
   "id": 13085,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 29,
   "firman": "Aku dinyatakan bersalah, apa gunanya aku menyusahkan diri dengan sia-sia?"
 },
 {
   "id": 13086,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 30,
   "firman": "Walaupun aku membasuh diriku dengan salju dan mencuci tanganku dengan sabun,"
 },
 {
   "id": 13087,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 31,
   "firman": "namun Engkau akan membenamkan aku dalam lumpur, sehingga pakaianku merasa jijik terhadap aku."
 },
 {
   "id": 13088,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 32,
   "firman": "Karena Dia bukan manusia seperti aku, sehingga aku dapat menjawab-Nya: Mari bersama-sama menghadap pengadilan."
 },
 {
   "id": 13089,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 33,
   "firman": "Tidak ada wasit di antara kami, yang dapat memegang kami berdua!"
 },
 {
   "id": 13090,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 34,
   "firman": "Biarlah Ia menyingkirkan pentung-Nya dari padaku, jangan aku ditimpa kegentaran terhadap Dia,"
 },
 {
   "id": 13091,
   "kitab": "Ayb",
   "pasal": 9,
   "ayat": 35,
   "firman": "maka aku akan berbicara tanpa rasa takut terhadap Dia, karena aku tidak menyadari kesalahanku.\""
 },
 {
   "id": 13092,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 1,
   "firman": "\"Aku telah bosan hidup, aku hendak melampiaskan keluhanku, aku hendak berbicara dalam kepahitan jiwaku."
 },
 {
   "id": 13093,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 2,
   "firman": "Aku akan berkata kepada Allah: Jangan mempersalahkan aku; beritahukanlah aku, mengapa Engkau beperkara dengan aku."
 },
 {
   "id": 13094,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 3,
   "firman": "Apakah untungnya bagi-Mu mengadakan penindasan, membuang hasil jerih payah tangan-Mu, sedangkan Engkau mendukung rancangan orang fasik?"
 },
 {
   "id": 13095,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 4,
   "firman": "Apakah Engkau mempunyai mata badani? Samakah penglihatan-Mu dengan penglihatan manusia?"
 },
 {
   "id": 13096,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 5,
   "firman": "Apakah hari-hari-Mu seperti hari-hari manusia, tahun-tahun-Mu seperti hari-hari orang laki-laki,"
 },
 {
   "id": 13097,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 6,
   "firman": "sehingga Engkau mencari-cari kesalahanku, dan mengusut dosaku,"
 },
 {
   "id": 13098,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 7,
   "firman": "padahal Engkau tahu, bahwa aku tidak bersalah, dan bahwa tiada seorangpun dapat memberi kelepasan dari tangan-Mu?"
 },
 {
   "id": 13099,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 8,
   "firman": "Tangan-Mulah yang membentuk dan membuat aku, tetapi kemudian Engkau berpaling dan hendak membinasakan aku?"
 },
 {
   "id": 13100,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 9,
   "firman": "Ingatlah, bahwa Engkau yang membuat aku dari tanah liat, tetapi Engkau hendak menjadikan aku debu kembali?"
 },
 {
   "id": 13101,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 10,
   "firman": "Bukankah Engkau yang mencurahkan aku seperti air susu, dan mengentalkan aku seperti keju?"
 },
 {
   "id": 13102,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 11,
   "firman": "Engkau mengenakan kulit dan daging kepadaku, serta menjalin aku dengan tulang dan urat."
 },
 {
   "id": 13103,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 12,
   "firman": "Hidup dan kasih setia Kaukaruniakan kepadaku, dan pemeliharaan-Mu menjaga nyawaku."
 },
 {
   "id": 13104,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 13,
   "firman": "Tetapi inilah yang Kausembunyikan di dalam hati-Mu; aku tahu, bahwa inilah maksud-Mu:"
 },
 {
   "id": 13105,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 14,
   "firman": "kalau aku berbuat dosa, maka Engkau akan mengawasi aku, dan Engkau tidak akan membebaskan aku dari pada kesalahanku."
 },
 {
   "id": 13106,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kalau aku bersalah, celakalah aku! dan kalau aku benar, aku takkan berani mengangkat kepalaku, karena kenyang dengan penghinaan, dan karena melihat sengsaraku."
 },
 {
   "id": 13107,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 16,
   "firman": "Kalau aku mengangkat kepalaku, maka seperti singa Engkau akan memburu aku, dan menunjukkan kembali kuasa-Mu yang ajaib kepadaku."
 },
 {
   "id": 13108,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 17,
   "firman": "Engkau akan mengajukan saksi-saksi baru terhadap aku, --Engkau memperbesar kegeraman-Mu terhadap aku--dan pasukan-pasukan baru, bahkan bala tentara melawan aku."
 },
 {
   "id": 13109,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 18,
   "firman": "Mengapa Engkau menyebabkan aku keluar dari kandungan? Lebih baik aku binasa, sebelum orang melihat aku!"
 },
 {
   "id": 13110,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 19,
   "firman": "Maka aku seolah-olah tidak pernah ada; dari kandungan ibu aku langsung dibawa ke kubur."
 },
 {
   "id": 13111,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 20,
   "firman": "Bukankah hari-hari umurku hanya sedikit? Biarkanlah aku, supaya aku dapat bergembira sejenak,"
 },
 {
   "id": 13112,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 21,
   "firman": "sebelum aku pergi, dan tidak kembali lagi, ke negeri yang gelap dan kelam pekat,"
 },
 {
   "id": 13113,
   "kitab": "Ayb",
   "pasal": 10,
   "ayat": 22,
   "firman": "ke negeri yang gelap gulita, tempat yang kelam pekat dan kacau balau, di mana cahaya terang serupa dengan kegelapan.\""
 },
 {
   "id": 13114,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 1,
   "firman": "Maka berbicaralah Zofar, orang Naama:"
 },
 {
   "id": 13115,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 2,
   "firman": "\"Apakah orang yang banyak bicara tidak harus dijawab? Apakah orang yang banyak mulut harus dibenarkan?"
 },
 {
   "id": 13116,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 3,
   "firman": "Apakah orang harus diam terhadap bualmu? Dan kalau engkau mengolok-olok, apakah tidak ada yang mempermalukan engkau?"
 },
 {
   "id": 13117,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 4,
   "firman": "Katamu: Pengajaranku murni, dan aku bersih di mata-Mu."
 },
 {
   "id": 13118,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 5,
   "firman": "Tetapi, mudah-mudahan Allah sendiri berfirman, dan membuka mulut-Nya terhadap engkau,"
 },
 {
   "id": 13119,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 6,
   "firman": "dan memberitakan kepadamu rahasia hikmat, karena itu ajaib bagi pengertian. Maka engkau akan mengetahui, bahwa Allah tidak memperhitungkan bagimu sebagian dari pada kesalahanmu."
 },
 {
   "id": 13120,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 7,
   "firman": "Dapatkah engkau memahami hakekat Allah, menyelami batas-batas kekuasaan Yang Mahakuasa?"
 },
 {
   "id": 13121,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 8,
   "firman": "Tingginya seperti langit--apa yang dapat kaulakukan? Dalamnya melebihi dunia orang mati--apa yang dapat kauketahui?"
 },
 {
   "id": 13122,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 9,
   "firman": "Lebih panjang dari pada bumi ukurannya, dan lebih luas dari pada samudera."
 },
 {
   "id": 13123,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 10,
   "firman": "Apabila Ia lewat, melakukan penangkapan, dan mengadakan pengadilan, siapa dapat menghalangi-Nya?"
 },
 {
   "id": 13124,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 11,
   "firman": "Karena Ia mengenal penipu dan melihat kejahatan tanpa mengamat-amatinya."
 },
 {
   "id": 13125,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 12,
   "firman": "Jikalau orang dungu dapat mengerti, maka anak keledai liarpun dapat lahir sebagai manusia."
 },
 {
   "id": 13126,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 13,
   "firman": "Jikalau engkau ini menyediakan hatimu, dan menadahkan tanganmu kepada-Nya;"
 },
 {
   "id": 13127,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 14,
   "firman": "jikalau engkau menjauhkan kejahatan dalam tanganmu, dan tidak membiarkan kecurangan ada dalam kemahmu,"
 },
 {
   "id": 13128,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 15,
   "firman": "maka sesungguhnya, engkau dapat mengangkat mukamu tanpa cela, dan engkau akan berdiri teguh dan tidak akan takut,"
 },
 {
   "id": 13129,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 16,
   "firman": "bahkan engkau akan melupakan kesusahanmu, hanya teringat kepadanya seperti kepada air yang telah mengalir lalu."
 },
 {
   "id": 13130,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 17,
   "firman": "Kehidupanmu akan menjadi lebih cemerlang dari pada siang hari, kegelapan akan menjadi terang seperti pagi hari."
 },
 {
   "id": 13131,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 18,
   "firman": "Engkau akan merasa aman, sebab ada harapan, dan sesudah memeriksa kiri kanan, engkau akan pergi tidur dengan tenteram;"
 },
 {
   "id": 13132,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 19,
   "firman": "engkau akan berbaring tidur dengan tidak diganggu, dan banyak orang akan mengambil muka kepadamu."
 },
 {
   "id": 13133,
   "kitab": "Ayb",
   "pasal": 11,
   "ayat": 20,
   "firman": "Tetapi mata orang fasik akan menjadi rabun, mereka tidak dapat melarikan diri lagi; yang masih diharapkan mereka hanyalah menghembuskan nafas.\""
 },
 {
   "id": 13134,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13135,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 2,
   "firman": "\"Memang, kamulah orang-orang itu, dan bersama-sama kamu hikmat akan mati."
 },
 {
   "id": 13136,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 3,
   "firman": "Akupun mempunyai pengertian, sama seperti kamu, aku tidak kalah dengan kamu; siapa tidak tahu hal-hal serupa itu?"
 },
 {
   "id": 13137,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 4,
   "firman": "Aku menjadi tertawaan sesamaku, aku, yang mendapat jawaban dari Allah, bila aku berseru kepada-Nya; orang yang benar dan saleh menjadi tertawaan."
 },
 {
   "id": 13138,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 5,
   "firman": "Penghinaan bagi orang yang celaka, --demikianlah pendapat orang yang hidup aman--suatu pukulan bagi orang yang tergelincir kakinya."
 },
 {
   "id": 13139,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 6,
   "firman": "Tetapi amanlah kemah para perusak, dan tenteramlah mereka yang membangkitkan murka Allah, mereka yang hendak membawa Allah dalam tangannya."
 },
 {
   "id": 13140,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 7,
   "firman": "Tetapi bertanyalah kepada binatang, maka engkau akan diberinya pengajaran, kepada burung di udara, maka engkau akan diberinya keterangan."
 },
 {
   "id": 13141,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 8,
   "firman": "Atau bertuturlah kepada bumi, maka engkau akan diberinya pengajaran, bahkan ikan di laut akan bercerita kepadamu."
 },
 {
   "id": 13142,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 9,
   "firman": "Siapa di antara semuanya itu yang tidak tahu, bahwa tangan Allah yang melakukan itu;"
 },
 {
   "id": 13143,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 10,
   "firman": "bahwa di dalam tangan-Nya terletak nyawa segala yang hidup dan nafas setiap manusia?"
 },
 {
   "id": 13144,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 11,
   "firman": "Bukankah telinga menguji kata-kata, seperti langit-langit mencecap makanan?"
 },
 {
   "id": 13145,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 12,
   "firman": "Konon hikmat ada pada orang yang tua, dan pengertian pada orang yang lanjut umurnya."
 },
 {
   "id": 13146,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 13,
   "firman": "Tetapi pada Allahlah hikmat dan kekuatan, Dialah yang mempunyai pertimbangan dan pengertian."
 },
 {
   "id": 13147,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 14,
   "firman": "Bila Ia membongkar, tidak ada yang dapat membangun kembali; bila Ia menangkap seseorang, tidak ada yang dapat melepaskannya."
 },
 {
   "id": 13148,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 15,
   "firman": "Bila Ia membendung air, keringlah semuanya; bila Ia melepaskannya mengalir, maka tanah dilandanya."
 },
 {
   "id": 13149,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 16,
   "firman": "Pada Dialah kuasa dan kemenangan, Dialah yang menguasai baik orang yang tersesat maupun orang yang menyesatkan."
 },
 {
   "id": 13150,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 17,
   "firman": "Dia yang menggiring menteri dengan telanjang, dan para hakim dibodohkan-Nya."
 },
 {
   "id": 13151,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 18,
   "firman": "Dia membuka belenggu yang dikenakan oleh raja-raja dan mengikat pinggang mereka dengan tali pengikat."
 },
 {
   "id": 13152,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 19,
   "firman": "Dia yang menggiring dan menggeledah para imam, dan menggulingkan yang kokoh."
 },
 {
   "id": 13153,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 20,
   "firman": "Dia yang membungkamkan orang-orang yang dipercaya, menjadikan para tua-tua hilang akal."
 },
 {
   "id": 13154,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 21,
   "firman": "Dia yang mendatangkan penghinaan kepada para pemuka, dan melepaskan ikat pinggang orang kuat."
 },
 {
   "id": 13155,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 22,
   "firman": "Dia yang menyingkapkan rahasia kegelapan, dan mendatangkan kelam pekat pada terang."
 },
 {
   "id": 13156,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 23,
   "firman": "Dia yang membuat bangsa-bangsa bertumbuh, lalu membinasakannya, dan memperbanyak bangsa-bangsa, lalu menghalau mereka."
 },
 {
   "id": 13157,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 24,
   "firman": "Dia menyebabkan para pemimpin dunia kehilangan akal, dan membuat mereka tersesat di padang belantara yang tidak ada jalannya."
 },
 {
   "id": 13158,
   "kitab": "Ayb",
   "pasal": 12,
   "ayat": 25,
   "firman": "Mereka meraba-raba dalam kegelapan yang tidak ada terangnya; dan Ia membuat mereka berjalan terhuyung-huyung seperti orang mabuk.\""
 },
 {
   "id": 13159,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 1,
   "firman": "\"Sesungguhnya, semuanya itu telah dilihat mataku, didengar dan dipahami telingaku."
 },
 {
   "id": 13160,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 2,
   "firman": "Apa yang kamu tahu, aku juga tahu, aku tidak kalah dengan kamu."
 },
 {
   "id": 13161,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 3,
   "firman": "Tetapi aku, aku hendak berbicara dengan Yang Mahakuasa, aku ingin membela perkaraku di hadapan Allah."
 },
 {
   "id": 13162,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 4,
   "firman": "Sebaliknya kamulah orang yang menutupi dusta, tabib palsulah kamu sekalian."
 },
 {
   "id": 13163,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 5,
   "firman": "Sekiranya kamu menutup mulut, itu akan dianggap kebijaksanaan dari padamu."
 },
 {
   "id": 13164,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 6,
   "firman": "Dengarkanlah pembelaanku, dan perhatikanlah bantahan bibirku."
 },
 {
   "id": 13165,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 7,
   "firman": "Sudikah kamu berbohong untuk Allah, sudikah kamu mengucapkan dusta untuk Dia?"
 },
 {
   "id": 13166,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 8,
   "firman": "Apakah kamu mau memihak Allah, berbantah untuk membela Dia?"
 },
 {
   "id": 13167,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 9,
   "firman": "Apakah baik, kalau Ia memeriksa kamu? Dapatkah kamu menipu Dia seperti menipu manusia?"
 },
 {
   "id": 13168,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kamu akan dihukum-Nya dengan keras, jikalau kamu diam-diam memihak."
 },
 {
   "id": 13169,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 11,
   "firman": "Apakah kebesaran-Nya tidak akan mengejutkan kamu dan ketakutan kepada-Nya menimpa kamu?"
 },
 {
   "id": 13170,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 12,
   "firman": "Dalil-dalilmu adalah amsal debu, dan perisaimu perisai tanah liat."
 },
 {
   "id": 13171,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 13,
   "firman": "Diam! Aku hendak bicara, apapun yang akan terjadi atas diriku!"
 },
 {
   "id": 13172,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 14,
   "firman": "Dagingku akan kuambil dengan gigiku, dan nyawaku akan kutatang dalam genggamku."
 },
 {
   "id": 13173,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 15,
   "firman": "Lihatlah, Ia hendak membunuh aku, tak ada harapan bagiku, namun aku hendak membela peri lakuku di hadapan-Nya."
 },
 {
   "id": 13174,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 16,
   "firman": "Itulah yang menyelamatkan aku; tetapi orang fasik tidak akan menghadap kepada-Nya."
 },
 {
   "id": 13175,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 17,
   "firman": "Dengarkanlah baik-baik perkataanku, perhatikanlah keteranganku."
 },
 {
   "id": 13176,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 18,
   "firman": "Ketahuilah, aku menyiapkan perkaraku, aku yakin, bahwa aku benar."
 },
 {
   "id": 13177,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 19,
   "firman": "Siapa mau bersengketa dengan aku? Pada saat itu juga aku mau berdiam diri dan binasa."
 },
 {
   "id": 13178,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 20,
   "firman": "Hanya janganlah Kaulakukan terhadap aku dua hal ini, maka aku tidak akan bersembunyi terhadap Engkau:"
 },
 {
   "id": 13179,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 21,
   "firman": "jauhkanlah kiranya tangan-Mu dari padaku, dan kegentaran terhadap Engkau janganlah menimpa aku!"
 },
 {
   "id": 13180,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 22,
   "firman": "Panggillah, maka aku akan menjawab; atau aku berbicara, dan Engkau menjawab."
 },
 {
   "id": 13181,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 23,
   "firman": "Berapa besar kesalahan dan dosaku? Beritahukanlah kepadaku pelanggaran dan dosaku itu."
 },
 {
   "id": 13182,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 24,
   "firman": "Mengapa Engkau menyembunyikan wajah-Mu, dan menganggap aku sebagai musuh-Mu?"
 },
 {
   "id": 13183,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 25,
   "firman": "Apakah Engkau hendak menggentarkan daun yang ditiupkan angin, dan mengejar jerami yang kering?"
 },
 {
   "id": 13184,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 26,
   "firman": "Sebab Engkau menulis hal-hal yang pahit terhadap aku dan menghukum aku karena kesalahan pada masa mudaku;"
 },
 {
   "id": 13185,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 27,
   "firman": "kakiku Kaumasukkan ke dalam pasung, segala tindak tandukku Kauawasi, dan rintangan Kaupasang di depan tapak kakiku?"
 },
 {
   "id": 13186,
   "kitab": "Ayb",
   "pasal": 13,
   "ayat": 28,
   "firman": "Dan semuanya itu terhadap orang yang sudah rapuh seperti kayu lapuk, seperti kain yang dimakan gegat!\""
 },
 {
   "id": 13187,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 1,
   "firman": "\"Manusia yang lahir dari perempuan, singkat umurnya dan penuh kegelisahan."
 },
 {
   "id": 13188,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 2,
   "firman": "Seperti bunga ia berkembang, lalu layu, seperti bayang-bayang ia hilang lenyap dan tidak dapat bertahan."
 },
 {
   "id": 13189,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 3,
   "firman": "Masakan Engkau menujukan pandangan-Mu kepada orang seperti itu, dan menghadapkan kepada-Mu untuk diadili?"
 },
 {
   "id": 13190,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 4,
   "firman": "Siapa dapat mendatangkan yang tahir dari yang najis? Seorangpun tidak!"
 },
 {
   "id": 13191,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 5,
   "firman": "Jikalau hari-harinya sudah pasti, dan jumlah bulannya sudah tentu pada-Mu, dan batas-batasnya sudah Kautetapkan, sehingga tidak dapat dilangkahinya,"
 },
 {
   "id": 13192,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 6,
   "firman": "hendaklah Kaualihkan pandangan-Mu dari padanya, agar ia beristirahat, sehingga ia seperti orang upahan dapat menikmati harinya."
 },
 {
   "id": 13193,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 7,
   "firman": "Karena bagi pohon masih ada harapan: apabila ditebang, ia bertunas kembali, dan tunasnya tidak berhenti tumbuh."
 },
 {
   "id": 13194,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 8,
   "firman": "Apabila akarnya menjadi tua di dalam tanah, dan tunggulnya mati di dalam debu,"
 },
 {
   "id": 13195,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 9,
   "firman": "maka bersemilah ia, setelah diciumnya air, dan dikeluarkannyalah ranting seperti semai."
 },
 {
   "id": 13196,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 10,
   "firman": "Tetapi bila manusia mati, maka tidak berdayalah ia, bila orang binasa, di manakah ia?"
 },
 {
   "id": 13197,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 11,
   "firman": "Seperti air menguap dari dalam tasik, dan sungai surut dan menjadi kering,"
 },
 {
   "id": 13198,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 12,
   "firman": "demikian juga manusia berbaring dan tidak bangkit lagi, sampai langit hilang lenyap, mereka tidak terjaga, dan tidak bangun dari tidurnya."
 },
 {
   "id": 13199,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 13,
   "firman": "Ah, kiranya Engkau menyembunyikan aku di dalam dunia orang mati, melindungi aku, sampai murka-Mu surut; dan menetapkan waktu bagiku, kemudian mengingat aku pula!"
 },
 {
   "id": 13200,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 14,
   "firman": "Kalau manusia mati, dapatkah ia hidup lagi? Maka aku akan menaruh harap selama hari-hari pergumulanku, sampai tiba giliranku;"
 },
 {
   "id": 13201,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 15,
   "firman": "maka Engkau akan memanggil, dan akupun akan menyahut; Engkau akan rindu kepada buatan tangan-Mu."
 },
 {
   "id": 13202,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 16,
   "firman": "Sungguhpun Engkau menghitung langkahku, Engkau tidak akan memperhatikan dosaku;"
 },
 {
   "id": 13203,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 17,
   "firman": "pelanggaranku akan dimasukkan di dalam pundi-pundi yang dimeteraikan, dan kesalahanku akan Kaututup dengan lepa."
 },
 {
   "id": 13204,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 18,
   "firman": "Tetapi seperti gunung runtuh berantakan, dan gunung batu bergeser dari tempatnya,"
 },
 {
   "id": 13205,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 19,
   "firman": "seperti batu-batu dikikis air, dan bumi dihanyutkan tanahnya oleh hujan lebat, demikianlah Kauhancurkan harapan manusia."
 },
 {
   "id": 13206,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 20,
   "firman": "Engkau menggagahi dia untuk selama-lamanya, maka pergilah ia, Engkau mengubah wajahnya dan menyuruh dia pergi."
 },
 {
   "id": 13207,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 21,
   "firman": "Anak-anaknya menjadi mulia, tetapi ia tidak tahu; atau mereka menjadi hina, tetapi ia tidak menyadarinya."
 },
 {
   "id": 13208,
   "kitab": "Ayb",
   "pasal": 14,
   "ayat": 22,
   "firman": "Hanya tubuhnya membuat dirinya menderita, dan karena dirinya sendiri jiwanya berduka cita.\""
 },
 {
   "id": 13209,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 1,
   "firman": "Maka Elifas, orang Teman, menjawab:"
 },
 {
   "id": 13210,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 2,
   "firman": "\"Apakah orang yang mempunyai hikmat menjawab dengan pengetahuan kosong, dan mengisi pikirannya dengan angin?"
 },
 {
   "id": 13211,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 3,
   "firman": "Apakah ia menegur dengan percakapan yang tidak berguna, dan dengan perkataan yang tidak berfaedah?"
 },
 {
   "id": 13212,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 4,
   "firman": "Lagipula engkau melenyapkan rasa takut dan mengurangi rasa hormat kepada Allah."
 },
 {
   "id": 13213,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 5,
   "firman": "Kesalahanmulah yang mengajar mulutmu, dan bahasa orang licik yang kaupilih."
 },
 {
   "id": 13214,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 6,
   "firman": "Mulutmu sendirilah yang mempersalahkan engkau, bukan aku; bibirmu sendiri menjadi saksi menentang engkau."
 },
 {
   "id": 13215,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 7,
   "firman": "Apakah engkau dilahirkan sebagai manusia yang pertama, atau dijadikan lebih dahulu dari pada bukit-bukit?"
 },
 {
   "id": 13216,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 8,
   "firman": "Apakah engkau turut mendengarkan di dalam musyawarah Allah dan meraih hikmat bagi dirimu?"
 },
 {
   "id": 13217,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 9,
   "firman": "Apakah yang kauketahui, yang tidak kami ketahui? Apakah yang kaumengerti, yang tidak terang bagi kami?"
 },
 {
   "id": 13218,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 10,
   "firman": "Di antara kami juga ada orang yang beruban dan yang lanjut umurnya, yang lebih tua umurnya dari pada ayahmu."
 },
 {
   "id": 13219,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 11,
   "firman": "Kurangkah artinya bagimu penghiburan Allah, dan perkataan yang dengan lemah lembut ditujukan kepadamu?"
 },
 {
   "id": 13220,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 12,
   "firman": "Mengapa engkau dihanyutkan oleh perasaan hatimu dan mengapa matamu menyala-nyala,"
 },
 {
   "id": 13221,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 13,
   "firman": "sehingga engkau memalingkan hatimu menentang Allah, dan mulutmu mengeluarkan perkataan serupa itu?"
 },
 {
   "id": 13222,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 14,
   "firman": "Masakan manusia bersih, masakan benar yang lahir dari perempuan?"
 },
 {
   "id": 13223,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 15,
   "firman": "Sesungguhnya, para suci-Nya tidak dipercayai-Nya, seluruh langitpun tidak bersih pada pandangan-Nya;"
 },
 {
   "id": 13224,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 16,
   "firman": "lebih-lebih lagi orang yang keji dan bejat, yang menghirup kecurangan seperti air."
 },
 {
   "id": 13225,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 17,
   "firman": "Aku hendak menerangkan sesuatu kepadamu, dengarkanlah aku, dan apa yang telah kulihat, hendak kuceritakan,"
 },
 {
   "id": 13226,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 18,
   "firman": "yakni apa yang diberitakan oleh orang yang mempunyai hikmat, yang nenek moyang mereka tidak sembunyikan,"
 },
 {
   "id": 13227,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 19,
   "firman": "ketika hanya kepada mereka negeri itu diberikan, dan tidak ada seorang asingpun masuk ke tengah-tengah mereka."
 },
 {
   "id": 13228,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 20,
   "firman": "Orang fasik menggeletar sepanjang hidupnya, demikian juga orang lalim selama tahun-tahun yang disediakan baginya."
 },
 {
   "id": 13229,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 21,
   "firman": "Bunyi yang dahsyat sampai ke telinganya, pada masa damai ia didatangi perusak."
 },
 {
   "id": 13230,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 22,
   "firman": "Ia tidak percaya, bahwa ia akan kembali dari kegelapan: ia sudah ditentukan untuk dimakan pedang."
 },
 {
   "id": 13231,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 23,
   "firman": "Ia mengembara untuk mencari makan, entah ke mana. Ia tahu, bahwa hari kegelapan siap menantikan dia."
 },
 {
   "id": 13232,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 24,
   "firman": "Ia ditakutkan oleh kesesakan dan kesempitan, yang menggagahinya laksana raja yang siap menyergap."
 },
 {
   "id": 13233,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 25,
   "firman": "Karena ia telah mengedangkan tangannya melawan Allah dan berani menantang Yang Mahakuasa;"
 },
 {
   "id": 13234,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 26,
   "firman": "dengan bertegang leher ia berlari-lari menghadapi Dia, dengan perisainya yang berlapis tebal."
 },
 {
   "id": 13235,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 27,
   "firman": "Mukanya telah ditutupinya dengan lemak, dan lapisan lemak dikenakannya pada pinggangnya;"
 },
 {
   "id": 13236,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 28,
   "firman": "ia menetap di kota-kota yang telah hancur, di rumah-rumah yang tidak dapat didiami orang, yang ditentukan untuk tetap menjadi reruntuhan."
 },
 {
   "id": 13237,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 29,
   "firman": "Ia takkan menjadi kaya dan hartanya tidak kekal, serta miliknyapun tidak bertambah-tambah di bumi."
 },
 {
   "id": 13238,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 30,
   "firman": "Ia tidak akan luput dari kegelapan, tunasnya akan dilayukan oleh nyala api, dan ia akan dilenyapkan oleh nafas mulut-Nya."
 },
 {
   "id": 13239,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 31,
   "firman": "Janganlah ia percaya kepada kesia-siaan, akan tertipulah ia, karena kesia-siaan akan menjadi ganjarannya."
 },
 {
   "id": 13240,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 32,
   "firman": "Sebelum genap masanya, ajalnya akan sampai; dan rantingnyapun tidak akan menghijau."
 },
 {
   "id": 13241,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 33,
   "firman": "Ia seperti pohon anggur yang gugur buahnya dan seperti pohon zaitun yang jatuh bunganya."
 },
 {
   "id": 13242,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 34,
   "firman": "Karena kawanan orang-orang fasik tidak berhasil, dan api memakan habis kemah-kemah orang yang makan suap."
 },
 {
   "id": 13243,
   "kitab": "Ayb",
   "pasal": 15,
   "ayat": 35,
   "firman": "Mereka menghamilkan bencana dan melahirkan kejahatan, dan tipu daya dikandung hati mereka.\""
 },
 {
   "id": 13244,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13245,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 2,
   "firman": "\"Hal seperti itu telah acap kali kudengar. Penghibur sialan kamu semua!"
 },
 {
   "id": 13246,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 3,
   "firman": "Belum habiskah omong kosong itu? Apa yang merangsang engkau untuk menyanggah?"
 },
 {
   "id": 13247,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 4,
   "firman": "Akupun dapat berbicara seperti kamu, sekiranya kamu pada tempatku; aku akan menggubah kata-kata indah terhadap kamu, dan menggeleng-gelengkan kepala atas kamu."
 },
 {
   "id": 13248,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 5,
   "firman": "Aku akan menguatkan hatimu dengan mulut, dan tidak menahan bibirku mengatakan belas kasihan."
 },
 {
   "id": 13249,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 6,
   "firman": "Tetapi bila aku berbicara, penderitaanku tidak menjadi ringan, dan bila aku berdiam diri, apakah yang hilang dari padaku?"
 },
 {
   "id": 13250,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 7,
   "firman": "Tetapi sekarang, Ia telah membuat aku lelah dan mencerai-beraikan segenap rumah tanggaku,"
 },
 {
   "id": 13251,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 8,
   "firman": "sudah menangkap aku; inilah yang menjadi saksi; kekurusanku telah bangkit menuduh aku."
 },
 {
   "id": 13252,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 9,
   "firman": "Murka-Nya menerkam dan memusuhi aku, Ia menggertakkan giginya terhadap aku; lawanku memandang aku dengan mata yang berapi-api."
 },
 {
   "id": 13253,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 10,
   "firman": "Mereka mengangakan mulutnya melawan aku, menampar pipiku dengan cercaan, dan bersama-sama mengerumuni aku."
 },
 {
   "id": 13254,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 11,
   "firman": "Allah menyerahkan aku kepada orang lalim, dan menjatuhkan aku ke dalam tangan orang fasik."
 },
 {
   "id": 13255,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 12,
   "firman": "Aku hidup dengan tenteram, tetapi Ia menggelisahkan aku, aku ditangkap-Nya pada tengkukku, lalu dibanting-Nya, dan aku ditegakkan-Nya menjadi sasaran-Nya."
 },
 {
   "id": 13256,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 13,
   "firman": "Aku dihujani anak panah, ginjalku ditembus-Nya dengan tak kenal belas kasihan, empeduku ditumpahkan-Nya ke tanah."
 },
 {
   "id": 13257,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 14,
   "firman": "Ia merobek-robek aku, menyerang aku laksana seorang pejuang."
 },
 {
   "id": 13258,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 15,
   "firman": "Kain kabung telah kujahit pada kulitku, dan tandukku kumasukkan ke dalam debu;"
 },
 {
   "id": 13259,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 16,
   "firman": "mukaku merah karena menangis, dan bulu mataku ditudungi kelam pekat,"
 },
 {
   "id": 13260,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 17,
   "firman": "sungguhpun tidak ada kelaliman pada tanganku, dan doaku bersih."
 },
 {
   "id": 13261,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 18,
   "firman": "Hai bumi, janganlah menutupi darahku, dan janganlah kiranya teriakku mendapat tempat perhentian!"
 },
 {
   "id": 13262,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 19,
   "firman": "Ketahuilah, sekarangpun juga, Saksiku ada di sorga, Yang memberi kesaksian bagiku ada di tempat yang tinggi."
 },
 {
   "id": 13263,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 20,
   "firman": "Sekalipun aku dicemoohkan oleh sahabat-sahabatku, namun ke arah Allah mataku menengadah sambil menangis,"
 },
 {
   "id": 13264,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 21,
   "firman": "supaya Ia memutuskan perkara antara manusia dengan Allah, dan antara manusia dengan sesamanya."
 },
 {
   "id": 13265,
   "kitab": "Ayb",
   "pasal": 16,
   "ayat": 22,
   "firman": "Karena sedikit jumlah tahun yang akan datang, dan aku akan menempuh jalan, dari mana aku tak akan kembali lagi."
 },
 {
   "id": 13266,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 1,
   "firman": "Semangatku patah, umurku telah habis, dan bagiku tersedia kuburan."
 },
 {
   "id": 13267,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 2,
   "firman": "Sesungguhnya, aku menjadi ejekan; mataku terpaksa menyaksikan tantangan mereka."
 },
 {
   "id": 13268,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 3,
   "firman": "Biarlah Engkau menjadi jaminanku bagi-Mu sendiri! Siapa lagi yang dapat membuat persetujuan bagiku?"
 },
 {
   "id": 13269,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 4,
   "firman": "Karena hati mereka telah Kaukatupkan bagi pengertian; itulah sebabnya Engkau mencegah mereka untuk menang."
 },
 {
   "id": 13270,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 5,
   "firman": "Barangsiapa mengadukan sahabatnya untuk mencari keuntungan, mata anak-anaknya akan menjadi rabun."
 },
 {
   "id": 13271,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 6,
   "firman": "Aku telah dijadikan sindiran di antara bangsa-bangsa, dan aku menjadi orang yang diludahi mukanya."
 },
 {
   "id": 13272,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 7,
   "firman": "Mataku menjadi kabur karena pedih hati, segala anggota tubuhku seperti bayang-bayang."
 },
 {
   "id": 13273,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 8,
   "firman": "Orang-orang yang jujur tercengang karena hal itu, dan orang yang tidak bersalah naik pitam terhadap orang fasik."
 },
 {
   "id": 13274,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 9,
   "firman": "Meskipun begitu orang yang benar tetap pada jalannya, dan orang yang bersih tangannya bertambah-tambah kuat."
 },
 {
   "id": 13275,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 10,
   "firman": "Tetapi kamu sekalian, silakan datang kembali! Seorang yang mempunyai hikmat takkan kudapati di antara kamu!"
 },
 {
   "id": 13276,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 11,
   "firman": "Umurku telah lalu, telah gagal rencana-rencanaku, cita-citaku."
 },
 {
   "id": 13277,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 12,
   "firman": "Malam hendak dijadikan mereka siang: terang segera muncul dari gelap, kata mereka."
 },
 {
   "id": 13278,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 13,
   "firman": "Apabila aku mengharapkan dunia orang mati sebagai rumahku, menyediakan tempat tidurku di dalam kegelapan,"
 },
 {
   "id": 13279,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 14,
   "firman": "dan berkata kepada liang kubur: Engkau ayahku, kepada berenga: Ibuku dan saudara perempuanku,"
 },
 {
   "id": 13280,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 15,
   "firman": "maka di manakah harapanku? Siapakah yang melihat adanya harapan bagiku?"
 },
 {
   "id": 13281,
   "kitab": "Ayb",
   "pasal": 17,
   "ayat": 16,
   "firman": "Keduanya akan tenggelam ke dasar dunia orang mati, apabila kami bersama-sama turun ke dalam debu.\""
 },
 {
   "id": 13282,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 1,
   "firman": "Maka Bildad, orang Suah, menjawab:"
 },
 {
   "id": 13283,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 2,
   "firman": "\"Bilakah engkau habis bicara? Sadarilah, baru kami akan bicara."
 },
 {
   "id": 13284,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 3,
   "firman": "Mengapa kami dianggap binatang? Mengapa kami bodoh dalam pandanganmu?"
 },
 {
   "id": 13285,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 4,
   "firman": "Engkau yang menerkam dirimu sendiri dalam kemarahan, demi kepentinganmukah bumi harus menjadi sunyi, dan gunung batu bergeser dari tempatnya?"
 },
 {
   "id": 13286,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 5,
   "firman": "Bagaimanapun juga terang orang fasik tentu padam, dan nyala apinya tidak tetap bersinar."
 },
 {
   "id": 13287,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 6,
   "firman": "Terang di dalam kemahnya menjadi gelap, dan pelita di atasnya padam."
 },
 {
   "id": 13288,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 7,
   "firman": "Langkahnya yang kuat terhambat, dan pertimbangannya sendiri menjatuhkan dia."
 },
 {
   "id": 13289,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 8,
   "firman": "Karena kakinya sendiri menyangkutkan dia dalam jaring, dan di atas tutup pelubang ia berjalan."
 },
 {
   "id": 13290,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 9,
   "firman": "Tumitnya tertangkap oleh jebak, dan ia tertahan oleh jerat."
 },
 {
   "id": 13291,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 10,
   "firman": "Tali tersembunyi baginya dalam tanah, perangkap terpasang baginya pada jalan yang dilaluinya."
 },
 {
   "id": 13292,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 11,
   "firman": "Kedahsyatan mengejutkan dia di mana-mana, dan mengejarnya di mana juga ia melangkah."
 },
 {
   "id": 13293,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 12,
   "firman": "Bencana mengidamkan dia, kebinasaan bersiap-siap menantikan dia jatuh."
 },
 {
   "id": 13294,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 13,
   "firman": "Kulit tubuhnya dimakan penyakit, bahkan anggota tubuhnya dimakan oleh penyakit parah."
 },
 {
   "id": 13295,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 14,
   "firman": "Ia diseret dari kemahnya, tempat ia merasa aman, dan dibawa kepada raja kedahsyatan."
 },
 {
   "id": 13296,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 15,
   "firman": "Dalam kemahnya tinggal apa yang tidak ada sangkut pautnya dengan dia, di atas tempat kediamannya ditaburkan belerang."
 },
 {
   "id": 13297,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 16,
   "firman": "Di bawah keringlah akar-akarnya, dan di atas layulah rantingnya."
 },
 {
   "id": 13298,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 17,
   "firman": "Ingatan kepadanya lenyap dari bumi, namanya tidak lagi disebut di lorong-lorong."
 },
 {
   "id": 13299,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 18,
   "firman": "Ia diusir dari tempat terang ke dalam kegelapan, dan ia dienyahkan dari dunia."
 },
 {
   "id": 13300,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 19,
   "firman": "Ia tidak akan mempunyai anak atau cucu cicit di antara bangsanya, dan tak seorangpun yang tinggal hidup di tempat kediamannya."
 },
 {
   "id": 13301,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 20,
   "firman": "Atas hari ajalnya orang-orang di Barat akan tercengang, dan orang-orang di Timur akan dihinggapi ketakutan."
 },
 {
   "id": 13302,
   "kitab": "Ayb",
   "pasal": 18,
   "ayat": 21,
   "firman": "Sungguh, demikianlah tempat kediaman orang yang curang, begitulah tempat tinggal orang yang tidak mengenal Allah.\""
 },
 {
   "id": 13303,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13304,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 2,
   "firman": "\"Berapa lama lagi kamu menyakitkan hatiku, dan meremukkan aku dengan perkataan?"
 },
 {
   "id": 13305,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 3,
   "firman": "Sekarang telah sepuluh kali kamu menghina aku, kamu tidak malu menyiksa aku."
 },
 {
   "id": 13306,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 4,
   "firman": "Jika aku sungguh tersesat, maka aku sendiri yang menanggung kesesatanku itu."
 },
 {
   "id": 13307,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 5,
   "firman": "Jika kamu sungguh hendak membesarkan diri terhadap aku, dan membuat celaku sebagai bukti terhadap diriku,"
 },
 {
   "id": 13308,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 6,
   "firman": "insafilah, bahwa Allah telah berlaku tidak adil terhadap aku, dan menebarkan jala-Nya atasku."
 },
 {
   "id": 13309,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 7,
   "firman": "Sesungguhnya, aku berteriak: Kelaliman!, tetapi tidak ada yang menjawab. Aku berseru minta tolong, tetapi tidak ada keadilan."
 },
 {
   "id": 13310,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 8,
   "firman": "Jalanku ditutup-Nya dengan tembok, sehingga aku tidak dapat melewatinya, dan jalan-jalanku itu dibuat-Nya gelap."
 },
 {
   "id": 13311,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 9,
   "firman": "Ia telah menanggalkan kemuliaanku dan merampas mahkota di kepalaku."
 },
 {
   "id": 13312,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 10,
   "firman": "Ia membongkar aku di semua tempat, sehingga aku lenyap, dan seperti pohon harapanku dicabut-Nya."
 },
 {
   "id": 13313,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 11,
   "firman": "Murka-Nya menyala terhadap aku, dan menganggap aku sebagai lawan-Nya."
 },
 {
   "id": 13314,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 12,
   "firman": "Pasukan-Nya maju serentak, mereka merintangi jalan melawan aku, lalu mengepung kemahku."
 },
 {
   "id": 13315,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 13,
   "firman": "Saudara-saudaraku dijauhkan-Nya dari padaku, dan kenalan-kenalanku tidak lagi mengenal aku."
 },
 {
   "id": 13316,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 14,
   "firman": "Kaum kerabatku menghindar, dan kawan-kawanku melupakan aku."
 },
 {
   "id": 13317,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 15,
   "firman": "Anak semang dan budak perempuanku menganggap aku orang yang tidak dikenal, aku dipandang mereka orang asing."
 },
 {
   "id": 13318,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 16,
   "firman": "Kalau aku memanggil budakku, ia tidak menyahut; aku harus membujuknya dengan kata-kata manis."
 },
 {
   "id": 13319,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 17,
   "firman": "Nafasku menimbulkan rasa jijik kepada isteriku, dan bauku memualkan saudara-saudara sekandungku."
 },
 {
   "id": 13320,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 18,
   "firman": "Bahkan kanak-kanakpun menghina aku, kalau aku mau berdiri, mereka mengejek aku."
 },
 {
   "id": 13321,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 19,
   "firman": "Semua teman karibku merasa muak terhadap aku; dan mereka yang kukasihi, berbalik melawan aku."
 },
 {
   "id": 13322,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 20,
   "firman": "Tulangku melekat pada kulit dan dagingku, dan hanya gusiku yang tinggal padaku."
 },
 {
   "id": 13323,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 21,
   "firman": "Kasihanilah aku, kasihanilah aku, hai sahabat-sahabatku, karena tangan Allah telah menimpa aku."
 },
 {
   "id": 13324,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 22,
   "firman": "Mengapa kamu mengejar aku, seakan-akan Allah, dan tidak menjadi kenyang makan dagingku?"
 },
 {
   "id": 13325,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 23,
   "firman": "Ah, kiranya perkataanku ditulis, dicatat dalam kitab,"
 },
 {
   "id": 13326,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 24,
   "firman": "terpahat dengan besi pengukir dan timah pada gunung batu untuk selama-lamanya!"
 },
 {
   "id": 13327,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 25,
   "firman": "Tetapi aku tahu: Penebusku hidup, dan akhirnya Ia akan bangkit di atas debu."
 },
 {
   "id": 13328,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 26,
   "firman": "Juga sesudah kulit tubuhku sangat rusak, tanpa dagingkupun aku akan melihat Allah,"
 },
 {
   "id": 13329,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 27,
   "firman": "yang aku sendiri akan melihat memihak kepadaku; mataku sendiri menyaksikan-Nya dan bukan orang lain. Hati sanubariku merana karena rindu."
 },
 {
   "id": 13330,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 28,
   "firman": "Kalau kamu berkata: Kami akan menuntut dia dan mendapatkan padanya sebab perkaranya!,"
 },
 {
   "id": 13331,
   "kitab": "Ayb",
   "pasal": 19,
   "ayat": 29,
   "firman": "takutlah kepada pedang, karena kegeraman mendatangkan hukuman pedang, agar kamu tahu, bahwa ada pengadilan.\""
 },
 {
   "id": 13332,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 1,
   "firman": "Maka Zofar, orang Naama, menjawab:"
 },
 {
   "id": 13333,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 2,
   "firman": "\"Oleh sebab itulah pikiran-pikiranku mendorong aku menjawab, karena hatiku tidak sabar lagi."
 },
 {
   "id": 13334,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 3,
   "firman": "Kudengar teguran yang menghina aku, tetapi yang menjawab aku ialah akal budi yang tidak berpengertian."
 },
 {
   "id": 13335,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 4,
   "firman": "Belumkah engkau mengetahui semuanya itu sejak dahulu kala, sejak manusia ditempatkan di bumi,"
 },
 {
   "id": 13336,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 5,
   "firman": "bahwa sorak-sorai orang fasik hanya sebentar saja, dan sukacita orang durhaka hanya sekejap mata?"
 },
 {
   "id": 13337,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 6,
   "firman": "Walaupun keangkuhannya sampai ke langit dan kepalanya mengenai awan,"
 },
 {
   "id": 13338,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 7,
   "firman": "namun seperti tahinya ia akan binasa untuk selama-lamanya; siapa yang pernah melihatnya, bertanya: Di mana dia?"
 },
 {
   "id": 13339,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 8,
   "firman": "Bagaikan impian ia melayang hilang, tak berbekas, lenyap bagaikan penglihatan waktu malam."
 },
 {
   "id": 13340,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 9,
   "firman": "Ia tidak lagi tampak pada mata yang melihatnya, dan tempat kediamannya tidak melihatnya lagi."
 },
 {
   "id": 13341,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 10,
   "firman": "Anak-anaknya harus mencari belas kasihan orang miskin, dan tangannya sendiri harus mengembalikan kekayaannya."
 },
 {
   "id": 13342,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 11,
   "firman": "Tulang-tulangnya boleh penuh tenaga orang muda, tetapi tenaga itupun akan membaringkan diri bersama dia dalam debu."
 },
 {
   "id": 13343,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 12,
   "firman": "Sungguhpun kejahatan manis rasanya di dalam mulutnya, sekalipun ia menyembunyikannya di bawah lidahnya,"
 },
 {
   "id": 13344,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 13,
   "firman": "menikmatinya serta tidak melepaskannya, dan menahannya pada langit-langitnya,"
 },
 {
   "id": 13345,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 14,
   "firman": "namun berubah juga makanannya di dalam perutnya, menjadi bisa ular tedung di dalamnya."
 },
 {
   "id": 13346,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 15,
   "firman": "Harta benda ditelannya, tetapi dimuntahkannya lagi, Allah yang mengeluarkannya dari dalam perutnya."
 },
 {
   "id": 13347,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 16,
   "firman": "Bisa ular tedung akan diisapnya, ia akan dibunuh oleh lidah ular."
 },
 {
   "id": 13348,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 17,
   "firman": "Ia tidak boleh melihat batang-batang air dan sungai-sungai yang mengalirkan madu dan dadih."
 },
 {
   "id": 13349,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 18,
   "firman": "Ia harus mengembalikan apa yang diperolehnya dan tidak mengecapnya; ia tidak menikmati kekayaan hasil dagangnya."
 },
 {
   "id": 13350,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 19,
   "firman": "Karena ia telah menghancurkan orang miskin, dan meninggalkan mereka terlantar; ia merampas rumah yang tidak dibangunnya."
 },
 {
   "id": 13351,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 20,
   "firman": "Sesungguhnya, ia tidak mengenal ketenangan dalam batinnya, dan ia tidak akan terluput dengan membawa harta bendanya."
 },
 {
   "id": 13352,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 21,
   "firman": "Suatupun tidak luput dari pada lahapnya, itulah sebabnya kemujurannya tidak kekal."
 },
 {
   "id": 13353,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 22,
   "firman": "Dalam kemewahannya yang berlimpah-limpah ia penuh kuatir; ia ditimpa kesusahan dengan sangat dahsyatnya."
 },
 {
   "id": 13354,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 23,
   "firman": "Untuk mengisi perutnya, Allah melepaskan ke atasnya murka-Nya yang menyala-nyala, dan menghujankan itu kepadanya sebagai makanannya."
 },
 {
   "id": 13355,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 24,
   "firman": "Ia dapat meluputkan diri terhadap senjata besi, namun panah tembaga menembus dia."
 },
 {
   "id": 13356,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 25,
   "firman": "Anak panah itu tercabut dan keluar dari punggungnya, mata panah yang berkilat itu keluar dari empedunya: ia menjadi ngeri."
 },
 {
   "id": 13357,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 26,
   "firman": "Kegelapan semata-mata tersedia bagi dia, api yang tidak ditiup memakan dia dan menghabiskan apa yang tersisa dalam kemahnya."
 },
 {
   "id": 13358,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 27,
   "firman": "Langit menyingkapkan kesalahannya, dan bumi bangkit melawan dia."
 },
 {
   "id": 13359,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 28,
   "firman": "Hasil usahanya yang ada di rumahnya diangkut, semuanya habis pada hari murka-Nya."
 },
 {
   "id": 13360,
   "kitab": "Ayb",
   "pasal": 20,
   "ayat": 29,
   "firman": "Itulah ganjaran Allah bagi orang fasik, milik pusaka yang dijanjikan Allah kepadanya.\""
 },
 {
   "id": 13361,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13362,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 2,
   "firman": "\"Dengarkanlah baik-baik perkataanku dan biarlah itu menjadi penghiburanmu."
 },
 {
   "id": 13363,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 3,
   "firman": "Bersabarlah dengan aku, aku akan berbicara; sehabis bicaraku bolehlah kamu mengejek."
 },
 {
   "id": 13364,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 4,
   "firman": "Kepada manusiakah keluhanku tertuju? Mengapa aku tidak boleh kesal hati?"
 },
 {
   "id": 13365,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 5,
   "firman": "Berpalinglah kepadaku, maka kamu akan tercengang, dan menutup mulutmu dengan tangan!"
 },
 {
   "id": 13366,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 6,
   "firman": "Kalau aku memikirkannya, aku menjadi takut, dan gemetarlah tubuhku."
 },
 {
   "id": 13367,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 7,
   "firman": "Mengapa orang fasik tetap hidup, menjadi tua, bahkan menjadi bertambah-tambah kuat?"
 },
 {
   "id": 13368,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 8,
   "firman": "Keturunan mereka tetap bersama mereka, dan anak cucu diperhatikan mereka."
 },
 {
   "id": 13369,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 9,
   "firman": "Rumah-rumah mereka aman, tak ada ketakutan, pentung Allah tidak menimpa mereka."
 },
 {
   "id": 13370,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 10,
   "firman": "Lembu jantan mereka memacek dan tidak gagal, lembu betina mereka beranak dan tidak keguguran."
 },
 {
   "id": 13371,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 11,
   "firman": "Kanak-kanak mereka dibiarkan keluar seperti kambing domba, anak-anak mereka melompat-lompat."
 },
 {
   "id": 13372,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 12,
   "firman": "Mereka bernyanyi-nyanyi dengan iringan rebana dan kecapi, dan bersukaria menurut lagu seruling."
 },
 {
   "id": 13373,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 13,
   "firman": "Mereka menghabiskan hari-hari mereka dalam kemujuran, dan dengan tenang mereka turun ke dalam dunia orang mati."
 },
 {
   "id": 13374,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 14,
   "firman": "Tetapi kata mereka kepada Allah: Pergilah dari kami! Kami tidak suka mengetahui jalan-jalan-Mu."
 },
 {
   "id": 13375,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 15,
   "firman": "Yang Mahakuasa itu apa, sehingga kami harus beribadah kepada-Nya, dan apa manfaatnya bagi kami, kalau kami memohon kepada-Nya?"
 },
 {
   "id": 13376,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 16,
   "firman": "Memang, kemujuran mereka tidak terletak dalam kuasa mereka sendiri! Rancangan orang fasik adalah jauh dari padaku."
 },
 {
   "id": 13377,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 17,
   "firman": "Betapa sering pelita orang fasik dipadamkan, kebinasaan menimpa mereka, dan kesakitan dibagikan Allah kepada mereka dalam murka-Nya!"
 },
 {
   "id": 13378,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 18,
   "firman": "Mereka menjadi seperti jerami di depan angin, seperti sekam yang diterbangkan badai."
 },
 {
   "id": 13379,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 19,
   "firman": "Bencana untuk dia disimpan Allah bagi anak-anaknya. Sebaiknya, orang itu sendiri diganjar Allah, supaya sadar;"
 },
 {
   "id": 13380,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 20,
   "firman": "sebaiknya matanya sendiri melihat kebinasaannya, dan ia sendiri minum dari murka Yang Mahakuasa!"
 },
 {
   "id": 13381,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 21,
   "firman": "Karena peduli apa ia dengan keluarganya sesudah ia mati, bila telah habis jumlah bulannya?"
 },
 {
   "id": 13382,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 22,
   "firman": "Masakan kepada Allah diajarkan orang pengetahuan, kepada Dia yang mengadili mereka yang di tempat tinggi?"
 },
 {
   "id": 13383,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 23,
   "firman": "Yang seorang mati dengan masih penuh tenaga, dengan sangat tenang dan sentosa;"
 },
 {
   "id": 13384,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 24,
   "firman": "pinggangnya gemuk oleh lemak, dan sumsum tulang-tulangnya masih segar."
 },
 {
   "id": 13385,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 25,
   "firman": "Yang lain mati dengan sakit hati, dengan tidak pernah merasakan kenikmatan."
 },
 {
   "id": 13386,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 26,
   "firman": "Tetapi sama-sama mereka terbaring di dalam debu, dan berenga-berenga berkeriapan di atas mereka."
 },
 {
   "id": 13387,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 27,
   "firman": "Sesungguhnya, aku mengetahui pikiranmu, dan muslihat yang kamu rancangkan terhadap aku."
 },
 {
   "id": 13388,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 28,
   "firman": "Katamu: Di mana rumah penguasa? Di mana kemah tempat kediaman orang-orang fasik?"
 },
 {
   "id": 13389,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 29,
   "firman": "Belum pernahkah kamu bertanya-tanya kepada orang-orang yang lewat di jalan? Dapatkah kamu menyangkal petunjuk-petunjuk mereka,"
 },
 {
   "id": 13390,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 30,
   "firman": "bahwa orang jahat terlindung pada hari kebinasaan, dan diselamatkan pada hari murka Allah?"
 },
 {
   "id": 13391,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 31,
   "firman": "Siapa yang akan langsung menggugat kelakuannya, dan mengganjar perbuatannya?"
 },
 {
   "id": 13392,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 32,
   "firman": "Dialah yang dibawa ke kuburan, dan jiratnya dirawat orang."
 },
 {
   "id": 13393,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 33,
   "firman": "Dengan nyaman ia ditutupi oleh gumpalan-gumpalan tanah di lembah; setiap orang mengikuti dia, dan yang mendahului dia tidak terbilang banyaknya."
 },
 {
   "id": 13394,
   "kitab": "Ayb",
   "pasal": 21,
   "ayat": 34,
   "firman": "Alangkah hampanya penghiburanmu bagiku! Semua jawabanmu hanyalah tipu daya belaka!\""
 },
 {
   "id": 13395,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 1,
   "firman": "Maka Elifas, orang Teman, menjawab:"
 },
 {
   "id": 13396,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 2,
   "firman": "\"Apakah manusia berguna bagi Allah? Tidak, orang yang berakal budi hanya berguna bagi dirinya sendiri."
 },
 {
   "id": 13397,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 3,
   "firman": "Apakah ada manfaatnya bagi Yang Mahakuasa, kalau engkau benar, atau keuntungannya, kalau engkau hidup saleh?"
 },
 {
   "id": 13398,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 4,
   "firman": "Apakah karena takutmu akan Allah, maka engkau dihukum-Nya, dan dibawa-Nya ke pengadilan?"
 },
 {
   "id": 13399,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 5,
   "firman": "Bukankah kejahatanmu besar dan kesalahanmu tidak berkesudahan?"
 },
 {
   "id": 13400,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 6,
   "firman": "Karena dengan sewenang-wenang engkau menerima gadai dari saudara-saudaramu dan merampas pakaian orang-orang yang melarat;"
 },
 {
   "id": 13401,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 7,
   "firman": "orang yang kehausan tidak kauberi minum air, dan orang yang kelaparan tidak kauberi makan,"
 },
 {
   "id": 13402,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 8,
   "firman": "tetapi orang yang kuat, dialah yang memiliki tanah, dan orang yang disegani, dialah yang mendudukinya."
 },
 {
   "id": 13403,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 9,
   "firman": "Janda-janda kausuruh pergi dengan tangan hampa, dan lengan yatim piatu kauremukkan."
 },
 {
   "id": 13404,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 10,
   "firman": "Itulah sebabnya engkau dikelilingi perangkap, dan dikejutkan oleh kedahsyatan dengan tiba-tiba."
 },
 {
   "id": 13405,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 11,
   "firman": "Terangmu menjadi gelap, sehingga engkau tidak dapat melihat dan banjir meliputi engkau."
 },
 {
   "id": 13406,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 12,
   "firman": "Bukankah Allah bersemayam di langit yang tinggi? Lihatlah bintang-bintang yang tertinggi, betapa tingginya!"
 },
 {
   "id": 13407,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 13,
   "firman": "Tetapi pikirmu: Tahu apa Allah? Dapatkah Ia mengadili dari balik awan-awan yang gelap?"
 },
 {
   "id": 13408,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 14,
   "firman": "Awan meliputi Dia, sehingga Ia tidak dapat melihat; Ia berjalan-jalan sepanjang lingkaran langit!"
 },
 {
   "id": 13409,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 15,
   "firman": "Apakah engkau mau tetap mengikuti jalan lama, yang dilalui orang-orang jahat,"
 },
 {
   "id": 13410,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 16,
   "firman": "mereka yang telah direnggut sebelum saatnya, yang alasnya dihanyutkan sungai;"
 },
 {
   "id": 13411,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 17,
   "firman": "mereka yang berkata kepada Allah: Pergilah dari pada kami! dan: Yang Mahakuasa dapat berbuat apa terhadap kami?"
 },
 {
   "id": 13412,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 18,
   "firman": "Namun Dialah juga yang memenuhi rumah mereka dengan segala yang baik--tetapi rancangan orang fasik adalah jauh dari padaku."
 },
 {
   "id": 13413,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 19,
   "firman": "Hal itu dilihat oleh orang benar dan mereka bersukaria; orang yang tidak bersalah mengolok-olok mereka:"
 },
 {
   "id": 13414,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 20,
   "firman": "Sungguh, lawan kami telah dilenyapkan, dan peninggalan mereka telah habis dimakan api."
 },
 {
   "id": 13415,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 21,
   "firman": "Berlakulah ramah terhadap Dia, supaya engkau tenteram; dengan demikian engkau memperoleh keuntungan."
 },
 {
   "id": 13416,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 22,
   "firman": "Terimalah apa yang diajarkan mulut-Nya, dan taruhlah firman-Nya dalam hatimu."
 },
 {
   "id": 13417,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 23,
   "firman": "Apabila engkau bertobat kepada Yang Mahakuasa, dan merendahkan diri; apabila engkau menjauhkan kecurangan dari dalam kemahmu,"
 },
 {
   "id": 13418,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 24,
   "firman": "membuang biji emas ke dalam debu, emas Ofir ke tengah batu-batu sungai,"
 },
 {
   "id": 13419,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 25,
   "firman": "dan apabila Yang Mahakuasa menjadi timbunan emasmu, dan kekayaan perakmu,"
 },
 {
   "id": 13420,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 26,
   "firman": "maka sungguh-sungguh engkau akan bersenang-senang karena Yang Mahakuasa, dan akan menengadah kepada Allah."
 },
 {
   "id": 13421,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 27,
   "firman": "Jikalau engkau berdoa kepada-Nya, Ia akan mengabulkan doamu, dan engkau akan membayar nazarmu."
 },
 {
   "id": 13422,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 28,
   "firman": "Apabila engkau memutuskan berbuat sesuatu, maka akan tercapai maksudmu, dan cahaya terang menyinari jalan-jalanmu."
 },
 {
   "id": 13423,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 29,
   "firman": "Karena Allah merendahkan orang yang angkuh tetapi menyelamatkan orang yang menundukkan kepala!"
 },
 {
   "id": 13424,
   "kitab": "Ayb",
   "pasal": 22,
   "ayat": 30,
   "firman": "Orang yang tidak bersalah diluputkan-Nya: engkau luput karena kebersihan tanganmu.\""
 },
 {
   "id": 13425,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13426,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 2,
   "firman": "\"Sekarang ini keluh kesahku menjadi pemberontakan, tangan-Nya menekan aku, sehingga aku mengaduh."
 },
 {
   "id": 13427,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 3,
   "firman": "Ah, semoga aku tahu mendapatkan Dia, dan boleh datang ke tempat Ia bersemayam."
 },
 {
   "id": 13428,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 4,
   "firman": "Maka akan kupaparkan perkaraku di hadapan-Nya, dan kupenuhi mulutku dengan kata-kata pembelaan."
 },
 {
   "id": 13429,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 5,
   "firman": "Maka aku akan mengetahui jawaban-jawaban yang diberikan-Nya kepadaku dan aku akan mengerti, apa yang difirmankan-Nya kepadaku."
 },
 {
   "id": 13430,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 6,
   "firman": "Sudikah Ia mengadakan perkara dengan aku dalam kemahakuasaan-Nya? Tidak, Ia akan menaruh perhatian kepadaku."
 },
 {
   "id": 13431,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 7,
   "firman": "Orang jujurlah yang akan membela diri di hadapan-Nya, dan aku akan bebas dari Hakimku untuk selama-lamanya."
 },
 {
   "id": 13432,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 8,
   "firman": "Sesungguhnya, kalau aku berjalan ke timur, Ia tidak di sana; atau ke barat, tidak kudapati Dia;"
 },
 {
   "id": 13433,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 9,
   "firman": "di utara kucari Dia, Ia tidak tampak, aku berpaling ke selatan, aku tidak melihat Dia."
 },
 {
   "id": 13434,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 10,
   "firman": "Karena Ia tahu jalan hidupku; seandainya Ia menguji aku, aku akan timbul seperti emas."
 },
 {
   "id": 13435,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 11,
   "firman": "Kakiku tetap mengikuti jejak-Nya, aku menuruti jalan-Nya dan tidak menyimpang."
 },
 {
   "id": 13436,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 12,
   "firman": "Perintah dari bibir-Nya tidak kulanggar, dalam sanubariku kusimpan ucapan mulut-Nya."
 },
 {
   "id": 13437,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 13,
   "firman": "Tetapi Ia tidak pernah berubah--siapa dapat menghalangi Dia? Apa yang dikehendaki-Nya, dilaksanakan-Nya juga."
 },
 {
   "id": 13438,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 14,
   "firman": "Karena Ia akan menyelesaikan apa yang ditetapkan atasku, dan banyak lagi hal yang serupa itu dimaksudkan-Nya."
 },
 {
   "id": 13439,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 15,
   "firman": "Itulah sebabnya hatiku gemetar menghadapi Dia, kalau semuanya itu kubayangkan, maka aku ketakutan terhadap Dia."
 },
 {
   "id": 13440,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 16,
   "firman": "Allah telah membuat aku putus asa, Yang Mahakuasa telah membuat hatiku gemetar;"
 },
 {
   "id": 13441,
   "kitab": "Ayb",
   "pasal": 23,
   "ayat": 17,
   "firman": "sebab bukan karena kegelapan aku binasa, dan bukan juga karena mukaku ditutupi gelap gulita.\""
 },
 {
   "id": 13442,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 1,
   "firman": "\"Mengapa Yang Mahakuasa tidak mencadangkan masa penghukuman dan mereka yang mengenal Dia tidak melihat hari pengadilan-Nya?"
 },
 {
   "id": 13443,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 2,
   "firman": "Ada orang yang menggeser batas tanah, yang merampas kawanan ternak, lalu menggembalakannya."
 },
 {
   "id": 13444,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 3,
   "firman": "Keledai kepunyaan yatim piatu dilarikannya, dan lembu betina kepunyaan seorang janda diterimanya sebagai gadai,"
 },
 {
   "id": 13445,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 4,
   "firman": "orang miskin didorongnya dari jalan, orang sengsara di dalam negeri terpaksa bersembunyi semuanya."
 },
 {
   "id": 13446,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 5,
   "firman": "Sesungguhnya, seperti keledai liar di padang gurun mereka keluar untuk bekerja mencari apa-apa di padang belantara sebagai makanan bagi anak-anak mereka."
 },
 {
   "id": 13447,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 6,
   "firman": "Di ladang mereka mengambil makanan hewan, dan kebun anggur, milik orang fasik, dipetiki buahnya yang ketinggalan."
 },
 {
   "id": 13448,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 7,
   "firman": "Dengan telanjang mereka bermalam, karena tidak ada pakaian, dan mereka tidak mempunyai selimut pada waktu dingin;"
 },
 {
   "id": 13449,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 8,
   "firman": "oleh hujan lebat di pegunungan mereka basah kuyup, dan karena tidak ada tempat berlindung, mereka mengimpitkan badannya pada gunung batu."
 },
 {
   "id": 13450,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 9,
   "firman": "Ada yang merebut anak piatu dari susu ibunya dan menerima bayi orang miskin sebagai gadai."
 },
 {
   "id": 13451,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 10,
   "firman": "Dengan telanjang mereka berkeliaran, karena tidak ada pakaian, dan dengan kelaparan mereka memikul berkas-berkas gandum;"
 },
 {
   "id": 13452,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 11,
   "firman": "di antara dua petak kebun mereka membuat minyak, mereka menginjak-injak tempat pengirikan sambil kehausan."
 },
 {
   "id": 13453,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 12,
   "firman": "Dari dalam kota terdengar rintihan orang-orang yang hampir mati dan jeritan orang-orang yang menderita luka, tetapi Allah tidak mengindahkan doa mereka."
 },
 {
   "id": 13454,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 13,
   "firman": "Ada lagi golongan yang memusuhi terang, yang tidak mengenal jalannya dan tidak tetap tinggal pada lintasannya."
 },
 {
   "id": 13455,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 14,
   "firman": "Pada parak siang bersiaplah si pembunuh, orang sengsara dan miskin dibunuhnya, dan waktu malam ia berlaku seperti pencuri."
 },
 {
   "id": 13456,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 15,
   "firman": "Orang yang berzinah menunggu senja, pikirnya: Jangan seorangpun melihat aku; lalu dikenakannya tudung muka."
 },
 {
   "id": 13457,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 16,
   "firman": "Di dalam gelap mereka membongkar rumah, pada siang hari mereka bersembunyi; mereka tidak kenal terang,"
 },
 {
   "id": 13458,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 17,
   "firman": "karena kegelapan adalah pagi hari bagi mereka sekalian, dan mereka sudah biasa dengan kedahsyatan kegelapan."
 },
 {
   "id": 13459,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 18,
   "firman": "Mereka hanyut di permukaan air, bagian mereka terkutuk di bumi; mereka tidak lagi pergi ke kebun anggur mereka."
 },
 {
   "id": 13460,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 19,
   "firman": "Air salju dihabiskan oleh kemarau dan panas, demikian juga dilakukan dunia orang mati terhadap mereka yang berbuat dosa."
 },
 {
   "id": 13461,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 20,
   "firman": "Rahim ibu melupakan dia, berenga mengerumitnya, ia tidak diingat lagi: kecurangan dipatahkan seperti pohon kayu."
 },
 {
   "id": 13462,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 21,
   "firman": "Ia menjarahi perempuan mandul, yang tidak beranak, dan tidak berbuat baik terhadap seorang janda,"
 },
 {
   "id": 13463,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 22,
   "firman": "bahkan menyeret orang-orang perkasa dengan kekuatannya; ia bangun kembali, tetapi hidupnya tidak terjamin."
 },
 {
   "id": 13464,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 23,
   "firman": "Allah memberinya keamanan yang menjadi sandarannya, dan mengawasi jalan-jalannya."
 },
 {
   "id": 13465,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 24,
   "firman": "Hanya sebentar mereka meninggikan diri, lalu tidak ada lagi; mereka luruh, lalu menjadi lisut seperti segala sesuatu, mereka dikerat seperti hulu tangkai gandum."
 },
 {
   "id": 13466,
   "kitab": "Ayb",
   "pasal": 24,
   "ayat": 25,
   "firman": "Jikalau tidak demikian halnya, siapa berani menyanggah aku dan meniadakan perkataanku?\""
 },
 {
   "id": 13467,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 1,
   "firman": "Maka Bildad, orang Suah, menjawab:"
 },
 {
   "id": 13468,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 2,
   "firman": "\"Kekuasaan dan kedahsyatan ada pada Dia, yang menyelenggarakan damai di tempat-Nya yang tinggi."
 },
 {
   "id": 13469,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 3,
   "firman": "Dapatkah dihitung pasukan-Nya? Dan siapakah yang tidak disinari terang-Nya?"
 },
 {
   "id": 13470,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 4,
   "firman": "Bagaimana manusia benar di hadapan Allah, dan bagaimana orang yang dilahirkan perempuan itu bersih?"
 },
 {
   "id": 13471,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 5,
   "firman": "Sesungguhnya, bahkan bulanpun tidak terang dan bintang-bintangpun tidak cerah di mata-Nya."
 },
 {
   "id": 13472,
   "kitab": "Ayb",
   "pasal": 25,
   "ayat": 6,
   "firman": "Lebih-lebih lagi manusia, yang adalah berenga, anak manusia, yang adalah ulat!\""
 },
 {
   "id": 13473,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 1,
   "firman": "Tetapi Ayub menjawab:"
 },
 {
   "id": 13474,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 2,
   "firman": "\"Alangkah baiknya bantuanmu kepada yang tidak kuat, dan pertolonganmu kepada lengan yang tidak berdaya!"
 },
 {
   "id": 13475,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 3,
   "firman": "Alangkah baiknya nasihatmu kepada orang yang tidak mempunyai hikmat, dan pengertian yang kauajarkan dengan limpahnya!"
 },
 {
   "id": 13476,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 4,
   "firman": "Atas anjuran siapakah engkau mengucapkan perkataan-perkataan itu, dan gagasan siapakah yang kaunyatakan?"
 },
 {
   "id": 13477,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 5,
   "firman": "Roh-roh di bawah menggeletar, demikian juga air dan penghuninya."
 },
 {
   "id": 13478,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 6,
   "firman": "Dunia orang mati terbuka di hadapan Allah, tempat kebinasaanpun tidak ada tutupnya."
 },
 {
   "id": 13479,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 7,
   "firman": "Allah membentangkan utara di atas kekosongan, dan menggantungkan bumi pada kehampaan."
 },
 {
   "id": 13480,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 8,
   "firman": "Ia membungkus air di dalam awan-Nya, namun awan itu tidak robek."
 },
 {
   "id": 13481,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 9,
   "firman": "Ia menutupi pemandangan takhta-Nya, melingkupinya dengan awan-Nya."
 },
 {
   "id": 13482,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 10,
   "firman": "Ia telah menarik garis pada permukaan air, sampai ujung perbatasan antara terang dan gelap;"
 },
 {
   "id": 13483,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 11,
   "firman": "tiang-tiang langit bergoyang-goyang, tercengang-cengang oleh hardik-Nya."
 },
 {
   "id": 13484,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 12,
   "firman": "Ia telah meneduhkan laut dengan kuasa-Nya dan meremukkan Rahab dengan kebijaksanaan-Nya."
 },
 {
   "id": 13485,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 13,
   "firman": "Oleh nafas-Nya langit menjadi cerah, tangan-Nya menembus ular yang tangkas."
 },
 {
   "id": 13486,
   "kitab": "Ayb",
   "pasal": 26,
   "ayat": 14,
   "firman": "Sesungguhnya, semuanya itu hanya ujung-ujung jalan-Nya; betapa lembutnya bisikan yang kita dengar dari pada-Nya! Siapa dapat memahami guntur kuasa-Nya?\""
 },
 {
   "id": 13487,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 1,
   "firman": "Maka Ayub melanjutkan uraiannya:"
 },
 {
   "id": 13488,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 2,
   "firman": "\"Demi Allah yang hidup, yang tidak memberi keadilan kepadaku, dan demi Yang Mahakuasa, yang memedihkan hatiku,"
 },
 {
   "id": 13489,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 3,
   "firman": "selama nafasku masih ada padaku, dan roh Allah masih di dalam lubang hidungku,"
 },
 {
   "id": 13490,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 4,
   "firman": "maka bibirku sungguh-sungguh tidak akan mengucapkan kecurangan, dan lidahku tidak akan melahirkan tipu daya."
 },
 {
   "id": 13491,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 5,
   "firman": "Aku sama sekali tidak membenarkan kamu! Sampai binasa aku tetap mempertahankan bahwa aku tidak bersalah."
 },
 {
   "id": 13492,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 6,
   "firman": "Kebenaranku kupegang teguh dan tidak kulepaskan; hatiku tidak mencela seharipun dari pada umurku."
 },
 {
   "id": 13493,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 7,
   "firman": "Biarlah musuhku mengalami seperti orang fasik, dan orang yang melawan aku seperti orang yang curang."
 },
 {
   "id": 13494,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 8,
   "firman": "Karena apakah harapan orang durhaka, kalau Allah menghabisinya, kalau Ia menuntut nyawanya?"
 },
 {
   "id": 13495,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 9,
   "firman": "Apakah Allah akan mendengar teriaknya, jika kesesakan menimpa dia?"
 },
 {
   "id": 13496,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 10,
   "firman": "Dapatkah ia bersenang-senang karena Yang Mahakuasa dan berseru kepada Allah setiap waktu?"
 },
 {
   "id": 13497,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 11,
   "firman": "Aku akan mengajari kamu tentang tangan Allah, apa yang dimaksudkan oleh Yang Mahakuasa tidak akan kusembunyikan."
 },
 {
   "id": 13498,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 12,
   "firman": "Sesungguhnya, kamu sekalian telah melihatnya sendiri; mengapa kamu berpikir yang tidak-tidak?"
 },
 {
   "id": 13499,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 13,
   "firman": "Inilah bagian orang fasik yang ditentukan Allah, dan milik pusaka orang-orang lalim yang mereka terima dari Yang Mahakuasa:"
 },
 {
   "id": 13500,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 14,
   "firman": "kalau anak-anaknya bertambah banyak mereka menjadi makanan pedang, dan anak cucunya tidak mendapat cukup makan;"
 },
 {
   "id": 13501,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 15,
   "firman": "siapa yang luput dari padanya, akan turun ke kubur karena wabah, dengan tidak ditangisi oleh janda mereka."
 },
 {
   "id": 13502,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 16,
   "firman": "Jikalau ia menimbun uang seperti debu banyaknya, dan menumpuk pakaian seperti tanah liat,"
 },
 {
   "id": 13503,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 17,
   "firman": "sekalipun ia yang menumpuknya, namun orang benar yang akan memakainya, dan orang yang tidak bersalah yang akan membagi-bagi uang itu."
 },
 {
   "id": 13504,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 18,
   "firman": "Ia mendirikan rumahnya seperti sarang laba-laba, seperti gubuk yang dibuat penjaga."
 },
 {
   "id": 13505,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 19,
   "firman": "Sebagai orang kaya ia membaringkan diri, tetapi tidak dapat ia mengulanginya: ketika ia membuka matanya, maka tidak ada lagi semuanya itu."
 },
 {
   "id": 13506,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 20,
   "firman": "Kedahsyatan mengejar dia seperti air bah, pada malam hari ia diterbangkan badai;"
 },
 {
   "id": 13507,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 21,
   "firman": "angin timur mengangkatnya, lalu lenyaplah ia; ia dilemparkannya dari tempatnya."
 },
 {
   "id": 13508,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 22,
   "firman": "Dengan tak kenal belas kasihan Allah melempari dia, dengan cepat ia harus melepaskan diri dari kuasa-Nya."
 },
 {
   "id": 13509,
   "kitab": "Ayb",
   "pasal": 27,
   "ayat": 23,
   "firman": "Oleh karena dia orang bertepuk tangan, dan bersuit-suit karena dia dari tempat kediamannya.\""
 },
 {
   "id": 13510,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 1,
   "firman": "\"Memang ada tempat orang menambang perak dan tempat orang melimbang emas;"
 },
 {
   "id": 13511,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 2,
   "firman": "besi digali dari dalam tanah, dan dari batu dilelehkan tembaga."
 },
 {
   "id": 13512,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 3,
   "firman": "Orang menyudahi kegelapan, dan batu diselidikinya sampai sedalam-dalamnya, di dalam kekelaman dan kelam pekat."
 },
 {
   "id": 13513,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 4,
   "firman": "Orang menggali tambang jauh dari tempat kediaman manusia, mereka dilupakan oleh orang-orang yang berjalan di atas, mereka melayang-layang jauh dari manusia."
 },
 {
   "id": 13514,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 5,
   "firman": "Tanah yang menghasilkan pangan, dibawahnya dibongkar-bangkir seperti oleh api."
 },
 {
   "id": 13515,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 6,
   "firman": "Batunya adalah tempat menemukan lazurit yang mengandung emas urai."
 },
 {
   "id": 13516,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 7,
   "firman": "Jalan ke sana tidak dikenal seekor burung buaspun, dan mata elang tidak melihatnya;"
 },
 {
   "id": 13517,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 8,
   "firman": "binatang yang ganas tidak menginjakkan kakinya di sana dan singa tidak melangkah melaluinya."
 },
 {
   "id": 13518,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 9,
   "firman": "Manusia melekatkan tangannya pada batu yang keras, ia membongkar-bangkir gunung-gunung sampai pada akar-akarnya;"
 },
 {
   "id": 13519,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 10,
   "firman": "di dalam gunung batu ia menggali terowongan, dan matanya melihat segala sesuatu yang berharga;"
 },
 {
   "id": 13520,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 11,
   "firman": "air sungai yang merembes dibendungnya, dan apa yang tersembunyi dibawanya ke tempat terang."
 },
 {
   "id": 13521,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 12,
   "firman": "Tetapi di mana hikmat dapat diperoleh, di mana tempat akal budi?"
 },
 {
   "id": 13522,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 13,
   "firman": "Jalan ke sana tidak diketahui manusia, dan tidak didapati di negeri orang hidup."
 },
 {
   "id": 13523,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 14,
   "firman": "Kata samudera raya: Ia tidak terdapat di dalamku, dan kata laut: Ia tidak ada padaku."
 },
 {
   "id": 13524,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 15,
   "firman": "Untuk gantinya tidak dapat diberikan emas murni, dan harganya tidak dapat ditimbang dengan perak."
 },
 {
   "id": 13525,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 16,
   "firman": "Ia tidak dapat dinilai dengan emas Ofir, ataupun dengan permata krisopras yang mahal atau dengan permata lazurit;"
 },
 {
   "id": 13526,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 17,
   "firman": "tidak dapat diimbangi oleh emas, atau kaca, ataupun ditukar dengan permata dari emas tua."
 },
 {
   "id": 13527,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 18,
   "firman": "Baik gewang, baik hablur, tidak terhitung lagi; memiliki hikmat adalah lebih baik dari pada mutiara."
 },
 {
   "id": 13528,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 19,
   "firman": "Permata krisolit Etiopia tidak dapat mengimbanginya, ia tidak dapat dinilai dengan emas murni."
 },
 {
   "id": 13529,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 20,
   "firman": "Hikmat itu, dari manakah datangnya, atau akal budi, di manakah tempatnya?"
 },
 {
   "id": 13530,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 21,
   "firman": "Ia terlindung dari mata segala yang hidup, bahkan tersembunyi bagi burung di udara."
 },
 {
   "id": 13531,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 22,
   "firman": "Kebinasaan dan maut berkata: Hanya desas-desusnya yang sampai ke telinga kami."
 },
 {
   "id": 13532,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 23,
   "firman": "Allah mengetahui jalan ke sana, Ia juga mengenal tempat kediamannya."
 },
 {
   "id": 13533,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 24,
   "firman": "Karena Ia memandang sampai ke ujung-ujung bumi, dan melihat segala sesuatu yang ada di kolong langit."
 },
 {
   "id": 13534,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 25,
   "firman": "Ketika Ia menetapkan kekuatan angin, dan mengatur banyaknya air,"
 },
 {
   "id": 13535,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 26,
   "firman": "ketika Ia membuat ketetapan bagi hujan, dan jalan bagi kilat guruh,"
 },
 {
   "id": 13536,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 27,
   "firman": "ketika itulah Ia melihat hikmat, lalu memberitakannya, menetapkannya, bahkan menyelidikinya;"
 },
 {
   "id": 13537,
   "kitab": "Ayb",
   "pasal": 28,
   "ayat": 28,
   "firman": "tetapi kepada manusia Ia berfirman: Sesungguhnya, takut akan Tuhan, itulah hikmat, dan menjauhi kejahatan itulah akal budi.\""
 },
 {
   "id": 13538,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 1,
   "firman": "Maka Ayub melanjutkan uraiannya:"
 },
 {
   "id": 13539,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 2,
   "firman": "\"Ah, kiranya aku seperti dalam bulan-bulan yang silam, seperti pada hari-hari, ketika Allah melindungi aku,"
 },
 {
   "id": 13540,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 3,
   "firman": "ketika pelita-Nya bersinar di atas kepalaku, dan di bawah terang-Nya aku berjalan dalam gelap;"
 },
 {
   "id": 13541,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 4,
   "firman": "seperti ketika aku mengalami masa remajaku, ketika Allah bergaul karib dengan aku di dalam kemahku;"
 },
 {
   "id": 13542,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 5,
   "firman": "ketika Yang Mahakuasa masih beserta aku, dan anak-anakku ada di sekelilingku;"
 },
 {
   "id": 13543,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 6,
   "firman": "ketika langkah-langkahku bermandikan dadih, dan gunung batu mengalirkan sungai minyak di dekatku."
 },
 {
   "id": 13544,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 7,
   "firman": "Apabila aku keluar ke pintu gerbang kota, dan menyediakan tempat dudukku di tengah-tengah lapangan,"
 },
 {
   "id": 13545,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 8,
   "firman": "maka ketika aku kelihatan, mundurlah orang-orang muda dan bangkitlah orang-orang yang sudah lanjut umurnya, lalu tinggal berdiri;"
 },
 {
   "id": 13546,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 9,
   "firman": "para pembesar berhenti bicara, dan menutup mulut mereka dengan tangan;"
 },
 {
   "id": 13547,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 10,
   "firman": "suara para pemuka membisu, dan lidah mereka melekat pada langit-langitnya;"
 },
 {
   "id": 13548,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 11,
   "firman": "apabila telinga mendengar tentang aku, maka aku disebut berbahagia; dan apabila mata melihat, maka aku dipuji."
 },
 {
   "id": 13549,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 12,
   "firman": "Karena aku menyelamatkan orang sengsara yang berteriak minta tolong, juga anak piatu yang tidak ada penolongnya;"
 },
 {
   "id": 13550,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 13,
   "firman": "aku mendapat ucapan berkat dari orang yang nyaris binasa, dan hati seorang janda kubuat bersukaria;"
 },
 {
   "id": 13551,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 14,
   "firman": "aku berpakaian kebenaran dan keadilan menutupi aku seperti jubah dan serban;"
 },
 {
   "id": 13552,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 15,
   "firman": "aku menjadi mata bagi orang buta, dan kaki bagi orang lumpuh;"
 },
 {
   "id": 13553,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 16,
   "firman": "aku menjadi bapa bagi orang miskin, dan perkara orang yang tidak kukenal, kuselidiki."
 },
 {
   "id": 13554,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 17,
   "firman": "Geraham orang curang kuremuk, dan merebut mangsanya dari giginya."
 },
 {
   "id": 13555,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 18,
   "firman": "Pikirku: Bersama-sama dengan sarangku aku akan binasa, dan memperbanyak hari-hariku seperti burung feniks."
 },
 {
   "id": 13556,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 19,
   "firman": "Akarku mencapai air, dan embun bermalam di atas ranting-rantingku."
 },
 {
   "id": 13557,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 20,
   "firman": "Kemuliaanku selalu baru padaku, dan busurku kuat kembali di tanganku."
 },
 {
   "id": 13558,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 21,
   "firman": "Kepadakulah orang mendengar sambil menanti, dengan diam mereka mendengarkan nasihatku."
 },
 {
   "id": 13559,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 22,
   "firman": "Sehabis bicaraku tiada seorangpun angkat bicara lagi, dan perkataanku menetes ke atas mereka."
 },
 {
   "id": 13560,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 23,
   "firman": "Orang menantikan aku seperti menantikan hujan, dan menadahkan mulutnya seperti menadah hujan pada akhir musim."
 },
 {
   "id": 13561,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 24,
   "firman": "Aku tersenyum kepada mereka, ketika mereka putus asa, dan seri mukaku tidak dapat disuramkan mereka."
 },
 {
   "id": 13562,
   "kitab": "Ayb",
   "pasal": 29,
   "ayat": 25,
   "firman": "Aku menentukan jalan mereka dan duduk sebagai pemimpin; aku bersemayam seperti raja di tengah-tengah rakyat, seperti seorang yang menghibur mereka yang berkabung.\""
 },
 {
   "id": 13563,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 1,
   "firman": "\"Tetapi sekarang aku ditertawakan mereka, yang umurnya lebih muda dari padaku, yang ayah-ayahnya kupandang terlalu hina untuk ditempatkan bersama-sama dengan anjing penjaga kambing dombaku."
 },
 {
   "id": 13564,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 2,
   "firman": "Lagipula, apakah gunanya bagiku kekuatan tangan mereka? Mereka sudah kehabisan tenaga,"
 },
 {
   "id": 13565,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 3,
   "firman": "mereka merana karena kekurangan dan kelaparan, mengerumit tanah yang kering, belukar di gurun dan padang belantara;"
 },
 {
   "id": 13566,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 4,
   "firman": "mereka memetik gelang laut dari antara semak-semak, dan akar pohon arar menjadi makanan mereka."
 },
 {
   "id": 13567,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 5,
   "firman": "Mereka diusir dari pergaulan hidup, dan orang berteriak-teriak terhadap mereka seperti terhadap pencuri."
 },
 {
   "id": 13568,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 6,
   "firman": "Di lembah-lembah yang mengerikan mereka harus diam, di dalam celah-celah tanah dan sela-sela gunung;"
 },
 {
   "id": 13569,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 7,
   "firman": "di antara semak-semak mereka meraung-raung, mereka berkelompok di bawah jeruju;"
 },
 {
   "id": 13570,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 8,
   "firman": "mereka itulah orang-orang bebal yang tak dikenal, yang didepak dari negeri."
 },
 {
   "id": 13571,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 9,
   "firman": "Tetapi sekarang aku menjadi sajak sindiran dan ejekan mereka."
 },
 {
   "id": 13572,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 10,
   "firman": "Mereka mengejikan aku, menjauhkan diri dari padaku, mereka tidak menahan diri meludahi mukaku,"
 },
 {
   "id": 13573,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 11,
   "firman": "karena tali kemahku telah dilepaskan Allah dan aku direndahkan-Nya, dan mereka tidak mengekang diri terhadap aku."
 },
 {
   "id": 13574,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 12,
   "firman": "Di sebelah kananku muncul gerombolan, dikaitnya kakiku, dan dirintisnya jalan kebinasaan terhadap aku;"
 },
 {
   "id": 13575,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 13,
   "firman": "mereka membongkar jalanku dan mengusahakan kejatuhanku; tidak ada yang menghalang-halangi mereka."
 },
 {
   "id": 13576,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 14,
   "firman": "Seperti melalui tembok yang terbelah lebar mereka menyerbu, mereka datang bergelombang di tengah-tengah keruntuhan."
 },
 {
   "id": 13577,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 15,
   "firman": "Kedahsyatan ditimpakan kepadaku; kemuliaanku diterbangkan seperti oleh angin, dan bahagiaku melayang hilang seperti awan."
 },
 {
   "id": 13578,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 16,
   "firman": "Oleh sebab itu jiwaku hancur dalam diriku; hari-hari kesengsaraan mencekam aku."
 },
 {
   "id": 13579,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 17,
   "firman": "Pada waktu malam tulang-tulangku seperti digerogoti, dan rasa nyeri yang menusuk tak kunjung berhenti."
 },
 {
   "id": 13580,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 18,
   "firman": "Oleh kekerasan yang tak terlawan koyaklah pakaianku dan menggelambir sekelilingku seperti kemeja."
 },
 {
   "id": 13581,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 19,
   "firman": "Ia telah menghempaskan aku ke dalam lumpur, dan aku sudah menyerupai debu dan abu."
 },
 {
   "id": 13582,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 20,
   "firman": "Aku berseru minta tolong kepada-Mu, tetapi Engkau tidak menjawab; aku berdiri menanti, tetapi Engkau tidak menghiraukan aku."
 },
 {
   "id": 13583,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 21,
   "firman": "Engkau menjadi kejam terhadap aku, Engkau memusuhi aku dengan kekuatan tangan-Mu."
 },
 {
   "id": 13584,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 22,
   "firman": "Engkau mengangkat aku ke atas angin, melayangkan aku dan menghancurkan aku di dalam angin ribut."
 },
 {
   "id": 13585,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 23,
   "firman": "Ya, aku tahu: Engkau membawa aku kepada maut, ke tempat segala yang hidup dihimpunkan."
 },
 {
   "id": 13586,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 24,
   "firman": "Sesungguhnya, masakan orang tidak akan mengulurkan tangannya kepada yang rebah, jikalau ia dalam kecelakaannya tidak ada penolongnya?"
 },
 {
   "id": 13587,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 25,
   "firman": "Bukankah aku menangis karena orang yang mengalami hari kesukaran? Bukankah susah hatiku karena orang miskin?"
 },
 {
   "id": 13588,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 26,
   "firman": "Tetapi, ketika aku mengharapkan yang baik, maka kejahatanlah yang datang; ketika aku menantikan terang, maka kegelapanlah yang datang."
 },
 {
   "id": 13589,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 27,
   "firman": "Batinku bergelora dan tak kunjung diam, hari-hari kesengsaraan telah melanda diriku."
 },
 {
   "id": 13590,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 28,
   "firman": "Dengan sedih, dengan tidak terhibur, aku berkeliaran; aku berdiri di tengah-tengah jemaah sambil berteriak minta tolong."
 },
 {
   "id": 13591,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 29,
   "firman": "Aku telah menjadi saudara bagi serigala, dan kawan bagi burung unta."
 },
 {
   "id": 13592,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 30,
   "firman": "Kulitku menjadi hitam dan mengelupas dari tubuhku, tulang-tulangku mengering karena demam;"
 },
 {
   "id": 13593,
   "kitab": "Ayb",
   "pasal": 30,
   "ayat": 31,
   "firman": "permainan kecapiku menjadi ratapan, dan tiupan serulingku menyerupai suara orang menangis.\""
 },
 {
   "id": 13594,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 1,
   "firman": "\"Aku telah menetapkan syarat bagi mataku, masakan aku memperhatikan anak dara?"
 },
 {
   "id": 13595,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 2,
   "firman": "Karena bagian apakah yang ditentukan Allah dari atas, milik pusaka apakah yang ditetapkan Yang Mahakuasa dari tempat yang tinggi?"
 },
 {
   "id": 13596,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 3,
   "firman": "Bukankah kebinasaan bagi orang yang curang dan kemalangan bagi yang melakukan kejahatan?"
 },
 {
   "id": 13597,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 4,
   "firman": "Bukankah Allah yang mengamat-amati jalanku dan menghitung segala langkahku?"
 },
 {
   "id": 13598,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 5,
   "firman": "Jikalau aku bergaul dengan dusta, atau kakiku cepat melangkah ke tipu daya,"
 },
 {
   "id": 13599,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 6,
   "firman": "biarlah aku ditimbang di atas neraca yang teliti, maka Allah akan mengetahui, bahwa aku tidak bersalah."
 },
 {
   "id": 13600,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 7,
   "firman": "Jikalau langkahku menyimpang dari jalan, dan hatiku menuruti pandangan mataku, dan noda melekat pada tanganku,"
 },
 {
   "id": 13601,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 8,
   "firman": "maka biarlah apa yang kutabur, dimakan orang lain, dan biarlah tercabut apa yang tumbuh bagiku."
 },
 {
   "id": 13602,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 9,
   "firman": "Jikalau hatiku tertarik kepada perempuan, dan aku menghadang di pintu sesamaku,"
 },
 {
   "id": 13603,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 10,
   "firman": "maka biarlah isteriku menggiling bagi orang lain, dan biarlah orang-orang lain meniduri dia."
 },
 {
   "id": 13604,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 11,
   "firman": "Karena hal itu adalah perbuatan mesum, bahkan kejahatan, yang patut dihukum oleh hakim."
 },
 {
   "id": 13605,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 12,
   "firman": "Sesungguhnya, itulah api yang memakan habis, dan menghanguskan seluruh hasilku."
 },
 {
   "id": 13606,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 13,
   "firman": "Jikalau aku mengabaikan hak budakku laki-laki atau perempuan, ketika mereka beperkara dengan aku,"
 },
 {
   "id": 13607,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 14,
   "firman": "apakah dayaku, kalau Allah bangkit berdiri; kalau Ia mengadakan pengusutan, apakah jawabku kepada-Nya?"
 },
 {
   "id": 13608,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 15,
   "firman": "Bukankah Ia, yang membuat aku dalam kandungan, membuat orang itu juga? Bukankah satu juga yang membentuk kami dalam rahim?"
 },
 {
   "id": 13609,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 16,
   "firman": "Jikalau aku pernah menolak keinginan orang-orang kecil, menyebabkan mata seorang janda menjadi pudar,"
 },
 {
   "id": 13610,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 17,
   "firman": "atau memakan makananku seorang diri, sedang anak yatim tidak turut memakannya"
 },
 {
   "id": 13611,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 18,
   "firman": "--malah sejak mudanya aku membesarkan dia seperti seorang ayah, dan sejak kandungan ibunya aku membimbing dia--;"
 },
 {
   "id": 13612,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 19,
   "firman": "jikalau aku melihat orang mati karena tidak ada pakaian, atau orang miskin yang tidak mempunyai selimut,"
 },
 {
   "id": 13613,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 20,
   "firman": "dan pinggangnya tidak meminta berkat bagiku, dan tidak dipanaskannya tubuhnya dengan kulit bulu dombaku;"
 },
 {
   "id": 13614,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 21,
   "firman": "jikalau aku mengangkat tanganku melawan anak yatim, karena di pintu gerbang aku melihat ada yang membantu aku,"
 },
 {
   "id": 13615,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 22,
   "firman": "maka biarlah tulang belikatku lepas dari bahuku, dan lenganku dipatahkan dari persendiannya."
 },
 {
   "id": 13616,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 23,
   "firman": "Karena celaka yang dari pada Allah menakutkan aku, dan aku tidak berdaya terhadap keluhuran-Nya."
 },
 {
   "id": 13617,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 24,
   "firman": "Jikalau aku menaruh kepercayaan kepada emas, dan berkata kepada kencana: Engkaulah kepercayaanku;"
 },
 {
   "id": 13618,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 25,
   "firman": "jikalau aku bersukacita, karena kekayaanku besar dan karena tanganku memperoleh harta benda yang berlimpah-limpah;"
 },
 {
   "id": 13619,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 26,
   "firman": "jikalau aku pernah memandang matahari, ketika ia bersinar, dan bulan, yang beredar dengan indahnya,"
 },
 {
   "id": 13620,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 27,
   "firman": "sehingga diam-diam hatiku terpikat, dan menyampaikan kecupan tangan kepadanya,"
 },
 {
   "id": 13621,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 28,
   "firman": "maka hal itu juga menjadi kejahatan yang patut dihukum oleh hakim, karena Allah yang di atas telah kuingkari."
 },
 {
   "id": 13622,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 29,
   "firman": "Apakah aku bersukacita karena kecelakaan pembenciku, dan bersorak-sorai, bila ia ditimpa malapetaka"
 },
 {
   "id": 13623,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 30,
   "firman": "--aku takkan membiarkan mulutku berbuat dosa, menuntut nyawanya dengan mengucapkan sumpah serapah! --"
 },
 {
   "id": 13624,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 31,
   "firman": "Jikalau orang-orang di kemahku mengatakan: Siapa yang tidak kenyang dengan lauknya?"
 },
 {
   "id": 13625,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 32,
   "firman": "--malah orang asingpun tidak pernah bermalam di luar, pintuku kubuka bagi musafir! --"
 },
 {
   "id": 13626,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 33,
   "firman": "Jikalau aku menutupi pelanggaranku seperti manusia dengan menyembunyikan kesalahanku dalam hatiku,"
 },
 {
   "id": 13627,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 34,
   "firman": "karena aku takuti khalayak ramai dan penghinaan kaum keluarga mengagetkan aku, sehingga aku berdiam diri dan tidak keluar dari pintu!"
 },
 {
   "id": 13628,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 35,
   "firman": "Ah, sekiranya ada yang mendengarkan aku! --Inilah tanda tanganku! Hendaklah Yang Mahakuasa menjawab aku! --Sekiranya ada surat tuduhan yang ditulis lawanku!"
 },
 {
   "id": 13629,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 36,
   "firman": "Sungguh, surat itu akan kupikul, dan akan kupakai bagaikan mahkota."
 },
 {
   "id": 13630,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 37,
   "firman": "Setiap langkahku akan kuberitahukan kepada-Nya, selaku pemuka aku akan menghadap Dia."
 },
 {
   "id": 13631,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 38,
   "firman": "Jikalau ladangku berteriak karena aku dan alur bajaknya menangis bersama-sama,"
 },
 {
   "id": 13632,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 39,
   "firman": "jikalau aku memakan habis hasilnya dengan tidak membayar, dan menyusahkan pemilik-pemiliknya,"
 },
 {
   "id": 13633,
   "kitab": "Ayb",
   "pasal": 31,
   "ayat": 40,
   "firman": "maka biarlah bukan gandum yang tumbuh, tetapi onak, dan bukan jelai, tetapi lalang.\" Sekianlah kata-kata Ayub."
 },
 {
   "id": 13634,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 1,
   "firman": "Maka ketiga orang itu menghentikan sanggahan mereka terhadap Ayub, karena ia menganggap dirinya benar."
 },
 {
   "id": 13635,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 2,
   "firman": "Lalu marahlah Elihu bin Barakheel, orang Bus, dari kaum Ram; ia marah terhadap Ayub, karena ia menganggap dirinya lebih benar dari pada Allah,"
 },
 {
   "id": 13636,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 3,
   "firman": "dan ia juga marah terhadap ketiga orang sahabat itu, karena mereka mempersalahkan Ayub, meskipun tidak dapat memberikan sanggahan."
 },
 {
   "id": 13637,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 4,
   "firman": "Elihu menangguhkan bicaranya dengan Ayub, karena mereka lebih tua dari pada dia."
 },
 {
   "id": 13638,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 5,
   "firman": "Tetapi setelah dilihatnya, bahwa mulut ketiga orang itu tidak lagi memberi sanggahan, maka marahlah ia."
 },
 {
   "id": 13639,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 6,
   "firman": "Lalu berbicaralah Elihu bin Barakheel, orang Bus itu: \"Aku masih muda dan kamu sudah berumur tinggi; oleh sebab itu aku malu dan takut mengemukakan pendapatku kepadamu."
 },
 {
   "id": 13640,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 7,
   "firman": "Pikirku: Biarlah yang sudah lanjut usianya berbicara, dan yang sudah banyak jumlah tahunnya memaparkan hikmat."
 },
 {
   "id": 13641,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 8,
   "firman": "Tetapi roh yang di dalam manusia, dan nafas Yang Mahakuasa, itulah yang memberi kepadanya pengertian."
 },
 {
   "id": 13642,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 9,
   "firman": "Bukan orang yang lanjut umurnya yang mempunyai hikmat, bukan orang yang sudah tua yang mengerti keadilan."
 },
 {
   "id": 13643,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 10,
   "firman": "Oleh sebab itu aku berkata: Dengarkanlah aku, akupun akan mengemukakan pendapatku."
 },
 {
   "id": 13644,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 11,
   "firman": "Ketahuilah, aku telah menantikan kata-katamu, aku telah memperhatikan pemikiranmu, hingga kamu menemukan kata-kata yang tepat."
 },
 {
   "id": 13645,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 12,
   "firman": "Kepadamulah kupusatkan perhatianku, tetapi sesungguhnya, tiada seorangpun yang mengecam Ayub, tiada seorangpun di antara kamu menyanggah perkataannya."
 },
 {
   "id": 13646,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 13,
   "firman": "Jangan berkata sekarang: Kami sudah mendapatkan hikmat; hanya Allah yang dapat mengalahkan dia, bukan manusia."
 },
 {
   "id": 13647,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 14,
   "firman": "Perkataannya tidak tertuju kepadaku, dan aku tidak akan menjawabnya dengan perkataanmu."
 },
 {
   "id": 13648,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 15,
   "firman": "Mereka bingung, mereka tidak dapat memberi sanggahan lagi, mereka tidak dapat berbicara lagi."
 },
 {
   "id": 13649,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 16,
   "firman": "Haruskah aku menunggu, karena mereka putus bicara, karena mereka berdiri di sana dan tidak memberi sanggahan lagi?"
 },
 {
   "id": 13650,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 17,
   "firman": "Akupun hendak memberi sanggahan pada giliranku, akupun akan mengemukakan pendapatku."
 },
 {
   "id": 13651,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 18,
   "firman": "Karena aku tumpat dengan kata-kata, semangat yang ada dalam diriku mendesak aku."
 },
 {
   "id": 13652,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 19,
   "firman": "Sesungguhnya, batinku seperti anggur yang tidak mendapat jalan hawa, seperti kirbat baru yang akan meletup."
 },
 {
   "id": 13653,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 20,
   "firman": "Aku harus berbicara, supaya merasa lega, aku harus membuka mulutku dan memberi sanggahan."
 },
 {
   "id": 13654,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 21,
   "firman": "Aku tidak akan memihak kepada siapapun dan tidak akan menyanjung-nyanjung siapapun,"
 },
 {
   "id": 13655,
   "kitab": "Ayb",
   "pasal": 32,
   "ayat": 22,
   "firman": "karena aku tidak tahu menyanjung-nyanjung; jika demikian, maka segera Pembuatku akan mencabut nyawaku.\""
 },
 {
   "id": 13656,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 1,
   "firman": "\"Akan tetapi sekarang, hai Ayub, dengarkanlah bicaraku, dan bukalah telingamu kepada segala perkataanku."
 },
 {
   "id": 13657,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 2,
   "firman": "Ketahuilah, mulutku telah kubuka, lidahku di bawah langit-langitku berbicara."
 },
 {
   "id": 13658,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 3,
   "firman": "Perkataanku keluar dari hati yang jujur, dan bibirku menyatakan dengan terang apa yang diketahui."
 },
 {
   "id": 13659,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 4,
   "firman": "Roh Allah telah membuat aku, dan nafas Yang Mahakuasa membuat aku hidup."
 },
 {
   "id": 13660,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 5,
   "firman": "Jikalau engkau dapat, jawablah aku, bersiaplah engkau menghadapi aku, pertahankanlah dirimu."
 },
 {
   "id": 13661,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 6,
   "firman": "Sesungguhnya, bagi Allah aku sama dengan engkau, akupun dibentuk dari tanah liat."
 },
 {
   "id": 13662,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 7,
   "firman": "Jadi engkau tak usah ditimpa kegentaran terhadap aku, tekananku terhadap engkau tidak akan berat."
 },
 {
   "id": 13663,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 8,
   "firman": "Tetapi engkau telah berbicara dekat telingaku, dan ucapan-ucapanmu telah kudengar:"
 },
 {
   "id": 13664,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 9,
   "firman": "Aku bersih, aku tidak melakukan pelanggaran, aku suci, aku tidak ada kesalahan."
 },
 {
   "id": 13665,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 10,
   "firman": "Tetapi Ia mendapat alasan terhadap aku, Ia menganggap aku sebagai musuh-Nya."
 },
 {
   "id": 13666,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 11,
   "firman": "Ia memasukkan kakiku ke dalam pasung, Ia mengawasi segala jalanku."
 },
 {
   "id": 13667,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 12,
   "firman": "Sesungguhnya, dalam hal itu engkau tidak benar, demikian sanggahanku kepadamu, karena Allah itu lebih dari pada manusia."
 },
 {
   "id": 13668,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 13,
   "firman": "Mengapa engkau berbantah dengan Dia, bahwa Dia tidak menjawab segala perkataanmu?"
 },
 {
   "id": 13669,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 14,
   "firman": "Karena Allah berfirman dengan satu dua cara, tetapi orang tidak memperhatikannya."
 },
 {
   "id": 13670,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 15,
   "firman": "Dalam mimpi, dalam penglihatan waktu malam, bila orang nyenyak tidur, bila berbaring di atas tempat tidur,"
 },
 {
   "id": 13671,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 16,
   "firman": "maka Ia membuka telinga manusia dan mengejutkan mereka dengan teguran-teguran"
 },
 {
   "id": 13672,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 17,
   "firman": "untuk menghalangi manusia dari pada perbuatannya, dan melenyapkan kesombongan orang,"
 },
 {
   "id": 13673,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 18,
   "firman": "untuk menahan nyawanya dari pada liang kubur, dan hidupnya dari pada maut oleh lembing."
 },
 {
   "id": 13674,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 19,
   "firman": "Dengan penderitaan ia ditegur di tempat tidurnya, dan berkobar terus-menerus bentrokan dalam tulang-tulangnya;"
 },
 {
   "id": 13675,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 20,
   "firman": "perutnya bosan makanan, hilang nafsunya untuk makanan yang lezat-lezat;"
 },
 {
   "id": 13676,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 21,
   "firman": "susutlah dagingnya, sehingga tidak kelihatan lagi, tulang-tulangnya, yang mula-mula tidak tampak, menonjol ke luar,"
 },
 {
   "id": 13677,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 22,
   "firman": "sampai nyawanya menghampiri liang kubur, dan hidupnya mendekati mereka yang membawa maut."
 },
 {
   "id": 13678,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 23,
   "firman": "Jikalau di sampingnya ada malaikat, penengah, satu di antara seribu, untuk menyatakan jalan yang benar kepada manusia,"
 },
 {
   "id": 13679,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 24,
   "firman": "maka Ia akan mengasihaninya dengan berfirman: Lepaskan dia, supaya jangan ia turun ke liang kubur; uang tebusan telah Kuperoleh."
 },
 {
   "id": 13680,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 25,
   "firman": "Tubuhnya mengalami kesegaran seorang pemuda, ia seperti pada masa mudanya."
 },
 {
   "id": 13681,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 26,
   "firman": "Ia berdoa kepada Allah, dan Allah berkenan menerimanya; ia akan memandang wajah-Nya dengan bersorak-sorai, dan Allah mengembalikan kebenaran kepada manusia."
 },
 {
   "id": 13682,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 27,
   "firman": "Ia akan bernyanyi di depan orang: Aku telah berbuat dosa, dan yang lurus telah kubengkokkan, tetapi hal itu tidak dibalaskan kepadaku."
 },
 {
   "id": 13683,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 28,
   "firman": "Ia telah membebaskan nyawaku dari jalan ke liang kubur, dan hidupku akan melihat terang."
 },
 {
   "id": 13684,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 29,
   "firman": "Sesungguhnya, semuanya ini dilakukan Allah dua, tiga kali terhadap manusia:"
 },
 {
   "id": 13685,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 30,
   "firman": "mengembalikan nyawanya dari liang kubur, sehingga ia diterangi oleh cahaya hidup."
 },
 {
   "id": 13686,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 31,
   "firman": "Perhatikanlah, hai Ayub, dengarkanlah aku, diamlah, akulah yang berbicara."
 },
 {
   "id": 13687,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 32,
   "firman": "Jikalau ada yang hendak kaukatakan, jawablah aku; berkatalah, karena aku rela membenarkan engkau."
 },
 {
   "id": 13688,
   "kitab": "Ayb",
   "pasal": 33,
   "ayat": 33,
   "firman": "Jikalau tidak, hendaklah engkau mendengarkan aku; diamlah, aku hendak mengajarkan hikmat kepadamu.\""
 },
 {
   "id": 13689,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 1,
   "firman": "Maka berbicaralah Elihu:"
 },
 {
   "id": 13690,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 2,
   "firman": "\"Dengarkanlah perkataanku, kamu orang-orang yang mempunyai hikmat, berilah telinga kepadaku, kamu orang-orang yang berakal budi."
 },
 {
   "id": 13691,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 3,
   "firman": "Karena telinga itu menguji kata-kata, seperti langit-langit mencecap makanan."
 },
 {
   "id": 13692,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 4,
   "firman": "Biarlah kita memutuskan bagi kita sendiri apa yang adil, menentukan bersama-sama apa yang baik."
 },
 {
   "id": 13693,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 5,
   "firman": "Karena Ayub berkata: Aku benar, tetapi Allah mengambil hakku;"
 },
 {
   "id": 13694,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 6,
   "firman": "kendati aku mempunyai hak aku dianggap berdusta, sekalipun aku tidak melakukan pelanggaran, lukaku tidak dapat sembuh lagi."
 },
 {
   "id": 13695,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 7,
   "firman": "Siapakah seperti Ayub, yang minum hujatan terhadap Allah seperti air,"
 },
 {
   "id": 13696,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 8,
   "firman": "yang mencari persekutuan dengan orang-orang yang melakukan kejahatan dan bergaul dengan orang-orang fasik?"
 },
 {
   "id": 13697,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 9,
   "firman": "Karena ia telah berkata: Tidak berguna bagi manusia, kalau ia dikenan Allah."
 },
 {
   "id": 13698,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 10,
   "firman": "Oleh sebab itu, kamu orang-orang yang berakal budi, dengarkanlah aku: Jauhlah dari pada Allah untuk melakukan kefasikan, dan dari pada Yang Mahakuasa untuk berbuat curang."
 },
 {
   "id": 13699,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 11,
   "firman": "Malah Ia mengganjar manusia sesuai perbuatannya, dan membuat setiap orang mengalami sesuai kelakuannya."
 },
 {
   "id": 13700,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 12,
   "firman": "Sungguh, Allah tidak berlaku curang, Yang Mahakuasa tidak membengkokkan keadilan."
 },
 {
   "id": 13701,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 13,
   "firman": "Siapa mempercayakan bumi kepada-Nya? Siapa membebankan alam semesta kepada-Nya?"
 },
 {
   "id": 13702,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 14,
   "firman": "Jikalau Ia menarik kembali Roh-Nya, dan mengembalikan nafas-Nya pada-Nya,"
 },
 {
   "id": 13703,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 15,
   "firman": "maka binasalah bersama-sama segala yang hidup, dan kembalilah manusia kepada debu."
 },
 {
   "id": 13704,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 16,
   "firman": "Jikalau engkau berakal budi, dengarkanlah ini, pasanglah telinga kepada apa yang kuucapkan."
 },
 {
   "id": 13705,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 17,
   "firman": "Dapatkah pembenci keadilan memegang kekuasaan, dan apakah engkau mau mempersalahkan Dia yang adil dan perkasa,"
 },
 {
   "id": 13706,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 18,
   "firman": "Dia yang berfirman kepada raja: Hai, orang dursila, kepada para bangsawan: Hai, orang fasik;"
 },
 {
   "id": 13707,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 19,
   "firman": "Dia yang tidak memihak kepada para pembesar, dan tidak mengutamakan orang yang terkemuka dari pada orang kecil, karena mereka sekalian adalah buatan tangan-Nya?"
 },
 {
   "id": 13708,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 20,
   "firman": "Dalam sekejap mata mereka mati, ya, pada tengah malam orang dikejutkan dan binasa; mereka yang perkasa dilenyapkan bukan oleh tangan orang."
 },
 {
   "id": 13709,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 21,
   "firman": "Karena mata-Nya mengawasi jalan manusia, dan Ia melihat segala langkahnya;"
 },
 {
   "id": 13710,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 22,
   "firman": "tidak ada kegelapan ataupun kelam kabut, di mana orang-orang yang melakukan kejahatan dapat bersembunyi."
 },
 {
   "id": 13711,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 23,
   "firman": "Karena bagi manusia Ia tidak menentukan waktu untuk datang menghadap Allah supaya diadili,"
 },
 {
   "id": 13712,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 24,
   "firman": "orang-orang yang perkasa diremukkan-Nya dengan tidak diperiksa, dan orang-orang lain diangkat-Nya ganti mereka."
 },
 {
   "id": 13713,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 25,
   "firman": "Jadi, Ia mengetahui perbuatan mereka, dan menggulingkan mereka di waktu malam, sehingga mereka hancur lebur."
 },
 {
   "id": 13714,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 26,
   "firman": "Mereka ditampar-Nya karena kefasikan mereka, dengan dilihat orang banyak,"
 },
 {
   "id": 13715,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 27,
   "firman": "karena mereka meninggalkan-Nya, dan tidak mengindahkan satupun dari pada jalan-Nya,"
 },
 {
   "id": 13716,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 28,
   "firman": "sehingga mereka menyebabkan jeritan orang miskin naik ke hadapan-Nya, dan Ia mendengar jeritan orang sengsara."
 },
 {
   "id": 13717,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 29,
   "firman": "--Kalau Dia berdiam diri, siapa akan menjatuhkan hukuman? Kalau Dia menyembunyikan wajah-Nya, siapa akan melihat Dia, baik itu sesuatu bangsa atau orang seorang? --,"
 },
 {
   "id": 13718,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 30,
   "firman": "supaya jangan menjadi raja orang fasik yang adalah jerat bagi orang banyak."
 },
 {
   "id": 13719,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 31,
   "firman": "Tetapi kalau seseorang berkata kepada Allah: Aku telah menyombongkan diri, tetapi aku tidak akan lagi berbuat jahat;"
 },
 {
   "id": 13720,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 32,
   "firman": "apa yang tidak kumengerti, ajarkanlah kepadaku; jikalau aku telah berbuat curang, maka aku tidak akan berbuat lagi,"
 },
 {
   "id": 13721,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 33,
   "firman": "menurut hematmu apakah Allah harus melakukan pembalasan karena engkau yang menolak? Jadi, engkau jugalah yang harus memutuskan, bukan aku; katakanlah apa yang engkau tahu!"
 },
 {
   "id": 13722,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 34,
   "firman": "Maka orang-orang yang berakal budi dan orang yang mempunyai hikmat yang mendengarkan aku akan berkata kepadaku:"
 },
 {
   "id": 13723,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 35,
   "firman": "Ayub berbicara tanpa pengetahuan, dan perkataannya tidak mengandung pengertian."
 },
 {
   "id": 13724,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 36,
   "firman": "Ah, kiranya Ayub diuji terus-menerus, karena ia menjawab seperti orang-orang jahat!"
 },
 {
   "id": 13725,
   "kitab": "Ayb",
   "pasal": 34,
   "ayat": 37,
   "firman": "Karena ia menambahkan dosanya dengan pelanggaran, ia mengepalkan tangan di antara kami dan banyak bicara terhadap Allah.\""
 },
 {
   "id": 13726,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 1,
   "firman": "Maka berbicaralah Elihu:"
 },
 {
   "id": 13727,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 2,
   "firman": "\"Inikah yang kauanggap adil dan yang kausebut: kebenaranku di hadapan Allah,"
 },
 {
   "id": 13728,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 3,
   "firman": "kalau engkau bertanya: Apakah gunanya bagiku? Apakah kelebihanku bila aku berbuat dosa?"
 },
 {
   "id": 13729,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 4,
   "firman": "Akulah yang akan memberi jawab kepadamu dan kepada sahabat-sahabatmu bersama-sama dengan engkau:"
 },
 {
   "id": 13730,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 5,
   "firman": "Arahkan pandanganmu ke langit dan lihatlah, perhatikanlah awan-awan yang lebih tinggi dari padamu!"
 },
 {
   "id": 13731,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 6,
   "firman": "Jikalau engkau berbuat dosa, apa yang akan kaulakukan terhadap Dia? Kalau pelanggaranmu banyak, apa yang kaubuat terhadap Dia?"
 },
 {
   "id": 13732,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 7,
   "firman": "Jikalau engkau benar, apakah yang kauberikan kepada Dia? Atau apakah yang diterima-Nya dari tanganmu?"
 },
 {
   "id": 13733,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 8,
   "firman": "Hanya orang seperti engkau yang dirugikan oleh kefasikanmu dan hanya anak manusia yang diuntungkan oleh kebenaranmu."
 },
 {
   "id": 13734,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 9,
   "firman": "Orang menjerit oleh karena banyaknya penindasan, berteriak minta tolong oleh karena kekerasan orang-orang yang berkuasa;"
 },
 {
   "id": 13735,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 10,
   "firman": "tetapi orang tidak bertanya: Di mana Allah, yang membuat aku, dan yang memberi nyanyian pujian di waktu malam;"
 },
 {
   "id": 13736,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 11,
   "firman": "yang memberi kita akal budi melebihi binatang di bumi, dan hikmat melebihi burung di udara?"
 },
 {
   "id": 13737,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 12,
   "firman": "Ketika itu orang menjerit, tetapi Ia tidak menjawab, oleh karena kecongkakan orang-orang jahat."
 },
 {
   "id": 13738,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 13,
   "firman": "Sungguh, teriakan yang kosong tidak didengar Allah dan tidak dihiraukan oleh Yang Mahakuasa."
 },
 {
   "id": 13739,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 14,
   "firman": "Lebih-lebih lagi kalau engkau berkata, bahwa engkau tidak melihat Dia, bahwa perkaramu sudah diadukan kehadapan-Nya, tetapi masih juga engkau menanti-nantikan Dia!"
 },
 {
   "id": 13740,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 15,
   "firman": "Tetapi sekarang: karena murka-Nya tidak menghukum dan Ia tidak terlalu mempedulikan pelanggaran,"
 },
 {
   "id": 13741,
   "kitab": "Ayb",
   "pasal": 35,
   "ayat": 16,
   "firman": "maka Ayub berbesar mulut dengan sia-sia, banyak bicara tanpa pengertian.\""
 },
 {
   "id": 13742,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 1,
   "firman": "Berkatalah Elihu selanjutnya:"
 },
 {
   "id": 13743,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 2,
   "firman": "\"Bersabarlah sebentar, aku akan mengajar engkau, karena masih ada yang hendak kukatakan demi Allah."
 },
 {
   "id": 13744,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 3,
   "firman": "Aku akan meraih pengetahuanku dari jauh dan membenarkan Pembuatku;"
 },
 {
   "id": 13745,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 4,
   "firman": "karena sungguh-sungguh, bukan dusta perkataanku, seorang yang sempurna pengetahuannya menghadapi engkau."
 },
 {
   "id": 13746,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 5,
   "firman": "Ketahuilah, Allah itu perkasa, namun tidak memandang hina apapun, Ia perkasa dalam kekuatan akal budi."
 },
 {
   "id": 13747,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 6,
   "firman": "Ia tidak membiarkan orang fasik hidup, tetapi memberi keadilan kepada orang-orang sengsara;"
 },
 {
   "id": 13748,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 7,
   "firman": "Ia tidak mengalihkan pandangan mata-Nya dari orang benar, tetapi menempatkan mereka untuk selama-lamanya di samping raja-raja di atas takhta, sehingga mereka tinggi martabatnya."
 },
 {
   "id": 13749,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 8,
   "firman": "Jikalau mereka dibelenggu dengan rantai, tertangkap dalam tali kesengsaraan,"
 },
 {
   "id": 13750,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 9,
   "firman": "maka Ia memperingatkan mereka kepada perbuatan mereka, dan kepada pelanggaran mereka, karena mereka berlaku congkak,"
 },
 {
   "id": 13751,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 10,
   "firman": "dan ia membukakan telinga mereka bagi ajaran, dan menyuruh mereka berbalik dari kejahatan."
 },
 {
   "id": 13752,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 11,
   "firman": "Jikalau mereka mendengar dan takluk, maka mereka hidup mujur sampai akhir hari-hari mereka dan senang sampai akhir tahun-tahun mereka."
 },
 {
   "id": 13753,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 12,
   "firman": "Tetapi, jikalau mereka tidak mendengar, maka mereka akan mati oleh lembing, dan binasa dalam kebebalan."
 },
 {
   "id": 13754,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 13,
   "firman": "Orang-orang yang fasik hatinya menyimpan kemarahan; mereka tidak berteriak minta tolong, kalau mereka dibelenggu-Nya;"
 },
 {
   "id": 13755,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 14,
   "firman": "nyawa mereka binasa di masa muda, dan hidup mereka berakhir sebelum saatnya."
 },
 {
   "id": 13756,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 15,
   "firman": "Dengan sengsara Ia menyelamatkan orang sengsara, dengan penindasan Ia membuka telinga mereka."
 },
 {
   "id": 13757,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 16,
   "firman": "Juga engkau dibujuk-Nya keluar dari dalam kesesakan, ke tempat yang luas, bebas dari tekanan, ke meja hidanganmu yang tenang dan penuh lemak."
 },
 {
   "id": 13758,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 17,
   "firman": "Tetapi engkau sudah mendapat hukuman orang fasik sepenuhnya, engkau dicengkeram hukuman dan keadilan;"
 },
 {
   "id": 13759,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 18,
   "firman": "janganlah panas hati membujuk engkau berolok-olok, janganlah besarnya tebusan menyesatkan engkau."
 },
 {
   "id": 13760,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 19,
   "firman": "Dapatkah teriakanmu meluputkan engkau dari kesesakan, ataukah seluruh kekuatan jerih payahmu?"
 },
 {
   "id": 13761,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 20,
   "firman": "Janganlah merindukan malam hari, waktu bangsa-bangsa pergi dari tempatnya."
 },
 {
   "id": 13762,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 21,
   "firman": "Jagalah dirimu, janganlah berpaling kepada kejahatan, karena itulah sebabnya engkau dicobai oleh sengsara."
 },
 {
   "id": 13763,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 22,
   "firman": "Sesungguhnya, Allah itu mulia di dalam kekuasaan-Nya; siapakah guru seperti Dia?"
 },
 {
   "id": 13764,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 23,
   "firman": "Siapakah akan menentukan jalan bagi-Nya, dan siapa berani berkata: Engkau telah berbuat curang?"
 },
 {
   "id": 13765,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 24,
   "firman": "Ingatlah, bahwa engkau harus menjunjung tinggi perbuatan-Nya, yang selalu dinyanyikan oleh manusia."
 },
 {
   "id": 13766,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 25,
   "firman": "Semua orang melihatnya, manusia memandangnya dari jauh."
 },
 {
   "id": 13767,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 26,
   "firman": "Sesungguhnya, Allah itu besar, tidak tercapai oleh pengetahuan kita, jumlah tahun-Nya tidak dapat diselidiki."
 },
 {
   "id": 13768,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 27,
   "firman": "Ia menarik ke atas titik-titik air, dan memekatkan kabut menjadi hujan,"
 },
 {
   "id": 13769,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 28,
   "firman": "yang dicurahkan oleh mendung, dan disiramkan ke atas banyak manusia."
 },
 {
   "id": 13770,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 29,
   "firman": "Siapa mengerti berkembangnya awan, dan bunyi gemuruh di tempat kediaman-Nya?"
 },
 {
   "id": 13771,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 30,
   "firman": "Sesungguhnya, Ia mengembangkan terang-Nya di sekeliling-Nya, dan menudungi dasar laut."
 },
 {
   "id": 13772,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 31,
   "firman": "Karena dengan semuanya itu Ia mengadili bangsa-bangsa, dan juga memberi makan dengan berlimpah-limpah."
 },
 {
   "id": 13773,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 32,
   "firman": "Kedua tangan-Nya diselubungi-Nya dengan kilat petir dan menyuruhnya menyambar sasaran."
 },
 {
   "id": 13774,
   "kitab": "Ayb",
   "pasal": 36,
   "ayat": 33,
   "firman": "Pekik perang-Nya memberitakan kedatangan-Nya, kalau dengan murka Ia berjuang melawan kecurangan.\""
 },
 {
   "id": 13775,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 1,
   "firman": "\"Sungguh, oleh karena itu hatiku berdebar-debar dan melonjak dari tempatnya."
 },
 {
   "id": 13776,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 2,
   "firman": "Dengar, dengarlah gegap gempita suara-Nya, guruh yang keluar dari dalam mulut-Nya."
 },
 {
   "id": 13777,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 3,
   "firman": "Ia melepaskannya ke seluruh kolong langit, dan juga kilat petir-Nya ke ujung-ujung bumi."
 },
 {
   "id": 13778,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 4,
   "firman": "Kemudian suara-Nya menderu, Ia mengguntur dengan suara-Nya yang megah; Ia tidak menahan kilat petir, bila suara-Nya kedengaran."
 },
 {
   "id": 13779,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 5,
   "firman": "Allah mengguntur dengan suara-Nya yang mengagumkan; Ia melakukan perbuatan-perbuatan besar yang tidak tercapai oleh pengetahuan kita;"
 },
 {
   "id": 13780,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 6,
   "firman": "karena kepada salju Ia berfirman: Jatuhlah ke bumi, dan kepada hujan lebat dan hujan deras: Jadilah deras!"
 },
 {
   "id": 13781,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 7,
   "firman": "Tangan setiap manusia diikat-Nya dengan dibubuhi meterai, agar semua orang mengetahui perbuatan-Nya."
 },
 {
   "id": 13782,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 8,
   "firman": "Maka binatang liar masuk ke dalam tempat persembunyiannya dan tinggal dalam sarangnya."
 },
 {
   "id": 13783,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 9,
   "firman": "Taufan keluar dari dalam perbendaharaan, dan hawa dingin dari sebelah utara."
 },
 {
   "id": 13784,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 10,
   "firman": "Oleh nafas Allah terjadilah es, dan permukaan air yang luas membeku."
 },
 {
   "id": 13785,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 11,
   "firman": "Awanpun dimuati-Nya dengan air, dan awan memencarkan kilat-Nya,"
 },
 {
   "id": 13786,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 12,
   "firman": "lalu kilat-Nya menyambar-nyambar ke seluruh penjuru menurut pimpinan-Nya untuk melakukan di permukaan bumi segala yang diperintahkan-Nya."
 },
 {
   "id": 13787,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 13,
   "firman": "Ia membuatnya mencapai tujuannya, baik untuk menjadi pentung bagi isi bumi-Nya maupun untuk menyatakan kasih setia."
 },
 {
   "id": 13788,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 14,
   "firman": "Berilah telinga kepada semuanya itu, hai Ayub, diamlah, dan perhatikanlah keajaiban-keajaiban Allah."
 },
 {
   "id": 13789,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 15,
   "firman": "Tahukah engkau, bagaimana Allah memberi tugas kepadanya, dan menyinarkan cahaya dari awan-Nya?"
 },
 {
   "id": 13790,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 16,
   "firman": "Tahukah engkau tentang melayangnya awan-awan, tentang keajaiban-keajaiban dari Yang Mahatahu,"
 },
 {
   "id": 13791,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 17,
   "firman": "hai engkau, yang pakaiannya menjadi panas, jika bumi terdiam karena panasnya angin selatan?"
 },
 {
   "id": 13792,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 18,
   "firman": "Dapatkah engkau seperti Dia menyusun awan menjadi cakrawala, keras seperti cermin tuangan?"
 },
 {
   "id": 13793,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 19,
   "firman": "Beritahukanlah kepada kami apa yang harus kami katakan kepada-Nya: tak ada yang dapat kami paparkan oleh karena kegelapan."
 },
 {
   "id": 13794,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 20,
   "firman": "Apakah akan diberitahukan kepada-Nya, bahwa aku akan bicara? Pernahkah orang berkata, bahwa ia ingin dibinasakan?"
 },
 {
   "id": 13795,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 21,
   "firman": "Seketika terang tidak terlihat, karena digelapkan mendung; lalu angin berembus, maka bersihlah cuaca."
 },
 {
   "id": 13796,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 22,
   "firman": "Dari sebelah utara muncul sinar keemasan; Allah diliputi oleh keagungan yang dahsyat."
 },
 {
   "id": 13797,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 23,
   "firman": "Yang Mahakuasa, yang tidak dapat kita pahami, besar kekuasaan dan keadilan-Nya; walaupun kaya akan kebenaran Ia tidak menindasnya."
 },
 {
   "id": 13798,
   "kitab": "Ayb",
   "pasal": 37,
   "ayat": 24,
   "firman": "Itulah sebabnya Ia ditakuti orang; setiap orang yang menganggap dirinya mempunyai hikmat, tidak dihiraukan-Nya.\""
 },
 {
   "id": 13799,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 1,
   "firman": "Maka dari dalam badai TUHAN menjawab Ayub:"
 },
 {
   "id": 13800,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 2,
   "firman": "\"Siapakah dia yang menggelapkan keputusan dengan perkataan-perkataan yang tidak berpengetahuan?"
 },
 {
   "id": 13801,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 3,
   "firman": "Bersiaplah engkau sebagai laki-laki! Aku akan menanyai engkau, supaya engkau memberitahu Aku."
 },
 {
   "id": 13802,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 4,
   "firman": "Di manakah engkau, ketika Aku meletakkan dasar bumi? Ceritakanlah, kalau engkau mempunyai pengertian!"
 },
 {
   "id": 13803,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 5,
   "firman": "Siapakah yang telah menetapkan ukurannya? Bukankah engkau mengetahuinya? --Atau siapakah yang telah merentangkan tali pengukur padanya?"
 },
 {
   "id": 13804,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 6,
   "firman": "Atas apakah sendi-sendinya dilantak, dan siapakah yang memasang batu penjurunya"
 },
 {
   "id": 13805,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 7,
   "firman": "pada waktu bintang-bintang fajar bersorak-sorak bersama-sama, dan semua anak Allah bersorak-sorai?"
 },
 {
   "id": 13806,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 8,
   "firman": "Siapa telah membendung laut dengan pintu, ketika membual ke luar dari dalam rahim? --"
 },
 {
   "id": 13807,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 9,
   "firman": "ketika Aku membuat awan menjadi pakaiannya dan kekelaman menjadi kain bedungnya;"
 },
 {
   "id": 13808,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 10,
   "firman": "ketika Aku menetapkan batasnya, dan memasang palang dan pintu;"
 },
 {
   "id": 13809,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 11,
   "firman": "ketika Aku berfirman: Sampai di sini boleh engkau datang, jangan lewat, di sinilah gelombang-gelombangmu yang congkak akan dihentikan!"
 },
 {
   "id": 13810,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 12,
   "firman": "Pernahkah dalam hidupmu engkau menyuruh datang dinihari atau fajar kautunjukkan tempatnya"
 },
 {
   "id": 13811,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 13,
   "firman": "untuk memegang ujung-ujung bumi, sehingga orang-orang fasik dikebaskan dari padanya?"
 },
 {
   "id": 13812,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 14,
   "firman": "Bumi itu berubah seperti tanah liat yang dimeteraikan, segala sesuatu berwarna seperti kain."
 },
 {
   "id": 13813,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 15,
   "firman": "Orang-orang fasik dirampas terangnya, dan dipatahkan lengan yang diacungkan."
 },
 {
   "id": 13814,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 16,
   "firman": "Engkaukah yang turun sampai ke sumber laut, atau berjalan-jalan melalui dasar samudera raya?"
 },
 {
   "id": 13815,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 17,
   "firman": "Apakah pintu gerbang maut tersingkap bagimu, atau pernahkah engkau melihat pintu gerbang kelam pekat?"
 },
 {
   "id": 13816,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 18,
   "firman": "Apakah engkau mengerti luasnya bumi? Nyatakanlah, kalau engkau tahu semuanya itu."
 },
 {
   "id": 13817,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 19,
   "firman": "Di manakah jalan ke tempat kediaman terang, dan di manakah tempat tinggal kegelapan,"
 },
 {
   "id": 13818,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 20,
   "firman": "sehingga engkau dapat mengantarnya ke daerahnya, dan mengetahui jalan-jalan ke rumahnya?"
 },
 {
   "id": 13819,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 21,
   "firman": "Tentu engkau mengenalnya, karena ketika itu engkau telah lahir, dan jumlah hari-harimu telah banyak!"
 },
 {
   "id": 13820,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 22,
   "firman": "Apakah engkau telah masuk sampai ke perbendaharaan salju, atau melihat perbendaharaan hujan batu,"
 },
 {
   "id": 13821,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 23,
   "firman": "yang Kusimpan untuk masa kesesakan, untuk waktu pertempuran dan peperangan?"
 },
 {
   "id": 13822,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 24,
   "firman": "Di manakah jalan ke tempat terang berpencar, ke tempat angin timur bertebar ke atas bumi?"
 },
 {
   "id": 13823,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 25,
   "firman": "Siapakah yang menggali saluran bagi hujan deras dan jalan bagi kilat guruh,"
 },
 {
   "id": 13824,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 26,
   "firman": "untuk memberi hujan ke atas tanah di mana tidak ada orang, ke atas padang tandus yang tidak didiami manusia;"
 },
 {
   "id": 13825,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 27,
   "firman": "untuk mengenyangkan gurun dan belantara, dan menumbuhkan pucuk-pucuk rumput muda?"
 },
 {
   "id": 13826,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 28,
   "firman": "Apakah hujan itu berayah? Atau siapakah yang menyebabkan lahirnya titik air embun?"
 },
 {
   "id": 13827,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 29,
   "firman": "Dari dalam kandungan siapakah keluar air beku, dan embun beku di langit, siapakah yang melahirkannya?"
 },
 {
   "id": 13828,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 30,
   "firman": "Air membeku seperti batu, dan permukaan samudera raya mengeras."
 },
 {
   "id": 13829,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 31,
   "firman": "Dapatkah engkau memberkas ikatan bintang Kartika, dan membuka belenggu bintang Belantik?"
 },
 {
   "id": 13830,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 32,
   "firman": "Dapatkah engkau menerbitkan Mintakulburuj pada waktunya, dan memimpin bintang Biduk dengan pengiring-pengiringnya?"
 },
 {
   "id": 13831,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 33,
   "firman": "Apakah engkau mengetahui hukum-hukum bagi langit? atau menetapkan pemerintahannya di atas bumi?"
 },
 {
   "id": 13832,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 34,
   "firman": "Dapatkah engkau menyaringkan suaramu sampai ke awan-awan, sehingga banjir meliputi engkau?"
 },
 {
   "id": 13833,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 35,
   "firman": "Dapatkah engkau melepaskan kilat, sehingga sabung-menyabung, sambil berkata kepadamu: Ya?"
 },
 {
   "id": 13834,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 36,
   "firman": "Siapa menaruh hikmat dalam awan-awan atau siapa memberikan pengertian kepada gumpalan mendung?"
 },
 {
   "id": 13835,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 37,
   "firman": "Siapa dapat menghitung awan dengan hikmat, dan siapa dapat mencurahkan tempayan-tempayan langit,"
 },
 {
   "id": 13836,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 38,
   "firman": "ketika debu membeku menjadi logam tuangan, dan gumpalan tanah berlekat-lekatan?"
 },
 {
   "id": 13837,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 39,
   "firman": "(38-1) Dapatkah engkau memburu mangsa untuk singa betina, dan memuaskan selera singa-singa muda,"
 },
 {
   "id": 13838,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 40,
   "firman": "(38-2) kalau mereka merangkak di dalam sarangnya, mengendap di bawah semak belukar?"
 },
 {
   "id": 13839,
   "kitab": "Ayb",
   "pasal": 38,
   "ayat": 41,
   "firman": "(38-3) Siapakah yang menyediakan mangsa bagi burung gagak, apabila anak-anaknya berkaok-kaok kepada Allah, berkeliaran karena tidak ada makanan?"
 },
 {
   "id": 13840,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 1,
   "firman": "(39-4) Apakah engkau mengetahui waktunya kambing gunung beranak, atau mengamat-amati rusa waktu sakit beranak?"
 },
 {
   "id": 13841,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 2,
   "firman": "(39-5) Dapatkah engkau menghitung berapa lamanya sampai genap bulannya, dan mengetahui waktunya beranak?"
 },
 {
   "id": 13842,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 3,
   "firman": "(39-6) Dengan membungkukkan diri mereka melahirkan anak-anaknya, dan mengeluarkan isi kandungannya."
 },
 {
   "id": 13843,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 4,
   "firman": "(39-7) Anak-anaknya menjadi kuat dan besar di padang, mereka pergi dan tidak kembali lagi kepada induknya."
 },
 {
   "id": 13844,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 5,
   "firman": "(39-8) Siapakah yang mengumbar keledai liar, atau siapakah yang membuka tali tambatan keledai jalang?"
 },
 {
   "id": 13845,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 6,
   "firman": "(39-9) Kepadanya telah Kuberikan tanah dataran sebagai tempat kediamannya dan padang masin sebagai tempat tinggalnya."
 },
 {
   "id": 13846,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 7,
   "firman": "(39-10) Ia menertawakan keramaian kota, tidak mendengarkan teriak si penggiring;"
 },
 {
   "id": 13847,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 8,
   "firman": "(39-11) ia menjelajah gunung-gunung padang rumputnya, dan mencari apa saja yang hijau."
 },
 {
   "id": 13848,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 9,
   "firman": "(39-12) Apakah lembu hutan mau takluk kepadamu, atau bermalam dekat palunganmu?"
 },
 {
   "id": 13849,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 10,
   "firman": "(39-13) Dapatkah engkau memaksa lembu hutan mengikuti alur bajak dengan keluan, atau apakah ia akan menyisir tanah lembah mengikuti engkau?"
 },
 {
   "id": 13850,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 11,
   "firman": "(39-14) Percayakah engkau kepadanya, karena kekuatannya sangat besar? Atau kauserahkankah kepadanya pekerjaanmu yang berat?"
 },
 {
   "id": 13851,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 12,
   "firman": "(39-15) Apakah engkau menaruh kepercayaan kepadanya, bahwa ia akan membawa pulang hasil tanahmu, dan mengumpulkannya di tempat pengirikanmu?"
 },
 {
   "id": 13852,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 13,
   "firman": "(39-16) Dengan riang sayap burung unta berkepak-kepak, tetapi apakah kepak dan bulu itu menaruh kasih sayang?"
 },
 {
   "id": 13853,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 14,
   "firman": "(39-17) Sebab telurnya ditinggalkannya di tanah, dan dibiarkannya menjadi panas di dalam pasir,"
 },
 {
   "id": 13854,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 15,
   "firman": "(39-18) tetapi lupa, bahwa telur itu dapat terpijak kaki, dan diinjak-injak oleh binatang-binatang liar."
 },
 {
   "id": 13855,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 16,
   "firman": "(39-19) Ia memperlakukan anak-anaknya dengan keras seolah-olah bukan anaknya sendiri; ia tidak peduli, kalau jerih payahnya sia-sia,"
 },
 {
   "id": 13856,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 17,
   "firman": "(39-20) karena Allah tidak memberikannya hikmat, dan tidak membagikan pengertian kepadanya."
 },
 {
   "id": 13857,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 18,
   "firman": "(39-21) Apabila ia dengan megah mengepakkan sayapnya, maka ia menertawakan kuda dan penunggangnya."
 },
 {
   "id": 13858,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 19,
   "firman": "(39-22) Engkaukah yang memberi tenaga kepada kuda? Engkaukah yang mengenakan surai pada tengkuknya?"
 },
 {
   "id": 13859,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 20,
   "firman": "(39-23) Engkaukah yang membuat dia melompat seperti belalang? Ringkiknya yang dahsyat mengerikan."
 },
 {
   "id": 13860,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 21,
   "firman": "(39-24) Ia menggaruk tanah lembah dengan gembira, dengan kekuatan ia maju menghadapi senjata."
 },
 {
   "id": 13861,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 22,
   "firman": "(39-25) Kedahsyatan ditertawakannya, ia tidak pernah kecut hati, dan ia pantang mundur menghadapi pedang."
 },
 {
   "id": 13862,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 23,
   "firman": "(39-26) Di atas dia tabung panah gemerencing, tombak dan lembing gemerlapan;"
 },
 {
   "id": 13863,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 24,
   "firman": "(39-27) dengan garang dan galak dilulurnya tanah, dan ia meronta-ronta kalau kedengaran bunyi sangkakala;"
 },
 {
   "id": 13864,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 25,
   "firman": "(39-28) ia meringkik setiap kali sangkakala ditiup; dan dari jauh sudah diciumnya perang, gertak para panglima dan pekik."
 },
 {
   "id": 13865,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 26,
   "firman": "(39-29) Oleh pengertianmukah burung elang terbang, mengembangkan sayapnya menuju ke selatan?"
 },
 {
   "id": 13866,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 27,
   "firman": "(39-30) Atas perintahmukah rajawali terbang membubung, dan membuat sarangnya di tempat yang tinggi?"
 },
 {
   "id": 13867,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 28,
   "firman": "(39-31) Ia diam dan bersarang di bukit batu, di puncak bukit batu dan di gunung yang sulit didatangi."
 },
 {
   "id": 13868,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 29,
   "firman": "(39-32) Dari sana ia mengintai mencari mangsa, dari jauh matanya mengamat-amati;"
 },
 {
   "id": 13869,
   "kitab": "Ayb",
   "pasal": 39,
   "ayat": 30,
   "firman": "(39-33) anak-anaknya menghirup darah, dan di mana ada yang tewas, di situlah dia.\""
 },
 {
   "id": 13870,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 1,
   "firman": "(39-34) Maka jawab TUHAN kepada Ayub:"
 },
 {
   "id": 13871,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 2,
   "firman": "(39-35) \"Apakah si pengecam hendak berbantah dengan Yang Mahakuasa? Hendaklah yang mencela Allah menjawab!\""
 },
 {
   "id": 13872,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 3,
   "firman": "(39-36) Maka jawab Ayub kepada TUHAN:"
 },
 {
   "id": 13873,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 4,
   "firman": "(39-37) \"Sesungguhnya, aku ini terlalu hina; jawab apakah yang dapat kuberikan kepada-Mu? Mulutku kututup dengan tangan."
 },
 {
   "id": 13874,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 5,
   "firman": "(39-38) Satu kali aku berbicara, tetapi tidak akan kuulangi; bahkan dua kali, tetapi tidak akan kulanjutkan.\""
 },
 {
   "id": 13875,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 6,
   "firman": "(40-1) Maka dari dalam badai TUHAN menjawab Ayub:"
 },
 {
   "id": 13876,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 7,
   "firman": "(40-2) \"Bersiaplah engkau sebagai laki-laki; Aku akan menanyai engkau, dan engkau memberitahu Aku."
 },
 {
   "id": 13877,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 8,
   "firman": "(40-3) Apakah engkau hendak meniadakan pengadilan-Ku, mempersalahkan Aku supaya engkau dapat membenarkan dirimu?"
 },
 {
   "id": 13878,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 9,
   "firman": "(40-4) Apakah lenganmu seperti lengan Allah, dan dapatkah engkau mengguntur seperti Dia?"
 },
 {
   "id": 13879,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 10,
   "firman": "(40-5) Hiasilah dirimu dengan kemegahan dan keluhuran, kenakanlah keagungan dan semarak!"
 },
 {
   "id": 13880,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 11,
   "firman": "(40-6) Luapkanlah marahmu yang bergelora; amat-amatilah setiap orang yang congkak dan rendahkanlah dia!"
 },
 {
   "id": 13881,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 12,
   "firman": "(40-7) Amat-amatilah setiap orang yang congkak, tundukkanlah dia, dan hancurkanlah orang-orang fasik di tempatnya!"
 },
 {
   "id": 13882,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 13,
   "firman": "(40-8) Pendamlah mereka bersama-sama dalam debu, kurunglah mereka di tempat yang tersembunyi."
 },
 {
   "id": 13883,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 14,
   "firman": "(40-9) Maka Akupun akan memuji engkau, karena tangan kananmu memberi engkau kemenangan.\""
 },
 {
   "id": 13884,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 15,
   "firman": "(40-10) \"Perhatikanlah kuda Nil, yang telah Kubuat seperti juga engkau. Ia makan rumput seperti lembu."
 },
 {
   "id": 13885,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 16,
   "firman": "(40-11) Perhatikanlah tenaga di pinggangnya, kekuatan pada urat-urat perutnya!"
 },
 {
   "id": 13886,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 17,
   "firman": "(40-12) Ia meregangkan ekornya seperti pohon aras, otot-otot pahanya berjalin-jalinan."
 },
 {
   "id": 13887,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 18,
   "firman": "(40-13) Tulang-tulangnya seperti pembuluh tembaga, kerangkanya seperti batang besi."
 },
 {
   "id": 13888,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 19,
   "firman": "(40-14) Dia yang pertama dibuat Allah, makhluk yang diberi-Nya bersenjatakan pedang;"
 },
 {
   "id": 13889,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 20,
   "firman": "(40-15) ya, bukit-bukit mengeluarkan hasil baginya, di mana binatang-binatang liar bermain-main."
 },
 {
   "id": 13890,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 21,
   "firman": "(40-16) Di bawah tumbuhan teratai ia menderum, tersembunyi dalam gelagah dan paya."
 },
 {
   "id": 13891,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 22,
   "firman": "(40-17) Tumbuhan-tumbuhan teratai menaungi dia dengan bayang-bayangnya, pohon-pohon gandarusa mengelilinginya."
 },
 {
   "id": 13892,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 23,
   "firman": "(40-18) Sesungguhnya, biarpun sungai sangat kuat arusnya, ia tidak gentar; ia tetap tenang, biarpun sungai Yordan meluap melanda mulutnya."
 },
 {
   "id": 13893,
   "kitab": "Ayb",
   "pasal": 40,
   "ayat": 24,
   "firman": "(40-19) Dapatkah orang menangkap dia dari muka, mencocok hidungnya dengan keluan?\""
 },
 {
   "id": 13894,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 1,
   "firman": "(40-20) \"Dapatkah engkau menarik buaya dengan kail, atau mengimpit lidahnya dengan tali?"
 },
 {
   "id": 13895,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 2,
   "firman": "(40-21) Dapatkah engkau mengenakan tali rotan pada hidungnya, mencocok rahangnya dengan kaitan?"
 },
 {
   "id": 13896,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 3,
   "firman": "(40-22) Mungkinkah ia mengajukan banyak permohonan belas kasihan kepadamu, atau berbicara dengan lemah lembut kepadamu?"
 },
 {
   "id": 13897,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 4,
   "firman": "(40-23) Mungkinkah ia mengikat perjanjian dengan engkau, sehingga engkau mengambil dia menjadi hamba untuk selama-lamanya?"
 },
 {
   "id": 13898,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 5,
   "firman": "(40-24) Dapatkah engkau bermain-main dengan dia seperti dengan burung, dan mengikat dia untuk anak-anakmu perempuan?"
 },
 {
   "id": 13899,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 6,
   "firman": "(40-25) Mungkinkah kawan-kawan nelayan memperdagangkan dia, atau membagi-bagikan dia di antara pedagang-pedagang?"
 },
 {
   "id": 13900,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 7,
   "firman": "(40-26) Dapatkah engkau menusuki kulitnya dengan serampang, dan kepalanya dengan tempuling?"
 },
 {
   "id": 13901,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 8,
   "firman": "(40-27) Letakkan tanganmu ke atasnya! Ingatlah pertarungannya! --Engkau takkan melakukannya lagi!"
 },
 {
   "id": 13902,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 9,
   "firman": "(40-28) Sesungguhnya, harapanmu hampa! Baru saja melihat dia, orang sudah terbanting."
 },
 {
   "id": 13903,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 10,
   "firman": "(41-1) Orang yang nekatpun takkan berani membangkitkan marahnya. Siapakah yang dapat bertahan di hadapan Aku?"
 },
 {
   "id": 13904,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 11,
   "firman": "(41-2) Siapakah yang menghadapi Aku, yang Kubiarkan tetap selamat? Apa yang ada di seluruh kolong langit, adalah kepunyaan-Ku."
 },
 {
   "id": 13905,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 12,
   "firman": "(41-3) Aku tidak akan berdiam diri tentang anggota-anggota badannya, tentang keperkasaannya dan perawakannya yang tampan."
 },
 {
   "id": 13906,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 13,
   "firman": "(41-4) Siapakah dapat menyingkapkan pakaian luarnya? Baju zirahnya yang berlapis dua, siapakah dapat menembusnya?"
 },
 {
   "id": 13907,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 14,
   "firman": "(41-5) Siapa dapat membuka pintu moncongnya? Di sekeliling giginya ada kengerian."
 },
 {
   "id": 13908,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 15,
   "firman": "(41-6) Punggungnya adalah perisai-perisai yang bersusun, terlekat rapat seperti meterai."
 },
 {
   "id": 13909,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 16,
   "firman": "(41-7) Rapat hubungannya yang satu dengan yang lain, sehingga angin tidak dapat masuk;"
 },
 {
   "id": 13910,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 17,
   "firman": "(41-8) yang satu melekat pada yang lain, bertautan tak terceraikan lagi."
 },
 {
   "id": 13911,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 18,
   "firman": "(41-9) Bersinnya menyinarkan cahaya, matanya laksana merekahnya fajar."
 },
 {
   "id": 13912,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 19,
   "firman": "(41-10) Dari dalam mulutnya keluar suluh, dan berpancaran bunga api."
 },
 {
   "id": 13913,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 20,
   "firman": "(41-11) Dari dalam lubang hidungnya mengepul uap bagaikan dari dalam belanga yang mendidih dan menggelegak isinya."
 },
 {
   "id": 13914,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 21,
   "firman": "(41-12) Nafasnya menyalakan bara, dan nyala api keluar dari dalam mulutnya."
 },
 {
   "id": 13915,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 22,
   "firman": "(41-13) Di dalam tengkuknya ada kekuatan; ketakutan berlompatan di hadapannya."
 },
 {
   "id": 13916,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 23,
   "firman": "(41-14) Daging gelambirnya berlekatan, melekat padanya, tidak tergerak."
 },
 {
   "id": 13917,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 24,
   "firman": "(41-15) Hatinya keras seperti batu, keras seperti batu kilangan bawah."
 },
 {
   "id": 13918,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 25,
   "firman": "(41-16) Bila ia bangkit, maka semua yang berkuasa menjadi gentar, menjadi bingung karena ketakutan."
 },
 {
   "id": 13919,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 26,
   "firman": "(41-17) Bila ia diserang dengan pedang, ia tidak mempan, demikian juga dengan tombak, seligi atau lembing."
 },
 {
   "id": 13920,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 27,
   "firman": "(41-18) Besi dirasanya seperti jerami, tembaga seperti kayu lapuk."
 },
 {
   "id": 13921,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 28,
   "firman": "(41-19) Anak panah tidak dapat menghalau dia, batu umban seolah-olah berubah padanya menjadi jerami."
 },
 {
   "id": 13922,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 29,
   "firman": "(41-20) Gada dianggapnya jerami dan ia menertawakan desingan lembing."
 },
 {
   "id": 13923,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 30,
   "firman": "(41-21) Pada bagian bawahnya ada tembikar yang runcing; ia membujur di atas lumpur seperti pengeretan pengirik."
 },
 {
   "id": 13924,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 31,
   "firman": "(41-22) Lubuk dibuatnya berbual-bual seperti periuk, laut dijadikannya tempat memasak campuran rempah-rempah."
 },
 {
   "id": 13925,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 32,
   "firman": "(41-23) Ia meninggalkan jejak yang bercahaya, sehingga samudera raya disangka orang rambut putih."
 },
 {
   "id": 13926,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 33,
   "firman": "(41-24) Tidak ada taranya di atas bumi; itulah makhluk yang tidak mengenal takut."
 },
 {
   "id": 13927,
   "kitab": "Ayb",
   "pasal": 41,
   "ayat": 34,
   "firman": "(41-25) Segala yang tinggi takut kepadanya; ia adalah raja atas segala binatang yang ganas.\""
 },
 {
   "id": 13928,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 1,
   "firman": "Maka jawab Ayub kepada TUHAN:"
 },
 {
   "id": 13929,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 2,
   "firman": "\"Aku tahu, bahwa Engkau sanggup melakukan segala sesuatu, dan tidak ada rencana-Mu yang gagal."
 },
 {
   "id": 13930,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 3,
   "firman": "Firman-Mu: Siapakah dia yang menyelubungi keputusan tanpa pengetahuan? Itulah sebabnya, tanpa pengertian aku telah bercerita tentang hal-hal yang sangat ajaib bagiku dan yang tidak kuketahui."
 },
 {
   "id": 13931,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 4,
   "firman": "Firman-Mu: Dengarlah, maka Akulah yang akan berfirman; Aku akan menanyai engkau, supaya engkau memberitahu Aku."
 },
 {
   "id": 13932,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 5,
   "firman": "Hanya dari kata orang saja aku mendengar tentang Engkau, tetapi sekarang mataku sendiri memandang Engkau."
 },
 {
   "id": 13933,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 6,
   "firman": "Oleh sebab itu aku mencabut perkataanku dan dengan menyesal aku duduk dalam debu dan abu.\""
 },
 {
   "id": 13934,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 7,
   "firman": "Setelah TUHAN mengucapkan firman itu kepada Ayub, maka firman TUHAN kepada Elifas, orang Teman: \"Murka-Ku menyala terhadap engkau dan terhadap kedua sahabatmu, karena kamu tidak berkata benar tentang Aku seperti hamba-Ku Ayub."
 },
 {
   "id": 13935,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 8,
   "firman": "Oleh sebab itu, ambillah tujuh ekor lembu jantan dan tujuh ekor domba jantan dan pergilah kepada hamba-Ku Ayub, lalu persembahkanlah semuanya itu sebagai korban bakaran untuk dirimu, dan baiklah hamba-Ku Ayub meminta doa untuk kamu, karena hanya permintaannyalah yang akan Kuterima, supaya Aku tidak melakukan aniaya terhadap kamu, sebab kamu tidak berkata benar tentang Aku seperti hamba-Ku Ayub.\""
 },
 {
   "id": 13936,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 9,
   "firman": "Maka pergilah Elifas, orang Teman, Bildad, orang Suah, dan Zofar, orang Naama, lalu mereka melakukan seperti apa yang difirmankan TUHAN kepada mereka. Dan TUHAN menerima permintaan Ayub."
 },
 {
   "id": 13937,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 10,
   "firman": "Lalu TUHAN memulihkan keadaan Ayub, setelah ia meminta doa untuk sahabat-sahabatnya, dan TUHAN memberikan kepada Ayub dua kali lipat dari segala kepunyaannya dahulu."
 },
 {
   "id": 13938,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 11,
   "firman": "Kemudian datanglah kepadanya semua saudaranya laki-laki dan perempuan dan semua kenalannya yang lama, dan makan bersama-sama dengan dia di rumahnya. Mereka menyatakan turut berdukacita dan menghibur dia oleh karena segala malapetaka yang telah ditimpakan TUHAN kepadanya, dan mereka masing-masing memberi dia uang satu kesita dan sebuah cincin emas."
 },
 {
   "id": 13939,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 12,
   "firman": "TUHAN memberkati Ayub dalam hidupnya yang selanjutnya lebih dari pada dalam hidupnya yang dahulu; ia mendapat empat belas ribu ekor kambing domba, dan enam ribu unta, seribu pasang lembu, dan seribu ekor keledai betina."
 },
 {
   "id": 13940,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 13,
   "firman": "Ia juga mendapat tujuh orang anak laki-laki dan tiga orang anak perempuan;"
 },
 {
   "id": 13941,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 14,
   "firman": "dan anak perempuan yang pertama diberinya nama Yemima, yang kedua Kezia dan yang ketiga Kerenhapukh."
 },
 {
   "id": 13942,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 15,
   "firman": "Di seluruh negeri tidak terdapat perempuan yang secantik anak-anak Ayub, dan mereka diberi ayahnya milik pusaka di tengah-tengah saudara-saudaranya laki-laki."
 },
 {
   "id": 13943,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 16,
   "firman": "Sesudah itu Ayub masih hidup seratus empat puluh tahun lamanya; ia melihat anak-anaknya dan cucu-cucunya sampai keturunan yang keempat."
 },
 {
   "id": 13944,
   "kitab": "Ayb",
   "pasal": 42,
   "ayat": 17,
   "firman": "Maka matilah Ayub, tua dan lanjut umur."
 },
 {
   "id": 13945,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 1,
   "firman": "Berbahagialah orang yang tidak berjalan menurut nasihat orang fasik, yang tidak berdiri di jalan orang berdosa, dan yang tidak duduk dalam kumpulan pencemooh,"
 },
 {
   "id": 13946,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 2,
   "firman": "tetapi yang kesukaannya ialah Taurat TUHAN, dan yang merenungkan Taurat itu siang dan malam."
 },
 {
   "id": 13947,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 3,
   "firman": "Ia seperti pohon, yang ditanam di tepi aliran air, yang menghasilkan buahnya pada musimnya, dan yang tidak layu daunnya; apa saja yang diperbuatnya berhasil."
 },
 {
   "id": 13948,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 4,
   "firman": "Bukan demikian orang fasik: mereka seperti sekam yang ditiupkan angin."
 },
 {
   "id": 13949,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab itu orang fasik tidak akan tahan dalam penghakiman, begitu pula orang berdosa dalam perkumpulan orang benar;"
 },
 {
   "id": 13950,
   "kitab": "Mzm",
   "pasal": 1,
   "ayat": 6,
   "firman": "sebab TUHAN mengenal jalan orang benar, tetapi jalan orang fasik menuju kebinasaan."
 },
 {
   "id": 13951,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 1,
   "firman": "Mengapa rusuh bangsa-bangsa, mengapa suku-suku bangsa mereka-reka perkara yang sia-sia?"
 },
 {
   "id": 13952,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 2,
   "firman": "Raja-raja dunia bersiap-siap dan para pembesar bermufakat bersama-sama melawan TUHAN dan yang diurapi-Nya:"
 },
 {
   "id": 13953,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 3,
   "firman": "\"Marilah kita memutuskan belenggu-belenggu mereka dan membuang tali-tali mereka dari pada kita!\""
 },
 {
   "id": 13954,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 4,
   "firman": "Dia, yang bersemayam di sorga, tertawa; Tuhan mengolok-olok mereka."
 },
 {
   "id": 13955,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 5,
   "firman": "Maka berkatalah Ia kepada mereka dalam murka-Nya dan mengejutkan mereka dalam kehangatan amarah-Nya:"
 },
 {
   "id": 13956,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 6,
   "firman": "\"Akulah yang telah melantik raja-Ku di Sion, gunung-Ku yang kudus!\""
 },
 {
   "id": 13957,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 7,
   "firman": "Aku mau menceritakan tentang ketetapan TUHAN; Ia berkata kepadaku: \"Anak-Ku engkau! Engkau telah Kuperanakkan pada hari ini."
 },
 {
   "id": 13958,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 8,
   "firman": "Mintalah kepada-Ku, maka bangsa-bangsa akan Kuberikan kepadamu menjadi milik pusakamu, dan ujung bumi menjadi kepunyaanmu."
 },
 {
   "id": 13959,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 9,
   "firman": "Engkau akan meremukkan mereka dengan gada besi, memecahkan mereka seperti tembikar tukang periuk.\""
 },
 {
   "id": 13960,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 10,
   "firman": "Oleh sebab itu, hai raja-raja, bertindaklah bijaksana, terimalah pengajaran, hai para hakim dunia!"
 },
 {
   "id": 13961,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 11,
   "firman": "Beribadahlah kepada TUHAN dengan takut dan ciumlah kaki-Nya dengan gemetar,"
 },
 {
   "id": 13962,
   "kitab": "Mzm",
   "pasal": 2,
   "ayat": 12,
   "firman": "supaya Ia jangan murka dan kamu binasa di jalan, sebab mudah sekali murka-Nya menyala. Berbahagialah semua orang yang berlindung pada-Nya!"
 },
 {
   "id": 13963,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 1,
   "firman": "Mazmur Daud, ketika ia lari dari Absalom, anaknya. (3-2) Ya TUHAN, betapa banyaknya lawanku! Banyak orang yang bangkit menyerang aku;"
 },
 {
   "id": 13964,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 2,
   "firman": "(3-3) banyak orang yang berkata tentang aku: \"Baginya tidak ada pertolongan dari pada Allah.\" Sela"
 },
 {
   "id": 13965,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 3,
   "firman": "(3-4) Tetapi Engkau, TUHAN, adalah perisai yang melindungi aku, Engkaulah kemuliaanku dan yang mengangkat kepalaku."
 },
 {
   "id": 13966,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 4,
   "firman": "(3-5) Dengan nyaring aku berseru kepada TUHAN, dan Ia menjawab aku dari gunung-Nya yang kudus. Sela"
 },
 {
   "id": 13967,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 5,
   "firman": "(3-6) Aku membaringkan diri, lalu tidur; aku bangun, sebab TUHAN menopang aku!"
 },
 {
   "id": 13968,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 6,
   "firman": "(3-7) Aku tidak takut kepada puluhan ribu orang yang siap mengepung aku."
 },
 {
   "id": 13969,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 7,
   "firman": "(3-8) Bangkitlah, TUHAN, tolonglah aku, ya Allahku! Ya, Engkau telah memukul rahang semua musuhku, dan mematahkan gigi orang-orang fasik."
 },
 {
   "id": 13970,
   "kitab": "Mzm",
   "pasal": 3,
   "ayat": 8,
   "firman": "(3-9) Dari TUHAN datang pertolongan. Berkat-Mu atas umat-Mu! Sela"
 },
 {
   "id": 13971,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Mazmur Daud. (4-2) Apabila aku berseru, jawablah aku, ya Allah, yang membenarkan aku. Di dalam kesesakan Engkau memberi kelegaan kepadaku. Kasihanilah aku dan dengarkanlah doaku!"
 },
 {
   "id": 13972,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 2,
   "firman": "(4-3) Hai orang-orang, berapa lama lagi kemuliaanku dinodai, berapa lama lagi kamu mencintai yang sia-sia dan mencari kebohongan? Sela"
 },
 {
   "id": 13973,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 3,
   "firman": "(4-4) Ketahuilah, bahwa TUHAN telah memilih bagi-Nya seorang yang dikasihi-Nya; TUHAN mendengarkan, apabila aku berseru kepada-Nya."
 },
 {
   "id": 13974,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 4,
   "firman": "(4-5) Biarlah kamu marah, tetapi jangan berbuat dosa; berkata-katalah dalam hatimu di tempat tidurmu, tetapi tetaplah diam. Sela"
 },
 {
   "id": 13975,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 5,
   "firman": "(4-6) Persembahkanlah korban yang benar dan percayalah kepada TUHAN."
 },
 {
   "id": 13976,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 6,
   "firman": "(4-7) Banyak orang berkata: \"Siapa yang akan memperlihatkan yang baik kepada kita?\" Biarlah cahaya wajah-Mu menyinari kami, ya TUHAN!"
 },
 {
   "id": 13977,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 7,
   "firman": "(4-8) Engkau telah memberikan sukacita kepadaku, lebih banyak dari pada mereka ketika mereka kelimpahan gandum dan anggur."
 },
 {
   "id": 13978,
   "kitab": "Mzm",
   "pasal": 4,
   "ayat": 8,
   "firman": "(4-9) Dengan tenteram aku mau membaringkan diri, lalu segera tidur, sebab hanya Engkaulah, ya TUHAN, yang membiarkan aku diam dengan aman."
 },
 {
   "id": 13979,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan suling. Mazmur Daud. (5-2) Berilah telinga kepada perkataanku, ya TUHAN, indahkanlah keluh kesahku."
 },
 {
   "id": 13980,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 2,
   "firman": "(5-3) Perhatikanlah teriakku minta tolong, ya Rajaku dan Allahku, sebab kepada-Mulah aku berdoa."
 },
 {
   "id": 13981,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 3,
   "firman": "(5-4) TUHAN, pada waktu pagi Engkau mendengar seruanku, pada waktu pagi aku mengatur persembahan bagi-Mu, dan aku menunggu-nunggu."
 },
 {
   "id": 13982,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 4,
   "firman": "(5-5) Sebab Engkau bukanlah Allah yang berkenan kepada kefasikan; orang jahat takkan menumpang pada-Mu."
 },
 {
   "id": 13983,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 5,
   "firman": "(5-6) Pembual tidak akan tahan di depan mata-Mu; Engkau membenci semua orang yang melakukan kejahatan."
 },
 {
   "id": 13984,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 6,
   "firman": "(5-7) Engkau membinasakan orang-orang yang berkata bohong, TUHAN jijik melihat penumpah darah dan penipu."
 },
 {
   "id": 13985,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 7,
   "firman": "(5-8) Tetapi aku, berkat kasih setia-Mu yang besar, aku akan masuk ke dalam rumah-Mu, sujud menyembah ke arah bait-Mu yang kudus dengan takut akan Engkau."
 },
 {
   "id": 13986,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 8,
   "firman": "(5-9) TUHAN, tuntunlah aku dalam keadilan-Mu karena seteruku; ratakanlah jalan-Mu di depanku."
 },
 {
   "id": 13987,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 9,
   "firman": "(5-10) Sebab perkataan mereka tidak ada yang jujur, batin mereka penuh kebusukan, kerongkongan mereka seperti kubur ternganga, lidah mereka merayu-rayu."
 },
 {
   "id": 13988,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 10,
   "firman": "(5-11) Biarlah mereka menanggung kesalahan mereka, ya Allah, biarlah mereka jatuh karena rancangannya sendiri; buanglah mereka karena banyaknya pelanggaran mereka, sebab mereka memberontak terhadap Engkau."
 },
 {
   "id": 13989,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 11,
   "firman": "(5-12) Tetapi semua orang yang berlindung pada-Mu akan bersukacita, mereka akan bersorak-sorai selama-lamanya, karena Engkau menaungi mereka; dan karena Engkau akan bersukaria orang-orang yang mengasihi nama-Mu."
 },
 {
   "id": 13990,
   "kitab": "Mzm",
   "pasal": 5,
   "ayat": 12,
   "firman": "(5-13) Sebab Engkaulah yang memberkati orang benar, ya TUHAN; Engkau memagari dia dengan anugerah-Mu seperti perisai."
 },
 {
   "id": 13991,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Menurut lagu: Yang kedelapan. Mazmur Daud. (6-2) Ya TUHAN, janganlah menghukum aku dalam murka-Mu, dan janganlah menghajar aku dalam kepanasan amarah-Mu."
 },
 {
   "id": 13992,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 2,
   "firman": "(6-3) Kasihanilah aku, TUHAN, sebab aku merana; sembuhkanlah aku, TUHAN, sebab tulang-tulangku gemetar,"
 },
 {
   "id": 13993,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 3,
   "firman": "(6-4) dan jiwakupun sangat terkejut; tetapi Engkau, TUHAN, berapa lama lagi?"
 },
 {
   "id": 13994,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 4,
   "firman": "(6-5) Kembalilah pula, TUHAN, luputkanlah jiwaku, selamatkanlah aku oleh karena kasih setia-Mu."
 },
 {
   "id": 13995,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 5,
   "firman": "(6-6) Sebab di dalam maut tidaklah orang ingat kepada-Mu; siapakah yang akan bersyukur kepada-Mu di dalam dunia orang mati?"
 },
 {
   "id": 13996,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 6,
   "firman": "(6-7) Lesu aku karena mengeluh; setiap malam aku menggenangi tempat tidurku, dengan air mataku aku membanjiri ranjangku."
 },
 {
   "id": 13997,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 7,
   "firman": "(6-8) Mataku mengidap karena sakit hati, rabun karena semua lawanku."
 },
 {
   "id": 13998,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 8,
   "firman": "(6-9) Menjauhlah dari padaku, kamu sekalian yang melakukan kejahatan, sebab TUHAN telah mendengar tangisku;"
 },
 {
   "id": 13999,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 9,
   "firman": "(6-10) TUHAN telah mendengar permohonanku, TUHAN menerima doaku."
 },
 {
   "id": 14000,
   "kitab": "Mzm",
   "pasal": 6,
   "ayat": 10,
   "firman": "(6-11) Semua musuhku mendapat malu dan sangat terkejut; mereka mundur dan mendapat malu dalam sekejap mata."
 },
 {
   "id": 14001,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 1,
   "firman": "Nyanyian ratapan Daud, yang dinyanyikan untuk TUHAN karena Kush, orang Benyamin itu. (7-2) Ya TUHAN, Allahku, pada-Mu aku berlindung; selamatkanlah aku dari semua orang yang mengejar aku dan lepaskanlah aku,"
 },
 {
   "id": 14002,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 2,
   "firman": "(7-3) supaya jangan mereka seperti singa menerkam aku dan menyeret aku, dengan tidak ada yang melepaskan."
 },
 {
   "id": 14003,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 3,
   "firman": "(7-4) Ya TUHAN, Allahku, jika aku berbuat ini: jika ada kecurangan di tanganku,"
 },
 {
   "id": 14004,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 4,
   "firman": "(7-5) jika aku melakukan yang jahat terhadap orang yang hidup damai dengan aku, atau merugikan orang yang melawan aku dengan tidak ada alasannya,"
 },
 {
   "id": 14005,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 5,
   "firman": "(7-6) maka musuh kiranya mengejar aku sampai menangkap aku, dan menginjak-injak hidupku ke tanah, dan menaruh kemuliaanku ke dalam debu. Sela"
 },
 {
   "id": 14006,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 6,
   "firman": "(7-7) Bangkitlah, TUHAN, dalam murka-Mu, berdirilah menghadapi geram orang-orang yang melawan aku, bangunlah untukku, ya Engkau yang telah memerintahkan penghakiman!"
 },
 {
   "id": 14007,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 7,
   "firman": "(7-8) Biarlah bangsa-bangsa berkumpul mengelilingi Engkau, dan bertakhtalah di atas mereka di tempat yang tinggi."
 },
 {
   "id": 14008,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 8,
   "firman": "(7-9) TUHAN mengadili bangsa-bangsa. Hakimilah aku, TUHAN, apakah aku benar, dan apakah aku tulus ikhlas."
 },
 {
   "id": 14009,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 9,
   "firman": "(7-10) Biarlah berakhir kejahatan orang fasik, tetapi teguhkanlah orang yang benar, Engkau, yang menguji hati dan batin orang, ya Allah yang adil."
 },
 {
   "id": 14010,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 10,
   "firman": "(7-11) Perisai bagiku adalah Allah, yang menyelamatkan orang-orang yang tulus hati;"
 },
 {
   "id": 14011,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 11,
   "firman": "(7-12) Allah adalah Hakim yang adil dan Allah yang murka setiap saat."
 },
 {
   "id": 14012,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 12,
   "firman": "(7-13) Sungguh, kembali ia mengasah pedangnya, melentur busurnya dan membidik."
 },
 {
   "id": 14013,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 13,
   "firman": "(7-14) Terhadap dirinya ia mempersiapkan senjata-senjata yang mematikan, dan membuat anak panahnya menjadi menyala."
 },
 {
   "id": 14014,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 14,
   "firman": "(7-15) Sesungguhnya, orang itu hamil dengan kejahatan, ia mengandung kelaliman dan melahirkan dusta."
 },
 {
   "id": 14015,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 15,
   "firman": "(7-16) Ia membuat lobang dan menggalinya, tetapi ia sendiri jatuh ke dalam pelubang yang dibuatnya."
 },
 {
   "id": 14016,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 16,
   "firman": "(7-17) Kelaliman yang dilakukannya kembali menimpa kepalanya, dan kekerasannya turun menimpa batu kepalanya."
 },
 {
   "id": 14017,
   "kitab": "Mzm",
   "pasal": 7,
   "ayat": 17,
   "firman": "(7-18) Aku hendak bersyukur kepada TUHAN karena keadilan-Nya, dan bermazmur bagi nama TUHAN, Yang Mahatinggi."
 },
 {
   "id": 14018,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Gitit. Mazmur Daud. (8-2) Ya TUHAN, Tuhan kami, betapa mulianya nama-Mu di seluruh bumi! Keagungan-Mu yang mengatasi langit dinyanyikan."
 },
 {
   "id": 14019,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 2,
   "firman": "(8-3) Dari mulut bayi-bayi dan anak-anak yang menyusu telah Kauletakkan dasar kekuatan karena lawan-Mu, untuk membungkamkan musuh dan pendendam."
 },
 {
   "id": 14020,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 3,
   "firman": "(8-4) Jika aku melihat langit-Mu, buatan jari-Mu, bulan dan bintang-bintang yang Kautempatkan:"
 },
 {
   "id": 14021,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 4,
   "firman": "(8-5) apakah manusia, sehingga Engkau mengingatnya? Apakah anak manusia, sehingga Engkau mengindahkannya?"
 },
 {
   "id": 14022,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 5,
   "firman": "(8-6) Namun Engkau telah membuatnya hampir sama seperti Allah, dan telah memahkotainya dengan kemuliaan dan hormat."
 },
 {
   "id": 14023,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 6,
   "firman": "(8-7) Engkau membuat dia berkuasa atas buatan tangan-Mu; segala-galanya telah Kauletakkan di bawah kakinya:"
 },
 {
   "id": 14024,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 7,
   "firman": "(8-8) kambing domba dan lembu sapi sekalian, juga binatang-binatang di padang;"
 },
 {
   "id": 14025,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 8,
   "firman": "(8-9) burung-burung di udara dan ikan-ikan di laut, dan apa yang melintasi arus lautan."
 },
 {
   "id": 14026,
   "kitab": "Mzm",
   "pasal": 8,
   "ayat": 9,
   "firman": "(8-10) Ya TUHAN, Tuhan kami, betapa mulianya nama-Mu di seluruh bumi!"
 },
 {
   "id": 14027,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Mut-Laben. Mazmur Daud. (9-2) Aku mau bersyukur kepada TUHAN dengan segenap hatiku, aku mau menceritakan segala perbuatan-Mu yang ajaib;"
 },
 {
   "id": 14028,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 2,
   "firman": "(9-3) aku mau bersukacita dan bersukaria karena Engkau, bermazmur bagi nama-Mu, ya Mahatinggi,"
 },
 {
   "id": 14029,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 3,
   "firman": "(9-4) sebab musuhku mundur, tersandung jatuh dan binasa di hadapan-Mu."
 },
 {
   "id": 14030,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 4,
   "firman": "(9-5) Sebab Engkau membela perkaraku dan hakku, sebagai Hakim yang adil Engkau duduk di atas takhta."
 },
 {
   "id": 14031,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 5,
   "firman": "(9-6) Engkau telah menghardik bangsa-bangsa, telah membinasakan orang-orang fasik; nama mereka telah Kauhapuskan untuk seterusnya dan selama-lamanya;"
 },
 {
   "id": 14032,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 6,
   "firman": "(9-7) musuh telah habis binasa, menjadi timbunan puing senantiasa: kota-kota telah Kauruntuhkan; lenyaplah ingatan kepadanya."
 },
 {
   "id": 14033,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 7,
   "firman": "(9-8) Tetapi TUHAN bersemayam untuk selama-lamanya, takhta-Nya didirikan-Nya untuk menjalankan penghakiman."
 },
 {
   "id": 14034,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 8,
   "firman": "(9-9) Dialah yang menghakimi dunia dengan keadilan dan mengadili bangsa-bangsa dengan kebenaran."
 },
 {
   "id": 14035,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 9,
   "firman": "(9-10) Demikianlah TUHAN adalah tempat perlindungan bagi orang yang terinjak, tempat perlindungan pada waktu kesesakan."
 },
 {
   "id": 14036,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 10,
   "firman": "(9-11) Orang yang mengenal nama-Mu percaya kepada-Mu, sebab tidak Kautinggalkan orang yang mencari Engkau, ya TUHAN."
 },
 {
   "id": 14037,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 11,
   "firman": "(9-12) Bermazmurlah bagi TUHAN, yang bersemayam di Sion, beritakanlah perbuatan-Nya di antara bangsa-bangsa,"
 },
 {
   "id": 14038,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 12,
   "firman": "(9-13) sebab Dia, yang membalas penumpahan darah, ingat kepada orang yang tertindas; teriak mereka tidaklah dilupakan-Nya."
 },
 {
   "id": 14039,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 13,
   "firman": "(9-14) Kasihanilah aku, ya TUHAN; lihatlah sengsaraku, disebabkan oleh orang-orang yang membenci aku, ya Engkau, yang mengangkat aku dari pintu gerbang maut,"
 },
 {
   "id": 14040,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 14,
   "firman": "(9-15) supaya aku menceritakan segala perbuatan-Mu yang terpuji dan bersorak-sorak di pintu gerbang puteri Sion karena keselamatan yang dari pada-Mu."
 },
 {
   "id": 14041,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 15,
   "firman": "(9-16) Bangsa-bangsa terbenam dalam pelubang yang dibuatnya, kakinya tertangkap dalam jaring yang dipasangnya sendiri."
 },
 {
   "id": 14042,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 16,
   "firman": "(9-17) TUHAN telah memperkenalkan diri-Nya, Ia menjalankan penghakiman; orang fasik terjerat dalam perbuatan tangannya sendiri. Higayon. Sela"
 },
 {
   "id": 14043,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 17,
   "firman": "(9-18) Orang-orang fasik akan kembali ke dunia orang mati, ya, segala bangsa yang melupakan Allah."
 },
 {
   "id": 14044,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 18,
   "firman": "(9-19) Sebab bukan untuk seterusnya orang miskin dilupakan, bukan untuk selamanya hilang harapan orang sengsara."
 },
 {
   "id": 14045,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 19,
   "firman": "(9-20) Bangkitlah, TUHAN, janganlah manusia merajalela; biarlah bangsa-bangsa dihakimi di hadapan-Mu!"
 },
 {
   "id": 14046,
   "kitab": "Mzm",
   "pasal": 9,
   "ayat": 20,
   "firman": "(9-21) Biarlah mereka menjadi takut, ya TUHAN, sehingga bangsa-bangsa itu mengakui, bahwa mereka manusia saja. Sela"
 },
 {
   "id": 14047,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 1,
   "firman": "Mengapa Engkau berdiri jauh-jauh, ya TUHAN, dan menyembunyikan diri-Mu dalam waktu-waktu kesesakan?"
 },
 {
   "id": 14048,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 2,
   "firman": "Karena congkak orang fasik giat memburu orang yang tertindas; mereka terjebak dalam tipu daya yang mereka rancangkan."
 },
 {
   "id": 14049,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 3,
   "firman": "Karena orang fasik memuji-muji keinginan hatinya, dan orang yang loba mengutuki dan menista TUHAN."
 },
 {
   "id": 14050,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 4,
   "firman": "Kata orang fasik itu dengan batang hidungnya ke atas: \"Allah tidak akan menuntut! Tidak ada Allah!\", itulah seluruh pikirannya."
 },
 {
   "id": 14051,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 5,
   "firman": "Tindakan-tindakannya selalu berhasil; hukum-hukum-Mu tinggi sekali, jauh dari dia; ia menganggap remeh semua lawannya."
 },
 {
   "id": 14052,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 6,
   "firman": "Ia berkata dalam hatinya: \"Aku takkan goyang. Aku tidak akan ditimpa malapetaka turun-temurun.\""
 },
 {
   "id": 14053,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 7,
   "firman": "Mulutnya penuh dengan sumpah serapah, dengan tipu dan penindasan; di lidahnya ada kelaliman dan kejahatan."
 },
 {
   "id": 14054,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 8,
   "firman": "Ia duduk menghadang di gubuk-gubuk, di tempat yang tersembunyi ia membunuh orang yang tak bersalah. Matanya mengintip orang yang lemah;"
 },
 {
   "id": 14055,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 9,
   "firman": "ia mengendap di tempat yang tersembunyi seperti singa di dalam semak-semak; ia mengendap untuk menangkap orang yang tertindas. Ia menangkap orang yang tertindas itu dengan menariknya ke dalam jaringnya."
 },
 {
   "id": 14056,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 10,
   "firman": "Ia membungkuk, dan meniarap, lalu orang-orang lemah jatuh ke dalam cakarnya yang kuat."
 },
 {
   "id": 14057,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 11,
   "firman": "Ia berkata dalam hatinya: \"Allah melupakannya; Ia menyembunyikan wajah-Nya, dan tidak akan melihatnya untuk seterusnya.\""
 },
 {
   "id": 14058,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 12,
   "firman": "Bangkitlah, TUHAN! Ya Allah, ulurkanlah tangan-Mu, janganlah lupakan orang-orang yang tertindas."
 },
 {
   "id": 14059,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 13,
   "firman": "Mengapa orang fasik menista Allah, sambil berkata dalam hatinya: \"Engkau tidak menuntut?\""
 },
 {
   "id": 14060,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 14,
   "firman": "Engkau memang melihatnya, sebab Engkaulah yang melihat kesusahan dan sakit hati, supaya Engkau mengambilnya ke dalam tangan-Mu sendiri. Kepada-Mulah orang lemah menyerahkan diri; untuk anak yatim Engkau menjadi penolong."
 },
 {
   "id": 14061,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 15,
   "firman": "Patahkanlah lengan orang fasik dan orang jahat, tuntutlah kefasikannya, sampai Engkau tidak menemuinya lagi."
 },
 {
   "id": 14062,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 16,
   "firman": "TUHAN adalah Raja untuk seterusnya dan selama-lamanya. Bangsa-bangsa lenyap dari tanah-Nya."
 },
 {
   "id": 14063,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 17,
   "firman": "Keinginan orang-orang yang tertindas telah Kaudengarkan, ya TUHAN; Engkau menguatkan hati mereka, Engkau memasang telinga-Mu,"
 },
 {
   "id": 14064,
   "kitab": "Mzm",
   "pasal": 10,
   "ayat": 18,
   "firman": "untuk memberi keadilan kepada anak yatim dan orang yang terinjak; supaya tidak ada lagi seorang manusia di bumi yang berani menakut-nakuti."
 },
 {
   "id": 14065,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari Daud. Pada TUHAN aku berlindung, bagaimana kamu berani berkata kepadaku: \"Terbanglah ke gunung seperti burung!\""
 },
 {
   "id": 14066,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 2,
   "firman": "Sebab, lihat orang fasik melentur busurnya, mereka memasang anak panahnya pada tali busur, untuk memanah orang yang tulus hati di tempat gelap."
 },
 {
   "id": 14067,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 3,
   "firman": "Apabila dasar-dasar dihancurkan, apakah yang dapat dibuat oleh orang benar itu?"
 },
 {
   "id": 14068,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 4,
   "firman": "TUHAN ada di dalam bait-Nya yang kudus; TUHAN, takhta-Nya di sorga; mata-Nya mengamat-amati, sorot mata-Nya menguji anak-anak manusia."
 },
 {
   "id": 14069,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 5,
   "firman": "TUHAN menguji orang benar dan orang fasik, dan Ia membenci orang yang mencintai kekerasan."
 },
 {
   "id": 14070,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 6,
   "firman": "Ia menghujani orang-orang fasik dengan arang berapi dan belerang; angin yang menghanguskan, itulah isi piala mereka."
 },
 {
   "id": 14071,
   "kitab": "Mzm",
   "pasal": 11,
   "ayat": 7,
   "firman": "Sebab TUHAN adalah adil dan Ia mengasihi keadilan; orang yang tulus akan memandang wajah-Nya."
 },
 {
   "id": 14072,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Yang kedelapan. Mazmur Daud. (12-2) Tolonglah kiranya, TUHAN, sebab orang saleh telah habis, telah lenyap orang-orang yang setia dari antara anak-anak manusia."
 },
 {
   "id": 14073,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 2,
   "firman": "(12-3) Mereka berkata dusta, yang seorang kepada yang lain, mereka berkata dengan bibir yang manis dan hati yang bercabang."
 },
 {
   "id": 14074,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 3,
   "firman": "(12-4) Biarlah TUHAN mengerat segala bibir yang manis dan setiap lidah yang bercakap besar,"
 },
 {
   "id": 14075,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 4,
   "firman": "(12-5) dari mereka yang berkata: \"Dengan lidah kami, kami menang! Bibir kami menyokong kami! Siapakah tuan atas kami?\""
 },
 {
   "id": 14076,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 5,
   "firman": "(12-6) Oleh karena penindasan terhadap orang-orang yang lemah, oleh karena keluhan orang-orang miskin, sekarang juga Aku bangkit, firman TUHAN; Aku memberi keselamatan kepada orang yang menghauskannya."
 },
 {
   "id": 14077,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 6,
   "firman": "(12-7) Janji TUHAN adalah janji yang murni, bagaikan perak yang teruji, tujuh kali dimurnikan dalam dapur peleburan di tanah."
 },
 {
   "id": 14078,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 7,
   "firman": "(12-8) Engkau, TUHAN, yang akan menepatinya, Engkau akan menjaga kami senantiasa terhadap angkatan ini."
 },
 {
   "id": 14079,
   "kitab": "Mzm",
   "pasal": 12,
   "ayat": 8,
   "firman": "(12-9) Orang-orang fasik berjalan ke mana-mana, sementara kebusukan muncul di antara anak-anak manusia."
 },
 {
   "id": 14080,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (13-2) Berapa lama lagi, TUHAN, Kaulupakan aku terus-menerus? Berapa lama lagi Kausembunyikan wajah-Mu terhadap aku?"
 },
 {
   "id": 14081,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 2,
   "firman": "(13-3) Berapa lama lagi aku harus menaruh kekuatiran dalam diriku, dan bersedih hati sepanjang hari? Berapa lama lagi musuhku meninggikan diri atasku?"
 },
 {
   "id": 14082,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 3,
   "firman": "(13-4) Pandanglah kiranya, jawablah aku, ya TUHAN, Allahku! Buatlah mataku bercahaya, supaya jangan aku tertidur dan mati,"
 },
 {
   "id": 14083,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 4,
   "firman": "(13-5) supaya musuhku jangan berkata: \"Aku telah mengalahkan dia,\" dan lawan-lawanku bersorak-sorak, apabila aku goyah."
 },
 {
   "id": 14084,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 5,
   "firman": "(13-6a) Tetapi aku, kepada kasih setia-Mu aku percaya, hatiku bersorak-sorak karena penyelamatan-Mu."
 },
 {
   "id": 14085,
   "kitab": "Mzm",
   "pasal": 13,
   "ayat": 6,
   "firman": "(13-6b) Aku mau menyanyi untuk TUHAN, karena Ia telah berbuat baik kepadaku."
 },
 {
   "id": 14086,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari Daud. Orang bebal berkata dalam hatinya: \"Tidak ada Allah.\" Busuk dan jijik perbuatan mereka, tidak ada yang berbuat baik."
 },
 {
   "id": 14087,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 2,
   "firman": "TUHAN memandang ke bawah dari sorga kepada anak-anak manusia untuk melihat, apakah ada yang berakal budi dan yang mencari Allah."
 },
 {
   "id": 14088,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 3,
   "firman": "Mereka semua telah menyeleweng, semuanya telah bejat; tidak ada yang berbuat baik, seorangpun tidak."
 },
 {
   "id": 14089,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 4,
   "firman": "Tidak sadarkah semua orang yang melakukan kejahatan, yang memakan habis umat-Ku seperti memakan roti, dan yang tidak berseru kepada TUHAN?"
 },
 {
   "id": 14090,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 5,
   "firman": "Di sanalah mereka ditimpa kekejutan yang besar, sebab Allah menyertai angkatan yang benar."
 },
 {
   "id": 14091,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 6,
   "firman": "Kamu dapat mengolok-olok maksud orang yang tertindas, tetapi TUHAN adalah tempat perlindungannya."
 },
 {
   "id": 14092,
   "kitab": "Mzm",
   "pasal": 14,
   "ayat": 7,
   "firman": "Ya, datanglah kiranya dari Sion keselamatan bagi Israel! Apabila TUHAN memulihkan keadaan umat-Nya, maka Yakub akan bersorak-sorak, Israel akan bersukacita."
 },
 {
   "id": 14093,
   "kitab": "Mzm",
   "pasal": 15,
   "ayat": 1,
   "firman": "Mazmur Daud. TUHAN, siapa yang boleh menumpang dalam kemah-Mu? Siapa yang boleh diam di gunung-Mu yang kudus?"
 },
 {
   "id": 14094,
   "kitab": "Mzm",
   "pasal": 15,
   "ayat": 2,
   "firman": "Yaitu dia yang berlaku tidak bercela, yang melakukan apa yang adil dan yang mengatakan kebenaran dengan segenap hatinya,"
 },
 {
   "id": 14095,
   "kitab": "Mzm",
   "pasal": 15,
   "ayat": 3,
   "firman": "yang tidak menyebarkan fitnah dengan lidahnya, yang tidak berbuat jahat terhadap temannya dan yang tidak menimpakan cela kepada tetangganya;"
 },
 {
   "id": 14096,
   "kitab": "Mzm",
   "pasal": 15,
   "ayat": 4,
   "firman": "yang memandang hina orang yang tersingkir, tetapi memuliakan orang yang takut akan TUHAN; yang berpegang pada sumpah, walaupun rugi;"
 },
 {
   "id": 14097,
   "kitab": "Mzm",
   "pasal": 15,
   "ayat": 5,
   "firman": "yang tidak meminjamkan uangnya dengan makan riba dan tidak menerima suap melawan orang yang tak bersalah. Siapa yang berlaku demikian, tidak akan goyah selama-lamanya."
 },
 {
   "id": 14098,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 1,
   "firman": "Miktam. Dari Daud. Jagalah aku, ya Allah, sebab pada-Mu aku berlindung."
 },
 {
   "id": 14099,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 2,
   "firman": "Aku berkata kepada TUHAN: \"Engkaulah Tuhanku, tidak ada yang baik bagiku selain Engkau!\""
 },
 {
   "id": 14100,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 3,
   "firman": "Orang-orang kudus yang ada di tanah ini, merekalah orang mulia yang selalu menjadi kesukaanku."
 },
 {
   "id": 14101,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 4,
   "firman": "Bertambah besar kesedihan orang-orang yang mengikuti allah lain; aku tidak akan ikut mempersembahkan korban curahan mereka yang dari darah, juga tidak akan menyebut-nyebut nama mereka di bibirku."
 },
 {
   "id": 14102,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 5,
   "firman": "Ya TUHAN, Engkaulah bagian warisanku dan pialaku, Engkau sendirilah yang meneguhkan bagian yang diundikan kepadaku."
 },
 {
   "id": 14103,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 6,
   "firman": "Tali pengukur jatuh bagiku di tempat-tempat yang permai; ya, milik pusakaku menyenangkan hatiku."
 },
 {
   "id": 14104,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 7,
   "firman": "Aku memuji TUHAN, yang telah memberi nasihat kepadaku, ya, pada waktu malam hati nuraniku mengajari aku."
 },
 {
   "id": 14105,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 8,
   "firman": "Aku senantiasa memandang kepada TUHAN; karena Ia berdiri di sebelah kananku, aku tidak goyah."
 },
 {
   "id": 14106,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 9,
   "firman": "Sebab itu hatiku bersukacita dan jiwaku bersorak-sorak, bahkan tubuhku akan diam dengan tenteram;"
 },
 {
   "id": 14107,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 10,
   "firman": "sebab Engkau tidak menyerahkan aku ke dunia orang mati, dan tidak membiarkan Orang Kudus-Mu melihat kebinasaan."
 },
 {
   "id": 14108,
   "kitab": "Mzm",
   "pasal": 16,
   "ayat": 11,
   "firman": "Engkau memberitahukan kepadaku jalan kehidupan; di hadapan-Mu ada sukacita berlimpah-limpah, di tangan kanan-Mu ada nikmat senantiasa."
 },
 {
   "id": 14109,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 1,
   "firman": "Doa Daud. Dengarkanlah, TUHAN, perkara yang benar, perhatikanlah seruanku; berilah telinga akan doaku, dari bibir yang tidak menipu."
 },
 {
   "id": 14110,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 2,
   "firman": "Dari pada-Mulah kiranya datang penghakiman: mata-Mu kiranya melihat apa yang benar."
 },
 {
   "id": 14111,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 3,
   "firman": "Bila Engkau menguji hatiku, memeriksanya pada waktu malam, dan menyelidiki aku, maka Engkau tidak akan menemui sesuatu kejahatan; mulutku tidak terlanjur."
 },
 {
   "id": 14112,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 4,
   "firman": "Tentang perbuatan manusia, sesuai dengan firman yang Engkau ucapkan, aku telah menjaga diriku terhadap jalan orang-orang yang melakukan kekerasan;"
 },
 {
   "id": 14113,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 5,
   "firman": "langkahku tetap mengikuti jejak-Mu, kakiku tidak goyang."
 },
 {
   "id": 14114,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 6,
   "firman": "Aku berseru kepada-Mu, karena Engkau menjawab aku, ya Allah; sendengkanlah telinga-Mu kepadaku, dengarkanlah perkataanku."
 },
 {
   "id": 14115,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 7,
   "firman": "Tunjukkanlah kasih setia-Mu yang ajaib, ya Engkau, yang menyelamatkan orang-orang yang berlindung pada tangan kanan-Mu terhadap pemberontak."
 },
 {
   "id": 14116,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 8,
   "firman": "Peliharalah aku seperti biji mata, sembunyikanlah aku dalam naungan sayap-Mu"
 },
 {
   "id": 14117,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 9,
   "firman": "terhadap orang-orang fasik yang menggagahi aku, terhadap musuh nyawaku yang mengepung aku."
 },
 {
   "id": 14118,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 10,
   "firman": "Mereka tidak menunjukkan belas kasihan, mereka membual;"
 },
 {
   "id": 14119,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 11,
   "firman": "mereka mengikuti langkah-langkahku, mereka sekarang mengerumuni aku, mata mereka diarahkan untuk menghempaskan aku ke bumi."
 },
 {
   "id": 14120,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 12,
   "firman": "Rupa mereka seperti singa, yang bernafsu untuk menerkam, seperti singa muda, yang mengendap di tempat yang tersembunyi."
 },
 {
   "id": 14121,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 13,
   "firman": "Bangunlah, TUHAN, hadapilah mereka, rebahkanlah mereka, luputkanlah aku dengan pedang-Mu dari pada orang fasik."
 },
 {
   "id": 14122,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 14,
   "firman": "Luputkanlah aku, ya TUHAN, dengan tangan-Mu, dari orang-orang dunia ini yang bagiannya adalah dalam hidup ini; biarlah perut mereka dikenyangkan dengan apa yang Engkau simpan, sehingga anak-anak mereka menjadi puas, dan sisanya mereka tinggalkan untuk bayi-bayi mereka."
 },
 {
   "id": 14123,
   "kitab": "Mzm",
   "pasal": 17,
   "ayat": 15,
   "firman": "Tetapi aku, dalam kebenaran akan kupandang wajah-Mu, dan pada waktu bangun aku akan menjadi puas dengan rupa-Mu."
 },
 {
   "id": 14124,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari hamba TUHAN, yakni Daud yang menyampaikan perkataan nyanyian ini kepada TUHAN, pada waktu TUHAN telah melepaskan dia dari cengkeraman semua musuhnya dan dari tangan Saul. (18:2) Ia berkata: \"Aku mengasihi Engkau, ya TUHAN, kekuatanku!"
 },
 {
   "id": 14125,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 2,
   "firman": "(18-3) Ya TUHAN, bukit batuku, kubu pertahananku dan penyelamatku, Allahku, gunung batuku, tempat aku berlindung, perisaiku, tanduk keselamatanku, kota bentengku!"
 },
 {
   "id": 14126,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 3,
   "firman": "(18-4) Terpujilah TUHAN, seruku; maka akupun selamat dari pada musuhku."
 },
 {
   "id": 14127,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 4,
   "firman": "(18-5) Tali-tali maut telah meliliti aku, dan banjir-banjir jahanam telah menimpa aku,"
 },
 {
   "id": 14128,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 5,
   "firman": "(18-6) tali-tali dunia orang mati telah membelit aku, perangkap-perangkap maut terpasang di depanku."
 },
 {
   "id": 14129,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 6,
   "firman": "(18-7) Ketika aku dalam kesesakan, aku berseru kepada TUHAN, kepada Allahku aku berteriak minta tolong. Ia mendengar suaraku dari bait-Nya, teriakku minta tolong kepada-Nya sampai ke telinga-Nya."
 },
 {
   "id": 14130,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 7,
   "firman": "(18-8) Lalu goyang dan goncanglah bumi, dan dasar-dasar gunung gemetar dan goyang, oleh karena menyala-nyala murka-Nya."
 },
 {
   "id": 14131,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 8,
   "firman": "(18-9) Asap membubung dari hidung-Nya, api menjilat keluar dari mulut-Nya, bara menyala keluar dari pada-Nya."
 },
 {
   "id": 14132,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 9,
   "firman": "(18-10) Ia menekukkan langit, lalu turun, kekelaman ada di bawah kaki-Nya."
 },
 {
   "id": 14133,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 10,
   "firman": "(18-11) Ia mengendarai kerub, lalu terbang dan melayang di atas sayap angin."
 },
 {
   "id": 14134,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 11,
   "firman": "(18-12) Ia membuat kegelapan di sekeliling-Nya menjadi persembunyian-Nya, ya, menjadi pondok-Nya: air hujan yang gelap, awan yang tebal."
 },
 {
   "id": 14135,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 12,
   "firman": "(18-13) Karena sinar di hadapan-Nya hilanglah awan-awan-Nya bersama hujan es dan bara api."
 },
 {
   "id": 14136,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 13,
   "firman": "(18-14) Maka TUHAN mengguntur di langit, Yang Mahatinggi memperdengarkan suara-Nya."
 },
 {
   "id": 14137,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 14,
   "firman": "(18-15) Dilepaskan-Nya panah-panah-Nya, sehingga diserakkan-Nya mereka, kilat bertubi-tubi, sehingga dikacaukan-Nya mereka."
 },
 {
   "id": 14138,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 15,
   "firman": "(18-16) Lalu kelihatanlah dasar-dasar lautan, dan tersingkaplah alas-alas dunia karena hardik-Mu, ya TUHAN, karena hembusan nafas dari hidung-Mu."
 },
 {
   "id": 14139,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 16,
   "firman": "(18-17) Ia menjangkau dari tempat tinggi, mengambil aku, menarik aku dari banjir."
 },
 {
   "id": 14140,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 17,
   "firman": "(18-18) Ia melepaskan aku dari musuhku yang gagah dan dari orang-orang yang membenci aku, karena mereka terlalu kuat bagiku."
 },
 {
   "id": 14141,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 18,
   "firman": "(18-19) Mereka menghadang aku pada hari sialku, tetapi TUHAN menjadi sandaran bagiku;"
 },
 {
   "id": 14142,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 19,
   "firman": "(18-20) Ia membawa aku ke luar ke tempat lapang, Ia menyelamatkan aku, karena Ia berkenan kepadaku."
 },
 {
   "id": 14143,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 20,
   "firman": "(18-21) TUHAN memperlakukan aku sesuai dengan kebenaranku, Ia membalas kepadaku sesuai dengan kesucian tanganku,"
 },
 {
   "id": 14144,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 21,
   "firman": "(18-22) sebab aku tetap mengikuti jalan TUHAN dan tidak berlaku fasik terhadap Allahku."
 },
 {
   "id": 14145,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 22,
   "firman": "(18-23) Sebab segala hukum-Nya kuperhatikan, dan ketetapan-Nya tidaklah kujauhkan dari padaku;"
 },
 {
   "id": 14146,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 23,
   "firman": "(18-24) aku berlaku tidak bercela di hadapan-Nya, dan menjaga diri terhadap kesalahan."
 },
 {
   "id": 14147,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 24,
   "firman": "(18-25) Karena itu TUHAN membalas kepadaku sesuai dengan kebenaranku, sesuai dengan kesucian tanganku di depan mata-Nya."
 },
 {
   "id": 14148,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 25,
   "firman": "(18-26) Terhadap orang yang setia Engkau berlaku setia, terhadap orang yang tidak bercela Engkau berlaku tidak bercela,"
 },
 {
   "id": 14149,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 26,
   "firman": "(18-27) terhadap orang yang suci Engkau berlaku suci, tetapi terhadap orang yang bengkok Engkau berlaku belat-belit."
 },
 {
   "id": 14150,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 27,
   "firman": "(18-28) Karena Engkaulah yang menyelamatkan bangsa yang tertindas, tetapi orang yang memandang dengan congkak Kaurendahkan."
 },
 {
   "id": 14151,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 28,
   "firman": "(18-29) Karena Engkaulah yang membuat pelitaku bercahaya; TUHAN, Allahku, menyinari kegelapanku."
 },
 {
   "id": 14152,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 29,
   "firman": "(18-30) Karena dengan Engkau aku berani menghadapi gerombolan, dan dengan Allahku aku berani melompati tembok."
 },
 {
   "id": 14153,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 30,
   "firman": "(18-31) Adapun Allah, jalan-Nya sempurna; janji TUHAN adalah murni; Dia menjadi perisai bagi semua orang yang berlindung pada-Nya."
 },
 {
   "id": 14154,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 31,
   "firman": "(18-32) Sebab siapakah Allah selain dari TUHAN, dan siapakah gunung batu kecuali Allah kita?"
 },
 {
   "id": 14155,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 32,
   "firman": "(18-33) Allah, Dialah yang mengikat pinggangku dengan keperkasaan dan membuat jalanku rata;"
 },
 {
   "id": 14156,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 33,
   "firman": "(18-34) yang membuat kakiku seperti kaki rusa dan membuat aku berdiri di bukit;"
 },
 {
   "id": 14157,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 34,
   "firman": "(18-35) yang mengajar tanganku berperang, sehingga lenganku dapat melenturkan busur tembaga."
 },
 {
   "id": 14158,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 35,
   "firman": "(18-36) Kauberikan kepadaku perisai keselamatan-Mu, tangan kanan-Mu menyokong aku, kemurahan-Mu membuat aku besar."
 },
 {
   "id": 14159,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 36,
   "firman": "(18-37) Kauberikan tempat lapang untuk langkahku, dan mata kakiku tidak goyah."
 },
 {
   "id": 14160,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 37,
   "firman": "(18-38) Aku mengejar musuhku sampai kutangkap mereka, dan tidak berbalik sebelum mereka kuhabiskan;"
 },
 {
   "id": 14161,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 38,
   "firman": "(18-39) aku meremukkan mereka, sehingga mereka tidak dapat bangkit lagi; mereka rebah di bawah kakiku."
 },
 {
   "id": 14162,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 39,
   "firman": "(18-40) Engkau telah mengikat pinggangku dengan keperkasaan untuk berperang; Engkau tundukkan ke bawah kuasaku orang yang bangkit melawan aku."
 },
 {
   "id": 14163,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 40,
   "firman": "(18-41) Kaubuat musuhku lari dari padaku, dan orang-orang yang membenci aku kubinasakan."
 },
 {
   "id": 14164,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 41,
   "firman": "(18-42) Mereka berteriak minta tolong, tetapi tidak ada yang menyelamatkan, mereka berteriak kepada TUHAN, tetapi Ia tidak menjawab mereka."
 },
 {
   "id": 14165,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 42,
   "firman": "(18-43) Aku menggiling mereka halus-halus seperti debu di depan angin, mencampakkan mereka seperti lumpur di jalan."
 },
 {
   "id": 14166,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 43,
   "firman": "(18-44) Engkau meluputkan aku dari perbantahan rakyat; Engkau mengangkat aku menjadi kepala atas bangsa-bangsa; bangsa yang tidak kukenal menjadi hambaku;"
 },
 {
   "id": 14167,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 44,
   "firman": "(18-45) baru saja telinga mereka mendengar, mereka taat kepadaku; orang-orang asing tunduk menjilat aku."
 },
 {
   "id": 14168,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 45,
   "firman": "(18-46) Orang-orang asing pucat layu dan keluar dari kota kubunya dengan gemetar."
 },
 {
   "id": 14169,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 46,
   "firman": "(18-47) TUHAN hidup! Terpujilah gunung batuku, dan mulialah Allah Penyelamatku,"
 },
 {
   "id": 14170,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 47,
   "firman": "(18-48) Allah, yang telah mengadakan pembalasan bagiku, yang telah menaklukkan bangsa-bangsa ke bawah kuasaku,"
 },
 {
   "id": 14171,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 48,
   "firman": "(18-49) yang telah meluputkan aku dari pada musuhku. Bahkan, Engkau telah meninggikan aku mengatasi mereka yang bangkit melawan aku; Engkau telah melepaskan aku dari orang yang melakukan kelaliman."
 },
 {
   "id": 14172,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 49,
   "firman": "(18-50) Sebab itu aku mau menyanyikan syukur bagi-Mu di antara bangsa-bangsa, ya TUHAN, dan aku mau menyanyikan mazmur bagi nama-Mu."
 },
 {
   "id": 14173,
   "kitab": "Mzm",
   "pasal": 18,
   "ayat": 50,
   "firman": "(18-51) Ia mengaruniakan keselamatan yang besar kepada raja yang diangkat-Nya, dan menunjukkan kasih setia kepada orang yang diurapi-Nya, yaitu Daud dan kepada anak cucunya untuk selamanya.\""
 },
 {
   "id": 14174,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (19-2) Langit menceritakan kemuliaan Allah, dan cakrawala memberitakan pekerjaan tangan-Nya;"
 },
 {
   "id": 14175,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 2,
   "firman": "(19-3) hari meneruskan berita itu kepada hari, dan malam menyampaikan pengetahuan itu kepada malam."
 },
 {
   "id": 14176,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 3,
   "firman": "(19-4) Tidak ada berita dan tidak ada kata, suara mereka tidak terdengar;"
 },
 {
   "id": 14177,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 4,
   "firman": "(19-5) tetapi gema mereka terpencar ke seluruh dunia, dan perkataan mereka sampai ke ujung bumi. Ia memasang kemah di langit untuk matahari,"
 },
 {
   "id": 14178,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 5,
   "firman": "(19-6) yang keluar bagaikan pengantin laki-laki yang keluar dari kamarnya, girang bagaikan pahlawan yang hendak melakukan perjalanannya."
 },
 {
   "id": 14179,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 6,
   "firman": "(19-7) Dari ujung langit ia terbit, dan ia beredar sampai ke ujung yang lain; tidak ada yang terlindung dari panas sinarnya."
 },
 {
   "id": 14180,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 7,
   "firman": "(19-8) Taurat TUHAN itu sempurna, menyegarkan jiwa; peraturan TUHAN itu teguh, memberikan hikmat kepada orang yang tak berpengalaman."
 },
 {
   "id": 14181,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 8,
   "firman": "(19-9) Titah TUHAN itu tepat, menyukakan hati; perintah TUHAN itu murni, membuat mata bercahaya."
 },
 {
   "id": 14182,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 9,
   "firman": "(19-10) Takut akan TUHAN itu suci, tetap ada untuk selamanya; hukum-hukum TUHAN itu benar, adil semuanya,"
 },
 {
   "id": 14183,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 10,
   "firman": "(19-11) lebih indah dari pada emas, bahkan dari pada banyak emas tua; dan lebih manis dari pada madu, bahkan dari pada madu tetesan dari sarang lebah."
 },
 {
   "id": 14184,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 11,
   "firman": "(19-12) Lagipula hamba-Mu diperingatkan oleh semuanya itu, dan orang yang berpegang padanya mendapat upah yang besar."
 },
 {
   "id": 14185,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 12,
   "firman": "(19-13) Siapakah yang dapat mengetahui kesesatan? Bebaskanlah aku dari apa yang tidak kusadari."
 },
 {
   "id": 14186,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 13,
   "firman": "(19-14) Lindungilah hamba-Mu, juga terhadap orang yang kurang ajar; janganlah mereka menguasai aku! Maka aku menjadi tak bercela dan bebas dari pelanggaran besar."
 },
 {
   "id": 14187,
   "kitab": "Mzm",
   "pasal": 19,
   "ayat": 14,
   "firman": "(19-15) Mudah-mudahan Engkau berkenan akan ucapan mulutku dan renungan hatiku, ya TUHAN, gunung batuku dan penebusku."
 },
 {
   "id": 14188,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (20-2) Kiranya TUHAN menjawab engkau pada waktu kesesakan! Kiranya nama Allah Yakub membentengi engkau!"
 },
 {
   "id": 14189,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 2,
   "firman": "(20-3) Kiranya dikirimkan-Nya bantuan kepadamu dari tempat kudus dan disokong-Nya engkau dari Sion."
 },
 {
   "id": 14190,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 3,
   "firman": "(20-4) Kiranya diingat-Nya segala korban persembahanmu, dan disukai-Nya korban bakaranmu. Sela"
 },
 {
   "id": 14191,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 4,
   "firman": "(20-5) Kiranya diberikan-Nya kepadamu apa yang kaukehendaki dan dijadikan-Nya berhasil apa yang kaurancangkan."
 },
 {
   "id": 14192,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 5,
   "firman": "(20-6) Kami mau bersorak-sorai tentang kemenanganmu dan mengangkat panji-panji demi nama Allah kita; kiranya TUHAN memenuhi segala permintaanmu."
 },
 {
   "id": 14193,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 6,
   "firman": "(20-7) Sekarang aku tahu, bahwa TUHAN memberi kemenangan kepada orang yang diurapi-Nya dan menjawabnya dari sorga-Nya yang kudus dengan kemenangan yang gilang-gemilang oleh tangan kanan-Nya."
 },
 {
   "id": 14194,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 7,
   "firman": "(20-8) Orang ini memegahkan kereta dan orang itu memegahkan kuda, tetapi kita bermegah dalam nama TUHAN, Allah kita."
 },
 {
   "id": 14195,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 8,
   "firman": "(20-9) Mereka rebah dan jatuh, tetapi kita bangun berdiri dan tetap tegak."
 },
 {
   "id": 14196,
   "kitab": "Mzm",
   "pasal": 20,
   "ayat": 9,
   "firman": "(20-10) Ya TUHAN, berikanlah kemenangan kepada raja! Jawablah kiranya kami pada waktu kami berseru!"
 },
 {
   "id": 14197,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (21-2) TUHAN, karena kuasa-Mulah raja bersukacita; betapa besar kegirangannya karena kemenangan yang dari pada-Mu!"
 },
 {
   "id": 14198,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 2,
   "firman": "(21-3) Apa yang menjadi keinginan hatinya telah Kaukaruniakan kepadanya, dan permintaan bibirnya tidak Kautolak. Sela"
 },
 {
   "id": 14199,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 3,
   "firman": "(21-4) Sebab Engkau menyambut dia dengan berkat melimpah; Engkau menaruh mahkota dari emas tua di atas kepalanya."
 },
 {
   "id": 14200,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 4,
   "firman": "(21-5) Hidup dimintanya dari pada-Mu; Engkau memberikannya kepadanya, dan umur panjang untuk seterusnya dan selama-lamanya."
 },
 {
   "id": 14201,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 5,
   "firman": "(21-6) Besar kemuliaannya karena kemenangan yang dari pada-Mu; keagungan dan semarak telah Kaukaruniakan kepadanya."
 },
 {
   "id": 14202,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 6,
   "firman": "(21-7) Ya, Engkau membuat dia menjadi berkat untuk seterusnya; Engkau memenuhi dia dengan sukacita di hadapan-Mu."
 },
 {
   "id": 14203,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 7,
   "firman": "(21-8) Sebab raja percaya kepada TUHAN, dan karena kasih setia Yang Mahatinggi ia tidak goyang."
 },
 {
   "id": 14204,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 8,
   "firman": "(21-9) Tangan-Mu akan menjangkau semua musuh-Mu; tangan kanan-Mu akan menjangkau orang-orang yang membenci Engkau."
 },
 {
   "id": 14205,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 9,
   "firman": "(21-10) Engkau akan membuat mereka seperti perapian yang menyala-nyala, pada waktu Engkau menampakkan Diri, ya TUHAN. Murka TUHAN akan menelan mereka, dan api akan memakan mereka."
 },
 {
   "id": 14206,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 10,
   "firman": "(21-11) Keturunan mereka akan Kaubinasakan dari muka bumi, dan anak cucu mereka dari antara anak-anak manusia."
 },
 {
   "id": 14207,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 11,
   "firman": "(21-12) Apabila mereka hendak mendatangkan malapetaka atasmu, merancangkan tipu muslihat, mereka tidak berdaya."
 },
 {
   "id": 14208,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 12,
   "firman": "(21-13) Ya, Engkau akan membuat mereka melarikan diri, dengan tali busur-Mu Engkau membidik muka mereka."
 },
 {
   "id": 14209,
   "kitab": "Mzm",
   "pasal": 21,
   "ayat": 13,
   "firman": "(21-14) Bangkitlah, ya TUHAN, di dalam kuasa-Mu! Kami mau menyanyikan dan memazmurkan keperkasaan-Mu."
 },
 {
   "id": 14210,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Rusa di kala fajar. Mazmur Daud. (22-2) Allahku, Allahku, mengapa Engkau meninggalkan aku? Aku berseru, tetapi Engkau tetap jauh dan tidak menolong aku."
 },
 {
   "id": 14211,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 2,
   "firman": "(22-3) Allahku, aku berseru-seru pada waktu siang, tetapi Engkau tidak menjawab, dan pada waktu malam, tetapi tidak juga aku tenang."
 },
 {
   "id": 14212,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 3,
   "firman": "(22-4) Padahal Engkaulah Yang Kudus yang bersemayam di atas puji-pujian orang Israel."
 },
 {
   "id": 14213,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 4,
   "firman": "(22-5) Kepada-Mu nenek moyang kami percaya; mereka percaya, dan Engkau meluputkan mereka."
 },
 {
   "id": 14214,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 5,
   "firman": "(22-6) Kepada-Mu mereka berseru-seru, dan mereka terluput; kepada-Mu mereka percaya, dan mereka tidak mendapat malu."
 },
 {
   "id": 14215,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 6,
   "firman": "(22-7) Tetapi aku ini ulat dan bukan orang, cela bagi manusia, dihina oleh orang banyak."
 },
 {
   "id": 14216,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 7,
   "firman": "(22-8) Semua yang melihat aku mengolok-olok aku, mereka mencibirkan bibirnya, menggelengkan kepalanya:"
 },
 {
   "id": 14217,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 8,
   "firman": "(22-9) \"Ia menyerah kepada TUHAN; biarlah Dia yang meluputkannya, biarlah Dia yang melepaskannya! Bukankah Dia berkenan kepadanya?\""
 },
 {
   "id": 14218,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 9,
   "firman": "(22-10) Ya, Engkau yang mengeluarkan aku dari kandungan; Engkau yang membuat aku aman pada dada ibuku."
 },
 {
   "id": 14219,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 10,
   "firman": "(22-11) Kepada-Mu aku diserahkan sejak aku lahir, sejak dalam kandungan ibuku Engkaulah Allahku."
 },
 {
   "id": 14220,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 11,
   "firman": "(22-12) Janganlah jauh dari padaku, sebab kesusahan telah dekat, dan tidak ada yang menolong."
 },
 {
   "id": 14221,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 12,
   "firman": "(22-13) Banyak lembu jantan mengerumuni aku; banteng-banteng dari Basan mengepung aku;"
 },
 {
   "id": 14222,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 13,
   "firman": "(22-14) mereka mengangakan mulutnya terhadap aku seperti singa yang menerkam dan mengaum."
 },
 {
   "id": 14223,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 14,
   "firman": "(22-15) Seperti air aku tercurah, dan segala tulangku terlepas dari sendinya; hatiku menjadi seperti lilin, hancur luluh di dalam dadaku;"
 },
 {
   "id": 14224,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 15,
   "firman": "(22-16) kekuatanku kering seperti beling, lidahku melekat pada langit-langit mulutku; dan dalam debu maut Kauletakkan aku."
 },
 {
   "id": 14225,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 16,
   "firman": "(22-17) Sebab anjing-anjing mengerumuni aku, gerombolan penjahat mengepung aku, mereka menusuk tangan dan kakiku."
 },
 {
   "id": 14226,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 17,
   "firman": "(22-18) Segala tulangku dapat kuhitung; mereka menonton, mereka memandangi aku."
 },
 {
   "id": 14227,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 18,
   "firman": "(22-19) Mereka membagi-bagi pakaianku di antara mereka, dan mereka membuang undi atas jubahku."
 },
 {
   "id": 14228,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 19,
   "firman": "(22-20) Tetapi Engkau, TUHAN, janganlah jauh; ya kekuatanku, segeralah menolong aku!"
 },
 {
   "id": 14229,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 20,
   "firman": "(22-21) Lepaskanlah aku dari pedang, dan nyawaku dari cengkeraman anjing."
 },
 {
   "id": 14230,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 21,
   "firman": "(22-22) Selamatkanlah aku dari mulut singa, dan dari tanduk banteng. Engkau telah menjawab aku!"
 },
 {
   "id": 14231,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 22,
   "firman": "(22-23) Aku akan memasyhurkan nama-Mu kepada saudara-saudaraku dan memuji-muji Engkau di tengah-tengah jemaah:"
 },
 {
   "id": 14232,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 23,
   "firman": "(22-24) kamu yang takut akan TUHAN, pujilah Dia, hai segenap anak cucu Yakub, muliakanlah Dia, dan gentarlah terhadap Dia, hai segenap anak cucu Israel!"
 },
 {
   "id": 14233,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 24,
   "firman": "(22-25) Sebab Ia tidak memandang hina ataupun merasa jijik kesengsaraan orang yang tertindas, dan Ia tidak menyembunyikan wajah-Nya kepada orang itu, dan Ia mendengar ketika orang itu berteriak minta tolong kepada-Nya."
 },
 {
   "id": 14234,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 25,
   "firman": "(22-26) Karena Engkau aku memuji-muji dalam jemaah yang besar; nazarku akan kubayar di depan mereka yang takut akan Dia."
 },
 {
   "id": 14235,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 26,
   "firman": "(22-27) Orang yang rendah hati akan makan dan kenyang, orang yang mencari TUHAN akan memuji-muji Dia; biarlah hatimu hidup untuk selamanya!"
 },
 {
   "id": 14236,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 27,
   "firman": "(22-28) Segala ujung bumi akan mengingatnya dan berbalik kepada TUHAN; dan segala kaum dari bangsa-bangsa akan sujud menyembah di hadapan-Nya."
 },
 {
   "id": 14237,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 28,
   "firman": "(22-29) Sebab Tuhanlah yang empunya kerajaan, Dialah yang memerintah atas bangsa-bangsa."
 },
 {
   "id": 14238,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 29,
   "firman": "(22-30) Ya, kepada-Nya akan sujud menyembah semua orang sombong di bumi, di hadapan-Nya akan berlutut semua orang yang turun ke dalam debu, dan orang yang tidak dapat menyambung hidup."
 },
 {
   "id": 14239,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 30,
   "firman": "(22-31) Anak-anak cucu akan beribadah kepada-Nya, dan akan menceritakan tentang TUHAN kepada angkatan yang akan datang."
 },
 {
   "id": 14240,
   "kitab": "Mzm",
   "pasal": 22,
   "ayat": 31,
   "firman": "(22-32) Mereka akan memberitakan keadilan-Nya kepada bangsa yang akan lahir nanti, sebab Ia telah melakukannya."
 },
 {
   "id": 14241,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 1,
   "firman": "Mazmur Daud. TUHAN adalah gembalaku, takkan kekurangan aku."
 },
 {
   "id": 14242,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 2,
   "firman": "Ia membaringkan aku di padang yang berumput hijau, Ia membimbing aku ke air yang tenang;"
 },
 {
   "id": 14243,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 3,
   "firman": "Ia menyegarkan jiwaku. Ia menuntun aku di jalan yang benar oleh karena nama-Nya."
 },
 {
   "id": 14244,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 4,
   "firman": "Sekalipun aku berjalan dalam lembah kekelaman, aku tidak takut bahaya, sebab Engkau besertaku; gada-Mu dan tongkat-Mu, itulah yang menghibur aku."
 },
 {
   "id": 14245,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 5,
   "firman": "Engkau menyediakan hidangan bagiku, di hadapan lawanku; Engkau mengurapi kepalaku dengan minyak; pialaku penuh melimpah."
 },
 {
   "id": 14246,
   "kitab": "Mzm",
   "pasal": 23,
   "ayat": 6,
   "firman": "Kebajikan dan kemurahan belaka akan mengikuti aku, seumur hidupku; dan aku akan diam dalam rumah TUHAN sepanjang masa."
 },
 {
   "id": 14247,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 1,
   "firman": "Mazmur Daud. Tuhanlah yang empunya bumi serta segala isinya, dan dunia serta yang diam di dalamnya."
 },
 {
   "id": 14248,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 2,
   "firman": "Sebab Dialah yang mendasarkannya di atas lautan dan menegakkannya di atas sungai-sungai."
 },
 {
   "id": 14249,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 3,
   "firman": "\"Siapakah yang boleh naik ke atas gunung TUHAN? Siapakah yang boleh berdiri di tempat-Nya yang kudus?\""
 },
 {
   "id": 14250,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 4,
   "firman": "\"Orang yang bersih tangannya dan murni hatinya, yang tidak menyerahkan dirinya kepada penipuan, dan yang tidak bersumpah palsu."
 },
 {
   "id": 14251,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 5,
   "firman": "Dialah yang akan menerima berkat dari TUHAN dan keadilan dari Allah yang menyelamatkan dia."
 },
 {
   "id": 14252,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 6,
   "firman": "Itulah angkatan orang-orang yang menanyakan Dia, yang mencari wajah-Mu, ya Allah Yakub.\" Sela"
 },
 {
   "id": 14253,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 7,
   "firman": "Angkatlah kepalamu, hai pintu-pintu gerbang, dan terangkatlah kamu, hai pintu-pintu yang berabad-abad, supaya masuk Raja Kemuliaan!"
 },
 {
   "id": 14254,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 8,
   "firman": "\"Siapakah itu Raja Kemuliaan?\" \"TUHAN, jaya dan perkasa, TUHAN, perkasa dalam peperangan!\""
 },
 {
   "id": 14255,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 9,
   "firman": "Angkatlah kepalamu, hai pintu-pintu gerbang, dan terangkatlah kamu, hai pintu-pintu yang berabad-abad, supaya masuk Raja Kemuliaan!"
 },
 {
   "id": 14256,
   "kitab": "Mzm",
   "pasal": 24,
   "ayat": 10,
   "firman": "\"Siapakah Dia itu Raja Kemuliaan?\" \"TUHAN semesta alam, Dialah Raja Kemuliaan!\" Sela"
 },
 {
   "id": 14257,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 1,
   "firman": "Dari Daud. Kepada-Mu, ya TUHAN, kuangkat jiwaku;"
 },
 {
   "id": 14258,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 2,
   "firman": "Allahku, kepada-Mu aku percaya; janganlah kiranya aku mendapat malu; janganlah musuh-musuhku beria-ria atas aku."
 },
 {
   "id": 14259,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 3,
   "firman": "Ya, semua orang yang menantikan Engkau takkan mendapat malu; yang mendapat malu ialah mereka yang berbuat khianat dengan tidak ada alasannya."
 },
 {
   "id": 14260,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 4,
   "firman": "Beritahukanlah jalan-jalan-Mu kepadaku, ya TUHAN, tunjukkanlah itu kepadaku."
 },
 {
   "id": 14261,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 5,
   "firman": "Bawalah aku berjalan dalam kebenaran-Mu dan ajarlah aku, sebab Engkaulah Allah yang menyelamatkan aku, Engkau kunanti-nantikan sepanjang hari."
 },
 {
   "id": 14262,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 6,
   "firman": "Ingatlah segala rahmat-Mu dan kasih setia-Mu, ya TUHAN, sebab semuanya itu sudah ada sejak purbakala."
 },
 {
   "id": 14263,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 7,
   "firman": "Dosa-dosaku pada waktu muda dan pelanggaran-pelanggaranku janganlah Kauingat, tetapi ingatlah kepadaku sesuai dengan kasih setia-Mu, oleh karena kebaikan-Mu, ya TUHAN."
 },
 {
   "id": 14264,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 8,
   "firman": "TUHAN itu baik dan benar; sebab itu Ia menunjukkan jalan kepada orang yang sesat."
 },
 {
   "id": 14265,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 9,
   "firman": "Ia membimbing orang-orang yang rendah hati menurut hukum, dan Ia mengajarkan jalan-Nya kepada orang-orang yang rendah hati."
 },
 {
   "id": 14266,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 10,
   "firman": "Segala jalan TUHAN adalah kasih setia dan kebenaran bagi orang yang berpegang pada perjanjian-Nya dan peringatan-peringatan-Nya."
 },
 {
   "id": 14267,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 11,
   "firman": "Oleh karena nama-Mu, ya TUHAN, ampunilah kesalahanku, sebab besar kesalahan itu."
 },
 {
   "id": 14268,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 12,
   "firman": "Siapakah orang yang takut akan TUHAN? Kepadanya TUHAN menunjukkan jalan yang harus dipilihnya."
 },
 {
   "id": 14269,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 13,
   "firman": "Orang itu sendiri akan menetap dalam kebahagiaan dan anak cucunya akan mewarisi bumi."
 },
 {
   "id": 14270,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 14,
   "firman": "TUHAN bergaul karib dengan orang yang takut akan Dia, dan perjanjian-Nya diberitahukan-Nya kepada mereka."
 },
 {
   "id": 14271,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 15,
   "firman": "Mataku tetap terarah kepada TUHAN, sebab Ia mengeluarkan kakiku dari jaring."
 },
 {
   "id": 14272,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 16,
   "firman": "Berpalinglah kepadaku dan kasihanilah aku, sebab aku sebatang kara dan tertindas."
 },
 {
   "id": 14273,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 17,
   "firman": "Lapangkanlah hatiku yang sesak dan keluarkanlah aku dari kesulitanku!"
 },
 {
   "id": 14274,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 18,
   "firman": "Tiliklah sengsaraku dan kesukaranku, dan ampunilah segala dosaku."
 },
 {
   "id": 14275,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 19,
   "firman": "Lihatlah, betapa banyaknya musuhku, dan bagaimana mereka membenci aku dengan sangat mendalam."
 },
 {
   "id": 14276,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 20,
   "firman": "Jagalah kiranya jiwaku dan lepaskanlah aku; janganlah aku mendapat malu, sebab aku berlindung pada-Mu."
 },
 {
   "id": 14277,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 21,
   "firman": "Ketulusan dan kejujuran kiranya mengawal aku, sebab aku menanti-nantikan Engkau."
 },
 {
   "id": 14278,
   "kitab": "Mzm",
   "pasal": 25,
   "ayat": 22,
   "firman": "Ya Allah, bebaskanlah orang Israel dari segala kesesakannya!"
 },
 {
   "id": 14279,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 1,
   "firman": "Dari Daud. Berilah keadilan kepadaku, ya TUHAN, sebab aku telah hidup dalam ketulusan; kepada TUHAN aku percaya dengan tidak ragu-ragu."
 },
 {
   "id": 14280,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 2,
   "firman": "Ujilah aku, ya TUHAN, dan cobalah aku; selidikilah batinku dan hatiku."
 },
 {
   "id": 14281,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 3,
   "firman": "Sebab mataku tertuju pada kasih setia-Mu, dan aku hidup dalam kebenaran-Mu."
 },
 {
   "id": 14282,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 4,
   "firman": "Aku tidak duduk dengan penipu, dan dengan orang munafik aku tidak bergaul;"
 },
 {
   "id": 14283,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 5,
   "firman": "aku benci kepada perkumpulan orang yang berbuat jahat, dan dengan orang fasik aku tidak duduk."
 },
 {
   "id": 14284,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 6,
   "firman": "Aku membasuh tanganku tanda tak bersalah, lalu berjalan mengelilingi mezbah-Mu, ya TUHAN,"
 },
 {
   "id": 14285,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 7,
   "firman": "sambil memperdengarkan nyanyian syukur dengan nyaring, dan menceritakan segala perbuatan-Mu yang ajaib."
 },
 {
   "id": 14286,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 8,
   "firman": "TUHAN, aku cinta pada rumah kediaman-Mu dan pada tempat kemuliaan-Mu bersemayam."
 },
 {
   "id": 14287,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 9,
   "firman": "Janganlah mencabut nyawaku bersama-sama orang berdosa, atau hidupku bersama-sama orang penumpah darah,"
 },
 {
   "id": 14288,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 10,
   "firman": "yang pada tangannya melekat perbuatan mesum, dan yang tangan kanannya menerima suapan."
 },
 {
   "id": 14289,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 11,
   "firman": "Tetapi aku ini hidup dalam ketulusan; bebaskanlah aku dan kasihanilah aku."
 },
 {
   "id": 14290,
   "kitab": "Mzm",
   "pasal": 26,
   "ayat": 12,
   "firman": "Kakiku berdiri di tanah yang rata; aku mau memuji TUHAN dalam jemaah."
 },
 {
   "id": 14291,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 1,
   "firman": "Dari Daud. TUHAN adalah terangku dan keselamatanku, kepada siapakah aku harus takut? TUHAN adalah benteng hidupku, terhadap siapakah aku harus gemetar?"
 },
 {
   "id": 14292,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 2,
   "firman": "Ketika penjahat-penjahat menyerang aku untuk memakan dagingku, yakni semua lawanku dan musuhku, mereka sendirilah yang tergelincir dan jatuh."
 },
 {
   "id": 14293,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 3,
   "firman": "Sekalipun tentara berkemah mengepung aku, tidak takut hatiku; sekalipun timbul peperangan melawan aku, dalam hal itupun aku tetap percaya."
 },
 {
   "id": 14294,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 4,
   "firman": "Satu hal telah kuminta kepada TUHAN, itulah yang kuingini: diam di rumah TUHAN seumur hidupku, menyaksikan kemurahan TUHAN dan menikmati bait-Nya."
 },
 {
   "id": 14295,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 5,
   "firman": "Sebab Ia melindungi aku dalam pondok-Nya pada waktu bahaya; Ia menyembunyikan aku dalam persembunyian di kemah-Nya, Ia mengangkat aku ke atas gunung batu."
 },
 {
   "id": 14296,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 6,
   "firman": "Maka sekarang tegaklah kepalaku, mengatasi musuhku sekeliling aku; dalam kemah-Nya aku mau mempersembahkan korban dengan sorak-sorai; aku mau menyanyi dan bermazmur bagi TUHAN."
 },
 {
   "id": 14297,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 7,
   "firman": "Dengarlah, TUHAN, seruan yang kusampaikan, kasihanilah aku dan jawablah aku!"
 },
 {
   "id": 14298,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 8,
   "firman": "Hatiku mengikuti firman-Mu: \"Carilah wajah-Ku\"; maka wajah-Mu kucari, ya TUHAN."
 },
 {
   "id": 14299,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 9,
   "firman": "Janganlah menyembunyikan wajah-Mu kepadaku, janganlah menolak hamba-Mu ini dengan murka; Engkaulah pertolonganku, janganlah membuang aku dan janganlah meninggalkan aku, ya Allah penyelamatku!"
 },
 {
   "id": 14300,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 10,
   "firman": "Sekalipun ayahku dan ibuku meninggalkan aku, namun TUHAN menyambut aku."
 },
 {
   "id": 14301,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 11,
   "firman": "Tunjukkanlah jalan-Mu kepadaku, ya TUHAN, dan tuntunlah aku di jalan yang rata oleh sebab seteruku."
 },
 {
   "id": 14302,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 12,
   "firman": "Janganlah menyerahkan aku kepada nafsu lawanku, sebab telah bangkit menyerang aku saksi-saksi dusta, dan orang-orang yang bernafaskan kelaliman."
 },
 {
   "id": 14303,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 13,
   "firman": "Sesungguhnya, aku percaya akan melihat kebaikan TUHAN di negeri orang-orang yang hidup!"
 },
 {
   "id": 14304,
   "kitab": "Mzm",
   "pasal": 27,
   "ayat": 14,
   "firman": "Nantikanlah TUHAN! Kuatkanlah dan teguhkanlah hatimu! Ya, nantikanlah TUHAN!"
 },
 {
   "id": 14305,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 1,
   "firman": "Dari Daud. Kepada-Mu, ya TUHAN, gunung batuku, aku berseru, janganlah berdiam diri terhadap aku, sebab, jika Engkau tetap membisu terhadap aku, aku menjadi seperti orang yang turun ke dalam liang kubur."
 },
 {
   "id": 14306,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 2,
   "firman": "Dengarkanlah suara permohonanku, apabila aku berteriak kepada-Mu minta tolong, dan mengangkat tanganku ke arah tempat-Mu yang maha kudus."
 },
 {
   "id": 14307,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 3,
   "firman": "Janganlah menyeret aku bersama-sama dengan orang fasik ataupun dengan orang yang melakukan kejahatan, yang ramah dengan teman-temannya, tetapi yang hatinya penuh kejahatan."
 },
 {
   "id": 14308,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 4,
   "firman": "Ganjarilah mereka menurut perbuatan mereka dan menurut kelakuan mereka yang jahat; ganjarilah mereka setimpal dengan perbuatan tangan mereka, balaslah kepada mereka apa yang mereka lakukan."
 },
 {
   "id": 14309,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 5,
   "firman": "Karena mereka tidak mengindahkan pekerjaan TUHAN dan perbuatan tangan-Nya; Ia akan menjatuhkan mereka dan tidak membangunkan mereka lagi."
 },
 {
   "id": 14310,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 6,
   "firman": "Terpujilah TUHAN, karena Ia telah mendengar suara permohonanku."
 },
 {
   "id": 14311,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 7,
   "firman": "TUHAN adalah kekuatanku dan perisaiku; kepada-Nya hatiku percaya. Aku tertolong sebab itu beria-ria hatiku, dan dengan nyanyianku aku bersyukur kepada-Nya."
 },
 {
   "id": 14312,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 8,
   "firman": "TUHAN adalah kekuatan umat-Nya dan benteng keselamatan bagi orang yang diurapi-Nya!"
 },
 {
   "id": 14313,
   "kitab": "Mzm",
   "pasal": 28,
   "ayat": 9,
   "firman": "Selamatkanlah kiranya umat-Mu dan berkatilah milik-Mu sendiri, gembalakanlah mereka dan dukunglah mereka untuk selama-lamanya."
 },
 {
   "id": 14314,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 1,
   "firman": "Mazmur Daud. Kepada TUHAN, hai penghuni sorgawi, kepada TUHAN sajalah kemuliaan dan kekuatan!"
 },
 {
   "id": 14315,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 2,
   "firman": "Berilah kepada TUHAN kemuliaan nama-Nya, sujudlah kepada TUHAN dengan berhiaskan kekudusan!"
 },
 {
   "id": 14316,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 3,
   "firman": "Suara TUHAN di atas air, Allah yang mulia mengguntur, TUHAN di atas air yang besar."
 },
 {
   "id": 14317,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 4,
   "firman": "Suara TUHAN penuh kekuatan, suara TUHAN penuh semarak."
 },
 {
   "id": 14318,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 5,
   "firman": "Suara TUHAN mematahkan pohon aras, bahkan, TUHAN menumbangkan pohon aras Libanon."
 },
 {
   "id": 14319,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 6,
   "firman": "Ia membuat gunung Libanon melompat-lompat seperti anak lembu, dan gunung Siryon seperti anak banteng."
 },
 {
   "id": 14320,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 7,
   "firman": "Suara TUHAN menyemburkan nyala api."
 },
 {
   "id": 14321,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 8,
   "firman": "Suara TUHAN membuat padang gurun gemetar, TUHAN membuat padang gurun Kadesh gemetar."
 },
 {
   "id": 14322,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 9,
   "firman": "Suara TUHAN membuat beranak rusa betina yang mengandung, bahkan, hutan digundulinya; dan di dalam bait-Nya setiap orang berseru: \"Hormat!\""
 },
 {
   "id": 14323,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 10,
   "firman": "TUHAN bersemayam di atas air bah, TUHAN bersemayam sebagai Raja untuk selama-lamanya."
 },
 {
   "id": 14324,
   "kitab": "Mzm",
   "pasal": 29,
   "ayat": 11,
   "firman": "TUHAN kiranya memberikan kekuatan kepada umat-Nya, TUHAN kiranya memberkati umat-Nya dengan sejahtera!"
 },
 {
   "id": 14325,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 1,
   "firman": "Mazmur. Nyanyian untuk pentahbisan Bait Suci. Dari Daud. (30-2) Aku akan memuji Engkau, ya TUHAN, sebab Engkau telah menarik aku ke atas, dan tidak memberi musuh-musuhku bersukacita atas aku."
 },
 {
   "id": 14326,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 2,
   "firman": "(30-3) TUHAN, Allahku, kepada-Mu aku berteriak minta tolong, dan Engkau telah menyembuhkan aku."
 },
 {
   "id": 14327,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 3,
   "firman": "(30-4) TUHAN, Engkau mengangkat aku dari dunia orang mati, Engkau menghidupkan aku di antara mereka yang turun ke liang kubur."
 },
 {
   "id": 14328,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 4,
   "firman": "(30-5) Nyanyikanlah mazmur bagi TUHAN, hai orang-orang yang dikasihi-Nya, dan persembahkanlah syukur kepada nama-Nya yang kudus!"
 },
 {
   "id": 14329,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 5,
   "firman": "(30-6) Sebab sesaat saja Ia murka, tetapi seumur hidup Ia murah hati; sepanjang malam ada tangisan, menjelang pagi terdengar sorak-sorai."
 },
 {
   "id": 14330,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 6,
   "firman": "(30-7) Dalam kesenanganku aku berkata: \"Aku takkan goyah untuk selama-lamanya!\""
 },
 {
   "id": 14331,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 7,
   "firman": "(30-8) TUHAN, oleh karena Engkau berkenan, Engkau telah menempatkan aku di atas gunung yang kokoh; ketika Engkau menyembunyikan wajah-Mu, aku terkejut."
 },
 {
   "id": 14332,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 8,
   "firman": "(30-9) Kepada-Mu, ya TUHAN, aku berseru, dan kepada Tuhanku aku memohon:"
 },
 {
   "id": 14333,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 9,
   "firman": "(30-10) \"Apakah untungnya kalau darahku tertumpah, kalau aku turun ke dalam lobang kubur? Dapatkah debu bersyukur kepada-Mu dan memberitakan kesetiaan-Mu?"
 },
 {
   "id": 14334,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 10,
   "firman": "(30-11) Dengarlah, TUHAN, dan kasihanilah aku, TUHAN, jadilah penolongku!\""
 },
 {
   "id": 14335,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 11,
   "firman": "(30-12) Aku yang meratap telah Kauubah menjadi orang yang menari-nari, kain kabungku telah Kaubuka, pinggangku Kauikat dengan sukacita,"
 },
 {
   "id": 14336,
   "kitab": "Mzm",
   "pasal": 30,
   "ayat": 12,
   "firman": "(30-13) supaya jiwaku menyanyikan mazmur bagi-Mu dan jangan berdiam diri. TUHAN, Allahku, untuk selama-lamanya aku mau menyanyikan syukur bagi-Mu."
 },
 {
   "id": 14337,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (31-2) Pada-Mu, TUHAN, aku berlindung, janganlah sekali-kali aku mendapat malu. Luputkanlah aku oleh karena keadilan-Mu,"
 },
 {
   "id": 14338,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 2,
   "firman": "(31-3) sendengkanlah telinga-Mu kepadaku, bersegeralah melepaskan aku! Jadilah bagiku gunung batu tempat perlindungan, kubu pertahanan untuk menyelamatkan aku!"
 },
 {
   "id": 14339,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 3,
   "firman": "(31-4) Sebab Engkau bukit batuku dan pertahananku, dan oleh karena nama-Mu Engkau akan menuntun dan membimbing aku."
 },
 {
   "id": 14340,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 4,
   "firman": "(31-5) Engkau akan mengeluarkan aku dari jaring yang dipasang orang terhadap aku, sebab Engkaulah tempat perlindunganku."
 },
 {
   "id": 14341,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 5,
   "firman": "(31-6) Ke dalam tangan-Mulah kuserahkan nyawaku; Engkau membebaskan aku, ya TUHAN, Allah yang setia."
 },
 {
   "id": 14342,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 6,
   "firman": "(31-7) Engkau benci kepada orang-orang yang memuja berhala yang sia-sia, tetapi aku percaya kepada TUHAN."
 },
 {
   "id": 14343,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 7,
   "firman": "(31-8) Aku akan bersorak-sorak dan bersukacita karena kasih setia-Mu, sebab Engkau telah menilik sengsaraku, telah memperhatikan kesesakan jiwaku,"
 },
 {
   "id": 14344,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 8,
   "firman": "(31-9) dan tidak menyerahkan aku ke tangan musuh, tetapi menegakkan kakiku di tempat yang lapang."
 },
 {
   "id": 14345,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 9,
   "firman": "(31-10) Kasihanilah aku, ya TUHAN, sebab aku merasa sesak; karena sakit hati mengidaplah mataku, meranalah jiwa dan tubuhku."
 },
 {
   "id": 14346,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 10,
   "firman": "(31-11) Sebab hidupku habis dalam duka dan tahun-tahun umurku dalam keluh kesah; kekuatanku merosot karena sengsaraku, dan tulang-tulangku menjadi lemah."
 },
 {
   "id": 14347,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 11,
   "firman": "(31-12) Di hadapan semua lawanku aku tercela, menakutkan bagi tetangga-tetanggaku, dan menjadi kekejutan bagi kenalan-kenalanku; mereka yang melihat aku di jalan lari dari padaku."
 },
 {
   "id": 14348,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 12,
   "firman": "(31-13) Aku telah hilang dari ingatan seperti orang mati, telah menjadi seperti barang yang pecah."
 },
 {
   "id": 14349,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 13,
   "firman": "(31-14) Sebab aku mendengar banyak orang berbisik-bisik, --ada kegentaran dari segala pihak! --mereka bersama-sama bermufakat mencelakakan aku, mereka bermaksud mencabut nyawaku."
 },
 {
   "id": 14350,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 14,
   "firman": "(31-15) Tetapi aku, kepada-Mu aku percaya, ya TUHAN, aku berkata: \"Engkaulah Allahku!\""
 },
 {
   "id": 14351,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 15,
   "firman": "(31-16) Masa hidupku ada dalam tangan-Mu, lepaskanlah aku dari tangan musuh-musuhku dan orang-orang yang mengejar aku!"
 },
 {
   "id": 14352,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 16,
   "firman": "(31-17) Buatlah wajah-Mu bercahaya atas hamba-Mu, selamatkanlah aku oleh kasih setia-Mu!"
 },
 {
   "id": 14353,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 17,
   "firman": "(31-18) TUHAN, janganlah membiarkan aku mendapat malu, sebab aku berseru kepada-Mu; biarlah orang-orang fasik mendapat malu dan turun ke dunia orang mati dan bungkam."
 },
 {
   "id": 14354,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 18,
   "firman": "(31-19) Biarlah bibir dusta menjadi kelu, yang mencaci maki orang benar dengan kecongkakan dan penghinaan!"
 },
 {
   "id": 14355,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 19,
   "firman": "(31-20) Alangkah limpahnya kebaikan-Mu yang telah Kausimpan bagi orang yang takut akan Engkau, yang telah Kaulakukan bagi orang yang berlindung pada-Mu, di hadapan manusia!"
 },
 {
   "id": 14356,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 20,
   "firman": "(31-21) Engkau menyembunyikan mereka dalam naungan wajah-Mu terhadap persekongkolan orang-orang; Engkau melindungi mereka dalam pondok terhadap perbantahan lidah."
 },
 {
   "id": 14357,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 21,
   "firman": "(31-22) Terpujilah TUHAN, sebab kasih setia-Nya ditunjukkan-Nya kepadaku dengan ajaib pada waktu kesesakan!"
 },
 {
   "id": 14358,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 22,
   "firman": "(31-23) Aku menyangka dalam kebingunganku: \"Aku telah terbuang dari hadapan mata-Mu.\" Tetapi sesungguhnya Engkau mendengarkan suara permohonanku, ketika aku berteriak kepada-Mu minta tolong."
 },
 {
   "id": 14359,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 23,
   "firman": "(31-24) Kasihilah TUHAN, hai semua orang yang dikasihi-Nya! TUHAN menjaga orang-orang yang setiawan, tetapi orang-orang yang berbuat congkak diganjar-Nya dengan tidak tanggung-tanggung."
 },
 {
   "id": 14360,
   "kitab": "Mzm",
   "pasal": 31,
   "ayat": 24,
   "firman": "(31-25) Kuatkanlah dan teguhkanlah hatimu, hai semua orang yang berharap kepada TUHAN!"
 },
 {
   "id": 14361,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 1,
   "firman": "Dari Daud. Nyanyian pengajaran. Berbahagialah orang yang diampuni pelanggarannya, yang dosanya ditutupi!"
 },
 {
   "id": 14362,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 2,
   "firman": "Berbahagialah manusia, yang kesalahannya tidak diperhitungkan TUHAN, dan yang tidak berjiwa penipu!"
 },
 {
   "id": 14363,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 3,
   "firman": "Selama aku berdiam diri, tulang-tulangku menjadi lesu karena aku mengeluh sepanjang hari;"
 },
 {
   "id": 14364,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 4,
   "firman": "sebab siang malam tangan-Mu menekan aku dengan berat, sumsumku menjadi kering, seperti oleh teriknya musim panas. Sela"
 },
 {
   "id": 14365,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 5,
   "firman": "Dosaku kuberitahukan kepada-Mu dan kesalahanku tidaklah kusembunyikan; aku berkata: \"Aku akan mengaku kepada TUHAN pelanggaran-pelanggaranku,\" dan Engkau mengampuni kesalahan karena dosaku. Sela"
 },
 {
   "id": 14366,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 6,
   "firman": "Sebab itu hendaklah setiap orang saleh berdoa kepada-Mu, selagi Engkau dapat ditemui; sesungguhnya pada waktu banjir besar terjadi, itu tidak melandanya."
 },
 {
   "id": 14367,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 7,
   "firman": "Engkaulah persembunyian bagiku, terhadap kesesakan Engkau menjaga aku, Engkau mengelilingi aku, sehingga aku luput dan bersorak. Sela"
 },
 {
   "id": 14368,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 8,
   "firman": "Aku hendak mengajar dan menunjukkan kepadamu jalan yang harus kautempuh; Aku hendak memberi nasihat, mata-Ku tertuju kepadamu."
 },
 {
   "id": 14369,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 9,
   "firman": "Janganlah seperti kuda atau bagal yang tidak berakal, yang kegarangannya harus dikendalikan dengan tali les dan kekang, kalau tidak, ia tidak akan mendekati engkau."
 },
 {
   "id": 14370,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 10,
   "firman": "Banyak kesakitan diderita orang fasik, tetapi orang percaya kepada TUHAN dikelilingi-Nya dengan kasih setia."
 },
 {
   "id": 14371,
   "kitab": "Mzm",
   "pasal": 32,
   "ayat": 11,
   "firman": "Bersukacitalah dalam TUHAN dan bersorak-soraklah, hai orang-orang benar; bersorak-sorailah, hai orang-orang jujur!"
 },
 {
   "id": 14372,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 1,
   "firman": "Bersorak-sorailah, hai orang-orang benar, dalam TUHAN! Sebab memuji-muji itu layak bagi orang-orang jujur."
 },
 {
   "id": 14373,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 2,
   "firman": "Bersyukurlah kepada TUHAN dengan kecapi, bermazmurlah bagi-Nya dengan gambus sepuluh tali!"
 },
 {
   "id": 14374,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 3,
   "firman": "Nyanyikanlah bagi-Nya nyanyian baru; petiklah kecapi baik-baik dengan sorak-sorai!"
 },
 {
   "id": 14375,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 4,
   "firman": "Sebab firman TUHAN itu benar, segala sesuatu dikerjakan-Nya dengan kesetiaan."
 },
 {
   "id": 14376,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 5,
   "firman": "Ia senang kepada keadilan dan hukum; bumi penuh dengan kasih setia TUHAN."
 },
 {
   "id": 14377,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 6,
   "firman": "Oleh firman TUHAN langit telah dijadikan, oleh nafas dari mulut-Nya segala tentaranya."
 },
 {
   "id": 14378,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 7,
   "firman": "Ia mengumpulkan air laut seperti dalam bendungan, Ia menaruh samudera raya ke dalam wadah."
 },
 {
   "id": 14379,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 8,
   "firman": "Biarlah segenap bumi takut kepada TUHAN, biarlah semua penduduk dunia gentar terhadap Dia!"
 },
 {
   "id": 14380,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 9,
   "firman": "Sebab Dia berfirman, maka semuanya jadi; Dia memberi perintah, maka semuanya ada."
 },
 {
   "id": 14381,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 10,
   "firman": "TUHAN menggagalkan rencana bangsa-bangsa; Ia meniadakan rancangan suku-suku bangsa;"
 },
 {
   "id": 14382,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 11,
   "firman": "tetapi rencana TUHAN tetap selama-lamanya, rancangan hati-Nya turun-temurun."
 },
 {
   "id": 14383,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 12,
   "firman": "Berbahagialah bangsa, yang Allahnya ialah TUHAN, suku bangsa yang dipilih-Nya menjadi milik-Nya sendiri!"
 },
 {
   "id": 14384,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 13,
   "firman": "TUHAN memandang dari sorga, Ia melihat semua anak manusia;"
 },
 {
   "id": 14385,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 14,
   "firman": "dari tempat kediaman-Nya Ia menilik semua penduduk bumi."
 },
 {
   "id": 14386,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 15,
   "firman": "Dia yang membentuk hati mereka sekalian, yang memperhatikan segala pekerjaan mereka."
 },
 {
   "id": 14387,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 16,
   "firman": "Seorang raja tidak akan selamat oleh besarnya kuasa; seorang pahlawan tidak akan tertolong oleh besarnya kekuatan."
 },
 {
   "id": 14388,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 17,
   "firman": "Kuda adalah harapan sia-sia untuk mencapai kemenangan, yang sekalipun besar ketangkasannya tidak dapat memberi keluputan."
 },
 {
   "id": 14389,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 18,
   "firman": "Sesungguhnya, mata TUHAN tertuju kepada mereka yang takut akan Dia, kepada mereka yang berharap akan kasih setia-Nya,"
 },
 {
   "id": 14390,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 19,
   "firman": "untuk melepaskan jiwa mereka dari pada maut dan memelihara hidup mereka pada masa kelaparan."
 },
 {
   "id": 14391,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 20,
   "firman": "Jiwa kita menanti-nantikan TUHAN. Dialah penolong kita dan perisai kita!"
 },
 {
   "id": 14392,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 21,
   "firman": "Ya, karena Dia hati kita bersukacita, sebab kepada nama-Nya yang kudus kita percaya."
 },
 {
   "id": 14393,
   "kitab": "Mzm",
   "pasal": 33,
   "ayat": 22,
   "firman": "Kasih setia-Mu, ya TUHAN, kiranya menyertai kami, seperti kami berharap kepada-Mu."
 },
 {
   "id": 14394,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 1,
   "firman": "Dari Daud, pada waktu ia pura-pura tidak waras pikirannya di depan Abimelekh, sehingga ia diusir, lalu pergi. (34-2) Aku hendak memuji TUHAN pada segala waktu; puji-pujian kepada-Nya tetap di dalam mulutku."
 },
 {
   "id": 14395,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 2,
   "firman": "(34-3) Karena TUHAN jiwaku bermegah; biarlah orang-orang yang rendah hati mendengarnya dan bersukacita."
 },
 {
   "id": 14396,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 3,
   "firman": "(34-4) Muliakanlah TUHAN bersama-sama dengan aku, marilah kita bersama-sama memasyhurkan nama-Nya!"
 },
 {
   "id": 14397,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 4,
   "firman": "(34-5) Aku telah mencari TUHAN, lalu Ia menjawab aku, dan melepaskan aku dari segala kegentaranku."
 },
 {
   "id": 14398,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 5,
   "firman": "(34-6) Tujukanlah pandanganmu kepada-Nya, maka mukamu akan berseri-seri, dan tidak akan malu tersipu-sipu."
 },
 {
   "id": 14399,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 6,
   "firman": "(34-7) Orang yang tertindas ini berseru, dan TUHAN mendengar; Ia menyelamatkan dia dari segala kesesakannya."
 },
 {
   "id": 14400,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 7,
   "firman": "(34-8) Malaikat TUHAN berkemah di sekeliling orang-orang yang takut akan Dia, lalu meluputkan mereka."
 },
 {
   "id": 14401,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 8,
   "firman": "(34-9) Kecaplah dan lihatlah, betapa baiknya TUHAN itu! Berbahagialah orang yang berlindung pada-Nya!"
 },
 {
   "id": 14402,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 9,
   "firman": "(34-10) Takutlah akan TUHAN, hai orang-orang-Nya yang kudus, sebab tidak berkekurangan orang yang takut akan Dia!"
 },
 {
   "id": 14403,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 10,
   "firman": "(34-11) Singa-singa muda merana kelaparan, tetapi orang-orang yang mencari TUHAN, tidak kekurangan sesuatupun yang baik."
 },
 {
   "id": 14404,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 11,
   "firman": "(34-12) Marilah anak-anak, dengarkanlah aku, takut akan TUHAN akan kuajarkan kepadamu!"
 },
 {
   "id": 14405,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 12,
   "firman": "(34-13) Siapakah orang yang menyukai hidup, yang mengingini umur panjang untuk menikmati yang baik?"
 },
 {
   "id": 14406,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 13,
   "firman": "(34-14) Jagalah lidahmu terhadap yang jahat dan bibirmu terhadap ucapan-ucapan yang menipu;"
 },
 {
   "id": 14407,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 14,
   "firman": "(34-15) jauhilah yang jahat dan lakukanlah yang baik, carilah perdamaian dan berusahalah mendapatkannya!"
 },
 {
   "id": 14408,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 15,
   "firman": "(34-16) Mata TUHAN tertuju kepada orang-orang benar, dan telinga-Nya kepada teriak mereka minta tolong;"
 },
 {
   "id": 14409,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 16,
   "firman": "(34-17) wajah TUHAN menentang orang-orang yang berbuat jahat untuk melenyapkan ingatan kepada mereka dari muka bumi."
 },
 {
   "id": 14410,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 17,
   "firman": "(34-18) Apabila orang-orang benar itu berseru-seru, maka TUHAN mendengar, dan melepaskan mereka dari segala kesesakannya."
 },
 {
   "id": 14411,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 18,
   "firman": "(34-19) TUHAN itu dekat kepada orang-orang yang patah hati, dan Ia menyelamatkan orang-orang yang remuk jiwanya."
 },
 {
   "id": 14412,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 19,
   "firman": "(34-20) Kemalangan orang benar banyak, tetapi TUHAN melepaskan dia dari semuanya itu;"
 },
 {
   "id": 14413,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 20,
   "firman": "(34-21) Ia melindungi segala tulangnya, tidak satupun yang patah."
 },
 {
   "id": 14414,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 21,
   "firman": "(34-22) Kemalangan akan mematikan orang fasik, dan siapa yang membenci orang benar akan menanggung hukuman."
 },
 {
   "id": 14415,
   "kitab": "Mzm",
   "pasal": 34,
   "ayat": 22,
   "firman": "(34-23) TUHAN membebaskan jiwa hamba-hamba-Nya, dan semua orang yang berlindung pada-Nya tidak akan menanggung hukuman."
 },
 {
   "id": 14416,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 1,
   "firman": "Dari Daud. Berbantahlah, TUHAN, melawan orang yang berbantah dengan aku, berperanglah melawan orang yang berperang melawan aku!"
 },
 {
   "id": 14417,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 2,
   "firman": "Peganglah perisai dan utar-utar, bangunlah menolong aku,"
 },
 {
   "id": 14418,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 3,
   "firman": "cabutlah tombak dan kapak menghadapi orang-orang yang mengejar aku; katakanlah kepada jiwaku: \"Akulah keselamatanmu!\""
 },
 {
   "id": 14419,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 4,
   "firman": "Biarlah mendapat malu dan kena noda, orang-orang yang ingin mencabut nyawaku; biarlah mundur dan tersipu-sipu orang-orang yang merancang kecelakaanku!"
 },
 {
   "id": 14420,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 5,
   "firman": "Biarlah mereka seperti sekam dibawa angin, didorong Malaikat TUHAN;"
 },
 {
   "id": 14421,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 6,
   "firman": "biarlah jalan mereka gelap dan licin, dan Malaikat TUHAN mengejar mereka!"
 },
 {
   "id": 14422,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 7,
   "firman": "Karena tanpa alasan mereka memasang jaring terhadap aku, tanpa alasan mereka menggali pelubang untuk nyawaku."
 },
 {
   "id": 14423,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 8,
   "firman": "Biarlah kebinasaan mendatangi dia dengan tidak disangka-sangka, jerat yang dipasangnya, biarlah menangkap dia sendiri, biarlah ia jatuh dan musnah!"
 },
 {
   "id": 14424,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 9,
   "firman": "Tetapi aku bersorak-sorak karena TUHAN, aku girang karena keselamatan dari pada-Nya;"
 },
 {
   "id": 14425,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 10,
   "firman": "segala tulangku berkata: \"Ya, TUHAN, siapakah yang seperti Engkau, yang melepaskan orang sengsara dari tangan orang yang lebih kuat dari padanya, orang sengsara dan miskin dari tangan orang yang merampasi dia?\""
 },
 {
   "id": 14426,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 11,
   "firman": "Saksi-saksi yang gemar kekerasan bangkit berdiri, apa yang tidak kuketahui, itulah yang mereka tuntut dari padaku."
 },
 {
   "id": 14427,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 12,
   "firman": "Mereka membalas kebaikanku dengan kejahatan; perasaan bulus mencekam aku."
 },
 {
   "id": 14428,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 13,
   "firman": "Tetapi aku, ketika mereka sakit, aku memakai pakaian kabung; aku menyiksa diriku dengan berpuasa, dan doaku kembali timbul dalam dadaku,"
 },
 {
   "id": 14429,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 14,
   "firman": "seolah-olah temanku atau saudarakulah yang sakit, demikianlah aku berlaku; seperti orang yang berkeluh kesah karena kematian ibu, demikianlah aku tunduk dengan pakaian kabung."
 },
 {
   "id": 14430,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 15,
   "firman": "Tetapi ketika aku tersandung jatuh, bersukacitalah mereka dan berkerumun, berkerumun melawan aku; orang-orang asing yang tidak kukenal menista aku dengan tidak henti-hentinya;"
 },
 {
   "id": 14431,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 16,
   "firman": "dengan fasik mereka mengolok-olok terus, menggertakkan giginya terhadap aku."
 },
 {
   "id": 14432,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 17,
   "firman": "Sampai berapa lama, Tuhan, Engkau memandangi saja? Selamatkanlah jiwaku dari perusakan mereka, nyawaku dari singa-singa muda!"
 },
 {
   "id": 14433,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 18,
   "firman": "Aku mau menyanyikan syukur kepada-Mu dalam jemaah yang besar, di tengah-tengah rakyat yang banyak aku mau memuji-muji Engkau."
 },
 {
   "id": 14434,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 19,
   "firman": "Janganlah sekali-kali bersukacita atas aku orang-orang yang memusuhi aku tanpa sebab, atau mengedip-ngedipkan mata orang-orang yang membenci aku tanpa alasan."
 },
 {
   "id": 14435,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 20,
   "firman": "Karena mereka tidak membicarakan damai, dan terhadap orang-orang yang rukun di negeri mereka merancangkan penipuan,"
 },
 {
   "id": 14436,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 21,
   "firman": "mereka membuka mulutnya lebar-lebar terhadap aku dan berkata: \"Syukur, syukur, mata kami telah melihatnya!\""
 },
 {
   "id": 14437,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 22,
   "firman": "Engkau telah melihatnya, TUHAN, janganlah berdiam diri, ya Tuhan, janganlah jauh dari padaku!"
 },
 {
   "id": 14438,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 23,
   "firman": "Terjagalah dan bangunlah membela hakku, membela perkaraku, ya Allahku dan Tuhanku!"
 },
 {
   "id": 14439,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 24,
   "firman": "Hakimilah aku sesuai dengan keadilan-Mu, ya TUHAN Allahku, supaya mereka jangan bersukacita atasku!"
 },
 {
   "id": 14440,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 25,
   "firman": "Janganlah mereka berkata dalam hatinya: \"Syukur, itulah keinginan kami!\" Dan janganlah mereka berkata: \"Kami telah menelannya!\""
 },
 {
   "id": 14441,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 26,
   "firman": "Biarlah bersama-sama mendapat malu dan tersipu-sipu orang-orang yang bersukacita atas kemalanganku; biarlah berpakaian malu dan noda orang-orang yang membesarkan dirinya terhadap aku!"
 },
 {
   "id": 14442,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 27,
   "firman": "Biarlah bersorak-sorai dan bersukacita orang-orang yang ingin melihat aku dibenarkan! Biarlah mereka tetap berkata: \"TUHAN itu besar, Dia menginginkan keselamatan hamba-Nya!\""
 },
 {
   "id": 14443,
   "kitab": "Mzm",
   "pasal": 35,
   "ayat": 28,
   "firman": "Dan lidahku akan menyebut-nyebut keadilan-Mu, memuji-muji Engkau sepanjang hari."
 },
 {
   "id": 14444,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari hamba TUHAN, dari Daud. (36-2) Dosa bertutur di lubuk hati orang fasik; rasa takut kepada Allah tidak ada pada orang itu,"
 },
 {
   "id": 14445,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 2,
   "firman": "(36-3) sebab ia membujuk dirinya, sampai orang mendapati kesalahannya dan membencinya."
 },
 {
   "id": 14446,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 3,
   "firman": "(36-4) Perkataan dari mulutnya ialah kejahatan dan tipu daya, ia berhenti berlaku bijaksana dan berbuat baik."
 },
 {
   "id": 14447,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 4,
   "firman": "(36-5) Kejahatan dirancangkannya di tempat tidurnya, ia menempatkan dirinya di jalan yang tidak baik; apa yang jahat tidak ditolaknya."
 },
 {
   "id": 14448,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 5,
   "firman": "(36-6) Ya TUHAN, kasih-Mu sampai ke langit, setia-Mu sampai ke awan."
 },
 {
   "id": 14449,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 6,
   "firman": "(36-7) Keadilan-Mu adalah seperti gunung-gunung Allah, hukum-Mu bagaikan samudera raya yang hebat. Manusia dan hewan Kauselamatkan, ya TUHAN."
 },
 {
   "id": 14450,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 7,
   "firman": "(36-8) Betapa berharganya kasih setia-Mu, ya Allah! Anak-anak manusia berlindung dalam naungan sayap-Mu."
 },
 {
   "id": 14451,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 8,
   "firman": "(36-9) Mereka mengenyangkan dirinya dengan lemak di rumah-Mu; Engkau memberi mereka minum dari sungai kesenangan-Mu."
 },
 {
   "id": 14452,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 9,
   "firman": "(36-10) Sebab pada-Mu ada sumber hayat, di dalam terang-Mu kami melihat terang."
 },
 {
   "id": 14453,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 10,
   "firman": "(36-11) Lanjutkanlah kasih setia-Mu bagi orang yang mengenal Engkau, dan keadilan-Mu bagi orang yang tulus hati!"
 },
 {
   "id": 14454,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 11,
   "firman": "(36-12) Janganlah kiranya kaki orang-orang congkak menginjak aku, dan tangan orang fasik mengusir aku."
 },
 {
   "id": 14455,
   "kitab": "Mzm",
   "pasal": 36,
   "ayat": 12,
   "firman": "(36-13) Lihat, orang-orang yang melakukan kejahatan itu jatuh; mereka dibanting dan tidak dapat bangun lagi."
 },
 {
   "id": 14456,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 1,
   "firman": "Dari Daud. Jangan marah karena orang yang berbuat jahat, jangan iri hati kepada orang yang berbuat curang;"
 },
 {
   "id": 14457,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 2,
   "firman": "sebab mereka segera lisut seperti rumput dan layu seperti tumbuh-tumbuhan hijau."
 },
 {
   "id": 14458,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 3,
   "firman": "Percayalah kepada TUHAN dan lakukanlah yang baik, diamlah di negeri dan berlakulah setia,"
 },
 {
   "id": 14459,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 4,
   "firman": "dan bergembiralah karena TUHAN; maka Ia akan memberikan kepadamu apa yang diinginkan hatimu."
 },
 {
   "id": 14460,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 5,
   "firman": "Serahkanlah hidupmu kepada TUHAN dan percayalah kepada-Nya, dan Ia akan bertindak;"
 },
 {
   "id": 14461,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 6,
   "firman": "Ia akan memunculkan kebenaranmu seperti terang, dan hakmu seperti siang."
 },
 {
   "id": 14462,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 7,
   "firman": "Berdiam dirilah di hadapan TUHAN dan nantikanlah Dia; jangan marah karena orang yang berhasil dalam hidupnya, karena orang yang melakukan tipu daya."
 },
 {
   "id": 14463,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 8,
   "firman": "Berhentilah marah dan tinggalkanlah panas hati itu, jangan marah, itu hanya membawa kepada kejahatan."
 },
 {
   "id": 14464,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 9,
   "firman": "Sebab orang-orang yang berbuat jahat akan dilenyapkan, tetapi orang-orang yang menanti-nantikan TUHAN akan mewarisi negeri."
 },
 {
   "id": 14465,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 10,
   "firman": "Karena sedikit waktu lagi, maka lenyaplah orang fasik; jika engkau memperhatikan tempatnya, maka ia sudah tidak ada lagi."
 },
 {
   "id": 14466,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 11,
   "firman": "Tetapi orang-orang yang rendah hati akan mewarisi negeri dan bergembira karena kesejahteraan yang berlimpah-limpah."
 },
 {
   "id": 14467,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 12,
   "firman": "Orang fasik merencanakan kejahatan terhadap orang benar dan menggertakkan giginya terhadap dia;"
 },
 {
   "id": 14468,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 13,
   "firman": "Tuhan menertawakan orang fasik itu, sebab Ia melihat bahwa harinya sudah dekat."
 },
 {
   "id": 14469,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 14,
   "firman": "Orang-orang fasik menghunus pedang dan melentur busur mereka untuk merobohkan orang-orang sengsara dan orang-orang miskin, untuk membunuh orang-orang yang hidup jujur;"
 },
 {
   "id": 14470,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 15,
   "firman": "tetapi pedang mereka akan menikam dada mereka sendiri, dan busur mereka akan dipatahkan."
 },
 {
   "id": 14471,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 16,
   "firman": "Lebih baik yang sedikit pada orang benar dari pada yang berlimpah-limpah pada orang fasik;"
 },
 {
   "id": 14472,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 17,
   "firman": "sebab lengan orang-orang fasik dipatahkan, tetapi TUHAN menopang orang-orang benar."
 },
 {
   "id": 14473,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 18,
   "firman": "TUHAN mengetahui hari-hari orang yang saleh, dan milik pusaka mereka akan tetap selama-lamanya;"
 },
 {
   "id": 14474,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 19,
   "firman": "mereka tidak akan mendapat malu pada waktu kecelakaan, dan mereka akan menjadi kenyang pada hari-hari kelaparan."
 },
 {
   "id": 14475,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 20,
   "firman": "Sesungguhnya, orang-orang fasik akan binasa; musuh TUHAN seperti keindahan padang rumput: mereka habis lenyap, habis lenyap bagaikan asap."
 },
 {
   "id": 14476,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 21,
   "firman": "Orang fasik meminjam dan tidak membayar kembali, tetapi orang benar adalah pengasih dan pemurah."
 },
 {
   "id": 14477,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 22,
   "firman": "Sesungguhnya, orang-orang yang diberkati-Nya akan mewarisi negeri, tetapi orang-orang yang dikutuki-Nya akan dilenyapkan."
 },
 {
   "id": 14478,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 23,
   "firman": "TUHAN menetapkan langkah-langkah orang yang hidupnya berkenan kepada-Nya;"
 },
 {
   "id": 14479,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 24,
   "firman": "apabila ia jatuh, tidaklah sampai tergeletak, sebab TUHAN menopang tangannya."
 },
 {
   "id": 14480,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 25,
   "firman": "Dahulu aku muda, sekarang telah menjadi tua, tetapi tidak pernah kulihat orang benar ditinggalkan, atau anak cucunya meminta-minta roti;"
 },
 {
   "id": 14481,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 26,
   "firman": "tiap hari ia menaruh belas kasihan dan memberi pinjaman, dan anak cucunya menjadi berkat."
 },
 {
   "id": 14482,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 27,
   "firman": "Jauhilah yang jahat dan lakukanlah yang baik, maka engkau akan tetap tinggal untuk selama-lamanya;"
 },
 {
   "id": 14483,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 28,
   "firman": "sebab TUHAN mencintai hukum, dan Ia tidak meninggalkan orang-orang yang dikasihi-Nya. Sampai selama-lamanya mereka akan terpelihara, tetapi anak cucu orang-orang fasik akan dilenyapkan."
 },
 {
   "id": 14484,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 29,
   "firman": "Orang-orang benar akan mewarisi negeri dan tinggal di sana senantiasa."
 },
 {
   "id": 14485,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 30,
   "firman": "Mulut orang benar mengucapkan hikmat, dan lidahnya mengatakan hukum;"
 },
 {
   "id": 14486,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 31,
   "firman": "Taurat Allahnya ada di dalam hatinya, langkah-langkahnya tidak goyah."
 },
 {
   "id": 14487,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 32,
   "firman": "Orang fasik mengintai orang benar dan berikhtiar membunuhnya;"
 },
 {
   "id": 14488,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 33,
   "firman": "TUHAN tidak menyerahkan orang benar itu ke dalam tangannya, Ia tidak membiarkannya dinyatakan fasik pada waktu diadili."
 },
 {
   "id": 14489,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 34,
   "firman": "Nantikanlah TUHAN dan tetap ikutilah jalan-Nya, maka Ia akan mengangkat engkau untuk mewarisi negeri, dan engkau akan melihat orang-orang fasik dilenyapkan."
 },
 {
   "id": 14490,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 35,
   "firman": "Aku melihat seorang fasik yang gagah sombong, yang tumbuh mekar seperti pohon aras Libanon;"
 },
 {
   "id": 14491,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 36,
   "firman": "ketika aku lewat, lenyaplah ia, aku mencarinya, tetapi tidak ditemui."
 },
 {
   "id": 14492,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 37,
   "firman": "Perhatikanlah orang yang tulus dan lihatlah kepada orang yang jujur, sebab pada orang yang suka damai akan ada masa depan;"
 },
 {
   "id": 14493,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 38,
   "firman": "tetapi pendurhaka-pendurhaka akan dibinasakan bersama-sama, dan masa depan orang-orang fasik akan dilenyapkan."
 },
 {
   "id": 14494,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 39,
   "firman": "Orang-orang benar diselamatkan oleh TUHAN; Ia adalah tempat perlindungan mereka pada waktu kesesakan;"
 },
 {
   "id": 14495,
   "kitab": "Mzm",
   "pasal": 37,
   "ayat": 40,
   "firman": "TUHAN menolong mereka dan meluputkan mereka, Ia meluputkan mereka dari tangan orang-orang fasik dan menyelamatkan mereka, sebab mereka berlindung pada-Nya."
 },
 {
   "id": 14496,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 1,
   "firman": "Mazmur Daud pada waktu mempersembahkan korban peringatan. (38-2) TUHAN, janganlah menghukum aku dalam geram-Mu, dan janganlah menghajar aku dalam kepanasan murka-Mu;"
 },
 {
   "id": 14497,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 2,
   "firman": "(38-3) sebab anak panah-Mu menembus aku, tangan-Mu telah turun menimpa aku."
 },
 {
   "id": 14498,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 3,
   "firman": "(38-4) Tidak ada yang sehat pada dagingku oleh karena amarah-Mu, tidak ada yang selamat pada tulang-tulangku oleh karena dosaku;"
 },
 {
   "id": 14499,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 4,
   "firman": "(38-5) sebab kesalahanku telah menimpa kepalaku; semuanya seperti beban berat yang menjadi terlalu berat bagiku."
 },
 {
   "id": 14500,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 5,
   "firman": "(38-6) Luka-lukaku berbau busuk, bernanah oleh karena kebodohanku;"
 },
 {
   "id": 14501,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 6,
   "firman": "(38-7) aku terbungkuk-bungkuk, sangat tertunduk; sepanjang hari aku berjalan dengan dukacita."
 },
 {
   "id": 14502,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 7,
   "firman": "(38-8) Sebab pinggangku penuh radang, tidak ada yang sehat pada dagingku;"
 },
 {
   "id": 14503,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 8,
   "firman": "(38-9) aku kehabisan tenaga dan remuk redam, aku merintih karena degap-degup jantungku."
 },
 {
   "id": 14504,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 9,
   "firman": "(38-10) Tuhan, Engkau mengetahui segala keinginanku, dan keluhkupun tidak tersembunyi bagi-Mu;"
 },
 {
   "id": 14505,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 10,
   "firman": "(38-11) jantungku berdebar-debar, kekuatanku hilang, dan cahaya matakupun lenyap dari padaku."
 },
 {
   "id": 14506,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 11,
   "firman": "(38-12) Sahabat-sahabatku dan teman-temanku menyisih karena penyakitku, dan sanak saudaraku menjauh."
 },
 {
   "id": 14507,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 12,
   "firman": "(38-13) Orang-orang yang ingin mencabut nyawaku memasang jerat, orang-orang yang mengikhtiarkan celakaku, memikirkan kehancuran dan merancangkan tipu daya sepanjang hari."
 },
 {
   "id": 14508,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 13,
   "firman": "(38-14) Tetapi aku ini seperti orang tuli, aku tidak mendengar, seperti orang bisu yang tidak membuka mulutnya;"
 },
 {
   "id": 14509,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 14,
   "firman": "(38-15) ya, aku ini seperti orang yang tidak mendengar, yang tak ada bantahan dalam mulutnya."
 },
 {
   "id": 14510,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 15,
   "firman": "(38-16) Sebab kepada-Mu, ya TUHAN, aku berharap; Engkaulah yang akan menjawab, ya Tuhan, Allahku."
 },
 {
   "id": 14511,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 16,
   "firman": "(38-17) Pikirku: \"Asal mereka jangan beria-ria karena aku, jangan membesarkan diri terhadap aku apabila kakiku goyah!\""
 },
 {
   "id": 14512,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 17,
   "firman": "(38-18) Sebab aku mulai jatuh karena tersandung, dan aku selalu dirundung kesakitan;"
 },
 {
   "id": 14513,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 18,
   "firman": "(38-19) ya, aku mengaku kesalahanku, aku cemas karena dosaku."
 },
 {
   "id": 14514,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 19,
   "firman": "(38-20) Orang-orang yang memusuhi aku besar jumlahnya, banyaklah orang-orang yang membenci aku tanpa sebab;"
 },
 {
   "id": 14515,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 20,
   "firman": "(38-21) mereka membalas yang jahat kepadaku ganti yang baik, mereka memusuhi aku, karena aku mengejar yang baik."
 },
 {
   "id": 14516,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 21,
   "firman": "(38-22) Jangan tinggalkan aku, ya TUHAN, Allahku, janganlah jauh dari padaku!"
 },
 {
   "id": 14517,
   "kitab": "Mzm",
   "pasal": 38,
   "ayat": 22,
   "firman": "(38-23) Segeralah menolong aku, ya Tuhan, keselamatanku!"
 },
 {
   "id": 14518,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Untuk Yedutun. Mazmur Daud. (39-2) Pikirku: \"Aku hendak menjaga diri, supaya jangan aku berdosa dengan lidahku; aku hendak menahan mulutku dengan kekang selama orang fasik masih ada di depanku.\""
 },
 {
   "id": 14519,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 2,
   "firman": "(39-3) Aku kelu, aku diam, aku membisu, aku jauh dari hal yang baik; tetapi penderitaanku makin berat."
 },
 {
   "id": 14520,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 3,
   "firman": "(39-4) Hatiku bergejolak dalam diriku, menyala seperti api, ketika aku berkeluh kesah; aku berbicara dengan lidahku:"
 },
 {
   "id": 14521,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 4,
   "firman": "(39-5) \"Ya TUHAN, beritahukanlah kepadaku ajalku, dan apa batas umurku, supaya aku mengetahui betapa fananya aku!"
 },
 {
   "id": 14522,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 5,
   "firman": "(39-6) Sungguh, hanya beberapa telempap saja Kautentukan umurku; bagi-Mu hidupku seperti sesuatu yang hampa. Ya, setiap manusia hanyalah kesia-siaan! Sela"
 },
 {
   "id": 14523,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 6,
   "firman": "(39-7) Ia hanyalah bayangan yang berlalu! Ia hanya mempeributkan yang sia-sia dan menimbun, tetapi tidak tahu, siapa yang meraupnya nanti."
 },
 {
   "id": 14524,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 7,
   "firman": "(39-8) Dan sekarang, apakah yang kunanti-nantikan, ya Tuhan? Kepada-Mulah aku berharap."
 },
 {
   "id": 14525,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 8,
   "firman": "(39-9) Lepaskanlah aku dari segala pelanggaranku, jangan jadikan aku celaan orang bebal!"
 },
 {
   "id": 14526,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 9,
   "firman": "(39-10) Aku kelu, tidak kubuka mulutku, sebab Engkau sendirilah yang bertindak."
 },
 {
   "id": 14527,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 10,
   "firman": "(39-11) Hindarkanlah aku dari pada pukulan-Mu, aku remuk karena serangan tangan-Mu."
 },
 {
   "id": 14528,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 11,
   "firman": "(39-12) Engkau menghajar seseorang dengan hukuman karena kesalahannya, dan menghancurkan keelokannya sama seperti gegat; sesungguhnya, setiap manusia adalah kesia-siaan belaka. Sela"
 },
 {
   "id": 14529,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 12,
   "firman": "(39-13) Dengarkanlah doaku, ya TUHAN, dan berilah telinga kepada teriakku minta tolong, janganlah berdiam diri melihat air mataku! Sebab aku menumpang pada-Mu, aku pendatang seperti semua nenek moyangku."
 },
 {
   "id": 14530,
   "kitab": "Mzm",
   "pasal": 39,
   "ayat": 13,
   "firman": "(39-14) Alihkanlah pandangan-Mu dari padaku, supaya aku bersukacita sebelum aku pergi dan tidak ada lagi!\""
 },
 {
   "id": 14531,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (40-2) Aku sangat menanti-nantikan TUHAN; lalu Ia menjenguk kepadaku dan mendengar teriakku minta tolong."
 },
 {
   "id": 14532,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 2,
   "firman": "(40-3) Ia mengangkat aku dari lobang kebinasaan, dari lumpur rawa; Ia menempatkan kakiku di atas bukit batu, menetapkan langkahku,"
 },
 {
   "id": 14533,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 3,
   "firman": "(40-4) Ia memberikan nyanyian baru dalam mulutku untuk memuji Allah kita. Banyak orang akan melihatnya dan menjadi takut, lalu percaya kepada TUHAN."
 },
 {
   "id": 14534,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 4,
   "firman": "(40-5) Berbahagialah orang, yang menaruh kepercayaannya pada TUHAN, yang tidak berpaling kepada orang-orang yang angkuh, atau kepada orang-orang yang telah menyimpang kepada kebohongan!"
 },
 {
   "id": 14535,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 5,
   "firman": "(40-6) Banyaklah yang telah Kaulakukan, ya TUHAN, Allahku, perbuatan-Mu yang ajaib dan maksud-Mu untuk kami. Tidak ada yang dapat disejajarkan dengan Engkau! Aku mau memberitakan dan mengatakannya, tetapi terlalu besar jumlahnya untuk dihitung."
 },
 {
   "id": 14536,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 6,
   "firman": "(40-7) Engkau tidak berkenan kepada korban sembelihan dan korban sajian, tetapi Engkau telah membuka telingaku; korban bakaran dan korban penghapus dosa tidak Engkau tuntut."
 },
 {
   "id": 14537,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 7,
   "firman": "(40-8) Lalu aku berkata: \"Sungguh, aku datang; dalam gulungan kitab ada tertulis tentang aku;"
 },
 {
   "id": 14538,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 8,
   "firman": "(40-9) aku suka melakukan kehendak-Mu, ya Allahku; Taurat-Mu ada dalam dadaku.\""
 },
 {
   "id": 14539,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 9,
   "firman": "(40-10) Aku mengabarkan keadilan dalam jemaah yang besar; bahkan tidak kutahan bibirku, Engkau juga yang tahu, ya TUHAN."
 },
 {
   "id": 14540,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 10,
   "firman": "(40-11) Keadilan tidaklah kusembunyikan dalam hatiku, kesetiaan-Mu dan keselamatan dari pada-Mu kubicarakan, kasih-Mu dan kebenaran-Mu tidak kudiamkan kepada jemaah yang besar."
 },
 {
   "id": 14541,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 11,
   "firman": "(40-12) Engkau, TUHAN, janganlah menahan rahmat-Mu dari padaku, kasih-Mu dan kebenaran-Mu kiranya menjaga aku selalu!"
 },
 {
   "id": 14542,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 12,
   "firman": "(40-13) Sebab malapetaka mengepung aku sampai tidak terbilang banyaknya. Aku telah terkejar oleh kesalahanku, sehingga aku tidak sanggup melihat; lebih besar jumlahnya dari rambut di kepalaku, sehingga hatiku menyerah."
 },
 {
   "id": 14543,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 13,
   "firman": "(40-14) Berkenanlah kiranya Engkau, ya TUHAN, untuk melepaskan aku; TUHAN, segeralah menolong aku!"
 },
 {
   "id": 14544,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 14,
   "firman": "(40-15) Biarlah mendapat malu dan tersipu-sipu mereka semua yang ingin mencabut nyawaku; biarlah mundur dan kena noda mereka yang mengingini kecelakaanku!"
 },
 {
   "id": 14545,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 15,
   "firman": "(40-16) Biarlah terdiam karena malu mereka yang mengatai aku: \"Syukur, syukur!\""
 },
 {
   "id": 14546,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 16,
   "firman": "(40-17) Biarlah bergembira dan bersukacita karena Engkau semua orang yang mencari Engkau; biarlah mereka yang mencintai keselamatan dari pada-Mu tetap berkata: \"TUHAN itu besar!\""
 },
 {
   "id": 14547,
   "kitab": "Mzm",
   "pasal": 40,
   "ayat": 17,
   "firman": "(40-18) Aku ini sengsara dan miskin, tetapi Tuhan memperhatikan aku. Engkaulah yang menolong aku dan meluputkan aku, ya Allahku, janganlah berlambat!"
 },
 {
   "id": 14548,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (41-2) Berbahagialah orang yang memperhatikan orang lemah! TUHAN akan meluputkan dia pada waktu celaka."
 },
 {
   "id": 14549,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 2,
   "firman": "(41-3) TUHAN akan melindungi dia dan memelihara nyawanya, sehingga ia disebut berbahagia di bumi; Engkau takkan membiarkan dia dipermainkan musuhnya!"
 },
 {
   "id": 14550,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 3,
   "firman": "(41-4) TUHAN membantu dia di ranjangnya waktu sakit; di tempat tidurnya Kaupulihkannya sama sekali dari sakitnya."
 },
 {
   "id": 14551,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 4,
   "firman": "(41-5) Kalau aku, kataku: \"TUHAN, kasihanilah aku, sembuhkanlah aku, sebab terhadap Engkaulah aku berdosa!\""
 },
 {
   "id": 14552,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 5,
   "firman": "(41-6) Musuhku mengatakan yang jahat tentang aku: \"Bilakah ia mati, dan namanya hilang lenyap?\""
 },
 {
   "id": 14553,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 6,
   "firman": "(41-7) Orang yang datang menjenguk, berkata dusta; hatinya penuh kejahatan, lalu ia keluar menceritakannya di jalan."
 },
 {
   "id": 14554,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 7,
   "firman": "(41-8) Semua orang yang benci kepadaku berbisik-bisik bersama-sama tentang aku, mereka merancangkan yang jahat terhadap aku:"
 },
 {
   "id": 14555,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 8,
   "firman": "(41-9) \"Penyakit jahanam telah menimpa dia, sekali ia berbaring, takkan bangun-bangun lagi.\""
 },
 {
   "id": 14556,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 9,
   "firman": "(41-10) Bahkan sahabat karibku yang kupercayai, yang makan rotiku, telah mengangkat tumitnya terhadap aku."
 },
 {
   "id": 14557,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 10,
   "firman": "(41-11) Tetapi Engkau, ya TUHAN, kasihanilah aku dan tegakkanlah aku, maka aku hendak mengadakan pembalasan terhadap mereka."
 },
 {
   "id": 14558,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 11,
   "firman": "(41-12) Dengan demikian aku tahu, bahwa Engkau berkenan kepadaku, apabila musuhku tidak bersorak-sorai karena aku."
 },
 {
   "id": 14559,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 12,
   "firman": "(41-13) Tetapi aku, Engkau menopang aku karena ketulusanku, Engkau membuat aku tegak di hadapan-Mu untuk selama-lamanya."
 },
 {
   "id": 14560,
   "kitab": "Mzm",
   "pasal": 41,
   "ayat": 13,
   "firman": "(41-14) Terpujilah TUHAN, Allah Israel, dari selama-lamanya sampai selama-lamanya! Amin, ya amin."
 },
 {
   "id": 14561,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Nyanyian pengajaran bani Korah. (42-2) Seperti rusa yang merindukan sungai yang berair, demikianlah jiwaku merindukan Engkau, ya Allah."
 },
 {
   "id": 14562,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 2,
   "firman": "(42-3) Jiwaku haus kepada Allah, kepada Allah yang hidup. Bilakah aku boleh datang melihat Allah?"
 },
 {
   "id": 14563,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 3,
   "firman": "(42-4) Air mataku menjadi makananku siang dan malam, karena sepanjang hari orang berkata kepadaku: \"Di mana Allahmu?\""
 },
 {
   "id": 14564,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 4,
   "firman": "(42-5) Inilah yang hendak kuingat, sementara jiwaku gundah-gulana; bagaimana aku berjalan maju dalam kepadatan manusia, mendahului mereka melangkah ke rumah Allah dengan suara sorak-sorai dan nyanyian syukur, dalam keramaian orang-orang yang mengadakan perayaan."
 },
 {
   "id": 14565,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 5,
   "firman": "(42-6) Mengapa engkau tertekan, hai jiwaku, dan gelisah di dalam diriku? Berharaplah kepada Allah! Sebab aku akan bersyukur lagi kepada-Nya, penolongku dan Allahku!"
 },
 {
   "id": 14566,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 6,
   "firman": "(42-7) Jiwaku tertekan dalam diriku, sebab itu aku teringat kepada-Mu dari tanah sungai Yordan dan pegunungan Hermon, dari gunung Mizar."
 },
 {
   "id": 14567,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 7,
   "firman": "(42-8) Samudera raya berpanggil-panggilan dengan deru air terjun-Mu; segala gelora dan gelombang-Mu bergulung melingkupi aku."
 },
 {
   "id": 14568,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 8,
   "firman": "(42-9) TUHAN memerintahkan kasih setia-Nya pada siang hari, dan pada malam hari aku menyanyikan nyanyian, suatu doa kepada Allah kehidupanku."
 },
 {
   "id": 14569,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 9,
   "firman": "(42-10) Aku berkata kepada Allah, gunung batuku: \"Mengapa Engkau melupakan aku? Mengapa aku harus hidup berkabung di bawah impitan musuh?\""
 },
 {
   "id": 14570,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 10,
   "firman": "(42-11) Seperti tikaman maut ke dalam tulangku lawanku mencela aku, sambil berkata kepadaku sepanjang hari: \"Di mana Allahmu?\""
 },
 {
   "id": 14571,
   "kitab": "Mzm",
   "pasal": 42,
   "ayat": 11,
   "firman": "(42-12) Mengapa engkau tertekan, hai jiwaku, dan mengapa engkau gelisah di dalam diriku? Berharaplah kepada Allah! Sebab aku bersyukur lagi kepada-Nya, penolongku dan Allahku!"
 },
 {
   "id": 14572,
   "kitab": "Mzm",
   "pasal": 43,
   "ayat": 1,
   "firman": "Berilah keadilan kepadaku, ya Allah, dan perjuangkanlah perkaraku terhadap kaum yang tidak saleh! Luputkanlah aku dari orang penipu dan orang curang!"
 },
 {
   "id": 14573,
   "kitab": "Mzm",
   "pasal": 43,
   "ayat": 2,
   "firman": "Sebab Engkaulah Allah tempat pengungsianku. Mengapa Engkau membuang aku? Mengapa aku harus hidup berkabung di bawah impitan musuh?"
 },
 {
   "id": 14574,
   "kitab": "Mzm",
   "pasal": 43,
   "ayat": 3,
   "firman": "Suruhlah terang-Mu dan kesetiaan-Mu datang, supaya aku dituntun dan dibawa ke gunung-Mu yang kudus dan ke tempat kediaman-Mu!"
 },
 {
   "id": 14575,
   "kitab": "Mzm",
   "pasal": 43,
   "ayat": 4,
   "firman": "Maka aku dapat pergi ke mezbah Allah, menghadap Allah, yang adalah sukacitaku dan kegembiraanku, dan bersyukur kepada-Mu dengan kecapi, ya Allah, ya Allahku!"
 },
 {
   "id": 14576,
   "kitab": "Mzm",
   "pasal": 43,
   "ayat": 5,
   "firman": "Mengapa engkau tertekan, hai jiwaku, dan mengapa engkau gelisah di dalam diriku? Berharaplah kepada Allah! Sebab aku bersyukur lagi kepada-Nya, penolongku dan Allahku!"
 },
 {
   "id": 14577,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari bani Korah. Nyanyian pengajaran. (44-2) Ya Allah, dengan telinga kami sendiri telah kami dengar, nenek moyang kami telah menceritakan kepada kami perbuatan yang telah Kaulakukan pada zaman mereka, pada zaman purbakala."
 },
 {
   "id": 14578,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 2,
   "firman": "(44-3) Engkau sendiri, dengan tangan-Mu, telah menghalau bangsa-bangsa, tetapi mereka ini Kaubiarkan bertumbuh; suku-suku bangsa telah Kaucelakakan, tetapi mereka ini Kaubiarkan berkembang."
 },
 {
   "id": 14579,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 3,
   "firman": "(44-4) Sebab bukan dengan pedang mereka menduduki negeri, bukan lengan mereka yang memberikan mereka kemenangan, melainkan tangan kanan-Mu dan lengan-Mu dan cahaya wajah-Mu, sebab Engkau berkenan kepada mereka."
 },
 {
   "id": 14580,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 4,
   "firman": "(44-5) Engkaulah Rajaku dan Allahku yang memerintahkan kemenangan bagi Yakub."
 },
 {
   "id": 14581,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 5,
   "firman": "(44-6) Dengan Engkaulah kami menanduk para lawan kami, dengan nama-Mulah kami menginjak-injak orang-orang yang bangkit menyerang kami."
 },
 {
   "id": 14582,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 6,
   "firman": "(44-7) Sebab bukan kepada panahku aku percaya, dan pedangkupun tidak memberi aku kemenangan,"
 },
 {
   "id": 14583,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 7,
   "firman": "(44-8) tetapi Engkaulah yang memberi kami kemenangan terhadap para lawan kami, dan orang-orang yang membenci kami Kauberi malu."
 },
 {
   "id": 14584,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 8,
   "firman": "(44-9) Karena Allah kami nyanyikan puji-pujian sepanjang hari, dan bagi nama-Mu kami mengucapkan syukur selama-lamanya. Sela"
 },
 {
   "id": 14585,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 9,
   "firman": "(44-10) Namun Engkau telah membuang kami dan membiarkan kami kena umpat, Engkau tidak maju bersama-sama dengan bala tentara kami."
 },
 {
   "id": 14586,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 10,
   "firman": "(44-11) Engkau membuat kami mundur dari pada lawan kami, dan orang-orang yang membenci kami mengadakan perampokan."
 },
 {
   "id": 14587,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 11,
   "firman": "(44-12) Engkau menyerahkan kami sebagai domba sembelihan dan menyerakkan kami di antara bangsa-bangsa."
 },
 {
   "id": 14588,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 12,
   "firman": "(44-13) Engkau menjual umat-Mu dengan cuma-cuma dan tidak mengambil keuntungan apa-apa dari penjualan itu."
 },
 {
   "id": 14589,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 13,
   "firman": "(44-14) Engkau membuat kami menjadi cela bagi tetangga-tetangga kami, menjadi olok-olok dan cemooh bagi orang-orang sekeliling kami."
 },
 {
   "id": 14590,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 14,
   "firman": "(44-15) Engkau membuat kami menjadi sindiran di antara bangsa-bangsa, menyebabkan suku-suku bangsa menggeleng-geleng kepala."
 },
 {
   "id": 14591,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 15,
   "firman": "(44-16) Sepanjang hari aku dihadapkan dengan nodaku, dan malu menyelimuti mukaku,"
 },
 {
   "id": 14592,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 16,
   "firman": "(44-17) karena kata-kata orang yang mencela dan menista, di hadapan musuh dan pendendam."
 },
 {
   "id": 14593,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 17,
   "firman": "(44-18) Semuanya ini telah menimpa kami, tetapi kami tidak melupakan Engkau, dan tidak mengkhianati perjanjian-Mu."
 },
 {
   "id": 14594,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 18,
   "firman": "(44-19) Hati kami tidak membangkang dan langkah kami tidak menyimpang dari jalan-Mu,"
 },
 {
   "id": 14595,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 19,
   "firman": "(44-20) walaupun Engkau telah meremukkan kami di tempat serigala, dan menyelimuti kami dengan kekelaman."
 },
 {
   "id": 14596,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 20,
   "firman": "(44-21) Seandainya kami melupakan nama Allah kami, dan menadahkan tangan kami kepada allah lain,"
 },
 {
   "id": 14597,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 21,
   "firman": "(44-22) masakan Allah tidak akan menyelidikinya? Karena Ia mengetahui rahasia hati!"
 },
 {
   "id": 14598,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 22,
   "firman": "(44-23) Oleh karena Engkau kami ada dalam bahaya maut sepanjang hari, kami dianggap sebagai domba-domba sembelihan."
 },
 {
   "id": 14599,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 23,
   "firman": "(44-24) Terjagalah! Mengapa Engkau tidur, ya Tuhan? Bangunlah! Janganlah membuang kami terus-menerus!"
 },
 {
   "id": 14600,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 24,
   "firman": "(44-25) Mengapa Engkau menyembunyikan wajah-Mu dan melupakan penindasan dan impitan terhadap kami?"
 },
 {
   "id": 14601,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 25,
   "firman": "(44-26) Sebab jiwa kami tertanam dalam debu, tubuh kami terhampar di tanah."
 },
 {
   "id": 14602,
   "kitab": "Mzm",
   "pasal": 44,
   "ayat": 26,
   "firman": "(44-27) Bersiaplah menolong kami, bebaskanlah kami karena kasih setia-Mu!"
 },
 {
   "id": 14603,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Bunga bakung. Dari bani Korah. Nyanyian pengajaran; nyanyian kasih. (45-2) Hatiku meluap dengan kata-kata indah, aku hendak menyampaikan sajakku kepada raja; lidahku ialah pena seorang jurutulis yang mahir."
 },
 {
   "id": 14604,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 2,
   "firman": "(45-3) Engkau yang terelok di antara anak-anak manusia, kemurahan tercurah pada bibirmu, sebab itu Allah telah memberkati engkau untuk selama-lamanya."
 },
 {
   "id": 14605,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 3,
   "firman": "(45-4) Ikatlah pedangmu pada pinggang, hai pahlawan, dalam keagunganmu dan semarakmu!"
 },
 {
   "id": 14606,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 4,
   "firman": "(45-5) Dalam semarakmu itu majulah demi kebenaran, perikemanusiaan dan keadilan! Biarlah tangan kananmu mengajarkan engkau perbuatan-perbuatan yang dahsyat!"
 },
 {
   "id": 14607,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 5,
   "firman": "(45-6) Anak-anak panahmu tajam, menembus jantung musuh raja; bangsa-bangsa jatuh di bawah kakimu."
 },
 {
   "id": 14608,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 6,
   "firman": "(45-7) Takhtamu kepunyaan Allah, tetap untuk seterusnya dan selamanya, dan tongkat kerajaanmu adalah tongkat kebenaran."
 },
 {
   "id": 14609,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 7,
   "firman": "(45-8) Engkau mencintai keadilan dan membenci kefasikan; sebab itu Allah, Allahmu, telah mengurapi engkau dengan minyak sebagai tanda kesukaan, melebihi teman-teman sekutumu."
 },
 {
   "id": 14610,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 8,
   "firman": "(45-9) Segala pakaianmu berbau mur, gaharu dan cendana; dari istana gading permainan kecapi menyukakan engkau;"
 },
 {
   "id": 14611,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 9,
   "firman": "(45-10) di antara mereka yang disayangi terdapat puteri-puteri raja, di sebelah kananmu berdiri permaisuri berpakaian emas dari Ofir."
 },
 {
   "id": 14612,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 10,
   "firman": "(45-11) Dengarlah, hai puteri, lihatlah, dan sendengkanlah telingamu, lupakanlah bangsamu dan seisi rumah ayahmu!"
 },
 {
   "id": 14613,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 11,
   "firman": "(45-12) Biarlah raja menjadi gairah karena keelokanmu, sebab dialah tuanmu! Sujudlah kepadanya!"
 },
 {
   "id": 14614,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 12,
   "firman": "(45-13) Puteri Tirus datang dengan pemberian-pemberian; orang-orang kaya di antara rakyat akan mengambil muka kepadamu."
 },
 {
   "id": 14615,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 13,
   "firman": "(45-14) Keindahan belaka puteri raja itu di dalam, pakaiannya berpakankan emas."
 },
 {
   "id": 14616,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 14,
   "firman": "(45-15) Dengan pakaian bersulam berwarna-warna ia dibawa kepada raja; anak-anak dara mengikutinya, yakni teman-temannya, yang didatangkan untuk dia."
 },
 {
   "id": 14617,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 15,
   "firman": "(45-16) Dengan sukacita dan sorak-sorai mereka dibawa, mereka masuk ke dalam istana raja."
 },
 {
   "id": 14618,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 16,
   "firman": "(45-17) Para bapa leluhurmu hendaknya diganti oleh anak-anakmu nanti; engkau akan mengangkat mereka menjadi pembesar di seluruh bumi."
 },
 {
   "id": 14619,
   "kitab": "Mzm",
   "pasal": 45,
   "ayat": 17,
   "firman": "(45-18) Aku mau memasyhurkan namamu turun-temurun; sebab itu bangsa-bangsa akan bersyukur kepadamu untuk seterusnya dan selamanya."
 },
 {
   "id": 14620,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari bani Korah. Dengan lagu: Alamot. Nyanyian. (46-2) Allah itu bagi kita tempat perlindungan dan kekuatan, sebagai penolong dalam kesesakan sangat terbukti."
 },
 {
   "id": 14621,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 2,
   "firman": "(46-3) Sebab itu kita tidak akan takut, sekalipun bumi berubah, sekalipun gunung-gunung goncang di dalam laut;"
 },
 {
   "id": 14622,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 3,
   "firman": "(46-4) sekalipun ribut dan berbuih airnya, sekalipun gunung-gunung goyang oleh geloranya. Sela"
 },
 {
   "id": 14623,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 4,
   "firman": "(46-5) Kota Allah, kediaman Yang Mahatinggi, disukakan oleh aliran-aliran sebuah sungai."
 },
 {
   "id": 14624,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 5,
   "firman": "(46-6) Allah ada di dalamnya, kota itu tidak akan goncang; Allah akan menolongnya menjelang pagi."
 },
 {
   "id": 14625,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 6,
   "firman": "(46-7) Bangsa-bangsa ribut, kerajaan-kerajaan goncang, Ia memperdengarkan suara-Nya, dan bumipun hancur."
 },
 {
   "id": 14626,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 7,
   "firman": "(46-8) TUHAN semesta alam menyertai kita, kota benteng kita ialah Allah Yakub. Sela"
 },
 {
   "id": 14627,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 8,
   "firman": "(46-9) Pergilah, pandanglah pekerjaan TUHAN, yang mengadakan pemusnahan di bumi,"
 },
 {
   "id": 14628,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 9,
   "firman": "(46-10) yang menghentikan peperangan sampai ke ujung bumi, yang mematahkan busur panah, menumpulkan tombak, membakar kereta-kereta perang dengan api!"
 },
 {
   "id": 14629,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 10,
   "firman": "(46-11) \"Diamlah dan ketahuilah, bahwa Akulah Allah! Aku ditinggikan di antara bangsa-bangsa, ditinggikan di bumi!\""
 },
 {
   "id": 14630,
   "kitab": "Mzm",
   "pasal": 46,
   "ayat": 11,
   "firman": "(46-12) TUHAN semesta alam menyertai kita, kota benteng kita ialah Allah Yakub. Sela"
 },
 {
   "id": 14631,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari bani Korah. Mazmur. (47-2) Hai segala bangsa, bertepuktanganlah, elu-elukanlah Allah dengan sorak-sorai!"
 },
 {
   "id": 14632,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 2,
   "firman": "(47-3) Sebab TUHAN, Yang Mahatinggi, adalah dahsyat, Raja yang besar atas seluruh bumi."
 },
 {
   "id": 14633,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 3,
   "firman": "(47-4) Ia menaklukkan bangsa-bangsa ke bawah kuasa kita, suku-suku bangsa ke bawah kaki kita,"
 },
 {
   "id": 14634,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 4,
   "firman": "(47-5) Ia memilih bagi kita tanah pusaka kita, kebanggaan Yakub yang dikasihi-Nya. Sela"
 },
 {
   "id": 14635,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 5,
   "firman": "(47-6) Allah telah naik dengan diiringi sorak-sorai, ya TUHAN itu, dengan diiringi bunyi sangkakala."
 },
 {
   "id": 14636,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 6,
   "firman": "(47-7) Bermazmurlah bagi Allah, bermazmurlah, bermazmurlah bagi Raja kita, bermazmurlah!"
 },
 {
   "id": 14637,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 7,
   "firman": "(47-8) Sebab Allah adalah Raja seluruh bumi, bermazmurlah dengan nyanyian pengajaran!"
 },
 {
   "id": 14638,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 8,
   "firman": "(47-9) Allah memerintah sebagai raja atas bangsa-bangsa, Allah bersemayam di atas takhta-Nya yang kudus."
 },
 {
   "id": 14639,
   "kitab": "Mzm",
   "pasal": 47,
   "ayat": 9,
   "firman": "(47-10) Para pemuka bangsa-bangsa berkumpul sebagai umat Allah Abraham. Sebab Allah yang empunya perisai-perisai bumi; Ia sangat dimuliakan."
 },
 {
   "id": 14640,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 1,
   "firman": "Nyanyian. Mazmur bani Korah. (48-2) Besarlah TUHAN dan sangat terpuji di kota Allah kita!"
 },
 {
   "id": 14641,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 2,
   "firman": "(48-3) Gunung-Nya yang kudus, yang menjulang permai, adalah kegirangan bagi seluruh bumi; gunung Sion itu, jauh di sebelah utara, kota Raja Besar."
 },
 {
   "id": 14642,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 3,
   "firman": "(48-4) Dalam puri-purinya Allah memperkenalkan diri-Nya sebagai benteng."
 },
 {
   "id": 14643,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 4,
   "firman": "(48-5) Sebab lihat, raja-raja datang berkumpul, mereka bersama-sama berjalan maju;"
 },
 {
   "id": 14644,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 5,
   "firman": "(48-6) demi mereka melihatnya, mereka tercengang-cengang, terkejut, lalu lari kebingungan."
 },
 {
   "id": 14645,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 6,
   "firman": "(48-7) Kegentaran menimpa mereka di sana; mereka kesakitan seperti perempuan yang hendak melahirkan."
 },
 {
   "id": 14646,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 7,
   "firman": "(48-8) Dengan angin timur Engkau memecahkan kapal-kapal Tarsis."
 },
 {
   "id": 14647,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 8,
   "firman": "(48-9) Seperti yang telah kita dengar, demikianlah juga kita lihat, di kota TUHAN semesta alam, di kota Allah kita; Allah menegakkannya untuk selama-lamanya. Sela"
 },
 {
   "id": 14648,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 9,
   "firman": "(48-10) Kami mengingat, ya Allah, kasih setia-Mu di dalam bait-Mu."
 },
 {
   "id": 14649,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 10,
   "firman": "(48-11) Seperti nama-Mu, ya Allah, demikianlah kemasyhuran-Mu sampai ke ujung bumi; tangan kanan-Mu penuh dengan keadilan."
 },
 {
   "id": 14650,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 11,
   "firman": "(48-12) Biarlah gunung Sion bersukacita; biarlah anak-anak perempuan Yehuda bersorak-sorak oleh karena penghukuman-Mu!"
 },
 {
   "id": 14651,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 12,
   "firman": "(48-13) Kelilingilah Sion dan edarilah dia, hitunglah menaranya,"
 },
 {
   "id": 14652,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 13,
   "firman": "(48-14) perhatikanlah temboknya, jalanilah puri-purinya, supaya kamu dapat menceriterakannya kepada angkatan yang kemudian:"
 },
 {
   "id": 14653,
   "kitab": "Mzm",
   "pasal": 48,
   "ayat": 14,
   "firman": "(48-15) Sesungguhnya inilah Allah, Allah kitalah Dia seterusnya dan untuk selamanya! Dialah yang memimpin kita!"
 },
 {
   "id": 14654,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari bani Korah. Mazmur. (49-2) Dengarlah, hai bangsa-bangsa sekalian, pasanglah telinga, hai semua penduduk dunia,"
 },
 {
   "id": 14655,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 2,
   "firman": "(49-3) baik yang hina maupun yang mulia, baik yang kaya maupun yang miskin bersama-sama!"
 },
 {
   "id": 14656,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 3,
   "firman": "(49-4) Mulutku akan mengucapkan hikmat, dan yang direnungkan hatiku ialah pengertian."
 },
 {
   "id": 14657,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 4,
   "firman": "(49-5) Aku akan menyendengkan telingaku kepada amsal, akan mengutarakan peribahasaku dengan bermain kecapi."
 },
 {
   "id": 14658,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 5,
   "firman": "(49-6) Mengapa aku takut pada hari-hari celaka pada waktu aku dikepung oleh kejahatan pengejar-pengejarku,"
 },
 {
   "id": 14659,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 6,
   "firman": "(49-7) mereka yang percaya akan harta bendanya, dan memegahkan diri dengan banyaknya kekayaan mereka?"
 },
 {
   "id": 14660,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 7,
   "firman": "(49-8) Tidak seorangpun dapat membebaskan dirinya, atau memberikan tebusan kepada Allah ganti nyawanya,"
 },
 {
   "id": 14661,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 8,
   "firman": "(49-9) karena terlalu mahal harga pembebasan nyawanya, dan tidak memadai untuk selama-lamanya--"
 },
 {
   "id": 14662,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 9,
   "firman": "(49-10) supaya ia tetap hidup untuk seterusnya, dan tidak melihat lobang kubur."
 },
 {
   "id": 14663,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 10,
   "firman": "(49-11) Sungguh, akan dilihatnya: orang-orang yang mempunyai hikmat mati, orang-orang bodoh dan dungupun binasa bersama-sama dan meninggalkan harta benda mereka untuk orang lain."
 },
 {
   "id": 14664,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 11,
   "firman": "(49-12) Kubur mereka ialah rumah mereka untuk selama-lamanya, tempat kediaman mereka turun-temurun; mereka menganggap ladang-ladang milik mereka."
 },
 {
   "id": 14665,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 12,
   "firman": "(49-13) Tetapi dengan segala kegemilangannya manusia tidak dapat bertahan, ia boleh disamakan dengan hewan yang dibinasakan."
 },
 {
   "id": 14666,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 13,
   "firman": "(49-14) Inilah jalannya orang-orang yang percaya kepada dirinya sendiri, ajal orang-orang yang gemar akan perkataannya sendiri. Sela"
 },
 {
   "id": 14667,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 14,
   "firman": "(49-15) Seperti domba mereka meluncur ke dalam dunia orang mati, digembalakan oleh maut; mereka turun langsung ke kubur, perawakan mereka hancur, dunia orang mati menjadi tempat kediaman mereka."
 },
 {
   "id": 14668,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 15,
   "firman": "(49-16) Tetapi Allah akan membebaskan nyawaku dari cengkeraman dunia orang mati, sebab Ia akan menarik aku. Sela"
 },
 {
   "id": 14669,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 16,
   "firman": "(49-17) Janganlah takut, apabila seseorang menjadi kaya, apabila kemuliaan keluarganya bertambah,"
 },
 {
   "id": 14670,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 17,
   "firman": "(49-18) sebab pada waktu matinya semuanya itu tidak akan dibawanya serta, kemuliaannya tidak akan turun mengikuti dia."
 },
 {
   "id": 14671,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 18,
   "firman": "(49-19) Sekalipun ia menganggap dirinya berbahagia pada masa hidupnya, sekalipun orang menyanjungnya, karena ia berbuat baik terhadap dirinya sendiri,"
 },
 {
   "id": 14672,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 19,
   "firman": "(49-20) namun ia akan sampai kepada angkatan nenek moyangnya, yang tidak akan melihat terang untuk seterusnya."
 },
 {
   "id": 14673,
   "kitab": "Mzm",
   "pasal": 49,
   "ayat": 20,
   "firman": "(49-21) Manusia, yang dengan segala kegemilangannya tidak mempunyai pengertian, boleh disamakan dengan hewan yang dibinasakan."
 },
 {
   "id": 14674,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 1,
   "firman": "Mazmur Asaf. Yang Mahakuasa, TUHAN Allah, berfirman dan memanggil bumi, dari terbitnya matahari sampai kepada terbenamnya."
 },
 {
   "id": 14675,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 2,
   "firman": "Dari Sion, puncak keindahan, Allah tampil bersinar."
 },
 {
   "id": 14676,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 3,
   "firman": "Allah kita datang dan tidak akan berdiam diri, di hadapan-Nya api menjilat, sekeliling-Nya bertiup badai yang dahsyat."
 },
 {
   "id": 14677,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 4,
   "firman": "Ia berseru kepada langit di atas, dan kepada bumi untuk mengadili umat-Nya:"
 },
 {
   "id": 14678,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 5,
   "firman": "\"Bawalah kemari orang-orang yang Kukasihi, yang mengikat perjanjian dengan Aku berdasarkan korban sembelihan!\""
 },
 {
   "id": 14679,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 6,
   "firman": "Langit memberitakan keadilan-Nya, sebab Allah sendirilah Hakim. Sela"
 },
 {
   "id": 14680,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 7,
   "firman": "\"Dengarlah, hai umat-Ku, Aku hendak berfirman, hai Israel, Aku hendak bersaksi terhadap kamu: Akulah Allah, Allahmu!"
 },
 {
   "id": 14681,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 8,
   "firman": "Bukan karena korban sembelihanmu Aku menghukum engkau; bukankah korban bakaranmu tetap ada di hadapan-Ku?"
 },
 {
   "id": 14682,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 9,
   "firman": "Tidak usah Aku mengambil lembu dari rumahmu atau kambing jantan dari kandangmu,"
 },
 {
   "id": 14683,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 10,
   "firman": "sebab punya-Kulah segala binatang hutan, dan beribu-ribu hewan di gunung."
 },
 {
   "id": 14684,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 11,
   "firman": "Aku kenal segala burung di udara, dan apa yang bergerak di padang adalah dalam kuasa-Ku."
 },
 {
   "id": 14685,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 12,
   "firman": "Jika Aku lapar, tidak usah Kukatakan kepadamu, sebab punya-Kulah dunia dan segala isinya."
 },
 {
   "id": 14686,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 13,
   "firman": "Daging lembu jantankah Aku makan, atau darah kambing jantankah Aku minum?"
 },
 {
   "id": 14687,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 14,
   "firman": "Persembahkanlah syukur sebagai korban kepada Allah dan bayarlah nazarmu kepada Yang Mahatinggi!"
 },
 {
   "id": 14688,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 15,
   "firman": "Berserulah kepada-Ku pada waktu kesesakan, Aku akan meluputkan engkau, dan engkau akan memuliakan Aku.\" Sela"
 },
 {
   "id": 14689,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 16,
   "firman": "Tetapi kepada orang fasik Allah berfirman: \"Apakah urusanmu menyelidiki ketetapan-Ku, dan menyebut-nyebut perjanjian-Ku dengan mulutmu,"
 },
 {
   "id": 14690,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 17,
   "firman": "padahal engkaulah yang membenci teguran, dan mengesampingkan firman-Ku?"
 },
 {
   "id": 14691,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 18,
   "firman": "Jika engkau melihat pencuri, maka engkau berkawan dengan dia, dan bergaul dengan orang berzinah."
 },
 {
   "id": 14692,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 19,
   "firman": "Mulutmu kaubiarkan mengucapkan yang jahat, dan pada lidahmu melekat tipu daya."
 },
 {
   "id": 14693,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 20,
   "firman": "Engkau duduk, dan mengata-ngatai saudaramu, memfitnah anak ibumu."
 },
 {
   "id": 14694,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 21,
   "firman": "Itulah yang engkau lakukan, tetapi Aku berdiam diri; engkau menyangka, bahwa Aku ini sederajat dengan engkau. Aku akan menghukum engkau dan membawa perkara ini ke hadapanmu."
 },
 {
   "id": 14695,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 22,
   "firman": "Perhatikanlah ini, hai kamu yang melupakan Allah; supaya jangan Aku menerkam, dan tidak ada yang melepaskan."
 },
 {
   "id": 14696,
   "kitab": "Mzm",
   "pasal": 50,
   "ayat": 23,
   "firman": "Siapa yang mempersembahkan syukur sebagai korban, ia memuliakan Aku; siapa yang jujur jalannya, keselamatan yang dari Allah akan Kuperlihatkan kepadanya.\""
 },
 {
   "id": 14697,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur dari Daud, (51-2) ketika nabi Natan datang kepadanya setelah ia menghampiri Batsyeba. (51-3) Kasihanilah aku, ya Allah, menurut kasih setia-Mu, hapuskanlah pelanggaranku menurut rahmat-Mu yang besar!"
 },
 {
   "id": 14698,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 2,
   "firman": "(51-4) Bersihkanlah aku seluruhnya dari kesalahanku, dan tahirkanlah aku dari dosaku!"
 },
 {
   "id": 14699,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 3,
   "firman": "(51-5) Sebab aku sendiri sadar akan pelanggaranku, aku senantiasa bergumul dengan dosaku."
 },
 {
   "id": 14700,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 4,
   "firman": "(51-6) Terhadap Engkau, terhadap Engkau sajalah aku telah berdosa dan melakukan apa yang Kauanggap jahat, supaya ternyata Engkau adil dalam putusan-Mu, bersih dalam penghukuman-Mu."
 },
 {
   "id": 14701,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 5,
   "firman": "(51-7) Sesungguhnya, dalam kesalahan aku diperanakkan, dalam dosa aku dikandung ibuku."
 },
 {
   "id": 14702,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 6,
   "firman": "(51-8) Sesungguhnya, Engkau berkenan akan kebenaran dalam batin, dan dengan diam-diam Engkau memberitahukan hikmat kepadaku."
 },
 {
   "id": 14703,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 7,
   "firman": "(51-9) Bersihkanlah aku dari pada dosaku dengan hisop, maka aku menjadi tahir, basuhlah aku, maka aku menjadi lebih putih dari salju!"
 },
 {
   "id": 14704,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 8,
   "firman": "(51-10) Biarlah aku mendengar kegirangan dan sukacita, biarlah tulang yang Kauremukkan bersorak-sorak kembali!"
 },
 {
   "id": 14705,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 9,
   "firman": "(51-11) Sembunyikanlah wajah-Mu terhadap dosaku, hapuskanlah segala kesalahanku!"
 },
 {
   "id": 14706,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 10,
   "firman": "(51-12) Jadikanlah hatiku tahir, ya Allah, dan perbaharuilah batinku dengan roh yang teguh!"
 },
 {
   "id": 14707,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 11,
   "firman": "(51-13) Janganlah membuang aku dari hadapan-Mu, dan janganlah mengambil roh-Mu yang kudus dari padaku!"
 },
 {
   "id": 14708,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 12,
   "firman": "(51-14) Bangkitkanlah kembali padaku kegirangan karena selamat yang dari pada-Mu, dan lengkapilah aku dengan roh yang rela!"
 },
 {
   "id": 14709,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 13,
   "firman": "(51-15) Maka aku akan mengajarkan jalan-Mu kepada orang-orang yang melakukan pelanggaran, supaya orang-orang berdosa berbalik kepada-Mu."
 },
 {
   "id": 14710,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 14,
   "firman": "(51-16) Lepaskanlah aku dari hutang darah, ya Allah, Allah keselamatanku, maka lidahku akan bersorak-sorai memberitakan keadilan-Mu!"
 },
 {
   "id": 14711,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 15,
   "firman": "(51-17) Ya Tuhan, bukalah bibirku, supaya mulutku memberitakan puji-pujian kepada-Mu!"
 },
 {
   "id": 14712,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 16,
   "firman": "(51-18) Sebab Engkau tidak berkenan kepada korban sembelihan; sekiranya kupersembahkan korban bakaran, Engkau tidak menyukainya."
 },
 {
   "id": 14713,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 17,
   "firman": "(51-19) Korban sembelihan kepada Allah ialah jiwa yang hancur; hati yang patah dan remuk tidak akan Kaupandang hina, ya Allah."
 },
 {
   "id": 14714,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 18,
   "firman": "(51-20) Lakukanlah kebaikan kepada Sion menurut kerelaan hati-Mu bangunkanlah tembok-tembok Yerusalem!"
 },
 {
   "id": 14715,
   "kitab": "Mzm",
   "pasal": 51,
   "ayat": 19,
   "firman": "(51-21) Maka Engkau akan berkenan kepada korban yang benar, korban bakaran dan korban yang terbakar seluruhnya; maka orang akan mengorbankan lembu jantan di atas mezbah-Mu."
 },
 {
   "id": 14716,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Nyanyian pengajaran Daud, (52-2) ketika Doeg, orang Edom itu, datang memberitahukan kepada Saul, bahwa Daud telah sampai di rumah Ahimelekh. (52-3) Mengapa engkau memegahkan diri dengan kejahatan, hai pahlawan, terhadap orang yang dikasihi Allah sepanjang hari?"
 },
 {
   "id": 14717,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 2,
   "firman": "(52-4) Engkau merancangkan penghancuran, lidahmu seperti pisau cukur yang diasah, hai engkau, penipu!"
 },
 {
   "id": 14718,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 3,
   "firman": "(52-5) Engkau mencintai yang jahat lebih dari pada yang baik, dan dusta lebih dari pada perkataan yang benar. Sela"
 },
 {
   "id": 14719,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 4,
   "firman": "(52-6) Engkau mencintai segala perkataan yang mengacaukan, hai lidah penipu!"
 },
 {
   "id": 14720,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 5,
   "firman": "(52-7) Tetapi Allah akan merobohkan engkau untuk seterusnya, Ia akan merebut engkau dan mencabut engkau dari dalam kemah, membantun engkau dari dalam negeri orang-orang hidup. Sela"
 },
 {
   "id": 14721,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 6,
   "firman": "(52-8) Maka orang-orang benar akan melihatnya dan menjadi takut, dan mereka akan menertawakannya:"
 },
 {
   "id": 14722,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 7,
   "firman": "(52-9) \"Lihatlah orang itu yang tidak menjadikan Allah tempat pengungsiannya, yang percaya akan kekayaannya yang melimpah, dan berlindung pada tindakan penghancurannya!\""
 },
 {
   "id": 14723,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 8,
   "firman": "(52-10) Tetapi aku ini seperti pohon zaitun yang menghijau di dalam rumah Allah; aku percaya akan kasih setia Allah untuk seterusnya dan selamanya."
 },
 {
   "id": 14724,
   "kitab": "Mzm",
   "pasal": 52,
   "ayat": 9,
   "firman": "(52-11) Aku hendak bersyukur kepada-Mu selama-lamanya, sebab Engkaulah yang bertindak; karena nama-Mu baik, aku hendak memasyhurkannya di depan orang-orang yang Kaukasihi!"
 },
 {
   "id": 14725,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Mahalat. Nyanyian pengajaran Daud. (53-2) Orang bebal berkata dalam hatinya: \"Tidak ada Allah!\" Busuk dan jijik kecurangan mereka, tidak ada yang berbuat baik."
 },
 {
   "id": 14726,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 2,
   "firman": "(53-3) Allah memandang ke bawah dari sorga kepada anak-anak manusia, untuk melihat apakah ada yang berakal budi dan yang mencari Allah."
 },
 {
   "id": 14727,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 3,
   "firman": "(53-4) Mereka semua telah menyimpang, sekaliannya telah bejat; tidak ada yang berbuat baik, seorangpun tidak."
 },
 {
   "id": 14728,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 4,
   "firman": "(53-5) Tidak sadarkah orang-orang yang melakukan kejahatan, yang memakan habis umat-Ku seperti memakan roti, dan yang tidak berseru kepada Allah?"
 },
 {
   "id": 14729,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 5,
   "firman": "(53-6) Di sanalah mereka ditimpa kekejutan yang besar, padahal tidak ada yang mengejutkan; sebab Allah menghamburkan tulang-tulang para pengepungmu; mereka akan dipermalukan, sebab Allah telah menolak mereka."
 },
 {
   "id": 14730,
   "kitab": "Mzm",
   "pasal": 53,
   "ayat": 6,
   "firman": "(53-7) Ya, datanglah kiranya dari Sion keselamatan bagi Israel! Apabila Allah memulihkan keadaan umat-Nya, maka Yakub akan bersorak-sorak, Israel akan bersukacita."
 },
 {
   "id": 14731,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Nyanyian pengajaran Daud, (54-2) ketika orang Zifi datang mengatakan kepada Saul: \"Daud bersembunyi kepada kami.\" (54-3) Ya Allah, selamatkanlah aku karena nama-Mu, berilah keadilan kepadaku karena keperkasaan-Mu!"
 },
 {
   "id": 14732,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 2,
   "firman": "(54-4) Ya Allah, dengarkanlah doaku, berilah telinga kepada ucapan mulutku!"
 },
 {
   "id": 14733,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 3,
   "firman": "(54-5) Sebab orang-orang yang angkuh bangkit menyerang aku, orang-orang yang sombong ingin mencabut nyawaku; mereka tidak mempedulikan Allah. Sela"
 },
 {
   "id": 14734,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 4,
   "firman": "(54-6) Sesungguhnya, Allah adalah penolongku; Tuhanlah yang menopang aku."
 },
 {
   "id": 14735,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 5,
   "firman": "(54-7) Biarlah kejahatan itu berbalik kepada seteru-seteruku; binasakanlah mereka karena kesetiaan-Mu!"
 },
 {
   "id": 14736,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 6,
   "firman": "(54-8) Dengan rela hati aku akan mempersembahkan korban kepada-Mu, bersyukur sebab nama-Mu baik, ya TUHAN."
 },
 {
   "id": 14737,
   "kitab": "Mzm",
   "pasal": 54,
   "ayat": 7,
   "firman": "(54-9) Sebab Ia melepaskan aku dari segala kesesakan, dan mataku memandangi musuhku."
 },
 {
   "id": 14738,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Nyanyian pengajaran Daud. (55-2) Berilah telinga, ya Allah, kepada doaku, janganlah bersembunyi terhadap permohonanku!"
 },
 {
   "id": 14739,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 2,
   "firman": "(55-3) Perhatikanlah aku dan jawablah aku! Aku mengembara dan menangis karena cemas,"
 },
 {
   "id": 14740,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 3,
   "firman": "(55-4) karena teriakan musuh, karena aniaya orang fasik; sebab mereka menimpakan kemalangan kepadaku, dan dengan geramnya mereka memusuhi aku."
 },
 {
   "id": 14741,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 4,
   "firman": "(55-5) Hatiku gelisah, kengerian maut telah menimpa aku."
 },
 {
   "id": 14742,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 5,
   "firman": "(55-6) Aku dirundung takut dan gentar, perasaan seram meliputi aku."
 },
 {
   "id": 14743,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 6,
   "firman": "(55-7) Pikirku: \"Sekiranya aku diberi sayap seperti merpati, aku akan terbang dan mencari tempat yang tenang,"
 },
 {
   "id": 14744,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 7,
   "firman": "(55-8) bahkan aku akan lari jauh-jauh dan bermalam di padang gurun. Sela"
 },
 {
   "id": 14745,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 8,
   "firman": "(55-9) Aku akan segera mencari tempat perlindungan terhadap angin ribut dan badai.\""
 },
 {
   "id": 14746,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 9,
   "firman": "(55-10) Bingungkanlah mereka, kacaukanlah percakapan mereka, ya Tuhan, sebab aku melihat kekerasan dan perbantahan dalam kota!"
 },
 {
   "id": 14747,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 10,
   "firman": "(55-11) Siang malam mereka mengelilingi kota itu di atas tembok-temboknya, dan di dalamnya ada kemalangan dan bencana;"
 },
 {
   "id": 14748,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 11,
   "firman": "(55-12) penghancuran ada di tengah-tengahnya, di tanah lapangnya tidak habis-habisnya ada penindasan dan tipu."
 },
 {
   "id": 14749,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 12,
   "firman": "(55-13) Kalau musuhku yang mencela aku, aku masih dapat menanggungnya; kalau pembenciku yang membesarkan diri terhadap aku, aku masih dapat menyembunyikan diri terhadap dia."
 },
 {
   "id": 14750,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 13,
   "firman": "(55-14) Tetapi engkau orang yang dekat dengan aku, temanku dan orang kepercayaanku:"
 },
 {
   "id": 14751,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 14,
   "firman": "(55-15) kami yang bersama-sama bergaul dengan baik, dan masuk rumah Allah di tengah-tengah keramaian."
 },
 {
   "id": 14752,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 15,
   "firman": "(55-16) Biarlah maut menyergap mereka, biarlah mereka turun hidup-hidup ke dalam dunia orang mati! Sebab kejahatan ada di kediaman mereka, ya dalam batin mereka."
 },
 {
   "id": 14753,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 16,
   "firman": "(55-17) Tetapi aku berseru kepada Allah, dan TUHAN akan menyelamatkan aku."
 },
 {
   "id": 14754,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 17,
   "firman": "(55-18) --Di waktu petang, pagi dan tengah hari aku cemas dan menangis; dan Ia mendengar suaraku."
 },
 {
   "id": 14755,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 18,
   "firman": "(55-19) Ia membebaskan aku dengan aman dari serangan terhadap aku, sebab berduyun-duyun mereka melawan aku."
 },
 {
   "id": 14756,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 19,
   "firman": "(55-20) Allah akan mendengar dan merendahkan mereka, --Dia yang bersemayam sejak purbakala. Sela Karena mereka tidak berubah dan mereka tidak takut akan Allah."
 },
 {
   "id": 14757,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 20,
   "firman": "(55-21) Orang itu mengacungkan tangannya kepada mereka yang hidup damai dengan dia, janjinya dilanggarnya;"
 },
 {
   "id": 14758,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 21,
   "firman": "(55-22) mulutnya lebih licin dari mentega, tetapi ia berniat menyerang; perkataannya lebih lembut dari minyak, tetapi semuanya adalah pedang terhunus."
 },
 {
   "id": 14759,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 22,
   "firman": "(55-23) Serahkanlah kuatirmu kepada TUHAN, maka Ia akan memelihara engkau! Tidak untuk selama-lamanya dibiarkan-Nya orang benar itu goyah."
 },
 {
   "id": 14760,
   "kitab": "Mzm",
   "pasal": 55,
   "ayat": 23,
   "firman": "(55-24) Tetapi Engkau, ya Allah, akan menjerumuskan mereka ke lubang sumur yang dalam; orang penumpah darah dan penipu tidak akan mencapai setengah umurnya. Tetapi aku ini percaya kepada-Mu."
 },
 {
   "id": 14761,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Merpati di pohon-pohon tarbantin yang jauh. Miktam dari Daud, ketika orang Filistin menangkap dia di Gat. (56-2) Kasihanilah aku, ya Allah, sebab orang-orang menginjak-injak aku, sepanjang hari orang memerangi dan mengimpit aku!"
 },
 {
   "id": 14762,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 2,
   "firman": "(56-3) Seteru-seteruku menginjak-injak aku sepanjang hari, bahkan banyak orang yang memerangi aku dengan sombong."
 },
 {
   "id": 14763,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 3,
   "firman": "(56-4) Waktu aku takut, aku ini percaya kepada-Mu;"
 },
 {
   "id": 14764,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 4,
   "firman": "(56-5) kepada Allah, yang firman-Nya kupuji, kepada Allah aku percaya, aku tidak takut. Apakah yang dapat dilakukan manusia terhadap aku?"
 },
 {
   "id": 14765,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 5,
   "firman": "(56-6) Sepanjang hari mereka mengacaukan perkaraku; mereka senantiasa bermaksud jahat terhadap aku."
 },
 {
   "id": 14766,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 6,
   "firman": "(56-7) Mereka mau menyerbu, mereka mengintip, mengamat-amati langkahku, seperti orang-orang yang ingin mencabut nyawaku."
 },
 {
   "id": 14767,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 7,
   "firman": "(56-8) Apakah mereka dapat luput dengan kejahatan mereka? Runtuhkanlah bangsa-bangsa dengan murka-Mu, ya Allah!"
 },
 {
   "id": 14768,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 8,
   "firman": "(56-9) Sengsaraku Engkaulah yang menghitung-hitung, air mataku Kautaruh ke dalam kirbat-Mu. Bukankah semuanya telah Kaudaftarkan?"
 },
 {
   "id": 14769,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 9,
   "firman": "(56-10) Maka musuhku akan mundur pada waktu aku berseru; aku yakin, bahwa Allah memihak kepadaku."
 },
 {
   "id": 14770,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 10,
   "firman": "(56-11) Kepada Allah, firman-Nya kupuji, kepada TUHAN, firman-Nya kupuji,"
 },
 {
   "id": 14771,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 11,
   "firman": "(56-12) kepada Allah aku percaya, aku tidak takut. Apakah yang dapat dilakukan manusia terhadap aku?"
 },
 {
   "id": 14772,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 12,
   "firman": "(56-13) Nazarku kepada-Mu, ya Allah, akan kulaksanakan, dan korban syukur akan kubayar kepada-Mu."
 },
 {
   "id": 14773,
   "kitab": "Mzm",
   "pasal": 56,
   "ayat": 13,
   "firman": "(56-14) Sebab Engkau telah meluputkan aku dari pada maut, bahkan menjaga kakiku, sehingga tidak tersandung; maka aku boleh berjalan di hadapan Allah dalam cahaya kehidupan."
 },
 {
   "id": 14774,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Jangan memusnahkan. Miktam Dari Daud, ketika ia lari dari pada Saul, ke dalam gua. (57-2) Kasihanilah aku, ya Allah, kasihanilah aku, sebab kepada-Mulah jiwaku berlindung; dalam naungan sayap-Mu aku akan berlindung, sampai berlalu penghancuran itu."
 },
 {
   "id": 14775,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 2,
   "firman": "(57-3) Aku berseru kepada Allah, Yang Mahatinggi, kepada Allah yang menyelesaikannya bagiku."
 },
 {
   "id": 14776,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 3,
   "firman": "(57-4) Kiranya Ia mengirim utusan dari sorga dan menyelamatkan aku, mencela orang-orang yang menginjak-injak aku. Sela Kiranya Allah mengirim kasih setia dan kebenaran-Nya."
 },
 {
   "id": 14777,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 4,
   "firman": "(57-5) Aku terbaring di tengah-tengah singa yang suka menerkam anak-anak manusia, yang giginya laksana tombak dan panah, dan lidahnya laksana pedang tajam."
 },
 {
   "id": 14778,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 5,
   "firman": "(57-6) Tinggikanlah diri-Mu mengatasi langit, ya Allah! Biarlah kemuliaan-Mu mengatasi seluruh bumi!"
 },
 {
   "id": 14779,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 6,
   "firman": "(57-7) Mereka memasang jaring terhadap langkah-langkahku, ditundukkannya jiwaku, mereka menggali lobang di depanku, tetapi mereka sendiri jatuh ke dalamnya. Sela"
 },
 {
   "id": 14780,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 7,
   "firman": "(57-8) Hatiku siap, ya Allah, hatiku siap; aku mau menyanyi, aku mau bermazmur."
 },
 {
   "id": 14781,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 8,
   "firman": "(57-9) Bangunlah, hai jiwaku, bangunlah, hai gambus dan kecapi, aku mau membangunkan fajar!"
 },
 {
   "id": 14782,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 9,
   "firman": "(57-10) Aku mau bersyukur kepada-Mu di antara bangsa-bangsa, ya Tuhan, aku mau bermazmur bagi-Mu di antara suku-suku bangsa;"
 },
 {
   "id": 14783,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 10,
   "firman": "(57-11) sebab kasih setia-Mu besar sampai ke langit, dan kebenaran-Mu sampai ke awan-awan."
 },
 {
   "id": 14784,
   "kitab": "Mzm",
   "pasal": 57,
   "ayat": 11,
   "firman": "(57-12) Tinggikanlah diri-Mu mengatasi langit, ya Allah! Biarlah kemuliaan-Mu mengatasi seluruh bumi!"
 },
 {
   "id": 14785,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Jangan memusnahkan. Miktam dari Daud. (58-2) Sungguhkah kamu memberi keputusan yang adil, hai para penguasa? Apakah kamu hakimi anak-anak manusia dengan jujur?"
 },
 {
   "id": 14786,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 2,
   "firman": "(58-3) Malah sesuai dengan niatmu kamu melakukan kejahatan, tanganmu, menjalankan kekerasan di bumi."
 },
 {
   "id": 14787,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 3,
   "firman": "(58-4) Sejak lahir orang-orang fasik telah menyimpang, sejak dari kandungan pendusta-pendusta telah sesat."
 },
 {
   "id": 14788,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 4,
   "firman": "(58-5) Bisa mereka serupa bisa ular, mereka seperti ular tedung tuli yang menutup telinganya,"
 },
 {
   "id": 14789,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 5,
   "firman": "(58-6) yang tidak mendengarkan suara tukang-tukang serapah atau suara pembaca mantera yang pandai."
 },
 {
   "id": 14790,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 6,
   "firman": "(58-7) Ya Allah, hancurkanlah gigi mereka dalam mulutnya, patahkanlah gigi geligi singa-singa muda, ya TUHAN!"
 },
 {
   "id": 14791,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 7,
   "firman": "(58-8) Biarlah mereka hilang seperti air yang mengalir lenyap! Biarlah mereka menjadi layu seperti rumput di jalan!"
 },
 {
   "id": 14792,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 8,
   "firman": "(58-9) Biarlah mereka seperti siput yang menjadi lendir, seperti guguran perempuan yang tidak melihat matahari."
 },
 {
   "id": 14793,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 9,
   "firman": "(58-10) Sebelum periuk-periukmu merasakan api semak duri, telah dilanda-Nya baik yang hidup segar maupun yang hangus."
 },
 {
   "id": 14794,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 10,
   "firman": "(58-11) Orang benar itu akan bersukacita, sebab ia memandang pembalasan, ia akan membasuh kakinya dalam darah orang fasik."
 },
 {
   "id": 14795,
   "kitab": "Mzm",
   "pasal": 58,
   "ayat": 11,
   "firman": "(58-12) Dan orang akan berkata: \"Sesungguhnya ada pahala bagi orang benar, sesungguhnya ada Allah yang memberi keadilan di bumi.\""
 },
 {
   "id": 14796,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Jangan memusnahkan. Miktam dari Daud, ketika Saul menyuruh orang mengawasi rumahnya untuk membunuh dia. (59-2) Lepaskanlah aku dari pada musuhku, ya Allahku; bentengilah aku terhadap orang-orang yang bangkit melawan aku."
 },
 {
   "id": 14797,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 2,
   "firman": "(59-3) Lepaskanlah aku dari pada orang-orang yang melakukan kejahatan dan selamatkanlah aku dari pada penumpah-penumpah darah."
 },
 {
   "id": 14798,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 3,
   "firman": "(59-4) Sebab sesungguhnya, mereka menghadang nyawaku; orang-orang perkasa menyerbu aku, padahal aku tidak melakukan pelanggaran, aku tidak berdosa, ya TUHAN,"
 },
 {
   "id": 14799,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 4,
   "firman": "(59-5) aku tidak bersalah, merekalah yang lari dan bersiap-siap. Marilah mendapatkan aku, dan lihatlah!"
 },
 {
   "id": 14800,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 5,
   "firman": "(59-6) Engkau, TUHAN, Allah semesta alam, adalah Allah Israel. Bangunlah untuk menghukum segala bangsa; janganlah mengasihani mereka yang melakukan kejahatan dengan berkhianat! Sela"
 },
 {
   "id": 14801,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 6,
   "firman": "(59-7) Pada waktu senja mereka datang kembali, mereka melolong seperti anjing dan mengelilingi kota."
 },
 {
   "id": 14802,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 7,
   "firman": "(59-8) Sesungguhnya, mereka menyindir dengan mulutnya; cemooh ada di bibir mereka, sebab--siapakah yang mendengarnya?"
 },
 {
   "id": 14803,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 8,
   "firman": "(59-9) Tetapi Engkau, TUHAN, menertawakan mereka, Engkau mengolok-olok segala bangsa."
 },
 {
   "id": 14804,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 9,
   "firman": "(59-10) Ya kekuatanku, aku mau berpegang pada-Mu, sebab Allah adalah kota bentengku."
 },
 {
   "id": 14805,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 10,
   "firman": "(59-11) Allahku dengan kasih setia-Nya akan menyongsong aku; Allah akan membuat aku memandang rendah seteru-seteruku."
 },
 {
   "id": 14806,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 11,
   "firman": "(59-12) Janganlah membunuh mereka, supaya bangsaku tidak lupa, halaulah mereka kian ke mari dengan kuasa-Mu, dan jatuhkanlah mereka, ya Tuhan, perisai kami!"
 },
 {
   "id": 14807,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 12,
   "firman": "(59-13) Karena dosa mulut mereka adalah perkataan bibirnya, biarlah mereka tertangkap dalam kecongkakannya. Oleh karena sumpah serapah dan dusta yang mereka ceritakan,"
 },
 {
   "id": 14808,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 13,
   "firman": "(59-14) habisilah mereka dalam geram, habisilah, sehingga mereka tidak ada lagi, supaya mereka sadar bahwa Allah memerintah di antara keturunan Yakub, sampai ke ujung bumi. Sela"
 },
 {
   "id": 14809,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 14,
   "firman": "(59-15) Pada waktu senja mereka datang kembali, mereka melolong seperti anjing dan mengelilingi kota."
 },
 {
   "id": 14810,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 15,
   "firman": "(59-16) Mereka mengembara mencari makan; apabila mereka tidak kenyang, maka mereka mengaum."
 },
 {
   "id": 14811,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 16,
   "firman": "(59-17) Tetapi aku mau menyanyikan kekuatan-Mu, pada waktu pagi aku mau bersorak-sorai karena kasih setia-Mu; sebab Engkau telah menjadi kota bentengku, tempat pelarianku pada waktu kesesakanku."
 },
 {
   "id": 14812,
   "kitab": "Mzm",
   "pasal": 59,
   "ayat": 17,
   "firman": "(59-18) Ya kekuatanku, bagi-Mu aku mau bermazmur; sebab Allah adalah kota bentengku, Allahku dengan kasih setia-Nya."
 },
 {
   "id": 14813,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Bunga bakung kesaksian. Miktam dari Daud untuk diajarkan, (60-2) ketika ia memerangi orang Aram-Mesopotamia dan orang Aram-Zoba, dan ketika Yoab pada waktu pulang telah memukul kalah dua belas ribu orang Edom di Lembah Asin. (60-3) Ya Allah, Engkau telah membuang kami, menembus pertahanan kami; Engkau telah murka; pulihkanlah kami!"
 },
 {
   "id": 14814,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 2,
   "firman": "(60-4) Engkau telah menggoncangkan bumi dan membelahnya; perbaikilah retak-retaknya, sebab bumi telah goyang."
 },
 {
   "id": 14815,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 3,
   "firman": "(60-5) Engkau telah membuat umat-Mu mengalami penderitaan yang berat, Engkau telah memberi kami minum anggur yang memusingkan."
 },
 {
   "id": 14816,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 4,
   "firman": "(60-6) Kepada mereka yang takut kepada-Mu telah Kauberikan panji-panji, tanda untuk berlindung terhadap panah. Sela"
 },
 {
   "id": 14817,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 5,
   "firman": "(60-7) Supaya terluput orang-orang yang Kaucintai, berikanlah keselamatan dengan tangan kanan-Mu dan jawablah kami!"
 },
 {
   "id": 14818,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 6,
   "firman": "(60-8) Allah telah berfirman di tempat kudus-Nya: \"Aku hendak beria-ria, Aku hendak membagi-bagikan Sikhem, dan lembah Sukot hendak Kuukur."
 },
 {
   "id": 14819,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 7,
   "firman": "(60-9) Punya-Ku Gilead dan punya-Ku Manasye, Efraim ialah pelindung kepala-Ku, Yehuda ialah tongkat kerajaan-Ku;"
 },
 {
   "id": 14820,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 8,
   "firman": "(60-10) Moab ialah tempat pembasuhan-Ku, kepada Edom Aku melemparkan kasut-Ku, karena Filistea Aku bersorak-sorai.\""
 },
 {
   "id": 14821,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 9,
   "firman": "(60-11) Siapakah yang akan membawa aku ke kota yang berkubu? Siapakah yang menuntun aku ke Edom?"
 },
 {
   "id": 14822,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 10,
   "firman": "(60-12) Bukankah Engkau, ya Allah, yang telah membuang kami, dan yang tidak maju, ya Allah, bersama-sama bala tentara kami?"
 },
 {
   "id": 14823,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 11,
   "firman": "(60-13) Berikanlah kepada kami pertolongan terhadap lawan, sebab sia-sia penyelamatan dari manusia."
 },
 {
   "id": 14824,
   "kitab": "Mzm",
   "pasal": 60,
   "ayat": 12,
   "firman": "(60-14) Dengan Allah akan kita lakukan perbuatan-perbuatan gagah perkasa, sebab Ia sendiri akan menginjak-injak para lawan kita."
 },
 {
   "id": 14825,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Dari Daud. (61-2) Dengarkanlah kiranya seruanku, ya Allah, perhatikanlah doaku!"
 },
 {
   "id": 14826,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 2,
   "firman": "(61-3) Dari ujung bumi aku berseru kepada-Mu, karena hatiku lemah lesu; tuntunlah aku ke gunung batu yang terlalu tinggi bagiku."
 },
 {
   "id": 14827,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 3,
   "firman": "(61-4) Sungguh Engkau telah menjadi tempat perlindunganku, menara yang kuat terhadap musuh."
 },
 {
   "id": 14828,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 4,
   "firman": "(61-5) Biarlah aku menumpang di dalam kemah-Mu untuk selama-lamanya, biarlah aku berlindung dalam naungan sayap-Mu! Sela"
 },
 {
   "id": 14829,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 5,
   "firman": "(61-6) Sungguh, Engkau, ya Allah, telah mendengarkan nazarku, telah memenuhi permintaan orang-orang yang takut akan nama-Mu."
 },
 {
   "id": 14830,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 6,
   "firman": "(61-7) Tambahilah umur raja, tahun-tahun hidupnya kiranya sampai turun-temurun;"
 },
 {
   "id": 14831,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 7,
   "firman": "(61-8) kiranya ia bersemayam di hadapan Allah selama-lamanya, titahkanlah kasih setia dan kebenaran menjaga dia."
 },
 {
   "id": 14832,
   "kitab": "Mzm",
   "pasal": 61,
   "ayat": 8,
   "firman": "(61-9) Maka aku hendak memazmurkan nama-Mu untuk selamanya, sedang aku membayar nazarku hari demi hari."
 },
 {
   "id": 14833,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut: Yedutun. Mazmur Daud. (62-2) Hanya dekat Allah saja aku tenang, dari pada-Nyalah keselamatanku."
 },
 {
   "id": 14834,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 2,
   "firman": "(62-3) Hanya Dialah gunung batuku dan keselamatanku, kota bentengku, aku tidak akan goyah."
 },
 {
   "id": 14835,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 3,
   "firman": "(62-4) Berapa lamakah kamu hendak menyerbu seseorang, hendak meremukkan dia, hai kamu sekalian, seperti terhadap dinding yang miring, terhadap tembok yang hendak roboh?"
 },
 {
   "id": 14836,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 4,
   "firman": "(62-5) Mereka hanya bermaksud menghempaskan dia dari kedudukannya yang tinggi; mereka suka kepada dusta; dengan mulutnya mereka memberkati, tetapi dalam hatinya mereka mengutuki. Sela"
 },
 {
   "id": 14837,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 5,
   "firman": "(62-6) Hanya pada Allah saja kiranya aku tenang, sebab dari pada-Nyalah harapanku."
 },
 {
   "id": 14838,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 6,
   "firman": "(62-7) Hanya Dialah gunung batuku dan keselamatanku, kota bentengku, aku tidak akan goyah."
 },
 {
   "id": 14839,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 7,
   "firman": "(62-8) Pada Allah ada keselamatanku dan kemuliaanku; gunung batu kekuatanku, tempat perlindunganku ialah Allah."
 },
 {
   "id": 14840,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 8,
   "firman": "(62-9) Percayalah kepada-Nya setiap waktu, hai umat, curahkanlah isi hatimu di hadapan-Nya; Allah ialah tempat perlindungan kita. Sela"
 },
 {
   "id": 14841,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 9,
   "firman": "(62-10) Hanya angin saja orang-orang yang hina, suatu dusta saja orang-orang yang mulia. Pada neraca mereka naik ke atas, mereka sekalian lebih ringan dari pada angin."
 },
 {
   "id": 14842,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 10,
   "firman": "(62-11) Janganlah percaya kepada pemerasan, janganlah menaruh harap yang sia-sia kepada perampasan; apabila harta makin bertambah, janganlah hatimu melekat padanya."
 },
 {
   "id": 14843,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 11,
   "firman": "(62-12) Satu kali Allah berfirman, dua hal yang aku dengar: bahwa kuasa dari Allah asalnya,"
 },
 {
   "id": 14844,
   "kitab": "Mzm",
   "pasal": 62,
   "ayat": 12,
   "firman": "(62-13) dan dari pada-Mu juga kasih setia, ya Tuhan; sebab Engkau membalas setiap orang menurut perbuatannya."
 },
 {
   "id": 14845,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 1,
   "firman": "Mazmur Daud, ketika ia ada di padang gurun Yehuda. (63-2) Ya Allah, Engkaulah Allahku, aku mencari Engkau, jiwaku haus kepada-Mu, tubuhku rindu kepada-Mu, seperti tanah yang kering dan tandus, tiada berair."
 },
 {
   "id": 14846,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 2,
   "firman": "(63-3) Demikianlah aku memandang kepada-Mu di tempat kudus, sambil melihat kekuatan-Mu dan kemuliaan-Mu."
 },
 {
   "id": 14847,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 3,
   "firman": "(63-4) Sebab kasih setia-Mu lebih baik dari pada hidup; bibirku akan memegahkan Engkau."
 },
 {
   "id": 14848,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 4,
   "firman": "(63-5) Demikianlah aku mau memuji Engkau seumur hidupku dan menaikkan tanganku demi nama-Mu."
 },
 {
   "id": 14849,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 5,
   "firman": "(63-6) Seperti dengan lemak dan sumsum jiwaku dikenyangkan, dan dengan bibir yang bersorak-sorai mulutku memuji-muji."
 },
 {
   "id": 14850,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 6,
   "firman": "(63-7) Apabila aku ingat kepada-Mu di tempat tidurku, merenungkan Engkau sepanjang kawal malam, --"
 },
 {
   "id": 14851,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 7,
   "firman": "(63-8) sungguh Engkau telah menjadi pertolonganku, dan dalam naungan sayap-Mu aku bersorak-sorai."
 },
 {
   "id": 14852,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 8,
   "firman": "(63-9) Jiwaku melekat kepada-Mu, tangan kanan-Mu menopang aku."
 },
 {
   "id": 14853,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 9,
   "firman": "(63-10) Tetapi orang-orang yang berikhtiar mencabut nyawaku, akan masuk ke bagian-bagian bumi yang paling bawah."
 },
 {
   "id": 14854,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 10,
   "firman": "(63-11) Mereka akan diserahkan kepada kuasa pedang, mereka akan menjadi makanan anjing hutan."
 },
 {
   "id": 14855,
   "kitab": "Mzm",
   "pasal": 63,
   "ayat": 11,
   "firman": "(63-12) Tetapi raja akan bersukacita di dalam Allah; setiap orang, yang bersumpah demi Dia, akan bermegah, karena mulut orang-orang yang mengatakan dusta akan disumbat."
 },
 {
   "id": 14856,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (64-2) Ya Allah, dengarlah suaraku pada waktu aku mengaduh, jagalah nyawaku terhadap musuh yang dahsyat."
 },
 {
   "id": 14857,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 2,
   "firman": "(64-3) Sembunyikanlah aku terhadap persepakatan orang jahat, terhadap kerusuhan orang-orang yang melakukan kejahatan,"
 },
 {
   "id": 14858,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 3,
   "firman": "(64-4) yang menajamkan lidahnya seperti pedang, yang membidikkan kata yang pahit seperti panah,"
 },
 {
   "id": 14859,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 4,
   "firman": "(64-5) untuk menembak orang yang tulus hati dari tempat yang tersembunyi; sekonyong-konyong mereka menembak dia dengan tidak takut-takut."
 },
 {
   "id": 14860,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 5,
   "firman": "(64-6) Mereka berpegang teguh pada maksud yang jahat, mereka membicarakan hendak memasang perangkap dengan sembunyi; kata mereka: \"Siapa yang melihatnya?\""
 },
 {
   "id": 14861,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 6,
   "firman": "(64-7) Mereka merancang kecurangan-kecurangan: \"Kami sudah siap, rancangan sudah rampung.\" Alangkah dalamnya batin dan hati orang!"
 },
 {
   "id": 14862,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 7,
   "firman": "(64-8) Tetapi Allah menembak mereka dengan panah; sekonyong-konyong mereka terluka."
 },
 {
   "id": 14863,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 8,
   "firman": "(64-9) Ia membuat mereka tergelincir karena lidah mereka; setiap orang yang melihat mereka menggeleng kepala."
 },
 {
   "id": 14864,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 9,
   "firman": "(64-10) Maka semua orang takut dan memberitakan perbuatan Allah, dan mengakui pekerjaan-Nya."
 },
 {
   "id": 14865,
   "kitab": "Mzm",
   "pasal": 64,
   "ayat": 10,
   "firman": "(64-11) Orang benar akan bersukacita karena TUHAN dan berlindung pada-Nya; semua orang yang jujur akan bermegah."
 },
 {
   "id": 14866,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. Nyanyian. (65-2) Bagi-Mulah puji-pujian di Sion, ya Allah; dan kepada-Mulah orang membayar nazar."
 },
 {
   "id": 14867,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 2,
   "firman": "(65-3) Engkau yang mendengarkan doa. Kepada-Mulah datang semua yang hidup"
 },
 {
   "id": 14868,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 3,
   "firman": "(65-4) karena bersalah. Bilamana pelanggaran-pelanggaran kami melebihi kekuatan kami, Engkaulah yang menghapuskannya."
 },
 {
   "id": 14869,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 4,
   "firman": "(65-5) Berbahagialah orang yang Engkau pilih dan yang Engkau suruh mendekat untuk diam di pelataran-Mu! Kiranya kami menjadi kenyang dengan segala yang baik di rumah-Mu, di bait-Mu yang kudus."
 },
 {
   "id": 14870,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 5,
   "firman": "(65-6) Dengan perbuatan-perbuatan yang dahsyat dan dengan keadilan Engkau menjawab kami, ya Allah yang menyelamatkan kami, Engkau, yang menjadi kepercayaan segala ujung bumi dan pulau-pulau yang jauh-jauh;"
 },
 {
   "id": 14871,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 6,
   "firman": "(65-7) Engkau, yang menegakkan gunung-gunung dengan kekuatan-Mu, sedang pinggang-Mu berikatkan keperkasaan;"
 },
 {
   "id": 14872,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 7,
   "firman": "(65-8) Engkau, yang meredakan deru lautan, deru gelombang-gelombangnya dan kegemparan bangsa-bangsa!"
 },
 {
   "id": 14873,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 8,
   "firman": "(65-9) Sebab itu orang-orang yang diam di ujung-ujung bumi takut kepada tanda-tanda mujizat-Mu; tempat terbitnya pagi dan petang Kaubuat bersorak-sorai."
 },
 {
   "id": 14874,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 9,
   "firman": "(65-10) Engkau mengindahkan tanah itu, mengaruniainya kelimpahan, dan membuatnya sangat kaya. Batang air Allah penuh air; Engkau menyediakan gandum bagi mereka. Ya, demikianlah Engkau menyediakannya:"
 },
 {
   "id": 14875,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 10,
   "firman": "(65-11) Engkau mengairi alur bajaknya, Engkau membasahi gumpalan-gumpalan tanahnya, dengan dirus hujan Engkau menggemburkannya; Engkau memberkati tumbuh-tumbuhannya."
 },
 {
   "id": 14876,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 11,
   "firman": "(65-12) Engkau memahkotai tahun dengan kebaikan-Mu, jejak-Mu mengeluarkan lemak;"
 },
 {
   "id": 14877,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 12,
   "firman": "(65-13) tanah-tanah padang gurun menitik, bukit-bukit berikatpinggangkan sorak-sorai;"
 },
 {
   "id": 14878,
   "kitab": "Mzm",
   "pasal": 65,
   "ayat": 13,
   "firman": "(65-14) padang-padang rumput berpakaikan kawanan kambing domba, lembah-lembah berselimutkan gandum, semuanya bersorak-sorai dan bernyanyi-nyanyi."
 },
 {
   "id": 14879,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Nyanyian Mazmur. Bersorak-sorailah bagi Allah, hai seluruh bumi,"
 },
 {
   "id": 14880,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 2,
   "firman": "mazmurkanlah kemuliaan nama-Nya, muliakanlah Dia dengan puji-pujian!"
 },
 {
   "id": 14881,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 3,
   "firman": "Katakanlah kepada Allah: \"Betapa dahsyatnya segala pekerjaan-Mu; oleh sebab kekuatan-Mu yang besar musuh-Mu tunduk menjilat kepada-Mu."
 },
 {
   "id": 14882,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 4,
   "firman": "Seluruh bumi sujud menyembah kepada-Mu, dan bermazmur bagi-Mu, memazmurkan nama-Mu.\" Sela"
 },
 {
   "id": 14883,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 5,
   "firman": "Pergilah dan lihatlah pekerjaan-pekerjaan Allah; Ia dahsyat dalam perbuatan-Nya terhadap manusia:"
 },
 {
   "id": 14884,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 6,
   "firman": "Ia mengubah laut menjadi tanah kering, dan orang-orang itu berjalan kaki menyeberangi sungai. Oleh sebab itu kita bersukacita karena Dia,"
 },
 {
   "id": 14885,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 7,
   "firman": "yang memerintah dengan perkasa untuk selama-lamanya, yang mata-Nya mengawasi bangsa-bangsa. Pemberontak-pemberontak tidak dapat meninggikan diri. Sela"
 },
 {
   "id": 14886,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 8,
   "firman": "Pujilah Allah kami, hai bangsa-bangsa, dan perdengarkanlah puji-pujian kepada-Nya!"
 },
 {
   "id": 14887,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 9,
   "firman": "Ia mempertahankan jiwa kami di dalam hidup dan tidak membiarkan kaki kami goyah."
 },
 {
   "id": 14888,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 10,
   "firman": "Sebab Engkau telah menguji kami, ya Allah, telah memurnikan kami, seperti orang memurnikan perak."
 },
 {
   "id": 14889,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 11,
   "firman": "Engkau telah membawa kami ke dalam jaring, mengenakan beban pada pinggang kami;"
 },
 {
   "id": 14890,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 12,
   "firman": "Engkau telah membiarkan orang-orang melintasi kepala kami, kami telah menempuh api dan air; tetapi Engkau telah mengeluarkan kami sehingga bebas."
 },
 {
   "id": 14891,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 13,
   "firman": "Aku akan masuk ke dalam rumah-Mu dengan membawa korban-korban bakaran, aku akan membayar kepada-Mu nazarku,"
 },
 {
   "id": 14892,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 14,
   "firman": "yang telah diucapkan bibirku, dan dikatakan mulutku pada waktu aku susah."
 },
 {
   "id": 14893,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 15,
   "firman": "Korban-korban bakaran dari binatang gemuk akan kupersembahkan kepada-Mu, dengan asap korban dari domba-domba jantan; aku akan menyediakan lembu-lembu dan kambing-kambing jantan. Sela"
 },
 {
   "id": 14894,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 16,
   "firman": "Marilah, dengarlah, hai kamu sekalian yang takut akan Allah, aku hendak menceritakan apa yang dilakukan-Nya terhadap diriku."
 },
 {
   "id": 14895,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 17,
   "firman": "Kepada-Nya aku telah berseru dengan mulutku, kini dengan lidahku aku menyanyikan pujian."
 },
 {
   "id": 14896,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 18,
   "firman": "Seandainya ada niat jahat dalam hatiku, tentulah Tuhan tidak mau mendengar."
 },
 {
   "id": 14897,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 19,
   "firman": "Sesungguhnya, Allah telah mendengar, Ia telah memperhatikan doa yang kuucapkan."
 },
 {
   "id": 14898,
   "kitab": "Mzm",
   "pasal": 66,
   "ayat": 20,
   "firman": "Terpujilah Allah, yang tidak menolak doaku dan tidak menjauhkan kasih setia-Nya dari padaku."
 },
 {
   "id": 14899,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Mazmur. Nyanyian. (67-2) Kiranya Allah mengasihani kita dan memberkati kita, kiranya Ia menyinari kita dengan wajah-Nya, Sela"
 },
 {
   "id": 14900,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 2,
   "firman": "(67-3) supaya jalan-Mu dikenal di bumi, dan keselamatan-Mu di antara segala bangsa."
 },
 {
   "id": 14901,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 3,
   "firman": "(67-4) Kiranya bangsa-bangsa bersyukur kepada-Mu, ya Allah; kiranya bangsa-bangsa semuanya bersyukur kepada-Mu."
 },
 {
   "id": 14902,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 4,
   "firman": "(67-5) Kiranya suku-suku bangsa bersukacita dan bersorak-sorai, sebab Engkau memerintah bangsa-bangsa dengan adil, dan menuntun suku-suku bangsa di atas bumi. Sela"
 },
 {
   "id": 14903,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 5,
   "firman": "(67-6) Kiranya bangsa-bangsa bersyukur kepada-Mu, ya Allah, kiranya bangsa-bangsa semuanya bersyukur kepada-Mu."
 },
 {
   "id": 14904,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 6,
   "firman": "(67-7) Tanah telah memberi hasilnya; Allah, Allah kita, memberkati kita."
 },
 {
   "id": 14905,
   "kitab": "Mzm",
   "pasal": 67,
   "ayat": 7,
   "firman": "(67-8) Allah memberkati kita; kiranya segala ujung bumi takut akan Dia!"
 },
 {
   "id": 14906,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. Nyanyian. (68-2) Allah bangkit, maka terseraklah musuh-musuh-Nya, orang-orang yang membenci Dia melarikan diri dari hadapan-Nya."
 },
 {
   "id": 14907,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 2,
   "firman": "(68-3) Seperti asap hilang tertiup, seperti lilin meleleh di depan api, demikianlah orang-orang fasik binasa di hadapan Allah."
 },
 {
   "id": 14908,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 3,
   "firman": "(68-4) Tetapi orang-orang benar bersukacita, mereka beria-ria di hadapan Allah, bergembira dan bersukacita."
 },
 {
   "id": 14909,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 4,
   "firman": "(68-5) Bernyanyilah bagi Allah, mazmurkanlah nama-Nya, buatlah jalan bagi Dia yang berkendaraan melintasi awan-awan! Nama-Nya ialah TUHAN; beria-rialah di hadapan-Nya!"
 },
 {
   "id": 14910,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 5,
   "firman": "(68-6) Bapa bagi anak yatim dan Pelindung bagi para janda, itulah Allah di kediaman-Nya yang kudus;"
 },
 {
   "id": 14911,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 6,
   "firman": "(68-7) Allah memberi tempat tinggal kepada orang-orang sebatang kara, Ia mengeluarkan orang-orang tahanan, sehingga mereka bahagia, tetapi pemberontak-pemberontak tinggal di tanah yang gundul."
 },
 {
   "id": 14912,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 7,
   "firman": "(68-8) Ya Allah, ketika Engkau maju berperang di depan umat-Mu, ketika Engkau melangkah di padang belantara, Sela"
 },
 {
   "id": 14913,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 8,
   "firman": "(68-9) bergoncanglah bumi, bahkan langit mencurahkan hujan di hadapan Allah; Sinai bergoyang di hadapan Allah, Allah Israel."
 },
 {
   "id": 14914,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 9,
   "firman": "(68-10) Hujan yang melimpah Engkau siramkan, ya Allah; Engkau memulihkan tanah milik-Mu yang gersang,"
 },
 {
   "id": 14915,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 10,
   "firman": "(68-11) sehingga kawanan hewan-Mu menetap di sana; dalam kebaikan-Mu Engkau memenuhi kebutuhan orang yang tertindas, ya Allah."
 },
 {
   "id": 14916,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 11,
   "firman": "(68-12) Tuhan menyampaikan sabda; orang-orang yang membawa kabar baik itu merupakan tentara yang besar:"
 },
 {
   "id": 14917,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 12,
   "firman": "(68-13) Raja-raja segala tentara melarikan diri, melarikan diri, dan perempuan di rumah membagi-bagi jarahan."
 },
 {
   "id": 14918,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 13,
   "firman": "(68-14) Maukah kamu berbaring di antara kandang-kandang? Sayap-sayap merpati bersalut dengan perak, bulu kepaknya dengan emas berkilau-kilauan."
 },
 {
   "id": 14919,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 14,
   "firman": "(68-15) Ketika Yang Mahakuasa menyerakkan raja-raja di sana, turunlah salju di atas gunung Zalmon."
 },
 {
   "id": 14920,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 15,
   "firman": "(68-16) Gunung Allah gunung Basan itu, gunung yang berpuncak banyak gunung Basan itu!"
 },
 {
   "id": 14921,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 16,
   "firman": "(68-17) Hai gunung-gunung yang berpuncak banyak, mengapa kamu menjeling cemburu, kepada gunung yang dikehendaki Allah menjadi tempat kedudukan-Nya? Sesungguhnya TUHAN akan diam di sana untuk seterusnya!"
 },
 {
   "id": 14922,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 17,
   "firman": "(68-18) Kereta-kereta Allah puluhan ribu, bahkan beribu-ribu banyaknya; Tuhan telah datang dari Sinai, masuk ke tempat kudus!"
 },
 {
   "id": 14923,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 18,
   "firman": "(68-19) Engkau telah naik ke tempat tinggi, telah membawa tawanan-tawanan; Engkau telah menerima persembahan-persembahan di antara manusia, bahkan dari pemberontak-pemberontak untuk diam di sana, ya TUHAN Allah."
 },
 {
   "id": 14924,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 19,
   "firman": "(68-20) Terpujilah Tuhan! Hari demi hari Ia menanggung bagi kita; Allah adalah keselamatan kita. Sela"
 },
 {
   "id": 14925,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 20,
   "firman": "(68-21) Allah bagi kita adalah Allah yang menyelamatkan, ALLAH, Tuhanku, memberi keluputan dari maut."
 },
 {
   "id": 14926,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 21,
   "firman": "(68-22) Sesungguhnya, Allah meremukkan kepala musuh-Nya, tempurung kepala yang berambut dari orang yang tetap hidup dalam kesalahan-kesalahannya."
 },
 {
   "id": 14927,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 22,
   "firman": "(68-23) Tuhan telah berfirman: \"Dari Basan akan Kubawa kembali, akan Kubawa kembali dari tempat yang dalam,"
 },
 {
   "id": 14928,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 23,
   "firman": "(68-24) supaya engkau membasuh kakimu dalam darah, dan lidah anjing-anjingmu mendapat bagiannya dari pada musuh.\""
 },
 {
   "id": 14929,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 24,
   "firman": "(68-25) Orang melihat perarakan-Mu, ya Allah, perarakan Allahku, Rajaku, ke dalam tempat kudus."
 },
 {
   "id": 14930,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 25,
   "firman": "(68-26) Di depan berjalan penyanyi-penyanyi, di belakang pemetik-pemetik kecapi, di tengah-tengah dayang-dayang yang memalu rebana."
 },
 {
   "id": 14931,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 26,
   "firman": "(68-27) \"Dalam jemaah pujilah Allah, yakni TUHAN, hai kamu yang berasal dari sumber Israel!\""
 },
 {
   "id": 14932,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 27,
   "firman": "(68-28) Itu Benyamin, yang bungsu, yang berjalan di depan mereka, pemuka-pemuka Yehuda berbondong-bondong, pemuka-pemuka Zebulon, pemuka-pemuka Naftali."
 },
 {
   "id": 14933,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 28,
   "firman": "(68-29) Kerahkanlah kekuatan-Mu, ya Allah, tunjukkanlah kekuatan-Mu, ya Allah, Engkau yang telah bertindak bagi kami."
 },
 {
   "id": 14934,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 29,
   "firman": "(68-30) Demi bait-Mu di Yerusalem, raja-raja menyampaikan persembahan kepada-Mu."
 },
 {
   "id": 14935,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 30,
   "firman": "(68-31) Hardiklah binatang-binatang di teberau, kawanan orang-orang kuat, penguasa-penguasa bangsa-bangsa! Injaklah mereka yang mengejar perak; serakkanlah bangsa-bangsa yang suka berperang!"
 },
 {
   "id": 14936,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 31,
   "firman": "(68-32) Dari Mesir orang membawa barang-barang tembaga, Etiopia bersegera mengulurkan tangannya kepada Allah."
 },
 {
   "id": 14937,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 32,
   "firman": "(68-33) Hai kerajaan-kerajaan bumi, menyanyilah bagi Allah, bermazmurlah bagi Tuhan; Sela"
 },
 {
   "id": 14938,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 33,
   "firman": "(68-34) bagi Dia yang berkendaraan melintasi langit purbakala. Perhatikanlah, Ia memperdengarkan suara-Nya, suara-Nya yang dahsyat!"
 },
 {
   "id": 14939,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 34,
   "firman": "(68-35) Akuilah kekuasaan Allah; kemegahan-Nya ada di atas Israel, kekuasaan-Nya di dalam awan-awan."
 },
 {
   "id": 14940,
   "kitab": "Mzm",
   "pasal": 68,
   "ayat": 35,
   "firman": "(68-36) Allah adalah dahsyat dari dalam tempat kudus-Nya; Allah Israel, Dia mengaruniakan kekuasaan dan kekuatan kepada umat-Nya. Terpujilah Allah!"
 },
 {
   "id": 14941,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Bunga bakung. Dari Daud. (69-2) Selamatkanlah aku, ya Allah, sebab air telah naik sampai ke leherku!"
 },
 {
   "id": 14942,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 2,
   "firman": "(69-3) Aku tenggelam ke dalam rawa yang dalam, tidak ada tempat bertumpu; aku telah terperosok ke air yang dalam, gelombang pasang menghanyutkan aku."
 },
 {
   "id": 14943,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 3,
   "firman": "(69-4) Lesu aku karena berseru-seru, kerongkonganku kering; mataku nyeri karena mengharapkan Allahku."
 },
 {
   "id": 14944,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 4,
   "firman": "(69-5) Orang-orang yang membenci aku tanpa alasan lebih banyak dari pada rambut di kepalaku; terlalu besar jumlah orang-orang yang hendak membinasakan aku, yang memusuhi aku tanpa sebab; aku dipaksa untuk mengembalikan apa yang tidak kurampas."
 },
 {
   "id": 14945,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 5,
   "firman": "(69-6) Ya Allah, Engkau mengetahui kebodohanku, kesalahan-kesalahanku tidak tersembunyi bagi-Mu."
 },
 {
   "id": 14946,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 6,
   "firman": "(69-7) Janganlah mendapat malu oleh karena aku orang-orang yang menantikan Engkau, ya Tuhan, ALLAH semesta alam! Janganlah kena noda oleh karena aku orang-orang yang mencari Engkau, ya Allah Israel!"
 },
 {
   "id": 14947,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 7,
   "firman": "(69-8) Sebab oleh karena Engkaulah aku menanggung cela, noda meliputi mukaku."
 },
 {
   "id": 14948,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 8,
   "firman": "(69-9) Aku telah menjadi orang luar bagi saudara-saudaraku, orang asing bagi anak-anak ibuku;"
 },
 {
   "id": 14949,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 9,
   "firman": "(69-10) sebab cinta untuk rumah-Mu menghanguskan aku, dan kata-kata yang mencela Engkau telah menimpa aku."
 },
 {
   "id": 14950,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 10,
   "firman": "(69-11) Aku meremukkan diriku dengan berpuasa, tetapi itupun menjadi cela bagiku;"
 },
 {
   "id": 14951,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 11,
   "firman": "(69-12) aku membuat kain kabung menjadi pakaianku, aku menjadi sindiran bagi mereka."
 },
 {
   "id": 14952,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 12,
   "firman": "(69-13) Aku menjadi buah bibir orang-orang yang duduk di pintu gerbang, dengan kecapi peminum-peminum menyanyi tentang aku."
 },
 {
   "id": 14953,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 13,
   "firman": "(69-14) Tetapi aku, aku berdoa kepada-Mu, ya TUHAN, pada waktu Engkau berkenan, ya Allah; demi kasih setia-Mu yang besar jawablah aku dengan pertolongan-Mu yang setia!"
 },
 {
   "id": 14954,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 14,
   "firman": "(69-15) Lepaskanlah aku dari dalam lumpur, supaya jangan aku tenggelam, biarlah aku dilepaskan dari orang-orang yang membenci aku, dan dari air yang dalam!"
 },
 {
   "id": 14955,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 15,
   "firman": "(69-16) Janganlah gelombang air menghanyutkan aku, atau tubir menelan aku, atau sumur menutup mulutnya di atasku."
 },
 {
   "id": 14956,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 16,
   "firman": "(69-17) Jawablah aku, ya TUHAN, sebab kasih setia-Mu baik, berpalinglah kepadaku menurut rahmat-Mu yang besar!"
 },
 {
   "id": 14957,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 17,
   "firman": "(69-18) Janganlah sembunyikan wajah-Mu kepada hamba-Mu, sebab aku tersesak; segeralah menjawab aku!"
 },
 {
   "id": 14958,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 18,
   "firman": "(69-19) Datanglah kepadaku, tebuslah aku, bebaskanlah aku oleh karena musuh-musuhku."
 },
 {
   "id": 14959,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 19,
   "firman": "(69-20) Engkau mengenal celaku, maluku dan nodaku; semua lawanku ada di hadapan-Mu."
 },
 {
   "id": 14960,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 20,
   "firman": "(69-21) Cela itu telah mematahkan hatiku, dan aku putus asa; aku menantikan belas kasihan, tetapi sia-sia, menantikan penghibur-penghibur, tetapi tidak kudapati."
 },
 {
   "id": 14961,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 21,
   "firman": "(69-22) Bahkan, mereka memberi aku makan racun, dan pada waktu aku haus, mereka memberi aku minum anggur asam."
 },
 {
   "id": 14962,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 22,
   "firman": "(69-23) Biarlah jamuan yang di depan mereka menjadi jerat, dan selamatan mereka menjadi perangkap."
 },
 {
   "id": 14963,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 23,
   "firman": "(69-24) Biarlah mata mereka menjadi gelap, sehingga mereka tidak melihat; buatlah pinggang mereka goyah senantiasa!"
 },
 {
   "id": 14964,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 24,
   "firman": "(69-25) Tumpahkanlah amarah-Mu ke atas mereka, dan biarlah murka-Mu yang menyala-nyala menimpa mereka."
 },
 {
   "id": 14965,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 25,
   "firman": "(69-26) Biarlah perkemahan mereka menjadi sunyi, dan biarlah kemah-kemah mereka tidak ada penghuninya."
 },
 {
   "id": 14966,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 26,
   "firman": "(69-27) Sebab mereka mengejar orang yang Kaupukul, mereka menambah kesakitan orang-orang yang Kautikam."
 },
 {
   "id": 14967,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 27,
   "firman": "(69-28) Tambahkanlah salah kepada salah mereka, dan janganlah sampai Engkau membenarkan mereka!"
 },
 {
   "id": 14968,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 28,
   "firman": "(69-29) Biarlah mereka dihapuskan dari kitab kehidupan, janganlah mereka tercatat bersama-sama dengan orang-orang yang benar!"
 },
 {
   "id": 14969,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 29,
   "firman": "(69-30) Tetapi aku ini tertindas dan kesakitan, keselamatan dari pada-Mu, ya Allah, kiranya melindungi aku!"
 },
 {
   "id": 14970,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 30,
   "firman": "(69-31) Aku akan memuji-muji nama Allah dengan nyanyian, mengagungkan Dia dengan nyanyian syukur;"
 },
 {
   "id": 14971,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 31,
   "firman": "(69-32) pada pemandangan Allah itu lebih baik dari pada sapi jantan, dari pada lembu jantan yang bertanduk dan berkuku belah."
 },
 {
   "id": 14972,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 32,
   "firman": "(69-33) Lihatlah, hai orang-orang yang rendah hati, dan bersukacitalah; kamu yang mencari Allah, biarlah hatimu hidup kembali!"
 },
 {
   "id": 14973,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 33,
   "firman": "(69-34) Sebab TUHAN mendengarkan orang-orang miskin, dan tidak memandang hina orang-orang-Nya dalam tahanan."
 },
 {
   "id": 14974,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 34,
   "firman": "(69-35) Biarlah langit dan bumi memuji-muji Dia, lautan dan segala yang bergerak di dalamnya."
 },
 {
   "id": 14975,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 35,
   "firman": "(69-36) Sebab Allah akan menyelamatkan Sion dan membangun kota-kota Yehuda, supaya orang-orang diam di sana dan memilikinya;"
 },
 {
   "id": 14976,
   "kitab": "Mzm",
   "pasal": 69,
   "ayat": 36,
   "firman": "(69-37) anak cucu hamba-hamba-Nya akan mewarisinya, dan orang-orang yang mencintai nama-Nya akan diam di situ."
 },
 {
   "id": 14977,
   "kitab": "Mzm",
   "pasal": 70,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dari Daud, pada waktu mempersembahkan korban peringatan. (70-2) Ya Allah, bersegeralah melepaskan aku, menolong aku, ya TUHAN!"
 },
 {
   "id": 14978,
   "kitab": "Mzm",
   "pasal": 70,
   "ayat": 2,
   "firman": "(70-3) Biarlah mendapat malu dan tersipu-sipu mereka yang ingin mencabut nyawaku; biarlah mundur dan kena noda mereka yang mengingini kecelakaanku;"
 },
 {
   "id": 14979,
   "kitab": "Mzm",
   "pasal": 70,
   "ayat": 3,
   "firman": "(70-4) biarlah berbalik karena malu mereka yang mengatakan: \"Syukur, syukur!\""
 },
 {
   "id": 14980,
   "kitab": "Mzm",
   "pasal": 70,
   "ayat": 4,
   "firman": "(70-5) Biarlah bergirang dan bersukacita karena Engkau semua orang yang mencari Engkau; biarlah mereka yang mencintai keselamatan dari pada-Mu selalu berkata: \"Allah itu besar!\""
 },
 {
   "id": 14981,
   "kitab": "Mzm",
   "pasal": 70,
   "ayat": 5,
   "firman": "(70-6) Tetapi aku ini sengsara dan miskin--ya Allah, segeralah datang! Engkaulah yang menolong aku dan meluputkan aku; ya TUHAN, janganlah lambat datang!"
 },
 {
   "id": 14982,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 1,
   "firman": "Pada-Mu, ya TUHAN, aku berlindung, janganlah sekali-kali aku mendapat malu."
 },
 {
   "id": 14983,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 2,
   "firman": "Lepaskanlah aku dan luputkanlah aku oleh karena keadilan-Mu, sendengkanlah telinga-Mu kepadaku dan selamatkanlah aku!"
 },
 {
   "id": 14984,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 3,
   "firman": "Jadilah bagiku gunung batu, tempat berteduh, kubu pertahanan untuk menyelamatkan aku; sebab Engkaulah bukit batuku dan pertahananku."
 },
 {
   "id": 14985,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 4,
   "firman": "Ya Allahku, luputkanlah aku dari tangan orang fasik, dari cengkeraman orang-orang lalim dan kejam."
 },
 {
   "id": 14986,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 5,
   "firman": "Sebab Engkaulah harapanku, ya Tuhan, kepercayaanku sejak masa muda, ya ALLAH."
 },
 {
   "id": 14987,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 6,
   "firman": "Kepada-Mulah aku bertopang mulai dari kandungan, Engkau telah mengeluarkan aku dari perut ibuku; Engkau yang selalu kupuji-puji."
 },
 {
   "id": 14988,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 7,
   "firman": "Bagi banyak orang aku seperti tanda ajaib, karena Engkaulah tempat perlindunganku yang kuat."
 },
 {
   "id": 14989,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 8,
   "firman": "Mulutku penuh dengan puji-pujian kepada-Mu, dengan penghormatan kepada-Mu sepanjang hari."
 },
 {
   "id": 14990,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 9,
   "firman": "Janganlah membuang aku pada masa tuaku, janganlah meninggalkan aku apabila kekuatanku habis."
 },
 {
   "id": 14991,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 10,
   "firman": "Sebab musuh-musuhku berkata-kata tentang aku, orang-orang yang mengincar nyawaku berunding bersama-sama"
 },
 {
   "id": 14992,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 11,
   "firman": "dan berkata: \"Allah telah meninggalkan dia, kejar dan tangkaplah dia, sebab tidak ada yang melepaskan dia!\""
 },
 {
   "id": 14993,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 12,
   "firman": "Ya Allah, janganlah jauh dari padaku! Allahku, segeralah menolong aku!"
 },
 {
   "id": 14994,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 13,
   "firman": "Biarlah mendapat malu dan menjadi habis orang-orang yang memusuhi jiwaku; biarlah berselubungkan cela dan noda orang-orang yang mengikhtiarkan celakaku!"
 },
 {
   "id": 14995,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 14,
   "firman": "Tetapi aku senantiasa mau berharap dan menambah puji-pujian kepada-Mu;"
 },
 {
   "id": 14996,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 15,
   "firman": "mulutku akan menceritakan keadilan-Mu dan keselamatan yang dari pada-Mu sepanjang hari, sebab aku tidak dapat menghitungnya."
 },
 {
   "id": 14997,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 16,
   "firman": "Aku datang dengan keperkasaan-keperkasaan Tuhan ALLAH, hendak memasyhurkan hanya keadilan-Mu saja!"
 },
 {
   "id": 14998,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 17,
   "firman": "Ya Allah, Engkau telah mengajar aku sejak kecilku, dan sampai sekarang aku memberitakan perbuatan-Mu yang ajaib;"
 },
 {
   "id": 14999,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 18,
   "firman": "juga sampai masa tuaku dan putih rambutku, ya Allah, janganlah meninggalkan aku, supaya aku memberitakan kuasa-Mu kepada angkatan ini, keperkasaan-Mu kepada semua orang yang akan datang."
 },
 {
   "id": 15000,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 19,
   "firman": "Keadilan-Mu, ya Allah, sampai ke langit. Engkau yang telah melakukan hal-hal yang besar, ya Allah, siapakah seperti Engkau?"
 },
 {
   "id": 15001,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 20,
   "firman": "Engkau yang telah membuat aku mengalami banyak kesusahan dan malapetaka, Engkau akan menghidupkan aku kembali, dan dari samudera raya bumi Engkau akan menaikkan aku kembali."
 },
 {
   "id": 15002,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 21,
   "firman": "Engkau akan menambah kebesaranku dan akan berpaling menghibur aku."
 },
 {
   "id": 15003,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 22,
   "firman": "Akupun mau menyanyikan syukur bagi-Mu dengan gambus atas kesetiaan-Mu, ya Allahku, menyanyikan mazmur bagi-Mu dengan kecapi, ya Yang Kudus Israel."
 },
 {
   "id": 15004,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 23,
   "firman": "Bibirku bersorak-sorai sementara menyanyikan mazmur bagi-Mu, juga jiwaku yang telah Kaubebaskan."
 },
 {
   "id": 15005,
   "kitab": "Mzm",
   "pasal": 71,
   "ayat": 24,
   "firman": "Lidahku juga menyebut-nyebut keadilan-Mu sepanjang hari, sebab akan mendapat malu dan tersipu-sipu orang-orang yang mengikhtiarkan celakaku."
 },
 {
   "id": 15006,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 1,
   "firman": "Dari Salomo. Ya Allah, berikanlah hukum-Mu kepada raja dan keadilan-Mu kepada putera raja!"
 },
 {
   "id": 15007,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 2,
   "firman": "Kiranya ia mengadili umat-Mu dengan keadilan dan orang-orang-Mu yang tertindas dengan hukum!"
 },
 {
   "id": 15008,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 3,
   "firman": "Kiranya gunung-gunung membawa damai sejahtera bagi bangsa, dan bukit-bukit membawa kebenaran!"
 },
 {
   "id": 15009,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 4,
   "firman": "Kiranya ia memberi keadilan kepada orang-orang yang tertindas dari bangsa itu, menolong orang-orang miskin, tetapi meremukkan pemeras-pemeras!"
 },
 {
   "id": 15010,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 5,
   "firman": "Kiranya lanjut umurnya selama ada matahari, dan selama ada bulan, turun-temurun!"
 },
 {
   "id": 15011,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 6,
   "firman": "Kiranya ia seperti hujan yang turun ke atas padang rumput, seperti dirus hujan yang menggenangi bumi!"
 },
 {
   "id": 15012,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 7,
   "firman": "Kiranya keadilan berkembang dalam zamannya dan damai sejahtera berlimpah, sampai tidak ada lagi bulan!"
 },
 {
   "id": 15013,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 8,
   "firman": "Kiranya ia memerintah dari laut ke laut, dari sungai Efrat sampai ke ujung bumi!"
 },
 {
   "id": 15014,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 9,
   "firman": "Kiranya penghuni padang belantara berlutut di depannya, dan musuh-musuhnya menjilat debu;"
 },
 {
   "id": 15015,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 10,
   "firman": "kiranya raja-raja dari Tarsis dan pulau-pulau membawa persembahan-persembahan; kiranya raja-raja dari Syeba dan Seba menyampaikan upeti!"
 },
 {
   "id": 15016,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 11,
   "firman": "Kiranya semua raja sujud menyembah kepadanya, dan segala bangsa menjadi hambanya!"
 },
 {
   "id": 15017,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 12,
   "firman": "Sebab ia akan melepaskan orang miskin yang berteriak minta tolong, orang yang tertindas, dan orang yang tidak punya penolong;"
 },
 {
   "id": 15018,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 13,
   "firman": "ia akan sayang kepada orang lemah dan orang miskin, ia akan menyelamatkan nyawa orang miskin."
 },
 {
   "id": 15019,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 14,
   "firman": "Ia akan menebus nyawa mereka dari penindasan dan kekerasan, darah mereka mahal di matanya."
 },
 {
   "id": 15020,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 15,
   "firman": "Hiduplah ia! Kiranya dipersembahkan kepadanya emas Syeba! Kiranya ia didoakan senantiasa, dan diberkati sepanjang hari!"
 },
 {
   "id": 15021,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 16,
   "firman": "Biarlah tanaman gandum berlimpah-limpah di negeri, bergelombang di puncak pegunungan; biarlah buahnya mekar bagaikan Libanon, bulir-bulirnya berkembang bagaikan rumput di bumi."
 },
 {
   "id": 15022,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 17,
   "firman": "Biarlah namanya tetap selama-lamanya, kiranya namanya semakin dikenal selama ada matahari. Kiranya segala bangsa saling memberkati dengan namanya, dan menyebut dia berbahagia."
 },
 {
   "id": 15023,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 18,
   "firman": "Terpujilah TUHAN, Allah Israel, yang melakukan perbuatan yang ajaib seorang diri!"
 },
 {
   "id": 15024,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 19,
   "firman": "Dan terpujilah kiranya nama-Nya yang mulia selama-lamanya, dan kiranya kemuliaan-Nya memenuhi seluruh bumi. Amin, ya amin."
 },
 {
   "id": 15025,
   "kitab": "Mzm",
   "pasal": 72,
   "ayat": 20,
   "firman": "Sekianlah doa-doa Daud bin Isai."
 },
 {
   "id": 15026,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 1,
   "firman": "Mazmur Asaf. Sesungguhnya Allah itu baik bagi mereka yang tulus hatinya, bagi mereka yang bersih hatinya."
 },
 {
   "id": 15027,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 2,
   "firman": "Tetapi aku, sedikit lagi maka kakiku terpeleset, nyaris aku tergelincir."
 },
 {
   "id": 15028,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 3,
   "firman": "Sebab aku cemburu kepada pembual-pembual, kalau aku melihat kemujuran orang-orang fasik."
 },
 {
   "id": 15029,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 4,
   "firman": "Sebab kesakitan tidak ada pada mereka, sehat dan gemuk tubuh mereka;"
 },
 {
   "id": 15030,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 5,
   "firman": "mereka tidak mengalami kesusahan manusia, dan mereka tidak kena tulah seperti orang lain."
 },
 {
   "id": 15031,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 6,
   "firman": "Sebab itu mereka berkalungkan kecongkakan dan berpakaian kekerasan."
 },
 {
   "id": 15032,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 7,
   "firman": "Karena kegemukan, kesalahan mereka menyolok, hati mereka meluap-luap dengan sangkaan."
 },
 {
   "id": 15033,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 8,
   "firman": "Mereka menyindir dan mengata-ngatai dengan jahatnya, hal pemerasan dibicarakan mereka dengan tinggi hati."
 },
 {
   "id": 15034,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 9,
   "firman": "Mereka membuka mulut melawan langit, dan lidah mereka membual di bumi."
 },
 {
   "id": 15035,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 10,
   "firman": "Sebab itu orang-orang berbalik kepada mereka, mendapatkan mereka seperti air yang berlimpah-limpah."
 },
 {
   "id": 15036,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 11,
   "firman": "Dan mereka berkata: \"Bagaimana Allah tahu hal itu, adakah pengetahuan pada Yang Mahatinggi?\""
 },
 {
   "id": 15037,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 12,
   "firman": "Sesungguhnya, itulah orang-orang fasik: mereka menambah harta benda dan senang selamanya!"
 },
 {
   "id": 15038,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 13,
   "firman": "Sia-sia sama sekali aku mempertahankan hati yang bersih, dan membasuh tanganku, tanda tak bersalah."
 },
 {
   "id": 15039,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 14,
   "firman": "Namun sepanjang hari aku kena tulah, dan kena hukum setiap pagi."
 },
 {
   "id": 15040,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 15,
   "firman": "Seandainya aku berkata: \"Aku mau berkata-kata seperti itu,\" maka sesungguhnya aku telah berkhianat kepada angkatan anak-anakmu."
 },
 {
   "id": 15041,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 16,
   "firman": "Tetapi ketika aku bermaksud untuk mengetahuinya, hal itu menjadi kesulitan di mataku,"
 },
 {
   "id": 15042,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 17,
   "firman": "sampai aku masuk ke dalam tempat kudus Allah, dan memperhatikan kesudahan mereka."
 },
 {
   "id": 15043,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 18,
   "firman": "Sesungguhnya di tempat-tempat licin Kautaruh mereka, Kaujatuhkan mereka sehingga hancur."
 },
 {
   "id": 15044,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 19,
   "firman": "Betapa binasa mereka dalam sekejap mata, lenyap, habis oleh karena kedahsyatan!"
 },
 {
   "id": 15045,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 20,
   "firman": "Seperti mimpi pada waktu terbangun, ya Tuhan, pada waktu terjaga, rupa mereka Kaupandang hina."
 },
 {
   "id": 15046,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 21,
   "firman": "Ketika hatiku merasa pahit dan buah pinggangku menusuk-nusuk rasanya,"
 },
 {
   "id": 15047,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 22,
   "firman": "aku dungu dan tidak mengerti, seperti hewan aku di dekat-Mu."
 },
 {
   "id": 15048,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 23,
   "firman": "Tetapi aku tetap di dekat-Mu; Engkau memegang tangan kananku."
 },
 {
   "id": 15049,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 24,
   "firman": "Dengan nasihat-Mu Engkau menuntun aku, dan kemudian Engkau mengangkat aku ke dalam kemuliaan."
 },
 {
   "id": 15050,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 25,
   "firman": "Siapa gerangan ada padaku di sorga selain Engkau? Selain Engkau tidak ada yang kuingini di bumi."
 },
 {
   "id": 15051,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 26,
   "firman": "Sekalipun dagingku dan hatiku habis lenyap, gunung batuku dan bagianku tetaplah Allah selama-lamanya."
 },
 {
   "id": 15052,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 27,
   "firman": "Sebab sesungguhnya, siapa yang jauh dari pada-Mu akan binasa; Kaubinasakan semua orang, yang berzinah dengan meninggalkan Engkau."
 },
 {
   "id": 15053,
   "kitab": "Mzm",
   "pasal": 73,
   "ayat": 28,
   "firman": "Tetapi aku, aku suka dekat pada Allah; aku menaruh tempat perlindunganku pada Tuhan ALLAH, supaya dapat menceritakan segala pekerjaan-Nya."
 },
 {
   "id": 15054,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 1,
   "firman": "Nyanyian pengajaran Asaf. Mengapa, ya Allah, Kaubuang kami untuk seterusnya? Mengapa menyala murka-Mu terhadap kambing domba gembalaan-Mu?"
 },
 {
   "id": 15055,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 2,
   "firman": "Ingatlah akan umat-Mu yang telah Kauperoleh pada zaman purbakala, yang Kautebus menjadi bangsa milik-Mu sendiri! Ingatlah akan gunung Sion yang Engkau diami."
 },
 {
   "id": 15056,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 3,
   "firman": "Ringankanlah langkah-Mu ke tempat yang rusak terus-menerus; segala-galanya telah dimusnahkan musuh di tempat kudus."
 },
 {
   "id": 15057,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 4,
   "firman": "Lawan-lawan-Mu mengaum di tempat pertemuan-Mu dan telah mendirikan panji-panji mereka sebagai tanda."
 },
 {
   "id": 15058,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 5,
   "firman": "Kelihatannya seperti orang mengayunkan tinggi-tinggi sebuah kapak kepada kayu-kayuan yang lebat,"
 },
 {
   "id": 15059,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 6,
   "firman": "dan sekarang ukir-ukirannya seluruhnya dipalu mereka dengan kapak dan beliung;"
 },
 {
   "id": 15060,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 7,
   "firman": "mereka menyulut tempat kudus-Mu dengan api, mereka menajiskan tempat kediaman nama-Mu sampai pada tanah;"
 },
 {
   "id": 15061,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 8,
   "firman": "mereka berkata dalam hatinya: \"Baiklah kita menindas mereka semuanya!\" Mereka membakar segala tempat pertemuan Allah di negeri."
 },
 {
   "id": 15062,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 9,
   "firman": "Tanda-tanda kami tidak kami lihat, tidak ada lagi nabi, dan tidak ada di antara kami yang mengetahui berapa lama lagi."
 },
 {
   "id": 15063,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 10,
   "firman": "Berapa lama lagi, ya Allah, lawan itu mencela, dan musuh menista nama-Mu terus-menerus?"
 },
 {
   "id": 15064,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 11,
   "firman": "Mengapa Engkau menarik kembali tangan-Mu, menaruh tangan kanan-Mu di dada?"
 },
 {
   "id": 15065,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 12,
   "firman": "Namun Engkau, ya Allah adalah Rajaku dari zaman purbakala, yang melakukan penyelamatan di atas bumi."
 },
 {
   "id": 15066,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 13,
   "firman": "Engkaulah yang membelah laut dengan kekuatan-Mu, yang memecahkan kepala ular-ular naga di atas muka air."
 },
 {
   "id": 15067,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 14,
   "firman": "Engkaulah yang meremukkan kepala-kepala Lewiatan, yang memberikannya menjadi makanan penghuni-penghuni padang belantara."
 },
 {
   "id": 15068,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 15,
   "firman": "Engkaulah yang membelah mata air dan sungai; Engkaulah yang mengeringkan sungai-sungai yang selalu mengalir."
 },
 {
   "id": 15069,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 16,
   "firman": "Punya-Mulah siang, punya-Mulah juga malam. Engkaulah yang menaruh benda penerang dan matahari."
 },
 {
   "id": 15070,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 17,
   "firman": "Engkaulah yang menetapkan segala batas bumi, musim kemarau dan musim hujan Engkaulah yang membuat-Nya."
 },
 {
   "id": 15071,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 18,
   "firman": "Ingatlah ini: musuh mencela, ya TUHAN, dan bangsa yang bebal itu menista nama-Mu."
 },
 {
   "id": 15072,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 19,
   "firman": "Janganlah berikan nyawa merpati-Mu kepada binatang liar! Janganlah lupakan terus-menerus nyawa orang-orang-Mu yang tertindas!"
 },
 {
   "id": 15073,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 20,
   "firman": "Pandanglah kepada perjanjian, sebab tempat-tempat gelap di bumi penuh sarang-sarang kekerasan."
 },
 {
   "id": 15074,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 21,
   "firman": "Janganlah biarkan orang yang terinjak-injak kembali dengan kena noda. Biarlah orang sengsara dan orang miskin memuji-muji nama-Mu."
 },
 {
   "id": 15075,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 22,
   "firman": "Bangunlah, ya Allah, lakukanlah perjuangan-Mu! Ingatlah akan cela kepada-Mu dari pihak orang bebal sepanjang hari."
 },
 {
   "id": 15076,
   "kitab": "Mzm",
   "pasal": 74,
   "ayat": 23,
   "firman": "Janganlah lupa suara lawan-Mu, deru orang-orang yang bangkit melawan Engkau, yang terus-menerus makin keras."
 },
 {
   "id": 15077,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Jangan memusnahkan. Mazmur Asaf. Nyanyian. (75-2) Kami bersyukur kepada-Mu, ya Allah, kami bersyukur, dan orang-orang yang menyerukan nama-Mu menceritakan perbuatan-perbuatan-Mu yang ajaib."
 },
 {
   "id": 15078,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 2,
   "firman": "(75-3) \"Apabila Aku menetapkan waktunya, Aku sendiri akan menghakimi dengan kebenaran."
 },
 {
   "id": 15079,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 3,
   "firman": "(75-4) Bumi hancur dan semua penduduknya; tetapi Akulah yang mengokohkan tiang-tiangnya.\" Sela"
 },
 {
   "id": 15080,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 4,
   "firman": "(75-5) Aku berkata kepada pembual-pembual: \"Jangan membual.\" Dan kepada orang-orang fasik: \"Jangan meninggikan tanduk!"
 },
 {
   "id": 15081,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 5,
   "firman": "(75-6) Jangan mengangkat tandukmu tinggi-tinggi, jangan berbicara dengan bertegang leher!\""
 },
 {
   "id": 15082,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 6,
   "firman": "(75-7) Sebab bukan dari timur atau dari barat dan bukan dari padang gurun datangnya peninggian itu,"
 },
 {
   "id": 15083,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 7,
   "firman": "(75-8) tetapi Allah adalah Hakim: direndahkan-Nya yang satu dan ditinggikan-Nya yang lain."
 },
 {
   "id": 15084,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 8,
   "firman": "(75-9) Sebab sebuah piala ada di tangan TUHAN, berisi anggur berbuih, penuh campuran bumbu; Ia menuang dari situ; sungguh, ampasnya akan dihirup dan diminum oleh semua orang fasik di bumi."
 },
 {
   "id": 15085,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 9,
   "firman": "(75-10) Tetapi aku hendak bersorak-sorak untuk selama-lamanya, aku hendak bermazmur bagi Allah Yakub."
 },
 {
   "id": 15086,
   "kitab": "Mzm",
   "pasal": 75,
   "ayat": 10,
   "firman": "(75-11) Segala tanduk orang-orang fasik akan dihancurkan-Nya, tetapi tanduk-tanduk orang benar akan ditinggikan."
 },
 {
   "id": 15087,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Dengan permainan kecapi. Mazmur Asaf. Nyanyian. (76-2) Allah terkenal di Yehuda, nama-Nya masyhur di Israel!"
 },
 {
   "id": 15088,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 2,
   "firman": "(76-3) Di Salem sudah ada pondok-Nya, dan kediaman-Nya di Sion!"
 },
 {
   "id": 15089,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 3,
   "firman": "(76-4) Di sanalah dipatahkan-Nya panah yang berkilat, perisai dan pedang dan alat perang. Sela"
 },
 {
   "id": 15090,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 4,
   "firman": "(76-5) Cemerlang Engkau, lebih mulia dari pada pegunungan yang ada sejak purba."
 },
 {
   "id": 15091,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 5,
   "firman": "(76-6) Orang-orang yang berani telah dijarah, mereka terlelap dalam tidurnya, dan semua orang yang gagah perkasa kehilangan kekuatannya."
 },
 {
   "id": 15092,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 6,
   "firman": "(76-7) Oleh sebab hardik-Mu, ya Allah Yakub, tertidur lelap baik pengendara maupun kuda."
 },
 {
   "id": 15093,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 7,
   "firman": "(76-8) Dahsyat Engkau! Siapakah yang tahan berdiri di hadapan-Mu pada saat Engkau murka?"
 },
 {
   "id": 15094,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 8,
   "firman": "(76-9) Dari langit Engkau memperdengarkan keputusan-Mu; bumi takut dan tertegun,"
 },
 {
   "id": 15095,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 9,
   "firman": "(76-10) pada waktu Allah bangkit untuk memberi penghukuman, untuk menyelamatkan semua yang tertindas di bumi. Sela"
 },
 {
   "id": 15096,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 10,
   "firman": "(76-11) Sesungguhnya panas hati manusia akan menjadi syukur bagi-Mu, dan sisa panas hati itu akan Kauperikatpinggangkan."
 },
 {
   "id": 15097,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 11,
   "firman": "(76-12) Bernazarlah dan bayarlah nazarmu itu kepada TUHAN, Allahmu! Biarlah semua orang yang di sekeliling-Nya menyampaikan persembahan kepada Dia yang ditakuti,"
 },
 {
   "id": 15098,
   "kitab": "Mzm",
   "pasal": 76,
   "ayat": 12,
   "firman": "(76-13) Dia yang mematahkan semangat para pemimpin, Dia yang dahsyat bagi raja-raja di bumi."
 },
 {
   "id": 15099,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut: Yedutun. Mazmur Asaf. (77-2) Aku mau berseru-seru dengan nyaring kepada Allah, dengan nyaring kepada Allah, supaya Ia mendengarkan aku."
 },
 {
   "id": 15100,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 2,
   "firman": "(77-3) Pada hari kesusahanku aku mencari Tuhan; malam-malam tanganku terulur dan tidak menjadi lesu, jiwaku enggan dihiburkan."
 },
 {
   "id": 15101,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 3,
   "firman": "(77-4) Apabila aku mengingat Allah, maka aku mengerang, apabila aku merenung, makin lemah lesulah semangatku. Sela"
 },
 {
   "id": 15102,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 4,
   "firman": "(77-5) Engkau membuat mataku tetap terbuka; aku gelisah, sehingga tidak dapat berkata-kata."
 },
 {
   "id": 15103,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 5,
   "firman": "(77-6) Aku memikir-mikir hari-hari zaman purbakala, tahun-tahun zaman dahulu aku ingat."
 },
 {
   "id": 15104,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 6,
   "firman": "(77-7) Aku sebut-sebut pada waktu malam dalam hatiku, aku merenung, dan rohku mencari-cari:"
 },
 {
   "id": 15105,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 7,
   "firman": "(77-8) \"Untuk selamanyakah Tuhan menolak dan tidak kembali bermurah hati lagi?"
 },
 {
   "id": 15106,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 8,
   "firman": "(77-9) Sudah lenyapkah untuk seterusnya kasih setia-Nya, telah berakhirkah janji itu berlaku turun-temurun?"
 },
 {
   "id": 15107,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 9,
   "firman": "(77-10) Sudah lupakah Allah menaruh kasihan, atau ditutup-Nyakah rahmat-Nya karena murka-Nya?\" Sela"
 },
 {
   "id": 15108,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 10,
   "firman": "(77-11) Maka kataku: \"Inilah yang menikam hatiku, bahwa tangan kanan Yang Mahatinggi berubah.\""
 },
 {
   "id": 15109,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 11,
   "firman": "(77-12) Aku hendak mengingat perbuatan-perbuatan TUHAN, ya, aku hendak mengingat keajaiban-keajaiban-Mu dari zaman purbakala."
 },
 {
   "id": 15110,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 12,
   "firman": "(77-13) Aku hendak menyebut-nyebut segala pekerjaan-Mu, dan merenungkan perbuatan-perbuatan-Mu."
 },
 {
   "id": 15111,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 13,
   "firman": "(77-14) Ya Allah, jalan-Mu adalah kudus! Allah manakah yang begitu besar seperti Allah kami?"
 },
 {
   "id": 15112,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 14,
   "firman": "(77-15) Engkaulah Allah yang melakukan keajaiban; Engkau telah menyatakan kuasa-Mu di antara bangsa-bangsa."
 },
 {
   "id": 15113,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 15,
   "firman": "(77-16) Dengan lengan-Mu Engkau telah menebus umat-Mu, bani Yakub dan bani Yusuf. Sela"
 },
 {
   "id": 15114,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 16,
   "firman": "(77-17) Air telah melihat Engkau, ya Allah, air telah melihat Engkau, lalu menjadi gentar, bahkan samudera raya gemetar."
 },
 {
   "id": 15115,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 17,
   "firman": "(77-18) Awan-awan mencurahkan air, awan-gemawan bergemuruh, bahkan anak-anak panah-Mu beterbangan."
 },
 {
   "id": 15116,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 18,
   "firman": "(77-19) Deru guntur-Mu menggelinding, kilat-kilat menerangi dunia, bumi gemetar dan bergoncang."
 },
 {
   "id": 15117,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 19,
   "firman": "(77-20) Melalui laut jalan-Mu dan lorong-Mu melalui muka air yang luas, tetapi jejak-Mu tidak kelihatan."
 },
 {
   "id": 15118,
   "kitab": "Mzm",
   "pasal": 77,
   "ayat": 20,
   "firman": "(77-21) Engkau telah menuntun umat-Mu seperti kawanan domba dengan perantaraan Musa dan Harun."
 },
 {
   "id": 15119,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 1,
   "firman": "Nyanyian pengajaran Asaf. Pasanglah telinga untuk pengajaranku, hai bangsaku, sendengkanlah telingamu kepada ucapan mulutku."
 },
 {
   "id": 15120,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 2,
   "firman": "Aku mau membuka mulut mengatakan amsal, aku mau mengucapkan teka-teki dari zaman purbakala."
 },
 {
   "id": 15121,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 3,
   "firman": "Yang telah kami dengar dan kami ketahui, dan yang diceritakan kepada kami oleh nenek moyang kami,"
 },
 {
   "id": 15122,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 4,
   "firman": "kami tidak hendak sembunyikan kepada anak-anak mereka, tetapi kami akan ceritakan kepada angkatan yang kemudian puji-pujian kepada TUHAN dan kekuatan-Nya dan perbuatan-perbuatan ajaib yang telah dilakukan-Nya."
 },
 {
   "id": 15123,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 5,
   "firman": "Telah ditetapkan-Nya peringatan di Yakub dan hukum Taurat diberi-Nya di Israel; nenek moyang kita diperintahkan-Nya untuk memperkenalkannya kepada anak-anak mereka,"
 },
 {
   "id": 15124,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 6,
   "firman": "supaya dikenal oleh angkatan yang kemudian, supaya anak-anak, yang akan lahir kelak, bangun dan menceritakannya kepada anak-anak mereka,"
 },
 {
   "id": 15125,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 7,
   "firman": "supaya mereka menaruh kepercayaan kepada Allah dan tidak melupakan perbuatan-perbuatan Allah, tetapi memegang perintah-perintah-Nya;"
 },
 {
   "id": 15126,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 8,
   "firman": "dan jangan seperti nenek moyang mereka, angkatan pendurhaka dan pemberontak, angkatan yang tidak tetap hatinya dan tidak setia jiwanya kepada Allah."
 },
 {
   "id": 15127,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 9,
   "firman": "Bani Efraim, pemanah-pemanah yang bersenjata lengkap, berbalik pada hari pertempuran;"
 },
 {
   "id": 15128,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 10,
   "firman": "mereka tidak berpegang pada perjanjian Allah dan enggan hidup menurut Taurat-Nya."
 },
 {
   "id": 15129,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 11,
   "firman": "Mereka melupakan pekerjaan-pekerjaan-Nya dan perbuatan-perbuatan-Nya yang ajaib, yang telah diperlihatkan-Nya kepada mereka."
 },
 {
   "id": 15130,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 12,
   "firman": "Di hadapan nenek moyang mereka dilakukan-Nya keajaiban-keajaiban, di tanah Mesir, di padang Zoan;"
 },
 {
   "id": 15131,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 13,
   "firman": "dibelah-Nya laut, diseberangkan-Nya mereka; didirikan-Nya air sebagai bendungan,"
 },
 {
   "id": 15132,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 14,
   "firman": "dituntun-Nya mereka dengan awan pada waktu siang, dan semalam suntuk dengan terang api;"
 },
 {
   "id": 15133,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 15,
   "firman": "dibelah-Nya gunung batu di padang gurun, diberi-Nya mereka minum banyak air seperti dari samudera raya;"
 },
 {
   "id": 15134,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 16,
   "firman": "dibuat-Nya aliran air keluar dari bukit batu, dan dibuat-Nya air turun seperti sungai."
 },
 {
   "id": 15135,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 17,
   "firman": "Tetapi mereka terus berbuat dosa terhadap Dia, dengan memberontak terhadap Yang Mahatinggi di padang kering."
 },
 {
   "id": 15136,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 18,
   "firman": "Mereka mencobai Allah dalam hati mereka dengan meminta makanan menuruti nafsu mereka."
 },
 {
   "id": 15137,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 19,
   "firman": "Mereka berkata terhadap Allah: \"Sanggupkah Allah menyajikan hidangan di padang gurun?"
 },
 {
   "id": 15138,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 20,
   "firman": "Memang, Ia memukul gunung batu, sehingga terpancar air dan membanjir sungai-sungai; tetapi sanggupkah Ia memberikan roti juga, atau menyediakan daging bagi umat-Nya?\""
 },
 {
   "id": 15139,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 21,
   "firman": "Sebab itu, ketika mendengar hal itu, TUHAN gemas, api menyala menimpa Yakub, bahkan murka bergejolak menimpa Israel,"
 },
 {
   "id": 15140,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 22,
   "firman": "sebab mereka tidak percaya kepada Allah, dan tidak yakin akan keselamatan dari pada-Nya."
 },
 {
   "id": 15141,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 23,
   "firman": "Maka Ia memerintahkan awan-awan dari atas, membuka pintu-pintu langit,"
 },
 {
   "id": 15142,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 24,
   "firman": "menurunkan kepada mereka hujan manna untuk dimakan, dan memberikan kepada mereka gandum dari langit;"
 },
 {
   "id": 15143,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 25,
   "firman": "setiap orang telah makan roti malaikat, Ia mengirimkan perbekalan kepada mereka berlimpah-limpah."
 },
 {
   "id": 15144,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 26,
   "firman": "Ia telah menghembuskan angin timur di langit dan menggiring angin selatan dengan kekuatan-Nya;"
 },
 {
   "id": 15145,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 27,
   "firman": "Ia menurunkan kepada mereka hujan daging seperti debu banyaknya, dan hujan burung-burung bersayap seperti pasir laut;"
 },
 {
   "id": 15146,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 28,
   "firman": "Ia menjatuhkannya ke tengah perkemahan mereka, sekeliling tempat kediaman itu."
 },
 {
   "id": 15147,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 29,
   "firman": "Mereka makan dan menjadi sangat kenyang; Ia memberikan kepada mereka apa yang mereka inginkan."
 },
 {
   "id": 15148,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 30,
   "firman": "Mereka belum merasa puas, sedang makanan masih ada di mulut mereka;"
 },
 {
   "id": 15149,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 31,
   "firman": "maka bangkitlah murka Allah terhadap mereka: Ia membunuh gembong-gembong mereka, dan menewaskan teruna-teruna Israel."
 },
 {
   "id": 15150,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 32,
   "firman": "Sekalipun demikian mereka masih saja berbuat dosa dan tidak percaya kepada perbuatan-perbuatan-Nya yang ajaib."
 },
 {
   "id": 15151,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 33,
   "firman": "Sebab itu Ia membuat hari-hari mereka habis dalam kesia-siaan, dan tahun-tahun mereka dalam kekejutan."
 },
 {
   "id": 15152,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 34,
   "firman": "Apabila Ia membunuh mereka, maka mereka mencari Dia, mereka berbalik dan mengingini Allah;"
 },
 {
   "id": 15153,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 35,
   "firman": "mereka teringat bahwa Allah adalah gunung batu mereka, dan bahwa Allah Yang Mahatinggi adalah Penebus mereka."
 },
 {
   "id": 15154,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 36,
   "firman": "Tetapi mereka memperdaya Dia dengan mulut mereka, dan dengan lidahnya mereka membohongi Dia."
 },
 {
   "id": 15155,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 37,
   "firman": "Hati mereka tidak tetap pada Dia, dan mereka tidak setia pada perjanjian-Nya."
 },
 {
   "id": 15156,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 38,
   "firman": "Tetapi Ia bersifat penyayang, Ia mengampuni kesalahan mereka dan tidak memusnahkan mereka; banyak kali Ia menahan murka-Nya dan tidak membangkitkan segenap amarah-Nya."
 },
 {
   "id": 15157,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 39,
   "firman": "Ia ingat bahwa mereka itu daging, angin yang berlalu, yang tidak akan kembali."
 },
 {
   "id": 15158,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 40,
   "firman": "Berapa kali mereka memberontak terhadap Dia di padang gurun, dan menyusahkan hati-Nya di padang belantara!"
 },
 {
   "id": 15159,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 41,
   "firman": "Berulang kali mereka mencobai Allah, menyakiti hati Yang Kudus dari Israel."
 },
 {
   "id": 15160,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 42,
   "firman": "Mereka tidak ingat kepada kekuasaan-Nya, kepada hari Ia membebaskan mereka dari pada lawan,"
 },
 {
   "id": 15161,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 43,
   "firman": "ketika Ia mengadakan tanda-tanda di Mesir dan mujizat-mujizat di padang Zoan."
 },
 {
   "id": 15162,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 44,
   "firman": "Ia mengubah menjadi darah sungai-sungai mereka dan aliran-aliran air mereka, sehingga tidak terminum;"
 },
 {
   "id": 15163,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 45,
   "firman": "Ia melepaskan kepada mereka lalat pikat yang memakan mereka, dan katak-katak yang memusnahkan mereka;"
 },
 {
   "id": 15164,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 46,
   "firman": "Ia memberikan hasil tanah mereka kepada ulat, dan hasil jerih payah mereka kepada belalang;"
 },
 {
   "id": 15165,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 47,
   "firman": "Ia mematikan pohon anggur mereka dengan hujan batu, dan pohon-pohon ara mereka dengan embun beku;"
 },
 {
   "id": 15166,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 48,
   "firman": "Ia membiarkan kawanan binatang mereka ditimpa hujan es, dan ternak mereka disambar halilintar;"
 },
 {
   "id": 15167,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 49,
   "firman": "Ia melepaskan kepada mereka murka-Nya yang menyala-nyala, kegemasan, kegeraman dan kesesakan, suatu pasukan malaikat yang membawa malapetaka;"
 },
 {
   "id": 15168,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 50,
   "firman": "Ia membiarkan murka-Nya berkobar, Ia tidak mencegah jiwa mereka dari maut, nyawa mereka diserahkan-Nya kepada penyakit sampar;"
 },
 {
   "id": 15169,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 51,
   "firman": "dibunuh-Nya semua anak sulung di Mesir, kegagahan mereka yang pertama-tama di kemah-kemah Ham;"
 },
 {
   "id": 15170,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 52,
   "firman": "disuruh-Nya umat-Nya berangkat seperti domba-domba, dipimpin-Nya mereka seperti kawanan hewan di padang gurun;"
 },
 {
   "id": 15171,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 53,
   "firman": "dituntun-Nya mereka dengan tenteram, sehingga tidak gemetar, sedang musuh mereka dilingkupi laut;"
 },
 {
   "id": 15172,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 54,
   "firman": "dibawa-Nya mereka ke tanah-Nya yang kudus, yakni pegunungan ini, yang diperoleh tangan kanan-Nya;"
 },
 {
   "id": 15173,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 55,
   "firman": "dihalau-Nya bangsa-bangsa dari depan mereka, dibagi-bagikan-Nya kepada mereka tanah pusaka dengan tali pengukur, dan disuruh-Nya suku-suku Israel mendiami kemah-kemah mereka itu."
 },
 {
   "id": 15174,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 56,
   "firman": "Tetapi mereka mencobai dan memberontak terhadap Allah, Yang Mahatinggi, dan tidak berpegang pada peringatan-peringatan-Nya;"
 },
 {
   "id": 15175,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 57,
   "firman": "mereka murtad dan berkhianat seperti nenek moyang mereka, berubah seperti busur yang memperdaya;"
 },
 {
   "id": 15176,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 58,
   "firman": "mereka menyakiti hati-Nya dengan bukit-bukit pengorbanan mereka, membuat Dia cemburu dengan patung-patung mereka."
 },
 {
   "id": 15177,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 59,
   "firman": "Ketika Allah mendengarnya, Ia menjadi gemas, Ia menolak Israel sama sekali;"
 },
 {
   "id": 15178,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 60,
   "firman": "Ia membuang kediaman-Nya di Silo kemah yang didiami-Nya di antara manusia;"
 },
 {
   "id": 15179,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 61,
   "firman": "Ia membiarkan kekuatan-Nya tertawan, membiarkan kehormatan-Nya jatuh ke tangan lawan;"
 },
 {
   "id": 15180,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 62,
   "firman": "Ia membiarkan umat-Nya dimakan pedang, dan gemaslah Ia atas milik-Nya sendiri."
 },
 {
   "id": 15181,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 63,
   "firman": "Anak-anak teruna mereka dimakan api, dan anak-anak dara mereka tidak lagi dipuja dengan nyanyian perkawinan;"
 },
 {
   "id": 15182,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 64,
   "firman": "imam-imam mereka gugur oleh pedang, dan janda-janda mereka tidak dapat menangis."
 },
 {
   "id": 15183,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 65,
   "firman": "Lalu terjagalah Tuhan, seperti orang yang tertidur, seperti pahlawan yang siuman dari mabuk anggur;"
 },
 {
   "id": 15184,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 66,
   "firman": "Ia memukul mundur para lawan-Nya, Ia menyebabkan mereka mendapat cela untuk selama-lamanya."
 },
 {
   "id": 15185,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 67,
   "firman": "Ia menolak kemah Yusuf, dan suku Efraim tidak dipilih-Nya,"
 },
 {
   "id": 15186,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 68,
   "firman": "tetapi Ia memilih suku Yehuda, gunung Sion yang dikasihi-Nya;"
 },
 {
   "id": 15187,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 69,
   "firman": "Ia membangun tempat kudus-Nya setinggi langit, laksana bumi yang didasarkan-Nya untuk selama-lamanya;"
 },
 {
   "id": 15188,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 70,
   "firman": "dipilih-Nya Daud, hamba-Nya, diambil-Nya dia dari antara kandang-kandang kambing domba;"
 },
 {
   "id": 15189,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 71,
   "firman": "dari tempat domba-domba yang menyusui didatangkan-Nya dia, untuk menggembalakan Yakub, umat-Nya, dan Israel, milik-Nya sendiri."
 },
 {
   "id": 15190,
   "kitab": "Mzm",
   "pasal": 78,
   "ayat": 72,
   "firman": "Ia menggembalakan mereka dengan ketulusan hatinya, dan menuntun mereka dengan kecakapan tangannya."
 },
 {
   "id": 15191,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 1,
   "firman": "Mazmur Asaf. Ya Allah, bangsa-bangsa lain telah masuk ke dalam tanah milik-Mu, menajiskan bait kudus-Mu, membuat Yerusalem menjadi timbunan puing."
 },
 {
   "id": 15192,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 2,
   "firman": "Mereka memberikan mayat hamba-hamba-Mu sebagai makanan kepada burung-burung di udara, daging orang-orang yang Kaukasihi kepada binatang-binatang liar di bumi."
 },
 {
   "id": 15193,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 3,
   "firman": "Mereka menumpahkan darah orang-orang itu seperti air sekeliling Yerusalem, dan tidak ada yang menguburkan."
 },
 {
   "id": 15194,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 4,
   "firman": "Kami menjadi cela bagi tetangga-tetangga kami, menjadi olok-olok dan cemooh bagi orang-orang sekeliling kami."
 },
 {
   "id": 15195,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 5,
   "firman": "Berapa lama lagi, ya TUHAN, Engkau murka terus-menerus, dan cemburu-Mu berkobar-kobar seperti api?"
 },
 {
   "id": 15196,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 6,
   "firman": "Tumpahkanlah amarah-Mu ke atas bangsa-bangsa yang tidak mengenal Engkau, ke atas kerajaan-kerajaan yang tidak menyerukan nama-Mu;"
 },
 {
   "id": 15197,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 7,
   "firman": "sebab mereka telah memakan habis Yakub, dan tempat kediamannya mereka hancurkan."
 },
 {
   "id": 15198,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 8,
   "firman": "Janganlah perhitungkan kepada kami kesalahan nenek moyang kami; kiranya rahmat-Mu segera menyongsong kami, sebab sudah sangat lemah kami."
 },
 {
   "id": 15199,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 9,
   "firman": "Tolonglah kami, ya Allah penyelamat kami, demi kemuliaan nama-Mu! Lepaskanlah kami dan ampunilah dosa kami oleh karena nama-Mu!"
 },
 {
   "id": 15200,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 10,
   "firman": "Mengapa bangsa-bangsa lain boleh berkata: \"Di mana Allah mereka?\" Biarlah di hadapan kami bangsa-bangsa lain mengetahui pembalasan atas darah yang tertumpah dari hamba-hamba-Mu."
 },
 {
   "id": 15201,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 11,
   "firman": "Biarlah sampai ke hadapan-Mu keluhan orang tahanan; sesuai dengan kebesaran lengan-Mu, biarkanlah hidup orang-orang yang ditentukan untuk mati dibunuh!"
 },
 {
   "id": 15202,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 12,
   "firman": "Dan balikkanlah ke atas pangkuan tetangga kami tujuh kali lipat cela yang telah didatangkan kepada-Mu, ya Tuhan!"
 },
 {
   "id": 15203,
   "kitab": "Mzm",
   "pasal": 79,
   "ayat": 13,
   "firman": "Maka kami ini, umat-Mu, dan kawanan domba gembalaan-Mu, akan bersyukur kepada-Mu untuk selama-lamanya, dan akan memberitakan puji-pujian untuk-Mu turun-temurun."
 },
 {
   "id": 15204,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Bunga bakung. Kesaksian Asaf. Mazmur. (80-2) Hai gembala Israel, pasanglah telinga, Engkau yang menggiring Yusuf sebagai kawanan domba! Ya Engkau, yang duduk di atas para kerub, tampillah bersinar"
 },
 {
   "id": 15205,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 2,
   "firman": "(80-3) di depan Efraim dan Benyamin dan Manasye! Bangkitkanlah keperkasaan-Mu dan datanglah untuk menyelamatkan kami."
 },
 {
   "id": 15206,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 3,
   "firman": "(80-4) Ya Allah, pulihkanlah kami, buatlah wajah-Mu bersinar, maka kami akan selamat."
 },
 {
   "id": 15207,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 4,
   "firman": "(80-5) TUHAN, Allah semesta alam, berapa lama lagi murka-Mu menyala sekalipun umat-Mu berdoa?"
 },
 {
   "id": 15208,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 5,
   "firman": "(80-6) Engkau memberi mereka makan roti cucuran air mata, Engkau memberi mereka minum air mata berlimpah-limpah,"
 },
 {
   "id": 15209,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 6,
   "firman": "(80-7) Engkau membuat kami menjadi pokok percederaan tetangga-tetangga kami, dan musuh-musuh kami mengolok-olok kami."
 },
 {
   "id": 15210,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 7,
   "firman": "(80-8) Ya Allah semesta alam, pulihkanlah kami, buatlah wajah-Mu bersinar, maka kami akan selamat."
 },
 {
   "id": 15211,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 8,
   "firman": "(80-9) Telah Kauambil pohon anggur dari Mesir, telah Kauhalau bangsa-bangsa, lalu Kautanam pohon itu."
 },
 {
   "id": 15212,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 9,
   "firman": "(80-10) Engkau telah menyediakan tempat bagi dia, maka berakarlah ia dalam-dalam dan memenuhi negeri;"
 },
 {
   "id": 15213,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 10,
   "firman": "(80-11) gunung-gunung terlindung oleh bayang-bayangnya, dan pohon-pohon aras Allah oleh cabang-cabangnya;"
 },
 {
   "id": 15214,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 11,
   "firman": "(80-12) dijulurkannya ranting-rantingnya sampai ke laut, dan pucuk-pucuknya sampai ke sungai Efrat."
 },
 {
   "id": 15215,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 12,
   "firman": "(80-13) Mengapa Engkau melanda temboknya, sehingga ia dipetik oleh setiap orang yang lewat?"
 },
 {
   "id": 15216,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 13,
   "firman": "(80-14) Babi hutan menggerogotinya dan binatang-binatang di padang memakannya."
 },
 {
   "id": 15217,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 14,
   "firman": "(80-15) Ya Allah semesta alam, kembalilah kiranya, pandanglah dari langit, dan lihatlah! Indahkanlah pohon anggur ini,"
 },
 {
   "id": 15218,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 15,
   "firman": "(80-16) batang yang ditanam oleh tangan kanan-Mu!"
 },
 {
   "id": 15219,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 16,
   "firman": "(80-17) Mereka telah membakarnya dengan api dan menebangnya; biarlah mereka hilang lenyap oleh hardik wajah-Mu!"
 },
 {
   "id": 15220,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 17,
   "firman": "(80-18) Kiranya tangan-Mu melindungi orang yang di sebelah kanan-Mu, anak manusia yang telah Kauteguhkan bagi diri-Mu itu,"
 },
 {
   "id": 15221,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 18,
   "firman": "(80-19) maka kami tidak akan menyimpang dari pada-Mu. Biarkanlah kami hidup, maka kami akan menyerukan nama-Mu."
 },
 {
   "id": 15222,
   "kitab": "Mzm",
   "pasal": 80,
   "ayat": 19,
   "firman": "(80-20) Ya TUHAN, Allah semesta alam, pulihkanlah kami, buatlah wajah-Mu bersinar, maka kami akan selamat."
 },
 {
   "id": 15223,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Gitit. Dari Asaf. (81-2) Bersorak-sorailah bagi Allah, kekuatan kita, bersorak-soraklah bagi Allah Yakub."
 },
 {
   "id": 15224,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 2,
   "firman": "(81-3) Angkatlah lagu, bunyikanlah rebana, kecapi yang merdu, diiringi gambus."
 },
 {
   "id": 15225,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 3,
   "firman": "(81-4) Tiuplah sangkakala pada bulan baru, pada bulan purnama, pada hari raya kita."
 },
 {
   "id": 15226,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 4,
   "firman": "(81-5) Sebab hal itu adalah suatu ketetapan bagi Israel, suatu hukum dari Allah Yakub."
 },
 {
   "id": 15227,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 5,
   "firman": "(81-6) Sebagai suatu peringatan bagi Yusuf ditetapkan-Nya hal itu, pada waktu Ia maju melawan tanah Mesir. Aku mendengar bahasa yang tidak kukenal:"
 },
 {
   "id": 15228,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 6,
   "firman": "(81-7) \"Aku telah mengangkat beban dari bahunya, tangannya telah bebas dari keranjang pikulan;"
 },
 {
   "id": 15229,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 7,
   "firman": "(81-8) dalam kesesakan engkau berseru, maka Aku meluputkan engkau; Aku menjawab engkau dalam persembunyian guntur, Aku telah menguji engkau dekat air Meriba. Sela"
 },
 {
   "id": 15230,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 8,
   "firman": "(81-9) Dengarlah hai umat-Ku, Aku hendak memberi peringatan kepadamu; hai Israel, jika engkau mau mendengarkan Aku!"
 },
 {
   "id": 15231,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 9,
   "firman": "(81-10) Janganlah ada di antaramu allah lain, dan janganlah engkau menyembah kepada allah asing."
 },
 {
   "id": 15232,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 10,
   "firman": "(81-11) Akulah TUHAN, Allahmu, yang menuntun engkau keluar dari tanah Mesir: bukalah mulutmu lebar-lebar, maka Aku akan membuatnya penuh."
 },
 {
   "id": 15233,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 11,
   "firman": "(81-12) Tetapi umat-Ku tidak mendengarkan suara-Ku, dan Israel tidak suka kepada-Ku."
 },
 {
   "id": 15234,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 12,
   "firman": "(81-13) Sebab itu Aku membiarkan dia dalam kedegilan hatinya; biarlah mereka berjalan mengikuti rencananya sendiri!"
 },
 {
   "id": 15235,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 13,
   "firman": "(81-14) Sekiranya umat-Ku mendengarkan Aku! Sekiranya Israel hidup menurut jalan yang Kutunjukkan!"
 },
 {
   "id": 15236,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 14,
   "firman": "(81-15) Seketika itu juga musuh mereka Aku tundukkan, dan terhadap para lawan mereka Aku balikkan tangan-Ku."
 },
 {
   "id": 15237,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 15,
   "firman": "(81-16) Orang-orang yang membenci TUHAN akan tunduk menjilat kepada-Nya, dan itulah nasib mereka untuk selama-lamanya."
 },
 {
   "id": 15238,
   "kitab": "Mzm",
   "pasal": 81,
   "ayat": 16,
   "firman": "(81-17) Tetapi umat-Ku akan Kuberi makan gandum yang terbaik dan dengan madu dari gunung batu Aku akan mengenyangkannya.\""
 },
 {
   "id": 15239,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 1,
   "firman": "Mazmur Asaf. Allah berdiri dalam sidang ilahi, di antara para allah Ia menghakimi:"
 },
 {
   "id": 15240,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 2,
   "firman": "\"Berapa lama lagi kamu menghakimi dengan lalim dan memihak kepada orang fasik? Sela"
 },
 {
   "id": 15241,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 3,
   "firman": "Berilah keadilan kepada orang yang lemah dan kepada anak yatim, belalah hak orang sengsara dan orang yang kekurangan!"
 },
 {
   "id": 15242,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 4,
   "firman": "Luputkanlah orang yang lemah dan yang miskin, lepaskanlah mereka dari tangan orang fasik!\""
 },
 {
   "id": 15243,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 5,
   "firman": "Mereka tidak tahu dan tidak mengerti apa-apa, dalam kegelapan mereka berjalan; goyanglah segala dasar bumi."
 },
 {
   "id": 15244,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 6,
   "firman": "Aku sendiri telah berfirman: \"Kamu adalah allah, dan anak-anak Yang Mahatinggi kamu sekalian. --"
 },
 {
   "id": 15245,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 7,
   "firman": "Namun seperti manusia kamu akan mati dan seperti salah seorang pembesar kamu akan tewas.\""
 },
 {
   "id": 15246,
   "kitab": "Mzm",
   "pasal": 82,
   "ayat": 8,
   "firman": "Bangunlah ya Allah, hakimilah bumi, sebab Engkaulah yang memiliki segala bangsa."
 },
 {
   "id": 15247,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 1,
   "firman": "Mazmur Asaf: suatu nyanyian. (83-2) Ya Allah, janganlah Engkau bungkam, janganlah berdiam diri dan janganlah berpangku tangan, ya Allah!"
 },
 {
   "id": 15248,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 2,
   "firman": "(83-3) Sebab sesungguhnya musuh-musuh-Mu ribut, orang-orang yang membenci Engkau meninggikan kepala."
 },
 {
   "id": 15249,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 3,
   "firman": "(83-4) Mereka mengadakan permufakatan licik melawan umat-Mu, dan mereka berunding untuk melawan orang-orang yang Kaulindungi."
 },
 {
   "id": 15250,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 4,
   "firman": "(83-5) Kata mereka: \"Marilah kita lenyapkan mereka sebagai bangsa, sehingga nama Israel tidak diingat lagi!\""
 },
 {
   "id": 15251,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 5,
   "firman": "(83-6) Sungguh, mereka telah berunding dengan satu hati, mereka telah mengadakan perjanjian melawan Engkau:"
 },
 {
   "id": 15252,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 6,
   "firman": "(83-7) Penghuni kemah-kemah Edom dan orang Ismael, Moab dan orang Hagar,"
 },
 {
   "id": 15253,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 7,
   "firman": "(83-8) Gebal dan Amon dan Amalek, Filistea beserta penduduk Tirus,"
 },
 {
   "id": 15254,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 8,
   "firman": "(83-9) juga Asyur telah bergabung dengan mereka, menjadi kaki tangan bani Lot. Sela"
 },
 {
   "id": 15255,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 9,
   "firman": "(83-10) Perlakukanlah mereka seperti Midian, seperti Sisera, seperti Yabin dekat sungai Kison,"
 },
 {
   "id": 15256,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 10,
   "firman": "(83-11) yang sudah dipunahkan di En-Dor, menjadi pupuk bagi tanah."
 },
 {
   "id": 15257,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 11,
   "firman": "(83-12) Buatlah para pemuka mereka seperti Oreb dan Zeeb, seperti Zebah dan Salmuna semua pemimpin mereka,"
 },
 {
   "id": 15258,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 12,
   "firman": "(83-13) yang berkata: \"Marilah kita menduduki tempat-tempat kediaman Allah!\""
 },
 {
   "id": 15259,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 13,
   "firman": "(83-14) Ya Allahku, buatlah mereka seperti dedak yang beterbangan, seperti jerami yang ditiup angin!"
 },
 {
   "id": 15260,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 14,
   "firman": "(83-15) Seperti api yang membakar hutan, dan seperti nyala api yang menghanguskan gunung-gunung,"
 },
 {
   "id": 15261,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 15,
   "firman": "(83-16) kejarlah mereka dengan badai-Mu, dan kejutkanlah mereka dengan puting beliung-Mu;"
 },
 {
   "id": 15262,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 16,
   "firman": "(83-17) penuhilah muka mereka dengan kehinaan, supaya mereka mencari nama-Mu, ya TUHAN!"
 },
 {
   "id": 15263,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 17,
   "firman": "(83-18) Biarlah mereka mendapat malu dan terkejut selama-lamanya; biarlah mereka tersipu-sipu dan binasa,"
 },
 {
   "id": 15264,
   "kitab": "Mzm",
   "pasal": 83,
   "ayat": 18,
   "firman": "(83-19) supaya mereka tahu bahwa Engkau sajalah yang bernama TUHAN, Yang Mahatinggi atas seluruh bumi."
 },
 {
   "id": 15265,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Menurut lagu: Gitit. Mazmur bani Korah. (84-2) Betapa disenangi tempat kediaman-Mu, ya TUHAN semesta alam!"
 },
 {
   "id": 15266,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 2,
   "firman": "(84-3) Jiwaku hancur karena merindukan pelataran-pelataran TUHAN; hatiku dan dagingku bersorak-sorai kepada Allah yang hidup."
 },
 {
   "id": 15267,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 3,
   "firman": "(84-4) Bahkan burung pipit telah mendapat sebuah rumah, dan burung layang-layang sebuah sarang, tempat menaruh anak-anaknya, pada mezbah-mezbah-Mu, ya TUHAN semesta alam, ya Rajaku dan Allahku!"
 },
 {
   "id": 15268,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 4,
   "firman": "(84-5) Berbahagialah orang-orang yang diam di rumah-Mu, yang terus-menerus memuji-muji Engkau. Sela"
 },
 {
   "id": 15269,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 5,
   "firman": "(84-6) Berbahagialah manusia yang kekuatannya di dalam Engkau, yang berhasrat mengadakan ziarah!"
 },
 {
   "id": 15270,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 6,
   "firman": "(84-7) Apabila melintasi lembah Baka, mereka membuatnya menjadi tempat yang bermata air; bahkan hujan pada awal musim menyelubunginya dengan berkat."
 },
 {
   "id": 15271,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 7,
   "firman": "(84-8) Mereka berjalan makin lama makin kuat, hendak menghadap Allah di Sion."
 },
 {
   "id": 15272,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 8,
   "firman": "(84-9) Ya TUHAN, Allah semesta alam, dengarkanlah doaku, pasanglah telinga, ya Allah Yakub. Sela"
 },
 {
   "id": 15273,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 9,
   "firman": "(84-10) Lihatlah perisai kami, ya Allah, pandanglah wajah orang yang Kauurapi!"
 },
 {
   "id": 15274,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 10,
   "firman": "(84-11) Sebab lebih baik satu hari di pelataran-Mu dari pada seribu hari di tempat lain; lebih baik berdiri di ambang pintu rumah Allahku dari pada diam di kemah-kemah orang fasik."
 },
 {
   "id": 15275,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 11,
   "firman": "(84-12) Sebab TUHAN Allah adalah matahari dan perisai; kasih dan kemuliaan Ia berikan; Ia tidak menahan kebaikan dari orang yang hidup tidak bercela."
 },
 {
   "id": 15276,
   "kitab": "Mzm",
   "pasal": 84,
   "ayat": 12,
   "firman": "(84-13) Ya TUHAN semesta alam, berbahagialah manusia yang percaya kepada-Mu!"
 },
 {
   "id": 15277,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur bani Korah. (85-2) Engkau telah berkenan kepada tanah-Mu, ya TUHAN, telah memulihkan keadaan Yakub."
 },
 {
   "id": 15278,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 2,
   "firman": "(85-3) Engkau telah mengampuni kesalahan umat-Mu, telah menutupi segala dosa mereka. Sela"
 },
 {
   "id": 15279,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 3,
   "firman": "(85-4) Engkau telah menyurutkan segala gemas-Mu, telah meredakan murka-Mu yang menyala-nyala."
 },
 {
   "id": 15280,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 4,
   "firman": "(85-5) Pulihkanlah kami, ya Allah penyelamat kami, dan tiadakanlah sakit hati-Mu kepada kami."
 },
 {
   "id": 15281,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 5,
   "firman": "(85-6) Untuk selamanyakah Engkau murka atas kami dan melanjutkan murka-Mu turun-temurun?"
 },
 {
   "id": 15282,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 6,
   "firman": "(85-7) Apakah Engkau tidak mau menghidupkan kami kembali, sehingga umat-Mu bersukacita karena Engkau?"
 },
 {
   "id": 15283,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 7,
   "firman": "(85-8) Perlihatkanlah kepada kami kasih setia-Mu, ya TUHAN, dan berikanlah kepada kami keselamatan dari pada-Mu!"
 },
 {
   "id": 15284,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 8,
   "firman": "(85-9) Aku mau mendengar apa yang hendak difirmankan Allah, TUHAN. Bukankah Ia hendak berbicara tentang damai kepada umat-Nya dan kepada orang-orang yang dikasihi-Nya, supaya jangan mereka kembali kepada kebodohan?"
 },
 {
   "id": 15285,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 9,
   "firman": "(85-10) Sesungguhnya keselamatan dari pada-Nya dekat pada orang-orang yang takut akan Dia, sehingga kemuliaan diam di negeri kita."
 },
 {
   "id": 15286,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 10,
   "firman": "(85-11) Kasih dan kesetiaan akan bertemu, keadilan dan damai sejahtera akan bercium-ciuman."
 },
 {
   "id": 15287,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 11,
   "firman": "(85-12) Kesetiaan akan tumbuh dari bumi, dan keadilan akan menjenguk dari langit."
 },
 {
   "id": 15288,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 12,
   "firman": "(85-13) Bahkan TUHAN akan memberikan kebaikan, dan negeri kita akan memberi hasilnya."
 },
 {
   "id": 15289,
   "kitab": "Mzm",
   "pasal": 85,
   "ayat": 13,
   "firman": "(85-14) Keadilan akan berjalan di hadapan-Nya, dan akan membuat jejak kaki-Nya menjadi jalan."
 },
 {
   "id": 15290,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 1,
   "firman": "Doa Daud. Sendengkanlah telinga-Mu, ya TUHAN, jawablah aku, sebab sengsara dan miskin aku."
 },
 {
   "id": 15291,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 2,
   "firman": "Peliharalah nyawaku, sebab aku orang yang Kaukasihi, selamatkanlah hamba-Mu yang percaya kepada-Mu."
 },
 {
   "id": 15292,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 3,
   "firman": "Engkau adalah Allahku, kasihanilah aku, ya Tuhan, sebab kepada-Mulah aku berseru sepanjang hari."
 },
 {
   "id": 15293,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 4,
   "firman": "Buatlah jiwa hamba-Mu bersukacita, sebab kepada-Mulah, ya Tuhan, kuangkat jiwaku."
 },
 {
   "id": 15294,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 5,
   "firman": "Sebab Engkau, ya Tuhan, baik dan suka mengampuni dan berlimpah kasih setia bagi semua orang yang berseru kepada-Mu."
 },
 {
   "id": 15295,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 6,
   "firman": "Pasanglah telinga kepada doaku, ya TUHAN, dan perhatikanlah suara permohonanku."
 },
 {
   "id": 15296,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 7,
   "firman": "Pada hari kesesakanku aku berseru kepada-Mu, sebab Engkau menjawab aku."
 },
 {
   "id": 15297,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 8,
   "firman": "Tidak ada seperti Engkau di antara para allah, ya Tuhan, dan tidak ada seperti apa yang Kaubuat."
 },
 {
   "id": 15298,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 9,
   "firman": "Segala bangsa yang Kaujadikan akan datang sujud menyembah di hadapan-Mu, ya Tuhan, dan akan memuliakan nama-Mu."
 },
 {
   "id": 15299,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 10,
   "firman": "Sebab Engkau besar dan melakukan keajaiban-keajaiban; Engkau sendiri saja Allah."
 },
 {
   "id": 15300,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 11,
   "firman": "Tunjukkanlah kepadaku jalan-Mu, ya TUHAN, supaya aku hidup menurut kebenaran-Mu; bulatkanlah hatiku untuk takut akan nama-Mu."
 },
 {
   "id": 15301,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 12,
   "firman": "Aku hendak bersyukur kepada-Mu, ya Tuhan, Allahku, dengan segenap hatiku, dan memuliakan nama-Mu untuk selama-lamanya;"
 },
 {
   "id": 15302,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 13,
   "firman": "sebab kasih setia-Mu besar atas aku, dan Engkau telah melepaskan nyawaku dari dunia orang mati yang paling bawah."
 },
 {
   "id": 15303,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 14,
   "firman": "Ya Allah, orang-orang yang angkuh telah bangkit menyerang aku, dan gerombolan orang-orang yang sombong ingin mencabut nyawaku, dan tidak mempedulikan Engkau."
 },
 {
   "id": 15304,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 15,
   "firman": "Tetapi Engkau, ya Tuhan, Allah penyayang dan pengasih, panjang sabar dan berlimpah kasih dan setia."
 },
 {
   "id": 15305,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 16,
   "firman": "Berpalinglah kepadaku dan kasihanilah aku, berilah kekuatan-Mu kepada hamba-Mu, dan selamatkanlah anak laki-laki hamba-Mu perempuan!"
 },
 {
   "id": 15306,
   "kitab": "Mzm",
   "pasal": 86,
   "ayat": 17,
   "firman": "Lakukanlah kepadaku suatu tanda kebaikan, supaya orang-orang yang membenci aku melihat dengan malu, bahwa Engkau, ya TUHAN, telah menolong dan menghiburkan aku."
 },
 {
   "id": 15307,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 1,
   "firman": "Mazmur bani Korah: suatu nyanyian. Di gunung-gunung yang kudus ada kota yang dibangunkan-Nya:"
 },
 {
   "id": 15308,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 2,
   "firman": "TUHAN lebih mencintai pintu-pintu gerbang Sion dari pada segala tempat kediaman Yakub."
 },
 {
   "id": 15309,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 3,
   "firman": "Hal-hal yang mulia dikatakan tentang engkau, ya kota Allah. Sela"
 },
 {
   "id": 15310,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 4,
   "firman": "Aku menyebut Rahab dan Babel di antara orang-orang yang mengenal Aku, bahkan Filistea, Tirus dan Etiopia: \"Ini dilahirkan di sana.\""
 },
 {
   "id": 15311,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 5,
   "firman": "Tetapi tentang Sion dikatakan: \"Seorang demi seorang dilahirkan di dalamnya,\" dan Dia, Yang Mahatinggi, menegakkannya."
 },
 {
   "id": 15312,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 6,
   "firman": "TUHAN menghitung pada waktu mencatat bangsa-bangsa: \"Ini dilahirkan di sana.\" Sela"
 },
 {
   "id": 15313,
   "kitab": "Mzm",
   "pasal": 87,
   "ayat": 7,
   "firman": "Dan orang menyanyi-nyanyi sambil menari beramai-ramai: \"Segala mata airku ada di dalammu.\""
 },
 {
   "id": 15314,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 1,
   "firman": "Nyanyian. Mazmur bani Korah. Untuk pemimpin biduan. Menurut lagu: Mahalat Leanot. Nyanyian pengajaran Heman, orang Ezrahi. (88-2) Ya TUHAN, Allah yang menyelamatkan aku, siang hari aku berseru-seru, pada waktu malam aku menghadap Engkau."
 },
 {
   "id": 15315,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 2,
   "firman": "(88-3) Biarlah doaku datang ke hadapan-Mu, sendengkanlah telinga-Mu kepada teriakku;"
 },
 {
   "id": 15316,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 3,
   "firman": "(88-4) sebab jiwaku kenyang dengan malapetaka, dan hidupku sudah dekat dunia orang mati."
 },
 {
   "id": 15317,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 4,
   "firman": "(88-5) Aku telah dianggap termasuk orang-orang yang turun ke liang kubur; aku seperti orang yang tidak berkekuatan."
 },
 {
   "id": 15318,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 5,
   "firman": "(88-6) Aku harus tinggal di antara orang-orang mati, seperti orang-orang yang mati dibunuh, terbaring dalam kubur, yang tidak Kauingat lagi, sebab mereka terputus dari kuasa-Mu."
 },
 {
   "id": 15319,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 6,
   "firman": "(88-7) Telah Kautaruh aku dalam liang kubur yang paling bawah, dalam kegelapan, dalam tempat yang dalam."
 },
 {
   "id": 15320,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 7,
   "firman": "(88-8) Aku tertekan oleh panas murka-Mu, dan segala pecahan ombak-Mu Kautindihkan kepadaku. Sela"
 },
 {
   "id": 15321,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 8,
   "firman": "(88-9) Telah Kaujauhkan kenalan-kenalanku dari padaku, telah Kaubuat aku menjadi kekejian bagi mereka. Aku tertahan dan tidak dapat keluar;"
 },
 {
   "id": 15322,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 9,
   "firman": "(88-10) mataku merana karena sengsara. Aku telah berseru kepada-Mu, ya TUHAN, sepanjang hari, telah mengulurkan tanganku kepada-Mu."
 },
 {
   "id": 15323,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 10,
   "firman": "(88-11) Apakah Kaulakukan keajaiban bagi orang-orang mati? Masakan arwah bangkit untuk bersyukur kepada-Mu? Sela"
 },
 {
   "id": 15324,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 11,
   "firman": "(88-12) Dapatkah kasih-Mu diberitakan di dalam kubur, dan kesetiaan-Mu di tempat kebinasaan?"
 },
 {
   "id": 15325,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 12,
   "firman": "(88-13) Diketahui orangkah keajaiban-keajaiban-Mu dalam kegelapan, dan keadilan-Mu di negeri segala lupa?"
 },
 {
   "id": 15326,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 13,
   "firman": "(88-14) Tetapi aku ini, ya TUHAN, kepada-Mu aku berteriak minta tolong, dan pada waktu pagi doaku datang ke hadapan-Mu."
 },
 {
   "id": 15327,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 14,
   "firman": "(88-15) Mengapa, ya TUHAN, Kaubuang aku, Kausembunyikan wajah-Mu dari padaku?"
 },
 {
   "id": 15328,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 15,
   "firman": "(88-16) Aku tertindas dan menjadi inceran maut sejak kecil, aku telah menanggung kengerian dari pada-Mu, aku putus asa."
 },
 {
   "id": 15329,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 16,
   "firman": "(88-17) Kehangatan murka-Mu menimpa aku, kedahsyatan-Mu membungkamkan aku,"
 },
 {
   "id": 15330,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 17,
   "firman": "(88-18) mengelilingi aku seperti air banjir sepanjang hari, mengepung aku serentak."
 },
 {
   "id": 15331,
   "kitab": "Mzm",
   "pasal": 88,
   "ayat": 18,
   "firman": "(88-19) Telah Kaujauhkan dari padaku sahabat dan teman, kenalan-kenalanku adalah kegelapan."
 },
 {
   "id": 15332,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 1,
   "firman": "Nyanyian pengajaran Etan, orang Ezrahi. (89-2) Aku hendak menyanyikan kasih setia TUHAN selama-lamanya, hendak memperkenalkan kesetiaan-Mu dengan mulutku turun-temurun."
 },
 {
   "id": 15333,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 2,
   "firman": "(89-3) Sebab kasih setia-Mu dibangun untuk selama-lamanya; kesetiaan-Mu tegak seperti langit."
 },
 {
   "id": 15334,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 3,
   "firman": "(89-4) Engkau telah berkata: \"Telah Kuikat perjanjian dengan orang pilihan-Ku, Aku telah bersumpah kepada Daud, hamba-Ku:"
 },
 {
   "id": 15335,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 4,
   "firman": "(89-5) Untuk selama-lamanya Aku hendak menegakkan anak cucumu, dan membangun takhtamu turun-temurun.\" Sela"
 },
 {
   "id": 15336,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 5,
   "firman": "(89-6) Sebab itu langit bersyukur karena keajaiban-keajaiban-Mu, ya TUHAN, bahkan karena kesetiaan-Mu di antara jemaah orang-orang kudus."
 },
 {
   "id": 15337,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 6,
   "firman": "(89-7) Sebab siapakah di awan-awan yang sejajar dengan TUHAN, yang sama seperti TUHAN di antara penghuni sorgawi?"
 },
 {
   "id": 15338,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 7,
   "firman": "(89-8) Allah disegani dalam kalangan orang-orang kudus, dan sangat ditakuti melebihi semua yang ada di sekeliling-Nya."
 },
 {
   "id": 15339,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 8,
   "firman": "(89-9) Ya TUHAN, Allah semesta alam, siapakah seperti Engkau? Engkau kuat, ya TUHAN, dan kesetiaan-Mu ada di sekeliling-Mu."
 },
 {
   "id": 15340,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 9,
   "firman": "(89-10) Engkaulah yang memerintah kecongkakan laut, pada waktu naik gelombang-gelombangnya, Engkau juga yang meredakannya."
 },
 {
   "id": 15341,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 10,
   "firman": "(89-11) Engkaulah yang meremukkan Rahab seperti orang terbunuh, dengan lengan-Mu yang kuat Engkau telah mencerai-beraikan musuh-Mu."
 },
 {
   "id": 15342,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 11,
   "firman": "(89-12) Punya-Mulah langit, punya-Mulah juga bumi, dunia serta isinya Engkaulah yang mendasarkannya."
 },
 {
   "id": 15343,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 12,
   "firman": "(89-13) Utara dan selatan, Engkaulah yang menciptakannya, Tabor dan Hermon bersorak-sorai karena nama-Mu."
 },
 {
   "id": 15344,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 13,
   "firman": "(89-14) Punya-Mulah lengan yang perkasa, kuat tangan-Mu dan tinggi tangan kanan-Mu."
 },
 {
   "id": 15345,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 14,
   "firman": "(89-15) Keadilan dan hukum adalah tumpuan takhta-Mu, kasih dan kesetiaan berjalan di depan-Mu."
 },
 {
   "id": 15346,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 15,
   "firman": "(89-16) Berbahagialah bangsa yang tahu bersorak-sorai, ya TUHAN, mereka hidup dalam cahaya wajah-Mu;"
 },
 {
   "id": 15347,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 16,
   "firman": "(89-17) karena nama-Mu mereka bersorak-sorak sepanjang hari, dan karena keadilan-Mu mereka bermegah."
 },
 {
   "id": 15348,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 17,
   "firman": "(89-18) Sebab Engkaulah kemuliaan kekuatan mereka, dan karena Engkau berkenan, tanduk kami meninggi."
 },
 {
   "id": 15349,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 18,
   "firman": "(89-19) Sebab perisai kita kepunyaan TUHAN, dan raja kita kepunyaan Yang Kudus Israel."
 },
 {
   "id": 15350,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 19,
   "firman": "(89-20) Pernah Engkau berbicara dalam penglihatan kepada orang-orang yang Kaukasihi, kata-Mu: \"Telah Kutaruh mahkota di atas kepala seorang pahlawan, telah Kutinggikan seorang pilihan dari antara bangsa itu."
 },
 {
   "id": 15351,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 20,
   "firman": "(89-21) Aku telah mendapat Daud, hamba-Ku; Aku telah mengurapinya dengan minyak-Ku yang kudus,"
 },
 {
   "id": 15352,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 21,
   "firman": "(89-22) maka tangan-Ku tetap dengan dia, bahkan lengan-Ku meneguhkan dia."
 },
 {
   "id": 15353,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 22,
   "firman": "(89-23) Musuh tidak akan menyergapnya, dan orang curang tidak akan menindasnya."
 },
 {
   "id": 15354,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 23,
   "firman": "(89-24) Aku akan menghancurkan lawannya dari hadapannya, dan orang-orang yang membencinya akan Kubunuh."
 },
 {
   "id": 15355,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 24,
   "firman": "(89-25) Kesetiaan-Ku dan kasih-Ku menyertai dia, dan oleh karena nama-Ku tanduknya akan meninggi."
 },
 {
   "id": 15356,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 25,
   "firman": "(89-26) Aku akan membuat tangannya menguasai laut, dan tangan kanannya menguasai sungai-sungai."
 },
 {
   "id": 15357,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 26,
   "firman": "(89-27) Diapun akan berseru kepada-Ku: 'Bapaku Engkau, Allahku dan gunung batu keselamatanku.'"
 },
 {
   "id": 15358,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 27,
   "firman": "(89-28) Akupun juga akan mengangkat dia menjadi anak sulung, menjadi yang mahatinggi di antara raja-raja bumi."
 },
 {
   "id": 15359,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 28,
   "firman": "(89-29) Aku akan memelihara kasih setia-Ku bagi dia untuk selama-lamanya, dan perjanjian-Ku teguh bagi dia."
 },
 {
   "id": 15360,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 29,
   "firman": "(89-30) Aku menjamin akan adanya anak cucunya sampai selama-lamanya, dan takhtanya seumur langit."
 },
 {
   "id": 15361,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 30,
   "firman": "(89-31) Jika anak-anaknya meninggalkan Taurat-Ku dan mereka tidak hidup menurut hukum-Ku,"
 },
 {
   "id": 15362,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 31,
   "firman": "(89-32) jika ketetapan-Ku mereka langgar dan tidak berpegang pada perintah-perintah-Ku,"
 },
 {
   "id": 15363,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 32,
   "firman": "(89-33) maka Aku akan membalas pelanggaran mereka dengan gada, dan kesalahan mereka dengan pukulan-pukulan."
 },
 {
   "id": 15364,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 33,
   "firman": "(89-34) Tetapi kasih setia-Ku tidak akan Kujauhkan dari padanya dan Aku tidak akan berlaku curang dalam hal kesetiaan-Ku."
 },
 {
   "id": 15365,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 34,
   "firman": "(89-35) Aku tidak akan melanggar perjanjian-Ku, dan apa yang keluar dari bibir-Ku tidak akan Kuubah."
 },
 {
   "id": 15366,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 35,
   "firman": "(89-36) Sekali Aku bersumpah demi kekudusan-Ku, tentulah Aku tidak akan berbohong kepada Daud:"
 },
 {
   "id": 15367,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 36,
   "firman": "(89-37) Anak cucunya akan ada untuk selama-lamanya, dan takhtanya seperti matahari di depan mata-Ku,"
 },
 {
   "id": 15368,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 37,
   "firman": "(89-38) seperti bulan yang ada selama-lamanya, suatu saksi yang setia di awan-awan.\" Sela"
 },
 {
   "id": 15369,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 38,
   "firman": "(89-39) Tetapi Engkau sendiri menolak dan membuang, menjadi gemas kepada orang yang Kauurapi,"
 },
 {
   "id": 15370,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 39,
   "firman": "(89-40) membatalkan perjanjian dengan hamba-Mu, menajiskan mahkotanya laksana debu,"
 },
 {
   "id": 15371,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 40,
   "firman": "(89-41) melanda segala temboknya, membuat kubu-kubunya menjadi reruntuhan."
 },
 {
   "id": 15372,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 41,
   "firman": "(89-42) Semua orang yang lewat di jalan merampoknya, dan ia menjadi cela bagi tetangganya."
 },
 {
   "id": 15373,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 42,
   "firman": "(89-43) Engkau telah meninggikan tangan kanan para lawannya, telah membuat semua musuhnya bersukacita."
 },
 {
   "id": 15374,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 43,
   "firman": "(89-44) Juga Kaubalikkan mata pedangnya, dan tidak membuat dia dapat bertahan dalam peperangan."
 },
 {
   "id": 15375,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 44,
   "firman": "(89-45) Engkau menghentikan kegemilangannya, dan takhtanya Kaucampakkan ke bumi."
 },
 {
   "id": 15376,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 45,
   "firman": "(89-46) Kaupendekkan masa mudanya, Kauselubungi dia dengan malu. Sela"
 },
 {
   "id": 15377,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 46,
   "firman": "(89-47) Berapa lama lagi, ya TUHAN, Engkau bersembunyi terus-menerus, berkobar-kobar murka-Mu laksana api?"
 },
 {
   "id": 15378,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 47,
   "firman": "(89-48) Ingatlah apa umur hidup itu, betapa sia-sia Kauciptakan semua anak manusia!"
 },
 {
   "id": 15379,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 48,
   "firman": "(89-49) Siapakah orang yang hidup dan yang tidak mengalami kematian, yang dapat meluputkan nyawanya dari kuasa dunia orang mati? Sela"
 },
 {
   "id": 15380,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 49,
   "firman": "(89-50) Di manakah kasih setia-Mu yang mula-mula, ya Tuhan, yang telah Kaujanjikan dengan sumpah kepada Daud demi kesetiaan-Mu?"
 },
 {
   "id": 15381,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 50,
   "firman": "(89-51) Ingatlah cela hamba-Mu, ya Tuhan, bahwa dalam dadaku aku menanggung penghinaan segala bangsa,"
 },
 {
   "id": 15382,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 51,
   "firman": "(89-52) yang dilontarkan oleh musuh-musuh-Mu, ya TUHAN, yang dilontarkan mencela jejak langkah orang yang Kauurapi."
 },
 {
   "id": 15383,
   "kitab": "Mzm",
   "pasal": 89,
   "ayat": 52,
   "firman": "(89-53) Terpujilah TUHAN untuk selama-lamanya! Amin, ya amin."
 },
 {
   "id": 15384,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 1,
   "firman": "Doa Musa, abdi Allah. Tuhan, Engkaulah tempat perteduhan kami turun-temurun."
 },
 {
   "id": 15385,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 2,
   "firman": "Sebelum gunung-gunung dilahirkan, dan bumi dan dunia diperanakkan, bahkan dari selama-lamanya sampai selama-lamanya Engkaulah Allah."
 },
 {
   "id": 15386,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 3,
   "firman": "Engkau mengembalikan manusia kepada debu, dan berkata: \"Kembalilah, hai anak-anak manusia!\""
 },
 {
   "id": 15387,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 4,
   "firman": "Sebab di mata-Mu seribu tahun sama seperti hari kemarin, apabila berlalu, atau seperti suatu giliran jaga di waktu malam."
 },
 {
   "id": 15388,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 5,
   "firman": "Engkau menghanyutkan manusia; mereka seperti mimpi, seperti rumput yang bertumbuh,"
 },
 {
   "id": 15389,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 6,
   "firman": "di waktu pagi berkembang dan bertumbuh, di waktu petang lisut dan layu."
 },
 {
   "id": 15390,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 7,
   "firman": "Sungguh, kami habis lenyap karena murka-Mu, dan karena kehangatan amarah-Mu kami terkejut."
 },
 {
   "id": 15391,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 8,
   "firman": "Engkau menaruh kesalahan kami di hadapan-Mu, dan dosa kami yang tersembunyi dalam cahaya wajah-Mu."
 },
 {
   "id": 15392,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 9,
   "firman": "Sungguh, segala hari kami berlalu karena gemas-Mu, kami menghabiskan tahun-tahun kami seperti keluh."
 },
 {
   "id": 15393,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 10,
   "firman": "Masa hidup kami tujuh puluh tahun dan jika kami kuat, delapan puluh tahun, dan kebanggaannya adalah kesukaran dan penderitaan; sebab berlalunya buru-buru, dan kami melayang lenyap."
 },
 {
   "id": 15394,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 11,
   "firman": "Siapakah yang mengenal kekuatan murka-Mu dan takut kepada gemas-Mu?"
 },
 {
   "id": 15395,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 12,
   "firman": "Ajarlah kami menghitung hari-hari kami sedemikian, hingga kami beroleh hati yang bijaksana."
 },
 {
   "id": 15396,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 13,
   "firman": "Kembalilah, ya TUHAN--berapa lama lagi? --dan sayangilah hamba-hamba-Mu!"
 },
 {
   "id": 15397,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 14,
   "firman": "Kenyangkanlah kami di waktu pagi dengan kasih setia-Mu, supaya kami bersorak-sorai dan bersukacita semasa hari-hari kami."
 },
 {
   "id": 15398,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 15,
   "firman": "Buatlah kami bersukacita seimbang dengan hari-hari Engkau menindas kami, seimbang dengan tahun-tahun kami mengalami celaka."
 },
 {
   "id": 15399,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 16,
   "firman": "Biarlah kelihatan kepada hamba-hamba-Mu perbuatan-Mu, dan semarak-Mu kepada anak-anak mereka."
 },
 {
   "id": 15400,
   "kitab": "Mzm",
   "pasal": 90,
   "ayat": 17,
   "firman": "Kiranya kemurahan Tuhan, Allah kami, atas kami, dan teguhkanlah perbuatan tangan kami, ya, perbuatan tangan kami, teguhkanlah itu."
 },
 {
   "id": 15401,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 1,
   "firman": "Orang yang duduk dalam lindungan Yang Mahatinggi dan bermalam dalam naungan Yang Mahakuasa"
 },
 {
   "id": 15402,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 2,
   "firman": "akan berkata kepada TUHAN: \"Tempat perlindunganku dan kubu pertahananku, Allahku, yang kupercayai.\""
 },
 {
   "id": 15403,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 3,
   "firman": "Sungguh, Dialah yang akan melepaskan engkau dari jerat penangkap burung, dari penyakit sampar yang busuk."
 },
 {
   "id": 15404,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 4,
   "firman": "Dengan kepak-Nya Ia akan menudungi engkau, di bawah sayap-Nya engkau akan berlindung, kesetiaan-Nya ialah perisai dan pagar tembok."
 },
 {
   "id": 15405,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 5,
   "firman": "Engkau tak usah takut terhadap kedahsyatan malam, terhadap panah yang terbang di waktu siang,"
 },
 {
   "id": 15406,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 6,
   "firman": "terhadap penyakit sampar yang berjalan di dalam gelap, terhadap penyakit menular yang mengamuk di waktu petang."
 },
 {
   "id": 15407,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 7,
   "firman": "Walau seribu orang rebah di sisimu, dan sepuluh ribu di sebelah kananmu, tetapi itu tidak akan menimpamu."
 },
 {
   "id": 15408,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 8,
   "firman": "Engkau hanya menontonnya dengan matamu sendiri dan melihat pembalasan terhadap orang-orang fasik."
 },
 {
   "id": 15409,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 9,
   "firman": "Sebab TUHAN ialah tempat perlindunganmu, Yang Mahatinggi telah kaubuat tempat perteduhanmu,"
 },
 {
   "id": 15410,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 10,
   "firman": "malapetaka tidak akan menimpa kamu, dan tulah tidak akan mendekat kepada kemahmu;"
 },
 {
   "id": 15411,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 11,
   "firman": "sebab malaikat-malaikat-Nya akan diperintahkan-Nya kepadamu untuk menjaga engkau di segala jalanmu."
 },
 {
   "id": 15412,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 12,
   "firman": "Mereka akan menatang engkau di atas tangannya, supaya kakimu jangan terantuk kepada batu."
 },
 {
   "id": 15413,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 13,
   "firman": "Singa dan ular tedung akan kaulangkahi, engkau akan menginjak anak singa dan ular naga."
 },
 {
   "id": 15414,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 14,
   "firman": "\"Sungguh, hatinya melekat kepada-Ku, maka Aku akan meluputkannya, Aku akan membentenginya, sebab ia mengenal nama-Ku."
 },
 {
   "id": 15415,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 15,
   "firman": "Bila ia berseru kepada-Ku, Aku akan menjawab, Aku akan menyertai dia dalam kesesakan, Aku akan meluputkannya dan memuliakannya."
 },
 {
   "id": 15416,
   "kitab": "Mzm",
   "pasal": 91,
   "ayat": 16,
   "firman": "Dengan panjang umur akan Kukenyangkan dia, dan akan Kuperlihatkan kepadanya keselamatan dari pada-Ku.\""
 },
 {
   "id": 15417,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 1,
   "firman": "Mazmur. Nyanyian untuk hari Sabat. (92-2) Adalah baik untuk menyanyikan syukur kepada TUHAN, dan untuk menyanyikan mazmur bagi nama-Mu, ya Yang Mahatinggi,"
 },
 {
   "id": 15418,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 2,
   "firman": "(92-3) untuk memberitakan kasih setia-Mu di waktu pagi dan kesetiaan-Mu di waktu malam,"
 },
 {
   "id": 15419,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 3,
   "firman": "(92-4) dengan bunyi-bunyian sepuluh tali dan dengan gambus, dengan iringan kecapi."
 },
 {
   "id": 15420,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 4,
   "firman": "(92-5) Sebab telah Kaubuat aku bersukacita, ya TUHAN, dengan pekerjaan-Mu, karena perbuatan tangan-Mu aku akan bersorak-sorai."
 },
 {
   "id": 15421,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 5,
   "firman": "(92-6) Betapa besarnya pekerjaan-pekerjaan-Mu, ya TUHAN, dan sangat dalamnya rancangan-rancangan-Mu."
 },
 {
   "id": 15422,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 6,
   "firman": "(92-7) Orang bodoh tidak akan mengetahui, dan orang bebal tidak akan mengerti hal itu."
 },
 {
   "id": 15423,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 7,
   "firman": "(92-8) Apabila orang-orang fasik bertunas seperti tumbuh-tumbuhan, dan orang-orang yang melakukan kejahatan berkembang, ialah supaya mereka dipunahkan untuk selama-lamanya."
 },
 {
   "id": 15424,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 8,
   "firman": "(92-9) Tetapi Engkau di tempat yang tinggi untuk selama-lamanya, ya TUHAN!"
 },
 {
   "id": 15425,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 9,
   "firman": "(92-10) Sebab, sesungguhnya musuh-Mu, ya TUHAN, sebab, sesungguhnya musuh-Mu akan binasa, semua orang yang melakukan kejahatan akan diceraiberaikan."
 },
 {
   "id": 15426,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 10,
   "firman": "(92-11) Tetapi Kautinggikan tandukku seperti tanduk banteng, aku dituangi dengan minyak baru;"
 },
 {
   "id": 15427,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 11,
   "firman": "(92-12) mataku memandangi seteruku, telingaku mendengar perihal orang-orang jahat yang bangkit melawan aku."
 },
 {
   "id": 15428,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 12,
   "firman": "(92-13) Orang benar akan bertunas seperti pohon korma, akan tumbuh subur seperti pohon aras di Libanon;"
 },
 {
   "id": 15429,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 13,
   "firman": "(92-14) mereka yang ditanam di bait TUHAN akan bertunas di pelataran Allah kita."
 },
 {
   "id": 15430,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 14,
   "firman": "(92-15) Pada masa tua pun mereka masih berbuah, menjadi gemuk dan segar,"
 },
 {
   "id": 15431,
   "kitab": "Mzm",
   "pasal": 92,
   "ayat": 15,
   "firman": "(92-16) untuk memberitakan, bahwa TUHAN itu benar, bahwa Ia gunung batuku dan tidak ada kecurangan pada-Nya."
 },
 {
   "id": 15432,
   "kitab": "Mzm",
   "pasal": 93,
   "ayat": 1,
   "firman": "TUHAN adalah Raja, Ia berpakaian kemegahan, TUHAN berpakaian, berikat pinggang kekuatan. Sungguh, telah tegak dunia, tidak bergoyang;"
 },
 {
   "id": 15433,
   "kitab": "Mzm",
   "pasal": 93,
   "ayat": 2,
   "firman": "takhta-Mu tegak sejak dahulu kala, dari kekal Engkau ada."
 },
 {
   "id": 15434,
   "kitab": "Mzm",
   "pasal": 93,
   "ayat": 3,
   "firman": "Sungai-sungai telah mengangkat, ya TUHAN, sungai-sungai telah mengangkat suaranya, sungai-sungai mengangkat bunyi hempasannya."
 },
 {
   "id": 15435,
   "kitab": "Mzm",
   "pasal": 93,
   "ayat": 4,
   "firman": "Dari pada suara air yang besar, dari pada pecahan ombak laut yang hebat, lebih hebat TUHAN di tempat tinggi."
 },
 {
   "id": 15436,
   "kitab": "Mzm",
   "pasal": 93,
   "ayat": 5,
   "firman": "Peraturan-Mu sangat teguh; bait-Mu layak kudus, ya TUHAN, untuk sepanjang masa."
 },
 {
   "id": 15437,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 1,
   "firman": "Ya Allah pembalas, ya TUHAN, ya Allah pembalas, tampillah!"
 },
 {
   "id": 15438,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 2,
   "firman": "Bangunlah, ya Hakim bumi, balaslah kepada orang-orang congkak apa yang mereka lakukan!"
 },
 {
   "id": 15439,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 3,
   "firman": "Berapa lama lagi orang-orang fasik, ya TUHAN, berapa lama lagi orang-orang fasik beria-ria?"
 },
 {
   "id": 15440,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 4,
   "firman": "Mereka memuntahkan kata-kata yang kurang ajar dan semua orang yang melakukan kejahatan itu menyombong."
 },
 {
   "id": 15441,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 5,
   "firman": "Umat-Mu, ya TUHAN, mereka remukkan, dan milik-Mu sendiri mereka tindas;"
 },
 {
   "id": 15442,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 6,
   "firman": "janda dan orang asing mereka sembelih, dan anak-anak yatim mereka bunuh;"
 },
 {
   "id": 15443,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 7,
   "firman": "dan mereka berkata: \"TUHAN tidak melihatnya, dan Allah Yakub tidak mengindahkannya.\""
 },
 {
   "id": 15444,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 8,
   "firman": "Perhatikanlah, hai orang-orang bodoh di antara rakyat! Hai orang-orang bebal, bilakah kamu memakai akal budimu?"
 },
 {
   "id": 15445,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 9,
   "firman": "Dia yang menanamkan telinga, masakan tidak mendengar? Dia yang membentuk mata, masakan tidak memandang?"
 },
 {
   "id": 15446,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 10,
   "firman": "Dia yang menghajar bangsa-bangsa, masakan tidak akan menghukum? Dia yang mengajarkan pengetahuan kepada manusia?"
 },
 {
   "id": 15447,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 11,
   "firman": "TUHAN mengetahui rancangan-rancangan manusia; sesungguhnya semuanya sia-sia belaka."
 },
 {
   "id": 15448,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 12,
   "firman": "Berbahagialah orang yang Kauhajar, ya TUHAN, dan yang Kauajari dari Taurat-Mu,"
 },
 {
   "id": 15449,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 13,
   "firman": "untuk menenangkan dia terhadap hari-hari malapetaka, sampai digali lobang untuk orang fasik."
 },
 {
   "id": 15450,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 14,
   "firman": "Sebab TUHAN tidak akan membuang umat-Nya, dan milik-Nya sendiri tidak akan ditinggalkan-Nya;"
 },
 {
   "id": 15451,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 15,
   "firman": "sebab hukum akan kembali kepada keadilan, dan akan diikuti oleh semua orang yang tulus hati."
 },
 {
   "id": 15452,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 16,
   "firman": "Siapakah yang bangkit bagiku melawan orang-orang jahat, siapakah yang tampil bagiku melawan orang-orang yang melakukan kejahatan?"
 },
 {
   "id": 15453,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 17,
   "firman": "Jika bukan TUHAN yang menolong aku, nyaris aku diam di tempat sunyi."
 },
 {
   "id": 15454,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 18,
   "firman": "Ketika aku berpikir: \"Kakiku goyang,\" maka kasih setia-Mu, ya TUHAN, menyokong aku."
 },
 {
   "id": 15455,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 19,
   "firman": "Apabila bertambah banyak pikiran dalam batinku, penghiburan-Mu menyenangkan jiwaku."
 },
 {
   "id": 15456,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 20,
   "firman": "Masakan bersekutu dengan Engkau takhta kebusukan, yang merancangkan bencana berdasarkan ketetapan?"
 },
 {
   "id": 15457,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 21,
   "firman": "Mereka bersekongkol melawan jiwa orang benar, dan menyatakan fasik darah orang yang tidak bersalah."
 },
 {
   "id": 15458,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 22,
   "firman": "Tetapi TUHAN adalah kota bentengku dan Allahku adalah gunung batu perlindunganku."
 },
 {
   "id": 15459,
   "kitab": "Mzm",
   "pasal": 94,
   "ayat": 23,
   "firman": "Ia akan membalas kepada mereka perbuatan jahat mereka, dan karena kejahatan mereka Ia akan membinasakan mereka; TUHAN, Allah kita, akan membinasakan mereka."
 },
 {
   "id": 15460,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 1,
   "firman": "Marilah kita bersorak-sorai untuk TUHAN, bersorak-sorak bagi gunung batu keselamatan kita."
 },
 {
   "id": 15461,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 2,
   "firman": "Biarlah kita menghadap wajah-Nya dengan nyanyian syukur, bersorak-sorak bagi-Nya dengan nyanyian mazmur."
 },
 {
   "id": 15462,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 3,
   "firman": "Sebab TUHAN adalah Allah yang besar, dan Raja yang besar mengatasi segala allah."
 },
 {
   "id": 15463,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 4,
   "firman": "Bagian-bagian bumi yang paling dalam ada di tangan-Nya, puncak gunung-gunungpun kepunyaan-Nya."
 },
 {
   "id": 15464,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 5,
   "firman": "Kepunyaan-Nya laut, Dialah yang menjadikannya, dan darat, tangan-Nyalah yang membentuknya."
 },
 {
   "id": 15465,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 6,
   "firman": "Masuklah, marilah kita sujud menyembah, berlutut di hadapan TUHAN yang menjadikan kita."
 },
 {
   "id": 15466,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 7,
   "firman": "Sebab Dialah Allah kita, dan kitalah umat gembalaan-Nya dan kawanan domba tuntunan tangan-Nya. Pada hari ini, sekiranya kamu mendengar suara-Nya!"
 },
 {
   "id": 15467,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 8,
   "firman": "Janganlah keraskan hatimu seperti di Meriba, seperti pada hari di Masa di padang gurun,"
 },
 {
   "id": 15468,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 9,
   "firman": "pada waktu nenek moyangmu mencobai Aku, menguji Aku, padahal mereka melihat perbuatan-Ku."
 },
 {
   "id": 15469,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 10,
   "firman": "Empat puluh tahun Aku jemu kepada angkatan itu, maka kata-Ku: \"Mereka suatu bangsa yang sesat hati, dan mereka itu tidak mengenal jalan-Ku.\""
 },
 {
   "id": 15470,
   "kitab": "Mzm",
   "pasal": 95,
   "ayat": 11,
   "firman": "Sebab itu Aku bersumpah dalam murka-Ku: \"Mereka takkan masuk ke tempat perhentian-Ku.\""
 },
 {
   "id": 15471,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 1,
   "firman": "Nyanyikanlah nyanyian baru bagi TUHAN, menyanyilah bagi TUHAN, hai segenap bumi!"
 },
 {
   "id": 15472,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 2,
   "firman": "Menyanyilah bagi TUHAN, pujilah nama-Nya, kabarkanlah keselamatan yang dari pada-Nya dari hari ke hari."
 },
 {
   "id": 15473,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 3,
   "firman": "Ceritakanlah kemuliaan-Nya di antara bangsa-bangsa dan perbuatan-perbuatan yang ajaib di antara segala suku bangsa."
 },
 {
   "id": 15474,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 4,
   "firman": "Sebab TUHAN maha besar dan terpuji sangat, Ia lebih dahsyat dari pada segala allah."
 },
 {
   "id": 15475,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 5,
   "firman": "Sebab segala allah bangsa-bangsa adalah hampa, tetapi Tuhanlah yang menjadikan langit."
 },
 {
   "id": 15476,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 6,
   "firman": "Keagungan dan semarak ada di hadapan-Nya, kekuatan dan kehormatan ada di tempat kudus-Nya."
 },
 {
   "id": 15477,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 7,
   "firman": "Kepada TUHAN, hai suku-suku bangsa, kepada TUHAN sajalah kemuliaan dan kekuatan!"
 },
 {
   "id": 15478,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 8,
   "firman": "Berilah kepada TUHAN kemuliaan nama-Nya, bawalah persembahan dan masuklah ke pelataran-Nya!"
 },
 {
   "id": 15479,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 9,
   "firman": "Sujudlah menyembah kepada TUHAN dengan berhiaskan kekudusan, gemetarlah di hadapan-Nya, hai segenap bumi!"
 },
 {
   "id": 15480,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 10,
   "firman": "Katakanlah di antara bangsa-bangsa: \"TUHAN itu Raja! Sungguh tegak dunia, tidak goyang. Ia akan mengadili bangsa-bangsa dalam kebenaran.\""
 },
 {
   "id": 15481,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 11,
   "firman": "Biarlah langit bersukacita dan bumi bersorak-sorak, biarlah gemuruh laut serta isinya,"
 },
 {
   "id": 15482,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 12,
   "firman": "biarlah beria-ria padang dan segala yang di atasnya, maka segala pohon di hutan bersorak-sorai"
 },
 {
   "id": 15483,
   "kitab": "Mzm",
   "pasal": 96,
   "ayat": 13,
   "firman": "di hadapan TUHAN, sebab Ia datang, sebab Ia datang untuk menghakimi bumi. Ia akan menghakimi dunia dengan keadilan, dan bangsa-bangsa dengan kesetiaan-Nya."
 },
 {
   "id": 15484,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 1,
   "firman": "TUHAN adalah Raja! Biarlah bumi bersorak-sorak, biarlah banyak pulau bersukacita!"
 },
 {
   "id": 15485,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 2,
   "firman": "Awan dan kekelaman ada sekeliling Dia, keadilan dan hukum adalah tumpuan takhta-Nya."
 },
 {
   "id": 15486,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 3,
   "firman": "Api menjalar di hadapan-Nya, dan menghanguskan para lawan-Nya sekeliling."
 },
 {
   "id": 15487,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 4,
   "firman": "Kilat-kilat-Nya menerangi dunia, bumi melihatnya dan gemetar."
 },
 {
   "id": 15488,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 5,
   "firman": "Gunung-gunung luluh seperti lilin di hadapan TUHAN, di hadapan Tuhan seluruh bumi."
 },
 {
   "id": 15489,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 6,
   "firman": "Langit memberitakan keadilan-Nya, dan segala bangsa melihat kemuliaan-Nya."
 },
 {
   "id": 15490,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 7,
   "firman": "Semua orang yang beribadah kepada patung akan mendapat malu, orang yang memegahkan diri karena berhala-berhala; segala allah sujud menyembah kepada-Nya."
 },
 {
   "id": 15491,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 8,
   "firman": "Sion mendengarnya dan bersukacita, puteri-puteri Yehuda bersorak-sorak, oleh karena penghukuman-Mu, ya TUHAN."
 },
 {
   "id": 15492,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 9,
   "firman": "Sebab Engkaulah, ya TUHAN, Yang Mahatinggi di atas seluruh bumi, Engkau sangat dimuliakan di atas segala allah."
 },
 {
   "id": 15493,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 10,
   "firman": "Hai orang-orang yang mengasihi TUHAN, bencilah kejahatan! Dia, yang memelihara nyawa orang-orang yang dikasihi-Nya, akan melepaskan mereka dari tangan orang-orang fasik."
 },
 {
   "id": 15494,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 11,
   "firman": "Terang sudah terbit bagi orang benar, dan sukacita bagi orang-orang yang tulus hati."
 },
 {
   "id": 15495,
   "kitab": "Mzm",
   "pasal": 97,
   "ayat": 12,
   "firman": "Bersukacitalah karena TUHAN, hai orang-orang benar, dan nyanyikanlah syukur bagi nama-Nya yang kudus."
 },
 {
   "id": 15496,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 1,
   "firman": "Mazmur. Nyanyikanlah nyanyian baru bagi TUHAN, sebab Ia telah melakukan perbuatan-perbuatan yang ajaib; keselamatan telah dikerjakan kepada-Nya oleh tangan kanan-Nya, oleh lengan-Nya yang kudus."
 },
 {
   "id": 15497,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 2,
   "firman": "TUHAN telah memperkenalkan keselamatan yang dari pada-Nya, telah menyatakan keadilan-Nya di depan mata bangsa-bangsa."
 },
 {
   "id": 15498,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 3,
   "firman": "Ia mengingat kasih setia dan kesetiaan-Nya terhadap kaum Israel, segala ujung bumi telah melihat keselamatan yang dari pada Allah kita."
 },
 {
   "id": 15499,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 4,
   "firman": "Bersorak-soraklah bagi TUHAN, hai seluruh bumi, bergembiralah, bersorak-sorailah dan bermazmurlah!"
 },
 {
   "id": 15500,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 5,
   "firman": "Bermazmurlah bagi TUHAN dengan kecapi, dengan kecapi dan lagu yang nyaring,"
 },
 {
   "id": 15501,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 6,
   "firman": "dengan nafiri dan sangkakala yang nyaring bersorak-soraklah di hadapan Raja, yakni TUHAN!"
 },
 {
   "id": 15502,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 7,
   "firman": "Biarlah gemuruh laut serta isinya, dunia serta yang diam di dalamnya!"
 },
 {
   "id": 15503,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 8,
   "firman": "Biarlah sungai-sungai bertepuk tangan, dan gunung-gunung bersorak-sorai bersama-sama"
 },
 {
   "id": 15504,
   "kitab": "Mzm",
   "pasal": 98,
   "ayat": 9,
   "firman": "di hadapan TUHAN, sebab Ia datang untuk menghakimi bumi. Ia akan menghakimi dunia dengan keadilan, dan bangsa-bangsa dengan kebenaran."
 },
 {
   "id": 15505,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 1,
   "firman": "TUHAN itu Raja, maka bangsa-bangsa gemetar. Ia duduk di atas kerub-kerub, maka bumi goyang."
 },
 {
   "id": 15506,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 2,
   "firman": "TUHAN itu maha besar di Sion, dan Ia tinggi mengatasi segala bangsa."
 },
 {
   "id": 15507,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 3,
   "firman": "Biarlah mereka menyanyikan syukur bagi nama-Mu yang besar dan dahsyat; Kuduslah Ia!"
 },
 {
   "id": 15508,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 4,
   "firman": "Raja yang kuat, yang mencintai hukum, Engkaulah yang menegakkan kebenaran; hukum dan keadilan di antara keturunan Yakub, Engkaulah yang melakukannya."
 },
 {
   "id": 15509,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 5,
   "firman": "Tinggikanlah TUHAN, Allah kita, dan sujudlah menyembah kepada tumpuan kaki-Nya! Kuduslah Ia!"
 },
 {
   "id": 15510,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 6,
   "firman": "Musa dan Harun di antara imam-imam-Nya, dan Samuel di antara orang-orang yang menyerukan nama-Nya. Mereka berseru kepada TUHAN dan Ia menjawab mereka."
 },
 {
   "id": 15511,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 7,
   "firman": "Dalam tiang awan Ia berbicara kepada mereka; mereka telah berpegang pada peringatan-peringatan-Nya dan ketetapan yang diberikan-Nya kepada mereka."
 },
 {
   "id": 15512,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 8,
   "firman": "TUHAN, Allah kami, Engkau telah menjawab mereka, Engkau Allah yang mengampuni bagi mereka, tetapi yang membalas perbuatan-perbuatan mereka."
 },
 {
   "id": 15513,
   "kitab": "Mzm",
   "pasal": 99,
   "ayat": 9,
   "firman": "Tinggikanlah TUHAN, Allah kita, dan sujudlah menyembah di hadapan gunung-Nya yang kudus! Sebab kuduslah TUHAN, Allah kita!"
 },
 {
   "id": 15514,
   "kitab": "Mzm",
   "pasal": 100,
   "ayat": 1,
   "firman": "Mazmur untuk korban syukur. Bersorak-soraklah bagi TUHAN, hai seluruh bumi!"
 },
 {
   "id": 15515,
   "kitab": "Mzm",
   "pasal": 100,
   "ayat": 2,
   "firman": "Beribadahlah kepada TUHAN dengan sukacita, datanglah ke hadapan-Nya dengan sorak-sorai!"
 },
 {
   "id": 15516,
   "kitab": "Mzm",
   "pasal": 100,
   "ayat": 3,
   "firman": "Ketahuilah, bahwa Tuhanlah Allah; Dialah yang menjadikan kita dan punya Dialah kita, umat-Nya dan kawanan domba gembalaan-Nya."
 },
 {
   "id": 15517,
   "kitab": "Mzm",
   "pasal": 100,
   "ayat": 4,
   "firman": "Masuklah melalui pintu gerbang-Nya dengan nyanyian syukur, ke dalam pelataran-Nya dengan puji-pujian, bersyukurlah kepada-Nya dan pujilah nama-Nya!"
 },
 {
   "id": 15518,
   "kitab": "Mzm",
   "pasal": 100,
   "ayat": 5,
   "firman": "Sebab TUHAN itu baik, kasih setia-Nya untuk selama-lamanya, dan kesetiaan-Nya tetap turun-temurun."
 },
 {
   "id": 15519,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 1,
   "firman": "Mazmur Daud. Aku hendak menyanyikan kasih setia dan hukum, aku hendak bermazmur bagi-Mu, ya TUHAN."
 },
 {
   "id": 15520,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 2,
   "firman": "Aku hendak memperhatikan hidup yang tidak bercela: Bilakah Engkau datang kepadaku? Aku hendak hidup dalam ketulusan hatiku di dalam rumahku."
 },
 {
   "id": 15521,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 3,
   "firman": "Tiada kutaruh di depan mataku perkara dursila; perbuatan murtad aku benci, itu takkan melekat padaku."
 },
 {
   "id": 15522,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 4,
   "firman": "Hati yang bengkok akan menjauh dari padaku, kejahatan aku tidak mau tahu."
 },
 {
   "id": 15523,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 5,
   "firman": "Orang yang sembunyi-sembunyi mengumpat temannya, dia akan kubinasakan. Orang yang sombong dan tinggi hati, aku tidak suka."
 },
 {
   "id": 15524,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 6,
   "firman": "Mataku tertuju kepada orang-orang yang setiawan di negeri, supaya mereka diam bersama-sama dengan aku. Orang yang hidup dengan cara yang tak bercela, akan melayani aku."
 },
 {
   "id": 15525,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 7,
   "firman": "Orang yang melakukan tipu daya tidak akan diam di dalam rumahku, orang yang berbicara dusta tidak akan tegak di depan mataku."
 },
 {
   "id": 15526,
   "kitab": "Mzm",
   "pasal": 101,
   "ayat": 8,
   "firman": "Setiap pagi akan kubinasakan semua orang fasik di negeri; akan kulenyapkan dari kota TUHAN, semua orang yang melakukan kejahatan."
 },
 {
   "id": 15527,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 1,
   "firman": "Doa seorang sengsara, pada waktu ia lemah lesu dan mencurahkan pengaduhannya ke hadapan TUHAN. (102-2) TUHAN, dengarkanlah doaku, dan biarlah teriakku minta tolong sampai kepada-Mu."
 },
 {
   "id": 15528,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 2,
   "firman": "(102-3) Janganlah sembunyikan wajah-Mu terhadap aku pada hari aku tersesak. Sendengkanlah telinga-Mu kepadaku; pada hari aku berseru, segeralah menjawab aku!"
 },
 {
   "id": 15529,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 3,
   "firman": "(102-4) Sebab hari-hariku habis seperti asap, tulang-tulangku membara seperti perapian."
 },
 {
   "id": 15530,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 4,
   "firman": "(102-5) Hatiku terpukul dan layu seperti rumput, sehingga aku lupa makan rotiku."
 },
 {
   "id": 15531,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 5,
   "firman": "(102-6) Oleh sebab keluhanku yang nyaring, aku tinggal tulang-belulang."
 },
 {
   "id": 15532,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 6,
   "firman": "(102-7) Aku sudah menyerupai burung undan di padang gurun, sudah menjadi seperti burung ponggok pada reruntuhan."
 },
 {
   "id": 15533,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 7,
   "firman": "(102-8) Aku tak bisa tidur dan sudah menjadi seperti burung terpencil di atas sotoh."
 },
 {
   "id": 15534,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 8,
   "firman": "(102-9) Sepanjang hari aku dicela oleh musuh-musuhku, orang-orang yang mempermainkan aku menyumpah dengan menyebut namaku."
 },
 {
   "id": 15535,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 9,
   "firman": "(102-10) Sebab aku makan abu seperti roti, dan mencampur minumanku dengan tangisan,"
 },
 {
   "id": 15536,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 10,
   "firman": "(102-11) oleh karena marah-Mu dan geram-Mu, sebab Engkau telah mengangkat aku dan melemparkan aku."
 },
 {
   "id": 15537,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 11,
   "firman": "(102-12) Hari-hariku seperti bayang-bayang memanjang, dan aku sendiri layu seperti rumput."
 },
 {
   "id": 15538,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 12,
   "firman": "(102-13) Tetapi Engkau, ya TUHAN, bersemayam untuk selama-lamanya, dan nama-Mu tetap turun-temurun."
 },
 {
   "id": 15539,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 13,
   "firman": "(102-14) Engkau sendiri akan bangun, akan menyayangi Sion, sebab sudah waktunya untuk mengasihaninya, sudah tiba saatnya."
 },
 {
   "id": 15540,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 14,
   "firman": "(102-15) Sebab hamba-hamba-Mu sayang kepada batu-batunya, dan merasa kasihan akan debunya."
 },
 {
   "id": 15541,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 15,
   "firman": "(102-16) Maka bangsa-bangsa menjadi takut akan nama TUHAN, dan semua raja bumi akan kemuliaan-Mu,"
 },
 {
   "id": 15542,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 16,
   "firman": "(102-17) bila TUHAN sudah membangun Sion, sudah menampakkan diri dalam kemuliaan-Nya,"
 },
 {
   "id": 15543,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 17,
   "firman": "(102-18) sudah berpaling mendengarkan doa orang-orang yang bulus, dan tidak memandang hina doa mereka."
 },
 {
   "id": 15544,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 18,
   "firman": "(102-19) Biarlah hal ini dituliskan bagi angkatan yang kemudian, dan bangsa yang diciptakan nanti akan memuji-muji TUHAN,"
 },
 {
   "id": 15545,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 19,
   "firman": "(102-20) sebab Ia telah memandang dari ketinggian-Nya yang kudus, TUHAN memandang dari sorga ke bumi,"
 },
 {
   "id": 15546,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 20,
   "firman": "(102-21) untuk mendengar keluhan orang tahanan, untuk membebaskan orang-orang yang ditentukan mati dibunuh,"
 },
 {
   "id": 15547,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 21,
   "firman": "(102-22) supaya nama TUHAN diceritakan di Sion, dan Dia dipuji-puji di Yerusalem,"
 },
 {
   "id": 15548,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 22,
   "firman": "(102-23) apabila berkumpul bersama-sama bangsa-bangsa dan kerajaan-kerajaan untuk beribadah kepada TUHAN."
 },
 {
   "id": 15549,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 23,
   "firman": "(102-24) Ia telah mematahkan kekuatanku di jalan, dan memperpendek umurku."
 },
 {
   "id": 15550,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 24,
   "firman": "(102-25) Aku berkata: \"Ya Allahku, janganlah mengambil aku pada pertengahan umurku! Tahun-tahun-Mu tetap turun-temurun!\""
 },
 {
   "id": 15551,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 25,
   "firman": "(102-26) Dahulu sudah Kauletakkan dasar bumi, dan langit adalah buatan tangan-Mu."
 },
 {
   "id": 15552,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 26,
   "firman": "(102-27) Semuanya itu akan binasa, tetapi Engkau tetap ada, dan semuanya itu akan menjadi usang seperti pakaian, seperti jubah Engkau akan mengubah mereka, dan mereka berubah;"
 },
 {
   "id": 15553,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 27,
   "firman": "(102-28) tetapi Engkau tetap sama, dan tahun-tahun-Mu tidak berkesudahan."
 },
 {
   "id": 15554,
   "kitab": "Mzm",
   "pasal": 102,
   "ayat": 28,
   "firman": "(102-29) Anak hamba-hamba-Mu akan diam dengan tenteram, dan anak cucu mereka akan tetap ada di hadapan-Mu."
 },
 {
   "id": 15555,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 1,
   "firman": "Dari Daud. Pujilah TUHAN, hai jiwaku! Pujilah nama-Nya yang kudus, hai segenap batinku!"
 },
 {
   "id": 15556,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 2,
   "firman": "Pujilah TUHAN, hai jiwaku, dan janganlah lupakan segala kebaikan-Nya!"
 },
 {
   "id": 15557,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 3,
   "firman": "Dia yang mengampuni segala kesalahanmu, yang menyembuhkan segala penyakitmu,"
 },
 {
   "id": 15558,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 4,
   "firman": "Dia yang menebus hidupmu dari lobang kubur, yang memahkotai engkau dengan kasih setia dan rahmat,"
 },
 {
   "id": 15559,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 5,
   "firman": "Dia yang memuaskan hasratmu dengan kebaikan, sehingga masa mudamu menjadi baru seperti pada burung rajawali."
 },
 {
   "id": 15560,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 6,
   "firman": "TUHAN menjalankan keadilan dan hukum bagi segala orang yang diperas."
 },
 {
   "id": 15561,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 7,
   "firman": "Ia telah memperkenalkan jalan-jalan-Nya kepada Musa, perbuatan-perbuatan-Nya kepada orang Israel."
 },
 {
   "id": 15562,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 8,
   "firman": "TUHAN adalah penyayang dan pengasih, panjang sabar dan berlimpah kasih setia."
 },
 {
   "id": 15563,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 9,
   "firman": "Tidak selalu Ia menuntut, dan tidak untuk selama-lamanya Ia mendendam."
 },
 {
   "id": 15564,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 10,
   "firman": "Tidak dilakukan-Nya kepada kita setimpal dengan dosa kita, dan tidak dibalas-Nya kepada kita setimpal dengan kesalahan kita,"
 },
 {
   "id": 15565,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 11,
   "firman": "tetapi setinggi langit di atas bumi, demikian besarnya kasih setia-Nya atas orang-orang yang takut akan Dia;"
 },
 {
   "id": 15566,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 12,
   "firman": "sejauh timur dari barat, demikian dijauhkan-Nya dari pada kita pelanggaran kita."
 },
 {
   "id": 15567,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 13,
   "firman": "Seperti bapa sayang kepada anak-anaknya, demikian TUHAN sayang kepada orang-orang yang takut akan Dia."
 },
 {
   "id": 15568,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 14,
   "firman": "Sebab Dia sendiri tahu apa kita, Dia ingat, bahwa kita ini debu."
 },
 {
   "id": 15569,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 15,
   "firman": "Adapun manusia, hari-harinya seperti rumput, seperti bunga di padang demikianlah ia berbunga;"
 },
 {
   "id": 15570,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 16,
   "firman": "apabila angin melintasinya, maka tidak ada lagi ia, dan tempatnya tidak mengenalnya lagi."
 },
 {
   "id": 15571,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 17,
   "firman": "Tetapi kasih setia TUHAN dari selama-lamanya sampai selama-lamanya atas orang-orang yang takut akan Dia, dan keadilan-Nya bagi anak cucu,"
 },
 {
   "id": 15572,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 18,
   "firman": "bagi orang-orang yang berpegang pada perjanjian-Nya dan yang ingat untuk melakukan titah-Nya."
 },
 {
   "id": 15573,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 19,
   "firman": "TUHAN sudah menegakkan takhta-Nya di sorga dan kerajaan-Nya berkuasa atas segala sesuatu."
 },
 {
   "id": 15574,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 20,
   "firman": "Pujilah TUHAN, hai malaikat-malaikat-Nya, hai pahlawan-pahlawan perkasa yang melaksanakan firman-Nya dengan mendengarkan suara firman-Nya."
 },
 {
   "id": 15575,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 21,
   "firman": "Pujilah TUHAN, hai segala tentara-Nya, hai pejabat-pejabat-Nya yang melakukan kehendak-Nya."
 },
 {
   "id": 15576,
   "kitab": "Mzm",
   "pasal": 103,
   "ayat": 22,
   "firman": "Pujilah TUHAN, hai segala buatan-Nya, di segala tempat kekuasaan-Nya! Pujilah TUHAN, hai jiwaku!"
 },
 {
   "id": 15577,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 1,
   "firman": "Pujilah TUHAN, hai jiwaku! TUHAN, Allahku, Engkau sangat besar! Engkau yang berpakaian keagungan dan semarak,"
 },
 {
   "id": 15578,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 2,
   "firman": "yang berselimutkan terang seperti kain, yang membentangkan langit seperti tenda,"
 },
 {
   "id": 15579,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 3,
   "firman": "yang mendirikan kamar-kamar loteng-Mu di air, yang menjadikan awan-awan sebagai kendaraan-Mu, yang bergerak di atas sayap angin,"
 },
 {
   "id": 15580,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 4,
   "firman": "yang membuat angin sebagai suruhan-suruhan-Mu, dan api yang menyala sebagai pelayan-pelayan-Mu,"
 },
 {
   "id": 15581,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 5,
   "firman": "yang telah mendasarkan bumi di atas tumpuannya, sehingga takkan goyang untuk seterusnya dan selamanya."
 },
 {
   "id": 15582,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 6,
   "firman": "Dengan samudera raya Engkau telah menyelubunginya; air telah naik melampaui gunung-gunung."
 },
 {
   "id": 15583,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 7,
   "firman": "Terhadap hardik-Mu air itu melarikan diri, lari kebingungan terhadap suara guntur-Mu,"
 },
 {
   "id": 15584,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 8,
   "firman": "naik gunung, turun lembah ke tempat yang Kautetapkan bagi mereka."
 },
 {
   "id": 15585,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 9,
   "firman": "Batas Kautentukan, takkan mereka lewati, takkan kembali mereka menyelubungi bumi."
 },
 {
   "id": 15586,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 10,
   "firman": "Engkau yang melepas mata-mata air ke dalam lembah-lembah, mengalir di antara gunung-gunung,"
 },
 {
   "id": 15587,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 11,
   "firman": "memberi minum segala binatang di padang, memuaskan haus keledai-keledai hutan;"
 },
 {
   "id": 15588,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 12,
   "firman": "di dekatnya diam burung-burung di udara, bersiul dari antara daun-daunan."
 },
 {
   "id": 15589,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 13,
   "firman": "Engkau yang memberi minum gunung-gunung dari kamar-kamar loteng-Mu, bumi kenyang dari buah pekerjaan-Mu."
 },
 {
   "id": 15590,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 14,
   "firman": "Engkau yang menumbuhkan rumput bagi hewan dan tumbuh-tumbuhan untuk diusahakan manusia, yang mengeluarkan makanan dari dalam tanah"
 },
 {
   "id": 15591,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 15,
   "firman": "dan anggur yang menyukakan hati manusia, yang membuat muka berseri karena minyak, dan makanan yang menyegarkan hati manusia."
 },
 {
   "id": 15592,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 16,
   "firman": "Kenyang pohon-pohon TUHAN, pohon-pohon aras di Libanon yang ditanam-Nya,"
 },
 {
   "id": 15593,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 17,
   "firman": "di mana burung-burung bersarang, burung ranggung yang rumahnya di pohon-pohon sanobar;"
 },
 {
   "id": 15594,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 18,
   "firman": "gunung-gunung tinggi adalah bagi kambing-kambing hutan, bukit-bukit batu adalah tempat perlindungan bagi pelanduk."
 },
 {
   "id": 15595,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 19,
   "firman": "Engkau yang telah membuat bulan menjadi penentu waktu, matahari yang tahu akan saat terbenamnya."
 },
 {
   "id": 15596,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 20,
   "firman": "Apabila Engkau mendatangkan gelap, maka haripun malamlah; ketika itulah bergerak segala binatang hutan."
 },
 {
   "id": 15597,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 21,
   "firman": "Singa-singa muda mengaum-aum akan mangsa, dan menuntut makanannya dari Allah."
 },
 {
   "id": 15598,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 22,
   "firman": "Apabila matahari terbit, berkumpullah semuanya dan berbaring di tempat perteduhannya;"
 },
 {
   "id": 15599,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 23,
   "firman": "manusiapun keluarlah ke pekerjaannya, dan ke usahanya sampai petang."
 },
 {
   "id": 15600,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 24,
   "firman": "Betapa banyak perbuatan-Mu, ya TUHAN, sekaliannya Kaujadikan dengan kebijaksanaan, bumi penuh dengan ciptaan-Mu."
 },
 {
   "id": 15601,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 25,
   "firman": "Lihatlah laut itu, besar dan luas wilayahnya, di situ bergerak, tidak terbilang banyaknya, binatang-binatang yang kecil dan besar."
 },
 {
   "id": 15602,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 26,
   "firman": "Di situ kapal-kapal berlayar dan Lewiatan yang telah Kaubentuk untuk bermain dengannya."
 },
 {
   "id": 15603,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 27,
   "firman": "Semuanya menantikan Engkau, supaya diberikan makanan pada waktunya."
 },
 {
   "id": 15604,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 28,
   "firman": "Apabila Engkau memberikannya, mereka memungutnya; apabila Engkau membuka tangan-Mu, mereka kenyang oleh kebaikan."
 },
 {
   "id": 15605,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 29,
   "firman": "Apabila Engkau menyembunyikan wajah-Mu, mereka terkejut; apabila Engkau mengambil roh mereka, mereka mati binasa dan kembali menjadi debu."
 },
 {
   "id": 15606,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 30,
   "firman": "Apabila Engkau mengirim roh-Mu, mereka tercipta, dan Engkau membaharui muka bumi."
 },
 {
   "id": 15607,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 31,
   "firman": "Biarlah kemuliaan TUHAN tetap untuk selama-lamanya, biarlah TUHAN bersukacita karena perbuatan-perbuatan-Nya!"
 },
 {
   "id": 15608,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 32,
   "firman": "Dia yang memandang bumi sehingga bergentar, yang menyentuh gunung-gunung sehingga berasap."
 },
 {
   "id": 15609,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 33,
   "firman": "Aku hendak menyanyi bagi TUHAN selama aku hidup, aku hendak bermazmur bagi Allahku selagi aku ada."
 },
 {
   "id": 15610,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 34,
   "firman": "Biarlah renunganku manis kedengaran kepada-Nya! Aku hendak bersukacita karena TUHAN."
 },
 {
   "id": 15611,
   "kitab": "Mzm",
   "pasal": 104,
   "ayat": 35,
   "firman": "Biarlah habis orang-orang berdosa dari bumi, dan biarlah orang-orang fasik tidak ada lagi! Pujilah TUHAN, hai jiwaku! Haleluya!"
 },
 {
   "id": 15612,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 1,
   "firman": "Bersyukurlah kepada TUHAN, serukanlah nama-Nya, perkenalkanlah perbuatan-Nya di antara bangsa-bangsa!"
 },
 {
   "id": 15613,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 2,
   "firman": "Bernyanyilah bagi-Nya, bermazmurlah bagi-Nya, percakapkanlah segala perbuatan-Nya yang ajaib!"
 },
 {
   "id": 15614,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 3,
   "firman": "Bermegahlah di dalam nama-Nya yang kudus, biarlah bersukahati orang-orang yang mencari TUHAN!"
 },
 {
   "id": 15615,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 4,
   "firman": "Carilah TUHAN dan kekuatan-Nya, carilah wajah-Nya selalu!"
 },
 {
   "id": 15616,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 5,
   "firman": "Ingatlah perbuatan-perbuatan ajaib yang dilakukan-Nya, mujizat-mujizat-Nya dan penghukuman-penghukuman yang diucapkan-Nya,"
 },
 {
   "id": 15617,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 6,
   "firman": "hai anak cucu Abraham, hamba-Nya, hai anak-anak Yakub, orang-orang pilihan-Nya!"
 },
 {
   "id": 15618,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 7,
   "firman": "Dialah TUHAN, Allah kita, di seluruh bumi berlaku penghukuman-Nya."
 },
 {
   "id": 15619,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 8,
   "firman": "Ia ingat untuk selama-lamanya akan perjanjian-Nya, firman yang diperintahkan-Nya kepada seribu angkatan,"
 },
 {
   "id": 15620,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 9,
   "firman": "yang diikat-Nya dengan Abraham, dan akan sumpah-Nya kepada Ishak;"
 },
 {
   "id": 15621,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 10,
   "firman": "diadakan-Nya hal itu menjadi ketetapan bagi Yakub, menjadi perjanjian kekal bagi Israel,"
 },
 {
   "id": 15622,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 11,
   "firman": "firman-Nya: \"Kepadamu akan Kuberikan tanah Kanaan, sebagai milik pusaka yang ditentukan bagimu.\""
 },
 {
   "id": 15623,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 12,
   "firman": "Ketika jumlah mereka tidak seberapa, sedikit saja, dan mereka orang-orang asing di sana,"
 },
 {
   "id": 15624,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 13,
   "firman": "dan mengembara dari bangsa yang satu ke bangsa yang lain, dari kerajaan yang satu ke suku bangsa yang lain,"
 },
 {
   "id": 15625,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 14,
   "firman": "Ia tidak membiarkan seorangpun memeras mereka, raja-raja dihukum-Nya oleh karena mereka:"
 },
 {
   "id": 15626,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 15,
   "firman": "\"Jangan mengusik orang-orang yang Kuurapi, dan jangan berbuat jahat kepada nabi-nabi-Ku!\""
 },
 {
   "id": 15627,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 16,
   "firman": "Ketika Ia mendatangkan kelaparan ke atas negeri itu, dan menghancurkan seluruh persediaan makanan,"
 },
 {
   "id": 15628,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 17,
   "firman": "diutus-Nyalah seorang mendahului mereka: Yusuf, yang dijual menjadi budak."
 },
 {
   "id": 15629,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 18,
   "firman": "Mereka mengimpit kakinya dengan belenggu, lehernya masuk ke dalam besi,"
 },
 {
   "id": 15630,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 19,
   "firman": "sampai saat firman-Nya sudah genap, dan janji TUHAN membenarkannya."
 },
 {
   "id": 15631,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 20,
   "firman": "Raja menyuruh melepaskannya, penguasa bangsa-bangsa membebaskannya."
 },
 {
   "id": 15632,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 21,
   "firman": "Dijadikannya dia tuan atas istananya, dan kuasa atas segala harta kepunyaannya,"
 },
 {
   "id": 15633,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 22,
   "firman": "untuk memberikan petunjuk kepada para pembesarnya sekehendak hatinya dan mengajarkan hikmat kepada para tua-tuanya."
 },
 {
   "id": 15634,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 23,
   "firman": "Demikianlah Israel datang ke Mesir, dan Yakub tinggal sebagai orang asing di tanah Ham."
 },
 {
   "id": 15635,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 24,
   "firman": "TUHAN membuat umat-Nya sangat subur, dan menjadikannya lebih kuat dari pada para lawannya;"
 },
 {
   "id": 15636,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 25,
   "firman": "diubah-Nya hati mereka untuk membenci umat-Nya, untuk memperdayakan hamba-hamba-Nya."
 },
 {
   "id": 15637,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 26,
   "firman": "Diutus-Nya Musa, hamba-Nya, dan Harun yang telah dipilih-Nya;"
 },
 {
   "id": 15638,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 27,
   "firman": "keduanya mengadakan tanda-tanda-Nya di antara mereka, dan mujizat-mujizat di tanah Ham:"
 },
 {
   "id": 15639,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 28,
   "firman": "dikirim-Nya kegelapan, maka hari menjadi gelap, tetapi mereka memberontak terhadap firman-Nya;"
 },
 {
   "id": 15640,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 29,
   "firman": "diubah-Nya air mereka menjadi darah, dan dimatikan-Nya ikan-ikan mereka."
 },
 {
   "id": 15641,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 30,
   "firman": "Katak-katak berkeriapan di negeri mereka, bahkan di kamar-kamar raja mereka;"
 },
 {
   "id": 15642,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 31,
   "firman": "Ia berfirman, maka datanglah lalat pikat, dan nyamuk-nyamuk di seluruh daerah mereka;"
 },
 {
   "id": 15643,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 32,
   "firman": "dicurahkan-Nya hujan es ganti hujan mereka, dan api yang menyala-nyala di negeri mereka;"
 },
 {
   "id": 15644,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 33,
   "firman": "dirubuhkan-Nya pohon anggur dan pohon ara mereka, dan ditumbangkan-Nya pohon di daerah mereka;"
 },
 {
   "id": 15645,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 34,
   "firman": "Ia berfirman, maka datanglah belalang dan belalang pelompat tidak terbilang banyaknya,"
 },
 {
   "id": 15646,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 35,
   "firman": "yang memakan segala tumbuh-tumbuhan di negeri mereka, dan memakan hasil tanah mereka;"
 },
 {
   "id": 15647,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 36,
   "firman": "dibunuh-Nya semua anak sulung di negeri mereka, mula segala kegagahan mereka:"
 },
 {
   "id": 15648,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 37,
   "firman": "Dituntun-Nya mereka keluar membawa perak dan emas, dan di antara suku-suku mereka tidak ada yang tergelincir."
 },
 {
   "id": 15649,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 38,
   "firman": "Orang Mesir bersukacita, ketika mereka keluar, sebab orang-orang Mesir itu ditimpa ketakutan terhadap mereka."
 },
 {
   "id": 15650,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 39,
   "firman": "Dibentangkan-Nya awan menjadi tudung, dan api untuk menerangi malam."
 },
 {
   "id": 15651,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 40,
   "firman": "Mereka meminta, maka didatangkan-Nya burung puyuh, dan dengan roti dari langit dikenyangkan-Nya mereka."
 },
 {
   "id": 15652,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 41,
   "firman": "Dibuka-Nya gunung batu, maka terpancarlah air, lalu mengalir di padang-padang kering seperti sungai;"
 },
 {
   "id": 15653,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 42,
   "firman": "sebab Ia ingat akan firman-Nya yang kudus, akan Abraham, hamba-Nya."
 },
 {
   "id": 15654,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 43,
   "firman": "Dituntun-Nya umat-Nya keluar dengan kegirangan dan orang-orang pilihan-Nya dengan sorak-sorai."
 },
 {
   "id": 15655,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 44,
   "firman": "Diberikan-Nya kepada mereka negeri-negeri bangsa-bangsa, sehingga mereka memiliki hasil jerih payah suku-suku bangsa,"
 },
 {
   "id": 15656,
   "kitab": "Mzm",
   "pasal": 105,
   "ayat": 45,
   "firman": "agar supaya mereka tetap mengikuti ketetapan-Nya, dan memegang segala pengajaran-Nya. Haleluya!"
 },
 {
   "id": 15657,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 1,
   "firman": "Haleluya! Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 15658,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 2,
   "firman": "Siapakah yang dapat memberitahukan keperkasaan TUHAN, memperdengarkan segala pujian kepada-Nya?"
 },
 {
   "id": 15659,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 3,
   "firman": "Berbahagialah orang-orang yang berpegang pada hukum, yang melakukan keadilan di segala waktu!"
 },
 {
   "id": 15660,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 4,
   "firman": "Ingatlah aku, ya TUHAN, demi kemurahan terhadap umat-Mu, perhatikanlah aku, demi keselamatan dari pada-Mu,"
 },
 {
   "id": 15661,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 5,
   "firman": "supaya aku melihat kebaikan pada orang-orang pilihan-Mu, supaya aku bersukacita dalam sukacita umat-Mu, dan supaya aku bermegah bersama-sama milik-Mu sendiri."
 },
 {
   "id": 15662,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 6,
   "firman": "Kami dan nenek moyang kami telah berbuat dosa, kami telah bersalah, telah berbuat fasik."
 },
 {
   "id": 15663,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 7,
   "firman": "Nenek moyang kami di Mesir tidak mengerti perbuatan-perbuatan-Mu yang ajaib, tidak ingat besarnya kasih setia-Mu, tetapi mereka memberontak terhadap Yang Mahatinggi di tepi Laut Teberau."
 },
 {
   "id": 15664,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 8,
   "firman": "Namun diselamatkan-Nya mereka oleh karena nama-Nya, untuk memperkenalkan keperkasaan-Nya."
 },
 {
   "id": 15665,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 9,
   "firman": "Dihardik-Nya Laut Teberau, sehingga kering, dibawa-Nya mereka berjalan melalui samudera raya seperti melalui padang gurun."
 },
 {
   "id": 15666,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 10,
   "firman": "Demikian diselamatkan-Nya mereka dari tangan pembenci, ditebus-Nya mereka dari tangan musuh;"
 },
 {
   "id": 15667,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 11,
   "firman": "air menutupi para lawan mereka, seorangpun dari pada mereka tiada tinggal."
 },
 {
   "id": 15668,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 12,
   "firman": "Ketika itu percayalah mereka kepada segala firman-Nya, mereka menyanyikan puji-pujian kepada-Nya."
 },
 {
   "id": 15669,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 13,
   "firman": "Tetapi segera mereka melupakan perbuatan-perbuatan-Nya, dan tidak menantikan nasihat-Nya;"
 },
 {
   "id": 15670,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 14,
   "firman": "mereka dirangsang nafsu di padang gurun, dan mencobai Allah di padang belantara."
 },
 {
   "id": 15671,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 15,
   "firman": "Diberikan-Nya kepada mereka apa yang mereka minta, dan didatangkan-Nya penyakit paru-paru di antara mereka."
 },
 {
   "id": 15672,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 16,
   "firman": "Mereka cemburu kepada Musa di perkemahan, dan kepada Harun, orang kudus TUHAN."
 },
 {
   "id": 15673,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 17,
   "firman": "Bumi terbuka dan menelan Datan, menutupi kumpulan Abiram."
 },
 {
   "id": 15674,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 18,
   "firman": "Api menyala di kalangan mereka, nyala api menghanguskan orang-orang fasik itu."
 },
 {
   "id": 15675,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 19,
   "firman": "Mereka membuat anak lembu di Horeb, dan sujud menyembah kepada patung tuangan;"
 },
 {
   "id": 15676,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 20,
   "firman": "mereka menukar Kemuliaan mereka dengan bangunan sapi jantan yang makan rumput."
 },
 {
   "id": 15677,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 21,
   "firman": "Mereka melupakan Allah yang telah menyelamatkan mereka, yang telah melakukan hal-hal yang besar di Mesir:"
 },
 {
   "id": 15678,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 22,
   "firman": "perbuatan-perbuatan ajaib di tanah Ham, perbuatan-perbuatan dahsyat di tepi Laut Teberau."
 },
 {
   "id": 15679,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 23,
   "firman": "Maka Ia mengatakan hendak memusnahkan mereka, kalau Musa, orang pilihan-Nya, tidak mengetengahi di hadapan-Nya, untuk menyurutkan amarah-Nya, sehingga Ia tidak memusnahkan mereka."
 },
 {
   "id": 15680,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 24,
   "firman": "Mereka menolak negeri yang indah itu, tidak percaya kepada firman-Nya."
 },
 {
   "id": 15681,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 25,
   "firman": "Mereka menggerutu di kemahnya dan tidak mendengarkan suara TUHAN."
 },
 {
   "id": 15682,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 26,
   "firman": "Lalu Ia mengangkat tangan-Nya terhadap mereka untuk meruntuhkan mereka di padang gurun,"
 },
 {
   "id": 15683,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 27,
   "firman": "dan untuk mencerai-beraikan anak cucu mereka ke antara bangsa-bangsa, dan menyerakkan mereka ke pelbagai negeri."
 },
 {
   "id": 15684,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 28,
   "firman": "Mereka berpaut pada Baal Peor, dan memakan korban-korban sembelihan bagi orang mati."
 },
 {
   "id": 15685,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 29,
   "firman": "Mereka menyakiti hati-Nya dengan perbuatan mereka, maka timbullah tulah di antara mereka."
 },
 {
   "id": 15686,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 30,
   "firman": "Tetapi Pinehas berdiri dan menjalankan hukum, maka berhentilah tulah itu."
 },
 {
   "id": 15687,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 31,
   "firman": "Hal itu diperhitungkan kepadanya sebagai jasa turun-temurun, untuk selama-lamanya."
 },
 {
   "id": 15688,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 32,
   "firman": "Mereka menggusarkan Dia dekat air Meriba, sehingga Musa kena celaka karena mereka;"
 },
 {
   "id": 15689,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 33,
   "firman": "sebab mereka memahitkan hatinya, sehingga ia teledor dengan kata-katanya."
 },
 {
   "id": 15690,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 34,
   "firman": "Mereka tidak memunahkan bangsa-bangsa, seperti yang diperintahkan TUHAN kepada mereka,"
 },
 {
   "id": 15691,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 35,
   "firman": "tetapi mereka bercampur baur dengan bangsa-bangsa, dan belajar cara-cara mereka bekerja."
 },
 {
   "id": 15692,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 36,
   "firman": "Mereka beribadah kepada berhala-berhala mereka, yang menjadi perangkap bagi mereka."
 },
 {
   "id": 15693,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 37,
   "firman": "Mereka mengorbankan anak-anak lelaki mereka, dan anak-anak perempuan mereka kepada roh-roh jahat,"
 },
 {
   "id": 15694,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 38,
   "firman": "dan menumpahkan darah orang yang tak bersalah, darah anak-anak lelaki dan anak-anak perempuan mereka, yang mereka korbankan kepada berhala-berhala Kanaan, sehingga negeri itu cemar oleh hutang darah."
 },
 {
   "id": 15695,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 39,
   "firman": "Mereka menajiskan diri dengan apa yang mereka lakukan, dan berzinah dalam perbuatan-perbuatan mereka."
 },
 {
   "id": 15696,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 40,
   "firman": "Maka menyalalah murka TUHAN terhadap umat-Nya, dan Ia jijik kepada milik-Nya sendiri."
 },
 {
   "id": 15697,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 41,
   "firman": "Diserahkan-Nyalah mereka ke tangan bangsa-bangsa, sehingga orang-orang yang membenci mereka berkuasa atas mereka."
 },
 {
   "id": 15698,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 42,
   "firman": "Mereka diimpit oleh musuhnya, sehingga takluk ke bawah kuasanya."
 },
 {
   "id": 15699,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 43,
   "firman": "Banyak kali dilepaskan-Nya mereka, tetapi mereka bersikap memberontak dengan rencana-rencana mereka, tenggelam dalam kesalahan mereka."
 },
 {
   "id": 15700,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 44,
   "firman": "Namun Ia menilik kesusahan mereka, ketika Ia mendengar teriak mereka."
 },
 {
   "id": 15701,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 45,
   "firman": "Ia ingat akan perjanjian-Nya karena mereka, dan menyesal sesuai dengan kasih setia-Nya yang besar."
 },
 {
   "id": 15702,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 46,
   "firman": "Diberi-Nya mereka mendapat rahmat dari pihak semua orang yang menawan mereka."
 },
 {
   "id": 15703,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 47,
   "firman": "Selamatkanlah kami, ya TUHAN, Allah kami, dan kumpulkanlah kami dari antara bangsa-bangsa, supaya kami bersyukur kepada nama-Mu yang kudus, dan bermegah dalam puji-pujian kepada-Mu."
 },
 {
   "id": 15704,
   "kitab": "Mzm",
   "pasal": 106,
   "ayat": 48,
   "firman": "Terpujilah TUHAN, Allah Israel, dari selama-lamanya sampai selama-lamanya, dan biarlah seluruh umat mengatakan: \"Amin!\" Haleluya!"
 },
 {
   "id": 15705,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 1,
   "firman": "Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 15706,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 2,
   "firman": "Biarlah itu dikatakan orang-orang yang ditebus TUHAN, yang ditebus-Nya dari kuasa yang menyesakkan,"
 },
 {
   "id": 15707,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 3,
   "firman": "yang dikumpulkan-Nya dari negeri-negeri, dari timur dan dari barat, dari utara dan dari selatan."
 },
 {
   "id": 15708,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 4,
   "firman": "Ada orang-orang yang mengembara di padang belantara, jalan ke kota tempat kediaman orang tidak mereka temukan;"
 },
 {
   "id": 15709,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 5,
   "firman": "mereka lapar dan haus, jiwa mereka lemah lesu di dalam diri mereka."
 },
 {
   "id": 15710,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 6,
   "firman": "Maka berseru-serulah mereka kepada TUHAN dalam kesesakan mereka, dan dilepaskan-Nya mereka dari kecemasan mereka."
 },
 {
   "id": 15711,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 7,
   "firman": "Dibawa-Nya mereka menempuh jalan yang lurus, sehingga sampai ke kota tempat kediaman orang."
 },
 {
   "id": 15712,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 8,
   "firman": "Biarlah mereka bersyukur kepada TUHAN karena kasih setia-Nya, karena perbuatan-perbuatan-Nya yang ajaib terhadap anak-anak manusia,"
 },
 {
   "id": 15713,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 9,
   "firman": "sebab dipuaskan-Nya jiwa yang dahaga, dan jiwa yang lapar dikenyangkan-Nya dengan kebaikan."
 },
 {
   "id": 15714,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 10,
   "firman": "Ada orang-orang yang duduk di dalam gelap dan kelam, terkurung dalam sengsara dan besi."
 },
 {
   "id": 15715,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 11,
   "firman": "Karena mereka memberontak terhadap perintah-perintah Allah, dan menista nasihat Yang Mahatinggi,"
 },
 {
   "id": 15716,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 12,
   "firman": "maka ditundukkan-Nya hati mereka ke dalam kesusahan, mereka tergelincir, dan tidak ada yang menolong."
 },
 {
   "id": 15717,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 13,
   "firman": "Maka berseru-serulah mereka kepada TUHAN dalam kesesakan mereka, dan diselamatkan-Nyalah mereka dari kecemasan mereka,"
 },
 {
   "id": 15718,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 14,
   "firman": "dibawa-Nya mereka keluar dari dalam gelap dan kelam, dan diputuskan-Nya belenggu-belenggu mereka."
 },
 {
   "id": 15719,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 15,
   "firman": "Biarlah mereka bersyukur kepada TUHAN karena kasih setia-Nya, karena perbuatan-perbuatan-Nya yang ajaib terhadap anak-anak manusia,"
 },
 {
   "id": 15720,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 16,
   "firman": "sebab dipecahkan-Nya pintu-pintu tembaga, dan dihancurkan-Nya palang-palang pintu besi."
 },
 {
   "id": 15721,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 17,
   "firman": "Ada orang-orang menjadi sakit oleh sebab kelakuan mereka yang berdosa, dan disiksa oleh sebab kesalahan-kesalahan mereka;"
 },
 {
   "id": 15722,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 18,
   "firman": "mereka muak terhadap segala makanan dan mereka sudah sampai pada pintu gerbang maut."
 },
 {
   "id": 15723,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 19,
   "firman": "Maka berseru-serulah mereka kepada TUHAN dalam kesesakan mereka, dan diselamatkan-Nya mereka dari kecemasan mereka,"
 },
 {
   "id": 15724,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 20,
   "firman": "disampaikan-Nya firman-Nya dan disembuhkan-Nya mereka, diluputkan-Nya mereka dari liang kubur."
 },
 {
   "id": 15725,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 21,
   "firman": "Biarlah mereka bersyukur kepada TUHAN karena kasih setia-Nya, karena perbuatan-perbuatan-Nya yang ajaib terhadap anak-anak manusia."
 },
 {
   "id": 15726,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 22,
   "firman": "Biarlah mereka mempersembahkan korban syukur, dan menceritakan pekerjaan-pekerjaan-Nya dengan sorak-sorai!"
 },
 {
   "id": 15727,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 23,
   "firman": "Ada orang-orang yang mengarungi laut dengan kapal-kapal, yang melakukan perdagangan di lautan luas;"
 },
 {
   "id": 15728,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 24,
   "firman": "mereka melihat pekerjaan-pekerjaan TUHAN, dan perbuatan-perbuatan-Nya yang ajaib di tempat yang dalam."
 },
 {
   "id": 15729,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 25,
   "firman": "Ia berfirman, maka dibangkitkan-Nya angin badai yang meninggikan gelombang-gelombangnya."
 },
 {
   "id": 15730,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 26,
   "firman": "Mereka naik sampai ke langit dan turun ke samudera raya, jiwa mereka hancur karena celaka;"
 },
 {
   "id": 15731,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 27,
   "firman": "mereka pusing dan terhuyung-huyung seperti orang mabuk, dan kehilangan akal."
 },
 {
   "id": 15732,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 28,
   "firman": "Maka berseru-serulah mereka kepada TUHAN dalam kesesakan mereka, dan dikeluarkan-Nya mereka dari kecemasan mereka,"
 },
 {
   "id": 15733,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 29,
   "firman": "dibuat-Nyalah badai itu diam, sehingga gelombang-gelombangnya tenang."
 },
 {
   "id": 15734,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 30,
   "firman": "Mereka bersukacita, sebab semuanya reda, dan dituntun-Nya mereka ke pelabuhan kesukaan mereka."
 },
 {
   "id": 15735,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 31,
   "firman": "Biarlah mereka bersyukur kepada TUHAN karena kasih setia-Nya, karena perbuatan-perbuatan-Nya yang ajaib terhadap anak-anak manusia."
 },
 {
   "id": 15736,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 32,
   "firman": "Biarlah mereka meninggikan Dia dalam jemaat umat itu, dan memuji-muji Dia dalam majelis para tua-tua."
 },
 {
   "id": 15737,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 33,
   "firman": "Dibuat-Nya sungai-sungai menjadi padang gurun, dan pancaran-pancaran air menjadi tanah gersang,"
 },
 {
   "id": 15738,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 34,
   "firman": "tanah yang subur menjadi padang asin, oleh sebab kejahatan orang-orang yang diam di dalamnya."
 },
 {
   "id": 15739,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 35,
   "firman": "Dibuat-Nya padang gurun menjadi kolam air, dan tanah kering menjadi pancaran-pancaran air."
 },
 {
   "id": 15740,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 36,
   "firman": "Ditempatkan-Nya di sana orang-orang lapar, dan mereka mendirikan kota tempat kediaman;"
 },
 {
   "id": 15741,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 37,
   "firman": "mereka menabur di ladang-ladang dan membuat kebun-kebun anggur, yang mengeluarkan buah-buahan sebagai hasil."
 },
 {
   "id": 15742,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 38,
   "firman": "Diberkati-Nya mereka sehingga mereka bertambah banyak dengan sangat, dan hewan-hewan mereka tidak dibuat-Nya berkurang."
 },
 {
   "id": 15743,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 39,
   "firman": "Tetapi mereka menjadi berkurang dan membungkuk oleh sebab tekanan celaka dan duka."
 },
 {
   "id": 15744,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 40,
   "firman": "Ditumpahkan-Nya kehinaan ke atas orang-orang terkemuka, dan dibuat-Nya mereka mengembara di padang tandus yang tiada jalan;"
 },
 {
   "id": 15745,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 41,
   "firman": "tetapi orang miskin dibentengi-Nya terhadap penindasan, dan dibuat-Nya kaum-kaum mereka seperti kawanan domba banyaknya."
 },
 {
   "id": 15746,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 42,
   "firman": "Orang-orang benar melihatnya, lalu bersukacita, tetapi segala kecurangan tutup mulut."
 },
 {
   "id": 15747,
   "kitab": "Mzm",
   "pasal": 107,
   "ayat": 43,
   "firman": "Siapa yang mempunyai hikmat? Biarlah ia berpegang pada semuanya ini, dan memperhatikan segala kemurahan TUHAN."
 },
 {
   "id": 15748,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 1,
   "firman": "Nyanyian. Mazmur Daud. (108-2) Hatiku siap, ya Allah, aku mau menyanyi, aku mau bermazmur. Bangunlah, hai jiwaku,"
 },
 {
   "id": 15749,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 2,
   "firman": "(108-3) bangunlah, hai gambus dan kecapi, aku mau membangunkan fajar."
 },
 {
   "id": 15750,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 3,
   "firman": "(108-4) Aku mau bersyukur kepada-Mu di antara bangsa-bangsa, ya TUHAN, dan aku mau bermazmur bagi-Mu di antara suku-suku bangsa;"
 },
 {
   "id": 15751,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 4,
   "firman": "(108-5) sebab kasih-Mu besar mengatasi langit, dan setia-Mu sampai ke awan-awan."
 },
 {
   "id": 15752,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 5,
   "firman": "(108-6) Tinggikanlah diri-Mu mengatasi langit, ya Allah, dan biarlah kemuliaan-Mu mengatasi seluruh bumi."
 },
 {
   "id": 15753,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 6,
   "firman": "(108-7) Supaya terluput orang-orang yang Kaucintai, selamatkanlah dengan tangan kanan-Mu dan jawablah aku!"
 },
 {
   "id": 15754,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 7,
   "firman": "(108-8) Allah telah berfirman di tempat kudus-Nya: \"Aku hendak beria-ria, Aku hendak membagi-bagikan Sikhem, dan lembah Sukot hendak Kuukur."
 },
 {
   "id": 15755,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 8,
   "firman": "(108-9) Gilead punya-Ku, Manasye punya-Ku, Efraim ialah pelindung kepala-Ku, Yehuda ialah tongkat kerajaan-Ku,"
 },
 {
   "id": 15756,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 9,
   "firman": "(108-10) Moab ialah tempat pembasuhan-Ku, kepada Edom Aku melemparkan kasut-Ku, dan karena Filistea Aku bersorak-sorai.\""
 },
 {
   "id": 15757,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 10,
   "firman": "(108-11) Siapakah yang akan membawa aku ke kota yang berkubu? Siapakah yang menuntun aku ke Edom?"
 },
 {
   "id": 15758,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 11,
   "firman": "(108-12) Bukankah Engkau, ya Allah, yang telah membuang kami, dan yang tidak maju, ya Allah, bersama-sama bala tentara kami?"
 },
 {
   "id": 15759,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 12,
   "firman": "(108-13) Berikanlah kepada kami pertolongan terhadap lawan, sebab sia-sia penyelamatan dari manusia."
 },
 {
   "id": 15760,
   "kitab": "Mzm",
   "pasal": 108,
   "ayat": 13,
   "firman": "(108-14) Dengan Allah akan kita lakukan perbuatan-perbuatan gagah perkasa, sebab Ia sendiri akan menginjak-injak para lawan kita."
 },
 {
   "id": 15761,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. Ya Allah pujianku, janganlah berdiam diri!"
 },
 {
   "id": 15762,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 2,
   "firman": "Sebab mulut orang fasik dan mulut penipu ternganga terhadap aku, mereka berbicara terhadap aku dengan lidah dusta;"
 },
 {
   "id": 15763,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 3,
   "firman": "dengan kata-kata kebencian mereka menyerang aku dan memerangi aku tanpa alasan."
 },
 {
   "id": 15764,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 4,
   "firman": "Sebagai balasan terhadap kasihku mereka menuduh aku, sedang aku mendoakan mereka."
 },
 {
   "id": 15765,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 5,
   "firman": "Mereka membalas kejahatan kepadaku ganti kebaikan dan kebencian ganti kasihku."
 },
 {
   "id": 15766,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 6,
   "firman": "\"Angkatlah seorang fasik atas dia, dan biarlah seorang pendakwa berdiri di sebelah kanannya;"
 },
 {
   "id": 15767,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 7,
   "firman": "apabila dihakimi, biarlah ia keluar sebagai orang bersalah, dan biarlah doanya menjadi dosa."
 },
 {
   "id": 15768,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 8,
   "firman": "Biarlah umurnya berkurang, biarlah jabatannya diambil orang lain."
 },
 {
   "id": 15769,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 9,
   "firman": "Biarlah anak-anaknya menjadi yatim, dan isterinya menjadi janda."
 },
 {
   "id": 15770,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 10,
   "firman": "Biarlah anak-anaknya mengembara tidak keruan dan mengemis, dan dihalau dari reruntuhan rumahnya."
 },
 {
   "id": 15771,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 11,
   "firman": "Biarlah penagih hutang menyita segala kepunyaannya, dan orang-orang lain menjarah hasil jerih payahnya."
 },
 {
   "id": 15772,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 12,
   "firman": "Janganlah ada orang yang tetap menunjukkan kasihnya kepadanya, dan janganlah ada orang yang sayang kepada anak-anaknya yang menjadi yatim."
 },
 {
   "id": 15773,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 13,
   "firman": "Biarlah dilenyapkan keturunannya, dan dihapuskan namanya dalam angkatan yang kemudian."
 },
 {
   "id": 15774,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 14,
   "firman": "Biarlah kesalahan nenek moyangnya diingat-ingat di hadapan TUHAN, dan janganlah dihapuskan dosa ibunya."
 },
 {
   "id": 15775,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 15,
   "firman": "Biarlah itu selalu diperhatikan TUHAN, supaya ingatan kepada mereka dilenyapkan dari bumi."
 },
 {
   "id": 15776,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 16,
   "firman": "Oleh karena ia tidak ingat menunjukkan kasih, tetapi mengejar orang sengsara dan miskin dan orang yang hancur hati sampai mereka mati."
 },
 {
   "id": 15777,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 17,
   "firman": "Ia cinta kepada kutuk--biarlah itu datang kepadanya; ia tidak suka kepada berkat--biarlah itu menjauh dari padanya."
 },
 {
   "id": 15778,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 18,
   "firman": "Ia memakai kutuk sebagai bajunya--biarlah itu merembes seperti air ke dalam dirinya, dan seperti minyak ke dalam tulang-tulangnya;"
 },
 {
   "id": 15779,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 19,
   "firman": "biarlah itu baginya seperti pakaian yang dikenakannya, sebagai ikat pinggang yang senantiasa dipakainya."
 },
 {
   "id": 15780,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 20,
   "firman": "Biarlah semuanya itu dari pihak TUHAN menjadi upah orang yang mendakwa aku, dan upah orang-orang yang berkata-kata jahat terhadap aku.\""
 },
 {
   "id": 15781,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 21,
   "firman": "Tetapi Engkau, ya ALLAH, Tuhanku, bertindaklah kepadaku oleh karena nama-Mu, lepaskanlah aku oleh sebab kasih setia-Mu yang baik!"
 },
 {
   "id": 15782,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 22,
   "firman": "Sebab sengsara dan miskin aku, dan hatiku terluka dalam diriku;"
 },
 {
   "id": 15783,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 23,
   "firman": "aku menghilang seperti bayang-bayang pada waktu memanjang, aku dikebutkan seperti belalang."
 },
 {
   "id": 15784,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 24,
   "firman": "Lututku melentuk oleh sebab berpuasa, dan badanku menjadi kurus, habis lemaknya."
 },
 {
   "id": 15785,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 25,
   "firman": "Aku telah menjadi cela bagi mereka; melihat aku, mereka menggelengkan kepalanya."
 },
 {
   "id": 15786,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 26,
   "firman": "Tolonglah aku, ya TUHAN, Allahku, selamatkanlah aku sesuai dengan kasih setia-Mu,"
 },
 {
   "id": 15787,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 27,
   "firman": "supaya mereka tahu, bahwa tangan-Mulah ini, bahwa Engkaulah, ya TUHAN, yang telah melakukannya."
 },
 {
   "id": 15788,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 28,
   "firman": "Biar mereka mengutuk, Engkau akan memberkati; biarlah lawan-lawanku mendapat malu, tetapi hamba-Mu ini kiranya bersukacita."
 },
 {
   "id": 15789,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 29,
   "firman": "Biarlah orang-orang yang mendakwa aku berpakaikan noda, dan berselimutkan malunya sebagai jubah."
 },
 {
   "id": 15790,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 30,
   "firman": "Aku hendak bersyukur sangat kepada TUHAN dengan mulutku, dan aku hendak memuji-muji Dia di tengah-tengah orang banyak."
 },
 {
   "id": 15791,
   "kitab": "Mzm",
   "pasal": 109,
   "ayat": 31,
   "firman": "Sebab Ia berdiri di sebelah kanan orang miskin untuk menyelamatkannya dari orang-orang yang menghukumnya."
 },
 {
   "id": 15792,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 1,
   "firman": "Mazmur Daud. Demikianlah firman TUHAN kepada tuanku: \"Duduklah di sebelah kanan-Ku, sampai Kubuat musuh-musuhmu menjadi tumpuan kakimu.\""
 },
 {
   "id": 15793,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 2,
   "firman": "Tongkat kekuatanmu akan diulurkan TUHAN dari Sion: memerintahlah di antara musuhmu!"
 },
 {
   "id": 15794,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 3,
   "firman": "Pada hari tentaramu bangsamu merelakan diri untuk maju dengan berhiaskan kekudusan; dari kandungan fajar tampil bagimu keremajaanmu seperti embun."
 },
 {
   "id": 15795,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 4,
   "firman": "TUHAN telah bersumpah, dan Ia tidak akan menyesal: \"Engkau adalah imam untuk selama-lamanya, menurut Melkisedek.\""
 },
 {
   "id": 15796,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 5,
   "firman": "TUHAN ada di sebelah kananmu; Ia meremukkan raja-raja pada hari murka-Nya,"
 },
 {
   "id": 15797,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 6,
   "firman": "Ia menghukum bangsa-bangsa, sehingga mayat-mayat bergelimpangan; Ia meremukkan orang-orang yang menjadi kepala di negeri luas."
 },
 {
   "id": 15798,
   "kitab": "Mzm",
   "pasal": 110,
   "ayat": 7,
   "firman": "Dari sungai di tepi jalan ia minum, oleh sebab itu ia mengangkat kepala."
 },
 {
   "id": 15799,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 1,
   "firman": "Haleluya! Aku mau bersyukur kepada TUHAN dengan segenap hati, dalam lingkungan orang-orang benar dan dalam jemaah."
 },
 {
   "id": 15800,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 2,
   "firman": "Besar perbuatan-perbuatan TUHAN, layak diselidiki oleh semua orang yang menyukainya."
 },
 {
   "id": 15801,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 3,
   "firman": "Agung dan bersemarak pekerjaan-Nya, dan keadilan-Nya tetap untuk selamanya."
 },
 {
   "id": 15802,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 4,
   "firman": "Perbuatan-perbuatan-Nya yang ajaib dijadikan-Nya peringatan; TUHAN itu pengasih dan penyayang."
 },
 {
   "id": 15803,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 5,
   "firman": "Diberikan-Nya rezeki kepada orang-orang yang takut akan Dia. Ia ingat untuk selama-lamanya akan perjanjian-Nya."
 },
 {
   "id": 15804,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 6,
   "firman": "Kekuatan perbuatan-Nya diberitakan-Nya kepada umat-Nya, dengan memberikan kepada mereka milik pusaka bangsa-bangsa."
 },
 {
   "id": 15805,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 7,
   "firman": "Perbuatan tangan-Nya ialah kebenaran dan keadilan, segala titah-Nya teguh,"
 },
 {
   "id": 15806,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 8,
   "firman": "kokoh untuk seterusnya dan selamanya, dilakukan dalam kebenaran dan kejujuran."
 },
 {
   "id": 15807,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 9,
   "firman": "Dikirim-Nya kebebasan kepada umat-Nya, diperintahkan-Nya supaya perjanjian-Nya itu untuk selama-lamanya; nama-Nya kudus dan dahsyat."
 },
 {
   "id": 15808,
   "kitab": "Mzm",
   "pasal": 111,
   "ayat": 10,
   "firman": "Permulaan hikmat adalah takut akan TUHAN, semua orang yang melakukannya berakal budi yang baik. Puji-pujian kepada-Nya tetap untuk selamanya."
 },
 {
   "id": 15809,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 1,
   "firman": "Haleluya! Berbahagialah orang yang takut akan TUHAN, yang sangat suka kepada segala perintah-Nya."
 },
 {
   "id": 15810,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 2,
   "firman": "Anak cucunya akan perkasa di bumi; angkatan orang benar akan diberkati."
 },
 {
   "id": 15811,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 3,
   "firman": "Harta dan kekayaan ada dalam rumahnya, kebajikannya tetap untuk selamanya."
 },
 {
   "id": 15812,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 4,
   "firman": "Di dalam gelap terbit terang bagi orang benar; pengasih dan penyayang orang yang adil."
 },
 {
   "id": 15813,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 5,
   "firman": "Mujur orang yang menaruh belas kasihan dan yang memberi pinjaman, yang melakukan urusannya dengan sewajarnya."
 },
 {
   "id": 15814,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 6,
   "firman": "Sebab ia takkan goyah untuk selama-lamanya; orang benar itu akan diingat selama-lamanya."
 },
 {
   "id": 15815,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 7,
   "firman": "Ia tidak takut kepada kabar celaka, hatinya tetap, penuh kepercayaan kepada TUHAN."
 },
 {
   "id": 15816,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 8,
   "firman": "Hatinya teguh, ia tidak takut, sehingga ia memandang rendah para lawannya."
 },
 {
   "id": 15817,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 9,
   "firman": "Ia membagi-bagikan, ia memberikan kepada orang miskin; kebajikannya tetap untuk selama-lamanya, tanduknya meninggi dalam kemuliaan."
 },
 {
   "id": 15818,
   "kitab": "Mzm",
   "pasal": 112,
   "ayat": 10,
   "firman": "Orang fasik melihatnya, lalu sakit hati, ia menggertakkan giginya, lalu hancur; keinginan orang fasik akan menuju kebinasaan."
 },
 {
   "id": 15819,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 1,
   "firman": "Haleluya! Pujilah, hai hamba-hamba TUHAN, pujilah nama TUHAN!"
 },
 {
   "id": 15820,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 2,
   "firman": "Kiranya nama TUHAN dimasyhurkan, sekarang ini dan selama-lamanya."
 },
 {
   "id": 15821,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 3,
   "firman": "Dari terbitnya sampai kepada terbenamnya matahari terpujilah nama TUHAN."
 },
 {
   "id": 15822,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 4,
   "firman": "TUHAN tinggi mengatasi segala bangsa, kemuliaan-Nya mengatasi langit."
 },
 {
   "id": 15823,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 5,
   "firman": "Siapakah seperti TUHAN, Allah kita, yang diam di tempat yang tinggi,"
 },
 {
   "id": 15824,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 6,
   "firman": "yang merendahkan diri untuk melihat ke langit dan ke bumi?"
 },
 {
   "id": 15825,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 7,
   "firman": "Ia menegakkan orang yang hina dari dalam debu dan mengangkat orang yang miskin dari lumpur,"
 },
 {
   "id": 15826,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 8,
   "firman": "untuk mendudukkan dia bersama-sama dengan para bangsawan, bersama-sama dengan para bangsawan bangsanya."
 },
 {
   "id": 15827,
   "kitab": "Mzm",
   "pasal": 113,
   "ayat": 9,
   "firman": "Ia mendudukkan perempuan yang mandul di rumah sebagai ibu anak-anak, penuh sukacita. Haleluya!"
 },
 {
   "id": 15828,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 1,
   "firman": "Pada waktu Israel keluar dari Mesir, kaum keturunan Yakub dari bangsa yang asing bahasanya,"
 },
 {
   "id": 15829,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 2,
   "firman": "maka Yehuda menjadi tempat kudus-Nya, Israel wilayah kekuasaan-Nya."
 },
 {
   "id": 15830,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 3,
   "firman": "Laut melihatnya, lalu melarikan diri, sungai Yordan berbalik ke hulu."
 },
 {
   "id": 15831,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 4,
   "firman": "Gunung-gunung melompat-lompat seperti domba jantan, dan bukit-bukit seperti anak domba."
 },
 {
   "id": 15832,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 5,
   "firman": "Ada apa, hai laut, sehingga engkau melarikan diri, hai sungai Yordan, sehingga engkau berbalik ke hulu,"
 },
 {
   "id": 15833,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 6,
   "firman": "hai gunung-gunung, sehingga kamu melompat-lompat seperti domba jantan, hai bukit-bukit, sehingga kamu seperti anak domba?"
 },
 {
   "id": 15834,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 7,
   "firman": "Gemetarlah, hai bumi, di hadapan TUHAN, di hadapan Allah Yakub,"
 },
 {
   "id": 15835,
   "kitab": "Mzm",
   "pasal": 114,
   "ayat": 8,
   "firman": "yang mengubah gunung batu menjadi kolam air, dan batu yang keras menjadi mata air!"
 },
 {
   "id": 15836,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 1,
   "firman": "Bukan kepada kami, ya TUHAN, bukan kepada kami, tetapi kepada nama-Mulah beri kemuliaan, oleh karena kasih-Mu, oleh karena setia-Mu!"
 },
 {
   "id": 15837,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 2,
   "firman": "Mengapa bangsa-bangsa akan berkata: \"Di mana Allah mereka?\""
 },
 {
   "id": 15838,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 3,
   "firman": "Allah kita di sorga; Ia melakukan apa yang dikehendaki-Nya!"
 },
 {
   "id": 15839,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 4,
   "firman": "Berhala-berhala mereka adalah perak dan emas, buatan tangan manusia,"
 },
 {
   "id": 15840,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 5,
   "firman": "mempunyai mulut, tetapi tidak dapat berkata-kata, mempunyai mata, tetapi tidak dapat melihat,"
 },
 {
   "id": 15841,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 6,
   "firman": "mempunyai telinga, tetapi tidak dapat mendengar, mempunyai hidung, tetapi tidak dapat mencium,"
 },
 {
   "id": 15842,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 7,
   "firman": "mempunyai tangan, tetapi tidak dapat meraba-raba, mempunyai kaki, tetapi tidak dapat berjalan, dan tidak dapat memberi suara dengan kerongkongannya."
 },
 {
   "id": 15843,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 8,
   "firman": "Seperti itulah jadinya orang-orang yang membuatnya, dan semua orang yang percaya kepadanya."
 },
 {
   "id": 15844,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 9,
   "firman": "Hai Israel, percayalah kepada TUHAN! --Dialah pertolongan mereka dan perisai mereka."
 },
 {
   "id": 15845,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 10,
   "firman": "Hai kaum Harun, percayalah kepada TUHAN! --Dialah pertolongan mereka dan perisai mereka."
 },
 {
   "id": 15846,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 11,
   "firman": "Hai orang-orang yang takut akan TUHAN, percayalah kepada TUHAN! --Dialah pertolongan mereka dan perisai mereka."
 },
 {
   "id": 15847,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 12,
   "firman": "TUHAN telah mengingat kita; Ia akan memberkati, memberkati kaum Israel, memberkati kaum Harun,"
 },
 {
   "id": 15848,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 13,
   "firman": "memberkati orang-orang yang takut akan TUHAN, baik yang kecil maupun yang besar."
 },
 {
   "id": 15849,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 14,
   "firman": "Kiranya TUHAN memberi pertambahan kepada kamu, kepada kamu dan kepada anak-anakmu."
 },
 {
   "id": 15850,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 15,
   "firman": "Diberkatilah kamu oleh TUHAN, yang menjadikan langit dan bumi."
 },
 {
   "id": 15851,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 16,
   "firman": "Langit itu langit kepunyaan TUHAN, dan bumi itu telah diberikan-Nya kepada anak-anak manusia."
 },
 {
   "id": 15852,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 17,
   "firman": "Bukan orang-orang mati akan memuji-muji TUHAN, dan bukan semua orang yang turun ke tempat sunyi,"
 },
 {
   "id": 15853,
   "kitab": "Mzm",
   "pasal": 115,
   "ayat": 18,
   "firman": "tetapi kita, kita akan memuji TUHAN, sekarang ini dan sampai selama-lamanya. Haleluya!"
 },
 {
   "id": 15854,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 1,
   "firman": "Aku mengasihi TUHAN, sebab Ia mendengarkan suaraku dan permohonanku."
 },
 {
   "id": 15855,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 2,
   "firman": "Sebab Ia menyendengkan telinga-Nya kepadaku, maka seumur hidupku aku akan berseru kepada-Nya."
 },
 {
   "id": 15856,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 3,
   "firman": "Tali-tali maut telah meliliti aku, dan kegentaran terhadap dunia orang mati menimpa aku, aku mengalami kesesakan dan kedukaan."
 },
 {
   "id": 15857,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 4,
   "firman": "Tetapi aku menyerukan nama TUHAN: \"Ya TUHAN, luputkanlah kiranya aku!\""
 },
 {
   "id": 15858,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 5,
   "firman": "TUHAN adalah pengasih dan adil, Allah kita penyayang."
 },
 {
   "id": 15859,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 6,
   "firman": "TUHAN memelihara orang-orang sederhana; aku sudah lemah, tetapi diselamatkan-Nya aku."
 },
 {
   "id": 15860,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 7,
   "firman": "Kembalilah tenang, hai jiwaku, sebab TUHAN telah berbuat baik kepadamu."
 },
 {
   "id": 15861,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 8,
   "firman": "Ya, Engkau telah meluputkan aku dari pada maut, dan mataku dari pada air mata, dan kakiku dari pada tersandung."
 },
 {
   "id": 15862,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 9,
   "firman": "Aku boleh berjalan di hadapan TUHAN, di negeri orang-orang hidup."
 },
 {
   "id": 15863,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 10,
   "firman": "Aku percaya, sekalipun aku berkata: \"Aku ini sangat tertindas.\""
 },
 {
   "id": 15864,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 11,
   "firman": "Aku ini berkata dalam kebingunganku: \"Semua manusia pembohong.\""
 },
 {
   "id": 15865,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 12,
   "firman": "Bagaimana akan kubalas kepada TUHAN segala kebajikan-Nya kepadaku?"
 },
 {
   "id": 15866,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 13,
   "firman": "Aku akan mengangkat piala keselamatan, dan akan menyerukan nama TUHAN,"
 },
 {
   "id": 15867,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 14,
   "firman": "akan membayar nazarku kepada TUHAN di depan seluruh umat-Nya."
 },
 {
   "id": 15868,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 15,
   "firman": "Berharga di mata TUHAN kematian semua orang yang dikasihi-Nya."
 },
 {
   "id": 15869,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 16,
   "firman": "Ya TUHAN, aku hamba-Mu! Aku hamba-Mu, anak dari hamba-Mu perempuan! Engkau telah membuka ikatan-ikatanku!"
 },
 {
   "id": 15870,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 17,
   "firman": "Aku akan mempersembahkan korban syukur kepada-Mu, dan akan menyerukan nama TUHAN,"
 },
 {
   "id": 15871,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 18,
   "firman": "akan membayar nazarku kepada TUHAN di depan seluruh umat-Nya,"
 },
 {
   "id": 15872,
   "kitab": "Mzm",
   "pasal": 116,
   "ayat": 19,
   "firman": "di pelataran rumah TUHAN, di tengah-tengahmu, ya Yerusalem! Haleluya!"
 },
 {
   "id": 15873,
   "kitab": "Mzm",
   "pasal": 117,
   "ayat": 1,
   "firman": "Pujilah TUHAN, hai segala bangsa, megahkanlah Dia, hai segala suku bangsa!"
 },
 {
   "id": 15874,
   "kitab": "Mzm",
   "pasal": 117,
   "ayat": 2,
   "firman": "Sebab kasih-Nya hebat atas kita, dan kesetiaan TUHAN untuk selama-lamanya. Haleluya!"
 },
 {
   "id": 15875,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 1,
   "firman": "Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 15876,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 2,
   "firman": "Biarlah Israel berkata: \"Bahwasanya untuk selama-lamanya kasih setia-Nya!\""
 },
 {
   "id": 15877,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 3,
   "firman": "Biarlah kaum Harun berkata: \"Bahwasanya untuk selama-lamanya kasih setia-Nya!\""
 },
 {
   "id": 15878,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 4,
   "firman": "Biarlah orang yang takut akan TUHAN berkata: \"Bahwasanya untuk selama-lamanya kasih setia-Nya!\""
 },
 {
   "id": 15879,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 5,
   "firman": "Dalam kesesakan aku telah berseru kepada TUHAN. TUHAN telah menjawab aku dengan memberi kelegaan."
 },
 {
   "id": 15880,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 6,
   "firman": "TUHAN di pihakku. Aku tidak akan takut. Apakah yang dapat dilakukan manusia terhadap aku?"
 },
 {
   "id": 15881,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 7,
   "firman": "TUHAN di pihakku, menolong aku; aku akan memandang rendah mereka yang membenci aku."
 },
 {
   "id": 15882,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 8,
   "firman": "Lebih baik berlindung pada TUHAN dari pada percaya kepada manusia."
 },
 {
   "id": 15883,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 9,
   "firman": "Lebih baik berlindung pada TUHAN dari pada percaya kepada para bangsawan."
 },
 {
   "id": 15884,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 10,
   "firman": "Segala bangsa mengelilingi aku--demi nama TUHAN, sesungguhnya aku pukul mereka mundur."
 },
 {
   "id": 15885,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 11,
   "firman": "Mereka mengelilingi aku, ya mengelilingi aku--demi nama TUHAN, sesungguhnya aku pukul mereka mundur."
 },
 {
   "id": 15886,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 12,
   "firman": "Mereka mengelilingi aku seperti lebah, mereka menyala-nyala seperti api duri, --demi nama TUHAN, sesungguhnya aku pukul mereka mundur."
 },
 {
   "id": 15887,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 13,
   "firman": "Aku ditolak dengan hebat sampai jatuh, tetapi TUHAN menolong aku."
 },
 {
   "id": 15888,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 14,
   "firman": "TUHAN itu kekuatanku dan mazmurku; Ia telah menjadi keselamatanku."
 },
 {
   "id": 15889,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 15,
   "firman": "Suara sorak-sorai dan kemenangan di kemah orang-orang benar: \"Tangan kanan TUHAN melakukan keperkasaan,"
 },
 {
   "id": 15890,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 16,
   "firman": "tangan kanan TUHAN berkuasa meninggikan, tangan kanan TUHAN melakukan keperkasaan!\""
 },
 {
   "id": 15891,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 17,
   "firman": "Aku tidak akan mati, tetapi hidup, dan aku akan menceritakan perbuatan-perbuatan TUHAN."
 },
 {
   "id": 15892,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 18,
   "firman": "TUHAN telah menghajar aku dengan keras, tetapi Ia tidak menyerahkan aku kepada maut."
 },
 {
   "id": 15893,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 19,
   "firman": "Bukakanlah aku pintu gerbang kebenaran, aku hendak masuk ke dalamnya, hendak mengucap syukur kepada TUHAN."
 },
 {
   "id": 15894,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 20,
   "firman": "Inilah pintu gerbang TUHAN, orang-orang benar akan masuk ke dalamnya."
 },
 {
   "id": 15895,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 21,
   "firman": "Aku bersyukur kepada-Mu, sebab Engkau telah menjawab aku dan telah menjadi keselamatanku."
 },
 {
   "id": 15896,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 22,
   "firman": "Batu yang dibuang oleh tukang-tukang bangunan telah menjadi batu penjuru."
 },
 {
   "id": 15897,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 23,
   "firman": "Hal itu terjadi dari pihak TUHAN, suatu perbuatan ajaib di mata kita."
 },
 {
   "id": 15898,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 24,
   "firman": "Inilah hari yang dijadikan TUHAN, marilah kita bersorak-sorak dan bersukacita karenanya!"
 },
 {
   "id": 15899,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 25,
   "firman": "Ya TUHAN, berilah kiranya keselamatan! Ya TUHAN, berilah kiranya kemujuran!"
 },
 {
   "id": 15900,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 26,
   "firman": "Diberkatilah dia yang datang dalam nama TUHAN! Kami memberkati kamu dari dalam rumah TUHAN."
 },
 {
   "id": 15901,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 27,
   "firman": "Tuhanlah Allah, Dia menerangi kita. Ikatkanlah korban hari raya itu dengan tali, pada tanduk-tanduk mezbah."
 },
 {
   "id": 15902,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 28,
   "firman": "Allahku Engkau, aku hendak bersyukur kepada-Mu, Allahku, aku hendak meninggikan Engkau."
 },
 {
   "id": 15903,
   "kitab": "Mzm",
   "pasal": 118,
   "ayat": 29,
   "firman": "Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 15904,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 1,
   "firman": "Berbahagialah orang-orang yang hidupnya tidak bercela, yang hidup menurut Taurat TUHAN."
 },
 {
   "id": 15905,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 2,
   "firman": "Berbahagialah orang-orang yang memegang peringatan-peringatan-Nya, yang mencari Dia dengan segenap hati,"
 },
 {
   "id": 15906,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 3,
   "firman": "yang juga tidak melakukan kejahatan, tetapi yang hidup menurut jalan-jalan yang ditunjukkan-Nya."
 },
 {
   "id": 15907,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 4,
   "firman": "Engkau sendiri telah menyampaikan titah-titah-Mu, supaya dipegang dengan sungguh-sungguh."
 },
 {
   "id": 15908,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 5,
   "firman": "Sekiranya hidupku tentu untuk berpegang pada ketetapan-Mu!"
 },
 {
   "id": 15909,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 6,
   "firman": "Maka aku tidak akan mendapat malu, apabila aku mengamat-amati segala perintah-Mu."
 },
 {
   "id": 15910,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 7,
   "firman": "Aku akan bersyukur kepada-Mu dengan hati jujur, apabila aku belajar hukum-hukum-Mu yang adil."
 },
 {
   "id": 15911,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 8,
   "firman": "Aku akan berpegang pada ketetapan-ketetapan-Mu, janganlah tinggalkan aku sama sekali."
 },
 {
   "id": 15912,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 9,
   "firman": "Dengan apakah seorang muda mempertahankan kelakuannya bersih? Dengan menjaganya sesuai dengan firman-Mu."
 },
 {
   "id": 15913,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 10,
   "firman": "Dengan segenap hatiku aku mencari Engkau, janganlah biarkan aku menyimpang dari perintah-perintah-Mu."
 },
 {
   "id": 15914,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 11,
   "firman": "Dalam hatiku aku menyimpan janji-Mu, supaya aku jangan berdosa terhadap Engkau."
 },
 {
   "id": 15915,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 12,
   "firman": "Terpujilah Engkau, ya TUHAN; ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 15916,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 13,
   "firman": "Dengan bibirku aku menceritakan segala hukum yang Kauucapkan."
 },
 {
   "id": 15917,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 14,
   "firman": "Atas petunjuk peringatan-peringatan-Mu aku bergembira, seperti atas segala harta."
 },
 {
   "id": 15918,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 15,
   "firman": "Aku hendak merenungkan titah-titah-Mu dan mengamat-amati jalan-jalan-Mu."
 },
 {
   "id": 15919,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 16,
   "firman": "Aku akan bergemar dalam ketetapan-ketetapan-Mu; firman-Mu tidak akan kulupakan."
 },
 {
   "id": 15920,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 17,
   "firman": "Lakukanlah kebajikan kepada hamba-Mu ini, supaya aku hidup, dan aku hendak berpegang pada firman-Mu."
 },
 {
   "id": 15921,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 18,
   "firman": "Singkapkanlah mataku, supaya aku memandang keajaiban-keajaiban dari Taurat-Mu."
 },
 {
   "id": 15922,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 19,
   "firman": "Aku ini orang asing di dunia, janganlah sembunyikan perintah-perintah-Mu terhadap aku."
 },
 {
   "id": 15923,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 20,
   "firman": "Hancur jiwaku karena rindu kepada hukum-hukum-Mu setiap waktu."
 },
 {
   "id": 15924,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 21,
   "firman": "Engkau menghardik orang-orang yang kurang ajar, terkutuklah orang yang menyimpang dari perintah-perintah-Mu."
 },
 {
   "id": 15925,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 22,
   "firman": "Gulingkanlah dari atasku cela dan penghinaan, sebab aku memegang peringatan-peringatan-Mu."
 },
 {
   "id": 15926,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 23,
   "firman": "Sekalipun pemuka-pemuka duduk bersepakat melawan aku, hamba-Mu ini merenungkan ketetapan-ketetapan-Mu."
 },
 {
   "id": 15927,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 24,
   "firman": "Ya, peringatan-peringatan-Mu menjadi kegemaranku, menjadi penasihat-penasihatku."
 },
 {
   "id": 15928,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 25,
   "firman": "Jiwaku melekat kepada debu, hidupkanlah aku sesuai dengan firman-Mu."
 },
 {
   "id": 15929,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 26,
   "firman": "Jalan-jalan hidupku telah aku ceritakan dan Engkau menjawab aku--ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 15930,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 27,
   "firman": "Buatlah aku mengerti petunjuk titah-titah-Mu, supaya aku merenungkan perbuatan-perbuatan-Mu yang ajaib."
 },
 {
   "id": 15931,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 28,
   "firman": "Jiwaku menangis karena duka hati, teguhkanlah aku sesuai dengan firman-Mu."
 },
 {
   "id": 15932,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 29,
   "firman": "Jauhkanlah jalan dusta dari padaku, dan karuniakanlah aku Taurat-Mu."
 },
 {
   "id": 15933,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 30,
   "firman": "Aku telah memilih jalan kebenaran, telah menempatkan hukum-hukum-Mu di hadapanku."
 },
 {
   "id": 15934,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 31,
   "firman": "Aku telah berpaut pada peringatan-peringatan-Mu, ya TUHAN, janganlah membuat aku malu."
 },
 {
   "id": 15935,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 32,
   "firman": "Aku akan mengikuti petunjuk perintah-perintah-Mu, sebab Engkau melapangkan hatiku."
 },
 {
   "id": 15936,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 33,
   "firman": "Perlihatkanlah kepadaku, ya TUHAN, petunjuk ketetapan-ketetapan-Mu, aku hendak memegangnya sampai saat terakhir."
 },
 {
   "id": 15937,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 34,
   "firman": "Buatlah aku mengerti, maka aku akan memegang Taurat-Mu; aku hendak memeliharanya dengan segenap hati."
 },
 {
   "id": 15938,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 35,
   "firman": "Biarlah aku hidup menurut petunjuk perintah-perintah-Mu, sebab aku menyukainya."
 },
 {
   "id": 15939,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 36,
   "firman": "Condongkanlah hatiku kepada peringatan-peringatan-Mu, dan jangan kepada laba."
 },
 {
   "id": 15940,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 37,
   "firman": "Lalukanlah mataku dari pada melihat hal yang hampa, hidupkanlah aku dengan jalan-jalan yang Kautunjukkan!"
 },
 {
   "id": 15941,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 38,
   "firman": "Teguhkanlah pada hamba-Mu ini janji-Mu, yang berlaku bagi orang yang takut kepada-Mu."
 },
 {
   "id": 15942,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 39,
   "firman": "Lalukanlah celaku yang menggetarkan aku, karena hukum-hukum-Mu adalah baik."
 },
 {
   "id": 15943,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 40,
   "firman": "Sesungguhnya aku rindu kepada titah-titah-Mu, hidupkanlah aku dengan keadilan-Mu!"
 },
 {
   "id": 15944,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 41,
   "firman": "Kiranya kasih setia-Mu mendatangi aku, ya TUHAN, keselamatan dari pada-Mu itu sesuai dengan janji-Mu,"
 },
 {
   "id": 15945,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 42,
   "firman": "supaya aku dapat memberi jawab kepada orang yang mencela aku, sebab aku percaya kepada firman-Mu."
 },
 {
   "id": 15946,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 43,
   "firman": "Janganlah sekali-kali mencabut firman kebenaran dari mulutku, sebab aku berharap kepada hukum-hukum-Mu."
 },
 {
   "id": 15947,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 44,
   "firman": "Aku hendak berpegang pada Taurat-Mu senantiasa, untuk seterusnya dan selamanya."
 },
 {
   "id": 15948,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 45,
   "firman": "Aku hendak hidup dalam kelegaan, sebab aku mencari titah-titah-Mu."
 },
 {
   "id": 15949,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 46,
   "firman": "Aku hendak berbicara tentang peringatan-peringatan-Mu di hadapan raja-raja, dan aku tidak akan mendapat malu."
 },
 {
   "id": 15950,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 47,
   "firman": "Aku hendak bergemar dalam perintah-perintah-Mu yang kucintai itu."
 },
 {
   "id": 15951,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 48,
   "firman": "Aku menaikkan tanganku kepada perintah-perintah-Mu yang kucintai, dan aku hendak merenungkan ketetapan-ketetapan-Mu."
 },
 {
   "id": 15952,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 49,
   "firman": "Ingatlah firman yang Kaukatakan kepada hamba-Mu, oleh karena Engkau telah membuat aku berharap."
 },
 {
   "id": 15953,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 50,
   "firman": "Inilah penghiburanku dalam sengsaraku, bahwa janji-Mu menghidupkan aku."
 },
 {
   "id": 15954,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 51,
   "firman": "Orang-orang yang kurang ajar sangat mencemoohkan aku, tetapi aku tidak menyimpang dari Taurat-Mu."
 },
 {
   "id": 15955,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 52,
   "firman": "Aku ingat kepada hukum-hukum-Mu yang dari dahulu kala, ya TUHAN, maka terhiburlah aku."
 },
 {
   "id": 15956,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 53,
   "firman": "Aku menjadi gusar terhadap orang-orang fasik, yang meninggalkan Taurat-Mu."
 },
 {
   "id": 15957,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 54,
   "firman": "Ketetapan-ketetapan-Mu adalah nyanyian mazmur bagiku di rumah yang kudiami sebagai orang asing."
 },
 {
   "id": 15958,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 55,
   "firman": "Pada waktu malam aku ingat kepada nama-Mu, ya TUHAN; aku hendak berpegang pada Taurat-Mu."
 },
 {
   "id": 15959,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 56,
   "firman": "Inilah yang kuperoleh, bahwa aku memegang titah-titah-Mu."
 },
 {
   "id": 15960,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 57,
   "firman": "Bagianku ialah TUHAN, aku telah berjanji untuk berpegang pada firman-firman-Mu."
 },
 {
   "id": 15961,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 58,
   "firman": "Aku memohon belas kasihan-Mu dengan segenap hati, kasihanilah aku sesuai dengan janji-Mu."
 },
 {
   "id": 15962,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 59,
   "firman": "Aku memikirkan jalan-jalan hidupku, dan melangkahkan kakiku menuju peringatan-peringatan-Mu."
 },
 {
   "id": 15963,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 60,
   "firman": "Aku bersegera dan tidak berlambat-lambat untuk berpegang pada perintah-perintah-Mu."
 },
 {
   "id": 15964,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 61,
   "firman": "Tali-tali orang-orang fasik membelit aku, tetapi Taurat-Mu tidak kulupakan."
 },
 {
   "id": 15965,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 62,
   "firman": "Tengah malam aku bangun untuk bersyukur kepada-Mu atas hukum-hukum-Mu yang adil."
 },
 {
   "id": 15966,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 63,
   "firman": "Aku bersekutu dengan semua orang yang takut kepada-Mu, dan dengan orang-orang yang berpegang pada titah-titah-Mu."
 },
 {
   "id": 15967,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 64,
   "firman": "Bumi penuh dengan kasih setia-Mu, ya TUHAN, ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 15968,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 65,
   "firman": "Kebajikan telah Kaulakukan kepada hamba-Mu, ya TUHAN, sesuai dengan firman-Mu."
 },
 {
   "id": 15969,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 66,
   "firman": "Ajarkanlah kepadaku kebijaksanaan dan pengetahuan yang baik, sebab aku percaya kepada perintah-perintah-Mu."
 },
 {
   "id": 15970,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 67,
   "firman": "Sebelum aku tertindas, aku menyimpang, tetapi sekarang aku berpegang pada janji-Mu."
 },
 {
   "id": 15971,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 68,
   "firman": "Engkau baik dan berbuat baik; ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 15972,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 69,
   "firman": "Orang yang kurang ajar menodai aku dengan dusta, tetapi aku, dengan segenap hati aku akan memegang titah-titah-Mu."
 },
 {
   "id": 15973,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 70,
   "firman": "Hati mereka tebal seperti lemak, tetapi aku, Taurat-Mu ialah kesukaanku."
 },
 {
   "id": 15974,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 71,
   "firman": "Bahwa aku tertindas itu baik bagiku, supaya aku belajar ketetapan-ketetapan-Mu."
 },
 {
   "id": 15975,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 72,
   "firman": "Taurat yang Kausampaikan adalah baik bagiku, lebih dari pada ribuan keping emas dan perak."
 },
 {
   "id": 15976,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 73,
   "firman": "Tangan-Mu telah menjadikan aku dan membentuk aku, berilah aku pengertian, supaya aku dapat belajar perintah-perintah-Mu."
 },
 {
   "id": 15977,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 74,
   "firman": "Orang-orang yang takut kepada-Mu melihat aku dan bersukacita, sebab aku berharap kepada firman-Mu."
 },
 {
   "id": 15978,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 75,
   "firman": "Aku tahu, ya TUHAN, bahwa hukum-hukum-Mu adil, dan bahwa Engkau telah menindas aku dalam kesetiaan."
 },
 {
   "id": 15979,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 76,
   "firman": "Biarlah kiranya kasih setia-Mu menjadi penghiburanku, sesuai dengan janji yang Kauucapkan kepada hamba-Mu."
 },
 {
   "id": 15980,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 77,
   "firman": "Biarlah rahmat-Mu sampai kepadaku, supaya aku hidup, sebab Taurat-Mu adalah kegemaranku."
 },
 {
   "id": 15981,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 78,
   "firman": "Biarlah orang-orang yang kurang ajar mendapat malu, karena mereka berlaku bengkok terhadap aku tanpa alasan; tetapi aku akan merenungkan titah-titah-Mu."
 },
 {
   "id": 15982,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 79,
   "firman": "Biarlah berbalik kepadaku orang-orang yang takut kepada-Mu, orang-orang yang tahu peringatan-peringatan-Mu."
 },
 {
   "id": 15983,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 80,
   "firman": "Biarlah hatiku tulus dalam ketetapan-ketetapan-Mu, supaya jangan aku mendapat malu."
 },
 {
   "id": 15984,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 81,
   "firman": "Habis jiwaku merindukan keselamatan dari pada-Mu, aku berharap kepada firman-Mu."
 },
 {
   "id": 15985,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 82,
   "firman": "Habis mataku merindukan janji-Mu; aku berkata: \"Bilakah Engkau akan menghiburkan aku?\""
 },
 {
   "id": 15986,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 83,
   "firman": "Sebab aku telah menjadi seperti kirbat yang diasapi; namun ketetapan-ketetapan-Mu tidak kulupakan."
 },
 {
   "id": 15987,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 84,
   "firman": "Berapa lagi hari-hari hamba-Mu ini? Bilakah Engkau menghukum orang-orang yang mengejar aku?"
 },
 {
   "id": 15988,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 85,
   "firman": "Orang-orang yang kurang ajar telah menggali lobang bagiku, orang-orang yang tidak menuruti Taurat-Mu."
 },
 {
   "id": 15989,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 86,
   "firman": "Segala perintah-Mu dapat dipercaya; mereka mengejar aku tanpa alasan--tolonglah aku!"
 },
 {
   "id": 15990,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 87,
   "firman": "Hampir saja mereka menghabisi aku di bumi, tetapi aku tidak meninggalkan titah-titah-Mu."
 },
 {
   "id": 15991,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 88,
   "firman": "Hidupkanlah aku sesuai dengan kasih setia-Mu, supaya aku berpegang pada peringatan yang Kauberikan."
 },
 {
   "id": 15992,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 89,
   "firman": "Untuk selama-lamanya, ya TUHAN, firman-Mu tetap teguh di sorga."
 },
 {
   "id": 15993,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 90,
   "firman": "Kesetiaan-Mu dari keturunan ke keturunan; Engkau menegakkan bumi, sehingga tetap ada."
 },
 {
   "id": 15994,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 91,
   "firman": "Menurut hukum-hukum-Mu semuanya itu ada sekarang, sebab segala sesuatu melayani Engkau."
 },
 {
   "id": 15995,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 92,
   "firman": "Sekiranya Taurat-Mu tidak menjadi kegemaranku, maka aku telah binasa dalam sengsaraku."
 },
 {
   "id": 15996,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 93,
   "firman": "Untuk selama-lamanya aku tidak melupakan titah-titah-Mu, sebab dengan itu Engkau menghidupkan aku."
 },
 {
   "id": 15997,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 94,
   "firman": "Aku kepunyaan-Mu, selamatkanlah aku, sebab aku mencari titah-titah-Mu."
 },
 {
   "id": 15998,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 95,
   "firman": "Orang-orang fasik menantikan aku untuk membinasakan aku; tetapi aku hendak memperhatikan peringatan-peringatan-Mu."
 },
 {
   "id": 15999,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 96,
   "firman": "Aku melihat batas-batas kesempurnaan, tetapi perintah-Mu luas sekali."
 },
 {
   "id": 16000,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 97,
   "firman": "Betapa kucintai Taurat-Mu! Aku merenungkannya sepanjang hari."
 },
 {
   "id": 16001,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 98,
   "firman": "Perintah-Mu membuat aku lebih bijaksana dari pada musuh-musuhku, sebab selama-lamanya itu ada padaku."
 },
 {
   "id": 16002,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 99,
   "firman": "Aku lebih berakal budi dari pada semua pengajarku, sebab peringatan-peringatan-Mu kurenungkan."
 },
 {
   "id": 16003,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 100,
   "firman": "Aku lebih mengerti dari pada orang-orang tua, sebab aku memegang titah-titah-Mu."
 },
 {
   "id": 16004,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 101,
   "firman": "Terhadap segala jalan kejahatan aku menahan kakiku, supaya aku berpegang pada firman-Mu."
 },
 {
   "id": 16005,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 102,
   "firman": "Aku tidak menyimpang dari hukum-hukum-Mu, sebab Engkaulah yang mengajar aku."
 },
 {
   "id": 16006,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 103,
   "firman": "Betapa manisnya janji-Mu itu bagi langit-langitku, lebih dari pada madu bagi mulutku."
 },
 {
   "id": 16007,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 104,
   "firman": "Aku beroleh pengertian dari titah-titah-Mu, itulah sebabnya aku benci segala jalan dusta."
 },
 {
   "id": 16008,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 105,
   "firman": "Firman-Mu itu pelita bagi kakiku dan terang bagi jalanku."
 },
 {
   "id": 16009,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 106,
   "firman": "Aku telah bersumpah dan aku akan menepatinya, untuk berpegang pada hukum-hukum-Mu yang adil."
 },
 {
   "id": 16010,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 107,
   "firman": "Aku sangat tertindas, ya TUHAN, hidupkanlah aku sesuai dengan firman-Mu."
 },
 {
   "id": 16011,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 108,
   "firman": "Kiranya persembahan sukarela yang berupa puji-pujian berkenan kepada-Mu, ya TUHAN, dan ajarkanlah hukum-hukum-Mu kepadaku."
 },
 {
   "id": 16012,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 109,
   "firman": "Aku selalu mempertaruhkan nyawaku, namun Taurat-Mu tidak kulupakan."
 },
 {
   "id": 16013,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 110,
   "firman": "Orang-orang fasik telah memasang jerat terhadap aku, tetapi aku tidak sesat dari titah-titah-Mu."
 },
 {
   "id": 16014,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 111,
   "firman": "Peringatan-peringatan-Mu adalah milik pusakaku untuk selama-lamanya, sebab semuanya itu kegirangan hatiku."
 },
 {
   "id": 16015,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 112,
   "firman": "Telah kucondongkan hatiku untuk melakukan ketetapan-ketetapan-Mu, untuk selama-lamanya, sampai saat terakhir."
 },
 {
   "id": 16016,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 113,
   "firman": "Orang yang bimbang hati kubenci, tetapi Taurat-Mu kucintai."
 },
 {
   "id": 16017,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 114,
   "firman": "Engkaulah persembunyianku dan perisaiku; aku berharap kepada firman-Mu."
 },
 {
   "id": 16018,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 115,
   "firman": "Menjauhlah dari padaku, hai penjahat-penjahat; aku hendak memegang perintah-perintah Allahku."
 },
 {
   "id": 16019,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 116,
   "firman": "Topanglah aku sesuai dengan janji-Mu, supaya aku hidup, dan janganlah membuat aku malu dalam pengharapanku."
 },
 {
   "id": 16020,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 117,
   "firman": "Sokonglah aku, supaya aku selamat; aku hendak bersukacita dalam ketetapan-ketetapan-Mu senantiasa."
 },
 {
   "id": 16021,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 118,
   "firman": "Engkau menolak semua orang yang sesat dari ketetapan-ketetapan-Mu, sebab sia-sia tipu muslihat mereka."
 },
 {
   "id": 16022,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 119,
   "firman": "Sebagai sanga Kauanggap semua orang fasik di bumi; sebab itu aku mencintai peringatan-peringatan-Mu."
 },
 {
   "id": 16023,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 120,
   "firman": "Badanku gemetar karena ketakutan terhadap Engkau, aku takut kepada penghukuman-Mu."
 },
 {
   "id": 16024,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 121,
   "firman": "Aku telah menjalankan hukum dan keadilan; janganlah menyerahkan aku kepada pemeras-pemerasku!"
 },
 {
   "id": 16025,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 122,
   "firman": "Jadilah jaminan bagi hamba-Mu untuk kebaikan, janganlah orang-orang yang kurang ajar memeras aku."
 },
 {
   "id": 16026,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 123,
   "firman": "Mataku sangat merindukan keselamatan dari pada-Mu dan merindukan janji-Mu yang adil."
 },
 {
   "id": 16027,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 124,
   "firman": "Perlakukanlah hamba-Mu sesuai dengan kasih setia-Mu, dan ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 16028,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 125,
   "firman": "Hamba-Mu aku ini, buatlah aku mengerti, supaya aku tahu peringatan-peringatan-Mu."
 },
 {
   "id": 16029,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 126,
   "firman": "Waktu untuk bertindak telah tiba bagi TUHAN; mereka telah merombak Taurat-Mu."
 },
 {
   "id": 16030,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 127,
   "firman": "Itulah sebabnya aku mencintai perintah-perintah-Mu lebih dari pada emas, bahkan dari pada emas tua."
 },
 {
   "id": 16031,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 128,
   "firman": "Itulah sebabnya aku hidup jujur sesuai dengan segala titah-Mu; segala jalan dusta aku benci."
 },
 {
   "id": 16032,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 129,
   "firman": "Peringatan-peringatan-Mu ajaib, itulah sebabnya jiwaku memegangnya."
 },
 {
   "id": 16033,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 130,
   "firman": "Bila tersingkap, firman-firman-Mu memberi terang, memberi pengertian kepada orang-orang bodoh."
 },
 {
   "id": 16034,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 131,
   "firman": "Mulutku kungangakan dan megap-megap, sebab aku mendambakan perintah-perintah-Mu."
 },
 {
   "id": 16035,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 132,
   "firman": "Berpalinglah kepadaku dan kasihanilah aku, sebagaimana sepatutnya terhadap orang-orang yang mencintai nama-Mu."
 },
 {
   "id": 16036,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 133,
   "firman": "Teguhkanlah langkahku oleh janji-Mu, dan janganlah segala kejahatan berkuasa atasku."
 },
 {
   "id": 16037,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 134,
   "firman": "Bebaskanlah aku dari pada pemerasan manusia, supaya aku berpegang pada titah-titah-Mu."
 },
 {
   "id": 16038,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 135,
   "firman": "Sinarilah hamba-Mu dengan wajah-Mu, dan ajarkanlah ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 16039,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 136,
   "firman": "Air mataku berlinang seperti aliran air, karena orang tidak berpegang pada Taurat-Mu."
 },
 {
   "id": 16040,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 137,
   "firman": "Engkau adil, ya TUHAN, dan hukum-hukum-Mu benar."
 },
 {
   "id": 16041,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 138,
   "firman": "Telah Kauperintahkan peringatan-peringatan-Mu dalam keadilan dan dalam kesetiaan belaka."
 },
 {
   "id": 16042,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 139,
   "firman": "Nyala cintaku menghabiskan aku, sebab para lawanku melupakan segala firman-Mu."
 },
 {
   "id": 16043,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 140,
   "firman": "Janji-Mu sangat teruji, dan hamba-Mu mencintainya."
 },
 {
   "id": 16044,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 141,
   "firman": "Aku ini kecil dan hina, tetapi titah-titah-Mu tidak kulupakan."
 },
 {
   "id": 16045,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 142,
   "firman": "Keadilan-Mu adil untuk selama-lamanya, dan Taurat-Mu benar."
 },
 {
   "id": 16046,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 143,
   "firman": "Aku ditimpa kesesakan dan kesusahan, tetapi perintah-perintah-Mu menjadi kesukaanku."
 },
 {
   "id": 16047,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 144,
   "firman": "Peringatan-peringatan-Mu adil untuk selama-lamanya, buatlah aku mengerti, supaya aku hidup."
 },
 {
   "id": 16048,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 145,
   "firman": "Aku berseru dengan segenap hati; jawablah aku, ya TUHAN! Ketetapan-ketetapan-Mu hendak kupegang."
 },
 {
   "id": 16049,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 146,
   "firman": "Aku berseru kepada-Mu; selamatkanlah aku! Aku hendak berpegang pada peringatan-peringatan-Mu."
 },
 {
   "id": 16050,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 147,
   "firman": "Pagi-pagi buta aku bangun dan berteriak minta tolong; aku berharap kepada firman-Mu."
 },
 {
   "id": 16051,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 148,
   "firman": "Aku bangun mendahului waktu jaga malam untuk merenungkan janji-Mu."
 },
 {
   "id": 16052,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 149,
   "firman": "Dengarlah suaraku sesuai dengan kasih setia-Mu; ya TUHAN, hidupkanlah aku sesuai dengan hukum-Mu."
 },
 {
   "id": 16053,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 150,
   "firman": "Mendekat orang-orang yang mengejar aku dengan maksud jahat, mereka menjauh dari Taurat-Mu."
 },
 {
   "id": 16054,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 151,
   "firman": "Engkau dekat, ya TUHAN, dan segala perintah-Mu adalah benar."
 },
 {
   "id": 16055,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 152,
   "firman": "Sejak dahulu aku tahu dari peringatan-peringatan-Mu, bahwa Engkau telah menetapkannya untuk selama-lamanya."
 },
 {
   "id": 16056,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 153,
   "firman": "Lihatlah sengsaraku dan luputkanlah aku, sebab Taurat-Mu tidak kulupakan."
 },
 {
   "id": 16057,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 154,
   "firman": "Perjuangkanlah perkaraku dan tebuslah aku, hidupkanlah aku sesuai dengan janji-Mu."
 },
 {
   "id": 16058,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 155,
   "firman": "Keselamatan menjauh dari orang-orang fasik, sebab ketetapan-ketetapan-Mu tidaklah mereka cari."
 },
 {
   "id": 16059,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 156,
   "firman": "Rahmat-Mu berlimpah, ya TUHAN, hidupkanlah aku sesuai dengan hukum-hukum-Mu."
 },
 {
   "id": 16060,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 157,
   "firman": "Pengejar dan lawanku banyak, tetapi aku tidak menyimpang dari peringatan-peringatan-Mu."
 },
 {
   "id": 16061,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 158,
   "firman": "Melihat pengkhianat-pengkhianat, aku merasa jemu, karena mereka tidak berpegang pada janji-Mu."
 },
 {
   "id": 16062,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 159,
   "firman": "Lihatlah, betapa aku mencintai titah-titah-Mu! Ya TUHAN, hidupkanlah aku sesuai dengan kasih setia-Mu."
 },
 {
   "id": 16063,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 160,
   "firman": "Dasar firman-Mu adalah kebenaran dan segala hukum-hukum-Mu yang adil adalah untuk selama-lamanya."
 },
 {
   "id": 16064,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 161,
   "firman": "Pembesar-pembesar mengejar aku tanpa alasan, tetapi hanya terhadap firman-Mu hatiku gemetar."
 },
 {
   "id": 16065,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 162,
   "firman": "Aku gembira atas janji-Mu, seperti orang yang mendapat banyak jarahan."
 },
 {
   "id": 16066,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 163,
   "firman": "Aku benci dan merasa jijik terhadap dusta, tetapi Taurat-Mu kucintai."
 },
 {
   "id": 16067,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 164,
   "firman": "Tujuh kali dalam sehari aku memuji-muji Engkau, karena hukum-hukum-Mu yang adil."
 },
 {
   "id": 16068,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 165,
   "firman": "Besarlah ketenteraman pada orang-orang yang mencintai Taurat-Mu, tidak ada batu sandungan bagi mereka."
 },
 {
   "id": 16069,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 166,
   "firman": "Aku menantikan keselamatan dari pada-Mu, ya TUHAN, dan aku melakukan perintah-perintah-Mu."
 },
 {
   "id": 16070,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 167,
   "firman": "Aku berpegang pada peringatan-peringatan-Mu, dan aku amat mencintainya."
 },
 {
   "id": 16071,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 168,
   "firman": "Aku berpegang pada titah-titah-Mu dan peringatan-peringatan-Mu, sebab seluruh hidupku terbuka di hadapan-Mu."
 },
 {
   "id": 16072,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 169,
   "firman": "Biarlah teriakku sampai ke hadapan-Mu, ya TUHAN; berilah aku pengertian sesuai dengan firman-Mu."
 },
 {
   "id": 16073,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 170,
   "firman": "Biarlah permohonanku datang ke hadapan-Mu; lepaskanlah aku sesuai dengan janji-Mu."
 },
 {
   "id": 16074,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 171,
   "firman": "Biarlah bibirku mengucapkan puji-pujian, sebab Engkau mengajarkan ketetapan-ketetapan-Mu kepadaku."
 },
 {
   "id": 16075,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 172,
   "firman": "Biarlah lidahku menyanyikan janji-Mu, sebab segala perintah-Mu benar."
 },
 {
   "id": 16076,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 173,
   "firman": "Biarlah tangan-Mu menjadi penolongku, sebab aku memilih titah-titah-Mu."
 },
 {
   "id": 16077,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 174,
   "firman": "Aku rindu kepada keselamatan dari pada-Mu, ya TUHAN, dan Taurat-Mu menjadi kesukaanku."
 },
 {
   "id": 16078,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 175,
   "firman": "Biarlah jiwaku hidup, supaya memuji-muji Engkau, dan biarlah hukum-hukum-Mu menolong aku."
 },
 {
   "id": 16079,
   "kitab": "Mzm",
   "pasal": 119,
   "ayat": 176,
   "firman": "Aku sesat seperti domba yang hilang, carilah hamba-Mu ini, sebab perintah-perintah-Mu tidak kulupakan."
 },
 {
   "id": 16080,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Dalam kesesakanku aku berseru kepada TUHAN dan Ia menjawab aku:"
 },
 {
   "id": 16081,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 2,
   "firman": "\"Ya TUHAN, lepaskanlah aku dari pada bibir dusta, dari pada lidah penipu.\""
 },
 {
   "id": 16082,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 3,
   "firman": "Apakah yang diberikan kepadamu dan apakah yang ditambahkan kepadamu, hai lidah penipu?"
 },
 {
   "id": 16083,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 4,
   "firman": "Panah-panah yang tajam dari pahlawan dan bara kayu arar."
 },
 {
   "id": 16084,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 5,
   "firman": "Celakalah aku, karena harus tinggal sebagai orang asing di Mesekh, karena harus diam di antara kemah-kemah Kedar!"
 },
 {
   "id": 16085,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 6,
   "firman": "Cukup lama aku tinggal bersama-sama dengan orang-orang yang membenci perdamaian."
 },
 {
   "id": 16086,
   "kitab": "Mzm",
   "pasal": 120,
   "ayat": 7,
   "firman": "Aku ini suka perdamaian, tetapi apabila aku berbicara, maka mereka menghendaki perang."
 },
 {
   "id": 16087,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Aku melayangkan mataku ke gunung-gunung; dari manakah akan datang pertolonganku?"
 },
 {
   "id": 16088,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 2,
   "firman": "Pertolonganku ialah dari TUHAN, yang menjadikan langit dan bumi."
 },
 {
   "id": 16089,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 3,
   "firman": "Ia takkan membiarkan kakimu goyah, Penjagamu tidak akan terlelap."
 },
 {
   "id": 16090,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 4,
   "firman": "Sesungguhnya tidak terlelap dan tidak tertidur Penjaga Israel."
 },
 {
   "id": 16091,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 5,
   "firman": "Tuhanlah Penjagamu, Tuhanlah naunganmu di sebelah tangan kananmu."
 },
 {
   "id": 16092,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 6,
   "firman": "Matahari tidak menyakiti engkau pada waktu siang, atau bulan pada waktu malam."
 },
 {
   "id": 16093,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 7,
   "firman": "TUHAN akan menjaga engkau terhadap segala kecelakaan; Ia akan menjaga nyawamu."
 },
 {
   "id": 16094,
   "kitab": "Mzm",
   "pasal": 121,
   "ayat": 8,
   "firman": "TUHAN akan menjaga keluar masukmu, dari sekarang sampai selama-lamanya."
 },
 {
   "id": 16095,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 1,
   "firman": "Nyanyian ziarah Daud. Aku bersukacita, ketika dikatakan orang kepadaku: \"Mari kita pergi ke rumah TUHAN.\""
 },
 {
   "id": 16096,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 2,
   "firman": "Sekarang kaki kami berdiri di pintu gerbangmu, hai Yerusalem."
 },
 {
   "id": 16097,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 3,
   "firman": "Hai Yerusalem, yang telah didirikan sebagai kota yang bersambung rapat,"
 },
 {
   "id": 16098,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 4,
   "firman": "ke mana suku-suku berziarah, yakni suku-suku TUHAN, untuk bersyukur kepada nama TUHAN sesuai dengan peraturan bagi Israel."
 },
 {
   "id": 16099,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 5,
   "firman": "Sebab di sanalah ditaruh kursi-kursi pengadilan, kursi-kursi milik keluarga raja Daud."
 },
 {
   "id": 16100,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 6,
   "firman": "Berdoalah untuk kesejahteraan Yerusalem: \"Biarlah orang-orang yang mencintaimu mendapat sentosa."
 },
 {
   "id": 16101,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 7,
   "firman": "Biarlah kesejahteraan ada di lingkungan tembokmu, dan sentosa di dalam purimu!\""
 },
 {
   "id": 16102,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 8,
   "firman": "Oleh karena saudara-saudaraku dan teman-temanku aku hendak mengucapkan: \"Semoga kesejahteraan ada di dalammu!\""
 },
 {
   "id": 16103,
   "kitab": "Mzm",
   "pasal": 122,
   "ayat": 9,
   "firman": "Oleh karena rumah TUHAN, Allah kita, aku hendak mencari kebaikan bagimu."
 },
 {
   "id": 16104,
   "kitab": "Mzm",
   "pasal": 123,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Kepada-Mu aku melayangkan mataku, ya Engkau yang bersemayam di sorga."
 },
 {
   "id": 16105,
   "kitab": "Mzm",
   "pasal": 123,
   "ayat": 2,
   "firman": "Lihat, seperti mata para hamba laki-laki memandang kepada tangan tuannya, seperti mata hamba perempuan memandang kepada tangan nyonyanya, demikianlah mata kita memandang kepada TUHAN, Allah kita, sampai Ia mengasihani kita."
 },
 {
   "id": 16106,
   "kitab": "Mzm",
   "pasal": 123,
   "ayat": 3,
   "firman": "Kasihanilah kami, ya TUHAN, kasihanilah kami, sebab kami sudah cukup kenyang dengan penghinaan;"
 },
 {
   "id": 16107,
   "kitab": "Mzm",
   "pasal": 123,
   "ayat": 4,
   "firman": "jiwa kami sudah cukup kenyang dengan olok-olok orang-orang yang merasa aman, dengan penghinaan orang-orang yang sombong."
 },
 {
   "id": 16108,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 1,
   "firman": "Nyanyian ziarah Daud. Jikalau bukan TUHAN yang memihak kepada kita, --biarlah Israel berkata demikian--"
 },
 {
   "id": 16109,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 2,
   "firman": "jikalau bukan TUHAN yang memihak kepada kita, ketika manusia bangkit melawan kita,"
 },
 {
   "id": 16110,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 3,
   "firman": "maka mereka telah menelan kita hidup-hidup, ketika amarah mereka menyala-nyala terhadap kita;"
 },
 {
   "id": 16111,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 4,
   "firman": "maka air telah menghanyutkan kita, dan sungai telah mengalir melingkupi diri kita,"
 },
 {
   "id": 16112,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 5,
   "firman": "maka telah mengalir melingkupi diri kita air yang meluap-luap itu."
 },
 {
   "id": 16113,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 6,
   "firman": "Terpujilah TUHAN yang tidak menyerahkan kita menjadi mangsa bagi gigi mereka!"
 },
 {
   "id": 16114,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 7,
   "firman": "Jiwa kita terluput seperti burung dari jerat penangkap burung; jerat itu telah putus, dan kitapun terluput!"
 },
 {
   "id": 16115,
   "kitab": "Mzm",
   "pasal": 124,
   "ayat": 8,
   "firman": "Pertolongan kita adalah dalam nama TUHAN, yang menjadikan langit dan bumi."
 },
 {
   "id": 16116,
   "kitab": "Mzm",
   "pasal": 125,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Orang-orang yang percaya kepada TUHAN adalah seperti gunung Sion yang tidak goyang, yang tetap untuk selama-lamanya."
 },
 {
   "id": 16117,
   "kitab": "Mzm",
   "pasal": 125,
   "ayat": 2,
   "firman": "Yerusalem, gunung-gunung sekelilingnya; demikianlah TUHAN sekeliling umat-Nya, dari sekarang sampai selama-lamanya."
 },
 {
   "id": 16118,
   "kitab": "Mzm",
   "pasal": 125,
   "ayat": 3,
   "firman": "Tongkat kerajaan orang fasik tidak akan tinggal tetap di atas tanah yang diundikan kepada orang-orang benar, supaya orang-orang benar tidak mengulurkan tangannya kepada kejahatan."
 },
 {
   "id": 16119,
   "kitab": "Mzm",
   "pasal": 125,
   "ayat": 4,
   "firman": "Lakukanlah kebaikan, ya TUHAN, kepada orang-orang baik dan kepada orang-orang yang tulus hati;"
 },
 {
   "id": 16120,
   "kitab": "Mzm",
   "pasal": 125,
   "ayat": 5,
   "firman": "tetapi orang-orang yang menyimpang ke jalan yang berbelit-belit, kiranya TUHAN mengenyahkan mereka bersama-sama orang-orang yang melakukan kejahatan. Damai sejahtera atas Israel!"
 },
 {
   "id": 16121,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Ketika TUHAN memulihkan keadaan Sion, keadaan kita seperti orang-orang yang bermimpi."
 },
 {
   "id": 16122,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 2,
   "firman": "Pada waktu itu mulut kita penuh dengan tertawa, dan lidah kita dengan sorak-sorai. Pada waktu itu berkatalah orang di antara bangsa-bangsa: \"TUHAN telah melakukan perkara besar kepada orang-orang ini!\""
 },
 {
   "id": 16123,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 3,
   "firman": "TUHAN telah melakukan perkara besar kepada kita, maka kita bersukacita."
 },
 {
   "id": 16124,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 4,
   "firman": "Pulihkanlah keadaan kami, ya TUHAN, seperti memulihkan batang air kering di Tanah Negeb!"
 },
 {
   "id": 16125,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 5,
   "firman": "Orang-orang yang menabur dengan mencucurkan air mata, akan menuai dengan bersorak-sorai."
 },
 {
   "id": 16126,
   "kitab": "Mzm",
   "pasal": 126,
   "ayat": 6,
   "firman": "Orang yang berjalan maju dengan menangis sambil menabur benih, pasti pulang dengan sorak-sorai sambil membawa berkas-berkasnya."
 },
 {
   "id": 16127,
   "kitab": "Mzm",
   "pasal": 127,
   "ayat": 1,
   "firman": "Nyanyian ziarah Salomo. Jikalau bukan TUHAN yang membangun rumah, sia-sialah usaha orang yang membangunnya; jikalau bukan TUHAN yang mengawal kota, sia-sialah pengawal berjaga-jaga."
 },
 {
   "id": 16128,
   "kitab": "Mzm",
   "pasal": 127,
   "ayat": 2,
   "firman": "Sia-sialah kamu bangun pagi-pagi dan duduk-duduk sampai jauh malam, dan makan roti yang diperoleh dengan susah payah--sebab Ia memberikannya kepada yang dicintai-Nya pada waktu tidur."
 },
 {
   "id": 16129,
   "kitab": "Mzm",
   "pasal": 127,
   "ayat": 3,
   "firman": "Sesungguhnya, anak-anak lelaki adalah milik pusaka dari pada TUHAN, dan buah kandungan adalah suatu upah."
 },
 {
   "id": 16130,
   "kitab": "Mzm",
   "pasal": 127,
   "ayat": 4,
   "firman": "Seperti anak-anak panah di tangan pahlawan, demikianlah anak-anak pada masa muda."
 },
 {
   "id": 16131,
   "kitab": "Mzm",
   "pasal": 127,
   "ayat": 5,
   "firman": "Berbahagialah orang yang telah membuat penuh tabung panahnya dengan semuanya itu. Ia tidak akan mendapat malu, apabila ia berbicara dengan musuh-musuh di pintu gerbang."
 },
 {
   "id": 16132,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Berbahagialah setiap orang yang takut akan TUHAN, yang hidup menurut jalan yang ditunjukkan-Nya!"
 },
 {
   "id": 16133,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 2,
   "firman": "Apabila engkau memakan hasil jerih payah tanganmu, berbahagialah engkau dan baiklah keadaanmu!"
 },
 {
   "id": 16134,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 3,
   "firman": "Isterimu akan menjadi seperti pohon anggur yang subur di dalam rumahmu; anak-anakmu seperti tunas pohon zaitun sekeliling mejamu!"
 },
 {
   "id": 16135,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 4,
   "firman": "Sesungguhnya demikianlah akan diberkati orang laki-laki yang takut akan TUHAN."
 },
 {
   "id": 16136,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 5,
   "firman": "Kiranya TUHAN memberkati engkau dari Sion, supaya engkau melihat kebahagiaan Yerusalem seumur hidupmu,"
 },
 {
   "id": 16137,
   "kitab": "Mzm",
   "pasal": 128,
   "ayat": 6,
   "firman": "dan melihat anak-anak dari anak-anakmu! Damai sejahtera atas Israel!"
 },
 {
   "id": 16138,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Mereka telah cukup menyesakkan aku sejak masa mudaku--biarlah Israel berkata demikian--"
 },
 {
   "id": 16139,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 2,
   "firman": "mereka telah cukup menyesakkan aku sejak masa mudaku, tetapi mereka tidak dapat mengalahkan aku."
 },
 {
   "id": 16140,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 3,
   "firman": "Di atas punggungku pembajak membajak, membuat panjang alur bajak mereka."
 },
 {
   "id": 16141,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 4,
   "firman": "TUHAN itu adil, Ia memotong tali-tali orang fasik."
 },
 {
   "id": 16142,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 5,
   "firman": "Semua orang yang membenci Sion akan mendapat malu dan akan mundur."
 },
 {
   "id": 16143,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 6,
   "firman": "Mereka seperti rumput di atas sotoh, yang menjadi layu, sebelum dicabut,"
 },
 {
   "id": 16144,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 7,
   "firman": "yang tidak digenggam tangan penyabit, atau dirangkum orang yang mengikat berkas,"
 },
 {
   "id": 16145,
   "kitab": "Mzm",
   "pasal": 129,
   "ayat": 8,
   "firman": "sehingga orang-orang yang lewat tidak berkata: \"Berkat TUHAN atas kamu! Kami memberkati kamu dalam nama TUHAN!\""
 },
 {
   "id": 16146,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Dari jurang yang dalam aku berseru kepada-Mu, ya TUHAN!"
 },
 {
   "id": 16147,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 2,
   "firman": "Tuhan, dengarkanlah suaraku! Biarlah telinga-Mu menaruh perhatian kepada suara permohonanku."
 },
 {
   "id": 16148,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 3,
   "firman": "Jika Engkau, ya TUHAN, mengingat-ingat kesalahan-kesalahan, Tuhan, siapakah yang dapat tahan?"
 },
 {
   "id": 16149,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 4,
   "firman": "Tetapi pada-Mu ada pengampunan, supaya Engkau ditakuti orang."
 },
 {
   "id": 16150,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 5,
   "firman": "Aku menanti-nantikan TUHAN, jiwaku menanti-nanti, dan aku mengharapkan firman-Nya."
 },
 {
   "id": 16151,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 6,
   "firman": "Jiwaku mengharapkan Tuhan lebih dari pada pengawal mengharapkan pagi, lebih dari pada pengawal mengharapkan pagi."
 },
 {
   "id": 16152,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 7,
   "firman": "Berharaplah kepada TUHAN, hai Israel! Sebab pada TUHAN ada kasih setia, dan Ia banyak kali mengadakan pembebasan."
 },
 {
   "id": 16153,
   "kitab": "Mzm",
   "pasal": 130,
   "ayat": 8,
   "firman": "Dialah yang akan membebaskan Israel dari segala kesalahannya."
 },
 {
   "id": 16154,
   "kitab": "Mzm",
   "pasal": 131,
   "ayat": 1,
   "firman": "Nyanyian ziarah Daud. TUHAN, aku tidak tinggi hati, dan tidak memandang dengan sombong; aku tidak mengejar hal-hal yang terlalu besar atau hal-hal yang terlalu ajaib bagiku."
 },
 {
   "id": 16155,
   "kitab": "Mzm",
   "pasal": 131,
   "ayat": 2,
   "firman": "Sesungguhnya, aku telah menenangkan dan mendiamkan jiwaku; seperti anak yang disapih berbaring dekat ibunya, ya, seperti anak yang disapih jiwaku dalam diriku."
 },
 {
   "id": 16156,
   "kitab": "Mzm",
   "pasal": 131,
   "ayat": 3,
   "firman": "Berharaplah kepada TUHAN, hai Israel, dari sekarang sampai selama-lamanya!"
 },
 {
   "id": 16157,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Ingatlah, ya TUHAN, kepada Daud dan segala penderitaannya,"
 },
 {
   "id": 16158,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 2,
   "firman": "bagaimana ia telah bersumpah kepada TUHAN, telah bernazar kepada Yang Mahakuat dari Yakub:"
 },
 {
   "id": 16159,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 3,
   "firman": "\"Sesungguhnya aku tidak akan masuk ke dalam kemah kediamanku, tidak akan berbaring di ranjang petiduranku,"
 },
 {
   "id": 16160,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 4,
   "firman": "sesungguhnya aku tidak akan membiarkan mataku tidur atau membiarkan kelopak mataku terlelap,"
 },
 {
   "id": 16161,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 5,
   "firman": "sampai aku mendapat tempat untuk TUHAN, kediaman untuk Yang Mahakuat dari Yakub.\""
 },
 {
   "id": 16162,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 6,
   "firman": "Memang kita telah mendengar tentang itu di Efrata, telah mendapatnya di padang Yaar."
 },
 {
   "id": 16163,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 7,
   "firman": "\"Mari kita pergi ke kediaman-Nya, sujud menyembah pada tumpuan kaki-Nya.\""
 },
 {
   "id": 16164,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 8,
   "firman": "Bangunlah, ya TUHAN, dan pergilah ke tempat perhentian-Mu, Engkau serta tabut kekuatan-Mu!"
 },
 {
   "id": 16165,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 9,
   "firman": "Biarlah imam-imam-Mu berpakaian kebenaran, dan bersorak-sorai orang-orang yang Kaukasihi!"
 },
 {
   "id": 16166,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 10,
   "firman": "Oleh karena Daud, hamba-Mu, janganlah Engkau menolak orang yang Kauurapi!"
 },
 {
   "id": 16167,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 11,
   "firman": "TUHAN telah menyatakan sumpah setia kepada Daud, Ia tidak akan memungkirinya: \"Seorang anak kandungmu akan Kududukkan di atas takhtamu;"
 },
 {
   "id": 16168,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 12,
   "firman": "jika anak-anakmu berpegang pada perjanjian-Ku, dan pada peraturan-peraturan-Ku yang Kuajarkan kepada mereka, maka anak-anak mereka selama-lamanya akan duduk di atas takhtamu.\""
 },
 {
   "id": 16169,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 13,
   "firman": "Sebab TUHAN telah memilih Sion, mengingininya menjadi tempat kedudukan-Nya:"
 },
 {
   "id": 16170,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 14,
   "firman": "\"Inilah tempat perhentian-Ku selama-lamanya, di sini Aku hendak diam, sebab Aku mengingininya."
 },
 {
   "id": 16171,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 15,
   "firman": "Perbekalannya akan Kuberkati dengan limpahnya, orang-orangnya yang miskin akan Kukenyangkan dengan roti,"
 },
 {
   "id": 16172,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 16,
   "firman": "imam-imamnya akan Kukenakan pakaian keselamatan, dan orang-orangnya yang saleh akan bersorak-sorai dengan girang."
 },
 {
   "id": 16173,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 17,
   "firman": "Di sanalah Aku akan menumbuhkan sebuah tanduk bagi Daud, Aku akan menyediakan sebuah pelita bagi orang yang Kuurapi."
 },
 {
   "id": 16174,
   "kitab": "Mzm",
   "pasal": 132,
   "ayat": 18,
   "firman": "Musuh-musuhnya akan Kukenakan pakaian penuh malu, tetapi di atas kepalanya akan bersemarak mahkotanya.\""
 },
 {
   "id": 16175,
   "kitab": "Mzm",
   "pasal": 133,
   "ayat": 1,
   "firman": "Nyanyian ziarah Daud. Sungguh, alangkah baiknya dan indahnya, apabila saudara-saudara diam bersama dengan rukun!"
 },
 {
   "id": 16176,
   "kitab": "Mzm",
   "pasal": 133,
   "ayat": 2,
   "firman": "Seperti minyak yang baik di atas kepala meleleh ke janggut, yang meleleh ke janggut Harun dan ke leher jubahnya."
 },
 {
   "id": 16177,
   "kitab": "Mzm",
   "pasal": 133,
   "ayat": 3,
   "firman": "Seperti embun gunung Hermon yang turun ke atas gunung-gunung Sion. Sebab ke sanalah TUHAN memerintahkan berkat, kehidupan untuk selama-lamanya."
 },
 {
   "id": 16178,
   "kitab": "Mzm",
   "pasal": 134,
   "ayat": 1,
   "firman": "Nyanyian ziarah. Mari, pujilah TUHAN, hai semua hamba TUHAN, yang datang melayani di rumah TUHAN pada waktu malam."
 },
 {
   "id": 16179,
   "kitab": "Mzm",
   "pasal": 134,
   "ayat": 2,
   "firman": "Angkatlah tanganmu ke tempat kudus dan pujilah TUHAN!"
 },
 {
   "id": 16180,
   "kitab": "Mzm",
   "pasal": 134,
   "ayat": 3,
   "firman": "Kiranya TUHAN yang menjadikan langit dan bumi, memberkati engkau dari Sion."
 },
 {
   "id": 16181,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 1,
   "firman": "Haleluya! Pujilah nama TUHAN, pujilah, hai hamba-hamba TUHAN,"
 },
 {
   "id": 16182,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 2,
   "firman": "hai orang-orang yang datang melayani di rumah TUHAN, di pelataran rumah Allah kita!"
 },
 {
   "id": 16183,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 3,
   "firman": "Pujilah TUHAN, sebab TUHAN itu baik, bermazmurlah bagi nama-Nya, sebab nama itu indah!"
 },
 {
   "id": 16184,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 4,
   "firman": "Sebab TUHAN telah memilih Yakub bagi-Nya, Israel menjadi milik kesayangan-Nya."
 },
 {
   "id": 16185,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 5,
   "firman": "Sesungguhnya aku tahu, bahwa TUHAN itu maha besar dan Tuhan kita itu melebihi segala allah."
 },
 {
   "id": 16186,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 6,
   "firman": "TUHAN melakukan apa yang dikehendaki-Nya, di langit dan di bumi, di laut dan di segenap samudera raya;"
 },
 {
   "id": 16187,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 7,
   "firman": "Ia menaikkan kabut dari ujung bumi, Ia membuat kilat mengikuti hujan, Ia mengeluarkan angin dari dalam perbendaharaan-Nya."
 },
 {
   "id": 16188,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 8,
   "firman": "Dialah yang memukul mati anak-anak sulung Mesir, baik manusia maupun hewan,"
 },
 {
   "id": 16189,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 9,
   "firman": "dan mendatangkan tanda-tanda dan mujizat-mujizat ke tengah-tengahmu, hai Mesir, menentang Firaun dan menentang semua pegawainya."
 },
 {
   "id": 16190,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 10,
   "firman": "Dialah yang memukul kalah banyak bangsa, dan membunuh raja-raja yang kuat:"
 },
 {
   "id": 16191,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 11,
   "firman": "Sihon, raja orang Amori, dan Og, raja negeri Basan, dan segala kerajaan Kanaan,"
 },
 {
   "id": 16192,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 12,
   "firman": "dan memberikan tanah mereka sebagai milik pusaka, milik pusaka kepada Israel, umat-Nya."
 },
 {
   "id": 16193,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 13,
   "firman": "Ya TUHAN, nama-Mu adalah untuk selama-lamanya; ya TUHAN, Engkau diingat turun-temurun."
 },
 {
   "id": 16194,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 14,
   "firman": "Sebab TUHAN akan memberi keadilan kepada umat-Nya, dan akan sayang kepada hamba-hamba-Nya."
 },
 {
   "id": 16195,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 15,
   "firman": "Berhala bangsa-bangsa adalah perak dan emas, buatan tangan manusia,"
 },
 {
   "id": 16196,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 16,
   "firman": "mempunyai mulut, tetapi tidak dapat berkata-kata, mempunyai mata, tetapi tidak dapat melihat,"
 },
 {
   "id": 16197,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 17,
   "firman": "mempunyai telinga, tetapi tidak dapat mendengar, juga nafas tidak ada dalam mulut mereka."
 },
 {
   "id": 16198,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 18,
   "firman": "Seperti itulah jadinya orang-orang yang membuatnya, semua orang yang percaya kepadanya."
 },
 {
   "id": 16199,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 19,
   "firman": "Hai kaum Israel, pujilah TUHAN! Hai kaum Harun, pujilah TUHAN!"
 },
 {
   "id": 16200,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 20,
   "firman": "Hai kaum Lewi, pujilah TUHAN! Hai orang-orang yang takut akan TUHAN, pujilah TUHAN!"
 },
 {
   "id": 16201,
   "kitab": "Mzm",
   "pasal": 135,
   "ayat": 21,
   "firman": "Terpujilah TUHAN dari Sion, Dia yang diam di Yerusalem! Haleluya!"
 },
 {
   "id": 16202,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 1,
   "firman": "Bersyukurlah kepada TUHAN, sebab Ia baik! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16203,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 2,
   "firman": "Bersyukurlah kepada Allah segala allah! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16204,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 3,
   "firman": "Bersyukurlah kepada Tuhan segala tuhan! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16205,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 4,
   "firman": "Kepada Dia yang seorang diri melakukan keajaiban-keajaiban besar! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16206,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 5,
   "firman": "Kepada Dia yang menjadikan langit dengan kebijaksanaan! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16207,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 6,
   "firman": "Kepada Dia yang menghamparkan bumi di atas air! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16208,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 7,
   "firman": "Kepada Dia yang menjadikan benda-benda penerang yang besar; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16209,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 8,
   "firman": "Matahari untuk menguasai siang; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16210,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 9,
   "firman": "Bulan dan bintang-bintang untuk menguasai malam! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16211,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 10,
   "firman": "Kepada Dia yang memukul mati anak-anak sulung Mesir; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16212,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 11,
   "firman": "Dan membawa Israel keluar dari tengah-tengah mereka; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16213,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 12,
   "firman": "Dengan tangan yang kuat dan dengan lengan yang teracung! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16214,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 13,
   "firman": "Kepada Dia yang membelah Laut Teberau menjadi dua belahan; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16215,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 14,
   "firman": "Dan menyeberangkan Israel dari tengah-tengahnya; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16216,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 15,
   "firman": "Dan mencampakkan Firaun dengan tentaranya ke Laut Teberau! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16217,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 16,
   "firman": "Kepada Dia yang memimpin umat-Nya melalui padang gurun! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16218,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 17,
   "firman": "Kepada Dia yang memukul kalah raja-raja yang besar; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16219,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 18,
   "firman": "Dan membunuh raja-raja yang mulia; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16220,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 19,
   "firman": "Sihon, raja orang Amori; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16221,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 20,
   "firman": "Dan Og, raja negeri Basan; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16222,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 21,
   "firman": "Dan memberikan tanah mereka menjadi milik pusaka; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16223,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 22,
   "firman": "Milik pusaka kepada Israel, hamba-Nya! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16224,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 23,
   "firman": "Dia yang mengingat kita dalam kerendahan kita; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16225,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 24,
   "firman": "Dan membebaskan kita dari pada para lawan kita; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16226,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 25,
   "firman": "Dia yang memberikan roti kepada segala makhluk; bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16227,
   "kitab": "Mzm",
   "pasal": 136,
   "ayat": 26,
   "firman": "Bersyukurlah kepada Allah semesta langit! Bahwasanya untuk selama-lamanya kasih setia-Nya."
 },
 {
   "id": 16228,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 1,
   "firman": "Di tepi sungai-sungai Babel, di sanalah kita duduk sambil menangis, apabila kita mengingat Sion."
 },
 {
   "id": 16229,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 2,
   "firman": "Pada pohon-pohon gandarusa di tempat itu kita menggantungkan kecapi kita."
 },
 {
   "id": 16230,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 3,
   "firman": "Sebab di sanalah orang-orang yang menawan kita meminta kepada kita memperdengarkan nyanyian, dan orang-orang yang menyiksa kita meminta nyanyian sukacita: \"Nyanyikanlah bagi kami nyanyian dari Sion!\""
 },
 {
   "id": 16231,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 4,
   "firman": "Bagaimanakah kita menyanyikan nyanyian TUHAN di negeri asing?"
 },
 {
   "id": 16232,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 5,
   "firman": "Jika aku melupakan engkau, hai Yerusalem, biarlah menjadi kering tangan kananku!"
 },
 {
   "id": 16233,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 6,
   "firman": "Biarlah lidahku melekat pada langit-langitku, jika aku tidak mengingat engkau, jika aku tidak jadikan Yerusalem puncak sukacitaku!"
 },
 {
   "id": 16234,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 7,
   "firman": "Ingatlah, ya TUHAN, kepada bani Edom, yang pada hari pemusnahan Yerusalem mengatakan: \"Runtuhkan, runtuhkan sampai ke dasarnya!\""
 },
 {
   "id": 16235,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 8,
   "firman": "Hai puteri Babel, yang suka melakukan kekerasan, berbahagialah orang yang membalas kepadamu perbuatan-perbuatan yang kaulakukan kepada kami!"
 },
 {
   "id": 16236,
   "kitab": "Mzm",
   "pasal": 137,
   "ayat": 9,
   "firman": "Berbahagialah orang yang menangkap dan memecahkan anak-anakmu pada bukit batu!"
 },
 {
   "id": 16237,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 1,
   "firman": "Dari Daud. Aku hendak bersyukur kepada-Mu dengan segenap hatiku, di hadapan para allah aku akan bermazmur bagi-Mu."
 },
 {
   "id": 16238,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 2,
   "firman": "Aku hendak sujud ke arah bait-Mu yang kudus dan memuji nama-Mu, oleh karena kasih-Mu dan oleh karena setia-Mu; sebab Kaubuat nama-Mu dan janji-Mu melebihi segala sesuatu."
 },
 {
   "id": 16239,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 3,
   "firman": "Pada hari aku berseru, Engkaupun menjawab aku, Engkau menambahkan kekuatan dalam jiwaku."
 },
 {
   "id": 16240,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 4,
   "firman": "Semua raja di bumi akan bersyukur kepada-Mu, ya TUHAN, sebab mereka mendengar janji dari mulut-Mu;"
 },
 {
   "id": 16241,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 5,
   "firman": "mereka akan menyanyi tentang jalan-jalan TUHAN, sebab besar kemuliaan TUHAN."
 },
 {
   "id": 16242,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 6,
   "firman": "TUHAN itu tinggi, namun Ia melihat orang yang hina, dan mengenal orang yang sombong dari jauh."
 },
 {
   "id": 16243,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 7,
   "firman": "Jika aku berada dalam kesesakan, Engkau mempertahankan hidupku; terhadap amarah musuhku Engkau mengulurkan tangan-Mu, dan tangan kanan-Mu menyelamatkan aku."
 },
 {
   "id": 16244,
   "kitab": "Mzm",
   "pasal": 138,
   "ayat": 8,
   "firman": "TUHAN akan menyelesaikannya bagiku! Ya TUHAN, kasih setia-Mu untuk selama-lamanya; janganlah Kautinggalkan perbuatan tangan-Mu!"
 },
 {
   "id": 16245,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. TUHAN, Engkau menyelidiki dan mengenal aku;"
 },
 {
   "id": 16246,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 2,
   "firman": "Engkau mengetahui, kalau aku duduk atau berdiri, Engkau mengerti pikiranku dari jauh."
 },
 {
   "id": 16247,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 3,
   "firman": "Engkau memeriksa aku, kalau aku berjalan dan berbaring, segala jalanku Kaumaklumi."
 },
 {
   "id": 16248,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 4,
   "firman": "Sebab sebelum lidahku mengeluarkan perkataan, sesungguhnya, semuanya telah Kauketahui, ya TUHAN."
 },
 {
   "id": 16249,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 5,
   "firman": "Dari belakang dan dari depan Engkau mengurung aku, dan Engkau menaruh tangan-Mu ke atasku."
 },
 {
   "id": 16250,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 6,
   "firman": "Terlalu ajaib bagiku pengetahuan itu, terlalu tinggi, tidak sanggup aku mencapainya."
 },
 {
   "id": 16251,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 7,
   "firman": "Ke mana aku dapat pergi menjauhi roh-Mu, ke mana aku dapat lari dari hadapan-Mu?"
 },
 {
   "id": 16252,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 8,
   "firman": "Jika aku mendaki ke langit, Engkau di sana; jika aku menaruh tempat tidurku di dunia orang mati, di situpun Engkau."
 },
 {
   "id": 16253,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 9,
   "firman": "Jika aku terbang dengan sayap fajar, dan membuat kediaman di ujung laut,"
 },
 {
   "id": 16254,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 10,
   "firman": "juga di sana tangan-Mu akan menuntun aku, dan tangan kanan-Mu memegang aku."
 },
 {
   "id": 16255,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 11,
   "firman": "Jika aku berkata: \"Biarlah kegelapan saja melingkupi aku, dan terang sekelilingku menjadi malam,\""
 },
 {
   "id": 16256,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 12,
   "firman": "maka kegelapanpun tidak menggelapkan bagi-Mu, dan malam menjadi terang seperti siang; kegelapan sama seperti terang."
 },
 {
   "id": 16257,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 13,
   "firman": "Sebab Engkaulah yang membentuk buah pinggangku, menenun aku dalam kandungan ibuku."
 },
 {
   "id": 16258,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 14,
   "firman": "Aku bersyukur kepada-Mu oleh karena kejadianku dahsyat dan ajaib; ajaib apa yang Kaubuat, dan jiwaku benar-benar menyadarinya."
 },
 {
   "id": 16259,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 15,
   "firman": "Tulang-tulangku tidak terlindung bagi-Mu, ketika aku dijadikan di tempat yang tersembunyi, dan aku direkam di bagian-bagian bumi yang paling bawah;"
 },
 {
   "id": 16260,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 16,
   "firman": "mata-Mu melihat selagi aku bakal anak, dan dalam kitab-Mu semuanya tertulis hari-hari yang akan dibentuk, sebelum ada satupun dari padanya."
 },
 {
   "id": 16261,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 17,
   "firman": "Dan bagiku, betapa sulitnya pikiran-Mu, ya Allah! Betapa besar jumlahnya!"
 },
 {
   "id": 16262,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 18,
   "firman": "Jika aku mau menghitungnya, itu lebih banyak dari pada pasir. Apabila aku berhenti, masih saja aku bersama-sama Engkau."
 },
 {
   "id": 16263,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 19,
   "firman": "Sekiranya Engkau mematikan orang fasik, ya Allah, sehingga menjauh dari padaku penumpah-penumpah darah,"
 },
 {
   "id": 16264,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 20,
   "firman": "yang berkata-kata dusta terhadap Engkau, dan melawan Engkau dengan sia-sia."
 },
 {
   "id": 16265,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 21,
   "firman": "Masakan aku tidak membenci orang-orang yang membenci Engkau, ya TUHAN, dan tidak merasa jemu kepada orang-orang yang bangkit melawan Engkau?"
 },
 {
   "id": 16266,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 22,
   "firman": "Aku sama sekali membenci mereka, mereka menjadi musuhku."
 },
 {
   "id": 16267,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 23,
   "firman": "Selidikilah aku, ya Allah, dan kenallah hatiku, ujilah aku dan kenallah pikiran-pikiranku;"
 },
 {
   "id": 16268,
   "kitab": "Mzm",
   "pasal": 139,
   "ayat": 24,
   "firman": "lihatlah, apakah jalanku serong, dan tuntunlah aku di jalan yang kekal!"
 },
 {
   "id": 16269,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 1,
   "firman": "Untuk pemimpin biduan. Mazmur Daud. (140-2) Luputkanlah aku, ya TUHAN, dari pada manusia jahat, jagalah aku terhadap orang yang melakukan kekerasan,"
 },
 {
   "id": 16270,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 2,
   "firman": "(140-3) yang merancang kejahatan di dalam hati, dan setiap hari menghasut-hasut perang!"
 },
 {
   "id": 16271,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 3,
   "firman": "(140-4) Mereka menajamkan lidahnya seperti ular, bisa ular senduk ada di bawah bibirnya. Sela"
 },
 {
   "id": 16272,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 4,
   "firman": "(140-5) Peliharalah aku, ya TUHAN, terhadap tangan orang fasik, jagalah aku terhadap orang yang melakukan kekerasan, yang bermaksud menjatuhkan aku."
 },
 {
   "id": 16273,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 5,
   "firman": "(140-6) Orang congkak dengan sembunyi memasang jerat terhadap aku, dan mereka membentangkan tali-tali sebagai jaring, di sepanjang jalan mereka menaruh perangkap terhadap aku. Sela"
 },
 {
   "id": 16274,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 6,
   "firman": "(140-7) Aku berkata kepada TUHAN: \"Allahku Engkau, berilah telinga, ya TUHAN, kepada suara permohonanku!\""
 },
 {
   "id": 16275,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 7,
   "firman": "(140-8) Ya ALLAH, Tuhanku, kekuatan keselamatanku, Engkau menudungi kepalaku pada hari pertarungan senjata."
 },
 {
   "id": 16276,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 8,
   "firman": "(140-9) Ya TUHAN, jangan penuhi keinginan orang fasik, jangan luluskan tipu rencananya! Sela"
 },
 {
   "id": 16277,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 9,
   "firman": "(140-10) Orang-orang yang mengelilingi aku meninggikan kepala; biarlah bencana yang diucapkan mereka menimpa mereka!"
 },
 {
   "id": 16278,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 10,
   "firman": "(140-11) Biarlah Ia menghujani mereka dengan bara api! Biarlah Ia menjatuhkan mereka ke dalam jurang sehingga tidak bangkit lagi!"
 },
 {
   "id": 16279,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 11,
   "firman": "(140-12) Pemfitnah tidak akan diam tetap di bumi; orang yang melakukan kekerasan akan diburu oleh malapetaka."
 },
 {
   "id": 16280,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 12,
   "firman": "(140-13) Aku tahu, bahwa TUHAN akan memberi keadilan kepada orang tertindas, dan membela perkara orang miskin."
 },
 {
   "id": 16281,
   "kitab": "Mzm",
   "pasal": 140,
   "ayat": 13,
   "firman": "(140-14) Sungguh, orang-orang benar akan memuji nama-Mu, orang-orang yang jujur akan diam di hadapan-Mu."
 },
 {
   "id": 16282,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 1,
   "firman": "Mazmur Daud. Ya TUHAN, aku berseru kepada-Mu, datanglah segera kepadaku, berilah telinga kepada suaraku, waktu aku berseru kepada-Mu!"
 },
 {
   "id": 16283,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 2,
   "firman": "Biarlah doaku adalah bagi-Mu seperti persembahan ukupan, dan tanganku yang terangkat seperti persembahan korban pada waktu petang."
 },
 {
   "id": 16284,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 3,
   "firman": "Awasilah mulutku, ya TUHAN, berjagalah pada pintu bibirku!"
 },
 {
   "id": 16285,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 4,
   "firman": "Jangan condongkan hatiku kepada yang jahat, untuk melakukan perbuatan-perbuatan yang fasik bersama-sama dengan orang-orang yang melakukan kejahatan; dan jangan aku mengecap sedap-sedapan mereka."
 },
 {
   "id": 16286,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 5,
   "firman": "Biarlah orang benar memalu dan menghukum aku, itulah kasih; tetapi janganlah minyak orang fasik menghiasi kepalaku! Sungguh aku terus berdoa menentang kejahatan-kejahatan mereka."
 },
 {
   "id": 16287,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 6,
   "firman": "Apabila mereka diserahkan kepada hakim-hakimnya, maka mereka akan mendengar, bahwa perkataan-perkataanku menyenangkan."
 },
 {
   "id": 16288,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 7,
   "firman": "Seperti batu yang dibelah dan dihancurkan di tanah, demikianlah akan berhamburan tulang-tulang mereka di mulut dunia orang mati."
 },
 {
   "id": 16289,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 8,
   "firman": "Tetapi kepada-Mulah, ya ALLAH, Tuhanku, mataku tertuju; pada-Mulah aku berlindung, jangan campakkan aku!"
 },
 {
   "id": 16290,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 9,
   "firman": "Lindungilah aku terhadap katupan jerat yang mereka pasang terhadap aku, dan dari perangkap orang-orang yang melakukan kejahatan."
 },
 {
   "id": 16291,
   "kitab": "Mzm",
   "pasal": 141,
   "ayat": 10,
   "firman": "Orang-orang fasik akan jatuh serentak ke dalam jala mereka, tetapi aku melangkah lalu."
 },
 {
   "id": 16292,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 1,
   "firman": "Nyanyian pengajaran Daud, ketika ia ada di dalam gua: suatu doa. (142-2) Dengan nyaring aku berseru-seru kepada TUHAN, dengan nyaring aku memohon kepada TUHAN."
 },
 {
   "id": 16293,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 2,
   "firman": "(142-3) Aku mencurahkan keluhanku ke hadapan-Nya, kesesakanku kuberitahukan ke hadapan-Nya."
 },
 {
   "id": 16294,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 3,
   "firman": "(142-4) Ketika semangatku lemah lesu di dalam diriku, Engkaulah yang mengetahui jalanku. Di jalan yang harus kutempuh, dengan sembunyi mereka memasang jerat terhadap aku."
 },
 {
   "id": 16295,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 4,
   "firman": "(142-5) Pandanglah ke kanan dan lihatlah, tidak ada seorangpun yang menghiraukan aku; tempat pelarian bagiku telah hilang, tidak ada seorangpun yang mencari aku."
 },
 {
   "id": 16296,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 5,
   "firman": "(142-6) Aku berseru-seru kepada-Mu, ya TUHAN, kataku: \"Engkaulah tempat perlindunganku, bagianku di negeri orang-orang hidup!\""
 },
 {
   "id": 16297,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 6,
   "firman": "(142-7) Perhatikanlah teriakku, sebab aku telah menjadi sangat lemah. Lepaskanlah aku dari pada orang-orang yang mengejar aku, sebab mereka terlalu kuat bagiku."
 },
 {
   "id": 16298,
   "kitab": "Mzm",
   "pasal": 142,
   "ayat": 7,
   "firman": "(142-8) Keluarkanlah aku dari dalam penjara untuk memuji nama-Mu. Orang-orang benar akan mengelilingi aku, apabila Engkau berbuat baik kepadaku."
 },
 {
   "id": 16299,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 1,
   "firman": "Mazmur Daud. Ya TUHAN, dengarkanlah doaku, berilah telinga kepada permohonanku! Jawablah aku dalam kesetiaan-Mu, demi keadilan-Mu!"
 },
 {
   "id": 16300,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 2,
   "firman": "Janganlah beperkara dengan hamba-Mu ini, sebab di antara yang hidup tidak seorangpun yang benar di hadapan-Mu."
 },
 {
   "id": 16301,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 3,
   "firman": "Sebab musuh telah mengejar aku dan mencampakkan nyawaku ke tanah, menempatkan aku di dalam gelap seperti orang yang sudah lama mati."
 },
 {
   "id": 16302,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 4,
   "firman": "Semangatku lemah lesu dalam diriku, hatiku tertegun dalam tubuhku."
 },
 {
   "id": 16303,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 5,
   "firman": "Aku teringat kepada hari-hari dahulu kala, aku merenungkan segala pekerjaan-Mu, aku memikirkan perbuatan tangan-Mu."
 },
 {
   "id": 16304,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 6,
   "firman": "Aku menadahkan tanganku kepada-Mu, jiwaku haus kepada-Mu seperti tanah yang tandus. Sela"
 },
 {
   "id": 16305,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 7,
   "firman": "Jawablah aku dengan segera, ya TUHAN, sudah habis semangatku! Jangan sembunyikan wajah-Mu terhadap aku, sehingga aku seperti mereka yang turun ke liang kubur."
 },
 {
   "id": 16306,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 8,
   "firman": "Perdengarkanlah kasih setia-Mu kepadaku pada waktu pagi, sebab kepada-Mulah aku percaya! Beritahukanlah aku jalan yang harus kutempuh, sebab kepada-Mulah kuangkat jiwaku."
 },
 {
   "id": 16307,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 9,
   "firman": "Lepaskanlah aku dari pada musuh-musuhku, ya TUHAN, pada-Mulah aku berteduh!"
 },
 {
   "id": 16308,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 10,
   "firman": "Ajarlah aku melakukan kehendak-Mu, sebab Engkaulah Allahku! Kiranya Roh-Mu yang baik itu menuntun aku di tanah yang rata!"
 },
 {
   "id": 16309,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 11,
   "firman": "Hidupkanlah aku oleh karena nama-Mu, ya TUHAN, keluarkanlah jiwaku dari dalam kesesakan demi keadilan-Mu!"
 },
 {
   "id": 16310,
   "kitab": "Mzm",
   "pasal": 143,
   "ayat": 12,
   "firman": "Binasakanlah musuh-musuhku demi kasih setia-Mu, dan lenyapkanlah semua orang yang mendesak aku, sebab aku ini hamba-Mu!"
 },
 {
   "id": 16311,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 1,
   "firman": "Dari Daud. Terpujilah TUHAN, gunung batuku, yang mengajar tanganku untuk bertempur, dan jari-jariku untuk berperang;"
 },
 {
   "id": 16312,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 2,
   "firman": "yang menjadi tempat perlindunganku dan kubu pertahananku, kota bentengku dan penyelamatku, perisaiku dan tempat aku berlindung, yang menundukkan bangsa-bangsa ke bawah kuasaku!"
 },
 {
   "id": 16313,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 3,
   "firman": "Ya TUHAN, apakah manusia itu, sehingga Engkau memperhatikannya, dan anak manusia, sehingga Engkau memperhitungkannya?"
 },
 {
   "id": 16314,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 4,
   "firman": "Manusia sama seperti angin, hari-harinya seperti bayang-bayang yang lewat."
 },
 {
   "id": 16315,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 5,
   "firman": "Ya TUHAN, tekukkanlah langit-Mu dan turunlah, sentuhlah gunung-gunung, sehingga berasap!"
 },
 {
   "id": 16316,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 6,
   "firman": "Lontarkanlah kilat-kilat dan serakkanlah mereka, lepaskanlah panah-panah-Mu, sehingga mereka kacau!"
 },
 {
   "id": 16317,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 7,
   "firman": "Ulurkanlah tangan-Mu dari tempat tinggi, bebaskanlah aku dan lepaskanlah aku dari banjir, dari tangan orang-orang asing,"
 },
 {
   "id": 16318,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 8,
   "firman": "yang mulutnya mengucapkan tipu dan yang tangan kanannya adalah tangan kanan dusta."
 },
 {
   "id": 16319,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 9,
   "firman": "Ya Allah, aku hendak menyanyikan nyanyian baru bagi-Mu, dengan gambus sepuluh tali aku hendak bermazmur bagi-Mu,"
 },
 {
   "id": 16320,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 10,
   "firman": "Engkau yang memberikan kemenangan kepada raja-raja, dan yang membebaskan Daud, hamba-Mu!"
 },
 {
   "id": 16321,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 11,
   "firman": "Bebaskanlah aku dari pada pedang celaka dan lepaskanlah aku dari tangan orang-orang asing, yang mulutnya mengucapkan tipu, dan yang tangan kanannya adalah tangan kanan dusta."
 },
 {
   "id": 16322,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 12,
   "firman": "Semoga anak-anak lelaki kita seperti tanam-tanaman yang tumbuh menjadi besar pada waktu mudanya; dan anak-anak perempuan kita seperti tiang-tiang penjuru, yang dipahat untuk bangunan istana!"
 },
 {
   "id": 16323,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 13,
   "firman": "Semoga gudang-gudang kita penuh, mengeluarkan beraneka ragam barang; semoga kambing domba kita menjadi beribu-ribu, berlaksa-laksa di padang-padang kita!"
 },
 {
   "id": 16324,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 14,
   "firman": "Semoga lembu sapi kita sarat; semoga tidak ada kegagalan dan tidak ada keguguran, dan tidak ada jeritan di lapangan-lapangan kita!"
 },
 {
   "id": 16325,
   "kitab": "Mzm",
   "pasal": 144,
   "ayat": 15,
   "firman": "Berbahagialah bangsa yang demikian keadaannya! Berbahagialah bangsa yang Allahnya ialah TUHAN!"
 },
 {
   "id": 16326,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 1,
   "firman": "Puji-pujian dari Daud. Aku hendak mengagungkan Engkau, ya Allahku, ya Raja, dan aku hendak memuji nama-Mu untuk seterusnya dan selamanya."
 },
 {
   "id": 16327,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 2,
   "firman": "Setiap hari aku hendak memuji Engkau, dan hendak memuliakan nama-Mu untuk seterusnya dan selamanya."
 },
 {
   "id": 16328,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 3,
   "firman": "Besarlah TUHAN dan sangat terpuji, dan kebesaran-Nya tidak terduga."
 },
 {
   "id": 16329,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 4,
   "firman": "Angkatan demi angkatan akan memegahkan pekerjaan-pekerjaan-Mu dan akan memberitakan keperkasaan-Mu."
 },
 {
   "id": 16330,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 5,
   "firman": "Semarak kemuliaan-Mu yang agung dan perbuatan-perbuatan-Mu yang ajaib akan kunyanyikan."
 },
 {
   "id": 16331,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 6,
   "firman": "Kekuatan perbuatan-perbuatan-Mu yang dahsyat akan diumumkan mereka, dan kebesaran-Mu hendak kuceritakan."
 },
 {
   "id": 16332,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 7,
   "firman": "Peringatan kepada besarnya kebajikan-Mu akan dimasyhurkan mereka, dan tentang keadilan-Mu mereka akan bersorak-sorai."
 },
 {
   "id": 16333,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 8,
   "firman": "TUHAN itu pengasih dan penyayang, panjang sabar dan besar kasih setia-Nya."
 },
 {
   "id": 16334,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 9,
   "firman": "TUHAN itu baik kepada semua orang, dan penuh rahmat terhadap segala yang dijadikan-Nya."
 },
 {
   "id": 16335,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 10,
   "firman": "Segala yang Kaujadikan itu akan bersyukur kepada-Mu, ya TUHAN, dan orang-orang yang Kaukasihi akan memuji Engkau."
 },
 {
   "id": 16336,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 11,
   "firman": "Mereka akan mengumumkan kemuliaan kerajaan-Mu, dan akan membicarakan keperkasaan-Mu,"
 },
 {
   "id": 16337,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 12,
   "firman": "untuk memberitahukan keperkasaan-Mu kepada anak-anak manusia, dan kemuliaan semarak kerajaan-Mu."
 },
 {
   "id": 16338,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 13,
   "firman": "Kerajaan-Mu ialah kerajaan segala abad, dan pemerintahan-Mu tetap melalui segala keturunan. TUHAN setia dalam segala perkataan-Nya dan penuh kasih setia dalam segala perbuatan-Nya."
 },
 {
   "id": 16339,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 14,
   "firman": "TUHAN itu penopang bagi semua orang yang jatuh dan penegak bagi semua orang yang tertunduk."
 },
 {
   "id": 16340,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 15,
   "firman": "Mata sekalian orang menantikan Engkau, dan Engkaupun memberi mereka makanan pada waktunya;"
 },
 {
   "id": 16341,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 16,
   "firman": "Engkau yang membuka tangan-Mu dan yang berkenan mengenyangkan segala yang hidup."
 },
 {
   "id": 16342,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 17,
   "firman": "TUHAN itu adil dalam segala jalan-Nya dan penuh kasih setia dalam segala perbuatan-Nya."
 },
 {
   "id": 16343,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 18,
   "firman": "TUHAN dekat pada setiap orang yang berseru kepada-Nya, pada setiap orang yang berseru kepada-Nya dalam kesetiaan."
 },
 {
   "id": 16344,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 19,
   "firman": "Ia melakukan kehendak orang-orang yang takut akan Dia, mendengarkan teriak mereka minta tolong dan menyelamatkan mereka."
 },
 {
   "id": 16345,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 20,
   "firman": "TUHAN menjaga semua orang yang mengasihi-Nya, tetapi semua orang fasik akan dibinasakan-Nya."
 },
 {
   "id": 16346,
   "kitab": "Mzm",
   "pasal": 145,
   "ayat": 21,
   "firman": "Mulutku mengucapkan puji-pujian kepada TUHAN dan biarlah segala makhluk memuji nama-Nya yang kudus untuk seterusnya dan selamanya."
 },
 {
   "id": 16347,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 1,
   "firman": "Haleluya! Pujilah TUHAN, hai jiwaku!"
 },
 {
   "id": 16348,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 2,
   "firman": "Aku hendak memuliakan TUHAN selama aku hidup, dan bermazmur bagi Allahku selagi aku ada."
 },
 {
   "id": 16349,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 3,
   "firman": "Janganlah percaya kepada para bangsawan, kepada anak manusia yang tidak dapat memberikan keselamatan."
 },
 {
   "id": 16350,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 4,
   "firman": "Apabila nyawanya melayang, ia kembali ke tanah; pada hari itu juga lenyaplah maksud-maksudnya."
 },
 {
   "id": 16351,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 5,
   "firman": "Berbahagialah orang yang mempunyai Allah Yakub sebagai penolong, yang harapannya pada TUHAN, Allahnya:"
 },
 {
   "id": 16352,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 6,
   "firman": "Dia yang menjadikan langit dan bumi, laut dan segala isinya; yang tetap setia untuk selama-lamanya,"
 },
 {
   "id": 16353,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 7,
   "firman": "yang menegakkan keadilan untuk orang-orang yang diperas, yang memberi roti kepada orang-orang yang lapar. TUHAN membebaskan orang-orang yang terkurung,"
 },
 {
   "id": 16354,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 8,
   "firman": "TUHAN membuka mata orang-orang buta, TUHAN menegakkan orang yang tertunduk, TUHAN mengasihi orang-orang benar."
 },
 {
   "id": 16355,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 9,
   "firman": "TUHAN menjaga orang-orang asing, anak yatim dan janda ditegakkan-Nya kembali, tetapi jalan orang fasik dibengkokkan-Nya."
 },
 {
   "id": 16356,
   "kitab": "Mzm",
   "pasal": 146,
   "ayat": 10,
   "firman": "TUHAN itu Raja untuk selama-lamanya, Allahmu, ya Sion, turun-temurun! Haleluya!"
 },
 {
   "id": 16357,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 1,
   "firman": "Haleluya! Sungguh, bermazmur bagi Allah kita itu baik, bahkan indah, dan layaklah memuji-muji itu."
 },
 {
   "id": 16358,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 2,
   "firman": "TUHAN membangun Yerusalem, Ia mengumpulkan orang-orang Israel yang tercerai-berai;"
 },
 {
   "id": 16359,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 3,
   "firman": "Ia menyembuhkan orang-orang yang patah hati dan membalut luka-luka mereka;"
 },
 {
   "id": 16360,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 4,
   "firman": "Ia menentukan jumlah bintang-bintang dan menyebut nama-nama semuanya."
 },
 {
   "id": 16361,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 5,
   "firman": "Besarlah Tuhan kita dan berlimpah kekuatan, kebijaksanaan-Nya tak terhingga."
 },
 {
   "id": 16362,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 6,
   "firman": "TUHAN menegakkan kembali orang-orang yang tertindas, tetapi merendahkan orang-orang fasik sampai ke bumi."
 },
 {
   "id": 16363,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 7,
   "firman": "Bernyanyilah bagi TUHAN dengan nyanyian syukur, bermazmurlah bagi Allah kita dengan kecapi!"
 },
 {
   "id": 16364,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 8,
   "firman": "Dia, yang menutupi langit dengan awan-awan, yang menyediakan hujan bagi bumi, yang membuat gunung-gunung menumbuhkan rumput."
 },
 {
   "id": 16365,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 9,
   "firman": "Dia, yang memberi makanan kepada hewan, kepada anak-anak burung gagak, yang memanggil-manggil."
 },
 {
   "id": 16366,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 10,
   "firman": "Ia tidak suka kepada kegagahan kuda, Ia tidak senang kepada kaki laki-laki;"
 },
 {
   "id": 16367,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 11,
   "firman": "TUHAN senang kepada orang-orang yang takut akan Dia, kepada orang-orang yang berharap akan kasih setia-Nya."
 },
 {
   "id": 16368,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 12,
   "firman": "Megahkanlah TUHAN, hai Yerusalem, pujilah Allahmu, hai Sion!"
 },
 {
   "id": 16369,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 13,
   "firman": "Sebab Ia meneguhkan palang pintu gerbangmu, dan memberkati anak-anakmu di antaramu."
 },
 {
   "id": 16370,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 14,
   "firman": "Ia memberikan kesejahteraan kepada daerahmu dan mengenyangkan engkau dengan gandum yang terbaik."
 },
 {
   "id": 16371,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 15,
   "firman": "Ia menyampaikan perintah-Nya ke bumi; dengan segera firman-Nya berlari."
 },
 {
   "id": 16372,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 16,
   "firman": "Ia menurunkan salju seperti bulu domba dan menghamburkan embun beku seperti abu."
 },
 {
   "id": 16373,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 17,
   "firman": "Ia melemparkan air batu seperti pecahan-pecahan. Siapakah yang tahan berdiri menghadapi dingin-Nya?"
 },
 {
   "id": 16374,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 18,
   "firman": "Ia menyampaikan firman-Nya, lalu mencairkan semuanya, Ia meniupkan angin-Nya, maka air mengalir."
 },
 {
   "id": 16375,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 19,
   "firman": "Ia memberitakan firman-Nya kepada Yakub, ketetapan-ketetapan-Nya dan hukum-hukum-Nya kepada Israel."
 },
 {
   "id": 16376,
   "kitab": "Mzm",
   "pasal": 147,
   "ayat": 20,
   "firman": "Ia tidak berbuat demikian kepada segala bangsa, dan hukum-hukum-Nya tidak mereka kenal. Haleluya!"
 },
 {
   "id": 16377,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 1,
   "firman": "Haleluya! Pujilah TUHAN di sorga, pujilah Dia di tempat tinggi!"
 },
 {
   "id": 16378,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 2,
   "firman": "Pujilah Dia, hai segala malaikat-Nya, pujilah Dia, hai segala tentara-Nya!"
 },
 {
   "id": 16379,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 3,
   "firman": "Pujilah Dia, hai matahari dan bulan, pujilah Dia, hai segala bintang terang!"
 },
 {
   "id": 16380,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 4,
   "firman": "Pujilah Dia, hai langit yang mengatasi segala langit, hai air yang di atas langit!"
 },
 {
   "id": 16381,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 5,
   "firman": "Baiklah semuanya memuji nama TUHAN, sebab Dia memberi perintah, maka semuanya tercipta."
 },
 {
   "id": 16382,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 6,
   "firman": "Dia mendirikan semuanya untuk seterusnya dan selamanya, dan memberi ketetapan yang tidak dapat dilanggar."
 },
 {
   "id": 16383,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 7,
   "firman": "Pujilah TUHAN di bumi, hai ular-ular naga dan segenap samudera raya;"
 },
 {
   "id": 16384,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 8,
   "firman": "hai api dan hujan es, salju dan kabut, angin badai yang melakukan firman-Nya;"
 },
 {
   "id": 16385,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 9,
   "firman": "hai gunung-gunung dan segala bukit, pohon buah-buahan dan segala pohon aras:"
 },
 {
   "id": 16386,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 10,
   "firman": "hai binatang-binatang liar dan segala hewan, binatang melata dan burung-burung yang bersayap;"
 },
 {
   "id": 16387,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 11,
   "firman": "hai raja-raja di bumi dan segala bangsa, pembesar-pembesar dan semua pemerintah dunia;"
 },
 {
   "id": 16388,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 12,
   "firman": "hai teruna dan anak-anak dara, orang tua dan orang muda!"
 },
 {
   "id": 16389,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 13,
   "firman": "Biarlah semuanya memuji-muji TUHAN, sebab hanya nama-Nya saja yang tinggi luhur, keagungan-Nya mengatasi bumi dan langit."
 },
 {
   "id": 16390,
   "kitab": "Mzm",
   "pasal": 148,
   "ayat": 14,
   "firman": "Ia telah meninggikan tanduk umat-Nya, menjadi puji-pujian bagi semua orang yang dikasihi-Nya, bagi orang Israel, umat yang dekat pada-Nya. Haleluya!"
 },
 {
   "id": 16391,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 1,
   "firman": "Haleluya! Nyanyikanlah bagi TUHAN nyanyian baru! Pujilah Dia dalam jemaah orang-orang saleh."
 },
 {
   "id": 16392,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 2,
   "firman": "Biarlah Israel bersukacita atas Yang menjadikannya, biarlah bani Sion bersorak-sorak atas raja mereka!"
 },
 {
   "id": 16393,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 3,
   "firman": "Biarlah mereka memuji-muji nama-Nya dengan tari-tarian, biarlah mereka bermazmur kepada-Nya dengan rebana dan kecapi!"
 },
 {
   "id": 16394,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 4,
   "firman": "Sebab TUHAN berkenan kepada umat-Nya, Ia memahkotai orang-orang yang rendah hati dengan keselamatan."
 },
 {
   "id": 16395,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 5,
   "firman": "Biarlah orang-orang saleh beria-ria dalam kemuliaan, biarlah mereka bersorak-sorai di atas tempat tidur mereka!"
 },
 {
   "id": 16396,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 6,
   "firman": "Biarlah pujian pengagungan Allah ada dalam kerongkongan mereka, dan pedang bermata dua di tangan mereka,"
 },
 {
   "id": 16397,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 7,
   "firman": "untuk melakukan pembalasan terhadap bangsa-bangsa, penyiksaan-penyiksaan terhadap suku-suku bangsa,"
 },
 {
   "id": 16398,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 8,
   "firman": "untuk membelenggu raja-raja mereka dengan rantai, dan orang-orang mereka yang mulia dengan tali-tali besi,"
 },
 {
   "id": 16399,
   "kitab": "Mzm",
   "pasal": 149,
   "ayat": 9,
   "firman": "untuk melaksanakan terhadap mereka hukuman seperti yang tertulis. Itulah semarak bagi semua orang yang dikasihi-Nya. Haleluya!"
 },
 {
   "id": 16400,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 1,
   "firman": "Haleluya! Pujilah Allah dalam tempat kudus-Nya! Pujilah Dia dalam cakrawala-Nya yang kuat!"
 },
 {
   "id": 16401,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 2,
   "firman": "Pujilah Dia karena segala keperkasaan-Nya, pujilah Dia sesuai dengan kebesaran-Nya yang hebat!"
 },
 {
   "id": 16402,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 3,
   "firman": "Pujilah Dia dengan tiupan sangkakala, pujilah Dia dengan gambus dan kecapi!"
 },
 {
   "id": 16403,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 4,
   "firman": "Pujilah Dia dengan rebana dan tari-tarian, pujilah Dia dengan permainan kecapi dan seruling!"
 },
 {
   "id": 16404,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 5,
   "firman": "Pujilah Dia dengan ceracap yang berdenting, pujilah Dia dengan ceracap yang berdentang!"
 },
 {
   "id": 16405,
   "kitab": "Mzm",
   "pasal": 150,
   "ayat": 6,
   "firman": "Biarlah segala yang bernafas memuji TUHAN! Haleluya!"
 },
 {
   "id": 16406,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 1,
   "firman": "Amsal-amsal Salomo bin Daud, raja Israel,"
 },
 {
   "id": 16407,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 2,
   "firman": "untuk mengetahui hikmat dan didikan, untuk mengerti kata-kata yang bermakna,"
 },
 {
   "id": 16408,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 3,
   "firman": "untuk menerima didikan yang menjadikan pandai, serta kebenaran, keadilan dan kejujuran,"
 },
 {
   "id": 16409,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 4,
   "firman": "untuk memberikan kecerdasan kepada orang yang tak berpengalaman, dan pengetahuan serta kebijaksanaan kepada orang muda--"
 },
 {
   "id": 16410,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 5,
   "firman": "baiklah orang bijak mendengar dan menambah ilmu dan baiklah orang yang berpengertian memperoleh bahan pertimbangan--"
 },
 {
   "id": 16411,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 6,
   "firman": "untuk mengerti amsal dan ibarat, perkataan dan teka-teki orang bijak."
 },
 {
   "id": 16412,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 7,
   "firman": "Takut akan TUHAN adalah permulaan pengetahuan, tetapi orang bodoh menghina hikmat dan didikan."
 },
 {
   "id": 16413,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 8,
   "firman": "Hai anakku, dengarkanlah didikan ayahmu, dan jangan menyia-nyiakan ajaran ibumu"
 },
 {
   "id": 16414,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 9,
   "firman": "sebab karangan bunga yang indah itu bagi kepalamu, dan suatu kalung bagi lehermu."
 },
 {
   "id": 16415,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 10,
   "firman": "Hai anakku, jikalau orang berdosa hendak membujuk engkau, janganlah engkau menurut;"
 },
 {
   "id": 16416,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 11,
   "firman": "jikalau mereka berkata: \"Marilah ikut kami, biarlah kita menghadang darah, biarlah kita mengintai orang yang tidak bersalah, dengan tidak semena-mena;"
 },
 {
   "id": 16417,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 12,
   "firman": "biarlah kita menelan mereka hidup-hidup seperti dunia orang mati, bulat-bulat, seperti mereka yang turun ke liang kubur;"
 },
 {
   "id": 16418,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 13,
   "firman": "kita akan mendapat pelbagai benda yang berharga, kita akan memenuhi rumah kita dengan barang rampasan;"
 },
 {
   "id": 16419,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 14,
   "firman": "buanglah undimu ke tengah-tengah kami, satu pundi-pundi bagi kita sekalian.\""
 },
 {
   "id": 16420,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 15,
   "firman": "Hai anakku, janganlah engkau hidup menurut tingkah laku mereka, tahanlah kakimu dari pada jalan mereka,"
 },
 {
   "id": 16421,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 16,
   "firman": "karena kaki mereka lari menuju kejahatan dan bergegas-gegas untuk menumpahkan darah."
 },
 {
   "id": 16422,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sebab percumalah jaring dibentangkan di depan mata segala yang bersayap,"
 },
 {
   "id": 16423,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 18,
   "firman": "padahal mereka menghadang darahnya sendiri dan mengintai nyawanya sendiri."
 },
 {
   "id": 16424,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 19,
   "firman": "Demikianlah pengalaman setiap orang yang loba akan keuntungan gelap, yang mengambil nyawa orang yang mempunyainya."
 },
 {
   "id": 16425,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 20,
   "firman": "Hikmat berseru nyaring di jalan-jalan, di lapangan-lapangan ia memperdengarkan suaranya,"
 },
 {
   "id": 16426,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 21,
   "firman": "di atas tembok-tembok ia berseru-seru, di depan pintu-pintu gerbang kota ia mengucapkan kata-katanya."
 },
 {
   "id": 16427,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 22,
   "firman": "\"Berapa lama lagi, hai orang yang tak berpengalaman, kamu masih cinta kepada keadaanmu itu, pencemooh masih gemar kepada cemooh, dan orang bebal benci kepada pengetahuan?"
 },
 {
   "id": 16428,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 23,
   "firman": "Berpalinglah kamu kepada teguranku! Sesungguhnya, aku hendak mencurahkan isi hatiku kepadamu dan memberitahukan perkataanku kepadamu."
 },
 {
   "id": 16429,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 24,
   "firman": "Oleh karena kamu menolak ketika aku memanggil, dan tidak ada orang yang menghiraukan ketika aku mengulurkan tanganku,"
 },
 {
   "id": 16430,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 25,
   "firman": "bahkan, kamu mengabaikan nasihatku, dan tidak mau menerima teguranku,"
 },
 {
   "id": 16431,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 26,
   "firman": "maka aku juga akan menertawakan celakamu; aku akan berolok-olok, apabila kedahsyatan datang ke atasmu,"
 },
 {
   "id": 16432,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 27,
   "firman": "apabila kedahsyatan datang ke atasmu seperti badai, dan celaka melanda kamu seperti angin puyuh, apabila kesukaran dan kecemasan datang menimpa kamu."
 },
 {
   "id": 16433,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 28,
   "firman": "Pada waktu itu mereka akan berseru kepadaku, tetapi tidak akan kujawab, mereka akan bertekun mencari aku, tetapi tidak akan menemukan aku."
 },
 {
   "id": 16434,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 29,
   "firman": "Oleh karena mereka benci kepada pengetahuan dan tidak memilih takut akan TUHAN,"
 },
 {
   "id": 16435,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 30,
   "firman": "tidak mau menerima nasihatku, tetapi menolak segala teguranku,"
 },
 {
   "id": 16436,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 31,
   "firman": "maka mereka akan memakan buah perbuatan mereka, dan menjadi kenyang oleh rencana mereka."
 },
 {
   "id": 16437,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 32,
   "firman": "Sebab orang yang tak berpengalaman akan dibunuh oleh keengganannya, dan orang bebal akan dibinasakan oleh kelalaiannya."
 },
 {
   "id": 16438,
   "kitab": "Ams",
   "pasal": 1,
   "ayat": 33,
   "firman": "Tetapi siapa mendengarkan aku, ia akan tinggal dengan aman, terlindung dari pada kedahsyatan malapetaka.\""
 },
 {
   "id": 16439,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 1,
   "firman": "Hai anakku, jikalau engkau menerima perkataanku dan menyimpan perintahku di dalam hatimu,"
 },
 {
   "id": 16440,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 2,
   "firman": "sehingga telingamu memperhatikan hikmat, dan engkau mencenderungkan hatimu kepada kepandaian,"
 },
 {
   "id": 16441,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 3,
   "firman": "ya, jikalau engkau berseru kepada pengertian, dan menujukan suaramu kepada kepandaian,"
 },
 {
   "id": 16442,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 4,
   "firman": "jikalau engkau mencarinya seperti mencari perak, dan mengejarnya seperti mengejar harta terpendam,"
 },
 {
   "id": 16443,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 5,
   "firman": "maka engkau akan memperoleh pengertian tentang takut akan TUHAN dan mendapat pengenalan akan Allah."
 },
 {
   "id": 16444,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 6,
   "firman": "Karena Tuhanlah yang memberikan hikmat, dari mulut-Nya datang pengetahuan dan kepandaian."
 },
 {
   "id": 16445,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 7,
   "firman": "Ia menyediakan pertolongan bagi orang yang jujur, menjadi perisai bagi orang yang tidak bercela lakunya,"
 },
 {
   "id": 16446,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 8,
   "firman": "sambil menjaga jalan keadilan, dan memelihara jalan orang-orang-Nya yang setia."
 },
 {
   "id": 16447,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka engkau akan mengerti tentang kebenaran, keadilan, dan kejujuran, bahkan setiap jalan yang baik."
 },
 {
   "id": 16448,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 10,
   "firman": "Karena hikmat akan masuk ke dalam hatimu dan pengetahuan akan menyenangkan jiwamu;"
 },
 {
   "id": 16449,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 11,
   "firman": "kebijaksanaan akan memelihara engkau, kepandaian akan menjaga engkau"
 },
 {
   "id": 16450,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 12,
   "firman": "supaya engkau terlepas dari jalan yang jahat, dari orang yang mengucapkan tipu muslihat,"
 },
 {
   "id": 16451,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 13,
   "firman": "dari mereka yang meninggalkan jalan yang lurus dan menempuh jalan yang gelap;"
 },
 {
   "id": 16452,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 14,
   "firman": "yang bersukacita melakukan kejahatan, bersorak-sorak karena tipu muslihat yang jahat,"
 },
 {
   "id": 16453,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 15,
   "firman": "yang berliku-liku jalannya dan yang sesat perilakunya;"
 },
 {
   "id": 16454,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 16,
   "firman": "supaya engkau terlepas dari perempuan jalang, dari perempuan yang asing, yang licin perkataannya,"
 },
 {
   "id": 16455,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 17,
   "firman": "yang meninggalkan teman hidup masa mudanya dan melupakan perjanjian Allahnya;"
 },
 {
   "id": 16456,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 18,
   "firman": "sesungguhnya rumahnya hilang tenggelam ke dalam maut, jalannya menuju ke arwah-arwah."
 },
 {
   "id": 16457,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 19,
   "firman": "Segala orang yang datang kepadanya tidak balik kembali, dan tidak mencapai jalan kehidupan."
 },
 {
   "id": 16458,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sebab itu tempuhlah jalan orang baik, dan peliharalah jalan-jalan orang benar."
 },
 {
   "id": 16459,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 21,
   "firman": "Karena orang jujurlah akan mendiami tanah, dan orang yang tak bercelalah yang akan tetap tinggal di situ,"
 },
 {
   "id": 16460,
   "kitab": "Ams",
   "pasal": 2,
   "ayat": 22,
   "firman": "tetapi orang fasik akan dipunahkan dari tanah itu, dan pengkhianat akan dibuang dari situ."
 },
 {
   "id": 16461,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 1,
   "firman": "Hai anakku, janganlah engkau melupakan ajaranku, dan biarlah hatimu memelihara perintahku,"
 },
 {
   "id": 16462,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 2,
   "firman": "karena panjang umur dan lanjut usia serta sejahtera akan ditambahkannya kepadamu."
 },
 {
   "id": 16463,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 3,
   "firman": "Janganlah kiranya kasih dan setia meninggalkan engkau! Kalungkanlah itu pada lehermu, tuliskanlah itu pada loh hatimu,"
 },
 {
   "id": 16464,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 4,
   "firman": "maka engkau akan mendapat kasih dan penghargaan dalam pandangan Allah serta manusia."
 },
 {
   "id": 16465,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 5,
   "firman": "Percayalah kepada TUHAN dengan segenap hatimu, dan janganlah bersandar kepada pengertianmu sendiri."
 },
 {
   "id": 16466,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 6,
   "firman": "Akuilah Dia dalam segala lakumu, maka Ia akan meluruskan jalanmu."
 },
 {
   "id": 16467,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 7,
   "firman": "Janganlah engkau menganggap dirimu sendiri bijak, takutlah akan TUHAN dan jauhilah kejahatan;"
 },
 {
   "id": 16468,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 8,
   "firman": "itulah yang akan menyembuhkan tubuhmu dan menyegarkan tulang-tulangmu."
 },
 {
   "id": 16469,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 9,
   "firman": "Muliakanlah TUHAN dengan hartamu dan dengan hasil pertama dari segala penghasilanmu,"
 },
 {
   "id": 16470,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 10,
   "firman": "maka lumbung-lumbungmu akan diisi penuh sampai melimpah-limpah, dan bejana pemerahanmu akan meluap dengan air buah anggurnya."
 },
 {
   "id": 16471,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 11,
   "firman": "Hai anakku, janganlah engkau menolak didikan TUHAN, dan janganlah engkau bosan akan peringatan-Nya."
 },
 {
   "id": 16472,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 12,
   "firman": "Karena TUHAN memberi ajaran kepada yang dikasihi-Nya, seperti seorang ayah kepada anak yang disayangi."
 },
 {
   "id": 16473,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 13,
   "firman": "Berbahagialah orang yang mendapat hikmat, orang yang memperoleh kepandaian,"
 },
 {
   "id": 16474,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 14,
   "firman": "karena keuntungannya melebihi keuntungan perak, dan hasilnya melebihi emas."
 },
 {
   "id": 16475,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 15,
   "firman": "Ia lebih berharga dari pada permata; apapun yang kauinginkan, tidak dapat menyamainya."
 },
 {
   "id": 16476,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 16,
   "firman": "Umur panjang ada di tangan kanannya, di tangan kirinya kekayaan dan kehormatan."
 },
 {
   "id": 16477,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 17,
   "firman": "Jalannya adalah jalan penuh bahagia, segala jalannya sejahtera semata-mata."
 },
 {
   "id": 16478,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 18,
   "firman": "Ia menjadi pohon kehidupan bagi orang yang memegangnya, siapa yang berpegang padanya akan disebut berbahagia."
 },
 {
   "id": 16479,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 19,
   "firman": "Dengan hikmat TUHAN telah meletakkan dasar bumi, dengan pengertian ditetapkan-Nya langit,"
 },
 {
   "id": 16480,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 20,
   "firman": "dengan pengetahuan-Nya air samudera raya berpencaran dan awan menitikkan embun."
 },
 {
   "id": 16481,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 21,
   "firman": "Hai anakku, janganlah pertimbangan dan kebijaksanaan itu menjauh dari matamu, peliharalah itu,"
 },
 {
   "id": 16482,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 22,
   "firman": "maka itu akan menjadi kehidupan bagi jiwamu, dan perhiasan bagi lehermu."
 },
 {
   "id": 16483,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 23,
   "firman": "Maka engkau akan berjalan di jalanmu dengan aman, dan kakimu tidak akan terantuk."
 },
 {
   "id": 16484,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 24,
   "firman": "Jikalau engkau berbaring, engkau tidak akan terkejut, tetapi engkau akan berbaring dan tidur nyenyak."
 },
 {
   "id": 16485,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 25,
   "firman": "Janganlah takut kepada kekejutan yang tiba-tiba, atau kepada kebinasaan orang fasik, bila itu datang."
 },
 {
   "id": 16486,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 26,
   "firman": "Karena Tuhanlah yang akan menjadi sandaranmu, dan akan menghindarkan kakimu dari jerat."
 },
 {
   "id": 16487,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 27,
   "firman": "Janganlah menahan kebaikan dari pada orang-orang yang berhak menerimanya, padahal engkau mampu melakukannya."
 },
 {
   "id": 16488,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 28,
   "firman": "Janganlah engkau berkata kepada sesamamu: \"Pergilah dan kembalilah, besok akan kuberi,\" sedangkan yang diminta ada padamu."
 },
 {
   "id": 16489,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 29,
   "firman": "Janganlah merencanakan kejahatan terhadap sesamamu, sedangkan tanpa curiga ia tinggal bersama-sama dengan engkau."
 },
 {
   "id": 16490,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 30,
   "firman": "Janganlah bertengkar tidak semena-mena dengan seseorang, jikalau ia tidak berbuat jahat kepadamu."
 },
 {
   "id": 16491,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 31,
   "firman": "Janganlah iri hati kepada orang yang melakukan kelaliman, dan janganlah memilih satupun dari jalannya,"
 },
 {
   "id": 16492,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 32,
   "firman": "karena orang yang sesat adalah kekejian bagi TUHAN, tetapi dengan orang jujur Ia bergaul erat."
 },
 {
   "id": 16493,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 33,
   "firman": "Kutuk TUHAN ada di dalam rumah orang fasik, tetapi tempat kediaman orang benar diberkati-Nya."
 },
 {
   "id": 16494,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 34,
   "firman": "Apabila Ia menghadapi pencemooh, maka Iapun mencemooh, tetapi orang yang rendah hati dikasihani-Nya."
 },
 {
   "id": 16495,
   "kitab": "Ams",
   "pasal": 3,
   "ayat": 35,
   "firman": "Orang yang bijak akan mewarisi kehormatan, tetapi orang yang bebal akan menerima cemooh."
 },
 {
   "id": 16496,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 1,
   "firman": "Dengarkanlah, hai anak-anak, didikan seorang ayah, dan perhatikanlah supaya engkau beroleh pengertian,"
 },
 {
   "id": 16497,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 2,
   "firman": "karena aku memberikan ilmu yang baik kepadamu; janganlah meninggalkan petunjukku."
 },
 {
   "id": 16498,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 3,
   "firman": "Karena ketika aku masih tinggal di rumah ayahku sebagai anak, lemah dan sebagai anak tunggal bagi ibuku,"
 },
 {
   "id": 16499,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 4,
   "firman": "aku diajari ayahku, katanya kepadaku: \"Biarlah hatimu memegang perkataanku; berpeganglah pada petunjuk-petunjukku, maka engkau akan hidup."
 },
 {
   "id": 16500,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 5,
   "firman": "Perolehlah hikmat, perolehlah pengertian, jangan lupa, dan jangan menyimpang dari perkataan mulutku."
 },
 {
   "id": 16501,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 6,
   "firman": "Janganlah meninggalkan hikmat itu, maka engkau akan dipeliharanya, kasihilah dia, maka engkau akan dijaganya."
 },
 {
   "id": 16502,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 7,
   "firman": "Permulaan hikmat ialah: perolehlah hikmat dan dengan segala yang kauperoleh perolehlah pengertian."
 },
 {
   "id": 16503,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 8,
   "firman": "Junjunglah dia, maka engkau akan ditinggikannya; engkau akan dijadikan terhormat, apabila engkau memeluknya."
 },
 {
   "id": 16504,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 9,
   "firman": "Ia akan mengenakan karangan bunga yang indah di kepalamu, mahkota yang indah akan dikaruniakannya kepadamu.\""
 },
 {
   "id": 16505,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 10,
   "firman": "Hai anakku, dengarkanlah dan terimalah perkataanku, supaya tahun hidupmu menjadi banyak."
 },
 {
   "id": 16506,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 11,
   "firman": "Aku mengajarkan jalan hikmat kepadamu, aku memimpin engkau di jalan yang lurus."
 },
 {
   "id": 16507,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 12,
   "firman": "Bila engkau berjalan langkahmu tidak akan terhambat, bila engkau berlari engkau tidak akan tersandung."
 },
 {
   "id": 16508,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 13,
   "firman": "Berpeganglah pada didikan, janganlah melepaskannya, peliharalah dia, karena dialah hidupmu."
 },
 {
   "id": 16509,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 14,
   "firman": "Janganlah menempuh jalan orang fasik, dan janganlah mengikuti jalan orang jahat."
 },
 {
   "id": 16510,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 15,
   "firman": "Jauhilah jalan itu, janganlah melaluinya, menyimpanglah dari padanya dan jalanlah terus."
 },
 {
   "id": 16511,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 16,
   "firman": "Karena mereka tidak dapat tidur, bila tidak berbuat jahat; kantuk mereka lenyap, bila mereka tidak membuat orang tersandung;"
 },
 {
   "id": 16512,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 17,
   "firman": "karena mereka makan roti kefasikan, dan minum anggur kelaliman."
 },
 {
   "id": 16513,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 18,
   "firman": "Tetapi jalan orang benar itu seperti cahaya fajar, yang kian bertambah terang sampai rembang tengah hari."
 },
 {
   "id": 16514,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 19,
   "firman": "Jalan orang fasik itu seperti kegelapan; mereka tidak tahu apa yang menyebabkan mereka tersandung."
 },
 {
   "id": 16515,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 20,
   "firman": "Hai anakku, perhatikanlah perkataanku, arahkanlah telingamu kepada ucapanku;"
 },
 {
   "id": 16516,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 21,
   "firman": "janganlah semuanya itu menjauh dari matamu, simpanlah itu di lubuk hatimu."
 },
 {
   "id": 16517,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 22,
   "firman": "Karena itulah yang menjadi kehidupan bagi mereka yang mendapatkannya dan kesembuhan bagi seluruh tubuh mereka."
 },
 {
   "id": 16518,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 23,
   "firman": "Jagalah hatimu dengan segala kewaspadaan, karena dari situlah terpancar kehidupan."
 },
 {
   "id": 16519,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 24,
   "firman": "Buanglah mulut serong dari padamu dan jauhkanlah bibir yang dolak-dalik dari padamu."
 },
 {
   "id": 16520,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 25,
   "firman": "Biarlah matamu memandang terus ke depan dan tatapan matamu tetap ke muka."
 },
 {
   "id": 16521,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 26,
   "firman": "Tempuhlah jalan yang rata dan hendaklah tetap segala jalanmu."
 },
 {
   "id": 16522,
   "kitab": "Ams",
   "pasal": 4,
   "ayat": 27,
   "firman": "Janganlah menyimpang ke kanan atau ke kiri, jauhkanlah kakimu dari kejahatan."
 },
 {
   "id": 16523,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 1,
   "firman": "Hai anakku, perhatikanlah hikmatku, arahkanlah telingamu kepada kepandaian yang kuajarkan,"
 },
 {
   "id": 16524,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 2,
   "firman": "supaya engkau berpegang pada kebijaksanaan dan bibirmu memelihara pengetahuan."
 },
 {
   "id": 16525,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 3,
   "firman": "Karena bibir perempuan jalang menitikkan tetesan madu dan langit-langit mulutnya lebih licin dari pada minyak,"
 },
 {
   "id": 16526,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 4,
   "firman": "tetapi kemudian ia pahit seperti empedu, dan tajam seperti pedang bermata dua."
 },
 {
   "id": 16527,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 5,
   "firman": "Kakinya turun menuju maut, langkahnya menuju dunia orang mati."
 },
 {
   "id": 16528,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 6,
   "firman": "Ia tidak menempuh jalan kehidupan, jalannya sesat, tanpa diketahuinya."
 },
 {
   "id": 16529,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab itu, hai anak-anak, dengarkanlah aku, janganlah kamu menyimpang dari pada perkataan mulutku."
 },
 {
   "id": 16530,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 8,
   "firman": "Jauhkanlah jalanmu dari pada dia, dan janganlah menghampiri pintu rumahnya,"
 },
 {
   "id": 16531,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 9,
   "firman": "supaya engkau jangan menyerahkan keremajaanmu kepada orang lain, dan tahun-tahun umurmu kepada orang kejam;"
 },
 {
   "id": 16532,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 10,
   "firman": "supaya orang lain jangan mengenyangkan diri dengan kekayaanmu, dan hasil susah payahmu jangan masuk ke rumah orang yang tidak dikenal"
 },
 {
   "id": 16533,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 11,
   "firman": "dan pada akhirnya engkau akan mengeluh, kalau daging dan tubuhmu habis binasa,"
 },
 {
   "id": 16534,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 12,
   "firman": "lalu engkau akan berkata: \"Ah, mengapa aku benci kepada didikan, dan hatiku menolak teguran;"
 },
 {
   "id": 16535,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 13,
   "firman": "mengapa aku tidak mendengarkan suara guru-guruku, dan tidak mengarahkan telingaku kepada pengajar-pengajarku?"
 },
 {
   "id": 16536,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 14,
   "firman": "Aku nyaris terjerumus ke dalam tiap malapetaka di tengah-tengah jemaah dan perkumpulan.\""
 },
 {
   "id": 16537,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 15,
   "firman": "Minumlah air dari kulahmu sendiri, minumlah air dari sumurmu yang membual."
 },
 {
   "id": 16538,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 16,
   "firman": "Patutkah mata airmu meluap ke luar seperti batang-batang air ke lapangan-lapangan?"
 },
 {
   "id": 16539,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 17,
   "firman": "Biarlah itu menjadi kepunyaanmu sendiri, jangan juga menjadi kepunyaan orang lain."
 },
 {
   "id": 16540,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 18,
   "firman": "Diberkatilah kiranya sendangmu, bersukacitalah dengan isteri masa mudamu:"
 },
 {
   "id": 16541,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 19,
   "firman": "rusa yang manis, kijang yang jelita; biarlah buah dadanya selalu memuaskan engkau, dan engkau senantiasa berahi karena cintanya."
 },
 {
   "id": 16542,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 20,
   "firman": "Hai anakku, mengapa engkau berahi akan perempuan jalang, dan mendekap dada perempuan asing?"
 },
 {
   "id": 16543,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 21,
   "firman": "Karena segala jalan orang terbuka di depan mata TUHAN, dan segala langkah orang diawasi-Nya."
 },
 {
   "id": 16544,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 22,
   "firman": "Orang fasik tertangkap dalam kejahatannya, dan terjerat dalam tali dosanya sendiri."
 },
 {
   "id": 16545,
   "kitab": "Ams",
   "pasal": 5,
   "ayat": 23,
   "firman": "Ia mati, karena tidak menerima didikan dan karena kebodohannya yang besar ia tersesat."
 },
 {
   "id": 16546,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 1,
   "firman": "Hai anakku, jikalau engkau menjadi penanggung sesamamu, dan membuat persetujuan dengan orang lain;"
 },
 {
   "id": 16547,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 2,
   "firman": "jikalau engkau terjerat dalam perkataan mulutmu, tertangkap dalam perkataan mulutmu,"
 },
 {
   "id": 16548,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 3,
   "firman": "buatlah begini, hai anakku, dan lepaskanlah dirimu, karena engkau telah jatuh ke dalam genggaman sesamamu: pergilah, berlututlah, dan desaklah sesamamu itu;"
 },
 {
   "id": 16549,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 4,
   "firman": "janganlah membiarkan matamu tidur, dan kelopak matamu mengantuk;"
 },
 {
   "id": 16550,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 5,
   "firman": "lepaskanlah dirimu seperti kijang dari pada tangkapan, seperti burung dari pada tangan pemikat."
 },
 {
   "id": 16551,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 6,
   "firman": "Hai pemalas, pergilah kepada semut, perhatikanlah lakunya dan jadilah bijak:"
 },
 {
   "id": 16552,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 7,
   "firman": "biarpun tidak ada pemimpinnya, pengaturnya atau penguasanya,"
 },
 {
   "id": 16553,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 8,
   "firman": "ia menyediakan rotinya di musim panas, dan mengumpulkan makanannya pada waktu panen."
 },
 {
   "id": 16554,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 9,
   "firman": "Hai pemalas, berapa lama lagi engkau berbaring? Bilakah engkau akan bangun dari tidurmu?"
 },
 {
   "id": 16555,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 10,
   "firman": "\"Tidur sebentar lagi, mengantuk sebentar lagi, melipat tangan sebentar lagi untuk tinggal berbaring\" --"
 },
 {
   "id": 16556,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 11,
   "firman": "maka datanglah kemiskinan kepadamu seperti seorang penyerbu, dan kekurangan seperti orang yang bersenjata."
 },
 {
   "id": 16557,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 12,
   "firman": "Tak bergunalah dan jahatlah orang yang hidup dengan mulut serong,"
 },
 {
   "id": 16558,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 13,
   "firman": "yang mengedipkan matanya, yang bermain kaki dan menunjuk-nunjuk dengan jari,"
 },
 {
   "id": 16559,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 14,
   "firman": "yang hatinya mengandung tipu muslihat, yang senantiasa merencanakan kejahatan, dan yang menimbulkan pertengkaran."
 },
 {
   "id": 16560,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 15,
   "firman": "Itulah sebabnya ia ditimpa kebinasaan dengan tiba-tiba, sesaat saja ia diremukkan tanpa dapat dipulihkan lagi."
 },
 {
   "id": 16561,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 16,
   "firman": "Enam perkara ini yang dibenci TUHAN, bahkan, tujuh perkara yang menjadi kekejian bagi hati-Nya:"
 },
 {
   "id": 16562,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 17,
   "firman": "mata sombong, lidah dusta, tangan yang menumpahkan darah orang yang tidak bersalah,"
 },
 {
   "id": 16563,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 18,
   "firman": "hati yang membuat rencana-rencana yang jahat, kaki yang segera lari menuju kejahatan,"
 },
 {
   "id": 16564,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 19,
   "firman": "seorang saksi dusta yang menyembur-nyemburkan kebohongan dan yang menimbulkan pertengkaran saudara."
 },
 {
   "id": 16565,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 20,
   "firman": "Hai anakku, peliharalah perintah ayahmu, dan janganlah menyia-nyiakan ajaran ibumu."
 },
 {
   "id": 16566,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 21,
   "firman": "Tambatkanlah senantiasa semuanya itu pada hatimu, kalungkanlah pada lehermu."
 },
 {
   "id": 16567,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 22,
   "firman": "Jikalau engkau berjalan, engkau akan dipimpinnya, jikalau engkau berbaring, engkau akan dijaganya, jikalau engkau bangun, engkau akan disapanya."
 },
 {
   "id": 16568,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 23,
   "firman": "Karena perintah itu pelita, dan ajaran itu cahaya, dan teguran yang mendidik itu jalan kehidupan,"
 },
 {
   "id": 16569,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 24,
   "firman": "yang melindungi engkau terhadap perempuan jahat, terhadap kelicikan lidah perempuan asing."
 },
 {
   "id": 16570,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 25,
   "firman": "Janganlah menginginkan kecantikannya dalam hatimu, janganlah terpikat oleh bulu matanya."
 },
 {
   "id": 16571,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 26,
   "firman": "Karena bagi seorang sundal sepotong rotilah yang penting, tetapi isteri orang lain memburu nyawa yang berharga."
 },
 {
   "id": 16572,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 27,
   "firman": "Dapatkah orang membawa api dalam gelumbung baju dengan tidak terbakar pakaiannya?"
 },
 {
   "id": 16573,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 28,
   "firman": "Atau dapatkah orang berjalan di atas bara, dengan tidak hangus kakinya?"
 },
 {
   "id": 16574,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 29,
   "firman": "Demikian juga orang yang menghampiri isteri sesamanya; tiada seorangpun, yang menjamahnya, luput dari hukuman."
 },
 {
   "id": 16575,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 30,
   "firman": "Apakah seorang pencuri tidak akan dihina, apabila ia mencuri untuk memuaskan nafsunya karena lapar?"
 },
 {
   "id": 16576,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 31,
   "firman": "Dan kalau ia tertangkap, haruslah ia membayar kembali tujuh kali lipat, segenap harta isi rumahnya harus diserahkan."
 },
 {
   "id": 16577,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 32,
   "firman": "Siapa melakukan zinah tidak berakal budi; orang yang berbuat demikian merusak diri."
 },
 {
   "id": 16578,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 33,
   "firman": "Siksa dan cemooh diperolehnya, malunya tidak terhapuskan."
 },
 {
   "id": 16579,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 34,
   "firman": "Karena cemburu adalah geram seorang laki-laki, ia tidak kenal belas kasihan pada hari pembalasan dendam;"
 },
 {
   "id": 16580,
   "kitab": "Ams",
   "pasal": 6,
   "ayat": 35,
   "firman": "ia tidak akan mau menerima tebusan suatupun, dan ia akan tetap bersikeras, betapa banyakpun pemberianmu."
 },
 {
   "id": 16581,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 1,
   "firman": "Hai anakku, berpeganglah pada perkataanku, dan simpanlah perintahku dalam hatimu."
 },
 {
   "id": 16582,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 2,
   "firman": "Berpeganglah pada perintahku, dan engkau akan hidup; simpanlah ajaranku seperti biji matamu."
 },
 {
   "id": 16583,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 3,
   "firman": "Tambatkanlah semuanya itu pada jarimu, dan tulislah itu pada loh hatimu."
 },
 {
   "id": 16584,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 4,
   "firman": "Katakanlah kepada hikmat: \"Engkaulah saudaraku\" dan sebutkanlah pengertian itu sanakmu,"
 },
 {
   "id": 16585,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 5,
   "firman": "supaya engkau dilindunginya terhadap perempuan jalang, terhadap perempuan asing, yang licin perkataannya."
 },
 {
   "id": 16586,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 6,
   "firman": "Karena ketika suatu waktu aku melihat-lihat, dari kisi-kisiku, dari jendela rumahku,"
 },
 {
   "id": 16587,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 7,
   "firman": "kulihat di antara yang tak berpengalaman, kudapati di antara anak-anak muda seorang teruna yang tidak berakal budi,"
 },
 {
   "id": 16588,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 8,
   "firman": "yang menyeberang dekat sudut jalan, lalu melangkah menuju rumah perempuan semacam itu,"
 },
 {
   "id": 16589,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 9,
   "firman": "pada waktu senja, pada petang hari, di malam yang gelap."
 },
 {
   "id": 16590,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 10,
   "firman": "Maka datanglah menyongsong dia seorang perempuan, berpakaian sundal dengan hati licik;"
 },
 {
   "id": 16591,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 11,
   "firman": "cerewet dan liat perempuan ini, kakinya tak dapat tenang di rumah,"
 },
 {
   "id": 16592,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 12,
   "firman": "sebentar ia di jalan dan sebentar di lapangan, dekat setiap tikungan ia menghadang."
 },
 {
   "id": 16593,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 13,
   "firman": "Lalu dipegangnyalah orang teruna itu dan diciumnya, dengan muka tanpa malu berkatalah ia kepadanya:"
 },
 {
   "id": 16594,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 14,
   "firman": "\"Aku harus mempersembahkan korban keselamatan, dan pada hari ini telah kubayar nazarku itu."
 },
 {
   "id": 16595,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 15,
   "firman": "Itulah sebabnya aku keluar menyongsong engkau, untuk mencari engkau dan sekarang kudapatkan engkau."
 },
 {
   "id": 16596,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 16,
   "firman": "Telah kubentangkan permadani di atas tempat tidurku, kain lenan beraneka warna dari Mesir."
 },
 {
   "id": 16597,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 17,
   "firman": "Pembaringanku telah kutaburi dengan mur, gaharu dan kayu manis."
 },
 {
   "id": 16598,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 18,
   "firman": "Marilah kita memuaskan berahi hingga pagi hari, dan bersama-sama menikmati asmara."
 },
 {
   "id": 16599,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 19,
   "firman": "Karena suamiku tidak di rumah, ia sedang dalam perjalanan jauh,"
 },
 {
   "id": 16600,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 20,
   "firman": "sekantong uang dibawanya, ia baru pulang menjelang bulan purnama.\""
 },
 {
   "id": 16601,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 21,
   "firman": "Ia merayu orang muda itu dengan berbagai-bagai bujukan, dengan kelicinan bibir ia menggodanya."
 },
 {
   "id": 16602,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 22,
   "firman": "Maka tiba-tiba orang muda itu mengikuti dia seperti lembu yang dibawa ke pejagalan, dan seperti orang bodoh yang terbelenggu untuk dihukum,"
 },
 {
   "id": 16603,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 23,
   "firman": "sampai anak panah menembus hatinya; seperti burung dengan cepat menuju perangkap, dengan tidak sadar, bahwa hidupnya terancam."
 },
 {
   "id": 16604,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 24,
   "firman": "Oleh sebab itu, hai anak-anak, dengarkanlah aku, perhatikanlah perkataan mulutku."
 },
 {
   "id": 16605,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 25,
   "firman": "Janganlah hatimu membelok ke jalan-jalan perempuan itu, dan janganlah menyesatkan dirimu di jalan-jalannya."
 },
 {
   "id": 16606,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 26,
   "firman": "Karena banyaklah orang yang gugur ditewaskannya, sangat besarlah jumlah orang yang dibunuhnya."
 },
 {
   "id": 16607,
   "kitab": "Ams",
   "pasal": 7,
   "ayat": 27,
   "firman": "Rumahnya adalah jalan ke dunia orang mati, yang menurun ke ruangan-ruangan maut."
 },
 {
   "id": 16608,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 1,
   "firman": "Bukankah hikmat berseru-seru, dan kepandaian memperdengarkan suaranya?"
 },
 {
   "id": 16609,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 2,
   "firman": "Di atas tempat-tempat yang tinggi di tepi jalan, di persimpangan jalan-jalan, di sanalah ia berdiri,"
 },
 {
   "id": 16610,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 3,
   "firman": "di samping pintu-pintu gerbang, di depan kota, pada jalan masuk, ia berseru dengan nyaring:"
 },
 {
   "id": 16611,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 4,
   "firman": "\"Hai para pria, kepadamulah aku berseru, kepada anak-anak manusia kutujukan suaraku."
 },
 {
   "id": 16612,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 5,
   "firman": "Hai orang yang tak berpengalaman, tuntutlah kecerdasan, hai orang bebal, mengertilah dalam hatimu."
 },
 {
   "id": 16613,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 6,
   "firman": "Dengarlah, karena aku akan mengatakan perkara-perkara yang dalam dan akan membuka bibirku tentang perkara-perkara yang tepat."
 },
 {
   "id": 16614,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 7,
   "firman": "Karena lidahku mengatakan kebenaran, dan kefasikan adalah kekejian bagi bibirku."
 },
 {
   "id": 16615,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 8,
   "firman": "Segala perkataan mulutku adalah adil, tidak ada yang belat-belit atau serong."
 },
 {
   "id": 16616,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 9,
   "firman": "Semuanya itu jelas bagi yang cerdas, lurus bagi yang berpengetahuan."
 },
 {
   "id": 16617,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 10,
   "firman": "Terimalah didikanku, lebih dari pada perak, dan pengetahuan lebih dari pada emas pilihan."
 },
 {
   "id": 16618,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 11,
   "firman": "Karena hikmat lebih berharga dari pada permata, apapun yang diinginkan orang, tidak dapat menyamainya."
 },
 {
   "id": 16619,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 12,
   "firman": "Aku, hikmat, tinggal bersama-sama dengan kecerdasan, dan aku mendapat pengetahuan dan kebijaksanaan."
 },
 {
   "id": 16620,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 13,
   "firman": "Takut akan TUHAN ialah membenci kejahatan; aku benci kepada kesombongan, kecongkakan, tingkah laku yang jahat, dan mulut penuh tipu muslihat."
 },
 {
   "id": 16621,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 14,
   "firman": "Padaku ada nasihat dan pertimbangan, akulah pengertian, padakulah kekuatan."
 },
 {
   "id": 16622,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 15,
   "firman": "Karena aku para raja memerintah, dan para pembesar menetapkan keadilan."
 },
 {
   "id": 16623,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 16,
   "firman": "Karena aku para pembesar berkuasa juga para bangsawan dan semua hakim di bumi."
 },
 {
   "id": 16624,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 17,
   "firman": "Aku mengasihi orang yang mengasihi aku, dan orang yang tekun mencari aku akan mendapatkan daku."
 },
 {
   "id": 16625,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 18,
   "firman": "Kekayaan dan kehormatan ada padaku, juga harta yang tetap dan keadilan."
 },
 {
   "id": 16626,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 19,
   "firman": "Buahku lebih berharga dari pada emas, bahkan dari pada emas tua, hasilku lebih dari pada perak pilihan."
 },
 {
   "id": 16627,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 20,
   "firman": "Aku berjalan pada jalan kebenaran, di tengah-tengah jalan keadilan,"
 },
 {
   "id": 16628,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 21,
   "firman": "supaya kuwariskan harta kepada yang mengasihi aku, dan kuisi penuh perbendaharaan mereka."
 },
 {
   "id": 16629,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 22,
   "firman": "TUHAN telah menciptakan aku sebagai permulaan pekerjaan-Nya, sebagai perbuatan-Nya yang pertama-tama dahulu kala."
 },
 {
   "id": 16630,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 23,
   "firman": "Sudah pada zaman purbakala aku dibentuk, pada mula pertama, sebelum bumi ada."
 },
 {
   "id": 16631,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 24,
   "firman": "Sebelum air samudera raya ada, aku telah lahir, sebelum ada sumber-sumber yang sarat dengan air."
 },
 {
   "id": 16632,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 25,
   "firman": "Sebelum gunung-gunung tertanam dan lebih dahulu dari pada bukit-bukit aku telah lahir;"
 },
 {
   "id": 16633,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 26,
   "firman": "sebelum Ia membuat bumi dengan padang-padangnya atau debu dataran yang pertama."
 },
 {
   "id": 16634,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 27,
   "firman": "Ketika Ia mempersiapkan langit, aku di sana, ketika Ia menggaris kaki langit pada permukaan air samudera raya,"
 },
 {
   "id": 16635,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 28,
   "firman": "ketika Ia menetapkan awan-awan di atas, dan mata air samudera raya meluap dengan deras,"
 },
 {
   "id": 16636,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 29,
   "firman": "ketika Ia menentukan batas kepada laut, supaya air jangan melanggar titah-Nya, dan ketika Ia menetapkan dasar-dasar bumi,"
 },
 {
   "id": 16637,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 30,
   "firman": "aku ada serta-Nya sebagai anak kesayangan, setiap hari aku menjadi kesenangan-Nya, dan senantiasa bermain-main di hadapan-Nya;"
 },
 {
   "id": 16638,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 31,
   "firman": "aku bermain-main di atas muka bumi-Nya dan anak-anak manusia menjadi kesenanganku."
 },
 {
   "id": 16639,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 32,
   "firman": "Oleh sebab itu, hai anak-anak, dengarkanlah aku, karena berbahagialah mereka yang memelihara jalan-jalanku."
 },
 {
   "id": 16640,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 33,
   "firman": "Dengarkanlah didikan, maka kamu menjadi bijak; janganlah mengabaikannya."
 },
 {
   "id": 16641,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 34,
   "firman": "Berbahagialah orang yang mendengarkan daku, yang setiap hari menunggu pada pintuku, yang menjaga tiang pintu gerbangku."
 },
 {
   "id": 16642,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 35,
   "firman": "Karena siapa mendapatkan aku, mendapatkan hidup, dan TUHAN berkenan akan dia."
 },
 {
   "id": 16643,
   "kitab": "Ams",
   "pasal": 8,
   "ayat": 36,
   "firman": "Tetapi siapa tidak mendapatkan aku, merugikan dirinya; semua orang yang membenci aku, mencintai maut.\""
 },
 {
   "id": 16644,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 1,
   "firman": "Hikmat telah mendirikan rumahnya, menegakkan ketujuh tiangnya,"
 },
 {
   "id": 16645,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 2,
   "firman": "memotong ternak sembelihannya, mencampur anggurnya, dan menyediakan hidangannya."
 },
 {
   "id": 16646,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 3,
   "firman": "Pelayan-pelayan perempuan telah disuruhnya berseru-seru di atas tempat-tempat yang tinggi di kota:"
 },
 {
   "id": 16647,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 4,
   "firman": "\"Siapa yang tak berpengalaman, singgahlah ke mari\"; dan kepada yang tidak berakal budi katanya:"
 },
 {
   "id": 16648,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 5,
   "firman": "\"Marilah, makanlah rotiku, dan minumlah anggur yang telah kucampur;"
 },
 {
   "id": 16649,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 6,
   "firman": "buanglah kebodohan, maka kamu akan hidup, dan ikutilah jalan pengertian.\""
 },
 {
   "id": 16650,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 7,
   "firman": "Siapa mendidik seorang pencemooh, mendatangkan cemooh kepada dirinya sendiri, dan siapa mengecam orang fasik, mendapat cela."
 },
 {
   "id": 16651,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 8,
   "firman": "Janganlah mengecam seorang pencemooh, supaya engkau jangan dibencinya, kecamlah orang bijak, maka engkau akan dikasihinya,"
 },
 {
   "id": 16652,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 9,
   "firman": "berilah orang bijak nasihat, maka ia akan menjadi lebih bijak, ajarilah orang benar, maka pengetahuannya akan bertambah."
 },
 {
   "id": 16653,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 10,
   "firman": "Permulaan hikmat adalah takut akan TUHAN, dan mengenal Yang Mahakudus adalah pengertian."
 },
 {
   "id": 16654,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 11,
   "firman": "Karena oleh aku umurmu diperpanjang, dan tahun-tahun hidupmu ditambah."
 },
 {
   "id": 16655,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 12,
   "firman": "Jikalau engkau bijak, kebijakanmu itu bagimu sendiri, jikalau engkau mencemooh, engkau sendirilah orang yang akan menanggungnya."
 },
 {
   "id": 16656,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 13,
   "firman": "Perempuan bebal cerewet, sangat tidak berpengalaman ia, dan tidak tahu malu."
 },
 {
   "id": 16657,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 14,
   "firman": "Ia duduk di depan pintu rumahnya di atas kursi di tempat-tempat yang tinggi di kota,"
 },
 {
   "id": 16658,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 15,
   "firman": "dan orang-orang yang berlalu di jalan, yang lurus jalannya diundangnya dengan kata-kata:"
 },
 {
   "id": 16659,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 16,
   "firman": "\"Siapa yang tak berpengalaman, singgahlah ke mari\"; dan kepada orang yang tidak berakal budi katanya:"
 },
 {
   "id": 16660,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 17,
   "firman": "\"Air curian manis, dan roti yang dimakan dengan sembunyi-sembunyi lezat rasanya.\""
 },
 {
   "id": 16661,
   "kitab": "Ams",
   "pasal": 9,
   "ayat": 18,
   "firman": "Tetapi orang itu tidak tahu, bahwa di sana ada arwah-arwah dan bahwa orang-orang yang diundangnya ada di dalam dunia orang mati."
 },
 {
   "id": 16662,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 1,
   "firman": "Amsal-amsal Salomo. Anak yang bijak mendatangkan sukacita kepada ayahnya, tetapi anak yang bebal adalah kedukaan bagi ibunya."
 },
 {
   "id": 16663,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 2,
   "firman": "Harta benda yang diperoleh dengan kefasikan tidak berguna, tetapi kebenaran menyelamatkan orang dari maut."
 },
 {
   "id": 16664,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 3,
   "firman": "TUHAN tidak membiarkan orang benar menderita kelaparan, tetapi keinginan orang fasik ditolak-Nya."
 },
 {
   "id": 16665,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 4,
   "firman": "Tangan yang lamban membuat miskin, tetapi tangan orang rajin menjadikan kaya."
 },
 {
   "id": 16666,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 5,
   "firman": "Siapa mengumpulkan pada musim panas, ia berakal budi; siapa tidur pada waktu panen membuat malu."
 },
 {
   "id": 16667,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 6,
   "firman": "Berkat ada di atas kepala orang benar, tetapi mulut orang fasik menyembunyikan kelaliman."
 },
 {
   "id": 16668,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 7,
   "firman": "Kenangan kepada orang benar mendatangkan berkat, tetapi nama orang fasik menjadi busuk."
 },
 {
   "id": 16669,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 8,
   "firman": "Siapa bijak hati, memperhatikan perintah-perintah, tetapi siapa bodoh bicaranya, akan jatuh."
 },
 {
   "id": 16670,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 9,
   "firman": "Siapa bersih kelakuannya, aman jalannya, tetapi siapa berliku-liku jalannya, akan diketahui."
 },
 {
   "id": 16671,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 10,
   "firman": "Siapa mengedipkan mata, menyebabkan kesusahan, siapa bodoh bicaranya, akan jatuh."
 },
 {
   "id": 16672,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 11,
   "firman": "Mulut orang benar adalah sumber kehidupan, tetapi mulut orang fasik menyembunyikan kelaliman."
 },
 {
   "id": 16673,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 12,
   "firman": "Kebencian menimbulkan pertengkaran, tetapi kasih menutupi segala pelanggaran."
 },
 {
   "id": 16674,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 13,
   "firman": "Di bibir orang berpengertian terdapat hikmat, tetapi pentung tersedia bagi punggung orang yang tidak berakal budi."
 },
 {
   "id": 16675,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 14,
   "firman": "Orang bijak menyimpan pengetahuan, tetapi mulut orang bodoh adalah kebinasaan yang mengancam."
 },
 {
   "id": 16676,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kota yang kuat bagi orang kaya ialah hartanya, tetapi yang menjadi kebinasaan bagi orang melarat ialah kemiskinan."
 },
 {
   "id": 16677,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 16,
   "firman": "Upah pekerjaan orang benar membawa kepada kehidupan, penghasilan orang fasik membawa kepada dosa."
 },
 {
   "id": 16678,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 17,
   "firman": "Siapa mengindahkan didikan, menuju jalan kehidupan, tetapi siapa mengabaikan teguran, tersesat."
 },
 {
   "id": 16679,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 18,
   "firman": "Siapa menyembunyikan kebencian, dusta bibirnya; siapa mengumpat adalah orang bebal."
 },
 {
   "id": 16680,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 19,
   "firman": "Di dalam banyak bicara pasti ada pelanggaran, tetapi siapa yang menahan bibirnya, berakal budi."
 },
 {
   "id": 16681,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 20,
   "firman": "Lidah orang benar seperti perak pilihan, tetapi pikiran orang fasik sedikit nilainya."
 },
 {
   "id": 16682,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 21,
   "firman": "Bibir orang benar menggembalakan banyak orang, tetapi orang bodoh mati karena kurang akal budi."
 },
 {
   "id": 16683,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 22,
   "firman": "Berkat Tuhanlah yang menjadikan kaya, susah payah tidak akan menambahinya."
 },
 {
   "id": 16684,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 23,
   "firman": "Berlaku cemar adalah kegemaran orang bebal, sebagaimana melakukan hikmat bagi orang yang pandai."
 },
 {
   "id": 16685,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 24,
   "firman": "Apa yang menggentarkan orang fasik, itulah yang akan menimpa dia, tetapi keinginan orang benar akan diluluskan."
 },
 {
   "id": 16686,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 25,
   "firman": "Bila taufan melanda, lenyaplah orang fasik, tetapi orang benar adalah alas yang abadi."
 },
 {
   "id": 16687,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 26,
   "firman": "Seperti cuka bagi gigi dan asap bagi mata, demikian si pemalas bagi orang yang menyuruhnya."
 },
 {
   "id": 16688,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 27,
   "firman": "Takut akan TUHAN memperpanjang umur, tetapi tahun-tahun orang fasik diperpendek."
 },
 {
   "id": 16689,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 28,
   "firman": "Harapan orang benar akan menjadi sukacita, tetapi harapan orang fasik menjadi sia-sia."
 },
 {
   "id": 16690,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 29,
   "firman": "Jalan TUHAN adalah perlindungan bagi orang yang tulus, tetapi kebinasaan bagi orang yang berbuat jahat."
 },
 {
   "id": 16691,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 30,
   "firman": "Orang benar tidak terombang-ambing untuk selama-lamanya, tetapi orang fasik tidak akan mendiami negeri."
 },
 {
   "id": 16692,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 31,
   "firman": "Mulut orang benar mengeluarkan hikmat, tetapi lidah bercabang akan dikerat."
 },
 {
   "id": 16693,
   "kitab": "Ams",
   "pasal": 10,
   "ayat": 32,
   "firman": "Bibir orang benar tahu akan hal yang menyenangkan, tetapi mulut orang fasik hanya tahu tipu muslihat."
 },
 {
   "id": 16694,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 1,
   "firman": "Neraca serong adalah kekejian bagi TUHAN, tetapi Ia berkenan akan batu timbangan yang tepat."
 },
 {
   "id": 16695,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 2,
   "firman": "Jikalau keangkuhan tiba, tiba juga cemooh, tetapi hikmat ada pada orang yang rendah hati."
 },
 {
   "id": 16696,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 3,
   "firman": "Orang yang jujur dipimpin oleh ketulusannya, tetapi pengkhianat dirusak oleh kecurangannya."
 },
 {
   "id": 16697,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 4,
   "firman": "Pada hari kemurkaan harta tidak berguna, tetapi kebenaran melepaskan orang dari maut."
 },
 {
   "id": 16698,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 5,
   "firman": "Jalan orang saleh diratakan oleh kebenarannya, tetapi orang fasik jatuh karena kefasikannya."
 },
 {
   "id": 16699,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 6,
   "firman": "Orang yang jujur dilepaskan oleh kebenarannya, tetapi pengkhianat tertangkap oleh hawa nafsunya."
 },
 {
   "id": 16700,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 7,
   "firman": "Pengharapan orang fasik gagal pada kematiannya, dan harapan orang jahat menjadi sia-sia."
 },
 {
   "id": 16701,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 8,
   "firman": "Orang benar diselamatkan dari kesukaran, lalu orang fasik menggantikannya."
 },
 {
   "id": 16702,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dengan mulutnya orang fasik membinasakan sesama manusia, tetapi orang benar diselamatkan oleh pengetahuan."
 },
 {
   "id": 16703,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 10,
   "firman": "Bila orang benar mujur, beria-rialah kota, dan bila orang fasik binasa, gemuruhlah sorak-sorai."
 },
 {
   "id": 16704,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 11,
   "firman": "Berkat orang jujur memperkembangkan kota, tetapi mulut orang fasik meruntuhkannya."
 },
 {
   "id": 16705,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 12,
   "firman": "Siapa menghina sesamanya, tidak berakal budi, tetapi orang yang pandai, berdiam diri."
 },
 {
   "id": 16706,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 13,
   "firman": "Siapa mengumpat, membuka rahasia, tetapi siapa yang setia, menutupi perkara."
 },
 {
   "id": 16707,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 14,
   "firman": "Jikalau tidak ada pimpinan, jatuhlah bangsa, tetapi jikalau penasihat banyak, keselamatan ada."
 },
 {
   "id": 16708,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 15,
   "firman": "Sangat malanglah orang yang menanggung orang lain, tetapi siapa membenci pertanggungan, amanlah ia."
 },
 {
   "id": 16709,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 16,
   "firman": "Perempuan yang baik hati beroleh hormat; sedangkan seorang penindas beroleh kekayaan."
 },
 {
   "id": 16710,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 17,
   "firman": "Orang yang murah hati berbuat baik kepada diri sendiri, tetapi orang yang kejam menyiksa badannya sendiri."
 },
 {
   "id": 16711,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 18,
   "firman": "Orang fasik membuat laba yang sia-sia, tetapi siapa menabur kebenaran, mendapat pahala yang tetap."
 },
 {
   "id": 16712,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 19,
   "firman": "Siapa berpegang pada kebenaran yang sejati, menuju hidup, tetapi siapa mengejar kejahatan, menuju kematian."
 },
 {
   "id": 16713,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 20,
   "firman": "Orang yang serong hatinya adalah kekejian bagi TUHAN, tetapi orang yang tak bercela, jalannya dikenan-Nya."
 },
 {
   "id": 16714,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 21,
   "firman": "Sungguh, orang jahat tidak akan luput dari hukuman, tetapi keturunan orang benar akan diselamatkan."
 },
 {
   "id": 16715,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 22,
   "firman": "Seperti anting-anting emas di jungur babi, demikianlah perempuan cantik yang tidak susila."
 },
 {
   "id": 16716,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 23,
   "firman": "Keinginan orang benar mendatangkan bahagia semata-mata, harapan orang fasik mendatangkan murka."
 },
 {
   "id": 16717,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 24,
   "firman": "Ada yang menyebar harta, tetapi bertambah kaya, ada yang menghemat secara luar biasa, namun selalu berkekurangan."
 },
 {
   "id": 16718,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 25,
   "firman": "Siapa banyak memberi berkat, diberi kelimpahan, siapa memberi minum, ia sendiri akan diberi minum."
 },
 {
   "id": 16719,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 26,
   "firman": "Siapa menahan gandum, ia dikutuki orang, tetapi berkat turun di atas kepala orang yang menjual gandum."
 },
 {
   "id": 16720,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 27,
   "firman": "Siapa mengejar kebaikan, berusaha untuk dikenan orang, tetapi siapa mengejar kejahatan akan ditimpa kejahatan."
 },
 {
   "id": 16721,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 28,
   "firman": "Siapa mempercayakan diri kepada kekayaannya akan jatuh; tetapi orang benar akan tumbuh seperti daun muda."
 },
 {
   "id": 16722,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 29,
   "firman": "Siapa yang mengacaukan rumah tangganya akan menangkap angin; orang bodoh akan menjadi budak orang bijak."
 },
 {
   "id": 16723,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 30,
   "firman": "Hasil orang benar adalah pohon kehidupan, dan siapa bijak, mengambil hati orang."
 },
 {
   "id": 16724,
   "kitab": "Ams",
   "pasal": 11,
   "ayat": 31,
   "firman": "Kalau orang benar menerima balasan di atas bumi, lebih-lebih orang fasik dan orang berdosa!"
 },
 {
   "id": 16725,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 1,
   "firman": "Siapa mencintai didikan, mencintai pengetahuan; tetapi siapa membenci teguran, adalah dungu."
 },
 {
   "id": 16726,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 2,
   "firman": "Orang baik dikenan TUHAN, tetapi si penipu dihukum-Nya."
 },
 {
   "id": 16727,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 3,
   "firman": "Orang tidak akan tetap tegak karena kefasikan, tetapi akar orang benar tidak akan goncang."
 },
 {
   "id": 16728,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 4,
   "firman": "Isteri yang cakap adalah mahkota suaminya, tetapi yang membuat malu adalah seperti penyakit yang membusukkan tulang suaminya."
 },
 {
   "id": 16729,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 5,
   "firman": "Rancangan orang benar adalah adil, tujuan orang fasik memperdaya."
 },
 {
   "id": 16730,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 6,
   "firman": "Perkataan orang fasik menghadang darah, tetapi mulut orang jujur menyelamatkan orang."
 },
 {
   "id": 16731,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 7,
   "firman": "Orang fasik dijatuhkan sehingga mereka tidak ada lagi, tetapi rumah orang benar berdiri tetap."
 },
 {
   "id": 16732,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 8,
   "firman": "Setiap orang dipuji seimbang dengan akal budinya, tetapi orang yang serong hatinya, akan dihina."
 },
 {
   "id": 16733,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 9,
   "firman": "Lebih baik menjadi orang kecil, tetapi bekerja untuk diri sendiri, dari pada berlagak orang besar, tetapi kekurangan makan."
 },
 {
   "id": 16734,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 10,
   "firman": "Orang benar memperhatikan hidup hewannya, tetapi belas kasihan orang fasik itu kejam."
 },
 {
   "id": 16735,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 11,
   "firman": "Siapa mengerjakan tanahnya, akan kenyang dengan makanan, tetapi siapa mengejar barang yang sia-sia, tidak berakal budi."
 },
 {
   "id": 16736,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 12,
   "firman": "Orang fasik mengingini jala orang jahat, tetapi akar orang benar mendatangkan hasil."
 },
 {
   "id": 16737,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 13,
   "firman": "Orang jahat terjerat oleh pelanggaran bibirnya, tetapi orang benar dapat keluar dari kesukaran."
 },
 {
   "id": 16738,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 14,
   "firman": "Setiap orang dikenyangkan dengan kebaikan oleh karena buah perkataan, dan orang mendapat balasan dari pada yang dikerjakan tangannya."
 },
 {
   "id": 16739,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 15,
   "firman": "Jalan orang bodoh lurus dalam anggapannya sendiri, tetapi siapa mendengarkan nasihat, ia bijak."
 },
 {
   "id": 16740,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 16,
   "firman": "Bodohlah yang menyatakan sakit hatinya seketika itu juga, tetapi bijak, yang mengabaikan cemooh."
 },
 {
   "id": 16741,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 17,
   "firman": "Siapa mengatakan kebenaran, menyatakan apa yang adil, tetapi saksi dusta menyatakan tipu daya."
 },
 {
   "id": 16742,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 18,
   "firman": "Ada orang yang lancang mulutnya seperti tikaman pedang, tetapi lidah orang bijak mendatangkan kesembuhan."
 },
 {
   "id": 16743,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 19,
   "firman": "Bibir yang mengatakan kebenaran tetap untuk selama-lamanya, tetapi lidah dusta hanya untuk sekejap mata."
 },
 {
   "id": 16744,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 20,
   "firman": "Tipu daya ada di dalam hati orang yang merencanakan kejahatan, tetapi orang yang menasihatkan kesejahteraan mendapat sukacita."
 },
 {
   "id": 16745,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 21,
   "firman": "Orang benar tidak akan ditimpa oleh bencana apapun, tetapi orang fasik akan senantiasa celaka."
 },
 {
   "id": 16746,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 22,
   "firman": "Orang yang dusta bibirnya adalah kekejian bagi TUHAN, tetapi orang yang berlaku setia dikenan-Nya."
 },
 {
   "id": 16747,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 23,
   "firman": "Orang yang bijak menyembunyikan pengetahuannya, tetapi hati orang bebal menyeru-nyerukan kebodohan."
 },
 {
   "id": 16748,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 24,
   "firman": "Tangan orang rajin memegang kekuasaan, tetapi kemalasan mengakibatkan kerja paksa."
 },
 {
   "id": 16749,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 25,
   "firman": "Kekuatiran dalam hati membungkukkan orang, tetapi perkataan yang baik menggembirakan dia."
 },
 {
   "id": 16750,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 26,
   "firman": "Orang benar mendapati tempat penggembalaannya, tetapi jalan orang fasik menyesatkan mereka sendiri."
 },
 {
   "id": 16751,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 27,
   "firman": "Orang malas tidak akan menangkap buruannya, tetapi orang rajin akan memperoleh harta yang berharga."
 },
 {
   "id": 16752,
   "kitab": "Ams",
   "pasal": 12,
   "ayat": 28,
   "firman": "Di jalan kebenaran terdapat hidup, tetapi jalan kemurtadan menuju maut."
 },
 {
   "id": 16753,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 1,
   "firman": "Anak yang bijak mendengarkan didikan ayahnya, tetapi seorang pencemooh tidak mendengarkan hardikan."
 },
 {
   "id": 16754,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 2,
   "firman": "Dari buah mulutnya seseorang akan makan yang baik, tetapi nafsu seorang pengkhianat ialah melakukan kelaliman."
 },
 {
   "id": 16755,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 3,
   "firman": "Siapa menjaga mulutnya, memelihara nyawanya, siapa yang lebar bibir, akan ditimpa kebinasaan."
 },
 {
   "id": 16756,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 4,
   "firman": "Hati si pemalas penuh keinginan, tetapi sia-sia, sedangkan hati orang rajin diberi kelimpahan."
 },
 {
   "id": 16757,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 5,
   "firman": "Orang benar benci kepada dusta, tetapi orang fasik memalukan dan memburukkan diri."
 },
 {
   "id": 16758,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 6,
   "firman": "Kebenaran menjaga orang yang saleh jalannya, tetapi kefasikan mencelakakan orang berdosa."
 },
 {
   "id": 16759,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 7,
   "firman": "Ada orang yang berlagak kaya, tetapi tidak mempunyai apa-apa, ada pula yang berpura-pura miskin, tetapi hartanya banyak."
 },
 {
   "id": 16760,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 8,
   "firman": "Kekayaan adalah tebusan nyawa seseorang, tetapi orang miskin tidak akan mendengar ancaman."
 },
 {
   "id": 16761,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 9,
   "firman": "Terang orang benar bercahaya gemilang, sedangkan pelita orang fasik padam."
 },
 {
   "id": 16762,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 10,
   "firman": "Keangkuhan hanya menimbulkan pertengkaran, tetapi mereka yang mendengarkan nasihat mempunyai hikmat."
 },
 {
   "id": 16763,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 11,
   "firman": "Harta yang cepat diperoleh akan berkurang, tetapi siapa mengumpulkan sedikit demi sedikit, menjadi kaya."
 },
 {
   "id": 16764,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 12,
   "firman": "Harapan yang tertunda menyedihkan hati, tetapi keinginan yang terpenuhi adalah pohon kehidupan."
 },
 {
   "id": 16765,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 13,
   "firman": "Siapa meremehkan firman, ia akan menanggung akibatnya, tetapi siapa taat kepada perintah, akan menerima balasan."
 },
 {
   "id": 16766,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 14,
   "firman": "Ajaran orang bijak adalah sumber kehidupan, sehingga orang terhindar dari jerat-jerat maut."
 },
 {
   "id": 16767,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 15,
   "firman": "Akal budi yang baik mendatangkan karunia, tetapi jalan pengkhianat-pengkhianat mencelakakan mereka."
 },
 {
   "id": 16768,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 16,
   "firman": "Orang cerdik bertindak dengan pengetahuan, tetapi orang bebal membeberkan kebodohan."
 },
 {
   "id": 16769,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 17,
   "firman": "Utusan orang fasik menjerumuskan orang ke dalam celaka, tetapi duta yang setia mendatangkan kesembuhan."
 },
 {
   "id": 16770,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 18,
   "firman": "Kemiskinan dan cemooh menimpa orang yang mengabaikan didikan, tetapi siapa mengindahkan teguran, ia dihormati."
 },
 {
   "id": 16771,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 19,
   "firman": "Keinginan yang terlaksana menyenangkan hati, menghindari kejahatan adalah kekejian bagi orang bebal."
 },
 {
   "id": 16772,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 20,
   "firman": "Siapa bergaul dengan orang bijak menjadi bijak, tetapi siapa berteman dengan orang bebal menjadi malang."
 },
 {
   "id": 16773,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 21,
   "firman": "Orang berdosa dikejar oleh malapetaka, tetapi Ia membalas orang benar dengan kebahagiaan."
 },
 {
   "id": 16774,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 22,
   "firman": "Orang baik meninggalkan warisan bagi anak cucunya, tetapi kekayaan orang berdosa disimpan bagi orang benar."
 },
 {
   "id": 16775,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 23,
   "firman": "Huma orang miskin menghasilkan banyak makanan, tetapi ada yang lenyap karena tidak ada keadilan."
 },
 {
   "id": 16776,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 24,
   "firman": "Siapa tidak menggunakan tongkat, benci kepada anaknya; tetapi siapa mengasihi anaknya, menghajar dia pada waktunya."
 },
 {
   "id": 16777,
   "kitab": "Ams",
   "pasal": 13,
   "ayat": 25,
   "firman": "Orang benar makan sekenyang-kenyangnya, tetapi perut orang fasik menderita kekurangan."
 },
 {
   "id": 16778,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 1,
   "firman": "Perempuan yang bijak mendirikan rumahnya, tetapi yang bodoh meruntuhkannya dengan tangannya sendiri."
 },
 {
   "id": 16779,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 2,
   "firman": "Siapa berjalan dengan jujur, takut akan TUHAN, tetapi orang yang sesat jalannya, menghina Dia."
 },
 {
   "id": 16780,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 3,
   "firman": "Di dalam mulut orang bodoh ada rotan untuk punggungnya, tetapi orang bijak dipelihara oleh bibirnya."
 },
 {
   "id": 16781,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 4,
   "firman": "Kalau tidak ada lembu, juga tidak ada gandum, tetapi dengan kekuatan sapi banyaklah hasil."
 },
 {
   "id": 16782,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 5,
   "firman": "Saksi yang setia tidak berbohong, tetapi siapa menyembur-nyemburkan kebohongan, adalah saksi dusta."
 },
 {
   "id": 16783,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 6,
   "firman": "Si pencemooh mencari hikmat, tetapi sia-sia, sedangkan bagi orang berpengertian, pengetahuan mudah diperoleh."
 },
 {
   "id": 16784,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 7,
   "firman": "Jauhilah orang bebal, karena pengetahuan tidak kaudapati dari bibirnya."
 },
 {
   "id": 16785,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 8,
   "firman": "Mengerti jalannya sendiri adalah hikmat orang cerdik, tetapi orang bebal ditipu oleh kebodohannya."
 },
 {
   "id": 16786,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 9,
   "firman": "Orang bodoh mencemoohkan korban tebusan, tetapi orang jujur saling menunjukkan kebaikan."
 },
 {
   "id": 16787,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 10,
   "firman": "Hati mengenal kepedihannya sendiri, dan orang lain tidak dapat turut merasakan kesenangannya."
 },
 {
   "id": 16788,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 11,
   "firman": "Rumah orang fasik akan musnah, tetapi kemah orang jujur akan mekar."
 },
 {
   "id": 16789,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 12,
   "firman": "Ada jalan yang disangka orang lurus, tetapi ujungnya menuju maut."
 },
 {
   "id": 16790,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 13,
   "firman": "Di dalam tertawapun hati dapat merana, dan kesukaan dapat berakhir dengan kedukaan."
 },
 {
   "id": 16791,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 14,
   "firman": "Orang yang murtad hatinya menjadi kenyang dengan jalannya, dan orang yang baik dengan apa yang ada padanya."
 },
 {
   "id": 16792,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 15,
   "firman": "Orang yang tak berpengalaman percaya kepada setiap perkataan, tetapi orang yang bijak memperhatikan langkahnya."
 },
 {
   "id": 16793,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 16,
   "firman": "Orang bijak berhati-hati dan menjauhi kejahatan, tetapi orang bebal melampiaskan nafsunya dan merasa aman."
 },
 {
   "id": 16794,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 17,
   "firman": "Siapa lekas naik darah, berlaku bodoh, tetapi orang yang bijaksana, bersabar."
 },
 {
   "id": 16795,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 18,
   "firman": "Orang yang tak berpengalaman mendapat kebodohan, tetapi orang yang bijak bermahkotakan pengetahuan."
 },
 {
   "id": 16796,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 19,
   "firman": "Orang jahat tunduk di dekat orang baik, orang fasik di depan pintu gerbang orang benar."
 },
 {
   "id": 16797,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 20,
   "firman": "Juga oleh temannya orang miskin itu dibenci, tetapi sahabat orang kaya itu banyak."
 },
 {
   "id": 16798,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 21,
   "firman": "Siapa menghina sesamanya berbuat dosa, tetapi berbahagialah orang yang menaruh belas kasihan kepada orang yang menderita."
 },
 {
   "id": 16799,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 22,
   "firman": "Tidak sesatkah orang yang merencanakan kejahatan? Tetapi yang merencanakan hal yang baik memperoleh kasih dan setia."
 },
 {
   "id": 16800,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 23,
   "firman": "Dalam tiap jerih payah ada keuntungan, tetapi kata-kata belaka mendatangkan kekurangan saja."
 },
 {
   "id": 16801,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 24,
   "firman": "Mahkota orang bijak adalah kepintarannya; tajuk orang bebal adalah kebodohannya."
 },
 {
   "id": 16802,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 25,
   "firman": "Saksi yang setia menyelamatkan hidup, tetapi siapa menyembur-nyemburkan kebohongan adalah pengkhianat."
 },
 {
   "id": 16803,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 26,
   "firman": "Dalam takut akan TUHAN ada ketenteraman yang besar, bahkan ada perlindungan bagi anak-anak-Nya."
 },
 {
   "id": 16804,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 27,
   "firman": "Takut akan TUHAN adalah sumber kehidupan sehingga orang terhindar dari jerat maut."
 },
 {
   "id": 16805,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 28,
   "firman": "Dalam besarnya jumlah rakyat terletak kemegahan raja, tetapi tanpa rakyat runtuhlah pemerintah."
 },
 {
   "id": 16806,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 29,
   "firman": "Orang yang sabar besar pengertiannya, tetapi siapa cepat marah membesarkan kebodohan."
 },
 {
   "id": 16807,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 30,
   "firman": "Hati yang tenang menyegarkan tubuh, tetapi iri hati membusukkan tulang."
 },
 {
   "id": 16808,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 31,
   "firman": "Siapa menindas orang yang lemah, menghina Penciptanya, tetapi siapa menaruh belas kasihan kepada orang miskin, memuliakan Dia."
 },
 {
   "id": 16809,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 32,
   "firman": "Orang fasik dirobohkan karena kejahatannya, tetapi orang benar mendapat perlindungan karena ketulusannya."
 },
 {
   "id": 16810,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 33,
   "firman": "Hikmat tinggal di dalam hati orang yang berpengertian, tetapi tidak dikenal di dalam hati orang bebal."
 },
 {
   "id": 16811,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 34,
   "firman": "Kebenaran meninggikan derajat bangsa, tetapi dosa adalah noda bangsa."
 },
 {
   "id": 16812,
   "kitab": "Ams",
   "pasal": 14,
   "ayat": 35,
   "firman": "Raja berkenan kepada hamba yang berakal budi, tetapi kemarahannya menimpa orang yang membuat malu."
 },
 {
   "id": 16813,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 1,
   "firman": "Jawaban yang lemah lembut meredakan kegeraman, tetapi perkataan yang pedas membangkitkan marah."
 },
 {
   "id": 16814,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 2,
   "firman": "Lidah orang bijak mengeluarkan pengetahuan, tetapi mulut orang bebal mencurahkan kebodohan."
 },
 {
   "id": 16815,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 3,
   "firman": "Mata TUHAN ada di segala tempat, mengawasi orang jahat dan orang baik."
 },
 {
   "id": 16816,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 4,
   "firman": "Lidah lembut adalah pohon kehidupan, tetapi lidah curang melukai hati."
 },
 {
   "id": 16817,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 5,
   "firman": "Orang bodoh menolak didikan ayahnya, tetapi siapa mengindahkan teguran adalah bijak."
 },
 {
   "id": 16818,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 6,
   "firman": "Di rumah orang benar ada banyak harta benda, tetapi penghasilan orang fasik membawa kerusakan."
 },
 {
   "id": 16819,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 7,
   "firman": "Bibir orang bijak menaburkan pengetahuan, tetapi hati orang bebal tidak jujur."
 },
 {
   "id": 16820,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 8,
   "firman": "Korban orang fasik adalah kekejian bagi TUHAN, tetapi doa orang jujur dikenan-Nya."
 },
 {
   "id": 16821,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 9,
   "firman": "Jalan orang fasik adalah kekejian bagi TUHAN, tetapi siapa mengejar kebenaran, dikasihi-Nya."
 },
 {
   "id": 16822,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 10,
   "firman": "Didikan yang keras adalah bagi orang yang meninggalkan jalan yang benar, dan siapa benci kepada teguran akan mati."
 },
 {
   "id": 16823,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 11,
   "firman": "Dunia orang mati dan kebinasaan terbuka di hadapan TUHAN, lebih-lebih hati anak manusia!"
 },
 {
   "id": 16824,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 12,
   "firman": "Si pencemooh tidak suka ditegur orang; ia tidak mau pergi kepada orang bijak."
 },
 {
   "id": 16825,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 13,
   "firman": "Hati yang gembira membuat muka berseri-seri, tetapi kepedihan hati mematahkan semangat."
 },
 {
   "id": 16826,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 14,
   "firman": "Hati orang berpengertian mencari pengetahuan, tetapi mulut orang bebal sibuk dengan kebodohan."
 },
 {
   "id": 16827,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 15,
   "firman": "Hari orang berkesusahan buruk semuanya, tetapi orang yang gembira hatinya selalu berpesta."
 },
 {
   "id": 16828,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 16,
   "firman": "Lebih baik sedikit barang dengan disertai takut akan TUHAN dari pada banyak harta dengan disertai kecemasan."
 },
 {
   "id": 16829,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 17,
   "firman": "Lebih baik sepiring sayur dengan kasih dari pada lembu tambun dengan kebencian."
 },
 {
   "id": 16830,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 18,
   "firman": "Si pemarah membangkitkan pertengkaran, tetapi orang yang sabar memadamkan perbantahan."
 },
 {
   "id": 16831,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 19,
   "firman": "Jalan si pemalas seperti pagar duri, tetapi jalan orang jujur adalah rata."
 },
 {
   "id": 16832,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 20,
   "firman": "Anak yang bijak menggembirakan ayahnya, tetapi orang yang bebal menghina ibunya."
 },
 {
   "id": 16833,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 21,
   "firman": "Kebodohan adalah kesukaan bagi yang tidak berakal budi, tetapi orang yang pandai berjalan lurus."
 },
 {
   "id": 16834,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 22,
   "firman": "Rancangan gagal kalau tidak ada pertimbangan, tetapi terlaksana kalau penasihat banyak."
 },
 {
   "id": 16835,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 23,
   "firman": "Seseorang bersukacita karena jawaban yang diberikannya, dan alangkah baiknya perkataan yang tepat pada waktunya!"
 },
 {
   "id": 16836,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 24,
   "firman": "Jalan kehidupan orang berakal budi menuju ke atas, supaya ia menjauhi dunia orang mati di bawah."
 },
 {
   "id": 16837,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 25,
   "firman": "Rumah orang congkak dirombak TUHAN, tetapi batas tanah seorang janda dijadikan-Nya tetap."
 },
 {
   "id": 16838,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 26,
   "firman": "Rancangan orang jahat adalah kekejian bagi TUHAN, tetapi perkataan yang ramah itu suci."
 },
 {
   "id": 16839,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 27,
   "firman": "Siapa loba akan keuntungan gelap, mengacaukan rumah tangganya, tetapi siapa membenci suap akan hidup."
 },
 {
   "id": 16840,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 28,
   "firman": "Hati orang benar menimbang-nimbang jawabannya, tetapi mulut orang fasik mencurahkan hal-hal yang jahat."
 },
 {
   "id": 16841,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 29,
   "firman": "TUHAN itu jauh dari pada orang fasik, tetapi doa orang benar didengar-Nya."
 },
 {
   "id": 16842,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 30,
   "firman": "Mata yang bersinar-sinar menyukakan hati, dan kabar yang baik menyegarkan tulang."
 },
 {
   "id": 16843,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 31,
   "firman": "Orang yang mengarahkan telinga kepada teguran yang membawa kepada kehidupan akan tinggal di tengah-tengah orang bijak."
 },
 {
   "id": 16844,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 32,
   "firman": "Siapa mengabaikan didikan membuang dirinya sendiri, tetapi siapa mendengarkan teguran, memperoleh akal budi."
 },
 {
   "id": 16845,
   "kitab": "Ams",
   "pasal": 15,
   "ayat": 33,
   "firman": "Takut akan TUHAN adalah didikan yang mendatangkan hikmat, dan kerendahan hati mendahului kehormatan."
 },
 {
   "id": 16846,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 1,
   "firman": "Manusia dapat menimbang-nimbang dalam hati, tetapi jawaban lidah berasal dari pada TUHAN."
 },
 {
   "id": 16847,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 2,
   "firman": "Segala jalan orang adalah bersih menurut pandangannya sendiri, tetapi Tuhanlah yang menguji hati."
 },
 {
   "id": 16848,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 3,
   "firman": "Serahkanlah perbuatanmu kepada TUHAN, maka terlaksanalah segala rencanamu."
 },
 {
   "id": 16849,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 4,
   "firman": "TUHAN membuat segala sesuatu untuk tujuannya masing-masing, bahkan orang fasik dibuat-Nya untuk hari malapetaka."
 },
 {
   "id": 16850,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 5,
   "firman": "Setiap orang yang tinggi hati adalah kekejian bagi TUHAN; sungguh, ia tidak akan luput dari hukuman."
 },
 {
   "id": 16851,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 6,
   "firman": "Dengan kasih dan kesetiaan, kesalahan diampuni, karena takut akan TUHAN orang menjauhi kejahatan."
 },
 {
   "id": 16852,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 7,
   "firman": "Jikalau TUHAN berkenan kepada jalan seseorang, maka musuh orang itupun didamaikan-Nya dengan dia."
 },
 {
   "id": 16853,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lebih baik penghasilan sedikit disertai kebenaran, dari pada penghasilan banyak tanpa keadilan."
 },
 {
   "id": 16854,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 9,
   "firman": "Hati manusia memikir-mikirkan jalannya, tetapi Tuhanlah yang menentukan arah langkahnya."
 },
 {
   "id": 16855,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 10,
   "firman": "Keputusan dari Allah ada di bibir raja, kalau ia mengadili mulutnya tidak berbuat salah."
 },
 {
   "id": 16856,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 11,
   "firman": "Timbangan dan neraca yang betul adalah kepunyaan TUHAN, segala batu timbangan di dalam pundi-pundi adalah buatan-Nya."
 },
 {
   "id": 16857,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 12,
   "firman": "Melakukan kefasikan adalah kekejian bagi raja, karena takhta menjadi kokoh oleh kebenaran."
 },
 {
   "id": 16858,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 13,
   "firman": "Bibir yang benar dikenan raja, dan orang yang berbicara jujur dikasihi-Nya."
 },
 {
   "id": 16859,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 14,
   "firman": "Kegeraman raja adalah bentara maut, tetapi orang bijak memadamkannya."
 },
 {
   "id": 16860,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 15,
   "firman": "Wajah raja yang bercahaya memberi hidup dan kebaikannya seperti awan hujan musim semi."
 },
 {
   "id": 16861,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 16,
   "firman": "Memperoleh hikmat sungguh jauh melebihi memperoleh emas, dan mendapat pengertian jauh lebih berharga dari pada mendapat perak."
 },
 {
   "id": 16862,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 17,
   "firman": "Menjauhi kejahatan itulah jalan orang jujur; siapa menjaga jalannya, memelihara nyawanya."
 },
 {
   "id": 16863,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 18,
   "firman": "Kecongkakan mendahului kehancuran, dan tinggi hati mendahului kejatuhan."
 },
 {
   "id": 16864,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 19,
   "firman": "Lebih baik merendahkan diri dengan orang yang rendah hati dari pada membagi rampasan dengan orang congkak."
 },
 {
   "id": 16865,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 20,
   "firman": "Siapa memperhatikan firman akan mendapat kebaikan, dan berbahagialah orang yang percaya kepada TUHAN."
 },
 {
   "id": 16866,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 21,
   "firman": "Orang yang bijak hati disebut berpengertian, dan berbicara manis lebih dapat meyakinkan."
 },
 {
   "id": 16867,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 22,
   "firman": "Akal budi adalah sumber kehidupan bagi yang mempunyainya, tetapi siksaan bagi orang bodoh ialah kebodohannya."
 },
 {
   "id": 16868,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 23,
   "firman": "Hati orang bijak menjadikan mulutnya berakal budi, dan menjadikan bibirnya lebih dapat meyakinkan."
 },
 {
   "id": 16869,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 24,
   "firman": "Perkataan yang menyenangkan adalah seperti sarang madu, manis bagi hati dan obat bagi tulang-tulang."
 },
 {
   "id": 16870,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 25,
   "firman": "Ada jalan yang disangka lurus, tetapi ujungnya menuju maut."
 },
 {
   "id": 16871,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 26,
   "firman": "Rasa lapar bekerja untuk seorang pekerja, karena mulutnya memaksa dia."
 },
 {
   "id": 16872,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 27,
   "firman": "Orang yang tidak berguna menggali lobang kejahatan, dan pada bibirnya seolah-olah ada api yang menghanguskan."
 },
 {
   "id": 16873,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 28,
   "firman": "Orang yang curang menimbulkan pertengkaran, dan seorang pemfitnah menceraikan sahabat yang karib."
 },
 {
   "id": 16874,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 29,
   "firman": "Orang yang menggunakan kekerasan menyesatkan sesamanya, dan membawa dia di jalan yang tidak baik."
 },
 {
   "id": 16875,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 30,
   "firman": "Siapa memejamkan matanya, merencanakan tipu muslihat; siapa mengatupkan bibirnya, sudah melakukan kejahatan."
 },
 {
   "id": 16876,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 31,
   "firman": "Rambut putih adalah mahkota yang indah, yang didapat pada jalan kebenaran."
 },
 {
   "id": 16877,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 32,
   "firman": "Orang yang sabar melebihi seorang pahlawan, orang yang menguasai dirinya, melebihi orang yang merebut kota."
 },
 {
   "id": 16878,
   "kitab": "Ams",
   "pasal": 16,
   "ayat": 33,
   "firman": "Undi dibuang di pangkuan, tetapi setiap keputusannya berasal dari pada TUHAN."
 },
 {
   "id": 16879,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 1,
   "firman": "Lebih baik sekerat roti yang kering disertai dengan ketenteraman, dari pada makanan daging serumah disertai dengan perbantahan."
 },
 {
   "id": 16880,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 2,
   "firman": "Budak yang berakal budi akan berkuasa atas anak yang membuat malu, dan akan mendapat bagian warisan bersama-sama dengan saudara-saudara anak itu."
 },
 {
   "id": 16881,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 3,
   "firman": "Kui adalah untuk melebur perak dan perapian untuk melebur emas, tetapi Tuhanlah yang menguji hati."
 },
 {
   "id": 16882,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 4,
   "firman": "Orang yang berbuat jahat memperhatikan bibir jahat, seorang pendusta memberi telinga kepada lidah yang mencelakakan."
 },
 {
   "id": 16883,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 5,
   "firman": "Siapa mengolok-olok orang miskin menghina Penciptanya; siapa gembira karena suatu kecelakaan tidak akan luput dari hukuman."
 },
 {
   "id": 16884,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 6,
   "firman": "Mahkota orang-orang tua adalah anak cucu dan kehormatan anak-anak ialah nenek moyang mereka."
 },
 {
   "id": 16885,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 7,
   "firman": "Orang bebal tidak layak mengucapkan kata-kata yang bagus, apalagi orang mulia mengucapkan kata-kata dusta."
 },
 {
   "id": 16886,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 8,
   "firman": "Hadiah suapan adalah seperti mestika di mata yang memberinya, ke mana juga ia memalingkan muka, ia beruntung."
 },
 {
   "id": 16887,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 9,
   "firman": "Siapa menutupi pelanggaran, mengejar kasih, tetapi siapa membangkit-bangkit perkara, menceraikan sahabat yang karib."
 },
 {
   "id": 16888,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 10,
   "firman": "Suatu hardikan lebih masuk pada orang berpengertian dari pada seratus pukulan pada orang bebal."
 },
 {
   "id": 16889,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 11,
   "firman": "Orang durhaka hanya mencari kejahatan, tetapi terhadap dia akan disuruh utusan yang kejam."
 },
 {
   "id": 16890,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 12,
   "firman": "Lebih baik berjumpa dengan beruang betina yang kehilangan anak, dari pada dengan orang bebal dengan kebodohannya."
 },
 {
   "id": 16891,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 13,
   "firman": "Siapa membalas kebaikan dengan kejahatan, kejahatan tidak akan menghindar dari rumahnya."
 },
 {
   "id": 16892,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 14,
   "firman": "Memulai pertengkaran adalah seperti membuka jalan air; jadi undurlah sebelum perbantahan mulai."
 },
 {
   "id": 16893,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 15,
   "firman": "Membenarkan orang fasik dan mempersalahkan orang benar, kedua-duanya adalah kekejian bagi TUHAN."
 },
 {
   "id": 16894,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 16,
   "firman": "Apakah gunanya uang di tangan orang bebal untuk membeli hikmat, sedang ia tidak berakal budi?"
 },
 {
   "id": 16895,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 17,
   "firman": "Seorang sahabat menaruh kasih setiap waktu, dan menjadi seorang saudara dalam kesukaran."
 },
 {
   "id": 16896,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 18,
   "firman": "Orang yang tidak berakal budi ialah dia yang membuat persetujuan, yang menjadi penanggung bagi sesamanya."
 },
 {
   "id": 16897,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 19,
   "firman": "Siapa suka bertengkar, suka juga kepada pelanggaran, siapa memewahkan pintunya mencari kehancuran."
 },
 {
   "id": 16898,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 20,
   "firman": "Orang yang serong hatinya tidak akan mendapat bahagia, orang yang memutar-mutar lidahnya akan jatuh ke dalam celaka."
 },
 {
   "id": 16899,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 21,
   "firman": "Siapa mendapat anak yang bebal, mendapat duka, dan ayah orang bodoh tidak akan bersukacita."
 },
 {
   "id": 16900,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 22,
   "firman": "Hati yang gembira adalah obat yang manjur, tetapi semangat yang patah mengeringkan tulang."
 },
 {
   "id": 16901,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 23,
   "firman": "Orang fasik menerima hadiah suapan dari pundi-pundi untuk membelokkan jalan hukum."
 },
 {
   "id": 16902,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 24,
   "firman": "Pandangan orang berpengertian tertuju pada hikmat, tetapi mata orang bebal melayang sampai ke ujung bumi."
 },
 {
   "id": 16903,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 25,
   "firman": "Anak yang bebal menyakiti hati ayahnya, dan memedihkan hati ibunya."
 },
 {
   "id": 16904,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 26,
   "firman": "Mengenakan denda orang benar adalah salah, memukul orang muliapun tidak patut."
 },
 {
   "id": 16905,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 27,
   "firman": "Orang yang berpengetahuan menahan perkataannya, orang yang berpengertian berkepala dingin."
 },
 {
   "id": 16906,
   "kitab": "Ams",
   "pasal": 17,
   "ayat": 28,
   "firman": "Juga orang bodoh akan disangka bijak kalau ia berdiam diri dan disangka berpengertian kalau ia mengatupkan bibirnya."
 },
 {
   "id": 16907,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 1,
   "firman": "Orang yang menyendiri, mencari keinginannya, amarahnya meledak terhadap setiap pertimbangan."
 },
 {
   "id": 16908,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 2,
   "firman": "Orang bebal tidak suka kepada pengertian, hanya suka membeberkan isi hatinya."
 },
 {
   "id": 16909,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 3,
   "firman": "Bila kefasikan datang, datanglah juga penghinaan dan cela disertai cemooh."
 },
 {
   "id": 16910,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 4,
   "firman": "Perkataan mulut orang adalah seperti air yang dalam, tetapi sumber hikmat adalah seperti batang air yang mengalir."
 },
 {
   "id": 16911,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 5,
   "firman": "Tidak baik berpihak kepada orang fasik dengan menolak orang benar dalam pengadilan."
 },
 {
   "id": 16912,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 6,
   "firman": "Bibir orang bebal menimbulkan perbantahan, dan mulutnya berseru meminta pukulan."
 },
 {
   "id": 16913,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 7,
   "firman": "Orang bebal dibinasakan oleh mulutnya, bibirnya adalah jerat bagi nyawanya."
 },
 {
   "id": 16914,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 8,
   "firman": "Perkataan pemfitnah seperti sedap-sedapan, yang masuk ke lubuk hati."
 },
 {
   "id": 16915,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 9,
   "firman": "Orang yang bermalas-malas dalam pekerjaannya sudah menjadi saudara dari si perusak."
 },
 {
   "id": 16916,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 10,
   "firman": "Nama TUHAN adalah menara yang kuat, ke sanalah orang benar berlari dan ia menjadi selamat."
 },
 {
   "id": 16917,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 11,
   "firman": "Kota yang kuat bagi orang kaya ialah hartanya dan seperti tembok yang tinggi menurut anggapannya."
 },
 {
   "id": 16918,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 12,
   "firman": "Tinggi hati mendahului kehancuran, tetapi kerendahan hati mendahului kehormatan."
 },
 {
   "id": 16919,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 13,
   "firman": "Jikalau seseorang memberi jawab sebelum mendengar, itulah kebodohan dan kecelaannya."
 },
 {
   "id": 16920,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 14,
   "firman": "Orang yang bersemangat dapat menanggung penderitaannya, tetapi siapa akan memulihkan semangat yang patah?"
 },
 {
   "id": 16921,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 15,
   "firman": "Hati orang berpengertian memperoleh pengetahuan, dan telinga orang bijak menuntut pengetahuan."
 },
 {
   "id": 16922,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 16,
   "firman": "Hadiah memberi keluasan kepada orang, membawa dia menghadap orang-orang besar."
 },
 {
   "id": 16923,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 17,
   "firman": "Pembicara pertama dalam suatu pertikaian nampaknya benar, lalu datanglah orang lain dan menyelidiki perkaranya."
 },
 {
   "id": 16924,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 18,
   "firman": "Undian mengakhiri pertengkaran, dan menyelesaikan persoalan antara orang-orang berkuasa."
 },
 {
   "id": 16925,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 19,
   "firman": "Saudara yang dikhianati lebih sulit dihampiri dari pada kota yang kuat, dan pertengkaran adalah seperti palang gapura sebuah puri."
 },
 {
   "id": 16926,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 20,
   "firman": "Perut orang dikenyangkan oleh hasil mulutnya, ia dikenyangkan oleh hasil bibirnya."
 },
 {
   "id": 16927,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 21,
   "firman": "Hidup dan mati dikuasai lidah, siapa suka menggemakannya, akan memakan buahnya."
 },
 {
   "id": 16928,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 22,
   "firman": "Siapa mendapat isteri, mendapat sesuatu yang baik, dan ia dikenan TUHAN."
 },
 {
   "id": 16929,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 23,
   "firman": "Orang miskin berbicara dengan memohon-mohon, tetapi orang kaya menjawab dengan kasar."
 },
 {
   "id": 16930,
   "kitab": "Ams",
   "pasal": 18,
   "ayat": 24,
   "firman": "Ada teman yang mendatangkan kecelakaan, tetapi ada juga sahabat yang lebih karib dari pada seorang saudara."
 },
 {
   "id": 16931,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 1,
   "firman": "Lebih baik seorang miskin yang bersih kelakuannya dari pada seorang yang serong bibirnya lagi bebal."
 },
 {
   "id": 16932,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 2,
   "firman": "Tanpa pengetahuan kerajinanpun tidak baik; orang yang tergesa-gesa akan salah langkah."
 },
 {
   "id": 16933,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 3,
   "firman": "Kebodohan menyesatkan jalan orang, lalu gusarlah hatinya terhadap TUHAN."
 },
 {
   "id": 16934,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 4,
   "firman": "Kekayaan menambah banyak sahabat, tetapi orang miskin ditinggalkan sahabatnya."
 },
 {
   "id": 16935,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 5,
   "firman": "Saksi dusta tidak akan luput dari hukuman, orang yang menyembur-nyemburkan kebohongan tidak akan terhindar."
 },
 {
   "id": 16936,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 6,
   "firman": "Banyak orang yang mengambil hati orang dermawan, setiap orang bersahabat dengan si pemberi."
 },
 {
   "id": 16937,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 7,
   "firman": "Orang miskin dibenci oleh semua saudaranya, apalagi sahabat-sahabatnya, mereka menjauhi dia. Ia mengejar mereka, memanggil mereka tetapi mereka tidak ada lagi."
 },
 {
   "id": 16938,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 8,
   "firman": "Siapa memperoleh akal budi, mengasihi dirinya; siapa berpegang pada pengertian, mendapat kebahagiaan."
 },
 {
   "id": 16939,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 9,
   "firman": "Saksi dusta tidak akan luput dari hukuman, orang yang menyembur-nyemburkan kebohongan akan binasa."
 },
 {
   "id": 16940,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 10,
   "firman": "Kemewahan tidak layak bagi orang bebal, apalagi bagi seorang budak memerintah pembesar."
 },
 {
   "id": 16941,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 11,
   "firman": "Akal budi membuat seseorang panjang sabar dan orang itu dipuji karena memaafkan pelanggaran."
 },
 {
   "id": 16942,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 12,
   "firman": "Kemarahan raja adalah seperti raung singa muda, tetapi kebaikannya seperti embun yang turun ke atas rumput."
 },
 {
   "id": 16943,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 13,
   "firman": "Anak bebal adalah bencana bagi ayahnya, dan pertengkaran seorang isteri adalah seperti tiris yang tidak henti-hentinya menitik."
 },
 {
   "id": 16944,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 14,
   "firman": "Rumah dan harta adalah warisan nenek moyang, tetapi isteri yang berakal budi adalah karunia TUHAN."
 },
 {
   "id": 16945,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 15,
   "firman": "Kemalasan mendatangkan tidur nyenyak, dan orang yang lamban akan menderita lapar."
 },
 {
   "id": 16946,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 16,
   "firman": "Siapa berpegang pada perintah, memelihara nyawanya, tetapi siapa menghina firman, akan mati."
 },
 {
   "id": 16947,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 17,
   "firman": "Siapa menaruh belas kasihan kepada orang yang lemah, memiutangi TUHAN, yang akan membalas perbuatannya itu."
 },
 {
   "id": 16948,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 18,
   "firman": "Hajarlah anakmu selama ada harapan, tetapi jangan engkau menginginkan kematiannya."
 },
 {
   "id": 16949,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 19,
   "firman": "Orang yang sangat cepat marah akan kena denda, karena jika engkau hendak menolongnya, engkau hanya menambah marahnya."
 },
 {
   "id": 16950,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 20,
   "firman": "Dengarkanlah nasihat dan terimalah didikan, supaya engkau menjadi bijak di masa depan."
 },
 {
   "id": 16951,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 21,
   "firman": "Banyaklah rancangan di hati manusia, tetapi keputusan Tuhanlah yang terlaksana."
 },
 {
   "id": 16952,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 22,
   "firman": "Sifat yang diinginkan pada seseorang ialah kesetiaannya; lebih baik orang miskin dari pada seorang pembohong."
 },
 {
   "id": 16953,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 23,
   "firman": "Takut akan Allah mendatangkan hidup, maka orang bermalam dengan puas, tanpa ditimpa malapetaka."
 },
 {
   "id": 16954,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 24,
   "firman": "Si pemalas mencelup tangannya ke dalam pinggan, tetapi tidak juga mengembalikannya ke mulut."
 },
 {
   "id": 16955,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 25,
   "firman": "Jikalau si pencemooh kaupukul, barulah orang yang tak berpengalaman menjadi bijak, jikalau orang yang berpengertian ditegur, ia menjadi insaf."
 },
 {
   "id": 16956,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 26,
   "firman": "Anak yang menganiaya ayahnya atau mengusir ibunya, memburukkan dan memalukan diri."
 },
 {
   "id": 16957,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 27,
   "firman": "Hai anakku, jangan lagi mendengarkan didikan, kalau engkau menyimpang juga dari perkataan-perkataan yang memberi pengetahuan."
 },
 {
   "id": 16958,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 28,
   "firman": "Saksi yang tidak berguna mencemoohkan hukum dan mulut orang fasik menelan dusta."
 },
 {
   "id": 16959,
   "kitab": "Ams",
   "pasal": 19,
   "ayat": 29,
   "firman": "Hukuman bagi si pencemooh tersedia dan pukulan bagi punggung orang bebal."
 },
 {
   "id": 16960,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 1,
   "firman": "Anggur adalah pencemooh, minuman keras adalah peribut, tidaklah bijak orang yang terhuyung-huyung karenanya."
 },
 {
   "id": 16961,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 2,
   "firman": "Kegentaran yang datang dari raja adalah seperti raung singa muda, siapa membangkitkan marahnya membahayakan dirinya."
 },
 {
   "id": 16962,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 3,
   "firman": "Terhormatlah seseorang, jika ia menjauhi perbantahan, tetapi setiap orang bodoh membiarkan amarahnya meledak."
 },
 {
   "id": 16963,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 4,
   "firman": "Pada musim dingin si pemalas tidak membajak; jikalau ia mencari pada musim menuai, maka tidak ada apa-apa."
 },
 {
   "id": 16964,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 5,
   "firman": "Rancangan di dalam hati manusia itu seperti air yang dalam, tetapi orang yang pandai tahu menimbanya."
 },
 {
   "id": 16965,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 6,
   "firman": "Banyak orang menyebut diri baik hati, tetapi orang yang setia, siapakah menemukannya?"
 },
 {
   "id": 16966,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 7,
   "firman": "Orang benar yang bersih kelakuannya--berbahagialah keturunannya."
 },
 {
   "id": 16967,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 8,
   "firman": "Raja yang bersemayam di atas kursi pengadilan dapat mengetahui segala yang jahat dengan matanya."
 },
 {
   "id": 16968,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 9,
   "firman": "Siapakah dapat berkata: \"Aku telah membersihkan hatiku, aku tahir dari pada dosaku?\""
 },
 {
   "id": 16969,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 10,
   "firman": "Dua macam batu timbangan, dua macam takaran, kedua-duanya adalah kekejian bagi TUHAN."
 },
 {
   "id": 16970,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 11,
   "firman": "Anak-anakpun sudah dapat dikenal dari pada perbuatannya, apakah bersih dan jujur kelakuannya."
 },
 {
   "id": 16971,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 12,
   "firman": "Telinga yang mendengar dan mata yang melihat, kedua-duanya dibuat oleh TUHAN."
 },
 {
   "id": 16972,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 13,
   "firman": "Janganlah menyukai tidur, supaya engkau tidak jatuh miskin, bukalah matamu dan engkau akan makan sampai kenyang."
 },
 {
   "id": 16973,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 14,
   "firman": "\"Tidak baik! Tidak baik!\", kata si pembeli, tetapi begitu ia pergi, ia memuji dirinya."
 },
 {
   "id": 16974,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 15,
   "firman": "Sekalipun ada emas dan permata banyak, tetapi yang paling berharga ialah bibir yang berpengetahuan."
 },
 {
   "id": 16975,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 16,
   "firman": "Ambillah pakaian orang yang menanggung orang lain, dan tahanlah dia sebagai sandera ganti orang asing."
 },
 {
   "id": 16976,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 17,
   "firman": "Roti hasil tipuan sedap rasanya, tetapi kemudian mulutnya penuh dengan kerikil."
 },
 {
   "id": 16977,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 18,
   "firman": "Rancangan terlaksana oleh pertimbangan, sebab itu berperanglah dengan siasat."
 },
 {
   "id": 16978,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 19,
   "firman": "Siapa mengumpat, membuka rahasia, sebab itu janganlah engkau bergaul dengan orang yang bocor mulut."
 },
 {
   "id": 16979,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 20,
   "firman": "Siapa mengutuki ayah atau ibunya, pelitanya akan padam pada waktu gelap."
 },
 {
   "id": 16980,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 21,
   "firman": "Milik yang diperoleh dengan cepat pada mulanya, akhirnya tidak diberkati."
 },
 {
   "id": 16981,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 22,
   "firman": "Janganlah engkau berkata: \"Aku akan membalas kejahatan,\" nantikanlah TUHAN, Ia akan menyelamatkan engkau."
 },
 {
   "id": 16982,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 23,
   "firman": "Dua macam batu timbangan adalah kekejian bagi TUHAN, dan neraca serong itu tidak baik."
 },
 {
   "id": 16983,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 24,
   "firman": "Langkah orang ditentukan oleh TUHAN, tetapi bagaimanakah manusia dapat mengerti jalan hidupnya?"
 },
 {
   "id": 16984,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 25,
   "firman": "Suatu jerat bagi manusia ialah kalau ia tanpa berpikir mengatakan \"Kudus\", dan baru menimbang-nimbang sesudah bernazar."
 },
 {
   "id": 16985,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 26,
   "firman": "Raja yang bijak dapat mengenal orang-orang fasik, dan menggilas mereka berulang-ulang."
 },
 {
   "id": 16986,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 27,
   "firman": "Roh manusia adalah pelita TUHAN, yang menyelidiki seluruh lubuk hatinya."
 },
 {
   "id": 16987,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 28,
   "firman": "Kasih dan setia melindungi raja, dan dengan kasih ia menopang takhtanya."
 },
 {
   "id": 16988,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 29,
   "firman": "Hiasan orang muda ialah kekuatannya, dan keindahan orang tua ialah uban."
 },
 {
   "id": 16989,
   "kitab": "Ams",
   "pasal": 20,
   "ayat": 30,
   "firman": "Bilur-bilur yang berdarah membersihkan kejahatan, dan pukulan membersihkan lubuk hati."
 },
 {
   "id": 16990,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 1,
   "firman": "Hati raja seperti batang air di dalam tangan TUHAN, dialirkan-Nya ke mana Ia ingini."
 },
 {
   "id": 16991,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 2,
   "firman": "Setiap jalan orang adalah lurus menurut pandangannya sendiri, tetapi Tuhanlah yang menguji hati."
 },
 {
   "id": 16992,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 3,
   "firman": "Melakukan kebenaran dan keadilan lebih dikenan TUHAN dari pada korban."
 },
 {
   "id": 16993,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 4,
   "firman": "Mata yang congkak dan hati yang sombong, yang menjadi pelita orang fasik, adalah dosa."
 },
 {
   "id": 16994,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 5,
   "firman": "Rancangan orang rajin semata-mata mendatangkan kelimpahan, tetapi setiap orang yang tergesa-gesa hanya akan mengalami kekurangan."
 },
 {
   "id": 16995,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 6,
   "firman": "Memperoleh harta benda dengan lidah dusta adalah kesia-siaan yang lenyap dari orang yang mencari maut."
 },
 {
   "id": 16996,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 7,
   "firman": "Orang fasik diseret oleh penganiayaan mereka, karena mereka menolak melakukan keadilan."
 },
 {
   "id": 16997,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 8,
   "firman": "Berliku-liku jalan si penipu, tetapi orang yang jujur lurus perbuatannya."
 },
 {
   "id": 16998,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 9,
   "firman": "Lebih baik tinggal pada sudut sotoh rumah dari pada diam serumah dengan perempuan yang suka bertengkar."
 },
 {
   "id": 16999,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 10,
   "firman": "Hati orang fasik mengingini kejahatan dan ia tidak menaruh belas kasihan kepada sesamanya."
 },
 {
   "id": 17000,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 11,
   "firman": "Jikalau si pencemooh dihukum, orang yang tak berpengalaman menjadi bijak, dan jikalau orang bijak diberi pengajaran, ia akan beroleh pengetahuan."
 },
 {
   "id": 17001,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 12,
   "firman": "Yang Mahaadil memperhatikan rumah orang fasik, dan menjerumuskan orang fasik ke dalam kecelakaan."
 },
 {
   "id": 17002,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 13,
   "firman": "Siapa menutup telinganya bagi jeritan orang lemah, tidak akan menerima jawaban, kalau ia sendiri berseru-seru."
 },
 {
   "id": 17003,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 14,
   "firman": "Pemberian dengan sembunyi-sembunyi memadamkan marah, dan hadiah yang dirahasiakan meredakan kegeraman yang hebat."
 },
 {
   "id": 17004,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 15,
   "firman": "Melakukan keadilan adalah kesukaan bagi orang benar, tetapi menakutkan orang yang berbuat jahat."
 },
 {
   "id": 17005,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 16,
   "firman": "Orang yang menyimpang dari jalan akal budi akan berhenti di tempat arwah-arwah berkumpul."
 },
 {
   "id": 17006,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 17,
   "firman": "Orang yang suka bersenang-senang akan berkekurangan, orang yang gemar kepada minyak dan anggur tidak akan menjadi kaya."
 },
 {
   "id": 17007,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 18,
   "firman": "Orang fasik dipakai sebagai tebusan bagi orang benar, dan pengkhianat sebagai ganti orang jujur."
 },
 {
   "id": 17008,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 19,
   "firman": "Lebih baik tinggal di padang gurun dari pada tinggal dengan perempuan yang suka bertengkar dan pemarah."
 },
 {
   "id": 17009,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 20,
   "firman": "Harta yang indah dan minyak ada di kediaman orang bijak, tetapi orang yang bebal memboroskannya."
 },
 {
   "id": 17010,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 21,
   "firman": "Siapa mengejar kebenaran dan kasih akan memperoleh kehidupan, kebenaran dan kehormatan."
 },
 {
   "id": 17011,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 22,
   "firman": "Orang bijak dapat memanjat kota pahlawan-pahlawan, dan merobohkan benteng yang mereka percayai."
 },
 {
   "id": 17012,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 23,
   "firman": "Siapa memelihara mulut dan lidahnya, memelihara diri dari pada kesukaran."
 },
 {
   "id": 17013,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 24,
   "firman": "Orang yang kurang ajar dan sombong pencemooh namanya, ia berlaku dengan keangkuhan yang tak terhingga."
 },
 {
   "id": 17014,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 25,
   "firman": "Si pemalas dibunuh oleh keinginannya, karena tangannya enggan bekerja."
 },
 {
   "id": 17015,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 26,
   "firman": "Keinginan bernafsu sepanjang hari, tetapi orang benar memberi tanpa batas."
 },
 {
   "id": 17016,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 27,
   "firman": "Korban orang fasik adalah kekejian, lebih-lebih kalau dipersembahkan dengan maksud jahat."
 },
 {
   "id": 17017,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 28,
   "firman": "Saksi bohong akan binasa, tetapi orang yang mendengarkan akan tetap berbicara."
 },
 {
   "id": 17018,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 29,
   "firman": "Orang fasik bermuka tebal, tetapi orang jujur mengatur jalannya."
 },
 {
   "id": 17019,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 30,
   "firman": "Tidak ada hikmat dan pengertian, dan tidak ada pertimbangan yang dapat menandingi TUHAN."
 },
 {
   "id": 17020,
   "kitab": "Ams",
   "pasal": 21,
   "ayat": 31,
   "firman": "Kuda diperlengkapi untuk hari peperangan, tetapi kemenangan ada di tangan TUHAN."
 },
 {
   "id": 17021,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 1,
   "firman": "Nama baik lebih berharga dari pada kekayaan besar, dikasihi orang lebih baik dari pada perak dan emas."
 },
 {
   "id": 17022,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 2,
   "firman": "Orang kaya dan orang miskin bertemu; yang membuat mereka semua ialah TUHAN."
 },
 {
   "id": 17023,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 3,
   "firman": "Kalau orang bijak melihat malapetaka, bersembunyilah ia, tetapi orang yang tak berpengalaman berjalan terus, lalu kena celaka."
 },
 {
   "id": 17024,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 4,
   "firman": "Ganjaran kerendahan hati dan takut akan TUHAN adalah kekayaan, kehormatan dan kehidupan."
 },
 {
   "id": 17025,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 5,
   "firman": "Duri dan perangkap ada di jalan orang yang serong hatinya; siapa ingin memelihara diri menjauhi orang itu."
 },
 {
   "id": 17026,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 6,
   "firman": "Didiklah orang muda menurut jalan yang patut baginya, maka pada masa tuanyapun ia tidak akan menyimpang dari pada jalan itu."
 },
 {
   "id": 17027,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 7,
   "firman": "Orang kaya menguasai orang miskin, yang berhutang menjadi budak dari yang menghutangi."
 },
 {
   "id": 17028,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 8,
   "firman": "Orang yang menabur kecurangan akan menuai bencana, dan tongkat amarahnya akan habis binasa."
 },
 {
   "id": 17029,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 9,
   "firman": "Orang yang baik hati akan diberkati, karena ia membagi rezekinya dengan si miskin."
 },
 {
   "id": 17030,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 10,
   "firman": "Usirlah si pencemooh, maka lenyaplah pertengkaran, dan akan berhentilah perbantahan dan cemooh."
 },
 {
   "id": 17031,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 11,
   "firman": "Orang yang mencintai kesucian hati dan yang manis bicaranya menjadi sahabat raja."
 },
 {
   "id": 17032,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 12,
   "firman": "Mata TUHAN menjaga pengetahuan, tetapi Ia membatalkan perkataan si pengkhianat."
 },
 {
   "id": 17033,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 13,
   "firman": "Si pemalas berkata: \"Ada singa di luar, aku akan dibunuh di tengah jalan.\""
 },
 {
   "id": 17034,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 14,
   "firman": "Mulut perempuan jalang adalah lobang yang dalam; orang yang dimurkai TUHAN akan terperosok ke dalamnya."
 },
 {
   "id": 17035,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 15,
   "firman": "Kebodohan melekat pada hati orang muda, tetapi tongkat didikan akan mengusir itu dari padanya."
 },
 {
   "id": 17036,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 16,
   "firman": "Orang yang menindas orang lemah untuk menguntungkan diri atau memberi hadiah kepada orang kaya, hanya merugikan diri saja."
 },
 {
   "id": 17037,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 17,
   "firman": "Pasanglah telingamu dan dengarkanlah amsal-amsal orang bijak, berilah perhatian kepada pengetahuanku."
 },
 {
   "id": 17038,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 18,
   "firman": "Karena menyimpannya dalam hati akan menyenangkan bagimu, bila semuanya itu tersedia pada bibirmu."
 },
 {
   "id": 17039,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 19,
   "firman": "Supaya engkau menaruh kepercayaanmu kepada TUHAN, aku mengajarkannya kepadamu sekarang, ya kepadamu."
 },
 {
   "id": 17040,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 20,
   "firman": "Bukankah aku telah menulisnya kepadamu dulu dengan nasihat dan pengetahuan,"
 },
 {
   "id": 17041,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 21,
   "firman": "untuk mengajarkan kepadamu apa yang benar dan sungguh, supaya engkau dapat memberikan jawaban yang tepat kepada yang menyuruh engkau."
 },
 {
   "id": 17042,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 22,
   "firman": "Janganlah merampasi orang lemah, karena ia lemah, dan janganlah menginjak-injak orang yang berkesusahan di pintu gerbang."
 },
 {
   "id": 17043,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 23,
   "firman": "Sebab TUHAN membela perkara mereka, dan mengambil nyawa orang yang merampasi mereka."
 },
 {
   "id": 17044,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 24,
   "firman": "Jangan berteman dengan orang yang lekas gusar, jangan bergaul dengan seorang pemarah,"
 },
 {
   "id": 17045,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 25,
   "firman": "supaya engkau jangan menjadi biasa dengan tingkah lakunya dan memasang jerat bagi dirimu sendiri."
 },
 {
   "id": 17046,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 26,
   "firman": "Jangan engkau termasuk orang yang membuat persetujuan, dan yang menjadi penanggung hutang."
 },
 {
   "id": 17047,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 27,
   "firman": "Mengapa orang akan mengambil tempat tidurmu dari bawahmu, bila engkau tidak mempunyai apa-apa untuk membayar kembali?"
 },
 {
   "id": 17048,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 28,
   "firman": "Jangan engkau memindahkan batas tanah yang lama, yang ditetapkan oleh nenek moyangmu."
 },
 {
   "id": 17049,
   "kitab": "Ams",
   "pasal": 22,
   "ayat": 29,
   "firman": "Pernahkah engkau melihat orang yang cakap dalam pekerjaannya? Di hadapan raja-raja ia akan berdiri, bukan di hadapan orang-orang yang hina."
 },
 {
   "id": 17050,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 1,
   "firman": "Bila engkau duduk makan dengan seorang pembesar, perhatikanlah baik-baik apa yang ada di depanmu."
 },
 {
   "id": 17051,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 2,
   "firman": "Taruhlah sebuah pisau pada lehermu, bila besar nafsumu!"
 },
 {
   "id": 17052,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 3,
   "firman": "Jangan ingin akan makanannya yang lezat, itu adalah hidangan yang menipu."
 },
 {
   "id": 17053,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 4,
   "firman": "Jangan bersusah payah untuk menjadi kaya, tinggalkan niatmu ini."
 },
 {
   "id": 17054,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 5,
   "firman": "Kalau engkau mengamat-amatinya, lenyaplah ia, karena tiba-tiba ia bersayap, lalu terbang ke angkasa seperti rajawali."
 },
 {
   "id": 17055,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 6,
   "firman": "Jangan makan roti orang yang kikir, jangan ingin akan makanannya yang lezat."
 },
 {
   "id": 17056,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 7,
   "firman": "Sebab seperti orang yang membuat perhitungan dalam dirinya sendiri demikianlah ia. \"Silakan makan dan minum,\" katanya kepadamu, tetapi ia tidak tulus hati terhadapmu."
 },
 {
   "id": 17057,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 8,
   "firman": "Suap yang telah kaumakan, kau akan muntahkan, dan kata-katamu yang manis kausia-siakan."
 },
 {
   "id": 17058,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 9,
   "firman": "Jangan berbicara di telinga orang bebal, sebab ia akan meremehkan kata-katamu yang bijak."
 },
 {
   "id": 17059,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 10,
   "firman": "Jangan engkau memindahkan batas tanah yang lama, dan memasuki ladang anak-anak yatim."
 },
 {
   "id": 17060,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 11,
   "firman": "Karena penebus mereka kuat, Dialah yang membela perkara mereka melawan engkau."
 },
 {
   "id": 17061,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 12,
   "firman": "Arahkanlah perhatianmu kepada didikan, dan telingamu kepada kata-kata pengetahuan."
 },
 {
   "id": 17062,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 13,
   "firman": "Jangan menolak didikan dari anakmu ia tidak akan mati kalau engkau memukulnya dengan rotan."
 },
 {
   "id": 17063,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 14,
   "firman": "Engkau memukulnya dengan rotan, tetapi engkau menyelamatkan nyawanya dari dunia orang mati."
 },
 {
   "id": 17064,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 15,
   "firman": "Hai anakku, jika hatimu bijak, hatiku juga bersukacita."
 },
 {
   "id": 17065,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 16,
   "firman": "Jiwaku bersukaria, kalau bibirmu mengatakan yang jujur."
 },
 {
   "id": 17066,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 17,
   "firman": "Janganlah hatimu iri kepada orang-orang yang berdosa, tetapi takutlah akan TUHAN senantiasa."
 },
 {
   "id": 17067,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 18,
   "firman": "Karena masa depan sungguh ada, dan harapanmu tidak akan hilang."
 },
 {
   "id": 17068,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 19,
   "firman": "Hai anakku, dengarkanlah, dan jadilah bijak, tujukanlah hatimu ke jalan yang benar."
 },
 {
   "id": 17069,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 20,
   "firman": "Janganlah engkau ada di antara peminum anggur dan pelahap daging."
 },
 {
   "id": 17070,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 21,
   "firman": "Karena si peminum dan si pelahap menjadi miskin, dan kantuk membuat orang berpakaian compang-camping."
 },
 {
   "id": 17071,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 22,
   "firman": "Dengarkanlah ayahmu yang memperanakkan engkau, dan janganlah menghina ibumu kalau ia sudah tua."
 },
 {
   "id": 17072,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 23,
   "firman": "Belilah kebenaran dan jangan menjualnya; demikian juga dengan hikmat, didikan dan pengertian."
 },
 {
   "id": 17073,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 24,
   "firman": "Ayah seorang yang benar akan bersorak-sorak; yang memperanakkan orang-orang yang bijak akan bersukacita karena dia."
 },
 {
   "id": 17074,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 25,
   "firman": "Biarlah ayahmu dan ibumu bersukacita, biarlah beria-ria dia yang melahirkan engkau."
 },
 {
   "id": 17075,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 26,
   "firman": "Hai anakku, berikanlah hatimu kepadaku, biarlah matamu senang dengan jalan-jalanku."
 },
 {
   "id": 17076,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 27,
   "firman": "Karena perempuan jalang adalah lobang yang dalam, dan perempuan asing adalah sumur yang sempit."
 },
 {
   "id": 17077,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 28,
   "firman": "Bahkan, seperti penyamun ia menghadang, dan memperbanyak pengkhianat di antara manusia."
 },
 {
   "id": 17078,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 29,
   "firman": "Siapa mengaduh? Siapa mengeluh? Siapa bertengkar? Siapa berkeluh kesah? Siapa mendapat cidera tanpa sebab? Siapa merah matanya?"
 },
 {
   "id": 17079,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 30,
   "firman": "Yakni mereka yang duduk dengan anggur sampai jauh malam, mereka yang datang mengecap anggur campuran."
 },
 {
   "id": 17080,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 31,
   "firman": "Jangan melihat kepada anggur, kalau merah menarik warnanya, dan mengilau dalam cawan, yang mengalir masuk dengan nikmat,"
 },
 {
   "id": 17081,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 32,
   "firman": "tetapi kemudian memagut seperti ular, dan menyemburkan bisa seperti beludak."
 },
 {
   "id": 17082,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 33,
   "firman": "Lalu matamu akan melihat hal-hal yang aneh, dan hatimu mengucapkan kata-kata yang kacau."
 },
 {
   "id": 17083,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 34,
   "firman": "Engkau seperti orang di tengah ombak laut, seperti orang di atas tiang kapal."
 },
 {
   "id": 17084,
   "kitab": "Ams",
   "pasal": 23,
   "ayat": 35,
   "firman": "Engkau akan berkata: \"Orang memukul aku, tetapi aku tidak merasa sakit. Orang memalu aku, tetapi tidak kurasa. Bilakah aku siuman? Aku akan mencari anggur lagi.\""
 },
 {
   "id": 17085,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 1,
   "firman": "Jangan iri kepada orang jahat, jangan ingin bergaul dengan mereka."
 },
 {
   "id": 17086,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 2,
   "firman": "Karena hati mereka memikirkan penindasan dan bibir mereka membicarakan bencana."
 },
 {
   "id": 17087,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 3,
   "firman": "Dengan hikmat rumah didirikan, dengan kepandaian itu ditegakkan,"
 },
 {
   "id": 17088,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 4,
   "firman": "dan dengan pengertian kamar-kamar diisi dengan bermacam-macam harta benda yang berharga dan menarik."
 },
 {
   "id": 17089,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 5,
   "firman": "Orang yang bijak lebih berwibawa dari pada orang kuat, juga orang yang berpengetahuan dari pada orang yang tegap kuat."
 },
 {
   "id": 17090,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 6,
   "firman": "Karena hanya dengan perencanaan engkau dapat berperang, dan kemenangan tergantung pada penasihat yang banyak."
 },
 {
   "id": 17091,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 7,
   "firman": "Hikmat terlalu tinggi bagi orang bodoh; ia tidak membuka mulutnya di pintu gerbang."
 },
 {
   "id": 17092,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 8,
   "firman": "Siapa selalu merencanakan kejahatan akan disebut penipu."
 },
 {
   "id": 17093,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 9,
   "firman": "Memikirkan kebodohan mendatangkan dosa, dan si pencemooh adalah kekejian bagi manusia."
 },
 {
   "id": 17094,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 10,
   "firman": "Jika engkau tawar hati pada masa kesesakan, kecillah kekuatanmu."
 },
 {
   "id": 17095,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 11,
   "firman": "Bebaskan mereka yang diangkut untuk dibunuh, selamatkan orang yang terhuyung-huyung menuju tempat pemancungan."
 },
 {
   "id": 17096,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 12,
   "firman": "Kalau engkau berkata: \"Sungguh, kami tidak tahu hal itu!\" Apakah Dia yang menguji hati tidak tahu yang sebenarnya? Apakah Dia yang menjaga jiwamu tidak mengetahuinya, dan membalas manusia menurut perbuatannya?"
 },
 {
   "id": 17097,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 13,
   "firman": "Anakku, makanlah madu, sebab itu baik; dan tetesan madu manis untuk langit-langit mulutmu."
 },
 {
   "id": 17098,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 14,
   "firman": "Ketahuilah, demikian hikmat untuk jiwamu: Jika engkau mendapatnya, maka ada masa depan, dan harapanmu tidak akan hilang."
 },
 {
   "id": 17099,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 15,
   "firman": "Jangan mengintai kediaman orang benar seperti orang fasik, jangan merusak rumahnya."
 },
 {
   "id": 17100,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 16,
   "firman": "Sebab tujuh kali orang benar jatuh, namun ia bangun kembali, tetapi orang fasik akan roboh dalam bencana."
 },
 {
   "id": 17101,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 17,
   "firman": "Jangan bersukacita kalau musuhmu jatuh, jangan hatimu beria-ria kalau ia terperosok,"
 },
 {
   "id": 17102,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 18,
   "firman": "supaya TUHAN tidak melihatnya dan menganggapnya jahat, lalu memalingkan murkanya dari pada orang itu."
 },
 {
   "id": 17103,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 19,
   "firman": "Jangan menjadi marah karena orang yang berbuat jahat, jangan iri kepada orang fasik."
 },
 {
   "id": 17104,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 20,
   "firman": "Karena tidak ada masa depan bagi penjahat, pelita orang fasik akan padam."
 },
 {
   "id": 17105,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 21,
   "firman": "Hai anakku, takutilah TUHAN dan raja; jangan melawan terhadap kedua-duanya."
 },
 {
   "id": 17106,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 22,
   "firman": "Karena dengan tiba-tiba mereka menimbulkan bencana, dan siapa mengetahui kehancuran yang didatangkan mereka?"
 },
 {
   "id": 17107,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 23,
   "firman": "Juga ini adalah amsal-amsal dari orang bijak. Memandang bulu dalam pengadilan tidaklah baik."
 },
 {
   "id": 17108,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 24,
   "firman": "Siapa berkata kepada orang fasik: \"Engkau tidak bersalah\", akan dikutuki bangsa-bangsa, dilaknatkan suku-suku bangsa."
 },
 {
   "id": 17109,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 25,
   "firman": "Tetapi mereka yang memberi peringatan akan berbahagia, mereka akan mendapat ganjaran berkat."
 },
 {
   "id": 17110,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 26,
   "firman": "Siapa memberi jawaban yang tepat mengecup bibir."
 },
 {
   "id": 17111,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 27,
   "firman": "Selesaikanlah pekerjaanmu di luar, siapkanlah itu di ladang; baru kemudian dirikanlah rumahmu."
 },
 {
   "id": 17112,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 28,
   "firman": "Jangan menjadi saksi terhadap sesamamu tanpa sebab, dan menipu dengan bibirmu."
 },
 {
   "id": 17113,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 29,
   "firman": "Janganlah berkata: \"Sebagaimana ia memperlakukan aku, demikian kuperlakukan dia. Aku membalas orang menurut perbuatannya.\""
 },
 {
   "id": 17114,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 30,
   "firman": "Aku melalui ladang seorang pemalas dan kebun anggur orang yang tidak berakal budi."
 },
 {
   "id": 17115,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 31,
   "firman": "Lihatlah, semua itu ditumbuhi onak, tanahnya tertutup dengan jeruju, dan temboknya sudah roboh."
 },
 {
   "id": 17116,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 32,
   "firman": "Aku memandangnya, aku memperhatikannya, aku melihatnya dan menarik suatu pelajaran."
 },
 {
   "id": 17117,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 33,
   "firman": "\"Tidur sebentar lagi, mengantuk sebentar lagi, melipat tangan sebentar lagi untuk tinggal berbaring,\""
 },
 {
   "id": 17118,
   "kitab": "Ams",
   "pasal": 24,
   "ayat": 34,
   "firman": "maka datanglah kemiskinan seperti seorang penyerbu, dan kekurangan seperti orang yang bersenjata."
 },
 {
   "id": 17119,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 1,
   "firman": "Juga ini adalah amsal-amsal Salomo yang dikumpulkan pegawai-pegawai Hizkia, raja Yehuda."
 },
 {
   "id": 17120,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 2,
   "firman": "Kemuliaan Allah ialah merahasiakan sesuatu, tetapi kemuliaan raja-raja ialah menyelidiki sesuatu."
 },
 {
   "id": 17121,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 3,
   "firman": "Seperti tingginya langit dan dalamnya bumi, demikianlah hati raja-raja tidak terduga."
 },
 {
   "id": 17122,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 4,
   "firman": "Sisihkanlah sanga dari perak, maka keluarlah benda yang indah bagi pandai emas."
 },
 {
   "id": 17123,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 5,
   "firman": "Sisihkanlah orang fasik dari hadapan raja, maka kokohlah takhtanya oleh kebenaran."
 },
 {
   "id": 17124,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 6,
   "firman": "Jangan berlagak di hadapan raja, atau berdiri di tempat para pembesar."
 },
 {
   "id": 17125,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 7,
   "firman": "Karena lebih baik orang berkata kepadamu: \"Naiklah ke mari,\" dari pada engkau direndahkan di hadapan orang mulia. Apa matamu lihat,"
 },
 {
   "id": 17126,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 8,
   "firman": "jangan terburu-buru kaubuat perkara pengadilan. Karena pada akhirnya apa yang engkau dapat lakukan, kalau sesamamu telah mempermalukan engkau?"
 },
 {
   "id": 17127,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 9,
   "firman": "Belalah perkaramu terhadap sesamamu itu, tetapi jangan buka rahasia orang lain,"
 },
 {
   "id": 17128,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 10,
   "firman": "supaya jangan orang yang mendengar engkau akan mencemoohkan engkau, dan umpat terhadap engkau akan tidak hilang."
 },
 {
   "id": 17129,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 11,
   "firman": "Perkataan yang diucapkan tepat pada waktunya adalah seperti buah apel emas di pinggan perak."
 },
 {
   "id": 17130,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 12,
   "firman": "Teguran orang yang bijak adalah seperti cincin emas dan hiasan kencana untuk telinga yang mendengar."
 },
 {
   "id": 17131,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 13,
   "firman": "Seperti sejuk salju di musim panen, demikianlah pesuruh yang setia bagi orang-orang yang menyuruhnya. Ia menyegarkan hati tuan-tuannya."
 },
 {
   "id": 17132,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 14,
   "firman": "Awan dan angin tanpa hujan, demikianlah orang yang menyombongkan diri dengan hadiah yang tidak pernah diberikannya."
 },
 {
   "id": 17133,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 15,
   "firman": "Dengan kesabaran seorang penguasa dapat diyakinkan dan lidah lembut mematahkan tulang."
 },
 {
   "id": 17134,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 16,
   "firman": "Kalau engkau mendapat madu, makanlah secukupnya, jangan sampai engkau terlalu kenyang dengan itu, lalu memuntahkannya."
 },
 {
   "id": 17135,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 17,
   "firman": "Janganlah kerap kali datang ke rumah sesamamu, supaya jangan ia bosan, lalu membencimu."
 },
 {
   "id": 17136,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 18,
   "firman": "Orang yang bersaksi dusta terhadap sesamanya adalah seperti gada, atau pedang, atau panah yang tajam."
 },
 {
   "id": 17137,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 19,
   "firman": "Kepercayaan kepada pengkhianat di masa kesesakan adalah seperti gigi yang rapuh dan kaki yang goyah."
 },
 {
   "id": 17138,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 20,
   "firman": "Orang yang menyanyikan nyanyian untuk hati yang sedih adalah seperti orang yang menanggalkan baju di musim dingin, dan seperti cuka pada luka."
 },
 {
   "id": 17139,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 21,
   "firman": "Jikalau seterumu lapar, berilah dia makan roti, dan jikalau ia dahaga, berilah dia minum air."
 },
 {
   "id": 17140,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 22,
   "firman": "Karena engkau akan menimbun bara api di atas kepalanya, dan TUHAN akan membalas itu kepadamu."
 },
 {
   "id": 17141,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 23,
   "firman": "Angin utara membawa hujan, bicara secara rahasia muka marah."
 },
 {
   "id": 17142,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 24,
   "firman": "Lebih baik tinggal pada sudut sotoh rumah dari pada diam serumah dengan perempuan yang suka bertengkar."
 },
 {
   "id": 17143,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 25,
   "firman": "Seperti air sejuk bagi jiwa yang dahaga, demikianlah kabar baik dari negeri yang jauh."
 },
 {
   "id": 17144,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 26,
   "firman": "Seperti mata air yang keruh dan sumber yang kotor, demikianlah orang benar yang kuatir di hadapan orang fasik."
 },
 {
   "id": 17145,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 27,
   "firman": "Tidaklah baik makan banyak madu; sebab itu biarlah jarang kata-kata pujianmu."
 },
 {
   "id": 17146,
   "kitab": "Ams",
   "pasal": 25,
   "ayat": 28,
   "firman": "Orang yang tak dapat mengendalikan diri adalah seperti kota yang roboh temboknya."
 },
 {
   "id": 17147,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 1,
   "firman": "Seperti salju di musim panas dan hujan pada waktu panen, demikian kehormatanpun tidak layak bagi orang bebal."
 },
 {
   "id": 17148,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 2,
   "firman": "Seperti burung pipit mengirap dan burung layang-layang terbang, demikianlah kutuk tanpa alasan tidak akan kena."
 },
 {
   "id": 17149,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 3,
   "firman": "Cemeti adalah untuk kuda, kekang untuk keledai, dan pentung untuk punggung orang bebal."
 },
 {
   "id": 17150,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 4,
   "firman": "Jangan menjawab orang bebal menurut kebodohannya, supaya jangan engkau sendiri menjadi sama dengan dia."
 },
 {
   "id": 17151,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 5,
   "firman": "Jawablah orang bebal menurut kebodohannya, supaya jangan ia menganggap dirinya bijak."
 },
 {
   "id": 17152,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 6,
   "firman": "Siapa mengirim pesan dengan perantaraan orang bebal mematahkan kakinya sendiri dan meminum kecelakaan."
 },
 {
   "id": 17153,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 7,
   "firman": "Amsal di mulut orang bebal adalah seperti kaki yang terkulai dari pada orang yang lumpuh."
 },
 {
   "id": 17154,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 8,
   "firman": "Seperti orang menaruh batu di umban, demikianlah orang yang memberi hormat kepada orang bebal."
 },
 {
   "id": 17155,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 9,
   "firman": "Amsal di mulut orang bebal adalah seperti duri yang menusuk tangan pemabuk."
 },
 {
   "id": 17156,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 10,
   "firman": "Siapa mempekerjakan orang bebal dan orang-orang yang lewat adalah seperti pemanah yang melukai tiap orang."
 },
 {
   "id": 17157,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 11,
   "firman": "Seperti anjing kembali ke muntahnya, demikianlah orang bebal yang mengulangi kebodohannya."
 },
 {
   "id": 17158,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 12,
   "firman": "Jika engkau melihat orang yang menganggap dirinya bijak, harapan bagi orang bebal lebih banyak dari pada bagi orang itu."
 },
 {
   "id": 17159,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 13,
   "firman": "Berkatalah si pemalas: \"Ada singa di jalan! Ada singa di lorong!\""
 },
 {
   "id": 17160,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 14,
   "firman": "Seperti pintu berputar pada engselnya, demikianlah si pemalas di tempat tidurnya."
 },
 {
   "id": 17161,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 15,
   "firman": "Si pemalas mencelupkan tangannya ke dalam pinggan, tetapi ia terlalu lelah untuk mengembalikannya ke mulutnya."
 },
 {
   "id": 17162,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 16,
   "firman": "Si pemalas menganggap dirinya lebih bijak dari pada tujuh orang yang menjawab dengan bijaksana."
 },
 {
   "id": 17163,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 17,
   "firman": "Orang yang ikut campur dalam pertengkaran orang lain adalah seperti orang yang menangkap telinga anjing yang berlalu."
 },
 {
   "id": 17164,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 18,
   "firman": "Seperti orang gila menembakkan panah api, panah dan maut,"
 },
 {
   "id": 17165,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 19,
   "firman": "demikianlah orang yang memperdaya sesamanya dan berkata: \"Aku hanya bersenda gurau.\""
 },
 {
   "id": 17166,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 20,
   "firman": "Bila kayu habis, padamlah api; bila pemfitnah tak ada, redalah pertengkaran."
 },
 {
   "id": 17167,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 21,
   "firman": "Seperti arang untuk bara menyala dan kayu untuk api, demikianlah orang yang suka bertengkar untuk panasnya perbantahan."
 },
 {
   "id": 17168,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 22,
   "firman": "Seperti sedap-sedapan perkataan pemfitnah masuk ke lubuk hati."
 },
 {
   "id": 17169,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 23,
   "firman": "Seperti pecahan periuk bersalutkan perak, demikianlah bibir manis dengan hati jahat."
 },
 {
   "id": 17170,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 24,
   "firman": "Si pembenci berpura-pura dengan bibirnya, tetapi dalam hati dikandungnya tipu daya."
 },
 {
   "id": 17171,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 25,
   "firman": "Kalau ia ramah, janganlah percaya padanya, karena tujuh kekejian ada dalam hatinya."
 },
 {
   "id": 17172,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 26,
   "firman": "Walaupun kebenciannya diselubungi tipu daya, kejahatannya akan nyata dalam jemaah."
 },
 {
   "id": 17173,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 27,
   "firman": "Siapa menggali lobang akan jatuh ke dalamnya, dan siapa menggelindingkan batu, batu itu akan kembali menimpa dia."
 },
 {
   "id": 17174,
   "kitab": "Ams",
   "pasal": 26,
   "ayat": 28,
   "firman": "Lidah dusta membenci korbannya, dan mulut licin mendatangkan kehancuran."
 },
 {
   "id": 17175,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 1,
   "firman": "Janganlah memuji diri karena esok hari, karena engkau tidak tahu apa yang akan terjadi hari itu."
 },
 {
   "id": 17176,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 2,
   "firman": "Biarlah orang lain memuji engkau dan bukan mulutmu, orang yang tidak kaukenal dan bukan bibirmu sendiri."
 },
 {
   "id": 17177,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 3,
   "firman": "Batu adalah berat dan pasirpun ada beratnya, tetapi lebih berat dari kedua-duanya adalah sakit hati terhadap orang bodoh."
 },
 {
   "id": 17178,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 4,
   "firman": "Panas hati kejam dan murka melanda, tetapi siapa dapat tahan terhadap cemburu?"
 },
 {
   "id": 17179,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 5,
   "firman": "Lebih baik teguran yang nyata-nyata dari pada kasih yang tersembunyi."
 },
 {
   "id": 17180,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 6,
   "firman": "Seorang kawan memukul dengan maksud baik, tetapi seorang lawan mencium secara berlimpah-limpah."
 },
 {
   "id": 17181,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 7,
   "firman": "Orang yang kenyang menginjak-injak madu, tetapi bagi orang yang lapar segala yang pahit dirasakan manis."
 },
 {
   "id": 17182,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 8,
   "firman": "Seperti burung yang lari dari sarangnya demikianlah orang yang lari dari kediamannya."
 },
 {
   "id": 17183,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 9,
   "firman": "Minyak dan wangi-wangian menyukakan hati, tetapi penderitaan merobek jiwa."
 },
 {
   "id": 17184,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 10,
   "firman": "Jangan kautinggalkan temanmu dan teman ayahmu. Jangan datang di rumah saudaramu pada waktu engkau malang. Lebih baik tetangga yang dekat dari pada saudara yang jauh."
 },
 {
   "id": 17185,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 11,
   "firman": "Anakku, hendaklah engkau bijak, sukakanlah hatiku, supaya aku dapat menjawab orang yang mencela aku."
 },
 {
   "id": 17186,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 12,
   "firman": "Kalau orang bijak melihat malapetaka, bersembunyilah ia, tetapi orang yang tak berpengalaman berjalan terus, lalu kena celaka."
 },
 {
   "id": 17187,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 13,
   "firman": "Ambillah pakaian orang yang menanggung orang lain, dan tahanlah dia sebagai sandera ganti orang asing."
 },
 {
   "id": 17188,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 14,
   "firman": "Siapa pagi-pagi sekali memberi selamat dengan suara nyaring, hal itu akan dianggap sebagai kutuk baginya."
 },
 {
   "id": 17189,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 15,
   "firman": "Seorang isteri yang suka bertengkar serupa dengan tiris yang tidak henti-hentinya menitik pada waktu hujan."
 },
 {
   "id": 17190,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 16,
   "firman": "Siapa menahannya menahan angin, dan tangan kanannya menggenggam minyak."
 },
 {
   "id": 17191,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 17,
   "firman": "Besi menajamkan besi, orang menajamkan sesamanya."
 },
 {
   "id": 17192,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 18,
   "firman": "Siapa memelihara pohon ara akan memakan buahnya, dan siapa menjaga tuannya akan dihormati."
 },
 {
   "id": 17193,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 19,
   "firman": "Seperti air mencerminkan wajah, demikianlah hati manusia mencerminkan manusia itu."
 },
 {
   "id": 17194,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 20,
   "firman": "Dunia orang mati dan kebinasaan tak akan puas, demikianlah mata manusia tak akan puas."
 },
 {
   "id": 17195,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 21,
   "firman": "Kui untuk melebur perak dan perapian untuk melebur emas, dan orang dinilai menurut pujian yang diberikan kepadanya."
 },
 {
   "id": 17196,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 22,
   "firman": "Sekalipun engkau menumbuk orang bodoh dalam lesung, dengan alu bersama-sama gandum, kebodohannya tidak akan lenyap dari padanya."
 },
 {
   "id": 17197,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 23,
   "firman": "Kenallah baik-baik keadaan kambing dombamu, perhatikanlah kawanan hewanmu."
 },
 {
   "id": 17198,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 24,
   "firman": "Karena harta benda tidaklah abadi. Apakah mahkota tetap turun-temurun?"
 },
 {
   "id": 17199,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 25,
   "firman": "Kalau rumput menghilang dan tunas muda nampak, dan rumput gunung dikumpulkan,"
 },
 {
   "id": 17200,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 26,
   "firman": "maka engkau mempunyai domba-domba muda untuk pakaianmu dan kambing-kambing jantan untuk pembeli ladang,"
 },
 {
   "id": 17201,
   "kitab": "Ams",
   "pasal": 27,
   "ayat": 27,
   "firman": "pula cukup susu kambing untuk makananmu dan makanan keluargamu, dan untuk penghidupan pelayan-pelayanmu perempuan."
 },
 {
   "id": 17202,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 1,
   "firman": "Orang fasik lari, walaupun tidak ada yang mengejarnya, tetapi orang benar merasa aman seperti singa muda."
 },
 {
   "id": 17203,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 2,
   "firman": "Karena pemberontakan negeri banyaklah penguasa-penguasanya, tetapi karena orang yang berpengertian dan berpengetahuan tetaplah hukum."
 },
 {
   "id": 17204,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 3,
   "firman": "Orang miskin yang menindas orang-orang yang lemah adalah seperti hujan deras, tetapi tidak memberi makanan."
 },
 {
   "id": 17205,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 4,
   "firman": "Orang yang mengabaikan hukum memuji orang fasik, tetapi orang yang berpegang pada hukum menentangnya."
 },
 {
   "id": 17206,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 5,
   "firman": "Orang yang jahat tidak mengerti keadilan, tetapi orang yang mencari TUHAN mengerti segala sesuatu."
 },
 {
   "id": 17207,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 6,
   "firman": "Lebih baik orang miskin yang bersih kelakuannya dari pada orang yang berliku-liku jalannya, sekalipun ia kaya."
 },
 {
   "id": 17208,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 7,
   "firman": "Orang yang memelihara hukum adalah anak yang berpengertian, tetapi orang yang bergaul dengan pelahap mempermalukan ayahnya."
 },
 {
   "id": 17209,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 8,
   "firman": "Orang yang memperbanyak hartanya dengan riba dan bunga uang, mengumpulkan itu untuk orang-orang yang mempunyai belas kasihan kepada orang-orang lemah."
 },
 {
   "id": 17210,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 9,
   "firman": "Siapa memalingkan telinganya untuk tidak mendengarkan hukum, juga doanya adalah kekejian."
 },
 {
   "id": 17211,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 10,
   "firman": "Siapa menyesatkan orang jujur ke jalan yang jahat akan jatuh ke dalam lobangnya sendiri, tetapi orang-orang yang tak bercela akan mewarisi kebahagiaan."
 },
 {
   "id": 17212,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 11,
   "firman": "Orang kaya menganggap dirinya bijak, tetapi orang miskin yang berpengertian mengenal dia."
 },
 {
   "id": 17213,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 12,
   "firman": "Jika orang benar menang, banyaklah pujian orang, tetapi jika orang fasik mendapat kekuasaan, orang menyembunyikan diri."
 },
 {
   "id": 17214,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 13,
   "firman": "Siapa menyembunyikan pelanggarannya tidak akan beruntung, tetapi siapa mengakuinya dan meninggalkannya akan disayangi."
 },
 {
   "id": 17215,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 14,
   "firman": "Berbahagialah orang yang senantiasa takut akan TUHAN, tetapi orang yang mengeraskan hatinya akan jatuh ke dalam malapetaka."
 },
 {
   "id": 17216,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 15,
   "firman": "Seperti singa yang meraung atau beruang yang menyerbu, demikianlah orang fasik yang memerintah rakyat yang lemah."
 },
 {
   "id": 17217,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 16,
   "firman": "Seorang pemimpin yang tidak mempunyai pengertian keras penindasannya, tetapi orang yang membenci laba yang tidak halal, memperpanjang umurnya."
 },
 {
   "id": 17218,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 17,
   "firman": "Orang yang menanggung darah orang lain akan lari sampai ke liang kubur. Janganlah engkau menahannya!"
 },
 {
   "id": 17219,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 18,
   "firman": "Siapa berlaku tidak bercela akan diselamatkan, tetapi siapa berliku-liku jalannya akan jatuh ke dalam lobang."
 },
 {
   "id": 17220,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 19,
   "firman": "Siapa mengerjakan tanahnya akan kenyang dengan makanan, tetapi siapa mengejar barang yang sia-sia akan kenyang dengan kemiskinan."
 },
 {
   "id": 17221,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 20,
   "firman": "Orang yang dapat dipercaya mendapat banyak berkat, tetapi orang yang ingin cepat menjadi kaya, tidak akan luput dari hukuman."
 },
 {
   "id": 17222,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 21,
   "firman": "Memandang bulu tidaklah baik, tetapi untuk sekerat roti orang membuat pelanggaran."
 },
 {
   "id": 17223,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 22,
   "firman": "Orang yang kikir tergesa-gesa mengejar harta, dan tidak mengetahui bahwa ia akan mengalami kekurangan."
 },
 {
   "id": 17224,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 23,
   "firman": "Siapa menegur orang akan kemudian lebih disayangi dari pada orang yang menjilat."
 },
 {
   "id": 17225,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 24,
   "firman": "Siapa merampasi ayah dan ibunya dan menyangka bahwa itu bukan suatu pelanggaran, ia sendiri adalah kawan si perusak."
 },
 {
   "id": 17226,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 25,
   "firman": "Orang yang loba, menimbulkan pertengkaran, tetapi siapa percaya kepada TUHAN, diberi kelimpahan."
 },
 {
   "id": 17227,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 26,
   "firman": "Siapa percaya kepada hatinya sendiri adalah orang bebal, tetapi siapa berlaku dengan bijak akan selamat."
 },
 {
   "id": 17228,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 27,
   "firman": "Siapa memberi kepada orang miskin tak akan berkekurangan, tetapi orang yang menutup matanya akan sangat dikutuki."
 },
 {
   "id": 17229,
   "kitab": "Ams",
   "pasal": 28,
   "ayat": 28,
   "firman": "Jika orang fasik mendapat kekuasaan, orang menyembunyikan diri, tetapi jika mereka binasa, bertambahlah jumlah orang benar."
 },
 {
   "id": 17230,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 1,
   "firman": "Siapa bersitegang leher, walaupun telah mendapat teguran, akan sekonyong-konyong diremukkan tanpa dapat dipulihkan lagi."
 },
 {
   "id": 17231,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 2,
   "firman": "Jika orang benar bertambah, bersukacitalah rakyat, tetapi jika orang fasik memerintah, berkeluhkesahlah rakyat."
 },
 {
   "id": 17232,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 3,
   "firman": "Orang yang mencintai hikmat menggembirakan ayahnya, tetapi siapa yang bergaul dengan pelacur memboroskan harta."
 },
 {
   "id": 17233,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 4,
   "firman": "Dengan keadilan seorang raja menegakkan negerinya, tetapi orang yang memungut banyak pajak meruntuhkannya."
 },
 {
   "id": 17234,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 5,
   "firman": "Orang yang menjilat sesamanya membentangkan jerat di depan kakinya."
 },
 {
   "id": 17235,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 6,
   "firman": "Orang yang jahat terjerat oleh pelanggarannya, tetapi orang benar akan bersorak dan bersukacita."
 },
 {
   "id": 17236,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 7,
   "firman": "Orang benar mengetahui hak orang lemah, tetapi orang fasik tidak mengertinya."
 },
 {
   "id": 17237,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 8,
   "firman": "Pencemooh mengacaukan kota, tetapi orang bijak meredakan amarah."
 },
 {
   "id": 17238,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 9,
   "firman": "Jika orang bijak beperkara dengan orang bodoh, orang bodoh ini mengamuk dan tertawa, sehingga tak ada ketenangan."
 },
 {
   "id": 17239,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 10,
   "firman": "Orang yang haus akan darah membenci orang saleh, tetapi orang yang jujur mencari keselamatannya."
 },
 {
   "id": 17240,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 11,
   "firman": "Orang bebal melampiaskan seluruh amarahnya, tetapi orang bijak akhirnya meredakannya."
 },
 {
   "id": 17241,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 12,
   "firman": "Kalau pemerintah memperhatikan kebohongan, semua pegawainya menjadi fasik."
 },
 {
   "id": 17242,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 13,
   "firman": "Si miskin dan si penindas bertemu, dan TUHAN membuat mata kedua orang itu bersinar."
 },
 {
   "id": 17243,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 14,
   "firman": "Raja yang menghakimi orang lemah dengan adil, takhtanya tetap kokoh untuk selama-lamanya."
 },
 {
   "id": 17244,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 15,
   "firman": "Tongkat dan teguran mendatangkan hikmat, tetapi anak yang dibiarkan mempermalukan ibunya."
 },
 {
   "id": 17245,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 16,
   "firman": "Jika orang fasik bertambah, bertambahlah pula pelanggaran, tetapi orang benar akan melihat keruntuhan mereka."
 },
 {
   "id": 17246,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 17,
   "firman": "Didiklah anakmu, maka ia akan memberikan ketenteraman kepadamu, dan mendatangkan sukacita kepadamu."
 },
 {
   "id": 17247,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 18,
   "firman": "Bila tidak ada wahyu, menjadi liarlah rakyat. Berbahagialah orang yang berpegang pada hukum."
 },
 {
   "id": 17248,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 19,
   "firman": "Dengan kata-kata saja seorang hamba tidak dapat diajari, sebab walaupun ia mengerti, namun ia tidak mengindahkannya."
 },
 {
   "id": 17249,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 20,
   "firman": "Kaulihat orang yang cepat dengan kata-katanya; harapan lebih banyak bagi orang bebal dari pada bagi orang itu."
 },
 {
   "id": 17250,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 21,
   "firman": "Siapa memanjakan hambanya sejak muda, akhirnya menjadikan dia keras kepala."
 },
 {
   "id": 17251,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 22,
   "firman": "Si pemarah menimbulkan pertengkaran, dan orang yang lekas gusar, banyak pelanggarannya."
 },
 {
   "id": 17252,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 23,
   "firman": "Keangkuhan merendahkan orang, tetapi orang yang rendah hati, menerima pujian."
 },
 {
   "id": 17253,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 24,
   "firman": "Siapa menerima bagian dari pencuri, membenci dirinya. Didengarnya kutuk, tetapi tidak diberitahukannya."
 },
 {
   "id": 17254,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 25,
   "firman": "Takut kepada orang mendatangkan jerat, tetapi siapa percaya kepada TUHAN, dilindungi."
 },
 {
   "id": 17255,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 26,
   "firman": "Banyak orang mencari muka pada pemerintah, tetapi dari TUHAN orang menerima keadilan."
 },
 {
   "id": 17256,
   "kitab": "Ams",
   "pasal": 29,
   "ayat": 27,
   "firman": "Orang bodoh adalah kekejian bagi orang benar, orang yang jujur jalannya adalah kekejian bagi orang fasik."
 },
 {
   "id": 17257,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 1,
   "firman": "Perkataan Agur bin Yake dari Masa. Tutur kata orang itu: Aku berlelah-lelah, ya Allah, aku berlelah-lelah, sampai habis tenagaku."
 },
 {
   "id": 17258,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 2,
   "firman": "Sebab aku ini lebih bodoh dari pada orang lain, pengertian manusia tidak ada padaku."
 },
 {
   "id": 17259,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 3,
   "firman": "Juga tidak kupelajari hikmat, sehingga tidak dapat kukenal Yang Mahakudus."
 },
 {
   "id": 17260,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 4,
   "firman": "Siapakah yang naik ke sorga lalu turun? Siapakah yang telah mengumpulkan angin dalam genggamnya? Siapakah yang telah membungkus air dengan kain? Siapakah yang telah menetapkan segala ujung bumi? Siapa namanya dan siapa nama anaknya? Engkau tentu tahu!"
 },
 {
   "id": 17261,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 5,
   "firman": "Semua firman Allah adalah murni. Ia adalah perisai bagi orang-orang yang berlindung pada-Nya."
 },
 {
   "id": 17262,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 6,
   "firman": "Jangan menambahi firman-Nya, supaya engkau tidak ditegur-Nya dan dianggap pendusta."
 },
 {
   "id": 17263,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 7,
   "firman": "Dua hal aku mohon kepada-Mu, jangan itu Kautolak sebelum aku mati, yakni:"
 },
 {
   "id": 17264,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 8,
   "firman": "Jauhkanlah dari padaku kecurangan dan kebohongan. Jangan berikan kepadaku kemiskinan atau kekayaan. Biarkanlah aku menikmati makanan yang menjadi bagianku."
 },
 {
   "id": 17265,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 9,
   "firman": "Supaya, kalau aku kenyang, aku tidak menyangkal-Mu dan berkata: Siapa TUHAN itu? Atau, kalau aku miskin, aku mencuri, dan mencemarkan nama Allahku."
 },
 {
   "id": 17266,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 10,
   "firman": "Jangan mencerca seorang hamba pada tuannya, supaya jangan ia mengutuki engkau dan engkau harus menanggung kesalahan itu."
 },
 {
   "id": 17267,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 11,
   "firman": "Ada keturunan yang mengutuki ayahnya dan tidak memberkati ibunya."
 },
 {
   "id": 17268,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 12,
   "firman": "Ada keturunan yang menganggap dirinya tahir, tetapi belum dibasuh dari kotorannya sendiri."
 },
 {
   "id": 17269,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 13,
   "firman": "Ada keturunan yang berpandangan angkuh, yang terangkat kelopak matanya."
 },
 {
   "id": 17270,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 14,
   "firman": "Ada keturunan yang giginya adalah pedang, yang gigi geliginya adalah pisau, untuk memakan habis dari bumi orang-orang yang tertindas, orang-orang yang miskin di antara manusia."
 },
 {
   "id": 17271,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 15,
   "firman": "Si lintah mempunyai dua anak perempuan: \"Untukku!\" dan \"Untukku!\" Ada tiga hal yang tak akan kenyang, ada empat hal yang tak pernah berkata: \"Cukup!\""
 },
 {
   "id": 17272,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 16,
   "firman": "Dunia orang mati, dan rahim yang mandul, dan bumi yang tidak pernah puas dengan air, dan api yang tidak pernah berkata: \"Cukup!\""
 },
 {
   "id": 17273,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 17,
   "firman": "Mata yang mengolok-olok ayah, dan enggan mendengarkan ibu akan dipatuk gagak lembah dan dimakan anak rajawali."
 },
 {
   "id": 17274,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 18,
   "firman": "Ada tiga hal yang mengherankan aku, bahkan, ada empat hal yang tidak kumengerti:"
 },
 {
   "id": 17275,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 19,
   "firman": "jalan rajawali di udara, jalan ular di atas cadas, jalan kapal di tengah-tengah laut, dan jalan seorang laki-laki dengan seorang gadis."
 },
 {
   "id": 17276,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 20,
   "firman": "Inilah jalan perempuan yang berzinah: ia makan, lalu menyeka mulutnya, dan berkata: Aku tidak berbuat jahat."
 },
 {
   "id": 17277,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 21,
   "firman": "Karena tiga hal bumi gemetar, bahkan, karena empat hal ia tidak dapat tahan:"
 },
 {
   "id": 17278,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 22,
   "firman": "karena seorang hamba, kalau ia menjadi raja, karena seorang bebal, kalau ia kekenyangan makan,"
 },
 {
   "id": 17279,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 23,
   "firman": "karena seorang wanita yang tidak disukai orang, kalau ia mendapat suami, dan karena seorang hamba perempuan, kalau ia mendesak kedudukan nyonyanya."
 },
 {
   "id": 17280,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 24,
   "firman": "Ada empat binatang yang terkecil di bumi, tetapi yang sangat cekatan:"
 },
 {
   "id": 17281,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 25,
   "firman": "semut, bangsa yang tidak kuat, tetapi yang menyediakan makanannya di musim panas,"
 },
 {
   "id": 17282,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 26,
   "firman": "pelanduk, bangsa yang lemah, tetapi yang membuat rumahnya di bukit batu,"
 },
 {
   "id": 17283,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 27,
   "firman": "belalang yang tidak mempunyai raja, namun semuanya berbaris dengan teratur,"
 },
 {
   "id": 17284,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 28,
   "firman": "cicak yang dapat kautangkap dengan tangan, tetapi yang juga ada di istana-istana raja."
 },
 {
   "id": 17285,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 29,
   "firman": "Ada tiga binatang yang gagah langkahnya, bahkan, empat hal yang gagah jalannya, yakni:"
 },
 {
   "id": 17286,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 30,
   "firman": "singa, yang terkuat di antara binatang, yang tidak mundur terhadap apapun."
 },
 {
   "id": 17287,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 31,
   "firman": "Ayam jantan yang angkuh, atau kambing jantan, dan seorang raja yang berjalan di depan rakyatnya."
 },
 {
   "id": 17288,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 32,
   "firman": "Bila engkau menyombongkan diri tanpa atau dengan berpikir, tekapkanlah tangan pada mulut!"
 },
 {
   "id": 17289,
   "kitab": "Ams",
   "pasal": 30,
   "ayat": 33,
   "firman": "Sebab, kalau susu ditekan, mentega dihasilkan, dan kalau hidung ditekan, darah keluar, dan kalau kemarahan ditekan, pertengkaran timbul."
 },
 {
   "id": 17290,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 1,
   "firman": "Inilah perkataan Lemuel, raja Masa, yang diajarkan ibunya kepadanya."
 },
 {
   "id": 17291,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 2,
   "firman": "Apa yang akan kukatakan, anakku, anak kandungku, anak nazarku?"
 },
 {
   "id": 17292,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 3,
   "firman": "Jangan berikan kekuatanmu kepada perempuan, dan jalanmu kepada perempuan-perempuan yang membinasakan raja-raja."
 },
 {
   "id": 17293,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 4,
   "firman": "Tidaklah pantas bagi raja, hai Lemuel, tidaklah pantas bagi raja meminum anggur, ataupun bagi para pembesar mengingini minuman keras,"
 },
 {
   "id": 17294,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 5,
   "firman": "jangan sampai karena minum ia melupakan apa yang telah ditetapkan, dan membengkokkan hak orang-orang yang tertindas."
 },
 {
   "id": 17295,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 6,
   "firman": "Berikanlah minuman keras itu kepada orang yang akan binasa, dan anggur itu kepada yang susah hati."
 },
 {
   "id": 17296,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 7,
   "firman": "Biarlah ia minum dan melupakan kemiskinannya, dan tidak lagi mengingat kesusahannya."
 },
 {
   "id": 17297,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 8,
   "firman": "Bukalah mulutmu untuk orang yang bisu, untuk hak semua orang yang merana."
 },
 {
   "id": 17298,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 9,
   "firman": "Bukalah mulutmu, ambillah keputusan secara adil dan berikanlah kepada yang tertindas dan yang miskin hak mereka."
 },
 {
   "id": 17299,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 10,
   "firman": "Isteri yang cakap siapakah akan mendapatkannya? Ia lebih berharga dari pada permata."
 },
 {
   "id": 17300,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 11,
   "firman": "Hati suaminya percaya kepadanya, suaminya tidak akan kekurangan keuntungan."
 },
 {
   "id": 17301,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 12,
   "firman": "Ia berbuat baik kepada suaminya dan tidak berbuat jahat sepanjang umurnya."
 },
 {
   "id": 17302,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 13,
   "firman": "Ia mencari bulu domba dan rami, dan senang bekerja dengan tangannya."
 },
 {
   "id": 17303,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 14,
   "firman": "Ia serupa kapal-kapal saudagar, dari jauh ia mendatangkan makanannya."
 },
 {
   "id": 17304,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 15,
   "firman": "Ia bangun kalau masih malam, lalu menyediakan makanan untuk seisi rumahnya, dan membagi-bagikan tugas kepada pelayan-pelayannya perempuan."
 },
 {
   "id": 17305,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 16,
   "firman": "Ia membeli sebuah ladang yang diingininya, dan dari hasil tangannya kebun anggur ditanaminya."
 },
 {
   "id": 17306,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 17,
   "firman": "Ia mengikat pinggangnya dengan kekuatan, ia menguatkan lengannya."
 },
 {
   "id": 17307,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 18,
   "firman": "Ia tahu bahwa pendapatannya menguntungkan, pada malam hari pelitanya tidak padam."
 },
 {
   "id": 17308,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 19,
   "firman": "Tangannya ditaruhnya pada jentera, jari-jarinya memegang pemintal."
 },
 {
   "id": 17309,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 20,
   "firman": "Ia memberikan tangannya kepada yang tertindas, mengulurkan tangannya kepada yang miskin."
 },
 {
   "id": 17310,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 21,
   "firman": "Ia tidak takut kepada salju untuk seisi rumahnya, karena seluruh isi rumahnya berpakaian rangkap."
 },
 {
   "id": 17311,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 22,
   "firman": "Ia membuat bagi dirinya permadani, lenan halus dan kain ungu pakaiannya."
 },
 {
   "id": 17312,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 23,
   "firman": "Suaminya dikenal di pintu gerbang, kalau ia duduk bersama-sama para tua-tua negeri."
 },
 {
   "id": 17313,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 24,
   "firman": "Ia membuat pakaian dari lenan, dan menjualnya, ia menyerahkan ikat pinggang kepada pedagang."
 },
 {
   "id": 17314,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 25,
   "firman": "Pakaiannya adalah kekuatan dan kemuliaan, ia tertawa tentang hari depan."
 },
 {
   "id": 17315,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 26,
   "firman": "Ia membuka mulutnya dengan hikmat, pengajaran yang lemah lembut ada di lidahnya."
 },
 {
   "id": 17316,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 27,
   "firman": "Ia mengawasi segala perbuatan rumah tangganya, makanan kemalasan tidak dimakannya."
 },
 {
   "id": 17317,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 28,
   "firman": "Anak-anaknya bangun, dan menyebutnya berbahagia, pula suaminya memuji dia:"
 },
 {
   "id": 17318,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 29,
   "firman": "Banyak wanita telah berbuat baik, tetapi kau melebihi mereka semua."
 },
 {
   "id": 17319,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 30,
   "firman": "Kemolekan adalah bohong dan kecantikan adalah sia-sia, tetapi isteri yang takut akan TUHAN dipuji-puji."
 },
 {
   "id": 17320,
   "kitab": "Ams",
   "pasal": 31,
   "ayat": 31,
   "firman": "Berilah kepadanya bagian dari hasil tangannya, biarlah perbuatannya memuji dia di pintu-pintu gerbang!"
 },
 {
   "id": 17321,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah perkataan Pengkhotbah, anak Daud, raja di Yerusalem."
 },
 {
   "id": 17322,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kesia-siaan belaka, kata Pengkhotbah, kesia-siaan belaka, segala sesuatu adalah sia-sia."
 },
 {
   "id": 17323,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 3,
   "firman": "Apakah gunanya manusia berusaha dengan jerih payah di bawah matahari?"
 },
 {
   "id": 17324,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 4,
   "firman": "Keturunan yang satu pergi dan keturunan yang lain datang, tetapi bumi tetap ada."
 },
 {
   "id": 17325,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 5,
   "firman": "Matahari terbit, matahari terbenam, lalu terburu-buru menuju tempat ia terbit kembali."
 },
 {
   "id": 17326,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 6,
   "firman": "Angin bertiup ke selatan, lalu berputar ke utara, terus-menerus ia berputar, dan dalam putarannya angin itu kembali."
 },
 {
   "id": 17327,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 7,
   "firman": "Semua sungai mengalir ke laut, tetapi laut tidak juga menjadi penuh; ke mana sungai mengalir, ke situ sungai mengalir selalu."
 },
 {
   "id": 17328,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 8,
   "firman": "Segala sesuatu menjemukan, sehingga tak terkatakan oleh manusia; mata tidak kenyang melihat, telinga tidak puas mendengar."
 },
 {
   "id": 17329,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 9,
   "firman": "Apa yang pernah ada akan ada lagi, dan apa yang pernah dibuat akan dibuat lagi; tak ada sesuatu yang baru di bawah matahari."
 },
 {
   "id": 17330,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 10,
   "firman": "Adakah sesuatu yang dapat dikatakan: \"Lihatlah, ini baru!\"? Tetapi itu sudah ada dulu, lama sebelum kita ada."
 },
 {
   "id": 17331,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 11,
   "firman": "Kenang-kenangan dari masa lampau tidak ada, dan dari masa depan yang masih akan datangpun tidak akan ada kenang-kenangan pada mereka yang hidup sesudahnya."
 },
 {
   "id": 17332,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 12,
   "firman": "Aku, Pengkhotbah, adalah raja atas Israel di Yerusalem."
 },
 {
   "id": 17333,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 13,
   "firman": "Aku membulatkan hatiku untuk memeriksa dan menyelidiki dengan hikmat segala yang terjadi di bawah langit. Itu pekerjaan yang menyusahkan yang diberikan Allah kepada anak-anak manusia untuk melelahkan diri."
 },
 {
   "id": 17334,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 14,
   "firman": "Aku telah melihat segala perbuatan yang dilakukan orang di bawah matahari, tetapi lihatlah, segala sesuatu adalah kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17335,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 15,
   "firman": "Yang bongkok tak dapat diluruskan, dan yang tidak ada tak dapat dihitung."
 },
 {
   "id": 17336,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 16,
   "firman": "Aku berkata dalam hati: \"Lihatlah, aku telah memperbesar dan menambah hikmat lebih dari pada semua orang yang memerintah atas Yerusalem sebelum aku, dan hatiku telah memperoleh banyak hikmat dan pengetahuan.\""
 },
 {
   "id": 17337,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 17,
   "firman": "Aku telah membulatkan hatiku untuk memahami hikmat dan pengetahuan, kebodohan dan kebebalan. Tetapi aku menyadari bahwa hal inipun adalah usaha menjaring angin,"
 },
 {
   "id": 17338,
   "kitab": "Pkh",
   "pasal": 1,
   "ayat": 18,
   "firman": "karena di dalam banyak hikmat ada banyak susah hati, dan siapa memperbanyak pengetahuan, memperbanyak kesedihan."
 },
 {
   "id": 17339,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 1,
   "firman": "Aku berkata dalam hati: \"Mari, aku hendak menguji kegirangan! Nikmatilah kesenangan! Tetapi lihat, juga itupun sia-sia.\""
 },
 {
   "id": 17340,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tentang tertawa aku berkata: \"Itu bodoh!\", dan mengenai kegirangan: \"Apa gunanya?\""
 },
 {
   "id": 17341,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 3,
   "firman": "Aku menyelidiki diriku dengan menyegarkan tubuhku dengan anggur, --sedang akal budiku tetap memimpin dengan hikmat--,dan dengan memperoleh kebebalan, sampai aku mengetahui apa yang baik bagi anak-anak manusia untuk dilakukan di bawah langit selama hidup mereka yang pendek itu."
 },
 {
   "id": 17342,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 4,
   "firman": "Aku melakukan pekerjaan-pekerjaan besar, mendirikan bagiku rumah-rumah, menanami bagiku kebun-kebun anggur;"
 },
 {
   "id": 17343,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 5,
   "firman": "aku mengusahakan bagiku kebun-kebun dan taman-taman, dan menanaminya dengan rupa-rupa pohon buah-buahan;"
 },
 {
   "id": 17344,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 6,
   "firman": "aku menggali bagiku kolam-kolam untuk mengairi dari situ tanaman pohon-pohon muda."
 },
 {
   "id": 17345,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 7,
   "firman": "Aku membeli budak-budak laki-laki dan perempuan, dan ada budak-budak yang lahir di rumahku; aku mempunyai juga banyak sapi dan kambing domba melebihi siapapun yang pernah hidup di Yerusalem sebelum aku."
 },
 {
   "id": 17346,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 8,
   "firman": "Aku mengumpulkan bagiku juga perak dan emas, harta benda raja-raja dan daerah-daerah. Aku mencari bagiku biduan-biduan dan biduanita-biduanita, dan yang menyenangkan anak-anak manusia, yakni banyak gundik."
 },
 {
   "id": 17347,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 9,
   "firman": "Dengan demikian aku menjadi besar, bahkan lebih besar dari pada siapapun yang pernah hidup di Yerusalem sebelum aku; dalam pada itu hikmatku tinggal tetap padaku."
 },
 {
   "id": 17348,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 10,
   "firman": "Aku tidak merintangi mataku dari apapun yang dikehendakinya, dan aku tidak menahan hatiku dari sukacita apapun, sebab hatiku bersukacita karena segala jerih payahku. Itulah buah segala jerih payahku."
 },
 {
   "id": 17349,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 11,
   "firman": "Ketika aku meneliti segala pekerjaan yang telah dilakukan tanganku dan segala usaha yang telah kulakukan untuk itu dengan jerih payah, lihatlah, segala sesuatu adalah kesia-siaan dan usaha menjaring angin; memang tak ada keuntungan di bawah matahari."
 },
 {
   "id": 17350,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 12,
   "firman": "Lalu aku berpaling untuk meninjau hikmat, kebodohan dan kebebalan, sebab apa yang dapat dilakukan orang yang menggantikan raja? Hanya apa yang telah dilakukan orang."
 },
 {
   "id": 17351,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan aku melihat bahwa hikmat melebihi kebodohan, seperti terang melebihi kegelapan."
 },
 {
   "id": 17352,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 14,
   "firman": "Mata orang berhikmat ada di kepalanya, sedangkan orang yang bodoh berjalan dalam kegelapan, tetapi aku tahu juga bahwa nasib yang sama menimpa mereka semua."
 },
 {
   "id": 17353,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 15,
   "firman": "Maka aku berkata dalam hati: \"Nasib yang menimpa orang bodoh juga akan menimpa aku. Untuk apa aku ini dulu begitu berhikmat?\" Lalu aku berkata dalam hati, bahwa inipun sia-sia."
 },
 {
   "id": 17354,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 16,
   "firman": "Karena tidak ada kenang-kenangan yang kekal baik dari orang yang berhikmat, maupun dari orang yang bodoh, sebab pada hari-hari yang akan datang kesemuanya sudah lama dilupakan. Dan, ah, orang yang berhikmat mati juga seperti orang yang bodoh!"
 },
 {
   "id": 17355,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 17,
   "firman": "Oleh sebab itu aku membenci hidup, karena aku menganggap menyusahkan apa yang dilakukan di bawah matahari, sebab segala sesuatu adalah kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17356,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 18,
   "firman": "Aku membenci segala usaha yang kulakukan dengan jerih payah di bawah matahari, sebab aku harus meninggalkannya kepada orang yang datang sesudah aku."
 },
 {
   "id": 17357,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 19,
   "firman": "Dan siapakah yang mengetahui apakah orang itu berhikmat atau bodoh? Meskipun demikian ia akan berkuasa atas segala usaha yang kulakukan di bawah matahari dengan jerih payah dan dengan mempergunakan hikmat. Inipun sia-sia."
 },
 {
   "id": 17358,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 20,
   "firman": "Dengan demikian aku mulai putus asa terhadap segala usaha yang kulakukan dengan jerih payah di bawah matahari."
 },
 {
   "id": 17359,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 21,
   "firman": "Sebab, kalau ada orang berlelah-lelah dengan hikmat, pengetahuan dan kecakapan, maka ia harus meninggalkan bahagiannya kepada orang yang tidak berlelah-lelah untuk itu. Inipun kesia-siaan dan kemalangan yang besar."
 },
 {
   "id": 17360,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 22,
   "firman": "Apakah faedahnya yang diperoleh manusia dari segala usaha yang dilakukannya dengan jerih payah di bawah matahari dan dari keinginan hatinya?"
 },
 {
   "id": 17361,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 23,
   "firman": "Seluruh hidupnya penuh kesedihan dan pekerjaannya penuh kesusahan hati, bahkan pada malam hari hatinya tidak tenteram. Inipun sia-sia."
 },
 {
   "id": 17362,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tak ada yang lebih baik bagi manusia dari pada makan dan minum dan bersenang-senang dalam jerih payahnya. Aku menyadari bahwa inipun dari tangan Allah."
 },
 {
   "id": 17363,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 25,
   "firman": "Karena siapa dapat makan dan merasakan kenikmatan di luar Dia?"
 },
 {
   "id": 17364,
   "kitab": "Pkh",
   "pasal": 2,
   "ayat": 26,
   "firman": "Karena kepada orang yang dikenan-Nya Ia mengaruniakan hikmat, pengetahuan dan kesukaan, tetapi orang berdosa ditugaskan-Nya untuk menghimpun dan menimbun sesuatu yang kemudian harus diberikannya kepada orang yang dikenan Allah. Inipun kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17365,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 1,
   "firman": "Untuk segala sesuatu ada masanya, untuk apapun di bawah langit ada waktunya."
 },
 {
   "id": 17366,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ada waktu untuk lahir, ada waktu untuk meninggal, ada waktu untuk menanam, ada waktu untuk mencabut yang ditanam;"
 },
 {
   "id": 17367,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 3,
   "firman": "ada waktu untuk membunuh, ada waktu untuk menyembuhkan; ada waktu untuk merombak, ada waktu untuk membangun;"
 },
 {
   "id": 17368,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 4,
   "firman": "ada waktu untuk menangis, ada waktu untuk tertawa; ada waktu untuk meratap; ada waktu untuk menari;"
 },
 {
   "id": 17369,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 5,
   "firman": "ada waktu untuk membuang batu, ada waktu untuk mengumpulkan batu; ada waktu untuk memeluk, ada waktu untuk menahan diri dari memeluk;"
 },
 {
   "id": 17370,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 6,
   "firman": "ada waktu untuk mencari, ada waktu untuk membiarkan rugi; ada waktu untuk menyimpan, ada waktu untuk membuang;"
 },
 {
   "id": 17371,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 7,
   "firman": "ada waktu untuk merobek, ada waktu untuk menjahit; ada waktu untuk berdiam diri, ada waktu untuk berbicara;"
 },
 {
   "id": 17372,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 8,
   "firman": "ada waktu untuk mengasihi, ada waktu untuk membenci; ada waktu untuk perang, ada waktu untuk damai."
 },
 {
   "id": 17373,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 9,
   "firman": "Apakah untung pekerja dari yang dikerjakannya dengan berjerih payah?"
 },
 {
   "id": 17374,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 10,
   "firman": "Aku telah melihat pekerjaan yang diberikan Allah kepada anak-anak manusia untuk melelahkan dirinya."
 },
 {
   "id": 17375,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 11,
   "firman": "Ia membuat segala sesuatu indah pada waktunya, bahkan Ia memberikan kekekalan dalam hati mereka. Tetapi manusia tidak dapat menyelami pekerjaan yang dilakukan Allah dari awal sampai akhir."
 },
 {
   "id": 17376,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 12,
   "firman": "Aku tahu bahwa untuk mereka tak ada yang lebih baik dari pada bersuka-suka dan menikmati kesenangan dalam hidup mereka."
 },
 {
   "id": 17377,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 13,
   "firman": "Dan bahwa setiap orang dapat makan, minum dan menikmati kesenangan dalam segala jerih payahnya, itu juga adalah pemberian Allah."
 },
 {
   "id": 17378,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 14,
   "firman": "Aku tahu bahwa segala sesuatu yang dilakukan Allah akan tetap ada untuk selamanya; itu tak dapat ditambah dan tak dapat dikurangi; Allah berbuat demikian, supaya manusia takut akan Dia."
 },
 {
   "id": 17379,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 15,
   "firman": "Yang sekarang ada dulu sudah ada, dan yang akan ada sudah lama ada; dan Allah mencari yang sudah lalu."
 },
 {
   "id": 17380,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 16,
   "firman": "Ada lagi yang kulihat di bawah matahari: di tempat pengadilan, di situpun terdapat ketidakadilan, dan di tempat keadilan, di situpun terdapat ketidakadilan."
 },
 {
   "id": 17381,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 17,
   "firman": "Berkatalah aku dalam hati: \"Allah akan mengadili baik orang yang benar maupun yang tidak adil, karena untuk segala hal dan segala pekerjaan ada waktunya.\""
 },
 {
   "id": 17382,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 18,
   "firman": "Tentang anak-anak manusia aku berkata dalam hati: \"Allah hendak menguji mereka dan memperlihatkan kepada mereka bahwa mereka hanyalah binatang.\""
 },
 {
   "id": 17383,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 19,
   "firman": "Karena nasib manusia adalah sama dengan nasib binatang, nasib yang sama menimpa mereka; sebagaimana yang satu mati, demikian juga yang lain. Kedua-duanya mempunyai nafas yang sama, dan manusia tak mempunyai kelebihan atas binatang, karena segala sesuatu adalah sia-sia."
 },
 {
   "id": 17384,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 20,
   "firman": "Kedua-duanya menuju satu tempat; kedua-duanya terjadi dari debu dan kedua-duanya kembali kepada debu."
 },
 {
   "id": 17385,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 21,
   "firman": "Siapakah yang mengetahui, apakah nafas manusia naik ke atas dan nafas binatang turun ke bawah bumi."
 },
 {
   "id": 17386,
   "kitab": "Pkh",
   "pasal": 3,
   "ayat": 22,
   "firman": "Aku melihat bahwa tidak ada yang lebih baik bagi manusia dari pada bergembira dalam pekerjaannya, sebab itu adalah bahagiannya. Karena siapa akan memperlihatkan kepadanya apa yang akan terjadi sesudah dia?"
 },
 {
   "id": 17387,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 1,
   "firman": "Lagi aku melihat segala penindasan yang terjadi di bawah matahari, dan lihatlah, air mata orang-orang yang ditindas dan tak ada yang menghibur mereka, karena di fihak orang-orang yang menindas ada kekuasaan."
 },
 {
   "id": 17388,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 2,
   "firman": "Oleh sebab itu aku menganggap orang-orang mati, yang sudah lama meninggal, lebih bahagia dari pada orang-orang hidup, yang sekarang masih hidup."
 },
 {
   "id": 17389,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 3,
   "firman": "Tetapi yang lebih bahagia dari pada kedua-duanya itu kuanggap orang yang belum ada, yang belum melihat perbuatan jahat, yang terjadi di bawah matahari."
 },
 {
   "id": 17390,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 4,
   "firman": "Dan aku melihat bahwa segala jerih payah dan segala kecakapan dalam pekerjaan adalah iri hati seseorang terhadap yang lain. Inipun kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17391,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 5,
   "firman": "Orang yang bodoh melipat tangannya dan memakan dagingnya sendiri."
 },
 {
   "id": 17392,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 6,
   "firman": "Segenggam ketenangan lebih baik dari pada dua genggam jerih payah dan usaha menjaring angin."
 },
 {
   "id": 17393,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 7,
   "firman": "Aku melihat lagi kesia-siaan di bawah matahari:"
 },
 {
   "id": 17394,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 8,
   "firman": "ada seorang sendirian, ia tidak mempunyai anak laki-laki atau saudara laki-laki, dan tidak henti-hentinya ia berlelah-lelah, matanyapun tidak puas dengan kekayaan; --untuk siapa aku berlelah-lelah dan menolak kesenangan? --Inipun kesia-siaan dan hal yang menyusahkan."
 },
 {
   "id": 17395,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 9,
   "firman": "Berdua lebih baik dari pada seorang diri, karena mereka menerima upah yang baik dalam jerih payah mereka."
 },
 {
   "id": 17396,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 10,
   "firman": "Karena kalau mereka jatuh, yang seorang mengangkat temannya, tetapi wai orang yang jatuh, yang tidak mempunyai orang lain untuk mengangkatnya!"
 },
 {
   "id": 17397,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 11,
   "firman": "Juga kalau orang tidur berdua, mereka menjadi panas, tetapi bagaimana seorang saja dapat menjadi panas?"
 },
 {
   "id": 17398,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 12,
   "firman": "Dan bilamana seorang dapat dialahkan, dua orang akan dapat bertahan. Tali tiga lembar tak mudah diputuskan."
 },
 {
   "id": 17399,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 13,
   "firman": "Lebih baik seorang muda miskin tetapi berhikmat dari pada seorang raja tua tetapi bodoh, yang tak mau diberi peringatan lagi."
 },
 {
   "id": 17400,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 14,
   "firman": "Karena dari penjara orang muda itu keluar untuk menjadi raja, biarpun ia dilahirkan miskin semasa pemerintahan orang yang tua itu."
 },
 {
   "id": 17401,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 15,
   "firman": "Aku melihat semua orang yang hidup di bawah matahari berjalan bersama-sama dengan orang muda tadi, yang akan menjadi pengganti raja itu."
 },
 {
   "id": 17402,
   "kitab": "Pkh",
   "pasal": 4,
   "ayat": 16,
   "firman": "Tiada habis-habisnya rakyat yang dipimpinnya, namun orang yang datang kemudian tidak menyukai dia. Oleh sebab itu, inipun kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17403,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 1,
   "firman": "(4-17) Jagalah langkahmu, kalau engkau berjalan ke rumah Allah! Menghampiri untuk mendengar adalah lebih baik dari pada mempersembahkan korban yang dilakukan oleh orang-orang bodoh, karena mereka tidak tahu, bahwa mereka berbuat jahat."
 },
 {
   "id": 17404,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 2,
   "firman": "(5-1) Janganlah terburu-buru dengan mulutmu, dan janganlah hatimu lekas-lekas mengeluarkan perkataan di hadapan Allah, karena Allah ada di sorga dan engkau di bumi; oleh sebab itu, biarlah perkataanmu sedikit."
 },
 {
   "id": 17405,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 3,
   "firman": "(5-2) Karena sebagaimana mimpi disebabkan oleh banyak kesibukan, demikian pula percakapan bodoh disebabkan oleh banyak perkataan."
 },
 {
   "id": 17406,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 4,
   "firman": "(5-3) Kalau engkau bernazar kepada Allah, janganlah menunda-nunda menepatinya, karena Ia tidak senang kepada orang-orang bodoh. Tepatilah nazarmu."
 },
 {
   "id": 17407,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 5,
   "firman": "(5-4) Lebih baik engkau tidak bernazar dari pada bernazar tetapi tidak menepatinya."
 },
 {
   "id": 17408,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 6,
   "firman": "(5-5) Janganlah mulutmu membawa engkau ke dalam dosa, dan janganlah berkata di hadapan utusan Allah bahwa engkau khilaf. Apakah perlu Allah menjadi murka atas ucapan-ucapanmu dan merusakkan pekerjaan tanganmu?"
 },
 {
   "id": 17409,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 7,
   "firman": "(5-6) Karena sebagaimana mimpi banyak, demikian juga perkataan sia-sia banyak. Tetapi takutlah akan Allah."
 },
 {
   "id": 17410,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 8,
   "firman": "(5-7) Kalau engkau melihat dalam suatu daerah orang miskin ditindas dan hukum serta keadilan diperkosa, janganlah heran akan perkara itu, karena pejabat tinggi yang satu mengawasi yang lain, begitu pula pejabat-pejabat yang lebih tinggi mengawasi mereka."
 },
 {
   "id": 17411,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 9,
   "firman": "(5-8) Suatu keuntungan bagi negara dalam keadaan demikian ialah, kalau rajanya dihormati di daerah itu."
 },
 {
   "id": 17412,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 10,
   "firman": "(5-9) Siapa mencintai uang tidak akan puas dengan uang, dan siapa mencintai kekayaan tidak akan puas dengan penghasilannya. Inipun sia-sia."
 },
 {
   "id": 17413,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 11,
   "firman": "(5-10) Dengan bertambahnya harta, bertambah pula orang-orang yang menghabiskannya. Dan apakah keuntungan pemiliknya selain dari pada melihatnya?"
 },
 {
   "id": 17414,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 12,
   "firman": "(5-11) Enak tidurnya orang yang bekerja, baik ia makan sedikit maupun banyak; tetapi kekenyangan orang kaya sekali-kali tidak membiarkan dia tidur."
 },
 {
   "id": 17415,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 13,
   "firman": "(5-12) Ada kemalangan yang menyedihkan kulihat di bawah matahari: kekayaan yang disimpan oleh pemiliknya menjadi kecelakaannya sendiri."
 },
 {
   "id": 17416,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 14,
   "firman": "(5-13) Dan kekayaan itu binasa oleh kemalangan, sehingga tak ada suatupun padanya untuk anaknya."
 },
 {
   "id": 17417,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 15,
   "firman": "(5-14) Sebagaimana ia keluar dari kandungan ibunya, demikian juga ia akan pergi, telanjang seperti ketika ia datang, dan tak diperolehnya dari jerih payahnya suatupun yang dapat dibawa dalam tangannya."
 },
 {
   "id": 17418,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 16,
   "firman": "(5-15) Inipun kemalangan yang menyedihkan. Sebagaimana ia datang, demikianpun ia akan pergi. Dan apakah keuntungan orang tadi yang telah berlelah-lelah menjaring angin?"
 },
 {
   "id": 17419,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 17,
   "firman": "(5-16) Malah sepanjang umurnya ia berada dalam kegelapan dan kesedihan, mengalami banyak kesusahan, penderitaan dan kekesalan."
 },
 {
   "id": 17420,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 18,
   "firman": "(5-17) Lihatlah, yang kuanggap baik dan tepat ialah, kalau orang makan minum dan bersenang-senang dalam segala usaha yang dilakukan dengan jerih payah di bawah matahari selama hidup yang pendek, yang dikaruniakan Allah kepadanya, sebab itulah bahagiannya."
 },
 {
   "id": 17421,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 19,
   "firman": "(5-18) Setiap orang yang dikaruniai Allah kekayaan dan harta benda dan kuasa untuk menikmatinya, untuk menerima bahagiannya, dan untuk bersukacita dalam jerih payahnya--juga itupun karunia Allah."
 },
 {
   "id": 17422,
   "kitab": "Pkh",
   "pasal": 5,
   "ayat": 20,
   "firman": "(5-19) Tidak sering ia mengingat umurnya, karena Allah membiarkan dia sibuk dengan kesenangan hatinya."
 },
 {
   "id": 17423,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 1,
   "firman": "Ada suatu kemalangan yang telah kulihat di bawah matahari, yang sangat menekan manusia:"
 },
 {
   "id": 17424,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 2,
   "firman": "orang yang dikaruniai Allah kekayaan, harta benda dan kemuliaan, sehingga ia tak kekurangan suatupun yang diingininya, tetapi orang itu tidak dikaruniai kuasa oleh Allah untuk menikmatinya, melainkan orang lain yang menikmatinya! Inilah kesia-siaan dan penderitaan yang pahit."
 },
 {
   "id": 17425,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 3,
   "firman": "Jika orang memperoleh seratus anak dan hidup lama sampai mencapai umur panjang, tetapi ia tidak puas dengan kesenangan, bahkan tidak mendapat penguburan, kataku, anak gugur lebih baik dari pada orang ini."
 },
 {
   "id": 17426,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sebab anak gugur itu datang dalam kesia-siaan dan pergi dalam kegelapan, dan namanya ditutupi kegelapan."
 },
 {
   "id": 17427,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 5,
   "firman": "Lagipula ia tidak melihat matahari dan tidak mengetahui apa-apa. Ia lebih tenteram dari pada orang tadi."
 },
 {
   "id": 17428,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 6,
   "firman": "Biarpun ia hidup dua kali seribu tahun, kalau ia tidak menikmati kesenangan: bukankah segala sesuatu menuju satu tempat?"
 },
 {
   "id": 17429,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 7,
   "firman": "Segala jerih payah manusia adalah untuk mulutnya, namun keinginannya tidak terpuaskan."
 },
 {
   "id": 17430,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 8,
   "firman": "Karena apakah kelebihan orang yang berhikmat dari pada orang yang bodoh? Apakah kelebihan orang miskin yang tahu berperilaku di hadapan orang?"
 },
 {
   "id": 17431,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 9,
   "firman": "Lebih baik melihat saja dari pada menuruti nafsu. Inipun kesia-siaan dan usaha menjaring angin."
 },
 {
   "id": 17432,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 10,
   "firman": "Apapun yang ada, sudah lama disebut namanya. Dan sudah diketahui siapa manusia, yaitu bahwa ia tidak dapat mengadakan perkara dengan yang lebih kuat dari padanya."
 },
 {
   "id": 17433,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 11,
   "firman": "Karena makin banyak kata-kata, makin banyak kesia-siaan. Apakah faedahnya untuk manusia?"
 },
 {
   "id": 17434,
   "kitab": "Pkh",
   "pasal": 6,
   "ayat": 12,
   "firman": "Karena siapakah yang mengetahui apa yang baik bagi manusia sepanjang waktu yang pendek dari hidupnya yang sia-sia, yang ditempuhnya seperti bayangan? Siapakah yang dapat mengatakan kepada manusia apa yang akan terjadi di bawah matahari sesudah dia?"
 },
 {
   "id": 17435,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 1,
   "firman": "Nama yang harum lebih baik dari pada minyak yang mahal, dan hari kematian lebih baik dari pada hari kelahiran."
 },
 {
   "id": 17436,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 2,
   "firman": "Pergi ke rumah duka lebih baik dari pada pergi ke rumah pesta, karena di rumah dukalah kesudahan setiap manusia; hendaknya orang yang hidup memperhatikannya."
 },
 {
   "id": 17437,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 3,
   "firman": "Bersedih lebih baik dari pada tertawa, karena muka muram membuat hati lega."
 },
 {
   "id": 17438,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 4,
   "firman": "Orang berhikmat senang berada di rumah duka, tetapi orang bodoh senang berada di rumah tempat bersukaria."
 },
 {
   "id": 17439,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 5,
   "firman": "Mendengar hardikan orang berhikmat lebih baik dari pada mendengar nyanyian orang bodoh."
 },
 {
   "id": 17440,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 6,
   "firman": "Karena seperti bunyi duri terbakar di bawah kuali, demikian tertawa orang bodoh. Inipun sia-sia."
 },
 {
   "id": 17441,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 7,
   "firman": "Sungguh, pemerasan membodohkan orang berhikmat, dan uang suap merusakkan hati."
 },
 {
   "id": 17442,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 8,
   "firman": "Akhir suatu hal lebih baik dari pada awalnya. Panjang sabar lebih baik dari pada tinggi hati."
 },
 {
   "id": 17443,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 9,
   "firman": "Janganlah lekas-lekas marah dalam hati, karena amarah menetap dalam dada orang bodoh."
 },
 {
   "id": 17444,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 10,
   "firman": "Janganlah mengatakan: \"Mengapa zaman dulu lebih baik dari pada zaman sekarang?\" Karena bukannya berdasarkan hikmat engkau menanyakan hal itu."
 },
 {
   "id": 17445,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 11,
   "firman": "Hikmat adalah sama baiknya dengan warisan dan merupakan suatu keuntungan bagi orang-orang yang melihat matahari."
 },
 {
   "id": 17446,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 12,
   "firman": "Karena perlindungan hikmat adalah seperti perlindungan uang. Dan beruntunglah yang mengetahui bahwa hikmat memelihara hidup pemilik-pemiliknya."
 },
 {
   "id": 17447,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 13,
   "firman": "Perhatikanlah pekerjaan Allah! Siapakah dapat meluruskan apa yang telah dibengkokkan-Nya?"
 },
 {
   "id": 17448,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 14,
   "firman": "Pada hari mujur bergembiralah, tetapi pada hari malang ingatlah, bahwa hari malang inipun dijadikan Allah seperti juga hari mujur, supaya manusia tidak dapat menemukan sesuatu mengenai masa depannya."
 },
 {
   "id": 17449,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 15,
   "firman": "Dalam hidupku yang sia-sia aku telah melihat segala hal ini: ada orang saleh yang binasa dalam kesalehannya, ada orang fasik yang hidup lama dalam kejahatannya."
 },
 {
   "id": 17450,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 16,
   "firman": "Janganlah terlalu saleh, janganlah perilakumu terlalu berhikmat; mengapa engkau akan membinasakan dirimu sendiri?"
 },
 {
   "id": 17451,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 17,
   "firman": "Janganlah terlalu fasik, janganlah bodoh! Mengapa engkau mau mati sebelum waktumu?"
 },
 {
   "id": 17452,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 18,
   "firman": "Adalah baik kalau engkau memegang yang satu, dan juga tidak melepaskan yang lain, karena orang yang takut akan Allah luput dari kedua-duanya."
 },
 {
   "id": 17453,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 19,
   "firman": "Hikmat memberi kepada yang memilikinya lebih banyak kekuatan dari pada sepuluh penguasa dalam kota."
 },
 {
   "id": 17454,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 20,
   "firman": "Sesungguhnya, di bumi tidak ada orang yang saleh: yang berbuat baik dan tak pernah berbuat dosa!"
 },
 {
   "id": 17455,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 21,
   "firman": "Juga janganlah memperhatikan segala perkataan yang diucapkan orang, supaya engkau tidak mendengar pelayanmu mengutuki engkau."
 },
 {
   "id": 17456,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 22,
   "firman": "Karena hatimu tahu bahwa engkau juga telah kerapkali mengutuki orang-orang lain."
 },
 {
   "id": 17457,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 23,
   "firman": "Kesemuanya ini telah kuuji untuk mencapai hikmat. Kataku: \"Aku hendak memperoleh hikmat,\" tetapi hikmat itu jauh dari padaku."
 },
 {
   "id": 17458,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 24,
   "firman": "Apa yang ada, itu jauh dan dalam, sangat dalam, siapa yang dapat menemukannya?"
 },
 {
   "id": 17459,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 25,
   "firman": "Aku tujukan perhatianku untuk memahami, menyelidiki, dan mencari hikmat dan kesimpulan, serta untuk mengetahui bahwa kefasikan itu kebodohan dan kebebalan itu kegilaan."
 },
 {
   "id": 17460,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 26,
   "firman": "Dan aku menemukan sesuatu yang lebih pahit dari pada maut: perempuan yang adalah jala, yang hatinya adalah jerat dan tangannya adalah belenggu. Orang yang dikenan Allah terhindar dari padanya, tetapi orang yang berdosa ditangkapnya."
 },
 {
   "id": 17461,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 27,
   "firman": "Lihatlah, ini yang kudapati, kata Pengkhotbah: Sementara menyatukan yang satu dengan yang lain untuk mendapat kesimpulan,"
 },
 {
   "id": 17462,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 28,
   "firman": "yang masih kucari tetapi tidak kudapati, kudapati seorang laki-laki di antara seribu, tetapi tidak kudapati seorang perempuan di antara mereka."
 },
 {
   "id": 17463,
   "kitab": "Pkh",
   "pasal": 7,
   "ayat": 29,
   "firman": "Lihatlah, hanya ini yang kudapati: bahwa Allah telah menjadikan manusia yang jujur, tetapi mereka mencari banyak dalih."
 },
 {
   "id": 17464,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 1,
   "firman": "Siapakah seperti orang berhikmat? Dan siapakah yang mengetahui keterangan setiap perkara? Hikmat manusia menjadikan wajahnya bercahaya dan berubahlah kekerasan wajahnya."
 },
 {
   "id": 17465,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 2,
   "firman": "Patuhilah perintah raja demi sumpahmu kepada Allah."
 },
 {
   "id": 17466,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 3,
   "firman": "Janganlah tergesa-gesa pergi dari hadapannya, janganlah bertahan dalam perkara yang jahat, karena ia berbuat apa yang dikehendakinya."
 },
 {
   "id": 17467,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 4,
   "firman": "Karena titah raja berkuasa; siapakah yang akan mengatakan kepadanya: \"Apakah yang baginda buat?\""
 },
 {
   "id": 17468,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 5,
   "firman": "Siapa yang mematuhi perintah tidak akan mengalami perkara yang mencelakakan, dan hati orang berhikmat mengetahui waktu pengadilan,"
 },
 {
   "id": 17469,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 6,
   "firman": "karena untuk segala sesuatu ada waktu pengadilan, dan kejahatan manusia menekan dirinya."
 },
 {
   "id": 17470,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sesungguhnya, ia tak mengetahui apa yang akan terjadi, karena siapakah yang akan mengatakan kepadanya bagaimana itu akan terjadi?"
 },
 {
   "id": 17471,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 8,
   "firman": "Tiada seorangpun berkuasa menahan angin dan tiada seorangpun berkuasa atas hari kematian. Tak ada istirahat dalam peperangan, dan kefasikan tidak melepaskan orang yang melakukannya."
 },
 {
   "id": 17472,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 9,
   "firman": "Semua ini telah kulihat dan aku memberi perhatian kepada segala perbuatan yang dilakukan di bawah matahari, ketika orang yang satu menguasai orang yang lain hingga ia celaka."
 },
 {
   "id": 17473,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 10,
   "firman": "Aku melihat juga orang-orang fasik yang akan dikuburkan boleh masuk, sedangkan orang yang berlaku benar harus pergi dari tempat yang kudus dan dilupakan dalam kota. Inipun sia-sia."
 },
 {
   "id": 17474,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 11,
   "firman": "Oleh karena hukuman terhadap perbuatan jahat tidak segera dilaksanakan, maka hati manusia penuh niat untuk berbuat jahat."
 },
 {
   "id": 17475,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 12,
   "firman": "Walaupun orang yang berdosa dan yang berbuat jahat seratus kali hidup lama, namun aku tahu, bahwa orang yang takut akan Allah akan beroleh kebahagiaan, sebab mereka takut terhadap hadirat-Nya."
 },
 {
   "id": 17476,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 13,
   "firman": "Tetapi orang yang fasik tidak akan beroleh kebahagiaan dan seperti bayang-bayang ia tidak akan panjang umur, karena ia tidak takut terhadap hadirat Allah."
 },
 {
   "id": 17477,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 14,
   "firman": "Ada suatu kesia-siaan yang terjadi di atas bumi: ada orang-orang benar, yang menerima ganjaran yang layak untuk perbuatan orang fasik, dan ada orang-orang fasik yang menerima pahala yang layak untuk perbuatan orang benar. Aku berkata: \"Inipun sia-sia!\""
 },
 {
   "id": 17478,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 15,
   "firman": "Oleh sebab itu aku memuji kesukaan, karena tak ada kebahagiaan lain bagi manusia di bawah matahari, kecuali makan dan minum dan bersukaria. Itu yang menyertainya di dalam jerih payahnya seumur hidupnya yang diberikan Allah kepadanya di bawah matahari."
 },
 {
   "id": 17479,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 16,
   "firman": "Ketika aku memberi perhatianku untuk memahami hikmat dan melihat kegiatan yang dilakukan orang di dunia tanpa mengantuk siang malam,"
 },
 {
   "id": 17480,
   "kitab": "Pkh",
   "pasal": 8,
   "ayat": 17,
   "firman": "maka nyatalah kepadaku, bahwa manusia tidak dapat menyelami segala pekerjaan Allah, yang dilakukan-Nya di bawah matahari. Bagaimanapun juga manusia berlelah-lelah mencarinya, ia tidak akan menyelaminya. Walaupun orang yang berhikmat mengatakan, bahwa ia mengetahuinya, namun ia tidak dapat menyelaminya."
 },
 {
   "id": 17481,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 1,
   "firman": "Sesungguhnya, semua ini telah kuperhatikan, semua ini telah kuperiksa, yakni bahwa orang-orang yang benar dan orang-orang yang berhikmat dan perbuatan-perbuatan mereka, baik kasih maupun kebencian, ada di tangan Allah; manusia tidak mengetahui apapun yang dihadapinya."
 },
 {
   "id": 17482,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 2,
   "firman": "Segala sesuatu sama bagi sekalian; nasib orang sama: baik orang yang benar maupun orang yang fasik, orang yang baik maupun orang yang jahat, orang yang tahir maupun orang yang najis, orang yang mempersembahkan korban maupun yang tidak mempersembahkan korban. Sebagaimana orang yang baik, begitu pula orang yang berdosa; sebagaimana orang yang bersumpah, begitu pula orang yang takut untuk bersumpah."
 },
 {
   "id": 17483,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 3,
   "firman": "Inilah yang celaka dalam segala sesuatu yang terjadi di bawah matahari; nasib semua orang sama. Hati anak-anak manusiapun penuh dengan kejahatan, dan kebebalan ada dalam hati mereka seumur hidup, dan kemudian mereka menuju alam orang mati."
 },
 {
   "id": 17484,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 4,
   "firman": "Tetapi siapa yang termasuk orang hidup mempunyai harapan, karena anjing yang hidup lebih baik dari pada singa yang mati."
 },
 {
   "id": 17485,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 5,
   "firman": "Karena orang-orang yang hidup tahu bahwa mereka akan mati, tetapi orang yang mati tak tahu apa-apa, tak ada upah lagi bagi mereka, bahkan kenangan kepada mereka sudah lenyap."
 },
 {
   "id": 17486,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 6,
   "firman": "Baik kasih mereka, maupun kebencian dan kecemburuan mereka sudah lama hilang, dan untuk selama-lamanya tak ada lagi bahagian mereka dalam segala sesuatu yang terjadi di bawah matahari."
 },
 {
   "id": 17487,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 7,
   "firman": "Mari, makanlah rotimu dengan sukaria, dan minumlah anggurmu dengan hati yang senang, karena Allah sudah lama berkenan akan perbuatanmu."
 },
 {
   "id": 17488,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 8,
   "firman": "Biarlah selalu putih pakaianmu dan jangan tidak ada minyak di atas kepalamu."
 },
 {
   "id": 17489,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 9,
   "firman": "Nikmatilah hidup dengan isteri yang kaukasihi seumur hidupmu yang sia-sia, yang dikaruniakan TUHAN kepadamu di bawah matahari, karena itulah bahagianmu dalam hidup dan dalam usaha yang engkau lakukan dengan jerih payah di bawah matahari."
 },
 {
   "id": 17490,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 10,
   "firman": "Segala sesuatu yang dijumpai tanganmu untuk dikerjakan, kerjakanlah itu sekuat tenaga, karena tak ada pekerjaan, pertimbangan, pengetahuan dan hikmat dalam dunia orang mati, ke mana engkau akan pergi."
 },
 {
   "id": 17491,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 11,
   "firman": "Lagi aku melihat di bawah matahari bahwa kemenangan perlombaan bukan untuk yang cepat, dan keunggulan perjuangan bukan untuk yang kuat, juga roti bukan untuk yang berhikmat, kekayaan bukan untuk yang cerdas, dan karunia bukan untuk yang cerdik cendekia, karena waktu dan nasib dialami mereka semua."
 },
 {
   "id": 17492,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 12,
   "firman": "Karena manusia tidak mengetahui waktunya. Seperti ikan yang tertangkap dalam jala yang mencelakakan, dan seperti burung yang tertangkap dalam jerat, begitulah anak-anak manusia terjerat pada waktu yang malang, kalau hal itu menimpa mereka secara tiba-tiba."
 },
 {
   "id": 17493,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 13,
   "firman": "Hal ini juga kupandang sebagai hikmat di bawah matahari dan nampaknya besar bagiku;"
 },
 {
   "id": 17494,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 14,
   "firman": "ada sebuah kota yang kecil, penduduknya tidak seberapa; seorang raja yang agung menyerang, mengepungnya dan mendirikan tembok-tembok pengepungan yang besar terhadapnya;"
 },
 {
   "id": 17495,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 15,
   "firman": "di situ terdapat seorang miskin yang berhikmat, dengan hikmatnya ia menyelamatkan kota itu, tetapi tak ada orang yang mengingat orang yang miskin itu."
 },
 {
   "id": 17496,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 16,
   "firman": "Kataku: \"Hikmat lebih baik dari pada keperkasaan, tetapi hikmat orang miskin dihina dan perkataannya tidak didengar orang.\""
 },
 {
   "id": 17497,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 17,
   "firman": "Perkataan orang berhikmat yang didengar dengan tenang, lebih baik dari pada teriakan orang yang berkuasa di antara orang bodoh."
 },
 {
   "id": 17498,
   "kitab": "Pkh",
   "pasal": 9,
   "ayat": 18,
   "firman": "Hikmat lebih baik dari pada alat-alat perang, tetapi satu orang yang keliru dapat merusakkan banyak hal yang baik."
 },
 {
   "id": 17499,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 1,
   "firman": "Lalat yang mati menyebabkan urapan dari pembuat urapan berbau busuk; demikian juga sedikit kebodohan lebih berpengaruh dari pada hikmat dan kehormatan."
 },
 {
   "id": 17500,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 2,
   "firman": "Hati orang berhikmat menuju ke kanan, tetapi hati orang bodoh ke kiri."
 },
 {
   "id": 17501,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 3,
   "firman": "Juga kalau ia berjalan di lorong orang bodoh itu tumpul pikirannya, dan ia berkata kepada setiap orang: \"Orang itu bodoh!\""
 },
 {
   "id": 17502,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 4,
   "firman": "Jika amarah penguasa menimpa engkau, janganlah meninggalkan tempatmu, karena kesabaran mencegah kesalahan-kesalahan besar."
 },
 {
   "id": 17503,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 5,
   "firman": "Ada suatu kejahatan yang kulihat di bawah matahari sebagai kekhilafan yang berasal dari seorang penguasa:"
 },
 {
   "id": 17504,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 6,
   "firman": "pada banyak tempat yang tinggi, didudukkan orang bodoh, sedangkan tempat yang rendah diduduki orang kaya."
 },
 {
   "id": 17505,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 7,
   "firman": "Aku melihat budak-budak menunggang kuda dan pembesar-pembesar berjalan kaki seperti budak-budak."
 },
 {
   "id": 17506,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 8,
   "firman": "Barangsiapa menggali lobang akan jatuh ke dalamnya, dan barangsiapa mendobrak tembok akan dipagut ular."
 },
 {
   "id": 17507,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 9,
   "firman": "Barangsiapa memecahkan batu akan dilukainya; barangsiapa membelah kayu akan dibahayakannya."
 },
 {
   "id": 17508,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 10,
   "firman": "Jika besi menjadi tumpul dan tidak diasah, maka orang harus memperbesar tenaga, tetapi yang terpenting untuk berhasil adalah hikmat."
 },
 {
   "id": 17509,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 11,
   "firman": "Jika ular memagut sebelum mantera diucapkan, maka tukang mantera tidak akan berhasil."
 },
 {
   "id": 17510,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 12,
   "firman": "Perkataan mulut orang berhikmat menarik, tetapi bibir orang bodoh menelan orang itu sendiri."
 },
 {
   "id": 17511,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 13,
   "firman": "Awal perkataan yang keluar dari mulutnya adalah kebodohan, dan akhir bicaranya adalah kebebalan yang mencelakakan."
 },
 {
   "id": 17512,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 14,
   "firman": "Orang yang bodoh banyak bicaranya, meskipun orang tidak tahu apa yang akan terjadi, dan siapakah yang akan mengatakan kepadanya apa yang akan terjadi sesudah dia?"
 },
 {
   "id": 17513,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 15,
   "firman": "Jerih payah orang bodoh melelahkan orang itu sendiri, karena ia tidak mengetahui jalan ke kota."
 },
 {
   "id": 17514,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 16,
   "firman": "Wahai engkau tanah, kalau rajamu seorang kanak-kanak, dan pemimpin-pemimpinmu pagi-pagi sudah makan!"
 },
 {
   "id": 17515,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 17,
   "firman": "Berbahagialah engkau tanah, kalau rajamu seorang yang berasal dari kaum pemuka, dan pemimpin-pemimpinmu makan pada waktunya dalam keperkasaan dan bukan dalam kemabukan!"
 },
 {
   "id": 17516,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 18,
   "firman": "Oleh karena kemalasan runtuhlah atap, dan oleh karena kelambanan tangan bocorlah rumah."
 },
 {
   "id": 17517,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 19,
   "firman": "Untuk tertawa orang menghidangkan makanan; anggur meriangkan hidup dan uang memungkinkan semuanya itu."
 },
 {
   "id": 17518,
   "kitab": "Pkh",
   "pasal": 10,
   "ayat": 20,
   "firman": "Dalam pikiranpun janganlah engkau mengutuki raja, dan dalam kamar tidur janganlah engkau mengutuki orang kaya, karena burung di udara mungkin akan menyampaikan ucapanmu, dan segala yang bersayap dapat menyampaikan apa yang kauucapkan."
 },
 {
   "id": 17519,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 1,
   "firman": "Lemparkanlah rotimu ke air, maka engkau akan mendapatnya kembali lama setelah itu."
 },
 {
   "id": 17520,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 2,
   "firman": "Berikanlah bahagian kepada tujuh, bahkan kepada delapan orang, karena engkau tidak tahu malapetaka apa yang akan terjadi di atas bumi."
 },
 {
   "id": 17521,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 3,
   "firman": "Bila awan-awan sarat mengandung hujan, maka hujan itu dicurahkannya ke atas bumi; dan bila pohon tumbang ke selatan atau ke utara, di tempat pohon itu jatuh, di situ ia tinggal terletak."
 },
 {
   "id": 17522,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 4,
   "firman": "Siapa senantiasa memperhatikan angin tidak akan menabur; dan siapa senantiasa melihat awan tidak akan menuai."
 },
 {
   "id": 17523,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 5,
   "firman": "Sebagaimana engkau tidak mengetahui jalan angin dan tulang-tulang dalam rahim seorang perempuan yang mengandung, demikian juga engkau tidak mengetahui pekerjaan Allah yang melakukan segala sesuatu."
 },
 {
   "id": 17524,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 6,
   "firman": "Taburkanlah benihmu pagi-pagi hari, dan janganlah memberi istirahat kepada tanganmu pada petang hari, karena engkau tidak mengetahui apakah ini atau itu yang akan berhasil, atau kedua-duanya sama baik."
 },
 {
   "id": 17525,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 7,
   "firman": "Terang itu menyenangkan dan melihat matahari itu baik bagi mata;"
 },
 {
   "id": 17526,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 8,
   "firman": "oleh sebab itu jikalau orang panjang umurnya, biarlah ia bersukacita di dalamnya, tetapi hendaklah ia ingat akan hari-hari yang gelap, karena banyak jumlahnya. Segala sesuatu yang datang adalah kesia-siaan."
 },
 {
   "id": 17527,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 9,
   "firman": "Bersukarialah, hai pemuda, dalam kemudaanmu, biarlah hatimu bersuka pada masa mudamu, dan turutilah keinginan hatimu dan pandangan matamu, tetapi ketahuilah bahwa karena segala hal ini Allah akan membawa engkau ke pengadilan!"
 },
 {
   "id": 17528,
   "kitab": "Pkh",
   "pasal": 11,
   "ayat": 10,
   "firman": "Buanglah kesedihan dari hatimu dan jauhkanlah penderitaan dari tubuhmu, karena kemudaan dan fajar hidup adalah kesia-siaan."
 },
 {
   "id": 17529,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 1,
   "firman": "Ingatlah akan Penciptamu pada masa mudamu, sebelum tiba hari-hari yang malang dan mendekat tahun-tahun yang kaukatakan: \"Tak ada kesenangan bagiku di dalamnya!\","
 },
 {
   "id": 17530,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 2,
   "firman": "sebelum matahari dan terang, bulan dan bintang-bintang menjadi gelap, dan awan-awan datang kembali sesudah hujan,"
 },
 {
   "id": 17531,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 3,
   "firman": "pada waktu penjaga-penjaga rumah gemetar, dan orang-orang kuat membungkuk, dan perempuan-perempuan penggiling berhenti karena berkurang jumlahnya, dan yang melihat dari jendela semuanya menjadi kabur,"
 },
 {
   "id": 17532,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 4,
   "firman": "dan pintu-pintu di tepi jalan tertutup, dan bunyi penggilingan menjadi lemah, dan suara menjadi seperti kicauan burung, dan semua penyanyi perempuan tunduk,"
 },
 {
   "id": 17533,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 5,
   "firman": "juga orang menjadi takut tinggi, dan ketakutan ada di jalan, pohon badam berbunga, belalang menyeret dirinya dengan susah payah dan nafsu makan tak dapat dibangkitkan lagi--karena manusia pergi ke rumahnya yang kekal dan peratap-peratap berkeliaran di jalan,"
 },
 {
   "id": 17534,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 6,
   "firman": "sebelum rantai perak diputuskan dan pelita emas dipecahkan, sebelum tempayan dihancurkan dekat mata air dan roda timba dirusakkan di atas sumur,"
 },
 {
   "id": 17535,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 7,
   "firman": "dan debu kembali menjadi tanah seperti semula dan roh kembali kepada Allah yang mengaruniakannya."
 },
 {
   "id": 17536,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 8,
   "firman": "Kesia-siaan atas kesia-siaan, kata Pengkhotbah, segala sesuatu adalah sia-sia."
 },
 {
   "id": 17537,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 9,
   "firman": "Selain Pengkhotbah berhikmat, ia mengajarkan juga kepada umat itu pengetahuan. Ia menimbang, menguji dan menyusun banyak amsal."
 },
 {
   "id": 17538,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 10,
   "firman": "Pengkhotbah berusaha mendapat kata-kata yang menyenangkan dan menulis kata-kata kebenaran secara jujur."
 },
 {
   "id": 17539,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 11,
   "firman": "Kata-kata orang berhikmat seperti kusa dan kumpulan-kumpulannya seperti paku-paku yang tertancap, diberikan oleh satu gembala."
 },
 {
   "id": 17540,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 12,
   "firman": "Lagipula, anakku, waspadalah! Membuat banyak buku tak akan ada akhirnya, dan banyak belajar melelahkan badan."
 },
 {
   "id": 17541,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 13,
   "firman": "Akhir kata dari segala yang didengar ialah: takutlah akan Allah dan berpeganglah pada perintah-perintah-Nya, karena ini adalah kewajiban setiap orang."
 },
 {
   "id": 17542,
   "kitab": "Pkh",
   "pasal": 12,
   "ayat": 14,
   "firman": "Karena Allah akan membawa setiap perbuatan ke pengadilan yang berlaku atas segala sesuatu yang tersembunyi, entah itu baik, entah itu jahat."
 },
 {
   "id": 17543,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 1,
   "firman": "Kidung agung dari Salomo."
 },
 {
   "id": 17544,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 2,
   "firman": "--Kiranya ia mencium aku dengan kecupan! Karena cintamu lebih nikmat dari pada anggur,"
 },
 {
   "id": 17545,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 3,
   "firman": "harum bau minyakmu, bagaikan minyak yang tercurah namamu, oleh sebab itu gadis-gadis cinta kepadamu!"
 },
 {
   "id": 17546,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 4,
   "firman": "Tariklah aku di belakangmu, marilah kita cepat-cepat pergi! Sang raja telah membawa aku ke dalam maligai-maligainya. Kami akan bersorak-sorai dan bergembira karena engkau, kami akan memuji cintamu lebih dari pada anggur! Layaklah mereka cinta kepadamu!"
 },
 {
   "id": 17547,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 5,
   "firman": "Memang hitam aku, tetapi cantik, hai puteri-puteri Yerusalem, seperti kemah orang Kedar, seperti tirai-tirai orang Salma."
 },
 {
   "id": 17548,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 6,
   "firman": "Janganlah kamu perhatikan bahwa aku hitam, karena terik matahari membakar aku. Putera-putera ibuku marah kepadaku, aku dijadikan mereka penjaga kebun-kebun anggur; kebun anggurku sendiri tak kujaga."
 },
 {
   "id": 17549,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 7,
   "firman": "Ceriterakanlah kepadaku, jantung hatiku, di mana kakanda menggembalakan domba, di mana kakanda membiarkan domba-domba berbaring pada petang hari. Karena mengapa aku akan jadi serupa pengembara dekat kawanan-kawanan domba teman-temanmu?"
 },
 {
   "id": 17550,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 8,
   "firman": "--Jika engkau tak tahu, hai jelita di antara wanita, ikutilah jejak-jejak domba, dan gembalakanlah anak-anak kambingmu dekat perkemahan para gembala."
 },
 {
   "id": 17551,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 9,
   "firman": "--Dengan kuda betina dari pada kereta-kereta Firaun kuumpamakan engkau, manisku."
 },
 {
   "id": 17552,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 10,
   "firman": "Moleklah pipimu di tengah perhiasan-perhiasan dan lehermu di tengah kalung-kalung."
 },
 {
   "id": 17553,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 11,
   "firman": "Kami akan membuat bagimu perhiasan-perhiasan emas dengan manik-manik perak."
 },
 {
   "id": 17554,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 12,
   "firman": "--Sementara sang raja duduk pada mejanya, semerbak bau narwastuku."
 },
 {
   "id": 17555,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 13,
   "firman": "Bagiku kekasihku bagaikan sebungkus mur, tersisip di antara buah dadaku."
 },
 {
   "id": 17556,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 14,
   "firman": "Bagiku kekasihku setangkai bunga pacar di kebun-kebun anggur En-Gedi."
 },
 {
   "id": 17557,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 15,
   "firman": "--Lihatlah, cantik engkau, manisku, sungguh cantik engkau, bagaikan merpati matamu."
 },
 {
   "id": 17558,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 16,
   "firman": "--Lihatlah, tampan engkau, kekasihku, sungguh menarik; sungguh sejuk petiduran kita."
 },
 {
   "id": 17559,
   "kitab": "Kid",
   "pasal": 1,
   "ayat": 17,
   "firman": "Dari kayu aras balok-balok rumah kita, dari kayu eru papan dinding-dinding kita."
 },
 {
   "id": 17560,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 1,
   "firman": "Bunga mawar dari Saron aku, bunga bakung di lembah-lembah."
 },
 {
   "id": 17561,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 2,
   "firman": "--Seperti bunga bakung di antara duri-duri, demikianlah manisku di antara gadis-gadis."
 },
 {
   "id": 17562,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 3,
   "firman": "--Seperti pohon apel di antara pohon-pohon di hutan, demikianlah kekasihku di antara teruna-teruna. Di bawah naungannya aku ingin duduk, buahnya manis bagi langit-langitku."
 },
 {
   "id": 17563,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 4,
   "firman": "Telah dibawanya aku ke rumah pesta, dan panjinya di atasku adalah cinta."
 },
 {
   "id": 17564,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 5,
   "firman": "Kuatkanlah aku dengan penganan kismis, segarkanlah aku dengan buah apel, sebab sakit asmara aku."
 },
 {
   "id": 17565,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tangan kirinya ada di bawah kepalaku, tangan kanannya memeluk aku."
 },
 {
   "id": 17566,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 7,
   "firman": "Kusumpahi kamu, puteri-puteri Yerusalem, demi kijang-kijang atau demi rusa-rusa betina di padang: jangan kamu membangkitkan dan menggerakkan cinta sebelum diingininya!"
 },
 {
   "id": 17567,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 8,
   "firman": "Dengarlah! Kekasihku! Lihatlah, ia datang, melompat-lompat di atas gunung-gunung, meloncat-loncat di atas bukit-bukit."
 },
 {
   "id": 17568,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 9,
   "firman": "Kekasihku serupa kijang, atau anak rusa. Lihatlah, ia berdiri di balik dinding kita, sambil menengok-nengok melalui tingkap-tingkap dan melihat dari kisi-kisi."
 },
 {
   "id": 17569,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 10,
   "firman": "Kekasihku mulai berbicara kepadaku: \"Bangunlah manisku, jelitaku, marilah!"
 },
 {
   "id": 17570,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 11,
   "firman": "Karena lihatlah, musim dingin telah lewat, hujan telah berhenti dan sudah lalu."
 },
 {
   "id": 17571,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 12,
   "firman": "Di ladang telah nampak bunga-bunga, tibalah musim memangkas; bunyi tekukur terdengar di tanah kita."
 },
 {
   "id": 17572,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 13,
   "firman": "Pohon ara mulai berbuah, dan bunga pohon anggur semerbak baunya. Bangunlah, manisku, jelitaku, marilah!"
 },
 {
   "id": 17573,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 14,
   "firman": "Merpatiku di celah-celah batu, di persembunyian lereng-lereng gunung, perlihatkanlah wajahmu, perdengarkanlah suaramu! Sebab merdu suaramu dan elok wajahmu!\""
 },
 {
   "id": 17574,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 15,
   "firman": "Tangkaplah bagi kami rubah-rubah itu, rubah-rubah yang kecil, yang merusak kebun-kebun anggur, kebun-kebun anggur kami yang sedang berbunga!"
 },
 {
   "id": 17575,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 16,
   "firman": "Kekasihku kepunyaanku, dan aku kepunyaan dia yang menggembalakan domba di tengah-tengah bunga bakung."
 },
 {
   "id": 17576,
   "kitab": "Kid",
   "pasal": 2,
   "ayat": 17,
   "firman": "Sebelum angin senja berembus dan bayang-bayang menghilang, kembalilah, kekasihku, berlakulah seperti kijang, atau seperti anak rusa di atas gunung-gunung tanaman rempah-rempah!"
 },
 {
   "id": 17577,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 1,
   "firman": "Di atas ranjangku pada malam hari kucari jantung hatiku. Kucari, tetapi tak kutemui dia."
 },
 {
   "id": 17578,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 2,
   "firman": "Aku hendak bangun dan berkeliling di kota; di jalan-jalan dan di lapangan-lapangan kucari dia, jantung hatiku. Kucari, tetapi tak kutemui dia."
 },
 {
   "id": 17579,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 3,
   "firman": "Aku ditemui peronda-peronda kota. \"Apakah kamu melihat jantung hatiku?\""
 },
 {
   "id": 17580,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 4,
   "firman": "Baru saja aku meninggalkan mereka, kutemui jantung hatiku; kupegang dan tak kulepaskan dia, sampai kubawa dia ke rumah ibuku, ke kamar orang yang melahirkan aku."
 },
 {
   "id": 17581,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 5,
   "firman": "Kusumpahi kamu, puteri-puteri Yerusalem, demi kijang-kijang atau demi rusa-rusa betina di padang: jangan kamu membangkitkan dan menggerakkan cinta sebelum diingininya!"
 },
 {
   "id": 17582,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 6,
   "firman": "Apakah itu yang membubung dari padang gurun seperti gumpalan-gumpalan asap tersaput dengan harum mur dan kemenyan dan bau segala macam serbuk wangi dari pedagang?"
 },
 {
   "id": 17583,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 7,
   "firman": "Lihat, itulah joli Salomo, dikelilingi oleh enam puluh pahlawan dari antara pahlawan-pahlawan Israel."
 },
 {
   "id": 17584,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 8,
   "firman": "Semua membawa pedang, terlatih dalam perang, masing-masing dengan pedang pada pinggang karena kedahsyatan malam."
 },
 {
   "id": 17585,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 9,
   "firman": "Raja Salomo membuat bagi dirinya suatu tandu dari kayu Libanon."
 },
 {
   "id": 17586,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tiang-tiangnya dibuatnya dari perak, sandarannya dari emas, tempat duduknya berwarna ungu, bagian dalamnya dihiasi dengan kayu arang. Hai puteri-puteri Yerusalem,"
 },
 {
   "id": 17587,
   "kitab": "Kid",
   "pasal": 3,
   "ayat": 11,
   "firman": "puteri-puteri Sion, keluarlah dan tengoklah raja Salomo dengan mahkota yang dikenakan kepadanya oleh ibunya pada hari pernikahannya, pada hari kesukaan hatinya."
 },
 {
   "id": 17588,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 1,
   "firman": "Lihatlah, cantik engkau, manisku, sungguh cantik engkau! Bagaikan merpati matamu di balik telekungmu. Rambutmu bagaikan kawanan kambing yang bergelombang turun dari pegunungan Gilead."
 },
 {
   "id": 17589,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 2,
   "firman": "Gigimu bagaikan kawanan domba yang baru saja dicukur, yang keluar dari tempat pembasuhan, yang beranak kembar semuanya, yang tak beranak tak ada."
 },
 {
   "id": 17590,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 3,
   "firman": "Bagaikan seutas pita kirmizi bibirmu, dan elok mulutmu. Bagaikan belahan buah delima pelipismu di balik telekungmu."
 },
 {
   "id": 17591,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 4,
   "firman": "Lehermu seperti menara Daud, dibangun untuk menyimpan senjata. Seribu perisai tergantung padanya dan gada para pahlawan semuanya."
 },
 {
   "id": 17592,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 5,
   "firman": "Seperti dua anak rusa buah dadamu, seperti anak kembar kijang yang tengah makan rumput di tengah-tengah bunga bakung."
 },
 {
   "id": 17593,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 6,
   "firman": "Sebelum angin senja berembus dan bayang-bayang menghilang, aku ingin pergi ke gunung mur dan ke bukit kemenyan."
 },
 {
   "id": 17594,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 7,
   "firman": "Engkau cantik sekali, manisku, tak ada cacat cela padamu."
 },
 {
   "id": 17595,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 8,
   "firman": "Turunlah kepadaku dari gunung Libanon, pengantinku, datanglah kepadaku dari gunung Libanon, turunlah dari puncak Amana, dari puncak Senir dan Hermon, dari liang-liang singa, dari pegunungan tempat macan tutul!"
 },
 {
   "id": 17596,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 9,
   "firman": "Engkau mendebarkan hatiku, dinda, pengantinku, engkau mendebarkan hati dengan satu kejapan mata, dengan seuntai kalung dari perhiasan lehermu."
 },
 {
   "id": 17597,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 10,
   "firman": "Betapa nikmat kasihmu, dinda, pengantinku! Jauh lebih nikmat cintamu dari pada anggur, dan lebih harum bau minyakmu dari pada segala macam rempah."
 },
 {
   "id": 17598,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 11,
   "firman": "Bibirmu meneteskan madu murni, pengantinku, madu dan susu ada di bawah lidahmu, dan bau pakaianmu seperti bau gunung Libanon."
 },
 {
   "id": 17599,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 12,
   "firman": "Dinda, pengantinku, kebun tertutup engkau, kebun tertutup dan mata air termeterai."
 },
 {
   "id": 17600,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 13,
   "firman": "Tunas-tunasmu merupakan kebun pohon-pohon delima dengan buah-buahnya yang lezat, bunga pacar dan narwastu,"
 },
 {
   "id": 17601,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 14,
   "firman": "narwastu dan kunyit, tebu dan kayu manis dengan segala macam pohon kemenyan, mur dan gaharu, beserta pelbagai rempah yang terpilih."
 },
 {
   "id": 17602,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 15,
   "firman": "O, mata air di kebun, sumber air hidup, yang mengalir dari gunung Libanon!"
 },
 {
   "id": 17603,
   "kitab": "Kid",
   "pasal": 4,
   "ayat": 16,
   "firman": "--Bangunlah, hai angin utara, dan marilah, hai angin selatan, bertiuplah dalam kebunku, supaya semerbaklah bau rempah-rempahnya! Semoga kekasihku datang ke kebunnya dan makan buah-buahnya yang lezat."
 },
 {
   "id": 17604,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 1,
   "firman": "--Aku datang ke kebunku, dinda, pengantinku, kukumpulkan mur dan rempah-rempahku, kumakan sambangku dan maduku, kuminum anggurku dan susuku. Makanlah, teman-teman, minumlah, minumlah sampai mabuk cinta!"
 },
 {
   "id": 17605,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 2,
   "firman": "Aku tidur, tetapi hatiku bangun. Dengarlah, kekasihku mengetuk. \"Bukalah pintu, dinda, manisku, merpatiku, idam-idamanku, karena kepalaku penuh embun, dan rambutku penuh tetesan embun malam!\""
 },
 {
   "id": 17606,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 3,
   "firman": "\"Bajuku telah kutanggalkan, apakah aku akan mengenakannya lagi? Kakiku telah kubasuh, apakah aku akan mengotorkannya pula?\""
 },
 {
   "id": 17607,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 4,
   "firman": "Kekasihku memasukkan tangannya melalui lobang pintu, berdebar-debarlah hatiku."
 },
 {
   "id": 17608,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 5,
   "firman": "Aku bangun untuk membuka pintu bagi kekasihku, tanganku bertetesan mur; bertetesan cairan mur jari-jariku pada pegangan kancing pintu."
 },
 {
   "id": 17609,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 6,
   "firman": "Kekasihku kubukakan pintu, tetapi kekasihku sudah pergi, lenyap. Seperti pingsan aku ketika ia menghilang. Kucari dia, tetapi tak kutemui, kupanggil, tetapi tak disahutnya."
 },
 {
   "id": 17610,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 7,
   "firman": "Aku ditemui peronda-peronda kota, dipukulinya aku, dilukainya, selendangku dirampas oleh penjaga-penjaga tembok."
 },
 {
   "id": 17611,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kusumpahi kamu, puteri-puteri Yerusalem: bila kamu menemukan kekasihku, apakah yang akan kamu katakan kepadanya? Katakanlah, bahwa sakit asmara aku!"
 },
 {
   "id": 17612,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 9,
   "firman": "--Apakah kelebihan kekasihmu dari pada kekasih yang lain, hai jelita di antara wanita? Apakah kelebihan kekasihmu dari pada kekasih yang lain, sehingga kausumpahi kami begini?"
 },
 {
   "id": 17613,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 10,
   "firman": "--Putih bersih dan merah cerah kekasihku, menyolok mata di antara selaksa orang."
 },
 {
   "id": 17614,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 11,
   "firman": "Bagaikan emas, emas murni, kepalanya, rambutnya mengombak, hitam seperti gagak."
 },
 {
   "id": 17615,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 12,
   "firman": "Matanya bagaikan merpati pada batang air, bermandi dalam susu, duduk pada kolam yang penuh."
 },
 {
   "id": 17616,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 13,
   "firman": "Pipinya bagaikan bedeng rempah-rempah, petak-petak rempah-rempah akar. Bunga-bunga bakung bibirnya, bertetesan cairan mur."
 },
 {
   "id": 17617,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 14,
   "firman": "Tangannya bundaran emas, berhiaskan permata Tarsis, tubuhnya ukiran dari gading, bertabur batu nilam."
 },
 {
   "id": 17618,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 15,
   "firman": "Kakinya adalah tiang-tiang marmar putih, bertumpu pada alas emas murni. Perawakannya seperti gunung Libanon, terpilih seperti pohon-pohon aras."
 },
 {
   "id": 17619,
   "kitab": "Kid",
   "pasal": 5,
   "ayat": 16,
   "firman": "Kata-katanya manis semata-mata, segala sesuatu padanya menarik. Demikianlah kekasihku, demikianlah temanku, hai puteri-puteri Yerusalem."
 },
 {
   "id": 17620,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 1,
   "firman": "--Ke mana perginya kekasihmu, hai jelita di antara wanita? Ke jurusan manakah kekasihmu pergi, supaya kami mencarinya besertamu?"
 },
 {
   "id": 17621,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 2,
   "firman": "--Kekasihku telah turun ke kebunnya, ke bedeng rempah-rempah untuk menggembalakan domba dalam kebun dan memetik bunga bakung."
 },
 {
   "id": 17622,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 3,
   "firman": "Aku kepunyaan kekasihku, dan kepunyaanku kekasihku, yang menggembalakan domba di tengah-tengah bunga bakung."
 },
 {
   "id": 17623,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 4,
   "firman": "Cantik engkau, manisku, seperti kota Tirza, juita seperti Yerusalem, dahsyat seperti bala tentara dengan panji-panjinya."
 },
 {
   "id": 17624,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 5,
   "firman": "Palingkanlah matamu dari padaku, sebab aku menjadi bingung karenanya. Rambutmu bagaikan kawanan kambing yang bergelombang turun dari Gilead."
 },
 {
   "id": 17625,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 6,
   "firman": "Gigimu bagaikan kawanan domba, yang keluar dari tempat pembasuhan, yang beranak kembar semuanya, yang tak beranak tak ada."
 },
 {
   "id": 17626,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 7,
   "firman": "Bagaikan belahan buah delima pelipismu di balik telekungmu."
 },
 {
   "id": 17627,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 8,
   "firman": "Permaisuri ada enam puluh, selir delapan puluh, dan dara-dara tak terbilang banyaknya."
 },
 {
   "id": 17628,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi dialah satu-satunya merpatiku, idam-idamanku, satu-satunya anak ibunya, anak kesayangan bagi yang melahirkannya; puteri-puteri melihatnya dan menyebutnya bahagia, permaisuri-permaisuri dan selir-selir memujinya."
 },
 {
   "id": 17629,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 10,
   "firman": "\"Siapakah dia yang muncul laksana fajar merekah, indah bagaikan bulan purnama, bercahaya bagaikan surya, dahsyat seperti bala tentara dengan panji-panjinya?\""
 },
 {
   "id": 17630,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 11,
   "firman": "Ke kebun kenari aku turun melihat kuntum-kuntum di lembah, melihat apakah pohon anggur berkuncup dan pohon-pohon delima berbunga."
 },
 {
   "id": 17631,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 12,
   "firman": "Tak sadar diri aku; kerinduanku menempatkan aku di atas kereta orang bangsawan."
 },
 {
   "id": 17632,
   "kitab": "Kid",
   "pasal": 6,
   "ayat": 13,
   "firman": "Kembalilah, kembalilah, ya gadis Sulam, kembalilah, kembalilah, supaya kami dapat melihat engkau! Mengapa kamu senang melihat gadis Sulam itu seperti melihat tari-tarian perang?"
 },
 {
   "id": 17633,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 1,
   "firman": "Betapa indah langkah-langkahmu dengan sandal-sandal itu, puteri yang berwatak luhur! Lengkung pinggangmu bagaikan perhiasan, karya tangan seniman."
 },
 {
   "id": 17634,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 2,
   "firman": "Pusarmu seperti cawan yang bulat, yang tak kekurangan anggur campur. Perutmu timbunan gandum, berpagar bunga-bunga bakung."
 },
 {
   "id": 17635,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 3,
   "firman": "Seperti dua anak rusa buah dadamu, seperti anak kembar kijang."
 },
 {
   "id": 17636,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 4,
   "firman": "Lehermu bagaikan menara gading, matamu bagaikan telaga di Hesybon, dekat pintu gerbang Batrabim; hidungmu seperti menara di gunung Libanon, yang menghadap ke kota Damsyik."
 },
 {
   "id": 17637,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 5,
   "firman": "Kepalamu seperti bukit Karmel, rambut kepalamu merah lembayung; seorang raja tertawan dalam kepang-kepangnya."
 },
 {
   "id": 17638,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 6,
   "firman": "Betapa cantik, betapa jelita engkau, hai tercinta di antara segala yang disenangi."
 },
 {
   "id": 17639,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 7,
   "firman": "Sosok tubuhmu seumpama pohon korma dan buah dadamu gugusannya."
 },
 {
   "id": 17640,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 8,
   "firman": "Kataku: \"Aku ingin memanjat pohon korma itu dan memegang gugusan-gugusannya Kiranya buah dadamu seperti gugusan anggur dan nafas hidungmu seperti buah apel."
 },
 {
   "id": 17641,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 9,
   "firman": "Kata-katamu manis bagaikan anggur!\" Ya, anggur itu mengalir kepada kekasihku dengan tak putus-putusnya, melimpah ke bibir orang-orang yang sedang tidur!"
 },
 {
   "id": 17642,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 10,
   "firman": "Kepunyaan kekasihku aku, kepadaku gairahnya tertuju."
 },
 {
   "id": 17643,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 11,
   "firman": "Mari, kekasihku, kita pergi ke padang, bermalam di antara bunga-bunga pacar!"
 },
 {
   "id": 17644,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 12,
   "firman": "Mari, kita pergi pagi-pagi ke kebun anggur dan melihat apakah pohon anggur sudah berkuncup, apakah sudah mekar bunganya, apakah pohon-pohon delima sudah berbunga! Di sanalah aku akan memberikan cintaku kepadamu!"
 },
 {
   "id": 17645,
   "kitab": "Kid",
   "pasal": 7,
   "ayat": 13,
   "firman": "Semerbak bau buah dudaim; dekat pintu kita ada pelbagai buah-buah yang lezat, yang telah lama dan yang baru saja dipetik. Itu telah kusimpan bagimu, kekasihku!"
 },
 {
   "id": 17646,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 1,
   "firman": "O, seandainya engkau saudaraku laki-laki, yang menyusu pada buah dada ibuku, akan kucium engkau bila kujumpai di luar, karena tak ada orang yang akan menghina aku!"
 },
 {
   "id": 17647,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 2,
   "firman": "Akan kubimbing engkau dan kubawa ke rumah ibuku, supaya engkau mengajar aku. Akan kuberi kepadamu anggur yang harum untuk diminum, air buah delimaku."
 },
 {
   "id": 17648,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 3,
   "firman": "Tangan kirinya ada di bawah kepalaku, tangan kanannya memeluk aku."
 },
 {
   "id": 17649,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 4,
   "firman": "Kusumpahi kamu, puteri-puteri Yerusalem: mengapa kamu membangkitkan dan menggerakkan cinta sebelum diingininya?"
 },
 {
   "id": 17650,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 5,
   "firman": "Siapakah dia yang muncul dari padang gurun, yang bersandar pada kekasihnya? --Di bawah pohon apel kubangunkan engkau, di sanalah ibumu telah mengandung engkau, di sanalah ia mengandung dan melahirkan engkau."
 },
 {
   "id": 17651,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 6,
   "firman": "--Taruhlah aku seperti meterai pada hatimu, seperti meterai pada lenganmu, karena cinta kuat seperti maut, kegairahan gigih seperti dunia orang mati, nyalanya adalah nyala api, seperti nyala api TUHAN!"
 },
 {
   "id": 17652,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 7,
   "firman": "Air yang banyak tak dapat memadamkan cinta, sungai-sungai tak dapat menghanyutkannya. Sekalipun orang memberi segala harta benda rumahnya untuk cinta, namun ia pasti akan dihina."
 },
 {
   "id": 17653,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 8,
   "firman": "--Kami mempunyai seorang adik perempuan, yang belum mempunyai buah dada. Apakah yang akan kami perbuat dengan adik perempuan kami pada hari ia dipinang?"
 },
 {
   "id": 17654,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 9,
   "firman": "Bila ia tembok, akan kami dirikan atap perak di atasnya; bila ia pintu, akan kami palangi dia dengan palang kayu aras."
 },
 {
   "id": 17655,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 10,
   "firman": "--Aku adalah suatu tembok dan buah dadaku bagaikan menara. Dalam matanya ketika itu aku bagaikan orang yang telah mendapat kebahagiaan."
 },
 {
   "id": 17656,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 11,
   "firman": "Salomo mempunyai kebun anggur di Baal-Hamon. Diserahkannya kebun anggur itu kepada para penjaga, masing-masing memberikan seribu keping perak untuk hasilnya."
 },
 {
   "id": 17657,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 12,
   "firman": "Kebun anggurku, yang punyaku sendiri, ada di hadapanku; bagimulah seribu keping itu, raja Salomo, dan dua ratus bagi orang-orang yang menjaga hasilnya."
 },
 {
   "id": 17658,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 13,
   "firman": "--Hai, penghuni kebun, teman-teman memperhatikan suaramu, perdengarkanlah itu kepadaku!"
 },
 {
   "id": 17659,
   "kitab": "Kid",
   "pasal": 8,
   "ayat": 14,
   "firman": "--Cepat, kekasihku, berlakulah seperti kijang, atau seperti anak rusa di atas gunung-gunung tanaman rempah-rempah."
 },
 {
   "id": 17660,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 1,
   "firman": "Penglihatan yang telah dilihat Yesaya bin Amos tentang Yehuda dan Yerusalem dalam zaman Uzia, Yotam, Ahas dan Hizkia, raja-raja Yehuda."
 },
 {
   "id": 17661,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 2,
   "firman": "Dengarlah, hai langit, dan perhatikanlah, hai bumi, sebab TUHAN berfirman: \"Aku membesarkan anak-anak dan mengasuhnya, tetapi mereka memberontak terhadap Aku."
 },
 {
   "id": 17662,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 3,
   "firman": "Lembu mengenal pemiliknya, tetapi Israel tidak; keledai mengenal palungan yang disediakan tuannya, tetapi umat-Ku tidak memahaminya.\""
 },
 {
   "id": 17663,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 4,
   "firman": "Celakalah bangsa yang berdosa, kaum yang sarat dengan kesalahan, keturunan yang jahat-jahat, anak-anak yang berlaku buruk! Mereka meninggalkan TUHAN, menista Yang Mahakudus, Allah Israel, dan berpaling membelakangi Dia."
 },
 {
   "id": 17664,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 5,
   "firman": "Di mana kamu mau dipukul lagi, kamu yang bertambah murtad? Seluruh kepala sakit dan seluruh hati lemah lesu."
 },
 {
   "id": 17665,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dari telapak kaki sampai kepala tidak ada yang sehat: bengkak dan bilur dan luka baru, tidak dipijit dan tidak dibalut dan tidak ditaruh minyak."
 },
 {
   "id": 17666,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 7,
   "firman": "Negerimu menjadi sunyi sepi, kota-kotamu habis terbakar; di depan matamu orang-orang asing memakan hasil dari tanahmu. Sunyi sepi negeri itu seolah-olah ditunggangbalikkan orang asing."
 },
 {
   "id": 17667,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 8,
   "firman": "Puteri Sion tertinggal sendirian seperti pondok di kebun anggur, seperti gubuk di kebun mentimun dan seperti kota yang terkepung."
 },
 {
   "id": 17668,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 9,
   "firman": "Seandainya TUHAN semesta alam tidak meninggalkan pada kita sedikit orang yang terlepas, kita sudah menjadi seperti Sodom, dan sama seperti Gomora."
 },
 {
   "id": 17669,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 10,
   "firman": "Dengarlah firman TUHAN, hai pemimpin-pemimpin, manusia Sodom! Perhatikanlah pengajaran Allah kita, hai rakyat, manusia Gomora!"
 },
 {
   "id": 17670,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 11,
   "firman": "\"Untuk apa itu korbanmu yang banyak-banyak?\" firman TUHAN; \"Aku sudah jemu akan korban-korban bakaran berupa domba jantan dan akan lemak dari anak lembu gemukan; darah lembu jantan dan domba-domba dan kambing jantan tidak Kusukai."
 },
 {
   "id": 17671,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 12,
   "firman": "Apabila kamu datang untuk menghadap di hadirat-Ku, siapakah yang menuntut itu dari padamu, bahwa kamu menginjak-injak pelataran Bait Suci-Ku?"
 },
 {
   "id": 17672,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 13,
   "firman": "Jangan lagi membawa persembahanmu yang tidak sungguh, sebab baunya adalah kejijikan bagi-Ku. Kalau kamu merayakan bulan baru dan sabat atau mengadakan pertemuan-pertemuan, Aku tidak tahan melihatnya, karena perayaanmu itu penuh kejahatan."
 },
 {
   "id": 17673,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 14,
   "firman": "Perayaan-perayaan bulan barumu dan pertemuan-pertemuanmu yang tetap, Aku benci melihatnya; semuanya itu menjadi beban bagi-Ku, Aku telah payah menanggungnya."
 },
 {
   "id": 17674,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 15,
   "firman": "Apabila kamu menadahkan tanganmu untuk berdoa, Aku akan memalingkan muka-Ku, bahkan sekalipun kamu berkali-kali berdoa, Aku tidak akan mendengarkannya, sebab tanganmu penuh dengan darah."
 },
 {
   "id": 17675,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 16,
   "firman": "Basuhlah, bersihkanlah dirimu, jauhkanlah perbuatan-perbuatanmu yang jahat dari depan mata-Ku. Berhentilah berbuat jahat,"
 },
 {
   "id": 17676,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 17,
   "firman": "belajarlah berbuat baik; usahakanlah keadilan, kendalikanlah orang kejam; belalah hak anak-anak yatim, perjuangkanlah perkara janda-janda!"
 },
 {
   "id": 17677,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 18,
   "firman": "Marilah, baiklah kita berperkara! --firman TUHAN--Sekalipun dosamu merah seperti kirmizi, akan menjadi putih seperti salju; sekalipun berwarna merah seperti kain kesumba, akan menjadi putih seperti bulu domba."
 },
 {
   "id": 17678,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 19,
   "firman": "Jika kamu menurut dan mau mendengar, maka kamu akan memakan hasil baik dari negeri itu."
 },
 {
   "id": 17679,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 20,
   "firman": "Tetapi jika kamu melawan dan memberontak, maka kamu akan dimakan oleh pedang.\" Sungguh, TUHAN yang mengucapkannya."
 },
 {
   "id": 17680,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 21,
   "firman": "Bagaimana ini, kota yang dahulu setia sekarang sudah menjadi sundal! Tadinya penuh keadilan dan di situ selalu diam kebenaran, tetapi sekarang penuh pembunuh."
 },
 {
   "id": 17681,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 22,
   "firman": "Perakmu tidak murni lagi dan arakmu bercampur air."
 },
 {
   "id": 17682,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 23,
   "firman": "Para pemimpinmu adalah pemberontak dan bersekongkol dengan pencuri. Semuanya suka menerima suap dan mengejar sogok. Mereka tidak membela hak anak-anak yatim, dan perkara janda-janda tidak sampai kepada mereka."
 },
 {
   "id": 17683,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 24,
   "firman": "Sebab itu demikianlah firman Tuhan, TUHAN semesta alam, Yang Mahakuat pelindung Israel; \"Ha, Aku akan melampiaskan dendam-Ku kepada para lawan-Ku, dan melakukan pembalasan kepada para musuh-Ku."
 },
 {
   "id": 17684,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 25,
   "firman": "Aku akan bertindak terhadap engkau: Aku akan memurnikan perakmu dengan garam soda, dan akan menyingkirkan segala timah dari padanya."
 },
 {
   "id": 17685,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 26,
   "firman": "Aku akan mengembalikan para hakimmu seperti dahulu, dan para penasihatmu seperti semula. Sesudah itu engkau akan disebutkan kota keadilan, kota yang setia.\""
 },
 {
   "id": 17686,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 27,
   "firman": "Sion akan Kubebaskan dengan penghakiman yang adil dan orang-orangnya yang bertobat akan Kubebaskan dengan tindakan yang benar."
 },
 {
   "id": 17687,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 28,
   "firman": "Tetapi orang-orang yang memberontak dan orang-orang berdosa akan dihancurkan bersama, dan orang-orang yang meninggalkan TUHAN akan habis lenyap."
 },
 {
   "id": 17688,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 29,
   "firman": "Sungguh, kamu akan mendapat malu karena pohon-pohon keramat yang kamu inginkan; dan kamu akan tersipu-sipu karena taman-taman dewa yang kamu pilih."
 },
 {
   "id": 17689,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 30,
   "firman": "Sebab kamu akan seperti pohon keramat yang daunnya layu, dan seperti kebun yang kekurangan air."
 },
 {
   "id": 17690,
   "kitab": "Yes",
   "pasal": 1,
   "ayat": 31,
   "firman": "Maka yang kuat menjadi seolah-olah kapas dan pekerjaannya menjadi seolah-olah bunga api; keduanya menimbulkan api dan tidak ada yang dapat memadamkan."
 },
 {
   "id": 17691,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 1,
   "firman": "Firman yang dinyatakan kepada Yesaya bin Amos tentang Yehuda dan Yerusalem."
 },
 {
   "id": 17692,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 2,
   "firman": "Akan terjadi pada hari-hari yang terakhir: gunung tempat rumah TUHAN akan berdiri tegak di hulu gunung-gunung dan menjulang tinggi di atas bukit-bukit; segala bangsa akan berduyun-duyun ke sana,"
 },
 {
   "id": 17693,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 3,
   "firman": "dan banyak suku bangsa akan pergi serta berkata: \"Mari, kita naik ke gunung TUHAN, ke rumah Allah Yakub, supaya Ia mengajar kita tentang jalan-jalan-Nya, dan supaya kita berjalan menempuhnya; sebab dari Sion akan keluar pengajaran dan firman TUHAN dari Yerusalem.\""
 },
 {
   "id": 17694,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 4,
   "firman": "Ia akan menjadi hakim antara bangsa-bangsa dan akan menjadi wasit bagi banyak suku bangsa; maka mereka akan menempa pedang-pedangnya menjadi mata bajak dan tombak-tombaknya menjadi pisau pemangkas; bangsa tidak akan lagi mengangkat pedang terhadap bangsa, dan mereka tidak akan lagi belajar perang."
 },
 {
   "id": 17695,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 5,
   "firman": "Hai kaum keturunan Yakub, mari kita berjalan di dalam terang TUHAN!"
 },
 {
   "id": 17696,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 6,
   "firman": "Sungguh, telah Kaubuang umat-Mu, yakni kaum keturunan Yakub, sebab di mana-mana mereka melakukan tenung seperti yang di Timur dan sihir seperti orang Filistin, dan orang-orang asing di antara mereka terlalu banyak."
 },
 {
   "id": 17697,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 7,
   "firman": "Negerinya penuh emas dan perak dan tak terbatas harta bendanya; negerinya penuh kuda dan tak terbatas jumlah keretanya."
 },
 {
   "id": 17698,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 8,
   "firman": "Negerinya penuh berhala-berhala; mereka sujud menyembah kepada buatan tangannya sendiri dan kepada yang dikerjakan oleh tangannya."
 },
 {
   "id": 17699,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka manusia ditundukkan dan orang direndahkan--janganlah ampuni mereka!"
 },
 {
   "id": 17700,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 10,
   "firman": "Masuklah di sela gunung batu dan bersembunyilah di dalam liang tanah terhadap kedahsyatan TUHAN dan terhadap semarak kemegahan-Nya!"
 },
 {
   "id": 17701,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 11,
   "firman": "Manusia yang sombong akan direndahkan, dan orang yang angkuh akan ditundukkan; dan hanya TUHAN sajalah yang maha tinggi pada hari itu."
 },
 {
   "id": 17702,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 12,
   "firman": "Sebab TUHAN semesta alam menetapkan suatu hari untuk menghukum semua yang congkak dan angkuh serta menghukum semua yang meninggikan diri, supaya direndahkan;"
 },
 {
   "id": 17703,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 13,
   "firman": "untuk menghukum semua pohon aras di Libanon yang tumbuh meninggi dan tetap menjulang, dan menghukum semua pohon tarbantin di Basan;"
 },
 {
   "id": 17704,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 14,
   "firman": "untuk menghukum semua gunung yang tinggi-tinggi dan semua bukit yang menjulang ke atas;"
 },
 {
   "id": 17705,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 15,
   "firman": "untuk menghukum semua menara yang tinggi-tinggi dan semua tembok yang berkubu;"
 },
 {
   "id": 17706,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 16,
   "firman": "untuk menghukum semua kapal Tarsis dan semua kapal yang paling indah."
 },
 {
   "id": 17707,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 17,
   "firman": "Manusia yang sombong akan ditundukkan dan orang yang angkuh akan direndahkan; hanya TUHAN sajalah yang maha tinggi pada hari itu."
 },
 {
   "id": 17708,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 18,
   "firman": "Sedang berhala-berhala akan hilang sama sekali."
 },
 {
   "id": 17709,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 19,
   "firman": "Maka orang akan masuk ke dalam gua-gua di gunung batu dan ke dalam liang-liang di tanah terhadap kedahsyatan TUHAN dan terhadap semarak kemegahan-Nya, pada waktu Ia bangkit menakut-nakuti bumi."
 },
 {
   "id": 17710,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 20,
   "firman": "Pada hari itu berhala-berhala perak dan berhala-berhala emas yang dibuat manusia untuk sujud menyembah kepadanya akan dilemparkannya kepada tikus dan kelelawar,"
 },
 {
   "id": 17711,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 21,
   "firman": "dan ia akan masuk ke dalam lekuk-lekuk di gunung batu dan ke dalam celah-celah di bukit batu terhadap kedahsyatan TUHAN dan terhadap semarak kemegahan-Nya, pada waktu Ia bangkit menakut-nakuti bumi."
 },
 {
   "id": 17712,
   "kitab": "Yes",
   "pasal": 2,
   "ayat": 22,
   "firman": "Jangan berharap pada manusia, sebab ia tidak lebih dari pada embusan nafas, dan sebagai apakah ia dapat dianggap?"
 },
 {
   "id": 17713,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 1,
   "firman": "Maka sesungguhnya Tuhan, TUHAN semesta alam, akan menjauhkan dari Yerusalem dan dari Yehuda setiap orang yang mereka andalkan, segala persediaan makanan dan minuman:"
 },
 {
   "id": 17714,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 2,
   "firman": "pahlawan dan orang perang, hakim dan nabi, petenung dan tua-tua,"
 },
 {
   "id": 17715,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 3,
   "firman": "perwira dan orang yang terpandang, penasihat dan ahli sihir, dan orang yang paham mantera."
 },
 {
   "id": 17716,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 4,
   "firman": "Aku akan mengangkat pemuda-pemuda menjadi pemimpin mereka, dan anak-anak akan memerintah atas mereka."
 },
 {
   "id": 17717,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 5,
   "firman": "Maka bangsa itu akan desak-mendesak, seorang kepada seorang, yang satu kepada yang lain; orang muda akan membentak-bentak terhadap orang tua, orang hina terhadap orang mulia."
 },
 {
   "id": 17718,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sehingga apabila seorang memegang saudaranya di rumah ayahnya dan berkata: \"Engkau masih mempunyai jubah, jadilah pemimpin kami, dan reruntuhan ini di bawah kuasamu\","
 },
 {
   "id": 17719,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 7,
   "firman": "maka pada waktu itu saudaranya akan menjawab: \"Aku tidak mau menjadi tabib; di rumahku tidak ada roti dan tidak ada jubah; janganlah angkat aku menjadi pemimpin bangsa.\""
 },
 {
   "id": 17720,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 8,
   "firman": "Sungguh, Yerusalem telah runtuh dan Yehuda telah rubuh; sebab perkataan mereka dan perbuatan mereka melawan TUHAN dan mereka menantang kemuliaan hadirat-Nya."
 },
 {
   "id": 17721,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 9,
   "firman": "Air muka mereka menyatakan kejahatan mereka, dan seperti orang Sodom, mereka dengan terang-terangan menyebut-nyebut dosanya, tidak lagi disembunyikannya. Celakalah orang-orang itu! Sebab mereka mendatangkan malapetaka kepada dirinya sendiri."
 },
 {
   "id": 17722,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 10,
   "firman": "Katakanlah berbahagia orang benar! Sebab mereka akan memakan hasil pekerjaannya."
 },
 {
   "id": 17723,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 11,
   "firman": "Celakalah orang fasik! Malapetaka akan menimpanya, sebab mereka akan diperlakukan menurut perbuatannya sendiri."
 },
 {
   "id": 17724,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 12,
   "firman": "Adapun umat-Ku, penguasa mereka ialah anak-anak, dan perempuan-perempuan memerintah atasnya. Hai umat-Ku, pemimpin-pemimpinmu adalah penyesat, dan jalan yang kamu tempuh mereka kacaukan!"
 },
 {
   "id": 17725,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 13,
   "firman": "TUHAN mengambil tempat untuk menuntut dan berdiri untuk mengadili bangsa-bangsa."
 },
 {
   "id": 17726,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 14,
   "firman": "TUHAN bertindak sebagai hakim atas tua-tua dan pemimpin-pemimpin umat-Nya: \"Kamulah yang memusnahkan kebun anggur itu, barang rampasan dari orang yang tertindas tertumpuk di dalam rumahmu."
 },
 {
   "id": 17727,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 15,
   "firman": "Mengapa kamu menyiksa umat-Ku dan menganiaya orang-orang yang tertindas?\" demikianlah firman Tuhan ALLAH semesta alam."
 },
 {
   "id": 17728,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 16,
   "firman": "TUHAN berfirman: Oleh karena wanita Sion telah menjadi sombong dan telah berjalan dengan jenjang leher dan dengan main mata, berjalan dengan dibuat-buat langkahnya dan gemerencing dengan giring-giring kakinya,"
 },
 {
   "id": 17729,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 17,
   "firman": "maka Tuhan akan membuat batu kepala wanita Sion penuh kudis dan TUHAN akan mencukur rambut sebelah dahi mereka."
 },
 {
   "id": 17730,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 18,
   "firman": "Pada waktu itu Tuhan akan menjauhkan segala perhiasan mereka: gelang-gelang kaki, jamang-jamang dan bulan-bulanan;"
 },
 {
   "id": 17731,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 19,
   "firman": "perhiasan-perhiasan telinga, pontoh-pontoh dan kerudung-kerudung;"
 },
 {
   "id": 17732,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 20,
   "firman": "perhiasan-perhiasan kepala, gelang-gelang rantai kaki, tali-tali pinggang, tempat-tempat wewangian dan jimat-jimat;"
 },
 {
   "id": 17733,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 21,
   "firman": "cincin meterai dan anting-anting hidung;"
 },
 {
   "id": 17734,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 22,
   "firman": "pakaian-pakaian pesta, jubah-jubah, selendang-selendang dan pundi-pundi;"
 },
 {
   "id": 17735,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 23,
   "firman": "cermin-cermin, baju-baju dalam dari kain lenan, ikat-ikat kepala dan baju-baju luar."
 },
 {
   "id": 17736,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 24,
   "firman": "Maka sebagai ganti rempah-rempah harum akan ada bau busuk, sebagai ganti ikat pinggang seutas tali, sebagai ganti selampit rambut kepala yang gundul, sebagai ganti pakaian hari raya sehelai kain kabung; dan tanda selar sebagai ganti kemolekan."
 },
 {
   "id": 17737,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 25,
   "firman": "Orang-orangmu akan tewas oleh pedang, dan pahlawan-pahlawanmu oleh perang."
 },
 {
   "id": 17738,
   "kitab": "Yes",
   "pasal": 3,
   "ayat": 26,
   "firman": "Pintu-pintu gerbang Sion akan mengaduh dan berkabung, dan kota itu akan seperti perempuan bulus yang duduk di bumi."
 },
 {
   "id": 17739,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 1,
   "firman": "Pada waktu itu tujuh orang perempuan akan memegang seorang laki-laki, serta berkata: \"Kami akan menanggung makanan dan pakaian kami sendiri; hanya biarlah namamu dilekatkan kepada nama kami; ambillah aib yang ada pada kami!\""
 },
 {
   "id": 17740,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 2,
   "firman": "Pada waktu itu tunas yang ditumbuhkan TUHAN akan menjadi kepermaian dan kemuliaan, dan hasil tanah menjadi kebanggaan dan kehormatan bagi orang-orang Israel yang terluput."
 },
 {
   "id": 17741,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 3,
   "firman": "Dan orang yang tertinggal di Sion dan yang tersisa di Yerusalem akan disebut kudus, yakni setiap orang di Yerusalem yang tercatat untuk beroleh hidup,"
 },
 {
   "id": 17742,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 4,
   "firman": "apabila TUHAN telah membersihkan kekotoran puteri Sion dan menghapuskan segala noda darah Yerusalem dari tengah-tengahnya dengan roh yang mengadili dan yang membakar."
 },
 {
   "id": 17743,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 5,
   "firman": "Maka TUHAN akan menjadikan di atas seluruh wilayah gunung Sion dan di atas setiap pertemuan yang diadakan di situ segumpal awan pada waktu siang dan segumpal asap serta sinar api yang menyala-nyala pada waktu malam, sebab di atas semuanya itu akan ada kemuliaan TUHAN sebagai tudung"
 },
 {
   "id": 17744,
   "kitab": "Yes",
   "pasal": 4,
   "ayat": 6,
   "firman": "dan sebagai pondok tempat bernaung pada waktu siang terhadap panas terik dan sebagai perlindungan dan persembunyian terhadap angin ribut dan hujan."
 },
 {
   "id": 17745,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 1,
   "firman": "Aku hendak menyanyikan nyanyian tentang kekasihku, nyanyian kekasihku tentang kebun anggurnya: Kekasihku itu mempunyai kebun anggur di lereng bukit yang subur."
 },
 {
   "id": 17746,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 2,
   "firman": "Ia mencangkulnya dan membuang batu-batunya, dan menanaminya dengan pokok anggur pilihan; ia mendirikan sebuah menara jaga di tengah-tengahnya dan menggali lobang tempat memeras anggur; lalu dinantinya supaya kebun itu menghasilkan buah anggur yang baik, tetapi yang dihasilkannya ialah buah anggur yang asam."
 },
 {
   "id": 17747,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 3,
   "firman": "Maka sekarang, hai penduduk Yerusalem, dan orang Yehuda, adililah antara Aku dan kebun anggur-Ku itu."
 },
 {
   "id": 17748,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 4,
   "firman": "Apatah lagi yang harus diperbuat untuk kebun anggur-Ku itu, yang belum Kuperbuat kepadanya? Aku menanti supaya dihasilkannya buah anggur yang baik, mengapa yang dihasilkannya hanya buah anggur yang asam?"
 },
 {
   "id": 17749,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 5,
   "firman": "Maka sekarang, Aku mau memberitahukan kepadamu apa yang hendak Kulakukan kepada kebun anggur-Ku itu: Aku akan menebang pagar durinya, sehingga kebun itu dimakan habis, dan melanda temboknya, sehingga kebun itu diinjak-injak;"
 },
 {
   "id": 17750,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 6,
   "firman": "Aku akan membuatnya ditumbuhi semak-semak, tidak dirantingi dan tidak disiangi, sehingga tumbuh puteri malu dan rumput; Aku akan memerintahkan awan-awan, supaya jangan diturunkannya hujan ke atasnya."
 },
 {
   "id": 17751,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab kebun anggur TUHAN semesta alam ialah kaum Israel, dan orang Yehuda ialah tanam-tanaman kegemaran-Nya; dinanti-Nya keadilan, tetapi hanya ada kelaliman, dinanti-Nya kebenaran tetapi hanya ada keonaran."
 },
 {
   "id": 17752,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 8,
   "firman": "Celakalah mereka yang menyerobot rumah demi rumah dan mencekau ladang demi ladang, sehingga tidak ada lagi tempat bagi orang lain dan hanya kamu sendiri yang tinggal di dalam negeri!"
 },
 {
   "id": 17753,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 9,
   "firman": "Di telingaku terdengar firman TUHAN semesta alam: \"Sesungguhnya banyak rumah akan menjadi sunyi sepi; rumah-rumah yang besar dan yang baik tidak akan ada penghuninya."
 },
 {
   "id": 17754,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sebab kebun anggur yang luasnya sepuluh hari membajak akan menghasilkan hanya satu bat anggur; dan satu homer benih akan menghasilkan hanya satu efa gandum.\""
 },
 {
   "id": 17755,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 11,
   "firman": "Celakalah mereka yang bangun pagi-pagi dan terus mencari minuman keras, dan duduk-duduk sampai malam hari, sedang badannya dihangatkan anggur!"
 },
 {
   "id": 17756,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 12,
   "firman": "Kecapi dan gambus, rebana dan suling, serta anggur terdapat dalam perjamuan-perjamuan mereka, tetapi perbuatan TUHAN tidak dipandangnya dan pekerjaan TUHAN tidak dilihatnya."
 },
 {
   "id": 17757,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 13,
   "firman": "Sebab itu umat-Ku harus pergi ke dalam pembuangan, oleh sebab mereka tidak mengerti apa-apa; orang-orang yang mulia akan mati kelaparan, dan khalayak ramai akan menderita kehausan."
 },
 {
   "id": 17758,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sebab itu dunia orang mati akan membuka kerongkongannya lapang-lapang dan akan mengangakan mulutnya lebar-lebar dengan tiada terhingga, sehingga lenyap ke dalamnya segala kesemarakan dan keramaian Yerusalem, segala kegaduhannya dan orang-orang yang bersukaria di kota itu."
 },
 {
   "id": 17759,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 15,
   "firman": "Maka manusia akan ditundukkan, dan orang akan direndahkan, ya, orang-orang sombong akan direndahkan."
 },
 {
   "id": 17760,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 16,
   "firman": "Tetapi TUHAN semesta alam akan ternyata maha tinggi dalam keadilan-Nya, dan Allah yang maha kudus akan menyatakan kekudusan-Nya dalam kebenaran-Nya."
 },
 {
   "id": 17761,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 17,
   "firman": "Maka domba-domba akan makan rumput di situ seperti di padangnya sendiri dan kambing-kambing akan mencari makan dalam reruntuhan gedung-gedung orang kaya."
 },
 {
   "id": 17762,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 18,
   "firman": "Celakalah mereka yang memancing kesalahan dengan tali kedustaan dan dosa seperti dengan tali gerobak,"
 },
 {
   "id": 17763,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 19,
   "firman": "yang berkata: \"Baiklah Allah lekas-lekas dan cepat-cepat melakukan tindakan-Nya, supaya kita lihat; dan baiklah keputusan Yang Mahakudus, Allah Israel, datang mendekat, supaya kita tahu.\""
 },
 {
   "id": 17764,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 20,
   "firman": "Celakalah mereka yang menyebutkan kejahatan itu baik dan kebaikan itu jahat, yang mengubah kegelapan menjadi terang dan terang menjadi kegelapan, yang mengubah pahit menjadi manis, dan manis menjadi pahit."
 },
 {
   "id": 17765,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 21,
   "firman": "Celakalah mereka yang memandang dirinya bijaksana, yang menganggap dirinya pintar!"
 },
 {
   "id": 17766,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 22,
   "firman": "Celakalah mereka yang menjadi jago minum dan juara dalam mencampur minuman keras;"
 },
 {
   "id": 17767,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 23,
   "firman": "yang membenarkan orang fasik karena suap dan yang memungkiri hak orang benar."
 },
 {
   "id": 17768,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 24,
   "firman": "Sebab itu seperti lidah api memakan jerami, dan seperti rumput kering habis lenyap dalam nyala api, demikian akar-akar mereka akan menjadi busuk, dan kuntumnya akan beterbangan seperti abu, oleh karena mereka telah menolak pengajaran TUHAN semesta alam dan menista firman Yang Mahakudus, Allah Israel."
 },
 {
   "id": 17769,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 25,
   "firman": "Sebab itu bangkitlah murka TUHAN terhadap umat-Nya, diacungkan-Nya tangan-Nya terhadap mereka dan dipukul-Nya mereka; gunung-gunung akan gemetar, dan mayat-mayat mereka akan seperti kotoran di tengah jalan. Sekalipun semuanya ini terjadi, murka-Nya belum surut, dan tangan-Nya masih teracung."
 },
 {
   "id": 17770,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 26,
   "firman": "Ia akan melambaikan panji-panji kepada bangsa yang dari jauh, dan akan bersuit memanggil mereka dari ujung bumi; sesungguhnya mereka akan datang dengan segera, dengan cepat!"
 },
 {
   "id": 17771,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 27,
   "firman": "Tiada yang lelah dan tiada yang tersandung di antaranya; mereka tidak terlelap dan tidak tertidur, tidak terlepas ikat pinggangnya dan tali kasutnya tidak terputus;"
 },
 {
   "id": 17772,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 28,
   "firman": "anak panahnya ditajamkan, dan segala busurnya dilentur; kuku kudanya keras seperti batu api dan roda keretanya seperti puting beliung."
 },
 {
   "id": 17773,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 29,
   "firman": "Aumnya seperti singa betina, mereka mengaum seperti singa muda; mereka meraung dan menangkap mangsanya, membawanya lari dan tidak ada yang melepaskan."
 },
 {
   "id": 17774,
   "kitab": "Yes",
   "pasal": 5,
   "ayat": 30,
   "firman": "Pada hari itu mereka akan diliputi oleh suara seperti suara laut menderu. Jika orang memandang ke bumi, sesungguhnya, ada gelap yang menyesakkan, dan terang menjadi gelap oleh awan-awan!"
 },
 {
   "id": 17775,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 1,
   "firman": "Dalam tahun matinya raja Uzia aku melihat Tuhan duduk di atas takhta yang tinggi dan menjulang, dan ujung jubah-Nya memenuhi Bait Suci."
 },
 {
   "id": 17776,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 2,
   "firman": "Para Serafim berdiri di sebelah atas-Nya, masing-masing mempunyai enam sayap; dua sayap dipakai untuk menutupi muka mereka, dua sayap dipakai untuk menutupi kaki mereka dan dua sayap dipakai untuk melayang-layang."
 },
 {
   "id": 17777,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 3,
   "firman": "Dan mereka berseru seorang kepada seorang, katanya: \"Kudus, kudus, kuduslah TUHAN semesta alam, seluruh bumi penuh kemuliaan-Nya!\""
 },
 {
   "id": 17778,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 4,
   "firman": "Maka bergoyanglah alas ambang pintu disebabkan suara orang yang berseru itu dan rumah itupun penuhlah dengan asap."
 },
 {
   "id": 17779,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 5,
   "firman": "Lalu kataku: \"Celakalah aku! aku binasa! Sebab aku ini seorang yang najis bibir, dan aku tinggal di tengah-tengah bangsa yang najis bibir, namun mataku telah melihat Sang Raja, yakni TUHAN semesta alam.\""
 },
 {
   "id": 17780,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 6,
   "firman": "Tetapi seorang dari pada Serafim itu terbang mendapatkan aku; di tangannya ada bara, yang diambilnya dengan sepit dari atas mezbah."
 },
 {
   "id": 17781,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 7,
   "firman": "Ia menyentuhkannya kepada mulutku serta berkata: \"Lihat, ini telah menyentuh bibirmu, maka kesalahanmu telah dihapus dan dosamu telah diampuni.\""
 },
 {
   "id": 17782,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 8,
   "firman": "Lalu aku mendengar suara Tuhan berkata: \"Siapakah yang akan Kuutus, dan siapakah yang mau pergi untuk Aku?\" Maka sahutku: \"Ini aku, utuslah aku!\""
 },
 {
   "id": 17783,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 9,
   "firman": "Kemudian firman-Nya: \"Pergilah, dan katakanlah kepada bangsa ini: Dengarlah sungguh-sungguh, tetapi mengerti: jangan! Lihatlah sungguh-sungguh, tetapi menanggap: jangan!"
 },
 {
   "id": 17784,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 10,
   "firman": "Buatlah hati bangsa ini keras dan buatlah telinganya berat mendengar dan buatlah matanya melekat tertutup, supaya jangan mereka melihat dengan matanya dan mendengar dengan telinganya dan mengerti dengan hatinya, lalu berbalik dan menjadi sembuh.\""
 },
 {
   "id": 17785,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 11,
   "firman": "Kemudian aku bertanya: \"Sampai berapa lama, ya Tuhan?\" Lalu jawab-Nya: \"Sampai kota-kota telah lengang sunyi sepi, tidak ada lagi yang mendiami, dan di rumah-rumah tidak ada lagi manusia dan tanah menjadi sunyi dan sepi."
 },
 {
   "id": 17786,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 12,
   "firman": "TUHAN akan menyingkirkan manusia jauh-jauh, sehingga hampir seluruh negeri menjadi kosong."
 },
 {
   "id": 17787,
   "kitab": "Yes",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan jika di situ masih tinggal sepersepuluh dari mereka, mereka harus sekali lagi ditimpa kebinasaan, namun keadaannya akan seperti pohon beringin dan pohon jawi-jawi yang tunggulnya tinggal berdiri pada waktu ditebang. Dan dari tunggul itulah akan keluar tunas yang kudus!\""
 },
 {
   "id": 17788,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 1,
   "firman": "Dalam zaman Ahas bin Yotam bin Uzia, raja Yehuda, maka Rezin, raja Aram, dengan Pekah bin Remalya, raja Israel, maju ke Yerusalem untuk berperang melawan kota itu, namun mereka tidak dapat mengalahkannya."
 },
 {
   "id": 17789,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 2,
   "firman": "Lalu diberitahukanlah kepada keluarga Daud: \"Aram telah berkemah di wilayah Efraim,\" maka hati Ahas dan hati rakyatnya gemetar ketakutan seperti pohon-pohon hutan bergoyang ditiup angin."
 },
 {
   "id": 17790,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 3,
   "firman": "Berfirmanlah TUHAN kepada Yesaya: \"Baiklah engkau keluar menemui Ahas, engkau dan Syear Yasyub, anakmu laki-laki, ke ujung saluran kolam atas, ke jalan raya pada Padang Tukang Penatu,"
 },
 {
   "id": 17791,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 4,
   "firman": "dan katakanlah kepadanya: Teguhkanlah hatimu dan tinggallah tenang, janganlah takut dan janganlah hatimu kecut karena kedua puntung kayu api yang berasap ini, yaitu kepanasan amarah Rezin dengan Aram dan anak Remalya."
 },
 {
   "id": 17792,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 5,
   "firman": "Oleh karena Aram dan Efraim dengan anak Remalya telah merancang yang jahat atasmu, dengan berkata:"
 },
 {
   "id": 17793,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 6,
   "firman": "Marilah kita maju menyerang Yehuda dan menakut-nakutinya serta merebutnya, kemudian mengangkat anak Tabeel sebagai raja di tengah-tengahnya,"
 },
 {
   "id": 17794,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 7,
   "firman": "maka beginilah firman Tuhan ALLAH: Tidak akan sampai hal itu, dan tidak akan terjadi,"
 },
 {
   "id": 17795,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 8,
   "firman": "sebab Damsyik ialah ibu kota Aram, dan Rezin ialah kepala Damsyik. Dalam enam puluh lima tahun Efraim akan pecah, tidak menjadi bangsa lagi."
 },
 {
   "id": 17796,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 9,
   "firman": "Dan Samaria ialah ibu kota Efraim, dan anak Remalya ialah kepala Samaria. Jika kamu tidak percaya, sungguh, kamu tidak teguh jaya.\""
 },
 {
   "id": 17797,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 10,
   "firman": "TUHAN melanjutkan firman-Nya kepada Ahas, kata-Nya:"
 },
 {
   "id": 17798,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 11,
   "firman": "\"Mintalah suatu pertanda dari TUHAN, Allahmu, biarlah itu sesuatu dari dunia orang mati yang paling bawah atau sesuatu dari tempat tertinggi yang di atas.\""
 },
 {
   "id": 17799,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 12,
   "firman": "Tetapi Ahas menjawab: \"Aku tidak mau meminta, aku tidak mau mencobai TUHAN.\""
 },
 {
   "id": 17800,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 13,
   "firman": "Lalu berkatalah nabi Yesaya: \"Baiklah dengarkan, hai keluarga Daud! Belum cukupkah kamu melelahkan orang, sehingga kamu melelahkan Allahku juga?"
 },
 {
   "id": 17801,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 14,
   "firman": "Sebab itu Tuhan sendirilah yang akan memberikan kepadamu suatu pertanda: Sesungguhnya, seorang perempuan muda mengandung dan akan melahirkan seorang anak laki-laki, dan ia akan menamakan Dia Imanuel."
 },
 {
   "id": 17802,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 15,
   "firman": "Ia akan makan dadih dan madu sampai ia tahu menolak yang jahat dan memilih yang baik,"
 },
 {
   "id": 17803,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 16,
   "firman": "sebab sebelum anak itu tahu menolak yang jahat dan memilih yang baik, maka negeri yang kedua rajanya engkau takuti akan ditinggalkan kosong."
 },
 {
   "id": 17804,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 17,
   "firman": "TUHAN akan mendatangkan atasmu dan atas rakyatmu dan atas kaum keluargamu hari-hari seperti yang belum pernah datang sejak Efraim menjauhkan diri dari Yehuda--yakni raja Asyur.\""
 },
 {
   "id": 17805,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 18,
   "firman": "Pada hari itu akan terjadi: TUHAN bersuit memanggil lalat yang ada di ujung anak-anak sungai Nil, dan memanggil lebah yang ada di tanah Asyur."
 },
 {
   "id": 17806,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 19,
   "firman": "Dan semuanya akan datang hinggap di lembah-lembah yang terjal dan di celah-celah bukit-bukit batu, di segala pagar duri dan di segala tanah penggembalaan."
 },
 {
   "id": 17807,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 20,
   "firman": "Pada hari itu dengan pisau cukur yang dipinjam dari seberang sungai Efrat, yakni raja Asyur, Tuhan akan mencukur kepala dan bulu paha, bahkan pisau itu akan melenyapkan janggut juga."
 },
 {
   "id": 17808,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 21,
   "firman": "Pada hari itu setiap orang akan memiara seekor lembu betina yang muda dan dua ekor domba,"
 },
 {
   "id": 17809,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 22,
   "firman": "dan karena banyaknya susu yang dihasilkan, mereka akan makan dadih; sungguh, dadih dan madu akan dimakan oleh setiap orang yang masih tinggal di dalam negeri."
 },
 {
   "id": 17810,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 23,
   "firman": "Pada hari itu setiap tempat, di mana biasanya tumbuh seribu pohon anggur dan yang berharga seribu syikal perak, akan menjadi tempat puteri malu dan rumput."
 },
 {
   "id": 17811,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 24,
   "firman": "Orang pergi ke sana terpaksa membawa anak-anak panah dan busur, sebab puteri malu dan rumput belaka seluruh negeri itu."
 },
 {
   "id": 17812,
   "kitab": "Yes",
   "pasal": 7,
   "ayat": 25,
   "firman": "Dan engkau tidak berani pergi ke segala lereng gunung yang biasanya dicangkul, karena takut akan puteri malu dan rumput; di situ hanya lembu dan domba akan berkeliaran."
 },
 {
   "id": 17813,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepadaku: \"Ambillah sebuah batu tulis besar dan tuliskanlah di atasnya dengan tulisan biasa: Maher-Syalal Hash-Bas.\""
 },
 {
   "id": 17814,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 2,
   "firman": "Maka aku memanggil dua saksi yang dapat dipercaya, yaitu imam Uria dan Zakharia bin Yeberekhya."
 },
 {
   "id": 17815,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 3,
   "firman": "Kemudian aku menghampiri isteriku; ia mengandung dan melahirkan seorang anak laki-laki. Lalu berfirmanlah TUHAN kepadaku: \"Namailah dia: Maher-Syalal Hash-Bas,"
 },
 {
   "id": 17816,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 4,
   "firman": "sebab sebelum anak itu tahu memanggil: Bapa! Ibu! maka kekayaan Damsyik dan jarahan Samaria akan diangkut di depan raja Asyur.\""
 },
 {
   "id": 17817,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 5,
   "firman": "TUHAN melanjutkan lagi firman-Nya kepadaku:"
 },
 {
   "id": 17818,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 6,
   "firman": "\"Oleh karena bangsa ini telah menolak air Syiloah yang mengalir lamban, dan telah tawar hati terhadap Rezin dan anak Remalya,"
 },
 {
   "id": 17819,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 7,
   "firman": "sebab itu, sesungguhnya, Tuhan akan membuat air sungai Efrat yang kuat dan besar, meluap-luap atas mereka, yaitu raja Asyur dengan segala kemuliaannya; air ini akan meluap melampaui segenap salurannya dan akan mengalir melampaui segenap tebingnya,"
 },
 {
   "id": 17820,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 8,
   "firman": "serta menerobos masuk ke Yehuda, ibarat banjir yang meluap-luap hingga sampai ke leher; dan sayap-sayapnya yang dikembangkan akan menutup seantero negerimu, ya Imanuel!\""
 },
 {
   "id": 17821,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 9,
   "firman": "Ketahuilah, hai bangsa-bangsa, dan terkejutlah, perhatikanlah, ya segala pelosok bumi, berikatpingganglah, dan terkejutlah; berikatpingganglah dan terkejutlah!"
 },
 {
   "id": 17822,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 10,
   "firman": "Buatlah rancangan, tetapi akan gagal juga; ambillah keputusan, tetapi tidak terlaksana juga, sebab Allah menyertai kami!"
 },
 {
   "id": 17823,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 11,
   "firman": "Sebab beginilah firman TUHAN kepadaku, ketika tangan-Nya menguasai aku, dan ketika Ia memperingatkan aku, supaya jangan mengikuti tingkah laku bangsa ini:"
 },
 {
   "id": 17824,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 12,
   "firman": "\"Jangan sebut persepakatan segala apa yang disebut bangsa ini persepakatan, dan apa yang mereka takuti janganlah kamu takuti dan janganlah gentar melihatnya."
 },
 {
   "id": 17825,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 13,
   "firman": "Tetapi TUHAN semesta alam, Dialah yang harus kamu akui sebagai Yang Kudus; kepada-Nyalah harus kamu takut dan terhadap Dialah harus kamu gentar."
 },
 {
   "id": 17826,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 14,
   "firman": "Ia akan menjadi tempat kudus, tetapi juga menjadi batu sentuhan dan batu sandungan bagi kedua kaum Israel itu, serta menjadi jerat dan perangkap bagi penduduk Yerusalem."
 },
 {
   "id": 17827,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 15,
   "firman": "Dan banyak di antara mereka akan tersandung, jatuh dan luka parah, tertangkap dan tertawan.\""
 },
 {
   "id": 17828,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 16,
   "firman": "Aku harus menyimpan kesaksian ini dan memeteraikan pengajaran ini di antara murid-muridku."
 },
 {
   "id": 17829,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 17,
   "firman": "Dan aku hendak menanti-nantikan TUHAN yang menyembunyikan wajah-Nya terhadap kaum keturunan Yakub; aku hendak mengharapkan Dia."
 },
 {
   "id": 17830,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 18,
   "firman": "Sesungguhnya, aku dan anak-anak yang telah diberikan TUHAN kepadaku adalah tanda dan alamat di antara orang Israel dari TUHAN semesta alam yang diam di gunung Sion."
 },
 {
   "id": 17831,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 19,
   "firman": "Dan apabila orang berkata kepada kamu: \"Mintalah petunjuk kepada arwah dan roh-roh peramal yang berbisik-bisik dan komat-kamit,\" maka jawablah: \"Bukankah suatu bangsa patut meminta petunjuk kepada allahnya? Atau haruskah mereka meminta petunjuk kepada orang-orang mati bagi orang-orang hidup?\""
 },
 {
   "id": 17832,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 20,
   "firman": "\"Carilah pengajaran dan kesaksian!\" Siapa yang tidak berbicara sesuai dengan perkataan itu, maka baginya tidak terbit fajar."
 },
 {
   "id": 17833,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 21,
   "firman": "Mereka akan lalu lalang di negeri itu, melarat dan lapar, dan apabila mereka lapar, mereka akan gusar dan akan mengutuk rajanya dan Allahnya; mereka akan menengadah ke langit,"
 },
 {
   "id": 17834,
   "kitab": "Yes",
   "pasal": 8,
   "ayat": 22,
   "firman": "dan akan melihat ke bumi, dan sesungguhnya, hanya kesesakan dan kegelapan, kesuraman yang mengimpit, dan mereka akan dibuang ke dalam kabut."
 },
 {
   "id": 17835,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 1,
   "firman": "(8-23) Tetapi tidak selamanya akan ada kesuraman untuk negeri yang terimpit itu. Kalau dahulu TUHAN merendahkan tanah Zebulon dan tanah Naftali, maka di kemudian hari Ia akan memuliakan jalan ke laut, daerah seberang sungai Yordan, wilayah bangsa-bangsa lain."
 },
 {
   "id": 17836,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 2,
   "firman": "(9-1) Bangsa yang berjalan di dalam kegelapan telah melihat terang yang besar; mereka yang diam di negeri kekelaman, atasnya terang telah bersinar."
 },
 {
   "id": 17837,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 3,
   "firman": "(9-2) Engkau telah menimbulkan banyak sorak-sorak, dan sukacita yang besar; mereka telah bersukacita di hadapan-Mu, seperti sukacita di waktu panen, seperti orang bersorak-sorak di waktu membagi-bagi jarahan."
 },
 {
   "id": 17838,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 4,
   "firman": "(9-3) Sebab kuk yang menekannya dan gandar yang di atas bahunya serta tongkat si penindas telah Kaupatahkan seperti pada hari kekalahan Midian."
 },
 {
   "id": 17839,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 5,
   "firman": "(9-4) Sebab setiap sepatu tentara yang berderap-derap dan setiap jubah yang berlumuran darah akan menjadi umpan api."
 },
 {
   "id": 17840,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 6,
   "firman": "(9-5) Sebab seorang anak telah lahir untuk kita, seorang putera telah diberikan untuk kita; lambang pemerintahan ada di atas bahunya, dan namanya disebutkan orang: Penasihat Ajaib, Allah yang Perkasa, Bapa yang Kekal, Raja Damai."
 },
 {
   "id": 17841,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 7,
   "firman": "(9-6) Besar kekuasaannya, dan damai sejahtera tidak akan berkesudahan di atas takhta Daud dan di dalam kerajaannya, karena ia mendasarkan dan mengokohkannya dengan keadilan dan kebenaran dari sekarang sampai selama-lamanya. Kecemburuan TUHAN semesta alam akan melakukan hal ini."
 },
 {
   "id": 17842,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 8,
   "firman": "(9-7) Tuhan telah melontarkan firman kepada Yakub, dan firman-Nya itu menimpa Israel."
 },
 {
   "id": 17843,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 9,
   "firman": "(9-8) Biarlah seluruh bangsa itu mengetahuinya, yakni Efraim dan penduduk Samaria, yang berkata dengan congkaknya dan tinggi hatinya:"
 },
 {
   "id": 17844,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 10,
   "firman": "(9-9) \"Tembok batu bata jatuh, akan kita dirikan dari batu pahat; pohon-pohon ara ditebang, akan kita ganti dengan pohon-pohon aras.\""
 },
 {
   "id": 17845,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 11,
   "firman": "(9-10) Maka TUHAN membangkitkan para panglima Rezin melawan mereka, dan menggerakkan musuh-musuh mereka:"
 },
 {
   "id": 17846,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 12,
   "firman": "(9-11) Orang Aram dari timur, dan orang Filistin dari barat, mereka menelan Israel dengan mulut yang lebar. Sekalipun semuanya ini terjadi, murka-Nya belum surut, dan tangan-Nya masih teracung."
 },
 {
   "id": 17847,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 13,
   "firman": "(9-12) Tetapi bangsa itu tidak kembali kepada Dia yang menghajarnya, dan mereka tidak mencari TUHAN semesta alam."
 },
 {
   "id": 17848,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 14,
   "firman": "(9-13) Maka TUHAN mengerat dari Israel kepala dan ekor, batang dan ranting pada satu hari juga."
 },
 {
   "id": 17849,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 15,
   "firman": "(9-14) Tua-tua dan orang yang terpandang, itulah kepala, dan nabi yang mengajarkan dusta, itulah ekor."
 },
 {
   "id": 17850,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 16,
   "firman": "(9-15) Sebab orang-orang yang mengendalikan bangsa ini adalah penyesat, dan orang-orang yang dikendalikan mereka menjadi kacau."
 },
 {
   "id": 17851,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 17,
   "firman": "(9-16) Sebab itu Tuhan tidak bersukacita karena teruna-teruna mereka, dan tidak sayang kepada anak-anak yatim dan janda-janda mereka, sebab sekaliannya mereka murtad dan berbuat jahat, dan setiap mulut berbicara bebal. Sekalipun semuanya ini terjadi, murka-Nya belum surut, dan tangan-Nya masih teracung."
 },
 {
   "id": 17852,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 18,
   "firman": "(9-17) Sebab kefasikan itu menyala seperti api yang memakan habis puteri malu dan rumput, lalu membakar belukar di hutan sehingga tonggak asap berkepul-kepul ke atas."
 },
 {
   "id": 17853,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 19,
   "firman": "(9-18) Oleh karena murka TUHAN semesta alam, terbakarlah tanah itu, dan bangsa itu menjadi makanan api; seorangpun tidak mengasihani saudaranya."
 },
 {
   "id": 17854,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 20,
   "firman": "(9-19) Mereka mencakup ke sebelah kanan, tetapi masih lapar, mereka memakan ke sebelah kiri, tetapi tidak kenyang, setiap orang memakan daging temannya:"
 },
 {
   "id": 17855,
   "kitab": "Yes",
   "pasal": 9,
   "ayat": 21,
   "firman": "(9-20) Manasye memakan Efraim, dan Efraim memakan Manasye, dan bersama-sama mereka melawan Yehuda. Sekalipun semuanya ini terjadi, murka-Nya belum surut, dan tangan-Nya masih teracung."
 },
 {
   "id": 17856,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 1,
   "firman": "Celakalah mereka yang menentukan ketetapan-ketetapan yang tidak adil, dan mereka yang mengeluarkan keputusan-keputusan kelaliman,"
 },
 {
   "id": 17857,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 2,
   "firman": "untuk menghalang-halangi orang-orang lemah mendapat keadilan dan untuk merebut hak orang-orang sengsara di antara umat-Ku, supaya mereka dapat merampas milik janda-janda, dan dapat menjarah anak-anak yatim!"
 },
 {
   "id": 17858,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 3,
   "firman": "Apakah yang akan kamu lakukan pada hari penghukuman, dan pada waktu kebinasaan yang datang dari jauh? Kepada siapakah kamu hendak lari minta tolong, dan di manakah hendak kamu tinggalkan kekayaanmu?"
 },
 {
   "id": 17859,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 4,
   "firman": "Tak dapat kamu lakukan apa-apa selain dari meringkuk di antara orang-orang yang terkurung, dan tewas di antara orang-orang yang terbunuh! Sekalipun semuanya ini terjadi, murka TUHAN belum surut, dan tangan-Nya masih teracung."
 },
 {
   "id": 17860,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 5,
   "firman": "Celakalah Asyur, yang menjadi cambuk murka-Ku dan yang menjadi tongkat amarah-Ku!"
 },
 {
   "id": 17861,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 6,
   "firman": "Aku akan menyuruhnya terhadap bangsa yang murtad, dan Aku akan memerintahkannya melawan umat sasaran murka-Ku, untuk melakukan perampasan dan penjarahan, dan untuk menginjak-injak mereka seperti lumpur di jalan."
 },
 {
   "id": 17862,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 7,
   "firman": "Tetapi dia sendiri tidak demikian maksudnya dan tidak demikian rancangan hatinya, melainkan niat hatinya ialah hendak memunahkan dan hendak melenyapkan tidak sedikit bangsa-bangsa."
 },
 {
   "id": 17863,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 8,
   "firman": "Sebab ia berkata: \"Bukankah panglima-panglimaku itu raja-raja semua?"
 },
 {
   "id": 17864,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 9,
   "firman": "Bukankah Kalno sama halnya seperti Karkemis, atau bukankah Hamat seperti Arpad, atau Samaria seperti Damsyik?"
 },
 {
   "id": 17865,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 10,
   "firman": "Seperti tanganku telah menyergap kerajaan-kerajaan para berhala, padahal patung-patung mereka melebihi yang di Yerusalem dan yang di Samaria,"
 },
 {
   "id": 17866,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 11,
   "firman": "masakan tidak akan kulakukan kepada Yerusalem dan patung-patung berhalanya, seperti yang telah kulakukan kepada Samaria dan berhala-berhalanya?"
 },
 {
   "id": 17867,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 12,
   "firman": "Tetapi apabila Tuhan telah menyelesaikan segala pekerjaan-Nya di gunung Sion dan di Yerusalem, maka Ia akan menghukum perbuatan ketinggian hati raja Asyur dan sikapnya yang angkuh sombong."
 },
 {
   "id": 17868,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 13,
   "firman": "Sebab ia telah berkata: \"Dengan kekuatan tanganku aku telah melakukannya dan dengan kebijaksanaanku, sebab aku berakal budi; aku telah meniadakan batas-batas antara bangsa, dan telah merampok persediaan-persediaan mereka, dengan perkasa aku telah menurunkan orang-orang yang duduk di atas takhta."
 },
 {
   "id": 17869,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 14,
   "firman": "Seperti kepada sarang burung, demikianlah tanganku telah menjangkau kepada kekayaan bangsa-bangsa, dan seperti orang meraup telur-telur yang ditinggalkan induknya, demikianlah aku telah meraup seluruh bumi, dan tidak seekorpun yang menggerakkan sayap, yang mengangakan paruh atau yang menciap-ciap.\""
 },
 {
   "id": 17870,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 15,
   "firman": "Adakah kapak memegahkan diri terhadap orang yang memakainya, atau gergaji membesarkan diri terhadap orang yang mempergunakannya? seolah-olah gada menggerakkan orang yang mengangkatnya, dan seolah-olah tongkat mengangkat orangnya yang bukan kayu!"
 },
 {
   "id": 17871,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 16,
   "firman": "Sebab itu Tuhan, TUHAN semesta alam, akan membuat orang-orangnya yang tegap menjadi kurus kering, dan segala kekayaannya akan dibakar habis, dengan api yang menyala-nyala."
 },
 {
   "id": 17872,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 17,
   "firman": "Maka Terang Israel akan menjadi api, dan Allahnya, Yang Mahakudus, akan menyala-nyala dan akan membakar dan memakan habis puteri malu dan rumputnya pada satu hari juga."
 },
 {
   "id": 17873,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 18,
   "firman": "Keindahan hutan Asyur dan kebun buah-buahannya akan dihabiskan-Nya, dari batangnya sampai rantingnya, sehingga akan menjadi seperti seorang sakit yang merana sampai mati;"
 },
 {
   "id": 17874,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 19,
   "firman": "dan sisa pohon-pohon hutannya akan dapat dihitung banyaknya, sehingga seorang anak dapat mencatatnya."
 },
 {
   "id": 17875,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 20,
   "firman": "Tetapi pada waktu itu sisa orang Israel dan orang yang terluput di antara kaum keturunan Yakub, tidak akan bersandar lagi kepada yang mengalahkannya, tetapi akan bersandar kepada TUHAN, Yang Mahakudus, Allah Israel, dan tetap setia."
 },
 {
   "id": 17876,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 21,
   "firman": "Suatu sisa akan kembali, sisa Yakub akan bertobat di hadapan Allah yang perkasa."
 },
 {
   "id": 17877,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 22,
   "firman": "Sebab sekalipun bangsamu, hai Israel, seperti pasir di laut banyaknya, namun hanya sisanya akan kembali. TUHAN telah memastikan datangnya kebinasaan dan dari situ timbul keadilan yang meluap-luap."
 },
 {
   "id": 17878,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 23,
   "firman": "Sungguh, kebinasaan yang sudah pasti akan dilaksanakan di atas seluruh bumi oleh Tuhan, TUHAN semesta alam."
 },
 {
   "id": 17879,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 24,
   "firman": "Sebab itu beginilah firman Tuhan, TUHAN semesta alam: \"Hai umat-Ku yang diam di Sion, janganlah takut terhadap Asyur, apabila mereka memukul engkau dengan gada dan menghantam engkau dengan tongkatnya, seperti yang dilakukan Mesir dahulu."
 },
 {
   "id": 17880,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 25,
   "firman": "Sebab sedikit waktu lagi amarah-Ku atasmu akan berakhir, dan murka-Ku akan menyebabkan kehancuran mereka."
 },
 {
   "id": 17881,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 26,
   "firman": "TUHAN semesta alam akan mencambuk mereka dengan cemeti, seperti Ia menghajar Midian di gunung batu Oreb, dan mengayunkan tongkat-Nya ke atas laut Teberau dan mengangkatnya seperti di Mesir dahulu."
 },
 {
   "id": 17882,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 27,
   "firman": "Pada waktu itu beban yang ditimpakan mereka atas bahumu akan terbuang, dan kuk yang diletakkan mereka atas tengkukmu akan lenyap.\""
 },
 {
   "id": 17883,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 28,
   "firman": "(10-27b) Asyur telah muncul dari Rimon (10-28) dan telah datang menyerang Ayat; ia telah lewat dari Migron, dan di Mikhmas diaturnya perbekalannya."
 },
 {
   "id": 17884,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 29,
   "firman": "Mereka telah menyeberang dari jurang penyeberangan, sambil berteriak: \"Geba tempat permalaman kita!\" Penduduk Rama gemetar, penghuni Gibea-Saul melarikan diri."
 },
 {
   "id": 17885,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 30,
   "firman": "Keluarkanlah jeritanmu, hai puteri Galim! Perhatikanlah, hai Laisya! Jawablah dia, hai Anatot!"
 },
 {
   "id": 17886,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 31,
   "firman": "Penghuni Madmena lari jauh-jauh, penduduk Gebim pergi mengungsi."
 },
 {
   "id": 17887,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 32,
   "firman": "Hari ini juga Asyur akan berhenti di Nob, mengacung-acungkan tangannya ke arah gunung puteri Sion, bukit Yerusalem."
 },
 {
   "id": 17888,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 33,
   "firman": "Lihat, Tuhan, TUHAN semesta alam akan memotong dahan-dahan pohon dengan kekuatan yang menakutkan; yang tinggi-tinggi tumbuhnya akan ditebang, dan yang menjulang ke atas akan direndahkan."
 },
 {
   "id": 17889,
   "kitab": "Yes",
   "pasal": 10,
   "ayat": 34,
   "firman": "Belukar rimba akan ditebas dengan kapak, dan Libanon dengan pohon-pohonnya yang hebat akan jatuh."
 },
 {
   "id": 17890,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 1,
   "firman": "Suatu tunas akan keluar dari tunggul Isai, dan taruk yang akan tumbuh dari pangkalnya akan berbuah."
 },
 {
   "id": 17891,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 2,
   "firman": "Roh TUHAN akan ada padanya, roh hikmat dan pengertian, roh nasihat dan keperkasaan, roh pengenalan dan takut akan TUHAN;"
 },
 {
   "id": 17892,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 3,
   "firman": "ya, kesenangannya ialah takut akan TUHAN. Ia tidak akan menghakimi dengan sekilas pandang saja atau menjatuhkan keputusan menurut kata orang."
 },
 {
   "id": 17893,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tetapi ia akan menghakimi orang-orang lemah dengan keadilan, dan akan menjatuhkan keputusan terhadap orang-orang yang tertindas di negeri dengan kejujuran; ia akan menghajar bumi dengan perkataannya seperti dengan tongkat, dan dengan nafas mulutnya ia akan membunuh orang fasik."
 },
 {
   "id": 17894,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 5,
   "firman": "Ia tidak akan menyimpang dari kebenaran dan kesetiaan, seperti ikat pinggang tetap terikat pada pinggang."
 },
 {
   "id": 17895,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 6,
   "firman": "Serigala akan tinggal bersama domba dan macan tutul akan berbaring di samping kambing. Anak lembu dan anak singa akan makan rumput bersama-sama, dan seorang anak kecil akan menggiringnya."
 },
 {
   "id": 17896,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 7,
   "firman": "Lembu dan beruang akan sama-sama makan rumput dan anaknya akan sama-sama berbaring, sedang singa akan makan jerami seperti lembu."
 },
 {
   "id": 17897,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 8,
   "firman": "Anak yang menyusu akan bermain-main dekat liang ular tedung dan anak yang cerai susu akan mengulurkan tangannya ke sarang ular beludak."
 },
 {
   "id": 17898,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 9,
   "firman": "Tidak ada yang akan berbuat jahat atau yang berlaku busuk di seluruh gunung-Ku yang kudus, sebab seluruh bumi penuh dengan pengenalan akan TUHAN, seperti air laut yang menutupi dasarnya."
 },
 {
   "id": 17899,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 10,
   "firman": "Maka pada waktu itu taruk dari pangkal Isai akan berdiri sebagai panji-panji bagi bangsa-bangsa; dia akan dicari oleh suku-suku bangsa dan tempat kediamannya akan menjadi mulia."
 },
 {
   "id": 17900,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 11,
   "firman": "Pada waktu itu Tuhan akan mengangkat pula tangan-Nya untuk menebus sisa-sisa umat-Nya yang tertinggal di Asyur dan di Mesir, di Patros, di Etiopia dan di Elam, di Sinear, di Hamat dan di pulau-pulau di laut."
 },
 {
   "id": 17901,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 12,
   "firman": "Ia akan menaikkan suatu panji-panji bagi bangsa-bangsa, akan mengumpulkan orang-orang Israel yang terbuang, dan akan menghimpunkan orang-orang Yehuda yang terserak dari keempat penjuru bumi."
 },
 {
   "id": 17902,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 13,
   "firman": "Kecemburuan Efraim akan berlalu, dan yang menyesakkan Yehuda akan lenyap. Efraim tidak akan cemburu lagi kepada Yehuda, dan Yehuda tidak akan menyesakkan Efraim lagi."
 },
 {
   "id": 17903,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 14,
   "firman": "Tetapi mereka akan terbang ke barat, ke atas lereng gunung Filistin, bersama-sama mereka akan menjarah bani Timur; mereka akan merampas Edom dan Moab, dan orang Amon akan patuh kepada mereka."
 },
 {
   "id": 17904,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 15,
   "firman": "TUHAN akan mengeringkan teluk Mesir dengan nafas-Nya yang menghanguskan, serta mengacungkan tangan-Nya terhadap sungai Efrat dan memukulnya pecah menjadi tujuh batang air, sehingga orang dapat melaluinya dengan berkasut."
 },
 {
   "id": 17905,
   "kitab": "Yes",
   "pasal": 11,
   "ayat": 16,
   "firman": "Maka akan ada jalan raya bagi sisa-sisa umat-Nya yang tertinggal di Asyur, seperti yang telah ada untuk Israel dahulu, pada waktu mereka keluar dari tanah Mesir."
 },
 {
   "id": 17906,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 1,
   "firman": "Pada waktu itu engkau akan berkata: \"Aku mau bersyukur kepada-Mu, ya TUHAN, karena sungguhpun Engkau telah murka terhadap aku: tetapi murka-Mu telah surut dan Engkau menghibur aku."
 },
 {
   "id": 17907,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 2,
   "firman": "Sungguh, Allah itu keselamatanku; aku percaya dengan tidak gementar, sebab TUHAN ALLAH itu kekuatanku dan mazmurku, Ia telah menjadi keselamatanku.\""
 },
 {
   "id": 17908,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 3,
   "firman": "Maka kamu akan menimba air dengan kegirangan dari mata air keselamatan."
 },
 {
   "id": 17909,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 4,
   "firman": "Pada waktu itu kamu akan berkata: \"Bersyukurlah kepada TUHAN, panggillah nama-Nya, beritahukanlah perbuatan-Nya di antara bangsa-bangsa, masyhurkanlah, bahwa nama-Nya tinggi luhur!"
 },
 {
   "id": 17910,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 5,
   "firman": "Bermazmurlah bagi TUHAN, sebab perbuatan-Nya mulia; baiklah hal ini diketahui di seluruh bumi!"
 },
 {
   "id": 17911,
   "kitab": "Yes",
   "pasal": 12,
   "ayat": 6,
   "firman": "Berserulah dan bersorak-sorailah, hai penduduk Sion, sebab Yang Mahakudus, Allah Israel, agung di tengah-tengahmu!\""
 },
 {
   "id": 17912,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 1,
   "firman": "Ucapan ilahi terhadap Babel yang dinyatakan kepada Yesaya bin Amos."
 },
 {
   "id": 17913,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 2,
   "firman": "Naikkanlah panji-panji di atas gunung yang gundul, berserulah terhadap mereka dengan suara nyaring; lambaikanlah tangan supaya mereka masuk ke pintu-pintu gerbang para bangsawan!"
 },
 {
   "id": 17914,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 3,
   "firman": "Aku ini telah memerintahkan orang-orang yang Kukuduskan, telah memanggil orang-orang perkasa-Ku untuk melaksanakan hukuman murka-Ku, orang-orang-Ku yang beria-ria dan bangga."
 },
 {
   "id": 17915,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 4,
   "firman": "Ada suara keramaian di atas gunung-gunung, seperti suara kumpulan orang yang besar jumlahnya! Suara kegaduhan dari kerajaan-kerajaan, dari bangsa-bangsa yang berkumpul! TUHAN semesta alam sedang memeriksa pasukan perang."
 },
 {
   "id": 17916,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 5,
   "firman": "Mereka datang dari negeri yang jauh, ya dari ujung langit, yaitu TUHAN serta yang melaksanakan amarah-Nya untuk merusakkan seluruh bumi."
 },
 {
   "id": 17917,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 6,
   "firman": "Merataplah, sebab hari TUHAN sudah dekat, datangnya sebagai pemusnahan dari Yang Mahakuasa."
 },
 {
   "id": 17918,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 7,
   "firman": "Sebab itu semua tangan akan menjadi lemah lesu, setiap hati manusia akan menjadi tawar,"
 },
 {
   "id": 17919,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 8,
   "firman": "dan mereka akan terkejut. Sakit mulas dan sakit beranak akan menyerang mereka, mereka akan menggeliat kesakitan seperti perempuan yang melahirkan. Mereka akan berpandang-pandangan dengan tercengang-cengang, muka mereka seperti orang yang demam."
 },
 {
   "id": 17920,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sungguh, hari TUHAN datang dengan kebengisan, dengan gemas dan dengan murka yang menyala-nyala, untuk membuat bumi menjadi sunyi sepi dan untuk memunahkan dari padanya orang-orang yang berdosa."
 },
 {
   "id": 17921,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 10,
   "firman": "Sebab bintang-bintang dan gugusan-gugusannya di langit tidak akan memancarkan cahayanya; matahari akan menjadi gelap pada waktu terbit, dan bulan tidak akan memancarkan sinarnya."
 },
 {
   "id": 17922,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 11,
   "firman": "Kepada dunia akan Kubalaskan kejahatannya, dan kepada orang-orang fasik kesalahan mereka; kesombongan orang-orang pemberani akan Kuhentikan, dan kecongkakan orang-orang yang gagah akan Kupatahkan."
 },
 {
   "id": 17923,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 12,
   "firman": "Aku akan membuat orang lebih jarang dari pada emas tua, dan manusia lebih jarang dari pada emas Ofir."
 },
 {
   "id": 17924,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 13,
   "firman": "Sebab itu Aku akan membuat langit gemetar, dan bumipun akan bergoncang dari tempatnya, pada waktu amarah TUHAN semesta alam, dan pada hari murka-Nya yang menyala-nyala."
 },
 {
   "id": 17925,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 14,
   "firman": "Seperti kijang yang dikejar-kejar dan seperti domba yang tidak digembalakan, demikianlah mereka akan berpaling, masing-masing kepada bangsanya, dan melarikan diri, masing-masing ke negerinya."
 },
 {
   "id": 17926,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 15,
   "firman": "Setiap orang yang didapati akan ditikam, dan setiap orang yang tertangkap akan rebah mati oleh pedang."
 },
 {
   "id": 17927,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 16,
   "firman": "Bayi-bayi mereka akan diremukkan di depan mata mereka, rumah-rumah mereka akan dirampoki, dan isteri-isteri mereka akan ditiduri."
 },
 {
   "id": 17928,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 17,
   "firman": "Lihat, Aku menggerakkan orang Madai melawan mereka, orang-orang yang tidak menghiraukan perak dan tidak suka kepada emas."
 },
 {
   "id": 17929,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 18,
   "firman": "Panah-panah mereka akan menembus orang-orang muda; mereka tidak akan sayang kepada buah kandungan, dan mereka tidak menaruh kasihan kepada anak-anak."
 },
 {
   "id": 17930,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 19,
   "firman": "Dan Babel, yang permai di antara kerajaan-kerajaan, perhiasan orang Kasdim yang megah, akan sama seperti Sodom dan Gomora pada waktu Allah menunggangbalikkannya:"
 },
 {
   "id": 17931,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 20,
   "firman": "tidak ada penduduk untuk seterusnya, dan tidak ada penghuni turun-temurun; orang Arab tidak akan berkemah di sana, dan gembala-gembala tidak akan membiarkan hewannya berbaring di sana;"
 },
 {
   "id": 17932,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 21,
   "firman": "tetapi yang akan berbaring di sana ialah binatang gurun, dan rumah-rumah mereka akan penuh dengan burung hantu; burung-burung unta akan diam di sana, dan jin-jin akan melompat-lompat;"
 },
 {
   "id": 17933,
   "kitab": "Yes",
   "pasal": 13,
   "ayat": 22,
   "firman": "anjing-anjing hutan akan menyalak di dalam puri-purinya, dan serigala-serigala di dalam istana-istana kesenangan. Waktunya akan datang segera, dan usianya tidak akan diperpanjang."
 },
 {
   "id": 17934,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 1,
   "firman": "Sebab TUHAN akan menyayangi Yakub dan akan memilih Israel sekali lagi dan akan membiarkan mereka tinggal di tanah mereka, maka orang asing akan menggabungkan diri kepada mereka dan akan berpadu dengan kaum keturunan Yakub."
 },
 {
   "id": 17935,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 2,
   "firman": "Bangsa-bangsa lain akan mengantar Israel pulang ke tempatnya, lalu kaum Israel akan memiliki bangsa-bangsa itu di tanah TUHAN sebagai hamba-hamba lelaki dan hamba-hamba perempuan. Demikianlah mereka akan menawan orang-orang yang menawan mereka dan akan berkuasa atas para penindas mereka."
 },
 {
   "id": 17936,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 3,
   "firman": "Maka pada hari TUHAN mengakhiri kesakitan dan kegelisahanmu dan kerja paksa yang berat yang dipaksakan kepadamu,"
 },
 {
   "id": 17937,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 4,
   "firman": "maka engkau akan memperdengarkan ejekan ini tentang raja Babel, dan berkata: \"Wah, sudah berakhir si penindas sudah berakhir orang lalim!"
 },
 {
   "id": 17938,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 5,
   "firman": "TUHAN telah mematahkan tongkat orang-orang fasik, gada orang-orang yang memerintah,"
 },
 {
   "id": 17939,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 6,
   "firman": "yang memukul bangsa-bangsa dengan gemas, dengan pukulan yang tidak putus-putusnya; yang menginjak-injak bangsa-bangsa dalam murka dengan tiada henti-hentinya."
 },
 {
   "id": 17940,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 7,
   "firman": "Segenap bumi sudah aman dan tenteram; orang bergembira dengan sorak-sorai."
 },
 {
   "id": 17941,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 8,
   "firman": "Juga pohon-pohon sanobar dan pohon-pohon aras di Libanon bersukacita karena kejatuhanmu, katanya: 'Dari sejak engkau rebah terbaring, tidak ada lagi orang yang naik untuk menebang kami!'"
 },
 {
   "id": 17942,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 9,
   "firman": "Dunia orang mati yang di bawah gemetar untuk menyongsong kedatanganmu, dijagakannya arwah-arwah bagimu, yaitu semua bekas pemimpin di bumi; semua bekas raja bangsa-bangsa dibangunkannya dari takhta mereka."
 },
 {
   "id": 17943,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 10,
   "firman": "Sekaliannya mereka mulai berbicara dan berkata kepadamu: 'Engkau juga telah menjadi lemah seperti kami, sudah menjadi sama seperti kami!'"
 },
 {
   "id": 17944,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 11,
   "firman": "Ke dunia orang mati sudah diturunkan kemegahanmu dan bunyi gambus-gambusmu; ulat-ulat dibentangkan sebagai lapik tidurmu, dan cacing-cacing sebagai selimutmu.\""
 },
 {
   "id": 17945,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 12,
   "firman": "\"Wah, engkau sudah jatuh dari langit, hai Bintang Timur, putera Fajar, engkau sudah dipecahkan dan jatuh ke bumi, hai yang mengalahkan bangsa-bangsa!"
 },
 {
   "id": 17946,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 13,
   "firman": "Engkau yang tadinya berkata dalam hatimu: Aku hendak naik ke langit, aku hendak mendirikan takhtaku mengatasi bintang-bintang Allah, dan aku hendak duduk di atas bukit pertemuan, jauh di sebelah utara."
 },
 {
   "id": 17947,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 14,
   "firman": "Aku hendak naik mengatasi ketinggian awan-awan, hendak menyamai Yang Mahatinggi!"
 },
 {
   "id": 17948,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 15,
   "firman": "Sebaliknya, ke dalam dunia orang mati engkau diturunkan, ke tempat yang paling dalam di liang kubur."
 },
 {
   "id": 17949,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 16,
   "firman": "Orang-orang yang melihat engkau akan memperhatikan dan mengamat-amati engkau, katanya: Inikah dia yang telah membuat bumi gemetar, dan yang telah membuat kerajaan-kerajaan bergoncang,"
 },
 {
   "id": 17950,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 17,
   "firman": "yang telah membuat dunia seperti padang gurun, dan menghancurkan kota-kotanya, yang tidak melepaskan orang-orangnya yang terkurung pulang ke rumah?"
 },
 {
   "id": 17951,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 18,
   "firman": "Semua bekas raja bangsa-bangsa berbaring dalam kemuliaan, masing-masing dalam rumah kuburnya."
 },
 {
   "id": 17952,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 19,
   "firman": "Tetapi engkau ini telah terlempar, jauh dari kuburmu, seperti taruk yang jijik, ditutupi dengan mayat orang-orang yang tertikam oleh pedang dan jatuh tercampak ke batu-batu liang kubur seperti bangkai yang terinjak-injak."
 },
 {
   "id": 17953,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 20,
   "firman": "Engkau tidak akan bersama-sama dengan raja-raja itu di dalam kubur, sebab engkau telah merusak negerimu dan membunuh rakyatmu. Anak cucu orang yang berbuat jahat tidak akan disebut-sebut untuk selama-lamanya."
 },
 {
   "id": 17954,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 21,
   "firman": "Dirikanlah bagi anak-anaknya tempat pembantaian, oleh karena kesalahan nenek moyang mereka, supaya mereka jangan bangun dan menduduki bumi dan memenuhi dunia dengan kota-kota.\""
 },
 {
   "id": 17955,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 22,
   "firman": "\"Aku akan bangkit melawan mereka,\" demikianlah firman TUHAN semesta alam, \"Aku akan melenyapkan nama Babel dan sisanya, anak cucu dan anak cicitnya,\" demikianlah firman TUHAN."
 },
 {
   "id": 17956,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 23,
   "firman": "\"Aku akan membuat Babel menjadi milik landak dan menjadi air rawa-rawa, dan kota itu akan Kusapu bersih dan Kupunahkan,\" demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 17957,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 24,
   "firman": "TUHAN semesta alam telah bersumpah, firman-Nya: \"Sesungguhnya seperti yang Kumaksud, demikianlah akan terjadi, dan seperti yang Kurancang, demikianlah akan terlaksana:"
 },
 {
   "id": 17958,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 25,
   "firman": "Aku akan membinasakan orang Asyur dalam negeri-Ku dan menginjak-injak mereka di atas gunung-Ku; kuk yang diletakkan mereka atas umat-Ku akan terbuang dan demikian juga beban yang ditimpakan mereka atas bahunya.\""
 },
 {
   "id": 17959,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 26,
   "firman": "Itulah rancangan yang telah dibuat mengenai seluruh bumi, dan itulah tangan yang teracung terhadap segala bangsa."
 },
 {
   "id": 17960,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 27,
   "firman": "TUHAN semesta alam telah merancang, siapakah yang dapat menggagalkannya? Tangan-Nya telah teracung, siapakah yang dapat membuatnya ditarik kembali?"
 },
 {
   "id": 17961,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 28,
   "firman": "Dalam tahun matinya raja Ahas datanglah ucapan ilahi ini:"
 },
 {
   "id": 17962,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 29,
   "firman": "Janganlah bersukaria, hai segenap Filistea, karena walaupun gada orang yang memukul engkau sudah patah, tetapi dari keturunan ular itu akan keluar ular beludak, dan anaknya akan menjadi ular naga terbang."
 },
 {
   "id": 17963,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 30,
   "firman": "Yang paling hina dari umat-Ku akan mendapat makanan dan orang-orang miskin akan diam dengan tenteram, tetapi keturunanmu akan Kumatikan dengan kelaparan, dan sisa-sisamu akan Kubunuh."
 },
 {
   "id": 17964,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 31,
   "firman": "Merataplah, hai pintu gerbang! Berteriaklah, hai kota! Gemetarlah, hai segenap Filistea! Sebab di sebelah utara sudah mengepul asap perang, dan barisan musuh maju tanpa ada yang mundur."
 },
 {
   "id": 17965,
   "kitab": "Yes",
   "pasal": 14,
   "ayat": 32,
   "firman": "Dan apakah jawab yang akan diberi kepada utusan-utusan bangsa itu? \"TUHAN yang meletakkan dasar Sion, dan di sanalah orang-orang yang sengsara dari umat-Nya mendapat perlindungan.\""
 },
 {
   "id": 17966,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 1,
   "firman": "Ucapan ilahi tentang Moab. Sungguh, dalam suatu malam Ar-Moab sudah dirusakkan, dibinasakan; sungguh, dalam suatu malam Kir-Moab sudah dirusakkan, dibinasakan!"
 },
 {
   "id": 17967,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 2,
   "firman": "Puteri Dibon naik ke bukit-bukit pengorbanan untuk menangis; Moab meratap karena Nebo dan karena Medeba. Di situ semua orang menggundul kepalanya dan memotong janggutnya sebagai tanda berkabung."
 },
 {
   "id": 17968,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 3,
   "firman": "Di jalan-jalan orang berlilitkan kain kabung, di atas sotoh dan di tanah-tanah lapang sekaliannya meratap, sedang air mata bercucuran."
 },
 {
   "id": 17969,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 4,
   "firman": "Hesybon dan Eleale meraung-raung, suara mereka kedengaran sampai ke Yahas. Sebab itu orang-orang bersenjata di Moab berseru-seru, jiwanyapun gemetar."
 },
 {
   "id": 17970,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 5,
   "firman": "Aku berteriak karena Moab, pengungsi-pengungsi sudah sampai ke Zoar, ke Eglat-Selisia. Sungguh, orang mendaki pendakian Luhit sambil menangis; dan di jalan ke Horonaim orang berteriak karena ditimpa bencana."
 },
 {
   "id": 17971,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 6,
   "firman": "Sungguh, air di Nimrim menjadi kering dan tandus dan rumput sudah kering, rumput muda sudah habis, tidak ada lagi tumbuh-tumbuhan hijau."
 },
 {
   "id": 17972,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 7,
   "firman": "Sebab itu segala harta yang mereka tumpuk dan segala yang mereka simpan mereka bawa ke seberang sungai Haarabim."
 },
 {
   "id": 17973,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 8,
   "firman": "Sungguh, teriak itu akan kedengaran di seluruh daerah Moab, ratapnya terdengar sampai ke Eglaim, bahkan sampai ke Beer-Elim."
 },
 {
   "id": 17974,
   "kitab": "Yes",
   "pasal": 15,
   "ayat": 9,
   "firman": "Sungguh, air Dibon telah penuh dengan darah, tetapi yang menimpa Dibon akan Kutambah lagi, yaitu singa akan menerkam orang-orang yang terluput dari Moab dan yang tersisa di tanah itu."
 },
 {
   "id": 17975,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 1,
   "firman": "Mereka mengirim anak domba kepada pemerintah negeri, dari Sela melalui padang gurun ke gunung puteri Sion."
 },
 {
   "id": 17976,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 2,
   "firman": "Seperti burung yang lari terbang, dan isi sarang yang diusir, demikianlah anak-anak perempuan Moab di tempat-tempat penyeberangan sungai Arnon."
 },
 {
   "id": 17977,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 3,
   "firman": "\"Berilah nasihat, pertahankanlah hak, jadilah naungan yang teduh di waktu rembang tengah hari; sembunyikanlah orang-orang yang terbuang, janganlah khianati orang-orang pelarian!"
 },
 {
   "id": 17978,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 4,
   "firman": "Biarkanlah orang-orang yang terbuang dari Moab menumpang padamu, jadilah tempat persembunyian baginya terhadap si pembinasa! Apabila penggagahan sudah berakhir, pembinasaan sudah lewat dan orang lalim sudah habis lenyap dari negeri,"
 },
 {
   "id": 17979,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 5,
   "firman": "maka suatu takhta akan ditegakkan dalam kasih setia dan di atasnya, dalam kemah Daud, akan duduk senantiasa seorang hakim yang menegakkan keadilan, dan yang segera melakukan kebenaran.\""
 },
 {
   "id": 17980,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 6,
   "firman": "Kami telah mendengar tentang keangkuhan Moab, alangkah angkuhnya dia, tentang kecongkakannya, keangkuhannya dan kegemasannya, dan tentang cakap anginnya yang tidak benar."
 },
 {
   "id": 17981,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 7,
   "firman": "Sebab itu biarlah orang Moab meratap, seorang karena yang lain, biarlah sekaliannya meratap. Mengingat kue kismis Kir-Hareset biarlah mereka mengaduh dan hancur luluh sama sekali!"
 },
 {
   "id": 17982,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 8,
   "firman": "Sebab kebun-kebun Hesybon dan pohon anggur Sibma telah merana; para penguasa bangsa-bangsa telah memotong pohon-pohon anggurnya yang terbaik, yang dahulu meluas sampai ke Yaezer dan merambat ke padang gurun; ranting-rantingnya berserak sampai ke seberang laut."
 },
 {
   "id": 17983,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 9,
   "firman": "Sebab itu aku turut menangis dengan Yaezer karena pohon anggur Sibma; aku mau membasahi engkau dengan air mataku, hai Hesybon dan Eleale, sebab pada musim kemarau tepat waktu panen musuhmu menyerbu dengan pekik pertempuran."
 },
 {
   "id": 17984,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 10,
   "firman": "Telah lenyap sukaria dan sorak-sorak dari kebun buah-buahan; telah menghilang dari kebun-kebun anggur tempik sorak dan sorak-sorai; tiada pengirik anggur di tempat pemerasan, pekik mereka sudah berhenti."
 },
 {
   "id": 17985,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 11,
   "firman": "Oleh karena itu, seperti kecapi mendengking, begitulah hatiku menjerit melihat keadaan Moab, dan batinku tergerak melihat keadaan Kir-Heres."
 },
 {
   "id": 17986,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 12,
   "firman": "Maka sekalipun Moab pergi beribadah dan bersusah payah di atas bukit pengorbanan dan masuk ke tempat kudusnya untuk berdoa, ia tidak akan mencapai apa-apa."
 },
 {
   "id": 17987,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 13,
   "firman": "Itulah firman yang diucapkan TUHAN tentang Moab pada waktu yang lalu."
 },
 {
   "id": 17988,
   "kitab": "Yes",
   "pasal": 16,
   "ayat": 14,
   "firman": "Maka sekarang TUHAN berfirman: \"Dalam tiga tahun, menurut masa kerja prajurit upahan, maka kemuliaan Moab, serta dengan keramaiannya yang besar, akan menjadi kehinaan, dan orang yang tertinggal akan sangat sedikit dan tiada berkuasa.\""
 },
 {
   "id": 17989,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 1,
   "firman": "Ucapan ilahi terhadap Damsyik. Sesungguhnya, Damsyik tidak akan tetap sebagai kota, nanti menjadi suatu timbunan reruntuhan;"
 },
 {
   "id": 17990,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 2,
   "firman": "kampung-kampungnya akan ditinggalkan selama-lamanya dan menjadi tempat bagi kawanan-kawanan ternak, yang berbaring dengan tidak diganggu oleh siapapun."
 },
 {
   "id": 17991,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 3,
   "firman": "Kubu-kubu akan hilang dari Efraim dan kuasa kerajaan akan lenyap dari Damsyik, juga sisa-sisa Aram, semuanya akan lenyap sama seperti kemuliaan orang Israel, demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 17992,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 4,
   "firman": "Maka pada waktu itu kemuliaan Yakub akan berkurang, dan kemakmurannya akan susut;"
 },
 {
   "id": 17993,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 5,
   "firman": "keadaannya seperti gandum yang digenggam orang untuk dituai dan tangannya memetik bulir-bulir; atau seperti bulir-bulir yang dipungut orang di lembah orang Refaim."
 },
 {
   "id": 17994,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 6,
   "firman": "Dari padanya akan tertinggal sisa untuk pemetikan susulan seperti pada waktu orang menjolok buah zaitun, tertinggal satu dua di sebelah pucuknya dan beberapa di dahan-dahannya, demikianlah firman TUHAN, Allah Israel."
 },
 {
   "id": 17995,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 7,
   "firman": "Pada waktu itu manusia akan memandang kepada Dia yang menjadikannya, dan matanya akan melihat kepada Yang Mahakudus, Allah Israel;"
 },
 {
   "id": 17996,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 8,
   "firman": "ia tidak akan memandang kepada mezbah-mezbah buatan tangannya sendiri, dan tidak akan melihat kepada yang dikerjakan oleh tangannya, yakni tiang-tiang berhala dan pedupaan-pedupaan."
 },
 {
   "id": 17997,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 9,
   "firman": "Pada waktu itu kota-kotamu akan ditinggalkan seperti kota-kota orang Hewi dan orang Amori yang mereka tinggalkan karena orang Israel, sehingga menjadi sunyi sepi."
 },
 {
   "id": 17998,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 10,
   "firman": "Sebab engkau telah melupakan Allah yang menyelamatkan engkau, dan tidak mengingat gunung batu kekuatanmu. Sebab itu sekalipun engkau membuat taman yang permai dan menanaminya dengan cangkokan luar negeri,"
 },
 {
   "id": 17999,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 11,
   "firman": "sekalipun pada hari menanamnya engkau membuatnya tumbuh subur, dan pada pagi mencangkokkannya engkau membuatnya berbunga, namun panen akan segera lenyap pada hari kesakitan dan hari penderitaan yang sangat payah."
 },
 {
   "id": 18000,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 12,
   "firman": "Wahai! Ributnya banyak bangsa-bangsa, mereka ribut seperti ombak laut menderu! Gaduhnya suku-suku bangsa, mereka gaduh seperti gaduhnya air yang hebat!"
 },
 {
   "id": 18001,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 13,
   "firman": "Suku-suku bangsa gaduh seperti gaduhnya air yang besar; tetapi TUHAN menghardiknya, sehingga mereka lari jauh-jauh, terburu-buru seperti sekam di tempat penumbukan dihembus angin, dan seperti dedak ditiup puting beliung."
 },
 {
   "id": 18002,
   "kitab": "Yes",
   "pasal": 17,
   "ayat": 14,
   "firman": "Menjelang waktu senja, sesungguhnya ada kedahsyatan! Sebelum hari pagi, mereka sudah tidak ada lagi! Itulah bagian orang-orang yang merampoki kita, dan itulah yang ditentukan bagi orang-orang yang merampasi kita."
 },
 {
   "id": 18003,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 1,
   "firman": "Wahai! Negeri dengingan sayap di seberang sungai-sungai Etiopia,"
 },
 {
   "id": 18004,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 2,
   "firman": "yang mengirim duta-duta melalui laut dalam perahu-perahu pandan mengarungi permukaan air! Pergilah, hai utusan-utusan yang tangkas, kepada bangsa yang jangkung dan berkulit mengkilap, kepada kaum yang ditakuti dekat dan jauh, yakni bangsa yang berkekuatan ulet dan lalim, yang negerinya dilintasi sungai-sungai!"
 },
 {
   "id": 18005,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 3,
   "firman": "Hai semua penduduk dunia, hai orang-orang yang mendiami bumi! Apabila panji-panji dinaikkan di gunung-gunung, lihatlah; apabila sangkakala ditiup, dengarlah!"
 },
 {
   "id": 18006,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN kepadaku: \"Aku akan menjenguk dari tempat kediaman-Ku dengan tidak bergerak, seperti hawa panas yang mendidih waktu panas terik, seperti kabut embun di panas musim menuai.\""
 },
 {
   "id": 18007,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 5,
   "firman": "Sebab sebelum musim buah, apabila waktu berbunga sudah berakhir, dan gugusan putik menjadi buah anggur yang hendak masak, maka TUHAN akan mengerat ranting-rantingnya dengan pisau pemangkas, dan menyisihkan carang-carangnya dengan memancungnya."
 },
 {
   "id": 18008,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 6,
   "firman": "Semuanya itu akan ditinggalkan bertumpuk-tumpuk bagi burung-burung buas di pegunungan, dan bagi binatang-binatang di hutan. Pada musim panas burung-burung buas akan bermukim di situ dan segala binatang hutan pada musim dingin."
 },
 {
   "id": 18009,
   "kitab": "Yes",
   "pasal": 18,
   "ayat": 7,
   "firman": "Pada waktu itu juga persembahan akan disampaikan kepada TUHAN semesta alam dari kaum yang jangkung dan berkulit mengkilap, dan dari kaum yang ditakuti dekat dan jauh, yakni bangsa yang berkekuatan ulet dan lalim, yang negerinya dilintasi sungai-sungai, ke tempat nama TUHAN semesta alam, yaitu gunung Sion."
 },
 {
   "id": 18010,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 1,
   "firman": "Ucapan ilahi terhadap Mesir. Lihat, TUHAN mengendarai awan yang cepat dan datang ke Mesir, maka berhala-berhala Mesir gemetar di hadapan-Nya, dan hati orang Mesir, merana hancur dalam diri mereka."
 },
 {
   "id": 18011,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 2,
   "firman": "Aku akan menggerakkan orang Mesir melawan orang Mesir, supaya mereka berperang, setiap orang melawan saudaranya, dan setiap orang melawan temannya, kota melawan kota, kerajaan melawan kerajaan;"
 },
 {
   "id": 18012,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 3,
   "firman": "semangat orang Mesir menjadi hilang, dan rancangannya akan Kukacaukan; maka mereka akan meminta petunjuk kepada berhala-berhala dan kepada tukang-tukang jampi, kepada arwah dan kepada roh-roh peramal."
 },
 {
   "id": 18013,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 4,
   "firman": "Aku akan menyerahkan orang Mesir ke dalam tangan seorang tuan yang kejam, dan seorang raja yang bengis akan memerintah mereka; demikianlah firman Tuhan, TUHAN semesta alam."
 },
 {
   "id": 18014,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 5,
   "firman": "Air dari sungai Nil akan habis, dan sungai itu akan menjadi tohor dan kering,"
 },
 {
   "id": 18015,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 6,
   "firman": "sehingga terusan-terusan akan berbau busuk, dan anak-anak sungai Nil akan menjadi dangkal dan tohor, gelagah dan teberau akan mati rebah."
 },
 {
   "id": 18016,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 7,
   "firman": "Rumput di tepi sungai Nil dan seluruh tanah pesemaian pada sungai Nil akan menjadi kering ditiup angin dan tidak ada lagi."
 },
 {
   "id": 18017,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 8,
   "firman": "Para nelayan akan mengaduh dan berkabung, yaitu semua orang yang memancing di sungai Nil; semua orang yang menjala di situ akan merana juga."
 },
 {
   "id": 18018,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 9,
   "firman": "Orang-orang yang mengolah lenan akan mendapat malu, demikian juga tukang-tukang tenun kain putih."
 },
 {
   "id": 18019,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 10,
   "firman": "Mereka yang menenun akan remuk hatinya, segala pekerja upahan akan bersedih hati."
 },
 {
   "id": 18020,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 11,
   "firman": "Para pembesar Zoan adalah orang-orang bodoh belaka; para penasihat Firaun yang paling bijaksana memberi nasihat yang dungu. Bagaimanakah kamu dapat berkata kepada Firaun: \"Aku ini anak orang-orang bijaksana, anak raja-raja zaman purbakala?\""
 },
 {
   "id": 18021,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 12,
   "firman": "Di manakah orang-orang bijaksanamu? Biarlah mereka mengumumkan kepadamu serta memberitahukan apa yang diputuskan TUHAN semesta alam tentang Mesir."
 },
 {
   "id": 18022,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 13,
   "firman": "Para pembesar Zoan bertindak tolol, para pembesar Memfis sudah teperdaya; para pemuka suku-suku mereka telah memusingkan Mesir."
 },
 {
   "id": 18023,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 14,
   "firman": "TUHAN telah mencurahkan di antara mereka suatu roh kekacauan, dan mereka memusingkan Mesir dalam segala usahanya, sehingga seperti seorang mabuk yang pusing waktu muntah-muntah."
 },
 {
   "id": 18024,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 15,
   "firman": "Dan tidak ada usaha Mesir yang akan berhasil yang dilakukan oleh pemimpin dan pengikut, oleh pemuka dan orang biasa."
 },
 {
   "id": 18025,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 16,
   "firman": "Pada waktu itu orang-orang Mesir akan seperti orang-orang perempuan; mereka akan gemetar dan terkejut terhadap tangan TUHAN semesta alam yang diacungkan-Nya kepada mereka."
 },
 {
   "id": 18026,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 17,
   "firman": "Maka tanah Yehuda akan menimbulkan kegemparan di antara orang Mesir, dan siapapun yang teringat kepadanya akan terkejut mendengar keputusan TUHAN semesta alam yang diambil-Nya mengenai mereka."
 },
 {
   "id": 18027,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 18,
   "firman": "Pada waktu itu akan ada lima kota di tanah Mesir yang berbicara bahasa Kanaan dan yang bersumpah demi TUHAN semesta alam. Satu di antaranya akan disebutkan Ir-Heres."
 },
 {
   "id": 18028,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 19,
   "firman": "Pada waktu itu akan ada mezbah bagi TUHAN di tengah-tengah tanah Mesir dan tugu peringatan bagi TUHAN pada perbatasannya."
 },
 {
   "id": 18029,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 20,
   "firman": "Itu akan menjadi tanda kesaksian bagi TUHAN semesta alam di tanah Mesir: apabila mereka berseru kepada TUHAN oleh karena orang-orang penindas, maka Ia akan mengirim seorang juruselamat kepada mereka, yang akan berjuang dan akan melepaskan mereka."
 },
 {
   "id": 18030,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 21,
   "firman": "TUHAN akan menyatakan diri kepada orang Mesir, dan orang Mesir akan mengenal TUHAN pada waktu itu; mereka akan beribadah dengan korban sembelihan dan korban sajian, dan mereka akan bernazar kepada TUHAN serta membayar nazar itu."
 },
 {
   "id": 18031,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 22,
   "firman": "TUHAN akan menghajar orang Mesir, akan menghajar dan menyembuhkan; dan mereka akan berbalik kepada TUHAN dan Ia akan mengabulkan doa mereka serta menyembuhkan mereka."
 },
 {
   "id": 18032,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 23,
   "firman": "Pada waktu itu akan ada jalan raya dari Mesir ke Asyur, sehingga orang Asyur dapat masuk ke Mesir dan orang Mesir ke Asyur, dan Mesir akan beribadah bersama-sama Asyur."
 },
 {
   "id": 18033,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 24,
   "firman": "Pada waktu itu Israel akan menjadi yang ketiga di samping Mesir dan di samping Asyur, suatu berkat di atas bumi,"
 },
 {
   "id": 18034,
   "kitab": "Yes",
   "pasal": 19,
   "ayat": 25,
   "firman": "yang diberkati oleh TUHAN semesta alam dengan berfirman: \"Diberkatilah Mesir, umat-Ku, dan Asyur, buatan tangan-Ku, dan Israel, milik pusaka-Ku.\""
 },
 {
   "id": 18035,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada tahun ketika panglima yang dikirim oleh Sargon, raja Asyur, tiba di Asdod lalu memerangi dan merebutnya,"
 },
 {
   "id": 18036,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 2,
   "firman": "pada waktu itu berfirmanlah TUHAN melalui Yesaya bin Amos. Firman-Nya: \"Pergilah dan bukalah kain kabung dari pinggangmu dan tanggalkanlah kasut dari kakimu,\" lalu iapun berbuat demikian, maka berjalanlah ia telanjang dan tidak berkasut."
 },
 {
   "id": 18037,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 3,
   "firman": "Berfirmanlah TUHAN: \"Seperti hamba-Ku Yesaya berjalan telanjang dan tidak berkasut tiga tahun lamanya sebagai tanda dan alamat terhadap Mesir dan terhadap Etiopia,"
 },
 {
   "id": 18038,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 4,
   "firman": "demikianlah raja Asyur akan menggiring orang Mesir sebagai tawanan dan orang Etiopia sebagai buangan, tua dan muda, telanjang dan tidak berkasut dengan pantatnya kelihatan, suatu penghinaan bagi Mesir."
 },
 {
   "id": 18039,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 5,
   "firman": "Maka orang akan terkejut dan malu karena Etiopia, pokok pengharapan mereka, dan karena Mesir, kebanggaan mereka."
 },
 {
   "id": 18040,
   "kitab": "Yes",
   "pasal": 20,
   "ayat": 6,
   "firman": "Dan penduduk tanah pesisir ini akan berkata pada waktu itu: Lihat, beginilah nasib orang-orang yang kami harapkan, kepada siapa kami melarikan diri minta pertolongan supaya diselamatkan dari raja Asyur. Bagaimana mungkin kami terluput?\""
 },
 {
   "id": 18041,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 1,
   "firman": "Ucapan ilahi terhadap \"padang gurun di tepi laut\". Seperti puting beliung mendesing lewat di Tanah Negeb, demikianlah datangnya dari padang gurun, dari negeri yang dahsyat."
 },
 {
   "id": 18042,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 2,
   "firman": "Suatu penglihatan yang kejam telah diberitakan kepadaku: \"Penggarong menggarong, perusak merusak! Majulah, hai Elam, kepunglah, hai Madai! Aku hentikan semua keluh yang ditimbulkannya.\""
 },
 {
   "id": 18043,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 3,
   "firman": "Sebab itu pinggangku amat sakit, sakit mulas menimpa aku seperti sakit mulas perempuan yang melahirkan; aku terbungkuk-bungkuk, tidak mendengar lagi, aku terkejut, tidak melihat lagi."
 },
 {
   "id": 18044,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 4,
   "firman": "Hatiku gelisah, kekejutan meliputi aku, malam hari yang selalu kurindukan itu sekarang menggentarkan aku."
 },
 {
   "id": 18045,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 5,
   "firman": "Orang sibuk menyajikan hidangan, mengatur tempat-tempat duduk, makan, minum...Tiba-tiba kedengaran: \"Hai para panglima! Siaplah tempur, minyakilah perisai!\""
 },
 {
   "id": 18046,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 6,
   "firman": "Sebab beginilah firman Tuhan kepadaku: \"Pergilah, tempatkanlah seorang peninjau, apa yang dilihatnya haruslah diberitahukannya."
 },
 {
   "id": 18047,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 7,
   "firman": "Apabila dilihatnya pasukan, pasang-pasangan orang berkuda, pasukan keledai, pasukan unta, maka haruslah diperhatikannya sungguh-sungguh, dengan penuh perhatian.\""
 },
 {
   "id": 18048,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 8,
   "firman": "Kemudian berserulah orang yang melihat itu: \"Di tempat peninjauan, ya tuanku, aku berdiri senantiasa sehari suntuk, dan di tempat pengawalanku aku terpancang setiap malam.\""
 },
 {
   "id": 18049,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 9,
   "firman": "Lihat, itu sudah datang sepasukan orang, pasang-pasangan orang berkuda! Lalu berserulah ia, katanya: \"Sudah jatuh, sudah jatuh Babel, dan segala patung berhalanya telah diremukkan dan bertaburan di tanah.\""
 },
 {
   "id": 18050,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 10,
   "firman": "Hai bangsaku yang telah dipijak-pijak dan diinjak-injak! Apa yang kudengar dari TUHAN semesta alam, Allah Israel, telah kuberitahukan kepadamu."
 },
 {
   "id": 18051,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 11,
   "firman": "Ucapan ilahi terhadap Duma. Ada seorang berseru kepadaku dari Seir: \"Hai pengawal, masih lama malam ini? Hai pengawal, masih lama malam ini?\""
 },
 {
   "id": 18052,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 12,
   "firman": "Pengawal itu berkata: \"Pagi akan datang, tetapi malam juga. Jika kamu mau bertanya, datanglah bertanya sekali lagi!\""
 },
 {
   "id": 18053,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 13,
   "firman": "Ucapan ilahi terhadap Arabia. Di belukar di Arabia kamu akan bermalam, hai kafilah-kafilah orang Dedan!"
 },
 {
   "id": 18054,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 14,
   "firman": "Hai penduduk tanah Tema, keluarlah, bawalah air kepada orang yang haus, pergilah, sambutlah orang pelarian dengan roti!"
 },
 {
   "id": 18055,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 15,
   "firman": "Sebab mereka melarikan diri terhadap pedang, ya terhadap pedang yang terhunus, terhadap busur yang dilentur, dan terhadap kehebatan peperangan."
 },
 {
   "id": 18056,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 16,
   "firman": "Sebab beginilah firman Tuhan kepadaku: \"Dalam setahun lagi, menurut masa kerja prajurit upahan, maka segala kemuliaan Kedar akan habis."
 },
 {
   "id": 18057,
   "kitab": "Yes",
   "pasal": 21,
   "ayat": 17,
   "firman": "Dan dari pemanah-pemanah yang gagah perkasa dari bani Kedar, akan tinggal sejumlah kecil saja, sebab TUHAN, Allah Israel, telah mengatakannya.\""
 },
 {
   "id": 18058,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 1,
   "firman": "Ucapan ilahi terhadap \"lembah penglihatan\". Ada apa gerangan, maka semua pendudukmu naik ke sotoh-sotoh rumah,"
 },
 {
   "id": 18059,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 2,
   "firman": "hai kota yang bersorak riuh dan ribut gembira, hai negeri yang beria-ria? Orang-orangmu yang mati terbunuh bukanlah terbunuh oleh pedang, dan bukanlah gugur dalam peperangan."
 },
 {
   "id": 18060,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 3,
   "firman": "Semua panglimamu sama-sama melarikan diri, mereka tertawan tanpa tembakan panah; semua orang-orang kuatmu sama-sama tertawan, biarpun mereka sudah lari jauh-jauh."
 },
 {
   "id": 18061,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 4,
   "firman": "Sebab itu aku berkata: \"Buanglah mukamu terhadap aku, biarkanlah aku menangis dalam kepahitan; janganlah mendesak aku, supaya aku terhibur mengenai kebinasaan puteri bangsaku.\""
 },
 {
   "id": 18062,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 5,
   "firman": "Sebab Tuhan, TUHAN semesta alam telah menentukan suatu hari: Ia akan menggemparkan, menginjak-injak dan mengacaukan orang: di \"lembah penglihatan\" tembok akan dirombak dan teriakan minta tolong sampai ke puncak gunung!"
 },
 {
   "id": 18063,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 6,
   "firman": "Elam telah memasang tabung panah, Aram datang dengan pasukan berkereta dan berkuda, dan Kir membuka sarung perisai."
 },
 {
   "id": 18064,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 7,
   "firman": "Maka lembah-lembahmu yang paling indah penuh dengan kereta, dan pasukan berkuda berbaris di hadapan pintu gerbang,"
 },
 {
   "id": 18065,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 8,
   "firman": "dan Yehuda kehilangan perlindungan. Pada waktu itu engkau memandang kepada perlengkapan senjata di \"Gedung Hutan\";"
 },
 {
   "id": 18066,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 9,
   "firman": "kamu melihat bahwa memang sudah banyak sekali retak-retak tembok kota Daud dan kamu mengumpulkan air kolam bawah;"
 },
 {
   "id": 18067,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 10,
   "firman": "kamu menghitung rumah-rumah di Yerusalem, dan kamu merobohkan rumah-rumah untuk meneguhkan tembok;"
 },
 {
   "id": 18068,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 11,
   "firman": "kamu membuat tempat pengumpulan air di antara kedua tembok itu untuk menampung air dari kolam yang lama; tetapi kamu tidak memandang kepada Dia yang membuatnya, dan tidak melihat kepada Dia yang telah sejak dahulu membentuknya."
 },
 {
   "id": 18069,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 12,
   "firman": "Pada waktu itu Tuhan, TUHAN semesta alam menyuruh orang menangis dan meratap dengan menggundul kepala dan melilitkan kain kabung;"
 },
 {
   "id": 18070,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 13,
   "firman": "tetapi lihat, di tengah-tengah mereka ada kegirangan dan sukacita, membantai lembu dan menyembelih domba, makan daging dan minum anggur, sambil berseru: \"Marilah kita makan dan minum, sebab besok kita mati!\""
 },
 {
   "id": 18071,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 14,
   "firman": "Tetapi TUHAN semesta alam menyatakan diri dan berfirman kepadaku: \"Sungguh, kesalahanmu ini tidak akan diampuni, sampai kamu mati,\" firman Tuhan, TUHAN semesta alam."
 },
 {
   "id": 18072,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 15,
   "firman": "Beginilah firman Tuhan, TUHAN semesta alam: \"Mari, pergilah kepada kepala istana ini, kepada Sebna yang mengurus istana, dan katakan:"
 },
 {
   "id": 18073,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 16,
   "firman": "Ada apamu dan siapamu di sini, maka engkau menggali kubur bagimu di sini, hai yang menggali kuburnya di tempat tinggi, yang memahat kediaman baginya di bukit batu?"
 },
 {
   "id": 18074,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 17,
   "firman": "Sesungguhnya, TUHAN akan melontarkan engkau jauh-jauh, hai orang! Ia akan memegang engkau dengan kuat-kuat"
 },
 {
   "id": 18075,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 18,
   "firman": "dan menggulung engkau keras-keras menjadi suatu gulungan dan menggulingkan engkau seperti bola ke tanah yang luas; di situlah engkau akan mati, dan di situlah akan tinggal kereta-kereta kemuliaanmu, hai engkau yang memalukan keluarga tuanmu!"
 },
 {
   "id": 18076,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 19,
   "firman": "Aku akan melemparkan engkau dari jabatanmu, dan dari pangkatmu engkau akan dijatuhkan."
 },
 {
   "id": 18077,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 20,
   "firman": "Maka pada waktu itu Aku akan memanggil hamba-Ku, Elyakim bin Hilkia:"
 },
 {
   "id": 18078,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 21,
   "firman": "Aku akan mengenakan jubahmu kepadanya dan ikat pinggangmu akan Kuikatkan kepadanya, dan kekuasaanmu akan Kuberikan ke tangannya; maka ia akan menjadi bapa bagi penduduk Yerusalem dan bagi kaum Yehuda."
 },
 {
   "id": 18079,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 22,
   "firman": "Aku akan menaruh kunci rumah Daud ke atas bahunya: apabila ia membuka, tidak ada yang dapat menutup; apabila ia menutup, tidak ada yang dapat membuka."
 },
 {
   "id": 18080,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 23,
   "firman": "Aku akan memberikan dia kedudukan yang teguh seperti gantungan yang dipasang kuat-kuat pada tembok yang kokoh; maka ia akan menjadi kursi kemuliaan bagi kaum keluarganya."
 },
 {
   "id": 18081,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 24,
   "firman": "Dan padanya akan digantungkan segala tanggungan kaum keluarganya, tunas dan taruk, beserta segala perkakas yang kecil, dari piring pasu sampai periuk belanga."
 },
 {
   "id": 18082,
   "kitab": "Yes",
   "pasal": 22,
   "ayat": 25,
   "firman": "Maka pada waktu itu, demikianlah firman TUHAN semesta alam, gantungan yang dipasang kuat-kuat pada tempat yang kokoh itu tidak akan kuat lagi, sehingga patah dan jatuh, dan segala tanggungannya itu hancur, sebab TUHAN telah mengatakannya.\""
 },
 {
   "id": 18083,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 1,
   "firman": "Ucapan ilahi tentang Tirus. Merataplah, hai kapal-kapal Tarsis, sebab Tirus sudah rusak, tiada lagi rumahmu atau pangkalanmu! Ketika mereka masih di negeri orang Kitim telah dinyatakan hal itu kepada mereka."
 },
 {
   "id": 18084,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 2,
   "firman": "Berdiam dirilah, hai penduduk tanah pesisir, hai saudagar Sidon, suruhan-suruhanmu mengarungi laut, dan berlayar di samudera besar;"
 },
 {
   "id": 18085,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 3,
   "firman": "barang-barang yang dimasukkan ke Sidon ialah gandum dari Sihor, dan panen daerah Nil, sehingga kota itu menjadi pasar bagi bangsa-bangsa."
 },
 {
   "id": 18086,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 4,
   "firman": "Tahulah malu hai Sidon, sebab laut, benteng laut, berbicara, katanya: \"Aku tidak pernah menggeliat sakit dan tidak melahirkan, aku tidak pernah membesarkan anak-anak teruna, dan tidak mengasuh anak-anak dara.\""
 },
 {
   "id": 18087,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 5,
   "firman": "Apabila kabar tentang Tirus itu sampai ke Mesir, mereka akan gemetar mendengarnya."
 },
 {
   "id": 18088,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 6,
   "firman": "Mengungsilah ke Tarsis, merataplah, hai penduduk tanah pesisir!"
 },
 {
   "id": 18089,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 7,
   "firman": "Inikah kotamu yang beria-ria, yang asalnya dari zaman purbakala? Orangnya telah melawat ke tempat yang jauh untuk merantau ke sana."
 },
 {
   "id": 18090,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 8,
   "firman": "Siapakah yang memutuskan ini atas Tirus, kota yang pernah menghadiahkan mahkota, yang saudagar-saudagarnya pembesar-pembesar dan pedagang-pedagangnya orang-orang mulia di bumi?"
 },
 {
   "id": 18091,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 9,
   "firman": "TUHAN semesta alam yang telah memutuskannya untuk mematahkan kesombongan, untuk menghinakan segala yang permai dan semua orang mulia di bumi."
 },
 {
   "id": 18092,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 10,
   "firman": "Kerjakanlah ladangmu seperti di tepi sungai Nil, hai puteri Tarsis, sudah tidak ada lagi galangan-galangan kapal!"
 },
 {
   "id": 18093,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 11,
   "firman": "TUHAN telah mengacungkan tangan-Nya terhadap laut dan membuat kerajaan-kerajaan gemetar; Ia telah memberi perintah mengenai Kanaan untuk memusnahkan benteng-bentengnya."
 },
 {
   "id": 18094,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 12,
   "firman": "Dan ia telah berfirman: \"Engkau tidak akan beria-ria lagi, hai anak dara yang digagahi, hai puteri Sidon! Bangkitlah, mengungsilah kepada orang Kitim! Di sanapun juga tidak akan ada tempat yang senang bagimu.\""
 },
 {
   "id": 18095,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 13,
   "firman": "Lihat negeri orang Kasdim! Bangsa itulah yang melakukannya, bukan orang Asyur. Mereka telah menyerahkan Tirus kepada binatang-binatang gurun, mereka telah mendirikan menara-menara pengepungan dan telah meratakan puri-puri kota itu dan membuat kota itu menjadi reruntuhan."
 },
 {
   "id": 18096,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 14,
   "firman": "Merataplah, hai kapal-kapal Tarsis, sebab sudah dirusakkan bentengmu!"
 },
 {
   "id": 18097,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 15,
   "firman": "Pada waktu itu Tirus akan dilupakan tujuh puluh tahun lamanya, sama dengan umur seorang raja. Sesudah lewat tujuh puluh tahun, akan terjadi kepada Tirus seperti terjadi kepada perempuan sundal dalam nyanyian ini:"
 },
 {
   "id": 18098,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 16,
   "firman": "\"Ambillah kecapi, kelilingilah kota, hai sundal yang dilupakan! Petiklah baik-baik, bernyanyilah banyak-banyak, supaya engkau diingat orang.\""
 },
 {
   "id": 18099,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 17,
   "firman": "Dan sesudah lewat tujuh puluh tahun, TUHAN akan memperhatikan Tirus, sehingga ia kembali mendapat upah sundalnya, dan ia akan bersundal dengan segala kerajaan yang ada di muka bumi."
 },
 {
   "id": 18100,
   "kitab": "Yes",
   "pasal": 23,
   "ayat": 18,
   "firman": "Labanya dan upah sundalnya akan kudus bagi TUHAN, tidak akan ditahan atau disimpan, tetapi dengan labanya itu akan disediakan makanan yang cukup dan pakaian yang indah bagi orang-orang yang diam di hadapan TUHAN."
 },
 {
   "id": 18101,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 1,
   "firman": "Sesungguhnya, TUHAN akan menanduskan bumi dan akan menghancurkannya, akan membalikkan permukaannya, dan akan menyerakkan penduduknya."
 },
 {
   "id": 18102,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 2,
   "firman": "Maka seperti nasib rakyat demikianlah nasib imam, seperti nasib hamba laki-laki demikianlah nasib tuannya, seperti nasib hamba perempuan demikianlah nasib nyonyanya, seperti nasib pembeli demikianlah nasib penjual, seperti nasib peminjam demikianlah nasib yang meminjamkan, seperti nasib orang yang berhutang demikianlah nasib orang yang berpiutang."
 },
 {
   "id": 18103,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 3,
   "firman": "Bumi akan ditanduskan setandus-tandusnya, dan akan dijarah sehabis-habisnya, sebab Tuhanlah yang mengucapkan firman ini."
 },
 {
   "id": 18104,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 4,
   "firman": "Bumi berkabung dan layu, ya, dunia merana dan layu, langit dan bumi merana bersama."
 },
 {
   "id": 18105,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 5,
   "firman": "Bumi cemar karena penduduknya, sebab mereka melanggar undang-undang, mengubah ketetapan dan mengingkari perjanjian abadi."
 },
 {
   "id": 18106,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 6,
   "firman": "Sebab itu sumpah serapah akan memakan bumi, dan penduduknya akan mendapat hukuman; sebab itu penduduk bumi akan hangus lenyap, dan manusia akan tinggal sedikit."
 },
 {
   "id": 18107,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 7,
   "firman": "Air anggur tidak menggirangkan lagi, pohon anggur merana, dan semua orang yang bersukahati mengeluh."
 },
 {
   "id": 18108,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 8,
   "firman": "Kegirangan suara rebana sudah berhenti, keramaian orang-orang yang beria-ria sudah diam, dan kegirangan suara kecapi sudah berhenti."
 },
 {
   "id": 18109,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 9,
   "firman": "Tiada lagi orang minum anggur dengan bernyanyi, arak menjadi pahit bagi orang yang meminumnya."
 },
 {
   "id": 18110,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 10,
   "firman": "Kota yang kacau riuh sudah hancur, setiap rumah sudah tertutup, tidak dapat dimasuki."
 },
 {
   "id": 18111,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 11,
   "firman": "Orang menjerit di jalan-jalan karena tiada anggur, segala sukacita sudah lenyap, kegirangan bumi sudah hilang."
 },
 {
   "id": 18112,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 12,
   "firman": "Yang terdapat dalam kota hanya kerusakan, pintu gerbang telah didobrak dan runtuh."
 },
 {
   "id": 18113,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 13,
   "firman": "Sebab beginilah akan terjadi di atas bumi, di tengah-tengah bangsa-bangsa, yaitu seperti pada waktu orang menjolok buah zaitun, seperti pada waktu pemetikan susulan, apabila panen buah anggur sudah berakhir."
 },
 {
   "id": 18114,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 14,
   "firman": "Dengan suara nyaring mereka bersorak-sorai, demi kemegahan TUHAN, mereka memekik dari sebelah barat:"
 },
 {
   "id": 18115,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 15,
   "firman": "\"Sebab itu permuliakanlah TUHAN di negeri-negeri timur, nama TUHAN, Allah Israel, di tanah-tanah pesisir laut!\""
 },
 {
   "id": 18116,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 16,
   "firman": "Dari ujung bumi kami dengar nyanyian pujian: \"Hormat bagi Yang Mahaadil!\" Tetapi aku berkata: \"Kurus merana aku, kurus merana aku. Celakalah aku! Sebab para penggarong menggarong, ya, terus-menerus mereka melakukan penggarongannya!\""
 },
 {
   "id": 18117,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 17,
   "firman": "Hai penduduk bumi, kamu akan dikejutkan, akan masuk pelubang dan jerat!"
 },
 {
   "id": 18118,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 18,
   "firman": "Maka yang lari karena bunyi yang mengejutkan akan jatuh ke dalam pelubang, dan yang naik dari dalam pelubang akan tertangkap dalam jerat. Sebab tingkap-tingkap di langit akan terbuka dan akan bergoncang dasar-dasar bumi."
 },
 {
   "id": 18119,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 19,
   "firman": "Bumi remuk redam, bumi hancur luluh bumi goncang-gancing."
 },
 {
   "id": 18120,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 20,
   "firman": "Bumi terhuyung-huyung sama sekali seperti orang mabuk dan goyang seperti gubuk yang ditiup angin; dosa pemberontakannya menimpa dia dengan sangat, ia rebah dan tidak akan bangkit-bangkit lagi."
 },
 {
   "id": 18121,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 21,
   "firman": "Maka pada hari itu TUHAN akan menghukum tentara langit di langit dan raja-raja bumi di atas bumi."
 },
 {
   "id": 18122,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 22,
   "firman": "Mereka akan dikumpulkan bersama-sama, seperti tahanan dimasukkan dalam liang; mereka akan dimasukkan dalam penjara dan akan dihukum sesudah waktu yang lama."
 },
 {
   "id": 18123,
   "kitab": "Yes",
   "pasal": 24,
   "ayat": 23,
   "firman": "Bulan purnama akan tersipu-sipu, dan matahari terik akan mendapat malu, sebab TUHAN semesta alam akan memerintah di gunung Sion dan di Yerusalem, dan Ia akan menunjukkan kemuliaan-Nya di depan tua-tua umat-Nya."
 },
 {
   "id": 18124,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 1,
   "firman": "Ya TUHAN, Engkaulah Allahku; aku mau meninggikan Engkau, mau menyanyikan syukur bagi nama-Mu; sebab dengan kesetiaan yang teguh Engkau telah melaksanakan rancangan-Mu yang ajaib yang telah ada sejak dahulu."
 },
 {
   "id": 18125,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 2,
   "firman": "Sebab Engkau telah membuat kota itu menjadi timbunan batu, dan kota yang berkubu itu menjadi reruntuhan; puri orang luar tidak lagi menjadi kota, dan tidak dibangunkan lagi untuk selama-lamanya."
 },
 {
   "id": 18126,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 3,
   "firman": "Oleh karena itu suatu bangsa yang kuat akan memuliakan Engkau; kota bangsa-bangsa yang gagah akan takut kepada-Mu."
 },
 {
   "id": 18127,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 4,
   "firman": "Sebab Engkau menjadi tempat pengungsian bagi orang lemah, tempat pengungsian bagi orang miskin dalam kesesakannya, perlindungan terhadap angin ribut, naungan terhadap panas terik, sebab amarah orang-orang yang gagah sombong itu seperti angin ribut di musim dingin,"
 },
 {
   "id": 18128,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 5,
   "firman": "seperti panas terik di tempat kering. Kegaduhan orang-orang luar Kaudiamkan; seperti panas terik ditiadakan oleh naungan awan, demikianlah nyanyian orang-orang yang gagah sombong ditiadakan."
 },
 {
   "id": 18129,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 6,
   "firman": "TUHAN semesta alam akan menyediakan di gunung Sion ini bagi segala bangsa-bangsa suatu perjamuan dengan masakan yang bergemuk, suatu perjamuan dengan anggur yang tua benar, masakan yang bergemuk dan bersumsum, anggur yang tua yang disaring endapannya."
 },
 {
   "id": 18130,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 7,
   "firman": "Dan di atas gunung ini TUHAN akan mengoyakkan kain perkabungan yang diselubungkan kepada segala suku bangsa dan tudung yang ditudungkan kepada segala bangsa-bangsa."
 },
 {
   "id": 18131,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 8,
   "firman": "Ia akan meniadakan maut untuk seterusnya; dan Tuhan ALLAH akan menghapuskan air mata dari pada segala muka; dan aib umat-Nya akan dijauhkan-Nya dari seluruh bumi, sebab TUHAN telah mengatakannya."
 },
 {
   "id": 18132,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 9,
   "firman": "Pada waktu itu orang akan berkata: \"Sesungguhnya, inilah Allah kita, yang kita nanti-nantikan, supaya kita diselamatkan. Inilah TUHAN yang kita nanti-nantikan; marilah kita bersorak-sorak dan bersukacita oleh karena keselamatan yang diadakan-Nya!\""
 },
 {
   "id": 18133,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 10,
   "firman": "Sebab tangan TUHAN akan melindungi gunung ini, tetapi Moab akan diinjak-injak di tempatnya sendiri, sebagai jerami diinjak-injak dalam lobang kotoran."
 },
 {
   "id": 18134,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 11,
   "firman": "Apabila Moab mengembangkan tangannya di dalamnya seperti cara perenang mengembangkannya untuk berenang, maka TUHAN akan mematahkan kecongkakkan mereka dengan segala daya upaya mereka."
 },
 {
   "id": 18135,
   "kitab": "Yes",
   "pasal": 25,
   "ayat": 12,
   "firman": "Maka kubu-kubu tembokmu yang tinggi akan ditumbangkan-Nya dan dirubuhkan-Nya, dan dicampakkan-Nya ke tanah dan debu."
 },
 {
   "id": 18136,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 1,
   "firman": "Pada waktu itu nyanyian ini akan dinyanyikan di tanah Yehuda: \"Pada kita ada kota yang kuat, untuk keselamatan kita TUHAN telah memasang tembok dan benteng."
 },
 {
   "id": 18137,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 2,
   "firman": "Bukalah pintu-pintu gerbang, supaya masuk bangsa yang benar dan yang tetap setia!"
 },
 {
   "id": 18138,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 3,
   "firman": "Yang hatinya teguh Kaujagai dengan damai sejahtera, sebab kepada-Mulah ia percaya."
 },
 {
   "id": 18139,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 4,
   "firman": "Percayalah kepada TUHAN selama-lamanya, sebab TUHAN ALLAH adalah gunung batu yang kekal."
 },
 {
   "id": 18140,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 5,
   "firman": "Sebab Ia sudah menundukkan penduduk tempat tinggi; kota yang berbenteng telah direndahkan-Nya, direndahkan-Nya sampai ke tanah dan dicampakkan-Nya sampai ke debu."
 },
 {
   "id": 18141,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 6,
   "firman": "Kaki orang-orang sengsara, telapak kaki orang-orang lemah akan menginjak-injaknya.\""
 },
 {
   "id": 18142,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 7,
   "firman": "Jejak orang benar adalah lurus, sebab Engkau yang merintis jalan lurus baginya."
 },
 {
   "id": 18143,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 8,
   "firman": "Ya TUHAN, kami juga menanti-nantikan saatnya Engkau menjalankan penghakiman; kesukaan kami ialah menyebut nama-Mu dan mengingat Engkau."
 },
 {
   "id": 18144,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 9,
   "firman": "Dengan segenap jiwa aku merindukan Engkau pada waktu malam, juga dengan sepenuh hati aku mencari Engkau pada waktu pagi; sebab apabila Engkau datang menghakimi bumi, maka penduduk dunia akan belajar apa yang benar."
 },
 {
   "id": 18145,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 10,
   "firman": "Seandainya orang fasik dikasihani, ia tidak akan belajar apa yang benar; ia akan berbuat curang di negeri di mana hukum berlaku, dan tidak akan melihat kemuliaan TUHAN."
 },
 {
   "id": 18146,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 11,
   "firman": "Ya TUHAN, tangan-Mu dinaikkan, tetapi mereka tidak melihatnya. Biarlah mereka melihat kecemburuan-Mu karena umat-Mu dan biarlah mereka mendapat malu! Biarlah api yang memusnahkan lawan-Mu memakan mereka habis!"
 },
 {
   "id": 18147,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 12,
   "firman": "Ya TUHAN, Engkau akan menyediakan damai sejahtera bagi kami, sebab segala sesuatu yang kami kerjakan, Engkaulah yang melakukannya bagi kami."
 },
 {
   "id": 18148,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 13,
   "firman": "Ya TUHAN, Allah kami, tuan-tuan lain pernah berkuasa atas kami, tetapi hanya nama-Mu saja kami masyhurkan."
 },
 {
   "id": 18149,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 14,
   "firman": "Mereka sudah mati, tidak akan hidup pula, sudah menjadi arwah, tidak akan bangkit pula; sesungguhnya, Engkau telah menghukum dan memunahkan mereka, dan meniadakan segala ingatan kepada mereka."
 },
 {
   "id": 18150,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 15,
   "firman": "Ya TUHAN, Engkau telah membuat bangsa ini bertambah-tambah, ya, membuat bertambah-tambah umat kemuliaan-Mu; Engkau telah sangat memperluas negerinya."
 },
 {
   "id": 18151,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 16,
   "firman": "Ya TUHAN, dalam kesesakan mereka mencari Engkau; ketika hajaran-Mu menimpa mereka, mereka mengeluh dalam doa."
 },
 {
   "id": 18152,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 17,
   "firman": "Seperti perempuan yang mengandung yang sudah dekat waktunya untuk melahirkan, menggeliat sakit, mengerang karena sakit beranak, demikianlah tadinya keadaan kami di hadapan-Mu, ya TUHAN:"
 },
 {
   "id": 18153,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 18,
   "firman": "Kami mengandung, kami menggeliat sakit, tetapi seakan-akan kami melahirkan angin: kami tidak dapat mengadakan keselamatan di bumi, dan tiada lahir penduduk dunia."
 },
 {
   "id": 18154,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 19,
   "firman": "Ya, TUHAN, orang-orang-Mu yang mati akan hidup pula, mayat-mayat mereka akan bangkit pula. Hai orang-orang yang sudah dikubur di dalam tanah bangkitlah dan bersorak-sorai! Sebab embun TUHAN ialah embun terang, dan bumi akan melahirkan arwah kembali."
 },
 {
   "id": 18155,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 20,
   "firman": "Mari bangsaku, masuklah ke dalam kamarmu, tutuplah pintumu sesudah engkau masuk, bersembunyilah barang sesaat lamanya, sampai amarah itu berlalu."
 },
 {
   "id": 18156,
   "kitab": "Yes",
   "pasal": 26,
   "ayat": 21,
   "firman": "Sebab sesungguhnya, TUHAN mau keluar dari tempat-Nya untuk menghukum penduduk bumi karena kesalahannya, dan bumi tidak lagi menyembunyikan darah yang tertumpah di atasnya, tidak lagi menutupi orang-orang yang mati terbunuh di sana."
 },
 {
   "id": 18157,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 1,
   "firman": "Pada waktu itu TUHAN akan melaksanakan hukuman dengan pedang-Nya yang keras, besar dan kuat atas Lewiatan, ular yang meluncur, atas Lewiatan, ular yang melingkar, dan Ia akan membunuh ular naga yang di laut."
 },
 {
   "id": 18158,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 2,
   "firman": "Pada waktu itu akan dikatakan: \"Bernyanyilah tentang kebun anggur yang elok!"
 },
 {
   "id": 18159,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 3,
   "firman": "Aku, TUHAN, penjaganya; setiap saat Aku menyiraminya. Supaya jangan orang mengganggunya, siang malam Aku menjaganya;"
 },
 {
   "id": 18160,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 4,
   "firman": "kehangatan murka tiada pada-Ku. Sekiranya tampak kepada-Ku puteri malu dan rumput, Aku akan bertindak memeranginya dan akan membakarnya sekaligus,"
 },
 {
   "id": 18161,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 5,
   "firman": "kecuali kalau mereka mencari perlindungan kepada-Ku dan mencari damai dengan Aku, ya mencari damai dengan Aku!\""
 },
 {
   "id": 18162,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 6,
   "firman": "Pada hari-hari yang akan datang, Yakub akan berakar, Israel akan berkembang dan bertunas dan memenuhi muka bumi dengan hasilnya."
 },
 {
   "id": 18163,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 7,
   "firman": "Apakah TUHAN memusnahkan umat-Nya seperti Ia memusnahkan orang yang memusnahkan mereka? Atau apakah Ia membunuh umat-Nya seperti Ia membunuh orang yang membunuh mereka?"
 },
 {
   "id": 18164,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 8,
   "firman": "Dengan menghalau dan dengan mengusir mereka Engkau telah melawan mereka. Ia telah menyisihkan mereka dengan angin-Nya yang keras di waktu angin timur."
 },
 {
   "id": 18165,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 9,
   "firman": "Maka beginilah akan dihapuskan kesalahan Yakub dan inilah buahnya kalau ia menjauhkan dosanya: ia akan membuat segala batu mezbah seperti batu-batu kapur yang dipecah-pecahkan, sehingga tiada lagi tiang-tiang berhala dan pedupaan-pedupaan yang tinggal berdiri."
 },
 {
   "id": 18166,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 10,
   "firman": "Sebab kota yang berkubu itu terpencil, suatu tempat kediaman yang dikosongkan dan ditinggalkan seperti padang gurun; anak lembu akan makan rumput dan berbaring di situ menghabiskan dahan-dahan pohon."
 },
 {
   "id": 18167,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 11,
   "firman": "Apabila ranting-rantingnya sudah kering, maka akan dipatahkan; perempuan-perempuan akan datang dan menyalakannya. Sebab inilah suatu bangsa yang tidak berakal budi, itulah sebabnya dia tidak disayangi oleh Dia yang menjadikannya dan tidak dikasihi oleh Dia yang membentuknya."
 },
 {
   "id": 18168,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 12,
   "firman": "Maka pada waktu itu TUHAN akan mengirik mulai dari sungai Efrat sampai sungai Mesir, dan kamu ini akan dikumpulkan satu demi satu, hai orang Israel!"
 },
 {
   "id": 18169,
   "kitab": "Yes",
   "pasal": 27,
   "ayat": 13,
   "firman": "Pada waktu itu sangkakala besar akan ditiup, dan akan datang mereka yang hilang di tanah Asyur serta mereka yang terbuang ke tanah Mesir untuk sujud menyembah kepada TUHAN di gunung yang kudus, di Yerusalem."
 },
 {
   "id": 18170,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 1,
   "firman": "Celaka atas mahkota kemegahan pemabuk-pemabuk Efraim, atas bunga yang sudah mulai layu di perhiasan kepala mereka yang indah-indah--yaitu kota yang terletak tinggi di atas bukit, di atas lembah yang subur yang penuh peminum anggur yang sudah pening--!"
 },
 {
   "id": 18171,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 2,
   "firman": "Sesungguhnya, pada Tuhan ada seorang yang kuat dan tegap, seorang yang seperti angin ribut disertai hujan batu, yakni badai yang membinasakan, seorang yang seperti angin ribut disertai air hujan yang hebat menghanyutkan; ia akan menghempaskan mereka ke tanah dengan kekerasan."
 },
 {
   "id": 18172,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 3,
   "firman": "Mahkota kemegahan pemabuk-pemabuk Efraim itu akan diinjak-injak dengan kaki,"
 },
 {
   "id": 18173,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 4,
   "firman": "dan bunga yang sudah mulai layu di perhiasan kepala mereka yang indah-indah itu--yaitu kota yang terletak tinggi di atas bukit, di atas lembah yang subur--nasibnya akan seperti nasib buah ara yang masak duluan sebelum musim kemarau: baru saja dilihat orang terus dipetik dan ditelan."
 },
 {
   "id": 18174,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 5,
   "firman": "Pada waktu itu TUHAN semesta alam akan menjadi mahkota kepermaian, dan perhiasan kepala yang indah-indah bagi sisa umat-Nya,"
 },
 {
   "id": 18175,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 6,
   "firman": "akan menjadi roh keadilan bagi orang yang duduk mengadili, dan menjadi roh kepahlawanan bagi orang yang memukul mundur peperangan ke arah pintu gerbang."
 },
 {
   "id": 18176,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 7,
   "firman": "Tetapi orang-orang di sinipun pening karena anggur dan pusing karena arak. Baik imam maupun nabi pening karena arak, kacau oleh anggur; mereka pusing oleh arak, pening pada waktu melihat penglihatan, goyang pada waktu memberi keputusan."
 },
 {
   "id": 18177,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 8,
   "firman": "Sungguh, segala meja penuh dengan muntah, kotoran, sehingga tidak ada tempat yang bersih lagi."
 },
 {
   "id": 18178,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 9,
   "firman": "Dan orang berkata: \"Kepada siapakah dia ini mau mengajarkan pengetahuannya dan kepada siapakah ia mau menjelaskan nubuat-nubuatnya? Seolah-olah kepada anak yang baru disapih, dan yang baru cerai susu!"
 },
 {
   "id": 18179,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 10,
   "firman": "Sebab harus ini harus itu, mesti begini mesti begitu, tambah ini, tambah itu!\""
 },
 {
   "id": 18180,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 11,
   "firman": "Sungguh, oleh orang-orang yang berlogat ganjil dan oleh orang-orang yang berbahasa asing akan berbicara kepada bangsa ini"
 },
 {
   "id": 18181,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 12,
   "firman": "Dia yang telah berfirman kepada mereka: \"Inilah tempat perhentian, berilah perhentian kepada orang yang lelah; inilah tempat peristirahatan!\" Tetapi mereka tidak mau mendengarkan."
 },
 {
   "id": 18182,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 13,
   "firman": "Maka mereka akan mendengarkan firman TUHAN yang begini: \"Harus ini harus itu, mesti begini mesti begitu, tambah ini tambah itu!\" supaya dalam berjalan mereka jatuh telentang, sehingga luka, tertangkap dan tertawan."
 },
 {
   "id": 18183,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 14,
   "firman": "Sebab itu dengarlah firman TUHAN, hai orang-orang pencemooh, hai orang-orang yang memerintah rakyat yang ada di Yerusalem ini!"
 },
 {
   "id": 18184,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 15,
   "firman": "Karena kamu telah berkata: \"Kami telah mengikat perjanjian dengan maut, dan dengan dunia maut kami telah mengadakan persetujuan; biarpun cemeti berdesik-desik dengan kerasnya, kami tidak akan kena; sebab kami telah membuat bohong sebagai perlindungan kami, dan dalam dusta kami menyembunyikan diri,\""
 },
 {
   "id": 18185,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 16,
   "firman": "sebab itu beginilah firman Tuhan ALLAH: \"Sesungguhnya, Aku meletakkan sebagai dasar di Sion sebuah batu, batu yang teruji, sebuah batu penjuru yang mahal, suatu dasar yang teguh: Siapa yang percaya, tidak akan gelisah!"
 },
 {
   "id": 18186,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 17,
   "firman": "Dan Aku akan membuat keadilan menjadi tali pengukur, dan kebenaran menjadi tali sipat; hujan batu akan menyapu bersih perlindungan bohong, dan air lebat akan menghanyutkan persembunyian.\""
 },
 {
   "id": 18187,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 18,
   "firman": "Perjanjianmu dengan maut itu akan ditiadakan, dan persetujuanmu dengan dunia orang mati itu tidak akan tetap berlaku; apabila cemeti berdesik-desik dengan kerasnya, kamu akan hancur diinjak-injak."
 },
 {
   "id": 18188,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 19,
   "firman": "Seberapa kali ia datang, ia akan menyeret kamu, sebab pagi demi pagi ia akan datang, pada waktu siang dan pada waktu malam; maka adalah semata-mata kengerian untuk mengerti firman yang didengar itu."
 },
 {
   "id": 18189,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 20,
   "firman": "Sebab tempat tidur akan kurang panjang untuk dipakai membujurkan diri dan selimut akan kurang lebar untuk dipakai menyelubungi diri."
 },
 {
   "id": 18190,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 21,
   "firman": "Sebab TUHAN akan bangkit seperti di gunung Perasim, Ia akan mengamuk seperti di lembah dekat Gibeon, untuk melakukan perbuatan-Nya--ganjil perbuatan-Nya itu; dan untuk mengerjakan pekerjaan-Nya--ajaib pekerjaan-Nya itu!"
 },
 {
   "id": 18191,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 22,
   "firman": "Oleh sebab itu, janganlah kamu mencemooh, supaya tali belenggumu jangan semakin keras, sebab kudengar tentang kebinasaan yang sudah pasti yang datang dari Tuhan ALLAH semesta alam atas seluruh negeri itu."
 },
 {
   "id": 18192,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 23,
   "firman": "Pasanglah telinga dan dengarkanlah suaraku; perhatikanlah dan dengarkanlah perkataanku!"
 },
 {
   "id": 18193,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 24,
   "firman": "Setiap harikah orang membajak, mencangkul dan menyisir tanahnya untuk menabur?"
 },
 {
   "id": 18194,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 25,
   "firman": "Bukankah setelah meratakan tanahnya, ia menyerakkan jintan hitam dan menebarkan jintan putih, menaruh gandum jawawut dan jelai kehitam-hitaman dan sekoi di pinggirnya?"
 },
 {
   "id": 18195,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 26,
   "firman": "Mengenai adat kebiasaan ia telah diajari, diberi petunjuk oleh Allahnya."
 },
 {
   "id": 18196,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 27,
   "firman": "Sebab jintan hitam tidak diirik dengan eretan pengirik, dan roda gerobak tidak dipakai untuk menggiling jintan putih, tetapi jintan hitam diirik dengan memukul-mukulnya dengan galah, dan jintan putih dengan tongkat."
 },
 {
   "id": 18197,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 28,
   "firman": "Apakah orang waktu mengirik memukul gandum sampai hancur? sungguh tidak, orang tidak terus-menerus memukulnya sampai hancur! Dan sekalipun orang menjalankan di atas gandum itu jentera gerobak dengan kudanya, namun orang tidak akan menggilingnya sampai hancur."
 },
 {
   "id": 18198,
   "kitab": "Yes",
   "pasal": 28,
   "ayat": 29,
   "firman": "Dan inipun datangnya dari TUHAN semesta alam; Ia ajaib dalam keputusan dan agung dalam kebijaksanaan."
 },
 {
   "id": 18199,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 1,
   "firman": "Celakalah Ariel, Ariel, kota tempat Daud berkemah! Biarlah tahun demi tahun perayaan-perayaan silih berganti!"
 },
 {
   "id": 18200,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 2,
   "firman": "Aku akan menyesakkan Ariel, sehingga orang mengerang dan mengaduh, dan kota itu akan seperti perapian bagi-Ku."
 },
 {
   "id": 18201,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 3,
   "firman": "Aku akan berkemah di segala penjuru mengepung engkau, dan akan membuat tempat-tempat pengintaian untuk mengimpit engkau, dan akan mendirikan pagar-pagar pengepungan terhadap engkau."
 },
 {
   "id": 18202,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 4,
   "firman": "Maka engkau akan merendahkan diri dan engkau bersuara dari dalam tanah, perkataanmu kedengaran samar-samar dari dalam debu; suaramu akan berbunyi seperti suara arwah dari dalam tanah, dan perkataanmu akan kedengaran seperti bisikan dari dalam debu."
 },
 {
   "id": 18203,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 5,
   "firman": "Akan tetapi segala pasukan lawanmu akan hilang lenyap seperti abu halus, dan semua orang yang gagah sombong akan menjadi seperti sekam yang melintas terbang. Sebab dengan tiba-tiba, dalam sekejap mata,"
 },
 {
   "id": 18204,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 6,
   "firman": "engkau akan melihat kedatangan TUHAN semesta alam dalam guntur, gempa dan suara hebat, dalam puting beliung dan badai dan dalam nyala api yang memakan habis."
 },
 {
   "id": 18205,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 7,
   "firman": "Maka segala pasukan bangsa-bangsa yang berperang melawan Ariel, dan semua orang yang memerangi dia dan kubu pertahanannya dan orang-orang yang menyesakkan dia akan seperti mimpi dan seperti penglihatan malam-malam:"
 },
 {
   "id": 18206,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 8,
   "firman": "seumpama seorang yang lapar bermimpi ia sedang makan, pada waktu terjaga, perutnya masih kosong, atau seumpama seorang yang haus bermimpi ia sedang minum, pada waktu terjaga, sesungguhnya ia masih lelah, kerongkongannya masih dahaga, demikianlah halnya dengan segala pasukan bangsa-bangsa yang berperang melawan gunung Sion."
 },
 {
   "id": 18207,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 9,
   "firman": "Tercengang-cenganglah, penuh keheranan, biarlah matamu tertutup, buta semata-mata! Jadilah mabuk, tetapi bukan karena anggur, jadilah pusing, tetapi bukan karena arak!"
 },
 {
   "id": 18208,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 10,
   "firman": "Sebab TUHAN telah membuat kamu tidur nyenyak; matamu--yakni para nabi--telah dipejamkan-Nya dan mukamu--yaitu para pelihat--telah ditudungi-Nya."
 },
 {
   "id": 18209,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 11,
   "firman": "Maka bagimu penglihatan dari semuanya itu seperti isi sebuah kitab yang termeterai, apabila itu diberikan kepada orang yang tahu membaca dengan mengatakan: \"Baiklah baca ini,\" maka ia akan menjawab: \"Aku tidak dapat, sebab kitab itu termeterai\";"
 },
 {
   "id": 18210,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 12,
   "firman": "dan apabila kitab itu diberikan kepada seorang yang tidak dapat membaca dengan mengatakan: \"Baiklah baca ini,\" maka ia akan menjawab: \"Aku tidak dapat membaca.\""
 },
 {
   "id": 18211,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 13,
   "firman": "Dan Tuhan telah berfirman: \"Oleh karena bangsa ini datang mendekat dengan mulutnya dan memuliakan Aku dengan bibirnya, padahal hatinya menjauh dari pada-Ku, dan ibadahnya kepada-Ku hanyalah perintah manusia yang dihafalkan,"
 },
 {
   "id": 18212,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 14,
   "firman": "maka sebab itu, sesungguhnya, Aku akan melakukan pula hal-hal yang ajaib kepada bangsa ini, keajaiban yang menakjubkan; hikmat orang-orangnya yang berhikmat akan hilang, dan kearifan orang-orangnya yang arif akan bersembunyi.\""
 },
 {
   "id": 18213,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 15,
   "firman": "Celakalah orang yang menyembunyikan dalam-dalam rancangannya terhadap TUHAN, yang pekerjaan-pekerjaannya terjadi dalam gelap sambil berkata: \"Siapakah yang melihat kita dan siapakah yang mengenal kita?\""
 },
 {
   "id": 18214,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 16,
   "firman": "Betapa kamu memutarbalikkan segala sesuatu! Apakah tanah liat dapat dianggap sama seperti tukang periuk, sehingga apa yang dibuat dapat berkata tentang yang membuatnya: \"Bukan dia yang membuat aku\"; dan apa yang dibentuk berkata tentang yang membentuknya: \"Ia tidak tahu apa-apa\"?"
 },
 {
   "id": 18215,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 17,
   "firman": "Bukankah hanya sedikit waktu lagi, Libanon akan berubah menjadi kebun buah-buahan, dan kebun buah-buahan itu akan dianggap hutan?"
 },
 {
   "id": 18216,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 18,
   "firman": "Pada waktu itu orang-orang tuli akan mendengar perkataan-perkataan sebuah kitab, dan lepas dari kekelaman dan kegelapan mata orang-orang buta akan melihat."
 },
 {
   "id": 18217,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 19,
   "firman": "Orang-orang yang sengsara akan tambah bersukaria di dalam TUHAN, dan orang-orang miskin di antara manusia akan bersorak-sorak di dalam Yang Mahakudus, Allah Israel!"
 },
 {
   "id": 18218,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 20,
   "firman": "Sebab orang yang gagah sombong akan berakhir dan orang pencemooh akan habis, dan semua orang yang berniat jahat akan dilenyapkan,"
 },
 {
   "id": 18219,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 21,
   "firman": "yaitu mereka yang begitu saja menyatakan seseorang berdosa di dalam suatu perkara, dan yang memasang jerat terhadap orang yang menegor mereka di pintu gerbang, dan yang mendesak orang benar dengan alasan yang tidak-tidak."
 },
 {
   "id": 18220,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 22,
   "firman": "Sebab itu beginilah firman TUHAN, Allah kaum keturunan Yakub, Dia yang telah membebaskan Abraham: \"Mulai sekarang Yakub tidak lagi mendapat malu, dan mukanya tidak lagi pucat."
 },
 {
   "id": 18221,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 23,
   "firman": "Sebab pada waktu mereka, keturunan Yakub itu, melihat apa yang dibuat tangan-Ku di tengah-tengahnya, mereka akan menguduskan nama-Ku; mereka akan menguduskan Yang Kudus, Allah Yakub, dan mereka akan gentar kepada Allah Israel;"
 },
 {
   "id": 18222,
   "kitab": "Yes",
   "pasal": 29,
   "ayat": 24,
   "firman": "orang-orang yang sesat pikiran akan mendapat pengertian, dan orang-orang yang bersungut-sungut akan menerima pengajaran.\""
 },
 {
   "id": 18223,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 1,
   "firman": "Celakalah anak-anak pemberontak, demikianlah firman TUHAN, yang melaksanakan suatu rancangan yang bukan dari pada-Ku, yang memasuki suatu persekutuan, yang bukan oleh dorongan Roh-Ku, sehingga dosa mereka bertambah-tambah,"
 },
 {
   "id": 18224,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 2,
   "firman": "yang berangkat ke Mesir dengan tidak meminta keputusan-Ku, untuk berlindung pada Firaun dan untuk berteduh di bawah naungan Mesir."
 },
 {
   "id": 18225,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 3,
   "firman": "Tetapi perlindungan Firaun akan memalukan kamu, dan perteduhan di bawah naungan Mesir akan menodai kamu."
 },
 {
   "id": 18226,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 4,
   "firman": "Sebab sekalipun pembesar-pembesar Yerusalem sudah ada di Zoan, dan utusan-utusannya sudah sampai ke Hanes,"
 },
 {
   "id": 18227,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 5,
   "firman": "sekaliannya akan mendapat malu karena bangsa itu tidak dapat memberi faedah kepada mereka, dan tidak dapat memberi pertolongan atau faedah; melainkan hanya memalukan, bahkan mengaibkan mereka."
 },
 {
   "id": 18228,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 6,
   "firman": "Ucapan ilahi tentang binatang-binatang di Tanah Negeb. Melalui suatu negeri yang penuh kesesakan dan kesempitan, tempat singa betina dan singa jantan yang mengaum, tempat ular beludak dan ular naga terbang, mereka mengangkut harta kekayaan mereka di atas punggung keledai, dan barang-barang perbendaharaan mereka di atas ponok unta, kepada suatu bangsa yang tidak dapat memberi faedah,"
 },
 {
   "id": 18229,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 7,
   "firman": "yakni Mesir yang memberi pertolongan yang tak berguna dan percuma; sebab itu Aku menamainya begini: \"Rahab yang dibuat menganggur.\""
 },
 {
   "id": 18230,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 8,
   "firman": "Maka sekarang, pergilah, tulislah itu di depan mata mereka di suatu loh, dan cantumkanlah di suatu kitab, supaya itu menjadi kesaksian untuk waktu yang kemudian, sampai selama-lamanya."
 },
 {
   "id": 18231,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 9,
   "firman": "Sebab mereka itu suatu bangsa pemberontak, anak-anak yang suka bohong anak-anak yang enggan mendengar akan pengajaran TUHAN;"
 },
 {
   "id": 18232,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 10,
   "firman": "yang mengatakan kepada para tukang tilik: \"Jangan menilik,\" dan kepada para pelihat: \"Janganlah lihat bagi kami hal-hal yang benar, tetapi katakanlah kepada kami hal-hal yang manis, lihatlah bagi kami hal-hal yang semu,"
 },
 {
   "id": 18233,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 11,
   "firman": "menyisihlah dari jalan dan ambillah jalan lain, janganlah susahi kami dengan Yang Mahakudus, Allah Israel.\""
 },
 {
   "id": 18234,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 12,
   "firman": "Sebab itu beginilah firman Yang Mahakudus, Allah Israel: \"Oleh karena kamu menolak firman ini, dan mempercayakan diri kepada orang-orang pemeras dan yang berlaku serong dan bersandar kepadanya,"
 },
 {
   "id": 18235,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 13,
   "firman": "maka sebab itu bagimu dosa ini akan seperti pecahan tembok yang mau jatuh, tersembul ke luar pada tembok yang tinggi, yang kehancurannya datang dengan tiba-tiba, dalam sekejap mata,"
 },
 {
   "id": 18236,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 14,
   "firman": "seperti kehancuran tempayan tukang periuk yang diremukkan dengan tidak kenal sayang, sehingga di antara remukannya tiada terdapat satu kepingpun yang dapat dipakai untuk mengambil api dari dalam tungku atau mencedok air dari dalam bak.\""
 },
 {
   "id": 18237,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 15,
   "firman": "Sebab beginilah firman Tuhan ALLAH, Yang Mahakudus, Allah Israel: \"Dengan bertobat dan tinggal diam kamu akan diselamatkan, dalam tinggal tenang dan percaya terletak kekuatanmu.\" Tetapi kamu enggan,"
 },
 {
   "id": 18238,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 16,
   "firman": "kamu berkata: \"Bukan, kami mau naik kuda dan lari cepat,\" maka kamu akan lari dan lenyap. Katamu pula: \"Kami mau mengendarai kuda tangkas,\" maka para pengejarmu akan lebih tangkas lagi."
 },
 {
   "id": 18239,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 17,
   "firman": "Seribu orang akan lari melihat ancaman satu orang, terhadap ancaman lima orang kamu akan lari, sampai kamu ditinggalkan seperti tonggak isyarat di atas puncak gunung dan seperti panji-panji di atas bukit."
 },
 {
   "id": 18240,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 18,
   "firman": "Sebab itu TUHAN menanti-nantikan saatnya hendak menunjukkan kasih-Nya kepada kamu; sebab itu Ia bangkit hendak menyayangi kamu. Sebab TUHAN adalah Allah yang adil; berbahagialah semua orang yang menanti-nantikan Dia!"
 },
 {
   "id": 18241,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 19,
   "firman": "Sungguh, hai bangsa di Sion yang diam di Yerusalem, engkau tidak akan terus menangis. Tentulah Tuhan akan mengasihani engkau, apabila engkau berseru-seru; pada saat Ia mendengar teriakmu, Ia akan menjawab."
 },
 {
   "id": 18242,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 20,
   "firman": "Dan walaupun Tuhan memberi kamu roti dan air serba sedikit, namun Pengajarmu tidak akan menyembunyikan diri lagi, tetapi matamu akan terus melihat Dia,"
 },
 {
   "id": 18243,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 21,
   "firman": "dan telingamu akan mendengar perkataan ini dari belakangmu: \"Inilah jalan, berjalanlah mengikutinya,\" entah kamu menganan atau mengiri."
 },
 {
   "id": 18244,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 22,
   "firman": "Engkau akan menganggap najis patung-patungmu yang disalut dengan perak atau yang dilapis dengan emas; engkau akan membuangnya seperti kain cemar sambil berkata kepadanya: \"Keluar!\""
 },
 {
   "id": 18245,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 23,
   "firman": "Lalu TUHAN akan memberi hujan bagi benih yang baru kamu taburkan di ladangmu, dan dari hasil tanah itu kamu akan makan roti yang lezat dan berlimpah-limpah. Pada waktu itu ternakmu akan makan rumput di padang rumput yang luas;"
 },
 {
   "id": 18246,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 24,
   "firman": "sapi-sapi dan keledai-keledai yang mengerjakan tanah akan memakan makanan campuran yang sedap, yang sudah ditampi dan diayak."
 },
 {
   "id": 18247,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 25,
   "firman": "Dari setiap gunung yang tinggi dan dari setiap bukit yang menjulang akan memancar sungai-sungai pada hari pembunuhan yang besar, apabila menara-menara runtuh."
 },
 {
   "id": 18248,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 26,
   "firman": "Maka terang bulan purnama akan seperti terang matahari terik dan terang matahari terik akan tujuh kali ganda, yaitu seperti terangnya tujuh hari, pada waktu TUHAN membalut luka umat-Nya dan menyembuhkan bekas pukulan."
 },
 {
   "id": 18249,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 27,
   "firman": "TUHAN datang menyatakan diri-Nya dari tempat-Nya yang jauh--murka-Nya menyala-nyala, Ia datang dalam awan gelap yang bergumpal-gumpal, bibir-Nya penuh dengan amarah, dan lidah-Nya seperti api yang memakan habis;"
 },
 {
   "id": 18250,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 28,
   "firman": "hembusan nafas-Nya seperti sungai yang menghanyutkan, yang airnya sampai ke leher--Ia datang untuk mengayak bangsa-bangsa dengan ayak kebinasaan dan untuk memasang suatu kekang yang menyesatkan di mulut suku-suku bangsa."
 },
 {
   "id": 18251,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 29,
   "firman": "Kamu akan menyanyikan suatu nyanyian seperti pada waktu malam ketika orang menguduskan diri untuk perayaan, dan kamu akan bersuka hati seperti pada waktu orang berjalan diiringi suling hendak naik ke gunung TUHAN, ke Gunung Batu Israel."
 },
 {
   "id": 18252,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 30,
   "firman": "Dan TUHAN akan memperdengarkan suara-Nya yang mulia, akan memperlihatkan tangan-Nya yang turun menimpa dengan murka yang hebat dan nyala api yang memakan habis, dengan hujan lebat, angin ribut dan hujan batu."
 },
 {
   "id": 18253,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 31,
   "firman": "Sebab Asyur akan terkejut oleh suara TUHAN, pada waktu Ia memukul mereka dengan gada."
 },
 {
   "id": 18254,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 32,
   "firman": "Sebab setiap pukulan dengan tongkat penghajar yang ditimpakan TUHAN ke atasnya, akan diiringi rebana dan kecapi, dan Ia akan berperang melawan Asyur dengan tangan yang diayunkan untuk peperangan."
 },
 {
   "id": 18255,
   "kitab": "Yes",
   "pasal": 30,
   "ayat": 33,
   "firman": "Sebab dari dahulu sudah diatur tempat pembakaran--bukankah itu untuk raja--dasarnya dibuat dalam dan lapang, pancakanya penuh api dan kayu; nafas TUHAN menghanguskannya seperti sungai belerang."
 },
 {
   "id": 18256,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 1,
   "firman": "Celakalah orang-orang yang pergi ke Mesir minta pertolongan, yang mengandalkan kuda-kuda, yang percaya kepada keretanya yang begitu banyak, dan kepada pasukan berkuda yang begitu besar jumlahnya, tetapi tidak memandang kepada Yang Mahakudus, Allah Israel, dan tidak mencari TUHAN."
 },
 {
   "id": 18257,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 2,
   "firman": "Akan tetapi Dia yang bijaksana akan mendatangkan malapetaka, dan tidak menarik firman-Nya; Ia akan bangkit melawan kaum penjahat, dan melawan bala bantuan orang-orang lalim."
 },
 {
   "id": 18258,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 3,
   "firman": "Sebab orang Mesir adalah manusia, bukan allah, dan kuda-kuda mereka adalah makhluk yang lemah, bukan roh yang berkuasa. Apabila TUHAN mengacungkan tangan-Nya, tergelincirlah yang membantu dan jatuhlah yang dibantu, dan mereka sekaliannya habis binasa bersama-sama."
 },
 {
   "id": 18259,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN kepadaku: Seperti seekor singa atau singa muda menggeram untuk mempertahankan mangsanya, dan tidak terkejut mendengar teriakan seluruh pasukan gembala yang dikerahkan melawan dia, dan tidak mengalah terhadap keributan mereka, demikianlah TUHAN semesta alam akan turun berperang untuk mempertahankan gunung Sion dan bukitnya."
 },
 {
   "id": 18260,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 5,
   "firman": "Seperti burung yang berkepak-kepak melindungi sarangnya, demikianlah TUHAN semesta alam akan melindungi Yerusalem, ya, melindungi dan menyelamatkannya, memeliharanya dan menjauhkan celaka."
 },
 {
   "id": 18261,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 6,
   "firman": "Bertobatlah, hai orang Israel, kepada Dia yang sudah kamu tinggalkan jauh-jauh!"
 },
 {
   "id": 18262,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 7,
   "firman": "Sungguh pada hari itu kamu masing-masing akan membuang berhala-berhala peraknya dan berhala-berhala emasnya yang dibuat oleh tanganmu sendiri dengan penuh dosa."
 },
 {
   "id": 18263,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 8,
   "firman": "Asyur akan rebah oleh pedang, tetapi bukan pedang orang, dan akan dimakan habis oleh pedang, tetapi bukan pedang manusia; mereka akan melarikan diri terhadap pedang, dan teruna-terunanya akan menjadi orang rodi."
 },
 {
   "id": 18264,
   "kitab": "Yes",
   "pasal": 31,
   "ayat": 9,
   "firman": "Pelindung mereka akan lenyap karena gentar, dan panglimanya akan lari terkejut meninggalkan panji-panji, demikianlah firman TUHAN yang mempunyai api di Sion dan dapur perapian di Yerusalem."
 },
 {
   "id": 18265,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 1,
   "firman": "Sesungguhnya, seorang raja akan memerintah menurut kebenaran, dan pemimpin-pemimpin akan memimpin menurut keadilan,"
 },
 {
   "id": 18266,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 2,
   "firman": "dan mereka masing-masing akan seperti tempat perteduhan terhadap angin dan tempat perlindungan terhadap angin ribut, seperti aliran-aliran air di tempat kering, seperti naungan batu yang besar, di tanah yang tandus."
 },
 {
   "id": 18267,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 3,
   "firman": "Mata orang-orang yang melihat tidak lagi akan tertutup, dan telinga orang-orang yang mendengar akan memperhatikan."
 },
 {
   "id": 18268,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 4,
   "firman": "Hati orang-orang yang terburu nafsu akan tahu menimbang-nimbang, dan lidah orang-orang yang gagap akan dapat berbicara jelas."
 },
 {
   "id": 18269,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 5,
   "firman": "Orang bebal tidak akan disebutkan lagi orang yang berbudi luhur, dan orang penipu tidak akan dikatakan terhormat."
 },
 {
   "id": 18270,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 6,
   "firman": "Sebab orang bebal mengatakan kebebalan, dan hatinya merencanakan yang jahat, yaitu bermaksud murtad dan mengatakan yang menyesatkan tentang TUHAN, membiarkan kosong perut orang lapar dan orang haus kekurangan minuman."
 },
 {
   "id": 18271,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 7,
   "firman": "Kalau penipu, akal-akalnya adalah jahat, ia merancang perbuatan-perbuatan keji untuk mencelakakan orang sengsara dengan perkataan dusta, sekalipun orang miskin itu membela haknya."
 },
 {
   "id": 18272,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 8,
   "firman": "Tetapi orang yang berbudi luhur merancang hal-hal yang luhur, dan ia selalu bertindak demikian."
 },
 {
   "id": 18273,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 9,
   "firman": "Hai perempuan-perempuan yang hidup aman, bangunlah, dengarkanlah suaraku, hai anak-anak perempuan yang hidup tenteram, perhatikanlah perkataanku!"
 },
 {
   "id": 18274,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 10,
   "firman": "Dalam waktu setahun lebih kamu akan gemetar, hai orang-orang yang hidup tenteram, sebab panen buah anggur sudah habis binasa, dan panen buah-buah lain juga tidak ada."
 },
 {
   "id": 18275,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 11,
   "firman": "Gentarlah, hai perempuan-perempuan yang hidup aman, gemetarlah, hai perempuan-perempuan yang hidup tenteram, tanggalkanlah dan bukalah pakaianmu, kenakanlah kain kabung pada pinggangmu!"
 },
 {
   "id": 18276,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 12,
   "firman": "Ratapilah ladangmu yang permai, dan pohon anggurmu yang selalu berbuah lebat,"
 },
 {
   "id": 18277,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 13,
   "firman": "ratapilah tanah bangsaku yang ditumbuhi semak duri dan puteri malu, bahkan juga segala rumahmu tempat bergirang-girang di kota yang penuh keriaan."
 },
 {
   "id": 18278,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 14,
   "firman": "Sebab purimu sudah ditinggalkan dan keramaian kotamu sudah berubah menjadi kesepian. Bukit dan Menara sudah menjadi tanah rata untuk selama-lamanya, menjadi tempat kegirangan bagi keledai hutan dan tempat makan rumput bagi kawanan binatang."
 },
 {
   "id": 18279,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 15,
   "firman": "Sampai dicurahkan kepada kita Roh dari atas: Maka padang gurun akan menjadi kebun buah-buahan, dan kebun buah-buahan itu akan dianggap hutan."
 },
 {
   "id": 18280,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 16,
   "firman": "Di padang gurun selalu akan berlaku keadilan dan di kebun buah-buahan akan tetap ada kebenaran."
 },
 {
   "id": 18281,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 17,
   "firman": "Di mana ada kebenaran di situ akan tumbuh damai sejahtera, dan akibat kebenaran ialah ketenangan dan ketenteraman untuk selama-lamanya."
 },
 {
   "id": 18282,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 18,
   "firman": "Bangsaku akan diam di tempat yang damai, di tempat tinggal yang tenteram di tempat peristirahatan yang aman."
 },
 {
   "id": 18283,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 19,
   "firman": "Hutan akan runtuh seluruhnya dan kota akan direndahkan serendah-rendahnya"
 },
 {
   "id": 18284,
   "kitab": "Yes",
   "pasal": 32,
   "ayat": 20,
   "firman": "Berbahagialah kamu yang boleh menabur di segala tempat di mana terdapat air, yang dapat membiarkan sapi dan keledainya pergi ke mana-mana!"
 },
 {
   "id": 18285,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 1,
   "firman": "Celakalah engkau, hai perusak yang tidak dirusak sendiri, dan engkau, hai penggarong yang tidak digarong sendiri! Apabila engkau selesai merusak, engkau sendiri akan dirusak; apabila engkau habis menggarong, engkau sendiri akan digarong."
 },
 {
   "id": 18286,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 2,
   "firman": "TUHAN, kasihanilah kami, Engkau kami nanti-nantikan! Lindungilah kami setiap pagi dengan tangan-Mu, ya, selamatkanlah kami di waktu kesesakan!"
 },
 {
   "id": 18287,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 3,
   "firman": "Waktu mendengar suara gemuruh ketika Engkau bangkit, larilah bangsa-bangsa dan berceraiberailah suku-suku bangsa."
 },
 {
   "id": 18288,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 4,
   "firman": "Orang mengumpulkan jarahan seperti belalang pelahap menelan makanannya; mereka menyerbunya seperti serbuan kawanan belalang."
 },
 {
   "id": 18289,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 5,
   "firman": "TUHAN tinggi luhur, sebab Ia tinggal di tempat tinggi; Ia membuat Sion penuh keadilan dan kebenaran."
 },
 {
   "id": 18290,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 6,
   "firman": "Masa keamanan akan tiba bagimu; kekayaan yang menyelamatkan ialah hikmat dan pengetahuan; takut akan TUHAN, itulah harta benda Sion."
 },
 {
   "id": 18291,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 7,
   "firman": "Lihat, orang-orang Ariel menjerit di jalan, utusan-utusan yang mencari damai menangis dengan pedih."
 },
 {
   "id": 18292,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 8,
   "firman": "Jalan-jalan raya menjadi sunyi dan seorangpun tiada lagi yang lintas di jalan. Perjanjian sudah diingkari, saksi-saksi sudah ditolak, dan manusia tidak dihiraukan."
 },
 {
   "id": 18293,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 9,
   "firman": "Negeri berkabung dan merana; Libanon tersipu-sipu dan mati rebah; Saron sudah seperti padang belantara, Basan dan Karmel meluruh daun."
 },
 {
   "id": 18294,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 10,
   "firman": "Sekarang, Aku akan bangkit, firman TUHAN, sekarang, Aku akan bangkit berdiri, sekarang, Aku akan berdiri tegak!"
 },
 {
   "id": 18295,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 11,
   "firman": "Kamu mengandung rumput kering, dan melahirkan jerami; amarahmu seperti api yang memakan kamu sendiri."
 },
 {
   "id": 18296,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 12,
   "firman": "Bangsa-bangsa akan dibakar menjadi kapur dan akan dibakar dalam api seperti semak duri yang ditebang."
 },
 {
   "id": 18297,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 13,
   "firman": "Hai orang-orang yang jauh, dengarlah apa yang telah Kulakukan, hai orang-orang yang dekat, ketahuilah keperkasaan-Ku!"
 },
 {
   "id": 18298,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 14,
   "firman": "Orang-orang yang berdosa terkejut di Sion orang-orang murtad diliputi kegentaran. Mereka berkata: \"Siapakah di antara kita yang dapat tinggal dalam api yang menghabiskan ini? Siapakah di antara kita yang dapat tinggal di perapian yang abadi ini?\""
 },
 {
   "id": 18299,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 15,
   "firman": "Orang yang hidup dalam kebenaran, yang berbicara dengan jujur, yang menolak untung hasil pemerasan, yang mengebaskan tangannya, supaya jangan menerima suap, yang menutup telinganya, supaya jangan mendengarkan rencana penumpahan darah, yang menutup matanya, supaya jangan melihat kejahatan,"
 },
 {
   "id": 18300,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 16,
   "firman": "dialah seperti orang yang tinggal aman di tempat-tempat tinggi, bentengnya ialah kubu di atas bukit batu; rotinya disediakan air minumnya terjamin."
 },
 {
   "id": 18301,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 17,
   "firman": "Engkau akan memandang raja dalam semaraknya, akan melihat negeri yang terbentang jauh."
 },
 {
   "id": 18302,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 18,
   "firman": "Dalam hatimu engkau akan memikirkan kengerian yang sudah-sudah: \"Sudah lenyapkah juru hitung, sudah lenyapkah juru timbang, dan sudah lenyapkah orang yang menghitung menara-menara?\""
 },
 {
   "id": 18303,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 19,
   "firman": "Tidak lagi akan kaulihat bangsa yang biadab itu, bangsa yang logatnya samar, sehingga tidak dapat dipahami, yang bahasanya gagap, sehingga tiada yang mengerti."
 },
 {
   "id": 18304,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 20,
   "firman": "Pandanglah Sion, kota pertemuan raya kita! Matamu akan melihat Yerusalem, tempat kediaman yang aman, kemah yang tidak berpindah-pindah, yang patoknya tidak dicabut untuk seterusnya, dan semua talinya tidak akan putus."
 },
 {
   "id": 18305,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 21,
   "firman": "Di situ kita akan melihat betapa mulia TUHAN kita: seperti tempat yang penuh sungai dan aliran yang lebar; perahu dayung tidak melaluinya, dan kapal besar tidak menyeberanginya."
 },
 {
   "id": 18306,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 22,
   "firman": "Sebab TUHAN ialah Hakim kita, TUHAN ialah yang memberi hukum bagi kita; TUHAN ialah Raja kita, Dia akan menyelamatkan kita."
 },
 {
   "id": 18307,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 23,
   "firman": "Tali-talimu sudah kendor, tidak dapat mengikat teguh tiang layar di tempatnya, tidak dapat membentangkan layar. Pada waktu itu orang akan membagi-bagi rampasan banyak-banyak, dan orang-orang lumpuh akan menjarah jarahan."
 },
 {
   "id": 18308,
   "kitab": "Yes",
   "pasal": 33,
   "ayat": 24,
   "firman": "Tidak seorangpun yang tinggal di situ akan berkata: \"Aku sakit,\" dan semua penduduknya akan diampuni kesalahannya."
 },
 {
   "id": 18309,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 1,
   "firman": "Marilah mendekat, hai bangsa-bangsa, dengarlah, dan perhatikanlah, hai suku-suku bangsa! Baiklah bumi serta segala isinya mendengar, dunia dan segala yang terpancar dari padanya."
 },
 {
   "id": 18310,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 2,
   "firman": "Sebab TUHAN murka atas segala bangsa, dan hati-Nya panas atas segenap tentara mereka. Ia telah mengkhususkan mereka untuk ditumpas dan menyerahkan mereka untuk dibantai."
 },
 {
   "id": 18311,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 3,
   "firman": "Orang-orangnya yang mati terbunuh akan dilemparkan, dan dari bangkai-bangkai mereka akan naik bau busuk; gunung-gunung akan kebanjiran darah mereka."
 },
 {
   "id": 18312,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 4,
   "firman": "Segenap tentara langit akan hancur, dan langit akan digulung seperti gulungan kitab, segala tentara mereka akan gugur seperti daun yang gugur dari pohon anggur, dan seperti gugurnya daun pohon ara."
 },
 {
   "id": 18313,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 5,
   "firman": "Sebab pedang-Ku yang di langit sudah mengamuk, lihat, ia turun menghakimi Edom, bangsa yang Kukhususkan untuk ditumpas."
 },
 {
   "id": 18314,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 6,
   "firman": "TUHAN mempunyai sebilah pedang yang berlumuran darah dan yang penuh lemak, yaitu darah anak-anak domba dan kambing-kambing jantan dan lemak buah pinggang domba-domba jantan. Sebab TUHAN mengadakan penyembelihan korban di Bozra dan pembantaian besar di tanah Edom."
 },
 {
   "id": 18315,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 7,
   "firman": "Banteng-banteng akan rebah mati bersama-sama domba dan kambing itu, dan lembu-lembu jantan yang muda bersama-sama lembu-lembu jantan yang gagah, seluruh negerinya diresapi oleh darah, dan tanah mereka penuh dengan lemak."
 },
 {
   "id": 18316,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 8,
   "firman": "Sebab TUHAN mendatangkan hari pembalasan dan tahun pengganjaran karena perkara Sion."
 },
 {
   "id": 18317,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 9,
   "firman": "Sungai-sungai Edom akan berubah menjadi ter, dan tanahnya menjadi belerang; negerinya akan menjadi ter yang menyala-nyala."
 },
 {
   "id": 18318,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 10,
   "firman": "Siang dan malam negeri itu tidak akan padam-padam, asapnya naik untuk selama-lamanya. Negeri itu akan menjadi reruntuhan turun-temurun, tidak ada orang yang melintasinya untuk seterusnya."
 },
 {
   "id": 18319,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 11,
   "firman": "Burung undan dan landak akan mendudukinya, burung hantu dan burung gagak akan tinggal di dalamnya. TUHAN menjadikannya campur baur dan kosong tepat menurut rencana-Nya."
 },
 {
   "id": 18320,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 12,
   "firman": "Jin-jin akan diam di dalamnya, dan para pemukanya akan tidak ada lagi; tidak ada lagi di sana yang dimaklumkan sebagai raja, dan semua pemimpinnya sudah lenyap."
 },
 {
   "id": 18321,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 13,
   "firman": "Duri-duri akan tumbuh di puri-purinya, rumput dan puteri malu di tempat-tempatnya yang berkubu, sehingga menjadi tempat kediaman serigala, dan lapangan bagi burung unta."
 },
 {
   "id": 18322,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 14,
   "firman": "Di sana berpapasan binatang gurun dengan anjing hutan, dan jin bertemu dengan temannya; hantu malam saja ada di sana dan mendapat tempat perhentian."
 },
 {
   "id": 18323,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 15,
   "firman": "Di sana ular pohon bersarang dan bertelur, mengeram sampai telurnya menetas; burung-burung dendang saja berkumpul di sana, masing-masing dengan pasangannya."
 },
 {
   "id": 18324,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 16,
   "firman": "Carilah di dalam kitab TUHAN dan bacalah: Satupun dari semua makhluk itu tidak ada yang ketinggalan dan yang satu tidak kehilangan yang lain; sebab begitulah perintah yang keluar dari mulut TUHAN, dan Roh TUHAN sendiri telah mengumpulkan mereka."
 },
 {
   "id": 18325,
   "kitab": "Yes",
   "pasal": 34,
   "ayat": 17,
   "firman": "Ia sendiri telah membuang undi dan membagi-bagi negeri itu di antara mereka dengan tali pengukur; mereka akan mendudukinya sampai selama-lamanya dan akan tinggal di situ turun-temurun."
 },
 {
   "id": 18326,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 1,
   "firman": "Padang gurun dan padang kering akan bergirang, padang belantara akan bersorak-sorak dan berbunga;"
 },
 {
   "id": 18327,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 2,
   "firman": "seperti bunga mawar ia akan berbunga lebat, akan bersorak-sorak, ya bersorak-sorak dan bersorak-sorai. Kemuliaan Libanon akan diberikan kepadanya, semarak Karmel dan Saron; mereka itu akan melihat kemuliaan TUHAN, semarak Allah kita."
 },
 {
   "id": 18328,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 3,
   "firman": "Kuatkanlah tangan yang lemah lesu dan teguhkanlah lutut yang goyah."
 },
 {
   "id": 18329,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 4,
   "firman": "Katakanlah kepada orang-orang yang tawar hati: \"Kuatkanlah hati, janganlah takut! Lihatlah, Allahmu akan datang dengan pembalasan dan dengan ganjaran Allah. Ia sendiri datang menyelamatkan kamu!\""
 },
 {
   "id": 18330,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 5,
   "firman": "Pada waktu itu mata orang-orang buta akan dicelikkan, dan telinga orang-orang tuli akan dibuka."
 },
 {
   "id": 18331,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 6,
   "firman": "Pada waktu itu orang lumpuh akan melompat seperti rusa, dan mulut orang bisu akan bersorak-sorai; sebab mata air memancar di padang gurun, dan sungai di padang belantara;"
 },
 {
   "id": 18332,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 7,
   "firman": "tanah pasir yang hangat akan menjadi kolam, dan tanah kersang menjadi sumber-sumber air; di tempat serigala berbaring akan tumbuh tebu dan pandan."
 },
 {
   "id": 18333,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 8,
   "firman": "Di situ akan ada jalan raya, yang akan disebutkan Jalan Kudus; orang yang tidak tahir tidak akan melintasinya, dan orang-orang pandir tidak akan mengembara di atasnya."
 },
 {
   "id": 18334,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 9,
   "firman": "Di situ tidak akan ada singa, binatang buas tidak akan menjalaninya dan tidak akan terdapat di sana; orang-orang yang diselamatkan akan berjalan di situ,"
 },
 {
   "id": 18335,
   "kitab": "Yes",
   "pasal": 35,
   "ayat": 10,
   "firman": "dan orang-orang yang dibebaskan TUHAN akan pulang dan masuk ke Sion dengan bersorak-sorai, sedang sukacita abadi meliputi mereka; kegirangan dan sukacita akan memenuhi mereka, kedukaan dan keluh kesah akan menjauh."
 },
 {
   "id": 18336,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 1,
   "firman": "Maka dalam tahun keempat belas zaman raja Hizkia majulah Sanherib, raja Asyur, menyerang segala kota berkubu negeri Yehuda, lalu merebutnya."
 },
 {
   "id": 18337,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 2,
   "firman": "Raja Asyur mengutus juru minuman agung dari Lakhis ke Yerusalem kepada raja Hizkia disertai suatu tentara yang besar. Ia mengambil tempat dekat saluran kolam atas di jalan raya pada Padang Tukang Penatu."
 },
 {
   "id": 18338,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 3,
   "firman": "Keluarlah mendapatkan dia Elyakim bin Hilkia, kepala istana, dan Sebna, panitera negara, serta Yoab bin Asaf, bendahara negara."
 },
 {
   "id": 18339,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 4,
   "firman": "Lalu berkatalah juru minuman agung kepada mereka: \"Baiklah katakan kepada Hizkia: Beginilah kata raja agung, raja Asyur: Kepercayaan macam apakah yang kaupegang ini?"
 },
 {
   "id": 18340,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 5,
   "firman": "Kaukira bahwa hanya ucapan bibir saja dapat merupakan rencana dan kekuatan untuk perang! Sekarang, kepada siapa engkau berharap, maka engkau memberontak terhadap aku?"
 },
 {
   "id": 18341,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 6,
   "firman": "Sesungguhnya, engkau berharap kepada tongkat bambu yang patah terkulai itu, yaitu Mesir, yang akan menusuk dan menembus tangan orang yang bertopang kepadanya. Begitulah keadaan Firaun, raja Mesir, bagi semua orang yang berharap kepadanya."
 },
 {
   "id": 18342,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 7,
   "firman": "Dan apabila engkau berkata kepadaku: Kami berharap kepada TUHAN, Allah kami, --bukankah Dia itu yang bukit-bukit pengorbanan-Nya dan mezbah-mezbah-Nya telah dijauhkan oleh Hizkia sambil berkata kepada Yehuda dan Yerusalem: Di depan mezbah inilah kamu harus sujud menyembah!"
 },
 {
   "id": 18343,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 8,
   "firman": "Maka sekarang, baiklah bertaruh dengan tuanku, raja Asyur: Aku akan memberikan dua ribu ekor kuda kepadamu, jika engkau sanggup memberikan dari pihakmu orang-orang yang mengendarainya."
 },
 {
   "id": 18344,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 9,
   "firman": "Bagaimanakah mungkin engkau memukul mundur satu orang perwira tuanku yang paling kecil? Padahal engkau berharap kepada Mesir dalam hal kereta dan orang-orang berkuda!"
 },
 {
   "id": 18345,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 10,
   "firman": "Sekarangpun, adakah di luar kehendak TUHAN aku maju melawan negeri ini untuk memusnahkannya? TUHAN telah berfirman kepadaku: Majulah menyerang negeri itu dan musnahkanlah itu!\""
 },
 {
   "id": 18346,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 11,
   "firman": "Lalu berkatalah Elyakim, Sebna dan Yoah kepada juru minuman agung: \"Silakan berbicara dalam bahasa Aram kepada hamba-hambamu ini, sebab kami mengerti; tetapi janganlah berbicara dengan kami dalam bahasa Yehuda sambil didengar oleh rakyat yang ada di atas tembok.\""
 },
 {
   "id": 18347,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 12,
   "firman": "Tetapi juru minuman agung berkata: \"Adakah tuanku mengutus aku untuk mengucapkan perkataan-perkataan ini hanya kepada tuanmu dan kepadamu saja? Bukankah juga kepada orang-orang yang duduk di atas tembok, yang memakan tahinya dan meminum air kencingnya bersama-sama dengan kamu?\""
 },
 {
   "id": 18348,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 13,
   "firman": "Kemudian berdirilah juru minuman agung dan berserulah ia dengan suara nyaring dalam bahasa Yehuda. Ia berkata: \"Dengarlah perkataan raja agung, raja Asyur!"
 },
 {
   "id": 18349,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 14,
   "firman": "Beginilah kata raja: Janganlah Hizkia memperdayakan kamu, sebab ia tidak sanggup melepaskan kamu!"
 },
 {
   "id": 18350,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 15,
   "firman": "Janganlah Hizkia mengajak kamu berharap kepada TUHAN dengan mengatakan: Tentulah TUHAN akan melepaskan kita; kota ini tidak akan diserahkan ke dalam tangan raja Asyur."
 },
 {
   "id": 18351,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 16,
   "firman": "Janganlah dengarkan Hizkia, sebab beginilah kata raja Asyur: Adakanlah perjanjian penyerahan dengan aku dan datanglah ke luar kepadaku, maka setiap orang dari padamu akan makan dari pohon anggurnya dan dari pohon aranya serta minum dari sumurnya,"
 },
 {
   "id": 18352,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 17,
   "firman": "sampai aku datang dan membawa kamu ke suatu negeri seperti negerimu, suatu negeri yang bergandum dan berair anggur, suatu negeri yang beroti dan berkebun anggur."
 },
 {
   "id": 18353,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 18,
   "firman": "Jangan sampai Hizkia membujuk kamu dengan mengatakan: TUHAN akan melepaskan kita! Apakah pernah para allah bangsa-bangsa melepaskan negerinya masing-masing dari tangan raja Asyur?"
 },
 {
   "id": 18354,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 19,
   "firman": "Di manakah para allah negeri Hamat dan Arpad? Di manakah para allah negeri Sefarwaim? Apakah mereka telah melepaskan Samaria dari tanganku?"
 },
 {
   "id": 18355,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 20,
   "firman": "Siapakah di antara semua allah negeri-negeri ini yang telah melepaskan negeri mereka dari tanganku, sehingga TUHAN sanggup melepaskan Yerusalem dari tanganku?\""
 },
 {
   "id": 18356,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 21,
   "firman": "Tetapi orang berdiam diri dan tidak menjawab dia sepatah katapun, sebab ada perintah raja, bunyinya: \"Jangan kamu menjawab dia!\""
 },
 {
   "id": 18357,
   "kitab": "Yes",
   "pasal": 36,
   "ayat": 22,
   "firman": "Kemudian pergilah Elyakim bin Hilkia, kepala istana, dan Sebna, panitera negara, dan Yoah bin Asaf, bendahara negara, menghadap Hizkia, dengan pakaian yang dikoyakkan, lalu memberitahukan kepada raja perkataan juru minuman agung."
 },
 {
   "id": 18358,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 1,
   "firman": "Segera sesudah raja Hizkia mendengar itu, dikoyakkannyalah pakaiannya dan diselubunginyalah badannya dengan kain kabung, lalu masuklah ia ke rumah TUHAN."
 },
 {
   "id": 18359,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 2,
   "firman": "Disuruhnyalah juga Elyakim, kepala istana, Sebna, panitera negara, dan yang tua-tua di antara para imam, dengan berselubungkan kain kabung, kepada nabi Yesaya bin Amos."
 },
 {
   "id": 18360,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 3,
   "firman": "Berkatalah mereka kepadanya: \"Beginilah kata Hizkia: Hari ini hari kesesakan, hari hukuman dan penistaan; sebab sudah datang waktunya untuk melahirkan anak, tetapi tidak ada kekuatan untuk melahirkannya."
 },
 {
   "id": 18361,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 4,
   "firman": "Mungkin TUHAN, Allahmu, sudah mendengar perkataan juru minuman agung yang telah diutus oleh raja Asyur, tuannya, untuk mencela Allah yang hidup, sehingga TUHAN, Allahmu, mau memberi hukuman karena perkataan-perkataan yang telah didengar-Nya. Maka baiklah engkau menaikkan doa untuk sisa yang masih tinggal ini!\""
 },
 {
   "id": 18362,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 5,
   "firman": "Ketika pegawai-pegawai raja Hizkia sampai kepada Yesaya,"
 },
 {
   "id": 18363,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 6,
   "firman": "berkatalah Yesaya kepada mereka: \"Beginilah kamu katakan kepada tuanmu: Beginilah firman TUHAN: Janganlah engkau takut terhadap perkataan yang kaudengar yang telah diucapkan oleh budak-budak raja Asyur untuk menghujat Aku."
 },
 {
   "id": 18364,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 7,
   "firman": "Sesungguhnya, Aku akan menyuruh suatu roh masuk di dalamnya, sehingga ia mendengar suatu kabar dan pulang ke negerinya; Aku akan membuat dia mati rebah oleh pedang di negerinya sendiri.\""
 },
 {
   "id": 18365,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 8,
   "firman": "Ketika juru minuman agung pulang, didapatinyalah raja Asyur berperang melawan Libna; sebab sudah didengarnya bahwa raja telah berangkat dari Lakhis."
 },
 {
   "id": 18366,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 9,
   "firman": "Dalam pada itu raja mendengar tentang Tirhaka, raja Etiopia, berita yang demikian: \"Ia telah keluar berperang melawan engkau,\" dan ketika mendengar itu, disuruhnyalah utusan-utusan kepada Hizkia dengan pesan:"
 },
 {
   "id": 18367,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 10,
   "firman": "\"Beginilah harus kamu katakan kepada Hizkia, raja Yehuda: Janganlah Allahmu yang kaupercayai itu memperdayakan engkau dengan menjanjikan: Yerusalem tidak akan diserahkan ke tangan raja Asyur."
 },
 {
   "id": 18368,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 11,
   "firman": "Sesungguhnya, engkau ini telah mendengar tentang yang dilakukan raja-raja Asyur kepada segala negeri, yakni bahwa mereka telah menumpasnya; masakan engkau ini akan dilepaskan?"
 },
 {
   "id": 18369,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 12,
   "firman": "Sudahkah para allah dari bangsa-bangsa yang telah dimusnahkan oleh nenek moyangku, dapat melepaskan mereka, yakni Gozan, Haran, Rezef dan bani Eden yang di Telasar?"
 },
 {
   "id": 18370,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 13,
   "firman": "Di manakah raja negeri Hamat dan Arpad raja kota Sefarwaim, raja negeri Hena dan Iwa?\""
 },
 {
   "id": 18371,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 14,
   "firman": "Hizkia menerima surat itu dari tangan para utusan, lalu membacanya; kemudian pergilah ia ke rumah TUHAN dan membentangkan surat itu di hadapan TUHAN."
 },
 {
   "id": 18372,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 15,
   "firman": "Hizkia berdoa di hadapan TUHAN, katanya:"
 },
 {
   "id": 18373,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 16,
   "firman": "\"Ya TUHAN semesta alam, Allah Israel, yang bertakhta di atas kerubim! Hanya Engkau sendirilah Allah segala kerajaan di bumi; Engkaulah yang menjadikan langit dan bumi."
 },
 {
   "id": 18374,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 17,
   "firman": "Sendengkanlah telinga-Mu, ya TUHAN, dan dengarlah; bukalah mata-Mu, ya TUHAN, dan lihatlah; dengarlah segala perkataan Sanherib yang telah dikirimnya untuk mencela Allah yang hidup."
 },
 {
   "id": 18375,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 18,
   "firman": "Ya TUHAN, memang raja-raja Asyur telah memusnahkan semua bangsa dan negeri-negeri mereka"
 },
 {
   "id": 18376,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 19,
   "firman": "dan menaruh para allah mereka ke dalam api, sebab mereka bukanlah Allah, hanya buatan tangan manusia, kayu dan batu; sebab itu dapat dibinasakan orang."
 },
 {
   "id": 18377,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 20,
   "firman": "Maka sekarang, ya TUHAN, Allah kami, selamatkanlah kami dari tangannya, supaya segala kerajaan di bumi mengetahui, bahwa hanya Engkau sendirilah TUHAN.\""
 },
 {
   "id": 18378,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 21,
   "firman": "Lalu Yesaya bin Amos menyuruh orang kepada Hizkia mengatakan: \"Beginilah firman TUHAN, Allah Israel: Tentang yang telah kaudoakan kepada-Ku mengenai Sanherib, raja Asyur,"
 },
 {
   "id": 18379,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 22,
   "firman": "inilah firman yang telah diucapkan TUHAN mengenai dia: Anak dara, yaitu puteri Sion, telah menghina engkau, telah mengolok-olokkan engkau; dan puteri Yerusalem telah geleng-geleng kepala di belakangmu."
 },
 {
   "id": 18380,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 23,
   "firman": "Siapakah yang engkau cela dan engkau hujat? terhadap siapakah engkau menyaringkan suaramu, dan memandang dengan sombong-sombong? Terhadap Yang Mahakudus, Allah Israel!"
 },
 {
   "id": 18381,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 24,
   "firman": "Dengan perantaraan hamba-hambamu engkau telah mencela Tuhan, dan engkau telah berkata: Dengan banyaknya keretaku aku naik ke tempat-tempat tinggi di pegunungan, ke tempat yang paling jauh di gunung Libanon; aku telah menebang pohon-pohon arasnya yang tinggi besar, pohon-pohon sanobarnya yang terpilih; aku telah masuk ke tempat tinggi yang paling ujung, ke hutan pohon-pohonannya yang lebat."
 },
 {
   "id": 18382,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 25,
   "firman": "Aku ini telah menggali air dan telah minum air; aku telah mengeringkan dengan telapak kakiku segala sungai di Mesir!"
 },
 {
   "id": 18383,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 26,
   "firman": "Bukankah telah kaudengar, bahwa Aku telah menentukannya dari jauh hari dan telah merancangnya dari zaman purbakala? Sekarang Aku mewujudkannya, bahwa engkau membuat sunyi senyap kota-kota yang berkubu menjadi timbunan batu,"
 },
 {
   "id": 18384,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 27,
   "firman": "sedang penduduknya yang tak berdaya menjadi terkejut dan malu; mereka menjadi seperti tumbuh-tumbuhan di padang dan seperti rumput hijau, seperti rumput di atas sotoh, atau gandum yang layu sebelum ia masak."
 },
 {
   "id": 18385,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 28,
   "firman": "Aku tahu, jika engkau bangun atau duduk, jika keluar atau masuk, atau jika engkau mengamuk terhadap Aku."
 },
 {
   "id": 18386,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 29,
   "firman": "Oleh karena engkau telah mengamuk terhadap Aku, dan kata-kata keangkuhanmu telah naik sampai ke telinga-Ku, maka Aku akan menaruh kelikir-Ku pada hidungmu dan kekang-Ku pada bibirmu, dan Aku akan memulangkan engkau melalui jalan, dari mana engkau datang."
 },
 {
   "id": 18387,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 30,
   "firman": "Dan inilah yang akan menjadi tanda bagimu, hai Hizkia: Dalam tahun ini orang makan apa yang tumbuh sendiri, dan dalam tahun yang kedua, apa yang tumbuh dari tanaman yang pertama, tetapi dalam tahun yang ketiga, menaburlah kamu, menuai, membuat kebun anggur dan memakan buahnya."
 },
 {
   "id": 18388,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 31,
   "firman": "Dan orang-orang yang terluput di antara kaum Yehuda, yaitu orang-orang yang masih tertinggal, akan berakar pula ke bawah dan menghasilkan buah ke atas."
 },
 {
   "id": 18389,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 32,
   "firman": "Sebab dari Yerusalem akan keluar orang-orang yang tertinggal dan dari gunung Sion orang-orang yang terluput; giat cemburu TUHAN semesta alam akan melakukan hal ini."
 },
 {
   "id": 18390,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 33,
   "firman": "Sebab itu beginilah firman TUHAN mengenai raja Asyur: Ia tidak akan masuk ke kota ini dan tidak akan menembakkan panah ke sana; juga ia tidak akan mendatanginya dengan perisai dan tidak akan menimbun tanah menjadi tembok untuk mengepungnya."
 },
 {
   "id": 18391,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 34,
   "firman": "Melalui jalan, dari mana ia datang, ia akan pulang, tetapi ke kota ini ia tidak akan masuk, demikianlah firman TUHAN."
 },
 {
   "id": 18392,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 35,
   "firman": "Dan Aku akan memagari kota ini untuk menyelamatkannya, oleh karena Aku dan oleh karena Daud, hamba-Ku.\""
 },
 {
   "id": 18393,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 36,
   "firman": "Keluarlah Malaikat TUHAN, lalu dibunuh-Nyalah seratus delapan puluh lima ribu orang di dalam perkemahan Asyur. Keesokan harinya pagi-pagi tampaklah, semuanya bangkai orang-orang mati belaka!"
 },
 {
   "id": 18394,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 37,
   "firman": "Sebab itu berangkatlah Sanherib, raja Asyur dan pulang, lalu tinggallah ia di Niniwe."
 },
 {
   "id": 18395,
   "kitab": "Yes",
   "pasal": 37,
   "ayat": 38,
   "firman": "Pada suatu kali ketika ia sujud menyembah di dalam kuil Nisrokh, allahnya, maka Adramelekh dan Sarezer, anak-anaknya, membunuh dia dengan pedang, dan mereka meloloskan diri ke tanah Ararat. Kemudian Esarhadon, anaknya, menjadi raja menggantikan dia."
 },
 {
   "id": 18396,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 1,
   "firman": "Pada hari-hari itu Hizkia jatuh sakit dan hampir mati. Lalu datanglah nabi Yesaya bin Amos dan berkata kepadanya: \"Beginilah firman TUHAN: Sampaikanlah pesan terakhir kepada keluargamu, sebab engkau akan mati, tidak akan sembuh lagi.\""
 },
 {
   "id": 18397,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 2,
   "firman": "Lalu Hizkia memalingkan mukanya ke arah dinding dan ia berdoa kepada TUHAN."
 },
 {
   "id": 18398,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 3,
   "firman": "Ia berkata: \"Ah TUHAN, ingatlah kiranya, bahwa aku telah hidup di hadapan-Mu dengan setia dan dengan tulus hati dan bahwa aku telah melakukan apa yang baik di mata-Mu.\" Kemudian menangislah Hizkia dengan sangat."
 },
 {
   "id": 18399,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 4,
   "firman": "Maka berfirmanlah TUHAN kepada Yesaya:"
 },
 {
   "id": 18400,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 5,
   "firman": "\"Pergilah dan katakanlah kepada Hizkia: Beginilah firman TUHAN, Allah Daud, bapa leluhurmu: Telah Kudengar doamu dan telah Kulihat air matamu. Sesungguhnya Aku akan memperpanjang hidupmu lima belas tahun lagi,"
 },
 {
   "id": 18401,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 6,
   "firman": "dan Aku akan melepaskan engkau dan kota ini dari tangan raja Asyur dan Aku akan memagari kota ini."
 },
 {
   "id": 18402,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 7,
   "firman": "Inilah yang akan menjadi tanda bagimu dari TUHAN, bahwa TUHAN akan melakukan apa yang telah dijanjikan-Nya:"
 },
 {
   "id": 18403,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 8,
   "firman": "Sesungguhnya, bayang-bayang pada penunjuk matahari buatan Ahas akan Kubuat mundur ke belakang sepuluh tapak yang telah dijalaninya.\" Maka pada penunjuk matahari itu mataharipun mundurlah ke belakang sepuluh tapak dari jarak yang telah dijalaninya."
 },
 {
   "id": 18404,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 9,
   "firman": "Karangan Hizkia, raja Yehuda, sesudah ia sakit dan sembuh dari penyakitnya:"
 },
 {
   "id": 18405,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 10,
   "firman": "Aku ini berkata: Dalam pertengahan umurku aku harus pergi, ke pintu gerbang dunia orang mati aku dipanggil untuk selebihnya dari hidupku."
 },
 {
   "id": 18406,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 11,
   "firman": "Aku berkata: aku tidak akan melihat TUHAN lagi di negeri orang-orang yang hidup; aku tidak akan melihat seorangpun lagi di antara penduduk dunia."
 },
 {
   "id": 18407,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 12,
   "firman": "Pondok kediamanku dibongkar dan dibuka seperti kemah gembala; seperti tukang tenun menggulung tenunannya aku mengakhiri hidupku; TUHAN memutus nyawaku dari benang hidup. Dari siang sampai malam Engkau membiarkan aku begitu saja,"
 },
 {
   "id": 18408,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 13,
   "firman": "aku berteriak minta tolong sampai pagi; seperti singa demikianlah TUHAN menghancurkan segala tulang-tulangku; dari siang sampai malam Engkau membiarkan aku begitu saja."
 },
 {
   "id": 18409,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 14,
   "firman": "Seperti burung layang-layang demikianlah aku menciap-ciap, suaraku redup seperti suara merpati. Mataku habis menengadah ke atas, ya Tuhan, pemerasan terjadi kepadaku; jadilah jaminan bagiku!"
 },
 {
   "id": 18410,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 15,
   "firman": "Apakah yang akan kukatakan dan kuucapkan kepada TUHAN; bukankah Dia yang telah melakukannya? Aku sama sekali tidak dapat tidur karena pahit pedihnya perasaanku."
 },
 {
   "id": 18411,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 16,
   "firman": "Ya Tuhan, karena inilah hatiku mengharapkan Engkau; tenangkanlah rohku, buatlah aku sehat, buatlah aku sembuh!"
 },
 {
   "id": 18412,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 17,
   "firman": "Sesungguhnya, penderitaan yang pahit menjadi keselamatan bagiku; Engkaulah yang mencegah jiwaku dari lobang kebinasaan. Sebab Engkau telah melemparkan segala dosaku jauh dari hadapan-Mu."
 },
 {
   "id": 18413,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 18,
   "firman": "Sebab dunia orang mati tidak dapat mengucap syukur kepada-Mu, dan maut tidak dapat memuji-muji Engkau; orang-orang yang turun ke liang kubur tidak menanti-nanti akan kesetiaan-Mu."
 },
 {
   "id": 18414,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 19,
   "firman": "Tetapi hanyalah orang yang hidup, dialah yang mengucap syukur kepada-Mu, seperti aku pada hari ini; seorang bapa memberitahukan kesetiaan-Mu kepada anak-anaknya."
 },
 {
   "id": 18415,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 20,
   "firman": "TUHAN telah datang menyelamatkan aku! Kami hendak main kecapi, seumur hidup kami di rumah TUHAN."
 },
 {
   "id": 18416,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 21,
   "firman": "Kemudian berkatalah Yesaya: \"Baiklah diambil sebuah kue ara dan ditaruh pada barah itu, supaya sembuh!\""
 },
 {
   "id": 18417,
   "kitab": "Yes",
   "pasal": 38,
   "ayat": 22,
   "firman": "Sebelum itu Hizkia telah berkata: \"Apakah yang akan menjadi tanda, bahwa aku akan pergi ke rumah TUHAN?\""
 },
 {
   "id": 18418,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 1,
   "firman": "Pada waktu itu Merodakh-Baladan bin Baladan, raja Babel, menyuruh orang membawa surat dan pemberian kepada Hizkia, sebab telah didengarnya bahwa Hizkia sakit tadinya dan sudah kuat kembali."
 },
 {
   "id": 18419,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 2,
   "firman": "Hizkia bersukacita atas kedatangan mereka, lalu diperlihatkannyalah kepada mereka gedung harta bendanya, emas dan perak, rempah-rempah dan minyak yang berharga, segenap gedung persenjataannya dan segala yang terdapat dalam perbendaharaannya. Tidak ada barang yang tidak diperlihatkan Hizkia kepada mereka di istananya dan di seluruh daerah kekuasaannya."
 },
 {
   "id": 18420,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 3,
   "firman": "Kemudian datanglah nabi Yesaya kepada raja Hizkia dan bertanya kepadanya: \"Apakah yang telah dikatakan orang-orang ini? Dan dari manakah mereka datang?\" Jawab Hizkia: \"Mereka datang dari negeri yang jauh, dari Babel!\""
 },
 {
   "id": 18421,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 4,
   "firman": "Lalu tanyanya lagi: \"Apakah yang telah dilihat mereka di istanamu?\" Jawab Hizkia: \"Semua yang ada di istanaku telah mereka lihat. Tidak ada barang yang tidak kuperlihatkan kepada mereka di perbendaharaanku.\""
 },
 {
   "id": 18422,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 5,
   "firman": "Lalu Yesaya berkata kepada Hizkia: \"Dengarkanlah firman TUHAN semesta alam!"
 },
 {
   "id": 18423,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 6,
   "firman": "Sesungguhnya, suatu masa akan datang, bahwa segala yang ada dalam istanamu dan yang disimpan oleh nenek moyangmu sampai hari ini akan diangkut ke Babel. Tidak ada barang yang akan ditinggalkan, demikianlah firman TUHAN."
 },
 {
   "id": 18424,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 7,
   "firman": "Dan dari keturunanmu yang akan kauperoleh, akan diambil orang untuk menjadi sida-sida di istana raja Babel.\""
 },
 {
   "id": 18425,
   "kitab": "Yes",
   "pasal": 39,
   "ayat": 8,
   "firman": "Hizkia menjawab kepada Yesaya: \"Sungguh baik firman TUHAN yang engkau ucapkan itu!\" Tetapi pikirnya: \"Asal ada damai dan keamanan seumur hidupku!\""
 },
 {
   "id": 18426,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 1,
   "firman": "Hiburkanlah, hiburkanlah umat-Ku, demikian firman Allahmu,"
 },
 {
   "id": 18427,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 2,
   "firman": "tenangkanlah hati Yerusalem dan serukanlah kepadanya, bahwa perhambaannya sudah berakhir, bahwa kesalahannya telah diampuni, sebab ia telah menerima hukuman dari tangan TUHAN dua kali lipat karena segala dosanya."
 },
 {
   "id": 18428,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 3,
   "firman": "Ada suara yang berseru-seru: \"Persiapkanlah di padang gurun jalan untuk TUHAN, luruskanlah di padang belantara jalan raya bagi Allah kita!"
 },
 {
   "id": 18429,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 4,
   "firman": "Setiap lembah harus ditutup, dan setiap gunung dan bukit diratakan; tanah yang berbukit-bukit harus menjadi tanah yang rata, dan tanah yang berlekuk-lekuk menjadi dataran;"
 },
 {
   "id": 18430,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 5,
   "firman": "maka kemuliaan TUHAN akan dinyatakan dan seluruh umat manusia akan melihatnya bersama-sama; sungguh, TUHAN sendiri telah mengatakannya.\""
 },
 {
   "id": 18431,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 6,
   "firman": "Ada suara yang berkata: \"Berserulah!\" Jawabku: \"Apakah yang harus kuserukan?\" \"Seluruh umat manusia adalah seperti rumput dan semua semaraknya seperti bunga di padang."
 },
 {
   "id": 18432,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 7,
   "firman": "Rumput menjadi kering, bunga menjadi layu, apabila TUHAN menghembusnya dengan nafas-Nya. Sesungguhnyalah bangsa itu seperti rumput."
 },
 {
   "id": 18433,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 8,
   "firman": "Rumput menjadi kering, bunga menjadi layu, tetapi firman Allah kita tetap untuk selama-lamanya.\""
 },
 {
   "id": 18434,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 9,
   "firman": "Hai Sion, pembawa kabar baik, naiklah ke atas gunung yang tinggi! Hai Yerusalem, pembawa kabar baik, nyaringkanlah suaramu kuat-kuat, nyaringkanlah suaramu, jangan takut! Katakanlah kepada kota-kota Yehuda: \"Lihat, itu Allahmu!\""
 },
 {
   "id": 18435,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 10,
   "firman": "Lihat, itu Tuhan ALLAH, Ia datang dengan kekuatan dan dengan tangan-Nya Ia berkuasa. Lihat, mereka yang menjadi upah jerih payah-Nya ada bersama-sama Dia, dan mereka yang diperoleh-Nya berjalan di hadapan-Nya."
 },
 {
   "id": 18436,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 11,
   "firman": "Seperti seorang gembala Ia menggembalakan kawanan ternak-Nya dan menghimpunkannya dengan tangan-Nya; anak-anak domba dipangku-Nya, induk-induk domba dituntun-Nya dengan hati-hati."
 },
 {
   "id": 18437,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 12,
   "firman": "Siapa yang menakar air laut dengan lekuk tangannya dan mengukur langit dengan jengkal, menyukat debu tanah dengan takaran, menimbang gunung-gunung dengan dacing, atau bukit-bukit dengan neraca?"
 },
 {
   "id": 18438,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 13,
   "firman": "Siapa yang dapat mengatur Roh TUHAN atau memberi petunjuk kepada-Nya sebagai penasihat?"
 },
 {
   "id": 18439,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 14,
   "firman": "Kepada siapa TUHAN meminta nasihat untuk mendapat pengertian, dan siapa yang mengajar TUHAN untuk menjalankan keadilan, atau siapa mengajar Dia pengetahuan dan memberi Dia petunjuk supaya Ia bertindak dengan pengertian?"
 },
 {
   "id": 18440,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 15,
   "firman": "Sesungguhnya, bangsa-bangsa adalah seperti setitik air dalam timba dan dianggap seperti sebutir debu pada neraca. Sesungguhnya, pulau-pulau tidak lebih dari abu halus beratnya."
 },
 {
   "id": 18441,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 16,
   "firman": "Libanon tidak mencukupi bagi kayu api dan margasatwanya tidak mencukupi bagi korban bakaran."
 },
 {
   "id": 18442,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 17,
   "firman": "Segala bangsa seperti tidak ada di hadapan-Nya mereka dianggap-Nya hampa dan sia-sia saja."
 },
 {
   "id": 18443,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 18,
   "firman": "Jadi dengan siapa hendak kamu samakan Allah, dan apa yang dapat kamu anggap serupa dengan Dia?"
 },
 {
   "id": 18444,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 19,
   "firman": "Patungkah? Tukang besi menuangnya, dan pandai emas melapisinya dengan emas, membuat rantai-rantai perak untuknya."
 },
 {
   "id": 18445,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 20,
   "firman": "Orang yang mendirikan arca, memilih kayu yang tidak lekas busuk, mencari tukang yang ahli untuk menegakkan patung yang tidak lekas goyang."
 },
 {
   "id": 18446,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 21,
   "firman": "Tidakkah kamu tahu? Tidakkah kamu dengar? Tidakkah diberitahukan kepadamu dari mulanya? Tidakkah kamu mengerti dari sejak dasar bumi diletakkan?"
 },
 {
   "id": 18447,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 22,
   "firman": "Dia yang bertakhta di atas bulatan bumi yang penduduknya seperti belalang; Dia yang membentangkan langit seperti kain dan memasangnya seperti kemah kediaman!"
 },
 {
   "id": 18448,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 23,
   "firman": "Dia yang membuat pembesar-pembesar menjadi tidak ada dan yang menjadikan hakim-hakim dunia sia-sia saja!"
 },
 {
   "id": 18449,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 24,
   "firman": "Baru saja mereka ditanam, baru saja mereka ditaburkan, baru saja cangkok mereka berakar di dalam tanah, sudah juga Ia meniup kepada mereka, sehingga mereka kering dan diterbangkan oleh badai seperti jerami."
 },
 {
   "id": 18450,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 25,
   "firman": "Dengan siapa hendak kamu samakan Aku, seakan-akan Aku seperti dia? firman Yang Mahakudus."
 },
 {
   "id": 18451,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 26,
   "firman": "Arahkanlah matamu ke langit dan lihatlah: siapa yang menciptakan semua bintang itu dan menyuruh segenap tentara mereka keluar, sambil memanggil nama mereka sekaliannya? Satupun tiada yang tak hadir, oleh sebab Ia maha kuasa dan maha kuat."
 },
 {
   "id": 18452,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 27,
   "firman": "Mengapakah engkau berkata demikian, hai Yakub, dan berkata begini, hai Israel: \"Hidupku tersembunyi dari TUHAN, dan hakku tidak diperhatikan Allahku?\""
 },
 {
   "id": 18453,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 28,
   "firman": "Tidakkah kautahu, dan tidakkah kaudengar? TUHAN ialah Allah kekal yang menciptakan bumi dari ujung ke ujung; Ia tidak menjadi lelah dan tidak menjadi lesu, tidak terduga pengertian-Nya."
 },
 {
   "id": 18454,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 29,
   "firman": "Dia memberi kekuatan kepada yang lelah dan menambah semangat kepada yang tiada berdaya."
 },
 {
   "id": 18455,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 30,
   "firman": "Orang-orang muda menjadi lelah dan lesu dan teruna-teruna jatuh tersandung,"
 },
 {
   "id": 18456,
   "kitab": "Yes",
   "pasal": 40,
   "ayat": 31,
   "firman": "tetapi orang-orang yang menanti-nantikan TUHAN mendapat kekuatan baru: mereka seumpama rajawali yang naik terbang dengan kekuatan sayapnya; mereka berlari dan tidak menjadi lesu, mereka berjalan dan tidak menjadi lelah."
 },
 {
   "id": 18457,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 1,
   "firman": "Dengarkanlah Aku dengan berdiam diri, hai pulau-pulau; hendaklah bangsa-bangsa mendapat kekuatan baru! Biarlah mereka datang mendekat, kemudian berbicara; baiklah kita tampil bersama-sama untuk berperkara!"
 },
 {
   "id": 18458,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 2,
   "firman": "Siapakah yang menggerakkan dia dari timur, menggerakkan dia yang mendapat kemenangan di setiap langkahnya, yang menaklukkan bangsa-bangsa ke depannya dan menurunkan raja-raja? Pedangnya membuat mereka seperti debu dan panahnya membuat mereka seperti jerami yang tertiup."
 },
 {
   "id": 18459,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 3,
   "firman": "Ia mengejar mereka dan dengan selamat ia melalui jalan yang belum pernah diinjak kakinya."
 },
 {
   "id": 18460,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 4,
   "firman": "Siapakah yang melakukan dan mengerjakan semuanya itu? Dia yang dari dahulu memanggil bangkit keturunan-keturunan, Aku, TUHAN, yang terdahulu, dan bagi mereka yang terkemudian Aku tetap Dia juga."
 },
 {
   "id": 18461,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 5,
   "firman": "Pulau-pulau telah melihatnya dan menjadi takut, ujung-ujung bumipun menjadi gemetar; mereka datang dan makin mendekat."
 },
 {
   "id": 18462,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 6,
   "firman": "Yang seorang menolong yang lain dan berkata kepada temannya: \"Kuatkanlah hatimu!\""
 },
 {
   "id": 18463,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 7,
   "firman": "Tukang besi menguatkan hati tukang emas, dan orang yang memipihkan logam dengan martil menguatkan hati orang yang menempa di atas landasan; ia berkata tentang patrian: \"Itu baik,\" lalu menguatkannya dengan paku-paku, sehingga tidak goyang."
 },
 {
   "id": 18464,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 8,
   "firman": "Tetapi engkau, hai Israel, hamba-Ku, hai Yakub, yang telah Kupilih, keturunan Abraham, yang Kukasihi;"
 },
 {
   "id": 18465,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 9,
   "firman": "engkau yang telah Kuambil dari ujung-ujung bumi dan yang telah Kupanggil dari penjuru-penjurunya, Aku berkata kepadamu: \"Engkau hamba-Ku, Aku telah memilih engkau dan tidak menolak engkau\";"
 },
 {
   "id": 18466,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 10,
   "firman": "janganlah takut, sebab Aku menyertai engkau, janganlah bimbang, sebab Aku ini Allahmu; Aku akan meneguhkan, bahkan akan menolong engkau; Aku akan memegang engkau dengan tangan kanan-Ku yang membawa kemenangan."
 },
 {
   "id": 18467,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 11,
   "firman": "Sesungguhnya, semua orang yang bangkit amarahnya terhadap engkau akan mendapat malu dan kena noda; orang-orang yang membantah engkau akan seperti tidak ada dan akan binasa;"
 },
 {
   "id": 18468,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 12,
   "firman": "engkau akan mencari orang-orang yang berkelahi dengan engkau, tetapi tidak akan menemui mereka; orang-orang yang berperang melawan engkau akan seperti tidak ada dan hampa."
 },
 {
   "id": 18469,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 13,
   "firman": "Sebab Aku ini, TUHAN, Allahmu, memegang tangan kananmu dan berkata kepadamu: \"Janganlah takut, Akulah yang menolong engkau.\""
 },
 {
   "id": 18470,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 14,
   "firman": "Janganlah takut, hai si cacing Yakub, hai si ulat Israel! Akulah yang menolong engkau, demikianlah firman TUHAN, dan yang menebus engkau ialah Yang Mahakudus, Allah Israel."
 },
 {
   "id": 18471,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 15,
   "firman": "Sesungguhnya, Aku membuat engkau menjadi papan pengirik yang tajam dan baru, dengan gigi dua jajar; engkau akan mengirik gunung-gunung dan menghancurkannya, dan bukit-bukitpun akan kaubuat seperti sekam."
 },
 {
   "id": 18472,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 16,
   "firman": "Engkau akan menampi mereka, lalu angin akan menerbangkan mereka, dan badai akan menyerakkan mereka. Tetapi engkau ini akan bersorak-sorak di dalam TUHAN dan bermegah di dalam Yang Mahakudus, Allah Israel."
 },
 {
   "id": 18473,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 17,
   "firman": "Orang-orang sengsara dan orang-orang miskin sedang mencari air, tetapi tidak ada, lidah mereka kering kehausan; tetapi Aku, TUHAN, akan menjawab mereka, dan sebagai Allah orang Israel Aku tidak akan meninggalkan mereka."
 },
 {
   "id": 18474,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 18,
   "firman": "Aku akan membuat sungai-sungai memancar di atas bukit-bukit yang gundul, dan membuat mata-mata air membual di tengah dataran; Aku akan membuat padang gurun menjadi telaga dan memancarkan air dari tanah kering."
 },
 {
   "id": 18475,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 19,
   "firman": "Aku akan menanam pohon aras di padang gurun, pohon penaga, pohon murad dan pohon minyak; Aku akan menumbuhkan pohon sanobar di padang belantara dan pohon berangan serta pohon cemara di sampingnya,"
 },
 {
   "id": 18476,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 20,
   "firman": "supaya semua orang melihat dan mengetahui, memperhatikan dan memahami, bahwa tangan TUHAN yang membuat semuanya ini dan Yang Mahakudus, Allah Israel, yang menciptakannya."
 },
 {
   "id": 18477,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 21,
   "firman": "Ajukanlah perkaramu, firman TUHAN, kemukakanlah alasan-alasanmu, firman Raja, Allah Yakub."
 },
 {
   "id": 18478,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 22,
   "firman": "Biarlah mereka maju dan memberitahukan kepada kami apa yang akan terjadi! Nubuat yang dahulu, beritahukanlah apa artinya, supaya kami memperhatikannya, atau hal-hal yang akan datang, kabarkanlah kepada kami, supaya kami mengetahui kesudahannya!"
 },
 {
   "id": 18479,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 23,
   "firman": "Beritahukanlah hal-hal yang akan datang kemudian, supaya kami mengetahui, bahwa kamu ini sungguh allah; bertindak sajalah, biar secara baik ataupun secara buruk, supaya kami bersama-sama tercengang melihatnya!"
 },
 {
   "id": 18480,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 24,
   "firman": "Sesungguhnya, kamu ini adalah seperti tidak ada dan perbuatan-perbuatanmu adalah hampa; orang yang memilih kamu adalah kejijikan."
 },
 {
   "id": 18481,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 25,
   "firman": "Aku telah menggerakkan seorang dari utara dan ia telah datang, dari sebelah matahari terbit Aku telah memanggil dia dengan namanya. Seperti tukang periuk menginjak-injak tanah liat, demikian dia akan menginjak-injak penguasa-penguasa seperti lumpur."
 },
 {
   "id": 18482,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 26,
   "firman": "Siapakah yang memberitahukannya dari mulanya, sehingga kami mengetahuinya, dan dari dahulu, sehingga kami mengatakan: \"Benarlah dia?\" Sungguh, tidak ada orang yang memberitahukannya, tidak ada orang yang mengabarkannya, tidak ada orang yang mendengar sepatah katapun dari padamu."
 },
 {
   "id": 18483,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 27,
   "firman": "Sebagai yang pertama Aku memberitahukannya kepada Sion, dan Aku memberikan orang yang membawa kabar baik kepada Yerusalem."
 },
 {
   "id": 18484,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 28,
   "firman": "Apabila Aku melihat berkeliling, maka tidak ada seorangpun, dan di antara semua mereka ini tidak ada yang dapat memberi petunjuk, atau yang dapat memberi jawab kalau Aku menanyakan mereka."
 },
 {
   "id": 18485,
   "kitab": "Yes",
   "pasal": 41,
   "ayat": 29,
   "firman": "Sesungguhnya, sekaliannya mereka seperti tidak ada, perbuatan-perbuatan mereka hampa, patung-patung tuangan mereka angin dan kesia-siaan."
 },
 {
   "id": 18486,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 1,
   "firman": "Lihat, itu hamba-Ku yang Kupegang, orang pilihan-Ku, yang kepadanya Aku berkenan. Aku telah menaruh Roh-Ku ke atasnya, supaya ia menyatakan hukum kepada bangsa-bangsa."
 },
 {
   "id": 18487,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 2,
   "firman": "Ia tidak akan berteriak atau menyaringkan suara atau memperdengarkan suaranya di jalan."
 },
 {
   "id": 18488,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 3,
   "firman": "Buluh yang patah terkulai tidak akan diputuskannya, dan sumbu yang pudar nyalanya tidak akan dipadamkannya, tetapi dengan setia ia akan menyatakan hukum."
 },
 {
   "id": 18489,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 4,
   "firman": "Ia sendiri tidak akan menjadi pudar dan tidak akan patah terkulai, sampai ia menegakkan hukum di bumi; segala pulau mengharapkan pengajarannya."
 },
 {
   "id": 18490,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 5,
   "firman": "Beginilah firman Allah, TUHAN, yang menciptakan langit dan membentangkannya, yang menghamparkan bumi dengan segala yang tumbuh di atasnya, yang memberikan nafas kepada umat manusia yang mendudukinya dan nyawa kepada mereka yang hidup di atasnya:"
 },
 {
   "id": 18491,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 6,
   "firman": "\"Aku ini, TUHAN, telah memanggil engkau untuk maksud penyelamatan, telah memegang tanganmu; Aku telah membentuk engkau dan memberi engkau menjadi perjanjian bagi umat manusia, menjadi terang untuk bangsa-bangsa,"
 },
 {
   "id": 18492,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 7,
   "firman": "untuk membuka mata yang buta, untuk mengeluarkan orang hukuman dari tempat tahanan dan mengeluarkan orang-orang yang duduk dalam gelap dari rumah penjara."
 },
 {
   "id": 18493,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 8,
   "firman": "Aku ini TUHAN, itulah nama-Ku; Aku tidak akan memberikan kemuliaan-Ku kepada yang lain atau kemasyhuran-Ku kepada patung."
 },
 {
   "id": 18494,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 9,
   "firman": "Nubuat-nubuat yang dahulu sekarang sudah menjadi kenyataan, hal-hal yang baru hendak Kuberitahukan. Sebelum hal-hal itu muncul, Aku mengabarkannya kepadamu.\""
 },
 {
   "id": 18495,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 10,
   "firman": "Nyanyikanlah nyanyian baru bagi TUHAN dan pujilah Dia dari ujung bumi! Baiklah laut bergemuruh serta segala isinya dan pulau-pulau dengan segala penduduknya."
 },
 {
   "id": 18496,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 11,
   "firman": "Baiklah padang gurun menyaringkan suara dengan kota-kotanya dan dengan desa-desa yang didiami Kedar! Baiklah bersorak-sorai penduduk Bukit Batu, baiklah mereka berseru-seru dari puncak gunung-gunung!"
 },
 {
   "id": 18497,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 12,
   "firman": "Baiklah mereka memberi penghormatan kepada TUHAN, dan memberitakan pujian yang kepada-Nya di pulau-pulau."
 },
 {
   "id": 18498,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 13,
   "firman": "TUHAN keluar berperang seperti pahlawan, seperti orang perang Ia membangkitkan semangat-Nya untuk bertempur; Ia bertempik sorak, ya, Ia memekik, terhadap musuh-musuh-Nya Ia membuktikan kepahlawanan-Nya."
 },
 {
   "id": 18499,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 14,
   "firman": "Aku membisu dari sejak dahulu kala, Aku berdiam diri, Aku menahan hati-Ku; sekarang Aku mau mengerang seperti perempuan yang melahirkan, Aku mau mengah-mengah dan megap-megap."
 },
 {
   "id": 18500,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 15,
   "firman": "Aku mau membuat tandus gunung-gunung dan bukit-bukit, dan mau membuat layu segala tumbuh-tumbuhannya; Aku mau membuat sungai-sungai menjadi tanah kering dan mau membuat kering telaga-telaga."
 },
 {
   "id": 18501,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 16,
   "firman": "Aku mau memimpin orang-orang buta di jalan yang tidak mereka kenal, dan mau membawa mereka berjalan di jalan-jalan yang tidak mereka kenal. Aku mau membuat kegelapan yang di depan mereka menjadi terang dan tanah yang berkeluk-keluk menjadi tanah yang rata. Itulah hal-hal yang hendak Kulakukan kepada mereka, yang pasti akan Kulaksanakan."
 },
 {
   "id": 18502,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 17,
   "firman": "Orang-orang yang percaya kepada patung pahatan akan berpaling ke belakang dan mendapat malu, yaitu orang-orang yang berkata kepada patung tuangan: \"Kamulah allah kami!\""
 },
 {
   "id": 18503,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 18,
   "firman": "Dengarkanlah, hai orang-orang tuli pandanglah dan lihatlah, hai orang-orang buta!"
 },
 {
   "id": 18504,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 19,
   "firman": "Siapakah yang buta selain dari hamba-Ku, dan yang tuli seperti utusan yang Kusuruh? Siapakah yang buta seperti suruhan-Ku dan yang tuli seperti hamba TUHAN?"
 },
 {
   "id": 18505,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 20,
   "firman": "Engkau melihat banyak, tetapi tidak memperhatikan, engkau memasang telinga, tetapi tidak mendengar."
 },
 {
   "id": 18506,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 21,
   "firman": "TUHAN telah berkenan demi penyelamatan-Nya untuk memberi pengajaran-Nya yang besar dan mulia;"
 },
 {
   "id": 18507,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 22,
   "firman": "namun mereka suatu bangsa yang dijarah dan dirampok, mereka semua terjebak dalam geronggang-geronggang dan disembunyikan dalam rumah-rumah penjara; mereka telah menjadi jarahan dan tidak ada yang melepaskan, menjadi rampasan dan tidak ada yang berkata: \"Kembalikanlah!\""
 },
 {
   "id": 18508,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 23,
   "firman": "Siapakah di antara kamu yang mau memasang telinga kepada hal ini, yang mau memperhatikan dan mendengarkannya untuk masa yang kemudian?"
 },
 {
   "id": 18509,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 24,
   "firman": "Siapakah yang menyerahkan Yakub untuk dirampas, dan Israel kepada penjarah? Bukankah itu TUHAN? Sebab kepada-Nya kita telah berdosa, dan orang tidak mau mengikuti jalan yang telah ditunjuk-Nya, dan kepada pengajaran-Nya orang tidak mau mendengar."
 },
 {
   "id": 18510,
   "kitab": "Yes",
   "pasal": 42,
   "ayat": 25,
   "firman": "Maka Ia telah menumpahkan kepadanya kepanasan amarah-Nya dan peperangan yang hebat, yang menghanguskan dia dari sekeliling, tetapi ia tidak menginsafinya, dan yang membakar dia, tetapi ia tidak memperhatikannya."
 },
 {
   "id": 18511,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 1,
   "firman": "Tetapi sekarang, beginilah firman TUHAN yang menciptakan engkau, hai Yakub, yang membentuk engkau, hai Israel: \"Janganlah takut, sebab Aku telah menebus engkau, Aku telah memanggil engkau dengan namamu, engkau ini kepunyaan-Ku."
 },
 {
   "id": 18512,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 2,
   "firman": "Apabila engkau menyeberang melalui air, Aku akan menyertai engkau, atau melalui sungai-sungai, engkau tidak akan dihanyutkan; apabila engkau berjalan melalui api, engkau tidak akan dihanguskan, dan nyala api tidak akan membakar engkau."
 },
 {
   "id": 18513,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 3,
   "firman": "Sebab Akulah TUHAN, Allahmu, Yang Mahakudus, Allah Israel, Juruselamatmu. Aku menebus engkau dengan Mesir, dan memberikan Etiopia dan Syeba sebagai gantimu."
 },
 {
   "id": 18514,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 4,
   "firman": "Oleh karena engkau berharga di mata-Ku dan mulia, dan Aku ini mengasihi engkau, maka Aku memberikan manusia sebagai gantimu, dan bangsa-bangsa sebagai ganti nyawamu."
 },
 {
   "id": 18515,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 5,
   "firman": "Janganlah takut, sebab Aku ini menyertai engkau, Aku akan mendatangkan anak cucumu dari timur, dan Aku akan menghimpun engkau dari barat."
 },
 {
   "id": 18516,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 6,
   "firman": "Aku akan berkata kepada utara: Berikanlah! dan kepada selatan: Janganlah tahan-tahan! Bawalah anak-anak-Ku laki-laki dari jauh, dan anak-anak-Ku perempuan dari ujung-ujung bumi,"
 },
 {
   "id": 18517,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 7,
   "firman": "semua orang yang disebutkan dengan nama-Ku yang Kuciptakan untuk kemuliaan-Ku, yang Kubentuk dan yang juga Kujadikan!\""
 },
 {
   "id": 18518,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 8,
   "firman": "Biarlah orang membawa tampil bangsa yang buta sekalipun ada matanya, yang tuli sekalipun ada telinganya!"
 },
 {
   "id": 18519,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 9,
   "firman": "Biarlah berhimpun bersama-sama segala bangsa-bangsa, dan biarlah berkumpul suku-suku bangsa! Siapakah di antara mereka yang dapat memberitahukan hal-hal ini, yang dapat mengabarkan kepada kita hal-hal yang dahulu? Biarlah mereka membawa saksi-saksinya, supaya mereka nyata benar; biarlah orang mendengarnya dan berkata: \"Benar demikian!\""
 },
 {
   "id": 18520,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 10,
   "firman": "\"Kamu inilah saksi-saksi-Ku,\" demikianlah firman TUHAN, \"dan hamba-Ku yang telah Kupilih, supaya kamu tahu dan percaya kepada-Ku dan mengerti, bahwa Aku tetap Dia. Sebelum Aku tidak ada Allah dibentuk, dan sesudah Aku tidak akan ada lagi."
 },
 {
   "id": 18521,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 11,
   "firman": "Aku, Akulah TUHAN dan tidak ada juruselamat selain dari pada-Ku."
 },
 {
   "id": 18522,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 12,
   "firman": "Akulah yang memberitahukan, menyelamatkan dan mengabarkan, dan bukannya allah asing yang ada di antaramu. Kamulah saksi-saksi-Ku,\" demikianlah firman TUHAN, \"dan Akulah Allah."
 },
 {
   "id": 18523,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 13,
   "firman": "Juga seterusnya Aku tetap Dia, dan tidak ada yang dapat melepaskan dari tangan-Ku; Aku melakukannya, siapakah yang dapat mencegahnya?\""
 },
 {
   "id": 18524,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 14,
   "firman": "Beginilah firman TUHAN, Penebusmu, Yang Mahakudus, Allah Israel: \"Oleh karena kamu Aku mau menyuruh orang ke Babel dan mau membuka semua palang-palang pintu penjara, dan sorak-sorai orang Kasdim menjadi keluh kesah."
 },
 {
   "id": 18525,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 15,
   "firman": "Akulah TUHAN, Yang Mahakudus, Allahmu, Rajamu, yang menciptakan Israel.\""
 },
 {
   "id": 18526,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 16,
   "firman": "Beginilah firman TUHAN, yang telah membuat jalan melalui laut dan melalui air yang hebat,"
 },
 {
   "id": 18527,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 17,
   "firman": "yang telah menyuruh kereta dan kuda keluar untuk berperang, juga tentara dan orang gagah--mereka terbaring, tidak dapat bangkit, sudah mati, sudah padam sebagai sumbu--,"
 },
 {
   "id": 18528,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 18,
   "firman": "firman-Nya: \"Janganlah ingat-ingat hal-hal yang dahulu, dan janganlah perhatikan hal-hal yang dari zaman purbakala!"
 },
 {
   "id": 18529,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 19,
   "firman": "Lihat, Aku hendak membuat sesuatu yang baru, yang sekarang sudah tumbuh, belumkah kamu mengetahuinya? Ya, Aku hendak membuat jalan di padang gurun dan sungai-sungai di padang belantara."
 },
 {
   "id": 18530,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 20,
   "firman": "Binatang hutan akan memuliakan Aku, serigala dan burung unta, sebab Aku telah membuat air memancar di padang gurun dan sungai-sungai di padang belantara, untuk memberi minum umat pilihan-Ku;"
 },
 {
   "id": 18531,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 21,
   "firman": "umat yang telah Kubentuk bagi-Ku akan memberitakan kemasyhuran-Ku.\""
 },
 {
   "id": 18532,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 22,
   "firman": "\"Sungguh, engkau tidak memanggil Aku, hai Yakub, dan engkau tidak bersusah-susah karena Aku, hai Israel."
 },
 {
   "id": 18533,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 23,
   "firman": "Engkau tidak membawa domba korban bakaranmu bagi-Ku, dan tidak memuliakan Aku dengan korban sembelihanmu. Aku tidak memberati engkau dengan menuntut korban sajian atau menyusahi engkau dengan menuntut kemenyan."
 },
 {
   "id": 18534,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 24,
   "firman": "Engkau tidak membeli tebu wangi bagi-Ku dengan uang atau mengenyangkan Aku dengan lemak korban sembelihanmu. Tetapi engkau memberati Aku dengan dosamu, engkau menyusahi Aku dengan kesalahanmu."
 },
 {
   "id": 18535,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 25,
   "firman": "Aku, Akulah Dia yang menghapus dosa pemberontakanmu oleh karena Aku sendiri, dan Aku tidak mengingat-ingat dosamu."
 },
 {
   "id": 18536,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 26,
   "firman": "Ingatkanlah Aku, marilah kita berperkara, kemukakanlah segala sesuatu, supaya engkau nyata benar!"
 },
 {
   "id": 18537,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 27,
   "firman": "Bapa leluhurmu yang pertama sudah berdosa, dan jurubicaramu telah memberontak terhadap Aku."
 },
 {
   "id": 18538,
   "kitab": "Yes",
   "pasal": 43,
   "ayat": 28,
   "firman": "Jadi Aku terpaksa menajiskan pemimpin-pemimpin tempat kudus, dan terpaksa menyerahkan Yakub untuk ditumpas dan Israel untuk dinista.\""
 },
 {
   "id": 18539,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 1,
   "firman": "\"Tetapi sekarang, dengarlah, hai Yakub, hamba-Ku, dan hai Israel, yang telah Kupilih!"
 },
 {
   "id": 18540,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN yang menjadikan engkau, yang membentuk engkau sejak dari kandungan dan yang menolong engkau: Janganlah takut, hai hamba-Ku Yakub, dan hai Yesyurun, yang telah Kupilih!"
 },
 {
   "id": 18541,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 3,
   "firman": "Sebab Aku akan mencurahkan air ke atas tanah yang haus, dan hujan lebat ke atas tempat yang kering. Aku akan mencurahkan Roh-Ku ke atas keturunanmu, dan berkat-Ku ke atas anak cucumu."
 },
 {
   "id": 18542,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 4,
   "firman": "Mereka akan tumbuh seperti rumput di tengah-tengah air, seperti pohon-pohon gandarusa di tepi sungai."
 },
 {
   "id": 18543,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 5,
   "firman": "Yang satu akan berkata: Aku kepunyaan TUHAN, yang lain akan menyebut dirinya dengan nama Yakub, dan yang ketiga akan menuliskan pada tangannya: Kepunyaan TUHAN, dan akan menggelari dirinya dengan nama Israel.\""
 },
 {
   "id": 18544,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 6,
   "firman": "Beginilah firman TUHAN, Raja dan Penebus Israel, TUHAN semesta alam: \"Akulah yang terdahulu dan Akulah yang terkemudian; tidak ada Allah selain dari pada-Ku."
 },
 {
   "id": 18545,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 7,
   "firman": "Siapakah seperti Aku? Biarlah ia menyerukannya, biarlah ia memberitahukannya dan membentangkannya kepada-Ku! Siapakah yang mengabarkan dari dahulu kala hal-hal yang akan datang? Apa yang akan tiba, biarlah mereka memberitahukannya kepada kami!"
 },
 {
   "id": 18546,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 8,
   "firman": "Janganlah gentar dan janganlah takut, sebab memang dari dahulu telah Kukabarkan dan Kuberitahukan hal itu kepadamu. Kamulah saksi-saksi-Ku! Adakah Allah selain dari pada-Ku? Tidak ada Gunung Batu yang lain, tidak ada Kukenal!\""
 },
 {
   "id": 18547,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 9,
   "firman": "Orang-orang yang membentuk patung, semuanya adalah kesia-siaan, dan barang-barang kesayangan mereka itu tidaklah memberi faedah. Penyembah-penyembah patung itu tidaklah melihat dan tidaklah mengetahui apa-apa; oleh karena itu mereka akan mendapat malu."
 },
 {
   "id": 18548,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 10,
   "firman": "Siapakah yang membentuk allah dan menuang patung yang tidak memberi faedah?"
 },
 {
   "id": 18549,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 11,
   "firman": "Sesungguhnya, semua pengikutnya akan mendapat malu, dan tukang-tukangnya adalah manusia belaka. Biarlah mereka semua berkumpul dan bangkit berdiri! Mereka akan gentar dan mendapat malu bersama-sama."
 },
 {
   "id": 18550,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 12,
   "firman": "Tukang besi membuatnya dalam bara api dan menempanya dengan palu, ia mengerjakannya dengan segala tenaga yang ada di tangannya. Bahkan ia menahan lapar sehingga habislah tenaganya, dan ia tidak minum air sehingga ia letih lesu."
 },
 {
   "id": 18551,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 13,
   "firman": "Tukang kayu merentangkan tali pengukur dan membuat bagan sebuah patung dengan kapur merah; ia mengerjakannya dengan pahat dan menggarisinya dengan jangka, lalu ia memberi bentuk seorang laki-laki kepadanya, seperti seorang manusia yang tampan, dan selanjutnya ditempatkan dalam kuil."
 },
 {
   "id": 18552,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 14,
   "firman": "Mungkin ia menebang pohon-pohon aras atau ia memilih pohon saru atau pohon tarbantin, lalu membiarkannya tumbuh menjadi besar di antara pohon-pohon di hutan, atau ia menanam pohon salam, lalu hujan membuatnya besar."
 },
 {
   "id": 18553,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 15,
   "firman": "Dan kayunya menjadi kayu api bagi manusia, yang memakainya untuk memanaskan diri; lagipula ia menyalakannya untuk membakar roti. Tetapi juga ia membuatnya menjadi allah lalu menyembah kepadanya; ia mengerjakannya menjadi patung lalu sujud kepadanya."
 },
 {
   "id": 18554,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 16,
   "firman": "Setengahnya dibakarnya dalam api dan di atasnya dipanggangnya daging. Lalu ia memakan daging yang dipanggang itu sampai kenyang; ia memanaskan diri sambil berkata: \"Ha, aku sudah menjadi panas, aku telah merasakan kepanasan api.\""
 },
 {
   "id": 18555,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 17,
   "firman": "Dan sisa kayu itu dikerjakannya menjadi allah, menjadi patung sembahannya; ia sujud kepadanya, ia menyembah dan berdoa kepadanya, katanya: \"Tolonglah aku, sebab engkaulah allahku!\""
 },
 {
   "id": 18556,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 18,
   "firman": "Orang seperti itu tidak mengetahui apa-apa dan tidak mengerti apa-apa, sebab matanya melekat tertutup, sehingga tidak dapat melihat, dan hatinya tertutup juga, sehingga tidak dapat memahami."
 },
 {
   "id": 18557,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 19,
   "firman": "Tidak ada yang mempertimbangkannya, tidak ada cukup pengetahuan atau pengertian untuk mengatakan: \"Setengahnya sudah kubakar dalam api dan di atas baranya juga sudah kubakar roti, sudah kupanggang daging, lalu kumakan. Masakan sisanya akan kubuat menjadi dewa kekejian? Masakan aku akan menyembah kepada kayu kering?\""
 },
 {
   "id": 18558,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 20,
   "firman": "Orang yang sibuk dengan abu belaka, disesatkan oleh hatinya yang tertipu; ia tidak dapat menyelamatkan jiwanya atau mengatakan: \"Bukankah dusta yang menjadi peganganku?\""
 },
 {
   "id": 18559,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 21,
   "firman": "Ingatlah semuanya ini, hai Yakub, sebab engkaulah hamba-Ku, hai Israel. Aku telah membentuk engkau, engkau adalah hamba-Ku; hai Israel, engkau tidak Kulupakan."
 },
 {
   "id": 18560,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 22,
   "firman": "Aku telah menghapus segala dosa pemberontakanmu seperti kabut diterbangkan angin dan segala dosamu seperti awan yang tertiup. Kembalilah kepada-Ku, sebab Aku telah menebus engkau!"
 },
 {
   "id": 18561,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 23,
   "firman": "Bersorak-sorailah, hai langit, sebab TUHAN telah bertindak, bertempiksoraklah, hai rahim bumi! Bergembiralah dengan sorak-sorai, hai gunung-gunung, hai hutan serta segala pohon di dalamnya! Sebab TUHAN telah menebus Yakub, dan Ia telah memperlihatkan keagungan-Nya dalam hal Israel."
 },
 {
   "id": 18562,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 24,
   "firman": "Beginilah firman TUHAN, Penebusmu, yang membentuk engkau sejak dari kandungan; \"Akulah TUHAN, yang menjadikan segala sesuatu, yang seorang diri membentangkan langit, yang menghamparkan bumi--siapakah yang mendampingi Aku? --"
 },
 {
   "id": 18563,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 25,
   "firman": "Akulah yang meniadakan tanda-tanda peramal pembohong dan mempermain-mainkan tukang-tukang tenung; yang membuat orang-orang bijaksana mundur ke belakang, dan membalikkan pengetahuan mereka menjadi kebodohan;"
 },
 {
   "id": 18564,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 26,
   "firman": "Akulah yang menguatkan perkataan hamba-hamba-Ku dan melaksanakan keputusan-keputusan yang diberitakan utusan-utusan-Ku; yang berkata tentang Yerusalem: Baiklah ia didiami! dan tentang kota-kota Yehuda: Baiklah ia dibangun, Aku mau mendirikan kembali reruntuhannya!"
 },
 {
   "id": 18565,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 27,
   "firman": "Akulah yang berkata kepada tubir lautan: Jadilah kering, Aku mau mengeringkan sungai-sungaimu!"
 },
 {
   "id": 18566,
   "kitab": "Yes",
   "pasal": 44,
   "ayat": 28,
   "firman": "Akulah yang berkata tentang Koresh: Dia gembala-Ku; segala kehendak-Ku akan digenapinya dengan mengatakan tentang Yerusalem: Baiklah ia dibangun! dan tentang Bait Suci: Baiklah diletakkan dasarnya!\""
 },
 {
   "id": 18567,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: \"Inilah firman-Ku kepada orang yang Kuurapi, kepada Koresh yang tangan kanannya Kupegang supaya Aku menundukkan bangsa-bangsa di depannya dan melucuti raja-raja, supaya Aku membuka pintu-pintu di depannya dan supaya pintu-pintu gerbang tidak tinggal tertutup:"
 },
 {
   "id": 18568,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 2,
   "firman": "Aku sendiri hendak berjalan di depanmu dan hendak meratakan gunung-gunung, hendak memecahkan pintu-pintu tembaga dan hendak mematahkan palang-palang besi."
 },
 {
   "id": 18569,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 3,
   "firman": "Aku akan memberikan kepadamu harta benda yang terpendam dan harta kekayaan yang tersembunyi, supaya engkau tahu, bahwa Akulah TUHAN, Allah Israel, yang memanggil engkau dengan namamu."
 },
 {
   "id": 18570,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 4,
   "firman": "Oleh karena hamba-Ku Yakub dan Israel, pilihan-Ku, maka Aku memanggil engkau dengan namamu, menggelari engkau, sekalipun engkau tidak mengenal Aku."
 },
 {
   "id": 18571,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 5,
   "firman": "Akulah TUHAN dan tidak ada yang lain; kecuali Aku tidak ada Allah. Aku telah mempersenjatai engkau, sekalipun engkau tidak mengenal Aku,"
 },
 {
   "id": 18572,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 6,
   "firman": "supaya orang tahu dari terbitnya matahari sampai terbenamnya, bahwa tidak ada yang lain di luar Aku. Akulah TUHAN dan tidak ada yang lain,"
 },
 {
   "id": 18573,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 7,
   "firman": "yang menjadikan terang dan menciptakan gelap, yang menjadikan nasib mujur dan menciptakan nasib malang; Akulah TUHAN yang membuat semuanya ini."
 },
 {
   "id": 18574,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 8,
   "firman": "Hai langit, teteskanlah keadilan dari atas, dan baiklah awan-awan mencurahkannya! Baiklah bumi membukakan diri dan bertunaskan keselamatan, dan baiklah ditumbuhkannya keadilan! Akulah TUHAN yang menciptakan semuanya ini.\""
 },
 {
   "id": 18575,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 9,
   "firman": "Celakalah orang yang berbantah dengan Pembentuknya; dia tidak lain dari beling periuk saja! Adakah tanah liat berkata kepada pembentuknya: \"Apakah yang kaubuat?\" atau yang telah dibuatnya: \"Engkau tidak punya tangan!\""
 },
 {
   "id": 18576,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 10,
   "firman": "Celakalah orang yang berkata kepada ayahnya: \"Apakah yang kauperanakkan?\" dan kepada ibunya: \"Apakah yang kaulahirkan?\""
 },
 {
   "id": 18577,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 11,
   "firman": "Beginilah firman TUHAN, Yang Mahakudus, Allah dan Pembentuk Israel: \"Kamukah yang mengajukan pertanyaan kepada-Ku mengenai anak-anak-Ku, atau memberi perintah kepada-Ku mengenai yang dibuat tangan-Ku?"
 },
 {
   "id": 18578,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 12,
   "firman": "Akulah yang menjadikan bumi dan yang menciptakan manusia di atasnya; tangan-Kulah yang membentangkan langit, dan Akulah yang memberi perintah kepada seluruh tentaranya."
 },
 {
   "id": 18579,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 13,
   "firman": "Akulah yang menggerakkan Koresh untuk maksud penyelamatan, dan Aku akan meratakan segala jalannya; dialah yang akan membangun kota-Ku dan yang akan melepaskan orang-orang-Ku yang ada dalam pembuangan, tanpa bayaran dan tanpa suap,\" firman TUHAN semesta alam."
 },
 {
   "id": 18580,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 14,
   "firman": "Beginilah firman TUHAN: \"Hasil tanah dari Mesir dan segala laba dari Etiopia dan orang-orang Syeba, orang-orang yang tinggi perawakannya, akan pindah kepadamu dan menjadi kepunyaanmu, mereka akan berjalan di belakangmu dengan dirantai; mereka akan sujud kepadamu dan akan membujuk engkau, katanya: Hanya di tengah-tengahmu ada Allah, dan tidak ada yang lain; di samping Dia tidak ada Allah!"
 },
 {
   "id": 18581,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 15,
   "firman": "Sungguh, Engkau Allah yang menyembunyikan diri, Allah Israel, Juruselamat."
 },
 {
   "id": 18582,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 16,
   "firman": "Tetapi tukang-tukang berhala harus mundur dengan penuh noda, semuanya akan mendapat malu dan kena noda juga."
 },
 {
   "id": 18583,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 17,
   "firman": "Sedangkan Israel diselamatkan oleh TUHAN dengan keselamatan yang selama-lamanya; kamu tidak akan mendapat malu dan tidak akan kena noda sampai selamanya dan seterusnya.\""
 },
 {
   "id": 18584,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 18,
   "firman": "Sebab beginilah firman TUHAN, yang menciptakan langit, --Dialah Allah--yang membentuk bumi dan menjadikannya dan yang menegakkannya, --dan Ia menciptakannya bukan supaya kosong, tetapi Ia membentuknya untuk didiami--:\"Akulah TUHAN dan tidak ada yang lain."
 },
 {
   "id": 18585,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 19,
   "firman": "Tidak pernah Aku berkata dengan sembunyi atau di tempat bumi yang gelap. Tidak pernah Aku menyuruh keturunan Yakub untuk mencari Aku dengan sia-sia! Aku, TUHAN, selalu berkata benar, selalu memberitakan apa yang lurus.\""
 },
 {
   "id": 18586,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 20,
   "firman": "\"Berhimpunlah dan datanglah, tampillah bersama-sama, hai kamu sekalian yang terluput di antara bangsa-bangsa! Tiada berpengetahuan orang-orang yang mengarak patung dari kayu dan yang berdoa kepada allah yang tidak dapat menyelamatkan."
 },
 {
   "id": 18587,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 21,
   "firman": "Beritahukanlah dan kemukakanlah alasanmu, ya, biarlah mereka berunding bersama-sama: Siapakah yang mengabarkan hal ini dari zaman purbakala, dan memberitahukannya dari sejak dahulu? Bukankah Aku, TUHAN? Tidak ada yang lain, tidak ada Allah selain dari pada-Ku! Allah yang adil dan Juruselamat, tidak ada yang lain kecuali Aku!"
 },
 {
   "id": 18588,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 22,
   "firman": "Berpalinglah kepada-Ku dan biarkanlah dirimu diselamatkan, hai ujung-ujung bumi! Sebab Akulah Allah dan tidak ada yang lain."
 },
 {
   "id": 18589,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 23,
   "firman": "Demi Aku sendiri Aku telah bersumpah, dari mulut-Ku telah keluar kebenaran, suatu firman yang tidak dapat ditarik kembali: dan semua orang akan bertekuk lutut di hadapan-Ku, dan akan bersumpah setia dalam segala bahasa,"
 },
 {
   "id": 18590,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 24,
   "firman": "sambil berkata: Keadilan dan kekuatan hanya ada di dalam TUHAN. Semua orang yang telah bangkit amarahnya terhadap Dia akan datang kepada-Nya dan mendapat malu,"
 },
 {
   "id": 18591,
   "kitab": "Yes",
   "pasal": 45,
   "ayat": 25,
   "firman": "tetapi seluruh keturunan Israel akan nyata benar dan akan bermegah di dalam TUHAN.\""
 },
 {
   "id": 18592,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 1,
   "firman": "Dewa Bel sudah ditundukkan, dewa Nebo sudah direbahkan, patung-patungnya sudah diangkut di atas binatang, di atas hewan; yang pernah kamu arak, sekarang telah dimuatkan sebagai beban pada binatang yang lelah,"
 },
 {
   "id": 18593,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 2,
   "firman": "yang tidak dapat menyelamatkan bebannya itu. Dewa-dewa itu bersama-sama direbahkan dan ditundukkan dan mereka sendiri harus pergi sebagai tawanan."
 },
 {
   "id": 18594,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 3,
   "firman": "\"Dengarkanlah Aku, hai kaum keturunan Yakub, hai semua orang yang masih tinggal dari keturunan Israel, hai orang-orang yang Kudukung sejak dari kandungan, hai orang-orang yang Kujunjung sejak dari rahim."
 },
 {
   "id": 18595,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 4,
   "firman": "Sampai masa tuamu Aku tetap Dia dan sampai masa putih rambutmu Aku menggendong kamu. Aku telah melakukannya dan mau menanggung kamu terus; Aku mau memikul kamu dan menyelamatkan kamu."
 },
 {
   "id": 18596,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 5,
   "firman": "Kepada siapakah kamu hendak menyamakan Aku, hendak membandingkan dan mengumpamakan Aku, sehingga kami sama?"
 },
 {
   "id": 18597,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 6,
   "firman": "Orang mengeluarkan emas dari dalam kantongnya dan menimbang perak dengan dacing, mereka mengupah tukang emas untuk membuat allah dari bahan itu, lalu mereka menyembahnya, juga sujud kepadanya!"
 },
 {
   "id": 18598,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 7,
   "firman": "Mereka mengangkatnya ke atas bahu dan memikulnya, lalu menaruhnya di tempatnya; di situ ia berdiri dan tidak dapat beralih dari tempatnya. Sekalipun orang berseru kepadanya, ia tidak menjawab dan ia tidak menyelamatkan mereka dari kesesakannya."
 },
 {
   "id": 18599,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 8,
   "firman": "Ingatlah hal itu dan jadilah malu, pertimbangkanlah dalam hati, hai orang-orang pemberontak!"
 },
 {
   "id": 18600,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 9,
   "firman": "Ingatlah hal-hal yang dahulu dari sejak purbakala, bahwasanya Akulah Allah dan tidak ada yang lain, Akulah Allah dan tidak ada yang seperti Aku,"
 },
 {
   "id": 18601,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 10,
   "firman": "yang memberitahukan dari mulanya hal yang kemudian dan dari zaman purbakala apa yang belum terlaksana, yang berkata: Keputusan-Ku akan sampai, dan segala kehendak-Ku akan Kulaksanakan,"
 },
 {
   "id": 18602,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 11,
   "firman": "yang memanggil burung buas dari timur, dan orang yang melaksanakan putusan-Ku dari negeri yang jauh. Aku telah mengatakannya, maka Aku hendak melangsungkannya, Aku telah merencanakannya, maka Aku hendak melaksanakannya."
 },
 {
   "id": 18603,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 12,
   "firman": "Dengarkanlah Aku hai orang-orang yang congkak, orang-orang yang jauh dari kebenaran:"
 },
 {
   "id": 18604,
   "kitab": "Yes",
   "pasal": 46,
   "ayat": 13,
   "firman": "Keselamatan yang dari pada-Ku tidak jauh lagi, sebab Aku telah mendekatkannya dan kelepasan yang Kuberikan tidak bertangguh lagi; Aku akan memberikan kelepasan di Sion dan keagungan-Ku kepada Israel.\""
 },
 {
   "id": 18605,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 1,
   "firman": "Turunlah dan duduklah di atas debu, hai anak dara, puteri Babel! Duduklah di tanah dengan tidak bertakhta, hai puteri Kasdim! Sebab engkau tidak akan disebutkan lagi manis dan genit."
 },
 {
   "id": 18606,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 2,
   "firman": "Ambillah batu kilangan dan gilinglah tepung, bukalah kerudungmu; angkatlah sarungmu, singkapkanlah paha, seberangilah sungai-sungai!"
 },
 {
   "id": 18607,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 3,
   "firman": "Biarlah auratmu tersingkap dan aibmu kelihatan! Aku akan mengadakan pembalasan dan tidak menyayangkan seorangpun,"
 },
 {
   "id": 18608,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 4,
   "firman": "kata Penebus kami, TUHAN semesta alam nama-Nya, Yang Mahakudus, Allah Israel."
 },
 {
   "id": 18609,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 5,
   "firman": "Duduklah dengan berdiam diri dan masuklah ke dalam gelap, hai puteri Kasdim! Sebab engkau tidak akan disebutkan lagi ratu atas kerajaan-kerajaan."
 },
 {
   "id": 18610,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 6,
   "firman": "Aku tadinya murka terhadap umat-Ku, menajiskan milik pusaka-Ku, dan menyerahkannya ke dalam tanganmu; dan engkau tidak menaruh belas kasihan kepada mereka, bahkan sangat memberatkan kukmu kepada orang yang tua."
 },
 {
   "id": 18611,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 7,
   "firman": "Katamu tadinya: \"Untuk selama-lamanya aku tetap menjadi ratu!\" sedang engkau tidak menyadari dan tidak memikirkan kesudahan semuanya itu."
 },
 {
   "id": 18612,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 8,
   "firman": "Oleh sebab itu, dengarlah ini, hai orang yang hidup bermanja-manja, yang duduk-duduk dengan tenang, yang berkata dalam hatimu: \"Tiada yang lain di sampingku! Aku tidak akan jadi janda dan tidak akan menjadi punah!\""
 },
 {
   "id": 18613,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 9,
   "firman": "Kedua hal itu akan menimpa engkau dalam sekejap mata, pada satu hari juga. Kepunahan dan kejandaan dengan sepenuhnya akan menimpa engkau, sekalipun banyak sihirmu dan sangat kuat manteramu."
 },
 {
   "id": 18614,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 10,
   "firman": "Engkau tadinya merasa aman dalam kejahatanmu, katamu: \"Tiada yang melihat aku!\" Kebijaksanaanmu dan pengetahuanmu itulah yang menyesatkan engkau, sehingga engkau berkata dalam hatimu: \"Tiada yang lain di sampingku!\""
 },
 {
   "id": 18615,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 11,
   "firman": "Tetapi malapetaka akan menimpa engkau, engkau tidak tahu mempergunakan jampimu terhadapnya; bencana akan jatuh atasmu, engkau tidak sanggup menampiknya dengan mempersembahkan korban; kebinasaan akan menimpa engkau dengan sekonyong-konyong, yang tidak terduga olehmu."
 },
 {
   "id": 18616,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 12,
   "firman": "Bertahan sajalah dengan segala manteramu dan sihirmu yang banyak itu, yang telah kaurepotkan dari sejak kecilmu; mungkin engkau sanggup mendatangkan bantuan, mungkin engkau dapat menimbulkan ketakutan."
 },
 {
   "id": 18617,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 13,
   "firman": "Engkau telah payah karena banyaknya nasihat! Biarlah tampil dan menyelamatkan engkau orang-orang yang meneliti segala penjuru langit, yang menilik bintang-bintang dan yang pada setiap bulan baru memberitahukan apa yang akan terjadi atasmu!"
 },
 {
   "id": 18618,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 14,
   "firman": "Sesungguhnya, mereka sebagai jerami yang dibakar api; mereka tidak dapat melepaskan nyawanya dari kuasa nyala api; api itu bukan bara api untuk memanaskan diri, bukan api untuk berdiang!"
 },
 {
   "id": 18619,
   "kitab": "Yes",
   "pasal": 47,
   "ayat": 15,
   "firman": "Demikianlah faedahnya bagimu dari tukang-tukang jampi itu, yang telah kaurepotkan dari sejak kecilmu; masing-masing mereka terhuyung-huyung ke segala jurusan, tidak ada yang dapat menyelamatkan engkau."
 },
 {
   "id": 18620,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 1,
   "firman": "Dengarlah firman ini, hai kaum keturunan Yakub, yang menyebutkan dirinya dengan nama Israel dan yang adalah keturunan Yehuda, yang bersumpah demi nama TUHAN dan mengakui Allah Israel--tetapi bukan dengan sungguh-sungguh dan dengan tulus hati--"
 },
 {
   "id": 18621,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 2,
   "firman": "bahkan mereka menyebutkan dirinya menurut kota kudus dan mereka bertopang kepada Allah Israel, TUHAN semesta alam nama-Nya;"
 },
 {
   "id": 18622,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 3,
   "firman": "firman TUHAN: \"Hal-hal yang terjadi di masa yang lampau telah Kuberitahukan dari sejak dahulu, Aku telah mengucapkannya dan telah mengabarkannya. Kemudian dengan sekonyong-konyong Aku melaksanakannya juga dan semuanya itu sudah menjadi kenyataan."
 },
 {
   "id": 18623,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 4,
   "firman": "Oleh karena Aku tahu, bahwa engkau tegar tengkuk, keras kepala dan berkepala batu,"
 },
 {
   "id": 18624,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 5,
   "firman": "maka Aku memberitahukannya kepadamu dari sejak dahulu; sebelum hal itu menjadi kenyataan, Aku mengabarkannya kepadamu, supaya jangan engkau berkata: Berhalaku yang melakukannya, patung pahatanku dan patung tuanganku yang memerintahkannya."
 },
 {
   "id": 18625,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 6,
   "firman": "Engkau telah mendengar semuanya itu dan sekarang engkau harus melihatnya; tidakkah kamu sendiri mau mengakuinya? Aku mengabarkan kepadamu hal-hal yang baru dari sejak sekarang, dan hal-hal yang tersimpan yang belum kauketahui."
 },
 {
   "id": 18626,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 7,
   "firman": "Baru sekarang hal-hal itu diciptakan dan bukan dari sejak dahulu, dan sebelumnya engkau tidak mendengarnya, supaya jangan engkau berkata: Memang aku telah mengetahuinya!"
 },
 {
   "id": 18627,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 8,
   "firman": "Engkau tidak mendengarnya ataupun mengetahuinya, juga telingamu tidak terbuka dari sejak dahulu; tetapi Aku telah mengetahui, bahwa engkau berbuat khianat sekeji-kejinya, dan bahwa orang menyebutkan engkau: pemberontak sejak dari kandungan."
 },
 {
   "id": 18628,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 9,
   "firman": "Oleh karena nama-Ku Aku menahan amarah-Ku dan oleh karena kemasyhuran-Ku Aku mengasihani engkau, sehingga Aku tidak melenyapkan engkau."
 },
 {
   "id": 18629,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 10,
   "firman": "Sesungguhnya, Aku telah memurnikan engkau, namun bukan seperti perak, tetapi Aku telah menguji engkau dalam dapur kesengsaraan."
 },
 {
   "id": 18630,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 11,
   "firman": "Aku akan melakukannya oleh karena Aku, ya oleh karena Aku sendiri, sebab masakan nama-Ku akan dinajiskan? Aku tidak akan memberikan kemuliaan-Ku kepada yang lain!\""
 },
 {
   "id": 18631,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 12,
   "firman": "\"Dengarkanlah Aku, hai Yakub, dan engkau Israel yang Kupanggil! Akulah yang tetap sama, Akulah yang terdahulu, Akulah juga yang terkemudian!"
 },
 {
   "id": 18632,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 13,
   "firman": "Tangan-Ku juga meletakkan dasar bumi, dan tangan kanan-Ku membentangkan langit. Ketika Aku menyebut namanya, semuanya bermunculan."
 },
 {
   "id": 18633,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 14,
   "firman": "Berhimpunlah kamu sekalian dan dengarlah! Siapakah di antara mereka memberitahukan semuanya ini? Dia yang dikasihi TUHAN akan melaksanakan kehendak TUHAN terhadap Babel dan menunjukkan kekuatan tangan TUHAN kepada orang Kasdim."
 },
 {
   "id": 18634,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 15,
   "firman": "Aku, Akulah yang mengatakannya dan yang memanggil dia juga, Akulah yang mendatangkan dia, dan segala usahanya akan berhasil."
 },
 {
   "id": 18635,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 16,
   "firman": "Mendekatlah kepada-Ku, dengarlah ini: Dari dahulu tidak pernah Aku berkata dengan sembunyi dan pada waktu hal itu terjadi Aku ada di situ.\" Dan sekarang, Tuhan ALLAH mengutus aku dengan Roh-Nya."
 },
 {
   "id": 18636,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 17,
   "firman": "Beginilah firman TUHAN, Penebusmu, Yang Mahakudus, Allah Israel: \"Akulah TUHAN, Allahmu, yang mengajar engkau tentang apa yang memberi faedah, yang menuntun engkau di jalan yang harus kautempuh."
 },
 {
   "id": 18637,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 18,
   "firman": "Sekiranya engkau memperhatikan perintah-perintah-Ku, maka damai sejahteramu akan seperti sungai yang tidak pernah kering, dan kebahagiaanmu akan terus berlimpah seperti gelombang-gelombang laut yang tidak pernah berhenti,"
 },
 {
   "id": 18638,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 19,
   "firman": "maka keturunanmu akan seperti pasir dan anak cucumu seperti kersik banyaknya; nama mereka tidak akan dilenyapkan atau ditiadakan dari hadapan-Ku.\""
 },
 {
   "id": 18639,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 20,
   "firman": "Keluarlah dari Babel, larilah dari Kasdim! Beritahukanlah dengan suara sorak-sorai dan kabarkanlah hal ini! Siarkanlah itu sampai ke ujung bumi! Katakanlah: \"TUHAN telah menebus Yakub, hamba-Nya!\""
 },
 {
   "id": 18640,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 21,
   "firman": "Mereka tidak menderita haus, ketika Ia memimpin mereka melalui tempat-tempat yang tandus; Ia mengeluarkan air dari gunung batu bagi mereka; Ia membelah gunung batu, maka memancarlah air."
 },
 {
   "id": 18641,
   "kitab": "Yes",
   "pasal": 48,
   "ayat": 22,
   "firman": "\"Tidak ada damai sejahtera bagi orang-orang fasik!\" firman TUHAN."
 },
 {
   "id": 18642,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 1,
   "firman": "Dengarkanlah aku, hai pulau-pulau, perhatikanlah, hai bangsa-bangsa yang jauh! TUHAN telah memanggil aku sejak dari kandungan telah menyebut namaku sejak dari perut ibuku."
 },
 {
   "id": 18643,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 2,
   "firman": "Ia telah membuat mulutku sebagai pedang yang tajam dan membuat aku berlindung dalam naungan tangan-Nya. Ia telah membuat aku menjadi anak panah yang runcing dan menyembunyikan aku dalam tabung panah-Nya."
 },
 {
   "id": 18644,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 3,
   "firman": "Ia berfirman kepadaku: \"Engkau adalah hamba-Ku, Israel, dan olehmu Aku akan menyatakan keagungan-Ku.\""
 },
 {
   "id": 18645,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 4,
   "firman": "Tetapi aku berkata: \"Aku telah bersusah-susah dengan percuma, dan telah menghabiskan kekuatanku dengan sia-sia dan tak berguna; namun, hakku terjamin pada TUHAN dan upahku pada Allahku.\""
 },
 {
   "id": 18646,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 5,
   "firman": "Maka sekarang firman TUHAN, yang membentuk aku sejak dari kandungan untuk menjadi hamba-Nya, untuk mengembalikan Yakub kepada-Nya, dan supaya Israel dikumpulkan kepada-Nya--maka aku dipermuliakan di mata TUHAN, dan Allahku menjadi kekuatanku--,firman-Nya:"
 },
 {
   "id": 18647,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 6,
   "firman": "\"Terlalu sedikit bagimu hanya untuk menjadi hamba-Ku, untuk menegakkan suku-suku Yakub dan untuk mengembalikan orang-orang Israel yang masih terpelihara. Tetapi Aku akan membuat engkau menjadi terang bagi bangsa-bangsa supaya keselamatan yang dari pada-Ku sampai ke ujung bumi.\""
 },
 {
   "id": 18648,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 7,
   "firman": "Beginilah firman TUHAN, Penebus Israel, Allahnya yang Mahakudus, kepada dia yang dihinakan orang, kepada dia yang dijijikkan bangsa-bangsa, kepada hamba penguasa-penguasa: \"Raja-raja akan melihat perbuatan-Ku, lalu bangkit memberi hormat, dan pembesar-pembesar akan sujud menyembah, oleh karena TUHAN yang setia oleh karena Yang Mahakudus, Allah Israel, yang memilih engkau.\""
 },
 {
   "id": 18649,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 8,
   "firman": "Beginilah firman TUHAN: \"Pada waktu Aku berkenan, Aku akan menjawab engkau, dan pada hari Aku menyelamatkan, Aku akan menolong engkau; Aku telah membentuk dan memberi engkau, menjadi perjanjian bagi umat manusia, untuk membangunkan bumi kembali dan untuk membagi-bagikan tanah pusaka yang sudah sunyi sepi,"
 },
 {
   "id": 18650,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 9,
   "firman": "untuk mengatakan kepada orang-orang yang terkurung: Keluarlah! kepada orang-orang yang ada di dalam gelap: Tampillah! Di sepanjang jalan mereka seperti domba yang tidak pernah kekurangan rumput, dan di segala bukit gundulpun tersedia rumput bagi mereka."
 },
 {
   "id": 18651,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 10,
   "firman": "Mereka tidak menjadi lapar atau haus; angin hangat dan terik matahari tidak akan menimpa mereka, sebab Penyayang mereka akan memimpin mereka dan akan menuntun mereka ke dekat sumber-sumber air."
 },
 {
   "id": 18652,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 11,
   "firman": "Aku akan membuat segala gunung-Ku menjadi jalan dan segala jalan raya-Ku akan Kuratakan."
 },
 {
   "id": 18653,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 12,
   "firman": "Lihat, ada orang yang datang dari jauh, ada dari utara dan dari barat, dan ada dari tanah Sinim.\""
 },
 {
   "id": 18654,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 13,
   "firman": "Bersorak-sorailah, hai langit, bersorak-soraklah, hai bumi, dan bergembiralah dengan sorak-sorai, hai gunung-gunung! Sebab TUHAN menghibur umat-Nya dan menyayangi orang-orang-Nya yang tertindas."
 },
 {
   "id": 18655,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 14,
   "firman": "Sion berkata: \"TUHAN telah meninggalkan aku dan Tuhanku telah melupakan aku.\""
 },
 {
   "id": 18656,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 15,
   "firman": "Dapatkah seorang perempuan melupakan bayinya, sehingga ia tidak menyayangi anak dari kandungannya? Sekalipun dia melupakannya, Aku tidak akan melupakan engkau."
 },
 {
   "id": 18657,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 16,
   "firman": "Lihat, Aku telah melukiskan engkau di telapak tangan-Ku; tembok-tembokmu tetap di ruang mata-Ku."
 },
 {
   "id": 18658,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 17,
   "firman": "Orang-orang yang membangun engkau datang bersegera, tetapi orang-orang yang merombak dan merusak engkau meninggalkan engkau."
 },
 {
   "id": 18659,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 18,
   "firman": "Angkatlah mukamu dan lihatlah ke sekeliling, mereka semua berhimpun datang kepadamu. Demi Aku yang hidup, demikianlah firman TUHAN, sungguh, mereka semua akan kaupakai sebagai perhiasan, dan mereka akan kaulilitkan, seperti yang dilakukan pengantin perempuan."
 },
 {
   "id": 18660,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 19,
   "firman": "Sebab tempat-tempatmu yang tandus dan sunyi sepi dan negerimu yang dirombak, sungguh, sekarang terlalu sempit untuk sekian banyak pendudukmu dan orang-orang yang mau menelan engkau akan menjauh."
 },
 {
   "id": 18661,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 20,
   "firman": "Malahan, anak-anakmu yang kausangka hilang akan berkata kepadamu: \"Tempat itu terlalu sempit bagiku, menyisihlah, supaya aku dapat diam di situ!\""
 },
 {
   "id": 18662,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 21,
   "firman": "Maka engkau akan berkata dalam hatimu: \"Siapakah yang telah melahirkan sekaliannya ini bagiku? Bukankah aku bulus dan mandul, diangkut ke dalam pembuangan dan disingkirkan? Tetapi anak-anak ini, siapakah yang membesarkan mereka? Sesungguhnya, aku tertinggal seorang diri, tetapi mereka ini, dari manakah datangnya?\""
 },
 {
   "id": 18663,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 22,
   "firman": "Beginilah firman Tuhan ALLAH: \"Lihat, Aku akan mengangkat tangan-Ku sebagai tanda untuk bangsa-bangsa dan memasang panji-panji-Ku untuk suku-suku bangsa, maka mereka akan menggendong anak-anakmu laki-laki dan anak-anakmu perempuan akan didukung di atas bahunya."
 },
 {
   "id": 18664,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 23,
   "firman": "Maka raja-raja akan menjadi pengasuhmu dan permaisuri-permaisuri mereka menjadi inangmu. Mereka akan sujud kepadamu dengan mukanya sampai ke tanah dan akan menjilat debu kakimu. Maka engkau akan mengetahui, bahwa Akulah TUHAN, dan bahwa orang-orang yang menanti-nantikan Aku tidak akan mendapat malu.\""
 },
 {
   "id": 18665,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 24,
   "firman": "Dapatkah direbut kembali jarahan dari pahlawan atau dapatkah lolos tawanan orang gagah?"
 },
 {
   "id": 18666,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 25,
   "firman": "Sungguh, beginilah firman TUHAN: \"Tawanan pahlawanpun dapat direbut kembali, dan jarahan orang gagah dapat lolos, sebab Aku sendiri akan melawan orang yang melawan engkau dan Aku sendiri akan menyelamatkan anak-anakmu."
 },
 {
   "id": 18667,
   "kitab": "Yes",
   "pasal": 49,
   "ayat": 26,
   "firman": "Aku akan memaksa orang-orang yang menindas engkau memakan dagingnya sendiri, dan mereka akan mabuk minum darahnya sendiri, seperti orang mabuk minum anggur baru, supaya seluruh umat manusia mengetahui, bahwa Aku, TUHAN, adalah Juruselamatmu dan Penebusmu, Yang Mahakuat, Allah Yakub.\""
 },
 {
   "id": 18668,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: \"Di manakah gerangan surat cerai ibumu tanda Aku telah mengusir dia? Atau kepada siapakah di antara penagih hutang-Ku Aku pernah menjual engkau? Sesungguhnya, oleh karena kesalahanmu sendiri kamu terjual dan oleh karena pelanggaranmu sendiri ibumu diusir."
 },
 {
   "id": 18669,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 2,
   "firman": "Mengapa ketika Aku datang tidak ada orang, dan ketika Aku memanggil tidak ada yang menjawab? Mungkinkah tangan-Ku terlalu pendek untuk membebaskan atau tidak adakah kekuatan pada-Ku untuk melepaskan? Sesungguhnya, dengan hardik-Ku Aku mengeringkan laut, Aku membuat sungai-sungai menjadi padang gurun; ikan-ikannya berbau amis karena tidak ada air dan mati kehausan."
 },
 {
   "id": 18670,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 3,
   "firman": "Aku mengenakan pakaian kelam kepada langit dan menyelimutinya dengan kain kabung.\""
 },
 {
   "id": 18671,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 4,
   "firman": "Tuhan ALLAH telah memberikan kepadaku lidah seorang murid, supaya dengan perkataan aku dapat memberi semangat baru kepada orang yang letih lesu. Setiap pagi Ia mempertajam pendengaranku untuk mendengar seperti seorang murid."
 },
 {
   "id": 18672,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 5,
   "firman": "Tuhan ALLAH telah membuka telingaku, dan aku tidak memberontak, tidak berpaling ke belakang."
 },
 {
   "id": 18673,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 6,
   "firman": "Aku memberi punggungku kepada orang-orang yang memukul aku, dan pipiku kepada orang-orang yang mencabut janggutku. Aku tidak menyembunyikan mukaku ketika aku dinodai dan diludahi."
 },
 {
   "id": 18674,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 7,
   "firman": "Tetapi Tuhan ALLAH menolong aku; sebab itu aku tidak mendapat noda. Sebab itu aku meneguhkan hatiku seperti keteguhan gunung batu karena aku tahu, bahwa aku tidak akan mendapat malu."
 },
 {
   "id": 18675,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 8,
   "firman": "Dia yang menyatakan aku benar telah dekat. Siapakah yang berani berbantah dengan aku? Marilah kita tampil bersama-sama! Siapakah lawanku berperkara? Biarlah ia mendekat kepadaku!"
 },
 {
   "id": 18676,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 9,
   "firman": "Sesungguhnya, Tuhan ALLAH menolong aku; siapakah yang berani menyatakan aku bersalah? Sesungguhnya, mereka semua akan memburuk seperti pakaian yang sudah usang; ngengat akan memakan mereka."
 },
 {
   "id": 18677,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 10,
   "firman": "Siapa di antaramu yang takut akan TUHAN dan mendengarkan suara hamba-Nya? Jika ia hidup dalam kegelapan dan tidak ada cahaya bersinar baginya, baiklah ia percaya kepada nama TUHAN dan bersandar kepada Allahnya!"
 },
 {
   "id": 18678,
   "kitab": "Yes",
   "pasal": 50,
   "ayat": 11,
   "firman": "Sesungguhnya, kamu semua yang menyalakan api dan yang memasang panah-panah api, masuklah ke dalam nyala apimu, dan ke tengah-tengah panah-panah api yang telah kamu pasang! Oleh tangan-Kulah hal itu akan terjadi atasmu; kamu akan berbaring di tempat siksaan."
 },
 {
   "id": 18679,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 1,
   "firman": "Dengarkanlah Aku, hai kamu yang mengejar apa yang benar, hai kamu yang mencari TUHAN! Pandanglah gunung batu yang dari padanya kamu terpahat, dan kepada lobang penggalian batu yang dari padanya kamu tergali."
 },
 {
   "id": 18680,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 2,
   "firman": "Pandanglah Abraham, bapa leluhurmu, dan Sara yang melahirkan kamu; ketika Abraham seorang diri, Aku memanggil dia, lalu Aku memberkati dan memperbanyak dia."
 },
 {
   "id": 18681,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 3,
   "firman": "Sebab TUHAN menghibur Sion, menghibur segala reruntuhannya; Ia membuat padang gurunnya seperti taman Eden dan padang belantaranya seperti taman TUHAN. Di situ terdapat kegirangan dan sukacita, nyanyian syukur dan lagu yang nyaring."
 },
 {
   "id": 18682,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 4,
   "firman": "Perhatikanlah suara-Ku, hai bangsa-bangsa, dan pasanglah telinga kepada-Ku, hai suku-suku bangsa! Sebab pengajaran akan keluar dari pada-Ku dan hukum-Ku sebagai terang untuk bangsa-bangsa."
 },
 {
   "id": 18683,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 5,
   "firman": "Dalam sekejap mata keselamatan yang dari pada-Ku akan dekat, kelepasan yang Kuberikan akan tiba, dan dengan tangan kekuasaan-Ku Aku akan memerintah bangsa-bangsa; kepada-Kulah pulau-pulau menanti-nanti, perbuatan tangan-Ku mereka harapkan."
 },
 {
   "id": 18684,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 6,
   "firman": "Arahkanlah matamu ke langit dan lihatlah ke bumi di bawah; sebab langit lenyap seperti asap, bumi memburuk seperti pakaian yang sudah usang dan penduduknya akan mati seperti nyamuk; tetapi kelepasan yang Kuberikan akan tetap untuk selama-lamanya, dan keselamatan yang dari pada-Ku tidak akan berakhir."
 },
 {
   "id": 18685,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 7,
   "firman": "Dengarkanlah Aku, hai kamu yang mengetahui apa yang benar, hai bangsa yang menyimpan pengajaran-Ku dalam hatimu! Janganlah takut jika diaibkan oleh manusia dan janganlah terkejut jika dinista oleh mereka."
 },
 {
   "id": 18686,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 8,
   "firman": "Sebab ngengat akan memakan mereka seperti memakan pakaian dan gegat akan memakan mereka seperti memakan kain bulu domba; tetapi keselamatan yang dari pada-Ku akan tetap untuk selama-lamanya dan kelepasan yang Kuberikan akan lanjut dari keturunan kepada keturunan."
 },
 {
   "id": 18687,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 9,
   "firman": "Terjagalah, terjagalah! Kenakanlah kekuatan, hai tangan TUHAN! Terjagalah seperti pada zaman purbakala, pada zaman keturunan yang dahulu kala! Bukankah Engkau yang meremukkan Rahab, yang menikam naga sampai mati?"
 },
 {
   "id": 18688,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 10,
   "firman": "Bukankah Engkau yang mengeringkan laut, air samudera raya yang hebat? yang membuat laut yang dalam menjadi jalan, supaya orang-orang yang diselamatkan dapat menyeberang?"
 },
 {
   "id": 18689,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 11,
   "firman": "Maka orang-orang yang dibebaskan TUHAN akan pulang dan masuk ke Sion dengan sorak-sorai, sedang sukacita abadi meliputi mereka; kegirangan dan sukacita akan memenuhi mereka, duka dan keluh akan menjauh."
 },
 {
   "id": 18690,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 12,
   "firman": "Akulah, Akulah yang menghibur kamu. Siapakah engkau maka engkau takut terhadap manusia yang memang akan mati, terhadap anak manusia yang dibuang seperti rumput,"
 },
 {
   "id": 18691,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 13,
   "firman": "sehingga engkau melupakan TUHAN yang menjadikan engkau, yang membentangkan langit dan meletakkan dasar bumi, sehingga engkau terus gentar sepanjang hari terhadap kepanasan amarah orang penganiaya, apabila ia bersiap-siap memusnahkan? Di manakah gerangan kepanasan amarah orang penganiaya itu?"
 },
 {
   "id": 18692,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 14,
   "firman": "Dia yang dipasung terbelenggu akan segera dibebaskan; ia tidak akan turun mati ke liang kubur, dan tidak akan kekurangan makanan."
 },
 {
   "id": 18693,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 15,
   "firman": "Sebab Akulah TUHAN, Allahmu, yang mengharubirukan laut, sehingga gelombang-gelombangnya ribut, --TUHAN semesta alam nama-Nya."
 },
 {
   "id": 18694,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 16,
   "firman": "Aku menaruh firman-Ku ke dalam mulutmu dan menyembunyikan engkau dalam naungan tangan-Ku, supaya Aku kembali membentangkan langit dan meletakkan dasar bumi, dan berkata kepada Sion: Engkau adalah umat-Ku!"
 },
 {
   "id": 18695,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 17,
   "firman": "Terjagalah, terjagalah, bangunlah, hai Yerusalem, hai engkau yang telah meminum dari tangan TUHAN isi piala kehangatan murka-Nya, engkau yang telah meminum, menghirup habis isi cangkir yang memusingkan!"
 },
 {
   "id": 18696,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 18,
   "firman": "Dari semua anak-anak yang dilahirkannya tidak ada yang membimbing dia dan dari semua anak-anak yang dibesarkannya tidak ada yang memegang tangannya."
 },
 {
   "id": 18697,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 19,
   "firman": "Kedua hal ini telah menimpa engkau--siapakah yang akan turut berdukacita dengan engkau? Kebinasaan dan keruntuhan, kelaparan dan pedang--siapakah yang akan menghibur engkau?"
 },
 {
   "id": 18698,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 20,
   "firman": "Anak-anakmu sudah terlentang kelesuan di semua ujung jalan seperti lembu hutan kena jaring; mereka diliputi kehangatan murka TUHAN dan hardik Allahmu."
 },
 {
   "id": 18699,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 21,
   "firman": "Sebab itu, dengarlah ini, hai engkau yang tertindas, hai engkau yang mabuk, tetapi bukan karena anggur!"
 },
 {
   "id": 18700,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 22,
   "firman": "Beginilah firman Tuhanmu, TUHAN, Allahmu yang memperjuangkan perkara umat-Nya: \"Sesungguhnya, Aku mengambil dari tanganmu piala dengan isinya yang memusingkan, dan isi cangkir kehangatan murka-Ku tidak akan kauminum lagi,"
 },
 {
   "id": 18701,
   "kitab": "Yes",
   "pasal": 51,
   "ayat": 23,
   "firman": "tetapi Aku akan memberikannya ke tangan orang yang menindas engkau, orang yang tadinya berkata kepadamu: Tunduklah, supaya kami lewat menginjak kamu! Maka engkau merentangkan punggungmu serata tanah dan sebagai jalan bagi orang yang lewat dari atasnya.\""
 },
 {
   "id": 18702,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 1,
   "firman": "Terjagalah, terjagalah! Kenakanlah kekuatanmu seperti pakaian, hai Sion! Kenakanlah pakaian kehormatanmu, hai Yerusalem, kota yang kudus! Sebab tidak seorangpun yang tak bersunat atau yang najis akan masuk lagi ke dalammu."
 },
 {
   "id": 18703,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 2,
   "firman": "Kebaskanlah debu dari padamu, bangunlah, hai Yerusalem yang tertawan! Tanggalkanlah ikatan-ikatan dari lehermu, hai puteri Sion yang tertawan!"
 },
 {
   "id": 18704,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 3,
   "firman": "Sebab beginilah firman TUHAN: Kamu dijual tanpa pembayaran, maka kamu akan ditebus tanpa pembayaran juga."
 },
 {
   "id": 18705,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 4,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Dahulu umat-Ku berangkat ke Mesir untuk tinggal di situ sebagai orang asing, lalu Asyur memeras dia tanpa alasan."
 },
 {
   "id": 18706,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 5,
   "firman": "Tetapi sekarang, apakah lagi urusan-Ku di sini? demikianlah firman TUHAN. Umat-Ku sudah dirampas begitu saja. Mereka yang berkuasa atas dia memegahkan diri, demikianlah firman TUHAN, dan nama-Ku terus dihujat sepanjang hari."
 },
 {
   "id": 18707,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 6,
   "firman": "Sebab itu umat-Ku akan mengenal nama-Ku dan pada waktu itu mereka akan mengerti bahwa Akulah Dia yang berbicara, ya Aku!"
 },
 {
   "id": 18708,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 7,
   "firman": "Betapa indahnya kelihatan dari puncak bukit-bukit kedatangan pembawa berita, yang mengabarkan berita damai dan memberitakan kabar baik, yang mengabarkan berita selamat dan berkata kepada Sion: \"Allahmu itu Raja!\""
 },
 {
   "id": 18709,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 8,
   "firman": "Dengarlah suara orang-orang yang mengawal engkau: mereka bersama-sama bersorak-sorai. Sebab dengan mata kepala sendiri mereka melihat bagaimana TUHAN kembali ke Sion."
 },
 {
   "id": 18710,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 9,
   "firman": "Bergembiralah, bersorak-sorailah bersama-sama, hai reruntuhan Yerusalem! Sebab TUHAN telah menghibur umat-Nya, telah menebus Yerusalem."
 },
 {
   "id": 18711,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 10,
   "firman": "TUHAN telah menunjukkan tangan-Nya yang kudus di depan mata semua bangsa; maka segala ujung bumi melihat keselamatan yang dari Allah kita."
 },
 {
   "id": 18712,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 11,
   "firman": "Menjauhlah, menjauhlah! Keluarlah dari sana! Janganlah engkau kena kepada yang najis! Keluarlah dari tengah-tengahnya, sucikanlah dirimu, hai orang-orang yang mengangkat perkakas rumah TUHAN!"
 },
 {
   "id": 18713,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 12,
   "firman": "Sungguh, kamu tidak akan buru-buru keluar dan tidak akan lari-lari berjalan, sebab TUHAN akan berjalan di depanmu, dan Allah Israel akan menjadi penutup barisanmu."
 },
 {
   "id": 18714,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 13,
   "firman": "Sesungguhnya, hamba-Ku akan berhasil, ia akan ditinggikan, disanjung dan dimuliakan."
 },
 {
   "id": 18715,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 14,
   "firman": "Seperti banyak orang akan tertegun melihat dia--begitu buruk rupanya, bukan seperti manusia lagi, dan tampaknya bukan seperti anak manusia lagi--"
 },
 {
   "id": 18716,
   "kitab": "Yes",
   "pasal": 52,
   "ayat": 15,
   "firman": "demikianlah ia akan membuat tercengang banyak bangsa, raja-raja akan mengatupkan mulutnya melihat dia; sebab apa yang tidak diceritakan kepada mereka akan mereka lihat, dan apa yang tidak mereka dengar akan mereka pahami."
 },
 {
   "id": 18717,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 1,
   "firman": "Siapakah yang percaya kepada berita yang kami dengar, dan kepada siapakah tangan kekuasaan TUHAN dinyatakan?"
 },
 {
   "id": 18718,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 2,
   "firman": "Sebagai taruk ia tumbuh di hadapan TUHAN dan sebagai tunas dari tanah kering. Ia tidak tampan dan semaraknyapun tidak ada sehingga kita memandang dia, dan rupapun tidak, sehingga kita menginginkannya."
 },
 {
   "id": 18719,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 3,
   "firman": "Ia dihina dan dihindari orang, seorang yang penuh kesengsaraan dan yang biasa menderita kesakitan; ia sangat dihina, sehingga orang menutup mukanya terhadap dia dan bagi kitapun dia tidak masuk hitungan."
 },
 {
   "id": 18720,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 4,
   "firman": "Tetapi sesungguhnya, penyakit kitalah yang ditanggungnya, dan kesengsaraan kita yang dipikulnya, padahal kita mengira dia kena tulah, dipukul dan ditindas Allah."
 },
 {
   "id": 18721,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 5,
   "firman": "Tetapi dia tertikam oleh karena pemberontakan kita, dia diremukkan oleh karena kejahatan kita; ganjaran yang mendatangkan keselamatan bagi kita ditimpakan kepadanya, dan oleh bilur-bilurnya kita menjadi sembuh."
 },
 {
   "id": 18722,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 6,
   "firman": "Kita sekalian sesat seperti domba, masing-masing kita mengambil jalannya sendiri, tetapi TUHAN telah menimpakan kepadanya kejahatan kita sekalian."
 },
 {
   "id": 18723,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 7,
   "firman": "Dia dianiaya, tetapi dia membiarkan diri ditindas dan tidak membuka mulutnya seperti anak domba yang dibawa ke pembantaian; seperti induk domba yang kelu di depan orang-orang yang menggunting bulunya, ia tidak membuka mulutnya."
 },
 {
   "id": 18724,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 8,
   "firman": "Sesudah penahanan dan penghukuman ia terambil, dan tentang nasibnya siapakah yang memikirkannya? Sungguh, ia terputus dari negeri orang-orang hidup, dan karena pemberontakan umat-Ku ia kena tulah."
 },
 {
   "id": 18725,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 9,
   "firman": "Orang menempatkan kuburnya di antara orang-orang fasik, dan dalam matinya ia ada di antara penjahat-penjahat, sekalipun ia tidak berbuat kekerasan dan tipu tidak ada dalam mulutnya."
 },
 {
   "id": 18726,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 10,
   "firman": "Tetapi TUHAN berkehendak meremukkan dia dengan kesakitan. Apabila ia menyerahkan dirinya sebagai korban penebus salah, ia akan melihat keturunannya, umurnya akan lanjut, dan kehendak TUHAN akan terlaksana olehnya."
 },
 {
   "id": 18727,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 11,
   "firman": "Sesudah kesusahan jiwanya ia akan melihat terang dan menjadi puas; dan hamba-Ku itu, sebagai orang yang benar, akan membenarkan banyak orang oleh hikmatnya, dan kejahatan mereka dia pikul."
 },
 {
   "id": 18728,
   "kitab": "Yes",
   "pasal": 53,
   "ayat": 12,
   "firman": "Sebab itu Aku akan membagikan kepadanya orang-orang besar sebagai rampasan, dan ia akan memperoleh orang-orang kuat sebagai jarahan, yaitu sebagai ganti karena ia telah menyerahkan nyawanya ke dalam maut dan karena ia terhitung di antara pemberontak-pemberontak, sekalipun ia menanggung dosa banyak orang dan berdoa untuk pemberontak-pemberontak."
 },
 {
   "id": 18729,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 1,
   "firman": "Bersorak-sorailah, hai si mandul yang tidak pernah melahirkan! Bergembiralah dengan sorak-sorai dan memekiklah, hai engkau yang tidak pernah menderita sakit bersalin! Sebab yang ditinggalkan suaminya akan mempunyai lebih banyak anak dari pada yang bersuami, firman TUHAN."
 },
 {
   "id": 18730,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 2,
   "firman": "Lapangkanlah tempat kemahmu, dan bentangkanlah tenda tempat kediamanmu, janganlah menghematnya; panjangkanlah tali-tali kemahmu dan pancangkanlah kokoh-kokoh patok-patokmu!"
 },
 {
   "id": 18731,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 3,
   "firman": "Sebab engkau akan mengembang ke kanan dan ke kiri, keturunanmu akan memperoleh tempat bangsa-bangsa, dan akan mendiami kota-kota yang sunyi."
 },
 {
   "id": 18732,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 4,
   "firman": "Janganlah takut, sebab engkau tidak akan mendapat malu, dan janganlah merasa malu, sebab engkau tidak akan tersipu-sipu. Sebab engkau akan melupakan malu keremajaanmu, dan tidak akan mengingat lagi aib kejandaanmu."
 },
 {
   "id": 18733,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 5,
   "firman": "Sebab yang menjadi suamimu ialah Dia yang menjadikan engkau, TUHAN semesta alam nama-Nya; yang menjadi Penebusmu ialah Yang Mahakudus, Allah Israel, Ia disebut Allah seluruh bumi."
 },
 {
   "id": 18734,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 6,
   "firman": "Sebab seperti isteri yang ditinggalkan dan yang bersusah hati TUHAN memanggil engkau kembali; masakan isteri dari masa muda akan tetap ditolak? firman Allahmu."
 },
 {
   "id": 18735,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 7,
   "firman": "Hanya sesaat lamanya Aku meninggalkan engkau, tetapi karena kasih sayang yang besar Aku mengambil engkau kembali."
 },
 {
   "id": 18736,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 8,
   "firman": "Dalam murka yang meluap Aku telah menyembunyikan wajah-Ku terhadap engkau sesaat lamanya, tetapi dalam kasih setia abadi Aku telah mengasihani engkau, firman TUHAN, Penebusmu."
 },
 {
   "id": 18737,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 9,
   "firman": "Keadaan ini bagi-Ku seperti pada zaman Nuh: seperti Aku telah bersumpah kepadanya bahwa air bah tidak akan meliputi bumi lagi, demikianlah Aku telah bersumpah bahwa Aku tidak akan murka terhadap engkau dan tidak akan menghardik engkau lagi."
 },
 {
   "id": 18738,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 10,
   "firman": "Sebab biarpun gunung-gunung beranjak dan bukit-bukit bergoyang, tetapi kasih setia-Ku tidak akan beranjak dari padamu dan perjanjian damai-Ku tidak akan bergoyang, firman TUHAN, yang mengasihani engkau."
 },
 {
   "id": 18739,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 11,
   "firman": "Hai yang tertindas, yang dilanggar angin badai, yang tidak dihiburkan! Sesungguhnya, Aku akan meletakkan alasmu dari batu hitam dan dasar-dasarmu dari batu nilam."
 },
 {
   "id": 18740,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 12,
   "firman": "Aku akan membuat kemuncak-kemuncak tembokmu dari batu delima, pintu-pintu gerbangmu dari batu manikam merah dan segenap tembok perbatasanmu dari batu permata."
 },
 {
   "id": 18741,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 13,
   "firman": "Semua anakmu akan menjadi murid TUHAN, dan besarlah kesejahteraan mereka;"
 },
 {
   "id": 18742,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 14,
   "firman": "engkau akan ditegakkan di atas kebenaran. Engkau akan jauh dari pemerasan, sebab engkau tidak usah lagi takut, dan engkau akan jauh dari kekejutan, sebab ia tidak akan mendekat kepadamu."
 },
 {
   "id": 18743,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 15,
   "firman": "Apabila orang menyerbu, itu bukanlah dari pada-Ku; siapapun yang menyerbu engkau, ia akan rebah melawan engkau."
 },
 {
   "id": 18744,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 16,
   "firman": "Sesungguhnya, Akulah yang menciptakan tukang besi yang menghembus api dan menghasilkan senjata menurut kecakapannya, tetapi Akulah juga yang menciptakan pemusnah untuk merusakkannya."
 },
 {
   "id": 18745,
   "kitab": "Yes",
   "pasal": 54,
   "ayat": 17,
   "firman": "Setiap senjata yang ditempa terhadap engkau tidak akan berhasil, dan setiap orang yang melontarkan tuduhan melawan engkau dalam pengadilan, akan engkau buktikan salah. Inilah yang menjadi bagian hamba-hamba TUHAN dan kebenaran yang mereka terima dari pada-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 18746,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 1,
   "firman": "Ayo, hai semua orang yang haus, marilah dan minumlah air, dan hai orang yang tidak mempunyai uang, marilah! Terimalah gandum tanpa uang pembeli dan makanlah, juga anggur dan susu tanpa bayaran!"
 },
 {
   "id": 18747,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 2,
   "firman": "Mengapakah kamu belanjakan uang untuk sesuatu yang bukan roti, dan upah jerih payahmu untuk sesuatu yang tidak mengenyangkan? Dengarkanlah Aku maka kamu akan memakan yang baik dan kamu akan menikmati sajian yang paling lezat."
 },
 {
   "id": 18748,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 3,
   "firman": "Sendengkanlah telingamu dan datanglah kepada-Ku; dengarkanlah, maka kamu akan hidup! Aku hendak mengikat perjanjian abadi dengan kamu, menurut kasih setia yang teguh yang Kujanjikan kepada Daud."
 },
 {
   "id": 18749,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 4,
   "firman": "Sesungguhnya, Aku telah menetapkan dia menjadi saksi bagi bangsa-bangsa, menjadi seorang raja dan pemerintah bagi suku-suku bangsa;"
 },
 {
   "id": 18750,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 5,
   "firman": "sesungguhnya, engkau akan memanggil bangsa yang tidak kaukenal, dan bangsa yang tidak mengenal engkau akan berlari kepadamu, oleh karena TUHAN, Allahmu, dan karena Yang Mahakudus, Allah Israel, yang mengagungkan engkau."
 },
 {
   "id": 18751,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 6,
   "firman": "Carilah TUHAN selama Ia berkenan ditemui; berserulah kepada-Nya selama Ia dekat!"
 },
 {
   "id": 18752,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 7,
   "firman": "Baiklah orang fasik meninggalkan jalannya, dan orang jahat meninggalkan rancangannya; baiklah ia kembali kepada TUHAN, maka Dia akan mengasihaninya, dan kepada Allah kita, sebab Ia memberi pengampunan dengan limpahnya."
 },
 {
   "id": 18753,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 8,
   "firman": "Sebab rancangan-Ku bukanlah rancanganmu, dan jalanmu bukanlah jalan-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 18754,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 9,
   "firman": "Seperti tingginya langit dari bumi, demikianlah tingginya jalan-Ku dari jalanmu dan rancangan-Ku dari rancanganmu."
 },
 {
   "id": 18755,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 10,
   "firman": "Sebab seperti hujan dan salju turun dari langit dan tidak kembali ke situ, melainkan mengairi bumi, membuatnya subur dan menumbuhkan tumbuh-tumbuhan, memberikan benih kepada penabur dan roti kepada orang yang mau makan,"
 },
 {
   "id": 18756,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 11,
   "firman": "demikianlah firman-Ku yang keluar dari mulut-Ku: ia tidak akan kembali kepada-Ku dengan sia-sia, tetapi ia akan melaksanakan apa yang Kukehendaki, dan akan berhasil dalam apa yang Kusuruhkan kepadanya."
 },
 {
   "id": 18757,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 12,
   "firman": "Sungguh, kamu akan berangkat dengan sukacita dan akan dihantarkan dengan damai; gunung-gunung serta bukit-bukit akan bergembira dan bersorak-sorai di depanmu, dan segala pohon-pohonan di padang akan bertepuk tangan."
 },
 {
   "id": 18758,
   "kitab": "Yes",
   "pasal": 55,
   "ayat": 13,
   "firman": "Sebagai ganti semak duri akan tumbuh pohon sanobar, dan sebagai ganti kecubung akan tumbuh pohon murad, dan itu akan terjadi sebagai kemasyhuran bagi TUHAN, sebagai tanda abadi yang tidak akan lenyap."
 },
 {
   "id": 18759,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: Taatilah hukum dan tegakkanlah keadilan, sebab sebentar lagi akan datang keselamatan yang dari pada-Ku, dan keadilan-Ku akan dinyatakan."
 },
 {
   "id": 18760,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 2,
   "firman": "Berbahagialah orang yang melakukannya, dan anak manusia yang berpegang kepadanya: yang memelihara hari Sabat dan tidak menajiskannya, dan yang menahan diri dari setiap perbuatan jahat."
 },
 {
   "id": 18761,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 3,
   "firman": "Janganlah orang asing yang menggabungkan diri kepada TUHAN berkata: \"Sudah tentu TUHAN hendak memisahkan aku dari pada umat-Nya\"; dan janganlah orang kebiri berkata: \"Sesungguhnya, aku ini pohon yang kering.\""
 },
 {
   "id": 18762,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN: \"Kepada orang-orang kebiri yang memelihara hari-hari Sabat-Ku dan yang memilih apa yang Kukehendaki dan yang berpegang kepada perjanjian-Ku,"
 },
 {
   "id": 18763,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 5,
   "firman": "kepada mereka akan Kuberikan dalam rumah-Ku dan di lingkungan tembok-tembok kediaman-Ku suatu tanda peringatan dan nama--itu lebih baik dari pada anak-anak lelaki dan perempuan--,suatu nama abadi yang tidak akan lenyap akan Kuberikan kepada mereka."
 },
 {
   "id": 18764,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 6,
   "firman": "Dan orang-orang asing yang menggabungkan diri kepada TUHAN untuk melayani Dia, untuk mengasihi nama TUHAN dan untuk menjadi hamba-hamba-Nya, semuanya yang memelihara hari Sabat dan tidak menajiskannya, dan yang berpegang kepada perjanjian-Ku,"
 },
 {
   "id": 18765,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 7,
   "firman": "mereka akan Kubawa ke gunung-Ku yang kudus dan akan Kuberi kesukaan di rumah doa-Ku. Aku akan berkenan kepada korban-korban bakaran dan korban-korban sembelihan mereka yang dipersembahkan di atas mezbah-Ku, sebab rumah-Ku akan disebut rumah doa bagi segala bangsa."
 },
 {
   "id": 18766,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 8,
   "firman": "Demikianlah firman Tuhan ALLAH yang menghimpun orang-orang Israel yang terbuang: Aku akan menghimpunkan orang kepadanya lagi sebagai tambahan kepada orang-orangnya yang telah terhimpun.\""
 },
 {
   "id": 18767,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 9,
   "firman": "Hai segala binatang di padang, hai segala binatang di hutan, datanglah untuk makan!"
 },
 {
   "id": 18768,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 10,
   "firman": "Sebab pengawal-pengawal umat-Ku adalah orang-orang buta, mereka semua tidak tahu apa-apa; mereka semua adalah anjing-anjing bisu, tidak tahu menyalak; mereka berbaring melamun dan suka tidur saja;"
 },
 {
   "id": 18769,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 11,
   "firman": "anjing-anjing pelahap, yang tidak tahu kenyang. Dan orang-orang itulah gembala-gembala, yang tidak dapat mengerti! Mereka semua mengambil jalannya sendiri, masing-masing mengejar laba, tiada yang terkecuali."
 },
 {
   "id": 18770,
   "kitab": "Yes",
   "pasal": 56,
   "ayat": 12,
   "firman": "\"Datanglah,\" kata mereka, \"aku akan mengambil anggur, baiklah kita minum arak banyak-banyak; besok akan sama seperti hari ini, dan lebih hebat lagi!\""
 },
 {
   "id": 18771,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 1,
   "firman": "Orang benar binasa, dan tidak ada seorangpun yang memperhatikannya; orang-orang saleh tercabut nyawanya, dan tidak ada seorangpun yang mengindahkannya; sungguh, karena merajalelanya kejahatan, tercabutlah nyawa orang benar"
 },
 {
   "id": 18772,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 2,
   "firman": "dan ia masuk ke tempat damai; orang-orang yang hidup dengan lurus hati mendapat perhentian di atas tempat tidurnya."
 },
 {
   "id": 18773,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 3,
   "firman": "Tetapi kamu, mendekatlah kamu ke mari, hai anak-anak dari perempuan-perempuan sihir, hai keturunan orang yang berzinah dan perempuan sundal!"
 },
 {
   "id": 18774,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 4,
   "firman": "Tentang siapakah kamu berkelakar, terhadap siapakah kamu melontarkan kata-kata yang bukan-bukan dan mengejeknya? Bukankah kamu ini anak-anak pemberontak, keturunan pendusta,"
 },
 {
   "id": 18775,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 5,
   "firman": "hai orang-orang yang terbakar oleh hawa nafsu dekat pohon-pohon keramat, di bawah setiap pohon yang rimbun, hai orang-orang yang menyembelih anak-anak di lembah-lembah, di dalam celah-celah bukit batu."
 },
 {
   "id": 18776,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 6,
   "firman": "Padamu hanya ada batu-batu licin dari sungai, dan hanya itu sajalah yang ditentukan bagimu; kepada mereka juga engkau mengunjukkan korban curahan, dan mempersembahkan korban sajian. Masakan Aku sabar akan hal itu?"
 },
 {
   "id": 18777,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 7,
   "firman": "Engkau menaruh petiduranmu di atas gunung yang tinggi dan menjulang dan ke atas gunung itu juga engkau naik untuk mempersembahkan korban sembelihan."
 },
 {
   "id": 18778,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 8,
   "firman": "Engkau telah menaruh lambang berhalamu di ambang pintu masuk rumahmu, ya, engkau telah meninggalkan Aku dan menelanjangi dirimu, engkau telah menaiki petiduranmu dan telah melebarkannya; engkau telah mengadakan janji dengan beberapa orang yang kauingini untuk tidur bersama-sama mereka dan engkau memandangi lingga."
 },
 {
   "id": 18779,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 9,
   "firman": "Engkau datang menghadap Molokh dengan membawa minyak dan banyak-banyak wangi-wangian; engkau menyuruh duta-dutamu pergi sampai jauh, dan sampai ke bawah di dunia orang mati."
 },
 {
   "id": 18780,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 10,
   "firman": "Oleh perjalananmu yang jauh engkau sudah letih lesu, tetapi engkau tidak berkata: \"Tidak ada harapan!\" Engkau mendapat kekuatan yang baru, dan sebab itu engkau tidak menjadi lemah."
 },
 {
   "id": 18781,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 11,
   "firman": "Kepada siapa gerangan engkau gentar dan takut, sehingga engkau berdusta dan tidak mengingat Aku atau memberi perhatian kepada-Ku? Bukankah karena Aku membisu dan menutup mata, maka engkau tidak takut kepada-Ku!"
 },
 {
   "id": 18782,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 12,
   "firman": "Aku akan menyebutkan kesalehanmu dan segala perbuatanmu, tetapi semuanya itu tidak akan berguna bagimu:"
 },
 {
   "id": 18783,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 13,
   "firman": "apabila engkau berteriak, biarlah berhala-berhalamu melepaskan engkau! Mereka semua akan ditiup angin, akan diterbangkan hembusan nafas. Tetapi orang yang berlindung kepada-Ku akan mewarisi negeri dan akan memiliki gunung-Ku yang kudus."
 },
 {
   "id": 18784,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 14,
   "firman": "Ada yang berkata: \"Bukalah, bukalah, persiapkanlah jalan, angkatlah batu sandungan dari jalan umat-Ku!\""
 },
 {
   "id": 18785,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 15,
   "firman": "Sebab beginilah firman Yang Mahatinggi dan Yang Mahamulia, yang bersemayam untuk selamanya dan Yang Mahakudus nama-Nya: \"Aku bersemayam di tempat tinggi dan di tempat kudus tetapi juga bersama-sama orang yang remuk dan rendah hati, untuk menghidupkan semangat orang-orang yang rendah hati dan untuk menghidupkan hati orang-orang yang remuk."
 },
 {
   "id": 18786,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 16,
   "firman": "Sebab bukan untuk selama-lamanya Aku hendak berbantah, dan bukan untuk seterusnya Aku hendak murka, supaya semangat mereka jangan lemah lesu di hadapan-Ku, padahal Akulah yang membuat nafas kehidupan."
 },
 {
   "id": 18787,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 17,
   "firman": "Aku murka karena kesalahan kelobaannya, Aku menghajar dia, menyembunyikan wajah-Ku dan murka, tetapi dengan murtad ia menempuh jalan yang dipilih hatinya."
 },
 {
   "id": 18788,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 18,
   "firman": "Aku telah melihat segala jalannya itu, tetapi Aku akan menyembuhkan dan akan menuntun dia dan akan memulihkan dia dengan penghiburan; juga pada bibir orang-orangnya yang berkabung"
 },
 {
   "id": 18789,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 19,
   "firman": "Aku akan menciptakan puji-pujian. Damai, damai sejahtera bagi mereka yang jauh dan bagi mereka yang dekat--firman TUHAN--Aku akan menyembuhkan dia!"
 },
 {
   "id": 18790,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 20,
   "firman": "Tetapi orang-orang fasik adalah seperti laut yang berombak-ombak sebab tidak dapat tetap tenang, dan arusnya menimbulkan sampah dan lumpur."
 },
 {
   "id": 18791,
   "kitab": "Yes",
   "pasal": 57,
   "ayat": 21,
   "firman": "Tiada damai bagi orang-orang fasik itu,\" firman Allahku."
 },
 {
   "id": 18792,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 1,
   "firman": "Serukanlah kuat-kuat, janganlah tahan-tahan! Nyaringkanlah suaramu bagaikan sangkakala, beritahukanlah kepada umat-Ku pelanggaran mereka dan kepada kaum keturunan Yakub dosa mereka!"
 },
 {
   "id": 18793,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 2,
   "firman": "Memang setiap hari mereka mencari Aku dan suka untuk mengenal segala jalan-Ku. Seperti bangsa yang melakukan yang benar dan yang tidak meninggalkan hukum Allahnya mereka menanyakan Aku tentang hukum-hukum yang benar, mereka suka mendekat menghadap Allah, tanyanya:"
 },
 {
   "id": 18794,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 3,
   "firman": "\"Mengapa kami berpuasa dan Engkau tidak memperhatikannya juga? Mengapa kami merendahkan diri dan Engkau tidak mengindahkannya juga?\" Sesungguhnya, pada hari puasamu engkau masih tetap mengurus urusanmu, dan kamu mendesak-desak semua buruhmu."
 },
 {
   "id": 18795,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 4,
   "firman": "Sesungguhnya, kamu berpuasa sambil berbantah dan berkelahi serta memukul dengan tinju dengan tidak semena-mena. Dengan caramu berpuasa seperti sekarang ini suaramu tidak akan didengar di tempat tinggi."
 },
 {
   "id": 18796,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 5,
   "firman": "Sungguh-sungguh inikah berpuasa yang Kukehendaki, dan mengadakan hari merendahkan diri, jika engkau menundukkan kepala seperti gelagah dan membentangkan kain karung dan abu sebagai lapik tidur? Sungguh-sungguh itukah yang kausebutkan berpuasa, mengadakan hari yang berkenan pada TUHAN?"
 },
 {
   "id": 18797,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 6,
   "firman": "Bukan! Berpuasa yang Kukehendaki, ialah supaya engkau membuka belenggu-belenggu kelaliman, dan melepaskan tali-tali kuk, supaya engkau memerdekakan orang yang teraniaya dan mematahkan setiap kuk,"
 },
 {
   "id": 18798,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 7,
   "firman": "supaya engkau memecah-mecah rotimu bagi orang yang lapar dan membawa ke rumahmu orang miskin yang tak punya rumah, dan apabila engkau melihat orang telanjang, supaya engkau memberi dia pakaian dan tidak menyembunyikan diri terhadap saudaramu sendiri!"
 },
 {
   "id": 18799,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 8,
   "firman": "Pada waktu itulah terangmu akan merekah seperti fajar dan lukamu akan pulih dengan segera; kebenaran menjadi barisan depanmu dan kemuliaan TUHAN barisan belakangmu."
 },
 {
   "id": 18800,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 9,
   "firman": "Pada waktu itulah engkau akan memanggil dan TUHAN akan menjawab, engkau akan berteriak minta tolong dan Ia akan berkata: Ini Aku! Apabila engkau tidak lagi mengenakan kuk kepada sesamamu dan tidak lagi menunjuk-nunjuk orang dengan jari dan memfitnah,"
 },
 {
   "id": 18801,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 10,
   "firman": "apabila engkau menyerahkan kepada orang lapar apa yang kauinginkan sendiri dan memuaskan hati orang yang tertindas maka terangmu akan terbit dalam gelap dan kegelapanmu akan seperti rembang tengah hari."
 },
 {
   "id": 18802,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 11,
   "firman": "TUHAN akan menuntun engkau senantiasa dan akan memuaskan hatimu di tanah yang kering, dan akan membaharui kekuatanmu; engkau akan seperti taman yang diairi dengan baik dan seperti mata air yang tidak pernah mengecewakan."
 },
 {
   "id": 18803,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 12,
   "firman": "Engkau akan membangun reruntuhan yang sudah berabad-abad, dan akan memperbaiki dasar yang diletakkan oleh banyak keturunan. Engkau akan disebutkan \"yang memperbaiki tembok yang tembus\", \"yang membetulkan jalan supaya tempat itu dapat dihuni\"."
 },
 {
   "id": 18804,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 13,
   "firman": "Apabila engkau tidak menginjak-injak hukum Sabat dan tidak melakukan urusanmu pada hari kudus-Ku; apabila engkau menyebutkan hari Sabat \"hari kenikmatan\", dan hari kudus TUHAN \"hari yang mulia\"; apabila engkau menghormatinya dengan tidak menjalankan segala acaramu dan dengan tidak mengurus urusanmu atau berkata omong kosong,"
 },
 {
   "id": 18805,
   "kitab": "Yes",
   "pasal": 58,
   "ayat": 14,
   "firman": "maka engkau akan bersenang-senang karena TUHAN, dan Aku akan membuat engkau melintasi puncak bukit-bukit di bumi dengan kendaraan kemenangan; Aku akan memberi makan engkau dari milik pusaka Yakub, bapa leluhurmu, sebab mulut Tuhanlah yang mengatakannya."
 },
 {
   "id": 18806,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 1,
   "firman": "Sesungguhnya, tangan TUHAN tidak kurang panjang untuk menyelamatkan, dan pendengaran-Nya tidak kurang tajam untuk mendengar;"
 },
 {
   "id": 18807,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 2,
   "firman": "tetapi yang merupakan pemisah antara kamu dan Allahmu ialah segala kejahatanmu, dan yang membuat Dia menyembunyikan diri terhadap kamu, sehingga Ia tidak mendengar, ialah segala dosamu."
 },
 {
   "id": 18808,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 3,
   "firman": "Sebab tanganmu cemar oleh darah dan jarimu oleh kejahatan; mulutmu mengucapkan dusta, lidahmu menyebut-nyebut kecurangan."
 },
 {
   "id": 18809,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 4,
   "firman": "Tidak ada yang mengajukan pengaduan dengan alasan benar, dan tidak ada yang menghakimi dengan alasan teguh; orang mengandalkan kesia-siaan dan mengucapkan dusta, orang mengandung bencana dan melahirkan kelaliman."
 },
 {
   "id": 18810,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 5,
   "firman": "Mereka menetaskan telur ular beludak, dan menenun sarang laba-laba; siapa yang makan dari telurnya itu akan mati, dan apabila sebutir ditekan pecah, keluarlah seekor ular beludak."
 },
 {
   "id": 18811,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 6,
   "firman": "Sarang yang ditenun itu tidak dapat dipergunakan sebagai pakaian, dan buatan mereka itu tidak dapat dipakai sebagai kain; perbuatan mereka adalah perbuatan kelaliman, dan yang dikerjakan tangan mereka adalah kekerasan belaka."
 },
 {
   "id": 18812,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 7,
   "firman": "Mereka segera melakukan kejahatan, dan bersegera hendak menumpahkan darah orang yang tidak bersalah; rancangan mereka adalah rancangan kelaliman, dan ke mana saja mereka pergi mereka meninggalkan kebinasaan dan keruntuhan."
 },
 {
   "id": 18813,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 8,
   "firman": "Mereka tidak mengenal jalan damai, dan dalam jejak mereka tidak ada keadilan; mereka mengambil jalan-jalan yang bengkok, dan setiap orang yang berjalan di situ tidaklah mengenal damai."
 },
 {
   "id": 18814,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 9,
   "firman": "Sebab itu keadilan tetap jauh dari pada kami dan kebenaran tidak sampai kepada kami. Kami menanti-nantikan terang, tetapi hanya kegelapan belaka, menanti-nantikan cahaya, tetapi kami berjalan dalam kekelaman."
 },
 {
   "id": 18815,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 10,
   "firman": "Kami meraba-raba dinding seperti orang buta, dan meraba-raba seolah-olah tidak punya mata; kami tersandung di waktu tengah hari seperti di waktu senja, duduk di tempat gelap seperti orang mati."
 },
 {
   "id": 18816,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 11,
   "firman": "Kami sekalian meraung seperti beruang; suara kami redup seperti suara burung merpati; kami menanti-nantikan keadilan, tetapi tidak ada, menanti-nantikan keselamatan, tetapi tetap jauh dari kami."
 },
 {
   "id": 18817,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 12,
   "firman": "Sungguh, dosa pemberontakan kami banyak di hadapan-Mu dan dosa kami bersaksi melawan kami; sungguh, kami menyadari pemberontakan kami dan kami mengenal kejahatan kami:"
 },
 {
   "id": 18818,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 13,
   "firman": "kami telah memberontak dan mungkir terhadap TUHAN, dan berbalik dari mengikuti Allah kami, kami merancangkan pemerasan dan penyelewengan, mengandung dusta dalam hati dan melahirkannya dalam kata-kata."
 },
 {
   "id": 18819,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 14,
   "firman": "Hukum telah terdesak ke belakang, dan keadilan berdiri jauh-jauh, sebab kebenaran tersandung di tempat umum dan ketulusan ditolak orang."
 },
 {
   "id": 18820,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 15,
   "firman": "Dengan demikian kebenaran telah hilang, dan siapa yang menjauhi kejahatan, ia menjadi korban rampasan. Tetapi TUHAN melihatnya, dan adalah jahat di mata-Nya bahwa tidak ada hukum."
 },
 {
   "id": 18821,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 16,
   "firman": "Ia melihat bahwa tidak seorangpun yang tampil, dan Ia tertegun karena tidak ada yang membela. Maka tangan-Nya sendiri memberi Dia pertolongan, dan keadilan-Nyalah yang membantu Dia."
 },
 {
   "id": 18822,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 17,
   "firman": "Ia mengenakan keadilan sebagai baju zirah dan ketopong keselamatan ada di kepala-Nya; Ia mengenakan pakaian pembalasan dan menyelubungkan kecemburuan sebagai jubah."
 },
 {
   "id": 18823,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 18,
   "firman": "Sesuai dengan perbuatan-perbuatan orang, demikianlah Ia memberi pembalasan: kehangatan murka kepada lawan-lawan-Nya, ganjaran kepada musuh-musuh-Nya; bahkan kepada pulau-pulau yang jauh Ia memberi ganjaran."
 },
 {
   "id": 18824,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 19,
   "firman": "Maka orang akan takut kepada nama TUHAN di tempat matahari terbenam dan kepada kemuliaan-Nya di tempat matahari terbit, sebab Ia akan datang seperti arus dari tempat yang sempit, yang didorong oleh nafas TUHAN."
 },
 {
   "id": 18825,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 20,
   "firman": "Dan Ia akan datang sebagai Penebus untuk Sion dan untuk orang-orang Yakub yang bertobat dari pemberontakannya, demikianlah firman TUHAN."
 },
 {
   "id": 18826,
   "kitab": "Yes",
   "pasal": 59,
   "ayat": 21,
   "firman": "Adapun Aku, inilah perjanjian-Ku dengan mereka, firman TUHAN: Roh-Ku yang menghinggapi engkau dan firman-Ku yang Kutaruh dalam mulutmu tidak akan meninggalkan mulutmu dan mulut keturunanmu dan mulut keturunan mereka, dari sekarang sampai selama-lamanya, firman TUHAN."
 },
 {
   "id": 18827,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 1,
   "firman": "Bangkitlah, menjadi teranglah, sebab terangmu datang, dan kemuliaan TUHAN terbit atasmu."
 },
 {
   "id": 18828,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 2,
   "firman": "Sebab sesungguhnya, kegelapan menutupi bumi, dan kekelaman menutupi bangsa-bangsa; tetapi terang TUHAN terbit atasmu, dan kemuliaan-Nya menjadi nyata atasmu."
 },
 {
   "id": 18829,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 3,
   "firman": "Bangsa-bangsa berduyun-duyun datang kepada terangmu, dan raja-raja kepada cahaya yang terbit bagimu."
 },
 {
   "id": 18830,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 4,
   "firman": "Angkatlah mukamu dan lihatlah ke sekeliling, mereka semua datang berhimpun kepadamu; anak-anakmu laki-laki datang dari jauh, dan anak-anakmu perempuan digendong."
 },
 {
   "id": 18831,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 5,
   "firman": "Pada waktu itu engkau akan heran melihat dan berseri-seri, engkau akan tercengang dan akan berbesar hati, sebab kelimpahan dari seberang laut akan beralih kepadamu, dan kekayaan bangsa-bangsa akan datang kepadamu."
 },
 {
   "id": 18832,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 6,
   "firman": "Sejumlah besar unta akan menutupi daerahmu, unta-unta muda dari Midian dan Efa. Mereka semua akan datang dari Syeba, akan membawa emas dan kemenyan, serta memberitakan perbuatan masyhur TUHAN."
 },
 {
   "id": 18833,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 7,
   "firman": "Segala kambing domba Kedar akan berhimpun kepadamu, domba-domba jantan Nebayot akan tersedia untuk ibadahmu; semuanya akan dipersembahkan di atas mezbah-Ku sebagai korban yang berkenan kepada-Ku, dan Aku akan menyemarakkan rumah keagungan-Ku."
 },
 {
   "id": 18834,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 8,
   "firman": "Siapakah mereka ini yang melayang seperti awan dan seperti burung merpati ke pintu kandangnya?"
 },
 {
   "id": 18835,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 9,
   "firman": "Sungguh, Akulah yang dinanti-nantikan pulau-pulau yang jauh; kapal-kapal Tarsis berlayar di depan untuk membawa anak-anakmu laki-laki dari jauh, perak dan emasnya dibawa serta, untuk nama TUHAN, Allahmu, dan oleh karena Yang Mahakudus, Allah Israel, sebab Ia mengagungkan engkau."
 },
 {
   "id": 18836,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 10,
   "firman": "Orang-orang asing akan membangun tembokmu, dan raja-raja mereka akan melayani engkau; sebab dalam murka-Ku Aku telah menghajar engkau, namun Aku telah berkenan untuk mengasihani engkau."
 },
 {
   "id": 18837,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 11,
   "firman": "Pintu-pintu gerbangmu akan terbuka senantiasa, baik siang maupun malam tidak akan tertutup, supaya orang dapat membawa kekayaan bangsa-bangsa kepadamu, sedang raja-raja mereka ikut digiring sebagai tawanan."
 },
 {
   "id": 18838,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 12,
   "firman": "Sungguh, bangsa dan kerajaan yang tidak mau mengabdi kepadamu akan lenyap; bangsa-bangsa itu akan dirusakbinasakan."
 },
 {
   "id": 18839,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 13,
   "firman": "Kemuliaan Libanon, yaitu pohon sanobar, pohon berangan dan pohon cemara, akan dibawa bersama-sama kepadamu, untuk mempersemarak tempat bait kudus-Ku, sebab Aku hendak memuliakan tempat kaki-Ku berjejak."
 },
 {
   "id": 18840,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 14,
   "firman": "Anak-anak orang-orang yang menindas engkau akan datang kepadamu dan tunduk, dan semua orang yang menista engkau akan sujud menyembah telapak kakimu; mereka akan menyebutkan engkau \"kota TUHAN\", \"Sion, milik Yang Mahakudus, Allah Israel.\""
 },
 {
   "id": 18841,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 15,
   "firman": "Sebagai ganti keadaanmu dahulu, ketika engkau ditinggalkan, dibenci dan tidak disinggahi seorangpun, sekarang Aku akan membuat engkau menjadi kebanggaan abadi, menjadi kegirangan turun-temurun."
 },
 {
   "id": 18842,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 16,
   "firman": "Engkau akan mengisap susu bangsa-bangsa dan akan meminum susu kerajaan-kerajaan maka engkau akan mengetahui, bahwa Akulah, TUHAN, Juruselamatmu, dan Penebusmu, Yang Mahakuasa, Allah Yakub."
 },
 {
   "id": 18843,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 17,
   "firman": "Sebagai ganti tembaga Aku akan membawa emas, dan sebagai ganti besi Aku akan membawa perak, sebagai ganti kayu, tembaga, dan sebagai ganti batu, besi; Aku akan memberikan damai sejahtera dan keadilan yang akan melindungi dan mengatur hidupmu."
 },
 {
   "id": 18844,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 18,
   "firman": "Tidak akan ada lagi kabar tentang perbuatan kekerasan di negerimu, tentang kebinasaan atau keruntuhan di daerahmu; engkau akan menyebutkan tembokmu \"Selamat\" dan pintu-pintu gerbangmu \"Pujian\"."
 },
 {
   "id": 18845,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 19,
   "firman": "Bagimu matahari tidak lagi menjadi penerang pada siang hari dan cahaya bulan tidak lagi memberi terang pada malam hari, tetapi TUHAN akan menjadi penerang abadi bagimu dan Allahmu akan menjadi keagunganmu."
 },
 {
   "id": 18846,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 20,
   "firman": "Bagimu akan ada matahari yang tidak pernah terbenam dan bulan yang tidak surut, sebab TUHAN akan menjadi penerang abadi bagimu, dan hari-hari perkabunganmu akan berakhir."
 },
 {
   "id": 18847,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 21,
   "firman": "Pendudukmu semuanya orang-orang benar, mereka memiliki negeri untuk selama-lamanya; mereka sebagai cangkokan yang Kutanam sendiri untuk memperlihatkan keagungan-Ku."
 },
 {
   "id": 18848,
   "kitab": "Yes",
   "pasal": 60,
   "ayat": 22,
   "firman": "Yang paling kecil akan menjadi kaum yang besar, dan yang paling lemah akan menjadi bangsa yang kuat; Aku, TUHAN, akan melaksanakannya dengan segera pada waktunya."
 },
 {
   "id": 18849,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 1,
   "firman": "Roh Tuhan ALLAH ada padaku, oleh karena TUHAN telah mengurapi aku; Ia telah mengutus aku untuk menyampaikan kabar baik kepada orang-orang sengsara, dan merawat orang-orang yang remuk hati, untuk memberitakan pembebasan kepada orang-orang tawanan, dan kepada orang-orang yang terkurung kelepasan dari penjara,"
 },
 {
   "id": 18850,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 2,
   "firman": "untuk memberitakan tahun rahmat TUHAN dan hari pembalasan Allah kita, untuk menghibur semua orang berkabung,"
 },
 {
   "id": 18851,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 3,
   "firman": "untuk mengaruniakan kepada mereka perhiasan kepala ganti abu, minyak untuk pesta ganti kain kabung, nyanyian puji-pujian ganti semangat yang pudar, supaya orang menyebutkan mereka \"pohon tarbantin kebenaran\", \"tanaman TUHAN\" untuk memperlihatkan keagungan-Nya."
 },
 {
   "id": 18852,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 4,
   "firman": "Mereka akan membangun reruntuhan yang sudah berabad-abad, dan akan mendirikan kembali tempat-tempat yang sejak dahulu menjadi sunyi; mereka akan membaharui kota-kota yang runtuh, tempat-tempat yang telah turun-temurun menjadi sunyi."
 },
 {
   "id": 18853,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 5,
   "firman": "Orang-orang luar akan melayani kamu sebagai gembala kambing dombamu, dan orang-orang asing akan bekerja bagimu sebagai petani dan tukang kebun anggurmu."
 },
 {
   "id": 18854,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 6,
   "firman": "Tetapi kamu akan disebut imam TUHAN dan akan dinamai pelayan Allah kita. Kamu akan menikmati kekayaan bangsa-bangsa dan akan memegahkan diri dengan segala harta benda mereka."
 },
 {
   "id": 18855,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 7,
   "firman": "Sebagai ganti bahwa kamu mendapat malu dua kali lipat, dan sebagai ganti noda dan ludah yang menjadi bagianmu, kamu akan mendapat warisan dua kali lipat di negerimu dan sukacita abadi akan menjadi kepunyaanmu."
 },
 {
   "id": 18856,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 8,
   "firman": "Sebab Aku, TUHAN, mencintai hukum, dan membenci perampasan dan kecurangan; Aku akan memberi upahmu dengan tepat, dan akan mengikat perjanjian abadi dengan kamu."
 },
 {
   "id": 18857,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 9,
   "firman": "Keturunanmu akan terkenal di antara bangsa-bangsa, dan anak cucumu di tengah-tengah suku-suku bangsa, sehingga semua orang yang melihat mereka akan mengakui, bahwa mereka adalah keturunan yang diberkati TUHAN."
 },
 {
   "id": 18858,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 10,
   "firman": "Aku bersukaria di dalam TUHAN, jiwaku bersorak-sorai di dalam Allahku, sebab Ia mengenakan pakaian keselamatan kepadaku dan menyelubungi aku dengan jubah kebenaran, seperti pengantin laki-laki yang mengenakan perhiasan kepala dan seperti pengantin perempuan yang memakai perhiasannya."
 },
 {
   "id": 18859,
   "kitab": "Yes",
   "pasal": 61,
   "ayat": 11,
   "firman": "Sebab seperti bumi memancarkan tumbuh-tumbuhan, dan seperti kebun menumbuhkan benih yang ditaburkan, demikianlah Tuhan ALLAH akan menumbuhkan kebenaran dan puji-pujian di depan semua bangsa-bangsa."
 },
 {
   "id": 18860,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 1,
   "firman": "Oleh karena Sion aku tidak dapat berdiam diri, dan oleh karena Yerusalem aku tidak akan tinggal tenang, sampai kebenarannya bersinar seperti cahaya dan keselamatannya menyala seperti suluh."
 },
 {
   "id": 18861,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 2,
   "firman": "Maka bangsa-bangsa akan melihat kebenaranmu, dan semua raja akan melihat kemuliaanmu, dan orang akan menyebut engkau dengan nama baru yang akan ditentukan oleh TUHAN sendiri."
 },
 {
   "id": 18862,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 3,
   "firman": "Engkau akan menjadi mahkota keagungan di tangan TUHAN dan serban kerajaan di tangan Allahmu."
 },
 {
   "id": 18863,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 4,
   "firman": "Engkau tidak akan disebut lagi \"yang ditinggalkan suami\", dan negerimu tidak akan disebut lagi \"yang sunyi\", tetapi engkau akan dinamai \"yang berkenan kepada-Ku\" dan negerimu \"yang bersuami\", sebab TUHAN telah berkenan kepadamu, dan negerimu akan bersuami."
 },
 {
   "id": 18864,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 5,
   "firman": "Sebab seperti seorang muda belia menjadi suami seorang anak dara, demikianlah Dia yang membangun engkau akan menjadi suamimu, dan seperti girang hatinya seorang mempelai melihat pengantin perempuan, demikianlah Allahmu akan girang hati atasmu."
 },
 {
   "id": 18865,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 6,
   "firman": "Di atas tembok-tembokmu, hai Yerusalem, telah Kutempatkan pengintai-pengintai. Sepanjang hari dan sepanjang malam, mereka tidak akan pernah berdiam diri. Hai kamu yang harus mengingatkan TUHAN kepada Sion, janganlah kamu tinggal tenang"
 },
 {
   "id": 18866,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 7,
   "firman": "dan janganlah biarkan Dia tinggal tenang, sampai Ia menegakkan Yerusalem dan sampai Ia membuatnya menjadi kemasyhuran di bumi."
 },
 {
   "id": 18867,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 8,
   "firman": "TUHAN telah bersumpah demi tangan kanan-Nya, demi tangan kekuatan-Nya: \"Sesungguhnya, Aku tidak akan memberi gandummu lagi sebagai makanan kepada musuhmu, dan sesungguhnya, orang-orang asing tidak akan meminum air anggurmu yang telah kauhasilkan dengan bersusah-susah;"
 },
 {
   "id": 18868,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 9,
   "firman": "tetapi orang yang menuainya akan memakannya juga dan akan memuji-muji TUHAN, dan orang yang mengumpulkannya akan meminumnya juga di pelataran-pelataran tempat kudus-Ku.\""
 },
 {
   "id": 18869,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 10,
   "firman": "Berjalanlah, berjalanlah melalui pintu-pintu gerbang, persiapkanlah jalan bagi umat, bukalah, bukalah jalan raya, singkirkanlah batu-batu, tegakkanlah panji-panji untuk bangsa-bangsa!"
 },
 {
   "id": 18870,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 11,
   "firman": "Sebab inilah yang telah diperdengarkan TUHAN sampai ke ujung bumi! Katakanlah kepada puteri Sion: Sesungguhnya, keselamatanmu datang; sesungguhnya, mereka yang menjadi upah jerih payah-Nya ada bersama-sama Dia dan mereka yang diperoleh-Nya berjalan di hadapan-Nya."
 },
 {
   "id": 18871,
   "kitab": "Yes",
   "pasal": 62,
   "ayat": 12,
   "firman": "Orang akan menyebutkan mereka \"bangsa kudus\", \"orang-orang tebusan TUHAN\", dan engkau akan disebutkan \"yang dicari\", \"kota yang tidak ditinggalkan\"."
 },
 {
   "id": 18872,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 1,
   "firman": "\"Siapa dia yang datang dari Edom, yang datang dari Bozra dengan baju yang merah, dia yang bersemarak dengan pakaiannya, yang melangkah dengan kekuatannya yang besar?\" \"Akulah yang menjanjikan keadilan dan yang berkuasa untuk menyelamatkan!\""
 },
 {
   "id": 18873,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 2,
   "firman": "\"Mengapakah pakaian-Mu semerah itu, dan baju-Mu seperti baju pengirik buah anggur?\""
 },
 {
   "id": 18874,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 3,
   "firman": "\"Aku seorang dirilah yang melakukan pengirikan, dan dari antara umat-Ku tidak ada yang menemani Aku! Aku telah mengirik bangsa-bangsa dalam murka-Ku, dan Aku telah menginjak-injak mereka dalam kehangatan amarah-Ku; semburan darah mereka memercik kepada baju-Ku, dan seluruh pakaian-Ku telah cemar."
 },
 {
   "id": 18875,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 4,
   "firman": "Sebab hari pembalasan telah Kurencanakan dan tahun penuntutan bela telah datang."
 },
 {
   "id": 18876,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 5,
   "firman": "Aku melayangkan pandangan-Ku: tidak ada yang menolong; Aku tertegun: tidak ada yang membantu. Lalu tangan-Ku memberi Aku pertolongan, dan kehangatan amarah-Ku, itulah yang membantu Aku."
 },
 {
   "id": 18877,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 6,
   "firman": "Aku memijak-mijak bangsa-bangsa dalam murka-Ku, menghancurkan mereka dalam kehangatan amarah-Ku dan membuat semburan darah mereka mengalir ke tanah.\""
 },
 {
   "id": 18878,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 7,
   "firman": "Aku hendak menyebut-nyebut perbuatan kasih setia TUHAN, perbuatan TUHAN yang masyhur, sesuai dengan segala yang dilakukan TUHAN kepada kita, dan kebajikan yang besar kepada kaum Israel yang dilakukan-Nya kepada mereka sesuai dengan kasih sayang-Nya dan sesuai dengan kasih setia-Nya yang besar."
 },
 {
   "id": 18879,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 8,
   "firman": "Bukankah Ia berfirman: \"Sungguh, merekalah umat-Ku, anak-anak yang tidak akan berlaku curang,\" maka Ia menjadi Juruselamat mereka"
 },
 {
   "id": 18880,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 9,
   "firman": "dalam segala kesesakan mereka. Bukan seorang duta atau utusan, melainkan Ia sendirilah yang menyelamatkan mereka; Dialah yang menebus mereka dalam kasih-Nya dan belas kasihan-Nya. Ia mengangkat dan menggendong mereka selama zaman dahulu kala."
 },
 {
   "id": 18881,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 10,
   "firman": "Tetapi mereka memberontak dan mendukakan Roh Kudus-Nya; maka Ia berubah menjadi musuh mereka, dan Ia sendiri berperang melawan mereka."
 },
 {
   "id": 18882,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 11,
   "firman": "Lalu teringatlah mereka kepada zaman dahulu kala, zaman Musa, hamba-Nya itu: Di manakah Dia yang membawa mereka naik dari laut bersama-sama dengan penggembala kambing domba-Nya? Di manakah Dia yang menaruh Roh Kudus-Nya dalam hati mereka;"
 },
 {
   "id": 18883,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 12,
   "firman": "yang dengan tangan-Nya yang agung menyertai Musa di sebelah kanan; yang membelah air di depan mereka untuk membuat nama abadi bagi-Nya;"
 },
 {
   "id": 18884,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 13,
   "firman": "yang menuntun mereka melintasi samudera raya seperti kuda melintasi padang gurun? Mereka tidak pernah tersandung,"
 },
 {
   "id": 18885,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 14,
   "firman": "seperti ternak yang turun ke dalam lembah. Roh TUHAN membawa mereka ke tempat perhentian. Demikianlah Engkau memimpin umat-Mu untuk membuat nama yang agung bagi-Mu."
 },
 {
   "id": 18886,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 15,
   "firman": "Pandanglah dari sorga dan lihatlah dari kediaman-Mu yang kudus dan agung! Di manakah kecemburuan-Mu dan keperkasaan-Mu, hati-Mu yang tergerak dan kasih sayang-Mu? Janganlah kiranya Engkau menahan diri!"
 },
 {
   "id": 18887,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 16,
   "firman": "Bukankah Engkau Bapa kami? Sungguh, Abraham tidak tahu apa-apa tentang kami, dan Israel tidak mengenal kami. Ya TUHAN, Engkau sendiri Bapa kami; nama-Mu ialah \"Penebus kami\" sejak dahulu kala."
 },
 {
   "id": 18888,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 17,
   "firman": "Ya TUHAN, mengapa Engkau biarkan kami sesat dari jalan-Mu, dan mengapa Engkau tegarkan hati kami, sehingga tidak takut kepada-Mu? Kembalilah oleh karena hamba-hamba-Mu, oleh karena suku-suku milik kepunyaan-Mu!"
 },
 {
   "id": 18889,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 18,
   "firman": "Mengapa orang-orang fasik menghina tempat kudus-Mu, para lawan kami memijak-mijak bait kudus-Mu?"
 },
 {
   "id": 18890,
   "kitab": "Yes",
   "pasal": 63,
   "ayat": 19,
   "firman": "Keadaan kami seolah-olah kami dari dahulu kala tidak pernah berada di bawah pemerintahan-Mu, seolah-olah nama-Mu tidak pernah disebut atas kami."
 },
 {
   "id": 18891,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 1,
   "firman": "Sekiranya Engkau mengoyakkan langit dan Engkau turun, sehingga gunung-gunung goyang di hadapan-Mu"
 },
 {
   "id": 18892,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 2,
   "firman": "--seperti api membuat ranggas menyala-nyala dan seperti api membuat air mendidih--untuk membuat nama-Mu dikenal oleh lawan-lawan-Mu, sehingga bangsa-bangsa gemetar di hadapan-Mu,"
 },
 {
   "id": 18893,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 3,
   "firman": "karena Engkau melakukan kedahsyatan yang tidak kami harapkan, seperti tidak pernah didengar orang sejak dahulu kala!"
 },
 {
   "id": 18894,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 4,
   "firman": "Tidak ada telinga yang mendengar, dan tidak ada mata yang melihat seorang allah yang bertindak bagi orang yang menanti-nantikan dia; hanya Engkau yang berbuat demikian."
 },
 {
   "id": 18895,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 5,
   "firman": "Engkau menyongsong mereka yang melakukan yang benar dan yang mengingat jalan yang Kautunjukkan! Sesungguhnya, Engkau ini murka, sebab kami berdosa; terhadap Engkau kami memberontak sejak dahulu kala."
 },
 {
   "id": 18896,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 6,
   "firman": "Demikianlah kami sekalian seperti seorang najis dan segala kesalehan kami seperti kain kotor; kami sekalian menjadi layu seperti daun dan kami lenyap oleh kejahatan kami seperti daun dilenyapkan oleh angin."
 },
 {
   "id": 18897,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 7,
   "firman": "Tidak ada yang memanggil nama-Mu atau yang bangkit untuk berpegang kepada-Mu; sebab Engkau menyembunyikan wajah-Mu terhadap kami, dan menyerahkan kami ke dalam kekuasaan dosa kami."
 },
 {
   "id": 18898,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 8,
   "firman": "Tetapi sekarang, ya TUHAN, Engkaulah Bapa kami! Kamilah tanah liat dan Engkaulah yang membentuk kami, dan kami sekalian adalah buatan tangan-Mu."
 },
 {
   "id": 18899,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 9,
   "firman": "Ya TUHAN, janganlah murka amat sangat dan janganlah mengingat-ingat dosa untuk seterusnya! Sesungguhnya, pandanglah kiranya, kami sekalian adalah umat-Mu."
 },
 {
   "id": 18900,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 10,
   "firman": "Kota-kota-Mu yang kudus sudah menjadi padang gurun, Sion sudah menjadi padang gurun, Yerusalem sunyi sepi."
 },
 {
   "id": 18901,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 11,
   "firman": "Bait kami yang kudus dan agung, tempat nenek moyang kami memuji-muji Engkau, sudah menjadi umpan api, maka milik kami yang paling indah sudah menjadi reruntuhan."
 },
 {
   "id": 18902,
   "kitab": "Yes",
   "pasal": 64,
   "ayat": 12,
   "firman": "Melihat semuanya ini, ya TUHAN, masakan Engkau menahan diri, masakan Engkau tinggal diam dan menindas kami amat sangat?"
 },
 {
   "id": 18903,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 1,
   "firman": "Aku telah berkenan memberi petunjuk kepada orang yang tidak menanyakan Aku; Aku telah berkenan ditemukan oleh orang yang tidak mencari Aku. Aku telah berkata: \"Ini Aku, ini Aku!\" kepada bangsa yang tidak memanggil nama-Ku."
 },
 {
   "id": 18904,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 2,
   "firman": "Sepanjang hari Aku telah mengulurkan tangan-Ku kepada suku bangsa yang memberontak, yang menempuh jalan yang tidak baik dan mengikuti rancangannya sendiri;"
 },
 {
   "id": 18905,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 3,
   "firman": "suku bangsa yang menyakitkan hati-Ku senantiasa di depan mata-Ku, dengan mempersembahkan korban di taman-taman dewa dan membakar korban di atas batu bata;"
 },
 {
   "id": 18906,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 4,
   "firman": "yang duduk di kuburan-kuburan dan bermalam di dalam gua-gua; yang memakan daging babi dan kuah daging najis ada dalam kuali mereka;"
 },
 {
   "id": 18907,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 5,
   "firman": "yang berkata: \"Menjauhlah, janganlah meraba aku, nanti engkau menjadi kudus olehku!\" Semuanya ini seperti asap yang naik ke dalam hidung-Ku, seperti api yang menyala sepanjang hari."
 },
 {
   "id": 18908,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 6,
   "firman": "Sesungguhnya, telah ada tertulis di hadapan-Ku: Aku tidak akan tinggal diam, malah Aku akan mengadakan pembalasan, ya, pembalasan terhadap diri mereka,"
 },
 {
   "id": 18909,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 7,
   "firman": "atas segala kesalahan mereka sendiri, maupun atas kesalahan nenek moyangnya, semuanya serentak, firman TUHAN. Sebab mereka telah membakar korban di atas gunung-gunung dan mengaibkan Aku di atas bukit-bukit. Memang Aku akan menakar ke dalam jubah mereka upah untuk perbuatan-perbuatan mereka yang dahulu!"
 },
 {
   "id": 18910,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 8,
   "firman": "Beginilah firman TUHAN: \"Seperti kata orang jika pada tandan buah anggur masih terdapat airnya: Janganlah musnahkan itu, sebab di dalamnya masih ada berkat! demikianlah Aku akan bertindak oleh karena hamba-hamba-Ku, yakni Aku tidak akan memusnahkan sekaliannya."
 },
 {
   "id": 18911,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 9,
   "firman": "Aku akan membangkitkan keturunan dari Yakub, dan orang yang mewarisi gunung-gunung-Ku dari Yehuda; orang-orang pilihan-Ku akan mewarisinya, dan hamba-hamba-Ku akan tinggal di situ."
 },
 {
   "id": 18912,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 10,
   "firman": "Saron akan menjadi padang rumput bagi kambing domba, dan lembah Akhor menjadi tempat pembaringan bagi lembu sapi, untuk umat-Ku yang mencari Aku."
 },
 {
   "id": 18913,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 11,
   "firman": "Tetapi kamu yang telah meninggalkan TUHAN, yang telah melupakan gunung-Ku yang kudus, yang menyajikan hidangan bagi dewa Gad, dan yang menyuguhkan anggur bercampur rempah bagi dewa Meni:"
 },
 {
   "id": 18914,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 12,
   "firman": "Aku akan menentukan kamu bagi pedang, dan kamu sekalian akan menekuk lutut untuk dibantai! Oleh karena ketika Aku memanggil, kamu tidak menjawab, ketika Aku berbicara, kamu tidak mendengar, tetapi kamu melakukan apa yang jahat di mata-Ku dan lebih menyukai apa yang tidak berkenan kepada-Ku.\""
 },
 {
   "id": 18915,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 13,
   "firman": "Sebab itu beginilah firman Tuhan ALLAH: \"Sesungguhnya, hamba-hamba-Ku akan makan, tetapi kamu akan menderita kelaparan; sesungguhnya, hamba-hamba-Ku akan minum, tetapi kamu akan menderita kehausan; sesungguhnya, hamba-hamba-Ku akan bersukacita, tetapi kamu akan mendapat malu;"
 },
 {
   "id": 18916,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 14,
   "firman": "sesungguhnya, hamba-hamba-Ku akan bersorak-sorai karena gembira hatinya, tetapi kamu akan mengerang karena sedih hati, dan kamu akan menangis karena patah semangat."
 },
 {
   "id": 18917,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 15,
   "firman": "Kamu harus meninggalkan namamu kepada orang-orang pilihan-Ku untuk dipakai sebagai sumpah kutuk ini: Tuhan ALLAH kiranya membuat engkau seperti mereka! Tetapi hamba-hamba-Ku akan disebut dengan nama lain,"
 },
 {
   "id": 18918,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 16,
   "firman": "sehingga orang yang hendak mendapat berkat di negeri akan memohon berkat demi Allah yang setia, dan orang yang hendak bersumpah di negeri akan bersumpah demi Allah yang setia, sebab kesesakan-kesesakan yang dahulu sudah terlupa, dan sudah tersembunyi dari mata-Ku.\""
 },
 {
   "id": 18919,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 17,
   "firman": "\"Sebab sesungguhnya, Aku menciptakan langit yang baru dan bumi yang baru; hal-hal yang dahulu tidak akan diingat lagi, dan tidak akan timbul lagi dalam hati."
 },
 {
   "id": 18920,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 18,
   "firman": "Tetapi bergiranglah dan bersorak-sorak untuk selama-lamanya atas apa yang Kuciptakan, sebab sesungguhnya, Aku menciptakan Yerusalem penuh sorak-sorak dan penduduknya penuh kegirangan."
 },
 {
   "id": 18921,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 19,
   "firman": "Aku akan bersorak-sorak karena Yerusalem, dan bergirang karena umat-Ku; di dalamnya tidak akan kedengaran lagi bunyi tangisan dan bunyi erangpun tidak."
 },
 {
   "id": 18922,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 20,
   "firman": "Di situ tidak akan ada lagi bayi yang hanya hidup beberapa hari atau orang tua yang tidak mencapai umur suntuk, sebab siapa yang mati pada umur seratus tahun masih akan dianggap muda, dan siapa yang tidak mencapai umur seratus tahun akan dianggap kena kutuk."
 },
 {
   "id": 18923,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 21,
   "firman": "Mereka akan mendirikan rumah-rumah dan mendiaminya juga; mereka akan menanami kebun-kebun anggur dan memakan buahnya juga."
 },
 {
   "id": 18924,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 22,
   "firman": "Mereka tidak akan mendirikan sesuatu, supaya orang lain mendiaminya, dan mereka tidak akan menanam sesuatu, supaya orang lain memakan buahnya; sebab umur umat-Ku akan sepanjang umur pohon, dan orang-orang pilihan-Ku akan menikmati pekerjaan tangan mereka."
 },
 {
   "id": 18925,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 23,
   "firman": "Mereka tidak akan bersusah-susah dengan percuma dan tidak akan melahirkan anak yang akan mati mendadak, sebab mereka itu keturunan orang-orang yang diberkati TUHAN, dan anak cucu mereka ada beserta mereka."
 },
 {
   "id": 18926,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 24,
   "firman": "Maka sebelum mereka memanggil, Aku sudah menjawabnya; ketika mereka sedang berbicara, Aku sudah mendengarkannya."
 },
 {
   "id": 18927,
   "kitab": "Yes",
   "pasal": 65,
   "ayat": 25,
   "firman": "Serigala dan anak domba akan bersama-sama makan rumput, singa akan makan jerami seperti lembu dan ular akan hidup dari debu. Tidak ada yang akan berbuat jahat atau yang berlaku busuk di segenap gunung-Ku yang kudus,\" firman TUHAN."
 },
 {
   "id": 18928,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: Langit adalah takhta-Ku dan bumi adalah tumpuan kaki-Ku; rumah apakah yang akan kamu dirikan bagi-Ku, dan tempat apakah yang akan menjadi perhentian-Ku?"
 },
 {
   "id": 18929,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 2,
   "firman": "Bukankah tangan-Ku yang membuat semuanya ini, sehingga semuanya ini terjadi? demikianlah firman TUHAN. Tetapi kepada orang inilah Aku memandang: kepada orang yang tertindas dan patah semangatnya dan yang gentar kepada firman-Ku."
 },
 {
   "id": 18930,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 3,
   "firman": "Orang menyembelih lembu jantan, namun membunuh manusia juga, orang mengorbankan domba, namun mematahkan batang leher anjing, orang mempersembahkan korban sajian, namun mempersembahkan darah babi, orang mempersembahkan kemenyan, namun memuja berhala juga. Karena itu: sama seperti mereka lebih menyukai jalan mereka sendiri, dan jiwanya menghendaki dewa kejijikan mereka,"
 },
 {
   "id": 18931,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 4,
   "firman": "demikianlah Aku lebih menyukai memperlakukan mereka dengan sewenang-wenang dan mendatangkan kepada mereka apa yang ditakutkan mereka; oleh karena apabila Aku memanggil, tidak ada yang menjawab, apabila Aku berbicara, mereka tidak mendengarkan, tetapi mereka melakukan yang jahat di mata-Ku dan lebih menyukai apa yang tidak Kukehendaki."
 },
 {
   "id": 18932,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 5,
   "firman": "Dengarlah firman TUHAN, hai kamu yang gentar kepada firman-Nya! Saudara-saudaramu, yang membenci kamu, yang mengucilkan kamu oleh karena kamu menghormati nama-Ku, telah berkata: \"Baiklah TUHAN menyatakan kemuliaan-Nya, supaya kami melihat sukacitamu!\" Tetapi mereka sendirilah yang mendapat malu."
 },
 {
   "id": 18933,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 6,
   "firman": "Dengar, bunyi kegemparan dari kota, dengar, datangnya dari Bait Suci! Dengar, TUHAN melakukan pembalasan kepada musuh-musuh-Nya!"
 },
 {
   "id": 18934,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 7,
   "firman": "Sebelum menggeliat sakit, ia sudah bersalin, sebelum mengalami sakit beranak, ia sudah melahirkan anak laki-laki."
 },
 {
   "id": 18935,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 8,
   "firman": "Siapakah yang telah mendengar hal yang seperti itu, siapakah yang telah melihat hal yang demikian? Masakan suatu negeri diperanakkan dalam satu hari, atau suatu bangsa dilahirkan dalam satu kali? Namun baru saja menggeliat sakit, Sion sudah melahirkan anak-anaknya."
 },
 {
   "id": 18936,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 9,
   "firman": "Masakan Aku membukakan rahim orang, dan tidak membuatnya melahirkan? firman TUHAN. Atau masakan Aku membuat orang melahirkan, dan menutup rahimnya pula? firman Allahmu."
 },
 {
   "id": 18937,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 10,
   "firman": "Bersukacitalah bersama-sama Yerusalem, dan bersorak-soraklah karenanya, hai semua orang yang mencintainya! Bergiranglah bersama-sama dia segirang-girangnya, hai semua orang yang berkabung karenanya!"
 },
 {
   "id": 18938,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 11,
   "firman": "supaya kamu mengisap dan menjadi kenyang dari susu yang menyegarkan kamu, supaya kamu menghirup dan menikmati dari dadanya yang bernas."
 },
 {
   "id": 18939,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 12,
   "firman": "Sebab beginilah firman TUHAN: Sesungguhnya, Aku mengalirkan kepadanya keselamatan seperti sungai, dan kekayaan bangsa-bangsa seperti batang air yang membanjir; kamu akan menyusu, akan digendong, akan dibelai-belai di pangkuan."
 },
 {
   "id": 18940,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 13,
   "firman": "Seperti seseorang yang dihibur ibunya, demikianlah Aku ini akan menghibur kamu; kamu akan dihibur di Yerusalem."
 },
 {
   "id": 18941,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 14,
   "firman": "Apabila kamu melihatnya, hatimu akan girang, dan kamu akan seperti rumput muda yang tumbuh dengan lebat; maka tangan TUHAN akan nyata kepada hamba-hamba-Nya, dan amarah-Nya kepada musuh-musuh-Nya."
 },
 {
   "id": 18942,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 15,
   "firman": "Sebab sesungguhnya, TUHAN akan datang dengan api, dan kereta-kereta-Nya akan seperti puting beliung, untuk melampiaskan murka-Nya dengan kepanasan dan hardik-Nya dengan nyala api."
 },
 {
   "id": 18943,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 16,
   "firman": "Sebab TUHAN akan menghukum segala yang hidup dengan api dan dengan pedang-Nya, dan orang-orang yang mati terbunuh oleh TUHAN akan banyak jumlahnya."
 },
 {
   "id": 18944,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 17,
   "firman": "Mereka yang menguduskan dan mentahirkan dirinya untuk taman-taman dewa, dengan mengikuti seseorang yang ada di tengah-tengahnya, yang memakan daging babi dan binatang-binatang jijik serta tikus, mereka semuanya akan lenyap sekaligus, demikianlah firman TUHAN."
 },
 {
   "id": 18945,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 18,
   "firman": "Aku mengenal segala perbuatan dan rancangan mereka, dan Aku datang untuk mengumpulkan segala bangsa dari semua bahasa, dan mereka itu akan datang dan melihat kemuliaan-Ku."
 },
 {
   "id": 18946,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 19,
   "firman": "Aku akan menaruh tanda di tengah-tengah mereka dan akan mengutus dari antara mereka orang-orang yang terluput kepada bangsa-bangsa, yakni Tarsis, Pul dan Lud, ke Mesekh dan Rosh, ke Tubal dan Yawan, ke pulau-pulau yang jauh yang belum pernah mendengar kabar tentang Aku dan yang belum pernah melihat kemuliaan-Ku, supaya mereka memberitakan kemuliaan-Ku di antara bangsa-bangsa."
 },
 {
   "id": 18947,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 20,
   "firman": "Mereka itu akan membawa semua saudaramu dari antara segala bangsa sebagai korban untuk TUHAN di atas kuda dan kereta dan di atas usungan, di atas bagal dan unta betina yang cepat, ke atas gunung-Ku yang kudus, ke Yerusalem, firman TUHAN, sama seperti orang Israel membawa korban dalam wadah yang tahir ke dalam rumah TUHAN."
 },
 {
   "id": 18948,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 21,
   "firman": "Juga dari antara mereka akan Kuambil imam-imam dan orang-orang Lewi, firman TUHAN."
 },
 {
   "id": 18949,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 22,
   "firman": "Sebab sama seperti langit yang baru dan bumi yang baru yang akan Kujadikan itu, tinggal tetap di hadapan-Ku, demikianlah firman TUHAN, demikianlah keturunanmu dan namamu akan tinggal tetap."
 },
 {
   "id": 18950,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 23,
   "firman": "Bulan berganti bulan, dan Sabat berganti Sabat, maka seluruh umat manusia akan datang untuk sujud menyembah di hadapan-Ku, firman TUHAN."
 },
 {
   "id": 18951,
   "kitab": "Yes",
   "pasal": 66,
   "ayat": 24,
   "firman": "Mereka akan keluar dan akan memandangi bangkai orang-orang yang telah memberontak kepada-Ku. Di situ ulat-ulatnya tidak akan mati, dan apinya tidak akan padam, maka semuanya akan menjadi kengerian bagi segala yang hidup."
 },
 {
   "id": 18952,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah perkataan-perkataan Yeremia bin Hilkia, dari keturunan imam yang ada di Anatot di tanah Benyamin."
 },
 {
   "id": 18953,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 2,
   "firman": "Dalam zaman Yosia bin Amon, raja Yehuda, dalam tahun yang ketiga belas dari pemerintahannya datanglah firman TUHAN kepada Yeremia."
 },
 {
   "id": 18954,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 3,
   "firman": "Firman itu datang juga dalam zaman Yoyakim bin Yosia, raja Yehuda, sampai akhir tahun yang kesebelas zaman Zedekia bin Yosia, raja Yehuda, hingga penduduk Yerusalem diangkut ke dalam pembuangan dalam bulan yang kelima."
 },
 {
   "id": 18955,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 4,
   "firman": "Firman TUHAN datang kepadaku, bunyinya:"
 },
 {
   "id": 18956,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 5,
   "firman": "\"Sebelum Aku membentuk engkau dalam rahim ibumu, Aku telah mengenal engkau, dan sebelum engkau keluar dari kandungan, Aku telah menguduskan engkau, Aku telah menetapkan engkau menjadi nabi bagi bangsa-bangsa.\""
 },
 {
   "id": 18957,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 6,
   "firman": "Maka aku menjawab: \"Ah, Tuhan ALLAH! Sesungguhnya aku tidak pandai berbicara, sebab aku ini masih muda.\""
 },
 {
   "id": 18958,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 7,
   "firman": "Tetapi TUHAN berfirman kepadaku: \"Janganlah katakan: Aku ini masih muda, tetapi kepada siapapun engkau Kuutus, haruslah engkau pergi, dan apapun yang Kuperintahkan kepadamu, haruslah kausampaikan."
 },
 {
   "id": 18959,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 8,
   "firman": "Janganlah takut kepada mereka, sebab Aku menyertai engkau untuk melepaskan engkau, demikianlah firman TUHAN.\""
 },
 {
   "id": 18960,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 9,
   "firman": "Lalu TUHAN mengulurkan tangan-Nya dan menjamah mulutku; TUHAN berfirman kepadaku: \"Sesungguhnya, Aku menaruh perkataan-perkataan-Ku ke dalam mulutmu."
 },
 {
   "id": 18961,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 10,
   "firman": "Ketahuilah, pada hari ini Aku mengangkat engkau atas bangsa-bangsa dan atas kerajaan-kerajaan untuk mencabut dan merobohkan, untuk membinasakan dan meruntuhkan, untuk membangun dan menanam.\""
 },
 {
   "id": 18962,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sesudah itu firman TUHAN datang kepadaku, bunyinya: \"Apakah yang kaulihat, hai Yeremia?\" Jawabku: \"Aku melihat sebatang dahan pohon badam.\""
 },
 {
   "id": 18963,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 12,
   "firman": "Lalu firman TUHAN kepadaku: \"Baik penglihatanmu, sebab Aku siap sedia untuk melaksanakan firman-Ku.\""
 },
 {
   "id": 18964,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 13,
   "firman": "Firman TUHAN datang kepadaku untuk kedua kalinya, bunyinya: \"Apakah yang kaulihat?\" Jawabku: \"Aku melihat sebuah periuk yang mendidih; datangnya dari sebelah utara.\""
 },
 {
   "id": 18965,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 14,
   "firman": "Lalu firman TUHAN kepadaku: \"Dari utara akan mengamuk malapetaka menimpa segala penduduk negeri ini."
 },
 {
   "id": 18966,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 15,
   "firman": "Sebab sesungguhnya, Aku memanggil segala kaum kerajaan sebelah utara, demikianlah firman TUHAN, dan mereka akan datang dan mendirikan takhtanya masing-masing di mulut pintu-pintu gerbang Yerusalem, dekat segala tembok di sekelilingnya dan dekat segala kota Yehuda."
 },
 {
   "id": 18967,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 16,
   "firman": "Maka Aku akan menjatuhkan hukuman-Ku atas mereka, karena segala kejahatan mereka, sebab mereka telah meninggalkan Aku, dengan membakar korban kepada allah lain dan sujud menyembah kepada buatan tangannya sendiri."
 },
 {
   "id": 18968,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 17,
   "firman": "Tetapi engkau ini, baiklah engkau bersiap, bangkitlah dan sampaikanlah kepada mereka segala yang Kuperintahkan kepadamu. Janganlah gentar terhadap mereka, supaya jangan Aku menggentarkan engkau di depan mereka!"
 },
 {
   "id": 18969,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 18,
   "firman": "Mengenai Aku, sesungguhnya pada hari ini Aku membuat engkau menjadi kota yang berkubu, menjadi tiang besi dan menjadi tembok tembaga melawan seluruh negeri ini, menentang raja-raja Yehuda dan pemuka-pemukanya, menentang para imamnya dan rakyat negeri ini."
 },
 {
   "id": 18970,
   "kitab": "Yer",
   "pasal": 1,
   "ayat": 19,
   "firman": "Mereka akan memerangi engkau, tetapi tidak akan mengalahkan engkau, sebab Aku menyertai engkau untuk melepaskan engkau, demikianlah firman TUHAN.\""
 },
 {
   "id": 18971,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 1,
   "firman": "Firman TUHAN datang kepadaku, bunyinya:"
 },
 {
   "id": 18972,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 2,
   "firman": "\"Pergilah memberitahukan kepada penduduk Yerusalem dengan mengatakan: Beginilah firman TUHAN: Aku teringat kepada kasihmu pada masa mudamu, kepada cintamu pada waktu engkau menjadi pengantin, bagaimana engkau mengikuti Aku di padang gurun, di negeri yang tiada tetaburannya."
 },
 {
   "id": 18973,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 3,
   "firman": "Ketika itu Israel kudus bagi TUHAN, sebagai buah bungaran dari hasil tanah-Nya. Semua orang yang memakannya menjadi bersalah, malapetaka menimpa mereka, demikianlah firman TUHAN."
 },
 {
   "id": 18974,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 4,
   "firman": "Dengarlah firman TUHAN, hai kaum keturunan Yakub, hai segala kaum keluarga keturunan Israel."
 },
 {
   "id": 18975,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 5,
   "firman": "Beginilah firman TUHAN: Apakah kecurangan yang didapati nenek moyangmu pada-Ku, sehingga mereka menjauh dari pada-Ku, mengikuti dewa kesia-siaan, sampai mereka menjadi sia-sia?"
 },
 {
   "id": 18976,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 6,
   "firman": "Dan mereka tidak lagi bertanya: Di manakah TUHAN, yang menuntun kita keluar dari tanah Mesir; yang memimpin kita di padang gurun, di tanah yang tandus dan yang lekak-lekuk, di tanah yang sangat kering dan gelap, di tanah yang tidak dilintasi orang dan yang tidak didiami manusia?"
 },
 {
   "id": 18977,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 7,
   "firman": "Aku telah membawa kamu ke tanah yang subur untuk menikmati buahnya dan segala yang baik dari padanya. Tetapi segera setelah kamu masuk, kamu menajiskan tanah-Ku; tanah milik-Ku telah kamu buat menjadi kekejian."
 },
 {
   "id": 18978,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 8,
   "firman": "Para imam tidak lagi bertanya: Di manakah TUHAN? Orang-orang yang melaksanakan hukum tidak mengenal Aku lagi, dan para gembala mendurhaka terhadap Aku. Para nabi bernubuat demi Baal, mereka mengikuti apa yang tidak berguna."
 },
 {
   "id": 18979,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sebab itu Aku akan berbantah lagi dengan kamu, demikianlah firman TUHAN, dan dengan anak cucumu Aku akan berbantah."
 },
 {
   "id": 18980,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 10,
   "firman": "Menyeberang sajalah ke tanah pesisir orang Kitim dan lihatlah; suruhlah orang ke Kedar dan perhatikanlah dengan sungguh-sungguh! Lihatlah apakah ada terjadi yang seperti ini:"
 },
 {
   "id": 18981,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 11,
   "firman": "pernahkah suatu bangsa menukarkan allahnya meskipun itu sebenarnya bukan allah? Tetapi umat-Ku menukarkan Kemuliaannya dengan apa yang tidak berguna."
 },
 {
   "id": 18982,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 12,
   "firman": "Tertegunlah atas hal itu, hai langit, menggigil dan gemetarlah dengan sangat, demikianlah firman TUHAN."
 },
 {
   "id": 18983,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sebab dua kali umat-Ku berbuat jahat: mereka meninggalkan Aku, sumber air yang hidup, untuk menggali kolam bagi mereka sendiri, yakni kolam yang bocor, yang tidak dapat menahan air."
 },
 {
   "id": 18984,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 14,
   "firman": "Adakah Israel itu budak atau anak budak? Maka mengapa ia menjadi rampasan?"
 },
 {
   "id": 18985,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 15,
   "firman": "Terhadapnya singa-singa muda mengaum, menyaringkan suaranya; negerinya dibuat orang menjadi tandus, kota-kotanya terbakar, tidak lagi berpenduduk."
 },
 {
   "id": 18986,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 16,
   "firman": "Bahkan orang-orang Memfis dan Tahpanhes telah menggundul batu kepalamu."
 },
 {
   "id": 18987,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 17,
   "firman": "Bukankah engkau sendiri yang menimpakan ini ke atas dirimu, oleh karena engkau meninggalkan TUHAN, Allahmu, ketika Ia menuntun engkau di jalan?"
 },
 {
   "id": 18988,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 18,
   "firman": "Dan sekarang, apakah untungmu untuk pergi ke Mesir, hendak meminum air sungai Nil? Dan apakah untungmu untuk pergi ke Asyur, hendak meminum air sungai Efrat?"
 },
 {
   "id": 18989,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 19,
   "firman": "Kejahatanmu akan menghajar engkau, dan kemurtadanmu akan menyiksa engkau! Ketahuilah dan lihatlah, betapa jahat dan pedihnya engkau meninggalkan TUHAN, Allahmu; dan tidak gemetar terhadap Aku, demikianlah firman Tuhan ALLAH semesta alam."
 },
 {
   "id": 18990,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sebab dari dahulu kala engkau telah mematahkan kukmu, telah memutuskan tali pengikatmu, dan berkata: Aku tidak mau lagi diperbudak. Bahkan di atas setiap bukit yang menjulang dan di bawah setiap pohon yang rimbun engkau berbaring dan bersundal."
 },
 {
   "id": 18991,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 21,
   "firman": "Namun Aku telah membuat engkau tumbuh sebagai pokok anggur pilihan, sebagai benih yang sungguh murni. Betapa engkau berubah menjadi pohon berbau busuk, pohon anggur liar!"
 },
 {
   "id": 18992,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 22,
   "firman": "Bahkan, sekalipun engkau mencuci dirimu dengan air abu, dan dengan banyak sabun, namun noda kesalahanmu tetap ada di depan mata-Ku, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 18993,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 23,
   "firman": "Bagaimanakah engkau berani berkata: Aku tidak pernah menajiskan diriku, aku tidak pernah mengikuti para Baal? Lihatlah tingkah langkahmu di dalam lembah, ketahuilah apa yang telah kaulakukan: hai, unta betina yang ringan kaki yang berlari-lari kian ke mari,"
 },
 {
   "id": 18994,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 24,
   "firman": "yang melepaskan diri lari ke padang gurun, karena ingin menghirup udara! Siapakah yang dapat menahan nafsunya untuk berjantan? Semua yang mencari dia, tidak usah berlelah, mereka akan menemukannya dalam musim berjantan."
 },
 {
   "id": 18995,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 25,
   "firman": "Jagalah, supaya kakimu jangan tak bersepatu dan supaya rongkonganmu jangan haus! Tetapi engkau berkata: Percuma saja! Percuma! Sebab aku cinta kepada orang-orang asing, jadi aku mau mengikuti mereka."
 },
 {
   "id": 18996,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 26,
   "firman": "Seperti malunya pencuri, apabila kedapatan, demikianlah malunya kaum Israel, yakni para rajanya, pemukanya, para imamnya dan nabinya,"
 },
 {
   "id": 18997,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 27,
   "firman": "yang berkata kepada sepotong kayu: Engkaulah bapaku! dan kepada batu: Engkaulah yang melahirkan aku! Sungguh, mereka membelakangi Aku dan tidak menghadapkan mukanya kepada-Ku, tetapi pada waktu mereka ditimpa malapetaka mereka berkata: Bangkitlah menyelamatkan kami!"
 },
 {
   "id": 18998,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 28,
   "firman": "Di manakah para allahmu yang kaubuat untuk dirimu? Biarlah mereka bangkit, jika mereka dapat menyelamatkan engkau pada waktu malapetakamu! Sebab seperti banyaknya kotamu demikian banyaknya para allahmu, hai Yehuda!"
 },
 {
   "id": 18999,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 29,
   "firman": "Mengapakah kamu mau berbantah dengan Aku? Kamu sekalian telah mendurhaka kepada-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 19000,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 30,
   "firman": "Sia-sia Aku telah memukuli anak-anakmu, hajaran tidaklah mereka terima; pedangmu sendiri telah memakan habis para nabimu seperti singa muda yang memusnahkan."
 },
 {
   "id": 19001,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 31,
   "firman": "Keturunan apakah kamu ini? Perhatikanlah firman TUHAN! Sudahkah Aku menjadi padang gurun bagi Israel atau tanah yang gelap gulita? Maka mengapa umat-Ku berkata: Kami sudah bebas, kami tidak lagi mau datang kepada-Mu?"
 },
 {
   "id": 19002,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 32,
   "firman": "Dapatkah seorang dara melupakan perhiasannya, atau seorang pengantin perempuan melupakan ikat pinggangnya? Tetapi umat-Ku melupakan Aku, sejak waktu yang tidak terbilang lamanya."
 },
 {
   "id": 19003,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 33,
   "firman": "Alangkah baiknya engkau mengatur jalanmu untuk mencari percintaan! Sebab itu juga engkau membiasakan segala jalanmu kepada kejahatan."
 },
 {
   "id": 19004,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 34,
   "firman": "Sampai-sampai pada bajumu terdapat darah orang-orang miskin yang tidak bersalah; bukan waktu mereka membongkar untuk mencuri kaudapati mereka! Meskipun semuanya itu demikian,"
 },
 {
   "id": 19005,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 35,
   "firman": "engkau berkata: Aku tidak bersalah! Memang, murka-Nya telah meninggalkan aku! Sesungguhnya Aku akan membawa engkau ke pengadilan, oleh karena engkau berkata: Aku tidak berdosa!"
 },
 {
   "id": 19006,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 36,
   "firman": "Alangkah ringannya kaupandang untuk mengubah tingkah langkahmu! Juga karena Mesir engkau akan menjadi malu, seperti engkau telah menjadi malu karena Asyur."
 },
 {
   "id": 19007,
   "kitab": "Yer",
   "pasal": 2,
   "ayat": 37,
   "firman": "Dari sanapun juga engkau akan keluar dengan mengangkat tanganmu, sebab TUHAN telah menolak mereka yang telah kaupercayai dan engkau tidak akan berhasil dengan mereka.\""
 },
 {
   "id": 19008,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 1,
   "firman": "Firman-Nya: \"Jika seseorang menceraikan isterinya, lalu perempuan itu pergi dari padanya dan menjadi isteri orang lain, akan kembalikah laki-laki yang pertama kepada perempuan itu? Bukankah negeri itu sudah tetap cemar? Engkau telah berzinah dengan banyak kekasih, dan mau kembali kepada-Ku? demikianlah firman TUHAN."
 },
 {
   "id": 19009,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 2,
   "firman": "Layangkanlah matamu ke bukit-bukit gundul dan lihatlah! Di manakah engkau tidak pernah ditiduri? Di pinggir jalan-jalan engkau duduk menantikan kekasih, seperti seorang Arab di padang gurun. Engkau telah mencemarkan negeri dengan zinahmu dan dengan kejahatanmu."
 },
 {
   "id": 19010,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 3,
   "firman": "Sebab itu dirus hujan tertahan dan hujan pada akhir musim tidak datang. Tetapi dahimu adalah dahi perempuan sundal, engkau tidak mengenal malu."
 },
 {
   "id": 19011,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 4,
   "firman": "Bukankah baru saja engkau memanggil Aku: Bapaku! Engkaulah kawanku sejak kecil!"
 },
 {
   "id": 19012,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 5,
   "firman": "Untuk selama-lamanyakah Ia akan murka atau menaruh dendam untuk seterusnya? Demikianlah katamu, namun engkau sedapat-dapatnya melakukan kejahatan.\""
 },
 {
   "id": 19013,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 6,
   "firman": "TUHAN berfirman kepadaku dalam zaman raja Yosia: \"Sudahkah engkau melihat apa yang dilakukan Israel, perempuan murtad itu, bagaimana dia naik ke atas setiap bukit yang menjulang dan pergi ke bawah setiap pohon yang rimbun untuk bersundal di sana?"
 },
 {
   "id": 19014,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 7,
   "firman": "Pikir-Ku: Sesudah melakukan semuanya ini, ia akan kembali kepada-Ku, tetapi ia tidak kembali. Hal itu telah dilihat oleh Yehuda, saudaranya perempuan yang tidak setia."
 },
 {
   "id": 19015,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 8,
   "firman": "Dilihatnya, bahwa oleh karena zinahnya Aku telah menceraikan Israel, perempuan murtad itu, dan memberikan kepadanya surat cerai; namun Yehuda, saudaranya perempuan yang tidak setia itu tidak takut, melainkan ia juga pun pergi bersundal."
 },
 {
   "id": 19016,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 9,
   "firman": "Dengan sundalnya yang sembrono itu maka ia mencemarkan negeri dan berzinah dengan menyembah batu dan kayu."
 },
 {
   "id": 19017,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 10,
   "firman": "Juga dengan semuanya ini Yehuda, saudaranya perempuan yang tidak setia itu, tidak kembali kepada-Ku dengan tulus hatinya, tetapi dengan pura-pura, demikianlah firman TUHAN.\""
 },
 {
   "id": 19018,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 11,
   "firman": "Dan TUHAN berfirman kepadaku: \"Israel, perempuan murtad itu, membuktikan dirinya lebih benar dari pada Yehuda, perempuan yang tidak setia itu."
 },
 {
   "id": 19019,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 12,
   "firman": "Pergilah menyerukan perkataan-perkataan ini ke utara, katakanlah: Kembalilah, hai Israel, perempuan murtad, demikianlah firman TUHAN. Muka-Ku tidak akan muram terhadap kamu, sebab Aku ini murah hati, demikianlah firman TUHAN, tidak akan murka untuk selama-lamanya."
 },
 {
   "id": 19020,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 13,
   "firman": "Hanya akuilah kesalahanmu, bahwa engkau telah mendurhaka terhadap TUHAN, Allahmu, telah melampiaskan cinta berahimu kepada orang-orang asing di bawah setiap pohon yang rimbun, dan tidak mendengarkan suara-Ku, demikianlah firman TUHAN.\""
 },
 {
   "id": 19021,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 14,
   "firman": "Kembalilah, hai anak-anak yang murtad, demikianlah firman TUHAN, karena Aku telah menjadi tuan atas kamu! Aku akan mengambil kamu, seorang dari setiap kota dan dua orang dari setiap keluarga, dan akan membawa kamu ke Sion."
 },
 {
   "id": 19022,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 15,
   "firman": "Aku akan mengangkat bagimu gembala-gembala yang sesuai dengan hati-Ku; mereka akan menggembalakan kamu dengan pengetahuan dan pengertian."
 },
 {
   "id": 19023,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 16,
   "firman": "Apabila pada masa itu kamu bertambah banyak dan beranak cucu di negeri ini, demikianlah firman TUHAN, maka orang tidak lagi akan berbicara tentang tabut perjanjian TUHAN. Itu tidak lagi akan timbul dalam hati dan tidak lagi akan diingat orang; orang tidak lagi akan mencarinya atau membuatnya kembali."
 },
 {
   "id": 19024,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 17,
   "firman": "Pada waktu itu Yerusalem akan disebut takhta TUHAN, dan segala bangsa akan berkumpul ke sana, demi nama TUHAN ke Yerusalem, dan mereka tidak lagi akan bertingkah langkah menurut kedegilan hatinya yang jahat."
 },
 {
   "id": 19025,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 18,
   "firman": "Pada masa itu kaum Yehuda akan pergi kepada kaum Israel, dan mereka akan datang bersama-sama dari negeri utara ke negeri yang telah Kubagikan kepada nenek moyangmu menjadi milik pusaka."
 },
 {
   "id": 19026,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 19,
   "firman": "Tadinya pikir-Ku: \"Sungguh Aku mau menempatkan engkau di tengah-tengah anak-anak-Ku dan memberikan kepadamu negeri yang indah, milik pusaka yang paling permai dari bangsa-bangsa. Pikir-Ku, engkau akan memanggil Aku: Bapaku, dan tidak akan berbalik dari mengikuti Aku."
 },
 {
   "id": 19027,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 20,
   "firman": "Tetapi sesungguhnya, seperti seorang isteri tidak setia terhadap temannya, demikianlah kamu tidak setia terhadap Aku, hai kaum Israel, demikianlah firman TUHAN."
 },
 {
   "id": 19028,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 21,
   "firman": "Dengar! Di atas bukit-bukit gundul kedengaran tangis memohon-mohon dari anak-anak Israel, sebab mereka telah memilih jalan yang sesat, dan telah melupakan TUHAN, Allah mereka."
 },
 {
   "id": 19029,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 22,
   "firman": "Kembalilah, hai anak-anak yang murtad! Aku akan menyembuhkan engkau dari murtadmu.\" \"Inilah kami, kami datang kepada-Mu, sebab Engkaulah TUHAN, Allah kami."
 },
 {
   "id": 19030,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 23,
   "firman": "Sesungguhnya, bukit-bukit pengorbanan adalah tipu daya, yakni keramaian di atas bukit-bukit itu! Sesungguhnya, hanya pada TUHAN, Allah kita, ada keselamatan Israel!"
 },
 {
   "id": 19031,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 24,
   "firman": "Tetapi berhala yang memalukan itu menelan segala hasil jerih lelah nenek moyang kita dari masa muda kita; kambing domba mereka dan lembu-lembu mereka, anak-anak lelaki dan anak-anak perempuan mereka."
 },
 {
   "id": 19032,
   "kitab": "Yer",
   "pasal": 3,
   "ayat": 25,
   "firman": "Maka biarlah kita berbaring dengan perasaan malu, dan biarlah noda kita menyelimuti kita, sebab kita telah berdosa kepada TUHAN, Allah kita, yakni kita dan nenek moyang kita dari masa muda kita sampai hari ini; dan kita tidak mendengarkan suara TUHAN, Allah kita.\""
 },
 {
   "id": 19033,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 1,
   "firman": "\"Jika engkau mau kembali, hai Israel, demikianlah firman TUHAN, kembalilah engkau kepada-Ku; dan jika engkau mau menjauhkan dewa-dewamu yang menjijikkan, tidak usahlah engkau melarikan diri dari hadapan-Ku!"
 },
 {
   "id": 19034,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 2,
   "firman": "Dan jika engkau bersumpah dalam kesetiaan, dalam keadilan dan dalam kebenaran: Demi TUHAN yang hidup!, maka bangsa-bangsa akan saling memberkati di dalam Dia dan akan bermegah di dalam Dia.\""
 },
 {
   "id": 19035,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sebab beginilah firman TUHAN kepada orang Yehuda dan kepada penduduk Yerusalem: \"Bukalah bagimu tanah baru, dan janganlah menabur di tempat duri tumbuh."
 },
 {
   "id": 19036,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 4,
   "firman": "Sunatlah dirimu bagi TUHAN, dan jauhkanlah kulit khatan hatimu, hai orang Yehuda dan penduduk Yerusalem, supaya jangan murka-Ku mengamuk seperti api, dan menyala-nyala dengan tidak ada yang memadamkan, oleh karena perbuatan-perbuatanmu yang jahat!\""
 },
 {
   "id": 19037,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 5,
   "firman": "Beritahukanlah di Yehuda dan kabarkanlah di Yerusalem: Tiuplah sangkakala di dalam negeri, berserulah keras-keras: \"Berkumpullah dan marilah kita pergi ke kota-kota yang berkubu!\""
 },
 {
   "id": 19038,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 6,
   "firman": "Angkatlah panji-panji ke arah Sion! Cepat-cepatlah kamu mengungsi, jangan tinggal diam! Sebab Aku mendatangkan malapetaka dari utara dan kehancuran yang besar."
 },
 {
   "id": 19039,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 7,
   "firman": "Singa telah bangkit dari belukar, pemusnah bangsa-bangsa telah berangkat, telah keluar dari tempatnya untuk membuat negerimu menjadi tandus; kota-kotamu akan dijadikan puing, tidak ada yang mendiaminya."
 },
 {
   "id": 19040,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 8,
   "firman": "Oleh karena itu lilitkanlah kain kabung, menangis dan merataplah; sebab murka TUHAN yang menyala-nyala tidak surut dari pada kita."
 },
 {
   "id": 19041,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 9,
   "firman": "\"Pada waktu itu, demikianlah firman TUHAN, raja dan para pemuka akan kehilangan semangat; para imam akan tertegun dan para nabi akan tercengang-cengang,"
 },
 {
   "id": 19042,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 10,
   "firman": "sambil berkata: Ah, Tuhan ALLAH, sungguh, Engkau telah sangat memperdayakan bangsa ini dan penduduk Yerusalem, dengan mengatakan: Damai kiranya ada padamu, padahal pedang telah mengancam nyawa kami!\""
 },
 {
   "id": 19043,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 11,
   "firman": "Pada masa itu akan dikatakan kepada bangsa ini dan kepada penduduk Yerusalem: \"Angin panas dari bukit-bukit gundul di padang gurun bertiup ke arah puteri umat-Ku; bukan untuk menampi dan bukan untuk membersihkan,"
 },
 {
   "id": 19044,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 12,
   "firman": "melainkan angin yang keras datang atas perintah-Ku. Sekarang Aku sendiri akan menjatuhkan hukuman atas mereka.\""
 },
 {
   "id": 19045,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 13,
   "firman": "Lihat, ia naik seperti awan-awan, keretanya kencang seperti angin badai, kudanya lebih tangkas dari pada burung rajawali. Celakalah kita, sebab kita dibinasakan!"
 },
 {
   "id": 19046,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 14,
   "firman": "Bersihkanlah hatimu dari kejahatan, hai Yerusalem, supaya engkau diselamatkan! Berapa lama lagi tinggal di dalam hatimu rancangan-rancangan kedurjanaanmu?"
 },
 {
   "id": 19047,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 15,
   "firman": "Dengar! Orang memberitahukan dari Dan, mengabarkan malapetaka dari pegunungan Efraim."
 },
 {
   "id": 19048,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 16,
   "firman": "Peringatkanlah kepada bangsa-bangsa: Sungguh ia datang! Kabarkanlah di Yerusalem: \"Pengepung datang dari negeri yang jauh, memperdengarkan suaranya terhadap kota-kota Yehuda."
 },
 {
   "id": 19049,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 17,
   "firman": "Seperti orang-orang yang menunggui ladang mereka mengelilinginya dari segala pihak, sebab Yehuda telah memberontak terhadap Aku, demikianlah firman TUHAN."
 },
 {
   "id": 19050,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 18,
   "firman": "Tingkah langkahmu dan perbuatanmu telah menyebabkan semuanya ini kepadamu. Itulah nasibmu yang buruk, betapa pahitnya, sampai menusuk hatimu.\""
 },
 {
   "id": 19051,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 19,
   "firman": "Aduh, dadaku, dadaku! Aku menggeliat sakit! Aduh, dinding jantungku! Jantungku berdebar-debar, aku tidak dapat berdiam diri, sebab aku mendengar bunyi sangkakala, pekik perang."
 },
 {
   "id": 19052,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 20,
   "firman": "Kehancuran demi kehancuran dikabarkan, seluruh negeri dirusakkan; kemahku dirusakkan dengan tiba-tiba, tendaku dalam sekejap mata."
 },
 {
   "id": 19053,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 21,
   "firman": "Berapa lama lagi aku melihat panji-panji itu, dan mendengar bunyi sangkakala itu?"
 },
 {
   "id": 19054,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 22,
   "firman": "\"Sungguh, bodohlah umat-Ku itu, mereka tidak mengenal Aku! Mereka adalah anak-anak tolol, dan tidak mempunyai pengertian! Mereka pintar untuk berbuat jahat, tetapi untuk berbuat baik mereka tidak tahu.\""
 },
 {
   "id": 19055,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 23,
   "firman": "Aku melihat kepada bumi, ternyata campur baur dan kosong, dan melihat kepada langit, tidak ada terangnya."
 },
 {
   "id": 19056,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 24,
   "firman": "Aku melihat kepada gunung-gunung, ternyata goncang; dan seluruh bukitpun goyah."
 },
 {
   "id": 19057,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 25,
   "firman": "Aku melihat, ternyata tidak ada manusia, dan semua burung di udara sudah lari terbang."
 },
 {
   "id": 19058,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 26,
   "firman": "Aku melihat, ternyata tanah subur sudah menjadi padang gurun, dan segala kotanya sudah runtuh di hadapan TUHAN, di hadapan murka-Nya yang menyala-nyala!"
 },
 {
   "id": 19059,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 27,
   "firman": "Sebab beginilah firman TUHAN: \"Seluruh negeri ini akan menjadi sunyi sepi, tetapi Aku tidak akan membuatnya habis lenyap."
 },
 {
   "id": 19060,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 28,
   "firman": "Karena hal ini bumi akan berkabung, dan langit di atas akan menjadi gelap, sebab Aku telah mengatakannya, Aku telah merancangnya, Aku tidak akan menyesalinya dan tidak akan mundur dari pada itu.\""
 },
 {
   "id": 19061,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 29,
   "firman": "Oleh karena hiruk-pikuk pasukan berkuda dan pemanah seluruh negeri melarikan diri. Mereka masuk ke dalam belukar dan naik ke bukit-bukit batu; setiap kota sudah ditinggalkan dan tidak seorangpun tinggal di dalamnya."
 },
 {
   "id": 19062,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 30,
   "firman": "Dan engkau, yang dimusnahkan, apakah yang hendak kaulakukan, mengapa engkau mengenakan pakaian kirmizi, menghiasi dirimu dengan perhiasan emas, memalit matamu dengan celak? Sia-sia engkau memperelok dirimu, pencinta-pencintamu menolak engkau, bahkan mereka ingin mencabut nyawamu."
 },
 {
   "id": 19063,
   "kitab": "Yer",
   "pasal": 4,
   "ayat": 31,
   "firman": "Sebab aku mendengar suara seperti suara perempuan bersalin, suara orang kesesakan seperti suara ibu yang melahirkan anak pertama, suara puteri Sion yang mengap-mengap, yang merentang-rentangkan tangannya: \"Celakalah aku, sebab aku binasa di depan para pembunuh!\""
 },
 {
   "id": 19064,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 1,
   "firman": "Lintasilah jalan-jalan Yerusalem, lihatlah baik-baik dan camkanlah! Periksalah di tanah-tanah lapangnya, apakah kamu dapat menemui seseorang, apakah ada yang melakukan keadilan dan yang mencari kebenaran, maka Aku mau mengampuni kota itu."
 },
 {
   "id": 19065,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 2,
   "firman": "Sekalipun mereka berkata: \"Demi TUHAN yang hidup,\" namun mereka bersumpah palsu."
 },
 {
   "id": 19066,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 3,
   "firman": "Ya TUHAN, tidakkah mata-Mu terarah kepada kebenaran? Engkau memukul mereka, tetapi mereka tidak kesakitan; Engkau meremukkan mereka, tetapi mereka tidak mau menerima hajaran. Mereka mengeraskan kepalanya lebih dari pada batu, dan mereka tidak mau bertobat."
 },
 {
   "id": 19067,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 4,
   "firman": "Lalu aku berpikir: \"Itu hanya orang-orang kecil; mereka adalah orang-orang bodoh, sebab mereka tidak mengetahui jalan TUHAN, hukum Allah mereka."
 },
 {
   "id": 19068,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 5,
   "firman": "Baiklah aku pergi kepada orang-orang besar, dan berbicara kepada mereka, sebab merekalah yang mengetahui jalan TUHAN, hukum Allah mereka.\" Tetapi merekapun semuanya telah mematahkan kuk, telah memutuskan tali-tali pengikat."
 },
 {
   "id": 19069,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 6,
   "firman": "Sebab itu singa dari hutan akan memukul mati mereka, dan serigala dari padang yang kersang akan merusakkan mereka. Macan tutul akan mengintai di pinggir kota-kota mereka, setiap orang yang ke luar akan diterkam. Sebab pelanggaran mereka amat banyak, dan kesesatannya besar sekali."
 },
 {
   "id": 19070,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 7,
   "firman": "Bagaimana, kalau begitu, dapatkah Aku mengampuni engkau? Anak-anakmu telah meninggalkan Aku, dan bersumpah demi yang bukan allah. Setelah Aku mengenyangkan mereka, mereka berzinah dan bertemu ke rumah persundalan."
 },
 {
   "id": 19071,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 8,
   "firman": "Mereka adalah kuda-kuda jantan yang gemuk dan gasang, masing-masing meringkik menginginkan isteri sesamanya."
 },
 {
   "id": 19072,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 9,
   "firman": "Masakan Aku tidak menghukum mereka karena semuanya ini?, demikianlah firman TUHAN. Masakan Aku tidak membalas dendam-Ku kepada bangsa yang seperti ini?"
 },
 {
   "id": 19073,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 10,
   "firman": "Naiklah ke kebun anggurnya yang bertangga-tangga, rusakkanlah, tetapi jangan membuatnya habis lenyap. Buanglah carang-carang pokok anggurnya, sebab semuanya itu bukan kepunyaan TUHAN!"
 },
 {
   "id": 19074,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 11,
   "firman": "Sebab kaum Israel dan kaum Yehuda telah sungguh-sungguh berlaku tidak setia terhadap Aku, demikianlah firman TUHAN."
 },
 {
   "id": 19075,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 12,
   "firman": "Mereka memungkiri TUHAN dan berkata: \"Dia tidak berbuat apa-apa! Malapetaka tidak akan menimpa kita, perang dan kelaparan tidak akan kita alami."
 },
 {
   "id": 19076,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 13,
   "firman": "Para nabi akan menjadi angin, firman TUHAN tidak ada pada mereka.\""
 },
 {
   "id": 19077,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sebab itu beginilah firman TUHAN, Allah semesta alam: \"Oleh karena mereka berkata seperti itu, maka beginilah akan terjadi kepada mereka: Sesungguhnya Aku akan membuat perkataan-perkataan-Ku menjadi api di dalam mulutmu, dan bangsa ini menjadi kayu bakar, maka api akan memakan habis mereka."
 },
 {
   "id": 19078,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 15,
   "firman": "Sesungguhnya, Aku akan mendatangkan suatu bangsa dari jauh menyerang kamu, hai kaum Israel, demikianlah firman TUHAN, suatu bangsa yang kokoh kuat, suatu bangsa dari dahulu kala, suatu bangsa yang tidak engkau kenal bahasanya, dan yang tidak engkau mengerti apa yang dikatakannya."
 },
 {
   "id": 19079,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 16,
   "firman": "Tabung panahnya seperti kubur yang ternganga, mereka semuanya adalah pahlawan-pahlawan."
 },
 {
   "id": 19080,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 17,
   "firman": "Mereka akan memakan habis hasil tuaianmu dan makananmu, akan memakan habis anak-anakmu lelaki dan perempuan, akan memakan habis kambing dombamu dan lembu sapimu, akan memakan habis pohon anggurmu dan pohon aramu, akan menghancurkan dengan pedang kota-kotamu yang berkubu, yang kauandalkan.\""
 },
 {
   "id": 19081,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 18,
   "firman": "\"Tetapi pada waktu itupun juga, demikianlah firman TUHAN, Aku tidak akan membuat kamu habis lenyap."
 },
 {
   "id": 19082,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 19,
   "firman": "Dan apabila kamu nanti bertanya-tanya: Untuk apakah TUHAN, Allah kita, melakukan segala hal ini atas kita?, maka engkau akan menjawab mereka: Seperti kamu meninggalkan Aku dan memperhambakan diri kepada allah asing di negerimu, demikianlah kamu akan memperhambakan diri kepada orang-orang asing di suatu negeri yang bukan negerimu.\""
 },
 {
   "id": 19083,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 20,
   "firman": "Beritahukanlah ini di antara kaum keturunan Yakub, kabarkanlah itu di Yehuda dengan mengatakan:"
 },
 {
   "id": 19084,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 21,
   "firman": "\"Dengarkanlah ini, hai bangsa yang tolol dan yang tidak mempunyai pikiran, yang mempunyai mata, tetapi tidak melihat, yang mempunyai telinga, tetapi tidak mendengar!"
 },
 {
   "id": 19085,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 22,
   "firman": "Masakan kamu tidak takut kepada-Ku, demikianlah firman TUHAN, kamu tidak gemetar terhadap Aku? Bukankah Aku yang membuat pantai pasir sebagai perbatasan bagi laut, sebagai perhinggaan tetap yang tidak dapat dilampauinya? Biarpun ia bergelora, ia tidak sanggup, biarpun gelombang-gelombangnya ribut, mereka tidak dapat melampauinya!"
 },
 {
   "id": 19086,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 23,
   "firman": "Tetapi bangsa ini mempunyai hati yang selalu melawan dan memberontak; mereka telah menyimpang dan menghilang."
 },
 {
   "id": 19087,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 24,
   "firman": "Mereka tidak berkata dalam hatinya: Baiklah kita takut akan TUHAN, Allah kita, yang memberi hujan pada waktunya, hujan pada awal musim maupun hujan pada akhir musim, dan yang menjamin bagi kita minggu-minggu yang tetap untuk panen."
 },
 {
   "id": 19088,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 25,
   "firman": "Kesalahanmu menghalangi semuanya ini, dan dosamu menghambat yang baik dari padamu."
 },
 {
   "id": 19089,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 26,
   "firman": "Sesungguhnya, di antara umat-Ku terdapat orang-orang fasik yang memasang jaringnya; seperti penangkap burung mereka memasang perangkapnya, mereka menangkap manusia."
 },
 {
   "id": 19090,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 27,
   "firman": "Seperti sangkar menjadi penuh dengan burung-burung, demikianlah rumah mereka menjadi penuh dengan tipu; itulah sebabnya mereka menjadi orang besar dan kaya,"
 },
 {
   "id": 19091,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 28,
   "firman": "orang gemuk dan gendut. Di samping itu mereka membiarkan berlalu kejahatan-kejahatan, tidak mengindahkan hukum, tidak memenangkan perkara anak yatim, dan tidak membela hak orang miskin."
 },
 {
   "id": 19092,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 29,
   "firman": "Masakan Aku tidak menghukum mereka karena semuanya ini?, demikianlah firman TUHAN. Masakan Aku tidak membalas dendam-Ku kepada bangsa yang seperti ini?\""
 },
 {
   "id": 19093,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 30,
   "firman": "Kedahsyatan dan kengerian terjadi di negeri ini:"
 },
 {
   "id": 19094,
   "kitab": "Yer",
   "pasal": 5,
   "ayat": 31,
   "firman": "Para nabi bernubuat palsu dan para imam mengajar dengan sewenang-wenang, dan umat-Ku menyukai yang demikian! Tetapi apakah yang akan kamu perbuat, apabila datang kesudahannya?"
 },
 {
   "id": 19095,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 1,
   "firman": "Larilah mengungsi, hai orang-orang Benyamin, dari tengah-tengah Yerusalem! Tiuplah sangkakala di Tekoa, dan naikkanlah asap sebagai tanda di atas Bet-Kerem! Sebab malapetaka telah mengintai dari utara, yakni suatu kehancuran besar."
 },
 {
   "id": 19096,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 2,
   "firman": "Adakah puteri Sion sama seperti padang yang paling disukai,"
 },
 {
   "id": 19097,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 3,
   "firman": "sehingga gembala-gembala mendatanginya beserta kawanan ternak mereka? Mereka telah memasang kemah-kemahnya sekelilingnya, masing-masing memakan habis apa yang didapatnya."
 },
 {
   "id": 19098,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 4,
   "firman": "\"Persiapkanlah perang melawan dia; ayo, marilah kita maju menyerang pada tengah hari!\" \"Celakalah kita, sebab matahari sudah lingsir, bayang-bayang senja hari sudah memanjang!\""
 },
 {
   "id": 19099,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 5,
   "firman": "\"Ayo, marilah kita maju menyerang pada waktu malam dan merusakkan puri-purinya!\""
 },
 {
   "id": 19100,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 6,
   "firman": "Sebab beginilah firman TUHAN semesta alam: \"Tebanglah pohon-pohonnya dan timbunlah tanah menjadi tembok terhadap Yerusalem! Itulah kota yang harus dihukum! Hanya penindasan saja di dalamnya!"
 },
 {
   "id": 19101,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 7,
   "firman": "Seperti mata air meluapkan airnya, demikianlah kota itu meluapkan kejahatannya. Kekerasan dan aniaya terdengar di dalamnya, luka dan pukulan selalu ada Kulihat."
 },
 {
   "id": 19102,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 8,
   "firman": "Terimalah penghajaran, hai Yerusalem, supaya Aku jangan menarik diri dari padamu, supaya Aku jangan membuat engkau sunyi sepi, menjadi negeri yang tidak berpenduduk!\""
 },
 {
   "id": 19103,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 9,
   "firman": "Beginilah firman TUHAN semesta alam: \"Petiklah habis-habisan sisa-sisa orang Israel seperti pokok anggur dipetik habis-habisan. Kembalilah seperti pemetik buah anggur dengan tanganmu mencari-cari buah pada ranting-rantingnya.\""
 },
 {
   "id": 19104,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 10,
   "firman": "Kepada siapakah aku harus berbicara dan bersaksi, supaya mereka mau memperhatikan? Sungguh, telinga mereka tidak bersunat, mereka tidak dapat mendengar! Sungguh, firman TUHAN menjadi cemoohan bagi mereka, mereka tidak menyukainya!"
 },
 {
   "id": 19105,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 11,
   "firman": "Tetapi aku penuh dengan kehangatan murka TUHAN, aku telah payah menahannya, harus menumpahkannya kepada bayi di jalan, dan kepada kumpulan teruna bersama-sama. Sesungguhnya, baik laki-laki maupun perempuan akan ditangkap, baik orang yang tua maupun orang yang sudah lanjut usianya."
 },
 {
   "id": 19106,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 12,
   "firman": "Rumah-rumah mereka akan beralih kepada orang lain, bersama ladang-ladang dan isteri-isteri mereka. --\"Sesungguhnya, Aku mengacungkan tangan-Ku melawan penduduk negeri ini, demikianlah firman TUHAN."
 },
 {
   "id": 19107,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 13,
   "firman": "Sesungguhnya, dari yang kecil sampai yang besar di antara mereka, semuanya mengejar untung, baik nabi maupun imam semuanya melakukan tipu."
 },
 {
   "id": 19108,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 14,
   "firman": "Mereka mengobati luka umat-Ku dengan memandangnya ringan, katanya: Damai sejahtera! Damai sejahtera!, tetapi tidak ada damai sejahtera."
 },
 {
   "id": 19109,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 15,
   "firman": "Seharusnya mereka merasa malu, sebab mereka melakukan kejijikan; tetapi mereka sama sekali tidak merasa malu dan tidak kenal noda mereka. Sebab itu mereka akan rebah di antara orang-orang yang rebah; mereka akan tersandung jatuh pada waktu Aku menghukum mereka, firman TUHAN.\""
 },
 {
   "id": 19110,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 16,
   "firman": "Beginilah firman TUHAN: \"Ambillah tempatmu di jalan-jalan dan lihatlah, tanyakanlah jalan-jalan yang dahulu kala, di manakah jalan yang baik, tempuhlah itu, dengan demikian jiwamu mendapat ketenangan. Tetapi mereka berkata: Kami tidak mau menempuhnya!"
 },
 {
   "id": 19111,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 17,
   "firman": "Juga aku mengangkat atas mereka penjaga-penjaga, firman-Ku: Perhatikanlah bunyi sangkakala! Tetapi mereka berkata: Kami tidak mau memperhatikannya!"
 },
 {
   "id": 19112,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 18,
   "firman": "Sebab itu dengarlah, hai bangsa-bangsa, dan ketahuilah, hai jemaat, apa yang akan terjadi atas mereka!"
 },
 {
   "id": 19113,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 19,
   "firman": "Dengarlah, hai bumi! Sungguh, ke atas bangsa ini Aku akan mendatangkan malapetaka, akibat dari rancangan-rancangan mereka, sebab mereka tidak memperhatikan perkataan-perkataan-Ku dan menolak pengajaran-Ku."
 },
 {
   "id": 19114,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 20,
   "firman": "Apakah gunanya bagi-Ku kamu bawa kemenyan dari Syeba dan tebu yang baik dari negeri yang jauh? Aku tidak berkenan kepada korban-korban bakaranmu dan korban-korban sembelihanmu tidak menyenangkan hati-Ku."
 },
 {
   "id": 19115,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 21,
   "firman": "Sebab itu beginilah firman TUHAN: Sungguh, Aku akan menaruh batu sandungan di depan bangsa ini, supaya mereka jatuh tersandung oleh karenanya; bapa-bapa serta dengan anak-anak, tetangga dan temannya, semuanya akan binasa.\""
 },
 {
   "id": 19116,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 22,
   "firman": "Beginilah firman TUHAN: \"Sesungguhnya, suatu bangsa akan datang dari tanah utara, suatu suku bangsa yang besar akan bergerak maju dari ujung bumi."
 },
 {
   "id": 19117,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 23,
   "firman": "Mereka memakai panah dan tombak; mereka bengis, tidak kenal belas kasihan. Suara mereka gemuruh seperti laut, mereka mengendarai kuda, berlengkap seperti orang maju berperang, menyerang engkau, hai puteri Sion!\""
 },
 {
   "id": 19118,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 24,
   "firman": "Kami telah mendengar kabarnya, tangan kami sudah menjadi lemah lesu; kesesakan telah menyergap kami, kami kesakitan seperti perempuan yang melahirkan."
 },
 {
   "id": 19119,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 25,
   "firman": "\"Janganlah keluar ke padang, dan janganlah berjalan di jalan, sebab pedang musuh mengamuk--kegentaran datang dari segala jurusan!\""
 },
 {
   "id": 19120,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 26,
   "firman": "Hai puteri bangsaku, kenakanlah kain kabung, dan berguling-gulinglah dalam debu! Berkabunglah seperti menangisi seorang anak tunggal, merataplah dengan pahit pedih! Sebab sekonyong-konyong akan datang si pembinasa menyerangmu."
 },
 {
   "id": 19121,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 27,
   "firman": "Aku telah mengangkat engkau di antara umat-Ku sebagai penguji, engkau harus tahu bagaimana menyelidikinya, dan harus menguji tingkah langkah mereka."
 },
 {
   "id": 19122,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 28,
   "firman": "Semua mereka adalah pendurhaka belaka, berjalan kian kemari sebagai pemfitnah; sekaliannya mereka berlaku busuk!"
 },
 {
   "id": 19123,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 29,
   "firman": "Puputan sudah mengembus, tetapi yang keluar dari api hanya timah hitam, tembaga dan besi. Sia-sia orang melebur terus-menerus, tetapi orang-orang yang jahat tidak terpisahkan."
 },
 {
   "id": 19124,
   "kitab": "Yer",
   "pasal": 6,
   "ayat": 30,
   "firman": "Sebutkanlah mereka perak yang ditolak, sebab TUHAN telah menolak mereka!"
 },
 {
   "id": 19125,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 1,
   "firman": "Firman yang datang kepada Yeremia dari pada TUHAN, bunyinya:"
 },
 {
   "id": 19126,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 2,
   "firman": "\"Berdirilah di pintu gerbang rumah TUHAN, serukanlah di sana firman ini dan katakanlah: Dengarlah firman TUHAN, hai sekalian orang Yehuda yang masuk melalui semua pintu gerbang ini untuk sujud menyembah kepada TUHAN!"
 },
 {
   "id": 19127,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 3,
   "firman": "Beginilah firman TUHAN semesta alam, Allah Israel: Perbaikilah tingkah langkahmu dan perbuatanmu, maka Aku mau diam bersama-sama kamu di tempat ini."
 },
 {
   "id": 19128,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 4,
   "firman": "Janganlah percaya kepada perkataan dusta yang berbunyi: Ini bait TUHAN, bait TUHAN, bait TUHAN,"
 },
 {
   "id": 19129,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 5,
   "firman": "melainkan jika kamu sungguh-sungguh memperbaiki tingkah langkahmu dan perbuatanmu, jika kamu sungguh-sungguh melaksanakan keadilan di antara kamu masing-masing,"
 },
 {
   "id": 19130,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 6,
   "firman": "tidak menindas orang asing, yatim dan janda, tidak menumpahkan darah orang yang tak bersalah di tempat ini dan tidak mengikuti allah lain, yang menjadi kemalanganmu sendiri,"
 },
 {
   "id": 19131,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 7,
   "firman": "maka Aku mau diam bersama-sama kamu di tempat ini, di tanah yang telah Kuberikan kepada nenek moyangmu, dari dahulu kala sampai selama-lamanya."
 },
 {
   "id": 19132,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 8,
   "firman": "Tetapi sesungguhnya, kamu percaya kepada perkataan dusta yang tidak memberi faedah."
 },
 {
   "id": 19133,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 9,
   "firman": "Masakan kamu mencuri, membunuh, berzinah dan bersumpah palsu, membakar korban kepada Baal dan mengikuti allah lain yang tidak kamu kenal,"
 },
 {
   "id": 19134,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 10,
   "firman": "kemudian kamu datang berdiri di hadapan-Ku di rumah yang atasnya nama-Ku diserukan, sambil berkata: Kita selamat, supaya dapat pula melakukan segala perbuatan yang keji ini!"
 },
 {
   "id": 19135,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 11,
   "firman": "Sudahkah menjadi sarang penyamun di matamu rumah yang atasnya nama-Ku diserukan ini? Kalau Aku, Aku sendiri melihat semuanya, demikianlah firman TUHAN."
 },
 {
   "id": 19136,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 12,
   "firman": "Tetapi baiklah pergi dahulu ke tempat-Ku yang di Silo itu, di mana Aku membuat nama-Ku diam dahulu, dan lihatlah apa yang telah Kulakukan kepadanya karena kejahatan umat-Ku Israel!"
 },
 {
   "id": 19137,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 13,
   "firman": "Maka sekarang, oleh karena kamu telah melakukan segala perbuatan itu juga, demikianlah firman TUHAN, dan oleh karena kamu tidak mau mendengarkan, sekalipun Aku berbicara kepadamu terus-menerus, dan kamu tidak mau menjawab, sekalipun Aku berseru kepadamu,"
 },
 {
   "id": 19138,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 14,
   "firman": "karena itulah kepada rumah, yang atasnya nama-Ku diserukan dan yang kamu andalkan itu, dan kepada tempat, yang telah Kuberikan kepadamu dan kepada nenek moyangmu itu, akan Kulakukan seperti yang telah Kulakukan kepada Silo;"
 },
 {
   "id": 19139,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 15,
   "firman": "Aku akan melemparkan kamu dari hadapan-Ku, seperti semua saudaramu, yakni seluruh keturunan Efraim, telah Kulemparkan.\""
 },
 {
   "id": 19140,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 16,
   "firman": "\"Tetapi engkau, janganlah berdoa untuk bangsa ini, janganlah sampaikan seruan permohonan dan doa untuk mereka, dan janganlah desak Aku, sebab Aku tidak akan mendengarkan engkau."
 },
 {
   "id": 19141,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 17,
   "firman": "Tiadakah engkau melihat apa yang dilakukan mereka di kota-kota Yehuda dan di jalan-jalan Yerusalem?"
 },
 {
   "id": 19142,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 18,
   "firman": "Anak-anak memungut kayu bakar, bapa-bapa menyalakan api dan perempuan-perempuan meremas adonan untuk membuat penganan persembahan bagi ratu sorga, dan orang mempersembahkan korban curahan kepada allah lain dengan maksud menyakiti hati-Ku."
 },
 {
   "id": 19143,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 19,
   "firman": "Hati-Kukah sebenarnya yang mereka sakiti, demikianlah firman TUHAN, bukankah hati mereka sendiri, sehingga mereka menjadi malu?"
 },
 {
   "id": 19144,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 20,
   "firman": "Sebab itu beginilah firman Tuhan ALLAH: Sesungguhnya, murka-Ku dan kehangatan amarah-Ku akan tercurah ke tempat ini, ke atas manusia, ke atas hewan, ke atas pohon-pohonan di padang dan ke atas hasil tanah; amarah itu akan menyala-nyala dengan tidak padam-padam.\""
 },
 {
   "id": 19145,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 21,
   "firman": "Beginilah firman TUHAN semesta alam, Allah Israel: \"Tambah sajalah korban bakaranmu kepada korban sembelihanmu dan nikmatilah dagingnya!"
 },
 {
   "id": 19146,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 22,
   "firman": "Sungguh, pada waktu Aku membawa nenek moyangmu keluar dari tanah Mesir Aku tidak mengatakan atau memerintahkan kepada mereka sesuatu tentang korban bakaran dan korban sembelihan;"
 },
 {
   "id": 19147,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 23,
   "firman": "hanya yang berikut inilah yang telah Kuperintahkan kepada mereka: Dengarkanlah suara-Ku, maka Aku akan menjadi Allahmu dan kamu akan menjadi umat-Ku, dan ikutilah seluruh jalan yang Kuperintahkan kepadamu, supaya kamu berbahagia!"
 },
 {
   "id": 19148,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 24,
   "firman": "Tetapi mereka tidak mau mendengarkan dan tidak mau memberi perhatian, melainkan mereka mengikuti rancangan-rancangan dan kedegilan hatinya yang jahat, dan mereka memperlihatkan belakangnya dan bukan mukanya."
 },
 {
   "id": 19149,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 25,
   "firman": "Dari sejak waktu nenek moyangmu keluar dari tanah Mesir sampai waktu ini, Aku mengutus kepada mereka hamba-hamba-Ku, para nabi, hari demi hari, terus-menerus,"
 },
 {
   "id": 19150,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 26,
   "firman": "tetapi mereka tidak mau mendengarkan kepada-Ku dan tidak mau memberi perhatian, bahkan mereka menegarkan tengkuknya, berbuat lebih jahat dari pada nenek moyang mereka."
 },
 {
   "id": 19151,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 27,
   "firman": "Sekalipun engkau mengatakan kepada mereka segala perkara ini, mereka tidak akan mendengarkan perkataanmu, dan sekalipun engkau berseru kepada mereka, mereka tidak akan menjawab engkau."
 },
 {
   "id": 19152,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 28,
   "firman": "Sebab itu, katakanlah kepada mereka: Inilah bangsa yang tidak mau mendengarkan suara TUHAN, Allah mereka, dan yang tidak mau menerima penghajaran! Ketulusan mereka sudah lenyap, sudah hapus dari mulut mereka.\""
 },
 {
   "id": 19153,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 29,
   "firman": "Cukurlah rambut kepalamu dan buanglah! Angkatlah ratapan di atas bukit-bukit gundul, sebab TUHAN telah menolak dan membuang bangsa yang kena murka-Nya!"
 },
 {
   "id": 19154,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 30,
   "firman": "Sungguh, orang Yehuda telah melakukan apa yang jahat di mata-Ku, demikianlah firman TUHAN, telah menempatkan dewa-dewa mereka yang menjijikkan di rumah yang atasnya nama-Ku diserukan ini untuk menajiskannya."
 },
 {
   "id": 19155,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 31,
   "firman": "Mereka telah mendirikan bukit pengorbanan yang bernama Tofet di Lembah Ben-Hinom untuk membakar anak-anaknya lelaki dan perempuan, suatu hal yang tidak pernah Kuperintahkan dan yang tidak pernah timbul dalam hati-Ku."
 },
 {
   "id": 19156,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 32,
   "firman": "Sebab itu, sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa orang tidak akan mengatakan lagi \"Tofet\" dan \"Lembah Ben-Hinom\", melainkan \"Lembah Pembunuhan\"; orang akan menguburkan mayat di Tofet karena kekurangan tempat,"
 },
 {
   "id": 19157,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 33,
   "firman": "bahkan mayat bangsa ini akan menjadi makanan burung-burung di udara serta binatang-binatang di bumi dengan tidak ada yang mengganggunya."
 },
 {
   "id": 19158,
   "kitab": "Yer",
   "pasal": 7,
   "ayat": 34,
   "firman": "Di kota-kota Yehuda serta di jalan-jalan Yerusalem akan Kuhentikan suara kegirangan dan suara sukacita, suara pengantin laki-laki dan suara pengantin perempuan, sebab negeri itu akan menjadi tempat yang tandus."
 },
 {
   "id": 19159,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada masa itu, demikianlah firman TUHAN, tulang-tulang raja-raja Yehuda, tulang-tulang pemuka-pemukanya, tulang-tulang imam-imam, tulang-tulang nabi-nabi dan tulang-tulang segenap penduduk Yerusalem akan dikeluarkan dari dalam kubur mereka"
 },
 {
   "id": 19160,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 2,
   "firman": "dan diserakkan di depan matahari, di depan bulan dan di depan segenap tentara langit yang dahulunya dicintai, diabdi, diikuti, ditanyakan dan disembah oleh mereka. Semuanya itu tidak akan dikumpulkan dan tidak akan dikuburkan; mereka akan menjadi pupuk di ladang."
 },
 {
   "id": 19161,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 3,
   "firman": "Tetapi semua orang yang masih tinggal dari kaum yang jahat ini akan lebih suka mati dari pada hidup di segala tempat ke mana Aku menceraiberaikan mereka, demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 19162,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 4,
   "firman": "Engkau harus mengatakan kepada mereka: \"Beginilah firman TUHAN: Apabila orang jatuh, masakan ia tidak bangun kembali? Apabila orang berpaling, masakan ia tidak kembali?"
 },
 {
   "id": 19163,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 5,
   "firman": "Mengapakah bangsa ini berpaling, berpaling terus-menerus? Mereka berpegang pada tipu, mereka menolak untuk kembali."
 },
 {
   "id": 19164,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 6,
   "firman": "Aku telah memperhatikan dan mendengarkan: mereka tidak berkata dengan jujur! Tidak ada yang menyesal karena kejahatannya dengan mengatakan: Apakah yang telah kulakukan ini! Sambil berlari semua mereka berpaling, seperti kuda yang menceburkan diri ke dalam pertempuran."
 },
 {
   "id": 19165,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 7,
   "firman": "Bahkan burung ranggung di udara mengetahui musimnya, burung tekukur, burung layang-layang dan burung bangau berpegang pada waktu kembalinya, tetapi umat-Ku tidak mengetahui hukum TUHAN."
 },
 {
   "id": 19166,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 8,
   "firman": "Bagaimanakah kamu berani berkata: Kami bijaksana, dan kami mempunyai Taurat TUHAN? Sesungguhnya, pena palsu penyurat sudah membuatnya menjadi bohong."
 },
 {
   "id": 19167,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 9,
   "firman": "Orang-orang bijaksana akan menjadi malu, akan terkejut dan tertangkap. Sesungguhnya, mereka telah menolak firman TUHAN, maka kebijaksanaan apakah yang masih ada pada mereka?"
 },
 {
   "id": 19168,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 10,
   "firman": "Sebab itu Aku akan memberikan isteri-isteri mereka kepada orang lain, ladang-ladang mereka kepada penjajah. Sesungguhnya, dari yang kecil sampai yang besar, semuanya mengejar untung; baik nabi maupun imam, semuanya melakukan tipu."
 },
 {
   "id": 19169,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 11,
   "firman": "Mereka mengobati luka puteri umat-Ku dengan memandangnya ringan, katanya: Damai sejahtera! Damai sejahtera!, tetapi tidak ada damai sejahtera."
 },
 {
   "id": 19170,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 12,
   "firman": "Seharusnya mereka merasa malu, sebab mereka melakukan kejijikan; tetapi mereka sama sekali tidak merasa malu dan tidak kenal noda mereka. Sebab itu mereka akan rebah di antara orang-orang yang rebah, mereka akan tersandung jatuh pada waktu mereka dihukum, firman TUHAN."
 },
 {
   "id": 19171,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 13,
   "firman": "Aku mau memungut hasil mereka, demikianlah firman TUHAN, tetapi tidak ada buah anggur pada pohon anggur, tidak ada buah ara pada pohon ara, dan daun-daunan sudah layu; sebab itu Aku akan menetapkan bagi mereka orang-orang yang akan melindas mereka.\""
 },
 {
   "id": 19172,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 14,
   "firman": "Mengapakah kita duduk-duduk saja? Berkumpullah dan marilah kita pergi ke kota-kota yang berkubu dan binasa di sana! Sebab TUHAN, Allah kita, membinasakan kita, memberi kita minum racun, sebab kita telah berdosa kepada TUHAN."
 },
 {
   "id": 19173,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 15,
   "firman": "Kita mengharapkan damai, tetapi tidak datang sesuatu yang baik, mengharapkan waktu kesembuhan, tetapi yang ada hanya kengerian!"
 },
 {
   "id": 19174,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 16,
   "firman": "\"Dengus kuda musuh terdengar dari Dan; karena bunyi ringkik kuda jantan mereka gemetarlah seluruh negeri. Mereka datang dan memakan habis negeri dengan isinya, kota dengan penduduknya."
 },
 {
   "id": 19175,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 17,
   "firman": "Lihatlah, Aku melepaskan ke antaramu ular-ular beludak, yang tidak dapat dimanterai, yang akan memagut kamu, demikianlah firman TUHAN.\""
 },
 {
   "id": 19176,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 18,
   "firman": "Tidak tersembuhkan kedukaan yang menimpa diriku, hatiku sakit pedih."
 },
 {
   "id": 19177,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 19,
   "firman": "Dengar! seruan puteri bangsaku minta tolong dari negeri yang jauh: \"Tidak adakah TUHAN di Sion? Tidak adakah Rajanya di dalamnya?\" --Mengapakah mereka menimbulkan sakit hati-Ku dengan patung-patung mereka, dengan dewa-dewa asing yang sia-sia? --"
 },
 {
   "id": 19178,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 20,
   "firman": "Sudah lewat musim menuai, sudah berakhir musim kemarau, tetapi kita belum diselamatkan juga!"
 },
 {
   "id": 19179,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 21,
   "firman": "Karena luka puteri bangsaku hatiku luka; aku berkabung, kedahsyatan telah menyergap aku."
 },
 {
   "id": 19180,
   "kitab": "Yer",
   "pasal": 8,
   "ayat": 22,
   "firman": "Tidak adakah balsam di Gilead? Tidak adakah tabib di sana? Mengapakah belum datang juga kesembuhan luka puteri bangsaku?"
 },
 {
   "id": 19181,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 1,
   "firman": "Sekiranya kepalaku penuh air, dan mataku jadi pancuran air mata, maka siang malam aku akan menangisi orang-orang puteri bangsaku yang terbunuh!"
 },
 {
   "id": 19182,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 2,
   "firman": "Sekiranya di padang gurun aku mempunyai tempat penginapan bagi orang-orang yang sedang dalam perjalanan, maka aku akan meninggalkan bangsaku dan menyingkir dari pada mereka! Sebab mereka sekalian adalah orang-orang berzinah, suatu kumpulan orang-orang yang tidak setia."
 },
 {
   "id": 19183,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 3,
   "firman": "Mereka melenturkan lidahnya seperti busur; dusta dan bukan kebenaran merajalela dalam negeri; sungguh, mereka melangkah dari kejahatan kepada kejahatan, tetapi TUHAN tidaklah mereka kenal."
 },
 {
   "id": 19184,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 4,
   "firman": "Baiklah setiap orang berjaga-jaga terhadap temannya, dan janganlah percaya kepada saudara manapun, sebab setiap saudara adalah penipu ulung, dan setiap teman berjalan kian ke mari sebagai pemfitnah."
 },
 {
   "id": 19185,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 5,
   "firman": "Yang seorang menipu yang lain, dan tidak seorangpun berkata benar; mereka sudah membiasakan lidahnya untuk berkata dusta; mereka melakukan kesalahan dan malas untuk bertobat."
 },
 {
   "id": 19186,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 6,
   "firman": "Penindasan ditimbuni penindasan, tipu ditimbuni tipu! Mereka enggan mengenal TUHAN."
 },
 {
   "id": 19187,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 7,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam: \"Sesungguhnya, Aku mau melebur dan menguji mereka, sebab apakah lagi yang dapat Kulakukan terhadap puteri umat-Ku?"
 },
 {
   "id": 19188,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 8,
   "firman": "Lidah mereka adalah anak panah yang membunuh, perkataan dari mulutnya adalah tipu; mereka berbicara damai dengan temannya, tetapi dalam hatinya mereka merancang pengadangan terhadapnya."
 },
 {
   "id": 19189,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 9,
   "firman": "Masakan Aku tidak menghukum mereka karena semuanya ini?, demikianlah firman TUHAN. Masakan Aku tidak membalas dendam-Ku kepada bangsa yang seperti ini?"
 },
 {
   "id": 19190,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 10,
   "firman": "Menangis dan merintihlah karena gunung-gunung, dan merataplah karena padang rumput di gurun, sebab semuanya sudah tandus sampai tidak ada orang yang melintasinya, dan orang tidak mendengar lagi suara ternak; baik burung-burung di udara maupun binatang-binatang, semuanya telah lari dan sudah lenyap."
 },
 {
   "id": 19191,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 11,
   "firman": "Aku akan membuat Yerusalem menjadi timbunan puing, tempat persembunyian serigala-serigala; Aku akan membuat kota-kota Yehuda menjadi sunyi sepi, tidak berpenduduk lagi.\""
 },
 {
   "id": 19192,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 12,
   "firman": "Siapakah orang yang begitu bijaksana, sehingga ia dapat mengerti hal ini, orang yang telah menerima firman dari mulut TUHAN, supaya ia dapat memberitahukannya? Apakah sebabnya negeri ini binasa, tandus seperti padang gurun sampai tidak ada orang yang melintasinya?"
 },
 {
   "id": 19193,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 13,
   "firman": "Berfirmanlah TUHAN: \"Oleh karena mereka meninggalkan Taurat-Ku yang telah Kuserahkan kepada mereka, dan oleh karena mereka tidak mendengarkan suara-Ku dan tidak mengikutinya,"
 },
 {
   "id": 19194,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 14,
   "firman": "melainkan mengikuti kedegilan hatinya dan mengikuti para Baal seperti yang diajarkan kepada mereka oleh nenek moyang mereka."
 },
 {
   "id": 19195,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 15,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku akan memberi bangsa ini makan ipuh dan minum racun."
 },
 {
   "id": 19196,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 16,
   "firman": "Aku akan menyerakkan mereka ke antara bangsa-bangsa yang tidak dikenal oleh mereka atau oleh nenek moyang mereka, dan Aku akan melepas pedang mengejar mereka sampai Aku membinasakan mereka.\""
 },
 {
   "id": 19197,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 17,
   "firman": "Perhatikanlah! Panggillah perempuan-perempuan peratap, supaya mereka datang, dan suruhlah orang kepada perempuan-perempuan yang bijaksana, supaya mereka datang!"
 },
 {
   "id": 19198,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 18,
   "firman": "Biarlah mereka bersegera dan meratap karena kita, supaya mata kita mencucurkan air mata, dan kelopak mata kita melelehkan air!"
 },
 {
   "id": 19199,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sebab terdengar ratapan dari Sion: Wahai binasalah kami! Kami sangat dipermalukan! Sebab kami harus meninggalkan negeri ini, karena rumah-rumah kediaman kami dirobohkan orang."
 },
 {
   "id": 19200,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 20,
   "firman": "Maka dengarlah firman TUHAN, hai perempuan-perempuan, biarlah telingamu menerima firman dari mulut-Nya; ajarkanlah ratapan kepada anak-anakmu perempuan, dan oleh setiap perempuan nyanyian ratapan kepada temannya:"
 },
 {
   "id": 19201,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 21,
   "firman": "\"Maut telah menyusup ke jendela-jendela kita, masuk ke dalam istana-istana kita; ia melenyapkan kanak-kanak dari jalan, pemuda-pemuda dari lapangan;"
 },
 {
   "id": 19202,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 22,
   "firman": "mayat-mayat manusia berhantaran seperti pupuk di ladang, seperti berkas gandum di belakang orang-orang yang menuai tanpa ada yang mengumpulkan.\""
 },
 {
   "id": 19203,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 23,
   "firman": "Beginilah firman TUHAN: \"Janganlah orang bijaksana bermegah karena kebijaksanaannya, janganlah orang kuat bermegah karena kekuatannya, janganlah orang kaya bermegah karena kekayaannya,"
 },
 {
   "id": 19204,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 24,
   "firman": "tetapi siapa yang mau bermegah, baiklah bermegah karena yang berikut: bahwa ia memahami dan mengenal Aku, bahwa Akulah TUHAN yang menunjukkan kasih setia, keadilan dan kebenaran di bumi; sungguh, semuanya itu Kusukai, demikianlah firman TUHAN.\""
 },
 {
   "id": 19205,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 25,
   "firman": "\"Lihat, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku menghukum orang-orang yang telah bersunat kulit khatannya:"
 },
 {
   "id": 19206,
   "kitab": "Yer",
   "pasal": 9,
   "ayat": 26,
   "firman": "orang Mesir, orang Yehuda, orang Edom, bani Amon, orang Moab dan semua orang yang berpotong tepi rambutnya berkeliling, orang-orang yang diam di padang gurun, sebab segala bangsa tidak bersunat dan segenap kaum Israel tidak bersunat hatinya.\""
 },
 {
   "id": 19207,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 1,
   "firman": "Dengarlah firman yang disampaikan TUHAN kepadamu, hai kaum Israel!"
 },
 {
   "id": 19208,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN: \"Janganlah biasakan dirimu dengan tingkah langkah bangsa-bangsa, janganlah gentar terhadap tanda-tanda di langit, sekalipun bangsa-bangsa gentar terhadapnya."
 },
 {
   "id": 19209,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 3,
   "firman": "Sebab yang disegani bangsa-bangsa adalah kesia-siaan. Bukankah berhala itu pohon kayu yang ditebang orang dari hutan, yang dikerjakan dengan pahat oleh tangan tukang kayu?"
 },
 {
   "id": 19210,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 4,
   "firman": "Orang memperindahnya dengan emas dan perak; orang memperkuatnya dengan paku dan palu, supaya jangan goyang."
 },
 {
   "id": 19211,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 5,
   "firman": "Berhala itu sama seperti orang-orangan di kebun mentimun, tidak dapat berbicara; orang harus mengangkatnya, sebab tidak dapat melangkah. Janganlah takut kepadanya, sebab berhala itu tidak dapat berbuat jahat, dan berbuat baikpun tidak dapat.\""
 },
 {
   "id": 19212,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 6,
   "firman": "Tidak ada yang sama seperti Engkau, ya TUHAN! Engkau besar dan nama-Mu besar oleh keperkasaan."
 },
 {
   "id": 19213,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 7,
   "firman": "Siapakah yang tidak takut kepada-Mu, ya Raja bangsa-bangsa? Sungguh, kepada-Mulah seharusnya sikap yang demikian; sebab di antara semua orang bijaksana dari bangsa-bangsa dan di antara raja-raja mereka tidak ada yang sama seperti Engkau!"
 },
 {
   "id": 19214,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 8,
   "firman": "Berhala itu semuanya bodoh dan dungu; petunjuk dewa itu sia-sia, karena ia hanya kayu belaka. --"
 },
 {
   "id": 19215,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 9,
   "firman": "Perak kepingan dibawa dari Tarsis, dan emas dari Ufas; berhala itu buatan tukang dan buatan tangan pandai emas. Pakaiannya dari kain ungu tua dan kain ungu muda, semuanya buatan orang-orang ahli. --"
 },
 {
   "id": 19216,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 10,
   "firman": "Tetapi TUHAN adalah Allah yang benar, Dialah Allah yang hidup dan Raja yang kekal. Bumi goncang karena murka-Nya, dan bangsa-bangsa tidak tahan akan geram-Nya."
 },
 {
   "id": 19217,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 11,
   "firman": "Beginilah harus kamu katakan kepada mereka: \"Para allah yang tidak menjadikan langit dan bumi akan lenyap dari bumi dan dari kolong langit ini.\""
 },
 {
   "id": 19218,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 12,
   "firman": "Tuhanlah yang menjadikan bumi dengan kekuatan-Nya, yang menegakkan dunia dengan kebijaksanaan-Nya, dan yang membentangkan langit dengan akal budi-Nya."
 },
 {
   "id": 19219,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 13,
   "firman": "Apabila Ia memperdengarkan suara-Nya, menderulah bunyi air di langit, Ia menaikkan kabut awan dari ujung bumi, Ia membuat kilat serta dengan hujan, dan mengeluarkan angin dari perbendaharaan-Nya."
 },
 {
   "id": 19220,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 14,
   "firman": "Setiap manusia ternyata bodoh, tidak berpengetahuan, dan setiap pandai emas menjadi malu karena patung buatannya. Sebab patung tuangannya itu adalah tipu, tidak ada nyawa di dalamnya,"
 },
 {
   "id": 19221,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 15,
   "firman": "semuanya adalah kesia-siaan, pekerjaan yang menjadi buah ejekan, dan yang akan binasa pada waktu dihukum."
 },
 {
   "id": 19222,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 16,
   "firman": "Tidaklah begitu Dia yang menjadi bagian Yakub, sebab Dialah yang membentuk segala-galanya, dan Israel adalah suku milik-Nya; nama-Nya ialah TUHAN semesta alam!"
 },
 {
   "id": 19223,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 17,
   "firman": "Angkutlah barang-barangmu dari negeri ini, hai orang-orang yang berada dalam pengepungan!"
 },
 {
   "id": 19224,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 18,
   "firman": "Sebab beginilah firman TUHAN: \"Sesungguhnya, sekali ini Aku akan melemparkan penduduk negeri ini, dan Aku akan menyesakkan mereka, supaya mereka merasakannya.\" --"
 },
 {
   "id": 19225,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 19,
   "firman": "Celakalah aku karena penyakitku, lukaku tidak tersembuhkan! Aku berpikir: \"Ah, inilah suatu kepedihan yang harus kutanggung!\""
 },
 {
   "id": 19226,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 20,
   "firman": "Kemahku sudah rusak, dan semua talinya sudah putus. Anak-anakku telah pergi dari padaku, tidak ada lagi; tidak ada lagi yang mendirikan kemahku dan yang membentangkan tendaku. --"
 },
 {
   "id": 19227,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 21,
   "firman": "Sungguh, gembala-gembala sudah menjadi bodoh, mereka tidak menanyakan petunjuk TUHAN. Sebab itu mereka tidak berbahagia dan seluruh binatang gembalaan mereka cerai-berai."
 },
 {
   "id": 19228,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 22,
   "firman": "Terdengarlah suatu berita, bunyinya: Kegemparan besar akan datang dari tanah sebelah utara, untuk membuat kota-kota Yehuda menjadi sunyi sepi, menjadi tempat persembunyian serigala-serigala."
 },
 {
   "id": 19229,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 23,
   "firman": "Aku tahu, ya TUHAN, bahwa manusia tidak berkuasa untuk menentukan jalannya, dan orang yang berjalan tidak berkuasa untuk menetapkan langkahnya."
 },
 {
   "id": 19230,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 24,
   "firman": "Hajarlah aku, ya TUHAN, tetapi dengan selayaknya, jangan dengan murka-Mu, supaya aku jangan Kaubinasakan!"
 },
 {
   "id": 19231,
   "kitab": "Yer",
   "pasal": 10,
   "ayat": 25,
   "firman": "Tumpahkanlah kepanasan amarah-Mu ke atas bangsa-bangsa yang tidak mengenal Engkau, ke atas kaum-kaum keluarga yang tidak menyerukan nama-Mu; sebab mereka telah memakan Yakub dan menghabisinya, dan membuat tempat kediamannya menjadi puing."
 },
 {
   "id": 19232,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 1,
   "firman": "Firman yang datang kepada Yeremia dari TUHAN, bunyinya:"
 },
 {
   "id": 19233,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 2,
   "firman": "\"Dengarlah perkataan-perkataan perjanjian ini dan sampaikanlah itu kepada orang Yehuda dan kepada penduduk Yerusalem!"
 },
 {
   "id": 19234,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 3,
   "firman": "Katakanlah kepada mereka: Beginilah firman TUHAN, Allah Israel: Terkutuklah orang yang tidak mendengarkan perkataan-perkataan perjanjian ini,"
 },
 {
   "id": 19235,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 4,
   "firman": "yang telah Kuperintahkan kepada nenek moyangmu pada waktu mereka Kubawa keluar dari tanah Mesir, dari dapur peleburan besi, dengan berfirman: Dengarkanlah suara-Ku dan lakukanlah segala apa yang Kuperintahkan kepadamu, maka kamu akan menjadi umat-Ku dan Aku akan menjadi Allahmu,"
 },
 {
   "id": 19236,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 5,
   "firman": "sehingga Aku dapat menepati sumpah yang telah Kuikrarkan kepada nenek moyangmu untuk memberikan kepada mereka tanah yang berlimpah-limpah susu dan madunya, seperti halnya pada waktu ini.\" Lalu jawabku: \"Begitulah hendaknya, ya TUHAN!\""
 },
 {
   "id": 19237,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 6,
   "firman": "Berfirmanlah TUHAN kepadaku: \"Serukanlah segala perkataan ini di kota-kota Yehuda dan di jalan-jalan Yerusalem dengan mengatakan: Dengarkanlah perkataan-perkataan perjanjian ini dan lakukanlah itu!"
 },
 {
   "id": 19238,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 7,
   "firman": "Sebab Aku sungguh-sungguh memperingatkan nenek moyangmu, pada waktu Aku menuntun mereka keluar dari tanah Mesir; sampai kepada waktu ini Aku memperingatkan mereka terus-menerus: Dengarkanlah suara-Ku!"
 },
 {
   "id": 19239,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 8,
   "firman": "Tetapi mereka tidak mau mendengarkan ataupun memperhatikannya, melainkan mereka masing-masing mengikuti kedegilan hatinya yang jahat; maka Aku telah mendatangkan ke atas mereka segala perkataan perjanjian ini, yang telah Kuperintahkan dipegang, tetapi mereka tidak memegangnya.\""
 },
 {
   "id": 19240,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 9,
   "firman": "Berfirmanlah TUHAN kepadaku: \"Telah terdapat persepakatan jahat di antara orang Yehuda dan penduduk Yerusalem."
 },
 {
   "id": 19241,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 10,
   "firman": "Mereka sudah jatuh kembali kepada kesalahan nenek moyang mereka yang dahulu telah menolak mendengarkan firman-Ku. Mereka mengikuti allah lain dan beribadah kepadanya. Kaum Israel dan kaum Yehuda telah mengingkari perjanjian-Ku yang telah Kuikat dengan nenek moyang mereka."
 },
 {
   "id": 19242,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 11,
   "firman": "Sebab itu beginilah firman TUHAN: Sesungguhnya, Aku mendatangkan ke atas mereka malapetaka yang tidak dapat mereka hindari, dan apabila mereka berseru-seru kepada-Ku, maka Aku tidak akan mendengarkan mereka."
 },
 {
   "id": 19243,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 12,
   "firman": "Dan biarpun kota-kota Yehuda dan penduduk Yerusalem pergi berseru-seru kepada para allah yang mereka sembah dengan korban bakaran, tetapi allah itu sama sekali tidak dapat menolong mereka pada waktu mereka ditimpa malapetaka."
 },
 {
   "id": 19244,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 13,
   "firman": "Sebab seperti banyaknya kotamu demikian banyaknya para allahmu, hai Yehuda, dan seperti banyaknya jalan di Yerusalem demikian banyaknya mezbah yang kamu dirikan untuk membakar korban kepada Baal."
 },
 {
   "id": 19245,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 14,
   "firman": "Adapun engkau, janganlah engkau berdoa untuk bangsa ini dan janganlah naikkan permohonan dan doa untuk mereka, sebab Aku tidak akan mendengarkan pada waktu mereka berseru kepada-Ku karena malapetaka mereka."
 },
 {
   "id": 19246,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 15,
   "firman": "Apakah lagi urusan kekasih-Ku di dalam rumah-Ku, bukankah ia sudah melaksanakan rancangan-rancangan yang jahat? Dapatkah nazar-nazar dan daging yang suci melewatkan malapetaka dari padamu, sehingga kemudian engkau dapat beria-ria?"
 },
 {
   "id": 19247,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 16,
   "firman": "Pohon zaitun yang rimbun, elok dipandang mata, pernah TUHAN menamai engkau. Tetapi dengan bunyi keributan yang hebat Ia menyalakan api pada daun-daunnya, sehingga ranting-rantingnya terbakar."
 },
 {
   "id": 19248,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 17,
   "firman": "TUHAN semesta alam, yang telah membuat engkau tumbuh, telah menentukan malapetaka atasmu karena kejahatan yang telah dilakukan oleh kaum Israel dan kaum Yehuda untuk menimbulkan sakit hati-Ku dengan membakar korban kepada Baal.\""
 },
 {
   "id": 19249,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 18,
   "firman": "TUHAN memberitahukan hal itu kepadaku, maka aku mengetahuinya; pada waktu itu Engkau, TUHAN, memperlihatkan perbuatan mereka kepadaku."
 },
 {
   "id": 19250,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 19,
   "firman": "Tetapi aku dulu seperti anak domba jinak yang dibawa untuk disembelih, aku tidak tahu bahwa mereka mengadakan persepakatan jahat terhadap aku: \"Marilah kita binasakan pohon ini dengan buah-buahnya! Marilah kita melenyapkannya dari negeri orang-orang yang hidup, sehingga namanya tidak diingat orang lagi!\""
 },
 {
   "id": 19251,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 20,
   "firman": "Tetapi, TUHAN semesta alam, yang menghakimi dengan adil, yang menguji batin dan hati, biarlah aku melihat pembalasan-Mu terhadap mereka, sebab kepada-Mulah kuserahkan perkaraku."
 },
 {
   "id": 19252,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 21,
   "firman": "Sebab itu beginilah firman TUHAN tentang orang-orang Anatot yang ingin mencabut nyawaku dengan mengatakan: \"Janganlah bernubuat demi nama TUHAN, supaya jangan engkau mati oleh tangan kami!\" --"
 },
 {
   "id": 19253,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 22,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam: \"Sesungguhnya, Aku akan menghukum mereka: pemuda-pemuda mereka akan mati oleh pedang, anak-anak mereka yang laki-laki dan perempuan akan habis mati kelaparan;"
 },
 {
   "id": 19254,
   "kitab": "Yer",
   "pasal": 11,
   "ayat": 23,
   "firman": "tidak ada yang tinggal hidup di antara mereka, sebab Aku akan mendatangkan malapetaka kepada orang-orang Anatot pada tahun hukuman mereka.\""
 },
 {
   "id": 19255,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 1,
   "firman": "Engkau memang benar, ya TUHAN, bilamana aku berbantah dengan Engkau! Tetapi aku mau berbicara dengan Engkau tentang keadilan: Mengapakah mujur hidup orang-orang fasik, sentosa semua orang yang berlaku tidak setia?"
 },
 {
   "id": 19256,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 2,
   "firman": "Engkau membuat mereka tumbuh, dan merekapun juga berakar, mereka tumbuh subur dan menghasilkan buah juga. Memang selalu Engkau di mulut mereka, tetapi jauh dari hati mereka."
 },
 {
   "id": 19257,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 3,
   "firman": "Ya TUHAN, Engkau mengenal aku, Engkau melihat aku, dan Engkau menguji bagaimana hatiku terhadap Engkau. Tariklah mereka ke luar seperti domba-domba sembelihan, dan khususkanlah mereka untuk hari penyembelihan. --"
 },
 {
   "id": 19258,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 4,
   "firman": "Berapa lama lagi negeri ini menjadi kering, dan rumput di segenap padang menjadi layu? Karena kejahatan penduduknya binatang-binatang dan burung-burung habis lenyap, sebab mereka telah mengira: \"Ia tidak akan melihat tingkah langkah kita!\""
 },
 {
   "id": 19259,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 5,
   "firman": "\"Jika engkau telah berlari dengan orang berjalan kaki, dan engkau telah dilelahkan, bagaimanakah engkau hendak berpacu melawan kuda? Dan jika di negeri yang damai engkau tidak merasa tenteram, apakah yang akan engkau perbuat di hutan belukar sungai Yordan?"
 },
 {
   "id": 19260,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 6,
   "firman": "Sebab saudara-saudaramu dan kaum keluargamu, mereka sendiri juga berbuat khianat terhadap engkau; mereka juga bersama-sama di belakangmu. Janganlah percaya kepada mereka, sekalipun mereka berkata manis kepadamu!"
 },
 {
   "id": 19261,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 7,
   "firman": "Aku telah meninggalkan kediaman-Ku, telah membuangkan negeri milik-Ku; Aku telah menyerahkan buah hati-Ku ke dalam tangan musuhnya."
 },
 {
   "id": 19262,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 8,
   "firman": "Negeri milik-Ku sudah menjadi seperti singa di hutan bagi-Ku; ia mengeraskan suaranya menentang Aku, sebab itu Aku membencinya."
 },
 {
   "id": 19263,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 9,
   "firman": "Negeri milik-Ku sudah menjadi seperti burung belang bagi-Ku; burung-burung buas mengerumuninya. Ayo, kumpulkanlah segala binatang di padang, bawalah untuk menghabiskannya!"
 },
 {
   "id": 19264,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 10,
   "firman": "Banyak gembala telah merusakkan kebun anggur-Ku, memijak-mijak tanah-Ku, dan membuat tanah kedambaan-Ku menjadi padang gurun yang sunyi sepi."
 },
 {
   "id": 19265,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 11,
   "firman": "Ya, mereka telah membuatnya sunyi sepi, sunyi sepi tanah itu berkabung di hadapan-Ku! Sunyi sepi sekarang segenap negeri itu, tetapi tidak ada orang yang memperhatikannya."
 },
 {
   "id": 19266,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 12,
   "firman": "Para pembinasa telah datang melintasi segala bukit gundul di padang gurun; sebab pedang TUHAN mengamuk makan dari ujung negeri yang satu ke ujung lain; tidak ada damai bagi segala yang hidup."
 },
 {
   "id": 19267,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 13,
   "firman": "Mereka telah menabur gandum, tetapi yang dituai adalah semak duri; mereka telah bersusah payah, tetapi usaha mereka tidak berguna; mereka malu karena hasil yang diperoleh mereka, akibat dari murka TUHAN yang menyala-nyala.\""
 },
 {
   "id": 19268,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 14,
   "firman": "Beginilah firman TUHAN: \"Mengenai sekalian tetangga-Ku yang jahat yang telah mengusik negeri yang telah Kuberikan sebagai milik pusaka kepada umat-Ku Israel, bahwasanya Aku akan mencabut mereka dari tanah mereka dan Aku mencabut kaum Yehuda dari tengah-tengah mereka."
 },
 {
   "id": 19269,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 15,
   "firman": "Tetapi setelah Aku mencabut mereka, maka Aku akan menyayangi mereka kembali. Aku akan mengembalikan mereka masing-masing ke milik pusakanya dan masing-masing ke negerinya."
 },
 {
   "id": 19270,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 16,
   "firman": "Dan jika mereka sungguh-sungguh belajar cara hidup umat-Ku sehingga bersumpah demi nama-Ku: Demi TUHAN yang hidup, seperti tadinya mereka mengajar umat-Ku untuk bersumpah demi Baal, maka mereka akan dibangun di tengah-tengah umat-Ku."
 },
 {
   "id": 19271,
   "kitab": "Yer",
   "pasal": 12,
   "ayat": 17,
   "firman": "Tetapi jika mereka tidak mau mendengarkan, maka Aku akan sungguh-sungguh mencabut dan membinasakan bangsa yang demikian, demikianlah firman TUHAN.\""
 },
 {
   "id": 19272,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN kepadaku: \"Pergilah membeli ikat pinggang lenan, ikatkanlah itu pada pinggangmu, tetapi jangan kaucelupkan ke dalam air!\""
 },
 {
   "id": 19273,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 2,
   "firman": "Maka aku membeli ikat pinggang seperti yang difirmankan TUHAN, lalu mengikatkannya pada pinggangku."
 },
 {
   "id": 19274,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 3,
   "firman": "Sesudah itu datanglah firman TUHAN kepadaku untuk kedua kalinya, bunyinya:"
 },
 {
   "id": 19275,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 4,
   "firman": "\"Ambillah ikat pinggang yang telah kaubeli dan yang sekarang pada pinggangmu itu! Pergilah segera ke sungai Efrat untuk menyembunyikannya di sana di celah-celah bukit batu!\""
 },
 {
   "id": 19276,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 5,
   "firman": "Maka pergilah aku, lalu menyembunyikannya di pinggir sungai Efrat seperti yang diperintahkan TUHAN kepadaku."
 },
 {
   "id": 19277,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 6,
   "firman": "Sesudah beberapa waktu lamanya, berfirmanlah TUHAN kepadaku: \"Pergilah segera ke sungai Efrat mengambil dari sana ikat pinggang yang Kuperintahkan kausembunyikan di sana!\""
 },
 {
   "id": 19278,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 7,
   "firman": "Maka pergilah aku ke sungai Efrat, lalu aku menggali dan mengambil ikat pinggang itu dari tempat aku menyembunyikannya, tetapi ternyata ikat pinggang itu sudah lapuk, tidak berguna untuk apapun."
 },
 {
   "id": 19279,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 8,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 19280,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 9,
   "firman": "\"Beginilah firman TUHAN: Demikianlah Aku akan menghapuskan kecongkakbongakan Yehuda dan Yerusalem."
 },
 {
   "id": 19281,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 10,
   "firman": "Bangsa yang jahat ini, yang enggan mendengarkan perkataan-perkataan-Ku, yang mengikuti kedegilan hatinya dan mengikuti allah lain untuk beribadah dan sujud menyembah kepada mereka, akan menjadi seperti ikat pinggang ini yang tidak berguna untuk apapun."
 },
 {
   "id": 19282,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 11,
   "firman": "Sebab seperti ikat pinggang melekat pada pinggang seseorang, demikianlah tadinya segenap kaum Israel dan segenap kaum Yehuda Kulekatkan kepada-Ku, demikianlah firman TUHAN, supaya mereka itu menjadi umat, menjadi ternama, terpuji dan terhormat bagi-Ku. Tetapi mereka itu tidak mau mendengar.\""
 },
 {
   "id": 19283,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 12,
   "firman": "\"Katakanlah kepada mereka firman ini: Beginilah firman TUHAN, Allah Israel: Setiap buyung harus dipenuhi dengan anggur! Dan jika mereka berkata kepadamu: Masakan kami tidak tahu betul, bahwa setiap buyung harus dipenuhi dengan anggur?,"
 },
 {
   "id": 19284,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 13,
   "firman": "maka katakanlah kepada mereka: Beginilah firman TUHAN: Sesungguhnya, seluruh penduduk negeri ini akan Kupenuhi dengan kemabukan: para raja yang duduk di atas takhta Daud, para imam, para nabi dan seluruh penduduk Yerusalem."
 },
 {
   "id": 19285,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 14,
   "firman": "Aku akan membantingkan seorang kepada yang lain sampai mereka hancur, bapa-bapa dengan anak-anaknya, demikianlah firman TUHAN. Aku akan membinasakan mereka tanpa belas kasihan, tanpa merasa sayang dan tanpa ampun.\""
 },
 {
   "id": 19286,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 15,
   "firman": "Dengarlah, pasanglah telingamu, janganlah kamu tinggi hati, sebab TUHAN telah berfirman."
 },
 {
   "id": 19287,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 16,
   "firman": "Permuliakanlah TUHAN, Allahmu, sebelum Ia membuat hari menjadi gelap, sebelum kakimu tersandung di atas bukit-bukit yang diliputi senja, sementara kamu menanti-nantikan terang, tetapi Ia menjadikan hari kelam pekat dan mengubahnya menjadi gelap gulita."
 },
 {
   "id": 19288,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 17,
   "firman": "Jika kamu tidak mau mendengarkannya, aku akan menangis di tempat yang tersembunyi oleh karena kesombonganmu, air mataku akan berlinang-linang, bahkan akan bercucuran, oleh sebab kawanan domba TUHAN diangkut tertawan."
 },
 {
   "id": 19289,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 18,
   "firman": "Katakanlah kepada raja dan kepada ibu suri: \"Duduklah di tempat yang rendah sekali, sebab mahkota kemuliaanmu sudah turun dari kepalamu!\""
 },
 {
   "id": 19290,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kota-kota tanah Negeb sudah ditutup gerbangnya, dan tidak ada seorangpun yang membukanya. Segenap Yehuda sudah diangkut ke dalam pembuangan, diangkut ke dalam pembuangan seluruhnya."
 },
 {
   "id": 19291,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 20,
   "firman": "Layangkanlah matamu, hai Yerusalem, dan lihatlah, ada orang-orang datang dari utara! Di manakah kawanan ternak yang diberikan kepadamu, kambing domba yang menjadi kemuliaanmu?"
 },
 {
   "id": 19292,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 21,
   "firman": "Apakah yang kaukatakan, apabila diangkat menjadi kepalamu orang-orang yang kauperlakukan sebagai pacar? Bukankah kesakitan akan menyergap engkau seperti halnya seorang perempuan yang melahirkan?"
 },
 {
   "id": 19293,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 22,
   "firman": "Dan apabila engkau bertanya dalam hatimu: \"Mengapakah semuanya ini menimpa aku?\" Karena banyaknya kesalahanmulah maka disingkapkan ujung kainmu dan engkau diperkosa!"
 },
 {
   "id": 19294,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 23,
   "firman": "Dapatkah orang Etiopia mengganti kulitnya atau macan tutul mengubah belangnya? Masakan kamu dapat berbuat baik, hai orang-orang yang membiasakan diri berbuat jahat?"
 },
 {
   "id": 19295,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 24,
   "firman": "Aku akan menghamburkan mereka seperti sekam yang diterbangkan angin padang gurun."
 },
 {
   "id": 19296,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 25,
   "firman": "Itulah nasibmu, bagianmu yang telah Kuukur untukmu, demikianlah firman TUHAN, karena engkau melupakan Aku, dan mempercayai dusta."
 },
 {
   "id": 19297,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 26,
   "firman": "Akupun juga akan mengangkat ujung kainmu sampai kepada mukamu, sehingga kelihatan auratmu."
 },
 {
   "id": 19298,
   "kitab": "Yer",
   "pasal": 13,
   "ayat": 27,
   "firman": "Zinahmu dan ringkikmu, persundalanmu yang mesum di atas bukit-bukit dan di padang-padang, Aku sudah melihat perbuatanmu yang keji itu. Celakalah engkau, hai Yerusalem, berapa lama lagi hingga engkau menjadi tahir?"
 },
 {
   "id": 19299,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada Yeremia mengenai musim kering."
 },
 {
   "id": 19300,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 2,
   "firman": "Yehuda berkabung, pintu-pintu gerbangnya rebah dan dengan sedih terhantar di tanah; jeritan Yerusalem naik ke atas."
 },
 {
   "id": 19301,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 3,
   "firman": "Pembesar-pembesarnya menyuruh pelayan-pelayannya mencari air; mereka sampai ke sumur-sumur, tetapi tidak menemukan air, sehingga mereka pulang dengan kendi-kendi kosong. Mereka malu, mukanya menjadi merah, sampai mereka menyelubungi kepala mereka."
 },
 {
   "id": 19302,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 4,
   "firman": "Pekerjaan di ladang sudah terhenti, sebab hujan tiada turun di negeri, maka petani-petani merasa kecewa dan menyelubungi kepala mereka."
 },
 {
   "id": 19303,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 5,
   "firman": "Bahkan rusa betina di padang meninggalkan anaknya yang baru lahir, sebab tidak ada rumput muda."
 },
 {
   "id": 19304,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 6,
   "firman": "Keledai-keledai hutan berdiri di atas bukit gundul, mengap-mengap seperti serigala, matanya menjadi lesu, sebab tidak ada rumput."
 },
 {
   "id": 19305,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 7,
   "firman": "\"Sekalipun kesalahan-kesalahan kami bersaksi melawan kami, bertindaklah membela kami, ya TUHAN, oleh karena nama-Mu! Sebab banyak kemurtadan kami, kami telah berdosa kepada-Mu."
 },
 {
   "id": 19306,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 8,
   "firman": "Ya Pengharapan Israel, Penolongnya di waktu kesusahan! Mengapakah Engkau seperti orang asing di negeri ini, seperti orang perjalanan yang hanya singgah untuk bermalam?"
 },
 {
   "id": 19307,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 9,
   "firman": "Mengapakah Engkau seperti orang yang bingung, seperti pahlawan yang tidak sanggup menolong? Tetapi Engkau ada di antara kami, ya TUHAN, dan nama-Mu diserukan di atas kami; janganlah tinggalkan kami!\""
 },
 {
   "id": 19308,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 10,
   "firman": "Beginilah firman TUHAN tentang bangsa ini: \"Mereka sangat senang mengembara dan tidak menahan kakinya. Sebab itu TUHAN tidak berkenan kepada mereka; tetapi sekarang Ia mau mengingat kesalahan mereka dan mau menghukum dosa mereka.\""
 },
 {
   "id": 19309,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 11,
   "firman": "TUHAN berfirman kepadaku: \"Janganlah engkau berdoa untuk kebaikan bangsa ini!"
 },
 {
   "id": 19310,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 12,
   "firman": "Sekalipun mereka berpuasa, Aku tidak akan mendengarkan seruan mereka; sekalipun mereka mempersembahkan korban bakaran dan korban sajian, Aku tidak akan berkenan kepada mereka, melainkan Aku akan menghabiskan mereka dengan perang, dengan kelaparan dan dengan penyakit sampar.\""
 },
 {
   "id": 19311,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 13,
   "firman": "Lalu aku berkata: \"Aduh, Tuhan ALLAH! Bukankah para nabi telah berkata kepada mereka: Kamu tidak akan mengalami perang, dan kelaparan tidak akan menimpa kamu, tetapi Aku akan memberikan kepada kamu damai sejahtera yang mantap di tempat ini!\""
 },
 {
   "id": 19312,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 14,
   "firman": "Jawab TUHAN kepadaku: \"Para nabi itu bernubuat palsu demi nama-Ku! Aku tidak mengutus mereka, tidak memerintahkan mereka dan tidak berfirman kepada mereka. Mereka menubuatkan kepadamu penglihatan bohong, ramalan kosong dan tipu rekaan hatinya sendiri."
 },
 {
   "id": 19313,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 15,
   "firman": "Sebab itu beginilah firman TUHAN mengenai para nabi yang bernubuat demi nama-Ku, padahal Aku tidak mengutus mereka, dan yang berkata: Perang dan kelaparan tidak akan menimpa negeri ini--:Para nabi itu sendiri akan habis mati oleh perang dan kelaparan!"
 },
 {
   "id": 19314,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dan bangsa yang kepadanya mereka bernubuat akan tercampak mati di jalan-jalan Yerusalem, disebabkan oleh kelaparan dan perang, dan tidak ada orang yang akan menguburkan mereka: mereka sendiri, isteri-isteri mereka, anak-anak mereka yang laki-laki dan yang perempuan. Demikianlah akan Kutumpahkan kejahatan mereka ke atas mereka.\""
 },
 {
   "id": 19315,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 17,
   "firman": "Katakanlah perkataan ini kepada mereka: \"Air mataku bercucuran siang dan malam dengan tidak berhenti-henti, sebab anak dara, puteri bangsaku, dilukai dengan luka parah, luka yang sama sekali tidak tersembuhkan."
 },
 {
   "id": 19316,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 18,
   "firman": "Apabila aku keluar ke padang, di sana ada orang-orang yang mati terbunuh oleh pedang! Apabila aku masuk ke dalam kota, di sana ada orang-orang sakit kelaparan! Bahkan, baik nabi maupun imam menjelajah negeri yang tidak dikenalnya.\""
 },
 {
   "id": 19317,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 19,
   "firman": "Telah Kautolakkah Yehuda sama sekali? Telah merasa muakkah Engkau terhadap Sion? Mengapakah kami Kaupukul sedemikian, hingga tidak ada kesembuhan lagi bagi kami? Kami mengharapkan damai sejahtera, tetapi tidak datang sesuatu yang baik; mengharapkan waktu kesembuhan, tetapi hanya ada kengerian!"
 },
 {
   "id": 19318,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 20,
   "firman": "Ya TUHAN, kami mengetahui kefasikan kami dan kesalahan nenek moyang kami; sungguh, kami telah berdosa kepada-Mu."
 },
 {
   "id": 19319,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 21,
   "firman": "Janganlah Engkau menampik kami, oleh karena nama-Mu, dan janganlah Engkau menghinakan takhta kemuliaan-Mu! Ingatlah perjanjian-Mu dengan kami, janganlah membatalkannya!"
 },
 {
   "id": 19320,
   "kitab": "Yer",
   "pasal": 14,
   "ayat": 22,
   "firman": "Adakah yang dapat menurunkan hujan di antara dewa kesia-siaan bangsa-bangsa itu? Atau dapatkah langit sendiri memberi hujan lebat? Bukankah hanya Engkau saja, ya TUHAN Allah kami, Pengharapan kami, yang membuat semuanya itu?"
 },
 {
   "id": 19321,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 1,
   "firman": "TUHAN berfirman kepadaku: \"Sekalipun Musa dan Samuel berdiri di hadapan-Ku, hati-Ku tidak akan berbalik kepada bangsa ini. Usirlah mereka dari hadapan-Ku, biarlah mereka pergi!"
 },
 {
   "id": 19322,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 2,
   "firman": "Dan apabila mereka bertanya kepadamu: Ke manakah kami harus pergi?, maka jawablah mereka: Beginilah firman TUHAN: Yang ke maut, ke mautlah! Yang ke pedang, ke pedanglah! Yang ke kelaparan, ke kelaparanlah! dan yang ke tawanan, ke tawananlah!"
 },
 {
   "id": 19323,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 3,
   "firman": "Aku akan mendatangkan atas mereka empat hukuman, demikianlah firman TUHAN: pedang untuk membunuh, anjing-anjing untuk menyeret-nyeret, burung-burung di udara dan binatang-binatang di bumi untuk memakan dan menghabiskan."
 },
 {
   "id": 19324,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 4,
   "firman": "Dengan demikian Aku akan membuat mereka menjadi kengerian bagi segala kerajaan di bumi, oleh karena segala apa yang dilakukan Manasye bin Hizkia, raja Yehuda, di Yerusalem.\""
 },
 {
   "id": 19325,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 5,
   "firman": "\"Siapakah yang akan merasa kasihan terhadap engkau, hai Yerusalem, dan siapakah yang akan turut berdukacita dengan engkau? Siapakah yang akan singgah untuk menanyakan perihal kesehatanmu?"
 },
 {
   "id": 19326,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 6,
   "firman": "Engkau sendiri telah menolak Aku, demikianlah firman TUHAN, telah pergi meninggalkan Aku. Maka Aku mengacungkan tangan-Ku dan membinasakan engkau; Aku sudah jemu untuk merasa sesal."
 },
 {
   "id": 19327,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 7,
   "firman": "Aku menampi mereka dengan tampi di kota-kota negeri; Aku membuat umat-Ku kehilangan anak dan membinasakan mereka, karena mereka tidak berbalik dari tingkah langkah mereka."
 },
 {
   "id": 19328,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 8,
   "firman": "Janda-janda di antara mereka Kubuat lebih besar jumlahnya dari pada pasir laut. Aku mendatangkan ke atas ibu dan teruna suatu pembinasa pada tengah hari. Dengan tiba-tiba Aku menurunkan ke atas mereka kegelisahan dan kekejutan."
 },
 {
   "id": 19329,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 9,
   "firman": "Maka meranalah perempuan yang sudah tujuh kali melahirkan, nafasnya mengap-mengap, baginya matahari sudah terbenam selagi hari siang, ia menjadi malu dan tersipu-sipu. Sisa mereka akan Kuserahkan kepada pedang di depan musuh-musuh mereka, demikianlah firman TUHAN.\""
 },
 {
   "id": 19330,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 10,
   "firman": "Celaka aku, ya ibuku, bahwa engkau melahirkan aku, seorang yang menjadi buah perbantahan dan buah percederaan bagi seluruh negeri. Aku bukan orang yang menghutangkan ataupun orang yang menghutang kepada siapapun, tetapi mereka semuanya mengutuki aku."
 },
 {
   "id": 19331,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 11,
   "firman": "Sungguh, ya TUHAN, aku telah melayani Engkau dengan sebaik-baiknya, dan telah membela musuh di depan-Mu pada masa kecelakaannya dan kesesakannya!"
 },
 {
   "id": 19332,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 12,
   "firman": "Dapatkah orang mematahkan besi, besi dari utara dan tembaga?"
 },
 {
   "id": 19333,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 13,
   "firman": "\"Harta kekayaanmu dan barang-barang perbendaharaanmu akan Kuberikan dirampas sebagai ganjaran atas segala dosamu di segenap daerahmu."
 },
 {
   "id": 19334,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 14,
   "firman": "Aku akan membuat engkau menjadi budak musuhmu di negeri yang tidak kaukenal, sebab dalam murka-Ku telah mencetus api yang akan menyala atasmu.\""
 },
 {
   "id": 19335,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 15,
   "firman": "Engkau mengetahuinya; ya TUHAN, ingatlah aku dan perhatikanlah aku, lakukanlah pembalasan untukku terhadap orang-orang yang mengejar aku. Janganlah membiarkan aku diambil, karena panjang sabar-Mu, ketahuilah bagaimana aku menanggung celaan oleh karena Engkau!"
 },
 {
   "id": 19336,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 16,
   "firman": "Apabila aku bertemu dengan perkataan-perkataan-Mu, maka aku menikmatinya; firman-Mu itu menjadi kegirangan bagiku, dan menjadi kesukaan hatiku, sebab nama-Mu telah diserukan atasku, ya TUHAN, Allah semesta alam."
 },
 {
   "id": 19337,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 17,
   "firman": "Tidak pernah aku duduk beria-ria dalam pertemuan orang-orang yang bersenda gurau; karena tekanan tangan-Mu aku duduk sendirian, sebab Engkau telah memenuhi aku dengan geram."
 },
 {
   "id": 19338,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 18,
   "firman": "Mengapakah penderitaanku tidak berkesudahan, dan lukaku sangat payah, sukar disembuhkan? Sungguh, Engkau seperti sungai yang curang bagiku, air yang tidak dapat dipercayai."
 },
 {
   "id": 19339,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 19,
   "firman": "Karena itu beginilah jawab TUHAN: \"Jika engkau mau kembali, Aku akan mengembalikan engkau menjadi pelayan di hadapan-Ku, dan jika engkau mengucapkan apa yang berharga dan tidak hina, maka engkau akan menjadi penyambung lidah bagi-Ku. Biarpun mereka akan kembali kepadamu, namun engkau tidak perlu kembali kepada mereka."
 },
 {
   "id": 19340,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 20,
   "firman": "Terhadap bangsa ini Aku akan membuat engkau sebagai tembok berkubu dari tembaga; mereka akan memerangi engkau, tetapi tidak akan mengalahkan engkau, sebab Aku menyertai engkau untuk menyelamatkan dan melepaskan engkau, demikianlah firman TUHAN."
 },
 {
   "id": 19341,
   "kitab": "Yer",
   "pasal": 15,
   "ayat": 21,
   "firman": "Aku akan melepaskan engkau dari tangan orang-orang jahat dan membebaskan engkau dari genggaman orang-orang lalim.\""
 },
 {
   "id": 19342,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 1,
   "firman": "Firman TUHAN datang kepadaku, bunyinya:"
 },
 {
   "id": 19343,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 2,
   "firman": "\"Janganlah mengambil isteri dan janganlah mempunyai anak-anak lelaki dan anak-anak perempuan di tempat ini."
 },
 {
   "id": 19344,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 3,
   "firman": "Sebab beginilah firman TUHAN tentang anak-anak lelaki dan anak-anak perempuan yang lahir di tempat ini, tentang ibu-ibu mereka yang melahirkan mereka dan tentang bapa-bapa mereka yang memperanakkan mereka di negeri ini:"
 },
 {
   "id": 19345,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 4,
   "firman": "Mereka akan mati karena penyakit-penyakit yang membawa maut; mereka tidak akan diratapi dan tidak akan dikuburkan; mereka akan menjadi pupuk di ladang; mereka akan habis oleh pedang dan kelaparan; mayat mereka akan menjadi makanan burung-burung di udara dan binatang-binatang di bumi."
 },
 {
   "id": 19346,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 5,
   "firman": "Sungguh, beginilah firman TUHAN: Janganlah masuk ke rumah perkabungan, dan janganlah pergi meratap dan janganlah turut berdukacita dengan mereka, sebab Aku telah menarik damai sejahtera pemberian-Ku dari pada bangsa ini, demikianlah firman TUHAN, juga kasih setia dan belas kasihan-Ku."
 },
 {
   "id": 19347,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 6,
   "firman": "Besar kecil akan mati di negeri ini; mereka tidak akan dikuburkan, dan tidak ada orang yang akan meratapi mereka; tidak ada orang yang akan menoreh-noreh diri dan yang akan menggundul kepala karena mereka."
 },
 {
   "id": 19348,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 7,
   "firman": "Tidak ada orang yang akan memecah-mecahkan roti bagi orang yang berkabung untuk menghiburkan dia karena kematian itu. Bahkan tidak ada orang yang akan memberi dia minum dari piala penghiburan oleh karena kematian ayah atau ibunya."
 },
 {
   "id": 19349,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 8,
   "firman": "Janganlah engkau masuk ke rumah orang mengadakan perjamuan untuk duduk makan minum dengan mereka."
 },
 {
   "id": 19350,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 9,
   "firman": "Sebab beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, di tempat ini, di depan matamu dan pada zamanmu, akan Kuhentikan suara kegirangan dan suara sukacita, suara pengantin laki-laki dan suara pengantin perempuan."
 },
 {
   "id": 19351,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 10,
   "firman": "Apabila engkau memberitahukan kepada bangsa ini segala perkataan itu dan mereka berkata kepadamu: Mengapakah TUHAN mengancamkan segala malapetaka yang besar ini terhadap kami? Apakah kesalahan kami dan apakah dosa yang telah kami lakukan terhadap TUHAN, Allah kami?,"
 },
 {
   "id": 19352,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 11,
   "firman": "maka engkau akan berkata kepada mereka: Oleh karena nenek moyangmu telah meninggalkan Aku, demikianlah firman TUHAN, dan oleh karena mereka telah mengikuti allah lain dengan beribadah dan sujud menyembah kepadanya, tetapi mereka meninggalkan Aku dan tidak berpegang pada Taurat-Ku."
 },
 {
   "id": 19353,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 12,
   "firman": "Dan kamu sendiri berlaku lebih jahat dari pada nenek moyangmu! Lihat, kamu masing-masing mengikuti kedegilan hatinya yang jahat dari pada mendengarkan kepada-Ku."
 },
 {
   "id": 19354,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 13,
   "firman": "Maka Aku akan melemparkan kamu dari negeri ini ke negeri yang tidak dikenal oleh kamu ataupun oleh nenek moyangmu. Di sana kamu akan beribadah kepada allah lain siang malam, sebab Aku tidak akan menaruh kasihan lagi kepadamu."
 },
 {
   "id": 19355,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 14,
   "firman": "Sebab itu, demikianlah firman TUHAN, sesungguhnya, waktunya akan datang, bahwa tidak dikatakan orang lagi: Demi TUHAN yang hidup yang menuntun orang Israel keluar dari tanah Mesir!,"
 },
 {
   "id": 19356,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 15,
   "firman": "melainkan: Demi TUHAN yang hidup yang menuntun orang Israel keluar dari tanah utara dan dari segala negeri ke mana Ia telah menceraiberaikan mereka! Sebab Aku akan membawa mereka pulang ke tanah yang telah Kuberikan kepada nenek moyang mereka."
 },
 {
   "id": 19357,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 16,
   "firman": "Sesungguhnya, Aku mau menyuruh banyak penangkap ikan, demikianlah firman TUHAN, yang akan menangkap mereka, sesudah itu Aku mau menyuruh banyak pemburu yang akan memburu mereka dari atas segala gunung dan dari atas segala bukit dan dari celah-celah bukit batu."
 },
 {
   "id": 19358,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 17,
   "firman": "Sebab Aku mengamat-amati segala tingkah langkah mereka; semuanya itu tidak tersembunyi dari pandangan-Ku, dan kesalahan merekapun tidak terlindung di depan mata-Ku."
 },
 {
   "id": 19359,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 18,
   "firman": "Aku akan mengganjar dua kali lipat kesalahan dan dosa mereka, oleh karena mereka telah menajiskan negeri-Ku dengan bangkai dewa-dewa mereka yang menjijikkan dan telah memenuhi tanah milik-Ku dengan perbuatan mereka yang keji.\""
 },
 {
   "id": 19360,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 19,
   "firman": "Ya TUHAN, kekuatanku dan bentengku, tempat pelarianku pada hari kesesakan! Kepada-Mu akan datang bangsa-bangsa dari ujung bumi serta berkata: \"Sungguh, nenek moyang kami hanya memiliki dewa penipu, dewa kesia-siaan yang satupun tiada berguna."
 },
 {
   "id": 19361,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 20,
   "firman": "Dapatkah manusia membuat allah bagi dirinya sendiri? Yang demikian bukan allah!\""
 },
 {
   "id": 19362,
   "kitab": "Yer",
   "pasal": 16,
   "ayat": 21,
   "firman": "\"Sebab itu, ketahuilah, Aku mau memberitahukan kepada mereka, sekali ini Aku akan memberitahukan kepada mereka kekuasaan-Ku dan keperkasaan-Ku, supaya mereka tahu, bahwa nama-Ku TUHAN.\""
 },
 {
   "id": 19363,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 1,
   "firman": "\"Dosa Yehuda telah tertulis dengan pena besi, yang matanya dari intan, terukir pada loh hati mereka dan pada tanduk-tanduk mezbah mereka"
 },
 {
   "id": 19364,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 2,
   "firman": "sebagai peringatan terhadap mereka! --Mezbah-mezbah mereka dan tiang-tiang berhala mereka memang ada di samping pohon yang rimbun di atas bukit yang tinggi,"
 },
 {
   "id": 19365,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 3,
   "firman": "yakni pegunungan di padang. --Harta kekayaanmu dan segala barang perbendaharaanmu akan Kuberikan dirampas sebagai ganjaran atas dosamu di segenap daerahmu."
 },
 {
   "id": 19366,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 4,
   "firman": "Engkau terpaksa lepas tangan dari milik pusakamu yang telah Kuberikan kepadamu, dan Aku akan membuat engkau menjadi budak musuhmu di negeri yang tidak kaukenal, sebab dalam murka-Ku api telah mencetus yang akan menyala untuk selama-lamanya.\""
 },
 {
   "id": 19367,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 5,
   "firman": "Beginilah firman TUHAN: \"Terkutuklah orang yang mengandalkan manusia, yang mengandalkan kekuatannya sendiri, dan yang hatinya menjauh dari pada TUHAN!"
 },
 {
   "id": 19368,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 6,
   "firman": "Ia akan seperti semak bulus di padang belantara, ia tidak akan mengalami datangnya keadaan baik; ia akan tinggal di tanah angus di padang gurun, di negeri padang asin yang tidak berpenduduk."
 },
 {
   "id": 19369,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 7,
   "firman": "Diberkatilah orang yang mengandalkan TUHAN, yang menaruh harapannya pada TUHAN!"
 },
 {
   "id": 19370,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 8,
   "firman": "Ia akan seperti pohon yang ditanam di tepi air, yang merambatkan akar-akarnya ke tepi batang air, dan yang tidak mengalami datangnya panas terik, yang daunnya tetap hijau, yang tidak kuatir dalam tahun kering, dan yang tidak berhenti menghasilkan buah."
 },
 {
   "id": 19371,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 9,
   "firman": "Betapa liciknya hati, lebih licik dari pada segala sesuatu, hatinya sudah membatu: siapakah yang dapat mengetahuinya?"
 },
 {
   "id": 19372,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 10,
   "firman": "Aku, TUHAN, yang menyelidiki hati, yang menguji batin, untuk memberi balasan kepada setiap orang setimpal dengan tingkah langkahnya, setimpal dengan hasil perbuatannya.\""
 },
 {
   "id": 19373,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 11,
   "firman": "Seperti ayam hutan yang mengerami yang tidak ditelurkannya, demikianlah orang yang menggaruk kekayaan secara tidak halal, pada pertengahan usianya ia akan kehilangan semuanya, dan pada kesudahan usianya ia terkenal sebagai seorang bebal."
 },
 {
   "id": 19374,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 12,
   "firman": "Takhta kemuliaan, luhur dari sejak semula, tempat bait kudus kita!"
 },
 {
   "id": 19375,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 13,
   "firman": "Ya Pengharapan Israel, TUHAN, semua orang yang meninggalkan Engkau akan menjadi malu; orang-orang yang menyimpang dari pada-Mu akan dilenyapkan di negeri, sebab mereka telah meninggalkan sumber air yang hidup, yakni TUHAN."
 },
 {
   "id": 19376,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 14,
   "firman": "Sembuhkanlah aku, ya TUHAN, maka aku akan sembuh; selamatkanlah aku, maka aku akan selamat, sebab Engkaulah kepujianku!"
 },
 {
   "id": 19377,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 15,
   "firman": "Sesungguhnya, mereka berkata kepadaku: \"Di manakah firman TUHAN itu? Biarlah ia sampai!\""
 },
 {
   "id": 19378,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 16,
   "firman": "Namun tidak pernah aku mendesak kepada-Mu untuk mendatangkan malapetaka, aku tidak mengingini hari bencana! Engkaulah yang mengetahui apa yang keluar dari bibirku, semuanya terpampang di hadapan mata-Mu."
 },
 {
   "id": 19379,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 17,
   "firman": "Janganlah Engkau menjadi kedahsyatan bagiku, Engkaulah perlindunganku pada hari malapetaka."
 },
 {
   "id": 19380,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 18,
   "firman": "Biarlah orang-orang yang mengejar aku menjadi malu, tetapi janganlah aku ini menjadi malu; biarlah mereka terkejut, tetapi janganlah aku ini terkejut! Buatlah hari malapetaka menimpa mereka, dan hancurkanlah mereka dengan kehancuran berganda."
 },
 {
   "id": 19381,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 19,
   "firman": "Beginilah firman TUHAN kepadaku: \"Pergilah engkau dan berdirilah di pintu gerbang Anak Rakyat, yang dilalui keluar masuk oleh raja-raja Yehuda, dan di segala pintu gerbang Yerusalem;"
 },
 {
   "id": 19382,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 20,
   "firman": "katakanlah kepada mereka: Dengarlah firman TUHAN, hai raja-raja Yehuda, hai segenap Yehuda dan segenap penduduk Yerusalem yang masuk melalui pintu-pintu gerbang ini!"
 },
 {
   "id": 19383,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 21,
   "firman": "Beginilah firman TUHAN: Berawas-awaslah demi nyawamu! Janganlah mengangkut barang-barang pada hari Sabat dan membawanya melalui pintu-pintu gerbang Yerusalem!"
 },
 {
   "id": 19384,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 22,
   "firman": "Janganlah membawa barang-barang dari rumahmu ke luar pada hari Sabat dan janganlah lakukan sesuatu pekerjaan, tetapi kuduskanlah hari Sabat seperti yang telah Kuperintahkan kepada nenek moyangmu."
 },
 {
   "id": 19385,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 23,
   "firman": "Namun mereka tidak mau mendengarkan dan tidak mau memperhatikannya, melainkan mereka berkeras kepala, sehingga tidak mau mendengarkan dan tidak mau menerima tegoran."
 },
 {
   "id": 19386,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 24,
   "firman": "Apabila kamu sungguh-sungguh mendengarkan Aku, demikianlah firman TUHAN, dan tidak membawa masuk barang-barang melalui pintu-pintu gerbang kota ini pada hari Sabat, tetapi menguduskan hari Sabat dan tidak melakukan sesuatu pekerjaan pada hari itu,"
 },
 {
   "id": 19387,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 25,
   "firman": "maka melalui pintu-pintu gerbang kota ini akan berarak masuk raja-raja dan pemuka-pemuka, yang akan duduk di atas takhta Daud, dengan mengendarai kereta dan kuda: mereka dan pemuka-pemuka mereka, orang-orang Yehuda dan penduduk Yerusalem. Dan kota ini akan didiami orang untuk selama-lamanya."
 },
 {
   "id": 19388,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 26,
   "firman": "Orang akan datang dari kota-kota Yehuda dan dari tempat-tempat sekitar Yerusalem, dari tanah Benyamin dan dari Daerah Bukit, dari pegunungan dan dari tanah Negeb, dengan membawa korban bakaran, korban sembelihan, korban sajian dan kemenyan, membawa korban syukur ke dalam rumah TUHAN."
 },
 {
   "id": 19389,
   "kitab": "Yer",
   "pasal": 17,
   "ayat": 27,
   "firman": "Tetapi apabila kamu tidak mendengarkan perintah-Ku untuk menguduskan hari Sabat dan untuk tidak masuk mengangkut barang-barang melalui pintu-pintu gerbang Yerusalem pada hari Sabat, maka di pintu-pintu gerbangnya Aku akan menyalakan api, yang akan memakan habis puri-puri Yerusalem, dan yang tidak akan terpadamkan.\""
 },
 {
   "id": 19390,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19391,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 2,
   "firman": "\"Pergilah dengan segera ke rumah tukang periuk! Di sana Aku akan memperdengarkan perkataan-perkataan-Ku kepadamu.\""
 },
 {
   "id": 19392,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 3,
   "firman": "Lalu pergilah aku ke rumah tukang periuk, dan kebetulan ia sedang bekerja dengan pelarikan."
 },
 {
   "id": 19393,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 4,
   "firman": "Apabila bejana, yang sedang dibuatnya dari tanah liat di tangannya itu, rusak, maka tukang periuk itu mengerjakannya kembali menjadi bejana lain menurut apa yang baik pada pemandangannya."
 },
 {
   "id": 19394,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 5,
   "firman": "Kemudian datanglah firman TUHAN kepadaku, bunyinya:"
 },
 {
   "id": 19395,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 6,
   "firman": "\"Masakan Aku tidak dapat bertindak kepada kamu seperti tukang periuk ini, hai kaum Israel!, demikianlah firman TUHAN. Sungguh, seperti tanah liat di tangan tukang periuk, demikianlah kamu di tangan-Ku, hai kaum Israel!"
 },
 {
   "id": 19396,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 7,
   "firman": "Ada kalanya Aku berkata tentang suatu bangsa dan tentang suatu kerajaan bahwa Aku akan mencabut, merobohkan dan membinasakannya."
 },
 {
   "id": 19397,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 8,
   "firman": "Tetapi apabila bangsa yang terhadap siapa Aku berkata demikian telah bertobat dari kejahatannya, maka menyesallah Aku, bahwa Aku hendak menjatuhkan malapetaka yang Kurancangkan itu terhadap mereka."
 },
 {
   "id": 19398,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 9,
   "firman": "Ada kalanya Aku berkata tentang suatu bangsa dan tentang suatu kerajaan bahwa Aku akan membangun dan menanam mereka."
 },
 {
   "id": 19399,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 10,
   "firman": "Tetapi apabila mereka melakukan apa yang jahat di depan mata-Ku dan tidak mendengarkan suara-Ku, maka menyesallah Aku, bahwa Aku hendak mendatangkan keberuntungan yang Kujanjikan itu kepada mereka."
 },
 {
   "id": 19400,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 11,
   "firman": "Sebab itu, katakanlah kepada orang Yehuda dan kepada penduduk Yerusalem: Beginilah firman TUHAN: Sesungguhnya, Aku ini sedang menyiapkan malapetaka terhadap kamu dan merancangkan rencana terhadap kamu. Baiklah kamu masing-masing bertobat dari tingkah langkahmu yang jahat, dan perbaikilah tingkah langkahmu dan perbuatanmu!"
 },
 {
   "id": 19401,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 12,
   "firman": "Tetapi mereka berkata: Tidak ada gunanya! Sebab kami hendak berkelakuan mengikuti rencana kami sendiri dan masing-masing hendak bertindak mengikuti kedegilan hatinya yang jahat.\""
 },
 {
   "id": 19402,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 13,
   "firman": "Sebab itu beginilah firman TUHAN: \"Cobalah tanyakan di kalangan bangsa-bangsa: siapakah yang telah mendengar hal seperti ini? Anak dara Israel telah melakukan hal-hal yang sangat ngeri!"
 },
 {
   "id": 19403,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 14,
   "firman": "Masakan salju putih akan beralih dari gunung batu Siryon? Masakan air gunung akan habis; air yang sejuk dan mengalir?"
 },
 {
   "id": 19404,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 15,
   "firman": "Tetapi umat-Ku telah melupakan Aku, mereka telah membakar korban kepada dewa kesia-siaan; mereka telah tersandung jatuh di jalan-jalan mereka, yakni jalan-jalan dari dahulu kala, dan telah mengambil jalan simpangan, yakni jalan yang tidak diratakan."
 },
 {
   "id": 19405,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 16,
   "firman": "Maka mereka membuat negerinya menjadi kengerian menjadi sasaran suitan untuk selamanya. Setiap orang yang melewatinya akan merasa ngeri, dan akan menggeleng-gelengkan kepalanya."
 },
 {
   "id": 19406,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 17,
   "firman": "Seperti angin timur Aku akan menyerakkan mereka di depan musuhnya. Belakang-Ku akan Kuperlihatkan kepada mereka dan bukan muka-Ku pada hari bencana mereka.\""
 },
 {
   "id": 19407,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 18,
   "firman": "Berkatalah mereka: \"Marilah kita mengadakan persepakatan terhadap Yeremia, sebab imam tidak akan kehabisan pengajaran, orang bijaksana tidak akan kehabisan nasihat dan nabi tidak akan kehabisan firman. Marilah kita memukul dia dengan bahasanya sendiri dan jangan memperhatikan setiap perkataannya!\""
 },
 {
   "id": 19408,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 19,
   "firman": "Perhatikanlah aku, ya TUHAN, dan dengarkanlah suara pengaduanku!"
 },
 {
   "id": 19409,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 20,
   "firman": "Akan dibalaskah kebaikan dengan kejahatan? Namun mereka telah menggali pelubang untuk aku! Ingatlah bahwa aku telah berdiri di hadapan-Mu, dan telah berbicara membela mereka, supaya amarah-Mu disurutkan dari mereka."
 },
 {
   "id": 19410,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 21,
   "firman": "Sebab itu serahkanlah anak-anak mereka kepada kelaparan, dan biarkanlah mereka dipancung pedang! Biarlah isteri-isteri mereka kehilangan anak dan suami; biarlah laki-laki mereka mati oleh sampar, dan pemuda-pemuda mereka mati karena pedang di pertempuran!"
 },
 {
   "id": 19411,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 22,
   "firman": "Biarlah kedengaran jeritan dari rumah-rumah mereka, apabila Engkau dengan tiba-tiba mendatangkan gerombolan perampok kepada mereka! Sebab mereka telah menggali pelubang untuk menangkap aku, dan telah memasang jerat untuk kakiku."
 },
 {
   "id": 19412,
   "kitab": "Yer",
   "pasal": 18,
   "ayat": 23,
   "firman": "Tetapi Engkau, ya TUHAN, Engkau mengetahui segala rancangan mereka untuk membunuh aku. Janganlah ampuni kesalahan mereka, dan janganlah hapuskan dosa mereka dari hadapan-Mu, tetapi biarlah mereka tersandung di hadapan mata-Mu; bertindaklah pada hari murka-Mu terhadap mereka!"
 },
 {
   "id": 19413,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 1,
   "firman": "Beginilah pula firman TUHAN kepadaku: \"Pergilah membeli buli-buli yang dibuat dari tanah, lalu ajaklah bersama-sama engkau beberapa orang tua-tua bangsa itu dan beberapa orang imam yang tertua,"
 },
 {
   "id": 19414,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 2,
   "firman": "kemudian berangkatlah ke Lembah Ben-Hinom yang di depan pintu gerbang Beling! Serukanlah di sana perkataan-perkataan yang akan Kusampaikan kepadamu!"
 },
 {
   "id": 19415,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 3,
   "firman": "Katakanlah: Dengarlah firman TUHAN, hai raja-raja Yehuda dan penduduk Yerusalem! Beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku akan mendatangkan malapetaka kepada tempat ini, sehingga telinga orang yang mendengarnya, mendenging!"
 },
 {
   "id": 19416,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 4,
   "firman": "Sebab mereka telah meninggalkan Aku, telah memberikan tempat ini kepada allah asing dan telah membakar korban di sini kepada allah lain yang tidak dikenal oleh mereka sendiri dan oleh nenek moyang mereka dan oleh raja-raja Yehuda. Mereka telah membuat tempat ini penuh dengan darah orang-orang yang tidak bersalah."
 },
 {
   "id": 19417,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 5,
   "firman": "Mereka telah mendirikan bukit-bukit pengorbanan bagi Baal untuk membakar anak-anak mereka sebagai korban bakaran kepada Baal, suatu hal yang tidak pernah Kuperintahkan atau Kukatakan dan yang tidak pernah timbul dalam hati-Ku."
 },
 {
   "id": 19418,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 6,
   "firman": "Sebab itu, sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa tempat ini tidak akan disebut lagi: Tofet dan Lembah Ben-Hinom, melainkan Lembah Pembunuhan."
 },
 {
   "id": 19419,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 7,
   "firman": "Aku akan menggagalkan rancangan Yehuda dan Yerusalem di tempat ini dan Aku akan membuat mereka rebah oleh pedang di depan musuh mereka dan oleh tangan orang-orang yang ingin mencabut nyawa mereka. Aku akan membiarkan mayat-mayat mereka dimakan oleh burung-burung di udara dan oleh binatang-binatang di bumi."
 },
 {
   "id": 19420,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 8,
   "firman": "Aku akan membuat kota ini menjadi kengerian dan menjadi sasaran suitan. Setiap orang yang melewatinya akan merasa ngeri dan bersuit karena segala pukulan yang dideritanya."
 },
 {
   "id": 19421,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 9,
   "firman": "Aku akan membuat mereka memakan daging anak-anaknya laki-laki dan daging anak-anaknya perempuan, dan setiap orang memakan daging temannya, dalam keadaan susah dan sulit yang ditimbulkan musuhnya kepada mereka dan oleh orang-orang yang ingin mencabut nyawa mereka."
 },
 {
   "id": 19422,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 10,
   "firman": "Selanjutnya pecahkanlah buli-buli itu di depan mata orang-orang yang turut bersama-sama engkau."
 },
 {
   "id": 19423,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 11,
   "firman": "Katakanlah kepada mereka: Beginilah firman TUHAN semesta alam: Demikianlah akan Kupecahkan bangsa ini dan kota ini, seperti orang memecahkan tembikar tukang periuk, sehingga tidak dapat diperbaiki lagi. Dan Tofet akan menjadi tempat penguburan, karena tidak ada tempat lain untuk menguburkan."
 },
 {
   "id": 19424,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 12,
   "firman": "Begitulah akan Kulakukan kepada tempat ini, demikianlah firman TUHAN, dan kepada penduduknya. Aku akan membuat kota ini seperti Tofet:"
 },
 {
   "id": 19425,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 13,
   "firman": "rumah-rumah Yerusalem dan rumah-rumah para raja Yehuda akan menjadi najis seperti tempat Tofet, yakni segala rumah yang di atas sotohnya orang membakar korban kepada segala tentara langit dan mempersembahkan korban curahan kepada allah lain.\""
 },
 {
   "id": 19426,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 14,
   "firman": "Ketika Yeremia pulang dari Tofet, ke mana TUHAN telah mengutusnya untuk bernubuat, berdirilah ia di pelataran rumah TUHAN dan berkata kepada segenap orang banyak:"
 },
 {
   "id": 19427,
   "kitab": "Yer",
   "pasal": 19,
   "ayat": 15,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku akan mendatangkan ke atas kota ini dan ke atas segala kota sekitarnya seluruh malapetaka yang telah Kukatakan akan menimpa mereka, sebab mereka berkeras kepala dan tidak mendengarkan perkataan-perkataan"
 },
 {
   "id": 19428,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pasyhur bin Imer, imam yang pada waktu itu menjabat kepala di rumah TUHAN, mendengar Yeremia menubuatkan perkataan-perkataan itu."
 },
 {
   "id": 19429,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 2,
   "firman": "Lalu Pasyhur memukul nabi Yeremia dan memasungkan dia di pintu gerbang Benyamin yang ada di atas rumah TUHAN."
 },
 {
   "id": 19430,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 3,
   "firman": "Tetapi ketika Pasyhur keesokan harinya mengeluarkan Yeremia dari pasungan itu, berkatalah Yeremia kepadanya: \"TUHAN akan menyebut namamu bukan Pasyhur, melainkan Kegentaran-dari-segala-jurusan."
 },
 {
   "id": 19431,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN: Sesungguhnya, Aku akan membuat engkau menjadi kegentaran bagimu sendiri dan bagi semua sahabatmu; mereka akan rebah mati oleh pedang musuhnya di depan matamu sendiri. Dan seluruh Yehuda akan Kuserahkan ke dalam tangan raja Babel yang akan mengangkut mereka ke dalam pembuangan ke Babel dan memukul mati mereka dengan pedang."
 },
 {
   "id": 19432,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 5,
   "firman": "Juga harta benda kota ini, segala hasil jerih payahnya, segala barangnya yang berharga dan segala barang perbendaharaan raja-raja Yehuda akan Kuserahkan ke dalam tangan musuhnya, yang akan menjarah, mengumpulkan dan membawa semuanya itu ke Babel."
 },
 {
   "id": 19433,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 6,
   "firman": "Mengenai engkau, hai Pasyhur, dan semua orang yang diam di rumahmu, kamu akan diangkut tertawan; engkau akan sampai ke Babel dan akan mati di sana dan akan dikuburkan di sana: engkau ini dengan semua sahabatmu yang kepadanya engkau telah bernubuat palsu.\""
 },
 {
   "id": 19434,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 7,
   "firman": "Engkau telah membujuk aku, ya TUHAN, dan aku telah membiarkan diriku dibujuk; Engkau terlalu kuat bagiku dan Engkau menundukkan aku. Aku telah menjadi tertawaan sepanjang hari, semuanya mereka mengolok-olokkan aku."
 },
 {
   "id": 19435,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 8,
   "firman": "Sebab setiap kali aku berbicara, terpaksa aku berteriak, terpaksa berseru: \"Kelaliman! Aniaya!\" Sebab firman TUHAN telah menjadi cela dan cemooh bagiku, sepanjang hari."
 },
 {
   "id": 19436,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 9,
   "firman": "Tetapi apabila aku berpikir: \"Aku tidak mau mengingat Dia dan tidak mau mengucapkan firman lagi demi nama-Nya\", maka dalam hatiku ada sesuatu yang seperti api yang menyala-nyala, terkurung dalam tulang-tulangku; aku berlelah-lelah untuk menahannya, tetapi aku tidak sanggup."
 },
 {
   "id": 19437,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 10,
   "firman": "Aku telah mendengar bisikan banyak orang: \"Kegentaran datang dari segala jurusan! Adukanlah dia! Kita mau mengadukan dia!\" Semua orang sahabat karibku mengintai apakah aku tersandung jatuh: \"Barangkali ia membiarkan dirinya dibujuk, sehingga kita dapat mengalahkan dia dan dapat melakukan pembalasan kita terhadap dia!\""
 },
 {
   "id": 19438,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 11,
   "firman": "Tetapi TUHAN menyertai aku seperti pahlawan yang gagah, sebab itu orang-orang yang mengejar aku akan tersandung jatuh dan mereka tidak dapat berbuat apa-apa. Mereka akan menjadi malu sekali, sebab mereka tidak berhasil, suatu noda yang selama-lamanya tidak terlupakan!"
 },
 {
   "id": 19439,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 12,
   "firman": "Ya TUHAN semesta alam, yang menguji orang benar, yang melihat batin dan hati, biarlah aku melihat pembalasan-Mu terhadap mereka, sebab kepada-Mulah kuserahkan perkaraku."
 },
 {
   "id": 19440,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 13,
   "firman": "Menyanyilah untuk TUHAN, pujilah TUHAN! Sebab ia telah melepaskan nyawa orang miskin dari tangan orang-orang yang berbuat jahat."
 },
 {
   "id": 19441,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 14,
   "firman": "Terkutuklah hari ketika aku dilahirkan! Biarlah jangan diberkati hari ketika ibuku melahirkan aku!"
 },
 {
   "id": 19442,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 15,
   "firman": "Terkutuklah orang yang membawa kabar kepada bapaku dengan mengatakan: \"Seorang anak laki-laki telah dilahirkan bagimu!\" yang membuat dia bersukacita dengan sangat."
 },
 {
   "id": 19443,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 16,
   "firman": "Terjadilah kepada hari itu seperti kepada kota-kota yang ditunggangbalikkan TUHAN tanpa belas kasihan! Didengarnyalah kiranya teriakan pada waktu pagi dan hiruk-pikuk pada waktu tengah hari!"
 },
 {
   "id": 19444,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 17,
   "firman": "Karena hari itu tidak membunuh aku selagi di kandungan, sehingga ibuku menjadi kuburanku, dan ia mengandung untuk selamanya!"
 },
 {
   "id": 19445,
   "kitab": "Yer",
   "pasal": 20,
   "ayat": 18,
   "firman": "Mengapa gerangan aku keluar dari kandungan, melihat kesusahan dan kedukaan, sehingga hari-hariku habis berlalu dalam malu?"
 },
 {
   "id": 19446,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia, ketika raja Zedekia mengutus Pasyhur bin Malkia dan imam Zefanya bin Maaseya kepadanya dengan pesan:"
 },
 {
   "id": 19447,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 2,
   "firman": "\"Tanyakanlah kiranya petunjuk TUHAN untuk kami, sebab Nebukadnezar, raja Babel, memerangi kami! Barangkali TUHAN mau melakukan kepada kami tepat seperti perbuatan-perbuatan-Nya yang ajaib, sehingga Nebukadnezar mundur meninggalkan kami.\""
 },
 {
   "id": 19448,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 3,
   "firman": "Kata Yeremia kepada mereka: \"Beginilah kamu katakan kepada Zedekia:"
 },
 {
   "id": 19449,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 4,
   "firman": "Beginilah firman TUHAN, Allah Israel: Sesungguhnya, Aku akan membalikkan senjata perang yang kamu pegang, yang kamu pakai berperang melawan raja Babel dan melawan orang-orang Kasdim yang mengepung kamu dari luar tembok; Aku akan mengumpulkannya ke dalam kota ini."
 },
 {
   "id": 19450,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 5,
   "firman": "Aku sendiri akan berperang melawan kamu dengan tangan yang teracung, dengan lengan yang kuat, dengan murka, dengan kehangatan amarah dan dengan kegusaran yang besar."
 },
 {
   "id": 19451,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 6,
   "firman": "Aku akan memukul penduduk kota ini, baik manusia maupun binatang; mereka akan mati oleh penyakit sampar yang hebat."
 },
 {
   "id": 19452,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 7,
   "firman": "Sesudah itu, demikianlah firman TUHAN, maka Zedekia, raja Yehuda, dan pegawai-pegawainya dan rakyat di kota ini, yang masih tinggal hidup dari penyakit sampar, dari pedang dan dari kelaparan, akan Kuserahkan ke dalam tangan Nebukadnezar, raja Babel, yaitu ke dalam tangan musuh mereka yang berusaha mencabut nyawa mereka; orang akan memukul mati mereka dengan mata pedang tanpa merasa sayang, tanpa belas kasihan dan tanpa ampun."
 },
 {
   "id": 19453,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 8,
   "firman": "Tetapi kepada bangsa ini haruslah kaukatakan: Beginilah firman TUHAN: Sesungguhnya, Aku menghadapkan kepada kamu jalan kehidupan dan jalan kematian."
 },
 {
   "id": 19454,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 9,
   "firman": "Siapa yang tinggal di kota ini akan mati karena pedang, karena kelaparan dan karena penyakit sampar; tetapi siapa yang keluar dari sini dan menyerahkan diri kepada orang-orang Kasdim yang mengepung kamu, ia akan tetap hidup; nyawanya akan menjadi jarahan baginya."
 },
 {
   "id": 19455,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 10,
   "firman": "Sebab Aku telah menentang kota ini untuk mendatangkan kecelakaan dan bukan untuk mendatangkan keberuntungannya, demikianlah firman TUHAN. Kota ini akan diserahkan ke dalam tangan raja Babel yang akan membakarnya habis dengan api.\""
 },
 {
   "id": 19456,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 11,
   "firman": "Kepada keluarga raja Yehuda. Dengarlah firman TUHAN:"
 },
 {
   "id": 19457,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 12,
   "firman": "\"Beginilah firman TUHAN, hai keturunan Daud: Jatuhkanlah hukum yang adil setiap pagi dan lepaskanlah dari tangan pemerasnya orang yang dirampas haknya, supaya kehangatan murka-Ku jangan menyambar seperti api dan menyala-nyala dengan tidak ada yang memadamkannya, oleh karena perbuatan-perbuatanmu yang jahat!"
 },
 {
   "id": 19458,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 13,
   "firman": "Sesungguhnya, Aku akan menjadi lawanmu, hai kota yang di atas lembah, gunung batu di dataran, demikianlah firman TUHAN, hai kamu yang berkata: Siapakah yang berani turun kepada kami dan siapakah yang berani masuk ke tempat perteduhan kami?"
 },
 {
   "id": 19459,
   "kitab": "Yer",
   "pasal": 21,
   "ayat": 14,
   "firman": "Aku akan melakukan pembalasan kepadamu sesuai dengan hasil perbuatanmu, demikianlah firman TUHAN. Aku akan menyalakan api di hutannya yang akan memakan habis segala sesuatu yang di sekitarnya.\""
 },
 {
   "id": 19460,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: \"Pergilah ke istana raja Yehuda dan sampaikanlah di sana firman ini!"
 },
 {
   "id": 19461,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 2,
   "firman": "Katakanlah: Dengarlah firman TUHAN, hai raja Yehuda yang duduk di atas takhta Daud, engkau, pegawai-pegawaimu dan rakyatmu yang masuk melalui pintu-pintu gerbang ini!"
 },
 {
   "id": 19462,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 3,
   "firman": "Beginilah firman TUHAN: Lakukanlah keadilan dan kebenaran, lepaskanlah dari tangan pemerasnya orang yang dirampas haknya, janganlah engkau menindas dan janganlah engkau memperlakukan orang asing, yatim dan janda dengan keras, dan janganlah engkau menumpahkan darah orang yang tak bersalah di tempat ini!"
 },
 {
   "id": 19463,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 4,
   "firman": "Sebab jika kamu sungguh-sungguh melakukan semuanya itu, maka melalui pintu-pintu gerbang istana ini akan berarak masuk raja-raja yang akan duduk di atas takhta Daud dengan mengendarai kereta dan kuda: mereka itu, pegawai-pegawainya dan rakyatnya."
 },
 {
   "id": 19464,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 5,
   "firman": "Tetapi jika kamu tidak mendengarkan perkataan-perkataan ini, maka Aku sudah bersumpah demi diri-Ku, demikianlah firman TUHAN, bahwa istana ini akan menjadi reruntuhan."
 },
 {
   "id": 19465,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 6,
   "firman": "Sebab beginilah firman TUHAN mengenai keluarga raja Yehuda: Engkau seperti Gilead bagi-Ku, seperti puncak gunung Libanon! Namun pastilah Aku akan membuat engkau menjadi padang gurun, menjadi kota yang tidak didiami orang."
 },
 {
   "id": 19466,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 7,
   "firman": "Aku akan menetapkan pemusnah-pemusnah terhadap engkau, masing-masing dengan senjatanya; mereka akan menebang pohon aras pilihanmu dan mencampakkannya ke dalam api."
 },
 {
   "id": 19467,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 8,
   "firman": "Dan apabila banyak bangsa melewati kota ini, maka mereka akan berkata seorang kepada yang lain: Mengapakah TUHAN melakukan seperti itu kepada kota yang besar ini?"
 },
 {
   "id": 19468,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 9,
   "firman": "Orang akan menjawab: Oleh karena mereka telah melupakan perjanjian TUHAN, Allah mereka, dan telah sujud menyembah kepada allah lain dan beribadah kepadanya.\""
 },
 {
   "id": 19469,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 10,
   "firman": "Janganlah kamu menangisi orang mati dan janganlah turut berdukacita karena dia. Lebih baiklah kamu menangisi dia yang sudah pergi, sebab ia tidak akan kembali lagi, ia tidak lagi akan melihat tanah kelahirannya."
 },
 {
   "id": 19470,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 11,
   "firman": "Sebab beginilah firman TUHAN mengenai Salum bin Yosia, raja Yehuda, yang telah menjadi raja menggantikan Yosia, ayahnya, dan yang telah meninggalkan tempat ini: \"Ia tidak lagi akan kembali ke sini,"
 },
 {
   "id": 19471,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 12,
   "firman": "tetapi ia akan mati di tempat pembuangannya, dan tidak lagi akan melihat negeri ini.\""
 },
 {
   "id": 19472,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 13,
   "firman": "Celakalah dia yang membangun istananya berdasarkan ketidakadilan dan anjungnya berdasarkan kelaliman, yang mempekerjakan sesamanya dengan cuma-cuma dan tidak memberikan upahnya kepadanya;"
 },
 {
   "id": 19473,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 14,
   "firman": "yang berkata: \"Aku mau mendirikan istana yang besar lebar dan anjung yang lapang luas!\", lalu menetas dinding istana membuat jendela, memapani istana itu dengan kayu aras dan mencatnya merah."
 },
 {
   "id": 19474,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 15,
   "firman": "Sangkamu rajakah engkau, jika engkau bertanding dalam hal pemakaian kayu aras? Tidakkah ayahmu makan minum juga dan beroleh kenikmatan? Tetapi ia melakukan keadilan dan kebenaran,"
 },
 {
   "id": 19475,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 16,
   "firman": "serta mengadili perkara orang sengsara dan orang miskin dengan adil. Bukankah itu namanya mengenal Aku? demikianlah firman TUHAN."
 },
 {
   "id": 19476,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 17,
   "firman": "Tetapi matamu dan hatimu hanya tertuju kepada pengejaran untung, kepada penumpahan darah orang yang tak bersalah, kepada pemerasan dan kepada penganiayaan!"
 },
 {
   "id": 19477,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 18,
   "firman": "Sebab itu beginilah firman TUHAN mengenai Yoyakim bin Yosia, raja Yehuda: \"Orang tidak akan meratapi dia: Aduhai abangku! Aduhai kakakku! Orang tidak akan menangisi dia: Aduhai tuan! Aduhai Seri Paduka!"
 },
 {
   "id": 19478,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 19,
   "firman": "Ia akan dikubur secara penguburan keledai, diseret dan dilemparkan ke luar pintu-pintu gerbang Yerusalem.\""
 },
 {
   "id": 19479,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 20,
   "firman": "Naiklah ke gunung Libanon dan berteriaklah! Perdengarkanlah suaramu di pegunungan Basan! Berteriaklah dari pegunungan Abarim, sebab semua kekasihmu sudah hancur!"
 },
 {
   "id": 19480,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 21,
   "firman": "Aku telah berbicara kepadamu selagi engkau sentosa, tetapi engkau berkata: \"Aku tidak mau mendengarkan!\" Itulah tingkah langkahmu dari sejak masa mudamu, sebab engkau tidak mau mendengarkan suara-Ku!"
 },
 {
   "id": 19481,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 22,
   "firman": "Semua orang yang menggembalakan kamu akan dihalau angin ribut, dan para kekasihmu akan diangkut tertawan. Pada waktu itu engkau akan menjadi malu dan bernoda dari sebab segala kejahatanmu."
 },
 {
   "id": 19482,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 23,
   "firman": "Hai engkau yang diam di gunung Libanon, dan yang bersarang di pohon-pohon aras! Betapa engkau akan mengeluh ketika kesakitan menimpa engkau, kesakitan seperti yang ditanggung perempuan yang melahirkan!"
 },
 {
   "id": 19483,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 24,
   "firman": "\"Demi Aku yang hidup, demikianlah firman TUHAN, bahkan sekalipun Konya bin Yoyakim, raja Yehuda, adalah sebagai cincin meterai pada tangan kanan-Ku, namun Aku akan mencabut engkau!"
 },
 {
   "id": 19484,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 25,
   "firman": "Aku akan menyerahkan engkau ke dalam tangan orang-orang yang berusaha mencabut nyawamu, ke dalam tangan orang-orang yang engkau takuti, ke dalam tangan Nebukadnezar, raja Babel, dan ke dalam tangan orang-orang Kasdim."
 },
 {
   "id": 19485,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 26,
   "firman": "Aku akan melemparkan engkau serta ibumu yang melahirkan engkau ke negeri lain, yang bukan tempat kelahiranmu; di sanalah kamu akan mati."
 },
 {
   "id": 19486,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 27,
   "firman": "Tetapi ke negeri yang mereka rindukan untuk kembali ke situ, mereka tidak akan kembali!\""
 },
 {
   "id": 19487,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 28,
   "firman": "Adakah Konya ini suatu benda yang hina, yang akan dipecahkan orang, atau suatu periuk yang tidak disukai orang? Mengapakah ia dicampakkan dan dilemparkan ke negeri yang tidak dikenalnya?"
 },
 {
   "id": 19488,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 29,
   "firman": "Hai negeri, negeri, negeri! Dengarlah firman TUHAN!"
 },
 {
   "id": 19489,
   "kitab": "Yer",
   "pasal": 22,
   "ayat": 30,
   "firman": "Beginilah firman TUHAN: \"Catatlah orang ini sebagai orang yang tak punya anak, sebagai laki-laki yang tidak pernah berhasil dalam hidupnya; sebab seorangpun dari keturunannya tidak akan berhasil duduk di atas takhta Daud dan memerintah kembali di Yehuda.\""
 },
 {
   "id": 19490,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 1,
   "firman": "\"Celakalah para gembala yang membiarkan kambing domba gembalaan-Ku hilang dan terserak!\" --demikianlah firman TUHAN."
 },
 {
   "id": 19491,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 2,
   "firman": "Sebab itu beginilah firman TUHAN, Allah Israel, terhadap para gembala yang menggembalakan bangsaku: \"Kamu telah membiarkan kambing domba-Ku terserak dan tercerai-berai, dan kamu tidak menjaganya. Maka ketahuilah, Aku akan membalaskan kepadamu perbuatan-perbuatanmu yang jahat, demikianlah firman TUHAN."
 },
 {
   "id": 19492,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 3,
   "firman": "Dan Aku sendiri akan mengumpulkan sisa-sisa kambing domba-Ku dari segala negeri ke mana Aku menceraiberaikan mereka, dan Aku akan membawa mereka kembali ke padang mereka: mereka akan berkembang biak dan bertambah banyak."
 },
 {
   "id": 19493,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 4,
   "firman": "Aku akan mengangkat atas mereka gembala-gembala yang akan menggembalakan mereka, sehingga mereka tidak takut lagi, tidak terkejut dan tidak hilang seekorpun, demikianlah firman TUHAN."
 },
 {
   "id": 19494,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 5,
   "firman": "Sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan menumbuhkan Tunas adil bagi Daud. Ia akan memerintah sebagai raja yang bijaksana dan akan melakukan keadilan dan kebenaran di negeri."
 },
 {
   "id": 19495,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 6,
   "firman": "Dalam zamannya Yehuda akan dibebaskan, dan Israel akan hidup dengan tenteram; dan inilah namanya yang diberikan orang kepadanya: TUHAN--keadilan kita."
 },
 {
   "id": 19496,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 7,
   "firman": "Sebab itu, demikianlah firman TUHAN, sesungguhnya, waktunya akan datang, bahwa orang tidak lagi mengatakan: Demi TUHAN yang hidup yang menuntun orang Israel keluar dari tanah Mesir!,"
 },
 {
   "id": 19497,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 8,
   "firman": "melainkan: Demi TUHAN yang hidup yang menuntun dan membawa pulang keturunan kaum Israel keluar dari tanah utara dan dari segala negeri ke mana Ia telah menceraiberaikan mereka!, maka mereka akan tinggal di tanahnya sendiri.\""
 },
 {
   "id": 19498,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 9,
   "firman": "Mengenai nabi-nabi. Hatiku hancur dalam dadaku, segala tulangku goyah. Keadaanku seperti orang mabuk, seperti laki-laki yang terlalu banyak minum anggur, oleh karena TUHAN dan oleh karena firman-Nya yang kudus."
 },
 {
   "id": 19499,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 10,
   "firman": "Negeri telah penuh dengan orang-orang berzinah; sungguh, oleh karena kutuk ini gersanglah negeri dan layulah padang-padang rumput di gurun; apa yang dikejar mereka adalah kejahatan, dan kekuatan mereka adalah ketidakadilan."
 },
 {
   "id": 19500,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 11,
   "firman": "\"Sungguh, baik nabi maupun imam berlaku fasik; di rumah-Kupun juga Aku mendapati kejahatan mereka, demikianlah firman TUHAN."
 },
 {
   "id": 19501,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 12,
   "firman": "Sebab itu jalan mereka akan seperti jalan-jalan yang licin bagi mereka; di dalam gelap mereka akan terserandung dan akan jatuh di sana; sebab Aku akan mendatangkan malapetaka atas mereka dalam tahun waktu mereka dihukum, demikianlah firman TUHAN."
 },
 {
   "id": 19502,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 13,
   "firman": "Di kalangan para nabi Samaria Aku melihat ada yang kurang pantas: mereka bernubuat demi Baal dan menyesatkan umat-Ku Israel."
 },
 {
   "id": 19503,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 14,
   "firman": "Tetapi di kalangan para nabi Yerusalem Aku melihat ada yang mengerikan: mereka berzinah dan berkelakuan tidak jujur; mereka menguatkan hati orang-orang yang berbuat jahat, sehingga tidak ada seorangpun yang bertobat dari kejahatannya; semuanya mereka telah menjadi seperti Sodom bagi-Ku dan penduduknya seperti Gomora.\""
 },
 {
   "id": 19504,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 15,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam mengenai para nabi itu: \"Sesungguhnya, Aku akan memberi mereka makan ipuh dan minum racun, sebab dari para nabi Yerusalem telah meluas kefasikan ke seluruh negeri.\""
 },
 {
   "id": 19505,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 16,
   "firman": "Beginilah firman TUHAN semesta alam: \"Janganlah dengarkan perkataan para nabi yang bernubuat kepada kamu! Mereka hanya memberi harapan yang sia-sia kepadamu, dan hanya mengungkapkan penglihatan rekaan hatinya sendiri, bukan apa yang datang dari mulut TUHAN;"
 },
 {
   "id": 19506,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 17,
   "firman": "mereka selalu berkata kepada orang-orang yang menista firman TUHAN: Kamu akan selamat! dan kepada setiap orang yang mengikuti kedegilan hatinya mereka berkata: Malapetaka tidak akan menimpa kamu!\""
 },
 {
   "id": 19507,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 18,
   "firman": "Sebab siapakah yang hadir dalam dewan musyawarah TUHAN, sehingga ia memperhatikan dan mendengar firman-Nya? Siapakah yang memperhatikan firman-Nya dan mendengarnya?"
 },
 {
   "id": 19508,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 19,
   "firman": "Lihatlah, angin badai TUHAN, yakni kehangatan murka, telah keluar menyambar, --angin puting beliung--dan turun menimpa kepala orang-orang fasik."
 },
 {
   "id": 19509,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 20,
   "firman": "Murka TUHAN tidak akan surut, sampai Ia telah melaksanakan dan mewujudkan apa yang dirancang-Nya dalam hati-Nya; pada hari-hari yang terakhir kamu akan benar-benar mengerti hal itu."
 },
 {
   "id": 19510,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 21,
   "firman": "\"Aku tidak mengutus para nabi itu, namun mereka giat; Aku tidak berfirman kepada mereka, namun mereka bernubuat."
 },
 {
   "id": 19511,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 22,
   "firman": "Sekiranya mereka hadir dalam dewan musyawarah-Ku, niscayalah mereka akan mengabarkan firman-Ku kepada umat-Ku, membawa mereka kembali dari tingkah langkahnya yang jahat dan dari perbuatan-perbuatannya yang jahat."
 },
 {
   "id": 19512,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 23,
   "firman": "Masakan Aku ini hanya Allah yang dari dekat, demikianlah firman TUHAN, dan bukan Allah yang dari jauh juga?"
 },
 {
   "id": 19513,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 24,
   "firman": "Sekiranya ada seseorang menyembunyikan diri dalam tempat persembunyian, masakan Aku tidak melihat dia? demikianlah firman TUHAN. Tidakkah Aku memenuhi langit dan bumi? demikianlah firman TUHAN."
 },
 {
   "id": 19514,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 25,
   "firman": "Aku telah mendengar apa yang dikatakan oleh para nabi, yang bernubuat palsu demi nama-Ku dengan mengatakan: Aku telah bermimpi, aku telah bermimpi!"
 },
 {
   "id": 19515,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 26,
   "firman": "Sampai bilamana hal itu ada dalam hati para nabi yang bernubuat palsu dan yang menubuatkan tipu rekaan hatinya sendiri,"
 },
 {
   "id": 19516,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 27,
   "firman": "yang merancang membuat umat-Ku melupakan nama-Ku dengan mimpi-mimpinya yang mereka ceritakan seorang kepada seorang, sama seperti nenek moyang mereka melupakan nama-Ku oleh karena Baal?"
 },
 {
   "id": 19517,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 28,
   "firman": "Nabi yang beroleh mimpi, biarlah menceritakan mimpinya itu, dan nabi yang beroleh firman-Ku, biarlah menceritakan firman-Ku itu dengan benar! Apakah sangkut-paut jerami dengan gandum? demikianlah firman TUHAN."
 },
 {
   "id": 19518,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 29,
   "firman": "Bukankah firman-Ku seperti api, demikianlah firman TUHAN dan seperti palu yang menghancurkan bukit batu?"
 },
 {
   "id": 19519,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 30,
   "firman": "Sebab itu, sesungguhnya, Aku akan menjadi lawan para nabi, demikianlah firman TUHAN, yang mencuri firman-Ku masing-masing dari temannya."
 },
 {
   "id": 19520,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 31,
   "firman": "Sesungguhnya, Aku akan menjadi lawan para nabi, demikianlah firman TUHAN, yang memakai lidahnya sewenang-wenang untuk mengutarakan firman ilahi."
 },
 {
   "id": 19521,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 32,
   "firman": "Sesungguhnya, Aku akan menjadi lawan mereka yang menubuatkan mimpi-mimpi dusta, demikianlah firman TUHAN, dan yang menceritakannya serta menyesatkan umat-Ku dengan dustanya dan dengan bualnya. Aku ini tidak pernah mengutus mereka dan tidak pernah memerintahkan mereka. Mereka sama sekali tiada berguna untuk bangsa ini, demikianlah firman TUHAN."
 },
 {
   "id": 19522,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 33,
   "firman": "Apabila bangsa ini--baik nabi ataupun imam--bertanya kepadamu: Apakah Sabda yang dibebankan oleh TUHAN?, maka jawablah mereka: Kamulah beban itu! Sebab itu kamu akan Kubuang dari hadapan-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 19523,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 34,
   "firman": "Adapun nabi atau imam atau rakyat yang masih berbicara tentang Sabda yang dibebankan oleh TUHAN, kepada orang itu dan kepada keluarganya akan Kulakukan pembalasan."
 },
 {
   "id": 19524,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 35,
   "firman": "Beginilah harus kamu katakan, masing-masing kepada temannya dan masing-masing kepada saudaranya: Apakah jawab TUHAN? atau: Apakah firman TUHAN?"
 },
 {
   "id": 19525,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 36,
   "firman": "Tetapi Sabda yang dibebankan oleh TUHAN janganlah kamu sebut-sebutkan lagi, sebab yang menjadi beban bagi setiap orang ialah perkataannya sendiri, oleh karena kamu telah memutarbalikkan perkataan-perkataan Allah yang hidup, TUHAN semesta alam, Allah kita."
 },
 {
   "id": 19526,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 37,
   "firman": "Beginilah engkau harus berkata kepada nabi: Apakah jawab TUHAN kepadamu? atau: Apakah firman TUHAN?"
 },
 {
   "id": 19527,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 38,
   "firman": "Tetapi jika kamu masih berbicara tentang Sabda yang dibebankan oleh TUHAN, maka beginilah firman TUHAN: Oleh karena kamu masih memakai ungkapan Sabda yang dibebankan oleh TUHAN itu, sekalipun Aku mengutus orang kepadamu mengatakan: Janganlah kamu berbicara tentang Sabda yang dibebankan oleh TUHAN,"
 },
 {
   "id": 19528,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 39,
   "firman": "maka sesungguhnya, Aku akan menangkap kamu dan membuang kamu dari hadapan-Ku, kamu serta kota yang telah Kuberikan kepadamu dan kepada nenek moyangmu itu."
 },
 {
   "id": 19529,
   "kitab": "Yer",
   "pasal": 23,
   "ayat": 40,
   "firman": "Aku akan menimpakan kepadamu aib yang kekal dan noda yang kekal yang tidak akan terlupakan.\""
 },
 {
   "id": 19530,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 1,
   "firman": "Lihatlah, TUHAN memperlihatkan kepadaku dua keranjang buah ara berdiri di hadapan bait TUHAN. Hal itu terjadi sesudah Nebukadnezar, raja Babel, mengangkut ke dalam pembuangan Yekhonya bin Yoyakim, raja Yehuda, beserta para pemuka Yehuda, tukang dan pandai besi dari Yerusalem dan membawa mereka ke Babel."
 },
 {
   "id": 19531,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 2,
   "firman": "Keranjang yang satu berisi buah ara yang sangat baik seperti buah ara bungaran, tetapi keranjang yang lain berisi buah ara yang jelek, yang tak dapat dimakan karena jeleknya."
 },
 {
   "id": 19532,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 3,
   "firman": "Lalu berfirmanlah TUHAN kepadaku: \"Apakah yang kaulihat, hai Yeremia?\" Maka jawabku: \"Buah ara! Buah ara yang baik itu sangat baik, dan buah ara yang jelek, yang tak dapat dimakan karena jeleknya.\""
 },
 {
   "id": 19533,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 4,
   "firman": "Kemudian datanglah firman TUHAN kepadaku, bunyinya:"
 },
 {
   "id": 19534,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 5,
   "firman": "\"Beginilah firman TUHAN, Allah Israel: Sama seperti buah ara yang baik ini, demikianlah Aku akan memperhatikan untuk kebaikannya orang-orang Yehuda yang Kubawa dari tempat ini ke dalam pembuangan, ke negeri orang-orang Kasdim."
 },
 {
   "id": 19535,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 6,
   "firman": "Maka Aku akan mengarahkan mata-Ku kepada mereka untuk kebaikan mereka, dan Aku akan membawa mereka kembali ke negeri ini. Aku akan membangun mereka, bukan meruntuhkannya; Aku akan menanam, bukan mencabutnya."
 },
 {
   "id": 19536,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 7,
   "firman": "Aku akan memberi mereka suatu hati untuk mengenal Aku, yaitu bahwa Akulah TUHAN. Mereka akan menjadi umat-Ku dan Aku ini akan menjadi Allah mereka, sebab mereka akan bertobat kepada-Ku dengan segenap hatinya."
 },
 {
   "id": 19537,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 8,
   "firman": "Tetapi seperti buah ara yang jelek itu, yang tak dapat dimakan karena jeleknya--sungguh, beginilah firman TUHAN--demikianlah Aku akan memperlakukan Zedekia, raja Yehuda, beserta para pemukanya, dan sisa-sisa penduduk Yerusalem yang masih tinggal di negeri ini dan orang-orang yang menetap di negeri Mesir."
 },
 {
   "id": 19538,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 9,
   "firman": "Aku akan membuat mereka menjadi kengerian bagi segala kerajaan di bumi, menjadi aib dan perumpamaan, menjadi sindiran dan kutuk di segala tempat ke mana Aku menceraiberaikan mereka."
 },
 {
   "id": 19539,
   "kitab": "Yer",
   "pasal": 24,
   "ayat": 10,
   "firman": "Dan Aku akan mengirimkan perang, kelaparan dan penyakit sampar ke antara mereka, sampai mereka habis dilenyapkan dari atas tanah yang telah Kuberikan kepada mereka dan kepada nenek moyang mereka.\""
 },
 {
   "id": 19540,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 1,
   "firman": "Firman yang datang kepada Yeremia tentang segenap kaum Yehuda dalam tahun keempat pemerintahan Yoyakim bin Yosia, raja Yehuda, yaitu dalam tahun pertama pemerintahan Nebukadnezar, raja Babel."
 },
 {
   "id": 19541,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 2,
   "firman": "Firman itu telah disampaikan oleh nabi Yeremia kepada segenap kaum Yehuda dan kepada segenap penduduk Yerusalem, katanya:"
 },
 {
   "id": 19542,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 3,
   "firman": "\"Sejak dari tahun yang ketiga belas pemerintahan Yosia bin Amon, raja Yehuda, sampai hari ini, jadi sudah dua puluh tiga tahun lamanya, firman TUHAN datang kepadaku dan terus-menerus aku mengucapkannya kepadamu, tetapi kamu tidak mau mendengarkannya."
 },
 {
   "id": 19543,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 4,
   "firman": "Juga TUHAN terus-menerus mengutus kepadamu semua hamba-Nya, yakni nabi-nabi, tetapi kamu tidak mau mendengarkan dan memperhatikannya."
 },
 {
   "id": 19544,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 5,
   "firman": "Kata mereka: Bertobatlah masing-masing kamu dari tingkah langkahmu yang jahat dan dari perbuatan-perbuatanmu yang jahat; maka kamu akan tetap diam di tanah yang diberikan TUHAN kepadamu dan kepada nenek moyangmu, dari selama-lamanya sampai selama-lamanya."
 },
 {
   "id": 19545,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 6,
   "firman": "Juga janganlah kamu mengikuti allah lain untuk beribadah dan sujud menyembah kepadanya; janganlah kamu menimbulkan sakit hati-Ku dengan buatan tanganmu, supaya jangan Aku mendatangkan malapetaka kepadamu."
 },
 {
   "id": 19546,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 7,
   "firman": "Tetapi kamu tidak mendengarkan Aku, demikianlah firman TUHAN, sehingga kamu menimbulkan sakit hati-Ku dengan buatan tanganmu untuk kemalanganmu sendiri."
 },
 {
   "id": 19547,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 8,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam: Oleh karena kamu tidak mendengarkan perkataan-perkataan-Ku,"
 },
 {
   "id": 19548,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 9,
   "firman": "sesungguhnya, Aku akan mengerahkan semua kaum dari utara--demikianlah firman TUHAN--menyuruh memanggil Nebukadnezar, raja Babel, hamba-Ku itu; Aku akan mendatangkan mereka melawan negeri ini, melawan penduduknya dan melawan bangsa-bangsa sekeliling ini, yang akan Kutumpas dan Kubuat menjadi kengerian, menjadi sasaran suitan dan menjadi ketandusan untuk selama-lamanya."
 },
 {
   "id": 19549,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 10,
   "firman": "Aku akan melenyapkan dari antara mereka suara kegirangan dan suara sukacita, suara pengantin laki-laki dan pengantin perempuan, bunyi batu kilangan dan cahaya pelita."
 },
 {
   "id": 19550,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 11,
   "firman": "Maka seluruh negeri ini akan menjadi reruntuhan dan ketandusan, dan bangsa-bangsa ini akan menjadi hamba kepada raja Babel tujuh puluh tahun lamanya."
 },
 {
   "id": 19551,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 12,
   "firman": "Kemudian sesudah genap ketujuh puluh tahun itu, demikianlah firman TUHAN, maka Aku akan melakukan pembalasan kepada raja Babel dan kepada bangsa itu oleh karena kesalahan mereka, juga kepada negeri orang-orang Kasdim, dengan membuatnya menjadi tempat-tempat yang tandus untuk selama-lamanya."
 },
 {
   "id": 19552,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 13,
   "firman": "Aku akan menimpakan kepada negeri ini segala apa yang Kufirmankan tentang dia, yaitu segala apa yang tertulis dalam kitab ini seperti yang telah dinubuatkan Yeremia tentang segala bangsa itu."
 },
 {
   "id": 19553,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 14,
   "firman": "Sebab merekapun juga akan menjadi hamba kepada banyak bangsa-bangsa dan raja-raja yang besar, dan Aku akan mengganjar mereka setimpal dengan pekerjaan mereka dan setimpal dengan perbuatan tangan mereka.\""
 },
 {
   "id": 19554,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 15,
   "firman": "Beginilah firman TUHAN, Allah Israel, kepadaku: \"Ambillah dari tangan-Ku piala berisi anggur kehangatan amarah ini dan minumkanlah isinya kepada segala bangsa yang kepadanya Aku mengutus engkau,"
 },
 {
   "id": 19555,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 16,
   "firman": "supaya mereka minum, menjadi terhuyung-huyung dan bingung karena pedang yang hendak Kukirimkan ke antaranya."
 },
 {
   "id": 19556,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 17,
   "firman": "Maka aku mengambil piala itu dari tangan TUHAN, lalu meminumkan isinya kepada segala bangsa yang kepadanya TUHAN mengutus aku,"
 },
 {
   "id": 19557,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 18,
   "firman": "yakni kepada Yerusalem dan kota-kota Yehuda, beserta raja-rajanya dan pemuka-pemukanya, untuk membuat semuanya itu menjadi reruntuhan, ketandusan dan sasaran suitan dan kutuk seperti halnya pada hari ini;"
 },
 {
   "id": 19558,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 19,
   "firman": "kepada Firaun, raja Mesir, beserta pegawai-pegawainya, dan pemuka-pemukanya, dan segenap rakyatnya,"
 },
 {
   "id": 19559,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 20,
   "firman": "juga kepada semua orang campuran dari berbagai-bagai bangsa; kepada semua raja negeri Us; kepada semua raja negeri Filistin, yakni Askelon, Gaza, Ekron dan orang-orang yang masih tinggal hidup di Asdod;"
 },
 {
   "id": 19560,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 21,
   "firman": "kepada Edom, Moab dan bani Amon;"
 },
 {
   "id": 19561,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 22,
   "firman": "kepada semua raja Tirus, semua raja Sidon dan kepada raja-raja tanah pesisir di seberang laut;"
 },
 {
   "id": 19562,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 23,
   "firman": "kepada Dedan, Tema, Bus dan kepada orang-orang yang berpotong tepi rambutnya berkeliling;"
 },
 {
   "id": 19563,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 24,
   "firman": "kepada semua raja Arab yang tinggal di padang gurun;"
 },
 {
   "id": 19564,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 25,
   "firman": "kepada semua raja Zimri, kepada semua raja Elam dan kepada semua raja Madai;"
 },
 {
   "id": 19565,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 26,
   "firman": "kepada semua raja dari utara, yang dekat dan yang jauh, satu demi satu, dan kepada semua kerajaan dunia yang ada di atas muka bumi; juga raja Sesakh akan meminumnya sesudah mereka."
 },
 {
   "id": 19566,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 27,
   "firman": "Kemudian haruslah kaukatakan kepada mereka: Beginilah firman TUHAN semesta alam, Allah Israel: Minumlah sampai mabuk dan muntah-muntah! Rebahlah dan jangan bangun lagi, oleh karena pedang yang hendak Kukirimkan ke antara kamu!"
 },
 {
   "id": 19567,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 28,
   "firman": "Tetapi apabila mereka enggan menerima piala itu dari tanganmu untuk meminum isinya, maka haruslah kaukatakan kepada mereka: Beginilah firman TUHAN semesta alam: Kamu wajib meminumnya!"
 },
 {
   "id": 19568,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 29,
   "firman": "Sebab sesungguhnya di kota yang nama-Ku telah diserukan di atasnya Aku akan mulai mendatangkan malapetaka; masakan kamu ini akan bebas dari hukuman? kamu tidak akan bebas dari hukuman, sebab Aku ini mengerahkan pedang ke atas segenap penduduk bumi, demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 19569,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 30,
   "firman": "Dan engkau ini, nubuatkanlah segala firman ini kepada mereka. Katakanlah kepada mereka: TUHAN akan menengking dari tempat tinggi dan memperdengarkan suara-Nya dari tempat pernaungan-Nya yang kudus; Ia akan mengaum hebat terhadap tempat penggembalaan-Nya, suatu pekik, seperti yang dipekikkan pengirik-pengirik buah anggur, terhadap segenap penduduk bumi."
 },
 {
   "id": 19570,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 31,
   "firman": "Deru perang akan sampai ke ujung bumi, sebab TUHAN mempunyai pengaduan terhadap bangsa-bangsa; Ia akan berperkara dengan segala makhluk: Orang-orang fasik akan diserahkan-Nya kepada pedang, demikianlah firman TUHAN."
 },
 {
   "id": 19571,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 32,
   "firman": "Beginilah firman TUHAN semesta alam: Sesungguhnya, malapetaka akan menjalar dari bangsa ke bangsa, suatu badai besar akan berkecamuk dari ujung-ujung bumi."
 },
 {
   "id": 19572,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 33,
   "firman": "Maka pada hari itu akan bergelimpangan orang-orang yang mati terbunuh oleh TUHAN dari ujung bumi sampai ke ujung bumi. Mereka tidak akan diratapi, tidak akan dikumpulkan dan tidak akan dikuburkan; mereka akan menjadi pupuk di ladang."
 },
 {
   "id": 19573,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 34,
   "firman": "Mengeluh dan berteriaklah, hai para gembala! Berguling-gulinglah dalam debu, hai pemimpin-pemimpin kawanan kambing domba! Sebab sudah genap waktunya kamu akan disembelih, dan kamu akan rebah seperti domba jantan pilihan."
 },
 {
   "id": 19574,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 35,
   "firman": "Maka bagi para gembala tidak akan ada lagi kelepasan, dan bagi para pemimpin kawanan kambing domba tidak akan ada lagi keluputan."
 },
 {
   "id": 19575,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 36,
   "firman": "Dengar! para gembala berteriak, para pemimpin kawanan kambing domba mengeluh! Sebab TUHAN telah merusakkan padang gembalaan mereka,"
 },
 {
   "id": 19576,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 37,
   "firman": "dan sunyi sepilah padang rumput yang sentosa, oleh karena murka TUHAN yang menyala-nyala itu."
 },
 {
   "id": 19577,
   "kitab": "Yer",
   "pasal": 25,
   "ayat": 38,
   "firman": "Seperti singa Ia meninggalkan semak belukar persembunyian-Nya, sebab negeri mereka sudah menjadi ketandusan, oleh karena pedang yang dahsyat, oleh karena murka-Nya yang menyala-nyala.\""
 },
 {
   "id": 19578,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 1,
   "firman": "Pada permulaan pemerintahan Yoyakim, anak Yosia raja Yehuda, datanglah firman ini dari TUHAN, bunyinya:"
 },
 {
   "id": 19579,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN: \"Berdirilah di pelataran rumah TUHAN dan katakanlah kepada penduduk segala kota Yehuda, yang datang untuk sujud di rumah TUHAN, segala firman yang Kuperintahkan untuk kaukatakan kepada mereka. Janganlah kaukurangi sepatah katapun!"
 },
 {
   "id": 19580,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 3,
   "firman": "Mungkin mereka mau mendengarkan dan masing-masing mau berbalik dari tingkah langkahnya yang jahat, sehingga Aku menyesal akan malapetaka yang Kurancangkan itu terhadap mereka oleh karena perbuatan-perbuatan mereka yang jahat."
 },
 {
   "id": 19581,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 4,
   "firman": "Jadi katakanlah kepada mereka: Beginilah firman TUHAN: Jika kamu tidak mau mendengarkan Aku, tidak mau mengikuti Taurat-Ku yang telah Kubentangkan di hadapanmu,"
 },
 {
   "id": 19582,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 5,
   "firman": "dan tidak mau mendengarkan perkataan hamba-hamba-Ku, para nabi, yang terus-menerus Kuutus kepadamu, --tetapi kamu tidak mau mendengarkan--"
 },
 {
   "id": 19583,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 6,
   "firman": "maka Aku akan membuat rumah ini sama seperti Silo, dan kota ini menjadi kutuk bagi segala bangsa di bumi.\""
 },
 {
   "id": 19584,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 7,
   "firman": "Para imam, para nabi dan seluruh rakyat mendengar Yeremia mengucapkan perkataan-perkataan itu dalam rumah TUHAN."
 },
 {
   "id": 19585,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 8,
   "firman": "Lalu sesudah Yeremia selesai mengatakan segala apa yang diperintahkan TUHAN untuk dikatakan kepada seluruh rakyat itu, maka para imam, para nabi dan seluruh rakyat itu menangkap dia serta berkata: \"Engkau harus mati!"
 },
 {
   "id": 19586,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 9,
   "firman": "Mengapa engkau bernubuat demi nama TUHAN dengan berkata: Rumah ini akan sama seperti Silo, dan kota ini akan menjadi reruntuhan, sehingga tidak ada lagi penduduknya?\" Dan seluruh rakyat berkumpul mengerumuni Yeremia di rumah TUHAN."
 },
 {
   "id": 19587,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 10,
   "firman": "Ketika para pemuka Yehuda mendengar tentang hal ini, pergilah mereka dari istana raja ke rumah TUHAN, lalu duduk di pintu gerbang baru di rumah TUHAN."
 },
 {
   "id": 19588,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 11,
   "firman": "Kemudian berkatalah para imam dan para nabi itu kepada para pemuka dan kepada seluruh rakyat itu, katanya: \"Orang ini patut mendapat hukuman mati, sebab ia telah bernubuat tentang kota ini, seperti yang kamu dengar dengan telingamu sendiri.\""
 },
 {
   "id": 19589,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 12,
   "firman": "Tetapi Yeremia berkata kepada segala pemuka dan kepada seluruh rakyat itu, katanya: \"Tuhanlah yang telah mengutus aku supaya bernubuat tentang rumah dan kota ini untuk menyampaikan segala perkataan yang telah kamu dengar itu."
 },
 {
   "id": 19590,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 13,
   "firman": "Oleh sebab itu, perbaikilah tingkah langkahmu dan perbuatanmu, dan dengarkanlah suara TUHAN, Allahmu, sehingga TUHAN menyesal akan malapetaka yang diancamkan-Nya atas kamu."
 },
 {
   "id": 19591,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 14,
   "firman": "Tetapi aku ini, sesungguhnya, aku ada di tanganmu, perbuatlah kepadaku apa yang baik dan benar di matamu."
 },
 {
   "id": 19592,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 15,
   "firman": "Hanya ketahuilah sungguh-sungguh, bahwa jika kamu membunuh aku, maka kamu mendatangkan darah orang yang tak bersalah atas kamu dan atas kota ini dan penduduknya, sebab TUHAN benar-benar mengutus aku kepadamu untuk menyampaikan segala perkataan ini kepadamu.\""
 },
 {
   "id": 19593,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 16,
   "firman": "Lalu berkatalah para pemuka dan seluruh rakyat itu kepada imam-imam dan nabi-nabi itu: \"Orang ini tidak patut mendapat hukuman mati, sebab ia telah berbicara kepada kita demi nama TUHAN, Allah kita.\""
 },
 {
   "id": 19594,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 17,
   "firman": "Memang beberapa orang dari para tua-tua negeri itu tampil juga ke depan dan berkata kepada kumpulan rakyat itu, katanya:"
 },
 {
   "id": 19595,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 18,
   "firman": "\"Mikha, orang Moresyet itu, telah bernubuat di zaman Hizkia, raja Yehuda. Dia telah berkata kepada segenap bangsa Yehuda: Beginilah firman TUHAN semesta alam: Sion akan dibajak seperti ladang dan Yerusalem akan menjadi timbunan puing dan gunung Bait Suci akan menjadi bukit yang berhutan."
 },
 {
   "id": 19596,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 19,
   "firman": "Apakah Hizkia, raja Yehuda, beserta segenap Yehuda membunuh dia? Tidakkah ia takut akan TUHAN, sehingga ia memohon belas kasihan TUHAN, agar TUHAN menyesal akan malapetaka yang diancamkan-Nya atas mereka? Dan kita, maukah kita mendatangkan malapetaka yang begitu besar atas diri kita sendiri?\""
 },
 {
   "id": 19597,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 20,
   "firman": "Ada juga seorang lain yang bernubuat demi nama TUHAN, yaitu Uria bin Semaya, dari Kiryat-Yearim. Dia bernubuat tentang kota dan negeri ini tepat seperti yang dikatakan Yeremia."
 },
 {
   "id": 19598,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 21,
   "firman": "Ketika raja Yoyakim, bersama-sama dengan segenap perwiranya dan semua pemuka, mendengar perkataan orang itu, maka rajapun mencari ikhtiar untuk membunuhnya. Mendengar hal itu maka takutlah Uria, lalu melarikan diri dan tiba di Mesir."
 },
 {
   "id": 19599,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 22,
   "firman": "Kemudian raja Yoyakim menyuruh orang ke Mesir, yaitu Elnatan bin Akhbor beserta beberapa orang."
 },
 {
   "id": 19600,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 23,
   "firman": "Mereka mengambil Uria dari Mesir dan membawanya kepada raja Yoyakim. Raja menyuruh membunuh dia dengan pedang dan melemparkan mayatnya ke kuburan rakyat biasa."
 },
 {
   "id": 19601,
   "kitab": "Yer",
   "pasal": 26,
   "ayat": 24,
   "firman": "Tetapi Yeremia dilindungi oleh Ahikam bin Safan, sehingga ia tidak diserahkan ke dalam tangan rakyat untuk dibunuh."
 },
 {
   "id": 19602,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 1,
   "firman": "Pada permulaan pemerintahan Zedekia, anak Yosia raja Yehuda, datanglah firman ini dari TUHAN kepada Yeremia."
 },
 {
   "id": 19603,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN kepadaku: \"Buatlah tali pengikat dan gandar, lalu pasanglah itu pada tengkukmu!"
 },
 {
   "id": 19604,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 3,
   "firman": "Kemudian kirimlah pesan kepada raja Edom, kepada raja Moab, kepada raja bani Amon, kepada raja Tirus dan kepada raja Sidon, dengan perantaraan utusan-utusan yang telah datang ke Yerusalem menghadap Zedekia, raja Yehuda."
 },
 {
   "id": 19605,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 4,
   "firman": "Perintahkanlah mereka mengatakan kepada tuan-tuan mereka: Beginilah firman TUHAN semesta alam, Allah Israel: Beginilah harus kamu katakan kepada tuan-tuanmu:"
 },
 {
   "id": 19606,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 5,
   "firman": "Akulah yang menjadikan bumi, manusia dan hewan yang ada di atas muka bumi dengan kekuatan-Ku yang besar dan dengan lengan-Ku yang terentang, dan Aku memberikannya kepada orang yang benar di mata-Ku."
 },
 {
   "id": 19607,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 6,
   "firman": "Dan sekarang, Aku menyerahkan segala negeri ini ke dalam tangan hamba-Ku, yakni Nebukadnezar, raja Babel; juga binatang di padang telah Kuserahkan supaya tunduk kepadanya."
 },
 {
   "id": 19608,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 7,
   "firman": "Segala bangsa akan takluk kepadanya dan kepada anaknya dan kepada cucunya, sampai saatnya juga tiba bagi negerinya sendiri, maka banyak bangsa dan raja-raja yang besar akan menaklukkannya."
 },
 {
   "id": 19609,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 8,
   "firman": "Tetapi bangsa dan kerajaan yang tidak mau takluk kepada Nebukadnezar, raja Babel, dan yang tidak mau menyerahkan tengkuknya ke bawah kuk raja Babel, maka bangsa itu akan Kuhukum dengan pedang, kelaparan dan penyakit sampar, demikianlah firman TUHAN, sampai mereka Kuserahkan ke dalam tangannya."
 },
 {
   "id": 19610,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 9,
   "firman": "Mengenai kamu, janganlah kamu mendengarkan nabi-nabimu, juru-juru tenungmu, juru-juru mimpimu, tukang-tukang ramalmu dan tukang-tukang sihirmu yang berkata kepadamu: Janganlah kamu mau takluk kepada raja Babel!"
 },
 {
   "id": 19611,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 10,
   "firman": "Sebab mereka bernubuat palsu kepadamu dengan maksud menjauhkan kamu dari atas tanahmu, sehingga kamu Kuceraiberaikan dan menjadi binasa."
 },
 {
   "id": 19612,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 11,
   "firman": "Tetapi bangsa yang mau menaruh tengkuknya ke bawah kuk raja Babel dan yang takluk kepadanya, maka mereka akan Kubiarkan di atas tanahnya, demikianlah firman TUHAN, dan mereka akan mengolahnya dan diam di sana.\""
 },
 {
   "id": 19613,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 12,
   "firman": "Kepada Zedekia, raja Yehuda, aku telah berbicara dengan cara yang sama, kataku: \"Taruhlah tengkukmu ke bawah kuk raja negeri Babel, takluklah kepadanya dan kepada rakyatnya, maka kamu akan hidup."
 },
 {
   "id": 19614,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 13,
   "firman": "Mengapa engkau beserta rakyatmu harus mati oleh pedang, kelaparan dan penyakit sampar seperti yang difirmankan TUHAN tentang bangsa yang tidak mau takluk kepada raja Babel itu?"
 },
 {
   "id": 19615,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 14,
   "firman": "Janganlah dengarkan perkataan nabi-nabi yang berkata kepadamu: Janganlah kamu mau takluk kepada raja Babel! Sebab mereka bernubuat palsu kepadamu."
 },
 {
   "id": 19616,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 15,
   "firman": "Sebab Aku tidak mengutus mereka, demikianlah firman TUHAN, tetapi mereka bernubuat palsu demi nama-Ku, sehingga kamu Kuceraiberaikan dan menjadi binasa bersama-sama dengan nabi-nabi yang bernubuat kepadamu itu.\""
 },
 {
   "id": 19617,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 16,
   "firman": "Juga kepada imam-imam dan kepada seluruh rakyat itu aku berbicara, kataku: \"Beginilah firman TUHAN: Janganlah dengarkan perkataan nabi-nabimu yang bernubuat kepadamu: Sesungguhnya, perkakas-perkakas rumah TUHAN tidak berapa lama lagi akan dibawa kembali dari Babel! Sebab mereka bernubuat palsu kepadamu."
 },
 {
   "id": 19618,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 17,
   "firman": "Janganlah kamu mendengarkan mereka, takluklah kepada raja Babel, maka kamu akan hidup. Mengapa kota ini harus menjadi reruntuhan?"
 },
 {
   "id": 19619,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 18,
   "firman": "Jika memang mereka itu nabi dan jika ada firman TUHAN pada mereka, baiklah mereka mendesak kepada TUHAN semesta alam, supaya perkakas-perkakas yang masih tinggal dalam rumah TUHAN dan dalam istana raja Yehuda dan di Yerusalem itu jangan diangkut ke Babel."
 },
 {
   "id": 19620,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 19,
   "firman": "Sebab beginilah firman TUHAN semesta alam tentang tiang-tiang, bejana 'laut' dan galang, tentang sisa perkakas-perkakas yang masih tinggal di kota ini,"
 },
 {
   "id": 19621,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 20,
   "firman": "yang tidak diambil oleh Nebukadnezar, raja Babel, ketika ia mengangkut Yekhonya bin Yoyakim, raja Yehuda, ke dalam pembuangan beserta segala pemuka Yehuda dan Yerusalem, dari Yerusalem ke Babel, --"
 },
 {
   "id": 19622,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 21,
   "firman": "sungguh, beginilah firman TUHAN semesta alam, Allah Israel, tentang perkakas-perkakas yang masih tinggal itu di rumah TUHAN dan di istana raja Yehuda dan di Yerusalem:"
 },
 {
   "id": 19623,
   "kitab": "Yer",
   "pasal": 27,
   "ayat": 22,
   "firman": "Semuanya akan diangkut ke Babel dan akan tinggal di sana sampai kepada hari Aku memperhatikannya lagi, demikianlah firman TUHAN, lalu membawanya kembali ke tempat ini.\""
 },
 {
   "id": 19624,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 1,
   "firman": "Dalam tahun itu juga, pada permulaan pemerintahan Zedekia, raja Yehuda, dalam bulan yang kelima tahun yang keempat, berkatalah nabi Hananya bin Azur yang berasal dari Gibeon itu kepadaku di rumah TUHAN, di depan mata imam-imam dan seluruh rakyat:"
 },
 {
   "id": 19625,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel: Aku telah mematahkan kuk raja Babel itu."
 },
 {
   "id": 19626,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 3,
   "firman": "Dalam dua tahun ini Aku akan mengembalikan ke tempat ini segala perkakas rumah TUHAN yang telah diambil dari tempat ini oleh Nebukadnezar, raja Babel, dan yang diangkutnya ke Babel."
 },
 {
   "id": 19627,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 4,
   "firman": "Juga Yekhonya bin Yoyakim, raja Yehuda, beserta semua orang buangan dari Yehuda yang dibawa ke Babel akan Kukembalikan ke tempat ini, demikianlah firman TUHAN! Sungguh, Aku akan mematahkan kuk raja Babel itu!\""
 },
 {
   "id": 19628,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 5,
   "firman": "Lalu berkatalah nabi Yeremia kepada nabi Hananya di depan mata imam-imam dan di depan mata seluruh rakyat yang berdiri di rumah TUHAN itu,"
 },
 {
   "id": 19629,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 6,
   "firman": "kata nabi Yeremia: \"Amin! Moga-moga TUHAN berbuat demikian! Moga-moga TUHAN menepati perkataan-perkataan yang kaunubuatkan itu dengan dikembalikannya perkakas-perkakas rumah TUHAN dan semua orang buangan itu dari Babel ke tempat ini."
 },
 {
   "id": 19630,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 7,
   "firman": "Hanya, dengarkanlah hendaknya perkataan yang akan kukatakan ke telingamu dan ke telinga seluruh rakyat ini:"
 },
 {
   "id": 19631,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 8,
   "firman": "Nabi-nabi yang ada sebelum aku dan sebelum engkau dari dahulu kala telah bernubuat kepada banyak negeri dan terhadap kerajaan-kerajaan yang besar tentang perang dan malapetaka dan penyakit sampar."
 },
 {
   "id": 19632,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 9,
   "firman": "Tetapi mengenai seorang nabi yang bernubuat tentang damai sejahtera, jika nubuat nabi itu digenapi, maka barulah ketahuan, bahwa nabi itu benar-benar diutus oleh TUHAN.\""
 },
 {
   "id": 19633,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 10,
   "firman": "Kemudian nabi Hananya mengambil gandar itu dari pada tengkuk nabi Yeremia, lalu mematahkannya."
 },
 {
   "id": 19634,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 11,
   "firman": "Berkatalah Hananya di depan mata seluruh rakyat itu: \"Beginilah firman TUHAN: Dalam dua tahun ini begitu jugalah Aku akan mematahkan kuk Nebukadnezar, raja Babel itu, dari pada tengkuk segala bangsa!\" Tetapi pergilah nabi Yeremia dari sana."
 },
 {
   "id": 19635,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 12,
   "firman": "Maka sesudah nabi Hananya mematahkan gandar dari pada tengkuk nabi Yeremia, datanglah firman TUHAN kepada Yeremia:"
 },
 {
   "id": 19636,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 13,
   "firman": "\"Pergilah mengatakan kepada Hananya: Beginilah firman TUHAN: Engkau telah mematahkan gandar kayu, tetapi Aku akan membuat gandar besi sebagai gantinya!"
 },
 {
   "id": 19637,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 14,
   "firman": "Sebab beginilah firman TUHAN semesta alam, Allah Israel: Kuk besi akan Kutaruh ke atas tengkuk segala bangsa ini, sehingga mereka takluk kepada Nebukadnezar, raja Babel; sungguh, mereka akan takluk kepadanya! Malahan binatang-binatang di padang telah Kuserahkan kepadanya.\""
 },
 {
   "id": 19638,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 15,
   "firman": "Lalu berkatalah nabi Yeremia kepada nabi Hananya: \"Dengarkanlah, hai Hananya! TUHAN tidak mengutus engkau, tetapi engkau telah membuat bangsa ini percaya kepada dusta."
 },
 {
   "id": 19639,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 16,
   "firman": "Sebab itu beginilah firman TUHAN: Sesungguhnya, Aku menyuruh engkau pergi dari muka bumi. Tahun ini juga engkau akan mati, sebab engkau telah mengajak murtad terhadap TUHAN.\""
 },
 {
   "id": 19640,
   "kitab": "Yer",
   "pasal": 28,
   "ayat": 17,
   "firman": "Maka matilah nabi Hananya dalam tahun itu juga, pada bulan yang ketujuh."
 },
 {
   "id": 19641,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 1,
   "firman": "Beginilah bunyi surat yang dikirim oleh nabi Yeremia dari Yerusalem kepada tua-tua di antara orang buangan, kepada imam-imam, kepada nabi-nabi dan kepada seluruh rakyat yang telah diangkut ke dalam pembuangan oleh Nebukadnezar dari Yerusalem ke Babel."
 },
 {
   "id": 19642,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 2,
   "firman": "Itu terjadi sesudah raja Yekhonya beserta ibu suri, pegawai-pegawai istana, pemuka-pemuka Yehuda dan Yerusalem, tukang dan pandai besi telah keluar dari Yerusalem."
 },
 {
   "id": 19643,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 3,
   "firman": "Surat itu dikirim dengan perantaraan Elasa bin Safan dan Gemarya bin Hilkia yang diutus oleh Zedekia, raja Yehuda, ke Babel, kepada Nebukadnezar, raja Babel. Bunyinya:"
 },
 {
   "id": 19644,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 4,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel, kepada semua orang buangan yang diangkut ke dalam pembuangan dari Yerusalem ke Babel:"
 },
 {
   "id": 19645,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 5,
   "firman": "Dirikanlah rumah untuk kamu diami; buatlah kebun untuk kamu nikmati hasilnya;"
 },
 {
   "id": 19646,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 6,
   "firman": "ambillah isteri untuk memperanakkan anak laki-laki dan perempuan; ambilkanlah isteri bagi anakmu laki-laki dan carikanlah suami bagi anakmu perempuan, supaya mereka melahirkan anak laki-laki dan perempuan, agar di sana kamu bertambah banyak dan jangan berkurang!"
 },
 {
   "id": 19647,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 7,
   "firman": "Usahakanlah kesejahteraan kota ke mana kamu Aku buang, dan berdoalah untuk kota itu kepada TUHAN, sebab kesejahteraannya adalah kesejahteraanmu."
 },
 {
   "id": 19648,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 8,
   "firman": "Sungguh, beginilah firman TUHAN semesta alam, Allah Israel: Janganlah kamu diperdayakan oleh nabi-nabimu yang ada di tengah-tengahmu dan oleh juru-juru tenungmu, dan janganlah kamu dengarkan mimpi-mimpi yang mereka mimpikan!"
 },
 {
   "id": 19649,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 9,
   "firman": "Sebab mereka bernubuat palsu kepadamu demi nama-Ku. Aku tidak mengutus mereka, demikianlah firman TUHAN."
 },
 {
   "id": 19650,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 10,
   "firman": "Sebab beginilah firman TUHAN: Apabila telah genap tujuh puluh tahun bagi Babel, barulah Aku memperhatikan kamu. Aku akan menepati janji-Ku itu kepadamu dengan mengembalikan kamu ke tempat ini."
 },
 {
   "id": 19651,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 11,
   "firman": "Sebab Aku ini mengetahui rancangan-rancangan apa yang ada pada-Ku mengenai kamu, demikianlah firman TUHAN, yaitu rancangan damai sejahtera dan bukan rancangan kecelakaan, untuk memberikan kepadamu hari depan yang penuh harapan."
 },
 {
   "id": 19652,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 12,
   "firman": "Dan apabila kamu berseru dan datang untuk berdoa kepada-Ku, maka Aku akan mendengarkan kamu;"
 },
 {
   "id": 19653,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 13,
   "firman": "apabila kamu mencari Aku, kamu akan menemukan Aku; apabila kamu menanyakan Aku dengan segenap hati,"
 },
 {
   "id": 19654,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 14,
   "firman": "Aku akan memberi kamu menemukan Aku, demikianlah firman TUHAN, dan Aku akan memulihkan keadaanmu dan akan mengumpulkan kamu dari antara segala bangsa dan dari segala tempat ke mana kamu telah Kuceraiberaikan, demikianlah firman TUHAN, dan Aku akan mengembalikan kamu ke tempat yang dari mana Aku telah membuang kamu. --"
 },
 {
   "id": 19655,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 15,
   "firman": "Memang kamu berkata: TUHAN telah membangkitkan nabi-nabi bagi kami di Babel. --"
 },
 {
   "id": 19656,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 16,
   "firman": "Sungguh, beginilah firman TUHAN tentang raja yang duduk di atas takhta Daud dan tentang seluruh rakyat yang diam di kota ini, yakni saudara-saudaramu yang tidak keluar beserta kamu ke dalam pembuangan:"
 },
 {
   "id": 19657,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 17,
   "firman": "Beginilah firman TUHAN semesta alam: Sesungguhnya, Aku akan mengirim pedang, kelaparan dan penyakit sampar ke antara mereka, dan Aku akan membuat mereka seperti buah ara yang busuk dan demikian jeleknya, sehingga tidak dapat dimakan."
 },
 {
   "id": 19658,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 18,
   "firman": "Aku akan mengejar mereka dengan pedang, kelaparan dan penyakit sampar, dan Aku akan membuat mereka menjadi kengerian bagi segala kerajaan di bumi, menjadi kutuk, kedahsyatan, suitan dan aib di antara segala bangsa ke mana mereka Kuceraiberaikan,"
 },
 {
   "id": 19659,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 19,
   "firman": "sebagai ganjaran bahwa mereka tidak mendengarkan perkataan-Ku, demikianlah firman TUHAN, yang telah Kusampaikan kepada mereka terus-menerus dengan perantaraan hamba-hamba-Ku, yakni para nabi; tetapi kamu tidak mendengarkannya, demikianlah firman TUHAN."
 },
 {
   "id": 19660,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 20,
   "firman": "Tetapi dengarkanlah firman TUHAN, hai kamu semua orang buangan, yang telah Kukirim dari Yerusalem ke Babel!"
 },
 {
   "id": 19661,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 21,
   "firman": "Beginilah firman TUHAN semesta alam, Allah Israel, tentang Ahab bin Kolaya dan tentang Zedekia bin Maaseya, orang-orang yang bernubuat palsu kepadamu demi nama-Ku: Sesungguhnya Aku akan menyerahkan mereka ke dalam tangan Nebukadnezar, raja Babel, yang akan memarang mereka mati di depan matamu sendiri,"
 },
 {
   "id": 19662,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 22,
   "firman": "sehingga dari keadaan mereka akan dijadikan suatu kutuk oleh semua orang buangan dari Yehuda yang ada di Babel, demikian: Biarlah TUHAN memperlakukan kamu seperti Zedekia dan Ahab yang telah dipanggang oleh raja negeri Babel di dalam api!,"
 },
 {
   "id": 19663,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 23,
   "firman": "oleh karena mereka telah melakukan kebebalan di Israel, telah berzinah dengan isteri sesama mereka dan telah mengucapkan demi nama-Ku perkataan dusta yang tidak Kupesankan kepada mereka. Aku sendirilah yang mengetahui dan menyaksikannya, demikianlah firman TUHAN.\""
 },
 {
   "id": 19664,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 24,
   "firman": "Kepada Semaya, orang Nehelam itu, haruslah kaukatakan:"
 },
 {
   "id": 19665,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 25,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel: Oleh sebab engkau telah mengirim surat atas namamu sendiri kepada seluruh rakyat yang ada di Yerusalem, yaitu kepada imam Zefanya bin Maaseya dan kepada segala imam, bunyinya:"
 },
 {
   "id": 19666,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 26,
   "firman": "TUHAN telah mengangkat engkau, Zefanya, menjadi imam menggantikan imam Yoyada, supaya engkau menjadi pengawas di rumah TUHAN untuk memasungkan setiap orang gila yang menganggap dirinya nabi dan untuk merantai lehernya dengan besi."
 },
 {
   "id": 19667,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 27,
   "firman": "Tetapi sekarang, mengapakah engkau tidak menegor Yeremia, orang Anatot itu, yang menganggap dirinya nabi di antaramu?"
 },
 {
   "id": 19668,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 28,
   "firman": "Bukankah ia telah mengirim pesan kepada kami di Babel, katanya: Pembuanganmu masih lama. Dirikanlah rumah untuk kamu diami; buatlah kebun untuk kamu nikmati hasilnya!\""
 },
 {
   "id": 19669,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 29,
   "firman": "Surat ini dibacakan oleh imam Zefanya ke telinga nabi Yeremia."
 },
 {
   "id": 19670,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 30,
   "firman": "Maka datanglah firman TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19671,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 31,
   "firman": "\"Kirimlah pesan kepada semua orang buangan itu: Beginilah firman TUHAN tentang Semaya, orang Nehelam itu: Oleh karena Semaya telah bernubuat kepadamu, sekalipun Aku tidak mengutusnya, dan ia telah membuat kamu percaya kepada dusta,"
 },
 {
   "id": 19672,
   "kitab": "Yer",
   "pasal": 29,
   "ayat": 32,
   "firman": "maka beginilah firman TUHAN: Sesungguhnya, Aku akan menghukum Semaya, orang Nehelam itu, dan keturunannya: tidak ada seorangpun dari keluarganya akan diam di tengah-tengah bangsa ini untuk melihat yang baik yang akan Kulakukan kepada umat-Ku, demikianlah firman TUHAN, sebab ia telah mengajak murtad terhadap TUHAN.\""
 },
 {
   "id": 19673,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19674,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN, Allah Israel: Tuliskanlah segala perkataan yang telah Kufirmankan kepadamu itu dalam suatu kitab."
 },
 {
   "id": 19675,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 3,
   "firman": "Sebab, sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan memulihkan keadaan umat-Ku Israel dan Yehuda--firman TUHAN--dan Aku akan mengembalikan mereka ke negeri yang telah Kuberikan kepada nenek moyang mereka, dan mereka akan memilikinya.\""
 },
 {
   "id": 19676,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 4,
   "firman": "Inilah perkataan-perkataan yang telah difirmankan TUHAN tentang Israel dan tentang Yehuda:"
 },
 {
   "id": 19677,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 5,
   "firman": "\"Sungguh, beginilah firman TUHAN: Telah kami dengar jerit kegentaran, kedahsyatan dan tidak ada damai."
 },
 {
   "id": 19678,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 6,
   "firman": "Cobalah tanyakan dan selidiki, adakah laki-laki melahirkan? Mengapakah setiap laki-laki Kulihat tangannya pada pinggangnya seperti seorang perempuan yang melahirkan? Mengapakah setiap muka berubah menjadi pucat?"
 },
 {
   "id": 19679,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 7,
   "firman": "Hai, alangkah hebatnya hari itu, tidak ada taranya; itulah waktu kesusahan bagi Yakub, tetapi ia akan diselamatkan dari padanya."
 },
 {
   "id": 19680,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 8,
   "firman": "Maka pada hari itu, demikianlah firman TUHAN semesta alam, Aku akan mematahkan kuk dari tengkuk mereka dan memutuskan tali-tali pengikat mereka, dan mereka tidak akan mengabdi lagi kepada orang-orang asing."
 },
 {
   "id": 19681,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 9,
   "firman": "Mereka akan mengabdi kepada TUHAN, Allah mereka, dan kepada Daud, raja mereka, yang akan Kubangkitkan bagi mereka."
 },
 {
   "id": 19682,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 10,
   "firman": "Maka engkau, janganlah takut, hai hamba-Ku Yakub, demikianlah firman TUHAN, janganlah gentar, hai Israel! Sebab sesungguhnya, Aku menyelamatkan engkau dari tempat jauh dan keturunanmu dari negeri pembuangan mereka. Yakub akan kembali dan hidup tenang dan aman, dengan tidak ada yang mengejutkan."
 },
 {
   "id": 19683,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 11,
   "firman": "Sebab Aku menyertai engkau, demikianlah firman TUHAN, untuk menyelamatkan engkau: segala bangsa yang ke antaranya engkau Kuserahkan akan Kuhabiskan, tetapi engkau ini tidak akan Kuhabiskan. Aku akan menghajar engkau menurut hukum, tetapi Aku sama sekali tidak memandang engkau tak bersalah."
 },
 {
   "id": 19684,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 12,
   "firman": "Sungguh, beginilah firman TUHAN: Penyakitmu sangat payah, lukamu tidak tersembuhkan!"
 },
 {
   "id": 19685,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 13,
   "firman": "Tidak ada yang membela hakmu, tidak ada obat untuk bisul, kesembuhan tidak ada bagimu!"
 },
 {
   "id": 19686,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 14,
   "firman": "Semua kekasihmu melupakan engkau, mereka tidak menanyakan engkau lagi. Sungguh, Aku telah memukul engkau dengan pukulan musuh, dengan hajaran yang bengis, karena kesalahanmu banyak, dosamu berjumlah besar."
 },
 {
   "id": 19687,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 15,
   "firman": "Mengapakah engkau berteriak karena penyakitmu, karena kepedihanmu sangat payah? Karena kesalahanmu banyak, dosamu berjumlah besar, maka Aku telah melakukan semuanya ini kepadamu."
 },
 {
   "id": 19688,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 16,
   "firman": "Tetapi semua orang yang menelan engkau akan tertelan, dan semua lawanmu akan masuk ke dalam tawanan; orang-orang yang merampok engkau akan menjadi rampokan, dan semua orang yang menjarah engkau akan Kubuat menjadi jarahan."
 },
 {
   "id": 19689,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 17,
   "firman": "Sebab Aku akan mendatangkan kesembuhan bagimu, Aku akan mengobati luka-lukamu, demikianlah firman TUHAN, sebab mereka telah menyebutkan engkau: orang buangan, yakni sisa yang tiada seorangpun menanyakannya."
 },
 {
   "id": 19690,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 18,
   "firman": "Beginilah firman TUHAN: Sesungguhnya, Aku akan memulihkan keadaan kemah-kemah Yakub, dan akan mengasihani tempat-tempat tinggalnya, kota itu akan dibangun kembali di atas reruntuhannya, dan puri itu akan berdiri di tempatnya yang asli."
 },
 {
   "id": 19691,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 19,
   "firman": "Nyanyian syukur akan terdengar dari antara mereka, juga suara orang yang bersukaria. Aku akan membuat mereka banyak dan mereka tidak akan berkurang lagi; Aku akan membuat mereka dipermuliakan dan mereka tidak akan dihina lagi."
 },
 {
   "id": 19692,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 20,
   "firman": "Anak-anak mereka akan menjadi seperti dahulu kala, dan perkumpulan mereka akan tinggal tetap di hadapan-Ku; Aku akan menghukum semua orang yang menindas mereka."
 },
 {
   "id": 19693,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 21,
   "firman": "Orang yang memerintah atas mereka akan tampil dari antara mereka sendiri, dan orang yang berkuasa atas mereka akan bangkit dari tengah-tengah mereka; Aku akan membuat dia maju dan mendekat kepada-Ku, sebab siapakah yang berani mempertaruhkan nyawanya untuk mendekat kepada-Ku? demikianlah firman TUHAN."
 },
 {
   "id": 19694,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 22,
   "firman": "Maka kamu akan menjadi umat-Ku, dan Aku akan menjadi Allahmu.\""
 },
 {
   "id": 19695,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 23,
   "firman": "Lihatlah, angin badai TUHAN, yakni kehangatan murka, telah keluar menyambar, --angin puting beliung--dan turun menimpa kepala orang-orang fasik."
 },
 {
   "id": 19696,
   "kitab": "Yer",
   "pasal": 30,
   "ayat": 24,
   "firman": "Murka TUHAN yang menyala-nyala itu tidak akan surut sampai Ia telah melaksanakan dan mewujudkan apa yang dirancang-Nya dalam hati-Nya; pada hari-hari yang terakhir kamu akan mengerti hal itu."
 },
 {
   "id": 19697,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 1,
   "firman": "\"Pada waktu itu, demikianlah firman TUHAN, Aku akan menjadi Allah segala kaum keluarga Israel dan mereka akan menjadi umat-Ku."
 },
 {
   "id": 19698,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 2,
   "firman": "Beginilah firman TUHAN: Ia mendapat kasih karunia di padang gurun, yaitu bangsa yang terluput dari pedang itu! Israel berjalan mencari istirahat bagi dirinya!"
 },
 {
   "id": 19699,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 3,
   "firman": "Dari jauh TUHAN menampakkan diri kepadanya: Aku mengasihi engkau dengan kasih yang kekal, sebab itu Aku melanjutkan kasih setia-Ku kepadamu."
 },
 {
   "id": 19700,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 4,
   "firman": "Aku akan membangun engkau kembali, sehingga engkau dibangun, hai anak dara Israel! Engkau akan menghiasi dirimu kembali dengan rebana dan akan tampil dalam tari-tarian orang yang bersukaria."
 },
 {
   "id": 19701,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 5,
   "firman": "Engkau akan membuat kebun anggur kembali di gunung-gunung Samaria; ya, orang-orang yang membuatnya akan memetik hasilnya pula."
 },
 {
   "id": 19702,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 6,
   "firman": "Sungguh, akan datang harinya bahwa para penjaga akan berseru di gunung Efraim: Ayo, marilah kita naik ke Sion, kepada TUHAN, Allah kita!"
 },
 {
   "id": 19703,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 7,
   "firman": "Sebab beginilah firman TUHAN: Bersorak-sorailah bagi Yakub dengan sukacita, bersukarialah tentang pemimpin bangsa-bangsa! Kabarkanlah, pujilah dan katakanlah: TUHAN telah menyelamatkan umat-Nya, yakni sisa-sisa Israel!"
 },
 {
   "id": 19704,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 8,
   "firman": "Sesungguhnya, Aku akan membawa mereka dari tanah utara dan akan mengumpulkan mereka dari ujung bumi; di antara mereka ada orang buta dan lumpuh, ada perempuan yang mengandung bersama-sama dengan perhimpunan yang melahirkan; dalam kumpulan besar mereka akan kembali ke mari!"
 },
 {
   "id": 19705,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 9,
   "firman": "Dengan menangis mereka akan datang, dengan hiburan Aku akan membawa mereka; Aku akan memimpin mereka ke sungai-sungai, di jalan yang rata, di mana mereka tidak akan tersandung; sebab Aku telah menjadi bapa Israel, Efraim adalah anak sulung-Ku."
 },
 {
   "id": 19706,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 10,
   "firman": "Dengarlah firman TUHAN, hai bangsa-bangsa, beritahukanlah itu di tanah-tanah pesisir yang jauh, katakanlah: Dia yang telah menyerakkan Israel akan mengumpulkannya kembali, dan menjaganya seperti gembala terhadap kawanan dombanya!"
 },
 {
   "id": 19707,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 11,
   "firman": "Sebab TUHAN telah membebaskan Yakub, telah menebusnya dari tangan orang yang lebih kuat dari padanya."
 },
 {
   "id": 19708,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 12,
   "firman": "Mereka akan datang bersorak-sorak di atas bukit Sion, muka mereka akan berseri-seri karena kebajikan TUHAN, karena gandum, anggur dan minyak, karena anak-anak kambing domba dan lembu sapi; hidup mereka akan seperti taman yang diairi baik-baik, mereka tidak akan kembali lagi merana."
 },
 {
   "id": 19709,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 13,
   "firman": "Pada waktu itu anak-anak dara akan bersukaria menari beramai-ramai, orang-orang muda dan orang-orang tua akan bergembira. Aku akan mengubah perkabungan mereka menjadi kegirangan, akan menghibur mereka dan menyukakan mereka sesudah kedukaan mereka."
 },
 {
   "id": 19710,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 14,
   "firman": "Aku akan memuaskan jiwa para imam dengan kelimpahan, dan umat-Ku akan menjadi kenyang dengan kebajikan-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 19711,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 15,
   "firman": "Beginilah firman TUHAN: Dengar! Di Rama terdengar ratapan, tangisan yang pahit pedih: Rahel menangisi anak-anaknya, ia tidak mau dihibur karena anak-anaknya, sebab mereka tidak ada lagi."
 },
 {
   "id": 19712,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 16,
   "firman": "Beginilah firman TUHAN: Cegahlah suaramu dari menangis, dan matamu dari mencucurkan air mata, sebab untuk jerih payahmu ada ganjaran, demikianlah firman TUHAN; mereka akan kembali dari negeri musuh."
 },
 {
   "id": 19713,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 17,
   "firman": "Masih ada harapan untuk hari depanmu, demikianlah firman TUHAN: anak-anak akan kembali ke daerah mereka."
 },
 {
   "id": 19714,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 18,
   "firman": "Telah Kudengar sungguh-sungguh Efraim meratap: Engkau telah menghajar aku, dan aku telah menerima hajaran, seperti anak lembu yang tidak terlatih. Bawalah aku kembali, supaya aku berbalik, sebab Engkaulah TUHAN, Allahku."
 },
 {
   "id": 19715,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 19,
   "firman": "Sungguh, sesudah aku berbalik, aku menyesal, dan sesudah aku tahu akan diriku, aku menepuk pinggang sebagai tanda berkabung; aku merasa malu dan bernoda, sebab aku menanggung aib masa mudaku."
 },
 {
   "id": 19716,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 20,
   "firman": "Anak kesayangankah gerangan Efraim bagi-Ku atau anak kesukaan? Sebab setiap kali Aku menghardik dia, tak putus-putusnya Aku terkenang kepadanya; sebab itu hati-Ku terharu terhadap dia; tak dapat tidak Aku akan menyayanginya, demikianlah firman TUHAN."
 },
 {
   "id": 19717,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 21,
   "firman": "Dirikanlah bagimu rambu-rambu jalan, pasanglah bagimu tanda-tanda jalan; perhatikanlah jalan raya baik-baik, yakni jalan yang telah kautempuh! Kembalilah, hai anak dara Israel, kembalilah ke kota-kotamu ini!"
 },
 {
   "id": 19718,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 22,
   "firman": "Berapa lama lagi engkau mundur maju, hai anak perempuan yang tidak taat? Sebab TUHAN menciptakan sesuatu yang baru di negeri: perempuan merangkul laki-laki.\""
 },
 {
   "id": 19719,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 23,
   "firman": "Beginilah firman TUHAN semesta alam, Allah orang Israel: \"Orang akan mengucapkan perkataan ini lagi di tanah Yehuda dan di kota-kotanya, apabila Aku telah memulihkan keadaan mereka: TUHAN kiranya memberkati engkau, hai tempat kediaman kebenaran, hai gunung yang kudus!"
 },
 {
   "id": 19720,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 24,
   "firman": "Di sana akan duduk Yehuda beserta segala kotanya, petani-petani dan orang-orang yang mengembara dengan kawanan ternaknya."
 },
 {
   "id": 19721,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 25,
   "firman": "Sebab Aku akan membuat segar orang yang lelah, dan setiap orang yang merana akan Kubuat puas.\""
 },
 {
   "id": 19722,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 26,
   "firman": "Sebab itu aku bangun dan melihat; tidurku menyenangkan."
 },
 {
   "id": 19723,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 27,
   "firman": "\"Sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan melimpahi kaum Israel dan kaum Yehuda dengan benih manusia dan benih hewan."
 },
 {
   "id": 19724,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 28,
   "firman": "Maka seperti tadinya Aku berjaga-jaga atas mereka untuk mencabut dan merobohkan, untuk meruntuhkan dan membinasakan dan mencelakakan, demikianlah juga Aku akan berjaga-jaga atas mereka untuk membangun dan menanam, demikianlah firman TUHAN."
 },
 {
   "id": 19725,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 29,
   "firman": "Pada waktu itu orang tidak akan berkata lagi: Ayah-ayah makan buah mentah, dan gigi anak-anaknya menjadi ngilu,"
 },
 {
   "id": 19726,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 30,
   "firman": "melainkan: Setiap orang akan mati karena kesalahannya sendiri; setiap manusia yang makan buah mentah, giginya sendiri menjadi ngilu."
 },
 {
   "id": 19727,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 31,
   "firman": "Sesungguhnya, akan datang waktunya, demikianlah firman TUHAN, Aku akan mengadakan perjanjian baru dengan kaum Israel dan kaum Yehuda,"
 },
 {
   "id": 19728,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 32,
   "firman": "bukan seperti perjanjian yang telah Kuadakan dengan nenek moyang mereka pada waktu Aku memegang tangan mereka untuk membawa mereka keluar dari tanah Mesir; perjanjian-Ku itu telah mereka ingkari, meskipun Aku menjadi tuan yang berkuasa atas mereka, demikianlah firman TUHAN."
 },
 {
   "id": 19729,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 33,
   "firman": "Tetapi beginilah perjanjian yang Kuadakan dengan kaum Israel sesudah waktu itu, demikianlah firman TUHAN: Aku akan menaruh Taurat-Ku dalam batin mereka dan menuliskannya dalam hati mereka; maka Aku akan menjadi Allah mereka dan mereka akan menjadi umat-Ku."
 },
 {
   "id": 19730,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 34,
   "firman": "Dan tidak usah lagi orang mengajar sesamanya atau mengajar saudaranya dengan mengatakan: Kenallah TUHAN! Sebab mereka semua, besar kecil, akan mengenal Aku, demikianlah firman TUHAN, sebab Aku akan mengampuni kesalahan mereka dan tidak lagi mengingat dosa mereka.\""
 },
 {
   "id": 19731,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 35,
   "firman": "Beginilah firman TUHAN, yang memberi matahari untuk menerangi siang, yang menetapkan bulan dan bintang-bintang untuk menerangi malam, yang mengharu biru laut, sehingga gelombang-gelombangnya ribut, --TUHAN semesta alam nama-Nya:"
 },
 {
   "id": 19732,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 36,
   "firman": "\"Sesungguhnya, seperti ketetapan-ketetapan ini tidak akan beralih dari hadapan-Ku, demikianlah firman TUHAN, demikianlah keturunan Israel juga tidak akan berhenti menjadi bangsa di hadapan-Ku untuk sepanjang waktu."
 },
 {
   "id": 19733,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 37,
   "firman": "Beginilah firman TUHAN: Sesungguhnya, seperti langit di atas tidak terukur dan dasar-dasar bumi di bawah tidak terselidiki, demikianlah juga Aku tidak akan menolak segala keturunan Israel, karena segala apa yang dilakukan mereka, demikianlah firman TUHAN."
 },
 {
   "id": 19734,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 38,
   "firman": "Sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa kota itu akan dibangun kembali bagi TUHAN, dari menara Hananeel sampai Pintu Gerbang Sudut;"
 },
 {
   "id": 19735,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 39,
   "firman": "kemudian tali pengukur itu akan merentang terus sampai ke bukit Gareb, lalu membelok ke Goa."
 },
 {
   "id": 19736,
   "kitab": "Yer",
   "pasal": 31,
   "ayat": 40,
   "firman": "Dan segenap lembah itu, dengan mayat-mayat dan abu korbannya, dan segenap tanah di tepi sungai Kidron sampai ke sudut Pintu Gerbang Kuda ke arah timur, akan menjadi kudus bagi TUHAN. Orang tidak akan meruntuhkan dan merobohkan lagi di sana untuk selama-lamanya.\""
 },
 {
   "id": 19737,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia dalam tahun yang kesepuluh pemerintahan Zedekia, raja Yehuda; itulah tahun yang kedelapan belas pemerintahan Nebukadnezar."
 },
 {
   "id": 19738,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 2,
   "firman": "Pada waktu itu tentara raja Babel mengepung Yerusalem, dan nabi Yeremia ditahan di pelataran penjagaan yang ada di istana raja Yehuda."
 },
 {
   "id": 19739,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 3,
   "firman": "Sebab Zedekia, raja Yehuda, telah menahan dia di sana dengan tuduhan: \"Mengapa engkau bernubuat: Beginilah firman TUHAN: Sesungguhnya, Aku menyerahkan kota ini ke dalam tangan raja Babel, supaya ia mendudukinya;"
 },
 {
   "id": 19740,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 4,
   "firman": "Zedekia, raja Yehuda, tidak akan luput dari tangan orang Kasdim, melainkan pasti akan diserahkan ke dalam tangan raja Babel, sehingga ia berbicara dengan dia mulut sama mulut dan melihat dia mata sama mata;"
 },
 {
   "id": 19741,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 5,
   "firman": "Zedekia akan dibawanya ke Babel dan di sanalah ia akan tinggal, sampai Aku memperhatikannya, demikianlah firman TUHAN. Apabila kamu berperang melawan orang Kasdim itu, kamu tidak akan beruntung!\""
 },
 {
   "id": 19742,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 6,
   "firman": "Berkatalah Yeremia: \"Firman TUHAN datang kepadaku, bunyinya:"
 },
 {
   "id": 19743,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 7,
   "firman": "Sesungguhnya, Hanameel, anak Salum, pamanmu, akan datang kepadamu dengan usul: Belilah ladangku yang di Anatot itu, sebab engkaulah yang mempunyai hak tebus untuk membelinya."
 },
 {
   "id": 19744,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 8,
   "firman": "Kemudian, sesuai dengan firman TUHAN, datanglah Hanameel, anak pamanku, kepadaku di pelataran penjagaan, dan mengusulkan kepadaku: Belilah ladangku yang di Anatot di daerah Benyamin itu, sebab engkaulah yang mempunyai hak milik dan hak tebus; belilah itu! Maka tahulah aku, bahwa itu adalah firman TUHAN."
 },
 {
   "id": 19745,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 9,
   "firman": "Jadi aku membeli ladang yang di Anatot itu dari Hanameel, anak pamanku, dan menimbang uang baginya: tujuh belas syikal perak."
 },
 {
   "id": 19746,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 10,
   "firman": "Aku menulis surat pembelian, memeteraikannya, memanggil saksi-saksi dan menimbang perak itu dengan neraca."
 },
 {
   "id": 19747,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 11,
   "firman": "Lalu aku mengambil surat pembelian yang berisi syarat dan ketetapan itu, baik yang dimeteraikan maupun salinannya yang terbuka;"
 },
 {
   "id": 19748,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 12,
   "firman": "kemudian aku memberikan surat pembelian itu kepada Barukh bin Neria bin Mahseya di depan Hanameel, anak pamanku, di depan para saksi yang telah menandatangani surat pembelian itu, dan di depan semua orang Yehuda yang ada di pelataran penjagaan itu."
 },
 {
   "id": 19749,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 13,
   "firman": "Di depan mereka aku memerintahkan kepada Barukh, kataku:"
 },
 {
   "id": 19750,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 14,
   "firman": "Beginilah firman TUHAN semesta alam, Allah Israel: Ambillah surat-surat ini, baik surat pembelian yang dimeteraikan itu maupun salinan yang terbuka ini, taruhlah semuanya itu dalam bejana tanah, supaya dapat tahan lama."
 },
 {
   "id": 19751,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 15,
   "firman": "Sebab beginilah firman TUHAN semesta alam, Allah Israel: Rumah, ladang dan kebun anggur akan dibeli pula di negeri ini!"
 },
 {
   "id": 19752,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 16,
   "firman": "Sesudah kuberikan surat pembelian itu kepada Barukh bin Neria, berdoalah aku kepada TUHAN, kataku:"
 },
 {
   "id": 19753,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 17,
   "firman": "Ah, Tuhan ALLAH! Sesungguhnya, Engkaulah yang telah menjadikan langit dan bumi dengan kekuatan-Mu yang besar dan dengan lengan-Mu yang terentang. Tiada suatu apapun yang mustahil untuk-Mu!"
 },
 {
   "id": 19754,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 18,
   "firman": "Engkaulah yang menunjukkan kasih setia-Mu kepada beribu-ribu orang dan yang membalaskan kesalahan bapa kepada anak-anaknya yang datang kemudian. Ya Allah yang besar dan perkasa, nama-Mu adalah TUHAN semesta alam,"
 },
 {
   "id": 19755,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 19,
   "firman": "besar dalam rancangan-Mu dan agung dalam perbuatan-Mu; mata-Mu terbuka terhadap segala tingkah langkah anak-anak manusia dengan mengganjar setiap orang sesuai dengan tingkah langkahnya dan sesuai dengan buah perbuatannya;"
 },
 {
   "id": 19756,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 20,
   "firman": "Engkau yang memperlihatkan tanda-tanda dan mujizat-mujizat di tanah Mesir, sampai kepada waktu ini kepada Israel dan kepada umat manusia, sehingga Engkau membuat nama bagi-Mu, seperti yang ternyata pada waktu ini."
 },
 {
   "id": 19757,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 21,
   "firman": "Engkau telah membawa umat-Mu Israel keluar dari tanah Mesir dengan tanda-tanda dan mujizat-mujizat, dengan tangan yang kuat dan lengan yang teracung dan dengan kedahsyatan yang besar."
 },
 {
   "id": 19758,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 22,
   "firman": "Dan Engkau telah memberikan kepada mereka negeri ini, seperti yang telah Kaujanjikan dengan sumpah kepada nenek moyang mereka untuk memberikannya kepada mereka, suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 19759,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 23,
   "firman": "Kemudian mereka memasuki dan mendudukinya, tetapi mereka tidak mendengarkan suara-Mu dan tidak berkelakuan menurut Taurat-Mu; mereka tidak melakukan segala apa yang Kauperintahkan kepada mereka untuk dilakukan. Sebab itu Engkau melimpahkan kepada mereka segala malapetaka ini."
 },
 {
   "id": 19760,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 24,
   "firman": "Sesungguhnya, tembok-tembok pengepungan yang dipakai untuk merebut kota telah sampai mendekatinya; oleh karena pedang, kelaparan dan penyakit sampar maka kota itu telah diserahkan kepada orang-orang Kasdim yang memeranginya. Maka apa yang Kaufirmankan itu telah terjadi; sungguh, Engkau sendiri melihatnya."
 },
 {
   "id": 19761,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 25,
   "firman": "Namun Engkau, ya Tuhan ALLAH, telah berfirman kepadaku: Belilah ladang itu dengan perak dan panggillah saksi-saksi! --padahal kota itu telah diserahkan ke dalam tangan orang-orang Kasdim.\""
 },
 {
   "id": 19762,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 26,
   "firman": "Firman TUHAN datang kepada Yeremia, bunyinya:"
 },
 {
   "id": 19763,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 27,
   "firman": "\"Sesungguhnya, Akulah TUHAN, Allah segala makhluk; adakah sesuatu apapun yang mustahil untuk-Ku?"
 },
 {
   "id": 19764,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 28,
   "firman": "Sebab itu beginilah firman TUHAN: Sesungguhnya, Aku berikan kota ini ke dalam tangan orang-orang Kasdim dan ke dalam tangan Nebukadnezar, raja Babel, dan ia akan merebutnya."
 },
 {
   "id": 19765,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 29,
   "firman": "Orang-orang Kasdim yang memerangi kota ini akan datang membakarnya dan menghanguskannya serta dengan rumah-rumah yang di atas sotohnya orang membakar korban kepada Baal dan mempersembahkan korban curahan kepada allah lain untuk menimbulkan sakit hati-Ku."
 },
 {
   "id": 19766,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 30,
   "firman": "Sebab orang Israel dan orang Yehuda hanyalah melakukan yang jahat di mata-Ku sejak masa mudanya; sungguh, orang Israel hanya menimbulkan sakit hati-Ku dengan perbuatan tangan mereka, demikianlah firman TUHAN."
 },
 {
   "id": 19767,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 31,
   "firman": "Ya, kota ini telah membangkitkan murka dan kehangatan amarah-Ku mulai dari hari didirikannya sampai hari ini, sehingga Aku harus menyingkirkannya dari hadapan-Ku,"
 },
 {
   "id": 19768,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 32,
   "firman": "karena segala kejahatan yang dilakukan oleh orang Israel dan orang Yehuda untuk menimbulkan sakit hati-Ku, oleh mereka sendiri, raja-raja mereka, pemuka-pemuka mereka, imam-imam mereka, nabi-nabi mereka, orang Yehuda dan penduduk Yerusalem."
 },
 {
   "id": 19769,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 33,
   "firman": "Mereka membelakangi Aku dan tidak menghadap kepada-Ku, dan sekalipun Aku mengajar mereka, terus-menerus, tiada mereka mau mendengarkan atau menerima penghajaran."
 },
 {
   "id": 19770,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 34,
   "firman": "Mereka menempatkan dewa-dewa mereka yang menjijikkan di rumah yang di atasnya nama-Ku diserukan, untuk menajiskannya."
 },
 {
   "id": 19771,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 35,
   "firman": "Mereka mendirikan bukit-bukit pengorbanan untuk Baal di Lembah Ben-Hinom, untuk mempersembahkan anak-anak lelaki dan anak-anak perempuan mereka kepada Molokh sebagai korban dalam api, sekalipun Aku tidak pernah memerintahkannya kepada mereka dan sekalipun hal itu tidak pernah timbul dalam hati-Ku, yakni hal melakukan kejijikan ini, sehingga Yehuda tergelincir ke dalam dosa."
 },
 {
   "id": 19772,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 36,
   "firman": "Oleh sebab itu, beginilah firman TUHAN, Allah Israel, mengenai kota ini, yang engkau katakan telah diserahkan ke dalam tangan raja Babel karena pedang, kelaparan dan penyakit sampar:"
 },
 {
   "id": 19773,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 37,
   "firman": "Sesungguhnya, Aku mengumpulkan mereka dari segala negeri, ke mana Aku menceraiberaikan mereka karena murka-Ku, kehangatan amarah-Ku dan gusar-Ku yang besar, dan Aku akan mengembalikan mereka ke tempat ini dan akan membuat mereka diam dengan tenteram."
 },
 {
   "id": 19774,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 38,
   "firman": "Maka mereka akan menjadi umat-Ku dan Aku akan menjadi Allah mereka."
 },
 {
   "id": 19775,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 39,
   "firman": "Aku akan memberi mereka satu hati dan satu tingkah langkah, sehingga mereka takut kepada-Ku sepanjang masa untuk kebaikan mereka dan anak-anak mereka yang datang kemudian."
 },
 {
   "id": 19776,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 40,
   "firman": "Aku akan mengikat perjanjian kekal dengan mereka, bahwa Aku tidak akan membelakangi mereka, melainkan akan berbuat baik kepada mereka; Aku akan menaruh takut kepada-Ku ke dalam hati mereka, supaya mereka jangan menjauh dari pada-Ku."
 },
 {
   "id": 19777,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 41,
   "firman": "Aku akan bergirang karena mereka untuk berbuat baik kepada mereka dan Aku akan membuat mereka tumbuh di negeri ini dengan kesetiaan, dengan segenap hati-Ku dan dengan segenap jiwa-Ku."
 },
 {
   "id": 19778,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 42,
   "firman": "Sebab beginilah firman TUHAN: Seperti Aku mendatangkan kepada bangsa ini segenap malapetaka yang hebat ini, demikianlah Aku mendatangkan ke atas mereka keberuntungan yang Kujanjikan kepada mereka."
 },
 {
   "id": 19779,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 43,
   "firman": "Orang akan membeli ladang lagi di negeri ini yang kamu katakan: Itu adalah tempat tandus tanpa manusia dan hewan; itu telah diserahkan ke dalam tangan orang-orang Kasdim!"
 },
 {
   "id": 19780,
   "kitab": "Yer",
   "pasal": 32,
   "ayat": 44,
   "firman": "Orang akan membeli ladang-ladang dengan perak, menulis surat pembelian, memeteraikannya dan memanggil saksi-saksi di daerah Benyamin, di sekitar Yerusalem, di kota-kota Yehuda, di kota-kota Pegunungan, di kota-kota Daerah Bukit dan di kota-kota Tanah Negeb. Sebab Aku akan memulihkan keadaan mereka, demikianlah firman TUHAN.\""
 },
 {
   "id": 19781,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN untuk kedua kalinya kepada Yeremia, ketika ia masih terkurung di pelataran penjagaan itu, bunyinya:"
 },
 {
   "id": 19782,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN, yang telah menjadikan bumi dengan membentuknya dan menegakkannya--TUHAN ialah nama-Nya--:"
 },
 {
   "id": 19783,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 3,
   "firman": "Berserulah kepada-Ku, maka Aku akan menjawab engkau dan akan memberitahukan kepadamu hal-hal yang besar dan yang tidak terpahami, yakni hal-hal yang tidak kauketahui."
 },
 {
   "id": 19784,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN, Allah Israel, mengenai rumah-rumah di kota ini dan mengenai gedung-gedung istana raja Yehuda yang dirobohkan untuk dipakai terhadap tembok-tembok pengepungan dan pedang:"
 },
 {
   "id": 19785,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 5,
   "firman": "Orang akan masuk pertempuran melawan orang-orang Kasdim dan kota ini akan penuh dengan bangkai-bangkai manusia yang telah Kupukul mati karena murka-Ku dan kehangatan amarah-Ku, sebab Aku telah menyembunyikan wajah-Ku dari kota ini oleh karena segala kejahatan mereka."
 },
 {
   "id": 19786,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 6,
   "firman": "Sesungguhnya, Aku akan mendatangkan kepada mereka kesehatan dan kesembuhan, dan Aku akan menyembuhkan mereka dan akan menyingkapkan kepada mereka kesejahteraan dan keamanan yang berlimpah-limpah."
 },
 {
   "id": 19787,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 7,
   "firman": "Aku akan memulihkan keadaan Yehuda dan Israel dan akan membangun mereka seperti dahulu:"
 },
 {
   "id": 19788,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 8,
   "firman": "Aku akan mentahirkan mereka dari segala kesalahan yang mereka lakukan dengan berdosa terhadap Aku, dan Aku akan mengampuni segala kesalahan yang mereka lakukan dengan berdosa dan dengan memberontak terhadap Aku."
 },
 {
   "id": 19789,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 9,
   "firman": "Dan kota ini akan menjadi pokok kegirangan: ternama, terpuji dan terhormat bagi-Ku di depan segala bangsa di bumi yang telah mendengar tentang segala kebajikan yang Kulakukan kepadanya; mereka akan terkejut dan gemetar karena segala kebajikan dan segala kesejahteraan yang Kulakukan kepadanya."
 },
 {
   "id": 19790,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 10,
   "firman": "Beginilah firman TUHAN: Di tempat ini, yang kamu katakan telah menjadi reruntuhan tanpa manusia dan tanpa hewan, di kota-kota Yehuda dan di jalan-jalan Yerusalem yang sunyi sepi itu tanpa manusia, tanpa penduduk dan tanpa hewan,"
 },
 {
   "id": 19791,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 11,
   "firman": "akan terdengar lagi suara kegirangan dan suara sukacita, suara pengantin laki-laki dan suara pengantin perempuan, suara orang-orang yang mengatakan: Bersyukurlah kepada TUHAN semesta alam, sebab TUHAN itu baik, bahwasanya untuk selama-lamanya kasih setia-Nya!, sambil mempersembahkan korban syukur di rumah TUHAN. Sebab Aku akan memulihkan keadaan negeri ini seperti dahulu, firman TUHAN."
 },
 {
   "id": 19792,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 12,
   "firman": "Beginilah firman TUHAN semesta alam: Di daerah ini, yang sudah menjadi reruntuhan, tanpa manusia dan tanpa hewan, dan di segala kotanya akan ada lagi padang rumput bagi gembala-gembala yang membaringkan kambing domba di situ."
 },
 {
   "id": 19793,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 13,
   "firman": "Di kota-kota Pegunungan, di kota-kota Daerah Bukit, di kota-kota Tanah Negeb, di daerah Benyamin, di sekitar Yerusalem dan di kota-kota Yehuda, kambing domba akan lewat lagi dari bawah tangan orang yang menghitungnya, demikianlah firman TUHAN.\""
 },
 {
   "id": 19794,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 14,
   "firman": "\"Sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan menepati janji yang telah Kukatakan kepada kaum Israel dan kaum Yehuda."
 },
 {
   "id": 19795,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 15,
   "firman": "Pada waktu itu dan pada masa itu Aku akan menumbuhkan Tunas keadilan bagi Daud. Ia akan melaksanakan keadilan dan kebenaran di negeri."
 },
 {
   "id": 19796,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 16,
   "firman": "Pada waktu itu Yehuda akan dibebaskan, dan Yerusalem akan hidup dengan tenteram. Dan dengan nama inilah mereka akan dipanggil: TUHAN keadilan kita!"
 },
 {
   "id": 19797,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 17,
   "firman": "Sebab beginilah firman TUHAN: Keturunan Daud tidak akan terputus duduk di atas takhta kerajaan kaum Israel!"
 },
 {
   "id": 19798,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 18,
   "firman": "Dan keturunan imam-imam orang Lewi tidak akan terputus mempersembahkan korban bakaran di hadapan-Ku dan membakar korban sajian dan mengorbankan korban sembelihan sepanjang masa.\""
 },
 {
   "id": 19799,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 19,
   "firman": "Firman TUHAN datang kepada Yeremia, bunyinya:"
 },
 {
   "id": 19800,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 20,
   "firman": "\"Beginilah firman TUHAN: Jika kamu dapat mengingkari perjanjian-Ku dengan siang dan perjanjian-Ku dengan malam, sehingga siang dan malam tidak datang lagi pada waktunya,"
 },
 {
   "id": 19801,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 21,
   "firman": "maka juga perjanjian-Ku dengan hamba-Ku Daud dapat diingkari, sehingga ia tidak mempunyai anak lagi yang memerintah di atas takhtanya; begitu juga perjanjian-Ku dengan orang-orang Lewi, yakni imam-imam yang menjadi pelayan-Ku."
 },
 {
   "id": 19802,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 22,
   "firman": "Seperti tentara langit tidak terbilang dan seperti pasir laut tidak tertakar, demikianlah Aku akan membuat banyak keturunan hamba-Ku Daud dan orang-orang Lewi yang melayani Aku.\""
 },
 {
   "id": 19803,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 23,
   "firman": "Firman TUHAN datang kepada Yeremia, bunyinya:"
 },
 {
   "id": 19804,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 24,
   "firman": "\"Tidakkah kauperhatikan apa yang dikatakan orang-orang ini: Kedua kaum keluarga yang dipilih TUHAN itu telah ditolak-Nya? Dengan demikian mereka menghina umat-Ku, dianggapnya bukan suatu bangsa lagi."
 },
 {
   "id": 19805,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 25,
   "firman": "Beginilah firman TUHAN: Jika Aku tidak menetapkan perjanjian-Ku dengan siang dan malam dan aturan langit dan bumi,"
 },
 {
   "id": 19806,
   "kitab": "Yer",
   "pasal": 33,
   "ayat": 26,
   "firman": "maka juga Aku pasti akan menolak keturunan Yakub dan hamba-Ku Daud, sehingga berhenti mengangkat dari keturunannya orang-orang yang memerintah atas keturunan Abraham, Ishak dan Yakub. Sebab Aku akan memulihkan keadaan mereka dan menyayangi mereka.\""
 },
 {
   "id": 19807,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia, ketika Nebukadnezar, raja Babel, dan segala tentaranya, segala kerajaan di bumi yang dibawah pemerintahannya, dan segala bangsa berperang melawan Yerusalem dan segala kotanya:"
 },
 {
   "id": 19808,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN, Allah Israel: Pergilah berbicara kepada Zedekia, raja Yehuda, katakan kepadanya: Beginilah firman TUHAN: Sesungguhnya, Aku menyerahkan kota ini ke dalam tangan raja Babel, supaya dihanguskannya dengan api."
 },
 {
   "id": 19809,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 3,
   "firman": "Dan engkau sendiri tidak akan luput dari tangannya, melainkan akan pasti tertangkap dan diserahkan ke dalam tangannya; engkau akan melihat raja Babel mata berhadapan mata dan ia akan berbicara dengan engkau mulut berhadapan mulut. Kemudian engkau akan pergi ke Babel."
 },
 {
   "id": 19810,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 4,
   "firman": "Namun demikian, dengarlah firman TUHAN, hai Zedekia, raja Yehuda, beginilah firman TUHAN mengenai engkau: engkau tidak akan mati oleh pedang!"
 },
 {
   "id": 19811,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 5,
   "firman": "Engkau akan mati dengan damai. Dan sebagaimana dinyalakan api untuk menghormati bapa-bapa leluhurmu, raja-raja dahulu, yang hidup sebelum engkau, demikianlah orang akan menyalakan api untuk menghormati engkau, dan akan meratapi engkau dengan berkata: Aduhai, tuan! Sungguh, Akulah yang mengucapkan firman ini, demikianlah firman TUHAN.\""
 },
 {
   "id": 19812,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 6,
   "firman": "Nabi Yeremia menyampaikan segala perkataan ini kepada Zedekia, raja Yehuda, di Yerusalem,"
 },
 {
   "id": 19813,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 7,
   "firman": "ketika tentara raja Babel berperang melawan Yerusalem dan segala kota Yehuda yang masih tinggal, yaitu Lakhis dan Aseka, sebab kota-kota itulah yang masih tinggal di antara kota-kota Yehuda sebagai kota-kota yang berkubu."
 },
 {
   "id": 19814,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 8,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia, sesudah raja Zedekia mengikat perjanjian dengan segenap rakyat yang ada di Yerusalem untuk memaklumkan pembebasan,"
 },
 {
   "id": 19815,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 9,
   "firman": "supaya setiap orang melepaskan budaknya bangsa Ibrani, baik laki-laki maupun perempuan, sebagai orang merdeka, sehingga tidak ada seorangpun lagi yang memperbudak seorang Yehuda, saudaranya."
 },
 {
   "id": 19816,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 10,
   "firman": "Maka semua pemuka dan segenap rakyat yang ikut serta dalam perjanjian itu menyetujui, bahwa setiap orang akan melepaskan budaknya laki-laki dan budaknya perempuan sebagai orang merdeka, sehingga tidak ada lagi yang memperbudak mereka. Orang-orang itu menyetujuinya, lalu melepaskan mereka."
 },
 {
   "id": 19817,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 11,
   "firman": "Tetapi sesudah itu mereka berbalik pikiran, lalu mengambil kembali budak-budak lelaki dan perempuan yang telah mereka lepaskan sebagai orang merdeka itu dan menundukkan mereka menjadi budak laki-laki dan budak perempuan lagi."
 },
 {
   "id": 19818,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 12,
   "firman": "Lalu datanglah firman TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19819,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 13,
   "firman": "\"Beginilah firman TUHAN, Allah Israel: Aku sendiri telah mengikat perjanjian dengan nenek moyangmu pada waktu Aku membawa mereka keluar dari tanah Mesir, dari tempat perbudakan, isinya:"
 },
 {
   "id": 19820,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 14,
   "firman": "Pada akhir tujuh tahun haruslah kamu masing-masing melepaskan saudaranya bangsa Ibrani yang sudah menjual dirinya kepadamu; ia akan bekerja padamu enam tahun lamanya, kemudian haruslah engkau melepaskan dia sebagai orang merdeka. Tetapi nenek moyangmu tidak mendengarkan Aku dan tidak memperhatikan Aku."
 },
 {
   "id": 19821,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 15,
   "firman": "Hari ini kamu telah bertobat dan melakukan apa yang benar di mata-Ku karena setiap orang memaklumkan pembebasan kepada saudaranya, dan kamu telah mengikat perjanjian di hadapan-Ku di rumah yang atasnya nama-Ku diserukan."
 },
 {
   "id": 19822,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 16,
   "firman": "Tetapi kamu telah berbalik pikiran dan telah menajiskan nama-Ku; kamu masing-masing telah mengambil kembali budaknya laki-laki dan budaknya perempuan, yang telah kamu lepaskan sebagai orang merdeka menurut keinginannya, dan telah menundukkan mereka, supaya mereka menjadi budakmu laki-laki dan budakmu perempuan lagi."
 },
 {
   "id": 19823,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 17,
   "firman": "Sebab itu beginilah firman TUHAN: Kamu ini tidak mendengarkan Aku agar setiap orang memaklumkan pembebasan kepada sesamanya dan kepada saudaranya, maka sesungguhnya, Aku memaklumkan bagimu pembebasan, demikianlah firman TUHAN, untuk diserahkan kepada pedang, penyakit sampar dan kelaparan. Aku akan membuat kamu menjadi kengerian bagi segala kerajaan di bumi."
 },
 {
   "id": 19824,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 18,
   "firman": "Dan Aku akan menyerahkan orang-orang, yang melanggar perjanjian-Ku dan yang tidak menepati isi perjanjian yang mereka ikat di hadapan-Ku, dengan memotong anak lembu jantan menjadi dua untuk berjalan di antara belahan-belahannya;"
 },
 {
   "id": 19825,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 19,
   "firman": "pemuka-pemuka Yehuda, pemuka-pemuka Yerusalem, pegawai-pegawai istana, imam-imam dan segenap rakyat negeri yang telah berjalan di antara belahan-belahan anak lembu jantan itu,"
 },
 {
   "id": 19826,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 20,
   "firman": "mereka akan Kuserahkan ke dalam tangan musuh mereka dan ke dalam tangan orang-orang yang berusaha mencabut nyawa mereka, sehingga mayat mereka menjadi makanan burung-burung di udara dan binatang-binatang di bumi."
 },
 {
   "id": 19827,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 21,
   "firman": "Juga Zedekia, raja Yehuda, beserta para pemukanya akan Kuserahkan ke dalam tangan musuh mereka dan ke dalam tangan orang-orang yang berusaha mencabut nyawa mereka dan ke dalam tangan tentara raja Babel yang sekarang telah berangkat dari pada kamu."
 },
 {
   "id": 19828,
   "kitab": "Yer",
   "pasal": 34,
   "ayat": 22,
   "firman": "Sesungguhnya, demikianlah firman TUHAN, Aku memberi perintah dan membawa mereka kembali ke kota ini untuk memeranginya, merebutnya dan menghanguskannya dengan api. Aku akan membuat kota-kota Yehuda menjadi ketandusan tanpa penduduk.\""
 },
 {
   "id": 19829,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 1,
   "firman": "Firman yang datang dari TUHAN kepada Yeremia di zaman Yoyakim bin Yosia, raja Yehuda, bunyinya:"
 },
 {
   "id": 19830,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 2,
   "firman": "\"Pergilah kepada kaum orang Rekhab, bicaralah dengan mereka dan bawalah mereka ke rumah TUHAN, ke dalam salah satu kamar, kemudian berilah mereka minum anggur!\""
 },
 {
   "id": 19831,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 3,
   "firman": "Maka aku menjemput Yaazanya bin Yeremia bin Habazinya beserta saudara-saudaranya dan semua anaknya, pendeknya segenap kaum orang Rekhab."
 },
 {
   "id": 19832,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 4,
   "firman": "Aku membawa mereka ke rumah TUHAN, ke dalam kamar anak-anak Hanan bin Yigdalya, abdi Allah; itulah kamar yang di sebelah kamar para pembesar, di atas kamar Maaseya bin Salum, penjaga pintu."
 },
 {
   "id": 19833,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 5,
   "firman": "Di depan anggota-anggota kaum orang Rekhab itu aku meletakkan piala-piala penuh anggur dan cawan-cawan, lalu aku berkata kepada mereka: \"Silakan minum anggur!\""
 },
 {
   "id": 19834,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 6,
   "firman": "Tetapi mereka menjawab: \"Kami tidak minum anggur, sebab Yonadab bin Rekhab, bapa leluhur kami, telah memberi perintah kepada kami, katanya: Janganlah kamu atau anak-anakmupun minum anggur sampai selama-lamanya;"
 },
 {
   "id": 19835,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 7,
   "firman": "janganlah kamu mendirikan rumah, janganlah kamu menabur benih; janganlah kamu membuat atau mempunyai kebun anggur, melainkan haruslah kamu diam di kemah-kemah selama hidupmu, supaya lama kamu hidup di tanah, di mana kamu tinggal sebagai orang asing!"
 },
 {
   "id": 19836,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 8,
   "firman": "Kami mentaati suara Yonadab bin Rekhab, bapa leluhur kami dalam segala apa yang diperintahkannya kepada kami, agar kami tidak minum anggur selama hidup kami, yakni kami sendiri, isteri kami, anak-anak lelaki dan anak-anak perempuan kami;"
 },
 {
   "id": 19837,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 9,
   "firman": "agar kami tidak mendirikan rumah-rumah untuk kami diami, tidak mempunyai kebun anggur atau ladang serta benih,"
 },
 {
   "id": 19838,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 10,
   "firman": "melainkan kami diam di kemah-kemah dan taat melakukan tepat seperti yang diperintahkan kepada kami oleh Yonadab, bapa leluhur kami."
 },
 {
   "id": 19839,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 11,
   "firman": "Tetapi ketika Nebukadnezar, raja Babel, bergerak maju melawan negeri ini, maka kami berkata: Marilah kita mengungsi ke Yerusalem, karena tentara orang Kasdim dan tentara orang Aram itu! Demikianlah kami diam di Yerusalem.\""
 },
 {
   "id": 19840,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 12,
   "firman": "Pada waktu itu datanglah firman TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19841,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 13,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel: Pergilah dan katakanlah kepada orang Yehuda dan kepada penduduk Yerusalem: Tidakkah kamu mau menerima penghajaran, yaitu mendengarkan perkataan-perkataan-Ku?"
 },
 {
   "id": 19842,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 14,
   "firman": "Memang perintah Yonadab bin Rekhab itu masih ditepati; ia telah memerintahkan kepada keturunannya, supaya mereka jangan minum anggur, dan sampai sekarang ini mereka tidak meminumnya, sebab mereka mendengarkan perintah bapa leluhur mereka. Aku sendiri telah berbicara kepada kamu, terus-menerus, tetapi kamu tidak mendengarkan Aku."
 },
 {
   "id": 19843,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 15,
   "firman": "Aku telah mengutus kepadamu segala hamba-Ku, yakni para nabi, terus-menerus, mengatakan: Kembalilah kamu masing-masing dari tingkah langkahmu yang jahat itu, perbaikilah perbuatanmu, janganlah mengikuti allah lain untuk beribadah kepada mereka, maka kamu akan tetap diam di tanah yang telah Kuberikan kepadamu dan kepada nenek moyangmu. Tetapi kamu tidak mau memperhatikannya dan kamu tidak mau mendengarkan Aku."
 },
 {
   "id": 19844,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 16,
   "firman": "Sungguh, keturunan Yonadab bin Rekhab menepati perintah yang diberikan bapa leluhurnya kepada mereka, tetapi bangsa ini tidak mau mendengarkan Aku!"
 },
 {
   "id": 19845,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 17,
   "firman": "Sebab itu beginilah firman TUHAN, Allah semesta alam, Allah Israel: Sesungguhnya, Aku mendatangkan kepada Yehuda dan kepada segenap penduduk Yerusalem segala malapetaka yang Kuancamkan atas mereka; karena Aku telah berbicara kepada mereka, tetapi mereka tidak mau mendengarkan, dan Aku telah berseru kepada mereka, tetapi mereka tidak mau menjawab.\""
 },
 {
   "id": 19846,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 18,
   "firman": "Tetapi berkatalah Yeremia kepada kaum orang Rekhab: \"Beginilah firman TUHAN semesta alam, Allah Israel: Oleh karena kamu telah mendengarkan perintah Yonadab, bapa leluhurmu, telah berpegang pada segala perintahnya dan telah melakukan tepat seperti yang diperintahkannya kepadamu,"
 },
 {
   "id": 19847,
   "kitab": "Yer",
   "pasal": 35,
   "ayat": 19,
   "firman": "maka beginilah firman TUHAN semesta alam, Allah Israel: Keturunan Yonadab bin Rekhab takkan terputus melayani Aku sepanjang masa.\""
 },
 {
   "id": 19848,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 1,
   "firman": "Dalam tahun yang keempat pemerintahan Yoyakim bin Yosia, raja Yehuda, datanglah firman ini dari TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19849,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 2,
   "firman": "\"Ambillah kitab gulungan dan tulislah di dalamnya segala perkataan yang telah Kufirmankan kepadamu mengenai Israel, Yehuda dan segala bangsa, dari sejak Aku berbicara kepadamu, yakni dari sejak zaman Yosia, sampai waktu ini."
 },
 {
   "id": 19850,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 3,
   "firman": "Mungkin apabila kaum Yehuda mendengar tentang segala malapetaka yang Aku rancangkan hendak mendatangkannya kepada mereka, maka mereka masing-masing akan bertobat dari tingkah langkahnya yang jahat itu, sehingga Aku mengampuni kesalahan dan dosa mereka.\""
 },
 {
   "id": 19851,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 4,
   "firman": "Jadi Yeremia memanggil Barukh bin Neria, lalu Barukh menuliskan dalam kitab gulungan itu langsung dari mulut Yeremia segala perkataan yang telah difirmankan TUHAN kepadanya."
 },
 {
   "id": 19852,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 5,
   "firman": "Pada suatu kali Yeremia memberi perintah kepada Barukh: \"Aku ini berhalangan, tidak dapat pergi ke rumah TUHAN."
 },
 {
   "id": 19853,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 6,
   "firman": "Jadi pada hari puasa engkaulah yang pergi membacakan perkataan-perkataan TUHAN kepada orang banyak di rumah TUHAN dari gulungan yang kautuliskan langsung dari mulutku itu; kepada segenap orang Yehuda yang datang dari kota-kotanya haruslah kaubacakannya juga."
 },
 {
   "id": 19854,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 7,
   "firman": "Mungkin permohonan mereka sampai di hadapan TUHAN dan mereka masing-masing bertobat dari tingkah langkahnya yang jahat itu, sebab besar murka dan kehangatan amarah yang diancamkan TUHAN kepada bangsa ini.\""
 },
 {
   "id": 19855,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 8,
   "firman": "Lalu Barukh bin Neria melakukan tepat seperti yang diperintahkan kepadanya oleh nabi Yeremia untuk membacakan perkataan-perkataan TUHAN dari kitab itu di rumah TUHAN. --"
 },
 {
   "id": 19856,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 9,
   "firman": "Adapun dalam tahun yang kelima pemerintahan Yoyakim bin Yosia, raja Yehuda, dalam bulan yang kesembilan, orang telah memaklumkan puasa di hadapan TUHAN bagi segenap rakyat di Yerusalem dan bagi segenap rakyat yang telah datang dari kota-kota Yehuda ke Yerusalem. --"
 },
 {
   "id": 19857,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 10,
   "firman": "Maka Barukh membacakan kepada segenap rakyat perkataan Yeremia dari kitab itu, di rumah TUHAN, di kamar Gemarya anak panitera Safan, di pelataran atas di muka pintu gerbang baru dari rumah TUHAN."
 },
 {
   "id": 19858,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 11,
   "firman": "Ketika Mikhaya bin Gemarya bin Safan mendengar segala firman TUHAN dari kitab itu,"
 },
 {
   "id": 19859,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 12,
   "firman": "turunlah ia ke istana raja, ke kamar panitera. Di sana tampak duduk semua pemuka, yakni panitera Elisama, Delaya bin Semaya, Elnatan bin Akhbor, Gemarya bin Safan, Zedekia bin Hananya dan semua pemuka lain."
 },
 {
   "id": 19860,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 13,
   "firman": "Lalu Mikhaya memberitahukan kepada mereka segala firman yang telah didengarnya, ketika Barukh membacakan kitab itu kepada orang banyak."
 },
 {
   "id": 19861,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 14,
   "firman": "Kemudian para pemimpin itu menyuruh Yehudi bin Netanya bin Selemya bin Kusyi kepada Barukh mengatakan: \"Bawalah gulungan yang telah kaubacakan kepada orang banyak itu dan datanglah ke mari!\" Maka Barukh bin Neria membawa gulungan itu dan datang kepada mereka."
 },
 {
   "id": 19862,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 15,
   "firman": "Berkatalah mereka kepadanya: \"Silakan duduk dan bacakan itu kepada kami!\" Lalu Barukh membacakannya kepada mereka."
 },
 {
   "id": 19863,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 16,
   "firman": "Setelah mereka mendengar segala perkataan itu, maka terkejutlah mereka dan berkata seorang kepada yang lain: \"Kita harus dengan segera memberitahukan segala perkataan ini kepada raja!\""
 },
 {
   "id": 19864,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 17,
   "firman": "Bertanyalah mereka kepada Barukh, katanya: \"Beritahukanlah kepada kami, bagaimana caranya engkau menuliskan segala perkataan ini!\""
 },
 {
   "id": 19865,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 18,
   "firman": "Jawab Barukh kepada mereka: \"Segala perkataan ini langsung dari mulut Yeremia kepadaku, dan aku menuliskannya dengan tinta dalam kitab.\""
 },
 {
   "id": 19866,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 19,
   "firman": "Lalu berkatalah para pemuka itu kepada Barukh: \"Pergilah, sembunyikanlah dirimu bersama Yeremia! Janganlah ada orang yang mengetahui di mana tempatmu!\""
 },
 {
   "id": 19867,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 20,
   "firman": "Kemudian pergilah mereka menghadap raja di pelataran, sesudah mereka menyimpan gulungan itu di kamar panitera Elisama. Mereka memberitahukan segala perkataan ini kepada raja."
 },
 {
   "id": 19868,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 21,
   "firman": "Raja menyuruh Yehudi mengambil gulungan itu, lalu ia mengambilnya dari kamar panitera Elisama itu. Yehudi membacakannya kepada raja dan semua pemuka yang berdiri dekat raja."
 },
 {
   "id": 19869,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 22,
   "firman": "Waktu itu adalah bulan yang kesembilan dan raja sedang duduk di balai musim dingin, sementara di depannya api menyala di perapian."
 },
 {
   "id": 19870,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 23,
   "firman": "Setiap kali apabila Yehudi selesai membacakan tiga empat lajur, maka raja mengoyak-ngoyaknya dengan pisau raut, lalu dilemparkan ke dalam api yang di perapian itu, sampai seluruh gulungan itu habis dimakan api yang di perapian itu."
 },
 {
   "id": 19871,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 24,
   "firman": "Baik raja maupun para pegawainya, yang mendengarkan segala perkataan ini, seorangpun tidak terkejut dan tidak mengoyakkan pakaiannya."
 },
 {
   "id": 19872,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 25,
   "firman": "Elnatan, Delaya dan Gemarya memang mendesak kepada raja, supaya jangan membakar gulungan itu, tetapi raja tidak mendengarkan mereka."
 },
 {
   "id": 19873,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 26,
   "firman": "Bahkan raja memerintahkan pangeran Yerahmeel, Seraya bin Azriel dan Selemya bin Abdeel untuk menangkap juru tulis Barukh dan nabi Yeremia, tetapi TUHAN menyembunyikan mereka."
 },
 {
   "id": 19874,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 27,
   "firman": "Sesudah raja membakar gulungan berisi perkataan-perkataan yang dituliskan oleh Barukh langsung dari mulut Yeremia itu, maka datanglah firman TUHAN kepada Yeremia, bunyinya:"
 },
 {
   "id": 19875,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 28,
   "firman": "\"Ambil pulalah gulungan lain, tuliskanlah di dalamnya segala perkataan yang semula ada di dalam gulungan yang pertama yang dibakar oleh Yoyakim, raja Yehuda."
 },
 {
   "id": 19876,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 29,
   "firman": "Mengenai Yoyakim, raja Yehuda, haruslah kaukatakan: Beginilah firman TUHAN: Engkau telah membakar gulungan ini dengan berkata: Mengapakah engkau menulis di dalamnya, bahwa raja Babel pasti akan datang untuk memusnahkan negeri ini dan untuk melenyapkan dari dalamnya manusia dan hewan?"
 },
 {
   "id": 19877,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 30,
   "firman": "Sebab itu beginilah firman TUHAN tentang Yoyakim, raja Yehuda: Ia tidak akan mempunyai keturunan yang akan duduk di atas takhta Daud, dan mayatnya akan tercampak, sehingga kena panas di waktu siang dan kena dingin di waktu malam."
 },
 {
   "id": 19878,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 31,
   "firman": "Aku akan menghukum dia, keturunannya dan hamba-hambanya karena kesalahan mereka; Aku akan mendatangkan atas mereka, atas segala penduduk Yerusalem dan atas orang Yehuda segenap malapetaka yang Kuancamkan kepada mereka, yang mereka tidak mau mendengarnya.\""
 },
 {
   "id": 19879,
   "kitab": "Yer",
   "pasal": 36,
   "ayat": 32,
   "firman": "Maka Yeremia mengambil gulungan lain dan memberikannya kepada juru tulis Barukh bin Neria yang menuliskan di dalamnya langsung dari mulut Yeremia segala perkataan yang ada di dalam kitab yang telah dibakar Yoyakim, raja Yehuda dalam api itu. Lagipula masih ditambahi dengan banyak perkataan seperti itu."
 },
 {
   "id": 19880,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 1,
   "firman": "Zedekia bin Yosia menjadi raja menggantikan Konya bin Yoyakim; Nebukadnezar, raja Babel, telah mengangkat dia menjadi raja atas negeri Yehuda."
 },
 {
   "id": 19881,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 2,
   "firman": "Tetapi baik ia, baik pegawai-pegawainya maupun rakyat negeri itu, tidak mendengarkan firman yang disampaikan TUHAN dengan perantaraan nabi Yeremia."
 },
 {
   "id": 19882,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 3,
   "firman": "Pada suatu kali raja Zedekia menyuruh Yukhal bin Selemya dan imam Zefanya bin Maaseya kepada Yeremia untuk meminta: \"Berdoalah hendaknya untuk kami kepada TUHAN, Allah kita!\""
 },
 {
   "id": 19883,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 4,
   "firman": "Adapun pada waktu itu Yeremia masih bebas pergi datang di tengah-tengah rakyat; ia belum dimasukkan orang ke dalam penjara."
 },
 {
   "id": 19884,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 5,
   "firman": "Adapun tentara Firaun telah berangkat keluar dari Mesir; mendengar kabar itu maka orang-orang Kasdim yang mengepung Yerusalem angkat kaki dari Yerusalem."
 },
 {
   "id": 19885,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 6,
   "firman": "Lalu datanglah firman TUHAN kepada nabi Yeremia, bunyinya:"
 },
 {
   "id": 19886,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 7,
   "firman": "\"Beginilah firman TUHAN, Allah Israel. Kepada raja Yehuda, yang menyuruh kamu kepada-Ku untuk meminta petunjuk, harus kamu katakan begini: Lihat, tentara Firaun yang telah berangkat keluar untuk membantu kamu akan kembali ke negerinya, ke Mesir."
 },
 {
   "id": 19887,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 8,
   "firman": "Tetapi orang-orang Kasdim akan datang kembali memerangi kota ini, merebutnya dan menghanguskannya dengan api."
 },
 {
   "id": 19888,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 9,
   "firman": "Beginilah firman TUHAN: Janganlah kamu membohongi dirimu sendiri dengan mengatakan: Orang-orang Kasdim itu telah pergi untuk selamanya dari pada kita! Padahal mereka tidak pergi untuk selamanya!"
 },
 {
   "id": 19889,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 10,
   "firman": "Dan seandainya kamu memukul kalah segenap tentara orang Kasdim yang telah memerangi kamu itu, sehingga di antara mereka hanya tinggal orang-orang yang luka parah, masing-masing di kemahnya mereka akan bangun dan menghanguskan kota ini dengan api.\""
 },
 {
   "id": 19890,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 11,
   "firman": "Ketika tentara orang Kasdim itu telah angkat kaki dari Yerusalem oleh karena takut kepada tentara Firaun,"
 },
 {
   "id": 19891,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 12,
   "firman": "maka keluarlah Yeremia dari Yerusalem untuk pergi ke daerah Benyamin dengan maksud mengurus di sana pembagian warisan di antara kaum keluarga."
 },
 {
   "id": 19892,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 13,
   "firman": "Tetapi ketika ia sampai ke pintu gerbang Benyamin, maka di sana ada seorang kepala jaga yang bernama Yeria bin Selemya bin Hananya; ia menangkap nabi Yeremia sambil berteriak: \"Engkau mau menyeberang kepada orang Kasdim!\""
 },
 {
   "id": 19893,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 14,
   "firman": "Dan sekalipun Yeremia menjawab: \"Itu bohong, aku tidak hendak menyeberang kepada orang Kasdim!\", tetapi Yeria tidak mendengarkan, lalu ia menangkap Yeremia dan membawanya menghadap para pemuka."
 },
 {
   "id": 19894,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 15,
   "firman": "Para pemuka ini menjadi marah kepada Yeremia; mereka memukul dia dan memasukkannya ke dalam rumah tahanan, rumah panitera Yonatan itu; adapun rumah itu telah dibuat mereka menjadi penjara."
 },
 {
   "id": 19895,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 16,
   "firman": "Demikianlah halnya Yeremia masuk ke dalam ruang cadangan air di bawah tanah itu. Dan lama Yeremia tinggal di sana."
 },
 {
   "id": 19896,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 17,
   "firman": "Pada suatu kali raja Zedekia menyuruh orang mengambil dia. Lalu dengan diam-diam bertanyalah raja di istananya kepadanya: \"Adakah datang firman dari TUHAN?\" Jawab Yeremia: \"Ada!\" Lagi katanya: \"Bunyinya: Engkau akan diserahkan ke dalam tangan raja Babel!\""
 },
 {
   "id": 19897,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 18,
   "firman": "Kemudian berkatalah Yeremia kepada raja Zedekia: \"Apakah dosa yang kuperbuat kepadamu, kepada pegawai-pegawaimu dan kepada bangsa ini, sehingga kamu memasukkan aku ke dalam penjara?"
 },
 {
   "id": 19898,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 19,
   "firman": "Di manakah gerangan para nabimu yang telah bernubuat kepadamu, bahwa raja Babel tidak akan datang menyerang kamu dan negeri ini?"
 },
 {
   "id": 19899,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 20,
   "firman": "Sekarang, dengarkanlah, hai tuanku raja! Biarlah permohonanku sampai di hadapanmu: janganlah kembalikan aku ke rumah panitera Yonatan, nanti aku mati di sana.\""
 },
 {
   "id": 19900,
   "kitab": "Yer",
   "pasal": 37,
   "ayat": 21,
   "firman": "Raja Zedekia memberi perintah, lalu orang menahan Yeremia di pelataran penjagaan dan memberikan setiap hari kepadanya sepotong roti dari jalan tukang roti, sampai pada waktu segala roti habis di kota itu. Demikianlah Yeremia tinggal di pelataran penjagaan itu."
 },
 {
   "id": 19901,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 1,
   "firman": "Tetapi Sefaca bin Matan, Gedalya bin Pasyhur, Yukhal bin Selemya dan Pasyhur bin Malkia mendengar perkataan yang tidak henti-henti diucapkan oleh Yeremia kepada segenap orang banyak itu:"
 },
 {
   "id": 19902,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN: Siapa yang tinggal di kota ini akan mati karena pedang, karena kelaparan dan karena penyakit sampar; tetapi siapa yang keluar dari sini mendapatkan orang Kasdim, ia akan tetap hidup; nyawanya akan menjadi jarahan baginya dan ia tetap hidup."
 },
 {
   "id": 19903,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 3,
   "firman": "Beginilah firman TUHAN: Kota ini akan pasti diserahkan ke dalam tangan tentara raja Babel yang akan merebutnya.\""
 },
 {
   "id": 19904,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 4,
   "firman": "Maka berkatalah para pemuka itu kepada raja: \"Baiklah orang ini dihukum mati! Sebab sebenarnya dengan mengatakan hal-hal seperti itu maka ia melemahkan semangat prajurit-prajurit yang masih tinggal di kota ini dan semangat segenap rakyat. Sungguh, orang ini tidak mengusahakan kesejahteraan untuk bangsa ini, melainkan kemalangan.\""
 },
 {
   "id": 19905,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 5,
   "firman": "Raja Zedekia menjawab: \"Baiklah, ia ada dalam kuasamu! Sebab raja tidak dapat berbuat apa-apa menentang kamu!\""
 },
 {
   "id": 19906,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 6,
   "firman": "Maka mereka mengambil Yeremia dan memasukkannya ke dalam perigi milik pangeran Malkia yang ada di pelataran penjagaan itu; mereka menurunkan Yeremia dengan tali. Di perigi itu tidak ada air, hanya lumpur, lalu terperosoklah Yeremia ke dalam lumpur itu."
 },
 {
   "id": 19907,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 7,
   "firman": "Tetapi ketika didengar Ebed-Melekh, orang Etiopia itu--ia seorang sida-sida yang tinggal di istana raja--bahwa Yeremia telah dimasukkan ke dalam perigi--pada waktu itu raja sedang duduk di pintu gerbang Benyamin--"
 },
 {
   "id": 19908,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 8,
   "firman": "maka keluarlah Ebed-Melekh dari istana raja itu, lalu berkata kepada raja:"
 },
 {
   "id": 19909,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 9,
   "firman": "\"Ya tuanku raja, perbuatan orang-orang ini jahat dalam segala apa yang mereka lakukan terhadap nabi Yeremia, yakni memasukkan dia ke dalam perigi; ia akan mati kelaparan di tempat itu! Sebab tidak ada lagi roti di kota.\""
 },
 {
   "id": 19910,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 10,
   "firman": "Lalu raja memberi perintah kepada Ebed-Melekh, orang Etiopia itu, katanya: \"Bawalah tiga orang dari sini dan angkatlah nabi Yeremia dari perigi itu sebelum ia mati!\""
 },
 {
   "id": 19911,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 11,
   "firman": "Ebed-Melekh membawa orang-orang itu dan masuk ke istana raja, ke gudang pakaian di tempat perbendaharaan; dari sana ia mengambil pakaian yang buruk-buruk dan pakaian yang robek-robek, lalu menurunkannya dengan tali kepada Yeremia di perigi itu."
 },
 {
   "id": 19912,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 12,
   "firman": "Berserulah Ebed-Melekh, orang Etiopia itu, kepada Yeremia: \"Taruhlah pakaian yang buruk-buruk dan robek-robek itu di bawah ketiakmu sebagai ganjal tali!\" Yeremiapun berbuat demikian."
 },
 {
   "id": 19913,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 13,
   "firman": "Kemudian mereka menarik dan mengangkat Yeremia dengan tali dari perigi itu. Demikianlah Yeremia tinggal di pelataran penjagaan itu."
 },
 {
   "id": 19914,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 14,
   "firman": "Raja Zedekia menyuruh orang membawa nabi Yeremia kepadanya di pintu yang ketiga pada rumah TUHAN. Berkatalah raja kepada Yeremia: \"Aku mau menanyakan sesuatu kepadamu; janganlah sembunyikan apa-apa kepadaku!\""
 },
 {
   "id": 19915,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 15,
   "firman": "Jawab Yeremia kepada Zedekia: \"Apabila aku memberitahukannya kepadamu, tentulah engkau akan membunuh aku, bukan? Dan apabila aku memberi nasihat kepadamu, engkau tidak juga akan mendengarkan aku!\""
 },
 {
   "id": 19916,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 16,
   "firman": "Lalu bersumpahlah raja Zedekia dengan diam-diam kepada Yeremia, katanya: \"Demi TUHAN yang hidup yang telah memberi nyawa ini kepada kita, aku tidak akan membunuh engkau dan tidak akan menyerahkan engkau ke dalam tangan orang-orang yang berusaha mencabut nyawamu itu!\""
 },
 {
   "id": 19917,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 17,
   "firman": "Sesudah itu berkatalah Yeremia kepada Zedekia: \"Beginilah firman TUHAN, Allah semesta alam, Allah Israel: Jika engkau keluar menyerahkan diri kepada para perwira raja Babel, maka nyawamu akan terpelihara, dan kota ini tidak akan dihanguskan dengan api; engkau dengan keluargamu akan hidup."
 },
 {
   "id": 19918,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 18,
   "firman": "Tetapi jika engkau tidak menyerahkan diri kepada para perwira raja Babel, maka kota ini akan diserahkan ke dalam tangan orang-orang Kasdim yang akan menghanguskannya dengan api; dan engkau sendiri tidak akan luput dari tangan mereka.\""
 },
 {
   "id": 19919,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 19,
   "firman": "Kemudian berkatalah raja Zedekia kepada Yeremia: \"Aku takut kepada orang-orang Yehuda yang menyeberang kepada orang Kasdim itu; nanti aku diserahkan ke dalam tangan mereka, sehingga mereka mempermainkan aku.\""
 },
 {
   "id": 19920,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 20,
   "firman": "Yeremia menjawab: \"Hal itu tidak akan terjadi! Dengarkanlah suara TUHAN dalam hal apa yang kukatakan kepadamu, maka keadaanmu akan baik dan nyawamu akan terpelihara."
 },
 {
   "id": 19921,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 21,
   "firman": "Tetapi jika engkau enggan menyerahkan diri, maka inilah firman yang dinyatakan TUHAN kepadaku:"
 },
 {
   "id": 19922,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 22,
   "firman": "Sungguh, semua perempuan yang masih tinggal di istana raja Yehuda digiring ke luar ke hadapan para perwira raja Babel sambil berseru: Engkau diperdayakan, dikalahkan oleh sahabat-sahabatmu. Tetapi baru saja kakimu terperosok ke dalam lumpur, mereka sudah berpaling pulang."
 },
 {
   "id": 19923,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 23,
   "firman": "Semua isterimu dan anak-anakmu akan digiring ke luar ke hadapan orang-orang Kasdim itu. Dan engkau sendiri tidak akan terluput dari tangan mereka, tetapi engkau akan tertangkap oleh raja Babel. Dan kota ini akan dihanguskan dengan api.\""
 },
 {
   "id": 19924,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 24,
   "firman": "Lalu berkatalah Zedekia kepada Yeremia: \"Janganlah ada orang yang mengetahui tentang pembicaraan ini, supaya engkau jangan mati."
 },
 {
   "id": 19925,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 25,
   "firman": "Apabila para pemuka mendengar, bahwa aku telah berbicara dengan engkau, lalu mereka datang meminta kepadamu: Beritahukanlah kepada kami apa yang telah kaukatakan kepada raja dan apa yang telah dikatakan raja kepadamu; janganlah sembunyikan kepada kami, supaya engkau jangan kami bunuh!,"
 },
 {
   "id": 19926,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 26,
   "firman": "maka haruslah kaukatakan kepada mereka: Aku menyampaikan permohonanku ke hadapan raja, supaya aku jangan dikembalikannya ke rumah Yonatan untuk mati di sana.\""
 },
 {
   "id": 19927,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 27,
   "firman": "Memang semua pemuka itu datang bertanya kepada Yeremia, tetapi ia memberi jawab kepada mereka tepat seperti segala yang diperintahkan raja. Maka mereka membiarkan dia, sebab sesuatupun dari pembicaraan itu tidak ada yang diketahui siapapun."
 },
 {
   "id": 19928,
   "kitab": "Yer",
   "pasal": 38,
   "ayat": 28,
   "firman": "Demikianlah Yeremia tinggal di pelataran penjagaan itu sampai kepada hari Yerusalem direbut."
 },
 {
   "id": 19929,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 1,
   "firman": "Ketika Yerusalem direbut--dalam tahun yang kesembilan pemerintahan Zedekia, raja Yehuda, dalam bulan yang kesepuluh, telah datang Nebukadnezar, raja Babel, beserta segenap tentaranya untuk mengepung Yerusalem;"
 },
 {
   "id": 19930,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 2,
   "firman": "dalam tahun yang kesebelas pemerintahan Zedekia, dalam bulan yang keempat, pada tanggal sembilan bulan itu, terbelahlah tembok kota itu--"
 },
 {
   "id": 19931,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 3,
   "firman": "maka datanglah para perwira raja Babel itu, lalu mengambil tempat di pintu gerbang tengah, mereka itu ialah Nergal-Sarezer, pembesar dari Sin-Magir, panglima, dan Nebusyazban, kepala istana, dan para perwira lainnya dari raja Babel."
 },
 {
   "id": 19932,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 4,
   "firman": "Melihat mereka semuanya maka Zedekia, raja Yehuda, dengan semua tentara melarikan diri, meninggalkan kota itu pada waktu malam dengan mengambil jalan taman raja, dengan melalui pintu gerbang antara kedua tembok; kemudian mereka berjalan menuju Araba-Yordan."
 },
 {
   "id": 19933,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 5,
   "firman": "Tetapi tentara Kasdim itu mengejar mereka dan menyusul Zedekia di dataran Yerikho; mereka menangkap dia dan membawa dia ke Ribla di tanah Hamat, kepada Nebukadnezar, raja Babel, yang menjatuhkan hukuman atas dia."
 },
 {
   "id": 19934,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 6,
   "firman": "Raja Babel menyuruh menyembelih anak-anak Zedekia di depan matanya di Ribla; juga semua pembesar Yehuda disembelih oleh raja Babel."
 },
 {
   "id": 19935,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 7,
   "firman": "Kemudian mata Zedekia dibutakannya, lalu ia dibelenggu dengan rantai tembaga untuk dibawa ke Babel."
 },
 {
   "id": 19936,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 8,
   "firman": "Orang-orang Kasdim membakar istana raja dan perumahan rakyat dengan api, lalu mereka merobohkan tembok-tembok Yerusalem."
 },
 {
   "id": 19937,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 9,
   "firman": "Kemudian Nebuzaradan, kepala pasukan pengawal, mengangkut ke dalam pembuangan ke Babel sisa-sisa rakyat yang masih tinggal di kota itu dan para pembelot yang menyeberang ke pihaknya dan sisa-sisa para pekerja tangan."
 },
 {
   "id": 19938,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 10,
   "firman": "Tetapi sebagian dari rakyat, yakni orang-orang miskin yang tidak mempunyai apa-apa, ditinggalkan di tanah Yehuda oleh Nebuzaradan, kepala pasukan pengawal. Pada waktu itu juga diberikannyalah kebun-kebun anggur dan ladang-ladang kepada mereka."
 },
 {
   "id": 19939,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 11,
   "firman": "Mengenai Yeremia, Nebukadnezar, raja Babel, telah memberi perintah dengan perantaraan Nebuzaradan, kepala pasukan pengawal, bunyinya:"
 },
 {
   "id": 19940,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 12,
   "firman": "\"Bawalah dan perhatikanlah dia, janganlah apa-apakan dia, melainkan haruslah kaulakukan kepadanya sesuai dengan permintaannya kepadamu!\""
 },
 {
   "id": 19941,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 13,
   "firman": "Maka Nebuzaradan, kepala pasukan pengawal, beserta Nebusyazban, kepala istana, dan Nergal-Sarezer, panglima, dan semua perwira tinggi raja Babel, mengutus orang--"
 },
 {
   "id": 19942,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 14,
   "firman": "mereka menyuruh mengambil Yeremia dari pelataran penjagaan, lalu menyerahkannya kepada Gedalya bin Ahikam bin Safan untuk membebaskannya, supaya pulang ke rumah. Demikianlah Yeremia tinggal di tengah-tengah rakyat."
 },
 {
   "id": 19943,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 15,
   "firman": "Selagi Yeremia masih terkurung di pelataran penjagaan, firman TUHAN datang kepadanya, bunyinya:"
 },
 {
   "id": 19944,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 16,
   "firman": "\"Pergilah kepada Ebed-Melekh, orang Etiopia itu dan katakanlah kepadanya: Beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, firman-Ku terhadap kota ini akan Kulaksanakan untuk kemalangan dan bukan untuk kebaikannya, dan semuanya itu akan terjadi di depan matamu pada waktu itu juga."
 },
 {
   "id": 19945,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 17,
   "firman": "Pada waktu itu juga, demikianlah firman TUHAN, Aku akan melepaskan engkau, dan engkau tidak akan diserahkan ke dalam tangan orang-orang yang kautakuti,"
 },
 {
   "id": 19946,
   "kitab": "Yer",
   "pasal": 39,
   "ayat": 18,
   "firman": "tetapi dengan pasti Aku akan meluputkan engkau: engkau tidak akan rebah oleh pedang; nyawamu akan menjadi jarahan bagimu, sebab engkau percaya kepada-Ku, demikianlah firman TUHAN.\""
 },
 {
   "id": 19947,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 1,
   "firman": "Firman yang datang dari pada TUHAN kepada Yeremia, sesudah ia dilepaskan dari Rama oleh Nebuzaradan, kepala pasukan pengawal, yang telah menyuruh untuk mengambilnya terbelenggu pada tangannya di tengah-tengah semua orang buangan dari Yerusalem dan Yehuda yang hendak diangkut ke dalam pembuangan ke Babel."
 },
 {
   "id": 19948,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 2,
   "firman": "Kepala pasukan pengawal itu telah mengambil Yeremia dan berkata kepadanya: \"TUHAN, Allahmu, telah mengancamkan malapetaka ini atas tempat ini,"
 },
 {
   "id": 19949,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 3,
   "firman": "dan Ia telah melaksanakannya. TUHAN telah melakukan apa yang diancamkan-Nya, oleh karena kamu telah berdosa kepada TUHAN dan tidak mendengarkan suara-Nya, sehingga terjadilah hal ini kepada kamu."
 },
 {
   "id": 19950,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 4,
   "firman": "Maka sekarang, lihatlah aku melepaskan engkau hari ini dari belenggu yang ada pada tanganmu itu. Jika engkau suka untuk ikut pergi dengan aku ke Babel, marilah! Aku akan memperhatikan engkau. Tetapi jika engkau tidak suka untuk ikut pergi dengan aku ke Babel, janganlah pergi! Lihat, seluruh negeri ini terbuka untuk engkau: engkau boleh pergi ke mana saja engkau pandang baik dan benar."
 },
 {
   "id": 19951,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 5,
   "firman": "Engkau boleh kembali kepada Gedalya bin Ahikam bin Safan yang telah diangkat oleh raja Babel atas kota-kota Yehuda, dan tinggallah bersama-sama dia di tengah-tengah rakyat, atau ke mana saja engkau pandang benar, pergilah ke situ!\" Lalu kepala pasukan pengawal itu memberikan kepadanya bekal makanan dan suatu hadiah, kemudian melepas dia pergi."
 },
 {
   "id": 19952,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 6,
   "firman": "Jadi pergilah Yeremia kepada Gedalya bin Ahikam di Mizpa, dan diam bersama-sama dengan dia di tengah-tengah rakyat yang masih tinggal di negeri itu."
 },
 {
   "id": 19953,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 7,
   "firman": "Ketika semua panglima tentara, yang masih berada di luar kota dengan orang-orangnya, mendengar bahwa raja Babel telah mengangkat Gedalya bin Ahikam bin Safan atas negeri itu dan bahwa kepadanya telah diserahkan pengawasan atas laki-laki, perempuan dan anak-anak, yaitu dari orang-orang lemah di negeri itu, yang tidak diangkut ke dalam pembuangan ke Babel,"
 },
 {
   "id": 19954,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 8,
   "firman": "maka pergilah mereka kepada Gedalya di Mizpa; mereka ialah Ismael bin Netanya, Yohanan bin Kareah, Seraya bin Tanhumet, anak-anak Efai orang Netofa itu, dan Yezanya, anak seorang Maakha, bersama dengan anak buahnya."
 },
 {
   "id": 19955,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 9,
   "firman": "Lalu bersumpahlah Gedalya bin Ahikam bin Safan kepada mereka dengan anak buah mereka: \"Janganlah kamu takut untuk takluk kepada orang-orang Kasdim itu; tinggallah di negeri ini dan takluklah kepada raja Babel, maka keadaanmu akan menjadi baik."
 },
 {
   "id": 19956,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 10,
   "firman": "Dan aku sendiri, aku menetap di Mizpa untuk bertindak sebagai wakil di depan orang-orang Kasdim yang akan datang kepada kita; tetapi kamu ini, kumpulkanlah saja hasil anggur, buah-buahan dan minyak, kemudian simpanlah sebagai persediaan, dan tinggallah di kota-kota di mana kamu hendak menetap.\""
 },
 {
   "id": 19957,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 11,
   "firman": "Juga ketika semua orang Yehuda, yang ada di Moab di antara bani Amon, di Edom dan di negeri-negeri lain, mendengar bahwa raja Babel telah membiarkan tinggal sisa rakyat di Yehuda dan mengangkat Gedalya bin Ahikam bin Safan atas mereka,"
 },
 {
   "id": 19958,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 12,
   "firman": "maka kembalilah semua orang Yehuda dari segala tempat ke mana mereka telah berserak-serak, dan masuk ke tanah Yehuda kepada Gedalya di Mizpa; mereka mengumpulkan hasil anggur dan buah-buahan amat sangat banyaknya."
 },
 {
   "id": 19959,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 13,
   "firman": "Pada suatu kali Yohanan bin Kareah dan semua panglima tentara yang masih berada di luar kota datang kepada Gedalya di Mizpa,"
 },
 {
   "id": 19960,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 14,
   "firman": "dan mereka berkata kepadanya: \"Tahukah engkau bahwa Baalis, raja bani Amon, telah menyuruh Ismael bin Netanya membunuh engkau?\" Tetapi Gedalya bin Ahikam tidak percaya kepada mereka."
 },
 {
   "id": 19961,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 15,
   "firman": "Kemudian Yohanan bin Kareah berkata dengan diam-diam kepada Gedalya di Mizpa: \"Baiklah aku pergi membunuh Ismael bin Netanya itu dengan tidak diketahui siapapun juga. Mengapa engkau harus dibunuhnya, sehingga semua orang Yehuda yang telah berkumpul di sekelilingmu berserak-serak lagi dan sisa Yehuda itu binasa?\""
 },
 {
   "id": 19962,
   "kitab": "Yer",
   "pasal": 40,
   "ayat": 16,
   "firman": "Tetapi Gedalya bin Ahikam menjawab Yohanan bin Kareah: \"Janganlah lakukan itu! Sebab yang kaukatakan tentang Ismael itu adalah bohong.\""
 },
 {
   "id": 19963,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 1,
   "firman": "Dalam bulan yang ketujuh datanglah Ismael bin Netanya bin Elisama--ia keturunan raja dan perwira tinggi raja--beserta sepuluh orang kepada Gedalya bin Ahikam di Mizpa. Sementara mereka makan roti bersama-sama di Mizpa,"
 },
 {
   "id": 19964,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 2,
   "firman": "maka bangkitlah Ismael bin Netanya dengan kesepuluh orang yang ada bersama-sama dia, lalu mereka memukul mati Gedalya bin Ahikam bin Safan dengan pedang; demikianlah Ismael membunuh dia yang telah diangkat raja Babel atas negeri itu."
 },
 {
   "id": 19965,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 3,
   "firman": "Juga semua orang Yehuda yang ada bersama-sama dengan Gedalya di Mizpa dan orang-orang Kasdim, yakni prajurit, yang terdapat di sana dipukul mati oleh Ismael."
 },
 {
   "id": 19966,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 4,
   "firman": "Esok harinya sesudah ia membunuh Gedalya--ketika itu belum ada yang tahu--"
 },
 {
   "id": 19967,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 5,
   "firman": "datanglah orang-orang dari Sikhem, dari Silo dan dari Samaria, delapan puluh orang jumlahnya, yang janggutnya bercukur, pakaiannya koyak-koyak dan badannya bertoreh-toreh; mereka membawa korban sajian dan kemenyan untuk dipersembahkan di rumah TUHAN."
 },
 {
   "id": 19968,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 6,
   "firman": "Lalu keluarlah Ismael bin Netanya dari Mizpa untuk mendapatkan mereka sambil menangis. Ketika ia bertemu dengan mereka, berkatalah ia kepada mereka: \"Pergilah kepada Gedalya bin Ahikam!\""
 },
 {
   "id": 19969,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 7,
   "firman": "Tetapi ketika mereka sampai ke tengah-tengah kota itu, maka mereka disembelih oleh Ismael bin Netanya dengan dibantu oleh orang-orang yang bersama-sama dengan dia; mayat-mayat mereka dicampakkan ke dalam perigi."
 },
 {
   "id": 19970,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 8,
   "firman": "Tetapi di antara mereka terdapat sepuluh orang yang berkata kepada Ismael: \"Janganlah bunuh kami, sebab kami masih mempunyai perbekalan tersembunyi di luar kota, yakni gandum, jelai, minyak dan madu!\" Maka iapun membiarkan mereka, tidak membunuhnya bersama-sama dengan rekan-rekan mereka."
 },
 {
   "id": 19971,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 9,
   "firman": "Adapun perigi, ke mana Ismael melemparkan segala mayat orang-orang yang dipukulnya mati itu adalah perigi besar yang telah dibuat oleh raja Asa untuk menghadapi Baesa, raja Israel; itulah yang diisi Ismael bin Netanya dengan mayat orang-orang yang mati terbunuh itu."
 },
 {
   "id": 19972,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 10,
   "firman": "Lalu Ismael mengangkut sebagai tawanan seluruh sisa-sisa rakyat yang ada di Mizpa itu, puteri-puteri raja dan semua orang yang masih tinggal di Mizpa yang telah ditempatkan di bawah Gedalya bin Ahikam oleh Nebuzaradan, kepala pasukan pengawal itu. Ismael bin Netanya mengangkut mereka sebagai tawanan, lalu ia berangkat untuk menyeberang ke daerah bani Amon."
 },
 {
   "id": 19973,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 11,
   "firman": "Tetapi ketika Yohanan bin Kareah serta semua perwira tentara, yang bersama-sama dengan dia, mendengar tentang segala kejahatan yang telah dilakukan Ismael bin Netanya,"
 },
 {
   "id": 19974,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 12,
   "firman": "maka merekapun mengumpulkan semua anak buah mereka, lalu mereka berangkat memerangi Ismael bin Netanya. Mereka bertemu dengan dia di telaga yang di Gibeon."
 },
 {
   "id": 19975,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 13,
   "firman": "Ketika seluruh rakyat yang bersama-sama dengan Ismael melihat Yohanan bin Kareah serta semua perwira tentara yang bersama-sama dengan dia, maka bersukacitalah mereka."
 },
 {
   "id": 19976,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 14,
   "firman": "Semua orang yang diangkut sebagai tawanan oleh Ismael dari Mizpa itu berbalik dan pergi mengikuti Yohanan bin Kareah."
 },
 {
   "id": 19977,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 15,
   "firman": "Tetapi Ismael bin Netanya beserta delapan orang terluput dari tangan Yohanan dan pergi ke daerah bani Amon."
 },
 {
   "id": 19978,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 16,
   "firman": "Lalu Yohanan bin Kareah serta semua perwira tentara yang bersama-sama dengan dia mengumpulkan seluruh sisa-sisa rakyat yang diangkut sebagai tawanan oleh Ismael bin Netanya dari Mizpa, setelah ia memukul mati Gedalya bin Ahikam: yaitu laki-laki, prajurit-prajurit, perempuan, anak-anak dan pegawai-pegawai istana yang dibawa kembali dari Gibeon,"
 },
 {
   "id": 19979,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 17,
   "firman": "kemudian mereka berjalan terus dan berhenti di tempat penginapan milik Kimham dekat Betlehem, dengan maksud berjalan terus menuju Mesir,"
 },
 {
   "id": 19980,
   "kitab": "Yer",
   "pasal": 41,
   "ayat": 18,
   "firman": "untuk mengelakkan orang-orang Kasdim, yang ditakuti mereka, oleh karena Ismael bin Netanya telah memukul mati Gedalya bin Ahikam yang telah diangkat raja Babel atas negeri itu."
 },
 {
   "id": 19981,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 1,
   "firman": "Kemudian datanglah semua perwira tentara, di antaranya Yohanan bin Kareah dan Azarya bin Hosaya, beserta seluruh rakyat, dari yang kecil sampai kepada yang besar,"
 },
 {
   "id": 19982,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 2,
   "firman": "dan mereka berkata kepada nabi Yeremia: \"Biarlah kiranya permohonan kami sampai di hadapanmu! Berdoalah untuk kami kepada TUHAN, Allahmu, untuk seluruh sisa ini; sebab dari banyak orang hanya sedikit saja kami yang tinggal, seperti yang kaulihat dengan matamu sendiri."
 },
 {
   "id": 19983,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 3,
   "firman": "Semoga TUHAN, Allahmu, memberitahukan kepada kami jalan yang harus kami tempuh dan apa yang harus kami lakukan.\""
 },
 {
   "id": 19984,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 4,
   "firman": "Jawab nabi Yeremia kepada mereka: \"Permohonanmu sudah kudengar! Lihat, aku akan berdoa kepada TUHAN, Allahmu, seperti yang kamu minta itu, dan segala firman, yang diberi TUHAN sebagai jawab, akan kuberitahukan kepadamu; sepatah katapun tidak akan kudiamkan kepadamu!\""
 },
 {
   "id": 19985,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 5,
   "firman": "Berkatalah mereka kepada Yeremia: \"Biarlah TUHAN menjadi saksi yang benar dan yang dapat dipercaya terhadap kami, jika kami tidak berbuat menurut segala firman yang disuruh TUHAN, Allahmu, kausampaikan kepada kami."
 },
 {
   "id": 19986,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 6,
   "firman": "Maupun baik ataupun buruk, kami akan mendengarkan suara TUHAN, Allah kita, yang kepada-Nya kami mengutus engkau, supaya keadaan kami baik, oleh karena kami mendengarkan suara TUHAN, Allah kita.\""
 },
 {
   "id": 19987,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 7,
   "firman": "Sesudah sepuluh hari datanglah firman TUHAN kepada Yeremia."
 },
 {
   "id": 19988,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 8,
   "firman": "Lalu Yeremia memanggil Yohanan bin Kareah dan semua perwira tentara yang ada bersama-sama dengan dia, dan seluruh rakyat, dari yang kecil sampai kepada yang besar."
 },
 {
   "id": 19989,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 9,
   "firman": "Berkatalah ia kepada mereka: \"Beginilah firman TUHAN, Allah Israel yang kepada-Nya kamu telah mengutus aku untuk menyampaikan permohonanmu ke hadapan-Nya:"
 },
 {
   "id": 19990,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 10,
   "firman": "Jika kamu tinggal tetap di negeri ini, maka Aku akan membangun dan tidak akan meruntuhkan kamu, akan membuat kamu tumbuh dan tidak akan mencabut kamu; sebab Aku menyesal telah mendatangkan malapetaka kepadamu."
 },
 {
   "id": 19991,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 11,
   "firman": "Janganlah takut kepada raja Babel yang kamu takuti itu. Janganlah takut kepadanya, demikianlah firman TUHAN, sebab Aku menyertai kamu untuk menyelamatkan kamu dan untuk melepaskan kamu dari tangannya."
 },
 {
   "id": 19992,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 12,
   "firman": "Aku akan membuat kamu mendapat belas kasihan, sehingga ia merasa belas kasihan kepadamu dan membiarkan kamu tinggal di tanahmu."
 },
 {
   "id": 19993,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 13,
   "firman": "Tetapi jika kamu tidak mau mendengarkan suara TUHAN, Allahmu, dengan mengatakan: Kami tidak mau tinggal di negeri ini!,"
 },
 {
   "id": 19994,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 14,
   "firman": "sebab pikirmu: Tidak! Kami mau pergi ke negeri Mesir, di mana kami tidak akan mengalami pertempuran, tidak akan mendengar bunyi sangkakala dan tidak akan menderita kelaparan; di sanalah kami akan tinggal!,"
 },
 {
   "id": 19995,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 15,
   "firman": "maka dengarkanlah sekarang firman Allah, hai sisa Yehuda: Beginilah firman TUHAN semesta alam, Allah Israel: Jika kamu sungguh-sungguh berniat hendak pergi ke Mesir, dan memang kamu pergi dan tinggal sebagai orang asing di sana,"
 },
 {
   "id": 19996,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 16,
   "firman": "maka pedang yang kamu takuti itu akan menimpa kamu di negeri Mesir, dan kelaparan yang kamu gentarkan itu tidak putus-putusnya mengejar-ngejar kamu di Mesir, sampai kamu mati di sana."
 },
 {
   "id": 19997,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 17,
   "firman": "Semua orang, yang berniat hendak pergi ke Mesir untuk tinggal sebagai orang asing di sana, akan mati karena pedang, kelaparan dan penyakit sampar; seorangpun dari mereka tidak ada yang terlepas atau terluput dari malapetaka yang Kudatangkan atas mereka."
 },
 {
   "id": 19998,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 18,
   "firman": "Sungguh, beginilah firman TUHAN semesta alam, Allah Israel: Seperti tercurahnya murka-Ku dan kehangatan amarah-Ku ke atas penduduk Yerusalem, demikianlah akan tercurah kehangatan amarah-Ku ke atas kamu, apabila kamu pergi ke Mesir. Kamu akan menjadi kutuk, kengerian, kutukan dan aib; kamu tidak akan melihat tempat ini lagi."
 },
 {
   "id": 19999,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 19,
   "firman": "TUHAN telah berfirman kepadamu, hai sisa Yehuda: Janganlah pergi ke Mesir! Camkanlah sungguh-sungguh, bahwa aku memperingatkan kamu pada hari ini!"
 },
 {
   "id": 20000,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 20,
   "firman": "Kamu telah menipu dirimu dan membahayakan nyawamu, ketika kamu mengutus aku kepada TUHAN, Allahmu, dengan berkata: Berdoalah untuk kami kepada TUHAN, Allah kita, dan beritahukanlah dengan tepat kepada kami apa yang difirmankan TUHAN, Allah kita, supaya kami melakukannya!"
 },
 {
   "id": 20001,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 21,
   "firman": "Tetapi, sekalipun aku memberitahukannya kepadamu pada hari ini, kamu tidak mendengarkan suara TUHAN, Allahmu, yaitu tidak menuruti segala sesuatu yang disuruh-Nya kusampaikan kepadamu."
 },
 {
   "id": 20002,
   "kitab": "Yer",
   "pasal": 42,
   "ayat": 22,
   "firman": "Oleh sebab itu, camkanlah sungguh-sungguh, bahwa kamu akan mati karena pedang, kelaparan dan penyakit sampar di tempat yang kamu rindukan untuk tinggal sebagai orang asing di sana.\""
 },
 {
   "id": 20003,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 1,
   "firman": "Ketika Yeremia selesai mengatakan kepada seluruh rakyat segala firman TUHAN, Allah mereka, yang disuruh TUHAN, Allah mereka, disampaikannya kepada mereka, yaitu segala firman yang tersebut di atas,"
 },
 {
   "id": 20004,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 2,
   "firman": "maka berkatalah Azarya bin Hosaya dan Yohanan bin Kareah serta semua orang congkak itu kepada Yeremia: \"Engkau berkata bohong! TUHAN, Allah kita, tidak mengutus engkau untuk berkata: Janganlah pergi ke Mesir untuk tinggal sebagai orang asing di sana,"
 },
 {
   "id": 20005,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 3,
   "firman": "tetapi Barukh bin Neria menghasut engkau terhadap kami dengan maksud untuk menyerahkan kami ke dalam tangan orang-orang Kasdim, supaya mereka membunuh kami dan mengangkut kami ke dalam pembuangan ke Babel.\""
 },
 {
   "id": 20006,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 4,
   "firman": "Demikianlah Yohanan bin Kareah dan semua perwira tentara serta seluruh rakyat tidak mau mendengarkan suara TUHAN untuk tinggal di tanah Yehuda."
 },
 {
   "id": 20007,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 5,
   "firman": "Lalu Yohanan bin Kareah dan semua perwira tentara itu mengumpulkan seluruh sisa Yehuda, yakni semua orang yang telah kembali dari antara segala bangsa, ke mana mereka telah berserak-serak, untuk menetap di tanah Yehuda,"
 },
 {
   "id": 20008,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 6,
   "firman": "laki-laki, perempuan, anak-anak, puteri-puteri raja dan setiap orang yang telah dibiarkan Nebuzaradan, kepala pasukan pengawal, pada Gedalya bin Ahikam bin Safan; juga nabi Yeremia dan Barukh bin Neria."
 },
 {
   "id": 20009,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 7,
   "firman": "Lalu mereka pergi ke tanah Mesir, sebab mereka tidak mau mendengarkan suara TUHAN. Maka sampailah mereka di Tahpanhes."
 },
 {
   "id": 20010,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 8,
   "firman": "Kemudian datanglah firman TUHAN kepada Yeremia di Tahpanhes, bunyinya:"
 },
 {
   "id": 20011,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 9,
   "firman": "\"Ambillah di tanganmu batu-batu besar dan sembunyikanlah itu di tanah liat dekat pintu masuk istana Firaun di Tahpanhes di hadapan mata orang-orang Yehuda itu,"
 },
 {
   "id": 20012,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 10,
   "firman": "lalu katakanlah kepada mereka: Beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku mengutus orang untuk menjemput Nebukadnezar, raja Babel, hamba-Ku itu, supaya ia mendirikan takhtanya di atas batu-batu yang telah Kusuruh sembunyikan ini, dan membentangkan permadani kebesarannya di atasnya."
 },
 {
   "id": 20013,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 11,
   "firman": "Dan apabila ia datang, ia akan memukul tanah Mesir: Yang ke maut, ke mautlah! Yang ke tawanan, ke tawananlah! Yang ke pedang, ke pedanglah!"
 },
 {
   "id": 20014,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 12,
   "firman": "Ia akan menyalakan api di kuil-kuil para allah Mesir dan akan membakar atau mengangkutnya sebagai tawanan. Dan ia akan membersihkan tanah Mesir dari kutu-kutu seperti seorang gembala membersihkan pakaiannya dari kutu-kutu, kemudian ia akan pergi dari sana tanpa gangguan."
 },
 {
   "id": 20015,
   "kitab": "Yer",
   "pasal": 43,
   "ayat": 13,
   "firman": "Ia akan memecahkan tugu-tugu berhala Bet-Syemes yang ada di Mesir dan akan menghanguskan kuil para allah Mesir itu dengan api.\""
 },
 {
   "id": 20016,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 1,
   "firman": "Firman yang datang kepada Yeremia untuk semua orang Yehuda yang diam di tanah Mesir, di Migdol, di Tahpanhes, di Memfis dan di tanah Patros:"
 },
 {
   "id": 20017,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN semesta alam, Allah Israel: Kamu telah mengalami segenap malapetaka yang telah Kudatangkan atas Yerusalem dan atas segala kota Yehuda; sungguh, semuanya itu kini sudah menjadi reruntuhan dan tidak ada seorangpun diam di sana."
 },
 {
   "id": 20018,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 3,
   "firman": "Itu disebabkan oleh kejahatan yang telah mereka lakukan untuk menimbulkan sakit hati-Ku, yakni mereka pergi membakar korban dan beribadah kepada allah lain yang tidak dikenal oleh mereka sendiri, oleh kamu atau oleh nenek moyangmu."
 },
 {
   "id": 20019,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 4,
   "firman": "Terus-menerus Aku telah mengutus kepadamu semua hamba-Ku, para nabi, dengan mengatakan: Janganlah hendaknya kamu melakukan kejijikan yang Aku benci ini!"
 },
 {
   "id": 20020,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 5,
   "firman": "Tetapi mereka tidak mau mendengarkan dan tidak mau memperhatikan supaya berbalik dari kejahatan mereka dan tidak membakar korban lagi kepada allah lain."
 },
 {
   "id": 20021,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 6,
   "firman": "Sebab itu kehangatan amarah-Ku dan murka-Ku telah tercurah dan membakar kota-kota Yehuda dan jalan-jalan Yerusalem, sehingga menjadi reruntuhan dan tempat tandus, seperti yang ternyata sekarang ini."
 },
 {
   "id": 20022,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 7,
   "firman": "Maka sekarang, beginilah firman TUHAN, Allah semesta alam, Allah Israel: Mengapakah kamu mendatangkan celaka besar kepada dirimu sendiri? Kamu mau melenyapkan laki-laki, perempuan, anak-anak dan bayi dari Yehuda dengan tidak meninggalkan sisa apapun?"
 },
 {
   "id": 20023,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 8,
   "firman": "Mengapa kamu mau menimbulkan sakit hati-Ku dengan perbuatan tanganmu, yakni membakar korban kepada allah lain di tanah Mesir yang kamu masuki untuk tinggal sebagai orang asing di sana? Mengapa kamu mau menjadi kutuk dan aib di antara segala bangsa di bumi?"
 },
 {
   "id": 20024,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 9,
   "firman": "Sudah lupakah kamu kepada kejahatan nenek moyangmu, kejahatan raja-raja Yehuda, kejahatan para pemuka mereka, kejahatanmu sendiri dan kejahatan isteri-isterimu yang dilakukan mereka di tanah Yehuda dan di jalan-jalan Yerusalem?"
 },
 {
   "id": 20025,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 10,
   "firman": "Mereka tidak remuk hati sampai kepada hari ini, mereka tidak takut dan tidak mengikuti Taurat-Ku dan ketetapan-Ku yang telah Kuberikan kepadamu dan kepada nenek moyangmu."
 },
 {
   "id": 20026,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 11,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku mau menujukan wajah-Ku terhadap kamu untuk kecelakaanmu, yakni Aku mau melenyapkan segenap orang Yehuda."
 },
 {
   "id": 20027,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 12,
   "firman": "Aku mau mencabut sisa Yehuda yang berniat hendak pergi ke tanah Mesir untuk tinggal sebagai orang asing di sana; mereka semuanya akan habis mati di tanah Mesir; mereka akan rebah mati karena pedang dan akan habis mati karena kelaparan, dari yang kecil sampai kepada yang besar; mereka akan mati karena pedang dan karena kelaparan dan mereka akan menjadi kutuk, kengerian, kutukan dan aib."
 },
 {
   "id": 20028,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 13,
   "firman": "Aku mau menghukum mereka yang diam di tanah Mesir, sama seperti Aku telah menghukum Yerusalem, yaitu dengan pedang, dengan kelaparan dan dengan penyakit sampar,"
 },
 {
   "id": 20029,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 14,
   "firman": "sehingga dari sisa Yehuda, yang telah pergi ke tanah Mesir untuk tinggal sebagai orang asing di sana, tidak ada seorangpun yang terluput atau terlepas untuk kembali ke tanah Yehuda, ke mana hati mereka sangat rindu untuk diam di sana lagi; sungguh, mereka tidak akan kembali, kecuali beberapa orang pengungsi.\""
 },
 {
   "id": 20030,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 15,
   "firman": "Lalu menjawablah kepada Yeremia semua orang laki-laki yang tahu bahwa isteri mereka membakar korban kepada allah lain, dan semua perempuan yang hadir di sana, suatu kumpulan yang besar, yakni segala rakyat yang diam di tanah Mesir dan di Patros, katanya:"
 },
 {
   "id": 20031,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 16,
   "firman": "\"Mengenai apa yang kaukatakan demi nama Allah kepada kami itu, kami tidak akan mendengarkan engkau,"
 },
 {
   "id": 20032,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 17,
   "firman": "tetapi kami akan terus melakukan segala apa yang kami ucapkan, yakni membakar korban kepada ratu sorga dan mempersembahkan korban curahan kepadanya seperti telah kami lakukan, kami sendiri dan nenek moyang kami dan raja-raja kami dan pemuka-pemuka kami di kota-kota Yehuda dan di jalan-jalan Yerusalem. Pada waktu itu kami mempunyai cukup makanan; kami merasa bahagia dan tidak mengalami penderitaan."
 },
 {
   "id": 20033,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 18,
   "firman": "Tetapi sejak kami berhenti membakar korban dan mempersembahkan korban curahan kepada ratu sorga, maka kami kekurangan segala-galanya dan kami dihabiskan oleh pedang dan kelaparan.\""
 },
 {
   "id": 20034,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 19,
   "firman": "Lalu perempuan-perempuan itu menambahkan: \"Apabila kami membakar korban dan mempersembahkan korban curahan kepada ratu sorga, adakah di luar pengetahuan suami kami bahwa kami membuat penganan persembahan serupa dengan patungnya dan mempersembahkan korban curahan kepadanya?\""
 },
 {
   "id": 20035,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 20,
   "firman": "Sesudah itu berkatalah Yeremia kepada segenap rakyat itu, kepada laki-laki dan perempuan dan kepada semua orang yang telah memberi jawab kepadanya itu, katanya:"
 },
 {
   "id": 20036,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 21,
   "firman": "\"Justru korban yang dibakar di kota-kota Yehuda dan di jalan-jalan Yerusalem oleh kamu sendiri, oleh nenek moyangmu, oleh raja-rajamu, oleh pemuka-pemukamu dan oleh rakyat negeri, tidakkah itu yang diingat TUHAN dan yang diperhatikan-Nya?"
 },
 {
   "id": 20037,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 22,
   "firman": "TUHAN tidak tahan lagi melihat perbuatan-perbuatanmu yang jahat dan kejijikan yang kamu lakukan; oleh karena itu negerimupun telah menjadi reruntuhan, kengerian dan kutuk tanpa penduduk, seperti yang ternyata sekarang ini."
 },
 {
   "id": 20038,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 23,
   "firman": "Kamu telah membakar korban dan kamu telah berdosa kepada TUHAN, tidak mendengarkan suara TUHAN dan tidak mengikuti Taurat-Nya, ketetapan-Nya dan peraturan-Nya, itulah sebabnya malapetaka ini menimpa kamu, seperti yang ternyata sekarang ini.\""
 },
 {
   "id": 20039,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 24,
   "firman": "Kemudian berkatalah Yeremia kepada segenap rakyat dan kepada semua perempuan itu: \"Dengarlah firman TUHAN, hai semua orang Yehuda yang ada di tanah Mesir."
 },
 {
   "id": 20040,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 25,
   "firman": "Beginilah firman TUHAN semesta alam, Allah Israel: Kamu, laki-laki dan isteri-isterimu! Kamu telah memenuhi apa yang telah kamu ucapkan, yaitu: Kami akan menepati dengan baik nazar yang kami ucapkan untuk membakar korban dan mempersembahkan korban curahan kepada ratu sorga. Baiklah! Wujudkanlah dan tepatilah nazarmu dengan baik!"
 },
 {
   "id": 20041,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 26,
   "firman": "Maka dengarkanlah firman TUHAN, hai semua orang Yehuda yang diam di tanah Mesir: Sesungguhnya, Aku telah bersumpah demi nama-Ku yang besar--firman TUHAN--bahwa nama-Ku tidak akan diserukan lagi oleh seseorang Yehuda di segenap tanah Mesir, dengan berkata: Demi Tuhan ALLAH yang hidup!"
 },
 {
   "id": 20042,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 27,
   "firman": "Sesungguhnya Aku berjaga-jaga untuk kecelakaan mereka dan bukan untuk kebahagiaan mereka; setiap orang Yehuda yang ada di tanah Mesir akan dihabiskan oleh pedang dan oleh kelaparan sampai mereka punah sama sekali."
 },
 {
   "id": 20043,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 28,
   "firman": "Hanya beberapa orang yang terluput dari pedang--jumlahnya kecil--yang akan kembali dari tanah Mesir ke tanah Yehuda. Maka seluruh sisa Yehuda yang telah pergi ke Mesir untuk tinggal sebagai orang asing di sana akan mengetahui perkataan siapa yang terwujud, perkataan-Ku atau perkataan mereka."
 },
 {
   "id": 20044,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 29,
   "firman": "Inilah tanda bagimu, demikianlah firman TUHAN, bahwa Aku akan menghukum kamu di tempat ini, supaya kamu mengetahui bahwa perkataan-perkataan-Ku terhadap kamu akan sungguh-sungguh terwujud untuk kecelakaanmu."
 },
 {
   "id": 20045,
   "kitab": "Yer",
   "pasal": 44,
   "ayat": 30,
   "firman": "Beginilah firman TUHAN: Sesungguhnya, Aku menyerahkan Firaun, Hofra, raja Mesir, ke dalam tangan musuhnya dan ke dalam tangan orang-orang yang berusaha mencabut nyawanya, sama seperti Aku telah menyerahkan Zedekia, raja Yehuda, ke dalam tangan Nebukadnezar, raja Babel, musuhnya yang berusaha mencabut nyawanya.\""
 },
 {
   "id": 20046,
   "kitab": "Yer",
   "pasal": 45,
   "ayat": 1,
   "firman": "Firman yang disampaikan oleh nabi Yeremia kepada Barukh bin Neria, waktu Barukh dalam tahun keempat pemerintahan Yoyakim bin Yosia, raja Yehuda, menuliskan segala firman tersebut dalam sebuah kitab langsung dari mulut Yeremia:"
 },
 {
   "id": 20047,
   "kitab": "Yer",
   "pasal": 45,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN, Allah Israel, tentang engkau, hai Barukh!"
 },
 {
   "id": 20048,
   "kitab": "Yer",
   "pasal": 45,
   "ayat": 3,
   "firman": "Oleh karena engkau telah berkata: Celakalah aku, sebab TUHAN telah menambahkan kedukaan kepada penderitaanku! Aku lesu karena keluh kesahku dan aku tidak mendapat ketenangan,"
 },
 {
   "id": 20049,
   "kitab": "Yer",
   "pasal": 45,
   "ayat": 4,
   "firman": "maka beginilah firman TUHAN: Sesungguhnya, apa yang Kubangun akan Kuruntuhkan, dan apa yang Kutanam akan Kucabut, bahkan sekalipun seluruh negeri!"
 },
 {
   "id": 20050,
   "kitab": "Yer",
   "pasal": 45,
   "ayat": 5,
   "firman": "Masakan engkau mencari hal-hal yang besar bagimu sendiri? Janganlah mencarinya! Sebab, sesungguhnya, Aku mendatangkan malapetaka atas segala makhluk, demikianlah firman TUHAN, tetapi kepadamu akan Kuberikan nyawamu sebagai jarahan di segala tempat ke mana engkau pergi.\""
 },
 {
   "id": 20051,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada nabi Yeremia tentang bangsa-bangsa."
 },
 {
   "id": 20052,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 2,
   "firman": "Mengenai Mesir. Terhadap tentara Firaun Nekho, raja Mesir, yang berkemah di tepi sungai Efrat dekat Karkemis dan yang dipukul kalah oleh Nebukadnezar, raja Babel, dalam tahun yang keempat pemerintahan Yoyakim bin Yosia, raja Yehuda:"
 },
 {
   "id": 20053,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 3,
   "firman": "\"Siapkanlah perisai besar dan perisai kecil dan majulah untuk bertempur!"
 },
 {
   "id": 20054,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 4,
   "firman": "Pasanglah kuda, dan naiklah, hai pengendara-pengendara! Ambillah tempatmu dengan memakai ketopong, tajamkanlah tombakmu, pakailah baju zirahmu!"
 },
 {
   "id": 20055,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 5,
   "firman": "Mengapa kulihat mereka terkejut, mundur ke belakang? Pahlawan-pahlawan mereka terpukul kalah, lari kocar-kacir, tanpa menoleh; kedahsyatan dari segala jurusan!, demikianlah firman TUHAN."
 },
 {
   "id": 20056,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 6,
   "firman": "Orang yang tangkas tidak dapat melarikan diri, pahlawan tidak dapat meluputkan diri; di utara, di tepi sungai Efratlah mereka tersandung dan rebah."
 },
 {
   "id": 20057,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 7,
   "firman": "Siapakah ini yang meluas seperti sungai Nil dan yang airnya bergelora seperti sungai-sungai?"
 },
 {
   "id": 20058,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 8,
   "firman": "Itulah Mesir yang meluas seperti sungai Nil, dan yang airnya bergelora seperti sungai-sungai. Ia berkata: Aku mau meluas menutupi bumi, membinasakan kota dan penduduknya."
 },
 {
   "id": 20059,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 9,
   "firman": "Majulah, hai kuda-kuda! Melajulah, hai kereta-kereta! Majulah berperang, hai pahlawan-pahlawan, hai kamu orang Etiopia dan orang Put yang memegang perisai, dan orang Lidia yang membentur busur!"
 },
 {
   "id": 20060,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 10,
   "firman": "Hari itu ialah hari Tuhan ALLAH semesta alam, hari pembalasan untuk melakukan pembalasan kepada para lawan-Nya. Pedang akan makan sampai kenyang, dan akan puas minum darah mereka. Sebab Tuhan ALLAH semesta alam mengadakan korban penyembelihan di tanah utara, dekat sungai Efrat."
 },
 {
   "id": 20061,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 11,
   "firman": "Pergilah ke Gilead mengambil balsam, hai anak dara, puteri Mesir! Sia-sia engkau memakai banyak obat, kesembuhan tidak akan kaudapat!"
 },
 {
   "id": 20062,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 12,
   "firman": "Bangsa-bangsa telah mendengar tentang celamu, bumi telah penuh dengan teriakmu, sebab pahlawan yang satu tersandung kepada pahlawan yang lain, keduanya rebah bersama-sama.\""
 },
 {
   "id": 20063,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 13,
   "firman": "Firman yang disampaikan TUHAN kepada nabi Yeremia tentang datangnya Nebukadnezar, raja Babel, untuk memukul kalah tanah Mesir:"
 },
 {
   "id": 20064,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 14,
   "firman": "\"Beritahukanlah di Mesir, dan kabarkanlah di Migdol! Kabarkanlah di Memfis dan di Tahpanhes! Katakanlah: Ambillah tempat dan bersiaplah, sebab sekitarmu habis dimakan pedang!"
 },
 {
   "id": 20065,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 15,
   "firman": "Mengapa Apis melarikan diri, tidakkah sanggup sapi jantanmu bertahan? Sungguh, TUHAN telah menundukkan dia!"
 },
 {
   "id": 20066,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 16,
   "firman": "Banyak dari padamu yang tersandung dan rebah, mereka berkata seorang kepada yang lain: Marilah kita pulang kepada bangsa kita, ke negeri kelahiran kita, untuk mengelakkan pedang yang merajalela ini!"
 },
 {
   "id": 20067,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 17,
   "firman": "Sebutlah nama Firaun, raja Mesir: Tukang ribut yang membiarkan kesempatan berlalu!"
 },
 {
   "id": 20068,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 18,
   "firman": "Demi Aku yang hidup, demikianlah firman Raja yang nama-Nya TUHAN semesta alam, ia akan datang seperti gunung Tabor yang menjulang di antara gunung-gunung lain, seperti gunung Karmel yang menganjur ke laut."
 },
 {
   "id": 20069,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 19,
   "firman": "Siapkanlah bagimu barang-barang untuk perjalananmu ke pembuangan, hai puteri Mesir yang sudah lama menetap! Sebab Memfis akan menjadi sunyi sepi, dijadikan reruntuhan yang tidak berpenduduk lagi."
 },
 {
   "id": 20070,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 20,
   "firman": "Mesir adalah lembu muda yang elok, tetapi seekor pikat dari utara mendatangi dia."
 },
 {
   "id": 20071,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 21,
   "firman": "Juga prajurit-prajurit upahan yang ada padanya adalah seperti anak-anak lembu tambun; merekapun berbalik dan melarikan diri bersama-sama; mereka tidak dapat bertahan, sebab hari bencana mereka menimpa mereka, yakni waktu penghukuman mereka."
 },
 {
   "id": 20072,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 22,
   "firman": "Suaranya seperti ular yang mendesis, apabila mereka berjalan maju dengan bertentara; mereka mendatangi dia dengan membawa kapak seperti orang-orang penebang pohon."
 },
 {
   "id": 20073,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 23,
   "firman": "Mereka menebang hutannya, demikianlah firman TUHAN, sekalipun itu tidak dapat dimasuki; sebab lebih banyak mereka dari pada belalang, tidak terbilang jumlahnya."
 },
 {
   "id": 20074,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 24,
   "firman": "Puteri Mesir menjadi malu, diserahkan ke dalam tangan bangsa dari utara.\""
 },
 {
   "id": 20075,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 25,
   "firman": "TUHAN semesta alam, Allah Israel, berfirman: \"Sesungguhnya, Aku mendatangkan hukuman atas dewa Amon dari Tebe, atas Firaun beserta Mesir, dewa-dewanya dan raja-rajanya, yakni atas Firaun beserta orang-orang yang percaya kepadanya."
 },
 {
   "id": 20076,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 26,
   "firman": "Aku akan menyerahkan mereka ke dalam tangan orang-orang yang berusaha mencabut nyawa mereka, yakni ke dalam tangan Nebukadnezar, raja Babel, dan para pegawainya. Tetapi sesudahnya negeri itu akan didiami seperti dalam zaman purbakala, demikianlah firman TUHAN."
 },
 {
   "id": 20077,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 27,
   "firman": "Maka engkau, janganlah takut, hai hamba-Ku Yakub, janganlah gentar, hai Israel! Sebab sesungguhnya, Aku menyelamatkan engkau dari tempat jauh dan keturunanmu dari negeri pembuangan mereka. Yakub akan kembali dan hidup tenang dan aman, dengan tidak ada yang mengejutkan."
 },
 {
   "id": 20078,
   "kitab": "Yer",
   "pasal": 46,
   "ayat": 28,
   "firman": "Maka engkau, janganlah takut, hai hamba-Ku Yakub, demikianlah firman TUHAN, sebab Aku menyertai engkau: segala bangsa yang ke antaranya engkau Kuceraiberaikan akan Kuhabiskan, tetapi engkau ini tidak akan Kuhabiskan. Aku akan menghajar engkau menurut hukum, tetapi Aku sama sekali tidak memandang engkau tak bersalah.\""
 },
 {
   "id": 20079,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada nabi Yeremia mengenai orang Filistin, sebelum Firaun mengalahkan Gaza."
 },
 {
   "id": 20080,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN: Lihat, air yang meluas mengamuk dari utara menjadi sungai yang membanjir, membanjiri negeri serta isinya, kota serta penduduknya. Manusia akan berteriak, dan seluruh penduduk negeri akan meratap,"
 },
 {
   "id": 20081,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 3,
   "firman": "mendengar bunyi derap kuku kudanya, mendengar derak-derik keretanya, kertak-kertuk rodanya. Para ayah tidak lagi berpaling menoleh kepada anak-anak, sebab tangan mereka sudah lemas,"
 },
 {
   "id": 20082,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 4,
   "firman": "oleh karena telah tiba harinya untuk membinasakan semua orang Filistin, dan melenyapkan bagi Tirus dan Sidon setiap penolong yang masih tinggal. Sungguh, TUHAN akan membinasakan orang Filistin, yakni sisa orang yang datang dari pulau Kaftor."
 },
 {
   "id": 20083,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 5,
   "firman": "Gaza telah menjadi gundul, Askelon telah menjadi bungkam; hai Asdod, sisa orang Enak, berapa lama lagi engkau menoreh-noreh diri?"
 },
 {
   "id": 20084,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 6,
   "firman": "Ah, pedang TUHAN, berapa lama lagi baru engkau berhenti? Masuklah kembali ke dalam sarungmu, jadilah tenang dan beristirahatlah!"
 },
 {
   "id": 20085,
   "kitab": "Yer",
   "pasal": 47,
   "ayat": 7,
   "firman": "Tetapi bagaimana ia dapat berhenti? Bukankah TUHAN memerintahkannya? Ke Askelon dan ke tepi pantai laut, ke sanalah Ia menyuruhnya!\""
 },
 {
   "id": 20086,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 1,
   "firman": "Mengenai Moab. Beginilah firman TUHAN semesta alam, Allah Israel: \"Celakalah Nebo, sebab kota itu sudah dibinasakan! Kiryataim telah menjadi malu dan direbut! Kota benteng itu menjadi malu dan terkejut:"
 },
 {
   "id": 20087,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 2,
   "firman": "lenyaplah sudah kemegahan Moab! Di Hesybon orang merencanakan malapetaka terhadapnya: Marilah kita melenyapkannya sebagai bangsa! Juga engkau, hai Madmen, akan dibungkamkan, engkau akan dikejar-kejar pedang."
 },
 {
   "id": 20088,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 3,
   "firman": "Dengar! Teriakan dari Horonaim: Kebinasaan! Kehancuran besar!"
 },
 {
   "id": 20089,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 4,
   "firman": "Moab telah hancur lebur! kedengaran orang berteriak sampai ke Zoar."
 },
 {
   "id": 20090,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 5,
   "firman": "Sungguh, orang mendaki pendakian Luhit sambil menangis. Sungguh, di jalan turun ke Horonaim orang mendengar teriak karena ditimpa bencana."
 },
 {
   "id": 20091,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 6,
   "firman": "Larilah, selamatkanlah nyawamu: jadilah seperti keledai liar di padang gurun!"
 },
 {
   "id": 20092,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 7,
   "firman": "Sungguh, oleh karena engkau percaya kepada bentengmu dan perbendaharaanmu, maka engkaupun akan direbut; Kamos akan pergi ke dalam pembuangan, bersama-sama dengan para imam dan pemukanya."
 },
 {
   "id": 20093,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 8,
   "firman": "Pembinasa akan datang ke setiap kota, tidak ada kota yang terluput! Lembah akan binasa, tanah datar habis musnah, seperti yang difirmankan TUHAN."
 },
 {
   "id": 20094,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 9,
   "firman": "Berikanlah sayap kepada Moab, supaya ia lari terbang; kota-kotanya akan menjadi sunyi sepi, tidak ada lagi penduduk di dalamnya."
 },
 {
   "id": 20095,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 10,
   "firman": "Terkutuklah orang yang melaksanakan pekerjaan TUHAN dengan lalai, dan terkutuklah orang yang menghambat pedang-Nya dari penumpahan darah!"
 },
 {
   "id": 20096,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 11,
   "firman": "Moab hidup aman dari sejak masa mudanya, dia hidup tenang seperti anggur di atas endapannya, tidak dituangkan dari tempayan yang satu ke tempayan yang lain, tidak pernah masuk ke dalam pembuangan; sebab itu rasanya tetap padanya, dan baunya tidak berubah."
 },
 {
   "id": 20097,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 12,
   "firman": "Sebab itu, sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan mengirim kepadanya tukang-tukang yang akan menuangkannya, mencurahkan tempayan-tempayannya dan memecahkan buyung-buyungnya."
 },
 {
   "id": 20098,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 13,
   "firman": "Maka Moab akan menjadi malu oleh karena dewa Kamos, sama seperti kaum Israel menjadi malu oleh karena Betel, kepercayaan mereka."
 },
 {
   "id": 20099,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 14,
   "firman": "Bagaimanakah kamu berani berkata: Kami adalah pahlawan-pahlawan, orang-orang gagah perkasa untuk berperang!"
 },
 {
   "id": 20100,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 15,
   "firman": "Pembinasa Moab telah maju menyerang dia, teruna-terunanya yang pilihan telah turun ke pembantaian, demikianlah firman Raja yang nama-Nya TUHAN semesta alam."
 },
 {
   "id": 20101,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 16,
   "firman": "Bencana Moab sudah hampir datang, malapetakanya sangat segera sampai."
 },
 {
   "id": 20102,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 17,
   "firman": "Ratapilah dia, hai semua yang ada di sekitarnya, hai semua yang mengenal namanya! Katakanlah: Sungguh, sudah patah tampuk kekuasaan, tongkat keagungan itu!"
 },
 {
   "id": 20103,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 18,
   "firman": "Turunlah dari kemuliaanmu dan duduklah di atas kotoran, hai puteri Dibon yang sudah lama menetap! Sebab pembinasa Moab sudah maju menyerbu engkau, memusnahkan tempat-tempatmu yang berkubu."
 },
 {
   "id": 20104,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 19,
   "firman": "Berdirilah di tepi jalan dan tinjaulah, hai penduduk Aroer! Tanyakanlah kepada orang yang lari dan yang terluput, katakanlah: Apakah yang telah terjadi?"
 },
 {
   "id": 20105,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 20,
   "firman": "Moab sudah malu, karena ia terkejut! Merataplah dan berteriaklah, beritahukanlah di sungai Arnon: Sungguh, Moab sudah binasa!"
 },
 {
   "id": 20106,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 21,
   "firman": "Penghukuman telah berlaku atas daerah dataran tinggi, atas kota-kota Holon, Yahas, Mefaat,"
 },
 {
   "id": 20107,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 22,
   "firman": "Dibon, Nebo, Bet-Diblataim,"
 },
 {
   "id": 20108,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 23,
   "firman": "Kiryataim, Bet-Gamul, Bet-Meon,"
 },
 {
   "id": 20109,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 24,
   "firman": "Keriot, Bozra dan atas segala kota negeri Moab yang jauh dan yang dekat."
 },
 {
   "id": 20110,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 25,
   "firman": "Telah patah tanduk kekuatan Moab, dan lengan kekuasaannya telah pecah! demikianlah firman TUHAN."
 },
 {
   "id": 20111,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 26,
   "firman": "Buatlah dia mabuk, sebab dia membesarkan diri terhadap TUHAN! Moab akan berguling-guling dalam muntahnya, dan ia sendiripun akan menjadi tertawaan orang."
 },
 {
   "id": 20112,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 27,
   "firman": "Apakah bukan Israel tadinya yang menjadi tertawaan bagimu? Apakah dia terdapat di antara pencuri-pencuri, sehingga engkau menggeleng-gelengkan kepala, setiap kali engkau berbicara tentang dia?"
 },
 {
   "id": 20113,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 28,
   "firman": "Tinggalkanlah kota-kota dan diamlah di bukit batu, hai penduduk Moab! Jadilah seperti burung merpati yang bersarang di dinding mulut liang."
 },
 {
   "id": 20114,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 29,
   "firman": "Kami telah mendengar tentang keangkuhan Moab, alangkah angkuhnya dia, tentang kesombongannya, keangkuhannya dan kecongkakannya, tentang tinggi hatinya."
 },
 {
   "id": 20115,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 30,
   "firman": "Aku ini kenal kepongahannya, demikianlah firman TUHAN, tidak benar cakapnya, dan tidak benar perilakunya."
 },
 {
   "id": 20116,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 31,
   "firman": "Sebab itu aku akan meratap karena Moab, akan berteriak karena Moab seluruhnya, dan akan mengaduh karena orang-orang Kir-Heres!"
 },
 {
   "id": 20117,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 32,
   "firman": "Aku akan menangis karena engkau, lebih dari pada menangis karena Yaezer, hai pohon anggur Sibma! Ranting-rantingmu merambak sampai ke laut, meluas sampai ke Yaezer. Si pembinasa telah jatuh menimpa hasil musim kemaraumu dan panen buah anggurmu."
 },
 {
   "id": 20118,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 33,
   "firman": "Sukaria dan sorak-sorak telah lenyap dari kebun buah-buahan dan dari negeri Moab. Aku telah menjauhkan anggur dari tempat pemerasan; pengirik tidak ada lagi pengiriknya, pekik kegirangan tidak kedengaran lagi."
 },
 {
   "id": 20119,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 34,
   "firman": "Hesybon dan Eleale meraung-raung; orang memperdengarkan suaranya sampai ke Yahas, dari Zoar sampai Horonaim dan Eglat-Selisia; sebab air sungai Nimrim juga menjadi ketandusan."
 },
 {
   "id": 20120,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 35,
   "firman": "Firman TUHAN: Aku akan menghentikan orang di Moab mempersembahkan korban bakaran di bukit pengorbanan dan mempersembahkan korban ukupan kepada allahnya."
 },
 {
   "id": 20121,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 36,
   "firman": "Sebab itu seperti hatiku terharu mendengar suling, begitulah hatiku terharu melihat keadaan Moab, dan hatiku terharu melihat keadaan orang-orang Kir-Heres; bukankah sudah hilang segala harta yang mereka tumpuk?"
 },
 {
   "id": 20122,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 37,
   "firman": "Sungguh, setiap kepala digundul dan setiap janggut dipotong, pada semua tangan ada toreh-torehan dan kain kabung dikenakan pada semua pinggang."
 },
 {
   "id": 20123,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 38,
   "firman": "Di atas segala sotoh Moab dan di tanah-tanah lapangnya hanya ada perkabungan belaka; --sungguh, Aku telah memecahkan Moab seperti tembikar, sehingga tidak ada orang yang menyukainya, demikianlah firman TUHAN."
 },
 {
   "id": 20124,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 39,
   "firman": "Betapa terkejutnya dia! Betapa Moab menyembunyikan mukanya karena malu! Maka Moab telah menjadi tertawaan dan kekejutan bagi semua yang di sekitarnya."
 },
 {
   "id": 20125,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 40,
   "firman": "Sebab beginilah firman TUHAN: Sesungguhnya, ia datang melayang seperti burung rajawali dan mengembangkan sayapnya ke atas Moab."
 },
 {
   "id": 20126,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 41,
   "firman": "Kota-kota direbut, kubu-kubu pertahanan dirampas. Hati para pahlawan Moab pada waktu itu akan seperti hati perempuan yang sakit beranak."
 },
 {
   "id": 20127,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 42,
   "firman": "Moab akan musnah sebagai bangsa, sebab ia membesarkan diri terhadap TUHAN."
 },
 {
   "id": 20128,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 43,
   "firman": "Kejut dan pelubang dan jerat bagimu, hai penduduk Moab! demikianlah firman TUHAN."
 },
 {
   "id": 20129,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 44,
   "firman": "Yang lari dari kekejutan akan jatuh ke dalam pelubang, dan yang naik dari pelubang akan tertangkap dalam jerat. Sungguh, Aku mendatangkan semuanya ini atas Moab di tahun penghukuman atas mereka, demikianlah firman TUHAN."
 },
 {
   "id": 20130,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 45,
   "firman": "Di naungan Hesybon orang-orang pelarian berhenti, kehabisan kekuatan; tetapi api keluar dari Hesybon, nyala api dari istana Sihon, yang memakan habis pelipis Moab dan batu kepala orang-orang ribut."
 },
 {
   "id": 20131,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 46,
   "firman": "Celakalah engkau, hai Moab, binasa engkau, hai bangsa dewa Kamos! Sebab anak-anakmu lelaki telah diculik tertawan dan anak-anakmu perempuan menjadi tawanan."
 },
 {
   "id": 20132,
   "kitab": "Yer",
   "pasal": 48,
   "ayat": 47,
   "firman": "Tetapi Aku akan memulihkan keadaan Moab di kemudian hari, demikianlah firman TUHAN.\" Sampai di sinilah firman penghukuman atas Moab."
 },
 {
   "id": 20133,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 1,
   "firman": "Mengenai bani Amon. Beginilah firman TUHAN: \"Tidak adakah anak Israel, tidak adakah ahli warisnya? Mengapakah dewa Milkom memiliki Gad, dan bangsanya mendiami kota-kotanya?"
 },
 {
   "id": 20134,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 2,
   "firman": "Sebab itu, sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan memperdengarkan tempik sorak peperangan terhadap Raba bani Amon. Kota itu akan menjadi anak bukit yang tandus, dan kota-kota jajahannya akan dibakar dengan api; maka Israel akan memiliki orang-orang yang dahulu memilikinya, firman TUHAN."
 },
 {
   "id": 20135,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 3,
   "firman": "Merataplah, hai Hesybon, sebab pembinasa telah maju menyerbu, berteriaklah, hai puteri-puteri Raba, kenakanlah kain kabung, berkabunglah, berjalan kelilinglah dengan luka toreh-torehan, sebab Milkom akan pergi ke dalam pembuangan bersama-sama dengan para imam dan pemuka-pemukanya."
 },
 {
   "id": 20136,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 4,
   "firman": "Betapa engkau memegahkan dirimu dengan lembahmu, hai puteri yang congkak, yang percaya akan harta bendanya dan yang berkata: Siapakah yang berani datang menyerang aku?"
 },
 {
   "id": 20137,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 5,
   "firman": "Sesungguhnya, Aku mendatangkan kekejutan atasmu demikianlah firman Tuhan ALLAH semesta alam, dari segala tempat di sekitarmu, sehingga kamu bersorak-sorak, masing-masing ke arahnya sendiri, dan tidak ada yang mengumpulkan orang-orang yang mengembara itu."
 },
 {
   "id": 20138,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 6,
   "firman": "Tetapi sesudah itu Aku akan memulihkan keadaan bani Amon itu, demikianlah firman TUHAN.\""
 },
 {
   "id": 20139,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 7,
   "firman": "Mengenai Edom. Beginilah firman TUHAN semesta alam: \"Tidak adakah lagi kebijaksanaan di Teman? Sudah hilangkah pertimbangan dari orang-orang yang berakal budi, sudah busukkah kebijaksanaan mereka?"
 },
 {
   "id": 20140,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 8,
   "firman": "Larilah cepat, bersembunyilah dalam liang-liang, hai penduduk Dedan! Sebab malapetaka akan Kudatangkan atas Esau, pada waktu Aku menghukum dia."
 },
 {
   "id": 20141,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 9,
   "firman": "Jika pemetik buah anggur datang kepadamu, mereka tidak akan meninggalkan sisa-sisa pemetikannya! Jika malam-malam pencuri datang kepadamu, mereka akan merusakkan sepuas-puasnya!"
 },
 {
   "id": 20142,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 10,
   "firman": "Tetapi Aku ini telah menelanjangi Esau, telah menyingkapkan tempat-tempat persembunyiannya, sehingga ia tidak dapat menyembunyikan diri lagi. Keturunannya telah binasa dan saudara-saudaranya dan bangsa-bangsa tetangganya tidak ada lagi."
 },
 {
   "id": 20143,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 11,
   "firman": "Tinggalkanlah anak-anak yatimmu, aku akan menghidupi mereka; biarlah janda-jandamu menaruh kepercayaan padaku!\""
 },
 {
   "id": 20144,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 12,
   "firman": "Sebab beginilah firman TUHAN: \"Sedangkan orang-orang yang tidak selayaknya meminum isi piala itu telah terpaksa meminumnya, masakan engkau ini akan bebas dari hukuman? Engkau tidak akan bebas dari hukuman, tetapi mesti meminumnya!"
 },
 {
   "id": 20145,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 13,
   "firman": "Sebab Aku telah bersumpah demi diri-Ku, demikianlah firman TUHAN, bahwa Bozra akan menjadi ketandusan, cela, keruntuhan dan kutuk, dan segala kotanya akan menjadi reruntuhan yang kekal.\""
 },
 {
   "id": 20146,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 14,
   "firman": "Suatu kabar telah kudengar dari TUHAN, seorang utusan telah disuruh ke tengah-tengah bangsa-bangsa: \"Berkumpullah, pergilah menyerangnya, bersiaplah untuk bertempur!"
 },
 {
   "id": 20147,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 15,
   "firman": "Sebab sesungguhnya, Aku membuat engkau kecil di antara bangsa-bangsa, dihinakan di antara manusia."
 },
 {
   "id": 20148,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 16,
   "firman": "Sikapmu yang menggemetarkan orang memperdayakan engkau, dan keangkuhan hatimu, ya engkau yang tinggal di liang-liang batu, yang menduduki tempat tinggi bukit! Sekalipun engkau membuat sarangmu tinggi seperti burung rajawali, Aku akan menurunkan engkau dari sana, demikianlah firman TUHAN."
 },
 {
   "id": 20149,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 17,
   "firman": "Edom akan menjadi ketandusan; setiap orang yang melewatinya akan merasa ngeri dan bersuit karena segala pukulan yang dideritanya."
 },
 {
   "id": 20150,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 18,
   "firman": "Seperti pada waktu ditunggangbalikkannya Sodom dan Gomora dan kota-kota tetangganya--firman TUHAN--maka seorangpun tidak akan diam lagi di sana dan seorang manusiapun tidak akan tinggal lagi di dalamnya."
 },
 {
   "id": 20151,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 19,
   "firman": "Sesungguhnya, seperti singa yang bangkit keluar dari hutan belukar sungai Yordan mendatangi padang rumput tempat kawanan domba, demikianlah Aku akan membuat mereka lari dengan tiba-tiba dari negeri itu dan mengangkat di dalamnya dia yang Kupilih. Sebab siapakah yang seperti Aku? Siapakah yang berani mendakwa Aku? Siapakah gerangan gembala yang tahan menghadapi Aku?"
 },
 {
   "id": 20152,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 20,
   "firman": "Sebab itu dengarlah putusan yang telah diambil TUHAN terhadap Edom dan rancangan-rancangan yang telah dibuat-Nya terhadap penduduk Teman: Bahwa sesungguhnya, yang paling lemahpun di antara kawanan domba akan diseret. Bahwa sesungguhnya, padang rumput mereka sendiri akan merasa ngeri terhadap mereka."
 },
 {
   "id": 20153,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 21,
   "firman": "Bumi akan goncang karena bunyi jatuhnya mereka; teriakan mereka akan terdengar bunyinya di Laut Teberau."
 },
 {
   "id": 20154,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 22,
   "firman": "Sesungguhnya, ia naik terbang seperti burung rajawali, melayang dan mengembangkan sayapnya ke atas Bozra. Hati para pahlawan Edom pada waktu itu akan seperti hati perempuan yang sakit beranak.\""
 },
 {
   "id": 20155,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 23,
   "firman": "Mengenai Damsyik. \"Hamat dan Arpad telah menjadi malu, sebab mereka mendengar kabar buruk; hati mereka gemetar karena kecemasan, tidak dapat menjadi tenang."
 },
 {
   "id": 20156,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 24,
   "firman": "Damsyik telah menjadi lemah semangat, berpaling untuk lari, kegemparan telah mencekam dia, kesesakan dan sakit beranak telah menggenggam dia seperti seorang perempuan yang sedang melahirkan."
 },
 {
   "id": 20157,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 25,
   "firman": "Sungguh, kota yang terpuji itu sudah ditinggalkan, kota kegirangan itu!"
 },
 {
   "id": 20158,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 26,
   "firman": "Sebab itu teruna-terunanya akan rebah di tanah-tanah lapangnya dan semua prajuritnya akan menjadi bungkam pada waktu itu, demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 20159,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 27,
   "firman": "Aku akan menyalakan api di tembok Damsyik, yang menghanguskan puri Benhadad.\""
 },
 {
   "id": 20160,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 28,
   "firman": "Mengenai Kedar dan mengenai kerajaan-kerajaan Hazor yang dipukul kalah oleh Nebukadnezar, raja Babel. Beginilah firman TUHAN: \"Bersiaplah, majulah melawan Kedar, binasakanlah orang-orang di sebelah timur!"
 },
 {
   "id": 20161,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 29,
   "firman": "Hendaklah kemah-kemah mereka dan kawanan domba mereka dirampas sampai bersih, tenda-tenda mereka dan segala perabot mereka; hendaklah unta-unta mereka habis dibawa serta, dan hendaklah berteriak-teriak kepada mereka: Kegentaran dari segala jurusan!"
 },
 {
   "id": 20162,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 30,
   "firman": "Larilah, mengungsilah cepat-cepat, bersembunyilah dalam liang-liang, hai penduduk Hazor! demikianlah firman TUHAN. Sebab Nebukadnezar, raja Babel, telah mengambil putusan terhadap kamu dan telah membuat rancangan terhadap kamu."
 },
 {
   "id": 20163,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 31,
   "firman": "Bersiaplah, majulah melawan bangsa yang hidup sentosa, yang diam dengan aman tenteram, demikianlah firman TUHAN, dan yang tidak punya pintu gerbang atau palang, dan yang tinggal tersendiri!"
 },
 {
   "id": 20164,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 32,
   "firman": "Unta-unta mereka akan menjadi jarahan, dan ternak mereka yang banyak itu menjadi rampasan! Aku akan menyerakkan ke segala mata angin mereka yang berpotong tepi rambutnya berkeliling, dan dari segala penjuru Aku akan mendatangkan bencana atas mereka, demikianlah firman TUHAN."
 },
 {
   "id": 20165,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 33,
   "firman": "Hazor akan menjadi tempat persembunyian bagi serigala, menjadi tempat tandus sampai selama-lamanya; seorangpun tidak akan diam lagi di sana dan seorang manusiapun tidak akan tinggal lagi di dalamnya.\""
 },
 {
   "id": 20166,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 34,
   "firman": "Firman TUHAN yang datang kepada nabi Yeremia mengenai Elam, pada permulaan pemerintahan Zedekia, raja Yehuda:"
 },
 {
   "id": 20167,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 35,
   "firman": "Beginilah firman TUHAN semesta alam: \"Sesungguhnya, Aku mematahkan busur Elam, yakni inti kekuatannya."
 },
 {
   "id": 20168,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 36,
   "firman": "Aku akan mendatangkan atas Elam keempat angin dari keempat penjuru langit dan akan menyerakkan mereka ke segala mata angin ini, sehingga tidak ada bangsa yang tidak kedatangan orang-orang yang berserakan dari Elam."
 },
 {
   "id": 20169,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 37,
   "firman": "Aku akan membuat Elam terkejut di depan para musuhnya dan di depan orang-orang yang berusaha mencabut nyawanya. Aku akan mendatangkan atasnya malapetaka, yakni murka-Ku yang menyala-nyala, demikianlah firman TUHAN. Aku akan menyuruh pedang mengejar mereka sampai mereka Kuhabiskan."
 },
 {
   "id": 20170,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 38,
   "firman": "Aku akan menaruh takhta-Ku di Elam, dan Aku akan membinasakan dari sana raja dan pemuka-pemuka, demikianlah firman TUHAN."
 },
 {
   "id": 20171,
   "kitab": "Yer",
   "pasal": 49,
   "ayat": 39,
   "firman": "Tetapi di kemudian hari Aku akan memulihkan keadaan Elam, demikianlah firman TUHAN.\""
 },
 {
   "id": 20172,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 1,
   "firman": "Firman yang disampaikan TUHAN dengan perantaraan nabi Yeremia mengenai Babel, mengenai negeri orang-orang Kasdim:"
 },
 {
   "id": 20173,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 2,
   "firman": "\"Beritahukanlah di antara bangsa-bangsa dan kabarkanlah, naikkanlah panji-panji dan kabarkanlah, janganlah sembunyikan, katakanlah: Babel telah direbut, dewa Bel menjadi malu, Merodakh telah terkejut! Berhala-berhalanya menjadi malu, dewa-dewanya yang keji telah terkejut!"
 },
 {
   "id": 20174,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 3,
   "firman": "Maka suatu bangsa maju menyerangnya dari utara, membuat negerinya menjadi tempat tandus; tidak ada lagi yang diam di dalamnya, baik manusia maupun binatang, semuanya lari lenyap."
 },
 {
   "id": 20175,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 4,
   "firman": "Pada waktu itu dan pada masa itu, demikianlah firman TUHAN, orang Israel akan datang, bersama-sama dengan orang Yehuda; mereka akan berjalan sambil menangis dan mencari TUHAN, Allah mereka;"
 },
 {
   "id": 20176,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 5,
   "firman": "mereka menanyakan jalan ke Sion, ke sanalah mereka terarah: Marilah kita menggabungkan diri kepada TUHAN, bergabung dalam suatu perjanjian kekal yang tidak dapat dilupakan!"
 },
 {
   "id": 20177,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 6,
   "firman": "Umat-Ku tadinya seperti domba-domba yang hilang; mereka dibiarkan sesat oleh gembala-gembalanya, dibiarkan mengembara di gunung-gunung, mereka berjalan dari gunung ke bukit sehingga lupa akan tempat pembaringannya."
 },
 {
   "id": 20178,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 7,
   "firman": "Siapapun yang menjumpai mereka, memakan habis mereka, dan lawan-lawan mereka berkata: Kami tidak bersalah! Karena mereka telah berdosa kepada TUHAN, tempat kebenaran, TUHAN, pengharapan nenek moyang mereka!"
 },
 {
   "id": 20179,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 8,
   "firman": "Larilah dari tengah-tengah Babel, dari negeri orang-orang Kasdim! Keluarlah! Jadilah seperti kambing-kambing jantan yang mengepalai kawanannya!"
 },
 {
   "id": 20180,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 9,
   "firman": "Sebab sesungguhnya, Aku menggerakkan dan membangkitkan terhadap Babel sekumpulan bangsa-bangsa yang besar dari utara; mereka akan mengatur barisan untuk melawannya, dari sanalah kota itu akan direbut. Panah-panah mereka adalah seperti pahlawan yang mujur, yang tidak pernah kembali dengan tangan hampa."
 },
 {
   "id": 20181,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 10,
   "firman": "Negeri orang-orang Kasdim akan menjadi rampasan, semua orang yang merampasnya akan puas hatinya, demikianlah firman TUHAN."
 },
 {
   "id": 20182,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 11,
   "firman": "Sekalipun kamu bersukacita dan beria-ria, hai orang-orang yang merampok milik-Ku, sekalipun kamu melompat-lompat seperti anak lembu di padang rumput, dan meringkik seperti kuda-kuda jantan,"
 },
 {
   "id": 20183,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 12,
   "firman": "namun, ibumu sangat menanggung malu, dan perempuan yang melahirkan kamu tersipu-sipu! Lihat, dialah yang menjadi terakhir dari bangsa-bangsa: padang gurun, padang belantara dan dataran rumput!"
 },
 {
   "id": 20184,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 13,
   "firman": "Karena murka TUHAN negeri itu tidak akan didiami lagi, sama sekali akan menjadi tempat tandus. Setiap orang yang melewati Babel akan merasa ngeri dan akan bersuit karena pukulan-pukulan yang dideritanya."
 },
 {
   "id": 20185,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 14,
   "firman": "Aturlah barisanmu menyerang Babel dari segala pihak, hai semua orang pemanah! Panahlah kepadanya, janganlah merasa sayang akan anak panah, sebab kepada Tuhanlah ia berdosa!"
 },
 {
   "id": 20186,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 15,
   "firman": "Bertempiksoraklah menyerangnya dari segala pihak! Dia sudah menyerah, tonggak-tonggaknya sudah rebah, pagar-pagarnya sudah runtuh! Sungguh, itulah pembalasan TUHAN! Laksanakanlah pembalasan terhadapnya, lakukanlah kepadanya seperti yang dilakukannya sendiri!"
 },
 {
   "id": 20187,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 16,
   "firman": "Lenyapkanlah orang penabur dari Babel dan orang penyabit pada musim menuai! Untuk mengelakkan pedang yang dahsyat ini, setiap orang akan berpaling pulang kepada bangsanya, setiap orang akan lari ke negerinya."
 },
 {
   "id": 20188,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 17,
   "firman": "Israel adalah seperti domba yang diceraiberaikan, dihalaukan oleh singa-singa. Mula-mula raja Asyur memakan dia, dan sekarang pada akhirnya Nebukadnezar, raja Babel, mengerumit tulang-tulangnya."
 },
 {
   "id": 20189,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 18,
   "firman": "Sebab itu beginilah firman TUHAN semesta alam, Allah Israel: Sesungguhnya, Aku menghukum raja Babel dan negerinya, seperti Aku telah menghukum raja Asyur."
 },
 {
   "id": 20190,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 19,
   "firman": "Tetapi Aku akan mengembalikan Israel ke padang rumputnya, supaya ia makan rumput di atas Karmel dan di Basan, dan menjadi kenyang di atas pegunungan Efraim dan di Gilead."
 },
 {
   "id": 20191,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 20,
   "firman": "Pada waktu itu dan pada masa itu, demikianlah firman TUHAN, orang akan mencari kesalahan Israel, tetapi tidak didapatnya, dan dosa Yehuda, tetapi tidak ada ditemukannya, sebab Aku akan mengampuni orang-orang yang Kubiarkan tinggal hidup."
 },
 {
   "id": 20192,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 21,
   "firman": "Majulah ke negeri Merataim, majulah menyerangnya dan menyerang penduduk Pekod! Bunuhlah dan tumpaslah mereka, demikianlah firman TUHAN, lakukanlah tepat seperti yang Kuperintahkan!"
 },
 {
   "id": 20193,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 22,
   "firman": "Gemuruh perang di negeri dan terjadilah kehancuran besar!"
 },
 {
   "id": 20194,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 23,
   "firman": "Betapa remuk redamnya dan hancur luluhnya martil seluruh bumi itu! Betapa Babel menjadi kengerian di antara bangsa-bangsa!"
 },
 {
   "id": 20195,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 24,
   "firman": "Aku memasang jerat bagimu, dan memang engkau terjebak, hai Babel, dengan tidak mengetahuinya. Engkau terdapat dan memang engkau tertangkap, sebab engkau telah menantang TUHAN."
 },
 {
   "id": 20196,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 25,
   "firman": "TUHAN telah membuka tempat perlengkapan-Nya dan mengeluarkan senjata-senjata geram-Nya, sebab ada pekerjaan bagi Tuhan ALLAH semesta alam di negeri orang-orang Kasdim:"
 },
 {
   "id": 20197,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 26,
   "firman": "Marilah mendatanginya dari segala jurusan, bukalah lumbung-lumbungnya, onggokkanlah isinya bertimbun-timbun dan tumpaslah itu, janganlah ada tinggal sisanya!"
 },
 {
   "id": 20198,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 27,
   "firman": "Bunuhlah segala lembunya, biarlah rebah semuanya untuk dibantai! Celakalah mereka, sebab waktunya sudah tiba, saat penghukuman atas mereka!"
 },
 {
   "id": 20199,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 28,
   "firman": "Dengar! Pelarian-pelarian dan orang-orang yang terluput dari negeri Babel datang memberitahukan di Sion tentang pembalasan TUHAN, Allah kita, pembalasan karena bait suci-Nya."
 },
 {
   "id": 20200,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 29,
   "firman": "Kerahkanlah penembak-penembak melawan Babel, semua orang pemanah! Berkemahlah mengepungnya, supaya jangan ada yang lolos! Balaslah dia setimpal dengan perbuatannya, lakukanlah kepadanya tepat seperti yang dilakukannya sendiri! Sebab ia bertindak kurang ajar terhadap TUHAN, terhadap Yang Mahakudus, Allah Israel."
 },
 {
   "id": 20201,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 30,
   "firman": "Sebab itu teruna-terunanya akan rebah di tanah-tanah lapangnya, dan semua prajuritnya akan menjadi bungkam pada waktu itu, demikianlah firman TUHAN."
 },
 {
   "id": 20202,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 31,
   "firman": "Sesungguhnya, Aku menjadi lawanmu, hai engkau yang kurang ajar, demikianlah firman Tuhan ALLAH semesta alam, sebab waktumu sudah tiba, saat Aku menghukum engkau."
 },
 {
   "id": 20203,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 32,
   "firman": "Si kurang ajar itu akan tersandung jatuh dan tidak ada yang membangkitkan dia. Di kota-kotanya Aku akan menyalakan api yang akan menghanguskan segala apa yang di sekitarnya."
 },
 {
   "id": 20204,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 33,
   "firman": "Beginilah firman TUHAN semesta alam: Orang Israel tertindas bersama-sama dengan orang Yehuda. Semua orang yang menawan mereka tetap menahan mereka, tidak mau melepaskan mereka."
 },
 {
   "id": 20205,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 34,
   "firman": "Tetapi Penebus mereka adalah kuat; TUHAN semesta alam nama-Nya. Tentulah Ia akan memperjuangkan perkara mereka, supaya Ia memberi ketenteraman kepada bumi, tetapi kegemparan kepada penduduk Babel."
 },
 {
   "id": 20206,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 35,
   "firman": "Pedang akan menimpa orang-orang Kasdim, demikianlah firman TUHAN, menimpa penduduk Babel, menimpa pemuka-pemukanya dan orang-orangnya yang berhikmat!"
 },
 {
   "id": 20207,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 36,
   "firman": "Pedang menimpa tukang-tukang ramal, sehingga ternyata mereka bodoh! Pedang menimpa pahlawan-pahlawannya, sehingga mereka menjadi terkejut!"
 },
 {
   "id": 20208,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 37,
   "firman": "Pedang menimpa kudanya dan keretanya, menimpa segenap tentara campuran yang di tengah-tengahnya, sehingga mereka menjadi seperti perempuan! Pedang menimpa perbendaharaannya, sehingga dijarah orang!"
 },
 {
   "id": 20209,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 38,
   "firman": "Pedang menimpa segala airnya, sehingga menjadi kering! Sebab negeri itu penuh patung-patung, mereka menjadi gila oleh berhala-berhala mereka!"
 },
 {
   "id": 20210,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 39,
   "firman": "Sebab itu binatang-binatang gurun serta anjing-anjing hutan akan diam di sana, juga burung-burung unta akan tinggal di dalamnya. Negeri itu tidak akan didiami lagi untuk seterusnya dan tidak akan ditinggali lagi turun-temurun."
 },
 {
   "id": 20211,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 40,
   "firman": "Seperti dahulu pada waktu Allah menunggangbalikkan Sodom dan Gomora serta kota-kota tetangganya, demikianlah firman TUHAN, demikianlah tidak akan ada orang lagi yang diam di sana dan seorang anak manusiapun tidak akan tinggal lagi di dalamnya."
 },
 {
   "id": 20212,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 41,
   "firman": "Lihatlah, suatu bangsa akan datang dari utara, suatu suku bangsa yang besar, dan banyak raja, akan bergerak maju dari ujung bumi."
 },
 {
   "id": 20213,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 42,
   "firman": "Mereka memakai panah dan tombak; mereka bengis, tidak kenal belas kasihan. Suara mereka gemuruh seperti laut, mereka mengendarai kuda, berlengkap seperti orang maju berperang, menyerang engkau, hai puteri Babel!"
 },
 {
   "id": 20214,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 43,
   "firman": "Raja Babel telah mendengar kabar tentang mereka, tangannya sudah menjadi lemah lesu, kesesakan telah menyergap dia, ia kesakitan seperti perempuan yang melahirkan."
 },
 {
   "id": 20215,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 44,
   "firman": "Sesungguhnya, seperti singa yang bangkit keluar dari hutan belukar sungai Yordan mendatangi padang rumput tempat kawanan domba, demikianlah Aku akan membuat mereka lari dengan tiba-tiba dari negeri itu dan mengangkat di atasnya dia yang Kupilih. Sebab siapakah yang seperti Aku? Siapakah yang berani mendakwa Aku? Siapakah gerangan gembala yang tahan menghadapi Aku?"
 },
 {
   "id": 20216,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 45,
   "firman": "Sebab itu dengarlah putusan yang telah diambil TUHAN terhadap Babel dan rancangan-rancangan yang telah dibuat-Nya terhadap negeri orang-orang Kasdim: Bahwa sesungguhnya, yang paling lemahpun di antara kawanan domba akan diseret. Bahwa sesungguhnya, padang rumput mereka sendiri akan merasa ngeri terhadap mereka."
 },
 {
   "id": 20217,
   "kitab": "Yer",
   "pasal": 50,
   "ayat": 46,
   "firman": "Bumi akan goncang karena kabar: Babel sudah direbut; ratap mereka akan terdengar di antara bangsa-bangsa!\""
 },
 {
   "id": 20218,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: \"Sesungguhnya, Aku menggerakkan terhadap Babel, terhadap penduduk negeri orang-orang Kasdim, suatu semangat pemusnah."
 },
 {
   "id": 20219,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 2,
   "firman": "Aku akan mengirim ke Babel penampi-penampi yang akan menampinya dan yang akan menyapu bersih negerinya, sebab mereka mengepungnya dari segala pihak pada hari malapetaka."
 },
 {
   "id": 20220,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 3,
   "firman": "Hendaklah si pemanah membidikkan panahnya kepada orang yang membidik dan kepada orang yang berbaju zirah! Janganlah merasa sayang akan teruna-terunanya, tumpaslah segala tentaranya!"
 },
 {
   "id": 20221,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 4,
   "firman": "Orang-orang yang terbunuh akan rebah di negeri orang-orang Kasdim dan orang-orang yang luka parah di jalan-jalannya--"
 },
 {
   "id": 20222,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 5,
   "firman": "sungguh, Israel dan Yehuda tidak ditinggalkan sebagai janda oleh Allahnya, oleh TUHAN semesta alam--sebab negeri orang Kasdim penuh dengan kesalahan terhadap Yang Mahakudus, Allah Israel."
 },
 {
   "id": 20223,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 6,
   "firman": "Larilah dari tengah-tengah Babel, hendaklah setiap orang menyelamatkan nyawanya, supaya kamu jangan tertumpas karena kesalahannya! Sebab inilah waktu pembalasan bagi TUHAN; Ia membayar ganjaran kepadanya."
 },
 {
   "id": 20224,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 7,
   "firman": "Babel tadinya seperti piala emas di tangan TUHAN yang memabukkan seluruh bumi. Bangsa-bangsa minum dari anggurnya, itulah sebabnya bangsa-bangsa menjadi gila."
 },
 {
   "id": 20225,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 8,
   "firman": "Tiba-tiba Babel jatuh dan pecah, ratapilah dia! Ambillah balsam untuk lukanya, mungkin ia menjadi sembuh!"
 },
 {
   "id": 20226,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 9,
   "firman": "Kami tadinya mau menyembuhkan Babel, tetapi ia tidak dapat disembuhkan; tinggalkanlah dia, marilah kita pulang masing-masing ke negerinya! Sungguh, penghukumannya sudah sampai ke langit, sudah menjangkau awan-awan!"
 },
 {
   "id": 20227,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 10,
   "firman": "TUHAN telah membuat segala kebenaran kita menjadi nyata; marilah kita ceritakan di Sion perbuatan TUHAN, Allah kita!"
 },
 {
   "id": 20228,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 11,
   "firman": "Lancipkanlah anak-anak panah, siapkanlah perisai-perisai! TUHAN telah membangkitkan semangat raja-raja Media, sebab rencana-Nya terhadap Babel ialah untuk memusnahkannya: itulah pembalasan TUHAN, pembalasan karena bait suci-Nya!"
 },
 {
   "id": 20229,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 12,
   "firman": "Angkatlah panji-panji terhadap tembok-tembok Babel, perkuatlah penjagaan! Tempatkanlah orang-orang jaga, persiapkanlah penghadangan! Sebab TUHAN telah merencanakan dan melaksanakan juga apa yang diancamkan-Nya terhadap penduduk Babel."
 },
 {
   "id": 20230,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 13,
   "firman": "Hai engkau yang tinggal di tepi sungai besar, yang mempunyai kekayaan besar, akhir hidupmu sudah datang, batas hidupmu sudah sampai!"
 },
 {
   "id": 20231,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 14,
   "firman": "TUHAN semesta alam telah bersumpah demi diri-Nya sendiri: Sungguhpun engkau penuh dengan manusia-manusia seperti belalang, tetapi orang akan mengangkat pekik pertempuran terhadapmu."
 },
 {
   "id": 20232,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 15,
   "firman": "Tuhanlah yang menjadikan bumi dengan kekuatan-Nya, yang menegakkan dunia dengan kebijaksanaan-Nya, dan yang membentangkan langit dengan akal budi-Nya."
 },
 {
   "id": 20233,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 16,
   "firman": "Apabila Ia memperdengarkan suara-Nya, menderulah bunyi air di langit, Ia menaikkan kabut awan dari ujung bumi, Ia membuat kilat serta dengan hujan, dan mengeluarkan angin dari perbendaharaan-Nya."
 },
 {
   "id": 20234,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 17,
   "firman": "Setiap manusia ternyata bodoh, tidak berpengetahuan, dan setiap pandai emas akan menjadi malu karena patung buatannya. Sebab patung tuangannya itu adalah tipu, tidak ada nyawa di dalamnya,"
 },
 {
   "id": 20235,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 18,
   "firman": "semuanya adalah kesia-siaan, pekerjaan yang menjadi buah ejekan, dan yang akan binasa pada waktu dihukum."
 },
 {
   "id": 20236,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 19,
   "firman": "Tidaklah begitu Dia yang menjadi bagian Yakub, sebab Dialah yang membentuk segala-galanya, dan Israel adalah suku milik-Nya; nama-Nya ialah TUHAN semesta alam!"
 },
 {
   "id": 20237,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 20,
   "firman": "Engkau tadinya adalah palu godam bagi-Ku, senjata perang: Dengan engkau Aku menghancurkan bangsa-bangsa, dengan engkau Aku memusnahkan kerajaan-kerajaan,"
 },
 {
   "id": 20238,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 21,
   "firman": "dengan engkau Aku menghancurkan kuda dan pengendaranya, dengan engkau Aku menghancurkan kereta dan penunggangnya,"
 },
 {
   "id": 20239,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 22,
   "firman": "dengan engkau Aku menghancurkan orang laki-laki dan perempuan, dengan engkau Aku menghancurkan orang tua dan muda, dengan engkau Aku menghancurkan teruna dan dara,"
 },
 {
   "id": 20240,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 23,
   "firman": "dengan engkau Aku menghancurkan gembala dan kawanan dombanya, dengan engkau Aku menghancurkan petani dan lembu pembajaknya, dengan engkau Aku menghancurkan bupati-bupati dan pembesar-pembesar!"
 },
 {
   "id": 20241,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 24,
   "firman": "Namun Aku akan membalaskan kepada Babel dan kepada segenap penduduk negeri orang Kasdim segala kejahatan yang telah mereka lakukan terhadap Sion, di depan matamu sendiri, demikianlah firman TUHAN."
 },
 {
   "id": 20242,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 25,
   "firman": "Sesungguhnya, Aku menjadi lawanmu, hai gunung pemusnah, demikianlah firman TUHAN, yang memusnahkan seluruh bumi! Aku akan mengacungkan tangan-Ku kepadamu, menggulingkan engkau dari bukit batu, dan membuat engkau menjadi gunung api yang telah padam."
 },
 {
   "id": 20243,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 26,
   "firman": "Orang tidak akan mengambil batu penjuru atau batu dasar dari padamu, tetapi engkau akan menjadi tempat tandus yang kekal, demikianlah firman TUHAN."
 },
 {
   "id": 20244,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 27,
   "firman": "Angkatlah panji-panji di bumi, tiuplah sangkakala di antara bangsa-bangsa, persiapkanlah bangsa-bangsa berperang melawan Babel, kerahkanlah kerajaan-kerajaan melawannya--Ararat, Mini dan Askenas--angkatlah seorang panglima melawannya, tampilkanlah kuda seperti kawanan belalang!"
 },
 {
   "id": 20245,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 28,
   "firman": "Persiapkanlah bangsa-bangsa berperang melawannya, raja-raja Media beserta bupati-bupati dan pembesar-pembesarnya, dan setiap negeri yang di bawah kuasanya!"
 },
 {
   "id": 20246,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 29,
   "firman": "Bumi berguncang dan bergetar, sebab rancangan TUHAN terhadap Babel sedang terlaksana, yakni untuk membuat negeri Babel menjadi tempat tandus yang tidak berpenduduk."
 },
 {
   "id": 20247,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 30,
   "firman": "Pahlawan-pahlawan Babel telah berhenti berperang, mereka tinggal duduk di kubu-kubu pertahanan, kegagahberanian mereka sudah lenyap, mereka sudah menjadi seperti perempuan. Tempat-tempat tinggalnya sudah terbakar, palang-palang pintunya sudah patah!"
 },
 {
   "id": 20248,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 31,
   "firman": "Pesuruh-pesuruh cepat berlari susul-menyusul, pembawa-pembawa kabar susul-menyusul, untuk mengabarkan kepada raja Babel, bahwa kotanya telah direbut dari segala penjuru,"
 },
 {
   "id": 20249,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 32,
   "firman": "tempat-tempat penyeberangan telah diduduki, benteng-benteng pertahanan telah dihanguskan dengan api, prajurit-prajurit telah menjadi gempar."
 },
 {
   "id": 20250,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 33,
   "firman": "Sebab beginilah firman TUHAN semesta alam, Allah Israel: Puteri Babel adalah seperti tempat pengirikan pada waktu orang menginjak-injaknya! Sedikit waktu lagi akan datang waktu panen baginya."
 },
 {
   "id": 20251,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 34,
   "firman": "Aku dimakan habis, dihamburkan oleh Nebukadnezar, raja Babel, diletakkan seperti mangkuk yang kosong. Ia menelan aku seperti ular naga, ia memenuhi perutnya dengan pengananku yang enak-enak, ia membuangkan aku."
 },
 {
   "id": 20252,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 35,
   "firman": "Biarlah penggagahan dan penghancuran atasku tertimpa kepada Babel, begitulah hendaknya berkata penduduk Sion, biarlah darahku tertimpa kepada penduduk negeri orang Kasdim, begitulah hendaknya berkata Yerusalem."
 },
 {
   "id": 20253,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 36,
   "firman": "Sebab itu beginilah firman TUHAN: Sesungguhnya, Aku akan memperjuangkan perkaramu, dan akan melakukan pembalasan untukmu: Aku akan mengeringkan lautnya dan akan menggersangkan sumber airnya;"
 },
 {
   "id": 20254,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 37,
   "firman": "Babel akan menjadi timbunan puing, tempat persembunyian serigala-serigala tempat kengerian dan suitan, tanpa penduduk."
 },
 {
   "id": 20255,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 38,
   "firman": "Bersama-sama mereka mengaum seperti singa-singa muda, menggeram seperti anak-anak singa;"
 },
 {
   "id": 20256,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 39,
   "firman": "jika mereka merasa panas, Aku akan menyediakan perjamuan bagi mereka, akan membuat mereka mabuk, supaya mereka menjadi pusing dan jatuh tertidur untuk selama-lamanya, tidak akan bangun-bangun lagi, demikianlah firman TUHAN."
 },
 {
   "id": 20257,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 40,
   "firman": "Aku akan merebahkan mereka untuk dibantai seperti anak-anak kambing, seperti domba-domba jantan dan kambing-kambing jantan."
 },
 {
   "id": 20258,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 41,
   "firman": "Betapa Sesakh direbut, dan negeri pujian seluruh bumi diduduki! Betapa Babel menjadi kengerian di antara bangsa-bangsa!"
 },
 {
   "id": 20259,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 42,
   "firman": "Laut telah naik meliputi Babel, gelombang-gelombangnya yang menderu telah melingkupinya."
 },
 {
   "id": 20260,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 43,
   "firman": "Kota-kotanya sudah menjadi tempat tandus, menjadi negeri yang kering dan padang belantara, negeri yang tidak didiami oleh seorangpun dan yang tidak dilewati oleh seorang manusiapun."
 },
 {
   "id": 20261,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 44,
   "firman": "Aku akan menghukum dewa Bel di Babel, dan akan mengeluarkan dari mulutnya apa yang ditelannya. Bangsa-bangsa tidak akan datang lagi mengalir kepadanya, tembok Babelpun sudah runtuh."
 },
 {
   "id": 20262,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 45,
   "firman": "Keluarlah dari tengah-tengahnya, hai umat-Ku! Hendaklah setiap orang menyelamatkan nyawanya dari murka TUHAN yang menyala-nyala itu!"
 },
 {
   "id": 20263,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 46,
   "firman": "Biarlah hatimu jangan kecut dan takut karena kabar yang terdengar di negeri: apabila tahun ini datang kabar ini, dan tahun kemudian kabar itu, apabila kekerasan merajalela di negeri dan penguasa lalim melawan penguasa lalim."
 },
 {
   "id": 20264,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 47,
   "firman": "Sebab itu sesungguhnya, waktunya akan datang, bahwa Aku akan menghukum patung-patung Babel; seluruh negerinya akan menjadi malu dan semua orangnya yang terbunuh akan rebah di tengah-tengahnya."
 },
 {
   "id": 20265,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 48,
   "firman": "Maka langit dan bumi serta segala apa yang ada di dalamnya akan bersorak-sorai tentang Babel, apabila dari utara datang kepadanya para perusak itu, demikianlah firman TUHAN."
 },
 {
   "id": 20266,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 49,
   "firman": "Babel akan jatuh oleh karena orang-orang yang mati terbunuh di antara Israel sama seperti jatuhnya orang-orang yang mati terbunuh di seluruh bumi oleh karena Babel."
 },
 {
   "id": 20267,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 50,
   "firman": "Kamu, orang-orang yang terluput dari pedang, pergilah, janganlah berhenti! Ingatlah dari jauh kepada TUHAN dan biarlah Yerusalem timbul lagi dalam hatimu:"
 },
 {
   "id": 20268,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 51,
   "firman": "Kami malu, sebab kami telah mendengar tentang aib, noda meliputi muka kami, sebab orang-orang asing telah memasuki tempat-tempat kudus di rumah TUHAN."
 },
 {
   "id": 20269,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 52,
   "firman": "Sebab itu sesungguhnya, waktunya akan datang, demikianlah firman TUHAN, bahwa Aku akan menghukum patung-patungnya, dan di seluruh negerinya akan mengerang orang-orang yang luka tertikam."
 },
 {
   "id": 20270,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 53,
   "firman": "Sekalipun Babel naik ke langit dan sekalipun dibuatnya kubu tak terhampiri di tempat tingginya, atas perintah-Ku akan datang para perusak kepadanya, demikianlah firman TUHAN."
 },
 {
   "id": 20271,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 54,
   "firman": "Dengar! Ratap dari Babel dan kehancuran besar dari negeri orang Kasdim!"
 },
 {
   "id": 20272,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 55,
   "firman": "Sebab TUHAN merusakkan Babel dan menghentikan suaranya yang besar. Biarpun gelombang-gelombangnya menderu seperti air besar dan suaranya bertambah ribut,"
 },
 {
   "id": 20273,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 56,
   "firman": "namun atas Babel akan datang perusak, para pahlawannya akan tertangkap dan busur-busurnya akan hancur, sebab TUHAN adalah Allah pembalas, tentulah Ia akan mengadakan pembalasan!"
 },
 {
   "id": 20274,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 57,
   "firman": "Aku akan membuat mabuk para pemukanya, orang-orang bijaksananya, para bupatinya, para pembesarnya dan para pahlawannya, sehingga mereka jatuh tertidur untuk selama-lamanya, tidak akan bangun-bangun lagi, demikianlah firman Sang Raja yang TUHAN semesta alam nama-Nya."
 },
 {
   "id": 20275,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 58,
   "firman": "Beginilah firman TUHAN semesta alam: Tembok-tembok tebal Babel akan disamaratakan, dan pintu-pintu gerbangnya yang tinggi akan dibakar dengan api, sehingga bangsa-bangsa bersusah-susah untuk yang sia-sia dan suku-suku bangsa berlelah untuk api saja.\""
 },
 {
   "id": 20276,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 59,
   "firman": "Pesan yang diberikan nabi Yeremia kepada Seraya bin Neria bin Mahseya, ketika Seraya pergi bersama-sama Zedekia, raja Yehuda, ke Babel pada tahun yang keempat dari pemerintahannya--Seraya waktu itu adalah kepala perlengkapan."
 },
 {
   "id": 20277,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 60,
   "firman": "Yeremia telah menuliskan dalam sebuah kitab segenap malapetaka yang akan menimpa Babel, yakni segala perkataan yang tertulis di sini mengenai Babel. --"
 },
 {
   "id": 20278,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 61,
   "firman": "Kata Yeremia kepada Seraya: \"Jika engkau tiba di Babel, maka ikhtiarkanlah, supaya engkau dapat membacakan segala perkataan ini,"
 },
 {
   "id": 20279,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 62,
   "firman": "dan katakanlah: TUHAN, Engkau telah berfirman tentang kota ini bahwa Engkau akan melenyapkannya, sehingga tidak ada lagi yang diam di dalamnya, baik manusia maupun hewan, dan sehingga kota ini akan menjadi tempat tandus untuk selama-lamanya!"
 },
 {
   "id": 20280,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 63,
   "firman": "Apabila engkau selesai membacakan kitab ini, maka ikatkanlah sebuah batu kepadanya, lalu lemparkanlah ia ke tengah-tengah sungai Efrat"
 },
 {
   "id": 20281,
   "kitab": "Yer",
   "pasal": 51,
   "ayat": 64,
   "firman": "sambil berkata: Beginilah Babel akan tenggelam, dan tidak akan timbul-timbul lagi, oleh karena malapetaka yang Kudatangkan atasnya.\" Sampai di sinilah perkataan-perkataan Yeremia."
 },
 {
   "id": 20282,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 1,
   "firman": "Zedekia berumur dua puluh satu tahun pada waktu ia menjadi raja dan sebelas tahun lamanya ia memerintah di Yerusalem. Nama ibunya ialah Hamutal binti Yeremia, dari Libna."
 },
 {
   "id": 20283,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 2,
   "firman": "Ia melakukan apa yang jahat di mata TUHAN tepat seperti yang telah dilakukan Yoyakim."
 },
 {
   "id": 20284,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 3,
   "firman": "Sebab oleh karena murka Tuhanlah hal itu terjadi terhadap Yerusalem dan Yehuda, yakni bahwa Ia sampai membuang mereka dari hadapan-Nya. Zedekia memberontak terhadap raja Babel."
 },
 {
   "id": 20285,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 4,
   "firman": "Maka pada tahun kesembilan dari pemerintahannya, dalam bulan yang kesepuluh, pada tanggal sepuluh bulan itu, datanglah Nebukadnezar, raja Babel, dengan segala tentaranya menyerang Yerusalem. Berkemahlah mereka mengepungnya dan didirikan merekalah tembok pengepungan sekelilingnya."
 },
 {
   "id": 20286,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 5,
   "firman": "Demikianlah kota itu terkepung sampai tahun yang kesebelas pemerintahan raja Zedekia."
 },
 {
   "id": 20287,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 6,
   "firman": "Pada tanggal sembilan bulan yang keempat, ketika kelaparan sudah merajalela di kota itu dan tidak ada lagi makanan pada rakyat negeri itu,"
 },
 {
   "id": 20288,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 7,
   "firman": "maka dibelah oranglah tembok kota itu. Melihat hal itu maka melarikan dirilah raja dengan semua tentara, meninggalkan kota itu pada waktu malam melalui pintu gerbang antara kedua tembok yang ada di dekat taman raja, sekalipun orang Kasdim mengepung kota itu sekeliling. Mereka lari menuju ke Araba-Yordan."
 },
 {
   "id": 20289,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 8,
   "firman": "Tetapi tentara Kasdim itu mengejar raja dari belakang dan mencapai Zedekia di dataran Yerikho; segala tentaranya telah berserak-serak meninggalkan dia."
 },
 {
   "id": 20290,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 9,
   "firman": "Mereka menangkap raja dan membawa dia ke Ribla di tanah Hamat, kepada raja Babel, yang menjatuhkan hukuman atas dia."
 },
 {
   "id": 20291,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 10,
   "firman": "Raja Babel menyuruh menyembelih anak-anak Zedekia di depan matanya; juga semua pemuka Yehuda disembelihnya di Ribla."
 },
 {
   "id": 20292,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 11,
   "firman": "Kemudian mata Zedekia dibutakannya, lalu ia dibelenggu dengan rantai tembaga. Kemudian raja Babel membawa dia ke Babel dan menaruhnya dalam rumah hukuman sampai kepada hari matinya."
 },
 {
   "id": 20293,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 12,
   "firman": "Dalam bulan yang kelima, pada tanggal sepuluh bulan itu--itulah tahun kesembilan belas pemerintahan Nebukadnezar, raja Babel--datanglah Nebuzaradan, kepala pasukan pengawal, yang melayani raja Babel, ke Yerusalem."
 },
 {
   "id": 20294,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 13,
   "firman": "Ia membakar rumah TUHAN, rumah raja dan segala rumah di Yerusalem; segala rumah orang-orang besar dibakarnya dengan api."
 },
 {
   "id": 20295,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 14,
   "firman": "Segala tembok sekeliling kota Yerusalem dirobohkan oleh tentara Kasdim yang ada bersama-sama dengan kepala pasukan pengawal itu."
 },
 {
   "id": 20296,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 15,
   "firman": "Sebagian dari orang-orang yang paling lemah dan sisa-sisa rakyat yang masih tinggal di kota itu dan pembelot-pembelot yang menyeberang ke pihak raja Babel dan sisa-sisa para pekerja tangan diangkut ke dalam pembuangan oleh Nebuzaradan, kepala pasukan pengawal itu."
 },
 {
   "id": 20297,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 16,
   "firman": "Hanya beberapa orang miskin dari negeri itu ditinggalkan oleh Nebuzaradan, kepala pasukan pengawal itu, untuk menjadi tukang-tukang kebun anggur dan peladang-peladang."
 },
 {
   "id": 20298,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 17,
   "firman": "Juga tiang-tiang tembaga yang ada di rumah TUHAN dan kereta penopang dan laut tembaga yang ada di rumah TUHAN dipecahkan oleh orang Kasdim dan seluruh tembaganya diangkut mereka ke Babel."
 },
 {
   "id": 20299,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 18,
   "firman": "Kuali-kuali, penyodok-penyodok, pisau-pisau, bokor-bokor penyiraman dan cawan-cawan dan segala perkakas tembaga yang dipakai untuk menyelenggarakan kebaktian diambil mereka,"
 },
 {
   "id": 20300,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 19,
   "firman": "juga pasu-pasu, perbaraan-perbaraan, bokor-bokor penyiraman, kuali-kuali, kandil-kandil, cawan-cawan dan piala-piala, baik segala yang dari emas maupun segala yang dari perak, diambil oleh kepala pasukan pengawal itu."
 },
 {
   "id": 20301,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 20,
   "firman": "Adapun kedua tiang, laut yang satu itu dan kedua belas lembu tembaga yang ada di bawah kereta penopang, yang dibuat oleh raja Salomo untuk rumah TUHAN, tiada tertimbang tembaga segala perkakas ini."
 },
 {
   "id": 20302,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 21,
   "firman": "Adapun tiang-tiang itu, satu tiang delapan belas hasta tingginya dan dapat dililit oleh tali yang dua belas hasta panjangnya; tebalnya empat jari dan geronggang dari dalam."
 },
 {
   "id": 20303,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 22,
   "firman": "Di atasnya ada ganja dari tembaga; tinggi ganja yang satu itu lima hasta, dan jala-jala dan buah-buah delima ada di atas ganja itu sekeliling, semuanya dari tembaga. Dan tiang yang kedua seperti itu juga. Mengenai buah delima,"
 },
 {
   "id": 20304,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 23,
   "firman": "ada sembilan puluh enam buah delima yang merupakan gambar timbul; seluruhnya buah-buah delima itu ada seratus pada jala-jala itu berkeliling."
 },
 {
   "id": 20305,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 24,
   "firman": "Lalu kepala pasukan pengawal itu menangkap Seraya, imam kepala, dan Zefanya, imam tingkat dua, dan ketiga orang penjaga pintu."
 },
 {
   "id": 20306,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 25,
   "firman": "Dari kota itu ditangkapnya seorang pegawai istana yang diangkat mengepalai prajurit-prajurit dan tujuh orang pelayan pribadi raja yang terdapat di kota itu, dan panitera panglima tentara yang mengerahkan rakyat negeri menjadi tentara, dan enam puluh orang dari rakyat negeri yang terdapat di tengah-tengah kota itu."
 },
 {
   "id": 20307,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 26,
   "firman": "Nebuzaradan, kepala pasukan pengawal, menangkap mereka dan membawa mereka kepada raja Babel, di Ribla."
 },
 {
   "id": 20308,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 27,
   "firman": "Lalu raja Babel menyuruh membunuh mereka di Ribla, di tanah Hamat. Demikianlah orang Yehuda diangkut ke dalam pembuangan dari tanahnya."
 },
 {
   "id": 20309,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 28,
   "firman": "Inilah jumlah rakyat yang diangkut ke dalam pembuangan oleh Nebuzaradan: dalam tahun ketujuh, tiga ribu dua puluh tiga orang Yehuda;"
 },
 {
   "id": 20310,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 29,
   "firman": "dalam tahun kedelapan belas zaman Nebukadnezar, delapan ratus tiga puluh dua jiwa dari Yerusalem;"
 },
 {
   "id": 20311,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 30,
   "firman": "dalam tahun kedua puluh tiga zaman Nebukadnezar, diangkut ke dalam pembuangan oleh Nebuzaradan, kepala pasukan pengawal, tujuh ratus empat puluh lima jiwa orang Yehuda; seluruhnya berjumlah empat ribu enam ratus jiwa."
 },
 {
   "id": 20312,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 31,
   "firman": "Kemudian dalam tahun ketiga puluh tujuh sesudah Yoyakhin, raja Yehuda, dibuang, dalam bulan yang kedua belas, pada tanggal dua puluh lima bulan itu, maka Ewil-Merodakh, raja Babel, dalam tahun ia menjadi raja, menunjukkan belas kasihannya kepada Yoyakhin, raja Yehuda, dengan melepaskannya dari penjara."
 },
 {
   "id": 20313,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 32,
   "firman": "Ewil-Merodakh berbicara baik-baik dengan dia dan memberikan kedudukan kepadanya lebih tinggi dari pada kedudukan raja-raja yang bersama-sama dengan dia di Babel."
 },
 {
   "id": 20314,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 33,
   "firman": "Yoyakhin boleh mengganti pakaian penjaranya dan boleh selalu makan roti di hadapan raja selama hidupnya."
 },
 {
   "id": 20315,
   "kitab": "Yer",
   "pasal": 52,
   "ayat": 34,
   "firman": "Dan tentang belanjanya, raja Babel selalu memberikannya kepadanya, sekadar yang perlu tiap-tiap hari, selama hidupnya, sampai hari matinya."
 },
 {
   "id": 20316,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ah, betapa terpencilnya kota itu, yang dahulu ramai! Laksana seorang jandalah ia, yang dahulu agung di antara bangsa-bangsa. Yang dahulu ratu di antara kota-kota, sekarang menjadi jajahan."
 },
 {
   "id": 20317,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 2,
   "firman": "Pada malam hari tersedu-sedu ia menangis, air matanya bercucuran di pipi; dari semua kekasihnya, tak ada seorangpun yang menghibur dia. Semua temannya mengkhianatinya, mereka menjadi seterunya."
 },
 {
   "id": 20318,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 3,
   "firman": "Yehuda telah ditinggalkan penduduknya karena sengsara dan karena perbudakan yang berat; ia tinggal di tengah-tengah bangsa-bangsa, namun tidak mendapat ketenteraman; siapa saja yang menyerang dapat memasukinya pada saat ia terdesak."
 },
 {
   "id": 20319,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 4,
   "firman": "Jalan-jalan ke Sion diliputi dukacita, karena pengunjung-pengunjung perayaan tiada; sunyi senyaplah segala pintu gerbangnya, berkeluh kesahlah imam-imamnya; bersedih pedih dara-daranya; dan dia sendiri pilu hatinya."
 },
 {
   "id": 20320,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lawan-lawan menguasainya, seteru-seterunya berbahagia. Sungguh, TUHAN membuatnya merana, karena banyak pelanggarannya; kanak-kanaknya berjalan di depan lawan sebagai tawanan."
 },
 {
   "id": 20321,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 6,
   "firman": "Lenyaplah dari puteri Sion segala kemuliaannya; pemimpin-pemimpinnya bagaikan rusa yang tidak menemukan padang rumput; mereka berjalan tanpa daya di depan yang mengejarnya."
 },
 {
   "id": 20322,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 7,
   "firman": "Terkenanglah Yerusalem, pada hari-hari sengsara dan penderitaannya, akan segala harta benda yang dimilikinya dahulu kala; tatkala penduduknya jatuh ke tangan lawan, dan tak ada penolong baginya, para lawan memandangnya, dan tertawa karena keruntuhannya."
 },
 {
   "id": 20323,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 8,
   "firman": "Yerusalem sangat berdosa, sehingga najis adanya; semua yang dahulu menghormatinya, sekarang menghinanya, karena melihat telanjangnya; dan dia sendiri berkeluh kesah, dan memalingkan mukanya."
 },
 {
   "id": 20324,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 9,
   "firman": "Kenajisannya melekat pada ujung kainnya; ia tak berpikir akan akhirnya, sangatlah dalam ia jatuh, tiada orang yang menghiburnya. \"Ya, TUHAN, lihatlah sengsaraku, karena si seteru membesarkan dirinya!\""
 },
 {
   "id": 20325,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 10,
   "firman": "Si lawan mengulurkan tangannya kepada segala harta bendanya; bahkan harus dilihatnya bagaimana bangsa-bangsa masuk ke dalam tempat kudusnya, padahal Engkau, ya TUHAN, telah melarang mereka untuk masuk jemaah-Mu."
 },
 {
   "id": 20326,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 11,
   "firman": "Berkeluh kesah seluruh penduduknya, sedang mereka mencari roti; harta benda mereka berikan ganti makanan, untuk menyambung hidupnya. \"Lihatlah, ya TUHAN, pandanglah, betapa hina aku ini!"
 },
 {
   "id": 20327,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 12,
   "firman": "Acuh tak acuhkah kamu sekalian yang berlalu? Pandanglah dan lihatlah, apakah ada kesedihan seperti kesedihan yang ditimpakan TUHAN kepadaku, untuk membuat aku merana tatkala murka-Nya menyala-nyala!"
 },
 {
   "id": 20328,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 13,
   "firman": "Dari atas dikirim-Nya api masuk ke dalam tulang-tulangku; dihamparkan-Nya jaring di muka kakiku, didesak-Nya aku mundur; aku dibuat-Nya terkejut, kesakitan sepanjang hari."
 },
 {
   "id": 20329,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 14,
   "firman": "Segala pelanggaranku adalah kuk yang berat, suatu jalinan yang dibuat tangan Tuhan, yang ditaruh di atas tengkukku, sehingga melumpuhkan kekuatanku; Tuhan telah menyerahkan aku ke tangan orang-orang, yang tidak dapat kutentangi."
 },
 {
   "id": 20330,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 15,
   "firman": "Tuhan membuang semua pahlawanku yang ada dalam lingkunganku; Ia menyelenggarakan pesta menentang aku untuk membinasakan teruna-terunaku; Tuhan telah menginjak-injak puteri Yehuda, dara itu, seperti orang mengirik memeras anggur."
 },
 {
   "id": 20331,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 16,
   "firman": "Karena inilah aku menangis, mataku mencucurkan air; karena jauh dari padaku penghibur yang dapat menyegarkan jiwaku; bingunglah anak-anakku, karena terlampau kuat si seteru.\""
 },
 {
   "id": 20332,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sion mengulurkan tangannya, tetapi tak ada orang yang menghiburnya; terhadap Yakub dikerahkan TUHAN tetangga-tetangganya sebagai lawan. Yerusalem telah menjadi najis di tengah-tengah mereka."
 },
 {
   "id": 20333,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 18,
   "firman": "\"Tuhanlah yang benar, karena aku telah memberontak terhadap firman-Nya; dengarlah hai segala bangsa, dan lihatlah kesedihanku; dara-daraku dan teruna-terunaku pergi sebagai tawanan."
 },
 {
   "id": 20334,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 19,
   "firman": "Aku memanggil kekasih-kekasihku, tetapi mereka memperdayakan aku; imam-imamku dan para tua-tuaku telah mati semuanya di kota, tatkala mencari makan bagi dirinya untuk menyambung hidupnya."
 },
 {
   "id": 20335,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ya, TUHAN, lihatlah, betapa besar ketakutanku, betapa gelisah jiwaku; hatiku terbolak-balik di dalam dadaku, karena sudah melampaui batas aku memberontak; di luar keturunanku dibinasakan oleh pedang, di dalam rumah oleh penyakit sampar."
 },
 {
   "id": 20336,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 21,
   "firman": "Dengarlah bagaimana keluh kesahku, sedang tiada penghibur bagiku; seteru-seteruku mendengar tentang kecelakaanku, mereka gembira karena Engkau yang mendatangkannya! Datanglah kiranya hari yang telah Engkau umumkan itu, dan biarlah mereka menjadi seperti aku!"
 },
 {
   "id": 20337,
   "kitab": "Rat",
   "pasal": 1,
   "ayat": 22,
   "firman": "Biarlah segala kejahatan mereka datang ke hadapan-Mu, dan perbuatlah kepada mereka, seperti Engkau telah perbuat kepadaku oleh karena segala pelanggaranku; karena banyaklah keluh kesahku, dan pedih hatiku.\""
 },
 {
   "id": 20338,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 1,
   "firman": "Ah, betapa Tuhan menyelubungi puteri Sion dengan awan dalam murka-Nya! Keagungan Israel dilemparkan-Nya dari langit ke bumi. Tak diingat-Nya akan tumpuan kaki-Nya tatkala Ia murka."
 },
 {
   "id": 20339,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tanpa belas kasihan Tuhan memusnahkan segala ladang Yakub. Ia menghancurkan dalam amarah-Nya benteng-benteng puteri Yehuda. Ia mencampakkan ke bumi dan mencemarkan kerajaan dan pemimpin-pemimpinnya."
 },
 {
   "id": 20340,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dalam murka yang menyala-nyala Ia mematahkan segala tanduk Israel, menarik kembali tangan kanan-Nya pada waktu si seteru mendekat, membakar Yakub laksana api yang menyala-nyala, yang menjilat ke sekeliling."
 },
 {
   "id": 20341,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 4,
   "firman": "Ia membidikkan panah-Nya seperti seorang seteru dengan mengacungkan tangan kanan-Nya seperti seorang lawan; membunuh segala yang menyenangkan mata dalam kemah puteri Sion, memuntahkan geram-Nya seperti api."
 },
 {
   "id": 20342,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tuhan menjadi seperti seorang seteru; Ia menghancurkan Israel, meremukkan segala purinya, mempuingkan benteng-bentengnya, memperbanyak susah dan kesah pada puteri Yehuda."
 },
 {
   "id": 20343,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ia melanda kemah-Nya seperti kebun, menghancurkan tempat pertemuan-Nya. Di Sion TUHAN menjadikan orang lupa akan perayaan dan sabat, dan menolak dalam kegeraman murka-Nya raja dan imam."
 },
 {
   "id": 20344,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tuhan membuang mezbah-Nya, meninggalkan tempat kudus-Nya, menyerahkan ke dalam tangan seteru tembok puri-purinya. Teriakan ramai mereka dalam Bait Allah seperti keramaian pada hari perayaan jemaah."
 },
 {
   "id": 20345,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 8,
   "firman": "TUHAN telah memutuskan untuk mempuingkan tembok puteri Sion. Ia mengukur semuanya dengan tali pengukur, Ia tak menahan tangan-Nya untuk menghancurkannya. Ia menjadikan berkabung tembok luar dan tembok dalam, mereka merana semua."
 },
 {
   "id": 20346,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 9,
   "firman": "Terbenam gapura-gapuranya di dalam tanah; TUHAN menghancurkan dan meluluhkan palang-palang pintunya. Rajanya dan pemimpin-pemimpinnya berada di antara bangsa-bangsa asing. Tak ada petunjuk dari TUHAN, bahkan nabi-nabi tidak menerima lagi wahyu dari pada-Nya."
 },
 {
   "id": 20347,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 10,
   "firman": "Duduklah tertegun di tanah para tua-tua puteri Sion; mereka menabur abu di atas kepala, dan mengenakan kain kabung. Dara-dara Yerusalem menundukkan kepalanya ke tanah."
 },
 {
   "id": 20348,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 11,
   "firman": "Mataku kusam dengan air mata, remuk redam hatiku; hancur habis hatiku karena keruntuhan puteri bangsaku, sebab jatuh pingsan kanak-kanak dan bayi di lapangan-lapangan kota."
 },
 {
   "id": 20349,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 12,
   "firman": "Kepada ibunya mereka bertanya: \"Mana roti dan anggur?\", sedang mereka jatuh pingsan seperti orang yang gugur di lapangan-lapangan kota, ketika menghembuskan nafas di pangkuan ibunya."
 },
 {
   "id": 20350,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 13,
   "firman": "Apa yang dapat kunyatakan kepadamu, dengan apa aku dapat menyamakan engkau, ya puteri Yerusalem? Dengan apa aku dapat membandingkan engkau untuk dihibur, ya dara, puteri Sion? Karena luas bagaikan laut reruntuhanmu; siapa yang akan memulihkan engkau?"
 },
 {
   "id": 20351,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 14,
   "firman": "Nabi-nabimu melihat bagimu penglihatan yang dusta dan hampa. Mereka tidak menyatakan kesalahanmu, guna memulihkan engkau kembali. Mereka mengeluarkan bagimu ramalan-ramalan yang dusta dan menyesatkan."
 },
 {
   "id": 20352,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 15,
   "firman": "Sekalian orang yang lewat bertepuk tangan karena engkau. Mereka bersuit-suit dan menggelengkan kepalanya mengenai puteri Yerusalem: \"Inikah kota yang disebut orang kota yang paling indah, kesukaan dunia semesta?\""
 },
 {
   "id": 20353,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 16,
   "firman": "Terhadap engkau semua seterumu mengangakan mulutnya. Mereka bersuit-suit dan menggertakkan gigi: \"Kami telah memusnahkannya!\", kata mereka, \"Nah, inilah harinya yang kami nanti-nantikan, kami mengalaminya, kami melihatnya!\""
 },
 {
   "id": 20354,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 17,
   "firman": "TUHAN telah menjalankan yang dirancangkan-Nya, Ia melaksanakan yang difirmankan-Nya, yang diperintahkan-Nya dahulu kala; Ia merusak tanpa belas kasihan, Ia menjadikan si seteru senang atas kamu, Ia meninggikan tanduk lawan-lawanmu."
 },
 {
   "id": 20355,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 18,
   "firman": "Berteriaklah kepada Tuhan dengan nyaring, hai, puteri Sion, cucurkanlah air mata bagaikan sungai siang dan malam; janganlah kauberikan dirimu istirahat, janganlah matamu tenang!"
 },
 {
   "id": 20356,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 19,
   "firman": "Bangunlah, mengeranglah pada malam hari, pada permulaan giliran jaga malam; curahkanlah isi hatimu bagaikan air di hadapan Tuhan, angkatlah tanganmu kepada-Nya demi hidup anak-anakmu, yang jatuh pingsan karena lapar di ujung-ujung jalan!"
 },
 {
   "id": 20357,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 20,
   "firman": "Lihatlah, TUHAN, dan tiliklah, kepada siapakah Engkau telah berbuat ini? Apakah perempuan harus makan anak kandungnya, anak-anak yang masih dibuai? Apakah dalam tempat kudus Tuhan harus dibunuh imam dan nabi?"
 },
 {
   "id": 20358,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 21,
   "firman": "Terbaring di debu jalan pemuda dan orang tua; dara-daraku dan teruna-terunaku gugur oleh pedang; Engkau membunuh mereka tatkala Engkau murka, tanpa belas kasihan Engkau menyembelih mereka!"
 },
 {
   "id": 20359,
   "kitab": "Rat",
   "pasal": 2,
   "ayat": 22,
   "firman": "Seolah-olah pada hari perayaan Engkau mengundang semua yang kutakuti dari sekeliling. Tatkala TUHAN murka tak ada seorang yang luput atau selamat. Mereka yang kubuai dan kubesarkan dibinasakan seteruku."
 },
 {
   "id": 20360,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 1,
   "firman": "Akulah orang yang melihat sengsara disebabkan cambuk murka-Nya."
 },
 {
   "id": 20361,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ia menghalau dan membawa aku ke dalam kegelapan yang tidak ada terangnya."
 },
 {
   "id": 20362,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 3,
   "firman": "Sesungguhnya, aku dipukul-Nya berulang-ulang dengan tangan-Nya sepanjang hari."
 },
 {
   "id": 20363,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 4,
   "firman": "Ia menyusutkan dagingku dan kulitku, tulang-tulangku dipatahkan-Nya."
 },
 {
   "id": 20364,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 5,
   "firman": "Ia mendirikan tembok sekelilingku, mengelilingi aku dengan kesedihan dan kesusahan."
 },
 {
   "id": 20365,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 6,
   "firman": "Ia menempatkan aku di dalam gelap seperti orang yang sudah lama mati."
 },
 {
   "id": 20366,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 7,
   "firman": "Ia menutup segala jalan ke luar bagiku, Ia mengikat aku dengan rantai yang berat."
 },
 {
   "id": 20367,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 8,
   "firman": "Walaupun aku memanggil-manggil dan berteriak minta tolong, tak didengarkan-Nya doaku."
 },
 {
   "id": 20368,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 9,
   "firman": "Ia merintangi jalan-jalanku dengan batu pahat, dan menjadikannya tidak terlalui."
 },
 {
   "id": 20369,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 10,
   "firman": "Laksana beruang Ia menghadang aku, laksana singa dalam tempat persembunyian."
 },
 {
   "id": 20370,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 11,
   "firman": "Ia membelokkan jalan-jalanku, merobek-robek aku dan membuat aku tertegun."
 },
 {
   "id": 20371,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 12,
   "firman": "Ia membidikkan panah-Nya, menjadikan aku sasaran anak panah."
 },
 {
   "id": 20372,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 13,
   "firman": "Ia menyusupkan ke dalam hatiku segala anak panah dari tabung-Nya."
 },
 {
   "id": 20373,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 14,
   "firman": "Aku menjadi tertawaan bagi segenap bangsaku, menjadi lagu ejekan mereka sepanjang hari."
 },
 {
   "id": 20374,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 15,
   "firman": "Ia mengenyangkan aku dengan kepahitan, memberi aku minum ipuh."
 },
 {
   "id": 20375,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 16,
   "firman": "Ia meremukkan gigi-gigiku dengan memberi aku makan kerikil; Ia menekan aku ke dalam debu."
 },
 {
   "id": 20376,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 17,
   "firman": "Engkau menceraikan nyawaku dari kesejahteraan, aku lupa akan kebahagiaan."
 },
 {
   "id": 20377,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 18,
   "firman": "Sangkaku: hilang lenyaplah kemasyhuranku dan harapanku kepada TUHAN."
 },
 {
   "id": 20378,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 19,
   "firman": "\"Ingatlah akan sengsaraku dan pengembaraanku, akan ipuh dan racun itu.\""
 },
 {
   "id": 20379,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 20,
   "firman": "Jiwaku selalu teringat akan hal itu dan tertekan dalam diriku."
 },
 {
   "id": 20380,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 21,
   "firman": "Tetapi hal-hal inilah yang kuperhatikan, oleh sebab itu aku akan berharap:"
 },
 {
   "id": 20381,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 22,
   "firman": "Tak berkesudahan kasih setia TUHAN, tak habis-habisnya rahmat-Nya,"
 },
 {
   "id": 20382,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 23,
   "firman": "selalu baru tiap pagi; besar kesetiaan-Mu!"
 },
 {
   "id": 20383,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 24,
   "firman": "\"TUHAN adalah bagianku,\" kata jiwaku, oleh sebab itu aku berharap kepada-Nya."
 },
 {
   "id": 20384,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 25,
   "firman": "TUHAN adalah baik bagi orang yang berharap kepada-Nya, bagi jiwa yang mencari Dia."
 },
 {
   "id": 20385,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 26,
   "firman": "Adalah baik menanti dengan diam pertolongan TUHAN."
 },
 {
   "id": 20386,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 27,
   "firman": "Adalah baik bagi seorang pria memikul kuk pada masa mudanya."
 },
 {
   "id": 20387,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 28,
   "firman": "Biarlah ia duduk sendirian dan berdiam diri kalau TUHAN membebankannya."
 },
 {
   "id": 20388,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 29,
   "firman": "Biarlah ia merebahkan diri dengan mukanya dalam debu, mungkin ada harapan."
 },
 {
   "id": 20389,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 30,
   "firman": "Biarlah ia memberikan pipi kepada yang menamparnya, biarlah ia kenyang dengan cercaan."
 },
 {
   "id": 20390,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 31,
   "firman": "Karena tidak untuk selama-lamanya Tuhan mengucilkan."
 },
 {
   "id": 20391,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 32,
   "firman": "Karena walau Ia mendatangkan susah, Ia juga menyayangi menurut kebesaran kasih setia-Nya."
 },
 {
   "id": 20392,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 33,
   "firman": "Karena tidak dengan rela hati Ia menindas dan merisaukan anak-anak manusia."
 },
 {
   "id": 20393,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 34,
   "firman": "Kalau dipijak-pijak dengan kaki tawanan-tawanan di dunia,"
 },
 {
   "id": 20394,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 35,
   "firman": "kalau hak orang dibelokkan di hadapan Yang Mahatinggi,"
 },
 {
   "id": 20395,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 36,
   "firman": "atau orang diperlakukan tidak adil dalam perkaranya, masakan Tuhan tidak melihatnya?"
 },
 {
   "id": 20396,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 37,
   "firman": "Siapa berfirman, maka semuanya jadi? Bukankah Tuhan yang memerintahkannya?"
 },
 {
   "id": 20397,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 38,
   "firman": "Bukankah dari mulut Yang Mahatinggi keluar apa yang buruk dan apa yang baik?"
 },
 {
   "id": 20398,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 39,
   "firman": "Mengapa orang hidup mengeluh? Biarlah setiap orang mengeluh tentang dosanya!"
 },
 {
   "id": 20399,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 40,
   "firman": "Marilah kita menyelidiki dan memeriksa hidup kita, dan berpaling kepada TUHAN."
 },
 {
   "id": 20400,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 41,
   "firman": "Marilah kita mengangkat hati dan tangan kita kepada Allah di sorga:"
 },
 {
   "id": 20401,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 42,
   "firman": "Kami telah mendurhaka dan memberontak, Engkau tidak mengampuni."
 },
 {
   "id": 20402,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 43,
   "firman": "Engkau menyelubungi diri-Mu dengan murka, mengejar kami dan membunuh kami tanpa belas kasihan."
 },
 {
   "id": 20403,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 44,
   "firman": "Engkau menyelubungi diri-Mu dengan awan, sehingga doa tak dapat menembus."
 },
 {
   "id": 20404,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 45,
   "firman": "Kami Kaujadikan kotor dan keji di antara bangsa-bangsa."
 },
 {
   "id": 20405,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 46,
   "firman": "Terhadap kami semua seteru kami mengangakan mulutnya."
 },
 {
   "id": 20406,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 47,
   "firman": "Kejut dan jerat menimpa kami, kemusnahan dan kehancuran."
 },
 {
   "id": 20407,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 48,
   "firman": "Air mataku mengalir bagaikan batang air, karena keruntuhan puteri bangsaku."
 },
 {
   "id": 20408,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 49,
   "firman": "Air mataku terus-menerus bercucuran, dengan tak henti-hentinya,"
 },
 {
   "id": 20409,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 50,
   "firman": "sampai TUHAN memandang dari atas dan melihat dari sorga."
 },
 {
   "id": 20410,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 51,
   "firman": "Mataku terasa pedih oleh sebab keadaan puteri-puteri kotaku."
 },
 {
   "id": 20411,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 52,
   "firman": "Seperti burung aku diburu-buru oleh mereka yang menjadi seteruku tanpa sebab."
 },
 {
   "id": 20412,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 53,
   "firman": "Mereka melemparkan aku hidup-hidup dalam lobang, melontari aku dengan batu."
 },
 {
   "id": 20413,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 54,
   "firman": "Air membanjir di atas kepalaku, kusangka: \"Binasa aku!\""
 },
 {
   "id": 20414,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 55,
   "firman": "\"Ya TUHAN, aku memanggil nama-Mu dari dasar lobang yang dalam."
 },
 {
   "id": 20415,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 56,
   "firman": "Engkau mendengar suaraku! Janganlah Kaututupi telinga-Mu terhadap kesahku dan teriak tolongku!"
 },
 {
   "id": 20416,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 57,
   "firman": "Engkau dekat tatkala aku memanggil-Mu, Engkau berfirman: Jangan takut!\""
 },
 {
   "id": 20417,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 58,
   "firman": "\"Ya Tuhan, Engkau telah memperjuangkan perkaraku, Engkau telah menyelamatkan hidupku."
 },
 {
   "id": 20418,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 59,
   "firman": "Engkau telah melihat ketidakadilan terhadap aku, ya TUHAN; berikanlah keadilan!"
 },
 {
   "id": 20419,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 60,
   "firman": "Engkau telah melihat segala dendam mereka, segala rancangan mereka terhadap aku.\""
 },
 {
   "id": 20420,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 61,
   "firman": "\"Engkau telah mendengar cercaan mereka, ya TUHAN, segala rancangan mereka terhadap aku,"
 },
 {
   "id": 20421,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 62,
   "firman": "percakapan orang-orang yang melawan aku, dan rencana mereka terhadap aku sepanjang hari."
 },
 {
   "id": 20422,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 63,
   "firman": "Amatilah duduk bangun mereka! Aku menjadi lagu ejekan mereka.\""
 },
 {
   "id": 20423,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 64,
   "firman": "\"Engkau akan mengadakan pembalasan terhadap mereka, ya TUHAN, menurut perbuatan tangan mereka."
 },
 {
   "id": 20424,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 65,
   "firman": "Engkau akan mengeraskan hati mereka; kiranya kutuk-Mu menimpa mereka!"
 },
 {
   "id": 20425,
   "kitab": "Rat",
   "pasal": 3,
   "ayat": 66,
   "firman": "Engkau akan mengejar mereka dengan murka dan memunahkan mereka dari bawah langit, ya TUHAN!\""
 },
 {
   "id": 20426,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ah, sungguh pudar emas itu, emas murni itu berubah; batu-batu suci itu terbuang di pojok tiap jalan."
 },
 {
   "id": 20427,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 2,
   "firman": "Anak-anak Sion yang berharga, yang setimbang dengan emas tua, sungguh mereka dianggap belanga-belanga tanah buatan tangan tukang periuk."
 },
 {
   "id": 20428,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 3,
   "firman": "Serigalapun memberikan teteknya dan menyusui anak-anaknya, tetapi puteri bangsaku telah menjadi kejam seperti burung unta di padang pasir."
 },
 {
   "id": 20429,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 4,
   "firman": "Lidah bayi melekat pada langit-langit karena haus; kanak-kanak meminta roti, tetapi tak seorangpun yang memberi."
 },
 {
   "id": 20430,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 5,
   "firman": "Yang biasa makan yang sedap-sedap mati bulur di jalan-jalan; yang biasa duduk di atas bantal kirmizi terbaring di timbunan sampah."
 },
 {
   "id": 20431,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 6,
   "firman": "Kedurjanaan puteri bangsaku melebihi dosa Sodom, yang sekejap mata dibongkar-bangkir tanpa ada tangan yang memukulnya."
 },
 {
   "id": 20432,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 7,
   "firman": "Pemimpin-pemimpin lebih bersih dari salju dan lebih putih dari susu, tubuh mereka lebih merah dari pada merjan, seperti batu nilam rupa mereka."
 },
 {
   "id": 20433,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 8,
   "firman": "Sekarang rupa mereka lebih hitam dari pada jelaga, mereka tidak dikenal di jalan-jalan, kulit mereka berkerut pada tulang-tulangnya, mengering seperti kayu."
 },
 {
   "id": 20434,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 9,
   "firman": "Lebih bahagia mereka yang gugur karena pedang dari pada mereka yang tewas karena lapar, yang merana dan mati sebab tak ada hasil ladang."
 },
 {
   "id": 20435,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 10,
   "firman": "Dengan tangan sendiri wanita yang lemah lembut memasak kanak-kanak mereka, untuk makanan mereka tatkala runtuh puteri bangsaku."
 },
 {
   "id": 20436,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 11,
   "firman": "TUHAN melepaskan segenap amarah-Nya, mencurahkan murka-Nya yang menyala-nyala, dan menyalakan api di Sion, yang memakan dasar-dasarnya."
 },
 {
   "id": 20437,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 12,
   "firman": "Tidak percaya raja-raja di bumi, pun seluruh penduduk dunia, bahwa lawan dan seteru dapat masuk ke dalam gapura-gapura Yerusalem."
 },
 {
   "id": 20438,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 13,
   "firman": "Hal itu terjadi oleh sebab dosa nabi-nabinya dan kedurjanaan imam-imamnya yang di tengah-tengahnya mencurahkan darah orang yang tidak bersalah."
 },
 {
   "id": 20439,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 14,
   "firman": "Mereka terhuyung-huyung seperti orang buta di jalan-jalan, cemar oleh darah, sehingga orang tak dapat menyentuh pakaian mereka."
 },
 {
   "id": 20440,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 15,
   "firman": "\"Singkir! Najis!\", kata orang kepada mereka, \"Singkir! Singkir! Jangan sentuh!\"; lalu mereka lari dan mengembara, maka berkatalah bangsa-bangsa: \"Mereka tak boleh tinggal lebih lama di sini.\""
 },
 {
   "id": 20441,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 16,
   "firman": "TUHAN sendiri mencerai-beraikan mereka, tak mau lagi Ia memandang mereka. Para imam tidak mereka hormati, dan orang-orang tua tidak mereka kasihani."
 },
 {
   "id": 20442,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 17,
   "firman": "Selalu mata kami merindukan pertolongan, tetapi sia-sia; dari menara penjagaan kami menanti-nantikan suatu bangsa yang tak dapat menolong."
 },
 {
   "id": 20443,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 18,
   "firman": "Mereka mengintai langkah-langkah kami, sehingga kami tak dapat berjalan di lapangan-lapangan kami; akhir hidup kami mendekat, hari-hari kami sudah genap, ya, akhir hidup kami sudah tiba."
 },
 {
   "id": 20444,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 19,
   "firman": "Pengejar-pengejar kami lebih cepat dari pada burung rajawali di angkasa mereka memburu kami di atas gunung-gunung, menghadang kami di padang gurun."
 },
 {
   "id": 20445,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 20,
   "firman": "Orang yang diurapi TUHAN, nafas hidup kami, tertangkap dalam pelubang mereka, dia yang kami sangka: \"Dalam naungannya kami akan hidup di antara bangsa-bangsa.\""
 },
 {
   "id": 20446,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 21,
   "firman": "Bergembira dan bersukacitalah, hai puteri Edom, engkau yang mendiami tanah Us, juga kepadamu piala akan sampai, engkau akan jadi mabuk lalu menelanjangi dirimu!"
 },
 {
   "id": 20447,
   "kitab": "Rat",
   "pasal": 4,
   "ayat": 22,
   "firman": "Telah hapus kesalahanmu, puteri Sion, tak akan lagi TUHAN membawa engkau ke dalam pembuangan, tetapi kesalahanmu, puteri Edom, akan dibalas-Nya, dan dosa-dosamu akan disingkapkan-Nya."
 },
 {
   "id": 20448,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 1,
   "firman": "Ingatlah, ya TUHAN, apa yang terjadi atas kami, pandanglah dan lihatlah akan kehinaan kami."
 },
 {
   "id": 20449,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 2,
   "firman": "Milik pusaka kami beralih kepada orang lain, rumah-rumah kami kepada orang asing."
 },
 {
   "id": 20450,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 3,
   "firman": "Kami menjadi anak yatim, tak punya bapa, dan ibu kami seperti janda."
 },
 {
   "id": 20451,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 4,
   "firman": "Air kami kami minum dengan membayar, kami mendapat kayu dengan bayaran."
 },
 {
   "id": 20452,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 5,
   "firman": "Kami dikejar dekat-dekat, kami lelah, bagi kami tak ada istirahat."
 },
 {
   "id": 20453,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 6,
   "firman": "Kami mengulurkan tangan kepada Mesir, dan kepada Asyur untuk menjadi kenyang dengan roti."
 },
 {
   "id": 20454,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 7,
   "firman": "Bapak-bapak kami berbuat dosa, mereka tak ada lagi, dan kami yang menanggung kedurjanaan mereka."
 },
 {
   "id": 20455,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 8,
   "firman": "Pelayan-pelayan memerintah atas kami; yang melepaskan kami dari tangan mereka tak ada."
 },
 {
   "id": 20456,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dengan bahaya maut karena serangan pedang di padang gurun, kami harus mengambil makanan kami."
 },
 {
   "id": 20457,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 10,
   "firman": "Kulit kami membara laksana perapian, karena nyerinya kelaparan."
 },
 {
   "id": 20458,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 11,
   "firman": "Mereka memperkosa wanita-wanita di Sion dan gadis-gadis di kota-kota Yehuda."
 },
 {
   "id": 20459,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 12,
   "firman": "Pemimpin-pemimpin digantung oleh tangan mereka, para tua-tua tidak dihormati."
 },
 {
   "id": 20460,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 13,
   "firman": "Pemuda-pemuda harus memikul batu kilangan, anak-anak terjatuh karena beratnya pikulan kayu."
 },
 {
   "id": 20461,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 14,
   "firman": "Para tua-tua tidak berkumpul lagi di pintu gerbang, para teruna berhenti main kecapi."
 },
 {
   "id": 20462,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 15,
   "firman": "Lenyaplah kegirangan hati kami, tari-tarian kami berubah menjadi perkabungan."
 },
 {
   "id": 20463,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 16,
   "firman": "Mahkota telah jatuh dari kepala kami. Wahai kami, karena kami telah berbuat dosa!"
 },
 {
   "id": 20464,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 17,
   "firman": "Karena inilah hati kami sakit, karena inilah mata kami jadi kabur:"
 },
 {
   "id": 20465,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 18,
   "firman": "karena bukit Sion yang tandus, di mana anjing-anjing hutan berkeliaran."
 },
 {
   "id": 20466,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 19,
   "firman": "Engkau, ya TUHAN, bertakhta selama-lamanya, takhta-Mu tetap dari masa ke masa!"
 },
 {
   "id": 20467,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 20,
   "firman": "Mengapa Engkau melupakan kami selama-lamanya, meninggalkan kami demikian lama?"
 },
 {
   "id": 20468,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 21,
   "firman": "Bawalah kami kembali kepada-Mu, ya TUHAN, maka kami akan kembali, baharuilah hari-hari kami seperti dahulu kala!"
 },
 {
   "id": 20469,
   "kitab": "Rat",
   "pasal": 5,
   "ayat": 22,
   "firman": "Atau, apa Engkau sudah membuang kami sama sekali? Sangat murkakah Engkau terhadap kami?"
 },
 {
   "id": 20470,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada tahun ketiga puluh, dalam bulan yang keempat, pada tanggal lima bulan itu, ketika aku bersama-sama dengan para buangan berada di tepi sungai Kebar, terbukalah langit dan aku melihat penglihatan-penglihatan tentang Allah."
 },
 {
   "id": 20471,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 2,
   "firman": "Pada tanggal lima bulan itu, yaitu tahun kelima sesudah raja Yoyakhin dibuang,"
 },
 {
   "id": 20472,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 3,
   "firman": "datanglah firman TUHAN kepada imam Yehezkiel, anak Busi, di negeri orang Kasdim di tepi sungai Kebar, dan di sana kekuasaan TUHAN meliputi dia."
 },
 {
   "id": 20473,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 4,
   "firman": "Lalu aku melihat, sungguh, angin badai bertiup dari utara, dan membawa segumpal awan yang besar dengan api yang berkilat-kilat dan awan itu dikelilingi oleh sinar; di dalam, di tengah-tengah api itu kelihatan seperti suasa mengkilat."
 },
 {
   "id": 20474,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan di tengah-tengah itu juga ada yang menyerupai empat makhluk hidup dan beginilah kelihatannya mereka: mereka menyerupai manusia,"
 },
 {
   "id": 20475,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 6,
   "firman": "tetapi masing-masing mempunyai empat muka dan pada masing-masing ada pula empat sayap."
 },
 {
   "id": 20476,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 7,
   "firman": "Kaki mereka adalah lurus dan telapak kaki mereka seperti kuku anak lembu; kaki-kaki ini mengkilap seperti tembaga yang baru digosok."
 },
 {
   "id": 20477,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 8,
   "firman": "Pada keempat sisi mereka di bawah sayap-sayapnya tampak tangan manusia. Mengenai muka dan sayap mereka berempat adalah begini:"
 },
 {
   "id": 20478,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 9,
   "firman": "mereka saling menyentuh dengan sayapnya; mereka tidak berbalik kalau berjalan, masing-masing berjalan lurus ke depan."
 },
 {
   "id": 20479,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 10,
   "firman": "Muka mereka kelihatan begini: Keempatnya mempunyai muka manusia di depan, muka singa di sebelah kanan, muka lembu di sebelah kiri, dan muka rajawali di belakang."
 },
 {
   "id": 20480,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sayap-sayap mereka dikembangkan ke atas; mereka saling menyentuh dengan sepasang sayapnya dan sepasang sayap yang lain menutupi badan mereka."
 },
 {
   "id": 20481,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 12,
   "firman": "Masing-masing berjalan lurus ke depan; ke arah mana roh itu hendak pergi, ke sanalah mereka pergi, mereka tidak berbalik kalau berjalan."
 },
 {
   "id": 20482,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 13,
   "firman": "Di tengah makhluk-makhluk hidup itu kelihatan seperti bara api yang menyala, seperti suluh, yang bergerak kian ke mari di antara makhluk-makhluk hidup itu, dan api itu bersinar sedang dari api itu kilat sabung-menyabung."
 },
 {
   "id": 20483,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 14,
   "firman": "Makhluk-makhluk hidup itu terbang ke sana ke mari seperti kilat."
 },
 {
   "id": 20484,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 15,
   "firman": "Aku melihat, sungguh, di atas tanah di samping masing-masing dari keempat makhluk-makhluk hidup itu ada sebuah roda."
 },
 {
   "id": 20485,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 16,
   "firman": "Rupa roda-roda itu seperti kilauan permata pirus dan keempatnya adalah serupa; buatannya seolah-olah roda yang satu di tengah-tengah yang lain."
 },
 {
   "id": 20486,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 17,
   "firman": "Kalau mereka berjalan mereka dapat menuju keempat jurusan; mereka tidak berbalik kalau berjalan."
 },
 {
   "id": 20487,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 18,
   "firman": "Mereka mempunyai lingkar dan aku melihat, bahwa sekeliling lingkar yang empat itu penuh dengan mata."
 },
 {
   "id": 20488,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 19,
   "firman": "Kalau makhluk-makhluk hidup itu berjalan, roda-roda itu juga berjalan di samping mereka; dan kalau makhluk-makhluk hidup itu terangkat dari atas tanah, roda-roda itu turut terangkat."
 },
 {
   "id": 20489,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ke arah mana roh itu hendak pergi, ke sanalah mereka pergi, dan roda-rodanya sama-sama terangkat dengan mereka, sebab roh makhluk-makhluk hidup itu berada di dalam roda-rodanya."
 },
 {
   "id": 20490,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 21,
   "firman": "Kalau makhluk-makhluk hidup itu berjalan, roda-roda itu berjalan; kalau mereka berhenti, roda-roda itu berhenti; dan kalau mereka terangkat dari tanah, roda-roda itu sama-sama terangkat dengan mereka; sebab roh makhluk-makhluk hidup itu berada di dalam roda-rodanya."
 },
 {
   "id": 20491,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 22,
   "firman": "Di atas kepala makhluk-makhluk hidup itu ada yang menyerupai cakrawala, yang kelihatan seperti hablur es yang mendahsyatkan, terbentang di atas kepala mereka."
 },
 {
   "id": 20492,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 23,
   "firman": "Dan di bawah cakrawala itu sayap mereka dikembangkan lurus, yang satu menyinggung yang lain; dan masing-masing mempunyai sepasang sayap yang menutupi badan mereka."
 },
 {
   "id": 20493,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 24,
   "firman": "Kalau mereka berjalan, aku mendengar suara sayapnya seperti suara air terjun yang menderu, seperti suara Yang Mahakuasa, seperti keributan laskar yang besar; kalau mereka berhenti, sayapnya dibiarkan terkulai."
 },
 {
   "id": 20494,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 25,
   "firman": "Maka kedengaranlah suara dari atas cakrawala yang ada di atas kepala mereka; kalau mereka berhenti, sayapnya dibiarkan terkulai."
 },
 {
   "id": 20495,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 26,
   "firman": "Di atas cakrawala yang ada di atas kepala mereka ada menyerupai takhta yang kelihatannya seperti permata lazurit; dan di atas yang menyerupai takhta itu ada yang kelihatan seperti rupa manusia."
 },
 {
   "id": 20496,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 27,
   "firman": "Dari yang menyerupai pinggangnya sampai ke atas aku lihat seperti suasa mengkilat dan seperti api yang ditudungi sekelilingnya; dan dari yang menyerupai pinggangnya sampai ke bawah aku lihat seperti api yang dikelilingi sinar."
 },
 {
   "id": 20497,
   "kitab": "Yeh",
   "pasal": 1,
   "ayat": 28,
   "firman": "Seperti busur pelangi, yang terlihat pada musim hujan di awan-awan, demikianlah kelihatan sinar yang mengelilinginya. Begitulah kelihatan gambar kemuliaan TUHAN. Tatkala aku melihatnya aku sembah sujud, lalu kudengar suara Dia yang berfirman."
 },
 {
   "id": 20498,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 1,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, bangunlah dan berdiri, karena Aku hendak berbicara dengan engkau.\""
 },
 {
   "id": 20499,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sementara Ia berbicara dengan aku, kembalilah rohku ke dalam aku dan ditegakkannyalah aku. Kemudian aku mendengar Dia yang berbicara dengan aku."
 },
 {
   "id": 20500,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 3,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, Aku mengutus engkau kepada orang Israel, kepada bangsa pemberontak yang telah memberontak melawan Aku. Mereka dan nenek moyang mereka telah mendurhaka terhadap Aku sampai hari ini juga."
 },
 {
   "id": 20501,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 4,
   "firman": "Kepada keturunan inilah, yang keras kepala dan tegar hati, Aku mengutus engkau dan harus kaukatakan kepada mereka: Beginilah firman Tuhan ALLAH."
 },
 {
   "id": 20502,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dan baik mereka mendengarkan atau tidak--sebab mereka adalah kaum pemberontak--mereka akan mengetahui bahwa seorang nabi ada di tengah-tengah mereka."
 },
 {
   "id": 20503,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 6,
   "firman": "Dan engkau, anak manusia, janganlah takut melihat mereka maupun mendengarkan kata-katanya, biarpun engkau di tengah-tengah onak dan duri dan engkau tinggal dekat kalajengking. Janganlah takut mendengarkan kata-kata mereka dan janganlah gentar melihat mukanya, sebab mereka adalah kaum pemberontak."
 },
 {
   "id": 20504,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 7,
   "firman": "Sampaikanlah perkataan-perkataan-Ku kepada mereka, baik mereka mau mendengarkan atau tidak, sebab mereka adalah pemberontak."
 },
 {
   "id": 20505,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 8,
   "firman": "Dan engkau, anak manusia, dengarlah apa yang Kufirmankan kepadamu; janganlah memberontak seperti kaum pemberontak ini. Ngangakanlah mulutmu dan makanlah apa yang Kuberikan kepadamu.\""
 },
 {
   "id": 20506,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 9,
   "firman": "Aku melihat, sesungguhnya ada tangan yang terulur kepadaku, dan sungguh, dipegang-Nya sebuah gulungan kitab,"
 },
 {
   "id": 20507,
   "kitab": "Yeh",
   "pasal": 2,
   "ayat": 10,
   "firman": "lalu dibentangkan-Nya di hadapanku. Gulungan kitab itu ditulisi timbal balik dan di sana tertulis nyanyian-nyanyian ratapan, keluh kesah dan rintihan."
 },
 {
   "id": 20508,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 1,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, makanlah apa yang engkau lihat di sini; makanlah gulungan kitab ini dan pergilah, berbicaralah kepada kaum Israel.\""
 },
 {
   "id": 20509,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 2,
   "firman": "Maka kubukalah mulutku dan diberikan-Nya gulungan kitab itu kumakan."
 },
 {
   "id": 20510,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 3,
   "firman": "Lalu firman-Nya kepadaku: \"Hai anak manusia, makanlah gulungan kitab yang Kuberikan ini kepadamu dan isilah perutmu dengan itu.\" Lalu aku memakannya dan rasanya manis seperti madu dalam mulutku."
 },
 {
   "id": 20511,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 4,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, mari, pergilah dan temuilah kaum Israel dan sampaikanlah perkataan-perkataan-Ku kepada mereka."
 },
 {
   "id": 20512,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 5,
   "firman": "Sebab engkau tidak diutus kepada suatu bangsa yang berbahasa asing dan yang berat lidah, tetapi kepada kaum Israel;"
 },
 {
   "id": 20513,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 6,
   "firman": "bukan kepada banyak bangsa-bangsa yang berbahasa asing dan yang berat lidah, yang engkau tidak mengerti bahasanya. Sekiranya aku mengutus engkau kepada bangsa yang demikian, mereka akan mendengarkan engkau."
 },
 {
   "id": 20514,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 7,
   "firman": "Akan tetapi kaum Israel tidak mau mendengarkan engkau, sebab mereka tidak mau mendengarkan Aku, karena seluruh kaum Israel berkepala batu dan bertegar hati."
 },
 {
   "id": 20515,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 8,
   "firman": "Lihat, Aku meneguhkan hatimu melawan mereka yang berkepala batu dan membajakan semangatmu melawan ketegaran hati mereka."
 },
 {
   "id": 20516,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 9,
   "firman": "Seperti batu intan, yang lebih keras dari pada batu Kuteguhkan hatimu; janganlah takut kepada mereka dan janganlah gentar melihat mukanya, sebab mereka adalah kaum pemberontak.\""
 },
 {
   "id": 20517,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 10,
   "firman": "Selanjutnya firman-Nya kepadaku: \"Hai anak manusia, perhatikanlah segala perkataan-Ku yang akan Kufirmankan kepadamu dan berikanlah telingamu kepadanya."
 },
 {
   "id": 20518,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 11,
   "firman": "Mari, pergilah dan temuilah orang-orang buangan, teman sebangsamu, berbicaralah kepada mereka dan katakanlah: Beginilah firman Tuhan ALLAH; baik mereka mau mendengarkan atau tidak.\""
 },
 {
   "id": 20519,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 12,
   "firman": "Maka Roh itu mengangkat aku, dan aku mendengar di belakangku suatu suara gemuruh yang besar, tatkala kemuliaan Allah naik ke atas dari tempatnya,"
 },
 {
   "id": 20520,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 13,
   "firman": "yakni suara dari sayap-sayap makhluk-makhluk hidup yang menggesek satu sama lain, dan di samping itu suara gemertak dari roda-roda, suatu suara gemuruh yang besar."
 },
 {
   "id": 20521,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan Roh itu mengangkat dan membawa aku, dan aku pergi dengan hati panas dan dengan perasaan pahit, karena kekuasaan TUHAN memaksa aku dengan sangat."
 },
 {
   "id": 20522,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 15,
   "firman": "Demikianlah aku datang kepada orang-orang buangan yang tinggal di tepi sungai Kebar di Tel-Abib dan di sana aku duduk tertegun di tengah-tengah mereka selama tujuh hari."
 },
 {
   "id": 20523,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 16,
   "firman": "Sesudah tujuh hari datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20524,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 17,
   "firman": "\"Hai anak manusia, Aku telah menetapkan engkau menjadi penjaga kaum Israel. Bilamana engkau mendengarkan sesuatu firman dari pada-Ku, peringatkanlah mereka atas nama-Ku."
 },
 {
   "id": 20525,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 18,
   "firman": "Kalau Aku berfirman kepada orang jahat: Engkau pasti dihukum mati! --dan engkau tidak memperingatkan dia atau tidak berkata apa-apa untuk memperingatkan orang jahat itu dari hidupnya yang jahat, supaya ia tetap hidup, orang jahat itu akan mati dalam kesalahannya, tetapi Aku akan menuntut pertanggungan jawab atas nyawanya dari padamu."
 },
 {
   "id": 20526,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 19,
   "firman": "Tetapi jikalau engkau memperingatkan orang jahat itu dan ia tidak berbalik dari kejahatannya dan dari hidupnya yang jahat, ia akan mati dalam kesalahannya, tetapi engkau telah menyelamatkan nyawamu."
 },
 {
   "id": 20527,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 20,
   "firman": "Jikalau seorang yang benar berbalik dari kebenarannya dan ia berbuat curang, dan Aku meletakkan batu sandungan di hadapannya, ia akan mati. Oleh karena engkau tidak memperingatkan dia, ia akan mati dalam dosanya dan perbuatan-perbuatan kebenaran yang dikerjakannya tidak akan diingat-ingat, tetapi Aku akan menuntut pertanggungan jawab atas nyawanya dari padamu."
 },
 {
   "id": 20528,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 21,
   "firman": "Tetapi jikalau engkau memperingatkan orang yang benar itu supaya ia jangan berbuat dosa dan memang tidak berbuat dosa, ia akan tetap hidup, sebab ia mau menerima peringatan, dan engkau telah menyelamatkan nyawamu.\""
 },
 {
   "id": 20529,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 22,
   "firman": "Maka di sana kekuasaan TUHAN meliputi aku dan Ia berfirman kepadaku: \"Bangunlah dan pergilah ke lembah, di sana Aku akan berbicara dengan engkau.\""
 },
 {
   "id": 20530,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 23,
   "firman": "Aku bangun dan pergi ke lembah; sesungguhnya di sana kelihatan kemuliaan TUHAN seperti kemuliaan yang telah kulihat di tepi sungai Kebar, dan aku sujud."
 },
 {
   "id": 20531,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 24,
   "firman": "Tetapi masuklah Roh ke dalam aku dan ditegakkannya aku, lalu Ia berbicara dengan aku, kata-Nya: \"Pergilah pulang, kurunglah dirimu di dalam rumahmu."
 },
 {
   "id": 20532,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 25,
   "firman": "Dan engkau, anak manusia, sesungguhnya, engkau akan diikat dengan tali dan akan dibelenggu, sehingga engkau tidak bisa keluar masuk di tengah-tengah mereka."
 },
 {
   "id": 20533,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 26,
   "firman": "Dan Aku akan membuat lidahmu melekat pada langit-langitmu, sehingga engkau menjadi bisu dan tidak akan menempelak mereka, sebab mereka adalah kaum pemberontak."
 },
 {
   "id": 20534,
   "kitab": "Yeh",
   "pasal": 3,
   "ayat": 27,
   "firman": "Tetapi kalau Aku berbicara dengan engkau, Aku akan membuka mulutmu dan engkau akan mengatakan kepada mereka: Beginilah firman Tuhan ALLAH. Orang yang mau mendengar, biarlah ia mendengar; dan orang yang mau membiarkan, baiklah membiarkan, sebab mereka adalah kaum pemberontak.\""
 },
 {
   "id": 20535,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 1,
   "firman": "\"Engkau, anak manusia, ambillah sebuah batu bata, letakkan di hadapanmu dan ukirlah di atasnya sebuah kota, yaitu Yerusalem."
 },
 {
   "id": 20536,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 2,
   "firman": "Ukirlah kota itu dalam keadaan terkepung: dirikan sebuah benteng pengepungan, timbun pula tanah menjadi tembok pengepungan, tempatkan perkemahan tentara dan susun alat-alat pendobrak sekeliling kota itu."
 },
 {
   "id": 20537,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu ambillah sebidang besi dan dirikanlah itu di antaramu dengan kota itu menjadi dinding besi, kemudian tujukanlah wajahmu ke arah kota itu, sehingga kota itu dalam keadaan terkepung, dan engkaulah yang mengepung dia. Inilah menjadi lambang bagi kaum Israel."
 },
 {
   "id": 20538,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 4,
   "firman": "Berbaringlah engkau pada sisi kirimu dan Aku akan menanggungkan hukuman kaum Israel atasmu. Berapa hari engkau berbaring demikian, selama itulah engkau menanggung hukuman mereka."
 },
 {
   "id": 20539,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 5,
   "firman": "Beginilah Aku tentukan bagimu: Berapa tahun hukuman kaum Israel, sekian harilah engkau menanggung hukuman mereka, yaitu tiga ratus sembilan puluh hari."
 },
 {
   "id": 20540,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 6,
   "firman": "Kalau engkau sudah mengakhiri waktu ini, berbaringlah engkau untuk kedua kalinya, tetapi pada sisi kananmu dan tanggunglah hukuman kaum Yehuda empat puluh hari lamanya; Aku menentukan bagimu satu hari untuk satu tahun."
 },
 {
   "id": 20541,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 7,
   "firman": "Tujukanlah wajahmu kepada pengepungan Yerusalem dan kepalkanlah tinjumu kepadanya dan bernubuatlah melawan kota itu."
 },
 {
   "id": 20542,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 8,
   "firman": "Lihat, Aku akan mengikat engkau dengan tali, sehingga engkau tidak dapat berbalik dari sisi yang satu ke sisi yang lain sampai engkau mengakhiri waktu pengepunganmu itu."
 },
 {
   "id": 20543,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 9,
   "firman": "Selanjutnya ambillah gandum, jelai, kacang merah besar, kacang merah kecil, jawan dan sekoi dan taruhlah dalam satu periuk dan masaklah itu menjadi roti bagimu. Itulah makananmu selama engkau berbaring pada sisimu, yaitu tiga ratus sembilan puluh hari."
 },
 {
   "id": 20544,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 10,
   "firman": "Dan makananmu yang harus kaumakan akan ditentukan timbangannya, yakni dua puluh syikal satu hari; makanlah itu pada waktu-waktu tertentu."
 },
 {
   "id": 20545,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 11,
   "firman": "Air minumpun bagimu akan ditentukan, seperenam hin banyaknya; minumlah itu pada waktu-waktu tertentu."
 },
 {
   "id": 20546,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 12,
   "firman": "Makanlah roti itu seperti roti jelai yang bundar dan engkau harus membakarnya di atas kotoran manusia yang sudah kering di hadapan mereka.\""
 },
 {
   "id": 20547,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 13,
   "firman": "Selanjutnya TUHAN berfirman: \"Aku akan membuang orang Israel ke tengah-tengah bangsa-bangsa dan demikianlah mereka akan memakan rotinya najis di sana.\""
 },
 {
   "id": 20548,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 14,
   "firman": "Maka kujawab: \"Aduh, Tuhan ALLAH, sesungguhnya, aku tak pernah dinajiskan dan dari masa mudaku sampai sekarang tak pernah kumakan bangkai atau sisa mangsa binatang buas; lagipula tak pernah masuk ke mulutku ini daging yang sudah basi.\""
 },
 {
   "id": 20549,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 15,
   "firman": "Lalu firman-Nya kepadaku: \"Lihat, kalau begitu Aku mengizinkan engkau memakai kotoran lembu ganti kotoran manusia dan bakarlah rotimu di atasnya.\""
 },
 {
   "id": 20550,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sesudah itu Ia berfirman kepadaku: \"Hai, anak manusia, sesungguhnya, Aku akan memusnahkan persediaan makanan di Yerusalem--dan mereka akan memakan roti yang tertentu timbangannya dengan hati yang cemas; juga mereka akan meminum air dalam ukuran terbatas dengan hati yang gundah-gulana--"
 },
 {
   "id": 20551,
   "kitab": "Yeh",
   "pasal": 4,
   "ayat": 17,
   "firman": "dengan maksud, supaya mereka kekurangan makanan dan minuman dan mereka semuanya menjadi gundah-gulana, sehingga mereka hancur di dalam hukumannya."
 },
 {
   "id": 20552,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 1,
   "firman": "Dan engkau, anak manusia, ambillah sebilah pedang yang tajam dan pakailah itu sebagai pisau cukur tukang pangkas; cukurlah rambutmu dan janggutmu dengan itu; lalu ambillah sebuah timbangan dan bagi-bagilah rambutmu."
 },
 {
   "id": 20553,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 2,
   "firman": "Sepertiga harus kaubakar dengan api di tengah-tengah kota itu sesudah berakhir waktu pengepungannya; sepertiga harus kauambil dan tetaklah dengan pedang itu sekelilingnya; dan sepertiga lagi hamburkanlah ke dalam angin, dan Aku akan menghunus pedang dari belakang mereka."
 },
 {
   "id": 20554,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 3,
   "firman": "Engkau harus mengambil sedikit dari rambut itu dan bungkus di dalam punca kainmu."
 },
 {
   "id": 20555,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 4,
   "firman": "Dan sekali lagi engkau harus mengambil dari padanya, buangkan ke dalam api dan hanguskan dia di sana; dari sana akan keluar api untuk memakan seluruh kaum Israel. Dan berkatalah kepada mereka:"
 },
 {
   "id": 20556,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 5,
   "firman": "Beginilah firman Tuhan ALLAH: Inilah Yerusalem! Di tengah-tengah bangsa-bangsa Kutempatkan dia dan sekelilingnya ada negeri-negeri mereka."
 },
 {
   "id": 20557,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 6,
   "firman": "Ia sudah memberontak terhadap peraturan-peraturan-Ku lebih jahat dari pada bangsa-bangsa dan terhadap ketetapan-ketetapan-Ku lebih jahat dari negeri-negeri yang di sekitarnya; karena mereka menolak peraturan-peraturan-Ku dan kelakuan mereka tidak selaras dengan ketetapan-ketetapan-Ku."
 },
 {
   "id": 20558,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab itu beginilah firman Tuhan ALLAH: Oleh karena engkau lebih jahat dari pada bangsa-bangsa yang di sekitarmu dan kelakuanmu tidak selaras dengan ketetapan-ketetapan-Ku dan engkau tidak melakukan peraturan-peraturan-Ku, bahkan engkau melakukan peraturan-peraturan bangsa-bangsa yang di sekitarmu,"
 },
 {
   "id": 20559,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 8,
   "firman": "sebab itu beginilah firman Tuhan ALLAH: Lihat, Aku, ya Aku sendiri akan menjadi lawanmu dan Aku akan menjatuhkan hukuman kepadamu di hadapan bangsa-bangsa."
 },
 {
   "id": 20560,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 9,
   "firman": "Oleh karena segala perbuatanmu yang keji akan Kuperbuat terhadapmu yang belum pernah Kuperbuat dan yang tidak pernah lagi akan Kuperbuat."
 },
 {
   "id": 20561,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sebab itu di tengah-tengahmu ayah-ayah akan memakan anak-anaknya dan anak-anak memakan ayahnya dan Aku akan menjatuhkan hukuman kepadamu, sedang semua yang masih tinggal lagi dari padamu akan Kuhamburkan ke semua penjuru angin."
 },
 {
   "id": 20562,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 11,
   "firman": "Sebab itu, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, sesungguhnya, oleh karena engkau menajiskan tempat kudus-Ku dengan segala dewamu yang menjijikkan dan dengan segala perbuatanmu yang keji, Aku sendiri akan meruntuhkan engkau; Aku tidak akan merasa sayang dan tidak akan kenal belas kasihan."
 },
 {
   "id": 20563,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sepertiga dari padamu akan mati kena sampar dan mati kelaparan di tengah-tengahmu; sepertiga akan tewas dimakan pedang di sekitarmu; dan sepertiga lagi akan Kuhamburkan ke semua mata angin dan Aku akan menghunus pedang dari belakang mereka."
 },
 {
   "id": 20564,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 13,
   "firman": "Aku akan melampiaskan murka-Ku kepada mereka, sehingga hati-Ku yang panas tenang kembali dan Aku merasa puas; dan mereka akan mengetahui, bahwa Akulah TUHAN yang mengatakannya di dalam cemburu-Ku, tatkala Aku melampiaskan amarah-Ku kepada mereka."
 },
 {
   "id": 20565,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 14,
   "firman": "Aku akan membuat engkau menjadi reruntuhan dan buah celaan di antara bangsa-bangsa yang di sekitarmu di hadapan semua orang yang lintas dari padamu."
 },
 {
   "id": 20566,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 15,
   "firman": "Engkau akan menjadi buah celaan dan cercaan, menjadi peringatan dan suatu kengerian bagi bangsa-bangsa yang di sekitarmu, tatkala Aku menjatuhkan hukuman kepadamu di dalam kemurkaan dan kemarahan dan di dalam penghajaran-penghajaran kemarahan--Aku, TUHAN, yang mengatakannya--"
 },
 {
   "id": 20567,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 16,
   "firman": "tatkala Aku mendatangkan atasmu kelaparan yang dahsyat, yang membinasakan, dan Aku mendatangkannya untuk membinasakan kamu, tatkala Aku memperdahsyat bencana kelaparan atasmu dan memusnahkan persediaan makananmu."
 },
 {
   "id": 20568,
   "kitab": "Yeh",
   "pasal": 5,
   "ayat": 17,
   "firman": "Aku akan mendatangkan kelaparan atasmu dan binatang-binatang buas di tengah-tengahmu, yang akan memunahkan anak-anakmu; sampar akan berkecamuk dan darah akan mengalir di tengah-tengahmu dan Aku akan mendatangkan pedang atasmu, Aku, TUHAN, yang mengatakannya.\""
 },
 {
   "id": 20569,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 1,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20570,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu ke gunung-gunung Israel dan bernubuatlah melawan mereka!"
 },
 {
   "id": 20571,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 3,
   "firman": "Katakanlah: Hai gunung-gunung Israel, dengarkanlah firman Tuhan ALLAH! Beginilah firman Tuhan ALLAH kepada gunung-gunung dan bukit-bukit, kepada alur-alur sungai dan lembah-lembah: Sungguh, Aku akan mendatangkan perang atasmu dan Aku akan membinasakan bukit-bukit pengorbananmu."
 },
 {
   "id": 20572,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 4,
   "firman": "Mezbah-mezbahmu akan menjadi sunyi sepi dan pedupaan-pedupaanmu akan dirusak; dan Aku akan merebahkan orang-orangmu yang terbunuh di hadapan berhala-berhalamu."
 },
 {
   "id": 20573,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 5,
   "firman": "Aku akan mencampakkan mayat-mayat orang Israel di hadapan berhala-berhala mereka dan menghamburkan tulang-tulangmu keliling mezbah-mezbahmu."
 },
 {
   "id": 20574,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 6,
   "firman": "Di mana saja kamu diam, kota-kotamu akan menjadi reruntuhan dan bukit-bukit pengorbananmu akan menjadi sunyi sepi, supaya mezbah-mezbahmu dihancurkan dan ditinggalkan sunyi sepi, berhala-berhalamu diremukkan dan ditiadakan, pedupaan-pedupaanmu diluluhkan dan buatan-buatan tanganmu dihapuskan."
 },
 {
   "id": 20575,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 7,
   "firman": "Dan orang-orangmu yang terbunuh akan berebahan di tengah-tengahmu dan kamu akan mengetahui, bahwa Akulah TUHAN."
 },
 {
   "id": 20576,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tetapi sebagian, yaitu yang terluput dari pedang, akan Kutinggalkan hidup di antara bangsa-bangsa, bilamana kamu dihamburkan ke negeri-negeri itu."
 },
 {
   "id": 20577,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 9,
   "firman": "Di sana, di tengah-tengah bangsa-bangsa, ke mana mereka dibawa tertawan, orang-orang yang terluput dari antara kamu akan mengingat kepada-Ku, tatkala Aku mengembalikan hati mereka yang berzinah itu, yang sudah menjauh dari pada-Ku dan mengalihkan mata mereka, yang selalu berzinah dengan mengikuti berhala-berhala mereka; maka mereka sendiri akan merasa mual melihat kejahatan yang mereka lakukan dan melihat segala perbuatan mereka yang keji."
 },
 {
   "id": 20578,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 10,
   "firman": "Dan mereka akan mengetahui, bahwa Akulah TUHAN dan bukan cakap angin, kalau Aku berfirman hendak menjatuhkan malapetaka ini atas mereka.\""
 },
 {
   "id": 20579,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 11,
   "firman": "Beginilah firman Tuhan ALLAH: \"Bertepuklah dan entakkanlah kakimu ke tanah dan serukanlah: Awas! Oleh sebab segala perbuatan kaum Israel yang keji dan jahat, mereka akan rebah mati karena pedang, kelaparan dan penyakit sampar."
 },
 {
   "id": 20580,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 12,
   "firman": "Yang jauh akan mati karena sampar, yang dekat akan rebah karena pedang dan yang terluput serta terpelihara akan mati karena kelaparan. Demikianlah Aku akan melampiaskan amarah-Ku kepada mereka."
 },
 {
   "id": 20581,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan kamu akan mengetahui, bahwa Akulah TUHAN, tatkala orang-orang mereka yang terbunuh berebahan di tengah-tengah berhala-berhala mereka keliling mezbah-mezbahnya, di atas setiap bukit yang tinggi dan di atas semua puncak-puncak gunung, di bawah setiap pohon yang rimbun dan setiap pohon keramat yang penuh cabang-cabang, di tempat mana mereka membawa korban persembahan yang harum bagi semua berhala-berhala mereka."
 },
 {
   "id": 20582,
   "kitab": "Yeh",
   "pasal": 6,
   "ayat": 14,
   "firman": "Aku akan mengacungkan tangan-Ku melawan mereka dan tanahnya, di mana saja mereka diam, akan Kubuat menjadi musnah dan sunyi sepi mulai dari padang gurun sampai ke Ribla dan mereka akan mengetahui, bahwa Akulah TUHAN.\""
 },
 {
   "id": 20583,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 1,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20584,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 2,
   "firman": "\"Engkau, anak manusia, katakanlah: Beginilah firman Tuhan ALLAH kepada tanah Israel: Berakhir! Berakhirlah keempat penjuru tanah itu."
 },
 {
   "id": 20585,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 3,
   "firman": "Kini kesudahanmu tiba dan Aku akan mencurahkan murka-Ku atasmu dan Aku akan menghakimi engkau selaras dengan tingkah lakumu dan Aku akan membalaskan kepadamu segala perbuatanmu yang keji."
 },
 {
   "id": 20586,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 4,
   "firman": "Aku tidak akan merasa sayang kepadamu dan tidak akan kenal belas kasihan, tetapi Aku akan membalaskan kepadamu selaras dengan tingkah lakumu dan perbuatan-perbuatanmu yang keji akan tertimpa atasmu. Maka kamu akan mengetahui, bahwa Akulah TUHAN."
 },
 {
   "id": 20587,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 5,
   "firman": "Beginilah firman Tuhan ALLAH: Lihat, bencana demi bencana akan datang!"
 },
 {
   "id": 20588,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 6,
   "firman": "Kesudahan datang, kesudahanmu tiba, seakan-akan ia terbangun melawan engkau, lihat datangnya!"
 },
 {
   "id": 20589,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 7,
   "firman": "Malapetaka datang atasmu, hai penduduk negeri! Waktunya datang, saatnya tiba! Hari huru-hara, bukan tempik sorak di atas gunung-gunung."
 },
 {
   "id": 20590,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 8,
   "firman": "Sekarang dengan segera Aku akan mencurahkan amarah-Ku atasmu dan melampiaskan murka-Ku kepadamu, Aku akan menghakimi engkau selaras dengan tingkah lakumu dan membalaskan kepadamu segala perbuatan-perbuatanmu yang keji."
 },
 {
   "id": 20591,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 9,
   "firman": "Aku tidak akan merasa sayang dan tidak akan kenal belas kasihan; selaras dengan tingkah lakumu akan Kubalaskan kepadamu dan perbuatan-perbuatanmu yang keji akan tertimpa atasmu. Maka kamu akan mengetahui, bahwa Aku, Tuhanlah, yang memusnahkan."
 },
 {
   "id": 20592,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 10,
   "firman": "Lihat, harinya sungguh datang: malapetaka akan menimpa, kelaliman bertunas, keangkuhan bertaruk."
 },
 {
   "id": 20593,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 11,
   "firman": "Kekerasan bersimaharajalela, yang menjadi penopang segala kejahatan. Tidak ada dari mereka yang tertinggal, baik dari kelimpahan mereka maupun dari kemewahannya; kemolekannyapun akan terhapus."
 },
 {
   "id": 20594,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 12,
   "firman": "Waktunya datang, harinya mendekat! Biarlah si pembeli jangan bergembira dan biarlah si penjual jangan berdukacita, karena kehangatan murka tertimpa atas segala kegemparan mereka."
 },
 {
   "id": 20595,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 13,
   "firman": "Sebab si penjual tidak akan kembali kepada jualannya, kalaupun mereka masih di tengah-tengah orang hidup, karena kehangatan murka tertimpa atas segala kegemparan mereka dan tidak dapat ditahan lagi, dan seorangpun tidak dapat mempertahankan hidupnya oleh karena kesalahannya."
 },
 {
   "id": 20596,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 14,
   "firman": "Tiuplah sangkakala dan sediakanlah segala sesuatu! Tetapi seorangpun tidak maju berperang, sebab kehangatan murka-Ku tertimpa atas segala kegemparan mereka."
 },
 {
   "id": 20597,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 15,
   "firman": "Pedang ada di luar kota, sampar dan kelaparan ada di dalam. Barangsiapa yang di luar kota akan mati karena pedang, dan barangsiapa yang di dalam kota akan binasa oleh kelaparan dan sampar."
 },
 {
   "id": 20598,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dan kalaupun ada yang terluput dari antara mereka, mereka akan tinggal di gunung-gunung seperti burung perkutut di lembah-lembah, semuanya mengerang, masing-masing karena kesalahannya sendiri."
 },
 {
   "id": 20599,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 17,
   "firman": "Semua tangan terkulai dan semua orang terkencing ketakutan."
 },
 {
   "id": 20600,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 18,
   "firman": "Mereka akan mengenakan kain kabung, kekejutan akan meliputi mereka, semuanya akan kehilangan muka dan semua kepala akan digundul sebagai tanda perkabungan."
 },
 {
   "id": 20601,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 19,
   "firman": "Perak mereka akan dicampakkan ke luar dan emas mereka akan dianggap cemar. Emas dan peraknya tidak akan dapat menyelamatkan mereka pada hari kemurkaan TUHAN. Mereka tidak akan kenyang karenanya dan perut mereka tidak akan terisi dengannya. Sebab hal itu menjadi batu sandungan, yang menjatuhkan mereka ke dalam kesalahan."
 },
 {
   "id": 20602,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 20,
   "firman": "Mereka menghiasi dirinya dengan emas dan peraknya dan kepermaian perhiasan ini membawa mereka dalam kecongkakan. Dari emas dan perak itu mereka membuat patung-patungnya yang keji dan dewa-dewanya yang menjijikkan; oleh sebab itu Aku akan menjadikan emas dan peraknya cemar bagi mereka."
 },
 {
   "id": 20603,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 21,
   "firman": "Aku akan menyerahkannya menjadi rampasan di tangan orang-orang asing dan menjadi jarahan bagi orang-orang fasik di bumi ini, dan mereka ini akan menajiskannya."
 },
 {
   "id": 20604,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 22,
   "firman": "Aku akan memalingkan wajah-Ku dari pada mereka dan perampok-perampok akan menajiskan rumah-Ku yang berharga; mereka akan masuk ke dalamnya dan menajiskannya,"
 },
 {
   "id": 20605,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 23,
   "firman": "serta memusnahkannya. Sebab negeri itu penuh hutang darah dan kota itu penuh kekerasan."
 },
 {
   "id": 20606,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 24,
   "firman": "Aku akan membiarkan datang bangsa-bangsa yang paling kejam dan bangsa-bangsa ini akan mengambil rumah-rumah mereka menjadi miliknya; Aku akan mengakhiri kecongkakan mereka, yang ditimbulkan kekuatan mereka itu, dan tempat-tempat kudus mereka akan dinajiskan."
 },
 {
   "id": 20607,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 25,
   "firman": "Ketakutan datang, dan mereka mencari keselamatan, tetapi tidak ada."
 },
 {
   "id": 20608,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 26,
   "firman": "Bencana demi bencana akan datang, kabar demi kabar akan tersiar. Mereka akan menginginkan suatu penglihatan dari nabi, pengajaran hilang lenyap dari imam, dan nasihat dari tua-tua."
 },
 {
   "id": 20609,
   "kitab": "Yeh",
   "pasal": 7,
   "ayat": 27,
   "firman": "Raja akan berkabung dan pemimpin akan diliputi kekagetan dan tangan seluruh penduduk negeri itu menjadi lemas ketakutan. Aku akan perbuat terhadap mereka selaras dengan tingkah lakunya dan Aku akan menghakimi mereka selaras dengan cara mereka menghakimi. Dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 20610,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada tahun keenam, dalam bulan yang keenam, pada tanggal lima bulan itu, waktu aku duduk di rumahku berhadap-hadapan dengan para tua-tua Yehuda, kekuasaan Tuhan ALLAH meliputi aku di sana,"
 },
 {
   "id": 20611,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 2,
   "firman": "dan aku menerima penglihatan: Sungguh, ada kelihatan yang menyerupai seorang laki-laki, dari yang menyerupai pinggangnya sampai ke bawah kelihatan seperti api dan dari pinggangnya ke atas kelihatan seperti cahaya, seperti suasa mengkilat."
 },
 {
   "id": 20612,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 3,
   "firman": "Dia mengulurkan sesuatu yang berbentuk tangan dan dipegang-Nya jambul kepalaku. Lalu Roh itu mengangkat aku ke antara langit dan bumi dan membawa aku dalam penglihatan-penglihatan ilahi ke Yerusalem dekat pintu gerbang pelataran dalam yang menghadap ke utara, di mana terdapat berhala cemburuan, yang menimbulkan cemburu itu."
 },
 {
   "id": 20613,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 4,
   "firman": "Lihat, di sana tampak kemuliaan Allah Israel, seperti penglihatan yang kulihat di lembah itu."
 },
 {
   "id": 20614,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 5,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, lihatlah ke utara!\" Aku melihat ke utara, sungguh, di sebelah utara gerbang mezbah, dekat jalan masuk, terdapat berhala cemburuan tadi."
 },
 {
   "id": 20615,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 6,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, kaulihatkah apa yang mereka perbuat, yaitu perbuatan-perbuatan kekejian yang besar-besar, yang dilakukan oleh kaum Israel di sini, sehingga Aku harus menjauhkan diri dari tempat kudus-Ku? Engkau masih akan melihat perbuatan-perbuatan kekejian yang lebih besar lagi.\""
 },
 {
   "id": 20616,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 7,
   "firman": "Dan dibawa-Nya aku ke pintu pelataran, aku melihat, sungguh, ada sebuah lobang di dalam temboknya."
 },
 {
   "id": 20617,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 8,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, perbesarlah lobang yang di tembok itu!\" Sesudah aku memperbesar lobang itu, lihat, ada sebuah pintu."
 },
 {
   "id": 20618,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 9,
   "firman": "Firman-Nya kepadaku: \"Masuklah dan lihatlah perbuatan-perbuatan kekejian yang jahat, yang mereka lakukan di sini.\""
 },
 {
   "id": 20619,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 10,
   "firman": "Lalu aku masuk dan melihat, sungguh, segala gambar-gambar binatang melata dan binatang-binatang lain yang menjijikkan dan segala berhala-berhala kaum Israel terukir pada tembok sekelilingnya."
 },
 {
   "id": 20620,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dan di hadapannya berdiri tujuh puluh orang tua-tua kaum Israel, dengan Yaazanya bin Safan di tengah-tengah mereka dan masing-masing memegang bokor ukupannya di tangannya, dan keharuman dari asap ukupan itu naik ke atas."
 },
 {
   "id": 20621,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 12,
   "firman": "Firman-Nya kepadaku: \"Kaulihatkah, hai anak manusia, apa yang dilakukan oleh tua-tua kaum Israel di dalam kegelapan, masing-masing di dalam kamar tempat ukiran-ukiran mereka? Sebab mereka berkata: TUHAN tidak melihat kita; TUHAN sudah meninggalkan tanah ini.\""
 },
 {
   "id": 20622,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 13,
   "firman": "Ditambahkan-Nya lagi: \"Engkau masih akan melihat perbuatan-perbuatan kekejian yang lebih besar lagi yang mereka lakukan.\""
 },
 {
   "id": 20623,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 14,
   "firman": "Lalu dibawa-Nya aku dekat pintu gerbang rumah TUHAN yang di sebelah utara, sungguh, di sana ada perempuan-perempuan yang menangisi dewa Tamus."
 },
 {
   "id": 20624,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 15,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, kaulihatkah apa yang mereka perbuat? Engkau masih akan melihat perbuatan-perbuatan kekejian yang lebih besar lagi dari pada ini.\""
 },
 {
   "id": 20625,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 16,
   "firman": "Kemudian dibawa-Nya aku ke pelataran dalam rumah TUHAN; sungguh, dekat jalan masuk ke bait TUHAN, di antara balai Bait Suci dan mezbah ada kira-kira dua puluh lima orang laki-laki, yang membelakangi bait TUHAN dan menghadap ke sebelah timur sambil sujud pada matahari di sebelah timur."
 },
 {
   "id": 20626,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 17,
   "firman": "Lalu firman-Nya kepadaku: \"Kaulihatkah itu, hai anak manusia? Perkara kecilkah itu bagi kaum Yehuda untuk melakukan perbuatan-perbuatan kekejian yang mereka lakukan di sini, bahwa mereka memenuhi tanah ini dengan kekerasan dan dengan itu terus menyakiti hati-Ku? Sungguh, mereka berkelakuan tak senonoh di hadapan-Ku."
 },
 {
   "id": 20627,
   "kitab": "Yeh",
   "pasal": 8,
   "ayat": 18,
   "firman": "Oleh karena itu Aku akan membalas di dalam kemurkaan-Ku. Aku tidak akan merasa sayang dan tidak akan kenal belas kasihan. Dan kalaupun mereka berseru-seru kepada-Ku dengan suara yang nyaring, Aku tidak akan mendengarkan mereka.\""
 },
 {
   "id": 20628,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 1,
   "firman": "Lalu aku mendengar Dia berseru dengan suara yang nyaring: \"Maju ke mari, hai, yang harus menjalankan hukuman atas kota ini! Masing-masing dengan alat pemusnah di tangannya!\""
 },
 {
   "id": 20629,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 2,
   "firman": "Lihat, enam orang laki-laki datang dari jurusan pintu gerbang Atas, yang menghadap ke utara, masing-masing dengan alat pemukul di tangannya. Dan satu orang di antara mereka berpakaian lenan dan di sisinya terdapat suatu alat penulis. Mereka ini masuk dan berdiri di samping mezbah tembaga."
 },
 {
   "id": 20630,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 3,
   "firman": "Pada saat itu kemuliaan Allah Israel sudah terangkat dari atas kerub, tempatnya semula, ke atas ambang pintu Bait Suci dan Dia memanggil orang yang berpakaian lenan dan yang mempunyai alat penulis di sisinya."
 },
 {
   "id": 20631,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 4,
   "firman": "Firman TUHAN kepadanya: \"Berjalanlah dari tengah-tengah kota, yaitu Yerusalem dan tulislah huruf T pada dahi orang-orang yang berkeluh kesah karena segala perbuatan-perbuatan keji yang dilakukan di sana.\""
 },
 {
   "id": 20632,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan kepada yang lain-lain aku mendengar Dia berfirman: \"Ikutilah dia dari belakang melalui kota itu dan pukullah sampai mati! Janganlah merasa sayang dan jangan kenal belas kasihan."
 },
 {
   "id": 20633,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 6,
   "firman": "Orang-orang tua, teruna-teruna dan dara-dara, anak-anak kecil dan perempuan-perempuan, bunuh dan musnahkan! Tetapi semua orang yang ditandai dengan huruf T itu, jangan singgung! Dan mulailah dari tempat kudus-Ku!\" Lalu mereka mulai dengan tua-tua yang berada di hadapan Bait Suci."
 },
 {
   "id": 20634,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 7,
   "firman": "Kemudian firman-Nya kepada mereka: \"Najiskanlah Bait Suci itu dan penuhilah pelataran-pelatarannya dengan orang-orang yang terbunuh. Pergilah!\" Mereka pergi ke luar dan memukuli orang-orang sampai mati di dalam kota."
 },
 {
   "id": 20635,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 8,
   "firman": "Sedang mereka memukuli orang-orang sampai mati--waktu itu aku tinggal di belakang--aku sujud dan berseru, kataku: \"Aduh, Tuhan ALLAH, apakah Engkau memusnahkan seluruh sisa Israel di dalam mencurahkan amarah-Mu atas Yerusalem?\""
 },
 {
   "id": 20636,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 9,
   "firman": "Jawab-Nya kepadaku: \"Kesalahan kaum Israel dan Yehuda sangat banyak, sehingga tanah ini penuh hutang darah dan kota ini penuh ketidakadilan; sebab mereka berkata: TUHAN sudah meninggalkan tanah ini dan TUHAN tidak melihatnya."
 },
 {
   "id": 20637,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 10,
   "firman": "Karena itu Aku juga tidak akan merasa sayang dan tidak akan kenal belas kasihan; kelakuan mereka akan Kutimpakan atas kepala mereka.\""
 },
 {
   "id": 20638,
   "kitab": "Yeh",
   "pasal": 9,
   "ayat": 11,
   "firman": "Lihat, orang yang berpakaian lenan itu dan yang mempunyai alat penulis di sisinya memberikan laporan, katanya: \"Aku sudah kerjakan seperti Engkau perintahkan kepadaku.\""
 },
 {
   "id": 20639,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 1,
   "firman": "Lalu aku melihat, sungguh, di atas cakrawala yang di atas kepala kerub tampak di atas mereka sesuatu yang menyerupai takhta, yang seperti permata lazurit kelihatannya."
 },
 {
   "id": 20640,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 2,
   "firman": "Maka Ia berkata kepada orang yang berpakaian lenan itu: \"Masuklah ke bawah kerub dari antara roda-rodanya dan penuhilah rangkup tanganmu dengan bara api dari tengah-tengah kerub itu dan hamburkan ke atas kota itu.\" Lalu aku melihat dia masuk."
 },
 {
   "id": 20641,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 3,
   "firman": "Kerub-kerub itu berdiri di sebelah selatan Bait Suci, waktu orang itu masuk ke tengah-tengah roda-rodanya; dan segumpal awan memenuhi pelataran dalam."
 },
 {
   "id": 20642,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 4,
   "firman": "Dalam pada itu kemuliaan TUHAN naik dari atas kerub dan pergi ke atas ambang pintu Bait Suci, dan Bait Suci ini dipenuhi oleh awan itu dan pelatarannya penuh dengan sinar kemuliaan TUHAN."
 },
 {
   "id": 20643,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 5,
   "firman": "Suara sayap kerub itu terdengar sampai pelataran luar seperti suara ALLAH Yang Mahakuasa, kalau Ia berfirman."
 },
 {
   "id": 20644,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 6,
   "firman": "Ia memerintahkan kepada orang yang berpakaian lenan itu: \"Ambillah api dari tengah-tengah roda-rodanya, dari tengah-tengah kerub itu!\" Maka yang berpakaian lenan ini pergi berdiri di samping salah satu dari roda-roda itu."
 },
 {
   "id": 20645,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 7,
   "firman": "Lalu seorang kerub itu mengulurkan tangannya dari tengah kerub-kerub ke api yang ada di tengah-tengah mereka, diambilnya sedikit dan ditaruhnya di dalam tangan orang yang berpakaian lenan. Orang ini menerimanya dan pergi."
 },
 {
   "id": 20646,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 8,
   "firman": "Pada kerub-kerub itu tampak yang menyerupai tangan manusia di bawah sayap mereka."
 },
 {
   "id": 20647,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 9,
   "firman": "Aku melihat, sungguh, di samping kerub-kerub itu terdapat empat roda, satu roda di samping seorang kerub, dan roda-roda ini kelihatannya seperti kilauan permata pirus."
 },
 {
   "id": 20648,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 10,
   "firman": "Kelihatannya keempatnya adalah serupa, seolah-olah roda yang satu di tengah-tengah yang lain."
 },
 {
   "id": 20649,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 11,
   "firman": "Kalau mereka berjalan mereka dapat menuju keempat jurusan tanpa berbalik kalau berjalan; karena tempat mana yang dituju oleh yang di muka, ke situlah pergi yang lain-lain, tanpa berbalik kalau berjalan."
 },
 {
   "id": 20650,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 12,
   "firman": "Seluruh badan mereka, punggungnya, tangannya, sayapnya, dan roda-rodanya penuh dengan mata sekelilingnya, ya, roda-roda mereka berempat juga."
 },
 {
   "id": 20651,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 13,
   "firman": "Aku dengar bahwa roda-rodanya disebut \"puting beliung\"."
 },
 {
   "id": 20652,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 14,
   "firman": "Masing-masing mempunyai empat muka: muka yang pertama ialah muka kerub, yang kedua ialah muka manusia, yang ketiga ialah muka singa dan yang keempat ialah muka rajawali."
 },
 {
   "id": 20653,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kerub-kerub itu naik ke atas. Itulah makhluk-makhluk hidup yang dahulu kulihat di tepi sungai Kebar."
 },
 {
   "id": 20654,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 16,
   "firman": "Kalau kerub-kerub itu berjalan, roda-roda itu juga berjalan di samping mereka; kalau kerub-kerub itu mengangkat sayapnya untuk terbang dari tanah, roda-roda itu tidak bergerak dari samping mereka."
 },
 {
   "id": 20655,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 17,
   "firman": "Kalau kerub-kerub itu berhenti, roda-roda itu berhenti, kalau kerub-kerub itu naik ke atas, roda-roda itu sama-sama naik dengan mereka; sebab roh makhluk-makhluk hidup itu ialah di dalam roda-roda itu."
 },
 {
   "id": 20656,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lalu kemuliaan TUHAN pergi dari ambang pintu Bait Suci dan hinggap di atas kerub-kerub."
 },
 {
   "id": 20657,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 19,
   "firman": "Dan kerub-kerub itu mengangkat sayap mereka, dan waktu mereka pergi, aku lihat, mereka naik dari tanah dan roda-rodanya bersama-sama dengan mereka. Lalu mereka berhenti dekat pintu gerbang rumah TUHAN yang di sebelah timur, sedang kemuliaan Allah Israel berada di atas mereka."
 },
 {
   "id": 20658,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 20,
   "firman": "Itulah makhluk-makhluk hidup yang dahulu kulihat di bawah Allah Israel di tepi sungai Kebar. Dan aku mengerti, bahwa mereka adalah kerub-kerub."
 },
 {
   "id": 20659,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 21,
   "firman": "Masing-masing mempunyai empat muka dan bagi masing-masing ada empat sayap dan di bawah sayap mereka ada yang berbentuk tangan manusia."
 },
 {
   "id": 20660,
   "kitab": "Yeh",
   "pasal": 10,
   "ayat": 22,
   "firman": "Kelihatannya muka mereka adalah serupa dengan muka yang kulihat di tepi sungai Kebar. Masing-masing berjalan lurus ke mukanya."
 },
 {
   "id": 20661,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 1,
   "firman": "Lalu Roh itu mengangkat aku dan membawa aku ke pintu gerbang Timur dari rumah TUHAN, pintu yang menghadap ke sebelah timur. Lihat, di dalam pintu gerbang itu ada dua puluh lima orang dan di antara mereka kulihat Yaazanya bin Azur dan Pelaca bin Benaya, yaitu pemimpin-pemimpin bangsa."
 },
 {
   "id": 20662,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 2,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, inilah orang-orang yang merancang kedurjanaan dan menaburkan nasihat jahat di kota ini,"
 },
 {
   "id": 20663,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 3,
   "firman": "yang mengatakan: Bukankah belum lama berselang rumah-rumah kita dibangun kembali? Kota inilah periuk dan kita dagingnya."
 },
 {
   "id": 20664,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 4,
   "firman": "Oleh sebab itu bernubuatlah melawan mereka, bernubuatlah, hai anak manusia!\""
 },
 {
   "id": 20665,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 5,
   "firman": "Maka Roh TUHAN meliputi aku dan TUHAN berfirman kepadaku: \"Katakanlah: Beginilah firman TUHAN: Kamu berkata-kata begini, hai kaum Israel, dan Aku tahu apa yang timbul dalam hatimu."
 },
 {
   "id": 20666,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 6,
   "firman": "Orang-orang yang kamu bunuh di kota ini bertambah banyak dan kamu penuhi jalan-jalannya dengan mereka."
 },
 {
   "id": 20667,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 7,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Orang-orang yang kamu bunuh di kota ini, merekalah dagingnya dan kota inilah periuk, tetapi kamu akan Kugiring keluar dari dalamnya."
 },
 {
   "id": 20668,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 8,
   "firman": "Kamu takut kepada pedang, tetapi Aku akan mendatangkan pedang atasmu, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20669,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 9,
   "firman": "Aku akan menggiring kamu keluar dari dalamnya dan menyerahkan kamu di tangan orang-orang asing dan menjatuhkan hukuman-hukuman kepadamu."
 },
 {
   "id": 20670,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 10,
   "firman": "Kamu akan berebahan karena pedang dan di tanah Israel Aku akan menghukum kamu; dan kamu akan mengetahui, bahwa Akulah TUHAN."
 },
 {
   "id": 20671,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 11,
   "firman": "Kota ini tidak akan menjadi periuk bagimu ataupun kamu seakan-akan daging di dalamnya; di tanah Israel Aku akan menghukum kamu."
 },
 {
   "id": 20672,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 12,
   "firman": "Dan kamu akan mengetahui, bahwa Akulah TUHAN, karena kelakuanmu tidak selaras dengan ketetapan-ketetapan-Ku dan peraturan-peraturan-Ku tidak kamu lakukan; bahkan engkau melakukan peraturan-peraturan bangsa-bangsa yang di sekitarmu.\""
 },
 {
   "id": 20673,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 13,
   "firman": "Maka sedang aku bernubuat, matilah Pelaca bin Benaya. Lalu aku sujud dan berseru dengan suara nyaring, kataku: \"Aduh, Tuhan ALLAH, apakah Engkau menghabiskan sisa Israel?\""
 },
 {
   "id": 20674,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 14,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20675,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 15,
   "firman": "\"Hai anak manusia, penduduk-penduduk Yerusalem berkata tentang semua saudara-saudaramu, tentang kaum kerabatmu dan segenap kaum Israel dalam keseluruhannya: Mereka telah jauh dari TUHAN, kepada kami tanah ini diberikan menjadi milik."
 },
 {
   "id": 20676,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 16,
   "firman": "Oleh sebab itu katakanlah: Beginilah firman Tuhan ALLAH: Walaupun Aku membawa mereka jauh-jauh di antara bangsa-bangsa dan menyerakkan mereka di negeri-negeri itu dan Aku menjadi tempat kudus yang sedikit artinya bagi mereka di negeri-negeri di mana mereka datang,"
 },
 {
   "id": 20677,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 17,
   "firman": "oleh sebab itu katakanlah: Beginilah firman Tuhan ALLAH: Aku akan menghimpunkan kamu dari bangsa-bangsa dan mengumpulkan kamu dari negeri-negeri di mana kamu berserak, dan Aku akan memberikan kamu tanah Israel."
 },
 {
   "id": 20678,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 18,
   "firman": "Maka sesudah mereka datang di sana, mereka akan menjauhkan segala dewa-dewanya yang menjijikkan dan segala perbuatan-perbuatan yang keji dari tanah itu."
 },
 {
   "id": 20679,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 19,
   "firman": "Aku akan memberikan mereka hati yang lain dan roh yang baru di dalam batin mereka; juga Aku akan menjauhkan dari tubuh mereka hati yang keras dan memberikan mereka hati yang taat,"
 },
 {
   "id": 20680,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 20,
   "firman": "supaya mereka hidup menurut segala ketetapan-Ku dan peraturan-peraturan-Ku dengan setia; maka mereka akan menjadi umat-Ku dan Aku akan menjadi Allah mereka."
 },
 {
   "id": 20681,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 21,
   "firman": "Mengenai mereka, yang hatinya berpaut pada dewa-dewanya yang menjijikkan dan pada perbuatan-perbuatannya yang keji, Aku akan menimpakan kelakuan mereka atas kepalanya sendiri, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20682,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 22,
   "firman": "Maka kerub-kerub itu mengangkat sayap mereka, dan roda-rodanya bergerak bersama-sama dengan mereka, sedang kemuliaan Allah Israel berada di atas mereka."
 },
 {
   "id": 20683,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 23,
   "firman": "Lalu kemuliaan TUHAN naik ke atas dari tengah-tengah kota dan hinggap di atas gunung yang di sebelah timur kota."
 },
 {
   "id": 20684,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 24,
   "firman": "Dan Roh itu mengangkat aku dan membawa aku kembali di dalam penglihatan yang dari Roh Allah ke negeri Kasdim kepada para buangan. Lalu menghilanglah penglihatan yang kulihat itu dari padaku"
 },
 {
   "id": 20685,
   "kitab": "Yeh",
   "pasal": 11,
   "ayat": 25,
   "firman": "dan aku sampaikan kepada para buangan itu segala sesuatu yang diperlihatkan TUHAN kepadaku."
 },
 {
   "id": 20686,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 1,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20687,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 2,
   "firman": "\"Hai anak manusia, engkau tinggal di tengah-tengah kaum pemberontak, yang mempunyai mata untuk melihat, tetapi tidak melihat dan mempunyai telinga untuk mendengar, tetapi tidak mendengar, sebab mereka adalah kaum pemberontak."
 },
 {
   "id": 20688,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 3,
   "firman": "Maka engkau, anak manusia, sediakanlah bagimu barang-barang seorang buangan dan berjalanlah seperti seorang buangan pada siang hari di hadapan mata mereka; pergilah dari tempatmu sekarang ke tempat yang lain seperti seorang buangan di hadapan mata mereka. Barangkali mereka akan insaf bahwa mereka adalah kaum pemberontak."
 },
 {
   "id": 20689,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 4,
   "firman": "Bawalah barang-barangmu itu ke luar seperti barang-barang seorang buangan pada siang hari di hadapan mata mereka; dan engkau sendiri harus keluar pada malam hari di hadapan mata mereka, seperti seorang yang harus keluar dan pergi ke pembuangan."
 },
 {
   "id": 20690,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 5,
   "firman": "Di hadapan mata mereka perbuatlah sebuah lobang di tembok dan keluarlah dari situ."
 },
 {
   "id": 20691,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 6,
   "firman": "Di hadapan mata mereka taruhlah barang-barangmu ke atas bahumu, dan bawalah itu ke luar pada malam gelap; engkau harus menutupi mukamu, sehingga engkau tidak melihat tanah; sebab Aku membuat engkau menjadi lambang bagi kaum Israel.\""
 },
 {
   "id": 20692,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 7,
   "firman": "Lalu kulakukan seperti diperintahkan kepadaku: aku membawa pada siang hari barang-barang seperti barang-barang seorang buangan dan pada malam hari aku membuat dengan tanganku sebuah lobang di tembok, pada malam gelap aku keluar dan di hadapan mata mereka aku menaruh barang-barangku ke atas bahuku."
 },
 {
   "id": 20693,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 8,
   "firman": "Pada hari besoknya datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20694,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 9,
   "firman": "\"Hai anak manusia, bukankah ditanya oleh kaum Israel, kaum pemberontak itu kepadamu: Apakah yang kaulakukan ini?"
 },
 {
   "id": 20695,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 10,
   "firman": "Katakanlah kepada mereka: beginilah firman Tuhan ALLAH: Ucapan ilahi ini mengenai raja di Yerusalem dan seluruh kaum Israel yang tinggal di sana."
 },
 {
   "id": 20696,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 11,
   "firman": "Katakanlah: Aku menjadi lambang bagimu; seperti yang kulakukan ini begitulah akan berlaku kepada mereka: sebagai orang buangan mereka akan pergi ke pembuangan."
 },
 {
   "id": 20697,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 12,
   "firman": "Dan raja yang di tengah-tengah mereka akan menaruh barang-barangnya ke atas bahunya pada malam gelap dan akan pergi ke luar; orang akan membuat sebuah lobang di tembok supaya ada baginya jalan keluar; ia akan menutupi mukanya supaya ia tidak akan melihat tanah itu."
 },
 {
   "id": 20698,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 13,
   "firman": "Aku akan memasang jaring-Ku untuk menangkap dia dan di dalam perangkap-Ku dia akan terjebak dan Aku akan membawa dia ke Babel, tanah orang Kasdim, tetapi tanah itu sendiri tidak akan dilihatnya; ia akan mati di sana."
 },
 {
   "id": 20699,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 14,
   "firman": "Dan semua yang di sekitarnya, para pembantunya dan bala tentaranya, akan Kuhamburkan ke semua mata angin dan Aku akan menghunus pedang dari belakang mereka."
 },
 {
   "id": 20700,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 15,
   "firman": "Maka mereka akan mengetahui bahwa Akulah TUHAN, apabila aku menyerakkan mereka di antara bangsa-bangsa dan menghamburkan mereka ke semua negeri."
 },
 {
   "id": 20701,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 16,
   "firman": "Tetapi Aku akan meninggalkan sedikit dari mereka yang luput dari pedang, dari kelaparan dan dari sampar, supaya mereka menceriterakan segala perbuatan-perbuatan mereka yang keji di antara bangsa-bangsa, di mana mereka datang; dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 20702,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 17,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20703,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 18,
   "firman": "\"Hai anak manusia, makanlah makananmu dengan gemetar dan minumlah air dengan menggigil dan dengan hati yang cemas,"
 },
 {
   "id": 20704,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 19,
   "firman": "dan katakanlah kepada penduduk negeri ini: Beginilah firman Tuhan ALLAH tentang penduduk Yerusalem yang di tanah Israel: Mereka akan makan makanannya dengan hati yang cemas dan minum air dengan hati yang gundah-gulana supaya tanah mereka menjadi sunyi sepi lantaran isinya sudah lenyap, oleh karena kekerasan yang dilakukan oleh semua yang tinggal di sana."
 },
 {
   "id": 20705,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 20,
   "firman": "Kota-kota yang masih didiami orang akan menjadi reruntuhan dan tanah itu akan menjadi sunyi sepi; dan kamu akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 20706,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 21,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20707,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 22,
   "firman": "\"Hai anak manusia, sindiran apakah itu yang hidup di antara kamu di tanah Israel, yang berbunyi: Sudah lama berselang, tetapi satu penglihatanpun tak jadi?"
 },
 {
   "id": 20708,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 23,
   "firman": "Oleh karena itu katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Aku akan menghentikan sindiran ini dan orang tidak akan mengucapkannya lagi di tanah Israel. Sebaliknya, katakanlah kepada mereka: Waktunya sudah dekat dan tiap penglihatan akan jadi."
 },
 {
   "id": 20709,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 24,
   "firman": "Sebab tidak akan ada lagi penglihatan yang menipu ataupun tenungan yang menyesatkan di tengah-tengah kaum Israel,"
 },
 {
   "id": 20710,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 25,
   "firman": "sebab Aku, TUHAN, akan berfirman dan apa yang Kufirmankan akan terjadi, dan firman itu tidak akan ditunda-tunda lagi, sebab pada masa hidupmu, hai kaum pemberontak, Aku akan mengucapkan suatu firman dan Aku akan menggenapinya, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20711,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 26,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20712,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 27,
   "firman": "\"Hai anak manusia, lihatlah, kaum Israel berkata: Penglihatan yang dilihatnya itu, harinya masih jauh, nubuatan yang diucapkannya, waktunya masih lama."
 },
 {
   "id": 20713,
   "kitab": "Yeh",
   "pasal": 12,
   "ayat": 28,
   "firman": "Oleh karena itu katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Tidak satupun dari firman-Ku akan ditunda-tunda. Apa yang Kufirmankan akan terjadi, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20714,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 1,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20715,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 2,
   "firman": "\"Hai anak manusia, bernubuatlah melawan nabi-nabi Israel, bernubuatlah dan katakanlah kepada mereka yang bernubuat sesuka hatinya saja: Dengarlah firman TUHAN!"
 },
 {
   "id": 20716,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 3,
   "firman": "Beginilah firman Tuhan ALLAH: Celakalah nabi-nabi yang bebal yang mengikuti bisikan hatinya sendiri dan yang tidak melihat sesuatu penglihatan."
 },
 {
   "id": 20717,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 4,
   "firman": "Seperti anjing hutan di tengah-tengah reruntuhan, begitulah nabi-nabimu, hai Israel!"
 },
 {
   "id": 20718,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 5,
   "firman": "Kamu tidak mempertahankan lobang-lobang pada tembokmu dan tidak mendirikan tembok sekeliling rumah Israel, supaya mereka dapat tetap berdiri di dalam peperangan pada hari TUHAN."
 },
 {
   "id": 20719,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 6,
   "firman": "Penglihatan mereka menipu dan tenungan mereka adalah bohong; mereka berkata: Demikianlah firman TUHAN, padahal TUHAN tidak mengutus mereka, dan mereka menanti firman itu digenapi-Nya."
 },
 {
   "id": 20720,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 7,
   "firman": "Bukankah penglihatan tipuan yang kamu lihat dan tenungan bohong yang kamu katakan, kalau kamu berkata: Demikianlah firman TUHAN, padahal Aku tidak berbicara?"
 },
 {
   "id": 20721,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 8,
   "firman": "Sebab itu, beginilah firman Tuhan ALLAH, oleh karena kamu mengatakan kata-kata dusta dan melihat perkara-perkara bohong, maka Aku akan menjadi lawanmu, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20722,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 9,
   "firman": "Aku akan mengacungkan tangan-Ku melawan nabi-nabi yang melihat perkara-perkara yang menipu dan yang mengucapkan tenungan-tenungan bohong; mereka tidak termasuk perkumpulan umat-Ku dan tidak akan tercatat dalam daftar kaum Israel, dan tidak akan masuk lagi di tanah Israel; dan kamu akan mengetahui bahwa Akulah Tuhan ALLAH."
 },
 {
   "id": 20723,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 10,
   "firman": "Oleh karena, ya sungguh karena mereka menyesatkan umat-Ku dengan mengatakan: Damai sejahtera!, padahal sama sekali tidak ada damai sejahtera--mereka itu mendirikan tembok dan lihat, mereka mengapurnya--"
 },
 {
   "id": 20724,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 11,
   "firman": "katakanlah kepada mereka yang mengapur tembok itu: Hujan lebat akan membanjir, rambun akan jatuh dan angin tofan akan bertiup!"
 },
 {
   "id": 20725,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 12,
   "firman": "Kalau tembok itu sudah runtuh, apakah orang tidak akan berkata kepadamu: Di mana sekarang kapur, yang kamu oleskan itu?"
 },
 {
   "id": 20726,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 13,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Di dalam amarah-Ku Aku akan membuat angin tofan bertiup dan di dalam murka-Ku hujan lebat akan membanjir, dan di dalam amarah-Ku rambun yang membinasakan akan jatuh."
 },
 {
   "id": 20727,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 14,
   "firman": "Dan Aku akan meruntuhkan tembok yang kamu kapur itu dan merobohkannya ke tanah, supaya dasarnya menjadi kelihatan; tembok kota itu akan runtuh dan kamu akan tewas di dalamnya. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 20728,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 15,
   "firman": "Begitulah Aku akan melampiaskan amarah-Ku atas tembok itu dan kepada mereka yang mengapurnya dan Aku akan berkata kepadamu: Lenyap temboknya dan lenyap orang-orang yang mengapurnya,"
 },
 {
   "id": 20729,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 16,
   "firman": "yaitu nabi-nabi Israel yang bernubuat tentang Yerusalem dan melihat baginya suatu penglihatan mengenai damai sejahtera, padahal sama sekali tidak ada damai sejahtera, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20730,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 17,
   "firman": "\"Engkau anak manusia, tujukanlah mukamu kepada kaum perempuan bangsamu yang bernubuat sesuka hatinya saja dan bernubuatlah melawan mereka."
 },
 {
   "id": 20731,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 18,
   "firman": "Katakanlah: Beginilah firman Tuhan ALLAH: Celakalah dukun-dukun perempuan, yang mengikatkan tali-tali azimat pada semua pergelangan dan mengenakan selubung pada kepala semua orang, tua atau muda, untuk menangkap jiwa orang. Apakah kamu hendak menangkap jiwa orang yang termasuk umat-Ku dan membiarkan orang-orang lain hidup untuk kepentinganmu?"
 },
 {
   "id": 20732,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kamu melanggar kekudusan-Ku di tengah-tengah umat-Ku hanya demi beberapa genggam jelai dan beberapa potong roti, dengan membunuh orang-orang yang tidak patut mati, dan membiarkan hidup orang-orang yang tidak patut hidup, dalam hal kamu berbohong kepada umat-Ku yang sedia mendengar bohong."
 },
 {
   "id": 20733,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 20,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Aku akan menentang tali-tali azimatmu, dengan mana kamu menangkap jiwa orang dan Aku akan mengoyakkannya dari tanganmu dan melepaskan seperti burung-burung, orang-orang yang kamu tangkap."
 },
 {
   "id": 20734,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 21,
   "firman": "Aku akan mengoyakkan selubungmu dan akan melepaskan umat-Ku dari tanganmu dan mereka tidak lagi menjadi mangsa di dalam tanganmu. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 20735,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 22,
   "firman": "Oleh karena kamu melemahkan hati orang benar dengan dusta, sedang Aku tidak mendukakan hatinya, dan sebaliknya kamu mengeraskan hati orang fasik, sehingga ia tidak bertobat dari kelakuannya yang fasik itu, dan kamu membiarkan dia hidup."
 },
 {
   "id": 20736,
   "kitab": "Yeh",
   "pasal": 13,
   "ayat": 23,
   "firman": "Oleh sebab itu kamu tidak lagi melihat perkara-perkara yang menipu dan mengucapkan tenungan-tenungan bohong; Aku akan melepaskan umat-Ku dari tanganmu dan kamu akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 20737,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 1,
   "firman": "Sesudah itu datanglah kepadaku beberapa orang dari tua-tua Israel dan duduk di hadapanku."
 },
 {
   "id": 20738,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 2,
   "firman": "Maka datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20739,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 3,
   "firman": "\"Hai anak manusia, orang-orang ini menjunjung berhala-berhala mereka dalam hatinya dan menempatkan di hadapan mereka batu sandungan, yang menjatuhkan mereka ke dalam kesalahan. Apakah Aku mau mereka meminta petunjuk dari pada-Ku?"
 },
 {
   "id": 20740,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 4,
   "firman": "Oleh sebab itu berbicaralah kepada mereka dan katakan: Beginilah firman Tuhan ALLAH: Setiap orang dari kaum Israel yang menjunjung berhala-berhalanya dalam hatinya dan menempatkan di hadapannya batu sandungan yang menjatuhkannya ke dalam kesalahan, lalu datang menemui nabi--Aku, TUHAN sendiri akan menjawab dia oleh karena berhala-berhalanya yang banyak itu,"
 },
 {
   "id": 20741,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 5,
   "firman": "supaya Aku memikat hati kaum Israel, yang seluruhnya sudah menyimpang dari pada-Ku dengan mengikuti segala berhala-berhala mereka."
 },
 {
   "id": 20742,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 6,
   "firman": "Oleh karena itu katakanlah kepada kaum Israel: Beginilah firman Tuhan ALLAH: Bertobatlah dan berpalinglah dari berhala-berhalamu dan palingkanlah mukamu dari segala perbuatan-perbuatanmu yang keji."
 },
 {
   "id": 20743,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 7,
   "firman": "Karena setiap orang, baik dari kaum Israel maupun dari orang-orang asing yang tinggal di tengah-tengah Israel, yang menyimpang dari pada-Ku dan menjunjung berhala-berhalanya dalam hatinya dan menempatkan di hadapannya batu sandungan, yang menjatuhkannya ke dalam kesalahan, lalu datang menemui nabi untuk meminta petunjuk dari pada-Ku baginya--Aku, TUHAN sendiri akan menjawab dia."
 },
 {
   "id": 20744,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 8,
   "firman": "Aku sendiri akan menentang orang itu dan Aku akan membuat dia menjadi lambang dan kiasan dan melenyapkannya dari tengah-tengah umat-Ku. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 20745,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 9,
   "firman": "Jikalau nabi itu membiarkan dirinya tergoda dengan mengatakan suatu ucapan--Aku, TUHAN yang menggoda nabi itu--maka Aku akan mengacungkan tangan-Ku melawan dia dan memunahkannya dari tengah-tengah umat-Ku Israel."
 },
 {
   "id": 20746,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 10,
   "firman": "Mereka akan menanggung kesalahannya sendiri, baik yang meminta petunjuk maupun nabi,"
 },
 {
   "id": 20747,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 11,
   "firman": "supaya kaum Israel jangan lagi sesat dari pada-Ku dan jangan lagi menajiskan dirinya dengan segala pelanggaran mereka; dengan demikian mereka akan menjadi umat-Ku dan Aku akan menjadi Allah mereka, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20748,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 12,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20749,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 13,
   "firman": "\"Hai anak manusia, kalau sesuatu negeri berdosa kepada-Ku dengan berobah setia dan Aku mengacungkan tangan-Ku melawannya dengan memusnahkan persediaan makanannya dan mendatangkan kelaparan atasnya dan melenyapkan dari negeri itu manusia dan binatang,"
 },
 {
   "id": 20750,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 14,
   "firman": "biarpun di tengah-tengahnya berada ketiga orang ini, yaitu Nuh, Daniel dan Ayub, mereka akan menyelamatkan hanya nyawanya sendiri karena kebenaran mereka, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20751,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 15,
   "firman": "Atau jikalau Aku membuat binatang buas berkeliaran di negeri itu, yang memunahkan penduduknya, sehingga negeri itu menjadi sunyi sepi, dan tidak seorangpun berani melintasinya karena binatang buas itu,"
 },
 {
   "id": 20752,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 16,
   "firman": "dan biarpun di tengah-tengahnya berada ketiga orang tadi, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, mereka tidak akan menyelamatkan baik anak-anak lelaki maupun anak-anak perempuan; hanya mereka sendiri akan diselamatkan, tetapi negeri itu akan menjadi sunyi sepi."
 },
 {
   "id": 20753,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 17,
   "firman": "Atau jikalau Aku membawa pedang atas negeri itu dan Aku berfirman: Hai pedang, jelajahilah negeri itu!, dan Aku melenyapkan dari negeri itu manusia dan binatang,"
 },
 {
   "id": 20754,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 18,
   "firman": "dan biarpun di tengah-tengahnya berada ketiga orang tadi, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, mereka tidak akan menyelamatkan baik anak-anak lelaki maupun anak-anak perempuan, tetapi hanya mereka sendiri akan diselamatkan."
 },
 {
   "id": 20755,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 19,
   "firman": "Atau jikalau Aku mendatangkan sampar atas negeri itu dan Aku mencurahkan amarah-Ku atasnya sehingga darah mengalir dengan melenyapkan dari negeri itu manusia dan binatang,"
 },
 {
   "id": 20756,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 20,
   "firman": "dan biarpun Nuh, Daniel dan Ayub berada di tengah-tengahnya, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, mereka tidak akan menyelamatkan baik anak laki-laki maupun anak perempuan, melainkan mereka akan menyelamatkan hanya nyawanya sendiri karena kebenaran mereka."
 },
 {
   "id": 20757,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 21,
   "firman": "Ya, beginilah firman Tuhan ALLAH: Jauh lebih dari itu, kalau Aku mendatangkan keempat hukuman-Ku yang berat-berat, yaitu pedang, kelaparan, binatang buas dan sampar, atas Yerusalem untuk melenyapkan dari padanya manusia dan binatang!"
 },
 {
   "id": 20758,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 22,
   "firman": "Tetapi sungguh, akan tertinggal di sana orang yang terluput, yang mengiring ke luar anak-anak lelaki dan perempuan; lihat, mereka akan datang kepadamu dan kamu akan melihat tingkah laku mereka dan kamu akan merasa terhibur tentang malapetaka yang Kudatangkan atas Yerusalem, ya tentang segala-galanya yang Kudatangkan atasnya."
 },
 {
   "id": 20759,
   "kitab": "Yeh",
   "pasal": 14,
   "ayat": 23,
   "firman": "Mereka akan menghibur kamu, kalau kamu melihat tingkah lakunya, dan kamu akan mengetahui bahwa bukan tanpa alasan Kuperbuat segala sesuatu yang Kuperbuat atas Yerusalem, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20760,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 1,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20761,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 2,
   "firman": "\"Hai anak manusia, apakah kelebihan kayu anggur dari semua kayu yang buahnya seperti anggur yang tumbuh di antara kayu-kayu di hutan?"
 },
 {
   "id": 20762,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 3,
   "firman": "Apakah orang mengambil kayunya untuk membuat sesuatu dari padanya ataukah membuat gantungan dari padanya untuk menggantungkan segala macam perkakas padanya?"
 },
 {
   "id": 20763,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 4,
   "firman": "Sungguh, kayu itu dilemparkan ke dalam api untuk dibakar; kedua ujungnya habis dimakan api dan tengah-tengahnya sedang menyala, bergunakah lagi itu untuk membuat sesuatu?"
 },
 {
   "id": 20764,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 5,
   "firman": "Lihat, sedangkan waktu ia masih utuh, tidak dipakai untuk sesuatu, apalagi sesudah dimakan api dan terbakar; apakah masih dapat lagi dipakai untuk sesuatu?"
 },
 {
   "id": 20765,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 6,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Seperti kayu anggur di antara kayu-kayu di hutan, yang Kulemparkan ke dalam api untuk dibakar, begitulah Aku lakukan terhadap penduduk Yerusalem."
 },
 {
   "id": 20766,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 7,
   "firman": "Aku sendiri akan menentang mereka. Walaupun mereka luput dari api, tetapi api akan memakan mereka. Dan kamu akan mengetahui bahwa Akulah TUHAN, pada saat Aku menentang mereka"
 },
 {
   "id": 20767,
   "kitab": "Yeh",
   "pasal": 15,
   "ayat": 8,
   "firman": "dan Aku menjadikan negeri itu sunyi sepi, oleh karena mereka berobah setia, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20768,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 1,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20769,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 2,
   "firman": "\"Hai anak manusia, beritahukanlah kepada Yerusalem perbuatan-perbuatannya yang keji"
 },
 {
   "id": 20770,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 3,
   "firman": "dan katakanlah: Beginilah firman Tuhan ALLAH kepada Yerusalem: Asalmu dan kelahiranmu ialah dari tanah Kanaan; ayahmu ialah orang Amori dan ibumu orang Heti."
 },
 {
   "id": 20771,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 4,
   "firman": "Kelahiranmu begini: Waktu engkau dilahirkan, pusatmu tidak dipotong dan engkau tidak dibasuh dengan air supaya bersih; juga dengan garampun engkau tidak digosok atau dibedungi dengan lampin."
 },
 {
   "id": 20772,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 5,
   "firman": "Tidak seorangpun merasa sayang kepadamu sehingga diperbuatnya hal-hal itu kepadamu dari rasa belas kasihan; malahan engkau dibuang ke ladang, oleh karena orang pandang enteng kepadamu pada hari lahirmu."
 },
 {
   "id": 20773,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 6,
   "firman": "Maka Aku lalu dari situ dan Kulihat engkau menendang-nendang dengan kakimu sambil berlumuran darah dan Aku berkata kepadamu dalam keadaan berlumuran darah itu: Engkau harus hidup"
 },
 {
   "id": 20774,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 7,
   "firman": "dan jadilah besar seperti tumbuh-tumbuhan di ladang! Engkau menjadi besar dan sudah cukup umur, bahkan sudah sampai pada masa mudamu. Maka buah dadamu sudah montok, rambutmu sudah tumbuh, tetapi engkau dalam keadaan telanjang bugil."
 },
 {
   "id": 20775,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 8,
   "firman": "Maka Aku lalu dari situ dan Aku melihat engkau, sungguh, engkau sudah sampai pada masa cinta berahi. Aku menghamparkan kain-Ku kepadamu dan menutupi auratmu. Dengan sumpah Aku mengadakan perjanjian dengan engkau, demikianlah firman Tuhan ALLAH, dan dengan itu engkau Aku punya."
 },
 {
   "id": 20776,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 9,
   "firman": "Aku membasuh engkau dengan air untuk membersihkan darahmu dari padamu dan Aku mengurapi engkau dengan minyak."
 },
 {
   "id": 20777,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 10,
   "firman": "Aku mengenakan pakaian berwarna-warna kepadamu dan memberikan engkau sandal-sandal dari kulit lumba-lumba dan tutup kepala dari lenan halus dan selendang dari sutera."
 },
 {
   "id": 20778,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 11,
   "firman": "Dan Aku menghiasi engkau dengan perhiasan-perhiasan dan mengenakan gelang pada tanganmu dan kalung pada lehermu."
 },
 {
   "id": 20779,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 12,
   "firman": "Dan Aku mengenakan anting-anting pada hidungmu dan anting-anting pada telingamu dan mahkota kemuliaan di atas kepalamu."
 },
 {
   "id": 20780,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 13,
   "firman": "Dengan demikian engkau menghias dirimu dengan emas dan perak, pakaianmu lenan halus dan sutera dan kain berwarna-warna; makananmu ialah tepung yang terbaik, madu dan minyak dan engkau menjadi sangat cantik, sehingga layak menjadi ratu."
 },
 {
   "id": 20781,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 14,
   "firman": "Dan namamu termasyhur di antara bangsa-bangsa karena kecantikanmu, sebab sangat sempurna adanya, oleh karena semarak perhiasan-Ku yang Kuberikan kepadamu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20782,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 15,
   "firman": "\"Tetapi engkau mengandalkan kecantikanmu dan engkau seumpama bersundal dalam menganggarkan ketermasyhuranmu dan engkau menghamburkan persundalanmu kepada setiap orang yang lewat."
 },
 {
   "id": 20783,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 16,
   "firman": "Engkau mengambil dari pakaian-pakaianmu untuk membuat bukit-bukit pengorbananmu berwarna-warni dan engkau bersundal di situ; seperti itu belum pernah terjadi dan tidak akan ada lagi."
 },
 {
   "id": 20784,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 17,
   "firman": "Engkau mengambil juga perhiasan-perhiasanmu yang dibuat dari emas-Ku dan perak-Ku, yang Kuberikan kepadamu, dan engkau membuat bagimu patung-patung lelaki dan engkau bersundal dengan mereka."
 },
 {
   "id": 20785,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 18,
   "firman": "Engkau mengambil dari pakaianmu yang berwarna-warni untuk menutupi mereka dan engkau mempersembahkan kepada mereka minyak-Ku dan ukupan-Ku."
 },
 {
   "id": 20786,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 19,
   "firman": "Juga makanan-Ku yang Kuberikan kepadamu--tepung yang terbaik, minyak dan madu Kuberikan makananmu--engkau persembahkan kepada mereka menjadi persembahan yang harum, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20787,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 20,
   "firman": "Bahkan, engkau mengambil anak-anakmu lelaki dan perempuan yang engkau lahirkan bagi-Ku dan mempersembahkannya kepada mereka menjadi makanan mereka. Apakah persundalanmu ini masih perkara enteng"
 },
 {
   "id": 20788,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 21,
   "firman": "bahwa engkau menyembelih anak-anak-Ku dan menyerahkannya kepada mereka dengan mempersembahkannya sebagai korban dalam api?"
 },
 {
   "id": 20789,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 22,
   "firman": "Dalam segala perbuatan-perbuatanmu yang keji dan persundalanmu itu engkau tidak teringat lagi kepada masa mudamu, waktu engkau telanjang bugil sambil menendang-nendang dengan kakimu dalam lumuran darahmu."
 },
 {
   "id": 20790,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 23,
   "firman": "Dan sesudah segala kejahatanmu itu--celaka, celakalah engkau! Demikianlah firman Tuhan ALLAH--"
 },
 {
   "id": 20791,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 24,
   "firman": "engkau membangun bagimu tempat yang tinggi dan membuat bagimu bukit pengorbanan di tiap-tiap tanah lapang."
 },
 {
   "id": 20792,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 25,
   "firman": "Pada setiap persimpangan jalan engkau membangun bukit pengorbanan dan menjual kecantikanmu menjadi kekejian dengan merenggangkan kedua pahamu bagi setiap orang yang lewat, sehingga persundalanmu bertambah-tambah."
 },
 {
   "id": 20793,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 26,
   "firman": "Engkau bersundal dengan orang Mesir, tetanggamu, si aurat besar itu, sehingga persundalanmu bertambah-tambah, yang menimbulkan sakit hati-Ku."
 },
 {
   "id": 20794,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 27,
   "firman": "Lihat, Aku telah melawan engkau dan telah mengurangi bagianmu dan menyerahkan engkau kepada kesewenang-wenangan orang-orang yang membenci engkau, yaitu perempuan-perempuan Filistin, yang merasa malu melihat tingkah lakumu yang mesum itu."
 },
 {
   "id": 20795,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 28,
   "firman": "Engkau bersundal juga dengan orang Asyur, oleh karena engkau belum merasa puas; ya, engkau bersundal dengan mereka, tetapi masih belum merasa puas."
 },
 {
   "id": 20796,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 29,
   "firman": "Engkau memperbanyak lagi persundalanmu dengan negeri perdagangan Kasdim, tetapi dengan itu juga engkau belum merasa puas."
 },
 {
   "id": 20797,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 30,
   "firman": "Betapa besar hawa nafsumu itu, demikianlah firman Tuhan ALLAH, engkau yang melakukan segala-galanya ini, yaitu perbuatan seorang perempuan sundal jahanam,"
 },
 {
   "id": 20798,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 31,
   "firman": "yang membangun tempatmu yang tinggi pada setiap persimpangan jalan dan membuat bukit pengorbananmu di tiap-tiap tanah lapang. Tetapi engkau tidak seperti sundal biasa, oleh karena engkau menolak upah sundal."
 },
 {
   "id": 20799,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 32,
   "firman": "Hai isteri yang berzinah, yang memeluk orang-orang lain ganti suaminya sendiri."
 },
 {
   "id": 20800,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 33,
   "firman": "Kepada semua perempuan sundal orang memberi upah, tetapi engkau sebaliknya, engkau yang memberi hadiah umpan kepada semua yang mencintai engkau sebagai bujukan, supaya mereka dari sekitarmu datang kepadamu untuk bersundal."
 },
 {
   "id": 20801,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 34,
   "firman": "Maka dalam persundalanmu engkau adalah kebalikan dari perempuan-perempuan yang lain; bukan orang yang mengejar engkau hendak bersundal; tetapi engkau yang memberi upah persundalan, sedang engkau tidak diberi apa-apa; itulah kebalikannya padamu."
 },
 {
   "id": 20802,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 35,
   "firman": "Oleh karena itu, hai perempuan sundal, dengarkanlah firman TUHAN!"
 },
 {
   "id": 20803,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 36,
   "firman": "Beginilah firman Tuhan ALLAH: Oleh karena engkau menghamburkan kemesumanmu dan auratmu disingkapkan dalam persundalanmu dengan orang yang mencintaimu dan dengan berhala-berhalamu yang keji dan oleh karena darah anak-anakmu yang engkau persembahkan kepada mereka,"
 },
 {
   "id": 20804,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 37,
   "firman": "sungguh, oleh karena itu Aku akan mengumpulkan semua kekasihmu, yaitu yang merayu hatimu, baik yang engkau cintai maupun yang engkau benci; Aku akan mengumpulkan mereka dari sekitarmu untuk melawan engkau dan Aku akan menyingkapkan auratmu di hadapan mereka, sehingga mereka melihat seluruh kemaluanmu."
 },
 {
   "id": 20805,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 38,
   "firman": "Aku akan menghakimi engkau seperti orang menghakimi perempuan-perempuan yang berzinah dan yang menumpahkan darah dan Aku akan melampiaskan atasmu murka dan cemburuan-Ku."
 },
 {
   "id": 20806,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 39,
   "firman": "Aku akan menyerahkan engkau di dalam tangan mereka dan mereka akan meruntuhkan tempatmu yang tinggi dan merusakkan bukit-bukitmu, mereka akan menelanjangi engkau, akan merampas perhiasan-perhiasanmu dan membiarkan engkau telanjang bugil."
 },
 {
   "id": 20807,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 40,
   "firman": "Mereka akan menyuruh bangkit sekumpulan orang melawan engkau, yang melempari engkau dengan batu dan memancung engkau dengan pedang-pedang mereka."
 },
 {
   "id": 20808,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 41,
   "firman": "Mereka akan membakar rumah-rumahmu dan menjatuhkan hukuman kepadamu di hadapan banyak perempuan. Dengan demikian Aku membuat engkau berhenti bersundal dan upah sundal tidak akan kauberikan lagi."
 },
 {
   "id": 20809,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 42,
   "firman": "Demikianlah Aku melampiaskan murka-Ku kepadamu sehingga cemburu-Ku kepadamu reda kembali; barulah Aku merasa tenang dan tidak sakit hati lagi."
 },
 {
   "id": 20810,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 43,
   "firman": "Oleh karena engkau tidak teringat lagi kepada masa mudamu, tetapi dengan semuanya ini membuat Aku gemetar kemarahan, sungguh, Aku juga akan menimpakan kelakuanmu atas kepalamu, demikianlah firman Tuhan ALLAH. Bukankah engkau melakukan kemesuman ini lagi di samping segala perbuatan-perbuatanmu yang keji?"
 },
 {
   "id": 20811,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 44,
   "firman": "Lihat, setiap penyair akan mengatakan sindiran ini mengenai engkau: Begitu ibu, begitu anak!"
 },
 {
   "id": 20812,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 45,
   "firman": "Anak ibumu engkau, yang jijik melihat suaminya dan anak-anaknya lelaki, dan adik kakak-kakakmu perempuan engkau, yang jijik melihat suami-suami mereka dan anak-anak mereka lelaki. Ibumu adalah orang Heti dan ayahmu adalah orang Amori."
 },
 {
   "id": 20813,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 46,
   "firman": "Kakakmu yang tertua ialah Samaria, yang beserta anak-anaknya perempuan diam di sebelah utaramu, dan kakakmu yang termuda ialah Sodom, yang beserta anak-anaknya perempuan diam di sebelah selatanmu."
 },
 {
   "id": 20814,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 47,
   "firman": "Bukankah engkau hidup menurut perbuatan mereka dan engkau lakukan seperti perbuatan-perbuatan mereka yang keji; sebentar lagi saja engkau berbuat lebih jahat dari mereka dalam seluruh hidupmu."
 },
 {
   "id": 20815,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 48,
   "firman": "Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, sesungguh-sungguhnya Sodom, kakakmu yang termuda beserta anak-anaknya perempuan tidak berbuat seperti engkau lakukan beserta anak-anakmu perempuan."
 },
 {
   "id": 20816,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 49,
   "firman": "Lihat, inilah kesalahan Sodom, kakakmu yang termuda itu: kecongkakan, makanan yang berlimpah-limpah dan kesenangan hidup ada padanya dan pada anak-anaknya perempuan, tetapi ia tidak menolong orang-orang sengsara dan miskin."
 },
 {
   "id": 20817,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 50,
   "firman": "Mereka menjadi tinggi hati dan melakukan kekejian di hadapan-Ku; maka Aku menjauhkan mereka sesudah Aku melihat itu."
 },
 {
   "id": 20818,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 51,
   "firman": "Dan Samaria tidak membuat setengahpun dari dosa-dosamu, bahkan engkau melakukan lebih banyak kekejian dari mereka berdua, sehingga dengan segala kekejian-kekejianmu yang engkau lakukan, engkau membuat kakak-kakakmu perempuan kelihatan benar."
 },
 {
   "id": 20819,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 52,
   "firman": "Tanggunglah nodamu, hai engkau, yang mengakibatkan hukuman lebih ringan kepada kakak-kakakmu perempuan; dengan dosa-dosamu yang lebih keji dari mereka, mereka lebih benar dari padamu. Biarlah engkau merasa malu dan tanggunglah nodamu, oleh karena engkau membuat kakak-kakakmu perempuan kelihatan benar.\""
 },
 {
   "id": 20820,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 53,
   "firman": "\"Tetapi Aku akan memulihkan keadaan mereka, baik keadaan Sodom bersama anak-anaknya perempuan maupun keadaan Samaria bersama anak-anaknya perempuan, dan juga Aku akan memulihkan keadaanmu di tengah-tengah mereka,"
 },
 {
   "id": 20821,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 54,
   "firman": "supaya engkau menanggung nodamu dan supaya engkau merasa malu karena segala perbuatanmu, sehingga engkau menjadi penghiburan bagi mereka."
 },
 {
   "id": 20822,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 55,
   "firman": "Mengenai kakak-kakakmu, Sodom bersama anak-anaknya perempuan akan dipulihkan ke dalam keadaannya semula; Samaria juga bersama anak-anaknya perempuan akan dipulihkan ke dalam keadaannya semula; dan engkaupun bersama anak-anakmu perempuan akan dipulihkan ke dalam keadaanmu semula."
 },
 {
   "id": 20823,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 56,
   "firman": "Bukankah Sodom, kakakmu yang termuda, menjadi buah bibirmu pada masa kecongkakanmu,"
 },
 {
   "id": 20824,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 57,
   "firman": "sebelum kejahatanmu menjadi nyata, seperti pada saat ini engkau diaibkan oleh anak-anak perempuan Edom dengan semua yang di sekitarnya dan anak-anak perempuan Filistin, yang menghina engkau dari sekitarmu?"
 },
 {
   "id": 20825,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 58,
   "firman": "Kemesumanmu dan perbuatan-perbuatanmu yang keji harus engkau tanggung, demikianlah firman TUHAN."
 },
 {
   "id": 20826,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 59,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Aku akan melakukan kepadamu seperti engkau lakukan, yaitu engkau memandang ringan kepada sumpah dengan mengingkari perjanjian."
 },
 {
   "id": 20827,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 60,
   "firman": "Tetapi Aku akan mengingat perjanjian-Ku dengan engkau pada masa mudamu dan Aku akan meneguhkan bagimu perjanjian yang kekal."
 },
 {
   "id": 20828,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 61,
   "firman": "Barulah engkau teringat kepada kelakuanmu dan engkau merasa malu, pada waktu Aku mengambil kakak-kakakmu, baik yang tertua maupun yang termuda, dan memberikan mereka kepadamu menjadi anakmu, tetapi bukan berdasarkan engkau memegang perjanjian."
 },
 {
   "id": 20829,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 62,
   "firman": "Aku akan meneguhkan perjanjian-Ku dengan engkau, dan engkau akan mengetahui bahwa Akulah TUHAN,"
 },
 {
   "id": 20830,
   "kitab": "Yeh",
   "pasal": 16,
   "ayat": 63,
   "firman": "dan dengan itu engkau akan teringat-ingat yang dulu dan merasa malu, sehingga mulutmu terkatup sama sekali karena nodamu, waktu Aku mengadakan pendamaian bagimu karena segala perbuatanmu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20831,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 1,
   "firman": "Maka datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20832,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 2,
   "firman": "\"Hai anak manusia, katakanlah suatu teka-teki dan ucapkanlah suatu perumpamaan kepada kaum Israel."
 },
 {
   "id": 20833,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 3,
   "firman": "Katakanlah: Beginilah firman Tuhan ALLAH: Seekor burung rajawali yang besar dengan sayapnya yang besar dan panjang, penuh dengan bulu yang berwarna-warna datang ke gunung Libanon dan ia mengambil puncak pohon aras."
 },
 {
   "id": 20834,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 4,
   "firman": "Ia mematahkan pucuknya yang paling ujung dan dibawanya ke sebuah negeri perdagangan lalu diletakkannya dia di kota perniagaan."
 },
 {
   "id": 20835,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 5,
   "firman": "Ia mengambil sebuah dari taruk-taruk tanah itu dan menanamnya di ladang yang sudah sedia ditaburi; ia menempatkannya dekat air yang berlimpah-limpah seperti pohon gandarusa"
 },
 {
   "id": 20836,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 6,
   "firman": "sehingga ia tumbuh dan menjadi pohon anggur yang rimbun, yang tumbuhnya rendah dan cabang-cabangnya melengkung menuju burung itu dan akar-akarnya tetap di bawahnya. Demikianlah ia menjadi pohon anggur dan mengeluarkan tunas-tunas dan memancarkan taruk-taruk."
 },
 {
   "id": 20837,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 7,
   "firman": "Dalam pada itu ada juga burung rajawali besar yang lain dengan sayapnya yang besar dan bulu yang lebat. Dan sungguh, pohon anggur ini mengarahkan akar-akarnya ke burung itu dan cabang-cabangnya dijulurkannya kepadanya, supaya burung itu mengairi dia lebih baik dari bedeng di mana ia ditanam."
 },
 {
   "id": 20838,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 8,
   "firman": "Namun ia ditanam di ladang yang baik, dekat air yang berlimpah-limpah, supaya ia bercabang-cabang dan berbuah dan supaya menjadi pohon anggur yang bagus."
 },
 {
   "id": 20839,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 9,
   "firman": "Katakanlah: Beginilah firman Tuhan ALLAH: Apakah itu akan berhasil? Apakah orang tidak akan mencabut akar-akarnya dan menyentakkan buahnya, sehingga semua ulamnya yang baru menjadi kering? Tidak usah tangan yang kuat dan banyak orang untuk mencabut dia dengan akar-akarnya."
 },
 {
   "id": 20840,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 10,
   "firman": "Lihat, ia memang ditanam, tetapi apakah ia akan memberi hasil? Apakah ia tidak akan layu kering kalau ditimpa angin timur? Ia akan layu kering di bedeng tempat tumbuhnya itu.\""
 },
 {
   "id": 20841,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 11,
   "firman": "Maka datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20842,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 12,
   "firman": "\"Katakanlah kepada kaum pemberontak: Tidakkah kamu mengetahui apa artinya ini? Katakan: Lihat, raja Babel datang ke Yerusalem dan ia mengambil rajanya dan pemuka-pemukanya dan membawa mereka ke Babel baginya."
 },
 {
   "id": 20843,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 13,
   "firman": "Lalu ia mengambil seorang yang berasal dari keturunan raja dan mengadakan perjanjian dengan dia sambil menyuruh dia bersumpah. Ia mengambil juga orang-orang berkuasa negeri itu,"
 },
 {
   "id": 20844,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 14,
   "firman": "supaya kerajaan itu menjadi lemah dan jangan memberontak lagi, juga supaya memegang teguh perjanjian itu dan dengan demikian tetap ada."
 },
 {
   "id": 20845,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 15,
   "firman": "Tetapi orang itu memberontak kepadanya dengan menyuruh utusannya ke Mesir, supaya ia diberi kuda dan tentara yang besar. Apakah ia akan berhasil? Apakah orang yang berbuat demikian dapat luput? Apakah orang yang mengingkari perjanjian dapat luput?"
 },
 {
   "id": 20846,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 16,
   "firman": "Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, ia pasti mati di Babel, di tempat raja yang mengangkatnya menjadi raja. Karena ia memandang ringan kepada sumpah yang dimintakan raja itu dari padanya dan mengingkari perjanjian raja itu dengan dia."
 },
 {
   "id": 20847,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 17,
   "firman": "Dan Firaun tidak akan membantu dia dalam peperangan dengan tentara yang besar dan sekumpulan banyak orang, pada waktu tembok pengepungan ditimbun dan benteng pengepungan didirikan untuk melenyapkan banyak orang."
 },
 {
   "id": 20848,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 18,
   "firman": "Ya, ia memandang ringan kepada sumpah dan mengingkari perjanjian. Sungguh, walaupun ia menyungguhkan hal itu dengan berjabat tangan, tetapi ia melanggar semuanya itu, maka ia tidak dapat luput."
 },
 {
   "id": 20849,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 19,
   "firman": "Oleh sebab itu, beginilah firman Tuhan ALLAH: Demi Aku yang hidup, Aku pasti menimpakan atas kepalanya sumpahnya kepada-Ku, yang dipandangnya ringan dan perjanjiannya di hadapan-Ku, yang diingkarinya."
 },
 {
   "id": 20850,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 20,
   "firman": "Aku akan memasang jaring-Ku untuk menangkap dia dan di dalam perangkap-Ku ia akan terjebak; Aku akan membawa dia ke Babel dan di sana Aku akan berperkara dengan dia, karena ia berobah setia terhadap Aku."
 },
 {
   "id": 20851,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 21,
   "firman": "Dan semua tentara pilihannya akan tewas dimakan pedang dan yang terluput akan dihamburkan ke semua mata angin. Dan kamu akan mengetahui bahwa Akulah TUHAN, yang mengatakannya."
 },
 {
   "id": 20852,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 22,
   "firman": "Beginilah firman Tuhan ALLAH: Aku sendiri akan mengambil sebuah carang dari puncak pohon aras yang tinggi dan menanamnya; Aku mematahkannya dari pucuk yang paling ujung dan yang masih muda dan Aku sendiri akan menanamnya di atas sebuah gunung yang menjulang tinggi ke atas;"
 },
 {
   "id": 20853,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 23,
   "firman": "di atas gunung Israel yang tinggi akan Kutanam dia, agar ia bercabang-cabang dan berbuah dan menjadi pohon aras yang hebat; segala macam burung dan yang berbulu bersayap tinggal di bawahnya, mereka bernaung di bawah cabang-cabangnya."
 },
 {
   "id": 20854,
   "kitab": "Yeh",
   "pasal": 17,
   "ayat": 24,
   "firman": "Maka segala pohon di ladang akan mengetahui, bahwa Aku, TUHAN, merendahkan pohon yang tinggi dan meninggikan pohon yang rendah, membuat pohon yang tumbuh menjadi layu kering dan membuat pohon yang layu kering bertaruk kembali. Aku, TUHAN, yang mengatakannya dan akan membuatnya.\""
 },
 {
   "id": 20855,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 1,
   "firman": "Maka datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20856,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 2,
   "firman": "\"Ada apa dengan kamu, sehingga kamu mengucapkan kata sindiran ini di tanah Israel: Ayah-ayah makan buah mentah dan gigi anak-anaknya menjadi ngilu?"
 },
 {
   "id": 20857,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 3,
   "firman": "Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, kamu tidak akan mengucapkan kata sindiran ini lagi di Israel."
 },
 {
   "id": 20858,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 4,
   "firman": "Sungguh, semua jiwa Aku punya! Baik jiwa ayah maupun jiwa anak Aku punya! Dan orang yang berbuat dosa, itu yang harus mati."
 },
 {
   "id": 20859,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 5,
   "firman": "Kalau seseorang adalah orang benar dan ia melakukan keadilan dan kebenaran,"
 },
 {
   "id": 20860,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 6,
   "firman": "dan ia tidak makan daging persembahan di atas gunung atau tidak melihat kepada berhala-berhala kaum Israel, tidak mencemari isteri sesamanya dan tidak menghampiri perempuan waktu bercemar kain,"
 },
 {
   "id": 20861,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 7,
   "firman": "tidak menindas orang lain, ia mengembalikan gadaian orang, tidak merampas apa-apa, memberi makan orang lapar, memberi pakaian kepada orang telanjang,"
 },
 {
   "id": 20862,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 8,
   "firman": "tidak memungut bunga uang atau mengambil riba, menjauhkan diri dari kecurangan, melakukan hukum yang benar di antara manusia dengan manusia,"
 },
 {
   "id": 20863,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 9,
   "firman": "hidup menurut ketetapan-Ku dan tetap mengikuti peraturan-Ku dengan berlaku setia--ialah orang benar, dan ia pasti hidup, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20864,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 10,
   "firman": "Tetapi kalau ia melahirkan seorang anak yang menjadi perampok, dan yang suka menumpahkan darah atau melakukan salah satu dari hal-hal itu"
 },
 {
   "id": 20865,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 11,
   "firman": "--walaupun ayah tidak melakukan satupun--juga makan daging persembahan di atas gunung dan mencemari isteri sesamanya,"
 },
 {
   "id": 20866,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 12,
   "firman": "menindas orang sengsara dan miskin, merampas, tidak mengembalikan gadaian orang, melihat kepada berhala-berhala dan melakukan kekejian,"
 },
 {
   "id": 20867,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 13,
   "firman": "memungut bunga uang dan mengambil riba, orang yang demikian tidak akan hidup. Segala kekejian ini dilakukannya, ia harus mati; darahnya tertimpa kepadanya sendiri."
 },
 {
   "id": 20868,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 14,
   "firman": "Sesungguhnya, kalau ia melahirkan seorang anak dan anak ini melihat segala dosa yang dilakukan ayahnya, tetapi menginsafi hal itu, sehingga tidak melakukan seperti itu:"
 },
 {
   "id": 20869,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 15,
   "firman": "ia tidak makan daging persembahan di atas gunung dan tidak melihat kepada berhala-berhala kaum Israel, tidak mencemari isteri sesamanya,"
 },
 {
   "id": 20870,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 16,
   "firman": "tidak menindas orang lain, tidak mau meminta gadai, tidak merampas apa-apa, memberi makan orang lapar, memberi pakaian kepada orang telanjang,"
 },
 {
   "id": 20871,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 17,
   "firman": "menjauhkan diri dari kecurangan, tidak mengambil bunga uang atau riba, melakukan peraturan-Ku dan hidup menurut ketetapan-Ku--orang yang demikian tidak akan mati karena kesalahan ayahnya, ia pasti hidup."
 },
 {
   "id": 20872,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 18,
   "firman": "Ayahnya, yang melakukan pemerasan, yang merampas sesuatu, dan yang melakukan hal-hal yang tidak baik di tengah-tengah bangsanya, sungguh, ia akan mati karena kesalahannya."
 },
 {
   "id": 20873,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 19,
   "firman": "Tetapi kamu berkata: Mengapa anak tidak turut menanggung kesalahan ayahnya? --Karena anak itu melakukan keadilan dan kebenaran, melakukan semua ketetapan-Ku dengan setia, maka ia pasti hidup."
 },
 {
   "id": 20874,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 20,
   "firman": "Orang yang berbuat dosa, itu yang harus mati. Anak tidak akan turut menanggung kesalahan ayahnya dan ayah tidak akan turut menanggung kesalahan anaknya. Orang benar akan menerima berkat kebenarannya, dan kefasikan orang fasik akan tertanggung atasnya."
 },
 {
   "id": 20875,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 21,
   "firman": "Tetapi jikalau orang fasik bertobat dari segala dosa yang dilakukannya dan berpegang pada segala ketetapan-Ku serta melakukan keadilan dan kebenaran, ia pasti hidup, ia tidak akan mati."
 },
 {
   "id": 20876,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 22,
   "firman": "Segala durhaka yang dibuatnya tidak akan diingat-ingat lagi terhadap dia; ia akan hidup karena kebenaran yang dilakukannya."
 },
 {
   "id": 20877,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 23,
   "firman": "Apakah Aku berkenan kepada kematian orang fasik? demikianlah firman Tuhan ALLAH. Bukankah kepada pertobatannya supaya ia hidup?"
 },
 {
   "id": 20878,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 24,
   "firman": "Jikalau orang benar berbalik dari kebenarannya dan melakukan kecurangan seperti segala kekejian yang dilakukan oleh orang fasik--apakah ia akan hidup? Segala kebenaran yang dilakukannya tidak akan diingat-ingat lagi. Ia harus mati karena ia berobah setia dan karena dosa yang dilakukannya."
 },
 {
   "id": 20879,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 25,
   "firman": "Tetapi kamu berkata: Tindakan Tuhan tidak tepat! Dengarlah dulu, hai kaum Israel, apakah tindakan-Ku yang tidak tepat ataukah tindakanmu yang tidak tepat?"
 },
 {
   "id": 20880,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 26,
   "firman": "Kalau orang benar berbalik dari kebenarannya dan melakukan kecurangan sehingga ia mati, ia harus mati karena kecurangan yang dilakukannya."
 },
 {
   "id": 20881,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 27,
   "firman": "Sebaliknya, kalau orang fasik bertobat dari kefasikan yang dilakukannya dan ia melakukan keadilan dan kebenaran, ia akan menyelamatkan nyawanya."
 },
 {
   "id": 20882,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 28,
   "firman": "Ia insaf dan bertobat dari segala durhaka yang dibuatnya, ia pasti hidup, ia tidak akan mati."
 },
 {
   "id": 20883,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 29,
   "firman": "Tetapi kaum Israel berkata: Tindakan Tuhan tidak tepat! Apakah tindakan-Ku yang tidak tepat, hai kaum Israel, ataukah tindakanmu yang tidak tepat?"
 },
 {
   "id": 20884,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 30,
   "firman": "Oleh karena itu Aku akan menghukum kamu masing-masing menurut tindakannya, hai kaum Israel, demikianlah firman Tuhan ALLAH. Bertobatlah dan berpalinglah dari segala durhakamu, supaya itu jangan bagimu menjadi batu sandungan, yang menjatuhkan kamu ke dalam kesalahan."
 },
 {
   "id": 20885,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 31,
   "firman": "Buangkanlah dari padamu segala durhaka yang kamu buat terhadap Aku dan perbaharuilah hatimu dan rohmu! Mengapakah kamu akan mati, hai kaum Israel?"
 },
 {
   "id": 20886,
   "kitab": "Yeh",
   "pasal": 18,
   "ayat": 32,
   "firman": "Sebab Aku tidak berkenan kepada kematian seseorang yang harus ditanggungnya, demikianlah firman Tuhan ALLAH. Oleh sebab itu, bertobatlah, supaya kamu hidup!\""
 },
 {
   "id": 20887,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 1,
   "firman": "Hai, ucapkanlah suatu ratapan mengenai raja Israel,"
 },
 {
   "id": 20888,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 2,
   "firman": "dan katakanlah begini: \"Betapa ibumu menjadi seekor singa betina di antara singa-singa! Ia berbaring di antara singa-singa muda, dan menyusui anak-anaknya."
 },
 {
   "id": 20889,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 3,
   "firman": "Ia membesarkan seekor dari anak-anaknya, sehingga menjadi singa muda; ia belajar menerkam, malah manusia ditelannya."
 },
 {
   "id": 20890,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 4,
   "firman": "Bangsa-bangsa menyerukan: Singa mengamuk! akhirnya ia terjebak dalam pelubang mereka; mereka mengelikir dia dan menggiringnya ke Mesir."
 },
 {
   "id": 20891,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 5,
   "firman": "Sesudah induk singa menyadari bahwa usahanya gagal dan pengharapannya hilang lenyap, ia mengambil anaknya yang lain dan membesarkannya menjadi singa muda."
 },
 {
   "id": 20892,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 6,
   "firman": "Anaknya ini berjalan-jalan di antara kawanan singa, ia menjadi seekor singa muda; ia belajar menerkam, malah manusia ditelannya."
 },
 {
   "id": 20893,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 7,
   "firman": "Ia merusak puri-puri mereka dan menumpas kota-kotanya; bumi serta segala isinya diam ketakutan mendengar suara aumnya."
 },
 {
   "id": 20894,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 8,
   "firman": "Maka bangsa-bangsa bangkit melawan dia dari daerah-daerah sekelilingnya, mereka memasang jaring untuk menangkapnya dan menjebaknya dalam pelubang."
 },
 {
   "id": 20895,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 9,
   "firman": "Ia dikurung dalam kandang, sambil dikelikir, dibawa ke hadapan raja Babel dan dimasukkan dalam penjara, supaya suaranya jangan kedengaran lagi di atas gunung-gunung Israel."
 },
 {
   "id": 20896,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 10,
   "firman": "Ibumu seperti pohon anggur dalam kebun anggur, yang tertanam dekat air, berbuah dan bercabang karena air yang berlimpah-limpah."
 },
 {
   "id": 20897,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 11,
   "firman": "Padanya tumbuh suatu cabang yang kuat yang menjadi tongkat kerajaan; ia menjulang tinggi di antara cabang-cabangnya yang rapat, dan menjadi kentara karena tingginya dan karena rantingnya yang banyak."
 },
 {
   "id": 20898,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 12,
   "firman": "Tetapi ia tercabut di dalam kemarahan dan dilemparkan ke bumi; angin timur membuatnya layu kering, buahnya disentakkan, cabang yang kuat menjadi layu kering; dan api menghabiskannya."
 },
 {
   "id": 20899,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 13,
   "firman": "Dan sekarang ia tertanam di padang gurun, di tanah yang kering dan haus akan air."
 },
 {
   "id": 20900,
   "kitab": "Yeh",
   "pasal": 19,
   "ayat": 14,
   "firman": "Maka keluarlah api dari cabangnya yang memakan habis ranting dan buahnya, sehingga tiada lagi padanya cabang yang kuat dan tiada tongkat kerajaan.\" Ini adalah ratapan dan sudah menjadi ratapan."
 },
 {
   "id": 20901,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada tahun ketujuh, dalam bulan yang kelima, pada tanggal sepuluh bulan itu, datanglah beberapa orang dari tua-tua Israel untuk meminta petunjuk dari pada TUHAN dan duduk di hadapanku."
 },
 {
   "id": 20902,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 2,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20903,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 3,
   "firman": "\"Hai anak manusia, berbicaralah kepada tua-tua Israel dan katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Apakah kamu datang untuk meminta petunjuk dari pada-Ku? Demi Aku yang hidup, Aku tidak mau kamu meminta petunjuk dari pada-Ku, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20904,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 4,
   "firman": "Maukah engkau menghakimi mereka, hai anak manusia, maukah engkau menghakimi mereka? Beritahukanlah kepada mereka perbuatan-perbuatan yang keji dari nenek moyang mereka,"
 },
 {
   "id": 20905,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 5,
   "firman": "dan katakanlah kepadanya: Beginilah firman Tuhan ALLAH: Pada hari Aku memilih Israel, Aku bersumpah kepada keturunan kaum Yakub dan menyatakan diri kepada mereka di tanah Mesir; Aku bersumpah kepada mereka: Akulah TUHAN Allahmu!"
 },
 {
   "id": 20906,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 6,
   "firman": "Pada hari itu Aku bersumpah kepada mereka untuk membawa mereka dari tanah Mesir ke tanah yang Kupilih baginya, negeri yang berlimpah-limpah susu dan madunya, tanah yang permai di antara semua negeri."
 },
 {
   "id": 20907,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 7,
   "firman": "Dan Aku berkata kepada mereka: Biarlah setiap orang membuangkan dewa-dewanya yang menjijikkan, ke mana ia selalu melihat dan janganlah menajiskan dirimu dengan berhala-berhala Mesir; Akulah TUHAN, Allahmu."
 },
 {
   "id": 20908,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 8,
   "firman": "Tetapi mereka memberontak terhadap Aku dan tidak mau mendengar kepada-Ku; setiap orang tidak membuangkan dewa-dewanya yang menjijikkan, ke mana ia selalu melihat, dan tidak meninggalkan berhala-berhala Mesir. Maka Aku bermaksud hendak mencurahkan amarah-Ku ke atas mereka untuk melampiaskan murka-Ku kepadanya di tengah-tengah tanah Mesir."
 },
 {
   "id": 20909,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 9,
   "firman": "Tetapi Aku bertindak oleh karena nama-Ku, supaya itu jangan dinajiskan di hadapan bangsa-bangsa, di mana mereka berada. Di hadapan bangsa-bangsa itu Aku menyatakan diri kepada mereka dalam hal Aku membawa mereka keluar dari tanah Mesir."
 },
 {
   "id": 20910,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 10,
   "firman": "Aku membawa mereka keluar dari tanah Mesir dan menuntun mereka ke padang gurun."
 },
 {
   "id": 20911,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 11,
   "firman": "Di sana Aku memberikan kepada mereka ketetapan-ketetapan-Ku dan memberitahukan peraturan-peraturan-Ku, dan manusia yang melakukannya, akan hidup."
 },
 {
   "id": 20912,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 12,
   "firman": "Hari-hari Sabat-Ku juga Kuberikan kepada mereka menjadi peringatan di antara Aku dan mereka, supaya mereka mengetahui bahwa Akulah TUHAN, yang menguduskan mereka."
 },
 {
   "id": 20913,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 13,
   "firman": "Tetapi kaum Israel memberontak terhadap Aku di padang gurun; mereka tidak hidup menurut ketetapan-ketetapan-Ku dan mereka menolak peraturan-peraturan-Ku, yang, kalau manusia melakukannya, ia akan hidup. Mereka juga melanggar kekudusan hari-hari Sabat-Ku dengan sangat. Maka Aku bermaksud hendak mencurahkan amarah-Ku ke atas mereka di padang gurun hendak membinasakan mereka."
 },
 {
   "id": 20914,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 14,
   "firman": "Tetapi Aku bertindak karena nama-Ku, supaya itu jangan dinajiskan di hadapan bangsa-bangsa, yang melihat sendiri waktu Aku membawa mereka ke luar."
 },
 {
   "id": 20915,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 15,
   "firman": "Walaupun begitu Aku bersumpah kepadanya di padang gurun, bahwa Aku tidak akan membawa mereka masuk ke tanah yang telah Kuberikan kepada mereka, yang berlimpah-limpah susu dan madunya, tanah yang permai di antara semua negeri,"
 },
 {
   "id": 20916,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 16,
   "firman": "oleh karena mereka menolak peraturan-peraturan-Ku dan tidak hidup menurut ketetapan-ketetapan-Ku dan melanggar kekudusan hari-hari Sabat-Ku; sebab hati mereka mengikuti berhala-berhala mereka."
 },
 {
   "id": 20917,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 17,
   "firman": "Tetapi Aku merasa sayang melihat mereka, sehingga Aku tidak membinasakannya dan tidak menghabisinya di padang gurun."
 },
 {
   "id": 20918,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 18,
   "firman": "Maka Aku berkata kepada anak-anak mereka di padang gurun: Janganlah kamu hidup menurut ketetapan-ketetapan ayahmu dan janganlah berpegang pada peraturan-peraturan mereka dan janganlah menajiskan dirimu dengan berhala-berhala mereka."
 },
 {
   "id": 20919,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 19,
   "firman": "Akulah TUHAN, Allahmu: Hiduplah menurut ketetapan-ketetapan-Ku dan lakukanlah peraturan-peraturan-Ku dengan setia,"
 },
 {
   "id": 20920,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 20,
   "firman": "kuduskanlah hari-hari Sabat-Ku, sehingga itu menjadi peringatan di antara Aku dan kamu, supaya orang mengetahui bahwa Akulah TUHAN, Allahmu."
 },
 {
   "id": 20921,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 21,
   "firman": "Tetapi anak-anak mereka memberontak terhadap Aku, mereka tidak hidup menurut ketetapan-ketetapan-Ku dan tidak melakukan peraturan-peraturan-Ku dengan setia, sedang manusia yang melakukannya, akan hidup; mereka juga melanggar kekudusan hari-hari Sabat-Ku. Maka Aku bermaksud mencurahkan amarah-Ku ke atas mereka untuk melampiaskan murka-Ku kepadanya di padang gurun."
 },
 {
   "id": 20922,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 22,
   "firman": "Tetapi Aku menarik tangan-Ku kembali dan bertindak karena nama-Ku, supaya itu jangan dinajiskan di hadapan bangsa-bangsa yang melihat sendiri waktu Aku membawa mereka ke luar."
 },
 {
   "id": 20923,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 23,
   "firman": "Walaupun begitu Aku bersumpah kepadanya di padang gurun untuk menyerakkan mereka di antara bangsa-bangsa dan menghamburkan mereka ke semua negeri,"
 },
 {
   "id": 20924,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 24,
   "firman": "oleh karena mereka tidak melakukan peraturan-peraturan-Ku dan menolak ketetapan-ketetapan-Ku dan melanggar kekudusan hari-hari Sabat-Ku dan matanya selalu tertuju kepada berhala-berhala ayah-ayah mereka."
 },
 {
   "id": 20925,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 25,
   "firman": "Begitulah Aku juga memberi kepada mereka ketetapan-ketetapan yang tidak baik dan peraturan-peraturan, yang karenanya mereka tidak dapat hidup."
 },
 {
   "id": 20926,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 26,
   "firman": "Aku membiarkan mereka menjadi najis dengan persembahan-persembahan mereka, dalam hal mereka mempersembahkan sebagai korban dalam api semua yang terdahulu lahir dari kandungan, supaya Kubuat mereka tertegun, agar mereka mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 20927,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 27,
   "firman": "Oleh karena itu berbicaralah kepada kaum Israel, hai anak manusia, dan katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Dalam hal ini juga nenek moyangmu menghujat Aku, yaitu mereka berobah setia kepada-Ku."
 },
 {
   "id": 20928,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 28,
   "firman": "Sebab sesudah Aku membawa mereka ke negeri yang dengan sumpah telah Kujanjikan memberikannya kepada mereka, mereka melihat ke setiap bukit yang tinggi dan ke setiap pohon yang penuh cabang-cabang dan mereka mempersembahkan di sana korban sembelihannya dan membawa persembahannya yang menyakiti hati, juga menyerbakkan di sana persembahan-persembahan mereka yang harum dan mempersembahkan mereka di sana korban-korban curahan mereka."
 },
 {
   "id": 20929,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 29,
   "firman": "Maka Aku berkata kepada mereka: Tempat tinggi apa itu yang kamu naiki? Maka namanya disebut Tempat Tinggi sampai hari ini."
 },
 {
   "id": 20930,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 30,
   "firman": "Oleh sebab itu katakanlah kepada kaum Israel: Beginilah firman Tuhan ALLAH: Apakah kamu menajiskan dirimu juga dengan cara hidup nenek moyangmu dan berzinah dengan mengikuti dewa-dewanya yang menjijikkan?"
 },
 {
   "id": 20931,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 31,
   "firman": "Dalam membawa persembahan-persembahanmu, yaitu mempersembahkan anak-anakmu sebagai korban dalam api, kamu menajiskan dirimu dengan segala berhala-berhalamu sampai hari ini, apakah Aku masih mau kamu minta petunjuk dari pada-Ku, hai kaum Israel? Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, Aku tidak mau lagi kamu minta petunjuk dari pada-Ku."
 },
 {
   "id": 20932,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 32,
   "firman": "Dan apa yang timbul dalam hatimu sama sekali tidak akan terjadi, yaitu yang kamu katakan: Kami ingin seperti bangsa-bangsa lain, seperti segala kaum di negeri-negeri untuk berbakti kepada pohon dan batu."
 },
 {
   "id": 20933,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 33,
   "firman": "Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, Aku akan memerintah kamu dengan tangan yang kuat dan lengan yang teracung dan amarah yang tercurah."
 },
 {
   "id": 20934,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 34,
   "firman": "Aku akan membawa kamu keluar dari tengah bangsa-bangsa dan mengumpulkan kamu dari negeri-negeri, di mana kamu berserak dengan tangan yang kuat dan lengan yang teracung dan amarah yang tercurah,"
 },
 {
   "id": 20935,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 35,
   "firman": "dan Aku akan membawa kamu ke padang gurun bangsa-bangsa dan di sana Aku akan berperkara dengan kamu berhadapan muka."
 },
 {
   "id": 20936,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 36,
   "firman": "Seperti Aku berperkara dengan nenek moyangmu di padang gurun tanah Mesir, begitulah Aku akan berperkara dengan kamu, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20937,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 37,
   "firman": "Aku akan membiarkan kamu lewat dari bawah tongkat gembala-Ku dan memasukkan kamu ke kandang dengan menghitung kamu."
 },
 {
   "id": 20938,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 38,
   "firman": "Aku akan memisahkan dari tengah-tengahmu orang-orang yang memberontak dan mendurhaka terhadap Aku; Aku akan membawa mereka keluar dari negeri, tempat mereka tinggal sebagai orang asing, tetapi di tanah Israel mereka tidak akan masuk. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 20939,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 39,
   "firman": "Hai kamu, kaum Israel, beginilah firman Tuhan ALLAH, biarlah masing-masing pergi beribadah kepada berhala-berhalanya. Tetapi kemudian kamu akan mendengarkan Aku dan tidak lagi melanggar kekudusan nama-Ku yang kudus dengan persembahan-persembahanmu dan berhala-berhalamu."
 },
 {
   "id": 20940,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 40,
   "firman": "Sebab di atas gunung-Ku yang kudus, di atas gunung Israel yang tinggi, demikianlah firman Tuhan ALLAH, di sana di tanah itu segenap kaum Israel dalam keseluruhannya akan beribadah kepada-Ku. Di sana Aku akan berkenan kepadamu dan di sana Aku akan menuntut dari kamu persembahan-persembahan khususmu dan sajian-sajianmu yang terpilih, segala yang kamu kuduskan."
 },
 {
   "id": 20941,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 41,
   "firman": "Seperti kepada persembahan yang harum Aku berkenan kepadamu pada waktu Aku mengeluarkan kamu dari tengah bangsa-bangsa dan mengumpulkan kamu dari negeri-negeri, di mana kamu berserak, dan Aku akan menunjukkan kekudusan-Ku kepadamu di hadapan bangsa-bangsa."
 },
 {
   "id": 20942,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 42,
   "firman": "Dan kamu akan mengetahui bahwa Akulah TUHAN, pada waktu Aku membawa kamu masuk ke tanah Israel, ke negeri yang dengan sumpah telah Kujanjikan memberikannya kepada nenek moyangmu."
 },
 {
   "id": 20943,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 43,
   "firman": "Di sana kamu akan teringat-ingat kepada segala tingkah lakumu, dengan mana kamu menajiskan dirimu, dan kamu akan merasa mual melihat dirimu sendiri karena segala kejahatan-kejahatan yang kamu lakukan."
 },
 {
   "id": 20944,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 44,
   "firman": "Dan kamu akan mengetahui bahwa Akulah TUHAN, pada masa Aku, oleh karena nama-Ku, tidak memperlakukan kamu selaras dengan tingkah lakumu yang jahat dan busuk, hai kaum Israel, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20945,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 45,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20946,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 46,
   "firman": "\"Hai anak manusia, tujukanlah mukamu ke selatan dan ucapkanlah banyak tegoran terhadap tanah selatan dan bernubuatlah terhadap tanah kehutanan di sebelah selatan;"
 },
 {
   "id": 20947,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 47,
   "firman": "dan katakanlah kepada hutan di sebelah selatan: Dengarlah firman TUHAN: Beginilah firman Tuhan ALLAH: Lihat, Aku akan menyalakan api di dalammu yang akan memakan habis setiap pohon yang hidup padamu dan setiap pohon yang layu kering. Apinya yang sedang bernyala-nyala tidak akan padam dan semua muka dari selatan sampai utara akan terbakar kepanasan olehnya."
 },
 {
   "id": 20948,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 48,
   "firman": "Dan setiap manusia akan melihat, bahwa Aku, Tuhanlah yang memasangnya; api itu tidak akan padam.\""
 },
 {
   "id": 20949,
   "kitab": "Yeh",
   "pasal": 20,
   "ayat": 49,
   "firman": "Lalu aku berkata: \"Aduh, Tuhan ALLAH, mereka berkata tentang aku: Apakah ia tidak hanya mengucapkan kata-kata sindiran?\""
 },
 {
   "id": 20950,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20951,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu ke Yerusalem dan ucapkanlah banyak tegoran terhadap tempat kudusnya dan bernubuatlah melawan tanah Israel."
 },
 {
   "id": 20952,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 3,
   "firman": "Katakanlah kepada tanah Israel: Beginilah firman TUHAN: Lihat, Aku akan menjadi lawanmu dan akan mencabut pedang-Ku dari sarungnya dan melenyapkan dari tengah-tengahmu orang benar dan orang fasik."
 },
 {
   "id": 20953,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 4,
   "firman": "Oleh karena Aku hendak melenyapkan dari tengah-tengahmu orang benar dan orang fasik, maka pedang-Ku akan terhunus dari sarungnya terhadap semua manusia dari selatan sampai utara."
 },
 {
   "id": 20954,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 5,
   "firman": "Dan semua manusia akan mengetahui bahwa Aku, TUHAN, mencabut pedang-Ku dari sarungnya, sehingga tidak akan kembali lagi ke situ."
 },
 {
   "id": 20955,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 6,
   "firman": "Dan engkau anak manusia, mengeranglah! Mengeranglah di hadapan mereka seperti seorang yang tulang pinggangnya patah dan yang berada dalam kesengsaraan yang pahit."
 },
 {
   "id": 20956,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 7,
   "firman": "Dan kalau mereka bertanya kepadamu: Mengapa engkau mengeluh? jawablah: Karena suatu berita! Kalau berita itu sudah tersiar, setiap hati akan menjadi tawar dan semua tangan menjadi lemah lesu, segala semangat menghilang dan semua orang terkencing ketakutan. Sungguh, pasti datang dan terjadi! demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 20957,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 8,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20958,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 9,
   "firman": "\"Hai anak manusia, bernubuatlah dan katakan: Beginilah firman TUHAN: Pedang! Pedang! Yang sudah diasah dan juga digosok!"
 },
 {
   "id": 20959,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 10,
   "firman": "Diasah untuk menumpahkan darah dan digosok supaya mengkilap seperti petir. Apakah kita akan bersukacita? --Tongkat anakku menghina segala macam kayu. --"
 },
 {
   "id": 20960,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 11,
   "firman": "Pedang itu diberikan supaya digosok, supaya sedia dipergunakan; pedang itu diasah dan digosok, supaya diberikan ke tangan si pembunuh."
 },
 {
   "id": 20961,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 12,
   "firman": "Berserulah dan merataplah, hai anak manusia! Sebab pedang itu ditujukan melawan umat-Ku, ditujukan melawan semua pemimpin Israel; mereka dan umat-Ku sama-sama dibiarkan dimakan pedang. Oleh sebab itu tepuklah pinggangmu sebagai tanda perkabungan."
 },
 {
   "id": 20962,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 13,
   "firman": "Sebab percobaan datang dan tidak suatupun yang dapat tahan, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20963,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 14,
   "firman": "Dan engkau anak manusia, bernubuatlah dan tepuklah tanganmu, biarlah pedang itu menjadi dua kali lipat, tiga kali lipat. Itu pedang pembunuh, pedang untuk pembunuhan besar-besaran, yang berkeliling menghabiskan mereka."
 },
 {
   "id": 20964,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 15,
   "firman": "Supaya hati mereka hancur dan yang jatuh berebahan bertambah-tambah di tiap pintu gerbang mereka, Aku memerintahkan penumpahan darah dengan pedang itu. Aduh, pedang itu dibuat menyamai petir dan digosok untuk menumpahkan darah."
 },
 {
   "id": 20965,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 16,
   "firman": "Pancung yang di kanan dan di kiri, ke mana saja matamu menetak."
 },
 {
   "id": 20966,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 17,
   "firman": "Dan Aku juga akan bertepuk tangan dan hati-Ku yang panas menjadi tenang kembali. Aku, TUHAN, yang mengatakannya.\""
 },
 {
   "id": 20967,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 18,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20968,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 19,
   "firman": "\"Hai engkau anak manusia, gambarlah dua jalan yang akan dilalui oleh pedang raja Babel; keduanya mulai dari satu negeri. Buatlah sebuah papan penunjuk jalan pada awal jalan yang menuju ke masing-masing kota."
 },
 {
   "id": 20969,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 20,
   "firman": "Gambarlah dari jalan mana pedang itu datang melawan Raba, ibukota bani Amon dan melawan Yehuda, yang bentengnya ada di Yerusalem."
 },
 {
   "id": 20970,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 21,
   "firman": "Sebab raja Babel berdiri pada persimpangan jalan itu, pada awal kedua jalan itu untuk melakukan tenungan; ia mengocok panah, meminta petunjuk dari terafim dan menilik hati binatang."
 },
 {
   "id": 20971,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 22,
   "firman": "Ke dalam tangan kanannya terjatuh panah tenungan mengenai Yerusalem: supaya diperdengarkannya suara orang yang membunuh dan menyerukan pekik pertempuran, supaya menyusun alat-alat pendobrak pintu gerbang dan menimbun tanah menjadi tembok pengepungan dan mendirikan benteng pengepungan."
 },
 {
   "id": 20972,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 23,
   "firman": "Tetapi bagi mereka, itu adalah tenungan yang menipu, walaupun mereka mengangkat sumpah yang muluk-muluk; tetapi ia mengingat kesalahan mereka, sehingga mereka ditangkap."
 },
 {
   "id": 20973,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 24,
   "firman": "Oleh sebab itu, beginilah firman Tuhan ALLAH: Oleh karena kamu membuat kesalahanmu itu teringat kembali dengan tersingkapnya pelanggaranmu, sehingga kentara dosa-dosamu dalam segala perbuatanmu, oleh karena kamu menjadi teringat kembali, kamu akan ditangkap dengan kekerasan."
 },
 {
   "id": 20974,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 25,
   "firman": "Dan hai engkau, raja Israel, orang fasik yang durhaka, yang saatmu sudah tiba untuk penghakiman terakhir,"
 },
 {
   "id": 20975,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 26,
   "firman": "beginilah firman Tuhan ALLAH: Jauhkanlah serbanmu dan buangkanlah mahkotamu! Tiada yang tetap seperti keadaannya sekarang. Yang rendah harus ditinggikan, yang tinggi harus direndahkan."
 },
 {
   "id": 20976,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 27,
   "firman": "Puing, puing, puing akan Kujadikan dia! Inipun tidak akan tetap. Sampai ia datang yang berhak atasnya, dan kepadanya akan Kuberikan itu.\""
 },
 {
   "id": 20977,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 28,
   "firman": "\"Dan engkau anak manusia, bernubuatlah dan katakan: Beginilah firman Tuhan ALLAH mengenai bani Amon dan cercaan mereka; katakanlah: Pedang, pedang sudah tercabut untuk menumpahkan darah, digosok untuk memusnahkan, dan supaya mengkilap seperti petir--"
 },
 {
   "id": 20978,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 29,
   "firman": "sedang orang melihat penglihatan-penglihatan yang menipu bagimu dan memberi tenungan-tenungan bohong kepadamu--untuk ditetakkan ke leher orang-orang fasik yang durhaka, yang saatnya sudah tiba untuk penghakiman terakhir."
 },
 {
   "id": 20979,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 30,
   "firman": "Kembalikanlah itu ke sarungnya! Di tempat penciptaanmu dan di negeri asalmu Aku akan menghukum engkau."
 },
 {
   "id": 20980,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 31,
   "firman": "Aku akan mencurahkan geram-Ku atasmu dan menyemburkan api murka-Ku kepadamu dan menyerahkan engkau ke dalam tangan orang-orang dungu, yang menimbulkan kemusnahan."
 },
 {
   "id": 20981,
   "kitab": "Yeh",
   "pasal": 21,
   "ayat": 32,
   "firman": "Engkau menjadi makanan api, darahmu akan tertumpah di tengah-tengah tanah itu, dan engkau tidak akan diingat-ingat lagi, sebab Aku, TUHAN, yang mengatakannya.\""
 },
 {
   "id": 20982,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20983,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 2,
   "firman": "\"Hai engkau, anak manusia, maukah engkau menjatuhkan, ya, menjatuhkan hukuman atas kota yang penuh hutang darah? Beritahukanlah kepadanya segala perbuatannya yang keji,"
 },
 {
   "id": 20984,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 3,
   "firman": "dan katakanlah: Beginilah firman Tuhan ALLAH: Hai kota, yang mencurahkan darah di tengah-tengahmu, sehingga waktu penghukumanmu datang dan membuat berhala-berhala bagimu yang menajiskan dirimu."
 },
 {
   "id": 20985,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 4,
   "firman": "Dengan darah yang engkau curahkan engkau bersalah dan dengan berhala-berhalamu yang engkau perbuat engkau menjadi najis; dengan demikian engkau membuat saatmu mendekat dan membuat akhir tahun-tahunmu datang. Oleh karena itu Aku memberi engkau cercaan bagi bangsa-bangsa dan ejekan bagi semua negeri."
 },
 {
   "id": 20986,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 5,
   "firman": "Yang dekat padamu dan yang jauh dari padamu akan mengejek engkau, yang kenajisannya terkenal dan yang penuh huru-hara."
 },
 {
   "id": 20987,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 6,
   "firman": "Lihat, masing-masing pemimpin Israel mengandalkan kekuatannya di tengah-tengahmu untuk menumpahkan darah."
 },
 {
   "id": 20988,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 7,
   "firman": "Padamu ayah dan ibu dihina dan di tengah-tengahmu orang melakukan pemerasan terhadap orang asing, padamu anak yatim dan janda ditindas."
 },
 {
   "id": 20989,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 8,
   "firman": "Engkau memandang ringan terhadap hal-hal yang kudus bagi-Ku dan hari-hari Sabat-Ku kaunajiskan."
 },
 {
   "id": 20990,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 9,
   "firman": "Padamu berkeliaran orang-orang pemfitnah dengan maksud mencurahkan darah dan orang makan daging persembahan di atas gunung-gunung; kemesuman dilakukan di tengah-tengahmu."
 },
 {
   "id": 20991,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 10,
   "firman": "Padamu orang menyingkapkan aurat isteri ayahnya dan memperkosa perempuan pada waktu cemar kainnya yang menajiskannya."
 },
 {
   "id": 20992,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 11,
   "firman": "Yang satu melakukan kekejian dengan isteri sesamanya dan yang lain menajiskan menantunya perempuan dengan perbuatan mesum, orang lain lagi memperkosa saudaranya perempuan, anak kandung ayahnya."
 },
 {
   "id": 20993,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 12,
   "firman": "Padamu orang menerima suap untuk mencurahkan darah, engkau memungut bunga uang atau mengambil riba dan merugikan sesamamu dengan pemerasan, tetapi Aku kaulupakan, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 20994,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 13,
   "firman": "Sungguh, Aku bertepuk tangan mengenai keuntunganmu yang haram yang kaudapati dan mengenai darah yang dicurahkan di tengah-tengahmu."
 },
 {
   "id": 20995,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 14,
   "firman": "Apakah hatimu akan tetap teguh dan tanganmu merasa kuat pada masa Aku bertindak terhadap engkau? Aku, TUHAN, yang mengatakannya dan yang akan membuatnya."
 },
 {
   "id": 20996,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 15,
   "firman": "Aku akan menyerakkan engkau di antara bangsa-bangsa dan menghamburkan engkau ke semua negeri dan Aku akan mengikis kenajisanmu dari padamu."
 },
 {
   "id": 20997,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 16,
   "firman": "Maka engkau akan dinajiskan di hadapan bangsa-bangsa karena kesalahanmu sendiri, dan engkau akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 20998,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 17,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 20999,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 18,
   "firman": "\"Hai anak manusia, bagi-Ku kaum Israel sudah menjadi sanga; mereka semuanya adalah ibarat tembaga, timah putih, besi dan timah hitam di dalam peleburan; mereka seperti sanga perak."
 },
 {
   "id": 21000,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 19,
   "firman": "Sebab itu beginilah firman Tuhan ALLAH: Oleh karena kamu semuanya menjadi sanga, maka sungguh, Aku akan mengumpulkan kamu di tengah-tengah Yerusalem."
 },
 {
   "id": 21001,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 20,
   "firman": "Seperti orang mengumpulkan perak, tembaga, besi, timah hitam dan timah putih di dalam peleburan dan mengembus api di bawahnya untuk meleburnya, demikianlah Aku akan mengumpulkan kamu dalam murka-Ku dan amarah-Ku dan menaruh kamu di dalamnya dan melebur kamu."
 },
 {
   "id": 21002,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 21,
   "firman": "Aku akan mengumpulkan kamu dan menyemburkan api kemurkaan-Ku kepadamu, sehingga kamu dilebur di dalamnya."
 },
 {
   "id": 21003,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 22,
   "firman": "Seperti perak dilebur dalam peleburan, begitulah kamu dilebur di dalamnya. Dan kamu akan mengetahui, bahwa Aku, TUHAN, yang mencurahkan amarah-Ku atasmu.\""
 },
 {
   "id": 21004,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 23,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21005,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 24,
   "firman": "\"Hai anak manusia, katakanlah kepadanya: Engkau adalah tanah yang tidak menerima hujan, tidak mendapat air pada masa kegeraman,"
 },
 {
   "id": 21006,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 25,
   "firman": "yang pemimpin-pemimpinnya di tengah-tengahnya seperti singa yang mengaum, yang menerkam mangsanya: manusia ditelan, harta benda dan barang-barang yang berharga dirampas, janda-janda dibuat bertambah-tambah di tengah-tengahnya."
 },
 {
   "id": 21007,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 26,
   "firman": "Imam-imamnya memperkosa hukum Taurat-Ku dan menajiskan hal-hal yang kudus bagi-Ku, mereka tidak membedakan antara yang kudus dengan yang tidak kudus, tidak mengajarkan perbedaan yang najis dengan yang tahir, mereka menutup mata terhadap hari-hari Sabat-Ku. Demikianlah Aku dinajiskan di tengah-tengah mereka."
 },
 {
   "id": 21008,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 27,
   "firman": "Pemuka-pemukanya di tengah-tengahnya adalah seperti serigala-serigala yang menerkam mangsanya dalam kehausan akan darah, yang membinasakan orang-orang untuk menguntungkan diri sendiri secara haram."
 },
 {
   "id": 21009,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 28,
   "firman": "Dan nabi-nabinya mengoles mereka dengan kapur dengan melihat penglihatan yang menipu dan memberi tenungan bohong bagi mereka; nabi-nabi itu berkata: Beginilah firman Tuhan ALLAH! --tetapi TUHAN tidak berfirman."
 },
 {
   "id": 21010,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 29,
   "firman": "Penduduk negeri melakukan pemerasan dan perampasan, menindas orang sengsara dan miskin dan mereka melakukan pemerasan terhadap orang asing bertentangan dengan hukum."
 },
 {
   "id": 21011,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 30,
   "firman": "Aku mencari di tengah-tengah mereka seorang yang hendak mendirikan tembok atau yang mempertahankan negeri itu di hadapan-Ku, supaya jangan Kumusnahkan, tetapi Aku tidak menemuinya."
 },
 {
   "id": 21012,
   "kitab": "Yeh",
   "pasal": 22,
   "ayat": 31,
   "firman": "Maka Aku mencurahkan geram-Ku atas mereka dan membinasakan mereka dengan api kemurkaan-Ku; kelakuan mereka Kutimpakan atas kepala mereka, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21013,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21014,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 2,
   "firman": "\"Hai anak manusia, ada dua orang perempuan, anak dari satu ibu."
 },
 {
   "id": 21015,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 3,
   "firman": "Mereka bersundal di Mesir, mereka bersundal pada masa mudanya; di sana susunya dijamah-jamah dan dada keperawanannya dipegang-pegang."
 },
 {
   "id": 21016,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 4,
   "firman": "Nama yang tertua ialah Ohola dan nama adiknya ialah Oholiba. Mereka Aku punya dan mereka melahirkan anak-anak lelaki dan perempuan. Mengenai nama-nama mereka, Ohola ialah Samaria dan Oholiba ialah Yerusalem."
 },
 {
   "id": 21017,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 5,
   "firman": "Dan Ohola berzinah, sedang ia Aku punya. Ia sangat berahi kepada kekasih-kekasihnya, kepada orang Asyur, pahlawan-pahlawan perang,"
 },
 {
   "id": 21018,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 6,
   "firman": "berpakaian kain ungu tua, bupati-bupati dan penguasa-penguasa, semuanya pemuda yang ganteng, pasukan kuda."
 },
 {
   "id": 21019,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 7,
   "firman": "Ia melakukan persundalannya dengan mereka, semuanya orang Asyur pilihan; ia menajiskan dirinya dengan semua orang, kepada siapa ia berahi dan dengan berhala-berhalanya."
 },
 {
   "id": 21020,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 8,
   "firman": "Ia tidak meninggalkan persundalannya yang dilakukannya sejak dari Mesir, sebab pada masa mudanya orang sudah menidurinya, dan mereka memegang-megang dada keperawanannya dan mencurahkan persundalan mereka kepadanya."
 },
 {
   "id": 21021,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 9,
   "firman": "Oleh sebab itu Aku menyerahkan dia ke dalam tangan kekasih-kekasihnya, dalam tangan orang Asyur, kepada siapa ia berahi."
 },
 {
   "id": 21022,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 10,
   "firman": "Mereka menyingkapkan auratnya, anak-anaknya lelaki dan perempuan ditangkap dan ia sendiri dibunuh dengan pedang. Dengan demikian namanya dipercakapkan di antara kaum perempuan sebab hukuman telah dijatuhkan atasnya."
 },
 {
   "id": 21023,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 11,
   "firman": "Walaupun hal itu dilihat oleh adiknya, Oholiba, ia lebih berahi lagi dan persundalannya melebihi lagi dari kakaknya."
 },
 {
   "id": 21024,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 12,
   "firman": "Ia berahi kepada orang Asyur, kepada bupati-bupati dan penguasa-penguasanya, kepada pahlawan-pahlawan perang yang pakaiannya sangat sempurna, kepada pasukan kuda, semuanya pemuda yang ganteng."
 },
 {
   "id": 21025,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 13,
   "firman": "Aku melihat bahwa ia menajiskan diri; kelakuan mereka berdua adalah sama."
 },
 {
   "id": 21026,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 14,
   "firman": "Bahkan, ia menambah persundalannya lagi: ia melihat laki-laki yang terukir pada dinding, gambar orang-orang Kasdim, diukir dalam warna linggam,"
 },
 {
   "id": 21027,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 15,
   "firman": "pinggangnya diikat dengan ikat pinggang, kepalanya memakai serban yang berjuntai, semuanya kelihatan seperti perwira, yang menyerupai orang Babel dari Kasdim, tanah kelahiran mereka."
 },
 {
   "id": 21028,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 16,
   "firman": "Segera sesudah kelihatan oleh matanya ia berahi kepada mereka dan mengirim suruhan kepada mereka ke tanah Kasdim."
 },
 {
   "id": 21029,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 17,
   "firman": "Maka orang Babel datang kepadanya menikmati tempat tidur percintaan dan menajiskan dia dengan persundalan mereka; sesudah ia menjadi najis oleh mereka, ia meronta dari mereka."
 },
 {
   "id": 21030,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 18,
   "firman": "Oleh karena ia melakukan persundalannya dengan terang-terangan dan memperlihatkan sendiri auratnya, maka Aku menjauhkan diri karena jijik dari padanya, seperti Aku menjauhkan diri dari adiknya."
 },
 {
   "id": 21031,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 19,
   "firman": "Ia melakukan lebih banyak lagi persundalannya sambil teringat kepada masa mudanya, waktu ia bersundal di tanah Mesir."
 },
 {
   "id": 21032,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 20,
   "firman": "Ia berahi kepada kawan-kawannya bersundal, yang auratnya seperti aurat keledai dan zakarnya seperti zakar kuda."
 },
 {
   "id": 21033,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 21,
   "firman": "Engkau menginginkan kemesuman masa mudamu, waktu orang Mesir memegang-megang dadamu dan menjamah-jamah susu kegadisanmu."
 },
 {
   "id": 21034,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 22,
   "firman": "Oleh sebab itu, hai Oholiba, beginilah firman Tuhan ALLAH, memang engkau sudah menjauhkan dirimu dari kekasih-kekasihmu, tetapi sungguh, Aku akan menyuruh mereka bergerak melawan engkau; Aku akan membawa mereka melawan engkau dari sekitarmu:"
 },
 {
   "id": 21035,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 23,
   "firman": "orang Babel dan semua orang Kasdim, orang Pekod, orang Soa dan orang Koa, dan semua orang Asyur bersama mereka, pemuda yang ganteng, bupati-bupati dan para penguasa semuanya, perwira-perwira dan pahlawan-pahlawan perang, pasukan kuda semuanya."
 },
 {
   "id": 21036,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 24,
   "firman": "Mereka datang melawan engkau dengan banyak kereta dan roda-roda dan dengan sekumpulan bangsa-bangsa; mereka akan menyusun perisai besar dan kecil dan ketopong di sekitarmu melawan engkau, dan Aku akan menyerahkan perkara ini di hadapannya dan mereka akan menghakimi engkau menurut hukum mereka."
 },
 {
   "id": 21037,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 25,
   "firman": "Aku akan membalaskan cemburuan-Ku kepadamu, sehingga mereka memperlakukan engkau dengan kemurkaan, hidung dan telingamu akan dikerat dan sisamu akan mati rebah oleh pedang. Mereka akan menangkap anak-anakmu lelaki dan perempuan dan sisamu akan dimakan api."
 },
 {
   "id": 21038,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 26,
   "firman": "Mereka akan menelanjangi engkau dan merampas perhiasan-perhiasanmu."
 },
 {
   "id": 21039,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 27,
   "firman": "Aku akan membuat engkau menghentikan kemesumanmu dan persundalanmu sejak dari tanah Mesir, sehingga engkau tidak lagi melirik kepada mereka dan tidak lagi mengingat-ingat orang Mesir."
 },
 {
   "id": 21040,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 28,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Lihat, Aku akan menyerahkan engkau ke dalam tangan orang yang kaubenci, walaupun engkau sudah menjauhkan diri dari mereka."
 },
 {
   "id": 21041,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 29,
   "firman": "Mereka akan memperlakukan engkau dengan kebencian dan akan merampas segala hasil jerih payahmu dan meninggalkan engkau telanjang bugil, sehingga aurat persundalanmu kelihatan. Kemesumanmu dan persundalanmu"
 },
 {
   "id": 21042,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 30,
   "firman": "mendatangkan hal ini atasmu, karena engkau bersundal dengan mengandalkan bangsa-bangsa dan menajiskan dirimu dengan berhala-berhala mereka."
 },
 {
   "id": 21043,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 31,
   "firman": "Engkau hidup mengikuti kelakuan kakakmu, sebab itu Aku akan memberi engkau minum dari pialanya."
 },
 {
   "id": 21044,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 32,
   "firman": "Beginilah firman Tuhan ALLAH: Engkau harus minum dari piala kakakmu, piala yang dalam dan lebar mulutnya, yaitu piala yang banyak isinya; menjadi tertawaan dan olok-olok engkau."
 },
 {
   "id": 21045,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 33,
   "firman": "Engkau akan penuh kemabukan dan dukacita. Piala kengerian disertai kesunyian ialah piala kakakmu Samaria."
 },
 {
   "id": 21046,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 34,
   "firman": "Engkau meminumnya beserta ampasnya, sampai mengunggis pecahan-pecahannya dan engkau merabitkan susumu. Sebab Aku yang mengatakannya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21047,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 35,
   "firman": "Oleh sebab itu, beginilah firman Tuhan ALLAH: Oleh karena engkau melupakan Aku dan membelakangi Aku, sekarang tanggung sendirilah kemesumanmu dan persundalanmu.\""
 },
 {
   "id": 21048,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 36,
   "firman": "Lalu TUHAN berfirman kepadaku: \"Hai anak manusia, maukah engkau menghakimi Ohola dan Oholiba dan memberitahukan kepada mereka perbuatan-perbuatannya yang keji?"
 },
 {
   "id": 21049,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 37,
   "firman": "Sebab mereka berzinah, tangan mereka berlumuran darah dan mereka berzinah dengan menyembah berhala-berhalanya, bahkan anak-anak lelaki mereka yang dilahirkan bagi-Ku dipersembahkannya sebagai korban dalam api kepada berhala-berhalanya menjadi makanan."
 },
 {
   "id": 21050,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 38,
   "firman": "Selain itu hal ini juga mereka lakukan terhadap Aku, mereka menajiskan tempat kudus-Ku pada hari itu dan melanggar kekudusan hari-hari Sabat-Ku."
 },
 {
   "id": 21051,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 39,
   "firman": "Dan sedang mereka menyembelih anak-anak mereka untuk berhala-berhalanya, mereka datang pada hari itu ke tempat kudus-Ku dan melanggar kekudusannya. Sungguh, inilah yang dilakukan mereka di dalam rumah-Ku."
 },
 {
   "id": 21052,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 40,
   "firman": "Tambahan lagi mereka meminta orang-orang datang dari tempat yang jauh dengan menyuruh suruhan memanggil mereka, dan sungguh, mereka datang. Demi kedatangan mereka engkau mandi bersih-bersih, mencalak alismu dan menghias dirimu dengan perhiasan-perhiasan."
 },
 {
   "id": 21053,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 41,
   "firman": "Engkau duduk di tempat tidur yang serba indah dan di hadapannya meja dengan hidangan yang disajikan; di atas tempat tidurmu itu kautaruh ukupan-Ku dan minyak-Ku."
 },
 {
   "id": 21054,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 42,
   "firman": "Lalu kedengaranlah suara keramaian hidup bersenang-senang padanya dan kepada orang-orang dari orang banyak ditambahkan lagi pemabuk-pemabuk dari padang gurun. Mereka mengenakan gelang pada tangannya dan mahkota kemuliaan di atas kepalanya."
 },
 {
   "id": 21055,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 43,
   "firman": "Aku berkata: Apakah bunga yang layu ini masih melakukan perzinahan? Orang bersundal dengan dia, bahkan dengan dia."
 },
 {
   "id": 21056,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 44,
   "firman": "Mereka datang kepadanya seperti orang mendatangi perempuan sundal. Demikianlah mereka datang kepada Ohola dan Oholiba untuk melakukan kemesuman."
 },
 {
   "id": 21057,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 45,
   "firman": "Tetapi orang-orang yang benar saleh akan menghakimi mereka seperti orang menghakimi perempuan-perempuan yang berzinah dan yang menumpahkan darah, sebab mereka adalah perempuan-perempuan berzinah dan tangan mereka berlumuran darah.\""
 },
 {
   "id": 21058,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 46,
   "firman": "Sebab beginilah firman Tuhan ALLAH: \"Biarlah bangkit sekumpulan orang melawan mereka dan biarkanlah mereka menjadi kengerian dan rampasan."
 },
 {
   "id": 21059,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 47,
   "firman": "Kumpulan orang ini akan melontari mereka dengan batu dan memancung mereka dengan pedangnya, membunuh anak-anak lelaki dan anak-anak perempuan mereka dan membakar habis rumah-rumah mereka."
 },
 {
   "id": 21060,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 48,
   "firman": "Aku akan menghentikan kemesuman di tanah itu dan semua kaum perempuan akan memperhatikan peringatan itu dan tidak akan melakukan kemesuman lagi seperti yang kamu lakukan."
 },
 {
   "id": 21061,
   "kitab": "Yeh",
   "pasal": 23,
   "ayat": 49,
   "firman": "Orang akan membalaskan kemesumanmu atasmu dan kamu harus menanggung dosa-dosamu lantaran kamu menyembah berhala-berhala. Dan kamu akan mengetahui bahwa Akulah Tuhan ALLAH.\""
 },
 {
   "id": 21062,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 1,
   "firman": "Pada tahun kesembilan, dalam bulan yang kesepuluh, pada tanggal sepuluh bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21063,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tuliskanlah tanggal hari ini, ya, tanggal hari ini. Pada hari ini juga raja Babel mulai menyerang Yerusalem."
 },
 {
   "id": 21064,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 3,
   "firman": "Ucapkanlah suatu perumpamaan kepada kaum pemberontak dan katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Taruhlah kuali di atas api, taruhlah, dan tuanglah juga air ke dalamnya;"
 },
 {
   "id": 21065,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 4,
   "firman": "taruhlah potongan daging di dalamnya, semua potongan yang baik, paha dan punggungnya; penuhilah itu dengan tulang-tulang pilihan."
 },
 {
   "id": 21066,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 5,
   "firman": "Ambillah domba yang terpilih, dan susunlah juga kayu di bawahnya, biarlah masakan itu mendidih dan tulang-tulangnya turut empuk di dalamnya."
 },
 {
   "id": 21067,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 6,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Celakalah kota yang penuh hutang darah, kuali yang berkarat di dalamnya dan karatnya tidak hilang dari padanya! Keluarkan potong demi potong dari dalamnya tanpa memilih-milih."
 },
 {
   "id": 21068,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 7,
   "firman": "Sebab darah yang dicurahkannya masih terdapat di tengah-tengahnya; ia mencurahkannya di atas bukit batu yang gundul. Ia tidak mencurahkannya di atas tanah, supaya ditutupinya dengan tanah."
 },
 {
   "id": 21069,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 8,
   "firman": "Demi amarah yang timbul dan rasa pembalasan yang bangkit Aku akan mencurahkan darahnya sendiri ke atas bukit batu yang gundul supaya jangan ditutupi."
 },
 {
   "id": 21070,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 9,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Celakalah kota yang penuh hutang darah! Aku juga hendak memperbesar pancakanya."
 },
 {
   "id": 21071,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 10,
   "firman": "Susunlah banyak kayu, nyalakan api, biarlah dagingnya masak betul, buanglah kuahnya dan biarlah tulang-tulangnya hangus."
 },
 {
   "id": 21072,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 11,
   "firman": "Letakkanlah periuk itu kosong di atas bara api, supaya itu dibakar dan tembaganya menjadi merah, sehingga kotorannya hancur di dalamnya dan karatnya hilang."
 },
 {
   "id": 21073,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 12,
   "firman": "Aku bersusah payah dengan sia-sia, sebab karatnya yang tebal tidak mau hilang dari padanya, biar dalam api."
 },
 {
   "id": 21074,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 13,
   "firman": "Oleh karena engkau menajiskan dirimu dengan kemesumanmu, dan Aku ingin mentahirkan engkau, tetapi engkau tidak menjadi tahir dari kenajisanmu, maka engkau tidak akan ditahirkan lagi, sampai Aku melampiaskan amarah-Ku atasmu."
 },
 {
   "id": 21075,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 14,
   "firman": "Aku, TUHAN, yang mengatakannya. Hal itu akan datang, dan Aku yang akan membuatnya. Aku tidak melalaikannya dan tidak merasa sayang, juga tidak menyesal. Aku akan menghakimi engkau menurut perbuatanmu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21076,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 15,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21077,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 16,
   "firman": "\"Hai anak manusia, lihat, Aku hendak mengambil dari padamu dia yang sangat kaucintai seperti yang kena tulah, tetapi janganlah meratap ataupun menangis dan janganlah mengeluarkan air mata."
 },
 {
   "id": 21078,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 17,
   "firman": "Diam-diam saja mengeluh, jangan mengadakan ratapan kematian; lilitkanlah destarmu dan pakailah kasutmu, jangan tutupi mukamu dan jangan makan roti perkabungan.\""
 },
 {
   "id": 21079,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 18,
   "firman": "Pada paginya aku berbicara kepada bangsa itu dan pada malamnya isteriku mati. Pada pagi berikutnya aku melakukan seperti diperintahkan kepadaku."
 },
 {
   "id": 21080,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 19,
   "firman": "Maka bangsa itu berkata kepadaku: \"Tidakkah engkau bersedia memberitahukan kepada kami, apa artinya ini bagi kami, bahwa engkau melakukan demikian?\""
 },
 {
   "id": 21081,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 20,
   "firman": "Lalu kujawab mereka: \"Firman TUHAN sudah datang kepadaku:"
 },
 {
   "id": 21082,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 21,
   "firman": "Katakanlah kepada kaum Israel: Beginilah firman Tuhan ALLAH: Sesungguh-sungguhnya Aku akan menajiskan tempat kudus-Ku, kekuasaanmu yang kaubanggakan, kenikmatan bagi matamu dan bagi jiwamu; dan anak-anakmu lelaki dan perempuan yang kamu tinggalkan akan mati rebah oleh pedang."
 },
 {
   "id": 21083,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 22,
   "firman": "Kamu akan melakukan seperti yang kulakukan: Mukamu tidak akan kamu tutupi dan roti perkabungan tidak akan kamu makan,"
 },
 {
   "id": 21084,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 23,
   "firman": "kepalamu pakai destar dan kakimu pakai kasut; dan kamu tidak akan meratap atau menangis. Tetapi kamu akan hancur lebur dalam hukumanmu, dan kamu akan mengeluh seorang kepada yang lain."
 },
 {
   "id": 21085,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 24,
   "firman": "Demikianlah Yehezkiel menjadi lambang bagimu; tepat seperti yang dilakukannya kamu akan lakukan. Kalau itu sudah terjadi maka kamu akan mengetahui, bahwa Akulah Tuhan ALLAH."
 },
 {
   "id": 21086,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 25,
   "firman": "Dan engkau, anak manusia, bukankah begini akan terjadi? Pada hari Aku mengambil dari mereka benteng mereka, perhiasannya yang menggirangkan hatinya, kenikmatan matanya dan yang dirindukan jiwanya, anak-anak mereka lelaki dan perempuan,"
 },
 {
   "id": 21087,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 26,
   "firman": "pada hari itu juga akan datang seorang yang terluput membawa berita kepadamu."
 },
 {
   "id": 21088,
   "kitab": "Yeh",
   "pasal": 24,
   "ayat": 27,
   "firman": "Pada hari itu mulutmu akan terbuka dan engkau akan berbicara kepada orang yang terluput itu dan tidak lagi tetap bisu. Dengan demikian engkau menjadi lambang bagi mereka dan mereka akan mengetahui, bahwa Akulah TUHAN.\""
 },
 {
   "id": 21089,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21090,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu kepada bani Amon dan bernubuatlah melawan mereka!"
 },
 {
   "id": 21091,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 3,
   "firman": "Katakanlah kepada bani Amon: Dengarlah firman Tuhan ALLAH: Beginilah firman Tuhan ALLAH: Oleh karena engkau menyerukan: Syukur! mengenai tempat kudus-Ku, waktu kekudusannya dilanggar, dan mengenai tanah Israel, waktu itu dijadikan sunyi sepi, dan mengenai kaum Yehuda, waktu mereka harus pergi ke dalam pembuangan,"
 },
 {
   "id": 21092,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 4,
   "firman": "oleh sebab itu, sungguh, Aku menyerahkan engkau kepada orang dari sebelah timur menjadi miliknya; mereka akan mendirikan perkemahannya padamu dan membangun tempat kediamannya; mereka akan memakan buah-buahanmu dan meminum susu ternakmu."
 },
 {
   "id": 21093,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 5,
   "firman": "Aku akan membuat Raba menjadi padang rumput untuk unta dan kota-kota bani Amon menjadi tempat kambing domba. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21094,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 6,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Oleh karena engkau bertepuk tangan dan mengentakkan kakimu ke tanah, dan bergembira dalam hatimu atas kecelakaan tanah Israel,"
 },
 {
   "id": 21095,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 7,
   "firman": "oleh sebab itu, sungguh, Aku akan mengacungkan tangan-Ku melawan engkau dan menyerahkan engkau menjadi jarahan bagi suku-suku bangsa dan melenyapkan engkau dari tengah bangsa-bangsa dan membinasakan engkau dari negeri-negeri; Aku akan memusnahkan engkau. Dengan demikian engkau akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21096,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 8,
   "firman": "Beginilah firman Tuhan ALLAH: \"Oleh karena Moab berkata: Sungguh, kaum Yehuda adalah sama dengan semua bangsa lain,"
 },
 {
   "id": 21097,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 9,
   "firman": "oleh sebab itu, sungguh, Aku akan membiarkan dataran tinggi Moab terbuka dengan runtuhnya kota-kotanya, ya, kota-kotanya tanpa terkecuali, yaitu kepermaian negeri itu: Bet-Yesimot, Baal-Meon dan Kiryataim."
 },
 {
   "id": 21098,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 10,
   "firman": "Aku akan menyerahkan dia bersama bani Amon kepada orang dari sebelah Timur menjadi miliknya, supaya bani Amon jangan diingat-ingat lagi di antara bangsa-bangsa."
 },
 {
   "id": 21099,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 11,
   "firman": "Aku akan menjatuhkan hukuman kepada Moab dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21100,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 12,
   "firman": "Beginilah firman Tuhan ALLAH: \"Oleh karena Edom membalaskan dendam kesumat terhadap kaum Yehuda dan membuat kesalahan besar dengan melakukan pembalasan terhadap mereka,"
 },
 {
   "id": 21101,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 13,
   "firman": "oleh sebab itu beginilah firman Tuhan ALLAH, Aku akan mengacungkan tangan-Ku melawan Edom dan melenyapkan dari padanya manusia dan binatang dan Aku membuatnya menjadi reruntuhan; dari Teman sampai Dedan mereka akan mati rebah oleh pedang."
 },
 {
   "id": 21102,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 14,
   "firman": "Aku akan melakukan pembalasan-Ku terhadap Edom dengan tangan umat-Ku Israel. Dan mereka akan memperlakukan Edom selaras dengan murka-Ku dan amarah-Ku, dan mereka akan mengetahui, bahwa Akulah yang membalas, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21103,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 15,
   "firman": "Beginilah firman Tuhan ALLAH: \"Oleh karena orang Filistin membalaskan dendam kesumat dan di dalam kegembiraannya atas kecelakaan Israel melakukan pembalasan dengan melakukan pembinasaan karena rasa permusuhan yang turun-temurun,"
 },
 {
   "id": 21104,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 16,
   "firman": "oleh sebab itu, beginilah firman Tuhan ALLAH: Sungguh, Aku akan mengacungkan tangan-Ku melawan orang Filistin dan melenyapkan orang Kreta dan membinasakan yang lain-lain di tepi pantai laut."
 },
 {
   "id": 21105,
   "kitab": "Yeh",
   "pasal": 25,
   "ayat": 17,
   "firman": "Aku akan melakukan pembalasan yang kejam terhadap mereka disertai penghajaran-penghajaran kemarahan. Dan mereka akan mengetahui bahwa Akulah TUHAN, pada waktu Aku melakukan pembalasan-Ku terhadap mereka.\""
 },
 {
   "id": 21106,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 1,
   "firman": "Pada tahun kesebelas, dalam bulan yang tertentu, pada tanggal satu bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21107,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 2,
   "firman": "\"Hai anak manusia, oleh karena Tirus berkata mengenai Yerusalem: Syukur! Sudah rusak pintu gerbang bangsa-bangsa itu; ia akan beralih kepadaku, sehingga aku menjadi penuh, tetapi ia menjadi reruntuhan."
 },
 {
   "id": 21108,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 3,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Lihat, Aku menjadi lawanmu, hai Tirus. Aku akan menyuruh bangkit banyak bangsa melawan engkau, seperti lautan menimbulkan gelombang-gelombangnya."
 },
 {
   "id": 21109,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 4,
   "firman": "Mereka akan memusnahkan tembok-tembok Tirus dan meruntuhkan menara-menaranya, debu tanahnya akan Kubuang sampai bersih dari padanya dan akan Kujadikan dia gunung batu yang gundul."
 },
 {
   "id": 21110,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 5,
   "firman": "Ia akan menjadi penjemuran pukat di tengah lautan, sebab Aku yang mengatakannya, demikianlah firman Tuhan ALLAH; ia akan menjadi jarahan bagi bangsa-bangsa."
 },
 {
   "id": 21111,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 6,
   "firman": "Dan anak-anaknya perempuan, yang tinggal di daratan akan ditewaskan dengan pedang. Dan mereka akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21112,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 7,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Sungguh, Aku membawa dari utara raja Nebukadnezar, raja Babel, raja segala raja untuk melawan Tirus dengan memakai kuda, kereta, pasukan berkuda, dan sekumpulan tentara yang banyak."
 },
 {
   "id": 21113,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 8,
   "firman": "Anak-anakmu perempuan yang tinggal di daratan akan dibunuhnya dengan pedang; ia akan menimbun tembok pengepungan dan menyusun alat-alat pendobrak dan memasang perisai melawan engkau."
 },
 {
   "id": 21114,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 9,
   "firman": "Tumbukan alat pendobraknya akan dilancarkan terhadap tembok-tembokmu dan menara-menaramu akan dirobohkan dengan beliung-beliungnya."
 },
 {
   "id": 21115,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 10,
   "firman": "Kudanya adalah begitu banyak, sehingga engkau akan ditutupi oleh abu; karena derap pasukan berkudanya dan kertak roda keretanya tembok-tembokmu akan gemetar, kalau ia memasuki pintu-pintu gerbangmu seperti orang memasuki kota yang sudah terbuka karena pendobrakan."
 },
 {
   "id": 21116,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 11,
   "firman": "Dengan kaki kuda-kudanya ia hendak menginjak-injak semua jalan-jalanmu, rakyatmu akan dibunuh dengan pedang, dan tugu-tugu yang kauandalkan akan dirobohkan ke tanah."
 },
 {
   "id": 21117,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 12,
   "firman": "Mereka akan merampas kekayaanmu dan menjarah barang-barang perniagaanmu; mereka akan meruntuhkan tembok-tembokmu dan merobohkan rumah-rumahmu yang indah; batumu, kayumu dan tanahmu akan dibuang ke dalam air."
 },
 {
   "id": 21118,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 13,
   "firman": "Aku akan mengakhiri keramaian nyanyianmu dan suara kecapimu tidak akan kedengaran lagi."
 },
 {
   "id": 21119,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 14,
   "firman": "Aku akan menjadikan engkau gunung batu yang gundul dan dengan demikian engkau akan menjadi penjemuran pukat, sehingga engkau tidak akan dibangun kembali, sebab Aku, Tuhanlah yang mengatakannya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21120,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 15,
   "firman": "Beginilah firman Tuhan ALLAH kepada Tirus: Apakah daerah pesisir tidak akan gemetar mendengar derum kejatuhanmu, kalau orang-orang yang berebahan mengerang karena pembunuhan bersimaharajalela di tengah-tengahmu?"
 },
 {
   "id": 21121,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 16,
   "firman": "Semua pemuka bangsa-bangsa yang di tepi lautan akan turun takhta dan menjauhkan jubah-jubah kerajaannya dan menanggalkan pakaiannya yang berwarna-warna. Mereka akan diliputi kegentaran dan akan duduk di tanah; mereka akan gentar senantiasa dan kaget melihat engkau."
 },
 {
   "id": 21122,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 17,
   "firman": "Dan mereka akan mengucapkan suatu ratapan mengenai engkau dan akan mengatakan kepadamu: Bagaimana engkau, hai kota yang terpuja, hilang dari lautan, kota yang berkuasa di laut, engkau dengan pendudukmu, yang menimbulkan ketakutan pada penduduk di daratan?"
 },
 {
   "id": 21123,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 18,
   "firman": "Sekarang, daerah pesisir jadi gentar pada hari jatuhmu, ya, daerah pesisir yang di tepi laut gempar mendengar kesudahanmu."
 },
 {
   "id": 21124,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 19,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Pada saat Aku menjadikan engkau kota reruntuhan, seperti kota-kota yang tidak berpenduduk lagi, kalau Aku menaikkan pasang samudera raya atasmu dan air banjir menutupi engkau,"
 },
 {
   "id": 21125,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 20,
   "firman": "maka Aku akan menurunkan engkau, supaya engkau bersama-sama di sana dengan orang-orang yang turun ke liang kubur, kepada bangsa dahulu kala, dan Aku akan membuat engkau tinggal di bumi yang paling bawah seperti reruntuhan dahulu kala, bersama dengan orang-orang yang turun ke liang kubur, supaya engkau jangan lagi didiami orang, dan jangan tampil lagi di negeri orang-orang hidup."
 },
 {
   "id": 21126,
   "kitab": "Yeh",
   "pasal": 26,
   "ayat": 21,
   "firman": "Aku menentukan bagimu akhir hidupmu yang mendahsyatkan dan engkau tidak terjumpa lagi. Engkau dicari orang, tetapi tidak ditemui lagi untuk selama-lamanya, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21127,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21128,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 2,
   "firman": "\"Hai engkau anak manusia, ucapkanlah suatu ratapan mengenai Tirus,"
 },
 {
   "id": 21129,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 3,
   "firman": "dan katakanlah kepada Tirus, yang terletak di pintu masuk lautan, dan yang berdagang dengan bangsa-bangsa di banyak daerah pesisir: Beginilah firman Tuhan ALLAH: Hai Tirus, engkau berkata: aku kapal yang maha indah."
 },
 {
   "id": 21130,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 4,
   "firman": "Wilayahmu di tengah lautan; ahli bangunmu membuat keindahanmu sempurna."
 },
 {
   "id": 21131,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 5,
   "firman": "Seluruh badanmu mereka buat dari kayu sanobar Senir, mereka mengambil aras Libanon membuat bagimu tiang layar."
 },
 {
   "id": 21132,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 6,
   "firman": "Pohon tarbantin dari Basan dipakai untuk dayungmu; geladakmu mereka buat dari tulang gading ditatahkan di cemara dari pantai Kitim."
 },
 {
   "id": 21133,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 7,
   "firman": "Layarmu diperbuat dari lenan halus yang berwarna-warni dari tanah Mesir; itulah tandamu. Dan tendamu diperbuat dari kain ungu tua dan kain ungu muda dari pantai Elisa."
 },
 {
   "id": 21134,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 8,
   "firman": "Orang Sidon dan Arwad menjadi pendayungmu; tukang-tukangmu, hai Tirus, berada padamu, mereka menjadi pelaut-pelautmu."
 },
 {
   "id": 21135,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 9,
   "firman": "Tua-tua Gebal dengan ahli-ahlinya berada padamu hendak memperbaiki kerusakan-kerusakanmu. Segala kapal laut beserta anak kapalnya berlabuh padamu hendak menukarkan barang dagangannya."
 },
 {
   "id": 21136,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 10,
   "firman": "Orang Persia, Lud dan Put, yang menjadi prajuritmu ada dalam ketenteraanmu. Perisai dan ketopong digantungkan padamu; mereka menambah semarakmu."
 },
 {
   "id": 21137,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 11,
   "firman": "Orang Arwad dan tentaranya memanjat di atas tembok-tembokmu sekeliling dan orang Gamad di atas menara-menaramu; mereka menggantungkan perisai-perisainya pada tembok-tembokmu sekeliling, mereka membuat keindahanmu sempurna."
 },
 {
   "id": 21138,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 12,
   "firman": "Tarsis berdagang dengan engkau dalam segala macam harta yang banyak; mereka menukarkan perak, besi, timah putih dan timah hitam ganti barang-barangmu."
 },
 {
   "id": 21139,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 13,
   "firman": "Yawan, Tubal dan Mesekh berdagang dengan engkau; mereka menukarkan budak-budak, barang-barang tembaga ganti barang-barang daganganmu."
 },
 {
   "id": 21140,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 14,
   "firman": "Dari Bet-Togarma mereka menukarkan kuda kereta, kuda tunggang dan bagal ganti barang-barangmu."
 },
 {
   "id": 21141,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 15,
   "firman": "Orang Rodos berdagang dengan engkau, banyak daerah pesisir menjadi daerah pasaranmu; mereka membawa kepadamu tulang gading dan kayu arang sebagai upeti."
 },
 {
   "id": 21142,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 16,
   "firman": "Edom berdagang dengan engkau karena banyaknya hasil-hasilmu; mereka menukarkan permata batu darah, kain ungu muda, pakaian berwarna-warna, kain lenan halus, karang dan batu delima ganti barang-barangmu."
 },
 {
   "id": 21143,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 17,
   "firman": "Yuda dan tanah Israel berdagang dengan engkau; mereka menukarkan gandum dari Minit, mur, madu, minyak dan balsam ganti barang-barang daganganmu."
 },
 {
   "id": 21144,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 18,
   "firman": "Damsyik berdagang dengan engkau karena banyaknya hasil-hasilmu, karena segala macam barangmu yang banyak. Anggur dari Helbon, bulu domba dari Sakhar,"
 },
 {
   "id": 21145,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 19,
   "firman": "dan anggur ditukarkan mereka ganti barang-barangmu; besi yang sudah dikerjakan dari Uzal, kayu teja dan tebu ada di antara barang-barang daganganmu."
 },
 {
   "id": 21146,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 20,
   "firman": "Dedan berdagang dengan engkau dalam kulit pelana untuk menunggang kuda."
 },
 {
   "id": 21147,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 21,
   "firman": "Arab dan semua pemuka Kedar berdagang dengan engkau dalam anak domba, domba jantan dan kambing jantan; dalam hal-hal itulah mereka berdagang dengan engkau."
 },
 {
   "id": 21148,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 22,
   "firman": "Pedagang Syeba dan Raema berdagang dengan engkau; mereka menukarkan yang terbaik dari segala rempah-rempah dan segala batu permata yang mahal-mahal dan emas ganti barang-barangmu."
 },
 {
   "id": 21149,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 23,
   "firman": "Haran, Kane, Eden, Asyur dan Kilmad berdagang dengan engkau."
 },
 {
   "id": 21150,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 24,
   "firman": "Mereka berdagang di pasar-pasarmu dalam jubah-jubah yang maha indah, kain ungu tua, pakaian yang berwarna-warni, permadani yang beraneka warna dan tali berpilin yang teguh."
 },
 {
   "id": 21151,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 25,
   "firman": "Kapal-kapal Tarsis membawa barang-barang dagangan ini bagimu. Penuh dengan muatan berat engkau di tengah lautan."
 },
 {
   "id": 21152,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 26,
   "firman": "Ke lautan luas pendayungmu membawa engkau. Tetapi badai timur melandamu di tengah lautan."
 },
 {
   "id": 21153,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 27,
   "firman": "Hartamu, barangmu, daganganmu, anak kapalmu dan pelaut-pelautmu, tukang-tukangmu dan pedagang-pedagangmu dengan semua prajurit-prajuritmu yang ada padamu, ya, bersama seluruh penumpang-penumpangmu, terbenam dalam lautan pada hari tenggelammu."
 },
 {
   "id": 21154,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 28,
   "firman": "Mendengar teriakan pelautmu gemetarlah tanah daratan."
 },
 {
   "id": 21155,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 29,
   "firman": "Mereka turun dari kapalnya, yang mengayun dayung semua. Anak kapal, pelaut semuanya ke daratan lari mereka."
 },
 {
   "id": 21156,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 30,
   "firman": "Ratapan kuat, teriakan pahit diperdengarkan terhadapmu; taruh abu di atas kepala, berguling-guling dalam debu."
 },
 {
   "id": 21157,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 31,
   "firman": "Mereka menggundul diri, demi engkau, dan melilitkan kain kabung; mereka menangis, jiwa merana, karena engkau; suatu ratapan yang pahit."
 },
 {
   "id": 21158,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 32,
   "firman": "Dalam meratap karena engkau mereka mengucapkan, menangiskan ratapan: Siapa seperti Tirus, yang sudah dimusnahkan di tengah lautan?"
 },
 {
   "id": 21159,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 33,
   "firman": "Sesudah barangmu datang dari laut engkau mengenyangkan banyak bangsa-bangsa, dengan banyaknya hartamu, daganganmu engkau memperkaya raja-raja dunia."
 },
 {
   "id": 21160,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 34,
   "firman": "Sekarang engkau dirusak dan dilenyapkan dari permukaan laut dan tenggelam di dasar lautan; daganganmu dan seluruh penumpangmu tenggelam dengan engkau."
 },
 {
   "id": 21161,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 35,
   "firman": "Orang pesisir kaget semua melihatmu; raja-rajanya menggigil, mukanya berkerut."
 },
 {
   "id": 21162,
   "kitab": "Yeh",
   "pasal": 27,
   "ayat": 36,
   "firman": "Pedagang bangsa-bangsa bersuit-suit terhadapmu, akhir hidupmu mendahsyatkan, dan lenyap selamanya engkau.\""
 },
 {
   "id": 21163,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 1,
   "firman": "Maka datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21164,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 2,
   "firman": "\"Hai anak manusia, katakanlah kepada raja Tirus: Beginilah firman Tuhan ALLAH: Karena engkau menjadi tinggi hati, dan berkata: Aku adalah Allah! Aku duduk di takhta Allah di tengah-tengah lautan. Padahal engkau adalah manusia, bukanlah Allah, walau hatimu menempatkan diri sama dengan Allah."
 },
 {
   "id": 21165,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 3,
   "firman": "Memang hikmatmu melebihi hikmat Daniel; tiada rahasia yang terlindung bagimu."
 },
 {
   "id": 21166,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 4,
   "firman": "Dengan hikmatmu dan pengertianmu engkau memperoleh kekayaan. Emas dan perak kaukumpulkan dalam perbendaharaanmu."
 },
 {
   "id": 21167,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 5,
   "firman": "Karena engkau sangat pandai berdagang engkau memperbanyak kekayaanmu, dan karena itu engkau jadi sombong."
 },
 {
   "id": 21168,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 6,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Karena hatimu menempatkan diri sama dengan Allah"
 },
 {
   "id": 21169,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 7,
   "firman": "maka, sungguh, Aku membawa orang asing melawan engkau, yaitu bangsa yang paling ganas, yang akan menghunus pedang mereka, melawan hikmatmu yang terpuja; dan semarakmu dinajiskan."
 },
 {
   "id": 21170,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 8,
   "firman": "Engkau diturunkannya ke lobang kubur, engkau mati seperti orang yang mati terbunuh di tengah lautan."
 },
 {
   "id": 21171,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 9,
   "firman": "Apakah engkau masih akan mengatakan di hadapan pembunuhmu: Aku adalah Allah!? Padahal terhadap kuasa penikammu engkau adalah manusia, bukanlah Allah."
 },
 {
   "id": 21172,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 10,
   "firman": "Engkau akan mati seperti orang tak bersunat oleh tangan orang asing. Sebab Aku yang mengatakannya, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21173,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 11,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21174,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 12,
   "firman": "\"Hai anak manusia, ucapkanlah suatu ratapan mengenai raja Tirus dan katakanlah kepadanya: Beginilah firman Tuhan ALLAH: Gambar dari kesempurnaan engkau, penuh hikmat dan maha indah."
 },
 {
   "id": 21175,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 13,
   "firman": "Engkau di taman Eden, yaitu taman Allah penuh segala batu permata yang berharga: yaspis merah, krisolit dan yaspis hijau, permata pirus, krisopras dan nefrit, lazurit, batu darah dan malakit. Tempat tatahannya diperbuat dari emas dan disediakan pada hari penciptaanmu."
 },
 {
   "id": 21176,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 14,
   "firman": "Kuberikan tempatmu dekat kerub yang berjaga, di gunung kudus Allah engkau berada dan berjalan-jalan di tengah batu-batu yang bercahaya-cahaya."
 },
 {
   "id": 21177,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 15,
   "firman": "Engkau tak bercela di dalam tingkah lakumu sejak hari penciptaanmu sampai terdapat kecurangan padamu."
 },
 {
   "id": 21178,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 16,
   "firman": "Dengan dagangmu yang besar engkau penuh dengan kekerasan dan engkau berbuat dosa. Maka Kubuangkan engkau dari gunung Allah dan kerub yang berjaga membinasakan engkau dari tengah batu-batu yang bercahaya."
 },
 {
   "id": 21179,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 17,
   "firman": "Engkau sombong karena kecantikanmu, hikmatmu kaumusnahkan demi semarakmu. Ke bumi kau Kulempar, kepada raja-raja engkau Kuserahkan menjadi tontonan bagi matanya."
 },
 {
   "id": 21180,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 18,
   "firman": "Dengan banyaknya kesalahanmu dan kecurangan dalam dagangmu engkau melanggar kekudusan tempat kudusmu. Maka Aku menyalakan api dari tengahmu yang akan memakan habis engkau. Dan Kubiarkan engkau menjadi abu di atas bumi di hadapan semua yang melihatmu."
 },
 {
   "id": 21181,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 19,
   "firman": "Semua di antara bangsa-bangsa yang mengenal engkau kaget melihat keadaanmu. Akhir hidupmu mendahsyatkan dan lenyap selamanya engkau.\""
 },
 {
   "id": 21182,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 20,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21183,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 21,
   "firman": "\"Hai anak manusia, tujukanlah mukamu kepada Sidon dan bernubuatlah melawan dia"
 },
 {
   "id": 21184,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 22,
   "firman": "dan katakanlah: Beginilah firman Tuhan ALLAH: Lihat, Aku menjadi lawanmu, hai Sidon, dan Aku menyatakan kemuliaan-Ku di tengah-tengahmu. Dan mereka akan mengetahui bahwa Akulah TUHAN, pada saat Aku menjatuhkan hukuman atasnya dan menunjukkan kekudusan-Ku terhadap dia."
 },
 {
   "id": 21185,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 23,
   "firman": "Aku akan mendatangkan sampar atasnya dan darah akan mengalir di jalan-jalannya dan orang-orang akan mati rebah di tengah-tengahnya karena pedang yang datang dari sekitarnya melawan dia. Dan mereka akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21186,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 24,
   "firman": "Dan tidak akan ada lagi bagi kaum Israel dari semua tetangganya yang menghina mereka, menjadi duri yang menusuk atau onak yang memedihkan. Dan mereka akan mengetahui bahwa Akulah Tuhan ALLAH."
 },
 {
   "id": 21187,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 25,
   "firman": "Beginilah firman Tuhan ALLAH: Pada saat Aku mengumpulkan kaum Israel dari tengah suku-suku bangsa, di mana mereka berserak dan Aku menunjukkan kekudusan-Ku kepada mereka di hadapan bangsa-bangsa, maka mereka akan diam di tanah mereka yang telah Kuberikan kepada hamba-Ku Yakub."
 },
 {
   "id": 21188,
   "kitab": "Yeh",
   "pasal": 28,
   "ayat": 26,
   "firman": "Mereka akan diam di sana dengan aman tenteram, mereka akan membangun rumah dan membuat kebun anggur. Ya, mereka akan diam dengan aman tenteram pada saat Aku menjatuhkan hukuman atas semua tetangganya yang menghina mereka. Dan mereka akan mengetahui bahwa Akulah TUHAN, Allah mereka.\""
 },
 {
   "id": 21189,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 1,
   "firman": "Pada tahun kesepuluh, dalam bulan yang kesepuluh, pada tanggal dua belas bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21190,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu kepada Firaun, raja Mesir dan bernubuatlah melawan dia dan melawan seluruh Mesir."
 },
 {
   "id": 21191,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 3,
   "firman": "Berbicaralah dan katakan: Beginilah firman Tuhan ALLAH: Lihat, Aku menjadi lawanmu, hai Firaun, raja Mesir, buaya yang besar, yang berbaring di tengah anak-anak sungaimu, yaitu Nil, dan yang berkata: Sungai Nil aku punya, aku yang membuatnya."
 },
 {
   "id": 21192,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 4,
   "firman": "Aku akan mengenakan kelikir pada rahangmu dan membuat ikan dari anak-anak sungaimu berlekatan pada sisikmu. Aku akan mengangkat engkau dari tengah anak-anak sungaimu dengan segala ikannya yang berlekatan pada sisikmu"
 },
 {
   "id": 21193,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 5,
   "firman": "dan Aku akan melemparkan engkau ke padang gurun, ya, engkau dengan segala ikan anak-anak sungaimu. Engkau akan jatuh di padang dan tidak akan dipungut atau dikubur. Aku memberikan engkau menjadi makanan binatang-binatang liar dan burung-burung di udara."
 },
 {
   "id": 21194,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 6,
   "firman": "Dan semua penduduk Mesir akan mengetahui bahwa Akulah TUHAN. Oleh karena engkau ibarat tongkat bambu bagi kaum Israel:"
 },
 {
   "id": 21195,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 7,
   "firman": "pada saat mereka memegang engkau dengan tangan, engkau patah terkulai dan engkau melukai bahu mereka semua; dan waktu mereka bertopang padamu, engkau patah dan engkau membuat mereka semua terhuyung-huyung."
 },
 {
   "id": 21196,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 8,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Sungguh, Aku mendatangkan pedang atasmu dan melenyapkan manusia dan binatang dari padamu,"
 },
 {
   "id": 21197,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 9,
   "firman": "sehingga tanah Mesir akan menjadi sunyi sepi dan menjadi reruntuhan. Dan mereka akan mengetahui bahwa Akulah TUHAN. Oleh karena engkau berkata: Sungai Nil aku punya, aku yang membuatnya,"
 },
 {
   "id": 21198,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 10,
   "firman": "maka sungguh, Aku menjadi lawanmu dan lawan anak-anak sungaimu dan Aku akan membuat tanah Mesir menjadi reruntuhan dan menjadi sunyi sepi mulai dari Migdol sampai Siene, bahkan sampai perbatasan tanah Etiopia."
 },
 {
   "id": 21199,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 11,
   "firman": "Tidak seorang manusiapun akan melintasinya, bahkan seekor binatangpun tidak dan tanah itu tidak akan didiami selama empat puluh tahun."
 },
 {
   "id": 21200,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 12,
   "firman": "Aku akan membuat tanah Mesir menjadi sunyi sepi di tengah negeri-negeri yang sudah dimusnahkan dan kota-kotanya akan menjadi sunyi sepi di tengah kota-kota yang diruntuhkan selama empat puluh tahun. Aku akan menyerakkan orang Mesir di antara bangsa-bangsa dan menghamburkannya ke semua negeri."
 },
 {
   "id": 21201,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 13,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Pada akhir keempat puluh tahun itu Aku akan mengumpulkan orang-orang Mesir dari tengah bangsa-bangsa di mana mereka berserak."
 },
 {
   "id": 21202,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 14,
   "firman": "Dan Aku akan memulihkan keadaan Mesir dan mengembalikan mereka ke tanah Patros, yaitu tanah asal mereka, dan di sana mereka menjadi kerajaan yang lemah."
 },
 {
   "id": 21203,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 15,
   "firman": "Di antara kerajaan-kerajaan ia akan yang paling lemah dan tidak akan dapat meninggikan dirinya lagi di atas bangsa-bangsa lain. Aku akan membuat mereka begitu lemah, sehingga mereka tidak akan memerintah bangsa-bangsa lagi."
 },
 {
   "id": 21204,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 16,
   "firman": "Dan bagi kaum Israel mereka tidak lagi menjadi kepercayaan, yang mengingatkan kesalahan Israel, kalau Israel berpaling kepada mereka untuk meminta pertolongan. Dan Mesir akan mengetahui bahwa Akulah Tuhan ALLAH.\""
 },
 {
   "id": 21205,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 17,
   "firman": "Lalu pada tahun kedua puluh tujuh, dalam bulan pertama, pada tanggal satu bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21206,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 18,
   "firman": "\"Hai anak manusia, Nebukadnezar, raja Babel, menyuruh tentaranya bekerja keras melawan Tirus; semua kepala sudah gundul dan semua bahu sudah lecet, tetapi baik ia maupun tentaranya tidak mendapat untung dari Tirus atas usaha yang dilakukannya melawan dia."
 },
 {
   "id": 21207,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 19,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Aku memberikan tanah Mesir kepada Nebukadnezar, raja Babel, dan ia akan mengangkut kekayaannya; ia akan melakukan perampasan dan penjarahan dan itulah upah bagi tentaranya."
 },
 {
   "id": 21208,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 20,
   "firman": "Aku akan memberikan kepadanya tanah Mesir sebagai pahala atas pekerjaan yang dilakukannya, sebab mereka sudah bekerja bagi-Ku, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21209,
   "kitab": "Yeh",
   "pasal": 29,
   "ayat": 21,
   "firman": "Pada hari itu Aku akan menumbuhkan tanduk bagi kaum Israel dan membuat engkau dapat berbicara lagi di tengah-tengah mereka. Dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21210,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21211,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 2,
   "firman": "\"Hai anak manusia, bernubuatlah dan katakanlah: Beginilah firman Tuhan ALLAH: Merataplah: Aduh, hari itu!"
 },
 {
   "id": 21212,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 3,
   "firman": "Hari itu sudah dekat, hari TUHAN sudah dekat, hari dengan awan gelap; itu adalah saat bangsa-bangsa."
 },
 {
   "id": 21213,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 4,
   "firman": "Pedang datang atas Mesir dan Etiopia akan gemetar pada saat berebahan orang-orang yang mati terbunuh di Mesir dan kekayaannya dilarikan dan dasar-dasarnya terbongkar."
 },
 {
   "id": 21214,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 5,
   "firman": "Orang Etiopia, Put, Lud, seluruh tanah Arab, Libia dan orang-orang dari negeri yang bersekutu dengan mereka akan mati rebah oleh pedang bersama mereka."
 },
 {
   "id": 21215,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 6,
   "firman": "Beginilah firman TUHAN: Orang-orang yang mendukung Mesir akan mati rebah, dan kecongkakan Mesir yang ditimbulkan kekuatannya akan patah. Dari Migdol sampai Siene mereka mati rebah oleh pedang, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21216,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 7,
   "firman": "Ia akan dimusnahkan di tengah negeri-negeri yang sudah sunyi sepi dan kota-kotanya termasuk kota-kota yang sudah runtuh."
 },
 {
   "id": 21217,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 8,
   "firman": "Maka mereka akan mengetahui bahwa Akulah TUHAN, pada saat Aku menimbulkan api di Mesir sehingga semua orang yang membantunya dimusnahkan."
 },
 {
   "id": 21218,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 9,
   "firman": "Pada hari itu utusan-utusan-Ku akan berangkat dengan cepat-cepat untuk mengejutkan Etiopia yang bersenang-senang dan mereka akan gentar pada hari penghukuman Mesir; sebab, sungguh, hari itu akan datang!"
 },
 {
   "id": 21219,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 10,
   "firman": "Beginilah firman Tuhan ALLAH: Aku akan meniadakan kekayaan Mesir dengan perantaraan Nebukadnezar, raja Babel."
 },
 {
   "id": 21220,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 11,
   "firman": "Ia bersama bangsanya, yaitu yang paling ganas di antara bangsa-bangsa, akan dibawa untuk memusnahkan tanah itu dan mereka akan menghunus pedang terhadap Mesir dan memenuhi tanah itu dengan orang-orang yang terbunuh."
 },
 {
   "id": 21221,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 12,
   "firman": "Aku akan mengeringkan anak-anak sungai Nil dan akan menyerahkan tanah itu dalam tangan orang-orang jahat dan memusnahkan tanah itu serta segala isinya dengan perantaraan orang-orang asing. Aku, TUHAN, yang mengatakannya."
 },
 {
   "id": 21222,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 13,
   "firman": "Beginilah firman Tuhan ALLAH: Aku akan membinasakan berhala-berhala dan meniadakan dewa-dewa dari Memfis; dan tidak akan ada lagi pemimpin di tanah Mesir dan Aku akan menimbulkan ketakutan di sana."
 },
 {
   "id": 21223,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 14,
   "firman": "Aku akan memusnahkan Patros dan menimbulkan api di Soan dan menjatuhkan hukuman atas Tebe."
 },
 {
   "id": 21224,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 15,
   "firman": "Aku akan mencurahkan amarah-Ku atas Sin, benteng Mesir dan melenyapkan kekayaan Tebe."
 },
 {
   "id": 21225,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 16,
   "firman": "Aku akan menimbulkan api di Mesir, Sin akan gemetar dan Tebe akan direbut dan tembok-temboknya akan dibongkar."
 },
 {
   "id": 21226,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 17,
   "firman": "Teruna-teruna On dan Pi-Beset akan mati rebah oleh pedang dan perempuan-perempuan akan diangkut tertawan."
 },
 {
   "id": 21227,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 18,
   "firman": "Di Tahpanhes hari akan menjadi gelap pada saat Aku mematahkan kekuasaan Mesir di sana dan kecongkakannya, yang ditimbulkan kekuatannya, berakhir. Kota itu akan ditutupi oleh awan dan anak-anaknya perempuan akan diangkut tertawan."
 },
 {
   "id": 21228,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 19,
   "firman": "Dan Aku akan menjatuhkan hukuman atas Mesir dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21229,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 20,
   "firman": "Pada tahun kesebelas, dalam bulan pertama, pada tanggal tujuh bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21230,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 21,
   "firman": "\"Hai anak manusia, Aku telah mematahkan tangan kekuatan Firaun, raja Mesir, dan lihat, tangannya itu tidak dibalut supaya sembuh kembali, tidak ada yang memasang pembalut supaya kuat kembali untuk mengacungkan pedang."
 },
 {
   "id": 21231,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 22,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Lihat, Aku menjadi lawan Firaun, raja Mesir, dan Aku akan mematahkan tangannya, baik yang masih kuat maupun yang sudah patah, dan Aku akan menjatuhkan pedang dari tangannya."
 },
 {
   "id": 21232,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 23,
   "firman": "Aku akan menyerakkan orang Mesir di antara bangsa-bangsa dan menghamburkan mereka ke semua negeri."
 },
 {
   "id": 21233,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 24,
   "firman": "Aku akan menguatkan tangan raja Babel dan akan memberikan pedang-Ku dalam tangannya, tetapi Aku akan mematahkan tangan Firaun dan ia akan merintih di hadapannya seperti orang yang mendapat luka berat."
 },
 {
   "id": 21234,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 25,
   "firman": "Ya, Aku akan menguatkan tangan raja Babel, tetapi tangan raja Firaun akan jatuh terkulai. Dan mereka akan mengetahui bahwa Akulah TUHAN, pada saat Aku memberikan pedang-Ku dalam tangan raja Babel dan ia mengacungkannya melawan tanah Mesir."
 },
 {
   "id": 21235,
   "kitab": "Yeh",
   "pasal": 30,
   "ayat": 26,
   "firman": "Aku akan menyerakkan orang Mesir di antara bangsa-bangsa dan menghamburkan mereka ke semua negeri. Dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21236,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 1,
   "firman": "Pada tahun kesebelas, dalam bulan yang ketiga, pada tanggal satu bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21237,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 2,
   "firman": "\"Hai anak manusia, katakanlah kepada Firaun, raja Mesir dan kepada khalayak ramai yang mengikutinya: Di dalam kebesaranmu siapakah yang dapat menyamai engkau?"
 },
 {
   "id": 21238,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 3,
   "firman": "Lihat, Aku menyamakan engkau dengan pohon aras di Libanon, penuh dengan cabang yang elok dan daun yang rumpun sekali; tumbuhnya sangat tinggi, puncaknya sampai ke langit."
 },
 {
   "id": 21239,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 4,
   "firman": "Sungai-sungai membuatnya besar samudera raya membuatnya meninggi; itu membuat sungainya mengalir mengelilingi bedengnya itu; dan menjulurkan saluran-saluran ke segala pohon yang ada di padang."
 },
 {
   "id": 21240,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 5,
   "firman": "Maka dari itu tumbuhnya lebih tinggi dari segala pohon di padang; ranting-rantingnya menjadi banyak, cabang-cabangnya menjadi panjang lantaran air yang melimpah datang."
 },
 {
   "id": 21241,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 6,
   "firman": "Pada rantingnya diam bersarang segala burung yang di udara, di bawah cabangnya segala binatang di hutan, melahirkan anaknya; dan semuanya bangsa besar duduk bernaung di bawahnya."
 },
 {
   "id": 21242,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 7,
   "firman": "Ia elok karena besarnya dan karena cabangnya yang panjang-panjang; karena akarnya julur-jalar sampai di air yang berlimpah-limpah."
 },
 {
   "id": 21243,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 8,
   "firman": "Pohon-pohon aras di dalam taman Allah tidak akan dapat menyainginya, juga pohon sanobar tidak akan dapat menyamai ranting-rantingnya, dan pohon berangan tidak dapat dibandingkan dengan cabang-cabangnya. Segala pohon-pohon yang di taman Allah tiada yang dapat disamakan dengan dia mengenai keelokannya."
 },
 {
   "id": 21244,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 9,
   "firman": "Aku membuat dia sungguh-sungguh elok dengan cabang-cabangnya yang sangat rapat. Di taman Eden, di taman Allah segala pohon cemburu padanya."
 },
 {
   "id": 21245,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 10,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Oleh karena ia tumbuh tinggi dan puncaknya menjulang sampai ke langit dan ia menjadi sombong karena ketinggiannya,"
 },
 {
   "id": 21246,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 11,
   "firman": "maka Aku telah menyerahkan dia ke dalam tangan seorang berkuasa di antara bangsa-bangsa, supaya ia memperlakukannya selaras dengan kejahatannya; Aku menghalau dia."
 },
 {
   "id": 21247,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 12,
   "firman": "Orang-orang asing, yaitu yang paling ganas di antara bangsa-bangsa, akan menebang dia dan membiarkannya; di atas gunung-gunung dan di semua lembah cabang-cabangnya berjatuhan dan di semua alur sungai negeri itu ranting-rantingnya berpatahan dan semua bangsa di bumi pergi lari dari naungannya dan membiarkan dia."
 },
 {
   "id": 21248,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 13,
   "firman": "Di atas batangnya yang roboh itu berhinggapan segala burung di udara dan di antara cabang-cabangnya diam segala binatang di hutan."
 },
 {
   "id": 21249,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 14,
   "firman": "Semuanya ini terjadi supaya segala pohon yang di tepi air jangan meninggikan dirinya dan puncaknya jangan dijulurkan sampai ke langit dan supaya pohon-pohon besar, yaitu semua yang menghisap banyak air, jangan tetap berdiri di dalam kecongkakannya; sebab mereka semuanya telah diserahkan ke dalam maut, ke dalam bumi yang paling bawah, di tengah anak-anak manusia yang telah turun ke liang kubur."
 },
 {
   "id": 21250,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 15,
   "firman": "Beginilah firman Tuhan ALLAH: Pada hari ia turun ke dunia orang mati, Aku membuat samudera raya berkabung karena dia. Aku mengempang sungai-sungainya, sehingga air banjirnya dibendung. Dan karena dia Aku membuat gunung Libanon berpakaian kabung dan membuat segala pohon di hutan layu lesu."
 },
 {
   "id": 21251,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 16,
   "firman": "Mendengar derum kejatuhannya Aku membuat bangsa-bangsa gemetar, pada saat Aku menurunkan dia ke dunia orang mati, menjumpai mereka yang telah turun ke liang kubur. Dan segala pohon taman Eden akan merasa terhibur di bumi yang paling bawah, yaitu pohon yang terpilih dan yang terindah dari Libanon, yang menghisap banyak air."
 },
 {
   "id": 21252,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 17,
   "firman": "Mereka juga turun bersama dia ke dunia orang mati, yaitu ke orang-orang yang mati terbunuh oleh pedang, dan mereka yang bernaung di bawahnya di tengah bangsa-bangsa mati juga."
 },
 {
   "id": 21253,
   "kitab": "Yeh",
   "pasal": 31,
   "ayat": 18,
   "firman": "Maka dengan siapakah engkau dapat disamakan di antara pohon-pohon di taman Eden dalam hal kemuliaan dan kebesaran? Engkau akan diturunkan ke bumi yang paling bawah bersama pohon-pohon di taman Eden dan engkau telentang di tengah orang-orang yang tak bersunat bersama orang-orang yang mati terbunuh oleh pedang. Itulah Firaun dengan semua khalayak ramai yang mengikutinya, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21254,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 1,
   "firman": "Pada tahun kedua belas, dalam bulan yang kedua belas, pada tanggal satu bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21255,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 2,
   "firman": "\"Hai anak manusia, ucapkanlah suatu ratapan mengenai Firaun, raja Mesir dan katakanlah kepadanya: Engkau menyamakan dirimu dengan singa muda di antara bangsa-bangsa. Tetapi engkau seperti buaya di laut; sungai-sungaimu kaubuat berbuih, engkau mengeruhkan airnya dengan kaki dan menggelompar dalam lumpur sungainya."
 },
 {
   "id": 21256,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 3,
   "firman": "Beginilah firman Tuhan ALLAH: Aku memasang jaringku menangkap engkau dengan sekumpulan bangsa-bangsa yang banyak, dan mengangkat engkau di dalam pukat-Ku."
 },
 {
   "id": 21257,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 4,
   "firman": "Kuhempaskan engkau ke tanah, Kulemparkan engkau ke padang. Dan ke atasmu Kusuruh hinggap segala burung di udara, dengan dagingmu Kukenyangkan binatang-binatang seluruh bumi."
 },
 {
   "id": 21258,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 5,
   "firman": "Dagingmu Kubiarkan berhamburan di atas pegunungan, lembah-lembah Aku penuhi dengan bangkai-bangkaimu."
 },
 {
   "id": 21259,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 6,
   "firman": "Bumi Kuberi minum darahmu yang mengalir, ya, juga gunung-gunung; dan alur-alur sungai akan penuh dengannya."
 },
 {
   "id": 21260,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 7,
   "firman": "Waktu Aku membinasakan engkau, langit akan Kututup dan bintangnya Kubuat berkabut. Matahari Kututup dengan awan dan bulan, cahayanya tak disinarkan."
 },
 {
   "id": 21261,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 8,
   "firman": "Semua yang bersinar di langit akan Kugelapkan demi engkau. Kegelapan Kudatangkan atas tanahmu, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21262,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 9,
   "firman": "Aku menggelisahkan hati banyak bangsa, kalau Aku membawa kamu sebagai tawanan di tengah bangsa-bangsa, ke negeri-negeri yang belum kamu kenal."
 },
 {
   "id": 21263,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 10,
   "firman": "Aku akan membuat banyak bangsa kaget melihat engkau, dan raja-rajanya akan menggigil melihatmu, kalau Aku menetak-netakkan pedang-Ku di hadapan mereka. Mereka akan gentar, terus-menerus, masing-masing demi hidupnya, pada hari kesudahanmu."
 },
 {
   "id": 21264,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 11,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Pedang raja Babel akan datang atasmu."
 },
 {
   "id": 21265,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 12,
   "firman": "Aku akan membuat khalayak pengikutmu berebahan oleh pedang para pahlawan, semuanya yang terganas di antara bangsa-bangsa. Kecongkakan Mesir akan dipatahkan dan khalayak pengikutnya semua dipunahkan."
 },
 {
   "id": 21266,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 13,
   "firman": "Semua binatangnya akan Kubinasakan dari tepi sungai-sungai besar; kaki manusia tidak lagi mengeruhkannya dan di dalamnya tiada hewan menggelompar."
 },
 {
   "id": 21267,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 14,
   "firman": "Maka airnya akan Kujernihkan, sungai-sungainya akan Kubuat mengalir seperti minyak, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21268,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 15,
   "firman": "Pada saat Mesir Kujadikan sunyi sepi, juga habis dilenyapkan segala isi negeri dan semua penduduknya habis Kumusnahkan, mereka akan tahu bahwa Akulah TUHAN."
 },
 {
   "id": 21269,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 16,
   "firman": "Inilah ratapan yang seharusnya dinyanyikan; kaum perempuan bangsa-bangsa akan menyanyikannya; mereka akan menyanyikannya atas Mesir dan atas seluruh rakyatnya yang banyak, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21270,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 17,
   "firman": "Pada tahun kedua belas, dalam bulan pertama, pada tanggal lima belas bulan itu, datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21271,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 18,
   "firman": "\"Hai anak manusia, perdengarkanlah suatu ratapan--engkau bersama kaum perempuan bangsa-bangsa yang hebat--mengenai khalayak ramai di Mesir dan turunkanlah mereka ke bumi yang paling bawah menjumpai mereka yang telah turun ke liang kubur."
 },
 {
   "id": 21272,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 19,
   "firman": "Dari siapakah engkau lebih cantik? Turunlah dan berbaringlah bersama orang-orang yang tidak bersunat!"
 },
 {
   "id": 21273,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 20,
   "firman": "Mereka akan rebah di tengah orang-orang yang mati terbunuh oleh pedang dan seluruh rakyatnya yang banyak akan telentang bersama dia."
 },
 {
   "id": 21274,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 21,
   "firman": "Orang-orang berkuasa yang gagah perkasa beserta pembantu-pembantunya akan berbicara mengenai dia dari tengah dunia orang mati: Mereka telah turun dan telentang, orang-orang yang tidak bersunat itu, yang mati terbunuh oleh pedang."
 },
 {
   "id": 21275,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 22,
   "firman": "Di situ Asyur dengan semua sekutunya, sekelilingnya terdapat kuburnya; mereka semuanya mati terbunuh, rebah oleh pedang."
 },
 {
   "id": 21276,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 23,
   "firman": "Kuburnya ditentukan pada bagian yang terdalam dari liang dan kumpulan pengikutnya terdapat sekeliling kuburnya; mereka semuanya mati terbunuh, rebah oleh pedang, yaitu yang menimbulkan ketakutan di dunia orang-orang hidup."
 },
 {
   "id": 21277,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 24,
   "firman": "Di situ Elam dan sekeliling kuburnya seluruh rakyatnya yang banyak; mereka semuanya mati terbunuh, rebah oleh pedang, yaitu yang tanpa disunat turun ke bumi yang paling bawah, yang dari pihaknya menimbulkan ketakutan di dunia orang-orang hidup. Mereka menanggung nodanya bersama orang-orang yang turun ke liang kubur."
 },
 {
   "id": 21278,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 25,
   "firman": "Di tengah orang-orang yang mati terbunuh disediakan tempat tidur baginya dengan seluruh rakyatnya yang banyak sekeliling kuburnya; mereka semuanya orang-orang yang tidak disunat, mati terbunuh oleh pedang. Oleh sebab ketakutan terhadap mereka sudah ditimbulkan di dunia orang-orang hidup, dan mereka menanggung nodanya bersama orang-orang yang turun ke liang kubur; mereka ditempatkan di tengah orang-orang yang mati terbunuh."
 },
 {
   "id": 21279,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 26,
   "firman": "Di situ Mesekh dan Tubal dengan seluruh rakyatnya yang banyak sekeliling kuburnya; mereka semuanya orang-orang yang tidak disunat, mati terbunuh oleh pedang, sebab mereka menimbulkan ketakutan di dunia orang-orang hidup."
 },
 {
   "id": 21280,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 27,
   "firman": "Mereka tidak dibaringkan bersama pahlawan-pahlawan yang mati rebah pada zaman dahulu, yang turun ke dunia orang mati bersama segala senjata perangnya dan yang pedang-pedangnya ditaruh orang di bawah kepalanya serta perisai-perisainya terletak di atas tulang-tulangnya; sebab ketakutan terhadap pahlawan-pahlawan itu meliputi dunia orang-orang hidup."
 },
 {
   "id": 21281,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 28,
   "firman": "Engkau akan telentang di tengah orang-orang yang tidak bersunat bersama orang-orang yang mati terbunuh oleh pedang."
 },
 {
   "id": 21282,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 29,
   "firman": "Di situ Edom, raja-rajanya dan semua pemimpinnya, yang ditempatkan dekat orang-orang yang mati terbunuh oleh pedang, walaupun mereka kuat; mereka dibaringkan dekat orang-orang yang tidak disunat dan dekat orang-orang yang turun ke liang kubur."
 },
 {
   "id": 21283,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 30,
   "firman": "Di situ pemimpin-pemimpin dari utara, semuanya mereka, dan semua orang Sidon, yang dengan malu turun dekat orang-orang yang mati terbunuh, walaupun dengan kekuatannya mereka sudah menimbulkan ketakutan terhadap mereka; mereka dibaringkan tanpa disunat dekat orang-orang yang mati terbunuh oleh pedang dan mereka menanggung nodanya bersama orang-orang yang turun ke liang kubur."
 },
 {
   "id": 21284,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 31,
   "firman": "Firaun akan melihat mereka semuanya dan ia akan merasa terhibur dengan nasib khalayak ramai yang mengikutinya. Firaun mati terbunuh oleh pedang dengan seluruh tentaranya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21285,
   "kitab": "Yeh",
   "pasal": 32,
   "ayat": 32,
   "firman": "Oleh karena ia menimbulkan ketakutan di dunia orang-orang hidup, maka ia dibaringkan di tengah orang-orang yang tidak disunat, dekat orang yang mati terbunuh oleh pedang. Firaun dengan seluruh khalayak ramai yang mengikutinya, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21286,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 1,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21287,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 2,
   "firman": "\"Hai anak manusia, berbicaralah kepada teman-temanmu sebangsa dan katakanlah kepada mereka: Kalau Aku mendatangkan pedang atas sesuatu negeri dan bangsa negeri itu mengambil seorang dari antara mereka dan menetapkan dia menjadi penjaganya"
 },
 {
   "id": 21288,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 3,
   "firman": "dan penjaga ini melihat pedang itu datang atas negerinya, lalu meniup sangkakala untuk memperingatkan bangsanya,"
 },
 {
   "id": 21289,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 4,
   "firman": "kalau ada seorang yang memang mendengar suara sangkakala itu, tetapi ia tidak mau diperingatkan, sehingga sesudah pedang itu datang ia dihabiskan, darahnya tertimpa kepadanya sendiri."
 },
 {
   "id": 21290,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 5,
   "firman": "Ia mendengar suara sangkakala, tetapi ia tidak mau diperingatkan, darahnya tertimpa kepadanya sendiri. Kalau ia mau diperingatkan, ia menyelamatkan nyawanya."
 },
 {
   "id": 21291,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 6,
   "firman": "Sebaliknya penjaga, yang melihat pedang itu datang, tetapi tidak meniup sangkakala dan bangsanya tidak mendapat peringatan, sehingga sesudah pedang itu datang, seorang dari antara mereka dihabiskan, orang itu dihabiskan dalam kesalahannya, tetapi Aku akan menuntut pertanggungan jawab atas nyawanya dari penjaga itu."
 },
 {
   "id": 21292,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 7,
   "firman": "Dan engkau anak manusia, Aku menetapkan engkau menjadi penjaga bagi kaum Israel. Bilamana engkau mendengar sesuatu firman dari pada-Ku, peringatkanlah mereka demi nama-Ku."
 },
 {
   "id": 21293,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 8,
   "firman": "Kalau Aku berfirman kepada orang jahat: Hai orang jahat, engkau pasti mati! --dan engkau tidak berkata apa-apa untuk memperingatkan orang jahat itu supaya bertobat dari hidupnya, orang jahat itu akan mati dalam kesalahannya, tetapi Aku akan menuntut pertanggungan jawab atas nyawanya dari padamu."
 },
 {
   "id": 21294,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 9,
   "firman": "Tetapi jikalau engkau memperingatkan orang jahat itu supaya ia bertobat dari hidupnya, tetapi ia tidak mau bertobat, ia akan mati dalam kesalahannya, tetapi engkau telah menyelamatkan nyawamu."
 },
 {
   "id": 21295,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 10,
   "firman": "Dan engkau anak manusia, katakanlah kepada kaum Israel: Kamu berkata begini: Pelanggaran kami dan dosa kami sudah tertanggung atas kami dan karena itu kami hancur; bagaimanakah kami dapat tetap hidup?"
 },
 {
   "id": 21296,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 11,
   "firman": "Katakanlah kepada mereka: Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, Aku tidak berkenan kepada kematian orang fasik, melainkan Aku berkenan kepada pertobatan orang fasik itu dari kelakuannya supaya ia hidup. Bertobatlah, bertobatlah dari hidupmu yang jahat itu! Mengapakah kamu akan mati, hai kaum Israel?"
 },
 {
   "id": 21297,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 12,
   "firman": "Dan engkau anak manusia, katakanlah kepada teman-temanmu sebangsa: Kebenaran orang benar tidak menyelamatkan dia, pada waktu ia jatuh dalam pelanggaran dan kejahatan orang jahat tidak menyebabkan dia tersandung, pada waktu ia bertobat dari kejahatannya; dan orang benar tidak dapat hidup karena kebenarannya, pada waktu ia berbuat dosa."
 },
 {
   "id": 21298,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 13,
   "firman": "Kalau Aku berfirman kepada orang benar: Engkau pasti hidup! --tetapi ia mengandalkan kebenarannya dan ia berbuat curang, segala perbuatan-perbuatan kebenarannya tidak akan diperhitungkan, dan ia harus mati dalam kecurangan yang diperbuatnya."
 },
 {
   "id": 21299,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 14,
   "firman": "Kalau Aku berfirman kepada orang jahat: Engkau pasti mati! --tetapi ia bertobat dari dosanya serta melakukan keadilan dan kebenaran,"
 },
 {
   "id": 21300,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 15,
   "firman": "orang jahat itu mengembalikan gadaian orang, ia membayar ganti rampasannya, menuruti peraturan-peraturan yang memberi hidup, sehingga tidak berbuat curang lagi, ia pasti hidup, ia tidak akan mati."
 },
 {
   "id": 21301,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 16,
   "firman": "Semua dosa yang diperbuatnya tidak akan diingat-ingat lagi; ia sudah melakukan keadilan dan kebenaran, maka ia pasti hidup."
 },
 {
   "id": 21302,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 17,
   "firman": "Tetapi teman-temanmu sebangsa berkata: Tindakan Tuhan tidak tepat! Padahal tindakan mereka yang tidak tepat."
 },
 {
   "id": 21303,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 18,
   "firman": "Jikalau orang benar berbalik dari kebenarannya dan melakukan kecurangan, ia harus mati karena itu."
 },
 {
   "id": 21304,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 19,
   "firman": "Sebaliknya, kalau orang fasik bertobat dari kefasikannya dan ia melakukan keadilan dan kebenaran, ia pasti hidup karena itu."
 },
 {
   "id": 21305,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 20,
   "firman": "Tetapi kamu berkata: Tindakan Tuhan tidak tepat! Aku akan menghakimi kamu, masing-masing menurut kelakuannya, hai kaum Israel.\""
 },
 {
   "id": 21306,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 21,
   "firman": "Pada tahun kesebelas sesudah pembuangan kami, dalam bulan yang kesepuluh, pada tanggal lima bulan itu, datanglah kepadaku seorang yang terluput dari Yerusalem dan berkata: \"Kota itu sudah ditaklukkan!\""
 },
 {
   "id": 21307,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 22,
   "firman": "Maka kekuasaan TUHAN meliputi aku pada malam sebelum kedatangan orang yang terluput itu dan TUHAN membuka mulutku pada saat menjelang kedatangan orang yang terluput itu pada pagi hari. Mulutku sudah terbuka dan aku tidak bisu lagi."
 },
 {
   "id": 21308,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 23,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21309,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 24,
   "firman": "\"Hai anak manusia, orang-orang yang tinggal pada reruntuhan-reruntuhan ini, yaitu yang di tanah Israel, berkata begini: Abraham adalah seorang diri, tatkala ia mendapat tanah ini menjadi miliknya, tetapi kita banyak, tentu tanah ini diberikan kepada kita menjadi milik."
 },
 {
   "id": 21310,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 25,
   "firman": "Oleh karena itu katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Kamu makan daging dengan darahnya, kamu melihat juga kepada berhala-berhalamu dan kamu menumpahkan darah--apakah kamu akan tetap memiliki tanah ini?"
 },
 {
   "id": 21311,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 26,
   "firman": "Kamu bersandar pada pedangmu, kamu melakukan kekejian dan masing-masing mencemari isteri sesamanya--apakah kamu akan tetap memiliki tanah ini?"
 },
 {
   "id": 21312,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 27,
   "firman": "Katakanlah begini kepada mereka: Beginilah firman Tuhan ALLAH. Demi Aku yang hidup, orang-orang yang tinggal pada reruntuhan-reruntuhan akan mati rebah oleh pedang, dan orang-orang yang di padang akan Kuberikan kepada binatang liar menjadi makanannya dan orang-orang yang di dalam kubu dan gua akan mati kena sampar."
 },
 {
   "id": 21313,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 28,
   "firman": "Tanah ini akan Kubuat musnah dan sunyi sepi, dan kecongkakannya, yang ditimbulkan kekuatannya, akan berakhir; gunung-gunung Israel akan menjadi sunyi sepi, sehingga tidak seorangpun berani melintasinya."
 },
 {
   "id": 21314,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 29,
   "firman": "Dan mereka akan mengetahui bahwa Akulah TUHAN, pada saat Aku membuat tanah ini musnah dan sunyi sepi, oleh karena semua perbuatan-perbuatan mereka yang keji, yang mereka lakukan."
 },
 {
   "id": 21315,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 30,
   "firman": "Dan engkau anak manusia, teman-temanmu sebangsa bercakap-cakap mengenai engkau dekat tembok-tembok dan di pintu rumah-rumah dan berkata satu sama lain, masing-masing kepada temannya. Silakan datang dan dengar, apa yang difirmankan oleh TUHAN!"
 },
 {
   "id": 21316,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 31,
   "firman": "Dan mereka datang kepadamu seperti rakyat berkerumun dan duduk di hadapanmu sebagai umat-Ku, mereka mendengar apa yang kauucapkan, tetapi mereka tidak melakukannya; mulutnya penuh dengan kata-kata cinta kasih, tetapi hati mereka mengejar keuntungan yang haram."
 },
 {
   "id": 21317,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 32,
   "firman": "Sungguh, engkau bagi mereka seperti seorang yang melagukan syair cinta kasih dengan suara yang merdu, dan yang pandai main kecapi; mereka mendengar apa yang kauucapkan, tetapi mereka sama sekali tidak melakukannya."
 },
 {
   "id": 21318,
   "kitab": "Yeh",
   "pasal": 33,
   "ayat": 33,
   "firman": "Kalau hal itu datang--dan sungguh akan datang! --mereka akan mengetahui bahwa seorang nabi ada di tengah-tengah mereka.\""
 },
 {
   "id": 21319,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 1,
   "firman": "Lalu datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21320,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 2,
   "firman": "\"Hai anak manusia, bernubuatlah melawan gembala-gembala Israel, bernubuatlah dan katakanlah kepada mereka, kepada gembala-gembala itu: Beginilah firman Tuhan ALLAH: Celakalah gembala-gembala Israel, yang menggembalakan dirinya sendiri! Bukankah domba-domba yang seharusnya digembalakan oleh gembala-gembala itu?"
 },
 {
   "id": 21321,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 3,
   "firman": "Kamu menikmati susunya, dari bulunya kamu buat pakaian, yang gemuk kamu sembelih, tetapi domba-domba itu sendiri tidak kamu gembalakan."
 },
 {
   "id": 21322,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 4,
   "firman": "Yang lemah tidak kamu kuatkan, yang sakit tidak kamu obati, yang luka tidak kamu balut, yang tersesat tidak kamu bawa pulang, yang hilang tidak kamu cari, melainkan kamu injak-injak mereka dengan kekerasan dan kekejaman."
 },
 {
   "id": 21323,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 5,
   "firman": "Dengan demikian mereka berserak, oleh karena gembala tidak ada, dan mereka menjadi makanan bagi segala binatang di hutan. Domba-domba-Ku berserak"
 },
 {
   "id": 21324,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 6,
   "firman": "dan tersesat di semua gunung dan di semua bukit yang tinggi; ya, di seluruh tanah itu domba-domba-Ku berserak, tanpa seorangpun yang memperhatikan atau yang mencarinya."
 },
 {
   "id": 21325,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 7,
   "firman": "Oleh sebab itu, hai gembala-gembala, dengarlah firman TUHAN:"
 },
 {
   "id": 21326,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 8,
   "firman": "Demi Aku yang hidup, demikianlah firman Tuhan ALLAH, sesungguhnya oleh karena domba-domba-Ku menjadi mangsa dan menjadi makanan bagi segala binatang di hutan, lantaran yang menggembalakannya tidak ada, oleh sebab gembala-gembala-Ku tidak memperhatikan domba-domba-Ku, melainkan mereka itu menggembalakan dirinya sendiri, tetapi domba-domba-Ku tidak digembalakannya--"
 },
 {
   "id": 21327,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 9,
   "firman": "oleh karena itu, hai gembala-gembala, dengarlah firman TUHAN:"
 },
 {
   "id": 21328,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 10,
   "firman": "Beginilah firman Tuhan ALLAH: Aku sendiri akan menjadi lawan gembala-gembala itu dan Aku akan menuntut kembali domba-domba-Ku dari mereka dan akan memberhentikan mereka menggembalakan domba-domba-Ku. Gembala-gembala itu tidak akan terus lagi menggembalakan dirinya sendiri; Aku akan melepaskan domba-domba-Ku dari mulut mereka, sehingga tidak terus lagi menjadi makanannya."
 },
 {
   "id": 21329,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 11,
   "firman": "Sebab beginilah firman Tuhan ALLAH: Dengan sesungguhnya Aku sendiri akan memperhatikan domba-domba-Ku dan akan mencarinya."
 },
 {
   "id": 21330,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 12,
   "firman": "Seperti seorang gembala mencari dombanya pada waktu domba itu tercerai dari kawanan dombanya, begitulah Aku akan mencari domba-domba-Ku dan Aku akan menyelamatkan mereka dari segala tempat, ke mana mereka diserahkan pada hari berkabut dan hari kegelapan."
 },
 {
   "id": 21331,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 13,
   "firman": "Aku akan membawa mereka keluar dari tengah bangsa-bangsa dan mengumpulkan mereka dari negeri-negeri dan membawa mereka ke tanahnya; Aku akan menggembalakan mereka di atas gunung-gunung Israel, di alur-alur sungainya dan di semua tempat kediaman orang di tanah itu."
 },
 {
   "id": 21332,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 14,
   "firman": "Di padang rumput yang baik akan Kugembalakan mereka dan di atas gunung-gunung Israel yang tinggi di situlah tempat penggembalaannya; di sana di tempat penggembalaan yang baik mereka akan berbaring dan rumput yang subur menjadi makanannya di atas gunung-gunung Israel."
 },
 {
   "id": 21333,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 15,
   "firman": "Aku sendiri akan menggembalakan domba-domba-Ku dan Aku akan membiarkan mereka berbaring, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21334,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 16,
   "firman": "Yang hilang akan Kucari, yang tersesat akan Kubawa pulang, yang luka akan Kubalut, yang sakit akan Kukuatkan, serta yang gemuk dan yang kuat akan Kulindungi; Aku akan menggembalakan mereka sebagaimana seharusnya."
 },
 {
   "id": 21335,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 17,
   "firman": "Dan hai kamu domba-domba-Ku, beginilah firman Tuhan ALLAH: Sungguh, Aku akan menjadi hakim di antara domba dengan domba, dan di antara domba jantan dan kambing jantan."
 },
 {
   "id": 21336,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 18,
   "firman": "Apakah belum cukup bagimu bahwa kamu menghabiskan padang rumput yang terbaik? Mesti pulakah kamu injak-injak padang rumput yang lain-lain dengan kakimu? Belum cukup bahwa kamu minum air yang jernih? Mesti pulakah yang tinggal itu kamu keruhkan dengan kakimu?"
 },
 {
   "id": 21337,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 19,
   "firman": "Apakah domba-domba-Ku seharusnya memakan rumput yang sudah diinjak-injak kakimu dan meminum air yang sudah dikeruhkan kakimu?"
 },
 {
   "id": 21338,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 20,
   "firman": "Oleh sebab itu, beginilah firman Tuhan ALLAH terhadap mereka. Dengan sesungguhnya Aku sendiri akan menjadi hakim di antara domba yang gemuk dengan domba yang kurus;"
 },
 {
   "id": 21339,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 21,
   "firman": "oleh karena semua yang lemah kamu desak dengan lambungmu dan bahumu serta kamu tanduk dengan tandukmu, sehingga kamu menghalau mereka ke luar kandang,"
 },
 {
   "id": 21340,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 22,
   "firman": "maka Aku akan menolong domba-domba-Ku, supaya mereka jangan lagi menjadi mangsa dan Aku akan menjadi hakim di antara domba dengan domba."
 },
 {
   "id": 21341,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 23,
   "firman": "Aku akan mengangkat satu orang gembala atas mereka, yang akan menggembalakannya, yaitu Daud, hamba-Ku; dia akan menggembalakan mereka, dan menjadi gembalanya."
 },
 {
   "id": 21342,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 24,
   "firman": "Dan Aku, TUHAN, akan menjadi Allah mereka serta hamba-Ku Daud menjadi raja di tengah-tengah mereka. Aku, TUHAN, yang mengatakannya."
 },
 {
   "id": 21343,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 25,
   "firman": "Aku akan mengadakan perjanjian damai dengan mereka dan Aku akan meniadakan binatang buas dari tanah itu, sehingga mereka dapat diam di padang gurun dengan aman tenteram dan dapat tidur di hutan-hutan."
 },
 {
   "id": 21344,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 26,
   "firman": "Aku akan menjadikan mereka dan semua yang di sekitar gunung-Ku menjadi berkat; Aku akan menurunkan hujan pada waktunya; itu adalah hujan yang membawa berkat."
 },
 {
   "id": 21345,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 27,
   "firman": "Pohon-pohon di ladang akan memberi buahnya dan tanah itu akan memberi hasilnya. Mereka akan hidup aman tenteram di tanahnya. Mereka akan mengetahui, bahwa Akulah TUHAN, pada saat Aku mematahkan kayu kuk mereka dan melepaskan mereka dari tangan orang yang memperbudak mereka."
 },
 {
   "id": 21346,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 28,
   "firman": "Mereka tidak lagi menjadi jarahan bagi bangsa-bangsa dan binatang liar tidak akan menerkam mereka, sehingga mereka akan diam dengan aman tenteram dengan tidak dikejutkan oleh apapun."
 },
 {
   "id": 21347,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 29,
   "firman": "Aku akan mendirikan bagi mereka suatu taman kebahagiaan, sehingga di tanah itu tidak seorangpun akan mati kelaparan dan mereka tidak lagi menanggung noda yang ditimbulkan bangsa-bangsa."
 },
 {
   "id": 21348,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 30,
   "firman": "Dan mereka akan mengetahui bahwa Aku, TUHAN, Allah mereka, menyertai mereka dan mereka, kaum Israel, adalah umat-Ku, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21349,
   "kitab": "Yeh",
   "pasal": 34,
   "ayat": 31,
   "firman": "Kamu adalah domba-domba-Ku, domba gembalaan-Ku, dan Aku adalah Allahmu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21350,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21351,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu kepada pegunungan Seir, bernubuatlah melawan dia"
 },
 {
   "id": 21352,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 3,
   "firman": "dan katakanlah kepadanya: Beginilah firman Tuhan ALLAH: Aku akan menjadi lawanmu, hai pegunungan Seir dan Aku akan mengacungkan tangan-Ku melawanmu dan akan menjadikan engkau musnah dan sunyi sepi."
 },
 {
   "id": 21353,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 4,
   "firman": "Aku akan menjadikan kota-kotamu reruntuhan dan engkau menjadi sunyi sepi, dan engkau akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21354,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 5,
   "firman": "Oleh karena dalam hatimu terpendam rasa permusuhan yang turun-temurun dan engkau membiarkan orang Israel menjadi makanan pedang pada hari sial mereka, waktu saatnya tiba untuk penghakiman terakhir,"
 },
 {
   "id": 21355,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 6,
   "firman": "oleh sebab itu, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, Aku akan menjadikan engkau darah dan darah akan mengejar engkau; oleh sebab engkau bersalah karena mencurahkan darah, maka darah akan mengejar engkau."
 },
 {
   "id": 21356,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 7,
   "firman": "Aku akan menjadikan pegunungan Seir musnah dan sunyi sepi dan melenyapkan dari padanya orang-orang yang lalu lalang."
 },
 {
   "id": 21357,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 8,
   "firman": "Aku akan memenuhi juga pegunungannya dengan orang-orang yang mati terbunuh. Di bukit-bukitmu, di lembah-lembahmu dan alur-alur sungaimu akan berebahan orang-orang yang mati terbunuh oleh pedang."
 },
 {
   "id": 21358,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 9,
   "firman": "Aku akan menjadikan engkau sunyi sepi untuk selama-lamanya dan kota-kotamu tidak akan didiami lagi. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21359,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 10,
   "firman": "Oleh sebab engkau mengatakan: Kedua bangsa itu dan kedua negeri itu akan menjadi milikku dan kita akan memilikinya--sebetulnya TUHAN ada di situ--"
 },
 {
   "id": 21360,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 11,
   "firman": "oleh sebab itu, demi Aku yang hidup, demikianlah firman Tuhan ALLAH, Aku akan memperlakukan engkau seperti engkau memperlakukan mereka dalam murkamu dan cemburumu, yang timbul dari kebencianmu terhadap mereka; dan Aku akan menyatakan diri kepadamu pada saat Aku menghakimi engkau."
 },
 {
   "id": 21361,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 12,
   "firman": "Dan engkau akan mengetahui bahwa Aku, TUHAN, mendengar segala penistaanmu yang kauucapkan melawan gunung-gunung Israel yang demikian: Gunung-gunung itu sudah menjadi sunyi sepi dan diserahkan kepada kita menjadi makanan kita."
 },
 {
   "id": 21362,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 13,
   "firman": "Dengan demikian kamu membesarkan dirimu terhadap Aku di dalam ucapanmu dan banyak sekali kata-katamu terhadap Aku. Aku mendengarnya."
 },
 {
   "id": 21363,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 14,
   "firman": "Beginilah firman Tuhan ALLAH: Seluruh bumi akan bersukacita pada saat Aku menjadikan engkau sunyi sepi."
 },
 {
   "id": 21364,
   "kitab": "Yeh",
   "pasal": 35,
   "ayat": 15,
   "firman": "Seperti engkau bersukacita mengenai milik pusaka kaum Israel, yang sudah menjadi sunyi sepi, demikianlah akan Kulakukan terhadap engkau. Engkau akan menjadi sunyi sepi, hai pegunungan Seir dan engkau, segenap Edom dalam keseluruhanmu. Dan mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21365,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 1,
   "firman": "\"Hai engkau, anak manusia, bernubuatlah mengenai gunung-gunung Israel dan katakanlah: Hai gunung-gunung Israel, dengarlah firman TUHAN!"
 },
 {
   "id": 21366,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 2,
   "firman": "Beginilah firman Tuhan ALLAH: Oleh karena musuh itu berkata mengenai kamu: Syukur! Bukit-bukit dari dahulu kala sudah menjadi milik kita."
 },
 {
   "id": 21367,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 3,
   "firman": "Oleh karena itu bernubuatlah dan katakan: Beginilah firman Tuhan ALLAH: Oleh karena, ya sungguh karena musuh dari sekitarmu menjadikan kamu sunyi sepi dan mengingini kamu, supaya kamu menjadi milik sisa bangsa-bangsa, dan oleh karena kamu menjadi buah mulut orang dan banyak dipergunjingkan,"
 },
 {
   "id": 21368,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 4,
   "firman": "oleh karena itu, hai gunung-gunung Israel, dengarlah firman Tuhan ALLAH kepada gunung-gunung dan bukit-bukit, kepada alur-alur sungai dan lembah-lembah, kepada reruntuhan-reruntuhan yang sunyi sepi dan kepada kota-kota yang sudah ditinggalkan, yang sudah menjadi jarahan dan olok-olokan bagi sisa bangsa-bangsa yang di sekitarnya;"
 },
 {
   "id": 21369,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 5,
   "firman": "oleh karena itu beginilah firman Tuhan ALLAH: Aku pasti berfirman dalam api cemburuan-Ku melawan sisa bangsa-bangsa dan melawan seluruh Edom, yang menentukan tanah-Ku menjadi miliknya dengan segala rasa sukacita dan rasa penghinaan, sehingga tanah-Ku itu dimilikinya dan dapat habis dijarah."
 },
 {
   "id": 21370,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 6,
   "firman": "Oleh karena itu bernubuatlah mengenai tanah Israel dan katakanlah kepada gunung-gunung dan bukit-bukit, kepada alur-alur sungai dan lembah-lembah: Beginilah firman Tuhan ALLAH: Sungguh, Aku berfirman dalam amarah cemburuan-Ku, oleh karena kamu sudah menanggung noda yang ditimbulkan bangsa-bangsa."
 },
 {
   "id": 21371,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 7,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Aku bersumpah bahwa bangsa-bangsa yang di sekitarmu sendiri pasti akan menanggung noda mereka."
 },
 {
   "id": 21372,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 8,
   "firman": "Maka kamu, gunung-gunung Israel, akan bertunas kembali dan akan memberi buah untuk umat-Ku Israel, sebab mereka akan segera kembali."
 },
 {
   "id": 21373,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 9,
   "firman": "Hati-Ku akan baik kembali dan Aku akan berpaling kepadamu dan kamu akan dikerjakan dan ditaburi."
 },
 {
   "id": 21374,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 10,
   "firman": "Aku akan membuat manusia banyak di atasmu, yaitu segenap kaum Israel dalam keseluruhannya; kota-kota akan didiami lagi dan reruntuhan-reruntuhan akan dibangun kembali."
 },
 {
   "id": 21375,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 11,
   "firman": "Aku akan membuat manusia dan binatang banyak di atasmu, dan mereka akan bertambah banyak dan beranak cucu dan Aku akan membuat kamu didiami kembali seperti keadaan semula dan akan berbuat baik kepadamu lebih dari pada keadaan dahulu. Dan kamu akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21376,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 12,
   "firman": "Aku akan membuat manusia lalu-lalang di atasmu yaitu umat-Ku Israel; mereka akan menduduki engkau dan engkau akan menjadi milik pusaka mereka dan engkau tidak lagi terus memunahkan mereka."
 },
 {
   "id": 21377,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 13,
   "firman": "Beginilah firman Tuhan ALLAH: Oleh karena orang berkata tentangmu: Engkau memakan orang dan engkau memunahkan bangsamu--"
 },
 {
   "id": 21378,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 14,
   "firman": "oleh karena itu engkau tidak akan makan orang lagi dan tidak akan memunahkan bangsamu lagi, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21379,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 15,
   "firman": "Aku tidak lagi membiarkan orang membicarakan noda yang ditimbulkan bangsa-bangsa terhadap engkau dan engkau tidak lagi menanggung pencelaan bangsa-bangsa dan tidak lagi memunahkan bangsamu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21380,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 16,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21381,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 17,
   "firman": "\"Hai anak manusia, waktu kaum Israel tinggal di tanah mereka, mereka menajiskannya dengan tingkah laku mereka; kelakuan mereka sama seperti cemar kain di hadapan-Ku."
 },
 {
   "id": 21382,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 18,
   "firman": "Maka Aku mencurahkan amarah-Ku ke atas mereka karena darah yang dicurahkan mereka di tanah itu, sedang tanah itu mereka najiskan dengan berhala-berhala mereka."
 },
 {
   "id": 21383,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 19,
   "firman": "Aku menghamburkan mereka di antara bangsa-bangsa, sehingga mereka berserak-serak di semua negeri, Aku menghakimi mereka selaras dengan tingkah lakunya."
 },
 {
   "id": 21384,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 20,
   "firman": "Di mana saja mereka datang di tengah bangsa-bangsa, mereka menajiskan nama-Ku yang kudus, dalam hal orang menyindir mereka: Katanya mereka umat TUHAN, tetapi mereka harus keluar dari tanah-Nya."
 },
 {
   "id": 21385,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 21,
   "firman": "Aku merasa sakit hati karena nama-Ku yang kudus yang dinajiskan oleh kaum Israel di tengah bangsa-bangsa, di mana mereka datang."
 },
 {
   "id": 21386,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 22,
   "firman": "Oleh karena itu katakanlah kepada kaum Israel: Beginilah firman Tuhan ALLAH: Bukan karena kamu Aku bertindak, hai kaum Israel, tetapi karena nama-Ku yang kudus yang kamu najiskan di tengah bangsa-bangsa di mana kamu datang."
 },
 {
   "id": 21387,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 23,
   "firman": "Aku akan menguduskan nama-Ku yang besar yang sudah dinajiskan di tengah bangsa-bangsa, dan yang kamu najiskan di tengah-tengah mereka. Dan bangsa-bangsa akan mengetahui bahwa Akulah TUHAN, demikianlah firman Tuhan ALLAH, manakala Aku menunjukkan kekudusan-Ku kepadamu di hadapan bangsa-bangsa."
 },
 {
   "id": 21388,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 24,
   "firman": "Aku akan menjemput kamu dari antara bangsa-bangsa dan mengumpulkan kamu dari semua negeri dan akan membawa kamu kembali ke tanahmu."
 },
 {
   "id": 21389,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 25,
   "firman": "Aku akan mencurahkan kepadamu air jernih, yang akan mentahirkan kamu; dari segala kenajisanmu dan dari semua berhala-berhalamu Aku akan mentahirkan kamu."
 },
 {
   "id": 21390,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 26,
   "firman": "Kamu akan Kuberikan hati yang baru, dan roh yang baru di dalam batinmu dan Aku akan menjauhkan dari tubuhmu hati yang keras dan Kuberikan kepadamu hati yang taat."
 },
 {
   "id": 21391,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 27,
   "firman": "Roh-Ku akan Kuberikan diam di dalam batinmu dan Aku akan membuat kamu hidup menurut segala ketetapan-Ku dan tetap berpegang pada peraturan-peraturan-Ku dan melakukannya."
 },
 {
   "id": 21392,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 28,
   "firman": "Dan kamu akan diam di dalam negeri yang telah Kuberikan kepada nenek moyangmu dan kamu akan menjadi umat-Ku dan Aku akan menjadi Allahmu."
 },
 {
   "id": 21393,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 29,
   "firman": "Aku akan melepaskan kamu dari segala dosa kenajisanmu dan Aku akan menumbuhkan gandum serta memperbanyaknya, dan Aku tidak lagi mendatangkan kelaparan atasmu."
 },
 {
   "id": 21394,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 30,
   "firman": "Aku juga memperbanyak buah pohon-pohonanmu dan hasil ladangmu, supaya kamu jangan lagi menanggung noda kelaparan di tengah bangsa-bangsa."
 },
 {
   "id": 21395,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 31,
   "firman": "Dan kamu akan teringat-ingat kepada kelakuanmu yang jahat dan perbuatan-perbuatanmu yang tidak baik dan kamu akan merasa mual melihat dirimu sendiri karena kesalahan-kesalahanmu dan perbuatan-perbuatanmu yang keji."
 },
 {
   "id": 21396,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 32,
   "firman": "Bukan karena kamu Aku bertindak, demikianlah firman Tuhan ALLAH, ketahuilah itu. Merasa malulah kamu dan biarlah kamu dipermalukan karena kelakuanmu, hai kaum Israel."
 },
 {
   "id": 21397,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 33,
   "firman": "Beginilah firman Tuhan ALLAH: Pada hari Aku mentahirkan kamu dari segala kesalahanmu, Aku akan membuat kota-kota didiami lagi dan reruntuhan-reruntuhan akan dibangun kembali."
 },
 {
   "id": 21398,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 34,
   "firman": "Tanah yang sudah lama tinggal tandus akan dikerjakan kembali, supaya jangan lagi tetap tandus di hadapan semua orang yang lintas dari padamu."
 },
 {
   "id": 21399,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 35,
   "firman": "Sebaliknya mereka akan berkata: Tanah ini yang sudah lama tinggal tandus menjadi seperti taman Eden dan kota-kota yang sudah runtuh, sunyi sepi dan musnah, sekarang didiami dan menjadi kubu."
 },
 {
   "id": 21400,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 36,
   "firman": "Dan bangsa-bangsa yang tertinggal, yang ada di sekitarmu akan mengetahui, bahwa Akulah TUHAN, yang membangun kembali yang sudah musnah dan menanami kembali yang sudah tandus. Aku, TUHAN, yang mengatakannya dan akan membuatnya."
 },
 {
   "id": 21401,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 37,
   "firman": "Beginilah firman Tuhan ALLAH: Dalam hal ini juga Aku menginginkan, supaya kaum Israel meminta dari pada-Ku apa yang hendak Kulakukan bagi mereka, yaitu membuat mereka banyak seperti lautan manusia."
 },
 {
   "id": 21402,
   "kitab": "Yeh",
   "pasal": 36,
   "ayat": 38,
   "firman": "Seperti domba-domba persembahan kudus, dan seumpama domba-domba Yerusalem pada waktu-waktu perayaannya, begitulah kota-kota yang sudah runtuh penuh dengan lautan manusia. Dengan begitu mereka akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21403,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 1,
   "firman": "Lalu kekuasaan TUHAN meliputi aku dan Ia membawa aku ke luar dengan perantaraan Roh-Nya dan menempatkan aku di tengah-tengah lembah, dan lembah ini penuh dengan tulang-tulang."
 },
 {
   "id": 21404,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 2,
   "firman": "Ia membawa aku melihat tulang-tulang itu berkeliling-keliling dan sungguh, amat banyak bertaburan di lembah itu; lihat, tulang-tulang itu amat kering."
 },
 {
   "id": 21405,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 3,
   "firman": "Lalu Ia berfirman kepadaku: \"Hai anak manusia, dapatkah tulang-tulang ini dihidupkan kembali?\" Aku menjawab: \"Ya Tuhan ALLAH, Engkaulah yang mengetahui!\""
 },
 {
   "id": 21406,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 4,
   "firman": "Lalu firman-Nya kepadaku: \"Bernubuatlah mengenai tulang-tulang ini dan katakanlah kepadanya: Hai tulang-tulang yang kering, dengarlah firman TUHAN!"
 },
 {
   "id": 21407,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 5,
   "firman": "Beginilah firman Tuhan ALLAH kepada tulang-tulang ini: Aku memberi nafas hidup di dalammu, supaya kamu hidup kembali."
 },
 {
   "id": 21408,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 6,
   "firman": "Aku akan memberi urat-urat padamu dan menumbuhkan daging padamu, Aku akan menutupi kamu dengan kulit dan memberikan kamu nafas hidup, supaya kamu hidup kembali. Dan kamu akan mengetahui bahwa Akulah TUHAN.\""
 },
 {
   "id": 21409,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 7,
   "firman": "Lalu aku bernubuat seperti diperintahkan kepadaku; dan segera sesudah aku bernubuat, kedengaranlah suara, sungguh, suatu suara berderak-derak, dan tulang-tulang itu bertemu satu sama lain."
 },
 {
   "id": 21410,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 8,
   "firman": "Sedang aku mengamat-amatinya, lihat, urat-urat ada dan daging tumbuh padanya, kemudian kulit menutupinya, tetapi mereka belum bernafas."
 },
 {
   "id": 21411,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 9,
   "firman": "Maka firman-Nya kepadaku: \"Bernubuatlah kepada nafas hidup itu, bernubuatlah, hai anak manusia, dan katakanlah kepada nafas hidup itu: Beginilah firman Tuhan ALLAH: Hai nafas hidup, datanglah dari keempat penjuru angin, dan berembuslah ke dalam orang-orang yang terbunuh ini, supaya mereka hidup kembali.\""
 },
 {
   "id": 21412,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 10,
   "firman": "Lalu aku bernubuat seperti diperintahkan-Nya kepadaku. Dan nafas hidup itu masuk di dalam mereka, sehingga mereka hidup kembali. Mereka menjejakkan kakinya, suatu tentara yang sangat besar."
 },
 {
   "id": 21413,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 11,
   "firman": "Firman-Nya kepadaku: \"Hai anak manusia, tulang-tulang ini adalah seluruh kaum Israel. Sungguh, mereka sendiri mengatakan: Tulang-tulang kami sudah menjadi kering, dan pengharapan kami sudah lenyap, kami sudah hilang."
 },
 {
   "id": 21414,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 12,
   "firman": "Oleh sebab itu, bernubuatlah dan katakan kepada mereka: Beginilah firman Tuhan ALLAH: Sungguh, Aku membuka kubur-kuburmu dan membangkitkan kamu, hai umat-Ku, dari dalamnya, dan Aku akan membawa kamu ke tanah Israel."
 },
 {
   "id": 21415,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 13,
   "firman": "Dan kamu akan mengetahui bahwa Akulah TUHAN, pada saat Aku membuka kubur-kuburmu dan membangkitkan kamu, hai umat-Ku, dari dalamnya."
 },
 {
   "id": 21416,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 14,
   "firman": "Aku akan memberikan Roh-Ku ke dalammu, sehingga kamu hidup kembali dan Aku akan membiarkan kamu tinggal di tanahmu. Dan kamu akan mengetahui bahwa Aku, TUHAN, yang mengatakannya dan membuatnya, demikianlah firman TUHAN.\""
 },
 {
   "id": 21417,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 15,
   "firman": "Kemudian datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21418,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 16,
   "firman": "\"Hai engkau anak manusia, ambillah sepotong papan dan tulis di atasnya: Untuk Yehuda dan orang-orang Israel yang bersekutu dengan dia. Kemudian ambillah papan yang lain dan tulis di atasnya: Untuk Yusuf--papan Efraim--dan seluruh kaum Israel yang bersekutu dengan dia."
 },
 {
   "id": 21419,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 17,
   "firman": "Gabungkanlah keduanya menjadi satu papan, sehingga keduanya menjadi satu dalam tanganmu."
 },
 {
   "id": 21420,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 18,
   "firman": "Maka kalau teman-teman sebangsamu bertanya kepadamu: Tidakkah engkau bersedia memberitahukan kepada kami, apa artinya ini--"
 },
 {
   "id": 21421,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 19,
   "firman": "katakanlah kepada mereka: Beginilah firman Tuhan ALLAH: Aku mengambil papan Yusuf--yang dalam tangan Efraim--beserta suku-suku Israel yang bersekutu dengan dia dan menggabungkannya dengan papan Yehuda dan Aku akan menjadikan mereka satu papan, sehingga mereka menjadi satu dalam tangan-Ku."
 },
 {
   "id": 21422,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 20,
   "firman": "Dan sedang engkau memegang papan-papan yang kautulisi itu dalam tanganmu di hadapan mereka,"
 },
 {
   "id": 21423,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 21,
   "firman": "katakanlah kepadanya: Beginilah firman Tuhan ALLAH: Sungguh, Aku menjemput orang Israel dari tengah bangsa-bangsa, ke mana mereka pergi; Aku akan mengumpulkan mereka dari segala penjuru dan akan membawa mereka ke tanah mereka."
 },
 {
   "id": 21424,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 22,
   "firman": "Aku akan menjadikan mereka satu bangsa di tanah mereka, di atas gunung-gunung Israel, dan satu raja memerintah mereka seluruhnya; mereka tidak lagi menjadi dua bangsa dan tidak lagi terbagi menjadi dua kerajaan."
 },
 {
   "id": 21425,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 23,
   "firman": "Mereka tidak lagi menajiskan dirinya dengan berhala-berhalanya atau dewa-dewa mereka yang menjijikkan atau dengan semua pelanggaran mereka. Tetapi Aku akan melepaskan mereka dari segala penyelewengan mereka, dengan mana mereka berbuat dosa, dan mentahirkan mereka, sehingga mereka akan menjadi umat-Ku dan Aku akan menjadi Allahnya."
 },
 {
   "id": 21426,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 24,
   "firman": "Maka hamba-Ku Daud akan menjadi rajanya, dan mereka semuanya akan mempunyai satu gembala. Mereka akan hidup menurut peraturan-peraturan-Ku dan melakukan ketetapan-ketetapan-Ku dengan setia."
 },
 {
   "id": 21427,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 25,
   "firman": "Mereka akan tinggal di tanah yang Kuberikan kepada hamba-Ku Yakub, di mana nenek moyang mereka tinggal, ya, mereka, anak-anak mereka maupun cucu cicit mereka akan tinggal di sana untuk selama-lamanya dan hamba-Ku Daud menjadi raja mereka untuk selama-lamanya."
 },
 {
   "id": 21428,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 26,
   "firman": "Aku akan mengadakan perjanjian damai dengan mereka, dan itu akan menjadi perjanjian yang kekal dengan mereka. Aku akan memberkati mereka dan membuat mereka banyak dan memberikan tempat kudus-Ku di tengah-tengah mereka untuk selama-lamanya."
 },
 {
   "id": 21429,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 27,
   "firman": "Tempat kediaman-Kupun akan ada pada mereka dan Aku akan menjadi Allah mereka dan mereka akan menjadi umat-Ku."
 },
 {
   "id": 21430,
   "kitab": "Yeh",
   "pasal": 37,
   "ayat": 28,
   "firman": "Maka bangsa-bangsa akan mengetahui bahwa Aku, TUHAN, menguduskan Israel, pada waktu tempat kudus-Ku berada di tengah-tengah mereka untuk selama-lamanya.\""
 },
 {
   "id": 21431,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepadaku:"
 },
 {
   "id": 21432,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 2,
   "firman": "\"Hai anak manusia, tujukanlah mukamu kepada Gog di tanah Magog, yaitu raja agung negeri Mesekh dan Tubal dan bernubuatlah melawan dia"
 },
 {
   "id": 21433,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 3,
   "firman": "dan katakanlah: Beginilah firman Tuhan ALLAH: Lihat, Aku akan menjadi lawanmu, hai Gog raja agung negeri Mesekh dan Tubal."
 },
 {
   "id": 21434,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 4,
   "firman": "Aku akan menarik engkau dengan mengenakan kelikir pada rahangmu dan membawa engkau ke luar beserta seluruh tentaramu, yaitu pasukan berkuda, semuanya berpakaian lengkap, suatu kumpulan orang banyak dengan perisai besar dan kecil dan semuanya berpedang di tangannya."
 },
 {
   "id": 21435,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 5,
   "firman": "Orang Persia, Etiopia, dan Put menyertai mereka dan semuanya dengan perisai dan ketopong;"
 },
 {
   "id": 21436,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 6,
   "firman": "orang Gomer dengan seluruh bala tentaranya, Bet-Togarma dari utara sekali dengan seluruh bala tentaranya, banyak bangsa menyertai engkau."
 },
 {
   "id": 21437,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 7,
   "firman": "Bersedialah dan bersiaplah engkau dengan semua kumpulan orang yang menggabungkan diri dengan engkau dan jadilah pelindung bagi mereka."
 },
 {
   "id": 21438,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 8,
   "firman": "Sesudah waktu yang lama sekali engkau akan mendapat perintah; pada hari yang terkemudian engkau akan datang di sebuah negeri yang dibangun kembali sesudah musnah karena perang, dan engkau menuju suatu bangsa yang dikumpul dari tengah-tengah banyak bangsa di atas gunung-gunung Israel yang telah lama menjadi reruntuhan. Bangsa ini telah dibawa ke luar dari tengah bangsa-bangsa dan mereka semuanya diam dengan aman tenteram."
 },
 {
   "id": 21439,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 9,
   "firman": "Engkau muncul seperti angin badai dan datang seperti awan yang menutupi seluruh bumi, engkau beserta seluruh bala tentaramu dan banyak bangsa menyertai engkau."
 },
 {
   "id": 21440,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 10,
   "firman": "Beginilah firman Tuhan ALLAH: Pada hari itu timbullah niat dalam hatimu dan engkau membuat rancangan jahat."
 },
 {
   "id": 21441,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 11,
   "firman": "Engkau berkata: Aku akan bangkit bergerak menyerang tanah yang kota-kotanya tanpa tembok dan akan mendatangi orang-orang yang hidup tenang-tenang dan diam dengan aman tenteram; mereka semuanya diam tanpa tembok atau palang atau pintu gerbang."
 },
 {
   "id": 21442,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 12,
   "firman": "Engkau bermaksud untuk merampas dan menjarah dan mengacungkan tanganmu terhadap reruntuhan-reruntuhan yang sudah didiami kembali dan menyerang umat-Ku yang dikumpulkan dari tengah bangsa-bangsa. Mereka sudah mempunyai ternak dan harta benda dan mereka diam di pusat bumi."
 },
 {
   "id": 21443,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 13,
   "firman": "Negeri Syeba dan Dedan beserta pembeli-pembeli barangnya, negeri Tarsis beserta pedagang-pedagangnya akan berkata kepadamu: Apakah engkau datang untuk merampas dan mengumpulkan sekutumu untuk menjarah, untuk mengangkut perak dan emas, untuk melarikan ternak dan harta benda dan untuk melakukan perampasan yang hebat sekali?"
 },
 {
   "id": 21444,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 14,
   "firman": "Sebab itu, bernubuatlah, hai anak manusia dan katakanlah kepada Gog: Beginilah firman Tuhan ALLAH: Ketika umat-Ku Israel sedang diam dengan aman tenteram, pada waktu itulah engkau akan bergerak"
 },
 {
   "id": 21445,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 15,
   "firman": "dan datang dari tempatmu dari utara sekali, engkau dengan banyak bangsa yang menyertai engkau, mereka semuanya mengendarai kuda, suatu kumpulan yang besar dan suatu pasukan yang kuat."
 },
 {
   "id": 21446,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 16,
   "firman": "Engkau bangkit melawan umat-Ku Israel seperti awan yang menutupi seluruh bumi. Pada hari yang terkemudian akan terjadi hal itu dan Aku akan membawa engkau untuk melawan tanah-Ku, supaya bangsa-bangsa mengenal Aku, pada saat Aku menunjukkan kekudusan-Ku kepadamu di hadapan mereka, hai Gog."
 },
 {
   "id": 21447,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 17,
   "firman": "Beginilah firman Tuhan ALLAH: Engkaulah itu tentang siapa Aku sudah berfirman pada hari-hari dahulu kala dengan perantaraan hamba-hamba-Ku, yaitu nabi-nabi Israel, yang bertahun-tahun bernubuat pada waktu itu, bahwa Aku akan membawa engkau melawan umat-Ku."
 },
 {
   "id": 21448,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 18,
   "firman": "Pada waktu itu, pada saat Gog datang melawan tanah Israel, demikianlah firman Tuhan ALLAH, amarah-Ku akan timbul. Dalam murka-Ku,"
 },
 {
   "id": 21449,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 19,
   "firman": "dalam cemburu-Ku dan dalam api kemurkaan-Ku Aku akan berfirman: Pada hari itu pasti terjadi gempa bumi yang dahsyat di tanah Israel."
 },
 {
   "id": 21450,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 20,
   "firman": "Ikan-ikan di laut, burung-burung di udara, binatang-binatang hutan, segala binatang melata yang merayap di bumi dan semua manusia yang ada di atas bumi akan gentar melihat wajah-Ku. Gunung-gunung akan runtuh, lereng-lereng gunung akan longsor dan tiap tembok akan roboh ke tanah."
 },
 {
   "id": 21451,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 21,
   "firman": "Dan Aku akan memanggil segala macam kekejutan terhadap Gog, demikianlah firman Tuhan ALLAH, sehingga pedang seorang akan memakan yang lain."
 },
 {
   "id": 21452,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 22,
   "firman": "Aku akan menghukum dia dengan sampar dan tumpahan darah; Aku akan menurunkan hujan lebat, rambun, api dan hujan belerang ke atasnya dan ke atas tentaranya dan ke atas banyak bangsa yang menyertai dia."
 },
 {
   "id": 21453,
   "kitab": "Yeh",
   "pasal": 38,
   "ayat": 23,
   "firman": "Aku akan menunjukkan kebesaran-Ku dan kekudusan-Ku dan menyatakan diri-Ku di hadapan bangsa-bangsa yang banyak, dan mereka akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21454,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 1,
   "firman": "Dan engkau, anak manusia, bernubuatlah melawan Gog dan katakanlah: Beginilah firman Tuhan ALLAH: Lihat, Aku akan menjadi lawanmu, hai Gog raja agung negeri Mesekh dan Tubal"
 },
 {
   "id": 21455,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 2,
   "firman": "dan Aku akan menarik dan menuntun engkau dan Aku akan mendatangkan engkau dari utara sekali dan membawa engkau ke gunung-gunung Israel."
 },
 {
   "id": 21456,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 3,
   "firman": "Aku akan memukul tangan kirimu sehingga busurmu jatuh dan membuat panah-panahmu berjatuhan dari tangan kananmu."
 },
 {
   "id": 21457,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 4,
   "firman": "Di atas gunung-gunung Israel engkau akan rebah dengan seluruh bala tentaramu beserta bangsa-bangsa yang menyertai engkau; dan engkau akan Kuberikan kepada burung-burung buas dari segala jenis dan kepada binatang-binatang buas menjadi makanannya."
 },
 {
   "id": 21458,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 5,
   "firman": "Engkau akan rebah di padang, sebab Aku yang mengatakannya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21459,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 6,
   "firman": "Aku mendatangkan api ke atas Magog dan ke atas orang-orang yang diam di daerah pesisir dengan aman tenteram, dan mereka akan mengetahui bahwa Akulah TUHAN."
 },
 {
   "id": 21460,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 7,
   "firman": "Dan Aku akan menyatakan nama-Ku yang kudus di tengah-tengah umat-Ku Israel dan Aku tidak lagi membiarkan nama-Ku yang kudus dinajiskan, sehingga bangsa-bangsa akan mengetahui bahwa Akulah TUHAN, Yang Mahakudus di Israel."
 },
 {
   "id": 21461,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 8,
   "firman": "Sungguh, pasti datang dan terjadi, yaitu hari yang sudah Kufirmankan."
 },
 {
   "id": 21462,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 9,
   "firman": "Dan yang diam di kota-kota Israel akan keluar dan menyalakan api serta membakar semua perlengkapan senjata Gog, yaitu perisai kecil dan besar, busur dan panah, tongkat pemukul dan tombak, dan mereka membakarnya selama tujuh tahun."
 },
 {
   "id": 21463,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 10,
   "firman": "Mereka tidak akan mengambil kayu dari hutan belukar atau membelah kayu api di hutan-hutan, sebab mereka akan menyalakan api itu dengan perlengkapan senjata itu. Mereka akan merampas orang-orang yang merampas mereka dan menjarah orang-orang yang menjarah mereka, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21464,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 11,
   "firman": "Maka pada hari itu Aku akan memberikan kepada Gog suatu tempat, di mana ia akan dikubur di Israel, yaitu Lembah Penyeberangan di sebelah timur dari laut dan kuburan itu akan menghalangi orang-orang yang menyeberang. Di sana Gog akan dikubur dengan semua khalayak ramai yang mengikutinya dan tempat itu akan disebut Lembah Khalayak Ramai Gog."
 },
 {
   "id": 21465,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 12,
   "firman": "Kaum Israel akan mengubur mereka selama tujuh bulan dengan maksud mentahirkan tanah itu."
 },
 {
   "id": 21466,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 13,
   "firman": "Dan seluruh penduduk negeri turut menguburnya dan hal itu menjadikan mereka kenamaan pada hari Aku menyatakan kemuliaan-Ku, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21467,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 14,
   "firman": "Beberapa orang dikhususkan untuk terus-menerus menjelajahi seluruh tanah itu untuk mengubur orang-orang yang masih bergelimpangan di atas tanah dengan maksud mentahirkannya. Sesudah lewat yang tujuh bulan itu mereka akan memeriksa tanah itu."
 },
 {
   "id": 21468,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 15,
   "firman": "Kalau mereka menjelajahinya dan seorang menjumpai sepotong tulang manusia, maka ia harus meletakkan batu di sampingnya sebagai tanda sampai tukang-tukang kubur menguburkannya di Lembah khalayak Ramai Gog."
 },
 {
   "id": 21469,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 16,
   "firman": "--Dan ada juga nama kota Hamona--.Dengan demikian mereka mentahirkan tanah itu."
 },
 {
   "id": 21470,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 17,
   "firman": "Dan engkau, anak manusia, beginilah firman Tuhan ALLAH: Katakanlah kepada segala jenis burung-burung dan segala binatang buas: Berkumpullah kamu dan datanglah, berhimpunlah kamu dari segala penjuru pada perjamuan korban yang Kuadakan bagimu, yaitu suatu perjamuan korban yang besar di atas gunung-gunung Israel; kamu akan makan daging dan minum darah."
 },
 {
   "id": 21471,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 18,
   "firman": "Daging para pahlawan akan kamu makan dan darah para pemimpin dunia akan kamu minum, mereka semuanya ibarat domba jantan, anak domba, kambing jantan dan lembu jantan, ternak gemukan dari Basan."
 },
 {
   "id": 21472,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 19,
   "firman": "Kamu akan makan lemak sampai kamu kenyang dan minum darah sampai kamu menjadi mabuk pada perjamuan korban yang Kuadakan bagimu."
 },
 {
   "id": 21473,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 20,
   "firman": "Kamu akan menjadi kenyang pada perjamuan-Ku dengan makanan: kuda dan penunggangnya, pahlawan dan semua orang perang, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21474,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 21,
   "firman": "Aku akan membuat kuasa kemuliaan-Ku berlaku atas bangsa-bangsa dan mereka semua melihat hukuman yang akan Kujatuhkan dan melihat tangan-Ku yang akan memukul mereka."
 },
 {
   "id": 21475,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 22,
   "firman": "Dan kaum Israel akan mengetahui bahwa Akulah TUHAN, Allah mereka, mulai hari itu dan seterusnya."
 },
 {
   "id": 21476,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 23,
   "firman": "Dan bangsa-bangsa akan mengetahui bahwa karena kesalahannya kaum Israel harus pergi ke dalam pembuangan, dan sebab mereka berobah setia terhadap Aku, Aku menyembunyikan wajah-Ku terhadap mereka. Dan Aku menyerahkan mereka ke dalam tangan lawan-lawannya dan mereka semuanya mati rebah oleh pedang."
 },
 {
   "id": 21477,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 24,
   "firman": "Selaras dengan kenajisan dan durhaka mereka Kuperlakukan mereka dan Kusembunyikan wajah-Ku terhadap mereka."
 },
 {
   "id": 21478,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 25,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Sekarang, Aku akan memulihkan keadaan Yakub dan akan menyayangi seluruh kaum Israel dan cemburu-Ku timbul untuk mempertahankan nama-Ku yang kudus."
 },
 {
   "id": 21479,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 26,
   "firman": "Mereka akan melupakan noda mereka dan segala ketidaksetiaan mereka, yang dilakukannya terhadap Aku, kalau mereka sudah diam kembali di tanah mereka dengan aman tenteram dengan tidak dikejutkan oleh apapun,"
 },
 {
   "id": 21480,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 27,
   "firman": "dan kalau Aku sudah membawa mereka kembali dari tengah bangsa-bangsa dan mengumpulkan mereka dari tanah musuh-musuh mereka dan pada saat Aku menunjukkan kekudusan-Ku kepada mereka di hadapan bangsa-bangsa yang banyak."
 },
 {
   "id": 21481,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 28,
   "firman": "Dan mereka akan mengetahui bahwa Akulah TUHAN, Allah mereka, yang membawa mereka ke dalam pembuangan di tengah bangsa-bangsa dan mengumpulkan mereka kembali di tanahnya dan Aku tidak membiarkan seorangpun dari padanya tinggal di sana."
 },
 {
   "id": 21482,
   "kitab": "Yeh",
   "pasal": 39,
   "ayat": 29,
   "firman": "Aku tidak lagi menyembunyikan wajah-Ku terhadap mereka, kalau Aku mencurahkan Roh-Ku ke atas kaum Israel, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21483,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 1,
   "firman": "Dalam tahun kedua puluh lima sesudah pembuangan kami, yaitu pada permulaan tahun, pada tanggal sepuluh bulan itu, dalam tahun keempat belas sesudah kota itu ditaklukkan, pada hari itu juga kekuasaan TUHAN meliputi aku dan dibawa-Nya aku"
 },
 {
   "id": 21484,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 2,
   "firman": "dalam penglihatan-penglihatan ilahi ke tanah Israel dan menempatkan aku di atas sebuah gunung yang tinggi sekali. Di atas itu di hadapanku ada yang menyerupai bentuk kota."
 },
 {
   "id": 21485,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 3,
   "firman": "Ke sanalah aku dibawa-Nya. Dan lihat, ada seorang yang kelihatan seperti tembaga dan di tangannya ada tali lenan beserta tongkat pengukur; dan ia berdiri di pintu gerbang."
 },
 {
   "id": 21486,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 4,
   "firman": "Orang itu berbicara kepadaku: \"Hai anak manusia, lihatlah dengan teliti dan dengarlah dengan sungguh-sungguh dan perhatikanlah baik-baik segala sesuatu yang akan kuperlihatkan kepadamu; sebab untuk itulah engkau dibawa ke mari, supaya aku memperlihatkan semuanya itu kepadamu. Beritahukanlah segala sesuatu yang kaulihat kepada kaum Israel.\""
 },
 {
   "id": 21487,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 5,
   "firman": "Lihat, di luar bangunan itu ada tembok, seluruh keliling bangunan itu. Dan di tangan orang itu ada tongkat pengukur, yang panjangnya enam hasta. --Hasta ini setapak tangan lebih panjang dari hasta biasa--.Ia mengukur tembok itu, tebalnya satu tongkat dan tingginya satu tongkat."
 },
 {
   "id": 21488,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 6,
   "firman": "Lalu ia sampai di pintu gerbang yang menghadap ke timur dan menaiki tangganya, ia mengukur ambang dari pintu gerbang itu: satu tongkat lebarnya."
 },
 {
   "id": 21489,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 7,
   "firman": "Kemudian ia mengukur kamar jaga: panjangnya satu tongkat dan lebarnya satu tongkat, dan jarak antara dua kamar jaga adalah lima hasta. Dan ambang pintu gerbang sebelah dalam yang dekat balai gerbang itu adalah satu tongkat."
 },
 {
   "id": 21490,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 8,
   "firman": "Kemudian ia mengukur balai gerbang itu: delapan hasta"
 },
 {
   "id": 21491,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 9,
   "firman": "dan tiang temboknya dua hasta dan balai itu ada di sebelah dalam."
 },
 {
   "id": 21492,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 10,
   "firman": "Mengenai kamar-kamar jaga yang di pintu gerbang sebelah timur itu ada tiga kamar pada tiap sisi; ketiga-tiganya sama ukurannya dan kedua tiang tembok pada kedua sisi sama juga ukurannya."
 },
 {
   "id": 21493,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 11,
   "firman": "Lalu ia mengukur lobang pintu gerbang itu: lebarnya sebelah dalam adalah sepuluh hasta, dan lebarnya sebelah luar tiga belas hasta."
 },
 {
   "id": 21494,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 12,
   "firman": "Di bagian muka dari kamar-kamar jaga itu ada sekatan, yang berukuran satu hasta dan demikian juga ukuran sekatan di sebelah yang lain. Dan ukuran kamar jaga itu adalah enam hasta pada kedua belah pihak."
 },
 {
   "id": 21495,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 13,
   "firman": "Lalu ia mengukur pintu gerbang itu dari dinding belakang kamar jaga yang satu sampai dinding belakang kamar jaga yang lain, melalui kedua pintu sekatan itu: lebarnya dua puluh lima hasta."
 },
 {
   "id": 21496,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 14,
   "firman": "Ia mengukur juga balai gerbang itu: dua puluh hasta dan sekeliling balai gerbang itu adalah pelataran."
 },
 {
   "id": 21497,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 15,
   "firman": "Dari muka pintu gerbang luar sampai balai gerbang sebelah dalam: lima puluh hasta."
 },
 {
   "id": 21498,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 16,
   "firman": "Pada sekeliling pintu gerbang itu di bagian dalam ada jendela-jendela dengan bidai, yaitu di kamar-kamar jaga dan pada tiang-tiang tembok dan begitu juga pada balai gerbang. Dan pada tiang-tiang tembok itu terukir gambar pohon-pohon korma."
 },
 {
   "id": 21499,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 17,
   "firman": "Lalu dibawanya aku ke pelataran luar, sungguh, sekeliling pelataran itu ada bilik-bilik, yang jumlahnya tiga puluh. Dan bilik-bilik itu dibangun di atas sebuah lantai batu."
 },
 {
   "id": 21500,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 18,
   "firman": "Dan lantai batu itu ada di samping pintu-pintu gerbang mengikuti panjangnya. Itulah lantai batu bawah."
 },
 {
   "id": 21501,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 19,
   "firman": "Kemudian ia mengukur lebar pelataran itu dari sebelah dalam pintu gerbang bawah sampai sebelah luar pintu gerbang dalam: seratus hasta. Lalu ia berjalan di depanku menuju ke utara"
 },
 {
   "id": 21502,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 20,
   "firman": "dan sungguh, ada pintu gerbang yang menghadap ke utara, yang termasuk pelataran luar. Ia mengukur panjang dan lebarnya."
 },
 {
   "id": 21503,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 21,
   "firman": "Kamar jaganya, tiga sebelah-menyebelah, tiang-tiang tembok dan balai gerbangnya adalah seukuran dengan pintu gerbang pertama: lima puluh hasta panjangnya dan lebarnya dua puluh lima hasta."
 },
 {
   "id": 21504,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 22,
   "firman": "Jendela-jendelanya, balai gerbangnya dan gambar-gambar pohon kormanya seukuran juga dengan pintu gerbang yang menghadap ke timur. Orang dapat naik ke situ melalui tangga yang tujuh tingkat dan balai gerbangnya ada sebelah dalam."
 },
 {
   "id": 21505,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 23,
   "firman": "Di pelataran dalam ada sebuah pintu gerbang yang berhadapan dengan pintu gerbang utara sama seperti halnya dengan pintu gerbang timur; ia mengukur dari pintu gerbang sampai pintu gerbang: seratus hasta."
 },
 {
   "id": 21506,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 24,
   "firman": "Kemudian ia membawa aku menuju selatan, sungguh, ada sebuah pintu gerbang yang menghadap ke selatan; ia mengukur kamar-kamar jaganya, tiang-tiang temboknya dan balai gerbangnya, ukurannya sama saja dengan yang lain-lain."
 },
 {
   "id": 21507,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 25,
   "firman": "Sekeliling pintu gerbang itu dan balai gerbangnya ada jendela-jendela, yang sama dengan yang lain-lain; panjang pintu gerbang itu lima puluh hasta dan lebarnya dua puluh lima hasta."
 },
 {
   "id": 21508,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 26,
   "firman": "Tangga ke situ adalah tujuh tingkat, dan balai gerbangnya ada sebelah dalam. Pada pintu gerbang itu juga, di tiang-tiang temboknya, terukir gambar pohon-pohon korma, satu batang di sebelah sini dan satu batang di sebelah sana."
 },
 {
   "id": 21509,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 27,
   "firman": "Di bagian selatan pelataran dalam ada juga pintu gerbang; ia mengukur dari pintu gerbang sampai pintu gerbang di bagian selatan: seratus hasta."
 },
 {
   "id": 21510,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 28,
   "firman": "Lalu dibawanya aku ke pelataran dalam melalui pintu gerbang selatan dan ia mengukur pintu gerbang itu, ukurannya sama saja dengan yang lain-lain."
 },
 {
   "id": 21511,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 29,
   "firman": "Kamar-kamar jaganya, tiang-tiang temboknya dan balai gerbangnya, ukurannya sama saja dengan yang lain-lain. Sekeliling pintu gerbang itu dan balai gerbangnya ada jendela-jendela; panjang pintu gerbang itu lima puluh hasta dan lebarnya dua puluh lima hasta. --"
 },
 {
   "id": 21512,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 30,
   "firman": "Sekelilingnya ada balai-balai gerbang, panjangnya dua puluh lima hasta dan lebarnya lima hasta. --"
 },
 {
   "id": 21513,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 31,
   "firman": "Balai gerbangnya adalah sebelah pelataran luar dan pada tiang-tiang temboknya terukir gambar pohon-pohon korma dan tangganya ke atas ada delapan tingkat."
 },
 {
   "id": 21514,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 32,
   "firman": "Lalu dibawanya aku ke sebelah timur pelataran dalam dan ia mengukur pintu gerbang yang di situ, dan ukurannya sama saja dengan yang lain-lain."
 },
 {
   "id": 21515,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 33,
   "firman": "Kamar-kamar jaganya, tiang-tiang temboknya dan balai gerbangnya, ukurannya sama saja dengan yang lain-lain. Sekeliling pintu gerbang itu dan balai gerbangnya ada jendela-jendela; panjang pintu gerbang itu lima puluh hasta dan lebarnya dua puluh lima hasta."
 },
 {
   "id": 21516,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 34,
   "firman": "Balai gerbangnya adalah sebelah pelataran luar dan pada tiang-tiang temboknya terukir gambar pohon-pohon korma, sebelah sini dan sebelah sana, dan tangganya ke atas ada delapan tingkat."
 },
 {
   "id": 21517,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 35,
   "firman": "Kemudian dibawanya aku ke pintu gerbang utara dan ia mengukurnya, dan ukurannya sama saja dengan yang lain-lain."
 },
 {
   "id": 21518,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 36,
   "firman": "Kamar-kamar jaganya, tiang-tiang temboknya dan balai gerbangnya, ukurannya sama saja dengan yang lain-lain, dan sekelilingnya ada jendela-jendela; panjang pintu gerbang itu lima puluh hasta dan lebarnya dua puluh lima hasta."
 },
 {
   "id": 21519,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 37,
   "firman": "Balai gerbangnya adalah sebelah pelataran luar, dan pada tiang-tiang temboknya terukir gambar pohon-pohon korma, sebelah sini dan sebelah sana, dan tangganya ke atas ada delapan tingkat."
 },
 {
   "id": 21520,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 38,
   "firman": "Ada juga sebuah bilik, yang pintunya di balai gerbang dan di sana orang membasuh korban bakaran."
 },
 {
   "id": 21521,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 39,
   "firman": "Dalam balai gerbang itu ada dua meja sebelah sini dan dua meja sebelah sana, tempat menyembelih korban bakaran, korban penghapus dosa dan korban penebus salah."
 },
 {
   "id": 21522,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 40,
   "firman": "Di samping kiri balai gerbang, di sebelah luar, ada dua meja, dan di samping kanan balai gerbang itu juga dua meja."
 },
 {
   "id": 21523,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 41,
   "firman": "Jadi di pintu gerbang itu ada empat meja sebelah sini dan empat meja sebelah sana; semuanya delapan meja di situ untuk tempat menyembelih korban."
 },
 {
   "id": 21524,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 42,
   "firman": "Ada juga empat meja lagi untuk korban bakaran, yang diperbuat dari batu pahat. Panjangnya satu setengah hasta, lebarnya satu setengah hasta dan tingginya satu hasta. Di sana diletakkan perkakas-perkakas untuk menyembelih korban bakaran dan korban sembelihan."
 },
 {
   "id": 21525,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 43,
   "firman": "Sekeliling ruangan itu dipakukan gantungan-gantungan yang panjangnya setapak tangan, dan di atas meja-meja itu diletakkan daging korban."
 },
 {
   "id": 21526,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 44,
   "firman": "Lalu dibawanya aku ke pelataran dalam, sungguh, di sana ada dua bilik, yaitu satu di samping pintu gerbang utara dan mukanya menghadap ke selatan, satu lagi di samping pintu gerbang selatan dan mukanya menghadap ke utara."
 },
 {
   "id": 21527,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 45,
   "firman": "Ia berkata kepadaku: \"Bilik ini, yang mukanya menghadap ke selatan, adalah bagi imam-imam yang bertugas di Bait Suci,"
 },
 {
   "id": 21528,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 46,
   "firman": "dan bilik yang mukanya menghadap ke utara, adalah bagi imam-imam yang bertugas di mezbah; mereka ini adalah bani Zadok dan hanya golongan inilah dari bani Lewi yang boleh mendekat kepada TUHAN untuk menyelenggarakan kebaktian.\""
 },
 {
   "id": 21529,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 47,
   "firman": "Lalu ia mengukur pelataran dalam: itu suatu empat persegi, yang panjangnya seratus hasta dan lebarnya seratus hasta; mezbah ada di hadapan Bait Suci."
 },
 {
   "id": 21530,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 48,
   "firman": "Lalu dibawanya aku ke balai Bait Suci dan ia mengukur tiang-tiang temboknya: tebalnya lima hasta yang sebelah sini dan lima hasta yang sebelah sana; lebar pintu itu empat belas hasta dan dinding sampingnya masing-masing tiga hasta."
 },
 {
   "id": 21531,
   "kitab": "Yeh",
   "pasal": 40,
   "ayat": 49,
   "firman": "Panjang balai Bait Suci itu adalah dua puluh hasta dan lebarnya dua belas hasta. Orang dapat naik ke situ melalui tangga yang sepuluh tingkat dan dekat kedua tiang tembok itu ada dua tiang, satu sebelah sini dan satu sebelah sana."
 },
 {
   "id": 21532,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 1,
   "firman": "Kemudian dibawanya aku ke dalam ruang besar Bait Suci dan ia mengukur tiang temboknya: yang sebelah sini enam hasta tebalnya dan yang sebelah sana enam hasta juga."
 },
 {
   "id": 21533,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 2,
   "firman": "Lebar pintu itu adalah sepuluh hasta dan lebar dinding sampingnya adalah lima hasta sebelah sini dan lima hasta sebelah sana. Panjang ruang besar diukur juga: empat puluh hasta dan lebarnya dua puluh hasta."
 },
 {
   "id": 21534,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 3,
   "firman": "Lalu ia sampai ke ruang dalam. Ia mengukur tiang temboknya: tebalnya dua hasta, dan lebar pintu sendiri: enam hasta dan lebar dinding sampingnya tujuh hasta sebelah sini dan tujuh hasta sebelah sana."
 },
 {
   "id": 21535,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 4,
   "firman": "Ia mengukur panjang ruang dalam itu: dua puluh hasta, dan lebarnya: dua puluh hasta sesuai dengan lebar ruang besar. Lalu ia berkata kepadaku: \"Inilah tempat maha kudus.\""
 },
 {
   "id": 21536,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 5,
   "firman": "Kemudian ia mengukur dinding Bait Suci itu: enam hasta tebalnya dan lebar kamar tambahan yang terdapat di sekeliling Bait Suci itu, empat hasta."
 },
 {
   "id": 21537,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 6,
   "firman": "Kamar-kamar tambahan itu ada tiga tingkat dan pada satu tingkat terdapat tiga puluh kamar. Pada sekeliling dinding Bait Suci ada ceruk-ceruk untuk mengokohkan kamar-kamar tambahan itu, sebab kamar-kamar ini tidak digabungkan pada dinding Bait Suci."
 },
 {
   "id": 21538,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 7,
   "firman": "Dan kamar-kamar tambahan semakin lebih besar dari tingkat pertama sampai tingkat ketiga selaras dengan bertambah besarnya ceruk-ceruk pada tiap tingkat sekeliling Bait Suci itu; ada tangga menuju ke atas dan dengan demikian orang dapat naik dari tingkat bawah ke tingkat atas melalui tingkat tengah."
 },
 {
   "id": 21539,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 8,
   "firman": "Aku melihat bahwa alas Bait Suci itu lebih tinggi dari sekelilingnya. Dasar kamar-kamar tambahan itu berukuran satu tongkat penuh, yaitu tingginya enam hasta."
 },
 {
   "id": 21540,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 9,
   "firman": "Tebal dinding yang sebelah luar kamar tambahan adalah lima hasta; lebar bagian alas Bait Suci yang dibiarkan kosong adalah lima hasta. Di antara alas bangunan itu dan"
 },
 {
   "id": 21541,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 10,
   "firman": "bilik-bilik ada jarak dua puluh hasta sekeliling bangunan itu."
 },
 {
   "id": 21542,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 11,
   "firman": "Dan pintu-pintu kamar tambahan ke luar ke bagian yang kosong itu, satu pintu di sebelah utara dan satu pintu di sebelah selatan; dan lebar tempat yang kosong itu adalah lima hasta sekeliling."
 },
 {
   "id": 21543,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 12,
   "firman": "Bangunan yang terdapat di lapangan tertutup yang di sebelah barat lebarnya tujuh puluh hasta, sedang dinding yang mengelilinginya tebalnya lima hasta dan panjangnya sembilan puluh hasta."
 },
 {
   "id": 21544,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 13,
   "firman": "Lalu ia mengukur Bait Suci itu: seratus hasta panjangnya dan lapangan tertutup bersama bangunan dan dindingnya: seratus hasta juga;"
 },
 {
   "id": 21545,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 14,
   "firman": "begitu juga lebarnya muka Bait Suci bersama lapangan tertutup sebelah timur: seratus hasta."
 },
 {
   "id": 21546,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 15,
   "firman": "Kemudian ia mengukur panjang bangunan yang terdapat di lapangan tertutup sebelah barat bersama serambi-serambinya di kedua belah: seratus hasta. Ruang besar, ruang dalam dan balai luar"
 },
 {
   "id": 21547,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 16,
   "firman": "ditutupi dengan papan dan sekeliling ketiga ruang itu ada jendela-jendela yang berbidai dan serambi-serambi. Di hadapan ambang itu seluruh Bait Suci ditutupi dengan papan, mulai dari lantai sampai ke jendela-jendelanya--sedang jendela-jendela ini terlindung--"
 },
 {
   "id": 21548,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 17,
   "firman": "sampai bagian atas pintu dan ruang dalam dan juga di luar. Dan di seluruh dinding bagian dalam dan bagian luar terukir"
 },
 {
   "id": 21549,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 18,
   "firman": "gambar-gambar kerub dan pohon-pohon korma, di antara dua kerub sebatang pohon korma, dan masing-masing kerub itu mempunyai dua muka."
 },
 {
   "id": 21550,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 19,
   "firman": "Dari sebelah yang satu muka manusia dan dari sebelah yang lain muka singa yang menghadap ke pohon korma itu dan begitulah dibuat di seluruh Bait Suci."
 },
 {
   "id": 21551,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 20,
   "firman": "Dari lantai sampai ke atas pintu terukir kerub-kerub dan pohon-pohon korma pada dinding."
 },
 {
   "id": 21552,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 21,
   "firman": "Tiang-tiang pintu dari ruang besar adalah empat persegi. Dan di hadapan tempat maha kudus ada sesuatu yang kelihatan menyerupai"
 },
 {
   "id": 21553,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 22,
   "firman": "mezbah dari kayu, tingginya tiga hasta, panjangnya dua hasta dan lebarnya dua hasta; sudut-sudutnya serta alasnya dan dindingnya dari kayu. Ia berkata kepadaku: \"Inilah meja yang ada di hadirat TUHAN.\""
 },
 {
   "id": 21554,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 23,
   "firman": "Ruang besar mempunyai dua daun pintu dan tempat maha kudus"
 },
 {
   "id": 21555,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 24,
   "firman": "juga mempunyai dua daun pintu. Pada pintu-pintu itu ada dua daun pintu yang dapat berputar, dua daun pintu pada pintu yang satu dan dua daun pintu pada yang lain."
 },
 {
   "id": 21556,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 25,
   "firman": "Pada pintu-pintu ini juga, yaitu pintu-pintu ruang besar, terukir kerub-kerub dan pohon-pohon korma, seperti pada dinding-dinding. Di muka balai Bait Suci itu, yaitu di luar, ada tangga kayu."
 },
 {
   "id": 21557,
   "kitab": "Yeh",
   "pasal": 41,
   "ayat": 26,
   "firman": "Pada kedua dinding samping dari balai itu ada jendela-jendela yang berbidai dan ukiran pohon-pohon korma."
 },
 {
   "id": 21558,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 1,
   "firman": "Lalu diiringnya aku ke pelataran luar bagian utara dan dibawanya aku ke bilik-bilik sebelah utara yang berhadapan dengan lapangan tertutup dan berhadapan dengan bangunan yang di ujung barat."
 },
 {
   "id": 21559,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 2,
   "firman": "Panjang bangunan bilik-bilik itu di sebelah utara ialah seratus hasta dan lebarnya lima puluh hasta."
 },
 {
   "id": 21560,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 3,
   "firman": "Berhadapan dengan yang dua puluh hasta dari pelataran dalam dan berhadapan dengan lantai batu yang terdapat di pelataran luar ada serambi yang berhadap-hadapan dan yang bertingkat tiga."
 },
 {
   "id": 21561,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 4,
   "firman": "Di depan bilik-bilik itu ada gang menuju ke dalam yang lebarnya sepuluh hasta dan panjangnya seratus hasta dan pintu-pintu masuknya adalah di sebelah utara."
 },
 {
   "id": 21562,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 5,
   "firman": "Bilik-bilik di tingkat atas adalah lebih kecil dari bilik-bilik di tingkat bawah dan tingkat menengah dari bangunan itu oleh karena serambi-serambi itu memakan lebih banyak tempat dari bilik-bilik itu."
 },
 {
   "id": 21563,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 6,
   "firman": "Sebab bilik-bilik itu bertingkat tiga dan tidak mempunyai tiang-tiang seperti yang ada di pelataran luar. Itulah sebabnya bilik-bilik atas lebih kecil dari bilik-bilik bawah atau tengah."
 },
 {
   "id": 21564,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 7,
   "firman": "Di luar ada tembok yang sejajar dengan barisan bilik-bilik, berdekatan dengan pelataran luar dan terdapat di hadapan bilik-bilik; panjangnya lima puluh hasta."
 },
 {
   "id": 21565,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 8,
   "firman": "Sebab barisan bilik yang berbatasan dengan pelataran luar panjangnya adalah lima puluh hasta, tetapi barisan bilik yang berbatasan dengan Bait Suci panjangnya seratus hasta."
 },
 {
   "id": 21566,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 9,
   "firman": "Di bagian bawah bilik-bilik ini terdapat pintu masuk dari jurusan timur, kalau orang dari pelataran luar ingin masuk ke dalamnya,"
 },
 {
   "id": 21567,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 10,
   "firman": "dan pintu itu terdapat pada pangkal tembok luar. Di sebelah selatan di hadapan lapangan tertutup itu dan di hadapan bangunan yang di ujung barat ada juga bilik-bilik"
 },
 {
   "id": 21568,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 11,
   "firman": "dan di depannya ada gang. Bilik-bilik ini serupa dengan bilik-bilik yang di sebelah utara, panjangnya dan lebarnya, pintu-pintu keluar dan rancangannya. Seperti pintu-pintu masuk di sebelah utara"
 },
 {
   "id": 21569,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 12,
   "firman": "begitulah pintu-pintu masuk bilik-bilik yang di sebelah selatan. Ada juga pintu pada pangkal jalan yang melintang di sisi tembok, yaitu pintu dari jurusan timur, kalau orang ingin masuk ke dalam bilik-bilik."
 },
 {
   "id": 21570,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 13,
   "firman": "Lalu ia berkata kepadaku: \"Bilik-bilik yang di utara dan bilik-bilik yang di selatan yang menghadap ke lapangan tertutup, itulah bilik-bilik kudus, di mana imam-imam, yang mendekat kepada TUHAN, memakan persembahan-persembahan maha kudus. Di sana mereka akan menaruh persembahan-persembahan maha kudus, korban sajian, korban penghapus dosa dan korban penebus salah, sebab tempat itu kudus."
 },
 {
   "id": 21571,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 14,
   "firman": "Kalau para imam masuk ke tempat kudus, mereka tidak akan keluar ke pelataran luar, sebelum mereka menanggalkan pakaian mereka di sana, yang dipakainya waktu menyelenggarakan kebaktian, sebab pakaian-pakaian itu adalah kudus. Mereka harus memakai pakaian yang lain, barulah mereka boleh datang ke tempat umat TUHAN.\""
 },
 {
   "id": 21572,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 15,
   "firman": "Sesudah ia selesai dengan mengukur seluruh bangunan dalam itu, ia mengiring aku menuju pintu gerbang yang menghadap ke sebelah timur, lalu mengukur sekeliling lingkungan Bait Suci itu."
 },
 {
   "id": 21573,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 16,
   "firman": "Ia mengukur sisi timur dengan tongkat pengukur: lima ratus hasta menurut tongkat pengukur. Lalu ia berputar"
 },
 {
   "id": 21574,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 17,
   "firman": "dan mengukur sisi utara: lima ratus hasta menurut tongkat pengukur. Ia berputar lagi"
 },
 {
   "id": 21575,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 18,
   "firman": "ke sisi selatan dan mengukurnya: lima ratus hasta menurut tongkat pengukur."
 },
 {
   "id": 21576,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 19,
   "firman": "Kemudian ia berputar ke sisi barat dan mengukurnya: lima ratus hasta menurut tongkat pengukur."
 },
 {
   "id": 21577,
   "kitab": "Yeh",
   "pasal": 42,
   "ayat": 20,
   "firman": "Keempat sisinya diukur. Sekeliling lingkungan itu ada tembok: panjangnya lima ratus hasta dan lebarnya lima ratus hasta, untuk memisahkan yang kudus dari yang tidak kudus."
 },
 {
   "id": 21578,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 1,
   "firman": "Lalu dibawanya aku ke pintu gerbang, yaitu pintu gerbang yang menghadap ke sebelah timur."
 },
 {
   "id": 21579,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 2,
   "firman": "Sungguh, kemuliaan Allah Israel datang dari sebelah timur dan terdengarlah suara seperti suara air terjun yang menderu dan bumi bersinar karena kemuliaan-Nya."
 },
 {
   "id": 21580,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 3,
   "firman": "Yang kelihatan kepadaku itu adalah seperti yang kelihatan kepadaku ketika Ia datang untuk memusnahkan kota itu dan seperti yang kelihatan kepadaku di tepi sungai Kebar, maka aku sembah sujud."
 },
 {
   "id": 21581,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 4,
   "firman": "Sedang kemuliaan TUHAN masuk di dalam Bait Suci melalui pintu gerbang yang menghadap ke sebelah timur,"
 },
 {
   "id": 21582,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 5,
   "firman": "Roh itu mengangkat aku dan membawa aku ke pelataran dalam, sungguh, Bait Suci itu penuh kemuliaan TUHAN."
 },
 {
   "id": 21583,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 6,
   "firman": "Lalu aku mendengar Dia berfirman kepadaku dari dalam Bait Suci itu--orang yang mengukur Bait Suci itu berdiri di sampingku--"
 },
 {
   "id": 21584,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 7,
   "firman": "dan Ia berfirman kepadaku: \"Hai anak manusia, inilah tempat takhta-Ku dan inilah tempat tapak kaki-Ku; di sinilah Aku akan diam di tengah-tengah orang Israel untuk selama-lamanya dan kaum Israel tidak lagi akan menajiskan nama-Ku yang kudus, baik mereka maupun raja-raja mereka, dengan persundalan mereka atau dengan mayat raja-raja mereka yang sudah mati;"
 },
 {
   "id": 21585,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 8,
   "firman": "juga tidak dengan meletakkan ambang pintu mereka dekat ambang pintu-Ku atau mendirikan tiang-tiang pintu mereka dekat tiang-tiang pintu-Ku, sehingga hanya dinding yang memisahkan Aku dari mereka. Mereka menajiskan nama-Ku yang kudus dengan perbuatan-perbuatan mereka yang keji, maka dari itu Aku menghabiskan mereka dalam amarah-Ku."
 },
 {
   "id": 21586,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 9,
   "firman": "Sekarang, mereka akan menjauhkan ketidaksetiaan mereka dan mayat raja-raja mereka dari pada-Ku dan Aku akan diam di tengah-tengah mereka untuk selama-lamanya."
 },
 {
   "id": 21587,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 10,
   "firman": "Maka engkau, hai anak manusia, terangkanlah kepada kaum Israel tentang Bait Suci ini, agar mereka menjadi malu melihat kesalahan-kesalahan mereka, juga bagaimana Bait Suci itu kelihatan dan rancangannya."
 },
 {
   "id": 21588,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 11,
   "firman": "Dan kalau mereka merasa malu melihat segala sesuatu yang dilakukan mereka, gambarlah Bait Suci itu, bagian-bagiannya, pintu-pintu keluar dan pintu-pintu masuknya dan seluruh bagannya; beritahukanlah kepada mereka segala peraturannya dan hukumnya dan tuliskanlah itu di hadapan mereka, agar mereka melakukan dengan setia segala hukumnya dan peraturannya."
 },
 {
   "id": 21589,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 12,
   "firman": "Inilah ketentuan mengenai Bait Suci itu: seluruh daerah yang di puncak gunung itu adalah maha kudus. Sungguh, inilah ketentuan mengenai Bait Suci itu.\""
 },
 {
   "id": 21590,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 13,
   "firman": "Inilah ukuran-ukuran mezbah itu dalam hasta, yaitu hasta yang setapak tangan lebih panjang dari hasta biasa: paritnya adalah satu hasta dalamnya dan satu hasta lebarnya dan sekeliling parit itu ada tepi yang tingginya satu jengkal. Dan inilah tinggi mezbah itu:"
 },
 {
   "id": 21591,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 14,
   "firman": "dari parit yang di dalam tanah sampai jalur keliling yang terbawah adalah dua hasta dan lebar jalur keliling itu adalah satu hasta. Dari jalur keliling yang terbawah sampai jalur keliling yang di atas ada empat hasta dan lebar jalur keliling itu satu hasta juga."
 },
 {
   "id": 21592,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 15,
   "firman": "Tempat perapian itu adalah empat hasta tingginya dan dari tempat perapian itu muncul ke atas empat tanduk."
 },
 {
   "id": 21593,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 16,
   "firman": "Tempat perapian itu panjangnya dua belas hasta dan lebarnya dua belas hasta, jadi empat persegi."
 },
 {
   "id": 21594,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 17,
   "firman": "Jalur yang mengelilingi perapian itu panjangnya empat belas hasta dan lebarnya empat belas hasta, jadi empat persegi juga. Sekeliling mezbah itu ada parit, yang satu hasta lebarnya dan sekeliling parit itu ada tepinya, yang setengah hasta lebarnya. Tangga mezbah itu adalah sebelah timur."
 },
 {
   "id": 21595,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 18,
   "firman": "Lalu Ia berfirman kepadaku: \"Hai anak manusia, beginilah firman Tuhan ALLAH: Beginilah peraturan mengenai mezbah itu: Ketika sudah selesai dibuat dan hendak mempersembahkan korban bakaran di atasnya dan menyiramkan darah padanya,"
 },
 {
   "id": 21596,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 19,
   "firman": "berikanlah kepada imam-imam orang Lewi dari keturunan Zadok seekor lembu jantan muda untuk korban penghapus dosa, sebab merekalah yang boleh mendekat kepada-Ku untuk menyelenggarakan kebaktian, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21597,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 20,
   "firman": "Dan ambillah sedikit dari darah itu dan bubuhlah itu pada keempat tanduk mezbah itu dan pada keempat sudut jalur keliling itu dan pada tepinya sekeliling; dengan demikian engkau menyucikan mezbah itu dan mengadakan pendamaian baginya."
 },
 {
   "id": 21598,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 21,
   "firman": "Ambillah lembu jantan untuk korban penghapus dosa itu dan orang harus membakarnya di tempat yang sudah ditentukan sekitar Bait Suci, di luar tempat kudus."
 },
 {
   "id": 21599,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 22,
   "firman": "Pada hari kedua engkau harus mempersembahkan seekor kambing jantan yang tidak bercela sebagai korban penghapus dosa dan orang harus menyucikan mezbah itu seperti sudah disucikan dengan lembu jantan."
 },
 {
   "id": 21600,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 23,
   "firman": "Sesudah upacara penyucian itu engkau selesaikan, engkau harus mempersembahkan seekor lembu jantan muda yang tidak bercela dan seekor domba jantan dari antara domba-domba, yang tidak bercela."
 },
 {
   "id": 21601,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 24,
   "firman": "Engkau harus membawanya ke hadapan TUHAN dan imam-imam harus menaburkan garam ke atasnya dan mempersembahkannya sebagai korban bakaran bagi TUHAN."
 },
 {
   "id": 21602,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 25,
   "firman": "Selama tujuh hari engkau harus mengolah setiap hari seekor kambing sebagai korban penghapus dosa; harus diolah juga seekor lembu jantan muda dan domba jantan dari antara domba-domba, yang tidak bercela."
 },
 {
   "id": 21603,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 26,
   "firman": "Tujuh hari lamanya mereka harus mengadakan pendamaian bagi mezbah itu serta mentahirkannya, dan dengan demikian mentahbiskan mezbah itu."
 },
 {
   "id": 21604,
   "kitab": "Yeh",
   "pasal": 43,
   "ayat": 27,
   "firman": "Sesudah hari-hari itu berakhir, maka pada hari kedelapan dan seterusnya imam-imam akan mengolah korban-korban bakaranmu dan korban-korban keselamatanmu di atas mezbah itu dan Aku akan berkenan kepada kamu, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21605,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 1,
   "firman": "Kemudian ia membawa aku kembali ke pintu gerbang luar dari tempat kudus, yang menghadap ke timur; gerbang ini tertutup."
 },
 {
   "id": 21606,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 2,
   "firman": "Lalu TUHAN berfirman kepadaku: \"Pintu gerbang ini harus tetap tertutup, jangan dibuka dan jangan seorangpun masuk dari situ, sebab TUHAN, Allah Israel, sudah masuk melaluinya; karena itu gerbang itu harus tetap tertutup."
 },
 {
   "id": 21607,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 3,
   "firman": "Hanya raja itu, oleh karena ia raja boleh duduk di sana makan santapan di hadapan TUHAN. Raja itu akan masuk melalui balai gerbang dan akan keluar dari situ.\""
 },
 {
   "id": 21608,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 4,
   "firman": "Lalu dibawanya aku melalui pintu gerbang utara ke depan Bait Suci; aku melihat, sungguh, rumah TUHAN penuh kemuliaan TUHAN, maka aku sujud menyembah."
 },
 {
   "id": 21609,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 5,
   "firman": "TUHAN berfirman kepadaku: \"Hai anak manusia, perhatikanlah baik-baik, lihatlah dengan teliti dan dengarlah dengan sungguh-sungguh segala sesuatu yang hendak Kufirmankan kepadamu mengenai peraturan-peraturan rumah TUHAN dan tentang segala hukumnya dan perhatikanlah baik-baik siapa yang diperbolehkan masuk ke dalamnya: dan siapa yang harus ditolak dari tempat kudus."
 },
 {
   "id": 21610,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 6,
   "firman": "Katakanlah kepada kaum pemberontak, yaitu kaum Israel: Beginilah firman Tuhan ALLAH: Cukuplah perbuatan-perbuatanmu yang keji itu, hai kaum Israel,"
 },
 {
   "id": 21611,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 7,
   "firman": "yang membiarkan orang-orang asing, yaitu orang-orang yang tidak bersunat hatinya maupun dagingnya masuk dalam tempat kudus-Ku dan dengan kehadirannya mereka menajiskannya waktu kamu mempersembahkan santapan-Ku, yaitu lemak dan darah. Dengan berbuat begitu kamu lebih mengingkari perjanjian-Ku dari pada dengan segala perbuatanmu yang keji yang sudah-sudah."
 },
 {
   "id": 21612,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 8,
   "firman": "Kamu tidak memelihara barang-barang-Ku yang kudus dan kamu mengangkat mereka untuk memelihara kewajibanmu terhadap Aku di dalam tempat kudus-Ku."
 },
 {
   "id": 21613,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 9,
   "firman": "Oleh sebab itu beginilah firman Tuhan ALLAH: Tidak seorangpun dari orang-orang asing yang hatinya dan dagingnya tidak bersunat, boleh masuk dalam tempat kudus-Ku, ya setiap orang asing yang ada di tengah-tengah orang Israel."
 },
 {
   "id": 21614,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 10,
   "firman": "Tetapi orang-orang Lewi yang menjauh dari pada-Ku waktu Israel sesat dari pada-Ku dengan mengikuti berhala-berhala mereka, akan menanggung hukumannya."
 },
 {
   "id": 21615,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 11,
   "firman": "Di dalam tempat kudus-Ku merekalah yang mendapat tugas penjagaan di pintu-pintu gerbang Bait Suci dan tugas pelayanan di dalam Bait Suci; merekalah yang menyembelih korban bakaran dan korban sembelihan bagi bangsa itu dan bertugas bagi bangsa itu untuk melayaninya."
 },
 {
   "id": 21616,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 12,
   "firman": "Oleh karena mereka telah melayani bangsa itu di hadapan berhala-berhala mereka, dan mereka bagi kaum Israel telah menjadi batu sandungan, yang menjatuhkannya ke dalam kesalahan, oleh karena itu Aku bersumpah mengenai mereka, demikianlah firman Tuhan ALLAH, bahwa mereka akan menanggung hukumannya sendiri."
 },
 {
   "id": 21617,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 13,
   "firman": "Mereka tidak akan mendekati Aku untuk melaksanakan tugas imam di hadapan-Ku ataupun mendekati segala barang-Ku yang kudus atau persembahan-persembahan maha kudus; mereka akan menanggung nodanya yang timbul karena perbuatan-perbuatan mereka yang keji."
 },
 {
   "id": 21618,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 14,
   "firman": "Aku menetapkan mereka untuk bertugas di Bait Suci dan melakukan segala pelayanan yang berhubungan dengan itu dan melakukan segala sesuatu yang perlu di situ."
 },
 {
   "id": 21619,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 15,
   "firman": "Tetapi mengenai imam-imam orang Lewi dari bani Zadok yang menjalankan tugas-tugas di tempat kudus-Ku waktu orang Israel sesat dari pada-Ku, merekalah yang akan mendekat kepada-Ku untuk menyelenggarakan kebaktian dan bertugas di hadapan-Ku untuk mempersembahkan kepada-Ku lemak dan darah, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21620,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 16,
   "firman": "Merekalah yang akan masuk ke dalam tempat kudus-Ku dan yang akan mendekati meja-Ku untuk menyelenggarakan kebaktian dan mereka akan menjalankan tugasnya terhadap Aku."
 },
 {
   "id": 21621,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 17,
   "firman": "Maka kalau mereka hendak masuk dari pintu-pintu gerbang pelataran dalam, mereka harus mengenakan pakaian lenan; mereka tidak boleh memakai pakaian bulu domba waktu mereka bertugas di pintu-pintu gerbang pelataran dalam atau waktu menyelenggarakan kebaktian dalam Bait Suci."
 },
 {
   "id": 21622,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 18,
   "firman": "Mereka harus memakai destar lenan dan memakai celana lenan, tetapi jangan memakai ikat pinggang yang menimbulkan keringat."
 },
 {
   "id": 21623,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 19,
   "firman": "Dan waktu mereka keluar ke pelataran luar menjumpai umat TUHAN itu, mereka harus menanggalkan pakaian mereka yang mereka pakai dalam menyelenggarakan kebaktian dan menyimpannya dalam bilik-bilik kudus, kemudian mengenakan pakaian yang lain, supaya umat itu jangan menjadi kudus disebabkan kena kepada pakaian imam-imam itu."
 },
 {
   "id": 21624,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 20,
   "firman": "Rambut mereka tidak boleh dicukur atau dibiarkan tumbuh panjang, melainkan harus dipotong pendek."
 },
 {
   "id": 21625,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 21,
   "firman": "Imam-imam tidak boleh minum anggur, kalau mereka hendak masuk dalam pelataran dalam."
 },
 {
   "id": 21626,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 22,
   "firman": "Janda atau seorang perempuan yang telah diceraikan oleh suaminya jangan mereka ambil menjadi isteri, tetapi hanya seorang perawan dari keturunan kaum Israel, atau seorang janda imam boleh mereka ambil."
 },
 {
   "id": 21627,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 23,
   "firman": "Mereka harus mengajar umat-Ku tentang perbedaan antara yang kudus dengan yang tidak kudus dan memberitahukan kepada mereka perbedaan antara yang najis dengan yang tahir."
 },
 {
   "id": 21628,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 24,
   "firman": "Di dalam sesuatu perkara mereka harus bertindak sebagai hakim dan mereka harus menghakiminya menurut peraturan-peraturan-Ku; mereka harus berpegang pada hukum-hukum-Ku dan ketetapan-ketetapan-Ku pada hari-hari raya-Ku dan menguduskan hari-hari Sabat-Ku."
 },
 {
   "id": 21629,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 25,
   "firman": "Mereka tidak boleh melihat orang mati oleh karena dengan demikian mereka menjadi najis. Hanya dengan mayat bapaknya atau ibunya, anaknya lelaki atau perempuan, kakak adiknya lelaki, kakak adiknya perempuan yang belum kawin, mereka boleh menajiskan dirinya."
 },
 {
   "id": 21630,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 26,
   "firman": "Sesudah pentahirannya ia harus menghitung tujuh hari,"
 },
 {
   "id": 21631,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 27,
   "firman": "dan pada hari ia masuk lagi ke tempat kudus, ke pelataran dalam, untuk menyelenggarakan kebaktian di tempat kudus, ia harus mempersembahkan korban penghapus dosanya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21632,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 28,
   "firman": "Mereka tidak mendapat bagian milik pusaka, sebab Akulah milik pusakanya, dan janganlah berikan kepada mereka tanah milik di Israel, sebab Akulah milik mereka."
 },
 {
   "id": 21633,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 29,
   "firman": "Persembahan, korban penghapus dosa dan korban penebus salah, merekalah yang harus memakannya dan segala yang dikhususkan di tanah Israel adalah bagian mereka."
 },
 {
   "id": 21634,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 30,
   "firman": "Dan yang terbaik dari buah sulung apapun dan segala persembahan khusus dari apapun, dari segala persembahan khususmu adalah bagian imam-imam; juga yang terbaik dari tepung jelaimu harus kamu berikan kepada imam supaya rumah-rumahmu mendapat berkat."
 },
 {
   "id": 21635,
   "kitab": "Yeh",
   "pasal": 44,
   "ayat": 31,
   "firman": "Segala burung atau binatang yang sudah mati atau yang menjadi sisa mangsa binatang buas janganlah dimakan oleh imam-imam.\""
 },
 {
   "id": 21636,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 1,
   "firman": "\"Pada waktu kamu membagi-bagi negeri itu menjadi milik pusakamu dengan jalan mengundi, kamu harus mengkhususkan sebidang dari tanah itu menjadi persembahan khusus yang kudus bagi TUHAN, panjangnya dua puluh lima ribu hasta dan lebarnya dua puluh ribu hasta. Seluruh tanah yang di dalam batas ini adalah kudus."
 },
 {
   "id": 21637,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 2,
   "firman": "Dari tanah ini harus disediakan untuk tempat kudus suatu empat persegi yang panjang dan lebarnya lima ratus hasta dan sekelilingnya ada lapangan yang lebarnya lima puluh hasta."
 },
 {
   "id": 21638,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 3,
   "firman": "Dari daerah yang sudah diukur ini ukurlah sebagian yang panjangnya dua puluh lima ribu hasta dan lebarnya sepuluh ribu hasta: di situlah letaknya tempat kudus, dan bagian ini adalah maha kudus."
 },
 {
   "id": 21639,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 4,
   "firman": "Ini adalah bagian yang kudus dari tanah itu dan menjadi tempat bagi imam-imam yang menyelenggarakan kebaktian di tempat kudus, yang datang mendekat untuk melayani TUHAN. Itulah tempat perumahan mereka dan menjadi daerah kudus untuk tempat kudus."
 },
 {
   "id": 21640,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 5,
   "firman": "Yang dua puluh lima ribu hasta panjangnya dan sepuluh ribu hasta lebarnya harus menjadi milik orang-orang Lewi yang mendapat tugas pelayanan dalam Bait Suci; itulah kota-kotanya, tempat tinggal mereka."
 },
 {
   "id": 21641,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 6,
   "firman": "Sebagai milik kota harus engkau tentukan: lima ribu hasta lebarnya dan dua puluh lima ribu hasta panjangnya, berbatasan dengan persembahan khusus yang kudus itu. Itulah untuk seluruh kaum Israel."
 },
 {
   "id": 21642,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 7,
   "firman": "Mengenai bagian raja itu haruslah terdapat di sebelah barat dan di sebelah timur dari persembahan khusus yang kudus dan milik kota itu dan harus berbatasan dengan kedua bagian itu. Yang di sebelah barat harus sampai ke perbatasan barat dan yang di sebelah timur harus sampai ke perbatasan timur. Jadi panjangnya harus sama dengan panjang dari bagian suatu suku Israel, yaitu dari perbatasan barat sampai perbatasan timur negeri itu."
 },
 {
   "id": 21643,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 8,
   "firman": "Itulah yang menjadi miliknya di tanah Israel. Dan raja-raja Israel tidak lagi akan menindas umat-Ku; mereka akan menyerahkan negeri itu kepada kaum Israel menurut suku-suku mereka.\""
 },
 {
   "id": 21644,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 9,
   "firman": "Beginilah firman Tuhan ALLAH: \"Cukuplah itu, hai raja-raja Israel, jauhkanlah kekerasan dan aniaya, tetapi lakukanlah keadilan dan kebenaran; hentikanlah kekerasanmu yang mengusir umat-Ku dari tanah miliknya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21645,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 10,
   "firman": "Neraca yang betul, efa yang betul dan bat yang betullah patut ada padamu."
 },
 {
   "id": 21646,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 11,
   "firman": "Sepatutnyalah efa dan bat mempunyai ukuran yang sama yang ditera, sehingga satu bat isinya sepersepuluh homer, dan satu efa ialah sepersepuluh homer juga; jadi menurut homerlah ukuran-ukuran itu ditera."
 },
 {
   "id": 21647,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 12,
   "firman": "Bagi kamu satu syikal sepatutnya sama dengan dua puluh gera, lima syikal, ya lima syikal dan sepuluh syikal, ya sepuluh syikal, dan lima puluh syikal adalah satu mina."
 },
 {
   "id": 21648,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 13,
   "firman": "Inilah persembahan khusus yang kamu harus persembahkan: seperenam efa dari sehomer gandum dan seperenam efa dari sehomer jelai."
 },
 {
   "id": 21649,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 14,
   "firman": "Tentang ketetapan mengenai minyak: sepersepuluh bat dari satu kor; satu kor adalah sama dengan sepuluh bat."
 },
 {
   "id": 21650,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 15,
   "firman": "Seekor anak domba dari setiap dua ratus ekor milik sesuatu kaum keluarga Israel. Semuanya itu untuk korban sajian, korban bakaran dan korban keselamatan untuk mengadakan pendamaian bagi mereka, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21651,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 16,
   "firman": "Seluruh penduduk negeri harus mempersembahkan persembahan khusus ini kepada raja di Israel."
 },
 {
   "id": 21652,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 17,
   "firman": "Dan rajalah yang bertanggung jawab mengenai korban bakaran, korban sajian, korban curahan pada hari-hari raya, bulan-bulan baru, hari-hari Sabat dan pada setiap perayaan kaum Israel. Ialah yang akan mengolah korban penghapus dosa, korban sajian, korban bakaran dan korban keselamatan untuk mengadakan pendamaian bagi kaum Israel.\""
 },
 {
   "id": 21653,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 18,
   "firman": "Beginilah firman Tuhan ALLAH: \"Pada bulan yang pertama, pada tanggal satu bulan itu ambillah seekor lembu jantan muda yang tidak bercela dan sucikanlah tempat kudus itu."
 },
 {
   "id": 21654,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 19,
   "firman": "Imam harus mengambil sedikit dari darah korban penghapus dosa dan membubuhnya pada tiang-tiang Bait Suci dan pada keempat sudut jalur keliling yang ada pada mezbah dan pada tiang-tiang pintu gerbang pelataran dalam."
 },
 {
   "id": 21655,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 20,
   "firman": "Demikianlah engkau harus perbuat pada hari pertama bulan yang ketujuh demi orang-orang yang berbuat dosa dengan tidak sengaja dan tanpa diketahui. Dengan demikian engkau mengadakan pendamaian bagi Bait Suci."
 },
 {
   "id": 21656,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 21,
   "firman": "Pada bulan pertama, pada tanggal empat belas bulan itu haruslah kamu merayakan hari raya Paskah, dan selama tujuh hari kamu harus makan roti yang tidak beragi."
 },
 {
   "id": 21657,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 22,
   "firman": "Pada hari itu raja harus mengolah lembu jantan sebagai korban penghapus dosa karena dirinya dan karena seluruh penduduk negeri."
 },
 {
   "id": 21658,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 23,
   "firman": "Selama tujuh hari hari raya itu ia harus mengolah korban bakaran bagi TUHAN: tiap hari tujuh ekor lembu jantan dan tujuh ekor domba jantan yang tidak bercela dan untuk korban penghapus dosa tiap hari seekor kambing jantan."
 },
 {
   "id": 21659,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 24,
   "firman": "Sebagai korban sajian ia harus mengolah satu efa tepung dengan seekor lembu dan satu efa tepung dengan seekor domba jantan dan minyak satu hin untuk satu efa."
 },
 {
   "id": 21660,
   "kitab": "Yeh",
   "pasal": 45,
   "ayat": 25,
   "firman": "Pada bulan ketujuh, pada tanggal lima belas bulan itu, yaitu pada hari raya, ia harus mengolah seperti ini selama tujuh hari: korban penghapus dosa, korban bakaran, korban sajian dan minyak."
 },
 {
   "id": 21661,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 1,
   "firman": "Beginilah firman Tuhan ALLAH: Pintu gerbang pelataran dalam yang menghadap ke sebelah timur haruslah tertutup selama enam hari kerja, tetapi pada hari Sabat supaya dibuka; pada hari bulan baru juga supaya dibuka."
 },
 {
   "id": 21662,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 2,
   "firman": "Raja itu akan masuk dari luar melalui balai gerbang dan akan berdiri dekat tiang pintu gerbang itu. Sementara itu imam-imam akan mengolah korban bakaran dan korban keselamatan raja itu dan ia akan sujud menyembah di ambang pintu gerbang itu, lalu keluar lagi. Dan pintu gerbang itu tidak boleh ditutup sampai petang hari."
 },
 {
   "id": 21663,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 3,
   "firman": "Penduduk negeri juga harus turut sujud menyembah di hadapan TUHAN di pintu gerbang itu pada hari Sabat dan hari bulan baru."
 },
 {
   "id": 21664,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 4,
   "firman": "Korban bakaran yang harus dipersembahkan raja itu kepada TUHAN pada hari Sabat ialah enam ekor domba yang tidak bercela dan seekor domba jantan yang tidak bercela."
 },
 {
   "id": 21665,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 5,
   "firman": "Korban sajian dari domba jantan harus diolah dengan satu efa tepung, tetapi korban sajian dari domba-domba yang lain bergantung pada kemampuannya, serta minyak satu hin untuk satu efa."
 },
 {
   "id": 21666,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 6,
   "firman": "Pada bulan baru harus dipersembahkan seekor lembu jantan muda yang tiada bercela, serta enam ekor domba dan seekor domba jantan yang tiada bercela."
 },
 {
   "id": 21667,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 7,
   "firman": "Sebagai korban sajian ia harus mengolah satu efa tepung dengan seekor lembu dan satu efa tepung dengan seekor domba jantan, tetapi korban sajian dari domba-domba lain bergantung pada kemampuannya, serta minyak satu hin untuk satu efa."
 },
 {
   "id": 21668,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 8,
   "firman": "Kalau raja hendak masuk ke dalam, ia harus masuk melalui balai gerbang dan keluar dari situ juga."
 },
 {
   "id": 21669,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 9,
   "firman": "Tetapi kalau penduduk negeri pada perayaan-perayaan yang tetap berkumpul di hadapan TUHAN, dan yang masuk melalui pintu gerbang utara untuk turut sujud menyembah biarlah mereka keluar melalui pintu gerbang selatan, dan yang masuk melalui pintu gerbang selatan, biarlah keluar melalui pintu gerbang utara. Janganlah seorang kembali melalui pintu gerbang kemasukannya, tetapi masing-masing harus keluar dari pintu gerbang yang di depannya."
 },
 {
   "id": 21670,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 10,
   "firman": "Mengenai raja itu, ia akan masuk bersama-sama mereka dan keluar bersama-sama mereka."
 },
 {
   "id": 21671,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 11,
   "firman": "Pada hari-hari raya dan perayaan-perayaan yang tetap harus ada korban sajian, yaitu satu efa tepung diolah dengan seekor lembu jantan dan satu efa tepung diolah dengan seekor domba jantan, tetapi korban sajian dari domba-domba yang lain bergantung pada kemampuannya, serta minyak satu hin untuk satu efa."
 },
 {
   "id": 21672,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 12,
   "firman": "Kalau raja mengolah korban bakaran sukarela atau korban keselamatan sukarela bagi TUHAN, maka orang harus membukakan pintu gerbang sebelah timur untuk dia dan ia akan mempersembahkan korban bakarannya dan korban keselamatannya itu seperti ia perbuat pada hari Sabat. Kemudian ia keluar, dan sesudah ia keluar pintu gerbang harus ditutup."
 },
 {
   "id": 21673,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 13,
   "firman": "Tiap hari ia harus mengolah domba yang berumur satu tahun dan yang tiada bercela sebagai korban bakaran bagi TUHAN; setiap pagi ia harus melakukan itu."
 },
 {
   "id": 21674,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 14,
   "firman": "Di samping itu setiap pagi ia harus mempersembahkan korban sajian seperenam efa tepung dengan minyak sepertiga hin untuk mencampur tepung yang terbaik itu; itulah korban sajian bagi TUHAN, dan ketetapan itu tetap selama-lamanya."
 },
 {
   "id": 21675,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 15,
   "firman": "Demikianlah mereka harus mempersembahkan domba dan korban sajian dan minyak setiap pagi sebagai korban bakaran yang tetap."
 },
 {
   "id": 21676,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 16,
   "firman": "Beginilah firman Tuhan ALLAH: Kalau raja itu memberi sesuatu pemberian dari milik pusakanya kepada salah seorang anaknya, maka itu menjadi kepunyaan anaknya, dan milik ini menjadi pusaka mereka."
 },
 {
   "id": 21677,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 17,
   "firman": "Kalau ia memberikan pemberian dari milik pusakanya kepada salah seorang hambanya, maka itu menjadi kepunyaannya sampai tahun kebebasan, lalu harus kembali kepada raja itu; hanya anak-anak raja itu boleh mewarisi milik pusakanya."
 },
 {
   "id": 21678,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 18,
   "firman": "Dan janganlah raja itu mengambil sesuatu dari milik pusaka rakyat, sehingga mereka terdesak dari miliknya; hanya dari miliknya boleh ia mewariskan kepada anak-anaknya supaya jangan seorangpun dari umat-Ku didesak dari miliknya.\""
 },
 {
   "id": 21679,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 19,
   "firman": "Lalu dibawanya aku melalui pintu masuk yang di samping pintu gerbang ke bilik-bilik untuk para imam yang di sebelah utara tempat kudus, dan sungguh, di sana di bahagian barat sekali ada suatu tempat."
 },
 {
   "id": 21680,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 20,
   "firman": "Ia berkata kepadaku: \"Di sinilah tempatnya imam-imam memasak korban penebus salah dan korban penghapus dosa dan membakar korban sajian, dan mereka tidak boleh membawanya ke pelataran luar, supaya dengan demikian mereka jangan menguduskan umat TUHAN.\""
 },
 {
   "id": 21681,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 21,
   "firman": "Kemudian diiringnya aku ke pelataran luar dan membiarkan aku pergi ke keempat sudut pelataran itu, sungguh, di tiap sudut pelataran itu ada lagi pelataran."
 },
 {
   "id": 21682,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 22,
   "firman": "Pada keempat sudut pelataran itu ada pelataran-pelataran kecil, empat puluh hasta panjangnya dan tiga puluh hasta lebarnya, keempatnya sama ukurannya."
 },
 {
   "id": 21683,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 23,
   "firman": "Mengelilingi keempat pelataran kecil itu ada tembok batu dan di bagian bawah tembok-tembok batu itu sekelilingnya diperbuat tempat-tempat memasak."
 },
 {
   "id": 21684,
   "kitab": "Yeh",
   "pasal": 46,
   "ayat": 24,
   "firman": "Ia berkata kepadaku: \"Inilah dapur tempat memasak, di mana petugas-petugas Bait Suci memasak korban sembelihan umat TUHAN.\""
 },
 {
   "id": 21685,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 1,
   "firman": "Kemudian ia membawa aku kembali ke pintu Bait Suci, dan sungguh, ada air keluar dari bawah ambang pintu Bait Suci itu dan mengalir menuju ke timur; sebab Bait Suci juga menghadap ke timur; dan air itu mengalir dari bawah bagian samping kanan dari Bait Suci itu, sebelah selatan mezbah."
 },
 {
   "id": 21686,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 2,
   "firman": "Lalu diiringnya aku ke luar melalui pintu gerbang utara dan dibawanya aku berkeliling dari luar menuju pintu gerbang luar yang menghadap ke timur, sungguh, air itu membual dari sebelah selatan."
 },
 {
   "id": 21687,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 3,
   "firman": "Sedang orang itu pergi ke arah timur dan memegang tali pengukur di tangannya, ia mengukur seribu hasta dan menyuruh aku masuk dalam air itu, maka dalamnya sampai di pergelangan kaki."
 },
 {
   "id": 21688,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 4,
   "firman": "Ia mengukur seribu hasta lagi dan menyuruh aku masuk sekali lagi dalam air itu, sekarang sudah sampai di lutut; kemudian ia mengukur seribu hasta lagi dan menyuruh aku ketiga kalinya masuk ke dalam air itu, sekarang sudah sampai di pinggang."
 },
 {
   "id": 21689,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 5,
   "firman": "Sekali lagi ia mengukur seribu hasta lagi, sekarang air itu sudah menjadi sungai, di mana aku tidak dapat berjalan lagi, sebab air itu sudah meninggi sehingga orang dapat berenang, suatu sungai yang tidak dapat diseberangi lagi."
 },
 {
   "id": 21690,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 6,
   "firman": "Lalu ia berkata kepadaku: \"Sudahkah engkau lihat, hai anak manusia?\" Kemudian ia membawa aku kembali menyusur tepi sungai."
 },
 {
   "id": 21691,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 7,
   "firman": "Dalam perjalanan pulang, sungguh, sepanjang tepi sungai itu ada amat banyak pohon, di sebelah sini dan di sebelah sana."
 },
 {
   "id": 21692,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 8,
   "firman": "Ia berkata kepadaku: \"Sungai ini mengalir menuju wilayah timur, dan menurun ke Araba-Yordan, dan bermuara di Laut Asin, air yang mengandung banyak garam dan air itu menjadi tawar,"
 },
 {
   "id": 21693,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 9,
   "firman": "sehingga ke mana saja sungai itu mengalir, segala makhluk hidup yang berkeriapan di sana akan hidup. Ikan-ikan akan menjadi sangat banyak, sebab ke mana saja air itu sampai, air laut di situ menjadi tawar dan ke mana saja sungai itu mengalir, semuanya di sana hidup."
 },
 {
   "id": 21694,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 10,
   "firman": "Maka penangkap-penangkap ikan penuh sepanjang tepinya mulai dari En-Gedi sampai En-Eglaim; daerah itu menjadi penjemuran pukat dan di sungai itu ada berjenis-jenis ikan, seperti ikan-ikan di laut besar, sangat banyak."
 },
 {
   "id": 21695,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 11,
   "firman": "Tetapi rawa-rawanya dan paya-payanya tidak menjadi tawar, itu menjadi tempat mengambil garam."
 },
 {
   "id": 21696,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 12,
   "firman": "Pada kedua tepi sungai itu tumbuh bermacam-macam pohon buah-buahan, yang daunnya tidak layu dan buahnya tidak habis-habis; tiap bulan ada lagi buahnya yang baru, sebab pohon-pohon itu mendapat air dari tempat kudus itu. Buahnya menjadi makanan dan daunnya menjadi obat.\""
 },
 {
   "id": 21697,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 13,
   "firman": "Beginilah firman Tuhan ALLAH: \"Inilah batas-batas tanah yang kamu harus bagi-bagi menjadi milik pusakamu di antara kedua belas suku Israel. Yusuf mendapat dua bagian."
 },
 {
   "id": 21698,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 14,
   "firman": "Tanah itu harus kamu bagi rata, yaitu tanah yang dengan sumpah Kujanjikan memberikannya kepada nenek moyangmu dan dengan demikian tanah ini menjadi milik pusakamu."
 },
 {
   "id": 21699,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 15,
   "firman": "Inilah perbatasan tanah itu: di sebelah utara: dari laut besar terus ke Hetlon sampai jalan masuk ke Hamat dan terus ke Zedad,"
 },
 {
   "id": 21700,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 16,
   "firman": "Berota, Sibraim, yang terletak di antara daerah kota Damsyik dan daerah kota Hamat, terus ke Hazar-Enon yang di daerah kota Hauran."
 },
 {
   "id": 21701,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 17,
   "firman": "Demikianlah perbatasannya itu mulai dari laut sampai di Hazar-Enon, sehingga daerah kota Damsyik dan juga daerah kota Hamat terletak di sebelah utaranya. Itulah sebelah utara."
 },
 {
   "id": 21702,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 18,
   "firman": "Di sebelah timur: mulai dari Hazar-Enon yang terletak di antara Hauran dan Damsyik, sungai Yordan menjadi perbatasan di antara Gilead dan tanah Israel, terus ke Laut Timur sampai ke Tamar. Itulah sebelah timur."
 },
 {
   "id": 21703,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 19,
   "firman": "Di sebelah selatan: perbatasan mulai dari Tamar sampai mata air Meriba dekat Kadesh, terus ke sungai Mesir, terus ke laut besar. Itulah di sebelah selatan perbatasan dengan Tanah Negeb."
 },
 {
   "id": 21704,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 20,
   "firman": "Di sebelah barat laut besar merupakan perbatasan sampai tempat jalan masuk ke Hamat. Itulah sebelah barat.\""
 },
 {
   "id": 21705,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 21,
   "firman": "\"Tanah inilah kamu harus bagi-bagi di antara kamu menurut suku-suku Israel."
 },
 {
   "id": 21706,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 22,
   "firman": "Dan kamu harus membagi-baginya menjadi milik pusaka di antara kamu dan di antara orang-orang asing yang tinggal di antara kamu, yang melahirkan anak di tengah-tengahmu dan mereka harus kamu anggap sama seperti orang Israel asli; bersama-sama kamu mereka harus mendapat bagian milik pusaka di tengah-tengah suku-suku Israel."
 },
 {
   "id": 21707,
   "kitab": "Yeh",
   "pasal": 47,
   "ayat": 23,
   "firman": "Jadi kalau di tengah-tengah sesuatu suku ada tinggal orang asing, di situlah kamu berikan milik pusakanya, demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 21708,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 1,
   "firman": "Inilah nama suku-suku itu: Yang paling utara: dari laut terus ke Hetlon, ke jalan masuk ke Hamat, Hazar-Enon, sehingga daerah kota Damsyik, yang berdekatan dengan Hamat, terletak di sebelah utaranya, dari perbatasan sebelah timur sampai perbatasan sebelah barat terdapat bagian Dan."
 },
 {
   "id": 21709,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 2,
   "firman": "Berbatasan dengan wilayah Dan, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Asyer."
 },
 {
   "id": 21710,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 3,
   "firman": "Berbatasan dengan wilayah Asyer, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Naftali."
 },
 {
   "id": 21711,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 4,
   "firman": "Berbatasan dengan wilayah Naftali, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Manasye."
 },
 {
   "id": 21712,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 5,
   "firman": "Berbatasan dengan wilayah Manasye, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Efraim."
 },
 {
   "id": 21713,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 6,
   "firman": "Berbatasan dengan wilayah Efraim, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Ruben."
 },
 {
   "id": 21714,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 7,
   "firman": "Berbatasan dengan wilayah Ruben, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Yehuda."
 },
 {
   "id": 21715,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 8,
   "firman": "Berbatasan dengan wilayah Yehuda, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat persembahan khusus yang harus kamu khususkan, yaitu dua puluh lima ribu hasta lebarnya, dan panjangnya sama dengan panjang satu bagian, yaitu dari perbatasan sebelah timur sampai perbatasan sebelah barat, dan di tengah-tengahnya terdapat tempat kudus."
 },
 {
   "id": 21716,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 9,
   "firman": "Bagian persembahan khusus yang harus kamu khususkan bagi TUHAN, panjangnya dua puluh lima ribu hasta dan lebarnya dua puluh ribu hasta."
 },
 {
   "id": 21717,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 10,
   "firman": "Dan bagi orang-orang inilah persembahan khusus yang kudus itu: Bagian imam-imam ialah panjangnya di utara dan selatan dua puluh lima ribu hasta, dan lebarnya di timur dan di barat sepuluh ribu hasta. Dan di tengah-tengahnyalah terletak tempat kudus TUHAN."
 },
 {
   "id": 21718,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 11,
   "firman": "Inilah bagian imam-imam, yang sudah dikuduskan, yaitu bani Zadok, yang memelihara kewajibannya terhadap Aku dan yang tidak turut sesat dalam kesesatan orang Israel, seperti orang-orang Lewi."
 },
 {
   "id": 21719,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 12,
   "firman": "Ini adalah bagian khusus bagi mereka dari tanah yang sudah dikhususkan, suatu hal yang maha kudus, berbatasan dengan bagian orang-orang Lewi."
 },
 {
   "id": 21720,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 13,
   "firman": "Bagian orang-orang Lewi ialah sejajar dengan wilayah imam-imam, panjangnya dua puluh lima ribu hasta dan lebarnya sepuluh ribu hasta. Jadi seluruhnya ialah: panjang dua puluh lima ribu hasta dan lebar dua puluh ribu hasta."
 },
 {
   "id": 21721,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 14,
   "firman": "Mereka tidak boleh menjual sedikitpun dari situ atau menukarnya, dan mereka tidak boleh mewariskan yang terbaik dari negeri itu kepada orang lain, sebab itu kudus bagi TUHAN."
 },
 {
   "id": 21722,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 15,
   "firman": "Yang tertinggal dari lebarnya, yaitu lima ribu hasta lagi, yang berbatasan dengan yang dua puluh lima ribu hasta itu adalah tidak kudus, tetapi itu untuk keperluan kota sebagai tempat tinggal dan tanah perladangan."
 },
 {
   "id": 21723,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 16,
   "firman": "Dan ukurannya adalah begini: sebelah utara dan selatan: empat ribu lima ratus hasta, sebelah timur dan barat: juga empat ribu lima ratus hasta."
 },
 {
   "id": 21724,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 17,
   "firman": "Sekeliling kota itu ada tanah lapang, di sebelah utara dan selatan dua ratus lima puluh hasta, serta di sebelah timur dan barat dua ratus lima puluh hasta juga."
 },
 {
   "id": 21725,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 18,
   "firman": "Yang tertinggal dari panjangnya, yang sejajar dengan persembahan khusus yang kudus itu, adalah sepuluh ribu hasta di sebelah timur dan sepuluh ribu hasta di sebelah barat dan hasilnya ialah menjadi makanan untuk pekerja-pekerja di kota itu."
 },
 {
   "id": 21726,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 19,
   "firman": "Pekerja-pekerja ini, yang datang dari semua suku Israel, akan mengerjakannya."
 },
 {
   "id": 21727,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 20,
   "firman": "Seluruh persembahan khusus itu adalah dua puluh lima ribu hasta kali dua puluh lima ribu hasta. Dalam bentuk empat persegi kamu harus mengkhususkan persembahan khusus yang kudus itu bersama milik kota itu."
 },
 {
   "id": 21728,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 21,
   "firman": "Selebihnya adalah milik raja, yaitu di sebelah timur dan barat dari persembahan khusus yang kudus dan milik kota itu, dan berbatasan dengan yang dua puluh lima ribu hasta itu, ke timur sampai di perbatasan timur dan ke barat sampai di perbatasan barat dan sejajar dengan bagian suku-suku lain, adalah untuk raja. Di tengah-tengah bagian itu adalah persembahan khusus yang kudus dan Bait Suci."
 },
 {
   "id": 21729,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 22,
   "firman": "Terkecuali milik orang-orang Lewi dan milik kota itu--yang terletak di tengah-tengah kepunyaan raja itu--maka yang diapit oleh wilayah Yehuda dan Benyamin adalah bagi raja."
 },
 {
   "id": 21730,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 23,
   "firman": "Mengenai suku-suku yang lain: dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Benyamin."
 },
 {
   "id": 21731,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 24,
   "firman": "Berbatasan dengan wilayah Benyamin, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Simeon."
 },
 {
   "id": 21732,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 25,
   "firman": "Berbatasan dengan wilayah Simeon, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Isakhar."
 },
 {
   "id": 21733,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 26,
   "firman": "Berbatasan dengan wilayah Isakhar, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Zebulon."
 },
 {
   "id": 21734,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 27,
   "firman": "Berbatasan dengan wilayah Zebulon, dari perbatasan sebelah timur sampai perbatasan sebelah barat, terdapat bagian Gad."
 },
 {
   "id": 21735,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 28,
   "firman": "Perbatasan wilayah Gad di sebelah selatan ialah dari Tamar sampai mata air Meriba dekat Kadesh, terus ke sungai Mesir, terus ke laut besar."
 },
 {
   "id": 21736,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 29,
   "firman": "Inilah negeri yang harus kamu bagi-bagi menjadi milik pusakamu di antara suku-suku Israel, dan itulah bagian-bagian mereka, demikianlah firman Tuhan ALLAH.\""
 },
 {
   "id": 21737,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 30,
   "firman": "\"Inilah pintu-pintu keluar kota itu: di sisi sebelah utara, yang ukurannya adalah empat ribu lima ratus hasta,"
 },
 {
   "id": 21738,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 31,
   "firman": "terdapat tiga pintu gerbang, yaitu pintu gerbang Ruben, pintu gerbang Yehuda dan pintu gerbang Lewi--sebab pintu-pintu gerbang kota itu disebut menurut nama suku-suku Israel--."
 },
 {
   "id": 21739,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 32,
   "firman": "Di sisi sebelah timur, yang ukurannya empat ribu lima ratus hasta, terdapat tiga pintu gerbang juga, yaitu pintu gerbang Yusuf, pintu gerbang Benyamin dan pintu gerbang Dan."
 },
 {
   "id": 21740,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 33,
   "firman": "Di sisi sebelah selatan, yang ukurannya empat ribu lima ratus hasta, terdapat tiga pintu gerbang juga, yaitu pintu gerbang Simeon, pintu gerbang Isakhar dan pintu gerbang Zebulon."
 },
 {
   "id": 21741,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 34,
   "firman": "Di sisi sebelah barat, yang ukurannya empat ribu lima ratus hasta, terdapat tiga pintu gerbang juga, yaitu pintu gerbang Gad, pintu gerbang Asyer dan pintu gerbang Naftali."
 },
 {
   "id": 21742,
   "kitab": "Yeh",
   "pasal": 48,
   "ayat": 35,
   "firman": "Jadi keliling kota itu adalah delapan belas ribu hasta. Sejak hari itu nama kota itu ialah: TUHAN HADIR DI SITU.\""
 },
 {
   "id": 21743,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada tahun yang ketiga pemerintahan Yoyakim, raja Yehuda, datanglah Nebukadnezar, raja Babel, ke Yerusalem, lalu mengepung kota itu."
 },
 {
   "id": 21744,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 2,
   "firman": "Tuhan menyerahkan Yoyakim, raja Yehuda, dan sebagian dari perkakas-perkakas di rumah Allah ke dalam tangannya. Semuanya itu dibawanya ke tanah Sinear, ke dalam rumah dewanya; perkakas-perkakas itu dibawanya ke dalam perbendaharaan dewanya."
 },
 {
   "id": 21745,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 3,
   "firman": "Lalu raja bertitah kepada Aspenas, kepala istananya, untuk membawa beberapa orang Israel, yang berasal dari keturunan raja dan dari kaum bangsawan,"
 },
 {
   "id": 21746,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 4,
   "firman": "yakni orang-orang muda yang tidak ada sesuatu cela, yang berperawakan baik, yang memahami berbagai-bagai hikmat, berpengetahuan banyak dan yang mempunyai pengertian tentang ilmu, yakni orang-orang yang cakap untuk bekerja dalam istana raja, supaya mereka diajarkan tulisan dan bahasa orang Kasdim."
 },
 {
   "id": 21747,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan raja menetapkan bagi mereka pelabur setiap hari dari santapan raja dan dari anggur yang biasa diminumnya. Mereka harus dididik selama tiga tahun, dan sesudah itu mereka harus bekerja pada raja."
 },
 {
   "id": 21748,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 6,
   "firman": "Di antara mereka itu ada juga beberapa orang Yehuda, yakni Daniel, Hananya, Misael dan Azarya."
 },
 {
   "id": 21749,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 7,
   "firman": "Pemimpin pegawai istana itu memberi nama lain kepada mereka: Daniel dinamainya Beltsazar, Hananya dinamainya Sadrakh, Misael dinamainya Mesakh dan Azarya dinamainya Abednego."
 },
 {
   "id": 21750,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 8,
   "firman": "Daniel berketetapan untuk tidak menajiskan dirinya dengan santapan raja dan dengan anggur yang biasa diminum raja; dimintanyalah kepada pemimpin pegawai istana itu, supaya ia tak usah menajiskan dirinya."
 },
 {
   "id": 21751,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 9,
   "firman": "Maka Allah mengaruniakan kepada Daniel kasih dan sayang dari pemimpin pegawai istana itu;"
 },
 {
   "id": 21752,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 10,
   "firman": "tetapi berkatalah pemimpin pegawai istana itu kepada Daniel: \"Aku takut, kalau-kalau tuanku raja, yang telah menetapkan makanan dan minumanmu, berpendapat bahwa kamu kelihatan kurang sehat dari pada orang-orang muda lain yang sebaya dengan kamu, sehingga karena kamu aku dianggap bersalah oleh raja.\""
 },
 {
   "id": 21753,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 11,
   "firman": "Kemudian berkatalah Daniel kepada penjenang yang telah diangkat oleh pemimpin pegawai istana untuk mengawasi Daniel, Hananya, Misael dan Azarya:"
 },
 {
   "id": 21754,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 12,
   "firman": "\"Adakanlah percobaan dengan hamba-hambamu ini selama sepuluh hari dan biarlah kami diberikan sayur untuk dimakan dan air untuk diminum;"
 },
 {
   "id": 21755,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 13,
   "firman": "sesudah itu bandingkanlah perawakan kami dengan perawakan orang-orang muda yang makan dari santapan raja, kemudian perlakukanlah hamba-hambamu ini sesuai dengan pendapatmu.\""
 },
 {
   "id": 21756,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 14,
   "firman": "Didengarkannyalah permintaan mereka itu, lalu diadakanlah percobaan dengan mereka selama sepuluh hari."
 },
 {
   "id": 21757,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 15,
   "firman": "Setelah lewat sepuluh hari, ternyata perawakan mereka lebih baik dan mereka kelihatan lebih gemuk dari pada semua orang muda yang telah makan dari santapan raja."
 },
 {
   "id": 21758,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 16,
   "firman": "Kemudian penjenang itu selalu mengambil makanan mereka dan anggur yang harus mereka minum, lalu memberikan sayur kepada mereka."
 },
 {
   "id": 21759,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 17,
   "firman": "Kepada keempat orang muda itu Allah memberikan pengetahuan dan kepandaian tentang berbagai-bagai tulisan dan hikmat, sedang Daniel juga mempunyai pengertian tentang berbagai-bagai penglihatan dan mimpi."
 },
 {
   "id": 21760,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 18,
   "firman": "Setelah lewat waktu yang ditetapkan raja, bahwa mereka sekalian harus dibawa menghadap, maka dibawalah mereka oleh pemimpin pegawai istana itu ke hadapan Nebukadnezar."
 },
 {
   "id": 21761,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 19,
   "firman": "Raja bercakap-cakap dengan mereka; dan di antara mereka sekalian itu tidak didapati yang setara dengan Daniel, Hananya, Misael dan Azarya; maka bekerjalah mereka itu pada raja."
 },
 {
   "id": 21762,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 20,
   "firman": "Dalam tiap-tiap hal yang memerlukan kebijaksanaan dan pengertian, yang ditanyakan raja kepada mereka, didapatinya bahwa mereka sepuluh kali lebih cerdas dari pada semua orang berilmu dan semua ahli jampi di seluruh kerajaannya."
 },
 {
   "id": 21763,
   "kitab": "Dan",
   "pasal": 1,
   "ayat": 21,
   "firman": "Daniel ada di sana sampai tahun pertama pemerintahan Koresh."
 },
 {
   "id": 21764,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pada tahun yang kedua pemerintahan Nebukadnezar bermimpilah Nebukadnezar; karena itu hatinya gelisah dan ia tidak dapat tidur."
 },
 {
   "id": 21765,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu raja menyuruh memanggil orang-orang berilmu, ahli jampi, ahli sihir dan para Kasdim, untuk menerangkan kepadanya tentang mimpinya itu; maka datanglah mereka dan berdiri di hadapan raja."
 },
 {
   "id": 21766,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 3,
   "firman": "Kata raja kepada mereka: \"Aku bermimpi, dan hatiku gelisah, karena ingin mengetahui mimpi itu.\""
 },
 {
   "id": 21767,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 4,
   "firman": "Lalu berkatalah para Kasdim itu kepada raja (dalam bahasa Aram): \"Ya raja, kekallah hidupmu! Ceriterakanlah kepada hamba-hambamu mimpi itu, maka kami akan memberitahukan maknanya.\""
 },
 {
   "id": 21768,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi raja menjawab para Kasdim itu: \"Aku telah mengambil keputusan, yakni jika kamu tidak memberitahukan kepadaku mimpi itu dengan maknanya, maka kamu akan dipenggal-penggal dan rumah-rumahmu akan dirobohkan menjadi timbunan puing;"
 },
 {
   "id": 21769,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 6,
   "firman": "tetapi jika kamu dapat memberitahukan mimpi itu dengan maknanya, maka kamu akan menerima hadiah, pemberian-pemberian dan kehormatan yang besar dari padaku. Oleh sebab itu beritahukanlah kepadaku mimpi itu dengan maknanya!\""
 },
 {
   "id": 21770,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 7,
   "firman": "Mereka menjawab pula: \"Silakan tuanku raja menceriterakan mimpi itu kepada hamba-hambanya ini, maka kami akan memberitahukan maknanya.\""
 },
 {
   "id": 21771,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 8,
   "firman": "Jawab raja: \"Aku tahu benar-benar, bahwa kamu mencoba mengulur-ulur waktu, karena kamu melihat, bahwa aku telah mengambil keputusan,"
 },
 {
   "id": 21772,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 9,
   "firman": "yakni jika kamu tidak dapat memberitahukan kepadaku mimpi itu, maka kamu akan kena hukuman yang sama; dan aku tahu bahwa kamu telah bermufakat untuk mengatakan kepadaku hal-hal yang bohong dan busuk, sampai keadaan berubah. Oleh sebab itu ceriterakanlah kepadaku mimpi itu, supaya aku tahu, bahwa kamu dapat memberitahukan maknanya juga kepadaku.\""
 },
 {
   "id": 21773,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 10,
   "firman": "Para Kasdim itu menjawab raja: \"Tidak ada seorangpun di muka bumi yang dapat memberitahukan apa yang diminta tuanku raja! Dan tidak pernah seorang raja, bagaimanapun agungnya dan besar kuasanya, telah meminta hal sedemikian dari seorang berilmu atau seorang ahli jampi atau seorang Kasdim."
 },
 {
   "id": 21774,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 11,
   "firman": "Apa yang diminta tuanku raja adalah terlalu berat, dan tidak ada seorangpun yang dapat memberitahukannya kepada tuanku raja, selain dari dewa-dewa yang tidak berdiam di antara manusia.\""
 },
 {
   "id": 21775,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 12,
   "firman": "Maka raja menjadi sangat geram dan murka karena hal itu, lalu dititahkannyalah untuk melenyapkan semua orang bijaksana di Babel."
 },
 {
   "id": 21776,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 13,
   "firman": "Ketika titah dikeluarkan supaya orang-orang bijaksana dibunuh, maka Daniel dan teman-temannyapun terancam akan dibunuh."
 },
 {
   "id": 21777,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lalu berkatalah Daniel dengan cerdik dan bijaksana kepada Ariokh, pemimpin pengawal raja yang telah pergi untuk membunuh orang-orang bijaksana di Babel itu,"
 },
 {
   "id": 21778,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 15,
   "firman": "katanya kepada Ariokh, pembesar raja itu: \"Mengapa titah yang begitu keras ini dikeluarkan oleh raja?\" Lalu Ariokh memberitahukan hal itu kepada Daniel."
 },
 {
   "id": 21779,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 16,
   "firman": "Maka Daniel menghadap raja dan meminta kepadanya, supaya ia diberi waktu untuk memberitahukan makna itu kepada raja."
 },
 {
   "id": 21780,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 17,
   "firman": "Kemudian pulanglah Daniel dan memberitahukan hal itu kepada Hananya, Misael dan Azarya, teman-temannya,"
 },
 {
   "id": 21781,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 18,
   "firman": "dengan maksud supaya mereka memohon kasih sayang kepada Allah semesta langit mengenai rahasia itu, supaya Daniel dan teman-temannya jangan dilenyapkan bersama-sama orang-orang bijaksana yang lain di Babel."
 },
 {
   "id": 21782,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 19,
   "firman": "Maka rahasia itu disingkapkan kepada Daniel dalam suatu penglihatan malam. Lalu Daniel memuji Allah semesta langit."
 },
 {
   "id": 21783,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 20,
   "firman": "Berkatalah Daniel: \"Terpujilah nama Allah dari selama-lamanya sampai selama-lamanya, sebab dari pada Dialah hikmat dan kekuatan!"
 },
 {
   "id": 21784,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 21,
   "firman": "Dia mengubah saat dan waktu, Dia memecat raja dan mengangkat raja, Dia memberi hikmat kepada orang bijaksana dan pengetahuan kepada orang yang berpengertian;"
 },
 {
   "id": 21785,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 22,
   "firman": "Dialah yang menyingkapkan hal-hal yang tidak terduga dan yang tersembunyi, Dia tahu apa yang ada di dalam gelap, dan terang ada pada-Nya."
 },
 {
   "id": 21786,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 23,
   "firman": "Ya Allah nenek moyangku, kupuji dan kumuliakan Engkau, sebab Engkau mengaruniakan kepadaku hikmat dan kekuatan, dan telah memberitahukan kepadaku sekarang apa yang kami mohon kepada-Mu: Engkau telah memberitahukan kepada kami hal yang dipersoalkan raja.\""
 },
 {
   "id": 21787,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 24,
   "firman": "Sebab itu pergilah Daniel kepada Ariokh yang telah ditugaskan raja untuk melenyapkan orang-orang bijaksana di Babel; maka pergilah ia serta berkata kepadanya, demikian: \"Orang-orang bijaksana di Babel itu jangan kaulenyapkan! Bawalah aku menghadap raja, maka aku akan memberitahukan kepada raja makna itu!\""
 },
 {
   "id": 21788,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 25,
   "firman": "Ariokh segera membawa Daniel menghadap raja serta berkata kepada raja demikian: \"Aku telah mendapat seorang dari antara orang-orang buangan dari Yehuda, yang dapat memberitahukan makna itu kepada raja.\""
 },
 {
   "id": 21789,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 26,
   "firman": "Bertanyalah raja kepada Daniel yang namanya Beltsazar: \"Sanggupkah engkau memberitahukan kepadaku mimpi yang telah kulihat itu dengan maknanya juga?\""
 },
 {
   "id": 21790,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 27,
   "firman": "Daniel menjawab, katanya kepada raja: \"Rahasia, yang ditanyakan tuanku raja, tidaklah dapat diberitahukan kepada raja oleh orang bijaksana, ahli jampi, orang berilmu atau ahli nujum."
 },
 {
   "id": 21791,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 28,
   "firman": "Tetapi di sorga ada Allah yang menyingkapkan rahasia-rahasia; Ia telah memberitahukan kepada tuanku raja Nebukadnezar apa yang akan terjadi pada hari-hari yang akan datang. Mimpi dan penglihatan-penglihatan yang tuanku lihat di tempat tidur ialah ini:"
 },
 {
   "id": 21792,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 29,
   "firman": "Sedang tuanku ada di tempat tidur, ya tuanku raja, timbul pada tuanku pikiran-pikiran tentang apa yang akan terjadi di kemudian hari, dan Dia yang menyingkapkan rahasia-rahasia telah memberitahukan kepada tuanku apa yang akan terjadi."
 },
 {
   "id": 21793,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 30,
   "firman": "Adapun aku, kepadaku telah disingkapkan rahasia itu, bukan karena hikmat yang mungkin ada padaku melebihi hikmat semua orang yang hidup, tetapi supaya maknanya diberitahukan kepada tuanku raja, dan supaya tuanku mengenal pikiran-pikiran tuanku."
 },
 {
   "id": 21794,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 31,
   "firman": "Ya raja, tuanku melihat suatu penglihatan, yakni sebuah patung yang amat besar! Patung ini tinggi, berkilau-kilauan luar biasa, tegak di hadapan tuanku, dan tampak mendahsyatkan."
 },
 {
   "id": 21795,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 32,
   "firman": "Adapun patung itu, kepalanya dari emas tua, dada dan lengannya dari perak, perut dan pinggangnya dari tembaga,"
 },
 {
   "id": 21796,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 33,
   "firman": "sedang pahanya dari besi dengan kakinya sebagian dari besi dan sebagian lagi dari tanah liat."
 },
 {
   "id": 21797,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 34,
   "firman": "Sementara tuanku melihatnya, terungkit lepas sebuah batu tanpa perbuatan tangan manusia, lalu menimpa patung itu, tepat pada kakinya yang dari besi dan tanah liat itu, sehingga remuk."
 },
 {
   "id": 21798,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 35,
   "firman": "Maka dengan sekaligus diremukkannyalah juga besi, tanah liat, tembaga, perak dan emas itu, dan semuanya menjadi seperti sekam di tempat pengirikan pada musim panas, lalu angin menghembuskannya, sehingga tidak ada bekas-bekasnya yang ditemukan. Tetapi batu yang menimpa patung itu menjadi gunung besar yang memenuhi seluruh bumi."
 },
 {
   "id": 21799,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 36,
   "firman": "Itulah mimpi tuanku, dan sekarang maknanya akan kami katakan kepada tuanku raja:"
 },
 {
   "id": 21800,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 37,
   "firman": "Ya tuanku raja, raja segala raja, yang kepadanya oleh Allah semesta langit telah diberikan kerajaan, kekuasaan, kekuatan dan kemuliaan,"
 },
 {
   "id": 21801,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 38,
   "firman": "dan yang ke dalam tangannya telah diserahkan-Nya anak-anak manusia, di manapun mereka berada, binatang-binatang di padang dan burung-burung di udara, dan yang dibuat-Nya menjadi kuasa atas semuanya itu--tuankulah kepala yang dari emas itu."
 },
 {
   "id": 21802,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 39,
   "firman": "Tetapi sesudah tuanku akan muncul suatu kerajaan lain, yang kurang besar dari kerajaan tuanku; kemudian suatu kerajaan lagi, yakni yang ketiga, dari tembaga, yang akan berkuasa atas seluruh bumi."
 },
 {
   "id": 21803,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 40,
   "firman": "Sesudah itu akan ada suatu kerajaan yang keempat, yang keras seperti besi, tepat seperti besi yang meremukkan dan menghancurkan segala sesuatu; dan seperti besi yang menghancurluluhkan, maka kerajaan ini akan meremukkan dan menghancurluluhkan semuanya."
 },
 {
   "id": 21804,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 41,
   "firman": "Dan seperti tuanku lihat kaki dan jari-jarinya sebagian dari tanah liat tukang periuk dan sebagian lagi dari besi, itu berarti, bahwa kerajaan itu terbagi; memang kerajaan itu juga keras seperti besi, sesuai dengan yang tuanku lihat besi itu bercampur dengan tanah liat."
 },
 {
   "id": 21805,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 42,
   "firman": "Tetapi sebagaimana jari-jari kaki itu sebagian dari besi dan sebagian lagi dari tanah liat, demikianlah kerajaan itu akan menjadi keras sebagian dan rapuh sebagian."
 },
 {
   "id": 21806,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 43,
   "firman": "Seperti tuanku lihat besi bercampur dengan tanah liat, itu berarti: mereka akan bercampur oleh perkawinan, tetapi tidak akan merupakan satu kesatuan, seperti besi tidak dapat bercampur dengan tanah liat."
 },
 {
   "id": 21807,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 44,
   "firman": "Tetapi pada zaman raja-raja, Allah semesta langit akan mendirikan suatu kerajaan yang tidak akan binasa sampai selama-lamanya, dan kekuasaan tidak akan beralih lagi kepada bangsa lain: kerajaan itu akan meremukkan segala kerajaan dan menghabisinya, tetapi kerajaan itu sendiri akan tetap untuk selama-lamanya,"
 },
 {
   "id": 21808,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 45,
   "firman": "tepat seperti yang tuanku lihat, bahwa tanpa perbuatan tangan manusia sebuah batu terungkit lepas dari gunung dan meremukkan besi, tembaga, tanah liat, perak dan emas itu. Allah yang maha besar telah memberitahukan kepada tuanku raja apa yang akan terjadi di kemudian hari; mimpi itu adalah benar dan maknanya dapat dipercayai.\""
 },
 {
   "id": 21809,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 46,
   "firman": "Lalu sujudlah raja Nebukadnezar serta menyembah Daniel; juga dititahkannya mempersembahkan korban dan bau-bauan kepadanya."
 },
 {
   "id": 21810,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 47,
   "firman": "Berkatalah raja kepada Daniel: \"Sesungguhnyalah, Allahmu itu Allah yang mengatasi segala allah dan Yang berkuasa atas segala raja, dan Yang menyingkapkan rahasia-rahasia, sebab engkau telah dapat menyingkapkan rahasia itu.\""
 },
 {
   "id": 21811,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 48,
   "firman": "Lalu raja memuliakan Daniel: dianugerahinyalah dengan banyak pemberian yang besar, dan dibuatnya dia menjadi penguasa atas seluruh wilayah Babel dan menjadi kepala semua orang bijaksana di Babel."
 },
 {
   "id": 21812,
   "kitab": "Dan",
   "pasal": 2,
   "ayat": 49,
   "firman": "Atas permintaan Daniel, raja menyerahkan pemerintahan wilayah Babel itu kepada Sadrakh, Mesakh dan Abednego, sedang Daniel sendiri tinggal di istana raja."
 },
 {
   "id": 21813,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 1,
   "firman": "Raja Nebukadnezar membuat sebuah patung emas yang tingginya enam puluh hasta dan lebarnya enam hasta yang didirikannya di dataran Dura di wilayah Babel."
 },
 {
   "id": 21814,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu raja Nebukadnezar menyuruh orang mengumpulkan para wakil raja, para penguasa, para bupati, para penasihat negara, para bendahara, para hakim, para ahli hukum dan semua kepala daerah, untuk menghadiri pentahbisan patung yang telah didirikannya itu."
 },
 {
   "id": 21815,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 3,
   "firman": "Lalu berkumpullah para wakil raja, para penguasa, para bupati, para penasihat negara, para bendahara, para hakim, para ahli hukum dan semua kepala daerah, untuk menghadiri pentahbisan patung yang telah didirikan raja Nebukadnezar itu."
 },
 {
   "id": 21816,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 4,
   "firman": "Dan berserulah seorang bentara dengan suara nyaring: \"Beginilah dititahkan kepadamu, hai orang-orang dari segala bangsa, suku bangsa dan bahasa:"
 },
 {
   "id": 21817,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 5,
   "firman": "demi kamu mendengar bunyi sangkakala, seruling, kecapi, rebab, gambus, serdam dan berbagai-bagai jenis bunyi-bunyian, maka haruslah kamu sujud menyembah patung yang telah didirikan raja Nebukadnezar itu;"
 },
 {
   "id": 21818,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 6,
   "firman": "siapa yang tidak sujud menyembah, akan dicampakkan seketika itu juga ke dalam perapian yang menyala-nyala!\""
 },
 {
   "id": 21819,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sebab itu demi segala bangsa mendengar bunyi sangkakala, seruling, kecapi, rebab, gambus dan berbagai-bagai jenis bunyi-bunyian, maka sujudlah orang-orang dari segala bangsa, suku bangsa dan bahasa, dan menyembah patung emas yang telah didirikan raja Nebukadnezar itu."
 },
 {
   "id": 21820,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 8,
   "firman": "Pada waktu itu juga tampillah beberapa orang Kasdim menuduh orang Yahudi."
 },
 {
   "id": 21821,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 9,
   "firman": "Berkatalah mereka kepada raja Nebukadnezar: \"Ya raja, kekallah hidup tuanku!"
 },
 {
   "id": 21822,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tuanku raja telah mengeluarkan titah, bahwa setiap orang yang mendengar bunyi sangkakala, seruling, kecapi, rebab, gambus, serdam dan berbagai-bagai jenis bunyi-bunyian, harus sujud menyembah patung emas itu,"
 },
 {
   "id": 21823,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 11,
   "firman": "dan bahwa siapa yang tidak sujud menyembah, akan dicampakkan ke dalam perapian yang menyala-nyala."
 },
 {
   "id": 21824,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 12,
   "firman": "Ada beberapa orang Yahudi, yang kepada mereka telah tuanku berikan pemerintahan atas wilayah Babel, yakni Sadrakh, Mesakh dan Abednego, orang-orang ini tidak mengindahkan titah tuanku, ya raja: mereka tidak memuja dewa tuanku dan tidak menyembah patung emas yang telah tuanku dirikan.\""
 },
 {
   "id": 21825,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 13,
   "firman": "Sesudah itu Nebukadnezar memerintahkan dalam marahnya dan geramnya untuk membawa Sadrakh, Mesakh dan Abednego menghadap. Setelah orang-orang itu dibawa menghadap raja,"
 },
 {
   "id": 21826,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 14,
   "firman": "berkatalah Nebukadnezar kepada mereka: \"Apakah benar, hai Sadrakh, Mesakh dan Abednego, bahwa kamu tidak memuja dewaku dan tidak menyembah patung emas yang kudirikan itu?"
 },
 {
   "id": 21827,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 15,
   "firman": "Sekarang, jika kamu bersedia, demi kamu mendengar bunyi sangkakala, seruling, kecapi, rebab, gambus, serdam dan berbagai-bagai jenis bunyi-bunyian, sujudlah menyembah patung yang kubuat itu! Tetapi jika kamu tidak menyembah, kamu akan dicampakkan seketika itu juga ke dalam perapian yang menyala-nyala. Dan dewa manakah yang dapat melepaskan kamu dari dalam tanganku?\""
 },
 {
   "id": 21828,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 16,
   "firman": "Lalu Sadrakh, Mesakh dan Abednego menjawab raja Nebukadnezar: \"Tidak ada gunanya kami memberi jawab kepada tuanku dalam hal ini."
 },
 {
   "id": 21829,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 17,
   "firman": "Jika Allah kami yang kami puja sanggup melepaskan kami, maka Ia akan melepaskan kami dari perapian yang menyala-nyala itu, dan dari dalam tanganmu, ya raja;"
 },
 {
   "id": 21830,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 18,
   "firman": "tetapi seandainya tidak, hendaklah tuanku mengetahui, ya raja, bahwa kami tidak akan memuja dewa tuanku, dan tidak akan menyembah patung emas yang tuanku dirikan itu.\""
 },
 {
   "id": 21831,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 19,
   "firman": "Maka meluaplah kegeraman Nebukadnezar, air mukanya berubah terhadap Sadrakh, Mesakh dan Abednego; lalu diperintahkannya supaya perapian itu dibuat tujuh kali lebih panas dari yang biasa."
 },
 {
   "id": 21832,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 20,
   "firman": "Kepada beberapa orang yang sangat kuat dari tentaranya dititahkannya untuk mengikat Sadrakh, Mesakh dan Abednego dan mencampakkan mereka ke dalam perapian yang menyala-nyala itu."
 },
 {
   "id": 21833,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 21,
   "firman": "Lalu diikatlah ketiga orang itu, dengan jubah, celana, topi dan pakaian-pakaian mereka yang lain, dan dicampakkan ke dalam perapian yang menyala-nyala."
 },
 {
   "id": 21834,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 22,
   "firman": "Karena titah raja itu keras, dipanaskanlah perapian itu dengan luar biasa, sehingga nyala api itu membakar mati orang-orang yang mengangkat Sadrakh, Mesakh dan Abednego itu ke atas."
 },
 {
   "id": 21835,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 23,
   "firman": "Tetapi ketiga orang itu, yakni Sadrakh, Mesakh dan Abednego, jatuh ke dalam perapian yang menyala-nyala itu dengan terikat."
 },
 {
   "id": 21836,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 24,
   "firman": "Kemudian terkejutlah raja Nebukadnezar lalu bangun dengan segera; berkatalah ia kepada para menterinya: \"Bukankah tiga orang yang telah kita campakkan dengan terikat ke dalam api itu?\" Jawab mereka kepada raja: \"Benar, ya raja!\""
 },
 {
   "id": 21837,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 25,
   "firman": "Katanya: \"Tetapi ada empat orang kulihat berjalan-jalan dengan bebas di tengah-tengah api itu; mereka tidak terluka, dan yang keempat itu rupanya seperti anak dewa!\""
 },
 {
   "id": 21838,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 26,
   "firman": "Lalu Nebukadnezar mendekati pintu perapian yang bernyala-nyala itu; berkatalah ia: \"Sadrakh, Mesakh dan Abednego, hamba-hamba Allah yang maha tinggi, keluarlah dan datanglah ke mari!\" Lalu keluarlah Sadrakh, Mesakh dan Abednego dari api itu."
 },
 {
   "id": 21839,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 27,
   "firman": "Dan para wakil raja, para penguasa, para bupati dan para menteri raja datang berkumpul; mereka melihat, bahwa tubuh orang-orang ini tidak mempan oleh api itu, bahwa rambut di kepala mereka tidak hangus, jubah mereka tidak berubah apa-apa, bahkan bau kebakaranpun tidak ada pada mereka."
 },
 {
   "id": 21840,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 28,
   "firman": "Berkatalah Nebukadnezar: \"Terpujilah Allahnya Sadrakh, Mesakh dan Abednego! Ia telah mengutus malaikat-Nya dan melepaskan hamba-hamba-Nya, yang telah menaruh percaya kepada-Nya, dan melanggar titah raja, dan yang menyerahkan tubuh mereka, karena mereka tidak mau memuja dan menyembah allah manapun kecuali Allah mereka."
 },
 {
   "id": 21841,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 29,
   "firman": "Sebab itu aku mengeluarkan perintah, bahwa setiap orang dari bangsa, suku bangsa atau bahasa manapun ia, yang mengucapkan penghinaan terhadap Allahnya Sadrakh, Mesakh dan Abednego, akan dipenggal-penggal dan rumahnya akan dirobohkan menjadi timbunan puing, karena tidak ada allah lain yang dapat melepaskan secara demikian itu.\""
 },
 {
   "id": 21842,
   "kitab": "Dan",
   "pasal": 3,
   "ayat": 30,
   "firman": "Lalu raja memberikan kedudukan tinggi kepada Sadrakh, Mesakh dan Abednego di wilayah Babel."
 },
 {
   "id": 21843,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 1,
   "firman": "Dari raja Nebukadnezar kepada orang-orang dari segala bangsa, suku bangsa dan bahasa, yang diam di seluruh bumi: \"Bertambah-tambahlah kiranya kesejahteraanmu!"
 },
 {
   "id": 21844,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 2,
   "firman": "Aku berkenan memaklumkan tanda-tanda dan mujizat-mujizat yang telah dilakukan Allah yang maha tinggi kepadaku."
 },
 {
   "id": 21845,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 3,
   "firman": "Betapa besarnya tanda-tanda-Nya dan betapa hebatnya mujizat-mujizat-Nya! Kerajaan-Nya adalah kerajaan yang kekal dan pemerintahan-Nya turun-temurun!"
 },
 {
   "id": 21846,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 4,
   "firman": "Aku, Nebukadnezar, diam dalam rumahku dengan tenang dan hidup dengan senang dalam istanaku;"
 },
 {
   "id": 21847,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 5,
   "firman": "lalu aku mendapat mimpi yang mengejutkan aku, dan khayalanku di tempat tidurku serta penglihatan-penglihatan yang kulihat menggelisahkan aku."
 },
 {
   "id": 21848,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 6,
   "firman": "Maka aku mengeluarkan titah, bahwa semua orang bijaksana di Babel harus dibawa menghadap aku, supaya mereka memberitahukan kepadaku makna mimpi itu."
 },
 {
   "id": 21849,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 7,
   "firman": "Kemudian orang-orang berilmu, ahli jampi, para Kasdim dan ahli nujum datang menghadap dan aku menceritakan kepada mereka mimpi itu, tetapi mereka tidak dapat memberitahukan maknanya kepadaku."
 },
 {
   "id": 21850,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 8,
   "firman": "Pada akhirnya Daniel datang menghadap aku, yakni Daniel yang dinamai Beltsazar menurut nama dewaku, dan yang penuh dengan roh para dewa yang kudus. Lalu kuceritakan kepadanya mimpi itu:"
 },
 {
   "id": 21851,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 9,
   "firman": "Hai Beltsazar, kepala orang-orang berilmu! Aku tahu, bahwa engkau penuh dengan roh para dewa yang kudus, dan bahwa tidak ada rahasia yang sukar bagimu! Sebab itu inilah riwayat penglihatan mimpi yang kudapat, maka ceritakanlah kepadaku maknanya."
 },
 {
   "id": 21852,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 10,
   "firman": "Adapun penglihatan yang kudapat di tempat tidurku itu, demikian: di tengah-tengah bumi ada sebatang pohon yang sangat tinggi;"
 },
 {
   "id": 21853,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 11,
   "firman": "pohon itu bertambah besar dan kuat, tingginya sampai ke langit, dan dapat dilihat sampai ke ujung seluruh bumi."
 },
 {
   "id": 21854,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 12,
   "firman": "Daun-daunnya indah, buahnya berlimpah-limpah, padanya ada makanan bagi semua yang hidup; di bawahnya binatang-binatang di padang mencari tempat bernaung dan di dahan-dahannya bersarang burung-burung di udara, dan segala makhluk mendapat makanan dari padanya."
 },
 {
   "id": 21855,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 13,
   "firman": "Kemudian dalam penglihatan yang kudapat di tempat tidurku itu tampak seorang penjaga, seorang kudus, turun dari langit;"
 },
 {
   "id": 21856,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 14,
   "firman": "ia berseru dengan nyaring, demikian katanya: Tebanglah pohon itu dan potonglah dahan-dahannya, gugurkanlah daun-daunnya dan hamburkanlah buah-buahnya! Biarlah binatang-binatang lari dari bawahnya dan burung-burung dari dahan-dahannya!"
 },
 {
   "id": 21857,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 15,
   "firman": "Tetapi biarkanlah tunggulnya tinggal di dalam tanah, terikat dengan rantai dari besi dan tembaga, di rumput muda di padang; biarlah ia dibasahi dengan embun dari langit dan bersama-sama dengan binatang-binatang mendapat bagiannya dari rumput di bumi!"
 },
 {
   "id": 21858,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 16,
   "firman": "Biarlah hati manusianya berubah dan diberikan kepadanya hati binatang. Demikianlah berlaku atasnya sampai tujuh masa berlalu."
 },
 {
   "id": 21859,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 17,
   "firman": "Titah ini adalah menurut putusan para penjaga dan hal ini menurut perkataan orang-orang kudus, supaya orang-orang yang hidup tahu, bahwa Yang Mahatinggi berkuasa atas kerajaan manusia dan memberikannya kepada siapa yang dikehendaki-Nya, bahkan orang yang paling kecil sekalipun dapat diangkat-Nya untuk kedudukan itu."
 },
 {
   "id": 21860,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 18,
   "firman": "Itulah mimpi yang telah kudapat, aku, raja Nebukadnezar; sekarang engkau, Beltsazar, katakanlah kepadaku maknanya, sebab semua orang bijaksana dari kerajaanku tidak dapat memberitahukan maknanya kepadaku; tetapi engkaulah yang sanggup, karena engkau penuh dengan roh para dewa yang kudus!\""
 },
 {
   "id": 21861,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 19,
   "firman": "Lalu berdirilah Daniel yang namanya Beltsazar, tercengang beberapa saat, pikiran-pikirannya menggelisahkan dia. Berkatalah raja: \"Beltsazar, janganlah mimpi dan maknanya itu menggelisahkan engkau!\" Beltsazar menjawab: \"Tuanku, biarlah mimpi itu tertimpa atas musuh tuanku dan maknanya atas seteru tuanku!"
 },
 {
   "id": 21862,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 20,
   "firman": "Pohon yang tuanku lihat itu, yang bertambah besar dan kuat, yang tingginya sampai ke langit dan yang terlihat sampai ke seluruh bumi,"
 },
 {
   "id": 21863,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 21,
   "firman": "yang daun-daunnya indah dan buahnya berlimpah-limpah dan padanya ada makanan bagi semua yang hidup, yang di bawahnya ada binatang-binatang di padang dan di dahan-dahannya bersarang burung-burung di udara--"
 },
 {
   "id": 21864,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 22,
   "firman": "tuankulah itu, ya raja, tuanku yang telah bertambah besar dan kuat, yang kebesarannya bertambah sampai ke langit, dan yang kekuasaannya sampai ke ujung bumi!"
 },
 {
   "id": 21865,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 23,
   "firman": "Tentang yang tuanku raja lihat, yakni seorang penjaga, seorang kudus, yang turun dari langit, sambil berkata: Tebanglah pohon ini dan binasakanlah dia, tetapi biarkanlah tunggulnya ada di dalam tanah, terikat dengan rantai dari besi dan tembaga, di rumput muda di padang, dan biarlah ia dibasahi dengan embun dari langit dan mendapat bagiannya bersama-sama dengan binatang-binatang di padang, hingga sudah berlaku yang demikian atasnya sampai tujuh masa berlalu--"
 },
 {
   "id": 21866,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 24,
   "firman": "inilah maknanya, ya raja, dan inilah putusan Yang Mahatinggi mengenai tuanku raja:"
 },
 {
   "id": 21867,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 25,
   "firman": "tuanku akan dihalau dari antara manusia dan tempat tinggal tuanku akan ada di antara binatang-binatang di padang; kepada tuanku akan diberikan makanan rumput, seperti kepada lembu, dan tuanku akan dibasahi dengan embun dari langit; dan demikianlah akan berlaku atas tuanku sampai tujuh masa berlalu, hingga tuanku mengakui, bahwa Yang Mahatinggi berkuasa atas kerajaan manusia dan memberikannya kepada siapa yang dikehendaki-Nya."
 },
 {
   "id": 21868,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 26,
   "firman": "Yang dikatakan tentang membiarkan tunggul pohon itu, berarti: kerajaan tuanku akan kembali tuanku pegang segera sesudah tuanku mengakui, bahwa Sorgalah yang mempunyai kekuasaan."
 },
 {
   "id": 21869,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 27,
   "firman": "Jadi, ya raja, biarlah nasihatku berkenan pada hati tuanku: lepaskanlah diri tuanku dari pada dosa dengan melakukan keadilan, dan dari pada kesalahan dengan menunjukkan belas kasihan terhadap orang yang tertindas; dengan demikian kebahagiaan tuanku akan dilanjutkan!\""
 },
 {
   "id": 21870,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 28,
   "firman": "Semuanya itu terjadi atas raja Nebukadnezar;"
 },
 {
   "id": 21871,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 29,
   "firman": "sebab setelah lewat dua belas bulan, ketika ia sedang berjalan-jalan di atas istana raja di Babel,"
 },
 {
   "id": 21872,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 30,
   "firman": "berkatalah raja: \"Bukankah itu Babel yang besar itu, yang dengan kekuatan kuasaku dan untuk kemuliaan kebesaranku telah kubangun menjadi kota kerajaan?\""
 },
 {
   "id": 21873,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 31,
   "firman": "Raja belum habis bicara, ketika suatu suara terdengar dari langit: \"Kepadamu dinyatakan, ya raja Nebukadnezar, bahwa kerajaan telah beralih dari padamu;"
 },
 {
   "id": 21874,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 32,
   "firman": "engkau akan dihalau dari antara manusia dan tempat tinggalmu akan ada di antara binatang-binatang di padang; kepadamu akan diberikan makanan rumput seperti kepada lembu; dan demikianlah akan berlaku atasmu sampai tujuh masa berlalu, hingga engkau mengakui, bahwa Yang Mahatinggi berkuasa atas kerajaan manusia dan memberikannya kepada siapa yang dikehendaki-Nya!\""
 },
 {
   "id": 21875,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 33,
   "firman": "Pada saat itu juga terlaksanalah perkataan itu atas Nebukadnezar, dan ia dihalau dari antara manusia dan makan rumput seperti lembu, dan tubuhnya basah oleh embun dari langit, sampai rambutnya menjadi panjang seperti bulu burung rajawali dan kukunya seperti kuku burung."
 },
 {
   "id": 21876,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 34,
   "firman": "Tetapi setelah lewat waktu yang ditentukan, aku, Nebukadnezar, menengadah ke langit, dan akal budiku kembali lagi kepadaku. Lalu aku memuji Yang Mahatinggi dan membesarkan dan memuliakan Yang Hidup kekal itu, karena kekuasaan-Nya ialah kekuasaan yang kekal dan kerajaan-Nya turun-temurun."
 },
 {
   "id": 21877,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 35,
   "firman": "Semua penduduk bumi dianggap remeh; Ia berbuat menurut kehendak-Nya terhadap bala tentara langit dan penduduk bumi; dan tidak ada seorangpun yang dapat menolak tangan-Nya dengan berkata kepada-Nya: \"Apa yang Kaubuat?\""
 },
 {
   "id": 21878,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 36,
   "firman": "Pada waktu akal budiku kembali kepadaku, kembalilah juga kepadaku kebesaran dan kemuliaanku untuk kemasyhuran kerajaanku. Para menteriku dan para pembesarku menjemput aku lagi; aku dikembalikan kepada kerajaanku, bahkan kemuliaan yang lebih besar dari dahulu diberikan kepadaku."
 },
 {
   "id": 21879,
   "kitab": "Dan",
   "pasal": 4,
   "ayat": 37,
   "firman": "Jadi sekarang aku, Nebukadnezar, memuji, meninggikan dan memuliakan Raja Sorga, yang segala perbuatan-Nya adalah benar dan jalan-jalan-Nya adalah adil, dan yang sanggup merendahkan mereka yang berlaku congkak."
 },
 {
   "id": 21880,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 1,
   "firman": "Raja Belsyazar mengadakan perjamuan yang besar untuk para pembesarnya, seribu orang jumlahnya; dan di hadapan seribu orang itu ia minum-minum anggur."
 },
 {
   "id": 21881,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 2,
   "firman": "Dalam kemabukan anggur, Belsyazar menitahkan orang membawa perkakas dari emas dan perak yang telah diambil oleh Nebukadnezar, ayahnya, dari dalam Bait Suci di Yerusalem, supaya raja dan para pembesarnya, para isteri dan para gundik mereka minum dari perkakas itu."
 },
 {
   "id": 21882,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 3,
   "firman": "Kemudian dibawalah perkakas dari emas dan perak itu, yang diambil dari dalam Bait Suci, Rumah Allah di Yerusalem, lalu raja dan para pembesarnya, para isteri dan para gundik mereka minum dari perkakas itu;"
 },
 {
   "id": 21883,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 4,
   "firman": "mereka minum anggur dan memuji-muji dewa-dewa dari emas dan perak, tembaga, besi, kayu dan batu."
 },
 {
   "id": 21884,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 5,
   "firman": "Pada waktu itu juga tampaklah jari-jari tangan manusia menulis pada kapur dinding istana raja, di depan kaki dian, dan raja melihat punggung tangan yang sedang menulis itu."
 },
 {
   "id": 21885,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 6,
   "firman": "Lalu raja menjadi pucat, dan pikiran-pikirannya menggelisahkan dia; sendi-sendi pangkal pahanya menjadi lemas dan lututnya berantukan."
 },
 {
   "id": 21886,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 7,
   "firman": "Kemudian berserulah raja dengan keras, supaya para ahli jampi, para Kasdim dan para ahli nujum dibawa menghadap. Berkatalah raja kepada para orang bijaksana di Babel itu: \"Setiap orang yang dapat membaca tulisan ini dan dapat memberitahukan maknanya kepadaku, kepadanya akan dikenakan pakaian dari kain ungu, dan lehernya akan dikalungkan rantai emas, dan di dalam kerajaanku ia akan mempunyai kekuasaan sebagai orang ketiga.\""
 },
 {
   "id": 21887,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tetapi semua orang bijaksana dari raja, yang telah datang menghadap, tidak sanggup membaca tulisan itu dan tidak sanggup memberitahukan maknanya kepada raja."
 },
 {
   "id": 21888,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 9,
   "firman": "Sesudah itu sangatlah cemas hati raja Belsyazar dan ia menjadi pucat; juga para pembesarnya terperanjat."
 },
 {
   "id": 21889,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 10,
   "firman": "Karena perkataan raja dan para pembesarnya itu masuklah permaisuri ke dalam ruang perjamuan; berkatalah ia: \"Ya raja, kekallah hidup tuanku! Janganlah pikiran-pikiran tuanku menggelisahkan tuanku dan janganlah menjadi pucat;"
 },
 {
   "id": 21890,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 11,
   "firman": "sebab dalam kerajaan tuanku ada seorang yang penuh dengan roh para dewa yang kudus! Dalam zaman ayah tuanku ada terdapat pada orang itu kecerahan, akal budi dan hikmat yang seperti hikmat para dewa. Ia telah diangkat oleh raja Nebukadnezar, ayah tuanku menjadi kepala orang-orang berilmu, para ahli jampi, para Kasdim dan para ahli nujum,"
 },
 {
   "id": 21891,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 12,
   "firman": "karena pada orang itu terdapat roh yang luar biasa dan pengetahuan dan akal budi, sehingga dapat menerangkan mimpi, menyingkapkan hal-hal yang tersembunyi dan menguraikan kekusutan, yakni pada Daniel yang dinamai Beltsazar oleh raja. Baiklah sekarang Daniel dipanggil dan ia akan memberitahukan maknanya!\""
 },
 {
   "id": 21892,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 13,
   "firman": "Lalu dibawalah Daniel menghadap raja. Bertanyalah raja kepada Daniel: \"Engkaukah Daniel itu, salah seorang buangan yang telah diangkut oleh raja, ayahku, dari tanah Yehuda?"
 },
 {
   "id": 21893,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 14,
   "firman": "Telah kudengar tentang engkau, bahwa engkau penuh dengan roh para dewa, dan bahwa padamu terdapat kecerahan, akal budi dan hikmat yang luar biasa."
 },
 {
   "id": 21894,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 15,
   "firman": "Kepadaku telah dibawa orang-orang bijaksana, para ahli jampi, supaya mereka membaca tulisan ini dan memberitahukan maknanya kepadaku, tetapi mereka tidak sanggup mengatakan makna perkataan itu."
 },
 {
   "id": 21895,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 16,
   "firman": "Tetapi telah kudengar tentang engkau, bahwa engkau dapat memberikan makna dan dapat menguraikan kekusutan. Oleh sebab itu, jika engkau dapat membaca tulisan itu dan dapat memberitahukan maknanya kepadaku, maka kepadamu akan dikenakan pakaian dari kain ungu dan pada lehermu akan dikalungkan rantai emas, dan dalam kerajaan ini engkau akan mempunyai kekuasaan sebagai orang ketiga.\""
 },
 {
   "id": 21896,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 17,
   "firman": "Kemudian Daniel menjawab raja: \"Tahanlah hadiah tuanku, berikanlah pemberian tuanku kepada orang lain! Namun demikian, aku akan membaca tulisan itu bagi raja dan memberitahukan maknanya kepada tuanku."
 },
 {
   "id": 21897,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 18,
   "firman": "Ya tuanku raja! Allah, Yang Mahatinggi, telah memberikan kekuasaan sebagai raja, kebesaran, kemuliaan dan keluhuran kepada Nebukadnezar, ayah tuanku."
 },
 {
   "id": 21898,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 19,
   "firman": "Dan oleh karena kebesaran yang telah diberikan-Nya kepadanya itu, maka takut dan gentarlah terhadap dia orang-orang dari segala bangsa, suku bangsa dan bahasa; dibunuhnya siapa yang dikehendakinya dan dibiarkannya hidup siapa yang dikehendakinya, ditinggikannya siapa yang dikehendakinya dan direndahkannya siapa yang dikehendakinya."
 },
 {
   "id": 21899,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 20,
   "firman": "Tetapi ketika ia menjadi tinggi hati dan keras kepala, sehingga berlaku terlalu angkuh, maka ia dijatuhkan dari takhta kerajaannya dan kemuliaannya diambil dari padanya."
 },
 {
   "id": 21900,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 21,
   "firman": "Ia dihalau dari antara manusia dan hatinya menjadi sama seperti hati binatang, dan tempat tinggalnya ada di antara keledai hutan; kepadanya diberikan makanan rumput seperti kepada lembu, dan tubuhnya basah oleh embun dari langit, sampai ia mengakui, bahwa Allah, Yang Mahatinggi, berkuasa atas kerajaan manusia dan mengangkat siapa yang dikehendaki-Nya untuk kedudukan itu."
 },
 {
   "id": 21901,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 22,
   "firman": "Tetapi tuanku, Belsyazar, anaknya, tidak merendahkan diri, walaupun tuanku mengetahui semuanya ini."
 },
 {
   "id": 21902,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 23,
   "firman": "Tuanku meninggikan diri terhadap Yang Berkuasa di sorga: perkakas dari Bait-Nya dibawa orang kepada tuanku, lalu tuanku serta para pembesar tuanku, para isteri dan para gundik tuanku telah minum anggur dari perkakas itu; tuanku telah memuji-muji dewa-dewa dari perak dan emas, dari tembaga, besi, kayu dan batu, yang tidak dapat melihat atau mendengar atau mengetahui, dan tidak tuanku muliakan Allah, yang menggenggam nafas tuanku dan menentukan segala jalan tuanku."
 },
 {
   "id": 21903,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 24,
   "firman": "Sebab itu Ia menyuruh punggung tangan itu dan dituliskanlah tulisan ini."
 },
 {
   "id": 21904,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 25,
   "firman": "Maka inilah tulisan yang tertulis itu: Mene, mene, tekel ufarsin."
 },
 {
   "id": 21905,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 26,
   "firman": "Dan inilah makna perkataan itu: Mene: masa pemerintahan tuanku dihitung oleh Allah dan telah diakhiri;"
 },
 {
   "id": 21906,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 27,
   "firman": "Tekel: tuanku ditimbang dengan neraca dan didapati terlalu ringan;"
 },
 {
   "id": 21907,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 28,
   "firman": "Peres: kerajaan tuanku dipecah dan diberikan kepada orang Media dan Persia.\""
 },
 {
   "id": 21908,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 29,
   "firman": "Lalu atas titah Belsyazar dikenakanlah kepada Daniel pakaian dari kain ungu dan pada lehernya dikalungkan rantai emas, dan dimaklumkanlah tentang dia, bahwa di dalam kerajaan ia akan mempunyai kekuasaan sebagai orang ketiga."
 },
 {
   "id": 21909,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 30,
   "firman": "Pada malam itu juga terbunuhlah Belsyazar, raja orang Kasdim itu."
 },
 {
   "id": 21910,
   "kitab": "Dan",
   "pasal": 5,
   "ayat": 31,
   "firman": "(6-1) Darius, orang Media, menerima pemerintahan ketika ia berumur enam puluh dua tahun."
 },
 {
   "id": 21911,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 1,
   "firman": "(6-2) Lalu berkenanlah Darius mengangkat seratus dua puluh wakil-wakil raja atas kerajaannya; mereka akan ditempatkan di seluruh kerajaan;"
 },
 {
   "id": 21912,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 2,
   "firman": "(6-3) membawahi mereka diangkat pula tiga pejabat tinggi, dan Daniel adalah salah satu dari ketiga orang itu; kepada merekalah para wakil-wakil raja harus memberi pertanggungan jawab, supaya raja jangan dirugikan."
 },
 {
   "id": 21913,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 3,
   "firman": "(6-4) Maka Daniel ini melebihi para pejabat tinggi dan para wakil raja itu, karena ia mempunyai roh yang luar biasa; dan raja bermaksud untuk menempatkannya atas seluruh kerajaannya."
 },
 {
   "id": 21914,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 4,
   "firman": "(6-5) Kemudian para pejabat tinggi dan wakil raja itu mencari alasan dakwaan terhadap Daniel dalam hal pemerintahan, tetapi mereka tidak mendapat alasan apapun atau sesuatu kesalahan, sebab ia setia dan tidak ada didapati sesuatu kelalaian atau sesuatu kesalahan padanya."
 },
 {
   "id": 21915,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 5,
   "firman": "(6-6) Maka berkatalah orang-orang itu: \"Kita tidak akan mendapat suatu alasan dakwaan terhadap Daniel ini, kecuali dalam hal ibadahnya kepada Allahnya!\""
 },
 {
   "id": 21916,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 6,
   "firman": "(6-7) Kemudian bergegas-gegaslah para pejabat tinggi dan wakil raja itu menghadap raja serta berkata kepadanya: \"Ya raja Darius, kekallah hidup tuanku!"
 },
 {
   "id": 21917,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 7,
   "firman": "(6-8) Semua pejabat tinggi kerajaan ini, semua penguasa dan wakil raja, para menteri dan bupati telah mufakat, supaya dikeluarkan kiranya suatu penetapan raja dan ditetapkan suatu larangan, agar barangsiapa yang dalam tiga puluh hari menyampaikan permohonan kepada salah satu dewa atau manusia kecuali kepada tuanku, ya raja, maka ia akan dilemparkan ke dalam gua singa."
 },
 {
   "id": 21918,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 8,
   "firman": "(6-9) Oleh sebab itu, ya raja, keluarkanlah larangan itu dan buatlah suatu surat perintah yang tidak dapat diubah, menurut undang-undang orang Media dan Persia, yang tidak dapat dicabut kembali.\""
 },
 {
   "id": 21919,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 9,
   "firman": "(6-10) Sebab itu raja Darius membuat surat perintah dengan larangan itu."
 },
 {
   "id": 21920,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 10,
   "firman": "(6-11) Demi didengar Daniel, bahwa surat perintah itu telah dibuat, pergilah ia ke rumahnya. Dalam kamar atasnya ada tingkap-tingkap yang terbuka ke arah Yerusalem; tiga kali sehari ia berlutut, berdoa serta memuji Allahnya, seperti yang biasa dilakukannya."
 },
 {
   "id": 21921,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 11,
   "firman": "(6-12) Lalu orang-orang itu bergegas-gegas masuk dan mendapati Daniel sedang berdoa dan bermohon kepada Allahnya."
 },
 {
   "id": 21922,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 12,
   "firman": "(6-13) Kemudian mereka menghadap raja dan menanyakan kepadanya tentang larangan raja: \"Bukankah tuanku mengeluarkan suatu larangan, supaya setiap orang yang dalam tiga puluh hari menyampaikan permohonan kepada salah satu dewa atau manusia kecuali kepada tuanku, ya raja, akan dilemparkan ke dalam gua singa?\" Jawab raja: \"Perkara ini telah pasti menurut undang-undang orang Media dan Persia, yang tidak dapat dicabut kembali.\""
 },
 {
   "id": 21923,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 13,
   "firman": "(6-14) Lalu kata mereka kepada raja: \"Daniel, salah seorang buangan dari Yehuda, tidak mengindahkan tuanku, ya raja, dan tidak mengindahkan larangan yang tuanku keluarkan, tetapi tiga kali sehari ia mengucapkan doanya.\""
 },
 {
   "id": 21924,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 14,
   "firman": "(6-15) Setelah raja mendengar hal itu, maka sangat sedihlah ia, dan ia mencari jalan untuk melepaskan Daniel, bahkan sampai matahari masuk, ia masih berusaha untuk menolongnya."
 },
 {
   "id": 21925,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 15,
   "firman": "(6-16) Lalu bergegas-gegaslah orang-orang itu menghadap raja serta berkata kepadanya: \"Ketahuilah, ya raja, bahwa menurut undang-undang orang Media dan Persia tidak ada larangan atau penetapan yang dikeluarkan raja yang dapat diubah!\""
 },
 {
   "id": 21926,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 16,
   "firman": "(6-17) Sesudah itu raja memberi perintah, lalu diambillah Daniel dan dilemparkan ke dalam gua singa. Berbicaralah raja kepada Daniel: \"Allahmu yang kausembah dengan tekun, Dialah kiranya yang melepaskan engkau!\""
 },
 {
   "id": 21927,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 17,
   "firman": "(6-18) Maka dibawalah sebuah batu dan diletakkan pada mulut gua itu, lalu raja mencap itu dengan cincin meterainya dan dengan cincin meterai para pembesarnya, supaya dalam hal Daniel tidak dibuat perubahan apa-apa."
 },
 {
   "id": 21928,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 18,
   "firman": "(6-19) Lalu pergilah raja ke istananya dan berpuasalah ia semalam-malaman itu; ia tidak menyuruh datang penghibur-penghibur, dan ia tidak dapat tidur."
 },
 {
   "id": 21929,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 19,
   "firman": "(6-20) Pagi-pagi sekali ketika fajar menyingsing, bangunlah raja dan pergi dengan buru-buru ke gua singa;"
 },
 {
   "id": 21930,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 20,
   "firman": "(6-21) dan ketika ia sampai dekat gua itu, berserulah ia kepada Daniel dengan suara yang sayu. Berkatalah ia kepada Daniel: \"Daniel, hamba Allah yang hidup, Allahmu yang kausembah dengan tekun, telah sanggupkah Ia melepaskan engkau dari singa-singa itu?\""
 },
 {
   "id": 21931,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 21,
   "firman": "(6-22) Lalu kata Daniel kepada raja: \"Ya raja, kekallah hidupmu!"
 },
 {
   "id": 21932,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 22,
   "firman": "(6-23) Allahku telah mengutus malaikat-Nya untuk mengatupkan mulut singa-singa itu, sehingga mereka tidak mengapa-apakan aku, karena ternyata aku tak bersalah di hadapan-Nya; tetapi juga terhadap tuanku, ya raja, aku tidak melakukan kejahatan.\""
 },
 {
   "id": 21933,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 23,
   "firman": "(6-24) Lalu sangat sukacitalah raja dan ia memberi perintah, supaya Daniel ditarik dari dalam gua itu. Maka ditariklah Daniel dari dalam gua itu, dan tidak terdapat luka apa-apa padanya, karena ia percaya kepada Allahnya."
 },
 {
   "id": 21934,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 24,
   "firman": "(6-25) Raja memberi perintah, lalu diambillah orang-orang yang telah menuduh Daniel dan mereka dilemparkan ke dalam gua singa, baik mereka maupun anak-anak dan isteri-isteri mereka. Belum lagi mereka sampai ke dasar gua itu, singa-singa itu telah menerkam mereka, bahkan meremukkan tulang-tulang mereka."
 },
 {
   "id": 21935,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 25,
   "firman": "(6-26) Kemudian raja Darius mengirim surat kepada orang-orang dari segala bangsa, suku bangsa dan bahasa, yang mendiami seluruh bumi, bunyinya: \"Bertambah-tambahlah kiranya kesejahteraanmu!"
 },
 {
   "id": 21936,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 26,
   "firman": "(6-27) Bersama ini kuberikan perintah, bahwa di seluruh kerajaan yang kukuasai orang harus takut dan gentar kepada Allahnya Daniel, sebab Dialah Allah yang hidup, yang kekal untuk selama-lamanya; pemerintahan-Nya tidak akan binasa dan kekuasaan-Nya tidak akan berakhir."
 },
 {
   "id": 21937,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 27,
   "firman": "(6-28) Dia melepaskan dan menolong, dan mengadakan tanda dan mujizat di langit dan di bumi, Dia yang telah melepaskan Daniel dari cengkaman singa-singa.\""
 },
 {
   "id": 21938,
   "kitab": "Dan",
   "pasal": 6,
   "ayat": 28,
   "firman": "(6-29) Dan Daniel ini mempunyai kedudukan tinggi pada zaman pemerintahan Darius dan pada zaman pemerintahan Koresh, orang Persia itu."
 },
 {
   "id": 21939,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 1,
   "firman": "Pada tahun pertama pemerintahan Belsyazar, raja Babel, bermimpilah Daniel dan mendapat penglihatan-penglihatan di tempat tidurnya. Lalu dituliskannya mimpi itu, dan inilah garis besarnya:"
 },
 {
   "id": 21940,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 2,
   "firman": "Berkatalah Daniel, demikian: \"Pada malam hari aku mendapat penglihatan, tampak keempat angin dari langit mengguncangkan laut besar,"
 },
 {
   "id": 21941,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 3,
   "firman": "dan empat binatang besar naik dari dalam laut, yang satu berbeda dengan yang lain."
 },
 {
   "id": 21942,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 4,
   "firman": "Yang pertama rupanya seperti seekor singa, dan mempunyai sayap burung rajawali; aku terus melihatnya sampai sayapnya tercabut dan ia terangkat dari tanah dan ditegakkan pada dua kaki seperti manusia, dan kepadanya diberikan hati manusia."
 },
 {
   "id": 21943,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 5,
   "firman": "Dan tampak ada seekor binatang yang lain, yang kedua, rupanya seperti beruang; ia berdiri pada sisinya yang sebelah, dan tiga tulang rusuk masih ada di dalam mulutnya di antara giginya. Dan demikianlah dikatakan kepadanya: Ayo, makanlah daging banyak-banyak."
 },
 {
   "id": 21944,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 6,
   "firman": "Kemudian aku melihat, tampak seekor binatang yang lain, rupanya seperti macan tutul; ada empat sayap burung pada punggungnya, lagipula binatang itu berkepala empat, dan kepadanya diberikan kekuasaan."
 },
 {
   "id": 21945,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 7,
   "firman": "Kemudian aku melihat dalam penglihatan malam itu, tampak seekor binatang yang keempat, yang menakutkan dan mendahsyatkan, dan ia sangat kuat. Ia bergigi besar dari besi; ia melahap dan meremukkan, dan sisanya diinjak-injaknya dengan kakinya; ia berbeda dengan segala binatang yang terdahulu; lagipula ia bertanduk sepuluh."
 },
 {
   "id": 21946,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 8,
   "firman": "Sementara aku memperhatikan tanduk-tanduk itu, tampak tumbuh di antaranya suatu tanduk lain yang kecil, sehingga tiga dari tanduk-tanduk yang dahulu itu tercabut; dan pada tanduk itu tampak ada mata seperti mata manusia dan mulut yang menyombong."
 },
 {
   "id": 21947,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 9,
   "firman": "Sementara aku terus melihat, takhta-takhta diletakkan, lalu duduklah Yang Lanjut Usianya; pakaian-Nya putih seperti salju dan rambut-Nya bersih seperti bulu domba; kursi-Nya dari nyala api dengan roda-rodanya dari api yang berkobar-kobar;"
 },
 {
   "id": 21948,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 10,
   "firman": "suatu sungai api timbul dan mengalir dari hadapan-Nya; seribu kali beribu-ribu melayani Dia, dan selaksa kali berlaksa-laksa berdiri di hadapan-Nya. Lalu duduklah Majelis Pengadilan dan dibukalah Kitab-kitab."
 },
 {
   "id": 21949,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 11,
   "firman": "Aku terus melihatnya, karena perkataan sombong yang diucapkan tanduk itu; aku terus melihatnya, sampai binatang itu dibunuh, tubuhnya dibinasakan dan diserahkan ke dalam api yang membakar."
 },
 {
   "id": 21950,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 12,
   "firman": "Juga kekuasaan binatang-binatang yang lain dicabut, dan jangka hidup mereka ditentukan sampai pada waktu dan saatnya."
 },
 {
   "id": 21951,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 13,
   "firman": "Aku terus melihat dalam penglihatan malam itu, tampak datang dengan awan-awan dari langit seorang seperti anak manusia; datanglah ia kepada Yang Lanjut Usianya itu, dan ia dibawa ke hadapan-Nya."
 },
 {
   "id": 21952,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 14,
   "firman": "Lalu diberikan kepadanya kekuasaan dan kemuliaan dan kekuasaan sebagai raja, maka orang-orang dari segala bangsa, suku bangsa dan bahasa mengabdi kepadanya. Kekuasaannya ialah kekuasaan yang kekal, yang tidak akan lenyap, dan kerajaannya ialah kerajaan yang tidak akan musnah."
 },
 {
   "id": 21953,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 15,
   "firman": "Maka aku, Daniel, terharu karena hal itu, dan penglihatan-penglihatan yang kulihat itu menggelisahkan aku."
 },
 {
   "id": 21954,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 16,
   "firman": "Lalu kudekati salah seorang dari mereka yang berdiri di sana dan kuminta penjelasan tentang semuanya itu. Maka berkatalah ia kepadaku dan diberitahukannyalah kepadaku maknanya:"
 },
 {
   "id": 21955,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 17,
   "firman": "Binatang-binatang besar yang empat ekor itu ialah empat raja yang akan muncul dari dalam bumi;"
 },
 {
   "id": 21956,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 18,
   "firman": "sesudah itu orang-orang kudus milik Yang Mahatinggi akan menerima pemerintahan, dan mereka akan memegang pemerintahan itu sampai selama-lamanya, bahkan kekal selama-lamanya."
 },
 {
   "id": 21957,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 19,
   "firman": "Lalu aku ingin mendapat penjelasan tentang binatang yang keempat itu, yang berbeda dengan segala binatang yang lain, yang sangat menakutkan, dengan gigi besinya dan kuku tembaganya, yang melahap dan meremukkan dan menginjak-injak sisanya dengan kakinya;"
 },
 {
   "id": 21958,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 20,
   "firman": "dan tentang kesepuluh tanduk yang ada pada kepalanya, dan tentang tanduk yang lain, yakni tanduk yang mempunyai mata dan yang mempunyai mulut yang menyombong, yang tumbuh sehingga patahlah tiga tanduk, dan yang lebih besar rupanya dari tanduk-tanduk yang lain."
 },
 {
   "id": 21959,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 21,
   "firman": "Dan aku melihat tanduk itu berperang melawan orang-orang kudus dan mengalahkan mereka,"
 },
 {
   "id": 21960,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 22,
   "firman": "sampai Yang Lanjut Usianya itu datang dan keadilan diberikan kepada orang-orang kudus milik Yang Mahatinggi dan waktunya datang orang-orang kudus itu memegang pemerintahan."
 },
 {
   "id": 21961,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 23,
   "firman": "Maka demikianlah katanya: Binatang yang keempat itu ialah kerajaan yang keempat yang akan ada di bumi, yang akan berbeda dengan segala kerajaan dan akan menelan seluruh bumi, menginjak-injaknya dan meremukkannya."
 },
 {
   "id": 21962,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 24,
   "firman": "Kesepuluh tanduk itu ialah kesepuluh raja yang muncul dari kerajaan itu. Sesudah mereka, akan muncul seorang raja; dia berbeda dengan raja-raja yang dahulu dan akan merendahkan tiga raja."
 },
 {
   "id": 21963,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 25,
   "firman": "Ia akan mengucapkan perkataan yang menentang Yang Mahatinggi, dan akan menganiaya orang-orang kudus milik Yang Mahatinggi; ia berusaha untuk mengubah waktu dan hukum, dan mereka akan diserahkan ke dalam tangannya selama satu masa dan dua masa dan setengah masa."
 },
 {
   "id": 21964,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 26,
   "firman": "Lalu Majelis Pengadilan akan duduk, dan kekuasaan akan dicabut dari padanya untuk dimusnahkan dan dihancurkan sampai lenyap."
 },
 {
   "id": 21965,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 27,
   "firman": "Maka pemerintahan, kekuasaan dan kebesaran dari kerajaan-kerajaan di bawah semesta langit akan diberikan kepada orang-orang kudus, umat Yang Mahatinggi: pemerintahan mereka adalah pemerintahan yang kekal, dan segala kekuasaan akan mengabdi dan patuh kepada mereka."
 },
 {
   "id": 21966,
   "kitab": "Dan",
   "pasal": 7,
   "ayat": 28,
   "firman": "Sekianlah berita itu. Adapun aku, Daniel, pikiran-pikiranku sangat menggelisahkan aku, sehingga aku menjadi pucat; dan aku menyimpan hal itu dalam ingatanku.\""
 },
 {
   "id": 21967,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada tahun yang ketiga pemerintahan raja Belsyazar, nampaklah kepadaku, Daniel, suatu penglihatan sesudah yang tampak kepadaku dahulu itu."
 },
 {
   "id": 21968,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 2,
   "firman": "Aku melihat dalam penglihatan itu, dan sementara aku melihat, aku berada di puri Susan, yang ada di wilayah Elam, dan aku melihat dalam penglihatan itu, bahwa aku sedang di tepi sungai Ulai."
 },
 {
   "id": 21969,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 3,
   "firman": "Aku mengangkat mukaku dan melihat, tampak seekor domba jantan berdiri di depan sungai itu; tanduknya dua dan kedua tanduk itu tinggi, tetapi yang satu lebih tinggi dari yang lain, dan yang tinggi itu tumbuh terakhir."
 },
 {
   "id": 21970,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 4,
   "firman": "Aku melihat domba jantan itu menanduk ke barat, ke utara dan ke selatan, dan tidak ada seekor binatangpun yang tahan menghadapi dia, dan tidak ada yang dapat membebaskan dari kuasanya; ia berbuat sekehendak hatinya dan membesarkan diri."
 },
 {
   "id": 21971,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 5,
   "firman": "Tetapi sementara aku memperhatikannya, tampak seekor kambing jantan datang dari sebelah barat, yang melintasi seluruh bumi tanpa menginjak tanah; dan kambing jantan itu mempunyai satu tanduk yang aneh di antara kedua matanya."
 },
 {
   "id": 21972,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 6,
   "firman": "Ia datang pada domba jantan yang dua tanduknya dan yang kulihat berdiri di depan sungai itu, lalu menyerangnya dengan keganasan yang hebat."
 },
 {
   "id": 21973,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 7,
   "firman": "Aku melihatnya mendekati domba jantan itu; ia menggeram, lalu ditanduknya domba jantan itu, dipatahkannya kedua tanduknya, dan domba jantan itu tidak berdaya untuk tahan menghadapi dia; dihempaskannya dia ke bumi, diinjak-injaknya, dan tidak ada yang melepaskan domba jantan itu dari kuasanya."
 },
 {
   "id": 21974,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 8,
   "firman": "Kambing jantan itu sangat membesarkan dirinya, tetapi ketika ia sampai pada puncak kuasanya, patahlah tanduk yang besar itu, lalu pada tempatnya tumbuh empat tanduk yang aneh, sejajar dengan keempat mata angin yang dari langit."
 },
 {
   "id": 21975,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 9,
   "firman": "Maka dari salah satu tanduk itu muncul suatu tanduk kecil, yang menjadi sangat besar ke arah selatan, ke arah timur dan ke arah Tanah Permai."
 },
 {
   "id": 21976,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 10,
   "firman": "Ia menjadi besar, bahkan sampai kepada bala tentara langit, dan dari bala tentara itu, dari bintang-bintang, dijatuhkannya beberapa ke bumi, dan diinjak-injaknya."
 },
 {
   "id": 21977,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 11,
   "firman": "Bahkan terhadap Panglima bala tentara itupun ia membesarkan dirinya, dan dari pada-Nya diambilnya korban persembahan sehari-hari, dan tempat-Nya yang kudus dirobohkannya."
 },
 {
   "id": 21978,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 12,
   "firman": "Suatu kebaktian diadakan secara fasik menggantikan korban sehari-hari, kebenaran dihempaskannya ke bumi, dan apapun yang dibuatnya, semuanya berhasil."
 },
 {
   "id": 21979,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 13,
   "firman": "Kemudian kudengar seorang kudus berbicara, dan seorang kudus lain berkata kepada yang berbicara itu: \"Sampai berapa lama berlaku penglihatan ini, yakni korban sehari-hari dan kefasikan yang membinasakan, tempat kudus yang diserahkan dan bala tentara yang diinjak-injak?\""
 },
 {
   "id": 21980,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 14,
   "firman": "Maka ia menjawab: \"Sampai lewat dua ribu tiga ratus petang dan pagi, lalu tempat kudus itu akan dipulihkan dalam keadaan yang wajar.\""
 },
 {
   "id": 21981,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 15,
   "firman": "Sedang aku, Daniel, melihat penglihatan itu dan berusaha memahaminya, maka tampaklah seorang berdiri di depanku, yang rupanya seperti seorang laki-laki;"
 },
 {
   "id": 21982,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 16,
   "firman": "dan aku mendengar dari tengah sungai Ulai itu suara manusia yang berseru: \"Gabriel, buatlah orang ini memahami penglihatan itu!\""
 },
 {
   "id": 21983,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 17,
   "firman": "Lalu datanglah ia ke tempat aku berdiri, dan ketika ia datang, terkejutlah aku dan jatuh tertelungkup, lalu ia berkata kepadaku: \"Pahamilah, anak manusia, bahwa penglihatan itu mengenai akhir masa!\""
 },
 {
   "id": 21984,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 18,
   "firman": "Sementara ia berbicara dengan aku, jatuh pingsanlah aku tertelungkup ke tanah; tetapi ia menyentuh aku dan membuat aku berdiri kembali."
 },
 {
   "id": 21985,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 19,
   "firman": "Lalu berkatalah ia: \"Kuberitahukan kepadamu apa yang akan terjadi pada akhir murka ini, sebab hal itu mengenai akhir zaman."
 },
 {
   "id": 21986,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 20,
   "firman": "Domba jantan yang kaulihat itu, dengan kedua tanduknya, ialah raja-raja orang Media dan Persia."
 },
 {
   "id": 21987,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 21,
   "firman": "Dan kambing jantan yang berbulu kesat itu ialah raja negeri Yunani, dan tanduk besar yang di antara kedua matanya itu ialah raja yang pertama."
 },
 {
   "id": 21988,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 22,
   "firman": "Dan bahwa tanduk itu patah dan pada tempatnya itu muncul empat buah, berarti: empat kerajaan akan muncul dari bangsa itu, tetapi tidak sekuat yang terdahulu."
 },
 {
   "id": 21989,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 23,
   "firman": "Dan pada akhir kerajaan mereka, apabila orang-orang fasik telah penuh kejahatannya, maka akan muncul seorang raja dengan muka yang garang dan yang pandai menipu."
 },
 {
   "id": 21990,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 24,
   "firman": "Kekuatannya akan menjadi hebat, tetapi tidak sekuat yang terdahulu, dan ia akan mendatangkan kebinasaan yang mengerikan, dan apa yang dilakukannya akan berhasil; orang-orang berkuasa akan dibinasakannya, juga umat orang kudus."
 },
 {
   "id": 21991,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 25,
   "firman": "Dan oleh karena akalnya, penipuan yang dilakukannya akan berhasil; ia akan membesarkan dirinya dalam hatinya, dan dengan tak disangka-sangka banyak orang akan dibinasakannya; juga ia akan bangkit melawan Raja segala raja. Tetapi tanpa perbuatan tangan manusia, ia akan dihancurkan."
 },
 {
   "id": 21992,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 26,
   "firman": "Adapun penglihatan tentang petang dan pagi itu, apa yang dikatakan tentang itu adalah benar. Tetapi engkau, sembunyikanlah penglihatan itu, sebab hal itu mengenai masa depan yang masih jauh.\""
 },
 {
   "id": 21993,
   "kitab": "Dan",
   "pasal": 8,
   "ayat": 27,
   "firman": "Maka aku, Daniel, lelah dan jatuh sakit beberapa hari lamanya; kemudian bangunlah aku dan melakukan pula urusan raja. Dan aku tercengang-cengang tentang penglihatan itu, tetapi tidak memahaminya."
 },
 {
   "id": 21994,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 1,
   "firman": "Pada tahun pertama pemerintahan Darius, anak Ahasyweros, dari keturunan orang Media, yang telah menjadi raja atas kerajaan orang Kasdim,"
 },
 {
   "id": 21995,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 2,
   "firman": "pada tahun pertama kerajaannya itu aku, Daniel, memperhatikan dalam kumpulan Kitab jumlah tahun yang menurut firman TUHAN kepada nabi Yeremia akan berlaku atas timbunan puing Yerusalem, yakni tujuh puluh tahun."
 },
 {
   "id": 21996,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 3,
   "firman": "Lalu aku mengarahkan mukaku kepada Tuhan Allah untuk berdoa dan bermohon, sambil berpuasa dan mengenakan kain kabung serta abu."
 },
 {
   "id": 21997,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 4,
   "firman": "Maka aku memohon kepada TUHAN, Allahku, dan mengaku dosaku, demikian: \"Ah Tuhan, Allah yang maha besar dan dahsyat, yang memegang Perjanjian dan kasih setia terhadap mereka yang mengasihi Engkau serta berpegang pada perintah-Mu!"
 },
 {
   "id": 21998,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 5,
   "firman": "Kami telah berbuat dosa dan salah, kami telah berlaku fasik dan telah memberontak, kami telah menyimpang dari perintah dan peraturan-Mu,"
 },
 {
   "id": 21999,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 6,
   "firman": "dan kami tidak taat kepada hamba-hamba-Mu, para nabi, yang telah berbicara atas nama-Mu kepada raja-raja kami, kepada pemimpin-pemimpin kami, kepada bapa-bapa kami dan kepada segenap rakyat negeri."
 },
 {
   "id": 22000,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 7,
   "firman": "Ya Tuhan, Engkaulah yang benar, tetapi patutlah kami malu seperti pada hari ini, kami orang-orang Yehuda, penduduk kota Yerusalem dan segenap orang Israel, mereka yang dekat dan mereka yang jauh, di segala negeri kemana Engkau telah membuang mereka oleh karena mereka berlaku murtad terhadap Engkau."
 },
 {
   "id": 22001,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 8,
   "firman": "Ya TUHAN, kami, raja-raja kami, pemimpin-pemimpin kami dan bapa-bapa kami patutlah malu, sebab kami telah berbuat dosa terhadap Engkau."
 },
 {
   "id": 22002,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 9,
   "firman": "Pada Tuhan, Allah kami, ada kesayangan dan keampunan, walaupun kami telah memberontak terhadap Dia,"
 },
 {
   "id": 22003,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 10,
   "firman": "dan tidak mendengarkan suara TUHAN, Allah kami, yang menyuruh kami hidup menurut hukum yang telah diberikan-Nya kepada kami dengan perantaraan para nabi, hamba-hamba-Nya."
 },
 {
   "id": 22004,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 11,
   "firman": "Segenap orang Israel telah melanggar hukum-Mu dan menyimpang karena tidak mendengarkan suara-Mu. Sebab itu telah dicurahkan ke atas kami kutuk dan sumpah, yang tertulis dalam kitab Taurat Musa, hamba Allah itu, sebab kami telah berbuat dosa terhadap Dia."
 },
 {
   "id": 22005,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 12,
   "firman": "Dan telah ditetapkan-Nya firman-Nya, yang diucapkan-Nya terhadap kami dan terhadap orang-orang yang telah memerintah kami, yakni bahwa akan didatangkan-Nya kepada kami malapetaka yang besar, yang belum pernah terjadi di bawah semesta langit, seperti di Yerusalem."
 },
 {
   "id": 22006,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 13,
   "firman": "Seperti yang tertulis dalam kitab Taurat Musa, segala malapetaka ini telah menimpa kami, dan kami tidak memohon belas kasihan TUHAN, Allah kami, dengan berbalik dari segala kesalahan kami dan memperhatikan kebenaran yang dari pada-Mu."
 },
 {
   "id": 22007,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 14,
   "firman": "Sebab itu TUHAN bersiap dengan malapetaka itu dan mendatangkannya kepada kami; karena TUHAN, Allah kami, adalah adil dalam segala perbuatan yang dilakukan-Nya, tetapi kami tidak mendengarkan suara-Nya."
 },
 {
   "id": 22008,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 15,
   "firman": "Oleh sebab itu, ya Tuhan, Allah kami, yang telah membawa umat-Mu keluar dari tanah Mesir dengan tangan yang kuat dan memasyhurkan nama-Mu, seperti pada hari ini, kami telah berbuat dosa, kami telah berlaku fasik."
 },
 {
   "id": 22009,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 16,
   "firman": "Ya Tuhan, sesuai dengan belas kasihan-Mu, biarlah kiranya murka dan amarah-Mu berlalu dari Yerusalem, kota-Mu, gunung-Mu yang kudus; sebab oleh karena dosa kami dan oleh karena kesalahan nenek moyang kami maka Yerusalem dan umat-Mu telah menjadi cela bagi semua orang yang di sekeliling kami."
 },
 {
   "id": 22010,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 17,
   "firman": "Oleh sebab itu, dengarkanlah, ya Allah kami, doa hamba-Mu ini dan permohonannya, dan sinarilah tempat kudus-Mu yang telah musnah ini dengan wajah-Mu, demi Tuhan sendiri."
 },
 {
   "id": 22011,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 18,
   "firman": "Ya Allahku, arahkanlah telinga-Mu dan dengarlah, bukalah mata-Mu dan lihatlah kebinasaan kami dan kota yang disebut dengan nama-Mu, sebab kami menyampaikan doa permohonan kami ke hadapan-Mu bukan berdasarkan jasa-jasa kami, tetapi berdasarkan kasih sayang-Mu yang berlimpah-limpah."
 },
 {
   "id": 22012,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 19,
   "firman": "Ya Tuhan, dengarlah! Ya, Tuhan, ampunilah! Ya Tuhan, perhatikanlah dan bertindaklah dengan tidak bertangguh, oleh karena Engkau sendiri, Allahku, sebab kota-Mu dan umat-Mu disebut dengan nama-Mu!\""
 },
 {
   "id": 22013,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 20,
   "firman": "Sementara aku berbicara dan berdoa dan mengaku dosaku dan dosa bangsaku, bangsa Israel, dan menyampaikan ke hadapan TUHAN, Allahku, permohonanku bagi gunung kudus Allahku,"
 },
 {
   "id": 22014,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 21,
   "firman": "sementara aku berbicara dalam doa, terbanglah dengan cepat ke arahku Gabriel, dia yang telah kulihat dalam penglihatan yang dahulu itu pada waktu persembahan korban petang hari."
 },
 {
   "id": 22015,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 22,
   "firman": "Lalu ia mengajari aku dan berbicara dengan aku: \"Daniel, sekarang aku datang untuk memberi akal budi kepadamu untuk mengerti."
 },
 {
   "id": 22016,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 23,
   "firman": "Ketika engkau mulai menyampaikan permohonan keluarlah suatu firman, maka aku datang untuk memberitahukannya kepadamu, sebab engkau sangat dikasihi. Jadi camkanlah firman itu dan perhatikanlah penglihatan itu!"
 },
 {
   "id": 22017,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 24,
   "firman": "Tujuh puluh kali tujuh masa telah ditetapkan atas bangsamu dan atas kotamu yang kudus, untuk melenyapkan kefasikan, untuk mengakhiri dosa, untuk menghapuskan kesalahan, untuk mendatangkan keadilan yang kekal, untuk menggenapkan penglihatan dan nabi, dan untuk mengurapi yang maha kudus."
 },
 {
   "id": 22018,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 25,
   "firman": "Maka ketahuilah dan pahamilah: dari saat firman itu keluar, yakni bahwa Yerusalem akan dipulihkan dan dibangun kembali, sampai pada kedatangan seorang yang diurapi, seorang raja, ada tujuh kali tujuh masa; dan enam puluh dua kali tujuh masa lamanya kota itu akan dibangun kembali dengan tanah lapang dan paritnya, tetapi di tengah-tengah kesulitan."
 },
 {
   "id": 22019,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sesudah keenam puluh dua kali tujuh masa itu akan disingkirkan seorang yang telah diurapi, padahal tidak ada salahnya apa-apa. Maka datanglah rakyat seorang raja memusnahkan kota dan tempat kudus itu, tetapi raja itu akan menemui ajalnya dalam air bah; dan sampai pada akhir zaman akan ada peperangan dan pemusnahan, seperti yang telah ditetapkan."
 },
 {
   "id": 22020,
   "kitab": "Dan",
   "pasal": 9,
   "ayat": 27,
   "firman": "Raja itu akan membuat perjanjian itu menjadi berat bagi banyak orang selama satu kali tujuh masa. Pada pertengahan tujuh masa itu ia akan menghentikan korban sembelihan dan korban santapan; dan di atas sayap kekejian akan datang yang membinasakan, sampai pemusnahan yang telah ditetapkan menimpa yang membinasakan itu.\""
 },
 {
   "id": 22021,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 1,
   "firman": "Pada tahun ketiga pemerintahan Koresh, raja orang Persia, suatu firman dinyatakan kepada Daniel yang diberi nama Beltsazar; firman itu benar dan mengenai kesusahan yang besar. Maka dicamkannyalah firman itu dan diperhatikannyalah penglihatan itu."
 },
 {
   "id": 22022,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 2,
   "firman": "Pada waktu itu aku, Daniel, berkabung tiga minggu penuh:"
 },
 {
   "id": 22023,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 3,
   "firman": "makanan yang sedap tidak kumakan, daging dan anggur tidak masuk ke dalam mulutku dan aku tidak berurap sampai berlalu tiga minggu penuh."
 },
 {
   "id": 22024,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 4,
   "firman": "Pada hari kedua puluh empat bulan pertama, ketika aku ada di tepi sungai besar, yakni sungai Tigris,"
 },
 {
   "id": 22025,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 5,
   "firman": "kuangkat mukaku, lalu kulihat, tampak seorang yang berpakaian kain lenan dan berikat pinggang emas dari ufas."
 },
 {
   "id": 22026,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 6,
   "firman": "Tubuhnya seperti permata Tarsis dan wajahnya seperti cahaya kilat; matanya seperti suluh yang menyala-nyala, lengan dan kakinya seperti kilau tembaga yang digilap, dan suara ucapannya seperti gaduh orang banyak."
 },
 {
   "id": 22027,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 7,
   "firman": "Hanya aku, Daniel, melihat penglihatan itu, tetapi orang-orang yang bersama-sama dengan aku, tidak melihatnya; tetapi mereka ditimpa oleh ketakutan yang besar, sehingga mereka lari bersembunyi;"
 },
 {
   "id": 22028,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 8,
   "firman": "demikianlah aku tinggal seorang diri. Ketika aku melihat penglihatan yang besar itu, hilanglah kekuatanku; aku menjadi pucat sama sekali, dan tidak ada lagi kekuatan padaku."
 },
 {
   "id": 22029,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 9,
   "firman": "Lalu kudengar suara ucapannya, dan ketika aku mendengar suara ucapannya itu, jatuh pingsanlah aku tertelungkup dengan mukaku ke tanah."
 },
 {
   "id": 22030,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 10,
   "firman": "Tetapi ada suatu tangan menyentuh aku dan membuat aku bangun sambil bertumpu pada lutut dan tanganku."
 },
 {
   "id": 22031,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 11,
   "firman": "Katanya kepadaku: \"Daniel, engkau orang yang dikasihi, camkanlah firman yang kukatakan kepadamu, dan berdirilah pada kakimu, sebab sekarang aku diutus kepadamu.\" Ketika hal ini dikatakannya kepadaku, berdirilah aku dengan gemetar."
 },
 {
   "id": 22032,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 12,
   "firman": "Lalu katanya kepadaku: \"Janganlah takut, Daniel, sebab telah didengarkan perkataanmu sejak hari pertama engkau berniat untuk mendapat pengertian dan untuk merendahkan dirimu di hadapan Allahmu, dan aku datang oleh karena perkataanmu itu."
 },
 {
   "id": 22033,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 13,
   "firman": "Pemimpin kerajaan orang Persia berdiri dua puluh satu hari lamanya menentang aku; tetapi kemudian Mikhael, salah seorang dari pemimpin-pemimpin terkemuka, datang menolong aku, dan aku meninggalkan dia di sana berhadapan dengan raja-raja orang Persia."
 },
 {
   "id": 22034,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 14,
   "firman": "Lalu aku datang untuk membuat engkau mengerti apa yang akan terjadi pada bangsamu pada hari-hari yang terakhir; sebab penglihatan ini juga mengenai hari-hari itu.\""
 },
 {
   "id": 22035,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 15,
   "firman": "Ketika dikatakannya hal ini kepadaku, kutundukkan mukaku ke tanah dan aku terkelu."
 },
 {
   "id": 22036,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 16,
   "firman": "Tetapi sesuatu yang menyerupai manusia menyentuh bibirku; lalu kubuka mulutku dan mulai berbicara, kataku kepada yang berdiri di depanku itu: \"Tuanku, oleh sebab penglihatan itu aku ditimpa kesakitan, dan tidak ada lagi kekuatan padaku."
 },
 {
   "id": 22037,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 17,
   "firman": "Masakan aku, hamba tuanku ini dapat berbicara dengan tuanku! Bukankah tidak ada lagi kekuatan padaku dan tidak ada lagi nafas padaku?\""
 },
 {
   "id": 22038,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lalu dia yang rupanya seperti manusia itu menyentuh aku pula dan memberikan aku kekuatan,"
 },
 {
   "id": 22039,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 19,
   "firman": "dan berkata: \"Hai engkau yang dikasihi, janganlah takut, sejahteralah engkau, jadilah kuat, ya, jadilah kuat!\" Sementara ia berbicara dengan aku, aku merasa kuat lagi dan berkata: \"Berbicaralah kiranya tuanku, sebab engkau telah memberikan aku kekuatan.\""
 },
 {
   "id": 22040,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 20,
   "firman": "Lalu katanya: \"Tahukah engkau, mengapa aku datang kepadamu? Sebentar lagi aku kembali untuk berperang dengan pemimpin orang Persia, dan sesudah aku selesai dengan dia, maka pemimpin orang Yunani akan datang."
 },
 {
   "id": 22041,
   "kitab": "Dan",
   "pasal": 10,
   "ayat": 21,
   "firman": "Namun demikian, aku akan memberitahukan kepadamu apa yang tercantum dalam Kitab Kebenaran. Tidak ada satupun yang berdiri di pihakku dengan tetap hati melawan mereka, kecuali Mikhael, pemimpinmu itu,"
 },
 {
   "id": 22042,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 1,
   "firman": "seperti dahulu aku juga mendampinginya untuk menguatkan dan menyokongnya, yakni pada tahun pertama pemerintahan Darius, orang Media itu.\""
 },
 {
   "id": 22043,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 2,
   "firman": "\"Oleh sebab itu, aku akan memberitahukan kepadamu hal yang benar. Sesungguhnya, tiga raja lagi akan muncul di negeri Persia, dan yang keempat akan mendapat kekayaan yang lebih besar dari mereka semua, dan apabila ia telah menjadi kuat karena kekayaannya, ia akan berusaha sekuat-kuatnya untuk melawan kerajaan Yunani."
 },
 {
   "id": 22044,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 3,
   "firman": "Kemudian akan muncul seorang raja yang gagah perkasa, yang akan memerintah dengan kekuasaan yang besar dan akan berbuat sekehendaknya."
 },
 {
   "id": 22045,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tetapi baru saja ia muncul, maka kerajaannya akan pecah dan terbagi-bagi menurut keempat mata angin dari langit, jatuh bukan kepada keturunannya, dan tanpa kekuasaan seperti yang dipunyainya; sebab kerajaannya akan runtuh dan menjadi milik orang-orang yang lain dari pada orang-orang ini."
 },
 {
   "id": 22046,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 5,
   "firman": "Maka raja negeri Selatan akan menjadi kuat; tetapi salah seorang dari panglima-panglimanya akan menjadi lebih kuat dari padanya dan orang ini memerintah, lalu kekuasaannya akan menjadi kekuasaan yang besar."
 },
 {
   "id": 22047,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 6,
   "firman": "Beberapa tahun kemudian keduanya akan bersekutu: puteri raja negeri Selatan akan datang kepada raja negeri Utara untuk mengadakan persetujuan. Tetapi puteri itu tidak berhasil, juga keturunannya tidak dapat bertahan: puteri itu akan diserahkan, demikian pula orang-orang yang mengantarnya, anak yang dilahirkannya dan orang yang mengawininya."
 },
 {
   "id": 22048,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 7,
   "firman": "Dan pada waktu itu akan tumbuh suatu tunas yang seakar dengan puteri itu menggantikan orang itu, dan orang ini akan bergerak maju melawan tentara raja negeri Utara dan memasuki kota bentengnya, dan ia akan bertindak terhadap mereka dan ia akan berkuasa."
 },
 {
   "id": 22049,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 8,
   "firman": "Bahkan dewa-dewa mereka dan patung-patung tuangan mereka dan barang-barang mereka yang berharga dari perak dan emas akan diangkutnya sebagai jarahan ke Mesir, lalu beberapa tahun lamanya ia akan berhenti berperang melawan raja negeri Utara."
 },
 {
   "id": 22050,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 9,
   "firman": "Kemudian raja ini akan memasuki kerajaan raja negeri Selatan, tetapi kemudian pulang ke negerinya sendiri."
 },
 {
   "id": 22051,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 10,
   "firman": "Kemudian anak-anaknya akan bersiap untuk berperang, dan akan mengerahkan sejumlah tentara yang besar, lalu salah seorang dari mereka itu akan bergerak maju melawan dia, menggenangi dan meliputi semuanya seperti air bah; dan pada serbuan yang kedua kalinya ia akan sampai ke benteng musuhnya."
 },
 {
   "id": 22052,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 11,
   "firman": "Maka menggeramlah raja negeri Selatan itu, lalu maju berperang melawan raja negeri Utara, yang telah mengerahkan sejumlah tentara besar, dan tentara besar itu akan jatuh ke tangan musuhnya."
 },
 {
   "id": 22053,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 12,
   "firman": "Setelah tentara besar itu dihancurkannya, maka hatinya akan bermegah; walaupun ia telah menewaskan berlaksa-laksa orang, ia tidak akan mempunyai kekuatan."
 },
 {
   "id": 22054,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 13,
   "firman": "Lalu untuk kedua kalinya raja negeri Utara itu akan mengerahkan sejumlah tentara besar, lebih besar dari yang pertama, dan beberapa tahun kemudian, ia akan bergerak maju melawan dia dengan tentara yang besar dan dengan banyak perlengkapan perang."
 },
 {
   "id": 22055,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 14,
   "firman": "Pada waktu itu banyak orang akan bangkit melawan raja negeri Selatan; juga orang-orang yang lalim dari bangsamu akan membesarkan diri, sehingga penglihatan itu menjadi kenyataan, tetapi mereka akan tergelincir."
 },
 {
   "id": 22056,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 15,
   "firman": "Maka raja negeri Utara itu akan datang, mendirikan kubu pengepungan dan merebut kota yang berbenteng; dan tentara negeri Selatan tidak akan dapat bertahan, juga pasukan-pasukan pilihannya sekalipun, ya, tidak ada kekuatan apapun yang dapat bertahan,"
 },
 {
   "id": 22057,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 16,
   "firman": "sehingga raja yang menyerangnya akan berbuat sekehendak hati, dan tidak ada seorangpun yang dapat bertahan menghadapinya; ia akan menduduki Tanah Permai dan seluruhnya akan ada dalam kekuasaannya."
 },
 {
   "id": 22058,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 17,
   "firman": "Kemudian ia akan berusaha untuk menguasai seluruh kerajaan orang yang lain itu: ia akan mengadakan persetujuan dengan dia, dan seorang puterinya diberikannya kepadanya untuk menghancurkan kerajaan itu, tetapi maksudnya itu tidak akan berhasil dan tidak akan menguntungkannya."
 },
 {
   "id": 22059,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 18,
   "firman": "Lalu ia akan memalingkan mukanya ke tanah-tanah pesisir dan banyak yang direbutnya; tetapi seorang panglima akan menghentikan penghinaannya itu, bahkan akan mengembalikan penghinaan itu kepadanya."
 },
 {
   "id": 22060,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 19,
   "firman": "Sesudah itu ia akan memalingkan mukanya ke kota-kota benteng di negerinya sendiri; tetapi ia akan tergelincir dan jatuh dan tidak akan ditemukan lagi."
 },
 {
   "id": 22061,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 20,
   "firman": "Menggantikan dia akan muncul seorang yang menyuruh seorang pemungut pajak menjalani bagian yang terindah dari kerajaan itu, tetapi beberapa hari kemudian ia akan dibinasakan, bukan oleh kemarahan atau oleh peperangan."
 },
 {
   "id": 22062,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 21,
   "firman": "Menggantikan dia akan muncul seorang yang hina, yang tidak memperoleh martabat raja; tetapi dengan tak disangka-sangka ia akan datang merebut kedudukan raja dengan perbuatan-perbuatan licin."
 },
 {
   "id": 22063,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 22,
   "firman": "Seluruh tentara yang datang melanda akan dihanyutkan di hadapannya dan dihancurkan, bahkan juga seorang raja Perjanjian."
 },
 {
   "id": 22064,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 23,
   "firman": "Dan dari saat diadakan persekutuan dengan dia, ia akan berlaku curang, dan ia akan maju serta menjadi berkuasa, meskipun sedikit orang-orangnya."
 },
 {
   "id": 22065,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 24,
   "firman": "Dengan tak disangka-sangka ia akan memasuki daerah-daerah yang paling subur dari negeri itu, dan melakukan apa yang belum pernah dilakukan oleh para bapa dan nenek moyangnya, yakni menghamburkan rampasan dan jarahan dan harta di antara orang-orangnya; juga terhadap tempat-tempat yang berbenteng ia membuat siasat, tetapi hanya untuk sementara waktu."
 },
 {
   "id": 22066,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 25,
   "firman": "Kekuatan dan keberaniannya akan ditujukannya melawan raja negeri Selatan dengan memakai tentara yang besar; dan walaupun raja negeri Selatan itu akan bersiap untuk berperang dengan tentara yang amat besar dan kuat, ia tidak akan dapat bertahan, sebab akan diadakan siasat terhadap dia,"
 },
 {
   "id": 22067,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 26,
   "firman": "dan orang-orang yang makan dari santapannya akan meruntuhkannya: tentaranya akan hanyut dan banyak orangnya yang tewas dibunuh."
 },
 {
   "id": 22068,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 27,
   "firman": "Dan kedua raja itu bermaksud jahat, dan sedang mereka duduk bersama-sama pada satu meja, mereka akan saling membohongi; tetapi hal itu tidak akan berhasil, sebab akhir zaman itu belum mencapai waktu yang ditetapkan."
 },
 {
   "id": 22069,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 28,
   "firman": "Kemudian ia akan pulang ke negerinya dengan banyak harta, dan hatinya bermaksud menentang Perjanjian Kudus; dan itu dilakukannya, lalu pulang ke negerinya."
 },
 {
   "id": 22070,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 29,
   "firman": "Pada waktu yang ditetapkan ia akan memasuki pula negeri Selatan, tetapi kali yang kedua ini tidak akan sama dengan yang pertama,"
 },
 {
   "id": 22071,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 30,
   "firman": "karena akan datang kapal-kapal orang Kitim melawan dia, sehingga hilanglah keberaniannya. Lalu pulanglah ia dengan hati mendendam terhadap Perjanjian Kudus dan ia akan bertindak: setelah pulang kembali, ia akan menujukan perhatiannya kepada mereka yang meninggalkan Perjanjian Kudus."
 },
 {
   "id": 22072,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 31,
   "firman": "Tentaranya akan muncul, mereka akan menajiskan tempat kudus, benteng itu, menghapuskan korban sehari-hari dan menegakkan kekejian yang membinasakan."
 },
 {
   "id": 22073,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 32,
   "firman": "Dan orang-orang yang berlaku fasik terhadap Perjanjian akan dibujuknya sampai murtad dengan kata-kata licin; tetapi umat yang mengenal Allahnya akan tetap kuat dan akan bertindak."
 },
 {
   "id": 22074,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 33,
   "firman": "Dan orang-orang bijaksana di antara umat itu akan membuat banyak orang mengerti, tetapi untuk beberapa waktu lamanya mereka akan jatuh oleh karena pedang dan api, oleh karena ditawan dan dirampas."
 },
 {
   "id": 22075,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 34,
   "firman": "Sementara jatuh, mereka akan mendapat pertolongan sedikit, dan banyak orang akan menggabungkan diri kepada mereka secara berpura-pura."
 },
 {
   "id": 22076,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 35,
   "firman": "Sebagian dari orang-orang bijaksana itu akan jatuh, supaya dengan demikian diadakan pengujian, penyaringan dan pemurnian di antara mereka, sampai pada akhir zaman; sebab akhir zaman itu belum mencapai waktu yang telah ditetapkan."
 },
 {
   "id": 22077,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 36,
   "firman": "Raja itu akan berbuat sekehendak hati; ia akan meninggikan dan membesarkan dirinya terhadap setiap allah. Juga terhadap Allah yang mengatasi segala allah ia akan mengucapkan kata-kata yang tak senonoh sama sekali, dan ia akan beruntung sampai akhir murka itu; sebab apa yang telah ditetapkan akan terjadi."
 },
 {
   "id": 22078,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 37,
   "firman": "Juga para allah nenek moyangnya tidak akan diindahkannya; baik pujaan orang-orang perempuan maupun allah manapun juga tidak akan diindahkannya, sebab terhadap semuanya itu ia akan membesarkan diri."
 },
 {
   "id": 22079,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 38,
   "firman": "Tetapi sebagai ganti semuanya itu ia akan menghormati dewa benteng-benteng: dewa yang tidak dikenal oleh nenek moyangnya akan dihormatinya dengan membawa emas dan perak dan permata dan barang-barang yang berharga."
 },
 {
   "id": 22080,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 39,
   "firman": "Dan ia akan bertindak terhadap benteng-benteng yang diperkuat dengan pertolongan dewa asing itu. Siapa yang mengakui dewa ini akan dilimpahi kehormatan; ia akan membuat mereka menjadi berkuasa atas banyak orang dan kepada mereka akan dibagikannya tanah sebagai upah."
 },
 {
   "id": 22081,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 40,
   "firman": "Tetapi pada akhir zaman raja negeri Selatan akan berperang dengan dia, dan raja negeri Utara itu akan menyerbunya dengan kereta dan orang-orang berkuda dan dengan banyak kapal; dan ia akan memasuki negeri-negeri, dan menggenangi dan meliputi semuanya seperti air bah."
 },
 {
   "id": 22082,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 41,
   "firman": "Juga Tanah Permai akan dimasukinya, dan banyak orang akan jatuh; tetapi dari tangannya akan terluput tanah Edom, tanah Moab dan bagian yang penting dari bani Amon."
 },
 {
   "id": 22083,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 42,
   "firman": "Ia akan menjangkau negeri-negeri, dan negeri Mesir tidak akan terluput."
 },
 {
   "id": 22084,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 43,
   "firman": "Ia akan menguasai harta benda emas dan perak dan segala barang berharga negeri Mesir, dan orang Libia serta orang Etiopia akan mengikuti dia."
 },
 {
   "id": 22085,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 44,
   "firman": "Tetapi kabar-kabar dari sebelah timur dan dari sebelah utara akan mengejutkan hatinya, sehingga ia akan keluar dengan kegeraman yang besar untuk memusnahkan dan membinasakan banyak orang."
 },
 {
   "id": 22086,
   "kitab": "Dan",
   "pasal": 11,
   "ayat": 45,
   "firman": "Ia akan mendirikan kemah kebesarannya di antara laut dan gunung Permai yang kudus itu, tetapi kemudian ia akan menemui ajalnya dan tidak ada seorangpun yang menolongnya.\""
 },
 {
   "id": 22087,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 1,
   "firman": "\"Pada waktu itu juga akan muncul Mikhael, pemimpin besar itu, yang akan mendampingi anak-anak bangsamu; dan akan ada suatu waktu kesesakan yang besar, seperti yang belum pernah terjadi sejak ada bangsa-bangsa sampai pada waktu itu. Tetapi pada waktu itu bangsamu akan terluput, yakni barangsiapa yang didapati namanya tertulis dalam Kitab itu."
 },
 {
   "id": 22088,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 2,
   "firman": "Dan banyak dari antara orang-orang yang telah tidur di dalam debu tanah, akan bangun, sebagian untuk mendapat hidup yang kekal, sebagian untuk mengalami kehinaan dan kengerian yang kekal."
 },
 {
   "id": 22089,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 3,
   "firman": "Dan orang-orang bijaksana akan bercahaya seperti cahaya cakrawala, dan yang telah menuntun banyak orang kepada kebenaran seperti bintang-bintang, tetap untuk selama-lamanya."
 },
 {
   "id": 22090,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 4,
   "firman": "Tetapi engkau, Daniel, sembunyikanlah segala firman itu, dan meteraikanlah Kitab itu sampai pada akhir zaman; banyak orang akan menyelidikinya, dan pengetahuan akan bertambah.\""
 },
 {
   "id": 22091,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 5,
   "firman": "Kemudian aku, Daniel, melihat, maka tampaklah berdiri dua orang lain, seorang di tepi sungai sebelah sini dan yang lain di tepi sungai yang sebelah sana."
 },
 {
   "id": 22092,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 6,
   "firman": "Dan yang seorang bertanya kepada yang berpakaian kain lenan, yang ada di sebelah atas air sungai itu: \"Bilakah hal-hal yang ajaib ini akan berakhir?\""
 },
 {
   "id": 22093,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 7,
   "firman": "Lalu kudengar orang yang berpakaian kain lenan, yang ada di sebelah atas air sungai itu bersumpah demi Dia yang hidup kekal, sambil mengangkat tangan kanan dan tangan kirinya ke langit: \"Satu masa dan dua masa dan setengah masa; dan setelah berakhir kuasa perusak bangsa yang kudus itu, maka segala hal ini akan digenapi!\""
 },
 {
   "id": 22094,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 8,
   "firman": "Adapun aku, memang kudengar hal itu, tetapi tidak memahaminya, lalu kutanya: \"Tuanku, apakah akhir segala hal ini?\""
 },
 {
   "id": 22095,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 9,
   "firman": "Tetapi ia menjawab: \"Pergilah, Daniel, sebab firman ini akan tinggal tersembunyi dan termeterai sampai akhir zaman."
 },
 {
   "id": 22096,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 10,
   "firman": "Banyak orang akan disucikan dan dimurnikan dan diuji, tetapi orang-orang fasik akan berlaku fasik; tidak seorangpun dari orang fasik itu akan memahaminya, tetapi orang-orang bijaksana akan memahaminya."
 },
 {
   "id": 22097,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 11,
   "firman": "Sejak dihentikan korban sehari-hari dan ditegakkan dewa-dewa kekejian yang membinasakan itu ada seribu dua ratus dan sembilan puluh hari."
 },
 {
   "id": 22098,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 12,
   "firman": "Berbahagialah orang yang tetap menanti-nanti dan mencapai seribu tiga ratus tiga puluh lima hari."
 },
 {
   "id": 22099,
   "kitab": "Dan",
   "pasal": 12,
   "ayat": 13,
   "firman": "Tetapi engkau, pergilah sampai tiba akhir zaman, dan engkau akan beristirahat, dan akan bangkit untuk mendapat bagianmu pada kesudahan zaman.\""
 },
 {
   "id": 22100,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada Hosea bin Beeri pada zaman Uzia, Yotam, Ahas dan Hizkia, raja-raja Yehuda, dan pada zaman Yerobeam bin Yoas, raja Israel."
 },
 {
   "id": 22101,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 2,
   "firman": "Ketika TUHAN mulai berbicara dengan perantaraan Hosea, berfirmanlah Ia kepada Hosea: \"Pergilah, kawinilah seorang perempuan sundal dan peranakkanlah anak-anak sundal, karena negeri ini bersundal hebat dengan membelakangi TUHAN.\""
 },
 {
   "id": 22102,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 3,
   "firman": "Maka pergilah ia dan mengawini Gomer binti Diblaim, lalu mengandunglah perempuan itu dan melahirkan baginya seorang anak laki-laki."
 },
 {
   "id": 22103,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 4,
   "firman": "Kemudian berfirmanlah TUHAN kepada Hosea: \"Berilah nama Yizreel kepada anak itu, sebab sedikit waktu lagi maka Aku akan menghukum keluarga Yehu karena hutang darah Yizreel dan Aku akan mengakhiri pemerintahan kaum Israel."
 },
 {
   "id": 22104,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 5,
   "firman": "Maka pada waktu itu Aku akan mematahkan busur panah Israel di lembah Yizreel.\""
 },
 {
   "id": 22105,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 6,
   "firman": "Lalu perempuan itu mengandung lagi dan melahirkan seorang anak perempuan. Berfirmanlah TUHAN kepada Hosea: \"Berilah nama Lo-Ruhama kepada anak itu, sebab Aku tidak akan menyayangi lagi kaum Israel, dan sama sekali tidak akan mengampuni mereka."
 },
 {
   "id": 22106,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 7,
   "firman": "Tetapi Aku akan menyayangi kaum Yehuda dan menyelamatkan mereka demi TUHAN, Allah mereka. Aku akan menyelamatkan mereka bukan dengan panah atau pedang, dengan alat perang atau dengan kuda dan orang-orang berkuda.\""
 },
 {
   "id": 22107,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sesudah menyapih Lo-Ruhama, mengandunglah perempuan itu lagi dan melahirkan seorang anak laki-laki."
 },
 {
   "id": 22108,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 9,
   "firman": "Lalu berfirmanlah Ia: \"Berilah nama Lo-Ami kepada anak itu, sebab kamu ini bukanlah umat-Ku dan Aku ini bukanlah Allahmu.\""
 },
 {
   "id": 22109,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 10,
   "firman": "Tetapi kelak, jumlah orang Israel akan seperti pasir laut, yang tidak dapat ditakar dan tidak dapat dihitung. Dan di tempat di mana dikatakan kepada mereka: \"Kamu ini bukanlah umat-Ku,\" akan dikatakan kepada mereka: \"Anak-anak Allah yang hidup.\""
 },
 {
   "id": 22110,
   "kitab": "Hos",
   "pasal": 1,
   "ayat": 11,
   "firman": "Orang Yehuda dan orang Israel akan berkumpul bersama-sama dan akan mengangkat bagi mereka satu pemimpin, lalu mereka akan menduduki negeri ini, sebab besar hari Yizreel itu."
 },
 {
   "id": 22111,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 1,
   "firman": "(1-12) Katakanlah kepada saudara-saudaramu laki-laki: \"Ami!\" dan kepada saudara-saudaramu perempuan: \"Ruhama!\""
 },
 {
   "id": 22112,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 2,
   "firman": "(2-1) \"Adukanlah ibumu, adukanlah, sebab dia bukan isteri-Ku, dan Aku ini bukan suaminya; biarlah dijauhkannya sundalnya dari mukanya, dan zinahnya dari antara buah dadanya,"
 },
 {
   "id": 22113,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 3,
   "firman": "(2-2) supaya jangan Aku menanggalkan pakaiannya sampai dia telanjang, dan membiarkan dia seperti pada hari dia dilahirkan, membuat dia seperti padang gurun, dan membuat dia seperti tanah kering, lalu membiarkan dia mati kehausan."
 },
 {
   "id": 22114,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 4,
   "firman": "(2-3) Tentang anak-anaknya, Aku tidak menyayangi mereka, sebab mereka adalah anak-anak sundal."
 },
 {
   "id": 22115,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 5,
   "firman": "(2-4) Sebab ibu mereka telah menjadi sundal; dia yang mengandung mereka telah berlaku tidak senonoh. Sebab dia berkata: Aku mau mengikuti para kekasihku, yang memberi roti dan air minumku, bulu domba dan kain lenanku, minyak dan minumanku."
 },
 {
   "id": 22116,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 6,
   "firman": "(2-5) Sebab itu, sesungguhnya, Aku akan menyekat jalannya dengan duri-duri, dan mendirikan pagar tembok mengurung dia, sehingga dia tidak dapat menemui jalannya."
 },
 {
   "id": 22117,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 7,
   "firman": "(2-6) Dia akan mengejar para kekasihnya, tetapi tidak akan mencapai mereka; dia akan mencari mereka, tetapi tidak bertemu dengan mereka. Maka dia akan berkata: Aku akan pulang kembali kepada suamiku yang pertama, sebab waktu itu aku lebih berbahagia dari pada sekarang."
 },
 {
   "id": 22118,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 8,
   "firman": "(2-7) Tetapi dia tidak insaf bahwa Akulah yang memberi kepadanya gandum, anggur dan minyak, dan yang memperbanyak bagi dia perak dan emas yang dibuat mereka menjadi patung Baal."
 },
 {
   "id": 22119,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 9,
   "firman": "(2-8) Sebab itu Aku akan mengambil kembali gandum-Ku pada masanya dan anggur-Ku pada musimnya, dan akan merampas kain bulu domba dan kain lenan-Ku yang harus menutupi auratnya."
 },
 {
   "id": 22120,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 10,
   "firman": "(2-9) Dan sekarang, Aku akan menyingkapkan kemaluannya, di depan mata para kekasihnya, dan seorangpun tidak akan melepaskan dia dari tangan-Ku."
 },
 {
   "id": 22121,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 11,
   "firman": "(2-10) Aku akan menghentikan segala kegirangannya, hari rayanya, bulan barunya dan hari Sabatnya dan segala perayaannya."
 },
 {
   "id": 22122,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 12,
   "firman": "(2-11) Aku akan memusnahkan pohon anggurnya dan pohon aranya, yang tentangnya dikatakannya: Ini semuanya pemberian kepadaku, yang dihadiahkan kepadaku oleh para kekasihku! Aku akan membuatnya menjadi hutan, dan binatang-binatang di padang akan memakannya habis."
 },
 {
   "id": 22123,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 13,
   "firman": "(2-12) Dan Aku akan menghukum dia karena hari-hari ketika dia membakar korban untuk para Baal, berhias dengan anting-antingnya dan kalungnya, dan mengikuti para kekasihnya dan melupakan Aku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22124,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 14,
   "firman": "(2-13) \"Sebab itu, sesungguhnya, Aku ini akan membujuk dia, dan membawa dia ke padang gurun, dan berbicara menenangkan hatinya."
 },
 {
   "id": 22125,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 15,
   "firman": "(2-14) Aku akan memberikan kepadanya kebun anggurnya dari sana, dan membuat lembah Akhor menjadi pintu pengharapan. Maka dia akan merelakan diri di sana seperti pada masa mudanya, seperti pada waktu dia berangkat keluar dari tanah Mesir."
 },
 {
   "id": 22126,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 16,
   "firman": "(2-15) Maka pada waktu itu, demikianlah firman TUHAN, engkau akan memanggil Aku: Suamiku, dan tidak lagi memanggil Aku: Baalku!"
 },
 {
   "id": 22127,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 17,
   "firman": "(2-16) Lalu Aku menjauhkan nama para Baal dari mulutmu, maka nama mereka tidak lagi disebut."
 },
 {
   "id": 22128,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 18,
   "firman": "(2-17) Aku akan mengikat perjanjian bagimu pada waktu itu dengan binatang-binatang di padang dan dengan burung-burung di udara, dan binatang-binatang melata di muka bumi; Aku akan meniadakan busur panah, pedang dan alat perang dari negeri, dan akan membuat engkau berbaring dengan tenteram."
 },
 {
   "id": 22129,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 19,
   "firman": "(2-18) Aku akan menjadikan engkau isteri-Ku untuk selama-lamanya dan Aku akan menjadikan engkau isteri-Ku dalam keadilan dan kebenaran, dalam kasih setia dan kasih sayang."
 },
 {
   "id": 22130,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 20,
   "firman": "(2-19) Aku akan menjadikan engkau isteri-Ku dalam kesetiaan, sehingga engkau akan mengenal TUHAN."
 },
 {
   "id": 22131,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 21,
   "firman": "(2-20) Maka pada waktu itu, demikianlah firman TUHAN, Aku akan mendengarkan langit, dan langit akan mendengarkan bumi."
 },
 {
   "id": 22132,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 22,
   "firman": "(2-21) Bumi akan mendengarkan gandum, anggur dan minyak, dan mereka ini akan mendengarkan Yizreel."
 },
 {
   "id": 22133,
   "kitab": "Hos",
   "pasal": 2,
   "ayat": 23,
   "firman": "(2-22) Aku akan menaburkan dia bagi-Ku di bumi, dan akan menyayangi Lo-Ruhama, dan Aku berkata kepada Lo-Ami: Umat-Ku engkau! dan ia akan berkata: Allahku!\""
 },
 {
   "id": 22134,
   "kitab": "Hos",
   "pasal": 3,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepadaku: \"Pergilah lagi, cintailah perempuan yang suka bersundal dan berzinah, seperti TUHAN juga mencintai orang Israel, sekalipun mereka berpaling kepada allah-allah lain dan menyukai kue kismis.\""
 },
 {
   "id": 22135,
   "kitab": "Hos",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu aku membeli dia bagiku dengan bayaran lima belas syikal perak dan satu setengah homer jelai."
 },
 {
   "id": 22136,
   "kitab": "Hos",
   "pasal": 3,
   "ayat": 3,
   "firman": "Aku berkata kepadanya: \"Lama engkau harus diam padaku dengan tidak bersundal dan dengan tidak menjadi kepunyaan seorang laki-laki; juga aku ini tidak akan bersetubuh dengan engkau.\""
 },
 {
   "id": 22137,
   "kitab": "Hos",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sebab lama orang Israel akan diam dengan tidak ada raja, tiada pemimpin, tiada korban, tiada tugu berhala dan tiada efod dan terafim."
 },
 {
   "id": 22138,
   "kitab": "Hos",
   "pasal": 3,
   "ayat": 5,
   "firman": "Sesudah itu orang Israel akan berbalik dan akan mencari TUHAN, Allah mereka, dan Daud, raja mereka. Mereka akan datang dengan gementar kepada TUHAN dan kepada kebaikan-Nya pada hari-hari yang terakhir."
 },
 {
   "id": 22139,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 1,
   "firman": "Dengarlah firman TUHAN, hai orang Israel, sebab TUHAN mempunyai perkara dengan penduduk negeri ini, sebab tidak ada kesetiaan dan tidak ada kasih, dan tidak ada pengenalan akan Allah di negeri ini."
 },
 {
   "id": 22140,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 2,
   "firman": "Hanya mengutuk, berbohong, membunuh, mencuri, berzinah, melakukan kekerasan dan penumpahan darah menyusul penumpahan darah."
 },
 {
   "id": 22141,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sebab itu negeri ini akan berkabung, dan seluruh penduduknya akan merana; juga binatang-binatang di padang dan burung-burung di udara, bahkan ikan-ikan di laut akan mati lenyap."
 },
 {
   "id": 22142,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 4,
   "firman": "Hanya janganlah ada orang mengadu, dan janganlah ada orang menegor, sebab terhadap engkaulah pengaduan-Ku itu, hai imam!"
 },
 {
   "id": 22143,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 5,
   "firman": "Engkau akan tergelincir jatuh pada siang hari, juga nabi akan tergelincir jatuh bersama-sama engkau pada malam hari; dan Aku akan membinasakan ibumu."
 },
 {
   "id": 22144,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 6,
   "firman": "Umat-Ku binasa karena tidak mengenal Allah; karena engkaulah yang menolak pengenalan itu maka Aku menolak engkau menjadi imam-Ku; dan karena engkau melupakan pengajaran Allahmu, maka Aku juga akan melupakan anak-anakmu."
 },
 {
   "id": 22145,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 7,
   "firman": "Makin bertambah banyak mereka, makin berdosa mereka kepada-Ku, kemuliaan mereka akan Kutukar dengan kehinaan."
 },
 {
   "id": 22146,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 8,
   "firman": "Mereka mendapat rezeki dari dosa umat-Ku dan mengharapkan umat-Ku itu berbuat salah."
 },
 {
   "id": 22147,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 9,
   "firman": "Maka seperti nasib rakyat demikianlah nasib imam: Aku akan menghukum dia karena tindakan-tindakannya dan Aku akan membalaskan perbuatan-perbuatannya kepadanya."
 },
 {
   "id": 22148,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 10,
   "firman": "Mereka akan makan, tetapi tidak menjadi kenyang, mereka akan bersundal, tetapi tidak menjadi banyak, sebab mereka telah meninggalkan TUHAN untuk berpegang kepada sundal."
 },
 {
   "id": 22149,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 11,
   "firman": "Anggur dan air anggur menghilangkan daya pikir."
 },
 {
   "id": 22150,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 12,
   "firman": "Umat-Ku bertanya kepada pohonnya, dan tongkatnya akan memberitahu kepadanya, sebab roh perzinahan menyesatkan mereka, dan mereka berzinah meninggalkan Allah mereka."
 },
 {
   "id": 22151,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 13,
   "firman": "Mereka mempersembahkan korban di puncak gunung-gunung dan membakar korban di atas bukit-bukit, di bawah pohon besar dan pohon hawar dan pohon rimbun, sebab naungannya baik. Itulah sebabnya anak-anakmu perempuan berzinah dan menantu-menantumu perempuan bersundal."
 },
 {
   "id": 22152,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 14,
   "firman": "Aku tidak akan menghukum anak-anak perempuanmu sekalipun mereka berzinah, atau menantu-menantumu perempuan, sekalipun mereka bersundal; sebab mereka sendiri mengasingkan diri bersama-sama dengan perempuan-perempuan sundal dan mempersembahkan korban bersama-sama dengan sundal-sundal bakti, dan umat yang tidak berpengertian akan runtuh."
 },
 {
   "id": 22153,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 15,
   "firman": "Jika engkau ini berzinah, hai Israel, janganlah Yehuda turut bersalah! Janganlah pergi ke Gilgal, dan janganlah naik ke Bet-Awen, dan janganlah bersumpah: \"Demi TUHAN yang hidup!\""
 },
 {
   "id": 22154,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sebab Israel degil seperti lembu yang degil, masakan sekarang TUHAN menggembalakan mereka, seperti domba di tanah lapang?"
 },
 {
   "id": 22155,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 17,
   "firman": "Efraim bersekutu dengan berhala-berhala, biarkanlah dia!"
 },
 {
   "id": 22156,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 18,
   "firman": "Persepakatan para pemabuk! mereka menyerahkan diri habis-habisan kepada persundalan; mereka lebih mencintai kehinaan dari pada kemasyhuran mereka."
 },
 {
   "id": 22157,
   "kitab": "Hos",
   "pasal": 4,
   "ayat": 19,
   "firman": "Angin melingkupi mereka dalam sayap-sayapnya, dan mereka akan mendapat malu karena korban-korban mereka."
 },
 {
   "id": 22158,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 1,
   "firman": "Dengarlah ini, hai para imam, perhatikanlah, hai kaum Israel, dan pasanglah telinga, hai keluarga raja! Sebab mengenai kamulah penghukuman itu, karena kamu telah menjadi perangkap bagi Mizpa, dan jaring yang dikembangkan di atas gunung Tabor,"
 },
 {
   "id": 22159,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 2,
   "firman": "dan lobang yang dikeruk di lembah Sitim, maka Aku ini akan menghajar mereka sekalian."
 },
 {
   "id": 22160,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 3,
   "firman": "Aku ini mengenal Efraim, dan Israel tidaklah tersembunyi bagi-Ku, sebab engkau telah berzinah, hai Efraim; dan Israel telah menajiskan diri."
 },
 {
   "id": 22161,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 4,
   "firman": "Perbuatan-perbuatan mereka tidak mengizinkan mereka berbalik kepada Allah mereka, sebab roh perzinahan ada di antara mereka, dan mereka tidak mengenal TUHAN."
 },
 {
   "id": 22162,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 5,
   "firman": "Kecongkakan Israel menjadi saksi terhadap dirinya sendiri; Efraim akan tergelincir jatuh oleh kesalahannya sendiri, dan bersama-sama mereka juga Yehuda."
 },
 {
   "id": 22163,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 6,
   "firman": "Dengan korban kambing domba dan lembu sapinya mereka akan pergi untuk mencari TUHAN, tetapi tidak akan menjumpai Dia; Ia telah menarik diri dari mereka."
 },
 {
   "id": 22164,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 7,
   "firman": "Mereka telah berkhianat terhadap TUHAN, sebab mereka telah memperanakkan anak-anak yang tidak sah; sekarang pembinasa akan memakan habis mereka dan ladang mereka."
 },
 {
   "id": 22165,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tiuplah sangkakala di Gibea, dan nafiri di Rama. Berteriaklah di Bet-Awen, gemetarlah, hai Benyamin!"
 },
 {
   "id": 22166,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 9,
   "firman": "Efraim akan menjadi tandus, pada hari penghukuman; mengenai suku-suku Israel Aku memberitahu apa yang pasti."
 },
 {
   "id": 22167,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 10,
   "firman": "Para pemuka Yehuda adalah seperti orang-orang yang menggeser batas; ke atas mereka akan Kucurahkan gemas-Ku seperti air."
 },
 {
   "id": 22168,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 11,
   "firman": "Efraim tertindas, diremukkan oleh hukuman, sebab ia berkeras untuk berjalan mengikuti kesia-siaan."
 },
 {
   "id": 22169,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab itu Aku ini akan seperti ngengat bagi Efraim dan seperti belatung bagi kaum Yehuda."
 },
 {
   "id": 22170,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 13,
   "firman": "Ketika Efraim melihat penyakitnya, dan Yehuda melihat bisulnya, maka pergilah Efraim ke Asyur dan mengutus orang kepada Raja 'Agung'. Tetapi iapun tidak dapat menyembuhkan kamu dan tidak dapat melenyapkan bisul itu dari padamu."
 },
 {
   "id": 22171,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sebab Aku ini seperti singa bagi Efraim, dan seperti singa muda bagi kaum Yehuda. Aku, Aku ini akan menerkam, lalu pergi, Aku akan membawa lari dan tidak ada yang melepaskan."
 },
 {
   "id": 22172,
   "kitab": "Hos",
   "pasal": 5,
   "ayat": 15,
   "firman": "Aku akan pergi pulang ke tempat-Ku, sampai mereka mengaku bersalah dan mencari wajah-Ku. Dalam kesesakannya mereka akan merindukan Aku:"
 },
 {
   "id": 22173,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 1,
   "firman": "\"Mari, kita akan berbalik kepada TUHAN, sebab Dialah yang telah menerkam dan yang akan menyembuhkan kita, yang telah memukul dan yang akan membalut kita."
 },
 {
   "id": 22174,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 2,
   "firman": "Ia akan menghidupkan kita sesudah dua hari, pada hari yang ketiga Ia akan membangkitkan kita, dan kita akan hidup di hadapan-Nya."
 },
 {
   "id": 22175,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 3,
   "firman": "Marilah kita mengenal dan berusaha sungguh-sungguh mengenal TUHAN; Ia pasti muncul seperti fajar, Ia akan datang kepada kita seperti hujan, seperti hujan pada akhir musim yang mengairi bumi.\""
 },
 {
   "id": 22176,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 4,
   "firman": "Apakah yang akan Kulakukan kepadamu, hai Efraim? Apakah yang akan Kulakukan kepadamu, hai Yehuda? Kasih setiamu seperti kabut pagi, dan seperti embun yang hilang pagi-pagi benar."
 },
 {
   "id": 22177,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 5,
   "firman": "Sebab itu Aku telah meremukkan mereka dengan perantaraan nabi-nabi, Aku telah membunuh mereka dengan perkataan mulut-Ku, dan hukum-Ku keluar seperti terang."
 },
 {
   "id": 22178,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 6,
   "firman": "Sebab Aku menyukai kasih setia, dan bukan korban sembelihan, dan menyukai pengenalan akan Allah, lebih dari pada korban-korban bakaran."
 },
 {
   "id": 22179,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 7,
   "firman": "Tetapi mereka itu telah melangkahi perjanjian di Adam, di sana mereka telah berkhianat terhadap Aku."
 },
 {
   "id": 22180,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 8,
   "firman": "Gilead adalah kota para penjahat, penuh dengan jejak darah."
 },
 {
   "id": 22181,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 9,
   "firman": "Seperti gerombolan menghadang demikianlah persekutuan para imam; mereka membunuh di jalan ke Sikhem, sungguh, mereka melakukan perbuatan mesum."
 },
 {
   "id": 22182,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 10,
   "firman": "Di antara kaum Israel telah Kulihat hal-hal yang mengerikan; di sana ada Efraim bersundal dan Israel telah menajiskan diri."
 },
 {
   "id": 22183,
   "kitab": "Hos",
   "pasal": 6,
   "ayat": 11,
   "firman": "Juga bagimu, hai Yehuda, telah ditentukan penuaian: Apabila Aku memulihkan keadaan umat-Ku,"
 },
 {
   "id": 22184,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 1,
   "firman": "apabila Aku menyembuhkan Israel, maka tersingkaplah kesalahan Efraim dan kejahatan-kejahatan Samaria: sebab mereka melakukan penipuan: pencuri mendobrak masuk, gerombolan merampas di luar."
 },
 {
   "id": 22185,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 2,
   "firman": "Dan tidak terpikir mereka bahwa Aku mengingat segala kejahatan mereka. Sekarangpun perbuatan-perbuatan mereka mengepung mereka, semuanya ada di hadapan wajah-Ku."
 },
 {
   "id": 22186,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 3,
   "firman": "Mereka menyukakan raja dengan kejahatan mereka, dan para pemuka dengan kebohongan mereka."
 },
 {
   "id": 22187,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 4,
   "firman": "Sekaliannya mereka orang-orang berzinah, bagaikan dapur perapian yang menyala terus, ketika tukang bakar roti berhenti membesarkan apinya, sementara ia meremas adonan sampai menjadi muai oleh ragi."
 },
 {
   "id": 22188,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 5,
   "firman": "Pada pesta raja kita mereka membuat sakit para pemuka dengan anggur yang menghangatkan; ia bersekutu dengan para pencemooh."
 },
 {
   "id": 22189,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 6,
   "firman": "Batin mereka seperti dapur perapian; hati mereka menyala-nyala; semalam-malaman murka mereka surut, pada waktu pagi menyala kembali seperti api yang menjilat."
 },
 {
   "id": 22190,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 7,
   "firman": "Mereka semua sudah panas seperti dapur perapian, dan memakan habis para hakim mereka. Semua raja mereka sudah tewas, tidak ada seorang di antara mereka yang berseru kepada-Ku."
 },
 {
   "id": 22191,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 8,
   "firman": "Efraim mencampurkan dirinya di antara bangsa-bangsa, Efraim telah menjadi roti bundar yang tidak dibalik."
 },
 {
   "id": 22192,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 9,
   "firman": "Orang-orang luar memakan habis kekuatannya, tetapi ia sendiri tidak mengetahuinya; juga ia sudah banyak beruban, tetapi ia sendiri tidak mengetahuinya."
 },
 {
   "id": 22193,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 10,
   "firman": "Kecongkakan Israel menjadi saksi terhadap dirinya, namun mereka tidak berbalik kepada TUHAN, Allah mereka, dan tidak mencari Dia kendati semuanya ini."
 },
 {
   "id": 22194,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 11,
   "firman": "Efraim telah menjadi merpati tolol, tidak berakal, dengan memanggil kepada Mesir, dengan pergi kepada Asyur."
 },
 {
   "id": 22195,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 12,
   "firman": "Apabila mereka pergi, Aku akan membentangkan jaring-Ku ke atas mereka; Aku akan menurunkan mereka seperti burung-burung di udara, Aku akan menghajar mereka karena kejahatan-kejahatan mereka."
 },
 {
   "id": 22196,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 13,
   "firman": "Celakalah mereka, sebab mereka melarikan diri dari pada-Ku! Binasalah mereka, sebab mereka memberontak terhadap Aku! Aku ini mau menebus mereka, tetapi mereka berdusta terhadap Aku."
 },
 {
   "id": 22197,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 14,
   "firman": "Seruan mereka kepada-Ku tidak keluar dari hatinya, tetapi mereka meratap di pembaringan mereka. Mereka menoreh-noreh diri karena gandum dan anggur, dan mereka berontak terhadap Aku."
 },
 {
   "id": 22198,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 15,
   "firman": "Sekalipun Aku telah melatih dan menguatkan lengan-lengan mereka, namun mereka merancang kejahatan terhadap Aku."
 },
 {
   "id": 22199,
   "kitab": "Hos",
   "pasal": 7,
   "ayat": 16,
   "firman": "Mereka berbalik kepada Baal, mereka adalah seperti busur tipu; pemuka-pemuka mereka akan tewas oleh pedang karena ucapan mereka yang kasar. Inilah yang akan menjadi olok-olok kepada mereka di tanah Mesir."
 },
 {
   "id": 22200,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 1,
   "firman": "Tiuplah sangkakala! Serangan laksana rajawali atas rumah TUHAN! Oleh karena mereka telah melangkahi perjanjian-Ku dan telah mendurhaka terhadap pengajaran-Ku."
 },
 {
   "id": 22201,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 2,
   "firman": "Kepada-Ku mereka berseru-seru: \"Ya Allahku, kami, Israel mengenal Engkau!\""
 },
 {
   "id": 22202,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 3,
   "firman": "Israel telah menolak yang baik--biarlah musuh mengejar dia!"
 },
 {
   "id": 22203,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 4,
   "firman": "Mereka telah mengangkat raja, tetapi tanpa persetujuan-Ku; mereka mengangkat pemuka, tetapi dengan tidak setahu-Ku. Dari emas dan peraknya mereka membuat berhala-berhala bagi dirinya sendiri, sehingga mereka dilenyapkan."
 },
 {
   "id": 22204,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 5,
   "firman": "Aku menolak anak lembumu, hai Samaria; murka-Ku menyala terhadap mereka! Sampai berapa lama tidak dapat disucikan,"
 },
 {
   "id": 22205,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 6,
   "firman": "orang-orang Israel itu? Itu dibuat oleh tukang, dan itu bukan Allah! Sungguh, akan menjadi serpih anak lembu Samaria itu!"
 },
 {
   "id": 22206,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebab mereka menabur angin, maka mereka akan menuai puting beliung; gandum yang belum menguning tidak ada pada mereka; tumbuh-tumbuhan itu tidak menghasilkan tepung; dan jika memberi hasil, maka orang-orang lain menelannya."
 },
 {
   "id": 22207,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 8,
   "firman": "Israel sudah ditelan; sekarang mereka itu ada di antara bangsa-bangsa seperti barang yang tidak disukai orang."
 },
 {
   "id": 22208,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 9,
   "firman": "Sebab mereka telah pergi ke Asyur, bagaikan keledai hutan yang memencilkan diri; Efraim telah membagi-bagi hadiah cinta."
 },
 {
   "id": 22209,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 10,
   "firman": "Sekalipun mereka membagi-bagi hadiah itu di antara bangsa-bangsa, sekarang ini Aku akan mengumpulkan mereka, dan sebentar lagi mereka akan berhenti mengurapi raja dan para pemuka."
 },
 {
   "id": 22210,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 11,
   "firman": "Sungguh, Efraim telah memperbanyak mezbah; mezbah-mezbah itu menjadikan mereka berdosa."
 },
 {
   "id": 22211,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 12,
   "firman": "Sekalipun Kutuliskan baginya banyak pengajaran-Ku, itu akan dianggap mereka sebagai sesuatu yang asing."
 },
 {
   "id": 22212,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 13,
   "firman": "Mereka mencintai korban sembelihan; mereka mempersembahkan daging dan memakannya; tetapi TUHAN tidak berkenan kepada mereka. Sekarang Ia akan mengingat kesalahan mereka dan akan menghukum dosa mereka; mereka harus kembali ke Mesir!"
 },
 {
   "id": 22213,
   "kitab": "Hos",
   "pasal": 8,
   "ayat": 14,
   "firman": "Israel telah melupakan Pembuatnya dan telah mendirikan istana-istana; Yehuda telah memperbanyak kota-kota yang berkubu; tetapi Aku akan melepas api ke dalam kota-kota mereka, sehingga puri mereka dimakan habis."
 },
 {
   "id": 22214,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 1,
   "firman": "Janganlah bersukacita, hai Israel! Janganlah bersorak-sorak seperti bangsa-bangsa! Sebab engkau telah berzinah dengan meninggalkan Allahmu, engkau telah mencintai upah sundal di segala tempat pengirikan gandum."
 },
 {
   "id": 22215,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 2,
   "firman": "Tempat pengirikan gandum dan tempat pemerasan anggur tidak akan memberi mereka makan, dan anggur akan mengecewakan mereka."
 },
 {
   "id": 22216,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 3,
   "firman": "Mereka tidak akan tetap diam di tanah TUHAN, tetapi Efraim harus kembali ke Mesir, dan di Asyur mereka akan memakan makanan najis."
 },
 {
   "id": 22217,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 4,
   "firman": "Mereka tidak akan mempersembahkan korban curahan anggur kepada TUHAN dan korban-korban sembelihan mereka tidak akan menyenangkan hati-Nya. Roti mereka adalah seperti roti perkabungan, semua orang yang memakannya akan menjadi najis, sebab roti mereka adalah untuk dirinya sendiri, tidak boleh dibawa ke dalam rumah TUHAN."
 },
 {
   "id": 22218,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 5,
   "firman": "Apakah yang hendak kamu perbuat pada waktu pertemuan raya dan pada waktu hari raya TUHAN?"
 },
 {
   "id": 22219,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 6,
   "firman": "Sebab walaupun mereka mengelakkan diri dari pemusnahan, Mesir akan mengumpulkan mereka, Memfis akan menguburkan mereka. Rumput akan menutupi barang-barang perak mereka yang berharga; onak akan tumbuh dalam kemah-kemah mereka."
 },
 {
   "id": 22220,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 7,
   "firman": "Sudah datang hari-hari penghukuman, sudah datang hari-hari pembalasan, Israel akan mengalaminya, \"Nabi adalah seorang pandir, orang yang penuh roh adalah orang gila!\", oleh karena besarnya kesalahanmu dan besarnya permusuhan:"
 },
 {
   "id": 22221,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 8,
   "firman": "Efraim, umat Allahku, sedang mengintai nabi, jerat penangkap burung ada di sepanjang jalannya, permusuhan ada di rumah Allahnya."
 },
 {
   "id": 22222,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 9,
   "firman": "Busuk sangat perbuatan mereka seperti pada hari-hari Gibea; Ia akan mengingat kesalahan mereka dan akan menghukum dosa mereka."
 },
 {
   "id": 22223,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 10,
   "firman": "Seperti buah-buah anggur di padang gurun Aku mendapati Israel dahulu; seperti buah sulung sebagai hasil pertama pohon ara Aku melihat nenek moyangmu. Tetapi mereka itu telah pergi kepada Baal-Peor dan telah membaktikan diri kepada dewa keaiban, sehingga mereka menjadi kejijikan sama seperti apa yang mereka cintai itu."
 },
 {
   "id": 22224,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 11,
   "firman": "Kemuliaan Efraim terbang seperti burung: tiada yang melahirkan, yang hamil dan yang mengandung!"
 },
 {
   "id": 22225,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 12,
   "firman": "Sekalipun mereka membesarkan anak-anaknya, Aku akan membuat mereka bulus, sehingga tidak ada manusia lagi. Sungguh, celakalah juga mereka pada waktu Aku menjauh dari pada mereka!"
 },
 {
   "id": 22226,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 13,
   "firman": "Efraim, seperti yang Aku lihat, telah membuat anak-anaknya menjadi binatang perburuan; Efraim terpaksa menyerahkan anak-anaknya kepada si pembunuh."
 },
 {
   "id": 22227,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 14,
   "firman": "Berilah kepada mereka, ya TUHAN--apakah yang hendak Kauberi? Berilah kepada mereka kandungan yang mandul dan buah dada yang kering."
 },
 {
   "id": 22228,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 15,
   "firman": "Segala kejahatan mereka terjadi di Gilgal, sungguh, di sana Aku mulai membenci mereka. Oleh karena jahatnya perbuatan-perbuatan mereka Aku akan menghalau mereka dari rumah-Ku. Aku tidak akan mengasihi mereka lagi, semua pemuka mereka adalah pemberontak."
 },
 {
   "id": 22229,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 16,
   "firman": "Efraim telah dipukul, akarnya telah menjadi kering, mereka tidak akan menghasilkan buah. Bahkan sekalipun mereka melahirkan anak, Aku akan mematikan buah kandungannya yang berharga."
 },
 {
   "id": 22230,
   "kitab": "Hos",
   "pasal": 9,
   "ayat": 17,
   "firman": "Allahku akan membuang mereka, sebab mereka tidak mendengarkan Dia, maka mereka akan mengembara di antara bangsa-bangsa."
 },
 {
   "id": 22231,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 1,
   "firman": "Israel adalah pohon anggur yang riap tumbuhnya, yang menghasilkan buah. Makin banyak buahnya, makin banyak dibuatnya mezbah-mezbah. Makin baik tanahnya, makin baik dibuatnya tugu-tugu berhala."
 },
 {
   "id": 22232,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 2,
   "firman": "Hati mereka licik, sekarang mereka harus menanggung akibat kesalahannya: Dia akan menghancurkan mezbah-mezbah mereka, akan meruntuhkan tugu-tugu berhala mereka."
 },
 {
   "id": 22233,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 3,
   "firman": "Sungguh, sekarang mereka berkata: \"Kita tidak mempunyai raja lagi, sebab kita tidak takut kepada TUHAN. Apakah yang dapat dilakukan raja bagi kita?\""
 },
 {
   "id": 22234,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 4,
   "firman": "Mereka membual, mengangkat sumpah dusta, mengikat perjanjian, sehingga tumbuh hukum seperti pohon upas di alur-alur ladang."
 },
 {
   "id": 22235,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 5,
   "firman": "Penduduk Samaria gentar mengenai anak lembu Bet-Awen. Sungguh, rakyatnya akan berkabung oleh karenanya, dan imam-imamnya akan meratap oleh karenanya, oleh sebab kemuliaannya telah beralih dari padanya."
 },
 {
   "id": 22236,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 6,
   "firman": "Anak lembu itu sendiri akan dibawa ke Asyur sebagai persembahan kepada Raja 'Agung'. Efraim akan menanggung malu, Israel akan mendapat malu karena rancangannya."
 },
 {
   "id": 22237,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 7,
   "firman": "Samaria akan dihancurkan; rajanya seperti sepotong ranting yang terapung di air."
 },
 {
   "id": 22238,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 8,
   "firman": "Bukit-bukit pengorbanan Awen, yakni dosa Israel, akan dimusnahkan. Semak duri dan rumput duri akan tumbuh di atas mezbah-mezbahnya. Dan mereka akan berkata kepada gunung-gunung: \"Timbunilah kami!\" dan kepada bukit-bukit: \"Runtuhlah menimpa kami!\""
 },
 {
   "id": 22239,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sejak hari Gibea engkau telah berdosa, hai Israel; di sana mereka bangkit melawan. Tidakkah perang melawan orang-orang curang akan mencapai mereka di Gibea?"
 },
 {
   "id": 22240,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 10,
   "firman": "Aku telah datang untuk menghajar mereka; bangsa-bangsa akan berkumpul melawan mereka, apabila mereka dihajar karena salahnya yang berganda."
 },
 {
   "id": 22241,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 11,
   "firman": "Efraim dahulu seekor anak lembu yang terlatih, yang suka mengirik, dan Aku ini menyayangi tengkuknya yang elok, Aku memasang Efraim; Yehuda harus membajak, Yakub harus menyisir tanah baginya sendiri."
 },
 {
   "id": 22242,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 12,
   "firman": "Menaburlah bagimu sesuai dengan keadilan, menuailah menurut kasih setia! Bukalah bagimu tanah baru, sebab sudah waktunya untuk mencari TUHAN, sampai Ia datang dan menghujani kamu dengan keadilan."
 },
 {
   "id": 22243,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 13,
   "firman": "Kamu telah membajak kefasikan, telah menuai kecurangan, telah memakan buah kebohongan. Oleh karena engkau telah mengandalkan diri pada keretamu, pada banyaknya pahlawan-pahlawanmu,"
 },
 {
   "id": 22244,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 14,
   "firman": "maka keriuhan perang akan timbul di antara bangsamu, dan segala kubumu akan dihancurkan seperti Salman menghancurkan Bet-Arbel pada hari pertempuran: ibu beserta anak-anak diremukkan."
 },
 {
   "id": 22245,
   "kitab": "Hos",
   "pasal": 10,
   "ayat": 15,
   "firman": "Demikianlah akan Kulakukan kepadamu, hai kaum Israel, oleh karena dahsyatnya kejahatanmu. Pada waktu fajar akan dilenyapkan sama sekali raja Israel."
 },
 {
   "id": 22246,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 1,
   "firman": "Ketika Israel masih muda, Kukasihi dia, dan dari Mesir Kupanggil anak-Ku itu."
 },
 {
   "id": 22247,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 2,
   "firman": "Makin Kupanggil mereka, makin pergi mereka itu dari hadapan-Ku; mereka mempersembahkan korban kepada para Baal, dan membakar korban kepada patung-patung."
 },
 {
   "id": 22248,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 3,
   "firman": "Padahal Akulah yang mengajar Efraim berjalan dan mengangkat mereka di tangan-Ku, tetapi mereka tidak mau insaf, bahwa Aku menyembuhkan mereka."
 },
 {
   "id": 22249,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 4,
   "firman": "Aku menarik mereka dengan tali kesetiaan, dengan ikatan kasih. Bagi mereka Aku seperti orang yang mengangkat kuk dari tulang rahang mereka; Aku membungkuk kepada mereka untuk memberi mereka makan."
 },
 {
   "id": 22250,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 5,
   "firman": "Mereka harus kembali ke tanah Mesir, dan Asyur akan menjadi raja mereka, sebab mereka menolak untuk bertobat."
 },
 {
   "id": 22251,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 6,
   "firman": "Pedang akan mengamuk di kota-kota mereka, akan memusnahkan palang-palang pintu mereka, dan akan memakan mereka di benteng-benteng mereka."
 },
 {
   "id": 22252,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 7,
   "firman": "Umat-Ku betah dalam membelakangi Aku; mereka memanggil kepada Baal dan berhenti meninggikan nama-Ku."
 },
 {
   "id": 22253,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 8,
   "firman": "Masakan Aku membiarkan engkau, hai Efraim, menyerahkan engkau, hai Israel? Masakan Aku membiarkan engkau seperti Adma, membuat engkau seperti Zeboim? Hati-Ku berbalik dalam diri-Ku, belas kasihan-Ku bangkit serentak."
 },
 {
   "id": 22254,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 9,
   "firman": "Aku tidak akan melaksanakan murka-Ku yang bernyala-nyala itu, tidak akan membinasakan Efraim kembali. Sebab Aku ini Allah dan bukan manusia, Yang Kudus di tengah-tengahmu, dan Aku tidak datang untuk menghanguskan."
 },
 {
   "id": 22255,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 10,
   "firman": "Mereka akan mengikuti TUHAN, Ia akan mengaum seperti singa. Sungguh, Ia akan mengaum, maka anak-anak akan datang dengan gemetar dari barat,"
 },
 {
   "id": 22256,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 11,
   "firman": "seperti burung dengan gemetar datang dari Mesir, dan seperti merpati dari tanah Asyur, lalu Aku akan menempatkan mereka lagi di rumah-rumah mereka, demikianlah firman TUHAN."
 },
 {
   "id": 22257,
   "kitab": "Hos",
   "pasal": 11,
   "ayat": 12,
   "firman": "(12-1) Dengan kebohongan Aku telah dikepung oleh Efraim, dengan tipu oleh kaum Israel; sedang Yehuda menghilang dari dekat Allah, dari dekat Yang Mahakudus yang setia."
 },
 {
   "id": 22258,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 1,
   "firman": "(12-2) Efraim menjaga angin, dan mengejar angin timur sehari suntuk, memperbanyak dusta dan pemusnahan; mereka mengadakan perjanjian dengan Asyur, dan membawa minyak kepada Mesir."
 },
 {
   "id": 22259,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 2,
   "firman": "(12-3) TUHAN mempunyai perbantahan dengan Yehuda, Ia akan menghukum Yakub sesuai dengan tingkah lakunya, dan akan memberi balasan kepadanya sesuai dengan perbuatan-perbuatannya."
 },
 {
   "id": 22260,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 3,
   "firman": "(12-4) Di dalam kandungan ia menipu saudaranya, dan dalam kegagahannya ia bergumul dengan Allah."
 },
 {
   "id": 22261,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 4,
   "firman": "(12-5) Ia bergumul dengan Malaikat dan menang; ia menangis dan memohon belas kasihan kepada-Nya. Di Betel ia bertemu dengan Dia, dan di sanalah Dia berfirman kepadanya:"
 },
 {
   "id": 22262,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 5,
   "firman": "(12-6) --yakni TUHAN, Allah semesta alam, TUHAN nama-Nya--"
 },
 {
   "id": 22263,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 6,
   "firman": "(12-7) \"Engkau ini harus berbalik kepada Allahmu, peliharalah kasih setia dan hukum, dan nantikanlah Allahmu senantiasa.\""
 },
 {
   "id": 22264,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 7,
   "firman": "(12-8) Sama seperti Kanaan, dengan neraca palsu di tangannya, dan suka memeras,"
 },
 {
   "id": 22265,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 8,
   "firman": "(12-9) berkatalah Efraim: \"Bukankah aku telah menjadi kaya, telah mendapat harta benda bagiku! Tetapi segala hasil jerih payahku tidak mendatangkan kesalahan yang merupakan dosa bagiku.\""
 },
 {
   "id": 22266,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 9,
   "firman": "(12-10) Tetapi Aku adalah TUHAN, Allahmu sejak di tanah Mesir; Aku masih mau membuat engkau diam kembali di kemah-kemah seperti di hari-hari pertemuan raya."
 },
 {
   "id": 22267,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 10,
   "firman": "(12-11) Aku berbicara kepada para nabi dan banyak kali memberi penglihatan dan memberi perumpamaan dengan perantaraan para nabi."
 },
 {
   "id": 22268,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 11,
   "firman": "(12-12) Bila di Gilead ada kejahatan, maka mereka menjadi kesia-siaan belaka; di Gilgal mereka mempersembahkan lembu-lembu jantan, maka mezbah-mezbah mereka juga menjadi seperti timbunan batu di alur-alur ladang."
 },
 {
   "id": 22269,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 12,
   "firman": "(12-13) Yakub melarikan diri ke tanah Aram, dan Israel memperhambakan diri untuk mendapat isteri, ya, untuk mendapat isteri ia menjadi gembala."
 },
 {
   "id": 22270,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 13,
   "firman": "(12-14) Israel dituntun oleh TUHAN keluar dari Mesir dengan perantaraan seorang nabi, ya, ia dijaga oleh seorang nabi."
 },
 {
   "id": 22271,
   "kitab": "Hos",
   "pasal": 12,
   "ayat": 14,
   "firman": "(12-15) Efraim telah menimbulkan sakit hati-Nya secara pahit, maka Tuhannya akan membiarkan hutang darahnya menimpa dia, dan akan membalas celanya kepadanya."
 },
 {
   "id": 22272,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 1,
   "firman": "Apabila Efraim berbicara, gemetarlah orang; ia diangkat-angkat di Israel, tetapi ia bersalah dengan menyembah Baal, sehingga matilah ia."
 },
 {
   "id": 22273,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 2,
   "firman": "Sekarangpun mereka terus berdosa, dan membuat baginya patung tuangan dari perak dan berhala-berhala sesuai dengan kecakapan mereka; semuanya itu buatan tukang-tukang. Persembahkanlah korban kepadanya!, kata mereka. Baiklah manusia mencium anak-anak lembu!"
 },
 {
   "id": 22274,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 3,
   "firman": "Sebab itu mereka akan seperti kabut pagi atau seperti embun yang hilang pagi-pagi benar, seperti debu jerami yang diterbangkan badai dari tempat pengirikan atau seperti asap dari tingkap."
 },
 {
   "id": 22275,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 4,
   "firman": "Tetapi Aku adalah TUHAN, Allahmu sejak di tanah Mesir; engkau tidak mengenal allah kecuali Aku, dan tidak ada juruselamat selain dari Aku."
 },
 {
   "id": 22276,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 5,
   "firman": "Akulah yang mengenal engkau di padang gurun, di tanah yang gersang."
 },
 {
   "id": 22277,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 6,
   "firman": "Ketika mereka makan rumput, maka mereka kenyang; setelah mereka kenyang, maka hati mereka meninggi; itulah sebabnya mereka melupakan Aku."
 },
 {
   "id": 22278,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 7,
   "firman": "Maka Aku menjadi seperti singa bagi mereka, seperti macan tutul Aku mengintip-intip di pinggir jalan."
 },
 {
   "id": 22279,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 8,
   "firman": "Aku mau mendatangi mereka seperti beruang yang kehilangan anak, Aku mau mengoyakkan dada mereka. Di sana Aku memakan mereka seperti singa; binatang liar di padang akan merobek mereka."
 },
 {
   "id": 22280,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 9,
   "firman": "Aku membinasakan engkau, hai Israel, siapakah yang dapat menolong engkau?"
 },
 {
   "id": 22281,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 10,
   "firman": "Di mana gerangan rajamu, supaya diselamatkannya engkau, dan semua pemukamu, supaya diberinya engkau keadilan, hai, engkau yang berkata: \"Berilah kepadaku seorang raja dan pemuka-pemuka!\""
 },
 {
   "id": 22282,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 11,
   "firman": "Aku memberikan engkau seorang raja dalam murka-Ku dan mengambilnya dalam gemas-Ku."
 },
 {
   "id": 22283,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 12,
   "firman": "Kesalahan Efraim dibungkus, dosanya disimpan."
 },
 {
   "id": 22284,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 13,
   "firman": "Sakit beranak mendahului kelahirannya, tetapi ia adalah seorang anak yang tidak bijaksana; sebab tidak pada waktunya ia bergerak, bila waktunya tiba, ia tidak mau keluar dari kandungan ibu."
 },
 {
   "id": 22285,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 14,
   "firman": "Akan Kubebaskankah mereka dari kuasa dunia orang mati, akan Kutebuskah mereka dari pada maut? Di manakah penyakit samparmu, hai maut, di manakah tenaga pembinasamu, hai dunia orang mati? Mata-Ku tertutup bagi belas kasihan."
 },
 {
   "id": 22286,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 15,
   "firman": "Sekalipun ia tumbuh subur di antara rumput-rumput, maka angin timur, angin TUHAN, akan datang, bertiup dari padang gurun, mengeringkan sumber-sumbernya dan merusakkan mata-mata airnya; dirampasnya harta benda, segala barang yang indah-indah."
 },
 {
   "id": 22287,
   "kitab": "Hos",
   "pasal": 13,
   "ayat": 16,
   "firman": "(14-1) Samaria harus mendapat hukuman, sebab ia memberontak terhadap Allahnya. Mereka akan tewas oleh pedang, bayi-bayinya akan diremukkan, dan perempuan-perempuannya yang mengandung akan dibelah perutnya."
 },
 {
   "id": 22288,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 1,
   "firman": "(14-2) Bertobatlah, hai Israel, kepada TUHAN, Allahmu, sebab engkau telah tergelincir karena kesalahanmu."
 },
 {
   "id": 22289,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 2,
   "firman": "(14-3) Bawalah sertamu kata-kata penyesalan, dan bertobatlah kepada TUHAN! katakanlah kepada-Nya: \"Ampunilah segala kesalahan, sehingga kami mendapat yang baik, maka kami akan mempersembahkan pengakuan kami."
 },
 {
   "id": 22290,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 3,
   "firman": "(14-4) Asyur tidak dapat menyelamatkan kami; kami tidak mau mengendarai kuda, dan kami tidak akan berkata lagi: Ya, Allah kami! kepada buatan tangan kami. Karena Engkau menyayangi anak yatim.\""
 },
 {
   "id": 22291,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 4,
   "firman": "(14-5) Aku akan memulihkan mereka dari penyelewengan, Aku akan mengasihi mereka dengan sukarela, sebab murka-Ku telah surut dari pada mereka."
 },
 {
   "id": 22292,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 5,
   "firman": "(14-6) Aku akan seperti embun bagi Israel, maka ia akan berbunga seperti bunga bakung dan akan menjulurkan akar-akarnya seperti pohon hawar."
 },
 {
   "id": 22293,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 6,
   "firman": "(14-7) Ranting-rantingnya akan merambak, semaraknya akan seperti pohon zaitun dan berbau harum seperti yang di Libanon."
 },
 {
   "id": 22294,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 7,
   "firman": "(14-8) Mereka akan kembali dan diam dalam naungan-Ku dan tumbuh seperti gandum; mereka akan berkembang seperti pohon anggur, yang termasyhur seperti anggur Libanon."
 },
 {
   "id": 22295,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 8,
   "firman": "(14-9) Efraim, apakah lagi sangkut paut-Ku dengan berhala-berhala? Akulah yang menjawab dan memperhatikan engkau! Aku ini seperti pohon sanobar yang menghijau, dari pada-Ku engkau mendapat buah."
 },
 {
   "id": 22296,
   "kitab": "Hos",
   "pasal": 14,
   "ayat": 9,
   "firman": "(14-10) Siapa yang bijaksana, biarlah ia memahami semuanya ini; siapa yang paham, biarlah ia mengetahuinya; sebab jalan-jalan TUHAN adalah lurus, dan orang benar menempuhnya, tetapi pemberontak tergelincir di situ."
 },
 {
   "id": 22297,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada Yoel bin Petuel."
 },
 {
   "id": 22298,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 2,
   "firman": "Dengarlah ini, hai para tua-tua, pasanglah telinga, hai seluruh penduduk negeri! Pernahkah terjadi seperti ini dalam zamanmu, atau dalam zaman nenek moyangmu?"
 },
 {
   "id": 22299,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 3,
   "firman": "Ceritakanlah tentang itu kepada anak-anakmu, dan biarlah anak-anakmu menceritakannya kepada anak-anak mereka, dan anak-anak mereka kepada angkatan yang kemudian."
 },
 {
   "id": 22300,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 4,
   "firman": "Apa yang ditinggalkan belalang pengerip telah dimakan belalang pindahan, apa yang ditinggalkan belalang pindahan telah dimakan belalang pelompat, dan apa yang ditinggalkan belalang pelompat telah dimakan belalang pelahap."
 },
 {
   "id": 22301,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 5,
   "firman": "Bangunlah, hai pemabuk, dan menangislah! Merataplah, hai semua peminum anggur karena anggur baru, sebab sudah dirampas dari mulutmu anggur itu!"
 },
 {
   "id": 22302,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 6,
   "firman": "Sebab maju menyerang negeriku suatu bangsa yang kuat dan tidak terbilang banyaknya; giginya bagaikan gigi singa, dan taringnya bagaikan taring singa betina."
 },
 {
   "id": 22303,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 7,
   "firman": "Telah dibuatnya pohon anggurku menjadi musnah, dan pohon araku menjadi buntung; dikelupasnya kulitnya sama sekali dan dilemparkannya, sehingga carang-carangnya menjadi putih."
 },
 {
   "id": 22304,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 8,
   "firman": "Merataplah seperti anak dara yang berlilitkan kain kabung karena mempelai, kekasih masa mudanya."
 },
 {
   "id": 22305,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 9,
   "firman": "Korban sajian dan korban curahan sudah lenyap dari rumah TUHAN; dan berkabunglah para imam, yakni pelayan-pelayan TUHAN."
 },
 {
   "id": 22306,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 10,
   "firman": "Ladang sudah musnah, tanah berkabung, sebab gandum sudah musnah, buah anggur sudah kering, minyak sudah menipis."
 },
 {
   "id": 22307,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 11,
   "firman": "Para petani menjadi malu, tukang-tukang kebun anggur meratap karena gandum dan karena jelai, sebab sudah musnah panen ladang."
 },
 {
   "id": 22308,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 12,
   "firman": "Pohon anggur sudah kering dan pohon ara sudah merana; pohon delima, juga pohon korma dan pohon apel, segala pohon di padang sudah mengering. Sungguh, kegirangan melayu dari antara anak-anak manusia."
 },
 {
   "id": 22309,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 13,
   "firman": "Lilitkanlah kain kabung dan mengeluhlah, hai para imam; merataplah, hai para pelayan mezbah; masuklah, bermalamlah dengan memakai kain kabung, hai para pelayan Allahku, sebab sudah ditahan dari rumah Allahmu, korban sajian dan korban curahan."
 },
 {
   "id": 22310,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 14,
   "firman": "Adakanlah puasa yang kudus, maklumkanlah perkumpulan raya; kumpulkanlah para tua-tua dan seluruh penduduk negeri ke rumah TUHAN, Allahmu, dan berteriaklah kepada TUHAN."
 },
 {
   "id": 22311,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 15,
   "firman": "Wahai, hari itu! Sungguh, hari TUHAN sudah dekat, datangnya sebagai pemusnahan dari Yang Mahakuasa."
 },
 {
   "id": 22312,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 16,
   "firman": "Bukankah di depan mata kita sudah lenyap makanan, sukaria dan sorak-sorai dari rumah Allah kita?"
 },
 {
   "id": 22313,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 17,
   "firman": "Biji-bijian menjadi kering di dalam tanah, lumbung-lumbung sudah licin tandas, rengkiang-rengkiang sudah runtuh, sebab gandum sudah habis."
 },
 {
   "id": 22314,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 18,
   "firman": "Betapa mengeluhnya hewan dan gempar kawanan-kawanan lembu, sebab tidak ada lagi padang rumput baginya; juga kawanan kambing domba terkejut."
 },
 {
   "id": 22315,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 19,
   "firman": "Kepada-Mu, ya TUHAN, aku berseru, sebab api telah memakan habis tanah gembalaan di padang gurun, dan nyala api telah menghanguskan segala pohon di padang."
 },
 {
   "id": 22316,
   "kitab": "Yoe",
   "pasal": 1,
   "ayat": 20,
   "firman": "Juga binatang-binatang di padang menjerit karena rindu kepada-Mu, sebab wadi telah kering, dan apipun telah memakan habis tanah gembalaan di padang gurun."
 },
 {
   "id": 22317,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 1,
   "firman": "Tiuplah sangkakala di Sion dan berteriaklah di gunung-Ku yang kudus! Biarlah gemetar seluruh penduduk negeri, sebab hari TUHAN datang, sebab hari itu sudah dekat;"
 },
 {
   "id": 22318,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 2,
   "firman": "suatu hari gelap gulita dan kelam kabut, suatu hari berawan dan kelam pekat; seperti fajar di atas gunung-gunung terbentang suatu bangsa yang banyak dan kuat, yang serupa itu tidak pernah ada sejak purbakala, dan tidak akan ada lagi sesudah itu turun-temurun, pada masa yang akan datang."
 },
 {
   "id": 22319,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 3,
   "firman": "Di depannya api memakan habis, di belakangnya nyala api berkobar. Tanah di depannya seperti Taman Eden, tetapi di belakangnya padang gurun tandus, dan sama sekali tidak ada yang dapat luput."
 },
 {
   "id": 22320,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 4,
   "firman": "Rupanya seperti kuda, dan seperti kuda balapan mereka berlari."
 },
 {
   "id": 22321,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 5,
   "firman": "Seperti gemertaknya kereta-kereta, mereka melompat-lompat di atas puncak gunung-gunung; seperti geletiknya nyala api yang memakan habis jerami; seperti suatu bangsa yang kuat, teratur barisannya untuk berperang."
 },
 {
   "id": 22322,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 6,
   "firman": "Terhadapnya bangsa-bangsa gemetar, segala muka bertambah menjadi pucat pasi."
 },
 {
   "id": 22323,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 7,
   "firman": "Seperti pahlawan mereka berlari, seperti prajurit mereka naik tembok; dan mereka masing-masing berjalan terus dengan tidak membelok dari jalannya;"
 },
 {
   "id": 22324,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 8,
   "firman": "mereka tidak berdesak-desakan, mereka berjalan terus masing-masing di jalannya; mereka menerobos pertahanan dengan tombak, mereka tidak membiarkan barisannya terputus."
 },
 {
   "id": 22325,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 9,
   "firman": "Mereka menyerbu ke dalam kota, mereka berlari ke atas tembok, mereka memanjat ke dalam rumah-rumah, mereka masuk melalui jendela-jendela seperti pencuri."
 },
 {
   "id": 22326,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 10,
   "firman": "Di depannya bumi gemetar, langit bergoncang; matahari dan bulan menjadi gelap, dan bintang-bintang menghilangkan cahayanya."
 },
 {
   "id": 22327,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dan TUHAN memperdengarkan suara-Nya di depan tentara-Nya. Pasukan-Nya sangat banyak dan pelaksana firman-Nya kuat. Betapa hebat dan sangat dahsyat hari TUHAN! Siapakah yang dapat menahannya?"
 },
 {
   "id": 22328,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 12,
   "firman": "\"Tetapi sekarang juga,\" demikianlah firman TUHAN, \"berbaliklah kepada-Ku dengan segenap hatimu, dengan berpuasa, dengan menangis dan dengan mengaduh.\""
 },
 {
   "id": 22329,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 13,
   "firman": "Koyakkanlah hatimu dan jangan pakaianmu, berbaliklah kepada TUHAN, Allahmu, sebab Ia pengasih dan penyayang, panjang sabar dan berlimpah kasih setia, dan Ia menyesal karena hukuman-Nya."
 },
 {
   "id": 22330,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 14,
   "firman": "Siapa tahu, mungkin Ia mau berbalik dan menyesal, dan ditinggalkan-Nya berkat, menjadi korban sajian dan korban curahan bagi TUHAN, Allahmu."
 },
 {
   "id": 22331,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 15,
   "firman": "Tiuplah sangkakala di Sion, adakanlah puasa yang kudus, maklumkanlah perkumpulan raya;"
 },
 {
   "id": 22332,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 16,
   "firman": "kumpulkanlah bangsa ini, kuduskanlah jemaah, himpunkanlah orang-orang yang tua, kumpulkanlah anak-anak, bahkan anak-anak yang menyusu; baiklah penganten laki-laki keluar dari kamarnya, dan penganten perempuan dari kamar tidurnya;"
 },
 {
   "id": 22333,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 17,
   "firman": "baiklah para imam, pelayan-pelayan TUHAN, menangis di antara balai depan dan mezbah, dan berkata: \"Sayangilah, ya TUHAN, umat-Mu, dan janganlah biarkan milik-Mu sendiri menjadi cela, sehingga bangsa-bangsa menyindir kepada mereka. Mengapa orang berkata di antara bangsa: Di mana Allah mereka?\""
 },
 {
   "id": 22334,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 18,
   "firman": "TUHAN menjadi cemburu karena tanah-Nya, dan Ia belas kasihan kepada umat-Nya."
 },
 {
   "id": 22335,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 19,
   "firman": "TUHAN menjawab, kata-Nya kepada umat-Nya: \"Sesungguhnya, Aku akan mengirim kepadamu gandum, anggur dan minyak, dan kamu akan kenyang memakannya; Aku tidak akan menyerahkan kamu lagi menjadi cela di antara bangsa-bangsa."
 },
 {
   "id": 22336,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 20,
   "firman": "Yang datang dari utara itu akan Kujauhkan dari padamu, dan akan Kuusir ke suatu negeri kering dan tandus, barisan mukanya ke laut timur, dan barisan belakangnya ke laut barat, maka bau busuknya dan bau anyirnya akan naik, sebab ia telah melakukan perkara yang besar."
 },
 {
   "id": 22337,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 21,
   "firman": "Jangan takut, hai tanah, bersorak-soraklah dan bersukacitalah, sebab juga TUHAN telah melakukan perkara yang besar!"
 },
 {
   "id": 22338,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 22,
   "firman": "Jangan takut, hai binatang-binatang di padang, sebab tanah gembalaan di padang gurun menghijau, pohon menghasilkan buahnya, pohon ara dan pohon anggur memberi kekayaannya."
 },
 {
   "id": 22339,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 23,
   "firman": "Hai bani Sion, bersorak-soraklah dan bersukacitalah karena TUHAN, Allahmu! Sebab telah diberikan-Nya kepadamu hujan pada awal musim dengan adilnya, dan diturunkan-Nya kepadamu hujan, hujan pada awal dan hujan pada akhir musim seperti dahulu."
 },
 {
   "id": 22340,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tempat-tempat pengirikan menjadi penuh dengan gandum, dan tempat pemerasan kelimpahan anggur dan minyak."
 },
 {
   "id": 22341,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 25,
   "firman": "Aku akan memulihkan kepadamu tahun-tahun yang hasilnya dimakan habis oleh belalang pindahan, belalang pelompat, belalang pelahap dan belalang pengerip, tentara-Ku yang besar yang Kukirim ke antara kamu."
 },
 {
   "id": 22342,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 26,
   "firman": "Maka kamu akan makan banyak-banyak dan menjadi kenyang, dan kamu akan memuji-muji nama TUHAN, Allahmu, yang telah memperlakukan kamu dengan ajaib; dan umat-Ku tidak akan menjadi malu lagi untuk selama-lamanya."
 },
 {
   "id": 22343,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 27,
   "firman": "Kamu akan mengetahui bahwa Aku ini ada di antara orang Israel, dan bahwa Aku ini, TUHAN, adalah Allahmu dan tidak ada yang lain; dan umat-Ku tidak akan menjadi malu lagi untuk selama-lamanya.\""
 },
 {
   "id": 22344,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 28,
   "firman": "\"Kemudian dari pada itu akan terjadi, bahwa Aku akan mencurahkan Roh-Ku ke atas semua manusia, maka anak-anakmu laki-laki dan perempuan akan bernubuat; orang-orangmu yang tua akan mendapat mimpi, teruna-terunamu akan mendapat penglihatan-penglihatan."
 },
 {
   "id": 22345,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 29,
   "firman": "Juga ke atas hamba-hambamu laki-laki dan perempuan akan Kucurahkan Roh-Ku pada hari-hari itu."
 },
 {
   "id": 22346,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 30,
   "firman": "Aku akan mengadakan mujizat-mujizat di langit dan di bumi: darah dan api dan gumpalan-gumpalan asap."
 },
 {
   "id": 22347,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 31,
   "firman": "Matahari akan berubah menjadi gelap gulita dan bulan menjadi darah sebelum datangnya hari TUHAN yang hebat dan dahsyat itu."
 },
 {
   "id": 22348,
   "kitab": "Yoe",
   "pasal": 2,
   "ayat": 32,
   "firman": "Dan barangsiapa yang berseru kepada nama TUHAN akan diselamatkan, sebab di gunung Sion dan di Yerusalem akan ada keselamatan, seperti yang telah difirmankan TUHAN; dan setiap orang yang dipanggil TUHAN akan termasuk orang-orang yang terlepas.\""
 },
 {
   "id": 22349,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 1,
   "firman": "\"Sebab sesungguhnya pada hari-hari itu dan pada waktu itu, apabila Aku memulihkan keadaan Yehuda dan Yerusalem,"
 },
 {
   "id": 22350,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 2,
   "firman": "Aku akan mengumpulkan segala bangsa dan akan membawa mereka turun ke lembah Yosafat; Aku akan berperkara dengan mereka di sana mengenai umat-Ku dan milik-Ku sendiri, Israel, oleh karena mereka mencerai-beraikannya ke antara bangsa-bangsa dan membagi-bagi tanah-Ku,"
 },
 {
   "id": 22351,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 3,
   "firman": "oleh karena mereka membuang undi mengenai umat-Ku, menyerahkan seorang anak laki-laki karena seorang sundal, dan menjual seorang anak perempuan karena anggur untuk diminum."
 },
 {
   "id": 22352,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 4,
   "firman": "Lagi apakah sangkut pautmu dengan Aku, hai Tirus dan Sidon dan seluruh wilayah Filistin? Apakah kamu ini hendak membalas perbuatan-Ku? Apabila kamu melakukan sesuatu terhadap Aku, maka dengan cepat, dengan segera Aku akan membalikkan perbuatanmu itu kepadamu sendiri."
 },
 {
   "id": 22353,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 5,
   "firman": "Oleh karena kamu telah mengambil perak-Ku dan emas-Ku dan telah membawa barang-barang-Ku yang berharga yang indah-indah ke tempat-tempat ibadahmu,"
 },
 {
   "id": 22354,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 6,
   "firman": "dan telah menjual orang-orang Yehuda dan orang-orang Yerusalem kepada orang Yunani dengan maksud menjauhkan mereka dari daerah mereka."
 },
 {
   "id": 22355,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sesungguhnya Aku akan menggerakkan mereka dari tempat ke mana kamu menjual mereka, dan Aku akan membalikkan perbuatanmu itu ke atas kepalamu sendiri."
 },
 {
   "id": 22356,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 8,
   "firman": "Aku akan menjual anak-anakmu laki-laki dan perempuan kepada orang-orang Yehuda dan mereka akan menjual anak-anakmu itu kepada orang-orang Syeba, kepada suatu bangsa yang jauh, sebab TUHAN telah mengatakannya.\""
 },
 {
   "id": 22357,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 9,
   "firman": "Maklumkanlah hal ini di antara bangsa-bangsa: bersiaplah untuk peperangan, gerakkanlah para pahlawan; suruhlah semua prajurit tampil dan maju!"
 },
 {
   "id": 22358,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tempalah mata bajakmu menjadi pedang dan pisau-pisau pemangkasmu menjadi tombak; baiklah orang yang tidak berdaya berkata: \"Aku ini pahlawan!\""
 },
 {
   "id": 22359,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 11,
   "firman": "Bergeraklah dan datanglah, hai segala bangsa dari segenap penjuru, dan berkumpullah ke sana! Bawalah turun, ya TUHAN, pahlawan-pahlawan-Mu!"
 },
 {
   "id": 22360,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 12,
   "firman": "Baiklah bangsa-bangsa bergerak dan maju ke lembah Yosafat, sebab di sana Aku akan duduk untuk menghakimi segala bangsa dari segenap penjuru."
 },
 {
   "id": 22361,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 13,
   "firman": "Ayunkanlah sabit, sebab sudah masak tuaian; marilah, iriklah, sebab sudah penuh tempat anggur; tempat-tempat pemerasan kelimpahan, sebab banyak kejahatan mereka."
 },
 {
   "id": 22362,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 14,
   "firman": "Banyak orang, banyak orang di lembah penentuan! Ya, sudah dekat hari TUHAN di lembah penentuan!"
 },
 {
   "id": 22363,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 15,
   "firman": "Matahari dan bulan menjadi gelap, dan bintang-bintang menghilangkan cahayanya."
 },
 {
   "id": 22364,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 16,
   "firman": "TUHAN mengaum dari Sion, dari Yerusalem Ia memperdengarkan suara-Nya, dan langit dan bumi bergoncang. Tetapi TUHAN adalah tempat perlindungan bagi umat-Nya, dan benteng bagi orang Israel."
 },
 {
   "id": 22365,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 17,
   "firman": "\"Maka kamu akan mengetahui bahwa Aku, TUHAN, adalah Allahmu, yang diam di Sion, gunung-Ku yang kudus. Dan Yerusalem akan menjadi kudus, dan orang-orang luar tidak akan melintasinya lagi."
 },
 {
   "id": 22366,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 18,
   "firman": "Pada waktu itu akan terjadi, bahwa gunung-gunung akan meniriskan anggur baru, bukit-bukit akan mengalirkan susu, dan segala sungai Yehuda akan mengalirkan air; mata air akan terbit dari rumah TUHAN dan akan membasahi lembah Sitim."
 },
 {
   "id": 22367,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 19,
   "firman": "Mesir akan menjadi sunyi sepi, dan Edom akan menjadi padang gurun tandus, oleh sebab kekerasan terhadap keturunan Yehuda, oleh karena mereka telah menumpahkan darah orang yang tak bersalah di tanahnya."
 },
 {
   "id": 22368,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 20,
   "firman": "Tetapi Yehuda tetap didiami untuk selama-lamanya dan Yerusalem turun-temurun."
 },
 {
   "id": 22369,
   "kitab": "Yoe",
   "pasal": 3,
   "ayat": 21,
   "firman": "Aku akan membalas darah mereka yang belum Kubalas; TUHAN tetap diam di Sion.\""
 },
 {
   "id": 22370,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 1,
   "firman": "Perkataan yang dinyatakan kepada Amos, salah seorang peternak domba dari Tekoa, tentang Israel pada zaman Uzia, raja Yehuda, dan dalam zaman Yerobeam, anak Yoas, raja Israel, dua tahun sebelum gempa bumi."
 },
 {
   "id": 22371,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 2,
   "firman": "Berkatalah ia: \"TUHAN mengaum dari Sion dan dari Yerusalem Ia memperdengarkan suara-Nya; keringlah padang-padang penggembalaan dan layulah puncak gunung Karmel.\""
 },
 {
   "id": 22372,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 3,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Damsyik, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka telah mengirik Gilead dengan eretan pengirik dari besi,"
 },
 {
   "id": 22373,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 4,
   "firman": "Aku akan melepas api ke dalam istana Hazael, sehingga puri Benhadad dimakan habis;"
 },
 {
   "id": 22374,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 5,
   "firman": "Aku akan mematahkan palang pintu Damsyik dan melenyapkan penduduk dari Bikeat-Awen serta pemegang tongkat kerajaan dari Bet-Eden; dan rakyat Aram harus pergi sebagai orang buangan ke Kir,\" firman TUHAN."
 },
 {
   "id": 22375,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 6,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Gaza, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka telah mengangkut ke dalam pembuangan suatu bangsa seluruhnya, untuk diserahkan kepada Edom,"
 },
 {
   "id": 22376,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 7,
   "firman": "Aku akan melepas api ke dalam tembok Gaza, sehingga purinya dimakan habis;"
 },
 {
   "id": 22377,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 8,
   "firman": "Aku akan melenyapkan penduduk dari Asdod dan pemegang tongkat kerajaan dari Askelon; Aku akan mengacungkan tangan-Ku melawan Ekron, sehingga binasalah sisa-sisa orang Filistin,\" firman Tuhan ALLAH."
 },
 {
   "id": 22378,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 9,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Tirus, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka telah menyerahkan tertawan suatu bangsa seluruhnya kepada Edom dan tidak mengingat perjanjian persaudaraan,"
 },
 {
   "id": 22379,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 10,
   "firman": "Aku akan melepas api ke dalam tembok Tirus, sehingga purinya dimakan habis.\""
 },
 {
   "id": 22380,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 11,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Edom, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena ia mengejar saudaranya dengan pedang dan mengekang belas kasihannya, memendamkan amarahnya untuk selamanya dan menyimpan gemasnya untuk seterusnya,"
 },
 {
   "id": 22381,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 12,
   "firman": "Aku akan melepas api ke dalam Teman, sehingga puri Bozra dimakan habis.\""
 },
 {
   "id": 22382,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 13,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat bani Amon, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka membelah perut perempuan-perempuan hamil di Gilead dengan maksud meluaskan daerah mereka sendiri,"
 },
 {
   "id": 22383,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 14,
   "firman": "Aku akan menyalakan api di dalam tembok Raba, sehingga purinya dimakan habis, diiringi sorak-sorai pada waktu pertempuran, diiringi angin badai pada waktu puting beliung;"
 },
 {
   "id": 22384,
   "kitab": "Amo",
   "pasal": 1,
   "ayat": 15,
   "firman": "dan raja mereka harus pergi sebagai orang buangan, ia bersama-sama dengan pembesar-pembesarnya,\" firman TUHAN."
 },
 {
   "id": 22385,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 1,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Moab, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena ia telah membakar tulang-tulang raja Edom menjadi kapur,"
 },
 {
   "id": 22386,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 2,
   "firman": "Aku akan melepas api ke dalam Moab, sehingga puri Keriot dimakan habis; Moab akan mati di dalam kegaduhan, diiringi sorak-sorai pada saat sangkakala berbunyi;"
 },
 {
   "id": 22387,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 3,
   "firman": "Aku akan melenyapkan penguasa dari antaranya dan membunuh segala pembesarnya bersama-sama dengan dia,\" firman TUHAN."
 },
 {
   "id": 22388,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 4,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Yehuda, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka telah menolak hukum TUHAN, dan tidak berpegang pada ketetapan-ketetapan-Nya, tetapi disesatkan oleh dewa-dewa kebohongannya, yang diikuti oleh nenek moyangnya,"
 },
 {
   "id": 22389,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 5,
   "firman": "Aku akan melepas api ke dalam Yehuda, sehingga puri Yerusalem dimakan habis.\""
 },
 {
   "id": 22390,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 6,
   "firman": "Beginilah firman TUHAN: \"Karena tiga perbuatan jahat Israel, bahkan empat, Aku tidak akan menarik kembali keputusan-Ku: Oleh karena mereka menjual orang benar karena uang dan orang miskin karena sepasang kasut;"
 },
 {
   "id": 22391,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 7,
   "firman": "mereka menginjak-injak kepala orang lemah ke dalam debu dan membelokkan jalan orang sengsara; anak dan ayah pergi menjamah seorang perempuan muda, sehingga melanggar kekudusan nama-Ku;"
 },
 {
   "id": 22392,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 8,
   "firman": "mereka merebahkan diri di samping setiap mezbah di atas pakaian gadaian orang, dan minum anggur orang-orang yang kena denda di rumah Allah mereka."
 },
 {
   "id": 22393,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 9,
   "firman": "Padahal Akulah yang memunahkan dari depan mereka, orang Amori, yang tingginya seperti tinggi pohon aras dan yang kuat seperti pohon tarbantin; Aku telah memunahkan buahnya dari atas dan akarnya dari bawah."
 },
 {
   "id": 22394,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 10,
   "firman": "Padahal Akulah yang menuntun kamu keluar dari tanah Mesir dan memimpin kamu empat puluh tahun lamanya di padang gurun, supaya kamu menduduki negeri orang Amori;"
 },
 {
   "id": 22395,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 11,
   "firman": "Aku telah membangkitkan sebagian dari anak-anakmu menjadi nabi dan sebagian dari teruna-terunamu menjadi nazir. Bukankah betul-betul begitu, hai orang Israel?\" demikianlah firman TUHAN."
 },
 {
   "id": 22396,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 12,
   "firman": "\"Tetapi kamu memberi orang nazir minum anggur dan memerintahkan kepada para nabi: Jangan kamu bernubuat!"
 },
 {
   "id": 22397,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sesungguhnya, Aku akan mengguncangkan tempat kamu berpijak seperti goncangan kereta yang sarat dengan berkas gandum."
 },
 {
   "id": 22398,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 14,
   "firman": "Orang cepat tidak mungkin lagi melarikan diri, orang kuat tidak dapat menggunakan kekuatannya, dan pahlawan tidak dapat melarikan diri."
 },
 {
   "id": 22399,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 15,
   "firman": "Pemegang panah tidak dapat bertahan, orang yang cepat kaki tidak akan terluput dan penunggang kuda tidak dapat meluputkan diri."
 },
 {
   "id": 22400,
   "kitab": "Amo",
   "pasal": 2,
   "ayat": 16,
   "firman": "Juga orang yang berhati berani di antara para pahlawan akan melarikan diri dengan telanjang pada hari itu,\" demikianlah firman TUHAN."
 },
 {
   "id": 22401,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 1,
   "firman": "Dengarlah firman ini, yang diucapkan TUHAN tentang kamu, hai orang Israel, tentang segenap kaum yang telah Kutuntun keluar dari tanah Mesir, bunyinya:"
 },
 {
   "id": 22402,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 2,
   "firman": "\"Hanya kamu yang Kukenal dari segala kaum di muka bumi, sebab itu Aku akan menghukum kamu karena segala kesalahanmu."
 },
 {
   "id": 22403,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 3,
   "firman": "Berjalankah dua orang bersama-sama, jika mereka belum berjanji?"
 },
 {
   "id": 22404,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mengaumkah seekor singa di hutan, apabila tidak mendapat mangsa? Bersuarakah singa muda dari sarangnya, jika belum menangkap apa-apa?"
 },
 {
   "id": 22405,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 5,
   "firman": "Jatuhkah seekor burung ke dalam perangkap di tanah, apabila tidak ada jerat terhadapnya? Membingkaskah perangkap dari tanah, jika tidak ditangkapnya sesuatu?"
 },
 {
   "id": 22406,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 6,
   "firman": "Adakah sangkakala ditiup di suatu kota, dan orang-orang tidak gemetar? Adakah terjadi malapetaka di suatu kota, dan TUHAN tidak melakukannya?"
 },
 {
   "id": 22407,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sungguh, Tuhan ALLAH tidak berbuat sesuatu tanpa menyatakan keputusan-Nya kepada hamba-hamba-Nya, para nabi."
 },
 {
   "id": 22408,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 8,
   "firman": "Singa telah mengaum, siapakah yang tidak takut? Tuhan ALLAH telah berfirman, siapakah yang tidak bernubuat?\""
 },
 {
   "id": 22409,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 9,
   "firman": "Siarkanlah di dalam puri di Asyur dan di dalam puri di tanah Mesir serta katakan: \"Berkumpullah di gunung-gunung dekat Samaria dan pandanglah kekacauan besar yang ada di tengah-tengahnya dan pemerasan yang ada di kota itu.\""
 },
 {
   "id": 22410,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 10,
   "firman": "\"Mereka tidak tahu berbuat jujur,\" demikianlah firman TUHAN, \"mereka itu yang menimbun kekerasan dan aniaya di dalam purinya.\""
 },
 {
   "id": 22411,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 11,
   "firman": "Sebab itu beginilah firman Tuhan ALLAH: \"Musuh akan ada di sekeliling negeri, kekuatanmu akan ditanggalkannya dari padamu, dan purimu akan dijarahi!\""
 },
 {
   "id": 22412,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 12,
   "firman": "Beginilah firman TUHAN: \"Seperti seorang gembala melepaskan dari mulut singa dua tulang betis atau potongan telinga, demikianlah orang Israel yang diam di Samaria akan dilepaskan seperti sebagian dari katil dan seperti sepenggal dari kaki balai-balai.\""
 },
 {
   "id": 22413,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 13,
   "firman": "\"Dengarlah, dan peringatkanlah kaum keturunan Yakub,\" demikianlah firman Tuhan ALLAH, Allah semesta alam,"
 },
 {
   "id": 22414,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 14,
   "firman": "\"bahwa pada waktu Aku menghukum Israel karena perbuatan-perbuatannya yang jahat, Aku akan melakukan hukuman kepada mezbah-mezbah Betel, sehingga tanduk-tanduk mezbah itu dipatahkan dan jatuh ke tanah."
 },
 {
   "id": 22415,
   "kitab": "Amo",
   "pasal": 3,
   "ayat": 15,
   "firman": "Aku akan merobohkan balai musim dingin beserta balai musim panas; hancurlah rumah-rumah gading, dan habislah rumah-rumah gedang,\" demikianlah firman TUHAN."
 },
 {
   "id": 22416,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 1,
   "firman": "\"Dengarlah firman ini, hai lembu-lembu Basan, yang ada di gunung Samaria, yang memeras orang lemah, yang menginjak orang miskin, yang mengatakan kepada tuan-tuanmu: bawalah ke mari, supaya kita minum-minum!"
 },
 {
   "id": 22417,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 2,
   "firman": "Tuhan ALLAH telah bersumpah demi kekudusan-Nya: sesungguhnya, akan datang masanya bagimu, bahwa kamu diangkat dengan kait dan yang tertinggal di antara kamu dengan kail ikan."
 },
 {
   "id": 22418,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 3,
   "firman": "Kamu akan keluar melalui belahan tembok, masing-masing lurus ke depan, dan kamu akan diseret ke arah Hermon,\" demikianlah firman TUHAN."
 },
 {
   "id": 22419,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 4,
   "firman": "\"Datanglah ke Betel dan lakukanlah perbuatan jahat, ke Gilgal dan perhebatlah perbuatan jahat! Bawalah korban sembelihanmu pada waktu pagi, dan persembahan persepuluhanmu pada hari yang ketiga!"
 },
 {
   "id": 22420,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 5,
   "firman": "Bakarlah korban syukur dari roti yang beragi dan maklumkanlah persembahan-persembahan sukarela; siarkanlah itu! Sebab bukankah yang demikian kamu sukai, hai orang Israel?\" demikianlah firman Tuhan ALLAH."
 },
 {
   "id": 22421,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 6,
   "firman": "\"Sekalipun Aku ini telah memberi kepadamu gigi yang tidak disentuh makanan di segala kotamu dan kekurangan roti di segala tempat kediamanmu, namun kamu tidak berbalik kepada-Ku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22422,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 7,
   "firman": "\"Akupun telah menahan hujan dari padamu, ketika tiga bulan lagi sebelum panen; Aku menurunkan hujan ke atas kota yang satu dan tidak menurunkan hujan ke atas kota yang lain; ladang yang satu kehujanan, dan ladang, yang tidak kena hujan, menjadi kering;"
 },
 {
   "id": 22423,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 8,
   "firman": "penduduk dua tiga kota pergi terhuyung-huyung ke satu kota untuk minum air, tetapi mereka tidak menjadi puas; namun kamu tidak berbalik kepada-Ku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22424,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 9,
   "firman": "\"Aku telah memukul kamu dengan hama dan penyakit gandum, telah melayukan taman-tamanmu dan kebun-kebun anggurmu, pohon-pohon ara dan pohon-pohon zaitunmu dimakan habis oleh belalang, namun kamu tidak berbalik kepada-Ku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22425,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 10,
   "firman": "\"Aku telah melepas penyakit sampar ke antaramu seperti kepada orang Mesir; Aku telah membunuh terunamu dengan pedang pada waktu kudamu dijarah; Aku telah membuat bau busuk perkemahanmu tercium oleh hidungmu; namun kamu tidak berbalik kepada-Ku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22426,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 11,
   "firman": "\"Aku telah menjungkirbalikkan kota-kota di antara kamu, seperti Allah menjungkirbalikkan Sodom dan Gomora, sehingga kamu menjadi seperti puntung yang ditarik dari kebakaran, namun kamu tidak berbalik kepada-Ku,\" demikianlah firman TUHAN."
 },
 {
   "id": 22427,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 12,
   "firman": "\"Sebab itu demikianlah akan Kulakukan kepadamu, hai Israel. --Oleh karena Aku akan melakukan yang demikian kepadamu, maka bersiaplah untuk bertemu dengan Allahmu, hai Israel!\""
 },
 {
   "id": 22428,
   "kitab": "Amo",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sebab sesungguhnya, Dia yang membentuk gunung-gunung dan menciptakan angin, yang memberitahukan kepada manusia apa yang dipikirkan-Nya, yang membuat fajar dan kegelapan dan yang berjejak di atas bukit-bukit bumi--TUHAN, Allah semesta alam, itulah nama-Nya."
 },
 {
   "id": 22429,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 1,
   "firman": "Dengarlah perkataan ini yang kuucapkan tentang kamu sebagai ratapan, hai kaum Israel:"
 },
 {
   "id": 22430,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 2,
   "firman": "\"Telah rebah, tidak akan bangkit-bangkit lagi anak dara Israel, terkapar di atas tanahnya, tidak ada yang membangkitkannya.\""
 },
 {
   "id": 22431,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 3,
   "firman": "Sebab beginilah firman Tuhan ALLAH kepada kaum Israel: \"Kota yang maju berperang dengan seribu orang, dari padanya akan tersisa seratus orang, dan yang maju berperang dengan seratus orang, dari padanya akan tersisa sepuluh orang.\""
 },
 {
   "id": 22432,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 4,
   "firman": "Sebab beginilah firman TUHAN kepada kaum Israel: \"Carilah Aku, maka kamu akan hidup!"
 },
 {
   "id": 22433,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 5,
   "firman": "Janganlah kamu mencari Betel, janganlah pergi ke Gilgal dan janganlah menyeberang ke Bersyeba, sebab Gilgal pasti masuk ke dalam pembuangan dan Betel akan lenyap.\""
 },
 {
   "id": 22434,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 6,
   "firman": "Carilah TUHAN, maka kamu akan hidup, supaya jangan Ia memasuki keturunan Yusuf bagaikan api, yang memakannya habis dengan tidak ada yang memadamkan bagi Betel."
 },
 {
   "id": 22435,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 7,
   "firman": "Hai kamu yang mengubah keadilan menjadi ipuh dan yang mengempaskan kebenaran ke tanah!"
 },
 {
   "id": 22436,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 8,
   "firman": "Dia yang telah membuat bintang kartika dan bintang belantik, yang mengubah kekelaman menjadi pagi dan yang membuat siang gelap seperti malam; Dia yang memanggil air laut dan mencurahkannya ke atas permukaan bumi--TUHAN itulah nama-Nya."
 },
 {
   "id": 22437,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dia yang menimpakan kebinasaan atas yang kuat, sehingga kebinasaan datang atas tempat yang berkubu."
 },
 {
   "id": 22438,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 10,
   "firman": "Mereka benci kepada yang memberi teguran di pintu gerbang, dan mereka keji kepada yang berkata dengan tulus ikhlas."
 },
 {
   "id": 22439,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 11,
   "firman": "Sebab itu, karena kamu menginjak-injak orang yang lemah dan mengambil pajak gandum dari padanya, --sekalipun kamu telah mendirikan rumah-rumah dari batu pahat, kamu tidak akan mendiaminya; sekalipun kamu telah membuat kebun anggur yang indah, kamu tidak akan minum anggurnya."
 },
 {
   "id": 22440,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab Aku tahu, bahwa perbuatanmu yang jahat banyak dan dosamu berjumlah besar, hai kamu yang menjadikan orang benar terjepit, yang menerima uang suap dan yang mengesampingkan orang miskin di pintu gerbang."
 },
 {
   "id": 22441,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 13,
   "firman": "Sebab itu orang yang berakal budi akan berdiam diri pada waktu itu, karena waktu itu adalah waktu yang jahat."
 },
 {
   "id": 22442,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 14,
   "firman": "Carilah yang baik dan jangan yang jahat, supaya kamu hidup; dengan demikian TUHAN, Allah semesta alam, akan menyertai kamu, seperti yang kamu katakan."
 },
 {
   "id": 22443,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 15,
   "firman": "Bencilah yang jahat dan cintailah yang baik; dan tegakkanlah keadilan di pintu gerbang; mungkin TUHAN, Allah semesta alam, akan mengasihani sisa-sisa keturunan Yusuf."
 },
 {
   "id": 22444,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 16,
   "firman": "Sesungguhnya, beginilah firman TUHAN, Allah semesta alam, Tuhanku: \"Di segala tanah lapang akan ada ratapan dan di segala lorong orang akan berkata: Wahai! Wahai! Petani dipanggil untuk berkabung dan orang-orang yang pandai meratap untuk mengadakan ratapan."
 },
 {
   "id": 22445,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 17,
   "firman": "Dan di segala kebun anggur akan ada ratapan, apabila Aku berjalan dari tengah-tengahmu,\" firman TUHAN."
 },
 {
   "id": 22446,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 18,
   "firman": "Celakalah mereka yang menginginkan hari TUHAN! Apakah gunanya hari TUHAN itu bagimu? Hari itu kegelapan, bukan terang!"
 },
 {
   "id": 22447,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 19,
   "firman": "Seperti seseorang yang lari terhadap singa, seekor beruang mendatangi dia, dan ketika ia sampai ke rumah, bertopang dengan tangannya ke dinding, seekor ular memagut dia!"
 },
 {
   "id": 22448,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 20,
   "firman": "Bukankah hari TUHAN itu kegelapan dan bukan terang, kelam kabut dan tidak bercahaya?"
 },
 {
   "id": 22449,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 21,
   "firman": "\"Aku membenci, Aku menghinakan perayaanmu dan Aku tidak senang kepada perkumpulan rayamu."
 },
 {
   "id": 22450,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 22,
   "firman": "Sungguh, apabila kamu mempersembahkan kepada-Ku korban-korban bakaran dan korban-korban sajianmu, Aku tidak suka, dan korban keselamatanmu berupa ternak yang tambun, Aku tidak mau pandang."
 },
 {
   "id": 22451,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 23,
   "firman": "Jauhkanlah dari pada-Ku keramaian nyanyian-nyanyianmu, lagu gambusmu tidak mau Aku dengar."
 },
 {
   "id": 22452,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 24,
   "firman": "Tetapi biarlah keadilan bergulung-gulung seperti air dan kebenaran seperti sungai yang selalu mengalir.\""
 },
 {
   "id": 22453,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 25,
   "firman": "\"Apakah kamu mempersembahkan kepada-Ku korban sembelihan dan korban sajian, selama empat puluh tahun di padang gurun itu, hai kaum Israel?"
 },
 {
   "id": 22454,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 26,
   "firman": "Kamu akan mengangkut Sakut, rajamu, dan Kewan, dewa bintangmu, patung-patungmu yang telah kamu buat bagimu itu,"
 },
 {
   "id": 22455,
   "kitab": "Amo",
   "pasal": 5,
   "ayat": 27,
   "firman": "dan Aku akan membawa kamu ke dalam pembuangan jauh ke seberang Damsyik,\" firman TUHAN, yang nama-Nya Allah semesta alam."
 },
 {
   "id": 22456,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 1,
   "firman": "\"Celaka atas orang-orang yang merasa aman di Sion, atas orang-orang yang merasa tenteram di gunung Samaria, atas orang-orang terkemuka dari bangsa yang utama, orang-orang yang kepada mereka kaum Israel biasa datang!"
 },
 {
   "id": 22457,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 2,
   "firman": "Menyeberanglah ke Kalne, dan lihat-lihatlah; berjalanlah dari sana ke Hamat yang besar itu, dan pergilah ke Gat orang Filistin! Adakah mereka lebih baik dari kerajaan-kerajaan ini, atau lebih besarkah daerah mereka dari daerahmu?"
 },
 {
   "id": 22458,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 3,
   "firman": "Hai kamu, yang menganggap jauh hari malapetaka, tetapi mendekatkan pemerintahan kekerasan;"
 },
 {
   "id": 22459,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 4,
   "firman": "yang berbaring di tempat tidur dari gading dan duduk berjuntai di ranjang; yang memakan anak-anak domba dari kumpulan kambing domba dan anak-anak lembu dari tengah-tengah kawanan binatang yang tambun;"
 },
 {
   "id": 22460,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 5,
   "firman": "yang bernyanyi-nyanyi mendengar bunyi gambus, dan seperti Daud menciptakan bunyi-bunyian bagi dirinya;"
 },
 {
   "id": 22461,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 6,
   "firman": "yang minum anggur dari bokor, dan berurap dengan minyak yang paling baik, tetapi tidak berduka karena hancurnya keturunan Yusuf!"
 },
 {
   "id": 22462,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 7,
   "firman": "Sebab itu sekarang, mereka akan pergi sebagai orang buangan di kepala barisan, dan berlalulah keriuhan pesta orang-orang yang duduk berjuntai itu.\""
 },
 {
   "id": 22463,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tuhan ALLAH telah bersumpah demi diri-Nya, --demikianlah firman TUHAN, Allah semesta alam--:\"Aku ini keji kepada kecongkakan Yakub, dan benci kepada purinya; Aku akan menyerahkan kota serta isinya.\""
 },
 {
   "id": 22464,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dan jika masih tinggal sepuluh orang dalam satu rumah, mereka akan mati."
 },
 {
   "id": 22465,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 10,
   "firman": "Dan jika pamannya, pembakar mayat itu, yang datang mengangkat dan mengeluarkan mayat itu dari rumah itu, bertanya kepada orang yang ada di bagian belakang rumah: \"Adakah lagi orang bersama-sama engkau?\" dan dijawab: \"Tidak ada,\" ia akan berkata: \"Diam!\" Sebab tidaklah patut menyebut-nyebut nama TUHAN!"
 },
 {
   "id": 22466,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 11,
   "firman": "Sebab sesungguhnya, TUHAN memberi perintah, maka rumah besar dirobohkan menjadi reruntuhan dan rumah kecil menjadi rosokan."
 },
 {
   "id": 22467,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 12,
   "firman": "Berlarikah kuda-kuda di atas bukit batu, atau dibajak orangkah laut dengan lembu? Sungguh, kamu telah mengubah keadilan menjadi racun dan hasil kebenaran menjadi ipuh!"
 },
 {
   "id": 22468,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 13,
   "firman": "Hai kamu, yang bersukacita karena Lodabar, dan yang berkata: \"Bukankah kita dengan kekuatan kita merebut Karnaim bagi kita?\""
 },
 {
   "id": 22469,
   "kitab": "Amo",
   "pasal": 6,
   "ayat": 14,
   "firman": "\"Sebab sesungguhnya, Aku akan membangkitkan suatu bangsa melawan kamu, hai kaum Israel,\" demikianlah firman TUHAN, Allah semesta alam, \"dan mereka akan menindas kamu dari jalan yang menuju ke Hamat sampai ke sungai yang di Araba.\""
 },
 {
   "id": 22470,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 1,
   "firman": "Inilah yang diperlihatkan Tuhan ALLAH kepadaku: Tampak Ia membentuk kawanan belalang, pada waktu rumput akhir mulai tumbuh, yaitu rumput akhir sesudah yang dipotong bagi raja."
 },
 {
   "id": 22471,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 2,
   "firman": "Ketika belalang mulai menghabisi tumbuh-tumbuhan di tanah, berkatalah aku: \"Tuhan ALLAH, berikanlah kiranya pengampunan! Bagaimanakah Yakub dapat bertahan? Bukankah ia kecil?\""
 },
 {
   "id": 22472,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 3,
   "firman": "Maka menyesallah TUHAN karena hal itu. \"Itu tidak akan terjadi,\" firman TUHAN."
 },
 {
   "id": 22473,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 4,
   "firman": "Inilah yang diperlihatkan Tuhan ALLAH kepadaku: Tampak Tuhan ALLAH memanggil api untuk melakukan hukuman. Api itu memakan habis samudera raya dan akan memakan habis tanah ladang."
 },
 {
   "id": 22474,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 5,
   "firman": "Lalu aku berkata: \"Tuhan ALLAH, hentikanlah kiranya! Bagaimanakah Yakub dapat bertahan? Bukankah ia kecil?\""
 },
 {
   "id": 22475,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 6,
   "firman": "Maka menyesallah TUHAN karena hal itu. \"Inipun tidak akan terjadi,\" firman Tuhan ALLAH."
 },
 {
   "id": 22476,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 7,
   "firman": "Inilah yang diperlihatkan-Nya kepadaku: Tampak Tuhan berdiri dekat sebuah tembok yang tegak lurus, dan di tangan-Nya ada tali sipat."
 },
 {
   "id": 22477,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 8,
   "firman": "Lalu berfirmanlah TUHAN kepadaku: \"Apakah yang kaulihat, Amos?\" Jawabku: \"Tali sipat!\" Berfirmanlah Tuhan: \"Sesungguhnya, Aku akan menaruh tali sipat di tengah-tengah umat-Ku Israel; Aku tidak akan memaafkannya lagi."
 },
 {
   "id": 22478,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 9,
   "firman": "Bukit-bukit pengorbanan dari pada Ishak akan dilicintandaskan dan tempat-tempat kudus Israel akan diruntuhkan, dan Aku akan bangkit melawan keluarga Yerobeam dengan pedang.\""
 },
 {
   "id": 22479,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 10,
   "firman": "Lalu Amazia, imam di Betel, menyuruh orang menghadap Yerobeam, raja Israel, dengan pesan: \"Amos telah mengadakan persepakatan melawan tuanku di tengah-tengah kaum Israel; negeri ini tidak dapat lagi menahan segala perkataannya."
 },
 {
   "id": 22480,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 11,
   "firman": "Sebab beginilah dikatakan Amos: Yerobeam akan mati terbunuh oleh pedang dan Israel pasti pergi dari tanahnya sebagai orang buangan.\""
 },
 {
   "id": 22481,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 12,
   "firman": "Lalu berkatalah Amazia kepada Amos: \"Pelihat, pergilah, enyahlah ke tanah Yehuda! Carilah makananmu di sana dan bernubuatlah di sana!"
 },
 {
   "id": 22482,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 13,
   "firman": "Tetapi jangan lagi bernubuat di Betel, sebab inilah tempat kudus raja, inilah bait suci kerajaan.\""
 },
 {
   "id": 22483,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 14,
   "firman": "Jawab Amos kepada Amazia: \"Aku ini bukan nabi dan aku ini tidak termasuk golongan nabi, melainkan aku ini seorang peternak dan pemungut buah ara hutan."
 },
 {
   "id": 22484,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 15,
   "firman": "Tetapi TUHAN mengambil aku dari pekerjaan menggiring kambing domba, dan TUHAN berfirman kepadaku: Pergilah, bernubuatlah terhadap umat-Ku Israel."
 },
 {
   "id": 22485,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 16,
   "firman": "Maka sekarang, dengarlah firman TUHAN! Engkau berkata: Janganlah bernubuat menentang Israel, dan janganlah ucapkan perkataan menentang keturunan Ishak."
 },
 {
   "id": 22486,
   "kitab": "Amo",
   "pasal": 7,
   "ayat": 17,
   "firman": "Sebab itu beginilah firman TUHAN: Isterimu akan bersundal di kota, dan anak-anakmu laki-laki dan perempuan akan tewas oleh pedang; tanahmu akan dibagi-bagikan dengan memakai tali pengukur, engkau sendiri akan mati di tanah yang najis, dan Israel pasti pergi dari tanahnya sebagai orang buangan.\""
 },
 {
   "id": 22487,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 1,
   "firman": "Inilah yang diperlihatkan Tuhan ALLAH kepadaku: Tampak sebuah bakul berisi buah-buahan musim kemarau."
 },
 {
   "id": 22488,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 2,
   "firman": "Lalu berfirmanlah Ia: \"Apakah yang kaulihat, Amos?\" Jawabku: \"Sebuah bakul berisi buah-buahan musim kemarau.\" Berfirmanlah TUHAN kepadaku: \"Kesudahan telah datang bagi umat-Ku Israel. Aku tidak akan memaafkannya lagi."
 },
 {
   "id": 22489,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 3,
   "firman": "Nyanyian-nyanyian di tempat suci akan menjadi ratapan pada hari itu,\" demikianlah firman Tuhan ALLAH. \"Ada banyak bangkai: ke mana-mana orang melemparkannya dengan diam-diam.\""
 },
 {
   "id": 22490,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 4,
   "firman": "Dengarlah ini, kamu yang menginjak-injak orang miskin, dan yang membinasakan orang sengsara di negeri ini"
 },
 {
   "id": 22491,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 5,
   "firman": "dan berpikir: \"Bilakah bulan baru berlalu, supaya kita boleh menjual gandum dan bilakah hari Sabat berlalu, supaya kita boleh menawarkan terigu dengan mengecilkan efa, membesarkan syikal, berbuat curang dengan neraca palsu,"
 },
 {
   "id": 22492,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 6,
   "firman": "supaya kita membeli orang lemah karena uang dan orang yang miskin karena sepasang kasut; dan menjual terigu rosokan?\""
 },
 {
   "id": 22493,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 7,
   "firman": "TUHAN telah bersumpah demi kebanggaan Yakub: \"Bahwasanya Aku tidak akan melupakan untuk seterusnya segala perbuatan mereka!"
 },
 {
   "id": 22494,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 8,
   "firman": "Tidakkah akan gemetar bumi karena hal itu, sehingga setiap penduduknya berkabung? Tidakkah itu seluruhnya akan naik seperti sungai Nil, diombang-ambingkan dan surut seperti sungai Mesir?\""
 },
 {
   "id": 22495,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 9,
   "firman": "\"Pada hari itu akan terjadi,\" demikianlah firman Tuhan ALLAH, \"Aku akan membuat matahari terbenam di siang hari dan membuat bumi gelap pada hari cerah."
 },
 {
   "id": 22496,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 10,
   "firman": "Aku akan mengubah perayaan-perayaanmu menjadi perkabungan, dan segala nyanyianmu menjadi ratapan. Aku akan mengenakan kain kabung pada setiap pinggang dan menjadikan gundul setiap kepala. Aku akan membuatnya sebagai perkabungan karena kematian anak tunggal, sehingga akhirnya menjadi seperti hari yang pahit pedih.\""
 },
 {
   "id": 22497,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 11,
   "firman": "\"Sesungguhnya, waktu akan datang,\" demikianlah firman Tuhan ALLAH, \"Aku akan mengirimkan kelaparan ke negeri ini, bukan kelaparan akan makanan dan bukan kehausan akan air, melainkan akan mendengarkan firman TUHAN."
 },
 {
   "id": 22498,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 12,
   "firman": "Mereka akan mengembara dari laut ke laut dan menjelajah dari utara ke timur untuk mencari firman TUHAN, tetapi tidak mendapatnya."
 },
 {
   "id": 22499,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 13,
   "firman": "Pada hari itu akan rebah lesu anak-anak dara yang cantik dan anak-anak teruna karena haus;"
 },
 {
   "id": 22500,
   "kitab": "Amo",
   "pasal": 8,
   "ayat": 14,
   "firman": "mereka yang bersumpah demi Asima, dewi Samaria dan yang berkata: Demi allahmu yang hidup, hai Dan! serta: Demi dewa kekasihmu yang hidup, hai Bersyeba! mereka itu akan rebah dan tidak akan bangkit-bangkit lagi.\""
 },
 {
   "id": 22501,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 1,
   "firman": "Kulihat Tuhan berdiri dekat mezbah, dan Ia berfirman: \"Pukullah hulu tiang dengan keras, sehingga ambang-ambang bergoncang, dan runtuhkanlah itu ke atas kepala semua orang, dan sisa-sisa mereka akan Kubunuh dengan pedang; tidak seorangpun dari mereka akan dapat melarikan diri, dan tidak seorangpun dari mereka akan dapat meluputkan diri."
 },
 {
   "id": 22502,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 2,
   "firman": "Sekalipun mereka menembus sampai ke dunia orang mati, tangan-Ku akan mengambil mereka dari sana; sekalipun mereka naik ke langit, Aku akan menurunkan mereka dari sana."
 },
 {
   "id": 22503,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 3,
   "firman": "Sekalipun mereka bersembunyi di puncak gunung Karmel, Aku akan mengusut dan mengambil mereka dari sana; sekalipun mereka menyembunyikan diri terhadap mata-Ku di dasar laut, Aku akan memerintahkan ular untuk memagut mereka di sana."
 },
 {
   "id": 22504,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 4,
   "firman": "Sekalipun mereka berjalan di depan musuhnya sebagai orang tawanan, Aku akan memerintahkan pedang untuk membunuh mereka di sana. Aku akan mengarahkan mata-Ku kepada mereka untuk kecelakaan dan bukan untuk keberuntungan mereka.\""
 },
 {
   "id": 22505,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 5,
   "firman": "Tuhan ALLAH semesta alamlah yang menyentuh bumi, sehingga bergoyang, dan semua penduduknya berkabung, dan seluruhnya naik seperti sungai Nil, dan surut seperti sungai Mesir;"
 },
 {
   "id": 22506,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 6,
   "firman": "yang mendirikan anjung-Nya di langit dan mendasarkan kubah-Nya di atas bumi; yang memanggil air laut dan mencurahkannya ke atas permukaan bumi--TUHAN itulah nama-Nya."
 },
 {
   "id": 22507,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 7,
   "firman": "\"Bukankah kamu sama seperti orang Etiopia bagi-Ku, hai orang Israel?\" demikianlah firman TUHAN. \"Bukankah Aku telah menuntun orang Israel keluar dari tanah Mesir, orang Filistin dari Kaftor, dan orang Aram dari Kir?"
 },
 {
   "id": 22508,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 8,
   "firman": "Sesungguhnya, TUHAN Allah sudah mengamat-amati kerajaan yang berdosa ini: Aku akan memunahkannya dari muka bumi! Tetapi Aku tidak akan memunahkan keturunan Yakub sama sekali,\" demikianlah firman TUHAN."
 },
 {
   "id": 22509,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 9,
   "firman": "\"Sebab sesungguhnya, Aku memberi perintah, dan Aku mengiraikan kaum Israel di antara segala bangsa, seperti orang mengiraikan ayak, dan sebiji batu kecilpun tidak akan jatuh ke tanah."
 },
 {
   "id": 22510,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 10,
   "firman": "Oleh pedang akan mati terbunuh semua orang berdosa di antara umat-Ku yang mengatakan: Malapetaka itu tidak akan menyusul dan tidak akan mencapai kami.\""
 },
 {
   "id": 22511,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 11,
   "firman": "\"Pada hari itu Aku akan mendirikan kembali pondok Daud yang telah roboh; Aku akan menutup pecahan dindingnya, dan akan mendirikan kembali reruntuhannya; Aku akan membangunnya kembali seperti di zaman dahulu kala,"
 },
 {
   "id": 22512,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 12,
   "firman": "supaya mereka menguasai sisa-sisa bangsa Edom dan segala bangsa yang Kusebut milik-Ku,\" demikianlah firman TUHAN yang melakukan hal ini."
 },
 {
   "id": 22513,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 13,
   "firman": "\"Sesungguhnya, waktu akan datang,\" demikianlah firman TUHAN, \"bahwa pembajak akan tepat menyusul penuai dan pengirik buah anggur penabur benih; gunung-gunung akan meniriskan anggur baru dan segala bukit akan kebanjiran."
 },
 {
   "id": 22514,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 14,
   "firman": "Aku akan memulihkan kembali umat-Ku Israel: mereka akan membangun kota-kota yang licin tandas dan mendiaminya; mereka akan menanami kebun-kebun anggur dan minum anggurnya; mereka akan membuat kebun-kebun buah-buahan dan makan buahnya."
 },
 {
   "id": 22515,
   "kitab": "Amo",
   "pasal": 9,
   "ayat": 15,
   "firman": "Maka Aku akan menanam mereka di tanah mereka, dan mereka tidak akan dicabut lagi dari tanah yang telah Kuberikan kepada mereka,\" firman TUHAN, Allahmu."
 },
 {
   "id": 22516,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 1,
   "firman": "Penglihatan Obaja. Beginilah firman Tuhan ALLAH tentang Edom--suatu kabar telah kami dengar dari TUHAN, seorang utusan telah disuruh ke tengah bangsa-bangsa: \"Bangunlah, marilah kita bangkit memeranginya!\" --"
 },
 {
   "id": 22517,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 2,
   "firman": "Sesungguhnya, Aku membuat engkau kecil di antara bangsa-bangsa, engkau dihinakan sangat."
 },
 {
   "id": 22518,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 3,
   "firman": "Keangkuhan hatimu telah memperdayakan engkau, ya engkau yang tinggal di liang-liang batu, di tempat kediamanmu yang tinggi; engkau yang berkata dalam hatimu: \"Siapakah yang sanggup menurunkan aku ke bumi?\""
 },
 {
   "id": 22519,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 4,
   "firman": "Sekalipun engkau terbang tinggi seperti burung rajawali, bahkan, sekalipun sarangmu ditempatkan di antara bintang-bintang, dari sanapun Aku akan menurunkan engkau, --demikianlah firman TUHAN."
 },
 {
   "id": 22520,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 5,
   "firman": "Jika malam-malam pencuri atau perampok datang kepadamu--betapa engkau dibinasakannya--bukankah mereka akan mencuri seberapa yang diperlukannya? Jika pemetik buah anggur datang kepadamu, bukankah mereka akan meninggalkan sisa-sisa pemetikannya?"
 },
 {
   "id": 22521,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 6,
   "firman": "Betapa kaum Esau digeledah, betapa harta bendanya yang tersembunyi dicari-cari!"
 },
 {
   "id": 22522,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sampai ke tapal batas engkau diusir oleh semua teman sekutumu; engkau diperdayakan, dikalahkan oleh sahabat-sahabatmu. Siapa yang makan sehidangan dengan engkau memasang jerat terhadap engkau. --Tidak ada pengertian padanya."
 },
 {
   "id": 22523,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 8,
   "firman": "Bukankah pada waktu itu, demikianlah firman TUHAN, Aku akan melenyapkan orang-orang bijaksana dari Edom, dan pengertian dari pegunungan Esau?"
 },
 {
   "id": 22524,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 9,
   "firman": "Juga para pahlawanmu, hai Teman, akan tertegun, supaya semua orang di pegunungan Esau lenyap terbunuh."
 },
 {
   "id": 22525,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 10,
   "firman": "Karena kekerasan terhadap saudaramu Yakub, maka cela akan meliputi engkau, dan engkau akan dilenyapkan untuk selama-lamanya."
 },
 {
   "id": 22526,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 11,
   "firman": "Pada waktu engkau berdiri di kejauhan, sedang orang-orang luar mengangkut kekayaan Yerusalem dan orang-orang asing memasuki pintu gerbangnya dan membuang undi atasnya, engkaupun seperti salah seorang dari mereka itu."
 },
 {
   "id": 22527,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 12,
   "firman": "Janganlah memandang rendah saudaramu, pada hari kemalangannya, dan janganlah bersukacita atas keturunan Yehuda pada hari kebinasaannya; dan janganlah membual pada hari kesusahannya."
 },
 {
   "id": 22528,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 13,
   "firman": "Janganlah masuk ke pintu gerbang umat-Ku pada hari sialnya, bahkan janganlah memandang ringan malapetaka yang menimpanya pada hari sialnya; dan janganlah merenggut kekayaannya pada hari sialnya."
 },
 {
   "id": 22529,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 14,
   "firman": "Janganlah berdiri di persimpangan untuk melenyapkan orang-orangnya yang luput, dan janganlah serahkan orang-orangnya yang terlepas pada hari kesusahan."
 },
 {
   "id": 22530,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 15,
   "firman": "Sebab telah dekat hari TUHAN menimpa segala bangsa. Seperti yang engkau lakukan, demikianlah akan dilakukan kepadamu, perbuatanmu akan kembali menimpa kepalamu sendiri."
 },
 {
   "id": 22531,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 16,
   "firman": "Sesungguhnya, seperti kamu telah minum di atas gunung-Ku yang kudus, segala bangsapun akan minum dengan tidak henti-hentinya; bahkan, mereka akan minum dengan lahap, dan mereka akan menjadi seakan-akan mereka tidak pernah ada."
 },
 {
   "id": 22532,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 17,
   "firman": "Tetapi di gunung Sion akan ada orang-orang yang terluput, dan gunung itu akan menjadi tempat kudus; dan kaum keturunan Yakub akan memiliki pula tanah miliknya."
 },
 {
   "id": 22533,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 18,
   "firman": "Kaum keturunan Yakub akan menjadi api dan kaum keturunan Yusuf menjadi nyala api, dan kaum keturunan Esau menjadi tunggul gandum: mereka akan membakar dan memakan habis sekaliannya, dan dari kaum keturunan Esau tidak ada seorangpun yang terlepas, sebab Tuhanlah yang berfirman demikian."
 },
 {
   "id": 22534,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 19,
   "firman": "Maka orang-orang Tanah Negeb akan memiliki pegunungan Esau, dan orang-orang Daerah Bukit akan memiliki tanah orang Filistin. Mereka akan memiliki daerah Efraim dan daerah Samaria, dan suku Benyamin akan memiliki daerah Gilead."
 },
 {
   "id": 22535,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 20,
   "firman": "Orang-orang Israel yang diangkut ke dalam pembuangan akan memiliki tanah orang Kanaan sampai ke Zarfat; dan orang-orang Yerusalem yang diangkut ke dalam pembuangan, yang ada di Sefarad, akan memiliki kota-kota di Tanah Negeb."
 },
 {
   "id": 22536,
   "kitab": "Oba",
   "pasal": 1,
   "ayat": 21,
   "firman": "Penyelamat-penyelamat akan naik ke atas gunung Sion untuk menghukumkan pegunungan Esau; maka Tuhanlah yang akan empunya kerajaan itu."
 },
 {
   "id": 22537,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepada Yunus bin Amitai, demikian:"
 },
 {
   "id": 22538,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Bangunlah, pergilah ke Niniwe, kota yang besar itu, berserulah terhadap mereka, karena kejahatannya telah sampai kepada-Ku.\""
 },
 {
   "id": 22539,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 3,
   "firman": "Tetapi Yunus bersiap untuk melarikan diri ke Tarsis, jauh dari hadapan TUHAN; ia pergi ke Yafo dan mendapat di sana sebuah kapal, yang akan berangkat ke Tarsis. Ia membayar biaya perjalanannya, lalu naik kapal itu untuk berlayar bersama-sama dengan mereka ke Tarsis, jauh dari hadapan TUHAN."
 },
 {
   "id": 22540,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 4,
   "firman": "Tetapi TUHAN menurunkan angin ribut ke laut, lalu terjadilah badai besar, sehingga kapal itu hampir-hampir terpukul hancur."
 },
 {
   "id": 22541,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 5,
   "firman": "Awak kapal menjadi takut, masing-masing berteriak-teriak kepada allahnya, dan mereka membuang ke dalam laut segala muatan kapal itu untuk meringankannya. Tetapi Yunus telah turun ke dalam ruang kapal yang paling bawah dan berbaring di situ, lalu tertidur dengan nyenyak."
 },
 {
   "id": 22542,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 6,
   "firman": "Datanglah nakhoda mendapatkannya sambil berkata: \"Bagaimana mungkin engkau tidur begitu nyenyak? Bangunlah, berserulah kepada Allahmu, barangkali Allah itu akan mengindahkan kita, sehingga kita tidak binasa.\""
 },
 {
   "id": 22543,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 7,
   "firman": "Lalu berkatalah mereka satu sama lain: \"Marilah kita buang undi, supaya kita mengetahui, karena siapa kita ditimpa oleh malapetaka ini.\" Mereka membuang undi dan Yunuslah yang kena undi."
 },
 {
   "id": 22544,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 8,
   "firman": "Berkatalah mereka kepadanya: \"Beritahukan kepada kami, karena siapa kita ditimpa oleh malapetaka ini. Apa pekerjaanmu dan dari mana engkau datang, apa negerimu dan dari bangsa manakah engkau?\""
 },
 {
   "id": 22545,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sahutnya kepada mereka: \"Aku seorang Ibrani; aku takut akan TUHAN, Allah yang empunya langit, yang telah menjadikan lautan dan daratan.\""
 },
 {
   "id": 22546,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 10,
   "firman": "Orang-orang itu menjadi sangat takut, lalu berkata kepadanya: \"Apa yang telah kauperbuat?\" --sebab orang-orang itu mengetahui, bahwa ia melarikan diri, jauh dari hadapan TUHAN. Hal itu telah diberitahukannya kepada mereka."
 },
 {
   "id": 22547,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 11,
   "firman": "Bertanyalah mereka: \"Akan kami apakan engkau, supaya laut menjadi reda dan tidak menyerang kami lagi, sebab laut semakin bergelora.\""
 },
 {
   "id": 22548,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 12,
   "firman": "Sahutnya kepada mereka: \"Angkatlah aku, campakkanlah aku ke dalam laut, maka laut akan menjadi reda dan tidak menyerang kamu lagi. Sebab aku tahu, bahwa karena akulah badai besar ini menyerang kamu.\""
 },
 {
   "id": 22549,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 13,
   "firman": "Lalu berdayunglah orang-orang itu dengan sekuat tenaga untuk membawa kapal itu kembali ke darat, tetapi mereka tidak sanggup, sebab laut semakin bergelora menyerang mereka."
 },
 {
   "id": 22550,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 14,
   "firman": "Lalu berserulah mereka kepada TUHAN, katanya: \"Ya TUHAN, janganlah kiranya Engkau biarkan kami binasa karena nyawa orang ini dan janganlah Engkau tanggungkan kepada kami darah orang yang tidak bersalah, sebab Engkau, TUHAN, telah berbuat seperti yang Kaukehendaki.\""
 },
 {
   "id": 22551,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 15,
   "firman": "Kemudian mereka mengangkat Yunus, lalu mencampakkannya ke dalam laut, dan laut berhenti mengamuk."
 },
 {
   "id": 22552,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 16,
   "firman": "Orang-orang itu menjadi sangat takut kepada TUHAN, lalu mempersembahkan korban sembelihan bagi TUHAN serta mengikrarkan nazar."
 },
 {
   "id": 22553,
   "kitab": "Yun",
   "pasal": 1,
   "ayat": 17,
   "firman": "Maka atas penentuan TUHAN datanglah seekor ikan besar yang menelan Yunus; dan Yunus tinggal di dalam perut ikan itu tiga hari tiga malam lamanya."
 },
 {
   "id": 22554,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 1,
   "firman": "Berdoalah Yunus kepada TUHAN, Allahnya, dari dalam perut ikan itu,"
 },
 {
   "id": 22555,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 2,
   "firman": "katanya: \"Dalam kesusahanku aku berseru kepada TUHAN, dan Ia menjawab aku, dari tengah-tengah dunia orang mati aku berteriak, dan Kaudengarkan suaraku."
 },
 {
   "id": 22556,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 3,
   "firman": "Telah Kaulemparkan aku ke tempat yang dalam, ke pusat lautan, lalu aku terangkum oleh arus air; segala gelora dan gelombang-Mu melingkupi aku."
 },
 {
   "id": 22557,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 4,
   "firman": "Dan aku berkata: telah terusir aku dari hadapan mata-Mu. Mungkinkah aku memandang lagi bait-Mu yang kudus?"
 },
 {
   "id": 22558,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 5,
   "firman": "Segala air telah mengepung aku, mengancam nyawaku; samudera raya merangkum aku; lumut lautan membelit kepalaku"
 },
 {
   "id": 22559,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 6,
   "firman": "di dasar gunung-gunung. Aku tenggelam ke dasar bumi; pintunya terpalang di belakangku untuk selama-lamanya. Ketika itulah Engkau naikkan nyawaku dari dalam liang kubur, ya TUHAN, Allahku."
 },
 {
   "id": 22560,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 7,
   "firman": "Ketika jiwaku letih lesu di dalam aku, teringatlah aku kepada TUHAN, dan sampailah doaku kepada-Mu, ke dalam bait-Mu yang kudus."
 },
 {
   "id": 22561,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 8,
   "firman": "Mereka yang berpegang teguh pada berhala kesia-siaan, merekalah yang meninggalkan Dia, yang mengasihi mereka dengan setia."
 },
 {
   "id": 22562,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tetapi aku, dengan ucapan syukur akan kupersembahkan korban kepada-Mu; apa yang kunazarkan akan kubayar. Keselamatan adalah dari TUHAN!\""
 },
 {
   "id": 22563,
   "kitab": "Yun",
   "pasal": 2,
   "ayat": 10,
   "firman": "Lalu berfirmanlah TUHAN kepada ikan itu, dan ikan itupun memuntahkan Yunus ke darat."
 },
 {
   "id": 22564,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN kepada Yunus untuk kedua kalinya, demikian:"
 },
 {
   "id": 22565,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 2,
   "firman": "\"Bangunlah, pergilah ke Niniwe, kota yang besar itu, dan sampaikanlah kepadanya seruan yang Kufirmankan kepadamu.\""
 },
 {
   "id": 22566,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 3,
   "firman": "Bersiaplah Yunus, lalu pergi ke Niniwe, sesuai dengan firman Allah. Niniwe adalah sebuah kota yang mengagumkan besarnya, tiga hari perjalanan luasnya."
 },
 {
   "id": 22567,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mulailah Yunus masuk ke dalam kota itu sehari perjalanan jauhnya, lalu berseru: \"Empat puluh hari lagi, maka Niniwe akan ditunggangbalikkan.\""
 },
 {
   "id": 22568,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 5,
   "firman": "Orang Niniwe percaya kepada Allah, lalu mereka mengumumkan puasa dan mereka, baik orang dewasa maupun anak-anak, mengenakan kain kabung."
 },
 {
   "id": 22569,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 6,
   "firman": "Setelah sampai kabar itu kepada raja kota Niniwe, turunlah ia dari singgasananya, ditanggalkannya jubahnya, diselubungkannya kain kabung, lalu duduklah ia di abu."
 },
 {
   "id": 22570,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 7,
   "firman": "Lalu atas perintah raja dan para pembesarnya orang memaklumkan dan mengatakan di Niniwe demikian: \"Manusia dan ternak, lembu sapi dan kambing domba tidak boleh makan apa-apa, tidak boleh makan rumput dan tidak boleh minum air."
 },
 {
   "id": 22571,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 8,
   "firman": "Haruslah semuanya, manusia dan ternak, berselubung kain kabung dan berseru dengan keras kepada Allah serta haruslah masing-masing berbalik dari tingkah lakunya yang jahat dan dari kekerasan yang dilakukannya."
 },
 {
   "id": 22572,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 9,
   "firman": "Siapa tahu, mungkin Allah akan berbalik dan menyesal serta berpaling dari murka-Nya yang bernyala-nyala itu, sehingga kita tidak binasa.\""
 },
 {
   "id": 22573,
   "kitab": "Yun",
   "pasal": 3,
   "ayat": 10,
   "firman": "Ketika Allah melihat perbuatan mereka itu, yakni bagaimana mereka berbalik dari tingkah lakunya yang jahat, maka menyesallah Allah karena malapetaka yang telah dirancangkan-Nya terhadap mereka, dan Iapun tidak jadi melakukannya."
 },
 {
   "id": 22574,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 1,
   "firman": "Tetapi hal itu sangat mengesalkan hati Yunus, lalu marahlah ia."
 },
 {
   "id": 22575,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 2,
   "firman": "Dan berdoalah ia kepada TUHAN, katanya: \"Ya TUHAN, bukankah telah kukatakan itu, ketika aku masih di negeriku? Itulah sebabnya, maka aku dahulu melarikan diri ke Tarsis, sebab aku tahu, bahwa Engkaulah Allah yang pengasih dan penyayang, yang panjang sabar dan berlimpah kasih setia serta yang menyesal karena malapetaka yang hendak didatangkan-Nya."
 },
 {
   "id": 22576,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 3,
   "firman": "Jadi sekarang, ya TUHAN, cabutlah kiranya nyawaku, karena lebih baik aku mati dari pada hidup.\""
 },
 {
   "id": 22577,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi firman TUHAN: \"Layakkah engkau marah?\""
 },
 {
   "id": 22578,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 5,
   "firman": "Yunus telah keluar meninggalkan kota itu dan tinggal di sebelah timurnya. Ia mendirikan di situ sebuah pondok dan ia duduk di bawah naungannya menantikan apa yang akan terjadi atas kota itu."
 },
 {
   "id": 22579,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lalu atas penentuan TUHAN Allah tumbuhlah sebatang pohon jarak melampaui kepala Yunus untuk menaunginya, agar ia terhibur dari pada kekesalan hatinya. Yunus sangat bersukacita karena pohon jarak itu."
 },
 {
   "id": 22580,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 7,
   "firman": "Tetapi keesokan harinya, ketika fajar menyingsing, atas penentuan Allah datanglah seekor ulat, yang menggerek pohon jarak itu, sehingga layu."
 },
 {
   "id": 22581,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 8,
   "firman": "Segera sesudah matahari terbit, maka atas penentuan Allah bertiuplah angin timur yang panas terik, sehingga sinar matahari menyakiti kepala Yunus, lalu rebahlah ia lesu dan berharap supaya mati, katanya: \"Lebih baiklah aku mati dari pada hidup.\""
 },
 {
   "id": 22582,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tetapi berfirmanlah Allah kepada Yunus: \"Layakkah engkau marah karena pohon jarak itu?\" Jawabnya: \"Selayaknyalah aku marah sampai mati.\""
 },
 {
   "id": 22583,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 10,
   "firman": "Lalu Allah berfirman: \"Engkau sayang kepada pohon jarak itu, yang untuknya sedikitpun engkau tidak berjerih payah dan yang tidak engkau tumbuhkan, yang tumbuh dalam satu malam dan binasa dalam satu malam pula."
 },
 {
   "id": 22584,
   "kitab": "Yun",
   "pasal": 4,
   "ayat": 11,
   "firman": "Bagaimana tidak Aku akan sayang kepada Niniwe, kota yang besar itu, yang berpenduduk lebih dari seratus dua puluh ribu orang, yang semuanya tak tahu membedakan tangan kanan dari tangan kiri, dengan ternaknya yang banyak?\""
 },
 {
   "id": 22585,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada Mikha, orang Moresyet, pada zaman Yotam, Ahas dan Hizkia, raja-raja Yehuda, yakni berkenaan dengan yang dilihatnya tentang Samaria dan Yerusalem."
 },
 {
   "id": 22586,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 2,
   "firman": "Dengarlah, hai bangsa-bangsa sekalian! Perhatikanlah, hai bumi serta isinya! Biarlah Tuhan ALLAH menjadi saksi terhadap kamu, yakni Tuhan dari bait-Nya yang kudus."
 },
 {
   "id": 22587,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 3,
   "firman": "Sebab sesungguhnya, TUHAN keluar dari tempat-Nya dan turun berjejak di atas bukit-bukit bumi."
 },
 {
   "id": 22588,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 4,
   "firman": "Luluhlah gunung-gunung di bawah kaki-Nya, dan lembah-lembah terbelah seperti lilin di depan api, seperti air tercurah di penurunan."
 },
 {
   "id": 22589,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 5,
   "firman": "Semuanya ini terjadi karena pelanggaran Yakub, dan karena dosa kaum Israel. Pelanggaran Yakub itu apa? Bukankah itu Samaria? Dosa kaum Yehuda itu apa? Bukankah itu Yerusalem?"
 },
 {
   "id": 22590,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 6,
   "firman": "Sebab itu Aku akan membuat Samaria menjadi timbunan puing di padang, menjadi tempat penanaman pohon anggur. Aku akan menggulingkan batu-batunya ke dalam lembah dan akan menyingkapkan dasar-dasarnya."
 },
 {
   "id": 22591,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 7,
   "firman": "Segala patungnya akan diremukkan, segala upah sundalnya akan dibakar, dan segala berhalanya akan Kuhancurkan; sebab dari upah sundal dikumpulkan semuanya itu, dan akan kembali menjadi upah sundal."
 },
 {
   "id": 22592,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 8,
   "firman": "Karena inilah aku hendak berkeluh kesah dan meratap, hendak berjalan dengan tidak berkasut dan telanjang, hendak melolong seperti serigala dan meraung seperti burung unta:"
 },
 {
   "id": 22593,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 9,
   "firman": "sebab lukanya tidak dapat sembuh, sudah menjalar ke Yehuda, sudah sampai ke pintu gerbang bangsaku, ke Yerusalem!"
 },
 {
   "id": 22594,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 10,
   "firman": "Di Gat janganlah sampaikan berita, janganlah sekali-kali menangis! Baiklah gulingkan dirimu dalam debu di Bet-Le-Afra!"
 },
 {
   "id": 22595,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 11,
   "firman": "Berkemaslah, hai penduduk Safir, dengan telanjang dan malu. Tidak berani keluar penduduk Zaanan. Ratapan Bet-Haezel menghalangi engkau untuk tetap berdiri."
 },
 {
   "id": 22596,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 12,
   "firman": "Dengan bimbang penduduk Marot berharap akan kebaikan. Sebab malapetaka turun dari pada TUHAN sampai ke pintu gerbang Yerusalem."
 },
 {
   "id": 22597,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 13,
   "firman": "Pasanglah kuda teji pada kereta, hai penduduk Lakhis! Inilah permulaan dosa bagi puteri Sion, sebab padamulah terdapat pelanggaran Israel."
 },
 {
   "id": 22598,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 14,
   "firman": "Sebab itu baiklah diberi hadiah perpisahan kepada Moresyet-Gat. Rumah-rumah Akhzib akan menjadi tipu daya bagi raja-raja Israel."
 },
 {
   "id": 22599,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 15,
   "firman": "Penakluk masih akan Kudatangkan kepadamu, hai penduduk Maresya! Kemuliaan Israel akan sampai di Adulam."
 },
 {
   "id": 22600,
   "kitab": "Mik",
   "pasal": 1,
   "ayat": 16,
   "firman": "Cukurlah dan gundulkanlah kepalamu, karena anak-anak kesayanganmu! Jadikanlah kepalamu gundul seperti gundulnya burung bangkai, sebab dari padamu mereka akan masuk pembuangan."
 },
 {
   "id": 22601,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 1,
   "firman": "Celakalah orang-orang yang merancang kedurjanaan dan yang merencanakan kejahatan di tempat tidurnya; yang melakukannya di waktu fajar, sebab hal itu ada dalam kekuasaannya;"
 },
 {
   "id": 22602,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 2,
   "firman": "yang apabila menginginkan ladang-ladang, mereka merampasnya, dan rumah-rumah, mereka menyerobotnya; yang menindas orang dengan rumahnya, manusia dengan milik pusakanya!"
 },
 {
   "id": 22603,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 3,
   "firman": "Sebab itu beginilah firman TUHAN: Sesungguhnya, Aku merancang malapetaka terhadap kaum ini, dan kamu tidak dapat menghindarkan lehermu dari padanya; kamu tidak dapat lagi berjalan angkuh, sebab waktu itu adalah waktu yang mencelakakan."
 },
 {
   "id": 22604,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 4,
   "firman": "Pada hari itu orang akan melontarkan sindiran tentang kamu dan akan memperdengarkan suatu ratapan dan akan berkata: \"Kita telah dihancurluluhkan! Bagian warisan bangsaku telah diukur dengan tali, dan tidak ada orang yang mengembalikannya, ladang-ladang kita dibagikan kepada orang-orang yang menawan kita.\""
 },
 {
   "id": 22605,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 5,
   "firman": "Sebab itu tidak akan ada bagimu orang yang melontarkan tali dengan undian di dalam jemaah TUHAN."
 },
 {
   "id": 22606,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 6,
   "firman": "\"Janganlah ucapkan nubuat,\" kata mereka itu, \"orang tidak mengucapkan nubuat seperti itu! Noda tidak akan menimpa kita.\""
 },
 {
   "id": 22607,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 7,
   "firman": "Bolehkah hal itu dikatakan, keturunan Yakub? Apakah TUHAN kurang sabar? Atau seperti inikah tindakan-Nya? Bukankah firman-Ku baik terhadap orang yang benar kelakuannya?"
 },
 {
   "id": 22608,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 8,
   "firman": "Tetapi kamulah yang bangkit sebagai musuh terhadap umat-Ku. Kamu merebut jubah dari orang-orang yang suka damai, dari orang-orang yang berjalan lewat dengan tenteram, yang tidak cenderung kepada perang."
 },
 {
   "id": 22609,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 9,
   "firman": "Para isteri di antara umat-Ku kamu halau dari rumah kesayangannya, dari bayi-bayinya kamu mengambil untuk selama-lamanya, semarak yang telah Kuberikan kepada mereka."
 },
 {
   "id": 22610,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 10,
   "firman": "Bangkitlah dan pergilah, sebab ini bukan tempat perhentian bagimu! Oleh karena kenajisan maka kamu akan dibinasakan dengan kebinasaan yang tidak terpulihkan."
 },
 {
   "id": 22611,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 11,
   "firman": "Seandainya seseorang datang mereka-reka yang hampa dan dusta: \"Aku bernubuat kepadamu tentang anggur dan arak,\" maka dialah yang patut menjadi orang yang bernubuat terhadap bangsa ini!"
 },
 {
   "id": 22612,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dengan sungguh-sungguh Aku akan mengumpulkan engkau seluruhnya, hai Yakub, dengan sungguh-sungguh Aku akan menghimpunkan sisa orang Israel; Aku akan menyatukannya seperti kambing domba dalam kandang, seperti kawanan binatang di tengah-tengah padangnya, sehingga ramai dengan manusia!"
 },
 {
   "id": 22613,
   "kitab": "Mik",
   "pasal": 2,
   "ayat": 13,
   "firman": "Penerobos akan maju di depan mereka; mereka akan menerobos dan berjalan melewati pintu gerbang dan akan keluar dari situ. Raja mereka akan berjalan terus di depan mereka, TUHAN sendiri di kepala barisan mereka!"
 },
 {
   "id": 22614,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 1,
   "firman": "Kataku: Baiklah dengar, hai para kepala di Yakub, dan hai para pemimpin kaum Israel! Bukankah selayaknya kamu mengetahui keadilan,"
 },
 {
   "id": 22615,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 2,
   "firman": "hai kamu yang membenci kebaikan dan yang mencintai kejahatan? Mereka merobek kulit dari tubuh bangsaku dan daging dari tulang-tulangnya;"
 },
 {
   "id": 22616,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 3,
   "firman": "mereka memakan daging bangsaku, dan mengupas kulit dari tubuhnya; mereka meremukkan tulang-tulangnya, dan mencincangnya seperti daging dalam kuali, seperti potongan-potongan daging di dalam belanga."
 },
 {
   "id": 22617,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mereka sendirilah nanti akan berseru-seru kepada TUHAN, tetapi Ia tidak akan menjawab mereka; Ia akan menyembunyikan wajah-Nya terhadap mereka pada waktu itu, sebab jahat perbuatan-perbuatan mereka."
 },
 {
   "id": 22618,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 5,
   "firman": "Beginilah firman TUHAN terhadap para nabi, yang menyesatkan bangsaku, yang apabila mereka mendapat sesuatu untuk dikunyah, maka mereka menyerukan damai, tetapi terhadap orang yang tidak memberi sesuatu ke dalam mulut mereka, maka mereka menyatakan perang."
 },
 {
   "id": 22619,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sebab itu hari akan menjadi malam bagimu tanpa penglihatan, dan menjadi gelap bagimu tanpa tenungan. Matahari akan terbenam bagi para nabi itu, dan hari menjadi hitam suram bagi mereka."
 },
 {
   "id": 22620,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 7,
   "firman": "Para pelihat akan mendapat malu dan tukang-tukang tenung akan tersipu-sipu; mereka sekalian akan menutupi mukanya, sebab tidak ada jawab dari pada Allah."
 },
 {
   "id": 22621,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 8,
   "firman": "Tetapi aku ini penuh dengan kekuatan, dengan Roh TUHAN, dengan keadilan dan keperkasaan, untuk memberitakan kepada Yakub pelanggarannya dan kepada Israel dosanya."
 },
 {
   "id": 22622,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 9,
   "firman": "Baiklah dengarkan ini, hai para kepala kaum Yakub, dan para pemimpin kaum Israel! Hai kamu yang muak terhadap keadilan dan yang membengkokkan segala yang lurus,"
 },
 {
   "id": 22623,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 10,
   "firman": "hai kamu yang mendirikan Sion dengan darah dan Yerusalem dengan kelaliman!"
 },
 {
   "id": 22624,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 11,
   "firman": "Para kepalanya memutuskan hukum karena suap, dan para imamnya memberi pengajaran karena bayaran, para nabinya menenung karena uang, padahal mereka bersandar kepada TUHAN dengan berkata: \"Bukankah TUHAN ada di tengah-tengah kita! Tidak akan datang malapetaka menimpa kita!\""
 },
 {
   "id": 22625,
   "kitab": "Mik",
   "pasal": 3,
   "ayat": 12,
   "firman": "Sebab itu oleh karena kamu maka Sion akan dibajak seperti ladang, dan Yerusalem akan menjadi timbunan puing, dan gunung Bait Suci akan menjadi bukit yang berhutan."
 },
 {
   "id": 22626,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 1,
   "firman": "Akan terjadi pada hari-hari yang terakhir: gunung rumah TUHAN akan berdiri tegak mengatasi gunung-gunung dan menjulang tinggi di atas bukit-bukit; bangsa-bangsa akan berduyun-duyun ke sana,"
 },
 {
   "id": 22627,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 2,
   "firman": "dan banyak suku bangsa akan pergi serta berkata: \"Mari, kita naik ke gunung TUHAN, ke rumah Allah Yakub, supaya Ia mengajar kita tentang jalan-jalan-Nya dan supaya kita berjalan menempuhnya; sebab dari Sion akan keluar pengajaran, dan firman TUHAN dari Yerusalem.\""
 },
 {
   "id": 22628,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 3,
   "firman": "Ia akan menjadi hakim antara banyak bangsa, dan akan menjadi wasit bagi suku-suku bangsa yang besar sampai ke tempat yang jauh; mereka akan menempa pedang-pedangnya menjadi mata bajak, dan tombak-tombaknya menjadi pisau pemangkas; bangsa tidak akan lagi mengangkat pedang terhadap bangsa, dan mereka tidak akan lagi belajar perang."
 },
 {
   "id": 22629,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi mereka masing-masing akan duduk di bawah pohon anggurnya dan di bawah pohon aranya dengan tidak ada yang mengejutkan, sebab mulut TUHAN semesta alam yang mengatakannya."
 },
 {
   "id": 22630,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 5,
   "firman": "Biarpun segala bangsa berjalan masing-masing demi nama allahnya, tetapi kita akan berjalan demi nama TUHAN Allah kita untuk selamanya dan seterusnya."
 },
 {
   "id": 22631,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 6,
   "firman": "Pada hari itu, demikianlah firman TUHAN, Aku akan mengumpulkan mereka yang pincang, dan akan menghimpunkan mereka yang terpencar-pencar dan mereka yang telah Kucelakakan."
 },
 {
   "id": 22632,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 7,
   "firman": "Mereka yang pincang akan Kujadikan pangkal suatu keturunan, dan yang diusir suatu bangsa yang kuat, dan TUHAN akan menjadi raja atas mereka di gunung Sion, dari sekarang sampai selama-lamanya."
 },
 {
   "id": 22633,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dan engkau, hai Menara Kawanan Domba, hai Bukit puteri Sion, kepadamu akan datang dan akan kembali pemerintahan yang dahulu, kerajaan atas puteri Yerusalem."
 },
 {
   "id": 22634,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 9,
   "firman": "Maka sekarang, mengapa engkau berteriak dengan keras? Tiadakah raja di tengah-tengahmu? Atau sudah binasakah penasihatmu, sehingga engkau disergap kesakitan seperti perempuan yang melahirkan?"
 },
 {
   "id": 22635,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 10,
   "firman": "Menggeliatlah dan mengaduhlah, hai puteri Sion, seperti perempuan yang melahirkan! Sebab sekarang terpaksa engkau keluar dari kota dan tinggal di padang, terpaksa engkau berjalan sampai Babel; di sanalah engkau akan dilepaskan, di sanalah engkau akan ditebus oleh TUHAN dari tangan musuhmu."
 },
 {
   "id": 22636,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 11,
   "firman": "Sekarang banyak bangsa berkumpul melawan engkau, dengan berkata: \"Biarlah dia dicemarkan, biarlah mata kita puas memandangi Sion!\""
 },
 {
   "id": 22637,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 12,
   "firman": "Tetapi mereka itu tidak mengetahui rancangan TUHAN; mereka tidak mengerti keputusan-Nya, bahwa Ia akan menghimpunkan mereka seperti berkas gandum ke tempat pengirikan."
 },
 {
   "id": 22638,
   "kitab": "Mik",
   "pasal": 4,
   "ayat": 13,
   "firman": "Bangkitlah dan iriklah, hai puteri Sion, sebab tandukmu akan Kubuat seperti besi, dan kukumu akan Kubuat seperti tembaga, sehingga engkau menumbuk hancur banyak bangsa; engkau akan mengkhususkan rampasan mereka bagi TUHAN dan kekayaan mereka bagi Tuhan seluruh bumi."
 },
 {
   "id": 22639,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 1,
   "firman": "(4-14) Sekarang, engkau harus mendirikan tembok bagimu; pagar pengepungan telah mereka dirikan melawan kita; dengan tongkat mereka memukul pipi orang yang memerintah Israel."
 },
 {
   "id": 22640,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 2,
   "firman": "(5-1) Tetapi engkau, hai Betlehem Efrata, hai yang terkecil di antara kaum-kaum Yehuda, dari padamu akan bangkit bagi-Ku seorang yang akan memerintah Israel, yang permulaannya sudah sejak purbakala, sejak dahulu kala."
 },
 {
   "id": 22641,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 3,
   "firman": "(5-2) Sebab itu ia akan membiarkan mereka sampai waktu perempuan yang akan melahirkan telah melahirkan; lalu selebihnya dari saudara-saudaranya akan kembali kepada orang Israel."
 },
 {
   "id": 22642,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 4,
   "firman": "(5-3) Maka ia akan bertindak dan akan menggembalakan mereka dalam kekuatan TUHAN, dalam kemegahan nama TUHAN Allahnya; mereka akan tinggal tetap, sebab sekarang ia menjadi besar sampai ke ujung bumi,"
 },
 {
   "id": 22643,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 5,
   "firman": "(5-4) dan dia menjadi damai sejahtera. Apabila Asyur masuk ke negeri kita dan apabila ia menginjak tanah kita, maka kita akan membangkitkan melawan dia tujuh gembala, bahkan delapan pemimpin manusia."
 },
 {
   "id": 22644,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 6,
   "firman": "(5-5) Mereka itu akan mencukur negeri Asyur dengan pedang dan negeri Nimrod dengan pedang terhunus; mereka akan melepaskan kita dari Asyur, apabila ia ini masuk ke negeri kita dan menginjak daerah kita."
 },
 {
   "id": 22645,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 7,
   "firman": "(5-6) Maka sisa-sisa Yakub akan ada di tengah-tengah banyak bangsa seperti embun dari pada TUHAN seperti dirus hujan ke atas tumbuh-tumbuhan yang tidak menanti-nantikan orang dan tidak mengharap-harapkan anak manusia."
 },
 {
   "id": 22646,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 8,
   "firman": "(5-7) Maka sisa-sisa Yakub akan ada di antara suku-suku bangsa, di tengah-tengah banyak bangsa seperti singa di antara binatang-binatang hutan, seperti singa muda di antara kawanan kambing domba: ke manapun ia pergi, maka ia membanting dan menerkam, sedang tidak ada yang melepaskan."
 },
 {
   "id": 22647,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 9,
   "firman": "(5-8) Tanganmu akan diangkat melawan para lawanmu, dan semua musuhmu akan dilenyapkan!"
 },
 {
   "id": 22648,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 10,
   "firman": "(5-9) Maka akan terjadi pada waktu itu, demikianlah firman TUHAN, Aku akan melenyapkan kudamu dari tengah-tengahmu dan akan membinasakan keretamu."
 },
 {
   "id": 22649,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 11,
   "firman": "(5-10) Aku akan melenyapkan kota-kota negerimu dan akan meruntuhkan segala kubumu."
 },
 {
   "id": 22650,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 12,
   "firman": "(5-11) Aku akan melenyapkan alat-alat sihir dari tanganmu, dan tukang-tukang peramal tidak akan ada lagi padamu."
 },
 {
   "id": 22651,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 13,
   "firman": "(5-12) Aku akan melenyapkan patung-patungmu dan tugu-tugu berhalamu dari tengah-tengahmu, maka engkau tidak lagi akan sujud menyembah kepada buatan tanganmu."
 },
 {
   "id": 22652,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 14,
   "firman": "(5-13) Aku akan menyentakkan tiang-tiang berhalamu dari tengah-tengahmu dan akan memunahkan berhalamu;"
 },
 {
   "id": 22653,
   "kitab": "Mik",
   "pasal": 5,
   "ayat": 15,
   "firman": "(5-14) Aku akan membalas dendam dengan murka dan kehangatan amarah, kepada bangsa-bangsa yang tidak mau mendengarkan."
 },
 {
   "id": 22654,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 1,
   "firman": "Baiklah dengar firman yang diucapkan TUHAN: Bangkitlah, lancarkanlah pengaduan di depan gunung-gunung, dan biarlah bukit-bukit mendengar suaramu!"
 },
 {
   "id": 22655,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 2,
   "firman": "Dengarlah, hai gunung-gunung, pengaduan TUHAN, dan pasanglah telinga, hai dasar-dasar bumi! Sebab TUHAN mempunyai pengaduan terhadap umat-Nya, dan Ia beperkara dengan Israel."
 },
 {
   "id": 22656,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 3,
   "firman": "\"Umat-Ku, apakah yang telah Kulakukan kepadamu? Dengan apakah engkau telah Kulelahkan? Jawablah Aku!"
 },
 {
   "id": 22657,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sebab Aku telah menuntun engkau keluar dari tanah Mesir dan telah membebaskan engkau dari rumah perbudakan dan telah mengutus Musa dan Harun dan Miryam sebagai penganjurmu."
 },
 {
   "id": 22658,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 5,
   "firman": "Umat-Ku, baiklah ingat apa yang dirancangkan oleh Balak, raja Moab, dan apa yang dijawab kepadanya oleh Bileam bin Beor dan apa yang telah terjadi dari Sitim sampai ke Gilgal, supaya engkau mengakui perbuatan-perbuatan keadilan dari TUHAN.\""
 },
 {
   "id": 22659,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 6,
   "firman": "\"Dengan apakah aku akan pergi menghadap TUHAN dan tunduk menyembah kepada Allah yang di tempat tinggi? Akan pergikah aku menghadap Dia dengan korban bakaran, dengan anak lembu berumur setahun?"
 },
 {
   "id": 22660,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 7,
   "firman": "Berkenankah TUHAN kepada ribuan domba jantan, kepada puluhan ribu curahan minyak? Akan kupersembahkankah anak sulungku karena pelanggaranku dan buah kandunganku karena dosaku sendiri?\""
 },
 {
   "id": 22661,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 8,
   "firman": "\"Hai manusia, telah diberitahukan kepadamu apa yang baik. Dan apakah yang dituntut TUHAN dari padamu: selain berlaku adil, mencintai kesetiaan, dan hidup dengan rendah hati di hadapan Allahmu?\""
 },
 {
   "id": 22662,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dengarlah, TUHAN berseru kepada kota: --adalah bijaksana untuk takut kepada nama-Nya--:\"Dengarlah, hai suku bangsa dan orang kota!"
 },
 {
   "id": 22663,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 10,
   "firman": "Masakan Aku melupakan harta benda kefasikan di rumah orang fasik dan takaran efa yang kurang dan terkutuk itu?"
 },
 {
   "id": 22664,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 11,
   "firman": "Masakan Aku membiarkan tidak dihukum orang yang membawa neraca palsu atau pundi-pundi berisi batu timbangan tipu?"
 },
 {
   "id": 22665,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 12,
   "firman": "Orang-orang kaya di kota itu melakukan banyak kekerasan, penduduknya berkata dusta dan lidah dalam mulut mereka adalah penipu."
 },
 {
   "id": 22666,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 13,
   "firman": "Maka Akupun mulai memukul engkau, menanduskan engkau oleh karena dosamu."
 },
 {
   "id": 22667,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 14,
   "firman": "Engkau ini akan makan, tetapi tidak menjadi kenyang, dan perutmu tetap mengamuk karena lapar; engkau akan menyingkirkan sesuatu, tetapi tidak dapat menyelamatkannya, dan apa yang dapat kauselamatkan, akan Kuserahkan kepada pedang."
 },
 {
   "id": 22668,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 15,
   "firman": "Engkau ini akan menabur, tetapi tidak menuai, engkau ini akan mengirik buah zaitun, tetapi tidak berurap dengan minyaknya; juga mengirik buah anggur, tetapi tidak meminum anggurnya."
 },
 {
   "id": 22669,
   "kitab": "Mik",
   "pasal": 6,
   "ayat": 16,
   "firman": "Engkau telah berpaut kepada ketetapan-ketetapan Omri dan kepada segala perbuatan keluarga Ahab, dan engkau telah bertindak menurut rancangan mereka, sehingga Aku membuat engkau menjadi ketandusan dan pendudukmu menjadi sasaran suitan; demikianlah kamu akan menanggung pencelaan dari pihak bangsa-bangsa.\""
 },
 {
   "id": 22670,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 1,
   "firman": "Celaka aku! Sebab keadaanku seperti pada pengumpulan buah-buahan musim kemarau, seperti pada pemetikan susulan buah anggur: tidak ada buah anggur untuk dimakan, atau buah ara yang kusukai."
 },
 {
   "id": 22671,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 2,
   "firman": "Orang saleh sudah hilang dari negeri, dan tiada lagi orang jujur di antara manusia. Mereka semuanya mengincar darah, yang seorang mencoba menangkap yang lain dengan jaring."
 },
 {
   "id": 22672,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 3,
   "firman": "Tangan mereka sudah cekatan berbuat jahat; pemuka menuntut, hakim dapat disuap; pembesar memberi putusan sekehendaknya, dan hukum, mereka putar balikkan!"
 },
 {
   "id": 22673,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 4,
   "firman": "Orang yang terbaik di antara mereka adalah seperti tumbuhan duri, yang paling jujur di antara mereka seperti pagar duri; hari bagi pengintai-pengintaimu, hari penghukumanmu, telah datang, sekarang akan mulai kegemparan di antara mereka!"
 },
 {
   "id": 22674,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 5,
   "firman": "Janganlah percaya kepada teman, janganlah mengandalkan diri kepada kawan! Jagalah pintu mulutmu terhadap perempuan yang berbaring di pangkuanmu!"
 },
 {
   "id": 22675,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 6,
   "firman": "Sebab anak laki-laki menghina ayahnya, anak perempuan bangkit melawan ibunya, menantu perempuan melawan ibu mertuanya; musuh orang ialah orang-orang seisi rumahnya."
 },
 {
   "id": 22676,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 7,
   "firman": "Tetapi aku ini akan menunggu-nunggu TUHAN, akan mengharapkan Allah yang menyelamatkan aku; Allahku akan mendengarkan aku!"
 },
 {
   "id": 22677,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 8,
   "firman": "Janganlah bersukacita atas aku, hai musuhku! Sekalipun aku jatuh, aku akan bangun pula, sekalipun aku duduk dalam gelap, TUHAN akan menjadi terangku."
 },
 {
   "id": 22678,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 9,
   "firman": "Aku akan memikul kemarahan TUHAN, sebab aku telah berdosa kepada-Nya, sampai Ia memperjuangkan perkaraku dan memberi keadilan kepadaku, membawa aku ke dalam terang, sehingga aku mengalami keadilan-Nya."
 },
 {
   "id": 22679,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 10,
   "firman": "Musuhku akan melihatnya dan dengan malu ia akan menutupi mukanya, dia yang berkata kepadaku: \"Di mana TUHAN, Allahmu?\" Mataku akan memandangi dia; sekarang ia diinjak-injak seperti lumpur di jalan."
 },
 {
   "id": 22680,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 11,
   "firman": "Akan datang suatu hari bahwa pagar tembokmu akan dibangun kembali; pada hari itulah perbatasanmu akan diperluas."
 },
 {
   "id": 22681,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 12,
   "firman": "Pada hari itu orang akan menghadap engkau dari Asyur sampai Mesir, dari Mesir sampai sungai Efrat, dari laut ke laut, dari gunung ke gunung."
 },
 {
   "id": 22682,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 13,
   "firman": "Tetapi bumi akan menjadi tandus oleh karena penduduknya, sebagai akibat perbuatan mereka."
 },
 {
   "id": 22683,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 14,
   "firman": "Gembalakanlah umat-Mu dengan tongkat-Mu, kambing domba milik-Mu sendiri, yang terpencil mendiami rimba di tengah-tengah kebun buah-buahan. Biarlah mereka makan rumput di Basan dan di Gilead seperti pada zaman dahulu kala."
 },
 {
   "id": 22684,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 15,
   "firman": "Seperti pada waktu Engkau keluar dari Mesir, perlihatkanlah kepada kami keajaiban-keajaiban!"
 },
 {
   "id": 22685,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 16,
   "firman": "Biarlah bangsa-bangsa melihatnya dan merasa malu atas segala keperkasaan mereka; biarlah mereka menutup mulutnya dengan tangan, dan telinganya menjadi tuli."
 },
 {
   "id": 22686,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 17,
   "firman": "Biarlah mereka menjilat debu seperti ular, seperti binatang menjalar di bumi; biarlah mereka keluar dengan gemetar dari kubunya, dan datang kepada TUHAN, Allah kami, dengan gentar, dengan takut kepada-Mu!"
 },
 {
   "id": 22687,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 18,
   "firman": "Siapakah Allah seperti Engkau yang mengampuni dosa, dan yang memaafkan pelanggaran dari sisa-sisa milik-Nya sendiri; yang tidak bertahan dalam murka-Nya untuk seterusnya, melainkan berkenan kepada kasih setia?"
 },
 {
   "id": 22688,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 19,
   "firman": "Biarlah Ia kembali menyayangi kita, menghapuskan kesalahan-kesalahan kita dan melemparkan segala dosa kita ke dalam tubir-tubir laut."
 },
 {
   "id": 22689,
   "kitab": "Mik",
   "pasal": 7,
   "ayat": 20,
   "firman": "Kiranya Engkau menunjukkan setia-Mu kepada Yakub dan kasih-Mu kepada Abraham seperti yang telah Kaujanjikan dengan bersumpah kepada nenek moyang kami sejak zaman purbakala!"
 },
 {
   "id": 22690,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ucapan ilahi tentang Niniwe. Kitab penglihatan Nahum, orang Elkosh."
 },
 {
   "id": 22691,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 2,
   "firman": "TUHAN itu Allah yang cemburu dan pembalas, TUHAN itu pembalas dan penuh kehangatan amarah. TUHAN itu pembalas kepada para lawan-Nya dan pendendam kepada para musuh-Nya."
 },
 {
   "id": 22692,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 3,
   "firman": "TUHAN itu panjang sabar dan besar kuasa, tetapi Ia tidak sekali-kali membebaskan dari hukuman orang yang bersalah. Ia berjalan dalam puting beliung dan badai, dan awan adalah debu kaki-Nya."
 },
 {
   "id": 22693,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 4,
   "firman": "Ia menghardik laut dan mengeringkannya, dan segala sungai dijadikan-Nya kering. Basan dan Karmel menjadi merana dan kembang Libanon menjadi layu."
 },
 {
   "id": 22694,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 5,
   "firman": "Gunung-gunung gemetar terhadap Dia, dan bukit-bukit mencair. Bumi menjadi sunyi sepi di hadapan-Nya, dunia serta seluruh penduduknya."
 },
 {
   "id": 22695,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 6,
   "firman": "Siapakah yang tahan berdiri menghadapi geram-Nya? Dan siapakah yang tahan tegak terhadap murka-Nya yang bernyala-nyala? Kehangatan amarah-Nya tercurah seperti api, dan gunung-gunung batu menjadi roboh di hadapan-Nya."
 },
 {
   "id": 22696,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 7,
   "firman": "TUHAN itu baik; Ia adalah tempat pengungsian pada waktu kesusahan; Ia mengenal orang-orang yang berlindung kepada-Nya"
 },
 {
   "id": 22697,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 8,
   "firman": "dan menyeberangkan mereka pada waktu banjir. Ia menghabisi sama sekali orang-orang yang bangkit melawan Dia, dan musuh-Nya dihalau-Nya ke dalam gelap."
 },
 {
   "id": 22698,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 9,
   "firman": "Apakah maksudmu menentang TUHAN? Ia akan menghabisi sama sekali; kesengsaraan tidak akan timbul dua kali!"
 },
 {
   "id": 22699,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 10,
   "firman": "Sebab merekapun akan lenyap seperti duri yang berjalin-jalin, dimakan habis seperti jerami kering."
 },
 {
   "id": 22700,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 11,
   "firman": "Bukankah dari padamu muncul orang yang merancang kejahatan terhadap TUHAN, orang yang memberi nasihat dursila?"
 },
 {
   "id": 22701,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 12,
   "firman": "Beginilah firman TUHAN: \"Sekalipun mereka utuh dan begitu banyak jumlahnya, tetapi mereka akan hilang terbabat dan mati binasa; sekalipun Aku telah merendahkan engkau, tetapi Aku tidak akan merendahkan engkau lagi."
 },
 {
   "id": 22702,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 13,
   "firman": "Sekarang, Aku akan mematahkan gandarnya yang memberati engkau, dan akan memutuskan belenggu-belenggu yang mengikat engkau.\""
 },
 {
   "id": 22703,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 14,
   "firman": "Terhadap engkau, inilah perintah TUHAN: \"Tidak akan ada lagi keturunan dengan namamu. Dari rumah allahmu Aku akan melenyapkan patung pahatan dan patung tuangan; kuburmu akan Kusediakan, sebab engkau hina.\""
 },
 {
   "id": 22704,
   "kitab": "Nah",
   "pasal": 1,
   "ayat": 15,
   "firman": "Lihatlah! Di atas gunung-gunung berjalan orang yang membawa berita, yang mengabarkan berita damai sejahtera. Rayakanlah hari rayamu, hai Yehuda, bayarlah nazarmu! Sebab tidak akan datang lagi orang dursila menyerang engkau; ia telah dilenyapkan sama sekali!"
 },
 {
   "id": 22705,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pembongkar maju terhadap engkau; adakan penjagaan di benteng, mengintailah di jalan, ikatlah pinggangmu teguh-teguh, kumpulkanlah segala kekuatan!"
 },
 {
   "id": 22706,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sungguh, TUHAN memulihkan kebanggaan Yakub, seperti kebanggaan Israel; sebab perusak telah merusakkannya dan telah membinasakan carang-carangnya."
 },
 {
   "id": 22707,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 3,
   "firman": "Perisai para pahlawannya berwarna merah, prajuritnya berpakaian kirmizi; kereta berkilat-kilat seperti api suluh pada hari ia melengkapinya, dan kuda-kuda penuh gelisah."
 },
 {
   "id": 22708,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 4,
   "firman": "Kereta melaju galak di jalan, kejar-mengejar di lapangan; kelihatannya seperti suluh, berpacu seperti kilat."
 },
 {
   "id": 22709,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 5,
   "firman": "Pasukan-pasukan istimewa dikerahkan, mereka tersandung jatuh di waktu berjalan maju; mereka lari terburu-buru ke arah tembok kota, sedang alat pendobrak sudah ditegakkan."
 },
 {
   "id": 22710,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 6,
   "firman": "Pintu-pintu di sungai-sungai telah dibuka, dan istana menjadi gempar."
 },
 {
   "id": 22711,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 7,
   "firman": "Permaisuri dibawa ke luar dan ditelanjangi dan dayang-dayangnya mengerang, mengaduh seperti suara merpati sambil memukul-mukul dada."
 },
 {
   "id": 22712,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 8,
   "firman": "Niniwe sendiri seperti kolam air yang airnya mengalir ke luar. \"Berhenti! Berhenti!\" teriak orang, tetapi tidak ada yang berpaling."
 },
 {
   "id": 22713,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 9,
   "firman": "Jarahlah perak, jarahlah emas! Sebab tidak berkesudahan persediaan harta benda, kelimpahan segala barang yang indah-indah!"
 },
 {
   "id": 22714,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ketandusan, penandusan dan penindasan! Hati menjadi tawar dan lutut goyah! Segenap pinggang gemetar, dan muka sekalian orang menjadi pucat pasi."
 },
 {
   "id": 22715,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 11,
   "firman": "Di mana gerangan persembunyian singa dan gua singa-singa muda, tempat singa pulang pergi, tempat anak singa, di mana tidak ada yang mengganggunya?"
 },
 {
   "id": 22716,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 12,
   "firman": "Biasanya singa itu menerkam supaya cukup makan anak-anaknya, mencekik mangsa bagi betina-betinanya, dan memenuhi liangnya dengan mangsa dan persembunyiannya dengan terkaman."
 },
 {
   "id": 22717,
   "kitab": "Nah",
   "pasal": 2,
   "ayat": 13,
   "firman": "Lihat, Aku akan menjadi lawanmu, demikianlah firman TUHAN semesta alam, Aku akan membakar keretamu menjadi asap, dan pedang akan memakan habis singa mudamu; Aku akan melenyapkan mangsamu dari atas bumi, dan suara utusan-utusanmu tidak akan terdengar lagi."
 },
 {
   "id": 22718,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 1,
   "firman": "Celakalah kota penumpah darah itu! Seluruhnya dusta belaka, penuh dengan perampasan, dan tidak henti-hentinya penerkaman!"
 },
 {
   "id": 22719,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 2,
   "firman": "Dengar, lecut cambuk dan derak-derik roda! Dengar, kuda lari menderap, dan kereta meloncat-loncat!"
 },
 {
   "id": 22720,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 3,
   "firman": "Pasukan berkuda menyerang, pedang bernyala-nyala dan tombak berkilat-kilat! Banyak yang mati terbunuh dan bangkai bertimbun-timbun! Tidak habis-habisnya mayat-mayat, orang tersandung jatuh pada mayat-mayat!"
 },
 {
   "id": 22721,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 4,
   "firman": "Semuanya karena banyaknya persundalan si perempuan sundal, yang cantik parasnya dan ahli dalam sihir, yang memperdayakan bangsa-bangsa dengan persundalannya dan kaum-kaum dengan sihirnya."
 },
 {
   "id": 22722,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 5,
   "firman": "Lihat, Aku akan menjadi lawanmu, demikianlah firman TUHAN semesta alam; Aku akan mengangkat ujung kainmu sampai ke mukamu dan akan memperlihatkan auratmu kepada bangsa-bangsa dan kemaluanmu kepada kerajaan-kerajaan."
 },
 {
   "id": 22723,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 6,
   "firman": "Aku akan melemparkan barang keji ke atasmu, akan menghina engkau dan akan membuat engkau menjadi tontonan."
 },
 {
   "id": 22724,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 7,
   "firman": "Maka semua orang yang melihat engkau akan lari meninggalkan engkau serta berkata: \"Niniwe sudah rusak! Siapakah yang meratapi dia? Dari manakah aku akan mencari penghibur-penghibur untuk dia?\""
 },
 {
   "id": 22725,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 8,
   "firman": "Adakah engkau lebih baik dari Tebe, kota dewa Amon, yang letaknya di sungai Nil, dengan air sekelilingnya, yang tembok kotanya adalah laut, dan bentengnya adalah air?"
 },
 {
   "id": 22726,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 9,
   "firman": "Etiopia adalah kekuatannya, juga Mesir, dengan tidak terbatas; Put dan orang-orang Libia adalah pembantunya."
 },
 {
   "id": 22727,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tetapi dia sendiripun terpaksa pergi ke dalam pembuangan, terpaksa masuk ke dalam tawanan. Bayi-bayinyapun diremukkan di ujung segala jalan; tentang semua orangnya yang dihormati dibuang undi, dan semua pembesarnya dibelenggu dengan rantai."
 },
 {
   "id": 22728,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 11,
   "firman": "Engkaupun akan menjadi mabuk, akan menjadi tidak berdaya; engkaupun akan mencari tempat perlindungan terhadap musuh."
 },
 {
   "id": 22729,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 12,
   "firman": "Segala kubumu adalah seperti pohon ara dengan buah ara yang masak duluan; jika diayunkan, maka jatuhlah buahnya ke dalam mulut orang yang hendak memakannya."
 },
 {
   "id": 22730,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 13,
   "firman": "Sesungguhnya, laskar yang di tengah-tengahmu itu adalah perempuan-perempuan; pintu-pintu gerbang negerimu terbuka lebar-lebar untuk musuhmu; api telah memakan habis palang pintumu."
 },
 {
   "id": 22731,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 14,
   "firman": "Timbalah air menghadapi pengepungan, perkuatlah kubu-kubumu! Pijaklah lumpur, injaklah tanah liat, peganglah acuan batu bata!"
 },
 {
   "id": 22732,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 15,
   "firman": "Di sana api akan memakan engkau habis, pedang akan membabat engkau, akan memakan engkau seperti belalang pelompat. Sekalipun engkau berjumlah besar seperti belalang pelompat, berjumlah besar seperti belalang pindahan,"
 },
 {
   "id": 22733,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 16,
   "firman": "sekalipun kauperbanyak orang-orang dagangmu lebih dari bintang-bintang di langit, seperti belalang pelompat mereka mengembangkan sayap dan terbang menghilang."
 },
 {
   "id": 22734,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sekalipun para penjagamu seperti belalang pindahan dan para pegawaimu seperti kawanan belalang, yang hinggap pada tembok-tembok pada waktu dingin, namun jika matahari terbit, mereka lari menghilang, tidak ketahuan tempatnya."
 },
 {
   "id": 22735,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 18,
   "firman": "Celaka! Alangkah terlelapnya para gembalamu, hai raja negeri Asyur! Para pemukamu tertidur, laskarmu berserak-serak di gunung-gunung, dan tidak ada yang mengumpulkan."
 },
 {
   "id": 22736,
   "kitab": "Nah",
   "pasal": 3,
   "ayat": 19,
   "firman": "Tiada pengobatan untuk cederamu, lukamu tidak tersembuhkan. Semua orang yang mendengar tentang engkau bertepuk tangan karena engkau; sebab kepada siapakah tidak tertimpa perbuatan jahatmu terus-menerus?"
 },
 {
   "id": 22737,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ucapan ilahi dalam penglihatan nabi Habakuk."
 },
 {
   "id": 22738,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 2,
   "firman": "Berapa lama lagi, TUHAN, aku berteriak, tetapi tidak Kaudengar, aku berseru kepada-Mu: \"Penindasan!\" tetapi tidak Kautolong?"
 },
 {
   "id": 22739,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 3,
   "firman": "Mengapa Engkau memperlihatkan kepadaku kejahatan, sehingga aku memandang kelaliman? Ya, aniaya dan kekerasan ada di depan mataku; perbantahan dan pertikaian terjadi."
 },
 {
   "id": 22740,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 4,
   "firman": "Itulah sebabnya hukum kehilangan kekuatannya dan tidak pernah muncul keadilan, sebab orang fasik mengepung orang benar; itulah sebabnya keadilan muncul terbalik."
 },
 {
   "id": 22741,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lihatlah di antara bangsa-bangsa dan perhatikanlah, jadilah heran dan tercengang-cengang, sebab Aku melakukan suatu pekerjaan dalam zamanmu yang tidak akan kamu percayai, jika diceriterakan."
 },
 {
   "id": 22742,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 6,
   "firman": "Sebab, sesungguhnya, Akulah yang membangkitkan orang Kasdim, bangsa yang garang dan tangkas itu, yang melintasi lintang bujur bumi untuk menduduki tempat kediaman, yang bukan kepunyaan mereka."
 },
 {
   "id": 22743,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 7,
   "firman": "Bangsa itu dahsyat dan menakutkan; keadilannya dan keluhurannya berasal dari padanya sendiri."
 },
 {
   "id": 22744,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 8,
   "firman": "Kudanya lebih cepat dari pada macan tutul, dan lebih ganas dari pada serigala pada waktu malam; pasukan berkudanya datang menderap, dari jauh mereka datang, terbang seperti rajawali yang menyambar mangsa."
 },
 {
   "id": 22745,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 9,
   "firman": "Seluruh bangsa itu datang untuk melakukan kekerasan, serbuan pasukan depannya seperti angin timur, dan mereka mengumpulkan tawanan seperti banyaknya pasir."
 },
 {
   "id": 22746,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 10,
   "firman": "Raja-raja dicemoohkannya dan penguasa-penguasa menjadi tertawaannya. Ditertawakannya tiap tempat berkubu, ditimbunkannya tanah dan direbutnya tempat itu."
 },
 {
   "id": 22747,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 11,
   "firman": "Maka berlarilah mereka, seperti angin dan bergerak terus; demikianlah mereka bersalah dengan mendewakan kekuatannya."
 },
 {
   "id": 22748,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 12,
   "firman": "Bukankah Engkau, ya TUHAN, dari dahulu Allahku, Yang Mahakudus? Tidak akan mati kami. Ya TUHAN, telah Kautetapkan dia untuk menghukumkan; ya Gunung Batu, telah Kautentukan dia untuk menyiksa."
 },
 {
   "id": 22749,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 13,
   "firman": "Mata-Mu terlalu suci untuk melihat kejahatan dan Engkau tidak dapat memandang kelaliman. Mengapa Engkau memandangi orang-orang yang berbuat khianat itu dan Engkau berdiam diri, apabila orang fasik menelan orang yang lebih benar dari dia?"
 },
 {
   "id": 22750,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 14,
   "firman": "Engkau menjadikan manusia itu seperti ikan di laut, seperti binatang-binatang melata yang tidak ada pemerintahnya?"
 },
 {
   "id": 22751,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 15,
   "firman": "Semuanya mereka ditariknya ke atas dengan kail, ditangkap dengan pukatnya dan dikumpulkan dengan payangnya; itulah sebabnya ia bersukaria dan bersorak-sorai."
 },
 {
   "id": 22752,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 16,
   "firman": "Itulah sebabnya dipersembahkannya korban untuk pukatnya dan dibakarnya korban untuk payangnya; sebab oleh karena alat-alat itu pendapatannya mewah dan rezekinya berlimpah-limpah."
 },
 {
   "id": 22753,
   "kitab": "Hab",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sebab itukah ia selalu menghunus pedangnya dan membunuh bangsa-bangsa dengan tidak kenal belas kasihan?"
 },
 {
   "id": 22754,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 1,
   "firman": "Aku mau berdiri di tempat pengintaianku dan berdiri tegak di menara, aku mau meninjau dan menantikan apa yang akan difirmankan-Nya kepadaku, dan apa yang akan dijawab-Nya atas pengaduanku."
 },
 {
   "id": 22755,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu TUHAN menjawab aku, demikian: \"Tuliskanlah penglihatan itu dan ukirkanlah itu pada loh-loh, supaya orang sambil lalu dapat membacanya."
 },
 {
   "id": 22756,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 3,
   "firman": "Sebab penglihatan itu masih menanti saatnya, tetapi ia bersegera menuju kesudahannya dengan tidak menipu; apabila berlambat-lambat, nantikanlah itu, sebab itu sungguh-sungguh akan datang dan tidak akan bertangguh."
 },
 {
   "id": 22757,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 4,
   "firman": "Sesungguhnya, orang yang membusungkan dada, tidak lurus hatinya, tetapi orang yang benar itu akan hidup oleh percayanya."
 },
 {
   "id": 22758,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 5,
   "firman": "Orang sombong dan khianat dia yang melagak, tetapi ia tidak akan tetap ada; ia mengangakan mulutnya seperti dunia orang mati dan tidak kenyang-kenyang seperti maut, sehingga segala suku bangsa dikumpulkannya dan segala bangsa dihimpunkannya.\""
 },
 {
   "id": 22759,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 6,
   "firman": "Bukankah sekalian itu akan melontarkan peribahasa mengatai dia, dan nyanyian olok-olok serta sindiran ini: Celakalah orang yang menggaruk bagi dirinya apa yang bukan miliknya--berapa lama lagi? --dan yang memuati dirinya dengan barang gadaian."
 },
 {
   "id": 22760,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 7,
   "firman": "Bukankah akan bangkit dengan sekonyong-konyong mereka yang menggigit engkau, dan akan terjaga mereka yang mengejutkan engkau, sehingga engkau menjadi barang rampasan bagi mereka?"
 },
 {
   "id": 22761,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 8,
   "firman": "Karena engkau telah menjarah banyak suku bangsa, maka bangsa-bangsa yang tertinggal akan menjarah engkau, karena darah manusia yang tertumpah itu dan karena kekerasan terhadap negeri, kota dan seluruh penduduknya itu."
 },
 {
   "id": 22762,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 9,
   "firman": "Celakalah orang yang mengambil laba yang tidak halal untuk keperluan rumahnya, untuk menempatkan sarangnya di tempat yang tinggi, dengan maksud melepaskan dirinya dari genggaman malapetaka!"
 },
 {
   "id": 22763,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 10,
   "firman": "Engkau telah merancangkan cela ke atas rumahmu, ketika engkau bermaksud untuk menghabisi banyak bangsa; dengan demikian engkau telah berdosa terhadap dirimu sendiri."
 },
 {
   "id": 22764,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 11,
   "firman": "Sebab batu berseru-seru dari tembok, dan balok menjawabnya dari rangka rumah."
 },
 {
   "id": 22765,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 12,
   "firman": "Celakalah orang yang mendirikan kota di atas darah dan meletakkan dasar benteng di atas ketidakadilan."
 },
 {
   "id": 22766,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sesungguhnya, bukankah dari TUHAN semesta alam asalnya, bahwa bangsa-bangsa bersusah-susah untuk api dan suku-suku bangsa berlelah untuk yang sia-sia?"
 },
 {
   "id": 22767,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 14,
   "firman": "Sebab bumi akan penuh dengan pengetahuan tentang kemuliaan TUHAN, seperti air yang menutupi dasar laut."
 },
 {
   "id": 22768,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 15,
   "firman": "Celakalah orang yang memberi minum sesamanya manusia bercampur amarah, bahkan memabukkan dia untuk memandang auratnya."
 },
 {
   "id": 22769,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 16,
   "firman": "Telah engkau kenyangkan dirimu dengan kehinaan ganti kehormatan. Minumlah juga engkau dan terhuyung-huyunglah. Kepadamu akan beralih piala dari tangan kanan TUHAN, dan cela besar akan meliputi kemuliaanmu."
 },
 {
   "id": 22770,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 17,
   "firman": "Sebab kekerasan terhadap gunung Libanon akan menutupi engkau dan pemusnahan binatang-binatang akan mengejutkan engkau, karena darah manusia yang tertumpah itu dan karena kekerasan terhadap negeri, kota dan seluruh penduduknya itu."
 },
 {
   "id": 22771,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 18,
   "firman": "Apakah gunanya patung pahatan, yang dipahat oleh pembuatnya? Apakah gunanya patung tuangan, pengajar dusta itu? Karena pembuatnya percaya akan buatannya, padahal berhala-berhala bisu belaka yang dibuatnya."
 },
 {
   "id": 22772,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 19,
   "firman": "Celakalah orang yang berkata kepada sepotong kayu: \"Terjagalah!\" dan kepada sebuah batu bisu: \"Bangunlah!\" Masakan dia itu mengajar? Memang ia bersalutkan emas dan perak, tetapi roh tidak ada sama sekali di dalamnya."
 },
 {
   "id": 22773,
   "kitab": "Hab",
   "pasal": 2,
   "ayat": 20,
   "firman": "Tetapi TUHAN ada di dalam bait-Nya yang kudus. Berdiam dirilah di hadapan-Nya, ya segenap bumi!"
 },
 {
   "id": 22774,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 1,
   "firman": "Doa nabi Habakuk. Menurut nada ratapan."
 },
 {
   "id": 22775,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 2,
   "firman": "TUHAN, telah kudengar kabar tentang Engkau, dan pekerjaan-Mu, ya TUHAN, kutakuti! Hidupkanlah itu dalam lintasan tahun, nyatakanlah itu dalam lintasan tahun; dalam murka ingatlah akan kasih sayang!"
 },
 {
   "id": 22776,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 3,
   "firman": "Allah datang dari negeri Teman dan Yang Mahakudus dari pegunungan Paran. Sela. Keagungan-Nya menutupi segenap langit, dan bumipun penuh dengan pujian kepada-Nya."
 },
 {
   "id": 22777,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 4,
   "firman": "Ada kilauan seperti cahaya, sinar cahaya dari sisi-Nya dan di situlah terselubung kekuatan-Nya."
 },
 {
   "id": 22778,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 5,
   "firman": "Mendahului-Nya berjalan penyakit sampar dan demam mengikuti jejak-Nya."
 },
 {
   "id": 22779,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 6,
   "firman": "Ia berdiri, maka bumi dibuat-Nya bergoyang; Ia melihat berkeliling, maka bangsa-bangsa dibuat-Nya melompat terkejut, hancur gunung-gunung yang ada sejak purba, merendah bukit-bukit yang berabad-abad; itulah perjalanan-Nya berabad-abad."
 },
 {
   "id": 22780,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 7,
   "firman": "Aku melihat kemah-kemah orang Kusyan tertekan, kain-kain tenda tanah Midian menggetar."
 },
 {
   "id": 22781,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 8,
   "firman": "Terhadap sungai-sungaikah, ya TUHAN, terhadap sungai-sungaikah murka-Mu bangkit? Atau terhadap lautkah amarah-Mu sehingga Engkau mengendarai kuda dan kereta kemenangan-Mu?"
 },
 {
   "id": 22782,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 9,
   "firman": "Busur-Mu telah Kaubuka, telah Kauisi dengan anak panah. Sela. Engkau membelah bumi menjadi sungai-sungai;"
 },
 {
   "id": 22783,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 10,
   "firman": "melihat Engkau, gunung-gunung gemetar, air bah menderu lalu, samudera raya memperdengarkan suaranya dan mengangkat tangannya."
 },
 {
   "id": 22784,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 11,
   "firman": "Matahari, bulan berhenti di tempat kediamannya, karena cahaya anak-anak panah-Mu yang melayang laju, karena kilauan tombak-Mu yang berkilat."
 },
 {
   "id": 22785,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 12,
   "firman": "Dalam kegeraman Engkau melangkah melintasi bumi, dalam murka Engkau menggasak bangsa-bangsa."
 },
 {
   "id": 22786,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 13,
   "firman": "Engkau berjalan maju untuk menyelamatkan umat-Mu, untuk menyelamatkan orang yang Kauurapi. Engkau meremukkan bagian atas rumah orang-orang fasik dan Kaubuka dasarnya sampai batu yang penghabisan. Sela."
 },
 {
   "id": 22787,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 14,
   "firman": "Engkau menusuk dengan anak panahnya sendiri kepala lasykarnya, yang mengamuk untuk menyerakkan aku dengan sorak-sorai, seolah-olah mereka menelan orang tertindas secara tersembunyi."
 },
 {
   "id": 22788,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 15,
   "firman": "Dengan kuda-Mu, Engkau menginjak laut, timbunan air yang membuih."
 },
 {
   "id": 22789,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 16,
   "firman": "Ketika aku mendengarnya, gemetarlah hatiku, mendengar bunyinya, menggigillah bibirku; tulang-tulangku seakan-akan kemasukan sengal, dan aku gemetar di tempat aku berdiri; namun dengan tenang akan kunantikan hari kesusahan, yang akan mendatangi bangsa yang bergerombolan menyerang kami."
 },
 {
   "id": 22790,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sekalipun pohon ara tidak berbunga, pohon anggur tidak berbuah, hasil pohon zaitun mengecewakan, sekalipun ladang-ladang tidak menghasilkan bahan makanan, kambing domba terhalau dari kurungan, dan tidak ada lembu sapi dalam kandang,"
 },
 {
   "id": 22791,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 18,
   "firman": "namun aku akan bersorak-sorak di dalam TUHAN, beria-ria di dalam Allah yang menyelamatkan aku."
 },
 {
   "id": 22792,
   "kitab": "Hab",
   "pasal": 3,
   "ayat": 19,
   "firman": "ALLAH Tuhanku itu kekuatanku: Ia membuat kakiku seperti kaki rusa, Ia membiarkan aku berjejak di bukit-bukitku. (Untuk pemimpin biduan. Dengan permainan kecapi)."
 },
 {
   "id": 22793,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 1,
   "firman": "Firman TUHAN yang datang kepada Zefanya bin Kusyi bin Gedalya bin Amarya bin Hizkia dalam zaman Yosia bin Amon, raja Yehuda."
 },
 {
   "id": 22794,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Aku akan menyapu bersih segala-galanya dari atas muka bumi, demikianlah firman TUHAN."
 },
 {
   "id": 22795,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 3,
   "firman": "Aku akan menyapu manusia dan hewan; Aku akan menyapu burung-burung di udara dan ikan-ikan di laut. Aku akan merebahkan orang-orang fasik dan akan melenyapkan manusia dari atas muka bumi, demikianlah firman TUHAN."
 },
 {
   "id": 22796,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 4,
   "firman": "Aku akan mengacungkan tangan-Ku terhadap Yehuda dan terhadap segenap penduduk Yerusalem. Aku akan melenyapkan dari tempat ini sisa-sisa Baal dan nama para imam berhala,"
 },
 {
   "id": 22797,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 5,
   "firman": "juga mereka yang sujud menyembah di atas sotoh kepada tentara langit dan mereka yang menyembah dengan bersumpah setia kepada TUHAN, namun di samping itu bersumpah demi Dewa Milkom,"
 },
 {
   "id": 22798,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 6,
   "firman": "serta mereka yang berbalik dari pada TUHAN, yang tidak mencari TUHAN dan tidak menanyakan petunjuk-Nya.\""
 },
 {
   "id": 22799,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 7,
   "firman": "Berdiam dirilah di hadapan Tuhan ALLAH! Sebab hari TUHAN sudah dekat. Sungguh TUHAN telah menyediakan perjamuan korban dan telah menguduskan para undangan-Nya."
 },
 {
   "id": 22800,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 8,
   "firman": "\"Pada hari perjamuan korban TUHAN itu Aku akan menghukum para pemuka, para anak-anak raja dan semua orang yang memakai pakaian asing."
 },
 {
   "id": 22801,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 9,
   "firman": "Aku akan menghukum pada hari itu semua orang yang melompati ambang pintu dan memenuhi istana tuan mereka dengan kekerasan dan penipuan."
 },
 {
   "id": 22802,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 10,
   "firman": "Maka pada hari itu, demikianlah firman TUHAN, akan terdengar teriakan dari Pintu Gerbang Ikan dan ratapan dari perkampungan baru dan bunyi keruntuhan hebat dari bukit-bukit."
 },
 {
   "id": 22803,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 11,
   "firman": "Merataplah, hai penduduk perkampungan Lumpang! Sebab telah habis segenap kaum pedagang, telah lenyap segenap penimbang perak."
 },
 {
   "id": 22804,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 12,
   "firman": "Pada waktu itu Aku akan menggeledah Yerusalem dengan memakai obor dan akan menghukum orang-orang yang telah mengental seperti anggur di atas endapannya dan yang berkata dalam hatinya: TUHAN tidak berbuat baik dan tidak berbuat jahat!"
 },
 {
   "id": 22805,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 13,
   "firman": "Maka harta kekayaannya akan dirampas dan rumah-rumahnya akan menjadi sunyi sepi. Apabila mereka mendirikan rumah, mereka tidak akan mendiaminya; apabila mereka membuat kebun anggur, mereka tidak akan minum anggurnya.\""
 },
 {
   "id": 22806,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 14,
   "firman": "Sudah dekat hari TUHAN yang hebat itu, sudah dekat dan datang dengan cepat sekali! Dengar, hari TUHAN pahit, pahlawanpun akan menangis."
 },
 {
   "id": 22807,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 15,
   "firman": "Hari kegemasan hari itu, hari kesusahan dan kesulitan, hari kemusnahan dan pemusnahan, hari kegelapan dan kesuraman, hari berawan dan kelam,"
 },
 {
   "id": 22808,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 16,
   "firman": "hari peniupan sangkakala dan pekik tempur terhadap kota-kota yang berkubu dan terhadap menara penjuru yang tinggi."
 },
 {
   "id": 22809,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 17,
   "firman": "Aku akan menyusahkan manusia, sehingga mereka berjalan seperti orang buta, sebab mereka telah berdosa kepada TUHAN. Darah mereka akan tercurah seperti debu dan usus mereka seperti tahi."
 },
 {
   "id": 22810,
   "kitab": "Zef",
   "pasal": 1,
   "ayat": 18,
   "firman": "Mereka tidak dapat diselamatkan oleh perak atau emas mereka pada hari kegemasan TUHAN, dan seluruh bumi akan dimakan habis oleh api cemburu-Nya; sebab kebinasaan, malah kebinasaan dahsyat diadakan-Nya terhadap segenap penduduk bumi."
 },
 {
   "id": 22811,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 1,
   "firman": "Bersemangatlah dan berkumpullah, hai bangsa yang acuh tak acuh,"
 },
 {
   "id": 22812,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 2,
   "firman": "sebelum kamu dihalau seperti sekam yang tertiup, sebelum datang ke atasmu murka TUHAN yang bernyala-nyala itu, sebelum datang ke atasmu hari kemurkaan TUHAN."
 },
 {
   "id": 22813,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 3,
   "firman": "Carilah TUHAN, hai semua orang yang rendah hati di negeri, yang melakukan hukum-Nya; carilah keadilan, carilah kerendahan hati; mungkin kamu akan terlindung pada hari kemurkaan TUHAN."
 },
 {
   "id": 22814,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 4,
   "firman": "Sebab Gaza akan ditinggalkan orang dan Askelon akan menjadi sunyi; Asdod akan dihalau penduduknya pada rembang tengah hari dan Ekron akan dibongkar-bangkirkan."
 },
 {
   "id": 22815,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 5,
   "firman": "Celakalah kamu penduduk Daerah Tepi Laut, kamu bangsa Kreti! Terhadap kamulah firman TUHAN ini: Hai Kanaan, tanah orang Filistin! Aku akan membinasakan engkau, sehingga tidak ada lagi pendudukmu."
 },
 {
   "id": 22816,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 6,
   "firman": "Daerah Tepi Laut akan menjadi tempat kediaman bagi gembala-gembala dan kandang berpagar bagi kambing domba."
 },
 {
   "id": 22817,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 7,
   "firman": "Daerah Pinggir Laut akan menjadi kepunyaan sisa-sisa kaum Yehuda. Mereka akan merumput di sana dan berbaring di rumah-rumah Askelon pada malam hari; sebab TUHAN, Allah mereka, akan memperhatikan mereka dan akan memulihkan keadaan mereka."
 },
 {
   "id": 22818,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 8,
   "firman": "\"Aku telah mendengar pencelaan dari pihak Moab dan kata-kata nista dari pihak bani Amon, bagaimana mereka mencela umat-Ku dan membesarkan dirinya terhadap daerah umat-Ku itu."
 },
 {
   "id": 22819,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sebab itu, demi Aku yang hidup--demikianlah firman TUHAN semesta alam, Allah Israel--maka Moab akan menjadi seperti Sodom dan bani Amon seperti Gomora, yakni menjadi padang jeruju dan tempat penggalian garam dan tempat sunyi sepi sampai selama-lamanya. Sisa-sisa umat-Ku akan menjarah mereka dan yang masih tinggal dari bangsa-Ku itu akan memiliki mereka sebagai warisan.\""
 },
 {
   "id": 22820,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 10,
   "firman": "Inilah yang menjadi bagian mereka sebagai ganti kecongkakan mereka, sebab mereka telah mencela dan membesarkan diri terhadap umat TUHAN semesta alam."
 },
 {
   "id": 22821,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 11,
   "firman": "TUHAN akan mendahsyatkan mereka, sebab Ia akan melenyapkan para allah di bumi, dan kepada-Nya akan sujud menyembah setiap bangsa daerah pesisir, masing-masing dari tempatnya."
 },
 {
   "id": 22822,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 12,
   "firman": "Kamupun, hai orang Etiopia, akan mati tertikam oleh pedang-Ku."
 },
 {
   "id": 22823,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 13,
   "firman": "Ia akan mengacungkan tangan-Nya terhadap Utara, akan membinasakan Asyur, dan akan membuat Niniwe menjadi tempat yang sunyi sepi, kering seperti padang gurun."
 },
 {
   "id": 22824,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 14,
   "firman": "Dan di tengah-tengahnya akan berbaring kawanan binatang, yakni segala macam binatang hutan; baik burung undan maupun burung bangau akan bermalam di hulu tiangnya; burung ponggok akan berbunyi di tingkap, burung gagak di ambang pintu: Pemapan dari kayu aras telah tersingkap!"
 },
 {
   "id": 22825,
   "kitab": "Zef",
   "pasal": 2,
   "ayat": 15,
   "firman": "Itulah kota yang beria-ria yang penduduknya begitu tenteram dan yang berkata dalam hatinya: \"Hanya ada aku dan tidak ada yang lain!\" Betapa dia sudah menjadi tempat yang tandus, tempat pembaringan bagi binatang-binatang liar. Setiap orang yang lewat dari padanya akan bersuit dan mengayun-ayunkan tangannya."
 },
 {
   "id": 22826,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 1,
   "firman": "Celakalah si pemberontak dan si cemar, hai kota yang penuh penindasan!"
 },
 {
   "id": 22827,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ia tidak mau mendengarkan teguran siapapun dan tidak mempedulikan kecaman; kepada TUHAN ia tidak percaya dan kepada Allahnya ia tidak menghadap."
 },
 {
   "id": 22828,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 3,
   "firman": "Para pemukanya di tengah-tengahnya adalah singa yang mengaum; para hakimnya adalah serigala pada waktu malam yang tidak meninggalkan apapun sampai pagi hari."
 },
 {
   "id": 22829,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 4,
   "firman": "Para nabinya adalah orang-orang ceroboh dan pengkhianat; para imamnya menajiskan apa yang kudus, memperkosa hukum Taurat."
 },
 {
   "id": 22830,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 5,
   "firman": "Tetapi TUHAN adil di tengah-tengahnya, tidak berbuat kelaliman. Pagi demi pagi Ia memberi hukum-Nya; itu tidak pernah ketinggalan pada waktu fajar. Tetapi orang lalim tidak kenal malu!"
 },
 {
   "id": 22831,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 6,
   "firman": "\"Aku telah melenyapkan bangsa-bangsa; menara-menara penjuru mereka telah musnah. Aku telah merusakkan jalan-jalannya, sehingga tidak ada orang yang lewat. Kota-kota mereka telah ditanduskan, sehingga tidak ada orang dan tidak ada penduduk."
 },
 {
   "id": 22832,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 7,
   "firman": "Aku sangka: Tentulah ia sekarang akan takut kepada-Ku, akan mempedulikan kecaman dan segala yang Kutugaskan kepadanya tidak akan lenyap dari penglihatannya. Tetapi sesungguhnya mereka makin giat menjadikan busuk perbuatan mereka."
 },
 {
   "id": 22833,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 8,
   "firman": "Oleh karena itu tunggulah Aku--demikianlah firman TUHAN--pada hari Aku bangkit sebagai saksi. Sebab keputusan-Ku ialah mengumpulkan bangsa-bangsa dan menghimpunkan kerajaan-kerajaan untuk menumpahkan ke atas mereka geram-Ku, yakni segenap murka-Ku yang bernyala-nyala, sebab seluruh bumi akan dimakan habis oleh api cemburu-Ku.\""
 },
 {
   "id": 22834,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 9,
   "firman": "\"Tetapi sesudah itu Aku akan memberikan bibir lain kepada bangsa-bangsa, yakni bibir yang bersih, supaya sekaliannya mereka memanggil nama TUHAN, beribadah kepada-Nya dengan bahu-membahu."
 },
 {
   "id": 22835,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 10,
   "firman": "Dari seberang sungai-sungai negeri Etiopia orang-orang yang memuja Aku, yang terserak-serak, akan membawa persembahan kepada-Ku."
 },
 {
   "id": 22836,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 11,
   "firman": "Pada hari itu engkau tidak akan mendapat malu karena segala perbuatan durhaka yang kaulakukan terhadap Aku, sebab pada waktu itu Aku akan menyingkirkan dari padamu orang-orangmu yang ria congkak, dan engkau tidak akan lagi meninggikan dirimu di gunung-Ku yang kudus."
 },
 {
   "id": 22837,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 12,
   "firman": "Di antaramu akan Kubiarkan hidup suatu umat yang rendah hati dan lemah, dan mereka akan mencari perlindungan pada nama TUHAN,"
 },
 {
   "id": 22838,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 13,
   "firman": "yakni sisa Israel itu. Mereka tidak akan melakukan kelaliman atau berbicara bohong; dalam mulut mereka tidak akan terdapat lidah penipu; ya, mereka akan seperti domba yang makan rumput dan berbaring dengan tidak ada yang mengganggunya.\""
 },
 {
   "id": 22839,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 14,
   "firman": "Bersorak-sorailah, hai puteri Sion, bertempik-soraklah, hai Israel! Bersukacitalah dan beria-rialah dengan segenap hati, hai puteri Yerusalem!"
 },
 {
   "id": 22840,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 15,
   "firman": "TUHAN telah menyingkirkan hukuman yang jatuh atasmu, telah menebas binasa musuhmu. Raja Israel, yakni TUHAN, ada di antaramu; engkau tidak akan takut kepada malapetaka lagi."
 },
 {
   "id": 22841,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 16,
   "firman": "Pada hari itu akan dikatakan kepada Yerusalem: \"Janganlah takut, hai Sion! Janganlah tanganmu menjadi lemah lesu."
 },
 {
   "id": 22842,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 17,
   "firman": "TUHAN Allahmu ada di antaramu sebagai pahlawan yang memberi kemenangan. Ia bergirang karena engkau dengan sukacita, Ia membaharui engkau dalam kasih-Nya, Ia bersorak-sorak karena engkau dengan sorak-sorai,"
 },
 {
   "id": 22843,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 18,
   "firman": "seperti pada hari pertemuan raya.\" \"Aku akan mengangkat malapetaka dari padamu, sehingga oleh karenanya engkau tidak lagi menanggung cela."
 },
 {
   "id": 22844,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 19,
   "firman": "Sesungguhnya pada waktu itu Aku akan bertindak terhadap segala penindasmu, tetapi Aku akan menyelamatkan yang pincang, mengumpulkan yang terpencar dan akan membuat mereka yang mendapat malu menjadi kepujian dan kenamaan di seluruh bumi."
 },
 {
   "id": 22845,
   "kitab": "Zef",
   "pasal": 3,
   "ayat": 20,
   "firman": "Pada waktu itu Aku akan membawa kamu pulang, yakni pada waktu Aku mengumpulkan kamu, sebab Aku mau membuat kamu menjadi kenamaan dan kepujian di antara segala bangsa di bumi dengan memulihkan keadaanmu di depan mata mereka,\" firman TUHAN."
 },
 {
   "id": 22846,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada tahun yang kedua zaman raja Darius, dalam bulan yang keenam, pada hari pertama bulan itu, datanglah firman TUHAN dengan perantaraan nabi Hagai kepada Zerubabel bin Sealtiel, bupati Yehuda, dan kepada Yosua bin Yozadak, imam besar, bunyinya:"
 },
 {
   "id": 22847,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN semesta alam: Bangsa ini berkata: Sekarang belum tiba waktunya untuk membangun kembali rumah TUHAN!\""
 },
 {
   "id": 22848,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 3,
   "firman": "Maka datanglah firman TUHAN dengan perantaraan nabi Hagai, bunyinya:"
 },
 {
   "id": 22849,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 4,
   "firman": "\"Apakah sudah tiba waktunya bagi kamu untuk mendiami rumah-rumahmu yang dipapani dengan baik, sedang Rumah ini tetap menjadi reruntuhan?"
 },
 {
   "id": 22850,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 5,
   "firman": "Oleh sebab itu, beginilah firman TUHAN semesta alam: Perhatikanlah keadaanmu!"
 },
 {
   "id": 22851,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kamu menabur banyak, tetapi membawa pulang hasil sedikit; kamu makan, tetapi tidak sampai kenyang; kamu minum, tetapi tidak sampai puas; kamu berpakaian, tetapi badanmu tidak sampai panas; dan orang yang bekerja untuk upah, ia bekerja untuk upah yang ditaruh dalam pundi-pundi yang berlobang!"
 },
 {
   "id": 22852,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 7,
   "firman": "Beginilah firman TUHAN semesta alam: Perhatikanlah keadaanmu!"
 },
 {
   "id": 22853,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 8,
   "firman": "Jadi naiklah ke gunung, bawalah kayu dan bangunlah Rumah itu; maka Aku akan berkenan kepadanya dan akan menyatakan kemuliaan-Ku di situ, firman TUHAN."
 },
 {
   "id": 22854,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 9,
   "firman": "Kamu mengharapkan banyak, tetapi hasilnya sedikit, dan ketika kamu membawanya ke rumah, Aku menghembuskannya. Oleh karena apa? demikianlah firman TUHAN semesta alam. Oleh karena rumah-Ku yang tetap menjadi reruntuhan, sedang kamu masing-masing sibuk dengan urusan rumahnya sendiri."
 },
 {
   "id": 22855,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 10,
   "firman": "Itulah sebabnya langit menahan embunnya dan bumi menahan hasilnya,"
 },
 {
   "id": 22856,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 11,
   "firman": "dan Aku memanggil kekeringan datang ke atas negeri, ke atas gunung-gunung, ke atas gandum, ke atas anggur, ke atas minyak, ke atas segala yang dihasilkan tanah, ke atas manusia dan hewan dan ke atas segala hasil usaha.\""
 },
 {
   "id": 22857,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 12,
   "firman": "Lalu Zerubabel bin Sealtiel dan Yosua bin Yozadak, imam besar, dan selebihnya dari bangsa itu mendengarkan suara TUHAN, Allah mereka, dan juga perkataan nabi Hagai, sesuai dengan apa yang disuruhkan kepadanya oleh TUHAN, Allah mereka; lalu takutlah bangsa itu kepada TUHAN."
 },
 {
   "id": 22858,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 13,
   "firman": "Maka berkatalah Hagai, utusan TUHAN itu, menurut pesan TUHAN kepada bangsa itu, demikian: \"Aku ini menyertai kamu, demikianlah firman TUHAN.\""
 },
 {
   "id": 22859,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 14,
   "firman": "TUHAN menggerakkan semangat Zerubabel bin Sealtiel, bupati Yehuda, dan semangat Yosua bin Yozadak, imam besar, dan semangat selebihnya dari bangsa itu, maka datanglah mereka, lalu melakukan pekerjaan pembangunan rumah TUHAN semesta alam, Allah mereka,"
 },
 {
   "id": 22860,
   "kitab": "Hag",
   "pasal": 1,
   "ayat": 15,
   "firman": "(2-1a) pada hari yang kedua puluh empat dalam bulan yang keenam. "
 },
 {
   "id": 22862,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 1,
   "firman": "(2-2) dalam bulan yang ketujuh, pada tanggal dua puluh satu bulan itu, datanglah firman TUHAN dengan perantaraan nabi Hagai, bunyinya:"
 },
 {
   "id": 22863,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 2,
   "firman": "(2-3) \"Katakanlah kepada Zerubabel bin Sealtiel, bupati Yehuda, dan kepada Yosua bin Yozadak, imam besar, dan kepada selebihnya dari bangsa itu, demikian:"
 },
 {
   "id": 22864,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 3,
   "firman": "(2-4) Masih adakah di antara kamu yang telah melihat Rumah ini dalam kemegahannya semula? Dan bagaimanakah kamu lihat keadaannya sekarang? Bukankah keadaannya di matamu seperti tidak ada artinya?"
 },
 {
   "id": 22865,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 4,
   "firman": "(2-5) Tetapi sekarang, kuatkanlah hatimu, hai Zerubabel, demikianlah firman TUHAN; kuatkanlah hatimu, hai Yosua bin Yozadak, imam besar; kuatkanlah hatimu, hai segala rakyat negeri, demikianlah firman TUHAN; bekerjalah, sebab Aku ini menyertai kamu, demikianlah firman TUHAN semesta alam,"
 },
 {
   "id": 22866,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 5,
   "firman": "(2-6) sesuai dengan janji yang telah Kuikat dengan kamu pada waktu kamu keluar dari Mesir. Dan Roh-Ku tetap tinggal di tengah-tengahmu. Janganlah takut!"
 },
 {
   "id": 22867,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 6,
   "firman": "(2-7) Sebab beginilah firman TUHAN semesta alam: Sedikit waktu lagi maka Aku akan menggoncangkan langit dan bumi, laut dan darat;"
 },
 {
   "id": 22868,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 7,
   "firman": "(2-8) Aku akan menggoncangkan segala bangsa, sehingga barang yang indah-indah kepunyaan segala bangsa datang mengalir, maka Aku akan memenuhi Rumah ini dengan kemegahan, firman TUHAN semesta alam."
 },
 {
   "id": 22869,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 8,
   "firman": "(2-9) Kepunyaan-Kulah perak dan kepunyaan-Kulah emas, demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 22870,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 9,
   "firman": "(2-10) Adapun Rumah ini, kemegahannya yang kemudian akan melebihi kemegahannya yang semula, firman TUHAN semesta alam, dan di tempat ini Aku akan memberi damai sejahtera, demikianlah firman TUHAN semesta alam.\""
 },
 {
   "id": 22871,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 10,
   "firman": "(2-11) Pada tanggal dua puluh empat bulan yang kesembilan, pada tahun yang kedua zaman Darius, datanglah firman TUHAN kepada nabi Hagai, bunyinya:"
 },
 {
   "id": 22872,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 11,
   "firman": "(2-12) \"Beginilah firman TUHAN semesta alam itu: Tanyakanlah pengajaran kepada para imam."
 },
 {
   "id": 22873,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 12,
   "firman": "(2-13) Andaikata seseorang membawa daging kudus dalam punca bajunya, lalu dengan puncanya itu ia menyentuh roti atau sesuatu masakan atau anggur atau minyak atau sesuatu yang dapat dimakan, menjadi kuduskah yang disentuh itu?\" Lalu para imam itu menjawab, katanya: \"Tidak!\""
 },
 {
   "id": 22874,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 13,
   "firman": "(2-14) Berkatalah pula Hagai: \"Jika seseorang yang najis oleh mayat menyentuh semuanya ini, menjadi najiskah yang disentuh itu?\" Lalu para imam itu menjawab, katanya: \"Tentu!\""
 },
 {
   "id": 22875,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 14,
   "firman": "(2-15) Maka berbicaralah Hagai, katanya: \"Begitu juga dengan umat ini dan dengan bangsa ini di hadapan-Ku, demikianlah firman TUHAN, dan dengan segala yang dibuat tangan mereka; dan yang dipersembahkan mereka di sana adalah najis.\""
 },
 {
   "id": 22876,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 15,
   "firman": "(2-16) \"Maka sekarang, perhatikanlah mulai dari hari ini dan selanjutnya! Sebelum ditaruh orang batu demi batu untuk pembangunan bait TUHAN,"
 },
 {
   "id": 22877,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 16,
   "firman": "(2-17) bagaimana keadaanmu? Ketika orang pergi melihat suatu timbunan gandum yang seharusnya sebanyak dua puluh gantang, hanya ada sepuluh; dan ketika orang pergi ke tempat pemerasan anggur untuk mencedok lima puluh takar, hanya ada dua puluh."
 },
 {
   "id": 22878,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 17,
   "firman": "(2-18) Aku telah memukul kamu dengan hama dan penyakit gandum dan segala yang dibuat tanganmu dengan hujan batu; namun kamu tidak berbalik kepada-Ku, demikianlah firman TUHAN."
 },
 {
   "id": 22879,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 18,
   "firman": "(2-19) Perhatikanlah mulai dari hari ini dan selanjutnya--mulai dari hari yang kedua puluh empat bulan kesembilan. Mulai dari hari diletakkannya dasar bait TUHAN perhatikanlah"
 },
 {
   "id": 22880,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 19,
   "firman": "(2-20) apakah benih masih tinggal tersimpan dalam lumbung, dan apakah pohon anggur dan pohon ara, pohon delima dan pohon zaitun belum berbuah? Mulai dari hari ini Aku akan memberi berkat!\""
 },
 {
   "id": 22881,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 20,
   "firman": "(2-21) Maka datanglah firman TUHAN untuk kedua kalinya kepada Hagai pada tanggal dua puluh empat bulan itu, bunyinya:"
 },
 {
   "id": 22882,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 21,
   "firman": "(2-22) \"Katakanlah kepada Zerubabel, bupati Yehuda, begini: Aku akan menggoncangkan langit dan bumi"
 },
 {
   "id": 22883,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 22,
   "firman": "(2-23) dan akan menunggangbalikkan takhta raja-raja; Aku akan memunahkan kekuasaan kerajaan bangsa-bangsa dan akan menjungkirbalikkan kereta dan pengendaranya; kuda dan pengendaranya akan mati rebah, masing-masing oleh pedang temannya."
 },
 {
   "id": 22884,
   "kitab": "Hag",
   "pasal": 2,
   "ayat": 23,
   "firman": "(2-24) Pada waktu itu, demikianlah firman TUHAN semesta alam, Aku akan mengambil engkau, hai Zerubabel bin Sealtiel, hamba-Ku--demikianlah firman TUHAN--dan akan menjadikan engkau seperti cincin meterai; sebab engkaulah yang Kupilih, demikianlah firman TUHAN semesta alam.\""
 },
 {
   "id": 22885,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dalam bulan yang kedelapan pada tahun kedua zaman Darius datanglah firman TUHAN kepada nabi Zakharia bin Berekhya bin Ido, bunyinya:"
 },
 {
   "id": 22886,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Sangat murka TUHAN atas nenek moyangmu."
 },
 {
   "id": 22887,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 3,
   "firman": "Sebab itu katakanlah kepada mereka: Beginilah firman TUHAN semesta alam: Kembalilah kepada-Ku, demikianlah firman TUHAN semesta alam, maka Akupun akan kembali kepadamu, firman TUHAN semesta alam."
 },
 {
   "id": 22888,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 4,
   "firman": "Janganlah kamu seperti nenek moyangmu yang kepadanya para nabi yang dahulu telah menyerukan, demikian: Beginilah firman TUHAN semesta alam: Berbaliklah dari tingkah lakumu yang buruk dan dari perbuatanmu yang jahat! Tetapi mereka tidak mau mendengarkan dan tidak mau menghiraukan Aku, demikianlah firman TUHAN."
 },
 {
   "id": 22889,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 5,
   "firman": "Nenek moyangmu, di mana mereka? Dan para nabi, apakah mereka hidup untuk selama-lamanya?"
 },
 {
   "id": 22890,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 6,
   "firman": "Tetapi segala firman dan ketetapan-Ku yang telah Kuperintahkan kepada hamba-hamba-Ku, para nabi, bukankah itu telah sampai kepada nenek moyangmu? Maka bertobatlah mereka serta berkata: Sebagaimana TUHAN semesta alam bermaksud mengambil tindakan terhadap kita sesuai dengan tingkah laku kita dan perbuatan kita, demikianlah Ia mengambil tindakan terhadap kita!\""
 },
 {
   "id": 22891,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 7,
   "firman": "Pada hari yang kedua puluh empat dari bulan yang kesebelas--itulah bulan Syebat--pada tahun yang kedua zaman Darius datanglah firman TUHAN kepada nabi Zakharia bin Berekhya bin Ido, bunyinya:"
 },
 {
   "id": 22892,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 8,
   "firman": "\"Tadi malam aku mendapat suatu penglihatan: tampak seorang yang menunggang kuda merah! Dia sedang berdiri di antara pohon-pohon murad yang di dalam jurang; dan di belakangnya ada kuda-kuda yang merah, yang merah jambu dan yang putih."
 },
 {
   "id": 22893,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 9,
   "firman": "Maka aku bertanya: Apakah arti semuanya ini, ya tuanku? Lalu malaikat yang berbicara dengan aku itu menjawab: Aku ini akan memperlihatkan kepadamu apa arti semuanya ini!"
 },
 {
   "id": 22894,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 10,
   "firman": "Orang yang berdiri di antara pohon-pohon murad itu mulai berbicara, katanya: Inilah mereka semua yang diutus TUHAN untuk menjelajahi bumi!"
 },
 {
   "id": 22895,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 11,
   "firman": "Berbicaralah mereka kepada Malaikat TUHAN yang berdiri di antara pohon-pohon murad itu, katanya: Kami telah menjelajahi bumi, dan sesungguhnya seluruh bumi itu tenang dan aman."
 },
 {
   "id": 22896,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 12,
   "firman": "Berbicaralah Malaikat TUHAN itu, katanya: Ya TUHAN semesta alam, berapa lama lagi Engkau tidak menyayangi Yerusalem dan kota-kota Yehuda yang telah tujuh puluh tahun lamanya Kaumurkai itu?"
 },
 {
   "id": 22897,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 13,
   "firman": "Lalu kepada malaikat, yang berbicara dengan aku itu, TUHAN menjawab dengan kata-kata yang ramah dan yang menghiburkan."
 },
 {
   "id": 22898,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 14,
   "firman": "Berkatalah kepadaku malaikat yang berbicara dengan aku itu: Serukanlah ini: Beginilah firman TUHAN semesta alam: Sangat besar usaha-Ku untuk Yerusalem dan Sion,"
 },
 {
   "id": 22899,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 15,
   "firman": "tetapi sangat besar murka-Ku terhadap bangsa-bangsa yang merasa dirinya aman, yang, sementara Aku murka sedikit, telah membantu menimbulkan kejahatan."
 },
 {
   "id": 22900,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 16,
   "firman": "Sebab itu, beginilah firman TUHAN, Aku kembali lagi kepada Yerusalem dengan kasih sayang. Rumah-Ku akan didirikan pula di sana, demikianlah firman TUHAN semesta alam, dan tali pengukur akan direntangkan lagi di atas Yerusalem."
 },
 {
   "id": 22901,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 17,
   "firman": "Serukanlah ini selanjutnya: Beginilah firman TUHAN semesta alam: Kota-kota-Ku akan berlimpah-limpah pula dengan kebajikan, dan TUHAN akan menghiburkan Sion dan akan memilih Yerusalem pula.\""
 },
 {
   "id": 22902,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 18,
   "firman": "Aku melayangkan mataku dan melihat: tampak empat tanduk."
 },
 {
   "id": 22903,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 19,
   "firman": "Lalu aku bertanya kepada malaikat yang berbicara dengan aku itu: \"Apakah arti semuanya ini?\" Maka ia menjawab aku: \"Inilah tanduk-tanduk yang telah menyerakkan Yehuda, Israel dan Yerusalem.\""
 },
 {
   "id": 22904,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 20,
   "firman": "Kemudian TUHAN memperlihatkan kepadaku empat tukang besi."
 },
 {
   "id": 22905,
   "kitab": "Zak",
   "pasal": 1,
   "ayat": 21,
   "firman": "Lalu aku bertanya: \"Orang-orang ini datang untuk melakukan apa?\" Maka ia menjawab: \"Inipun adalah tanduk-tanduk yang telah menyerakkan Yehuda, sehingga tidak seorangpun berani mengangkat kepalanya. Dan semuanya ini datang untuk mengejutkan mereka, yakni untuk menghempaskan tanduk bangsa-bangsa yang telah mengangkat tanduk terhadap tanah Yehuda hendak menyerakkannya.\""
 },
 {
   "id": 22906,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 1,
   "firman": "Aku melayangkan mataku dan melihat: tampak seorang yang memegang tali pengukur."
 },
 {
   "id": 22907,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu aku bertanya: \"Ke manakah engkau ini pergi?\" Maka ia menjawab aku: \"Ke Yerusalem, untuk mengukurnya, untuk melihat berapa lebarnya dan panjangnya.\""
 },
 {
   "id": 22908,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan sementara malaikat yang berbicara dengan aku itu maju ke depan, majulah seorang malaikat lain mendekatinya,"
 },
 {
   "id": 22909,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 4,
   "firman": "yang diberi perintah: \"Berlarilah, katakanlah kepada orang muda yang di sana itu, demikian: Yerusalem akan tetap tinggal seperti padang terbuka oleh karena banyaknya manusia dan hewan di dalamnya."
 },
 {
   "id": 22910,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dan Aku sendiri, demikianlah firman TUHAN, akan menjadi tembok berapi baginya di sekelilingnya, dan Aku akan menjadi kemuliaan di dalamnya.\""
 },
 {
   "id": 22911,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ayo, ayo, larilah dari Tanah Utara, demikianlah firman TUHAN; sebab ke arah keempat mata angin Aku telah menyerakkan kamu, demikianlah firman TUHAN."
 },
 {
   "id": 22912,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 7,
   "firman": "Ayo, luputkanlah dirimu ke Sion, hai, penduduk Babel!"
 },
 {
   "id": 22913,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 8,
   "firman": "Sebab beginilah firman TUHAN semesta alam, yang dalam kemuliaan-Nya telah mengutus aku, mengenai bangsa-bangsa yang telah menjarah kamu--sebab siapa yang menjamah kamu, berarti menjamah biji mata-Nya--:"
 },
 {
   "id": 22914,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 9,
   "firman": "\"Sesungguhnya Aku akan menggerakkan tangan-Ku terhadap mereka, dan mereka akan menjadi jarahan bagi orang-orang yang tadinya takluk kepada mereka. Maka kamu akan mengetahui bahwa TUHAN semesta alam yang mengutus aku."
 },
 {
   "id": 22915,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 10,
   "firman": "Bersorak-sorailah dan bersukarialah, hai puteri Sion, sebab sesungguhnya Aku datang dan diam di tengah-tengahmu, demikianlah firman TUHAN;"
 },
 {
   "id": 22916,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 11,
   "firman": "dan banyak bangsa akan menggabungkan diri kepada TUHAN pada waktu itu dan akan menjadi umat-Ku dan Aku akan diam di tengah-tengahmu.\" Maka engkau akan mengetahui, bahwa TUHAN semesta alam yang mengutus aku kepadamu."
 },
 {
   "id": 22917,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan TUHAN akan mengambil Yehuda sebagai milik-Nya di tanah yang kudus, dan Ia akan memilih Yerusalem pula."
 },
 {
   "id": 22918,
   "kitab": "Zak",
   "pasal": 2,
   "ayat": 13,
   "firman": "Berdiam dirilah, hai segala makhluk, di hadapan TUHAN, sebab Ia telah bangkit dari tempat kediaman-Nya yang kudus."
 },
 {
   "id": 22919,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 1,
   "firman": "Kemudian ia memperlihatkan kepadaku imam besar Yosua berdiri di hadapan Malaikat TUHAN sedang Iblis berdiri di sebelah kanannya untuk mendakwa dia."
 },
 {
   "id": 22920,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu berkatalah Malaikat TUHAN kepada Iblis itu: \"TUHAN kiranya menghardik engkau, hai Iblis! TUHAN, yang memilih Yerusalem, kiranya menghardik engkau! Bukankah dia ini puntung yang telah ditarik dari api?\""
 },
 {
   "id": 22921,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 3,
   "firman": "Adapun Yosua mengenakan pakaian yang kotor, waktu dia berdiri di hadapan Malaikat itu,"
 },
 {
   "id": 22922,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 4,
   "firman": "yang memberikan perintah kepada orang-orang yang melayaninya: \"Tanggalkanlah pakaian yang kotor itu dari padanya.\" Dan kepada Yosua ia berkata: \"Lihat, dengan ini aku telah menjauhkan kesalahanmu dari padamu! Aku akan mengenakan kepadamu pakaian pesta.\""
 },
 {
   "id": 22923,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 5,
   "firman": "Kemudian ia berkata: \"Taruhlah serban tahir pada kepalanya!\" Maka mereka menaruh serban tahir pada kepalanya dan mengenakan pakaian kepadanya, sedang Malaikat TUHAN berdiri di situ."
 },
 {
   "id": 22924,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lalu Malaikat TUHAN itu memberi jaminan kepada Yosua, katanya:"
 },
 {
   "id": 22925,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 7,
   "firman": "\"Beginilah firman TUHAN semesta alam: Apabila engkau hidup menurut jalan yang Kutunjukkan dan melakukan tugas yang Kuberikan kepadamu, maka engkau akan memerintah rumah-Ku dan mengurus pelataran-Ku, dan Aku akan mengizinkan engkau masuk ke antara mereka yang berdiri melayani di sini."
 },
 {
   "id": 22926,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 8,
   "firman": "Dengarkanlah, hai imam besar Yosua! Engkau dan teman-temanmu yang duduk di hadapanmu--sungguh kamu merupakan suatu lambang. Sebab, sesungguhnya Aku akan mendatangkan hamba-Ku, yakni Sang Tunas."
 },
 {
   "id": 22927,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 9,
   "firman": "Sebab sesungguhnya permata yang telah Kuserahkan kepada Yosua--satu permata yang bermata tujuh--sesungguhnya Aku akan mengukirkan ukiran di atasnya, demikianlah firman TUHAN semesta alam, dan Aku akan menghapuskan kesalahan negeri ini dalam satu hari saja."
 },
 {
   "id": 22928,
   "kitab": "Zak",
   "pasal": 3,
   "ayat": 10,
   "firman": "Pada hari itu, demikianlah firman TUHAN semesta alam, setiap orang dari padamu akan mengundang temannya duduk di bawah pohon anggur dan di bawah pohon ara.\""
 },
 {
   "id": 22929,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 1,
   "firman": "Datanglah kembali malaikat yang berbicara dengan aku itu, lalu dibangunkannyalah aku seperti seorang yang dibangunkan dari tidurnya."
 },
 {
   "id": 22930,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 2,
   "firman": "Maka berkatalah ia kepadaku: \"Apa yang engkau lihat?\" Jawabku: \"Aku melihat: tampak sebuah kandil, dari emas seluruhnya, dan tempat minyaknya di bagian atasnya; kandil itu ada tujuh pelitanya dan ada tujuh corot pada masing-masing pelita yang ada di bagian atasnya itu."
 },
 {
   "id": 22931,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 3,
   "firman": "Dan pohon zaitun ada terukir padanya, satu di sebelah kanan tempat minyak itu dan satu di sebelah kirinya.\""
 },
 {
   "id": 22932,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 4,
   "firman": "Lalu berbicaralah aku, kataku kepada malaikat yang berbicara dengan aku itu: \"Apakah arti semuanya ini, tuanku?\""
 },
 {
   "id": 22933,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 5,
   "firman": "Maka berbicaralah malaikat yang berbicara dengan aku itu, katanya kepadaku: \"Tidakkah engkau tahu, apa arti semuanya ini?\" Jawabku: \"Tidak, tuanku!\""
 },
 {
   "id": 22934,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 6,
   "firman": "Maka berbicaralah ia, katanya: \"Inilah firman TUHAN kepada Zerubabel bunyinya: Bukan dengan keperkasaan dan bukan dengan kekuatan, melainkan dengan roh-Ku, firman TUHAN semesta alam."
 },
 {
   "id": 22935,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 7,
   "firman": "Siapakah engkau, gunung yang besar? Di depan Zerubabel engkau menjadi tanah rata. Ia akan mengangkat batu utama, sedang orang bersorak: Bagus! Bagus sekali batu itu!\""
 },
 {
   "id": 22936,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 8,
   "firman": "Kemudian datanglah firman TUHAN kepadaku, demikian:"
 },
 {
   "id": 22937,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 9,
   "firman": "\"Tangan Zerubabel telah meletakkan dasar Rumah ini, dan tangannya juga akan menyelesaikannya. Maka kamu akan mengetahui, bahwa TUHAN semesta alam yang mengutus aku kepadamu."
 },
 {
   "id": 22938,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 10,
   "firman": "Sebab siapa yang memandang hina hari peristiwa-peristiwa yang kecil, mereka akan bersukaria melihat batu pilihan di tangan Zerubabel. Yang tujuh ini adalah mata TUHAN, yang menjelajah seluruh bumi.\""
 },
 {
   "id": 22939,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 11,
   "firman": "Lalu berbicaralah aku kepadanya: \"Apakah arti kedua pohon zaitun yang di sebelah kanan dan di sebelah kiri kandil ini?\""
 },
 {
   "id": 22940,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 12,
   "firman": "Untuk kedua kalinya berbicaralah aku kepadanya: \"Apakah arti kedua dahan pohon zaitun yang di samping kedua pipa emas yang menyalurkan cairan emas dari atasnya itu?\""
 },
 {
   "id": 22941,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 13,
   "firman": "Ia menjawab aku: \"Tidakkah engkau tahu, apa arti semuanya ini?\" Jawabku: \"Tidak, tuanku!\""
 },
 {
   "id": 22942,
   "kitab": "Zak",
   "pasal": 4,
   "ayat": 14,
   "firman": "Lalu ia berkata: \"Inilah kedua orang yang diurapi yang berdiri di dekat Tuhan seluruh bumi!\""
 },
 {
   "id": 22943,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 1,
   "firman": "Aku melayangkan mataku pula, maka aku melihat: tampak sebuah gulungan kitab yang terbang."
 },
 {
   "id": 22944,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 2,
   "firman": "Berkatalah ia kepadaku: \"Apa yang engkau lihat?\" Jawabku: \"Aku melihat sebuah gulungan kitab yang terbang; panjangnya dua puluh hasta dan lebarnya sepuluh hasta.\""
 },
 {
   "id": 22945,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 3,
   "firman": "Lalu ia berkata kepadaku: \"Inilah sumpah serapah yang keluar menimpa seluruh negeri; sebab menurut sumpah serapah itu setiap pencuri di sini masih bebas dari hukuman, dan setiap orang yang bersumpah palsu di sini juga masih bebas dari hukuman."
 },
 {
   "id": 22946,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 4,
   "firman": "Aku telah menyuruhnya keluar, demikianlah firman TUHAN semesta alam, supaya itu masuk ke dalam rumah pencuri dan ke dalam rumah orang yang bersumpah palsu demi nama-Ku, dan supaya itu bermalam di dalam rumah mereka dan memusnahkannya, baik kayunya maupun batu-batunya.\""
 },
 {
   "id": 22947,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 5,
   "firman": "Tampillah malaikat yang berbicara dengan aku itu, katanya kepadaku: \"Cobalah layangkan matamu dan lihatlah apa yang muncul itu!\""
 },
 {
   "id": 22948,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 6,
   "firman": "Lalu tanyaku: \"Apa itu?\" Jawabnya: \"Yang muncul itu sebuah gantang!\" Lagi katanya: \"Inilah kejahatan mereka di seluruh negeri!\""
 },
 {
   "id": 22949,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 7,
   "firman": "Lihat, tutup timah gantang itu telah terangkat, dan seorang perempuan duduk di dalamnya!"
 },
 {
   "id": 22950,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kemudian berkatalah ia: \"Itulah kefasikan!\" Lalu didorongnyalah perempuan itu kembali ke dalam gantang dan dibantingnyalah batu timah itu ke mulut gantang."
 },
 {
   "id": 22951,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 9,
   "firman": "Lalu aku melayangkan mataku dan aku melihat: tampak tampil dua orang perempuan yang sayapnya didorong oleh angin. Adapun sayap mereka adalah sayap seperti burung ranggung. Mereka mengangkut gantang itu di antara bumi dan langit."
 },
 {
   "id": 22952,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 10,
   "firman": "Bertanyalah aku kepada malaikat yang berbicara dengan aku itu: \"Ke mana mereka membawa gantang itu?\""
 },
 {
   "id": 22953,
   "kitab": "Zak",
   "pasal": 5,
   "ayat": 11,
   "firman": "Jawabnya kepadaku: \"Ke tanah Sinear, untuk mendirikan sebuah rumah bagi perempuan itu. Dan apabila itu selesai, maka mereka akan menempatkan dia di sana di tempat rumah itu didirikan.\""
 },
 {
   "id": 22954,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 1,
   "firman": "Aku melayangkan mataku pula, maka aku melihat: tampak keluar empat kereta dari antara dua gunung. Adapun gunung-gunung itu adalah gunung-gunung tembaga."
 },
 {
   "id": 22955,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 2,
   "firman": "Kereta pertama ditarik oleh kuda merah, kereta kedua oleh kuda hitam."
 },
 {
   "id": 22956,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 3,
   "firman": "Kereta ketiga oleh kuda putih, dan kereta keempat oleh kuda yang berbelang-belang dan berloreng-loreng."
 },
 {
   "id": 22957,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 4,
   "firman": "Berbicaralah aku kepada malaikat yang berbicara dengan aku itu: \"Apakah arti semuanya ini, tuanku?\""
 },
 {
   "id": 22958,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 5,
   "firman": "Berbicaralah malaikat itu kepadaku: \"Semuanya ini keluar ke arah keempat mata angin, sesudah mereka menghadap kepada Tuhan seluruh bumi.\""
 },
 {
   "id": 22959,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 6,
   "firman": "Yang ditarik oleh kuda hitam itu keluar ke Tanah Utara; yang putih itu keluar ke arah barat; yang berbelang-belang itu keluar ke Tanah Selatan;"
 },
 {
   "id": 22960,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 7,
   "firman": "dan yang merah itu keluar, gelisah untuk pergi, hendak menjelajahi bumi. Lalu berkatalah ia: \"Pergilah, jelajahilah bumi!\" Maka mereka menjelajahi bumi."
 },
 {
   "id": 22961,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 8,
   "firman": "Kemudian berteriaklah ia kepadaku: \"Lihat, mereka yang keluar ke Tanah Utara itu akan menenteramkan roh-Ku di Tanah Utara.\""
 },
 {
   "id": 22962,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 9,
   "firman": "Datanglah firman TUHAN kepadaku, bunyinya:"
 },
 {
   "id": 22963,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 10,
   "firman": "\"Pergilah pada hari ini juga ke rumah Yosia bin Zefanya dan pungutlah persembahan dari pihak orang-orang buangan, yaitu dari Heldai, Tobia dan Yedaya, semuanya orang-orang yang sudah datang kembali dari Babel,"
 },
 {
   "id": 22964,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 11,
   "firman": "pungutlah perak dan emas, buatlah mahkota dan kenakanlah itu pada kepala imam besar Yosua bin Yozadak;"
 },
 {
   "id": 22965,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 12,
   "firman": "katakanlah kepadanya: Beginilah firman TUHAN semesta alam: Inilah orang yang bernama Tunas. Ia akan bertunas dari tempatnya dan ia akan mendirikan bait TUHAN."
 },
 {
   "id": 22966,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dialah yang akan mendirikan bait TUHAN, dan dialah yang akan mendapat keagungan dan akan duduk memerintah di atas takhtanya. Di sebelah kanannya akan ada seorang imam dan permufakatan tentang damai akan ada di antara mereka berdua."
 },
 {
   "id": 22967,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 14,
   "firman": "Dan mahkota itu akan tetap tinggal dalam bait TUHAN sebagai tanda peringatan akan Heldai, Tobia, Yedaya dan akan Yosia bin Zefanya."
 },
 {
   "id": 22968,
   "kitab": "Zak",
   "pasal": 6,
   "ayat": 15,
   "firman": "Orang-orang dari jauh akan datang untuk turut membangun bait TUHAN; maka kamu akan mengetahui bahwa TUHAN semesta alam yang mengutus aku kepadamu. Dan hal ini akan terjadi, apabila kamu dengan baik-baik mendengarkan suara TUHAN Allahmu.\""
 },
 {
   "id": 22969,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 1,
   "firman": "Pada tahun yang keempat zaman raja Darius datanglah firman TUHAN kepada Zakharia, pada tanggal empat bulan kesembilan, yakni bulan Kislew."
 },
 {
   "id": 22970,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 2,
   "firman": "Adapun penduduk Betel telah mengutus Sarezer dan Regem-Melekh serta orang-orangnya untuk melunakkan hati TUHAN,"
 },
 {
   "id": 22971,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 3,
   "firman": "untuk menanyakan kepada para imam dari rumah TUHAN semesta alam dan kepada nabi, demikian: \"Haruskah kami sekalian menangis dan berpantang dalam bulan yang kelima seperti yang telah kami lakukan bertahun-tahun lamanya?\""
 },
 {
   "id": 22972,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 4,
   "firman": "Maka datanglah firman TUHAN semesta alam kepadaku, bunyinya:"
 },
 {
   "id": 22973,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 5,
   "firman": "\"Katakanlah kepada seluruh rakyat negeri dan kepada para imam, demikian: Ketika kamu berpuasa dan meratap dalam bulan yang kelima dan yang ketujuh selama tujuh puluh tahun ini, adakah kamu sungguh-sungguh berpuasa untuk Aku?"
 },
 {
   "id": 22974,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 6,
   "firman": "Dan ketika kamu makan dan ketika kamu minum, bukankah kamu makan dan minum untuk dirimu sendiri?"
 },
 {
   "id": 22975,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 7,
   "firman": "Bukankah ini firman yang telah disampaikan TUHAN dengan perantaraan para nabi yang dahulu, ketika Yerusalem dengan kota-kota yang di sekelilingnya masih didiami orang dan masih sentosa dan Tanah Negeb dan Daerah Bukit masih didiami?\""
 },
 {
   "id": 22976,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 8,
   "firman": "Firman TUHAN datang kepada Zakharia, bunyinya:"
 },
 {
   "id": 22977,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 9,
   "firman": "\"Beginilah firman TUHAN semesta alam: Laksanakanlah hukum yang benar dan tunjukkanlah kesetiaan dan kasih sayang kepada masing-masing!"
 },
 {
   "id": 22978,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 10,
   "firman": "Janganlah menindas janda dan anak yatim, orang asing dan orang miskin, dan janganlah merancang kejahatan dalam hatimu terhadap masing-masing.\""
 },
 {
   "id": 22979,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 11,
   "firman": "Tetapi mereka tidak mau menghiraukan, dilintangkannya bahunya untuk melawan dan ditulikannya telinganya supaya jangan mendengar."
 },
 {
   "id": 22980,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 12,
   "firman": "Mereka membuat hati mereka keras seperti batu amril, supaya jangan mendengar pengajaran dan firman yang disampaikan TUHAN semesta alam melalui roh-Nya dengan perantaraan para nabi yang dahulu. Oleh sebab itu datang murka yang hebat dari pada TUHAN."
 },
 {
   "id": 22981,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 13,
   "firman": "\"Seperti mereka tidak mendengarkan pada waktu dipanggil, demikianlah Aku tidak mendengarkan pada waktu mereka memanggil, firman TUHAN semesta alam."
 },
 {
   "id": 22982,
   "kitab": "Zak",
   "pasal": 7,
   "ayat": 14,
   "firman": "Oleh sebab itu Aku meniupkan mereka seperti angin badai ke antara segala bangsa yang tidak dikenal mereka, dan sesudahnya tanah itu menjadi sunyi sepi, sehingga tidak ada yang lalu lalang di sana; demikianlah mereka membuat negeri yang indah itu menjadi tempat yang sunyi sepi.\""
 },
 {
   "id": 22983,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 1,
   "firman": "Datanglah firman TUHAN semesta alam, bunyinya:"
 },
 {
   "id": 22984,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 2,
   "firman": "\"Beginilah firman TUHAN semesta alam: Aku berusaha untuk Sion dengan kegiatan yang besar dan dengan kehangatan amarah yang besar."
 },
 {
   "id": 22985,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 3,
   "firman": "Beginilah firman TUHAN: Aku akan kembali ke Sion dan akan diam di tengah-tengah Yerusalem. Yerusalem akan disebut Kota Setia, dan gunung TUHAN semesta alam akan disebut Gunung Kudus."
 },
 {
   "id": 22986,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 4,
   "firman": "Beginilah firman TUHAN semesta alam: Akan ada lagi kakek-kakek dan nenek-nenek duduk di jalan-jalan Yerusalem, masing-masing memegang tongkat karena lanjut usianya."
 },
 {
   "id": 22987,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 5,
   "firman": "Dan jalan-jalan kota itu akan penuh dengan anak laki-laki dan anak perempuan yang bermain-main di situ."
 },
 {
   "id": 22988,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 6,
   "firman": "Beginilah firman TUHAN semesta alam: Kalau pada waktu itu sisa-sisa bangsa ini menganggap hal itu ajaib, apakah Aku akan menganggapnya ajaib? demikianlah firman TUHAN semesta alam."
 },
 {
   "id": 22989,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 7,
   "firman": "Beginilah firman TUHAN semesta alam: Sesungguhnya, Aku menyelamatkan umat-Ku dari tempat terbitnya matahari sampai kepada tempat terbenamnya,"
 },
 {
   "id": 22990,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 8,
   "firman": "dan Aku akan membawa mereka pulang, supaya mereka diam di tengah-tengah Yerusalem. Maka mereka akan menjadi umat-Ku dan Aku akan menjadi Allah mereka dalam kesetiaan dan kebenaran.\""
 },
 {
   "id": 22991,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 9,
   "firman": "Beginilah firman TUHAN semesta alam: \"Kuatkanlah hatimu, hai orang-orang yang selama ini telah mendengar firman ini, yang diucapkan para nabi, sejak dasar rumah TUHAN semesta alam diletakkan, untuk mendirikan Bait Suci itu."
 },
 {
   "id": 22992,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 10,
   "firman": "Sebab sebelum waktu itu tidak ada rezeki bagi manusia, juga tidak bagi binatang; dan karena musuh tidak ada keamanan bagi orang yang keluar dan bagi orang yang masuk, lagipula Aku membuat manusia semua bertengkar."
 },
 {
   "id": 22993,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 11,
   "firman": "Tetapi sekarang, Aku tidak lagi seperti waktu dahulu terhadap sisa-sisa bangsa ini, demikianlah firman TUHAN semesta alam,"
 },
 {
   "id": 22994,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 12,
   "firman": "melainkan Aku akan menabur damai sejahtera. Maka pohon anggur akan memberi buahnya dan tanah akan memberi hasilnya dan langit akan memberi air embunnya. Aku akan memberi semuanya itu kepada sisa-sisa bangsa ini sebagai miliknya."
 },
 {
   "id": 22995,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 13,
   "firman": "Dan kalau dahulu kamu telah menjadi kutuk di antara bangsa-bangsa, hai kaum Yehuda dan kaum Israel, maka sekarang Aku akan menyelamatkan kamu, sehingga kamu menjadi berkat. Janganlah takut, kuatkanlah hatimu!\""
 },
 {
   "id": 22996,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 14,
   "firman": "Sebab beginilah firman TUHAN semesta alam: \"Kalau dahulu Aku telah bermaksud mendatangkan malapetaka kepada kamu, ketika nenek moyangmu membuat Aku murka, dan Aku tidak menyesal, firman TUHAN semesta alam,"
 },
 {
   "id": 22997,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 15,
   "firman": "maka pada waktu ini Aku kembali bermaksud berbuat baik kepada Yerusalem dan kepada kaum Yehuda. Janganlah takut!"
 },
 {
   "id": 22998,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 16,
   "firman": "Inilah hal-hal yang harus kamu lakukan: Berkatalah benar seorang kepada yang lain dan laksanakanlah hukum yang benar, yang mendatangkan damai di pintu-pintu gerbangmu."
 },
 {
   "id": 22999,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 17,
   "firman": "Janganlah merancang kejahatan dalam hatimu seorang terhadap yang lain dan janganlah mencintai sumpah palsu. Sebab semuanya itu Kubenci, demikianlah firman TUHAN.\""
 },
 {
   "id": 23000,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 18,
   "firman": "Datanglah firman TUHAN semesta alam kepadaku, bunyinya:"
 },
 {
   "id": 23001,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 19,
   "firman": "\"Beginilah firman TUHAN semesta alam: Waktu puasa dalam bulan yang keempat, dalam bulan yang kelima, dalam bulan yang ketujuh dan dalam bulan yang kesepuluh akan menjadi kegirangan dan sukacita dan menjadi waktu-waktu perayaan yang menggembirakan bagi kaum Yehuda. Maka cintailah kebenaran dan damai!\""
 },
 {
   "id": 23002,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 20,
   "firman": "Beginilah firman TUHAN semesta alam: \"Masih akan datang lagi bangsa-bangsa dan penduduk banyak kota."
 },
 {
   "id": 23003,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 21,
   "firman": "Dan penduduk kota yang satu akan pergi kepada penduduk kota yang lain, mengatakan: Marilah kita pergi untuk melunakkan hati TUHAN dan mencari TUHAN semesta alam! Kamipun akan pergi!"
 },
 {
   "id": 23004,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 22,
   "firman": "Jadi banyak bangsa dan suku-suku bangsa yang kuat akan datang mencari TUHAN semesta alam di Yerusalem dan melunakkan hati TUHAN.\""
 },
 {
   "id": 23005,
   "kitab": "Zak",
   "pasal": 8,
   "ayat": 23,
   "firman": "Beginilah firman TUHAN semesta alam: \"Pada waktu itu sepuluh orang dari berbagai-bagai bangsa dan bahasa akan memegang kuat-kuat punca jubah seorang Yahudi dengan berkata: Kami mau pergi menyertai kamu, sebab telah kami dengar, bahwa Allah menyertai kamu!\""
 },
 {
   "id": 23006,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 1,
   "firman": "Ucapan Ilahi. Firman TUHAN datang atas negeri Hadrakh dan berhenti di Damsyik. Sebab kepunyaan Tuhanlah kota-kota Aram serta segala suku Israel;"
 },
 {
   "id": 23007,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 2,
   "firman": "juga Hamat yang berbatas kepadanya, pula Tirus dan Sidon, sekalipun mereka sangat bijaksana."
 },
 {
   "id": 23008,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 3,
   "firman": "Tirus mendirikan tembok benteng bagi dirinya dan menimbun perak seperti debu dan emas seperti lumpur di jalan."
 },
 {
   "id": 23009,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 4,
   "firman": "Namun sesungguhnya, Tuhan akan membuatnya miskin dan akan melontarkan kekuatannya ke dalam laut, dan kota itu sendiri akan habis dimakan api."
 },
 {
   "id": 23010,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 5,
   "firman": "Askelon akan melihatnya, lalu takut; juga Gaza, lalu gemetar sangat; Ekronpun, sebab harapannya sudah kandas. Dari Gaza raja akan binasa dan Askelon tidak akan didiami lagi."
 },
 {
   "id": 23011,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 6,
   "firman": "Di Asdod akan diam keturunan campuran, dan kebanggaan orang Filistin akan Kulenyapkan."
 },
 {
   "id": 23012,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 7,
   "firman": "Aku akan melenyapkan darah dari mulutnya dan kejijikan dari antara giginya, dan yang tinggal dari merekapun akan menjadi kepunyaan Allah kita. Mereka akan dianggap seperti suatu kaum di Yehuda, dan orang Ekron seperti orang Yebus."
 },
 {
   "id": 23013,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 8,
   "firman": "Aku berkemah dekat rumah-Ku sebagai pengawal terhadap mereka yang lalu-lalang; tidak akan ada lagi penindas mendatanginya, sebab sekarang Aku sendiri telah mengindahkannya."
 },
 {
   "id": 23014,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 9,
   "firman": "Bersorak-soraklah dengan nyaring, hai puteri Sion, bersorak-sorailah, hai puteri Yerusalem! Lihat, rajamu datang kepadamu; ia adil dan jaya. Ia lemah lembut dan mengendarai seekor keledai, seekor keledai beban yang muda."
 },
 {
   "id": 23015,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 10,
   "firman": "Ia akan melenyapkan kereta-kereta dari Efraim dan kuda-kuda dari Yerusalem; busur perang akan dilenyapkan, dan ia akan memberitakan damai kepada bangsa-bangsa. Wilayah kekuasaannya akan terbentang dari laut sampai ke laut dan dari sungai Efrat sampai ke ujung-ujung bumi."
 },
 {
   "id": 23016,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 11,
   "firman": "Mengenai engkau, oleh karena darah perjanjian-Ku dengan engkau, Aku akan melepaskan orang-orang tahananmu dari lobang yang tidak berair."
 },
 {
   "id": 23017,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 12,
   "firman": "Kembalilah ke kota bentengmu, hai orang tahanan yang penuh harapan! Pada hari ini juga Aku memberitahukan: Aku akan memberi ganti kepadamu dua kali lipat!"
 },
 {
   "id": 23018,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 13,
   "firman": "Sebab Aku melentur Yehuda bagi-Ku, busur Kuisi dengan Efraim, dan Aku mengayunkan anak-anakmu, hai Sion, terhadap anak-anakmu, hai Yunani, dan Aku akan memakai engkau seperti pedang seorang pahlawan."
 },
 {
   "id": 23019,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 14,
   "firman": "TUHAN akan menampakkan diri kepada mereka, dan anak panah-Nya akan melayang keluar seperti kilat. Dan Tuhan ALLAH akan meniup sangkakala dan akan berjalan maju dalam angin badai dari selatan."
 },
 {
   "id": 23020,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 15,
   "firman": "TUHAN semesta alam akan melindungi mereka, dan mereka akan menghabisi dan menginjak-injak pengumban-pengumban. Mereka akan minum darah seperti minum anggur dan menjadi penuh seperti bokor penyiraman, seperti penjuru-penjuru mezbah."
 },
 {
   "id": 23021,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 16,
   "firman": "TUHAN, Allah mereka, akan menyelamatkan mereka pada hari itu; seperti kawanan domba umat-Nya itu, sungguh, mereka seperti permata-permata mahkota yang berkilap-kilap, demikianlah mereka di tanah TUHAN."
 },
 {
   "id": 23022,
   "kitab": "Zak",
   "pasal": 9,
   "ayat": 17,
   "firman": "Sungguh, alangkah baiknya itu dan alangkah indahnya! Teruna bertumbuh pesat karena gandum, dan anak dara karena anggur."
 },
 {
   "id": 23023,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 1,
   "firman": "Mintalah hujan dari pada TUHAN pada akhir musim semi! Tuhanlah yang membuat awan-awan pembawa hujan deras, dan hujan lebat akan Diberikannya kepada mereka dan tumbuh-tumbuhan di padang kepada setiap orang."
 },
 {
   "id": 23024,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 2,
   "firman": "Sebab apa yang dikatakan oleh terafim adalah jahat, dan yang dilihat oleh juru-juru tenung adalah dusta, dan mimpi-mimpi yang disebutkan mereka adalah hampa, serta hiburan yang diberikan mereka adalah kesia-siaan. Oleh sebab itu bangsa itu berkeliaran seperti kawanan domba dan menderita sengsara sebab tidak ada gembala."
 },
 {
   "id": 23025,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 3,
   "firman": "\"Terhadap para gembala akan bangkit murka-Ku dan terhadap kepala-kepala kawanan kambing Aku akan mengadakan pembalasan, sebab TUHAN semesta alam memperhatikan kawanan ternak-Nya, yakni kaum Yehuda, dan membuat mereka sebagai kuda keagungan-Nya dalam pertempuran."
 },
 {
   "id": 23026,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 4,
   "firman": "Dari pada mereka akan muncul batu penjuru, dari pada mereka akan muncul patok kemah, dari pada mereka akan muncul busur perang, dari pada mereka akan keluar semua penguasa bersama-sama."
 },
 {
   "id": 23027,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 5,
   "firman": "Maka mereka akan seperti pahlawan yang menginjak-injak musuh seakan-akan itu lumpur di jalan; mereka akan berperang, sebab TUHAN menyertai mereka, dan mereka akan membuat malu orang-orang yang mengendarai kuda."
 },
 {
   "id": 23028,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 6,
   "firman": "Aku akan membuat kuat kaum Yehuda, dan Aku menyelamatkan keturunan Yusuf. Aku akan membawa mereka kembali, sebab Aku menyayangi mereka; dan keadaan mereka seakan-akan tidak pernah ditolak oleh Aku, sebab Akulah TUHAN, Allah mereka, dan Aku akan menjawab mereka."
 },
 {
   "id": 23029,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 7,
   "firman": "Efraim akan seperti seorang pahlawan, hati mereka akan bersukacita seperti oleh anggur. Anak-anak mereka akan melihatnya, lalu bersukacita dan hati mereka bersorak-sorak karena TUHAN."
 },
 {
   "id": 23030,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 8,
   "firman": "Aku akan bersiul memanggil mereka dan Aku akan mengumpulkan mereka, sebab Aku sudah membebaskan mereka, dan jumlah mereka menjadi banyak seperti dahulu."
 },
 {
   "id": 23031,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sekalipun Aku telah menyerakkan mereka ke antara bangsa-bangsa, tetapi di tempat-tempat yang jauh mereka akan ingat kepada-Ku; mereka akan hidup bersama-sama anak-anak mereka dan mereka akan kembali."
 },
 {
   "id": 23032,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 10,
   "firman": "Aku akan membawa mereka kembali dari tanah Mesir, dan dari Asyur Aku akan mengumpulkan mereka; Aku akan membawa mereka masuk ke tanah Gilead dan ke Libanon, sehingga tidak ada tempat lagi bagi mereka."
 },
 {
   "id": 23033,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 11,
   "firman": "Mereka akan menyeberangi laut Mesir dan Ia akan memukul gelombang di laut, sehingga segala tempat yang dalam di sungai Nil menjadi kering. Kebanggaan Asyur akan diturunkan dan tongkat kerajaan Mesir akan lewat."
 },
 {
   "id": 23034,
   "kitab": "Zak",
   "pasal": 10,
   "ayat": 12,
   "firman": "Aku akan menguatkan mereka, dan mereka akan bermegah di dalam nama TUHAN,\" demikianlah firman TUHAN."
 },
 {
   "id": 23035,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 1,
   "firman": "Bukalah pintu-pintumu, hai Libanon, supaya api dapat memakan pohon-pohon arasmu."
 },
 {
   "id": 23036,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 2,
   "firman": "Merataplah, hai pohon sanobar, sebab sudah rebah pohon aras dan sudah dirusakkan pohon-pohon yang hebat! Merataplah, hai pohon-pohon tarbantin Basan, sebab telah rata hutan yang lebat itu!"
 },
 {
   "id": 23037,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 3,
   "firman": "Dengar, para gembala meratap! Sebab kemegahan mereka sudah dirusakkan. Dengar, singa-singa mengaum! Sebab sudah dirusakkan kebanggaan sungai Yordan."
 },
 {
   "id": 23038,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 4,
   "firman": "Beginilah firman TUHAN Allahku kepadaku: \"Gembalakanlah domba-domba sembelihan itu!"
 },
 {
   "id": 23039,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 5,
   "firman": "Orang-orang yang membelinya menyembelihnya dengan tidak merasa bersalah dan orang-orang yang menjualnya berkata: Terpujilah TUHAN! Aku telah menjadi kaya! Dan orang-orang yang menggembalakannya tidak mengasihaninya."
 },
 {
   "id": 23040,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 6,
   "firman": "Sebab Aku tidak lagi akan mengasihani penduduk bumi, demikianlah firman TUHAN, melainkan sesungguhnya, Aku akan menyerahkan manusia masing-masing ke dalam tangan gembalanya dan ke dalam tangan rajanya; mereka ini akan menghancurkan bumi dan Aku tidak akan melepaskan seorangpun dari tangan mereka.\""
 },
 {
   "id": 23041,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 7,
   "firman": "Maka aku menggembalakan domba-domba sembelihan itu untuk pedagang-pedagang domba. Aku mengambil dua tongkat: yang satu kusebutkan \"Kemurahan\" dan yang lain kusebutkan \"Ikatan\"; lalu aku menggembalakan domba-domba itu."
 },
 {
   "id": 23042,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 8,
   "firman": "Dalam satu bulan aku melenyapkan ketiga gembala itu. Kemudian aku tidak dapat menahan hati lagi terhadap domba-domba itu, dan merekapun merasa muak terhadap aku."
 },
 {
   "id": 23043,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 9,
   "firman": "Lalu aku berkata: \"Aku tidak mau lagi menggembalakan kamu; yang hendak mati, biarlah mati; yang hendak lenyap, biarlah lenyap, dan yang masih tinggal itu, biarlah masing-masing memakan daging temannya!\""
 },
 {
   "id": 23044,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 10,
   "firman": "Aku mengambil tongkatku \"Kemurahan\", lalu mematahkannya untuk membatalkan perjanjian yang telah kuikat dengan segala bangsa."
 },
 {
   "id": 23045,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 11,
   "firman": "Jadi dibatalkanlah perjanjian pada hari itu, maka tahulah pedagang-pedagang domba yang sedang mengamat-amati aku, bahwa itu adalah firman TUHAN."
 },
 {
   "id": 23046,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 12,
   "firman": "Lalu aku berkata kepada mereka: \"Jika itu kamu anggap baik, berikanlah upahku, dan jika tidak, biarkanlah!\" Maka mereka membayar upahku dengan menimbang tiga puluh uang perak."
 },
 {
   "id": 23047,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 13,
   "firman": "Tetapi berfirmanlah TUHAN kepadaku: \"Serahkanlah itu kepada penuang logam!\" --nilai tinggi yang ditaksir mereka bagiku. Lalu aku mengambil ketiga puluh uang perak itu dan menyerahkannya kepada penuang logam di rumah TUHAN."
 },
 {
   "id": 23048,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 14,
   "firman": "Kemudian aku mematahkan tongkat yang kedua, yaitu \"Ikatan\", untuk meniadakan persaudaraan antara Yehuda dan Israel."
 },
 {
   "id": 23049,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 15,
   "firman": "Sesudah itu berfirmanlah TUHAN kepadaku: \"Ambillah sekali lagi perkakas seorang gembala yang pandir!"
 },
 {
   "id": 23050,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 16,
   "firman": "Sebab sesungguhnya, Aku akan membangkitkan di negeri ini seorang gembala yang tidak mengindahkan yang lenyap, yang tidak mencari yang hilang, yang tidak menyembuhkan yang luka, yang tidak memelihara yang sehat, melainkan memakan daging dari yang gemuk dan mencabut kuku mereka."
 },
 {
   "id": 23051,
   "kitab": "Zak",
   "pasal": 11,
   "ayat": 17,
   "firman": "Celakalah gembala-Ku yang pandir, yang meninggalkan domba-domba! Biarlah pedang menimpa lengannya dan menimpa mata kanannya! Biarlah lengannya kering sekering-keringnya, dan mata kanannya menjadi pudar sepudar-pudarnya!\""
 },
 {
   "id": 23052,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 1,
   "firman": "Ucapan ilahi. Firman TUHAN tentang Israel: Demikianlah firman TUHAN yang membentangkan langit dan yang meletakkan dasar bumi dan yang menciptakan roh dalam diri manusia:"
 },
 {
   "id": 23053,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 2,
   "firman": "\"Sesungguhnya Aku membuat Yerusalem menjadi pasu yang menyebabkan segala bangsa di sekeliling menjadi pening; juga Yehuda akan mengalami kesusahan ketika Yerusalem dikepung."
 },
 {
   "id": 23054,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 3,
   "firman": "Maka pada waktu itu Aku akan membuat Yerusalem menjadi batu untuk diangkat bagi segala bangsa. Siapa yang mengangkatnya pastilah mendapat luka parah. Segala bangsa di bumi akan berkumpul melawannya."
 },
 {
   "id": 23055,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 4,
   "firman": "Pada waktu itu, demikianlah firman TUHAN, Aku akan membuat segala kuda menjadi bingung, penunggangnya menjadi gila. Atas kaum Yehuda, Aku akan membuka mata-Ku, tetapi segala kuda bangsa akan Kubuat menjadi buta."
 },
 {
   "id": 23056,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 5,
   "firman": "Sesudah itu kaum-kaum di Yehuda akan berkata dalam hatinya: Penduduk Yerusalem mempunyai kekuatan oleh karena TUHAN semesta alam, Allah mereka."
 },
 {
   "id": 23057,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 6,
   "firman": "Pada waktu itu Aku akan membuat kaum-kaum di Yehuda seperti anglo berapi di tengah-tengah timbunan kayu dan seperti suluh berapi di tengah-tengah timbunan bulir gandum; api keduanya akan menjilat ke kanan dan ke kiri segala bangsa di sekeliling, tetapi Yerusalem selanjutnya akan tetap tinggal di tempatnya yang dahulu."
 },
 {
   "id": 23058,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 7,
   "firman": "TUHAN akan pertama-tama memberi kemenangan kepada kemah-kemah Yehuda, supaya keluarga Daud dan penduduk Yerusalem jangan terlalu bermegah-megah terhadap Yehuda."
 },
 {
   "id": 23059,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 8,
   "firman": "Pada waktu itu TUHAN akan melindungi penduduk Yerusalem, dan orang yang tersandung di antara mereka pada waktu itu akan menjadi seperti Daud, dan keluarga Daud akan menjadi seperti Allah, seperti Malaikat TUHAN, yang mengepalai mereka."
 },
 {
   "id": 23060,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 9,
   "firman": "Maka pada waktu itu Aku berikhtiar untuk memunahkan segala bangsa yang menyerang Yerusalem.\""
 },
 {
   "id": 23061,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 10,
   "firman": "\"Aku akan mencurahkan roh pengasihan dan roh permohonan atas keluarga Daud dan atas penduduk Yerusalem, dan mereka akan memandang kepada dia yang telah mereka tikam, dan akan meratapi dia seperti orang meratapi anak tunggal, dan akan menangisi dia dengan pedih seperti orang menangisi anak sulung."
 },
 {
   "id": 23062,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 11,
   "firman": "Pada waktu itu ratapan di Yerusalem akan sama besarnya dengan ratapan atas Hadad-Rimon di lembah Megido."
 },
 {
   "id": 23063,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 12,
   "firman": "Negeri itu akan meratap, setiap kaum keluarga tersendiri; kaum keluarga keturunan Daud tersendiri dan isteri mereka tersendiri; kaum keluarga keturunan Natan tersendiri dan isteri mereka tersendiri;"
 },
 {
   "id": 23064,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 13,
   "firman": "kaum keluarga keturunan Lewi tersendiri dan isteri mereka tersendiri; kaum keluarga Simei tersendiri dan isteri mereka tersendiri;"
 },
 {
   "id": 23065,
   "kitab": "Zak",
   "pasal": 12,
   "ayat": 14,
   "firman": "juga segala kaum keluarga yang masih tinggal, setiap kaum keluarga tersendiri dan isteri mereka tersendiri.\""
 },
 {
   "id": 23066,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 1,
   "firman": "\"Pada waktu itu akan terbuka suatu sumber bagi keluarga Daud dan bagi penduduk Yerusalem untuk membasuh dosa dan kecemaran."
 },
 {
   "id": 23067,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 2,
   "firman": "Maka pada waktu itu, demikianlah firman TUHAN semesta alam, Aku akan melenyapkan nama-nama berhala dari negeri itu, sehingga orang tidak menyebutnya lagi. Juga para nabi dan roh najis akan Kusingkirkan dari negeri itu."
 },
 {
   "id": 23068,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 3,
   "firman": "Dan apabila seseorang masih tampil sebagai nabi, maka ayahnya dan ibunya, yang telah memperanakkan dia, akan berkata kepadanya: Janganlah engkau hidup lagi, sebab yang kaukatakan demi nama TUHAN itu adalah dusta! Lalu ayahnya dan ibunya, yang telah memperanakkan dia, akan menikam dia pada waktu ia bernubuat."
 },
 {
   "id": 23069,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 4,
   "firman": "Pada waktu itu para nabi masing-masing akan mendapat malu oleh karena penglihatannya sebagai nabi, dan tidak ada lagi dari mereka yang mengenakan jubah berbulu untuk berbohong;"
 },
 {
   "id": 23070,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 5,
   "firman": "tetapi masing-masing akan berkata: Aku ini bukan seorang nabi, melainkan seorang pengusaha tanah, sebab tanah adalah harta kepunyaanku sejak kecil."
 },
 {
   "id": 23071,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 6,
   "firman": "Dan apabila ada orang bertanya kepadanya: Bekas luka apakah yang ada pada badanmu ini?, lalu ia akan menjawab: Itulah luka yang kudapat di rumah sahabat-sahabatku!\""
 },
 {
   "id": 23072,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 7,
   "firman": "\"Hai pedang, bangkitlah terhadap gembala-Ku, terhadap orang yang paling karib kepada-Ku!\", demikianlah firman TUHAN semesta alam. \"Bunuhlah gembala, sehingga domba-domba tercerai-berai! Aku akan mengenakan tangan-Ku terhadap yang lemah."
 },
 {
   "id": 23073,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 8,
   "firman": "Maka di seluruh negeri, demikianlah firman TUHAN, dua pertiga dari padanya akan dilenyapkan, mati binasa, tetapi sepertiga dari padanya akan tinggal hidup."
 },
 {
   "id": 23074,
   "kitab": "Zak",
   "pasal": 13,
   "ayat": 9,
   "firman": "Aku akan menaruh yang sepertiga itu dalam api dan akan memurnikan mereka seperti orang memurnikan perak. Aku akan menguji mereka, seperti orang menguji emas. Mereka akan memanggil nama-Ku, dan Aku akan menjawab mereka. Aku akan berkata: Mereka adalah umat-Ku, dan mereka akan menjawab: TUHAN adalah Allahku!\""
 },
 {
   "id": 23075,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 1,
   "firman": "Sesungguhnya, akan datang hari yang ditetapkan TUHAN, maka jarahan yang dirampas dari padamu akan dibagi-bagi di tengah-tengahmu."
 },
 {
   "id": 23076,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 2,
   "firman": "Aku akan mengumpulkan segala bangsa untuk memerangi Yerusalem; kota itu akan direbut, rumah-rumah akan dirampoki dan perempuan-perempuan akan ditiduri. Setengah dari penduduk kota itu harus pergi ke dalam pembuangan, tetapi selebihnya dari bangsa itu tidak akan dilenyapkan dari kota itu."
 },
 {
   "id": 23077,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 3,
   "firman": "Kemudian TUHAN akan maju berperang melawan bangsa-bangsa itu seperti Ia berperang pada hari pertempuran."
 },
 {
   "id": 23078,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 4,
   "firman": "Pada waktu itu kaki-Nya akan berjejak di bukit Zaitun yang terletak di depan Yerusalem di sebelah timur. Bukit Zaitun itu akan terbelah dua dari timur ke barat, sehingga terjadi suatu lembah yang sangat besar; setengah dari bukit itu akan bergeser ke utara dan setengah lagi ke selatan."
 },
 {
   "id": 23079,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 5,
   "firman": "Maka tertutuplah lembah gunung-gunung-Ku, sebab lembah gunung itu akan menyentuh sisinya; dan kamu akan melarikan diri seperti kamu pernah melarikan diri oleh karena gempa bumi pada zaman Uzia, raja Yehuda. Lalu TUHAN, Allahku, akan datang, dan semua orang kudus bersama-sama Dia."
 },
 {
   "id": 23080,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 6,
   "firman": "Maka pada waktu itu tidak akan ada lagi udara dingin atau keadaan beku,"
 },
 {
   "id": 23081,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 7,
   "firman": "tetapi akan ada satu hari--hari itu diketahui oleh TUHAN--dengan tidak ada pergantian siang dan malam, dan malampun menjadi siang."
 },
 {
   "id": 23082,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 8,
   "firman": "Pada waktu itu akan mengalir air kehidupan dari Yerusalem; setengahnya mengalir ke laut timur, dan setengah lagi mengalir ke laut barat; hal itu akan terus berlangsung dalam musim panas dan dalam musim dingin."
 },
 {
   "id": 23083,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 9,
   "firman": "Maka TUHAN akan menjadi Raja atas seluruh bumi; pada waktu itu TUHAN adalah satu-satunya dan nama-Nya satu-satunya."
 },
 {
   "id": 23084,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 10,
   "firman": "Seluruh negeri ini akan berubah menjadi seperti Araba-Yordan, dari Geba sampai ke Rimon di sebelah selatan Yerusalem. Tetapi kota itu akan menjulang tinggi dan tetap tinggal di tempatnya, dari pintu gerbang Benyamin sampai ke tempat pintu gerbang yang dahulu, yakni sampai ke pintu gerbang Sudut, dan dari menara Hananeel sampai ke tempat pemerasan anggur raja."
 },
 {
   "id": 23085,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 11,
   "firman": "Orang akan menetap di dalamnya, sebab penumpasan tidak akan ada lagi, dan Yerusalem akan tetap aman."
 },
 {
   "id": 23086,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 12,
   "firman": "Inilah tulah yang akan ditimpakan TUHAN kepada segala bangsa yang memerangi Yerusalem: daging mereka akan menjadi busuk, sementara mereka masih berdiri, mata mereka akan menjadi busuk dalam lekuknya dan lidah mereka akan menjadi busuk dalam mulut mereka."
 },
 {
   "id": 23087,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 13,
   "firman": "Maka pada waktu itu akan terjadi kegemparan besar dari pada TUHAN di antara mereka, sehingga masing-masing memegang tangan temannya dan mengangkat tangannya melawan tangan temannya."
 },
 {
   "id": 23088,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 14,
   "firman": "Juga Yehuda akan berperang melawan Yerusalem itu; dan dikumpulkanlah harta benda segala bangsa di sekeliling, yaitu emas, perak dan pakaian dalam jumlah yang sangat besar."
 },
 {
   "id": 23089,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 15,
   "firman": "Tulah seperti itu juga akan menimpa kuda, bagal, unta, keledai dan segala hewan yang ada dalam perkemahan-perkemahan itu."
 },
 {
   "id": 23090,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 16,
   "firman": "Maka semua orang yang tinggal dari segala bangsa yang telah menyerang Yerusalem, akan datang tahun demi tahun untuk sujud menyembah kepada Raja, TUHAN semesta alam, dan untuk merayakan hari raya Pondok Daun."
 },
 {
   "id": 23091,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 17,
   "firman": "Tetapi bila mereka dari kaum-kaum di bumi tidak datang ke Yerusalem untuk sujud menyembah kepada Raja, TUHAN semesta alam, maka kepada mereka tidak akan turun hujan."
 },
 {
   "id": 23092,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 18,
   "firman": "Dan jika kaum Mesir tidak datang dan tidak masuk menghadap, maka kepada mereka akan turun tulah yang ditimpakan TUHAN kepada bangsa-bangsa yang tidak datang untuk merayakan hari raya Pondok Daun."
 },
 {
   "id": 23093,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 19,
   "firman": "Itulah hukuman dosa Mesir dan hukuman dosa segala bangsa yang tidak datang untuk merayakan hari raya Pondok Daun."
 },
 {
   "id": 23094,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 20,
   "firman": "Pada waktu itu akan tertulis pada kerencingan-kerencingan kuda: \"Kudus bagi TUHAN!\" dan kuali-kuali di rumah TUHAN akan seperti bokor-bokor penyiraman di depan mezbah."
 },
 {
   "id": 23095,
   "kitab": "Zak",
   "pasal": 14,
   "ayat": 21,
   "firman": "Maka segala kuali di Yerusalem dan di Yehuda akan menjadi kudus bagi TUHAN semesta alam; semua orang yang mempersembahkan korban akan datang mengambilnya dan memasak di dalamnya. Dan tidak akan ada lagi pedagang di rumah TUHAN semesta alam pada waktu itu."
 },
 {
   "id": 23096,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 1,
   "firman": "Ucapan ilahi. Firman TUHAN kepada Israel dengan perantaraan Maleakhi."
 },
 {
   "id": 23097,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Aku mengasihi kamu,\" firman TUHAN. Tetapi kamu berkata: \"Dengan cara bagaimanakah Engkau mengasihi kami?\" \"Bukankah Esau itu kakak Yakub?\" demikianlah firman TUHAN. \"Namun Aku mengasihi Yakub,"
 },
 {
   "id": 23098,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 3,
   "firman": "tetapi membenci Esau. Sebab itu Aku membuat pegunungannya menjadi sunyi sepi dan tanah pusakanya Kujadikan padang gurun.\""
 },
 {
   "id": 23099,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 4,
   "firman": "Apabila Edom berkata: \"Kami telah hancur, tetapi kami akan membangun kembali reruntuhan itu,\" maka beginilah firman TUHAN semesta alam: \"Mereka boleh membangun, tetapi Aku akan merobohkannya; dan orang akan menyebutkannya daerah kefasikan dan bangsa yang kepadanya TUHAN murka sampai selama-lamanya.\""
 },
 {
   "id": 23100,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 5,
   "firman": "Matamu akan melihat dan kamu sendiri akan berkata: \"TUHAN maha besar sampai di luar daerah Israel.\""
 },
 {
   "id": 23101,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 6,
   "firman": "Seorang anak menghormati bapanya dan seorang hamba menghormati tuannya. Jika Aku ini bapa, di manakah hormat yang kepada-Ku itu? Jika Aku ini tuan, di manakah takut yang kepada-Ku itu? firman TUHAN semesta alam kepada kamu, hai para imam yang menghina nama-Ku. Tetapi kamu berkata: \"Dengan cara bagaimanakah kami menghina nama-Mu?\""
 },
 {
   "id": 23102,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 7,
   "firman": "Kamu membawa roti cemar ke atas mezbah-Ku, tetapi berkata: \"Dengan cara bagaimanakah kami mencemarkannya?\" Dengan cara menyangka: \"Meja TUHAN boleh dihinakan!\""
 },
 {
   "id": 23103,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 8,
   "firman": "Apabila kamu membawa seekor binatang buta untuk dipersembahkan, tidakkah itu jahat? Apabila kamu membawa binatang yang timpang dan sakit, tidakkah itu jahat? Cobalah menyampaikannya kepada bupatimu, apakah ia berkenan kepadamu, apalagi menyambut engkau dengan baik? firman TUHAN semesta alam."
 },
 {
   "id": 23104,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 9,
   "firman": "Maka sekarang: \"Cobalah melunakkan hati Allah, supaya Ia mengasihani kita!\" Oleh tangan kamulah terjadi hal itu, masakan Ia akan menyambut salah seorang dari padamu dengan baik? firman TUHAN semesta alam."
 },
 {
   "id": 23105,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 10,
   "firman": "Sekiranya ada di antara kamu yang mau menutup pintu, supaya jangan kamu menyalakan api di mezbah-Ku dengan percuma. Aku tidak suka kepada kamu, firman TUHAN semesta alam, dan Aku tidak berkenan menerima persembahan dari tanganmu."
 },
 {
   "id": 23106,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab dari terbitnya sampai kepada terbenamnya matahari nama-Ku besar di antara bangsa-bangsa, dan di setiap tempat dibakar dan dipersembahkan korban bagi nama-Ku dan juga korban sajian yang tahir; sebab nama-Ku besar di antara bangsa-bangsa, firman TUHAN semesta alam."
 },
 {
   "id": 23107,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi kamu ini menajiskannya, karena kamu menyangka: \"Meja Tuhan memang cemar dan makanan yang ada di situ boleh dihinakan!\""
 },
 {
   "id": 23108,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kamu berkata: \"Lihat, alangkah susah payahnya!\" dan kamu menyusahkan Aku, firman TUHAN semesta alam. Kamu membawa binatang yang dirampas, binatang yang timpang dan binatang yang sakit, kamu membawanya sebagai persembahan. Akan berkenankah Aku menerimanya dari tanganmu? firman TUHAN."
 },
 {
   "id": 23109,
   "kitab": "Mal",
   "pasal": 1,
   "ayat": 14,
   "firman": "Terkutuklah penipu, yang mempunyai seekor binatang jantan di antara kawanan ternaknya, yang dinazarkannya, tetapi ia mempersembahkan binatang yang cacat kepada Tuhan. Sebab Aku ini Raja yang besar, firman TUHAN semesta alam, dan nama-Ku ditakuti di antara bangsa-bangsa."
 },
 {
   "id": 23110,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 1,
   "firman": "Maka sekarang, kepada kamulah tertuju perintah ini, hai para imam!"
 },
 {
   "id": 23111,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 2,
   "firman": "Jika kamu tidak mendengarkan, dan jika kamu tidak memberi perhatian untuk menghormati nama-Ku, firman TUHAN semesta alam, maka Aku akan mengirimkan kutuk ke antaramu dan akan membuat berkat-berkatmu menjadi kutuk, dan Aku telah membuatnya menjadi kutuk, sebab kamu ini tidak memperhatikan."
 },
 {
   "id": 23112,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 3,
   "firman": "Sesungguhnya, Aku akan mematahkan lenganmu dan akan melemparkan kotoran ke mukamu, yakni kotoran korban dari hari-hari rayamu, dan orang akan menyeret kamu ke kotoran itu."
 },
 {
   "id": 23113,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 4,
   "firman": "Maka kamu akan sadar, bahwa Kukirimkan perintah ini kepadamu, supaya perjanjian-Ku dengan Lewi tetap dipegang, firman TUHAN semesta alam."
 },
 {
   "id": 23114,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 5,
   "firman": "Perjanjian-Ku dengan dia pada satu pihak ialah kehidupan dan sejahtera dan itu Kuberikan kepadanya--pada pihak lain ketakutan--dan ia takut kepada-Ku dan gentar terhadap nama-Ku."
 },
 {
   "id": 23115,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 6,
   "firman": "Pengajaran yang benar ada dalam mulutnya dan kecurangan tidak terdapat pada bibirnya. Dalam damai sejahtera dan kejujuran ia mengikuti Aku dan banyak orang dibuatnya berbalik dari pada kesalahan."
 },
 {
   "id": 23116,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 7,
   "firman": "Sebab bibir seorang imam memelihara pengetahuan dan orang mencari pengajaran dari mulutnya, sebab dialah utusan TUHAN semesta alam."
 },
 {
   "id": 23117,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 8,
   "firman": "Tetapi kamu ini menyimpang dari jalan; kamu membuat banyak orang tergelincir dengan pengajaranmu; kamu merusakkan perjanjian dengan Lewi, firman TUHAN semesta alam."
 },
 {
   "id": 23118,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka Akupun akan membuat kamu hina dan rendah bagi seluruh umat ini, oleh karena kamu tidak mengikuti jalan yang Kutunjukkan, tetapi memandang bulu dalam pengajaranmu."
 },
 {
   "id": 23119,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 10,
   "firman": "Bukankah kita sekalian mempunyai satu bapa? Bukankah satu Allah menciptakan kita? Lalu mengapa kita berkhianat satu sama lain dan dengan demikian menajiskan perjanjian nenek moyang kita?"
 },
 {
   "id": 23120,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 11,
   "firman": "Yehuda berkhianat, dan perbuatan keji dilakukan di Israel dan di Yerusalem, sebab Yehuda telah menajiskan tempat kudus yang dikasihi TUHAN dan telah menjadi suami anak perempuan allah asing."
 },
 {
   "id": 23121,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 12,
   "firman": "Biarlah TUHAN melenyapkan dari kemah-kemah Yakub segenap keturunan orang yang berbuat demikian, sekalipun ia membawa persembahan kepada TUHAN semesta alam!"
 },
 {
   "id": 23122,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan inilah yang kedua yang kamu lakukan: Kamu menutupi mezbah TUHAN dengan air mata, dengan tangisan dan rintihan, oleh karena Ia tidak lagi berpaling kepada persembahan dan tidak berkenan menerimanya dari tanganmu."
 },
 {
   "id": 23123,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 14,
   "firman": "Dan kamu bertanya: \"Oleh karena apa?\" Oleh sebab TUHAN telah menjadi saksi antara engkau dan isteri masa mudamu yang kepadanya engkau telah tidak setia, padahal dialah teman sekutumu dan isteri seperjanjianmu."
 },
 {
   "id": 23124,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 15,
   "firman": "Bukankah Allah yang Esa menjadikan mereka daging dan roh? Dan apakah yang dikehendaki kesatuan itu? Keturunan ilahi! Jadi jagalah dirimu! Dan janganlah orang tidak setia terhadap isteri dari masa mudanya."
 },
 {
   "id": 23125,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 16,
   "firman": "Sebab Aku membenci perceraian, firman TUHAN, Allah Israel--juga orang yang menutupi pakaiannya dengan kekerasan, firman TUHAN semesta alam. Maka jagalah dirimu dan janganlah berkhianat!"
 },
 {
   "id": 23126,
   "kitab": "Mal",
   "pasal": 2,
   "ayat": 17,
   "firman": "Kamu menyusahi TUHAN dengan perkataanmu. Tetapi kamu berkata: \"Dengan cara bagaimanakah kami menyusahi Dia?\" Dengan cara kamu menyangka: \"Setiap orang yang berbuat jahat adalah baik di mata TUHAN; kepada orang-orang yang demikianlah Ia berkenan--atau jika tidak, di manakah Allah yang menghukum?\""
 },
 {
   "id": 23127,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 1,
   "firman": "Lihat, Aku menyuruh utusan-Ku, supaya ia mempersiapkan jalan di hadapan-Ku! Dengan mendadak Tuhan yang kamu cari itu akan masuk ke bait-Nya! Malaikat Perjanjian yang kamu kehendaki itu, sesungguhnya, Ia datang, firman TUHAN semesta alam."
 },
 {
   "id": 23128,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 2,
   "firman": "Siapakah yang dapat tahan akan hari kedatangan-Nya? Dan siapakah yang dapat tetap berdiri, apabila Ia menampakkan diri? Sebab Ia seperti api tukang pemurni logam dan seperti sabun tukang penatu."
 },
 {
   "id": 23129,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 3,
   "firman": "Ia akan duduk seperti orang yang memurnikan dan mentahirkan perak; dan Ia mentahirkan orang Lewi, menyucikan mereka seperti emas dan seperti perak, supaya mereka menjadi orang-orang yang mempersembahkan korban yang benar kepada TUHAN."
 },
 {
   "id": 23130,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 4,
   "firman": "Maka persembahan Yehuda dan Yerusalem akan menyenangkan hati TUHAN seperti pada hari-hari dahulu kala dan seperti tahun-tahun yang sudah-sudah."
 },
 {
   "id": 23131,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 5,
   "firman": "Aku akan mendekati kamu untuk menghakimi dan akan segera menjadi saksi terhadap tukang-tukang sihir, orang-orang berzinah dan orang-orang yang bersumpah dusta dan terhadap orang-orang yang menindas orang upahan, janda dan anak piatu, dan yang mendesak ke samping orang asing, dengan tidak takut kepada-Ku, firman TUHAN semesta alam."
 },
 {
   "id": 23132,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 6,
   "firman": "Bahwasanya Aku, TUHAN, tidak berubah, dan kamu, bani Yakub, tidak akan lenyap."
 },
 {
   "id": 23133,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sejak zaman nenek moyangmu kamu telah menyimpang dari ketetapan-Ku dan tidak memeliharanya. Kembalilah kepada-Ku, maka Aku akan kembali kepadamu, firman TUHAN semesta alam. Tetapi kamu berkata: \"Dengan cara bagaimanakah kami harus kembali?\""
 },
 {
   "id": 23134,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 8,
   "firman": "Bolehkah manusia menipu Allah? Namun kamu menipu Aku. Tetapi kamu berkata: \"Dengan cara bagaimanakah kami menipu Engkau?\" Mengenai persembahan persepuluhan dan persembahan khusus!"
 },
 {
   "id": 23135,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 9,
   "firman": "Kamu telah kena kutuk, tetapi kamu masih menipu Aku, ya kamu seluruh bangsa!"
 },
 {
   "id": 23136,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 10,
   "firman": "Bawalah seluruh persembahan persepuluhan itu ke dalam rumah perbendaharaan, supaya ada persediaan makanan di rumah-Ku dan ujilah Aku, firman TUHAN semesta alam, apakah Aku tidak membukakan bagimu tingkap-tingkap langit dan mencurahkan berkat kepadamu sampai berkelimpahan."
 },
 {
   "id": 23137,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 11,
   "firman": "Aku akan menghardik bagimu belalang pelahap, supaya jangan dihabisinya hasil tanahmu dan supaya jangan pohon anggur di padang tidak berbuah bagimu, firman TUHAN semesta alam."
 },
 {
   "id": 23138,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 12,
   "firman": "Maka segala bangsa akan menyebut kamu berbahagia, sebab kamu ini akan menjadi negeri kesukaan, firman TUHAN semesta alam."
 },
 {
   "id": 23139,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 13,
   "firman": "Bicaramu kurang ajar tentang Aku, firman TUHAN. Tetapi kamu berkata: \"Apakah kami bicarakan di antara kami tentang Engkau?\""
 },
 {
   "id": 23140,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 14,
   "firman": "Kamu berkata: \"Adalah sia-sia beribadah kepada Allah. Apakah untungnya kita memelihara apa yang harus dilakukan terhadap-Nya dan berjalan dengan pakaian berkabung di hadapan TUHAN semesta alam?"
 },
 {
   "id": 23141,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 15,
   "firman": "Oleh sebab itu kita ini menyebut berbahagia orang-orang yang gegabah: bukan saja mujur orang-orang yang berbuat fasik itu, tetapi dengan mencobai Allahpun, mereka luput juga.\""
 },
 {
   "id": 23142,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 16,
   "firman": "Beginilah berbicara satu sama lain orang-orang yang takut akan TUHAN: \"TUHAN memperhatikan dan mendengarnya; sebuah kitab peringatan ditulis di hadapan-Nya bagi orang-orang yang takut akan TUHAN dan bagi orang-orang yang menghormati nama-Nya.\""
 },
 {
   "id": 23143,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 17,
   "firman": "Mereka akan menjadi milik kesayangan-Ku sendiri, firman TUHAN semesta alam, pada hari yang Kusiapkan. Aku akan mengasihani mereka sama seperti seseorang menyayangi anaknya yang melayani dia."
 },
 {
   "id": 23144,
   "kitab": "Mal",
   "pasal": 3,
   "ayat": 18,
   "firman": "Maka kamu akan melihat kembali perbedaan antara orang benar dan orang fasik, antara orang yang beribadah kepada Allah dan orang yang tidak beribadah kepada-Nya."
 },
 {
   "id": 23145,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 1,
   "firman": "Bahwa sesungguhnya hari itu datang, menyala seperti perapian, maka semua orang gegabah dan setiap orang yang berbuat fasik menjadi seperti jerami dan akan terbakar oleh hari yang datang itu, firman TUHAN semesta alam, sampai tidak ditinggalkannya akar dan cabang mereka."
 },
 {
   "id": 23146,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 2,
   "firman": "Tetapi kamu yang takut akan nama-Ku, bagimu akan terbit surya kebenaran dengan kesembuhan pada sayapnya. Kamu akan keluar dan berjingkrak-jingkrak seperti anak lembu lepas kandang."
 },
 {
   "id": 23147,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 3,
   "firman": "Kamu akan menginjak-injak orang-orang fasik, sebab mereka akan menjadi abu di bawah telapak kakimu, pada hari yang Kusiapkan itu, firman TUHAN semesta alam."
 },
 {
   "id": 23148,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 4,
   "firman": "Ingatlah kepada Taurat yang telah Kuperintahkan kepada Musa, hamba-Ku, di gunung Horeb untuk disampaikan kepada seluruh Israel, yakni ketetapan-ketetapan dan hukum-hukum."
 },
 {
   "id": 23149,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 5,
   "firman": "Sesungguhnya Aku akan mengutus nabi Elia kepadamu menjelang datangnya hari TUHAN yang besar dan dahsyat itu."
 },
 {
   "id": 23150,
   "kitab": "Mal",
   "pasal": 4,
   "ayat": 6,
   "firman": "Maka ia akan membuat hati bapa-bapa berbalik kepada anak-anaknya dan hati anak-anak kepada bapa-bapanya supaya jangan Aku datang memukul bumi sehingga musnah."
 },
 {
   "id": 23151,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah silsilah Yesus Kristus, anak Daud, anak Abraham."
 },
 {
   "id": 23152,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 2,
   "firman": "Abraham memperanakkan Ishak, Ishak memperanakkan Yakub, Yakub memperanakkan Yehuda dan saudara-saudaranya,"
 },
 {
   "id": 23153,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 3,
   "firman": "Yehuda memperanakkan Peres dan Zerah dari Tamar, Peres memperanakkan Hezron, Hezron memperanakkan Ram,"
 },
 {
   "id": 23154,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 4,
   "firman": "Ram memperanakkan Aminadab, Aminadab memperanakkan Nahason, Nahason memperanakkan Salmon,"
 },
 {
   "id": 23155,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 5,
   "firman": "Salmon memperanakkan Boas dari Rahab, Boas memperanakkan Obed dari Rut, Obed memperanakkan Isai,"
 },
 {
   "id": 23156,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 6,
   "firman": "Isai memperanakkan raja Daud. Daud memperanakkan Salomo dari isteri Uria,"
 },
 {
   "id": 23157,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 7,
   "firman": "Salomo memperanakkan Rehabeam, Rehabeam memperanakkan Abia, Abia memperanakkan Asa,"
 },
 {
   "id": 23158,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 8,
   "firman": "Asa memperanakkan Yosafat, Yosafat memperanakkan Yoram, Yoram memperanakkan Uzia,"
 },
 {
   "id": 23159,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 9,
   "firman": "Uzia memperanakkan Yotam, Yotam memperanakkan Ahas, Ahas memperanakkan Hizkia,"
 },
 {
   "id": 23160,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 10,
   "firman": "Hizkia memperanakkan Manasye, Manasye memperanakkan Amon, Amon memperanakkan Yosia,"
 },
 {
   "id": 23161,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 11,
   "firman": "Yosia memperanakkan Yekhonya dan saudara-saudaranya pada waktu pembuangan ke Babel."
 },
 {
   "id": 23162,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 12,
   "firman": "Sesudah pembuangan ke Babel, Yekhonya memperanakkan Sealtiel, Sealtiel memperanakkan Zerubabel,"
 },
 {
   "id": 23163,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 13,
   "firman": "Zerubabel memperanakkan Abihud, Abihud memperanakkan Elyakim, Elyakim memperanakkan Azor,"
 },
 {
   "id": 23164,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 14,
   "firman": "Azor memperanakkan Zadok, Zadok memperanakkan Akhim, Akhim memperanakkan Eliud,"
 },
 {
   "id": 23165,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 15,
   "firman": "Eliud memperanakkan Eleazar, Eleazar memperanakkan Matan, Matan memperanakkan Yakub,"
 },
 {
   "id": 23166,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 16,
   "firman": "Yakub memperanakkan Yusuf suami Maria, yang melahirkan Yesus yang disebut Kristus."
 },
 {
   "id": 23167,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 17,
   "firman": "Jadi seluruhnya ada: empat belas keturunan dari Abraham sampai Daud, empat belas keturunan dari Daud sampai pembuangan ke Babel, dan empat belas keturunan dari pembuangan ke Babel sampai Kristus."
 },
 {
   "id": 23168,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 18,
   "firman": "Kelahiran Yesus Kristus adalah seperti berikut: Pada waktu Maria, ibu-Nya, bertunangan dengan Yusuf, ternyata ia mengandung dari Roh Kudus, sebelum mereka hidup sebagai suami isteri."
 },
 {
   "id": 23169,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena Yusuf suaminya, seorang yang tulus hati dan tidak mau mencemarkan nama isterinya di muka umum, ia bermaksud menceraikannya dengan diam-diam."
 },
 {
   "id": 23170,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 20,
   "firman": "Tetapi ketika ia mempertimbangkan maksud itu, malaikat Tuhan nampak kepadanya dalam mimpi dan berkata: \"Yusuf, anak Daud, janganlah engkau takut mengambil Maria sebagai isterimu, sebab anak yang di dalam kandungannya adalah dari Roh Kudus."
 },
 {
   "id": 23171,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 21,
   "firman": "Ia akan melahirkan anak laki-laki dan engkau akan menamakan Dia Yesus, karena Dialah yang akan menyelamatkan umat-Nya dari dosa mereka.\""
 },
 {
   "id": 23172,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 22,
   "firman": "Hal itu terjadi supaya genaplah yang difirmankan Tuhan oleh nabi:"
 },
 {
   "id": 23173,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 23,
   "firman": "\"Sesungguhnya, anak dara itu akan mengandung dan melahirkan seorang anak laki-laki, dan mereka akan menamakan Dia Imanuel\" --yang berarti: Allah menyertai kita."
 },
 {
   "id": 23174,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 24,
   "firman": "Sesudah bangun dari tidurnya, Yusuf berbuat seperti yang diperintahkan malaikat Tuhan itu kepadanya. Ia mengambil Maria sebagai isterinya,"
 },
 {
   "id": 23175,
   "kitab": "Mat",
   "pasal": 1,
   "ayat": 25,
   "firman": "tetapi tidak bersetubuh dengan dia sampai ia melahirkan anaknya laki-laki dan Yusuf menamakan Dia Yesus."
 },
 {
   "id": 23176,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 1,
   "firman": "Sesudah Yesus dilahirkan di Betlehem di tanah Yudea pada zaman raja Herodes, datanglah orang-orang majus dari Timur ke Yerusalem"
 },
 {
   "id": 23177,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 2,
   "firman": "dan bertanya-tanya: \"Di manakah Dia, raja orang Yahudi yang baru dilahirkan itu? Kami telah melihat bintang-Nya di Timur dan kami datang untuk menyembah Dia.\""
 },
 {
   "id": 23178,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 3,
   "firman": "Ketika raja Herodes mendengar hal itu terkejutlah ia beserta seluruh Yerusalem."
 },
 {
   "id": 23179,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 4,
   "firman": "Maka dikumpulkannya semua imam kepala dan ahli Taurat bangsa Yahudi, lalu dimintanya keterangan dari mereka, di mana Mesias akan dilahirkan."
 },
 {
   "id": 23180,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 5,
   "firman": "Mereka berkata kepadanya: \"Di Betlehem di tanah Yudea, karena demikianlah ada tertulis dalam kitab nabi:"
 },
 {
   "id": 23181,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 6,
   "firman": "Dan engkau Betlehem, tanah Yehuda, engkau sekali-kali bukanlah yang terkecil di antara mereka yang memerintah Yehuda, karena dari padamulah akan bangkit seorang pemimpin, yang akan menggembalakan umat-Ku Israel.\""
 },
 {
   "id": 23182,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 7,
   "firman": "Lalu dengan diam-diam Herodes memanggil orang-orang majus itu dan dengan teliti bertanya kepada mereka, bilamana bintang itu nampak."
 },
 {
   "id": 23183,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 8,
   "firman": "Kemudian ia menyuruh mereka ke Betlehem, katanya: \"Pergi dan selidikilah dengan seksama hal-hal mengenai Anak itu dan segera sesudah kamu menemukan Dia, kabarkanlah kepadaku supaya akupun datang menyembah Dia.\""
 },
 {
   "id": 23184,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 9,
   "firman": "Setelah mendengar kata-kata raja itu, berangkatlah mereka. Dan lihatlah, bintang yang mereka lihat di Timur itu mendahului mereka hingga tiba dan berhenti di atas tempat, di mana Anak itu berada."
 },
 {
   "id": 23185,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ketika mereka melihat bintang itu, sangat bersukacitalah mereka."
 },
 {
   "id": 23186,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 11,
   "firman": "Maka masuklah mereka ke dalam rumah itu dan melihat Anak itu bersama Maria, ibu-Nya, lalu sujud menyembah Dia. Merekapun membuka tempat harta bendanya dan mempersembahkan persembahan kepada-Nya, yaitu emas, kemenyan dan mur."
 },
 {
   "id": 23187,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan karena diperingatkan dalam mimpi, supaya jangan kembali kepada Herodes, maka pulanglah mereka ke negerinya melalui jalan lain."
 },
 {
   "id": 23188,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 13,
   "firman": "Setelah orang-orang majus itu berangkat, nampaklah malaikat Tuhan kepada Yusuf dalam mimpi dan berkata: \"Bangunlah, ambillah Anak itu serta ibu-Nya, larilah ke Mesir dan tinggallah di sana sampai Aku berfirman kepadamu, karena Herodes akan mencari Anak itu untuk membunuh Dia.\""
 },
 {
   "id": 23189,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 14,
   "firman": "Maka Yusufpun bangunlah, diambilnya Anak itu serta ibu-Nya malam itu juga, lalu menyingkir ke Mesir,"
 },
 {
   "id": 23190,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 15,
   "firman": "dan tinggal di sana hingga Herodes mati. Hal itu terjadi supaya genaplah yang difirmankan Tuhan oleh nabi: \"Dari Mesir Kupanggil Anak-Ku.\""
 },
 {
   "id": 23191,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 16,
   "firman": "Ketika Herodes tahu, bahwa ia telah diperdayakan oleh orang-orang majus itu, ia sangat marah. Lalu ia menyuruh membunuh semua anak di Betlehem dan sekitarnya, yaitu anak-anak yang berumur dua tahun ke bawah, sesuai dengan waktu yang dapat diketahuinya dari orang-orang majus itu."
 },
 {
   "id": 23192,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 17,
   "firman": "Dengan demikian genaplah firman yang disampaikan oleh nabi Yeremia:"
 },
 {
   "id": 23193,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 18,
   "firman": "\"Terdengarlah suara di Rama, tangis dan ratap yang amat sedih; Rahel menangisi anak-anaknya dan ia tidak mau dihibur, sebab mereka tidak ada lagi.\""
 },
 {
   "id": 23194,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 19,
   "firman": "Setelah Herodes mati, nampaklah malaikat Tuhan kepada Yusuf dalam mimpi di Mesir, katanya:"
 },
 {
   "id": 23195,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 20,
   "firman": "\"Bangunlah, ambillah Anak itu serta ibu-Nya dan berangkatlah ke tanah Israel, karena mereka yang hendak membunuh Anak itu, sudah mati.\""
 },
 {
   "id": 23196,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 21,
   "firman": "Lalu Yusufpun bangunlah, diambilnya Anak itu serta ibu-Nya dan pergi ke tanah Israel."
 },
 {
   "id": 23197,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 22,
   "firman": "Tetapi setelah didengarnya, bahwa Arkhelaus menjadi raja di Yudea menggantikan Herodes, ayahnya, ia takut ke sana. Karena dinasihati dalam mimpi, pergilah Yusuf ke daerah Galilea."
 },
 {
   "id": 23198,
   "kitab": "Mat",
   "pasal": 2,
   "ayat": 23,
   "firman": "Setibanya di sana iapun tinggal di sebuah kota yang bernama Nazaret. Hal itu terjadi supaya genaplah firman yang disampaikan oleh nabi-nabi, bahwa Ia akan disebut: Orang Nazaret."
 },
 {
   "id": 23199,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 1,
   "firman": "Pada waktu itu tampillah Yohanes Pembaptis di padang gurun Yudea dan memberitakan:"
 },
 {
   "id": 23200,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 2,
   "firman": "\"Bertobatlah, sebab Kerajaan Sorga sudah dekat!\""
 },
 {
   "id": 23201,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 3,
   "firman": "Sesungguhnya dialah yang dimaksudkan nabi Yesaya ketika ia berkata: \"Ada suara orang yang berseru-seru di padang gurun: Persiapkanlah jalan untuk Tuhan, luruskanlah jalan bagi-Nya.\""
 },
 {
   "id": 23202,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 4,
   "firman": "Yohanes memakai jubah bulu unta dan ikat pinggang kulit, dan makanannya belalang dan madu hutan."
 },
 {
   "id": 23203,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 5,
   "firman": "Maka datanglah kepadanya penduduk dari Yerusalem, dari seluruh Yudea dan dari seluruh daerah sekitar Yordan."
 },
 {
   "id": 23204,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lalu sambil mengaku dosanya mereka dibaptis oleh Yohanes di sungai Yordan."
 },
 {
   "id": 23205,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 7,
   "firman": "Tetapi waktu ia melihat banyak orang Farisi dan orang Saduki datang untuk dibaptis, berkatalah ia kepada mereka: \"Hai kamu keturunan ular beludak. Siapakah yang mengatakan kepada kamu, bahwa kamu dapat melarikan diri dari murka yang akan datang?"
 },
 {
   "id": 23206,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 8,
   "firman": "Jadi hasilkanlah buah yang sesuai dengan pertobatan."
 },
 {
   "id": 23207,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 9,
   "firman": "Dan janganlah mengira, bahwa kamu dapat berkata dalam hatimu: Abraham adalah bapa kami! Karena aku berkata kepadamu: Allah dapat menjadikan anak-anak bagi Abraham dari batu-batu ini!"
 },
 {
   "id": 23208,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 10,
   "firman": "Kapak sudah tersedia pada akar pohon dan setiap pohon yang tidak menghasilkan buah yang baik, pasti ditebang dan dibuang ke dalam api."
 },
 {
   "id": 23209,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 11,
   "firman": "Aku membaptis kamu dengan air sebagai tanda pertobatan, tetapi Ia yang datang kemudian dari padaku lebih berkuasa dari padaku dan aku tidak layak melepaskan kasut-Nya. Ia akan membaptiskan kamu dengan Roh Kudus dan dengan api."
 },
 {
   "id": 23210,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 12,
   "firman": "Alat penampi sudah ditangan-Nya. Ia akan membersihkan tempat pengirikan-Nya dan mengumpulkan gandum-Nya ke dalam lumbung, tetapi debu jerami itu akan dibakar-Nya dalam api yang tidak terpadamkan.\""
 },
 {
   "id": 23211,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 13,
   "firman": "Maka datanglah Yesus dari Galilea ke Yordan kepada Yohanes untuk dibaptis olehnya."
 },
 {
   "id": 23212,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 14,
   "firman": "Tetapi Yohanes mencegah Dia, katanya: \"Akulah yang perlu dibaptis oleh-Mu, dan Engkau yang datang kepadaku?\""
 },
 {
   "id": 23213,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 15,
   "firman": "Lalu Yesus menjawab, kata-Nya kepadanya: \"Biarlah hal itu terjadi, karena demikianlah sepatutnya kita menggenapkan seluruh kehendak Allah.\" Dan Yohanespun menuruti-Nya."
 },
 {
   "id": 23214,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 16,
   "firman": "Sesudah dibaptis, Yesus segera keluar dari air dan pada waktu itu juga langit terbuka dan Ia melihat Roh Allah seperti burung merpati turun ke atas-Nya,"
 },
 {
   "id": 23215,
   "kitab": "Mat",
   "pasal": 3,
   "ayat": 17,
   "firman": "lalu terdengarlah suara dari sorga yang mengatakan: \"Inilah Anak-Ku yang Kukasihi, kepada-Nyalah Aku berkenan.\""
 },
 {
   "id": 23216,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 1,
   "firman": "Maka Yesus dibawa oleh Roh ke padang gurun untuk dicobai Iblis."
 },
 {
   "id": 23217,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 2,
   "firman": "Dan setelah berpuasa empat puluh hari dan empat puluh malam, akhirnya laparlah Yesus."
 },
 {
   "id": 23218,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu datanglah si pencoba itu dan berkata kepada-Nya: \"Jika Engkau Anak Allah, perintahkanlah supaya batu-batu ini menjadi roti.\""
 },
 {
   "id": 23219,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi Yesus menjawab: \"Ada tertulis: Manusia hidup bukan dari roti saja, tetapi dari setiap firman yang keluar dari mulut Allah.\""
 },
 {
   "id": 23220,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 5,
   "firman": "Kemudian Iblis membawa-Nya ke Kota Suci dan menempatkan Dia di bubungan Bait Allah,"
 },
 {
   "id": 23221,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 6,
   "firman": "lalu berkata kepada-Nya: \"Jika Engkau Anak Allah, jatuhkanlah diri-Mu ke bawah, sebab ada tertulis: Mengenai Engkau Ia akan memerintahkan malaikat-malaikat-Nya dan mereka akan menatang Engkau di atas tangannya, supaya kaki-Mu jangan terantuk kepada batu.\""
 },
 {
   "id": 23222,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 7,
   "firman": "Yesus berkata kepadanya: \"Ada pula tertulis: Janganlah engkau mencobai Tuhan, Allahmu!\""
 },
 {
   "id": 23223,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dan Iblis membawa-Nya pula ke atas gunung yang sangat tinggi dan memperlihatkan kepada-Nya semua kerajaan dunia dengan kemegahannya,"
 },
 {
   "id": 23224,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 9,
   "firman": "dan berkata kepada-Nya: \"Semua itu akan kuberikan kepada-Mu, jika Engkau sujud menyembah aku.\""
 },
 {
   "id": 23225,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 10,
   "firman": "Maka berkatalah Yesus kepadanya: \"Enyahlah, Iblis! Sebab ada tertulis: Engkau harus menyembah Tuhan, Allahmu, dan hanya kepada Dia sajalah engkau berbakti!\""
 },
 {
   "id": 23226,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 11,
   "firman": "Lalu Iblis meninggalkan Dia, dan lihatlah, malaikat-malaikat datang melayani Yesus."
 },
 {
   "id": 23227,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 12,
   "firman": "Tetapi waktu Yesus mendengar, bahwa Yohanes telah ditangkap, menyingkirlah Ia ke Galilea."
 },
 {
   "id": 23228,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 13,
   "firman": "Ia meninggalkan Nazaret dan diam di Kapernaum, di tepi danau, di daerah Zebulon dan Naftali,"
 },
 {
   "id": 23229,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 14,
   "firman": "supaya genaplah firman yang disampaikan oleh nabi Yesaya:"
 },
 {
   "id": 23230,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 15,
   "firman": "\"Tanah Zebulon dan tanah Naftali, jalan ke laut, daerah seberang sungai Yordan, Galilea, wilayah bangsa-bangsa lain, --"
 },
 {
   "id": 23231,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 16,
   "firman": "bangsa yang diam dalam kegelapan, telah melihat Terang yang besar dan bagi mereka yang diam di negeri yang dinaungi maut, telah terbit Terang.\""
 },
 {
   "id": 23232,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 17,
   "firman": "Sejak waktu itulah Yesus memberitakan: \"Bertobatlah, sebab Kerajaan Sorga sudah dekat!\""
 },
 {
   "id": 23233,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 18,
   "firman": "Dan ketika Yesus sedang berjalan menyusur danau Galilea, Ia melihat dua orang bersaudara, yaitu Simon yang disebut Petrus, dan Andreas, saudaranya. Mereka sedang menebarkan jala di danau, sebab mereka penjala ikan."
 },
 {
   "id": 23234,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 19,
   "firman": "Yesus berkata kepada mereka: \"Mari, ikutlah Aku, dan kamu akan Kujadikan penjala manusia.\""
 },
 {
   "id": 23235,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 20,
   "firman": "Lalu merekapun segera meninggalkan jalanya dan mengikuti Dia."
 },
 {
   "id": 23236,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 21,
   "firman": "Dan setelah Yesus pergi dari sana, dilihat-Nya pula dua orang bersaudara, yaitu Yakobus anak Zebedeus dan Yohanes saudaranya, bersama ayah mereka, Zebedeus, sedang membereskan jala di dalam perahu. Yesus memanggil mereka"
 },
 {
   "id": 23237,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 22,
   "firman": "dan mereka segera meninggalkan perahu serta ayahnya, lalu mengikuti Dia."
 },
 {
   "id": 23238,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 23,
   "firman": "Yesuspun berkeliling di seluruh Galilea; Ia mengajar dalam rumah-rumah ibadat dan memberitakan Injil Kerajaan Allah serta melenyapkan segala penyakit dan kelemahan di antara bangsa itu."
 },
 {
   "id": 23239,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 24,
   "firman": "Maka tersiarlah berita tentang Dia di seluruh Siria dan dibawalah kepada-Nya semua orang yang buruk keadaannya, yang menderita pelbagai penyakit dan sengsara, yang kerasukan, yang sakit ayan dan yang lumpuh, lalu Yesus menyembuhkan mereka."
 },
 {
   "id": 23240,
   "kitab": "Mat",
   "pasal": 4,
   "ayat": 25,
   "firman": "Maka orang banyak berbondong-bondong mengikuti Dia. Mereka datang dari Galilea dan dari Dekapolis, dari Yerusalem dan dari Yudea dan dari seberang Yordan."
 },
 {
   "id": 23241,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 1,
   "firman": "Ketika Yesus melihat orang banyak itu, naiklah Ia ke atas bukit dan setelah Ia duduk, datanglah murid-murid-Nya kepada-Nya."
 },
 {
   "id": 23242,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 2,
   "firman": "Maka Yesuspun mulai berbicara dan mengajar mereka, kata-Nya:"
 },
 {
   "id": 23243,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 3,
   "firman": "\"Berbahagialah orang yang miskin di hadapan Allah, karena merekalah yang empunya Kerajaan Sorga."
 },
 {
   "id": 23244,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 4,
   "firman": "Berbahagialah orang yang berdukacita, karena mereka akan dihibur."
 },
 {
   "id": 23245,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 5,
   "firman": "Berbahagialah orang yang lemah lembut, karena mereka akan memiliki bumi."
 },
 {
   "id": 23246,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 6,
   "firman": "Berbahagialah orang yang lapar dan haus akan kebenaran, karena mereka akan dipuaskan."
 },
 {
   "id": 23247,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 7,
   "firman": "Berbahagialah orang yang murah hatinya, karena mereka akan beroleh kemurahan."
 },
 {
   "id": 23248,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 8,
   "firman": "Berbahagialah orang yang suci hatinya, karena mereka akan melihat Allah."
 },
 {
   "id": 23249,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 9,
   "firman": "Berbahagialah orang yang membawa damai, karena mereka akan disebut anak-anak Allah."
 },
 {
   "id": 23250,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 10,
   "firman": "Berbahagialah orang yang dianiaya oleh sebab kebenaran, karena merekalah yang empunya Kerajaan Sorga."
 },
 {
   "id": 23251,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 11,
   "firman": "Berbahagialah kamu, jika karena Aku kamu dicela dan dianiaya dan kepadamu difitnahkan segala yang jahat."
 },
 {
   "id": 23252,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 12,
   "firman": "Bersukacita dan bergembiralah, karena upahmu besar di sorga, sebab demikian juga telah dianiaya nabi-nabi yang sebelum kamu.\""
 },
 {
   "id": 23253,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 13,
   "firman": "\"Kamu adalah garam dunia. Jika garam itu menjadi tawar, dengan apakah ia diasinkan? Tidak ada lagi gunanya selain dibuang dan diinjak orang."
 },
 {
   "id": 23254,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 14,
   "firman": "Kamu adalah terang dunia. Kota yang terletak di atas gunung tidak mungkin tersembunyi."
 },
 {
   "id": 23255,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 15,
   "firman": "Lagipula orang tidak menyalakan pelita lalu meletakkannya di bawah gantang, melainkan di atas kaki dian sehingga menerangi semua orang di dalam rumah itu."
 },
 {
   "id": 23256,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 16,
   "firman": "Demikianlah hendaknya terangmu bercahaya di depan orang, supaya mereka melihat perbuatanmu yang baik dan memuliakan Bapamu yang di sorga.\""
 },
 {
   "id": 23257,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 17,
   "firman": "\"Janganlah kamu menyangka, bahwa Aku datang untuk meniadakan hukum Taurat atau kitab para nabi. Aku datang bukan untuk meniadakannya, melainkan untuk menggenapinya."
 },
 {
   "id": 23258,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 18,
   "firman": "Karena Aku berkata kepadamu: Sesungguhnya selama belum lenyap langit dan bumi ini, satu iota atau satu titikpun tidak akan ditiadakan dari hukum Taurat, sebelum semuanya terjadi."
 },
 {
   "id": 23259,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 19,
   "firman": "Karena itu siapa yang meniadakan salah satu perintah hukum Taurat sekalipun yang paling kecil, dan mengajarkannya demikian kepada orang lain, ia akan menduduki tempat yang paling rendah di dalam Kerajaan Sorga; tetapi siapa yang melakukan dan mengajarkan segala perintah-perintah hukum Taurat, ia akan menduduki tempat yang tinggi di dalam Kerajaan Sorga."
 },
 {
   "id": 23260,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 20,
   "firman": "Maka Aku berkata kepadamu: Jika hidup keagamaanmu tidak lebih benar dari pada hidup keagamaan ahli-ahli Taurat dan orang-orang Farisi, sesungguhnya kamu tidak akan masuk ke dalam Kerajaan Sorga."
 },
 {
   "id": 23261,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 21,
   "firman": "Kamu telah mendengar yang difirmankan kepada nenek moyang kita: Jangan membunuh; siapa yang membunuh harus dihukum."
 },
 {
   "id": 23262,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 22,
   "firman": "Tetapi Aku berkata kepadamu: Setiap orang yang marah terhadap saudaranya harus dihukum; siapa yang berkata kepada saudaranya: Kafir! harus dihadapkan ke Mahkamah Agama dan siapa yang berkata: Jahil! harus diserahkan ke dalam neraka yang menyala-nyala."
 },
 {
   "id": 23263,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 23,
   "firman": "Sebab itu, jika engkau mempersembahkan persembahanmu di atas mezbah dan engkau teringat akan sesuatu yang ada dalam hati saudaramu terhadap engkau,"
 },
 {
   "id": 23264,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 24,
   "firman": "tinggalkanlah persembahanmu di depan mezbah itu dan pergilah berdamai dahulu dengan saudaramu, lalu kembali untuk mempersembahkan persembahanmu itu."
 },
 {
   "id": 23265,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 25,
   "firman": "Segeralah berdamai dengan lawanmu selama engkau bersama-sama dengan dia di tengah jalan, supaya lawanmu itu jangan menyerahkan engkau kepada hakim dan hakim itu menyerahkan engkau kepada pembantunya dan engkau dilemparkan ke dalam penjara."
 },
 {
   "id": 23266,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 26,
   "firman": "Aku berkata kepadamu: Sesungguhnya engkau tidak akan keluar dari sana, sebelum engkau membayar hutangmu sampai lunas."
 },
 {
   "id": 23267,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 27,
   "firman": "Kamu telah mendengar firman: Jangan berzinah."
 },
 {
   "id": 23268,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 28,
   "firman": "Tetapi Aku berkata kepadamu: Setiap orang yang memandang perempuan serta menginginkannya, sudah berzinah dengan dia di dalam hatinya."
 },
 {
   "id": 23269,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 29,
   "firman": "Maka jika matamu yang kanan menyesatkan engkau, cungkillah dan buanglah itu, karena lebih baik bagimu jika satu dari anggota tubuhmu binasa, dari pada tubuhmu dengan utuh dicampakkan ke dalam neraka."
 },
 {
   "id": 23270,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 30,
   "firman": "Dan jika tanganmu yang kanan menyesatkan engkau, penggallah dan buanglah itu, karena lebih baik bagimu jika satu dari anggota tubuhmu binasa dari pada tubuhmu dengan utuh masuk neraka."
 },
 {
   "id": 23271,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 31,
   "firman": "Telah difirmankan juga: Siapa yang menceraikan isterinya harus memberi surat cerai kepadanya."
 },
 {
   "id": 23272,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 32,
   "firman": "Tetapi Aku berkata kepadamu: Setiap orang yang menceraikan isterinya kecuali karena zinah, ia menjadikan isterinya berzinah; dan siapa yang kawin dengan perempuan yang diceraikan, ia berbuat zinah."
 },
 {
   "id": 23273,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 33,
   "firman": "Kamu telah mendengar pula yang difirmankan kepada nenek moyang kita: Jangan bersumpah palsu, melainkan peganglah sumpahmu di depan Tuhan."
 },
 {
   "id": 23274,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 34,
   "firman": "Tetapi Aku berkata kepadamu: Janganlah sekali-kali bersumpah, baik demi langit, karena langit adalah takhta Allah,"
 },
 {
   "id": 23275,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 35,
   "firman": "maupun demi bumi, karena bumi adalah tumpuan kaki-Nya, ataupun demi Yerusalem, karena Yerusalem adalah kota Raja Besar;"
 },
 {
   "id": 23276,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 36,
   "firman": "janganlah juga engkau bersumpah demi kepalamu, karena engkau tidak berkuasa memutihkan atau menghitamkan sehelai rambutpun."
 },
 {
   "id": 23277,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 37,
   "firman": "Jika ya, hendaklah kamu katakan: ya, jika tidak, hendaklah kamu katakan: tidak. Apa yang lebih dari pada itu berasal dari si jahat."
 },
 {
   "id": 23278,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 38,
   "firman": "Kamu telah mendengar firman: Mata ganti mata dan gigi ganti gigi."
 },
 {
   "id": 23279,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 39,
   "firman": "Tetapi Aku berkata kepadamu: Janganlah kamu melawan orang yang berbuat jahat kepadamu, melainkan siapapun yang menampar pipi kananmu, berilah juga kepadanya pipi kirimu."
 },
 {
   "id": 23280,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 40,
   "firman": "Dan kepada orang yang hendak mengadukan engkau karena mengingini bajumu, serahkanlah juga jubahmu."
 },
 {
   "id": 23281,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 41,
   "firman": "Dan siapapun yang memaksa engkau berjalan sejauh satu mil, berjalanlah bersama dia sejauh dua mil."
 },
 {
   "id": 23282,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 42,
   "firman": "Berilah kepada orang yang meminta kepadamu dan janganlah menolak orang yang mau meminjam dari padamu."
 },
 {
   "id": 23283,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 43,
   "firman": "Kamu telah mendengar firman: Kasihilah sesamamu manusia dan bencilah musuhmu."
 },
 {
   "id": 23284,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 44,
   "firman": "Tetapi Aku berkata kepadamu: Kasihilah musuhmu dan berdoalah bagi mereka yang menganiaya kamu."
 },
 {
   "id": 23285,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 45,
   "firman": "Karena dengan demikianlah kamu menjadi anak-anak Bapamu yang di sorga, yang menerbitkan matahari bagi orang yang jahat dan orang yang baik dan menurunkan hujan bagi orang yang benar dan orang yang tidak benar."
 },
 {
   "id": 23286,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 46,
   "firman": "Apabila kamu mengasihi orang yang mengasihi kamu, apakah upahmu? Bukankah pemungut cukai juga berbuat demikian?"
 },
 {
   "id": 23287,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 47,
   "firman": "Dan apabila kamu hanya memberi salam kepada saudara-saudaramu saja, apakah lebihnya dari pada perbuatan orang lain? Bukankah orang yang tidak mengenal Allahpun berbuat demikian?"
 },
 {
   "id": 23288,
   "kitab": "Mat",
   "pasal": 5,
   "ayat": 48,
   "firman": "Karena itu haruslah kamu sempurna, sama seperti Bapamu yang di sorga adalah sempurna.\""
 },
 {
   "id": 23289,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 1,
   "firman": "\"Ingatlah, jangan kamu melakukan kewajiban agamamu di hadapan orang supaya dilihat mereka, karena jika demikian, kamu tidak beroleh upah dari Bapamu yang di sorga."
 },
 {
   "id": 23290,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 2,
   "firman": "Jadi apabila engkau memberi sedekah, janganlah engkau mencanangkan hal itu, seperti yang dilakukan orang munafik di rumah-rumah ibadat dan di lorong-lorong, supaya mereka dipuji orang. Aku berkata kepadamu: Sesungguhnya mereka sudah mendapat upahnya."
 },
 {
   "id": 23291,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 3,
   "firman": "Tetapi jika engkau memberi sedekah, janganlah diketahui tangan kirimu apa yang diperbuat tangan kananmu."
 },
 {
   "id": 23292,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 4,
   "firman": "Hendaklah sedekahmu itu diberikan dengan tersembunyi, maka Bapamu yang melihat yang tersembunyi akan membalasnya kepadamu.\""
 },
 {
   "id": 23293,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 5,
   "firman": "\"Dan apabila kamu berdoa, janganlah berdoa seperti orang munafik. Mereka suka mengucapkan doanya dengan berdiri dalam rumah-rumah ibadat dan pada tikungan-tikungan jalan raya, supaya mereka dilihat orang. Aku berkata kepadamu: Sesungguhnya mereka sudah mendapat upahnya."
 },
 {
   "id": 23294,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 6,
   "firman": "Tetapi jika engkau berdoa, masuklah ke dalam kamarmu, tutuplah pintu dan berdoalah kepada Bapamu yang ada di tempat tersembunyi. Maka Bapamu yang melihat yang tersembunyi akan membalasnya kepadamu."
 },
 {
   "id": 23295,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 7,
   "firman": "Lagipula dalam doamu itu janganlah kamu bertele-tele seperti kebiasaan orang yang tidak mengenal Allah. Mereka menyangka bahwa karena banyaknya kata-kata doanya akan dikabulkan."
 },
 {
   "id": 23296,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 8,
   "firman": "Jadi janganlah kamu seperti mereka, karena Bapamu mengetahui apa yang kamu perlukan, sebelum kamu minta kepada-Nya."
 },
 {
   "id": 23297,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 9,
   "firman": "Karena itu berdoalah demikian: Bapa kami yang di sorga, Dikuduskanlah nama-Mu,"
 },
 {
   "id": 23298,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 10,
   "firman": "datanglah Kerajaan-Mu, jadilah kehendak-Mu di bumi seperti di sorga."
 },
 {
   "id": 23299,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 11,
   "firman": "Berikanlah kami pada hari ini makanan kami yang secukupnya"
 },
 {
   "id": 23300,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 12,
   "firman": "dan ampunilah kami akan kesalahan kami, seperti kami juga mengampuni orang yang bersalah kepada kami;"
 },
 {
   "id": 23301,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 13,
   "firman": "dan janganlah membawa kami ke dalam pencobaan, tetapi lepaskanlah kami dari pada yang jahat. (Karena Engkaulah yang empunya Kerajaan dan kuasa dan kemuliaan sampai selama-lamanya. Amin.)"
 },
 {
   "id": 23302,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 14,
   "firman": "Karena jikalau kamu mengampuni kesalahan orang, Bapamu yang di sorga akan mengampuni kamu juga."
 },
 {
   "id": 23303,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 15,
   "firman": "Tetapi jikalau kamu tidak mengampuni orang, Bapamu juga tidak akan mengampuni kesalahanmu.\""
 },
 {
   "id": 23304,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 16,
   "firman": "\"Dan apabila kamu berpuasa, janganlah muram mukamu seperti orang munafik. Mereka mengubah air mukanya, supaya orang melihat bahwa mereka sedang berpuasa. Aku berkata kepadamu: Sesungguhnya mereka sudah mendapat upahnya."
 },
 {
   "id": 23305,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 17,
   "firman": "Tetapi apabila engkau berpuasa, minyakilah kepalamu dan cucilah mukamu,"
 },
 {
   "id": 23306,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 18,
   "firman": "supaya jangan dilihat oleh orang bahwa engkau sedang berpuasa, melainkan hanya oleh Bapamu yang ada di tempat tersembunyi. Maka Bapamu yang melihat yang tersembunyi akan membalasnya kepadamu.\""
 },
 {
   "id": 23307,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 19,
   "firman": "\"Janganlah kamu mengumpulkan harta di bumi; di bumi ngengat dan karat merusakkannya dan pencuri membongkar serta mencurinya."
 },
 {
   "id": 23308,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 20,
   "firman": "Tetapi kumpulkanlah bagimu harta di sorga; di sorga ngengat dan karat tidak merusakkannya dan pencuri tidak membongkar serta mencurinya."
 },
 {
   "id": 23309,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 21,
   "firman": "Karena di mana hartamu berada, di situ juga hatimu berada."
 },
 {
   "id": 23310,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 22,
   "firman": "Mata adalah pelita tubuh. Jika matamu baik, teranglah seluruh tubuhmu;"
 },
 {
   "id": 23311,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 23,
   "firman": "jika matamu jahat, gelaplah seluruh tubuhmu. Jadi jika terang yang ada padamu gelap, betapa gelapnya kegelapan itu."
 },
 {
   "id": 23312,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 24,
   "firman": "Tak seorangpun dapat mengabdi kepada dua tuan. Karena jika demikian, ia akan membenci yang seorang dan mengasihi yang lain, atau ia akan setia kepada yang seorang dan tidak mengindahkan yang lain. Kamu tidak dapat mengabdi kepada Allah dan kepada Mamon.\""
 },
 {
   "id": 23313,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 25,
   "firman": "\"Karena itu Aku berkata kepadamu: Janganlah kuatir akan hidupmu, akan apa yang hendak kamu makan atau minum, dan janganlah kuatir pula akan tubuhmu, akan apa yang hendak kamu pakai. Bukankah hidup itu lebih penting dari pada makanan dan tubuh itu lebih penting dari pada pakaian?"
 },
 {
   "id": 23314,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 26,
   "firman": "Pandanglah burung-burung di langit, yang tidak menabur dan tidak menuai dan tidak mengumpulkan bekal dalam lumbung, namun diberi makan oleh Bapamu yang di sorga. Bukankah kamu jauh melebihi burung-burung itu?"
 },
 {
   "id": 23315,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 27,
   "firman": "Siapakah di antara kamu yang karena kekuatirannya dapat menambahkan sehasta saja pada jalan hidupnya?"
 },
 {
   "id": 23316,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 28,
   "firman": "Dan mengapa kamu kuatir akan pakaian? Perhatikanlah bunga bakung di ladang, yang tumbuh tanpa bekerja dan tanpa memintal,"
 },
 {
   "id": 23317,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 29,
   "firman": "namun Aku berkata kepadamu: Salomo dalam segala kemegahannyapun tidak berpakaian seindah salah satu dari bunga itu."
 },
 {
   "id": 23318,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 30,
   "firman": "Jadi jika demikian Allah mendandani rumput di ladang, yang hari ini ada dan besok dibuang ke dalam api, tidakkah Ia akan terlebih lagi mendandani kamu, hai orang yang kurang percaya?"
 },
 {
   "id": 23319,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 31,
   "firman": "Sebab itu janganlah kamu kuatir dan berkata: Apakah yang akan kami makan? Apakah yang akan kami minum? Apakah yang akan kami pakai?"
 },
 {
   "id": 23320,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 32,
   "firman": "Semua itu dicari bangsa-bangsa yang tidak mengenal Allah. Akan tetapi Bapamu yang di sorga tahu, bahwa kamu memerlukan semuanya itu."
 },
 {
   "id": 23321,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 33,
   "firman": "Tetapi carilah dahulu Kerajaan Allah dan kebenarannya, maka semuanya itu akan ditambahkan kepadamu."
 },
 {
   "id": 23322,
   "kitab": "Mat",
   "pasal": 6,
   "ayat": 34,
   "firman": "Sebab itu janganlah kamu kuatir akan hari besok, karena hari besok mempunyai kesusahannya sendiri. Kesusahan sehari cukuplah untuk sehari.\""
 },
 {
   "id": 23323,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 1,
   "firman": "\"Jangan kamu menghakimi, supaya kamu tidak dihakimi."
 },
 {
   "id": 23324,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 2,
   "firman": "Karena dengan penghakiman yang kamu pakai untuk menghakimi, kamu akan dihakimi dan ukuran yang kamu pakai untuk mengukur, akan diukurkan kepadamu."
 },
 {
   "id": 23325,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 3,
   "firman": "Mengapakah engkau melihat selumbar di mata saudaramu, sedangkan balok di dalam matamu tidak engkau ketahui?"
 },
 {
   "id": 23326,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 4,
   "firman": "Bagaimanakah engkau dapat berkata kepada saudaramu: Biarlah aku mengeluarkan selumbar itu dari matamu, padahal ada balok di dalam matamu."
 },
 {
   "id": 23327,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 5,
   "firman": "Hai orang munafik, keluarkanlah dahulu balok dari matamu, maka engkau akan melihat dengan jelas untuk mengeluarkan selumbar itu dari mata saudaramu.\""
 },
 {
   "id": 23328,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 6,
   "firman": "\"Jangan kamu memberikan barang yang kudus kepada anjing dan jangan kamu melemparkan mutiaramu kepada babi, supaya jangan diinjak-injaknya dengan kakinya, lalu ia berbalik mengoyak kamu.\""
 },
 {
   "id": 23329,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 7,
   "firman": "\"Mintalah, maka akan diberikan kepadamu; carilah, maka kamu akan mendapat; ketoklah, maka pintu akan dibukakan bagimu."
 },
 {
   "id": 23330,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 8,
   "firman": "Karena setiap orang yang meminta, menerima dan setiap orang yang mencari, mendapat dan setiap orang yang mengetok, baginya pintu dibukakan."
 },
 {
   "id": 23331,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 9,
   "firman": "Adakah seorang dari padamu yang memberi batu kepada anaknya, jika ia meminta roti,"
 },
 {
   "id": 23332,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 10,
   "firman": "atau memberi ular, jika ia meminta ikan?"
 },
 {
   "id": 23333,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 11,
   "firman": "Jadi jika kamu yang jahat tahu memberi pemberian yang baik kepada anak-anakmu, apalagi Bapamu yang di sorga! Ia akan memberikan yang baik kepada mereka yang meminta kepada-Nya.\""
 },
 {
   "id": 23334,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 12,
   "firman": "\"Segala sesuatu yang kamu kehendaki supaya orang perbuat kepadamu, perbuatlah demikian juga kepada mereka. Itulah isi seluruh hukum Taurat dan kitab para nabi."
 },
 {
   "id": 23335,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 13,
   "firman": "Masuklah melalui pintu yang sesak itu, karena lebarlah pintu dan luaslah jalan yang menuju kepada kebinasaan, dan banyak orang yang masuk melaluinya;"
 },
 {
   "id": 23336,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 14,
   "firman": "karena sesaklah pintu dan sempitlah jalan yang menuju kepada kehidupan, dan sedikit orang yang mendapatinya.\""
 },
 {
   "id": 23337,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 15,
   "firman": "\"Waspadalah terhadap nabi-nabi palsu yang datang kepadamu dengan menyamar seperti domba, tetapi sesungguhnya mereka adalah serigala yang buas."
 },
 {
   "id": 23338,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dari buahnyalah kamu akan mengenal mereka. Dapatkah orang memetik buah anggur dari semak duri atau buah ara dari rumput duri?"
 },
 {
   "id": 23339,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 17,
   "firman": "Demikianlah setiap pohon yang baik menghasilkan buah yang baik, sedang pohon yang tidak baik menghasilkan buah yang tidak baik."
 },
 {
   "id": 23340,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 18,
   "firman": "Tidak mungkin pohon yang baik itu menghasilkan buah yang tidak baik, ataupun pohon yang tidak baik itu menghasilkan buah yang baik."
 },
 {
   "id": 23341,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 19,
   "firman": "Dan setiap pohon yang tidak menghasilkan buah yang baik, pasti ditebang dan dibuang ke dalam api."
 },
 {
   "id": 23342,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 20,
   "firman": "Jadi dari buahnyalah kamu akan mengenal mereka."
 },
 {
   "id": 23343,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 21,
   "firman": "Bukan setiap orang yang berseru kepada-Ku: Tuhan, Tuhan! akan masuk ke dalam Kerajaan Sorga, melainkan dia yang melakukan kehendak Bapa-Ku yang di sorga."
 },
 {
   "id": 23344,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 22,
   "firman": "Pada hari terakhir banyak orang akan berseru kepada-Ku: Tuhan, Tuhan, bukankah kami bernubuat demi nama-Mu, dan mengusir setan demi nama-Mu, dan mengadakan banyak mujizat demi nama-Mu juga?"
 },
 {
   "id": 23345,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 23,
   "firman": "Pada waktu itulah Aku akan berterus terang kepada mereka dan berkata: Aku tidak pernah mengenal kamu! Enyahlah dari pada-Ku, kamu sekalian pembuat kejahatan!\""
 },
 {
   "id": 23346,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 24,
   "firman": "\"Setiap orang yang mendengar perkataan-Ku ini dan melakukannya, ia sama dengan orang yang bijaksana, yang mendirikan rumahnya di atas batu."
 },
 {
   "id": 23347,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 25,
   "firman": "Kemudian turunlah hujan dan datanglah banjir, lalu angin melanda rumah itu, tetapi rumah itu tidak rubuh sebab didirikan di atas batu."
 },
 {
   "id": 23348,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 26,
   "firman": "Tetapi setiap orang yang mendengar perkataan-Ku ini dan tidak melakukannya, ia sama dengan orang yang bodoh, yang mendirikan rumahnya di atas pasir."
 },
 {
   "id": 23349,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 27,
   "firman": "Kemudian turunlah hujan dan datanglah banjir, lalu angin melanda rumah itu, sehingga rubuhlah rumah itu dan hebatlah kerusakannya.\""
 },
 {
   "id": 23350,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 28,
   "firman": "Dan setelah Yesus mengakhiri perkataan ini, takjublah orang banyak itu mendengar pengajaran-Nya,"
 },
 {
   "id": 23351,
   "kitab": "Mat",
   "pasal": 7,
   "ayat": 29,
   "firman": "sebab Ia mengajar mereka sebagai orang yang berkuasa, tidak seperti ahli-ahli Taurat mereka."
 },
 {
   "id": 23352,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 1,
   "firman": "Setelah Yesus turun dari bukit, orang banyak berbondong-bondong mengikuti Dia."
 },
 {
   "id": 23353,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 2,
   "firman": "Maka datanglah seorang yang sakit kusta kepada-Nya, lalu sujud menyembah Dia dan berkata: \"Tuan, jika Tuan mau, Tuan dapat mentahirkan aku.\""
 },
 {
   "id": 23354,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 3,
   "firman": "Lalu Yesus mengulurkan tangan-Nya, menjamah orang itu dan berkata: \"Aku mau, jadilah engkau tahir.\" Seketika itu juga tahirlah orang itu dari pada kustanya."
 },
 {
   "id": 23355,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 4,
   "firman": "Lalu Yesus berkata kepadanya: \"Ingatlah, jangan engkau memberitahukan hal ini kepada siapapun, tetapi pergilah, perlihatkanlah dirimu kepada imam dan persembahkanlah persembahan yang diperintahkan Musa, sebagai bukti bagi mereka.\""
 },
 {
   "id": 23356,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 5,
   "firman": "Ketika Yesus masuk ke Kapernaum, datanglah seorang perwira mendapatkan Dia dan memohon kepada-Nya:"
 },
 {
   "id": 23357,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 6,
   "firman": "\"Tuan, hambaku terbaring di rumah karena sakit lumpuh dan ia sangat menderita.\""
 },
 {
   "id": 23358,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 7,
   "firman": "Yesus berkata kepadanya: \"Aku akan datang menyembuhkannya.\""
 },
 {
   "id": 23359,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 8,
   "firman": "Tetapi jawab perwira itu kepada-Nya: \"Tuan, aku tidak layak menerima Tuan di dalam rumahku, katakan saja sepatah kata, maka hambaku itu akan sembuh."
 },
 {
   "id": 23360,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 9,
   "firman": "Sebab aku sendiri seorang bawahan, dan di bawahku ada pula prajurit. Jika aku berkata kepada salah seorang prajurit itu: Pergi!, maka ia pergi, dan kepada seorang lagi: Datang!, maka ia datang, ataupun kepada hambaku: Kerjakanlah ini!, maka ia mengerjakannya.\""
 },
 {
   "id": 23361,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 10,
   "firman": "Setelah Yesus mendengar hal itu, heranlah Ia dan berkata kepada mereka yang mengikuti-Nya: \"Aku berkata kepadamu, sesungguhnya iman sebesar ini tidak pernah Aku jumpai pada seorangpun di antara orang Israel."
 },
 {
   "id": 23362,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 11,
   "firman": "Aku berkata kepadamu: Banyak orang akan datang dari Timur dan Barat dan duduk makan bersama-sama dengan Abraham, Ishak dan Yakub di dalam Kerajaan Sorga,"
 },
 {
   "id": 23363,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 12,
   "firman": "sedangkan anak-anak Kerajaan itu akan dicampakkan ke dalam kegelapan yang paling gelap, di sanalah akan terdapat ratap dan kertak gigi.\""
 },
 {
   "id": 23364,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 13,
   "firman": "Lalu Yesus berkata kepada perwira itu: \"Pulanglah dan jadilah kepadamu seperti yang engkau percaya.\" Maka pada saat itu juga sembuhlah hambanya."
 },
 {
   "id": 23365,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 14,
   "firman": "Setibanya di rumah Petrus, Yesuspun melihat ibu mertua Petrus terbaring karena sakit demam."
 },
 {
   "id": 23366,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 15,
   "firman": "Maka dipegang-Nya tangan perempuan itu, lalu lenyaplah demamnya. Iapun bangunlah dan melayani Dia."
 },
 {
   "id": 23367,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 16,
   "firman": "Menjelang malam dibawalah kepada Yesus banyak orang yang kerasukan setan dan dengan sepatah kata Yesus mengusir roh-roh itu dan menyembuhkan orang-orang yang menderita sakit."
 },
 {
   "id": 23368,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 17,
   "firman": "Hal itu terjadi supaya genaplah firman yang disampaikan oleh nabi Yesaya: \"Dialah yang memikul kelemahan kita dan menanggung penyakit kita.\""
 },
 {
   "id": 23369,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 18,
   "firman": "Ketika Yesus melihat orang banyak mengelilingi-Nya, Ia menyuruh bertolak ke seberang."
 },
 {
   "id": 23370,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 19,
   "firman": "Lalu datanglah seorang ahli Taurat dan berkata kepada-Nya: \"Guru, aku akan mengikut Engkau, ke mana saja Engkau pergi.\""
 },
 {
   "id": 23371,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 20,
   "firman": "Yesus berkata kepadanya: \"Serigala mempunyai liang dan burung mempunyai sarang, tetapi Anak Manusia tidak mempunyai tempat untuk meletakkan kepala-Nya.\""
 },
 {
   "id": 23372,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 21,
   "firman": "Seorang lain, yaitu salah seorang murid-Nya, berkata kepada-Nya: \"Tuhan, izinkanlah aku pergi dahulu menguburkan ayahku.\""
 },
 {
   "id": 23373,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 22,
   "firman": "Tetapi Yesus berkata kepadanya: \"Ikutlah Aku dan biarlah orang-orang mati menguburkan orang-orang mati mereka.\""
 },
 {
   "id": 23374,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 23,
   "firman": "Lalu Yesus naik ke dalam perahu dan murid-murid-Nyapun mengikuti-Nya."
 },
 {
   "id": 23375,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 24,
   "firman": "Sekonyong-konyong mengamuklah angin ribut di danau itu, sehingga perahu itu ditimbus gelombang, tetapi Yesus tidur."
 },
 {
   "id": 23376,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 25,
   "firman": "Maka datanglah murid-murid-Nya membangunkan Dia, katanya: \"Tuhan, tolonglah, kita binasa.\""
 },
 {
   "id": 23377,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 26,
   "firman": "Ia berkata kepada mereka: \"Mengapa kamu takut, kamu yang kurang percaya?\" Lalu bangunlah Yesus menghardik angin dan danau itu, maka danau itu menjadi teduh sekali."
 },
 {
   "id": 23378,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 27,
   "firman": "Dan heranlah orang-orang itu, katanya: \"Orang apakah Dia ini, sehingga angin dan danaupun taat kepada-Nya?\""
 },
 {
   "id": 23379,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 28,
   "firman": "Setibanya di seberang, yaitu di daerah orang Gadara, datanglah dari pekuburan dua orang yang kerasukan setan menemui Yesus. Mereka sangat berbahaya, sehingga tidak seorangpun yang berani melalui jalan itu."
 },
 {
   "id": 23380,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 29,
   "firman": "Dan mereka itupun berteriak, katanya: \"Apa urusan-Mu dengan kami, hai Anak Allah? Adakah Engkau ke mari untuk menyiksa kami sebelum waktunya?\""
 },
 {
   "id": 23381,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 30,
   "firman": "Tidak jauh dari mereka itu sejumlah besar babi sedang mencari makan."
 },
 {
   "id": 23382,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 31,
   "firman": "Maka setan-setan itu meminta kepada-Nya, katanya: \"Jika Engkau mengusir kami, suruhlah kami pindah ke dalam kawanan babi itu.\""
 },
 {
   "id": 23383,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 32,
   "firman": "Yesus berkata kepada mereka: \"Pergilah!\" Lalu keluarlah mereka dan masuk ke dalam babi-babi itu. Maka terjunlah seluruh kawanan babi itu dari tepi jurang ke dalam danau dan mati di dalam air."
 },
 {
   "id": 23384,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 33,
   "firman": "Maka larilah penjaga-penjaga babi itu dan setibanya di kota, diceriterakannyalah segala sesuatu, juga tentang orang-orang yang kerasukan setan itu."
 },
 {
   "id": 23385,
   "kitab": "Mat",
   "pasal": 8,
   "ayat": 34,
   "firman": "Maka keluarlah seluruh kota mendapatkan Yesus dan setelah mereka berjumpa dengan Dia, merekapun mendesak, supaya Ia meninggalkan daerah mereka."
 },
 {
   "id": 23386,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 1,
   "firman": "Sesudah itu naiklah Yesus ke dalam perahu lalu menyeberang. Kemudian sampailah Ia ke kota-Nya sendiri."
 },
 {
   "id": 23387,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 2,
   "firman": "Maka dibawa oranglah kepada-Nya seorang lumpuh yang terbaring di tempat tidurnya. Ketika Yesus melihat iman mereka, berkatalah Ia kepada orang lumpuh itu: \"Percayalah, hai anak-Ku, dosamu sudah diampuni.\""
 },
 {
   "id": 23388,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 3,
   "firman": "Maka berkatalah beberapa orang ahli Taurat dalam hatinya: \"Ia menghujat Allah.\""
 },
 {
   "id": 23389,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 4,
   "firman": "Tetapi Yesus mengetahui pikiran mereka, lalu berkata: \"Mengapa kamu memikirkan hal-hal yang jahat di dalam hatimu?"
 },
 {
   "id": 23390,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 5,
   "firman": "Manakah lebih mudah, mengatakan: Dosamu sudah diampuni, atau mengatakan: Bangunlah dan berjalanlah?"
 },
 {
   "id": 23391,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 6,
   "firman": "Tetapi supaya kamu tahu, bahwa di dunia ini Anak Manusia berkuasa mengampuni dosa\" --lalu berkatalah Ia kepada orang lumpuh itu--:\"Bangunlah, angkatlah tempat tidurmu dan pulanglah ke rumahmu!\""
 },
 {
   "id": 23392,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 7,
   "firman": "Dan orang itupun bangun lalu pulang."
 },
 {
   "id": 23393,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 8,
   "firman": "Maka orang banyak yang melihat hal itu takut lalu memuliakan Allah yang telah memberikan kuasa sedemikian itu kepada manusia."
 },
 {
   "id": 23394,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 9,
   "firman": "Setelah Yesus pergi dari situ, Ia melihat seorang yang bernama Matius duduk di rumah cukai, lalu Ia berkata kepadanya: \"Ikutlah Aku.\" Maka berdirilah Matius lalu mengikut Dia."
 },
 {
   "id": 23395,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 10,
   "firman": "Kemudian ketika Yesus makan di rumah Matius, datanglah banyak pemungut cukai dan orang berdosa dan makan bersama-sama dengan Dia dan murid-murid-Nya."
 },
 {
   "id": 23396,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 11,
   "firman": "Pada waktu orang Farisi melihat hal itu, berkatalah mereka kepada murid-murid Yesus: \"Mengapa gurumu makan bersama-sama dengan pemungut cukai dan orang berdosa?\""
 },
 {
   "id": 23397,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 12,
   "firman": "Yesus mendengarnya dan berkata: \"Bukan orang sehat yang memerlukan tabib, tetapi orang sakit."
 },
 {
   "id": 23398,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 13,
   "firman": "Jadi pergilah dan pelajarilah arti firman ini: Yang Kukehendaki ialah belas kasihan dan bukan persembahan, karena Aku datang bukan untuk memanggil orang benar, melainkan orang berdosa.\""
 },
 {
   "id": 23399,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 14,
   "firman": "Kemudian datanglah murid-murid Yohanes kepada Yesus dan berkata: \"Mengapa kami dan orang Farisi berpuasa, tetapi murid-murid-Mu tidak?\""
 },
 {
   "id": 23400,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 15,
   "firman": "Jawab Yesus kepada mereka: \"Dapatkah sahabat-sahabat mempelai laki-laki berdukacita selama mempelai itu bersama mereka? Tetapi waktunya akan datang mempelai itu diambil dari mereka dan pada waktu itulah mereka akan berpuasa."
 },
 {
   "id": 23401,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 16,
   "firman": "Tidak seorangpun menambalkan secarik kain yang belum susut pada baju yang tua, karena jika demikian kain penambal itu akan mencabik baju itu, lalu makin besarlah koyaknya."
 },
 {
   "id": 23402,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 17,
   "firman": "Begitu pula anggur yang baru tidak diisikan ke dalam kantong kulit yang tua, karena jika demikian kantong itu akan koyak sehingga anggur itu terbuang dan kantong itupun hancur. Tetapi anggur yang baru disimpan orang dalam kantong yang baru pula, dan dengan demikian terpeliharalah kedua-duanya.\""
 },
 {
   "id": 23403,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 18,
   "firman": "Sementara Yesus berbicara demikian kepada mereka, datanglah seorang kepala rumah ibadat, lalu menyembah Dia dan berkata: \"Anakku perempuan baru saja meninggal, tetapi datanglah dan letakkanlah tangan-Mu atasnya, maka ia akan hidup.\""
 },
 {
   "id": 23404,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 19,
   "firman": "Lalu Yesuspun bangunlah dan mengikuti orang itu bersama-sama dengan murid-murid-Nya."
 },
 {
   "id": 23405,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 20,
   "firman": "Pada waktu itu seorang perempuan yang sudah dua belas tahun lamanya menderita pendarahan maju mendekati Yesus dari belakang dan menjamah jumbai jubah-Nya."
 },
 {
   "id": 23406,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 21,
   "firman": "Karena katanya dalam hatinya: \"Asal kujamah saja jubah-Nya, aku akan sembuh.\""
 },
 {
   "id": 23407,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 22,
   "firman": "Tetapi Yesus berpaling dan memandang dia serta berkata: \"Teguhkanlah hatimu, hai anak-Ku, imanmu telah menyelamatkan engkau.\" Maka sejak saat itu sembuhlah perempuan itu."
 },
 {
   "id": 23408,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 23,
   "firman": "Ketika Yesus tiba di rumah kepala rumah ibadat itu dan melihat peniup-peniup seruling dan orang banyak ribut,"
 },
 {
   "id": 23409,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 24,
   "firman": "berkatalah Ia: \"Pergilah, karena anak ini tidak mati, tetapi tidur.\" Tetapi mereka menertawakan Dia."
 },
 {
   "id": 23410,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 25,
   "firman": "Setelah orang banyak itu diusir, Yesus masuk dan memegang tangan anak itu, lalu bangkitlah anak itu."
 },
 {
   "id": 23411,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 26,
   "firman": "Maka tersiarlah kabar tentang hal itu ke seluruh daerah itu."
 },
 {
   "id": 23412,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 27,
   "firman": "Ketika Yesus meneruskan perjalanan-Nya dari sana, dua orang buta mengikuti-Nya sambil berseru-seru dan berkata: \"Kasihanilah kami, hai Anak Daud.\""
 },
 {
   "id": 23413,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 28,
   "firman": "Setelah Yesus masuk ke dalam sebuah rumah, datanglah kedua orang buta itu kepada-Nya dan Yesus berkata kepada mereka: \"Percayakah kamu, bahwa Aku dapat melakukannya?\" Mereka menjawab: \"Ya Tuhan, kami percaya.\""
 },
 {
   "id": 23414,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 29,
   "firman": "Lalu Yesus menjamah mata mereka sambil berkata: \"Jadilah kepadamu menurut imanmu.\""
 },
 {
   "id": 23415,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 30,
   "firman": "Maka meleklah mata mereka. Dan Yesuspun dengan tegas berpesan kepada mereka, kata-Nya: \"Jagalah supaya jangan seorangpun mengetahui hal ini.\""
 },
 {
   "id": 23416,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 31,
   "firman": "Tetapi mereka keluar dan memasyhurkan Dia ke seluruh daerah itu."
 },
 {
   "id": 23417,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 32,
   "firman": "Sedang kedua orang buta itu keluar, dibawalah kepada Yesus seorang bisu yang kerasukan setan."
 },
 {
   "id": 23418,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 33,
   "firman": "Dan setelah setan itu diusir, dapatlah orang bisu itu berkata-kata. Maka heranlah orang banyak, katanya: \"Yang demikian belum pernah dilihat orang di Israel.\""
 },
 {
   "id": 23419,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 34,
   "firman": "Tetapi orang Farisi berkata: \"Dengan kuasa penghulu setan Ia mengusir setan.\""
 },
 {
   "id": 23420,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 35,
   "firman": "Demikianlah Yesus berkeliling ke semua kota dan desa; Ia mengajar dalam rumah-rumah ibadat dan memberitakan Injil Kerajaan Sorga serta melenyapkan segala penyakit dan kelemahan."
 },
 {
   "id": 23421,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 36,
   "firman": "Melihat orang banyak itu, tergeraklah hati Yesus oleh belas kasihan kepada mereka, karena mereka lelah dan terlantar seperti domba yang tidak bergembala."
 },
 {
   "id": 23422,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 37,
   "firman": "Maka kata-Nya kepada murid-murid-Nya: \"Tuaian memang banyak, tetapi pekerja sedikit."
 },
 {
   "id": 23423,
   "kitab": "Mat",
   "pasal": 9,
   "ayat": 38,
   "firman": "Karena itu mintalah kepada tuan yang empunya tuaian, supaya Ia mengirimkan pekerja-pekerja untuk tuaian itu.\""
 },
 {
   "id": 23424,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 1,
   "firman": "Yesus memanggil kedua belas murid-Nya dan memberi kuasa kepada mereka untuk mengusir roh-roh jahat dan untuk melenyapkan segala penyakit dan segala kelemahan."
 },
 {
   "id": 23425,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 2,
   "firman": "Inilah nama kedua belas rasul itu: Pertama Simon yang disebut Petrus dan Andreas saudaranya, dan Yakobus anak Zebedeus dan Yohanes saudaranya,"
 },
 {
   "id": 23426,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 3,
   "firman": "Filipus dan Bartolomeus, Tomas dan Matius pemungut cukai, Yakobus anak Alfeus, dan Tadeus,"
 },
 {
   "id": 23427,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 4,
   "firman": "Simon orang Zelot dan Yudas Iskariot yang mengkhianati Dia."
 },
 {
   "id": 23428,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 5,
   "firman": "Kedua belas murid itu diutus oleh Yesus dan Ia berpesan kepada mereka: \"Janganlah kamu menyimpang ke jalan bangsa lain atau masuk ke dalam kota orang Samaria,"
 },
 {
   "id": 23429,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 6,
   "firman": "melainkan pergilah kepada domba-domba yang hilang dari umat Israel."
 },
 {
   "id": 23430,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 7,
   "firman": "Pergilah dan beritakanlah: Kerajaan Sorga sudah dekat."
 },
 {
   "id": 23431,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 8,
   "firman": "Sembuhkanlah orang sakit; bangkitkanlah orang mati; tahirkanlah orang kusta; usirlah setan-setan. Kamu telah memperolehnya dengan cuma-cuma, karena itu berikanlah pula dengan cuma-cuma."
 },
 {
   "id": 23432,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 9,
   "firman": "Janganlah kamu membawa emas atau perak atau tembaga dalam ikat pinggangmu."
 },
 {
   "id": 23433,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 10,
   "firman": "Janganlah kamu membawa bekal dalam perjalanan, janganlah kamu membawa baju dua helai, kasut atau tongkat, sebab seorang pekerja patut mendapat upahnya."
 },
 {
   "id": 23434,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 11,
   "firman": "Apabila kamu masuk kota atau desa, carilah di situ seorang yang layak dan tinggallah padanya sampai kamu berangkat."
 },
 {
   "id": 23435,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 12,
   "firman": "Apabila kamu masuk rumah orang, berilah salam kepada mereka."
 },
 {
   "id": 23436,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 13,
   "firman": "Jika mereka layak menerimanya, salammu itu turun ke atasnya, jika tidak, salammu itu kembali kepadamu."
 },
 {
   "id": 23437,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 14,
   "firman": "Dan apabila seorang tidak menerima kamu dan tidak mendengar perkataanmu, keluarlah dan tinggalkanlah rumah atau kota itu dan kebaskanlah debunya dari kakimu."
 },
 {
   "id": 23438,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 15,
   "firman": "Aku berkata kepadamu: Sesungguhnya pada hari penghakiman tanah Sodom dan Gomora akan lebih ringan tanggungannya dari pada kota itu.\""
 },
 {
   "id": 23439,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 16,
   "firman": "\"Lihat, Aku mengutus kamu seperti domba ke tengah-tengah serigala, sebab itu hendaklah kamu cerdik seperti ular dan tulus seperti merpati."
 },
 {
   "id": 23440,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 17,
   "firman": "Tetapi waspadalah terhadap semua orang; karena ada yang akan menyerahkan kamu kepada majelis agama dan mereka akan menyesah kamu di rumah ibadatnya."
 },
 {
   "id": 23441,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 18,
   "firman": "Dan karena Aku, kamu akan digiring ke muka penguasa-penguasa dan raja-raja sebagai suatu kesaksian bagi mereka dan bagi orang-orang yang tidak mengenal Allah."
 },
 {
   "id": 23442,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 19,
   "firman": "Apabila mereka menyerahkan kamu, janganlah kamu kuatir akan bagaimana dan akan apa yang harus kamu katakan, karena semuanya itu akan dikaruniakan kepadamu pada saat itu juga."
 },
 {
   "id": 23443,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 20,
   "firman": "Karena bukan kamu yang berkata-kata, melainkan Roh Bapamu; Dia yang akan berkata-kata di dalam kamu."
 },
 {
   "id": 23444,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 21,
   "firman": "Orang akan menyerahkan saudaranya untuk dibunuh, demikian juga seorang ayah akan anaknya. Dan anak-anak akan memberontak terhadap orang tuanya dan akan membunuh mereka."
 },
 {
   "id": 23445,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 22,
   "firman": "Dan kamu akan dibenci semua orang oleh karena nama-Ku; tetapi orang yang bertahan sampai pada kesudahannya akan selamat."
 },
 {
   "id": 23446,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 23,
   "firman": "Apabila mereka menganiaya kamu dalam kota yang satu, larilah ke kota yang lain; karena Aku berkata kepadamu: Sesungguhnya sebelum kamu selesai mengunjungi kota-kota Israel, Anak Manusia sudah datang."
 },
 {
   "id": 23447,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 24,
   "firman": "Seorang murid tidak lebih dari pada gurunya, atau seorang hamba dari pada tuannya."
 },
 {
   "id": 23448,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 25,
   "firman": "Cukuplah bagi seorang murid jika ia menjadi sama seperti gurunya dan bagi seorang hamba jika ia menjadi sama seperti tuannya. Jika tuan rumah disebut Beelzebul, apalagi seisi rumahnya."
 },
 {
   "id": 23449,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 26,
   "firman": "Jadi janganlah kamu takut terhadap mereka, karena tidak ada sesuatupun yang tertutup yang tidak akan dibuka dan tidak ada sesuatupun yang tersembunyi yang tidak akan diketahui."
 },
 {
   "id": 23450,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 27,
   "firman": "Apa yang Kukatakan kepadamu dalam gelap, katakanlah itu dalam terang; dan apa yang dibisikkan ke telingamu, beritakanlah itu dari atas atap rumah."
 },
 {
   "id": 23451,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 28,
   "firman": "Dan janganlah kamu takut kepada mereka yang dapat membunuh tubuh, tetapi yang tidak berkuasa membunuh jiwa; takutlah terutama kepada Dia yang berkuasa membinasakan baik jiwa maupun tubuh di dalam neraka."
 },
 {
   "id": 23452,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 29,
   "firman": "Bukankah burung pipit dijual dua ekor seduit? Namun seekorpun dari padanya tidak akan jatuh ke bumi di luar kehendak Bapamu."
 },
 {
   "id": 23453,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 30,
   "firman": "Dan kamu, rambut kepalamupun terhitung semuanya."
 },
 {
   "id": 23454,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 31,
   "firman": "Sebab itu janganlah kamu takut, karena kamu lebih berharga dari pada banyak burung pipit."
 },
 {
   "id": 23455,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 32,
   "firman": "Setiap orang yang mengakui Aku di depan manusia, Aku juga akan mengakuinya di depan Bapa-Ku yang di sorga."
 },
 {
   "id": 23456,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 33,
   "firman": "Tetapi barangsiapa menyangkal Aku di depan manusia, Aku juga akan menyangkalnya di depan Bapa-Ku yang di sorga.\""
 },
 {
   "id": 23457,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 34,
   "firman": "\"Jangan kamu menyangka, bahwa Aku datang untuk membawa damai di atas bumi; Aku datang bukan untuk membawa damai, melainkan pedang."
 },
 {
   "id": 23458,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 35,
   "firman": "Sebab Aku datang untuk memisahkan orang dari ayahnya, anak perempuan dari ibunya, menantu perempuan dari ibu mertuanya,"
 },
 {
   "id": 23459,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 36,
   "firman": "dan musuh orang ialah orang-orang seisi rumahnya."
 },
 {
   "id": 23460,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 37,
   "firman": "Barangsiapa mengasihi bapa atau ibunya lebih dari pada-Ku, ia tidak layak bagi-Ku; dan barangsiapa mengasihi anaknya laki-laki atau perempuan lebih dari pada-Ku, ia tidak layak bagi-Ku."
 },
 {
   "id": 23461,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 38,
   "firman": "Barangsiapa tidak memikul salibnya dan mengikut Aku, ia tidak layak bagi-Ku."
 },
 {
   "id": 23462,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 39,
   "firman": "Barangsiapa mempertahankan nyawanya, ia akan kehilangan nyawanya, dan barangsiapa kehilangan nyawanya karena Aku, ia akan memperolehnya."
 },
 {
   "id": 23463,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 40,
   "firman": "Barangsiapa menyambut kamu, ia menyambut Aku, dan barangsiapa menyambut Aku, ia menyambut Dia yang mengutus Aku."
 },
 {
   "id": 23464,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 41,
   "firman": "Barangsiapa menyambut seorang nabi sebagai nabi, ia akan menerima upah nabi, dan barangsiapa menyambut seorang benar sebagai orang benar, ia akan menerima upah orang benar."
 },
 {
   "id": 23465,
   "kitab": "Mat",
   "pasal": 10,
   "ayat": 42,
   "firman": "Dan barangsiapa memberi air sejuk secangkir sajapun kepada salah seorang yang kecil ini, karena ia murid-Ku, Aku berkata kepadamu: Sesungguhnya ia tidak akan kehilangan upahnya dari padanya.\""
 },
 {
   "id": 23466,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 1,
   "firman": "Setelah Yesus selesai berpesan kepada kedua belas murid-Nya, pergilah Ia dari sana untuk mengajar dan memberitakan Injil di dalam kota-kota mereka."
 },
 {
   "id": 23467,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 2,
   "firman": "Di dalam penjara Yohanes mendengar tentang pekerjaan Kristus,"
 },
 {
   "id": 23468,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 3,
   "firman": "lalu menyuruh murid-muridnya bertanya kepada-Nya: \"Engkaukah yang akan datang itu atau haruskah kami menantikan orang lain?\""
 },
 {
   "id": 23469,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 4,
   "firman": "Yesus menjawab mereka: \"Pergilah dan katakanlah kepada Yohanes apa yang kamu dengar dan kamu lihat:"
 },
 {
   "id": 23470,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 5,
   "firman": "orang buta melihat, orang lumpuh berjalan, orang kusta menjadi tahir, orang tuli mendengar, orang mati dibangkitkan dan kepada orang miskin diberitakan kabar baik."
 },
 {
   "id": 23471,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 6,
   "firman": "Dan berbahagialah orang yang tidak menjadi kecewa dan menolak Aku.\""
 },
 {
   "id": 23472,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 7,
   "firman": "Setelah murid-murid Yohanes pergi, mulailah Yesus berbicara kepada orang banyak itu tentang Yohanes: \"Untuk apakah kamu pergi ke padang gurun? Melihat buluh yang digoyangkan angin kian ke mari?"
 },
 {
   "id": 23473,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 8,
   "firman": "Atau untuk apakah kamu pergi? Melihat orang yang berpakaian halus? Orang yang berpakaian halus itu tempatnya di istana raja."
 },
 {
   "id": 23474,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 9,
   "firman": "Jadi untuk apakah kamu pergi? Melihat nabi? Benar, dan Aku berkata kepadamu, bahkan lebih dari pada nabi."
 },
 {
   "id": 23475,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 10,
   "firman": "Karena tentang dia ada tertulis: Lihatlah, Aku menyuruh utusan-Ku mendahului Engkau, ia akan mempersiapkan jalan-Mu di hadapan-Mu."
 },
 {
   "id": 23476,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 11,
   "firman": "Aku berkata kepadamu: Sesungguhnya di antara mereka yang dilahirkan oleh perempuan tidak pernah tampil seorang yang lebih besar dari pada Yohanes Pembaptis, namun yang terkecil dalam Kerajaan Sorga lebih besar dari padanya."
 },
 {
   "id": 23477,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 12,
   "firman": "Sejak tampilnya Yohanes Pembaptis hingga sekarang, Kerajaan Sorga diserong dan orang yang menyerongnya mencoba menguasainya."
 },
 {
   "id": 23478,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 13,
   "firman": "Sebab semua nabi dan kitab Taurat bernubuat hingga tampilnya Yohanes"
 },
 {
   "id": 23479,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 14,
   "firman": "dan--jika kamu mau menerimanya--ialah Elia yang akan datang itu."
 },
 {
   "id": 23480,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 15,
   "firman": "Siapa bertelinga, hendaklah ia mendengar!"
 },
 {
   "id": 23481,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 16,
   "firman": "Dengan apakah akan Kuumpamakan angkatan ini? Mereka itu seumpama anak-anak yang duduk di pasar dan berseru kepada teman-temannya:"
 },
 {
   "id": 23482,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 17,
   "firman": "Kami meniup seruling bagimu, tetapi kamu tidak menari, kami menyanyikan kidung duka, tetapi kamu tidak berkabung."
 },
 {
   "id": 23483,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 18,
   "firman": "Karena Yohanes datang, ia tidak makan, dan tidak minum, dan mereka berkata: Ia kerasukan setan."
 },
 {
   "id": 23484,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 19,
   "firman": "Kemudian Anak Manusia datang, Ia makan dan minum, dan mereka berkata: Lihatlah, Ia seorang pelahap dan peminum, sahabat pemungut cukai dan orang berdosa. Tetapi hikmat Allah dibenarkan oleh perbuatannya.\""
 },
 {
   "id": 23485,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 20,
   "firman": "Lalu Yesus mulai mengecam kota-kota yang tidak bertobat, sekalipun di situ Ia paling banyak melakukan mujizat-mujizat-Nya:"
 },
 {
   "id": 23486,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 21,
   "firman": "\"Celakalah engkau Khorazim! Celakalah engkau Betsaida! Karena jika di Tirus dan di Sidon terjadi mujizat-mujizat yang telah terjadi di tengah-tengah kamu, sudah lama mereka bertobat dan berkabung."
 },
 {
   "id": 23487,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 22,
   "firman": "Tetapi Aku berkata kepadamu: Pada hari penghakiman, tanggungan Tirus dan Sidon akan lebih ringan dari pada tanggunganmu."
 },
 {
   "id": 23488,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 23,
   "firman": "Dan engkau Kapernaum, apakah engkau akan dinaikkan sampai ke langit? Tidak, engkau akan diturunkan sampai ke dunia orang mati! Karena jika di Sodom terjadi mujizat-mujizat yang telah terjadi di tengah-tengah kamu, kota itu tentu masih berdiri sampai hari ini."
 },
 {
   "id": 23489,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 24,
   "firman": "Tetapi Aku berkata kepadamu: Pada hari penghakiman, tanggungan negeri Sodom akan lebih ringan dari pada tanggunganmu.\""
 },
 {
   "id": 23490,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 25,
   "firman": "Pada waktu itu berkatalah Yesus: \"Aku bersyukur kepada-Mu, Bapa, Tuhan langit dan bumi, karena semuanya itu Engkau sembunyikan bagi orang bijak dan orang pandai, tetapi Engkau nyatakan kepada orang kecil."
 },
 {
   "id": 23491,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 26,
   "firman": "Ya Bapa, itulah yang berkenan kepada-Mu."
 },
 {
   "id": 23492,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 27,
   "firman": "Semua telah diserahkan kepada-Ku oleh Bapa-Ku dan tidak seorangpun mengenal Anak selain Bapa, dan tidak seorangpun mengenal Bapa selain Anak dan orang yang kepadanya Anak itu berkenan menyatakannya."
 },
 {
   "id": 23493,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 28,
   "firman": "Marilah kepada-Ku, semua yang letih lesu dan berbeban berat, Aku akan memberi kelegaan kepadamu."
 },
 {
   "id": 23494,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 29,
   "firman": "Pikullah kuk yang Kupasang dan belajarlah pada-Ku, karena Aku lemah lembut dan rendah hati dan jiwamu akan mendapat ketenangan."
 },
 {
   "id": 23495,
   "kitab": "Mat",
   "pasal": 11,
   "ayat": 30,
   "firman": "Sebab kuk yang Kupasang itu enak dan beban-Kupun ringan.\""
 },
 {
   "id": 23496,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 1,
   "firman": "Pada waktu itu, pada hari Sabat, Yesus berjalan di ladang gandum. Karena lapar, murid-murid-Nya memetik bulir gandum dan memakannya."
 },
 {
   "id": 23497,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 2,
   "firman": "Melihat itu, berkatalah orang-orang Farisi kepada-Nya: \"Lihatlah, murid-murid-Mu berbuat sesuatu yang tidak diperbolehkan pada hari Sabat.\""
 },
 {
   "id": 23498,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 3,
   "firman": "Tetapi jawab Yesus kepada mereka: \"Tidakkah kamu baca apa yang dilakukan Daud, ketika ia dan mereka yang mengikutinya lapar,"
 },
 {
   "id": 23499,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 4,
   "firman": "bagaimana ia masuk ke dalam Rumah Allah dan bagaimana mereka makan roti sajian yang tidak boleh dimakan, baik olehnya maupun oleh mereka yang mengikutinya, kecuali oleh imam-imam?"
 },
 {
   "id": 23500,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 5,
   "firman": "Atau tidakkah kamu baca dalam kitab Taurat, bahwa pada hari-hari Sabat, imam-imam melanggar hukum Sabat di dalam Bait Allah, namun tidak bersalah?"
 },
 {
   "id": 23501,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 6,
   "firman": "Aku berkata kepadamu: Di sini ada yang melebihi Bait Allah."
 },
 {
   "id": 23502,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 7,
   "firman": "Jika memang kamu mengerti maksud firman ini: Yang Kukehendaki ialah belas kasihan dan bukan persembahan, tentu kamu tidak menghukum orang yang tidak bersalah."
 },
 {
   "id": 23503,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 8,
   "firman": "Karena Anak Manusia adalah Tuhan atas hari Sabat.\""
 },
 {
   "id": 23504,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 9,
   "firman": "Setelah pergi dari sana, Yesus masuk ke rumah ibadat mereka."
 },
 {
   "id": 23505,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 10,
   "firman": "Di situ ada seorang yang mati sebelah tangannya. Mereka bertanya kepada-Nya: \"Bolehkah menyembuhkan orang pada hari Sabat?\" Maksud mereka ialah supaya dapat mempersalahkan Dia."
 },
 {
   "id": 23506,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 11,
   "firman": "Tetapi Yesus berkata kepada mereka: \"Jika seorang dari antara kamu mempunyai seekor domba dan domba itu terjatuh ke dalam lobang pada hari Sabat, tidakkah ia akan menangkapnya dan mengeluarkannya?"
 },
 {
   "id": 23507,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 12,
   "firman": "Bukankah manusia jauh lebih berharga dari pada domba? Karena itu boleh berbuat baik pada hari Sabat.\""
 },
 {
   "id": 23508,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 13,
   "firman": "Lalu kata Yesus kepada orang itu: \"Ulurkanlah tanganmu!\" Dan ia mengulurkannya, maka pulihlah tangannya itu, dan menjadi sehat seperti tangannya yang lain."
 },
 {
   "id": 23509,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 14,
   "firman": "Lalu keluarlah orang-orang Farisi itu dan bersekongkol untuk membunuh Dia."
 },
 {
   "id": 23510,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 15,
   "firman": "Tetapi Yesus mengetahui maksud mereka lalu menyingkir dari sana."
 },
 {
   "id": 23512,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 16,
   "firman": "Ia dengan keras melarang mereka memberitahukan siapa Dia,"
 },
 {
   "id": 23513,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 17,
   "firman": "supaya genaplah firman yang disampaikan oleh nabi Yesaya:"
 },
 {
   "id": 23514,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 18,
   "firman": "\"Lihatlah, itu Hamba-Ku yang Kupilih, yang Kukasihi, yang kepada-Nya jiwa-Ku berkenan; Aku akan menaruh roh-Ku ke atas-Nya, dan Ia akan memaklumkan hukum kepada bangsa-bangsa."
 },
 {
   "id": 23515,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 19,
   "firman": "Ia tidak akan berbantah dan tidak akan berteriak dan orang tidak akan mendengar suara-Nya di jalan-jalan."
 },
 {
   "id": 23516,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 20,
   "firman": "Buluh yang patah terkulai tidak akan diputuskan-Nya, dan sumbu yang pudar nyalanya tidak akan dipadamkan-Nya, sampai Ia menjadikan hukum itu menang."
 },
 {
   "id": 23517,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 21,
   "firman": "Dan pada-Nyalah bangsa-bangsa akan berharap.\""
 },
 {
   "id": 23518,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 22,
   "firman": "Kemudian dibawalah kepada Yesus seorang yang kerasukan setan. Orang itu buta dan bisu, lalu Yesus menyembuhkannya, sehingga si bisu itu berkata-kata dan melihat."
 },
 {
   "id": 23519,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 23,
   "firman": "Maka takjublah sekalian orang banyak itu, katanya: \"Ia ini agaknya Anak Daud.\""
 },
 {
   "id": 23520,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 24,
   "firman": "Tetapi ketika orang Farisi mendengarnya, mereka berkata: \"Dengan Beelzebul, penghulu setan, Ia mengusir setan.\""
 },
 {
   "id": 23521,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 25,
   "firman": "Tetapi Yesus mengetahui pikiran mereka lalu berkata kepada mereka: \"Setiap kerajaan yang terpecah-pecah pasti binasa dan setiap kota atau rumah tangga yang terpecah-pecah tidak dapat bertahan."
 },
 {
   "id": 23522,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 26,
   "firman": "Demikianlah juga kalau Iblis mengusir Iblis, iapun terbagi-bagi dan melawan dirinya sendiri; bagaimanakah kerajaannya dapat bertahan?"
 },
 {
   "id": 23523,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 27,
   "firman": "Jadi jika Aku mengusir setan dengan kuasa Beelzebul, dengan kuasa siapakah pengikut-pengikutmu mengusirnya? Sebab itu merekalah yang akan menjadi hakimmu."
 },
 {
   "id": 23524,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 28,
   "firman": "Tetapi jika Aku mengusir setan dengan kuasa Roh Allah, maka sesungguhnya Kerajaan Allah sudah datang kepadamu."
 },
 {
   "id": 23525,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 29,
   "firman": "Atau bagaimanakah orang dapat memasuki rumah seorang yang kuat dan merampas harta bendanya apabila tidak diikatnya dahulu orang kuat itu? Sesudah diikatnya barulah dapat ia merampok rumah itu."
 },
 {
   "id": 23526,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 30,
   "firman": "Siapa tidak bersama Aku, ia melawan Aku dan siapa tidak mengumpulkan bersama Aku, ia mencerai-beraikan."
 },
 {
   "id": 23527,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 31,
   "firman": "Sebab itu Aku berkata kepadamu: Segala dosa dan hujat manusia akan diampuni, tetapi hujat terhadap Roh Kudus tidak akan diampuni."
 },
 {
   "id": 23528,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 32,
   "firman": "Apabila seorang mengucapkan sesuatu menentang Anak Manusia, ia akan diampuni, tetapi jika ia menentang Roh Kudus, ia tidak akan diampuni, di dunia ini tidak, dan di dunia yang akan datangpun tidak."
 },
 {
   "id": 23529,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 33,
   "firman": "Jikalau suatu pohon kamu katakan baik, maka baik pula buahnya; jikalau suatu pohon kamu katakan tidak baik, maka tidak baik pula buahnya. Sebab dari buahnya pohon itu dikenal."
 },
 {
   "id": 23530,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 34,
   "firman": "Hai kamu keturunan ular beludak, bagaimanakah kamu dapat mengucapkan hal-hal yang baik, sedangkan kamu sendiri jahat? Karena yang diucapkan mulut meluap dari hati."
 },
 {
   "id": 23531,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 35,
   "firman": "Orang yang baik mengeluarkan hal-hal yang baik dari perbendaharaannya yang baik dan orang yang jahat mengeluarkan hal-hal yang jahat dari perbendaharaannya yang jahat."
 },
 {
   "id": 23532,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 36,
   "firman": "Tetapi Aku berkata kepadamu: Setiap kata sia-sia yang diucapkan orang harus dipertanggungjawabkannya pada hari penghakiman."
 },
 {
   "id": 23533,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 37,
   "firman": "Karena menurut ucapanmu engkau akan dibenarkan, dan menurut ucapanmu pula engkau akan dihukum.\""
 },
 {
   "id": 23534,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 38,
   "firman": "Pada waktu itu berkatalah beberapa ahli Taurat dan orang Farisi kepada Yesus: \"Guru, kami ingin melihat suatu tanda dari pada-Mu.\""
 },
 {
   "id": 23535,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 39,
   "firman": "Tetapi jawab-Nya kepada mereka: \"Angkatan yang jahat dan tidak setia ini menuntut suatu tanda. Tetapi kepada mereka tidak akan diberikan tanda selain tanda nabi Yunus."
 },
 {
   "id": 23536,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 40,
   "firman": "Sebab seperti Yunus tinggal di dalam perut ikan tiga hari tiga malam, demikian juga Anak Manusia akan tinggal di dalam rahim bumi tiga hari tiga malam."
 },
 {
   "id": 23537,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 41,
   "firman": "Pada waktu penghakiman, orang-orang Niniwe akan bangkit bersama angkatan ini dan menghukumnya juga. Sebab orang-orang Niniwe itu bertobat setelah mendengar pemberitaan Yunus, dan sesungguhnya yang ada di sini lebih dari pada Yunus!"
 },
 {
   "id": 23538,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 42,
   "firman": "Pada waktu penghakiman, ratu dari Selatan itu akan bangkit bersama angkatan ini dan ia akan menghukumnya juga. Sebab ratu ini datang dari ujung bumi untuk mendengar hikmat Salomo, dan sesungguhnya yang ada di sini lebih dari pada Salomo!\""
 },
 {
   "id": 23539,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 43,
   "firman": "\"Apabila roh jahat keluar dari manusia, iapun mengembara ke tempat-tempat yang tandus mencari perhentian. Tetapi ia tidak mendapatnya."
 },
 {
   "id": 23540,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 44,
   "firman": "Lalu ia berkata: Aku akan kembali ke rumah yang telah kutinggalkan itu. Maka pergilah ia dan mendapati rumah itu kosong, bersih tersapu dan rapih teratur."
 },
 {
   "id": 23541,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 45,
   "firman": "Lalu ia keluar dan mengajak tujuh roh lain yang lebih jahat dari padanya dan mereka masuk dan berdiam di situ. Maka akhirnya keadaan orang itu lebih buruk dari pada keadaannya semula. Demikian juga akan berlaku atas angkatan yang jahat ini.\""
 },
 {
   "id": 23542,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 46,
   "firman": "Ketika Yesus masih berbicara dengan orang banyak itu, ibu-Nya dan saudara-saudara-Nya berdiri di luar dan berusaha menemui Dia."
 },
 {
   "id": 23543,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 47,
   "firman": "Maka seorang berkata kepada-Nya: \"Lihatlah, ibu-Mu dan saudara-saudara-Mu ada di luar dan berusaha menemui Engkau.\""
 },
 {
   "id": 23544,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 48,
   "firman": "Tetapi jawab Yesus kepada orang yang menyampaikan berita itu kepada-Nya: \"Siapa ibu-Ku? Dan siapa saudara-saudara-Ku?\""
 },
 {
   "id": 23545,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 49,
   "firman": "Lalu kata-Nya, sambil menunjuk ke arah murid-murid-Nya: \"Ini ibu-Ku dan saudara-saudara-Ku!"
 },
 {
   "id": 23546,
   "kitab": "Mat",
   "pasal": 12,
   "ayat": 50,
   "firman": "Sebab siapapun yang melakukan kehendak Bapa-Ku di sorga, dialah saudara-Ku laki-laki, dialah saudara-Ku perempuan, dialah ibu-Ku.\""
 },
 {
   "id": 23547,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 1,
   "firman": "Pada hari itu keluarlah Yesus dari rumah itu dan duduk di tepi danau."
 },
 {
   "id": 23548,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 2,
   "firman": "Maka datanglah orang banyak berbondong-bondong lalu mengerumuni Dia, sehingga Ia naik ke perahu dan duduk di situ, sedangkan orang banyak semuanya berdiri di pantai."
 },
 {
   "id": 23549,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 3,
   "firman": "Dan Ia mengucapkan banyak hal dalam perumpamaan kepada mereka. Kata-Nya: \"Adalah seorang penabur keluar untuk menabur."
 },
 {
   "id": 23550,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 4,
   "firman": "Pada waktu ia menabur, sebagian benih itu jatuh di pinggir jalan, lalu datanglah burung dan memakannya sampai habis."
 },
 {
   "id": 23551,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 5,
   "firman": "Sebagian jatuh di tanah yang berbatu-batu, yang tidak banyak tanahnya, lalu benih itupun segera tumbuh, karena tanahnya tipis."
 },
 {
   "id": 23552,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 6,
   "firman": "Tetapi sesudah matahari terbit, layulah ia dan menjadi kering karena tidak berakar."
 },
 {
   "id": 23553,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 7,
   "firman": "Sebagian lagi jatuh di tengah semak duri, lalu makin besarlah semak itu dan menghimpitnya sampai mati."
 },
 {
   "id": 23554,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 8,
   "firman": "Dan sebagian jatuh di tanah yang baik lalu berbuah: ada yang seratus kali lipat, ada yang enam puluh kali lipat, ada yang tiga puluh kali lipat."
 },
 {
   "id": 23555,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 9,
   "firman": "Siapa bertelinga, hendaklah ia mendengar!\""
 },
 {
   "id": 23556,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 10,
   "firman": "Maka datanglah murid-murid-Nya dan bertanya kepada-Nya: \"Mengapa Engkau berkata-kata kepada mereka dalam perumpamaan?\""
 },
 {
   "id": 23557,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 11,
   "firman": "Jawab Yesus: \"Kepadamu diberi karunia untuk mengetahui rahasia Kerajaan Sorga, tetapi kepada mereka tidak."
 },
 {
   "id": 23558,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 12,
   "firman": "Karena siapa yang mempunyai, kepadanya akan diberi, sehingga ia berkelimpahan; tetapi siapa yang tidak mempunyai, apapun juga yang ada padanya akan diambil dari padanya."
 },
 {
   "id": 23559,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 13,
   "firman": "Itulah sebabnya Aku berkata-kata dalam perumpamaan kepada mereka; karena sekalipun melihat, mereka tidak melihat dan sekalipun mendengar, mereka tidak mendengar dan tidak mengerti."
 },
 {
   "id": 23560,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 14,
   "firman": "Maka pada mereka genaplah nubuat Yesaya, yang berbunyi: Kamu akan mendengar dan mendengar, namun tidak mengerti, kamu akan melihat dan melihat, namun tidak menanggap."
 },
 {
   "id": 23561,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 15,
   "firman": "Sebab hati bangsa ini telah menebal, dan telinganya berat mendengar, dan matanya melekat tertutup; supaya jangan mereka melihat dengan matanya dan mendengar dengan telinganya dan mengerti dengan hatinya, lalu berbalik sehingga Aku menyembuhkan mereka."
 },
 {
   "id": 23562,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 16,
   "firman": "Tetapi berbahagialah matamu karena melihat dan telingamu karena mendengar."
 },
 {
   "id": 23563,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 17,
   "firman": "Sebab Aku berkata kepadamu: Sesungguhnya banyak nabi dan orang benar ingin melihat apa yang kamu lihat, tetapi tidak melihatnya, dan ingin mendengar apa yang kamu dengar, tetapi tidak mendengarnya."
 },
 {
   "id": 23564,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 18,
   "firman": "Karena itu, dengarlah arti perumpamaan penabur itu."
 },
 {
   "id": 23565,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 19,
   "firman": "Kepada setiap orang yang mendengar firman tentang Kerajaan Sorga, tetapi tidak mengertinya, datanglah si jahat dan merampas yang ditaburkan dalam hati orang itu; itulah benih yang ditaburkan di pinggir jalan."
 },
 {
   "id": 23566,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 20,
   "firman": "Benih yang ditaburkan di tanah yang berbatu-batu ialah orang yang mendengar firman itu dan segera menerimanya dengan gembira."
 },
 {
   "id": 23567,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 21,
   "firman": "Tetapi ia tidak berakar dan tahan sebentar saja. Apabila datang penindasan atau penganiayaan karena firman itu, orang itupun segera murtad."
 },
 {
   "id": 23568,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 22,
   "firman": "Yang ditaburkan di tengah semak duri ialah orang yang mendengar firman itu, lalu kekuatiran dunia ini dan tipu daya kekayaan menghimpit firman itu sehingga tidak berbuah."
 },
 {
   "id": 23569,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 23,
   "firman": "Yang ditaburkan di tanah yang baik ialah orang yang mendengar firman itu dan mengerti, dan karena itu ia berbuah, ada yang seratus kali lipat, ada yang enam puluh kali lipat, ada yang tiga puluh kali lipat.\""
 },
 {
   "id": 23570,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 24,
   "firman": "Yesus membentangkan suatu perumpamaan lain lagi kepada mereka, kata-Nya: \"Hal Kerajaan Sorga itu seumpama orang yang menaburkan benih yang baik di ladangnya."
 },
 {
   "id": 23571,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 25,
   "firman": "Tetapi pada waktu semua orang tidur, datanglah musuhnya menaburkan benih lalang di antara gandum itu, lalu pergi."
 },
 {
   "id": 23572,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 26,
   "firman": "Ketika gandum itu tumbuh dan mulai berbulir, nampak jugalah lalang itu."
 },
 {
   "id": 23573,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 27,
   "firman": "Maka datanglah hamba-hamba tuan ladang itu kepadanya dan berkata: Tuan, bukankah benih baik, yang tuan taburkan di ladang tuan? Dari manakah lalang itu?"
 },
 {
   "id": 23574,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 28,
   "firman": "Jawab tuan itu: Seorang musuh yang melakukannya. Lalu berkatalah hamba-hamba itu kepadanya: Jadi maukah tuan supaya kami pergi mencabut lalang itu?"
 },
 {
   "id": 23575,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 29,
   "firman": "Tetapi ia berkata: Jangan, sebab mungkin gandum itu ikut tercabut pada waktu kamu mencabut lalang itu."
 },
 {
   "id": 23576,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 30,
   "firman": "Biarkanlah keduanya tumbuh bersama sampai waktu menuai. Pada waktu itu aku akan berkata kepada para penuai: Kumpulkanlah dahulu lalang itu dan ikatlah berberkas-berkas untuk dibakar; kemudian kumpulkanlah gandum itu ke dalam lumbungku.\""
 },
 {
   "id": 23577,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 31,
   "firman": "Yesus membentangkan suatu perumpamaan lain lagi kepada mereka, kata-Nya: \"Hal Kerajaan Sorga itu seumpama biji sesawi, yang diambil dan ditaburkan orang di ladangnya."
 },
 {
   "id": 23578,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 32,
   "firman": "Memang biji itu yang paling kecil dari segala jenis benih, tetapi apabila sudah tumbuh, sesawi itu lebih besar dari pada sayuran yang lain, bahkan menjadi pohon, sehingga burung-burung di udara datang bersarang pada cabang-cabangnya.\""
 },
 {
   "id": 23579,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 33,
   "firman": "Dan Ia menceriterakan perumpamaan ini juga kepada mereka: \"Hal Kerajaan Sorga itu seumpama ragi yang diambil seorang perempuan dan diadukkan ke dalam tepung terigu tiga sukat sampai khamir seluruhnya.\""
 },
 {
   "id": 23580,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 34,
   "firman": "Semuanya itu disampaikan Yesus kepada orang banyak dalam perumpamaan, dan tanpa perumpamaan suatupun tidak disampaikan-Nya kepada mereka,"
 },
 {
   "id": 23581,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 35,
   "firman": "supaya genaplah firman yang disampaikan oleh nabi: \"Aku mau membuka mulut-Ku mengatakan perumpamaan, Aku mau mengucapkan hal yang tersembunyi sejak dunia dijadikan.\""
 },
 {
   "id": 23582,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 36,
   "firman": "Maka Yesuspun meninggalkan orang banyak itu, lalu pulang. Murid-murid-Nya datang dan berkata kepada-Nya: \"Jelaskanlah kepada kami perumpamaan tentang lalang di ladang itu.\""
 },
 {
   "id": 23583,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 37,
   "firman": "Ia menjawab, kata-Nya: \"Orang yang menaburkan benih baik ialah Anak Manusia;"
 },
 {
   "id": 23584,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 38,
   "firman": "ladang ialah dunia. Benih yang baik itu anak-anak Kerajaan dan lalang anak-anak si jahat."
 },
 {
   "id": 23585,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 39,
   "firman": "Musuh yang menaburkan benih lalang ialah Iblis. Waktu menuai ialah akhir zaman dan para penuai itu malaikat."
 },
 {
   "id": 23586,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 40,
   "firman": "Maka seperti lalang itu dikumpulkan dan dibakar dalam api, demikian juga pada akhir zaman."
 },
 {
   "id": 23587,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 41,
   "firman": "Anak Manusia akan menyuruh malaikat-malaikat-Nya dan mereka akan mengumpulkan segala sesuatu yang menyesatkan dan semua orang yang melakukan kejahatan dari dalam Kerajaan-Nya."
 },
 {
   "id": 23588,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 42,
   "firman": "Semuanya akan dicampakkan ke dalam dapur api; di sanalah akan terdapat ratapan dan kertakan gigi."
 },
 {
   "id": 23589,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 43,
   "firman": "Pada waktu itulah orang-orang benar akan bercahaya seperti matahari dalam Kerajaan Bapa mereka. Siapa bertelinga, hendaklah ia mendengar!\""
 },
 {
   "id": 23590,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 44,
   "firman": "\"Hal Kerajaan Sorga itu seumpama harta yang terpendam di ladang, yang ditemukan orang, lalu dipendamkannya lagi. Oleh sebab sukacitanya pergilah ia menjual seluruh miliknya lalu membeli ladang itu."
 },
 {
   "id": 23591,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 45,
   "firman": "Demikian pula hal Kerajaan Sorga itu seumpama seorang pedagang yang mencari mutiara yang indah."
 },
 {
   "id": 23592,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 46,
   "firman": "Setelah ditemukannya mutiara yang sangat berharga, iapun pergi menjual seluruh miliknya lalu membeli mutiara itu.\""
 },
 {
   "id": 23593,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 47,
   "firman": "\"Demikian pula hal Kerajaan Sorga itu seumpama pukat yang dilabuhkan di laut, lalu mengumpulkan berbagai-bagai jenis ikan."
 },
 {
   "id": 23594,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 48,
   "firman": "Setelah penuh, pukat itupun diseret orang ke pantai, lalu duduklah mereka dan mengumpulkan ikan yang baik ke dalam pasu dan ikan yang tidak baik mereka buang."
 },
 {
   "id": 23595,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 49,
   "firman": "Demikianlah juga pada akhir zaman: Malaikat-malaikat akan datang memisahkan orang jahat dari orang benar,"
 },
 {
   "id": 23596,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 50,
   "firman": "lalu mencampakkan orang jahat ke dalam dapur api; di sanalah akan terdapat ratapan dan kertakan gigi."
 },
 {
   "id": 23597,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 51,
   "firman": "Mengertikah kamu semuanya itu?\" Mereka menjawab: \"Ya, kami mengerti.\""
 },
 {
   "id": 23598,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 52,
   "firman": "Maka berkatalah Yesus kepada mereka: \"Karena itu setiap ahli Taurat yang menerima pelajaran dari hal Kerajaan Sorga itu seumpama tuan rumah yang mengeluarkan harta yang baru dan yang lama dari perbendaharaannya.\""
 },
 {
   "id": 23599,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 53,
   "firman": "Setelah Yesus selesai menceriterakan perumpamaan-perumpamaan itu, Iapun pergi dari situ."
 },
 {
   "id": 23600,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 54,
   "firman": "Setibanya di tempat asal-Nya, Yesus mengajar orang-orang di situ di rumah ibadat mereka. Maka takjublah mereka dan berkata: \"Dari mana diperoleh-Nya hikmat itu dan kuasa untuk mengadakan mujizat-mujizat itu?"
 },
 {
   "id": 23601,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 55,
   "firman": "Bukankah Ia ini anak tukang kayu? Bukankah ibu-Nya bernama Maria dan saudara-saudara-Nya: Yakobus, Yusuf, Simon dan Yudas?"
 },
 {
   "id": 23602,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 56,
   "firman": "Dan bukankah saudara-saudara-Nya perempuan semuanya ada bersama kita? Jadi dari mana diperoleh-Nya semuanya itu?\""
 },
 {
   "id": 23603,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 57,
   "firman": "Lalu mereka kecewa dan menolak Dia. Maka Yesus berkata kepada mereka: \"Seorang nabi dihormati di mana-mana, kecuali di tempat asalnya sendiri dan di rumahnya.\""
 },
 {
   "id": 23604,
   "kitab": "Mat",
   "pasal": 13,
   "ayat": 58,
   "firman": "Dan karena ketidakpercayaan mereka, tidak banyak mujizat diadakan-Nya di situ."
 },
 {
   "id": 23605,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 1,
   "firman": "Pada masa itu sampailah berita-berita tentang Yesus kepada Herodes, raja wilayah."
 },
 {
   "id": 23606,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 2,
   "firman": "Lalu ia berkata kepada pegawai-pegawainya: \"Inilah Yohanes Pembaptis; ia sudah bangkit dari antara orang mati dan itulah sebabnya kuasa-kuasa itu bekerja di dalam-Nya.\""
 },
 {
   "id": 23607,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 3,
   "firman": "Sebab memang Herodes telah menyuruh menangkap Yohanes, membelenggunya dan memenjarakannya, berhubung dengan peristiwa Herodias, isteri Filipus saudaranya."
 },
 {
   "id": 23608,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 4,
   "firman": "Karena Yohanes pernah menegornya, katanya: \"Tidak halal engkau mengambil Herodias!\""
 },
 {
   "id": 23609,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 5,
   "firman": "Herodes ingin membunuhnya, tetapi ia takut akan orang banyak yang memandang Yohanes sebagai nabi."
 },
 {
   "id": 23610,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi pada hari ulang tahun Herodes, menarilah anak perempuan Herodias di tengah-tengah mereka dan menyukakan hati Herodes,"
 },
 {
   "id": 23611,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 7,
   "firman": "sehingga Herodes bersumpah akan memberikan kepadanya apa saja yang dimintanya."
 },
 {
   "id": 23612,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 8,
   "firman": "Maka setelah dihasut oleh ibunya, anak perempuan itu berkata: \"Berikanlah aku di sini kepala Yohanes Pembaptis di sebuah talam.\""
 },
 {
   "id": 23613,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 9,
   "firman": "Lalu sedihlah hati raja, tetapi karena sumpahnya dan karena tamu-tamunya diperintahkannya juga untuk memberikannya."
 },
 {
   "id": 23614,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 10,
   "firman": "Disuruhnya memenggal kepala Yohanes di penjara"
 },
 {
   "id": 23615,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 11,
   "firman": "dan kepala Yohanes itupun dibawa orang di sebuah talam, lalu diberikan kepada gadis itu dan ia membawanya kepada ibunya."
 },
 {
   "id": 23616,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 12,
   "firman": "Kemudian datanglah murid-murid Yohanes Pembaptis mengambil mayatnya dan menguburkannya. Lalu pergilah mereka memberitahukannya kepada Yesus."
 },
 {
   "id": 23617,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 13,
   "firman": "Setelah Yesus mendengar berita itu menyingkirlah Ia dari situ, dan hendak mengasingkan diri dengan perahu ke tempat yang sunyi. Tetapi orang banyak mendengarnya dan mengikuti Dia dengan mengambil jalan darat dari kota-kota mereka."
 },
 {
   "id": 23618,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 14,
   "firman": "Ketika Yesus mendarat, Ia melihat orang banyak yang besar jumlahnya, maka tergeraklah hati-Nya oleh belas kasihan kepada mereka dan Ia menyembuhkan mereka yang sakit."
 },
 {
   "id": 23619,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 15,
   "firman": "Menjelang malam, murid-murid-Nya datang kepada-Nya dan berkata: \"Tempat ini sunyi dan hari sudah mulai malam. Suruhlah orang banyak itu pergi supaya mereka dapat membeli makanan di desa-desa.\""
 },
 {
   "id": 23620,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 16,
   "firman": "Tetapi Yesus berkata kepada mereka: \"Tidak perlu mereka pergi, kamu harus memberi mereka makan.\""
 },
 {
   "id": 23621,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 17,
   "firman": "Jawab mereka: \"Yang ada pada kami di sini hanya lima roti dan dua ikan.\""
 },
 {
   "id": 23622,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 18,
   "firman": "Yesus berkata: \"Bawalah ke mari kepada-Ku.\""
 },
 {
   "id": 23623,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 19,
   "firman": "Lalu disuruh-Nya orang banyak itu duduk di rumput. Dan setelah diambil-Nya lima roti dan dua ikan itu, Yesus menengadah ke langit dan mengucap berkat, lalu memecah-mecahkan roti itu dan memberikannya kepada murid-murid-Nya, lalu murid-murid-Nya membagi-bagikannya kepada orang banyak."
 },
 {
   "id": 23624,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 20,
   "firman": "Dan mereka semuanya makan sampai kenyang. Kemudian orang mengumpulkan potongan-potongan roti yang sisa, dua belas bakul penuh."
 },
 {
   "id": 23625,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 21,
   "firman": "Yang ikut makan kira-kira lima ribu laki-laki, tidak termasuk perempuan dan anak-anak."
 },
 {
   "id": 23626,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 22,
   "firman": "Sesudah itu Yesus segera memerintahkan murid-murid-Nya naik ke perahu dan mendahului-Nya ke seberang, sementara itu Ia menyuruh orang banyak pulang."
 },
 {
   "id": 23627,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 23,
   "firman": "Dan setelah orang banyak itu disuruh-Nya pulang, Yesus naik ke atas bukit untuk berdoa seorang diri. Ketika hari sudah malam, Ia sendirian di situ."
 },
 {
   "id": 23628,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 24,
   "firman": "Perahu murid-murid-Nya sudah beberapa mil jauhnya dari pantai dan diombang-ambingkan gelombang, karena angin sakal."
 },
 {
   "id": 23629,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 25,
   "firman": "Kira-kira jam tiga malam datanglah Yesus kepada mereka berjalan di atas air."
 },
 {
   "id": 23630,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 26,
   "firman": "Ketika murid-murid-Nya melihat Dia berjalan di atas air, mereka terkejut dan berseru: \"Itu hantu!\", lalu berteriak-teriak karena takut."
 },
 {
   "id": 23631,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 27,
   "firman": "Tetapi segera Yesus berkata kepada mereka: \"Tenanglah! Aku ini, jangan takut!\""
 },
 {
   "id": 23632,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 28,
   "firman": "Lalu Petrus berseru dan menjawab Dia: \"Tuhan, apabila Engkau itu, suruhlah aku datang kepada-Mu berjalan di atas air.\""
 },
 {
   "id": 23633,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 29,
   "firman": "Kata Yesus: \"Datanglah!\" Maka Petrus turun dari perahu dan berjalan di atas air mendapatkan Yesus."
 },
 {
   "id": 23634,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 30,
   "firman": "Tetapi ketika dirasanya tiupan angin, takutlah ia dan mulai tenggelam lalu berteriak: \"Tuhan, tolonglah aku!\""
 },
 {
   "id": 23635,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 31,
   "firman": "Segera Yesus mengulurkan tangan-Nya, memegang dia dan berkata: \"Hai orang yang kurang percaya, mengapa engkau bimbang?\""
 },
 {
   "id": 23636,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 32,
   "firman": "Lalu mereka naik ke perahu dan anginpun redalah."
 },
 {
   "id": 23637,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 33,
   "firman": "Dan orang-orang yang ada di perahu menyembah Dia, katanya: \"Sesungguhnya Engkau Anak Allah.\""
 },
 {
   "id": 23638,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 34,
   "firman": "Setibanya di seberang mereka mendarat di Genesaret."
 },
 {
   "id": 23639,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 35,
   "firman": "Ketika Yesus dikenal oleh orang-orang di tempat itu, mereka memberitahukannya ke seluruh daerah itu. Maka semua orang yang sakit dibawa kepada-Nya."
 },
 {
   "id": 23640,
   "kitab": "Mat",
   "pasal": 14,
   "ayat": 36,
   "firman": "Mereka memohon supaya diperkenankan menjamah jumbai jubah-Nya. Dan semua orang yang menjamah-Nya menjadi sembuh."
 },
 {
   "id": 23641,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 1,
   "firman": "Kemudian datanglah beberapa orang Farisi dan ahli Taurat dari Yerusalem kepada Yesus dan berkata:"
 },
 {
   "id": 23642,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 2,
   "firman": "\"Mengapa murid-murid-Mu melanggar adat istiadat nenek moyang kita? Mereka tidak membasuh tangan sebelum makan.\""
 },
 {
   "id": 23643,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 3,
   "firman": "Tetapi jawab Yesus kepada mereka: \"Mengapa kamupun melanggar perintah Allah demi adat istiadat nenek moyangmu?"
 },
 {
   "id": 23644,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 4,
   "firman": "Sebab Allah berfirman: Hormatilah ayahmu dan ibumu; dan lagi: Siapa yang mengutuki ayahnya atau ibunya pasti dihukum mati."
 },
 {
   "id": 23645,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 5,
   "firman": "Tetapi kamu berkata: Barangsiapa berkata kepada bapanya atau kepada ibunya: Apa yang ada padaku yang dapat digunakan untuk pemeliharaanmu, sudah digunakan untuk persembahan kepada Allah,"
 },
 {
   "id": 23646,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 6,
   "firman": "orang itu tidak wajib lagi menghormati bapanya atau ibunya. Dengan demikian firman Allah kamu nyatakan tidak berlaku demi adat istiadatmu sendiri."
 },
 {
   "id": 23647,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 7,
   "firman": "Hai orang-orang munafik! Benarlah nubuat Yesaya tentang kamu:"
 },
 {
   "id": 23648,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 8,
   "firman": "Bangsa ini memuliakan Aku dengan bibirnya, padahal hatinya jauh dari pada-Ku."
 },
 {
   "id": 23649,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 9,
   "firman": "Percuma mereka beribadah kepada-Ku, sedangkan ajaran yang mereka ajarkan ialah perintah manusia.\""
 },
 {
   "id": 23650,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 10,
   "firman": "Lalu Yesus memanggil orang banyak dan berkata kepada mereka:"
 },
 {
   "id": 23651,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 11,
   "firman": "\"Dengar dan camkanlah: bukan yang masuk ke dalam mulut yang menajiskan orang, melainkan yang keluar dari mulut, itulah yang menajiskan orang.\""
 },
 {
   "id": 23652,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 12,
   "firman": "Maka datanglah murid-murid-Nya dan bertanya kepada-Nya: \"Engkau tahu bahwa perkataan-Mu itu telah menjadi batu sandungan bagi orang-orang Farisi?\""
 },
 {
   "id": 23653,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 13,
   "firman": "Jawab Yesus: \"Setiap tanaman yang tidak ditanam oleh Bapa-Ku yang di sorga akan dicabut dengan akar-akarnya."
 },
 {
   "id": 23654,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 14,
   "firman": "Biarkanlah mereka itu. Mereka orang buta yang menuntun orang buta. Jika orang buta menuntun orang buta, pasti keduanya jatuh ke dalam lobang.\""
 },
 {
   "id": 23655,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 15,
   "firman": "Lalu Petrus berkata kepada-Nya: \"Jelaskanlah perumpamaan itu kepada kami.\""
 },
 {
   "id": 23656,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 16,
   "firman": "Jawab Yesus: \"Kamupun masih belum dapat memahaminya?"
 },
 {
   "id": 23657,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 17,
   "firman": "Tidak tahukah kamu bahwa segala sesuatu yang masuk ke dalam mulut turun ke dalam perut lalu dibuang di jamban?"
 },
 {
   "id": 23658,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 18,
   "firman": "Tetapi apa yang keluar dari mulut berasal dari hati dan itulah yang menajiskan orang."
 },
 {
   "id": 23659,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 19,
   "firman": "Karena dari hati timbul segala pikiran jahat, pembunuhan, perzinahan, percabulan, pencurian, sumpah palsu dan hujat."
 },
 {
   "id": 23660,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 20,
   "firman": "Itulah yang menajiskan orang. Tetapi makan dengan tangan yang tidak dibasuh tidak menajiskan orang.\""
 },
 {
   "id": 23661,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 21,
   "firman": "Lalu Yesus pergi dari situ dan menyingkir ke daerah Tirus dan Sidon."
 },
 {
   "id": 23662,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 22,
   "firman": "Maka datanglah seorang perempuan Kanaan dari daerah itu dan berseru: \"Kasihanilah aku, ya Tuhan, Anak Daud, karena anakku perempuan kerasukan setan dan sangat menderita.\""
 },
 {
   "id": 23663,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 23,
   "firman": "Tetapi Yesus sama sekali tidak menjawabnya. Lalu murid-murid-Nya datang dan meminta kepada-Nya: \"Suruhlah ia pergi, ia mengikuti kita dengan berteriak-teriak.\""
 },
 {
   "id": 23664,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 24,
   "firman": "Jawab Yesus: \"Aku diutus hanya kepada domba-domba yang hilang dari umat Israel.\""
 },
 {
   "id": 23665,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 25,
   "firman": "Tetapi perempuan itu mendekat dan menyembah Dia sambil berkata: \"Tuhan, tolonglah aku.\""
 },
 {
   "id": 23666,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 26,
   "firman": "Tetapi Yesus menjawab: \"Tidak patut mengambil roti yang disediakan bagi anak-anak dan melemparkannya kepada anjing.\""
 },
 {
   "id": 23667,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 27,
   "firman": "Kata perempuan itu: \"Benar Tuhan, namun anjing itu makan remah-remah yang jatuh dari meja tuannya.\""
 },
 {
   "id": 23668,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 28,
   "firman": "Maka Yesus menjawab dan berkata kepadanya: \"Hai ibu, besar imanmu, maka jadilah kepadamu seperti yang kaukehendaki.\" Dan seketika itu juga anaknya sembuh."
 },
 {
   "id": 23669,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 29,
   "firman": "Setelah meninggalkan daerah itu, Yesus menyusur pantai danau Galilea dan naik ke atas bukit lalu duduk di situ."
 },
 {
   "id": 23670,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 30,
   "firman": "Kemudian orang banyak berbondong-bondong datang kepada-Nya membawa orang lumpuh, orang timpang, orang buta, orang bisu dan banyak lagi yang lain, lalu meletakkan mereka pada kaki Yesus dan Ia menyembuhkan mereka semuanya."
 },
 {
   "id": 23671,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 31,
   "firman": "Maka takjublah orang banyak itu melihat orang bisu berkata-kata, orang timpang sembuh, orang lumpuh berjalan, orang buta melihat, dan mereka memuliakan Allah Israel."
 },
 {
   "id": 23672,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 32,
   "firman": "Lalu Yesus memanggil murid-murid-Nya dan berkata: \"Hati-Ku tergerak oleh belas kasihan kepada orang banyak itu. Sudah tiga hari mereka mengikuti Aku dan mereka tidak mempunyai makanan. Aku tidak mau menyuruh mereka pulang dengan lapar, nanti mereka pingsan di jalan.\""
 },
 {
   "id": 23673,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 33,
   "firman": "Kata murid-murid-Nya kepada-Nya: \"Bagaimana di tempat sunyi ini kita mendapat roti untuk mengenyangkan orang banyak yang begitu besar jumlahnya?\""
 },
 {
   "id": 23674,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 34,
   "firman": "Kata Yesus kepada mereka: \"Berapa roti ada padamu?\" \"Tujuh,\" jawab mereka, \"dan ada lagi beberapa ikan kecil.\""
 },
 {
   "id": 23675,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 35,
   "firman": "Lalu Yesus menyuruh orang banyak itu duduk di tanah."
 },
 {
   "id": 23676,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 36,
   "firman": "Sesudah itu Ia mengambil ketujuh roti dan ikan-ikan itu, mengucap syukur, memecah-mecahkannya dan memberikannya kepada murid-murid-Nya, lalu murid-murid-Nya memberikannya pula kepada orang banyak."
 },
 {
   "id": 23677,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 37,
   "firman": "Dan mereka semuanya makan sampai kenyang. Kemudian orang mengumpulkan potongan-potongan roti yang sisa, tujuh bakul penuh."
 },
 {
   "id": 23678,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 38,
   "firman": "Yang ikut makan ialah empat ribu laki-laki, tidak termasuk perempuan dan anak-anak."
 },
 {
   "id": 23679,
   "kitab": "Mat",
   "pasal": 15,
   "ayat": 39,
   "firman": "Lalu Yesus menyuruh orang banyak itu pulang. Ia naik perahu dan bertolak ke daerah Magadan."
 },
 {
   "id": 23680,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 1,
   "firman": "Kemudian datanglah orang-orang Farisi dan Saduki hendak mencobai Yesus. Mereka meminta supaya Ia memperlihatkan suatu tanda dari sorga kepada mereka."
 },
 {
   "id": 23681,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 2,
   "firman": "Tetapi jawab Yesus: \"Pada petang hari karena langit merah, kamu berkata: Hari akan cerah,"
 },
 {
   "id": 23682,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 3,
   "firman": "dan pada pagi hari, karena langit merah dan redup, kamu berkata: Hari buruk. Rupa langit kamu tahu membedakannya tetapi tanda-tanda zaman tidak."
 },
 {
   "id": 23683,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 4,
   "firman": "Angkatan yang jahat dan tidak setia ini menuntut suatu tanda. Tetapi kepada mereka tidak akan diberikan tanda selain tanda nabi Yunus.\" Lalu Yesus meninggalkan mereka dan pergi."
 },
 {
   "id": 23684,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 5,
   "firman": "Pada waktu murid-murid Yesus menyeberang danau, mereka lupa membawa roti."
 },
 {
   "id": 23685,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 6,
   "firman": "Yesus berkata kepada mereka: \"Berjaga-jagalah dan waspadalah terhadap ragi orang Farisi dan Saduki.\""
 },
 {
   "id": 23686,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 7,
   "firman": "Maka mereka berpikir-pikir dan seorang berkata kepada yang lain: \"Itu dikatakan-Nya karena kita tidak membawa roti.\""
 },
 {
   "id": 23687,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 8,
   "firman": "Dan ketika Yesus mengetahui apa yang mereka perbincangkan, Ia berkata: \"Mengapa kamu memperbincangkan soal tidak ada roti? Hai orang-orang yang kurang percaya!"
 },
 {
   "id": 23688,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 9,
   "firman": "Belum juga kamu mengerti? Tidak kamu ingat lagi akan lima roti untuk lima ribu orang itu dan berapa bakul roti kamu kumpulkan kemudian?"
 },
 {
   "id": 23689,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 10,
   "firman": "Ataupun akan tujuh roti untuk empat ribu orang itu dan berapa bakul kamu kumpulkan kemudian?"
 },
 {
   "id": 23690,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 11,
   "firman": "Bagaimana mungkin kamu tidak mengerti bahwa bukan roti yang Kumaksudkan. Aku berkata kepadamu: Waspadalah terhadap ragi orang Farisi dan Saduki.\""
 },
 {
   "id": 23691,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 12,
   "firman": "Ketika itu barulah mereka mengerti bahwa bukan maksud-Nya supaya mereka waspada terhadap ragi roti, melainkan terhadap ajaran orang Farisi dan Saduki."
 },
 {
   "id": 23692,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 13,
   "firman": "Setelah Yesus tiba di daerah Kaisarea Filipi, Ia bertanya kepada murid-murid-Nya: \"Kata orang, siapakah Anak Manusia itu?\""
 },
 {
   "id": 23693,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 14,
   "firman": "Jawab mereka: \"Ada yang mengatakan: Yohanes Pembaptis, ada juga yang mengatakan: Elia dan ada pula yang mengatakan: Yeremia atau salah seorang dari para nabi.\""
 },
 {
   "id": 23694,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu Yesus bertanya kepada mereka: \"Tetapi apa katamu, siapakah Aku ini?\""
 },
 {
   "id": 23695,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 16,
   "firman": "Maka jawab Simon Petrus: \"Engkau adalah Mesias, Anak Allah yang hidup!\""
 },
 {
   "id": 23696,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 17,
   "firman": "Kata Yesus kepadanya: \"Berbahagialah engkau Simon bin Yunus sebab bukan manusia yang menyatakan itu kepadamu, melainkan Bapa-Ku yang di sorga."
 },
 {
   "id": 23697,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 18,
   "firman": "Dan Akupun berkata kepadamu: Engkau adalah Petrus dan di atas batu karang ini Aku akan mendirikan jemaat-Ku dan alam maut tidak akan menguasainya."
 },
 {
   "id": 23698,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 19,
   "firman": "Kepadamu akan Kuberikan kunci Kerajaan Sorga. Apa yang kauikat di dunia ini akan terikat di sorga dan apa yang kaulepaskan di dunia ini akan terlepas di sorga.\""
 },
 {
   "id": 23699,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 20,
   "firman": "Lalu Yesus melarang murid-murid-Nya supaya jangan memberitahukan kepada siapapun bahwa Ia Mesias."
 },
 {
   "id": 23700,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 21,
   "firman": "Sejak waktu itu Yesus mulai menyatakan kepada murid-murid-Nya bahwa Ia harus pergi ke Yerusalem dan menanggung banyak penderitaan dari pihak tua-tua, imam-imam kepala dan ahli-ahli Taurat, lalu dibunuh dan dibangkitkan pada hari ketiga."
 },
 {
   "id": 23701,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 22,
   "firman": "Tetapi Petrus menarik Yesus ke samping dan menegor Dia, katanya: \"Tuhan, kiranya Allah menjauhkan hal itu! Hal itu sekali-kali takkan menimpa Engkau.\""
 },
 {
   "id": 23702,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 23,
   "firman": "Maka Yesus berpaling dan berkata kepada Petrus: \"Enyahlah Iblis. Engkau suatu batu sandungan bagi-Ku, sebab engkau bukan memikirkan apa yang dipikirkan Allah, melainkan apa yang dipikirkan manusia.\""
 },
 {
   "id": 23703,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 24,
   "firman": "Lalu Yesus berkata kepada murid-murid-Nya: \"Setiap orang yang mau mengikut Aku, ia harus menyangkal dirinya, memikul salibnya dan mengikut Aku."
 },
 {
   "id": 23704,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 25,
   "firman": "Karena barangsiapa mau menyelamatkan nyawanya, ia akan kehilangan nyawanya; tetapi barangsiapa kehilangan nyawanya karena Aku, ia akan memperolehnya."
 },
 {
   "id": 23705,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 26,
   "firman": "Apa gunanya seorang memperoleh seluruh dunia tetapi kehilangan nyawanya? Dan apakah yang dapat diberikannya sebagai ganti nyawanya?"
 },
 {
   "id": 23706,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 27,
   "firman": "Sebab Anak Manusia akan datang dalam kemuliaan Bapa-Nya diiringi malaikat-malaikat-Nya; pada waktu itu Ia akan membalas setiap orang menurut perbuatannya."
 },
 {
   "id": 23707,
   "kitab": "Mat",
   "pasal": 16,
   "ayat": 28,
   "firman": "Aku berkata kepadamu: Sesungguhnya di antara orang yang hadir di sini ada yang tidak akan mati sebelum mereka melihat Anak Manusia datang sebagai Raja dalam Kerajaan-Nya.\""
 },
 {
   "id": 23708,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 1,
   "firman": "Enam hari kemudian Yesus membawa Petrus, Yakobus dan Yohanes saudaranya, dan bersama-sama dengan mereka Ia naik ke sebuah gunung yang tinggi. Di situ mereka sendiri saja."
 },
 {
   "id": 23709,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 2,
   "firman": "Lalu Yesus berubah rupa di depan mata mereka; wajah-Nya bercahaya seperti matahari dan pakaian-Nya menjadi putih bersinar seperti terang."
 },
 {
   "id": 23710,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 3,
   "firman": "Maka nampak kepada mereka Musa dan Elia sedang berbicara dengan Dia."
 },
 {
   "id": 23711,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 4,
   "firman": "Kata Petrus kepada Yesus: \"Tuhan, betapa bahagianya kami berada di tempat ini. Jika Engkau mau, biarlah kudirikan di sini tiga kemah, satu untuk Engkau, satu untuk Musa dan satu untuk Elia.\""
 },
 {
   "id": 23712,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 5,
   "firman": "Dan tiba-tiba sedang ia berkata-kata turunlah awan yang terang menaungi mereka dan dari dalam awan itu terdengar suara yang berkata: \"Inilah Anak yang Kukasihi, kepada-Nyalah Aku berkenan, dengarkanlah Dia.\""
 },
 {
   "id": 23713,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 6,
   "firman": "Mendengar itu tersungkurlah murid-murid-Nya dan mereka sangat ketakutan."
 },
 {
   "id": 23714,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 7,
   "firman": "Lalu Yesus datang kepada mereka dan menyentuh mereka sambil berkata: \"Berdirilah, jangan takut!\""
 },
 {
   "id": 23715,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 8,
   "firman": "Dan ketika mereka mengangkat kepala, mereka tidak melihat seorangpun kecuali Yesus seorang diri."
 },
 {
   "id": 23716,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 9,
   "firman": "Pada waktu mereka turun dari gunung itu, Yesus berpesan kepada mereka: \"Jangan kamu ceriterakan penglihatan itu kepada seorangpun sebelum Anak Manusia dibangkitkan dari antara orang mati.\""
 },
 {
   "id": 23717,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 10,
   "firman": "Lalu murid-murid-Nya bertanya kepada-Nya: \"Kalau demikian mengapa ahli-ahli Taurat berkata bahwa Elia harus datang dahulu?\""
 },
 {
   "id": 23718,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 11,
   "firman": "Jawab Yesus: \"Memang Elia akan datang dan memulihkan segala sesuatu"
 },
 {
   "id": 23719,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 12,
   "firman": "dan Aku berkata kepadamu: Elia sudah datang, tetapi orang tidak mengenal dia, dan memperlakukannya menurut kehendak mereka. Demikian juga Anak Manusia akan menderita oleh mereka.\""
 },
 {
   "id": 23720,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 13,
   "firman": "Pada waktu itu mengertilah murid-murid Yesus bahwa Ia berbicara tentang Yohanes Pembaptis."
 },
 {
   "id": 23721,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 14,
   "firman": "Ketika Yesus dan murid-murid-Nya kembali kepada orang banyak itu, datanglah seorang mendapatkan Yesus dan menyembah,"
 },
 {
   "id": 23722,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 15,
   "firman": "katanya: \"Tuhan, kasihanilah anakku. Ia sakit ayan dan sangat menderita. Ia sering jatuh ke dalam api dan juga sering ke dalam air."
 },
 {
   "id": 23723,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 16,
   "firman": "Aku sudah membawanya kepada murid-murid-Mu, tetapi mereka tidak dapat menyembuhkannya.\""
 },
 {
   "id": 23724,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 17,
   "firman": "Maka kata Yesus: \"Hai kamu angkatan yang tidak percaya dan yang sesat, berapa lama lagi Aku harus tinggal di antara kamu? Berapa lama lagi Aku harus sabar terhadap kamu? Bawalah anak itu ke mari!\""
 },
 {
   "id": 23725,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 18,
   "firman": "Dengan keras Yesus menegor dia, lalu keluarlah setan itu dari padanya dan anak itupun sembuh seketika itu juga."
 },
 {
   "id": 23726,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 19,
   "firman": "Kemudian murid-murid Yesus datang dan ketika mereka sendirian dengan Dia, bertanyalah mereka: \"Mengapa kami tidak dapat mengusir setan itu?\""
 },
 {
   "id": 23727,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 20,
   "firman": "Ia berkata kepada mereka: \"Karena kamu kurang percaya. Sebab Aku berkata kepadamu: Sesungguhnya sekiranya kamu mempunyai iman sebesar biji sesawi saja kamu dapat berkata kepada gunung ini: Pindah dari tempat ini ke sana, --maka gunung ini akan pindah, dan takkan ada yang mustahil bagimu."
 },
 {
   "id": 23728,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 21,
   "firman": "(Jenis ini tidak dapat diusir kecuali dengan berdoa dan berpuasa.)\""
 },
 {
   "id": 23729,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 22,
   "firman": "Pada waktu Yesus dan murid-murid-Nya bersama-sama di Galilea, Ia berkata kepada mereka: \"Anak Manusia akan diserahkan ke dalam tangan manusia"
 },
 {
   "id": 23730,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 23,
   "firman": "dan mereka akan membunuh Dia dan pada hari ketiga Ia akan dibangkitkan.\" Maka hati murid-murid-Nya itupun sedih sekali."
 },
 {
   "id": 23731,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 24,
   "firman": "Ketika Yesus dan murid-murid-Nya tiba di Kapernaum datanglah pemungut bea Bait Allah kepada Petrus dan berkata: \"Apakah gurumu tidak membayar bea dua dirham itu?\""
 },
 {
   "id": 23732,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 25,
   "firman": "Jawabnya: \"Memang membayar.\" Dan ketika Petrus masuk rumah, Yesus mendahuluinya dengan pertanyaan: \"Apakah pendapatmu, Simon? Dari siapakah raja-raja dunia ini memungut bea dan pajak? Dari rakyatnya atau dari orang asing?\""
 },
 {
   "id": 23733,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 26,
   "firman": "Jawab Petrus: \"Dari orang asing!\" Maka kata Yesus kepadanya: \"Jadi bebaslah rakyatnya."
 },
 {
   "id": 23734,
   "kitab": "Mat",
   "pasal": 17,
   "ayat": 27,
   "firman": "Tetapi supaya jangan kita menjadi batu sandungan bagi mereka, pergilah memancing ke danau. Dan ikan pertama yang kaupancing, tangkaplah dan bukalah mulutnya, maka engkau akan menemukan mata uang empat dirham di dalamnya. Ambillah itu dan bayarkanlah kepada mereka, bagi-Ku dan bagimu juga.\""
 },
 {
   "id": 23735,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 1,
   "firman": "Pada waktu itu datanglah murid-murid itu kepada Yesus dan bertanya: \"Siapakah yang terbesar dalam Kerajaan Sorga?\""
 },
 {
   "id": 23736,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 2,
   "firman": "Maka Yesus memanggil seorang anak kecil dan menempatkannya di tengah-tengah mereka"
 },
 {
   "id": 23737,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 3,
   "firman": "lalu berkata: \"Aku berkata kepadamu, sesungguhnya jika kamu tidak bertobat dan menjadi seperti anak kecil ini, kamu tidak akan masuk ke dalam Kerajaan Sorga."
 },
 {
   "id": 23738,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 4,
   "firman": "Sedangkan barangsiapa merendahkan diri dan menjadi seperti anak kecil ini, dialah yang terbesar dalam Kerajaan Sorga."
 },
 {
   "id": 23739,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 5,
   "firman": "Dan barangsiapa menyambut seorang anak seperti ini dalam nama-Ku, ia menyambut Aku.\""
 },
 {
   "id": 23740,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 6,
   "firman": "\"Tetapi barangsiapa menyesatkan salah satu dari anak-anak kecil ini yang percaya kepada-Ku, lebih baik baginya jika sebuah batu kilangan diikatkan pada lehernya lalu ia ditenggelamkan ke dalam laut."
 },
 {
   "id": 23741,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 7,
   "firman": "Celakalah dunia dengan segala penyesatannya: memang penyesatan harus ada, tetapi celakalah orang yang mengadakannya."
 },
 {
   "id": 23742,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 8,
   "firman": "Jika tanganmu atau kakimu menyesatkan engkau, penggallah dan buanglah itu, karena lebih baik bagimu masuk ke dalam hidup dengan tangan kudung atau timpang dari pada dengan utuh kedua tangan dan kedua kakimu dicampakkan ke dalam api kekal."
 },
 {
   "id": 23743,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 9,
   "firman": "Dan jika matamu menyesatkan engkau, cungkillah dan buanglah itu, karena lebih baik bagimu masuk ke dalam hidup dengan bermata satu dari pada dicampakkan ke dalam api neraka dengan bermata dua."
 },
 {
   "id": 23744,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 10,
   "firman": "Ingatlah, jangan menganggap rendah seorang dari anak-anak kecil ini. Karena Aku berkata kepadamu: Ada malaikat mereka di sorga yang selalu memandang wajah Bapa-Ku yang di sorga."
 },
 {
   "id": 23745,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 11,
   "firman": "(Karena Anak Manusia datang untuk menyelamatkan yang hilang.)\""
 },
 {
   "id": 23746,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 12,
   "firman": "\"Bagaimana pendapatmu? Jika seorang mempunyai seratus ekor domba, dan seekor di antaranya sesat, tidakkah ia akan meninggalkan yang sembilan puluh sembilan ekor di pegunungan dan pergi mencari yang sesat itu?"
 },
 {
   "id": 23747,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 13,
   "firman": "Dan Aku berkata kepadamu: Sesungguhnya jika ia berhasil menemukannya, lebih besar kegembiraannya atas yang seekor itu dari pada atas yang kesembilan puluh sembilan ekor yang tidak sesat."
 },
 {
   "id": 23748,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 14,
   "firman": "Demikian juga Bapamu yang di sorga tidak menghendaki supaya seorangpun dari anak-anak ini hilang.\""
 },
 {
   "id": 23749,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 15,
   "firman": "\"Apabila saudaramu berbuat dosa, tegorlah dia di bawah empat mata. Jika ia mendengarkan nasihatmu engkau telah mendapatnya kembali."
 },
 {
   "id": 23750,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 16,
   "firman": "Jika ia tidak mendengarkan engkau, bawalah seorang atau dua orang lagi, supaya atas keterangan dua atau tiga orang saksi, perkara itu tidak disangsikan."
 },
 {
   "id": 23751,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 17,
   "firman": "Jika ia tidak mau mendengarkan mereka, sampaikanlah soalnya kepada jemaat. Dan jika ia tidak mau juga mendengarkan jemaat, pandanglah dia sebagai seorang yang tidak mengenal Allah atau seorang pemungut cukai."
 },
 {
   "id": 23752,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 18,
   "firman": "Aku berkata kepadamu: Sesungguhnya apa yang kamu ikat di dunia ini akan terikat di sorga dan apa yang kamu lepaskan di dunia ini akan terlepas di sorga."
 },
 {
   "id": 23753,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 19,
   "firman": "Dan lagi Aku berkata kepadamu: Jika dua orang dari padamu di dunia ini sepakat meminta apapun juga, permintaan mereka itu akan dikabulkan oleh Bapa-Ku yang di sorga."
 },
 {
   "id": 23754,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 20,
   "firman": "Sebab di mana dua atau tiga orang berkumpul dalam Nama-Ku, di situ Aku ada di tengah-tengah mereka.\""
 },
 {
   "id": 23755,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 21,
   "firman": "Kemudian datanglah Petrus dan berkata kepada Yesus: \"Tuhan, sampai berapa kali aku harus mengampuni saudaraku jika ia berbuat dosa terhadap aku? Sampai tujuh kali?\""
 },
 {
   "id": 23756,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 22,
   "firman": "Yesus berkata kepadanya: \"Bukan! Aku berkata kepadamu: Bukan sampai tujuh kali, melainkan sampai tujuh puluh kali tujuh kali."
 },
 {
   "id": 23757,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 23,
   "firman": "Sebab hal Kerajaan Sorga seumpama seorang raja yang hendak mengadakan perhitungan dengan hamba-hambanya."
 },
 {
   "id": 23758,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 24,
   "firman": "Setelah ia mulai mengadakan perhitungan itu, dihadapkanlah kepadanya seorang yang berhutang sepuluh ribu talenta."
 },
 {
   "id": 23759,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 25,
   "firman": "Tetapi karena orang itu tidak mampu melunaskan hutangnya, raja itu memerintahkan supaya ia dijual beserta anak isterinya dan segala miliknya untuk pembayar hutangnya."
 },
 {
   "id": 23760,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 26,
   "firman": "Maka sujudlah hamba itu menyembah dia, katanya: Sabarlah dahulu, segala hutangku akan kulunaskan."
 },
 {
   "id": 23761,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 27,
   "firman": "Lalu tergeraklah hati raja itu oleh belas kasihan akan hamba itu, sehingga ia membebaskannya dan menghapuskan hutangnya."
 },
 {
   "id": 23762,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 28,
   "firman": "Tetapi ketika hamba itu keluar, ia bertemu dengan seorang hamba lain yang berhutang seratus dinar kepadanya. Ia menangkap dan mencekik kawannya itu, katanya: Bayar hutangmu!"
 },
 {
   "id": 23763,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 29,
   "firman": "Maka sujudlah kawannya itu dan memohon kepadanya: Sabarlah dahulu, hutangku itu akan kulunaskan."
 },
 {
   "id": 23764,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 30,
   "firman": "Tetapi ia menolak dan menyerahkan kawannya itu ke dalam penjara sampai dilunaskannya hutangnya."
 },
 {
   "id": 23765,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 31,
   "firman": "Melihat itu kawan-kawannya yang lain sangat sedih lalu menyampaikan segala yang terjadi kepada tuan mereka."
 },
 {
   "id": 23766,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 32,
   "firman": "Raja itu menyuruh memanggil orang itu dan berkata kepadanya: Hai hamba yang jahat, seluruh hutangmu telah kuhapuskan karena engkau memohonkannya kepadaku."
 },
 {
   "id": 23767,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 33,
   "firman": "Bukankah engkaupun harus mengasihani kawanmu seperti aku telah mengasihani engkau?"
 },
 {
   "id": 23768,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 34,
   "firman": "Maka marahlah tuannya itu dan menyerahkannya kepada algojo-algojo, sampai ia melunaskan seluruh hutangnya."
 },
 {
   "id": 23769,
   "kitab": "Mat",
   "pasal": 18,
   "ayat": 35,
   "firman": "Maka Bapa-Ku yang di sorga akan berbuat demikian juga terhadap kamu, apabila kamu masing-masing tidak mengampuni saudaramu dengan segenap hatimu.\""
 },
 {
   "id": 23770,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 1,
   "firman": "Setelah Yesus selesai dengan pengajaran-Nya itu, berangkatlah Ia dari Galilea dan tiba di daerah Yudea yang di seberang sungai Yordan."
 },
 {
   "id": 23771,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 2,
   "firman": "Orang banyak berbondong-bondong mengikuti Dia dan Iapun menyembuhkan mereka di sana."
 },
 {
   "id": 23772,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 3,
   "firman": "Maka datanglah orang-orang Farisi kepada-Nya untuk mencobai Dia. Mereka bertanya: \"Apakah diperbolehkan orang menceraikan isterinya dengan alasan apa saja?\""
 },
 {
   "id": 23773,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 4,
   "firman": "Jawab Yesus: \"Tidakkah kamu baca, bahwa Ia yang menciptakan manusia sejak semula menjadikan mereka laki-laki dan perempuan?"
 },
 {
   "id": 23774,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 5,
   "firman": "Dan firman-Nya: Sebab itu laki-laki akan meninggalkan ayah dan ibunya dan bersatu dengan isterinya, sehingga keduanya itu menjadi satu daging."
 },
 {
   "id": 23775,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 6,
   "firman": "Demikianlah mereka bukan lagi dua, melainkan satu. Karena itu, apa yang telah dipersatukan Allah, tidak boleh diceraikan manusia.\""
 },
 {
   "id": 23776,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 7,
   "firman": "Kata mereka kepada-Nya: \"Jika demikian, apakah sebabnya Musa memerintahkan untuk memberikan surat cerai jika orang menceraikan isterinya?\""
 },
 {
   "id": 23777,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 8,
   "firman": "Kata Yesus kepada mereka: \"Karena ketegaran hatimu Musa mengizinkan kamu menceraikan isterimu, tetapi sejak semula tidaklah demikian."
 },
 {
   "id": 23778,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 9,
   "firman": "Tetapi Aku berkata kepadamu: Barangsiapa menceraikan isterinya, kecuali karena zinah, lalu kawin dengan perempuan lain, ia berbuat zinah.\""
 },
 {
   "id": 23779,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 10,
   "firman": "Murid-murid itu berkata kepada-Nya: \"Jika demikian halnya hubungan antara suami dan isteri, lebih baik jangan kawin.\""
 },
 {
   "id": 23780,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 11,
   "firman": "Akan tetapi Ia berkata kepada mereka: \"Tidak semua orang dapat mengerti perkataan itu, hanya mereka yang dikaruniai saja."
 },
 {
   "id": 23781,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 12,
   "firman": "Ada orang yang tidak dapat kawin karena ia memang lahir demikian dari rahim ibunya, dan ada orang yang dijadikan demikian oleh orang lain, dan ada orang yang membuat dirinya demikian karena kemauannya sendiri oleh karena Kerajaan Sorga. Siapa yang dapat mengerti hendaklah ia mengerti.\""
 },
 {
   "id": 23782,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 13,
   "firman": "Lalu orang membawa anak-anak kecil kepada Yesus, supaya Ia meletakkan tangan-Nya atas mereka dan mendoakan mereka; akan tetapi murid-murid-Nya memarahi orang-orang itu."
 },
 {
   "id": 23783,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 14,
   "firman": "Tetapi Yesus berkata: \"Biarkanlah anak-anak itu, janganlah menghalang-halangi mereka datang kepada-Ku; sebab orang-orang yang seperti itulah yang empunya Kerajaan Sorga.\""
 },
 {
   "id": 23784,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 15,
   "firman": "Lalu Ia meletakkan tangan-Nya atas mereka dan kemudian Ia berangkat dari situ."
 },
 {
   "id": 23785,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 16,
   "firman": "Ada seorang datang kepada Yesus, dan berkata: \"Guru, perbuatan baik apakah yang harus kuperbuat untuk memperoleh hidup yang kekal?\""
 },
 {
   "id": 23786,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 17,
   "firman": "Jawab Yesus: \"Apakah sebabnya engkau bertanya kepada-Ku tentang apa yang baik? Hanya Satu yang baik. Tetapi jikalau engkau ingin masuk ke dalam hidup, turutilah segala perintah Allah.\""
 },
 {
   "id": 23787,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 18,
   "firman": "Kata orang itu kepada-Nya: \"Perintah yang mana?\" Kata Yesus: \"Jangan membunuh, jangan berzinah, jangan mencuri, jangan mengucapkan saksi dusta,"
 },
 {
   "id": 23788,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 19,
   "firman": "hormatilah ayahmu dan ibumu dan kasihilah sesamamu manusia seperti dirimu sendiri.\""
 },
 {
   "id": 23789,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 20,
   "firman": "Kata orang muda itu kepada-Nya: \"Semuanya itu telah kuturuti, apa lagi yang masih kurang?\""
 },
 {
   "id": 23790,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 21,
   "firman": "Kata Yesus kepadanya: \"Jikalau engkau hendak sempurna, pergilah, juallah segala milikmu dan berikanlah itu kepada orang-orang miskin, maka engkau akan beroleh harta di sorga, kemudian datanglah ke mari dan ikutlah Aku.\""
 },
 {
   "id": 23791,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 22,
   "firman": "Ketika orang muda itu mendengar perkataan itu, pergilah ia dengan sedih, sebab banyak hartanya."
 },
 {
   "id": 23792,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 23,
   "firman": "Yesus berkata kepada murid-murid-Nya: \"Aku berkata kepadamu, sesungguhnya sukar sekali bagi seorang kaya untuk masuk ke dalam Kerajaan Sorga."
 },
 {
   "id": 23793,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 24,
   "firman": "Sekali lagi Aku berkata kepadamu, lebih mudah seekor unta masuk melalui lobang jarum dari pada seorang kaya masuk ke dalam Kerajaan Allah.\""
 },
 {
   "id": 23794,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 25,
   "firman": "Ketika murid-murid mendengar itu, sangat gemparlah mereka dan berkata: \"Jika demikian, siapakah yang dapat diselamatkan?\""
 },
 {
   "id": 23795,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 26,
   "firman": "Yesus memandang mereka dan berkata: \"Bagi manusia hal ini tidak mungkin, tetapi bagi Allah segala sesuatu mungkin.\""
 },
 {
   "id": 23796,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 27,
   "firman": "Lalu Petrus menjawab dan berkata kepada Yesus: \"Kami ini telah meninggalkan segala sesuatu dan mengikut Engkau; jadi apakah yang akan kami peroleh?\""
 },
 {
   "id": 23797,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 28,
   "firman": "Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya pada waktu penciptaan kembali, apabila Anak Manusia bersemayam di takhta kemuliaan-Nya, kamu, yang telah mengikut Aku, akan duduk juga di atas dua belas takhta untuk menghakimi kedua belas suku Israel."
 },
 {
   "id": 23798,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 29,
   "firman": "Dan setiap orang yang karena nama-Ku meninggalkan rumahnya, saudaranya laki-laki atau saudaranya perempuan, bapa atau ibunya, anak-anak atau ladangnya, akan menerima kembali seratus kali lipat dan akan memperoleh hidup yang kekal."
 },
 {
   "id": 23799,
   "kitab": "Mat",
   "pasal": 19,
   "ayat": 30,
   "firman": "Tetapi banyak orang yang terdahulu akan menjadi yang terakhir, dan yang terakhir akan menjadi yang terdahulu.\""
 },
 {
   "id": 23800,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 1,
   "firman": "\"Adapun hal Kerajaan Sorga sama seperti seorang tuan rumah yang pagi-pagi benar keluar mencari pekerja-pekerja untuk kebun anggurnya."
 },
 {
   "id": 23801,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 2,
   "firman": "Setelah ia sepakat dengan pekerja-pekerja itu mengenai upah sedinar sehari, ia menyuruh mereka ke kebun anggurnya."
 },
 {
   "id": 23802,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 3,
   "firman": "Kira-kira pukul sembilan pagi ia keluar pula dan dilihatnya ada lagi orang-orang lain menganggur di pasar."
 },
 {
   "id": 23803,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 4,
   "firman": "Katanya kepada mereka: Pergi jugalah kamu ke kebun anggurku dan apa yang pantas akan kuberikan kepadamu. Dan merekapun pergi."
 },
 {
   "id": 23804,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 5,
   "firman": "Kira-kira pukul dua belas dan pukul tiga petang ia keluar pula dan melakukan sama seperti tadi."
 },
 {
   "id": 23805,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 6,
   "firman": "Kira-kira pukul lima petang ia keluar lagi dan mendapati orang-orang lain pula, lalu katanya kepada mereka: Mengapa kamu menganggur saja di sini sepanjang hari?"
 },
 {
   "id": 23806,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 7,
   "firman": "Kata mereka kepadanya: Karena tidak ada orang mengupah kami. Katanya kepada mereka: Pergi jugalah kamu ke kebun anggurku."
 },
 {
   "id": 23807,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 8,
   "firman": "Ketika hari malam tuan itu berkata kepada mandurnya: Panggillah pekerja-pekerja itu dan bayarkan upah mereka, mulai dengan mereka yang masuk terakhir hingga mereka yang masuk terdahulu."
 },
 {
   "id": 23808,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 9,
   "firman": "Maka datanglah mereka yang mulai bekerja kira-kira pukul lima dan mereka menerima masing-masing satu dinar."
 },
 {
   "id": 23809,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 10,
   "firman": "Kemudian datanglah mereka yang masuk terdahulu, sangkanya akan mendapat lebih banyak, tetapi merekapun menerima masing-masing satu dinar juga."
 },
 {
   "id": 23810,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 11,
   "firman": "Ketika mereka menerimanya, mereka bersungut-sungut kepada tuan itu,"
 },
 {
   "id": 23811,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 12,
   "firman": "katanya: Mereka yang masuk terakhir ini hanya bekerja satu jam dan engkau menyamakan mereka dengan kami yang sehari suntuk bekerja berat dan menanggung panas terik matahari."
 },
 {
   "id": 23812,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 13,
   "firman": "Tetapi tuan itu menjawab seorang dari mereka: Saudara, aku tidak berlaku tidak adil terhadap engkau. Bukankah kita telah sepakat sedinar sehari?"
 },
 {
   "id": 23813,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 14,
   "firman": "Ambillah bagianmu dan pergilah; aku mau memberikan kepada orang yang masuk terakhir ini sama seperti kepadamu."
 },
 {
   "id": 23814,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 15,
   "firman": "Tidakkah aku bebas mempergunakan milikku menurut kehendak hatiku? Atau iri hatikah engkau, karena aku murah hati?"
 },
 {
   "id": 23815,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 16,
   "firman": "Demikianlah orang yang terakhir akan menjadi yang terdahulu dan yang terdahulu akan menjadi yang terakhir.\""
 },
 {
   "id": 23816,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 17,
   "firman": "Ketika Yesus akan pergi ke Yerusalem, Ia memanggil kedua belas murid-Nya tersendiri dan berkata kepada mereka di tengah jalan:"
 },
 {
   "id": 23817,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 18,
   "firman": "\"Sekarang kita pergi ke Yerusalem dan Anak Manusia akan diserahkan kepada imam-imam kepala dan ahli-ahli Taurat, dan mereka akan menjatuhi Dia hukuman mati."
 },
 {
   "id": 23818,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 19,
   "firman": "Dan mereka akan menyerahkan Dia kepada bangsa-bangsa yang tidak mengenal Allah, supaya Ia diolok-olokkan, disesah dan disalibkan, dan pada hari ketiga Ia akan dibangkitkan.\""
 },
 {
   "id": 23819,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 20,
   "firman": "Maka datanglah ibu anak-anak Zebedeus serta anak-anaknya itu kepada Yesus, lalu sujud di hadapan-Nya untuk meminta sesuatu kepada-Nya."
 },
 {
   "id": 23820,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 21,
   "firman": "Kata Yesus: \"Apa yang kaukehendaki?\" Jawabnya: \"Berilah perintah, supaya kedua anakku ini boleh duduk kelak di dalam Kerajaan-Mu, yang seorang di sebelah kanan-Mu dan yang seorang lagi di sebelah kiri-Mu.\""
 },
 {
   "id": 23821,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 22,
   "firman": "Tetapi Yesus menjawab, kata-Nya: \"Kamu tidak tahu, apa yang kamu minta. Dapatkah kamu meminum cawan, yang harus Kuminum?\" Kata mereka kepada-Nya: \"Kami dapat.\""
 },
 {
   "id": 23822,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 23,
   "firman": "Yesus berkata kepada mereka: \"Cawan-Ku memang akan kamu minum, tetapi hal duduk di sebelah kanan-Ku atau di sebelah kiri-Ku, Aku tidak berhak memberikannya. Itu akan diberikan kepada orang-orang bagi siapa Bapa-Ku telah menyediakannya.\""
 },
 {
   "id": 23823,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 24,
   "firman": "Mendengar itu marahlah kesepuluh murid yang lain kepada kedua saudara itu."
 },
 {
   "id": 23824,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 25,
   "firman": "Tetapi Yesus memanggil mereka lalu berkata: \"Kamu tahu, bahwa pemerintah-pemerintah bangsa-bangsa memerintah rakyatnya dengan tangan besi dan pembesar-pembesar menjalankan kuasanya dengan keras atas mereka."
 },
 {
   "id": 23825,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 26,
   "firman": "Tidaklah demikian di antara kamu. Barangsiapa ingin menjadi besar di antara kamu, hendaklah ia menjadi pelayanmu,"
 },
 {
   "id": 23826,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 27,
   "firman": "dan barangsiapa ingin menjadi terkemuka di antara kamu, hendaklah ia menjadi hambamu;"
 },
 {
   "id": 23827,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 28,
   "firman": "sama seperti Anak Manusia datang bukan untuk dilayani, melainkan untuk melayani dan untuk memberikan nyawa-Nya menjadi tebusan bagi banyak orang.\""
 },
 {
   "id": 23828,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 29,
   "firman": "Dan ketika Yesus dan murid-murid-Nya keluar dari Yerikho, orang banyak berbondong-bondong mengikuti Dia."
 },
 {
   "id": 23829,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 30,
   "firman": "Ada dua orang buta yang duduk di pinggir jalan mendengar, bahwa Yesus lewat, lalu mereka berseru: \"Tuhan, Anak Daud, kasihanilah kami!\""
 },
 {
   "id": 23830,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 31,
   "firman": "Tetapi orang banyak itu menegor mereka supaya mereka diam. Namun mereka makin keras berseru, katanya: \"Tuhan, Anak Daud, kasihanilah kami!\""
 },
 {
   "id": 23831,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 32,
   "firman": "Lalu Yesus berhenti dan memanggil mereka. Ia berkata: \"Apa yang kamu kehendaki supaya Aku perbuat bagimu?\""
 },
 {
   "id": 23832,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 33,
   "firman": "Jawab mereka: \"Tuhan, supaya mata kami dapat melihat.\""
 },
 {
   "id": 23833,
   "kitab": "Mat",
   "pasal": 20,
   "ayat": 34,
   "firman": "Maka tergeraklah hati Yesus oleh belas kasihan, lalu Ia menjamah mata mereka dan seketika itu juga mereka melihat lalu mengikuti Dia."
 },
 {
   "id": 23834,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 1,
   "firman": "Ketika Yesus dan murid-murid-Nya telah dekat Yerusalem dan tiba di Betfage yang terletak di Bukit Zaitun, Yesus menyuruh dua orang murid-Nya"
 },
 {
   "id": 23835,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 2,
   "firman": "dengan pesan: \"Pergilah ke kampung yang di depanmu itu, dan di situ kamu akan segera menemukan seekor keledai betina tertambat dan anaknya ada dekatnya. Lepaskanlah keledai itu dan bawalah keduanya kepada-Ku."
 },
 {
   "id": 23836,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 3,
   "firman": "Dan jikalau ada orang menegor kamu, katakanlah: Tuhan memerlukannya. Ia akan segera mengembalikannya.\""
 },
 {
   "id": 23837,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 4,
   "firman": "Hal itu terjadi supaya genaplah firman yang disampaikan oleh nabi:"
 },
 {
   "id": 23838,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 5,
   "firman": "\"Katakanlah kepada puteri Sion: Lihat, Rajamu datang kepadamu, Ia lemah lembut dan mengendarai seekor keledai, seekor keledai beban yang muda.\""
 },
 {
   "id": 23839,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 6,
   "firman": "Maka pergilah murid-murid itu dan berbuat seperti yang ditugaskan Yesus kepada mereka."
 },
 {
   "id": 23840,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 7,
   "firman": "Mereka membawa keledai betina itu bersama anaknya, lalu mengalasinya dengan pakaian mereka dan Yesuspun naik ke atasnya."
 },
 {
   "id": 23841,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 8,
   "firman": "Orang banyak yang sangat besar jumlahnya menghamparkan pakaiannya di jalan, ada pula yang memotong ranting-ranting dari pohon-pohon dan menyebarkannya di jalan."
 },
 {
   "id": 23842,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 9,
   "firman": "Dan orang banyak yang berjalan di depan Yesus dan yang mengikuti-Nya dari belakang berseru, katanya: \"Hosana bagi Anak Daud, diberkatilah Dia yang datang dalam nama Tuhan, hosana di tempat yang mahatinggi!\""
 },
 {
   "id": 23843,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 10,
   "firman": "Dan ketika Ia masuk ke Yerusalem, gemparlah seluruh kota itu dan orang berkata: \"Siapakah orang ini?\""
 },
 {
   "id": 23844,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 11,
   "firman": "Dan orang banyak itu menyahut: \"Inilah nabi Yesus dari Nazaret di Galilea.\""
 },
 {
   "id": 23845,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 12,
   "firman": "Lalu Yesus masuk ke Bait Allah dan mengusir semua orang yang berjual beli di halaman Bait Allah. Ia membalikkan meja-meja penukar uang dan bangku-bangku pedagang merpati"
 },
 {
   "id": 23846,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 13,
   "firman": "dan berkata kepada mereka: \"Ada tertulis: Rumah-Ku akan disebut rumah doa. Tetapi kamu menjadikannya sarang penyamun.\""
 },
 {
   "id": 23847,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 14,
   "firman": "Maka datanglah orang-orang buta dan orang-orang timpang kepada-Nya dalam Bait Allah itu dan mereka disembuhkan-Nya."
 },
 {
   "id": 23848,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 15,
   "firman": "Tetapi ketika imam-imam kepala dan ahli-ahli Taurat melihat mujizat-mujizat yang dibuat-Nya itu dan anak-anak yang berseru dalam Bait Allah: \"Hosana bagi Anak Daud!\" hati mereka sangat jengkel,"
 },
 {
   "id": 23849,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 16,
   "firman": "lalu mereka berkata kepada-Nya: \"Engkau dengar apa yang dikatakan anak-anak ini?\" Kata Yesus kepada mereka: \"Aku dengar; belum pernahkah kamu baca: Dari mulut bayi-bayi dan anak-anak yang menyusu Engkau telah menyediakan puji-pujian?\""
 },
 {
   "id": 23850,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 17,
   "firman": "Lalu Ia meninggalkan mereka dan pergi ke luar kota ke Betania dan bermalam di situ."
 },
 {
   "id": 23851,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 18,
   "firman": "Pada pagi-pagi hari dalam perjalanan-Nya kembali ke kota, Yesus merasa lapar."
 },
 {
   "id": 23852,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 19,
   "firman": "Dekat jalan Ia melihat pohon ara lalu pergi ke situ, tetapi Ia tidak mendapat apa-apa pada pohon itu selain daun-daun saja. Kata-Nya kepada pohon itu: \"Engkau tidak akan berbuah lagi selama-lamanya!\" Dan seketika itu juga keringlah pohon ara itu."
 },
 {
   "id": 23853,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 20,
   "firman": "Melihat kejadian itu tercenganglah murid-murid-Nya, lalu berkata: \"Bagaimana mungkin pohon ara itu sekonyong-konyong menjadi kering?\""
 },
 {
   "id": 23854,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 21,
   "firman": "Yesus menjawab mereka: \"Aku berkata kepadamu, sesungguhnya jika kamu percaya dan tidak bimbang, kamu bukan saja akan dapat berbuat apa yang Kuperbuat dengan pohon ara itu, tetapi juga jikalau kamu berkata kepada gunung ini: Beranjaklah dan tercampaklah ke dalam laut! hal itu akan terjadi."
 },
 {
   "id": 23855,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 22,
   "firman": "Dan apa saja yang kamu minta dalam doa dengan penuh kepercayaan, kamu akan menerimanya.\""
 },
 {
   "id": 23856,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 23,
   "firman": "Lalu Yesus masuk ke Bait Allah, dan ketika Ia mengajar di situ, datanglah imam-imam kepala serta tua-tua bangsa Yahudi kepada-Nya, dan bertanya: \"Dengan kuasa manakah Engkau melakukan hal-hal itu? Dan siapakah yang memberikan kuasa itu kepada-Mu?\""
 },
 {
   "id": 23857,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 24,
   "firman": "Jawab Yesus kepada mereka: \"Aku juga akan mengajukan satu pertanyaan kepadamu dan jikalau kamu memberi jawabnya kepada-Ku, Aku akan mengatakan juga kepadamu dengan kuasa manakah Aku melakukan hal-hal itu."
 },
 {
   "id": 23858,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 25,
   "firman": "Dari manakah baptisan Yohanes? Dari sorga atau dari manusia?\" Mereka memperbincangkannya di antara mereka, dan berkata: \"Jikalau kita katakan: Dari sorga, Ia akan berkata kepada kita: Kalau begitu, mengapakah kamu tidak percaya kepadanya?"
 },
 {
   "id": 23859,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 26,
   "firman": "Tetapi jikalau kita katakan: Dari manusia, kita takut kepada orang banyak, sebab semua orang menganggap Yohanes ini nabi.\""
 },
 {
   "id": 23860,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 27,
   "firman": "Lalu mereka menjawab Yesus: \"Kami tidak tahu.\" Dan Yesuspun berkata kepada mereka: \"Jika demikian, Aku juga tidak mengatakan kepadamu dengan kuasa manakah Aku melakukan hal-hal itu.\""
 },
 {
   "id": 23861,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 28,
   "firman": "\"Tetapi apakah pendapatmu tentang ini: Seorang mempunyai dua anak laki-laki. Ia pergi kepada anak yang sulung dan berkata: Anakku, pergi dan bekerjalah hari ini dalam kebun anggur."
 },
 {
   "id": 23862,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 29,
   "firman": "Jawab anak itu: Baik, bapa. Tetapi ia tidak pergi."
 },
 {
   "id": 23863,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 30,
   "firman": "Lalu orang itu pergi kepada anak yang kedua dan berkata demikian juga. Dan anak itu menjawab: Aku tidak mau. Tetapi kemudian ia menyesal lalu pergi juga."
 },
 {
   "id": 23864,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 31,
   "firman": "Siapakah di antara kedua orang itu yang melakukan kehendak ayahnya?\" Jawab mereka: \"Yang terakhir.\" Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya pemungut-pemungut cukai dan perempuan-perempuan sundal akan mendahului kamu masuk ke dalam Kerajaan Allah."
 },
 {
   "id": 23865,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 32,
   "firman": "Sebab Yohanes datang untuk menunjukkan jalan kebenaran kepadamu, dan kamu tidak percaya kepadanya. Tetapi pemungut-pemungut cukai dan perempuan-perempuan sundal percaya kepadanya. Dan meskipun kamu melihatnya, tetapi kemudian kamu tidak menyesal dan kamu tidak juga percaya kepadanya.\""
 },
 {
   "id": 23866,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 33,
   "firman": "\"Dengarkanlah suatu perumpamaan yang lain. Adalah seorang tuan tanah membuka kebun anggur dan menanam pagar sekelilingnya. Ia menggali lobang tempat memeras anggur dan mendirikan menara jaga di dalam kebun itu. Kemudian ia menyewakan kebun itu kepada penggarap-penggarap lalu berangkat ke negeri lain."
 },
 {
   "id": 23867,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 34,
   "firman": "Ketika hampir tiba musim petik, ia menyuruh hamba-hambanya kepada penggarap-penggarap itu untuk menerima hasil yang menjadi bagiannya."
 },
 {
   "id": 23868,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 35,
   "firman": "Tetapi penggarap-penggarap itu menangkap hamba-hambanya itu: mereka memukul yang seorang, membunuh yang lain dan melempari yang lain pula dengan batu."
 },
 {
   "id": 23869,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 36,
   "firman": "Kemudian tuan itu menyuruh pula hamba-hamba yang lain, lebih banyak dari pada yang semula, tetapi merekapun diperlakukan sama seperti kawan-kawan mereka."
 },
 {
   "id": 23870,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 37,
   "firman": "Akhirnya ia menyuruh anaknya kepada mereka, katanya: Anakku akan mereka segani."
 },
 {
   "id": 23871,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 38,
   "firman": "Tetapi ketika penggarap-penggarap itu melihat anaknya itu, mereka berkata seorang kepada yang lain: Ia adalah ahli waris, mari kita bunuh dia, supaya warisannya menjadi milik kita."
 },
 {
   "id": 23872,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 39,
   "firman": "Mereka menangkapnya dan melemparkannya ke luar kebun anggur itu, lalu membunuhnya."
 },
 {
   "id": 23873,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 40,
   "firman": "Maka apabila tuan kebun anggur itu datang, apakah yang akan dilakukannya dengan penggarap-penggarap itu?\""
 },
 {
   "id": 23874,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 41,
   "firman": "Kata mereka kepada-Nya: \"Ia akan membinasakan orang-orang jahat itu dan kebun anggurnya akan disewakannya kepada penggarap-penggarap lain, yang akan menyerahkan hasilnya kepadanya pada waktunya.\""
 },
 {
   "id": 23875,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 42,
   "firman": "Kata Yesus kepada mereka: \"Belum pernahkah kamu baca dalam Kitab Suci: Batu yang dibuang oleh tukang-tukang bangunan telah menjadi batu penjuru: hal itu terjadi dari pihak Tuhan, suatu perbuatan ajaib di mata kita."
 },
 {
   "id": 23876,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 43,
   "firman": "Sebab itu, Aku berkata kepadamu, bahwa Kerajaan Allah akan diambil dari padamu dan akan diberikan kepada suatu bangsa yang akan menghasilkan buah Kerajaan itu."
 },
 {
   "id": 23877,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 44,
   "firman": "(Dan barangsiapa jatuh ke atas batu itu, ia akan hancur dan barangsiapa ditimpa batu itu, ia akan remuk.)\""
 },
 {
   "id": 23878,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 45,
   "firman": "Ketika imam-imam kepala dan orang-orang Farisi mendengar perumpamaan-perumpamaan Yesus, mereka mengerti, bahwa merekalah yang dimaksudkan-Nya."
 },
 {
   "id": 23879,
   "kitab": "Mat",
   "pasal": 21,
   "ayat": 46,
   "firman": "Dan mereka berusaha untuk menangkap Dia, tetapi mereka takut kepada orang banyak, karena orang banyak itu menganggap Dia nabi."
 },
 {
   "id": 23880,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu Yesus berbicara pula dalam perumpamaan kepada mereka:"
 },
 {
   "id": 23881,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 2,
   "firman": "\"Hal Kerajaan Sorga seumpama seorang raja, yang mengadakan perjamuan kawin untuk anaknya."
 },
 {
   "id": 23882,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 3,
   "firman": "Ia menyuruh hamba-hambanya memanggil orang-orang yang telah diundang ke perjamuan kawin itu, tetapi orang-orang itu tidak mau datang."
 },
 {
   "id": 23883,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 4,
   "firman": "Ia menyuruh pula hamba-hamba lain, pesannya: Katakanlah kepada orang-orang yang diundang itu: Sesungguhnya hidangan, telah kusediakan, lembu-lembu jantan dan ternak piaraanku telah disembelih; semuanya telah tersedia, datanglah ke perjamuan kawin ini."
 },
 {
   "id": 23884,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 5,
   "firman": "Tetapi orang-orang yang diundang itu tidak mengindahkannya; ada yang pergi ke ladangnya, ada yang pergi mengurus usahanya,"
 },
 {
   "id": 23885,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 6,
   "firman": "dan yang lain menangkap hamba-hambanya itu, menyiksanya dan membunuhnya."
 },
 {
   "id": 23886,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 7,
   "firman": "Maka murkalah raja itu, lalu menyuruh pasukannya ke sana untuk membinasakan pembunuh-pembunuh itu dan membakar kota mereka."
 },
 {
   "id": 23887,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 8,
   "firman": "Sesudah itu ia berkata kepada hamba-hambanya: Perjamuan kawin telah tersedia, tetapi orang-orang yang diundang tadi tidak layak untuk itu."
 },
 {
   "id": 23888,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 9,
   "firman": "Sebab itu pergilah ke persimpangan-persimpangan jalan dan undanglah setiap orang yang kamu jumpai di sana ke perjamuan kawin itu."
 },
 {
   "id": 23889,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 10,
   "firman": "Maka pergilah hamba-hamba itu dan mereka mengumpulkan semua orang yang dijumpainya di jalan-jalan, orang-orang jahat dan orang-orang baik, sehingga penuhlah ruangan perjamuan kawin itu dengan tamu."
 },
 {
   "id": 23890,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 11,
   "firman": "Ketika raja itu masuk untuk bertemu dengan tamu-tamu itu, ia melihat seorang yang tidak berpakaian pesta."
 },
 {
   "id": 23891,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 12,
   "firman": "Ia berkata kepadanya: Hai saudara, bagaimana engkau masuk ke mari dengan tidak mengenakan pakaian pesta? Tetapi orang itu diam saja."
 },
 {
   "id": 23892,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 13,
   "firman": "Lalu kata raja itu kepada hamba-hambanya: Ikatlah kaki dan tangannya dan campakkanlah orang itu ke dalam kegelapan yang paling gelap, di sanalah akan terdapat ratap dan kertak gigi."
 },
 {
   "id": 23893,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 14,
   "firman": "Sebab banyak yang dipanggil, tetapi sedikit yang dipilih.\""
 },
 {
   "id": 23894,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 15,
   "firman": "Kemudian pergilah orang-orang Farisi; mereka berunding bagaimana mereka dapat menjerat Yesus dengan suatu pertanyaan."
 },
 {
   "id": 23895,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 16,
   "firman": "Mereka menyuruh murid-murid mereka bersama-sama orang-orang Herodian bertanya kepada-Nya: \"Guru, kami tahu, Engkau adalah seorang yang jujur dan dengan jujur mengajar jalan Allah dan Engkau tidak takut kepada siapapun juga, sebab Engkau tidak mencari muka."
 },
 {
   "id": 23896,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 17,
   "firman": "Katakanlah kepada kami pendapat-Mu: Apakah diperbolehkan membayar pajak kepada Kaisar atau tidak?\""
 },
 {
   "id": 23897,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 18,
   "firman": "Tetapi Yesus mengetahui kejahatan hati mereka itu lalu berkata: \"Mengapa kamu mencobai Aku, hai orang-orang munafik?"
 },
 {
   "id": 23898,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 19,
   "firman": "Tunjukkanlah kepada-Ku mata uang untuk pajak itu.\" Mereka membawa suatu dinar kepada-Nya."
 },
 {
   "id": 23899,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 20,
   "firman": "Maka Ia bertanya kepada mereka: \"Gambar dan tulisan siapakah ini?\""
 },
 {
   "id": 23900,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 21,
   "firman": "Jawab mereka: \"Gambar dan tulisan Kaisar.\" Lalu kata Yesus kepada mereka: \"Berikanlah kepada Kaisar apa yang wajib kamu berikan kepada Kaisar dan kepada Allah apa yang wajib kamu berikan kepada Allah.\""
 },
 {
   "id": 23901,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 22,
   "firman": "Mendengar itu heranlah mereka dan meninggalkan Yesus lalu pergi."
 },
 {
   "id": 23902,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 23,
   "firman": "Pada hari itu datanglah kepada Yesus beberapa orang Saduki, yang berpendapat, bahwa tidak ada kebangkitan. Mereka bertanya kepada-Nya:"
 },
 {
   "id": 23903,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 24,
   "firman": "\"Guru, Musa mengatakan, bahwa jika seorang mati dengan tiada meninggalkan anak, saudaranya harus kawin dengan isterinya itu dan membangkitkan keturunan bagi saudaranya itu."
 },
 {
   "id": 23904,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 25,
   "firman": "Tetapi di antara kami ada tujuh orang bersaudara. Yang pertama kawin, tetapi kemudian mati. Dan karena ia tidak mempunyai keturunan, ia meninggalkan isterinya itu bagi saudaranya."
 },
 {
   "id": 23905,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 26,
   "firman": "Demikian juga yang kedua dan yang ketiga sampai dengan yang ketujuh."
 },
 {
   "id": 23906,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 27,
   "firman": "Dan akhirnya, sesudah mereka semua, perempuan itupun mati."
 },
 {
   "id": 23907,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 28,
   "firman": "Siapakah di antara ketujuh orang itu yang menjadi suami perempuan itu pada hari kebangkitan? Sebab mereka semua telah beristerikan dia.\""
 },
 {
   "id": 23908,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 29,
   "firman": "Yesus menjawab mereka: \"Kamu sesat, sebab kamu tidak mengerti Kitab Suci maupun kuasa Allah!"
 },
 {
   "id": 23909,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 30,
   "firman": "Karena pada waktu kebangkitan orang tidak kawin dan tidak dikawinkan melainkan hidup seperti malaikat di sorga."
 },
 {
   "id": 23910,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 31,
   "firman": "Tetapi tentang kebangkitan orang-orang mati tidakkah kamu baca apa yang difirmankan Allah, ketika Ia bersabda:"
 },
 {
   "id": 23911,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 32,
   "firman": "Akulah Allah Abraham, Allah Ishak dan Allah Yakub? Ia bukanlah Allah orang mati, melainkan Allah orang hidup.\""
 },
 {
   "id": 23912,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 33,
   "firman": "Orang banyak yang mendengar itu takjub akan pengajaran-Nya."
 },
 {
   "id": 23913,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 34,
   "firman": "Ketika orang-orang Farisi mendengar, bahwa Yesus telah membuat orang-orang Saduki itu bungkam, berkumpullah mereka"
 },
 {
   "id": 23914,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 35,
   "firman": "dan seorang dari mereka, seorang ahli Taurat, bertanya untuk mencobai Dia:"
 },
 {
   "id": 23915,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 36,
   "firman": "\"Guru, hukum manakah yang terutama dalam hukum Taurat?\""
 },
 {
   "id": 23916,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 37,
   "firman": "Jawab Yesus kepadanya: \"Kasihilah Tuhan, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu dan dengan segenap akal budimu."
 },
 {
   "id": 23917,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 38,
   "firman": "Itulah hukum yang terutama dan yang pertama."
 },
 {
   "id": 23918,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 39,
   "firman": "Dan hukum yang kedua, yang sama dengan itu, ialah: Kasihilah sesamamu manusia seperti dirimu sendiri."
 },
 {
   "id": 23919,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 40,
   "firman": "Pada kedua hukum inilah tergantung seluruh hukum Taurat dan kitab para nabi.\""
 },
 {
   "id": 23920,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 41,
   "firman": "Ketika orang-orang Farisi sedang berkumpul, Yesus bertanya kepada mereka, kata-Nya:"
 },
 {
   "id": 23921,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 42,
   "firman": "\"Apakah pendapatmu tentang Mesias? Anak siapakah Dia?\" Kata mereka kepada-Nya: \"Anak Daud.\""
 },
 {
   "id": 23922,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 43,
   "firman": "Kata-Nya kepada mereka: \"Jika demikian, bagaimanakah Daud oleh pimpinan Roh dapat menyebut Dia Tuannya, ketika ia berkata:"
 },
 {
   "id": 23923,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 44,
   "firman": "Tuhan telah berfirman kepada Tuanku: duduklah di sebelah kanan-Ku, sampai musuh-musuh-Mu Kutaruh di bawah kaki-Mu."
 },
 {
   "id": 23924,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 45,
   "firman": "Jadi jika Daud menyebut Dia Tuannya, bagaimana mungkin Ia anaknya pula?\""
 },
 {
   "id": 23925,
   "kitab": "Mat",
   "pasal": 22,
   "ayat": 46,
   "firman": "Tidak ada seorangpun yang dapat menjawab-Nya, dan sejak hari itu tidak ada seorangpun juga yang berani menanyakan sesuatu kepada-Nya."
 },
 {
   "id": 23926,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 1,
   "firman": "Maka berkatalah Yesus kepada orang banyak dan kepada murid-murid-Nya, kata-Nya:"
 },
 {
   "id": 23927,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 2,
   "firman": "\"Ahli-ahli Taurat dan orang-orang Farisi telah menduduki kursi Musa."
 },
 {
   "id": 23928,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 3,
   "firman": "Sebab itu turutilah dan lakukanlah segala sesuatu yang mereka ajarkan kepadamu, tetapi janganlah kamu turuti perbuatan-perbuatan mereka, karena mereka mengajarkannya tetapi tidak melakukannya."
 },
 {
   "id": 23929,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 4,
   "firman": "Mereka mengikat beban-beban berat, lalu meletakkannya di atas bahu orang, tetapi mereka sendiri tidak mau menyentuhnya."
 },
 {
   "id": 23930,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 5,
   "firman": "Semua pekerjaan yang mereka lakukan hanya dimaksud supaya dilihat orang; mereka memakai tali sembahyang yang lebar dan jumbai yang panjang;"
 },
 {
   "id": 23931,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 6,
   "firman": "mereka suka duduk di tempat terhormat dalam perjamuan dan di tempat terdepan di rumah ibadat;"
 },
 {
   "id": 23932,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 7,
   "firman": "mereka suka menerima penghormatan di pasar dan suka dipanggil Rabi."
 },
 {
   "id": 23933,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 8,
   "firman": "Tetapi kamu, janganlah kamu disebut Rabi; karena hanya satu Rabimu dan kamu semua adalah saudara."
 },
 {
   "id": 23934,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 9,
   "firman": "Dan janganlah kamu menyebut siapapun bapa di bumi ini, karena hanya satu Bapamu, yaitu Dia yang di sorga."
 },
 {
   "id": 23935,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 10,
   "firman": "Janganlah pula kamu disebut pemimpin, karena hanya satu Pemimpinmu, yaitu Mesias."
 },
 {
   "id": 23936,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 11,
   "firman": "Barangsiapa terbesar di antara kamu, hendaklah ia menjadi pelayanmu."
 },
 {
   "id": 23937,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 12,
   "firman": "Dan barangsiapa meninggikan diri, ia akan direndahkan dan barangsiapa merendahkan diri, ia akan ditinggikan."
 },
 {
   "id": 23938,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 13,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, karena kamu menutup pintu-pintu Kerajaan Sorga di depan orang. Sebab kamu sendiri tidak masuk dan kamu merintangi mereka yang berusaha untuk masuk."
 },
 {
   "id": 23939,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 14,
   "firman": "(Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab kamu menelan rumah janda-janda sedang kamu mengelabui mata orang dengan doa yang panjang-panjang. Sebab itu kamu pasti akan menerima hukuman yang lebih berat.)"
 },
 {
   "id": 23940,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 15,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab kamu mengarungi lautan dan menjelajah daratan, untuk mentobatkan satu orang saja menjadi penganut agamamu dan sesudah ia bertobat, kamu menjadikan dia orang neraka, yang dua kali lebih jahat dari pada kamu sendiri."
 },
 {
   "id": 23941,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 16,
   "firman": "Celakalah kamu, hai pemimpin-pemimpin buta, yang berkata: Bersumpah demi Bait Suci, sumpah itu tidak sah; tetapi bersumpah demi emas Bait Suci, sumpah itu mengikat."
 },
 {
   "id": 23942,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 17,
   "firman": "Hai kamu orang-orang bodoh dan orang-orang buta, apakah yang lebih penting, emas atau Bait Suci yang menguduskan emas itu?"
 },
 {
   "id": 23943,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 18,
   "firman": "Bersumpah demi mezbah, sumpah itu tidak sah; tetapi bersumpah demi persembahan yang ada di atasnya, sumpah itu mengikat."
 },
 {
   "id": 23944,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 19,
   "firman": "Hai kamu orang-orang buta, apakah yang lebih penting, persembahan atau mezbah yang menguduskan persembahan itu?"
 },
 {
   "id": 23945,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 20,
   "firman": "Karena itu barangsiapa bersumpah demi mezbah, ia bersumpah demi mezbah dan juga demi segala sesuatu yang terletak di atasnya."
 },
 {
   "id": 23946,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 21,
   "firman": "Dan barangsiapa bersumpah demi Bait Suci, ia bersumpah demi Bait Suci dan juga demi Dia, yang diam di situ."
 },
 {
   "id": 23947,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 22,
   "firman": "Dan barangsiapa bersumpah demi sorga, ia bersumpah demi takhta Allah dan juga demi Dia, yang bersemayam di atasnya."
 },
 {
   "id": 23948,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 23,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab persepuluhan dari selasih, adas manis dan jintan kamu bayar, tetapi yang terpenting dalam hukum Taurat kamu abaikan, yaitu: keadilan dan belas kasihan dan kesetiaan. Yang satu harus dilakukan dan yang lain jangan diabaikan."
 },
 {
   "id": 23949,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 24,
   "firman": "Hai kamu pemimpin-pemimpin buta, nyamuk kamu tapiskan dari dalam minumanmu, tetapi unta yang di dalamnya kamu telan."
 },
 {
   "id": 23950,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 25,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab cawan dan pinggan kamu bersihkan sebelah luarnya, tetapi sebelah dalamnya penuh rampasan dan kerakusan."
 },
 {
   "id": 23951,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 26,
   "firman": "Hai orang Farisi yang buta, bersihkanlah dahulu sebelah dalam cawan itu, maka sebelah luarnya juga akan bersih."
 },
 {
   "id": 23952,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 27,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab kamu sama seperti kuburan yang dilabur putih, yang sebelah luarnya memang bersih tampaknya, tetapi yang sebelah dalamnya penuh tulang belulang dan pelbagai jenis kotoran."
 },
 {
   "id": 23953,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 28,
   "firman": "Demikian jugalah kamu, di sebelah luar kamu tampaknya benar di mata orang, tetapi di sebelah dalam kamu penuh kemunafikan dan kedurjanaan."
 },
 {
   "id": 23954,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 29,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat dan orang-orang Farisi, hai kamu orang-orang munafik, sebab kamu membangun makam nabi-nabi dan memperindah tugu orang-orang saleh"
 },
 {
   "id": 23955,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 30,
   "firman": "dan berkata: Jika kami hidup di zaman nenek moyang kita, tentulah kami tidak ikut dengan mereka dalam pembunuhan nabi-nabi itu."
 },
 {
   "id": 23956,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 31,
   "firman": "Tetapi dengan demikian kamu bersaksi terhadap diri kamu sendiri, bahwa kamu adalah keturunan pembunuh nabi-nabi itu."
 },
 {
   "id": 23957,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 32,
   "firman": "Jadi, penuhilah juga takaran nenek moyangmu!"
 },
 {
   "id": 23958,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 33,
   "firman": "Hai kamu ular-ular, hai kamu keturunan ular beludak! Bagaimanakah mungkin kamu dapat meluputkan diri dari hukuman neraka?"
 },
 {
   "id": 23959,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 34,
   "firman": "Sebab itu, lihatlah, Aku mengutus kepadamu nabi-nabi, orang-orang bijaksana dan ahli-ahli Taurat: separuh di antara mereka akan kamu bunuh dan kamu salibkan, yang lain akan kamu sesah di rumah-rumah ibadatmu dan kamu aniaya dari kota ke kota,"
 },
 {
   "id": 23960,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 35,
   "firman": "supaya kamu menanggung akibat penumpahan darah orang yang tidak bersalah mulai dari Habel, orang benar itu, sampai kepada Zakharia anak Berekhya, yang kamu bunuh di antara tempat kudus dan mezbah."
 },
 {
   "id": 23961,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 36,
   "firman": "Aku berkata kepadamu: Sesungguhnya semuanya ini akan ditanggung angkatan ini!\""
 },
 {
   "id": 23962,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 37,
   "firman": "\"Yerusalem, Yerusalem, engkau yang membunuh nabi-nabi dan melempari dengan batu orang-orang yang diutus kepadamu! Berkali-kali Aku rindu mengumpulkan anak-anakmu, sama seperti induk ayam mengumpulkan anak-anaknya di bawah sayapnya, tetapi kamu tidak mau."
 },
 {
   "id": 23963,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 38,
   "firman": "Lihatlah rumahmu ini akan ditinggalkan dan menjadi sunyi."
 },
 {
   "id": 23964,
   "kitab": "Mat",
   "pasal": 23,
   "ayat": 39,
   "firman": "Dan Aku berkata kepadamu: Mulai sekarang kamu tidak akan melihat Aku lagi, hingga kamu berkata: Diberkatilah Dia yang datang dalam nama Tuhan!\""
 },
 {
   "id": 23965,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 1,
   "firman": "Sesudah itu Yesus keluar dari Bait Allah, lalu pergi. Maka datanglah murid-murid-Nya dan menunjuk kepada bangunan-bangunan Bait Allah."
 },
 {
   "id": 23966,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 2,
   "firman": "Ia berkata kepada mereka: \"Kamu melihat semuanya itu? Aku berkata kepadamu, sesungguhnya tidak satu batupun di sini akan dibiarkan terletak di atas batu yang lain; semuanya akan diruntuhkan.\""
 },
 {
   "id": 23967,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 3,
   "firman": "Ketika Yesus duduk di atas Bukit Zaitun, datanglah murid-murid-Nya kepada-Nya untuk bercakap-cakap sendirian dengan Dia. Kata mereka: \"Katakanlah kepada kami, bilamanakah itu akan terjadi dan apakah tanda kedatangan-Mu dan tanda kesudahan dunia?\""
 },
 {
   "id": 23968,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 4,
   "firman": "Jawab Yesus kepada mereka: \"Waspadalah supaya jangan ada orang yang menyesatkan kamu!"
 },
 {
   "id": 23969,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 5,
   "firman": "Sebab banyak orang akan datang dengan memakai nama-Ku dan berkata: Akulah Mesias, dan mereka akan menyesatkan banyak orang."
 },
 {
   "id": 23970,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 6,
   "firman": "Kamu akan mendengar deru perang atau kabar-kabar tentang perang. Namun berawas-awaslah jangan kamu gelisah; sebab semuanya itu harus terjadi, tetapi itu belum kesudahannya."
 },
 {
   "id": 23971,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 7,
   "firman": "Sebab bangsa akan bangkit melawan bangsa, dan kerajaan melawan kerajaan. Akan ada kelaparan dan gempa bumi di berbagai tempat."
 },
 {
   "id": 23972,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 8,
   "firman": "Akan tetapi semuanya itu barulah permulaan penderitaan menjelang zaman baru."
 },
 {
   "id": 23973,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 9,
   "firman": "Pada waktu itu kamu akan diserahkan supaya disiksa, dan kamu akan dibunuh dan akan dibenci semua bangsa oleh karena nama-Ku,"
 },
 {
   "id": 23974,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 10,
   "firman": "dan banyak orang akan murtad dan mereka akan saling menyerahkan dan saling membenci."
 },
 {
   "id": 23975,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 11,
   "firman": "Banyak nabi palsu akan muncul dan menyesatkan banyak orang."
 },
 {
   "id": 23976,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 12,
   "firman": "Dan karena makin bertambahnya kedurhakaan, maka kasih kebanyakan orang akan menjadi dingin."
 },
 {
   "id": 23977,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 13,
   "firman": "Tetapi orang yang bertahan sampai pada kesudahannya akan selamat."
 },
 {
   "id": 23978,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 14,
   "firman": "Dan Injil Kerajaan ini akan diberitakan di seluruh dunia menjadi kesaksian bagi semua bangsa, sesudah itu barulah tiba kesudahannya.\""
 },
 {
   "id": 23979,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 15,
   "firman": "\"Jadi apabila kamu melihat Pembinasa keji berdiri di tempat kudus, menurut firman yang disampaikan oleh nabi Daniel--para pembaca hendaklah memperhatikannya--"
 },
 {
   "id": 23980,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 16,
   "firman": "maka orang-orang yang di Yudea haruslah melarikan diri ke pegunungan."
 },
 {
   "id": 23981,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 17,
   "firman": "Orang yang sedang di peranginan di atas rumah janganlah ia turun untuk mengambil barang-barang dari rumahnya,"
 },
 {
   "id": 23982,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 18,
   "firman": "dan orang yang sedang di ladang janganlah ia kembali untuk mengambil pakaiannya."
 },
 {
   "id": 23983,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 19,
   "firman": "Celakalah ibu-ibu yang sedang hamil atau yang menyusukan bayi pada masa itu."
 },
 {
   "id": 23984,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 20,
   "firman": "Berdoalah, supaya waktu kamu melarikan diri itu jangan jatuh pada musim dingin dan jangan pada hari Sabat."
 },
 {
   "id": 23985,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 21,
   "firman": "Sebab pada masa itu akan terjadi siksaan yang dahsyat seperti yang belum pernah terjadi sejak awal dunia sampai sekarang dan yang tidak akan terjadi lagi."
 },
 {
   "id": 23986,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 22,
   "firman": "Dan sekiranya waktunya tidak dipersingkat, maka dari segala yang hidup tidak akan ada yang selamat; akan tetapi oleh karena orang-orang pilihan waktu itu akan dipersingkat."
 },
 {
   "id": 23987,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 23,
   "firman": "Pada waktu itu jika orang berkata kepada kamu: Lihat, Mesias ada di sini, atau Mesias ada di sana, jangan kamu percaya."
 },
 {
   "id": 23988,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 24,
   "firman": "Sebab Mesias-mesias palsu dan nabi-nabi palsu akan muncul dan mereka akan mengadakan tanda-tanda yang dahsyat dan mujizat-mujizat, sehingga sekiranya mungkin, mereka menyesatkan orang-orang pilihan juga."
 },
 {
   "id": 23989,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 25,
   "firman": "Camkanlah, Aku sudah mengatakannya terlebih dahulu kepadamu."
 },
 {
   "id": 23990,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 26,
   "firman": "Jadi, apabila orang berkata kepadamu: Lihat, Ia ada di padang gurun, janganlah kamu pergi ke situ; atau: Lihat, Ia ada di dalam bilik, janganlah kamu percaya."
 },
 {
   "id": 23991,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 27,
   "firman": "Sebab sama seperti kilat memancar dari sebelah timur dan melontarkan cahayanya sampai ke barat, demikian pulalah kelak kedatangan Anak Manusia."
 },
 {
   "id": 23992,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 28,
   "firman": "Di mana ada bangkai, di situ burung nazar berkerumun.\""
 },
 {
   "id": 23993,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 29,
   "firman": "\"Segera sesudah siksaan pada masa itu, matahari akan menjadi gelap dan bulan tidak bercahaya dan bintang-bintang akan berjatuhan dari langit dan kuasa-kuasa langit akan goncang."
 },
 {
   "id": 23994,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 30,
   "firman": "Pada waktu itu akan tampak tanda Anak Manusia di langit dan semua bangsa di bumi akan meratap dan mereka akan melihat Anak Manusia itu datang di atas awan-awan di langit dengan segala kekuasaan dan kemuliaan-Nya."
 },
 {
   "id": 23995,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 31,
   "firman": "Dan Ia akan menyuruh keluar malaikat-malaikat-Nya dengan meniup sangkakala yang dahsyat bunyinya dan mereka akan mengumpulkan orang-orang pilihan-Nya dari keempat penjuru bumi, dari ujung langit yang satu ke ujung langit yang lain."
 },
 {
   "id": 23996,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 32,
   "firman": "Tariklah pelajaran dari perumpamaan tentang pohon ara: Apabila ranting-rantingnya melembut dan mulai bertunas, kamu tahu, bahwa musim panas sudah dekat."
 },
 {
   "id": 23997,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 33,
   "firman": "Demikian juga, jika kamu melihat semuanya ini, ketahuilah, bahwa waktunya sudah dekat, sudah di ambang pintu."
 },
 {
   "id": 23998,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 34,
   "firman": "Aku berkata kepadamu: Sesungguhnya angkatan ini tidak akan berlalu, sebelum semuanya ini terjadi."
 },
 {
   "id": 23999,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 35,
   "firman": "Langit dan bumi akan berlalu, tetapi perkataan-Ku tidak akan berlalu."
 },
 {
   "id": 24000,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 36,
   "firman": "Tetapi tentang hari dan saat itu tidak seorangpun yang tahu, malaikat-malaikat di sorga tidak, dan Anakpun tidak, hanya Bapa sendiri.\""
 },
 {
   "id": 24001,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 37,
   "firman": "\"Sebab sebagaimana halnya pada zaman Nuh, demikian pula halnya kelak pada kedatangan Anak Manusia."
 },
 {
   "id": 24002,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 38,
   "firman": "Sebab sebagaimana mereka pada zaman sebelum air bah itu makan dan minum, kawin dan mengawinkan, sampai kepada hari Nuh masuk ke dalam bahtera,"
 },
 {
   "id": 24003,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 39,
   "firman": "dan mereka tidak tahu akan sesuatu, sebelum air bah itu datang dan melenyapkan mereka semua, demikian pulalah halnya kelak pada kedatangan Anak Manusia."
 },
 {
   "id": 24004,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 40,
   "firman": "Pada waktu itu kalau ada dua orang di ladang, yang seorang akan dibawa dan yang lain akan ditinggalkan;"
 },
 {
   "id": 24005,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 41,
   "firman": "kalau ada dua orang perempuan sedang memutar batu kilangan, yang seorang akan dibawa dan yang lain akan ditinggalkan."
 },
 {
   "id": 24006,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 42,
   "firman": "Karena itu berjaga-jagalah, sebab kamu tidak tahu pada hari mana Tuhanmu datang."
 },
 {
   "id": 24007,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 43,
   "firman": "Tetapi ketahuilah ini: Jika tuan rumah tahu pada waktu mana pada malam hari pencuri akan datang, sudahlah pasti ia berjaga-jaga, dan tidak akan membiarkan rumahnya dibongkar."
 },
 {
   "id": 24008,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 44,
   "firman": "Sebab itu, hendaklah kamu juga siap sedia, karena Anak Manusia datang pada saat yang tidak kamu duga.\""
 },
 {
   "id": 24009,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 45,
   "firman": "\"Siapakah hamba yang setia dan bijaksana, yang diangkat oleh tuannya atas orang-orangnya untuk memberikan mereka makanan pada waktunya?"
 },
 {
   "id": 24010,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 46,
   "firman": "Berbahagialah hamba, yang didapati tuannya melakukan tugasnya itu, ketika tuannya itu datang."
 },
 {
   "id": 24011,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 47,
   "firman": "Aku berkata kepadamu: Sesungguhnya tuannya itu akan mengangkat dia menjadi pengawas segala miliknya."
 },
 {
   "id": 24012,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 48,
   "firman": "Akan tetapi apabila hamba itu jahat dan berkata di dalam hatinya:"
 },
 {
   "id": 24013,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 49,
   "firman": "Tuanku tidak datang-datang, lalu ia mulai memukul hamba-hamba lain, dan makan minum bersama-sama pemabuk-pemabuk,"
 },
 {
   "id": 24014,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 50,
   "firman": "maka tuan hamba itu akan datang pada hari yang tidak disangkakannya, dan pada saat yang tidak diketahuinya,"
 },
 {
   "id": 24015,
   "kitab": "Mat",
   "pasal": 24,
   "ayat": 51,
   "firman": "dan akan membunuh dia dan membuat dia senasib dengan orang-orang munafik. Di sanalah akan terdapat ratapan dan kertakan gigi.\""
 },
 {
   "id": 24016,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 1,
   "firman": "\"Pada waktu itu hal Kerajaan Sorga seumpama sepuluh gadis, yang mengambil pelitanya dan pergi menyongsong mempelai laki-laki."
 },
 {
   "id": 24017,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 2,
   "firman": "Lima di antaranya bodoh dan lima bijaksana."
 },
 {
   "id": 24018,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 3,
   "firman": "Gadis-gadis yang bodoh itu membawa pelitanya, tetapi tidak membawa minyak,"
 },
 {
   "id": 24019,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 4,
   "firman": "sedangkan gadis-gadis yang bijaksana itu membawa pelitanya dan juga minyak dalam buli-buli mereka."
 },
 {
   "id": 24020,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 5,
   "firman": "Tetapi karena mempelai itu lama tidak datang-datang juga, mengantuklah mereka semua lalu tertidur."
 },
 {
   "id": 24021,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 6,
   "firman": "Waktu tengah malam terdengarlah suara orang berseru: Mempelai datang! Songsonglah dia!"
 },
 {
   "id": 24022,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 7,
   "firman": "Gadis-gadis itupun bangun semuanya lalu membereskan pelita mereka."
 },
 {
   "id": 24023,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 8,
   "firman": "Gadis-gadis yang bodoh berkata kepada gadis-gadis yang bijaksana: Berikanlah kami sedikit dari minyakmu itu, sebab pelita kami hampir padam."
 },
 {
   "id": 24024,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 9,
   "firman": "Tetapi jawab gadis-gadis yang bijaksana itu: Tidak, nanti tidak cukup untuk kami dan untuk kamu. Lebih baik kamu pergi kepada penjual minyak dan beli di situ."
 },
 {
   "id": 24025,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 10,
   "firman": "Akan tetapi, waktu mereka sedang pergi untuk membelinya, datanglah mempelai itu dan mereka yang telah siap sedia masuk bersama-sama dengan dia ke ruang perjamuan kawin, lalu pintu ditutup."
 },
 {
   "id": 24026,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 11,
   "firman": "Kemudian datang juga gadis-gadis yang lain itu dan berkata: Tuan, tuan, bukakanlah kami pintu!"
 },
 {
   "id": 24027,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 12,
   "firman": "Tetapi ia menjawab: Aku berkata kepadamu, sesungguhnya aku tidak mengenal kamu."
 },
 {
   "id": 24028,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 13,
   "firman": "Karena itu, berjaga-jagalah, sebab kamu tidak tahu akan hari maupun akan saatnya.\""
 },
 {
   "id": 24029,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 14,
   "firman": "\"Sebab hal Kerajaan Sorga sama seperti seorang yang mau bepergian ke luar negeri, yang memanggil hamba-hambanya dan mempercayakan hartanya kepada mereka."
 },
 {
   "id": 24030,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 15,
   "firman": "Yang seorang diberikannya lima talenta, yang seorang lagi dua dan yang seorang lain lagi satu, masing-masing menurut kesanggupannya, lalu ia berangkat."
 },
 {
   "id": 24031,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 16,
   "firman": "Segera pergilah hamba yang menerima lima talenta itu. Ia menjalankan uang itu lalu beroleh laba lima talenta."
 },
 {
   "id": 24032,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 17,
   "firman": "Hamba yang menerima dua talenta itupun berbuat demikian juga dan berlaba dua talenta."
 },
 {
   "id": 24033,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 18,
   "firman": "Tetapi hamba yang menerima satu talenta itu pergi dan menggali lobang di dalam tanah lalu menyembunyikan uang tuannya."
 },
 {
   "id": 24034,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 19,
   "firman": "Lama sesudah itu pulanglah tuan hamba-hamba itu lalu mengadakan perhitungan dengan mereka."
 },
 {
   "id": 24035,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 20,
   "firman": "Hamba yang menerima lima talenta itu datang dan ia membawa laba lima talenta, katanya: Tuan, lima talenta tuan percayakan kepadaku; lihat, aku telah beroleh laba lima talenta."
 },
 {
   "id": 24036,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 21,
   "firman": "Maka kata tuannya itu kepadanya: Baik sekali perbuatanmu itu, hai hambaku yang baik dan setia; engkau telah setia dalam perkara kecil, aku akan memberikan kepadamu tanggung jawab dalam perkara yang besar. Masuklah dan turutlah dalam kebahagiaan tuanmu."
 },
 {
   "id": 24037,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 22,
   "firman": "Lalu datanglah hamba yang menerima dua talenta itu, katanya: Tuan, dua talenta tuan percayakan kepadaku; lihat, aku telah beroleh laba dua talenta."
 },
 {
   "id": 24038,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 23,
   "firman": "Maka kata tuannya itu kepadanya: Baik sekali perbuatanmu itu, hai hambaku yang baik dan setia, engkau telah setia memikul tanggung jawab dalam perkara yang kecil, aku akan memberikan kepadamu tanggung jawab dalam perkara yang besar. Masuklah dan turutlah dalam kebahagiaan tuanmu."
 },
 {
   "id": 24039,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 24,
   "firman": "Kini datanglah juga hamba yang menerima satu talenta itu dan berkata: Tuan, aku tahu bahwa tuan adalah manusia yang kejam yang menuai di tempat di mana tuan tidak menabur dan yang memungut dari tempat di mana tuan tidak menanam."
 },
 {
   "id": 24040,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 25,
   "firman": "Karena itu aku takut dan pergi menyembunyikan talenta tuan itu di dalam tanah: Ini, terimalah kepunyaan tuan!"
 },
 {
   "id": 24041,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 26,
   "firman": "Maka jawab tuannya itu: Hai kamu, hamba yang jahat dan malas, jadi kamu sudah tahu, bahwa aku menuai di tempat di mana aku tidak menabur dan memungut dari tempat di mana aku tidak menanam?"
 },
 {
   "id": 24042,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 27,
   "firman": "Karena itu sudahlah seharusnya uangku itu kauberikan kepada orang yang menjalankan uang, supaya sekembaliku aku menerimanya serta dengan bunganya."
 },
 {
   "id": 24043,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 28,
   "firman": "Sebab itu ambillah talenta itu dari padanya dan berikanlah kepada orang yang mempunyai sepuluh talenta itu."
 },
 {
   "id": 24044,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 29,
   "firman": "Karena setiap orang yang mempunyai, kepadanya akan diberi, sehingga ia berkelimpahan. Tetapi siapa yang tidak mempunyai, apapun juga yang ada padanya akan diambil dari padanya."
 },
 {
   "id": 24045,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 30,
   "firman": "Dan campakkanlah hamba yang tidak berguna itu ke dalam kegelapan yang paling gelap. Di sanalah akan terdapat ratap dan kertak gigi.\""
 },
 {
   "id": 24046,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 31,
   "firman": "\"Apabila Anak Manusia datang dalam kemuliaan-Nya dan semua malaikat bersama-sama dengan Dia, maka Ia akan bersemayam di atas takhta kemuliaan-Nya."
 },
 {
   "id": 24047,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 32,
   "firman": "Lalu semua bangsa akan dikumpulkan di hadapan-Nya dan Ia akan memisahkan mereka seorang dari pada seorang, sama seperti gembala memisahkan domba dari kambing,"
 },
 {
   "id": 24048,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 33,
   "firman": "dan Ia akan menempatkan domba-domba di sebelah kanan-Nya dan kambing-kambing di sebelah kiri-Nya."
 },
 {
   "id": 24049,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 34,
   "firman": "Dan Raja itu akan berkata kepada mereka yang di sebelah kanan-Nya: Mari, hai kamu yang diberkati oleh Bapa-Ku, terimalah Kerajaan yang telah disediakan bagimu sejak dunia dijadikan."
 },
 {
   "id": 24050,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 35,
   "firman": "Sebab ketika Aku lapar, kamu memberi Aku makan; ketika Aku haus, kamu memberi Aku minum; ketika Aku seorang asing, kamu memberi Aku tumpangan;"
 },
 {
   "id": 24051,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 36,
   "firman": "ketika Aku telanjang, kamu memberi Aku pakaian; ketika Aku sakit, kamu melawat Aku; ketika Aku di dalam penjara, kamu mengunjungi Aku."
 },
 {
   "id": 24052,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 37,
   "firman": "Maka orang-orang benar itu akan menjawab Dia, katanya: Tuhan, bilamanakah kami melihat Engkau lapar dan kami memberi Engkau makan, atau haus dan kami memberi Engkau minum?"
 },
 {
   "id": 24053,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 38,
   "firman": "Bilamanakah kami melihat Engkau sebagai orang asing, dan kami memberi Engkau tumpangan, atau telanjang dan kami memberi Engkau pakaian?"
 },
 {
   "id": 24054,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 39,
   "firman": "Bilamanakah kami melihat Engkau sakit atau dalam penjara dan kami mengunjungi Engkau?"
 },
 {
   "id": 24055,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 40,
   "firman": "Dan Raja itu akan menjawab mereka: Aku berkata kepadamu, sesungguhnya segala sesuatu yang kamu lakukan untuk salah seorang dari saudara-Ku yang paling hina ini, kamu telah melakukannya untuk Aku."
 },
 {
   "id": 24056,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 41,
   "firman": "Dan Ia akan berkata juga kepada mereka yang di sebelah kiri-Nya: Enyahlah dari hadapan-Ku, hai kamu orang-orang terkutuk, enyahlah ke dalam api yang kekal yang telah sedia untuk Iblis dan malaikat-malaikatnya."
 },
 {
   "id": 24057,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 42,
   "firman": "Sebab ketika Aku lapar, kamu tidak memberi Aku makan; ketika Aku haus, kamu tidak memberi Aku minum;"
 },
 {
   "id": 24058,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 43,
   "firman": "ketika Aku seorang asing, kamu tidak memberi Aku tumpangan; ketika Aku telanjang, kamu tidak memberi Aku pakaian; ketika Aku sakit dan dalam penjara, kamu tidak melawat Aku."
 },
 {
   "id": 24059,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 44,
   "firman": "Lalu merekapun akan menjawab Dia, katanya: Tuhan, bilamanakah kami melihat Engkau lapar, atau haus, atau sebagai orang asing, atau telanjang atau sakit, atau dalam penjara dan kami tidak melayani Engkau?"
 },
 {
   "id": 24060,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 45,
   "firman": "Maka Ia akan menjawab mereka: Aku berkata kepadamu, sesungguhnya segala sesuatu yang tidak kamu lakukan untuk salah seorang dari yang paling hina ini, kamu tidak melakukannya juga untuk Aku."
 },
 {
   "id": 24061,
   "kitab": "Mat",
   "pasal": 25,
   "ayat": 46,
   "firman": "Dan mereka ini akan masuk ke tempat siksaan yang kekal, tetapi orang benar ke dalam hidup yang kekal.\""
 },
 {
   "id": 24062,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 1,
   "firman": "Setelah Yesus selesai dengan segala pengajaran-Nya itu, berkatalah Ia kepada murid-murid-Nya:"
 },
 {
   "id": 24063,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 2,
   "firman": "\"Kamu tahu, bahwa dua hari lagi akan dirayakan Paskah, maka Anak Manusia akan diserahkan untuk disalibkan.\""
 },
 {
   "id": 24064,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 3,
   "firman": "Pada waktu itu berkumpullah imam-imam kepala dan tua-tua bangsa Yahudi di istana Imam Besar yang bernama Kayafas,"
 },
 {
   "id": 24065,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 4,
   "firman": "dan mereka merundingkan suatu rencana untuk menangkap Yesus dengan tipu muslihat dan untuk membunuh Dia."
 },
 {
   "id": 24066,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 5,
   "firman": "Tetapi mereka berkata: \"Jangan pada waktu perayaan, supaya jangan timbul keributan di antara rakyat.\""
 },
 {
   "id": 24067,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 6,
   "firman": "Ketika Yesus berada di Betania, di rumah Simon si kusta,"
 },
 {
   "id": 24068,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 7,
   "firman": "datanglah seorang perempuan kepada-Nya membawa sebuah buli-buli pualam berisi minyak wangi yang mahal. Minyak itu dicurahkannya ke atas kepala Yesus, yang sedang duduk makan."
 },
 {
   "id": 24069,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 8,
   "firman": "Melihat itu murid-murid gusar dan berkata: \"Untuk apa pemborosan ini?"
 },
 {
   "id": 24070,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 9,
   "firman": "Sebab minyak itu dapat dijual dengan mahal dan uangnya dapat diberikan kepada orang-orang miskin.\""
 },
 {
   "id": 24071,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 10,
   "firman": "Tetapi Yesus mengetahui pikiran mereka lalu berkata: \"Mengapa kamu menyusahkan perempuan ini? Sebab ia telah melakukan suatu perbuatan yang baik pada-Ku."
 },
 {
   "id": 24072,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 11,
   "firman": "Karena orang-orang miskin selalu ada padamu, tetapi Aku tidak akan selalu bersama-sama kamu."
 },
 {
   "id": 24073,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 12,
   "firman": "Sebab dengan mencurahkan minyak itu ke tubuh-Ku, ia membuat suatu persiapan untuk penguburan-Ku."
 },
 {
   "id": 24074,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 13,
   "firman": "Aku berkata kepadamu: Sesungguhnya di mana saja Injil ini diberitakan di seluruh dunia, apa yang dilakukannya ini akan disebut juga untuk mengingat dia.\""
 },
 {
   "id": 24075,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 14,
   "firman": "Kemudian pergilah seorang dari kedua belas murid itu, yang bernama Yudas Iskariot, kepada imam-imam kepala."
 },
 {
   "id": 24076,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 15,
   "firman": "Ia berkata: \"Apa yang hendak kamu berikan kepadaku, supaya aku menyerahkan Dia kepada kamu?\" Mereka membayar tiga puluh uang perak kepadanya."
 },
 {
   "id": 24077,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 16,
   "firman": "Dan mulai saat itu ia mencari kesempatan yang baik untuk menyerahkan Yesus."
 },
 {
   "id": 24078,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 17,
   "firman": "Pada hari pertama dari hari raya Roti Tidak Beragi datanglah murid-murid Yesus kepada-Nya dan berkata: \"Di mana Engkau kehendaki kami mempersiapkan perjamuan Paskah bagi-Mu?\""
 },
 {
   "id": 24079,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 18,
   "firman": "Jawab Yesus: \"Pergilah ke kota kepada si Anu dan katakan kepadanya: Pesan Guru: waktu-Ku hampir tiba; di dalam rumahmulah Aku mau merayakan Paskah bersama-sama dengan murid-murid-Ku.\""
 },
 {
   "id": 24080,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 19,
   "firman": "Lalu murid-murid-Nya melakukan seperti yang ditugaskan Yesus kepada mereka dan mempersiapkan Paskah."
 },
 {
   "id": 24081,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 20,
   "firman": "Setelah hari malam, Yesus duduk makan bersama-sama dengan kedua belas murid itu."
 },
 {
   "id": 24082,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 21,
   "firman": "Dan ketika mereka sedang makan, Ia berkata: \"Aku berkata kepadamu, sesungguhnya seorang di antara kamu akan menyerahkan Aku.\""
 },
 {
   "id": 24083,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 22,
   "firman": "Dan dengan hati yang sangat sedih berkatalah mereka seorang demi seorang kepada-Nya: \"Bukan aku, ya Tuhan?\""
 },
 {
   "id": 24084,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 23,
   "firman": "Ia menjawab: \"Dia yang bersama-sama dengan Aku mencelupkan tangannya ke dalam pinggan ini, dialah yang akan menyerahkan Aku."
 },
 {
   "id": 24085,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 24,
   "firman": "Anak Manusia memang akan pergi sesuai dengan yang ada tertulis tentang Dia, akan tetapi celakalah orang yang olehnya Anak Manusia itu diserahkan. Adalah lebih baik bagi orang itu sekiranya ia tidak dilahirkan.\""
 },
 {
   "id": 24086,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 25,
   "firman": "Yudas, yang hendak menyerahkan Dia itu menjawab, katanya: \"Bukan aku, ya Rabi?\" Kata Yesus kepadanya: \"Engkau telah mengatakannya.\""
 },
 {
   "id": 24087,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 26,
   "firman": "Dan ketika mereka sedang makan, Yesus mengambil roti, mengucap berkat, memecah-mecahkannya lalu memberikannya kepada murid-murid-Nya dan berkata: \"Ambillah, makanlah, inilah tubuh-Ku.\""
 },
 {
   "id": 24088,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 27,
   "firman": "Sesudah itu Ia mengambil cawan, mengucap syukur lalu memberikannya kepada mereka dan berkata: \"Minumlah, kamu semua, dari cawan ini."
 },
 {
   "id": 24089,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 28,
   "firman": "Sebab inilah darah-Ku, darah perjanjian, yang ditumpahkan bagi banyak orang untuk pengampunan dosa."
 },
 {
   "id": 24090,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 29,
   "firman": "Akan tetapi Aku berkata kepadamu: mulai dari sekarang Aku tidak akan minum lagi hasil pokok anggur ini sampai pada hari Aku meminumnya, yaitu yang baru, bersama-sama dengan kamu dalam Kerajaan Bapa-Ku.\""
 },
 {
   "id": 24091,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 30,
   "firman": "Sesudah menyanyikan nyanyian pujian, pergilah Yesus dan murid-murid-Nya ke Bukit Zaitun."
 },
 {
   "id": 24092,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 31,
   "firman": "Maka berkatalah Yesus kepada mereka: \"Malam ini kamu semua akan tergoncang imanmu karena Aku. Sebab ada tertulis: Aku akan membunuh gembala dan kawanan domba itu akan tercerai-berai."
 },
 {
   "id": 24093,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 32,
   "firman": "Akan tetapi sesudah Aku bangkit, Aku akan mendahului kamu ke Galilea.\""
 },
 {
   "id": 24094,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 33,
   "firman": "Petrus menjawab-Nya: \"Biarpun mereka semua tergoncang imannya karena Engkau, aku sekali-kali tidak.\""
 },
 {
   "id": 24095,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 34,
   "firman": "Yesus berkata kepadanya: \"Aku berkata kepadamu, sesungguhnya malam ini, sebelum ayam berkokok, engkau telah menyangkal Aku tiga kali.\""
 },
 {
   "id": 24096,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 35,
   "firman": "Kata Petrus kepada-Nya: \"Sekalipun aku harus mati bersama-sama Engkau, aku takkan menyangkal Engkau.\" Semua murid yang lainpun berkata demikian juga."
 },
 {
   "id": 24097,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 36,
   "firman": "Maka sampailah Yesus bersama-sama murid-murid-Nya ke suatu tempat yang bernama Getsemani. Lalu Ia berkata kepada murid-murid-Nya: \"Duduklah di sini, sementara Aku pergi ke sana untuk berdoa.\""
 },
 {
   "id": 24098,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 37,
   "firman": "Dan Ia membawa Petrus dan kedua anak Zebedeus serta-Nya. Maka mulailah Ia merasa sedih dan gentar,"
 },
 {
   "id": 24099,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 38,
   "firman": "lalu kata-Nya kepada mereka: \"Hati-Ku sangat sedih, seperti mau mati rasanya. Tinggallah di sini dan berjaga-jagalah dengan Aku.\""
 },
 {
   "id": 24100,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 39,
   "firman": "Maka Ia maju sedikit, lalu sujud dan berdoa, kata-Nya: \"Ya Bapa-Ku, jikalau sekiranya mungkin, biarlah cawan ini lalu dari pada-Ku, tetapi janganlah seperti yang Kukehendaki, melainkan seperti yang Engkau kehendaki.\""
 },
 {
   "id": 24101,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 40,
   "firman": "Setelah itu Ia kembali kepada murid-murid-Nya itu dan mendapati mereka sedang tidur. Dan Ia berkata kepada Petrus: \"Tidakkah kamu sanggup berjaga-jaga satu jam dengan Aku?"
 },
 {
   "id": 24102,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 41,
   "firman": "Berjaga-jagalah dan berdoalah, supaya kamu jangan jatuh ke dalam pencobaan: roh memang penurut, tetapi daging lemah.\""
 },
 {
   "id": 24103,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 42,
   "firman": "Lalu Ia pergi untuk kedua kalinya dan berdoa, kata-Nya: \"Ya Bapa-Ku jikalau cawan ini tidak mungkin lalu, kecuali apabila Aku meminumnya, jadilah kehendak-Mu!\""
 },
 {
   "id": 24104,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 43,
   "firman": "Dan ketika Ia kembali pula, Ia mendapati mereka sedang tidur, sebab mata mereka sudah berat."
 },
 {
   "id": 24105,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 44,
   "firman": "Ia membiarkan mereka di situ lalu pergi dan berdoa untuk ketiga kalinya dan mengucapkan doa yang itu juga."
 },
 {
   "id": 24106,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 45,
   "firman": "Sesudah itu Ia datang kepada murid-murid-Nya dan berkata kepada mereka: \"Tidurlah sekarang dan istirahatlah. Lihat, saatnya sudah tiba, bahwa Anak Manusia diserahkan ke tangan orang-orang berdosa."
 },
 {
   "id": 24107,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 46,
   "firman": "Bangunlah, marilah kita pergi. Dia yang menyerahkan Aku sudah dekat.\""
 },
 {
   "id": 24108,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 47,
   "firman": "Waktu Yesus masih berbicara datanglah Yudas, salah seorang dari kedua belas murid itu, dan bersama-sama dia serombongan besar orang yang membawa pedang dan pentung, disuruh oleh imam-imam kepala dan tua-tua bangsa Yahudi."
 },
 {
   "id": 24109,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 48,
   "firman": "Orang yang menyerahkan Dia telah memberitahukan tanda ini kepada mereka: \"Orang yang akan kucium, itulah Dia, tangkaplah Dia.\""
 },
 {
   "id": 24110,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 49,
   "firman": "Dan segera ia maju mendapatkan Yesus dan berkata: \"Salam Rabi,\" lalu mencium Dia."
 },
 {
   "id": 24111,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 50,
   "firman": "Tetapi Yesus berkata kepadanya: \"Hai teman, untuk itukah engkau datang?\" Maka majulah mereka memegang Yesus dan menangkap-Nya."
 },
 {
   "id": 24112,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 51,
   "firman": "Tetapi seorang dari mereka yang menyertai Yesus mengulurkan tangannya, menghunus pedangnya dan menetakkannya kepada hamba Imam Besar sehingga putus telinganya."
 },
 {
   "id": 24113,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 52,
   "firman": "Maka kata Yesus kepadanya: \"Masukkan pedang itu kembali ke dalam sarungnya, sebab barangsiapa menggunakan pedang, akan binasa oleh pedang."
 },
 {
   "id": 24114,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 53,
   "firman": "Atau kausangka, bahwa Aku tidak dapat berseru kepada Bapa-Ku, supaya Ia segera mengirim lebih dari dua belas pasukan malaikat membantu Aku?"
 },
 {
   "id": 24115,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 54,
   "firman": "Jika begitu, bagaimanakah akan digenapi yang tertulis dalam Kitab Suci, yang mengatakan, bahwa harus terjadi demikian?\""
 },
 {
   "id": 24116,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 55,
   "firman": "Pada saat itu Yesus berkata kepada orang banyak: \"Sangkamu Aku ini penyamun, maka kamu datang lengkap dengan pedang dan pentung untuk menangkap Aku? Padahal tiap-tiap hari Aku duduk mengajar di Bait Allah, dan kamu tidak menangkap Aku."
 },
 {
   "id": 24117,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 56,
   "firman": "Akan tetapi semua ini terjadi supaya genap yang ada tertulis dalam kitab nabi-nabi.\" Lalu semua murid itu meninggalkan Dia dan melarikan diri."
 },
 {
   "id": 24118,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 57,
   "firman": "Sesudah mereka menangkap Yesus, mereka membawa-Nya menghadap Kayafas, Imam Besar. Di situ telah berkumpul ahli-ahli Taurat dan tua-tua."
 },
 {
   "id": 24119,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 58,
   "firman": "Dan Petrus mengikuti Dia dari jauh sampai ke halaman Imam Besar, dan setelah masuk ke dalam, ia duduk di antara pengawal-pengawal untuk melihat kesudahan perkara itu."
 },
 {
   "id": 24120,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 59,
   "firman": "Imam-imam kepala, malah seluruh Mahkamah Agama mencari kesaksian palsu terhadap Yesus, supaya Ia dapat dihukum mati,"
 },
 {
   "id": 24121,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 60,
   "firman": "tetapi mereka tidak memperolehnya, walaupun tampil banyak saksi dusta. Tetapi akhirnya tampillah dua orang,"
 },
 {
   "id": 24122,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 61,
   "firman": "yang mengatakan: \"Orang ini berkata: Aku dapat merubuhkan Bait Allah dan membangunnya kembali dalam tiga hari.\""
 },
 {
   "id": 24123,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 62,
   "firman": "Lalu Imam Besar itu berdiri dan berkata kepada-Nya: \"Tidakkah Engkau memberi jawab atas tuduhan-tuduhan saksi-saksi ini terhadap Engkau?\""
 },
 {
   "id": 24124,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 63,
   "firman": "Tetapi Yesus tetap diam. Lalu kata Imam Besar itu kepada-Nya: \"Demi Allah yang hidup, katakanlah kepada kami, apakah Engkau Mesias, Anak Allah, atau tidak.\""
 },
 {
   "id": 24125,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 64,
   "firman": "Jawab Yesus: \"Engkau telah mengatakannya. Akan tetapi, Aku berkata kepadamu, mulai sekarang kamu akan melihat Anak Manusia duduk di sebelah kanan Yang Mahakuasa dan datang di atas awan-awan di langit.\""
 },
 {
   "id": 24126,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 65,
   "firman": "Maka Imam Besar itu mengoyakkan pakaiannya dan berkata: \"Ia menghujat Allah. Untuk apa kita perlu saksi lagi? Sekarang telah kamu dengar hujat-Nya."
 },
 {
   "id": 24127,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 66,
   "firman": "Bagaimana pendapat kamu?\" Mereka menjawab dan berkata: \"Ia harus dihukum mati!\""
 },
 {
   "id": 24128,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 67,
   "firman": "Lalu mereka meludahi muka-Nya dan meninju-Nya; orang-orang lain memukul Dia,"
 },
 {
   "id": 24129,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 68,
   "firman": "dan berkata: \"Cobalah katakan kepada kami, hai Mesias, siapakah yang memukul Engkau?\""
 },
 {
   "id": 24130,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 69,
   "firman": "Sementara itu Petrus duduk di luar di halaman. Maka datanglah seorang hamba perempuan kepadanya, katanya: \"Engkau juga selalu bersama-sama dengan Yesus, orang Galilea itu.\""
 },
 {
   "id": 24131,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 70,
   "firman": "Tetapi ia menyangkalnya di depan semua orang, katanya: \"Aku tidak tahu, apa yang engkau maksud.\""
 },
 {
   "id": 24132,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 71,
   "firman": "Ketika ia pergi ke pintu gerbang, seorang hamba lain melihat dia dan berkata kepada orang-orang yang ada di situ: \"Orang ini bersama-sama dengan Yesus, orang Nazaret itu.\""
 },
 {
   "id": 24133,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 72,
   "firman": "Dan ia menyangkalnya pula dengan bersumpah: \"Aku tidak kenal orang itu.\""
 },
 {
   "id": 24134,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 73,
   "firman": "Tidak lama kemudian orang-orang yang ada di situ datang kepada Petrus dan berkata: \"Pasti engkau juga salah seorang dari mereka, itu nyata dari bahasamu.\""
 },
 {
   "id": 24135,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 74,
   "firman": "Maka mulailah Petrus mengutuk dan bersumpah: \"Aku tidak kenal orang itu.\" Dan pada saat itu berkokoklah ayam."
 },
 {
   "id": 24136,
   "kitab": "Mat",
   "pasal": 26,
   "ayat": 75,
   "firman": "Maka teringatlah Petrus akan apa yang dikatakan Yesus kepadanya: \"Sebelum ayam berkokok, engkau telah menyangkal Aku tiga kali.\" Lalu ia pergi ke luar dan menangis dengan sedihnya."
 },
 {
   "id": 24137,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 1,
   "firman": "Ketika hari mulai siang, semua imam kepala dan tua-tua bangsa Yahudi berkumpul dan mengambil keputusan untuk membunuh Yesus."
 },
 {
   "id": 24138,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 2,
   "firman": "Mereka membelenggu Dia, lalu membawa-Nya dan menyerahkan-Nya kepada Pilatus, wali negeri itu."
 },
 {
   "id": 24139,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 3,
   "firman": "Pada waktu Yudas, yang menyerahkan Dia, melihat, bahwa Yesus telah dijatuhi hukuman mati, menyesallah ia. Lalu ia mengembalikan uang yang tiga puluh perak itu kepada imam-imam kepala dan tua-tua,"
 },
 {
   "id": 24140,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 4,
   "firman": "dan berkata: \"Aku telah berdosa karena menyerahkan darah orang yang tak bersalah.\" Tetapi jawab mereka: \"Apa urusan kami dengan itu? Itu urusanmu sendiri!\""
 },
 {
   "id": 24141,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 5,
   "firman": "Maka iapun melemparkan uang perak itu ke dalam Bait Suci, lalu pergi dari situ dan menggantung diri."
 },
 {
   "id": 24142,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 6,
   "firman": "Imam-imam kepala mengambil uang perak itu dan berkata: \"Tidak diperbolehkan memasukkan uang ini ke dalam peti persembahan, sebab ini uang darah.\""
 },
 {
   "id": 24143,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 7,
   "firman": "Sesudah berunding mereka membeli dengan uang itu tanah yang disebut Tanah Tukang Periuk untuk dijadikan tempat pekuburan orang asing."
 },
 {
   "id": 24144,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 8,
   "firman": "Itulah sebabnya tanah itu sampai pada hari ini disebut Tanah Darah."
 },
 {
   "id": 24145,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 9,
   "firman": "Dengan demikian genaplah firman yang disampaikan oleh nabi Yeremia: \"Mereka menerima tiga puluh uang perak, yaitu harga yang ditetapkan untuk seorang menurut penilaian yang berlaku di antara orang Israel,"
 },
 {
   "id": 24146,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 10,
   "firman": "dan mereka memberikan uang itu untuk tanah tukang periuk, seperti yang dipesankan Tuhan kepadaku.\""
 },
 {
   "id": 24147,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 11,
   "firman": "Lalu Yesus dihadapkan kepada wali negeri. Dan wali negeri bertanya kepada-Nya: \"Engkaukah raja orang Yahudi?\" Jawab Yesus: \"Engkau sendiri mengatakannya.\""
 },
 {
   "id": 24148,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 12,
   "firman": "Tetapi atas tuduhan yang diajukan imam-imam kepala dan tua-tua terhadap Dia, Ia tidak memberi jawab apapun."
 },
 {
   "id": 24149,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 13,
   "firman": "Maka kata Pilatus kepada-Nya: \"Tidakkah Engkau dengar betapa banyaknya tuduhan saksi-saksi ini terhadap Engkau?\""
 },
 {
   "id": 24150,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 14,
   "firman": "Tetapi Ia tidak menjawab suatu katapun, sehingga wali negeri itu sangat heran."
 },
 {
   "id": 24151,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 15,
   "firman": "Telah menjadi kebiasaan bagi wali negeri untuk membebaskan satu orang hukuman pada tiap-tiap hari raya itu atas pilihan orang banyak."
 },
 {
   "id": 24152,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 16,
   "firman": "Dan pada waktu itu ada dalam penjara seorang yang terkenal kejahatannya yang bernama Yesus Barabas."
 },
 {
   "id": 24153,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 17,
   "firman": "Karena mereka sudah berkumpul di sana, Pilatus berkata kepada mereka: \"Siapa yang kamu kehendaki kubebaskan bagimu, Yesus Barabas atau Yesus, yang disebut Kristus?\""
 },
 {
   "id": 24154,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 18,
   "firman": "Ia memang mengetahui, bahwa mereka telah menyerahkan Yesus karena dengki."
 },
 {
   "id": 24155,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 19,
   "firman": "Ketika Pilatus sedang duduk di kursi pengadilan, isterinya mengirim pesan kepadanya: \"Jangan engkau mencampuri perkara orang benar itu, sebab karena Dia aku sangat menderita dalam mimpi tadi malam.\""
 },
 {
   "id": 24156,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 20,
   "firman": "Tetapi oleh hasutan imam-imam kepala dan tua-tua, orang banyak bertekad untuk meminta supaya Barabas dibebaskan dan Yesus dihukum mati."
 },
 {
   "id": 24157,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 21,
   "firman": "Wali negeri menjawab dan berkata kepada mereka: \"Siapa di antara kedua orang itu yang kamu kehendaki kubebaskan bagimu?\" Kata mereka: \"Barabas.\""
 },
 {
   "id": 24158,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 22,
   "firman": "Kata Pilatus kepada mereka: \"Jika begitu, apakah yang harus kuperbuat dengan Yesus, yang disebut Kristus?\" Mereka semua berseru: \"Ia harus disalibkan!\""
 },
 {
   "id": 24159,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 23,
   "firman": "Katanya: \"Tetapi kejahatan apakah yang telah dilakukan-Nya?\" Namun mereka makin keras berteriak: \"Ia harus disalibkan!\""
 },
 {
   "id": 24160,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 24,
   "firman": "Ketika Pilatus melihat bahwa segala usaha akan sia-sia, malah sudah mulai timbul kekacauan, ia mengambil air dan membasuh tangannya di hadapan orang banyak dan berkata: \"Aku tidak bersalah terhadap darah orang ini; itu urusan kamu sendiri!\""
 },
 {
   "id": 24161,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 25,
   "firman": "Dan seluruh rakyat itu menjawab: \"Biarlah darah-Nya ditanggungkan atas kami dan atas anak-anak kami!\""
 },
 {
   "id": 24162,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 26,
   "firman": "Lalu ia membebaskan Barabas bagi mereka, tetapi Yesus disesahnya lalu diserahkannya untuk disalibkan."
 },
 {
   "id": 24163,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 27,
   "firman": "Kemudian serdadu-serdadu wali negeri membawa Yesus ke gedung pengadilan, lalu memanggil seluruh pasukan berkumpul sekeliling Yesus."
 },
 {
   "id": 24164,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 28,
   "firman": "Mereka menanggalkan pakaian-Nya dan mengenakan jubah ungu kepada-Nya."
 },
 {
   "id": 24165,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 29,
   "firman": "Mereka menganyam sebuah mahkota duri dan menaruhnya di atas kepala-Nya, lalu memberikan Dia sebatang buluh di tangan kanan-Nya. Kemudian mereka berlutut di hadapan-Nya dan mengolok-olokkan Dia, katanya: \"Salam, hai Raja orang Yahudi!\""
 },
 {
   "id": 24166,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 30,
   "firman": "Mereka meludahi-Nya dan mengambil buluh itu dan memukulkannya ke kepala-Nya."
 },
 {
   "id": 24167,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 31,
   "firman": "Sesudah mengolok-olokkan Dia mereka menanggalkan jubah itu dari pada-Nya dan mengenakan pula pakaian-Nya kepada-Nya. Kemudian mereka membawa Dia ke luar untuk disalibkan."
 },
 {
   "id": 24168,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 32,
   "firman": "Ketika mereka berjalan ke luar kota, mereka berjumpa dengan seorang dari Kirene yang bernama Simon. Orang itu mereka paksa untuk memikul salib Yesus."
 },
 {
   "id": 24169,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 33,
   "firman": "Maka sampailah mereka di suatu tempat yang bernama Golgota, artinya: Tempat Tengkorak."
 },
 {
   "id": 24170,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 34,
   "firman": "Lalu mereka memberi Dia minum anggur bercampur empedu. Setelah Ia mengecapnya, Ia tidak mau meminumnya."
 },
 {
   "id": 24171,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 35,
   "firman": "Sesudah menyalibkan Dia mereka membagi-bagi pakaian-Nya dengan membuang undi."
 },
 {
   "id": 24172,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 36,
   "firman": "Lalu mereka duduk di situ menjaga Dia."
 },
 {
   "id": 24173,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 37,
   "firman": "Dan di atas kepala-Nya terpasang tulisan yang menyebut alasan mengapa Ia dihukum: \"Inilah Yesus Raja orang Yahudi.\""
 },
 {
   "id": 24174,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 38,
   "firman": "Bersama dengan Dia disalibkan dua orang penyamun, seorang di sebelah kanan dan seorang di sebelah kiri-Nya."
 },
 {
   "id": 24175,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 39,
   "firman": "Orang-orang yang lewat di sana menghujat Dia dan sambil menggelengkan kepala,"
 },
 {
   "id": 24176,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 40,
   "firman": "mereka berkata: \"Hai Engkau yang mau merubuhkan Bait Suci dan mau membangunnya kembali dalam tiga hari, selamatkanlah diri-Mu jikalau Engkau Anak Allah, turunlah dari salib itu!\""
 },
 {
   "id": 24177,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 41,
   "firman": "Demikian juga imam-imam kepala bersama-sama ahli-ahli Taurat dan tua-tua mengolok-olokkan Dia dan mereka berkata:"
 },
 {
   "id": 24178,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 42,
   "firman": "\"Orang lain Ia selamatkan, tetapi diri-Nya sendiri tidak dapat Ia selamatkan! Ia Raja Israel? Baiklah Ia turun dari salib itu dan kami akan percaya kepada-Nya."
 },
 {
   "id": 24179,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 43,
   "firman": "Ia menaruh harapan-Nya pada Allah: baiklah Allah menyelamatkan Dia, jikalau Allah berkenan kepada-Nya! Karena Ia telah berkata: Aku adalah Anak Allah.\""
 },
 {
   "id": 24180,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 44,
   "firman": "Bahkan penyamun-penyamun yang disalibkan bersama-sama dengan Dia mencela-Nya demikian juga."
 },
 {
   "id": 24181,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 45,
   "firman": "Mulai dari jam dua belas kegelapan meliputi seluruh daerah itu sampai jam tiga."
 },
 {
   "id": 24182,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 46,
   "firman": "Kira-kira jam tiga berserulah Yesus dengan suara nyaring: \"Eli, Eli, lama sabakhtani?\" Artinya: Allah-Ku, Allah-Ku, mengapa Engkau meninggalkan Aku?"
 },
 {
   "id": 24183,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 47,
   "firman": "Mendengar itu, beberapa orang yang berdiri di situ berkata: \"Ia memanggil Elia.\""
 },
 {
   "id": 24184,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 48,
   "firman": "Dan segeralah datang seorang dari mereka; ia mengambil bunga karang, mencelupkannya ke dalam anggur asam, lalu mencucukkannya pada sebatang buluh dan memberi Yesus minum."
 },
 {
   "id": 24185,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 49,
   "firman": "Tetapi orang-orang lain berkata: \"Jangan, baiklah kita lihat, apakah Elia datang untuk menyelamatkan Dia.\""
 },
 {
   "id": 24186,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 50,
   "firman": "Yesus berseru pula dengan suara nyaring lalu menyerahkan nyawa-Nya."
 },
 {
   "id": 24187,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 51,
   "firman": "Dan lihatlah, tabir Bait Suci terbelah dua dari atas sampai ke bawah dan terjadilah gempa bumi, dan bukit-bukit batu terbelah,"
 },
 {
   "id": 24188,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 52,
   "firman": "dan kuburan-kuburan terbuka dan banyak orang kudus yang telah meninggal bangkit."
 },
 {
   "id": 24189,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 53,
   "firman": "Dan sesudah kebangkitan Yesus, merekapun keluar dari kubur, lalu masuk ke kota kudus dan menampakkan diri kepada banyak orang."
 },
 {
   "id": 24190,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 54,
   "firman": "Kepala pasukan dan prajurit-prajuritnya yang menjaga Yesus menjadi sangat takut ketika mereka melihat gempa bumi dan apa yang telah terjadi, lalu berkata: \"Sungguh, Ia ini adalah Anak Allah.\""
 },
 {
   "id": 24191,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 55,
   "firman": "Dan ada di situ banyak perempuan yang melihat dari jauh, yaitu perempuan-perempuan yang mengikuti Yesus dari Galilea untuk melayani Dia."
 },
 {
   "id": 24192,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 56,
   "firman": "Di antara mereka terdapat Maria Magdalena, dan Maria ibu Yakobus dan Yusuf, dan ibu anak-anak Zebedeus."
 },
 {
   "id": 24193,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 57,
   "firman": "Menjelang malam datanglah seorang kaya, orang Arimatea, yang bernama Yusuf dan yang telah menjadi murid Yesus juga."
 },
 {
   "id": 24194,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 58,
   "firman": "Ia pergi menghadap Pilatus dan meminta mayat Yesus. Pilatus memerintahkan untuk menyerahkannya kepadanya."
 },
 {
   "id": 24195,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 59,
   "firman": "Dan Yusufpun mengambil mayat itu, mengapaninya dengan kain lenan yang putih bersih,"
 },
 {
   "id": 24196,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 60,
   "firman": "lalu membaringkannya di dalam kuburnya yang baru, yang digalinya di dalam bukit batu, dan sesudah menggulingkan sebuah batu besar ke pintu kubur itu, pergilah ia."
 },
 {
   "id": 24197,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 61,
   "firman": "Tetapi Maria Magdalena dan Maria yang lain tinggal di situ duduk di depan kubur itu."
 },
 {
   "id": 24198,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 62,
   "firman": "Keesokan harinya, yaitu sesudah hari persiapan, datanglah imam-imam kepala dan orang-orang Farisi bersama-sama menghadap Pilatus,"
 },
 {
   "id": 24199,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 63,
   "firman": "dan mereka berkata: \"Tuan, kami ingat, bahwa si penyesat itu sewaktu hidup-Nya berkata: Sesudah tiga hari Aku akan bangkit."
 },
 {
   "id": 24200,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 64,
   "firman": "Karena itu perintahkanlah untuk menjaga kubur itu sampai hari yang ketiga; jikalau tidak, murid-murid-Nya mungkin datang untuk mencuri Dia, lalu mengatakan kepada rakyat: Ia telah bangkit dari antara orang mati, sehingga penyesatan yang terakhir akan lebih buruk akibatnya dari pada yang pertama.\""
 },
 {
   "id": 24201,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 65,
   "firman": "Kata Pilatus kepada mereka: \"Ini penjaga-penjaga bagimu, pergi dan jagalah kubur itu sebaik-baiknya.\""
 },
 {
   "id": 24202,
   "kitab": "Mat",
   "pasal": 27,
   "ayat": 66,
   "firman": "Maka pergilah mereka dan dengan bantuan penjaga-penjaga itu mereka memeterai kubur itu dan menjaganya."
 },
 {
   "id": 24203,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 1,
   "firman": "Setelah hari Sabat lewat, menjelang menyingsingnya fajar pada hari pertama minggu itu, pergilah Maria Magdalena dan Maria yang lain, menengok kubur itu."
 },
 {
   "id": 24204,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 2,
   "firman": "Maka terjadilah gempa bumi yang hebat sebab seorang malaikat Tuhan turun dari langit dan datang ke batu itu dan menggulingkannya lalu duduk di atasnya."
 },
 {
   "id": 24205,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 3,
   "firman": "Wajahnya bagaikan kilat dan pakaiannya putih bagaikan salju."
 },
 {
   "id": 24206,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 4,
   "firman": "Dan penjaga-penjaga itu gentar ketakutan dan menjadi seperti orang-orang mati."
 },
 {
   "id": 24207,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 5,
   "firman": "Akan tetapi malaikat itu berkata kepada perempuan-perempuan itu: \"Janganlah kamu takut; sebab aku tahu kamu mencari Yesus yang disalibkan itu."
 },
 {
   "id": 24208,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 6,
   "firman": "Ia tidak ada di sini, sebab Ia telah bangkit, sama seperti yang telah dikatakan-Nya. Mari, lihatlah tempat Ia berbaring."
 },
 {
   "id": 24209,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 7,
   "firman": "Dan segeralah pergi dan katakanlah kepada murid-murid-Nya bahwa Ia telah bangkit dari antara orang mati. Ia mendahului kamu ke Galilea; di sana kamu akan melihat Dia. Sesungguhnya aku telah mengatakannya kepadamu.\""
 },
 {
   "id": 24210,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 8,
   "firman": "Mereka segera pergi dari kubur itu, dengan takut dan dengan sukacita yang besar dan berlari cepat-cepat untuk memberitahukannya kepada murid-murid Yesus."
 },
 {
   "id": 24211,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 9,
   "firman": "Tiba-tiba Yesus berjumpa dengan mereka dan berkata: \"Salam bagimu.\" Mereka mendekati-Nya dan memeluk kaki-Nya serta menyembah-Nya."
 },
 {
   "id": 24212,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 10,
   "firman": "Maka kata Yesus kepada mereka: \"Jangan takut. Pergi dan katakanlah kepada saudara-saudara-Ku, supaya mereka pergi ke Galilea, dan di sanalah mereka akan melihat Aku.\""
 },
 {
   "id": 24213,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 11,
   "firman": "Ketika mereka di tengah jalan, datanglah beberapa orang dari penjaga itu ke kota dan memberitahukan segala yang terjadi itu kepada imam-imam kepala."
 },
 {
   "id": 24214,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 12,
   "firman": "Dan sesudah berunding dengan tua-tua, mereka mengambil keputusan lalu memberikan sejumlah besar uang kepada serdadu-serdadu itu"
 },
 {
   "id": 24215,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 13,
   "firman": "dan berkata: \"Kamu harus mengatakan, bahwa murid-murid-Nya datang malam-malam dan mencuri-Nya ketika kamu sedang tidur."
 },
 {
   "id": 24216,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 14,
   "firman": "Dan apabila hal ini kedengaran oleh wali negeri, kami akan berbicara dengan dia, sehingga kamu tidak beroleh kesulitan apa-apa.\""
 },
 {
   "id": 24217,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 15,
   "firman": "Mereka menerima uang itu dan berbuat seperti yang dipesankan kepada mereka. Dan ceritera ini tersiar di antara orang Yahudi sampai sekarang ini."
 },
 {
   "id": 24218,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 16,
   "firman": "Dan kesebelas murid itu berangkat ke Galilea, ke bukit yang telah ditunjukkan Yesus kepada mereka."
 },
 {
   "id": 24219,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 17,
   "firman": "Ketika melihat Dia mereka menyembah-Nya, tetapi beberapa orang ragu-ragu."
 },
 {
   "id": 24220,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 18,
   "firman": "Yesus mendekati mereka dan berkata: \"Kepada-Ku telah diberikan segala kuasa di sorga dan di bumi."
 },
 {
   "id": 24221,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 19,
   "firman": "Karena itu pergilah, jadikanlah semua bangsa murid-Ku dan baptislah mereka dalam nama Bapa dan Anak dan Roh Kudus,"
 },
 {
   "id": 24222,
   "kitab": "Mat",
   "pasal": 28,
   "ayat": 20,
   "firman": "dan ajarlah mereka melakukan segala sesuatu yang telah Kuperintahkan kepadamu. Dan ketahuilah, Aku menyertai kamu senantiasa sampai kepada akhir zaman.\""
 },
 {
   "id": 24223,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah permulaan Injil tentang Yesus Kristus, Anak Allah."
 },
 {
   "id": 24224,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 2,
   "firman": "Seperti ada tertulis dalam kitab nabi Yesaya: \"Lihatlah, Aku menyuruh utusan-Ku mendahului Engkau, ia akan mempersiapkan jalan bagi-Mu;"
 },
 {
   "id": 24225,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 3,
   "firman": "ada suara orang yang berseru-seru di padang gurun: Persiapkanlah jalan untuk Tuhan, luruskanlah jalan bagi-Nya\","
 },
 {
   "id": 24226,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 4,
   "firman": "demikianlah Yohanes Pembaptis tampil di padang gurun dan menyerukan: \"Bertobatlah dan berilah dirimu dibaptis dan Allah akan mengampuni dosamu.\""
 },
 {
   "id": 24227,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 5,
   "firman": "Lalu datanglah kepadanya orang-orang dari seluruh daerah Yudea dan semua penduduk Yerusalem, dan sambil mengaku dosanya mereka dibaptis di sungai Yordan."
 },
 {
   "id": 24228,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 6,
   "firman": "Yohanes memakai jubah bulu unta dan ikat pinggang kulit, dan makanannya belalang dan madu hutan."
 },
 {
   "id": 24229,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 7,
   "firman": "Inilah yang diberitakannya: \"Sesudah aku akan datang Ia yang lebih berkuasa dari padaku; membungkuk dan membuka tali kasut-Nyapun aku tidak layak."
 },
 {
   "id": 24230,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 8,
   "firman": "Aku membaptis kamu dengan air, tetapi Ia akan membaptis kamu dengan Roh Kudus.\""
 },
 {
   "id": 24231,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 9,
   "firman": "Pada waktu itu datanglah Yesus dari Nazaret di tanah Galilea, dan Ia dibaptis di sungai Yordan oleh Yohanes."
 },
 {
   "id": 24232,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 10,
   "firman": "Pada saat Ia keluar dari air, Ia melihat langit terkoyak, dan Roh seperti burung merpati turun ke atas-Nya."
 },
 {
   "id": 24233,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 11,
   "firman": "Lalu terdengarlah suara dari sorga: \"Engkaulah Anak-Ku yang Kukasihi, kepada-Mulah Aku berkenan.\""
 },
 {
   "id": 24234,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 12,
   "firman": "Segera sesudah itu Roh memimpin Dia ke padang gurun."
 },
 {
   "id": 24235,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 13,
   "firman": "Di padang gurun itu Ia tinggal empat puluh hari lamanya, dicobai oleh Iblis. Ia berada di sana di antara binatang-binatang liar dan malaikat-malaikat melayani Dia."
 },
 {
   "id": 24236,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 14,
   "firman": "Sesudah Yohanes ditangkap datanglah Yesus ke Galilea memberitakan Injil Allah,"
 },
 {
   "id": 24237,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 15,
   "firman": "kata-Nya: \"Waktunya telah genap; Kerajaan Allah sudah dekat. Bertobatlah dan percayalah kepada Injil!\""
 },
 {
   "id": 24238,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 16,
   "firman": "Ketika Yesus sedang berjalan menyusur danau Galilea, Ia melihat Simon dan Andreas, saudara Simon. Mereka sedang menebarkan jala di danau, sebab mereka penjala ikan."
 },
 {
   "id": 24239,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 17,
   "firman": "Yesus berkata kepada mereka: \"Mari, ikutlah Aku dan kamu akan Kujadikan penjala manusia.\""
 },
 {
   "id": 24240,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 18,
   "firman": "Lalu merekapun segera meninggalkan jalanya dan mengikuti Dia."
 },
 {
   "id": 24241,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 19,
   "firman": "Dan setelah Yesus meneruskan perjalanan-Nya sedikit lagi, dilihat-Nya Yakobus, anak Zebedeus, dan Yohanes, saudaranya, sedang membereskan jala di dalam perahu."
 },
 {
   "id": 24242,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 20,
   "firman": "Yesus segera memanggil mereka dan mereka meninggalkan ayahnya, Zebedeus, di dalam perahu bersama orang-orang upahannya lalu mengikuti Dia."
 },
 {
   "id": 24243,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 21,
   "firman": "Mereka tiba di Kapernaum. Setelah hari Sabat mulai, Yesus segera masuk ke dalam rumah ibadat dan mengajar."
 },
 {
   "id": 24244,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 22,
   "firman": "Mereka takjub mendengar pengajaran-Nya, sebab Ia mengajar mereka sebagai orang yang berkuasa, tidak seperti ahli-ahli Taurat."
 },
 {
   "id": 24245,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 23,
   "firman": "Pada waktu itu di dalam rumah ibadat itu ada seorang yang kerasukan roh jahat. Orang itu berteriak:"
 },
 {
   "id": 24246,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 24,
   "firman": "\"Apa urusan-Mu dengan kami, hai Yesus orang Nazaret? Engkau datang hendak membinasakan kami? Aku tahu siapa Engkau: Yang Kudus dari Allah.\""
 },
 {
   "id": 24247,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 25,
   "firman": "Tetapi Yesus menghardiknya, kata-Nya: \"Diam, keluarlah dari padanya!\""
 },
 {
   "id": 24248,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 26,
   "firman": "Roh jahat itu menggoncang-goncang orang itu, dan sambil menjerit dengan suara nyaring ia keluar dari padanya."
 },
 {
   "id": 24249,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 27,
   "firman": "Mereka semua takjub, sehingga mereka memperbincangkannya, katanya: \"Apa ini? Suatu ajaran baru. Ia berkata-kata dengan kuasa. Roh-roh jahatpun diperintah-Nya dan mereka taat kepada-Nya.\""
 },
 {
   "id": 24250,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 28,
   "firman": "Lalu tersebarlah dengan cepat kabar tentang Dia ke segala penjuru di seluruh Galilea."
 },
 {
   "id": 24251,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 29,
   "firman": "Sekeluarnya dari rumah ibadat itu Yesus dengan Yakobus dan Yohanes pergi ke rumah Simon dan Andreas."
 },
 {
   "id": 24252,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 30,
   "firman": "Ibu mertua Simon terbaring karena sakit demam. Mereka segera memberitahukan keadaannya kepada Yesus."
 },
 {
   "id": 24253,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 31,
   "firman": "Ia pergi ke tempat perempuan itu, dan sambil memegang tangannya Ia membangunkan dia, lalu lenyaplah demamnya. Kemudian perempuan itu melayani mereka."
 },
 {
   "id": 24254,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 32,
   "firman": "Menjelang malam, sesudah matahari terbenam, dibawalah kepada Yesus semua orang yang menderita sakit dan yang kerasukan setan."
 },
 {
   "id": 24255,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 33,
   "firman": "Maka berkerumunlah seluruh penduduk kota itu di depan pintu."
 },
 {
   "id": 24256,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 34,
   "firman": "Ia menyembuhkan banyak orang yang menderita bermacam-macam penyakit dan mengusir banyak setan; Ia tidak memperbolehkan setan-setan itu berbicara, sebab mereka mengenal Dia."
 },
 {
   "id": 24257,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 35,
   "firman": "Pagi-pagi benar, waktu hari masih gelap, Ia bangun dan pergi ke luar. Ia pergi ke tempat yang sunyi dan berdoa di sana."
 },
 {
   "id": 24258,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 36,
   "firman": "Tetapi Simon dan kawan-kawannya menyusul Dia;"
 },
 {
   "id": 24259,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 37,
   "firman": "waktu menemukan Dia mereka berkata: \"Semua orang mencari Engkau.\""
 },
 {
   "id": 24260,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 38,
   "firman": "Jawab-Nya: \"Marilah kita pergi ke tempat lain, ke kota-kota yang berdekatan, supaya di sana juga Aku memberitakan Injil, karena untuk itu Aku telah datang.\""
 },
 {
   "id": 24261,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 39,
   "firman": "Lalu pergilah Ia ke seluruh Galilea dan memberitakan Injil dalam rumah-rumah ibadat mereka dan mengusir setan-setan."
 },
 {
   "id": 24262,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 40,
   "firman": "Seorang yang sakit kusta datang kepada Yesus, dan sambil berlutut di hadapan-Nya ia memohon bantuan-Nya, katanya: \"Kalau Engkau mau, Engkau dapat mentahirkan aku.\""
 },
 {
   "id": 24263,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 41,
   "firman": "Maka tergeraklah hati-Nya oleh belas kasihan, lalu Ia mengulurkan tangan-Nya, menjamah orang itu dan berkata kepadanya: \"Aku mau, jadilah engkau tahir.\""
 },
 {
   "id": 24264,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 42,
   "firman": "Seketika itu juga lenyaplah penyakit kusta orang itu, dan ia menjadi tahir."
 },
 {
   "id": 24265,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 43,
   "firman": "Segera Ia menyuruh orang itu pergi dengan peringatan keras:"
 },
 {
   "id": 24266,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 44,
   "firman": "\"Ingatlah, janganlah engkau memberitahukan apa-apa tentang hal ini kepada siapapun, tetapi pergilah, perlihatkanlah dirimu kepada imam dan persembahkanlah untuk pentahiranmu persembahan, yang diperintahkan oleh Musa, sebagai bukti bagi mereka.\""
 },
 {
   "id": 24267,
   "kitab": "Mrk",
   "pasal": 1,
   "ayat": 45,
   "firman": "Tetapi orang itu pergi memberitakan peristiwa itu dan menyebarkannya kemana-mana, sehingga Yesus tidak dapat lagi terang-terangan masuk ke dalam kota. Ia tinggal di luar di tempat-tempat yang sepi; namun orang terus juga datang kepada-Nya dari segala penjuru."
 },
 {
   "id": 24268,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 1,
   "firman": "Kemudian, sesudah lewat beberapa hari, waktu Yesus datang lagi ke Kapernaum, tersiarlah kabar, bahwa Ia ada di rumah."
 },
 {
   "id": 24269,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 2,
   "firman": "Maka datanglah orang-orang berkerumun sehingga tidak ada lagi tempat, bahkan di muka pintupun tidak. Sementara Ia memberitakan firman kepada mereka,"
 },
 {
   "id": 24270,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 3,
   "firman": "ada orang-orang datang membawa kepada-Nya seorang lumpuh, digotong oleh empat orang."
 },
 {
   "id": 24271,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 4,
   "firman": "Tetapi mereka tidak dapat membawanya kepada-Nya karena orang banyak itu, lalu mereka membuka atap yang di atas-Nya; sesudah terbuka mereka menurunkan tilam, tempat orang lumpuh itu terbaring."
 },
 {
   "id": 24272,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 5,
   "firman": "Ketika Yesus melihat iman mereka, berkatalah Ia kepada orang lumpuh itu: \"Hai anak-Ku, dosamu sudah diampuni!\""
 },
 {
   "id": 24273,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tetapi di situ ada juga duduk beberapa ahli Taurat, mereka berpikir dalam hatinya:"
 },
 {
   "id": 24274,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 7,
   "firman": "\"Mengapa orang ini berkata begitu? Ia menghujat Allah. Siapa yang dapat mengampuni dosa selain dari pada Allah sendiri?\""
 },
 {
   "id": 24275,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 8,
   "firman": "Tetapi Yesus segera mengetahui dalam hati-Nya, bahwa mereka berpikir demikian, lalu Ia berkata kepada mereka: \"Mengapa kamu berpikir begitu dalam hatimu?"
 },
 {
   "id": 24276,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 9,
   "firman": "Manakah lebih mudah, mengatakan kepada orang lumpuh ini: Dosamu sudah diampuni, atau mengatakan: Bangunlah, angkatlah tilammu dan berjalan?"
 },
 {
   "id": 24277,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 10,
   "firman": "Tetapi supaya kamu tahu, bahwa di dunia ini Anak Manusia berkuasa mengampuni dosa\" --berkatalah Ia kepada orang lumpuh itu--:"
 },
 {
   "id": 24278,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 11,
   "firman": "\"Kepadamu Kukatakan, bangunlah, angkatlah tempat tidurmu dan pulanglah ke rumahmu!\""
 },
 {
   "id": 24279,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan orang itupun bangun, segera mengangkat tempat tidurnya dan pergi ke luar di hadapan orang-orang itu, sehingga mereka semua takjub lalu memuliakan Allah, katanya: \"Yang begini belum pernah kita lihat.\""
 },
 {
   "id": 24280,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sesudah itu Yesus pergi lagi ke pantai danau, dan seluruh orang banyak datang kepada-Nya, lalu Ia mengajar mereka."
 },
 {
   "id": 24281,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 14,
   "firman": "Kemudian ketika Ia berjalan lewat di situ, Ia melihat Lewi anak Alfeus duduk di rumah cukai lalu Ia berkata kepadanya: \"Ikutlah Aku!\" Maka berdirilah Lewi lalu mengikuti Dia."
 },
 {
   "id": 24282,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 15,
   "firman": "Kemudian ketika Yesus makan di rumah orang itu, banyak pemungut cukai dan orang berdosa makan bersama-sama dengan Dia dan murid-murid-Nya, sebab banyak orang yang mengikuti Dia."
 },
 {
   "id": 24283,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 16,
   "firman": "Pada waktu ahli-ahli Taurat dari golongan Farisi melihat, bahwa Ia makan dengan pemungut cukai dan orang berdosa itu, berkatalah mereka kepada murid-murid-Nya: \"Mengapa Ia makan bersama-sama dengan pemungut cukai dan orang berdosa?\""
 },
 {
   "id": 24284,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 17,
   "firman": "Yesus mendengarnya dan berkata kepada mereka: \"Bukan orang sehat yang memerlukan tabib, tetapi orang sakit; Aku datang bukan untuk memanggil orang benar, melainkan orang berdosa.\""
 },
 {
   "id": 24285,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 18,
   "firman": "Pada suatu kali ketika murid-murid Yohanes dan orang-orang Farisi sedang berpuasa, datanglah orang-orang dan mengatakan kepada Yesus: \"Mengapa murid-murid Yohanes dan murid-murid orang Farisi berpuasa, tetapi murid-murid-Mu tidak?\""
 },
 {
   "id": 24286,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 19,
   "firman": "Jawab Yesus kepada mereka: \"Dapatkah sahabat-sahabat mempelai laki-laki berpuasa sedang mempelai itu bersama mereka? Selama mempelai itu bersama mereka, mereka tidak dapat berpuasa."
 },
 {
   "id": 24287,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 20,
   "firman": "Tetapi waktunya akan datang mempelai itu diambil dari mereka, dan pada waktu itulah mereka akan berpuasa."
 },
 {
   "id": 24288,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 21,
   "firman": "Tidak seorangpun menambalkan secarik kain yang belum susut pada baju yang tua, karena jika demikian kain penambal itu akan mencabiknya, yang baru mencabik yang tua, lalu makin besarlah koyaknya."
 },
 {
   "id": 24289,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 22,
   "firman": "Demikian juga tidak seorangpun mengisikan anggur yang baru ke dalam kantong kulit yang tua, karena jika demikian anggur itu akan mengoyakkan kantong itu, sehingga anggur itu dan kantongnya dua-duanya terbuang. Tetapi anggur yang baru hendaknya disimpan dalam kantong yang baru pula.\""
 },
 {
   "id": 24290,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 23,
   "firman": "Pada suatu kali, pada hari Sabat, Yesus berjalan di ladang gandum, dan sementara berjalan murid-murid-Nya memetik bulir gandum."
 },
 {
   "id": 24291,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 24,
   "firman": "Maka kata orang-orang Farisi kepada-Nya: \"Lihat! Mengapa mereka berbuat sesuatu yang tidak diperbolehkan pada hari Sabat?\""
 },
 {
   "id": 24292,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 25,
   "firman": "Jawab-Nya kepada mereka: \"Belum pernahkah kamu baca apa yang dilakukan Daud, ketika ia dan mereka yang mengikutinya kekurangan dan kelaparan,"
 },
 {
   "id": 24293,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 26,
   "firman": "bagaimana ia masuk ke dalam Rumah Allah waktu Abyatar menjabat sebagai Imam Besar lalu makan roti sajian itu--yang tidak boleh dimakan kecuali oleh imam-imam--dan memberinya juga kepada pengikut-pengikutnya?\""
 },
 {
   "id": 24294,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 27,
   "firman": "Lalu kata Yesus kepada mereka: \"Hari Sabat diadakan untuk manusia dan bukan manusia untuk hari Sabat,"
 },
 {
   "id": 24295,
   "kitab": "Mrk",
   "pasal": 2,
   "ayat": 28,
   "firman": "jadi Anak Manusia adalah juga Tuhan atas hari Sabat.\""
 },
 {
   "id": 24296,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 1,
   "firman": "Kemudian Yesus masuk lagi ke rumah ibadat. Di situ ada seorang yang mati sebelah tangannya."
 },
 {
   "id": 24297,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 2,
   "firman": "Mereka mengamat-amati Yesus, kalau-kalau Ia menyembuhkan orang itu pada hari Sabat, supaya mereka dapat mempersalahkan Dia."
 },
 {
   "id": 24298,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 3,
   "firman": "Kata Yesus kepada orang yang mati sebelah tangannya itu: \"Mari, berdirilah di tengah!\""
 },
 {
   "id": 24299,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 4,
   "firman": "Kemudian kata-Nya kepada mereka: \"Manakah yang diperbolehkan pada hari Sabat, berbuat baik atau berbuat jahat, menyelamatkan nyawa orang atau membunuh orang?\" Tetapi mereka itu diam saja."
 },
 {
   "id": 24300,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 5,
   "firman": "Ia berdukacita karena kedegilan mereka dan dengan marah Ia memandang sekeliling-Nya kepada mereka lalu Ia berkata kepada orang itu: \"Ulurkanlah tanganmu!\" Dan ia mengulurkannya, maka sembuhlah tangannya itu."
 },
 {
   "id": 24301,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lalu keluarlah orang-orang Farisi dan segera bersekongkol dengan orang-orang Herodian untuk membunuh Dia."
 },
 {
   "id": 24302,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 7,
   "firman": "Kemudian Yesus dengan murid-murid-Nya menyingkir ke danau, dan banyak orang dari Galilea mengikuti-Nya. Juga dari Yudea,"
 },
 {
   "id": 24303,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 8,
   "firman": "dari Yerusalem, dari Idumea, dari seberang Yordan, dan dari daerah Tirus dan Sidon datang banyak orang kepada-Nya, sesudah mereka mendengar segala yang dilakukan-Nya."
 },
 {
   "id": 24304,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 9,
   "firman": "Ia menyuruh murid-murid-Nya menyediakan sebuah perahu bagi-Nya karena orang banyak itu, supaya mereka jangan sampai menghimpit-Nya."
 },
 {
   "id": 24305,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 10,
   "firman": "Sebab Ia menyembuhkan banyak orang, sehingga semua penderita penyakit berdesak-desakan kepada-Nya hendak menjamah-Nya."
 },
 {
   "id": 24306,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 11,
   "firman": "Bilamana roh-roh jahat melihat Dia, mereka jatuh tersungkur di hadapan-Nya dan berteriak: \"Engkaulah Anak Allah.\""
 },
 {
   "id": 24307,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 12,
   "firman": "Tetapi Ia dengan keras melarang mereka memberitahukan siapa Dia."
 },
 {
   "id": 24308,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 13,
   "firman": "Kemudian naiklah Yesus ke atas bukit. Ia memanggil orang-orang yang dikehendaki-Nya dan merekapun datang kepada-Nya."
 },
 {
   "id": 24309,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 14,
   "firman": "Ia menetapkan dua belas orang untuk menyertai Dia dan untuk diutus-Nya memberitakan Injil"
 },
 {
   "id": 24310,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 15,
   "firman": "dan diberi-Nya kuasa untuk mengusir setan."
 },
 {
   "id": 24311,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 16,
   "firman": "Kedua belas orang yang ditetapkan-Nya itu ialah: Simon, yang diberi-Nya nama Petrus,"
 },
 {
   "id": 24312,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 17,
   "firman": "Yakobus anak Zebedeus, dan Yohanes saudara Yakobus, yang keduanya diberi-Nya nama Boanerges, yang berarti anak-anak guruh,"
 },
 {
   "id": 24313,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 18,
   "firman": "selanjutnya Andreas, Filipus, Bartolomeus, Matius, Tomas, Yakobus anak Alfeus, Tadeus, Simon orang Zelot,"
 },
 {
   "id": 24314,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 19,
   "firman": "dan Yudas Iskariot, yang mengkhianati Dia."
 },
 {
   "id": 24315,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 20,
   "firman": "Kemudian Yesus masuk ke sebuah rumah. Maka datanglah orang banyak berkerumun pula, sehingga makanpun mereka tidak dapat."
 },
 {
   "id": 24316,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 21,
   "firman": "Waktu kaum keluarga-Nya mendengar hal itu, mereka datang hendak mengambil Dia, sebab kata mereka Ia tidak waras lagi."
 },
 {
   "id": 24317,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 22,
   "firman": "Dan ahli-ahli Taurat yang datang dari Yerusalem berkata: \"Ia kerasukan Beelzebul,\" dan: \"Dengan penghulu setan Ia mengusir setan.\""
 },
 {
   "id": 24318,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 23,
   "firman": "Yesus memanggil mereka, lalu berkata kepada mereka dalam perumpamaan: \"Bagaimana Iblis dapat mengusir Iblis?"
 },
 {
   "id": 24319,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 24,
   "firman": "Kalau suatu kerajaan terpecah-pecah, kerajaan itu tidak dapat bertahan,"
 },
 {
   "id": 24320,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 25,
   "firman": "dan jika suatu rumah tangga terpecah-pecah, rumah tangga itu tidak dapat bertahan."
 },
 {
   "id": 24321,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 26,
   "firman": "Demikianlah juga kalau Iblis berontak melawan dirinya sendiri dan kalau ia terbagi-bagi, ia tidak dapat bertahan, melainkan sudahlah tiba kesudahannya."
 },
 {
   "id": 24322,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 27,
   "firman": "Tetapi tidak seorangpun dapat memasuki rumah seorang yang kuat untuk merampas harta bendanya apabila tidak diikatnya dahulu orang kuat itu. Sesudah itu barulah dapat ia merampok rumah itu."
 },
 {
   "id": 24323,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 28,
   "firman": "Aku berkata kepadamu: Sesungguhnya semua dosa dan hujat anak-anak manusia akan diampuni, ya, semua hujat yang mereka ucapkan."
 },
 {
   "id": 24324,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 29,
   "firman": "Tetapi apabila seorang menghujat Roh Kudus, ia tidak mendapat ampun selama-lamanya, melainkan bersalah karena berbuat dosa kekal.\""
 },
 {
   "id": 24325,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 30,
   "firman": "Ia berkata demikian karena mereka katakan bahwa Ia kerasukan roh jahat."
 },
 {
   "id": 24326,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 31,
   "firman": "Lalu datanglah ibu dan saudara-saudara Yesus. Sementara mereka berdiri di luar, mereka menyuruh orang memanggil Dia."
 },
 {
   "id": 24327,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 32,
   "firman": "Ada orang banyak duduk mengelilingi Dia, mereka berkata kepada-Nya: \"Lihat, ibu dan saudara-saudara-Mu ada di luar, dan berusaha menemui Engkau.\""
 },
 {
   "id": 24328,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 33,
   "firman": "Jawab Yesus kepada mereka: \"Siapa ibu-Ku dan siapa saudara-saudara-Ku?\""
 },
 {
   "id": 24329,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 34,
   "firman": "Ia melihat kepada orang-orang yang duduk di sekeliling-Nya itu dan berkata: \"Ini ibu-Ku dan saudara-saudara-Ku!"
 },
 {
   "id": 24330,
   "kitab": "Mrk",
   "pasal": 3,
   "ayat": 35,
   "firman": "Barangsiapa melakukan kehendak Allah, dialah saudara-Ku laki-laki, dialah saudara-Ku perempuan, dialah ibu-Ku.\""
 },
 {
   "id": 24331,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 1,
   "firman": "Pada suatu kali Yesus mulai pula mengajar di tepi danau. Maka datanglah orang banyak yang sangat besar jumlahnya mengerumuni Dia, sehingga Ia naik ke sebuah perahu yang sedang berlabuh lalu duduk di situ, sedangkan semua orang banyak itu di darat, di tepi danau itu."
 },
 {
   "id": 24332,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 2,
   "firman": "Dan Ia mengajarkan banyak hal dalam perumpamaan kepada mereka. Dalam ajaran-Nya itu Ia berkata kepada mereka:"
 },
 {
   "id": 24333,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 3,
   "firman": "\"Dengarlah! Adalah seorang penabur keluar untuk menabur."
 },
 {
   "id": 24334,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 4,
   "firman": "Pada waktu ia menabur sebagian benih itu jatuh di pinggir jalan, lalu datanglah burung dan memakannya sampai habis."
 },
 {
   "id": 24335,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 5,
   "firman": "Sebagian jatuh di tanah yang berbatu-batu, yang tidak banyak tanahnya, lalu benih itupun segera tumbuh, karena tanahnya tipis."
 },
 {
   "id": 24336,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 6,
   "firman": "Tetapi sesudah matahari terbit, layulah ia dan menjadi kering karena tidak berakar."
 },
 {
   "id": 24337,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 7,
   "firman": "Sebagian lagi jatuh di tengah semak duri, lalu makin besarlah semak itu dan menghimpitnya sampai mati, sehingga ia tidak berbuah."
 },
 {
   "id": 24338,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dan sebagian jatuh di tanah yang baik, ia tumbuh dengan suburnya dan berbuah, hasilnya ada yang tiga puluh kali lipat, ada yang enam puluh kali lipat, ada yang seratus kali lipat.\""
 },
 {
   "id": 24339,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 9,
   "firman": "Dan kata-Nya: \"Siapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\""
 },
 {
   "id": 24340,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 10,
   "firman": "Ketika Ia sendirian, pengikut-pengikut-Nya dan kedua belas murid itu menanyakan Dia tentang perumpamaan itu."
 },
 {
   "id": 24341,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 11,
   "firman": "Jawab-Nya: \"Kepadamu telah diberikan rahasia Kerajaan Allah, tetapi kepada orang-orang luar segala sesuatu disampaikan dalam perumpamaan,"
 },
 {
   "id": 24342,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 12,
   "firman": "supaya: Sekalipun melihat, mereka tidak menanggap, sekalipun mendengar, mereka tidak mengerti, supaya mereka jangan berbalik dan mendapat ampun.\""
 },
 {
   "id": 24343,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 13,
   "firman": "Lalu Ia berkata kepada mereka: \"Tidakkah kamu mengerti perumpamaan ini? Kalau demikian bagaimana kamu dapat memahami semua perumpamaan yang lain?"
 },
 {
   "id": 24344,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 14,
   "firman": "Penabur itu menaburkan firman."
 },
 {
   "id": 24345,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 15,
   "firman": "Orang-orang yang di pinggir jalan, tempat firman itu ditaburkan, ialah mereka yang mendengar firman, lalu datanglah Iblis dan mengambil firman yang baru ditaburkan di dalam mereka."
 },
 {
   "id": 24346,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 16,
   "firman": "Demikian juga yang ditaburkan di tanah yang berbatu-batu, ialah orang-orang yang mendengar firman itu dan segera menerimanya dengan gembira,"
 },
 {
   "id": 24347,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 17,
   "firman": "tetapi mereka tidak berakar dan tahan sebentar saja. Apabila kemudian datang penindasan atau penganiayaan karena firman itu, mereka segera murtad."
 },
 {
   "id": 24348,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 18,
   "firman": "Dan yang lain ialah yang ditaburkan di tengah semak duri, itulah yang mendengar firman itu,"
 },
 {
   "id": 24349,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 19,
   "firman": "lalu kekuatiran dunia ini dan tipu daya kekayaan dan keinginan-keinginan akan hal yang lain masuklah menghimpit firman itu sehingga tidak berbuah."
 },
 {
   "id": 24350,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 20,
   "firman": "Dan akhirnya yang ditaburkan di tanah yang baik, ialah orang yang mendengar dan menyambut firman itu lalu berbuah, ada yang tiga puluh kali lipat, ada yang enam puluh kali lipat, dan ada yang seratus kali lipat.\""
 },
 {
   "id": 24351,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 21,
   "firman": "Lalu Yesus berkata kepada mereka: \"Orang membawa pelita bukan supaya ditempatkan di bawah gantang atau di bawah tempat tidur, melainkan supaya ditaruh di atas kaki dian."
 },
 {
   "id": 24352,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 22,
   "firman": "Sebab tidak ada sesuatu yang tersembunyi yang tidak akan dinyatakan, dan tidak ada sesuatu yang rahasia yang tidak akan tersingkap."
 },
 {
   "id": 24353,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 23,
   "firman": "Barangsiapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\""
 },
 {
   "id": 24354,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 24,
   "firman": "Lalu Ia berkata lagi: \"Camkanlah apa yang kamu dengar! Ukuran yang kamu pakai untuk mengukur akan diukurkan kepadamu, dan di samping itu akan ditambah lagi kepadamu."
 },
 {
   "id": 24355,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 25,
   "firman": "Karena siapa yang mempunyai, kepadanya akan diberi, tetapi siapa yang tidak mempunyai, apapun juga yang ada padanya akan diambil dari padanya.\""
 },
 {
   "id": 24356,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 26,
   "firman": "Lalu kata Yesus: \"Beginilah hal Kerajaan Allah itu: seumpama orang yang menaburkan benih di tanah,"
 },
 {
   "id": 24357,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 27,
   "firman": "lalu pada malam hari ia tidur dan pada siang hari ia bangun, dan benih itu mengeluarkan tunas dan tunas itu makin tinggi, bagaimana terjadinya tidak diketahui orang itu."
 },
 {
   "id": 24358,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 28,
   "firman": "Bumi dengan sendirinya mengeluarkan buah, mula-mula tangkainya, lalu bulirnya, kemudian butir-butir yang penuh isinya dalam bulir itu."
 },
 {
   "id": 24359,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 29,
   "firman": "Apabila buah itu sudah cukup masak, orang itu segera menyabit, sebab musim menuai sudah tiba.\""
 },
 {
   "id": 24360,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 30,
   "firman": "Kata-Nya lagi: \"Dengan apa hendak kita membandingkan Kerajaan Allah itu, atau dengan perumpamaan manakah hendaknya kita menggambarkannya?"
 },
 {
   "id": 24361,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 31,
   "firman": "Hal Kerajaan itu seumpama biji sesawi yang ditaburkan di tanah. Memang biji itu yang paling kecil dari pada segala jenis benih yang ada di bumi."
 },
 {
   "id": 24362,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 32,
   "firman": "Tetapi apabila ia ditaburkan, ia tumbuh dan menjadi lebih besar dari pada segala sayuran yang lain dan mengeluarkan cabang-cabang yang besar, sehingga burung-burung di udara dapat bersarang dalam naungannya.\""
 },
 {
   "id": 24363,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 33,
   "firman": "Dalam banyak perumpamaan yang semacam itu Ia memberitakan firman kepada mereka sesuai dengan pengertian mereka,"
 },
 {
   "id": 24364,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 34,
   "firman": "dan tanpa perumpamaan Ia tidak berkata-kata kepada mereka, tetapi kepada murid-murid-Nya Ia menguraikan segala sesuatu secara tersendiri."
 },
 {
   "id": 24365,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 35,
   "firman": "Pada hari itu, waktu hari sudah petang, Yesus berkata kepada mereka: \"Marilah kita bertolak ke seberang.\""
 },
 {
   "id": 24366,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 36,
   "firman": "Mereka meninggalkan orang banyak itu lalu bertolak dan membawa Yesus beserta dengan mereka dalam perahu di mana Yesus telah duduk dan perahu-perahu lain juga menyertai Dia."
 },
 {
   "id": 24367,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 37,
   "firman": "Lalu mengamuklah taufan yang sangat dahsyat dan ombak menyembur masuk ke dalam perahu, sehingga perahu itu mulai penuh dengan air."
 },
 {
   "id": 24368,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 38,
   "firman": "Pada waktu itu Yesus sedang tidur di buritan di sebuah tilam. Maka murid-murid-Nya membangunkan Dia dan berkata kepada-Nya: \"Guru, Engkau tidak perduli kalau kita binasa?\""
 },
 {
   "id": 24369,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 39,
   "firman": "Iapun bangun, menghardik angin itu dan berkata kepada danau itu: \"Diam! Tenanglah!\" Lalu angin itu reda dan danau itu menjadi teduh sekali."
 },
 {
   "id": 24370,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 40,
   "firman": "Lalu Ia berkata kepada mereka: \"Mengapa kamu begitu takut? Mengapa kamu tidak percaya?\""
 },
 {
   "id": 24371,
   "kitab": "Mrk",
   "pasal": 4,
   "ayat": 41,
   "firman": "Mereka menjadi sangat takut dan berkata seorang kepada yang lain: \"Siapa gerangan orang ini, sehingga angin dan danaupun taat kepada-Nya?\""
 },
 {
   "id": 24372,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 1,
   "firman": "Lalu sampailah mereka di seberang danau, di daerah orang Gerasa."
 },
 {
   "id": 24373,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 2,
   "firman": "Baru saja Yesus turun dari perahu, datanglah seorang yang kerasukan roh jahat dari pekuburan menemui Dia."
 },
 {
   "id": 24374,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 3,
   "firman": "Orang itu diam di sana dan tidak ada seorangpun lagi yang sanggup mengikatnya, sekalipun dengan rantai,"
 },
 {
   "id": 24375,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 4,
   "firman": "karena sudah sering ia dibelenggu dan dirantai, tetapi rantainya diputuskannya dan belenggunya dimusnahkannya, sehingga tidak ada seorangpun yang cukup kuat untuk menjinakkannya."
 },
 {
   "id": 24376,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 5,
   "firman": "Siang malam ia berkeliaran di pekuburan dan di bukit-bukit sambil berteriak-teriak dan memukuli dirinya dengan batu."
 },
 {
   "id": 24377,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 6,
   "firman": "Ketika ia melihat Yesus dari jauh, berlarilah ia mendapatkan-Nya lalu menyembah-Nya,"
 },
 {
   "id": 24378,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 7,
   "firman": "dan dengan keras ia berteriak: \"Apa urusan-Mu dengan aku, hai Yesus, Anak Allah Yang Mahatinggi? Demi Allah, jangan siksa aku!\""
 },
 {
   "id": 24379,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 8,
   "firman": "Karena sebelumnya Yesus mengatakan kepadanya: \"Hai engkau roh jahat! Keluar dari orang ini!\""
 },
 {
   "id": 24380,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kemudian Ia bertanya kepada orang itu: \"Siapa namamu?\" Jawabnya: \"Namaku Legion, karena kami banyak.\""
 },
 {
   "id": 24381,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 10,
   "firman": "Ia memohon dengan sangat supaya Yesus jangan mengusir roh-roh itu keluar dari daerah itu."
 },
 {
   "id": 24382,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 11,
   "firman": "Adalah di sana di lereng bukit sejumlah besar babi sedang mencari makan,"
 },
 {
   "id": 24383,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 12,
   "firman": "lalu roh-roh itu meminta kepada-Nya, katanya: \"Suruhlah kami pindah ke dalam babi-babi itu, biarkanlah kami memasukinya!\""
 },
 {
   "id": 24384,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 13,
   "firman": "Yesus mengabulkan permintaan mereka. Lalu keluarlah roh-roh jahat itu dan memasuki babi-babi itu. Kawanan babi yang kira-kira dua ribu jumlahnya itu terjun dari tepi jurang ke dalam danau dan mati lemas di dalamnya."
 },
 {
   "id": 24385,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 14,
   "firman": "Maka larilah penjaga-penjaga babi itu dan menceriterakan hal itu di kota dan di kampung-kampung sekitarnya. Lalu keluarlah orang untuk melihat apa yang terjadi."
 },
 {
   "id": 24386,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 15,
   "firman": "Mereka datang kepada Yesus dan melihat orang yang kerasukan itu duduk, sudah berpakaian dan sudah waras, orang yang tadinya kerasukan legion itu. Maka takutlah mereka."
 },
 {
   "id": 24387,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 16,
   "firman": "Orang-orang yang telah melihat sendiri hal itu menceriterakan kepada mereka tentang apa yang telah terjadi atas orang yang kerasukan setan itu, dan tentang babi-babi itu."
 },
 {
   "id": 24388,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 17,
   "firman": "Lalu mereka mendesak Yesus supaya Ia meninggalkan daerah mereka."
 },
 {
   "id": 24389,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 18,
   "firman": "Pada waktu Yesus naik lagi ke dalam perahu, orang yang tadinya kerasukan setan itu meminta, supaya ia diperkenankan menyertai Dia."
 },
 {
   "id": 24390,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 19,
   "firman": "Yesus tidak memperkenankannya, tetapi Ia berkata kepada orang itu: \"Pulanglah ke rumahmu, kepada orang-orang sekampungmu, dan beritahukanlah kepada mereka segala sesuatu yang telah diperbuat oleh Tuhan atasmu dan bagaimana Ia telah mengasihani engkau!\""
 },
 {
   "id": 24391,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 20,
   "firman": "Orang itupun pergilah dan mulai memberitakan di daerah Dekapolis segala apa yang telah diperbuat Yesus atas dirinya dan mereka semua menjadi heran."
 },
 {
   "id": 24392,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 21,
   "firman": "Sesudah Yesus menyeberang lagi dengan perahu, orang banyak berbondong-bondong datang lalu mengerumuni Dia. Sedang Ia berada di tepi danau,"
 },
 {
   "id": 24393,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 22,
   "firman": "datanglah seorang kepala rumah ibadat yang bernama Yairus. Ketika ia melihat Yesus, tersungkurlah ia di depan kaki-Nya"
 },
 {
   "id": 24394,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 23,
   "firman": "dan memohon dengan sangat kepada-Nya: \"Anakku perempuan sedang sakit, hampir mati, datanglah kiranya dan letakkanlah tangan-Mu atasnya, supaya ia selamat dan tetap hidup.\""
 },
 {
   "id": 24395,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 24,
   "firman": "Lalu pergilah Yesus dengan orang itu. Orang banyak berbondong-bondong mengikuti Dia dan berdesak-desakan di dekat-Nya."
 },
 {
   "id": 24396,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 25,
   "firman": "Adalah di situ seorang perempuan yang sudah dua belas tahun lamanya menderita pendarahan."
 },
 {
   "id": 24397,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 26,
   "firman": "Ia telah berulang-ulang diobati oleh berbagai tabib, sehingga telah dihabiskannya semua yang ada padanya, namun sama sekali tidak ada faedahnya malah sebaliknya keadaannya makin memburuk."
 },
 {
   "id": 24398,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 27,
   "firman": "Dia sudah mendengar berita-berita tentang Yesus, maka di tengah-tengah orang banyak itu ia mendekati Yesus dari belakang dan menjamah jubah-Nya."
 },
 {
   "id": 24399,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 28,
   "firman": "Sebab katanya: \"Asal kujamah saja jubah-Nya, aku akan sembuh.\""
 },
 {
   "id": 24400,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 29,
   "firman": "Seketika itu juga berhentilah pendarahannya dan ia merasa, bahwa badannya sudah sembuh dari penyakitnya."
 },
 {
   "id": 24401,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 30,
   "firman": "Pada ketika itu juga Yesus mengetahui, bahwa ada tenaga yang keluar dari diri-Nya, lalu Ia berpaling di tengah orang banyak dan bertanya: \"Siapa yang menjamah jubah-Ku?\""
 },
 {
   "id": 24402,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 31,
   "firman": "Murid-murid-Nya menjawab: \"Engkau melihat bagaimana orang-orang ini berdesak-desakan dekat-Mu, dan Engkau bertanya: Siapa yang menjamah Aku?\""
 },
 {
   "id": 24403,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 32,
   "firman": "Lalu Ia memandang sekeliling-Nya untuk melihat siapa yang telah melakukan hal itu."
 },
 {
   "id": 24404,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 33,
   "firman": "Perempuan itu, yang menjadi takut dan gemetar ketika mengetahui apa yang telah terjadi atas dirinya, tampil dan tersungkur di depan Yesus dan dengan tulus memberitahukan segala sesuatu kepada-Nya."
 },
 {
   "id": 24405,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 34,
   "firman": "Maka kata-Nya kepada perempuan itu: \"Hai anak-Ku, imanmu telah menyelamatkan engkau. Pergilah dengan selamat dan sembuhlah dari penyakitmu!\""
 },
 {
   "id": 24406,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 35,
   "firman": "Ketika Yesus masih berbicara datanglah orang dari keluarga kepala rumah ibadat itu dan berkata: \"Anakmu sudah mati, apa perlunya lagi engkau menyusah-nyusahkan Guru?\""
 },
 {
   "id": 24407,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 36,
   "firman": "Tetapi Yesus tidak menghiraukan perkataan mereka dan berkata kepada kepala rumah ibadat: \"Jangan takut, percaya saja!\""
 },
 {
   "id": 24408,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 37,
   "firman": "Lalu Yesus tidak memperbolehkan seorangpun ikut serta, kecuali Petrus, Yakobus dan Yohanes, saudara Yakobus."
 },
 {
   "id": 24409,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 38,
   "firman": "Mereka tiba di rumah kepala rumah ibadat, dan di sana dilihat-Nya orang-orang ribut, menangis dan meratap dengan suara nyaring."
 },
 {
   "id": 24410,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 39,
   "firman": "Sesudah Ia masuk Ia berkata kepada orang-orang itu: \"Mengapa kamu ribut dan menangis? Anak ini tidak mati, tetapi tidur!\""
 },
 {
   "id": 24411,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 40,
   "firman": "Tetapi mereka menertawakan Dia. Maka diusir-Nya semua orang itu, lalu dibawa-Nya ayah dan ibu anak itu dan mereka yang bersama-sama dengan Dia masuk ke kamar anak itu."
 },
 {
   "id": 24412,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 41,
   "firman": "Lalu dipegang-Nya tangan anak itu, kata-Nya: \"Talita kum,\" yang berarti: \"Hai anak, Aku berkata kepadamu, bangunlah!\""
 },
 {
   "id": 24413,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 42,
   "firman": "Seketika itu juga anak itu bangkit berdiri dan berjalan, sebab umurnya sudah dua belas tahun. Semua orang yang hadir sangat takjub."
 },
 {
   "id": 24414,
   "kitab": "Mrk",
   "pasal": 5,
   "ayat": 43,
   "firman": "Dengan sangat Ia berpesan kepada mereka, supaya jangan seorangpun mengetahui hal itu, lalu Ia menyuruh mereka memberi anak itu makan."
 },
 {
   "id": 24415,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 1,
   "firman": "Kemudian Yesus berangkat dari situ dan tiba di tempat asal-Nya, sedang murid-murid-Nya mengikuti Dia."
 },
 {
   "id": 24416,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 2,
   "firman": "Pada hari Sabat Ia mulai mengajar di rumah ibadat dan jemaat yang besar takjub ketika mendengar Dia dan mereka berkata: \"Dari mana diperoleh-Nya semuanya itu? Hikmat apa pulakah yang diberikan kepada-Nya? Dan mujizat-mujizat yang demikian bagaimanakah dapat diadakan oleh tangan-Nya?"
 },
 {
   "id": 24417,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 3,
   "firman": "Bukankah Ia ini tukang kayu, anak Maria, saudara Yakobus, Yoses, Yudas dan Simon? Dan bukankah saudara-saudara-Nya yang perempuan ada bersama kita?\" Lalu mereka kecewa dan menolak Dia."
 },
 {
   "id": 24418,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 4,
   "firman": "Maka Yesus berkata kepada mereka: \"Seorang nabi dihormati di mana-mana kecuali di tempat asalnya sendiri, di antara kaum keluarganya dan di rumahnya.\""
 },
 {
   "id": 24419,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 5,
   "firman": "Ia tidak dapat mengadakan satu mujizatpun di sana, kecuali menyembuhkan beberapa orang sakit dengan meletakkan tangan-Nya atas mereka."
 },
 {
   "id": 24420,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 6,
   "firman": "Ia merasa heran atas ketidakpercayaan mereka."
 },
 {
   "id": 24422,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 7,
   "firman": "Ia memanggil kedua belas murid itu dan mengutus mereka berdua-dua. Ia memberi mereka kuasa atas roh-roh jahat,"
 },
 {
   "id": 24423,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 8,
   "firman": "dan berpesan kepada mereka supaya jangan membawa apa-apa dalam perjalanan mereka, kecuali tongkat, rotipun jangan, bekalpun jangan, uang dalam ikat pinggangpun jangan,"
 },
 {
   "id": 24424,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 9,
   "firman": "boleh memakai alas kaki, tetapi jangan memakai dua baju."
 },
 {
   "id": 24425,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 10,
   "firman": "Kata-Nya selanjutnya kepada mereka: \"Kalau di suatu tempat kamu sudah diterima dalam suatu rumah, tinggallah di situ sampai kamu berangkat dari tempat itu."
 },
 {
   "id": 24426,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 11,
   "firman": "Dan kalau ada suatu tempat yang tidak mau menerima kamu dan kalau mereka tidak mau mendengarkan kamu, keluarlah dari situ dan kebaskanlah debu yang di kakimu sebagai peringatan bagi mereka.\""
 },
 {
   "id": 24427,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 12,
   "firman": "Lalu pergilah mereka memberitakan bahwa orang harus bertobat,"
 },
 {
   "id": 24428,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 13,
   "firman": "dan mereka mengusir banyak setan, dan mengoles banyak orang sakit dengan minyak dan menyembuhkan mereka."
 },
 {
   "id": 24429,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 14,
   "firman": "Raja Herodes juga mendengar tentang Yesus, sebab nama-Nya sudah terkenal dan orang mengatakan: \"Yohanes Pembaptis sudah bangkit dari antara orang mati dan itulah sebabnya kuasa-kuasa itu bekerja di dalam Dia.\""
 },
 {
   "id": 24430,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 15,
   "firman": "Yang lain mengatakan: \"Dia itu Elia!\" Yang lain lagi mengatakan: \"Dia itu seorang nabi sama seperti nabi-nabi yang dahulu.\""
 },
 {
   "id": 24431,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 16,
   "firman": "Waktu Herodes mendengar hal itu, ia berkata: \"Bukan, dia itu Yohanes yang sudah kupenggal kepalanya, dan yang bangkit lagi.\""
 },
 {
   "id": 24432,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 17,
   "firman": "Sebab memang Herodeslah yang menyuruh orang menangkap Yohanes dan membelenggunya di penjara berhubung dengan peristiwa Herodias, isteri Filipus saudaranya, karena Herodes telah mengambilnya sebagai isteri."
 },
 {
   "id": 24433,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 18,
   "firman": "Karena Yohanes pernah menegor Herodes: \"Tidak halal engkau mengambil isteri saudaramu!\""
 },
 {
   "id": 24434,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 19,
   "firman": "Karena itu Herodias menaruh dendam pada Yohanes dan bermaksud untuk membunuh dia, tetapi tidak dapat,"
 },
 {
   "id": 24435,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 20,
   "firman": "sebab Herodes segan akan Yohanes karena ia tahu, bahwa Yohanes adalah orang yang benar dan suci, jadi ia melindunginya. Tetapi apabila ia mendengarkan Yohanes, hatinya selalu terombang-ambing, namun ia merasa senang juga mendengarkan dia."
 },
 {
   "id": 24436,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 21,
   "firman": "Akhirnya tiba juga kesempatan yang baik bagi Herodias, ketika Herodes pada hari ulang tahunnya mengadakan perjamuan untuk pembesar-pembesarnya, perwira-perwiranya dan orang-orang terkemuka di Galilea."
 },
 {
   "id": 24437,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 22,
   "firman": "Pada waktu itu anak perempuan Herodias tampil lalu menari, dan ia menyukakan hati Herodes dan tamu-tamunya. Raja berkata kepada gadis itu: \"Minta dari padaku apa saja yang kauingini, maka akan kuberikan kepadamu!\","
 },
 {
   "id": 24438,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 23,
   "firman": "lalu bersumpah kepadanya: \"Apa saja yang kauminta akan kuberikan kepadamu, sekalipun setengah dari kerajaanku!\""
 },
 {
   "id": 24439,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 24,
   "firman": "Anak itu pergi dan menanyakan ibunya: \"Apa yang harus kuminta?\" Jawabnya: \"Kepala Yohanes Pembaptis!\""
 },
 {
   "id": 24440,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 25,
   "firman": "Maka cepat-cepat ia pergi kepada raja dan meminta: \"Aku mau, supaya sekarang juga engkau berikan kepadaku kepala Yohanes Pembaptis di sebuah talam!\""
 },
 {
   "id": 24441,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 26,
   "firman": "Lalu sangat sedihlah hati raja, tetapi karena sumpahnya dan karena tamu-tamunya ia tidak mau menolaknya."
 },
 {
   "id": 24442,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 27,
   "firman": "Raja segera menyuruh seorang pengawal dengan perintah supaya mengambil kepala Yohanes. Orang itu pergi dan memenggal kepala Yohanes di penjara."
 },
 {
   "id": 24443,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 28,
   "firman": "Ia membawa kepala itu di sebuah talam dan memberikannya kepada gadis itu dan gadis itu memberikannya pula kepada ibunya."
 },
 {
   "id": 24444,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 29,
   "firman": "Ketika murid-murid Yohanes mendengar hal itu mereka datang dan mengambil mayatnya, lalu membaringkannya dalam kuburan."
 },
 {
   "id": 24445,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 30,
   "firman": "Kemudian rasul-rasul itu kembali berkumpul dengan Yesus dan memberitahukan kepada-Nya semua yang mereka kerjakan dan ajarkan."
 },
 {
   "id": 24446,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 31,
   "firman": "Lalu Ia berkata kepada mereka: \"Marilah ke tempat yang sunyi, supaya kita sendirian, dan beristirahatlah seketika!\" Sebab memang begitu banyaknya orang yang datang dan yang pergi, sehingga makanpun mereka tidak sempat."
 },
 {
   "id": 24447,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 32,
   "firman": "Maka berangkatlah mereka untuk mengasingkan diri dengan perahu ke tempat yang sunyi."
 },
 {
   "id": 24448,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 33,
   "firman": "Tetapi pada waktu mereka bertolak banyak orang melihat mereka dan mengetahui tujuan mereka. Dengan mengambil jalan darat segeralah datang orang dari semua kota ke tempat itu sehingga mendahului mereka."
 },
 {
   "id": 24449,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 34,
   "firman": "Ketika Yesus mendarat, Ia melihat sejumlah besar orang banyak, maka tergeraklah hati-Nya oleh belas kasihan kepada mereka, karena mereka seperti domba yang tidak mempunyai gembala. Lalu mulailah Ia mengajarkan banyak hal kepada mereka."
 },
 {
   "id": 24450,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 35,
   "firman": "Pada waktu hari sudah mulai malam, datanglah murid-murid-Nya kepada-Nya dan berkata: \"Tempat ini sunyi dan hari sudah mulai malam."
 },
 {
   "id": 24451,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 36,
   "firman": "Suruhlah mereka pergi, supaya mereka dapat membeli makanan di desa-desa dan di kampung-kampung di sekitar ini.\""
 },
 {
   "id": 24452,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 37,
   "firman": "Tetapi jawab-Nya: \"Kamu harus memberi mereka makan!\" Kata mereka kepada-Nya: \"Jadi haruskah kami membeli roti seharga dua ratus dinar untuk memberi mereka makan?\""
 },
 {
   "id": 24453,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 38,
   "firman": "Tetapi Ia berkata kepada mereka: \"Berapa banyak roti yang ada padamu? Cobalah periksa!\" Sesudah memeriksanya mereka berkata: \"Lima roti dan dua ikan.\""
 },
 {
   "id": 24454,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 39,
   "firman": "Lalu Ia menyuruh orang-orang itu, supaya semua duduk berkelompok-kelompok di atas rumput hijau."
 },
 {
   "id": 24455,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 40,
   "firman": "Maka duduklah mereka berkelompok-kelompok, ada yang seratus, ada yang lima puluh orang."
 },
 {
   "id": 24456,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 41,
   "firman": "Dan setelah Ia mengambil lima roti dan dua ikan itu, Ia menengadah ke langit dan mengucap berkat, lalu memecah-mecahkan roti itu dan memberikannya kepada murid-murid-Nya, supaya dibagi-bagikan kepada orang-orang itu; begitu juga kedua ikan itu dibagi-bagikan-Nya kepada semua mereka."
 },
 {
   "id": 24457,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 42,
   "firman": "Dan mereka semuanya makan sampai kenyang."
 },
 {
   "id": 24458,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 43,
   "firman": "Kemudian orang mengumpulkan potongan-potongan roti dua belas bakul penuh, selain dari pada sisa-sisa ikan."
 },
 {
   "id": 24459,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 44,
   "firman": "Yang ikut makan roti itu ada lima ribu orang laki-laki."
 },
 {
   "id": 24460,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 45,
   "firman": "Sesudah itu Yesus segera memerintahkan murid-murid-Nya naik ke perahu dan berangkat lebih dulu ke seberang, ke Betsaida, sementara itu Ia menyuruh orang banyak pulang."
 },
 {
   "id": 24461,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 46,
   "firman": "Setelah Ia berpisah dari mereka, Ia pergi ke bukit untuk berdoa."
 },
 {
   "id": 24462,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 47,
   "firman": "Ketika hari sudah malam perahu itu sudah di tengah danau, sedang Yesus tinggal sendirian di darat."
 },
 {
   "id": 24463,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 48,
   "firman": "Ketika Ia melihat betapa payahnya mereka mendayung karena angin sakal, maka kira-kira jam tiga malam Ia datang kepada mereka berjalan di atas air dan Ia hendak melewati mereka."
 },
 {
   "id": 24464,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 49,
   "firman": "Ketika mereka melihat Dia berjalan di atas air, mereka mengira bahwa Ia adalah hantu, lalu mereka berteriak-teriak,"
 },
 {
   "id": 24465,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 50,
   "firman": "sebab mereka semua melihat Dia dan merekapun sangat terkejut. Tetapi segera Ia berkata kepada mereka: \"Tenanglah! Aku ini, jangan takut!\""
 },
 {
   "id": 24466,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 51,
   "firman": "Lalu Ia naik ke perahu mendapatkan mereka, dan anginpun redalah. Mereka sangat tercengang dan bingung,"
 },
 {
   "id": 24467,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 52,
   "firman": "sebab sesudah peristiwa roti itu mereka belum juga mengerti, dan hati mereka tetap degil."
 },
 {
   "id": 24468,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 53,
   "firman": "Setibanya di seberang Yesus dan murid-murid-Nya mendarat di Genesaret dan berlabuh di situ."
 },
 {
   "id": 24469,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 54,
   "firman": "Ketika mereka keluar dari perahu, orang segera mengenal Yesus."
 },
 {
   "id": 24470,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 55,
   "firman": "Maka berlari-larilah mereka ke seluruh daerah itu dan mulai mengusung orang-orang sakit di atas tilamnya kepada Yesus, di mana saja kabarnya Ia berada."
 },
 {
   "id": 24471,
   "kitab": "Mrk",
   "pasal": 6,
   "ayat": 56,
   "firman": "Ke manapun Ia pergi, ke desa-desa, ke kota-kota, atau ke kampung-kampung, orang meletakkan orang-orang sakit di pasar dan memohon kepada-Nya, supaya mereka diperkenankan hanya menjamah jumbai jubah-Nya saja. Dan semua orang yang menjamah-Nya menjadi sembuh."
 },
 {
   "id": 24472,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 1,
   "firman": "Pada suatu kali serombongan orang Farisi dan beberapa ahli Taurat dari Yerusalem datang menemui Yesus."
 },
 {
   "id": 24473,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 2,
   "firman": "Mereka melihat, bahwa beberapa orang murid-Nya makan dengan tangan najis, yaitu dengan tangan yang tidak dibasuh."
 },
 {
   "id": 24474,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 3,
   "firman": "Sebab orang-orang Farisi seperti orang-orang Yahudi lainnya tidak makan kalau tidak melakukan pembasuhan tangan lebih dulu, karena mereka berpegang pada adat istiadat nenek moyang mereka;"
 },
 {
   "id": 24475,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 4,
   "firman": "dan kalau pulang dari pasar mereka juga tidak makan kalau tidak lebih dahulu membersihkan dirinya. Banyak warisan lain lagi yang mereka pegang, umpamanya hal mencuci cawan, kendi dan perkakas-perkakas tembaga."
 },
 {
   "id": 24476,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 5,
   "firman": "Karena itu orang-orang Farisi dan ahli-ahli Taurat itu bertanya kepada-Nya: \"Mengapa murid-murid-Mu tidak hidup menurut adat istiadat nenek moyang kita, tetapi makan dengan tangan najis?\""
 },
 {
   "id": 24477,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 6,
   "firman": "Jawab-Nya kepada mereka: \"Benarlah nubuat Yesaya tentang kamu, hai orang-orang munafik! Sebab ada tertulis: Bangsa ini memuliakan Aku dengan bibirnya, padahal hatinya jauh dari pada-Ku."
 },
 {
   "id": 24478,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 7,
   "firman": "Percuma mereka beribadah kepada-Ku, sedangkan ajaran yang mereka ajarkan ialah perintah manusia."
 },
 {
   "id": 24479,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 8,
   "firman": "Perintah Allah kamu abaikan untuk berpegang pada adat istiadat manusia.\""
 },
 {
   "id": 24480,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 9,
   "firman": "Yesus berkata pula kepada mereka: \"Sungguh pandai kamu mengesampingkan perintah Allah, supaya kamu dapat memelihara adat istiadatmu sendiri."
 },
 {
   "id": 24481,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 10,
   "firman": "Karena Musa telah berkata: Hormatilah ayahmu dan ibumu! dan: Siapa yang mengutuki ayahnya atau ibunya harus mati."
 },
 {
   "id": 24482,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 11,
   "firman": "Tetapi kamu berkata: Kalau seorang berkata kepada bapanya atau ibunya: Apa yang ada padaku, yang dapat digunakan untuk pemeliharaanmu, sudah digunakan untuk korban--yaitu persembahan kepada Allah--,"
 },
 {
   "id": 24483,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 12,
   "firman": "maka kamu tidak membiarkannya lagi berbuat sesuatupun untuk bapanya atau ibunya."
 },
 {
   "id": 24484,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 13,
   "firman": "Dengan demikian firman Allah kamu nyatakan tidak berlaku demi adat istiadat yang kamu ikuti itu. Dan banyak hal lain seperti itu yang kamu lakukan.\""
 },
 {
   "id": 24485,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 14,
   "firman": "Lalu Yesus memanggil lagi orang banyak dan berkata kepada mereka: \"Kamu semua, dengarlah kepada-Ku dan camkanlah."
 },
 {
   "id": 24486,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 15,
   "firman": "Apapun dari luar, yang masuk ke dalam seseorang, tidak dapat menajiskannya, tetapi apa yang keluar dari seseorang, itulah yang menajiskannya.\""
 },
 {
   "id": 24487,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 16,
   "firman": "(Barangsiapa bertelinga untuk mendengar hendaklah ia mendengar!)"
 },
 {
   "id": 24488,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 17,
   "firman": "Sesudah Ia masuk ke sebuah rumah untuk menyingkir dari orang banyak, murid-murid-Nya bertanya kepada-Nya tentang arti perumpamaan itu."
 },
 {
   "id": 24489,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 18,
   "firman": "Maka jawab-Nya: \"Apakah kamu juga tidak dapat memahaminya? Tidak tahukah kamu bahwa segala sesuatu dari luar yang masuk ke dalam seseorang tidak dapat menajiskannya,"
 },
 {
   "id": 24490,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 19,
   "firman": "karena bukan masuk ke dalam hati tetapi ke dalam perutnya, lalu dibuang di jamban?\" Dengan demikian Ia menyatakan semua makanan halal."
 },
 {
   "id": 24491,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 20,
   "firman": "Kata-Nya lagi: \"Apa yang keluar dari seseorang, itulah yang menajiskannya,"
 },
 {
   "id": 24492,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 21,
   "firman": "sebab dari dalam, dari hati orang, timbul segala pikiran jahat, percabulan, pencurian, pembunuhan,"
 },
 {
   "id": 24493,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 22,
   "firman": "perzinahan, keserakahan, kejahatan, kelicikan, hawa nafsu, iri hati, hujat, kesombongan, kebebalan."
 },
 {
   "id": 24494,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 23,
   "firman": "Semua hal-hal jahat ini timbul dari dalam dan menajiskan orang.\""
 },
 {
   "id": 24495,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 24,
   "firman": "Lalu Yesus berangkat dari situ dan pergi ke daerah Tirus. Ia masuk ke sebuah rumah dan tidak mau bahwa ada orang yang mengetahuinya, tetapi kedatangan-Nya tidak dapat dirahasiakan."
 },
 {
   "id": 24496,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 25,
   "firman": "Malah seorang ibu, yang anaknya perempuan kerasukan roh jahat, segera mendengar tentang Dia, lalu datang dan tersungkur di depan kaki-Nya."
 },
 {
   "id": 24497,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 26,
   "firman": "Perempuan itu seorang Yunani bangsa Siro-Fenisia. Ia memohon kepada Yesus untuk mengusir setan itu dari anaknya."
 },
 {
   "id": 24498,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 27,
   "firman": "Lalu Yesus berkata kepadanya: \"Biarlah anak-anak kenyang dahulu, sebab tidak patut mengambil roti yang disediakan bagi anak-anak dan melemparkannya kepada anjing.\""
 },
 {
   "id": 24499,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 28,
   "firman": "Tetapi perempuan itu menjawab: \"Benar, Tuhan. Tetapi anjing yang di bawah meja juga makan remah-remah yang dijatuhkan anak-anak.\""
 },
 {
   "id": 24500,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 29,
   "firman": "Maka kata Yesus kepada perempuan itu: \"Karena kata-katamu itu, pergilah sekarang sebab setan itu sudah keluar dari anakmu.\""
 },
 {
   "id": 24501,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 30,
   "firman": "Perempuan itu pulang ke rumahnya, lalu didapatinya anak itu berbaring di tempat tidur, sedang setan itu sudah keluar."
 },
 {
   "id": 24502,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 31,
   "firman": "Kemudian Yesus meninggalkan pula daerah Tirus dan dengan melalui Sidon pergi ke danau Galilea, di tengah-tengah daerah Dekapolis."
 },
 {
   "id": 24503,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 32,
   "firman": "Di situ orang membawa kepada-Nya seorang yang tuli dan yang gagap dan memohon kepada-Nya, supaya Ia meletakkan tangan-Nya atas orang itu."
 },
 {
   "id": 24504,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 33,
   "firman": "Dan sesudah Yesus memisahkan dia dari orang banyak, sehingga mereka sendirian, Ia memasukkan jari-Nya ke telinga orang itu, lalu Ia meludah dan meraba lidah orang itu."
 },
 {
   "id": 24505,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 34,
   "firman": "Kemudian sambil menengadah ke langit Yesus menarik nafas dan berkata kepadanya: \"Efata!\", artinya: Terbukalah!"
 },
 {
   "id": 24506,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 35,
   "firman": "Maka terbukalah telinga orang itu dan seketika itu terlepas pulalah pengikat lidahnya, lalu ia berkata-kata dengan baik."
 },
 {
   "id": 24507,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 36,
   "firman": "Yesus berpesan kepada orang-orang yang ada di situ supaya jangan menceriterakannya kepada siapapun juga. Tetapi makin dilarang-Nya mereka, makin luas mereka memberitakannya."
 },
 {
   "id": 24508,
   "kitab": "Mrk",
   "pasal": 7,
   "ayat": 37,
   "firman": "Mereka takjub dan tercengang dan berkata: \"Ia menjadikan segala-galanya baik, yang tuli dijadikan-Nya mendengar, yang bisu dijadikan-Nya berkata-kata.\""
 },
 {
   "id": 24509,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 1,
   "firman": "Pada waktu itu ada pula orang banyak di situ yang besar jumlahnya, dan karena mereka tidak mempunyai makanan, Yesus memanggil murid-murid-Nya dan berkata:"
 },
 {
   "id": 24510,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 2,
   "firman": "\"Hati-Ku tergerak oleh belas kasihan kepada orang banyak ini. Sudah tiga hari mereka mengikuti Aku dan mereka tidak mempunyai makanan."
 },
 {
   "id": 24511,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 3,
   "firman": "Dan jika mereka Kusuruh pulang ke rumahnya dengan lapar, mereka akan rebah di jalan, sebab ada yang datang dari jauh.\""
 },
 {
   "id": 24512,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 4,
   "firman": "Murid-murid-Nya menjawab: \"Bagaimana di tempat yang sunyi ini orang dapat memberi mereka roti sampai kenyang?\""
 },
 {
   "id": 24513,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 5,
   "firman": "Yesus bertanya kepada mereka: \"Berapa roti ada padamu?\" Jawab mereka: \"Tujuh.\""
 },
 {
   "id": 24514,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 6,
   "firman": "Lalu Ia menyuruh orang banyak itu duduk di tanah. Sesudah itu Ia mengambil ketujuh roti itu, mengucap syukur, memecah-mecahkannya dan memberikannya kepada murid-murid-Nya untuk dibagi-bagikan, dan mereka memberikannya kepada orang banyak."
 },
 {
   "id": 24515,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 7,
   "firman": "Mereka juga mempunyai beberapa ikan, dan sesudah mengucap berkat atasnya, Ia menyuruh supaya ikan itu juga dibagi-bagikan."
 },
 {
   "id": 24516,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 8,
   "firman": "Dan mereka makan sampai kenyang. Kemudian orang mengumpulkan potongan-potongan roti yang sisa, sebanyak tujuh bakul."
 },
 {
   "id": 24517,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 9,
   "firman": "Mereka itu ada kira-kira empat ribu orang. Lalu Yesus menyuruh mereka pulang."
 },
 {
   "id": 24518,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 10,
   "firman": "Ia segera naik ke perahu dengan murid-murid-Nya dan bertolak ke daerah Dalmanuta."
 },
 {
   "id": 24519,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 11,
   "firman": "Lalu muncullah orang-orang Farisi dan bersoal jawab dengan Yesus. Untuk mencobai Dia mereka meminta dari pada-Nya suatu tanda dari sorga."
 },
 {
   "id": 24520,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 12,
   "firman": "Maka mengeluhlah Ia dalam hati-Nya dan berkata: \"Mengapa angkatan ini meminta tanda? Aku berkata kepadamu, sesungguhnya kepada angkatan ini sekali-kali tidak akan diberi tanda.\""
 },
 {
   "id": 24521,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 13,
   "firman": "Ia meninggalkan mereka; Ia naik pula ke perahu dan bertolak ke seberang."
 },
 {
   "id": 24522,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 14,
   "firman": "Kemudian ternyata murid-murid Yesus lupa membawa roti, hanya sebuah saja yang ada pada mereka dalam perahu."
 },
 {
   "id": 24523,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 15,
   "firman": "Lalu Yesus memperingatkan mereka, kata-Nya: \"Berjaga-jagalah dan awaslah terhadap ragi orang Farisi dan ragi Herodes.\""
 },
 {
   "id": 24524,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 16,
   "firman": "Maka mereka berpikir-pikir dan seorang berkata kepada yang lain: \"Itu dikatakan-Nya karena kita tidak mempunyai roti.\""
 },
 {
   "id": 24525,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 17,
   "firman": "Dan ketika Yesus mengetahui apa yang mereka perbincangkan, Ia berkata: \"Mengapa kamu memperbincangkan soal tidak ada roti? Belum jugakah kamu faham dan mengerti? Telah degilkah hatimu?"
 },
 {
   "id": 24526,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 18,
   "firman": "Kamu mempunyai mata, tidakkah kamu melihat dan kamu mempunyai telinga, tidakkah kamu mendengar? Tidakkah kamu ingat lagi,"
 },
 {
   "id": 24527,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 19,
   "firman": "pada waktu Aku memecah-mecahkan lima roti untuk lima ribu orang itu, berapa bakul penuh potongan-potongan roti kamu kumpulkan?\" Jawab mereka: \"Dua belas bakul.\""
 },
 {
   "id": 24528,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 20,
   "firman": "\"Dan pada waktu tujuh roti untuk empat ribu orang itu, berapa bakul penuh potongan-potongan roti kamu kumpulkan?\" Jawab mereka: \"Tujuh bakul.\""
 },
 {
   "id": 24529,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 21,
   "firman": "Lalu kata-Nya kepada mereka: \"Masihkah kamu belum mengerti?\""
 },
 {
   "id": 24530,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 22,
   "firman": "Kemudian tibalah Yesus dan murid-murid-Nya di Betsaida. Di situ orang membawa kepada Yesus seorang buta dan mereka memohon kepada-Nya, supaya Ia menjamah dia."
 },
 {
   "id": 24531,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 23,
   "firman": "Yesus memegang tangan orang buta itu dan membawa dia ke luar kampung. Lalu Ia meludahi mata orang itu dan meletakkan tangan-Nya atasnya, dan bertanya: \"Sudahkah kaulihat sesuatu?\""
 },
 {
   "id": 24532,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 24,
   "firman": "Orang itu memandang ke depan, lalu berkata: \"Aku melihat orang, sebab melihat mereka berjalan-jalan, tetapi tampaknya seperti pohon-pohon.\""
 },
 {
   "id": 24533,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 25,
   "firman": "Yesus meletakkan lagi tangan-Nya pada mata orang itu, maka orang itu sungguh-sungguh melihat dan telah sembuh, sehingga ia dapat melihat segala sesuatu dengan jelas."
 },
 {
   "id": 24534,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 26,
   "firman": "Sesudah itu Yesus menyuruh dia pulang ke rumahnya dan berkata: \"Jangan masuk ke kampung!\""
 },
 {
   "id": 24535,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 27,
   "firman": "Kemudian Yesus beserta murid-murid-Nya berangkat ke kampung-kampung di sekitar Kaisarea Filipi. Di tengah jalan Ia bertanya kepada murid-murid-Nya, kata-Nya: \"Kata orang, siapakah Aku ini?\""
 },
 {
   "id": 24536,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 28,
   "firman": "Jawab mereka: \"Ada yang mengatakan: Yohanes Pembaptis, ada juga yang mengatakan: Elia, ada pula yang mengatakan: seorang dari para nabi.\""
 },
 {
   "id": 24537,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 29,
   "firman": "Ia bertanya kepada mereka: \"Tetapi apa katamu, siapakah Aku ini?\" Maka jawab Petrus: \"Engkau adalah Mesias!\""
 },
 {
   "id": 24538,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 30,
   "firman": "Lalu Yesus melarang mereka dengan keras supaya jangan memberitahukan kepada siapapun tentang Dia."
 },
 {
   "id": 24539,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 31,
   "firman": "Kemudian mulailah Yesus mengajarkan kepada mereka, bahwa Anak Manusia harus menanggung banyak penderitaan dan ditolak oleh tua-tua, imam-imam kepala dan ahli-ahli Taurat, lalu dibunuh dan bangkit sesudah tiga hari."
 },
 {
   "id": 24540,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 32,
   "firman": "Hal ini dikatakan-Nya dengan terus terang. Tetapi Petrus menarik Yesus ke samping dan menegor Dia."
 },
 {
   "id": 24541,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 33,
   "firman": "Maka berpalinglah Yesus dan sambil memandang murid-murid-Nya Ia memarahi Petrus, kata-Nya: \"Enyahlah Iblis, sebab engkau bukan memikirkan apa yang dipikirkan Allah, melainkan apa yang dipikirkan manusia.\""
 },
 {
   "id": 24542,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 34,
   "firman": "Lalu Yesus memanggil orang banyak dan murid-murid-Nya dan berkata kepada mereka: \"Setiap orang yang mau mengikut Aku, ia harus menyangkal dirinya, memikul salibnya dan mengikut Aku."
 },
 {
   "id": 24543,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 35,
   "firman": "Karena siapa yang mau menyelamatkan nyawanya, ia akan kehilangan nyawanya; tetapi barangsiapa kehilangan nyawanya karena Aku dan karena Injil, ia akan menyelamatkannya."
 },
 {
   "id": 24544,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 36,
   "firman": "Apa gunanya seorang memperoleh seluruh dunia, tetapi ia kehilangan nyawanya."
 },
 {
   "id": 24545,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 37,
   "firman": "Karena apakah yang dapat diberikannya sebagai ganti nyawanya?"
 },
 {
   "id": 24546,
   "kitab": "Mrk",
   "pasal": 8,
   "ayat": 38,
   "firman": "Sebab barangsiapa malu karena Aku dan karena perkataan-Ku di tengah-tengah angkatan yang tidak setia dan berdosa ini, Anak Manusiapun akan malu karena orang itu apabila Ia datang kelak dalam kemuliaan Bapa-Nya, diiringi malaikat-malaikat kudus.\""
 },
 {
   "id": 24547,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 1,
   "firman": "Kata-Nya lagi kepada mereka: \"Aku berkata kepadamu, sesungguhnya di antara orang yang hadir di sini ada yang tidak akan mati sebelum mereka melihat bahwa Kerajaan Allah telah datang dengan kuasa.\""
 },
 {
   "id": 24548,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 2,
   "firman": "Enam hari kemudian Yesus membawa Petrus, Yakobus dan Yohanes dan bersama-sama dengan mereka Ia naik ke sebuah gunung yang tinggi. Di situ mereka sendirian saja. Lalu Yesus berubah rupa di depan mata mereka,"
 },
 {
   "id": 24549,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 3,
   "firman": "dan pakaian-Nya sangat putih berkilat-kilat. Tidak ada seorangpun di dunia ini yang dapat mengelantang pakaian seperti itu."
 },
 {
   "id": 24550,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 4,
   "firman": "Maka nampaklah kepada mereka Elia bersama dengan Musa, keduanya sedang berbicara dengan Yesus."
 },
 {
   "id": 24551,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 5,
   "firman": "Kata Petrus kepada Yesus: \"Rabi, betapa bahagianya kami berada di tempat ini. Baiklah kami dirikan tiga kemah, satu untuk Engkau, satu untuk Musa dan satu untuk Elia.\""
 },
 {
   "id": 24552,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 6,
   "firman": "Ia berkata demikian, sebab tidak tahu apa yang harus dikatakannya, karena mereka sangat ketakutan."
 },
 {
   "id": 24553,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 7,
   "firman": "Maka datanglah awan menaungi mereka dan dari dalam awan itu terdengar suara: \"Inilah Anak yang Kukasihi, dengarkanlah Dia.\""
 },
 {
   "id": 24554,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dan sekonyong-konyong waktu mereka memandang sekeliling mereka, mereka tidak melihat seorangpun lagi bersama mereka, kecuali Yesus seorang diri."
 },
 {
   "id": 24555,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 9,
   "firman": "Pada waktu mereka turun dari gunung itu, Yesus berpesan kepada mereka, supaya mereka jangan menceriterakan kepada seorangpun apa yang telah mereka lihat itu, sebelum Anak Manusia bangkit dari antara orang mati."
 },
 {
   "id": 24556,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 10,
   "firman": "Mereka memegang pesan tadi sambil mempersoalkan di antara mereka apa yang dimaksud dengan \"bangkit dari antara orang mati.\""
 },
 {
   "id": 24557,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 11,
   "firman": "Lalu mereka bertanya kepada-Nya: \"Mengapa ahli-ahli Taurat berkata, bahwa Elia harus datang dahulu?\""
 },
 {
   "id": 24558,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 12,
   "firman": "Jawab Yesus: \"Memang Elia akan datang dahulu dan memulihkan segala sesuatu. Hanya, bagaimanakah dengan yang ada tertulis mengenai Anak Manusia, bahwa Ia akan banyak menderita dan akan dihinakan?"
 },
 {
   "id": 24559,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 13,
   "firman": "Tetapi Aku berkata kepadamu: Memang Elia sudah datang dan orang memperlakukan dia menurut kehendak mereka, sesuai dengan yang ada tertulis tentang dia.\""
 },
 {
   "id": 24560,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 14,
   "firman": "Ketika Yesus, Petrus, Yakobus dan Yohanes kembali pada murid-murid lain, mereka melihat orang banyak mengerumuni murid-murid itu, dan beberapa ahli Taurat sedang mempersoalkan sesuatu dengan mereka."
 },
 {
   "id": 24561,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 15,
   "firman": "Pada waktu orang banyak itu melihat Yesus, tercenganglah mereka semua dan bergegas menyambut Dia."
 },
 {
   "id": 24562,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 16,
   "firman": "Lalu Yesus bertanya kepada mereka: \"Apa yang kamu persoalkan dengan mereka?\""
 },
 {
   "id": 24563,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 17,
   "firman": "Kata seorang dari orang banyak itu: \"Guru, anakku ini kubawa kepada-Mu, karena ia kerasukan roh yang membisukan dia."
 },
 {
   "id": 24564,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 18,
   "firman": "Dan setiap kali roh itu menyerang dia, roh itu membantingkannya ke tanah; lalu mulutnya berbusa, giginya bekertakan dan tubuhnya menjadi kejang. Aku sudah meminta kepada murid-murid-Mu, supaya mereka mengusir roh itu, tetapi mereka tidak dapat.\""
 },
 {
   "id": 24565,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 19,
   "firman": "Maka kata Yesus kepada mereka: \"Hai kamu angkatan yang tidak percaya, berapa lama lagi Aku harus tinggal di antara kamu? Berapa lama lagi Aku harus sabar terhadap kamu? Bawalah anak itu ke mari!\""
 },
 {
   "id": 24566,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 20,
   "firman": "Lalu mereka membawanya kepada-Nya. Waktu roh itu melihat Yesus, anak itu segera digoncang-goncangnya, dan anak itu terpelanting ke tanah dan terguling-guling, sedang mulutnya berbusa."
 },
 {
   "id": 24567,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 21,
   "firman": "Lalu Yesus bertanya kepada ayah anak itu: \"Sudah berapa lama ia mengalami ini?\" Jawabnya: \"Sejak masa kecilnya."
 },
 {
   "id": 24568,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 22,
   "firman": "Dan seringkali roh itu menyeretnya ke dalam api ataupun ke dalam air untuk membinasakannya. Sebab itu jika Engkau dapat berbuat sesuatu, tolonglah kami dan kasihanilah kami.\""
 },
 {
   "id": 24569,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 23,
   "firman": "Jawab Yesus: \"Katamu: jika Engkau dapat? Tidak ada yang mustahil bagi orang yang percaya!\""
 },
 {
   "id": 24570,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 24,
   "firman": "Segera ayah anak itu berteriak: \"Aku percaya. Tolonglah aku yang tidak percaya ini!\""
 },
 {
   "id": 24571,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 25,
   "firman": "Ketika Yesus melihat orang banyak makin datang berkerumun, Ia menegor roh jahat itu dengan keras, kata-Nya: \"Hai kau roh yang menyebabkan orang menjadi bisu dan tuli, Aku memerintahkan engkau, keluarlah dari pada anak ini dan jangan memasukinya lagi!\""
 },
 {
   "id": 24572,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 26,
   "firman": "Lalu keluarlah roh itu sambil berteriak dan menggoncang-goncang anak itu dengan hebatnya. Anak itu kelihatannya seperti orang mati, sehingga banyak orang yang berkata: \"Ia sudah mati.\""
 },
 {
   "id": 24573,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 27,
   "firman": "Tetapi Yesus memegang tangan anak itu dan membangunkannya, lalu ia bangkit sendiri."
 },
 {
   "id": 24574,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 28,
   "firman": "Ketika Yesus sudah di rumah, dan murid-murid-Nya sendirian dengan Dia, bertanyalah mereka: \"Mengapa kami tidak dapat mengusir roh itu?\""
 },
 {
   "id": 24575,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 29,
   "firman": "Jawab-Nya kepada mereka: \"Jenis ini tidak dapat diusir kecuali dengan berdoa.\""
 },
 {
   "id": 24576,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 30,
   "firman": "Yesus dan murid-murid-Nya berangkat dari situ dan melewati Galilea, dan Yesus tidak mau hal itu diketahui orang;"
 },
 {
   "id": 24577,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 31,
   "firman": "sebab Ia sedang mengajar murid-murid-Nya. Ia berkata kepada mereka: \"Anak Manusia akan diserahkan ke dalam tangan manusia, dan mereka akan membunuh Dia, dan tiga hari sesudah Ia dibunuh Ia akan bangkit.\""
 },
 {
   "id": 24578,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 32,
   "firman": "Mereka tidak mengerti perkataan itu, namun segan menanyakannya kepada-Nya."
 },
 {
   "id": 24579,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 33,
   "firman": "Kemudian tibalah Yesus dan murid-murid-Nya di Kapernaum. Ketika Yesus sudah di rumah, Ia bertanya kepada murid-murid-Nya: \"Apa yang kamu perbincangkan tadi di tengah jalan?\""
 },
 {
   "id": 24580,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 34,
   "firman": "Tetapi mereka diam, sebab di tengah jalan tadi mereka mempertengkarkan siapa yang terbesar di antara mereka."
 },
 {
   "id": 24581,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 35,
   "firman": "Lalu Yesus duduk dan memanggil kedua belas murid itu. Kata-Nya kepada mereka: \"Jika seseorang ingin menjadi yang terdahulu, hendaklah ia menjadi yang terakhir dari semuanya dan pelayan dari semuanya.\""
 },
 {
   "id": 24582,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 36,
   "firman": "Maka Yesus mengambil seorang anak kecil dan menempatkannya di tengah-tengah mereka, kemudian Ia memeluk anak itu dan berkata kepada mereka:"
 },
 {
   "id": 24583,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 37,
   "firman": "\"Barangsiapa menyambut seorang anak seperti ini dalam nama-Ku, ia menyambut Aku. Dan barangsiapa menyambut Aku, bukan Aku yang disambutnya, tetapi Dia yang mengutus Aku.\""
 },
 {
   "id": 24584,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 38,
   "firman": "Kata Yohanes kepada Yesus: \"Guru, kami lihat seorang yang bukan pengikut kita mengusir setan demi nama-Mu, lalu kami cegah orang itu, karena ia bukan pengikut kita.\""
 },
 {
   "id": 24585,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 39,
   "firman": "Tetapi kata Yesus: \"Jangan kamu cegah dia! Sebab tidak seorangpun yang telah mengadakan mujizat demi nama-Ku, dapat seketika itu juga mengumpat Aku."
 },
 {
   "id": 24586,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 40,
   "firman": "Barangsiapa tidak melawan kita, ia ada di pihak kita."
 },
 {
   "id": 24587,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 41,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa memberi kamu minum secangkir air oleh karena kamu adalah pengikut Kristus, ia tidak akan kehilangan upahnya.\""
 },
 {
   "id": 24588,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 42,
   "firman": "\"Barangsiapa menyesatkan salah satu dari anak-anak kecil yang percaya ini, lebih baik baginya jika sebuah batu kilangan diikatkan pada lehernya lalu ia dibuang ke dalam laut."
 },
 {
   "id": 24589,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 43,
   "firman": "Dan jika tanganmu menyesatkan engkau, penggallah, karena lebih baik engkau masuk ke dalam hidup dengan tangan kudung dari pada dengan utuh kedua tanganmu dibuang ke dalam neraka, ke dalam api yang tak terpadamkan;"
 },
 {
   "id": 24590,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 44,
   "firman": "(di tempat itu ulatnya tidak akan mati, dan apinya tidak akan padam.)"
 },
 {
   "id": 24591,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 45,
   "firman": "Dan jika kakimu menyesatkan engkau, penggallah, karena lebih baik engkau masuk ke dalam hidup dengan timpang, dari pada dengan utuh kedua kakimu dicampakkan ke dalam neraka;"
 },
 {
   "id": 24592,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 46,
   "firman": "(di tempat itu ulatnya tidak akan mati, dan apinya tidak akan padam.)"
 },
 {
   "id": 24593,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 47,
   "firman": "Dan jika matamu menyesatkan engkau, cungkillah, karena lebih baik engkau masuk ke dalam Kerajaan Allah dengan bermata satu dari pada dengan bermata dua dicampakkan ke dalam neraka,"
 },
 {
   "id": 24594,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 48,
   "firman": "di mana ulat-ulat bangkai tidak mati dan api tidak padam."
 },
 {
   "id": 24595,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 49,
   "firman": "Karena setiap orang akan digarami dengan api."
 },
 {
   "id": 24596,
   "kitab": "Mrk",
   "pasal": 9,
   "ayat": 50,
   "firman": "Garam memang baik, tetapi jika garam menjadi hambar, dengan apakah kamu mengasinkannya? Hendaklah kamu selalu mempunyai garam dalam dirimu dan selalu hidup berdamai yang seorang dengan yang lain.\""
 },
 {
   "id": 24597,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 1,
   "firman": "Dari situ Yesus berangkat ke daerah Yudea dan ke daerah seberang sungai Yordan dan di situpun orang banyak datang mengerumuni Dia; dan seperti biasa Ia mengajar mereka pula."
 },
 {
   "id": 24598,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 2,
   "firman": "Maka datanglah orang-orang Farisi, dan untuk mencobai Yesus mereka bertanya kepada-Nya: \"Apakah seorang suami diperbolehkan menceraikan isterinya?\""
 },
 {
   "id": 24599,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 3,
   "firman": "Tetapi jawab-Nya kepada mereka: \"Apa perintah Musa kepada kamu?\""
 },
 {
   "id": 24600,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 4,
   "firman": "Jawab mereka: \"Musa memberi izin untuk menceraikannya dengan membuat surat cerai.\""
 },
 {
   "id": 24601,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 5,
   "firman": "Lalu kata Yesus kepada mereka: \"Justru karena ketegaran hatimulah maka Musa menuliskan perintah ini untuk kamu."
 },
 {
   "id": 24602,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 6,
   "firman": "Sebab pada awal dunia, Allah menjadikan mereka laki-laki dan perempuan,"
 },
 {
   "id": 24603,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 7,
   "firman": "sebab itu laki-laki akan meninggalkan ayahnya dan ibunya dan bersatu dengan isterinya,"
 },
 {
   "id": 24604,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 8,
   "firman": "sehingga keduanya itu menjadi satu daging. Demikianlah mereka bukan lagi dua, melainkan satu."
 },
 {
   "id": 24605,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 9,
   "firman": "Karena itu, apa yang telah dipersatukan Allah, tidak boleh diceraikan manusia.\""
 },
 {
   "id": 24606,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 10,
   "firman": "Ketika mereka sudah di rumah, murid-murid itu bertanya pula kepada Yesus tentang hal itu."
 },
 {
   "id": 24607,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 11,
   "firman": "Lalu kata-Nya kepada mereka: \"Barangsiapa menceraikan isterinya lalu kawin dengan perempuan lain, ia hidup dalam perzinahan terhadap isterinya itu."
 },
 {
   "id": 24608,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 12,
   "firman": "Dan jika si isteri menceraikan suaminya dan kawin dengan laki-laki lain, ia berbuat zinah.\""
 },
 {
   "id": 24609,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 13,
   "firman": "Lalu orang membawa anak-anak kecil kepada Yesus, supaya Ia menjamah mereka; akan tetapi murid-murid-Nya memarahi orang-orang itu."
 },
 {
   "id": 24610,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 14,
   "firman": "Ketika Yesus melihat hal itu, Ia marah dan berkata kepada mereka: \"Biarkan anak-anak itu datang kepada-Ku, jangan menghalang-halangi mereka, sebab orang-orang yang seperti itulah yang empunya Kerajaan Allah."
 },
 {
   "id": 24611,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 15,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa tidak menyambut Kerajaan Allah seperti seorang anak kecil, ia tidak akan masuk ke dalamnya.\""
 },
 {
   "id": 24612,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 16,
   "firman": "Lalu Ia memeluk anak-anak itu dan sambil meletakkan tangan-Nya atas mereka Ia memberkati mereka."
 },
 {
   "id": 24613,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 17,
   "firman": "Pada waktu Yesus berangkat untuk meneruskan perjalanan-Nya, datanglah seorang berlari-lari mendapatkan Dia dan sambil bertelut di hadapan-Nya ia bertanya: \"Guru yang baik, apa yang harus kuperbuat untuk memperoleh hidup yang kekal?\""
 },
 {
   "id": 24614,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 18,
   "firman": "Jawab Yesus: \"Mengapa kaukatakan Aku baik? Tak seorangpun yang baik selain dari pada Allah saja."
 },
 {
   "id": 24615,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 19,
   "firman": "Engkau tentu mengetahui segala perintah Allah: Jangan membunuh, jangan berzinah, jangan mencuri, jangan mengucapkan saksi dusta, jangan mengurangi hak orang, hormatilah ayahmu dan ibumu!\""
 },
 {
   "id": 24616,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 20,
   "firman": "Lalu kata orang itu kepada-Nya: \"Guru, semuanya itu telah kuturuti sejak masa mudaku.\""
 },
 {
   "id": 24617,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 21,
   "firman": "Tetapi Yesus memandang dia dan menaruh kasih kepadanya, lalu berkata kepadanya: \"Hanya satu lagi kekuranganmu: pergilah, juallah apa yang kaumiliki dan berikanlah itu kepada orang-orang miskin, maka engkau akan beroleh harta di sorga, kemudian datanglah ke mari dan ikutlah Aku.\""
 },
 {
   "id": 24618,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 22,
   "firman": "Mendengar perkataan itu ia menjadi kecewa, lalu pergi dengan sedih, sebab banyak hartanya."
 },
 {
   "id": 24619,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 23,
   "firman": "Lalu Yesus memandang murid-murid-Nya di sekeliling-Nya dan berkata kepada mereka: \"Alangkah sukarnya orang yang beruang masuk ke dalam Kerajaan Allah.\""
 },
 {
   "id": 24620,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 24,
   "firman": "Murid-murid-Nya tercengang mendengar perkataan-Nya itu. Tetapi Yesus menyambung lagi: \"Anak-anak-Ku, alangkah sukarnya masuk ke dalam Kerajaan Allah."
 },
 {
   "id": 24621,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 25,
   "firman": "Lebih mudah seekor unta melewati lobang jarum dari pada seorang kaya masuk ke dalam Kerajaan Allah.\""
 },
 {
   "id": 24622,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 26,
   "firman": "Mereka makin gempar dan berkata seorang kepada yang lain: \"Jika demikian, siapakah yang dapat diselamatkan?\""
 },
 {
   "id": 24623,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 27,
   "firman": "Yesus memandang mereka dan berkata: \"Bagi manusia hal itu tidak mungkin, tetapi bukan demikian bagi Allah. Sebab segala sesuatu adalah mungkin bagi Allah.\""
 },
 {
   "id": 24624,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 28,
   "firman": "Berkatalah Petrus kepada Yesus: \"Kami ini telah meninggalkan segala sesuatu dan mengikut Engkau!\""
 },
 {
   "id": 24625,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 29,
   "firman": "Jawab Yesus: \"Aku berkata kepadamu, sesungguhnya setiap orang yang karena Aku dan karena Injil meninggalkan rumahnya, saudaranya laki-laki atau saudaranya perempuan, ibunya atau bapanya, anak-anaknya atau ladangnya,"
 },
 {
   "id": 24626,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 30,
   "firman": "orang itu sekarang pada masa ini juga akan menerima kembali seratus kali lipat: rumah, saudara laki-laki, saudara perempuan, ibu, anak dan ladang, sekalipun disertai berbagai penganiayaan, dan pada zaman yang akan datang ia akan menerima hidup yang kekal."
 },
 {
   "id": 24627,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 31,
   "firman": "Tetapi banyak orang yang terdahulu akan menjadi yang terakhir dan yang terakhir akan menjadi yang terdahulu.\""
 },
 {
   "id": 24628,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 32,
   "firman": "Yesus dan murid-murid-Nya sedang dalam perjalanan ke Yerusalem dan Yesus berjalan di depan. Murid-murid merasa cemas dan juga orang-orang yang mengikuti Dia dari belakang merasa takut. Sekali lagi Yesus memanggil kedua belas murid-Nya dan Ia mulai mengatakan kepada mereka apa yang akan terjadi atas diri-Nya,"
 },
 {
   "id": 24629,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 33,
   "firman": "kata-Nya: \"Sekarang kita pergi ke Yerusalem dan Anak Manusia akan diserahkan kepada imam-imam kepala dan ahli-ahli Taurat, dan mereka akan menjatuhi Dia hukuman mati. Dan mereka akan menyerahkan Dia kepada bangsa-bangsa yang tidak mengenal Allah,"
 },
 {
   "id": 24630,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 34,
   "firman": "dan Ia akan diolok-olokkan, diludahi, disesah dan dibunuh, dan sesudah tiga hari Ia akan bangkit.\""
 },
 {
   "id": 24631,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 35,
   "firman": "Lalu Yakobus dan Yohanes, anak-anak Zebedeus, mendekati Yesus dan berkata kepada-Nya: \"Guru, kami harap supaya Engkau kiranya mengabulkan suatu permintaan kami!\""
 },
 {
   "id": 24632,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 36,
   "firman": "Jawab-Nya kepada mereka: \"Apa yang kamu kehendaki Aku perbuat bagimu?\""
 },
 {
   "id": 24633,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 37,
   "firman": "Lalu kata mereka: \"Perkenankanlah kami duduk dalam kemuliaan-Mu kelak, yang seorang lagi di sebelah kanan-Mu dan yang seorang di sebelah kiri-Mu.\""
 },
 {
   "id": 24634,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 38,
   "firman": "Tetapi kata Yesus kepada mereka: \"Kamu tidak tahu apa yang kamu minta. Dapatkah kamu meminum cawan yang harus Kuminum dan dibaptis dengan baptisan yang harus Kuterima?\""
 },
 {
   "id": 24635,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 39,
   "firman": "Jawab mereka: \"Kami dapat.\" Yesus berkata kepada mereka: \"Memang, kamu akan meminum cawan yang harus Kuminum dan akan dibaptis dengan baptisan yang harus Kuterima."
 },
 {
   "id": 24636,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 40,
   "firman": "Tetapi hal duduk di sebelah kanan-Ku atau di sebelah kiri-Ku, Aku tidak berhak memberikannya. Itu akan diberikan kepada orang-orang bagi siapa itu telah disediakan.\""
 },
 {
   "id": 24637,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 41,
   "firman": "Mendengar itu kesepuluh murid yang lain menjadi marah kepada Yakobus dan Yohanes."
 },
 {
   "id": 24638,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 42,
   "firman": "Tetapi Yesus memanggil mereka lalu berkata: \"Kamu tahu, bahwa mereka yang disebut pemerintah bangsa-bangsa memerintah rakyatnya dengan tangan besi, dan pembesar-pembesarnya menjalankan kuasanya dengan keras atas mereka."
 },
 {
   "id": 24639,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 43,
   "firman": "Tidaklah demikian di antara kamu. Barangsiapa ingin menjadi besar di antara kamu, hendaklah ia menjadi pelayanmu,"
 },
 {
   "id": 24640,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 44,
   "firman": "dan barangsiapa ingin menjadi yang terkemuka di antara kamu, hendaklah ia menjadi hamba untuk semuanya."
 },
 {
   "id": 24641,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 45,
   "firman": "Karena Anak Manusia juga datang bukan untuk dilayani, melainkan untuk melayani dan untuk memberikan nyawa-Nya menjadi tebusan bagi banyak orang.\""
 },
 {
   "id": 24642,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 46,
   "firman": "Lalu tibalah Yesus dan murid-murid-Nya di Yerikho. Dan ketika Yesus keluar dari Yerikho, bersama-sama dengan murid-murid-Nya dan orang banyak yang berbondong-bondong, ada seorang pengemis yang buta, bernama Bartimeus, anak Timeus, duduk di pinggir jalan."
 },
 {
   "id": 24643,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 47,
   "firman": "Ketika didengarnya, bahwa itu adalah Yesus orang Nazaret, mulailah ia berseru: \"Yesus, Anak Daud, kasihanilah aku!\""
 },
 {
   "id": 24644,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 48,
   "firman": "Banyak orang menegornya supaya ia diam. Namun semakin keras ia berseru: \"Anak Daud, kasihanilah aku!\""
 },
 {
   "id": 24645,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 49,
   "firman": "Lalu Yesus berhenti dan berkata: \"Panggillah dia!\" Mereka memanggil orang buta itu dan berkata kepadanya: \"Kuatkan hatimu, berdirilah, Ia memanggil engkau.\""
 },
 {
   "id": 24646,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 50,
   "firman": "Lalu ia menanggalkan jubahnya, ia segera berdiri dan pergi mendapatkan Yesus."
 },
 {
   "id": 24647,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 51,
   "firman": "Tanya Yesus kepadanya: \"Apa yang kaukehendaki supaya Aku perbuat bagimu?\" Jawab orang buta itu: \"Rabuni, supaya aku dapat melihat!\""
 },
 {
   "id": 24648,
   "kitab": "Mrk",
   "pasal": 10,
   "ayat": 52,
   "firman": "Lalu kata Yesus kepadanya: \"Pergilah, imanmu telah menyelamatkan engkau!\" Pada saat itu juga melihatlah ia, lalu ia mengikuti Yesus dalam perjalanan-Nya."
 },
 {
   "id": 24649,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 1,
   "firman": "Ketika Yesus dan murid-murid-Nya telah dekat Yerusalem, dekat Betfage dan Betania yang terletak di Bukit Zaitun, Yesus menyuruh dua orang murid-Nya"
 },
 {
   "id": 24650,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 2,
   "firman": "dengan pesan: \"Pergilah ke kampung yang di depanmu itu. Pada waktu kamu masuk di situ, kamu akan segera menemukan seekor keledai muda tertambat, yang belum pernah ditunggangi orang. Lepaskan keledai itu dan bawalah ke mari."
 },
 {
   "id": 24651,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 3,
   "firman": "Dan jika ada orang mengatakan kepadamu: Mengapa kamu lakukan itu, jawablah: Tuhan memerlukannya. Ia akan segera mengembalikannya ke sini.\""
 },
 {
   "id": 24652,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 4,
   "firman": "Merekapun pergi, dan menemukan seekor keledai muda tertambat di depan pintu di luar, di pinggir jalan, lalu melepaskannya."
 },
 {
   "id": 24653,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 5,
   "firman": "Dan beberapa orang yang ada di situ berkata kepada mereka: \"Apa maksudnya kamu melepaskan keledai itu?\""
 },
 {
   "id": 24654,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 6,
   "firman": "Lalu mereka menjawab seperti yang sudah dikatakan Yesus. Maka orang-orang itu membiarkan mereka."
 },
 {
   "id": 24655,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 7,
   "firman": "Lalu mereka membawa keledai itu kepada Yesus, dan mengalasinya dengan pakaian mereka, kemudian Yesus naik ke atasnya."
 },
 {
   "id": 24656,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 8,
   "firman": "Banyak orang yang menghamparkan pakaiannya di jalan, ada pula yang menyebarkan ranting-ranting hijau yang mereka ambil dari ladang."
 },
 {
   "id": 24657,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 9,
   "firman": "Orang-orang yang berjalan di depan dan mereka yang mengikuti dari belakang berseru: \"Hosana! Diberkatilah Dia yang datang dalam nama Tuhan,"
 },
 {
   "id": 24658,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 10,
   "firman": "diberkatilah Kerajaan yang datang, Kerajaan bapak kita Daud, hosana di tempat yang maha tinggi!\""
 },
 {
   "id": 24659,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 11,
   "firman": "Sesampainya di Yerusalem Ia masuk ke Bait Allah. Di sana Ia meninjau semuanya, tetapi sebab hari sudah hampir malam Ia keluar ke Betania bersama dengan kedua belas murid-Nya."
 },
 {
   "id": 24660,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 12,
   "firman": "Keesokan harinya sesudah Yesus dan kedua belas murid-Nya meninggalkan Betania, Yesus merasa lapar."
 },
 {
   "id": 24661,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 13,
   "firman": "Dan dari jauh Ia melihat pohon ara yang sudah berdaun. Ia mendekatinya untuk melihat kalau-kalau Ia mendapat apa-apa pada pohon itu. Tetapi waktu Ia tiba di situ, Ia tidak mendapat apa-apa selain daun-daun saja, sebab memang bukan musim buah ara."
 },
 {
   "id": 24662,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 14,
   "firman": "Maka kata-Nya kepada pohon itu: \"Jangan lagi seorangpun makan buahmu selama-lamanya!\" Dan murid-murid-Nyapun mendengarnya."
 },
 {
   "id": 24663,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 15,
   "firman": "Lalu tibalah Yesus dan murid-murid-Nya di Yerusalem. Sesudah Yesus masuk ke Bait Allah, mulailah Ia mengusir orang-orang yang berjual beli di halaman Bait Allah. Meja-meja penukar uang dan bangku-bangku pedagang merpati dibalikkan-Nya,"
 },
 {
   "id": 24664,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 16,
   "firman": "dan Ia tidak memperbolehkan orang membawa barang-barang melintasi halaman Bait Allah."
 },
 {
   "id": 24665,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 17,
   "firman": "Lalu Ia mengajar mereka, kata-Nya: \"Bukankah ada tertulis: Rumah-Ku akan disebut rumah doa bagi segala bangsa? Tetapi kamu ini telah menjadikannya sarang penyamun!\""
 },
 {
   "id": 24666,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 18,
   "firman": "Imam-imam kepala dan ahli-ahli Taurat mendengar tentang peristiwa itu, dan mereka berusaha untuk membinasakan Dia, sebab mereka takut kepada-Nya, melihat seluruh orang banyak takjub akan pengajaran-Nya."
 },
 {
   "id": 24667,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 19,
   "firman": "Menjelang malam mereka keluar lagi dari kota."
 },
 {
   "id": 24668,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 20,
   "firman": "Pagi-pagi ketika Yesus dan murid-murid-Nya lewat, mereka melihat pohon ara tadi sudah kering sampai ke akar-akarnya."
 },
 {
   "id": 24669,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 21,
   "firman": "Maka teringatlah Petrus akan apa yang telah terjadi, lalu ia berkata kepada Yesus: \"Rabi, lihatlah, pohon ara yang Kaukutuk itu sudah kering.\""
 },
 {
   "id": 24670,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 22,
   "firman": "Yesus menjawab mereka: \"Percayalah kepada Allah!"
 },
 {
   "id": 24671,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 23,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa berkata kepada gunung ini: Beranjaklah dan tercampaklah ke dalam laut! asal tidak bimbang hatinya, tetapi percaya, bahwa apa yang dikatakannya itu akan terjadi, maka hal itu akan terjadi baginya."
 },
 {
   "id": 24672,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 24,
   "firman": "Karena itu Aku berkata kepadamu: apa saja yang kamu minta dan doakan, percayalah bahwa kamu telah menerimanya, maka hal itu akan diberikan kepadamu."
 },
 {
   "id": 24673,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 25,
   "firman": "Dan jika kamu berdiri untuk berdoa, ampunilah dahulu sekiranya ada barang sesuatu dalam hatimu terhadap seseorang, supaya juga Bapamu yang di sorga mengampuni kesalahan-kesalahanmu.\""
 },
 {
   "id": 24674,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 26,
   "firman": "(Tetapi jika kamu tidak mengampuni, maka Bapamu yang di sorga juga tidak akan mengampuni kesalahan-kesalahanmu.)"
 },
 {
   "id": 24675,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 27,
   "firman": "Lalu Yesus dan murid-murid-Nya tiba pula di Yerusalem. Ketika Yesus berjalan di halaman Bait Allah, datanglah kepada-Nya imam-imam kepala, ahli-ahli Taurat dan tua-tua,"
 },
 {
   "id": 24676,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 28,
   "firman": "dan bertanya kepada-Nya: \"Dengan kuasa manakah Engkau melakukan hal-hal itu? Dan siapakah yang memberikan kuasa itu kepada-Mu, sehingga Engkau melakukan hal-hal itu?\""
 },
 {
   "id": 24677,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 29,
   "firman": "Jawab Yesus kepada mereka: \"Aku akan mengajukan satu pertanyaan kepadamu. Berikanlah Aku jawabnya, maka Aku akan mengatakan kepadamu dengan kuasa manakah Aku melakukan hal-hal itu."
 },
 {
   "id": 24678,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 30,
   "firman": "Baptisan Yohanes itu, dari sorga atau dari manusia? Berikanlah Aku jawabnya!\""
 },
 {
   "id": 24679,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 31,
   "firman": "Mereka memperbincangkannya di antara mereka, dan berkata: \"Jikalau kita katakan: Dari sorga, Ia akan berkata: Kalau begitu, mengapakah kamu tidak percaya kepadanya?"
 },
 {
   "id": 24680,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 32,
   "firman": "Tetapi, masakan kita katakan: Dari manusia!\" Sebab mereka takut kepada orang banyak, karena semua orang menganggap bahwa Yohanes betul-betul seorang nabi."
 },
 {
   "id": 24681,
   "kitab": "Mrk",
   "pasal": 11,
   "ayat": 33,
   "firman": "Lalu mereka menjawab Yesus: \"Kami tidak tahu.\" Maka kata Yesus kepada mereka: \"Jika demikian, Aku juga tidak mengatakan kepadamu dengan kuasa manakah Aku melakukan hal-hal itu.\""
 },
 {
   "id": 24682,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 1,
   "firman": "Lalu Yesus mulai berbicara kepada mereka dalam perumpamaan: \"Adalah seorang membuka kebun anggur dan menanam pagar sekelilingnya. Ia menggali lobang tempat memeras anggur dan mendirikan menara jaga. Kemudian ia menyewakan kebun itu kepada penggarap-penggarap lalu berangkat ke negeri lain."
 },
 {
   "id": 24683,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 2,
   "firman": "Dan ketika sudah tiba musimnya, ia menyuruh seorang hamba kepada penggarap-penggarap itu untuk menerima sebagian dari hasil kebun itu dari mereka."
 },
 {
   "id": 24684,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 3,
   "firman": "Tetapi mereka menangkap hamba itu dan memukulnya, lalu menyuruhnya pergi dengan tangan hampa."
 },
 {
   "id": 24685,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 4,
   "firman": "Kemudian ia menyuruh pula seorang hamba lain kepada mereka. Orang ini mereka pukul sampai luka kepalanya dan sangat mereka permalukan."
 },
 {
   "id": 24686,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 5,
   "firman": "Lalu ia menyuruh seorang hamba lain lagi, dan orang ini mereka bunuh. Dan banyak lagi yang lain, ada yang mereka pukul dan ada yang mereka bunuh."
 },
 {
   "id": 24687,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 6,
   "firman": "Sekarang tinggal hanya satu orang anaknya yang kekasih. Akhirnya ia menyuruh dia kepada mereka, katanya: Anakku akan mereka segani."
 },
 {
   "id": 24688,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 7,
   "firman": "Tetapi penggarap-penggarap itu berkata seorang kepada yang lain: Ia adalah ahli waris, mari kita bunuh dia, maka warisan ini menjadi milik kita."
 },
 {
   "id": 24689,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 8,
   "firman": "Mereka menangkapnya dan membunuhnya, lalu melemparkannya ke luar kebun anggur itu."
 },
 {
   "id": 24690,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 9,
   "firman": "Sekarang apa yang akan dilakukan oleh tuan kebun anggur itu? Ia akan datang dan membinasakan penggarap-penggarap itu, lalu mempercayakan kebun anggur itu kepada orang-orang lain."
 },
 {
   "id": 24691,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 10,
   "firman": "Tidak pernahkah kamu membaca nas ini: Batu yang dibuang oleh tukang-tukang bangunan telah menjadi batu penjuru:"
 },
 {
   "id": 24692,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 11,
   "firman": "hal itu terjadi dari pihak Tuhan, suatu perbuatan ajaib di mata kita.\""
 },
 {
   "id": 24693,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 12,
   "firman": "Lalu mereka berusaha untuk menangkap Yesus, karena mereka tahu, bahwa merekalah yang dimaksudkan-Nya dengan perumpamaan itu. Tetapi mereka takut kepada orang banyak, jadi mereka pergi dan membiarkan Dia."
 },
 {
   "id": 24694,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 13,
   "firman": "Kemudian disuruh beberapa orang Farisi dan Herodian kepada Yesus untuk menjerat Dia dengan suatu pertanyaan."
 },
 {
   "id": 24695,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 14,
   "firman": "Orang-orang itu datang dan berkata kepada-Nya: \"Guru, kami tahu, Engkau adalah seorang yang jujur, dan Engkau tidak takut kepada siapapun juga, sebab Engkau tidak mencari muka, melainkan dengan jujur mengajar jalan Allah dengan segala kejujuran. Apakah diperbolehkan membayar pajak kepada Kaisar atau tidak? Haruskah kami bayar atau tidak?\""
 },
 {
   "id": 24696,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 15,
   "firman": "Tetapi Yesus mengetahui kemunafikan mereka, lalu berkata kepada mereka: \"Mengapa kamu mencobai Aku? Bawalah ke mari suatu dinar supaya Kulihat!\""
 },
 {
   "id": 24697,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 16,
   "firman": "Lalu mereka bawa. Maka Ia bertanya kepada mereka: \"Gambar dan tulisan siapakah ini?\" Jawab mereka: \"Gambar dan tulisan Kaisar.\""
 },
 {
   "id": 24698,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 17,
   "firman": "Lalu kata Yesus kepada mereka: \"Berikanlah kepada Kaisar apa yang wajib kamu berikan kepada Kaisar dan kepada Allah apa yang wajib kamu berikan kepada Allah!\" Mereka sangat heran mendengar Dia."
 },
 {
   "id": 24699,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 18,
   "firman": "Datanglah kepada Yesus beberapa orang Saduki, yang berpendapat, bahwa tidak ada kebangkitan. Mereka bertanya kepada-Nya:"
 },
 {
   "id": 24700,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 19,
   "firman": "\"Guru, Musa menuliskan perintah ini untuk kita: Jika seorang, yang mempunyai saudara laki-laki, mati dengan meninggalkan seorang isteri tetapi tidak meninggalkan anak, saudaranya harus kawin dengan isterinya itu dan membangkitkan keturunan bagi saudaranya itu."
 },
 {
   "id": 24701,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 20,
   "firman": "Adalah tujuh orang bersaudara. Yang pertama kawin dengan seorang perempuan dan mati dengan tidak meninggalkan keturunan."
 },
 {
   "id": 24702,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 21,
   "firman": "Lalu yang kedua juga mengawini dia dan mati dengan tidak meninggalkan keturunan. Demikian juga dengan yang ketiga."
 },
 {
   "id": 24703,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 22,
   "firman": "Dan begitulah seterusnya, ketujuhnya tidak meninggalkan keturunan. Dan akhirnya, sesudah mereka semua, perempuan itupun mati."
 },
 {
   "id": 24704,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 23,
   "firman": "Pada hari kebangkitan, bilamana mereka bangkit, siapakah yang menjadi suami perempuan itu? Sebab ketujuhnya telah beristerikan dia.\""
 },
 {
   "id": 24705,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 24,
   "firman": "Jawab Yesus kepada mereka: \"Kamu sesat, justru karena kamu tidak mengerti Kitab Suci maupun kuasa Allah."
 },
 {
   "id": 24706,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 25,
   "firman": "Sebab apabila orang bangkit dari antara orang mati, orang tidak kawin dan tidak dikawinkan melainkan hidup seperti malaikat di sorga."
 },
 {
   "id": 24707,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 26,
   "firman": "Dan juga tentang bangkitnya orang-orang mati, tidakkah kamu baca dalam kitab Musa, dalam ceritera tentang semak duri, bagaimana bunyi firman Allah kepadanya: Akulah Allah Abraham, Allah Ishak dan Allah Yakub?"
 },
 {
   "id": 24708,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 27,
   "firman": "Ia bukanlah Allah orang mati, melainkan Allah orang hidup. Kamu benar-benar sesat!\""
 },
 {
   "id": 24709,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 28,
   "firman": "Lalu seorang ahli Taurat, yang mendengar Yesus dan orang-orang Saduki bersoal jawab dan tahu, bahwa Yesus memberi jawab yang tepat kepada orang-orang itu, datang kepada-Nya dan bertanya: \"Hukum manakah yang paling utama?\""
 },
 {
   "id": 24710,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 29,
   "firman": "Jawab Yesus: \"Hukum yang terutama ialah: Dengarlah, hai orang Israel, Tuhan Allah kita, Tuhan itu esa."
 },
 {
   "id": 24711,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 30,
   "firman": "Kasihilah Tuhan, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu dan dengan segenap akal budimu dan dengan segenap kekuatanmu."
 },
 {
   "id": 24712,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 31,
   "firman": "Dan hukum yang kedua ialah: Kasihilah sesamamu manusia seperti dirimu sendiri. Tidak ada hukum lain yang lebih utama dari pada kedua hukum ini.\""
 },
 {
   "id": 24713,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 32,
   "firman": "Lalu kata ahli Taurat itu kepada Yesus: \"Tepat sekali, Guru, benar kata-Mu itu, bahwa Dia esa, dan bahwa tidak ada yang lain kecuali Dia."
 },
 {
   "id": 24714,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 33,
   "firman": "Memang mengasihi Dia dengan segenap hati dan dengan segenap pengertian dan dengan segenap kekuatan, dan juga mengasihi sesama manusia seperti diri sendiri adalah jauh lebih utama dari pada semua korban bakaran dan korban sembelihan.\""
 },
 {
   "id": 24715,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 34,
   "firman": "Yesus melihat, bagaimana bijaksananya jawab orang itu, dan Ia berkata kepadanya: \"Engkau tidak jauh dari Kerajaan Allah!\" Dan seorangpun tidak berani lagi menanyakan sesuatu kepada Yesus."
 },
 {
   "id": 24716,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 35,
   "firman": "Pada suatu kali ketika Yesus mengajar di Bait Allah, Ia berkata: \"Bagaimana ahli-ahli Taurat dapat mengatakan, bahwa Mesias adalah anak Daud?"
 },
 {
   "id": 24717,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 36,
   "firman": "Daud sendiri oleh pimpinan Roh Kudus berkata: Tuhan telah berfirman kepada Tuanku: duduklah di sebelah kanan-Ku, sampai musuh-musuh-Mu Kutaruh di bawah kaki-Mu."
 },
 {
   "id": 24718,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 37,
   "firman": "Daud sendiri menyebut Dia Tuannya, bagaimana mungkin Ia anaknya pula?\" Orang banyak yang besar jumlahnya mendengarkan Dia dengan penuh minat."
 },
 {
   "id": 24719,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 38,
   "firman": "Dalam pengajaran-Nya Yesus berkata: \"Hati-hatilah terhadap ahli-ahli Taurat yang suka berjalan-jalan memakai jubah panjang dan suka menerima penghormatan di pasar,"
 },
 {
   "id": 24720,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 39,
   "firman": "yang suka duduk di tempat terdepan di rumah ibadat dan di tempat terhormat dalam perjamuan,"
 },
 {
   "id": 24721,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 40,
   "firman": "yang menelan rumah janda-janda, sedang mereka mengelabui mata orang dengan doa yang panjang-panjang. Mereka ini pasti akan menerima hukuman yang lebih berat.\""
 },
 {
   "id": 24722,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 41,
   "firman": "Pada suatu kali Yesus duduk menghadapi peti persembahan dan memperhatikan bagaimana orang banyak memasukkan uang ke dalam peti itu. Banyak orang kaya memberi jumlah yang besar."
 },
 {
   "id": 24723,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 42,
   "firman": "Lalu datanglah seorang janda yang miskin dan ia memasukkan dua peser, yaitu satu duit."
 },
 {
   "id": 24724,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 43,
   "firman": "Maka dipanggil-Nya murid-murid-Nya dan berkata kepada mereka: \"Aku berkata kepadamu, sesungguhnya janda miskin ini memberi lebih banyak dari pada semua orang yang memasukkan uang ke dalam peti persembahan."
 },
 {
   "id": 24725,
   "kitab": "Mrk",
   "pasal": 12,
   "ayat": 44,
   "firman": "Sebab mereka semua memberi dari kelimpahannya, tetapi janda ini memberi dari kekurangannya, semua yang ada padanya, yaitu seluruh nafkahnya.\""
 },
 {
   "id": 24726,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 1,
   "firman": "Ketika Yesus keluar dari Bait Allah, seorang murid-Nya berkata kepada-Nya: \"Guru, lihatlah betapa kokohnya batu-batu itu dan betapa megahnya gedung-gedung itu!\""
 },
 {
   "id": 24727,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 2,
   "firman": "Lalu Yesus berkata kepadanya: \"Kaulihat gedung-gedung yang hebat ini? Tidak satu batupun akan dibiarkan terletak di atas batu yang lain, semuanya akan diruntuhkan.\""
 },
 {
   "id": 24728,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 3,
   "firman": "Ketika Yesus duduk di atas Bukit Zaitun, berhadapan dengan Bait Allah, Petrus, Yakobus, Yohanes dan Andreas bertanya sendirian kepada-Nya:"
 },
 {
   "id": 24729,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 4,
   "firman": "\"Katakanlah kepada kami, bilamanakah itu akan terjadi, dan apakah tandanya, kalau semuanya itu akan sampai kepada kesudahannya.\""
 },
 {
   "id": 24730,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 5,
   "firman": "Maka mulailah Yesus berkata kepada mereka: \"Waspadalah supaya jangan ada orang yang menyesatkan kamu!"
 },
 {
   "id": 24731,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 6,
   "firman": "Akan datang banyak orang dengan memakai nama-Ku dan berkata: Akulah dia, dan mereka akan menyesatkan banyak orang."
 },
 {
   "id": 24732,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 7,
   "firman": "Dan apabila kamu mendengar deru perang atau kabar-kabar tentang perang, janganlah kamu gelisah. Semuanya itu harus terjadi, tetapi itu belum kesudahannya."
 },
 {
   "id": 24733,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 8,
   "firman": "Sebab bangsa akan bangkit melawan bangsa dan kerajaan melawan kerajaan. Akan terjadi gempa bumi di berbagai tempat, dan akan ada kelaparan. Semua itu barulah permulaan penderitaan menjelang zaman baru."
 },
 {
   "id": 24734,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 9,
   "firman": "Tetapi kamu ini, hati-hatilah! Kamu akan diserahkan kepada majelis agama dan kamu akan dipukul di rumah ibadat dan kamu akan dihadapkan ke muka penguasa-penguasa dan raja-raja karena Aku, sebagai kesaksian bagi mereka."
 },
 {
   "id": 24735,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 10,
   "firman": "Tetapi Injil harus diberitakan dahulu kepada semua bangsa."
 },
 {
   "id": 24736,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 11,
   "firman": "Dan jika kamu digiring dan diserahkan, janganlah kamu kuatir akan apa yang harus kamu katakan, tetapi katakanlah apa yang dikaruniakan kepadamu pada saat itu juga, sebab bukan kamu yang berkata-kata, melainkan Roh Kudus."
 },
 {
   "id": 24737,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 12,
   "firman": "Seorang saudara akan menyerahkan saudaranya untuk dibunuh, demikian juga seorang ayah terhadap anaknya. Dan anak-anak akan memberontak terhadap orang tuanya dan akan membunuh mereka."
 },
 {
   "id": 24738,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 13,
   "firman": "Kamu akan dibenci semua orang oleh karena nama-Ku. Tetapi orang yang bertahan sampai pada kesudahannya ia akan selamat.\""
 },
 {
   "id": 24739,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 14,
   "firman": "\"Apabila kamu melihat Pembinasa keji berdiri di tempat yang tidak sepatutnya--para pembaca hendaklah memperhatikannya--maka orang-orang yang di Yudea haruslah melarikan diri ke pegunungan."
 },
 {
   "id": 24740,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 15,
   "firman": "Orang yang sedang di peranginan di atas rumah janganlah ia turun dan masuk untuk mengambil sesuatu dari rumahnya,"
 },
 {
   "id": 24741,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 16,
   "firman": "dan orang yang sedang di ladang janganlah ia kembali untuk mengambil pakaiannya."
 },
 {
   "id": 24742,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 17,
   "firman": "Celakalah ibu-ibu yang sedang hamil atau yang menyusukan bayi pada masa itu."
 },
 {
   "id": 24743,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 18,
   "firman": "Berdoalah, supaya semuanya itu jangan terjadi pada musim dingin."
 },
 {
   "id": 24744,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 19,
   "firman": "Sebab pada masa itu akan terjadi siksaan seperti yang belum pernah terjadi sejak awal dunia, yang diciptakan Allah, sampai sekarang dan yang tidak akan terjadi lagi."
 },
 {
   "id": 24745,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 20,
   "firman": "Dan sekiranya Tuhan tidak mempersingkat waktunya, maka dari segala yang hidup tidak akan ada yang selamat; akan tetapi oleh karena orang-orang pilihan yang telah dipilih-Nya, Tuhan mempersingkat waktunya."
 },
 {
   "id": 24746,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 21,
   "firman": "Pada waktu itu jika orang berkata kepada kamu: Lihat, Mesias ada di sini, atau: Lihat, Mesias ada di sana, jangan kamu percaya."
 },
 {
   "id": 24747,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 22,
   "firman": "Sebab Mesias-mesias palsu dan nabi-nabi palsu akan muncul dan mereka akan mengadakan tanda-tanda dan mujizat-mujizat dengan maksud, sekiranya mungkin, menyesatkan orang-orang pilihan."
 },
 {
   "id": 24748,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 23,
   "firman": "Hati-hatilah kamu! Aku sudah terlebih dahulu mengatakan semuanya ini kepada kamu.\""
 },
 {
   "id": 24749,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 24,
   "firman": "\"Tetapi pada masa itu, sesudah siksaan itu, matahari akan menjadi gelap dan bulan tidak bercahaya"
 },
 {
   "id": 24750,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 25,
   "firman": "dan bintang-bintang akan berjatuhan dari langit, dan kuasa-kuasa langit akan goncang."
 },
 {
   "id": 24751,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 26,
   "firman": "Pada waktu itu orang akan melihat Anak Manusia datang dalam awan-awan dengan segala kekuasaan dan kemuliaan-Nya."
 },
 {
   "id": 24752,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 27,
   "firman": "Dan pada waktu itupun Ia akan menyuruh keluar malaikat-malaikat-Nya dan akan mengumpulkan orang-orang pilihan-Nya dari keempat penjuru bumi, dari ujung bumi sampai ke ujung langit."
 },
 {
   "id": 24753,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 28,
   "firman": "Tariklah pelajaran dari perumpamaan tentang pohon ara. Apabila ranting-rantingnya melembut dan mulai bertunas, kamu tahu, bahwa musim panas sudah dekat."
 },
 {
   "id": 24754,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 29,
   "firman": "Demikian juga, jika kamu lihat hal-hal itu terjadi, ketahuilah bahwa waktunya sudah dekat, sudah di ambang pintu."
 },
 {
   "id": 24755,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 30,
   "firman": "Aku berkata kepadamu: Sesungguhnya angkatan ini tidak akan berlalu, sebelum semuanya itu terjadi."
 },
 {
   "id": 24756,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 31,
   "firman": "Langit dan bumi akan berlalu, tetapi perkataan-Ku tidak akan berlalu."
 },
 {
   "id": 24757,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 32,
   "firman": "Tetapi tentang hari atau saat itu tidak seorangpun yang tahu, malaikat-malaikat di sorga tidak, dan Anakpun tidak, hanya Bapa saja.\""
 },
 {
   "id": 24758,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 33,
   "firman": "\"Hati-hatilah dan berjaga-jagalah! Sebab kamu tidak tahu bilamanakah waktunya tiba."
 },
 {
   "id": 24759,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 34,
   "firman": "Dan halnya sama seperti seorang yang bepergian, yang meninggalkan rumahnya dan menyerahkan tanggung jawab kepada hamba-hambanya, masing-masing dengan tugasnya, dan memerintahkan penunggu pintu supaya berjaga-jaga."
 },
 {
   "id": 24760,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 35,
   "firman": "Karena itu berjaga-jagalah, sebab kamu tidak tahu bilamanakah tuan rumah itu pulang, menjelang malam, atau tengah malam, atau larut malam, atau pagi-pagi buta,"
 },
 {
   "id": 24761,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 36,
   "firman": "supaya kalau ia tiba-tiba datang jangan kamu didapatinya sedang tidur."
 },
 {
   "id": 24762,
   "kitab": "Mrk",
   "pasal": 13,
   "ayat": 37,
   "firman": "Apa yang Kukatakan kepada kamu, Kukatakan kepada semua orang: berjaga-jagalah!\""
 },
 {
   "id": 24763,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 1,
   "firman": "Hari raya Paskah dan hari raya Roti Tidak Beragi akan mulai dua hari lagi. Imam-imam kepala dan ahli-ahli Taurat mencari jalan untuk menangkap dan membunuh Yesus dengan tipu muslihat,"
 },
 {
   "id": 24764,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 2,
   "firman": "sebab mereka berkata: \"Jangan pada waktu perayaan, supaya jangan timbul keributan di antara rakyat.\""
 },
 {
   "id": 24765,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 3,
   "firman": "Ketika Yesus berada di Betania, di rumah Simon si kusta, dan sedang duduk makan, datanglah seorang perempuan membawa suatu buli-buli pualam berisi minyak narwastu murni yang mahal harganya. Setelah dipecahkannya leher buli-buli itu, dicurahkannya minyak itu ke atas kepala Yesus."
 },
 {
   "id": 24766,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 4,
   "firman": "Ada orang yang menjadi gusar dan berkata seorang kepada yang lain: \"Untuk apa pemborosan minyak narwastu ini?"
 },
 {
   "id": 24767,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 5,
   "firman": "Sebab minyak ini dapat dijual tiga ratus dinar lebih dan uangnya dapat diberikan kepada orang-orang miskin.\" Lalu mereka memarahi perempuan itu."
 },
 {
   "id": 24768,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi Yesus berkata: \"Biarkanlah dia. Mengapa kamu menyusahkan dia? Ia telah melakukan suatu perbuatan yang baik pada-Ku."
 },
 {
   "id": 24769,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 7,
   "firman": "Karena orang-orang miskin selalu ada padamu, dan kamu dapat menolong mereka, bilamana kamu menghendakinya, tetapi Aku tidak akan selalu bersama-sama kamu."
 },
 {
   "id": 24770,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 8,
   "firman": "Ia telah melakukan apa yang dapat dilakukannya. Tubuh-Ku telah diminyakinya sebagai persiapan untuk penguburan-Ku."
 },
 {
   "id": 24771,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 9,
   "firman": "Aku berkata kepadamu: Sesungguhnya di mana saja Injil diberitakan di seluruh dunia, apa yang dilakukannya ini akan disebut juga untuk mengingat dia.\""
 },
 {
   "id": 24772,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 10,
   "firman": "Lalu pergilah Yudas Iskariot, salah seorang dari kedua belas murid itu, kepada imam-imam kepala dengan maksud untuk menyerahkan Yesus kepada mereka."
 },
 {
   "id": 24773,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 11,
   "firman": "Mereka sangat gembira waktu mendengarnya dan mereka berjanji akan memberikan uang kepadanya. Kemudian ia mencari kesempatan yang baik untuk menyerahkan Yesus."
 },
 {
   "id": 24774,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 12,
   "firman": "Pada hari pertama dari hari raya Roti Tidak Beragi, pada waktu orang menyembelih domba Paskah, murid-murid Yesus berkata kepada-Nya: \"Ke tempat mana Engkau kehendaki kami pergi untuk mempersiapkan perjamuan Paskah bagi-Mu?\""
 },
 {
   "id": 24775,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 13,
   "firman": "Lalu Ia menyuruh dua orang murid-Nya dengan pesan: \"Pergilah ke kota; di sana kamu akan bertemu dengan seorang yang membawa kendi berisi air. Ikutilah dia"
 },
 {
   "id": 24776,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 14,
   "firman": "dan katakanlah kepada pemilik rumah yang dimasukinya: Pesan Guru: di manakah ruangan yang disediakan bagi-Ku untuk makan Paskah bersama-sama dengan murid-murid-Ku?"
 },
 {
   "id": 24777,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 15,
   "firman": "Lalu orang itu akan menunjukkan kamu sebuah ruangan atas yang besar, yang sudah lengkap dan tersedia. Di situlah kamu harus mempersiapkan perjamuan Paskah untuk kita!\""
 },
 {
   "id": 24778,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 16,
   "firman": "Maka berangkatlah kedua murid itu dan setibanya di kota, didapati mereka semua seperti yang dikatakan Yesus kepada mereka. Lalu mereka mempersiapkan Paskah."
 },
 {
   "id": 24779,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 17,
   "firman": "Setelah hari malam, datanglah Yesus bersama-sama dengan kedua belas murid itu."
 },
 {
   "id": 24780,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 18,
   "firman": "Ketika mereka duduk di situ dan sedang makan, Yesus berkata: \"Aku berkata kepadamu, sesungguhnya seorang di antara kamu akan menyerahkan Aku, yaitu dia yang makan dengan Aku.\""
 },
 {
   "id": 24781,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 19,
   "firman": "Maka sedihlah hati mereka dan seorang demi seorang berkata kepada-Nya: \"Bukan aku, ya Tuhan?\""
 },
 {
   "id": 24782,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 20,
   "firman": "Ia menjawab: \"Orang itu ialah salah seorang dari kamu yang dua belas ini, dia yang mencelupkan roti ke dalam satu pinggan dengan Aku."
 },
 {
   "id": 24783,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 21,
   "firman": "Anak Manusia memang akan pergi sesuai dengan yang ada tertulis tentang Dia, akan tetapi celakalah orang yang olehnya Anak Manusia itu diserahkan. Adalah lebih baik bagi orang itu sekiranya ia tidak dilahirkan.\""
 },
 {
   "id": 24784,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 22,
   "firman": "Dan ketika Yesus dan murid-murid-Nya sedang makan, Yesus mengambil roti, mengucap berkat, memecah-mecahkannya lalu memberikannya kepada mereka dan berkata: \"Ambillah, inilah tubuh-Ku.\""
 },
 {
   "id": 24785,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 23,
   "firman": "Sesudah itu Ia mengambil cawan, mengucap syukur lalu memberikannya kepada mereka, dan mereka semuanya minum dari cawan itu."
 },
 {
   "id": 24786,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 24,
   "firman": "Dan Ia berkata kepada mereka: \"Inilah darah-Ku, darah perjanjian, yang ditumpahkan bagi banyak orang."
 },
 {
   "id": 24787,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 25,
   "firman": "Aku berkata kepadamu: Sesungguhnya Aku tidak akan minum lagi hasil pokok anggur sampai pada hari Aku meminumnya, yaitu yang baru, dalam Kerajaan Allah.\""
 },
 {
   "id": 24788,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 26,
   "firman": "Sesudah mereka menyanyikan nyanyian pujian, pergilah mereka ke Bukit Zaitun."
 },
 {
   "id": 24789,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 27,
   "firman": "Lalu Yesus berkata kepada mereka: \"Kamu semua akan tergoncang imanmu. Sebab ada tertulis: Aku akan memukul gembala dan domba-domba itu akan tercerai-berai."
 },
 {
   "id": 24790,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 28,
   "firman": "Akan tetapi sesudah Aku bangkit, Aku akan mendahului kamu ke Galilea.\""
 },
 {
   "id": 24791,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 29,
   "firman": "Kata Petrus kepada-Nya: \"Biarpun mereka semua tergoncang imannya, aku tidak.\""
 },
 {
   "id": 24792,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 30,
   "firman": "Lalu kata Yesus kepadanya: \"Aku berkata kepadamu, sesungguhnya pada hari ini, malam ini juga, sebelum ayam berkokok dua kali, engkau telah menyangkal Aku tiga kali.\""
 },
 {
   "id": 24793,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 31,
   "firman": "Tetapi dengan lebih bersungguh-sungguh Petrus berkata: \"Sekalipun aku harus mati bersama-sama Engkau, aku takkan menyangkal Engkau.\" Semua yang lainpun berkata demikian juga."
 },
 {
   "id": 24794,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 32,
   "firman": "Lalu sampailah Yesus dan murid-murid-Nya ke suatu tempat yang bernama Getsemani. Kata Yesus kepada murid-murid-Nya: \"Duduklah di sini, sementara Aku berdoa.\""
 },
 {
   "id": 24795,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 33,
   "firman": "Dan Ia membawa Petrus, Yakobus dan Yohanes serta-Nya. Ia sangat takut dan gentar,"
 },
 {
   "id": 24796,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 34,
   "firman": "lalu kata-Nya kepada mereka: \"Hati-Ku sangat sedih, seperti mau mati rasanya. Tinggallah di sini dan berjaga-jagalah.\""
 },
 {
   "id": 24797,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 35,
   "firman": "Ia maju sedikit, merebahkan diri ke tanah dan berdoa supaya, sekiranya mungkin, saat itu lalu dari pada-Nya."
 },
 {
   "id": 24798,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 36,
   "firman": "Kata-Nya: \"Ya Abba, ya Bapa, tidak ada yang mustahil bagi-Mu, ambillah cawan ini dari pada-Ku, tetapi janganlah apa yang Aku kehendaki, melainkan apa yang Engkau kehendaki.\""
 },
 {
   "id": 24799,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 37,
   "firman": "Setelah itu Ia datang kembali, dan mendapati ketiganya sedang tidur. Dan Ia berkata kepada Petrus: \"Simon, sedang tidurkah engkau? Tidakkah engkau sanggup berjaga-jaga satu jam?"
 },
 {
   "id": 24800,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 38,
   "firman": "Berjaga-jagalah dan berdoalah, supaya kamu jangan jatuh ke dalam pencobaan; roh memang penurut, tetapi daging lemah.\""
 },
 {
   "id": 24801,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 39,
   "firman": "Lalu Ia pergi lagi dan mengucapkan doa yang itu juga."
 },
 {
   "id": 24802,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 40,
   "firman": "Dan ketika Ia kembali pula, Ia mendapati mereka sedang tidur, sebab mata mereka sudah berat dan mereka tidak tahu jawab apa yang harus mereka berikan kepada-Nya."
 },
 {
   "id": 24803,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 41,
   "firman": "Kemudian Ia kembali untuk ketiga kalinya dan berkata kepada mereka: \"Tidurlah sekarang dan istirahatlah. Cukuplah. Saatnya sudah tiba, lihat, Anak Manusia diserahkan ke tangan orang-orang berdosa."
 },
 {
   "id": 24804,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 42,
   "firman": "Bangunlah, marilah kita pergi. Dia yang menyerahkan Aku sudah dekat.\""
 },
 {
   "id": 24805,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 43,
   "firman": "Waktu Yesus masih berbicara, muncullah Yudas, salah seorang dari kedua belas murid itu, dan bersama-sama dia serombongan orang yang membawa pedang dan pentung, disuruh oleh imam-imam kepala, ahli-ahli Taurat dan tua-tua."
 },
 {
   "id": 24806,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 44,
   "firman": "Orang yang menyerahkan Dia telah memberitahukan tanda ini kepada mereka: \"Orang yang akan kucium, itulah Dia, tangkaplah Dia dan bawalah Dia dengan selamat.\""
 },
 {
   "id": 24807,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 45,
   "firman": "Dan ketika ia sampai di situ ia segera maju mendapatkan Yesus dan berkata: \"Rabi,\" lalu mencium Dia."
 },
 {
   "id": 24808,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 46,
   "firman": "Maka mereka memegang Yesus dan menangkap-Nya."
 },
 {
   "id": 24809,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 47,
   "firman": "Salah seorang dari mereka yang ada di situ menghunus pedangnya, lalu menetakkannya kepada hamba Imam Besar sehingga putus telinganya."
 },
 {
   "id": 24810,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 48,
   "firman": "Kata Yesus kepada mereka: \"Sangkamu Aku ini penyamun, maka kamu datang lengkap dengan pedang dan pentung untuk menangkap Aku?"
 },
 {
   "id": 24811,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 49,
   "firman": "Padahal tiap-tiap hari Aku ada di tengah-tengah kamu mengajar di Bait Allah, dan kamu tidak menangkap Aku. Tetapi haruslah digenapi yang tertulis dalam Kitab Suci.\""
 },
 {
   "id": 24812,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 50,
   "firman": "Lalu semua murid itu meninggalkan Dia dan melarikan diri."
 },
 {
   "id": 24813,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 51,
   "firman": "Ada seorang muda, yang pada waktu itu hanya memakai sehelai kain lenan untuk menutup badannya, mengikuti Dia. Mereka hendak menangkapnya,"
 },
 {
   "id": 24814,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 52,
   "firman": "tetapi ia melepaskan kainnya dan lari dengan telanjang."
 },
 {
   "id": 24815,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 53,
   "firman": "Kemudian Yesus dibawa menghadap Imam Besar. Lalu semua imam kepala, tua-tua dan ahli Taurat berkumpul di situ."
 },
 {
   "id": 24816,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 54,
   "firman": "Dan Petrus mengikuti Dia dari jauh, sampai ke dalam halaman Imam Besar, dan di sana ia duduk di antara pengawal-pengawal sambil berdiang dekat api."
 },
 {
   "id": 24817,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 55,
   "firman": "Imam-imam kepala, malah seluruh Mahkamah Agama mencari kesaksian terhadap Yesus supaya Ia dapat dihukum mati, tetapi mereka tidak memperolehnya."
 },
 {
   "id": 24818,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 56,
   "firman": "Banyak juga orang yang mengucapkan kesaksian palsu terhadap Dia, tetapi kesaksian-kesaksian itu tidak sesuai yang satu dengan yang lain."
 },
 {
   "id": 24819,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 57,
   "firman": "Lalu beberapa orang naik saksi melawan Dia dengan tuduhan palsu ini:"
 },
 {
   "id": 24820,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 58,
   "firman": "\"Kami sudah mendengar orang ini berkata: Aku akan merubuhkan Bait Suci buatan tangan manusia ini dan dalam tiga hari akan Kudirikan yang lain, yang bukan buatan tangan manusia.\""
 },
 {
   "id": 24821,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 59,
   "firman": "Dalam hal inipun kesaksian mereka tidak sesuai yang satu dengan yang lain."
 },
 {
   "id": 24822,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 60,
   "firman": "Maka Imam Besar bangkit berdiri di tengah-tengah sidang dan bertanya kepada Yesus, katanya: \"Tidakkah Engkau memberi jawab atas tuduhan-tuduhan saksi-saksi ini terhadap Engkau?\""
 },
 {
   "id": 24823,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 61,
   "firman": "Tetapi Ia tetap diam dan tidak menjawab apa-apa. Imam Besar itu bertanya kepada-Nya sekali lagi, katanya: \"Apakah Engkau Mesias, Anak dari Yang Terpuji?\""
 },
 {
   "id": 24824,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 62,
   "firman": "Jawab Yesus: \"Akulah Dia, dan kamu akan melihat Anak Manusia duduk di sebelah kanan Yang Mahakuasa dan datang di tengah-tengah awan-awan di langit.\""
 },
 {
   "id": 24825,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 63,
   "firman": "Maka Imam Besar itu mengoyakkan pakaiannya dan berkata: \"Untuk apa kita perlu saksi lagi?"
 },
 {
   "id": 24826,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 64,
   "firman": "Kamu sudah mendengar hujat-Nya terhadap Allah. Bagaimana pendapat kamu?\" Lalu dengan suara bulat mereka memutuskan, bahwa Dia harus dihukum mati."
 },
 {
   "id": 24827,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 65,
   "firman": "Lalu mulailah beberapa orang meludahi Dia dan menutupi muka-Nya dan meninju-Nya sambil berkata kepada-Nya: \"Hai nabi, cobalah terka!\" Malah para pengawalpun memukul Dia."
 },
 {
   "id": 24828,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 66,
   "firman": "Pada waktu itu Petrus masih ada di bawah, di halaman. Lalu datanglah seorang hamba perempuan Imam Besar,"
 },
 {
   "id": 24829,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 67,
   "firman": "dan ketika perempuan itu melihat Petrus sedang berdiang, ia menatap mukanya dan berkata: \"Engkau juga selalu bersama-sama dengan Yesus, orang Nazaret itu.\""
 },
 {
   "id": 24830,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 68,
   "firman": "Tetapi ia menyangkalnya dan berkata: \"Aku tidak tahu dan tidak mengerti apa yang engkau maksud.\" Lalu ia pergi ke serambi muka (dan berkokoklah ayam)."
 },
 {
   "id": 24831,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 69,
   "firman": "Ketika hamba perempuan itu melihat Petrus lagi, berkatalah ia pula kepada orang-orang yang ada di situ: \"Orang ini adalah salah seorang dari mereka.\""
 },
 {
   "id": 24832,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 70,
   "firman": "Tetapi Petrus menyangkalnya pula. Tidak lama kemudian orang-orang yang ada di situ berkata juga kepada Petrus: \"Engkau ini pasti salah seorang dari mereka, apalagi engkau seorang Galilea!\""
 },
 {
   "id": 24833,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 71,
   "firman": "Maka mulailah Petrus mengutuk dan bersumpah: \"Aku tidak kenal orang yang kamu sebut-sebut ini!\""
 },
 {
   "id": 24834,
   "kitab": "Mrk",
   "pasal": 14,
   "ayat": 72,
   "firman": "Dan pada saat itu berkokoklah ayam untuk kedua kalinya. Maka teringatlah Petrus, bahwa Yesus telah berkata kepadanya: \"Sebelum ayam berkokok dua kali, engkau telah menyangkal Aku tiga kali.\" Lalu menangislah ia tersedu-sedu."
 },
 {
   "id": 24835,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 1,
   "firman": "Pagi-pagi benar imam-imam kepala bersama tua-tua dan ahli-ahli Taurat dan seluruh Mahkamah Agama sudah bulat mupakatnya. Mereka membelenggu Yesus lalu membawa-Nya dan menyerahkan-Nya kepada Pilatus."
 },
 {
   "id": 24836,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 2,
   "firman": "Pilatus bertanya kepada-Nya: \"Engkaukah raja orang Yahudi?\" Jawab Yesus: \"Engkau sendiri mengatakannya.\""
 },
 {
   "id": 24837,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 3,
   "firman": "Lalu imam-imam kepala mengajukan banyak tuduhan terhadap Dia."
 },
 {
   "id": 24838,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 4,
   "firman": "Pilatus bertanya pula kepada-Nya, katanya: \"Tidakkah Engkau memberi jawab? Lihatlah betapa banyaknya tuduhan mereka terhadap Engkau!\""
 },
 {
   "id": 24839,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 5,
   "firman": "Tetapi Yesus sama sekali tidak menjawab lagi, sehingga Pilatus merasa heran."
 },
 {
   "id": 24840,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 6,
   "firman": "Telah menjadi kebiasaan untuk membebaskan satu orang hukuman pada tiap-tiap hari raya itu menurut permintaan orang banyak."
 },
 {
   "id": 24841,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 7,
   "firman": "Dan pada waktu itu adalah seorang yang bernama Barabas sedang dipenjarakan bersama beberapa orang pemberontak lainnya. Mereka telah melakukan pembunuhan dalam pemberontakan."
 },
 {
   "id": 24842,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 8,
   "firman": "Maka datanglah orang banyak dan meminta supaya sekarang kebiasaan itu diikuti juga."
 },
 {
   "id": 24843,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 9,
   "firman": "Pilatus menjawab mereka dan bertanya: \"Apakah kamu menghendaki supaya kubebaskan raja orang Yahudi ini?\""
 },
 {
   "id": 24844,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 10,
   "firman": "Ia memang mengetahui, bahwa imam-imam kepala telah menyerahkan Yesus karena dengki."
 },
 {
   "id": 24845,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 11,
   "firman": "Tetapi imam-imam kepala menghasut orang banyak untuk meminta supaya Barabaslah yang dibebaskannya bagi mereka."
 },
 {
   "id": 24846,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 12,
   "firman": "Pilatus sekali lagi menjawab dan bertanya kepada mereka: \"Jika begitu, apakah yang harus kuperbuat dengan orang yang kamu sebut raja orang Yahudi ini?\""
 },
 {
   "id": 24847,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 13,
   "firman": "Maka mereka berteriak lagi, katanya: \"Salibkanlah Dia!\""
 },
 {
   "id": 24848,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 14,
   "firman": "Lalu Pilatus berkata kepada mereka: \"Tetapi kejahatan apakah yang telah dilakukan-Nya?\" Namun mereka makin keras berteriak: \"Salibkanlah Dia!\""
 },
 {
   "id": 24849,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 15,
   "firman": "Dan oleh karena Pilatus ingin memuaskan hati orang banyak itu, ia membebaskan Barabas bagi mereka. Tetapi Yesus disesahnya lalu diserahkannya untuk disalibkan."
 },
 {
   "id": 24850,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 16,
   "firman": "Kemudian serdadu-serdadu membawa Yesus ke dalam istana, yaitu gedung pengadilan, dan memanggil seluruh pasukan berkumpul."
 },
 {
   "id": 24851,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 17,
   "firman": "Mereka mengenakan jubah ungu kepada-Nya, menganyam sebuah mahkota duri dan menaruhnya di atas kepala-Nya."
 },
 {
   "id": 24852,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 18,
   "firman": "Kemudian mereka mulai memberi hormat kepada-Nya, katanya: \"Salam, hai raja orang Yahudi!\""
 },
 {
   "id": 24853,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 19,
   "firman": "Mereka memukul kepala-Nya dengan buluh, dan meludahi-Nya dan berlutut menyembah-Nya."
 },
 {
   "id": 24854,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 20,
   "firman": "Sesudah mengolok-olokkan Dia mereka menanggalkan jubah ungu itu dari pada-Nya dan mengenakan pula pakaian-Nya kepada-Nya."
 },
 {
   "id": 24856,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 21,
   "firman": "Pada waktu itu lewat seorang yang bernama Simon, orang Kirene, ayah Aleksander dan Rufus, yang baru datang dari luar kota, dan orang itu mereka paksa untuk memikul salib Yesus."
 },
 {
   "id": 24857,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 22,
   "firman": "Mereka membawa Yesus ke tempat yang bernama Golgota, yang berarti: Tempat Tengkorak."
 },
 {
   "id": 24858,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 23,
   "firman": "Lalu mereka memberi anggur bercampur mur kepada-Nya, tetapi Ia menolaknya."
 },
 {
   "id": 24859,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 24,
   "firman": "Kemudian mereka menyalibkan Dia, lalu mereka membagi pakaian-Nya dengan membuang undi atasnya untuk menentukan bagian masing-masing."
 },
 {
   "id": 24860,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 25,
   "firman": "Hari jam sembilan ketika Ia disalibkan."
 },
 {
   "id": 24861,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 26,
   "firman": "Dan alasan mengapa Ia dihukum disebut pada tulisan yang terpasang di situ: \"Raja orang Yahudi\"."
 },
 {
   "id": 24862,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 27,
   "firman": "Bersama dengan Dia disalibkan dua orang penyamun, seorang di sebelah kanan-Nya dan seorang di sebelah kiri-Nya."
 },
 {
   "id": 24863,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 28,
   "firman": "(Demikian genaplah nas Alkitab yang berbunyi: \"Ia akan terhitung di antara orang-orang durhaka.\")"
 },
 {
   "id": 24864,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 29,
   "firman": "Orang-orang yang lewat di sana menghujat Dia, dan sambil menggelengkan kepala mereka berkata: \"Hai Engkau yang mau merubuhkan Bait Suci dan mau membangunnya kembali dalam tiga hari,"
 },
 {
   "id": 24865,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 30,
   "firman": "turunlah dari salib itu dan selamatkan diri-Mu!\""
 },
 {
   "id": 24866,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 31,
   "firman": "Demikian juga imam-imam kepala bersama-sama ahli Taurat mengolok-olokkan Dia di antara mereka sendiri dan mereka berkata: \"Orang lain Ia selamatkan, tetapi diri-Nya sendiri tidak dapat Ia selamatkan!"
 },
 {
   "id": 24867,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 32,
   "firman": "Baiklah Mesias, Raja Israel itu, turun dari salib itu, supaya kita lihat dan percaya.\" Bahkan kedua orang yang disalibkan bersama-sama dengan Dia mencela Dia juga."
 },
 {
   "id": 24868,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 33,
   "firman": "Pada jam dua belas, kegelapan meliputi seluruh daerah itu dan berlangsung sampai jam tiga."
 },
 {
   "id": 24869,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 34,
   "firman": "Dan pada jam tiga berserulah Yesus dengan suara nyaring: \"Eloi, Eloi, lama sabakhtani?\", yang berarti: Allahku, Allahku, mengapa Engkau meninggalkan Aku? "
 },
 {
   "id": 24870,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 35,
   "firman": "Mendengar itu, beberapa orang yang berdiri di situ berkata: \"Lihat, Ia memanggil Elia.\""
 },
 {
   "id": 24871,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 36,
   "firman": "Maka datanglah seorang dengan bunga karang, mencelupkannya ke dalam anggur asam lalu mencucukkannya pada sebatang buluh dan memberi Yesus minum serta berkata: \"Baiklah kita tunggu dan melihat apakah Elia datang untuk menurunkan Dia.\""
 },
 {
   "id": 24872,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 37,
   "firman": "Lalu berserulah Yesus dengan suara nyaring dan menyerahkan nyawa-Nya."
 },
 {
   "id": 24873,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 38,
   "firman": "Ketika itu tabir Bait Suci terbelah dua dari atas sampai ke bawah."
 },
 {
   "id": 24874,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 39,
   "firman": "Waktu kepala pasukan yang berdiri berhadapan dengan Dia melihat mati-Nya demikian, berkatalah ia: \"Sungguh, orang ini adalah Anak Allah!\""
 },
 {
   "id": 24875,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 40,
   "firman": "Ada juga beberapa perempuan yang melihat dari jauh, di antaranya Maria Magdalena, Maria ibu Yakobus Muda dan Yoses, serta Salome."
 },
 {
   "id": 24876,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 41,
   "firman": "Mereka semuanya telah mengikut Yesus dan melayani-Nya waktu Ia di Galilea. Dan ada juga di situ banyak perempuan lain yang telah datang ke Yerusalem bersama-sama dengan Yesus."
 },
 {
   "id": 24877,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 42,
   "firman": "Sementara itu hari mulai malam, dan hari itu adalah hari persiapan, yaitu hari menjelang Sabat."
 },
 {
   "id": 24878,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 43,
   "firman": "Karena itu Yusuf, orang Arimatea, seorang anggota Majelis Besar yang terkemuka, yang juga menanti-nantikan Kerajaan Allah, memberanikan diri menghadap Pilatus dan meminta mayat Yesus."
 },
 {
   "id": 24879,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 44,
   "firman": "Pilatus heran waktu mendengar bahwa Yesus sudah mati. Maka ia memanggil kepala pasukan dan bertanya kepadanya apakah Yesus sudah mati."
 },
 {
   "id": 24880,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 45,
   "firman": "Sesudah didengarnya keterangan kepala pasukan, ia berkenan memberikan mayat itu kepada Yusuf."
 },
 {
   "id": 24881,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 46,
   "firman": "Yusufpun membeli kain lenan, kemudian ia menurunkan mayat Yesus dari salib dan mengapaninya dengan kain lenan itu. Lalu ia membaringkan Dia di dalam kubur yang digali di dalam bukit batu. Kemudian digulingkannya sebuah batu ke pintu kubur itu."
 },
 {
   "id": 24882,
   "kitab": "Mrk",
   "pasal": 15,
   "ayat": 47,
   "firman": "Maria Magdalena dan Maria ibu Yoses melihat di mana Yesus dibaringkan."
 },
 {
   "id": 24883,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 1,
   "firman": "Setelah lewat hari Sabat, Maria Magdalena dan Maria ibu Yakobus, serta Salome membeli rempah-rempah untuk pergi ke kubur dan meminyaki Yesus."
 },
 {
   "id": 24884,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 2,
   "firman": "Dan pagi-pagi benar pada hari pertama minggu itu, setelah matahari terbit, pergilah mereka ke kubur."
 },
 {
   "id": 24885,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 3,
   "firman": "Mereka berkata seorang kepada yang lain: \"Siapa yang akan menggulingkan batu itu bagi kita dari pintu kubur?\""
 },
 {
   "id": 24886,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 4,
   "firman": "Tetapi ketika mereka melihat dari dekat, tampaklah, batu yang memang sangat besar itu sudah terguling."
 },
 {
   "id": 24887,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 5,
   "firman": "Lalu mereka masuk ke dalam kubur dan mereka melihat seorang muda yang memakai jubah putih duduk di sebelah kanan. Merekapun sangat terkejut,"
 },
 {
   "id": 24888,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 6,
   "firman": "tetapi orang muda itu berkata kepada mereka: \"Jangan takut! Kamu mencari Yesus orang Nazaret, yang disalibkan itu. Ia telah bangkit. Ia tidak ada di sini. Lihat! Inilah tempat mereka membaringkan Dia."
 },
 {
   "id": 24889,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 7,
   "firman": "Tetapi sekarang pergilah, katakanlah kepada murid-murid-Nya dan kepada Petrus: Ia mendahului kamu ke Galilea; di sana kamu akan melihat Dia, seperti yang sudah dikatakan-Nya kepada kamu.\""
 },
 {
   "id": 24890,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lalu mereka keluar dan lari meninggalkan kubur itu, sebab gentar dan dahsyat menimpa mereka. Mereka tidak mengatakan apa-apa kepada siapapun juga karena takut. Dengan singkat mereka sampaikan semua pesan itu kepada Petrus dan teman-temannya. Sesudah itu Yesus sendiri dengan perantaraan murid-murid-Nya memberitakan dari Timur ke Barat berita yang kudus dan tak terbinasakan tentang keselamatan yang kekal itu."
 },
 {
   "id": 24891,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 9,
   "firman": "Setelah Yesus bangkit pagi-pagi pada hari pertama minggu itu, Ia mula-mula menampakkan diri-Nya kepada Maria Magdalena. Dari padanya Yesus pernah mengusir tujuh setan."
 },
 {
   "id": 24892,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 10,
   "firman": "Lalu perempuan itu pergi memberitahukannya kepada mereka yang selalu mengiringi Yesus, dan yang pada waktu itu sedang berkabung dan menangis."
 },
 {
   "id": 24893,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 11,
   "firman": "Tetapi ketika mereka mendengar, bahwa Yesus hidup dan telah dilihat olehnya, mereka tidak percaya."
 },
 {
   "id": 24894,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 12,
   "firman": "Sesudah itu Ia menampakkan diri dalam rupa yang lain kepada dua orang dari mereka, ketika keduanya dalam perjalanan ke luar kota."
 },
 {
   "id": 24895,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 13,
   "firman": "Lalu kembalilah mereka dan memberitahukannya kepada teman-teman yang lain, tetapi kepada merekapun teman-teman itu tidak percaya."
 },
 {
   "id": 24896,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 14,
   "firman": "Akhirnya Ia menampakkan diri kepada kesebelas orang itu ketika mereka sedang makan, dan Ia mencela ketidakpercayaan dan kedegilan hati mereka, oleh karena mereka tidak percaya kepada orang-orang yang telah melihat Dia sesudah kebangkitan-Nya."
 },
 {
   "id": 24897,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu Ia berkata kepada mereka: \"Pergilah ke seluruh dunia, beritakanlah Injil kepada segala makhluk."
 },
 {
   "id": 24898,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 16,
   "firman": "Siapa yang percaya dan dibaptis akan diselamatkan, tetapi siapa yang tidak percaya akan dihukum."
 },
 {
   "id": 24899,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 17,
   "firman": "Tanda-tanda ini akan menyertai orang-orang yang percaya: mereka akan mengusir setan-setan demi nama-Ku, mereka akan berbicara dalam bahasa-bahasa yang baru bagi mereka,"
 },
 {
   "id": 24900,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 18,
   "firman": "mereka akan memegang ular, dan sekalipun mereka minum racun maut, mereka tidak akan mendapat celaka; mereka akan meletakkan tangannya atas orang sakit, dan orang itu akan sembuh.\""
 },
 {
   "id": 24901,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 19,
   "firman": "Sesudah Tuhan Yesus berbicara demikian kepada mereka, terangkatlah Ia ke sorga, lalu duduk di sebelah kanan Allah."
 },
 {
   "id": 24902,
   "kitab": "Mrk",
   "pasal": 16,
   "ayat": 20,
   "firman": "Merekapun pergilah memberitakan Injil ke segala penjuru, dan Tuhan turut bekerja dan meneguhkan firman itu dengan tanda-tanda yang menyertainya."
 },
 {
   "id": 24903,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 1,
   "firman": "Teofilus yang mulia, Banyak orang telah berusaha menyusun suatu berita tentang peristiwa-peristiwa yang telah terjadi di antara kita,"
 },
 {
   "id": 24904,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 2,
   "firman": "seperti yang disampaikan kepada kita oleh mereka, yang dari semula adalah saksi mata dan pelayan Firman."
 },
 {
   "id": 24905,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 3,
   "firman": "Karena itu, setelah aku menyelidiki segala peristiwa itu dengan seksama dari asal mulanya, aku mengambil keputusan untuk membukukannya dengan teratur bagimu,"
 },
 {
   "id": 24906,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 4,
   "firman": "supaya engkau dapat mengetahui, bahwa segala sesuatu yang diajarkan kepadamu sungguh benar."
 },
 {
   "id": 24907,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 5,
   "firman": "Pada zaman Herodes, raja Yudea, adalah seorang imam yang bernama Zakharia dari rombongan Abia. Isterinya juga berasal dari keturunan Harun, namanya Elisabet."
 },
 {
   "id": 24908,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 6,
   "firman": "Keduanya adalah benar di hadapan Allah dan hidup menurut segala perintah dan ketetapan Tuhan dengan tidak bercacat."
 },
 {
   "id": 24909,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 7,
   "firman": "Tetapi mereka tidak mempunyai anak, sebab Elisabet mandul dan keduanya telah lanjut umurnya."
 },
 {
   "id": 24910,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 8,
   "firman": "Pada suatu kali, waktu tiba giliran rombongannya, Zakharia melakukan tugas keimaman di hadapan Tuhan."
 },
 {
   "id": 24911,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sebab ketika diundi, sebagaimana lazimnya, untuk menentukan imam yang bertugas, dialah yang ditunjuk untuk masuk ke dalam Bait Suci dan membakar ukupan di situ."
 },
 {
   "id": 24912,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 10,
   "firman": "Sementara itu seluruh umat berkumpul di luar dan sembahyang. Waktu itu adalah waktu pembakaran ukupan."
 },
 {
   "id": 24913,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 11,
   "firman": "Maka tampaklah kepada Zakharia seorang malaikat Tuhan berdiri di sebelah kanan mezbah pembakaran ukupan."
 },
 {
   "id": 24914,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 12,
   "firman": "Melihat hal itu ia terkejut dan menjadi takut."
 },
 {
   "id": 24915,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 13,
   "firman": "Tetapi malaikat itu berkata kepadanya: \"Jangan takut, hai Zakharia, sebab doamu telah dikabulkan dan Elisabet, isterimu, akan melahirkan seorang anak laki-laki bagimu dan haruslah engkau menamai dia Yohanes."
 },
 {
   "id": 24916,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 14,
   "firman": "Engkau akan bersukacita dan bergembira, bahkan banyak orang akan bersukacita atas kelahirannya itu."
 },
 {
   "id": 24917,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 15,
   "firman": "Sebab ia akan besar di hadapan Tuhan dan ia tidak akan minum anggur atau minuman keras dan ia akan penuh dengan Roh Kudus mulai dari rahim ibunya;"
 },
 {
   "id": 24918,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 16,
   "firman": "ia akan membuat banyak orang Israel berbalik kepada Tuhan, Allah mereka,"
 },
 {
   "id": 24919,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 17,
   "firman": "dan ia akan berjalan mendahului Tuhan dalam roh dan kuasa Elia untuk membuat hati bapa-bapa berbalik kepada anak-anaknya dan hati orang-orang durhaka kepada pikiran orang-orang benar dan dengan demikian menyiapkan bagi Tuhan suatu umat yang layak bagi-Nya.\""
 },
 {
   "id": 24920,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 18,
   "firman": "Lalu kata Zakharia kepada malaikat itu: \"Bagaimanakah aku tahu, bahwa hal ini akan terjadi? Sebab aku sudah tua dan isteriku sudah lanjut umurnya.\""
 },
 {
   "id": 24921,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 19,
   "firman": "Jawab malaikat itu kepadanya: \"Akulah Gabriel yang melayani Allah dan aku telah diutus untuk berbicara dengan engkau dan untuk menyampaikan kabar baik ini kepadamu."
 },
 {
   "id": 24922,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 20,
   "firman": "Sesungguhnya engkau akan menjadi bisu dan tidak dapat berkata-kata sampai kepada hari, di mana semuanya ini terjadi, karena engkau tidak percaya akan perkataanku yang akan nyata kebenarannya pada waktunya.\""
 },
 {
   "id": 24923,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 21,
   "firman": "Sementara itu orang banyak menanti-nantikan Zakharia. Mereka menjadi heran, bahwa ia begitu lama berada dalam Bait Suci."
 },
 {
   "id": 24924,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 22,
   "firman": "Ketika ia keluar, ia tidak dapat berkata-kata kepada mereka dan mengertilah mereka, bahwa ia telah melihat suatu penglihatan di dalam Bait Suci. Lalu ia memberi isyarat kepada mereka, sebab ia tetap bisu."
 },
 {
   "id": 24925,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 23,
   "firman": "Ketika selesai jangka waktu tugas jabatannya, ia pulang ke rumah."
 },
 {
   "id": 24926,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 24,
   "firman": "Beberapa lama kemudian Elisabet, isterinya, mengandung dan selama lima bulan ia tidak menampakkan diri, katanya:"
 },
 {
   "id": 24927,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 25,
   "firman": "\"Inilah suatu perbuatan Tuhan bagiku, dan sekarang Ia berkenan menghapuskan aibku di depan orang.\""
 },
 {
   "id": 24928,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 26,
   "firman": "Dalam bulan yang keenam Allah menyuruh malaikat Gabriel pergi ke sebuah kota di Galilea bernama Nazaret,"
 },
 {
   "id": 24929,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 27,
   "firman": "kepada seorang perawan yang bertunangan dengan seorang bernama Yusuf dari keluarga Daud; nama perawan itu Maria."
 },
 {
   "id": 24930,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 28,
   "firman": "Ketika malaikat itu masuk ke rumah Maria, ia berkata: \"Salam, hai engkau yang dikaruniai, Tuhan menyertai engkau.\""
 },
 {
   "id": 24931,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 29,
   "firman": "Maria terkejut mendengar perkataan itu, lalu bertanya di dalam hatinya, apakah arti salam itu."
 },
 {
   "id": 24932,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 30,
   "firman": "Kata malaikat itu kepadanya: \"Jangan takut, hai Maria, sebab engkau beroleh kasih karunia di hadapan Allah."
 },
 {
   "id": 24933,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 31,
   "firman": "Sesungguhnya engkau akan mengandung dan akan melahirkan seorang anak laki-laki dan hendaklah engkau menamai Dia Yesus."
 },
 {
   "id": 24934,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 32,
   "firman": "Ia akan menjadi besar dan akan disebut Anak Allah Yang Mahatinggi. Dan Tuhan Allah akan mengaruniakan kepada-Nya takhta Daud, bapa leluhur-Nya,"
 },
 {
   "id": 24935,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 33,
   "firman": "dan Ia akan menjadi raja atas kaum keturunan Yakub sampai selama-lamanya dan Kerajaan-Nya tidak akan berkesudahan.\""
 },
 {
   "id": 24936,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 34,
   "firman": "Kata Maria kepada malaikat itu: \"Bagaimana hal itu mungkin terjadi, karena aku belum bersuami?\""
 },
 {
   "id": 24937,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 35,
   "firman": "Jawab malaikat itu kepadanya: \"Roh Kudus akan turun atasmu dan kuasa Allah Yang Mahatinggi akan menaungi engkau; sebab itu anak yang akan kaulahirkan itu akan disebut kudus, Anak Allah."
 },
 {
   "id": 24938,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 36,
   "firman": "Dan sesungguhnya, Elisabet, sanakmu itu, iapun sedang mengandung seorang anak laki-laki pada hari tuanya dan inilah bulan yang keenam bagi dia, yang disebut mandul itu."
 },
 {
   "id": 24939,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 37,
   "firman": "Sebab bagi Allah tidak ada yang mustahil.\""
 },
 {
   "id": 24940,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 38,
   "firman": "Kata Maria: \"Sesungguhnya aku ini adalah hamba Tuhan; jadilah padaku menurut perkataanmu itu.\" Lalu malaikat itu meninggalkan dia."
 },
 {
   "id": 24941,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 39,
   "firman": "Beberapa waktu kemudian berangkatlah Maria dan langsung berjalan ke pegunungan menuju sebuah kota di Yehuda."
 },
 {
   "id": 24942,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 40,
   "firman": "Di situ ia masuk ke rumah Zakharia dan memberi salam kepada Elisabet."
 },
 {
   "id": 24943,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 41,
   "firman": "Dan ketika Elisabet mendengar salam Maria, melonjaklah anak yang di dalam rahimnya dan Elisabetpun penuh dengan Roh Kudus,"
 },
 {
   "id": 24944,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 42,
   "firman": "lalu berseru dengan suara nyaring: \"Diberkatilah engkau di antara semua perempuan dan diberkatilah buah rahimmu."
 },
 {
   "id": 24945,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 43,
   "firman": "Siapakah aku ini sampai ibu Tuhanku datang mengunjungi aku?"
 },
 {
   "id": 24946,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 44,
   "firman": "Sebab sesungguhnya, ketika salammu sampai kepada telingaku, anak yang di dalam rahimku melonjak kegirangan."
 },
 {
   "id": 24947,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 45,
   "firman": "Dan berbahagialah ia, yang telah percaya, sebab apa yang dikatakan kepadanya dari Tuhan, akan terlaksana.\""
 },
 {
   "id": 24948,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 46,
   "firman": "Lalu kata Maria: \"Jiwaku memuliakan Tuhan,"
 },
 {
   "id": 24949,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 47,
   "firman": "dan hatiku bergembira karena Allah, Juruselamatku,"
 },
 {
   "id": 24950,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 48,
   "firman": "sebab Ia telah memperhatikan kerendahan hamba-Nya. Sesungguhnya, mulai dari sekarang segala keturunan akan menyebut aku berbahagia,"
 },
 {
   "id": 24951,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 49,
   "firman": "karena Yang Mahakuasa telah melakukan perbuatan-perbuatan besar kepadaku dan nama-Nya adalah kudus."
 },
 {
   "id": 24952,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 50,
   "firman": "Dan rahmat-Nya turun-temurun atas orang yang takut akan Dia."
 },
 {
   "id": 24953,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 51,
   "firman": "Ia memperlihatkan kuasa-Nya dengan perbuatan tangan-Nya dan mencerai-beraikan orang-orang yang congkak hatinya;"
 },
 {
   "id": 24954,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 52,
   "firman": "Ia menurunkan orang-orang yang berkuasa dari takhtanya dan meninggikan orang-orang yang rendah;"
 },
 {
   "id": 24955,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 53,
   "firman": "Ia melimpahkan segala yang baik kepada orang yang lapar, dan menyuruh orang yang kaya pergi dengan tangan hampa;"
 },
 {
   "id": 24956,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 54,
   "firman": "Ia menolong Israel, hamba-Nya, karena Ia mengingat rahmat-Nya,"
 },
 {
   "id": 24957,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 55,
   "firman": "seperti yang dijanjikan-Nya kepada nenek moyang kita, kepada Abraham dan keturunannya untuk selama-lamanya.\""
 },
 {
   "id": 24958,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 56,
   "firman": "Dan Maria tinggal kira-kira tiga bulan lamanya bersama dengan Elisabet, lalu pulang kembali ke rumahnya."
 },
 {
   "id": 24959,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 57,
   "firman": "Kemudian genaplah bulannya bagi Elisabet untuk bersalin dan iapun melahirkan seorang anak laki-laki."
 },
 {
   "id": 24960,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 58,
   "firman": "Ketika tetangga-tetangganya serta sanak saudaranya mendengar, bahwa Tuhan telah menunjukkan rahmat-Nya yang begitu besar kepadanya, bersukacitalah mereka bersama-sama dengan dia."
 },
 {
   "id": 24961,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 59,
   "firman": "Maka datanglah mereka pada hari yang kedelapan untuk menyunatkan anak itu dan mereka hendak menamai dia Zakharia menurut nama bapanya,"
 },
 {
   "id": 24962,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 60,
   "firman": "tetapi ibunya berkata: \"Jangan, ia harus dinamai Yohanes.\""
 },
 {
   "id": 24963,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 61,
   "firman": "Kata mereka kepadanya: \"Tidak ada di antara sanak saudaramu yang bernama demikian.\""
 },
 {
   "id": 24964,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 62,
   "firman": "Lalu mereka memberi isyarat kepada bapanya untuk bertanya nama apa yang hendak diberikannya kepada anaknya itu."
 },
 {
   "id": 24965,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 63,
   "firman": "Ia meminta batu tulis, lalu menuliskan kata-kata ini: \"Namanya adalah Yohanes.\" Dan merekapun heran semuanya."
 },
 {
   "id": 24966,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 64,
   "firman": "Dan seketika itu juga terbukalah mulutnya dan terlepaslah lidahnya, lalu ia berkata-kata dan memuji Allah."
 },
 {
   "id": 24967,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 65,
   "firman": "Maka ketakutanlah semua orang yang tinggal di sekitarnya, dan segala peristiwa itu menjadi buah tutur di seluruh pegunungan Yudea."
 },
 {
   "id": 24968,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 66,
   "firman": "Dan semua orang, yang mendengarnya, merenungkannya dan berkata: \"Menjadi apakah anak ini nanti?\" Sebab tangan Tuhan menyertai dia."
 },
 {
   "id": 24969,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 67,
   "firman": "Dan Zakharia, ayahnya, penuh dengan Roh Kudus, lalu bernubuat, katanya:"
 },
 {
   "id": 24970,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 68,
   "firman": "\"Terpujilah Tuhan, Allah Israel, sebab Ia melawat umat-Nya dan membawa kelepasan baginya,"
 },
 {
   "id": 24971,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 69,
   "firman": "Ia menumbuhkan sebuah tanduk keselamatan bagi kita di dalam keturunan Daud, hamba-Nya itu,"
 },
 {
   "id": 24972,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 70,
   "firman": "--seperti yang telah difirmankan-Nya sejak purbakala oleh mulut nabi-nabi-Nya yang kudus--"
 },
 {
   "id": 24973,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 71,
   "firman": "untuk melepaskan kita dari musuh-musuh kita dan dari tangan semua orang yang membenci kita,"
 },
 {
   "id": 24974,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 72,
   "firman": "untuk menunjukkan rahmat-Nya kepada nenek moyang kita dan mengingat akan perjanjian-Nya yang kudus,"
 },
 {
   "id": 24975,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 73,
   "firman": "yaitu sumpah yang diucapkan-Nya kepada Abraham, bapa leluhur kita, bahwa Ia mengaruniai kita,"
 },
 {
   "id": 24976,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 74,
   "firman": "supaya kita, terlepas dari tangan musuh, dapat beribadah kepada-Nya tanpa takut,"
 },
 {
   "id": 24977,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 75,
   "firman": "dalam kekudusan dan kebenaran di hadapan-Nya seumur hidup kita."
 },
 {
   "id": 24978,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 76,
   "firman": "Dan engkau, hai anakku, akan disebut nabi Allah Yang Mahatinggi; karena engkau akan berjalan mendahului Tuhan untuk mempersiapkan jalan bagi-Nya,"
 },
 {
   "id": 24979,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 77,
   "firman": "untuk memberikan kepada umat-Nya pengertian akan keselamatan yang berdasarkan pengampunan dosa-dosa mereka,"
 },
 {
   "id": 24980,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 78,
   "firman": "oleh rahmat dan belas kasihan dari Allah kita, dengan mana Ia akan melawat kita, Surya pagi dari tempat yang tinggi,"
 },
 {
   "id": 24981,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 79,
   "firman": "untuk menyinari mereka yang diam dalam kegelapan dan dalam naungan maut untuk mengarahkan kaki kita kepada jalan damai sejahtera.\""
 },
 {
   "id": 24982,
   "kitab": "Luk",
   "pasal": 1,
   "ayat": 80,
   "firman": "Adapun anak itu bertambah besar dan makin kuat rohnya. Dan ia tinggal di padang gurun sampai kepada hari ia harus menampakkan diri kepada Israel."
 },
 {
   "id": 24983,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pada waktu itu Kaisar Agustus mengeluarkan suatu perintah, menyuruh mendaftarkan semua orang di seluruh dunia."
 },
 {
   "id": 24984,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 2,
   "firman": "Inilah pendaftaran yang pertama kali diadakan sewaktu Kirenius menjadi wali negeri di Siria."
 },
 {
   "id": 24985,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 3,
   "firman": "Maka pergilah semua orang mendaftarkan diri, masing-masing di kotanya sendiri."
 },
 {
   "id": 24986,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 4,
   "firman": "Demikian juga Yusuf pergi dari kota Nazaret di Galilea ke Yudea, ke kota Daud yang bernama Betlehem, --karena ia berasal dari keluarga dan keturunan Daud--"
 },
 {
   "id": 24987,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 5,
   "firman": "supaya didaftarkan bersama-sama dengan Maria, tunangannya, yang sedang mengandung."
 },
 {
   "id": 24988,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ketika mereka di situ tibalah waktunya bagi Maria untuk bersalin,"
 },
 {
   "id": 24989,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 7,
   "firman": "dan ia melahirkan seorang anak laki-laki, anaknya yang sulung, lalu dibungkusnya dengan lampin dan dibaringkannya di dalam palungan, karena tidak ada tempat bagi mereka di rumah penginapan."
 },
 {
   "id": 24990,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 8,
   "firman": "Di daerah itu ada gembala-gembala yang tinggal di padang menjaga kawanan ternak mereka pada waktu malam."
 },
 {
   "id": 24991,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tiba-tiba berdirilah seorang malaikat Tuhan di dekat mereka dan kemuliaan Tuhan bersinar meliputi mereka dan mereka sangat ketakutan."
 },
 {
   "id": 24992,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 10,
   "firman": "Lalu kata malaikat itu kepada mereka: \"Jangan takut, sebab sesungguhnya aku memberitakan kepadamu kesukaan besar untuk seluruh bangsa:"
 },
 {
   "id": 24993,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 11,
   "firman": "Hari ini telah lahir bagimu Juruselamat, yaitu Kristus, Tuhan, di kota Daud."
 },
 {
   "id": 24994,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan inilah tandanya bagimu: Kamu akan menjumpai seorang bayi dibungkus dengan lampin dan terbaring di dalam palungan.\""
 },
 {
   "id": 24995,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan tiba-tiba tampaklah bersama-sama dengan malaikat itu sejumlah besar bala tentara sorga yang memuji Allah, katanya:"
 },
 {
   "id": 24996,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 14,
   "firman": "\"Kemuliaan bagi Allah di tempat yang mahatinggi dan damai sejahtera di bumi di antara manusia yang berkenan kepada-Nya.\""
 },
 {
   "id": 24997,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 15,
   "firman": "Setelah malaikat-malaikat itu meninggalkan mereka dan kembali ke sorga, gembala-gembala itu berkata seorang kepada yang lain: \"Marilah kita pergi ke Betlehem untuk melihat apa yang terjadi di sana, seperti yang diberitahukan Tuhan kepada kita.\""
 },
 {
   "id": 24998,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 16,
   "firman": "Lalu mereka cepat-cepat berangkat dan menjumpai Maria dan Yusuf dan bayi itu, yang sedang berbaring di dalam palungan."
 },
 {
   "id": 24999,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 17,
   "firman": "Dan ketika mereka melihat-Nya, mereka memberitahukan apa yang telah dikatakan kepada mereka tentang Anak itu."
 },
 {
   "id": 25000,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 18,
   "firman": "Dan semua orang yang mendengarnya heran tentang apa yang dikatakan gembala-gembala itu kepada mereka."
 },
 {
   "id": 25001,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 19,
   "firman": "Tetapi Maria menyimpan segala perkara itu di dalam hatinya dan merenungkannya."
 },
 {
   "id": 25002,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 20,
   "firman": "Maka kembalilah gembala-gembala itu sambil memuji dan memuliakan Allah karena segala sesuatu yang mereka dengar dan mereka lihat, semuanya sesuai dengan apa yang telah dikatakan kepada mereka."
 },
 {
   "id": 25003,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 21,
   "firman": "Dan ketika genap delapan hari dan Ia harus disunatkan, Ia diberi nama Yesus, yaitu nama yang disebut oleh malaikat sebelum Ia dikandung ibu-Nya."
 },
 {
   "id": 25004,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 22,
   "firman": "Dan ketika genap waktu pentahiran, menurut hukum Taurat Musa, mereka membawa Dia ke Yerusalem untuk menyerahkan-Nya kepada Tuhan,"
 },
 {
   "id": 25005,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 23,
   "firman": "seperti ada tertulis dalam hukum Tuhan: \"Semua anak laki-laki sulung harus dikuduskan bagi Allah\","
 },
 {
   "id": 25006,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 24,
   "firman": "dan untuk mempersembahkan korban menurut apa yang difirmankan dalam hukum Tuhan, yaitu sepasang burung tekukur atau dua ekor anak burung merpati."
 },
 {
   "id": 25007,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 25,
   "firman": "Adalah di Yerusalem seorang bernama Simeon. Ia seorang yang benar dan saleh yang menantikan penghiburan bagi Israel. Roh Kudus ada di atasnya,"
 },
 {
   "id": 25008,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 26,
   "firman": "dan kepadanya telah dinyatakan oleh Roh Kudus, bahwa ia tidak akan mati sebelum ia melihat Mesias, yaitu Dia yang diurapi Tuhan."
 },
 {
   "id": 25009,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 27,
   "firman": "Ia datang ke Bait Allah oleh Roh Kudus. Ketika Yesus, Anak itu, dibawa masuk oleh orang tua-Nya untuk melakukan kepada-Nya apa yang ditentukan hukum Taurat,"
 },
 {
   "id": 25010,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 28,
   "firman": "ia menyambut Anak itu dan menatang-Nya sambil memuji Allah, katanya:"
 },
 {
   "id": 25011,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 29,
   "firman": "\"Sekarang, Tuhan, biarkanlah hamba-Mu ini pergi dalam damai sejahtera, sesuai dengan firman-Mu,"
 },
 {
   "id": 25012,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 30,
   "firman": "sebab mataku telah melihat keselamatan yang dari pada-Mu,"
 },
 {
   "id": 25013,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 31,
   "firman": "yang telah Engkau sediakan di hadapan segala bangsa,"
 },
 {
   "id": 25014,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 32,
   "firman": "yaitu terang yang menjadi penyataan bagi bangsa-bangsa lain dan menjadi kemuliaan bagi umat-Mu, Israel.\""
 },
 {
   "id": 25015,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 33,
   "firman": "Dan bapa serta ibu-Nya amat heran akan segala apa yang dikatakan tentang Dia."
 },
 {
   "id": 25016,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 34,
   "firman": "Lalu Simeon memberkati mereka dan berkata kepada Maria, ibu Anak itu: \"Sesungguhnya Anak ini ditentukan untuk menjatuhkan atau membangkitkan banyak orang di Israel dan untuk menjadi suatu tanda yang menimbulkan perbantahan"
 },
 {
   "id": 25017,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 35,
   "firman": "--dan suatu pedang akan menembus jiwamu sendiri--,supaya menjadi nyata pikiran hati banyak orang.\""
 },
 {
   "id": 25018,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 36,
   "firman": "Lagipula di situ ada Hana, seorang nabi perempuan, anak Fanuel dari suku Asyer. Ia sudah sangat lanjut umurnya. Sesudah kawin ia hidup tujuh tahun lamanya bersama suaminya,"
 },
 {
   "id": 25019,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 37,
   "firman": "dan sekarang ia janda dan berumur delapan puluh empat tahun. Ia tidak pernah meninggalkan Bait Allah dan siang malam beribadah dengan berpuasa dan berdoa."
 },
 {
   "id": 25020,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 38,
   "firman": "Dan pada ketika itu juga datanglah ia ke situ dan mengucap syukur kepada Allah dan berbicara tentang Anak itu kepada semua orang yang menantikan kelepasan untuk Yerusalem."
 },
 {
   "id": 25021,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 39,
   "firman": "Dan setelah selesai semua yang harus dilakukan menurut hukum Tuhan, kembalilah mereka ke kota kediamannya, yaitu kota Nazaret di Galilea."
 },
 {
   "id": 25022,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 40,
   "firman": "Anak itu bertambah besar dan menjadi kuat, penuh hikmat, dan kasih karunia Allah ada pada-Nya."
 },
 {
   "id": 25023,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 41,
   "firman": "Tiap-tiap tahun orang tua Yesus pergi ke Yerusalem pada hari raya Paskah."
 },
 {
   "id": 25024,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 42,
   "firman": "Ketika Yesus telah berumur dua belas tahun pergilah mereka ke Yerusalem seperti yang lazim pada hari raya itu."
 },
 {
   "id": 25025,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 43,
   "firman": "Sehabis hari-hari perayaan itu, ketika mereka berjalan pulang, tinggallah Yesus di Yerusalem tanpa diketahui orang tua-Nya."
 },
 {
   "id": 25026,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 44,
   "firman": "Karena mereka menyangka bahwa Ia ada di antara orang-orang seperjalanan mereka, berjalanlah mereka sehari perjalanan jauhnya, lalu mencari Dia di antara kaum keluarga dan kenalan mereka."
 },
 {
   "id": 25027,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 45,
   "firman": "Karena mereka tidak menemukan Dia, kembalilah mereka ke Yerusalem sambil terus mencari Dia."
 },
 {
   "id": 25028,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 46,
   "firman": "Sesudah tiga hari mereka menemukan Dia dalam Bait Allah; Ia sedang duduk di tengah-tengah alim ulama, sambil mendengarkan mereka dan mengajukan pertanyaan-pertanyaan kepada mereka."
 },
 {
   "id": 25029,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 47,
   "firman": "Dan semua orang yang mendengar Dia sangat heran akan kecerdasan-Nya dan segala jawab yang diberikan-Nya."
 },
 {
   "id": 25030,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 48,
   "firman": "Dan ketika orang tua-Nya melihat Dia, tercenganglah mereka, lalu kata ibu-Nya kepada-Nya: \"Nak, mengapakah Engkau berbuat demikian terhadap kami? Bapa-Mu dan aku dengan cemas mencari Engkau.\""
 },
 {
   "id": 25031,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 49,
   "firman": "Jawab-Nya kepada mereka: \"Mengapa kamu mencari Aku? Tidakkah kamu tahu, bahwa Aku harus berada di dalam rumah Bapa-Ku?\""
 },
 {
   "id": 25032,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 50,
   "firman": "Tetapi mereka tidak mengerti apa yang dikatakan-Nya kepada mereka."
 },
 {
   "id": 25033,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 51,
   "firman": "Lalu Ia pulang bersama-sama mereka ke Nazaret; dan Ia tetap hidup dalam asuhan mereka. Dan ibu-Nya menyimpan semua perkara itu di dalam hatinya."
 },
 {
   "id": 25034,
   "kitab": "Luk",
   "pasal": 2,
   "ayat": 52,
   "firman": "Dan Yesus makin bertambah besar dan bertambah hikmat-Nya dan besar-Nya, dan makin dikasihi oleh Allah dan manusia."
 },
 {
   "id": 25035,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 1,
   "firman": "Dalam tahun kelima belas dari pemerintahan Kaisar Tiberius, ketika Pontius Pilatus menjadi wali negeri Yudea, dan Herodes raja wilayah Galilea, Filipus, saudaranya, raja wilayah Iturea dan Trakhonitis, dan Lisanias raja wilayah Abilene,"
 },
 {
   "id": 25036,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 2,
   "firman": "pada waktu Hanas dan Kayafas menjadi Imam Besar, datanglah firman Allah kepada Yohanes, anak Zakharia, di padang gurun."
 },
 {
   "id": 25037,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 3,
   "firman": "Maka datanglah Yohanes ke seluruh daerah Yordan dan menyerukan: \"Bertobatlah dan berilah dirimu dibaptis dan Allah akan mengampuni dosamu,"
 },
 {
   "id": 25038,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 4,
   "firman": "seperti ada tertulis dalam kitab nubuat-nubuat Yesaya: Ada suara yang berseru-seru di padang gurun: Persiapkanlah jalan untuk Tuhan, luruskanlah jalan bagi-Nya."
 },
 {
   "id": 25039,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 5,
   "firman": "Setiap lembah akan ditimbun dan setiap gunung dan bukit akan menjadi rata, yang berliku-liku akan diluruskan, yang berlekuk-lekuk akan diratakan,"
 },
 {
   "id": 25040,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 6,
   "firman": "dan semua orang akan melihat keselamatan yang dari Tuhan.\""
 },
 {
   "id": 25041,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 7,
   "firman": "Lalu ia berkata kepada orang banyak yang datang kepadanya untuk dibaptis, katanya: \"Hai kamu keturunan ular beludak! Siapakah yang mengatakan kepada kamu melarikan diri dari murka yang akan datang?"
 },
 {
   "id": 25042,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 8,
   "firman": "Jadi hasilkanlah buah-buah yang sesuai dengan pertobatan. Dan janganlah berpikir dalam hatimu: Abraham adalah bapa kami! Karena aku berkata kepadamu: Allah dapat menjadikan anak-anak bagi Abraham dari batu-batu ini!"
 },
 {
   "id": 25043,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 9,
   "firman": "Kapak sudah tersedia pada akar pohon dan setiap pohon yang tidak menghasilkan buah yang baik, akan ditebang dan dibuang ke dalam api.\""
 },
 {
   "id": 25044,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 10,
   "firman": "Orang banyak bertanya kepadanya: \"Jika demikian, apakah yang harus kami perbuat?\""
 },
 {
   "id": 25045,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 11,
   "firman": "Jawabnya: \"Barangsiapa mempunyai dua helai baju, hendaklah ia membaginya dengan yang tidak punya, dan barangsiapa mempunyai makanan, hendaklah ia berbuat juga demikian.\""
 },
 {
   "id": 25046,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 12,
   "firman": "Ada datang juga pemungut-pemungut cukai untuk dibaptis dan mereka bertanya kepadanya: \"Guru, apakah yang harus kami perbuat?\""
 },
 {
   "id": 25047,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 13,
   "firman": "Jawabnya: \"Jangan menagih lebih banyak dari pada yang telah ditentukan bagimu.\""
 },
 {
   "id": 25048,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan prajurit-prajurit bertanya juga kepadanya: \"Dan kami, apakah yang harus kami perbuat?\" Jawab Yohanes kepada mereka: \"Jangan merampas dan jangan memeras dan cukupkanlah dirimu dengan gajimu.\""
 },
 {
   "id": 25049,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 15,
   "firman": "Tetapi karena orang banyak sedang menanti dan berharap, dan semuanya bertanya dalam hatinya tentang Yohanes, kalau-kalau ia adalah Mesias,"
 },
 {
   "id": 25050,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 16,
   "firman": "Yohanes menjawab dan berkata kepada semua orang itu: \"Aku membaptis kamu dengan air, tetapi Ia yang lebih berkuasa dari padaku akan datang dan membuka tali kasut-Nyapun aku tidak layak. Ia akan membaptis kamu dengan Roh Kudus dan dengan api."
 },
 {
   "id": 25051,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 17,
   "firman": "Alat penampi sudah di tangan-Nya untuk membersihkan tempat pengirikan-Nya dan untuk mengumpulkan gandum-Nya ke dalam lumbung-Nya, tetapi debu jerami itu akan dibakar-Nya dalam api yang tidak terpadamkan.\""
 },
 {
   "id": 25052,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dengan banyak nasihat lain Yohanes memberitakan Injil kepada orang banyak."
 },
 {
   "id": 25053,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 19,
   "firman": "Akan tetapi setelah ia menegor raja wilayah Herodes karena peristiwa Herodias, isteri saudaranya, dan karena segala kejahatan lain yang dilakukannya,"
 },
 {
   "id": 25054,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 20,
   "firman": "raja itu menambah kejahatannya dengan memasukkan Yohanes ke dalam penjara."
 },
 {
   "id": 25055,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 21,
   "firman": "Ketika seluruh orang banyak itu telah dibaptis dan ketika Yesus juga dibaptis dan sedang berdoa, terbukalah langit"
 },
 {
   "id": 25056,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 22,
   "firman": "dan turunlah Roh Kudus dalam rupa burung merpati ke atas-Nya. Dan terdengarlah suara dari langit: \"Engkaulah Anak-Ku yang Kukasihi, kepada-Mulah Aku berkenan.\""
 },
 {
   "id": 25057,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 23,
   "firman": "Ketika Yesus memulai pekerjaan-Nya, Ia berumur kira-kira tiga puluh tahun dan menurut anggapan orang, Ia adalah anak Yusuf, anak Eli,"
 },
 {
   "id": 25058,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 24,
   "firman": "anak Matat, anak Lewi, anak Malkhi, anak Yanai, anak Yusuf,"
 },
 {
   "id": 25059,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 25,
   "firman": "anak Matica, anak Amos, anak Nahum, anak Hesli, anak Nagai,"
 },
 {
   "id": 25060,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 26,
   "firman": "anak Maat, anak Matica, anak Simei, anak Yosekh, anak Yoda,"
 },
 {
   "id": 25061,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 27,
   "firman": "anak Yohanan, anak Resa, anak Zerubabel, anak Sealtiel, anak Neri,"
 },
 {
   "id": 25062,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 28,
   "firman": "anak Malkhi, anak Adi, anak Kosam, anak Elmadam, anak Er,"
 },
 {
   "id": 25063,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 29,
   "firman": "anak Yesua, anak Eliezer, anak Yorim, anak Matat, anak Lewi,"
 },
 {
   "id": 25064,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 30,
   "firman": "anak Simeon, anak Yehuda, anak Yusuf, anak Yonam, anak Elyakim,"
 },
 {
   "id": 25065,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 31,
   "firman": "anak Melea, anak Mina, anak Matata, anak Natan, anak Daud,"
 },
 {
   "id": 25066,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 32,
   "firman": "anak Isai, anak Obed, anak Boas, anak Salmon, anak Nahason,"
 },
 {
   "id": 25067,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 33,
   "firman": "anak Aminadab, anak Admin, anak Arni, anak Hezron, anak Peres, anak Yehuda,"
 },
 {
   "id": 25068,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 34,
   "firman": "anak Yakub, anak Ishak, anak Abraham, anak Terah, anak Nahor,"
 },
 {
   "id": 25069,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 35,
   "firman": "anak Serug, anak Rehu, anak Peleg, anak Eber, anak Salmon,"
 },
 {
   "id": 25070,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 36,
   "firman": "anak Kenan, anak Arpakhsad, anak Sem, anak Nuh, anak Lamekh,"
 },
 {
   "id": 25071,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 37,
   "firman": "anak Metusalah, anak Henokh, anak Yared, anak Mahalaleel, anak Kenan,"
 },
 {
   "id": 25072,
   "kitab": "Luk",
   "pasal": 3,
   "ayat": 38,
   "firman": "anak Enos, anak Set, anak Adam, anak Allah."
 },
 {
   "id": 25073,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 1,
   "firman": "Yesus, yang penuh dengan Roh Kudus, kembali dari sungai Yordan, lalu dibawa oleh Roh Kudus ke padang gurun."
 },
 {
   "id": 25074,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 2,
   "firman": "Di situ Ia tinggal empat puluh hari lamanya dan dicobai Iblis. Selama di situ Ia tidak makan apa-apa dan sesudah waktu itu Ia lapar."
 },
 {
   "id": 25075,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 3,
   "firman": "Lalu berkatalah Iblis kepada-Nya: \"Jika Engkau Anak Allah, suruhlah batu ini menjadi roti.\""
 },
 {
   "id": 25076,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 4,
   "firman": "Jawab Yesus kepadanya: \"Ada tertulis: Manusia hidup bukan dari roti saja.\""
 },
 {
   "id": 25077,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 5,
   "firman": "Kemudian ia membawa Yesus ke suatu tempat yang tinggi dan dalam sekejap mata ia memperlihatkan kepada-Nya semua kerajaan dunia."
 },
 {
   "id": 25078,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 6,
   "firman": "Kata Iblis kepada-Nya: \"Segala kuasa itu serta kemuliaannya akan kuberikan kepada-Mu, sebab semuanya itu telah diserahkan kepadaku dan aku memberikannya kepada siapa saja yang kukehendaki."
 },
 {
   "id": 25079,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 7,
   "firman": "Jadi jikalau Engkau menyembah aku, seluruhnya itu akan menjadi milik-Mu.\""
 },
 {
   "id": 25080,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 8,
   "firman": "Tetapi Yesus berkata kepadanya: \"Ada tertulis: Engkau harus menyembah Tuhan, Allahmu, dan hanya kepada Dia sajalah engkau berbakti!\""
 },
 {
   "id": 25081,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 9,
   "firman": "Kemudian ia membawa Yesus ke Yerusalem dan menempatkan Dia di bubungan Bait Allah, lalu berkata kepada-Nya: \"Jika Engkau Anak Allah, jatuhkanlah diri-Mu dari sini ke bawah,"
 },
 {
   "id": 25082,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 10,
   "firman": "sebab ada tertulis: Mengenai Engkau, Ia akan memerintahkan malaikat-malaikat-Nya untuk melindungi Engkau,"
 },
 {
   "id": 25083,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 11,
   "firman": "dan mereka akan menatang Engkau di atas tangannya, supaya kaki-Mu jangan terantuk kepada batu.\""
 },
 {
   "id": 25084,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 12,
   "firman": "Yesus menjawabnya, kata-Nya: \"Ada firman: Jangan engkau mencobai Tuhan, Allahmu!\""
 },
 {
   "id": 25085,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sesudah Iblis mengakhiri semua pencobaan itu, ia mundur dari pada-Nya dan menunggu waktu yang baik."
 },
 {
   "id": 25086,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 14,
   "firman": "Dalam kuasa Roh kembalilah Yesus ke Galilea. Dan tersiarlah kabar tentang Dia di seluruh daerah itu."
 },
 {
   "id": 25087,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sementara itu Ia mengajar di rumah-rumah ibadat di situ dan semua orang memuji Dia."
 },
 {
   "id": 25088,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 16,
   "firman": "Ia datang ke Nazaret tempat Ia dibesarkan, dan menurut kebiasaan-Nya pada hari Sabat Ia masuk ke rumah ibadat, lalu berdiri hendak membaca dari Alkitab."
 },
 {
   "id": 25089,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 17,
   "firman": "Kepada-Nya diberikan kitab nabi Yesaya dan setelah dibuka-Nya, Ia menemukan nas, di mana ada tertulis:"
 },
 {
   "id": 25090,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 18,
   "firman": "\"Roh Tuhan ada pada-Ku, oleh sebab Ia telah mengurapi Aku, untuk menyampaikan kabar baik kepada orang-orang miskin; dan Ia telah mengutus Aku"
 },
 {
   "id": 25091,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 19,
   "firman": "untuk memberitakan pembebasan kepada orang-orang tawanan, dan penglihatan bagi orang-orang buta, untuk membebaskan orang-orang yang tertindas, untuk memberitakan tahun rahmat Tuhan telah datang.\""
 },
 {
   "id": 25092,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 20,
   "firman": "Kemudian Ia menutup kitab itu, memberikannya kembali kepada pejabat, lalu duduk; dan mata semua orang dalam rumah ibadat itu tertuju kepada-Nya."
 },
 {
   "id": 25093,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 21,
   "firman": "Lalu Ia memulai mengajar mereka, kata-Nya: \"Pada hari ini genaplah nas ini sewaktu kamu mendengarnya.\""
 },
 {
   "id": 25094,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 22,
   "firman": "Dan semua orang itu membenarkan Dia dan mereka heran akan kata-kata yang indah yang diucapkan-Nya, lalu kata mereka: \"Bukankah Ia ini anak Yusuf?\""
 },
 {
   "id": 25095,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 23,
   "firman": "Maka berkatalah Ia kepada mereka: \"Tentu kamu akan mengatakan pepatah ini kepada-Ku: Hai tabib, sembuhkanlah diri-Mu sendiri. Perbuatlah di sini juga, di tempat asal-Mu ini, segala yang kami dengar yang telah terjadi di Kapernaum!\""
 },
 {
   "id": 25096,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 24,
   "firman": "Dan kata-Nya lagi: \"Aku berkata kepadamu, sesungguhnya tidak ada nabi yang dihargai di tempat asalnya."
 },
 {
   "id": 25097,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 25,
   "firman": "Dan Aku berkata kepadamu, dan kata-Ku ini benar: Pada zaman Elia terdapat banyak perempuan janda di Israel ketika langit tertutup selama tiga tahun dan enam bulan dan ketika bahaya kelaparan yang hebat menimpa seluruh negeri."
 },
 {
   "id": 25098,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 26,
   "firman": "Tetapi Elia diutus bukan kepada salah seorang dari mereka, melainkan kepada seorang perempuan janda di Sarfat, di tanah Sidon."
 },
 {
   "id": 25099,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 27,
   "firman": "Dan pada zaman nabi Elisa banyak orang kusta di Israel dan tidak ada seorangpun dari mereka yang ditahirkan, selain dari pada Naaman, orang Siria itu.\""
 },
 {
   "id": 25100,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 28,
   "firman": "Mendengar itu sangat marahlah semua orang yang di rumah ibadat itu."
 },
 {
   "id": 25101,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 29,
   "firman": "Mereka bangun, lalu menghalau Yesus ke luar kota dan membawa Dia ke tebing gunung, tempat kota itu terletak, untuk melemparkan Dia dari tebing itu."
 },
 {
   "id": 25102,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 30,
   "firman": "Tetapi Ia berjalan lewat dari tengah-tengah mereka, lalu pergi."
 },
 {
   "id": 25103,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 31,
   "firman": "Kemudian Yesus pergi ke Kapernaum, sebuah kota di Galilea, lalu mengajar di situ pada hari-hari Sabat."
 },
 {
   "id": 25104,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 32,
   "firman": "Mereka takjub mendengar pengajaran-Nya, sebab perkataan-Nya penuh kuasa."
 },
 {
   "id": 25105,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 33,
   "firman": "Di dalam rumah ibadat itu ada seorang yang kerasukan setan dan ia berteriak dengan suara keras:"
 },
 {
   "id": 25106,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 34,
   "firman": "\"Hai Engkau, Yesus orang Nazaret, apa urusan-Mu dengan kami? Engkau datang hendak membinasakan kami? Aku tahu siapa Engkau: Yang Kudus dari Allah.\""
 },
 {
   "id": 25107,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 35,
   "firman": "Tetapi Yesus menghardiknya, kata-Nya: \"Diam, keluarlah dari padanya!\" Dan setan itupun menghempaskan orang itu ke tengah-tengah orang banyak, lalu keluar dari padanya dan sama sekali tidak menyakitinya."
 },
 {
   "id": 25108,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 36,
   "firman": "Dan semua orang takjub, lalu berkata seorang kepada yang lain, katanya: \"Alangkah hebatnya perkataan ini! Sebab dengan penuh wibawa dan kuasa Ia memberi perintah kepada roh-roh jahat dan merekapun keluar.\""
 },
 {
   "id": 25109,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 37,
   "firman": "Dan tersebarlah berita tentang Dia ke mana-mana di daerah itu."
 },
 {
   "id": 25110,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 38,
   "firman": "Kemudian Ia meninggalkan rumah ibadat itu dan pergi ke rumah Simon. Adapun ibu mertua Simon demam keras dan mereka meminta kepada Yesus supaya menolong dia."
 },
 {
   "id": 25111,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 39,
   "firman": "Maka Ia berdiri di sisi perempuan itu, lalu menghardik demam itu, dan penyakit itupun meninggalkan dia. Perempuan itu segera bangun dan melayani mereka."
 },
 {
   "id": 25112,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 40,
   "firman": "Ketika matahari terbenam, semua orang membawa kepada-Nya orang-orang sakitnya, yang menderita bermacam-macam penyakit. Iapun meletakkan tangan-Nya atas mereka masing-masing dan menyembuhkan mereka."
 },
 {
   "id": 25113,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 41,
   "firman": "Dari banyak orang keluar juga setan-setan sambil berteriak: \"Engkau adalah Anak Allah.\" Lalu Ia dengan keras melarang mereka dan tidak memperbolehkan mereka berbicara, karena mereka tahu bahwa Ia adalah Mesias."
 },
 {
   "id": 25114,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 42,
   "firman": "Ketika hari siang, Yesus berangkat dan pergi ke suatu tempat yang sunyi. Tetapi orang banyak mencari Dia, lalu menemukan-Nya dan berusaha menahan Dia supaya jangan meninggalkan mereka."
 },
 {
   "id": 25115,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 43,
   "firman": "Tetapi Ia berkata kepada mereka: \"Juga di kota-kota lain Aku harus memberitakan Injil Kerajaan Allah sebab untuk itulah Aku diutus.\""
 },
 {
   "id": 25116,
   "kitab": "Luk",
   "pasal": 4,
   "ayat": 44,
   "firman": "Dan Ia memberitakan Injil dalam rumah-rumah ibadat di Yudea."
 },
 {
   "id": 25117,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 1,
   "firman": "Pada suatu kali Yesus berdiri di pantai danau Genesaret, sedang orang banyak mengerumuni Dia hendak mendengarkan firman Allah."
 },
 {
   "id": 25118,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 2,
   "firman": "Ia melihat dua perahu di tepi pantai. Nelayan-nelayannya telah turun dan sedang membasuh jalanya."
 },
 {
   "id": 25119,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 3,
   "firman": "Ia naik ke dalam salah satu perahu itu, yaitu perahu Simon, dan menyuruh dia supaya menolakkan perahunya sedikit jauh dari pantai. Lalu Ia duduk dan mengajar orang banyak dari atas perahu."
 },
 {
   "id": 25120,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 4,
   "firman": "Setelah selesai berbicara, Ia berkata kepada Simon: \"Bertolaklah ke tempat yang dalam dan tebarkanlah jalamu untuk menangkap ikan.\""
 },
 {
   "id": 25121,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 5,
   "firman": "Simon menjawab: \"Guru, telah sepanjang malam kami bekerja keras dan kami tidak menangkap apa-apa, tetapi karena Engkau menyuruhnya, aku akan menebarkan jala juga.\""
 },
 {
   "id": 25122,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 6,
   "firman": "Dan setelah mereka melakukannya, mereka menangkap sejumlah besar ikan, sehingga jala mereka mulai koyak."
 },
 {
   "id": 25123,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 7,
   "firman": "Lalu mereka memberi isyarat kepada teman-temannya di perahu yang lain supaya mereka datang membantunya. Dan mereka itu datang, lalu mereka bersama-sama mengisi kedua perahu itu dengan ikan hingga hampir tenggelam."
 },
 {
   "id": 25124,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 8,
   "firman": "Ketika Simon Petrus melihat hal itu iapun tersungkur di depan Yesus dan berkata: \"Tuhan, pergilah dari padaku, karena aku ini seorang berdosa.\""
 },
 {
   "id": 25125,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 9,
   "firman": "Sebab ia dan semua orang yang bersama-sama dengan dia takjub oleh karena banyaknya ikan yang mereka tangkap;"
 },
 {
   "id": 25126,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 10,
   "firman": "demikian juga Yakobus dan Yohanes, anak-anak Zebedeus, yang menjadi teman Simon. Kata Yesus kepada Simon: \"Jangan takut, mulai dari sekarang engkau akan menjala manusia.\""
 },
 {
   "id": 25127,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 11,
   "firman": "Dan sesudah mereka menghela perahu-perahunya ke darat, merekapun meninggalkan segala sesuatu, lalu mengikut Yesus."
 },
 {
   "id": 25128,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 12,
   "firman": "Pada suatu kali Yesus berada dalam sebuah kota. Di situ ada seorang yang penuh kusta. Ketika ia melihat Yesus, tersungkurlah ia dan memohon: \"Tuan, jika Tuan mau, Tuan dapat mentahirkan aku.\""
 },
 {
   "id": 25129,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 13,
   "firman": "Lalu Yesus mengulurkan tangan-Nya, menjamah orang itu, dan berkata: \"Aku mau, jadilah engkau tahir.\" Seketika itu juga lenyaplah penyakit kustanya."
 },
 {
   "id": 25130,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 14,
   "firman": "Yesus melarang orang itu memberitahukannya kepada siapapun juga dan berkata: \"Pergilah, perlihatkanlah dirimu kepada imam dan persembahkanlah untuk pentahiranmu persembahan seperti yang diperintahkan Musa, sebagai bukti bagi mereka.\""
 },
 {
   "id": 25131,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 15,
   "firman": "Tetapi kabar tentang Yesus makin jauh tersiar dan datanglah orang banyak berbondong-bondong kepada-Nya untuk mendengar Dia dan untuk disembuhkan dari penyakit mereka."
 },
 {
   "id": 25132,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 16,
   "firman": "Akan tetapi Ia mengundurkan diri ke tempat-tempat yang sunyi dan berdoa."
 },
 {
   "id": 25133,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 17,
   "firman": "Pada suatu hari ketika Yesus mengajar, ada beberapa orang Farisi dan ahli Taurat duduk mendengarkan-Nya. Mereka datang dari semua desa di Galilea dan Yudea dan dari Yerusalem. Kuasa Tuhan menyertai Dia, sehingga Ia dapat menyembuhkan orang sakit."
 },
 {
   "id": 25134,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 18,
   "firman": "Lalu datanglah beberapa orang mengusung seorang lumpuh di atas tempat tidur; mereka berusaha membawa dia masuk dan meletakkannya di hadapan Yesus."
 },
 {
   "id": 25135,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 19,
   "firman": "Karena mereka tidak dapat membawanya masuk berhubung dengan banyaknya orang di situ, naiklah mereka ke atap rumah, lalu membongkar atap itu, dan menurunkan orang itu dengan tempat tidurnya ke tengah-tengah orang banyak tepat di depan Yesus."
 },
 {
   "id": 25136,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 20,
   "firman": "Ketika Yesus melihat iman mereka, berkatalah Ia: \"Hai saudara, dosamu sudah diampuni.\""
 },
 {
   "id": 25137,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 21,
   "firman": "Tetapi ahli-ahli Taurat dan orang-orang Farisi berpikir dalam hatinya: \"Siapakah orang yang menghujat Allah ini? Siapa yang dapat mengampuni dosa selain dari pada Allah sendiri?\""
 },
 {
   "id": 25138,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 22,
   "firman": "Akan tetapi Yesus mengetahui pikiran mereka, lalu berkata kepada mereka: \"Apakah yang kamu pikirkan dalam hatimu?"
 },
 {
   "id": 25139,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 23,
   "firman": "Manakah lebih mudah, mengatakan: Dosamu sudah diampuni, atau mengatakan: Bangunlah, dan berjalanlah?"
 },
 {
   "id": 25140,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 24,
   "firman": "Tetapi supaya kamu tahu, bahwa di dunia ini Anak Manusia berkuasa mengampuni dosa\" --berkatalah Ia kepada orang lumpuh itu--:\"Kepadamu Kukatakan, bangunlah, angkatlah tempat tidurmu dan pulanglah ke rumahmu!\""
 },
 {
   "id": 25141,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 25,
   "firman": "Dan seketika itu juga bangunlah ia, di depan mereka, lalu mengangkat tempat tidurnya dan pulang ke rumahnya sambil memuliakan Allah."
 },
 {
   "id": 25142,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 26,
   "firman": "Semua orang itu takjub, lalu memuliakan Allah, dan mereka sangat takut, katanya: \"Hari ini kami telah menyaksikan hal-hal yang sangat mengherankan.\""
 },
 {
   "id": 25143,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 27,
   "firman": "Kemudian, ketika Yesus pergi ke luar, Ia melihat seorang pemungut cukai, yang bernama Lewi, sedang duduk di rumah cukai. Yesus berkata kepadanya: \"Ikutlah Aku!\""
 },
 {
   "id": 25144,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 28,
   "firman": "Maka berdirilah Lewi dan meninggalkan segala sesuatu, lalu mengikut Dia."
 },
 {
   "id": 25145,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 29,
   "firman": "Dan Lewi mengadakan suatu perjamuan besar untuk Dia di rumahnya dan sejumlah besar pemungut cukai dan orang-orang lain turut makan bersama-sama dengan Dia."
 },
 {
   "id": 25146,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 30,
   "firman": "Orang-orang Farisi dan ahli-ahli Taurat bersungut-sungut kepada murid-murid Yesus, katanya: \"Mengapa kamu makan dan minum bersama-sama dengan pemungut cukai dan orang berdosa?\""
 },
 {
   "id": 25147,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 31,
   "firman": "Lalu jawab Yesus kepada mereka, kata-Nya: \"Bukan orang sehat yang memerlukan tabib, tetapi orang sakit;"
 },
 {
   "id": 25148,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 32,
   "firman": "Aku datang bukan untuk memanggil orang benar, tetapi orang berdosa, supaya mereka bertobat.\""
 },
 {
   "id": 25149,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 33,
   "firman": "Orang-orang Farisi itu berkata pula kepada Yesus: \"Murid-murid Yohanes sering berpuasa dan sembahyang, demikian juga murid-murid orang Farisi, tetapi murid-murid-Mu makan dan minum.\""
 },
 {
   "id": 25150,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 34,
   "firman": "Jawab Yesus kepada mereka: \"Dapatkah sahabat mempelai laki-laki disuruh berpuasa, sedang mempelai itu bersama mereka?"
 },
 {
   "id": 25151,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 35,
   "firman": "Tetapi akan datang waktunya, apabila mempelai itu diambil dari mereka, pada waktu itulah mereka akan berpuasa.\""
 },
 {
   "id": 25152,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 36,
   "firman": "Ia mengatakan juga suatu perumpamaan kepada mereka: \"Tidak seorangpun mengoyakkan secarik kain dari baju yang baru untuk menambalkannya pada baju yang tua. Jika demikian, yang baru itu juga akan koyak dan pada yang tua itu tidak akan cocok kain penambal yang dikoyakkan dari yang baru itu."
 },
 {
   "id": 25153,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 37,
   "firman": "Demikian juga tidak seorangpun mengisikan anggur yang baru ke dalam kantong kulit yang tua, karena jika demikian, anggur yang baru itu akan mengoyakkan kantong itu dan anggur itu akan terbuang dan kantong itupun hancur."
 },
 {
   "id": 25154,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 38,
   "firman": "Tetapi anggur yang baru harus disimpan dalam kantong yang baru pula."
 },
 {
   "id": 25155,
   "kitab": "Luk",
   "pasal": 5,
   "ayat": 39,
   "firman": "Dan tidak seorangpun yang telah minum anggur tua ingin minum anggur yang baru, sebab ia akan berkata: Anggur yang tua itu baik.\""
 },
 {
   "id": 25156,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 1,
   "firman": "Pada suatu hari Sabat, ketika Yesus berjalan di ladang gandum, murid-murid-Nya memetik bulir gandum dan memakannya, sementara mereka menggisarnya dengan tangannya."
 },
 {
   "id": 25157,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 2,
   "firman": "Tetapi beberapa orang Farisi berkata: \"Mengapa kamu berbuat sesuatu yang tidak diperbolehkan pada hari Sabat?\""
 },
 {
   "id": 25158,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 3,
   "firman": "Lalu Yesus menjawab mereka: \"Tidakkah kamu baca apa yang dilakukan oleh Daud, ketika ia dan mereka yang mengikutinya lapar,"
 },
 {
   "id": 25159,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 4,
   "firman": "bagaimana ia masuk ke dalam Rumah Allah dan mengambil roti sajian, lalu memakannya dan memberikannya kepada pengikut-pengikutnya, padahal roti itu tidak boleh dimakan kecuali oleh imam-imam?\""
 },
 {
   "id": 25160,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 5,
   "firman": "Kata Yesus lagi kepada mereka: \"Anak Manusia adalah Tuhan atas hari Sabat.\""
 },
 {
   "id": 25161,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 6,
   "firman": "Pada suatu hari Sabat lain, Yesus masuk ke rumah ibadat, lalu mengajar. Di situ ada seorang yang mati tangan kanannya."
 },
 {
   "id": 25162,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 7,
   "firman": "Ahli-ahli Taurat dan orang-orang Farisi mengamat-amati Yesus, kalau-kalau Ia menyembuhkan orang pada hari Sabat, supaya mereka dapat alasan untuk mempersalahkan Dia."
 },
 {
   "id": 25163,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tetapi Ia mengetahui pikiran mereka, lalu berkata kepada orang yang mati tangannya itu: \"Bangunlah dan berdirilah di tengah!\" Maka bangunlah orang itu dan berdiri."
 },
 {
   "id": 25164,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 9,
   "firman": "Lalu Yesus berkata kepada mereka: \"Aku bertanya kepada kamu: Manakah yang diperbolehkan pada hari Sabat, berbuat baik atau berbuat jahat, menyelamatkan nyawa orang atau membinasakannya?\""
 },
 {
   "id": 25165,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 10,
   "firman": "Sesudah itu Ia memandang keliling kepada mereka semua, lalu berkata kepada orang sakit itu: \"Ulurkanlah tanganmu!\" Orang itu berbuat demikian dan sembuhlah tangannya."
 },
 {
   "id": 25166,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 11,
   "firman": "Maka meluaplah amarah mereka, lalu mereka berunding, apakah yang akan mereka lakukan terhadap Yesus."
 },
 {
   "id": 25167,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 12,
   "firman": "Pada waktu itu pergilah Yesus ke bukit untuk berdoa dan semalam-malaman Ia berdoa kepada Allah."
 },
 {
   "id": 25168,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 13,
   "firman": "Ketika hari siang, Ia memanggil murid-murid-Nya kepada-Nya, lalu memilih dari antara mereka dua belas orang, yang disebut-Nya rasul:"
 },
 {
   "id": 25169,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 14,
   "firman": "Simon yang juga diberi-Nya nama Petrus, dan Andreas saudara Simon, Yakobus dan Yohanes, Filipus dan Bartolomeus,"
 },
 {
   "id": 25170,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 15,
   "firman": "Matius dan Tomas, Yakobus anak Alfeus, dan Simon yang disebut orang Zelot,"
 },
 {
   "id": 25171,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 16,
   "firman": "Yudas anak Yakobus, dan Yudas Iskariot yang kemudian menjadi pengkhianat."
 },
 {
   "id": 25172,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 17,
   "firman": "Lalu Ia turun dengan mereka dan berhenti pada suatu tempat yang datar: di situ berkumpul sejumlah besar dari murid-murid-Nya dan banyak orang lain yang datang dari seluruh Yudea dan dari Yerusalem dan dari daerah pantai Tirus dan Sidon."
 },
 {
   "id": 25173,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 18,
   "firman": "Mereka datang untuk mendengarkan Dia dan untuk disembuhkan dari penyakit mereka; juga mereka yang dirasuk oleh roh-roh jahat beroleh kesembuhan."
 },
 {
   "id": 25174,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 19,
   "firman": "Dan semua orang banyak itu berusaha menjamah Dia, karena ada kuasa yang keluar dari pada-Nya dan semua orang itu disembuhkan-Nya."
 },
 {
   "id": 25175,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 20,
   "firman": "Lalu Yesus memandang murid-murid-Nya dan berkata: \"Berbahagialah, hai kamu yang miskin, karena kamulah yang empunya Kerajaan Allah."
 },
 {
   "id": 25176,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 21,
   "firman": "Berbahagialah, hai kamu yang sekarang ini lapar, karena kamu akan dipuaskan. Berbahagialah, hai kamu yang sekarang ini menangis, karena kamu akan tertawa."
 },
 {
   "id": 25177,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 22,
   "firman": "Berbahagialah kamu, jika karena Anak Manusia orang membenci kamu, dan jika mereka mengucilkan kamu, dan mencela kamu serta menolak namamu sebagai sesuatu yang jahat."
 },
 {
   "id": 25178,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 23,
   "firman": "Bersukacitalah pada waktu itu dan bergembiralah, sebab sesungguhnya, upahmu besar di sorga; karena secara demikian juga nenek moyang mereka telah memperlakukan para nabi."
 },
 {
   "id": 25179,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 24,
   "firman": "Tetapi celakalah kamu, hai kamu yang kaya, karena dalam kekayaanmu kamu telah memperoleh penghiburanmu."
 },
 {
   "id": 25180,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 25,
   "firman": "Celakalah kamu, yang sekarang ini kenyang, karena kamu akan lapar. Celakalah kamu, yang sekarang ini tertawa, karena kamu akan berdukacita dan menangis."
 },
 {
   "id": 25181,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 26,
   "firman": "Celakalah kamu, jika semua orang memuji kamu; karena secara demikian juga nenek moyang mereka telah memperlakukan nabi-nabi palsu.\""
 },
 {
   "id": 25182,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 27,
   "firman": "\"Tetapi kepada kamu, yang mendengarkan Aku, Aku berkata: Kasihilah musuhmu, berbuatlah baik kepada orang yang membenci kamu;"
 },
 {
   "id": 25183,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 28,
   "firman": "mintalah berkat bagi orang yang mengutuk kamu; berdoalah bagi orang yang mencaci kamu."
 },
 {
   "id": 25184,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 29,
   "firman": "Barangsiapa menampar pipimu yang satu, berikanlah juga kepadanya pipimu yang lain, dan barangsiapa yang mengambil jubahmu, biarkan juga ia mengambil bajumu."
 },
 {
   "id": 25185,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 30,
   "firman": "Berilah kepada setiap orang yang meminta kepadamu; dan janganlah meminta kembali kepada orang yang mengambil kepunyaanmu."
 },
 {
   "id": 25186,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 31,
   "firman": "Dan sebagaimana kamu kehendaki supaya orang perbuat kepadamu, perbuatlah juga demikian kepada mereka."
 },
 {
   "id": 25187,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 32,
   "firman": "Dan jikalau kamu mengasihi orang yang mengasihi kamu, apakah jasamu? Karena orang-orang berdosapun mengasihi juga orang-orang yang mengasihi mereka."
 },
 {
   "id": 25188,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 33,
   "firman": "Sebab jikalau kamu berbuat baik kepada orang yang berbuat baik kepada kamu, apakah jasamu? Orang-orang berdosapun berbuat demikian."
 },
 {
   "id": 25189,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 34,
   "firman": "Dan jikalau kamu meminjamkan sesuatu kepada orang, karena kamu berharap akan menerima sesuatu dari padanya, apakah jasamu? Orang-orang berdosapun meminjamkan kepada orang-orang berdosa, supaya mereka menerima kembali sama banyak."
 },
 {
   "id": 25190,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 35,
   "firman": "Tetapi kamu, kasihilah musuhmu dan berbuatlah baik kepada mereka dan pinjamkan dengan tidak mengharapkan balasan, maka upahmu akan besar dan kamu akan menjadi anak-anak Allah Yang Mahatinggi, sebab Ia baik terhadap orang-orang yang tidak tahu berterima kasih dan terhadap orang-orang jahat."
 },
 {
   "id": 25191,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 36,
   "firman": "Hendaklah kamu murah hati, sama seperti Bapamu adalah murah hati.\""
 },
 {
   "id": 25192,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 37,
   "firman": "\"Janganlah kamu menghakimi, maka kamupun tidak akan dihakimi. Dan janganlah kamu menghukum, maka kamupun tidak akan dihukum; ampunilah dan kamu akan diampuni."
 },
 {
   "id": 25193,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 38,
   "firman": "Berilah dan kamu akan diberi: suatu takaran yang baik, yang dipadatkan, yang digoncang dan yang tumpah ke luar akan dicurahkan ke dalam ribaanmu. Sebab ukuran yang kamu pakai untuk mengukur, akan diukurkan kepadamu.\""
 },
 {
   "id": 25194,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 39,
   "firman": "Yesus mengatakan pula suatu perumpamaan kepada mereka: \"Dapatkah orang buta menuntun orang buta? Bukankah keduanya akan jatuh ke dalam lobang?"
 },
 {
   "id": 25195,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 40,
   "firman": "Seorang murid tidak lebih dari pada gurunya, tetapi barangsiapa yang telah tamat pelajarannya akan sama dengan gurunya."
 },
 {
   "id": 25196,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 41,
   "firman": "Mengapakah engkau melihat selumbar di dalam mata saudaramu, sedangkan balok di dalam matamu sendiri tidak engkau ketahui?"
 },
 {
   "id": 25197,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 42,
   "firman": "Bagaimanakah engkau dapat berkata kepada saudaramu: Saudara, biarlah aku mengeluarkan selumbar yang ada di dalam matamu, padahal balok yang di dalam matamu tidak engkau lihat? Hai orang munafik, keluarkanlah dahulu balok dari matamu, maka engkau akan melihat dengan jelas untuk mengeluarkan selumbar itu dari mata saudaramu.\""
 },
 {
   "id": 25198,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 43,
   "firman": "\"Karena tidak ada pohon yang baik yang menghasilkan buah yang tidak baik, dan juga tidak ada pohon yang tidak baik yang menghasilkan buah yang baik."
 },
 {
   "id": 25199,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 44,
   "firman": "Sebab setiap pohon dikenal pada buahnya. Karena dari semak duri orang tidak memetik buah ara dan dari duri-duri tidak memetik buah anggur."
 },
 {
   "id": 25200,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 45,
   "firman": "Orang yang baik mengeluarkan barang yang baik dari perbendaharaan hatinya yang baik dan orang yang jahat mengeluarkan barang yang jahat dari perbendaharaannya yang jahat. Karena yang diucapkan mulutnya, meluap dari hatinya.\""
 },
 {
   "id": 25201,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 46,
   "firman": "\"Mengapa kamu berseru kepada-Ku: Tuhan, Tuhan, padahal kamu tidak melakukan apa yang Aku katakan?"
 },
 {
   "id": 25202,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 47,
   "firman": "Setiap orang yang datang kepada-Ku dan mendengarkan perkataan-Ku serta melakukannya--Aku akan menyatakan kepadamu dengan siapa ia dapat disamakan--,"
 },
 {
   "id": 25203,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 48,
   "firman": "ia sama dengan seorang yang mendirikan rumah: Orang itu menggali dalam-dalam dan meletakkan dasarnya di atas batu. Ketika datang air bah dan banjir melanda rumah itu, rumah itu tidak dapat digoyahkan, karena rumah itu kokoh dibangun."
 },
 {
   "id": 25204,
   "kitab": "Luk",
   "pasal": 6,
   "ayat": 49,
   "firman": "Akan tetapi barangsiapa mendengar perkataan-Ku, tetapi tidak melakukannya, ia sama dengan seorang yang mendirikan rumah di atas tanah tanpa dasar. Ketika banjir melandanya, rumah itu segera rubuh dan hebatlah kerusakannya.\""
 },
 {
   "id": 25205,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 1,
   "firman": "Setelah Yesus selesai berbicara di depan orang banyak, masuklah Ia ke Kapernaum."
 },
 {
   "id": 25206,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 2,
   "firman": "Di situ ada seorang perwira yang mempunyai seorang hamba, yang sangat dihargainya. Hamba itu sedang sakit keras dan hampir mati."
 },
 {
   "id": 25207,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 3,
   "firman": "Ketika perwira itu mendengar tentang Yesus, ia menyuruh beberapa orang tua-tua Yahudi kepada-Nya untuk meminta, supaya Ia datang dan menyembuhkan hambanya."
 },
 {
   "id": 25208,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 4,
   "firman": "Mereka datang kepada Yesus dan dengan sangat mereka meminta pertolongan-Nya, katanya: \"Ia layak Engkau tolong,"
 },
 {
   "id": 25209,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 5,
   "firman": "sebab ia mengasihi bangsa kita dan dialah yang menanggung pembangunan rumah ibadat kami.\""
 },
 {
   "id": 25210,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 6,
   "firman": "Lalu Yesus pergi bersama-sama dengan mereka. Ketika Ia tidak jauh lagi dari rumah perwira itu, perwira itu menyuruh sahabat-sahabatnya untuk mengatakan kepada-Nya: \"Tuan, janganlah bersusah-susah, sebab aku tidak layak menerima Tuan di dalam rumahku;"
 },
 {
   "id": 25211,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 7,
   "firman": "sebab itu aku juga menganggap diriku tidak layak untuk datang kepada-Mu. Tetapi katakan saja sepatah kata, maka hambaku itu akan sembuh."
 },
 {
   "id": 25212,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 8,
   "firman": "Sebab aku sendiri seorang bawahan, dan di bawahku ada pula prajurit. Jika aku berkata kepada salah seorang prajurit itu: Pergi!, maka ia pergi, dan kepada seorang lagi: Datang!, maka ia datang, ataupun kepada hambaku: Kerjakanlah ini!, maka ia mengerjakannya.\""
 },
 {
   "id": 25213,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 9,
   "firman": "Setelah Yesus mendengar perkataan itu, Ia heran akan dia, dan sambil berpaling kepada orang banyak yang mengikuti Dia, Ia berkata: \"Aku berkata kepadamu, iman sebesar ini tidak pernah Aku jumpai, sekalipun di antara orang Israel!\""
 },
 {
   "id": 25214,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 10,
   "firman": "Dan setelah orang-orang yang disuruh itu kembali ke rumah, didapatinyalah hamba itu telah sehat kembali."
 },
 {
   "id": 25215,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 11,
   "firman": "Kemudian Yesus pergi ke suatu kota yang bernama Nain. Murid-murid-Nya pergi bersama-sama dengan Dia, dan juga orang banyak menyertai-Nya berbondong-bondong."
 },
 {
   "id": 25216,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 12,
   "firman": "Setelah Ia dekat pintu gerbang kota, ada orang mati diusung ke luar, anak laki-laki, anak tunggal ibunya yang sudah janda, dan banyak orang dari kota itu menyertai janda itu."
 },
 {
   "id": 25217,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 13,
   "firman": "Dan ketika Tuhan melihat janda itu, tergeraklah hati-Nya oleh belas kasihan, lalu Ia berkata kepadanya: \"Jangan menangis!\""
 },
 {
   "id": 25218,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 14,
   "firman": "Sambil menghampiri usungan itu Ia menyentuhnya, dan sedang para pengusung berhenti, Ia berkata: \"Hai anak muda, Aku berkata kepadamu, bangkitlah!\""
 },
 {
   "id": 25219,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 15,
   "firman": "Maka bangunlah orang itu dan duduk dan mulai berkata-kata, dan Yesus menyerahkannya kepada ibunya."
 },
 {
   "id": 25220,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 16,
   "firman": "Semua orang itu ketakutan dan mereka memuliakan Allah, sambil berkata: \"Seorang nabi besar telah muncul di tengah-tengah kita,\" dan \"Allah telah melawat umat-Nya.\""
 },
 {
   "id": 25221,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 17,
   "firman": "Maka tersiarlah kabar tentang Yesus di seluruh Yudea dan di seluruh daerah sekitarnya."
 },
 {
   "id": 25222,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 18,
   "firman": "Ketika Yohanes mendapat kabar tentang segala peristiwa itu dari murid-muridnya,"
 },
 {
   "id": 25223,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 19,
   "firman": "ia memanggil dua orang dari antaranya dan menyuruh mereka bertanya kepada Tuhan: \"Engkaukah yang akan datang itu atau haruskah kami menantikan seorang lain?\""
 },
 {
   "id": 25224,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 20,
   "firman": "Ketika kedua orang itu sampai kepada Yesus, mereka berkata: \"Yohanes Pembaptis menyuruh kami bertanya kepada-Mu: Engkaukah yang akan datang itu atau haruskah kami menantikan seorang lain?\""
 },
 {
   "id": 25225,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 21,
   "firman": "Pada saat itu Yesus menyembuhkan banyak orang dari segala penyakit dan penderitaan dan dari roh-roh jahat, dan Ia mengaruniakan penglihatan kepada banyak orang buta."
 },
 {
   "id": 25226,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 22,
   "firman": "Dan Yesus menjawab mereka: \"Pergilah, dan katakanlah kepada Yohanes apa yang kamu lihat dan kamu dengar: Orang buta melihat, orang lumpuh berjalan, orang kusta menjadi tahir, orang tuli mendengar, orang mati dibangkitkan dan kepada orang miskin diberitakan kabar baik."
 },
 {
   "id": 25227,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 23,
   "firman": "Dan berbahagialah orang yang tidak menjadi kecewa dan menolak Aku.\""
 },
 {
   "id": 25228,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 24,
   "firman": "Setelah suruhan Yohanes itu pergi, mulailah Yesus berbicara kepada orang banyak itu tentang Yohanes: \"Untuk apakah kamu pergi ke padang gurun? Melihat buluh yang digoyangkan angin kian ke mari?"
 },
 {
   "id": 25229,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 25,
   "firman": "Atau untuk apakah kamu pergi? Melihat orang yang berpakaian halus? Orang yang berpakaian indah dan yang hidup mewah, tempatnya di istana raja."
 },
 {
   "id": 25230,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 26,
   "firman": "Jadi untuk apakah kamu pergi? Melihat nabi? Benar, dan Aku berkata kepadamu, bahkan lebih dari pada nabi."
 },
 {
   "id": 25231,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 27,
   "firman": "Karena tentang dia ada tertulis: Lihatlah, Aku menyuruh utusan-Ku mendahului Engkau, ia akan mempersiapkan jalan-Mu di hadapan-Mu."
 },
 {
   "id": 25232,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 28,
   "firman": "Aku berkata kepadamu: Di antara mereka yang dilahirkan oleh perempuan tidak ada seorangpun yang lebih besar dari pada Yohanes, namun yang terkecil dalam Kerajaan Allah lebih besar dari padanya.\""
 },
 {
   "id": 25233,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 29,
   "firman": "Seluruh orang banyak yang mendengar perkataan-Nya, termasuk para pemungut cukai, mengakui kebenaran Allah, karena mereka telah memberi diri dibaptis oleh Yohanes."
 },
 {
   "id": 25234,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 30,
   "firman": "Tetapi orang-orang Farisi dan ahli-ahli Taurat menolak maksud Allah terhadap diri mereka, karena mereka tidak mau dibaptis oleh Yohanes."
 },
 {
   "id": 25235,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 31,
   "firman": "Kata Yesus: \"Dengan apakah akan Kuumpamakan orang-orang dari angkatan ini dan dengan apakah mereka itu sama?"
 },
 {
   "id": 25236,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 32,
   "firman": "Mereka itu seumpama anak-anak yang duduk di pasar dan yang saling menyerukan: Kami meniup seruling bagimu, tetapi kamu tidak menari, kami menyanyikan kidung duka, tetapi kamu tidak menangis."
 },
 {
   "id": 25237,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 33,
   "firman": "Karena Yohanes Pembaptis datang, ia tidak makan roti dan tidak minum anggur, dan kamu berkata: Ia kerasukan setan."
 },
 {
   "id": 25238,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 34,
   "firman": "Kemudian Anak Manusia datang, Ia makan dan minum, dan kamu berkata: Lihatlah, Ia seorang pelahap dan peminum, sahabat pemungut cukai dan orang berdosa."
 },
 {
   "id": 25239,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 35,
   "firman": "Tetapi hikmat dibenarkan oleh semua orang yang menerimanya.\""
 },
 {
   "id": 25240,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 36,
   "firman": "Seorang Farisi mengundang Yesus untuk datang makan di rumahnya. Yesus datang ke rumah orang Farisi itu, lalu duduk makan."
 },
 {
   "id": 25241,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 37,
   "firman": "Di kota itu ada seorang perempuan yang terkenal sebagai seorang berdosa. Ketika perempuan itu mendengar, bahwa Yesus sedang makan di rumah orang Farisi itu, datanglah ia membawa sebuah buli-buli pualam berisi minyak wangi."
 },
 {
   "id": 25242,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 38,
   "firman": "Sambil menangis ia pergi berdiri di belakang Yesus dekat kaki-Nya, lalu membasahi kaki-Nya itu dengan air matanya dan menyekanya dengan rambutnya, kemudian ia mencium kaki-Nya dan meminyakinya dengan minyak wangi itu."
 },
 {
   "id": 25243,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 39,
   "firman": "Ketika orang Farisi yang mengundang Yesus melihat hal itu, ia berkata dalam hatinya: \"Jika Ia ini nabi, tentu Ia tahu, siapakah dan orang apakah perempuan yang menjamah-Nya ini; tentu Ia tahu, bahwa perempuan itu adalah seorang berdosa.\""
 },
 {
   "id": 25244,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 40,
   "firman": "Lalu Yesus berkata kepadanya: \"Simon, ada yang hendak Kukatakan kepadamu.\" Sahut Simon: \"Katakanlah, Guru.\""
 },
 {
   "id": 25245,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 41,
   "firman": "\"Ada dua orang yang berhutang kepada seorang pelepas uang. Yang seorang berhutang lima ratus dinar, yang lain lima puluh."
 },
 {
   "id": 25246,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 42,
   "firman": "Karena mereka tidak sanggup membayar, maka ia menghapuskan hutang kedua orang itu. Siapakah di antara mereka yang akan terlebih mengasihi dia?\""
 },
 {
   "id": 25247,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 43,
   "firman": "Jawab Simon: \"Aku kira dia yang paling banyak dihapuskan hutangnya.\" Kata Yesus kepadanya: \"Betul pendapatmu itu.\""
 },
 {
   "id": 25248,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 44,
   "firman": "Dan sambil berpaling kepada perempuan itu, Ia berkata kepada Simon: \"Engkau lihat perempuan ini? Aku masuk ke rumahmu, namun engkau tidak memberikan Aku air untuk membasuh kaki-Ku, tetapi dia membasahi kaki-Ku dengan air mata dan menyekanya dengan rambutnya."
 },
 {
   "id": 25249,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 45,
   "firman": "Engkau tidak mencium Aku, tetapi sejak Aku masuk ia tiada henti-hentinya mencium kaki-Ku."
 },
 {
   "id": 25250,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 46,
   "firman": "Engkau tidak meminyaki kepala-Ku dengan minyak, tetapi dia meminyaki kaki-Ku dengan minyak wangi."
 },
 {
   "id": 25251,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 47,
   "firman": "Sebab itu Aku berkata kepadamu: Dosanya yang banyak itu telah diampuni, sebab ia telah banyak berbuat kasih. Tetapi orang yang sedikit diampuni, sedikit juga ia berbuat kasih.\""
 },
 {
   "id": 25252,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 48,
   "firman": "Lalu Ia berkata kepada perempuan itu: \"Dosamu telah diampuni.\""
 },
 {
   "id": 25253,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 49,
   "firman": "Dan mereka, yang duduk makan bersama Dia, berpikir dalam hati mereka: \"Siapakah Ia ini, sehingga Ia dapat mengampuni dosa?\""
 },
 {
   "id": 25254,
   "kitab": "Luk",
   "pasal": 7,
   "ayat": 50,
   "firman": "Tetapi Yesus berkata kepada perempuan itu: \"Imanmu telah menyelamatkan engkau, pergilah dengan selamat!\""
 },
 {
   "id": 25255,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 1,
   "firman": "Tidak lama sesudah itu Yesus berjalan berkeliling dari kota ke kota dan dari desa ke desa memberitakan Injil Kerajaan Allah. Kedua belas murid-Nya bersama-sama dengan Dia,"
 },
 {
   "id": 25256,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 2,
   "firman": "dan juga beberapa orang perempuan yang telah disembuhkan dari roh-roh jahat atau berbagai penyakit, yaitu Maria yang disebut Magdalena, yang telah dibebaskan dari tujuh roh jahat,"
 },
 {
   "id": 25257,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 3,
   "firman": "Yohana isteri Khuza bendahara Herodes, Susana dan banyak perempuan lain. Perempuan-perempuan ini melayani rombongan itu dengan kekayaan mereka."
 },
 {
   "id": 25258,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 4,
   "firman": "Ketika orang banyak berbondong-bondong datang, yaitu orang-orang yang dari kota ke kota menggabungkan diri pada Yesus, berkatalah Ia dalam suatu perumpamaan:"
 },
 {
   "id": 25259,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 5,
   "firman": "\"Adalah seorang penabur keluar untuk menaburkan benihnya. Pada waktu ia menabur, sebagian benih itu jatuh di pinggir jalan, lalu diinjak orang dan burung-burung di udara memakannya sampai habis."
 },
 {
   "id": 25260,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 6,
   "firman": "Sebagian jatuh di tanah yang berbatu-batu, dan setelah tumbuh ia menjadi kering karena tidak mendapat air."
 },
 {
   "id": 25261,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebagian lagi jatuh di tengah semak duri, dan semak itu tumbuh bersama-sama dan menghimpitnya sampai mati."
 },
 {
   "id": 25262,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 8,
   "firman": "Dan sebagian jatuh di tanah yang baik, dan setelah tumbuh berbuah seratus kali lipat.\" Setelah berkata demikian Yesus berseru: \"Siapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\""
 },
 {
   "id": 25263,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 9,
   "firman": "Murid-murid-Nya bertanya kepada-Nya, apa maksud perumpamaan itu."
 },
 {
   "id": 25264,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 10,
   "firman": "Lalu Ia menjawab: \"Kepadamu diberi karunia untuk mengetahui rahasia Kerajaan Allah, tetapi kepada orang-orang lain hal itu diberitakan dalam perumpamaan, supaya sekalipun memandang, mereka tidak melihat dan sekalipun mendengar, mereka tidak mengerti."
 },
 {
   "id": 25265,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 11,
   "firman": "Inilah arti perumpamaan itu: Benih itu ialah firman Allah."
 },
 {
   "id": 25266,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 12,
   "firman": "Yang jatuh di pinggir jalan itu ialah orang yang telah mendengarnya; kemudian datanglah Iblis lalu mengambil firman itu dari dalam hati mereka, supaya mereka jangan percaya dan diselamatkan."
 },
 {
   "id": 25267,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 13,
   "firman": "Yang jatuh di tanah yang berbatu-batu itu ialah orang, yang setelah mendengar firman itu, menerimanya dengan gembira, tetapi mereka itu tidak berakar, mereka percaya sebentar saja dan dalam masa pencobaan mereka murtad."
 },
 {
   "id": 25268,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 14,
   "firman": "Yang jatuh dalam semak duri ialah orang yang telah mendengar firman itu, dan dalam pertumbuhan selanjutnya mereka terhimpit oleh kekuatiran dan kekayaan dan kenikmatan hidup, sehingga mereka tidak menghasilkan buah yang matang."
 },
 {
   "id": 25269,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 15,
   "firman": "Yang jatuh di tanah yang baik itu ialah orang, yang setelah mendengar firman itu, menyimpannya dalam hati yang baik dan mengeluarkan buah dalam ketekunan.\""
 },
 {
   "id": 25270,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 16,
   "firman": "\"Tidak ada orang yang menyalakan pelita lalu menutupinya dengan tempayan atau menempatkannya di bawah tempat tidur, tetapi ia menempatkannya di atas kaki dian, supaya semua orang yang masuk ke dalam rumah dapat melihat cahayanya."
 },
 {
   "id": 25271,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 17,
   "firman": "Sebab tidak ada sesuatu yang tersembunyi yang tidak akan dinyatakan, dan tidak ada sesuatu yang rahasia yang tidak akan diketahui dan diumumkan."
 },
 {
   "id": 25272,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 18,
   "firman": "Karena itu, perhatikanlah cara kamu mendengar. Karena siapa yang mempunyai, kepadanya akan diberi, tetapi siapa yang tidak mempunyai, dari padanya akan diambil, juga apa yang ia anggap ada padanya.\""
 },
 {
   "id": 25273,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 19,
   "firman": "Ibu dan saudara-saudara Yesus datang kepada-Nya, tetapi mereka tidak dapat mencapai Dia karena orang banyak."
 },
 {
   "id": 25274,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 20,
   "firman": "Orang memberitahukan kepada-Nya: \"Ibu-Mu dan saudara-saudara-Mu ada di luar dan ingin bertemu dengan Engkau.\""
 },
 {
   "id": 25275,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 21,
   "firman": "Tetapi Ia menjawab mereka: \"Ibu-Ku dan saudara-saudara-Ku ialah mereka, yang mendengarkan firman Allah dan melakukannya.\""
 },
 {
   "id": 25276,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 22,
   "firman": "Pada suatu hari Yesus naik ke dalam perahu bersama-sama dengan murid-murid-Nya, dan Ia berkata kepada mereka: \"Marilah kita bertolak ke seberang danau.\" Lalu bertolaklah mereka."
 },
 {
   "id": 25277,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 23,
   "firman": "Dan ketika mereka sedang berlayar, Yesus tertidur. Sekonyong-konyong turunlah taufan ke danau, sehingga perahu itu kemasukan air dan mereka berada dalam bahaya."
 },
 {
   "id": 25278,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 24,
   "firman": "Maka datanglah murid-murid-Nya membangunkan Dia, katanya: \"Guru, Guru, kita binasa!\" Iapun bangun, lalu menghardik angin dan air yang mengamuk itu. Dan angin dan air itupun reda dan danau itu menjadi teduh."
 },
 {
   "id": 25279,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 25,
   "firman": "Lalu kata-Nya kepada mereka: \"Di manakah kepercayaanmu?\" Maka takutlah mereka dan heran, lalu berkata seorang kepada yang lain: \"Siapa gerangan orang ini, sehingga Ia memberi perintah kepada angin dan air dan mereka taat kepada-Nya?\""
 },
 {
   "id": 25280,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 26,
   "firman": "Lalu mendaratlah Yesus dan murid-murid-Nya di tanah orang Gerasa yang terletak di seberang Galilea."
 },
 {
   "id": 25281,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 27,
   "firman": "Setelah Yesus naik ke darat, datanglah seorang laki-laki dari kota itu menemui Dia; orang itu dirasuki oleh setan-setan dan sudah lama ia tidak berpakaian dan tidak tinggal dalam rumah, tetapi dalam pekuburan."
 },
 {
   "id": 25282,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 28,
   "firman": "Ketika ia melihat Yesus, ia berteriak lalu tersungkur di hadapan-Nya dan berkata dengan suara keras: \"Apa urusan-Mu dengan aku, hai Yesus Anak Allah Yang Mahatinggi? Aku memohon kepada-Mu, supaya Engkau jangan menyiksa aku.\""
 },
 {
   "id": 25283,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 29,
   "firman": "Ia berkata demikian sebab Yesus memerintahkan roh jahat itu keluar dari orang itu. Karena sering roh itu menyeret-nyeret dia, maka untuk menjaganya, ia dirantai dan dibelenggu, tetapi ia memutuskan segala pengikat itu dan ia dihalau oleh setan itu ke tempat-tempat yang sunyi."
 },
 {
   "id": 25284,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 30,
   "firman": "Dan Yesus bertanya kepadanya: \"Siapakah namamu?\" Jawabnya: \"Legion,\" karena ia kerasukan banyak setan."
 },
 {
   "id": 25285,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 31,
   "firman": "Lalu setan-setan itu memohon kepada Yesus, supaya Ia jangan memerintahkan mereka masuk ke dalam jurang maut."
 },
 {
   "id": 25286,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 32,
   "firman": "Adalah di sana sejumlah besar babi sedang mencari makan di lereng gunung, lalu setan-setan itu meminta kepada Yesus, supaya Ia memperkenankan mereka memasuki babi-babi itu. Yesus mengabulkan permintaan mereka."
 },
 {
   "id": 25287,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 33,
   "firman": "Lalu keluarlah setan-setan itu dari orang itu dan memasuki babi-babi itu. Kawanan babi itu terjun dari tepi jurang ke dalam danau lalu mati lemas."
 },
 {
   "id": 25288,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 34,
   "firman": "Setelah penjaga-penjaga babi itu melihat apa yang telah terjadi, mereka lari lalu menceritakan hal itu di kota dan di kampung-kampung sekitarnya."
 },
 {
   "id": 25289,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 35,
   "firman": "Dan keluarlah orang-orang untuk melihat apa yang telah terjadi. Mereka datang kepada Yesus dan mereka menjumpai orang yang telah ditinggalkan setan-setan itu duduk di kaki Yesus; ia telah berpakaian dan sudah waras. Maka takutlah mereka."
 },
 {
   "id": 25290,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 36,
   "firman": "Orang-orang yang telah melihat sendiri hal itu memberitahukan kepada mereka, bagaimana orang yang dirasuk setan itu telah diselamatkan."
 },
 {
   "id": 25291,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 37,
   "firman": "Lalu seluruh penduduk daerah Gerasa meminta kepada Yesus, supaya Ia meninggalkan mereka, sebab mereka sangat ketakutan. Maka naiklah Ia ke dalam perahu, lalu berlayar kembali."
 },
 {
   "id": 25292,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 38,
   "firman": "Dan orang yang telah ditinggalkan setan-setan itu meminta supaya ia diperkenankan menyertai-Nya. Tetapi Yesus menyuruh dia pergi, kata-Nya:"
 },
 {
   "id": 25293,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 39,
   "firman": "\"Pulanglah ke rumahmu dan ceriterakanlah segala sesuatu yang telah diperbuat Allah atasmu.\" Orang itupun pergi mengelilingi seluruh kota dan memberitahukan segala apa yang telah diperbuat Yesus atas dirinya."
 },
 {
   "id": 25294,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 40,
   "firman": "Ketika Yesus kembali, orang banyak menyambut Dia sebab mereka semua menanti-nantikan Dia."
 },
 {
   "id": 25295,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 41,
   "firman": "Maka datanglah seorang yang bernama Yairus. Ia adalah kepala rumah ibadat. Sambil tersungkur di depan kaki Yesus ia memohon kepada-Nya, supaya Yesus datang ke rumahnya,"
 },
 {
   "id": 25296,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 42,
   "firman": "karena anaknya perempuan yang satu-satunya, yang berumur kira-kira dua belas tahun, hampir mati. Dalam perjalanan ke situ Yesus didesak-desak orang banyak."
 },
 {
   "id": 25297,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 43,
   "firman": "Adalah seorang perempuan yang sudah dua belas tahun menderita pendarahan dan yang tidak berhasil disembuhkan oleh siapapun."
 },
 {
   "id": 25298,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 44,
   "firman": "Ia maju mendekati Yesus dari belakang dan menjamah jumbai jubah-Nya, dan seketika itu juga berhentilah pendarahannya."
 },
 {
   "id": 25299,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 45,
   "firman": "Lalu kata Yesus: \"Siapa yang menjamah Aku?\" Dan karena tidak ada yang mengakuinya, berkatalah Petrus: \"Guru, orang banyak mengerumuni dan mendesak Engkau.\""
 },
 {
   "id": 25300,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 46,
   "firman": "Tetapi Yesus berkata: \"Ada seorang yang menjamah Aku, sebab Aku merasa ada kuasa keluar dari diri-Ku.\""
 },
 {
   "id": 25301,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 47,
   "firman": "Ketika perempuan itu melihat, bahwa perbuatannya itu ketahuan, ia datang dengan gemetar, tersungkur di depan-Nya dan menceriterakan kepada orang banyak apa sebabnya ia menjamah Dia dan bahwa ia seketika itu juga menjadi sembuh."
 },
 {
   "id": 25302,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 48,
   "firman": "Maka kata-Nya kepada perempuan itu: \"Hai anak-Ku, imanmu telah menyelamatkan engkau, pergilah dengan selamat!\""
 },
 {
   "id": 25303,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 49,
   "firman": "Ketika Yesus masih berbicara, datanglah seorang dari keluarga kepala rumah ibadat itu dan berkata: \"Anakmu sudah mati, jangan lagi engkau menyusah-nyusahkan Guru!\""
 },
 {
   "id": 25304,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 50,
   "firman": "Tetapi Yesus mendengarnya dan berkata kepada Yairus: \"Jangan takut, percaya saja, dan anakmu akan selamat.\""
 },
 {
   "id": 25305,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 51,
   "firman": "Setibanya di rumah Yairus, Yesus tidak memperbolehkan seorangpun ikut masuk dengan Dia, kecuali Petrus, Yohanes dan Yakobus dan ayah anak itu serta ibunya."
 },
 {
   "id": 25306,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 52,
   "firman": "Semua orang menangis dan meratapi anak itu. Akan tetapi Yesus berkata: \"Jangan menangis; ia tidak mati, tetapi tidur.\""
 },
 {
   "id": 25307,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 53,
   "firman": "Mereka menertawakan Dia, karena mereka tahu bahwa anak itu telah mati."
 },
 {
   "id": 25308,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 54,
   "firman": "Lalu Yesus memegang tangan anak itu dan berseru, kata-Nya: \"Hai anak bangunlah!\""
 },
 {
   "id": 25309,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 55,
   "firman": "Maka kembalilah roh anak itu dan seketika itu juga ia bangkit berdiri. Lalu Yesus menyuruh mereka memberi anak itu makan."
 },
 {
   "id": 25310,
   "kitab": "Luk",
   "pasal": 8,
   "ayat": 56,
   "firman": "Dan takjublah orang tua anak itu, tetapi Yesus melarang mereka memberitahukan kepada siapapun juga apa yang terjadi itu."
 },
 {
   "id": 25311,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 1,
   "firman": "Maka Yesus memanggil kedua belas murid-Nya, lalu memberikan tenaga dan kuasa kepada mereka untuk menguasai setan-setan dan untuk menyembuhkan penyakit-penyakit."
 },
 {
   "id": 25312,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 2,
   "firman": "Dan Ia mengutus mereka untuk memberitakan Kerajaan Allah dan untuk menyembuhkan orang,"
 },
 {
   "id": 25313,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 3,
   "firman": "kata-Nya kepada mereka: \"Jangan membawa apa-apa dalam perjalanan, jangan membawa tongkat atau bekal, roti atau uang, atau dua helai baju."
 },
 {
   "id": 25314,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 4,
   "firman": "Dan apabila kamu sudah diterima dalam suatu rumah, tinggallah di situ sampai kamu berangkat dari situ."
 },
 {
   "id": 25315,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan kalau ada orang yang tidak mau menerima kamu, keluarlah dari kota mereka dan kebaskanlah debunya dari kakimu sebagai peringatan terhadap mereka.\""
 },
 {
   "id": 25316,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 6,
   "firman": "Lalu pergilah mereka dan mereka mengelilingi segala desa sambil memberitakan Injil dan menyembuhkan orang sakit di segala tempat."
 },
 {
   "id": 25317,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 7,
   "firman": "Herodes, raja wilayah, mendengar segala yang terjadi itu dan iapun merasa cemas, sebab ada orang yang mengatakan, bahwa Yohanes telah bangkit dari antara orang mati."
 },
 {
   "id": 25318,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 8,
   "firman": "Ada lagi yang mengatakan, bahwa Elia telah muncul kembali, dan ada pula yang mengatakan, bahwa seorang dari nabi-nabi dahulu telah bangkit."
 },
 {
   "id": 25319,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 9,
   "firman": "Tetapi Herodes berkata: \"Yohanes telah kupenggal kepalanya. Siapa gerangan Dia ini, yang kabarnya melakukan hal-hal demikian?\" Lalu ia berusaha supaya dapat bertemu dengan Yesus."
 },
 {
   "id": 25320,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 10,
   "firman": "Sekembalinya rasul-rasul itu menceriterakan kepada Yesus apa yang telah mereka kerjakan. Lalu Yesus membawa mereka dan menyingkir ke sebuah kota yang bernama Betsaida, sehingga hanya mereka saja bersama Dia."
 },
 {
   "id": 25321,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 11,
   "firman": "Akan tetapi orang banyak mengetahuinya, lalu mengikuti Dia. Ia menerima mereka dan berkata-kata kepada mereka tentang Kerajaan Allah dan Ia menyembuhkan orang-orang yang memerlukan penyembuhan."
 },
 {
   "id": 25322,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 12,
   "firman": "Pada waktu hari mulai malam datanglah kedua belas murid-Nya kepada-Nya dan berkata: \"Suruhlah orang banyak itu pergi, supaya mereka pergi ke desa-desa dan kampung-kampung sekitar ini untuk mencari tempat penginapan dan makanan, karena di sini kita berada di tempat yang sunyi.\""
 },
 {
   "id": 25323,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 13,
   "firman": "Tetapi Ia berkata kepada mereka: \"Kamu harus memberi mereka makan!\" Mereka menjawab: \"Yang ada pada kami tidak lebih dari pada lima roti dan dua ikan, kecuali kalau kami pergi membeli makanan untuk semua orang banyak ini.\""
 },
 {
   "id": 25324,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 14,
   "firman": "Sebab di situ ada kira-kira lima ribu orang laki-laki. Lalu Ia berkata kepada murid-murid-Nya: \"Suruhlah mereka duduk berkelompok-kelompok, kira-kira lima puluh orang sekelompok.\""
 },
 {
   "id": 25325,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 15,
   "firman": "Murid-murid melakukannya dan menyuruh semua orang banyak itu duduk."
 },
 {
   "id": 25326,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 16,
   "firman": "Dan setelah Ia mengambil lima roti dan dua ikan itu, Ia menengadah ke langit, mengucap berkat, lalu memecah-mecahkan roti itu dan memberikannya kepada murid-murid-Nya supaya dibagi-bagikannya kepada orang banyak."
 },
 {
   "id": 25327,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 17,
   "firman": "Dan mereka semuanya makan sampai kenyang. Kemudian dikumpulkan potongan-potongan roti yang sisa sebanyak dua belas bakul."
 },
 {
   "id": 25328,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 18,
   "firman": "Pada suatu kali ketika Yesus berdoa seorang diri, datanglah murid-murid-Nya kepada-Nya. Lalu Ia bertanya kepada mereka: \"Kata orang banyak, siapakah Aku ini?\""
 },
 {
   "id": 25329,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 19,
   "firman": "Jawab mereka: \"Yohanes Pembaptis, ada juga yang mengatakan: Elia, ada pula yang mengatakan, bahwa seorang dari nabi-nabi dahulu telah bangkit.\""
 },
 {
   "id": 25330,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 20,
   "firman": "Yesus bertanya kepada mereka: \"Menurut kamu, siapakah Aku ini?\" Jawab Petrus: \"Mesias dari Allah.\""
 },
 {
   "id": 25331,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 21,
   "firman": "Lalu Yesus melarang mereka dengan keras, supaya mereka jangan memberitahukan hal itu kepada siapapun."
 },
 {
   "id": 25332,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 22,
   "firman": "Dan Yesus berkata: \"Anak Manusia harus menanggung banyak penderitaan dan ditolak oleh tua-tua, imam-imam kepala dan ahli-ahli Taurat, lalu dibunuh dan dibangkitkan pada hari ketiga.\""
 },
 {
   "id": 25333,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 23,
   "firman": "Kata-Nya kepada mereka semua: \"Setiap orang yang mau mengikut Aku, ia harus menyangkal dirinya, memikul salibnya setiap hari dan mengikut Aku."
 },
 {
   "id": 25334,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 24,
   "firman": "Karena barangsiapa mau menyelamatkan nyawanya, ia akan kehilangan nyawanya; tetapi barangsiapa kehilangan nyawanya karena Aku, ia akan menyelamatkannya."
 },
 {
   "id": 25335,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 25,
   "firman": "Apa gunanya seorang memperoleh seluruh dunia, tetapi ia membinasakan atau merugikan dirinya sendiri?"
 },
 {
   "id": 25336,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sebab barangsiapa malu karena Aku dan karena perkataan-Ku, Anak Manusia juga akan malu karena orang itu, apabila Ia datang kelak dalam kemuliaan-Nya dan dalam kemuliaan Bapa dan malaikat-malaikat kudus."
 },
 {
   "id": 25337,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 27,
   "firman": "Aku berkata kepadamu: Sesungguhnya di antara orang yang hadir di sini ada yang tidak akan mati sebelum mereka melihat Kerajaan Allah.\""
 },
 {
   "id": 25338,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 28,
   "firman": "Kira-kira delapan hari sesudah segala pengajaran itu, Yesus membawa Petrus, Yohanes dan Yakobus, lalu naik ke atas gunung untuk berdoa."
 },
 {
   "id": 25339,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 29,
   "firman": "Ketika Ia sedang berdoa, rupa wajah-Nya berubah dan pakaian-Nya menjadi putih berkilau-kilauan."
 },
 {
   "id": 25340,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 30,
   "firman": "Dan tampaklah dua orang berbicara dengan Dia, yaitu Musa dan Elia."
 },
 {
   "id": 25341,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 31,
   "firman": "Keduanya menampakkan diri dalam kemuliaan dan berbicara tentang tujuan kepergian-Nya yang akan digenapi-Nya di Yerusalem."
 },
 {
   "id": 25342,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 32,
   "firman": "Sementara itu Petrus dan teman-temannya telah tertidur dan ketika mereka terbangun mereka melihat Yesus dalam kemuliaan-Nya: dan kedua orang yang berdiri di dekat-Nya itu."
 },
 {
   "id": 25343,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 33,
   "firman": "Dan ketika kedua orang itu hendak meninggalkan Yesus, Petrus berkata kepada-Nya: \"Guru, betapa bahagianya kami berada di tempat ini. Baiklah kami dirikan sekarang tiga kemah, satu untuk Engkau, satu untuk Musa dan satu untuk Elia.\" Tetapi Petrus tidak tahu apa yang dikatakannya itu."
 },
 {
   "id": 25344,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 34,
   "firman": "Sementara ia berkata demikian, datanglah awan menaungi mereka. Dan ketika mereka masuk ke dalam awan itu, takutlah mereka."
 },
 {
   "id": 25345,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 35,
   "firman": "Maka terdengarlah suara dari dalam awan itu, yang berkata: \"Inilah Anak-Ku yang Kupilih, dengarkanlah Dia.\""
 },
 {
   "id": 25346,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 36,
   "firman": "Ketika suara itu terdengar, nampaklah Yesus tinggal seorang diri. Dan murid-murid itu merahasiakannya, dan pada masa itu mereka tidak menceriterakan kepada siapapun apa yang telah mereka lihat itu."
 },
 {
   "id": 25347,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 37,
   "firman": "Pada keesokan harinya ketika mereka turun dari gunung itu, datanglah orang banyak berbondong-bondong menemui Yesus."
 },
 {
   "id": 25348,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 38,
   "firman": "Seorang dari orang banyak itu berseru, katanya: \"Guru, aku memohon supaya Engkau menengok anakku, sebab ia adalah satu-satunya anakku."
 },
 {
   "id": 25349,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 39,
   "firman": "Sewaktu-waktu ia diserang roh, lalu mendadak ia berteriak dan roh itu menggoncang-goncangkannya sehingga mulutnya berbusa. Roh itu terus saja menyiksa dia dan hampir-hampir tidak mau meninggalkannya."
 },
 {
   "id": 25350,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 40,
   "firman": "Dan aku telah meminta kepada murid-murid-Mu supaya mereka mengusir roh itu, tetapi mereka tidak dapat.\""
 },
 {
   "id": 25351,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 41,
   "firman": "Maka kata Yesus: \"Hai kamu angkatan yang tidak percaya dan yang sesat, berapa lama lagi Aku harus tinggal di antara kamu dan sabar terhadap kamu? Bawa anakmu itu kemari!\""
 },
 {
   "id": 25352,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 42,
   "firman": "Dan ketika anak itu mendekati Yesus, setan itu membantingkannya ke tanah dan menggoncang-goncangnya. Tetapi Yesus menegor roh jahat itu dengan keras dan menyembuhkan anak itu, lalu mengembalikannya kepada ayahnya."
 },
 {
   "id": 25353,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 43,
   "firman": "Maka takjublah semua orang itu karena kebesaran Allah."
 },
 {
   "id": 25355,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 44,
   "firman": "\"Dengarlah dan camkanlah segala perkataan-Ku ini: Anak Manusia akan diserahkan ke dalam tangan manusia.\""
 },
 {
   "id": 25356,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 45,
   "firman": "Mereka tidak mengerti perkataan itu, sebab artinya tersembunyi bagi mereka, sehingga mereka tidak dapat memahaminya. Dan mereka tidak berani menanyakan arti perkataan itu kepada-Nya."
 },
 {
   "id": 25357,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 46,
   "firman": "Maka timbullah pertengkaran di antara murid-murid Yesus tentang siapakah yang terbesar di antara mereka."
 },
 {
   "id": 25358,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 47,
   "firman": "Tetapi Yesus mengetahui pikiran mereka. Karena itu Ia mengambil seorang anak kecil dan menempatkannya di samping-Nya,"
 },
 {
   "id": 25359,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 48,
   "firman": "dan berkata kepada mereka: \"Barangsiapa menyambut anak ini dalam nama-Ku, ia menyambut Aku; dan barangsiapa menyambut Aku, ia menyambut Dia, yang mengutus Aku. Karena yang terkecil di antara kamu sekalian, dialah yang terbesar.\""
 },
 {
   "id": 25360,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 49,
   "firman": "Yohanes berkata: \"Guru, kami lihat seorang mengusir setan demi nama-Mu, lalu kami cegah orang itu, karena ia bukan pengikut kita.\""
 },
 {
   "id": 25361,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 50,
   "firman": "Yesus berkata kepadanya: \"Jangan kamu cegah, sebab barangsiapa tidak melawan kamu, ia ada di pihak kamu.\""
 },
 {
   "id": 25362,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 51,
   "firman": "Ketika hampir genap waktunya Yesus diangkat ke sorga, Ia mengarahkan pandangan-Nya untuk pergi ke Yerusalem,"
 },
 {
   "id": 25363,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 52,
   "firman": "dan Ia mengirim beberapa utusan mendahului Dia. Mereka itu pergi, lalu masuk ke suatu desa orang Samaria untuk mempersiapkan segala sesuatu bagi-Nya."
 },
 {
   "id": 25364,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 53,
   "firman": "Tetapi orang-orang Samaria itu tidak mau menerima Dia, karena perjalanan-Nya menuju Yerusalem."
 },
 {
   "id": 25365,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 54,
   "firman": "Ketika dua murid-Nya, yaitu Yakobus dan Yohanes, melihat hal itu, mereka berkata: \"Tuhan, apakah Engkau mau, supaya kami menyuruh api turun dari langit untuk membinasakan mereka?\""
 },
 {
   "id": 25366,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 55,
   "firman": "Akan tetapi Ia berpaling dan menegor mereka."
 },
 {
   "id": 25367,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 56,
   "firman": "Lalu mereka pergi ke desa yang lain."
 },
 {
   "id": 25368,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 57,
   "firman": "Ketika Yesus dan murid-murid-Nya melanjutkan perjalanan mereka, berkatalah seorang di tengah jalan kepada Yesus: \"Aku akan mengikut Engkau, ke mana saja Engkau pergi.\""
 },
 {
   "id": 25369,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 58,
   "firman": "Yesus berkata kepadanya: \"Serigala mempunyai liang dan burung mempunyai sarang, tetapi Anak Manusia tidak mempunyai tempat untuk meletakkan kepala-Nya.\""
 },
 {
   "id": 25370,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 59,
   "firman": "Lalu Ia berkata kepada seorang lain: \"Ikutlah Aku!\" Tetapi orang itu berkata: \"Izinkanlah aku pergi dahulu menguburkan bapaku.\""
 },
 {
   "id": 25371,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 60,
   "firman": "Tetapi Yesus berkata kepadanya: \"Biarlah orang mati menguburkan orang mati; tetapi engkau, pergilah dan beritakanlah Kerajaan Allah di mana-mana.\""
 },
 {
   "id": 25372,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 61,
   "firman": "Dan seorang lain lagi berkata: \"Aku akan mengikut Engkau, Tuhan, tetapi izinkanlah aku pamitan dahulu dengan keluargaku.\""
 },
 {
   "id": 25373,
   "kitab": "Luk",
   "pasal": 9,
   "ayat": 62,
   "firman": "Tetapi Yesus berkata: \"Setiap orang yang siap untuk membajak tetapi menoleh ke belakang, tidak layak untuk Kerajaan Allah.\""
 },
 {
   "id": 25374,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 1,
   "firman": "Kemudian dari pada itu Tuhan menunjuk tujuh puluh murid yang lain, lalu mengutus mereka berdua-dua mendahului-Nya ke setiap kota dan tempat yang hendak dikunjungi-Nya."
 },
 {
   "id": 25375,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 2,
   "firman": "Kata-Nya kepada mereka: \"Tuaian memang banyak, tetapi pekerja sedikit. Karena itu mintalah kepada Tuan yang empunya tuaian, supaya Ia mengirimkan pekerja-pekerja untuk tuaian itu."
 },
 {
   "id": 25376,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 3,
   "firman": "Pergilah, sesungguhnya Aku mengutus kamu seperti anak domba ke tengah-tengah serigala."
 },
 {
   "id": 25377,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 4,
   "firman": "Janganlah membawa pundi-pundi atau bekal atau kasut, dan janganlah memberi salam kepada siapapun selama dalam perjalanan."
 },
 {
   "id": 25378,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 5,
   "firman": "Kalau kamu memasuki suatu rumah, katakanlah lebih dahulu: Damai sejahtera bagi rumah ini."
 },
 {
   "id": 25379,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 6,
   "firman": "Dan jikalau di situ ada orang yang layak menerima damai sejahtera, maka salammu itu akan tinggal atasnya. Tetapi jika tidak, salammu itu kembali kepadamu."
 },
 {
   "id": 25380,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 7,
   "firman": "Tinggallah dalam rumah itu, makan dan minumlah apa yang diberikan orang kepadamu, sebab seorang pekerja patut mendapat upahnya. Janganlah berpindah-pindah rumah."
 },
 {
   "id": 25381,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 8,
   "firman": "Dan jikalau kamu masuk ke dalam sebuah kota dan kamu diterima di situ, makanlah apa yang dihidangkan kepadamu,"
 },
 {
   "id": 25382,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 9,
   "firman": "dan sembuhkanlah orang-orang sakit yang ada di situ dan katakanlah kepada mereka: Kerajaan Allah sudah dekat padamu."
 },
 {
   "id": 25383,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 10,
   "firman": "Tetapi jikalau kamu masuk ke dalam sebuah kota dan kamu tidak diterima di situ, pergilah ke jalan-jalan raya kota itu dan serukanlah:"
 },
 {
   "id": 25384,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 11,
   "firman": "Juga debu kotamu yang melekat pada kaki kami, kami kebaskan di depanmu; tetapi ketahuilah ini: Kerajaan Allah sudah dekat."
 },
 {
   "id": 25385,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 12,
   "firman": "Aku berkata kepadamu: pada hari itu Sodom akan lebih ringan tanggungannya dari pada kota itu.\""
 },
 {
   "id": 25386,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 13,
   "firman": "\"Celakalah engkau Khorazim! Celakalah engkau Betsaida! karena jika di Tirus dan di Sidon terjadi mujizat-mujizat yang telah terjadi di tengah-tengah kamu, sudah lama mereka bertobat dan berkabung."
 },
 {
   "id": 25387,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 14,
   "firman": "Akan tetapi pada waktu penghakiman, tanggungan Tirus dan Sidon akan lebih ringan dari pada tanggunganmu."
 },
 {
   "id": 25388,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 15,
   "firman": "Dan engkau Kapernaum, apakah engkau akan dinaikkan sampai ke langit? Tidak, engkau akan diturunkan sampai ke dunia orang mati!"
 },
 {
   "id": 25389,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 16,
   "firman": "Barangsiapa mendengarkan kamu, ia mendengarkan Aku; dan barangsiapa menolak kamu, ia menolak Aku; dan barangsiapa menolak Aku, ia menolak Dia yang mengutus Aku.\""
 },
 {
   "id": 25390,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 17,
   "firman": "Kemudian ketujuh puluh murid itu kembali dengan gembira dan berkata: \"Tuhan, juga setan-setan takluk kepada kami demi nama-Mu.\""
 },
 {
   "id": 25391,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lalu kata Yesus kepada mereka: \"Aku melihat Iblis jatuh seperti kilat dari langit."
 },
 {
   "id": 25392,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 19,
   "firman": "Sesungguhnya Aku telah memberikan kuasa kepada kamu untuk menginjak ular dan kalajengking dan kuasa untuk menahan kekuatan musuh, sehingga tidak ada yang akan membahayakan kamu."
 },
 {
   "id": 25393,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 20,
   "firman": "Namun demikian janganlah bersukacita karena roh-roh itu takluk kepadamu, tetapi bersukacitalah karena namamu ada terdaftar di sorga.\""
 },
 {
   "id": 25394,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 21,
   "firman": "Pada waktu itu juga bergembiralah Yesus dalam Roh Kudus dan berkata: \"Aku bersyukur kepada-Mu, Bapa, Tuhan langit dan bumi, karena semuanya itu Engkau sembunyikan bagi orang bijak dan orang pandai, tetapi Engkau nyatakan kepada orang kecil. Ya Bapa, itulah yang berkenan kepada-Mu."
 },
 {
   "id": 25395,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 22,
   "firman": "Semua telah diserahkan kepada-Ku oleh Bapa-Ku dan tidak ada seorangpun yang tahu siapakah Anak selain Bapa, dan siapakah Bapa selain Anak dan orang yang kepadanya Anak itu berkenan menyatakan hal itu.\""
 },
 {
   "id": 25396,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 23,
   "firman": "Sesudah itu berpalinglah Yesus kepada murid-murid-Nya tersendiri dan berkata: \"Berbahagialah mata yang melihat apa yang kamu lihat."
 },
 {
   "id": 25397,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 24,
   "firman": "Karena Aku berkata kepada kamu: Banyak nabi dan raja ingin melihat apa yang kamu lihat, tetapi tidak melihatnya, dan ingin mendengar apa yang kamu dengar, tetapi tidak mendengarnya.\""
 },
 {
   "id": 25398,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 25,
   "firman": "Pada suatu kali berdirilah seorang ahli Taurat untuk mencobai Yesus, katanya: \"Guru, apa yang harus kuperbuat untuk memperoleh hidup yang kekal?\""
 },
 {
   "id": 25399,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 26,
   "firman": "Jawab Yesus kepadanya: \"Apa yang tertulis dalam hukum Taurat? Apa yang kaubaca di sana?\""
 },
 {
   "id": 25400,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 27,
   "firman": "Jawab orang itu: \"Kasihilah Tuhan, Allahmu, dengan segenap hatimu dan dengan segenap jiwamu dan dengan segenap kekuatanmu dan dengan segenap akal budimu, dan kasihilah sesamamu manusia seperti dirimu sendiri.\""
 },
 {
   "id": 25401,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 28,
   "firman": "Kata Yesus kepadanya: \"Jawabmu itu benar; perbuatlah demikian, maka engkau akan hidup.\""
 },
 {
   "id": 25402,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 29,
   "firman": "Tetapi untuk membenarkan dirinya orang itu berkata kepada Yesus: \"Dan siapakah sesamaku manusia?\""
 },
 {
   "id": 25403,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 30,
   "firman": "Jawab Yesus: \"Adalah seorang yang turun dari Yerusalem ke Yerikho; ia jatuh ke tangan penyamun-penyamun yang bukan saja merampoknya habis-habisan, tetapi yang juga memukulnya dan yang sesudah itu pergi meninggalkannya setengah mati."
 },
 {
   "id": 25404,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 31,
   "firman": "Kebetulan ada seorang imam turun melalui jalan itu; ia melihat orang itu, tetapi ia melewatinya dari seberang jalan."
 },
 {
   "id": 25405,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 32,
   "firman": "Demikian juga seorang Lewi datang ke tempat itu; ketika ia melihat orang itu, ia melewatinya dari seberang jalan."
 },
 {
   "id": 25406,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 33,
   "firman": "Lalu datang seorang Samaria, yang sedang dalam perjalanan, ke tempat itu; dan ketika ia melihat orang itu, tergeraklah hatinya oleh belas kasihan."
 },
 {
   "id": 25407,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 34,
   "firman": "Ia pergi kepadanya lalu membalut luka-lukanya, sesudah ia menyiraminya dengan minyak dan anggur. Kemudian ia menaikkan orang itu ke atas keledai tunggangannya sendiri lalu membawanya ke tempat penginapan dan merawatnya."
 },
 {
   "id": 25408,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 35,
   "firman": "Keesokan harinya ia menyerahkan dua dinar kepada pemilik penginapan itu, katanya: Rawatlah dia dan jika kaubelanjakan lebih dari ini, aku akan menggantinya, waktu aku kembali."
 },
 {
   "id": 25409,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 36,
   "firman": "Siapakah di antara ketiga orang ini, menurut pendapatmu, adalah sesama manusia dari orang yang jatuh ke tangan penyamun itu?\""
 },
 {
   "id": 25410,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 37,
   "firman": "Jawab orang itu: \"Orang yang telah menunjukkan belas kasihan kepadanya.\" Kata Yesus kepadanya: \"Pergilah, dan perbuatlah demikian!\""
 },
 {
   "id": 25411,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 38,
   "firman": "Ketika Yesus dan murid-murid-Nya dalam perjalanan, tibalah Ia di sebuah kampung. Seorang perempuan yang bernama Marta menerima Dia di rumahnya."
 },
 {
   "id": 25412,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 39,
   "firman": "Perempuan itu mempunyai seorang saudara yang bernama Maria. Maria ini duduk dekat kaki Tuhan dan terus mendengarkan perkataan-Nya,"
 },
 {
   "id": 25413,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 40,
   "firman": "sedang Marta sibuk sekali melayani. Ia mendekati Yesus dan berkata: \"Tuhan, tidakkah Engkau peduli, bahwa saudaraku membiarkan aku melayani seorang diri? Suruhlah dia membantu aku.\""
 },
 {
   "id": 25414,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 41,
   "firman": "Tetapi Tuhan menjawabnya: \"Marta, Marta, engkau kuatir dan menyusahkan diri dengan banyak perkara,"
 },
 {
   "id": 25415,
   "kitab": "Luk",
   "pasal": 10,
   "ayat": 42,
   "firman": "tetapi hanya satu saja yang perlu: Maria telah memilih bagian yang terbaik, yang tidak akan diambil dari padanya.\""
 },
 {
   "id": 25416,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 1,
   "firman": "Pada suatu kali Yesus sedang berdoa di salah satu tempat. Ketika Ia berhenti berdoa, berkatalah seorang dari murid-murid-Nya kepada-Nya: \"Tuhan, ajarlah kami berdoa, sama seperti yang diajarkan Yohanes kepada murid-muridnya.\""
 },
 {
   "id": 25417,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 2,
   "firman": "Jawab Yesus kepada mereka: \"Apabila kamu berdoa, katakanlah: Bapa, dikuduskanlah nama-Mu; datanglah Kerajaan-Mu."
 },
 {
   "id": 25418,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 3,
   "firman": "Berikanlah kami setiap hari makanan kami yang secukupnya"
 },
 {
   "id": 25419,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 4,
   "firman": "dan ampunilah kami akan dosa kami, sebab kamipun mengampuni setiap orang yang bersalah kepada kami; dan janganlah membawa kami ke dalam pencobaan.\""
 },
 {
   "id": 25420,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 5,
   "firman": "Lalu kata-Nya kepada mereka: \"Jika seorang di antara kamu pada tengah malam pergi ke rumah seorang sahabatnya dan berkata kepadanya: Saudara, pinjamkanlah kepadaku tiga roti,"
 },
 {
   "id": 25421,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 6,
   "firman": "sebab seorang sahabatku yang sedang berada dalam perjalanan singgah ke rumahku dan aku tidak mempunyai apa-apa untuk dihidangkan kepadanya;"
 },
 {
   "id": 25422,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 7,
   "firman": "masakan ia yang di dalam rumah itu akan menjawab: Jangan mengganggu aku, pintu sudah tertutup dan aku serta anak-anakku sudah tidur; aku tidak dapat bangun dan memberikannya kepada saudara."
 },
 {
   "id": 25423,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 8,
   "firman": "Aku berkata kepadamu: Sekalipun ia tidak mau bangun dan memberikannya kepadanya karena orang itu adalah sahabatnya, namun karena sikapnya yang tidak malu itu, ia akan bangun juga dan memberikan kepadanya apa yang diperlukannya."
 },
 {
   "id": 25424,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 9,
   "firman": "Oleh karena itu Aku berkata kepadamu: Mintalah, maka akan diberikan kepadamu; carilah, maka kamu akan mendapat; ketoklah, maka pintu akan dibukakan bagimu."
 },
 {
   "id": 25425,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 10,
   "firman": "Karena setiap orang yang meminta, menerima dan setiap orang yang mencari, mendapat dan setiap orang yang mengetok, baginya pintu dibukakan."
 },
 {
   "id": 25426,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 11,
   "firman": "Bapa manakah di antara kamu, jika anaknya minta ikan dari padanya, akan memberikan ular kepada anaknya itu ganti ikan?"
 },
 {
   "id": 25427,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 12,
   "firman": "Atau, jika ia minta telur, akan memberikan kepadanya kalajengking?"
 },
 {
   "id": 25428,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 13,
   "firman": "Jadi jika kamu yang jahat tahu memberi pemberian yang baik kepada anak-anakmu, apalagi Bapamu yang di sorga! Ia akan memberikan Roh Kudus kepada mereka yang meminta kepada-Nya.\""
 },
 {
   "id": 25429,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 14,
   "firman": "Pada suatu kali Yesus mengusir dari seorang suatu setan yang membisukan. Ketika setan itu keluar, orang bisu itu dapat berkata-kata. Maka heranlah orang banyak."
 },
 {
   "id": 25430,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 15,
   "firman": "Tetapi ada di antara mereka yang berkata: \"Ia mengusir setan dengan kuasa Beelzebul, penghulu setan.\""
 },
 {
   "id": 25431,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 16,
   "firman": "Ada pula yang meminta suatu tanda dari sorga kepada-Nya, untuk mencobai Dia."
 },
 {
   "id": 25432,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 17,
   "firman": "Tetapi Yesus mengetahui pikiran mereka lalu berkata: \"Setiap kerajaan yang terpecah-pecah pasti binasa, dan setiap rumah tangga yang terpecah-pecah, pasti runtuh."
 },
 {
   "id": 25433,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 18,
   "firman": "Jikalau Iblis itu juga terbagi-bagi dan melawan dirinya sendiri, bagaimanakah kerajaannya dapat bertahan? Sebab kamu berkata, bahwa Aku mengusir setan dengan kuasa Beelzebul."
 },
 {
   "id": 25434,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 19,
   "firman": "Jadi jika Aku mengusir setan dengan kuasa Beelzebul, dengan kuasa apakah pengikut-pengikutmu mengusirnya? Sebab itu merekalah yang akan menjadi hakimmu."
 },
 {
   "id": 25435,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 20,
   "firman": "Tetapi jika Aku mengusir setan dengan kuasa Allah, maka sesungguhnya Kerajaan Allah sudah datang kepadamu."
 },
 {
   "id": 25436,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 21,
   "firman": "Apabila seorang yang kuat dan yang lengkap bersenjata menjaga rumahnya sendiri, maka amanlah segala miliknya."
 },
 {
   "id": 25437,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 22,
   "firman": "Tetapi jika seorang yang lebih kuat dari padanya menyerang dan mengalahkannya, maka orang itu akan merampas perlengkapan senjata, yang diandalkannya, dan akan membagi-bagikan rampasannya."
 },
 {
   "id": 25438,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 23,
   "firman": "Siapa tidak bersama Aku, ia melawan Aku dan siapa tidak mengumpulkan bersama Aku, ia mencerai-beraikan.\""
 },
 {
   "id": 25439,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 24,
   "firman": "\"Apabila roh jahat keluar dari manusia, iapun mengembara ke tempat-tempat yang tandus mencari perhentian, dan karena ia tidak mendapatnya, ia berkata: Aku akan kembali ke rumah yang telah kutinggalkan itu."
 },
 {
   "id": 25440,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 25,
   "firman": "Maka pergilah ia dan mendapati rumah itu bersih tersapu dan rapih teratur."
 },
 {
   "id": 25441,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 26,
   "firman": "Lalu ia keluar dan mengajak tujuh roh lain yang lebih jahat dari padanya, dan mereka masuk dan berdiam di situ. Maka akhirnya keadaan orang itu lebih buruk dari pada keadaannya semula.\""
 },
 {
   "id": 25442,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 27,
   "firman": "Ketika Yesus masih berbicara, berserulah seorang perempuan dari antara orang banyak dan berkata kepada-Nya: \"Berbahagialah ibu yang telah mengandung Engkau dan susu yang telah menyusui Engkau.\""
 },
 {
   "id": 25443,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 28,
   "firman": "Tetapi Ia berkata: \"Yang berbahagia ialah mereka yang mendengarkan firman Allah dan yang memeliharanya.\""
 },
 {
   "id": 25444,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 29,
   "firman": "Ketika orang banyak mengerumuni-Nya, berkatalah Yesus: \"Angkatan ini adalah angkatan yang jahat. Mereka menghendaki suatu tanda, tetapi kepada mereka tidak akan diberikan tanda selain tanda nabi Yunus."
 },
 {
   "id": 25445,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 30,
   "firman": "Sebab seperti Yunus menjadi tanda untuk orang-orang Niniwe, demikian pulalah Anak Manusia akan menjadi tanda untuk angkatan ini."
 },
 {
   "id": 25446,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 31,
   "firman": "Pada waktu penghakiman, ratu dari Selatan itu akan bangkit bersama orang dari angkatan ini dan ia akan menghukum mereka. Sebab ratu ini datang dari ujung bumi untuk mendengarkan hikmat Salomo, dan sesungguhnya yang ada di sini lebih dari pada Salomo!"
 },
 {
   "id": 25447,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 32,
   "firman": "Pada waktu penghakiman, orang-orang Niniwe akan bangkit bersama angkatan ini dan mereka akan menghukumnya. Sebab orang-orang Niniwe itu bertobat waktu mereka mendengarkan pemberitaan Yunus, dan sesungguhnya yang ada di sini lebih dari pada Yunus!\""
 },
 {
   "id": 25448,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 33,
   "firman": "\"Tidak seorangpun yang menyalakan pelita lalu meletakkannya di kolong rumah atau di bawah gantang, melainkan di atas kaki dian, supaya semua orang yang masuk, dapat melihat cahayanya."
 },
 {
   "id": 25449,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 34,
   "firman": "Matamu adalah pelita tubuhmu. Jika matamu baik, teranglah seluruh tubuhmu, tetapi jika matamu jahat, gelaplah tubuhmu."
 },
 {
   "id": 25450,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 35,
   "firman": "Karena itu perhatikanlah supaya terang yang ada padamu jangan menjadi kegelapan."
 },
 {
   "id": 25451,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 36,
   "firman": "Jika seluruh tubuhmu terang dan tidak ada bagian yang gelap, maka seluruhnya akan terang, sama seperti apabila pelita menerangi engkau dengan cahayanya.\""
 },
 {
   "id": 25452,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 37,
   "firman": "Ketika Yesus selesai mengajar, seorang Farisi mengundang Dia untuk makan di rumahnya. Maka masuklah Ia ke rumah itu, lalu duduk makan."
 },
 {
   "id": 25453,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 38,
   "firman": "Orang Farisi itu melihat hal itu dan ia heran, karena Yesus tidak mencuci tangan-Nya sebelum makan."
 },
 {
   "id": 25454,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 39,
   "firman": "Tetapi Tuhan berkata kepadanya: \"Kamu orang-orang Farisi, kamu membersihkan bagian luar dari cawan dan pinggan, tetapi bagian dalammu penuh rampasan dan kejahatan."
 },
 {
   "id": 25455,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 40,
   "firman": "Hai orang-orang bodoh, bukankah Dia yang menjadikan bagian luar, Dia juga yang menjadikan bagian dalam?"
 },
 {
   "id": 25456,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 41,
   "firman": "Akan tetapi, berikanlah isinya sebagai sedekah dan sesungguhnya semuanya akan menjadi bersih bagimu."
 },
 {
   "id": 25457,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 42,
   "firman": "Tetapi celakalah kamu, hai orang-orang Farisi, sebab kamu membayar persepuluhan dari selasih, inggu dan segala jenis sayuran, tetapi kamu mengabaikan keadilan dan kasih Allah. Yang satu harus dilakukan dan yang lain jangan diabaikan."
 },
 {
   "id": 25458,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 43,
   "firman": "Celakalah kamu, hai orang-orang Farisi, sebab kamu suka duduk di tempat terdepan di rumah ibadat dan suka menerima penghormatan di pasar."
 },
 {
   "id": 25459,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 44,
   "firman": "Celakalah kamu, sebab kamu sama seperti kubur yang tidak memakai tanda; orang-orang yang berjalan di atasnya, tidak mengetahuinya.\""
 },
 {
   "id": 25460,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 45,
   "firman": "Seorang dari antara ahli-ahli Taurat itu menjawab dan berkata kepada-Nya: \"Guru, dengan berkata demikian, Engkau menghina kami juga.\""
 },
 {
   "id": 25461,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 46,
   "firman": "Tetapi Ia menjawab: \"Celakalah kamu juga, hai ahli-ahli Taurat, sebab kamu meletakkan beban-beban yang tak terpikul pada orang, tetapi kamu sendiri tidak menyentuh beban itu dengan satu jaripun."
 },
 {
   "id": 25462,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 47,
   "firman": "Celakalah kamu, sebab kamu membangun makam nabi-nabi, tetapi nenek moyangmu telah membunuh mereka."
 },
 {
   "id": 25463,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 48,
   "firman": "Dengan demikian kamu mengaku, bahwa kamu membenarkan perbuatan-perbuatan nenek moyangmu, sebab mereka telah membunuh nabi-nabi itu dan kamu membangun makamnya."
 },
 {
   "id": 25464,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 49,
   "firman": "Sebab itu hikmat Allah berkata: Aku akan mengutus kepada mereka nabi-nabi dan rasul-rasul dan separuh dari antara nabi-nabi dan rasul-rasul itu akan mereka bunuh dan mereka aniaya,"
 },
 {
   "id": 25465,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 50,
   "firman": "supaya dari angkatan ini dituntut darah semua nabi yang telah tertumpah sejak dunia dijadikan,"
 },
 {
   "id": 25466,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 51,
   "firman": "mulai dari darah Habel sampai kepada darah Zakharia yang telah dibunuh di antara mezbah dan Rumah Allah. Bahkan, Aku berkata kepadamu: Semuanya itu akan dituntut dari angkatan ini."
 },
 {
   "id": 25467,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 52,
   "firman": "Celakalah kamu, hai ahli-ahli Taurat, sebab kamu telah mengambil kunci pengetahuan; kamu sendiri tidak masuk ke dalam dan orang yang berusaha untuk masuk ke dalam kamu halang-halangi.\""
 },
 {
   "id": 25468,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 53,
   "firman": "Dan setelah Yesus berangkat dari tempat itu, ahli-ahli Taurat dan orang-orang Farisi terus-menerus mengintai dan membanjiri-Nya dengan rupa-rupa soal."
 },
 {
   "id": 25469,
   "kitab": "Luk",
   "pasal": 11,
   "ayat": 54,
   "firman": "Untuk itu mereka berusaha memancing-Nya, supaya mereka dapat menangkap-Nya berdasarkan sesuatu yang diucapkan-Nya."
 },
 {
   "id": 25470,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 1,
   "firman": "Sementara itu beribu-ribu orang banyak telah berkerumun, sehingga mereka berdesak-desakan. Lalu Yesus mulai mengajar, pertama-tama kepada murid-murid-Nya, kata-Nya: \"Waspadalah terhadap ragi, yaitu kemunafikan orang Farisi."
 },
 {
   "id": 25471,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 2,
   "firman": "Tidak ada sesuatupun yang tertutup yang tidak akan dibuka dan tidak ada sesuatupun yang tersembunyi yang tidak akan diketahui."
 },
 {
   "id": 25472,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 3,
   "firman": "Karena itu apa yang kamu katakan dalam gelap akan kedengaran dalam terang, dan apa yang kamu bisikkan ke telinga di dalam kamar akan diberitakan dari atas atap rumah."
 },
 {
   "id": 25473,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 4,
   "firman": "Aku berkata kepadamu, hai sahabat-sahabat-Ku, janganlah kamu takut terhadap mereka yang dapat membunuh tubuh dan kemudian tidak dapat berbuat apa-apa lagi."
 },
 {
   "id": 25474,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 5,
   "firman": "Aku akan menunjukkan kepada kamu siapakah yang harus kamu takuti. Takutilah Dia, yang setelah membunuh, mempunyai kuasa untuk melemparkan orang ke dalam neraka. Sesungguhnya Aku berkata kepadamu, takutilah Dia!"
 },
 {
   "id": 25475,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 6,
   "firman": "Bukankah burung pipit dijual lima ekor dua duit? Sungguhpun demikian tidak seekorpun dari padanya yang dilupakan Allah,"
 },
 {
   "id": 25476,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 7,
   "firman": "bahkan rambut kepalamupun terhitung semuanya. Karena itu jangan takut, karena kamu lebih berharga dari pada banyak burung pipit."
 },
 {
   "id": 25477,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 8,
   "firman": "Aku berkata kepadamu: Setiap orang yang mengakui Aku di depan manusia, Anak Manusia juga akan mengakui dia di depan malaikat-malaikat Allah."
 },
 {
   "id": 25478,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 9,
   "firman": "Tetapi barangsiapa menyangkal Aku di depan manusia, ia akan disangkal di depan malaikat-malaikat Allah."
 },
 {
   "id": 25479,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 10,
   "firman": "Setiap orang yang mengatakan sesuatu melawan Anak Manusia, ia akan diampuni; tetapi barangsiapa menghujat Roh Kudus, ia tidak akan diampuni."
 },
 {
   "id": 25480,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 11,
   "firman": "Apabila orang menghadapkan kamu kepada majelis-majelis atau kepada pemerintah-pemerintah dan penguasa-penguasa, janganlah kamu kuatir bagaimana dan apa yang harus kamu katakan untuk membela dirimu."
 },
 {
   "id": 25481,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 12,
   "firman": "Sebab pada saat itu juga Roh Kudus akan mengajar kamu apa yang harus kamu katakan.\""
 },
 {
   "id": 25482,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 13,
   "firman": "Seorang dari orang banyak itu berkata kepada Yesus: \"Guru, katakanlah kepada saudaraku supaya ia berbagi warisan dengan aku.\""
 },
 {
   "id": 25483,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 14,
   "firman": "Tetapi Yesus berkata kepadanya: \"Saudara, siapakah yang telah mengangkat Aku menjadi hakim atau pengantara atas kamu?\""
 },
 {
   "id": 25484,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 15,
   "firman": "Kata-Nya lagi kepada mereka: \"Berjaga-jagalah dan waspadalah terhadap segala ketamakan, sebab walaupun seorang berlimpah-limpah hartanya, hidupnya tidaklah tergantung dari pada kekayaannya itu.\""
 },
 {
   "id": 25485,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 16,
   "firman": "Kemudian Ia mengatakan kepada mereka suatu perumpamaan, kata-Nya: \"Ada seorang kaya, tanahnya berlimpah-limpah hasilnya."
 },
 {
   "id": 25486,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 17,
   "firman": "Ia bertanya dalam hatinya: Apakah yang harus aku perbuat, sebab aku tidak mempunyai tempat di mana aku dapat menyimpan hasil tanahku."
 },
 {
   "id": 25487,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 18,
   "firman": "Lalu katanya: Inilah yang akan aku perbuat; aku akan merombak lumbung-lumbungku dan aku akan mendirikan yang lebih besar dan aku akan menyimpan di dalamnya segala gandum dan barang-barangku."
 },
 {
   "id": 25488,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 19,
   "firman": "Sesudah itu aku akan berkata kepada jiwaku: Jiwaku, ada padamu banyak barang, tertimbun untuk bertahun-tahun lamanya; beristirahatlah, makanlah, minumlah dan bersenang-senanglah!"
 },
 {
   "id": 25489,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 20,
   "firman": "Tetapi firman Allah kepadanya: Hai engkau orang bodoh, pada malam ini juga jiwamu akan diambil dari padamu, dan apa yang telah kausediakan, untuk siapakah itu nanti?"
 },
 {
   "id": 25490,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 21,
   "firman": "Demikianlah jadinya dengan orang yang mengumpulkan harta bagi dirinya sendiri, jikalau ia tidak kaya di hadapan Allah.\""
 },
 {
   "id": 25491,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 22,
   "firman": "Yesus berkata kepada murid-murid-Nya: \"Karena itu Aku berkata kepadamu: Janganlah kuatir akan hidupmu, akan apa yang hendak kamu makan, dan janganlah kuatir pula akan tubuhmu, akan apa yang hendak kamu pakai."
 },
 {
   "id": 25492,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 23,
   "firman": "Sebab hidup itu lebih penting dari pada makanan dan tubuh itu lebih penting dari pada pakaian."
 },
 {
   "id": 25493,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 24,
   "firman": "Perhatikanlah burung-burung gagak yang tidak menabur dan tidak menuai dan tidak mempunyai gudang atau lumbung, namun demikian diberi makan oleh Allah. Betapa jauhnya kamu melebihi burung-burung itu!"
 },
 {
   "id": 25494,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 25,
   "firman": "Siapakah di antara kamu yang karena kekuatirannya dapat menambahkan sehasta pada jalan hidupnya?"
 },
 {
   "id": 25495,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 26,
   "firman": "Jadi, jikalau kamu tidak sanggup membuat barang yang paling kecil, mengapa kamu kuatir akan hal-hal lain?"
 },
 {
   "id": 25496,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 27,
   "firman": "Perhatikanlah bunga bakung, yang tidak memintal dan tidak menenun, namun Aku berkata kepadamu: Salomo dalam segala kemegahannyapun tidak berpakaian seindah salah satu dari bunga itu."
 },
 {
   "id": 25497,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 28,
   "firman": "Jadi, jika rumput di ladang, yang hari ini ada dan besok dibuang ke dalam api demikian didandani Allah, terlebih lagi kamu, hai orang yang kurang percaya!"
 },
 {
   "id": 25498,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 29,
   "firman": "Jadi, janganlah kamu mempersoalkan apa yang akan kamu makan atau apa yang akan kamu minum dan janganlah cemas hatimu."
 },
 {
   "id": 25499,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 30,
   "firman": "Semua itu dicari bangsa-bangsa di dunia yang tidak mengenal Allah. Akan tetapi Bapamu tahu, bahwa kamu memang memerlukan semuanya itu."
 },
 {
   "id": 25500,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 31,
   "firman": "Tetapi carilah Kerajaan-Nya, maka semuanya itu akan ditambahkan juga kepadamu."
 },
 {
   "id": 25501,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 32,
   "firman": "Janganlah takut, hai kamu kawanan kecil! Karena Bapamu telah berkenan memberikan kamu Kerajaan itu."
 },
 {
   "id": 25502,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 33,
   "firman": "Juallah segala milikmu dan berikanlah sedekah! Buatlah bagimu pundi-pundi yang tidak dapat menjadi tua, suatu harta di sorga yang tidak akan habis, yang tidak dapat didekati pencuri dan yang tidak dirusakkan ngengat."
 },
 {
   "id": 25503,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 34,
   "firman": "Karena di mana hartamu berada, di situ juga hatimu berada.\""
 },
 {
   "id": 25504,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 35,
   "firman": "\"Hendaklah pinggangmu tetap berikat dan pelitamu tetap menyala."
 },
 {
   "id": 25505,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 36,
   "firman": "Dan hendaklah kamu sama seperti orang-orang yang menanti-nantikan tuannya yang pulang dari perkawinan, supaya jika ia datang dan mengetok pintu, segera dibuka pintu baginya."
 },
 {
   "id": 25506,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 37,
   "firman": "Berbahagialah hamba-hamba yang didapati tuannya berjaga-jaga ketika ia datang. Aku berkata kepadamu: Sesungguhnya ia akan mengikat pinggangnya dan mempersilakan mereka duduk makan, dan ia akan datang melayani mereka."
 },
 {
   "id": 25507,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 38,
   "firman": "Dan apabila ia datang pada tengah malam atau pada dinihari dan mendapati mereka berlaku demikian, maka berbahagialah mereka."
 },
 {
   "id": 25508,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 39,
   "firman": "Tetapi ketahuilah ini: Jika tuan rumah tahu pukul berapa pencuri akan datang, ia tidak akan membiarkan rumahnya dibongkar."
 },
 {
   "id": 25509,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 40,
   "firman": "Hendaklah kamu juga siap sedia, karena Anak Manusia datang pada saat yang tidak kamu sangkakan.\""
 },
 {
   "id": 25510,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 41,
   "firman": "Kata Petrus: \"Tuhan, kamikah yang Engkau maksudkan dengan perumpamaan itu atau juga semua orang?\""
 },
 {
   "id": 25511,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 42,
   "firman": "Jawab Tuhan: \"Jadi, siapakah pengurus rumah yang setia dan bijaksana yang akan diangkat oleh tuannya menjadi kepala atas semua hambanya untuk memberikan makanan kepada mereka pada waktunya?"
 },
 {
   "id": 25512,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 43,
   "firman": "Berbahagialah hamba, yang didapati tuannya melakukan tugasnya itu, ketika tuannya itu datang."
 },
 {
   "id": 25513,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 44,
   "firman": "Aku berkata kepadamu: Sesungguhnya tuannya itu akan mengangkat dia menjadi pengawas segala miliknya."
 },
 {
   "id": 25514,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 45,
   "firman": "Akan tetapi, jikalau hamba itu jahat dan berkata di dalam hatinya: Tuanku tidak datang-datang, lalu ia mulai memukul hamba-hamba laki-laki dan hamba-hamba perempuan, dan makan minum dan mabuk,"
 },
 {
   "id": 25515,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 46,
   "firman": "maka tuan hamba itu akan datang pada hari yang tidak disangkakannya, dan pada saat yang tidak diketahuinya, dan akan membunuh dia dan membuat dia senasib dengan orang-orang yang tidak setia."
 },
 {
   "id": 25516,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 47,
   "firman": "Adapun hamba yang tahu akan kehendak tuannya, tetapi yang tidak mengadakan persiapan atau tidak melakukan apa yang dikehendaki tuannya, ia akan menerima banyak pukulan."
 },
 {
   "id": 25517,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 48,
   "firman": "Tetapi barangsiapa tidak tahu akan kehendak tuannya dan melakukan apa yang harus mendatangkan pukulan, ia akan menerima sedikit pukulan. Setiap orang yang kepadanya banyak diberi, dari padanya akan banyak dituntut, dan kepada siapa yang banyak dipercayakan, dari padanya akan lebih banyak lagi dituntut.\""
 },
 {
   "id": 25518,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 49,
   "firman": "\"Aku datang untuk melemparkan api ke bumi dan betapakah Aku harapkan, api itu telah menyala!"
 },
 {
   "id": 25519,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 50,
   "firman": "Aku harus menerima baptisan, dan betapakah susahnya hati-Ku, sebelum hal itu berlangsung!"
 },
 {
   "id": 25520,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 51,
   "firman": "Kamu menyangka, bahwa Aku datang untuk membawa damai di atas bumi? Bukan, kata-Ku kepadamu, bukan damai, melainkan pertentangan."
 },
 {
   "id": 25521,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 52,
   "firman": "Karena mulai dari sekarang akan ada pertentangan antara lima orang di dalam satu rumah, tiga melawan dua dan dua melawan tiga."
 },
 {
   "id": 25522,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 53,
   "firman": "Mereka akan saling bertentangan, ayah melawan anaknya laki-laki dan anak laki-laki melawan ayahnya, ibu melawan anaknya perempuan, dan anak perempuan melawan ibunya, ibu mertua melawan menantunya perempuan dan menantu perempuan melawan ibu mertuanya.\""
 },
 {
   "id": 25523,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 54,
   "firman": "Yesus berkata pula kepada orang banyak: \"Apabila kamu melihat awan naik di sebelah barat, segera kamu berkata: Akan datang hujan, dan hal itu memang terjadi."
 },
 {
   "id": 25524,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 55,
   "firman": "Dan apabila kamu melihat angin selatan bertiup, kamu berkata: Hari akan panas terik, dan hal itu memang terjadi."
 },
 {
   "id": 25525,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 56,
   "firman": "Hai orang-orang munafik, rupa bumi dan langit kamu tahu menilainya, mengapakah kamu tidak dapat menilai zaman ini?"
 },
 {
   "id": 25526,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 57,
   "firman": "Dan mengapakah engkau juga tidak memutuskan sendiri apa yang benar?"
 },
 {
   "id": 25527,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 58,
   "firman": "Sebab, jikalau engkau dengan lawanmu pergi menghadap pemerintah, berusahalah berdamai dengan dia selama di tengah jalan, supaya jangan engkau diseretnya kepada hakim dan hakim menyerahkan engkau kepada pembantunya dan pembantu itu melemparkan engkau ke dalam penjara."
 },
 {
   "id": 25528,
   "kitab": "Luk",
   "pasal": 12,
   "ayat": 59,
   "firman": "Aku berkata kepadamu: Engkau tidak akan keluar dari sana, sebelum engkau membayar hutangmu sampai lunas.\""
 },
 {
   "id": 25529,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 1,
   "firman": "Pada waktu itu datanglah kepada Yesus beberapa orang membawa kabar tentang orang-orang Galilea, yang darahnya dicampurkan Pilatus dengan darah korban yang mereka persembahkan."
 },
 {
   "id": 25530,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 2,
   "firman": "Yesus menjawab mereka: \"Sangkamu orang-orang Galilea ini lebih besar dosanya dari pada dosa semua orang Galilea yang lain, karena mereka mengalami nasib itu?"
 },
 {
   "id": 25531,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 3,
   "firman": "Tidak! kata-Ku kepadamu. Tetapi jikalau kamu tidak bertobat, kamu semua akan binasa atas cara demikian."
 },
 {
   "id": 25532,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 4,
   "firman": "Atau sangkamu kedelapan belas orang, yang mati ditimpa menara dekat Siloam, lebih besar kesalahannya dari pada kesalahan semua orang lain yang diam di Yerusalem?"
 },
 {
   "id": 25533,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 5,
   "firman": "Tidak! kata-Ku kepadamu. Tetapi jikalau kamu tidak bertobat, kamu semua akan binasa atas cara demikian.\""
 },
 {
   "id": 25534,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 6,
   "firman": "Lalu Yesus mengatakan perumpamaan ini: \"Seorang mempunyai pohon ara yang tumbuh di kebun anggurnya, dan ia datang untuk mencari buah pada pohon itu, tetapi ia tidak menemukannya."
 },
 {
   "id": 25535,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 7,
   "firman": "Lalu ia berkata kepada pengurus kebun anggur itu: Sudah tiga tahun aku datang mencari buah pada pohon ara ini dan aku tidak menemukannya. Tebanglah pohon ini! Untuk apa ia hidup di tanah ini dengan percuma!"
 },
 {
   "id": 25536,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 8,
   "firman": "Jawab orang itu: Tuan, biarkanlah dia tumbuh tahun ini lagi, aku akan mencangkul tanah sekelilingnya dan memberi pupuk kepadanya,"
 },
 {
   "id": 25537,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 9,
   "firman": "mungkin tahun depan ia berbuah; jika tidak, tebanglah dia!\""
 },
 {
   "id": 25538,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 10,
   "firman": "Pada suatu kali Yesus sedang mengajar dalam salah satu rumah ibadat pada hari Sabat."
 },
 {
   "id": 25539,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 11,
   "firman": "Di situ ada seorang perempuan yang telah delapan belas tahun dirasuk roh sehingga ia sakit sampai bungkuk punggungnya dan tidak dapat berdiri lagi dengan tegak."
 },
 {
   "id": 25540,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 12,
   "firman": "Ketika Yesus melihat perempuan itu, Ia memanggil dia dan berkata kepadanya: \"Hai ibu, penyakitmu telah sembuh.\""
 },
 {
   "id": 25541,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 13,
   "firman": "Lalu Ia meletakkan tangan-Nya atas perempuan itu, dan seketika itu juga berdirilah perempuan itu, dan memuliakan Allah."
 },
 {
   "id": 25542,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tetapi kepala rumah ibadat gusar karena Yesus menyembuhkan orang pada hari Sabat, lalu ia berkata kepada orang banyak: \"Ada enam hari untuk bekerja. Karena itu datanglah pada salah satu hari itu untuk disembuhkan dan jangan pada hari Sabat.\""
 },
 {
   "id": 25543,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 15,
   "firman": "Tetapi Tuhan menjawab dia, kata-Nya: \"Hai orang-orang munafik, bukankah setiap orang di antaramu melepaskan lembunya atau keledainya pada hari Sabat dari kandangnya dan membawanya ke tempat minuman?"
 },
 {
   "id": 25544,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 16,
   "firman": "Bukankah perempuan ini, yang sudah delapan belas tahun diikat oleh Iblis, harus dilepaskan dari ikatannya itu, karena ia adalah keturunan Abraham?\""
 },
 {
   "id": 25545,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 17,
   "firman": "Dan waktu Ia berkata demikian, semua lawan-Nya merasa malu dan semua orang banyak bersukacita karena segala perkara mulia, yang telah dilakukan-Nya."
 },
 {
   "id": 25546,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 18,
   "firman": "Maka kata Yesus: \"Seumpama apakah hal Kerajaan Allah dan dengan apakah Aku akan mengumpamakannya?"
 },
 {
   "id": 25547,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 19,
   "firman": "Ia seumpama biji sesawi, yang diambil dan ditaburkan orang di kebunnya; biji itu tumbuh dan menjadi pohon dan burung-burung di udara bersarang pada cabang-cabangnya.\""
 },
 {
   "id": 25548,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 20,
   "firman": "Dan Ia berkata lagi: \"Dengan apakah Aku akan mengumpamakan Kerajaan Allah?"
 },
 {
   "id": 25549,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 21,
   "firman": "Ia seumpama ragi yang diambil seorang perempuan dan diadukkan ke dalam tepung terigu tiga sukat sampai khamir seluruhnya.\""
 },
 {
   "id": 25550,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 22,
   "firman": "Kemudian Yesus berjalan keliling dari kota ke kota dan dari desa ke desa sambil mengajar dan meneruskan perjalanan-Nya ke Yerusalem."
 },
 {
   "id": 25551,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 23,
   "firman": "Dan ada seorang yang berkata kepada-Nya: \"Tuhan, sedikit sajakah orang yang diselamatkan?\""
 },
 {
   "id": 25552,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 24,
   "firman": "Jawab Yesus kepada orang-orang di situ: \"Berjuanglah untuk masuk melalui pintu yang sesak itu! Sebab Aku berkata kepadamu: Banyak orang akan berusaha untuk masuk, tetapi tidak akan dapat."
 },
 {
   "id": 25553,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 25,
   "firman": "Jika tuan rumah telah bangkit dan telah menutup pintu, kamu akan berdiri di luar dan mengetok-ngetok pintu sambil berkata: Tuan, bukakanlah kami pintu! dan Ia akan menjawab dan berkata kepadamu: Aku tidak tahu dari mana kamu datang."
 },
 {
   "id": 25554,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 26,
   "firman": "Maka kamu akan berkata: Kami telah makan dan minum di hadapan-Mu dan Engkau telah mengajar di jalan-jalan kota kami."
 },
 {
   "id": 25555,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 27,
   "firman": "Tetapi Ia akan berkata kepadamu: Aku tidak tahu dari mana kamu datang, enyahlah dari hadapan-Ku, hai kamu sekalian yang melakukan kejahatan!"
 },
 {
   "id": 25556,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 28,
   "firman": "Di sanalah akan terdapat ratap dan kertak gigi, apabila kamu akan melihat Abraham dan Ishak dan Yakub dan semua nabi di dalam Kerajaan Allah, tetapi kamu sendiri dicampakkan ke luar."
 },
 {
   "id": 25557,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 29,
   "firman": "Dan orang akan datang dari Timur dan Barat dan dari Utara dan Selatan dan mereka akan duduk makan di dalam Kerajaan Allah."
 },
 {
   "id": 25558,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 30,
   "firman": "Dan sesungguhnya ada orang yang terakhir yang akan menjadi orang yang terdahulu dan ada orang yang terdahulu yang akan menjadi orang yang terakhir.\""
 },
 {
   "id": 25559,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 31,
   "firman": "Pada waktu itu datanglah beberapa orang Farisi dan berkata kepada Yesus: \"Pergilah, tinggalkanlah tempat ini, karena Herodes hendak membunuh Engkau.\""
 },
 {
   "id": 25560,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 32,
   "firman": "Jawab Yesus kepada mereka: \"Pergilah dan katakanlah kepada si serigala itu: Aku mengusir setan dan menyembuhkan orang, pada hari ini dan besok, dan pada hari yang ketiga Aku akan selesai."
 },
 {
   "id": 25561,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 33,
   "firman": "Tetapi hari ini dan besok dan lusa Aku harus meneruskan perjalanan-Ku, sebab tidaklah semestinya seorang nabi dibunuh kalau tidak di Yerusalem."
 },
 {
   "id": 25562,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 34,
   "firman": "Yerusalem, Yerusalem, engkau yang membunuh nabi-nabi dan melempari dengan batu orang-orang yang diutus kepadamu! Berkali-kali Aku rindu mengumpulkan anak-anakmu, sama seperti induk ayam mengumpulkan anak-anaknya di bawah sayapnya, tetapi kamu tidak mau."
 },
 {
   "id": 25563,
   "kitab": "Luk",
   "pasal": 13,
   "ayat": 35,
   "firman": "Sesungguhnya rumahmu ini akan ditinggalkan dan menjadi sunyi. Tetapi Aku berkata kepadamu: Kamu tidak akan melihat Aku lagi hingga pada saat kamu berkata: Diberkatilah Dia yang datang dalam nama Tuhan!\""
 },
 {
   "id": 25564,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 1,
   "firman": "Pada suatu hari Sabat Yesus datang ke rumah salah seorang pemimpin dari orang-orang Farisi untuk makan di situ. Semua yang hadir mengamat-amati Dia dengan saksama."
 },
 {
   "id": 25565,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 2,
   "firman": "Tiba-tiba datanglah seorang yang sakit busung air berdiri di hadapan-Nya."
 },
 {
   "id": 25566,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 3,
   "firman": "Lalu Yesus berkata kepada ahli-ahli Taurat dan orang-orang Farisi itu, kata-Nya: \"Diperbolehkankah menyembuhkan orang pada hari Sabat atau tidak?\""
 },
 {
   "id": 25567,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 4,
   "firman": "Mereka itu diam semuanya. Lalu Ia memegang tangan orang sakit itu dan menyembuhkannya dan menyuruhnya pergi."
 },
 {
   "id": 25568,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 5,
   "firman": "Kemudian Ia berkata kepada mereka: \"Siapakah di antara kamu yang tidak segera menarik ke luar anaknya atau lembunya kalau terperosok ke dalam sebuah sumur, meskipun pada hari Sabat?\""
 },
 {
   "id": 25569,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 6,
   "firman": "Mereka tidak sanggup membantah-Nya."
 },
 {
   "id": 25570,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 7,
   "firman": "Karena Yesus melihat, bahwa tamu-tamu berusaha menduduki tempat-tempat kehormatan, Ia mengatakan perumpamaan ini kepada mereka:"
 },
 {
   "id": 25571,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 8,
   "firman": "\"Kalau seorang mengundang engkau ke pesta perkawinan, janganlah duduk di tempat kehormatan, sebab mungkin orang itu telah mengundang seorang yang lebih terhormat dari padamu,"
 },
 {
   "id": 25572,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 9,
   "firman": "supaya orang itu, yang mengundang engkau dan dia, jangan datang dan berkata kepadamu: Berilah tempat ini kepada orang itu. Lalu engkau dengan malu harus pergi duduk di tempat yang paling rendah."
 },
 {
   "id": 25573,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 10,
   "firman": "Tetapi, apabila engkau diundang, pergilah duduk di tempat yang paling rendah. Mungkin tuan rumah akan datang dan berkata kepadamu: Sahabat, silakan duduk di depan. Dan dengan demikian engkau akan menerima hormat di depan mata semua tamu yang lain."
 },
 {
   "id": 25574,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 11,
   "firman": "Sebab barangsiapa meninggikan diri, ia akan direndahkan dan barangsiapa merendahkan diri, ia akan ditinggikan.\""
 },
 {
   "id": 25575,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 12,
   "firman": "Dan Yesus berkata juga kepada orang yang mengundang Dia: \"Apabila engkau mengadakan perjamuan siang atau perjamuan malam, janganlah engkau mengundang sahabat-sahabatmu atau saudara-saudaramu atau kaum keluargamu atau tetangga-tetanggamu yang kaya, karena mereka akan membalasnya dengan mengundang engkau pula dan dengan demikian engkau mendapat balasnya."
 },
 {
   "id": 25576,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 13,
   "firman": "Tetapi apabila engkau mengadakan perjamuan, undanglah orang-orang miskin, orang-orang cacat, orang-orang lumpuh dan orang-orang buta."
 },
 {
   "id": 25577,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 14,
   "firman": "Dan engkau akan berbahagia, karena mereka tidak mempunyai apa-apa untuk membalasnya kepadamu. Sebab engkau akan mendapat balasnya pada hari kebangkitan orang-orang benar.\""
 },
 {
   "id": 25578,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 15,
   "firman": "Mendengar itu berkatalah seorang dari tamu-tamu itu kepada Yesus: \"Berbahagialah orang yang akan dijamu dalam Kerajaan Allah.\""
 },
 {
   "id": 25579,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 16,
   "firman": "Tetapi Yesus berkata kepadanya: \"Ada seorang mengadakan perjamuan besar dan ia mengundang banyak orang."
 },
 {
   "id": 25580,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 17,
   "firman": "Menjelang perjamuan itu dimulai, ia menyuruh hambanya mengatakan kepada para undangan: Marilah, sebab segala sesuatu sudah siap."
 },
 {
   "id": 25581,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 18,
   "firman": "Tetapi mereka bersama-sama meminta maaf. Yang pertama berkata kepadanya: Aku telah membeli ladang dan aku harus pergi melihatnya; aku minta dimaafkan."
 },
 {
   "id": 25582,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 19,
   "firman": "Yang lain berkata: Aku telah membeli lima pasang lembu kebiri dan aku harus pergi mencobanya; aku minta dimaafkan."
 },
 {
   "id": 25583,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 20,
   "firman": "Yang lain lagi berkata: Aku baru kawin dan karena itu aku tidak dapat datang."
 },
 {
   "id": 25584,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 21,
   "firman": "Maka kembalilah hamba itu dan menyampaikan semuanya itu kepada tuannya. Lalu murkalah tuan rumah itu dan berkata kepada hambanya: Pergilah dengan segera ke segala jalan dan lorong kota dan bawalah ke mari orang-orang miskin dan orang-orang cacat dan orang-orang buta dan orang-orang lumpuh."
 },
 {
   "id": 25585,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 22,
   "firman": "Kemudian hamba itu melaporkan: Tuan, apa yang tuan perintahkan itu sudah dilaksanakan, tetapi sekalipun demikian masih ada tempat."
 },
 {
   "id": 25586,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 23,
   "firman": "Lalu kata tuan itu kepada hambanya: Pergilah ke semua jalan dan lintasan dan paksalah orang-orang, yang ada di situ, masuk, karena rumahku harus penuh."
 },
 {
   "id": 25587,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 24,
   "firman": "Sebab Aku berkata kepadamu: Tidak ada seorangpun dari orang-orang yang telah diundang itu akan menikmati jamuan-Ku.\""
 },
 {
   "id": 25588,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 25,
   "firman": "Pada suatu kali banyak orang berduyun-duyun mengikuti Yesus dalam perjalanan-Nya. Sambil berpaling Ia berkata kepada mereka:"
 },
 {
   "id": 25589,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 26,
   "firman": "\"Jikalau seorang datang kepada-Ku dan ia tidak membenci bapanya, ibunya, isterinya, anak-anaknya, saudara-saudaranya laki-laki atau perempuan, bahkan nyawanya sendiri, ia tidak dapat menjadi murid-Ku."
 },
 {
   "id": 25590,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 27,
   "firman": "Barangsiapa tidak memikul salibnya dan mengikut Aku, ia tidak dapat menjadi murid-Ku."
 },
 {
   "id": 25591,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 28,
   "firman": "Sebab siapakah di antara kamu yang kalau mau mendirikan sebuah menara tidak duduk dahulu membuat anggaran biayanya, kalau-kalau cukup uangnya untuk menyelesaikan pekerjaan itu?"
 },
 {
   "id": 25592,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 29,
   "firman": "Supaya jikalau ia sudah meletakkan dasarnya dan tidak dapat menyelesaikannya, jangan-jangan semua orang yang melihatnya, mengejek dia,"
 },
 {
   "id": 25593,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 30,
   "firman": "sambil berkata: Orang itu mulai mendirikan, tetapi ia tidak sanggup menyelesaikannya."
 },
 {
   "id": 25594,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 31,
   "firman": "Atau, raja manakah yang kalau mau pergi berperang melawan raja lain tidak duduk dahulu untuk mempertimbangkan, apakah dengan sepuluh ribu orang ia sanggup menghadapi lawan yang mendatanginya dengan dua puluh ribu orang?"
 },
 {
   "id": 25595,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 32,
   "firman": "Jikalau tidak, ia akan mengirim utusan selama musuh itu masih jauh untuk menanyakan syarat-syarat perdamaian."
 },
 {
   "id": 25596,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 33,
   "firman": "Demikian pulalah tiap-tiap orang di antara kamu, yang tidak melepaskan dirinya dari segala miliknya, tidak dapat menjadi murid-Ku."
 },
 {
   "id": 25597,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 34,
   "firman": "Garam memang baik, tetapi jika garam juga menjadi tawar, dengan apakah ia diasinkan?"
 },
 {
   "id": 25598,
   "kitab": "Luk",
   "pasal": 14,
   "ayat": 35,
   "firman": "Tidak ada lagi gunanya baik untuk ladang maupun untuk pupuk, dan orang membuangnya saja. Siapa mempunyai telinga untuk mendengar, hendaklah ia mendengar!\""
 },
 {
   "id": 25599,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 1,
   "firman": "Para pemungut cukai dan orang-orang berdosa biasanya datang kepada Yesus untuk mendengarkan Dia."
 },
 {
   "id": 25600,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 2,
   "firman": "Maka bersungut-sungutlah orang-orang Farisi dan ahli-ahli Taurat, katanya: \"Ia menerima orang-orang berdosa dan makan bersama-sama dengan mereka.\""
 },
 {
   "id": 25601,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 3,
   "firman": "Lalu Ia mengatakan perumpamaan ini kepada mereka:"
 },
 {
   "id": 25602,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 4,
   "firman": "\"Siapakah di antara kamu yang mempunyai seratus ekor domba, dan jikalau ia kehilangan seekor di antaranya, tidak meninggalkan yang sembilan puluh sembilan ekor di padang gurun dan pergi mencari yang sesat itu sampai ia menemukannya?"
 },
 {
   "id": 25603,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 5,
   "firman": "Dan kalau ia telah menemukannya, ia meletakkannya di atas bahunya dengan gembira,"
 },
 {
   "id": 25604,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 6,
   "firman": "dan setibanya di rumah ia memanggil sahabat-sahabat dan tetangga-tetangganya serta berkata kepada mereka: Bersukacitalah bersama-sama dengan aku, sebab dombaku yang hilang itu telah kutemukan."
 },
 {
   "id": 25605,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 7,
   "firman": "Aku berkata kepadamu: Demikian juga akan ada sukacita di sorga karena satu orang berdosa yang bertobat, lebih dari pada sukacita karena sembilan puluh sembilan orang benar yang tidak memerlukan pertobatan.\""
 },
 {
   "id": 25606,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 8,
   "firman": "\"Atau perempuan manakah yang mempunyai sepuluh dirham, dan jika ia kehilangan satu di antaranya, tidak menyalakan pelita dan menyapu rumah serta mencarinya dengan cermat sampai ia menemukannya?"
 },
 {
   "id": 25607,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 9,
   "firman": "Dan kalau ia telah menemukannya, ia memanggil sahabat-sahabat dan tetangga-tetangganya serta berkata: Bersukacitalah bersama-sama dengan aku, sebab dirhamku yang hilang itu telah kutemukan."
 },
 {
   "id": 25608,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 10,
   "firman": "Aku berkata kepadamu: Demikian juga akan ada sukacita pada malaikat-malaikat Allah karena satu orang berdosa yang bertobat.\""
 },
 {
   "id": 25609,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 11,
   "firman": "Yesus berkata lagi: \"Ada seorang mempunyai dua anak laki-laki."
 },
 {
   "id": 25610,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 12,
   "firman": "Kata yang bungsu kepada ayahnya: Bapa, berikanlah kepadaku bagian harta milik kita yang menjadi hakku. Lalu ayahnya membagi-bagikan harta kekayaan itu di antara mereka."
 },
 {
   "id": 25611,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 13,
   "firman": "Beberapa hari kemudian anak bungsu itu menjual seluruh bagiannya itu lalu pergi ke negeri yang jauh. Di sana ia memboroskan harta miliknya itu dengan hidup berfoya-foya."
 },
 {
   "id": 25612,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 14,
   "firman": "Setelah dihabiskannya semuanya, timbullah bencana kelaparan di dalam negeri itu dan iapun mulai melarat."
 },
 {
   "id": 25613,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 15,
   "firman": "Lalu ia pergi dan bekerja pada seorang majikan di negeri itu. Orang itu menyuruhnya ke ladang untuk menjaga babinya."
 },
 {
   "id": 25614,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 16,
   "firman": "Lalu ia ingin mengisi perutnya dengan ampas yang menjadi makanan babi itu, tetapi tidak seorangpun yang memberikannya kepadanya."
 },
 {
   "id": 25615,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 17,
   "firman": "Lalu ia menyadari keadaannya, katanya: Betapa banyaknya orang upahan bapaku yang berlimpah-limpah makanannya, tetapi aku di sini mati kelaparan."
 },
 {
   "id": 25616,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 18,
   "firman": "Aku akan bangkit dan pergi kepada bapaku dan berkata kepadanya: Bapa, aku telah berdosa terhadap sorga dan terhadap bapa,"
 },
 {
   "id": 25617,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 19,
   "firman": "aku tidak layak lagi disebutkan anak bapa; jadikanlah aku sebagai salah seorang upahan bapa."
 },
 {
   "id": 25618,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 20,
   "firman": "Maka bangkitlah ia dan pergi kepada bapanya. Ketika ia masih jauh, ayahnya telah melihatnya, lalu tergeraklah hatinya oleh belas kasihan. Ayahnya itu berlari mendapatkan dia lalu merangkul dan mencium dia."
 },
 {
   "id": 25619,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 21,
   "firman": "Kata anak itu kepadanya: Bapa, aku telah berdosa terhadap sorga dan terhadap bapa, aku tidak layak lagi disebutkan anak bapa."
 },
 {
   "id": 25620,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 22,
   "firman": "Tetapi ayah itu berkata kepada hamba-hambanya: Lekaslah bawa ke mari jubah yang terbaik, pakaikanlah itu kepadanya dan kenakanlah cincin pada jarinya dan sepatu pada kakinya."
 },
 {
   "id": 25621,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 23,
   "firman": "Dan ambillah anak lembu tambun itu, sembelihlah dia dan marilah kita makan dan bersukacita."
 },
 {
   "id": 25622,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 24,
   "firman": "Sebab anakku ini telah mati dan menjadi hidup kembali, ia telah hilang dan didapat kembali. Maka mulailah mereka bersukaria."
 },
 {
   "id": 25623,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 25,
   "firman": "Tetapi anaknya yang sulung berada di ladang dan ketika ia pulang dan dekat ke rumah, ia mendengar bunyi seruling dan nyanyian tari-tarian."
 },
 {
   "id": 25624,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 26,
   "firman": "Lalu ia memanggil salah seorang hamba dan bertanya kepadanya apa arti semuanya itu."
 },
 {
   "id": 25625,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 27,
   "firman": "Jawab hamba itu: Adikmu telah kembali dan ayahmu telah menyembelih anak lembu tambun, karena ia mendapatnya kembali dengan sehat."
 },
 {
   "id": 25626,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 28,
   "firman": "Maka marahlah anak sulung itu dan ia tidak mau masuk. Lalu ayahnya keluar dan berbicara dengan dia."
 },
 {
   "id": 25627,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 29,
   "firman": "Tetapi ia menjawab ayahnya, katanya: Telah bertahun-tahun aku melayani bapa dan belum pernah aku melanggar perintah bapa, tetapi kepadaku belum pernah bapa memberikan seekor anak kambing untuk bersukacita dengan sahabat-sahabatku."
 },
 {
   "id": 25628,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 30,
   "firman": "Tetapi baru saja datang anak bapa yang telah memboroskan harta kekayaan bapa bersama-sama dengan pelacur-pelacur, maka bapa menyembelih anak lembu tambun itu untuk dia."
 },
 {
   "id": 25629,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 31,
   "firman": "Kata ayahnya kepadanya: Anakku, engkau selalu bersama-sama dengan aku, dan segala kepunyaanku adalah kepunyaanmu."
 },
 {
   "id": 25630,
   "kitab": "Luk",
   "pasal": 15,
   "ayat": 32,
   "firman": "Kita patut bersukacita dan bergembira karena adikmu telah mati dan menjadi hidup kembali, ia telah hilang dan didapat kembali.\""
 },
 {
   "id": 25631,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 1,
   "firman": "Dan Yesus berkata kepada murid-murid-Nya: \"Ada seorang kaya yang mempunyai seorang bendahara. Kepadanya disampaikan tuduhan, bahwa bendahara itu menghamburkan miliknya."
 },
 {
   "id": 25632,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 2,
   "firman": "Lalu ia memanggil bendahara itu dan berkata kepadanya: Apakah yang kudengar tentang engkau? Berilah pertanggungan jawab atas urusanmu, sebab engkau tidak boleh lagi bekerja sebagai bendahara."
 },
 {
   "id": 25633,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 3,
   "firman": "Kata bendahara itu di dalam hatinya: Apakah yang harus aku perbuat? Tuanku memecat aku dari jabatanku sebagai bendahara. Mencangkul aku tidak dapat, mengemis aku malu."
 },
 {
   "id": 25634,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 4,
   "firman": "Aku tahu apa yang akan aku perbuat, supaya apabila aku dipecat dari jabatanku sebagai bendahara, ada orang yang akan menampung aku di rumah mereka."
 },
 {
   "id": 25635,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 5,
   "firman": "Lalu ia memanggil seorang demi seorang yang berhutang kepada tuannya. Katanya kepada yang pertama: Berapakah hutangmu kepada tuanku?"
 },
 {
   "id": 25636,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 6,
   "firman": "Jawab orang itu: Seratus tempayan minyak. Lalu katanya kepada orang itu: Inilah surat hutangmu, duduklah dan buat surat hutang lain sekarang juga: Lima puluh tempayan."
 },
 {
   "id": 25637,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 7,
   "firman": "Kemudian ia berkata kepada yang kedua: Dan berapakah hutangmu? Jawab orang itu: Seratus pikul gandum. Katanya kepada orang itu: Inilah surat hutangmu, buatlah surat hutang lain: Delapan puluh pikul."
 },
 {
   "id": 25638,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lalu tuan itu memuji bendahara yang tidak jujur itu, karena ia telah bertindak dengan cerdik. Sebab anak-anak dunia ini lebih cerdik terhadap sesamanya dari pada anak-anak terang."
 },
 {
   "id": 25639,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 9,
   "firman": "Dan Aku berkata kepadamu: Ikatlah persahabatan dengan mempergunakan Mamon yang tidak jujur, supaya jika Mamon itu tidak dapat menolong lagi, kamu diterima di dalam kemah abadi.\""
 },
 {
   "id": 25640,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 10,
   "firman": "\"Barangsiapa setia dalam perkara-perkara kecil, ia setia juga dalam perkara-perkara besar. Dan barangsiapa tidak benar dalam perkara-perkara kecil, ia tidak benar juga dalam perkara-perkara besar."
 },
 {
   "id": 25641,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 11,
   "firman": "Jadi, jikalau kamu tidak setia dalam hal Mamon yang tidak jujur, siapakah yang akan mempercayakan kepadamu harta yang sesungguhnya?"
 },
 {
   "id": 25642,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 12,
   "firman": "Dan jikalau kamu tidak setia dalam harta orang lain, siapakah yang akan menyerahkan hartamu sendiri kepadamu?"
 },
 {
   "id": 25643,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 13,
   "firman": "Seorang hamba tidak dapat mengabdi kepada dua tuan. Karena jika demikian ia akan membenci yang seorang dan mengasihi yang lain, atau ia akan setia kepada yang seorang dan tidak mengindahkan yang lain. Kamu tidak dapat mengabdi kepada Allah dan kepada Mamon.\""
 },
 {
   "id": 25644,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 14,
   "firman": "Semuanya itu didengar oleh orang-orang Farisi, hamba-hamba uang itu, dan mereka mencemoohkan Dia."
 },
 {
   "id": 25645,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu Ia berkata kepada mereka: \"Kamu membenarkan diri di hadapan orang, tetapi Allah mengetahui hatimu. Sebab apa yang dikagumi manusia, dibenci oleh Allah."
 },
 {
   "id": 25646,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 16,
   "firman": "Hukum Taurat dan kitab para nabi berlaku sampai kepada zaman Yohanes; dan sejak waktu itu Kerajaan Allah diberitakan dan setiap orang menggagahinya berebut memasukinya."
 },
 {
   "id": 25647,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 17,
   "firman": "Lebih mudah langit dan bumi lenyap dari pada satu titik dari hukum Taurat batal."
 },
 {
   "id": 25648,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 18,
   "firman": "Setiap orang yang menceraikan isterinya, lalu kawin dengan perempuan lain, ia berbuat zinah; dan barangsiapa kawin dengan perempuan yang diceraikan suaminya, ia berbuat zinah.\""
 },
 {
   "id": 25649,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 19,
   "firman": "\"Ada seorang kaya yang selalu berpakaian jubah ungu dan kain halus, dan setiap hari ia bersukaria dalam kemewahan."
 },
 {
   "id": 25650,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 20,
   "firman": "Dan ada seorang pengemis bernama Lazarus, badannya penuh dengan borok, berbaring dekat pintu rumah orang kaya itu,"
 },
 {
   "id": 25651,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 21,
   "firman": "dan ingin menghilangkan laparnya dengan apa yang jatuh dari meja orang kaya itu. Malahan anjing-anjing datang dan menjilat boroknya."
 },
 {
   "id": 25652,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 22,
   "firman": "Kemudian matilah orang miskin itu, lalu dibawa oleh malaikat-malaikat ke pangkuan Abraham."
 },
 {
   "id": 25653,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 23,
   "firman": "Orang kaya itu juga mati, lalu dikubur. Dan sementara ia menderita sengsara di alam maut ia memandang ke atas, dan dari jauh dilihatnya Abraham, dan Lazarus duduk di pangkuannya."
 },
 {
   "id": 25654,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 24,
   "firman": "Lalu ia berseru, katanya: Bapa Abraham, kasihanilah aku. Suruhlah Lazarus, supaya ia mencelupkan ujung jarinya ke dalam air dan menyejukkan lidahku, sebab aku sangat kesakitan dalam nyala api ini."
 },
 {
   "id": 25655,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 25,
   "firman": "Tetapi Abraham berkata: Anak, ingatlah, bahwa engkau telah menerima segala yang baik sewaktu hidupmu, sedangkan Lazarus segala yang buruk. Sekarang ia mendapat hiburan dan engkau sangat menderita."
 },
 {
   "id": 25656,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 26,
   "firman": "Selain dari pada itu di antara kami dan engkau terbentang jurang yang tak terseberangi, supaya mereka yang mau pergi dari sini kepadamu ataupun mereka yang mau datang dari situ kepada kami tidak dapat menyeberang."
 },
 {
   "id": 25657,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 27,
   "firman": "Kata orang itu: Kalau demikian, aku minta kepadamu, bapa, supaya engkau menyuruh dia ke rumah ayahku,"
 },
 {
   "id": 25658,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 28,
   "firman": "sebab masih ada lima orang saudaraku, supaya ia memperingati mereka dengan sungguh-sungguh, agar mereka jangan masuk kelak ke dalam tempat penderitaan ini."
 },
 {
   "id": 25659,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 29,
   "firman": "Tetapi kata Abraham: Ada pada mereka kesaksian Musa dan para nabi; baiklah mereka mendengarkan kesaksian itu."
 },
 {
   "id": 25660,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 30,
   "firman": "Jawab orang itu: Tidak, bapa Abraham, tetapi jika ada seorang yang datang dari antara orang mati kepada mereka, mereka akan bertobat."
 },
 {
   "id": 25661,
   "kitab": "Luk",
   "pasal": 16,
   "ayat": 31,
   "firman": "Kata Abraham kepadanya: Jika mereka tidak mendengarkan kesaksian Musa dan para nabi, mereka tidak juga akan mau diyakinkan, sekalipun oleh seorang yang bangkit dari antara orang mati.\""
 },
 {
   "id": 25662,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 1,
   "firman": "Yesus berkata kepada murid-murid-Nya: \"Tidak mungkin tidak akan ada penyesatan, tetapi celakalah orang yang mengadakannya."
 },
 {
   "id": 25663,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 2,
   "firman": "Adalah lebih baik baginya jika sebuah batu kilangan diikatkan pada lehernya, lalu ia dilemparkan ke dalam laut, dari pada menyesatkan salah satu dari orang-orang yang lemah ini."
 },
 {
   "id": 25664,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 3,
   "firman": "Jagalah dirimu! Jikalau saudaramu berbuat dosa, tegorlah dia, dan jikalau ia menyesal, ampunilah dia."
 },
 {
   "id": 25665,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 4,
   "firman": "Bahkan jikalau ia berbuat dosa terhadap engkau tujuh kali sehari dan tujuh kali ia kembali kepadamu dan berkata: Aku menyesal, engkau harus mengampuni dia.\""
 },
 {
   "id": 25666,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 5,
   "firman": "Lalu kata rasul-rasul itu kepada Tuhan: \"Tambahkanlah iman kami!\""
 },
 {
   "id": 25667,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 6,
   "firman": "Jawab Tuhan: \"Kalau sekiranya kamu mempunyai iman sebesar biji sesawi saja, kamu dapat berkata kepada pohon ara ini: Terbantunlah engkau dan tertanamlah di dalam laut, dan ia akan taat kepadamu.\""
 },
 {
   "id": 25668,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 7,
   "firman": "\"Siapa di antara kamu yang mempunyai seorang hamba yang membajak atau menggembalakan ternak baginya, akan berkata kepada hamba itu, setelah ia pulang dari ladang: Mari segera makan!"
 },
 {
   "id": 25669,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 8,
   "firman": "Bukankah sebaliknya ia akan berkata kepada hamba itu: Sediakanlah makananku. Ikatlah pinggangmu dan layanilah aku sampai selesai aku makan dan minum. Dan sesudah itu engkau boleh makan dan minum."
 },
 {
   "id": 25670,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 9,
   "firman": "Adakah ia berterima kasih kepada hamba itu, karena hamba itu telah melakukan apa yang ditugaskan kepadanya?"
 },
 {
   "id": 25671,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 10,
   "firman": "Demikian jugalah kamu. Apabila kamu telah melakukan segala sesuatu yang ditugaskan kepadamu, hendaklah kamu berkata: Kami adalah hamba-hamba yang tidak berguna; kami hanya melakukan apa yang kami harus lakukan.\""
 },
 {
   "id": 25672,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dalam perjalanan-Nya ke Yerusalem Yesus menyusur perbatasan Samaria dan Galilea."
 },
 {
   "id": 25673,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 12,
   "firman": "Ketika Ia memasuki suatu desa datanglah sepuluh orang kusta menemui Dia. Mereka tinggal berdiri agak jauh"
 },
 {
   "id": 25674,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 13,
   "firman": "dan berteriak: \"Yesus, Guru, kasihanilah kami!\""
 },
 {
   "id": 25675,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 14,
   "firman": "Lalu Ia memandang mereka dan berkata: \"Pergilah, perlihatkanlah dirimu kepada imam-imam.\" Dan sementara mereka di tengah jalan mereka menjadi tahir."
 },
 {
   "id": 25676,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 15,
   "firman": "Seorang dari mereka, ketika melihat bahwa ia telah sembuh, kembali sambil memuliakan Allah dengan suara nyaring,"
 },
 {
   "id": 25677,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 16,
   "firman": "lalu tersungkur di depan kaki Yesus dan mengucap syukur kepada-Nya. Orang itu adalah seorang Samaria."
 },
 {
   "id": 25678,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 17,
   "firman": "Lalu Yesus berkata: \"Bukankah kesepuluh orang tadi semuanya telah menjadi tahir? Di manakah yang sembilan orang itu?"
 },
 {
   "id": 25679,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 18,
   "firman": "Tidak adakah di antara mereka yang kembali untuk memuliakan Allah selain dari pada orang asing ini?\""
 },
 {
   "id": 25680,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 19,
   "firman": "Lalu Ia berkata kepada orang itu: \"Berdirilah dan pergilah, imanmu telah menyelamatkan engkau.\""
 },
 {
   "id": 25681,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 20,
   "firman": "Atas pertanyaan orang-orang Farisi, apabila Kerajaan Allah akan datang, Yesus menjawab, kata-Nya: \"Kerajaan Allah datang tanpa tanda-tanda lahiriah,"
 },
 {
   "id": 25682,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 21,
   "firman": "juga orang tidak dapat mengatakan: Lihat, ia ada di sini atau ia ada di sana! Sebab sesungguhnya Kerajaan Allah ada di antara kamu.\""
 },
 {
   "id": 25683,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 22,
   "firman": "Dan Ia berkata kepada murid-murid-Nya: \"Akan datang waktunya kamu ingin melihat satu dari pada hari-hari Anak Manusia itu dan kamu tidak akan melihatnya."
 },
 {
   "id": 25684,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 23,
   "firman": "Dan orang akan berkata kepadamu: Lihat, ia ada di sana; lihat, ia ada di sini! Jangan kamu pergi ke situ, jangan kamu ikut."
 },
 {
   "id": 25685,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 24,
   "firman": "Sebab sama seperti kilat memancar dari ujung langit yang satu ke ujung langit yang lain, demikian pulalah kelak halnya Anak Manusia pada hari kedatangan-Nya."
 },
 {
   "id": 25686,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 25,
   "firman": "Tetapi Ia harus menanggung banyak penderitaan dahulu dan ditolak oleh angkatan ini."
 },
 {
   "id": 25687,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 26,
   "firman": "Dan sama seperti terjadi pada zaman Nuh, demikian pulalah halnya kelak pada hari-hari Anak Manusia:"
 },
 {
   "id": 25688,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 27,
   "firman": "mereka makan dan minum, mereka kawin dan dikawinkan, sampai kepada hari Nuh masuk ke dalam bahtera, lalu datanglah air bah dan membinasakan mereka semua."
 },
 {
   "id": 25689,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 28,
   "firman": "Demikian juga seperti yang terjadi di zaman Lot: mereka makan dan minum, mereka membeli dan menjual, mereka menanam dan membangun."
 },
 {
   "id": 25690,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 29,
   "firman": "Tetapi pada hari Lot pergi keluar dari Sodom turunlah hujan api dan hujan belerang dari langit dan membinasakan mereka semua."
 },
 {
   "id": 25691,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 30,
   "firman": "Demikianlah halnya kelak pada hari, di mana Anak Manusia menyatakan diri-Nya."
 },
 {
   "id": 25692,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 31,
   "firman": "Barangsiapa pada hari itu sedang di peranginan di atas rumah dan barang-barangnya ada di dalam rumah, janganlah ia turun untuk mengambilnya, dan demikian juga orang yang sedang di ladang, janganlah ia kembali."
 },
 {
   "id": 25693,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 32,
   "firman": "Ingatlah akan isteri Lot!"
 },
 {
   "id": 25694,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 33,
   "firman": "Barangsiapa berusaha memelihara nyawanya, ia akan kehilangan nyawanya, dan barangsiapa kehilangan nyawanya, ia akan menyelamatkannya."
 },
 {
   "id": 25695,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 34,
   "firman": "Aku berkata kepadamu: Pada malam itu ada dua orang di atas satu tempat tidur, yang seorang akan dibawa dan yang lain akan ditinggalkan."
 },
 {
   "id": 25696,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 35,
   "firman": "Ada dua orang perempuan bersama-sama mengilang, yang seorang akan dibawa dan yang lain akan ditinggalkan.\""
 },
 {
   "id": 25697,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 36,
   "firman": "(Kalau ada dua orang di ladang, yang seorang akan dibawa dan yang lain akan ditinggalkan.)"
 },
 {
   "id": 25698,
   "kitab": "Luk",
   "pasal": 17,
   "ayat": 37,
   "firman": "Kata mereka kepada Yesus: \"Di mana, Tuhan?\" Kata-Nya kepada mereka: \"Di mana ada mayat, di situ berkerumun burung nasar.\""
 },
 {
   "id": 25699,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 1,
   "firman": "Yesus mengatakan suatu perumpamaan kepada mereka untuk menegaskan, bahwa mereka harus selalu berdoa dengan tidak jemu-jemu."
 },
 {
   "id": 25700,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 2,
   "firman": "Kata-Nya: \"Dalam sebuah kota ada seorang hakim yang tidak takut akan Allah dan tidak menghormati seorangpun."
 },
 {
   "id": 25701,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 3,
   "firman": "Dan di kota itu ada seorang janda yang selalu datang kepada hakim itu dan berkata: Belalah hakku terhadap lawanku."
 },
 {
   "id": 25702,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 4,
   "firman": "Beberapa waktu lamanya hakim itu menolak. Tetapi kemudian ia berkata dalam hatinya: Walaupun aku tidak takut akan Allah dan tidak menghormati seorangpun,"
 },
 {
   "id": 25703,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 5,
   "firman": "namun karena janda ini menyusahkan aku, baiklah aku membenarkan dia, supaya jangan terus saja ia datang dan akhirnya menyerang aku.\""
 },
 {
   "id": 25704,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 6,
   "firman": "Kata Tuhan: \"Camkanlah apa yang dikatakan hakim yang lalim itu!"
 },
 {
   "id": 25705,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 7,
   "firman": "Tidakkah Allah akan membenarkan orang-orang pilihan-Nya yang siang malam berseru kepada-Nya? Dan adakah Ia mengulur-ulur waktu sebelum menolong mereka?"
 },
 {
   "id": 25706,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 8,
   "firman": "Aku berkata kepadamu: Ia akan segera membenarkan mereka. Akan tetapi, jika Anak Manusia itu datang, adakah Ia mendapati iman di bumi?\""
 },
 {
   "id": 25707,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 9,
   "firman": "Dan kepada beberapa orang yang menganggap dirinya benar dan memandang rendah semua orang lain, Yesus mengatakan perumpamaan ini:"
 },
 {
   "id": 25708,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 10,
   "firman": "\"Ada dua orang pergi ke Bait Allah untuk berdoa; yang seorang adalah Farisi dan yang lain pemungut cukai."
 },
 {
   "id": 25709,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 11,
   "firman": "Orang Farisi itu berdiri dan berdoa dalam hatinya begini: Ya Allah, aku mengucap syukur kepada-Mu, karena aku tidak sama seperti semua orang lain, bukan perampok, bukan orang lalim, bukan pezinah dan bukan juga seperti pemungut cukai ini;"
 },
 {
   "id": 25710,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 12,
   "firman": "aku berpuasa dua kali seminggu, aku memberikan sepersepuluh dari segala penghasilanku."
 },
 {
   "id": 25711,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 13,
   "firman": "Tetapi pemungut cukai itu berdiri jauh-jauh, bahkan ia tidak berani menengadah ke langit, melainkan ia memukul diri dan berkata: Ya Allah, kasihanilah aku orang berdosa ini."
 },
 {
   "id": 25712,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 14,
   "firman": "Aku berkata kepadamu: Orang ini pulang ke rumahnya sebagai orang yang dibenarkan Allah dan orang lain itu tidak. Sebab barangsiapa meninggikan diri, ia akan direndahkan dan barangsiapa merendahkan diri, ia akan ditinggikan.\""
 },
 {
   "id": 25713,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 15,
   "firman": "Maka datanglah orang-orang membawa anak-anaknya yang kecil kepada Yesus, supaya Ia menjamah mereka. Melihat itu murid-murid-Nya memarahi orang-orang itu."
 },
 {
   "id": 25714,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 16,
   "firman": "Tetapi Yesus memanggil mereka dan berkata: \"Biarkanlah anak-anak itu datang kepada-Ku, dan jangan kamu menghalang-halangi mereka, sebab orang-orang yang seperti itulah yang empunya Kerajaan Allah."
 },
 {
   "id": 25715,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 17,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa tidak menyambut Kerajaan Allah seperti seorang anak kecil, ia tidak akan masuk ke dalamnya.\""
 },
 {
   "id": 25716,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 18,
   "firman": "Ada seorang pemimpin bertanya kepada Yesus, katanya: \"Guru yang baik, apa yang harus aku perbuat untuk memperoleh hidup yang kekal?\""
 },
 {
   "id": 25717,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 19,
   "firman": "Jawab Yesus: \"Mengapa kaukatakan Aku baik? Tak seorangpun yang baik selain dari pada Allah saja."
 },
 {
   "id": 25718,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 20,
   "firman": "Engkau tentu mengetahui segala perintah Allah: Jangan berzinah, jangan membunuh, jangan mencuri, jangan mengucapkan saksi dusta, hormatilah ayahmu dan ibumu.\""
 },
 {
   "id": 25719,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 21,
   "firman": "Kata orang itu: \"Semuanya itu telah kuturuti sejak masa mudaku.\""
 },
 {
   "id": 25720,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 22,
   "firman": "Mendengar itu Yesus berkata kepadanya: \"Masih tinggal satu hal lagi yang harus kaulakukan: juallah segala yang kaumiliki dan bagi-bagikanlah itu kepada orang-orang miskin, maka engkau akan beroleh harta di sorga, kemudian datanglah ke mari dan ikutlah Aku.\""
 },
 {
   "id": 25721,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 23,
   "firman": "Ketika orang itu mendengar perkataan itu, ia menjadi amat sedih, sebab ia sangat kaya."
 },
 {
   "id": 25722,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 24,
   "firman": "Lalu Yesus memandang dia dan berkata: \"Alangkah sukarnya orang yang beruang masuk ke dalam Kerajaan Allah."
 },
 {
   "id": 25723,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 25,
   "firman": "Sebab lebih mudah seekor unta masuk melalui lobang jarum dari pada seorang kaya masuk ke dalam Kerajaan Allah.\""
 },
 {
   "id": 25724,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 26,
   "firman": "Dan mereka yang mendengar itu berkata: \"Jika demikian, siapakah yang dapat diselamatkan?\""
 },
 {
   "id": 25725,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 27,
   "firman": "Kata Yesus: \"Apa yang tidak mungkin bagi manusia, mungkin bagi Allah.\""
 },
 {
   "id": 25726,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 28,
   "firman": "Petrus berkata: \"Kami ini telah meninggalkan segala kepunyaan kami dan mengikut Engkau.\""
 },
 {
   "id": 25727,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 29,
   "firman": "Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya setiap orang yang karena Kerajaan Allah meninggalkan rumahnya, isterinya atau saudaranya, orang tuanya atau anak-anaknya,"
 },
 {
   "id": 25728,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 30,
   "firman": "akan menerima kembali lipat ganda pada masa ini juga, dan pada zaman yang akan datang ia akan menerima hidup yang kekal.\""
 },
 {
   "id": 25729,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 31,
   "firman": "Yesus memanggil kedua belas murid-Nya, lalu berkata kepada mereka: \"Sekarang kita pergi ke Yerusalem dan segala sesuatu yang ditulis oleh para nabi mengenai Anak Manusia akan digenapi."
 },
 {
   "id": 25730,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 32,
   "firman": "Sebab Ia akan diserahkan kepada bangsa-bangsa yang tidak mengenal Allah, diolok-olokkan, dihina dan diludahi,"
 },
 {
   "id": 25731,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 33,
   "firman": "dan mereka menyesah dan membunuh Dia, dan pada hari ketiga Ia akan bangkit.\""
 },
 {
   "id": 25732,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 34,
   "firman": "Akan tetapi mereka sama sekali tidak mengerti semuanya itu; arti perkataan itu tersembunyi bagi mereka dan mereka tidak tahu apa yang dimaksudkan."
 },
 {
   "id": 25733,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 35,
   "firman": "Waktu Yesus hampir tiba di Yerikho, ada seorang buta yang duduk di pinggir jalan dan mengemis."
 },
 {
   "id": 25734,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 36,
   "firman": "Waktu orang itu mendengar orang banyak lewat, ia bertanya: \"Apa itu?\""
 },
 {
   "id": 25735,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 37,
   "firman": "Kata orang kepadanya: \"Yesus orang Nazaret lewat.\""
 },
 {
   "id": 25736,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 38,
   "firman": "Lalu ia berseru: \"Yesus, Anak Daud, kasihanilah aku!\""
 },
 {
   "id": 25737,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 39,
   "firman": "Maka mereka, yang berjalan di depan, menegor dia supaya ia diam. Namun semakin keras ia berseru: \"Anak Daud, kasihanilah aku!\""
 },
 {
   "id": 25738,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 40,
   "firman": "Lalu Yesus berhenti dan menyuruh membawa orang itu kepada-Nya. Dan ketika ia telah berada di dekat-Nya, Yesus bertanya kepadanya:"
 },
 {
   "id": 25739,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 41,
   "firman": "\"Apa yang kaukehendaki supaya Aku perbuat bagimu?\" Jawab orang itu: \"Tuhan, supaya aku dapat melihat!\""
 },
 {
   "id": 25740,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 42,
   "firman": "Lalu kata Yesus kepadanya: \"Melihatlah engkau, imanmu telah menyelamatkan engkau!\""
 },
 {
   "id": 25741,
   "kitab": "Luk",
   "pasal": 18,
   "ayat": 43,
   "firman": "Dan seketika itu juga melihatlah ia, lalu mengikuti Dia sambil memuliakan Allah. Seluruh rakyat melihat hal itu dan memuji-muji Allah."
 },
 {
   "id": 25742,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 1,
   "firman": "Yesus masuk ke kota Yerikho dan berjalan terus melintasi kota itu."
 },
 {
   "id": 25743,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 2,
   "firman": "Di situ ada seorang bernama Zakheus, kepala pemungut cukai, dan ia seorang yang kaya."
 },
 {
   "id": 25744,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 3,
   "firman": "Ia berusaha untuk melihat orang apakah Yesus itu, tetapi ia tidak berhasil karena orang banyak, sebab badannya pendek."
 },
 {
   "id": 25745,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 4,
   "firman": "Maka berlarilah ia mendahului orang banyak, lalu memanjat pohon ara untuk melihat Yesus, yang akan lewat di situ."
 },
 {
   "id": 25746,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ketika Yesus sampai ke tempat itu, Ia melihat ke atas dan berkata: \"Zakheus, segeralah turun, sebab hari ini Aku harus menumpang di rumahmu.\""
 },
 {
   "id": 25747,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 6,
   "firman": "Lalu Zakheus segera turun dan menerima Yesus dengan sukacita."
 },
 {
   "id": 25748,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 7,
   "firman": "Tetapi semua orang yang melihat hal itu bersungut-sungut, katanya: \"Ia menumpang di rumah orang berdosa.\""
 },
 {
   "id": 25749,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 8,
   "firman": "Tetapi Zakheus berdiri dan berkata kepada Tuhan: \"Tuhan, setengah dari milikku akan kuberikan kepada orang miskin dan sekiranya ada sesuatu yang kuperas dari seseorang akan kukembalikan empat kali lipat.\""
 },
 {
   "id": 25750,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 9,
   "firman": "Kata Yesus kepadanya: \"Hari ini telah terjadi keselamatan kepada rumah ini, karena orang inipun anak Abraham."
 },
 {
   "id": 25751,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 10,
   "firman": "Sebab Anak Manusia datang untuk mencari dan menyelamatkan yang hilang.\""
 },
 {
   "id": 25752,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 11,
   "firman": "Untuk mereka yang mendengarkan Dia di situ, Yesus melanjutkan perkataan-Nya dengan suatu perumpamaan, sebab Ia sudah dekat Yerusalem dan mereka menyangka, bahwa Kerajaan Allah akan segera kelihatan."
 },
 {
   "id": 25753,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 12,
   "firman": "Maka Ia berkata: \"Ada seorang bangsawan berangkat ke sebuah negeri yang jauh untuk dinobatkan menjadi raja di situ dan setelah itu baru kembali."
 },
 {
   "id": 25754,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 13,
   "firman": "Ia memanggil sepuluh orang hambanya dan memberikan sepuluh mina kepada mereka, katanya: Pakailah ini untuk berdagang sampai aku datang kembali."
 },
 {
   "id": 25755,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 14,
   "firman": "Akan tetapi orang-orang sebangsanya membenci dia, lalu mengirimkan utusan menyusul dia untuk mengatakan: Kami tidak mau orang ini menjadi raja atas kami."
 },
 {
   "id": 25756,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 15,
   "firman": "Dan terjadilah, ketika ia kembali, setelah ia dinobatkan menjadi raja, ia menyuruh memanggil hamba-hambanya, yang telah diberinya uang itu, untuk mengetahui berapa hasil dagang mereka masing-masing."
 },
 {
   "id": 25757,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 16,
   "firman": "Orang yang pertama datang dan berkata: Tuan, mina tuan yang satu itu telah menghasilkan sepuluh mina."
 },
 {
   "id": 25758,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 17,
   "firman": "Katanya kepada orang itu: Baik sekali perbuatanmu itu, hai hamba yang baik; engkau telah setia dalam perkara kecil, karena itu terimalah kekuasaan atas sepuluh kota."
 },
 {
   "id": 25759,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 18,
   "firman": "Datanglah yang kedua dan berkata: Tuan, mina tuan telah menghasilkan lima mina."
 },
 {
   "id": 25760,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 19,
   "firman": "Katanya kepada orang itu: Dan engkau, kuasailah lima kota."
 },
 {
   "id": 25761,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 20,
   "firman": "Dan hamba yang ketiga datang dan berkata: Tuan, inilah mina tuan, aku telah menyimpannya dalam sapu tangan."
 },
 {
   "id": 25762,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 21,
   "firman": "Sebab aku takut akan tuan, karena tuan adalah manusia yang keras; tuan mengambil apa yang tidak pernah tuan taruh dan tuan menuai apa yang tidak tuan tabur."
 },
 {
   "id": 25763,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 22,
   "firman": "Katanya kepada orang itu: Hai hamba yang jahat, aku akan menghakimi engkau menurut perkataanmu sendiri. Engkau sudah tahu bahwa aku adalah orang yang keras, yang mengambil apa yang tidak pernah aku taruh dan menuai apa yang tidak aku tabur."
 },
 {
   "id": 25764,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 23,
   "firman": "Jika demikian, mengapa uangku itu tidak kauberikan kepada orang yang menjalankan uang? Maka sekembaliku aku dapat mengambilnya serta dengan bunganya."
 },
 {
   "id": 25765,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 24,
   "firman": "Lalu katanya kepada orang-orang yang berdiri di situ: Ambillah mina yang satu itu dari padanya dan berikanlah kepada orang yang mempunyai sepuluh mina itu."
 },
 {
   "id": 25766,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 25,
   "firman": "Kata mereka kepadanya: Tuan, ia sudah mempunyai sepuluh mina."
 },
 {
   "id": 25767,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 26,
   "firman": "Jawabnya: Aku berkata kepadamu: Setiap orang yang mempunyai, kepadanya akan diberi, tetapi siapa yang tidak mempunyai, dari padanya akan diambil, juga apa yang ada padanya."
 },
 {
   "id": 25768,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 27,
   "firman": "Akan tetapi semua seteruku ini, yang tidak suka aku menjadi rajanya, bawalah mereka ke mari dan bunuhlah mereka di depan mataku.\""
 },
 {
   "id": 25769,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 28,
   "firman": "Dan setelah mengatakan semuanya itu Yesus mendahului mereka dan meneruskan perjalanan-Nya ke Yerusalem."
 },
 {
   "id": 25770,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 29,
   "firman": "Ketika Ia telah dekat Betfage dan Betania, yang terletak di gunung yang bernama Bukit Zaitun, Yesus menyuruh dua orang murid-Nya"
 },
 {
   "id": 25771,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 30,
   "firman": "dengan pesan: \"Pergilah ke kampung yang di depanmu itu: Pada waktu kamu masuk di situ, kamu akan mendapati seekor keledai muda tertambat, yang belum pernah ditunggangi orang. Lepaskanlah keledai itu dan bawalah ke mari."
 },
 {
   "id": 25772,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 31,
   "firman": "Dan jika ada orang bertanya kepadamu: Mengapa kamu melepaskannya? jawablah begini: Tuhan memerlukannya.\""
 },
 {
   "id": 25773,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 32,
   "firman": "Lalu pergilah mereka yang disuruh itu, dan mereka mendapati segala sesuatu seperti yang telah dikatakan Yesus."
 },
 {
   "id": 25774,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 33,
   "firman": "Ketika mereka melepaskan keledai itu, berkatalah orang yang empunya keledai itu: \"Mengapa kamu melepaskan keledai itu?\""
 },
 {
   "id": 25775,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 34,
   "firman": "Kata mereka: \"Tuhan memerlukannya.\""
 },
 {
   "id": 25776,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 35,
   "firman": "Mereka membawa keledai itu kepada Yesus, lalu mengalasinya dengan pakaian mereka dan menolong Yesus naik ke atasnya."
 },
 {
   "id": 25777,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 36,
   "firman": "Dan sementara Yesus mengendarai keledai itu mereka menghamparkan pakaiannya di jalan."
 },
 {
   "id": 25778,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 37,
   "firman": "Ketika Ia dekat Yerusalem, di tempat jalan menurun dari Bukit Zaitun, mulailah semua murid yang mengiringi Dia bergembira dan memuji Allah dengan suara nyaring oleh karena segala mujizat yang telah mereka lihat."
 },
 {
   "id": 25779,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 38,
   "firman": "Kata mereka: \"Diberkatilah Dia yang datang sebagai Raja dalam nama Tuhan, damai sejahtera di sorga dan kemuliaan di tempat yang mahatinggi!\""
 },
 {
   "id": 25780,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 39,
   "firman": "Beberapa orang Farisi yang turut dengan orang banyak itu berkata kepada Yesus: \"Guru, tegorlah murid-murid-Mu itu.\""
 },
 {
   "id": 25781,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 40,
   "firman": "Jawab-Nya: \"Aku berkata kepadamu: Jika mereka ini diam, maka batu ini akan berteriak.\""
 },
 {
   "id": 25782,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 41,
   "firman": "Dan ketika Yesus telah dekat dan melihat kota itu, Ia menangisinya,"
 },
 {
   "id": 25783,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 42,
   "firman": "kata-Nya: \"Wahai, betapa baiknya jika pada hari ini juga engkau mengerti apa yang perlu untuk damai sejahteramu! Tetapi sekarang hal itu tersembunyi bagi matamu."
 },
 {
   "id": 25784,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 43,
   "firman": "Sebab akan datang harinya, bahwa musuhmu akan mengelilingi engkau dengan kubu, lalu mengepung engkau dan menghimpit engkau dari segala jurusan,"
 },
 {
   "id": 25785,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 44,
   "firman": "dan mereka akan membinasakan engkau beserta dengan pendudukmu dan pada tembokmu mereka tidak akan membiarkan satu batupun tinggal terletak di atas batu yang lain, karena engkau tidak mengetahui saat, bilamana Allah melawat engkau.\""
 },
 {
   "id": 25786,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 45,
   "firman": "Lalu Yesus masuk ke Bait Allah dan mulailah Ia mengusir semua pedagang di situ,"
 },
 {
   "id": 25787,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 46,
   "firman": "kata-Nya kepada mereka: \"Ada tertulis: Rumah-Ku adalah rumah doa. Tetapi kamu menjadikannya sarang penyamun.\""
 },
 {
   "id": 25788,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 47,
   "firman": "Tiap-tiap hari Ia mengajar di dalam Bait Allah. Imam-imam kepala dan ahli-ahli Taurat serta orang-orang terkemuka dari bangsa Israel berusaha untuk membinasakan Dia,"
 },
 {
   "id": 25789,
   "kitab": "Luk",
   "pasal": 19,
   "ayat": 48,
   "firman": "tetapi mereka tidak tahu, bagaimana harus melakukannya, sebab seluruh rakyat terpikat kepada-Nya dan ingin mendengarkan Dia."
 },
 {
   "id": 25790,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada suatu hari ketika Yesus mengajar orang banyak di Bait Allah dan memberitakan Injil, datanglah imam-imam kepala dan ahli-ahli Taurat serta tua-tua ke situ,"
 },
 {
   "id": 25791,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 2,
   "firman": "dan mereka berkata kepada Yesus: \"Katakanlah kepada kami dengan kuasa manakah Engkau melakukan hal-hal itu, dan siapa yang memberikan kuasa itu kepada-Mu!\""
 },
 {
   "id": 25792,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 3,
   "firman": "Jawab Yesus kepada mereka: \"Aku juga akan mengajukan suatu pertanyaan kepada kamu. Katakanlah kepada-Ku:"
 },
 {
   "id": 25793,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 4,
   "firman": "Baptisan Yohanes itu, dari sorga atau dari manusia?\""
 },
 {
   "id": 25794,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 5,
   "firman": "Mereka mempertimbangkannya di antara mereka, dan berkata: \"Jikalau kita katakan: Dari sorga, Ia akan berkata: Mengapakah kamu tidak percaya kepadanya?"
 },
 {
   "id": 25795,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 6,
   "firman": "Tetapi jikalau kita katakan: Dari manusia, seluruh rakyat akan melempari kita dengan batu, sebab mereka yakin, bahwa Yohanes adalah seorang nabi.\""
 },
 {
   "id": 25796,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 7,
   "firman": "Lalu mereka menjawab, bahwa mereka tidak tahu dari mana baptisan itu."
 },
 {
   "id": 25797,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 8,
   "firman": "Maka kata Yesus kepada mereka: \"Jika demikian, Aku juga tidak mengatakan kepadamu dengan kuasa manakah Aku melakukan hal-hal itu.\""
 },
 {
   "id": 25798,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 9,
   "firman": "Lalu Yesus mengatakan perumpamaan ini kepada orang banyak: \"Seorang membuka kebun anggur; kemudian ia menyewakannya kepada penggarap-penggarap lalu berangkat ke negeri lain untuk waktu yang agak lama."
 },
 {
   "id": 25799,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 10,
   "firman": "Dan ketika sudah tiba musimnya, ia menyuruh seorang hamba kepada penggarap-penggarap itu, supaya mereka menyerahkan sebagian dari hasil kebun anggur itu kepadanya. Tetapi penggarap-penggarap itu memukul hamba itu dan menyuruhnya pulang dengan tangan hampa."
 },
 {
   "id": 25800,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 11,
   "firman": "Sesudah itu ia menyuruh seorang hamba yang lain, tetapi hamba itu juga dipukul dan dipermalukan oleh mereka, lalu disuruh pulang dengan tangan hampa."
 },
 {
   "id": 25801,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 12,
   "firman": "Selanjutnya ia menyuruh hamba yang ketiga, tetapi orang itu juga dilukai oleh mereka, lalu dilemparkan ke luar kebun itu."
 },
 {
   "id": 25802,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 13,
   "firman": "Maka kata tuan kebun anggur itu: Apakah yang harus kuperbuat? Aku akan menyuruh anakku yang kekasih; tentu ia mereka segani."
 },
 {
   "id": 25803,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 14,
   "firman": "Tetapi ketika penggarap-penggarap itu melihat anaknya itu, mereka berunding, katanya: Ia adalah ahli waris, mari kita bunuh dia, supaya warisan ini menjadi milik kita."
 },
 {
   "id": 25804,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 15,
   "firman": "Lalu mereka melemparkan dia ke luar kebun anggur itu dan membunuhnya. Sekarang apa yang akan dilakukan oleh tuan kebun anggur itu dengan mereka?"
 },
 {
   "id": 25805,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 16,
   "firman": "Ia akan datang dan membinasakan penggarap-penggarap itu, dan mempercayakan kebun anggur itu kepada orang-orang lain.\" Mendengar itu mereka berkata: \"Sekali-kali jangan!\""
 },
 {
   "id": 25806,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 17,
   "firman": "Tetapi Yesus memandang mereka dan berkata: \"Jika demikian apakah arti nas ini: Batu yang dibuang oleh tukang-tukang bangunan telah menjadi batu penjuru?"
 },
 {
   "id": 25807,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 18,
   "firman": "Barangsiapa jatuh ke atas batu itu, ia akan hancur, dan barangsiapa ditimpa batu itu, ia akan remuk.\""
 },
 {
   "id": 25808,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 19,
   "firman": "Lalu ahli-ahli Taurat dan imam-imam kepala berusaha menangkap Dia pada saat itu juga, sebab mereka tahu, bahwa merekalah yang dimaksudkan-Nya dengan perumpamaan itu, tetapi mereka takut kepada orang banyak."
 },
 {
   "id": 25809,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 20,
   "firman": "Ahli-ahli Taurat dan imam-imam kepala mengamat-amati Yesus. Mereka menyuruh kepada-Nya mata-mata yang berlaku seolah-olah orang jujur, supaya mereka dapat menjerat-Nya dengan suatu pertanyaan dan menyerahkan-Nya kepada wewenang dan kuasa wali negeri."
 },
 {
   "id": 25810,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 21,
   "firman": "Orang-orang itu mengajukan pertanyaan ini kepada-Nya: \"Guru, kami tahu, bahwa segala perkataan dan pengajaran-Mu benar dan Engkau tidak mencari muka, melainkan dengan jujur mengajar jalan Allah."
 },
 {
   "id": 25811,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 22,
   "firman": "Apakah kami diperbolehkan membayar pajak kepada Kaisar atau tidak?\""
 },
 {
   "id": 25812,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 23,
   "firman": "Tetapi Yesus mengetahui maksud mereka yang licik itu, lalu berkata kepada mereka:"
 },
 {
   "id": 25813,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 24,
   "firman": "\"Tunjukkanlah kepada-Ku suatu dinar; gambar dan tulisan siapakah ada padanya?\" Jawab mereka: \"Gambar dan tulisan Kaisar.\""
 },
 {
   "id": 25814,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 25,
   "firman": "Lalu kata Yesus kepada mereka: \"Kalau begitu berikanlah kepada Kaisar apa yang wajib kamu berikan kepada Kaisar dan kepada Allah apa yang wajib kamu berikan kepada Allah!\""
 },
 {
   "id": 25815,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 26,
   "firman": "Dan mereka tidak dapat menjerat Dia dalam perkataan-Nya di depan orang banyak. Mereka heran akan jawab-Nya itu dan mereka diam."
 },
 {
   "id": 25816,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 27,
   "firman": "Maka datanglah kepada Yesus beberapa orang Saduki, yang tidak mengakui adanya kebangkitan. Mereka bertanya kepada-Nya:"
 },
 {
   "id": 25817,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 28,
   "firman": "\"Guru, Musa menuliskan perintah ini untuk kita: Jika seorang, yang mempunyai saudara laki-laki, mati sedang isterinya masih ada, tetapi ia tidak meninggalkan anak, saudaranya harus kawin dengan isterinya itu dan membangkitkan keturunan bagi saudaranya itu."
 },
 {
   "id": 25818,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 29,
   "firman": "Adalah tujuh orang bersaudara. Yang pertama kawin dengan seorang perempuan lalu mati dengan tidak meninggalkan anak."
 },
 {
   "id": 25819,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 30,
   "firman": "Lalu perempuan itu dikawini oleh yang kedua,"
 },
 {
   "id": 25820,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 31,
   "firman": "dan oleh yang ketiga dan demikianlah berturut-turut oleh ketujuh saudara itu, mereka semuanya mati dengan tidak meninggalkan anak."
 },
 {
   "id": 25821,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 32,
   "firman": "Akhirnya perempuan itupun mati."
 },
 {
   "id": 25822,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 33,
   "firman": "Bagaimana sekarang dengan perempuan itu, siapakah di antara orang-orang itu yang menjadi suaminya pada hari kebangkitan? Sebab ketujuhnya telah beristerikan dia.\""
 },
 {
   "id": 25823,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 34,
   "firman": "Jawab Yesus kepada mereka: \"Orang-orang dunia ini kawin dan dikawinkan,"
 },
 {
   "id": 25824,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 35,
   "firman": "tetapi mereka yang dianggap layak untuk mendapat bagian dalam dunia yang lain itu dan dalam kebangkitan dari antara orang mati, tidak kawin dan tidak dikawinkan."
 },
 {
   "id": 25825,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 36,
   "firman": "Sebab mereka tidak dapat mati lagi; mereka sama seperti malaikat-malaikat dan mereka adalah anak-anak Allah, karena mereka telah dibangkitkan."
 },
 {
   "id": 25826,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 37,
   "firman": "Tentang bangkitnya orang-orang mati, Musa telah memberitahukannya dalam nas tentang semak duri, di mana Tuhan disebut Allah Abraham, Allah Ishak dan Allah Yakub."
 },
 {
   "id": 25827,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 38,
   "firman": "Ia bukan Allah orang mati, melainkan Allah orang hidup, sebab di hadapan Dia semua orang hidup.\""
 },
 {
   "id": 25828,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 39,
   "firman": "Mendengar itu beberapa ahli Taurat berkata: \"Guru, jawab-Mu itu tepat sekali.\""
 },
 {
   "id": 25829,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 40,
   "firman": "Sebab mereka tidak berani lagi menanyakan apa-apa kepada Yesus."
 },
 {
   "id": 25830,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 41,
   "firman": "Tetapi Yesus berkata kepada mereka: \"Bagaimana orang dapat mengatakan, bahwa Mesias adalah Anak Daud?"
 },
 {
   "id": 25831,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 42,
   "firman": "Sebab Daud sendiri berkata dalam kitab Mazmur: Tuhan telah berfirman kepada Tuanku: duduklah di sebelah kanan-Ku,"
 },
 {
   "id": 25832,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 43,
   "firman": "sampai Kubuat musuh-musuh-Mu menjadi tumpuan kaki-Mu."
 },
 {
   "id": 25833,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 44,
   "firman": "Jadi Daud menyebut Dia Tuannya, bagaimana mungkin Ia anaknya pula?\""
 },
 {
   "id": 25834,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 45,
   "firman": "Ketika semua orang banyak mendengarkan, Yesus berkata kepada murid-murid-Nya:"
 },
 {
   "id": 25835,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 46,
   "firman": "\"Waspadalah terhadap ahli-ahli Taurat yang suka berjalan-jalan memakai jubah panjang dan suka menerima penghormatan di pasar, yang suka duduk di tempat terdepan di rumah ibadat dan di tempat terhormat dalam perjamuan,"
 },
 {
   "id": 25836,
   "kitab": "Luk",
   "pasal": 20,
   "ayat": 47,
   "firman": "yang menelan rumah janda-janda dan yang mengelabui mata orang dengan doa yang panjang-panjang. Mereka itu pasti akan menerima hukuman yang lebih berat.\""
 },
 {
   "id": 25837,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 1,
   "firman": "Ketika Yesus mengangkat muka-Nya, Ia melihat orang-orang kaya memasukkan persembahan mereka ke dalam peti persembahan."
 },
 {
   "id": 25838,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 2,
   "firman": "Ia melihat juga seorang janda miskin memasukkan dua peser ke dalam peti itu."
 },
 {
   "id": 25839,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 3,
   "firman": "Lalu Ia berkata: \"Aku berkata kepadamu, sesungguhnya janda miskin ini memberi lebih banyak dari pada semua orang itu."
 },
 {
   "id": 25840,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 4,
   "firman": "Sebab mereka semua memberi persembahannya dari kelimpahannya, tetapi janda ini memberi dari kekurangannya, bahkan ia memberi seluruh nafkahnya.\""
 },
 {
   "id": 25841,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 5,
   "firman": "Ketika beberapa orang berbicara tentang Bait Allah dan mengagumi bangunan itu yang dihiasi dengan batu yang indah-indah dan dengan berbagai-bagai barang persembahan, berkatalah Yesus:"
 },
 {
   "id": 25842,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 6,
   "firman": "\"Apa yang kamu lihat di situ--akan datang harinya di mana tidak ada satu batupun akan dibiarkan terletak di atas batu yang lain; semuanya akan diruntuhkan.\""
 },
 {
   "id": 25843,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 7,
   "firman": "Dan murid-murid bertanya kepada Yesus, katanya: \"Guru, bilamanakah itu akan terjadi? Dan apakah tandanya, kalau itu akan terjadi?\""
 },
 {
   "id": 25844,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 8,
   "firman": "Jawab-Nya: \"Waspadalah, supaya kamu jangan disesatkan. Sebab banyak orang akan datang dengan memakai nama-Ku dan berkata: Akulah Dia, dan: Saatnya sudah dekat. Janganlah kamu mengikuti mereka."
 },
 {
   "id": 25845,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 9,
   "firman": "Dan apabila kamu mendengar tentang peperangan dan pemberontakan, janganlah kamu terkejut. Sebab semuanya itu harus terjadi dahulu, tetapi itu tidak berarti kesudahannya akan datang segera.\""
 },
 {
   "id": 25846,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 10,
   "firman": "Ia berkata kepada mereka: \"Bangsa akan bangkit melawan bangsa dan kerajaan melawan kerajaan,"
 },
 {
   "id": 25847,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 11,
   "firman": "dan akan terjadi gempa bumi yang dahsyat dan di berbagai tempat akan ada penyakit sampar dan kelaparan, dan akan terjadi juga hal-hal yang mengejutkan dan tanda-tanda yang dahsyat dari langit."
 },
 {
   "id": 25848,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 12,
   "firman": "Tetapi sebelum semuanya itu kamu akan ditangkap dan dianiaya; kamu akan diserahkan ke rumah-rumah ibadat dan penjara-penjara, dan kamu akan dihadapkan kepada raja-raja dan penguasa-penguasa oleh karena nama-Ku."
 },
 {
   "id": 25849,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 13,
   "firman": "Hal itu akan menjadi kesempatan bagimu untuk bersaksi."
 },
 {
   "id": 25850,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 14,
   "firman": "Sebab itu tetapkanlah di dalam hatimu, supaya kamu jangan memikirkan lebih dahulu pembelaanmu."
 },
 {
   "id": 25851,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 15,
   "firman": "Sebab Aku sendiri akan memberikan kepadamu kata-kata hikmat, sehingga kamu tidak dapat ditentang atau dibantah lawan-lawanmu."
 },
 {
   "id": 25852,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 16,
   "firman": "Dan kamu akan diserahkan juga oleh orang tuamu, saudara-saudaramu, kaum keluargamu dan sahabat-sahabatmu dan beberapa orang di antara kamu akan dibunuh"
 },
 {
   "id": 25853,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 17,
   "firman": "dan kamu akan dibenci semua orang oleh karena nama-Ku."
 },
 {
   "id": 25854,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 18,
   "firman": "Tetapi tidak sehelaipun dari rambut kepalamu akan hilang."
 },
 {
   "id": 25855,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 19,
   "firman": "Kalau kamu tetap bertahan, kamu akan memperoleh hidupmu.\""
 },
 {
   "id": 25856,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 20,
   "firman": "\"Apabila kamu melihat Yerusalem dikepung oleh tentara-tentara, ketahuilah, bahwa keruntuhannya sudah dekat."
 },
 {
   "id": 25857,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 21,
   "firman": "Pada waktu itu orang-orang yang berada di Yudea harus melarikan diri ke pegunungan, dan orang-orang yang berada di dalam kota harus mengungsi, dan orang-orang yang berada di pedusunan jangan masuk lagi ke dalam kota,"
 },
 {
   "id": 25858,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 22,
   "firman": "sebab itulah masa pembalasan di mana akan genap semua yang ada tertulis."
 },
 {
   "id": 25859,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 23,
   "firman": "Celakalah ibu-ibu yang sedang hamil atau yang menyusukan bayi pada masa itu! Sebab akan datang kesesakan yang dahsyat atas seluruh negeri dan murka atas bangsa ini,"
 },
 {
   "id": 25860,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 24,
   "firman": "dan mereka akan tewas oleh mata pedang dan dibawa sebagai tawanan ke segala bangsa, dan Yerusalem akan diinjak-injak oleh bangsa-bangsa yang tidak mengenal Allah, sampai genaplah zaman bangsa-bangsa itu.\""
 },
 {
   "id": 25861,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 25,
   "firman": "\"Dan akan ada tanda-tanda pada matahari dan bulan dan bintang-bintang, dan di bumi bangsa-bangsa akan takut dan bingung menghadapi deru dan gelora laut."
 },
 {
   "id": 25862,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 26,
   "firman": "Orang akan mati ketakutan karena kecemasan berhubung dengan segala apa yang menimpa bumi ini, sebab kuasa-kuasa langit akan goncang."
 },
 {
   "id": 25863,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 27,
   "firman": "Pada waktu itu orang akan melihat Anak Manusia datang dalam awan dengan segala kekuasaan dan kemuliaan-Nya."
 },
 {
   "id": 25864,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 28,
   "firman": "Apabila semuanya itu mulai terjadi, bangkitlah dan angkatlah mukamu, sebab penyelamatanmu sudah dekat.\""
 },
 {
   "id": 25865,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 29,
   "firman": "Lalu Yesus mengatakan perumpamaan ini kepada mereka: \"Perhatikanlah pohon ara atau pohon apa saja."
 },
 {
   "id": 25866,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 30,
   "firman": "Apabila kamu melihat pohon-pohon itu sudah bertunas, kamu tahu dengan sendirinya bahwa musim panas sudah dekat."
 },
 {
   "id": 25867,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 31,
   "firman": "Demikian juga, jika kamu melihat hal-hal itu terjadi, ketahuilah, bahwa Kerajaan Allah sudah dekat."
 },
 {
   "id": 25868,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 32,
   "firman": "Aku berkata kepadamu: Sesungguhnya angkatan ini tidak akan berlalu, sebelum semuanya terjadi."
 },
 {
   "id": 25869,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 33,
   "firman": "Langit dan bumi akan berlalu, tetapi perkataan-Ku tidak akan berlalu.\""
 },
 {
   "id": 25870,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 34,
   "firman": "\"Jagalah dirimu, supaya hatimu jangan sarat oleh pesta pora dan kemabukan serta kepentingan-kepentingan duniawi dan supaya hari Tuhan jangan dengan tiba-tiba jatuh ke atas dirimu seperti suatu jerat."
 },
 {
   "id": 25871,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 35,
   "firman": "Sebab ia akan menimpa semua penduduk bumi ini."
 },
 {
   "id": 25872,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 36,
   "firman": "Berjaga-jagalah senantiasa sambil berdoa, supaya kamu beroleh kekuatan untuk luput dari semua yang akan terjadi itu, dan supaya kamu tahan berdiri di hadapan Anak Manusia.\""
 },
 {
   "id": 25873,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 37,
   "firman": "Pada siang hari Yesus mengajar di Bait Allah dan pada malam hari Ia keluar dan bermalam di gunung yang bernama Bukit Zaitun."
 },
 {
   "id": 25874,
   "kitab": "Luk",
   "pasal": 21,
   "ayat": 38,
   "firman": "Dan pagi-pagi semua orang banyak datang kepada-Nya di dalam Bait Allah untuk mendengarkan Dia."
 },
 {
   "id": 25875,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 1,
   "firman": "Hari raya Roti Tidak Beragi, yang disebut Paskah, sudah dekat."
 },
 {
   "id": 25876,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 2,
   "firman": "Imam-imam kepala dan ahli-ahli Taurat mencari jalan, bagaimana mereka dapat membunuh Yesus, sebab mereka takut kepada orang banyak."
 },
 {
   "id": 25877,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 3,
   "firman": "Maka masuklah Iblis ke dalam Yudas, yang bernama Iskariot, seorang dari kedua belas murid itu."
 },
 {
   "id": 25878,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 4,
   "firman": "Lalu pergilah Yudas kepada imam-imam kepala dan kepala-kepala pengawal Bait Allah dan berunding dengan mereka, bagaimana ia dapat menyerahkan Yesus kepada mereka."
 },
 {
   "id": 25879,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 5,
   "firman": "Mereka sangat gembira dan bermupakat untuk memberikan sejumlah uang kepadanya."
 },
 {
   "id": 25880,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 6,
   "firman": "Ia menyetujuinya, dan mulai dari waktu itu ia mencari kesempatan yang baik untuk menyerahkan Yesus kepada mereka tanpa setahu orang banyak."
 },
 {
   "id": 25881,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 7,
   "firman": "Maka tibalah hari raya Roti Tidak Beragi, yaitu hari di mana orang harus menyembelih domba Paskah."
 },
 {
   "id": 25882,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 8,
   "firman": "Lalu Yesus menyuruh Petrus dan Yohanes, kata-Nya: \"Pergilah, persiapkanlah perjamuan Paskah bagi kita supaya kita makan.\""
 },
 {
   "id": 25883,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 9,
   "firman": "Kata mereka kepada-Nya: \"Di manakah Engkau kehendaki kami mempersiapkannya?\""
 },
 {
   "id": 25884,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 10,
   "firman": "Jawab-Nya: \"Apabila kamu masuk ke dalam kota, kamu akan bertemu dengan seorang yang membawa kendi berisi air. Ikutilah dia ke dalam rumah yang dimasukinya,"
 },
 {
   "id": 25885,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 11,
   "firman": "dan katakanlah kepada tuan rumah itu: Guru bertanya kepadamu: di manakah ruangan tempat Aku bersama-sama dengan murid-murid-Ku akan makan Paskah?"
 },
 {
   "id": 25886,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 12,
   "firman": "Lalu orang itu akan menunjukkan kepadamu sebuah ruangan atas yang besar yang sudah lengkap, di situlah kamu harus mempersiapkannya.\""
 },
 {
   "id": 25887,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 13,
   "firman": "Maka berangkatlah mereka dan mereka mendapati semua seperti yang dikatakan Yesus kepada mereka. Lalu mereka mempersiapkan Paskah."
 },
 {
   "id": 25888,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 14,
   "firman": "Ketika tiba saatnya, Yesus duduk makan bersama-sama dengan rasul-rasul-Nya."
 },
 {
   "id": 25889,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 15,
   "firman": "Kata-Nya kepada mereka: \"Aku sangat rindu makan Paskah ini bersama-sama dengan kamu, sebelum Aku menderita."
 },
 {
   "id": 25890,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 16,
   "firman": "Sebab Aku berkata kepadamu: Aku tidak akan memakannya lagi sampai ia beroleh kegenapannya dalam Kerajaan Allah.\""
 },
 {
   "id": 25891,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 17,
   "firman": "Kemudian Ia mengambil sebuah cawan, mengucap syukur, lalu berkata: \"Ambillah ini dan bagikanlah di antara kamu."
 },
 {
   "id": 25892,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 18,
   "firman": "Sebab Aku berkata kepada kamu: mulai dari sekarang ini Aku tidak akan minum lagi hasil pokok anggur sampai Kerajaan Allah telah datang.\""
 },
 {
   "id": 25893,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 19,
   "firman": "Lalu Ia mengambil roti, mengucap syukur, memecah-mecahkannya dan memberikannya kepada mereka, kata-Nya: \"Inilah tubuh-Ku yang diserahkan bagi kamu; perbuatlah ini menjadi peringatan akan Aku.\""
 },
 {
   "id": 25894,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 20,
   "firman": "Demikian juga dibuat-Nya dengan cawan sesudah makan; Ia berkata: \"Cawan ini adalah perjanjian baru oleh darah-Ku, yang ditumpahkan bagi kamu."
 },
 {
   "id": 25895,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 21,
   "firman": "Tetapi, lihat, tangan orang yang menyerahkan Aku, ada bersama dengan Aku di meja ini."
 },
 {
   "id": 25896,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 22,
   "firman": "Sebab Anak Manusia memang akan pergi seperti yang telah ditetapkan, akan tetapi, celakalah orang yang olehnya Ia diserahkan!\""
 },
 {
   "id": 25897,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 23,
   "firman": "Lalu mulailah mereka mempersoalkan, siapa di antara mereka yang akan berbuat demikian."
 },
 {
   "id": 25898,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 24,
   "firman": "Terjadilah juga pertengkaran di antara murid-murid Yesus, siapakah yang dapat dianggap terbesar di antara mereka."
 },
 {
   "id": 25899,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 25,
   "firman": "Yesus berkata kepada mereka: \"Raja-raja bangsa-bangsa memerintah rakyat mereka dan orang-orang yang menjalankan kuasa atas mereka disebut pelindung-pelindung."
 },
 {
   "id": 25900,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 26,
   "firman": "Tetapi kamu tidaklah demikian, melainkan yang terbesar di antara kamu hendaklah menjadi sebagai yang paling muda dan pemimpin sebagai pelayan."
 },
 {
   "id": 25901,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 27,
   "firman": "Sebab siapakah yang lebih besar: yang duduk makan, atau yang melayani? Bukankah dia yang duduk makan? Tetapi Aku ada di tengah-tengah kamu sebagai pelayan."
 },
 {
   "id": 25902,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 28,
   "firman": "Kamulah yang tetap tinggal bersama-sama dengan Aku dalam segala pencobaan yang Aku alami."
 },
 {
   "id": 25903,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 29,
   "firman": "Dan Aku menentukan hak-hak Kerajaan bagi kamu, sama seperti Bapa-Ku menentukannya bagi-Ku,"
 },
 {
   "id": 25904,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 30,
   "firman": "bahwa kamu akan makan dan minum semeja dengan Aku di dalam Kerajaan-Ku dan kamu akan duduk di atas takhta untuk menghakimi kedua belas suku Israel."
 },
 {
   "id": 25905,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 31,
   "firman": "Simon, Simon, lihat, Iblis telah menuntut untuk menampi kamu seperti gandum,"
 },
 {
   "id": 25906,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 32,
   "firman": "tetapi Aku telah berdoa untuk engkau, supaya imanmu jangan gugur. Dan engkau, jikalau engkau sudah insaf, kuatkanlah saudara-saudaramu.\""
 },
 {
   "id": 25907,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 33,
   "firman": "Jawab Petrus: \"Tuhan, aku bersedia masuk penjara dan mati bersama-sama dengan Engkau!\""
 },
 {
   "id": 25908,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 34,
   "firman": "Tetapi Yesus berkata: \"Aku berkata kepadamu, Petrus, hari ini ayam tidak akan berkokok, sebelum engkau tiga kali menyangkal, bahwa engkau mengenal Aku.\""
 },
 {
   "id": 25909,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 35,
   "firman": "Lalu Ia berkata kepada mereka: \"Ketika Aku mengutus kamu dengan tiada membawa pundi-pundi, bekal dan kasut, adakah kamu kekurangan apa-apa?\""
 },
 {
   "id": 25910,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 36,
   "firman": "Jawab mereka: \"Suatupun tidak.\" Kata-Nya kepada mereka: \"Tetapi sekarang ini, siapa yang mempunyai pundi-pundi, hendaklah ia membawanya, demikian juga yang mempunyai bekal; dan siapa yang tidak mempunyainya hendaklah ia menjual jubahnya dan membeli pedang."
 },
 {
   "id": 25911,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 37,
   "firman": "Sebab Aku berkata kepada kamu, bahwa nas Kitab Suci ini harus digenapi pada-Ku: Ia akan terhitung di antara pemberontak-pemberontak. Sebab apa yang tertulis tentang Aku sedang digenapi.\""
 },
 {
   "id": 25912,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 38,
   "firman": "Kata mereka: \"Tuhan, ini dua pedang.\" Jawab-Nya: \"Sudah cukup.\""
 },
 {
   "id": 25913,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 39,
   "firman": "Lalu pergilah Yesus ke luar kota dan sebagaimana biasa Ia menuju Bukit Zaitun. Murid-murid-Nya juga mengikuti Dia."
 },
 {
   "id": 25914,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 40,
   "firman": "Setelah tiba di tempat itu Ia berkata kepada mereka: \"Berdoalah supaya kamu jangan jatuh ke dalam pencobaan.\""
 },
 {
   "id": 25915,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 41,
   "firman": "Kemudian Ia menjauhkan diri dari mereka kira-kira sepelempar batu jaraknya, lalu Ia berlutut dan berdoa, kata-Nya:"
 },
 {
   "id": 25916,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 42,
   "firman": "\"Ya Bapa-Ku, jikalau Engkau mau, ambillah cawan ini dari pada-Ku; tetapi bukanlah kehendak-Ku, melainkan kehendak-Mulah yang terjadi.\""
 },
 {
   "id": 25917,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 43,
   "firman": "Maka seorang malaikat dari langit menampakkan diri kepada-Nya untuk memberi kekuatan kepada-Nya."
 },
 {
   "id": 25918,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 44,
   "firman": "Ia sangat ketakutan dan makin bersungguh-sungguh berdoa. Peluh-Nya menjadi seperti titik-titik darah yang bertetesan ke tanah."
 },
 {
   "id": 25919,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 45,
   "firman": "Lalu Ia bangkit dari doa-Nya dan kembali kepada murid-murid-Nya, tetapi Ia mendapati mereka sedang tidur karena dukacita."
 },
 {
   "id": 25920,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 46,
   "firman": "Kata-Nya kepada mereka: \"Mengapa kamu tidur? Bangunlah dan berdoalah, supaya kamu jangan jatuh ke dalam pencobaan.\""
 },
 {
   "id": 25921,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 47,
   "firman": "Waktu Yesus masih berbicara datanglah serombongan orang, sedang murid-Nya yang bernama Yudas, seorang dari kedua belas murid itu, berjalan di depan mereka. Yudas mendekati Yesus untuk mencium-Nya."
 },
 {
   "id": 25922,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 48,
   "firman": "Maka kata Yesus kepadanya: \"Hai Yudas, engkau menyerahkan Anak Manusia dengan ciuman?\""
 },
 {
   "id": 25923,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 49,
   "firman": "Ketika mereka, yang bersama-sama dengan Yesus, melihat apa yang akan terjadi, berkatalah mereka: \"Tuhan, mestikah kami menyerang mereka dengan pedang?\""
 },
 {
   "id": 25924,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 50,
   "firman": "Dan seorang dari mereka menyerang hamba Imam Besar sehingga putus telinga kanannya."
 },
 {
   "id": 25925,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 51,
   "firman": "Tetapi Yesus berkata: \"Sudahlah itu.\" Lalu Ia menjamah telinga orang itu dan menyembuhkannya."
 },
 {
   "id": 25926,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 52,
   "firman": "Maka Yesus berkata kepada imam-imam kepala dan kepala-kepala pengawal Bait Allah serta tua-tua yang datang untuk menangkap Dia, kata-Nya: \"Sangkamu Aku ini penyamun, maka kamu datang lengkap dengan pedang dan pentung?"
 },
 {
   "id": 25927,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 53,
   "firman": "Padahal tiap-tiap hari Aku ada di tengah-tengah kamu di dalam Bait Allah, dan kamu tidak menangkap Aku. Tetapi inilah saat kamu, dan inilah kuasa kegelapan itu.\""
 },
 {
   "id": 25928,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 54,
   "firman": "Lalu Yesus ditangkap dan dibawa dari tempat itu. Ia digiring ke rumah Imam Besar. Dan Petrus mengikut dari jauh."
 },
 {
   "id": 25929,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 55,
   "firman": "Di tengah-tengah halaman rumah itu orang memasang api dan mereka duduk mengelilinginya. Petrus juga duduk di tengah-tengah mereka."
 },
 {
   "id": 25930,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 56,
   "firman": "Seorang hamba perempuan melihat dia duduk dekat api; ia mengamat-amatinya lalu berkata: \"Juga orang ini bersama-sama dengan Dia.\""
 },
 {
   "id": 25931,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 57,
   "firman": "Tetapi Petrus menyangkal, katanya: \"Bukan, aku tidak kenal Dia!\""
 },
 {
   "id": 25932,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 58,
   "firman": "Tidak berapa lama kemudian seorang lain melihat dia lalu berkata: \"Engkau juga seorang dari mereka!\" Tetapi Petrus berkata: \"Bukan, aku tidak!\""
 },
 {
   "id": 25933,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 59,
   "firman": "Dan kira-kira sejam kemudian seorang lain berkata dengan tegas: \"Sungguh, orang ini juga bersama-sama dengan Dia, sebab ia juga orang Galilea.\""
 },
 {
   "id": 25934,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 60,
   "firman": "Tetapi Petrus berkata: \"Bukan, aku tidak tahu apa yang engkau katakan.\" Seketika itu juga, sementara ia berkata, berkokoklah ayam."
 },
 {
   "id": 25935,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 61,
   "firman": "Lalu berpalinglah Tuhan memandang Petrus. Maka teringatlah Petrus bahwa Tuhan telah berkata kepadanya: \"Sebelum ayam berkokok pada hari ini, engkau telah tiga kali menyangkal Aku.\""
 },
 {
   "id": 25936,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 62,
   "firman": "Lalu ia pergi ke luar dan menangis dengan sedihnya."
 },
 {
   "id": 25937,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 63,
   "firman": "Dan orang-orang yang menahan Yesus, mengolok-olokkan Dia dan memukuli-Nya."
 },
 {
   "id": 25938,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 64,
   "firman": "Mereka menutupi muka-Nya dan bertanya: \"Cobalah katakan siapakah yang memukul Engkau?\""
 },
 {
   "id": 25939,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 65,
   "firman": "Dan banyak lagi hujat yang diucapkan mereka kepada-Nya."
 },
 {
   "id": 25940,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 66,
   "firman": "Dan setelah hari siang berkumpullah sidang para tua-tua bangsa Yahudi dan imam-imam kepala dan ahli-ahli Taurat, lalu mereka menghadapkan Dia ke Mahkamah Agama mereka,"
 },
 {
   "id": 25941,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 67,
   "firman": "katanya: \"Jikalau Engkau adalah Mesias, katakanlah kepada kami.\" Jawab Yesus: \"Sekalipun Aku mengatakannya kepada kamu, namun kamu tidak akan percaya;"
 },
 {
   "id": 25942,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 68,
   "firman": "dan sekalipun Aku bertanya sesuatu kepada kamu, namun kamu tidak akan menjawab."
 },
 {
   "id": 25943,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 69,
   "firman": "Mulai sekarang Anak Manusia sudah duduk di sebelah kanan Allah Yang Mahakuasa.\""
 },
 {
   "id": 25944,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 70,
   "firman": "Kata mereka semua: \"Kalau begitu, Engkau ini Anak Allah?\" Jawab Yesus: \"Kamu sendiri mengatakan, bahwa Akulah Anak Allah.\""
 },
 {
   "id": 25945,
   "kitab": "Luk",
   "pasal": 22,
   "ayat": 71,
   "firman": "Lalu kata mereka: \"Untuk apa kita perlu kesaksian lagi? Kita ini telah mendengarnya dari mulut-Nya sendiri.\""
 },
 {
   "id": 25946,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 1,
   "firman": "Lalu bangkitlah seluruh sidang itu dan Yesus dibawa menghadap Pilatus."
 },
 {
   "id": 25947,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 2,
   "firman": "Di situ mereka mulai menuduh Dia, katanya: \"Telah kedapatan oleh kami, bahwa orang ini menyesatkan bangsa kami, dan melarang membayar pajak kepada Kaisar, dan tentang diri-Nya Ia mengatakan, bahwa Ia adalah Kristus, yaitu Raja.\""
 },
 {
   "id": 25948,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 3,
   "firman": "Pilatus bertanya kepada-Nya: \"Engkaukah raja orang Yahudi?\" Jawab Yesus: \"Engkau sendiri mengatakannya.\""
 },
 {
   "id": 25949,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 4,
   "firman": "Kata Pilatus kepada imam-imam kepala dan seluruh orang banyak itu: \"Aku tidak mendapati kesalahan apapun pada orang ini.\""
 },
 {
   "id": 25950,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 5,
   "firman": "Tetapi mereka makin kuat mendesak, katanya: \"Ia menghasut rakyat dengan ajaran-Nya di seluruh Yudea, Ia mulai di Galilea dan sudah sampai ke sini.\""
 },
 {
   "id": 25951,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 6,
   "firman": "Ketika Pilatus mendengar itu ia bertanya, apakah orang itu seorang Galilea."
 },
 {
   "id": 25952,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 7,
   "firman": "Dan ketika ia tahu, bahwa Yesus seorang dari wilayah Herodes, ia mengirim Dia menghadap Herodes, yang pada waktu itu ada juga di Yerusalem."
 },
 {
   "id": 25953,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 8,
   "firman": "Ketika Herodes melihat Yesus, ia sangat girang. Sebab sudah lama ia ingin melihat-Nya, karena ia sering mendengar tentang Dia, lagipula ia mengharapkan melihat bagaimana Yesus mengadakan suatu tanda."
 },
 {
   "id": 25954,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 9,
   "firman": "Ia mengajukan banyak pertanyaan kepada Yesus, tetapi Yesus tidak memberi jawaban apapun."
 },
 {
   "id": 25955,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 10,
   "firman": "Sementara itu imam-imam kepala dan ahli-ahli Taurat maju ke depan dan melontarkan tuduhan-tuduhan yang berat terhadap Dia."
 },
 {
   "id": 25956,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 11,
   "firman": "Maka mulailah Herodes dan pasukannya menista dan mengolok-olokkan Dia, ia mengenakan jubah kebesaran kepada-Nya lalu mengirim Dia kembali kepada Pilatus."
 },
 {
   "id": 25957,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 12,
   "firman": "Dan pada hari itu juga bersahabatlah Herodes dan Pilatus; sebelum itu mereka bermusuhan."
 },
 {
   "id": 25958,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 13,
   "firman": "Lalu Pilatus mengumpulkan imam-imam kepala dan pemimpin-pemimpin serta rakyat,"
 },
 {
   "id": 25959,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 14,
   "firman": "dan berkata kepada mereka: \"Kamu telah membawa orang ini kepadaku sebagai seorang yang menyesatkan rakyat. Kamu lihat sendiri bahwa aku telah memeriksa-Nya, dan dari kesalahan-kesalahan yang kamu tuduhkan kepada-Nya tidak ada yang kudapati pada-Nya."
 },
 {
   "id": 25960,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 15,
   "firman": "Dan Herodes juga tidak, sebab ia mengirimkan Dia kembali kepada kami. Sesungguhnya tidak ada suatu apapun yang dilakukan-Nya yang setimpal dengan hukuman mati."
 },
 {
   "id": 25961,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 16,
   "firman": "Jadi aku akan menghajar Dia, lalu melepaskan-Nya.\""
 },
 {
   "id": 25962,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 17,
   "firman": "(Sebab ia wajib melepaskan seorang bagi mereka pada hari raya itu.)"
 },
 {
   "id": 25963,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 18,
   "firman": "Tetapi mereka berteriak bersama-sama: \"Enyahkanlah Dia, lepaskanlah Barabas bagi kami!\""
 },
 {
   "id": 25964,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 19,
   "firman": "Barabas ini dimasukkan ke dalam penjara berhubung dengan suatu pemberontakan yang telah terjadi di dalam kota dan karena pembunuhan."
 },
 {
   "id": 25965,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 20,
   "firman": "Sekali lagi Pilatus berbicara dengan suara keras kepada mereka, karena ia ingin melepaskan Yesus."
 },
 {
   "id": 25966,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 21,
   "firman": "Tetapi mereka berteriak membalasnya, katanya: \"Salibkanlah Dia! Salibkanlah Dia!\""
 },
 {
   "id": 25967,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 22,
   "firman": "Kata Pilatus untuk ketiga kalinya kepada mereka: \"Kejahatan apa yang sebenarnya telah dilakukan orang ini? Tidak ada suatu kesalahanpun yang kudapati pada-Nya, yang setimpal dengan hukuman mati. Jadi aku akan menghajar Dia, lalu melepaskan-Nya.\""
 },
 {
   "id": 25968,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 23,
   "firman": "Tetapi dengan berteriak mereka mendesak dan menuntut, supaya Ia disalibkan, dan akhirnya mereka menang dengan teriak mereka."
 },
 {
   "id": 25969,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 24,
   "firman": "Lalu Pilatus memutuskan, supaya tuntutan mereka dikabulkan."
 },
 {
   "id": 25970,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 25,
   "firman": "Dan ia melepaskan orang yang dimasukkan ke dalam penjara karena pemberontakan dan pembunuhan itu sesuai dengan tuntutan mereka, tetapi Yesus diserahkannya kepada mereka untuk diperlakukan semau-maunya."
 },
 {
   "id": 25971,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 26,
   "firman": "Ketika mereka membawa Yesus, mereka menahan seorang yang bernama Simon dari Kirene, yang baru datang dari luar kota, lalu diletakkan salib itu di atas bahunya, supaya dipikulnya sambil mengikuti Yesus."
 },
 {
   "id": 25972,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 27,
   "firman": "Sejumlah besar orang mengikuti Dia; di antaranya banyak perempuan yang menangisi dan meratapi Dia."
 },
 {
   "id": 25973,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 28,
   "firman": "Yesus berpaling kepada mereka dan berkata: \"Hai puteri-puteri Yerusalem, janganlah kamu menangisi Aku, melainkan tangisilah dirimu sendiri dan anak-anakmu!"
 },
 {
   "id": 25974,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 29,
   "firman": "Sebab lihat, akan tiba masanya orang berkata: Berbahagialah perempuan mandul dan yang rahimnya tidak pernah melahirkan, dan yang susunya tidak pernah menyusui."
 },
 {
   "id": 25975,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 30,
   "firman": "Maka orang akan mulai berkata kepada gunung-gunung: Runtuhlah menimpa kami! dan kepada bukit-bukit: Timbunilah kami!"
 },
 {
   "id": 25976,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 31,
   "firman": "Sebab jikalau orang berbuat demikian dengan kayu hidup, apakah yang akan terjadi dengan kayu kering?\""
 },
 {
   "id": 25977,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 32,
   "firman": "Dan ada juga digiring dua orang lain, yaitu dua penjahat untuk dihukum mati bersama-sama dengan Dia."
 },
 {
   "id": 25978,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 33,
   "firman": "Ketika mereka sampai di tempat yang bernama Tengkorak, mereka menyalibkan Yesus di situ dan juga kedua orang penjahat itu, yang seorang di sebelah kanan-Nya dan yang lain di sebelah kiri-Nya."
 },
 {
   "id": 25979,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 34,
   "firman": "Yesus berkata: \"Ya Bapa, ampunilah mereka, sebab mereka tidak tahu apa yang mereka perbuat.\" Dan mereka membuang undi untuk membagi pakaian-Nya."
 },
 {
   "id": 25980,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 35,
   "firman": "Orang banyak berdiri di situ dan melihat semuanya. Pemimpin-pemimpin mengejek Dia, katanya: \"Orang lain Ia selamatkan, biarlah sekarang Ia menyelamatkan diri-Nya sendiri, jika Ia adalah Mesias, orang yang dipilih Allah.\""
 },
 {
   "id": 25981,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 36,
   "firman": "Juga prajurit-prajurit mengolok-olokkan Dia; mereka mengunjukkan anggur asam kepada-Nya"
 },
 {
   "id": 25982,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 37,
   "firman": "dan berkata: \"Jika Engkau adalah raja orang Yahudi, selamatkanlah diri-Mu!\""
 },
 {
   "id": 25983,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 38,
   "firman": "Ada juga tulisan di atas kepala-Nya: \"Inilah raja orang Yahudi\"."
 },
 {
   "id": 25984,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 39,
   "firman": "Seorang dari penjahat yang di gantung itu menghujat Dia, katanya: \"Bukankah Engkau adalah Kristus? Selamatkanlah diri-Mu dan kami!\""
 },
 {
   "id": 25985,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 40,
   "firman": "Tetapi yang seorang menegor dia, katanya: \"Tidakkah engkau takut, juga tidak kepada Allah, sedang engkau menerima hukuman yang sama?"
 },
 {
   "id": 25986,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 41,
   "firman": "Kita memang selayaknya dihukum, sebab kita menerima balasan yang setimpal dengan perbuatan kita, tetapi orang ini tidak berbuat sesuatu yang salah.\""
 },
 {
   "id": 25987,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 42,
   "firman": "Lalu ia berkata: \"Yesus, ingatlah akan aku, apabila Engkau datang sebagai Raja.\""
 },
 {
   "id": 25988,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 43,
   "firman": "Kata Yesus kepadanya: \"Aku berkata kepadamu, sesungguhnya hari ini juga engkau akan ada bersama-sama dengan Aku di dalam Firdaus.\""
 },
 {
   "id": 25989,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 44,
   "firman": "Ketika itu hari sudah kira-kira jam dua belas, lalu kegelapan meliputi seluruh daerah itu sampai jam tiga,"
 },
 {
   "id": 25990,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 45,
   "firman": "sebab matahari tidak bersinar. Dan tabir Bait Suci terbelah dua."
 },
 {
   "id": 25991,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 46,
   "firman": "Lalu Yesus berseru dengan suara nyaring: \"Ya Bapa, ke dalam tangan-Mu Kuserahkan nyawa-Ku.\" Dan sesudah berkata demikian Ia menyerahkan nyawa-Nya."
 },
 {
   "id": 25992,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 47,
   "firman": "Ketika kepala pasukan melihat apa yang terjadi, ia memuliakan Allah, katanya: \"Sungguh, orang ini adalah orang benar!\""
 },
 {
   "id": 25993,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 48,
   "firman": "Dan sesudah seluruh orang banyak, yang datang berkerumun di situ untuk tontonan itu, melihat apa yang terjadi itu, pulanglah mereka sambil memukul-mukul diri."
 },
 {
   "id": 25994,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 49,
   "firman": "Semua orang yang mengenal Yesus dari dekat, termasuk perempuan-perempuan yang mengikuti Dia dari Galilea, berdiri jauh-jauh dan melihat semuanya itu."
 },
 {
   "id": 25995,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 50,
   "firman": "Adalah seorang yang bernama Yusuf. Ia anggota Majelis Besar, dan seorang yang baik lagi benar."
 },
 {
   "id": 25996,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 51,
   "firman": "Ia tidak setuju dengan putusan dan tindakan Majelis itu. Ia berasal dari Arimatea, sebuah kota Yahudi dan ia menanti-nantikan Kerajaan Allah."
 },
 {
   "id": 25997,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 52,
   "firman": "Ia pergi menghadap Pilatus dan meminta mayat Yesus."
 },
 {
   "id": 25998,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 53,
   "firman": "Dan sesudah ia menurunkan mayat itu, ia mengapaninya dengan kain lenan, lalu membaringkannya di dalam kubur yang digali di dalam bukit batu, di mana belum pernah dibaringkan mayat."
 },
 {
   "id": 25999,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 54,
   "firman": "Hari itu adalah hari persiapan dan sabat hampir mulai."
 },
 {
   "id": 26000,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 55,
   "firman": "Dan perempuan-perempuan yang datang bersama-sama dengan Yesus dari Galilea, ikut serta dan mereka melihat kubur itu dan bagaimana mayat-Nya dibaringkan."
 },
 {
   "id": 26001,
   "kitab": "Luk",
   "pasal": 23,
   "ayat": 56,
   "firman": "Dan setelah pulang, mereka menyediakan rempah-rempah dan minyak mur."
 },
 {
   "id": 26003,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 1,
   "firman": "tetapi pagi-pagi benar pada hari pertama minggu itu mereka pergi ke kubur membawa rempah-rempah yang telah disediakan mereka."
 },
 {
   "id": 26004,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 2,
   "firman": "Mereka mendapati batu sudah terguling dari kubur itu,"
 },
 {
   "id": 26005,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 3,
   "firman": "dan setelah masuk mereka tidak menemukan mayat Tuhan Yesus."
 },
 {
   "id": 26006,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 4,
   "firman": "Sementara mereka berdiri termangu-mangu karena hal itu, tiba-tiba ada dua orang berdiri dekat mereka memakai pakaian yang berkilau-kilauan."
 },
 {
   "id": 26007,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 5,
   "firman": "Mereka sangat ketakutan dan menundukkan kepala, tetapi kedua orang itu berkata kepada mereka: \"Mengapa kamu mencari Dia yang hidup, di antara orang mati?"
 },
 {
   "id": 26008,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 6,
   "firman": "Ia tidak ada di sini, Ia telah bangkit. Ingatlah apa yang dikatakan-Nya kepada kamu, ketika Ia masih di Galilea,"
 },
 {
   "id": 26009,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 7,
   "firman": "yaitu bahwa Anak Manusia harus diserahkan ke tangan orang-orang berdosa dan disalibkan, dan akan bangkit pada hari yang ketiga.\""
 },
 {
   "id": 26010,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 8,
   "firman": "Maka teringatlah mereka akan perkataan Yesus itu."
 },
 {
   "id": 26011,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 9,
   "firman": "Dan setelah mereka kembali dari kubur, mereka menceriterakan semuanya itu kepada kesebelas murid dan kepada semua saudara yang lain."
 },
 {
   "id": 26012,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 10,
   "firman": "Perempuan-perempuan itu ialah Maria dari Magdala, dan Yohana, dan Maria ibu Yakobus. Dan perempuan-perempuan lain juga yang bersama-sama dengan mereka memberitahukannya kepada rasul-rasul."
 },
 {
   "id": 26013,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 11,
   "firman": "Tetapi bagi mereka perkataan-perkataan itu seakan-akan omong kosong dan mereka tidak percaya kepada perempuan-perempuan itu."
 },
 {
   "id": 26014,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 12,
   "firman": "Sungguhpun demikian Petrus bangun, lalu cepat-cepat pergi ke kubur itu. Ketika ia menjenguk ke dalam, ia melihat hanya kain kapan saja. Lalu ia pergi, dan ia bertanya dalam hatinya apa yang kiranya telah terjadi."
 },
 {
   "id": 26015,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 13,
   "firman": "Pada hari itu juga dua orang dari murid-murid Yesus pergi ke sebuah kampung bernama Emaus, yang terletak kira-kira tujuh mil jauhnya dari Yerusalem,"
 },
 {
   "id": 26016,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 14,
   "firman": "dan mereka bercakap-cakap tentang segala sesuatu yang telah terjadi."
 },
 {
   "id": 26017,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 15,
   "firman": "Ketika mereka sedang bercakap-cakap dan bertukar pikiran, datanglah Yesus sendiri mendekati mereka, lalu berjalan bersama-sama dengan mereka."
 },
 {
   "id": 26018,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 16,
   "firman": "Tetapi ada sesuatu yang menghalangi mata mereka, sehingga mereka tidak dapat mengenal Dia."
 },
 {
   "id": 26019,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 17,
   "firman": "Yesus berkata kepada mereka: \"Apakah yang kamu percakapkan sementara kamu berjalan?\" Maka berhentilah mereka dengan muka muram."
 },
 {
   "id": 26020,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 18,
   "firman": "Seorang dari mereka, namanya Kleopas, menjawab-Nya: \"Adakah Engkau satu-satunya orang asing di Yerusalem, yang tidak tahu apa yang terjadi di situ pada hari-hari belakangan ini?\""
 },
 {
   "id": 26021,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 19,
   "firman": "Kata-Nya kepada mereka: \"Apakah itu?\" Jawab mereka: \"Apa yang terjadi dengan Yesus orang Nazaret. Dia adalah seorang nabi, yang berkuasa dalam pekerjaan dan perkataan di hadapan Allah dan di depan seluruh bangsa kami."
 },
 {
   "id": 26022,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 20,
   "firman": "Tetapi imam-imam kepala dan pemimpin-pemimpin kami telah menyerahkan Dia untuk dihukum mati dan mereka telah menyalibkan-Nya."
 },
 {
   "id": 26023,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 21,
   "firman": "Padahal kami dahulu mengharapkan, bahwa Dialah yang datang untuk membebaskan bangsa Israel. Tetapi sementara itu telah lewat tiga hari, sejak semuanya itu terjadi."
 },
 {
   "id": 26024,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 22,
   "firman": "Tetapi beberapa perempuan dari kalangan kami telah mengejutkan kami: Pagi-pagi buta mereka telah pergi ke kubur,"
 },
 {
   "id": 26025,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 23,
   "firman": "dan tidak menemukan mayat-Nya. Lalu mereka datang dengan berita, bahwa telah kelihatan kepada mereka malaikat-malaikat, yang mengatakan, bahwa Ia hidup."
 },
 {
   "id": 26026,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 24,
   "firman": "Dan beberapa teman kami telah pergi ke kubur itu dan mendapati, bahwa memang benar yang dikatakan perempuan-perempuan itu, tetapi Dia tidak mereka lihat.\""
 },
 {
   "id": 26027,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 25,
   "firman": "Lalu Ia berkata kepada mereka: \"Hai kamu orang bodoh, betapa lambannya hatimu, sehingga kamu tidak percaya segala sesuatu, yang telah dikatakan para nabi!"
 },
 {
   "id": 26028,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 26,
   "firman": "Bukankah Mesias harus menderita semuanya itu untuk masuk ke dalam kemuliaan-Nya?\""
 },
 {
   "id": 26029,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 27,
   "firman": "Lalu Ia menjelaskan kepada mereka apa yang tertulis tentang Dia dalam seluruh Kitab Suci, mulai dari kitab-kitab Musa dan segala kitab nabi-nabi."
 },
 {
   "id": 26030,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 28,
   "firman": "Mereka mendekati kampung yang mereka tuju, lalu Ia berbuat seolah-olah hendak meneruskan perjalanan-Nya."
 },
 {
   "id": 26031,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 29,
   "firman": "Tetapi mereka sangat mendesak-Nya, katanya: \"Tinggallah bersama-sama dengan kami, sebab hari telah menjelang malam dan matahari hampir terbenam.\" Lalu masuklah Ia untuk tinggal bersama-sama dengan mereka."
 },
 {
   "id": 26032,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 30,
   "firman": "Waktu Ia duduk makan dengan mereka, Ia mengambil roti, mengucap berkat, lalu memecah-mecahkannya dan memberikannya kepada mereka."
 },
 {
   "id": 26033,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 31,
   "firman": "Ketika itu terbukalah mata mereka dan merekapun mengenal Dia, tetapi Ia lenyap dari tengah-tengah mereka."
 },
 {
   "id": 26034,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 32,
   "firman": "Kata mereka seorang kepada yang lain: \"Bukankah hati kita berkobar-kobar, ketika Ia berbicara dengan kita di tengah jalan dan ketika Ia menerangkan Kitab Suci kepada kita?\""
 },
 {
   "id": 26035,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 33,
   "firman": "Lalu bangunlah mereka dan terus kembali ke Yerusalem. Di situ mereka mendapati kesebelas murid itu. Mereka sedang berkumpul bersama-sama dengan teman-teman mereka."
 },
 {
   "id": 26036,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 34,
   "firman": "Kata mereka itu: \"Sesungguhnya Tuhan telah bangkit dan telah menampakkan diri kepada Simon.\""
 },
 {
   "id": 26037,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 35,
   "firman": "Lalu kedua orang itupun menceriterakan apa yang terjadi di tengah jalan dan bagaimana mereka mengenal Dia pada waktu Ia memecah-mecahkan roti."
 },
 {
   "id": 26038,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 36,
   "firman": "Dan sementara mereka bercakap-cakap tentang hal-hal itu, Yesus tiba-tiba berdiri di tengah-tengah mereka dan berkata kepada mereka: \"Damai sejahtera bagi kamu!\""
 },
 {
   "id": 26039,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 37,
   "firman": "Mereka terkejut dan takut dan menyangka bahwa mereka melihat hantu."
 },
 {
   "id": 26040,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 38,
   "firman": "Akan tetapi Ia berkata kepada mereka: \"Mengapa kamu terkejut dan apa sebabnya timbul keragu-raguan di dalam hati kamu?"
 },
 {
   "id": 26041,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 39,
   "firman": "Lihatlah tangan-Ku dan kaki-Ku: Aku sendirilah ini; rabalah Aku dan lihatlah, karena hantu tidak ada daging dan tulangnya, seperti yang kamu lihat ada pada-Ku.\""
 },
 {
   "id": 26042,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 40,
   "firman": "Sambil berkata demikian, Ia memperlihatkan tangan dan kaki-Nya kepada mereka."
 },
 {
   "id": 26043,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 41,
   "firman": "Dan ketika mereka belum percaya karena girangnya dan masih heran, berkatalah Ia kepada mereka: \"Adakah padamu makanan di sini?\""
 },
 {
   "id": 26044,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 42,
   "firman": "Lalu mereka memberikan kepada-Nya sepotong ikan goreng."
 },
 {
   "id": 26045,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 43,
   "firman": "Ia mengambilnya dan memakannya di depan mata mereka."
 },
 {
   "id": 26046,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 44,
   "firman": "Ia berkata kepada mereka: \"Inilah perkataan-Ku, yang telah Kukatakan kepadamu ketika Aku masih bersama-sama dengan kamu, yakni bahwa harus digenapi semua yang ada tertulis tentang Aku dalam kitab Taurat Musa dan kitab nabi-nabi dan kitab Mazmur.\""
 },
 {
   "id": 26047,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 45,
   "firman": "Lalu Ia membuka pikiran mereka, sehingga mereka mengerti Kitab Suci."
 },
 {
   "id": 26048,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 46,
   "firman": "Kata-Nya kepada mereka: \"Ada tertulis demikian: Mesias harus menderita dan bangkit dari antara orang mati pada hari yang ketiga,"
 },
 {
   "id": 26049,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 47,
   "firman": "dan lagi: dalam nama-Nya berita tentang pertobatan dan pengampunan dosa harus disampaikan kepada segala bangsa, mulai dari Yerusalem."
 },
 {
   "id": 26050,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 48,
   "firman": "Kamu adalah saksi dari semuanya ini."
 },
 {
   "id": 26051,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 49,
   "firman": "Dan Aku akan mengirim kepadamu apa yang dijanjikan Bapa-Ku. Tetapi kamu harus tinggal di dalam kota ini sampai kamu diperlengkapi dengan kekuasaan dari tempat tinggi.\""
 },
 {
   "id": 26052,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 50,
   "firman": "Lalu Yesus membawa mereka ke luar kota sampai dekat Betania. Di situ Ia mengangkat tangan-Nya dan memberkati mereka."
 },
 {
   "id": 26053,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 51,
   "firman": "Dan ketika Ia sedang memberkati mereka, Ia berpisah dari mereka dan terangkat ke sorga."
 },
 {
   "id": 26054,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 52,
   "firman": "Mereka sujud menyembah kepada-Nya, lalu mereka pulang ke Yerusalem dengan sangat bersukacita."
 },
 {
   "id": 26055,
   "kitab": "Luk",
   "pasal": 24,
   "ayat": 53,
   "firman": "Mereka senantiasa berada di dalam Bait Allah dan memuliakan Allah."
 },
 {
   "id": 26056,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada mulanya adalah Firman; Firman itu bersama-sama dengan Allah dan Firman itu adalah Allah."
 },
 {
   "id": 26057,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 2,
   "firman": "Ia pada mulanya bersama-sama dengan Allah."
 },
 {
   "id": 26058,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 3,
   "firman": "Segala sesuatu dijadikan oleh Dia dan tanpa Dia tidak ada suatupun yang telah jadi dari segala yang telah dijadikan."
 },
 {
   "id": 26059,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dalam Dia ada hidup dan hidup itu adalah terang manusia."
 },
 {
   "id": 26060,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 5,
   "firman": "Terang itu bercahaya di dalam kegelapan dan kegelapan itu tidak menguasainya."
 },
 {
   "id": 26061,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 6,
   "firman": "Datanglah seorang yang diutus Allah, namanya Yohanes;"
 },
 {
   "id": 26062,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 7,
   "firman": "ia datang sebagai saksi untuk memberi kesaksian tentang terang itu, supaya oleh dia semua orang menjadi percaya."
 },
 {
   "id": 26063,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 8,
   "firman": "Ia bukan terang itu, tetapi ia harus memberi kesaksian tentang terang itu."
 },
 {
   "id": 26064,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 9,
   "firman": "Terang yang sesungguhnya, yang menerangi setiap orang, sedang datang ke dalam dunia."
 },
 {
   "id": 26065,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 10,
   "firman": "Ia telah ada di dalam dunia dan dunia dijadikan oleh-Nya, tetapi dunia tidak mengenal-Nya."
 },
 {
   "id": 26066,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 11,
   "firman": "Ia datang kepada milik kepunyaan-Nya, tetapi orang-orang kepunyaan-Nya itu tidak menerima-Nya."
 },
 {
   "id": 26067,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi semua orang yang menerima-Nya diberi-Nya kuasa supaya menjadi anak-anak Allah, yaitu mereka yang percaya dalam nama-Nya;"
 },
 {
   "id": 26068,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 13,
   "firman": "orang-orang yang diperanakkan bukan dari darah atau dari daging, bukan pula secara jasmani oleh keinginan seorang laki-laki, melainkan dari Allah."
 },
 {
   "id": 26069,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 14,
   "firman": "Firman itu telah menjadi manusia, dan diam di antara kita, dan kita telah melihat kemuliaan-Nya, yaitu kemuliaan yang diberikan kepada-Nya sebagai Anak Tunggal Bapa, penuh kasih karunia dan kebenaran."
 },
 {
   "id": 26070,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 15,
   "firman": "Yohanes memberi kesaksian tentang Dia dan berseru, katanya: \"Inilah Dia, yang kumaksudkan ketika aku berkata: Kemudian dari padaku akan datang Dia yang telah mendahului aku, sebab Dia telah ada sebelum aku.\""
 },
 {
   "id": 26071,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 16,
   "firman": "Karena dari kepenuhan-Nya kita semua telah menerima kasih karunia demi kasih karunia;"
 },
 {
   "id": 26072,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 17,
   "firman": "sebab hukum Taurat diberikan oleh Musa, tetapi kasih karunia dan kebenaran datang oleh Yesus Kristus."
 },
 {
   "id": 26073,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 18,
   "firman": "Tidak seorangpun yang pernah melihat Allah; tetapi Anak Tunggal Allah, yang ada di pangkuan Bapa, Dialah yang menyatakan-Nya."
 },
 {
   "id": 26074,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 19,
   "firman": "Dan inilah kesaksian Yohanes ketika orang Yahudi dari Yerusalem mengutus beberapa imam dan orang-orang Lewi kepadanya untuk menanyakan dia: \"Siapakah engkau?\""
 },
 {
   "id": 26075,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ia mengaku dan tidak berdusta, katanya: \"Aku bukan Mesias.\""
 },
 {
   "id": 26076,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 21,
   "firman": "Lalu mereka bertanya kepadanya: \"Kalau begitu, siapakah engkau? Elia?\" Dan ia menjawab: \"Bukan!\" \"Engkaukah nabi yang akan datang?\" Dan ia menjawab: \"Bukan!\""
 },
 {
   "id": 26077,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 22,
   "firman": "Maka kata mereka kepadanya: \"Siapakah engkau? Sebab kami harus memberi jawab kepada mereka yang mengutus kami. Apakah katamu tentang dirimu sendiri?\""
 },
 {
   "id": 26078,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 23,
   "firman": "Jawabnya: \"Akulah suara orang yang berseru-seru di padang gurun: Luruskanlah jalan Tuhan! seperti yang telah dikatakan nabi Yesaya.\""
 },
 {
   "id": 26079,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 24,
   "firman": "Dan di antara orang-orang yang diutus itu ada beberapa orang Farisi."
 },
 {
   "id": 26080,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 25,
   "firman": "Mereka bertanya kepadanya, katanya: \"Mengapakah engkau membaptis, jikalau engkau bukan Mesias, bukan Elia, dan bukan nabi yang akan datang?\""
 },
 {
   "id": 26081,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 26,
   "firman": "Yohanes menjawab mereka, katanya: \"Aku membaptis dengan air; tetapi di tengah-tengah kamu berdiri Dia yang tidak kamu kenal,"
 },
 {
   "id": 26082,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 27,
   "firman": "yaitu Dia, yang datang kemudian dari padaku. Membuka tali kasut-Nyapun aku tidak layak.\""
 },
 {
   "id": 26083,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 28,
   "firman": "Hal itu terjadi di Betania yang di seberang sungai Yordan, di mana Yohanes membaptis."
 },
 {
   "id": 26084,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 29,
   "firman": "Pada keesokan harinya Yohanes melihat Yesus datang kepadanya dan ia berkata: \"Lihatlah Anak domba Allah, yang menghapus dosa dunia."
 },
 {
   "id": 26085,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 30,
   "firman": "Dialah yang kumaksud ketika kukatakan: Kemudian dari padaku akan datang seorang, yang telah mendahului aku, sebab Dia telah ada sebelum aku."
 },
 {
   "id": 26086,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 31,
   "firman": "Dan aku sendiripun mula-mula tidak mengenal Dia, tetapi untuk itulah aku datang dan membaptis dengan air, supaya Ia dinyatakan kepada Israel.\""
 },
 {
   "id": 26087,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 32,
   "firman": "Dan Yohanes memberi kesaksian, katanya: \"Aku telah melihat Roh turun dari langit seperti merpati, dan Ia tinggal di atas-Nya."
 },
 {
   "id": 26088,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 33,
   "firman": "Dan akupun tidak mengenal-Nya, tetapi Dia, yang mengutus aku untuk membaptis dengan air, telah berfirman kepadaku: Jikalau engkau melihat Roh itu turun ke atas seseorang dan tinggal di atas-Nya, Dialah itu yang akan membaptis dengan Roh Kudus."
 },
 {
   "id": 26089,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 34,
   "firman": "Dan aku telah melihat-Nya dan memberi kesaksian: Ia inilah Anak Allah.\""
 },
 {
   "id": 26090,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 35,
   "firman": "Pada keesokan harinya Yohanes berdiri di situ pula dengan dua orang muridnya."
 },
 {
   "id": 26091,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 36,
   "firman": "Dan ketika ia melihat Yesus lewat, ia berkata: \"Lihatlah Anak domba Allah!\""
 },
 {
   "id": 26092,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 37,
   "firman": "Kedua murid itu mendengar apa yang dikatakannya itu, lalu mereka pergi mengikut Yesus."
 },
 {
   "id": 26093,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 38,
   "firman": "Tetapi Yesus menoleh ke belakang. Ia melihat, bahwa mereka mengikut Dia lalu berkata kepada mereka: \"Apakah yang kamu cari?\" Kata mereka kepada-Nya: \"Rabi (artinya: Guru), di manakah Engkau tinggal?\""
 },
 {
   "id": 26094,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 39,
   "firman": "Ia berkata kepada mereka: \"Marilah dan kamu akan melihatnya.\" Merekapun datang dan melihat di mana Ia tinggal, dan hari itu mereka tinggal bersama-sama dengan Dia; waktu itu kira-kira pukul empat."
 },
 {
   "id": 26095,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 40,
   "firman": "Salah seorang dari keduanya yang mendengar perkataan Yohanes lalu mengikut Yesus adalah Andreas, saudara Simon Petrus."
 },
 {
   "id": 26096,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 41,
   "firman": "Andreas mula-mula bertemu dengan Simon, saudaranya, dan ia berkata kepadanya: \"Kami telah menemukan Mesias (artinya: Kristus).\""
 },
 {
   "id": 26097,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 42,
   "firman": "Ia membawanya kepada Yesus. Yesus memandang dia dan berkata: \"Engkau Simon, anak Yohanes, engkau akan dinamakan Kefas (artinya: Petrus).\""
 },
 {
   "id": 26098,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 43,
   "firman": "Pada keesokan harinya Yesus memutuskan untuk berangkat ke Galilea. Ia bertemu dengan Filipus, dan berkata kepadanya: \"Ikutlah Aku!\""
 },
 {
   "id": 26099,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 44,
   "firman": "Filipus itu berasal dari Betsaida, kota Andreas dan Petrus."
 },
 {
   "id": 26100,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 45,
   "firman": "Filipus bertemu dengan Natanael dan berkata kepadanya: \"Kami telah menemukan Dia, yang disebut oleh Musa dalam kitab Taurat dan oleh para nabi, yaitu Yesus, anak Yusuf dari Nazaret.\""
 },
 {
   "id": 26101,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 46,
   "firman": "Kata Natanael kepadanya: \"Mungkinkah sesuatu yang baik datang dari Nazaret?\""
 },
 {
   "id": 26102,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 47,
   "firman": "Kata Filipus kepadanya: \"Mari dan lihatlah!\" Yesus melihat Natanael datang kepada-Nya, lalu berkata tentang dia: \"Lihat, inilah seorang Israel sejati, tidak ada kepalsuan di dalamnya!\""
 },
 {
   "id": 26103,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 48,
   "firman": "Kata Natanael kepada-Nya: \"Bagaimana Engkau mengenal aku?\" Jawab Yesus kepadanya: \"Sebelum Filipus memanggil engkau, Aku telah melihat engkau di bawah pohon ara.\""
 },
 {
   "id": 26104,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 49,
   "firman": "Kata Natanael kepada-Nya: \"Rabi, Engkau Anak Allah, Engkau Raja orang Israel!\""
 },
 {
   "id": 26105,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 50,
   "firman": "Yesus menjawab, kata-Nya: \"Karena Aku berkata kepadamu: Aku melihat engkau di bawah pohon ara, maka engkau percaya? Engkau akan melihat hal-hal yang lebih besar dari pada itu.\""
 },
 {
   "id": 26106,
   "kitab": "Yoh",
   "pasal": 1,
   "ayat": 51,
   "firman": "Lalu kata Yesus kepadanya: \"Aku berkata kepadamu, sesungguhnya engkau akan melihat langit terbuka dan malaikat-malaikat Allah turun naik kepada Anak Manusia.\""
 },
 {
   "id": 26107,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pada hari ketiga ada perkawinan di Kana yang di Galilea, dan ibu Yesus ada di situ;"
 },
 {
   "id": 26108,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 2,
   "firman": "Yesus dan murid-murid-Nya diundang juga ke perkawinan itu."
 },
 {
   "id": 26109,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 3,
   "firman": "Ketika mereka kekurangan anggur, ibu Yesus berkata kepada-Nya: \"Mereka kehabisan anggur.\""
 },
 {
   "id": 26110,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 4,
   "firman": "Kata Yesus kepadanya: \"Mau apakah engkau dari pada-Ku, ibu? Saat-Ku belum tiba.\""
 },
 {
   "id": 26111,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi ibu Yesus berkata kepada pelayan-pelayan: \"Apa yang dikatakan kepadamu, buatlah itu!\""
 },
 {
   "id": 26112,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 6,
   "firman": "Di situ ada enam tempayan yang disediakan untuk pembasuhan menurut adat orang Yahudi, masing-masing isinya dua tiga buyung."
 },
 {
   "id": 26113,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 7,
   "firman": "Yesus berkata kepada pelayan-pelayan itu: \"Isilah tempayan-tempayan itu penuh dengan air.\" Dan merekapun mengisinya sampai penuh."
 },
 {
   "id": 26114,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 8,
   "firman": "Lalu kata Yesus kepada mereka: \"Sekarang cedoklah dan bawalah kepada pemimpin pesta.\" Lalu merekapun membawanya."
 },
 {
   "id": 26115,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 9,
   "firman": "Setelah pemimpin pesta itu mengecap air, yang telah menjadi anggur itu--dan ia tidak tahu dari mana datangnya, tetapi pelayan-pelayan, yang mencedok air itu, mengetahuinya--ia memanggil mempelai laki-laki,"
 },
 {
   "id": 26116,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 10,
   "firman": "dan berkata kepadanya: \"Setiap orang menghidangkan anggur yang baik dahulu dan sesudah orang puas minum, barulah yang kurang baik; akan tetapi engkau menyimpan anggur yang baik sampai sekarang.\""
 },
 {
   "id": 26117,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 11,
   "firman": "Hal itu dibuat Yesus di Kana yang di Galilea, sebagai yang pertama dari tanda-tanda-Nya dan dengan itu Ia telah menyatakan kemuliaan-Nya, dan murid-murid-Nya percaya kepada-Nya."
 },
 {
   "id": 26118,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 12,
   "firman": "Sesudah itu Yesus pergi ke Kapernaum, bersama-sama dengan ibu-Nya dan saudara-saudara-Nya dan murid-murid-Nya, dan mereka tinggal di situ hanya beberapa hari saja."
 },
 {
   "id": 26119,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 13,
   "firman": "Ketika hari raya Paskah orang Yahudi sudah dekat, Yesus berangkat ke Yerusalem."
 },
 {
   "id": 26120,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 14,
   "firman": "Dalam Bait Suci didapati-Nya pedagang-pedagang lembu, kambing domba dan merpati, dan penukar-penukar uang duduk di situ."
 },
 {
   "id": 26121,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ia membuat cambuk dari tali lalu mengusir mereka semua dari Bait Suci dengan semua kambing domba dan lembu mereka; uang penukar-penukar dihamburkan-Nya ke tanah dan meja-meja mereka dibalikkan-Nya."
 },
 {
   "id": 26122,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 16,
   "firman": "Kepada pedagang-pedagang merpati Ia berkata: \"Ambil semuanya ini dari sini, jangan kamu membuat rumah Bapa-Ku menjadi tempat berjualan.\""
 },
 {
   "id": 26123,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 17,
   "firman": "Maka teringatlah murid-murid-Nya, bahwa ada tertulis: \"Cinta untuk rumah-Mu menghanguskan Aku.\""
 },
 {
   "id": 26124,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 18,
   "firman": "Orang-orang Yahudi menantang Yesus, katanya: \"Tanda apakah dapat Engkau tunjukkan kepada kami, bahwa Engkau berhak bertindak demikian?\""
 },
 {
   "id": 26125,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 19,
   "firman": "Jawab Yesus kepada mereka: \"Rombak Bait Allah ini, dan dalam tiga hari Aku akan mendirikannya kembali.\""
 },
 {
   "id": 26126,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 20,
   "firman": "Lalu kata orang Yahudi kepada-Nya: \"Empat puluh enam tahun orang mendirikan Bait Allah ini dan Engkau dapat membangunnya dalam tiga hari?\""
 },
 {
   "id": 26127,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 21,
   "firman": "Tetapi yang dimaksudkan-Nya dengan Bait Allah ialah tubuh-Nya sendiri."
 },
 {
   "id": 26128,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 22,
   "firman": "Kemudian, sesudah Ia bangkit dari antara orang mati, barulah teringat oleh murid-murid-Nya bahwa hal itu telah dikatakan-Nya, dan merekapun percayalah akan Kitab Suci dan akan perkataan yang telah diucapkan Yesus."
 },
 {
   "id": 26129,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 23,
   "firman": "Dan sementara Ia di Yerusalem selama hari raya Paskah, banyak orang percaya dalam nama-Nya, karena mereka telah melihat tanda-tanda yang diadakan-Nya."
 },
 {
   "id": 26130,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tetapi Yesus sendiri tidak mempercayakan diri-Nya kepada mereka, karena Ia mengenal mereka semua,"
 },
 {
   "id": 26131,
   "kitab": "Yoh",
   "pasal": 2,
   "ayat": 25,
   "firman": "dan karena tidak perlu seorangpun memberi kesaksian kepada-Nya tentang manusia, sebab Ia tahu apa yang ada di dalam hati manusia."
 },
 {
   "id": 26132,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 1,
   "firman": "Adalah seorang Farisi yang bernama Nikodemus, seorang pemimpin agama Yahudi."
 },
 {
   "id": 26133,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 2,
   "firman": "Ia datang pada waktu malam kepada Yesus dan berkata: \"Rabi, kami tahu, bahwa Engkau datang sebagai guru yang diutus Allah; sebab tidak ada seorangpun yang dapat mengadakan tanda-tanda yang Engkau adakan itu, jika Allah tidak menyertainya.\""
 },
 {
   "id": 26134,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 3,
   "firman": "Yesus menjawab, kata-Nya: \"Aku berkata kepadamu, sesungguhnya jika seorang tidak dilahirkan kembali, ia tidak dapat melihat Kerajaan Allah.\""
 },
 {
   "id": 26135,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 4,
   "firman": "Kata Nikodemus kepada-Nya: \"Bagaimanakah mungkin seorang dilahirkan, kalau ia sudah tua? Dapatkah ia masuk kembali ke dalam rahim ibunya dan dilahirkan lagi?\""
 },
 {
   "id": 26136,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 5,
   "firman": "Jawab Yesus: \"Aku berkata kepadamu, sesungguhnya jika seorang tidak dilahirkan dari air dan Roh, ia tidak dapat masuk ke dalam Kerajaan Allah."
 },
 {
   "id": 26137,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 6,
   "firman": "Apa yang dilahirkan dari daging, adalah daging, dan apa yang dilahirkan dari Roh, adalah roh."
 },
 {
   "id": 26138,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 7,
   "firman": "Janganlah engkau heran, karena Aku berkata kepadamu: Kamu harus dilahirkan kembali."
 },
 {
   "id": 26139,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 8,
   "firman": "Angin bertiup ke mana ia mau, dan engkau mendengar bunyinya, tetapi engkau tidak tahu dari mana ia datang atau ke mana ia pergi. Demikianlah halnya dengan tiap-tiap orang yang lahir dari Roh.\""
 },
 {
   "id": 26140,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 9,
   "firman": "Nikodemus menjawab, katanya: \"Bagaimanakah mungkin hal itu terjadi?\""
 },
 {
   "id": 26141,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 10,
   "firman": "Jawab Yesus: \"Engkau adalah pengajar Israel, dan engkau tidak mengerti hal-hal itu?"
 },
 {
   "id": 26142,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 11,
   "firman": "Aku berkata kepadamu, sesungguhnya kami berkata-kata tentang apa yang kami ketahui dan kami bersaksi tentang apa yang kami lihat, tetapi kamu tidak menerima kesaksian kami."
 },
 {
   "id": 26143,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 12,
   "firman": "Kamu tidak percaya, waktu Aku berkata-kata dengan kamu tentang hal-hal duniawi, bagaimana kamu akan percaya, kalau Aku berkata-kata dengan kamu tentang hal-hal sorgawi?"
 },
 {
   "id": 26144,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tidak ada seorangpun yang telah naik ke sorga, selain dari pada Dia yang telah turun dari sorga, yaitu Anak Manusia."
 },
 {
   "id": 26145,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan sama seperti Musa meninggikan ular di padang gurun, demikian juga Anak Manusia harus ditinggikan,"
 },
 {
   "id": 26146,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 15,
   "firman": "supaya setiap orang yang percaya kepada-Nya beroleh hidup yang kekal."
 },
 {
   "id": 26147,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 16,
   "firman": "Karena begitu besar kasih Allah akan dunia ini, sehingga Ia telah mengaruniakan Anak-Nya yang tunggal, supaya setiap orang yang percaya kepada-Nya tidak binasa, melainkan beroleh hidup yang kekal."
 },
 {
   "id": 26148,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sebab Allah mengutus Anak-Nya ke dalam dunia bukan untuk menghakimi dunia, melainkan untuk menyelamatkannya oleh Dia."
 },
 {
   "id": 26149,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 18,
   "firman": "Barangsiapa percaya kepada-Nya, ia tidak akan dihukum; barangsiapa tidak percaya, ia telah berada di bawah hukuman, sebab ia tidak percaya dalam nama Anak Tunggal Allah."
 },
 {
   "id": 26150,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 19,
   "firman": "Dan inilah hukuman itu: Terang telah datang ke dalam dunia, tetapi manusia lebih menyukai kegelapan dari pada terang, sebab perbuatan-perbuatan mereka jahat."
 },
 {
   "id": 26151,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 20,
   "firman": "Sebab barangsiapa berbuat jahat, membenci terang dan tidak datang kepada terang itu, supaya perbuatan-perbuatannya yang jahat itu tidak nampak;"
 },
 {
   "id": 26152,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 21,
   "firman": "tetapi barangsiapa melakukan yang benar, ia datang kepada terang, supaya menjadi nyata, bahwa perbuatan-perbuatannya dilakukan dalam Allah.\""
 },
 {
   "id": 26153,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 22,
   "firman": "Sesudah itu Yesus pergi dengan murid-murid-Nya ke tanah Yudea dan Ia diam di sana bersama-sama mereka dan membaptis."
 },
 {
   "id": 26154,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 23,
   "firman": "Akan tetapi Yohanespun membaptis juga di Ainon, dekat Salim, sebab di situ banyak air, dan orang-orang datang ke situ untuk dibaptis,"
 },
 {
   "id": 26155,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 24,
   "firman": "sebab pada waktu itu Yohanes belum dimasukkan ke dalam penjara."
 },
 {
   "id": 26156,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 25,
   "firman": "Maka timbullah perselisihan di antara murid-murid Yohanes dengan seorang Yahudi tentang penyucian."
 },
 {
   "id": 26157,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 26,
   "firman": "Lalu mereka datang kepada Yohanes dan berkata kepadanya: \"Rabi, orang yang bersama dengan engkau di seberang sungai Yordan dan yang tentang Dia engkau telah memberi kesaksian, Dia membaptis juga dan semua orang pergi kepada-Nya.\""
 },
 {
   "id": 26158,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 27,
   "firman": "Jawab Yohanes: \"Tidak ada seorangpun yang dapat mengambil sesuatu bagi dirinya, kalau tidak dikaruniakan kepadanya dari sorga."
 },
 {
   "id": 26159,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 28,
   "firman": "Kamu sendiri dapat memberi kesaksian, bahwa aku telah berkata: Aku bukan Mesias, tetapi aku diutus untuk mendahului-Nya."
 },
 {
   "id": 26160,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 29,
   "firman": "Yang empunya mempelai perempuan, ialah mempelai laki-laki; tetapi sahabat mempelai laki-laki, yang berdiri dekat dia dan yang mendengarkannya, sangat bersukacita mendengar suara mempelai laki-laki itu. Itulah sukacitaku, dan sekarang sukacitaku itu penuh."
 },
 {
   "id": 26161,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 30,
   "firman": "Ia harus makin besar, tetapi aku harus makin kecil."
 },
 {
   "id": 26162,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 31,
   "firman": "Siapa yang datang dari atas adalah di atas semuanya; siapa yang berasal dari bumi, termasuk pada bumi dan berkata-kata dalam bahasa bumi. Siapa yang datang dari sorga adalah di atas semuanya."
 },
 {
   "id": 26163,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 32,
   "firman": "Ia memberi kesaksian tentang apa yang dilihat-Nya dan yang didengar-Nya, tetapi tak seorangpun yang menerima kesaksian-Nya itu."
 },
 {
   "id": 26164,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 33,
   "firman": "Siapa yang menerima kesaksian-Nya itu, ia mengaku, bahwa Allah adalah benar."
 },
 {
   "id": 26165,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 34,
   "firman": "Sebab siapa yang diutus Allah, Dialah yang menyampaikan firman Allah, karena Allah mengaruniakan Roh-Nya dengan tidak terbatas."
 },
 {
   "id": 26166,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 35,
   "firman": "Bapa mengasihi Anak dan telah menyerahkan segala sesuatu kepada-Nya."
 },
 {
   "id": 26167,
   "kitab": "Yoh",
   "pasal": 3,
   "ayat": 36,
   "firman": "Barangsiapa percaya kepada Anak, ia beroleh hidup yang kekal, tetapi barangsiapa tidak taat kepada Anak, ia tidak akan melihat hidup, melainkan murka Allah tetap ada di atasnya.\""
 },
 {
   "id": 26168,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ketika Tuhan Yesus mengetahui, bahwa orang-orang Farisi telah mendengar, bahwa Ia memperoleh dan membaptis murid lebih banyak dari pada Yohanes"
 },
 {
   "id": 26169,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 2,
   "firman": "--meskipun Yesus sendiri tidak membaptis, melainkan murid-murid-Nya, --"
 },
 {
   "id": 26170,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 3,
   "firman": "Iapun meninggalkan Yudea dan kembali lagi ke Galilea."
 },
 {
   "id": 26171,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 4,
   "firman": "Ia harus melintasi daerah Samaria."
 },
 {
   "id": 26172,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 5,
   "firman": "Maka sampailah Ia ke sebuah kota di Samaria, yang bernama Sikhar dekat tanah yang diberikan Yakub dahulu kepada anaknya, Yusuf."
 },
 {
   "id": 26173,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 6,
   "firman": "Di situ terdapat sumur Yakub. Yesus sangat letih oleh perjalanan, karena itu Ia duduk di pinggir sumur itu. Hari kira-kira pukul dua belas."
 },
 {
   "id": 26174,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 7,
   "firman": "Maka datanglah seorang perempuan Samaria hendak menimba air. Kata Yesus kepadanya: \"Berilah Aku minum.\""
 },
 {
   "id": 26175,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 8,
   "firman": "Sebab murid-murid-Nya telah pergi ke kota membeli makanan."
 },
 {
   "id": 26176,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 9,
   "firman": "Maka kata perempuan Samaria itu kepada-Nya: \"Masakan Engkau, seorang Yahudi, minta minum kepadaku, seorang Samaria?\" (Sebab orang Yahudi tidak bergaul dengan orang Samaria.)"
 },
 {
   "id": 26177,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 10,
   "firman": "Jawab Yesus kepadanya: \"Jikalau engkau tahu tentang karunia Allah dan siapakah Dia yang berkata kepadamu: Berilah Aku minum! niscaya engkau telah meminta kepada-Nya dan Ia telah memberikan kepadamu air hidup.\""
 },
 {
   "id": 26178,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 11,
   "firman": "Kata perempuan itu kepada-Nya: \"Tuhan, Engkau tidak punya timba dan sumur ini amat dalam; dari manakah Engkau memperoleh air hidup itu?"
 },
 {
   "id": 26179,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 12,
   "firman": "Adakah Engkau lebih besar dari pada bapa kami Yakub, yang memberikan sumur ini kepada kami dan yang telah minum sendiri dari dalamnya, ia serta anak-anaknya dan ternaknya?\""
 },
 {
   "id": 26180,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 13,
   "firman": "Jawab Yesus kepadanya: \"Barangsiapa minum air ini, ia akan haus lagi,"
 },
 {
   "id": 26181,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 14,
   "firman": "tetapi barangsiapa minum air yang akan Kuberikan kepadanya, ia tidak akan haus untuk selama-lamanya. Sebaliknya air yang akan Kuberikan kepadanya, akan menjadi mata air di dalam dirinya, yang terus-menerus memancar sampai kepada hidup yang kekal.\""
 },
 {
   "id": 26182,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 15,
   "firman": "Kata perempuan itu kepada-Nya: \"Tuhan, berikanlah aku air itu, supaya aku tidak haus dan tidak usah datang lagi ke sini untuk menimba air.\""
 },
 {
   "id": 26183,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 16,
   "firman": "Kata Yesus kepadanya: \"Pergilah, panggillah suamimu dan datang ke sini.\""
 },
 {
   "id": 26184,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 17,
   "firman": "Kata perempuan itu: \"Aku tidak mempunyai suami.\" Kata Yesus kepadanya: \"Tepat katamu, bahwa engkau tidak mempunyai suami,"
 },
 {
   "id": 26185,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 18,
   "firman": "sebab engkau sudah mempunyai lima suami dan yang ada sekarang padamu, bukanlah suamimu. Dalam hal ini engkau berkata benar.\""
 },
 {
   "id": 26186,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 19,
   "firman": "Kata perempuan itu kepada-Nya: \"Tuhan, nyata sekarang padaku, bahwa Engkau seorang nabi."
 },
 {
   "id": 26187,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 20,
   "firman": "Nenek moyang kami menyembah di atas gunung ini, tetapi kamu katakan, bahwa Yerusalemlah tempat orang menyembah.\""
 },
 {
   "id": 26188,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 21,
   "firman": "Kata Yesus kepadanya: \"Percayalah kepada-Ku, hai perempuan, saatnya akan tiba, bahwa kamu akan menyembah Bapa bukan di gunung ini dan bukan juga di Yerusalem."
 },
 {
   "id": 26189,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 22,
   "firman": "Kamu menyembah apa yang tidak kamu kenal, kami menyembah apa yang kami kenal, sebab keselamatan datang dari bangsa Yahudi."
 },
 {
   "id": 26190,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 23,
   "firman": "Tetapi saatnya akan datang dan sudah tiba sekarang, bahwa penyembah-penyembah benar akan menyembah Bapa dalam roh dan kebenaran; sebab Bapa menghendaki penyembah-penyembah demikian."
 },
 {
   "id": 26191,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 24,
   "firman": "Allah itu Roh dan barangsiapa menyembah Dia, harus menyembah-Nya dalam roh dan kebenaran.\""
 },
 {
   "id": 26192,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 25,
   "firman": "Jawab perempuan itu kepada-Nya: \"Aku tahu, bahwa Mesias akan datang, yang disebut juga Kristus; apabila Ia datang, Ia akan memberitakan segala sesuatu kepada kami.\""
 },
 {
   "id": 26193,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 26,
   "firman": "Kata Yesus kepadanya: \"Akulah Dia, yang sedang berkata-kata dengan engkau.\""
 },
 {
   "id": 26194,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 27,
   "firman": "Pada waktu itu datanglah murid-murid-Nya dan mereka heran, bahwa Ia sedang bercakap-cakap dengan seorang perempuan. Tetapi tidak seorangpun yang berkata: \"Apa yang Engkau kehendaki? Atau: Apa yang Engkau percakapkan dengan dia?\""
 },
 {
   "id": 26195,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 28,
   "firman": "Maka perempuan itu meninggalkan tempayannya di situ lalu pergi ke kota dan berkata kepada orang-orang yang di situ:"
 },
 {
   "id": 26196,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 29,
   "firman": "\"Mari, lihat! Di sana ada seorang yang mengatakan kepadaku segala sesuatu yang telah kuperbuat. Mungkinkah Dia Kristus itu?\""
 },
 {
   "id": 26197,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 30,
   "firman": "Maka merekapun pergi ke luar kota lalu datang kepada Yesus."
 },
 {
   "id": 26198,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 31,
   "firman": "Sementara itu murid-murid-Nya mengajak Dia, katanya: \"Rabi, makanlah.\""
 },
 {
   "id": 26199,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 32,
   "firman": "Akan tetapi Ia berkata kepada mereka: \"Pada-Ku ada makanan yang tidak kamu kenal.\""
 },
 {
   "id": 26200,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 33,
   "firman": "Maka murid-murid itu berkata seorang kepada yang lain: \"Adakah orang yang telah membawa sesuatu kepada-Nya untuk dimakan?\""
 },
 {
   "id": 26201,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 34,
   "firman": "Kata Yesus kepada mereka: \"Makanan-Ku ialah melakukan kehendak Dia yang mengutus Aku dan menyelesaikan pekerjaan-Nya."
 },
 {
   "id": 26202,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 35,
   "firman": "Bukankah kamu mengatakan: Empat bulan lagi tibalah musim menuai? Tetapi Aku berkata kepadamu: Lihatlah sekelilingmu dan pandanglah ladang-ladang yang sudah menguning dan matang untuk dituai."
 },
 {
   "id": 26203,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 36,
   "firman": "Sekarang juga penuai telah menerima upahnya dan ia mengumpulkan buah untuk hidup yang kekal, sehingga penabur dan penuai sama-sama bersukacita."
 },
 {
   "id": 26204,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 37,
   "firman": "Sebab dalam hal ini benarlah peribahasa: Yang seorang menabur dan yang lain menuai."
 },
 {
   "id": 26205,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 38,
   "firman": "Aku mengutus kamu untuk menuai apa yang tidak kamu usahakan; orang-orang lain berusaha dan kamu datang memetik hasil usaha mereka.\""
 },
 {
   "id": 26206,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 39,
   "firman": "Dan banyak orang Samaria dari kota itu telah menjadi percaya kepada-Nya karena perkataan perempuan itu, yang bersaksi: \"Ia mengatakan kepadaku segala sesuatu yang telah kuperbuat.\""
 },
 {
   "id": 26207,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 40,
   "firman": "Ketika orang-orang Samaria itu sampai kepada Yesus, mereka meminta kepada-Nya, supaya Ia tinggal pada mereka; dan Iapun tinggal di situ dua hari lamanya."
 },
 {
   "id": 26208,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 41,
   "firman": "Dan lebih banyak lagi orang yang menjadi percaya karena perkataan-Nya,"
 },
 {
   "id": 26209,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 42,
   "firman": "dan mereka berkata kepada perempuan itu: \"Kami percaya, tetapi bukan lagi karena apa yang kaukatakan, sebab kami sendiri telah mendengar Dia dan kami tahu, bahwa Dialah benar-benar Juruselamat dunia.\""
 },
 {
   "id": 26210,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 43,
   "firman": "Dan setelah dua hari itu Yesus berangkat dari sana ke Galilea,"
 },
 {
   "id": 26211,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 44,
   "firman": "sebab Yesus sendiri telah bersaksi, bahwa seorang nabi tidak dihormati di negerinya sendiri."
 },
 {
   "id": 26212,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 45,
   "firman": "Maka setelah ia tiba di Galilea, orang-orang Galileapun menyambut Dia, karena mereka telah melihat segala sesuatu yang dikerjakan-Nya di Yerusalem pada pesta itu, sebab mereka sendiripun turut ke pesta itu."
 },
 {
   "id": 26213,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 46,
   "firman": "Maka Yesus kembali lagi ke Kana di Galilea, di mana Ia membuat air menjadi anggur. Dan di Kapernaum ada seorang pegawai istana, anaknya sedang sakit."
 },
 {
   "id": 26214,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 47,
   "firman": "Ketika ia mendengar, bahwa Yesus telah datang dari Yudea ke Galilea, pergilah ia kepada-Nya lalu meminta, supaya Ia datang dan menyembuhkan anaknya, sebab anaknya itu hampir mati."
 },
 {
   "id": 26215,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 48,
   "firman": "Maka kata Yesus kepadanya: \"Jika kamu tidak melihat tanda dan mujizat, kamu tidak percaya.\""
 },
 {
   "id": 26216,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 49,
   "firman": "Pegawai istana itu berkata kepada-Nya: \"Tuhan, datanglah sebelum anakku mati.\""
 },
 {
   "id": 26217,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 50,
   "firman": "Kata Yesus kepadanya: \"Pergilah, anakmu hidup!\" Orang itu percaya akan perkataan yang dikatakan Yesus kepadanya, lalu pergi."
 },
 {
   "id": 26218,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 51,
   "firman": "Ketika ia masih di tengah jalan hamba-hambanya telah datang kepadanya dengan kabar, bahwa anaknya hidup."
 },
 {
   "id": 26219,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 52,
   "firman": "Ia bertanya kepada mereka pukul berapa anak itu mulai sembuh. Jawab mereka: \"Kemarin siang pukul satu demamnya hilang.\""
 },
 {
   "id": 26220,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 53,
   "firman": "Maka teringatlah ayah itu, bahwa pada saat itulah Yesus berkata kepadanya: \"Anakmu hidup.\" Lalu iapun percaya, ia dan seluruh keluarganya."
 },
 {
   "id": 26221,
   "kitab": "Yoh",
   "pasal": 4,
   "ayat": 54,
   "firman": "Dan itulah tanda kedua yang dibuat Yesus ketika Ia pulang dari Yudea ke Galilea."
 },
 {
   "id": 26222,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 1,
   "firman": "Sesudah itu ada hari raya orang Yahudi, dan Yesus berangkat ke Yerusalem."
 },
 {
   "id": 26223,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 2,
   "firman": "Di Yerusalem dekat Pintu Gerbang Domba ada sebuah kolam, yang dalam bahasa Ibrani disebut Betesda; ada lima serambinya"
 },
 {
   "id": 26224,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 3,
   "firman": "dan di serambi-serambi itu berbaring sejumlah besar orang sakit: orang-orang buta, orang-orang timpang dan orang-orang lumpuh, yang menantikan goncangan air kolam itu."
 },
 {
   "id": 26225,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 4,
   "firman": "Sebab sewaktu-waktu turun malaikat Tuhan ke kolam itu dan menggoncangkan air itu; barangsiapa yang terdahulu masuk ke dalamnya sesudah goncangan air itu, menjadi sembuh, apapun juga penyakitnya."
 },
 {
   "id": 26226,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 5,
   "firman": "Di situ ada seorang yang sudah tiga puluh delapan tahun lamanya sakit."
 },
 {
   "id": 26227,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 6,
   "firman": "Ketika Yesus melihat orang itu berbaring di situ dan karena Ia tahu, bahwa ia telah lama dalam keadaan itu, berkatalah Ia kepadanya: \"Maukah engkau sembuh?\""
 },
 {
   "id": 26228,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 7,
   "firman": "Jawab orang sakit itu kepada-Nya: \"Tuhan, tidak ada orang yang menurunkan aku ke dalam kolam itu apabila airnya mulai goncang, dan sementara aku menuju ke kolam itu, orang lain sudah turun mendahului aku.\""
 },
 {
   "id": 26229,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kata Yesus kepadanya: \"Bangunlah, angkatlah tilammu dan berjalanlah.\""
 },
 {
   "id": 26230,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dan pada saat itu juga sembuhlah orang itu lalu ia mengangkat tilamnya dan berjalan. Tetapi hari itu hari Sabat."
 },
 {
   "id": 26231,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 10,
   "firman": "Karena itu orang-orang Yahudi berkata kepada orang yang baru sembuh itu: \"Hari ini hari Sabat dan tidak boleh engkau memikul tilammu.\""
 },
 {
   "id": 26232,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 11,
   "firman": "Akan tetapi ia menjawab mereka: \"Orang yang telah menyembuhkan aku, dia yang mengatakan kepadaku: Angkatlah tilammu dan berjalanlah.\""
 },
 {
   "id": 26233,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 12,
   "firman": "Mereka bertanya kepadanya: \"Siapakah orang itu yang berkata kepadamu: Angkatlah tilammu dan berjalanlah?\""
 },
 {
   "id": 26234,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 13,
   "firman": "Tetapi orang yang baru sembuh itu tidak tahu siapa orang itu, sebab Yesus telah menghilang ke tengah-tengah orang banyak di tempat itu."
 },
 {
   "id": 26235,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 14,
   "firman": "Kemudian Yesus bertemu dengan dia dalam Bait Allah lalu berkata kepadanya: \"Engkau telah sembuh; jangan berbuat dosa lagi, supaya padamu jangan terjadi yang lebih buruk.\""
 },
 {
   "id": 26236,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 15,
   "firman": "Orang itu keluar, lalu menceriterakan kepada orang-orang Yahudi, bahwa Yesuslah yang telah menyembuhkan dia."
 },
 {
   "id": 26237,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 16,
   "firman": "Dan karena itu orang-orang Yahudi berusaha menganiaya Yesus, karena Ia melakukan hal-hal itu pada hari Sabat."
 },
 {
   "id": 26238,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 17,
   "firman": "Tetapi Ia berkata kepada mereka: \"Bapa-Ku bekerja sampai sekarang, maka Akupun bekerja juga.\""
 },
 {
   "id": 26239,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 18,
   "firman": "Sebab itu orang-orang Yahudi lebih berusaha lagi untuk membunuh-Nya, bukan saja karena Ia meniadakan hari Sabat, tetapi juga karena Ia mengatakan bahwa Allah adalah Bapa-Nya sendiri dan dengan demikian menyamakan diri-Nya dengan Allah."
 },
 {
   "id": 26240,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 19,
   "firman": "Maka Yesus menjawab mereka, kata-Nya: \"Aku berkata kepadamu, sesungguhnya Anak tidak dapat mengerjakan sesuatu dari diri-Nya sendiri, jikalau tidak Ia melihat Bapa mengerjakannya; sebab apa yang dikerjakan Bapa, itu juga yang dikerjakan Anak."
 },
 {
   "id": 26241,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 20,
   "firman": "Sebab Bapa mengasihi Anak dan Ia menunjukkan kepada-Nya segala sesuatu yang dikerjakan-Nya sendiri, bahkan Ia akan menunjukkan kepada-Nya pekerjaan-pekerjaan yang lebih besar lagi dari pada pekerjaan-pekerjaan itu, sehingga kamu menjadi heran."
 },
 {
   "id": 26242,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 21,
   "firman": "Sebab sama seperti Bapa membangkitkan orang-orang mati dan menghidupkannya, demikian juga Anak menghidupkan barangsiapa yang dikehendaki-Nya."
 },
 {
   "id": 26243,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 22,
   "firman": "Bapa tidak menghakimi siapapun, melainkan telah menyerahkan penghakiman itu seluruhnya kepada Anak,"
 },
 {
   "id": 26244,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 23,
   "firman": "supaya semua orang menghormati Anak sama seperti mereka menghormati Bapa. Barangsiapa tidak menghormati Anak, ia juga tidak menghormati Bapa, yang mengutus Dia."
 },
 {
   "id": 26245,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 24,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa mendengar perkataan-Ku dan percaya kepada Dia yang mengutus Aku, ia mempunyai hidup yang kekal dan tidak turut dihukum, sebab ia sudah pindah dari dalam maut ke dalam hidup."
 },
 {
   "id": 26246,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 25,
   "firman": "Aku berkata kepadamu: Sesungguhnya saatnya akan tiba dan sudah tiba, bahwa orang-orang mati akan mendengar suara Anak Allah, dan mereka yang mendengarnya, akan hidup."
 },
 {
   "id": 26247,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 26,
   "firman": "Sebab sama seperti Bapa mempunyai hidup dalam diri-Nya sendiri, demikian juga diberikan-Nya Anak mempunyai hidup dalam diri-Nya sendiri."
 },
 {
   "id": 26248,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 27,
   "firman": "Dan Ia telah memberikan kuasa kepada-Nya untuk menghakimi, karena Ia adalah Anak Manusia."
 },
 {
   "id": 26249,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 28,
   "firman": "Janganlah kamu heran akan hal itu, sebab saatnya akan tiba, bahwa semua orang yang di dalam kuburan akan mendengar suara-Nya,"
 },
 {
   "id": 26250,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 29,
   "firman": "dan mereka yang telah berbuat baik akan keluar dan bangkit untuk hidup yang kekal, tetapi mereka yang telah berbuat jahat akan bangkit untuk dihukum."
 },
 {
   "id": 26251,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 30,
   "firman": "Aku tidak dapat berbuat apa-apa dari diri-Ku sendiri; Aku menghakimi sesuai dengan apa yang Aku dengar, dan penghakiman-Ku adil, sebab Aku tidak menuruti kehendak-Ku sendiri, melainkan kehendak Dia yang mengutus Aku."
 },
 {
   "id": 26252,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 31,
   "firman": "Kalau Aku bersaksi tentang diri-Ku sendiri, maka kesaksian-Ku itu tidak benar;"
 },
 {
   "id": 26253,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 32,
   "firman": "ada yang lain yang bersaksi tentang Aku dan Aku tahu, bahwa kesaksian yang diberikan-Nya tentang Aku adalah benar."
 },
 {
   "id": 26254,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 33,
   "firman": "Kamu telah mengirim utusan kepada Yohanes dan ia telah bersaksi tentang kebenaran;"
 },
 {
   "id": 26255,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 34,
   "firman": "tetapi Aku tidak memerlukan kesaksian dari manusia, namun Aku mengatakan hal ini, supaya kamu diselamatkan."
 },
 {
   "id": 26256,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 35,
   "firman": "Ia adalah pelita yang menyala dan yang bercahaya dan kamu hanya mau menikmati seketika saja cahayanya itu."
 },
 {
   "id": 26257,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 36,
   "firman": "Tetapi Aku mempunyai suatu kesaksian yang lebih penting dari pada kesaksian Yohanes, yaitu segala pekerjaan yang diserahkan Bapa kepada-Ku, supaya Aku melaksanakannya. Pekerjaan itu juga yang Kukerjakan sekarang, dan itulah yang memberi kesaksian tentang Aku, bahwa Bapa yang mengutus Aku."
 },
 {
   "id": 26258,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 37,
   "firman": "Bapa yang mengutus Aku, Dialah yang bersaksi tentang Aku. Kamu tidak pernah mendengar suara-Nya, rupa-Nyapun tidak pernah kamu lihat,"
 },
 {
   "id": 26259,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 38,
   "firman": "dan firman-Nya tidak menetap di dalam dirimu, sebab kamu tidak percaya kepada Dia yang diutus-Nya."
 },
 {
   "id": 26260,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 39,
   "firman": "Kamu menyelidiki Kitab-kitab Suci, sebab kamu menyangka bahwa oleh-Nya kamu mempunyai hidup yang kekal, tetapi walaupun Kitab-kitab Suci itu memberi kesaksian tentang Aku,"
 },
 {
   "id": 26261,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 40,
   "firman": "namun kamu tidak mau datang kepada-Ku untuk memperoleh hidup itu."
 },
 {
   "id": 26262,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 41,
   "firman": "Aku tidak memerlukan hormat dari manusia."
 },
 {
   "id": 26263,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 42,
   "firman": "Tetapi tentang kamu, memang Aku tahu bahwa di dalam hatimu kamu tidak mempunyai kasih akan Allah."
 },
 {
   "id": 26264,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 43,
   "firman": "Aku datang dalam nama Bapa-Ku dan kamu tidak menerima Aku; jikalau orang lain datang atas namanya sendiri, kamu akan menerima dia."
 },
 {
   "id": 26265,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 44,
   "firman": "Bagaimanakah kamu dapat percaya, kamu yang menerima hormat seorang dari yang lain dan yang tidak mencari hormat yang datang dari Allah yang Esa?"
 },
 {
   "id": 26266,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 45,
   "firman": "Jangan kamu menyangka, bahwa Aku akan mendakwa kamu di hadapan Bapa; yang mendakwa kamu adalah Musa, yaitu Musa, yang kepadanya kamu menaruh pengharapanmu."
 },
 {
   "id": 26267,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 46,
   "firman": "Sebab jikalau kamu percaya kepada Musa, tentu kamu akan percaya juga kepada-Ku, sebab ia telah menulis tentang Aku."
 },
 {
   "id": 26268,
   "kitab": "Yoh",
   "pasal": 5,
   "ayat": 47,
   "firman": "Tetapi jikalau kamu tidak percaya akan apa yang ditulisnya, bagaimanakah kamu akan percaya akan apa yang Kukatakan?\""
 },
 {
   "id": 26269,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 1,
   "firman": "Sesudah itu Yesus berangkat ke seberang danau Galilea, yaitu danau Tiberias."
 },
 {
   "id": 26270,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 2,
   "firman": "Orang banyak berbondong-bondong mengikuti Dia, karena mereka melihat mujizat-mujizat penyembuhan, yang diadakan-Nya terhadap orang-orang sakit."
 },
 {
   "id": 26271,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 3,
   "firman": "Dan Yesus naik ke atas gunung dan duduk di situ dengan murid-murid-Nya."
 },
 {
   "id": 26272,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dan Paskah, hari raya orang Yahudi, sudah dekat."
 },
 {
   "id": 26273,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 5,
   "firman": "Ketika Yesus memandang sekeliling-Nya dan melihat, bahwa orang banyak berbondong-bondong datang kepada-Nya, berkatalah Ia kepada Filipus: \"Di manakah kita akan membeli roti, supaya mereka ini dapat makan?\""
 },
 {
   "id": 26274,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 6,
   "firman": "Hal itu dikatakan-Nya untuk mencobai dia, sebab Ia sendiri tahu, apa yang hendak dilakukan-Nya."
 },
 {
   "id": 26275,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 7,
   "firman": "Jawab Filipus kepada-Nya: \"Roti seharga dua ratus dinar tidak akan cukup untuk mereka ini, sekalipun masing-masing mendapat sepotong kecil saja.\""
 },
 {
   "id": 26276,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 8,
   "firman": "Seorang dari murid-murid-Nya, yaitu Andreas, saudara Simon Petrus, berkata kepada-Nya:"
 },
 {
   "id": 26277,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 9,
   "firman": "\"Di sini ada seorang anak, yang mempunyai lima roti jelai dan dua ikan; tetapi apakah artinya itu untuk orang sebanyak ini?\""
 },
 {
   "id": 26278,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 10,
   "firman": "Kata Yesus: \"Suruhlah orang-orang itu duduk.\" Adapun di tempat itu banyak rumput. Maka duduklah orang-orang itu, kira-kira lima ribu laki-laki banyaknya."
 },
 {
   "id": 26279,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 11,
   "firman": "Lalu Yesus mengambil roti itu, mengucap syukur dan membagi-bagikannya kepada mereka yang duduk di situ, demikian juga dibuat-Nya dengan ikan-ikan itu, sebanyak yang mereka kehendaki."
 },
 {
   "id": 26280,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 12,
   "firman": "Dan setelah mereka kenyang Ia berkata kepada murid-murid-Nya: \"Kumpulkanlah potongan-potongan yang lebih supaya tidak ada yang terbuang.\""
 },
 {
   "id": 26281,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 13,
   "firman": "Maka merekapun mengumpulkannya, dan mengisi dua belas bakul penuh dengan potongan-potongan dari kelima roti jelai yang lebih setelah orang makan."
 },
 {
   "id": 26282,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 14,
   "firman": "Ketika orang-orang itu melihat mujizat yang telah diadakan-Nya, mereka berkata: \"Dia ini adalah benar-benar nabi yang akan datang ke dalam dunia.\""
 },
 {
   "id": 26283,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 15,
   "firman": "Karena Yesus tahu, bahwa mereka hendak datang dan hendak membawa Dia dengan paksa untuk menjadikan Dia raja, Ia menyingkir pula ke gunung, seorang diri."
 },
 {
   "id": 26284,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 16,
   "firman": "Dan ketika hari sudah mulai malam, murid-murid Yesus pergi ke danau, lalu naik ke perahu"
 },
 {
   "id": 26285,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 17,
   "firman": "dan menyeberang ke Kapernaum. Ketika hari sudah gelap Yesus belum juga datang mendapatkan mereka,"
 },
 {
   "id": 26286,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 18,
   "firman": "sedang laut bergelora karena angin kencang."
 },
 {
   "id": 26287,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 19,
   "firman": "Sesudah mereka mendayung kira-kira dua tiga mil jauhnya, mereka melihat Yesus berjalan di atas air mendekati perahu itu. Maka ketakutanlah mereka."
 },
 {
   "id": 26288,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 20,
   "firman": "Tetapi Ia berkata kepada mereka: \"Aku ini, jangan takut!\""
 },
 {
   "id": 26289,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 21,
   "firman": "Mereka mau menaikkan Dia ke dalam perahu, dan seketika juga perahu itu sampai ke pantai yang mereka tujui."
 },
 {
   "id": 26290,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 22,
   "firman": "Pada keesokan harinya orang banyak, yang masih tinggal di seberang, melihat bahwa di situ tidak ada perahu selain dari pada yang satu tadi dan bahwa Yesus tidak turut naik ke perahu itu bersama-sama dengan murid-murid-Nya, dan bahwa murid-murid-Nya saja yang berangkat."
 },
 {
   "id": 26291,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 23,
   "firman": "Tetapi sementara itu beberapa perahu lain datang dari Tiberias dekat ke tempat mereka makan roti, sesudah Tuhan mengucapkan syukur atasnya."
 },
 {
   "id": 26292,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 24,
   "firman": "Ketika orang banyak melihat, bahwa Yesus tidak ada di situ dan murid-murid-Nya juga tidak, mereka naik ke perahu-perahu itu lalu berangkat ke Kapernaum untuk mencari Yesus."
 },
 {
   "id": 26293,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 25,
   "firman": "Ketika orang banyak menemukan Yesus di seberang laut itu, mereka berkata kepada-Nya: \"Rabi, bilamana Engkau tiba di sini?\""
 },
 {
   "id": 26294,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 26,
   "firman": "Yesus menjawab mereka: \"Aku berkata kepadamu, sesungguhnya kamu mencari Aku, bukan karena kamu telah melihat tanda-tanda, melainkan karena kamu telah makan roti itu dan kamu kenyang."
 },
 {
   "id": 26295,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 27,
   "firman": "Bekerjalah, bukan untuk makanan yang akan dapat binasa, melainkan untuk makanan yang bertahan sampai kepada hidup yang kekal, yang akan diberikan Anak Manusia kepadamu; sebab Dialah yang disahkan oleh Bapa, Allah, dengan meterai-Nya.\""
 },
 {
   "id": 26296,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 28,
   "firman": "Lalu kata mereka kepada-Nya: \"Apakah yang harus kami perbuat, supaya kami mengerjakan pekerjaan yang dikehendaki Allah?\""
 },
 {
   "id": 26297,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 29,
   "firman": "Jawab Yesus kepada mereka: \"Inilah pekerjaan yang dikehendaki Allah, yaitu hendaklah kamu percaya kepada Dia yang telah diutus Allah.\""
 },
 {
   "id": 26298,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 30,
   "firman": "Maka kata mereka kepada-Nya: \"Tanda apakah yang Engkau perbuat, supaya dapat kami melihatnya dan percaya kepada-Mu? Pekerjaan apakah yang Engkau lakukan?"
 },
 {
   "id": 26299,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 31,
   "firman": "Nenek moyang kami telah makan manna di padang gurun, seperti ada tertulis: Mereka diberi-Nya makan roti dari sorga.\""
 },
 {
   "id": 26300,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 32,
   "firman": "Maka kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya bukan Musa yang memberikan kamu roti dari sorga, melainkan Bapa-Ku yang memberikan kamu roti yang benar dari sorga."
 },
 {
   "id": 26301,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 33,
   "firman": "Karena roti yang dari Allah ialah roti yang turun dari sorga dan yang memberi hidup kepada dunia.\""
 },
 {
   "id": 26302,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 34,
   "firman": "Maka kata mereka kepada-Nya: \"Tuhan, berikanlah kami roti itu senantiasa.\""
 },
 {
   "id": 26303,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 35,
   "firman": "Kata Yesus kepada mereka: \"Akulah roti hidup; barangsiapa datang kepada-Ku, ia tidak akan lapar lagi, dan barangsiapa percaya kepada-Ku, ia tidak akan haus lagi."
 },
 {
   "id": 26304,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 36,
   "firman": "Tetapi Aku telah berkata kepadamu: Sungguhpun kamu telah melihat Aku, kamu tidak percaya."
 },
 {
   "id": 26305,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 37,
   "firman": "Semua yang diberikan Bapa kepada-Ku akan datang kepada-Ku, dan barangsiapa datang kepada-Ku, ia tidak akan Kubuang."
 },
 {
   "id": 26306,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 38,
   "firman": "Sebab Aku telah turun dari sorga bukan untuk melakukan kehendak-Ku, tetapi untuk melakukan kehendak Dia yang telah mengutus Aku."
 },
 {
   "id": 26307,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 39,
   "firman": "Dan Inilah kehendak Dia yang telah mengutus Aku, yaitu supaya dari semua yang telah diberikan-Nya kepada-Ku jangan ada yang hilang, tetapi supaya Kubangkitkan pada akhir zaman."
 },
 {
   "id": 26308,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 40,
   "firman": "Sebab inilah kehendak Bapa-Ku, yaitu supaya setiap orang, yang melihat Anak dan yang percaya kepada-Nya beroleh hidup yang kekal, dan supaya Aku membangkitkannya pada akhir zaman.\""
 },
 {
   "id": 26309,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 41,
   "firman": "Maka bersungut-sungutlah orang Yahudi tentang Dia, karena Ia telah mengatakan: \"Akulah roti yang telah turun dari sorga.\""
 },
 {
   "id": 26310,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 42,
   "firman": "Kata mereka: \"Bukankah Ia ini Yesus, anak Yusuf, yang ibu bapanya kita kenal? Bagaimana Ia dapat berkata: Aku telah turun dari sorga?\""
 },
 {
   "id": 26311,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 43,
   "firman": "Jawab Yesus kepada mereka: \"Jangan kamu bersungut-sungut."
 },
 {
   "id": 26312,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 44,
   "firman": "Tidak ada seorangpun yang dapat datang kepada-Ku, jikalau ia tidak ditarik oleh Bapa yang mengutus Aku, dan ia akan Kubangkitkan pada akhir zaman."
 },
 {
   "id": 26313,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 45,
   "firman": "Ada tertulis dalam kitab nabi-nabi: Dan mereka semua akan diajar oleh Allah. Dan setiap orang, yang telah mendengar dan menerima pengajaran dari Bapa, datang kepada-Ku."
 },
 {
   "id": 26314,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 46,
   "firman": "Hal itu tidak berarti, bahwa ada orang yang telah melihat Bapa. Hanya Dia yang datang dari Allah, Dialah yang telah melihat Bapa."
 },
 {
   "id": 26315,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 47,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa percaya, ia mempunyai hidup yang kekal."
 },
 {
   "id": 26316,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 48,
   "firman": "Akulah roti hidup."
 },
 {
   "id": 26317,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 49,
   "firman": "Nenek moyangmu telah makan manna di padang gurun dan mereka telah mati."
 },
 {
   "id": 26318,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 50,
   "firman": "Inilah roti yang turun dari sorga: Barangsiapa makan dari padanya, ia tidak akan mati."
 },
 {
   "id": 26319,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 51,
   "firman": "Akulah roti hidup yang telah turun dari sorga. Jikalau seorang makan dari roti ini, ia akan hidup selama-lamanya, dan roti yang Kuberikan itu ialah daging-Ku, yang akan Kuberikan untuk hidup dunia.\""
 },
 {
   "id": 26320,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 52,
   "firman": "Orang-orang Yahudi bertengkar antara sesama mereka dan berkata: \"Bagaimana Ia ini dapat memberikan daging-Nya kepada kita untuk dimakan.\""
 },
 {
   "id": 26321,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 53,
   "firman": "Maka kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya jikalau kamu tidak makan daging Anak Manusia dan minum darah-Nya, kamu tidak mempunyai hidup di dalam dirimu."
 },
 {
   "id": 26322,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 54,
   "firman": "Barangsiapa makan daging-Ku dan minum darah-Ku, ia mempunyai hidup yang kekal dan Aku akan membangkitkan dia pada akhir zaman."
 },
 {
   "id": 26323,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 55,
   "firman": "Sebab daging-Ku adalah benar-benar makanan dan darah-Ku adalah benar-benar minuman."
 },
 {
   "id": 26324,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 56,
   "firman": "Barangsiapa makan daging-Ku dan minum darah-Ku, ia tinggal di dalam Aku dan Aku di dalam dia."
 },
 {
   "id": 26325,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 57,
   "firman": "Sama seperti Bapa yang hidup mengutus Aku dan Aku hidup oleh Bapa, demikian juga barangsiapa yang memakan Aku, akan hidup oleh Aku."
 },
 {
   "id": 26326,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 58,
   "firman": "Inilah roti yang telah turun dari sorga, bukan roti seperti yang dimakan nenek moyangmu dan mereka telah mati. Barangsiapa makan roti ini, ia akan hidup selama-lamanya.\""
 },
 {
   "id": 26327,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 59,
   "firman": "Semuanya ini dikatakan Yesus di Kapernaum ketika Ia mengajar di rumah ibadat."
 },
 {
   "id": 26328,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 60,
   "firman": "Sesudah mendengar semuanya itu banyak dari murid-murid Yesus yang berkata: \"Perkataan ini keras, siapakah yang sanggup mendengarkannya?\""
 },
 {
   "id": 26329,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 61,
   "firman": "Yesus yang di dalam hati-Nya tahu, bahwa murid-murid-Nya bersungut-sungut tentang hal itu, berkata kepada mereka: \"Adakah perkataan itu menggoncangkan imanmu?"
 },
 {
   "id": 26330,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 62,
   "firman": "Dan bagaimanakah, jikalau kamu melihat Anak Manusia naik ke tempat di mana Ia sebelumnya berada?"
 },
 {
   "id": 26331,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 63,
   "firman": "Rohlah yang memberi hidup, daging sama sekali tidak berguna. Perkataan-perkataan yang Kukatakan kepadamu adalah roh dan hidup."
 },
 {
   "id": 26332,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 64,
   "firman": "Tetapi di antaramu ada yang tidak percaya.\" Sebab Yesus tahu dari semula, siapa yang tidak percaya dan siapa yang akan menyerahkan Dia."
 },
 {
   "id": 26333,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 65,
   "firman": "Lalu Ia berkata: \"Sebab itu telah Kukatakan kepadamu: Tidak ada seorangpun dapat datang kepada-Ku, kalau Bapa tidak mengaruniakannya kepadanya.\""
 },
 {
   "id": 26334,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 66,
   "firman": "Mulai dari waktu itu banyak murid-murid-Nya mengundurkan diri dan tidak lagi mengikut Dia."
 },
 {
   "id": 26335,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 67,
   "firman": "Maka kata Yesus kepada kedua belas murid-Nya: \"Apakah kamu tidak mau pergi juga?\""
 },
 {
   "id": 26336,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 68,
   "firman": "Jawab Simon Petrus kepada-Nya: \"Tuhan, kepada siapakah kami akan pergi? Perkataan-Mu adalah perkataan hidup yang kekal;"
 },
 {
   "id": 26337,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 69,
   "firman": "dan kami telah percaya dan tahu, bahwa Engkau adalah Yang Kudus dari Allah.\""
 },
 {
   "id": 26338,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 70,
   "firman": "Jawab Yesus kepada mereka: \"Bukankah Aku sendiri yang telah memilih kamu yang dua belas ini? Namun seorang di antaramu adalah Iblis.\""
 },
 {
   "id": 26339,
   "kitab": "Yoh",
   "pasal": 6,
   "ayat": 71,
   "firman": "Yang dimaksudkan-Nya ialah Yudas, anak Simon Iskariot; sebab dialah yang akan menyerahkan Yesus, dia seorang di antara kedua belas murid itu."
 },
 {
   "id": 26340,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 1,
   "firman": "Sesudah itu Yesus berjalan keliling Galilea, sebab Ia tidak mau tetap tinggal di Yudea, karena di sana orang-orang Yahudi berusaha untuk membunuh-Nya."
 },
 {
   "id": 26341,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 2,
   "firman": "Ketika itu sudah dekat hari raya orang Yahudi, yaitu hari raya Pondok Daun."
 },
 {
   "id": 26342,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 3,
   "firman": "Maka kata saudara-saudara Yesus kepada-Nya: \"Berangkatlah dari sini dan pergi ke Yudea, supaya murid-murid-Mu juga melihat perbuatan-perbuatan yang Engkau lakukan."
 },
 {
   "id": 26343,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 4,
   "firman": "Sebab tidak seorangpun berbuat sesuatu di tempat tersembunyi, jika ia mau diakui di muka umum. Jikalau Engkau berbuat hal-hal yang demikian, tampakkanlah diri-Mu kepada dunia.\""
 },
 {
   "id": 26344,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 5,
   "firman": "Sebab saudara-saudara-Nya sendiripun tidak percaya kepada-Nya."
 },
 {
   "id": 26345,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 6,
   "firman": "Maka jawab Yesus kepada mereka: \"Waktu-Ku belum tiba, tetapi bagi kamu selalu ada waktu."
 },
 {
   "id": 26346,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 7,
   "firman": "Dunia tidak dapat membenci kamu, tetapi ia membenci Aku, sebab Aku bersaksi tentang dia, bahwa pekerjaan-pekerjaannya jahat."
 },
 {
   "id": 26347,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 8,
   "firman": "Pergilah kamu ke pesta itu. Aku belum pergi ke situ, karena waktu-Ku belum genap.\""
 },
 {
   "id": 26348,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 9,
   "firman": "Demikianlah kata-Nya kepada mereka, dan Iapun tinggal di Galilea."
 },
 {
   "id": 26349,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 10,
   "firman": "Tetapi sesudah saudara-saudara Yesus berangkat ke pesta itu, Iapun pergi juga ke situ, tidak terang-terangan tetapi diam-diam."
 },
 {
   "id": 26350,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 11,
   "firman": "Orang-orang Yahudi mencari Dia di pesta itu dan berkata: \"Di manakah Ia?\""
 },
 {
   "id": 26351,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 12,
   "firman": "Dan banyak terdengar bisikan di antara orang banyak tentang Dia. Ada yang berkata: \"Ia orang baik.\" Ada pula yang berkata: \"Tidak, Ia menyesatkan rakyat.\""
 },
 {
   "id": 26352,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 13,
   "firman": "Tetapi tidak seorangpun yang berani berkata terang-terangan tentang Dia karena takut terhadap orang-orang Yahudi."
 },
 {
   "id": 26353,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 14,
   "firman": "Waktu pesta itu sedang berlangsung, Yesus masuk ke Bait Allah lalu mengajar di situ."
 },
 {
   "id": 26354,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 15,
   "firman": "Maka heranlah orang-orang Yahudi dan berkata: \"Bagaimanakah orang ini mempunyai pengetahuan demikian tanpa belajar!\""
 },
 {
   "id": 26355,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 16,
   "firman": "Jawab Yesus kepada mereka: \"Ajaran-Ku tidak berasal dari diri-Ku sendiri, tetapi dari Dia yang telah mengutus Aku."
 },
 {
   "id": 26356,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 17,
   "firman": "Barangsiapa mau melakukan kehendak-Nya, ia akan tahu entah ajaran-Ku ini berasal dari Allah, entah Aku berkata-kata dari diri-Ku sendiri."
 },
 {
   "id": 26357,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 18,
   "firman": "Barangsiapa berkata-kata dari dirinya sendiri, ia mencari hormat bagi dirinya sendiri, tetapi barangsiapa mencari hormat bagi Dia yang mengutusnya, ia benar dan tidak ada ketidakbenaran padanya."
 },
 {
   "id": 26358,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 19,
   "firman": "Bukankah Musa yang telah memberikan hukum Taurat kepadamu? Namun tidak seorangpun di antara kamu yang melakukan hukum Taurat itu. Mengapa kamu berusaha membunuh Aku?\""
 },
 {
   "id": 26359,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 20,
   "firman": "Orang banyak itu menjawab: \"Engkau kerasukan setan; siapakah yang berusaha membunuh Engkau?\""
 },
 {
   "id": 26360,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 21,
   "firman": "Jawab Yesus kepada mereka: \"Hanya satu perbuatan yang Kulakukan dan kamu semua telah heran."
 },
 {
   "id": 26361,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 22,
   "firman": "Jadi: Musa menetapkan supaya kamu bersunat--sebenarnya sunat itu tidak berasal dari Musa, tetapi dari nenek moyang kita--dan kamu menyunat orang pada hari Sabat!"
 },
 {
   "id": 26362,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 23,
   "firman": "Jikalau seorang menerima sunat pada hari Sabat, supaya jangan melanggar hukum Musa, mengapa kamu marah kepada-Ku, karena Aku menyembuhkan seluruh tubuh seorang manusia pada hari Sabat."
 },
 {
   "id": 26363,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 24,
   "firman": "Janganlah menghakimi menurut apa yang nampak, tetapi hakimilah dengan adil.\""
 },
 {
   "id": 26364,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 25,
   "firman": "Beberapa orang Yerusalem berkata: \"Bukankah Dia ini yang mereka mau bunuh?"
 },
 {
   "id": 26365,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 26,
   "firman": "Dan lihatlah, Ia berbicara dengan leluasa dan mereka tidak mengatakan apa-apa kepada-Nya. Mungkinkah pemimpin kita benar-benar sudah tahu, bahwa Ia adalah Kristus?"
 },
 {
   "id": 26366,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 27,
   "firman": "Tetapi tentang orang ini kita tahu dari mana asal-Nya, tetapi bilamana Kristus datang, tidak ada seorangpun yang tahu dari mana asal-Nya.\""
 },
 {
   "id": 26367,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 28,
   "firman": "Waktu Yesus mengajar di Bait Allah, Ia berseru: \"Memang Aku kamu kenal dan kamu tahu dari mana asal-Ku; namun Aku datang bukan atas kehendak-Ku sendiri, tetapi Aku diutus oleh Dia yang benar yang tidak kamu kenal."
 },
 {
   "id": 26368,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 29,
   "firman": "Aku kenal Dia, sebab Aku datang dari Dia dan Dialah yang mengutus Aku.\""
 },
 {
   "id": 26369,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 30,
   "firman": "Mereka berusaha menangkap Dia, tetapi tidak ada seorangpun yang menyentuh Dia, sebab saat-Nya belum tiba."
 },
 {
   "id": 26370,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 31,
   "firman": "Tetapi di antara orang banyak itu ada banyak yang percaya kepada-Nya dan mereka berkata: \"Apabila Kristus datang, mungkinkah Ia akan mengadakan lebih banyak mujizat dari pada yang telah diadakan oleh Dia ini?\""
 },
 {
   "id": 26371,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 32,
   "firman": "Orang-orang Farisi mendengar orang banyak membisikkan hal-hal itu mengenai Dia, dan karena itu imam-imam kepala dan orang-orang Farisi menyuruh penjaga-penjaga Bait Allah untuk menangkap-Nya."
 },
 {
   "id": 26372,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 33,
   "firman": "Maka kata Yesus: \"Tinggal sedikit waktu saja Aku ada bersama kamu dan sesudah itu Aku akan pergi kepada Dia yang telah mengutus Aku."
 },
 {
   "id": 26373,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 34,
   "firman": "Kamu akan mencari Aku, tetapi tidak akan bertemu dengan Aku, sebab kamu tidak dapat datang ke tempat di mana Aku berada.\""
 },
 {
   "id": 26374,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 35,
   "firman": "Orang-orang Yahudi itu berkata seorang kepada yang lain: \"Ke manakah Ia akan pergi, sehingga kita tidak dapat bertemu dengan Dia? Adakah maksud-Nya untuk pergi kepada mereka yang tinggal di perantauan, di antara orang Yunani, untuk mengajar orang Yunani?"
 },
 {
   "id": 26375,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 36,
   "firman": "Apakah maksud perkataan yang diucapkan-Nya ini: Kamu akan mencari Aku, tetapi kamu tidak akan bertemu dengan Aku, dan: Kamu tidak dapat datang ke tempat di mana Aku berada?\""
 },
 {
   "id": 26376,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 37,
   "firman": "Dan pada hari terakhir, yaitu pada puncak perayaan itu, Yesus berdiri dan berseru: \"Barangsiapa haus, baiklah ia datang kepada-Ku dan minum!"
 },
 {
   "id": 26377,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 38,
   "firman": "Barangsiapa percaya kepada-Ku, seperti yang dikatakan oleh Kitab Suci: Dari dalam hatinya akan mengalir aliran-aliran air hidup.\""
 },
 {
   "id": 26378,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 39,
   "firman": "Yang dimaksudkan-Nya ialah Roh yang akan diterima oleh mereka yang percaya kepada-Nya; sebab Roh itu belum datang, karena Yesus belum dimuliakan."
 },
 {
   "id": 26379,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 40,
   "firman": "Beberapa orang di antara orang banyak, yang mendengarkan perkataan-perkataan itu, berkata: \"Dia ini benar-benar nabi yang akan datang.\""
 },
 {
   "id": 26380,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 41,
   "firman": "Yang lain berkata: \"Ia ini Mesias.\" Tetapi yang lain lagi berkata: \"Bukan, Mesias tidak datang dari Galilea!"
 },
 {
   "id": 26381,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 42,
   "firman": "Karena Kitab Suci mengatakan, bahwa Mesias berasal dari keturunan Daud dan dari kampung Betlehem, tempat Daud dahulu tinggal.\""
 },
 {
   "id": 26382,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 43,
   "firman": "Maka timbullah pertentangan di antara orang banyak karena Dia."
 },
 {
   "id": 26383,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 44,
   "firman": "Beberapa orang di antara mereka mau menangkap Dia, tetapi tidak ada seorangpun yang berani menyentuh-Nya."
 },
 {
   "id": 26384,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 45,
   "firman": "Maka penjaga-penjaga itu pergi kepada imam-imam kepala dan orang-orang Farisi, yang berkata kepada mereka: \"Mengapa kamu tidak membawa-Nya?\""
 },
 {
   "id": 26385,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 46,
   "firman": "Jawab penjaga-penjaga itu: \"Belum pernah seorang manusia berkata seperti orang itu!\""
 },
 {
   "id": 26386,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 47,
   "firman": "Jawab orang-orang Farisi itu kepada mereka: \"Adakah kamu juga disesatkan?"
 },
 {
   "id": 26387,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 48,
   "firman": "Adakah seorang di antara pemimpin-pemimpin yang percaya kepada-Nya, atau seorang di antara orang-orang Farisi?"
 },
 {
   "id": 26388,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 49,
   "firman": "Tetapi orang banyak ini yang tidak mengenal hukum Taurat, terkutuklah mereka!\""
 },
 {
   "id": 26389,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 50,
   "firman": "Nikodemus, seorang dari mereka, yang dahulu telah datang kepada-Nya, berkata kepada mereka:"
 },
 {
   "id": 26390,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 51,
   "firman": "\"Apakah hukum Taurat kita menghukum seseorang, sebelum ia didengar dan sebelum orang mengetahui apa yang telah dibuat-Nya?\""
 },
 {
   "id": 26391,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 52,
   "firman": "Jawab mereka: \"Apakah engkau juga orang Galilea? Selidikilah Kitab Suci dan engkau akan tahu bahwa tidak ada nabi yang datang dari Galilea.\""
 },
 {
   "id": 26392,
   "kitab": "Yoh",
   "pasal": 7,
   "ayat": 53,
   "firman": "Lalu mereka pulang, masing-masing ke rumahnya,"
 },
 {
   "id": 26393,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 1,
   "firman": "tetapi Yesus pergi ke bukit Zaitun."
 },
 {
   "id": 26394,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 2,
   "firman": "Pagi-pagi benar Ia berada lagi di Bait Allah, dan seluruh rakyat datang kepada-Nya. Ia duduk dan mengajar mereka."
 },
 {
   "id": 26395,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 3,
   "firman": "Maka ahli-ahli Taurat dan orang-orang Farisi membawa kepada-Nya seorang perempuan yang kedapatan berbuat zinah."
 },
 {
   "id": 26396,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 4,
   "firman": "Mereka menempatkan perempuan itu di tengah-tengah lalu berkata kepada Yesus: \"Rabi, perempuan ini tertangkap basah ketika ia sedang berbuat zinah."
 },
 {
   "id": 26397,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 5,
   "firman": "Musa dalam hukum Taurat memerintahkan kita untuk melempari perempuan-perempuan yang demikian. Apakah pendapat-Mu tentang hal itu?\""
 },
 {
   "id": 26398,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 6,
   "firman": "Mereka mengatakan hal itu untuk mencobai Dia, supaya mereka memperoleh sesuatu untuk menyalahkan-Nya. Tetapi Yesus membungkuk lalu menulis dengan jari-Nya di tanah."
 },
 {
   "id": 26399,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 7,
   "firman": "Dan ketika mereka terus-menerus bertanya kepada-Nya, Iapun bangkit berdiri lalu berkata kepada mereka: \"Barangsiapa di antara kamu tidak berdosa, hendaklah ia yang pertama melemparkan batu kepada perempuan itu.\""
 },
 {
   "id": 26400,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 8,
   "firman": "Lalu Ia membungkuk pula dan menulis di tanah."
 },
 {
   "id": 26401,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 9,
   "firman": "Tetapi setelah mereka mendengar perkataan itu, pergilah mereka seorang demi seorang, mulai dari yang tertua. Akhirnya tinggallah Yesus seorang diri dengan perempuan itu yang tetap di tempatnya."
 },
 {
   "id": 26402,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 10,
   "firman": "Lalu Yesus bangkit berdiri dan berkata kepadanya: \"Hai perempuan, di manakah mereka? Tidak adakah seorang yang menghukum engkau?\""
 },
 {
   "id": 26403,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 11,
   "firman": "Jawabnya: \"Tidak ada, Tuhan.\" Lalu kata Yesus: \"Akupun tidak menghukum engkau. Pergilah, dan jangan berbuat dosa lagi mulai dari sekarang.\""
 },
 {
   "id": 26404,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 12,
   "firman": "Maka Yesus berkata pula kepada orang banyak, kata-Nya: \"Akulah terang dunia; barangsiapa mengikut Aku, ia tidak akan berjalan dalam kegelapan, melainkan ia akan mempunyai terang hidup.\""
 },
 {
   "id": 26405,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 13,
   "firman": "Kata orang-orang Farisi kepada-Nya: \"Engkau bersaksi tentang diri-Mu, kesaksian-Mu tidak benar.\""
 },
 {
   "id": 26406,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 14,
   "firman": "Jawab Yesus kepada mereka, kata-Nya: \"Biarpun Aku bersaksi tentang diri-Ku sendiri, namun kesaksian-Ku itu benar, sebab Aku tahu, dari mana Aku datang dan ke mana Aku pergi. Tetapi kamu tidak tahu, dari mana Aku datang dan ke mana Aku pergi."
 },
 {
   "id": 26407,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 15,
   "firman": "Kamu menghakimi menurut ukuran manusia, Aku tidak menghakimi seorangpun,"
 },
 {
   "id": 26408,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 16,
   "firman": "dan jikalau Aku menghakimi, maka penghakiman-Ku itu benar, sebab Aku tidak seorang diri, tetapi Aku bersama dengan Dia yang mengutus Aku."
 },
 {
   "id": 26409,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 17,
   "firman": "Dan dalam kitab Tauratmu ada tertulis, bahwa kesaksian dua orang adalah sah;"
 },
 {
   "id": 26410,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 18,
   "firman": "Akulah yang bersaksi tentang diri-Ku sendiri, dan juga Bapa, yang mengutus Aku, bersaksi tentang Aku.\""
 },
 {
   "id": 26411,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 19,
   "firman": "Maka kata mereka kepada-Nya: \"Di manakah Bapa-Mu?\" Jawab Yesus: \"Baik Aku, maupun Bapa-Ku tidak kamu kenal. Jikalau sekiranya kamu mengenal Aku, kamu mengenal juga Bapa-Ku.\""
 },
 {
   "id": 26412,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 20,
   "firman": "Kata-kata itu dikatakan Yesus dekat perbendaharaan, waktu Ia mengajar di dalam Bait Allah. Dan tidak seorangpun yang menangkap Dia, karena saat-Nya belum tiba."
 },
 {
   "id": 26413,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 21,
   "firman": "Maka Yesus berkata pula kepada orang banyak: \"Aku akan pergi dan kamu akan mencari Aku tetapi kamu akan mati dalam dosamu. Ke tempat Aku pergi, tidak mungkin kamu datang.\""
 },
 {
   "id": 26414,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 22,
   "firman": "Maka kata orang-orang Yahudi itu: \"Apakah Ia mau bunuh diri dan karena itu dikatakan-Nya: Ke tempat Aku pergi, tidak mungkin kamu datang?\""
 },
 {
   "id": 26415,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 23,
   "firman": "Lalu Ia berkata kepada mereka: \"Kamu berasal dari bawah, Aku dari atas; kamu dari dunia ini, Aku bukan dari dunia ini."
 },
 {
   "id": 26416,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 24,
   "firman": "Karena itu tadi Aku berkata kepadamu, bahwa kamu akan mati dalam dosamu; sebab jikalau kamu tidak percaya, bahwa Akulah Dia, kamu akan mati dalam dosamu.\""
 },
 {
   "id": 26417,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 25,
   "firman": "Maka kata mereka kepada-Nya: \"Siapakah Engkau?\" Jawab Yesus kepada mereka: \"Apakah gunanya lagi Aku berbicara dengan kamu?"
 },
 {
   "id": 26418,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 26,
   "firman": "Banyak yang harus Kukatakan dan Kuhakimi tentang kamu; akan tetapi Dia, yang mengutus Aku, adalah benar, dan apa yang Kudengar dari pada-Nya, itu yang Kukatakan kepada dunia.\""
 },
 {
   "id": 26419,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 27,
   "firman": "Mereka tidak mengerti, bahwa Ia berbicara kepada mereka tentang Bapa."
 },
 {
   "id": 26420,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 28,
   "firman": "Maka kata Yesus: \"Apabila kamu telah meninggikan Anak Manusia, barulah kamu tahu, bahwa Akulah Dia, dan bahwa Aku tidak berbuat apa-apa dari diri-Ku sendiri, tetapi Aku berbicara tentang hal-hal, sebagaimana diajarkan Bapa kepada-Ku."
 },
 {
   "id": 26421,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 29,
   "firman": "Dan Ia, yang telah mengutus Aku, Ia menyertai Aku. Ia tidak membiarkan Aku sendiri, sebab Aku senantiasa berbuat apa yang berkenan kepada-Nya.\""
 },
 {
   "id": 26422,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 30,
   "firman": "Setelah Yesus mengatakan semuanya itu, banyak orang percaya kepada-Nya."
 },
 {
   "id": 26423,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 31,
   "firman": "Maka kata-Nya kepada orang-orang Yahudi yang percaya kepada-Nya: \"Jikalau kamu tetap dalam firman-Ku, kamu benar-benar adalah murid-Ku"
 },
 {
   "id": 26424,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 32,
   "firman": "dan kamu akan mengetahui kebenaran, dan kebenaran itu akan memerdekakan kamu.\""
 },
 {
   "id": 26425,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 33,
   "firman": "Jawab mereka: \"Kami adalah keturunan Abraham dan tidak pernah menjadi hamba siapapun. Bagaimana Engkau dapat berkata: Kamu akan merdeka?\""
 },
 {
   "id": 26426,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 34,
   "firman": "Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya setiap orang yang berbuat dosa, adalah hamba dosa."
 },
 {
   "id": 26427,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 35,
   "firman": "Dan hamba tidak tetap tinggal dalam rumah, tetapi anak tetap tinggal dalam rumah."
 },
 {
   "id": 26428,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 36,
   "firman": "Jadi apabila Anak itu memerdekakan kamu, kamupun benar-benar merdeka.\""
 },
 {
   "id": 26429,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 37,
   "firman": "\"Aku tahu, bahwa kamu adalah keturunan Abraham, tetapi kamu berusaha untuk membunuh Aku karena firman-Ku tidak beroleh tempat di dalam kamu."
 },
 {
   "id": 26430,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 38,
   "firman": "Apa yang Kulihat pada Bapa, itulah yang Kukatakan, dan demikian juga kamu perbuat tentang apa yang kamu dengar dari bapamu.\""
 },
 {
   "id": 26431,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 39,
   "firman": "Jawab mereka kepada-Nya: \"Bapa kami ialah Abraham.\" Kata Yesus kepada mereka: \"Jikalau sekiranya kamu anak-anak Abraham, tentulah kamu mengerjakan pekerjaan yang dikerjakan oleh Abraham."
 },
 {
   "id": 26432,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 40,
   "firman": "Tetapi yang kamu kerjakan ialah berusaha membunuh Aku; Aku, seorang yang mengatakan kebenaran kepadamu, yaitu kebenaran yang Kudengar dari Allah; pekerjaan yang demikian tidak dikerjakan oleh Abraham."
 },
 {
   "id": 26433,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 41,
   "firman": "Kamu mengerjakan pekerjaan bapamu sendiri.\" Jawab mereka: \"Kami tidak dilahirkan dari zinah. Bapa kami satu, yaitu Allah.\""
 },
 {
   "id": 26434,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 42,
   "firman": "Kata Yesus kepada mereka: \"Jikalau Allah adalah Bapamu, kamu akan mengasihi Aku, sebab Aku keluar dan datang dari Allah. Dan Aku datang bukan atas kehendak-Ku sendiri, melainkan Dialah yang mengutus Aku."
 },
 {
   "id": 26435,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 43,
   "firman": "Apakah sebabnya kamu tidak mengerti bahasa-Ku? Sebab kamu tidak dapat menangkap firman-Ku."
 },
 {
   "id": 26436,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 44,
   "firman": "Iblislah yang menjadi bapamu dan kamu ingin melakukan keinginan-keinginan bapamu. Ia adalah pembunuh manusia sejak semula dan tidak hidup dalam kebenaran, sebab di dalam dia tidak ada kebenaran. Apabila ia berkata dusta, ia berkata atas kehendaknya sendiri, sebab ia adalah pendusta dan bapa segala dusta."
 },
 {
   "id": 26437,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 45,
   "firman": "Tetapi karena Aku mengatakan kebenaran kepadamu, kamu tidak percaya kepada-Ku."
 },
 {
   "id": 26438,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 46,
   "firman": "Siapakah di antaramu yang membuktikan bahwa Aku berbuat dosa? Apabila Aku mengatakan kebenaran, mengapakah kamu tidak percaya kepada-Ku?"
 },
 {
   "id": 26439,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 47,
   "firman": "Barangsiapa berasal dari Allah, ia mendengarkan firman Allah; itulah sebabnya kamu tidak mendengarkannya, karena kamu tidak berasal dari Allah.\""
 },
 {
   "id": 26440,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 48,
   "firman": "Orang-orang Yahudi menjawab Yesus: \"Bukankah benar kalau kami katakan bahwa Engkau orang Samaria dan kerasukan setan?\""
 },
 {
   "id": 26441,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 49,
   "firman": "Jawab Yesus: \"Aku tidak kerasukan setan, tetapi Aku menghormati Bapa-Ku dan kamu tidak menghormati Aku."
 },
 {
   "id": 26442,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 50,
   "firman": "Tetapi Aku tidak mencari hormat bagi-Ku: ada Satu yang mencarinya dan Dia juga yang menghakimi."
 },
 {
   "id": 26443,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 51,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa menuruti firman-Ku, ia tidak akan mengalami maut sampai selama-lamanya.\""
 },
 {
   "id": 26444,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 52,
   "firman": "Kata orang-orang Yahudi kepada-Nya: \"Sekarang kami tahu, bahwa Engkau kerasukan setan. Sebab Abraham telah mati dan demikian juga nabi-nabi, namun Engkau berkata: Barangsiapa menuruti firman-Ku, ia tidak akan mengalami maut sampai selama-lamanya."
 },
 {
   "id": 26445,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 53,
   "firman": "Adakah Engkau lebih besar dari pada bapa kita Abraham, yang telah mati! Nabi-nabipun telah mati; dengan siapakah Engkau samakan diri-Mu?\""
 },
 {
   "id": 26446,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 54,
   "firman": "Jawab Yesus: \"Jikalau Aku memuliakan diri-Ku sendiri, maka kemuliaan-Ku itu sedikitpun tidak ada artinya. Bapa-Kulah yang memuliakan Aku, tentang siapa kamu berkata: Dia adalah Allah kami,"
 },
 {
   "id": 26447,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 55,
   "firman": "padahal kamu tidak mengenal Dia, tetapi Aku mengenal Dia. Dan jika Aku berkata: Aku tidak mengenal Dia, maka Aku adalah pendusta, sama seperti kamu, tetapi Aku mengenal Dia dan Aku menuruti firman-Nya."
 },
 {
   "id": 26448,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 56,
   "firman": "Abraham bapamu bersukacita bahwa ia akan melihat hari-Ku dan ia telah melihatnya dan ia bersukacita.\""
 },
 {
   "id": 26449,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 57,
   "firman": "Maka kata orang-orang Yahudi itu kepada-Nya: \"Umur-Mu belum sampai lima puluh tahun dan Engkau telah melihat Abraham?\""
 },
 {
   "id": 26450,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 58,
   "firman": "Kata Yesus kepada mereka: \"Aku berkata kepadamu, sesungguhnya sebelum Abraham jadi, Aku telah ada.\""
 },
 {
   "id": 26451,
   "kitab": "Yoh",
   "pasal": 8,
   "ayat": 59,
   "firman": "Lalu mereka mengambil batu untuk melempari Dia; tetapi Yesus menghilang dan meninggalkan Bait Allah."
 },
 {
   "id": 26452,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 1,
   "firman": "Waktu Yesus sedang lewat, Ia melihat seorang yang buta sejak lahirnya."
 },
 {
   "id": 26453,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 2,
   "firman": "Murid-murid-Nya bertanya kepada-Nya: \"Rabi, siapakah yang berbuat dosa, orang ini sendiri atau orang tuanya, sehingga ia dilahirkan buta?\""
 },
 {
   "id": 26454,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 3,
   "firman": "Jawab Yesus: \"Bukan dia dan bukan juga orang tuanya, tetapi karena pekerjaan-pekerjaan Allah harus dinyatakan di dalam dia."
 },
 {
   "id": 26455,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 4,
   "firman": "Kita harus mengerjakan pekerjaan Dia yang mengutus Aku, selama masih siang; akan datang malam, di mana tidak ada seorangpun yang dapat bekerja."
 },
 {
   "id": 26456,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 5,
   "firman": "Selama Aku di dalam dunia, Akulah terang dunia.\""
 },
 {
   "id": 26457,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 6,
   "firman": "Setelah Ia mengatakan semuanya itu, Ia meludah ke tanah, dan mengaduk ludahnya itu dengan tanah, lalu mengoleskannya pada mata orang buta tadi"
 },
 {
   "id": 26458,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 7,
   "firman": "dan berkata kepadanya: \"Pergilah, basuhlah dirimu dalam kolam Siloam.\" Siloam artinya: \"Yang diutus.\" Maka pergilah orang itu, ia membasuh dirinya lalu kembali dengan matanya sudah melek."
 },
 {
   "id": 26459,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 8,
   "firman": "Tetapi tetangga-tetangganya dan mereka, yang dahulu mengenalnya sebagai pengemis, berkata: \"Bukankah dia ini, yang selalu mengemis?\""
 },
 {
   "id": 26460,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 9,
   "firman": "Ada yang berkata: \"Benar, dialah ini.\" Ada pula yang berkata: \"Bukan, tetapi ia serupa dengan dia.\" Orang itu sendiri berkata: \"Benar, akulah itu.\""
 },
 {
   "id": 26461,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 10,
   "firman": "Kata mereka kepadanya: \"Bagaimana matamu menjadi melek?\""
 },
 {
   "id": 26462,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 11,
   "firman": "Jawabnya: \"Orang yang disebut Yesus itu mengaduk tanah, mengoleskannya pada mataku dan berkata kepadaku: Pergilah ke Siloam dan basuhlah dirimu. Lalu aku pergi dan setelah aku membasuh diriku, aku dapat melihat.\""
 },
 {
   "id": 26463,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 12,
   "firman": "Lalu mereka berkata kepadanya: \"Di manakah Dia?\" Jawabnya: \"Aku tidak tahu.\""
 },
 {
   "id": 26464,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 13,
   "firman": "Lalu mereka membawa orang yang tadinya buta itu kepada orang-orang Farisi."
 },
 {
   "id": 26465,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 14,
   "firman": "Adapun hari waktu Yesus mengaduk tanah dan memelekkan mata orang itu, adalah hari Sabat."
 },
 {
   "id": 26466,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 15,
   "firman": "Karena itu orang-orang Farisipun bertanya kepadanya, bagaimana matanya menjadi melek. Jawabnya: \"Ia mengoleskan adukan tanah pada mataku, lalu aku membasuh diriku, dan sekarang aku dapat melihat.\""
 },
 {
   "id": 26467,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 16,
   "firman": "Maka kata sebagian orang-orang Farisi itu: \"Orang ini tidak datang dari Allah, sebab Ia tidak memelihara hari Sabat.\" Sebagian pula berkata: \"Bagaimanakah seorang berdosa dapat membuat mujizat yang demikian?\" Maka timbullah pertentangan di antara mereka."
 },
 {
   "id": 26468,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 17,
   "firman": "Lalu kata mereka pula kepada orang buta itu: \"Dan engkau, apakah katamu tentang Dia, karena Ia telah memelekkan matamu?\" Jawabnya: \"Ia adalah seorang nabi.\""
 },
 {
   "id": 26469,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 18,
   "firman": "Tetapi orang-orang Yahudi itu tidak percaya, bahwa tadinya ia buta dan baru dapat melihat lagi, sampai mereka memanggil orang tuanya"
 },
 {
   "id": 26470,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 19,
   "firman": "dan bertanya kepada mereka: \"Inikah anakmu, yang kamu katakan bahwa ia lahir buta? Kalau begitu bagaimanakah ia sekarang dapat melihat?\""
 },
 {
   "id": 26471,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 20,
   "firman": "Jawab orang tua itu: \"Yang kami tahu ialah, bahwa dia ini anak kami dan bahwa ia lahir buta,"
 },
 {
   "id": 26472,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 21,
   "firman": "tetapi bagaimana ia sekarang dapat melihat, kami tidak tahu, dan siapa yang memelekkan matanya, kami tidak tahu juga. Tanyakanlah kepadanya sendiri, ia sudah dewasa, ia dapat berkata-kata untuk dirinya sendiri.\""
 },
 {
   "id": 26473,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 22,
   "firman": "Orang tuanya berkata demikian, karena mereka takut kepada orang-orang Yahudi, sebab orang-orang Yahudi itu telah sepakat bahwa setiap orang yang mengaku Dia sebagai Mesias, akan dikucilkan."
 },
 {
   "id": 26474,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 23,
   "firman": "Itulah sebabnya maka orang tuanya berkata: \"Ia telah dewasa, tanyakanlah kepadanya sendiri.\""
 },
 {
   "id": 26475,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 24,
   "firman": "Lalu mereka memanggil sekali lagi orang yang tadinya buta itu dan berkata kepadanya: \"Katakanlah kebenaran di hadapan Allah; kami tahu bahwa orang itu orang berdosa.\""
 },
 {
   "id": 26476,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 25,
   "firman": "Jawabnya: \"Apakah orang itu orang berdosa, aku tidak tahu; tetapi satu hal aku tahu, yaitu bahwa aku tadinya buta, dan sekarang dapat melihat.\""
 },
 {
   "id": 26477,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 26,
   "firman": "Kata mereka kepadanya: \"Apakah yang diperbuat-Nya padamu? Bagaimana Ia memelekkan matamu?\""
 },
 {
   "id": 26478,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 27,
   "firman": "Jawabnya: \"Telah kukatakan kepadamu, dan kamu tidak mendengarkannya; mengapa kamu hendak mendengarkannya lagi? Barangkali kamu mau menjadi murid-Nya juga?\""
 },
 {
   "id": 26479,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 28,
   "firman": "Sambil mengejek mereka berkata kepadanya: \"Engkau murid orang itu tetapi kami murid-murid Musa."
 },
 {
   "id": 26480,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 29,
   "firman": "Kami tahu, bahwa Allah telah berfirman kepada Musa, tetapi tentang Dia itu kami tidak tahu dari mana Ia datang.\""
 },
 {
   "id": 26481,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 30,
   "firman": "Jawab orang itu kepada mereka: \"Aneh juga bahwa kamu tidak tahu dari mana Ia datang, sedangkan Ia telah memelekkan mataku."
 },
 {
   "id": 26482,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 31,
   "firman": "Kita tahu, bahwa Allah tidak mendengarkan orang-orang berdosa, melainkan orang-orang yang saleh dan yang melakukan kehendak-Nya."
 },
 {
   "id": 26483,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 32,
   "firman": "Dari dahulu sampai sekarang tidak pernah terdengar, bahwa ada orang yang memelekkan mata orang yang lahir buta."
 },
 {
   "id": 26484,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 33,
   "firman": "Jikalau orang itu tidak datang dari Allah, Ia tidak dapat berbuat apa-apa.\""
 },
 {
   "id": 26485,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 34,
   "firman": "Jawab mereka: \"Engkau ini lahir sama sekali dalam dosa dan engkau hendak mengajar kami?\" Lalu mereka mengusir dia ke luar."
 },
 {
   "id": 26486,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 35,
   "firman": "Yesus mendengar bahwa ia telah diusir ke luar oleh mereka. Kemudian Ia bertemu dengan dia dan berkata: \"Percayakah engkau kepada Anak Manusia?\""
 },
 {
   "id": 26487,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 36,
   "firman": "Jawabnya: \"Siapakah Dia, Tuhan? Supaya aku percaya kepada-Nya.\""
 },
 {
   "id": 26488,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 37,
   "firman": "Kata Yesus kepadanya: \"Engkau bukan saja melihat Dia; tetapi Dia yang sedang berkata-kata dengan engkau, Dialah itu!\""
 },
 {
   "id": 26489,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 38,
   "firman": "Katanya: \"Aku percaya, Tuhan!\" Lalu ia sujud menyembah-Nya."
 },
 {
   "id": 26490,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 39,
   "firman": "Kata Yesus: \"Aku datang ke dalam dunia untuk menghakimi, supaya barangsiapa yang tidak melihat, dapat melihat, dan supaya barangsiapa yang dapat melihat, menjadi buta.\""
 },
 {
   "id": 26491,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 40,
   "firman": "Kata-kata itu didengar oleh beberapa orang Farisi yang berada di situ dan mereka berkata kepada-Nya: \"Apakah itu berarti bahwa kami juga buta?\""
 },
 {
   "id": 26492,
   "kitab": "Yoh",
   "pasal": 9,
   "ayat": 41,
   "firman": "Jawab Yesus kepada mereka: \"Sekiranya kamu buta, kamu tidak berdosa, tetapi karena kamu berkata: Kami melihat, maka tetaplah dosamu.\""
 },
 {
   "id": 26493,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 1,
   "firman": "Aku berkata kepadamu: Sesungguhnya siapa yang masuk ke dalam kandang domba dengan tidak melalui pintu, tetapi dengan memanjat tembok, ia adalah seorang pencuri dan seorang perampok;"
 },
 {
   "id": 26494,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 2,
   "firman": "tetapi siapa yang masuk melalui pintu, ia adalah gembala domba."
 },
 {
   "id": 26495,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 3,
   "firman": "Untuk dia penjaga membuka pintu dan domba-domba mendengarkan suaranya dan ia memanggil domba-dombanya masing-masing menurut namanya dan menuntunnya ke luar."
 },
 {
   "id": 26496,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 4,
   "firman": "Jika semua dombanya telah dibawanya ke luar, ia berjalan di depan mereka dan domba-domba itu mengikuti dia, karena mereka mengenal suaranya."
 },
 {
   "id": 26497,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 5,
   "firman": "Tetapi seorang asing pasti tidak mereka ikuti, malah mereka lari dari padanya, karena suara orang-orang asing tidak mereka kenal.\""
 },
 {
   "id": 26498,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 6,
   "firman": "Itulah yang dikatakan Yesus dalam perumpamaan kepada mereka, tetapi mereka tidak mengerti apa maksudnya Ia berkata demikian kepada mereka."
 },
 {
   "id": 26499,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 7,
   "firman": "Maka kata Yesus sekali lagi: \"Aku berkata kepadamu, sesungguhnya Akulah pintu ke domba-domba itu."
 },
 {
   "id": 26500,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 8,
   "firman": "Semua orang yang datang sebelum Aku, adalah pencuri dan perampok, dan domba-domba itu tidak mendengarkan mereka."
 },
 {
   "id": 26501,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 9,
   "firman": "Akulah pintu; barangsiapa masuk melalui Aku, ia akan selamat dan ia akan masuk dan keluar dan menemukan padang rumput."
 },
 {
   "id": 26502,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 10,
   "firman": "Pencuri datang hanya untuk mencuri dan membunuh dan membinasakan; Aku datang, supaya mereka mempunyai hidup, dan mempunyainya dalam segala kelimpahan."
 },
 {
   "id": 26503,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 11,
   "firman": "Akulah gembala yang baik. Gembala yang baik memberikan nyawanya bagi domba-dombanya;"
 },
 {
   "id": 26504,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 12,
   "firman": "sedangkan seorang upahan yang bukan gembala, dan yang bukan pemilik domba-domba itu sendiri, ketika melihat serigala datang, meninggalkan domba-domba itu lalu lari, sehingga serigala itu menerkam dan mencerai-beraikan domba-domba itu."
 },
 {
   "id": 26505,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 13,
   "firman": "Ia lari karena ia seorang upahan dan tidak memperhatikan domba-domba itu."
 },
 {
   "id": 26506,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 14,
   "firman": "Akulah gembala yang baik dan Aku mengenal domba-domba-Ku dan domba-domba-Ku mengenal Aku"
 },
 {
   "id": 26507,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 15,
   "firman": "sama seperti Bapa mengenal Aku dan Aku mengenal Bapa, dan Aku memberikan nyawa-Ku bagi domba-domba-Ku."
 },
 {
   "id": 26508,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 16,
   "firman": "Ada lagi pada-Ku domba-domba lain, yang bukan dari kandang ini; domba-domba itu harus Kutuntun juga dan mereka akan mendengarkan suara-Ku dan mereka akan menjadi satu kawanan dengan satu gembala."
 },
 {
   "id": 26509,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 17,
   "firman": "Bapa mengasihi Aku, oleh karena Aku memberikan nyawa-Ku untuk menerimanya kembali."
 },
 {
   "id": 26510,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 18,
   "firman": "Tidak seorangpun mengambilnya dari pada-Ku, melainkan Aku memberikannya menurut kehendak-Ku sendiri. Aku berkuasa memberikannya dan berkuasa mengambilnya kembali. Inilah tugas yang Kuterima dari Bapa-Ku.\""
 },
 {
   "id": 26511,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 19,
   "firman": "Maka timbullah pula pertentangan di antara orang-orang Yahudi karena perkataan itu. Banyak di antara mereka berkata:"
 },
 {
   "id": 26512,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 20,
   "firman": "\"Ia kerasukan setan dan gila; mengapa kamu mendengarkan Dia?\""
 },
 {
   "id": 26513,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 21,
   "firman": "Yang lain berkata: \"Itu bukan perkataan orang yang kerasukan setan; dapatkah setan memelekkan mata orang-orang buta?\""
 },
 {
   "id": 26514,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 22,
   "firman": "Tidak lama kemudian tibalah hari raya Pentahbisan Bait Allah di Yerusalem; ketika itu musim dingin."
 },
 {
   "id": 26515,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 23,
   "firman": "Dan Yesus berjalan-jalan di Bait Allah, di serambi Salomo."
 },
 {
   "id": 26516,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 24,
   "firman": "Maka orang-orang Yahudi mengelilingi Dia dan berkata kepada-Nya: \"Berapa lama lagi Engkau membiarkan kami hidup dalam kebimbangan? Jikalau Engkau Mesias, katakanlah terus terang kepada kami.\""
 },
 {
   "id": 26517,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 25,
   "firman": "Yesus menjawab mereka: \"Aku telah mengatakannya kepada kamu, tetapi kamu tidak percaya; pekerjaan-pekerjaan yang Kulakukan dalam nama Bapa-Ku, itulah yang memberikan kesaksian tentang Aku,"
 },
 {
   "id": 26518,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 26,
   "firman": "tetapi kamu tidak percaya, karena kamu tidak termasuk domba-domba-Ku."
 },
 {
   "id": 26519,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 27,
   "firman": "Domba-domba-Ku mendengarkan suara-Ku dan Aku mengenal mereka dan mereka mengikut Aku,"
 },
 {
   "id": 26520,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 28,
   "firman": "dan Aku memberikan hidup yang kekal kepada mereka dan mereka pasti tidak akan binasa sampai selama-lamanya dan seorangpun tidak akan merebut mereka dari tangan-Ku."
 },
 {
   "id": 26521,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 29,
   "firman": "Bapa-Ku, yang memberikan mereka kepada-Ku, lebih besar dari pada siapapun, dan seorangpun tidak dapat merebut mereka dari tangan Bapa."
 },
 {
   "id": 26522,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 30,
   "firman": "Aku dan Bapa adalah satu.\""
 },
 {
   "id": 26523,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 31,
   "firman": "Sekali lagi orang-orang Yahudi mengambil batu untuk melempari Yesus."
 },
 {
   "id": 26524,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 32,
   "firman": "Kata Yesus kepada mereka: \"Banyak pekerjaan baik yang berasal dari Bapa-Ku yang Kuperlihatkan kepadamu; pekerjaan manakah di antaranya yang menyebabkan kamu mau melempari Aku?\""
 },
 {
   "id": 26525,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 33,
   "firman": "Jawab orang-orang Yahudi itu: \"Bukan karena suatu pekerjaan baik maka kami mau melempari Engkau, melainkan karena Engkau menghujat Allah dan karena Engkau, sekalipun hanya seorang manusia saja, menyamakan diri-Mu dengan Allah.\""
 },
 {
   "id": 26526,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 34,
   "firman": "Kata Yesus kepada mereka: \"Tidakkah ada tertulis dalam kitab Taurat kamu: Aku telah berfirman: Kamu adalah allah?"
 },
 {
   "id": 26527,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 35,
   "firman": "Jikalau mereka, kepada siapa firman itu disampaikan, disebut allah--sedang Kitab Suci tidak dapat dibatalkan--,"
 },
 {
   "id": 26528,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 36,
   "firman": "masihkah kamu berkata kepada Dia yang dikuduskan oleh Bapa dan yang telah diutus-Nya ke dalam dunia: Engkau menghujat Allah! Karena Aku telah berkata: Aku Anak Allah?"
 },
 {
   "id": 26529,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 37,
   "firman": "Jikalau Aku tidak melakukan pekerjaan-pekerjaan Bapa-Ku, janganlah percaya kepada-Ku,"
 },
 {
   "id": 26530,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 38,
   "firman": "tetapi jikalau Aku melakukannya dan kamu tidak mau percaya kepada-Ku, percayalah akan pekerjaan-pekerjaan itu, supaya kamu boleh mengetahui dan mengerti, bahwa Bapa di dalam Aku dan Aku di dalam Bapa.\""
 },
 {
   "id": 26531,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 39,
   "firman": "Sekali lagi mereka mencoba menangkap Dia, tetapi Ia luput dari tangan mereka."
 },
 {
   "id": 26532,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 40,
   "firman": "Kemudian Yesus pergi lagi ke seberang Yordan, ke tempat Yohanes membaptis dahulu, lalu Ia tinggal di situ."
 },
 {
   "id": 26533,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 41,
   "firman": "Dan banyak orang datang kepada-Nya dan berkata: \"Yohanes memang tidak membuat satu tandapun, tetapi semua yang pernah dikatakan Yohanes tentang orang ini adalah benar.\""
 },
 {
   "id": 26534,
   "kitab": "Yoh",
   "pasal": 10,
   "ayat": 42,
   "firman": "Dan banyak orang di situ percaya kepada-Nya."
 },
 {
   "id": 26535,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 1,
   "firman": "Ada seorang yang sedang sakit, namanya Lazarus. Ia tinggal di Betania, kampung Maria dan adiknya Marta."
 },
 {
   "id": 26536,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 2,
   "firman": "Maria ialah perempuan yang pernah meminyaki kaki Tuhan dengan minyak mur dan menyekanya dengan rambutnya."
 },
 {
   "id": 26537,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 3,
   "firman": "Dan Lazarus yang sakit itu adalah saudaranya. Kedua perempuan itu mengirim kabar kepada Yesus: \"Tuhan, dia yang Engkau kasihi, sakit.\""
 },
 {
   "id": 26538,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 4,
   "firman": "Ketika Yesus mendengar kabar itu, Ia berkata: \"Penyakit itu tidak akan membawa kematian, tetapi akan menyatakan kemuliaan Allah, sebab oleh penyakit itu Anak Allah akan dimuliakan.\""
 },
 {
   "id": 26539,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 5,
   "firman": "Yesus memang mengasihi Marta dan kakaknya dan Lazarus."
 },
 {
   "id": 26540,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 6,
   "firman": "Namun setelah didengar-Nya, bahwa Lazarus sakit, Ia sengaja tinggal dua hari lagi di tempat, di mana Ia berada;"
 },
 {
   "id": 26541,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 7,
   "firman": "tetapi sesudah itu Ia berkata kepada murid-murid-Nya: \"Mari kita kembali lagi ke Yudea.\""
 },
 {
   "id": 26542,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 8,
   "firman": "Murid-murid itu berkata kepada-Nya: \"Rabi, baru-baru ini orang-orang Yahudi mencoba melempari Engkau, masih maukah Engkau kembali ke sana?\""
 },
 {
   "id": 26543,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 9,
   "firman": "Jawab Yesus: \"Bukankah ada dua belas jam dalam satu hari? Siapa yang berjalan pada siang hari, kakinya tidak terantuk, karena ia melihat terang dunia ini."
 },
 {
   "id": 26544,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 10,
   "firman": "Tetapi jikalau seorang berjalan pada malam hari, kakinya terantuk, karena terang tidak ada di dalam dirinya.\""
 },
 {
   "id": 26545,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 11,
   "firman": "Demikianlah perkataan-Nya, dan sesudah itu Ia berkata kepada mereka: \"Lazarus, saudara kita, telah tertidur, tetapi Aku pergi ke sana untuk membangunkan dia dari tidurnya.\""
 },
 {
   "id": 26546,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 12,
   "firman": "Maka kata murid-murid itu kepada-Nya: \"Tuhan, jikalau ia tertidur, ia akan sembuh.\""
 },
 {
   "id": 26547,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 13,
   "firman": "Tetapi maksud Yesus ialah tertidur dalam arti mati, sedangkan sangka mereka Yesus berkata tentang tertidur dalam arti biasa."
 },
 {
   "id": 26548,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 14,
   "firman": "Karena itu Yesus berkata dengan terus terang: \"Lazarus sudah mati;"
 },
 {
   "id": 26549,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 15,
   "firman": "tetapi syukurlah Aku tidak hadir pada waktu itu, sebab demikian lebih baik bagimu, supaya kamu dapat belajar percaya. Marilah kita pergi sekarang kepadanya.\""
 },
 {
   "id": 26550,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 16,
   "firman": "Lalu Tomas, yang disebut Didimus, berkata kepada teman-temannya, yaitu murid-murid yang lain: \"Marilah kita pergi juga untuk mati bersama-sama dengan Dia.\""
 },
 {
   "id": 26551,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 17,
   "firman": "Maka ketika Yesus tiba, didapati-Nya Lazarus telah empat hari berbaring di dalam kubur."
 },
 {
   "id": 26552,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 18,
   "firman": "Betania terletak dekat Yerusalem, kira-kira dua mil jauhnya."
 },
 {
   "id": 26553,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 19,
   "firman": "Di situ banyak orang Yahudi telah datang kepada Marta dan Maria untuk menghibur mereka berhubung dengan kematian saudaranya."
 },
 {
   "id": 26554,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 20,
   "firman": "Ketika Marta mendengar, bahwa Yesus datang, ia pergi mendapatkan-Nya. Tetapi Maria tinggal di rumah."
 },
 {
   "id": 26555,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 21,
   "firman": "Maka kata Marta kepada Yesus: \"Tuhan, sekiranya Engkau ada di sini, saudaraku pasti tidak mati."
 },
 {
   "id": 26556,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 22,
   "firman": "Tetapi sekarangpun aku tahu, bahwa Allah akan memberikan kepada-Mu segala sesuatu yang Engkau minta kepada-Nya.\""
 },
 {
   "id": 26557,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 23,
   "firman": "Kata Yesus kepada Marta: \"Saudaramu akan bangkit.\""
 },
 {
   "id": 26558,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 24,
   "firman": "Kata Marta kepada-Nya: \"Aku tahu bahwa ia akan bangkit pada waktu orang-orang bangkit pada akhir zaman.\""
 },
 {
   "id": 26559,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 25,
   "firman": "Jawab Yesus: \"Akulah kebangkitan dan hidup; barangsiapa percaya kepada-Ku, ia akan hidup walaupun ia sudah mati,"
 },
 {
   "id": 26560,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 26,
   "firman": "dan setiap orang yang hidup dan yang percaya kepada-Ku, tidak akan mati selama-lamanya. Percayakah engkau akan hal ini?\""
 },
 {
   "id": 26561,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 27,
   "firman": "Jawab Marta: \"Ya, Tuhan, aku percaya, bahwa Engkaulah Mesias, Anak Allah, Dia yang akan datang ke dalam dunia.\""
 },
 {
   "id": 26562,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 28,
   "firman": "Dan sesudah berkata demikian ia pergi memanggil saudaranya Maria dan berbisik kepadanya: \"Guru ada di sana dan Ia memanggil engkau.\""
 },
 {
   "id": 26563,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 29,
   "firman": "Mendengar itu Maria segera bangkit lalu pergi mendapatkan Yesus."
 },
 {
   "id": 26564,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 30,
   "firman": "Tetapi waktu itu Yesus belum sampai ke dalam kampung itu. Ia masih berada di tempat Marta menjumpai Dia."
 },
 {
   "id": 26565,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 31,
   "firman": "Ketika orang-orang Yahudi yang bersama-sama dengan Maria di rumah itu untuk menghiburnya, melihat bahwa Maria segera bangkit dan pergi ke luar, mereka mengikutinya, karena mereka menyangka bahwa ia pergi ke kubur untuk meratap di situ."
 },
 {
   "id": 26566,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 32,
   "firman": "Setibanya Maria di tempat Yesus berada dan melihat Dia, tersungkurlah ia di depan kaki-Nya dan berkata kepada-Nya: \"Tuhan, sekiranya Engkau ada di sini, saudaraku pasti tidak mati.\""
 },
 {
   "id": 26567,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 33,
   "firman": "Ketika Yesus melihat Maria menangis dan juga orang-orang Yahudi yang datang bersama-sama dia, maka masygullah hati-Nya. Ia sangat terharu dan berkata:"
 },
 {
   "id": 26568,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 34,
   "firman": "\"Di manakah dia kamu baringkan?\" Jawab mereka: \"Tuhan, marilah dan lihatlah!\""
 },
 {
   "id": 26569,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 35,
   "firman": "Maka menangislah Yesus."
 },
 {
   "id": 26570,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 36,
   "firman": "Kata orang-orang Yahudi: \"Lihatlah, betapa kasih-Nya kepadanya!\""
 },
 {
   "id": 26571,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 37,
   "firman": "Tetapi beberapa orang di antaranya berkata: \"Ia yang memelekkan mata orang buta, tidak sanggupkah Ia bertindak, sehingga orang ini tidak mati?\""
 },
 {
   "id": 26572,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 38,
   "firman": "Maka masygullah pula hati Yesus, lalu Ia pergi ke kubur itu. Kubur itu adalah sebuah gua yang ditutup dengan batu."
 },
 {
   "id": 26573,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 39,
   "firman": "Kata Yesus: \"Angkat batu itu!\" Marta, saudara orang yang meninggal itu, berkata kepada-Nya: \"Tuhan, ia sudah berbau, sebab sudah empat hari ia mati.\""
 },
 {
   "id": 26574,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 40,
   "firman": "Jawab Yesus: \"Bukankah sudah Kukatakan kepadamu: Jikalau engkau percaya engkau akan melihat kemuliaan Allah?\""
 },
 {
   "id": 26575,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 41,
   "firman": "Maka mereka mengangkat batu itu. Lalu Yesus menengadah ke atas dan berkata: \"Bapa, Aku mengucap syukur kepada-Mu, karena Engkau telah mendengarkan Aku."
 },
 {
   "id": 26576,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 42,
   "firman": "Aku tahu, bahwa Engkau selalu mendengarkan Aku, tetapi oleh karena orang banyak yang berdiri di sini mengelilingi Aku, Aku mengatakannya, supaya mereka percaya, bahwa Engkaulah yang telah mengutus Aku.\""
 },
 {
   "id": 26577,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 43,
   "firman": "Dan sesudah berkata demikian, berserulah Ia dengan suara keras: \"Lazarus, marilah ke luar!\""
 },
 {
   "id": 26578,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 44,
   "firman": "Orang yang telah mati itu datang ke luar, kaki dan tangannya masih terikat dengan kain kapan dan mukanya tertutup dengan kain peluh. Kata Yesus kepada mereka: \"Bukalah kain-kain itu dan biarkan ia pergi.\""
 },
 {
   "id": 26579,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 45,
   "firman": "Banyak di antara orang-orang Yahudi yang datang melawat Maria dan yang menyaksikan sendiri apa yang telah dibuat Yesus, percaya kepada-Nya."
 },
 {
   "id": 26580,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 46,
   "firman": "Tetapi ada yang pergi kepada orang-orang Farisi dan menceriterakan kepada mereka, apa yang telah dibuat Yesus itu."
 },
 {
   "id": 26581,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 47,
   "firman": "Lalu imam-imam kepala dan orang-orang Farisi memanggil Mahkamah Agama untuk berkumpul dan mereka berkata: \"Apakah yang harus kita buat? Sebab orang itu membuat banyak mujizat."
 },
 {
   "id": 26582,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 48,
   "firman": "Apabila kita biarkan Dia, maka semua orang akan percaya kepada-Nya dan orang-orang Roma akan datang dan akan merampas tempat suci kita serta bangsa kita.\""
 },
 {
   "id": 26583,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 49,
   "firman": "Tetapi seorang di antara mereka, yaitu Kayafas, Imam Besar pada tahun itu, berkata kepada mereka: \"Kamu tidak tahu apa-apa,"
 },
 {
   "id": 26584,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 50,
   "firman": "dan kamu tidak insaf, bahwa lebih berguna bagimu, jika satu orang mati untuk bangsa kita dari pada seluruh bangsa kita ini binasa.\""
 },
 {
   "id": 26585,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 51,
   "firman": "Hal itu dikatakannya bukan dari dirinya sendiri, tetapi sebagai Imam Besar pada tahun itu ia bernubuat, bahwa Yesus akan mati untuk bangsa itu,"
 },
 {
   "id": 26586,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 52,
   "firman": "dan bukan untuk bangsa itu saja, tetapi juga untuk mengumpulkan dan mempersatukan anak-anak Allah yang tercerai-berai."
 },
 {
   "id": 26587,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 53,
   "firman": "Mulai dari hari itu mereka sepakat untuk membunuh Dia."
 },
 {
   "id": 26588,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 54,
   "firman": "Karena itu Yesus tidak tampil lagi di muka umum di antara orang-orang Yahudi, Ia berangkat dari situ ke daerah dekat padang gurun, ke sebuah kota yang bernama Efraim, dan di situ Ia tinggal bersama-sama murid-murid-Nya."
 },
 {
   "id": 26589,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 55,
   "firman": "Pada waktu itu hari raya Paskah orang Yahudi sudah dekat dan banyak orang dari negeri itu berangkat ke Yerusalem untuk menyucikan diri sebelum Paskah itu."
 },
 {
   "id": 26590,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 56,
   "firman": "Mereka mencari Yesus dan sambil berdiri di dalam Bait Allah, mereka berkata seorang kepada yang lain: \"Bagaimana pendapatmu? Akan datang jugakah Ia ke pesta?\""
 },
 {
   "id": 26591,
   "kitab": "Yoh",
   "pasal": 11,
   "ayat": 57,
   "firman": "Sementara itu imam-imam kepala dan orang-orang Farisi telah memberikan perintah supaya setiap orang yang tahu di mana Dia berada memberitahukannya, agar mereka dapat menangkap Dia."
 },
 {
   "id": 26592,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 1,
   "firman": "Enam hari sebelum Paskah Yesus datang ke Betania, tempat tinggal Lazarus yang dibangkitkan Yesus dari antara orang mati."
 },
 {
   "id": 26593,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 2,
   "firman": "Di situ diadakan perjamuan untuk Dia dan Marta melayani, sedang salah seorang yang turut makan dengan Yesus adalah Lazarus."
 },
 {
   "id": 26594,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 3,
   "firman": "Maka Maria mengambil setengah kati minyak narwastu murni yang mahal harganya, lalu meminyaki kaki Yesus dan menyekanya dengan rambutnya; dan bau minyak semerbak di seluruh rumah itu."
 },
 {
   "id": 26595,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 4,
   "firman": "Tetapi Yudas Iskariot, seorang dari murid-murid Yesus, yang akan segera menyerahkan Dia, berkata:"
 },
 {
   "id": 26596,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 5,
   "firman": "\"Mengapa minyak narwastu ini tidak dijual tiga ratus dinar dan uangnya diberikan kepada orang-orang miskin?\""
 },
 {
   "id": 26597,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 6,
   "firman": "Hal itu dikatakannya bukan karena ia memperhatikan nasib orang-orang miskin, melainkan karena ia adalah seorang pencuri; ia sering mengambil uang yang disimpan dalam kas yang dipegangnya."
 },
 {
   "id": 26598,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 7,
   "firman": "Maka kata Yesus: \"Biarkanlah dia melakukan hal ini mengingat hari penguburan-Ku."
 },
 {
   "id": 26599,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 8,
   "firman": "Karena orang-orang miskin selalu ada pada kamu, tetapi Aku tidak akan selalu ada pada kamu.\""
 },
 {
   "id": 26600,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 9,
   "firman": "Sejumlah besar orang Yahudi mendengar, bahwa Yesus ada di sana dan mereka datang bukan hanya karena Yesus, melainkan juga untuk melihat Lazarus, yang telah dibangkitkan-Nya dari antara orang mati."
 },
 {
   "id": 26601,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 10,
   "firman": "Lalu imam-imam kepala bermupakat untuk membunuh Lazarus juga,"
 },
 {
   "id": 26602,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 11,
   "firman": "sebab karena dia banyak orang Yahudi meninggalkan mereka dan percaya kepada Yesus."
 },
 {
   "id": 26603,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 12,
   "firman": "Keesokan harinya ketika orang banyak yang datang merayakan pesta mendengar, bahwa Yesus sedang di tengah jalan menuju Yerusalem,"
 },
 {
   "id": 26604,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 13,
   "firman": "mereka mengambil daun-daun palem, dan pergi menyongsong Dia sambil berseru-seru: \"Hosana! Diberkatilah Dia yang datang dalam nama Tuhan, Raja Israel!\""
 },
 {
   "id": 26605,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 14,
   "firman": "Yesus menemukan seekor keledai muda lalu Ia naik ke atasnya, seperti ada tertulis:"
 },
 {
   "id": 26606,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 15,
   "firman": "\"Jangan takut, hai puteri Sion, lihatlah, Rajamu datang, duduk di atas seekor anak keledai.\""
 },
 {
   "id": 26607,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 16,
   "firman": "Mula-mula murid-murid Yesus tidak mengerti akan hal itu, tetapi sesudah Yesus dimuliakan, teringatlah mereka, bahwa nas itu mengenai Dia, dan bahwa mereka telah melakukannya juga untuk Dia."
 },
 {
   "id": 26608,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 17,
   "firman": "Orang banyak yang bersama-sama dengan Dia ketika Ia memanggil Lazarus keluar dari kubur dan membangkitkannya dari antara orang mati, memberi kesaksian tentang Dia."
 },
 {
   "id": 26609,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 18,
   "firman": "Sebab itu orang banyak itu pergi menyongsong Dia, karena mereka mendengar, bahwa Ia yang membuat mujizat itu."
 },
 {
   "id": 26610,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 19,
   "firman": "Maka kata orang-orang Farisi seorang kepada yang lain: \"Kamu lihat sendiri, bahwa kamu sama sekali tidak berhasil, lihatlah, seluruh dunia datang mengikuti Dia.\""
 },
 {
   "id": 26611,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 20,
   "firman": "Di antara mereka yang berangkat untuk beribadah pada hari raya itu, terdapat beberapa orang Yunani."
 },
 {
   "id": 26612,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 21,
   "firman": "Orang-orang itu pergi kepada Filipus, yang berasal dari Betsaida di Galilea, lalu berkata kepadanya: \"Tuan, kami ingin bertemu dengan Yesus.\""
 },
 {
   "id": 26613,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 22,
   "firman": "Filipus pergi memberitahukannya kepada Andreas; Andreas dan Filipus menyampaikannya pula kepada Yesus."
 },
 {
   "id": 26614,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 23,
   "firman": "Tetapi Yesus menjawab mereka, kata-Nya: \"Telah tiba saatnya Anak Manusia dimuliakan."
 },
 {
   "id": 26615,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 24,
   "firman": "Aku berkata kepadamu: Sesungguhnya jikalau biji gandum tidak jatuh ke dalam tanah dan mati, ia tetap satu biji saja; tetapi jika ia mati, ia akan menghasilkan banyak buah."
 },
 {
   "id": 26616,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 25,
   "firman": "Barangsiapa mencintai nyawanya, ia akan kehilangan nyawanya, tetapi barangsiapa tidak mencintai nyawanya di dunia ini, ia akan memeliharanya untuk hidup yang kekal."
 },
 {
   "id": 26617,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 26,
   "firman": "Barangsiapa melayani Aku, ia harus mengikut Aku dan di mana Aku berada, di situpun pelayan-Ku akan berada. Barangsiapa melayani Aku, ia akan dihormati Bapa."
 },
 {
   "id": 26618,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 27,
   "firman": "Sekarang jiwa-Ku terharu dan apakah yang akan Kukatakan? Bapa, selamatkanlah Aku dari saat ini? Tidak, sebab untuk itulah Aku datang ke dalam saat ini."
 },
 {
   "id": 26619,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 28,
   "firman": "Bapa, muliakanlah nama-Mu!\" Maka terdengarlah suara dari sorga: \"Aku telah memuliakan-Nya, dan Aku akan memuliakan-Nya lagi!\""
 },
 {
   "id": 26620,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 29,
   "firman": "Orang banyak yang berdiri di situ dan mendengarkannya berkata, bahwa itu bunyi guntur. Ada pula yang berkata: \"Seorang malaikat telah berbicara dengan Dia.\""
 },
 {
   "id": 26621,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 30,
   "firman": "Jawab Yesus: \"Suara itu telah terdengar bukan oleh karena Aku, melainkan oleh karena kamu."
 },
 {
   "id": 26622,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 31,
   "firman": "Sekarang berlangsung penghakiman atas dunia ini: sekarang juga penguasa dunia ini akan dilemparkan ke luar;"
 },
 {
   "id": 26623,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 32,
   "firman": "dan Aku, apabila Aku ditinggikan dari bumi, Aku akan menarik semua orang datang kepada-Ku.\""
 },
 {
   "id": 26624,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 33,
   "firman": "Ini dikatakan-Nya untuk menyatakan bagaimana caranya Ia akan mati."
 },
 {
   "id": 26625,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 34,
   "firman": "Lalu jawab orang banyak itu: \"Kami telah mendengar dari hukum Taurat, bahwa Mesias tetap hidup selama-lamanya; bagaimana mungkin Engkau mengatakan, bahwa Anak Manusia harus ditinggikan? Siapakah Anak Manusia itu?\""
 },
 {
   "id": 26626,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 35,
   "firman": "Kata Yesus kepada mereka: \"Hanya sedikit waktu lagi terang ada di antara kamu. Selama terang itu ada padamu, percayalah kepadanya, supaya kegelapan jangan menguasai kamu; barangsiapa berjalan dalam kegelapan, ia tidak tahu ke mana ia pergi."
 },
 {
   "id": 26627,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 36,
   "firman": "Percayalah kepada terang itu, selama terang itu ada padamu, supaya kamu menjadi anak-anak terang.\" Sesudah berkata demikian, Yesus pergi bersembunyi dari antara mereka."
 },
 {
   "id": 26628,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 37,
   "firman": "Dan meskipun Yesus mengadakan begitu banyak mujizat di depan mata mereka, namun mereka tidak percaya kepada-Nya,"
 },
 {
   "id": 26629,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 38,
   "firman": "supaya genaplah firman yang disampaikan oleh nabi Yesaya: \"Tuhan, siapakah yang percaya kepada pemberitaan kami? Dan kepada siapakah tangan kekuasaan Tuhan dinyatakan?\""
 },
 {
   "id": 26630,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 39,
   "firman": "Karena itu mereka tidak dapat percaya, sebab Yesaya telah berkata juga:"
 },
 {
   "id": 26631,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 40,
   "firman": "\"Ia telah membutakan mata dan mendegilkan hati mereka, supaya mereka jangan melihat dengan mata, dan menanggap dengan hati, lalu berbalik, sehingga Aku menyembuhkan mereka.\""
 },
 {
   "id": 26632,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 41,
   "firman": "Hal ini dikatakan oleh Yesaya, karena ia telah melihat kemuliaan-Nya dan telah berkata-kata tentang Dia."
 },
 {
   "id": 26633,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 42,
   "firman": "Namun banyak juga di antara pemimpin yang percaya kepada-Nya, tetapi oleh karena orang-orang Farisi mereka tidak mengakuinya berterus terang, supaya mereka jangan dikucilkan."
 },
 {
   "id": 26634,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 43,
   "firman": "Sebab mereka lebih suka akan kehormatan manusia dari pada kehormatan Allah."
 },
 {
   "id": 26635,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 44,
   "firman": "Tetapi Yesus berseru kata-Nya: \"Barangsiapa percaya kepada-Ku, ia bukan percaya kepada-Ku, tetapi kepada Dia, yang telah mengutus Aku;"
 },
 {
   "id": 26636,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 45,
   "firman": "dan barangsiapa melihat Aku, ia melihat Dia, yang telah mengutus Aku."
 },
 {
   "id": 26637,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 46,
   "firman": "Aku telah datang ke dalam dunia sebagai terang, supaya setiap orang yang percaya kepada-Ku, jangan tinggal di dalam kegelapan."
 },
 {
   "id": 26638,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 47,
   "firman": "Dan jikalau seorang mendengar perkataan-Ku, tetapi tidak melakukannya, Aku tidak menjadi hakimnya, sebab Aku datang bukan untuk menghakimi dunia, melainkan untuk menyelamatkannya."
 },
 {
   "id": 26639,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 48,
   "firman": "Barangsiapa menolak Aku, dan tidak menerima perkataan-Ku, ia sudah ada hakimnya, yaitu firman yang telah Kukatakan, itulah yang akan menjadi hakimnya pada akhir zaman."
 },
 {
   "id": 26640,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 49,
   "firman": "Sebab Aku berkata-kata bukan dari diri-Ku sendiri, tetapi Bapa, yang mengutus Aku, Dialah yang memerintahkan Aku untuk mengatakan apa yang harus Aku katakan dan Aku sampaikan."
 },
 {
   "id": 26641,
   "kitab": "Yoh",
   "pasal": 12,
   "ayat": 50,
   "firman": "Dan Aku tahu, bahwa perintah-Nya itu adalah hidup yang kekal. Jadi apa yang Aku katakan, Aku menyampaikannya sebagaimana yang difirmankan oleh Bapa kepada-Ku.\""
 },
 {
   "id": 26642,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 1,
   "firman": "Sementara itu sebelum hari raya Paskah mulai, Yesus telah tahu, bahwa saat-Nya sudah tiba untuk beralih dari dunia ini kepada Bapa. Sama seperti Ia senantiasa mengasihi murid-murid-Nya demikianlah sekarang Ia mengasihi mereka sampai kepada kesudahannya."
 },
 {
   "id": 26643,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 2,
   "firman": "Mereka sedang makan bersama, dan Iblis telah membisikkan rencana dalam hati Yudas Iskariot, anak Simon, untuk mengkhianati Dia."
 },
 {
   "id": 26644,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 3,
   "firman": "Yesus tahu, bahwa Bapa-Nya telah menyerahkan segala sesuatu kepada-Nya dan bahwa Ia datang dari Allah dan kembali kepada Allah."
 },
 {
   "id": 26645,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 4,
   "firman": "Lalu bangunlah Yesus dan menanggalkan jubah-Nya. Ia mengambil sehelai kain lenan dan mengikatkannya pada pinggang-Nya,"
 },
 {
   "id": 26646,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 5,
   "firman": "kemudian Ia menuangkan air ke dalam sebuah basi, dan mulai membasuh kaki murid-murid-Nya lalu menyekanya dengan kain yang terikat pada pinggang-Nya itu."
 },
 {
   "id": 26647,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 6,
   "firman": "Maka sampailah Ia kepada Simon Petrus. Kata Petrus kepada-Nya: \"Tuhan, Engkau hendak membasuh kakiku?\""
 },
 {
   "id": 26648,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 7,
   "firman": "Jawab Yesus kepadanya: \"Apa yang Kuperbuat, engkau tidak tahu sekarang, tetapi engkau akan mengertinya kelak.\""
 },
 {
   "id": 26649,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 8,
   "firman": "Kata Petrus kepada-Nya: \"Engkau tidak akan membasuh kakiku sampai selama-lamanya.\" Jawab Yesus: \"Jikalau Aku tidak membasuh engkau, engkau tidak mendapat bagian dalam Aku.\""
 },
 {
   "id": 26650,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 9,
   "firman": "Kata Simon Petrus kepada-Nya: \"Tuhan, jangan hanya kakiku saja, tetapi juga tangan dan kepalaku!\""
 },
 {
   "id": 26651,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kata Yesus kepadanya: \"Barangsiapa telah mandi, ia tidak usah membasuh diri lagi selain membasuh kakinya, karena ia sudah bersih seluruhnya. Juga kamu sudah bersih, hanya tidak semua.\""
 },
 {
   "id": 26652,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 11,
   "firman": "Sebab Ia tahu, siapa yang akan menyerahkan Dia. Karena itu Ia berkata: \"Tidak semua kamu bersih.\""
 },
 {
   "id": 26653,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 12,
   "firman": "Sesudah Ia membasuh kaki mereka, Ia mengenakan pakaian-Nya dan kembali ke tempat-Nya. Lalu Ia berkata kepada mereka: \"Mengertikah kamu apa yang telah Kuperbuat kepadamu?"
 },
 {
   "id": 26654,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 13,
   "firman": "Kamu menyebut Aku Guru dan Tuhan, dan katamu itu tepat, sebab memang Akulah Guru dan Tuhan."
 },
 {
   "id": 26655,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 14,
   "firman": "Jadi jikalau Aku membasuh kakimu, Aku yang adalah Tuhan dan Gurumu, maka kamupun wajib saling membasuh kakimu;"
 },
 {
   "id": 26656,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 15,
   "firman": "sebab Aku telah memberikan suatu teladan kepada kamu, supaya kamu juga berbuat sama seperti yang telah Kuperbuat kepadamu."
 },
 {
   "id": 26657,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 16,
   "firman": "Aku berkata kepadamu: Sesungguhnya seorang hamba tidaklah lebih tinggi dari pada tuannya, ataupun seorang utusan dari pada dia yang mengutusnya."
 },
 {
   "id": 26658,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 17,
   "firman": "Jikalau kamu tahu semua ini, maka berbahagialah kamu, jika kamu melakukannya."
 },
 {
   "id": 26659,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 18,
   "firman": "Bukan tentang kamu semua Aku berkata. Aku tahu, siapa yang telah Kupilih. Tetapi haruslah genap nas ini: Orang yang makan roti-Ku, telah mengangkat tumitnya terhadap Aku."
 },
 {
   "id": 26660,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 19,
   "firman": "Aku mengatakannya kepadamu sekarang juga sebelum hal itu terjadi, supaya jika hal itu terjadi, kamu percaya, bahwa Akulah Dia."
 },
 {
   "id": 26661,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 20,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa menerima orang yang Kuutus, ia menerima Aku, dan barangsiapa menerima Aku, ia menerima Dia yang mengutus Aku.\""
 },
 {
   "id": 26662,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 21,
   "firman": "Setelah Yesus berkata demikian Ia sangat terharu, lalu bersaksi: \"Aku berkata kepadamu, sesungguhnya seorang di antara kamu akan menyerahkan Aku.\""
 },
 {
   "id": 26663,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 22,
   "firman": "Murid-murid itu memandang seorang kepada yang lain, mereka ragu-ragu siapa yang dimaksudkan-Nya."
 },
 {
   "id": 26664,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 23,
   "firman": "Seorang di antara murid Yesus, yaitu murid yang dikasihi-Nya, bersandar dekat kepada-Nya, di sebelah kanan-Nya."
 },
 {
   "id": 26665,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 24,
   "firman": "Kepada murid itu Simon Petrus memberi isyarat dan berkata: \"Tanyalah siapa yang dimaksudkan-Nya!\""
 },
 {
   "id": 26666,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 25,
   "firman": "Murid yang duduk dekat Yesus itu berpaling dan berkata kepada-Nya: \"Tuhan, siapakah itu?\""
 },
 {
   "id": 26667,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 26,
   "firman": "Jawab Yesus: \"Dialah itu, yang kepadanya Aku akan memberikan roti, sesudah Aku mencelupkannya.\" Sesudah berkata demikian Ia mengambil roti, mencelupkannya dan memberikannya kepada Yudas, anak Simon Iskariot."
 },
 {
   "id": 26668,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 27,
   "firman": "Dan sesudah Yudas menerima roti itu, ia kerasukan Iblis. Maka Yesus berkata kepadanya: \"Apa yang hendak kauperbuat, perbuatlah dengan segera.\""
 },
 {
   "id": 26669,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 28,
   "firman": "Tetapi tidak ada seorangpun dari antara mereka yang duduk makan itu mengerti, apa maksud Yesus mengatakan itu kepada Yudas."
 },
 {
   "id": 26670,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 29,
   "firman": "Karena Yudas memegang kas ada yang menyangka, bahwa Yesus menyuruh dia membeli apa-apa yang perlu untuk perayaan itu, atau memberi apa-apa kepada orang miskin."
 },
 {
   "id": 26671,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 30,
   "firman": "Yudas menerima roti itu lalu segera pergi. Pada waktu itu hari sudah malam."
 },
 {
   "id": 26672,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 31,
   "firman": "Sesudah Yudas pergi, berkatalah Yesus: \"Sekarang Anak Manusia dipermuliakan dan Allah dipermuliakan di dalam Dia."
 },
 {
   "id": 26673,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 32,
   "firman": "Jikalau Allah dipermuliakan di dalam Dia, Allah akan mempermuliakan Dia juga di dalam diri-Nya, dan akan mempermuliakan Dia dengan segera."
 },
 {
   "id": 26674,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 33,
   "firman": "Hai anak-anak-Ku, hanya seketika saja lagi Aku ada bersama kamu. Kamu akan mencari Aku, dan seperti yang telah Kukatakan kepada orang-orang Yahudi: Ke tempat Aku pergi, tidak mungkin kamu datang, demikian pula Aku mengatakannya sekarang juga kepada kamu."
 },
 {
   "id": 26675,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 34,
   "firman": "Aku memberikan perintah baru kepada kamu, yaitu supaya kamu saling mengasihi; sama seperti Aku telah mengasihi kamu demikian pula kamu harus saling mengasihi."
 },
 {
   "id": 26676,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 35,
   "firman": "Dengan demikian semua orang akan tahu, bahwa kamu adalah murid-murid-Ku, yaitu jikalau kamu saling mengasihi.\""
 },
 {
   "id": 26677,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 36,
   "firman": "Simon Petrus berkata kepada Yesus: \"Tuhan, ke manakah Engkau pergi?\" Jawab Yesus: \"Ke tempat Aku pergi, engkau tidak dapat mengikuti Aku sekarang, tetapi kelak engkau akan mengikuti Aku.\""
 },
 {
   "id": 26678,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 37,
   "firman": "Kata Petrus kepada-Nya: \"Tuhan, mengapa aku tidak dapat mengikuti Engkau sekarang? Aku akan memberikan nyawaku bagi-Mu!\""
 },
 {
   "id": 26679,
   "kitab": "Yoh",
   "pasal": 13,
   "ayat": 38,
   "firman": "Jawab Yesus: \"Nyawamu akan kauberikan bagi-Ku? Sesungguhnya Aku berkata kepadamu: Sebelum ayam berkokok, engkau telah menyangkal Aku tiga kali.\""
 },
 {
   "id": 26680,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 1,
   "firman": "\"Janganlah gelisah hatimu; percayalah kepada Allah, percayalah juga kepada-Ku."
 },
 {
   "id": 26681,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 2,
   "firman": "Di rumah Bapa-Ku banyak tempat tinggal. Jika tidak demikian, tentu Aku mengatakannya kepadamu. Sebab Aku pergi ke situ untuk menyediakan tempat bagimu."
 },
 {
   "id": 26682,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 3,
   "firman": "Dan apabila Aku telah pergi ke situ dan telah menyediakan tempat bagimu, Aku akan datang kembali dan membawa kamu ke tempat-Ku, supaya di tempat di mana Aku berada, kamupun berada."
 },
 {
   "id": 26683,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 4,
   "firman": "Dan ke mana Aku pergi, kamu tahu jalan ke situ.\""
 },
 {
   "id": 26684,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 5,
   "firman": "Kata Tomas kepada-Nya: \"Tuhan, kami tidak tahu ke mana Engkau pergi; jadi bagaimana kami tahu jalan ke situ?\""
 },
 {
   "id": 26685,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 6,
   "firman": "Kata Yesus kepadanya: \"Akulah jalan dan kebenaran dan hidup. Tidak ada seorangpun yang datang kepada Bapa, kalau tidak melalui Aku."
 },
 {
   "id": 26686,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 7,
   "firman": "Sekiranya kamu mengenal Aku, pasti kamu juga mengenal Bapa-Ku. Sekarang ini kamu mengenal Dia dan kamu telah melihat Dia.\""
 },
 {
   "id": 26687,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 8,
   "firman": "Kata Filipus kepada-Nya: \"Tuhan, tunjukkanlah Bapa itu kepada kami, itu sudah cukup bagi kami.\""
 },
 {
   "id": 26688,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 9,
   "firman": "Kata Yesus kepadanya: \"Telah sekian lama Aku bersama-sama kamu, Filipus, namun engkau tidak mengenal Aku? Barangsiapa telah melihat Aku, ia telah melihat Bapa; bagaimana engkau berkata: Tunjukkanlah Bapa itu kepada kami."
 },
 {
   "id": 26689,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 10,
   "firman": "Tidak percayakah engkau, bahwa Aku di dalam Bapa dan Bapa di dalam Aku? Apa yang Aku katakan kepadamu, tidak Aku katakan dari diri-Ku sendiri, tetapi Bapa, yang diam di dalam Aku, Dialah yang melakukan pekerjaan-Nya."
 },
 {
   "id": 26690,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 11,
   "firman": "Percayalah kepada-Ku, bahwa Aku di dalam Bapa dan Bapa di dalam Aku; atau setidak-tidaknya, percayalah karena pekerjaan-pekerjaan itu sendiri."
 },
 {
   "id": 26691,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 12,
   "firman": "Aku berkata kepadamu: Sesungguhnya barangsiapa percaya kepada-Ku, ia akan melakukan juga pekerjaan-pekerjaan yang Aku lakukan, bahkan pekerjaan-pekerjaan yang lebih besar dari pada itu. Sebab Aku pergi kepada Bapa;"
 },
 {
   "id": 26692,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 13,
   "firman": "dan apa juga yang kamu minta dalam nama-Ku, Aku akan melakukannya, supaya Bapa dipermuliakan di dalam Anak."
 },
 {
   "id": 26693,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 14,
   "firman": "Jika kamu meminta sesuatu kepada-Ku dalam nama-Ku, Aku akan melakukannya.\""
 },
 {
   "id": 26694,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 15,
   "firman": "\"Jikalau kamu mengasihi Aku, kamu akan menuruti segala perintah-Ku."
 },
 {
   "id": 26695,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 16,
   "firman": "Aku akan minta kepada Bapa, dan Ia akan memberikan kepadamu seorang Penolong yang lain, supaya Ia menyertai kamu selama-lamanya,"
 },
 {
   "id": 26696,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 17,
   "firman": "yaitu Roh Kebenaran. Dunia tidak dapat menerima Dia, sebab dunia tidak melihat Dia dan tidak mengenal Dia. Tetapi kamu mengenal Dia, sebab Ia menyertai kamu dan akan diam di dalam kamu."
 },
 {
   "id": 26697,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 18,
   "firman": "Aku tidak akan meninggalkan kamu sebagai yatim piatu. Aku datang kembali kepadamu."
 },
 {
   "id": 26698,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 19,
   "firman": "Tinggal sesaat lagi dan dunia tidak akan melihat Aku lagi, tetapi kamu melihat Aku, sebab Aku hidup dan kamupun akan hidup."
 },
 {
   "id": 26699,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 20,
   "firman": "Pada waktu itulah kamu akan tahu, bahwa Aku di dalam Bapa-Ku dan kamu di dalam Aku dan Aku di dalam kamu."
 },
 {
   "id": 26700,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 21,
   "firman": "Barangsiapa memegang perintah-Ku dan melakukannya, dialah yang mengasihi Aku. Dan barangsiapa mengasihi Aku, ia akan dikasihi oleh Bapa-Ku dan Akupun akan mengasihi dia dan akan menyatakan diri-Ku kepadanya.\""
 },
 {
   "id": 26701,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 22,
   "firman": "Yudas, yang bukan Iskariot, berkata kepada-Nya: \"Tuhan, apakah sebabnya maka Engkau hendak menyatakan diri-Mu kepada kami, dan bukan kepada dunia?\""
 },
 {
   "id": 26702,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 23,
   "firman": "Jawab Yesus: \"Jika seorang mengasihi Aku, ia akan menuruti firman-Ku dan Bapa-Ku akan mengasihi dia dan Kami akan datang kepadanya dan diam bersama-sama dengan dia."
 },
 {
   "id": 26703,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 24,
   "firman": "Barangsiapa tidak mengasihi Aku, ia tidak menuruti firman-Ku; dan firman yang kamu dengar itu bukanlah dari pada-Ku, melainkan dari Bapa yang mengutus Aku."
 },
 {
   "id": 26704,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 25,
   "firman": "Semuanya itu Kukatakan kepadamu, selagi Aku berada bersama-sama dengan kamu;"
 },
 {
   "id": 26705,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 26,
   "firman": "tetapi Penghibur, yaitu Roh Kudus, yang akan diutus oleh Bapa dalam nama-Ku, Dialah yang akan mengajarkan segala sesuatu kepadamu dan akan mengingatkan kamu akan semua yang telah Kukatakan kepadamu."
 },
 {
   "id": 26706,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 27,
   "firman": "Damai sejahtera Kutinggalkan bagimu. Damai sejahtera-Ku Kuberikan kepadamu, dan apa yang Kuberikan tidak seperti yang diberikan oleh dunia kepadamu. Janganlah gelisah dan gentar hatimu."
 },
 {
   "id": 26707,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 28,
   "firman": "Kamu telah mendengar, bahwa Aku telah berkata kepadamu: Aku pergi, tetapi Aku datang kembali kepadamu. Sekiranya kamu mengasihi Aku, kamu tentu akan bersukacita karena Aku pergi kepada Bapa-Ku, sebab Bapa lebih besar dari pada Aku."
 },
 {
   "id": 26708,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 29,
   "firman": "Dan sekarang juga Aku mengatakannya kepadamu sebelum hal itu terjadi, supaya kamu percaya, apabila hal itu terjadi."
 },
 {
   "id": 26709,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 30,
   "firman": "Tidak banyak lagi Aku berkata-kata dengan kamu, sebab penguasa dunia ini datang dan ia tidak berkuasa sedikitpun atas diri-Ku."
 },
 {
   "id": 26710,
   "kitab": "Yoh",
   "pasal": 14,
   "ayat": 31,
   "firman": "Tetapi supaya dunia tahu, bahwa Aku mengasihi Bapa dan bahwa Aku melakukan segala sesuatu seperti yang diperintahkan Bapa kepada-Ku, bangunlah, marilah kita pergi dari sini.\""
 },
 {
   "id": 26711,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 1,
   "firman": "\"Akulah pokok anggur yang benar dan Bapa-Kulah pengusahanya."
 },
 {
   "id": 26712,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 2,
   "firman": "Setiap ranting pada-Ku yang tidak berbuah, dipotong-Nya dan setiap ranting yang berbuah, dibersihkan-Nya, supaya ia lebih banyak berbuah."
 },
 {
   "id": 26713,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 3,
   "firman": "Kamu memang sudah bersih karena firman yang telah Kukatakan kepadamu."
 },
 {
   "id": 26714,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 4,
   "firman": "Tinggallah di dalam Aku dan Aku di dalam kamu. Sama seperti ranting tidak dapat berbuah dari dirinya sendiri, kalau ia tidak tinggal pada pokok anggur, demikian juga kamu tidak berbuah, jikalau kamu tidak tinggal di dalam Aku."
 },
 {
   "id": 26715,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 5,
   "firman": "Akulah pokok anggur dan kamulah ranting-rantingnya. Barangsiapa tinggal di dalam Aku dan Aku di dalam dia, ia berbuah banyak, sebab di luar Aku kamu tidak dapat berbuat apa-apa."
 },
 {
   "id": 26716,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 6,
   "firman": "Barangsiapa tidak tinggal di dalam Aku, ia dibuang ke luar seperti ranting dan menjadi kering, kemudian dikumpulkan orang dan dicampakkan ke dalam api lalu dibakar."
 },
 {
   "id": 26717,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 7,
   "firman": "Jikalau kamu tinggal di dalam Aku dan firman-Ku tinggal di dalam kamu, mintalah apa saja yang kamu kehendaki, dan kamu akan menerimanya."
 },
 {
   "id": 26718,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dalam hal inilah Bapa-Ku dipermuliakan, yaitu jika kamu berbuah banyak dan dengan demikian kamu adalah murid-murid-Ku.\""
 },
 {
   "id": 26719,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 9,
   "firman": "\"Seperti Bapa telah mengasihi Aku, demikianlah juga Aku telah mengasihi kamu; tinggallah di dalam kasih-Ku itu."
 },
 {
   "id": 26720,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 10,
   "firman": "Jikalau kamu menuruti perintah-Ku, kamu akan tinggal di dalam kasih-Ku, seperti Aku menuruti perintah Bapa-Ku dan tinggal di dalam kasih-Nya."
 },
 {
   "id": 26721,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 11,
   "firman": "Semuanya itu Kukatakan kepadamu, supaya sukacita-Ku ada di dalam kamu dan sukacitamu menjadi penuh."
 },
 {
   "id": 26722,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 12,
   "firman": "Inilah perintah-Ku, yaitu supaya kamu saling mengasihi, seperti Aku telah mengasihi kamu."
 },
 {
   "id": 26723,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 13,
   "firman": "Tidak ada kasih yang lebih besar dari pada kasih seorang yang memberikan nyawanya untuk sahabat-sahabatnya."
 },
 {
   "id": 26724,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 14,
   "firman": "Kamu adalah sahabat-Ku, jikalau kamu berbuat apa yang Kuperintahkan kepadamu."
 },
 {
   "id": 26725,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 15,
   "firman": "Aku tidak menyebut kamu lagi hamba, sebab hamba tidak tahu, apa yang diperbuat oleh tuannya, tetapi Aku menyebut kamu sahabat, karena Aku telah memberitahukan kepada kamu segala sesuatu yang telah Kudengar dari Bapa-Ku."
 },
 {
   "id": 26726,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 16,
   "firman": "Bukan kamu yang memilih Aku, tetapi Akulah yang memilih kamu. Dan Aku telah menetapkan kamu, supaya kamu pergi dan menghasilkan buah dan buahmu itu tetap, supaya apa yang kamu minta kepada Bapa dalam nama-Ku, diberikan-Nya kepadamu."
 },
 {
   "id": 26727,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 17,
   "firman": "Inilah perintah-Ku kepadamu: Kasihilah seorang akan yang lain.\""
 },
 {
   "id": 26728,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 18,
   "firman": "\"Jikalau dunia membenci kamu, ingatlah bahwa ia telah lebih dahulu membenci Aku dari pada kamu."
 },
 {
   "id": 26729,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 19,
   "firman": "Sekiranya kamu dari dunia, tentulah dunia mengasihi kamu sebagai miliknya. Tetapi karena kamu bukan dari dunia, melainkan Aku telah memilih kamu dari dunia, sebab itulah dunia membenci kamu."
 },
 {
   "id": 26730,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 20,
   "firman": "Ingatlah apa yang telah Kukatakan kepadamu: Seorang hamba tidaklah lebih tinggi dari pada tuannya. Jikalau mereka telah menganiaya Aku, mereka juga akan menganiaya kamu; jikalau mereka telah menuruti firman-Ku, mereka juga akan menuruti perkataanmu."
 },
 {
   "id": 26731,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 21,
   "firman": "Tetapi semuanya itu akan mereka lakukan terhadap kamu karena nama-Ku, sebab mereka tidak mengenal Dia, yang telah mengutus Aku."
 },
 {
   "id": 26732,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 22,
   "firman": "Sekiranya Aku tidak datang dan tidak berkata-kata kepada mereka, mereka tentu tidak berdosa. Tetapi sekarang mereka tidak mempunyai dalih bagi dosa mereka!"
 },
 {
   "id": 26733,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 23,
   "firman": "Barangsiapa membenci Aku, ia membenci juga Bapa-Ku."
 },
 {
   "id": 26734,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 24,
   "firman": "Sekiranya Aku tidak melakukan pekerjaan di tengah-tengah mereka seperti yang tidak pernah dilakukan orang lain, mereka tentu tidak berdosa. Tetapi sekarang walaupun mereka telah melihat semuanya itu, namun mereka membenci baik Aku maupun Bapa-Ku."
 },
 {
   "id": 26735,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 25,
   "firman": "Tetapi firman yang ada tertulis dalam kitab Taurat mereka harus digenapi: Mereka membenci Aku tanpa alasan."
 },
 {
   "id": 26736,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 26,
   "firman": "Jikalau Penghibur yang akan Kuutus dari Bapa datang, yaitu Roh Kebenaran yang keluar dari Bapa, Ia akan bersaksi tentang Aku."
 },
 {
   "id": 26737,
   "kitab": "Yoh",
   "pasal": 15,
   "ayat": 27,
   "firman": "Tetapi kamu juga harus bersaksi, karena kamu dari semula bersama-sama dengan Aku.\""
 },
 {
   "id": 26738,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 1,
   "firman": "\"Semuanya ini Kukatakan kepadamu, supaya kamu jangan kecewa dan menolak Aku."
 },
 {
   "id": 26739,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 2,
   "firman": "Kamu akan dikucilkan, bahkan akan datang saatnya bahwa setiap orang yang membunuh kamu akan menyangka bahwa ia berbuat bakti bagi Allah."
 },
 {
   "id": 26740,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 3,
   "firman": "Mereka akan berbuat demikian, karena mereka tidak mengenal baik Bapa maupun Aku."
 },
 {
   "id": 26741,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 4,
   "firman": "Tetapi semuanya ini Kukatakan kepadamu, supaya apabila datang saatnya kamu ingat, bahwa Aku telah mengatakannya kepadamu.\""
 },
 {
   "id": 26743,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 5,
   "firman": "tetapi sekarang Aku pergi kepada Dia yang telah mengutus Aku, dan tiada seorangpun di antara kamu yang bertanya kepada-Ku: Ke mana Engkau pergi?"
 },
 {
   "id": 26744,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 6,
   "firman": "Tetapi karena Aku mengatakan hal itu kepadamu, sebab itu hatimu berdukacita."
 },
 {
   "id": 26745,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 7,
   "firman": "Namun benar yang Kukatakan ini kepadamu: Adalah lebih berguna bagi kamu, jika Aku pergi. Sebab jikalau Aku tidak pergi, Penghibur itu tidak akan datang kepadamu, tetapi jikalau Aku pergi, Aku akan mengutus Dia kepadamu."
 },
 {
   "id": 26746,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 8,
   "firman": "Dan kalau Ia datang, Ia akan menginsafkan dunia akan dosa, kebenaran dan penghakiman;"
 },
 {
   "id": 26747,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 9,
   "firman": "akan dosa, karena mereka tetap tidak percaya kepada-Ku;"
 },
 {
   "id": 26748,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 10,
   "firman": "akan kebenaran, karena Aku pergi kepada Bapa dan kamu tidak melihat Aku lagi;"
 },
 {
   "id": 26749,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 11,
   "firman": "akan penghakiman, karena penguasa dunia ini telah dihukum."
 },
 {
   "id": 26750,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 12,
   "firman": "Masih banyak hal yang harus Kukatakan kepadamu, tetapi sekarang kamu belum dapat menanggungnya."
 },
 {
   "id": 26751,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 13,
   "firman": "Tetapi apabila Ia datang, yaitu Roh Kebenaran, Ia akan memimpin kamu ke dalam seluruh kebenaran; sebab Ia tidak akan berkata-kata dari diri-Nya sendiri, tetapi segala sesuatu yang didengar-Nya itulah yang akan dikatakan-Nya dan Ia akan memberitakan kepadamu hal-hal yang akan datang."
 },
 {
   "id": 26752,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 14,
   "firman": "Ia akan memuliakan Aku, sebab Ia akan memberitakan kepadamu apa yang diterimanya dari pada-Ku."
 },
 {
   "id": 26753,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 15,
   "firman": "Segala sesuatu yang Bapa punya, adalah Aku punya; sebab itu Aku berkata: Ia akan memberitakan kepadamu apa yang diterimanya dari pada-Ku.\""
 },
 {
   "id": 26754,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 16,
   "firman": "\"Tinggal sesaat saja dan kamu tidak melihat Aku lagi dan tinggal sesaat saja pula dan kamu akan melihat Aku.\""
 },
 {
   "id": 26755,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 17,
   "firman": "Mendengar itu beberapa dari murid-Nya berkata seorang kepada yang lain: \"Apakah artinya Ia berkata kepada kita: Tinggal sesaat saja dan kamu tidak melihat Aku dan tinggal sesaat saja pula dan kamu akan melihat Aku? Dan: Aku pergi kepada Bapa?\""
 },
 {
   "id": 26756,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 18,
   "firman": "Maka kata mereka: \"Apakah artinya Ia berkata: Tinggal sesaat saja? Kita tidak tahu apa maksud-Nya.\""
 },
 {
   "id": 26757,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 19,
   "firman": "Yesus tahu, bahwa mereka hendak menanyakan sesuatu kepada-Nya, lalu Ia berkata kepada mereka: \"Adakah kamu membicarakan seorang dengan yang lain apa yang Kukatakan tadi, yaitu: Tinggal sesaat saja dan kamu tidak melihat Aku dan tinggal sesaat saja pula dan kamu akan melihat Aku?"
 },
 {
   "id": 26758,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 20,
   "firman": "Aku berkata kepadamu: Sesungguhnya kamu akan menangis dan meratap, tetapi dunia akan bergembira; kamu akan berdukacita, tetapi dukacitamu akan berubah menjadi sukacita."
 },
 {
   "id": 26759,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 21,
   "firman": "Seorang perempuan berdukacita pada saat ia melahirkan, tetapi sesudah ia melahirkan anaknya, ia tidak ingat lagi akan penderitaannya, karena kegembiraan bahwa seorang manusia telah dilahirkan ke dunia."
 },
 {
   "id": 26760,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 22,
   "firman": "Demikian juga kamu sekarang diliputi dukacita, tetapi Aku akan melihat kamu lagi dan hatimu akan bergembira dan tidak ada seorangpun yang dapat merampas kegembiraanmu itu dari padamu."
 },
 {
   "id": 26761,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 23,
   "firman": "Dan pada hari itu kamu tidak akan menanyakan apa-apa kepada-Ku. Aku berkata kepadamu: Sesungguhnya segala sesuatu yang kamu minta kepada Bapa, akan diberikan-Nya kepadamu dalam nama-Ku."
 },
 {
   "id": 26762,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 24,
   "firman": "Sampai sekarang kamu belum meminta sesuatupun dalam nama-Ku. Mintalah maka kamu akan menerima, supaya penuhlah sukacitamu."
 },
 {
   "id": 26763,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 25,
   "firman": "Semuanya ini Kukatakan kepadamu dengan kiasan. Akan tiba saatnya Aku tidak lagi berkata-kata kepadamu dengan kiasan, tetapi terus terang memberitakan Bapa kepadamu."
 },
 {
   "id": 26764,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 26,
   "firman": "Pada hari itu kamu akan berdoa dalam nama-Ku. Dan tidak Aku katakan kepadamu, bahwa Aku meminta bagimu kepada Bapa,"
 },
 {
   "id": 26765,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 27,
   "firman": "sebab Bapa sendiri mengasihi kamu, karena kamu telah mengasihi Aku dan percaya, bahwa Aku datang dari Allah."
 },
 {
   "id": 26766,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 28,
   "firman": "Aku datang dari Bapa dan Aku datang ke dalam dunia; Aku meninggalkan dunia pula dan pergi kepada Bapa.\""
 },
 {
   "id": 26767,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 29,
   "firman": "Kata murid-murid-Nya: \"Lihat, sekarang Engkau terus terang berkata-kata dan Engkau tidak memakai kiasan."
 },
 {
   "id": 26768,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 30,
   "firman": "Sekarang kami tahu, bahwa Engkau mengetahui segala sesuatu dan tidak perlu orang bertanya kepada-Mu. Karena itu kami percaya, bahwa Engkau datang dari Allah.\""
 },
 {
   "id": 26769,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 31,
   "firman": "Jawab Yesus kepada mereka: \"Percayakah kamu sekarang?"
 },
 {
   "id": 26770,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 32,
   "firman": "Lihat, saatnya datang, bahkan sudah datang, bahwa kamu diceraiberaikan masing-masing ke tempatnya sendiri dan kamu meninggalkan Aku seorang diri. Namun Aku tidak seorang diri, sebab Bapa menyertai Aku."
 },
 {
   "id": 26771,
   "kitab": "Yoh",
   "pasal": 16,
   "ayat": 33,
   "firman": "Semuanya itu Kukatakan kepadamu, supaya kamu beroleh damai sejahtera dalam Aku. Dalam dunia kamu menderita penganiayaan, tetapi kuatkanlah hatimu, Aku telah mengalahkan dunia.\""
 },
 {
   "id": 26772,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 1,
   "firman": "Demikianlah kata Yesus. Lalu Ia menengadah ke langit dan berkata: \"Bapa, telah tiba saatnya; permuliakanlah Anak-Mu, supaya Anak-Mu mempermuliakan Engkau."
 },
 {
   "id": 26773,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 2,
   "firman": "Sama seperti Engkau telah memberikan kepada-Nya kuasa atas segala yang hidup, demikian pula Ia akan memberikan hidup yang kekal kepada semua yang telah Engkau berikan kepada-Nya."
 },
 {
   "id": 26774,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 3,
   "firman": "Inilah hidup yang kekal itu, yaitu bahwa mereka mengenal Engkau, satu-satunya Allah yang benar, dan mengenal Yesus Kristus yang telah Engkau utus."
 },
 {
   "id": 26775,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 4,
   "firman": "Aku telah mempermuliakan Engkau di bumi dengan jalan menyelesaikan pekerjaan yang Engkau berikan kepada-Ku untuk melakukannya."
 },
 {
   "id": 26776,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 5,
   "firman": "Oleh sebab itu, ya Bapa, permuliakanlah Aku pada-Mu sendiri dengan kemuliaan yang Kumiliki di hadirat-Mu sebelum dunia ada."
 },
 {
   "id": 26777,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 6,
   "firman": "Aku telah menyatakan nama-Mu kepada semua orang, yang Engkau berikan kepada-Ku dari dunia. Mereka itu milik-Mu dan Engkau telah memberikan mereka kepada-Ku dan mereka telah menuruti firman-Mu."
 },
 {
   "id": 26778,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 7,
   "firman": "Sekarang mereka tahu, bahwa semua yang Engkau berikan kepada-Ku itu berasal dari pada-Mu."
 },
 {
   "id": 26779,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 8,
   "firman": "Sebab segala firman yang Engkau sampaikan kepada-Ku telah Kusampaikan kepada mereka dan mereka telah menerimanya. Mereka tahu benar-benar, bahwa Aku datang dari pada-Mu, dan mereka percaya, bahwa Engkaulah yang telah mengutus Aku."
 },
 {
   "id": 26780,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 9,
   "firman": "Aku berdoa untuk mereka. Bukan untuk dunia Aku berdoa, tetapi untuk mereka, yang telah Engkau berikan kepada-Ku, sebab mereka adalah milik-Mu"
 },
 {
   "id": 26781,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 10,
   "firman": "dan segala milik-Ku adalah milik-Mu dan milik-Mu adalah milik-Ku, dan Aku telah dipermuliakan di dalam mereka."
 },
 {
   "id": 26782,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dan Aku tidak ada lagi di dalam dunia, tetapi mereka masih ada di dalam dunia, dan Aku datang kepada-Mu. Ya Bapa yang kudus, peliharalah mereka dalam nama-Mu, yaitu nama-Mu yang telah Engkau berikan kepada-Ku, supaya mereka menjadi satu sama seperti Kita."
 },
 {
   "id": 26783,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 12,
   "firman": "Selama Aku bersama mereka, Aku memelihara mereka dalam nama-Mu, yaitu nama-Mu yang telah Engkau berikan kepada-Ku; Aku telah menjaga mereka dan tidak ada seorangpun dari mereka yang binasa selain dari pada dia yang telah ditentukan untuk binasa, supaya genaplah yang tertulis dalam Kitab Suci."
 },
 {
   "id": 26784,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 13,
   "firman": "Tetapi sekarang, Aku datang kepada-Mu dan Aku mengatakan semuanya ini sementara Aku masih ada di dalam dunia, supaya penuhlah sukacita-Ku di dalam diri mereka."
 },
 {
   "id": 26785,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 14,
   "firman": "Aku telah memberikan firman-Mu kepada mereka dan dunia membenci mereka, karena mereka bukan dari dunia, sama seperti Aku bukan dari dunia."
 },
 {
   "id": 26786,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 15,
   "firman": "Aku tidak meminta, supaya Engkau mengambil mereka dari dunia, tetapi supaya Engkau melindungi mereka dari pada yang jahat."
 },
 {
   "id": 26787,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 16,
   "firman": "Mereka bukan dari dunia, sama seperti Aku bukan dari dunia."
 },
 {
   "id": 26788,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 17,
   "firman": "Kuduskanlah mereka dalam kebenaran; firman-Mu adalah kebenaran."
 },
 {
   "id": 26789,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 18,
   "firman": "Sama seperti Engkau telah mengutus Aku ke dalam dunia, demikian pula Aku telah mengutus mereka ke dalam dunia;"
 },
 {
   "id": 26790,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 19,
   "firman": "dan Aku menguduskan diri-Ku bagi mereka, supaya merekapun dikuduskan dalam kebenaran."
 },
 {
   "id": 26791,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 20,
   "firman": "Dan bukan untuk mereka ini saja Aku berdoa, tetapi juga untuk orang-orang, yang percaya kepada-Ku oleh pemberitaan mereka;"
 },
 {
   "id": 26792,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 21,
   "firman": "supaya mereka semua menjadi satu, sama seperti Engkau, ya Bapa, di dalam Aku dan Aku di dalam Engkau, agar mereka juga di dalam Kita, supaya dunia percaya, bahwa Engkaulah yang telah mengutus Aku."
 },
 {
   "id": 26793,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 22,
   "firman": "Dan Aku telah memberikan kepada mereka kemuliaan, yang Engkau berikan kepada-Ku, supaya mereka menjadi satu, sama seperti Kita adalah satu:"
 },
 {
   "id": 26794,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 23,
   "firman": "Aku di dalam mereka dan Engkau di dalam Aku supaya mereka sempurna menjadi satu, agar dunia tahu, bahwa Engkau yang telah mengutus Aku dan bahwa Engkau mengasihi mereka, sama seperti Engkau mengasihi Aku."
 },
 {
   "id": 26795,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 24,
   "firman": "Ya Bapa, Aku mau supaya, di manapun Aku berada, mereka juga berada bersama-sama dengan Aku, mereka yang telah Engkau berikan kepada-Ku, agar mereka memandang kemuliaan-Ku yang telah Engkau berikan kepada-Ku, sebab Engkau telah mengasihi Aku sebelum dunia dijadikan."
 },
 {
   "id": 26796,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 25,
   "firman": "Ya Bapa yang adil, memang dunia tidak mengenal Engkau, tetapi Aku mengenal Engkau, dan mereka ini tahu, bahwa Engkaulah yang telah mengutus Aku;"
 },
 {
   "id": 26797,
   "kitab": "Yoh",
   "pasal": 17,
   "ayat": 26,
   "firman": "dan Aku telah memberitahukan nama-Mu kepada mereka dan Aku akan memberitahukannya, supaya kasih yang Engkau berikan kepada-Ku ada di dalam mereka dan Aku di dalam mereka.\""
 },
 {
   "id": 26798,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 1,
   "firman": "Setelah Yesus mengatakan semuanya itu keluarlah Ia dari situ bersama-sama dengan murid-murid-Nya dan mereka pergi ke seberang sungai Kidron. Di situ ada suatu taman dan Ia masuk ke taman itu bersama-sama dengan murid-murid-Nya."
 },
 {
   "id": 26799,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 2,
   "firman": "Yudas, yang mengkhianati Yesus, tahu juga tempat itu, karena Yesus sering berkumpul di situ dengan murid-murid-Nya."
 },
 {
   "id": 26800,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 3,
   "firman": "Maka datanglah Yudas juga ke situ dengan sepasukan prajurit dan penjaga-penjaga Bait Allah yang disuruh oleh imam-imam kepala dan orang-orang Farisi lengkap dengan lentera, suluh dan senjata."
 },
 {
   "id": 26801,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 4,
   "firman": "Maka Yesus, yang tahu semua yang akan menimpa diri-Nya, maju ke depan dan berkata kepada mereka: \"Siapakah yang kamu cari?\""
 },
 {
   "id": 26802,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 5,
   "firman": "Jawab mereka: \"Yesus dari Nazaret.\" Kata-Nya kepada mereka: \"Akulah Dia.\" Yudas yang mengkhianati Dia berdiri juga di situ bersama-sama mereka."
 },
 {
   "id": 26803,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 6,
   "firman": "Ketika Ia berkata kepada mereka: \"Akulah Dia,\" mundurlah mereka dan jatuh ke tanah."
 },
 {
   "id": 26804,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 7,
   "firman": "Maka Ia bertanya pula: \"Siapakah yang kamu cari?\" Kata mereka: \"Yesus dari Nazaret.\""
 },
 {
   "id": 26805,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 8,
   "firman": "Jawab Yesus: \"Telah Kukatakan kepadamu, Akulah Dia. Jika Aku yang kamu cari, biarkanlah mereka ini pergi.\""
 },
 {
   "id": 26806,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 9,
   "firman": "Demikian hendaknya supaya genaplah firman yang telah dikatakan-Nya: \"Dari mereka yang Engkau serahkan kepada-Ku, tidak seorangpun yang Kubiarkan binasa.\""
 },
 {
   "id": 26807,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 10,
   "firman": "Lalu Simon Petrus, yang membawa pedang, menghunus pedang itu, menetakkannya kepada hamba Imam Besar dan memutuskan telinga kanannya. Nama hamba itu Malkhus."
 },
 {
   "id": 26808,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 11,
   "firman": "Kata Yesus kepada Petrus: \"Sarungkan pedangmu itu; bukankah Aku harus minum cawan yang diberikan Bapa kepada-Ku?\""
 },
 {
   "id": 26809,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 12,
   "firman": "Maka pasukan prajurit serta perwiranya dan penjaga-penjaga yang disuruh orang Yahudi itu menangkap Yesus dan membelenggu Dia."
 },
 {
   "id": 26810,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 13,
   "firman": "Lalu mereka membawa-Nya mula-mula kepada Hanas, karena Hanas adalah mertua Kayafas, yang pada tahun itu menjadi Imam Besar;"
 },
 {
   "id": 26811,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 14,
   "firman": "dan Kayafaslah yang telah menasihatkan orang-orang Yahudi: \"Adalah lebih berguna jika satu orang mati untuk seluruh bangsa.\""
 },
 {
   "id": 26812,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 15,
   "firman": "Simon Petrus dan seorang murid lain mengikuti Yesus. Murid itu mengenal Imam Besar dan ia masuk bersama-sama dengan Yesus ke halaman istana Imam Besar,"
 },
 {
   "id": 26813,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 16,
   "firman": "tetapi Petrus tinggal di luar dekat pintu. Maka murid lain tadi, yang mengenal Imam Besar, kembali ke luar, bercakap-cakap dengan perempuan penjaga pintu lalu membawa Petrus masuk."
 },
 {
   "id": 26814,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 17,
   "firman": "Maka kata hamba perempuan penjaga pintu kepada Petrus: \"Bukankah engkau juga murid orang itu?\" Jawab Petrus: \"Bukan!\""
 },
 {
   "id": 26815,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 18,
   "firman": "Sementara itu hamba-hamba dan penjaga-penjaga Bait Allah telah memasang api arang, sebab hawa dingin waktu itu, dan mereka berdiri berdiang di situ. Juga Petrus berdiri berdiang bersama-sama dengan mereka."
 },
 {
   "id": 26816,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 19,
   "firman": "Maka mulailah Imam Besar menanyai Yesus tentang murid-murid-Nya dan tentang ajaran-Nya."
 },
 {
   "id": 26817,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 20,
   "firman": "Jawab Yesus kepadanya: \"Aku berbicara terus terang kepada dunia: Aku selalu mengajar di rumah-rumah ibadat dan di Bait Allah, tempat semua orang Yahudi berkumpul; Aku tidak pernah berbicara sembunyi-sembunyi."
 },
 {
   "id": 26818,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 21,
   "firman": "Mengapakah engkau menanyai Aku? Tanyailah mereka, yang telah mendengar apa yang Kukatakan kepada mereka; sungguh, mereka tahu apa yang telah Kukatakan.\""
 },
 {
   "id": 26819,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 22,
   "firman": "Ketika Ia mengatakan hal itu, seorang penjaga yang berdiri di situ, menampar muka-Nya sambil berkata: \"Begitukah jawab-Mu kepada Imam Besar?\""
 },
 {
   "id": 26820,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 23,
   "firman": "Jawab Yesus kepadanya: \"Jikalau kata-Ku itu salah, tunjukkanlah salahnya, tetapi jikalau kata-Ku itu benar, mengapakah engkau menampar Aku?\""
 },
 {
   "id": 26821,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 24,
   "firman": "Maka Hanas mengirim Dia terbelenggu kepada Kayafas, Imam Besar itu."
 },
 {
   "id": 26822,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 25,
   "firman": "Simon Petrus masih berdiri berdiang. Kata orang-orang di situ kepadanya: \"Bukankah engkau juga seorang murid-Nya?\""
 },
 {
   "id": 26823,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 26,
   "firman": "Ia menyangkalnya, katanya: \"Bukan.\" Kata seorang hamba Imam Besar, seorang keluarga dari hamba yang telinganya dipotong Petrus: \"Bukankah engkau kulihat di taman itu bersama-sama dengan Dia?\""
 },
 {
   "id": 26824,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 27,
   "firman": "Maka Petrus menyangkalnya pula dan ketika itu berkokoklah ayam."
 },
 {
   "id": 26825,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 28,
   "firman": "Maka mereka membawa Yesus dari Kayafas ke gedung pengadilan. Ketika itu hari masih pagi. Mereka sendiri tidak masuk ke gedung pengadilan itu, supaya jangan menajiskan diri, sebab mereka hendak makan Paskah."
 },
 {
   "id": 26826,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 29,
   "firman": "Sebab itu Pilatus keluar mendapatkan mereka dan berkata: \"Apakah tuduhan kamu terhadap orang ini?\""
 },
 {
   "id": 26827,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 30,
   "firman": "Jawab mereka kepadanya: \"Jikalau Ia bukan seorang penjahat, kami tidak menyerahkan-Nya kepadamu!\""
 },
 {
   "id": 26828,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 31,
   "firman": "Kata Pilatus kepada mereka: \"Ambillah Dia dan hakimilah Dia menurut hukum Tauratmu.\" Kata orang-orang Yahudi itu: \"Kami tidak diperbolehkan membunuh seseorang.\""
 },
 {
   "id": 26829,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 32,
   "firman": "Demikian hendaknya supaya genaplah firman Yesus, yang dikatakan-Nya untuk menyatakan bagaimana caranya Ia akan mati."
 },
 {
   "id": 26830,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 33,
   "firman": "Maka kembalilah Pilatus ke dalam gedung pengadilan, lalu memanggil Yesus dan bertanya kepada-Nya: \"Engkau inikah raja orang Yahudi?\""
 },
 {
   "id": 26831,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 34,
   "firman": "Jawab Yesus: \"Apakah engkau katakan hal itu dari hatimu sendiri, atau adakah orang lain yang mengatakannya kepadamu tentang Aku?\""
 },
 {
   "id": 26832,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 35,
   "firman": "Kata Pilatus: \"Apakah aku seorang Yahudi? Bangsa-Mu sendiri dan imam-imam kepala yang telah menyerahkan Engkau kepadaku; apakah yang telah Engkau perbuat?\""
 },
 {
   "id": 26833,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 36,
   "firman": "Jawab Yesus: \"Kerajaan-Ku bukan dari dunia ini; jika Kerajaan-Ku dari dunia ini, pasti hamba-hamba-Ku telah melawan, supaya Aku jangan diserahkan kepada orang Yahudi, akan tetapi Kerajaan-Ku bukan dari sini.\""
 },
 {
   "id": 26834,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 37,
   "firman": "Maka kata Pilatus kepada-Nya: \"Jadi Engkau adalah raja?\" Jawab Yesus: \"Engkau mengatakan, bahwa Aku adalah raja. Untuk itulah Aku lahir dan untuk itulah Aku datang ke dalam dunia ini, supaya Aku memberi kesaksian tentang kebenaran; setiap orang yang berasal dari kebenaran mendengarkan suara-Ku.\""
 },
 {
   "id": 26835,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 38,
   "firman": "Kata Pilatus kepada-Nya: \"Apakah kebenaran itu?\""
 },
 {
   "id": 26837,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 39,
   "firman": "Tetapi pada kamu ada kebiasaan, bahwa pada Paskah aku membebaskan seorang bagimu. Maukah kamu, supaya aku membebaskan raja orang Yahudi bagimu?\""
 },
 {
   "id": 26838,
   "kitab": "Yoh",
   "pasal": 18,
   "ayat": 40,
   "firman": "Mereka berteriak pula: \"Jangan Dia, melainkan Barabas!\" Barabas adalah seorang penyamun."
 },
 {
   "id": 26839,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 1,
   "firman": "Lalu Pilatus mengambil Yesus dan menyuruh orang menyesah Dia."
 },
 {
   "id": 26840,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 2,
   "firman": "Prajurit-prajurit menganyam sebuah mahkota duri dan menaruhnya di atas kepala-Nya. Mereka memakaikan Dia jubah ungu,"
 },
 {
   "id": 26841,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 3,
   "firman": "dan sambil maju ke depan mereka berkata: \"Salam, hai raja orang Yahudi!\" Lalu mereka menampar muka-Nya."
 },
 {
   "id": 26842,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 4,
   "firman": "Pilatus keluar lagi dan berkata kepada mereka: \"Lihatlah, aku membawa Dia ke luar kepada kamu, supaya kamu tahu, bahwa aku tidak mendapati kesalahan apapun pada-Nya.\""
 },
 {
   "id": 26843,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 5,
   "firman": "Lalu Yesus keluar, bermahkota duri dan berjubah ungu. Maka kata Pilatus kepada mereka: \"Lihatlah manusia itu!\""
 },
 {
   "id": 26844,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 6,
   "firman": "Ketika imam-imam kepala dan penjaga-penjaga itu melihat Dia, berteriaklah mereka: \"Salibkan Dia, salibkan Dia!\" Kata Pilatus kepada mereka: \"Ambil Dia dan salibkan Dia; sebab aku tidak mendapati kesalahan apapun pada-Nya.\""
 },
 {
   "id": 26845,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 7,
   "firman": "Jawab orang-orang Yahudi itu kepadanya: \"Kami mempunyai hukum dan menurut hukum itu Ia harus mati, sebab Ia menganggap diri-Nya sebagai Anak Allah.\""
 },
 {
   "id": 26846,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 8,
   "firman": "Ketika Pilatus mendengar perkataan itu bertambah takutlah ia,"
 },
 {
   "id": 26847,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 9,
   "firman": "lalu ia masuk pula ke dalam gedung pengadilan dan berkata kepada Yesus: \"Dari manakah asal-Mu?\" Tetapi Yesus tidak memberi jawab kepadanya."
 },
 {
   "id": 26848,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 10,
   "firman": "Maka kata Pilatus kepada-Nya: \"Tidakkah Engkau mau bicara dengan aku? Tidakkah Engkau tahu, bahwa aku berkuasa untuk membebaskan Engkau, dan berkuasa juga untuk menyalibkan Engkau?\""
 },
 {
   "id": 26849,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 11,
   "firman": "Yesus menjawab: \"Engkau tidak mempunyai kuasa apapun terhadap Aku, jikalau kuasa itu tidak diberikan kepadamu dari atas. Sebab itu: dia, yang menyerahkan Aku kepadamu, lebih besar dosanya.\""
 },
 {
   "id": 26850,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 12,
   "firman": "Sejak itu Pilatus berusaha untuk membebaskan Dia, tetapi orang-orang Yahudi berteriak: \"Jikalau engkau membebaskan Dia, engkau bukanlah sahabat Kaisar. Setiap orang yang menganggap dirinya sebagai raja, ia melawan Kaisar.\""
 },
 {
   "id": 26851,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 13,
   "firman": "Ketika Pilatus mendengar perkataan itu, ia menyuruh membawa Yesus ke luar, dan ia duduk di kursi pengadilan, di tempat yang bernama Litostrotos, dalam bahasa Ibrani Gabata."
 },
 {
   "id": 26852,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 14,
   "firman": "Hari itu ialah hari persiapan Paskah, kira-kira jam dua belas. Kata Pilatus kepada orang-orang Yahudi itu: \"Inilah rajamu!\""
 },
 {
   "id": 26853,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 15,
   "firman": "Maka berteriaklah mereka: \"Enyahkan Dia! Enyahkan Dia! Salibkan Dia!\" Kata Pilatus kepada mereka: \"Haruskah aku menyalibkan rajamu?\" Jawab imam-imam kepala: \"Kami tidak mempunyai raja selain dari pada Kaisar!\""
 },
 {
   "id": 26854,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 16,
   "firman": "Akhirnya Pilatus menyerahkan Yesus kepada mereka untuk disalibkan."
 },
 {
   "id": 26856,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 17,
   "firman": "Sambil memikul salib-Nya Ia pergi ke luar ke tempat yang bernama Tempat Tengkorak, dalam bahasa Ibrani: Golgota."
 },
 {
   "id": 26857,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 18,
   "firman": "Dan di situ Ia disalibkan mereka dan bersama-sama dengan Dia disalibkan juga dua orang lain, sebelah-menyebelah, Yesus di tengah-tengah."
 },
 {
   "id": 26858,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 19,
   "firman": "Dan Pilatus menyuruh memasang juga tulisan di atas kayu salib itu, bunyinya: \"Yesus, orang Nazaret, Raja orang Yahudi.\""
 },
 {
   "id": 26859,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 20,
   "firman": "Banyak orang Yahudi yang membaca tulisan itu, sebab tempat di mana Yesus disalibkan letaknya dekat kota dan kata-kata itu tertulis dalam bahasa Ibrani, bahasa Latin dan bahasa Yunani."
 },
 {
   "id": 26860,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 21,
   "firman": "Maka kata imam-imam kepala orang Yahudi kepada Pilatus: \"Jangan engkau menulis: Raja orang Yahudi, tetapi bahwa Ia mengatakan: Aku adalah Raja orang Yahudi.\""
 },
 {
   "id": 26861,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 22,
   "firman": "Jawab Pilatus: \"Apa yang kutulis, tetap tertulis.\""
 },
 {
   "id": 26862,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 23,
   "firman": "Sesudah prajurit-prajurit itu menyalibkan Yesus, mereka mengambil pakaian-Nya lalu membaginya menjadi empat bagian untuk tiap-tiap prajurit satu bagian--dan jubah-Nya juga mereka ambil. Jubah itu tidak berjahit, dari atas ke bawah hanya satu tenunan saja."
 },
 {
   "id": 26863,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 24,
   "firman": "Karena itu mereka berkata seorang kepada yang lain: \"Janganlah kita membaginya menjadi beberapa potong, tetapi baiklah kita membuang undi untuk menentukan siapa yang mendapatnya.\" Demikianlah hendaknya supaya genaplah yang ada tertulis dalam Kitab Suci: \"Mereka membagi-bagi pakaian-Ku di antara mereka dan mereka membuang undi atas jubah-Ku.\" Hal itu telah dilakukan prajurit-prajurit itu."
 },
 {
   "id": 26864,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 25,
   "firman": "Dan dekat salib Yesus berdiri ibu-Nya dan saudara ibu-Nya, Maria, isteri Klopas dan Maria Magdalena."
 },
 {
   "id": 26865,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 26,
   "firman": "Ketika Yesus melihat ibu-Nya dan murid yang dikasihi-Nya di sampingnya, berkatalah Ia kepada ibu-Nya: \"Ibu, inilah, anakmu!\""
 },
 {
   "id": 26866,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 27,
   "firman": "Kemudian kata-Nya kepada murid-murid-Nya: \"Inilah ibumu!\" Dan sejak saat itu murid itu menerima dia di dalam rumahnya."
 },
 {
   "id": 26867,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 28,
   "firman": "Sesudah itu, karena Yesus tahu, bahwa segala sesuatu telah selesai, berkatalah Ia--supaya genaplah yang ada tertulis dalam Kitab Suci--:\"Aku haus!\""
 },
 {
   "id": 26868,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 29,
   "firman": "Di situ ada suatu bekas penuh anggur asam. Maka mereka mencucukkan bunga karang, yang telah dicelupkan dalam anggur asam, pada sebatang hisop lalu mengunjukkannya ke mulut Yesus."
 },
 {
   "id": 26869,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 30,
   "firman": "Sesudah Yesus meminum anggur asam itu, berkatalah Ia: \"Sudah selesai.\" Lalu Ia menundukkan kepala-Nya dan menyerahkan nyawa-Nya."
 },
 {
   "id": 26870,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 31,
   "firman": "Karena hari itu hari persiapan dan supaya pada hari Sabat mayat-mayat itu tidak tinggal tergantung pada kayu salib--sebab Sabat itu adalah hari yang besar--maka datanglah orang-orang Yahudi kepada Pilatus dan meminta kepadanya supaya kaki orang-orang itu dipatahkan dan mayat-mayatnya diturunkan."
 },
 {
   "id": 26871,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 32,
   "firman": "Maka datanglah prajurit-prajurit lalu mematahkan kaki orang yang pertama dan kaki orang yang lain yang disalibkan bersama-sama dengan Yesus;"
 },
 {
   "id": 26872,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 33,
   "firman": "tetapi ketika mereka sampai kepada Yesus dan melihat bahwa Ia telah mati, mereka tidak mematahkan kaki-Nya,"
 },
 {
   "id": 26873,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 34,
   "firman": "tetapi seorang dari antara prajurit itu menikam lambung-Nya dengan tombak, dan segera mengalir keluar darah dan air."
 },
 {
   "id": 26874,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 35,
   "firman": "Dan orang yang melihat hal itu sendiri yang memberikan kesaksian ini dan kesaksiannya benar, dan ia tahu, bahwa ia mengatakan kebenaran, supaya kamu juga percaya."
 },
 {
   "id": 26875,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 36,
   "firman": "Sebab hal itu terjadi, supaya genaplah yang tertulis dalam Kitab Suci: \"Tidak ada tulang-Nya yang akan dipatahkan.\""
 },
 {
   "id": 26876,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 37,
   "firman": "Dan ada pula nas yang mengatakan: \"Mereka akan memandang kepada Dia yang telah mereka tikam.\""
 },
 {
   "id": 26877,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 38,
   "firman": "Sesudah itu Yusuf dari Arimatea--ia murid Yesus, tetapi sembunyi-sembunyi karena takut kepada orang-orang Yahudi--meminta kepada Pilatus, supaya ia diperbolehkan menurunkan mayat Yesus. Dan Pilatus meluluskan permintaannya itu. Lalu datanglah ia dan menurunkan mayat itu."
 },
 {
   "id": 26878,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 39,
   "firman": "Juga Nikodemus datang ke situ. Dialah yang mula-mula datang waktu malam kepada Yesus. Ia membawa campuran minyak mur dengan minyak gaharu, kira-kira lima puluh kati beratnya."
 },
 {
   "id": 26879,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 40,
   "firman": "Mereka mengambil mayat Yesus, mengapaninya dengan kain lenan dan membubuhinya dengan rempah-rempah menurut adat orang Yahudi bila menguburkan mayat."
 },
 {
   "id": 26880,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 41,
   "firman": "Dekat tempat di mana Yesus disalibkan ada suatu taman dan dalam taman itu ada suatu kubur baru yang di dalamnya belum pernah dimakamkan seseorang."
 },
 {
   "id": 26881,
   "kitab": "Yoh",
   "pasal": 19,
   "ayat": 42,
   "firman": "Karena hari itu hari persiapan orang Yahudi, sedang kubur itu tidak jauh letaknya, maka mereka meletakkan mayat Yesus ke situ."
 },
 {
   "id": 26882,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 1,
   "firman": "Pada hari pertama minggu itu, pagi-pagi benar ketika hari masih gelap, pergilah Maria Magdalena ke kubur itu dan ia melihat bahwa batu telah diambil dari kubur."
 },
 {
   "id": 26883,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 2,
   "firman": "Ia berlari-lari mendapatkan Simon Petrus dan murid yang lain yang dikasihi Yesus, dan berkata kepada mereka: \"Tuhan telah diambil orang dari kuburnya dan kami tidak tahu di mana Ia diletakkan.\""
 },
 {
   "id": 26884,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 3,
   "firman": "Maka berangkatlah Petrus dan murid yang lain itu ke kubur."
 },
 {
   "id": 26885,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 4,
   "firman": "Keduanya berlari bersama-sama, tetapi murid yang lain itu berlari lebih cepat dari pada Petrus sehingga lebih dahulu sampai di kubur."
 },
 {
   "id": 26886,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 5,
   "firman": "Ia menjenguk ke dalam, dan melihat kain kapan terletak di tanah; akan tetapi ia tidak masuk ke dalam."
 },
 {
   "id": 26887,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 6,
   "firman": "Maka datanglah Simon Petrus juga menyusul dia dan masuk ke dalam kubur itu. Ia melihat kain kapan terletak di tanah,"
 },
 {
   "id": 26888,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 7,
   "firman": "sedang kain peluh yang tadinya ada di kepala Yesus tidak terletak dekat kain kapan itu, tetapi agak di samping di tempat yang lain dan sudah tergulung."
 },
 {
   "id": 26889,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 8,
   "firman": "Maka masuklah juga murid yang lain, yang lebih dahulu sampai di kubur itu dan ia melihatnya dan percaya."
 },
 {
   "id": 26890,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 9,
   "firman": "Sebab selama itu mereka belum mengerti isi Kitab Suci yang mengatakan, bahwa Ia harus bangkit dari antara orang mati."
 },
 {
   "id": 26891,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 10,
   "firman": "Lalu pulanglah kedua murid itu ke rumah."
 },
 {
   "id": 26892,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 11,
   "firman": "Tetapi Maria berdiri dekat kubur itu dan menangis. Sambil menangis ia menjenguk ke dalam kubur itu,"
 },
 {
   "id": 26893,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 12,
   "firman": "dan tampaklah olehnya dua orang malaikat berpakaian putih, yang seorang duduk di sebelah kepala dan yang lain di sebelah kaki di tempat mayat Yesus terbaring."
 },
 {
   "id": 26894,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 13,
   "firman": "Kata malaikat-malaikat itu kepadanya: \"Ibu, mengapa engkau menangis?\" Jawab Maria kepada mereka: \"Tuhanku telah diambil orang dan aku tidak tahu di mana Ia diletakkan.\""
 },
 {
   "id": 26895,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 14,
   "firman": "Sesudah berkata demikian ia menoleh ke belakang dan melihat Yesus berdiri di situ, tetapi ia tidak tahu, bahwa itu adalah Yesus."
 },
 {
   "id": 26896,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 15,
   "firman": "Kata Yesus kepadanya: \"Ibu, mengapa engkau menangis? Siapakah yang engkau cari?\" Maria menyangka orang itu adalah penunggu taman, lalu berkata kepada-Nya: \"Tuan, jikalau tuan yang mengambil Dia, katakanlah kepadaku, di mana tuan meletakkan Dia, supaya aku dapat mengambil-Nya.\""
 },
 {
   "id": 26897,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 16,
   "firman": "Kata Yesus kepadanya: \"Maria!\" Maria berpaling dan berkata kepada-Nya dalam bahasa Ibrani: \"Rabuni!\", artinya Guru."
 },
 {
   "id": 26898,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 17,
   "firman": "Kata Yesus kepadanya: \"Janganlah engkau memegang Aku, sebab Aku belum pergi kepada Bapa, tetapi pergilah kepada saudara-saudara-Ku dan katakanlah kepada mereka, bahwa sekarang Aku akan pergi kepada Bapa-Ku dan Bapamu, kepada Allah-Ku dan Allahmu.\""
 },
 {
   "id": 26899,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 18,
   "firman": "Maria Magdalena pergi dan berkata kepada murid-murid: \"Aku telah melihat Tuhan!\" dan juga bahwa Dia yang mengatakan hal-hal itu kepadanya."
 },
 {
   "id": 26900,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 19,
   "firman": "Ketika hari sudah malam pada hari pertama minggu itu berkumpullah murid-murid Yesus di suatu tempat dengan pintu-pintu yang terkunci karena mereka takut kepada orang-orang Yahudi. Pada waktu itu datanglah Yesus dan berdiri di tengah-tengah mereka dan berkata: \"Damai sejahtera bagi kamu!\""
 },
 {
   "id": 26901,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 20,
   "firman": "Dan sesudah berkata demikian, Ia menunjukkan tangan-Nya dan lambung-Nya kepada mereka. Murid-murid itu bersukacita ketika mereka melihat Tuhan."
 },
 {
   "id": 26902,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 21,
   "firman": "Maka kata Yesus sekali lagi: \"Damai sejahtera bagi kamu! Sama seperti Bapa mengutus Aku, demikian juga sekarang Aku mengutus kamu.\""
 },
 {
   "id": 26903,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 22,
   "firman": "Dan sesudah berkata demikian, Ia mengembusi mereka dan berkata: \"Terimalah Roh Kudus."
 },
 {
   "id": 26904,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 23,
   "firman": "Jikalau kamu mengampuni dosa orang, dosanya diampuni, dan jikalau kamu menyatakan dosa orang tetap ada, dosanya tetap ada.\""
 },
 {
   "id": 26905,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 24,
   "firman": "Tetapi Tomas, seorang dari kedua belas murid itu, yang disebut Didimus, tidak ada bersama-sama mereka, ketika Yesus datang ke situ."
 },
 {
   "id": 26906,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 25,
   "firman": "Maka kata murid-murid yang lain itu kepadanya: \"Kami telah melihat Tuhan!\" Tetapi Tomas berkata kepada mereka: \"Sebelum aku melihat bekas paku pada tangan-Nya dan sebelum aku mencucukkan jariku ke dalam bekas paku itu dan mencucukkan tanganku ke dalam lambung-Nya, sekali-kali aku tidak akan percaya.\""
 },
 {
   "id": 26907,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 26,
   "firman": "Delapan hari kemudian murid-murid Yesus berada kembali dalam rumah itu dan Tomas bersama-sama dengan mereka. Sementara pintu-pintu terkunci, Yesus datang dan Ia berdiri di tengah-tengah mereka dan berkata: \"Damai sejahtera bagi kamu!\""
 },
 {
   "id": 26908,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 27,
   "firman": "Kemudian Ia berkata kepada Tomas: \"Taruhlah jarimu di sini dan lihatlah tangan-Ku, ulurkanlah tanganmu dan cucukkan ke dalam lambung-Ku dan jangan engkau tidak percaya lagi, melainkan percayalah.\""
 },
 {
   "id": 26909,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 28,
   "firman": "Tomas menjawab Dia: \"Ya Tuhanku dan Allahku!\""
 },
 {
   "id": 26910,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 29,
   "firman": "Kata Yesus kepadanya: \"Karena engkau telah melihat Aku, maka engkau percaya. Berbahagialah mereka yang tidak melihat, namun percaya.\""
 },
 {
   "id": 26911,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 30,
   "firman": "Memang masih banyak tanda lain yang dibuat Yesus di depan mata murid-murid-Nya, yang tidak tercatat dalam kitab ini,"
 },
 {
   "id": 26912,
   "kitab": "Yoh",
   "pasal": 20,
   "ayat": 31,
   "firman": "tetapi semua yang tercantum di sini telah dicatat, supaya kamu percaya, bahwa Yesuslah Mesias, Anak Allah, dan supaya kamu oleh imanmu memperoleh hidup dalam nama-Nya."
 },
 {
   "id": 26913,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 1,
   "firman": "Kemudian Yesus menampakkan diri lagi kepada murid-murid-Nya di pantai danau Tiberias dan Ia menampakkan diri sebagai berikut."
 },
 {
   "id": 26914,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 2,
   "firman": "Di pantai itu berkumpul Simon Petrus, Tomas yang disebut Didimus, Natanael dari Kana yang di Galilea, anak-anak Zebedeus dan dua orang murid-Nya yang lain."
 },
 {
   "id": 26915,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 3,
   "firman": "Kata Simon Petrus kepada mereka: \"Aku pergi menangkap ikan.\" Kata mereka kepadanya: \"Kami pergi juga dengan engkau.\" Mereka berangkat lalu naik ke perahu, tetapi malam itu mereka tidak menangkap apa-apa."
 },
 {
   "id": 26916,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 4,
   "firman": "Ketika hari mulai siang, Yesus berdiri di pantai; akan tetapi murid-murid itu tidak tahu, bahwa itu adalah Yesus."
 },
 {
   "id": 26917,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 5,
   "firman": "Kata Yesus kepada mereka: \"Hai anak-anak, adakah kamu mempunyai lauk-pauk?\" Jawab mereka: \"Tidak ada.\""
 },
 {
   "id": 26918,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 6,
   "firman": "Maka kata Yesus kepada mereka: \"Tebarkanlah jalamu di sebelah kanan perahu, maka akan kamu peroleh.\" Lalu mereka menebarkannya dan mereka tidak dapat menariknya lagi karena banyaknya ikan."
 },
 {
   "id": 26919,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 7,
   "firman": "Maka murid yang dikasihi Yesus itu berkata kepada Petrus: \"Itu Tuhan.\" Ketika Petrus mendengar, bahwa itu adalah Tuhan, maka ia mengenakan pakaiannya, sebab ia tidak berpakaian, lalu terjun ke dalam danau."
 },
 {
   "id": 26920,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 8,
   "firman": "Murid-murid yang lain datang dengan perahu karena mereka tidak jauh dari darat, hanya kira-kira dua ratus hasta saja dan mereka menghela jala yang penuh ikan itu."
 },
 {
   "id": 26921,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 9,
   "firman": "Ketika mereka tiba di darat, mereka melihat api arang dan di atasnya ikan dan roti."
 },
 {
   "id": 26922,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 10,
   "firman": "Kata Yesus kepada mereka: \"Bawalah beberapa ikan, yang baru kamu tangkap itu.\""
 },
 {
   "id": 26923,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 11,
   "firman": "Simon Petrus naik ke perahu lalu menghela jala itu ke darat, penuh ikan-ikan besar: seratus lima puluh tiga ekor banyaknya, dan sungguhpun sebanyak itu, jala itu tidak koyak."
 },
 {
   "id": 26924,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 12,
   "firman": "Kata Yesus kepada mereka: \"Marilah dan sarapanlah.\" Tidak ada di antara murid-murid itu yang berani bertanya kepada-Nya: \"Siapakah Engkau?\" Sebab mereka tahu, bahwa Ia adalah Tuhan."
 },
 {
   "id": 26925,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 13,
   "firman": "Yesus maju ke depan, mengambil roti dan memberikannya kepada mereka, demikian juga ikan itu."
 },
 {
   "id": 26926,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 14,
   "firman": "Itulah ketiga kalinya Yesus menampakkan diri kepada murid-murid-Nya sesudah Ia bangkit dari antara orang mati."
 },
 {
   "id": 26927,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 15,
   "firman": "Sesudah sarapan Yesus berkata kepada Simon Petrus: \"Simon, anak Yohanes, apakah engkau mengasihi Aku lebih dari pada mereka ini?\" Jawab Petrus kepada-Nya: \"Benar Tuhan, Engkau tahu, bahwa aku mengasihi Engkau.\" Kata Yesus kepadanya: \"Gembalakanlah domba-domba-Ku.\""
 },
 {
   "id": 26928,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 16,
   "firman": "Kata Yesus pula kepadanya untuk kedua kalinya: \"Simon, anak Yohanes, apakah engkau mengasihi Aku?\" Jawab Petrus kepada-Nya: \"Benar Tuhan, Engkau tahu, bahwa aku mengasihi Engkau.\" Kata Yesus kepadanya: \"Gembalakanlah domba-domba-Ku.\""
 },
 {
   "id": 26929,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 17,
   "firman": "Kata Yesus kepadanya untuk ketiga kalinya: \"Simon, anak Yohanes, apakah engkau mengasihi Aku?\" Maka sedih hati Petrus karena Yesus berkata untuk ketiga kalinya: \"Apakah engkau mengasihi Aku?\" Dan ia berkata kepada-Nya: \"Tuhan, Engkau tahu segala sesuatu, Engkau tahu, bahwa aku mengasihi Engkau.\" Kata Yesus kepadanya: \"Gembalakanlah domba-domba-Ku."
 },
 {
   "id": 26930,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 18,
   "firman": "Aku berkata kepadamu: Sesungguhnya ketika engkau masih muda engkau mengikat pinggangmu sendiri dan engkau berjalan ke mana saja kaukehendaki, tetapi jika engkau sudah menjadi tua, engkau akan mengulurkan tanganmu dan orang lain akan mengikat engkau dan membawa engkau ke tempat yang tidak kaukehendaki.\""
 },
 {
   "id": 26931,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 19,
   "firman": "Dan hal ini dikatakan-Nya untuk menyatakan bagaimana Petrus akan mati dan memuliakan Allah. Sesudah mengatakan demikian Ia berkata kepada Petrus: \"Ikutlah Aku.\""
 },
 {
   "id": 26932,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 20,
   "firman": "Ketika Petrus berpaling, ia melihat bahwa murid yang dikasihi Yesus sedang mengikuti mereka, yaitu murid yang pada waktu mereka sedang makan bersama duduk dekat Yesus dan yang berkata: \"Tuhan, siapakah dia yang akan menyerahkan Engkau?\""
 },
 {
   "id": 26933,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 21,
   "firman": "Ketika Petrus melihat murid itu, ia berkata kepada Yesus: \"Tuhan, apakah yang akan terjadi dengan dia ini?\""
 },
 {
   "id": 26934,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 22,
   "firman": "Jawab Yesus: \"Jikalau Aku menghendaki, supaya ia tinggal hidup sampai Aku datang, itu bukan urusanmu. Tetapi engkau: ikutlah Aku.\""
 },
 {
   "id": 26935,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 23,
   "firman": "Maka tersebarlah kabar di antara saudara-saudara itu, bahwa murid itu tidak akan mati. Tetapi Yesus tidak mengatakan kepada Petrus, bahwa murid itu tidak akan mati, melainkan: \"Jikalau Aku menghendaki supaya ia tinggal hidup sampai Aku datang, itu bukan urusanmu.\""
 },
 {
   "id": 26936,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 24,
   "firman": "Dialah murid, yang memberi kesaksian tentang semuanya ini dan yang telah menuliskannya dan kita tahu, bahwa kesaksiannya itu benar."
 },
 {
   "id": 26937,
   "kitab": "Yoh",
   "pasal": 21,
   "ayat": 25,
   "firman": "Masih banyak hal-hal lain lagi yang diperbuat oleh Yesus, tetapi jikalau semuanya itu harus dituliskan satu per satu, maka agaknya dunia ini tidak dapat memuat semua kitab yang harus ditulis itu."
 },
 {
   "id": 26938,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 1,
   "firman": "Hai Teofilus, dalam bukuku yang pertama aku menulis tentang segala sesuatu yang dikerjakan dan diajarkan Yesus,"
 },
 {
   "id": 26939,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 2,
   "firman": "sampai pada hari Ia terangkat. Sebelum itu Ia telah memberi perintah-Nya oleh Roh Kudus kepada rasul-rasul yang dipilih-Nya."
 },
 {
   "id": 26940,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kepada mereka Ia menunjukkan diri-Nya setelah penderitaan-Nya selesai, dan dengan banyak tanda Ia membuktikan, bahwa Ia hidup. Sebab selama empat puluh hari Ia berulang-ulang menampakkan diri dan berbicara kepada mereka tentang Kerajaan Allah."
 },
 {
   "id": 26941,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 4,
   "firman": "Pada suatu hari ketika Ia makan bersama-sama dengan mereka, Ia melarang mereka meninggalkan Yerusalem, dan menyuruh mereka tinggal di situ menantikan janji Bapa, yang -- demikian kata-Nya -- \"telah kamu dengar dari pada-Ku."
 },
 {
   "id": 26942,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab Yohanes membaptis dengan air, tetapi tidak lama lagi kamu akan dibaptis dengan Roh Kudus.\""
 },
 {
   "id": 26943,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 6,
   "firman": "Maka bertanyalah mereka yang berkumpul di situ: \"Tuhan, maukah Engkau pada masa ini memulihkan kerajaan bagi Israel?\""
 },
 {
   "id": 26944,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 7,
   "firman": "Jawab-Nya: \"Engkau tidak perlu mengetahui masa dan waktu, yang ditetapkan Bapa sendiri menurut kuasa-Nya."
 },
 {
   "id": 26945,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 8,
   "firman": "Tetapi kamu akan menerima kuasa, kalau Roh Kudus turun ke atas kamu, dan kamu akan menjadi saksi-Ku di Yerusalem dan di seluruh Yudea dan Samaria dan sampai ke ujung bumi.\""
 },
 {
   "id": 26946,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sesudah Ia mengatakan demikian, terangkatlah Ia disaksikan oleh mereka, dan awan menutup-Nya dari pandangan mereka."
 },
 {
   "id": 26947,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 10,
   "firman": "Ketika mereka sedang menatap ke langit waktu Ia naik itu, tiba-tiba berdirilah dua orang yang berpakaian putih dekat mereka,"
 },
 {
   "id": 26948,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 11,
   "firman": "dan berkata kepada mereka: \"Hai orang-orang Galilea, mengapakah kamu berdiri melihat ke langit? Yesus ini, yang terangkat ke sorga meninggalkan kamu, akan datang kembali dengan cara yang sama seperti kamu melihat Dia naik ke sorga.\""
 },
 {
   "id": 26949,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 12,
   "firman": "Maka kembalilah rasul-rasul itu ke Yerusalem dari bukit yang disebut Bukit Zaitun, yang hanya seperjalanan Sabat jauhnya dari Yerusalem."
 },
 {
   "id": 26950,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 13,
   "firman": "Setelah mereka tiba di kota, naiklah mereka ke ruang atas, tempat mereka menumpang. Mereka itu ialah Petrus dan Yohanes, Yakobus dan Andreas, Filipus dan Tomas, Bartolomeus dan Matius, Yakobus bin Alfeus, dan Simon orang Zelot dan Yudas bin Yakobus."
 },
 {
   "id": 26951,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 14,
   "firman": "Mereka semua bertekun dengan sehati dalam doa bersama-sama, dengan beberapa perempuan serta Maria, ibu Yesus, dan dengan saudara-saudara Yesus."
 },
 {
   "id": 26952,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 15,
   "firman": "Pada hari-hari itu berdirilah Petrus di tengah-tengah saudara-saudara yang sedang berkumpul itu, kira-kira seratus dua puluh orang banyaknya, lalu berkata:"
 },
 {
   "id": 26953,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 16,
   "firman": "\"Hai saudara-saudara, haruslah genap nas Kitab Suci, yang disampaikan Roh Kudus dengan perantaraan Daud tentang Yudas, pemimpin orang-orang yang menangkap Yesus itu."
 },
 {
   "id": 26954,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 17,
   "firman": "Dahulu ia termasuk bilangan kami dan mengambil bagian di dalam pelayanan ini.\""
 },
 {
   "id": 26955,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 18,
   "firman": "--Yudas ini telah membeli sebidang tanah dengan upah kejahatannya, lalu ia jatuh tertelungkup, dan perutnya terbelah sehingga semua isi perutnya tertumpah ke luar."
 },
 {
   "id": 26956,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 19,
   "firman": "Hal itu diketahui oleh semua penduduk Yerusalem, sehingga tanah itu mereka sebut dalam bahasa mereka sendiri \"Hakal-Dama\", artinya Tanah Darah--."
 },
 {
   "id": 26957,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 20,
   "firman": "\"Sebab ada tertulis dalam kitab Mazmur: Biarlah perkemahannya menjadi sunyi, dan biarlah tidak ada penghuni di dalamnya: dan: Biarlah jabatannya diambil orang lain."
 },
 {
   "id": 26958,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 21,
   "firman": "Jadi harus ditambahkan kepada kami seorang dari mereka yang senantiasa datang berkumpul dengan kami selama Tuhan Yesus bersama-sama dengan kami,"
 },
 {
   "id": 26959,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 22,
   "firman": "yaitu mulai dari baptisan Yohanes sampai hari Yesus terangkat ke sorga meninggalkan kami, untuk menjadi saksi dengan kami tentang kebangkitan-Nya.\""
 },
 {
   "id": 26960,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 23,
   "firman": "Lalu mereka mengusulkan dua orang: Yusuf yang disebut Barsabas dan yang juga bernama Yustus, dan Matias."
 },
 {
   "id": 26961,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 24,
   "firman": "Mereka semua berdoa dan berkata: \"Ya Tuhan, Engkaulah yang mengenal hati semua orang, tunjukkanlah kiranya siapa yang Engkau pilih dari kedua orang ini,"
 },
 {
   "id": 26962,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 25,
   "firman": "untuk menerima jabatan pelayanan, yaitu kerasulan yang ditinggalkan Yudas yang telah jatuh ke tempat yang wajar baginya.\""
 },
 {
   "id": 26963,
   "kitab": "Kis",
   "pasal": 1,
   "ayat": 26,
   "firman": "Lalu mereka membuang undi bagi kedua orang itu dan yang kena undi adalah Matias dan dengan demikian ia ditambahkan kepada bilangan kesebelas rasul itu."
 },
 {
   "id": 26964,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 1,
   "firman": "Ketika tiba hari Pentakosta, semua orang percaya berkumpul di satu tempat."
 },
 {
   "id": 26965,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tiba-tiba turunlah dari langit suatu bunyi seperti tiupan angin keras yang memenuhi seluruh rumah, di mana mereka duduk;"
 },
 {
   "id": 26966,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 3,
   "firman": "dan tampaklah kepada mereka lidah-lidah seperti nyala api yang bertebaran dan hinggap pada mereka masing-masing."
 },
 {
   "id": 26967,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 4,
   "firman": "Maka penuhlah mereka dengan Roh Kudus, lalu mereka mulai berkata-kata dalam bahasa-bahasa lain, seperti yang diberikan oleh Roh itu kepada mereka untuk mengatakannya."
 },
 {
   "id": 26968,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 5,
   "firman": "Waktu itu di Yerusalem diam orang-orang Yahudi yang saleh dari segala bangsa di bawah kolong langit."
 },
 {
   "id": 26969,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ketika turun bunyi itu, berkerumunlah orang banyak. Mereka bingung karena mereka masing-masing mendengar rasul-rasul itu berkata-kata dalam bahasa mereka sendiri."
 },
 {
   "id": 26970,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 7,
   "firman": "Mereka semua tercengang-cengang dan heran, lalu berkata: \"Bukankah mereka semua yang berkata-kata itu orang Galilea?"
 },
 {
   "id": 26971,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 8,
   "firman": "Bagaimana mungkin kita masing-masing mendengar mereka berkata-kata dalam bahasa kita sendiri, yaitu bahasa yang kita pakai di negeri asal kita:"
 },
 {
   "id": 26972,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 9,
   "firman": "kita orang Partia, Media, Elam, penduduk Mesopotamia, Yudea dan Kapadokia, Pontus dan Asia,"
 },
 {
   "id": 26973,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 10,
   "firman": "Frigia dan Pamfilia, Mesir dan daerah-daerah Libia yang berdekatan dengan Kirene, pendatang-pendatang dari Roma,"
 },
 {
   "id": 26974,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 11,
   "firman": "baik orang Yahudi maupun penganut agama Yahudi, orang Kreta dan orang Arab, kita mendengar mereka berkata-kata dalam bahasa kita sendiri tentang perbuatan-perbuatan besar yang dilakukan Allah.\""
 },
 {
   "id": 26975,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 12,
   "firman": "Mereka semuanya tercengang-cengang dan sangat termangu-mangu sambil berkata seorang kepada yang lain: \"Apakah artinya ini?\""
 },
 {
   "id": 26976,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 13,
   "firman": "Tetapi orang lain menyindir: \"Mereka sedang mabuk oleh anggur manis.\""
 },
 {
   "id": 26977,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 14,
   "firman": "Maka bangkitlah Petrus berdiri dengan kesebelas rasul itu, dan dengan suara nyaring ia berkata kepada mereka: \"Hai kamu orang Yahudi dan kamu semua yang tinggal di Yerusalem, ketahuilah dan camkanlah perkataanku ini."
 },
 {
   "id": 26978,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 15,
   "firman": "Orang-orang ini tidak mabuk seperti yang kamu sangka, karena hari baru pukul sembilan,"
 },
 {
   "id": 26979,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 16,
   "firman": "tetapi itulah yang difirmankan Allah dengan perantaraan nabi Yoel:"
 },
 {
   "id": 26980,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 17,
   "firman": "Akan terjadi pada hari-hari terakhir--demikianlah firman Allah--bahwa Aku akan mencurahkan Roh-Ku ke atas semua manusia; maka anak-anakmu laki-laki dan perempuan akan bernubuat, dan teruna-terunamu akan mendapat penglihatan-penglihatan, dan orang-orangmu yang tua akan mendapat mimpi."
 },
 {
   "id": 26981,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 18,
   "firman": "Juga ke atas hamba-hamba-Ku laki-laki dan perempuan akan Kucurahkan Roh-Ku pada hari-hari itu dan mereka akan bernubuat."
 },
 {
   "id": 26982,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 19,
   "firman": "Dan Aku akan mengadakan mujizat-mujizat di atas, di langit dan tanda-tanda di bawah, di bumi: darah dan api dan gumpalan-gumpalan asap."
 },
 {
   "id": 26983,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 20,
   "firman": "Matahari akan berubah menjadi gelap gulita dan bulan menjadi darah sebelum datangnya hari Tuhan, hari yang besar dan mulia itu."
 },
 {
   "id": 26984,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 21,
   "firman": "Dan barangsiapa yang berseru kepada nama Tuhan akan diselamatkan."
 },
 {
   "id": 26985,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 22,
   "firman": "Hai orang-orang Israel, dengarlah perkataan ini: Yang aku maksudkan, ialah Yesus dari Nazaret, seorang yang telah ditentukan Allah dan yang dinyatakan kepadamu dengan kekuatan-kekuatan dan mujizat-mujizat dan tanda-tanda yang dilakukan oleh Allah dengan perantaraan Dia di tengah-tengah kamu, seperti yang kamu tahu."
 },
 {
   "id": 26986,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 23,
   "firman": "Dia yang diserahkan Allah menurut maksud dan rencana-Nya, telah kamu salibkan dan kamu bunuh oleh tangan bangsa-bangsa durhaka."
 },
 {
   "id": 26987,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tetapi Allah membangkitkan Dia dengan melepaskan Dia dari sengsara maut, karena tidak mungkin Ia tetap berada dalam kuasa maut itu."
 },
 {
   "id": 26988,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 25,
   "firman": "Sebab Daud berkata tentang Dia: Aku senantiasa memandang kepada Tuhan, karena Ia berdiri di sebelah kananku, aku tidak goyah."
 },
 {
   "id": 26989,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 26,
   "firman": "Sebab itu hatiku bersukacita dan jiwaku bersorak-sorak, bahkan tubuhku akan diam dengan tenteram,"
 },
 {
   "id": 26990,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 27,
   "firman": "sebab Engkau tidak menyerahkan aku kepada dunia orang mati, dan tidak membiarkan Orang Kudus-Mu melihat kebinasaan."
 },
 {
   "id": 26991,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 28,
   "firman": "Engkau memberitahukan kepadaku jalan kehidupan; Engkau akan melimpahi aku dengan sukacita di hadapan-Mu."
 },
 {
   "id": 26992,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 29,
   "firman": "Saudara-saudara, aku boleh berkata-kata dengan terus terang kepadamu tentang Daud, bapa bangsa kita. Ia telah mati dan dikubur, dan kuburannya masih ada pada kita sampai hari ini."
 },
 {
   "id": 26993,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 30,
   "firman": "Tetapi ia adalah seorang nabi dan ia tahu, bahwa Allah telah berjanji kepadanya dengan mengangkat sumpah, bahwa Ia akan mendudukkan seorang dari keturunan Daud sendiri di atas takhtanya."
 },
 {
   "id": 26994,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 31,
   "firman": "Karena itu ia telah melihat ke depan dan telah berbicara tentang kebangkitan Mesias, ketika ia mengatakan, bahwa Dia tidak ditinggalkan di dalam dunia orang mati, dan bahwa daging-Nya tidak mengalami kebinasaan."
 },
 {
   "id": 26995,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 32,
   "firman": "Yesus inilah yang dibangkitkan Allah, dan tentang hal itu kami semua adalah saksi."
 },
 {
   "id": 26996,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 33,
   "firman": "Dan sesudah Ia ditinggikan oleh tangan kanan Allah dan menerima Roh Kudus yang dijanjikan itu, maka dicurahkan-Nya apa yang kamu lihat dan dengar di sini."
 },
 {
   "id": 26997,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 34,
   "firman": "Sebab bukan Daud yang naik ke sorga, malahan Daud sendiri berkata: Tuhan telah berfirman kepada Tuanku:"
 },
 {
   "id": 26998,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 35,
   "firman": "Duduklah di sebelah kanan-Ku, sampai Kubuat musuh-musuh-Mu menjadi tumpuan kaki-Mu."
 },
 {
   "id": 26999,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 36,
   "firman": "Jadi seluruh kaum Israel harus tahu dengan pasti, bahwa Allah telah membuat Yesus, yang kamu salibkan itu, menjadi Tuhan dan Kristus.\""
 },
 {
   "id": 27000,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 37,
   "firman": "Ketika mereka mendengar hal itu hati mereka sangat terharu, lalu mereka bertanya kepada Petrus dan rasul-rasul yang lain: \"Apakah yang harus kami perbuat, saudara-saudara?\""
 },
 {
   "id": 27001,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 38,
   "firman": "Jawab Petrus kepada mereka: \"Bertobatlah dan hendaklah kamu masing-masing memberi dirimu dibaptis dalam nama Yesus Kristus untuk pengampunan dosamu, maka kamu akan menerima karunia Roh Kudus."
 },
 {
   "id": 27002,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 39,
   "firman": "Sebab bagi kamulah janji itu dan bagi anak-anakmu dan bagi orang yang masih jauh, yaitu sebanyak yang akan dipanggil oleh Tuhan Allah kita.\""
 },
 {
   "id": 27003,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 40,
   "firman": "Dan dengan banyak perkataan lain lagi ia memberi suatu kesaksian yang sungguh-sungguh dan ia mengecam dan menasihati mereka, katanya: \"Berilah dirimu diselamatkan dari angkatan yang jahat ini.\""
 },
 {
   "id": 27004,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 41,
   "firman": "Orang-orang yang menerima perkataannya itu memberi diri dibaptis dan pada hari itu jumlah mereka bertambah kira-kira tiga ribu jiwa."
 },
 {
   "id": 27005,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 42,
   "firman": "Mereka bertekun dalam pengajaran rasul-rasul dan dalam persekutuan. Dan mereka selalu berkumpul untuk memecahkan roti dan berdoa."
 },
 {
   "id": 27006,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 43,
   "firman": "Maka ketakutanlah mereka semua, sedang rasul-rasul itu mengadakan banyak mujizat dan tanda."
 },
 {
   "id": 27007,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 44,
   "firman": "Dan semua orang yang telah menjadi percaya tetap bersatu, dan segala kepunyaan mereka adalah kepunyaan bersama,"
 },
 {
   "id": 27008,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 45,
   "firman": "dan selalu ada dari mereka yang menjual harta miliknya, lalu membagi-bagikannya kepada semua orang sesuai dengan keperluan masing-masing."
 },
 {
   "id": 27009,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 46,
   "firman": "Dengan bertekun dan dengan sehati mereka berkumpul tiap-tiap hari dalam Bait Allah. Mereka memecahkan roti di rumah masing-masing secara bergilir dan makan bersama-sama dengan gembira dan dengan tulus hati,"
 },
 {
   "id": 27010,
   "kitab": "Kis",
   "pasal": 2,
   "ayat": 47,
   "firman": "sambil memuji Allah. Dan mereka disukai semua orang. Dan tiap-tiap hari Tuhan menambah jumlah mereka dengan orang yang diselamatkan."
 },
 {
   "id": 27011,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 1,
   "firman": "Pada suatu hari menjelang waktu sembahyang, yaitu pukul tiga petang, naiklah Petrus dan Yohanes ke Bait Allah."
 },
 {
   "id": 27012,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 2,
   "firman": "Di situ ada seorang laki-laki, yang lumpuh sejak lahirnya sehingga ia harus diusung. Tiap-tiap hari orang itu diletakkan dekat pintu gerbang Bait Allah, yang bernama Gerbang Indah, untuk meminta sedekah kepada orang yang masuk ke dalam Bait Allah."
 },
 {
   "id": 27013,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 3,
   "firman": "Ketika orang itu melihat, bahwa Petrus dan Yohanes hendak masuk ke Bait Allah, ia meminta sedekah."
 },
 {
   "id": 27014,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 4,
   "firman": "Mereka menatap dia dan Petrus berkata: \"Lihatlah kepada kami.\""
 },
 {
   "id": 27015,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 5,
   "firman": "Lalu orang itu menatap mereka dengan harapan akan mendapat sesuatu dari mereka."
 },
 {
   "id": 27016,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 6,
   "firman": "Tetapi Petrus berkata: \"Emas dan perak tidak ada padaku, tetapi apa yang kupunyai, kuberikan kepadamu: Demi nama Yesus Kristus, orang Nazaret itu, berjalanlah!\""
 },
 {
   "id": 27017,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 7,
   "firman": "Lalu ia memegang tangan kanan orang itu dan membantu dia berdiri. Seketika itu juga kuatlah kaki dan mata kaki orang itu."
 },
 {
   "id": 27018,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 8,
   "firman": "Ia melonjak berdiri lalu berjalan kian ke mari dan mengikuti mereka ke dalam Bait Allah, berjalan dan melompat-lompat serta memuji Allah."
 },
 {
   "id": 27019,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 9,
   "firman": "Seluruh rakyat itu melihat dia berjalan sambil memuji Allah,"
 },
 {
   "id": 27020,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 10,
   "firman": "lalu mereka mengenal dia sebagai orang yang biasanya duduk meminta sedekah di Gerbang Indah Bait Allah, sehingga mereka takjub dan tercengang tentang apa yang telah terjadi padanya."
 },
 {
   "id": 27021,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 11,
   "firman": "Karena orang itu tetap mengikuti Petrus dan Yohanes, maka seluruh orang banyak yang sangat keheranan itu datang mengerumuni mereka di serambi yang disebut Serambi Salomo."
 },
 {
   "id": 27022,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 12,
   "firman": "Petrus melihat orang banyak itu lalu berkata: \"Hai orang Israel, mengapa kamu heran tentang kejadian itu dan mengapa kamu menatap kami seolah-olah kami membuat orang ini berjalan karena kuasa atau kesalehan kami sendiri?"
 },
 {
   "id": 27023,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 13,
   "firman": "Allah Abraham, Ishak dan Yakub, Allah nenek moyang kita telah memuliakan Hamba-Nya, yaitu Yesus yang kamu serahkan dan tolak di depan Pilatus, walaupun Pilatus berpendapat, bahwa Ia harus dilepaskan."
 },
 {
   "id": 27024,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 14,
   "firman": "Tetapi kamu telah menolak Yang Kudus dan Benar, serta menghendaki seorang pembunuh sebagai hadiahmu."
 },
 {
   "id": 27025,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 15,
   "firman": "Demikianlah Ia, Pemimpin kepada hidup, telah kamu bunuh, tetapi Allah telah membangkitkan Dia dari antara orang mati; dan tentang hal itu kami adalah saksi."
 },
 {
   "id": 27026,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 16,
   "firman": "Dan karena kepercayaan dalam Nama Yesus, maka Nama itu telah menguatkan orang yang kamu lihat dan kamu kenal ini; dan kepercayaan itu telah memberi kesembuhan kepada orang ini di depan kamu semua."
 },
 {
   "id": 27027,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 17,
   "firman": "Hai saudara-saudara, aku tahu bahwa kamu telah berbuat demikian karena ketidaktahuan, sama seperti semua pemimpin kamu."
 },
 {
   "id": 27028,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 18,
   "firman": "Tetapi dengan jalan demikian Allah telah menggenapi apa yang telah difirmankan-Nya dahulu dengan perantaraan nabi-nabi-Nya, yaitu bahwa Mesias yang diutus-Nya harus menderita."
 },
 {
   "id": 27029,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 19,
   "firman": "Karena itu sadarlah dan bertobatlah, supaya dosamu dihapuskan,"
 },
 {
   "id": 27030,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 20,
   "firman": "agar Tuhan mendatangkan waktu kelegaan, dan mengutus Yesus, yang dari semula diuntukkan bagimu sebagai Kristus."
 },
 {
   "id": 27031,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 21,
   "firman": "Kristus itu harus tinggal di sorga sampai waktu pemulihan segala sesuatu, seperti yang difirmankan Allah dengan perantaraan nabi-nabi-Nya yang kudus di zaman dahulu."
 },
 {
   "id": 27032,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 22,
   "firman": "Bukankah telah dikatakan Musa: Tuhan Allah akan membangkitkan bagimu seorang nabi dari antara saudara-saudaramu, sama seperti aku: Dengarkanlah dia dalam segala sesuatu yang akan dikatakannya kepadamu."
 },
 {
   "id": 27033,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 23,
   "firman": "Dan akan terjadi, bahwa semua orang yang tidak mendengarkan nabi itu, akan dibasmi dari umat kita."
 },
 {
   "id": 27034,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 24,
   "firman": "Dan semua nabi yang pernah berbicara, mulai dari Samuel, dan sesudah dia, telah bernubuat tentang zaman ini."
 },
 {
   "id": 27035,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 25,
   "firman": "Kamulah yang mewarisi nubuat-nubuat itu dan mendapat bagian dalam perjanjian yang telah diadakan Allah dengan nenek moyang kita, ketika Ia berfirman kepada Abraham: Oleh keturunanmu semua bangsa di muka bumi akan diberkati."
 },
 {
   "id": 27036,
   "kitab": "Kis",
   "pasal": 3,
   "ayat": 26,
   "firman": "Dan bagi kamulah pertama-tama Allah membangkitkan Hamba-Nya dan mengutus-Nya kepada kamu, supaya Ia memberkati kamu dengan memimpin kamu masing-masing kembali dari segala kejahatanmu.\""
 },
 {
   "id": 27037,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 1,
   "firman": "Ketika Petrus dan Yohanes sedang berbicara kepada orang banyak, mereka tiba-tiba didatangi imam-imam dan kepala pengawal Bait Allah serta orang-orang Saduki."
 },
 {
   "id": 27038,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 2,
   "firman": "Orang-orang itu sangat marah karena mereka mengajar orang banyak dan memberitakan, bahwa dalam Yesus ada kebangkitan dari antara orang mati."
 },
 {
   "id": 27039,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 3,
   "firman": "Mereka ditangkap dan diserahkan ke dalam tahanan sampai keesokan harinya, karena hari telah malam."
 },
 {
   "id": 27040,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi di antara orang yang mendengar ajaran itu banyak yang menjadi percaya, sehingga jumlah mereka menjadi kira-kira lima ribu orang laki-laki."
 },
 {
   "id": 27041,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 5,
   "firman": "Pada keesokan harinya pemimpin-pemimpin Yahudi serta tua-tua dan ahli-ahli Taurat mengadakan sidang di Yerusalem"
 },
 {
   "id": 27042,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 6,
   "firman": "dengan Imam Besar Hanas dan Kayafas, Yohanes dan Aleksander dan semua orang lain yang termasuk keturunan Imam Besar."
 },
 {
   "id": 27043,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 7,
   "firman": "Lalu Petrus dan Yohanes dihadapkan kepada sidang itu dan mulai diperiksa dengan pertanyaan ini: \"Dengan kuasa manakah atau dalam nama siapakah kamu bertindak demikian itu?\""
 },
 {
   "id": 27044,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 8,
   "firman": "Maka jawab Petrus, penuh dengan Roh Kudus: \"Hai pemimpin-pemimpin umat dan tua-tua,"
 },
 {
   "id": 27045,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 9,
   "firman": "jika kami sekarang harus diperiksa karena suatu kebajikan kepada seorang sakit dan harus menerangkan dengan kuasa manakah orang itu disembuhkan,"
 },
 {
   "id": 27046,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 10,
   "firman": "maka ketahuilah oleh kamu sekalian dan oleh seluruh umat Israel, bahwa dalam nama Yesus Kristus, orang Nazaret, yang telah kamu salibkan, tetapi yang telah dibangkitkan Allah dari antara orang mati--bahwa oleh karena Yesus itulah orang ini berdiri dengan sehat sekarang di depan kamu."
 },
 {
   "id": 27047,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 11,
   "firman": "Yesus adalah batu yang dibuang oleh tukang-tukang bangunan--yaitu kamu sendiri--,namun ia telah menjadi batu penjuru."
 },
 {
   "id": 27048,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 12,
   "firman": "Dan keselamatan tidak ada di dalam siapapun juga selain di dalam Dia, sebab di bawah kolong langit ini tidak ada nama lain yang diberikan kepada manusia yang olehnya kita dapat diselamatkan.\""
 },
 {
   "id": 27049,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 13,
   "firman": "Ketika sidang itu melihat keberanian Petrus dan Yohanes dan mengetahui, bahwa keduanya orang biasa yang tidak terpelajar, heranlah mereka; dan mereka mengenal keduanya sebagai pengikut Yesus."
 },
 {
   "id": 27050,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 14,
   "firman": "Tetapi karena mereka melihat orang yang disembuhkan itu berdiri di samping kedua rasul itu, mereka tidak dapat mengatakan apa-apa untuk membantahnya."
 },
 {
   "id": 27051,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 15,
   "firman": "Dan setelah mereka menyuruh rasul-rasul itu meninggalkan ruang sidang, berundinglah mereka,"
 },
 {
   "id": 27052,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 16,
   "firman": "dan berkata: \"Tindakan apakah yang harus kita ambil terhadap orang-orang ini? Sebab telah nyata kepada semua penduduk Yerusalem, bahwa mereka telah mengadakan suatu mujizat yang menyolok dan kita tidak dapat menyangkalnya."
 },
 {
   "id": 27053,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 17,
   "firman": "Tetapi supaya hal itu jangan makin luas tersiar di antara orang banyak, baiklah kita mengancam dan melarang mereka, supaya mereka jangan berbicara lagi dengan siapapun dalam nama itu.\""
 },
 {
   "id": 27054,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 18,
   "firman": "Dan setelah keduanya disuruh masuk, mereka diperintahkan, supaya sama sekali jangan berbicara atau mengajar lagi dalam nama Yesus."
 },
 {
   "id": 27055,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 19,
   "firman": "Tetapi Petrus dan Yohanes menjawab mereka: \"Silakan kamu putuskan sendiri manakah yang benar di hadapan Allah: taat kepada kamu atau taat kepada Allah."
 },
 {
   "id": 27056,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 20,
   "firman": "Sebab tidak mungkin bagi kami untuk tidak berkata-kata tentang apa yang telah kami lihat dan yang telah kami dengar.\""
 },
 {
   "id": 27057,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 21,
   "firman": "Mereka semakin keras mengancam rasul-rasul itu, tetapi akhirnya melepaskan mereka juga, sebab sidang tidak melihat jalan untuk menghukum mereka karena takut akan orang banyak yang memuliakan nama Allah berhubung dengan apa yang telah terjadi."
 },
 {
   "id": 27058,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 22,
   "firman": "Sebab orang yang disembuhkan oleh mujizat itu sudah lebih dari empat puluh tahun umurnya."
 },
 {
   "id": 27059,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 23,
   "firman": "Sesudah dilepaskan pergilah Petrus dan Yohanes kepada teman-teman mereka, lalu mereka menceriterakan segala sesuatu yang dikatakan imam-imam kepala dan tua-tua kepada mereka."
 },
 {
   "id": 27060,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 24,
   "firman": "Ketika teman-teman mereka mendengar hal itu, berserulah mereka bersama-sama kepada Allah, katanya: \"Ya Tuhan, Engkaulah yang menjadikan langit dan bumi, laut dan segala isinya."
 },
 {
   "id": 27061,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 25,
   "firman": "Dan oleh Roh Kudus dengan perantaraan hamba-Mu Daud, bapa kami, Engkau telah berfirman: Mengapa rusuh bangsa-bangsa, mengapa suku-suku bangsa mereka-reka perkara yang sia-sia?"
 },
 {
   "id": 27062,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 26,
   "firman": "Raja-raja dunia bersiap-siap dan para pembesar berkumpul untuk melawan Tuhan dan Yang Diurapi-Nya."
 },
 {
   "id": 27063,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 27,
   "firman": "Sebab sesungguhnya telah berkumpul di dalam kota ini Herodes dan Pontius Pilatus beserta bangsa-bangsa dan suku-suku bangsa Israel melawan Yesus, Hamba-Mu yang kudus, yang Engkau urapi,"
 },
 {
   "id": 27064,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 28,
   "firman": "untuk melaksanakan segala sesuatu yang telah Engkau tentukan dari semula oleh kuasa dan kehendak-Mu."
 },
 {
   "id": 27065,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 29,
   "firman": "Dan sekarang, ya Tuhan, lihatlah bagaimana mereka mengancam kami dan berikanlah kepada hamba-hamba-Mu keberanian untuk memberitakan firman-Mu."
 },
 {
   "id": 27066,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 30,
   "firman": "Ulurkanlah tangan-Mu untuk menyembuhkan orang, dan adakanlah tanda-tanda dan mujizat-mujizat oleh nama Yesus, Hamba-Mu yang kudus.\""
 },
 {
   "id": 27067,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 31,
   "firman": "Dan ketika mereka sedang berdoa, goyanglah tempat mereka berkumpul itu dan mereka semua penuh dengan Roh Kudus, lalu mereka memberitakan firman Allah dengan berani."
 },
 {
   "id": 27068,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 32,
   "firman": "Adapun kumpulan orang yang telah percaya itu, mereka sehati dan sejiwa, dan tidak seorangpun yang berkata, bahwa sesuatu dari kepunyaannya adalah miliknya sendiri, tetapi segala sesuatu adalah kepunyaan mereka bersama."
 },
 {
   "id": 27069,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 33,
   "firman": "Dan dengan kuasa yang besar rasul-rasul memberi kesaksian tentang kebangkitan Tuhan Yesus dan mereka semua hidup dalam kasih karunia yang melimpah-limpah."
 },
 {
   "id": 27070,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 34,
   "firman": "Sebab tidak ada seorangpun yang berkekurangan di antara mereka; karena semua orang yang mempunyai tanah atau rumah, menjual kepunyaannya itu, dan hasil penjualan itu mereka bawa"
 },
 {
   "id": 27071,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 35,
   "firman": "dan mereka letakkan di depan kaki rasul-rasul; lalu dibagi-bagikan kepada setiap orang sesuai dengan keperluannya."
 },
 {
   "id": 27072,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 36,
   "firman": "Demikian pula dengan Yusuf, yang oleh rasul-rasul disebut Barnabas, artinya anak penghiburan, seorang Lewi dari Siprus."
 },
 {
   "id": 27073,
   "kitab": "Kis",
   "pasal": 4,
   "ayat": 37,
   "firman": "Ia menjual ladang, miliknya, lalu membawa uangnya itu dan meletakkannya di depan kaki rasul-rasul."
 },
 {
   "id": 27074,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 1,
   "firman": "Ada seorang lain yang bernama Ananias. Ia beserta isterinya Safira menjual sebidang tanah."
 },
 {
   "id": 27075,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 2,
   "firman": "Dengan setahu isterinya ia menahan sebagian dari hasil penjualan itu dan sebagian lain dibawa dan diletakkannya di depan kaki rasul-rasul."
 },
 {
   "id": 27076,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 3,
   "firman": "Tetapi Petrus berkata: \"Ananias, mengapa hatimu dikuasai Iblis, sehingga engkau mendustai Roh Kudus dan menahan sebagian dari hasil penjualan tanah itu?"
 },
 {
   "id": 27077,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 4,
   "firman": "Selama tanah itu tidak dijual, bukankah itu tetap kepunyaanmu, dan setelah dijual, bukankah hasilnya itu tetap dalam kuasamu? Mengapa engkau merencanakan perbuatan itu dalam hatimu? Engkau bukan mendustai manusia, tetapi mendustai Allah.\""
 },
 {
   "id": 27078,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 5,
   "firman": "Ketika mendengar perkataan itu rebahlah Ananias dan putuslah nyawanya. Maka sangatlah ketakutan semua orang yang mendengar hal itu."
 },
 {
   "id": 27079,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 6,
   "firman": "Lalu datanglah beberapa orang muda; mereka mengapani mayat itu, mengusungnya ke luar dan pergi menguburnya."
 },
 {
   "id": 27080,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 7,
   "firman": "Kira-kira tiga jam kemudian masuklah isteri Ananias, tetapi ia tidak tahu apa yang telah terjadi."
 },
 {
   "id": 27081,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kata Petrus kepadanya: \"Katakanlah kepadaku, dengan harga sekiankah tanah itu kamu jual?\" Jawab perempuan itu: \"Betul sekian.\""
 },
 {
   "id": 27082,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kata Petrus: \"Mengapa kamu berdua bersepakat untuk mencobai Roh Tuhan? Lihatlah, orang-orang yang baru mengubur suamimu berdiri di depan pintu dan mereka akan mengusung engkau juga ke luar.\""
 },
 {
   "id": 27083,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 10,
   "firman": "Lalu rebahlah perempuan itu seketika itu juga di depan kaki Petrus dan putuslah nyawanya. Ketika orang-orang muda itu masuk, mereka mendapati dia sudah mati, lalu mereka mengusungnya ke luar dan menguburnya di samping suaminya."
 },
 {
   "id": 27084,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 11,
   "firman": "Maka sangat ketakutanlah seluruh jemaat dan semua orang yang mendengar hal itu."
 },
 {
   "id": 27085,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 12,
   "firman": "Dan oleh rasul-rasul diadakan banyak tanda dan mujizat di antara orang banyak. Semua orang percaya selalu berkumpul di Serambi Salomo dalam persekutuan yang erat."
 },
 {
   "id": 27086,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 13,
   "firman": "Orang-orang lain tidak ada yang berani menggabungkan diri kepada mereka. Namun mereka sangat dihormati orang banyak."
 },
 {
   "id": 27087,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 14,
   "firman": "Dan makin lama makin bertambahlah jumlah orang yang percaya kepada Tuhan, baik laki-laki maupun perempuan,"
 },
 {
   "id": 27088,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 15,
   "firman": "bahkan mereka membawa orang-orang sakit ke luar, ke jalan raya, dan membaringkannya di atas balai-balai dan tilam, supaya, apabila Petrus lewat, setidak-tidaknya bayangannya mengenai salah seorang dari mereka."
 },
 {
   "id": 27089,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 16,
   "firman": "Dan juga orang banyak dari kota-kota di sekitar Yerusalem datang berduyun-duyun serta membawa orang-orang yang sakit dan orang-orang yang diganggu roh jahat. Dan mereka semua disembuhkan."
 },
 {
   "id": 27090,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 17,
   "firman": "Akhirnya mulailah Imam Besar dan pengikut-pengikutnya, yaitu orang-orang dari mazhab Saduki, bertindak sebab mereka sangat iri hati."
 },
 {
   "id": 27091,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 18,
   "firman": "Mereka menangkap rasul-rasul itu, lalu memasukkan mereka ke dalam penjara kota."
 },
 {
   "id": 27092,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 19,
   "firman": "Tetapi waktu malam seorang malaikat Tuhan membuka pintu-pintu penjara itu dan membawa mereka ke luar, katanya:"
 },
 {
   "id": 27093,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 20,
   "firman": "\"Pergilah, berdirilah di Bait Allah dan beritakanlah seluruh firman hidup itu kepada orang banyak.\""
 },
 {
   "id": 27094,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 21,
   "firman": "Mereka mentaati pesan itu, dan menjelang pagi masuklah mereka ke dalam Bait Allah, lalu mulai mengajar di situ. Sementara itu Imam Besar dan pengikut-pengikutnya menyuruh Mahkamah Agama berkumpul, yaitu seluruh majelis tua-tua bangsa Israel, dan mereka menyuruh mengambil rasul-rasul itu dari penjara."
 },
 {
   "id": 27095,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 22,
   "firman": "Tetapi ketika pejabat-pejabat datang ke penjara, mereka tidak menemukan rasul-rasul itu di situ. Lalu mereka kembali dan memberitahukan,"
 },
 {
   "id": 27096,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 23,
   "firman": "katanya: \"Kami mendapati penjara terkunci dengan sangat rapihnya dan semua pengawal ada di tempatnya di muka pintu, tetapi setelah kami membukanya, tidak seorangpun yang kami temukan di dalamnya.\""
 },
 {
   "id": 27097,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 24,
   "firman": "Ketika kepala pengawal Bait Allah dan imam-imam kepala mendengar laporan itu, mereka cemas dan bertanya apa yang telah terjadi dengan rasul-rasul itu."
 },
 {
   "id": 27098,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 25,
   "firman": "Tetapi datanglah seorang mendapatkan mereka dengan kabar: \"Lihat, orang-orang yang telah kamu masukkan ke dalam penjara, ada di dalam Bait Allah dan mereka mengajar orang banyak.\""
 },
 {
   "id": 27099,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 26,
   "firman": "Maka pergilah kepala pengawal serta orang-orangnya ke Bait Allah, lalu mengambil kedua rasul itu, tetapi tidak dengan kekerasan, karena mereka takut, kalau-kalau orang banyak melempari mereka."
 },
 {
   "id": 27100,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 27,
   "firman": "Mereka membawa keduanya dan menghadapkan mereka kepada Mahkamah Agama. Imam Besar mulai menanyai mereka,"
 },
 {
   "id": 27101,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 28,
   "firman": "katanya: \"Dengan keras kami melarang kamu mengajar dalam Nama itu. Namun ternyata, kamu telah memenuhi Yerusalem dengan ajaranmu dan kamu hendak menanggungkan darah Orang itu kepada kami.\""
 },
 {
   "id": 27102,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 29,
   "firman": "Tetapi Petrus dan rasul-rasul itu menjawab, katanya: \"Kita harus lebih taat kepada Allah dari pada kepada manusia."
 },
 {
   "id": 27103,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 30,
   "firman": "Allah nenek moyang kita telah membangkitkan Yesus, yang kamu gantungkan pada kayu salib dan kamu bunuh."
 },
 {
   "id": 27104,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 31,
   "firman": "Dialah yang telah ditinggikan oleh Allah sendiri dengan tangan kanan-Nya menjadi Pemimpin dan Juruselamat, supaya Israel dapat bertobat dan menerima pengampunan dosa."
 },
 {
   "id": 27105,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 32,
   "firman": "Dan kami adalah saksi dari segala sesuatu itu, kami dan Roh Kudus, yang dikaruniakan Allah kepada semua orang yang mentaati Dia.\""
 },
 {
   "id": 27106,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 33,
   "firman": "Mendengar perkataan itu sangatlah tertusuk hati mereka dan mereka bermaksud membunuh rasul-rasul itu."
 },
 {
   "id": 27107,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 34,
   "firman": "Tetapi seorang Farisi dalam Mahkamah Agama itu, yang bernama Gamaliel, seorang ahli Taurat yang sangat dihormati seluruh orang banyak, bangkit dan meminta, supaya orang-orang itu disuruh keluar sebentar."
 },
 {
   "id": 27108,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 35,
   "firman": "Sesudah itu ia berkata kepada sidang: \"Hai orang-orang Israel, pertimbangkanlah baik-baik, apa yang hendak kamu perbuat terhadap orang-orang ini!"
 },
 {
   "id": 27109,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 36,
   "firman": "Sebab dahulu telah muncul si Teudas, yang mengaku dirinya seorang istimewa dan ia mempunyai kira-kira empat ratus orang pengikut; tetapi ia dibunuh dan cerai-berailah seluruh pengikutnya dan lenyap."
 },
 {
   "id": 27110,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 37,
   "firman": "Sesudah dia, pada waktu pendaftaran penduduk, muncullah si Yudas, seorang Galilea. Ia menyeret banyak orang dalam pemberontakannya, tetapi ia juga tewas dan cerai-berailah seluruh pengikutnya."
 },
 {
   "id": 27111,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 38,
   "firman": "Karena itu aku berkata kepadamu: Janganlah bertindak terhadap orang-orang ini. Biarkanlah mereka, sebab jika maksud dan perbuatan mereka berasal dari manusia, tentu akan lenyap,"
 },
 {
   "id": 27112,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 39,
   "firman": "tetapi kalau berasal dari Allah, kamu tidak akan dapat melenyapkan orang-orang ini; mungkin ternyata juga nanti, bahwa kamu melawan Allah.\" Nasihat itu diterima."
 },
 {
   "id": 27113,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 40,
   "firman": "Mereka memanggil rasul-rasul itu, lalu menyesah mereka dan melarang mereka mengajar dalam nama Yesus. Sesudah itu mereka dilepaskan."
 },
 {
   "id": 27114,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 41,
   "firman": "Rasul-rasul itu meninggalkan sidang Mahkamah Agama dengan gembira, karena mereka telah dianggap layak menderita penghinaan oleh karena Nama Yesus."
 },
 {
   "id": 27115,
   "kitab": "Kis",
   "pasal": 5,
   "ayat": 42,
   "firman": "Dan setiap hari mereka melanjutkan pengajaran mereka di Bait Allah dan di rumah-rumah orang dan memberitakan Injil tentang Yesus yang adalah Mesias."
 },
 {
   "id": 27116,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 1,
   "firman": "Pada masa itu, ketika jumlah murid makin bertambah, timbullah sungut-sungut di antara orang-orang Yahudi yang berbahasa Yunani terhadap orang-orang Ibrani, karena pembagian kepada janda-janda mereka diabaikan dalam pelayanan sehari-hari."
 },
 {
   "id": 27117,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 2,
   "firman": "Berhubung dengan itu kedua belas rasul itu memanggil semua murid berkumpul dan berkata: \"Kami tidak merasa puas, karena kami melalaikan Firman Allah untuk melayani meja."
 },
 {
   "id": 27118,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 3,
   "firman": "Karena itu, saudara-saudara, pilihlah tujuh orang dari antaramu, yang terkenal baik, dan yang penuh Roh dan hikmat, supaya kami mengangkat mereka untuk tugas itu,"
 },
 {
   "id": 27119,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 4,
   "firman": "dan supaya kami sendiri dapat memusatkan pikiran dalam doa dan pelayanan Firman.\""
 },
 {
   "id": 27120,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 5,
   "firman": "Usul itu diterima baik oleh seluruh jemaat, lalu mereka memilih Stefanus, seorang yang penuh iman dan Roh Kudus, dan Filipus, Prokhorus, Nikanor, Timon, Parmenas dan Nikolaus, seorang penganut agama Yahudi dari Antiokhia."
 },
 {
   "id": 27121,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 6,
   "firman": "Mereka itu dihadapkan kepada rasul-rasul, lalu rasul-rasul itupun berdoa dan meletakkan tangan di atas mereka."
 },
 {
   "id": 27122,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 7,
   "firman": "Firman Allah makin tersebar, dan jumlah murid di Yerusalem makin bertambah banyak; juga sejumlah besar imam menyerahkan diri dan percaya."
 },
 {
   "id": 27123,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 8,
   "firman": "Dan Stefanus, yang penuh dengan karunia dan kuasa, mengadakan mujizat-mujizat dan tanda-tanda di antara orang banyak."
 },
 {
   "id": 27124,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi tampillah beberapa orang dari jemaat Yahudi yang disebut jemaat orang Libertini--anggota-anggota jemaat itu adalah orang-orang dari Kirene dan dari Aleksandria--bersama dengan beberapa orang Yahudi dari Kilikia dan dari Asia. Orang-orang itu bersoal jawab dengan Stefanus,"
 },
 {
   "id": 27125,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 10,
   "firman": "tetapi mereka tidak sanggup melawan hikmatnya dan Roh yang mendorong dia berbicara."
 },
 {
   "id": 27126,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 11,
   "firman": "Lalu mereka menghasut beberapa orang untuk mengatakan: \"Kami telah mendengar dia mengucapkan kata-kata hujat terhadap Musa dan Allah.\""
 },
 {
   "id": 27127,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 12,
   "firman": "Dengan jalan demikian mereka mengadakan suatu gerakan di antara orang banyak serta tua-tua dan ahli-ahli Taurat; mereka menyergap Stefanus, menyeretnya dan membawanya ke hadapan Mahkamah Agama."
 },
 {
   "id": 27128,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 13,
   "firman": "Lalu mereka memajukan saksi-saksi palsu yang berkata: \"Orang ini terus-menerus mengucapkan perkataan yang menghina tempat kudus ini dan hukum Taurat,"
 },
 {
   "id": 27129,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 14,
   "firman": "sebab kami telah mendengar dia mengatakan, bahwa Yesus, orang Nazaret itu, akan merubuhkan tempat ini dan mengubah adat istiadat yang diwariskan oleh Musa kepada kita.\""
 },
 {
   "id": 27130,
   "kitab": "Kis",
   "pasal": 6,
   "ayat": 15,
   "firman": "Semua orang yang duduk dalam sidang Mahkamah Agama itu menatap Stefanus, lalu mereka melihat muka Stefanus sama seperti muka seorang malaikat."
 },
 {
   "id": 27131,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 1,
   "firman": "Kata Imam Besar: \"Benarkah demikian?\""
 },
 {
   "id": 27132,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 2,
   "firman": "Jawab Stefanus: \"Hai saudara-saudara dan bapa-bapa, dengarkanlah! Allah yang Mahamulia telah menampakkan diri-Nya kepada bapa leluhur kita Abraham, ketika ia masih di Mesopotamia, sebelum ia menetap di Haran,"
 },
 {
   "id": 27133,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 3,
   "firman": "dan berfirman kepadanya: Keluarlah dari negerimu dan dari sanak saudaramu dan pergilah ke negeri yang akan Kutunjukkan kepadamu."
 },
 {
   "id": 27134,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 4,
   "firman": "Maka keluarlah ia dari negeri orang Kasdim, lalu menetap di Haran. Dan setelah ayahnya meninggal, Allah menyuruh dia pindah dari situ ke tanah ini, tempat kamu diam sekarang;"
 },
 {
   "id": 27135,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 5,
   "firman": "dan di situ Allah tidak memberikan milik pusaka kepadanya, bahkan setapak tanahpun tidak, tetapi Ia berjanji akan memberikan tanah itu kepadanya menjadi kepunyaannya dan kepunyaan keturunannya, walaupun pada waktu itu ia tidak mempunyai anak."
 },
 {
   "id": 27136,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 6,
   "firman": "Beginilah firman Allah, yaitu bahwa keturunannya akan menjadi pendatang di negeri asing dan bahwa mereka akan diperbudak dan dianiaya empat ratus tahun lamanya."
 },
 {
   "id": 27137,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 7,
   "firman": "Tetapi bangsa yang akan memperbudak mereka itu akan Kuhukum, firman Allah, dan sesudah itu mereka akan keluar dari situ dan beribadah kepada-Ku di tempat ini."
 },
 {
   "id": 27138,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 8,
   "firman": "Lalu Allah memberikan kepadanya perjanjian sunat; dan demikianlah Abraham memperanakkan Ishak, lalu menyunatkannya pada hari yang kedelapan; dan Ishak memperanakkan Yakub, dan Yakub memperanakkan kedua belas bapa leluhur kita."
 },
 {
   "id": 27139,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 9,
   "firman": "Karena iri hati, bapa-bapa leluhur kita menjual Yusuf ke tanah Mesir, tetapi Allah menyertai dia,"
 },
 {
   "id": 27140,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 10,
   "firman": "dan melepaskannya dari segala penindasan serta menganugerahkan kepadanya kasih karunia dan hikmat, ketika ia menghadap Firaun, raja Mesir. Firaun mengangkatnya menjadi kuasa atas tanah Mesir dan atas seluruh istananya."
 },
 {
   "id": 27141,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 11,
   "firman": "Maka datanglah bahaya kelaparan menimpa seluruh tanah Mesir dan tanah Kanaan serta penderitaan yang besar, sehingga nenek moyang kita tidak mendapat makanan."
 },
 {
   "id": 27142,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 12,
   "firman": "Tetapi ketika Yakub mendengar, bahwa di tanah Mesir ada gandum, ia menyuruh nenek moyang kita ke sana. Itulah kunjungan mereka yang pertama;"
 },
 {
   "id": 27143,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 13,
   "firman": "pada kunjungan mereka yang kedua Yusuf memperkenalkan dirinya kepada saudara-saudaranya, lalu ketahuanlah asal-usul Yusuf kepada Firaun."
 },
 {
   "id": 27144,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 14,
   "firman": "Kemudian Yusuf menyuruh menjemput Yakub, ayahnya, dan semua sanak saudaranya, tujuh puluh lima jiwa banyaknya."
 },
 {
   "id": 27145,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 15,
   "firman": "Lalu pergilah Yakub ke tanah Mesir. Di situ ia meninggal, ia dan nenek moyang kita;"
 },
 {
   "id": 27146,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 16,
   "firman": "mayat mereka dipindahkan ke Sikhem dan diletakkan di dalam kuburan yang telah dibeli Abraham dengan sejumlah uang perak dari anak-anak Hemor di Sikhem."
 },
 {
   "id": 27147,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 17,
   "firman": "Tetapi makin dekat genapnya janji yang diberikan Allah kepada Abraham, makin bertambah banyaklah bangsa itu di Mesir,"
 },
 {
   "id": 27148,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 18,
   "firman": "sampai bangkit seorang raja lain memerintah tanah Mesir, seorang yang tidak mengenal Yusuf."
 },
 {
   "id": 27149,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 19,
   "firman": "Raja itu mempergunakan tipu daya terhadap bangsa kita dan menganiaya nenek moyang kita serta menyuruh membuang bayi mereka, supaya bangsa kita itu jangan berkembang."
 },
 {
   "id": 27150,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 20,
   "firman": "Pada waktu itulah Musa lahir dan ia elok di mata Allah. Tiga bulan lamanya ia diasuh di rumah ayahnya."
 },
 {
   "id": 27151,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 21,
   "firman": "Lalu ia dibuang, tetapi puteri Firaun memungutnya dan menyuruh mengasuhnya seperti anaknya sendiri."
 },
 {
   "id": 27152,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 22,
   "firman": "Dan Musa dididik dalam segala hikmat orang Mesir, dan ia berkuasa dalam perkataan dan perbuatannya."
 },
 {
   "id": 27153,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 23,
   "firman": "Pada waktu ia berumur empat puluh tahun, timbullah keinginan dalam hatinya untuk mengunjungi saudara-saudaranya, yaitu orang-orang Israel."
 },
 {
   "id": 27154,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 24,
   "firman": "Ketika itu ia melihat seorang dianiaya oleh seorang Mesir, lalu ia menolong dan membela orang itu dengan membunuh orang Mesir itu."
 },
 {
   "id": 27155,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 25,
   "firman": "Pada sangkanya saudara-saudaranya akan mengerti, bahwa Allah memakai dia untuk menyelamatkan mereka, tetapi mereka tidak mengerti."
 },
 {
   "id": 27156,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 26,
   "firman": "Pada keesokan harinya ia muncul pula ketika dua orang Israel sedang berkelahi, lalu ia berusaha mendamaikan mereka, katanya: Saudara-saudara! Bukankah kamu ini bersaudara? Mengapakah kamu saling menganiaya?"
 },
 {
   "id": 27157,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 27,
   "firman": "Tetapi orang yang berbuat salah kepada temannya itu menolak Musa dan berkata: Siapakah yang mengangkat engkau menjadi pemimpin dan hakim atas kami?"
 },
 {
   "id": 27158,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 28,
   "firman": "Apakah engkau bermaksud membunuh aku, sama seperti kemarin engkau membunuh orang Mesir itu?"
 },
 {
   "id": 27159,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 29,
   "firman": "Mendengar perkataan itu, larilah Musa dan hidup sebagai pendatang di tanah Midian. Di situ ia memperanakkan dua orang anak laki-laki."
 },
 {
   "id": 27160,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 30,
   "firman": "Dan sesudah empat puluh tahun tampaklah kepadanya seorang malaikat di padang gurun gunung Sinai di dalam nyala api yang keluar dari semak duri."
 },
 {
   "id": 27161,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 31,
   "firman": "Musa heran tentang penglihatan itu, dan ketika ia pergi ke situ untuk melihatnya dari dekat, datanglah suara Tuhan kepadanya:"
 },
 {
   "id": 27162,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 32,
   "firman": "Akulah Allah nenek moyangmu, Allah Abraham, Ishak dan Yakub. Maka gemetarlah Musa, dan ia tidak berani lagi melihatnya."
 },
 {
   "id": 27163,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 33,
   "firman": "Lalu firman Allah kepadanya: Tanggalkanlah kasutmu dari kakimu, sebab tempat, di mana engkau berdiri itu, adalah tanah yang kudus."
 },
 {
   "id": 27164,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 34,
   "firman": "Aku telah memperhatikan dengan sungguh kesengsaraan umat-Ku di tanah Mesir dan Aku telah mendengar keluh kesah mereka, dan Aku telah turun untuk melepaskan mereka; karena itu marilah, engkau akan Kuutus ke tanah Mesir."
 },
 {
   "id": 27165,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 35,
   "firman": "Musa ini, yang telah mereka tolak, dengan mengatakan: Siapakah yang mengangkat engkau menjadi pemimpin dan hakim? --Musa ini juga telah diutus oleh Allah sebagai pemimpin dan penyelamat oleh malaikat, yang telah menampakkan diri kepadanya di semak duri itu."
 },
 {
   "id": 27166,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 36,
   "firman": "Dialah yang membawa mereka keluar dengan mengadakan mujizat-mujizat dan tanda-tanda di tanah Mesir, di Laut Merah dan di padang gurun, empat puluh tahun lamanya."
 },
 {
   "id": 27167,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 37,
   "firman": "Musa ini pulalah yang berkata kepada orang Israel: Seorang nabi seperti aku ini akan dibangkitkan Allah bagimu dari antara saudara-saudaramu."
 },
 {
   "id": 27168,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 38,
   "firman": "Musa inilah yang menjadi pengantara dalam sidang jemaah di padang gurun di antara malaikat yang berfirman kepadanya di gunung Sinai dan nenek moyang kita; dan dialah yang menerima firman-firman yang hidup untuk menyampaikannya kepada kamu."
 },
 {
   "id": 27169,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 39,
   "firman": "Tetapi nenek moyang kita tidak mau taat kepadanya, malahan mereka menolaknya. Dalam hati mereka ingin kembali ke tanah Mesir."
 },
 {
   "id": 27170,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 40,
   "firman": "Kepada Harun mereka berkata: Buatlah untuk kami beberapa allah yang akan berjalan di depan kami, sebab Musa ini yang telah memimpin kami keluar dari tanah Mesir--kami tidak tahu apa yang telah terjadi dengan dia."
 },
 {
   "id": 27171,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 41,
   "firman": "Lalu pada waktu itu mereka membuat sebuah anak lembu dan mempersembahkan persembahan kepada berhala itu dan mereka bersukacita tentang apa yang dibuat sendiri oleh mereka."
 },
 {
   "id": 27172,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 42,
   "firman": "Maka berpalinglah Allah dari mereka dan membiarkan mereka beribadah kepada bala tentara langit, seperti yang tertulis dalam kitab nabi-nabi: Apakah kamu mempersembahkan kepada-Ku korban sembelihan dan persembahan selama empat puluh tahun di padang gurun itu, hai kaum Israel?"
 },
 {
   "id": 27173,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 43,
   "firman": "Tidak pernah, malahan kamu mengusung kemah Molokh dan bintang dewa Refan, patung-patung yang kamu buat itu untuk disembah. Maka Aku akan membawa kamu ke dalam pembuangan, sampai di seberang sana Babel."
 },
 {
   "id": 27174,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 44,
   "firman": "Kemah Kesaksian ada pada nenek moyang kita di padang gurun, seperti yang diperintahkan Allah kepada Musa untuk membuatnya menurut contoh yang telah dilihatnya."
 },
 {
   "id": 27175,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 45,
   "firman": "Kemah itu yang diterima nenek moyang kita dan yang dengan pimpinan Yosua dibawa masuk ke tanah ini, yaitu waktu tanah ini direbut dari bangsa-bangsa lain yang dihalau Allah dari depan nenek moyang kita; demikianlah sampai kepada zaman Daud."
 },
 {
   "id": 27176,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 46,
   "firman": "Daud telah mendapat kasih karunia di hadapan Allah dan ia memohon, supaya ia diperkenankan untuk mendirikan suatu tempat kediaman bagi Allah Yakub."
 },
 {
   "id": 27177,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 47,
   "firman": "Tetapi Salomolah yang mendirikan sebuah rumah untuk Allah."
 },
 {
   "id": 27178,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 48,
   "firman": "Tetapi Yang Mahatinggi tidak diam di dalam apa yang dibuat oleh tangan manusia, seperti yang dikatakan oleh nabi:"
 },
 {
   "id": 27179,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 49,
   "firman": "Langit adalah takhta-Ku, dan bumi adalah tumpuan kaki-Ku. Rumah apakah yang akan kamu dirikan bagi-Ku, demikian firman Tuhan, tempat apakah yang akan menjadi perhentian-Ku?"
 },
 {
   "id": 27180,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 50,
   "firman": "Bukankah tangan-Ku sendiri yang membuat semuanya ini?"
 },
 {
   "id": 27181,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 51,
   "firman": "Hai orang-orang yang keras kepala dan yang tidak bersunat hati dan telinga, kamu selalu menentang Roh Kudus, sama seperti nenek moyangmu, demikian juga kamu."
 },
 {
   "id": 27182,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 52,
   "firman": "Siapakah dari nabi-nabi yang tidak dianiaya oleh nenek moyangmu? Bahkan mereka membunuh orang-orang yang lebih dahulu memberitakan tentang kedatangan Orang Benar, yang sekarang telah kamu khianati dan kamu bunuh."
 },
 {
   "id": 27183,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 53,
   "firman": "Kamu telah menerima hukum Taurat yang disampaikan oleh malaikat-malaikat, akan tetapi kamu tidak menurutinya.\""
 },
 {
   "id": 27184,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 54,
   "firman": "Ketika anggota-anggota Mahkamah Agama itu mendengar semuanya itu, sangat tertusuk hati mereka. Maka mereka menyambutnya dengan gertakan gigi."
 },
 {
   "id": 27185,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 55,
   "firman": "Tetapi Stefanus, yang penuh dengan Roh Kudus, menatap ke langit, lalu melihat kemuliaan Allah dan Yesus berdiri di sebelah kanan Allah."
 },
 {
   "id": 27186,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 56,
   "firman": "Lalu katanya: \"Sungguh, aku melihat langit terbuka dan Anak Manusia berdiri di sebelah kanan Allah.\""
 },
 {
   "id": 27187,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 57,
   "firman": "Maka berteriak-teriaklah mereka dan sambil menutup telinga serentak menyerbu dia."
 },
 {
   "id": 27188,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 58,
   "firman": "Mereka menyeret dia ke luar kota, lalu melemparinya. Dan saksi-saksi meletakkan jubah mereka di depan kaki seorang muda yang bernama Saulus."
 },
 {
   "id": 27189,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 59,
   "firman": "Sedang mereka melemparinya Stefanus berdoa, katanya: \"Ya Tuhan Yesus, terimalah rohku.\""
 },
 {
   "id": 27190,
   "kitab": "Kis",
   "pasal": 7,
   "ayat": 60,
   "firman": "Sambil berlutut ia berseru dengan suara nyaring: \"Tuhan, janganlah tanggungkan dosa ini kepada mereka!\" Dan dengan perkataan itu meninggallah ia."
 },
 {
   "id": 27191,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 1,
   "firman": "Saulus juga setuju, bahwa Stefanus mati dibunuh."
 },
 {
   "id": 27193,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 2,
   "firman": "Orang-orang saleh menguburkan mayat Stefanus serta meratapinya dengan sangat."
 },
 {
   "id": 27194,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 3,
   "firman": "Tetapi Saulus berusaha membinasakan jemaat itu dan ia memasuki rumah demi rumah dan menyeret laki-laki dan perempuan ke luar dan menyerahkan mereka untuk dimasukkan ke dalam penjara."
 },
 {
   "id": 27195,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 4,
   "firman": "Mereka yang tersebar itu menjelajah seluruh negeri itu sambil memberitakan Injil."
 },
 {
   "id": 27196,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 5,
   "firman": "Dan Filipus pergi ke suatu kota di Samaria dan memberitakan Mesias kepada orang-orang di situ."
 },
 {
   "id": 27197,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 6,
   "firman": "Ketika orang banyak itu mendengar pemberitaan Filipus dan melihat tanda-tanda yang diadakannya, mereka semua dengan bulat hati menerima apa yang diberitakannya itu."
 },
 {
   "id": 27198,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebab dari banyak orang yang kerasukan roh jahat keluarlah roh-roh itu sambil berseru dengan suara keras, dan banyak juga orang lumpuh dan orang timpang yang disembuhkan."
 },
 {
   "id": 27199,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 8,
   "firman": "Maka sangatlah besar sukacita dalam kota itu."
 },
 {
   "id": 27200,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 9,
   "firman": "Seorang yang bernama Simon telah sejak dahulu melakukan sihir di kota itu dan mentakjubkan rakyat Samaria, serta berlagak seolah-olah ia seorang yang sangat penting."
 },
 {
   "id": 27201,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 10,
   "firman": "Semua orang, besar kecil, mengikuti dia dan berkata: \"Orang ini adalah kuasa Allah yang terkenal sebagai Kuasa Besar.\""
 },
 {
   "id": 27202,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dan mereka mengikutinya, karena sudah lama ia mentakjubkan mereka oleh perbuatan sihirnya."
 },
 {
   "id": 27203,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 12,
   "firman": "Tetapi sekarang mereka percaya kepada Filipus yang memberitakan Injil tentang Kerajaan Allah dan tentang nama Yesus Kristus, dan mereka memberi diri mereka dibaptis, baik laki-laki maupun perempuan."
 },
 {
   "id": 27204,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 13,
   "firman": "Simon sendiri juga menjadi percaya, dan sesudah dibaptis, ia senantiasa bersama-sama dengan Filipus, dan takjub ketika ia melihat tanda-tanda dan mujizat-mujizat besar yang terjadi."
 },
 {
   "id": 27205,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 14,
   "firman": "Ketika rasul-rasul di Yerusalem mendengar, bahwa tanah Samaria telah menerima firman Allah, mereka mengutus Petrus dan Yohanes ke situ."
 },
 {
   "id": 27206,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 15,
   "firman": "Setibanya di situ kedua rasul itu berdoa, supaya orang-orang Samaria itu beroleh Roh Kudus."
 },
 {
   "id": 27207,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 16,
   "firman": "Sebab Roh Kudus belum turun di atas seorangpun di antara mereka, karena mereka hanya dibaptis dalam nama Tuhan Yesus."
 },
 {
   "id": 27208,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 17,
   "firman": "Kemudian keduanya menumpangkan tangan di atas mereka, lalu mereka menerima Roh Kudus."
 },
 {
   "id": 27209,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 18,
   "firman": "Ketika Simon melihat, bahwa pemberian Roh Kudus terjadi oleh karena rasul-rasul itu menumpangkan tangannya, ia menawarkan uang kepada mereka,"
 },
 {
   "id": 27210,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 19,
   "firman": "serta berkata: \"Berikanlah juga kepadaku kuasa itu, supaya jika aku menumpangkan tanganku di atas seseorang, ia boleh menerima Roh Kudus.\""
 },
 {
   "id": 27211,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 20,
   "firman": "Tetapi Petrus berkata kepadanya: \"Binasalah kiranya uangmu itu bersama dengan engkau, karena engkau menyangka, bahwa engkau dapat membeli karunia Allah dengan uang."
 },
 {
   "id": 27212,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 21,
   "firman": "Tidak ada bagian atau hakmu dalam perkara ini, sebab hatimu tidak lurus di hadapan Allah."
 },
 {
   "id": 27213,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 22,
   "firman": "Jadi bertobatlah dari kejahatanmu ini dan berdoalah kepada Tuhan, supaya Ia mengampuni niat hatimu ini;"
 },
 {
   "id": 27214,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 23,
   "firman": "sebab kulihat, bahwa hatimu telah seperti empedu yang pahit dan terjerat dalam kejahatan.\""
 },
 {
   "id": 27215,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 24,
   "firman": "Jawab Simon: \"Hendaklah kamu berdoa untuk aku kepada Tuhan, supaya kepadaku jangan kiranya terjadi segala apa yang telah kamu katakan itu.\""
 },
 {
   "id": 27216,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 25,
   "firman": "Setelah keduanya bersaksi dan memberitakan firman Tuhan, kembalilah mereka ke Yerusalem dan dalam perjalanannya itu mereka memberitakan Injil dalam banyak kampung di Samaria."
 },
 {
   "id": 27217,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 26,
   "firman": "Kemudian berkatalah seorang malaikat Tuhan kepada Filipus, katanya: \"Bangunlah dan berangkatlah ke sebelah selatan, menurut jalan yang turun dari Yerusalem ke Gaza.\" Jalan itu jalan yang sunyi."
 },
 {
   "id": 27218,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 27,
   "firman": "Lalu berangkatlah Filipus. Adalah seorang Etiopia, seorang sida-sida, pembesar dan kepala perbendaharaan Sri Kandake, ratu negeri Etiopia, yang pergi ke Yerusalem untuk beribadah."
 },
 {
   "id": 27219,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 28,
   "firman": "Sekarang orang itu sedang dalam perjalanan pulang dan duduk dalam keretanya sambil membaca kitab nabi Yesaya."
 },
 {
   "id": 27220,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 29,
   "firman": "Lalu kata Roh kepada Filipus: \"Pergilah ke situ dan dekatilah kereta itu!\""
 },
 {
   "id": 27221,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 30,
   "firman": "Filipus segera ke situ dan mendengar sida-sida itu sedang membaca kitab nabi Yesaya. Kata Filipus: \"Mengertikah tuan apa yang tuan baca itu?\""
 },
 {
   "id": 27222,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 31,
   "firman": "Jawabnya: \"Bagaimanakah aku dapat mengerti, kalau tidak ada yang membimbing aku?\" Lalu ia meminta Filipus naik dan duduk di sampingnya."
 },
 {
   "id": 27223,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 32,
   "firman": "Nas yang dibacanya itu berbunyi seperti berikut: Seperti seekor domba Ia dibawa ke pembantaian; dan seperti anak domba yang kelu di depan orang yang menggunting bulunya, demikianlah Ia tidak membuka mulut-Nya."
 },
 {
   "id": 27224,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 33,
   "firman": "Dalam kehinaan-Nya berlangsunglah hukuman-Nya; siapakah yang akan menceriterakan asal-usul-Nya? Sebab nyawa-Nya diambil dari bumi."
 },
 {
   "id": 27225,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 34,
   "firman": "Maka kata sida-sida itu kepada Filipus: \"Aku bertanya kepadamu, tentang siapakah nabi berkata demikian? Tentang dirinya sendiri atau tentang orang lain?\""
 },
 {
   "id": 27226,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 35,
   "firman": "Maka mulailah Filipus berbicara dan bertolak dari nas itu ia memberitakan Injil Yesus kepadanya."
 },
 {
   "id": 27227,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 36,
   "firman": "Mereka melanjutkan perjalanan mereka, dan tiba di suatu tempat yang ada air. Lalu kata sida-sida itu: \"Lihat, di situ ada air; apakah halangannya, jika aku dibaptis?\""
 },
 {
   "id": 27228,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 37,
   "firman": "(Sahut Filipus: \"Jika tuan percaya dengan segenap hati, boleh.\" Jawabnya: \"Aku percaya, bahwa Yesus Kristus adalah Anak Allah.\")"
 },
 {
   "id": 27229,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 38,
   "firman": "Lalu orang Etiopia itu menyuruh menghentikan kereta itu, dan keduanya turun ke dalam air, baik Filipus maupun sida-sida itu, dan Filipus membaptis dia."
 },
 {
   "id": 27230,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 39,
   "firman": "Dan setelah mereka keluar dari air, Roh Tuhan tiba-tiba melarikan Filipus dan sida-sida itu tidak melihatnya lagi. Ia meneruskan perjalanannya dengan sukacita."
 },
 {
   "id": 27231,
   "kitab": "Kis",
   "pasal": 8,
   "ayat": 40,
   "firman": "Tetapi ternyata Filipus ada di Asdod. Ia berjalan melalui daerah itu dan memberitakan Injil di semua kota sampai ia tiba di Kaisarea."
 },
 {
   "id": 27232,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 1,
   "firman": "Sementara itu berkobar-kobar hati Saulus untuk mengancam dan membunuh murid-murid Tuhan. Ia menghadap Imam Besar,"
 },
 {
   "id": 27233,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 2,
   "firman": "dan meminta surat kuasa dari padanya untuk dibawa kepada majelis-majelis Yahudi di Damsyik, supaya, jika ia menemukan laki-laki atau perempuan yang mengikuti Jalan Tuhan, ia menangkap mereka dan membawa mereka ke Yerusalem."
 },
 {
   "id": 27234,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 3,
   "firman": "Dalam perjalanannya ke Damsyik, ketika ia sudah dekat kota itu, tiba-tiba cahaya memancar dari langit mengelilingi dia."
 },
 {
   "id": 27235,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 4,
   "firman": "Ia rebah ke tanah dan kedengaranlah olehnya suatu suara yang berkata kepadanya: \"Saulus, Saulus, mengapakah engkau menganiaya Aku?\""
 },
 {
   "id": 27236,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 5,
   "firman": "Jawab Saulus: \"Siapakah Engkau, Tuhan?\" Kata-Nya: \"Akulah Yesus yang kauaniaya itu."
 },
 {
   "id": 27237,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 6,
   "firman": "Tetapi bangunlah dan pergilah ke dalam kota, di sana akan dikatakan kepadamu, apa yang harus kauperbuat.\""
 },
 {
   "id": 27238,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 7,
   "firman": "Maka termangu-mangulah teman-temannya seperjalanan, karena mereka memang mendengar suara itu, tetapi tidak melihat seorang jugapun."
 },
 {
   "id": 27239,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 8,
   "firman": "Saulus bangun dan berdiri, lalu membuka matanya, tetapi ia tidak dapat melihat apa-apa; mereka harus menuntun dia masuk ke Damsyik."
 },
 {
   "id": 27240,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 9,
   "firman": "Tiga hari lamanya ia tidak dapat melihat dan tiga hari lamanya ia tidak makan dan minum."
 },
 {
   "id": 27241,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 10,
   "firman": "Di Damsyik ada seorang murid Tuhan bernama Ananias. Firman Tuhan kepadanya dalam suatu penglihatan: \"Ananias!\" Jawabnya: \"Ini aku, Tuhan!\""
 },
 {
   "id": 27242,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 11,
   "firman": "Firman Tuhan: \"Mari, pergilah ke jalan yang bernama Jalan Lurus, dan carilah di rumah Yudas seorang dari Tarsus yang bernama Saulus. Ia sekarang berdoa,"
 },
 {
   "id": 27243,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 12,
   "firman": "dan dalam suatu penglihatan ia melihat, bahwa seorang yang bernama Ananias masuk ke dalam dan menumpangkan tangannya ke atasnya, supaya ia dapat melihat lagi.\""
 },
 {
   "id": 27244,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 13,
   "firman": "Jawab Ananias: \"Tuhan, dari banyak orang telah kudengar tentang orang itu, betapa banyaknya kejahatan yang dilakukannya terhadap orang-orang kudus-Mu di Yerusalem."
 },
 {
   "id": 27245,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 14,
   "firman": "Dan ia datang ke mari dengan kuasa penuh dari imam-imam kepala untuk menangkap semua orang yang memanggil nama-Mu.\""
 },
 {
   "id": 27246,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 15,
   "firman": "Tetapi firman Tuhan kepadanya: \"Pergilah, sebab orang ini adalah alat pilihan bagi-Ku untuk memberitakan nama-Ku kepada bangsa-bangsa lain serta raja-raja dan orang-orang Israel."
 },
 {
   "id": 27247,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 16,
   "firman": "Aku sendiri akan menunjukkan kepadanya, betapa banyak penderitaan yang harus ia tanggung oleh karena nama-Ku.\""
 },
 {
   "id": 27248,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 17,
   "firman": "Lalu pergilah Ananias ke situ dan masuk ke rumah itu. Ia menumpangkan tangannya ke atas Saulus, katanya: \"Saulus, saudaraku, Tuhan Yesus, yang telah menampakkan diri kepadamu di jalan yang engkau lalui, telah menyuruh aku kepadamu, supaya engkau dapat melihat lagi dan penuh dengan Roh Kudus.\""
 },
 {
   "id": 27249,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 18,
   "firman": "Dan seketika itu juga seolah-olah selaput gugur dari matanya, sehingga ia dapat melihat lagi. Ia bangun lalu dibaptis."
 },
 {
   "id": 27250,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 19,
   "firman": "Dan setelah ia makan, pulihlah kekuatannya."
 },
 {
   "id": 27252,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 20,
   "firman": "Ketika itu juga ia memberitakan Yesus di rumah-rumah ibadat, dan mengatakan bahwa Yesus adalah Anak Allah."
 },
 {
   "id": 27253,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 21,
   "firman": "Semua orang yang mendengar hal itu heran dan berkata: \"Bukankah dia ini yang di Yerusalem mau membinasakan barangsiapa yang memanggil nama Yesus ini? Dan bukankah ia datang ke sini dengan maksud untuk menangkap dan membawa mereka ke hadapan imam-imam kepala?\""
 },
 {
   "id": 27254,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 22,
   "firman": "Akan tetapi Saulus semakin besar pengaruhnya dan ia membingungkan orang-orang Yahudi yang tinggal di Damsyik, karena ia membuktikan, bahwa Yesus adalah Mesias."
 },
 {
   "id": 27255,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 23,
   "firman": "Beberapa hari kemudian orang Yahudi merundingkan suatu rencana untuk membunuh Saulus."
 },
 {
   "id": 27256,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 24,
   "firman": "Tetapi maksud jahat itu diketahui oleh Saulus. Siang malam orang-orang Yahudi mengawal semua pintu gerbang kota, supaya dapat membunuh dia."
 },
 {
   "id": 27257,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 25,
   "firman": "Sungguhpun demikian pada suatu malam murid-muridnya mengambilnya dan menurunkannya dari atas tembok kota dalam sebuah keranjang."
 },
 {
   "id": 27258,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 26,
   "firman": "Setibanya di Yerusalem Saulus mencoba menggabungkan diri kepada murid-murid, tetapi semuanya takut kepadanya, karena mereka tidak dapat percaya, bahwa ia juga seorang murid."
 },
 {
   "id": 27259,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 27,
   "firman": "Tetapi Barnabas menerima dia dan membawanya kepada rasul-rasul dan menceriterakan kepada mereka, bagaimana Saulus melihat Tuhan di tengah jalan dan bahwa Tuhan berbicara dengan dia dan bagaimana keberaniannya mengajar di Damsyik dalam nama Yesus."
 },
 {
   "id": 27260,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 28,
   "firman": "Dan Saulus tetap bersama-sama dengan mereka di Yerusalem, dan dengan keberanian mengajar dalam nama Tuhan."
 },
 {
   "id": 27261,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 29,
   "firman": "Ia juga berbicara dan bersoal jawab dengan orang-orang Yahudi yang berbahasa Yunani, tetapi mereka itu berusaha membunuh dia."
 },
 {
   "id": 27262,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 30,
   "firman": "Akan tetapi setelah hal itu diketahui oleh saudara-saudara anggota jemaat, mereka membawa dia ke Kaisarea dan dari situ membantu dia ke Tarsus."
 },
 {
   "id": 27263,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 31,
   "firman": "Selama beberapa waktu jemaat di seluruh Yudea, Galilea dan Samaria berada dalam keadaan damai. Jemaat itu dibangun dan hidup dalam takut akan Tuhan. Jumlahnya makin bertambah besar oleh pertolongan dan penghiburan Roh Kudus."
 },
 {
   "id": 27264,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 32,
   "firman": "Pada waktu itu Petrus berjalan keliling, mengadakan kunjungan ke mana-mana. Dalam perjalanan itu ia singgah juga kepada orang-orang kudus yang di Lida."
 },
 {
   "id": 27265,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 33,
   "firman": "Di situ didapatinya seorang bernama Eneas, yang telah delapan tahun terbaring di tempat tidur karena lumpuh."
 },
 {
   "id": 27266,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 34,
   "firman": "Kata Petrus kepadanya: \"Eneas, Yesus Kristus menyembuhkan engkau; bangunlah dan bereskanlah tempat tidurmu!\" Seketika itu juga bangunlah orang itu."
 },
 {
   "id": 27267,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 35,
   "firman": "Semua penduduk Lida dan Saron melihat dia, lalu mereka berbalik kepada Tuhan."
 },
 {
   "id": 27268,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 36,
   "firman": "Di Yope ada seorang murid perempuan bernama Tabita--dalam bahasa Yunani Dorkas. Perempuan itu banyak sekali berbuat baik dan memberi sedekah."
 },
 {
   "id": 27269,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 37,
   "firman": "Tetapi pada waktu itu ia sakit lalu meninggal. Dan setelah dimandikan, mayatnya dibaringkan di ruang atas."
 },
 {
   "id": 27270,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 38,
   "firman": "Lida dekat dengan Yope. Ketika murid-murid mendengar, bahwa Petrus ada di Lida, mereka menyuruh dua orang kepadanya dengan permintaan: \"Segeralah datang ke tempat kami.\""
 },
 {
   "id": 27271,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 39,
   "firman": "Maka berkemaslah Petrus dan berangkat bersama-sama dengan mereka. Setelah sampai di sana, ia dibawa ke ruang atas dan semua janda datang berdiri dekatnya dan sambil menangis mereka menunjukkan kepadanya semua baju dan pakaian, yang dibuat Dorkas waktu ia masih hidup."
 },
 {
   "id": 27272,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 40,
   "firman": "Tetapi Petrus menyuruh mereka semua keluar, lalu ia berlutut dan berdoa. Kemudian ia berpaling ke mayat itu dan berkata: \"Tabita, bangkitlah!\" Lalu Tabita membuka matanya dan ketika melihat Petrus, ia bangun lalu duduk."
 },
 {
   "id": 27273,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 41,
   "firman": "Petrus memegang tangannya dan membantu dia berdiri. Kemudian ia memanggil orang-orang kudus beserta janda-janda, lalu menunjukkan kepada mereka, bahwa perempuan itu hidup."
 },
 {
   "id": 27274,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 42,
   "firman": "Peristiwa itu tersiar di seluruh Yope dan banyak orang menjadi percaya kepada Tuhan."
 },
 {
   "id": 27275,
   "kitab": "Kis",
   "pasal": 9,
   "ayat": 43,
   "firman": "Kemudian dari pada itu Petrus tinggal beberapa hari di Yope, di rumah seorang yang bernama Simon, seorang penyamak kulit."
 },
 {
   "id": 27276,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 1,
   "firman": "Di Kaisarea ada seorang yang bernama Kornelius, seorang perwira pasukan yang disebut pasukan Italia."
 },
 {
   "id": 27277,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 2,
   "firman": "Ia saleh, ia serta seisi rumahnya takut akan Allah dan ia memberi banyak sedekah kepada umat Yahudi dan senantiasa berdoa kepada Allah."
 },
 {
   "id": 27278,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 3,
   "firman": "Dalam suatu penglihatan, kira-kira jam tiga petang, jelas tampak kepadanya seorang malaikat Allah masuk ke rumahnya dan berkata kepadanya: \"Kornelius!\""
 },
 {
   "id": 27279,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 4,
   "firman": "Ia menatap malaikat itu dan dengan takut ia berkata: \"Ada apa, Tuhan?\" Jawab malaikat itu: \"Semua doamu dan sedekahmu telah naik ke hadirat Allah dan Allah mengingat engkau."
 },
 {
   "id": 27280,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 5,
   "firman": "Dan sekarang, suruhlah beberapa orang ke Yope untuk menjemput seorang yang bernama Simon dan yang disebut Petrus."
 },
 {
   "id": 27281,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 6,
   "firman": "Ia menumpang di rumah seorang penyamak kulit yang bernama Simon, yang tinggal di tepi laut.\""
 },
 {
   "id": 27282,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 7,
   "firman": "Setelah malaikat yang berbicara kepadanya itu meninggalkan dia, dipanggilnya dua orang hambanya beserta seorang prajurit yang saleh dari orang-orang yang selalu bersama-sama dengan dia."
 },
 {
   "id": 27283,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 8,
   "firman": "Dan sesudah ia menjelaskan segala sesuatu kepada mereka, ia menyuruh mereka ke Yope."
 },
 {
   "id": 27284,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 9,
   "firman": "Keesokan harinya ketika ketiga orang itu berada dalam perjalanan dan sudah dekat kota Yope, kira-kira pukul dua belas tengah hari, naiklah Petrus ke atas rumah untuk berdoa."
 },
 {
   "id": 27285,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 10,
   "firman": "Ia merasa lapar dan ingin makan, tetapi sementara makanan disediakan, tiba-tiba rohnya diliputi kuasa ilahi."
 },
 {
   "id": 27286,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 11,
   "firman": "Tampak olehnya langit terbuka dan turunlah suatu benda berbentuk kain lebar yang bergantung pada keempat sudutnya, yang diturunkan ke tanah."
 },
 {
   "id": 27287,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 12,
   "firman": "Di dalamnya terdapat pelbagai jenis binatang berkaki empat, binatang menjalar dan burung."
 },
 {
   "id": 27288,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 13,
   "firman": "Kedengaranlah olehnya suatu suara yang berkata: \"Bangunlah, hai Petrus, sembelihlah dan makanlah!\""
 },
 {
   "id": 27289,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 14,
   "firman": "Tetapi Petrus menjawab: \"Tidak, Tuhan, tidak, sebab aku belum pernah makan sesuatu yang haram dan yang tidak tahir.\""
 },
 {
   "id": 27290,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kedengaran pula untuk kedua kalinya suara yang berkata kepadanya: \"Apa yang dinyatakan halal oleh Allah, tidak boleh engkau nyatakan haram.\""
 },
 {
   "id": 27291,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 16,
   "firman": "Hal ini terjadi sampai tiga kali dan segera sesudah itu terangkatlah benda itu ke langit."
 },
 {
   "id": 27292,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 17,
   "firman": "Petrus bertanya-tanya di dalam hatinya, apa kiranya arti penglihatan yang telah dilihatnya itu. Sementara itu telah sampai di muka pintu orang-orang yang disuruh oleh Kornelius dan yang berusaha mengetahui di mana rumah Petrus."
 },
 {
   "id": 27293,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 18,
   "firman": "Mereka memanggil seorang dan bertanya, apakah Simon yang disebut Petrus ada menumpang di rumah itu."
 },
 {
   "id": 27294,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 19,
   "firman": "Dan ketika Petrus sedang berpikir tentang penglihatan itu, berkatalah Roh: \"Ada tiga orang mencari engkau."
 },
 {
   "id": 27295,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 20,
   "firman": "Bangunlah, turunlah ke bawah dan berangkatlah bersama-sama dengan mereka, jangan bimbang, sebab Aku yang menyuruh mereka ke mari.\""
 },
 {
   "id": 27296,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 21,
   "firman": "Lalu turunlah Petrus ke bawah dan berkata kepada orang-orang itu: \"Akulah yang kamu cari; apakah maksud kedatangan kamu?\""
 },
 {
   "id": 27297,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 22,
   "firman": "Jawab mereka: \"Kornelius, seorang perwira yang tulus hati dan takut akan Allah, dan yang terkenal baik di antara seluruh bangsa Yahudi, telah menerima penyataan Allah dengan perantaraan seorang malaikat kudus, supaya ia mengundang engkau ke rumahnya dan mendengar apa yang akan kaukatakan.\""
 },
 {
   "id": 27298,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 23,
   "firman": "Ia mempersilakan mereka untuk bermalam di situ. Keesokan harinya ia bangun dan berangkat bersama-sama dengan mereka, dan beberapa saudara dari Yope menyertai dia."
 },
 {
   "id": 27299,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 24,
   "firman": "Dan pada hari berikutnya sampailah mereka di Kaisarea. Kornelius sedang menantikan mereka dan ia telah memanggil sanak saudaranya dan sahabat-sahabatnya berkumpul."
 },
 {
   "id": 27300,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 25,
   "firman": "Ketika Petrus masuk, datanglah Kornelius menyambutnya, dan sambil tersungkur di depan kakinya, ia menyembah Petrus."
 },
 {
   "id": 27301,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 26,
   "firman": "Tetapi Petrus menegakkan dia, katanya: \"Bangunlah, aku hanya manusia saja.\""
 },
 {
   "id": 27302,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 27,
   "firman": "Dan sambil bercakap-cakap dengan dia, ia masuk dan mendapati banyak orang sedang berkumpul."
 },
 {
   "id": 27303,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 28,
   "firman": "Ia berkata kepada mereka: \"Kamu tahu, betapa kerasnya larangan bagi seorang Yahudi untuk bergaul dengan orang-orang yang bukan Yahudi atau masuk ke rumah mereka. Tetapi Allah telah menunjukkan kepadaku, bahwa aku tidak boleh menyebut orang najis atau tidak tahir."
 },
 {
   "id": 27304,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 29,
   "firman": "Itulah sebabnya aku tidak berkeberatan ketika aku dipanggil, lalu datang ke mari. Sekarang aku ingin tahu, apa sebabnya kamu memanggil aku.\""
 },
 {
   "id": 27305,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 30,
   "firman": "Jawab Kornelius: \"Empat hari yang lalu kira-kira pada waktu yang sama seperti sekarang, yaitu jam tiga petang, aku sedang berdoa di rumah. Tiba-tiba ada seorang berdiri di depanku, pakaiannya berkilau-kilauan"
 },
 {
   "id": 27306,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 31,
   "firman": "dan ia berkata: Kornelius, doamu telah didengarkan Allah dan sedekahmu telah diingatkan di hadapan-Nya."
 },
 {
   "id": 27307,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 32,
   "firman": "Suruhlah orang ke Yope untuk menjemput Simon yang disebut Petrus; ia sedang menumpang di rumah Simon, seorang penyamak kulit, yang tinggal di tepi laut."
 },
 {
   "id": 27308,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 33,
   "firman": "Karena itu segera kusuruh orang kepadamu, dan dengan senang hati engkau telah datang. Sekarang kami semua sudah hadir di sini di hadapan Allah untuk mendengarkan apa yang ditugaskan Allah kepadamu.\""
 },
 {
   "id": 27309,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 34,
   "firman": "Lalu mulailah Petrus berbicara, katanya: \"Sesungguhnya aku telah mengerti, bahwa Allah tidak membedakan orang."
 },
 {
   "id": 27310,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 35,
   "firman": "Setiap orang dari bangsa manapun yang takut akan Dia dan yang mengamalkan kebenaran berkenan kepada-Nya."
 },
 {
   "id": 27311,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 36,
   "firman": "Itulah firman yang Ia suruh sampaikan kepada orang-orang Israel, yaitu firman yang memberitakan damai sejahtera oleh Yesus Kristus, yang adalah Tuhan dari semua orang."
 },
 {
   "id": 27312,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 37,
   "firman": "Kamu tahu tentang segala sesuatu yang terjadi di seluruh tanah Yudea, mulai dari Galilea, sesudah baptisan yang diberitakan oleh Yohanes,"
 },
 {
   "id": 27313,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 38,
   "firman": "yaitu tentang Yesus dari Nazaret: bagaimana Allah mengurapi Dia dengan Roh Kudus dan kuat kuasa, Dia, yang berjalan berkeliling sambil berbuat baik dan menyembuhkan semua orang yang dikuasai Iblis, sebab Allah menyertai Dia."
 },
 {
   "id": 27314,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 39,
   "firman": "Dan kami adalah saksi dari segala sesuatu yang diperbuat-Nya di tanah Yudea maupun di Yerusalem; dan mereka telah membunuh Dia dan menggantung Dia pada kayu salib."
 },
 {
   "id": 27315,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 40,
   "firman": "Yesus itu telah dibangkitkan Allah pada hari yang ketiga, dan Allah berkenan, bahwa Ia menampakkan diri,"
 },
 {
   "id": 27316,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 41,
   "firman": "bukan kepada seluruh bangsa, tetapi kepada saksi-saksi, yang sebelumnya telah ditunjuk oleh Allah, yaitu kepada kami yang telah makan dan minum bersama-sama dengan Dia, setelah Ia bangkit dari antara orang mati."
 },
 {
   "id": 27317,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 42,
   "firman": "Dan Ia telah menugaskan kami memberitakan kepada seluruh bangsa dan bersaksi, bahwa Dialah yang ditentukan Allah menjadi Hakim atas orang-orang hidup dan orang-orang mati."
 },
 {
   "id": 27318,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 43,
   "firman": "Tentang Dialah semua nabi bersaksi, bahwa barangsiapa percaya kepada-Nya, ia akan mendapat pengampunan dosa oleh karena nama-Nya.\""
 },
 {
   "id": 27319,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 44,
   "firman": "Ketika Petrus sedang berkata demikian, turunlah Roh Kudus ke atas semua orang yang mendengarkan pemberitaan itu."
 },
 {
   "id": 27320,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 45,
   "firman": "Dan semua orang percaya dari golongan bersunat yang menyertai Petrus, tercengang-cengang, karena melihat, bahwa karunia Roh Kudus dicurahkan ke atas bangsa-bangsa lain juga,"
 },
 {
   "id": 27321,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 46,
   "firman": "sebab mereka mendengar orang-orang itu berkata-kata dalam bahasa roh dan memuliakan Allah. Lalu kata Petrus:"
 },
 {
   "id": 27322,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 47,
   "firman": "\"Bolehkah orang mencegah untuk membaptis orang-orang ini dengan air, sedangkan mereka telah menerima Roh Kudus sama seperti kita?\""
 },
 {
   "id": 27323,
   "kitab": "Kis",
   "pasal": 10,
   "ayat": 48,
   "firman": "Lalu ia menyuruh mereka dibaptis dalam nama Yesus Kristus. Kemudian mereka meminta Petrus, supaya ia tinggal beberapa hari lagi bersama-sama dengan mereka."
 },
 {
   "id": 27324,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 1,
   "firman": "Rasul-rasul dan saudara-saudara di Yudea mendengar, bahwa bangsa-bangsa lain juga menerima firman Allah."
 },
 {
   "id": 27325,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 2,
   "firman": "Ketika Petrus tiba di Yerusalem, orang-orang dari golongan yang bersunat berselisih pendapat dengan dia."
 },
 {
   "id": 27326,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 3,
   "firman": "Kata mereka: \"Engkau telah masuk ke rumah orang-orang yang tidak bersunat dan makan bersama-sama dengan mereka.\""
 },
 {
   "id": 27327,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tetapi Petrus menjelaskan segala sesuatu berturut-turut, katanya:"
 },
 {
   "id": 27328,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 5,
   "firman": "\"Aku sedang berdoa di kota Yope, tiba-tiba rohku diliputi kuasa ilahi dan aku melihat suatu penglihatan: suatu benda berbentuk kain lebar yang bergantung pada keempat sudutnya diturunkan dari langit sampai di depanku."
 },
 {
   "id": 27329,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 6,
   "firman": "Aku menatapnya dan di dalamnya aku lihat segala jenis binatang berkaki empat dan binatang liar dan binatang menjalar dan burung-burung."
 },
 {
   "id": 27330,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 7,
   "firman": "Lalu aku mendengar suara berkata kepadaku: Bangunlah, hai Petrus, sembelihlah dan makanlah!"
 },
 {
   "id": 27331,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 8,
   "firman": "Tetapi aku berkata: Tidak, Tuhan, tidak, sebab belum pernah sesuatu yang haram dan yang tidak tahir masuk ke dalam mulutku."
 },
 {
   "id": 27332,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 9,
   "firman": "Akan tetapi untuk kedua kalinya suara dari sorga berkata kepadaku: Apa yang dinyatakan halal oleh Allah, tidak boleh engkau nyatakan haram!"
 },
 {
   "id": 27333,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 10,
   "firman": "Hal itu terjadi sampai tiga kali, lalu semuanya ditarik kembali ke langit."
 },
 {
   "id": 27334,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 11,
   "firman": "Dan seketika itu juga tiga orang berdiri di depan rumah, di mana kami menumpang; mereka diutus kepadaku dari Kaisarea."
 },
 {
   "id": 27335,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 12,
   "firman": "Lalu kata Roh kepadaku: Pergi bersama mereka dengan tidak bimbang! Dan keenam saudara ini menyertai aku. Kami masuk ke dalam rumah orang itu,"
 },
 {
   "id": 27336,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 13,
   "firman": "dan ia menceriterakan kepada kami, bagaimana ia melihat seorang malaikat berdiri di dalam rumahnya dan berkata kepadanya: Suruhlah orang ke Yope untuk menjemput Simon yang disebut Petrus."
 },
 {
   "id": 27337,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 14,
   "firman": "Ia akan menyampaikan suatu berita kepada kamu, yang akan mendatangkan keselamatan bagimu dan bagi seluruh isi rumahmu."
 },
 {
   "id": 27338,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 15,
   "firman": "Dan ketika aku mulai berbicara, turunlah Roh Kudus ke atas mereka, sama seperti dahulu ke atas kita."
 },
 {
   "id": 27339,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 16,
   "firman": "Maka teringatlah aku akan perkataan Tuhan: Yohanes membaptis dengan air, tetapi kamu akan dibaptis dengan Roh Kudus."
 },
 {
   "id": 27340,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 17,
   "firman": "Jadi jika Allah memberikan karunia-Nya kepada mereka sama seperti kepada kita pada waktu kita mulai percaya kepada Yesus Kristus, bagaimanakah mungkin aku mencegah Dia?\""
 },
 {
   "id": 27341,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 18,
   "firman": "Ketika mereka mendengar hal itu, mereka menjadi tenang, lalu memuliakan Allah, katanya: \"Jadi kepada bangsa-bangsa lain juga Allah mengaruniakan pertobatan yang memimpin kepada hidup.\""
 },
 {
   "id": 27342,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 19,
   "firman": "Sementara itu banyak saudara-saudara telah tersebar karena penganiayaan yang timbul sesudah Stefanus dihukum mati. Mereka tersebar sampai ke Fenisia, Siprus dan Antiokhia; namun mereka memberitakan Injil kepada orang Yahudi saja."
 },
 {
   "id": 27343,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 20,
   "firman": "Akan tetapi di antara mereka ada beberapa orang Siprus dan orang Kirene yang tiba di Antiokhia dan berkata-kata juga kepada orang-orang Yunani dan memberitakan Injil, bahwa Yesus adalah Tuhan."
 },
 {
   "id": 27344,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 21,
   "firman": "Dan tangan Tuhan menyertai mereka dan sejumlah besar orang menjadi percaya dan berbalik kepada Tuhan."
 },
 {
   "id": 27345,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 22,
   "firman": "Maka sampailah kabar tentang mereka itu kepada jemaat di Yerusalem, lalu jemaat itu mengutus Barnabas ke Antiokhia."
 },
 {
   "id": 27346,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 23,
   "firman": "Setelah Barnabas datang dan melihat kasih karunia Allah, bersukacitalah ia. Ia menasihati mereka, supaya mereka semua tetap setia kepada Tuhan,"
 },
 {
   "id": 27347,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 24,
   "firman": "karena Barnabas adalah orang baik, penuh dengan Roh Kudus dan iman. Sejumlah orang dibawa kepada Tuhan."
 },
 {
   "id": 27348,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 25,
   "firman": "Lalu pergilah Barnabas ke Tarsus untuk mencari Saulus; dan setelah bertemu dengan dia, ia membawanya ke Antiokhia."
 },
 {
   "id": 27349,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 26,
   "firman": "Mereka tinggal bersama-sama dengan jemaat itu satu tahun lamanya, sambil mengajar banyak orang. Di Antiokhialah murid-murid itu untuk pertama kalinya disebut Kristen."
 },
 {
   "id": 27350,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 27,
   "firman": "Pada waktu itu datanglah beberapa nabi dari Yerusalem ke Antiokhia."
 },
 {
   "id": 27351,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 28,
   "firman": "Seorang dari mereka yang bernama Agabus bangkit dan oleh kuasa Roh ia mengatakan, bahwa seluruh dunia akan ditimpa bahaya kelaparan yang besar. Hal itu terjadi juga pada zaman Klaudius."
 },
 {
   "id": 27352,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 29,
   "firman": "Lalu murid-murid memutuskan untuk mengumpulkan suatu sumbangan, sesuai dengan kemampuan mereka masing-masing dan mengirimkannya kepada saudara-saudara yang diam di Yudea."
 },
 {
   "id": 27353,
   "kitab": "Kis",
   "pasal": 11,
   "ayat": 30,
   "firman": "Hal itu mereka lakukan juga dan mereka mengirimkannya kepada penatua-penatua dengan perantaraan Barnabas dan Saulus."
 },
 {
   "id": 27354,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 1,
   "firman": "Kira-kira pada waktu itu raja Herodes mulai bertindak dengan keras terhadap beberapa orang dari jemaat."
 },
 {
   "id": 27355,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 2,
   "firman": "Ia menyuruh membunuh Yakobus, saudara Yohanes, dengan pedang."
 },
 {
   "id": 27356,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 3,
   "firman": "Ketika ia melihat, bahwa hal itu menyenangkan hati orang Yahudi, ia melanjutkan perbuatannya itu dan menyuruh menahan Petrus. Waktu itu hari raya Roti Tidak Beragi."
 },
 {
   "id": 27357,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 4,
   "firman": "Setelah Petrus ditangkap, Herodes menyuruh memenjarakannya di bawah penjagaan empat regu, masing-masing terdiri dari empat prajurit. Maksudnya ialah, supaya sehabis Paskah ia menghadapkannya ke depan orang banyak."
 },
 {
   "id": 27358,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 5,
   "firman": "Demikianlah Petrus ditahan di dalam penjara. Tetapi jemaat dengan tekun mendoakannya kepada Allah."
 },
 {
   "id": 27359,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 6,
   "firman": "Pada malam sebelum Herodes hendak menghadapkannya kepada orang banyak, Petrus tidur di antara dua orang prajurit, terbelenggu dengan dua rantai. Selain itu prajurit-prajurit pengawal sedang berkawal di muka pintu."
 },
 {
   "id": 27360,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 7,
   "firman": "Tiba-tiba berdirilah seorang malaikat Tuhan dekat Petrus dan cahaya bersinar dalam ruang itu. Malaikat itu menepuk Petrus untuk membangunkannya, katanya: \"Bangunlah segera!\" Maka gugurlah rantai itu dari tangan Petrus."
 },
 {
   "id": 27361,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 8,
   "firman": "Lalu kata malaikat itu kepadanya: \"Ikatlah pinggangmu dan kenakanlah sepatumu!\" Iapun berbuat demikian. Lalu malaikat itu berkata kepadanya: \"Kenakanlah jubahmu dan ikutlah aku!\""
 },
 {
   "id": 27362,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 9,
   "firman": "Lalu ia mengikuti malaikat itu ke luar dan ia tidak tahu, bahwa apa yang dilakukan malaikat itu sungguh-sungguh terjadi, sangkanya ia melihat suatu penglihatan."
 },
 {
   "id": 27363,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 10,
   "firman": "Setelah mereka melalui tempat kawal pertama dan tempat kawal kedua, sampailah mereka ke pintu gerbang besi yang menuju ke kota. Pintu itu terbuka dengan sendirinya bagi mereka. Sesudah tiba di luar, mereka berjalan sampai ke ujung jalan, dan tiba-tiba malaikat itu meninggalkan dia."
 },
 {
   "id": 27364,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 11,
   "firman": "Dan setelah sadar akan dirinya, Petrus berkata: \"Sekarang tahulah aku benar-benar bahwa Tuhan telah menyuruh malaikat-Nya dan menyelamatkan aku dari tangan Herodes dan dari segala sesuatu yang diharapkan orang Yahudi.\""
 },
 {
   "id": 27365,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 12,
   "firman": "Dan setelah berpikir sebentar, pergilah ia ke rumah Maria, ibu Yohanes yang disebut juga Markus. Di situ banyak orang berkumpul dan berdoa."
 },
 {
   "id": 27366,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 13,
   "firman": "Dan ketika ia mengetuk pintu gerbang, datanglah seorang hamba perempuan bernama Rode untuk mengetahui siapa yang mengetuk itu."
 },
 {
   "id": 27367,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 14,
   "firman": "Ia terus mengenal suara Petrus, tetapi karena girangnya ia tidak membuka pintu gerbang itu dan segera masuk ke dalam untuk memberitahukan, bahwa Petrus ada di depan pintu gerbang."
 },
 {
   "id": 27368,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 15,
   "firman": "Kata mereka kepada perempuan itu: \"Engkau mengigau.\" Akan tetapi ia tetap mengatakan, bahwa benar-benar demikian. Kata mereka: \"Itu malaikatnya.\""
 },
 {
   "id": 27369,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 16,
   "firman": "Tetapi Petrus terus-menerus mengetuk dan ketika mereka membuka pintu dan melihat dia, mereka tercengang-cengang."
 },
 {
   "id": 27370,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 17,
   "firman": "Tetapi Petrus memberi isyarat dengan tangannya, supaya mereka diam, lalu ia menceriterakan bagaimana Tuhan menuntunnya ke luar dari penjara. Katanya: \"Beritahukanlah hal ini kepada Yakobus dan saudara-saudara kita.\" Lalu ia keluar dan pergi ke tempat lain."
 },
 {
   "id": 27371,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 18,
   "firman": "Pada keesokan harinya gemparlah prajurit-prajurit itu. Mereka bertanya-tanya apakah yang telah terjadi dengan Petrus."
 },
 {
   "id": 27372,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 19,
   "firman": "Herodes menyuruh mencari Petrus, tetapi ia tidak ditemukan. Lalu Herodes menyuruh memeriksa pengawal-pengawal itu dan membunuh mereka. Kemudian ia berangkat dari Yudea ke Kaisarea dan tinggal di situ."
 },
 {
   "id": 27373,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 20,
   "firman": "Herodes sangat marah terhadap orang Tirus dan Sidon. Atas persetujuan bersama mereka pergi menghadap dia. Mereka berhasil membujuk Blastus, pegawai istana raja, ke pihak mereka, lalu mereka memohonkan perdamaian, karena negeri mereka beroleh bahan makanan dari wilayah raja."
 },
 {
   "id": 27374,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 21,
   "firman": "Dan pada suatu hari yang ditentukan, Herodes mengenakan pakaian kerajaan, lalu duduk di atas takhta dan berpidato kepada mereka."
 },
 {
   "id": 27375,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 22,
   "firman": "Dan rakyatnya bersorak membalasnya: \"Ini suara allah dan bukan suara manusia!\""
 },
 {
   "id": 27376,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 23,
   "firman": "Dan seketika itu juga ia ditampar malaikat Tuhan karena ia tidak memberi hormat kepada Allah; ia mati dimakan cacing-cacing."
 },
 {
   "id": 27377,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 24,
   "firman": "Maka firman Tuhan makin tersebar dan makin banyak didengar orang."
 },
 {
   "id": 27378,
   "kitab": "Kis",
   "pasal": 12,
   "ayat": 25,
   "firman": "Barnabas dan Saulus kembali dari Yerusalem, setelah mereka menyelesaikan tugas pelayanan mereka. Mereka membawa Yohanes, yang disebut juga Markus."
 },
 {
   "id": 27379,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 1,
   "firman": "Pada waktu itu dalam jemaat di Antiokhia ada beberapa nabi dan pengajar, yaitu: Barnabas dan Simeon yang disebut Niger, dan Lukius orang Kirene, dan Menahem yang diasuh bersama dengan raja wilayah Herodes, dan Saulus."
 },
 {
   "id": 27380,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 2,
   "firman": "Pada suatu hari ketika mereka beribadah kepada Tuhan dan berpuasa, berkatalah Roh Kudus: \"Khususkanlah Barnabas dan Saulus bagi-Ku untuk tugas yang telah Kutentukan bagi mereka.\""
 },
 {
   "id": 27381,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 3,
   "firman": "Maka berpuasa dan berdoalah mereka, dan setelah meletakkan tangan ke atas kedua orang itu, mereka membiarkan keduanya pergi."
 },
 {
   "id": 27382,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 4,
   "firman": "Oleh karena disuruh Roh Kudus, Barnabas dan Saulus berangkat ke Seleukia, dan dari situ mereka berlayar ke Siprus."
 },
 {
   "id": 27383,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 5,
   "firman": "Setiba di Salamis mereka memberitakan firman Allah di dalam rumah-rumah ibadat orang Yahudi. Dan Yohanes menyertai mereka sebagai pembantu mereka."
 },
 {
   "id": 27384,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 6,
   "firman": "Mereka mengelilingi seluruh pulau itu sampai ke Pafos. Di situ mereka bertemu dengan seorang Yahudi bernama Baryesus. Ia seorang tukang sihir dan nabi palsu."
 },
 {
   "id": 27385,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 7,
   "firman": "Ia adalah kawan gubernur pulau itu, Sergius Paulus, yang adalah orang cerdas. Gubernur itu memanggil Barnabas dan Saulus, karena ia ingin mendengar firman Allah."
 },
 {
   "id": 27386,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 8,
   "firman": "Tetapi Elimas--demikianlah namanya dalam bahasa Yunani--,tukang sihir itu, menghalang-halangi mereka dan berusaha membelokkan gubernur itu dari imannya."
 },
 {
   "id": 27387,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 9,
   "firman": "Tetapi Saulus, juga disebut Paulus, yang penuh dengan Roh Kudus, menatap dia,"
 },
 {
   "id": 27388,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 10,
   "firman": "dan berkata: \"Hai anak Iblis, engkau penuh dengan rupa-rupa tipu muslihat dan kejahatan, engkau musuh segala kebenaran, tidakkah engkau akan berhenti membelokkan Jalan Tuhan yang lurus itu?"
 },
 {
   "id": 27389,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 11,
   "firman": "Sekarang, lihatlah, tangan Tuhan datang menimpa engkau, dan engkau menjadi buta, beberapa hari lamanya engkau tidak dapat melihat matahari.\" Dan seketika itu juga orang itu merasa diliputi kabut dan gelap, dan sambil meraba-raba ia harus mencari orang untuk menuntun dia."
 },
 {
   "id": 27390,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 12,
   "firman": "Melihat apa yang telah terjadi itu, percayalah gubernur itu; ia takjub oleh ajaran Tuhan."
 },
 {
   "id": 27391,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 13,
   "firman": "Lalu Paulus dan kawan-kawannya meninggalkan Pafos dan berlayar ke Perga di Pamfilia; tetapi Yohanes meninggalkan mereka lalu kembali ke Yerusalem."
 },
 {
   "id": 27392,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 14,
   "firman": "Dari Perga mereka melanjutkan perjalanan mereka, lalu tiba di Antiokhia di Pisidia. Pada hari Sabat mereka pergi ke rumah ibadat, lalu duduk di situ."
 },
 {
   "id": 27393,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 15,
   "firman": "Setelah selesai pembacaan dari hukum Taurat dan kitab nabi-nabi, pejabat-pejabat rumah ibadat menyuruh bertanya kepada mereka: \"Saudara-saudara, jikalau saudara-saudara ada pesan untuk membangun dan menghibur umat ini, silakanlah!\""
 },
 {
   "id": 27394,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 16,
   "firman": "Maka bangkitlah Paulus. Ia memberi isyarat dengan tangannya, lalu berkata: \"Hai orang-orang Israel dan kamu yang takut akan Allah, dengarkanlah!"
 },
 {
   "id": 27395,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 17,
   "firman": "Allah umat Israel ini telah memilih nenek moyang kita dan membuat umat itu menjadi besar, ketika mereka tinggal di Mesir sebagai orang asing. Dengan tangan-Nya yang luhur Ia telah memimpin mereka keluar dari negeri itu."
 },
 {
   "id": 27396,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 18,
   "firman": "Empat puluh tahun lamanya Ia sabar terhadap tingkah laku mereka di padang gurun."
 },
 {
   "id": 27397,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 19,
   "firman": "Dan setelah membinasakan tujuh bangsa di tanah Kanaan, Ia membagi-bagikan tanah itu kepada mereka untuk menjadi warisan mereka"
 },
 {
   "id": 27398,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 20,
   "firman": "selama kira-kira empat ratus lima puluh tahun. Sesudah itu Ia memberikan mereka hakim-hakim sampai pada zaman nabi Samuel."
 },
 {
   "id": 27399,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 21,
   "firman": "Kemudian mereka meminta seorang raja dan Allah memberikan kepada mereka Saul bin Kish dari suku Benyamin, empat puluh tahun lamanya."
 },
 {
   "id": 27400,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 22,
   "firman": "Setelah Saul disingkirkan, Allah mengangkat Daud menjadi raja mereka. Tentang Daud Allah telah menyatakan: Aku telah mendapat Daud bin Isai, seorang yang berkenan di hati-Ku dan yang melakukan segala kehendak-Ku."
 },
 {
   "id": 27401,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 23,
   "firman": "Dan dari keturunannyalah, sesuai dengan yang telah dijanjikan-Nya, Allah telah membangkitkan Juruselamat bagi orang Israel, yaitu Yesus."
 },
 {
   "id": 27402,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 24,
   "firman": "Menjelang kedatangan-Nya Yohanes telah menyerukan kepada seluruh bangsa Israel supaya mereka bertobat dan memberi diri dibaptis."
 },
 {
   "id": 27403,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 25,
   "firman": "Dan ketika Yohanes hampir selesai menunaikan tugasnya, ia berkata: Aku bukanlah Dia yang kamu sangka, tetapi Ia akan datang kemudian dari padaku. Membuka kasut dari kaki-Nyapun aku tidak layak."
 },
 {
   "id": 27404,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 26,
   "firman": "Hai saudara-saudaraku, baik yang termasuk keturunan Abraham, maupun yang takut akan Allah, kabar keselamatan itu sudah disampaikan kepada kita."
 },
 {
   "id": 27405,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 27,
   "firman": "Sebab penduduk Yerusalem dan pemimpin-pemimpinnya tidak mengakui Yesus. Dengan menjatuhkan hukuman mati atas Dia, mereka menggenapi perkataan nabi-nabi yang dibacakan setiap hari Sabat."
 },
 {
   "id": 27406,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 28,
   "firman": "Dan meskipun mereka tidak menemukan sesuatu yang dapat menjadi alasan untuk hukuman mati itu, namun mereka telah meminta kepada Pilatus supaya Ia dibunuh."
 },
 {
   "id": 27407,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 29,
   "firman": "Dan setelah mereka menggenapi segala sesuatu yang ada tertulis tentang Dia, mereka menurunkan Dia dari kayu salib, lalu membaringkan-Nya di dalam kubur."
 },
 {
   "id": 27408,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 30,
   "firman": "Tetapi Allah membangkitkan Dia dari antara orang mati."
 },
 {
   "id": 27409,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 31,
   "firman": "Dan selama beberapa waktu Ia menampakkan diri kepada mereka yang mengikuti Dia dari Galilea ke Yerusalem. Mereka itulah yang sekarang menjadi saksi-Nya bagi umat ini."
 },
 {
   "id": 27410,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 32,
   "firman": "Dan kami sekarang memberitakan kabar kesukaan kepada kamu, yaitu bahwa janji yang diberikan kepada nenek moyang kita,"
 },
 {
   "id": 27411,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 33,
   "firman": "telah digenapi Allah kepada kita, keturunan mereka, dengan membangkitkan Yesus, seperti yang ada tertulis dalam mazmur kedua: Anak-Ku Engkau! Aku telah memperanakkan Engkau pada hari ini."
 },
 {
   "id": 27412,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 34,
   "firman": "Allah telah membangkitkan Dia dari antara orang mati dan Ia tidak akan diserahkan kembali kepada kebinasaan. Hal itu dinyatakan oleh Tuhan dalam firman ini: Aku akan menggenapi kepadamu janji-janji yang kudus yang dapat dipercayai, yang telah Kuberikan kepada Daud."
 },
 {
   "id": 27413,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 35,
   "firman": "Sebab itu Ia mengatakan dalam mazmur yang lain: Engkau tidak akan membiarkan Orang Kudus-Mu melihat kebinasaan."
 },
 {
   "id": 27414,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 36,
   "firman": "Sebab Daud melakukan kehendak Allah pada zamannya, lalu ia mangkat dan dibaringkan di samping nenek moyangnya, dan ia memang diserahkan kepada kebinasaan."
 },
 {
   "id": 27415,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 37,
   "firman": "Tetapi Yesus, yang dibangkitkan Allah, tidak demikian."
 },
 {
   "id": 27416,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 38,
   "firman": "Jadi ketahuilah, hai saudara-saudara, oleh karena Dialah maka diberitakan kepada kamu pengampunan dosa."
 },
 {
   "id": 27417,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 39,
   "firman": "Dan di dalam Dialah setiap orang yang percaya memperoleh pembebasan dari segala dosa, yang tidak dapat kamu peroleh dari hukum Musa."
 },
 {
   "id": 27418,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 40,
   "firman": "Karena itu, waspadalah, supaya jangan berlaku atas kamu apa yang telah dikatakan dalam kitab nabi-nabi:"
 },
 {
   "id": 27419,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 41,
   "firman": "Ingatlah, hai kamu penghina-penghina, tercenganglah dan lenyaplah, sebab Aku melakukan suatu pekerjaan dalam zamanmu, suatu pekerjaan, yang tidak akan kamu percayai, jika diceriterakan kepadamu.\""
 },
 {
   "id": 27420,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 42,
   "firman": "Ketika Paulus dan Barnabas keluar, mereka diminta untuk berbicara tentang pokok itu pula pada hari Sabat berikutnya."
 },
 {
   "id": 27421,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 43,
   "firman": "Setelah selesai ibadah, banyak orang Yahudi dan penganut-penganut agama Yahudi yang takut akan Allah, mengikuti Paulus dan Barnabas; kedua rasul itu mengajar mereka dan menasihati supaya mereka tetap hidup di dalam kasih karunia Allah."
 },
 {
   "id": 27422,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 44,
   "firman": "Pada hari Sabat berikutnya datanglah hampir seluruh kota itu berkumpul untuk mendengar firman Allah."
 },
 {
   "id": 27423,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 45,
   "firman": "Akan tetapi, ketika orang Yahudi melihat orang banyak itu, penuhlah mereka dengan iri hati dan sambil menghujat, mereka membantah apa yang dikatakan oleh Paulus."
 },
 {
   "id": 27424,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 46,
   "firman": "Tetapi dengan berani Paulus dan Barnabas berkata: \"Memang kepada kamulah firman Allah harus diberitakan lebih dahulu, tetapi kamu menolaknya dan menganggap dirimu tidak layak untuk beroleh hidup yang kekal. Karena itu kami berpaling kepada bangsa-bangsa lain."
 },
 {
   "id": 27425,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 47,
   "firman": "Sebab inilah yang diperintahkan kepada kami: Aku telah menentukan engkau menjadi terang bagi bangsa-bangsa yang tidak mengenal Allah, supaya engkau membawa keselamatan sampai ke ujung bumi.\""
 },
 {
   "id": 27426,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 48,
   "firman": "Mendengar itu bergembiralah semua orang yang tidak mengenal Allah dan mereka memuliakan firman Tuhan; dan semua orang yang ditentukan Allah untuk hidup yang kekal, menjadi percaya."
 },
 {
   "id": 27427,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 49,
   "firman": "Lalu firman Tuhan disiarkan di seluruh daerah itu."
 },
 {
   "id": 27428,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 50,
   "firman": "Orang-orang Yahudi menghasut perempuan-perempuan terkemuka yang takut akan Allah, dan pembesar-pembesar di kota itu, dan mereka menimbulkan penganiayaan atas Paulus dan Barnabas dan mengusir mereka dari daerah itu."
 },
 {
   "id": 27429,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 51,
   "firman": "Akan tetapi Paulus dan Barnabas mengebaskan debu kaki mereka sebagai peringatan bagi orang-orang itu, lalu pergi ke Ikonium."
 },
 {
   "id": 27430,
   "kitab": "Kis",
   "pasal": 13,
   "ayat": 52,
   "firman": "Dan murid-murid di Antiokhia penuh dengan sukacita dan dengan Roh Kudus."
 },
 {
   "id": 27431,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 1,
   "firman": "Di Ikoniumpun kedua rasul itu masuk ke rumah ibadat orang Yahudi, lalu mengajar sedemikian rupa, sehingga sejumlah besar orang Yahudi dan orang Yunani menjadi percaya."
 },
 {
   "id": 27432,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 2,
   "firman": "Tetapi orang-orang Yahudi, yang menolak pemberitaan mereka, memanaskan hati orang-orang yang tidak mengenal Allah dan membuat mereka gusar terhadap saudara-saudara itu."
 },
 {
   "id": 27433,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 3,
   "firman": "Paulus dan Barnabas tinggal beberapa waktu lamanya di situ. Mereka mengajar dengan berani, karena mereka percaya kepada Tuhan. Dan Tuhan menguatkan berita tentang kasih karunia-Nya dengan mengaruniakan kepada mereka kuasa untuk mengadakan tanda-tanda dan mujizat-mujizat."
 },
 {
   "id": 27434,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 4,
   "firman": "Tetapi orang banyak di kota itu terbelah menjadi dua: ada yang memihak kepada orang Yahudi, ada pula yang memihak kepada kedua rasul itu."
 },
 {
   "id": 27435,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 5,
   "firman": "Maka mulailah orang-orang yang tidak mengenal Allah dan orang-orang Yahudi bersama-sama dengan pemimpin-pemimpin mereka menimbulkan suatu gerakan untuk menyiksa dan melempari kedua rasul itu dengan batu."
 },
 {
   "id": 27436,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 6,
   "firman": "Setelah rasul-rasul itu mengetahuinya, menyingkirlah mereka ke kota-kota di Likaonia, yaitu Listra dan Derbe dan daerah sekitarnya."
 },
 {
   "id": 27437,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 7,
   "firman": "Di situ mereka memberitakan Injil."
 },
 {
   "id": 27438,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 8,
   "firman": "Di Listra ada seorang yang duduk saja, karena lemah kakinya dan lumpuh sejak ia dilahirkan dan belum pernah dapat berjalan."
 },
 {
   "id": 27439,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 9,
   "firman": "Ia duduk mendengarkan, ketika Paulus berbicara. Dan Paulus menatap dia dan melihat, bahwa ia beriman dan dapat disembuhkan."
 },
 {
   "id": 27440,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 10,
   "firman": "Lalu kata Paulus dengan suara nyaring: \"Berdirilah tegak di atas kakimu!\" Dan orang itu melonjak berdiri, lalu berjalan kian ke mari."
 },
 {
   "id": 27441,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 11,
   "firman": "Ketika orang banyak melihat apa yang telah diperbuat Paulus, mereka itu berseru dalam bahasa Likaonia: \"Dewa-dewa telah turun ke tengah-tengah kita dalam rupa manusia.\""
 },
 {
   "id": 27442,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 12,
   "firman": "Barnabas mereka sebut Zeus dan Paulus mereka sebut Hermes, karena ia yang berbicara."
 },
 {
   "id": 27443,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 13,
   "firman": "Maka datanglah imam dewa Zeus, yang kuilnya terletak di luar kota, membawa lembu-lembu jantan dan karangan-karangan bunga ke pintu gerbang kota untuk mempersembahkan korban bersama-sama dengan orang banyak kepada rasul-rasul itu."
 },
 {
   "id": 27444,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 14,
   "firman": "Mendengar itu Barnabas dan Paulus mengoyakkan pakaian mereka, lalu terjun ke tengah-tengah orang banyak itu sambil berseru:"
 },
 {
   "id": 27445,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 15,
   "firman": "\"Hai kamu sekalian, mengapa kamu berbuat demikian? Kami ini adalah manusia biasa sama seperti kamu. Kami ada di sini untuk memberitakan Injil kepada kamu, supaya kamu meninggalkan perbuatan sia-sia ini dan berbalik kepada Allah yang hidup, yang telah menjadikan langit dan bumi, laut dan segala isinya."
 },
 {
   "id": 27446,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dalam zaman yang lampau Allah membiarkan semua bangsa menuruti jalannya masing-masing,"
 },
 {
   "id": 27447,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 17,
   "firman": "namun Ia bukan tidak menyatakan diri-Nya dengan berbagai-bagai kebajikan, yaitu dengan menurunkan hujan dari langit dan dengan memberikan musim-musim subur bagi kamu. Ia memuaskan hatimu dengan makanan dan kegembiraan.\""
 },
 {
   "id": 27448,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 18,
   "firman": "Walaupun rasul-rasul itu berkata demikian, namun hampir-hampir tidak dapat mereka mencegah orang banyak mempersembahkan korban kepada mereka."
 },
 {
   "id": 27449,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 19,
   "firman": "Tetapi datanglah orang-orang Yahudi dari Antiokhia dan Ikonium dan mereka membujuk orang banyak itu memihak mereka. Lalu mereka melempari Paulus dengan batu dan menyeretnya ke luar kota, karena mereka menyangka, bahwa ia telah mati."
 },
 {
   "id": 27450,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 20,
   "firman": "Akan tetapi ketika murid-murid itu berdiri mengelilingi dia, bangkitlah ia lalu masuk ke dalam kota. Keesokan harinya berangkatlah ia bersama-sama dengan Barnabas ke Derbe."
 },
 {
   "id": 27451,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 21,
   "firman": "Paulus dan Barnabas memberitakan Injil di kota itu dan memperoleh banyak murid. Lalu kembalilah mereka ke Listra, Ikonium dan Antiokhia."
 },
 {
   "id": 27452,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 22,
   "firman": "Di tempat itu mereka menguatkan hati murid-murid itu dan menasihati mereka supaya mereka bertekun di dalam iman, dan mengatakan, bahwa untuk masuk ke dalam Kerajaan Allah kita harus mengalami banyak sengsara."
 },
 {
   "id": 27453,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 23,
   "firman": "Di tiap-tiap jemaat rasul-rasul itu menetapkan penatua-penatua bagi jemaat itu dan setelah berdoa dan berpuasa, mereka menyerahkan penatua-penatua itu kepada Tuhan, yang adalah sumber kepercayaan mereka."
 },
 {
   "id": 27454,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 24,
   "firman": "Mereka menjelajah seluruh Pisidia dan tiba di Pamfilia."
 },
 {
   "id": 27455,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 25,
   "firman": "Di situ mereka memberitakan firman di Perga, lalu pergi ke Atalia, di pantai."
 },
 {
   "id": 27456,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 26,
   "firman": "Dari situ berlayarlah mereka ke Antiokhia; di tempat itulah mereka dahulu diserahkan kepada kasih karunia Allah untuk memulai pekerjaan, yang telah mereka selesaikan."
 },
 {
   "id": 27457,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 27,
   "firman": "Setibanya di situ mereka memanggil jemaat berkumpul, lalu mereka menceriterakan segala sesuatu yang Allah lakukan dengan perantaraan mereka, dan bahwa Ia telah membuka pintu bagi bangsa-bangsa lain kepada iman."
 },
 {
   "id": 27458,
   "kitab": "Kis",
   "pasal": 14,
   "ayat": 28,
   "firman": "Di situ mereka lama tinggal bersama-sama dengan murid-murid itu."
 },
 {
   "id": 27459,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 1,
   "firman": "Beberapa orang datang dari Yudea ke Antiokhia dan mengajarkan kepada saudara-saudara di situ: \"Jikalau kamu tidak disunat menurut adat istiadat yang diwariskan oleh Musa, kamu tidak dapat diselamatkan.\""
 },
 {
   "id": 27460,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 2,
   "firman": "Tetapi Paulus dan Barnabas dengan keras melawan dan membantah pendapat mereka itu. Akhirnya ditetapkan, supaya Paulus dan Barnabas serta beberapa orang lain dari jemaat itu pergi kepada rasul-rasul dan penatua-penatua di Yerusalem untuk membicarakan soal itu."
 },
 {
   "id": 27461,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 3,
   "firman": "Mereka diantarkan oleh jemaat sampai ke luar kota, lalu mereka berjalan melalui Fenisia dan Samaria, dan di tempat-tempat itu mereka menceriterakan tentang pertobatan orang-orang yang tidak mengenal Allah. Hal itu sangat menggembirakan hati saudara-saudara di situ."
 },
 {
   "id": 27462,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 4,
   "firman": "Setibanya di Yerusalem mereka disambut oleh jemaat dan oleh rasul-rasul dan penatua-penatua, lalu mereka menceriterakan segala sesuatu yang Allah lakukan dengan perantaraan mereka."
 },
 {
   "id": 27463,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 5,
   "firman": "Tetapi beberapa orang dari golongan Farisi, yang telah menjadi percaya, datang dan berkata: \"Orang-orang bukan Yahudi harus disunat dan diwajibkan untuk menuruti hukum Musa.\""
 },
 {
   "id": 27464,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 6,
   "firman": "Maka bersidanglah rasul-rasul dan penatua-penatua untuk membicarakan soal itu."
 },
 {
   "id": 27465,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 7,
   "firman": "Sesudah beberapa waktu lamanya berlangsung pertukaran pikiran mengenai soal itu, berdirilah Petrus dan berkata kepada mereka: \"Hai saudara-saudara, kamu tahu, bahwa telah sejak semula Allah memilih aku dari antara kamu, supaya dengan perantaraan mulutku bangsa-bangsa lain mendengar berita Injil dan menjadi percaya."
 },
 {
   "id": 27466,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dan Allah, yang mengenal hati manusia, telah menyatakan kehendak-Nya untuk menerima mereka, sebab Ia mengaruniakan Roh Kudus juga kepada mereka sama seperti kepada kita,"
 },
 {
   "id": 27467,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 9,
   "firman": "dan Ia sama sekali tidak mengadakan perbedaan antara kita dengan mereka, sesudah Ia menyucikan hati mereka oleh iman."
 },
 {
   "id": 27468,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 10,
   "firman": "Kalau demikian, mengapa kamu mau mencobai Allah dengan meletakkan pada tengkuk murid-murid itu suatu kuk, yang tidak dapat dipikul, baik oleh nenek moyang kita maupun oleh kita sendiri?"
 },
 {
   "id": 27469,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 11,
   "firman": "Sebaliknya, kita percaya, bahwa oleh kasih karunia Tuhan Yesus Kristus kita akan beroleh keselamatan sama seperti mereka juga.\""
 },
 {
   "id": 27470,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 12,
   "firman": "Maka diamlah seluruh umat itu, lalu mereka mendengarkan Paulus dan Barnabas menceriterakan segala tanda dan mujizat yang dilakukan Allah dengan perantaraan mereka di tengah-tengah bangsa-bangsa lain."
 },
 {
   "id": 27471,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 13,
   "firman": "Setelah Paulus dan Barnabas selesai berbicara, berkatalah Yakobus: \"Hai saudara-saudara, dengarkanlah aku:"
 },
 {
   "id": 27472,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 14,
   "firman": "Simon telah menceriterakan, bahwa sejak semula Allah menunjukkan rahmat-Nya kepada bangsa-bangsa lain, yaitu dengan memilih suatu umat dari antara mereka bagi nama-Nya."
 },
 {
   "id": 27473,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 15,
   "firman": "Hal itu sesuai dengan ucapan-ucapan para nabi seperti yang tertulis:"
 },
 {
   "id": 27474,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 16,
   "firman": "Kemudian Aku akan kembali dan membangunkan kembali pondok Daud yang telah roboh, dan reruntuhannya akan Kubangun kembali dan akan Kuteguhkan,"
 },
 {
   "id": 27475,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 17,
   "firman": "supaya semua orang lain mencari Tuhan dan segala bangsa yang tidak mengenal Allah, yang Kusebut milik-Ku demikianlah firman Tuhan yang melakukan semuanya ini,"
 },
 {
   "id": 27476,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 18,
   "firman": "yang telah diketahui dari sejak semula."
 },
 {
   "id": 27477,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 19,
   "firman": "Sebab itu aku berpendapat, bahwa kita tidak boleh menimbulkan kesulitan bagi mereka dari bangsa-bangsa lain yang berbalik kepada Allah,"
 },
 {
   "id": 27478,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 20,
   "firman": "tetapi kita harus menulis surat kepada mereka, supaya mereka menjauhkan diri dari makanan yang telah dicemarkan berhala-berhala, dari percabulan, dari daging binatang yang mati dicekik dan dari darah."
 },
 {
   "id": 27479,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 21,
   "firman": "Sebab sejak zaman dahulu hukum Musa diberitakan di tiap-tiap kota, dan sampai sekarang hukum itu dibacakan tiap-tiap hari Sabat di rumah-rumah ibadat.\""
 },
 {
   "id": 27480,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 22,
   "firman": "Maka rasul-rasul dan penatua-penatua beserta seluruh jemaat itu mengambil keputusan untuk memilih dari antara mereka beberapa orang yang akan diutus ke Antiokhia bersama-sama dengan Paulus dan Barnabas, yaitu Yudas yang disebut Barsabas dan Silas. Keduanya adalah orang terpandang di antara saudara-saudara itu."
 },
 {
   "id": 27481,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 23,
   "firman": "Kepada mereka diserahkan surat yang bunyinya: \"Salam dari rasul-rasul dan penatua-penatua, dari saudara-saudaramu kepada saudara-saudara di Antiokhia, Siria dan Kilikia yang berasal dari bangsa-bangsa lain."
 },
 {
   "id": 27482,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 24,
   "firman": "Kami telah mendengar, bahwa ada beberapa orang di antara kami, yang tiada mendapat pesan dari kami, telah menggelisahkan dan menggoyangkan hatimu dengan ajaran mereka."
 },
 {
   "id": 27483,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 25,
   "firman": "Sebab itu dengan bulat hati kami telah memutuskan untuk memilih dan mengutus beberapa orang kepada kamu bersama-sama dengan Barnabas dan Paulus yang kami kasihi,"
 },
 {
   "id": 27484,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 26,
   "firman": "yaitu dua orang yang telah mempertaruhkan nyawanya karena nama Tuhan kita Yesus Kristus."
 },
 {
   "id": 27485,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 27,
   "firman": "Maka kami telah mengutus Yudas dan Silas, yang dengan lisan akan menyampaikan pesan yang tertulis ini juga kepada kamu."
 },
 {
   "id": 27486,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 28,
   "firman": "Sebab adalah keputusan Roh Kudus dan keputusan kami, supaya kepada kamu jangan ditanggungkan lebih banyak beban dari pada yang perlu ini:"
 },
 {
   "id": 27487,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 29,
   "firman": "kamu harus menjauhkan diri dari makanan yang dipersembahkan kepada berhala, dari darah, dari daging binatang yang mati dicekik dan dari percabulan. Jikalau kamu memelihara diri dari hal-hal ini, kamu berbuat baik. Sekianlah, selamat.\""
 },
 {
   "id": 27488,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 30,
   "firman": "Setelah berpamitan, Yudas dan Silas berangkat ke Antiokhia. Di situ mereka memanggil seluruh jemaat berkumpul, lalu menyerahkan surat itu kepada mereka."
 },
 {
   "id": 27489,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 31,
   "firman": "Setelah membaca surat itu, jemaat bersukacita karena isinya yang menghiburkan."
 },
 {
   "id": 27490,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 32,
   "firman": "Yudas dan Silas, yang adalah juga nabi, lama menasihati saudara-saudara itu dan menguatkan hati mereka."
 },
 {
   "id": 27491,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 33,
   "firman": "Dan sesudah beberapa waktu keduanya tinggal di situ, saudara-saudara itu melepas mereka dalam damai untuk kembali kepada mereka yang mengutusnya."
 },
 {
   "id": 27492,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 34,
   "firman": "(Tetapi Silas memutuskan untuk tinggal di situ.)"
 },
 {
   "id": 27493,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 35,
   "firman": "Paulus dan Barnabas tinggal beberapa lama di Antiokhia. Mereka bersama-sama dengan banyak orang lain mengajar dan memberitakan firman Tuhan."
 },
 {
   "id": 27494,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 36,
   "firman": "Tetapi beberapa waktu kemudian berkatalah Paulus kepada Barnabas: \"Baiklah kita kembali kepada saudara-saudara kita di setiap kota, di mana kita telah memberitakan firman Tuhan, untuk melihat, bagaimana keadaan mereka.\""
 },
 {
   "id": 27495,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 37,
   "firman": "Barnabas ingin membawa juga Yohanes yang disebut Markus;"
 },
 {
   "id": 27496,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 38,
   "firman": "tetapi Paulus dengan tegas berkata, bahwa tidak baik membawa serta orang yang telah meninggalkan mereka di Pamfilia dan tidak mau turut bekerja bersama-sama dengan mereka."
 },
 {
   "id": 27497,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 39,
   "firman": "Hal itu menimbulkan perselisihan yang tajam, sehingga mereka berpisah dan Barnabas membawa Markus juga sertanya berlayar ke Siprus."
 },
 {
   "id": 27498,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 40,
   "firman": "Tetapi Paulus memilih Silas, dan sesudah diserahkan oleh saudara-saudara itu kepada kasih karunia Tuhan"
 },
 {
   "id": 27499,
   "kitab": "Kis",
   "pasal": 15,
   "ayat": 41,
   "firman": "berangkatlah ia mengelilingi Siria dan Kilikia sambil meneguhkan jemaat-jemaat di situ."
 },
 {
   "id": 27500,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 1,
   "firman": "Paulus datang juga ke Derbe dan ke Listra. Di situ ada seorang murid bernama Timotius; ibunya adalah seorang Yahudi dan telah menjadi percaya, sedangkan ayahnya seorang Yunani."
 },
 {
   "id": 27501,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 2,
   "firman": "Timotius ini dikenal baik oleh saudara-saudara di Listra dan di Ikonium,"
 },
 {
   "id": 27502,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 3,
   "firman": "dan Paulus mau, supaya dia menyertainya dalam perjalanan. Paulus menyuruh menyunatkan dia karena orang-orang Yahudi di daerah itu, sebab setiap orang tahu bahwa bapanya adalah orang Yunani."
 },
 {
   "id": 27503,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 4,
   "firman": "Dalam perjalanan keliling dari kota ke kota Paulus dan Silas menyampaikan keputusan-keputusan yang diambil para rasul dan para penatua di Yerusalem dengan pesan, supaya jemaat-jemaat menurutinya."
 },
 {
   "id": 27504,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 5,
   "firman": "Demikianlah jemaat-jemaat diteguhkan dalam iman dan makin lama makin bertambah besar jumlahnya."
 },
 {
   "id": 27505,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 6,
   "firman": "Mereka melintasi tanah Frigia dan tanah Galatia, karena Roh Kudus mencegah mereka untuk memberitakan Injil di Asia."
 },
 {
   "id": 27506,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 7,
   "firman": "Dan setibanya di Misia mereka mencoba masuk ke daerah Bitinia, tetapi Roh Yesus tidak mengizinkan mereka."
 },
 {
   "id": 27507,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 8,
   "firman": "Setelah melintasi Misia, mereka sampai di Troas."
 },
 {
   "id": 27508,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 9,
   "firman": "Pada malam harinya tampaklah oleh Paulus suatu penglihatan: ada seorang Makedonia berdiri di situ dan berseru kepadanya, katanya: \"Menyeberanglah ke mari dan tolonglah kami!\""
 },
 {
   "id": 27509,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 10,
   "firman": "Setelah Paulus melihat penglihatan itu, segeralah kami mencari kesempatan untuk berangkat ke Makedonia, karena dari penglihatan itu kami menarik kesimpulan, bahwa Allah telah memanggil kami untuk memberitakan Injil kepada orang-orang di sana."
 },
 {
   "id": 27510,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 11,
   "firman": "Lalu kami bertolak dari Troas dan langsung berlayar ke Samotrake, dan keesokan harinya tibalah kami di Neapolis;"
 },
 {
   "id": 27511,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 12,
   "firman": "dari situ kami ke Filipi, kota pertama di bagian Makedonia ini, suatu kota perantauan orang Roma. Di kota itu kami tinggal beberapa hari."
 },
 {
   "id": 27512,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 13,
   "firman": "Pada hari Sabat kami ke luar pintu gerbang kota. Kami menyusur tepi sungai dan menemukan tempat sembahyang Yahudi, yang sudah kami duga ada di situ; setelah duduk, kami berbicara kepada perempuan-perempuan yang ada berkumpul di situ."
 },
 {
   "id": 27513,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 14,
   "firman": "Seorang dari perempuan-perempuan itu yang bernama Lidia turut mendengarkan. Ia seorang penjual kain ungu dari kota Tiatira, yang beribadah kepada Allah. Tuhan membuka hatinya, sehingga ia memperhatikan apa yang dikatakan oleh Paulus."
 },
 {
   "id": 27514,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 15,
   "firman": "Sesudah ia dibaptis bersama-sama dengan seisi rumahnya, ia mengajak kami, katanya: \"Jika kamu berpendapat, bahwa aku sungguh-sungguh percaya kepada Tuhan, marilah menumpang di rumahku.\" Ia mendesak sampai kami menerimanya."
 },
 {
   "id": 27515,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 16,
   "firman": "Pada suatu kali ketika kami pergi ke tempat sembahyang itu, kami bertemu dengan seorang hamba perempuan yang mempunyai roh tenung; dengan tenungan-tenungannya tuan-tuannya memperoleh penghasilan besar."
 },
 {
   "id": 27516,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 17,
   "firman": "Ia mengikuti Paulus dan kami dari belakang sambil berseru, katanya: \"Orang-orang ini adalah hamba Allah Yang Mahatinggi. Mereka memberitakan kepadamu jalan kepada keselamatan.\""
 },
 {
   "id": 27517,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 18,
   "firman": "Hal itu dilakukannya beberapa hari lamanya. Tetapi ketika Paulus tidak tahan lagi akan gangguan itu, ia berpaling dan berkata kepada roh itu: \"Demi nama Yesus Kristus aku menyuruh engkau keluar dari perempuan ini.\" Seketika itu juga keluarlah roh itu."
 },
 {
   "id": 27518,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 19,
   "firman": "Ketika tuan-tuan perempuan itu melihat, bahwa harapan mereka akan mendapat penghasilan lenyap, mereka menangkap Paulus dan Silas, lalu menyeret mereka ke pasar untuk menghadap penguasa."
 },
 {
   "id": 27519,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 20,
   "firman": "Setelah mereka membawa keduanya menghadap pembesar-pembesar kota itu, berkatalah mereka, katanya: \"Orang-orang ini mengacau kota kita ini, karena mereka orang Yahudi,"
 },
 {
   "id": 27520,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 21,
   "firman": "dan mereka mengajarkan adat istiadat, yang kita sebagai orang Rum tidak boleh menerimanya atau menurutinya.\""
 },
 {
   "id": 27521,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 22,
   "firman": "Juga orang banyak bangkit menentang mereka. Lalu pembesar-pembesar kota itu menyuruh mengoyakkan pakaian dari tubuh mereka dan mendera mereka."
 },
 {
   "id": 27522,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 23,
   "firman": "Setelah mereka berkali-kali didera, mereka dilemparkan ke dalam penjara. Kepala penjara diperintahkan untuk menjaga mereka dengan sungguh-sungguh."
 },
 {
   "id": 27523,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 24,
   "firman": "Sesuai dengan perintah itu, kepala penjara memasukkan mereka ke ruang penjara yang paling tengah dan membelenggu kaki mereka dalam pasungan yang kuat."
 },
 {
   "id": 27524,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 25,
   "firman": "Tetapi kira-kira tengah malam Paulus dan Silas berdoa dan menyanyikan puji-pujian kepada Allah dan orang-orang hukuman lain mendengarkan mereka."
 },
 {
   "id": 27525,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 26,
   "firman": "Akan tetapi terjadilah gempa bumi yang hebat, sehingga sendi-sendi penjara itu goyah; dan seketika itu juga terbukalah semua pintu dan terlepaslah belenggu mereka semua."
 },
 {
   "id": 27526,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 27,
   "firman": "Ketika kepala penjara itu terjaga dari tidurnya dan melihat pintu-pintu penjara terbuka, ia menghunus pedangnya hendak membunuh diri, karena ia menyangka, bahwa orang-orang hukuman itu telah melarikan diri."
 },
 {
   "id": 27527,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 28,
   "firman": "Tetapi Paulus berseru dengan suara nyaring, katanya: \"Jangan celakakan dirimu, sebab kami semuanya masih ada di sini!\""
 },
 {
   "id": 27528,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 29,
   "firman": "Kepala penjara itu menyuruh membawa suluh, lalu berlari masuk dan dengan gemetar tersungkurlah ia di depan Paulus dan Silas."
 },
 {
   "id": 27529,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 30,
   "firman": "Ia mengantar mereka ke luar, sambil berkata: \"Tuan-tuan, apakah yang harus aku perbuat, supaya aku selamat?\""
 },
 {
   "id": 27530,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 31,
   "firman": "Jawab mereka: \"Percayalah kepada Tuhan Yesus Kristus dan engkau akan selamat, engkau dan seisi rumahmu.\""
 },
 {
   "id": 27531,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 32,
   "firman": "Lalu mereka memberitakan firman Tuhan kepadanya dan kepada semua orang yang ada di rumahnya."
 },
 {
   "id": 27532,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 33,
   "firman": "Pada jam itu juga kepala penjara itu membawa mereka dan membasuh bilur mereka. Seketika itu juga ia dan keluarganya memberi diri dibaptis."
 },
 {
   "id": 27533,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 34,
   "firman": "Lalu ia membawa mereka ke rumahnya dan menghidangkan makanan kepada mereka. Dan ia sangat bergembira, bahwa ia dan seisi rumahnya telah menjadi percaya kepada Allah."
 },
 {
   "id": 27534,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 35,
   "firman": "Setelah hari siang pembesar-pembesar kota menyuruh pejabat-pejabat kota pergi kepada kepala penjara dengan pesan: \"Lepaskanlah kedua orang itu!\""
 },
 {
   "id": 27535,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 36,
   "firman": "Kepala penjara meneruskan pesan itu kepada Paulus, katanya: \"Pembesar-pembesar kota telah menyuruh melepaskan kamu; jadi keluarlah kamu sekarang dan pergilah dengan selamat!\""
 },
 {
   "id": 27536,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 37,
   "firman": "Tetapi Paulus berkata kepada orang-orang itu: \"Tanpa diadili mereka telah mendera kami, warganegara-warganegara Roma, di muka umum, lalu melemparkan kami ke dalam penjara. Sekarang mereka mau mengeluarkan kami dengan diam-diam? Tidak mungkin demikian! Biarlah mereka datang sendiri dan membawa kami ke luar.\""
 },
 {
   "id": 27537,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 38,
   "firman": "Pejabat-pejabat itu menyampaikan perkataan itu kepada pembesar-pembesar kota. Ketika mereka mendengar, bahwa Paulus dan Silas adalah orang Rum, maka takutlah mereka."
 },
 {
   "id": 27538,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 39,
   "firman": "Mereka datang minta maaf lalu membawa kedua rasul itu ke luar dan memohon, supaya mereka meninggalkan kota itu."
 },
 {
   "id": 27539,
   "kitab": "Kis",
   "pasal": 16,
   "ayat": 40,
   "firman": "Lalu mereka meninggalkan penjara itu dan pergi ke rumah Lidia; dan setelah bertemu dengan saudara-saudara di situ dan menghiburkan mereka, berangkatlah kedua rasul itu."
 },
 {
   "id": 27540,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 1,
   "firman": "Paulus dan Silas mengambil jalan melalui Amfipolis dan Apolonia dan tiba di Tesalonika. Di situ ada sebuah rumah ibadat orang Yahudi."
 },
 {
   "id": 27541,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 2,
   "firman": "Seperti biasa Paulus masuk ke rumah ibadat itu. Tiga hari Sabat berturut-turut ia membicarakan dengan mereka bagian-bagian dari Kitab Suci."
 },
 {
   "id": 27542,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 3,
   "firman": "Ia menerangkannya kepada mereka dan menunjukkan, bahwa Mesias harus menderita dan bangkit dari antara orang mati, lalu ia berkata: \"Inilah Mesias, yaitu Yesus, yang kuberitakan kepadamu.\""
 },
 {
   "id": 27543,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 4,
   "firman": "Beberapa orang dari mereka menjadi yakin dan menggabungkan diri dengan Paulus dan Silas dan juga sejumlah besar orang Yunani yang takut kepada Allah, dan tidak sedikit perempuan-perempuan terkemuka."
 },
 {
   "id": 27544,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 5,
   "firman": "Tetapi orang-orang Yahudi menjadi iri hati dan dengan dibantu oleh beberapa penjahat dari antara petualang-petualang di pasar, mereka mengadakan keributan dan mengacau kota itu. Mereka menyerbu rumah Yason dengan maksud untuk menghadapkan Paulus dan Silas kepada sidang rakyat."
 },
 {
   "id": 27545,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 6,
   "firman": "Tetapi ketika mereka tidak menemukan keduanya, mereka menyeret Yason dan beberapa saudara ke hadapan pembesar-pembesar kota, sambil berteriak, katanya: \"Orang-orang yang mengacaukan seluruh dunia telah datang juga ke mari,"
 },
 {
   "id": 27546,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 7,
   "firman": "dan Yason menerima mereka menumpang di rumahnya. Mereka semua bertindak melawan ketetapan-ketetapan Kaisar dengan mengatakan, bahwa ada seorang raja lain, yaitu Yesus.\""
 },
 {
   "id": 27547,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 8,
   "firman": "Ketika orang banyak dan pembesar-pembesar kota mendengar semuanya itu, mereka menjadi gelisah."
 },
 {
   "id": 27548,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 9,
   "firman": "Tetapi setelah mereka mendapat jaminan dari Yason dan dari saudara-saudara lain, merekapun dilepaskan."
 },
 {
   "id": 27549,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 10,
   "firman": "Tetapi pada malam itu juga segera saudara-saudara di situ menyuruh Paulus dan Silas berangkat ke Berea. Setibanya di situ pergilah mereka ke rumah ibadat orang Yahudi."
 },
 {
   "id": 27550,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 11,
   "firman": "Orang-orang Yahudi di kota itu lebih baik hatinya dari pada orang-orang Yahudi di Tesalonika, karena mereka menerima firman itu dengan segala kerelaan hati dan setiap hari mereka menyelidiki Kitab Suci untuk mengetahui, apakah semuanya itu benar demikian."
 },
 {
   "id": 27551,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 12,
   "firman": "Banyak di antara mereka yang menjadi percaya; juga tidak sedikit di antara perempuan-perempuan terkemuka dan laki-laki Yunani."
 },
 {
   "id": 27552,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 13,
   "firman": "Tetapi ketika orang-orang Yahudi dari Tesalonika tahu, bahwa juga di Berea telah diberitakan firman Allah oleh Paulus, datang jugalah mereka ke sana menghasut dan menggelisahkan hati orang banyak."
 },
 {
   "id": 27553,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 14,
   "firman": "Tetapi saudara-saudara menyuruh Paulus segera berangkat menuju ke pantai laut, tetapi Silas dan Timotius masih tinggal di Berea."
 },
 {
   "id": 27554,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 15,
   "firman": "Orang-orang yang mengiringi Paulus menemaninya sampai di Atena, lalu kembali dengan pesan kepada Silas dan Timotius, supaya mereka selekas mungkin datang kepadanya."
 },
 {
   "id": 27555,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 16,
   "firman": "Sementara Paulus menantikan mereka di Atena, sangat sedih hatinya karena ia melihat, bahwa kota itu penuh dengan patung-patung berhala."
 },
 {
   "id": 27556,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 17,
   "firman": "Karena itu di rumah ibadat ia bertukar pikiran dengan orang-orang Yahudi dan orang-orang yang takut akan Allah, dan di pasar setiap hari dengan orang-orang yang dijumpainya di situ."
 },
 {
   "id": 27557,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 18,
   "firman": "Dan juga beberapa ahli pikir dari golongan Epikuros dan Stoa bersoal jawab dengan dia dan ada yang berkata: \"Apakah yang hendak dikatakan si peleter ini?\" Tetapi yang lain berkata: \"Rupa-rupanya ia adalah pemberita ajaran dewa-dewa asing.\" Sebab ia memberitakan Injil tentang Yesus dan tentang kebangkitan-Nya."
 },
 {
   "id": 27558,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 19,
   "firman": "Lalu mereka membawanya menghadap sidang Areopagus dan mengatakan: \"Bolehkah kami tahu ajaran baru mana yang kauajarkan ini?"
 },
 {
   "id": 27559,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 20,
   "firman": "Sebab engkau memperdengarkan kepada kami perkara-perkara yang aneh. Karena itu kami ingin tahu, apakah artinya semua itu.\""
 },
 {
   "id": 27560,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 21,
   "firman": "Adapun orang-orang Atena dan orang-orang asing yang tinggal di situ tidak mempunyai waktu untuk sesuatu selain untuk mengatakan atau mendengar segala sesuatu yang baru."
 },
 {
   "id": 27561,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 22,
   "firman": "Paulus pergi berdiri di atas Areopagus dan berkata: \"Hai orang-orang Atena, aku lihat, bahwa dalam segala hal kamu sangat beribadah kepada dewa-dewa."
 },
 {
   "id": 27562,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 23,
   "firman": "Sebab ketika aku berjalan-jalan di kotamu dan melihat-lihat barang-barang pujaanmu, aku menjumpai juga sebuah mezbah dengan tulisan: Kepada Allah yang tidak dikenal. Apa yang kamu sembah tanpa mengenalnya, itulah yang kuberitakan kepada kamu."
 },
 {
   "id": 27563,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 24,
   "firman": "Allah yang telah menjadikan bumi dan segala isinya, Ia, yang adalah Tuhan atas langit dan bumi, tidak diam dalam kuil-kuil buatan tangan manusia,"
 },
 {
   "id": 27564,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 25,
   "firman": "dan juga tidak dilayani oleh tangan manusia, seolah-olah Ia kekurangan apa-apa, karena Dialah yang memberikan hidup dan nafas dan segala sesuatu kepada semua orang."
 },
 {
   "id": 27565,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 26,
   "firman": "Dari satu orang saja Ia telah menjadikan semua bangsa dan umat manusia untuk mendiami seluruh muka bumi dan Ia telah menentukan musim-musim bagi mereka dan batas-batas kediaman mereka,"
 },
 {
   "id": 27566,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 27,
   "firman": "supaya mereka mencari Dia dan mudah-mudahan menjamah dan menemukan Dia, walaupun Ia tidak jauh dari kita masing-masing."
 },
 {
   "id": 27567,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 28,
   "firman": "Sebab di dalam Dia kita hidup, kita bergerak, kita ada, seperti yang telah juga dikatakan oleh pujangga-pujanggamu: Sebab kita ini dari keturunan Allah juga."
 },
 {
   "id": 27568,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 29,
   "firman": "Karena kita berasal dari keturunan Allah, kita tidak boleh berpikir, bahwa keadaan ilahi sama seperti emas atau perak atau batu, ciptaan kesenian dan keahlian manusia."
 },
 {
   "id": 27569,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 30,
   "firman": "Dengan tidak memandang lagi zaman kebodohan, maka sekarang Allah memberitakan kepada manusia, bahwa di mana-mana semua mereka harus bertobat."
 },
 {
   "id": 27570,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 31,
   "firman": "Karena Ia telah menetapkan suatu hari, pada waktu mana Ia dengan adil akan menghakimi dunia oleh seorang yang telah ditentukan-Nya, sesudah Ia memberikan kepada semua orang suatu bukti tentang hal itu dengan membangkitkan Dia dari antara orang mati.\""
 },
 {
   "id": 27571,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 32,
   "firman": "Ketika mereka mendengar tentang kebangkitan orang mati, maka ada yang mengejek, dan yang lain berkata: \"Lain kali saja kami mendengar engkau berbicara tentang hal itu.\""
 },
 {
   "id": 27572,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 33,
   "firman": "Lalu Paulus pergi meninggalkan mereka."
 },
 {
   "id": 27573,
   "kitab": "Kis",
   "pasal": 17,
   "ayat": 34,
   "firman": "Tetapi beberapa orang laki-laki menggabungkan diri dengan dia dan menjadi percaya, di antaranya juga Dionisius, anggota majelis Areopagus, dan seorang perempuan bernama Damaris, dan juga orang-orang lain bersama-sama dengan mereka."
 },
 {
   "id": 27574,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 1,
   "firman": "Kemudian Paulus meninggalkan Atena, lalu pergi ke Korintus."
 },
 {
   "id": 27575,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 2,
   "firman": "Di Korintus ia berjumpa dengan seorang Yahudi bernama Akwila, yang berasal dari Pontus. Ia baru datang dari Italia dengan Priskila, isterinya, karena kaisar Klaudius telah memerintahkan, supaya semua orang Yahudi meninggalkan Roma. Paulus singgah ke rumah mereka."
 },
 {
   "id": 27576,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 3,
   "firman": "Dan karena mereka melakukan pekerjaan yang sama, ia tinggal bersama-sama dengan mereka. Mereka bekerja bersama-sama, karena mereka sama-sama tukang kemah."
 },
 {
   "id": 27577,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 4,
   "firman": "Dan setiap hari Sabat Paulus berbicara dalam rumah ibadat dan berusaha meyakinkan orang-orang Yahudi dan orang-orang Yunani."
 },
 {
   "id": 27578,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 5,
   "firman": "Ketika Silas dan Timotius datang dari Makedonia, Paulus dengan sepenuhnya dapat memberitakan firman, di mana ia memberi kesaksian kepada orang-orang Yahudi, bahwa Yesus adalah Mesias."
 },
 {
   "id": 27579,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 6,
   "firman": "Tetapi ketika orang-orang itu memusuhi dia dan menghujat, ia mengebaskan debu dari pakaiannya dan berkata kepada mereka: \"Biarlah darahmu tertumpah ke atas kepalamu sendiri; aku bersih, tidak bersalah. Mulai dari sekarang aku akan pergi kepada bangsa-bangsa lain.\""
 },
 {
   "id": 27580,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 7,
   "firman": "Maka keluarlah ia dari situ, lalu datang ke rumah seorang bernama Titius Yustus, yang beribadah kepada Allah, dan yang rumahnya berdampingan dengan rumah ibadat."
 },
 {
   "id": 27581,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 8,
   "firman": "Tetapi Krispus, kepala rumah ibadat itu, menjadi percaya kepada Tuhan bersama-sama dengan seisi rumahnya, dan banyak dari orang-orang Korintus, yang mendengarkan pemberitaan Paulus, menjadi percaya dan memberi diri mereka dibaptis."
 },
 {
   "id": 27582,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 9,
   "firman": "Pada suatu malam berfirmanlah Tuhan kepada Paulus di dalam suatu penglihatan: \"Jangan takut! Teruslah memberitakan firman dan jangan diam!"
 },
 {
   "id": 27583,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 10,
   "firman": "Sebab Aku menyertai engkau dan tidak ada seorangpun yang akan menjamah dan menganiaya engkau, sebab banyak umat-Ku di kota ini.\""
 },
 {
   "id": 27584,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 11,
   "firman": "Maka tinggallah Paulus di situ selama satu tahun enam bulan dan ia mengajarkan firman Allah di tengah-tengah mereka."
 },
 {
   "id": 27585,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 12,
   "firman": "Akan tetapi setelah Galio menjadi gubernur di Akhaya, bangkitlah orang-orang Yahudi bersama-sama melawan Paulus, lalu membawa dia ke depan pengadilan."
 },
 {
   "id": 27586,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 13,
   "firman": "Kata mereka: \"Ia ini berusaha meyakinkan orang untuk beribadah kepada Allah dengan jalan yang bertentangan dengan hukum Taurat.\""
 },
 {
   "id": 27587,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 14,
   "firman": "Ketika Paulus hendak mulai berbicara, berkatalah Galio kepada orang-orang Yahudi itu: \"Hai orang-orang Yahudi, jika sekiranya dakwaanmu mengenai suatu pelanggaran atau kejahatan, sudahlah sepatutnya aku menerima perkaramu,"
 },
 {
   "id": 27588,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 15,
   "firman": "tetapi kalau hal itu adalah perselisihan tentang perkataan atau nama atau hukum yang berlaku di antara kamu, maka hendaklah kamu sendiri mengurusnya; aku tidak rela menjadi hakim atas perkara yang demikian.\""
 },
 {
   "id": 27589,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 16,
   "firman": "Lalu ia mengusir mereka dari ruang pengadilan."
 },
 {
   "id": 27590,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 17,
   "firman": "Maka orang itu semua menyerbu Sostenes, kepala rumah ibadat, lalu memukulinya di depan pengadilan itu; tetapi Galio sama sekali tidak menghiraukan hal itu."
 },
 {
   "id": 27591,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 18,
   "firman": "Paulus tinggal beberapa hari lagi di Korintus. Lalu ia minta diri kepada saudara-saudara di situ, dan berlayar ke Siria, sesudah ia mencukur rambutnya di Kengkrea, karena ia telah bernazar. Priskila dan Akwila menyertai dia."
 },
 {
   "id": 27592,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 19,
   "firman": "Lalu sampailah mereka di Efesus. Paulus meninggalkan Priskila dan Akwila di situ. Ia sendiri masuk ke rumah ibadat dan berbicara dengan orang-orang Yahudi."
 },
 {
   "id": 27593,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 20,
   "firman": "Mereka minta kepadanya untuk tinggal lebih lama di situ, tetapi ia tidak mengabulkannya."
 },
 {
   "id": 27594,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 21,
   "firman": "Ia minta diri dan berkata: \"Aku akan kembali kepada kamu, jika Allah menghendakinya.\" Lalu bertolaklah ia dari Efesus."
 },
 {
   "id": 27595,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 22,
   "firman": "Ia sampai di Kaisarea dan setelah naik ke darat dan memberi salam kepada jemaat, ia berangkat ke Antiokhia."
 },
 {
   "id": 27596,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 23,
   "firman": "Setelah beberapa hari lamanya ia tinggal di situ, ia berangkat pula, lalu menjelajahi seluruh tanah Galatia dan Frigia untuk meneguhkan hati semua murid."
 },
 {
   "id": 27597,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 24,
   "firman": "Sementara itu datanglah ke Efesus seorang Yahudi bernama Apolos, yang berasal dari Aleksandria. Ia seorang yang fasih berbicara dan sangat mahir dalam soal-soal Kitab Suci."
 },
 {
   "id": 27598,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 25,
   "firman": "Ia telah menerima pengajaran dalam Jalan Tuhan. Dengan bersemangat ia berbicara dan dengan teliti ia mengajar tentang Yesus, tetapi ia hanya mengetahui baptisan Yohanes."
 },
 {
   "id": 27599,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 26,
   "firman": "Ia mulai mengajar dengan berani di rumah ibadat. Tetapi setelah Priskila dan Akwila mendengarnya, mereka membawa dia ke rumah mereka dan dengan teliti menjelaskan kepadanya Jalan Allah."
 },
 {
   "id": 27600,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 27,
   "firman": "Karena Apolos ingin menyeberang ke Akhaya, saudara-saudara di Efesus mengirim surat kepada murid-murid di situ, supaya mereka menyambut dia. Setibanya di Akhaya maka ia, oleh kasih karunia Allah, menjadi seorang yang sangat berguna bagi orang-orang yang percaya."
 },
 {
   "id": 27601,
   "kitab": "Kis",
   "pasal": 18,
   "ayat": 28,
   "firman": "Sebab dengan tak jemu-jemunya ia membantah orang-orang Yahudi di muka umum dan membuktikan dari Kitab Suci bahwa Yesus adalah Mesias."
 },
 {
   "id": 27602,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 1,
   "firman": "Ketika Apolos masih di Korintus, Paulus sudah menjelajah daerah-daerah pedalaman dan tiba di Efesus. Di situ didapatinya beberapa orang murid."
 },
 {
   "id": 27603,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 2,
   "firman": "Katanya kepada mereka: \"Sudahkah kamu menerima Roh Kudus, ketika kamu menjadi percaya?\" Akan tetapi mereka menjawab dia: \"Belum, bahkan kami belum pernah mendengar, bahwa ada Roh Kudus.\""
 },
 {
   "id": 27604,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 3,
   "firman": "Lalu kata Paulus kepada mereka: \"Kalau begitu dengan baptisan manakah kamu telah dibaptis?\" Jawab mereka: \"Dengan baptisan Yohanes.\""
 },
 {
   "id": 27605,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 4,
   "firman": "Kata Paulus: \"Baptisan Yohanes adalah pembaptisan orang yang telah bertobat, dan ia berkata kepada orang banyak, bahwa mereka harus percaya kepada Dia yang datang kemudian dari padanya, yaitu Yesus.\""
 },
 {
   "id": 27606,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 5,
   "firman": "Ketika mereka mendengar hal itu, mereka memberi diri mereka dibaptis dalam nama Tuhan Yesus."
 },
 {
   "id": 27607,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 6,
   "firman": "Dan ketika Paulus menumpangkan tangan di atas mereka, turunlah Roh Kudus ke atas mereka, dan mulailah mereka berkata-kata dalam bahasa roh dan bernubuat."
 },
 {
   "id": 27608,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 7,
   "firman": "Jumlah mereka adalah kira-kira dua belas orang."
 },
 {
   "id": 27609,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 8,
   "firman": "Selama tiga bulan Paulus mengunjungi rumah ibadat di situ dan mengajar dengan berani. Oleh pemberitaannya ia berusaha meyakinkan mereka tentang Kerajaan Allah."
 },
 {
   "id": 27610,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 9,
   "firman": "Tetapi ada beberapa orang yang tegar hatinya. Mereka tidak mau diyakinkan, malahan mengumpat Jalan Tuhan di depan orang banyak. Karena itu Paulus meninggalkan mereka dan memisahkan murid-muridnya dari mereka, dan setiap hari berbicara di ruang kuliah Tiranus."
 },
 {
   "id": 27611,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 10,
   "firman": "Hal ini dilakukannya dua tahun lamanya, sehingga semua penduduk Asia mendengar firman Tuhan, baik orang Yahudi maupun orang Yunani."
 },
 {
   "id": 27612,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 11,
   "firman": "Oleh Paulus Allah mengadakan mujizat-mujizat yang luar biasa,"
 },
 {
   "id": 27613,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 12,
   "firman": "bahkan orang membawa saputangan atau kain yang pernah dipakai oleh Paulus dan meletakkannya atas orang-orang sakit, maka lenyaplah penyakit mereka dan keluarlah roh-roh jahat."
 },
 {
   "id": 27614,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 13,
   "firman": "Juga beberapa tukang jampi Yahudi, yang berjalan keliling di negeri itu, mencoba menyebut nama Tuhan Yesus atas mereka yang kerasukan roh jahat dengan berseru, katanya: \"Aku menyumpahi kamu demi nama Yesus yang diberitakan oleh Paulus.\""
 },
 {
   "id": 27615,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 14,
   "firman": "Mereka yang melakukan hal itu ialah tujuh orang anak dari seorang imam kepala Yahudi yang bernama Skewa."
 },
 {
   "id": 27616,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 15,
   "firman": "Tetapi roh jahat itu menjawab: \"Yesus aku kenal, dan Paulus aku ketahui, tetapi kamu, siapakah kamu?\""
 },
 {
   "id": 27617,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 16,
   "firman": "Dan orang yang dirasuk roh jahat itu menerpa mereka dan menggagahi mereka semua dan mengalahkannya, sehingga mereka lari dari rumah orang itu dengan telanjang dan luka-luka."
 },
 {
   "id": 27618,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 17,
   "firman": "Hal itu diketahui oleh seluruh penduduk Efesus, baik orang Yahudi maupun orang Yunani, maka ketakutanlah mereka semua dan makin masyhurlah nama Tuhan Yesus."
 },
 {
   "id": 27619,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 18,
   "firman": "Banyak di antara mereka yang telah menjadi percaya, datang dan mengaku di muka umum, bahwa mereka pernah turut melakukan perbuatan-perbuatan seperti itu."
 },
 {
   "id": 27620,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 19,
   "firman": "Banyak juga di antara mereka, yang pernah melakukan sihir, mengumpulkan kitab-kitabnya lalu membakarnya di depan mata semua orang. Nilai kitab-kitab itu ditaksir lima puluh ribu uang perak."
 },
 {
   "id": 27621,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 20,
   "firman": "Dengan jalan ini makin tersiarlah firman Tuhan dan makin berkuasa."
 },
 {
   "id": 27622,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 21,
   "firman": "Kemudian dari pada semuanya itu Paulus bermaksud pergi ke Yerusalem melalui Makedonia dan Akhaya. Katanya: \"Sesudah berkunjung ke situ aku harus melihat Roma juga.\""
 },
 {
   "id": 27623,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 22,
   "firman": "Lalu ia menyuruh dua orang pembantunya, yaitu Timotius dan Erastus, mendahuluinya ke Makedonia, tetapi ia sendiri tinggal beberapa lama lagi di Asia."
 },
 {
   "id": 27624,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 23,
   "firman": "Kira-kira pada waktu itu timbul huru-hara besar mengenai Jalan Tuhan."
 },
 {
   "id": 27625,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 24,
   "firman": "Sebab ada seorang bernama Demetrius, seorang tukang perak, yang membuat kuil-kuilan dewi Artemis dari perak. Usahanya itu mendatangkan penghasilan yang tidak sedikit bagi tukang-tukangnya."
 },
 {
   "id": 27626,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 25,
   "firman": "Ia mengumpulkan mereka bersama-sama dengan pekerja-pekerja lain dalam perusahaan itu dan berkata: \"Saudara-saudara, kamu tahu, bahwa kemakmuran kita adalah hasil perusahaan ini!"
 },
 {
   "id": 27627,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 26,
   "firman": "Sekarang kamu sendiri melihat dan mendengar, bagaimana Paulus, bukan saja di Efesus, tetapi juga hampir di seluruh Asia telah membujuk dan menyesatkan banyak orang dengan mengatakan, bahwa apa yang dibuat oleh tangan manusia bukanlah dewa."
 },
 {
   "id": 27628,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 27,
   "firman": "Dengan jalan demikian bukan saja perusahaan kita berada dalam bahaya untuk dihina orang, tetapi juga kuil Artemis, dewi besar itu, berada dalam bahaya akan kehilangan artinya. Dan Artemis sendiri, Artemis yang disembah oleh seluruh Asia dan seluruh dunia yang beradab, akan kehilangan kebesarannya.\""
 },
 {
   "id": 27629,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 28,
   "firman": "Mendengar itu meluaplah amarah mereka, lalu mereka berteriak-teriak, katanya: \"Besarlah Artemis dewi orang Efesus!\""
 },
 {
   "id": 27630,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 29,
   "firman": "Seluruh kota menjadi kacau dan mereka ramai-ramai membanjiri gedung kesenian serta menyeret Gayus dan Aristarkhus, keduanya orang Makedonia dan teman seperjalanan Paulus."
 },
 {
   "id": 27631,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 30,
   "firman": "Paulus mau pergi ke tengah-tengah rakyat itu, tetapi murid-muridnya tidak mengizinkannya."
 },
 {
   "id": 27632,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 31,
   "firman": "Bahkan beberapa pembesar yang berasal dari Asia yang bersahabat dengan Paulus, mengirim peringatan kepadanya, supaya ia jangan masuk ke gedung kesenian itu."
 },
 {
   "id": 27633,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 32,
   "firman": "Sementara itu orang yang berkumpul di dalam gedung itu berteriak-teriak; yang seorang mengatakan ini dan yang lain mengatakan itu, sebab kumpulan itu kacau-balau dan kebanyakan dari mereka tidak tahu untuk apa mereka berkumpul."
 },
 {
   "id": 27634,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 33,
   "firman": "Lalu seorang bernama Aleksander didorong ke depan oleh orang-orang Yahudi. Ia mendapat keterangan dari orang banyak tentang apa yang terjadi. Segera ia memberi isyarat dengan tangannya dan mau memberi penjelasan sebagai pembelaan di depan rakyat itu."
 },
 {
   "id": 27635,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 34,
   "firman": "Tetapi ketika mereka tahu, bahwa ia adalah orang Yahudi, berteriaklah mereka bersama-sama kira-kira dua jam lamanya: \"Besarlah Artemis dewi orang Efesus!\""
 },
 {
   "id": 27636,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 35,
   "firman": "Akan tetapi panitera kota menenangkan orang banyak itu dan berkata: \"Hai orang Efesus! Siapakah di dunia ini yang tidak tahu, bahwa kota Efesuslah yang memelihara baik kuil dewi Artemis, yang mahabesar, maupun patungnya yang turun dari langit?"
 },
 {
   "id": 27637,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 36,
   "firman": "Hal itu tidak dapat dibantah, karena itu hendaklah kamu tenang dan janganlah terburu-buru bertindak."
 },
 {
   "id": 27638,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 37,
   "firman": "Sebab kamu telah membawa orang-orang ini ke sini, walaupun mereka tidak merampok kuil dewi kita dan tidak menghujat namanya."
 },
 {
   "id": 27639,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 38,
   "firman": "Jadi jika Demetrius dan tukang-tukangnya ada pengaduannya terhadap seseorang, bukankah ada sidang-sidang pengadilan dan ada gubernur, jadi hendaklah kedua belah pihak mengajukan dakwaannya ke situ."
 },
 {
   "id": 27640,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 39,
   "firman": "Dan jika ada sesuatu yang lain yang kamu kehendaki, baiklah kehendakmu itu diselesaikan dalam sidang rakyat yang sah."
 },
 {
   "id": 27641,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 40,
   "firman": "Sebab kita berada dalam bahaya akan dituduh, bahwa kita menimbulkan huru-hara pada hari ini, karena tidak ada alasan yang dapat kita kemukakan untuk membenarkan kumpulan yang kacau-balau ini.\""
 },
 {
   "id": 27642,
   "kitab": "Kis",
   "pasal": 19,
   "ayat": 41,
   "firman": "(19-40b) Dan dengan kata-kata itu ia membubarkan kumpulan rakyat itu."
 },
 {
   "id": 27643,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 1,
   "firman": "Setelah reda keributan itu, Paulus memanggil murid-murid dan menguatkan hati mereka. Dan sesudah minta diri, ia berangkat ke Makedonia."
 },
 {
   "id": 27644,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 2,
   "firman": "Ia menjelajah daerah itu dan dengan banyak nasihat menguatkan hati saudara-saudara di situ. Lalu tibalah ia di tanah Yunani."
 },
 {
   "id": 27645,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 3,
   "firman": "Sesudah tiga bulan lamanya tinggal di situ ia hendak berlayar ke Siria. Tetapi pada waktu itu orang-orang Yahudi bermaksud membunuh dia. Karena itu ia memutuskan untuk kembali melalui Makedonia."
 },
 {
   "id": 27646,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 4,
   "firman": "Ia disertai oleh Sopater anak Pirus, dari Berea, dan Aristarkhus dan Sekundus, keduanya dari Tesalonika, dan Gayus dari Derbe, dan Timotius dan dua orang dari Asia, yaitu Tikhikus dan Trofimus."
 },
 {
   "id": 27647,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 5,
   "firman": "Mereka itu berangkat lebih dahulu dan menantikan kami di Troas."
 },
 {
   "id": 27648,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 6,
   "firman": "Tetapi sesudah hari raya Roti Tidak Beragi kami berlayar dari Filipi dan empat hari kemudian sampailah kami di Troas dan bertemu dengan mereka. Di situ kami tinggal tujuh hari lamanya."
 },
 {
   "id": 27649,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 7,
   "firman": "Pada hari pertama dalam minggu itu, ketika kami berkumpul untuk memecah-mecahkan roti, Paulus berbicara dengan saudara-saudara di situ, karena ia bermaksud untuk berangkat pada keesokan harinya. Pembicaraan itu berlangsung sampai tengah malam."
 },
 {
   "id": 27650,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 8,
   "firman": "Di ruang atas, di mana kami berkumpul, dinyalakan banyak lampu."
 },
 {
   "id": 27651,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 9,
   "firman": "Seorang muda bernama Eutikhus duduk di jendela. Karena Paulus amat lama berbicara, orang muda itu tidak dapat menahan kantuknya. Akhirnya ia tertidur lelap dan jatuh dari tingkat ketiga ke bawah. Ketika ia diangkat orang, ia sudah mati."
 },
 {
   "id": 27652,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 10,
   "firman": "Tetapi Paulus turun ke bawah. Ia merebahkan diri ke atas orang muda itu, mendekapnya, dan berkata: \"Jangan ribut, sebab ia masih hidup.\""
 },
 {
   "id": 27653,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 11,
   "firman": "Setelah kembali di ruang atas, Paulus memecah-mecahkan roti lalu makan; habis makan masih lama lagi ia berbicara, sampai fajar menyingsing. Kemudian ia berangkat."
 },
 {
   "id": 27654,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 12,
   "firman": "Sementara itu mereka mengantarkan orang muda itu hidup ke rumahnya, dan mereka semua merasa sangat terhibur."
 },
 {
   "id": 27655,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 13,
   "firman": "Kami berangkat lebih dahulu ke kapal dan berlayar ke Asos, dengan maksud untuk menjemput Paulus di situ sesuai dengan pesannya, sebab ia sendiri mau berjalan kaki melalui darat."
 },
 {
   "id": 27656,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 14,
   "firman": "Ketika ia bertemu dengan kami di Asos, kami membawanya ke kapal, lalu melanjutkan pelayaran kami ke Metilene."
 },
 {
   "id": 27657,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 15,
   "firman": "Dari situ kami terus berlayar dan pada keesokan harinya kami berhadapan dengan pulau Khios. Pada hari berikutnya kami menuju Samos dan sehari kemudian tibalah kami di Miletus."
 },
 {
   "id": 27658,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 16,
   "firman": "Paulus telah memutuskan untuk tidak singgah di Efesus, supaya jangan habis waktunya di Asia. Sebab ia buru-buru, agar jika mungkin, ia telah berada di Yerusalem pada hari raya Pentakosta."
 },
 {
   "id": 27659,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 17,
   "firman": "Karena itu ia menyuruh seorang dari Miletus ke Efesus dengan pesan supaya para penatua jemaat datang ke Miletus."
 },
 {
   "id": 27660,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 18,
   "firman": "Sesudah mereka datang, berkatalah ia kepada mereka: \"Kamu tahu, bagaimana aku hidup di antara kamu sejak hari pertama aku tiba di Asia ini:"
 },
 {
   "id": 27661,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 19,
   "firman": "dengan segala rendah hati aku melayani Tuhan. Dalam pelayanan itu aku banyak mencucurkan air mata dan banyak mengalami pencobaan dari pihak orang Yahudi yang mau membunuh aku."
 },
 {
   "id": 27662,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 20,
   "firman": "Sungguhpun demikian aku tidak pernah melalaikan apa yang berguna bagi kamu. Semua kuberitakan dan kuajarkan kepada kamu, baik di muka umum maupun dalam perkumpulan-perkumpulan di rumah kamu;"
 },
 {
   "id": 27663,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 21,
   "firman": "aku senantiasa bersaksi kepada orang-orang Yahudi dan orang-orang Yunani, supaya mereka bertobat kepada Allah dan percaya kepada Tuhan kita, Yesus Kristus."
 },
 {
   "id": 27664,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 22,
   "firman": "Tetapi sekarang sebagai tawanan Roh aku pergi ke Yerusalem dan aku tidak tahu apa yang akan terjadi atas diriku di situ"
 },
 {
   "id": 27665,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 23,
   "firman": "selain dari pada yang dinyatakan Roh Kudus dari kota ke kota kepadaku, bahwa penjara dan sengsara menunggu aku."
 },
 {
   "id": 27666,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 24,
   "firman": "Tetapi aku tidak menghiraukan nyawaku sedikitpun, asal saja aku dapat mencapai garis akhir dan menyelesaikan pelayanan yang ditugaskan oleh Tuhan Yesus kepadaku untuk memberi kesaksian tentang Injil kasih karunia Allah."
 },
 {
   "id": 27667,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 25,
   "firman": "Dan sekarang aku tahu, bahwa kamu tidak akan melihat mukaku lagi, kamu sekalian yang telah kukunjungi untuk memberitakan Kerajaan Allah."
 },
 {
   "id": 27668,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 26,
   "firman": "Sebab itu pada hari ini aku bersaksi kepadamu, bahwa aku bersih, tidak bersalah terhadap siapapun yang akan binasa."
 },
 {
   "id": 27669,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 27,
   "firman": "Sebab aku tidak lalai memberitakan seluruh maksud Allah kepadamu."
 },
 {
   "id": 27670,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 28,
   "firman": "Karena itu jagalah dirimu dan jagalah seluruh kawanan, karena kamulah yang ditetapkan Roh Kudus menjadi penilik untuk menggembalakan jemaat Allah yang diperoleh-Nya dengan darah Anak-Nya sendiri."
 },
 {
   "id": 27671,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 29,
   "firman": "Aku tahu, bahwa sesudah aku pergi, serigala-serigala yang ganas akan masuk ke tengah-tengah kamu dan tidak akan menyayangkan kawanan itu."
 },
 {
   "id": 27672,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 30,
   "firman": "Bahkan dari antara kamu sendiri akan muncul beberapa orang, yang dengan ajaran palsu mereka berusaha menarik murid-murid dari jalan yang benar dan supaya mengikut mereka."
 },
 {
   "id": 27673,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 31,
   "firman": "Sebab itu berjaga-jagalah dan ingatlah, bahwa aku tiga tahun lamanya, siang malam, dengan tiada berhenti-hentinya menasihati kamu masing-masing dengan mencucurkan air mata."
 },
 {
   "id": 27674,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 32,
   "firman": "Dan sekarang aku menyerahkan kamu kepada Tuhan dan kepada firman kasih karunia-Nya, yang berkuasa membangun kamu dan menganugerahkan kepada kamu bagian yang ditentukan bagi semua orang yang telah dikuduskan-Nya."
 },
 {
   "id": 27675,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 33,
   "firman": "Perak atau emas atau pakaian tidak pernah aku ingini dari siapapun juga."
 },
 {
   "id": 27676,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 34,
   "firman": "Kamu sendiri tahu, bahwa dengan tanganku sendiri aku telah bekerja untuk memenuhi keperluanku dan keperluan kawan-kawan seperjalananku."
 },
 {
   "id": 27677,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 35,
   "firman": "Dalam segala sesuatu telah kuberikan contoh kepada kamu, bahwa dengan bekerja demikian kita harus membantu orang-orang yang lemah dan harus mengingat perkataan Tuhan Yesus, sebab Ia sendiri telah mengatakan: Adalah lebih berbahagia memberi dari pada menerima.\""
 },
 {
   "id": 27678,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 36,
   "firman": "Sesudah mengucapkan kata-kata itu Paulus berlutut dan berdoa bersama-sama dengan mereka semua."
 },
 {
   "id": 27679,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 37,
   "firman": "Maka menangislah mereka semua tersedu-sedu dan sambil memeluk Paulus, mereka berulang-ulang mencium dia."
 },
 {
   "id": 27680,
   "kitab": "Kis",
   "pasal": 20,
   "ayat": 38,
   "firman": "Mereka sangat berdukacita, terlebih-lebih karena ia katakan, bahwa mereka tidak akan melihat mukanya lagi. Lalu mereka mengantar dia ke kapal."
 },
 {
   "id": 27681,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 1,
   "firman": "Sesudah perpisahan yang berat itu bertolaklah kami dan langsung berlayar menuju Kos. Keesokan harinya sampailah kami di Rodos dan dari situ kami ke Patara."
 },
 {
   "id": 27682,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 2,
   "firman": "Di Patara kami mendapat kapal, yang hendak menyeberang ke Fenisia. Kami naik kapal itu, lalu bertolak."
 },
 {
   "id": 27683,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 3,
   "firman": "Kemudian tampak Siprus di sebelah kiri, tetapi kami melewatinya dan menuju ke Siria. Akhirnya tibalah kami di Tirus, sebab muatan kapal harus dibongkar di kota itu."
 },
 {
   "id": 27684,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 4,
   "firman": "Di situ kami mengunjungi murid-murid dan tinggal di situ tujuh hari lamanya. Oleh bisikan Roh murid-murid itu menasihati Paulus, supaya ia jangan pergi ke Yerusalem."
 },
 {
   "id": 27685,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 5,
   "firman": "Tetapi setelah lewat waktunya, kami berangkat meneruskan perjalanan kami. Murid-murid semua dengan isteri dan anak-anak mereka mengantar kami sampai ke luar kota; dan di tepi pantai kami berlutut dan berdoa."
 },
 {
   "id": 27686,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 6,
   "firman": "Sesudah minta diri kami naik ke kapal, dan mereka pulang ke rumah."
 },
 {
   "id": 27687,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 7,
   "firman": "Dari Tirus kami tiba di Ptolemais dan di situ berakhirlah pelayaran kami. Kami memberi salam kepada saudara-saudara dan tinggal satu hari di antara mereka."
 },
 {
   "id": 27688,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 8,
   "firman": "Pada keesokan harinya kami berangkat dari situ dan tiba di Kaisarea. Kami masuk ke rumah Filipus, pemberita Injil itu, yaitu satu dari ketujuh orang yang dipilih di Yerusalem, dan kami tinggal di rumahnya."
 },
 {
   "id": 27689,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 9,
   "firman": "Filipus mempunyai empat anak dara yang beroleh karunia untuk bernubuat."
 },
 {
   "id": 27690,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 10,
   "firman": "Setelah beberapa hari kami tinggal di situ, datanglah dari Yudea seorang nabi bernama Agabus."
 },
 {
   "id": 27691,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 11,
   "firman": "Ia datang pada kami, lalu mengambil ikat pinggang Paulus. Sambil mengikat kaki dan tangannya sendiri ia berkata: \"Demikianlah kata Roh Kudus: Beginilah orang yang empunya ikat pinggang ini akan diikat oleh orang-orang Yahudi di Yerusalem dan diserahkan ke dalam tangan bangsa-bangsa lain.\""
 },
 {
   "id": 27692,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 12,
   "firman": "Mendengar itu kami bersama-sama dengan murid-murid di tempat itu meminta, supaya Paulus jangan pergi ke Yerusalem."
 },
 {
   "id": 27693,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 13,
   "firman": "Tetapi Paulus menjawab: \"Mengapa kamu menangis dan dengan jalan demikian mau menghancurkan hatiku? Sebab aku ini rela bukan saja untuk diikat, tetapi juga untuk mati di Yerusalem oleh karena nama Tuhan Yesus.\""
 },
 {
   "id": 27694,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 14,
   "firman": "Karena ia tidak mau menerima nasihat kami, kami menyerah dan berkata: \"Jadilah kehendak Tuhan!\""
 },
 {
   "id": 27695,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 15,
   "firman": "Sesudah beberapa hari lamanya tinggal di Kaisarea, berkemaslah kami, lalu berangkat ke Yerusalem."
 },
 {
   "id": 27696,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 16,
   "firman": "Bersama-sama dengan kami turut juga beberapa murid dari Kaisarea. Mereka membawa kami ke rumah seorang yang bernama Manason. Ia dari Siprus dan sudah lama menjadi murid. Kami akan menumpang di rumahnya."
 },
 {
   "id": 27697,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 17,
   "firman": "Ketika kami tiba di Yerusalem, semua saudara menyambut kami dengan suka hati."
 },
 {
   "id": 27698,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 18,
   "firman": "Pada keesokan harinya pergilah Paulus bersama-sama dengan kami mengunjungi Yakobus; semua penatua telah hadir di situ."
 },
 {
   "id": 27699,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 19,
   "firman": "Paulus memberi salam kepada mereka, lalu menceriterakan dengan terperinci apa yang dilakukan Allah di antara bangsa-bangsa lain oleh pelayanannya."
 },
 {
   "id": 27700,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 20,
   "firman": "Mendengar itu mereka memuliakan Allah. Lalu mereka berkata kepada Paulus: \"Saudara, lihatlah, beribu-ribu orang Yahudi telah menjadi percaya dan mereka semua rajin memelihara hukum Taurat."
 },
 {
   "id": 27701,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 21,
   "firman": "Tetapi mereka mendengar tentang engkau, bahwa engkau mengajar semua orang Yahudi yang tinggal di antara bangsa-bangsa lain untuk melepaskan hukum Musa, sebab engkau mengatakan, supaya mereka jangan menyunatkan anak-anaknya dan jangan hidup menurut adat istiadat kita."
 },
 {
   "id": 27702,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 22,
   "firman": "Jadi bagaimana sekarang? Tentu mereka akan mendengar, bahwa engkau telah datang ke mari."
 },
 {
   "id": 27703,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 23,
   "firman": "Sebab itu, lakukanlah apa yang kami katakan ini: Di antara kami ada empat orang yang bernazar."
 },
 {
   "id": 27704,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 24,
   "firman": "Bawalah mereka bersama-sama dengan engkau, lakukanlah pentahiran dirimu bersama-sama dengan mereka dan tanggunglah biaya mereka, sehingga mereka dapat mencukurkan rambutnya; maka semua orang akan tahu, bahwa segala kabar yang mereka dengar tentang engkau sama sekali tidak benar, melainkan bahwa engkau tetap memelihara hukum Taurat."
 },
 {
   "id": 27705,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 25,
   "firman": "Tetapi mengenai bangsa-bangsa lain, yang telah menjadi percaya, sudah kami tuliskan keputusan-keputusan kami, yaitu mereka harus menjauhkan diri dari makanan yang dipersembahkan kepada berhala, dari darah, dari daging binatang yang mati dicekik dan dari percabulan.\""
 },
 {
   "id": 27706,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 26,
   "firman": "Pada hari berikutnya Paulus membawa orang-orang itu serta dengan dia, dan ia mentahirkan diri bersama-sama dengan mereka, lalu masuk ke Bait Allah untuk memberitahukan, bilamana pentahiran akan selesai dan persembahan akan dipersembahkan untuk mereka masing-masing."
 },
 {
   "id": 27707,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 27,
   "firman": "Ketika masa tujuh hari itu sudah hampir berakhir, orang-orang Yahudi yang datang dari Asia, melihat Paulus di dalam Bait Allah, lalu mereka menghasut rakyat dan menangkap dia,"
 },
 {
   "id": 27708,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 28,
   "firman": "sambil berteriak: \"Hai orang-orang Israel, tolong! Inilah orang yang di mana-mana mengajar semua orang untuk menentang bangsa kita dan menentang hukum Taurat dan tempat ini! Dan sekarang ia membawa orang-orang Yunani pula ke dalam Bait Allah dan menajiskan tempat suci ini!\""
 },
 {
   "id": 27709,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 29,
   "firman": "Sebab mereka telah melihat Trofimus dari Efesus sebelumnya bersama-sama dengan Paulus di kota, dan mereka menyangka, bahwa Paulus telah membawa dia ke dalam Bait Allah."
 },
 {
   "id": 27710,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 30,
   "firman": "Maka gemparlah seluruh kota, dan rakyat datang berkerumun, lalu menangkap Paulus dan menyeretnya keluar dari Bait Allah dan seketika itu juga semua pintu gerbang Bait Allah itu ditutup."
 },
 {
   "id": 27711,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 31,
   "firman": "Sementara mereka merencanakan untuk membunuh dia, sampailah kabar kepada kepala pasukan, bahwa seluruh Yerusalem gempar."
 },
 {
   "id": 27712,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 32,
   "firman": "Kepala pasukan itu segera bergerak dengan prajurit-prajurit dan perwira-perwira dan maju mendapatkan orang banyak itu. Ketika mereka melihat dia dan prajurit-prajurit itu, berhentilah mereka memukul Paulus."
 },
 {
   "id": 27713,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 33,
   "firman": "Kepala pasukan itu mendekati Paulus, menangkapnya dan menyuruh mengikat dia dengan dua rantai, lalu bertanya siapakah dia dan apakah yang telah diperbuatnya."
 },
 {
   "id": 27714,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 34,
   "firman": "Tetapi dari antara orang banyak itu ada yang meneriakkan kepadanya ini, ada pula yang meneriakkan itu. Dan oleh karena keributan itu ia tidak dapat mengetahui apakah yang sebenarnya terjadi. Sebab itu ia menyuruh membawa Paulus ke markas."
 },
 {
   "id": 27715,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 35,
   "firman": "Ketika sampai ke tangga Paulus terpaksa didukung prajurit-prajurit karena berdesak-desaknya orang banyak,"
 },
 {
   "id": 27716,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 36,
   "firman": "yang berbondong-bondong mengikuti dia, sambil berteriak: \"Enyahkanlah dia!\""
 },
 {
   "id": 27717,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 37,
   "firman": "Ketika Paulus hendak dibawa masuk ke markas, ia berkata kepada kepala pasukan itu: \"Bolehkah aku mengatakan sesuatu kepadamu?\" Jawabnya: \"Tahukah engkau bahasa Yunani?"
 },
 {
   "id": 27718,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 38,
   "firman": "Jadi engkau bukan orang Mesir itu, yang baru-baru ini menimbulkan pemberontakan dan melarikan empat ribu orang pengacau bersenjata ke padang gurun?\""
 },
 {
   "id": 27719,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 39,
   "firman": "Paulus menjawab: \"Aku adalah orang Yahudi, dari Tarsus, warga dari kota yang terkenal di Kilikia; aku minta, supaya aku diperbolehkan berbicara kepada orang banyak itu.\""
 },
 {
   "id": 27720,
   "kitab": "Kis",
   "pasal": 21,
   "ayat": 40,
   "firman": "Sesudah Paulus diperbolehkan oleh kepala pasukan, pergilah ia berdiri di tangga dan memberi isyarat dengan tangannya kepada rakyat itu; ketika suasana sudah tenang, mulailah ia berbicara kepada mereka dalam bahasa Ibrani, katanya:"
 },
 {
   "id": 27721,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 1,
   "firman": "\"Hai saudara-saudara dan bapa-bapa, dengarkanlah, apa yang hendak kukatakan kepadamu sebagai pembelaan diri.\""
 },
 {
   "id": 27722,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 2,
   "firman": "Ketika orang banyak itu mendengar ia berbicara dalam bahasa Ibrani, makin tenanglah mereka. Ia berkata:"
 },
 {
   "id": 27723,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 3,
   "firman": "\"Aku adalah orang Yahudi, lahir di Tarsus di tanah Kilikia, tetapi dibesarkan di kota ini; dididik dengan teliti di bawah pimpinan Gamaliel dalam hukum nenek moyang kita, sehingga aku menjadi seorang yang giat bekerja bagi Allah sama seperti kamu semua pada waktu ini."
 },
 {
   "id": 27724,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 4,
   "firman": "Dan aku telah menganiaya pengikut-pengikut Jalan Tuhan sampai mereka mati; laki-laki dan perempuan kutangkap dan kuserahkan ke dalam penjara."
 },
 {
   "id": 27725,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 5,
   "firman": "Tentang hal itu baik Imam Besar maupun Majelis Tua-Tua dapat memberi kesaksian. Dari mereka aku telah membawa surat-surat untuk saudara-saudara di Damsyik dan aku telah pergi ke sana untuk menangkap penganut-penganut Jalan Tuhan, yang terdapat juga di situ dan membawa mereka ke Yerusalem untuk dihukum."
 },
 {
   "id": 27726,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 6,
   "firman": "Tetapi dalam perjalananku ke sana, ketika aku sudah dekat Damsyik, yaitu waktu tengah hari, tiba-tiba memancarlah cahaya yang menyilaukan dari langit mengelilingi aku."
 },
 {
   "id": 27727,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 7,
   "firman": "Maka rebahlah aku ke tanah dan aku mendengar suatu suara yang berkata kepadaku: Saulus, Saulus, mengapakah engkau menganiaya Aku?"
 },
 {
   "id": 27728,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 8,
   "firman": "Jawabku: Siapakah Engkau, Tuhan? Kata-Nya: Akulah Yesus, orang Nazaret, yang kauaniaya itu."
 },
 {
   "id": 27729,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 9,
   "firman": "Dan mereka yang menyertai aku, memang melihat cahaya itu, tetapi suara Dia, yang berkata kepadaku, tidak mereka dengar."
 },
 {
   "id": 27730,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 10,
   "firman": "Maka kataku: Tuhan, apakah yang harus kuperbuat? Kata Tuhan kepadaku: Bangkitlah dan pergilah ke Damsyik. Di sana akan diberitahukan kepadamu segala sesuatu yang ditugaskan kepadamu."
 },
 {
   "id": 27731,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 11,
   "firman": "Dan karena aku tidak dapat melihat oleh karena cahaya yang menyilaukan mata itu, maka kawan-kawan seperjalananku memegang tanganku dan menuntun aku ke Damsyik."
 },
 {
   "id": 27732,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 12,
   "firman": "Di situ ada seorang bernama Ananias, seorang saleh yang menurut hukum Taurat dan terkenal baik di antara semua orang Yahudi yang ada di situ."
 },
 {
   "id": 27733,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 13,
   "firman": "Ia datang berdiri di dekatku dan berkata: Saulus, saudaraku, bukalah matamu dan melihatlah! Dan seketika itu juga aku melihat kembali dan menatap dia."
 },
 {
   "id": 27734,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 14,
   "firman": "Lalu katanya: Allah nenek moyang kita telah menetapkan engkau untuk mengetahui kehendak-Nya, untuk melihat Yang Benar dan untuk mendengar suara yang keluar dari mulut-Nya."
 },
 {
   "id": 27735,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 15,
   "firman": "Sebab engkau harus menjadi saksi-Nya terhadap semua orang tentang apa yang kaulihat dan yang kaudengar."
 },
 {
   "id": 27736,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 16,
   "firman": "Dan sekarang, mengapa engkau masih ragu-ragu? Bangunlah, berilah dirimu dibaptis dan dosa-dosamu disucikan sambil berseru kepada nama Tuhan!"
 },
 {
   "id": 27737,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 17,
   "firman": "Sesudah aku kembali di Yerusalem dan ketika aku sedang berdoa di dalam Bait Allah, rohku diliputi oleh kuasa ilahi."
 },
 {
   "id": 27738,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 18,
   "firman": "Aku melihat Dia, yang berkata kepadaku: Lekaslah, segeralah tinggalkan Yerusalem, sebab mereka tidak akan menerima kesaksianmu tentang Aku."
 },
 {
   "id": 27739,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 19,
   "firman": "Jawabku: Tuhan, mereka tahu, bahwa akulah yang pergi dari rumah ibadat yang satu ke rumah ibadat yang lain dan yang memasukkan mereka yang percaya kepada-Mu ke dalam penjara dan menyesah mereka."
 },
 {
   "id": 27740,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 20,
   "firman": "Dan ketika darah Stefanus, saksi-Mu itu, ditumpahkan, aku ada di situ dan menyetujui perbuatan itu dan aku menjaga pakaian mereka yang membunuhnya."
 },
 {
   "id": 27741,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 21,
   "firman": "Tetapi kata Tuhan kepadaku: Pergilah, sebab Aku akan mengutus engkau jauh dari sini kepada bangsa-bangsa lain.\""
 },
 {
   "id": 27742,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 22,
   "firman": "Rakyat mendengarkan Paulus sampai kepada perkataan itu; tetapi sesudah itu, mereka mulai berteriak, katanya: \"Enyahkan orang ini dari muka bumi! Ia tidak layak hidup!\""
 },
 {
   "id": 27743,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 23,
   "firman": "Mereka terus berteriak sambil melemparkan jubah mereka dan menghamburkan debu ke udara."
 },
 {
   "id": 27744,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 24,
   "firman": "Karena itu kepala pasukan memberi perintah untuk membawa Paulus ke markas dan menyuruh memeriksa dan menyesah dia, supaya dapat diketahui apa sebabnya orang banyak itu berteriak-teriak sedemikian terhadap dia."
 },
 {
   "id": 27745,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 25,
   "firman": "Tetapi ketika Paulus ditelentangkan untuk disesah, berkatalah ia kepada perwira yang bertugas: \"Bolehkah kamu menyesah seorang warganegara Rum, apalagi tanpa diadili?\""
 },
 {
   "id": 27746,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 26,
   "firman": "Mendengar perkataan itu perwira itu melaporkannya kepada kepala pasukan, katanya: \"Apakah yang hendak engkau perbuat? Orang itu warganegara Rum.\""
 },
 {
   "id": 27747,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 27,
   "firman": "Maka datanglah kepala pasukan itu kepada Paulus dan berkata: \"Katakanlah, benarkah engkau warganegara Rum?\" Jawab Paulus: \"Benar.\""
 },
 {
   "id": 27748,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 28,
   "firman": "Lalu kata kepala pasukan itu: \"Kewarganegaraan itu kubeli dengan harga yang mahal.\" Jawab Paulus: \"Tetapi aku mempunyai hak itu karena kelahiranku.\""
 },
 {
   "id": 27749,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 29,
   "firman": "Maka mereka yang harus menyesah dia, segera mundur; dan kepala pasukan itu juga takut, setelah ia tahu, bahwa Paulus, yang ia suruh ikat itu, adalah orang Rum."
 },
 {
   "id": 27750,
   "kitab": "Kis",
   "pasal": 22,
   "ayat": 30,
   "firman": "Namun kepala pasukan itu ingin mengetahui dengan teliti apa yang dituduhkan orang-orang Yahudi kepada Paulus. Karena itu pada keesokan harinya ia menyuruh mengambil Paulus dari penjara dan memerintahkan, supaya imam-imam kepala dan seluruh Mahkamah Agama berkumpul. Lalu ia membawa Paulus dari markas dan menghadapkannya kepada mereka."
 },
 {
   "id": 27751,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 1,
   "firman": "Sambil menatap anggota-anggota Mahkamah Agama, Paulus berkata: \"Hai saudara-saudaraku, sampai kepada hari ini aku tetap hidup dengan hati nurani yang murni di hadapan Allah.\""
 },
 {
   "id": 27752,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 2,
   "firman": "Tetapi Imam Besar Ananias menyuruh orang-orang yang berdiri dekat Paulus menampar mulut Paulus."
 },
 {
   "id": 27753,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 3,
   "firman": "Membalas itu Paulus berkata kepadanya: \"Allah akan menampar engkau, hai tembok yang dikapur putih-putih! Engkau duduk di sini untuk menghakimi aku menurut hukum Taurat, namun engkau melanggar hukum Taurat oleh perintahmu untuk menampar aku.\""
 },
 {
   "id": 27754,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 4,
   "firman": "Dan orang-orang yang hadir di situ berkata: \"Engkau mengejek Imam Besar Allah?\""
 },
 {
   "id": 27755,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 5,
   "firman": "Jawab Paulus: \"Hai saudara-saudara, aku tidak tahu, bahwa ia adalah Imam Besar. Memang ada tertulis: Janganlah engkau berkata jahat tentang seorang pemimpin bangsamu!\""
 },
 {
   "id": 27756,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 6,
   "firman": "Dan karena ia tahu, bahwa sebagian dari mereka itu termasuk golongan orang Saduki dan sebagian termasuk golongan orang Farisi, ia berseru dalam Mahkamah Agama itu, katanya: \"Hai saudara-saudaraku, aku adalah orang Farisi, keturunan orang Farisi; aku dihadapkan ke Mahkamah ini, karena aku mengharap akan kebangkitan orang mati.\""
 },
 {
   "id": 27757,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 7,
   "firman": "Ketika ia berkata demikian, timbullah perpecahan antara orang-orang Farisi dan orang-orang Saduki dan terbagi-bagilah orang banyak itu."
 },
 {
   "id": 27758,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 8,
   "firman": "Sebab orang-orang Saduki mengatakan, bahwa tidak ada kebangkitan dan tidak ada malaikat atau roh, tetapi orang-orang Farisi mengakui kedua-duanya."
 },
 {
   "id": 27759,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 9,
   "firman": "Maka terjadilah keributan besar. Beberapa ahli Taurat dari golongan Farisi tampil ke depan dan membantah dengan keras, katanya: \"Kami sama sekali tidak menemukan sesuatu yang salah pada orang ini! Barangkali ada roh atau malaikat yang telah berbicara kepadanya.\""
 },
 {
   "id": 27760,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 10,
   "firman": "Maka terjadilah perpecahan besar, sehingga kepala pasukan takut, kalau-kalau mereka akan mengoyak-ngoyak Paulus. Karena itu ia memerintahkan pasukan untuk turun ke bawah dan mengambil Paulus dari tengah-tengah mereka dan membawanya ke markas."
 },
 {
   "id": 27761,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 11,
   "firman": "Pada malam berikutnya Tuhan datang berdiri di sisinya dan berkata kepadanya: \"Kuatkanlah hatimu, sebab sebagaimana engkau dengan berani telah bersaksi tentang Aku di Yerusalem, demikian jugalah hendaknya engkau pergi bersaksi di Roma.\""
 },
 {
   "id": 27762,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 12,
   "firman": "Dan setelah hari siang orang-orang Yahudi mengadakan komplotan dan bersumpah dengan mengutuk diri, bahwa mereka tidak akan makan atau minum, sebelum mereka membunuh Paulus."
 },
 {
   "id": 27763,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 13,
   "firman": "Jumlah mereka yang mengadakan komplotan itu lebih dari pada empat puluh orang."
 },
 {
   "id": 27764,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 14,
   "firman": "Mereka pergi kepada imam-imam kepala dan tua-tua bangsa Yahudi dan berkata: \"Kami telah bersumpah dengan mengutuk diri, bahwa kami tidak akan makan atau minum, sebelum kami membunuh Paulus."
 },
 {
   "id": 27765,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 15,
   "firman": "Karena itu hendaklah kamu bersama-sama dengan Mahkamah Agama menganjurkan kepada kepala pasukan, supaya ia menghadapkan Paulus lagi kepada kamu, seolah-olah kamu hendak memeriksa perkaranya lebih teliti, dan sementara itu kami sudah siap sedia untuk membunuh dia sebelum ia sampai kepada kamu.\""
 },
 {
   "id": 27766,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 16,
   "firman": "Akan tetapi kemenakan Paulus, anak saudaranya perempuan, mendengar tentang penghadangan itu. Ia datang ke markas dan setelah diizinkan masuk, ia memberitahukannya kepada Paulus."
 },
 {
   "id": 27767,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 17,
   "firman": "Lalu Paulus memanggil salah seorang perwira dan berkata kepadanya: \"Bawalah anak ini kepada kepala pasukan, karena ada sesuatu yang perlu diberitahukannya kepadanya.\""
 },
 {
   "id": 27768,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 18,
   "firman": "Perwira itu membawanya kepada kepala pasukan dan berkata: \"Paulus orang tahanan itu, memanggil aku dan meminta, supaya aku membawa anak muda ini kepadamu, sebab ada yang perlu diberitahukannya kepadamu.\""
 },
 {
   "id": 27769,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 19,
   "firman": "Maka kepala pasukan itu memegang tangan anak muda itu, lalu membawanya ke samping dan bertanya: \"Apakah yang perlu kauberitahukan kepadaku?\""
 },
 {
   "id": 27770,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 20,
   "firman": "Jawabnya: \"Orang-orang Yahudi telah bersepakat untuk meminta kepadamu, supaya besok engkau menghadapkan Paulus lagi ke Mahkamah Agama, seolah-olah Mahkamah itu mau memperoleh keterangan yang lebih teliti dari padanya."
 },
 {
   "id": 27771,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 21,
   "firman": "Akan tetapi janganlah engkau mendengarkan mereka, sebab lebih dari pada empat puluh orang dari mereka telah siap untuk menghadang dia. Mereka telah bersumpah dengan mengutuk diri, bahwa mereka tidak akan makan atau minum, sebelum mereka membunuh dia; sekarang mereka telah siap sedia dan hanya menantikan keputusanmu.\""
 },
 {
   "id": 27772,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 22,
   "firman": "Lalu kepala pasukan menyuruh anak muda itu pulang dan memerintahkan kepadanya: \"Jangan katakan kepada siapapun juga, bahwa engkau telah memberitahukan hal ini kepadaku.\""
 },
 {
   "id": 27773,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 23,
   "firman": "Kemudian kepala pasukan memanggil dua perwira dan berkata: \"Siapkan dua ratus orang prajurit untuk berangkat ke Kaisarea beserta tujuh puluh orang berkuda dan dua ratus orang bersenjata lembing, kira-kira pada jam sembilan malam ini."
 },
 {
   "id": 27774,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 24,
   "firman": "Sediakan juga beberapa keledai tunggang untuk Paulus dan bawalah dia dengan selamat kepada wali negeri Feliks.\""
 },
 {
   "id": 27775,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 25,
   "firman": "Dan ia menulis surat, yang isinya sebagai berikut:"
 },
 {
   "id": 27776,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 26,
   "firman": "\"Salam dari Klaudius Lisias kepada wali negeri Feliks yang mulia."
 },
 {
   "id": 27777,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 27,
   "firman": "Orang ini ditangkap oleh orang-orang Yahudi dan ketika mereka hendak membunuhnya, aku datang dengan pasukan mencegahnya dan melepaskannya, karena aku dengar, bahwa ia adalah warganegara Roma."
 },
 {
   "id": 27778,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 28,
   "firman": "Untuk mengetahui apa alasannya mereka mendakwa dia, aku menghadapkannya ke Mahkamah Agama mereka."
 },
 {
   "id": 27779,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 29,
   "firman": "Ternyatalah bagiku, bahwa ia didakwa karena soal-soal hukum Taurat mereka, tetapi tidak ada tuduhan, atas mana ia patut dihukum mati atau dipenjarakan."
 },
 {
   "id": 27780,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 30,
   "firman": "Kepadaku telah diberitahukan, bahwa ada komplotan merencanakan membunuh dia. Karena itu aku segera menyuruh membawa dia kepadamu, sedang kepada para pendakwa telah kuberitahukan, bahwa mereka harus mengajukan perkara itu kepadamu.\""
 },
 {
   "id": 27781,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 31,
   "firman": "Lalu prajurit-prajurit itu mengambil Paulus sesuai dengan yang diperintahkan kepada mereka dan membawanya pada waktu malam ke Antipatris."
 },
 {
   "id": 27782,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 32,
   "firman": "Pada keesokan harinya mereka membiarkan orang-orang berkuda dan Paulus meneruskan perjalanan, dan mereka sendiri pulang ke markas."
 },
 {
   "id": 27783,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 33,
   "firman": "Setibanya di Kaisarea orang-orang berkuda itu menyampaikan surat itu kepada wali negeri serta menyerahkan Paulus kepadanya."
 },
 {
   "id": 27784,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 34,
   "firman": "Dan setelah membaca surat itu, wali negeri itu menanyakan Paulus dari propinsi manakah asalnya. Dan ketika ia mendengar, bahwa Paulus dari Kilikia,"
 },
 {
   "id": 27785,
   "kitab": "Kis",
   "pasal": 23,
   "ayat": 35,
   "firman": "ia berkata: \"Aku akan memeriksa perkaramu, bila para pendakwamu juga telah tiba di sini.\" Lalu ia menyuruh menahan Paulus di istana Herodes."
 },
 {
   "id": 27786,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 1,
   "firman": "Lima hari kemudian datanglah Imam Besar Ananias bersama-sama dengan beberapa orang tua-tua dan seorang pengacara bernama Tertulus. Mereka menghadap wali negeri dan menyampaikan dakwaan mereka terhadap Paulus."
 },
 {
   "id": 27787,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 2,
   "firman": "Paulus dipanggil menghadap dan Tertulus mulai mendakwa dia, katanya: \"Feliks yang mulia, oleh usahamu kami terus-menerus menikmati kesejahteraan, dan oleh kebijaksanaanmu banyak sekali perbaikan yang telah terlaksana untuk bangsa kami."
 },
 {
   "id": 27788,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 3,
   "firman": "Semuanya itu senantiasa dan di mana-mana kami sambut dengan sangat berterima kasih."
 },
 {
   "id": 27789,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 4,
   "firman": "Akan tetapi supaya jangan terlalu banyak menghabiskan waktumu, aku minta, supaya engkau mendengarkan kami sebentar dengan kemurahan hatimu yang terkenal itu."
 },
 {
   "id": 27790,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 5,
   "firman": "Telah nyata kepada kami, bahwa orang ini adalah penyakit sampar, seorang yang menimbulkan kekacauan di antara semua orang Yahudi di seluruh dunia yang beradab, dan bahwa ia adalah seorang tokoh dari sekte orang Nasrani."
 },
 {
   "id": 27791,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 6,
   "firman": "Malahan ia mencoba melanggar kekudusan Bait Allah. Oleh karena itu kami menangkap dia dan hendak menghakiminya menurut hukum Taurat kami."
 },
 {
   "id": 27792,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 7,
   "firman": "Tetapi kepala pasukan Lisias datang mencegahnya dan merebut dia dengan kekerasan dari tangan kami,"
 },
 {
   "id": 27793,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 8,
   "firman": "lalu menyuruh para pendakwa datang menghadap engkau. Jika engkau sendiri memeriksa dia, dapatlah engkau mengetahui segala sesuatu yang kami tuduhkan kepadanya.\""
 },
 {
   "id": 27794,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 9,
   "firman": "Dan juga orang-orang Yahudi menyokong dakwaan itu dengan mengatakan, bahwa perkara itu sungguh demikian."
 },
 {
   "id": 27795,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 10,
   "firman": "Lalu wali negeri itu memberi isyarat kepada Paulus, bahwa ia boleh berbicara. Maka berkatalah Paulus: \"Aku tahu, bahwa sudah bertahun-tahun lamanya engkau menjadi hakim atas bangsa ini. Karena itu tanpa ragu-ragu aku membela perkaraku ini di hadapanmu:"
 },
 {
   "id": 27796,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 11,
   "firman": "Engkau dapat memastikan, bahwa tidak lebih dari dua belas hari yang lalu aku datang ke Yerusalem untuk beribadah."
 },
 {
   "id": 27797,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 12,
   "firman": "Dan tidak pernah orang mendapati aku sedang bertengkar dengan seseorang atau mengadakan huru-hara, baik di dalam Bait Allah, maupun di dalam rumah ibadat, atau di tempat lain di kota."
 },
 {
   "id": 27798,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 13,
   "firman": "Dan mereka tidak dapat membuktikan kepadamu apa yang sekarang dituduhkan mereka kepada diriku."
 },
 {
   "id": 27799,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 14,
   "firman": "Tetapi aku mengakui kepadamu, bahwa aku berbakti kepada Allah nenek moyang kami dengan menganut Jalan Tuhan, yaitu Jalan yang mereka sebut sekte. Aku percaya kepada segala sesuatu yang ada tertulis dalam hukum Taurat dan dalam kitab nabi-nabi."
 },
 {
   "id": 27800,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 15,
   "firman": "Aku menaruh pengharapan kepada Allah, sama seperti mereka juga, bahwa akan ada kebangkitan semua orang mati, baik orang-orang yang benar maupun orang-orang yang tidak benar."
 },
 {
   "id": 27801,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 16,
   "firman": "Sebab itu aku senantiasa berusaha untuk hidup dengan hati nurani yang murni di hadapan Allah dan manusia."
 },
 {
   "id": 27802,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 17,
   "firman": "Dan setelah beberapa tahun lamanya aku datang kembali ke Yerusalem untuk membawa pemberian bagi bangsaku dan untuk mempersembahkan persembahan-persembahan."
 },
 {
   "id": 27803,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 18,
   "firman": "Sementara aku melakukan semuanya itu, beberapa orang Yahudi dari Asia mendapati aku di dalam Bait Allah, sesudah aku selesai mentahirkan diriku, tanpa orang banyak dan tanpa keributan."
 },
 {
   "id": 27804,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 19,
   "firman": "Merekalah yang sebenarnya harus menghadap engkau di sini dan mengajukan dakwaan mereka, jika mereka mempunyai sesuatu terhadap aku."
 },
 {
   "id": 27805,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 20,
   "firman": "Namun biarlah orang-orang yang hadir di sini sekarang menyatakan kejahatan apakah yang mereka dapati, ketika aku dihadapkan di Mahkamah Agama."
 },
 {
   "id": 27806,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 21,
   "firman": "Atau mungkinkah karena satu-satunya perkataan yang aku serukan, ketika aku berdiri di tengah-tengah mereka, yakni: Karena hal kebangkitan orang-orang mati, aku hari ini dihadapkan kepada kamu.\""
 },
 {
   "id": 27807,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 22,
   "firman": "Tetapi Feliks yang tahu benar-benar akan Jalan Tuhan, menangguhkan perkara mereka, katanya: \"Setibanya kepala pasukan Lisias di sini, aku akan mengambil keputusan dalam perkaramu.\""
 },
 {
   "id": 27808,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 23,
   "firman": "Lalu ia menyuruh perwira itu tetap menahan Paulus, tetapi dengan tahanan ringan, dan tidak boleh mencegah sahabat-sahabatnya melayani dia."
 },
 {
   "id": 27809,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 24,
   "firman": "Dan setelah beberapa hari datanglah Feliks bersama-sama dengan isterinya Drusila, seorang Yahudi; ia menyuruh memanggil Paulus, lalu mendengar dari padanya tentang kepercayaan kepada Yesus Kristus."
 },
 {
   "id": 27810,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 25,
   "firman": "Tetapi ketika Paulus berbicara tentang kebenaran, penguasaan diri dan penghakiman yang akan datang, Feliks menjadi takut dan berkata: \"Cukuplah dahulu dan pergilah sekarang; apabila ada kesempatan baik, aku akan menyuruh memanggil engkau.\""
 },
 {
   "id": 27811,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 26,
   "firman": "Sementara itu ia berharap, bahwa Paulus akan memberikan uang kepadanya. Karena itu ia sering memanggilnya untuk bercakap-cakap dengan dia."
 },
 {
   "id": 27812,
   "kitab": "Kis",
   "pasal": 24,
   "ayat": 27,
   "firman": "Tetapi sesudah genap dua tahun, Feliks digantikan oleh Perkius Festus, dan untuk mengambil hati orang Yahudi, ia membiarkan Paulus tetap dalam penjara."
 },
 {
   "id": 27813,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 1,
   "firman": "Tiga hari sesudah tiba di propinsi itu berangkatlah Festus dari Kaisarea ke Yerusalem."
 },
 {
   "id": 27814,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 2,
   "firman": "Di situ imam-imam kepala dan orang-orang Yahudi yang terkemuka datang menghadap dia dan menyampaikan dakwaan terhadap Paulus."
 },
 {
   "id": 27815,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 3,
   "firman": "Kepadanya mereka meminta suatu anugerah, yang merugikan Paulus, yaitu untuk menyuruh Paulus datang ke Yerusalem. Sebab mereka sedang membuat rencana untuk membunuh dia di tengah jalan."
 },
 {
   "id": 27816,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 4,
   "firman": "Tetapi Festus menjawab, bahwa Paulus tetap ditahan di Kaisarea dan bahwa ia sendiri bermaksud untuk segera kembali ke sana."
 },
 {
   "id": 27817,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 5,
   "firman": "Katanya: \"Karena itu baiklah orang-orang yang berwewenang di antara kamu turut ke sana bersama-sama dengan aku dan mengajukan dakwaan terhadap dia, jika ada kesalahannya.\""
 },
 {
   "id": 27818,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 6,
   "firman": "Festus tinggal tidak lebih dari pada delapan atau sepuluh hari di Yerusalem. Sesudah itu ia pulang ke Kaisarea. Pada keesokan harinya ia mengadakan sidang pengadilan, dan menyuruh menghadapkan Paulus."
 },
 {
   "id": 27819,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 7,
   "firman": "Sesudah Paulus tiba di situ, semua orang Yahudi yang datang dari Yerusalem berdiri mengelilinginya dan mereka mengemukakan banyak tuduhan berat terhadap dia yang tidak dapat mereka buktikan."
 },
 {
   "id": 27820,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 8,
   "firman": "Sebaliknya Paulus membela diri, katanya: \"Aku sedikitpun tidak bersalah, baik terhadap hukum Taurat orang Yahudi maupun terhadap Bait Allah atau terhadap Kaisar.\""
 },
 {
   "id": 27821,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 9,
   "firman": "Tetapi Festus yang hendak mengambil hati orang Yahudi, menjawab Paulus, katanya: \"Apakah engkau bersedia pergi ke Yerusalem, supaya engkau dihakimi di sana di hadapanku tentang perkara ini?\""
 },
 {
   "id": 27822,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 10,
   "firman": "Tetapi kata Paulus: \"Aku sekarang berdiri di sini di hadapan pengadilan Kaisar dan di sinilah aku harus dihakimi. Seperti engkau sendiri tahu benar-benar, sedikitpun aku tidak berbuat salah terhadap orang Yahudi."
 },
 {
   "id": 27823,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 11,
   "firman": "Jadi, jika aku benar-benar bersalah dan berbuat sesuatu kejahatan yang setimpal dengan hukuman mati, aku rela mati, tetapi, jika apa yang mereka tuduhkan itu terhadap aku ternyata tidak benar, tidak ada seorangpun yang berhak menyerahkan aku sebagai suatu anugerah kepada mereka. Aku naik banding kepada Kaisar!\""
 },
 {
   "id": 27824,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 12,
   "firman": "Setelah berunding dengan anggota-anggota pengadilan, Festus menjawab: \"Engkau telah naik banding kepada Kaisar, jadi engkau harus pergi menghadap Kaisar.\""
 },
 {
   "id": 27825,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 13,
   "firman": "Beberapa hari kemudian datanglah raja Agripa dengan Bernike ke Kaisarea untuk mengadakan kunjungan kehormatan kepada Festus."
 },
 {
   "id": 27826,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 14,
   "firman": "Karena mereka beberapa hari lamanya tinggal di situ, Festus memaparkan perkara Paulus kepada raja itu, katanya: \"Di sini ada seorang tahanan yang ditinggalkan Feliks pada waktu ia pergi."
 },
 {
   "id": 27827,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 15,
   "firman": "Ketika aku berada di Yerusalem, imam-imam kepala dan tua-tua orang Yahudi mengajukan dakwaan terhadap orang itu dan meminta supaya ia dihukum."
 },
 {
   "id": 27828,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 16,
   "firman": "Aku menjawab mereka, bahwa bukanlah kebiasaan pada orang-orang Roma untuk menyerahkan seorang terdakwa sebagai suatu anugerah sebelum ia dihadapkan dengan orang-orang yang menuduhnya dan diberi kesempatan untuk membela diri terhadap tuduhan itu."
 },
 {
   "id": 27829,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 17,
   "firman": "Karena itu mereka turut bersama-sama dengan aku ke mari. Pada keesokan harinya aku segera mengadakan sidang pengadilan dan menyuruh menghadapkan orang itu."
 },
 {
   "id": 27830,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 18,
   "firman": "Tetapi ketika para pendakwa berdiri di sekelilingnya, mereka tidak mengajukan suatu tuduhanpun tentang perbuatan jahat seperti yang telah aku duga."
 },
 {
   "id": 27831,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 19,
   "firman": "Tetapi mereka hanya berselisih paham dengan dia tentang soal-soal agama mereka, dan tentang seorang bernama Yesus, yang sudah mati, sedangkan Paulus katakan dengan pasti, bahwa Ia hidup."
 },
 {
   "id": 27832,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 20,
   "firman": "Karena aku ragu-ragu bagaimana aku harus memeriksa perkara-perkara seperti itu, aku menanyakan apakah ia mau pergi ke Yerusalem, supaya perkaranya dihakimi di situ."
 },
 {
   "id": 27833,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 21,
   "firman": "Tetapi Paulus naik banding. Ia minta, supaya ia tinggal dalam tahanan dan menunggu, sampai perkaranya diputuskan oleh Kaisar. Karena itu aku menyuruh menahan dia sampai aku dapat mengirim dia kepada Kaisar.\""
 },
 {
   "id": 27834,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 22,
   "firman": "Kata Agripa kepada Festus: \"Aku ingin mendengar orang itu sendiri.\" Jawab Festus: \"Besok engkau akan mendengar dia.\""
 },
 {
   "id": 27835,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 23,
   "firman": "Pada keesokan harinya datanglah Agripa dan Bernike dengan segala kebesaran dan sesudah mereka masuk ruang pengadilan bersama-sama dengan kepala-kepala pasukan dan orang-orang yang terkemuka dari kota itu, Festus memberi perintah, supaya Paulus dihadapkan."
 },
 {
   "id": 27836,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 24,
   "firman": "Festus berkata: \"Ya raja Agripa serta semua yang hadir di sini bersama-sama dengan kami. Lihatlah orang ini, yang dituduh oleh semua orang Yahudi, baik yang di Yerusalem, maupun yang di sini. Mereka telah datang kepadaku dan sambil berteriak-teriak mereka mengatakan, bahwa ia tidak boleh hidup lebih lama."
 },
 {
   "id": 27837,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 25,
   "firman": "Tetapi ternyata kepadaku, bahwa ia tidak berbuat sesuatupun yang setimpal dengan hukuman mati dan karena ia naik banding kepada Kaisar, aku memutuskan untuk mengirim dia menghadap Kaisar."
 },
 {
   "id": 27838,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 26,
   "firman": "Tetapi tidak ada apa-apa yang pasti yang harus kutulis kepada Kaisar tentang dia. Itulah sebabnya aku menghadapkan dia di sini kepada kamu semua, terutama kepadamu, raja Agripa, supaya, setelah diadakan pemeriksaan, aku dapat menuliskan sesuatu."
 },
 {
   "id": 27839,
   "kitab": "Kis",
   "pasal": 25,
   "ayat": 27,
   "firman": "Sebab pada hematku tidaklah wajar untuk mengirim seorang tahanan dengan tidak menyatakan tuduhan-tuduhan yang diajukan terhadap dia.\""
 },
 {
   "id": 27840,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 1,
   "firman": "Kata Agripa kepada Paulus: \"Engkau diberi kesempatan untuk membela diri.\" Paulus memberi isyarat dengan tangannya, lalu memberi pembelaannya seperti berikut:"
 },
 {
   "id": 27841,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 2,
   "firman": "\"Ya raja Agripa, aku merasa berbahagia, karena pada hari ini aku diperkenankan untuk memberi pertanggungan jawab di hadapanmu terhadap segala tuduhan yang diajukan orang-orang Yahudi terhadap diriku,"
 },
 {
   "id": 27842,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 3,
   "firman": "terutama karena engkau tahu benar-benar adat istiadat dan persoalan orang Yahudi. Sebab itu aku minta kepadamu, supaya engkau mendengarkan aku dengan sabar."
 },
 {
   "id": 27843,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 4,
   "firman": "Semua orang Yahudi mengetahui jalan hidupku sejak masa mudaku, sebab dari semula aku hidup di tengah-tengah bangsaku di Yerusalem."
 },
 {
   "id": 27844,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 5,
   "firman": "Sudah lama mereka mengenal aku dan sekiranya mereka mau, mereka dapat memberi kesaksian, bahwa aku telah hidup sebagai seorang Farisi menurut mazhab yang paling keras dalam agama kita."
 },
 {
   "id": 27845,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 6,
   "firman": "Dan sekarang aku harus menghadap pengadilan oleh sebab aku mengharapkan kegenapan janji, yang diberikan Allah kepada nenek moyang kita,"
 },
 {
   "id": 27846,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 7,
   "firman": "dan yang dinantikan oleh kedua belas suku kita, sementara mereka siang malam melakukan ibadahnya dengan tekun. Dan karena pengharapan itulah, ya raja Agripa, aku dituduh orang-orang Yahudi."
 },
 {
   "id": 27847,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 8,
   "firman": "Mengapa kamu menganggap mustahil, bahwa Allah membangkitkan orang mati?"
 },
 {
   "id": 27848,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 9,
   "firman": "Bagaimanapun juga, aku sendiri pernah menyangka, bahwa aku harus keras bertindak menentang nama Yesus dari Nazaret."
 },
 {
   "id": 27849,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 10,
   "firman": "Hal itu kulakukan juga di Yerusalem. Aku bukan saja telah memasukkan banyak orang kudus ke dalam penjara, setelah aku memperoleh kuasa dari imam-imam kepala, tetapi aku juga setuju, jika mereka dihukum mati."
 },
 {
   "id": 27850,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 11,
   "firman": "Dalam rumah-rumah ibadat aku sering menyiksa mereka dan memaksanya untuk menyangkal imannya dan dalam amarah yang meluap-luap aku mengejar mereka, bahkan sampai ke kota-kota asing.\""
 },
 {
   "id": 27851,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 12,
   "firman": "\"Dan dalam keadaan demikian, ketika aku dengan kuasa penuh dan tugas dari imam-imam kepala sedang dalam perjalanan ke Damsyik,"
 },
 {
   "id": 27852,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 13,
   "firman": "tiba-tiba, ya raja Agripa, pada tengah hari bolong aku melihat di tengah jalan itu cahaya yang lebih terang dari pada cahaya matahari, turun dari langit meliputi aku dan teman-teman seperjalananku."
 },
 {
   "id": 27853,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 14,
   "firman": "Kami semua rebah ke tanah dan aku mendengar suatu suara yang mengatakan kepadaku dalam bahasa Ibrani: Saulus, Saulus, mengapa engkau menganiaya Aku? Sukar bagimu menendang ke galah rangsang."
 },
 {
   "id": 27854,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 15,
   "firman": "Tetapi aku menjawab: Siapa Engkau, Tuhan? Kata Tuhan: Akulah Yesus, yang kauaniaya itu."
 },
 {
   "id": 27855,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 16,
   "firman": "Tetapi sekarang, bangunlah dan berdirilah. Aku menampakkan diri kepadamu untuk menetapkan engkau menjadi pelayan dan saksi tentang segala sesuatu yang telah kaulihat dari pada-Ku dan tentang apa yang akan Kuperlihatkan kepadamu nanti."
 },
 {
   "id": 27856,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 17,
   "firman": "Aku akan mengasingkan engkau dari bangsa ini dan dari bangsa-bangsa lain. Dan Aku akan mengutus engkau kepada mereka,"
 },
 {
   "id": 27857,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 18,
   "firman": "untuk membuka mata mereka, supaya mereka berbalik dari kegelapan kepada terang dan dari kuasa Iblis kepada Allah, supaya mereka oleh iman mereka kepada-Ku memperoleh pengampunan dosa dan mendapat bagian dalam apa yang ditentukan untuk orang-orang yang dikuduskan."
 },
 {
   "id": 27858,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 19,
   "firman": "Sebab itu, ya raja Agripa, kepada penglihatan yang dari sorga itu tidak pernah aku tidak taat."
 },
 {
   "id": 27859,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 20,
   "firman": "Tetapi mula-mula aku memberitakan kepada orang-orang Yahudi di Damsyik, di Yerusalem dan di seluruh tanah Yudea, dan juga kepada bangsa-bangsa lain, bahwa mereka harus bertobat dan berbalik kepada Allah serta melakukan pekerjaan-pekerjaan yang sesuai dengan pertobatan itu."
 },
 {
   "id": 27860,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 21,
   "firman": "Karena itulah orang-orang Yahudi menangkap aku di Bait Allah, dan mencoba membunuh aku."
 },
 {
   "id": 27861,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 22,
   "firman": "Tetapi oleh pertolongan Allah aku dapat hidup sampai sekarang dan memberi kesaksian kepada orang-orang kecil dan orang-orang besar. Dan apa yang kuberitakan itu tidak lain dari pada yang sebelumnya telah diberitahukan oleh para nabi dan juga oleh Musa,"
 },
 {
   "id": 27862,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 23,
   "firman": "yaitu, bahwa Mesias harus menderita sengsara dan bahwa Ia adalah yang pertama yang akan bangkit dari antara orang mati, dan bahwa Ia akan memberitakan terang kepada bangsa ini dan kepada bangsa-bangsa lain.\""
 },
 {
   "id": 27863,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 24,
   "firman": "Sementara Paulus mengemukakan semuanya itu untuk mempertanggungjawabkan pekerjaannya, berkatalah Festus dengan suara keras: \"Engkau gila, Paulus! Ilmumu yang banyak itu membuat engkau gila.\""
 },
 {
   "id": 27864,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 25,
   "firman": "Tetapi Paulus menjawab: \"Aku tidak gila, Festus yang mulia! Aku mengatakan kebenaran dengan pikiran yang sehat!"
 },
 {
   "id": 27865,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 26,
   "firman": "Raja juga tahu tentang segala perkara ini, sebab itu aku berani berbicara terus terang kepadanya. Aku yakin, bahwa tidak ada sesuatupun dari semuanya ini yang belum didengarnya, karena perkara ini tidak terjadi di tempat yang terpencil."
 },
 {
   "id": 27866,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 27,
   "firman": "Percayakah engkau, raja Agripa, kepada para nabi? Aku tahu, bahwa engkau percaya kepada mereka.\""
 },
 {
   "id": 27867,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 28,
   "firman": "Jawab Agripa: \"Hampir-hampir saja kauyakinkan aku menjadi orang Kristen!\""
 },
 {
   "id": 27868,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 29,
   "firman": "Kata Paulus: \"Aku mau berdoa kepada Allah, supaya segera atau lama-kelamaan bukan hanya engkau saja, tetapi semua orang lain yang hadir di sini dan yang mendengarkan perkataanku menjadi sama seperti aku, kecuali belenggu-belenggu ini.\""
 },
 {
   "id": 27869,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 30,
   "firman": "Lalu bangkitlah raja dan wali negeri serta Bernike dan semua orang yang duduk bersama-sama mereka."
 },
 {
   "id": 27870,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 31,
   "firman": "Sementara mereka keluar, mereka berkata seorang kepada yang lain: \"Orang itu tidak melakukan sesuatu yang setimpal dengan hukuman mati atau hukuman penjara.\""
 },
 {
   "id": 27871,
   "kitab": "Kis",
   "pasal": 26,
   "ayat": 32,
   "firman": "Kata Agripa kepada Festus: \"Orang itu sebenarnya sudah dapat dibebaskan sekiranya ia tidak naik banding kepada Kaisar.\""
 },
 {
   "id": 27872,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 1,
   "firman": "Setelah diputuskan, bahwa kami akan berlayar ke Italia, maka Paulus dan beberapa orang tahanan lain diserahkan kepada seorang perwira yang bernama Yulius dari pasukan Kaisar."
 },
 {
   "id": 27873,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 2,
   "firman": "Kami naik ke sebuah kapal dari Adramitium yang akan berangkat ke pelabuhan-pelabuhan di sepanjang pantai Asia, lalu kami bertolak. Aristarkhus, seorang Makedonia dari Tesalonika, menyertai kami."
 },
 {
   "id": 27874,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 3,
   "firman": "Pada keesokan harinya kami singgah di Sidon. Yulius memperlakukan Paulus dengan ramah dan memperbolehkannya mengunjungi sahabat-sahabatnya, supaya mereka melengkapkan keperluannya."
 },
 {
   "id": 27875,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 4,
   "firman": "Oleh karena angin sakal kami berlayar dari situ menyusur pantai Siprus."
 },
 {
   "id": 27876,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 5,
   "firman": "Dan setelah mengarungi laut di depan Kilikia dan Pamfilia, sampailah kami di Mira, di daerah Likia."
 },
 {
   "id": 27877,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 6,
   "firman": "Di situ perwira kami menemukan sebuah kapal dari Aleksandria yang hendak berlayar ke Italia. Ia memindahkan kami ke kapal itu."
 },
 {
   "id": 27878,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 7,
   "firman": "Selama beberapa hari berlayar, kami hampir-hampir tidak maju dan dengan susah payah kami mendekati Knidus. Karena angin tetap tidak baik, kami menyusur pantai Kreta melewati tanjung Salmone."
 },
 {
   "id": 27879,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 8,
   "firman": "Sesudah kami dengan susah payah melewati tanjung itu, sampailah kami di sebuah tempat bernama Pelabuhan Indah, dekat kota Lasea."
 },
 {
   "id": 27880,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 9,
   "firman": "Sementara itu sudah banyak waktu yang hilang. Waktu puasa sudah lampau dan sudah berbahaya untuk melanjutkan pelayaran. Sebab itu Paulus memperingatkan mereka, katanya:"
 },
 {
   "id": 27881,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 10,
   "firman": "\"Saudara-saudara, aku lihat, bahwa pelayaran kita akan mendatangkan kesukaran-kesukaran dan kerugian besar, bukan saja bagi muatan dan kapal, tetapi juga bagi nyawa kita.\""
 },
 {
   "id": 27882,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 11,
   "firman": "Tetapi perwira itu lebih percaya kepada jurumudi dan nakhoda dari pada kepada perkataan Paulus."
 },
 {
   "id": 27883,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 12,
   "firman": "Karena pelabuhan itu tidak baik untuk tinggal di situ selama musim dingin, maka kebanyakan dari mereka lebih setuju untuk berlayar terus dan mencoba mencapai kota Feniks untuk tinggal di situ selama musim dingin. Kota Feniks adalah sebuah pelabuhan pulau Kreta, yang terbuka ke arah barat daya dan ke arah barat laut."
 },
 {
   "id": 27884,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 13,
   "firman": "Pada waktu itu angin sepoi-sepoi bertiup dari selatan. Mereka menyangka, bahwa maksud mereka sudah tentu akan tercapai. Mereka membongkar sauh, lalu berlayar dekat sekali menyusur pantai Kreta."
 },
 {
   "id": 27885,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 14,
   "firman": "Tetapi tidak berapa lama kemudian turunlah dari arah pulau itu angin badai, yang disebut angin \"Timur Laut\"."
 },
 {
   "id": 27886,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 15,
   "firman": "Kapal itu dilandanya dan tidak tahan menghadapi angin haluan. Karena itu kami menyerah saja dan membiarkan kapal kami terombang-ambing."
 },
 {
   "id": 27887,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 16,
   "firman": "Kemudian kami hanyut sampai ke pantai sebuah pulau kecil bernama Kauda, dan di situ dengan susah payah kami dapat menguasai sekoci kapal itu."
 },
 {
   "id": 27888,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 17,
   "firman": "Dan setelah sekoci itu dinaikkan ke atas kapal, mereka memasang alat-alat penolong dengan meliliti kapal itu dengan tali. Dan karena takut terdampar di beting Sirtis, mereka menurunkan layar dan membiarkan kapal itu terapung-apung saja."
 },
 {
   "id": 27889,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 18,
   "firman": "Karena kami sangat hebat diombang-ambingkan angin badai, maka pada keesokan harinya mereka mulai membuang muatan kapal ke laut."
 },
 {
   "id": 27890,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 19,
   "firman": "Dan pada hari yang ketiga mereka membuang alat-alat kapal dengan tangan mereka sendiri."
 },
 {
   "id": 27891,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 20,
   "firman": "Setelah beberapa hari lamanya baik matahari maupun bintang-bintang tidak kelihatan, dan angin badai yang dahsyat terus-menerus mengancam kami, akhirnya putuslah segala harapan kami untuk dapat menyelamatkan diri kami."
 },
 {
   "id": 27892,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 21,
   "firman": "Dan karena mereka beberapa lamanya tidak makan, berdirilah Paulus di tengah-tengah mereka dan berkata: \"Saudara-saudara, jika sekiranya nasihatku dituruti, supaya kita jangan berlayar dari Kreta, kita pasti terpelihara dari kesukaran dan kerugian ini!"
 },
 {
   "id": 27893,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 22,
   "firman": "Tetapi sekarang, juga dalam kesukaran ini, aku menasihatkan kamu, supaya kamu tetap bertabah hati, sebab tidak seorangpun di antara kamu yang akan binasa, kecuali kapal ini."
 },
 {
   "id": 27894,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 23,
   "firman": "Karena tadi malam seorang malaikat dari Allah, yaitu dari Allah yang aku sembah sebagai milik-Nya, berdiri di sisiku,"
 },
 {
   "id": 27895,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 24,
   "firman": "dan ia berkata: Jangan takut, Paulus! Engkau harus menghadap Kaisar; dan sesungguhnya oleh karunia Allah, maka semua orang yang ada bersama-sama dengan engkau di kapal ini akan selamat karena engkau."
 },
 {
   "id": 27896,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 25,
   "firman": "Sebab itu tabahkanlah hatimu, saudara-saudara! Karena aku percaya kepada Allah, bahwa semuanya pasti terjadi sama seperti yang dinyatakan kepadaku."
 },
 {
   "id": 27897,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 26,
   "firman": "Namun kita harus mendamparkan kapal ini di salah satu pulau.\""
 },
 {
   "id": 27898,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 27,
   "firman": "Malam yang keempat belas sudah tiba dan kami masih tetap terombang-ambing di laut Adria. Tetapi kira-kira tengah malam anak-anak kapal merasa, bahwa mereka telah dekat daratan."
 },
 {
   "id": 27899,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 28,
   "firman": "Lalu mereka mengulurkan batu duga, dan ternyata air di situ dua puluh depa dalamnya. Setelah maju sedikit mereka menduga lagi dan ternyata lima belas depa."
 },
 {
   "id": 27900,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 29,
   "firman": "Dan karena takut, bahwa kami akan terkandas di salah satu batu karang, mereka membuang empat sauh di buritan, dan kami sangat berharap mudah-mudahan hari lekas siang."
 },
 {
   "id": 27901,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 30,
   "firman": "Akan tetapi anak-anak kapal berusaha untuk melarikan diri dari kapal. Mereka menurunkan sekoci, dan berbuat seolah-olah mereka hendak melabuhkan beberapa sauh di haluan."
 },
 {
   "id": 27902,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 31,
   "firman": "Karena itu Paulus berkata kepada perwira dan prajurit-prajuritnya: \"Jika mereka tidak tinggal di kapal, kamu tidak mungkin selamat.\""
 },
 {
   "id": 27903,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 32,
   "firman": "Lalu prajurit-prajurit itu memotong tali sekoci dan membiarkannya hanyut."
 },
 {
   "id": 27904,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 33,
   "firman": "Ketika hari menjelang siang, Paulus mengajak semua orang untuk makan, katanya: \"Sudah empat belas hari lamanya kamu menanti-nanti saja, menahan lapar dan tidak makan apa-apa."
 },
 {
   "id": 27905,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 34,
   "firman": "Karena itu aku menasihati kamu, supaya kamu makan dahulu. Hal itu perlu untuk keselamatanmu. Tidak seorangpun di antara kamu akan kehilangan sehelaipun dari rambut kepalanya.\""
 },
 {
   "id": 27906,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 35,
   "firman": "Sesudah berkata demikian, ia mengambil roti, mengucap syukur kepada Allah di hadapan semua mereka, memecah-mecahkannya, lalu mulai makan."
 },
 {
   "id": 27907,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 36,
   "firman": "Maka kuatlah hati semua orang itu, dan merekapun makan juga."
 },
 {
   "id": 27908,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 37,
   "firman": "Jumlah kami semua yang di kapal itu dua ratus tujuh puluh enam jiwa."
 },
 {
   "id": 27909,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 38,
   "firman": "Setelah makan kenyang, mereka membuang muatan gandum ke laut untuk meringankan kapal itu."
 },
 {
   "id": 27910,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 39,
   "firman": "Dan ketika hari mulai siang, mereka melihat suatu teluk yang rata pantainya. Walaupun mereka tidak mengenal daratan itu, mereka memutuskan untuk sedapat mungkin mendamparkan kapal itu ke situ."
 },
 {
   "id": 27911,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 40,
   "firman": "Mereka melepaskan tali-tali sauh, lalu meninggalkan sauh-sauh itu di dasar laut. Sementara itu mereka mengulurkan tali-tali kemudi, memasang layar topang, supaya angin meniup kapal itu menuju pantai."
 },
 {
   "id": 27912,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 41,
   "firman": "Tetapi mereka melanggar busung pasir, dan terkandaslah kapal itu. Haluannya terpancang dan tidak dapat bergerak dan buritannya hancur dipukul oleh gelombang yang hebat."
 },
 {
   "id": 27913,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 42,
   "firman": "Pada waktu itu prajurit-prajurit bermaksud untuk membunuh tahanan-tahanan, supaya jangan ada seorangpun yang melarikan diri dengan berenang."
 },
 {
   "id": 27914,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 43,
   "firman": "Tetapi perwira itu ingin menyelamatkan Paulus. Karena itu ia menggagalkan maksud mereka, dan memerintahkan, supaya orang-orang yang pandai berenang lebih dahulu terjun ke laut dan naik ke darat,"
 },
 {
   "id": 27915,
   "kitab": "Kis",
   "pasal": 27,
   "ayat": 44,
   "firman": "dan supaya orang-orang lain menyusul dengan mempergunakan papan atau pecahan-pecahan kapal. Demikianlah mereka semua selamat naik ke darat."
 },
 {
   "id": 27916,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 1,
   "firman": "Setelah kami tiba dengan selamat di pantai, barulah kami tahu, bahwa daratan itu adalah pulau Malta."
 },
 {
   "id": 27917,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 2,
   "firman": "Penduduk pulau itu sangat ramah terhadap kami. Mereka menyalakan api besar dan mengajak kami semua ke situ karena telah mulai hujan dan hawanya dingin."
 },
 {
   "id": 27918,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 3,
   "firman": "Ketika Paulus memungut seberkas ranting-ranting dan meletakkannya di atas api, keluarlah seekor ular beludak karena panasnya api itu, lalu menggigit tangannya."
 },
 {
   "id": 27919,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 4,
   "firman": "Ketika orang-orang itu melihat ular itu terpaut pada tangan Paulus, mereka berkata seorang kepada yang lain: \"Orang ini sudah pasti seorang pembunuh, sebab, meskipun ia telah luput dari laut, ia tidak dibiarkan hidup oleh Dewi Keadilan.\""
 },
 {
   "id": 27920,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 5,
   "firman": "Tetapi Paulus mengibaskan ular itu ke dalam api, dan ia sama sekali tidak menderita sesuatu."
 },
 {
   "id": 27921,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 6,
   "firman": "Namun mereka menyangka, bahwa ia akan bengkak atau akan mati rebah seketika itu juga. Tetapi sesudah lama menanti-nanti, mereka melihat, bahwa tidak ada apa-apa yang terjadi padanya, maka sebaliknya mereka berpendapat, bahwa ia seorang dewa."
 },
 {
   "id": 27922,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 7,
   "firman": "Tidak jauh dari tempat itu ada tanah milik gubernur pulau itu. Gubernur itu namanya Publius. Ia menyambut kami dan menjamu kami dengan ramahnya selama tiga hari."
 },
 {
   "id": 27923,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 8,
   "firman": "Ketika itu ayah Publius terbaring karena sakit demam dan disentri. Paulus masuk ke kamarnya; ia berdoa serta menumpangkan tangan ke atasnya dan menyembuhkan dia."
 },
 {
   "id": 27924,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 9,
   "firman": "Sesudah peristiwa itu datanglah juga orang-orang sakit lain dari pulau itu dan merekapun disembuhkan juga."
 },
 {
   "id": 27925,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 10,
   "firman": "Mereka sangat menghormati kami dan ketika kami bertolak, mereka menyediakan segala sesuatu yang kami perlukan."
 },
 {
   "id": 27926,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 11,
   "firman": "Tiga bulan kemudian kami berangkat dari situ naik sebuah kapal dari Aleksandria yang selama musim dingin berlabuh di pulau itu. Kapal itu memakai lambang Dioskuri."
 },
 {
   "id": 27927,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 12,
   "firman": "Kami singgah di Sirakusa dan tinggal di situ tiga hari lamanya."
 },
 {
   "id": 27928,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 13,
   "firman": "Dari situ kami menyusur pantai, lalu sampai ke Regium. Sehari kemudian bertiuplah angin selatan dan pada hari kedua sampailah kami di Putioli."
 },
 {
   "id": 27929,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 14,
   "firman": "Di situ kami berjumpa dengan anggota-anggota jemaat, dan atas undangan mereka kami tinggal tujuh hari bersama-sama mereka. Sesudah itu kami berangkat ke Roma."
 },
 {
   "id": 27930,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 15,
   "firman": "Saudara-saudara yang di sana telah mendengar tentang hal ihwal kami dan mereka datang menjumpai kami sampai ke Forum Apius dan Tres Taberne. Ketika Paulus melihat mereka, ia mengucap syukur kepada Allah lalu kuatlah hatinya."
 },
 {
   "id": 27931,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 16,
   "firman": "Setelah kami tiba di Roma, Paulus diperbolehkan tinggal dalam rumah sendiri bersama-sama seorang prajurit yang mengawalnya."
 },
 {
   "id": 27932,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 17,
   "firman": "Tiga hari kemudian Paulus memanggil orang-orang terkemuka bangsa Yahudi dan setelah mereka berkumpul, Paulus berkata: \"Saudara-saudara, meskipun aku tidak berbuat kesalahan terhadap bangsa kita atau terhadap adat istiadat nenek moyang kita, namun aku ditangkap di Yerusalem dan diserahkan kepada orang-orang Roma."
 },
 {
   "id": 27933,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 18,
   "firman": "Setelah aku diperiksa, mereka bermaksud melepaskan aku, karena tidak terdapat suatu kesalahanpun padaku yang setimpal dengan hukuman mati."
 },
 {
   "id": 27934,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 19,
   "firman": "Akan tetapi orang-orang Yahudi menentangnya dan karena itu terpaksalah aku naik banding kepada Kaisar, tetapi bukan dengan maksud untuk mengadukan bangsaku."
 },
 {
   "id": 27935,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 20,
   "firman": "Itulah sebabnya aku meminta, supaya aku melihat kamu dan berbicara dengan kamu, sebab justru karena pengharapan Israellah aku diikat dengan belenggu ini.\""
 },
 {
   "id": 27936,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 21,
   "firman": "Akan tetapi mereka berkata kepadanya: \"Kami tidak menerima surat-surat dari Yudea tentang engkau dan juga tidak seorangpun dari saudara-saudara kita datang memberitakan apa-apa yang jahat mengenai engkau."
 },
 {
   "id": 27937,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 22,
   "firman": "Tetapi kami ingin mendengar dari engkau, bagaimana pikiranmu, sebab tentang mazhab ini kami tahu, bahwa di mana-manapun ia mendapat perlawanan.\""
 },
 {
   "id": 27938,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 23,
   "firman": "Lalu mereka menentukan suatu hari untuk Paulus. Pada hari yang ditentukan itu datanglah mereka dalam jumlah besar ke tempat tumpangannya. Ia menerangkan dan memberi kesaksian kepada mereka tentang Kerajaan Allah; dan berdasarkan hukum Musa dan kitab para nabi ia berusaha meyakinkan mereka tentang Yesus. Hal itu berlangsung dari pagi sampai sore."
 },
 {
   "id": 27939,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 24,
   "firman": "Ada yang dapat diyakinkan oleh perkataannya, ada yang tetap tidak percaya."
 },
 {
   "id": 27940,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 25,
   "firman": "Maka bubarlah pertemuan itu dengan tidak ada kesesuaian di antara mereka. Tetapi Paulus masih mengatakan perkataan yang satu ini: \"Tepatlah firman yang disampaikan Roh Kudus kepada nenek moyang kita dengan perantaraan nabi Yesaya:"
 },
 {
   "id": 27941,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 26,
   "firman": "Pergilah kepada bangsa ini, dan katakanlah: Kamu akan mendengar dan mendengar, namun tidak mengerti, kamu akan melihat dan melihat, namun tidak menanggap."
 },
 {
   "id": 27942,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 27,
   "firman": "Sebab hati bangsa ini telah menebal, dan telinganya berat mendengar, dan matanya melekat tertutup; supaya jangan mereka melihat dengan matanya dan mendengar dengan telinganya dan mengerti dengan hatinya, lalu berbalik sehingga Aku menyembuhkan mereka."
 },
 {
   "id": 27943,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 28,
   "firman": "Sebab itu kamu harus tahu, bahwa keselamatan yang dari pada Allah ini disampaikan kepada bangsa-bangsa lain dan mereka akan mendengarnya.\""
 },
 {
   "id": 27944,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 29,
   "firman": "(Dan setelah Paulus berkata demikian, pergilah orang-orang Yahudi itu dengan banyak perbedaan paham antara mereka.)"
 },
 {
   "id": 27945,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 30,
   "firman": "Dan Paulus tinggal dua tahun penuh di rumah yang disewanya sendiri itu; ia menerima semua orang yang datang kepadanya."
 },
 {
   "id": 27946,
   "kitab": "Kis",
   "pasal": 28,
   "ayat": 31,
   "firman": "Dengan terus terang dan tanpa rintangan apa-apa ia memberitakan Kerajaan Allah dan mengajar tentang Tuhan Yesus Kristus."
 },
 {
   "id": 27947,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, hamba Kristus Yesus, yang dipanggil menjadi rasul dan dikuduskan untuk memberitakan Injil Allah."
 },
 {
   "id": 27948,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 2,
   "firman": "Injil itu telah dijanjikan-Nya sebelumnya dengan perantaraan nabi-nabi-Nya dalam kitab-kitab suci,"
 },
 {
   "id": 27949,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 3,
   "firman": "tentang Anak-Nya, yang menurut daging diperanakkan dari keturunan Daud,"
 },
 {
   "id": 27950,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 4,
   "firman": "dan menurut Roh kekudusan dinyatakan oleh kebangkitan-Nya dari antara orang mati, bahwa Ia adalah Anak Allah yang berkuasa, Yesus Kristus Tuhan kita."
 },
 {
   "id": 27951,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dengan perantaraan-Nya kami menerima kasih karunia dan jabatan rasul untuk menuntun semua bangsa, supaya mereka percaya dan taat kepada nama-Nya."
 },
 {
   "id": 27952,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kamu juga termasuk di antara mereka, kamu yang telah dipanggil menjadi milik Kristus."
 },
 {
   "id": 27953,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 7,
   "firman": "Kepada kamu sekalian yang tinggal di Roma, yang dikasihi Allah, yang dipanggil dan dijadikan orang-orang kudus: Kasih karunia menyertai kamu dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus."
 },
 {
   "id": 27954,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 8,
   "firman": "Pertama-tama aku mengucap syukur kepada Allahku oleh Yesus Kristus atas kamu sekalian, sebab telah tersiar kabar tentang imanmu di seluruh dunia."
 },
 {
   "id": 27955,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 9,
   "firman": "Karena Allah, yang kulayani dengan segenap hatiku dalam pemberitaan Injil Anak-Nya, adalah saksiku, bahwa dalam doaku aku selalu mengingat kamu:"
 },
 {
   "id": 27956,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 10,
   "firman": "Aku berdoa, semoga dengan kehendak Allah aku akhirnya beroleh kesempatan untuk mengunjungi kamu."
 },
 {
   "id": 27957,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab aku ingin melihat kamu untuk memberikan karunia rohani kepadamu guna menguatkan kamu,"
 },
 {
   "id": 27958,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 12,
   "firman": "yaitu, supaya aku ada di antara kamu dan turut terhibur oleh iman kita bersama, baik oleh imanmu maupun oleh imanku."
 },
 {
   "id": 27959,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 13,
   "firman": "Saudara-saudara, aku mau, supaya kamu mengetahui, bahwa aku telah sering berniat untuk datang kepadamu--tetapi hingga kini selalu aku terhalang--agar di tengah-tengahmu aku menemukan buah, seperti juga di tengah-tengah bangsa bukan Yahudi yang lain."
 },
 {
   "id": 27960,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 14,
   "firman": "Aku berhutang baik kepada orang Yunani, maupun kepada orang bukan Yunani, baik kepada orang terpelajar, maupun kepada orang tidak terpelajar."
 },
 {
   "id": 27961,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 15,
   "firman": "Itulah sebabnya aku ingin untuk memberitakan Injil kepada kamu juga yang diam di Roma."
 },
 {
   "id": 27962,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 16,
   "firman": "Sebab aku mempunyai keyakinan yang kokoh dalam Injil, karena Injil adalah kekuatan Allah yang menyelamatkan setiap orang yang percaya, pertama-tama orang Yahudi, tetapi juga orang Yunani."
 },
 {
   "id": 27963,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sebab di dalamnya nyata kebenaran Allah, yang bertolak dari iman dan memimpin kepada iman, seperti ada tertulis: \"Orang benar akan hidup oleh iman.\""
 },
 {
   "id": 27964,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sebab murka Allah nyata dari sorga atas segala kefasikan dan kelaliman manusia, yang menindas kebenaran dengan kelaliman."
 },
 {
   "id": 27965,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena apa yang dapat mereka ketahui tentang Allah nyata bagi mereka, sebab Allah telah menyatakannya kepada mereka."
 },
 {
   "id": 27966,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 20,
   "firman": "Sebab apa yang tidak nampak dari pada-Nya, yaitu kekuatan-Nya yang kekal dan keilahian-Nya, dapat nampak kepada pikiran dari karya-Nya sejak dunia diciptakan, sehingga mereka tidak dapat berdalih."
 },
 {
   "id": 27967,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 21,
   "firman": "Sebab sekalipun mereka mengenal Allah, mereka tidak memuliakan Dia sebagai Allah atau mengucap syukur kepada-Nya. Sebaliknya pikiran mereka menjadi sia-sia dan hati mereka yang bodoh menjadi gelap."
 },
 {
   "id": 27968,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 22,
   "firman": "Mereka berbuat seolah-olah mereka penuh hikmat, tetapi mereka telah menjadi bodoh."
 },
 {
   "id": 27969,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 23,
   "firman": "Mereka menggantikan kemuliaan Allah yang tidak fana dengan gambaran yang mirip dengan manusia yang fana, burung-burung, binatang-binatang yang berkaki empat atau binatang-binatang yang menjalar."
 },
 {
   "id": 27970,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 24,
   "firman": "Karena itu Allah menyerahkan mereka kepada keinginan hati mereka akan kecemaran, sehingga mereka saling mencemarkan tubuh mereka."
 },
 {
   "id": 27971,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 25,
   "firman": "Sebab mereka menggantikan kebenaran Allah dengan dusta dan memuja dan menyembah makhluk dengan melupakan Penciptanya yang harus dipuji selama-lamanya, amin."
 },
 {
   "id": 27972,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 26,
   "firman": "Karena itu Allah menyerahkan mereka kepada hawa nafsu yang memalukan, sebab isteri-isteri mereka menggantikan persetubuhan yang wajar dengan yang tak wajar."
 },
 {
   "id": 27973,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 27,
   "firman": "Demikian juga suami-suami meninggalkan persetubuhan yang wajar dengan isteri mereka dan menyala-nyala dalam berahi mereka seorang terhadap yang lain, sehingga mereka melakukan kemesuman, laki-laki dengan laki-laki, dan karena itu mereka menerima dalam diri mereka balasan yang setimpal untuk kesesatan mereka."
 },
 {
   "id": 27974,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 28,
   "firman": "Dan karena mereka tidak merasa perlu untuk mengakui Allah, maka Allah menyerahkan mereka kepada pikiran-pikiran yang terkutuk, sehingga mereka melakukan apa yang tidak pantas:"
 },
 {
   "id": 27975,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 29,
   "firman": "penuh dengan rupa-rupa kelaliman, kejahatan, keserakahan dan kebusukan, penuh dengan dengki, pembunuhan, perselisihan, tipu muslihat dan kefasikan."
 },
 {
   "id": 27976,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 30,
   "firman": "Mereka adalah pengumpat, pemfitnah, pembenci Allah, kurang ajar, congkak, sombong, pandai dalam kejahatan, tidak taat kepada orang tua,"
 },
 {
   "id": 27977,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 31,
   "firman": "tidak berakal, tidak setia, tidak penyayang, tidak mengenal belas kasihan."
 },
 {
   "id": 27978,
   "kitab": "Rom",
   "pasal": 1,
   "ayat": 32,
   "firman": "Sebab walaupun mereka mengetahui tuntutan-tuntutan hukum Allah, yaitu bahwa setiap orang yang melakukan hal-hal demikian, patut dihukum mati, mereka bukan saja melakukannya sendiri, tetapi mereka juga setuju dengan mereka yang melakukannya."
 },
 {
   "id": 27979,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 1,
   "firman": "Karena itu, hai manusia, siapapun juga engkau, yang menghakimi orang lain, engkau sendiri tidak bebas dari salah. Sebab, dalam menghakimi orang lain, engkau menghakimi dirimu sendiri, karena engkau yang menghakimi orang lain, melakukan hal-hal yang sama."
 },
 {
   "id": 27980,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tetapi kita tahu, bahwa hukuman Allah berlangsung secara jujur atas mereka yang berbuat demikian."
 },
 {
   "id": 27981,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan engkau, hai manusia, engkau yang menghakimi mereka yang berbuat demikian, sedangkan engkau sendiri melakukannya juga, adakah engkau sangka, bahwa engkau akan luput dari hukuman Allah?"
 },
 {
   "id": 27982,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 4,
   "firman": "Maukah engkau menganggap sepi kekayaan kemurahan-Nya, kesabaran-Nya dan kelapangan hati-Nya? Tidakkah engkau tahu, bahwa maksud kemurahan Allah ialah menuntun engkau kepada pertobatan?"
 },
 {
   "id": 27983,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi oleh kekerasan hatimu yang tidak mau bertobat, engkau menimbun murka atas dirimu sendiri pada hari waktu mana murka dan hukuman Allah yang adil akan dinyatakan."
 },
 {
   "id": 27984,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ia akan membalas setiap orang menurut perbuatannya,"
 },
 {
   "id": 27985,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 7,
   "firman": "yaitu hidup kekal kepada mereka yang dengan tekun berbuat baik, mencari kemuliaan, kehormatan dan ketidakbinasaan,"
 },
 {
   "id": 27986,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 8,
   "firman": "tetapi murka dan geram kepada mereka yang mencari kepentingan sendiri, yang tidak taat kepada kebenaran, melainkan taat kepada kelaliman."
 },
 {
   "id": 27987,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 9,
   "firman": "Penderitaan dan kesesakan akan menimpa setiap orang yang hidup yang berbuat jahat, pertama-tama orang Yahudi dan juga orang Yunani,"
 },
 {
   "id": 27988,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 10,
   "firman": "tetapi kemuliaan, kehormatan dan damai sejahtera akan diperoleh semua orang yang berbuat baik, pertama-tama orang Yahudi, dan juga orang Yunani."
 },
 {
   "id": 27989,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 11,
   "firman": "Sebab Allah tidak memandang bulu."
 },
 {
   "id": 27990,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 12,
   "firman": "Sebab semua orang yang berdosa tanpa hukum Taurat akan binasa tanpa hukum Taurat; dan semua orang yang berdosa di bawah hukum Taurat akan dihakimi oleh hukum Taurat."
 },
 {
   "id": 27991,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 13,
   "firman": "Karena bukanlah orang yang mendengar hukum Taurat yang benar di hadapan Allah, tetapi orang yang melakukan hukum Tauratlah yang akan dibenarkan."
 },
 {
   "id": 27992,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 14,
   "firman": "Apabila bangsa-bangsa lain yang tidak memiliki hukum Taurat oleh dorongan diri sendiri melakukan apa yang dituntut hukum Taurat, maka, walaupun mereka tidak memiliki hukum Taurat, mereka menjadi hukum Taurat bagi diri mereka sendiri."
 },
 {
   "id": 27993,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 15,
   "firman": "Sebab dengan itu mereka menunjukkan, bahwa isi hukum Taurat ada tertulis di dalam hati mereka dan suara hati mereka turut bersaksi dan pikiran mereka saling menuduh atau saling membela."
 },
 {
   "id": 27994,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 16,
   "firman": "Hal itu akan nampak pada hari, bilamana Allah, sesuai dengan Injil yang kuberitakan, akan menghakimi segala sesuatu yang tersembunyi dalam hati manusia, oleh Kristus Yesus."
 },
 {
   "id": 27995,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi, jika kamu menyebut dirimu orang Yahudi dan bersandar kepada hukum Taurat, bermegah dalam Allah,"
 },
 {
   "id": 27996,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 18,
   "firman": "dan tahu akan kehendak-Nya, dan oleh karena diajar dalam hukum Taurat, dapat tahu mana yang baik dan mana yang tidak,"
 },
 {
   "id": 27997,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 19,
   "firman": "dan yakin, bahwa engkau adalah penuntun orang buta dan terang bagi mereka yang di dalam kegelapan,"
 },
 {
   "id": 27998,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 20,
   "firman": "pendidik orang bodoh, dan pengajar orang yang belum dewasa, karena dalam hukum Taurat engkau memiliki kegenapan segala kepandaian dan kebenaran."
 },
 {
   "id": 27999,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 21,
   "firman": "Jadi, bagaimanakah engkau yang mengajar orang lain, tidakkah engkau mengajar dirimu sendiri? Engkau yang mengajar: \"Jangan mencuri,\" mengapa engkau sendiri mencuri?"
 },
 {
   "id": 28000,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 22,
   "firman": "Engkau yang berkata: \"Jangan berzinah,\" mengapa engkau sendiri berzinah? Engkau yang jijik akan segala berhala, mengapa engkau sendiri merampok rumah berhala?"
 },
 {
   "id": 28001,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 23,
   "firman": "Engkau bermegah atas hukum Taurat, mengapa engkau sendiri menghina Allah dengan melanggar hukum Taurat itu?"
 },
 {
   "id": 28002,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 24,
   "firman": "Seperti ada tertulis: \"Sebab oleh karena kamulah nama Allah dihujat di antara bangsa-bangsa lain.\""
 },
 {
   "id": 28003,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 25,
   "firman": "Sunat memang ada gunanya, jika engkau mentaati hukum Taurat; tetapi jika engkau melanggar hukum Taurat, maka sunatmu tidak ada lagi gunanya."
 },
 {
   "id": 28004,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 26,
   "firman": "Jadi jika orang yang tak bersunat memperhatikan tuntutan-tuntutan hukum Taurat, tidakkah ia dianggap sama dengan orang yang telah disunat?"
 },
 {
   "id": 28005,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 27,
   "firman": "Jika demikian, maka orang yang tak bersunat, tetapi yang melakukan hukum Taurat, akan menghakimi kamu yang mempunyai hukum tertulis dan sunat, tetapi yang melanggar hukum Taurat."
 },
 {
   "id": 28006,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 28,
   "firman": "Sebab yang disebut Yahudi bukanlah orang yang lahiriah Yahudi, dan yang disebut sunat, bukanlah sunat yang dilangsungkan secara lahiriah."
 },
 {
   "id": 28007,
   "kitab": "Rom",
   "pasal": 2,
   "ayat": 29,
   "firman": "Tetapi orang Yahudi sejati ialah dia yang tidak nampak keyahudiannya dan sunat ialah sunat di dalam hati, secara rohani, bukan secara hurufiah. Maka pujian baginya datang bukan dari manusia, melainkan dari Allah."
 },
 {
   "id": 28008,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 1,
   "firman": "Jika demikian, apakah kelebihan orang Yahudi dan apakah gunanya sunat?"
 },
 {
   "id": 28009,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 2,
   "firman": "Banyak sekali, dan di dalam segala hal. Pertama-tama: sebab kepada merekalah dipercayakan firman Allah."
 },
 {
   "id": 28010,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 3,
   "firman": "Jadi bagaimana, jika di antara mereka ada yang tidak setia, dapatkah ketidaksetiaan itu membatalkan kesetiaan Allah?"
 },
 {
   "id": 28011,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sekali-kali tidak! Sebaliknya: Allah adalah benar, dan semua manusia pembohong, seperti ada tertulis: \"Supaya Engkau ternyata benar dalam segala firman-Mu, dan menang, jika Engkau dihakimi.\""
 },
 {
   "id": 28012,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 5,
   "firman": "Tetapi jika ketidakbenaran kita menunjukkan kebenaran Allah, apakah yang akan kita katakan? Tidak adilkah Allah--aku berkata sebagai manusia--jika Ia menampakkan murka-Nya?"
 },
 {
   "id": 28013,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sekali-kali tidak! Andaikata demikian, bagaimanakah Allah dapat menghakimi dunia?"
 },
 {
   "id": 28014,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 7,
   "firman": "Tetapi jika kebenaran Allah oleh dustaku semakin melimpah bagi kemuliaan-Nya, mengapa aku masih dihakimi lagi sebagai orang berdosa?"
 },
 {
   "id": 28015,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 8,
   "firman": "Bukankah tidak benar fitnahan orang yang mengatakan, bahwa kita berkata: \"Marilah kita berbuat yang jahat, supaya yang baik timbul dari padanya.\" Orang semacam itu sudah selayaknya mendapat hukuman."
 },
 {
   "id": 28016,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 9,
   "firman": "Jadi bagaimana? Adakah kita mempunyai kelebihan dari pada orang lain? Sama sekali tidak. Sebab di atas telah kita tuduh baik orang Yahudi, maupun orang Yunani, bahwa mereka semua ada di bawah kuasa dosa,"
 },
 {
   "id": 28017,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 10,
   "firman": "seperti ada tertulis: \"Tidak ada yang benar, seorangpun tidak."
 },
 {
   "id": 28018,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 11,
   "firman": "Tidak ada seorangpun yang berakal budi, tidak ada seorangpun yang mencari Allah."
 },
 {
   "id": 28019,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 12,
   "firman": "Semua orang telah menyeleweng, mereka semua tidak berguna, tidak ada yang berbuat baik, seorangpun tidak."
 },
 {
   "id": 28020,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 13,
   "firman": "Kerongkongan mereka seperti kubur yang ternganga, lidah mereka merayu-rayu, bibir mereka mengandung bisa."
 },
 {
   "id": 28021,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 14,
   "firman": "Mulut mereka penuh dengan sumpah serapah,"
 },
 {
   "id": 28022,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 15,
   "firman": "kaki mereka cepat untuk menumpahkan darah."
 },
 {
   "id": 28023,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 16,
   "firman": "Keruntuhan dan kebinasaan mereka tinggalkan di jalan mereka,"
 },
 {
   "id": 28024,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 17,
   "firman": "dan jalan damai tidak mereka kenal;"
 },
 {
   "id": 28025,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 18,
   "firman": "rasa takut kepada Allah tidak ada pada orang itu.\""
 },
 {
   "id": 28026,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 19,
   "firman": "Tetapi kita tahu, bahwa segala sesuatu yang tercantum dalam Kitab Taurat ditujukan kepada mereka yang hidup di bawah hukum Taurat, supaya tersumbat setiap mulut dan seluruh dunia jatuh ke bawah hukuman Allah."
 },
 {
   "id": 28027,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 20,
   "firman": "Sebab tidak seorangpun yang dapat dibenarkan di hadapan Allah oleh karena melakukan hukum Taurat, karena justru oleh hukum Taurat orang mengenal dosa."
 },
 {
   "id": 28028,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 21,
   "firman": "Tetapi sekarang, tanpa hukum Taurat kebenaran Allah telah dinyatakan, seperti yang disaksikan dalam Kitab Taurat dan Kitab-kitab para nabi,"
 },
 {
   "id": 28029,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 22,
   "firman": "yaitu kebenaran Allah karena iman dalam Yesus Kristus bagi semua orang yang percaya. Sebab tidak ada perbedaan."
 },
 {
   "id": 28030,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 23,
   "firman": "Karena semua orang telah berbuat dosa dan telah kehilangan kemuliaan Allah,"
 },
 {
   "id": 28031,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 24,
   "firman": "dan oleh kasih karunia telah dibenarkan dengan cuma-cuma karena penebusan dalam Kristus Yesus."
 },
 {
   "id": 28032,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 25,
   "firman": "Kristus Yesus telah ditentukan Allah menjadi jalan pendamaian karena iman, dalam darah-Nya. Hal ini dibuat-Nya untuk menunjukkan keadilan-Nya, karena Ia telah membiarkan dosa-dosa yang telah terjadi dahulu pada masa kesabaran-Nya."
 },
 {
   "id": 28033,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 26,
   "firman": "Maksud-Nya ialah untuk menunjukkan keadilan-Nya pada masa ini, supaya nyata, bahwa Ia benar dan juga membenarkan orang yang percaya kepada Yesus."
 },
 {
   "id": 28034,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 27,
   "firman": "Jika demikian, apakah dasarnya untuk bermegah? Tidak ada! Berdasarkan apa? Berdasarkan perbuatan? Tidak, melainkan berdasarkan iman!"
 },
 {
   "id": 28035,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 28,
   "firman": "Karena kami yakin, bahwa manusia dibenarkan karena iman, dan bukan karena ia melakukan hukum Taurat."
 },
 {
   "id": 28036,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 29,
   "firman": "Atau adakah Allah hanya Allah orang Yahudi saja? Bukankah Ia juga adalah Allah bangsa-bangsa lain? Ya, benar. Ia juga adalah Allah bangsa-bangsa lain!"
 },
 {
   "id": 28037,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 30,
   "firman": "Artinya, kalau ada satu Allah, yang akan membenarkan baik orang-orang bersunat karena iman, maupun orang-orang tak bersunat juga karena iman."
 },
 {
   "id": 28038,
   "kitab": "Rom",
   "pasal": 3,
   "ayat": 31,
   "firman": "Jika demikian, adakah kami membatalkan hukum Taurat karena iman? Sama sekali tidak! Sebaliknya, kami meneguhkannya."
 },
 {
   "id": 28039,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 1,
   "firman": "Jadi apakah akan kita katakan tentang Abraham, bapa leluhur jasmani kita?"
 },
 {
   "id": 28040,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 2,
   "firman": "Sebab jikalau Abraham dibenarkan karena perbuatannya, maka ia beroleh dasar untuk bermegah, tetapi tidak di hadapan Allah."
 },
 {
   "id": 28041,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sebab apakah dikatakan nas Kitab Suci? \"Lalu percayalah Abraham kepada Tuhan, dan Tuhan memperhitungkan hal itu kepadanya sebagai kebenaran.\""
 },
 {
   "id": 28042,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 4,
   "firman": "Kalau ada orang yang bekerja, upahnya tidak diperhitungkan sebagai hadiah, tetapi sebagai haknya."
 },
 {
   "id": 28043,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 5,
   "firman": "Tetapi kalau ada orang yang tidak bekerja, namun percaya kepada Dia yang membenarkan orang durhaka, imannya diperhitungkan menjadi kebenaran."
 },
 {
   "id": 28044,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 6,
   "firman": "Seperti juga Daud menyebut berbahagia orang yang dibenarkan Allah bukan berdasarkan perbuatannya:"
 },
 {
   "id": 28045,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 7,
   "firman": "\"Berbahagialah orang yang diampuni pelanggaran-pelanggarannya, dan yang ditutupi dosa-dosanya;"
 },
 {
   "id": 28046,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 8,
   "firman": "berbahagialah manusia yang kesalahannya tidak diperhitungkan Tuhan kepadanya.\""
 },
 {
   "id": 28047,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 9,
   "firman": "Adakah ucapan bahagia ini hanya berlaku bagi orang bersunat saja atau juga bagi orang tak bersunat? Sebab telah kami katakan, bahwa kepada Abraham iman diperhitungkan sebagai kebenaran."
 },
 {
   "id": 28048,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 10,
   "firman": "Dalam keadaan manakah hal itu diperhitungkan? Sebelum atau sesudah ia disunat? Bukan sesudah disunat, tetapi sebelumnya."
 },
 {
   "id": 28049,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 11,
   "firman": "Dan tanda sunat itu diterimanya sebagai meterai kebenaran berdasarkan iman yang ditunjukkannya, sebelum ia bersunat. Demikianlah ia dapat menjadi bapa semua orang percaya yang tak bersunat, supaya kebenaran diperhitungkan kepada mereka,"
 },
 {
   "id": 28050,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 12,
   "firman": "dan juga menjadi bapa orang-orang bersunat, yaitu mereka yang bukan hanya bersunat, tetapi juga mengikuti jejak iman Abraham, bapa leluhur kita, pada masa ia belum disunat."
 },
 {
   "id": 28051,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sebab bukan karena hukum Taurat telah diberikan janji kepada Abraham dan keturunannya, bahwa ia akan memiliki dunia, tetapi karena kebenaran, berdasarkan iman."
 },
 {
   "id": 28052,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 14,
   "firman": "Sebab jika mereka yang mengharapkannya dari hukum Taurat, menerima bagian yang dijanjikan Allah, maka sia-sialah iman dan batallah janji itu."
 },
 {
   "id": 28053,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 15,
   "firman": "Karena hukum Taurat membangkitkan murka, tetapi di mana tidak ada hukum Taurat, di situ tidak ada juga pelanggaran."
 },
 {
   "id": 28054,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 16,
   "firman": "Karena itulah kebenaran berdasarkan iman supaya merupakan kasih karunia, sehingga janji itu berlaku bagi semua keturunan Abraham, bukan hanya bagi mereka yang hidup dari hukum Taurat, tetapi juga bagi mereka yang hidup dari iman Abraham. Sebab Abraham adalah bapa kita semua, --"
 },
 {
   "id": 28055,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 17,
   "firman": "seperti ada tertulis: \"Engkau telah Kutetapkan menjadi bapa banyak bangsa\" --di hadapan Allah yang kepada-Nya ia percaya, yaitu Allah yang menghidupkan orang mati dan yang menjadikan dengan firman-Nya apa yang tidak ada menjadi ada."
 },
 {
   "id": 28056,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 18,
   "firman": "Sebab sekalipun tidak ada dasar untuk berharap, namun Abraham berharap juga dan percaya, bahwa ia akan menjadi bapa banyak bangsa, menurut yang telah difirmankan: \"Demikianlah banyaknya nanti keturunanmu.\""
 },
 {
   "id": 28057,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 19,
   "firman": "Imannya tidak menjadi lemah, walaupun ia mengetahui, bahwa tubuhnya sudah sangat lemah, karena usianya telah kira-kira seratus tahun, dan bahwa rahim Sara telah tertutup."
 },
 {
   "id": 28058,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 20,
   "firman": "Tetapi terhadap janji Allah ia tidak bimbang karena ketidakpercayaan, malah ia diperkuat dalam imannya dan ia memuliakan Allah,"
 },
 {
   "id": 28059,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 21,
   "firman": "dengan penuh keyakinan, bahwa Allah berkuasa untuk melaksanakan apa yang telah Ia janjikan."
 },
 {
   "id": 28060,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 22,
   "firman": "Karena itu hal ini diperhitungkan kepadanya sebagai kebenaran."
 },
 {
   "id": 28061,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 23,
   "firman": "Kata-kata ini, yaitu \"hal ini diperhitungkan kepadanya,\" tidak ditulis untuk Abraham saja,"
 },
 {
   "id": 28062,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 24,
   "firman": "tetapi ditulis juga untuk kita; sebab kepada kitapun Allah memperhitungkannya, karena kita percaya kepada Dia, yang telah membangkitkan Yesus, Tuhan kita, dari antara orang mati,"
 },
 {
   "id": 28063,
   "kitab": "Rom",
   "pasal": 4,
   "ayat": 25,
   "firman": "yaitu Yesus, yang telah diserahkan karena pelanggaran kita dan dibangkitkan karena pembenaran kita."
 },
 {
   "id": 28064,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 1,
   "firman": "Sebab itu, kita yang dibenarkan karena iman, kita hidup dalam damai sejahtera dengan Allah oleh karena Tuhan kita, Yesus Kristus."
 },
 {
   "id": 28065,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 2,
   "firman": "Oleh Dia kita juga beroleh jalan masuk oleh iman kepada kasih karunia ini. Di dalam kasih karunia ini kita berdiri dan kita bermegah dalam pengharapan akan menerima kemuliaan Allah."
 },
 {
   "id": 28066,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 3,
   "firman": "Dan bukan hanya itu saja. Kita malah bermegah juga dalam kesengsaraan kita, karena kita tahu, bahwa kesengsaraan itu menimbulkan ketekunan,"
 },
 {
   "id": 28067,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 4,
   "firman": "dan ketekunan menimbulkan tahan uji dan tahan uji menimbulkan pengharapan."
 },
 {
   "id": 28068,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 5,
   "firman": "Dan pengharapan tidak mengecewakan, karena kasih Allah telah dicurahkan di dalam hati kita oleh Roh Kudus yang telah dikaruniakan kepada kita."
 },
 {
   "id": 28069,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 6,
   "firman": "Karena waktu kita masih lemah, Kristus telah mati untuk kita orang-orang durhaka pada waktu yang ditentukan oleh Allah."
 },
 {
   "id": 28070,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab tidak mudah seorang mau mati untuk orang yang benar--tetapi mungkin untuk orang yang baik ada orang yang berani mati--."
 },
 {
   "id": 28071,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 8,
   "firman": "Akan tetapi Allah menunjukkan kasih-Nya kepada kita, oleh karena Kristus telah mati untuk kita, ketika kita masih berdosa."
 },
 {
   "id": 28072,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 9,
   "firman": "Lebih-lebih, karena kita sekarang telah dibenarkan oleh darah-Nya, kita pasti akan diselamatkan dari murka Allah."
 },
 {
   "id": 28073,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sebab jikalau kita, ketika masih seteru, diperdamaikan dengan Allah oleh kematian Anak-Nya, lebih-lebih kita, yang sekarang telah diperdamaikan, pasti akan diselamatkan oleh hidup-Nya!"
 },
 {
   "id": 28074,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 11,
   "firman": "Dan bukan hanya itu saja! Kita malah bermegah dalam Allah oleh Yesus Kristus, Tuhan kita, sebab oleh Dia kita telah menerima pendamaian itu."
 },
 {
   "id": 28075,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab itu, sama seperti dosa telah masuk ke dalam dunia oleh satu orang, dan oleh dosa itu juga maut, demikianlah maut itu telah menjalar kepada semua orang, karena semua orang telah berbuat dosa."
 },
 {
   "id": 28076,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 13,
   "firman": "Sebab sebelum hukum Taurat ada, telah ada dosa di dunia. Tetapi dosa itu tidak diperhitungkan kalau tidak ada hukum Taurat."
 },
 {
   "id": 28077,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sungguhpun demikian maut telah berkuasa dari zaman Adam sampai kepada zaman Musa juga atas mereka, yang tidak berbuat dosa dengan cara yang sama seperti yang telah dibuat oleh Adam, yang adalah gambaran Dia yang akan datang."
 },
 {
   "id": 28078,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 15,
   "firman": "Tetapi karunia Allah tidaklah sama dengan pelanggaran Adam. Sebab, jika karena pelanggaran satu orang semua orang telah jatuh di dalam kuasa maut, jauh lebih besar lagi kasih karunia Allah dan karunia-Nya, yang dilimpahkan-Nya atas semua orang karena satu orang, yaitu Yesus Kristus."
 },
 {
   "id": 28079,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 16,
   "firman": "Dan kasih karunia tidak berimbangan dengan dosa satu orang. Sebab penghakiman atas satu pelanggaran itu telah mengakibatkan penghukuman, tetapi penganugerahan karunia atas banyak pelanggaran itu mengakibatkan pembenaran."
 },
 {
   "id": 28080,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 17,
   "firman": "Sebab, jika oleh dosa satu orang, maut telah berkuasa oleh satu orang itu, maka lebih benar lagi mereka, yang telah menerima kelimpahan kasih karunia dan anugerah kebenaran, akan hidup dan berkuasa oleh karena satu orang itu, yaitu Yesus Kristus."
 },
 {
   "id": 28081,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 18,
   "firman": "Sebab itu, sama seperti oleh satu pelanggaran semua orang beroleh penghukuman, demikian pula oleh satu perbuatan kebenaran semua orang beroleh pembenaran untuk hidup."
 },
 {
   "id": 28082,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 19,
   "firman": "Jadi sama seperti oleh ketidaktaatan satu orang semua orang telah menjadi orang berdosa, demikian pula oleh ketaatan satu orang semua orang menjadi orang benar."
 },
 {
   "id": 28083,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 20,
   "firman": "Tetapi hukum Taurat ditambahkan, supaya pelanggaran menjadi semakin banyak; dan di mana dosa bertambah banyak, di sana kasih karunia menjadi berlimpah-limpah,"
 },
 {
   "id": 28084,
   "kitab": "Rom",
   "pasal": 5,
   "ayat": 21,
   "firman": "supaya, sama seperti dosa berkuasa dalam alam maut, demikian kasih karunia akan berkuasa oleh kebenaran untuk hidup yang kekal, oleh Yesus Kristus, Tuhan kita."
 },
 {
   "id": 28085,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 1,
   "firman": "Jika demikian, apakah yang hendak kita katakan? Bolehkah kita bertekun dalam dosa, supaya semakin bertambah kasih karunia itu?"
 },
 {
   "id": 28086,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 2,
   "firman": "Sekali-kali tidak! Bukankah kita telah mati bagi dosa, bagaimanakah kita masih dapat hidup di dalamnya?"
 },
 {
   "id": 28087,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 3,
   "firman": "Atau tidak tahukah kamu, bahwa kita semua yang telah dibaptis dalam Kristus, telah dibaptis dalam kematian-Nya?"
 },
 {
   "id": 28088,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dengan demikian kita telah dikuburkan bersama-sama dengan Dia oleh baptisan dalam kematian, supaya, sama seperti Kristus telah dibangkitkan dari antara orang mati oleh kemuliaan Bapa, demikian juga kita akan hidup dalam hidup yang baru."
 },
 {
   "id": 28089,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 5,
   "firman": "Sebab jika kita telah menjadi satu dengan apa yang sama dengan kematian-Nya, kita juga akan menjadi satu dengan apa yang sama dengan kebangkitan-Nya."
 },
 {
   "id": 28090,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 6,
   "firman": "Karena kita tahu, bahwa manusia lama kita telah turut disalibkan, supaya tubuh dosa kita hilang kuasanya, agar jangan kita menghambakan diri lagi kepada dosa."
 },
 {
   "id": 28091,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 7,
   "firman": "Sebab siapa yang telah mati, ia telah bebas dari dosa."
 },
 {
   "id": 28092,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 8,
   "firman": "Jadi jika kita telah mati dengan Kristus, kita percaya, bahwa kita akan hidup juga dengan Dia."
 },
 {
   "id": 28093,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 9,
   "firman": "Karena kita tahu, bahwa Kristus, sesudah Ia bangkit dari antara orang mati, tidak mati lagi: maut tidak berkuasa lagi atas Dia."
 },
 {
   "id": 28094,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 10,
   "firman": "Sebab kematian-Nya adalah kematian terhadap dosa, satu kali dan untuk selama-lamanya, dan kehidupan-Nya adalah kehidupan bagi Allah."
 },
 {
   "id": 28095,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 11,
   "firman": "Demikianlah hendaknya kamu memandangnya: bahwa kamu telah mati bagi dosa, tetapi kamu hidup bagi Allah dalam Kristus Yesus."
 },
 {
   "id": 28096,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 12,
   "firman": "Sebab itu hendaklah dosa jangan berkuasa lagi di dalam tubuhmu yang fana, supaya kamu jangan lagi menuruti keinginannya."
 },
 {
   "id": 28097,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan janganlah kamu menyerahkan anggota-anggota tubuhmu kepada dosa untuk dipakai sebagai senjata kelaliman, tetapi serahkanlah dirimu kepada Allah sebagai orang-orang, yang dahulu mati, tetapi yang sekarang hidup. Dan serahkanlah anggota-anggota tubuhmu kepada Allah untuk menjadi senjata-senjata kebenaran."
 },
 {
   "id": 28098,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 14,
   "firman": "Sebab kamu tidak akan dikuasai lagi oleh dosa, karena kamu tidak berada di bawah hukum Taurat, tetapi di bawah kasih karunia."
 },
 {
   "id": 28099,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 15,
   "firman": "Jadi bagaimana? Apakah kita akan berbuat dosa, karena kita tidak berada di bawah hukum Taurat, tetapi di bawah kasih karunia? Sekali-kali tidak!"
 },
 {
   "id": 28100,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 16,
   "firman": "Apakah kamu tidak tahu, bahwa apabila kamu menyerahkan dirimu kepada seseorang sebagai hamba untuk mentaatinya, kamu adalah hamba orang itu, yang harus kamu taati, baik dalam dosa yang memimpin kamu kepada kematian, maupun dalam ketaatan yang memimpin kamu kepada kebenaran?"
 },
 {
   "id": 28101,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 17,
   "firman": "Tetapi syukurlah kepada Allah! Dahulu memang kamu hamba dosa, tetapi sekarang kamu dengan segenap hati telah mentaati pengajaran yang telah diteruskan kepadamu."
 },
 {
   "id": 28102,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 18,
   "firman": "Kamu telah dimerdekakan dari dosa dan menjadi hamba kebenaran."
 },
 {
   "id": 28103,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 19,
   "firman": "Aku mengatakan hal ini secara manusia karena kelemahan kamu. Sebab sama seperti kamu telah menyerahkan anggota-anggota tubuhmu menjadi hamba kecemaran dan kedurhakaan yang membawa kamu kepada kedurhakaan, demikian hal kamu sekarang harus menyerahkan anggota-anggota tubuhmu menjadi hamba kebenaran yang membawa kamu kepada pengudusan."
 },
 {
   "id": 28104,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 20,
   "firman": "Sebab waktu kamu hamba dosa, kamu bebas dari kebenaran."
 },
 {
   "id": 28105,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 21,
   "firman": "Dan buah apakah yang kamu petik dari padanya? Semuanya itu menyebabkan kamu merasa malu sekarang, karena kesudahan semuanya itu ialah kematian."
 },
 {
   "id": 28106,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 22,
   "firman": "Tetapi sekarang, setelah kamu dimerdekakan dari dosa dan setelah kamu menjadi hamba Allah, kamu beroleh buah yang membawa kamu kepada pengudusan dan sebagai kesudahannya ialah hidup yang kekal."
 },
 {
   "id": 28107,
   "kitab": "Rom",
   "pasal": 6,
   "ayat": 23,
   "firman": "Sebab upah dosa ialah maut; tetapi karunia Allah ialah hidup yang kekal dalam Kristus Yesus, Tuhan kita."
 },
 {
   "id": 28108,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 1,
   "firman": "Apakah kamu tidak tahu, saudara-saudara, --sebab aku berbicara kepada mereka yang mengetahui hukum--bahwa hukum berkuasa atas seseorang selama orang itu hidup?"
 },
 {
   "id": 28109,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 2,
   "firman": "Sebab seorang isteri terikat oleh hukum kepada suaminya selama suaminya itu hidup. Akan tetapi apabila suaminya itu mati, bebaslah ia dari hukum yang mengikatnya kepada suaminya itu."
 },
 {
   "id": 28110,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 3,
   "firman": "Jadi selama suaminya hidup ia dianggap berzinah, kalau ia menjadi isteri laki-laki lain; tetapi jika suaminya telah mati, ia bebas dari hukum, sehingga ia bukanlah berzinah, kalau ia menjadi isteri laki-laki lain."
 },
 {
   "id": 28111,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 4,
   "firman": "Sebab itu, saudara-saudaraku, kamu juga telah mati bagi hukum Taurat oleh tubuh Kristus, supaya kamu menjadi milik orang lain, yaitu milik Dia, yang telah dibangkitkan dari antara orang mati, agar kita berbuah bagi Allah."
 },
 {
   "id": 28112,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 5,
   "firman": "Sebab waktu kita masih hidup di dalam daging, hawa nafsu dosa, yang dirangsang oleh hukum Taurat, bekerja dalam anggota-anggota tubuh kita, agar kita berbuah bagi maut."
 },
 {
   "id": 28113,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 6,
   "firman": "Tetapi sekarang kita telah dibebaskan dari hukum Taurat, sebab kita telah mati bagi dia, yang mengurung kita, sehingga kita sekarang melayani dalam keadaan baru menurut Roh dan bukan dalam keadaan lama menurut huruf hukum Taurat."
 },
 {
   "id": 28114,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 7,
   "firman": "Jika demikian, apakah yang hendak kita katakan? Apakah hukum Taurat itu dosa? Sekali-kali tidak! Sebaliknya, justru oleh hukum Taurat aku telah mengenal dosa. Karena aku juga tidak tahu apa itu keinginan, kalau hukum Taurat tidak mengatakan: \"Jangan mengingini!\""
 },
 {
   "id": 28115,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 8,
   "firman": "Tetapi dalam perintah itu dosa mendapat kesempatan untuk membangkitkan di dalam diriku rupa-rupa keinginan; sebab tanpa hukum Taurat dosa mati."
 },
 {
   "id": 28116,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 9,
   "firman": "Dahulu aku hidup tanpa hukum Taurat. Akan tetapi sesudah datang perintah itu, dosa mulai hidup,"
 },
 {
   "id": 28117,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 10,
   "firman": "sebaliknya aku mati. Dan perintah yang seharusnya membawa kepada hidup, ternyata bagiku justru membawa kepada kematian."
 },
 {
   "id": 28118,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 11,
   "firman": "Sebab dalam perintah itu, dosa mendapat kesempatan untuk menipu aku dan oleh perintah itu ia membunuh aku."
 },
 {
   "id": 28119,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 12,
   "firman": "Jadi hukum Taurat adalah kudus, dan perintah itu juga adalah kudus, benar dan baik."
 },
 {
   "id": 28120,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 13,
   "firman": "Jika demikian, adakah yang baik itu menjadi kematian bagiku? Sekali-kali tidak! Tetapi supaya nyata, bahwa ia adalah dosa, maka dosa mempergunakan yang baik untuk mendatangkan kematian bagiku, supaya oleh perintah itu dosa lebih nyata lagi keadaannya sebagai dosa."
 },
 {
   "id": 28121,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 14,
   "firman": "Sebab kita tahu, bahwa hukum Taurat adalah rohani, tetapi aku bersifat daging, terjual di bawah kuasa dosa."
 },
 {
   "id": 28122,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 15,
   "firman": "Sebab apa yang aku perbuat, aku tidak tahu. Karena bukan apa yang aku kehendaki yang aku perbuat, tetapi apa yang aku benci, itulah yang aku perbuat."
 },
 {
   "id": 28123,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 16,
   "firman": "Jadi jika aku perbuat apa yang tidak aku kehendaki, aku menyetujui, bahwa hukum Taurat itu baik."
 },
 {
   "id": 28124,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 17,
   "firman": "Kalau demikian bukan aku lagi yang memperbuatnya, tetapi dosa yang ada di dalam aku."
 },
 {
   "id": 28125,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 18,
   "firman": "Sebab aku tahu, bahwa di dalam aku, yaitu di dalam aku sebagai manusia, tidak ada sesuatu yang baik. Sebab kehendak memang ada di dalam aku, tetapi bukan hal berbuat apa yang baik."
 },
 {
   "id": 28126,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 19,
   "firman": "Sebab bukan apa yang aku kehendaki, yaitu yang baik, yang aku perbuat, melainkan apa yang tidak aku kehendaki, yaitu yang jahat, yang aku perbuat."
 },
 {
   "id": 28127,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 20,
   "firman": "Jadi jika aku berbuat apa yang tidak aku kehendaki, maka bukan lagi aku yang memperbuatnya, tetapi dosa yang diam di dalam aku."
 },
 {
   "id": 28128,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 21,
   "firman": "Demikianlah aku dapati hukum ini: jika aku menghendaki berbuat apa yang baik, yang jahat itu ada padaku."
 },
 {
   "id": 28129,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 22,
   "firman": "Sebab di dalam batinku aku suka akan hukum Allah,"
 },
 {
   "id": 28130,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 23,
   "firman": "tetapi di dalam anggota-anggota tubuhku aku melihat hukum lain yang berjuang melawan hukum akal budiku dan membuat aku menjadi tawanan hukum dosa yang ada di dalam anggota-anggota tubuhku."
 },
 {
   "id": 28131,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 24,
   "firman": "Aku, manusia celaka! Siapakah yang akan melepaskan aku dari tubuh maut ini?"
 },
 {
   "id": 28132,
   "kitab": "Rom",
   "pasal": 7,
   "ayat": 25,
   "firman": "Syukur kepada Allah! oleh Yesus Kristus, Tuhan kita. (7-26) Jadi dengan akal budiku aku melayani hukum Allah, tetapi dengan tubuh insaniku aku melayani hukum dosa."
 },
 {
   "id": 28133,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 1,
   "firman": "Demikianlah sekarang tidak ada penghukuman bagi mereka yang ada di dalam Kristus Yesus."
 },
 {
   "id": 28134,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 2,
   "firman": "Roh, yang memberi hidup telah memerdekakan kamu dalam Kristus dari hukum dosa dan hukum maut."
 },
 {
   "id": 28135,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 3,
   "firman": "Sebab apa yang tidak mungkin dilakukan hukum Taurat karena tak berdaya oleh daging, telah dilakukan oleh Allah. Dengan jalan mengutus Anak-Nya sendiri dalam daging, yang serupa dengan daging yang dikuasai dosa karena dosa, Ia telah menjatuhkan hukuman atas dosa di dalam daging,"
 },
 {
   "id": 28136,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 4,
   "firman": "supaya tuntutan hukum Taurat digenapi di dalam kita, yang tidak hidup menurut daging, tetapi menurut Roh."
 },
 {
   "id": 28137,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 5,
   "firman": "Sebab mereka yang hidup menurut daging, memikirkan hal-hal yang dari daging; mereka yang hidup menurut Roh, memikirkan hal-hal yang dari Roh."
 },
 {
   "id": 28138,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 6,
   "firman": "Karena keinginan daging adalah maut, tetapi keinginan Roh adalah hidup dan damai sejahtera."
 },
 {
   "id": 28139,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebab keinginan daging adalah perseteruan terhadap Allah, karena ia tidak takluk kepada hukum Allah; hal ini memang tidak mungkin baginya."
 },
 {
   "id": 28140,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 8,
   "firman": "Mereka yang hidup dalam daging, tidak mungkin berkenan kepada Allah."
 },
 {
   "id": 28141,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 9,
   "firman": "Tetapi kamu tidak hidup dalam daging, melainkan dalam Roh, jika memang Roh Allah diam di dalam kamu. Tetapi jika orang tidak memiliki Roh Kristus, ia bukan milik Kristus."
 },
 {
   "id": 28142,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 10,
   "firman": "Tetapi jika Kristus ada di dalam kamu, maka tubuh memang mati karena dosa, tetapi roh adalah kehidupan oleh karena kebenaran."
 },
 {
   "id": 28143,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dan jika Roh Dia, yang telah membangkitkan Yesus dari antara orang mati, diam di dalam kamu, maka Ia, yang telah membangkitkan Kristus Yesus dari antara orang mati, akan menghidupkan juga tubuhmu yang fana itu oleh Roh-Nya, yang diam di dalam kamu."
 },
 {
   "id": 28144,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 12,
   "firman": "Jadi, saudara-saudara, kita adalah orang berhutang, tetapi bukan kepada daging, supaya hidup menurut daging."
 },
 {
   "id": 28145,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 13,
   "firman": "Sebab, jika kamu hidup menurut daging, kamu akan mati; tetapi jika oleh Roh kamu mematikan perbuatan-perbuatan tubuhmu, kamu akan hidup."
 },
 {
   "id": 28146,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 14,
   "firman": "Semua orang, yang dipimpin Roh Allah, adalah anak Allah."
 },
 {
   "id": 28147,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 15,
   "firman": "Sebab kamu tidak menerima roh perbudakan yang membuat kamu menjadi takut lagi, tetapi kamu telah menerima Roh yang menjadikan kamu anak Allah. Oleh Roh itu kita berseru: \"ya Abba, ya Bapa!\""
 },
 {
   "id": 28148,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 16,
   "firman": "Roh itu bersaksi bersama-sama dengan roh kita, bahwa kita adalah anak-anak Allah."
 },
 {
   "id": 28149,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 17,
   "firman": "Dan jika kita adalah anak, maka kita juga adalah ahli waris, maksudnya orang-orang yang berhak menerima janji-janji Allah, yang akan menerimanya bersama-sama dengan Kristus, yaitu jika kita menderita bersama-sama dengan Dia, supaya kita juga dipermuliakan bersama-sama dengan Dia."
 },
 {
   "id": 28150,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 18,
   "firman": "Sebab aku yakin, bahwa penderitaan zaman sekarang ini tidak dapat dibandingkan dengan kemuliaan yang akan dinyatakan kepada kita."
 },
 {
   "id": 28151,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 19,
   "firman": "Sebab dengan sangat rindu seluruh makhluk menantikan saat anak-anak Allah dinyatakan."
 },
 {
   "id": 28152,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 20,
   "firman": "Karena seluruh makhluk telah ditaklukkan kepada kesia-siaan, bukan oleh kehendaknya sendiri, tetapi oleh kehendak Dia, yang telah menaklukkannya,"
 },
 {
   "id": 28153,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 21,
   "firman": "tetapi dalam pengharapan, karena makhluk itu sendiri juga akan dimerdekakan dari perbudakan kebinasaan dan masuk ke dalam kemerdekaan kemuliaan anak-anak Allah."
 },
 {
   "id": 28154,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 22,
   "firman": "Sebab kita tahu, bahwa sampai sekarang segala makhluk sama-sama mengeluh dan sama-sama merasa sakit bersalin."
 },
 {
   "id": 28155,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 23,
   "firman": "Dan bukan hanya mereka saja, tetapi kita yang telah menerima karunia sulung Roh, kita juga mengeluh dalam hati kita sambil menantikan pengangkatan sebagai anak, yaitu pembebasan tubuh kita."
 },
 {
   "id": 28156,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 24,
   "firman": "Sebab kita diselamatkan dalam pengharapan. Tetapi pengharapan yang dilihat, bukan pengharapan lagi; sebab bagaimana orang masih mengharapkan apa yang dilihatnya?"
 },
 {
   "id": 28157,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 25,
   "firman": "Tetapi jika kita mengharapkan apa yang tidak kita lihat, kita menantikannya dengan tekun."
 },
 {
   "id": 28158,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 26,
   "firman": "Demikian juga Roh membantu kita dalam kelemahan kita; sebab kita tidak tahu, bagaimana sebenarnya harus berdoa; tetapi Roh sendiri berdoa untuk kita kepada Allah dengan keluhan-keluhan yang tidak terucapkan."
 },
 {
   "id": 28159,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 27,
   "firman": "Dan Allah yang menyelidiki hati nurani, mengetahui maksud Roh itu, yaitu bahwa Ia, sesuai dengan kehendak Allah, berdoa untuk orang-orang kudus."
 },
 {
   "id": 28160,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 28,
   "firman": "Kita tahu sekarang, bahwa Allah turut bekerja dalam segala sesuatu untuk mendatangkan kebaikan bagi mereka yang mengasihi Dia, yaitu bagi mereka yang terpanggil sesuai dengan rencana Allah."
 },
 {
   "id": 28161,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 29,
   "firman": "Sebab semua orang yang dipilih-Nya dari semula, mereka juga ditentukan-Nya dari semula untuk menjadi serupa dengan gambaran Anak-Nya, supaya Ia, Anak-Nya itu, menjadi yang sulung di antara banyak saudara."
 },
 {
   "id": 28162,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 30,
   "firman": "Dan mereka yang ditentukan-Nya dari semula, mereka itu juga dipanggil-Nya. Dan mereka yang dipanggil-Nya, mereka itu juga dibenarkan-Nya. Dan mereka yang dibenarkan-Nya, mereka itu juga dimuliakan-Nya."
 },
 {
   "id": 28163,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 31,
   "firman": "Sebab itu apakah yang akan kita katakan tentang semuanya itu? Jika Allah di pihak kita, siapakah yang akan melawan kita?"
 },
 {
   "id": 28164,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 32,
   "firman": "Ia, yang tidak menyayangkan Anak-Nya sendiri, tetapi yang menyerahkan-Nya bagi kita semua, bagaimanakah mungkin Ia tidak mengaruniakan segala sesuatu kepada kita bersama-sama dengan Dia?"
 },
 {
   "id": 28165,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 33,
   "firman": "Siapakah yang akan menggugat orang-orang pilihan Allah? Allah, yang membenarkan mereka? Siapakah yang akan menghukum mereka?"
 },
 {
   "id": 28166,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 34,
   "firman": "Kristus Yesus, yang telah mati? Bahkan lebih lagi: yang telah bangkit, yang juga duduk di sebelah kanan Allah, yang malah menjadi Pembela bagi kita?"
 },
 {
   "id": 28167,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 35,
   "firman": "Siapakah yang akan memisahkan kita dari kasih Kristus? Penindasan atau kesesakan atau penganiayaan, atau kelaparan atau ketelanjangan, atau bahaya, atau pedang?"
 },
 {
   "id": 28168,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 36,
   "firman": "Seperti ada tertulis: \"Oleh karena Engkau kami ada dalam bahaya maut sepanjang hari, kami telah dianggap sebagai domba-domba sembelihan.\""
 },
 {
   "id": 28169,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 37,
   "firman": "Tetapi dalam semuanya itu kita lebih dari pada orang-orang yang menang, oleh Dia yang telah mengasihi kita."
 },
 {
   "id": 28170,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 38,
   "firman": "Sebab aku yakin, bahwa baik maut, maupun hidup, baik malaikat-malaikat, maupun pemerintah-pemerintah, baik yang ada sekarang, maupun yang akan datang,"
 },
 {
   "id": 28171,
   "kitab": "Rom",
   "pasal": 8,
   "ayat": 39,
   "firman": "atau kuasa-kuasa, baik yang di atas, maupun yang di bawah, ataupun sesuatu makhluk lain, tidak akan dapat memisahkan kita dari kasih Allah, yang ada dalam Kristus Yesus, Tuhan kita."
 },
 {
   "id": 28172,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 1,
   "firman": "Aku mengatakan kebenaran dalam Kristus, aku tidak berdusta. Suara hatiku turut bersaksi dalam Roh Kudus,"
 },
 {
   "id": 28173,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 2,
   "firman": "bahwa aku sangat berdukacita dan selalu bersedih hati."
 },
 {
   "id": 28174,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 3,
   "firman": "Bahkan, aku mau terkutuk dan terpisah dari Kristus demi saudara-saudaraku, kaum sebangsaku secara jasmani."
 },
 {
   "id": 28175,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 4,
   "firman": "Sebab mereka adalah orang Israel, mereka telah diangkat menjadi anak, dan mereka telah menerima kemuliaan, dan perjanjian-perjanjian, dan hukum Taurat, dan ibadah, dan janji-janji."
 },
 {
   "id": 28176,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 5,
   "firman": "Mereka adalah keturunan bapa-bapa leluhur, yang menurunkan Mesias dalam keadaan-Nya sebagai manusia, yang ada di atas segala sesuatu. Ia adalah Allah yang harus dipuji sampai selama-lamanya. Amin!"
 },
 {
   "id": 28177,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 6,
   "firman": "Akan tetapi firman Allah tidak mungkin gagal. Sebab tidak semua orang yang berasal dari Israel adalah orang Israel,"
 },
 {
   "id": 28178,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 7,
   "firman": "dan juga tidak semua yang terhitung keturunan Abraham adalah anak Abraham, tetapi: \"Yang berasal dari Ishak yang akan disebut keturunanmu.\""
 },
 {
   "id": 28179,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 8,
   "firman": "Artinya: bukan anak-anak menurut daging adalah anak-anak Allah, tetapi anak-anak perjanjian yang disebut keturunan yang benar."
 },
 {
   "id": 28180,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 9,
   "firman": "Sebab firman ini mengandung janji: \"Pada waktu seperti inilah Aku akan datang dan Sara akan mempunyai seorang anak laki-laki.\""
 },
 {
   "id": 28181,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 10,
   "firman": "Tetapi bukan hanya itu saja. Lebih terang lagi ialah Ribka yang mengandung dari satu orang, yaitu dari Ishak, bapa leluhur kita."
 },
 {
   "id": 28182,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 11,
   "firman": "Sebab waktu anak-anak itu belum dilahirkan dan belum melakukan yang baik atau yang jahat, --supaya rencana Allah tentang pemilihan-Nya diteguhkan, bukan berdasarkan perbuatan, tetapi berdasarkan panggilan-Nya--"
 },
 {
   "id": 28183,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 12,
   "firman": "dikatakan kepada Ribka: \"Anak yang tua akan menjadi hamba anak yang muda,\""
 },
 {
   "id": 28184,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 13,
   "firman": "seperti ada tertulis: \"Aku mengasihi Yakub, tetapi membenci Esau.\""
 },
 {
   "id": 28185,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 14,
   "firman": "Jika demikian, apakah yang hendak kita katakan? Apakah Allah tidak adil? Mustahil!"
 },
 {
   "id": 28186,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 15,
   "firman": "Sebab Ia berfirman kepada Musa: \"Aku akan menaruh belas kasihan kepada siapa Aku mau menaruh belas kasihan dan Aku akan bermurah hati kepada siapa Aku mau bermurah hati.\""
 },
 {
   "id": 28187,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 16,
   "firman": "Jadi hal itu tidak tergantung pada kehendak orang atau usaha orang, tetapi kepada kemurahan hati Allah."
 },
 {
   "id": 28188,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 17,
   "firman": "Sebab Kitab Suci berkata kepada Firaun: \"Itulah sebabnya Aku membangkitkan engkau, yaitu supaya Aku memperlihatkan kuasa-Ku di dalam engkau, dan supaya nama-Ku dimasyhurkan di seluruh bumi.\""
 },
 {
   "id": 28189,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 18,
   "firman": "Jadi Ia menaruh belas kasihan kepada siapa yang dikehendaki-Nya dan Ia menegarkan hati siapa yang dikehendaki-Nya."
 },
 {
   "id": 28190,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sekarang kamu akan berkata kepadaku: \"Jika demikian, apa lagi yang masih disalahkan-Nya? Sebab siapa yang menentang kehendak-Nya?\""
 },
 {
   "id": 28191,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 20,
   "firman": "Siapakah kamu, hai manusia, maka kamu membantah Allah? Dapatkah yang dibentuk berkata kepada yang membentuknya: \"Mengapakah engkau membentuk aku demikian?\""
 },
 {
   "id": 28192,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 21,
   "firman": "Apakah tukang periuk tidak mempunyai hak atas tanah liatnya, untuk membuat dari gumpal yang sama suatu benda untuk dipakai guna tujuan yang mulia dan suatu benda lain untuk dipakai guna tujuan yang biasa?"
 },
 {
   "id": 28193,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 22,
   "firman": "Jadi, kalau untuk menunjukkan murka-Nya dan menyatakan kuasa-Nya, Allah menaruh kesabaran yang besar terhadap benda-benda kemurkaan-Nya, yang telah disiapkan untuk kebinasaan--"
 },
 {
   "id": 28194,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 23,
   "firman": "justru untuk menyatakan kekayaan kemuliaan-Nya atas benda-benda belas kasihan-Nya yang telah dipersiapkan-Nya untuk kemuliaan,"
 },
 {
   "id": 28195,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 24,
   "firman": "yaitu kita, yang telah dipanggil-Nya bukan hanya dari antara orang Yahudi, tetapi juga dari antara bangsa-bangsa lain,"
 },
 {
   "id": 28196,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 25,
   "firman": "seperti yang difirmankan-Nya juga dalam kitab nabi Hosea: \"Yang bukan umat-Ku akan Kusebut: umat-Ku dan yang bukan kekasih: kekasih.\""
 },
 {
   "id": 28197,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 26,
   "firman": "Dan di tempat, di mana akan dikatakan kepada mereka: \"Kamu ini bukanlah umat-Ku,\" di sana akan dikatakan kepada mereka: \"Anak-anak Allah yang hidup.\""
 },
 {
   "id": 28198,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 27,
   "firman": "Dan Yesaya berseru tentang Israel: \"Sekalipun jumlah anak Israel seperti pasir di laut, namun hanya sisanya akan diselamatkan."
 },
 {
   "id": 28199,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 28,
   "firman": "Sebab apa yang telah difirmankan-Nya, akan dilakukan Tuhan di atas bumi, sempurna dan segera.\""
 },
 {
   "id": 28200,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 29,
   "firman": "Dan seperti yang dikatakan Yesaya sebelumnya: \"Seandainya Tuhan semesta alam tidak meninggalkan pada kita keturunan, kita sudah menjadi seperti Sodom dan sama seperti Gomora.\""
 },
 {
   "id": 28201,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 30,
   "firman": "Jika demikian, apakah yang hendak kita katakan? Ini: bahwa bangsa-bangsa lain yang tidak mengejar kebenaran, telah beroleh kebenaran, yaitu kebenaran karena iman."
 },
 {
   "id": 28202,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 31,
   "firman": "Tetapi: bahwa Israel, sungguhpun mengejar hukum yang akan mendatangkan kebenaran, tidaklah sampai kepada hukum itu."
 },
 {
   "id": 28203,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 32,
   "firman": "Mengapa tidak? Karena Israel mengejarnya bukan karena iman, tetapi karena perbuatan. Mereka tersandung pada batu sandungan,"
 },
 {
   "id": 28204,
   "kitab": "Rom",
   "pasal": 9,
   "ayat": 33,
   "firman": "seperti ada tertulis: \"Sesungguhnya, Aku meletakkan di Sion sebuah batu sentuhan dan sebuah batu sandungan, dan siapa yang percaya kepada-Nya, tidak akan dipermalukan.\""
 },
 {
   "id": 28205,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 1,
   "firman": "Saudara-saudara, keinginan hatiku dan doaku kepada Tuhan ialah, supaya mereka diselamatkan."
 },
 {
   "id": 28206,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 2,
   "firman": "Sebab aku dapat memberi kesaksian tentang mereka, bahwa mereka sungguh-sungguh giat untuk Allah, tetapi tanpa pengertian yang benar."
 },
 {
   "id": 28207,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 3,
   "firman": "Sebab, oleh karena mereka tidak mengenal kebenaran Allah dan oleh karena mereka berusaha untuk mendirikan kebenaran mereka sendiri, maka mereka tidak takluk kepada kebenaran Allah."
 },
 {
   "id": 28208,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 4,
   "firman": "Sebab Kristus adalah kegenapan hukum Taurat, sehingga kebenaran diperoleh tiap-tiap orang yang percaya."
 },
 {
   "id": 28209,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 5,
   "firman": "Sebab Musa menulis tentang kebenaran karena hukum Taurat: \"Orang yang melakukannya, akan hidup karenanya.\""
 },
 {
   "id": 28210,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 6,
   "firman": "Tetapi kebenaran karena iman berkata demikian: \"Jangan katakan di dalam hatimu: Siapakah akan naik ke sorga?\", yaitu: untuk membawa Yesus turun,"
 },
 {
   "id": 28211,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 7,
   "firman": "atau: \"Siapakah akan turun ke jurang maut?\", yaitu: untuk membawa Kristus naik dari antara orang mati."
 },
 {
   "id": 28212,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 8,
   "firman": "Tetapi apakah katanya? Ini: \"Firman itu dekat kepadamu, yakni di dalam mulutmu dan di dalam hatimu.\" Itulah firman iman, yang kami beritakan."
 },
 {
   "id": 28213,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 9,
   "firman": "Sebab jika kamu mengaku dengan mulutmu, bahwa Yesus adalah Tuhan, dan percaya dalam hatimu, bahwa Allah telah membangkitkan Dia dari antara orang mati, maka kamu akan diselamatkan."
 },
 {
   "id": 28214,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 10,
   "firman": "Karena dengan hati orang percaya dan dibenarkan, dan dengan mulut orang mengaku dan diselamatkan."
 },
 {
   "id": 28215,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 11,
   "firman": "Karena Kitab Suci berkata: \"Barangsiapa yang percaya kepada Dia, tidak akan dipermalukan.\""
 },
 {
   "id": 28216,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 12,
   "firman": "Sebab tidak ada perbedaan antara orang Yahudi dan orang Yunani. Karena, Allah yang satu itu adalah Tuhan dari semua orang, kaya bagi semua orang yang berseru kepada-Nya."
 },
 {
   "id": 28217,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 13,
   "firman": "Sebab, barangsiapa yang berseru kepada nama Tuhan, akan diselamatkan."
 },
 {
   "id": 28218,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 14,
   "firman": "Tetapi bagaimana mereka dapat berseru kepada-Nya, jika mereka tidak percaya kepada Dia? Bagaimana mereka dapat percaya kepada Dia, jika mereka tidak mendengar tentang Dia. Bagaimana mereka mendengar tentang Dia, jika tidak ada yang memberitakan-Nya?"
 },
 {
   "id": 28219,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 15,
   "firman": "Dan bagaimana mereka dapat memberitakan-Nya, jika mereka tidak diutus? Seperti ada tertulis: \"Betapa indahnya kedatangan mereka yang membawa kabar baik!\""
 },
 {
   "id": 28220,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 16,
   "firman": "Tetapi tidak semua orang telah menerima kabar baik itu. Yesaya sendiri berkata: \"Tuhan, siapakah yang percaya kepada pemberitaan kami?\""
 },
 {
   "id": 28221,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 17,
   "firman": "Jadi, iman timbul dari pendengaran, dan pendengaran oleh firman Kristus."
 },
 {
   "id": 28222,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 18,
   "firman": "Tetapi aku bertanya: Adakah mereka tidak mendengarnya? Memang mereka telah mendengarnya: \"Suara mereka sampai ke seluruh dunia, dan perkataan mereka sampai ke ujung bumi.\""
 },
 {
   "id": 28223,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 19,
   "firman": "Tetapi aku bertanya: Adakah Israel menanggapnya? Pertama-tama Musa berkata: \"Aku menjadikan kamu cemburu terhadap orang-orang yang bukan umat dan membangkitkan amarahmu terhadap bangsa yang bebal.\""
 },
 {
   "id": 28224,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 20,
   "firman": "Dan dengan berani Yesaya mengatakan: \"Aku telah berkenan ditemukan mereka yang tidak mencari Aku, Aku telah menampakkan diri kepada mereka yang tidak menanyakan Aku.\""
 },
 {
   "id": 28225,
   "kitab": "Rom",
   "pasal": 10,
   "ayat": 21,
   "firman": "Tetapi tentang Israel ia berkata: \"Sepanjang hari Aku telah mengulurkan tangan-Ku kepada bangsa yang tidak taat dan yang membantah.\""
 },
 {
   "id": 28226,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 1,
   "firman": "Maka aku bertanya: Adakah Allah mungkin telah menolak umat-Nya? Sekali-kali tidak! Karena aku sendiripun orang Israel, dari keturunan Abraham, dari suku Benyamin."
 },
 {
   "id": 28227,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 2,
   "firman": "Allah tidak menolak umat-Nya yang dipilih-Nya. Ataukah kamu tidak tahu, apa yang dikatakan Kitab Suci tentang Elia, waktu ia mengadukan Israel kepada Allah:"
 },
 {
   "id": 28228,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 3,
   "firman": "\"Tuhan, nabi-nabi-Mu telah mereka bunuh, mezbah-mezbah-Mu telah mereka runtuhkan; hanya aku seorang dirilah yang masih hidup dan mereka ingin mencabut nyawaku.\""
 },
 {
   "id": 28229,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tetapi bagaimanakah firman Allah kepadanya? \"Aku masih meninggalkan tujuh ribu orang bagi-Ku, yang tidak pernah sujud menyembah Baal.\""
 },
 {
   "id": 28230,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 5,
   "firman": "Demikian juga pada waktu ini ada tinggal suatu sisa, menurut pilihan kasih karunia."
 },
 {
   "id": 28231,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 6,
   "firman": "Tetapi jika hal itu terjadi karena kasih karunia, maka bukan lagi karena perbuatan, sebab jika tidak demikian, maka kasih karunia itu bukan lagi kasih karunia."
 },
 {
   "id": 28232,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 7,
   "firman": "Jadi bagaimana? Israel tidak memperoleh apa yang dikejarnya, tetapi orang-orang yang terpilih telah memperolehnya. Dan orang-orang yang lain telah tegar hatinya,"
 },
 {
   "id": 28233,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 8,
   "firman": "seperti ada tertulis: \"Allah membuat mereka tidur nyenyak, memberikan mata untuk tidak melihat dan telinga untuk tidak mendengar, sampai kepada hari sekarang ini.\""
 },
 {
   "id": 28234,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dan Daud berkata: \"Biarlah jamuan mereka menjadi jerat dan perangkap, penyesatan dan pembalasan bagi mereka."
 },
 {
   "id": 28235,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 10,
   "firman": "Dan biarlah mata mereka menjadi gelap, sehingga mereka tidak melihat, dan buatlah punggung mereka terus-menerus membungkuk.\""
 },
 {
   "id": 28236,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 11,
   "firman": "Maka aku bertanya: Adakah mereka tersandung dan harus jatuh? Sekali-kali tidak! Tetapi oleh pelanggaran mereka, keselamatan telah sampai kepada bangsa-bangsa lain, supaya membuat mereka cemburu."
 },
 {
   "id": 28237,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 12,
   "firman": "Sebab jika pelanggaran mereka berarti kekayaan bagi dunia, dan kekurangan mereka kekayaan bagi bangsa-bangsa lain, terlebih-lebih lagi kesempurnaan mereka."
 },
 {
   "id": 28238,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 13,
   "firman": "Aku berkata kepada kamu, hai bangsa-bangsa bukan Yahudi. Justru karena aku adalah rasul untuk bangsa-bangsa bukan Yahudi, aku menganggap hal itu kemuliaan pelayananku,"
 },
 {
   "id": 28239,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 14,
   "firman": "yaitu kalau-kalau aku dapat membangkitkan cemburu di dalam hati kaum sebangsaku menurut daging dan dapat menyelamatkan beberapa orang dari mereka."
 },
 {
   "id": 28240,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 15,
   "firman": "Sebab jika penolakan mereka berarti perdamaian bagi dunia, dapatkah penerimaan mereka mempunyai arti lain dari pada hidup dari antara orang mati?"
 },
 {
   "id": 28241,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 16,
   "firman": "Jikalau roti sulung adalah kudus, maka seluruh adonan juga kudus, dan jikalau akar adalah kudus, maka cabang-cabang juga kudus."
 },
 {
   "id": 28242,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 17,
   "firman": "Karena itu apabila beberapa cabang telah dipatahkan dan kamu sebagai tunas liar telah dicangkokkan di antaranya dan turut mendapat bagian dalam akar pohon zaitun yang penuh getah,"
 },
 {
   "id": 28243,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 18,
   "firman": "janganlah kamu bermegah terhadap cabang-cabang itu! Jikalau kamu bermegah, ingatlah, bahwa bukan kamu yang menopang akar itu, melainkan akar itu yang menopang kamu."
 },
 {
   "id": 28244,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 19,
   "firman": "Mungkin kamu akan berkata: ada cabang-cabang yang dipatahkan, supaya aku dicangkokkan di antaranya sebagai tunas."
 },
 {
   "id": 28245,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 20,
   "firman": "Baiklah! Mereka dipatahkan karena ketidakpercayaan mereka, dan kamu tegak tercacak karena iman. Janganlah kamu sombong, tetapi takutlah!"
 },
 {
   "id": 28246,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 21,
   "firman": "Sebab kalau Allah tidak menyayangkan cabang-cabang asli, Ia juga tidak akan menyayangkan kamu."
 },
 {
   "id": 28247,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 22,
   "firman": "Sebab itu perhatikanlah kemurahan Allah dan juga kekerasan-Nya, yaitu kekerasan atas orang-orang yang telah jatuh, tetapi atas kamu kemurahan-Nya, yaitu jika kamu tetap dalam kemurahan-Nya; jika tidak, kamupun akan dipotong juga."
 },
 {
   "id": 28248,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 23,
   "firman": "Tetapi merekapun akan dicangkokkan kembali, jika mereka tidak tetap dalam ketidakpercayaan mereka, sebab Allah berkuasa untuk mencangkokkan mereka kembali."
 },
 {
   "id": 28249,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 24,
   "firman": "Sebab jika kamu telah dipotong sebagai cabang dari pohon zaitun liar, dan bertentangan dengan keadaanmu itu kamu telah dicangkokkan pada pohon zaitun sejati, terlebih lagi mereka ini, yang menurut asal mereka akan dicangkokkan pada pohon zaitun mereka sendiri."
 },
 {
   "id": 28250,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 25,
   "firman": "Sebab, saudara-saudara, supaya kamu jangan menganggap dirimu pandai, aku mau agar kamu mengetahui rahasia ini: Sebagian dari Israel telah menjadi tegar sampai jumlah yang penuh dari bangsa-bangsa lain telah masuk."
 },
 {
   "id": 28251,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 26,
   "firman": "Dengan jalan demikian seluruh Israel akan diselamatkan, seperti ada tertulis: \"Dari Sion akan datang Penebus, Ia akan menyingkirkan segala kefasikan dari pada Yakub."
 },
 {
   "id": 28252,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 27,
   "firman": "Dan inilah perjanjian-Ku dengan mereka, apabila Aku menghapuskan dosa mereka.\""
 },
 {
   "id": 28253,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 28,
   "firman": "Mengenai Injil mereka adalah seteru Allah oleh karena kamu, tetapi mengenai pilihan mereka adalah kekasih Allah oleh karena nenek moyang."
 },
 {
   "id": 28254,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 29,
   "firman": "Sebab Allah tidak menyesali kasih karunia dan panggilan-Nya."
 },
 {
   "id": 28255,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 30,
   "firman": "Sebab sama seperti kamu dahulu tidak taat kepada Allah, tetapi sekarang beroleh kemurahan oleh ketidaktaatan mereka,"
 },
 {
   "id": 28256,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 31,
   "firman": "demikian juga mereka sekarang tidak taat, supaya oleh kemurahan yang telah kamu peroleh, mereka juga akan beroleh kemurahan."
 },
 {
   "id": 28257,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 32,
   "firman": "Sebab Allah telah mengurung semua orang dalam ketidaktaatan, supaya Ia dapat menunjukkan kemurahan-Nya atas mereka semua."
 },
 {
   "id": 28258,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 33,
   "firman": "O, alangkah dalamnya kekayaan, hikmat dan pengetahuan Allah! Sungguh tak terselidiki keputusan-keputusan-Nya dan sungguh tak terselami jalan-jalan-Nya!"
 },
 {
   "id": 28259,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 34,
   "firman": "Sebab, siapakah yang mengetahui pikiran Tuhan? Atau siapakah yang pernah menjadi penasihat-Nya?"
 },
 {
   "id": 28260,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 35,
   "firman": "Atau siapakah yang pernah memberikan sesuatu kepada-Nya, sehingga Ia harus menggantikannya?"
 },
 {
   "id": 28261,
   "kitab": "Rom",
   "pasal": 11,
   "ayat": 36,
   "firman": "Sebab segala sesuatu adalah dari Dia, dan oleh Dia, dan kepada Dia: Bagi Dialah kemuliaan sampai selama-lamanya!"
 },
 {
   "id": 28262,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 1,
   "firman": "Karena itu, saudara-saudara, demi kemurahan Allah aku menasihatkan kamu, supaya kamu mempersembahkan tubuhmu sebagai persembahan yang hidup, yang kudus dan yang berkenan kepada Allah: itu adalah ibadahmu yang sejati."
 },
 {
   "id": 28263,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 2,
   "firman": "Janganlah kamu menjadi serupa dengan dunia ini, tetapi berubahlah oleh pembaharuan budimu, sehingga kamu dapat membedakan manakah kehendak Allah: apa yang baik, yang berkenan kepada Allah dan yang sempurna."
 },
 {
   "id": 28264,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 3,
   "firman": "Berdasarkan kasih karunia yang dianugerahkan kepadaku, aku berkata kepada setiap orang di antara kamu: Janganlah kamu memikirkan hal-hal yang lebih tinggi dari pada yang patut kamu pikirkan, tetapi hendaklah kamu berpikir begitu rupa, sehingga kamu menguasai diri menurut ukuran iman, yang dikaruniakan Allah kepada kamu masing-masing."
 },
 {
   "id": 28265,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 4,
   "firman": "Sebab sama seperti pada satu tubuh kita mempunyai banyak anggota, tetapi tidak semua anggota itu mempunyai tugas yang sama,"
 },
 {
   "id": 28266,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 5,
   "firman": "demikian juga kita, walaupun banyak, adalah satu tubuh di dalam Kristus; tetapi kita masing-masing adalah anggota yang seorang terhadap yang lain."
 },
 {
   "id": 28267,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 6,
   "firman": "Demikianlah kita mempunyai karunia yang berlain-lainan menurut kasih karunia yang dianugerahkan kepada kita: Jika karunia itu adalah untuk bernubuat baiklah kita melakukannya sesuai dengan iman kita."
 },
 {
   "id": 28268,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 7,
   "firman": "Jika karunia untuk melayani, baiklah kita melayani; jika karunia untuk mengajar, baiklah kita mengajar;"
 },
 {
   "id": 28269,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 8,
   "firman": "jika karunia untuk menasihati, baiklah kita menasihati. Siapa yang membagi-bagikan sesuatu, hendaklah ia melakukannya dengan hati yang ikhlas; siapa yang memberi pimpinan, hendaklah ia melakukannya dengan rajin; siapa yang menunjukkan kemurahan, hendaklah ia melakukannya dengan sukacita."
 },
 {
   "id": 28270,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 9,
   "firman": "Hendaklah kasih itu jangan pura-pura! Jauhilah yang jahat dan lakukanlah yang baik."
 },
 {
   "id": 28271,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 10,
   "firman": "Hendaklah kamu saling mengasihi sebagai saudara dan saling mendahului dalam memberi hormat."
 },
 {
   "id": 28272,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 11,
   "firman": "Janganlah hendaknya kerajinanmu kendor, biarlah rohmu menyala-nyala dan layanilah Tuhan."
 },
 {
   "id": 28273,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 12,
   "firman": "Bersukacitalah dalam pengharapan, sabarlah dalam kesesakan, dan bertekunlah dalam doa!"
 },
 {
   "id": 28274,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 13,
   "firman": "Bantulah dalam kekurangan orang-orang kudus dan usahakanlah dirimu untuk selalu memberikan tumpangan!"
 },
 {
   "id": 28275,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 14,
   "firman": "Berkatilah siapa yang menganiaya kamu, berkatilah dan jangan mengutuk!"
 },
 {
   "id": 28276,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 15,
   "firman": "Bersukacitalah dengan orang yang bersukacita, dan menangislah dengan orang yang menangis!"
 },
 {
   "id": 28277,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 16,
   "firman": "Hendaklah kamu sehati sepikir dalam hidupmu bersama; janganlah kamu memikirkan perkara-perkara yang tinggi, tetapi arahkanlah dirimu kepada perkara-perkara yang sederhana. Janganlah menganggap dirimu pandai!"
 },
 {
   "id": 28278,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 17,
   "firman": "Janganlah membalas kejahatan dengan kejahatan; lakukanlah apa yang baik bagi semua orang!"
 },
 {
   "id": 28279,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 18,
   "firman": "Sedapat-dapatnya, kalau hal itu bergantung padamu, hiduplah dalam perdamaian dengan semua orang!"
 },
 {
   "id": 28280,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 19,
   "firman": "Saudara-saudaraku yang kekasih, janganlah kamu sendiri menuntut pembalasan, tetapi berilah tempat kepada murka Allah, sebab ada tertulis: Pembalasan itu adalah hak-Ku. Akulah yang akan menuntut pembalasan, firman Tuhan."
 },
 {
   "id": 28281,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 20,
   "firman": "Tetapi, jika seterumu lapar, berilah dia makan; jika ia haus, berilah dia minum! Dengan berbuat demikian kamu menumpukkan bara api di atas kepalanya."
 },
 {
   "id": 28282,
   "kitab": "Rom",
   "pasal": 12,
   "ayat": 21,
   "firman": "Janganlah kamu kalah terhadap kejahatan, tetapi kalahkanlah kejahatan dengan kebaikan!"
 },
 {
   "id": 28283,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 1,
   "firman": "Tiap-tiap orang harus takluk kepada pemerintah yang di atasnya, sebab tidak ada pemerintah, yang tidak berasal dari Allah; dan pemerintah-pemerintah yang ada, ditetapkan oleh Allah."
 },
 {
   "id": 28284,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 2,
   "firman": "Sebab itu barangsiapa melawan pemerintah, ia melawan ketetapan Allah dan siapa yang melakukannya, akan mendatangkan hukuman atas dirinya."
 },
 {
   "id": 28285,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 3,
   "firman": "Sebab jika seorang berbuat baik, ia tidak usah takut kepada pemerintah, hanya jika ia berbuat jahat. Maukah kamu hidup tanpa takut terhadap pemerintah? Perbuatlah apa yang baik dan kamu akan beroleh pujian dari padanya."
 },
 {
   "id": 28286,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 4,
   "firman": "Karena pemerintah adalah hamba Allah untuk kebaikanmu. Tetapi jika engkau berbuat jahat, takutlah akan dia, karena tidak percuma pemerintah menyandang pedang. Pemerintah adalah hamba Allah untuk membalaskan murka Allah atas mereka yang berbuat jahat."
 },
 {
   "id": 28287,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 5,
   "firman": "Sebab itu perlu kita menaklukkan diri, bukan saja oleh karena kemurkaan Allah, tetapi juga oleh karena suara hati kita."
 },
 {
   "id": 28288,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 6,
   "firman": "Itulah juga sebabnya maka kamu membayar pajak. Karena mereka yang mengurus hal itu adalah pelayan-pelayan Allah."
 },
 {
   "id": 28289,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 7,
   "firman": "Bayarlah kepada semua orang apa yang harus kamu bayar: pajak kepada orang yang berhak menerima pajak, cukai kepada orang yang berhak menerima cukai; rasa takut kepada orang yang berhak menerima rasa takut dan hormat kepada orang yang berhak menerima hormat."
 },
 {
   "id": 28290,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 8,
   "firman": "Janganlah kamu berhutang apa-apa kepada siapapun juga, tetapi hendaklah kamu saling mengasihi. Sebab barangsiapa mengasihi sesamanya manusia, ia sudah memenuhi hukum Taurat."
 },
 {
   "id": 28291,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 9,
   "firman": "Karena firman: jangan berzinah, jangan membunuh, jangan mencuri, jangan mengingini dan firman lain manapun juga, sudah tersimpul dalam firman ini, yaitu: Kasihilah sesamamu manusia seperti dirimu sendiri!"
 },
 {
   "id": 28292,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kasih tidak berbuat jahat terhadap sesama manusia, karena itu kasih adalah kegenapan hukum Taurat."
 },
 {
   "id": 28293,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 11,
   "firman": "Hal ini harus kamu lakukan, karena kamu mengetahui keadaan waktu sekarang, yaitu bahwa saatnya telah tiba bagi kamu untuk bangun dari tidur. Sebab sekarang keselamatan sudah lebih dekat bagi kita dari pada waktu kita menjadi percaya."
 },
 {
   "id": 28294,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 12,
   "firman": "Hari sudah jauh malam, telah hampir siang. Sebab itu marilah kita menanggalkan perbuatan-perbuatan kegelapan dan mengenakan perlengkapan senjata terang!"
 },
 {
   "id": 28295,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 13,
   "firman": "Marilah kita hidup dengan sopan, seperti pada siang hari, jangan dalam pesta pora dan kemabukan, jangan dalam percabulan dan hawa nafsu, jangan dalam perselisihan dan iri hati."
 },
 {
   "id": 28296,
   "kitab": "Rom",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tetapi kenakanlah Tuhan Yesus Kristus sebagai perlengkapan senjata terang dan janganlah merawat tubuhmu untuk memuaskan keinginannya."
 },
 {
   "id": 28297,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 1,
   "firman": "Terimalah orang yang lemah imannya tanpa mempercakapkan pendapatnya."
 },
 {
   "id": 28298,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 2,
   "firman": "Yang seorang yakin, bahwa ia boleh makan segala jenis makanan, tetapi orang yang lemah imannya hanya makan sayur-sayuran saja."
 },
 {
   "id": 28299,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 3,
   "firman": "Siapa yang makan, janganlah menghina orang yang tidak makan, dan siapa yang tidak makan, janganlah menghakimi orang yang makan, sebab Allah telah menerima orang itu."
 },
 {
   "id": 28300,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 4,
   "firman": "Siapakah kamu, sehingga kamu menghakimi hamba orang lain? Entahkah ia berdiri, entahkah ia jatuh, itu adalah urusan tuannya sendiri. Tetapi ia akan tetap berdiri, karena Tuhan berkuasa menjaga dia terus berdiri."
 },
 {
   "id": 28301,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 5,
   "firman": "Yang seorang menganggap hari yang satu lebih penting dari pada hari yang lain, tetapi yang lain menganggap semua hari sama saja. Hendaklah setiap orang benar-benar yakin dalam hatinya sendiri."
 },
 {
   "id": 28302,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 6,
   "firman": "Siapa yang berpegang pada suatu hari yang tertentu, ia melakukannya untuk Tuhan. Dan siapa makan, ia melakukannya untuk Tuhan, sebab ia mengucap syukur kepada Allah. Dan siapa tidak makan, ia melakukannya untuk Tuhan, dan ia juga mengucap syukur kepada Allah."
 },
 {
   "id": 28303,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 7,
   "firman": "Sebab tidak ada seorangpun di antara kita yang hidup untuk dirinya sendiri, dan tidak ada seorangpun yang mati untuk dirinya sendiri."
 },
 {
   "id": 28304,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 8,
   "firman": "Sebab jika kita hidup, kita hidup untuk Tuhan, dan jika kita mati, kita mati untuk Tuhan. Jadi baik hidup atau mati, kita adalah milik Tuhan."
 },
 {
   "id": 28305,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 9,
   "firman": "Sebab untuk itulah Kristus telah mati dan hidup kembali, supaya Ia menjadi Tuhan, baik atas orang-orang mati, maupun atas orang-orang hidup."
 },
 {
   "id": 28306,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 10,
   "firman": "Tetapi engkau, mengapakah engkau menghakimi saudaramu? Atau mengapakah engkau menghina saudaramu? Sebab kita semua harus menghadap takhta pengadilan Allah."
 },
 {
   "id": 28307,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 11,
   "firman": "Karena ada tertulis: \"Demi Aku hidup, demikianlah firman Tuhan, semua orang akan bertekuk lutut di hadapan-Ku dan semua orang akan memuliakan Allah.\""
 },
 {
   "id": 28308,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 12,
   "firman": "Demikianlah setiap orang di antara kita akan memberi pertanggungan jawab tentang dirinya sendiri kepada Allah."
 },
 {
   "id": 28309,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 13,
   "firman": "Karena itu janganlah kita saling menghakimi lagi! Tetapi lebih baik kamu menganut pandangan ini: Jangan kita membuat saudara kita jatuh atau tersandung!"
 },
 {
   "id": 28310,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 14,
   "firman": "Aku tahu dan yakin dalam Tuhan Yesus, bahwa tidak ada sesuatu yang najis dari dirinya sendiri. Hanya bagi orang yang beranggapan, bahwa sesuatu adalah najis, bagi orang itulah sesuatu itu najis."
 },
 {
   "id": 28311,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 15,
   "firman": "Sebab jika engkau menyakiti hati saudaramu oleh karena sesuatu yang engkau makan, maka engkau tidak hidup lagi menurut tuntutan kasih. Janganlah engkau membinasakan saudaramu oleh karena makananmu, karena Kristus telah mati untuk dia."
 },
 {
   "id": 28312,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 16,
   "firman": "Apa yang baik, yang kamu miliki, janganlah kamu biarkan difitnah."
 },
 {
   "id": 28313,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 17,
   "firman": "Sebab Kerajaan Allah bukanlah soal makanan dan minuman, tetapi soal kebenaran, damai sejahtera dan sukacita oleh Roh Kudus."
 },
 {
   "id": 28314,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 18,
   "firman": "Karena barangsiapa melayani Kristus dengan cara ini, ia berkenan pada Allah dan dihormati oleh manusia."
 },
 {
   "id": 28315,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 19,
   "firman": "Sebab itu marilah kita mengejar apa yang mendatangkan damai sejahtera dan yang berguna untuk saling membangun."
 },
 {
   "id": 28316,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 20,
   "firman": "Janganlah engkau merusakkan pekerjaan Allah oleh karena makanan! Segala sesuatu adalah suci, tetapi celakalah orang, jika oleh makanannya orang lain tersandung!"
 },
 {
   "id": 28317,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 21,
   "firman": "Baiklah engkau jangan makan daging atau minum anggur, atau sesuatu yang menjadi batu sandungan untuk saudaramu."
 },
 {
   "id": 28318,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 22,
   "firman": "Berpeganglah pada keyakinan yang engkau miliki itu, bagi dirimu sendiri di hadapan Allah. Berbahagialah dia, yang tidak menghukum dirinya sendiri dalam apa yang dianggapnya baik untuk dilakukan."
 },
 {
   "id": 28319,
   "kitab": "Rom",
   "pasal": 14,
   "ayat": 23,
   "firman": "Tetapi barangsiapa yang bimbang, kalau ia makan, ia telah dihukum, karena ia tidak melakukannya berdasarkan iman. Dan segala sesuatu yang tidak berdasarkan iman, adalah dosa."
 },
 {
   "id": 28320,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 1,
   "firman": "Kita, yang kuat, wajib menanggung kelemahan orang yang tidak kuat dan jangan kita mencari kesenangan kita sendiri."
 },
 {
   "id": 28321,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 2,
   "firman": "Setiap orang di antara kita harus mencari kesenangan sesama kita demi kebaikannya untuk membangunnya."
 },
 {
   "id": 28322,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 3,
   "firman": "Karena Kristus juga tidak mencari kesenangan-Nya sendiri, tetapi seperti ada tertulis: \"Kata-kata cercaan mereka, yang mencerca Engkau, telah mengenai aku.\""
 },
 {
   "id": 28323,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 4,
   "firman": "Sebab segala sesuatu yang ditulis dahulu, telah ditulis untuk menjadi pelajaran bagi kita, supaya kita teguh berpegang pada pengharapan oleh ketekunan dan penghiburan dari Kitab Suci."
 },
 {
   "id": 28324,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 5,
   "firman": "Semoga Allah, yang adalah sumber ketekunan dan penghiburan, mengaruniakan kerukunan kepada kamu, sesuai dengan kehendak Kristus Yesus,"
 },
 {
   "id": 28325,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 6,
   "firman": "sehingga dengan satu hati dan satu suara kamu memuliakan Allah dan Bapa Tuhan kita, Yesus Kristus."
 },
 {
   "id": 28326,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 7,
   "firman": "Sebab itu terimalah satu akan yang lain, sama seperti Kristus juga telah menerima kita, untuk kemuliaan Allah."
 },
 {
   "id": 28327,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 8,
   "firman": "Yang aku maksudkan ialah, bahwa oleh karena kebenaran Allah Kristus telah menjadi pelayan orang-orang bersunat untuk mengokohkan janji yang telah diberikan-Nya kepada nenek moyang kita,"
 },
 {
   "id": 28328,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 9,
   "firman": "dan untuk memungkinkan bangsa-bangsa, supaya mereka memuliakan Allah karena rahmat-Nya, seperti ada tertulis: \"Sebab itu aku akan memuliakan Engkau di antara bangsa-bangsa dan menyanyikan mazmur bagi nama-Mu.\""
 },
 {
   "id": 28329,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 10,
   "firman": "Dan selanjutnya: \"Bersukacitalah, hai bangsa-bangsa, dengan umat-Nya.\""
 },
 {
   "id": 28330,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 11,
   "firman": "Dan lagi: \"Pujilah Tuhan, hai kamu semua bangsa-bangsa, dan biarlah segala suku bangsa memuji Dia.\""
 },
 {
   "id": 28331,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 12,
   "firman": "Dan selanjutnya kata Yesaya: \"Taruk dari pangkal Isai akan terbit, dan Ia akan bangkit untuk memerintah bangsa-bangsa, dan kepada-Nyalah bangsa-bangsa akan menaruh harapan.\""
 },
 {
   "id": 28332,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 13,
   "firman": "Semoga Allah, sumber pengharapan, memenuhi kamu dengan segala sukacita dan damai sejahtera dalam iman kamu, supaya oleh kekuatan Roh Kudus kamu berlimpah-limpah dalam pengharapan."
 },
 {
   "id": 28333,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 14,
   "firman": "Saudara-saudaraku, aku sendiri memang yakin tentang kamu, bahwa kamu juga telah penuh dengan kebaikan dan dengan segala pengetahuan dan sanggup untuk saling menasihati."
 },
 {
   "id": 28334,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 15,
   "firman": "Namun, karena kasih karunia yang telah dianugerahkan Allah kepadaku, aku di sana sini dengan agak berani telah menulis kepadamu untuk mengingatkan kamu,"
 },
 {
   "id": 28335,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 16,
   "firman": "yaitu bahwa aku boleh menjadi pelayan Kristus Yesus bagi bangsa-bangsa bukan Yahudi dalam pelayanan pemberitaan Injil Allah, supaya bangsa-bangsa bukan Yahudi dapat diterima oleh Allah sebagai persembahan yang berkenan kepada-Nya, yang disucikan oleh Roh Kudus."
 },
 {
   "id": 28336,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 17,
   "firman": "Jadi dalam Kristus aku boleh bermegah tentang pelayananku bagi Allah."
 },
 {
   "id": 28337,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 18,
   "firman": "Sebab aku tidak akan berani berkata-kata tentang sesuatu yang lain, kecuali tentang apa yang telah dikerjakan Kristus olehku, yaitu untuk memimpin bangsa-bangsa lain kepada ketaatan, oleh perkataan dan perbuatan,"
 },
 {
   "id": 28338,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 19,
   "firman": "oleh kuasa tanda-tanda dan mujizat-mujizat dan oleh kuasa Roh. Demikianlah dalam perjalanan keliling dari Yerusalem sampai ke Ilirikum aku telah memberitakan sepenuhnya Injil Kristus."
 },
 {
   "id": 28339,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 20,
   "firman": "Dan dalam pemberitaan itu aku menganggap sebagai kehormatanku, bahwa aku tidak melakukannya di tempat-tempat, di mana nama Kristus telah dikenal orang, supaya aku jangan membangun di atas dasar, yang telah diletakkan orang lain,"
 },
 {
   "id": 28340,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 21,
   "firman": "tetapi sesuai dengan yang ada tertulis: \"Mereka, yang belum pernah menerima berita tentang Dia, akan melihat Dia, dan mereka, yang tidak pernah mendengarnya, akan mengertinya.\""
 },
 {
   "id": 28341,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 22,
   "firman": "Itulah sebabnya aku selalu terhalang untuk mengunjungi kamu."
 },
 {
   "id": 28342,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 23,
   "firman": "Tetapi sekarang, karena aku tidak lagi mempunyai tempat kerja di daerah ini dan karena aku telah beberapa tahun lamanya ingin mengunjungi kamu,"
 },
 {
   "id": 28343,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 24,
   "firman": "aku harap dalam perjalananku ke Spanyol aku dapat singgah di tempatmu dan bertemu dengan kamu, sehingga kamu dapat mengantarkan aku ke sana, setelah aku seketika menikmati pertemuan dengan kamu."
 },
 {
   "id": 28344,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 25,
   "firman": "Tetapi sekarang aku sedang dalam perjalanan ke Yerusalem untuk mengantarkan bantuan kepada orang-orang kudus."
 },
 {
   "id": 28345,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 26,
   "firman": "Sebab Makedonia dan Akhaya telah mengambil keputusan untuk menyumbangkan sesuatu kepada orang-orang miskin di antara orang-orang kudus di Yerusalem."
 },
 {
   "id": 28346,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 27,
   "firman": "Keputusan itu memang telah mereka ambil, tetapi itu adalah kewajiban mereka. Sebab, jika bangsa-bangsa lain telah beroleh bagian dalam harta rohani orang Yahudi, maka wajiblah juga bangsa-bangsa lain itu melayani orang Yahudi dengan harta duniawi mereka."
 },
 {
   "id": 28347,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 28,
   "firman": "Apabila aku sudah menunaikan tugas itu dan sudah menyerahkan hasil usaha bangsa-bangsa lain itu kepada mereka, aku akan berangkat ke Spanyol melalui kota kamu."
 },
 {
   "id": 28348,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 29,
   "firman": "Dan aku tahu, bahwa jika aku datang mengunjungi kamu, aku akan melakukannya dengan penuh berkat Kristus."
 },
 {
   "id": 28349,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 30,
   "firman": "Tetapi demi Kristus, Tuhan kita, dan demi kasih Roh, aku menasihatkan kamu, saudara-saudara, untuk bergumul bersama-sama dengan aku dalam doa kepada Allah untuk aku,"
 },
 {
   "id": 28350,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 31,
   "firman": "supaya aku terpelihara dari orang-orang yang tidak taat di Yudea, dan supaya pelayananku untuk Yerusalem disambut dengan baik oleh orang-orang kudus di sana,"
 },
 {
   "id": 28351,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 32,
   "firman": "agar aku yang dengan sukacita datang kepadamu oleh kehendak Allah, beroleh kesegaran bersama-sama dengan kamu."
 },
 {
   "id": 28352,
   "kitab": "Rom",
   "pasal": 15,
   "ayat": 33,
   "firman": "Allah, sumber damai sejahtera, menyertai kamu sekalian! Amin."
 },
 {
   "id": 28353,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 1,
   "firman": "Aku meminta perhatianmu terhadap Febe, saudari kita yang melayani jemaat di Kengkrea,"
 },
 {
   "id": 28354,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 2,
   "firman": "supaya kamu menyambut dia dalam Tuhan, sebagaimana seharusnya bagi orang-orang kudus, dan berikanlah kepadanya bantuan bila diperlukannya. Sebab ia sendiri telah memberikan bantuan kepada banyak orang, juga kepadaku sendiri."
 },
 {
   "id": 28355,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 3,
   "firman": "Sampaikan salam kepada Priskila dan Akwila, teman-teman sekerjaku dalam Kristus Yesus."
 },
 {
   "id": 28356,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 4,
   "firman": "Mereka telah mempertaruhkan nyawanya untuk hidupku. Kepada mereka bukan aku saja yang berterima kasih, tetapi juga semua jemaat bukan Yahudi."
 },
 {
   "id": 28357,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 5,
   "firman": "Salam juga kepada jemaat di rumah mereka. Salam kepada Epenetus, saudara yang kukasihi, yang adalah buah pertama dari daerah Asia untuk Kristus."
 },
 {
   "id": 28358,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 6,
   "firman": "Salam kepada Maria, yang telah bekerja keras untuk kamu."
 },
 {
   "id": 28359,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 7,
   "firman": "Salam kepada Andronikus dan Yunias, saudara-saudaraku sebangsa, yang pernah dipenjarakan bersama-sama dengan aku, yaitu orang-orang yang terpandang di antara para rasul dan yang telah menjadi Kristen sebelum aku."
 },
 {
   "id": 28360,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 8,
   "firman": "Salam kepada Ampliatus yang kukasihi dalam Tuhan."
 },
 {
   "id": 28361,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 9,
   "firman": "Salam kepada Urbanus, teman sekerja kami dalam Kristus, dan salam kepada Stakhis, yang kukasihi."
 },
 {
   "id": 28362,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 10,
   "firman": "Salam kepada Apeles, yang telah tahan uji dalam Kristus. Salam kepada mereka, yang termasuk isi rumah Aristobulus."
 },
 {
   "id": 28363,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 11,
   "firman": "Salam kepada Herodion, temanku sebangsa. Salam kepada mereka yang termasuk isi rumah Narkisus, yang ada dalam Tuhan."
 },
 {
   "id": 28364,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 12,
   "firman": "Salam kepada Trifena dan Trifosa, yang bekerja membanting tulang dalam pelayanan Tuhan. Salam kepada Persis, yang kukasihi, yang telah bekerja membanting tulang dalam pelayanan Tuhan."
 },
 {
   "id": 28365,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 13,
   "firman": "Salam kepada Rufus, orang pilihan dalam Tuhan, dan salam kepada ibunya, yang bagiku adalah juga ibu."
 },
 {
   "id": 28366,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 14,
   "firman": "Salam kepada Asinkritus, Flegon, Hermes, Patrobas, Hermas dan saudara-saudara yang bersama-sama dengan mereka."
 },
 {
   "id": 28367,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 15,
   "firman": "Salam kepada Filologus, dan Yulia, Nereus dan saudaranya perempuan, dan Olimpas, dan juga kepada segala orang kudus yang bersama-sama dengan mereka."
 },
 {
   "id": 28368,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 16,
   "firman": "Bersalam-salamlah kamu dengan cium kudus. Salam kepada kamu dari semua jemaat Kristus."
 },
 {
   "id": 28369,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 17,
   "firman": "Tetapi aku menasihatkan kamu, saudara-saudara, supaya kamu waspada terhadap mereka, yang bertentangan dengan pengajaran yang telah kamu terima, menimbulkan perpecahan dan godaan. Sebab itu hindarilah mereka!"
 },
 {
   "id": 28370,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 18,
   "firman": "Sebab orang-orang demikian tidak melayani Kristus, Tuhan kita, tetapi melayani perut mereka sendiri. Dan dengan kata-kata mereka yang muluk-muluk dan bahasa mereka yang manis mereka menipu orang-orang yang tulus hatinya."
 },
 {
   "id": 28371,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 19,
   "firman": "Kabar tentang ketaatanmu telah terdengar oleh semua orang. Sebab itu aku bersukacita tentang kamu. Tetapi aku ingin supaya kamu bijaksana terhadap apa yang baik, dan bersih terhadap apa yang jahat."
 },
 {
   "id": 28372,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 20,
   "firman": "Semoga Allah, sumber damai sejahtera, segera akan menghancurkan Iblis di bawah kakimu. Kasih karunia Yesus, Tuhan kita, menyertai kamu!"
 },
 {
   "id": 28373,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 21,
   "firman": "Salam kepada kamu dari Timotius, temanku sekerja, dan dari Lukius, Yason dan Sosipater, teman-temanku sebangsa."
 },
 {
   "id": 28374,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 22,
   "firman": "Salam dalam Tuhan kepada kamu dari Tertius, yaitu aku, yang menulis surat ini."
 },
 {
   "id": 28375,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 23,
   "firman": "Salam kepada kamu dari Gayus, yang memberi tumpangan kepadaku, dan kepada seluruh jemaat. Salam kepada kamu dari Erastus, bendahara negeri, dan dari Kwartus, saudara kita."
 },
 {
   "id": 28376,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 24,
   "firman": "(Kasih karunia Yesus Kristus, Tuhan kita, menyertai kamu sekalian! Amin.)"
 },
 {
   "id": 28377,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 25,
   "firman": "Bagi Dia, yang berkuasa menguatkan kamu, --menurut Injil yang kumasyhurkan dan pemberitaan tentang Yesus Kristus, sesuai dengan pernyataan rahasia, yang didiamkan berabad-abad lamanya,"
 },
 {
   "id": 28378,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 26,
   "firman": "tetapi yang sekarang telah dinyatakan dan yang menurut perintah Allah yang abadi, telah diberitakan oleh kitab-kitab para nabi kepada segala bangsa untuk membimbing mereka kepada ketaatan iman--"
 },
 {
   "id": 28379,
   "kitab": "Rom",
   "pasal": 16,
   "ayat": 27,
   "firman": "bagi Dia, satu-satunya Allah yang penuh hikmat, oleh Yesus Kristus: segala kemuliaan sampai selama-lamanya! Amin."
 },
 {
   "id": 28380,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, yang oleh kehendak Allah dipanggil menjadi rasul Kristus Yesus, dan dari Sostenes, saudara kita,"
 },
 {
   "id": 28381,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 2,
   "firman": "kepada jemaat Allah di Korintus, yaitu mereka yang dikuduskan dalam Kristus Yesus dan yang dipanggil menjadi orang-orang kudus, dengan semua orang di segala tempat, yang berseru kepada nama Tuhan kita Yesus Kristus, yaitu Tuhan mereka dan Tuhan kita."
 },
 {
   "id": 28382,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 28383,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 4,
   "firman": "Aku senantiasa mengucap syukur kepada Allahku karena kamu atas kasih karunia Allah yang dianugerahkan-Nya kepada kamu dalam Kristus Yesus."
 },
 {
   "id": 28384,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab di dalam Dia kamu telah menjadi kaya dalam segala hal: dalam segala macam perkataan dan segala macam pengetahuan,"
 },
 {
   "id": 28385,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 6,
   "firman": "sesuai dengan kesaksian tentang Kristus, yang telah diteguhkan di antara kamu."
 },
 {
   "id": 28386,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 7,
   "firman": "Demikianlah kamu tidak kekurangan dalam suatu karuniapun sementara kamu menantikan penyataan Tuhan kita Yesus Kristus."
 },
 {
   "id": 28387,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 8,
   "firman": "Ia juga akan meneguhkan kamu sampai kepada kesudahannya, sehingga kamu tak bercacat pada hari Tuhan kita Yesus Kristus."
 },
 {
   "id": 28388,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 9,
   "firman": "Allah, yang memanggil kamu kepada persekutuan dengan Anak-Nya Yesus Kristus, Tuhan kita, adalah setia."
 },
 {
   "id": 28389,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 10,
   "firman": "Tetapi aku menasihatkan kamu, saudara-saudara, demi nama Tuhan kita Yesus Kristus, supaya kamu seia sekata dan jangan ada perpecahan di antara kamu, tetapi sebaliknya supaya kamu erat bersatu dan sehati sepikir."
 },
 {
   "id": 28390,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab, saudara-saudaraku, aku telah diberitahukan oleh orang-orang dari keluarga Kloe tentang kamu, bahwa ada perselisihan di antara kamu."
 },
 {
   "id": 28391,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 12,
   "firman": "Yang aku maksudkan ialah, bahwa kamu masing-masing berkata: Aku dari golongan Paulus. Atau aku dari golongan Apolos. Atau aku dari golongan Kefas. Atau aku dari golongan Kristus."
 },
 {
   "id": 28392,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 13,
   "firman": "Adakah Kristus terbagi-bagi? Adakah Paulus disalibkan karena kamu? Atau adakah kamu dibaptis dalam nama Paulus?"
 },
 {
   "id": 28393,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 14,
   "firman": "Aku mengucap syukur bahwa tidak ada seorangpun juga di antara kamu yang aku baptis selain Krispus dan Gayus,"
 },
 {
   "id": 28394,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 15,
   "firman": "sehingga tidak ada orang yang dapat mengatakan, bahwa kamu dibaptis dalam namaku."
 },
 {
   "id": 28395,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 16,
   "firman": "Juga keluarga Stefanus aku yang membaptisnya. Kecuali mereka aku tidak tahu, entahkah ada lagi orang yang aku baptis."
 },
 {
   "id": 28396,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 17,
   "firman": "Sebab Kristus mengutus aku bukan untuk membaptis, tetapi untuk memberitakan Injil; dan itupun bukan dengan hikmat perkataan, supaya salib Kristus jangan menjadi sia-sia."
 },
 {
   "id": 28397,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sebab pemberitaan tentang salib memang adalah kebodohan bagi mereka yang akan binasa, tetapi bagi kita yang diselamatkan pemberitaan itu adalah kekuatan Allah."
 },
 {
   "id": 28398,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena ada tertulis: \"Aku akan membinasakan hikmat orang-orang berhikmat dan kearifan orang-orang bijak akan Kulenyapkan.\""
 },
 {
   "id": 28399,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 20,
   "firman": "Di manakah orang yang berhikmat? Di manakah ahli Taurat? Di manakah pembantah dari dunia ini? Bukankah Allah telah membuat hikmat dunia ini menjadi kebodohan?"
 },
 {
   "id": 28400,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 21,
   "firman": "Oleh karena dunia, dalam hikmat Allah, tidak mengenal Allah oleh hikmatnya, maka Allah berkenan menyelamatkan mereka yang percaya oleh kebodohan pemberitaan Injil."
 },
 {
   "id": 28401,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 22,
   "firman": "Orang-orang Yahudi menghendaki tanda dan orang-orang Yunani mencari hikmat,"
 },
 {
   "id": 28402,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 23,
   "firman": "tetapi kami memberitakan Kristus yang disalibkan: untuk orang-orang Yahudi suatu batu sandungan dan untuk orang-orang bukan Yahudi suatu kebodohan,"
 },
 {
   "id": 28403,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 24,
   "firman": "tetapi untuk mereka yang dipanggil, baik orang Yahudi, maupun orang bukan Yahudi, Kristus adalah kekuatan Allah dan hikmat Allah."
 },
 {
   "id": 28404,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 25,
   "firman": "Sebab yang bodoh dari Allah lebih besar hikmatnya dari pada manusia dan yang lemah dari Allah lebih kuat dari pada manusia."
 },
 {
   "id": 28405,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 26,
   "firman": "Ingat saja, saudara-saudara, bagaimana keadaan kamu, ketika kamu dipanggil: menurut ukuran manusia tidak banyak orang yang bijak, tidak banyak orang yang berpengaruh, tidak banyak orang yang terpandang."
 },
 {
   "id": 28406,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 27,
   "firman": "Tetapi apa yang bodoh bagi dunia, dipilih Allah untuk memalukan orang-orang yang berhikmat, dan apa yang lemah bagi dunia, dipilih Allah untuk memalukan apa yang kuat,"
 },
 {
   "id": 28407,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 28,
   "firman": "dan apa yang tidak terpandang dan yang hina bagi dunia, dipilih Allah, bahkan apa yang tidak berarti, dipilih Allah untuk meniadakan apa yang berarti,"
 },
 {
   "id": 28408,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 29,
   "firman": "supaya jangan ada seorang manusiapun yang memegahkan diri di hadapan Allah."
 },
 {
   "id": 28409,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 30,
   "firman": "Tetapi oleh Dia kamu berada dalam Kristus Yesus, yang oleh Allah telah menjadi hikmat bagi kita. Ia membenarkan dan menguduskan dan menebus kita."
 },
 {
   "id": 28410,
   "kitab": "1Ko",
   "pasal": 1,
   "ayat": 31,
   "firman": "Karena itu seperti ada tertulis: \"Barangsiapa yang bermegah, hendaklah ia bermegah di dalam Tuhan.\""
 },
 {
   "id": 28411,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 1,
   "firman": "Demikianlah pula, ketika aku datang kepadamu, saudara-saudara, aku tidak datang dengan kata-kata yang indah atau dengan hikmat untuk menyampaikan kesaksian Allah kepada kamu."
 },
 {
   "id": 28412,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sebab aku telah memutuskan untuk tidak mengetahui apa-apa di antara kamu selain Yesus Kristus, yaitu Dia yang disalibkan."
 },
 {
   "id": 28413,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 3,
   "firman": "Aku juga telah datang kepadamu dalam kelemahan dan dengan sangat takut dan gentar."
 },
 {
   "id": 28414,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 4,
   "firman": "Baik perkataanku maupun pemberitaanku tidak kusampaikan dengan kata-kata hikmat yang meyakinkan, tetapi dengan keyakinan akan kekuatan Roh,"
 },
 {
   "id": 28415,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 5,
   "firman": "supaya iman kamu jangan bergantung pada hikmat manusia, tetapi pada kekuatan Allah."
 },
 {
   "id": 28416,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 6,
   "firman": "Sungguhpun demikian kami memberitakan hikmat di kalangan mereka yang telah matang, yaitu hikmat yang bukan dari dunia ini, dan yang bukan dari penguasa-penguasa dunia ini, yaitu penguasa-penguasa yang akan ditiadakan."
 },
 {
   "id": 28417,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tetapi yang kami beritakan ialah hikmat Allah yang tersembunyi dan rahasia, yang sebelum dunia dijadikan, telah disediakan Allah bagi kemuliaan kita."
 },
 {
   "id": 28418,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 8,
   "firman": "Tidak ada dari penguasa dunia ini yang mengenalnya, sebab kalau sekiranya mereka mengenalnya, mereka tidak menyalibkan Tuhan yang mulia."
 },
 {
   "id": 28419,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tetapi seperti ada tertulis: \"Apa yang tidak pernah dilihat oleh mata, dan tidak pernah didengar oleh telinga, dan yang tidak pernah timbul di dalam hati manusia: semua yang disediakan Allah untuk mereka yang mengasihi Dia.\""
 },
 {
   "id": 28420,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 10,
   "firman": "Karena kepada kita Allah telah menyatakannya oleh Roh, sebab Roh menyelidiki segala sesuatu, bahkan hal-hal yang tersembunyi dalam diri Allah."
 },
 {
   "id": 28421,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 11,
   "firman": "Siapa gerangan di antara manusia yang tahu, apa yang terdapat di dalam diri manusia selain roh manusia sendiri yang ada di dalam dia? Demikian pulalah tidak ada orang yang tahu, apa yang terdapat di dalam diri Allah selain Roh Allah."
 },
 {
   "id": 28422,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 12,
   "firman": "Kita tidak menerima roh dunia, tetapi roh yang berasal dari Allah, supaya kita tahu, apa yang dikaruniakan Allah kepada kita."
 },
 {
   "id": 28423,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan karena kami menafsirkan hal-hal rohani kepada mereka yang mempunyai Roh, kami berkata-kata tentang karunia-karunia Allah dengan perkataan yang bukan diajarkan kepada kami oleh hikmat manusia, tetapi oleh Roh."
 },
 {
   "id": 28424,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 14,
   "firman": "Tetapi manusia duniawi tidak menerima apa yang berasal dari Roh Allah, karena hal itu baginya adalah suatu kebodohan; dan ia tidak dapat memahaminya, sebab hal itu hanya dapat dinilai secara rohani."
 },
 {
   "id": 28425,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 15,
   "firman": "Tetapi manusia rohani menilai segala sesuatu, tetapi ia sendiri tidak dinilai oleh orang lain."
 },
 {
   "id": 28426,
   "kitab": "1Ko",
   "pasal": 2,
   "ayat": 16,
   "firman": "Sebab: \"Siapakah yang mengetahui pikiran Tuhan, sehingga ia dapat menasihati Dia?\" Tetapi kami memiliki pikiran Kristus."
 },
 {
   "id": 28427,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 1,
   "firman": "Dan aku, saudara-saudara, pada waktu itu tidak dapat berbicara dengan kamu seperti dengan manusia rohani, tetapi hanya dengan manusia duniawi, yang belum dewasa dalam Kristus."
 },
 {
   "id": 28428,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 2,
   "firman": "Susulah yang kuberikan kepadamu, bukanlah makanan keras, sebab kamu belum dapat menerimanya. Dan sekarangpun kamu belum dapat menerimanya."
 },
 {
   "id": 28429,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 3,
   "firman": "Karena kamu masih manusia duniawi. Sebab, jika di antara kamu ada iri hati dan perselisihan bukankah hal itu menunjukkan, bahwa kamu manusia duniawi dan bahwa kamu hidup secara manusiawi?"
 },
 {
   "id": 28430,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 4,
   "firman": "Karena jika yang seorang berkata: \"Aku dari golongan Paulus,\" dan yang lain berkata: \"Aku dari golongan Apolos,\" bukankah hal itu menunjukkan, bahwa kamu manusia duniawi yang bukan rohani?"
 },
 {
   "id": 28431,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 5,
   "firman": "Jadi, apakah Apolos? Apakah Paulus? Pelayan-pelayan Tuhan yang olehnya kamu menjadi percaya, masing-masing menurut jalan yang diberikan Tuhan kepadanya."
 },
 {
   "id": 28432,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 6,
   "firman": "Aku menanam, Apolos menyiram, tetapi Allah yang memberi pertumbuhan."
 },
 {
   "id": 28433,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 7,
   "firman": "Karena itu yang penting bukanlah yang menanam atau yang menyiram, melainkan Allah yang memberi pertumbuhan."
 },
 {
   "id": 28434,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 8,
   "firman": "Baik yang menanam maupun yang menyiram adalah sama; dan masing-masing akan menerima upahnya sesuai dengan pekerjaannya sendiri."
 },
 {
   "id": 28435,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 9,
   "firman": "Karena kami adalah kawan sekerja Allah; kamu adalah ladang Allah, bangunan Allah."
 },
 {
   "id": 28436,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 10,
   "firman": "Sesuai dengan kasih karunia Allah, yang dianugerahkan kepadaku, aku sebagai seorang ahli bangunan yang cakap telah meletakkan dasar, dan orang lain membangun terus di atasnya. Tetapi tiap-tiap orang harus memperhatikan, bagaimana ia harus membangun di atasnya."
 },
 {
   "id": 28437,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 11,
   "firman": "Karena tidak ada seorangpun yang dapat meletakkan dasar lain dari pada dasar yang telah diletakkan, yaitu Yesus Kristus."
 },
 {
   "id": 28438,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 12,
   "firman": "Entahkah orang membangun di atas dasar ini dengan emas, perak, batu permata, kayu, rumput kering atau jerami,"
 },
 {
   "id": 28439,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 13,
   "firman": "sekali kelak pekerjaan masing-masing orang akan nampak. Karena hari Tuhan akan menyatakannya, sebab ia akan nampak dengan api dan bagaimana pekerjaan masing-masing orang akan diuji oleh api itu."
 },
 {
   "id": 28440,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 14,
   "firman": "Jika pekerjaan yang dibangun seseorang tahan uji, ia akan mendapat upah."
 },
 {
   "id": 28441,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 15,
   "firman": "Jika pekerjaannya terbakar, ia akan menderita kerugian, tetapi ia sendiri akan diselamatkan, tetapi seperti dari dalam api."
 },
 {
   "id": 28442,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 16,
   "firman": "Tidak tahukah kamu, bahwa kamu adalah bait Allah dan bahwa Roh Allah diam di dalam kamu?"
 },
 {
   "id": 28443,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 17,
   "firman": "Jika ada orang yang membinasakan bait Allah, maka Allah akan membinasakan dia. Sebab bait Allah adalah kudus dan bait Allah itu ialah kamu."
 },
 {
   "id": 28444,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 18,
   "firman": "Janganlah ada orang yang menipu dirinya sendiri. Jika ada di antara kamu yang menyangka dirinya berhikmat menurut dunia ini, biarlah ia menjadi bodoh, supaya ia berhikmat."
 },
 {
   "id": 28445,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 19,
   "firman": "Karena hikmat dunia ini adalah kebodohan bagi Allah. Sebab ada tertulis: \"Ia yang menangkap orang berhikmat dalam kecerdikannya.\""
 },
 {
   "id": 28446,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 20,
   "firman": "Dan di tempat lain: \"Tuhan mengetahui rancangan-rancangan orang berhikmat; sesungguhnya semuanya sia-sia belaka.\""
 },
 {
   "id": 28447,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 21,
   "firman": "Karena itu janganlah ada orang yang memegahkan dirinya atas manusia, sebab segala sesuatu adalah milikmu:"
 },
 {
   "id": 28448,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 22,
   "firman": "baik Paulus, Apolos, maupun Kefas, baik dunia, hidup, maupun mati, baik waktu sekarang, maupun waktu yang akan datang. Semuanya kamu punya."
 },
 {
   "id": 28449,
   "kitab": "1Ko",
   "pasal": 3,
   "ayat": 23,
   "firman": "Tetapi kamu adalah milik Kristus dan Kristus adalah milik Allah."
 },
 {
   "id": 28450,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 1,
   "firman": "Demikianlah hendaknya orang memandang kami: sebagai hamba-hamba Kristus, yang kepadanya dipercayakan rahasia Allah."
 },
 {
   "id": 28451,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 2,
   "firman": "Yang akhirnya dituntut dari pelayan-pelayan yang demikian ialah, bahwa mereka ternyata dapat dipercayai."
 },
 {
   "id": 28452,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 3,
   "firman": "Bagiku sedikit sekali artinya entahkah aku dihakimi oleh kamu atau oleh suatu pengadilan manusia. Malahan diriku sendiripun tidak kuhakimi."
 },
 {
   "id": 28453,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 4,
   "firman": "Sebab memang aku tidak sadar akan sesuatu, tetapi bukan karena itulah aku dibenarkan. Dia, yang menghakimi aku, ialah Tuhan."
 },
 {
   "id": 28454,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 5,
   "firman": "Karena itu, janganlah menghakimi sebelum waktunya, yaitu sebelum Tuhan datang. Ia akan menerangi, juga apa yang tersembunyi dalam kegelapan, dan Ia akan memperlihatkan apa yang direncanakan di dalam hati. Maka tiap-tiap orang akan menerima pujian dari Allah."
 },
 {
   "id": 28455,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 6,
   "firman": "Saudara-saudara, kata-kata ini aku kenakan pada diriku sendiri dan pada Apolos, karena kamu, supaya dari teladan kami kamu belajar apakah artinya ungkapan: \"Jangan melampaui yang ada tertulis\", supaya jangan ada di antara kamu yang menyombongkan diri dengan jalan mengutamakan yang satu dari pada yang lain."
 },
 {
   "id": 28456,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 7,
   "firman": "Sebab siapakah yang menganggap engkau begitu penting? Dan apakah yang engkau punyai, yang tidak engkau terima? Dan jika engkau memang menerimanya, mengapakah engkau memegahkan diri, seolah-olah engkau tidak menerimanya?"
 },
 {
   "id": 28457,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 8,
   "firman": "Kamu telah kenyang, kamu telah menjadi kaya, tanpa kami kamu telah menjadi raja. Ah, alangkah baiknya kalau benar demikian, bahwa kamu telah menjadi raja, sehingga kamipun turut menjadi raja dengan kamu."
 },
 {
   "id": 28458,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 9,
   "firman": "Sebab, menurut pendapatku, Allah memberikan kepada kami, para rasul, tempat yang paling rendah, sama seperti orang-orang yang telah dijatuhi hukuman mati, sebab kami telah menjadi tontonan bagi dunia, bagi malaikat-malaikat dan bagi manusia."
 },
 {
   "id": 28459,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 10,
   "firman": "Kami bodoh oleh karena Kristus, tetapi kamu arif dalam Kristus. Kami lemah, tetapi kamu kuat. Kamu mulia, tetapi kami hina."
 },
 {
   "id": 28460,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 11,
   "firman": "Sampai pada saat ini kami lapar, haus, telanjang, dipukul dan hidup mengembara,"
 },
 {
   "id": 28461,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 12,
   "firman": "kami melakukan pekerjaan tangan yang berat. Kalau kami dimaki, kami memberkati; kalau kami dianiaya, kami sabar;"
 },
 {
   "id": 28462,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 13,
   "firman": "kalau kami difitnah, kami tetap menjawab dengan ramah; kami telah menjadi sama dengan sampah dunia, sama dengan kotoran dari segala sesuatu, sampai pada saat ini."
 },
 {
   "id": 28463,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 14,
   "firman": "Hal ini kutuliskan bukan untuk memalukan kamu, tetapi untuk menegor kamu sebagai anak-anakku yang kukasihi."
 },
 {
   "id": 28464,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sebab sekalipun kamu mempunyai beribu-ribu pendidik dalam Kristus, kamu tidak mempunyai banyak bapa. Karena akulah yang dalam Kristus Yesus telah menjadi bapamu oleh Injil yang kuberitakan kepadamu."
 },
 {
   "id": 28465,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sebab itu aku menasihatkan kamu: turutilah teladanku!"
 },
 {
   "id": 28466,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 17,
   "firman": "Justru itulah sebabnya aku mengirimkan kepadamu Timotius, yang adalah anakku yang kekasih dan yang setia dalam Tuhan. Ia akan memperingatkan kamu akan hidup yang kuturuti dalam Kristus Yesus, seperti yang kuajarkan di mana-mana dalam setiap jemaat."
 },
 {
   "id": 28467,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 18,
   "firman": "Tetapi ada beberapa orang yang menjadi sombong, karena mereka menyangka, bahwa aku tidak akan datang lagi kepadamu."
 },
 {
   "id": 28468,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 19,
   "firman": "Tetapi aku akan segera datang kepadamu, kalau Tuhan menghendakinya. Maka aku akan tahu, bukan tentang perkataan orang-orang yang sombong itu, tetapi tentang kekuatan mereka."
 },
 {
   "id": 28469,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 20,
   "firman": "Sebab Kerajaan Allah bukan terdiri dari perkataan, tetapi dari kuasa."
 },
 {
   "id": 28470,
   "kitab": "1Ko",
   "pasal": 4,
   "ayat": 21,
   "firman": "Apakah yang kamu kehendaki? Haruskah aku datang kepadamu dengan cambuk atau dengan kasih dan dengan hati yang lemah lembut?"
 },
 {
   "id": 28471,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 1,
   "firman": "Memang orang mendengar, bahwa ada percabulan di antara kamu, dan percabulan yang begitu rupa, seperti yang tidak terdapat sekalipun di antara bangsa-bangsa yang tidak mengenal Allah, yaitu bahwa ada orang yang hidup dengan isteri ayahnya."
 },
 {
   "id": 28472,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 2,
   "firman": "Sekalipun demikian kamu sombong. Tidakkah lebih patut kamu berdukacita dan menjauhkan orang yang melakukan hal itu dari tengah-tengah kamu?"
 },
 {
   "id": 28473,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 3,
   "firman": "Sebab aku, sekalipun secara badani tidak hadir, tetapi secara rohani hadir, aku--sama seperti aku hadir--telah menjatuhkan hukuman atas dia, yang telah melakukan hal yang semacam itu."
 },
 {
   "id": 28474,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 4,
   "firman": "Bilamana kita berkumpul dalam roh, kamu bersama-sama dengan aku, dengan kuasa Yesus, Tuhan kita,"
 },
 {
   "id": 28475,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 5,
   "firman": "orang itu harus kita serahkan dalam nama Tuhan Yesus kepada Iblis, sehingga binasa tubuhnya, agar rohnya diselamatkan pada hari Tuhan."
 },
 {
   "id": 28476,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 6,
   "firman": "Kemegahanmu tidak baik. Tidak tahukah kamu, bahwa sedikit ragi mengkhamiri seluruh adonan?"
 },
 {
   "id": 28477,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 7,
   "firman": "Buanglah ragi yang lama itu, supaya kamu menjadi adonan yang baru, sebab kamu memang tidak beragi. Sebab anak domba Paskah kita juga telah disembelih, yaitu Kristus."
 },
 {
   "id": 28478,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 8,
   "firman": "Karena itu marilah kita berpesta, bukan dengan ragi yang lama, bukan pula dengan ragi keburukan dan kejahatan, tetapi dengan roti yang tidak beragi, yaitu kemurnian dan kebenaran."
 },
 {
   "id": 28479,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dalam suratku telah kutuliskan kepadamu, supaya kamu jangan bergaul dengan orang-orang cabul."
 },
 {
   "id": 28480,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 10,
   "firman": "Yang aku maksudkan bukanlah dengan semua orang cabul pada umumnya dari dunia ini atau dengan semua orang kikir dan penipu atau dengan semua penyembah berhala, karena jika demikian kamu harus meninggalkan dunia ini."
 },
 {
   "id": 28481,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 11,
   "firman": "Tetapi yang kutuliskan kepada kamu ialah, supaya kamu jangan bergaul dengan orang, yang sekalipun menyebut dirinya saudara, adalah orang cabul, kikir, penyembah berhala, pemfitnah, pemabuk atau penipu; dengan orang yang demikian janganlah kamu sekali-kali makan bersama-sama."
 },
 {
   "id": 28482,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab dengan wewenang apakah aku menghakimi mereka, yang berada di luar jemaat? Bukankah kamu hanya menghakimi mereka yang berada di dalam jemaat?"
 },
 {
   "id": 28483,
   "kitab": "1Ko",
   "pasal": 5,
   "ayat": 13,
   "firman": "Mereka yang berada di luar jemaat akan dihakimi Allah. Usirlah orang yang melakukan kejahatan dari tengah-tengah kamu."
 },
 {
   "id": 28484,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 1,
   "firman": "Apakah ada seorang di antara kamu, yang jika berselisih dengan orang lain, berani mencari keadilan pada orang-orang yang tidak benar, dan bukan pada orang-orang kudus?"
 },
 {
   "id": 28485,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 2,
   "firman": "Atau tidak tahukah kamu, bahwa orang-orang kudus akan menghakimi dunia? Dan jika penghakiman dunia berada dalam tangan kamu, tidakkah kamu sanggup untuk mengurus perkara-perkara yang tidak berarti?"
 },
 {
   "id": 28486,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 3,
   "firman": "Tidak tahukah kamu, bahwa kita akan menghakimi malaikat-malaikat? Jadi apalagi perkara-perkara biasa dalam hidup kita sehari-hari."
 },
 {
   "id": 28487,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sekalipun demikian, jika kamu harus mengurus perkara-perkara biasa, kamu menyerahkan urusan itu kepada mereka yang tidak berarti dalam jemaat?"
 },
 {
   "id": 28488,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 5,
   "firman": "Hal ini kukatakan untuk memalukan kamu. Tidak adakah seorang di antara kamu yang berhikmat, yang dapat mengurus perkara-perkara dari saudara-saudaranya?"
 },
 {
   "id": 28489,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 6,
   "firman": "Adakah saudara yang satu mencari keadilan terhadap saudara yang lain, dan justru pada orang-orang yang tidak percaya?"
 },
 {
   "id": 28490,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 7,
   "firman": "Adanya saja perkara di antara kamu yang seorang terhadap yang lain telah merupakan kekalahan bagi kamu. Mengapa kamu tidak lebih suka menderita ketidakadilan? Mengapakah kamu tidak lebih suka dirugikan?"
 },
 {
   "id": 28491,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tetapi kamu sendiri melakukan ketidakadilan dan kamu sendiri mendatangkan kerugian, dan hal itu kamu buat terhadap saudara-saudaramu."
 },
 {
   "id": 28492,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 9,
   "firman": "Atau tidak tahukah kamu, bahwa orang-orang yang tidak adil tidak akan mendapat bagian dalam Kerajaan Allah? Janganlah sesat! Orang cabul, penyembah berhala, orang berzinah, banci, orang pemburit,"
 },
 {
   "id": 28493,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 10,
   "firman": "pencuri, orang kikir, pemabuk, pemfitnah dan penipu tidak akan mendapat bagian dalam Kerajaan Allah."
 },
 {
   "id": 28494,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 11,
   "firman": "Dan beberapa orang di antara kamu demikianlah dahulu. Tetapi kamu telah memberi dirimu disucikan, kamu telah dikuduskan, kamu telah dibenarkan dalam nama Tuhan Yesus Kristus dan dalam Roh Allah kita."
 },
 {
   "id": 28495,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 12,
   "firman": "Segala sesuatu halal bagiku, tetapi bukan semuanya berguna. Segala sesuatu halal bagiku, tetapi aku tidak membiarkan diriku diperhamba oleh suatu apapun."
 },
 {
   "id": 28496,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 13,
   "firman": "Makanan adalah untuk perut dan perut untuk makanan: tetapi kedua-duanya akan dibinasakan Allah. Tetapi tubuh bukanlah untuk percabulan, melainkan untuk Tuhan, dan Tuhan untuk tubuh."
 },
 {
   "id": 28497,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 14,
   "firman": "Allah, yang membangkitkan Tuhan, akan membangkitkan kita juga oleh kuasa-Nya."
 },
 {
   "id": 28498,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 15,
   "firman": "Tidak tahukah kamu, bahwa tubuhmu adalah anggota Kristus? Akan kuambilkah anggota Kristus untuk menyerahkannya kepada percabulan? Sekali-kali tidak!"
 },
 {
   "id": 28499,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 16,
   "firman": "Atau tidak tahukah kamu, bahwa siapa yang mengikatkan dirinya pada perempuan cabul, menjadi satu tubuh dengan dia? Sebab, demikianlah kata nas: \"Keduanya akan menjadi satu daging.\""
 },
 {
   "id": 28500,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 17,
   "firman": "Tetapi siapa yang mengikatkan dirinya pada Tuhan, menjadi satu roh dengan Dia."
 },
 {
   "id": 28501,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 18,
   "firman": "Jauhkanlah dirimu dari percabulan! Setiap dosa lain yang dilakukan manusia, terjadi di luar dirinya. Tetapi orang yang melakukan percabulan berdosa terhadap dirinya sendiri."
 },
 {
   "id": 28502,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 19,
   "firman": "Atau tidak tahukah kamu, bahwa tubuhmu adalah bait Roh Kudus yang diam di dalam kamu, Roh Kudus yang kamu peroleh dari Allah, --dan bahwa kamu bukan milik kamu sendiri?"
 },
 {
   "id": 28503,
   "kitab": "1Ko",
   "pasal": 6,
   "ayat": 20,
   "firman": "Sebab kamu telah dibeli dan harganya telah lunas dibayar: Karena itu muliakanlah Allah dengan tubuhmu!"
 },
 {
   "id": 28504,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 1,
   "firman": "Dan sekarang tentang hal-hal yang kamu tuliskan kepadaku. Adalah baik bagi laki-laki, kalau ia tidak kawin,"
 },
 {
   "id": 28505,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 2,
   "firman": "tetapi mengingat bahaya percabulan, baiklah setiap laki-laki mempunyai isterinya sendiri dan setiap perempuan mempunyai suaminya sendiri."
 },
 {
   "id": 28506,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 3,
   "firman": "Hendaklah suami memenuhi kewajibannya terhadap isterinya, demikian pula isteri terhadap suaminya."
 },
 {
   "id": 28507,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 4,
   "firman": "Isteri tidak berkuasa atas tubuhnya sendiri, tetapi suaminya, demikian pula suami tidak berkuasa atas tubuhnya sendiri, tetapi isterinya."
 },
 {
   "id": 28508,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 5,
   "firman": "Janganlah kamu saling menjauhi, kecuali dengan persetujuan bersama untuk sementara waktu, supaya kamu mendapat kesempatan untuk berdoa. Sesudah itu hendaklah kamu kembali hidup bersama-sama, supaya Iblis jangan menggodai kamu, karena kamu tidak tahan bertarak."
 },
 {
   "id": 28509,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 6,
   "firman": "Hal ini kukatakan kepadamu sebagai kelonggaran, bukan sebagai perintah."
 },
 {
   "id": 28510,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 7,
   "firman": "Namun demikian alangkah baiknya, kalau semua orang seperti aku; tetapi setiap orang menerima dari Allah karunianya yang khas, yang seorang karunia ini, yang lain karunia itu."
 },
 {
   "id": 28511,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 8,
   "firman": "Tetapi kepada orang-orang yang tidak kawin dan kepada janda-janda aku anjurkan, supaya baiklah mereka tinggal dalam keadaan seperti aku."
 },
 {
   "id": 28512,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 9,
   "firman": "Tetapi kalau mereka tidak dapat menguasai diri, baiklah mereka kawin. Sebab lebih baik kawin dari pada hangus karena hawa nafsu."
 },
 {
   "id": 28513,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 10,
   "firman": "Kepada orang-orang yang telah kawin aku--tidak, bukan aku, tetapi Tuhan--perintahkan, supaya seorang isteri tidak boleh menceraikan suaminya."
 },
 {
   "id": 28514,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 11,
   "firman": "Dan jikalau ia bercerai, ia harus tetap hidup tanpa suami atau berdamai dengan suaminya. Dan seorang suami tidak boleh menceraikan isterinya."
 },
 {
   "id": 28515,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 12,
   "firman": "Kepada orang-orang lain aku, bukan Tuhan, katakan: kalau ada seorang saudara beristerikan seorang yang tidak beriman dan perempuan itu mau hidup bersama-sama dengan dia, janganlah saudara itu menceraikan dia."
 },
 {
   "id": 28516,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 13,
   "firman": "Dan kalau ada seorang isteri bersuamikan seorang yang tidak beriman dan laki-laki itu mau hidup bersama-sama dengan dia, janganlah ia menceraikan laki-laki itu."
 },
 {
   "id": 28517,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 14,
   "firman": "Karena suami yang tidak beriman itu dikuduskan oleh isterinya dan isteri yang tidak beriman itu dikuduskan oleh suaminya. Andaikata tidak demikian, niscaya anak-anakmu adalah anak cemar, tetapi sekarang mereka adalah anak-anak kudus."
 },
 {
   "id": 28518,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 15,
   "firman": "Tetapi kalau orang yang tidak beriman itu mau bercerai, biarlah ia bercerai; dalam hal yang demikian saudara atau saudari tidak terikat. Tetapi Allah memanggil kamu untuk hidup dalam damai sejahtera."
 },
 {
   "id": 28519,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 16,
   "firman": "Sebab bagaimanakah engkau mengetahui, hai isteri, apakah engkau tidak akan menyelamatkan suamimu? Atau bagaimanakah engkau mengetahui, hai suami, apakah engkau tidak akan menyelamatkan isterimu?"
 },
 {
   "id": 28520,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 17,
   "firman": "Selanjutnya hendaklah tiap-tiap orang tetap hidup seperti yang telah ditentukan Tuhan baginya dan dalam keadaan seperti waktu ia dipanggil Allah. Inilah ketetapan yang kuberikan kepada semua jemaat."
 },
 {
   "id": 28521,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 18,
   "firman": "Kalau seorang dipanggil dalam keadaan bersunat, janganlah ia berusaha meniadakan tanda-tanda sunat itu. Dan kalau seorang dipanggil dalam keadaan tidak bersunat, janganlah ia mau bersunat."
 },
 {
   "id": 28522,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 19,
   "firman": "Sebab bersunat atau tidak bersunat tidak penting. Yang penting ialah mentaati hukum-hukum Allah."
 },
 {
   "id": 28523,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 20,
   "firman": "Baiklah tiap-tiap orang tinggal dalam keadaan, seperti waktu ia dipanggil Allah."
 },
 {
   "id": 28524,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 21,
   "firman": "Adakah engkau hamba waktu engkau dipanggil? Itu tidak apa-apa! Tetapi jikalau engkau mendapat kesempatan untuk dibebaskan, pergunakanlah kesempatan itu."
 },
 {
   "id": 28525,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 22,
   "firman": "Sebab seorang hamba yang dipanggil oleh Tuhan dalam pelayanan-Nya, adalah orang bebas, milik Tuhan. Demikian pula orang bebas yang dipanggil Kristus, adalah hamba-Nya."
 },
 {
   "id": 28526,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 23,
   "firman": "Kamu telah dibeli dan harganya telah lunas dibayar. Karena itu janganlah kamu menjadi hamba manusia."
 },
 {
   "id": 28527,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 24,
   "firman": "Saudara-saudara, hendaklah tiap-tiap orang tinggal di hadapan Allah dalam keadaan seperti pada waktu ia dipanggil."
 },
 {
   "id": 28528,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 25,
   "firman": "Sekarang tentang para gadis. Untuk mereka aku tidak mendapat perintah dari Tuhan. Tetapi aku memberikan pendapatku sebagai seorang yang dapat dipercayai karena rahmat yang diterimanya dari Allah."
 },
 {
   "id": 28529,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 26,
   "firman": "Aku berpendapat, bahwa, mengingat waktu darurat sekarang, adalah baik bagi manusia untuk tetap dalam keadaannya."
 },
 {
   "id": 28530,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 27,
   "firman": "Adakah engkau terikat pada seorang perempuan? Janganlah engkau mengusahakan perceraian! Adakah engkau tidak terikat pada seorang perempuan? Janganlah engkau mencari seorang!"
 },
 {
   "id": 28531,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 28,
   "firman": "Tetapi, kalau engkau kawin, engkau tidak berdosa. Dan kalau seorang gadis kawin, ia tidak berbuat dosa. Tetapi orang-orang yang demikian akan ditimpa kesusahan badani dan aku mau menghindarkan kamu dari kesusahan itu."
 },
 {
   "id": 28532,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 29,
   "firman": "Saudara-saudara, inilah yang kumaksudkan, yaitu: waktu telah singkat! Karena itu dalam waktu yang masih sisa ini orang-orang yang beristeri harus berlaku seolah-olah mereka tidak beristeri;"
 },
 {
   "id": 28533,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 30,
   "firman": "dan orang-orang yang menangis seolah-olah tidak menangis; dan orang-orang yang bergembira seolah-olah tidak bergembira; dan orang-orang yang membeli seolah-olah tidak memiliki apa yang mereka beli;"
 },
 {
   "id": 28534,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 31,
   "firman": "pendeknya orang-orang yang mempergunakan barang-barang duniawi seolah-olah sama sekali tidak mempergunakannya. Sebab dunia seperti yang kita kenal sekarang akan berlalu."
 },
 {
   "id": 28535,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 32,
   "firman": "Aku ingin, supaya kamu hidup tanpa kekuatiran. Orang yang tidak beristeri memusatkan perhatiannya pada perkara Tuhan, bagaimana Tuhan berkenan kepadanya."
 },
 {
   "id": 28536,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 33,
   "firman": "Orang yang beristeri memusatkan perhatiannya pada perkara duniawi, bagaimana ia dapat menyenangkan isterinya,"
 },
 {
   "id": 28537,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 34,
   "firman": "dan dengan demikian perhatiannya terbagi-bagi. Perempuan yang tidak bersuami dan anak-anak gadis memusatkan perhatian mereka pada perkara Tuhan, supaya tubuh dan jiwa mereka kudus. Tetapi perempuan yang bersuami memusatkan perhatiannya pada perkara duniawi, bagaimana ia dapat menyenangkan suaminya."
 },
 {
   "id": 28538,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 35,
   "firman": "Semuanya ini kukatakan untuk kepentingan kamu sendiri, bukan untuk menghalang-halangi kamu dalam kebebasan kamu, tetapi sebaliknya supaya kamu melakukan apa yang benar dan baik, dan melayani Tuhan tanpa gangguan."
 },
 {
   "id": 28539,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 36,
   "firman": "Tetapi jikalau seorang menyangka, bahwa ia tidak berlaku wajar terhadap gadisnya, jika gadisnya itu telah bertambah tua dan ia benar-benar merasa, bahwa mereka harus kawin, baiklah mereka kawin, kalau ia menghendakinya. Hal itu bukan dosa."
 },
 {
   "id": 28540,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 37,
   "firman": "Tetapi kalau ada seorang, yang tidak dipaksa untuk berbuat demikian, benar-benar yakin dalam hatinya dan benar-benar menguasai kemauannya, telah mengambil keputusan untuk tidak kawin dengan gadisnya, ia berbuat baik."
 },
 {
   "id": 28541,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 38,
   "firman": "Jadi orang yang kawin dengan gadisnya berbuat baik, dan orang yang tidak kawin dengan gadisnya berbuat lebih baik."
 },
 {
   "id": 28542,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 39,
   "firman": "Isteri terikat selama suaminya hidup. Kalau suaminya telah meninggal, ia bebas untuk kawin dengan siapa saja yang dikehendakinya, asal orang itu adalah seorang yang percaya."
 },
 {
   "id": 28543,
   "kitab": "1Ko",
   "pasal": 7,
   "ayat": 40,
   "firman": "Tetapi menurut pendapatku, ia lebih berbahagia, kalau ia tetap tinggal dalam keadaannya. Dan aku berpendapat, bahwa aku juga mempunyai Roh Allah."
 },
 {
   "id": 28544,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 1,
   "firman": "Tentang daging persembahan berhala kita tahu: \"kita semua mempunyai pengetahuan.\" Pengetahuan yang demikian membuat orang menjadi sombong, tetapi kasih membangun."
 },
 {
   "id": 28545,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 2,
   "firman": "Jika ada seorang menyangka, bahwa ia mempunyai sesuatu \"pengetahuan\", maka ia belum juga mencapai pengetahuan, sebagaimana yang harus dicapainya."
 },
 {
   "id": 28546,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 3,
   "firman": "Tetapi orang yang mengasihi Allah, ia dikenal oleh Allah."
 },
 {
   "id": 28547,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 4,
   "firman": "Tentang hal makan daging persembahan berhala kita tahu: \"tidak ada berhala di dunia dan tidak ada Allah lain dari pada Allah yang esa.\""
 },
 {
   "id": 28548,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 5,
   "firman": "Sebab sungguhpun ada apa yang disebut \"allah\", baik di sorga, maupun di bumi--dan memang benar ada banyak \"allah\" dan banyak \"tuhan\" yang demikian--"
 },
 {
   "id": 28549,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 6,
   "firman": "namun bagi kita hanya ada satu Allah saja, yaitu Bapa, yang dari pada-Nya berasal segala sesuatu dan yang untuk Dia kita hidup, dan satu Tuhan saja, yaitu Yesus Kristus, yang oleh-Nya segala sesuatu telah dijadikan dan yang karena Dia kita hidup."
 },
 {
   "id": 28550,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 7,
   "firman": "Tetapi bukan semua orang yang mempunyai pengetahuan itu. Ada orang, yang karena masih terus terikat pada berhala-berhala, makan daging itu sebagai daging persembahan berhala. Dan oleh karena hati nurani mereka lemah, hati nurani mereka itu dinodai olehnya."
 },
 {
   "id": 28551,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 8,
   "firman": "\"Makanan tidak membawa kita lebih dekat kepada Allah. Kita tidak rugi apa-apa, kalau tidak kita makan dan kita tidak untung apa-apa, kalau kita makan.\""
 },
 {
   "id": 28552,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 9,
   "firman": "Tetapi jagalah, supaya kebebasanmu ini jangan menjadi batu sandungan bagi mereka yang lemah."
 },
 {
   "id": 28553,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 10,
   "firman": "Karena apabila orang melihat engkau yang mempunyai \"pengetahuan\", sedang duduk makan di dalam kuil berhala, bukankah orang yang lemah hati nuraninya itu dikuatkan untuk makan daging persembahan berhala?"
 },
 {
   "id": 28554,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dengan jalan demikian orang yang lemah, yaitu saudaramu, yang untuknya Kristus telah mati, menjadi binasa karena \"pengetahuan\" mu."
 },
 {
   "id": 28555,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 12,
   "firman": "Jika engkau secara demikian berdosa terhadap saudara-saudaramu dan melukai hati nurani mereka yang lemah, engkau pada hakekatnya berdosa terhadap Kristus."
 },
 {
   "id": 28556,
   "kitab": "1Ko",
   "pasal": 8,
   "ayat": 13,
   "firman": "Karena itu apabila makanan menjadi batu sandungan bagi saudaraku, aku untuk selama-lamanya tidak akan mau makan daging lagi, supaya aku jangan menjadi batu sandungan bagi saudaraku."
 },
 {
   "id": 28557,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 1,
   "firman": "Bukankah aku rasul? Bukankah aku orang bebas? Bukankah aku telah melihat Yesus, Tuhan kita? Bukankah kamu adalah buah pekerjaanku dalam Tuhan?"
 },
 {
   "id": 28558,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 2,
   "firman": "Sekalipun bagi orang lain aku bukanlah rasul, tetapi bagi kamu aku adalah rasul. Sebab hidupmu dalam Tuhan adalah meterai dari kerasulanku."
 },
 {
   "id": 28559,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 3,
   "firman": "Inilah pembelaanku terhadap mereka yang mengeritik aku."
 },
 {
   "id": 28560,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 4,
   "firman": "Tidakkah kami mempunyai hak untuk makan dan minum?"
 },
 {
   "id": 28561,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 5,
   "firman": "Tidakkah kami mempunyai hak untuk membawa seorang isteri Kristen, dalam perjalanan kami, seperti yang dilakukan rasul-rasul lain dan saudara-saudara Tuhan dan Kefas?"
 },
 {
   "id": 28562,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 6,
   "firman": "Atau hanya aku dan Barnabas sajakah yang tidak mempunyai hak untuk dibebaskan dari pekerjaan tangan?"
 },
 {
   "id": 28563,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 7,
   "firman": "Siapakah yang pernah turut dalam peperangan atas biayanya sendiri? Siapakah yang menanami kebun anggur dan tidak memakan buahnya? Atau siapakah yang menggembalakan kawanan domba dan yang tidak minum susu domba itu?"
 },
 {
   "id": 28564,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 8,
   "firman": "Apa yang kukatakan ini bukanlah hanya pikiran manusia saja. Bukankah hukum Taurat juga berkata-kata demikian?"
 },
 {
   "id": 28565,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 9,
   "firman": "Sebab dalam hukum Musa ada tertulis: \"Janganlah engkau memberangus mulut lembu yang sedang mengirik!\" Lembukah yang Allah perhatikan?"
 },
 {
   "id": 28566,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 10,
   "firman": "Atau kitakah yang Ia maksudkan? Ya, untuk kitalah hal ini ditulis, yaitu pembajak harus membajak dalam pengharapan dan pengirik harus mengirik dalam pengharapan untuk memperoleh bagiannya."
 },
 {
   "id": 28567,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 11,
   "firman": "Jadi, jika kami telah menaburkan benih rohani bagi kamu, berlebih-lebihankah, kalau kami menuai hasil duniawi dari pada kamu?"
 },
 {
   "id": 28568,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 12,
   "firman": "Kalau orang lain mempunyai hak untuk mengharapkan hal itu dari pada kamu, bukankah kami mempunyai hak yang lebih besar? Tetapi kami tidak mempergunakan hak itu. Sebaliknya, kami menanggung segala sesuatu, supaya jangan kami mengadakan rintangan bagi pemberitaan Injil Kristus."
 },
 {
   "id": 28569,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 13,
   "firman": "Tidak tahukah kamu, bahwa mereka yang melayani dalam tempat kudus mendapat penghidupannya dari tempat kudus itu dan bahwa mereka yang melayani mezbah, mendapat bahagian mereka dari mezbah itu?"
 },
 {
   "id": 28570,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 14,
   "firman": "Demikian pula Tuhan telah menetapkan, bahwa mereka yang memberitakan Injil, harus hidup dari pemberitaan Injil itu."
 },
 {
   "id": 28571,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 15,
   "firman": "Tetapi aku tidak pernah mempergunakan satupun dari hak-hak itu. Aku tidak menulis semuanya ini, supaya akupun diperlakukan juga demikian. Sebab aku lebih suka mati dari pada...! Sungguh, kemegahanku tidak dapat ditiadakan siapapun juga!"
 },
 {
   "id": 28572,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 16,
   "firman": "Karena jika aku memberitakan Injil, aku tidak mempunyai alasan untuk memegahkan diri. Sebab itu adalah keharusan bagiku. Celakalah aku, jika aku tidak memberitakan Injil."
 },
 {
   "id": 28573,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 17,
   "firman": "Kalau andaikata aku melakukannya menurut kehendakku sendiri, memang aku berhak menerima upah. Tetapi karena aku melakukannya bukan menurut kehendakku sendiri, pemberitaan itu adalah tugas penyelenggaraan yang ditanggungkan kepadaku."
 },
 {
   "id": 28574,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 18,
   "firman": "Kalau demikian apakah upahku? Upahku ialah ini: bahwa aku boleh memberitakan Injil tanpa upah, dan bahwa aku tidak mempergunakan hakku sebagai pemberita Injil."
 },
 {
   "id": 28575,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sungguhpun aku bebas terhadap semua orang, aku menjadikan diriku hamba dari semua orang, supaya aku boleh memenangkan sebanyak mungkin orang."
 },
 {
   "id": 28576,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 20,
   "firman": "Demikianlah bagi orang Yahudi aku menjadi seperti orang Yahudi, supaya aku memenangkan orang-orang Yahudi. Bagi orang-orang yang hidup di bawah hukum Taurat aku menjadi seperti orang yang hidup di bawah hukum Taurat, sekalipun aku sendiri tidak hidup di bawah hukum Taurat, supaya aku dapat memenangkan mereka yang hidup di bawah hukum Taurat."
 },
 {
   "id": 28577,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 21,
   "firman": "Bagi orang-orang yang tidak hidup di bawah hukum Taurat aku menjadi seperti orang yang tidak hidup di bawah hukum Taurat, sekalipun aku tidak hidup di luar hukum Allah, karena aku hidup di bawah hukum Kristus, supaya aku dapat memenangkan mereka yang tidak hidup di bawah hukum Taurat."
 },
 {
   "id": 28578,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 22,
   "firman": "Bagi orang-orang yang lemah aku menjadi seperti orang yang lemah, supaya aku dapat menyelamatkan mereka yang lemah. Bagi semua orang aku telah menjadi segala-galanya, supaya aku sedapat mungkin memenangkan beberapa orang dari antara mereka."
 },
 {
   "id": 28579,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 23,
   "firman": "Segala sesuatu ini aku lakukan karena Injil, supaya aku mendapat bagian dalamnya."
 },
 {
   "id": 28580,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 24,
   "firman": "Tidak tahukah kamu, bahwa dalam gelanggang pertandingan semua peserta turut berlari, tetapi bahwa hanya satu orang saja yang mendapat hadiah? Karena itu larilah begitu rupa, sehingga kamu memperolehnya!"
 },
 {
   "id": 28581,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 25,
   "firman": "Tiap-tiap orang yang turut mengambil bagian dalam pertandingan, menguasai dirinya dalam segala hal. Mereka berbuat demikian untuk memperoleh suatu mahkota yang fana, tetapi kita untuk memperoleh suatu mahkota yang abadi."
 },
 {
   "id": 28582,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sebab itu aku tidak berlari tanpa tujuan dan aku bukan petinju yang sembarangan saja memukul."
 },
 {
   "id": 28583,
   "kitab": "1Ko",
   "pasal": 9,
   "ayat": 27,
   "firman": "Tetapi aku melatih tubuhku dan menguasainya seluruhnya, supaya sesudah memberitakan Injil kepada orang lain, jangan aku sendiri ditolak."
 },
 {
   "id": 28584,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 1,
   "firman": "Aku mau, supaya kamu mengetahui, saudara-saudara, bahwa nenek moyang kita semua berada di bawah perlindungan awan dan bahwa mereka semua telah melintasi laut."
 },
 {
   "id": 28585,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 2,
   "firman": "Untuk menjadi pengikut Musa mereka semua telah dibaptis dalam awan dan dalam laut."
 },
 {
   "id": 28586,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 3,
   "firman": "Mereka semua makan makanan rohani yang sama"
 },
 {
   "id": 28587,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 4,
   "firman": "dan mereka semua minum minuman rohani yang sama, sebab mereka minum dari batu karang rohani yang mengikuti mereka, dan batu karang itu ialah Kristus."
 },
 {
   "id": 28588,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 5,
   "firman": "Tetapi sungguhpun demikian Allah tidak berkenan kepada bagian yang terbesar dari mereka, karena mereka ditewaskan di padang gurun."
 },
 {
   "id": 28589,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 6,
   "firman": "Semuanya ini telah terjadi sebagai contoh bagi kita untuk memperingatkan kita, supaya jangan kita menginginkan hal-hal yang jahat seperti yang telah mereka perbuat,"
 },
 {
   "id": 28590,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 7,
   "firman": "dan supaya jangan kita menjadi penyembah-penyembah berhala, sama seperti beberapa orang dari mereka, seperti ada tertulis: \"Maka duduklah bangsa itu untuk makan dan minum; kemudian bangunlah mereka dan bersukaria.\""
 },
 {
   "id": 28591,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 8,
   "firman": "Janganlah kita melakukan percabulan, seperti yang dilakukan oleh beberapa orang dari mereka, sehingga pada satu hari telah tewas dua puluh tiga ribu orang."
 },
 {
   "id": 28592,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 9,
   "firman": "Dan janganlah kita mencobai Tuhan, seperti yang dilakukan oleh beberapa orang dari mereka, sehingga mereka mati dipagut ular."
 },
 {
   "id": 28593,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 10,
   "firman": "Dan janganlah bersungut-sungut, seperti yang dilakukan oleh beberapa orang dari mereka, sehingga mereka dibinasakan oleh malaikat maut."
 },
 {
   "id": 28594,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 11,
   "firman": "Semuanya ini telah menimpa mereka sebagai contoh dan dituliskan untuk menjadi peringatan bagi kita yang hidup pada waktu, di mana zaman akhir telah tiba."
 },
 {
   "id": 28595,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 12,
   "firman": "Sebab itu siapa yang menyangka, bahwa ia teguh berdiri, hati-hatilah supaya ia jangan jatuh!"
 },
 {
   "id": 28596,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 13,
   "firman": "Pencobaan-pencobaan yang kamu alami ialah pencobaan-pencobaan biasa, yang tidak melebihi kekuatan manusia. Sebab Allah setia dan karena itu Ia tidak akan membiarkan kamu dicobai melampaui kekuatanmu. Pada waktu kamu dicobai Ia akan memberikan kepadamu jalan ke luar, sehingga kamu dapat menanggungnya."
 },
 {
   "id": 28597,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 14,
   "firman": "Karena itu, saudara-saudaraku yang kekasih, jauhilah penyembahan berhala!"
 },
 {
   "id": 28598,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 15,
   "firman": "Aku berbicara kepadamu sebagai orang-orang yang bijaksana. Pertimbangkanlah sendiri apa yang aku katakan!"
 },
 {
   "id": 28599,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 16,
   "firman": "Bukankah cawan pengucapan syukur, yang atasnya kita ucapkan syukur, adalah persekutuan dengan darah Kristus? Bukankah roti yang kita pecah-pecahkan adalah persekutuan dengan tubuh Kristus?"
 },
 {
   "id": 28600,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 17,
   "firman": "Karena roti adalah satu, maka kita, sekalipun banyak, adalah satu tubuh, karena kita semua mendapat bagian dalam roti yang satu itu."
 },
 {
   "id": 28601,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 18,
   "firman": "Perhatikanlah bangsa Israel menurut daging: bukankah mereka yang makan apa yang dipersembahkan mendapat bagian dalam pelayanan mezbah?"
 },
 {
   "id": 28602,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 19,
   "firman": "Apakah yang kumaksudkan dengan perkataan itu? Bahwa persembahan berhala adalah sesuatu? Atau bahwa berhala adalah sesuatu?"
 },
 {
   "id": 28603,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 20,
   "firman": "Bukan! Apa yang kumaksudkan ialah, bahwa persembahan mereka adalah persembahan kepada roh-roh jahat, bukan kepada Allah. Dan aku tidak mau, bahwa kamu bersekutu dengan roh-roh jahat."
 },
 {
   "id": 28604,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 21,
   "firman": "Kamu tidak dapat minum dari cawan Tuhan dan juga dari cawan roh-roh jahat. Kamu tidak dapat mendapat bagian dalam perjamuan Tuhan dan juga dalam perjamuan roh-roh jahat."
 },
 {
   "id": 28605,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 22,
   "firman": "Atau maukah kita membangkitkan cemburu Tuhan? Apakah kita lebih kuat dari pada Dia?"
 },
 {
   "id": 28606,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 23,
   "firman": "\"Segala sesuatu diperbolehkan.\" Benar, tetapi bukan segala sesuatu berguna. \"Segala sesuatu diperbolehkan.\" Benar, tetapi bukan segala sesuatu membangun."
 },
 {
   "id": 28607,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 24,
   "firman": "Jangan seorangpun yang mencari keuntungannya sendiri, tetapi hendaklah tiap-tiap orang mencari keuntungan orang lain."
 },
 {
   "id": 28608,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 25,
   "firman": "Kamu boleh makan segala sesuatu yang dijual di pasar daging, tanpa mengadakan pemeriksaan karena keberatan-keberatan hati nurani."
 },
 {
   "id": 28609,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 26,
   "firman": "Karena: \"bumi serta segala isinya adalah milik Tuhan.\""
 },
 {
   "id": 28610,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 27,
   "firman": "Kalau kamu diundang makan oleh seorang yang tidak percaya, dan undangan itu kamu terima, makanlah apa saja yang dihidangkan kepadamu, tanpa mengadakan pemeriksaan karena keberatan-keberatan hati nurani."
 },
 {
   "id": 28611,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 28,
   "firman": "Tetapi kalau seorang berkata kepadamu: \"Itu persembahan berhala!\" janganlah engkau memakannya, oleh karena dia yang mengatakan hal itu kepadamu dan karena keberatan-keberatan hati nurani."
 },
 {
   "id": 28612,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 29,
   "firman": "Yang aku maksudkan dengan keberatan-keberatan bukanlah keberatan-keberatan hati nuranimu sendiri, tetapi keberatan-keberatan hati nurani orang lain itu. Mungkin ada orang yang berkata: \"Mengapa kebebasanku harus ditentukan oleh keberatan-keberatan hati nurani orang lain?"
 },
 {
   "id": 28613,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 30,
   "firman": "Kalau aku mengucap syukur atas apa yang aku turut memakannya, mengapa orang berkata jahat tentang aku karena makanan, yang atasnya aku mengucap syukur?\""
 },
 {
   "id": 28614,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 31,
   "firman": "Aku menjawab: Jika engkau makan atau jika engkau minum, atau jika engkau melakukan sesuatu yang lain, lakukanlah semuanya itu untuk kemuliaan Allah."
 },
 {
   "id": 28615,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 32,
   "firman": "Janganlah kamu menimbulkan syak dalam hati orang, baik orang Yahudi atau orang Yunani, maupun Jemaat Allah."
 },
 {
   "id": 28616,
   "kitab": "1Ko",
   "pasal": 10,
   "ayat": 33,
   "firman": "Sama seperti aku juga berusaha menyenangkan hati semua orang dalam segala hal, bukan untuk kepentingan diriku, tetapi untuk kepentingan orang banyak, supaya mereka beroleh selamat."
 },
 {
   "id": 28617,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 1,
   "firman": "Jadilah pengikutku, sama seperti aku juga menjadi pengikut Kristus."
 },
 {
   "id": 28618,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 2,
   "firman": "Aku harus memuji kamu, sebab dalam segala sesuatu kamu tetap mengingat akan aku dan teguh berpegang pada ajaran yang kuteruskan kepadamu."
 },
 {
   "id": 28619,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 3,
   "firman": "Tetapi aku mau, supaya kamu mengetahui hal ini, yaitu Kepala dari tiap-tiap laki-laki ialah Kristus, kepala dari perempuan ialah laki-laki dan Kepala dari Kristus ialah Allah."
 },
 {
   "id": 28620,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tiap-tiap laki-laki yang berdoa atau bernubuat dengan kepala yang bertudung, menghina kepalanya."
 },
 {
   "id": 28621,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 5,
   "firman": "Tetapi tiap-tiap perempuan yang berdoa atau bernubuat dengan kepala yang tidak bertudung, menghina kepalanya, sebab ia sama dengan perempuan yang dicukur rambutnya."
 },
 {
   "id": 28622,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 6,
   "firman": "Sebab jika perempuan tidak mau menudungi kepalanya, maka haruslah ia juga menggunting rambutnya. Tetapi jika bagi perempuan adalah penghinaan, bahwa rambutnya digunting atau dicukur, maka haruslah ia menudungi kepalanya."
 },
 {
   "id": 28623,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 7,
   "firman": "Sebab laki-laki tidak perlu menudungi kepalanya: ia menyinarkan gambaran dan kemuliaan Allah. Tetapi perempuan menyinarkan kemuliaan laki-laki."
 },
 {
   "id": 28624,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 8,
   "firman": "Sebab laki-laki tidak berasal dari perempuan, tetapi perempuan berasal dari laki-laki."
 },
 {
   "id": 28625,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dan laki-laki tidak diciptakan karena perempuan, tetapi perempuan diciptakan karena laki-laki."
 },
 {
   "id": 28626,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 10,
   "firman": "Sebab itu, perempuan harus memakai tanda wibawa di kepalanya oleh karena para malaikat."
 },
 {
   "id": 28627,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 11,
   "firman": "Namun demikian, dalam Tuhan tidak ada perempuan tanpa laki-laki dan tidak ada laki-laki tanpa perempuan."
 },
 {
   "id": 28628,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 12,
   "firman": "Sebab sama seperti perempuan berasal dari laki-laki, demikian pula laki-laki dilahirkan oleh perempuan; dan segala sesuatu berasal dari Allah."
 },
 {
   "id": 28629,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 13,
   "firman": "Pertimbangkanlah sendiri: Patutkah perempuan berdoa kepada Allah dengan kepala yang tidak bertudung?"
 },
 {
   "id": 28630,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 14,
   "firman": "Bukankah alam sendiri menyatakan kepadamu, bahwa adalah kehinaan bagi laki-laki, jika ia berambut panjang,"
 },
 {
   "id": 28631,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 15,
   "firman": "tetapi bahwa adalah kehormatan bagi perempuan, jika ia berambut panjang? Sebab rambut diberikan kepada perempuan untuk menjadi penudung."
 },
 {
   "id": 28632,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 16,
   "firman": "Tetapi jika ada orang yang mau membantah, kami maupun Jemaat-jemaat Allah tidak mempunyai kebiasaan yang demikian."
 },
 {
   "id": 28633,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 17,
   "firman": "Dalam peraturan-peraturan yang berikut aku tidak dapat memuji kamu, sebab pertemuan-pertemuanmu tidak mendatangkan kebaikan, tetapi mendatangkan keburukan."
 },
 {
   "id": 28634,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 18,
   "firman": "Sebab pertama-tama aku mendengar, bahwa apabila kamu berkumpul sebagai Jemaat, ada perpecahan di antara kamu, dan hal itu sedikit banyak aku percaya."
 },
 {
   "id": 28635,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 19,
   "firman": "Sebab di antara kamu harus ada perpecahan, supaya nyata nanti siapakah di antara kamu yang tahan uji."
 },
 {
   "id": 28636,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 20,
   "firman": "Apabila kamu berkumpul, kamu bukanlah berkumpul untuk makan perjamuan Tuhan."
 },
 {
   "id": 28637,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 21,
   "firman": "Sebab pada perjamuan itu tiap-tiap orang memakan dahulu makanannya sendiri, sehingga yang seorang lapar dan yang lain mabuk."
 },
 {
   "id": 28638,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 22,
   "firman": "Apakah kamu tidak mempunyai rumah sendiri untuk makan dan minum? Atau maukah kamu menghinakan Jemaat Allah dan memalukan orang-orang yang tidak mempunyai apa-apa? Apakah yang kukatakan kepada kamu? Memuji kamu? Dalam hal ini aku tidak memuji."
 },
 {
   "id": 28639,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 23,
   "firman": "Sebab apa yang telah kuteruskan kepadamu, telah aku terima dari Tuhan, yaitu bahwa Tuhan Yesus, pada malam waktu Ia diserahkan, mengambil roti"
 },
 {
   "id": 28640,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 24,
   "firman": "dan sesudah itu Ia mengucap syukur atasnya; Ia memecah-mecahkannya dan berkata: \"Inilah tubuh-Ku, yang diserahkan bagi kamu; perbuatlah ini menjadi peringatan akan Aku!\""
 },
 {
   "id": 28641,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 25,
   "firman": "Demikian juga Ia mengambil cawan, sesudah makan, lalu berkata: \"Cawan ini adalah perjanjian baru yang dimeteraikan oleh darah-Ku; perbuatlah ini, setiap kali kamu meminumnya, menjadi peringatan akan Aku!\""
 },
 {
   "id": 28642,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 26,
   "firman": "Sebab setiap kali kamu makan roti ini dan minum cawan ini, kamu memberitakan kematian Tuhan sampai Ia datang."
 },
 {
   "id": 28643,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 27,
   "firman": "Jadi barangsiapa dengan cara yang tidak layak makan roti atau minum cawan Tuhan, ia berdosa terhadap tubuh dan darah Tuhan."
 },
 {
   "id": 28644,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 28,
   "firman": "Karena itu hendaklah tiap-tiap orang menguji dirinya sendiri dan baru sesudah itu ia makan roti dan minum dari cawan itu."
 },
 {
   "id": 28645,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 29,
   "firman": "Karena barangsiapa makan dan minum tanpa mengakui tubuh Tuhan, ia mendatangkan hukuman atas dirinya."
 },
 {
   "id": 28646,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 30,
   "firman": "Sebab itu banyak di antara kamu yang lemah dan sakit, dan tidak sedikit yang meninggal."
 },
 {
   "id": 28647,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 31,
   "firman": "Kalau kita menguji diri kita sendiri, hukuman tidak menimpa kita."
 },
 {
   "id": 28648,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 32,
   "firman": "Tetapi kalau kita menerima hukuman dari Tuhan, kita dididik, supaya kita tidak akan dihukum bersama-sama dengan dunia."
 },
 {
   "id": 28649,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 33,
   "firman": "Karena itu, saudara-saudaraku, jika kamu berkumpul untuk makan, nantikanlah olehmu seorang akan yang lain."
 },
 {
   "id": 28650,
   "kitab": "1Ko",
   "pasal": 11,
   "ayat": 34,
   "firman": "Kalau ada orang yang lapar, baiklah ia makan dahulu di rumahnya, supaya jangan kamu berkumpul untuk dihukum. Hal-hal yang lain akan kuatur, kalau aku datang."
 },
 {
   "id": 28651,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 1,
   "firman": "Sekarang tentang karunia-karunia Roh. Aku mau, saudara-saudara, supaya kamu mengetahui kebenarannya."
 },
 {
   "id": 28652,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 2,
   "firman": "Kamu tahu, bahwa pada waktu kamu masih belum mengenal Allah, kamu tanpa berpikir ditarik kepada berhala-berhala yang bisu."
 },
 {
   "id": 28653,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 3,
   "firman": "Karena itu aku mau meyakinkan kamu, bahwa tidak ada seorangpun yang berkata-kata oleh Roh Allah, dapat berkata: \"Terkutuklah Yesus!\" dan tidak ada seorangpun, yang dapat mengaku: \"Yesus adalah Tuhan\", selain oleh Roh Kudus."
 },
 {
   "id": 28654,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 4,
   "firman": "Ada rupa-rupa karunia, tetapi satu Roh."
 },
 {
   "id": 28655,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 5,
   "firman": "Dan ada rupa-rupa pelayanan, tetapi satu Tuhan."
 },
 {
   "id": 28656,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 6,
   "firman": "Dan ada berbagai-bagai perbuatan ajaib, tetapi Allah adalah satu yang mengerjakan semuanya dalam semua orang."
 },
 {
   "id": 28657,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 7,
   "firman": "Tetapi kepada tiap-tiap orang dikaruniakan penyataan Roh untuk kepentingan bersama."
 },
 {
   "id": 28658,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 8,
   "firman": "Sebab kepada yang seorang Roh memberikan karunia untuk berkata-kata dengan hikmat, dan kepada yang lain Roh yang sama memberikan karunia berkata-kata dengan pengetahuan."
 },
 {
   "id": 28659,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 9,
   "firman": "Kepada yang seorang Roh yang sama memberikan iman, dan kepada yang lain Ia memberikan karunia untuk menyembuhkan."
 },
 {
   "id": 28660,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 10,
   "firman": "Kepada yang seorang Roh memberikan kuasa untuk mengadakan mujizat, dan kepada yang lain Ia memberikan karunia untuk bernubuat, dan kepada yang lain lagi Ia memberikan karunia untuk membedakan bermacam-macam roh. Kepada yang seorang Ia memberikan karunia untuk berkata-kata dengan bahasa roh, dan kepada yang lain Ia memberikan karunia untuk menafsirkan bahasa roh itu."
 },
 {
   "id": 28661,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 11,
   "firman": "Tetapi semuanya ini dikerjakan oleh Roh yang satu dan yang sama, yang memberikan karunia kepada tiap-tiap orang secara khusus, seperti yang dikehendaki-Nya."
 },
 {
   "id": 28662,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 12,
   "firman": "Karena sama seperti tubuh itu satu dan anggota-anggotanya banyak, dan segala anggota itu, sekalipun banyak, merupakan satu tubuh, demikian pula Kristus."
 },
 {
   "id": 28663,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 13,
   "firman": "Sebab dalam satu Roh kita semua, baik orang Yahudi, maupun orang Yunani, baik budak, maupun orang merdeka, telah dibaptis menjadi satu tubuh dan kita semua diberi minum dari satu Roh."
 },
 {
   "id": 28664,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 14,
   "firman": "Karena tubuh juga tidak terdiri dari satu anggota, tetapi atas banyak anggota."
 },
 {
   "id": 28665,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 15,
   "firman": "Andaikata kaki berkata: \"Karena aku bukan tangan, aku tidak termasuk tubuh\", jadi benarkah ia tidak termasuk tubuh?"
 },
 {
   "id": 28666,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 16,
   "firman": "Dan andaikata telinga berkata: \"Karena aku bukan mata, aku tidak termasuk tubuh\", jadi benarkah ia tidak termasuk tubuh?"
 },
 {
   "id": 28667,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 17,
   "firman": "Andaikata tubuh seluruhnya adalah mata, di manakah pendengaran? Andaikata seluruhnya adalah telinga, di manakah penciuman?"
 },
 {
   "id": 28668,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 18,
   "firman": "Tetapi Allah telah memberikan kepada anggota, masing-masing secara khusus, suatu tempat pada tubuh, seperti yang dikehendaki-Nya."
 },
 {
   "id": 28669,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 19,
   "firman": "Andaikata semuanya adalah satu anggota, di manakah tubuh?"
 },
 {
   "id": 28670,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 20,
   "firman": "Memang ada banyak anggota, tetapi hanya satu tubuh."
 },
 {
   "id": 28671,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 21,
   "firman": "Jadi mata tidak dapat berkata kepada tangan: \"Aku tidak membutuhkan engkau.\" Dan kepala tidak dapat berkata kepada kaki: \"Aku tidak membutuhkan engkau.\""
 },
 {
   "id": 28672,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 22,
   "firman": "Malahan justru anggota-anggota tubuh yang nampaknya paling lemah, yang paling dibutuhkan."
 },
 {
   "id": 28673,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 23,
   "firman": "Dan kepada anggota-anggota tubuh yang menurut pemandangan kita kurang terhormat, kita berikan penghormatan khusus. Dan terhadap anggota-anggota kita yang tidak elok, kita berikan perhatian khusus."
 },
 {
   "id": 28674,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 24,
   "firman": "Hal itu tidak dibutuhkan oleh anggota-anggota kita yang elok. Allah telah menyusun tubuh kita begitu rupa, sehingga kepada anggota-anggota yang tidak mulia diberikan penghormatan khusus,"
 },
 {
   "id": 28675,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 25,
   "firman": "supaya jangan terjadi perpecahan dalam tubuh, tetapi supaya anggota-anggota yang berbeda itu saling memperhatikan."
 },
 {
   "id": 28676,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 26,
   "firman": "Karena itu jika satu anggota menderita, semua anggota turut menderita; jika satu anggota dihormati, semua anggota turut bersukacita."
 },
 {
   "id": 28677,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 27,
   "firman": "Kamu semua adalah tubuh Kristus dan kamu masing-masing adalah anggotanya."
 },
 {
   "id": 28678,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 28,
   "firman": "Dan Allah telah menetapkan beberapa orang dalam Jemaat: pertama sebagai rasul, kedua sebagai nabi, ketiga sebagai pengajar. Selanjutnya mereka yang mendapat karunia untuk mengadakan mujizat, untuk menyembuhkan, untuk melayani, untuk memimpin, dan untuk berkata-kata dalam bahasa roh."
 },
 {
   "id": 28679,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 29,
   "firman": "Adakah mereka semua rasul, atau nabi, atau pengajar? Adakah mereka semua mendapat karunia untuk mengadakan mujizat,"
 },
 {
   "id": 28680,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 30,
   "firman": "atau untuk menyembuhkan, atau untuk berkata-kata dalam bahasa roh, atau untuk menafsirkan bahasa roh?"
 },
 {
   "id": 28681,
   "kitab": "1Ko",
   "pasal": 12,
   "ayat": 31,
   "firman": "Jadi berusahalah untuk memperoleh karunia-karunia yang paling utama. Dan aku menunjukkan kepadamu jalan yang lebih utama lagi."
 },
 {
   "id": 28682,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 1,
   "firman": "Sekalipun aku dapat berkata-kata dengan semua bahasa manusia dan bahasa malaikat, tetapi jika aku tidak mempunyai kasih, aku sama dengan gong yang berkumandang dan canang yang gemerincing."
 },
 {
   "id": 28683,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 2,
   "firman": "Sekalipun aku mempunyai karunia untuk bernubuat dan aku mengetahui segala rahasia dan memiliki seluruh pengetahuan; dan sekalipun aku memiliki iman yang sempurna untuk memindahkan gunung, tetapi jika aku tidak mempunyai kasih, aku sama sekali tidak berguna."
 },
 {
   "id": 28684,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 3,
   "firman": "Dan sekalipun aku membagi-bagikan segala sesuatu yang ada padaku, bahkan menyerahkan tubuhku untuk dibakar, tetapi jika aku tidak mempunyai kasih, sedikitpun tidak ada faedahnya bagiku."
 },
 {
   "id": 28685,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 4,
   "firman": "Kasih itu sabar; kasih itu murah hati; ia tidak cemburu. Ia tidak memegahkan diri dan tidak sombong."
 },
 {
   "id": 28686,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 5,
   "firman": "Ia tidak melakukan yang tidak sopan dan tidak mencari keuntungan diri sendiri. Ia tidak pemarah dan tidak menyimpan kesalahan orang lain."
 },
 {
   "id": 28687,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 6,
   "firman": "Ia tidak bersukacita karena ketidakadilan, tetapi karena kebenaran."
 },
 {
   "id": 28688,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 7,
   "firman": "Ia menutupi segala sesuatu, percaya segala sesuatu, mengharapkan segala sesuatu, sabar menanggung segala sesuatu."
 },
 {
   "id": 28689,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 8,
   "firman": "Kasih tidak berkesudahan; nubuat akan berakhir; bahasa roh akan berhenti; pengetahuan akan lenyap."
 },
 {
   "id": 28690,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sebab pengetahuan kita tidak lengkap dan nubuat kita tidak sempurna."
 },
 {
   "id": 28691,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 10,
   "firman": "Tetapi jika yang sempurna tiba, maka yang tidak sempurna itu akan lenyap."
 },
 {
   "id": 28692,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 11,
   "firman": "Ketika aku kanak-kanak, aku berkata-kata seperti kanak-kanak, aku merasa seperti kanak-kanak, aku berpikir seperti kanak-kanak. Sekarang sesudah aku menjadi dewasa, aku meninggalkan sifat kanak-kanak itu."
 },
 {
   "id": 28693,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 12,
   "firman": "Karena sekarang kita melihat dalam cermin suatu gambaran yang samar-samar, tetapi nanti kita akan melihat muka dengan muka. Sekarang aku hanya mengenal dengan tidak sempurna, tetapi nanti aku akan mengenal dengan sempurna, seperti aku sendiri dikenal."
 },
 {
   "id": 28694,
   "kitab": "1Ko",
   "pasal": 13,
   "ayat": 13,
   "firman": "Demikianlah tinggal ketiga hal ini, yaitu iman, pengharapan dan kasih, dan yang paling besar di antaranya ialah kasih."
 },
 {
   "id": 28695,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 1,
   "firman": "Kejarlah kasih itu dan usahakanlah dirimu memperoleh karunia-karunia Roh, terutama karunia untuk bernubuat."
 },
 {
   "id": 28696,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 2,
   "firman": "Siapa yang berkata-kata dengan bahasa roh, tidak berkata-kata kepada manusia, tetapi kepada Allah. Sebab tidak ada seorangpun yang mengerti bahasanya; oleh Roh ia mengucapkan hal-hal yang rahasia."
 },
 {
   "id": 28697,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 3,
   "firman": "Tetapi siapa yang bernubuat, ia berkata-kata kepada manusia, ia membangun, menasihati dan menghibur."
 },
 {
   "id": 28698,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 4,
   "firman": "Siapa yang berkata-kata dengan bahasa roh, ia membangun dirinya sendiri, tetapi siapa yang bernubuat, ia membangun Jemaat."
 },
 {
   "id": 28699,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 5,
   "firman": "Aku suka, supaya kamu semua berkata-kata dengan bahasa roh, tetapi lebih dari pada itu, supaya kamu bernubuat. Sebab orang yang bernubuat lebih berharga dari pada orang yang berkata-kata dengan bahasa roh, kecuali kalau orang itu juga menafsirkannya, sehingga Jemaat dapat dibangun."
 },
 {
   "id": 28700,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 6,
   "firman": "Jadi, saudara-saudara, jika aku datang kepadamu dan berkata-kata dengan bahasa roh, apakah gunanya itu bagimu, jika aku tidak menyampaikan kepadamu penyataan Allah atau pengetahuan atau nubuat atau pengajaran?"
 },
 {
   "id": 28701,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 7,
   "firman": "Sama halnya dengan alat-alat yang tidak berjiwa, tetapi yang berbunyi, seperti seruling dan kecapi--bagaimanakah orang dapat mengetahui lagu apakah yang dimainkan seruling atau kecapi, kalau keduanya tidak mengeluarkan bunyi yang berbeda?"
 },
 {
   "id": 28702,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 8,
   "firman": "Atau, jika nafiri tidak mengeluarkan bunyi yang terang, siapakah yang menyiapkan diri untuk berperang?"
 },
 {
   "id": 28703,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 9,
   "firman": "Demikianlah juga kamu yang berkata-kata dengan bahasa roh: jika kamu tidak mempergunakan kata-kata yang jelas, bagaimanakah orang dapat mengerti apa yang kamu katakan? Kata-katamu sia-sia saja kamu ucapkan di udara!"
 },
 {
   "id": 28704,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 10,
   "firman": "Ada banyak--entah berapa banyak--macam bahasa di dunia; sekalipun demikian tidak ada satupun di antaranya yang mempunyai bunyi yang tidak berarti."
 },
 {
   "id": 28705,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 11,
   "firman": "Tetapi jika aku tidak mengetahui arti bahasa itu, aku menjadi orang asing bagi dia yang mempergunakannya dan dia orang asing bagiku."
 },
 {
   "id": 28706,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 12,
   "firman": "Demikian pula dengan kamu: Kamu memang berusaha untuk memperoleh karunia-karunia Roh, tetapi lebih dari pada itu hendaklah kamu berusaha mempergunakannya untuk membangun Jemaat."
 },
 {
   "id": 28707,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 13,
   "firman": "Karena itu siapa yang berkata-kata dengan bahasa roh, ia harus berdoa, supaya kepadanya diberikan juga karunia untuk menafsirkannya."
 },
 {
   "id": 28708,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 14,
   "firman": "Sebab jika aku berdoa dengan bahasa roh, maka rohkulah yang berdoa, tetapi akal budiku tidak turut berdoa."
 },
 {
   "id": 28709,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 15,
   "firman": "Jadi, apakah yang harus kubuat? Aku akan berdoa dengan rohku, tetapi aku akan berdoa juga dengan akal budiku; aku akan menyanyi dan memuji dengan rohku, tetapi aku akan menyanyi dan memuji juga dengan akal budiku."
 },
 {
   "id": 28710,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 16,
   "firman": "Sebab, jika engkau mengucap syukur dengan rohmu saja, bagaimanakah orang biasa yang hadir sebagai pendengar dapat mengatakan \"amin\" atas pengucapan syukurmu? Bukankah ia tidak tahu apa yang engkau katakan?"
 },
 {
   "id": 28711,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 17,
   "firman": "Sebab sekalipun pengucapan syukurmu itu sangat baik, tetapi orang lain tidak dibangun olehnya."
 },
 {
   "id": 28712,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 18,
   "firman": "Aku mengucap syukur kepada Allah, bahwa aku berkata-kata dengan bahasa roh lebih dari pada kamu semua."
 },
 {
   "id": 28713,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 19,
   "firman": "Tetapi dalam pertemuan Jemaat aku lebih suka mengucapkan lima kata yang dapat dimengerti untuk mengajar orang lain juga, dari pada beribu-ribu kata dengan bahasa roh."
 },
 {
   "id": 28714,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 20,
   "firman": "Saudara-saudara, janganlah sama seperti anak-anak dalam pemikiranmu. Jadilah anak-anak dalam kejahatan, tetapi orang dewasa dalam pemikiranmu!"
 },
 {
   "id": 28715,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 21,
   "firman": "Dalam hukum Taurat ada tertulis: \"Oleh orang-orang yang mempunyai bahasa lain dan oleh mulut orang-orang asing Aku akan berbicara kepada bangsa ini, namun demikian mereka tidak akan mendengarkan Aku, firman Tuhan.\""
 },
 {
   "id": 28716,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 22,
   "firman": "Karena itu karunia bahasa roh adalah tanda, bukan untuk orang yang beriman, tetapi untuk orang yang tidak beriman; sedangkan karunia untuk bernubuat adalah tanda, bukan untuk orang yang tidak beriman, tetapi untuk orang yang beriman."
 },
 {
   "id": 28717,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 23,
   "firman": "Jadi, kalau seluruh Jemaat berkumpul bersama-sama dan tiap-tiap orang berkata-kata dengan bahasa roh, lalu masuklah orang-orang luar atau orang-orang yang tidak beriman, tidakkah akan mereka katakan, bahwa kamu gila?"
 },
 {
   "id": 28718,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 24,
   "firman": "Tetapi kalau semua bernubuat, lalu masuk orang yang tidak beriman atau orang baru, ia akan diyakinkan oleh semua dan diselidiki oleh semua;"
 },
 {
   "id": 28719,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 25,
   "firman": "segala rahasia yang terkandung di dalam hatinya akan menjadi nyata, sehingga ia akan sujud menyembah Allah dan mengaku: \"Sungguh, Allah ada di tengah-tengah kamu.\""
 },
 {
   "id": 28720,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 26,
   "firman": "Jadi bagaimana sekarang, saudara-saudara? Bilamana kamu berkumpul, hendaklah tiap-tiap orang mempersembahkan sesuatu: yang seorang mazmur, yang lain pengajaran, atau penyataan Allah, atau karunia bahasa roh, atau karunia untuk menafsirkan bahasa roh, tetapi semuanya itu harus dipergunakan untuk membangun."
 },
 {
   "id": 28721,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 27,
   "firman": "Jika ada yang berkata-kata dengan bahasa roh, biarlah dua atau sebanyak-banyaknya tiga orang, seorang demi seorang, dan harus ada seorang lain untuk menafsirkannya."
 },
 {
   "id": 28722,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 28,
   "firman": "Jika tidak ada orang yang dapat menafsirkannya, hendaklah mereka berdiam diri dalam pertemuan Jemaat dan hanya boleh berkata-kata kepada dirinya sendiri dan kepada Allah."
 },
 {
   "id": 28723,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 29,
   "firman": "Tentang nabi-nabi--baiklah dua atau tiga orang di antaranya berkata-kata dan yang lain menanggapi apa yang mereka katakan."
 },
 {
   "id": 28724,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 30,
   "firman": "Tetapi jika seorang lain yang duduk di situ mendapat penyataan, maka yang pertama itu harus berdiam diri."
 },
 {
   "id": 28725,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 31,
   "firman": "Sebab kamu semua boleh bernubuat seorang demi seorang, sehingga kamu semua dapat belajar dan beroleh kekuatan."
 },
 {
   "id": 28726,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 32,
   "firman": "Karunia nabi takluk kepada nabi-nabi."
 },
 {
   "id": 28727,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 33,
   "firman": "Sebab Allah tidak menghendaki kekacauan, tetapi damai sejahtera."
 },
 {
   "id": 28728,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 34,
   "firman": "Sama seperti dalam semua Jemaat orang-orang kudus, perempuan-perempuan harus berdiam diri dalam pertemuan-pertemuan Jemaat. Sebab mereka tidak diperbolehkan untuk berbicara. Mereka harus menundukkan diri, seperti yang dikatakan juga oleh hukum Taurat."
 },
 {
   "id": 28729,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 35,
   "firman": "Jika mereka ingin mengetahui sesuatu, baiklah mereka menanyakannya kepada suaminya di rumah. Sebab tidak sopan bagi perempuan untuk berbicara dalam pertemuan Jemaat."
 },
 {
   "id": 28730,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 36,
   "firman": "Atau adakah firman Allah mulai dari kamu? Atau hanya kepada kamu sajakah firman itu telah datang?"
 },
 {
   "id": 28731,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 37,
   "firman": "Jika seorang menganggap dirinya nabi atau orang yang mendapat karunia rohani, ia harus sadar, bahwa apa yang kukatakan kepadamu adalah perintah Tuhan."
 },
 {
   "id": 28732,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 38,
   "firman": "Tetapi jika ia tidak mengindahkannya, janganlah kamu mengindahkan dia."
 },
 {
   "id": 28733,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 39,
   "firman": "Karena itu, saudara-saudaraku, usahakanlah dirimu untuk memperoleh karunia untuk bernubuat dan janganlah melarang orang yang berkata-kata dengan bahasa roh."
 },
 {
   "id": 28734,
   "kitab": "1Ko",
   "pasal": 14,
   "ayat": 40,
   "firman": "Tetapi segala sesuatu harus berlangsung dengan sopan dan teratur."
 },
 {
   "id": 28735,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 1,
   "firman": "Dan sekarang, saudara-saudara, aku mau mengingatkan kamu kepada Injil yang aku beritakan kepadamu dan yang kamu terima, dan yang di dalamnya kamu teguh berdiri."
 },
 {
   "id": 28736,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 2,
   "firman": "Oleh Injil itu kamu diselamatkan, asal kamu teguh berpegang padanya, seperti yang telah kuberitakan kepadamu--kecuali kalau kamu telah sia-sia saja menjadi percaya."
 },
 {
   "id": 28737,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 3,
   "firman": "Sebab yang sangat penting telah kusampaikan kepadamu, yaitu apa yang telah kuterima sendiri, ialah bahwa Kristus telah mati karena dosa-dosa kita, sesuai dengan Kitab Suci,"
 },
 {
   "id": 28738,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 4,
   "firman": "bahwa Ia telah dikuburkan, dan bahwa Ia telah dibangkitkan, pada hari yang ketiga, sesuai dengan Kitab Suci;"
 },
 {
   "id": 28739,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 5,
   "firman": "bahwa Ia telah menampakkan diri kepada Kefas dan kemudian kepada kedua belas murid-Nya."
 },
 {
   "id": 28740,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 6,
   "firman": "Sesudah itu Ia menampakkan diri kepada lebih dari lima ratus saudara sekaligus; kebanyakan dari mereka masih hidup sampai sekarang, tetapi beberapa di antaranya telah meninggal."
 },
 {
   "id": 28741,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 7,
   "firman": "Selanjutnya Ia menampakkan diri kepada Yakobus, kemudian kepada semua rasul."
 },
 {
   "id": 28742,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dan yang paling akhir dari semuanya Ia menampakkan diri juga kepadaku, sama seperti kepada anak yang lahir sebelum waktunya."
 },
 {
   "id": 28743,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 9,
   "firman": "Karena aku adalah yang paling hina dari semua rasul, bahkan tidak layak disebut rasul, sebab aku telah menganiaya Jemaat Allah."
 },
 {
   "id": 28744,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 10,
   "firman": "Tetapi karena kasih karunia Allah aku adalah sebagaimana aku ada sekarang, dan kasih karunia yang dianugerahkan-Nya kepadaku tidak sia-sia. Sebaliknya, aku telah bekerja lebih keras dari pada mereka semua; tetapi bukannya aku, melainkan kasih karunia Allah yang menyertai aku."
 },
 {
   "id": 28745,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 11,
   "firman": "Sebab itu, baik aku, maupun mereka, demikianlah kami mengajar dan demikianlah kamu menjadi percaya."
 },
 {
   "id": 28746,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 12,
   "firman": "Jadi, bilamana kami beritakan, bahwa Kristus dibangkitkan dari antara orang mati, bagaimana mungkin ada di antara kamu yang mengatakan, bahwa tidak ada kebangkitan orang mati?"
 },
 {
   "id": 28747,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 13,
   "firman": "Kalau tidak ada kebangkitan orang mati, maka Kristus juga tidak dibangkitkan."
 },
 {
   "id": 28748,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 14,
   "firman": "Tetapi andaikata Kristus tidak dibangkitkan, maka sia-sialah pemberitaan kami dan sia-sialah juga kepercayaan kamu."
 },
 {
   "id": 28749,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 15,
   "firman": "Lebih dari pada itu kami ternyata berdusta terhadap Allah, karena tentang Dia kami katakan, bahwa Ia telah membangkitkan Kristus--padahal Ia tidak membangkitkan-Nya, kalau andaikata benar, bahwa orang mati tidak dibangkitkan."
 },
 {
   "id": 28750,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 16,
   "firman": "Sebab jika benar orang mati tidak dibangkitkan, maka Kristus juga tidak dibangkitkan."
 },
 {
   "id": 28751,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 17,
   "firman": "Dan jika Kristus tidak dibangkitkan, maka sia-sialah kepercayaan kamu dan kamu masih hidup dalam dosamu."
 },
 {
   "id": 28752,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 18,
   "firman": "Demikianlah binasa juga orang-orang yang mati dalam Kristus."
 },
 {
   "id": 28753,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 19,
   "firman": "Jikalau kita hanya dalam hidup ini saja menaruh pengharapan pada Kristus, maka kita adalah orang-orang yang paling malang dari segala manusia."
 },
 {
   "id": 28754,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 20,
   "firman": "Tetapi yang benar ialah, bahwa Kristus telah dibangkitkan dari antara orang mati, sebagai yang sulung dari orang-orang yang telah meninggal."
 },
 {
   "id": 28755,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 21,
   "firman": "Sebab sama seperti maut datang karena satu orang manusia, demikian juga kebangkitan orang mati datang karena satu orang manusia."
 },
 {
   "id": 28756,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 22,
   "firman": "Karena sama seperti semua orang mati dalam persekutuan dengan Adam, demikian pula semua orang akan dihidupkan kembali dalam persekutuan dengan Kristus."
 },
 {
   "id": 28757,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 23,
   "firman": "Tetapi tiap-tiap orang menurut urutannya: Kristus sebagai buah sulung; sesudah itu mereka yang menjadi milik-Nya pada waktu kedatangan-Nya."
 },
 {
   "id": 28758,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 24,
   "firman": "Kemudian tiba kesudahannya, yaitu bilamana Ia menyerahkan Kerajaan kepada Allah Bapa, sesudah Ia membinasakan segala pemerintahan, kekuasaan dan kekuatan."
 },
 {
   "id": 28759,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 25,
   "firman": "Karena Ia harus memegang pemerintahan sebagai Raja sampai Allah meletakkan semua musuh-Nya di bawah kaki-Nya."
 },
 {
   "id": 28760,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 26,
   "firman": "Musuh yang terakhir, yang dibinasakan ialah maut."
 },
 {
   "id": 28761,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 27,
   "firman": "Sebab segala sesuatu telah ditaklukkan-Nya di bawah kaki-Nya. Tetapi kalau dikatakan, bahwa \"segala sesuatu telah ditaklukkan\", maka teranglah, bahwa Ia sendiri yang telah menaklukkan segala sesuatu di bawah kaki Kristus itu tidak termasuk di dalamnya."
 },
 {
   "id": 28762,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 28,
   "firman": "Tetapi kalau segala sesuatu telah ditaklukkan di bawah Kristus, maka Ia sendiri sebagai Anak akan menaklukkan diri-Nya di bawah Dia, yang telah menaklukkan segala sesuatu di bawah-Nya, supaya Allah menjadi semua di dalam semua."
 },
 {
   "id": 28763,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 29,
   "firman": "Jika tidak demikian, apakah faedahnya perbuatan orang-orang yang dibaptis bagi orang mati? Kalau orang mati sama sekali tidak dibangkitkan, mengapa mereka mau dibaptis bagi orang-orang yang telah meninggal?"
 },
 {
   "id": 28764,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 30,
   "firman": "Dan kami juga--mengapakah kami setiap saat membawa diri kami ke dalam bahaya?"
 },
 {
   "id": 28765,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 31,
   "firman": "Saudara-saudara, tiap-tiap hari aku berhadapan dengan maut. Demi kebanggaanku akan kamu dalam Kristus Yesus, Tuhan kita, aku katakan, bahwa hal ini benar."
 },
 {
   "id": 28766,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 32,
   "firman": "Kalau hanya berdasarkan pertimbangan-pertimbangan manusia saja aku telah berjuang melawan binatang buas di Efesus, apakah gunanya hal itu bagiku? Jika orang mati tidak dibangkitkan, maka \"marilah kita makan dan minum, sebab besok kita mati\"."
 },
 {
   "id": 28767,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 33,
   "firman": "Janganlah kamu sesat: Pergaulan yang buruk merusakkan kebiasaan yang baik."
 },
 {
   "id": 28768,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 34,
   "firman": "Sadarlah kembali sebaik-baiknya dan jangan berbuat dosa lagi! Ada di antara kamu yang tidak mengenal Allah. Hal ini kukatakan, supaya kamu merasa malu."
 },
 {
   "id": 28769,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 35,
   "firman": "Tetapi mungkin ada orang yang bertanya: \"Bagaimanakah orang mati dibangkitkan? Dan dengan tubuh apakah mereka akan datang kembali?\""
 },
 {
   "id": 28770,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 36,
   "firman": "Hai orang bodoh! Apa yang engkau sendiri taburkan, tidak akan tumbuh dan hidup, kalau ia tidak mati dahulu."
 },
 {
   "id": 28771,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 37,
   "firman": "Dan yang engkau taburkan bukanlah tubuh tanaman yang akan tumbuh, tetapi biji yang tidak berkulit, umpamanya biji gandum atau biji lain."
 },
 {
   "id": 28772,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 38,
   "firman": "Tetapi Allah memberikan kepadanya suatu tubuh, seperti yang dikehendaki-Nya: Ia memberikan kepada tiap-tiap biji tubuhnya sendiri."
 },
 {
   "id": 28773,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 39,
   "firman": "Bukan semua daging sama: daging manusia lain dari pada daging binatang, lain dari pada daging burung, lain dari pada daging ikan."
 },
 {
   "id": 28774,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 40,
   "firman": "Ada tubuh sorgawi dan ada tubuh duniawi, tetapi kemuliaan tubuh sorgawi lain dari pada kemuliaan tubuh duniawi."
 },
 {
   "id": 28775,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 41,
   "firman": "Kemuliaan matahari lain dari pada kemuliaan bulan, dan kemuliaan bulan lain dari pada kemuliaan bintang-bintang, dan kemuliaan bintang yang satu berbeda dengan kemuliaan bintang yang lain."
 },
 {
   "id": 28776,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 42,
   "firman": "Demikianlah pula halnya dengan kebangkitan orang mati. Ditaburkan dalam kebinasaan, dibangkitkan dalam ketidakbinasaan."
 },
 {
   "id": 28777,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 43,
   "firman": "Ditaburkan dalam kehinaan, dibangkitkan dalam kemuliaan. Ditaburkan dalam kelemahan, dibangkitkan dalam kekuatan."
 },
 {
   "id": 28778,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 44,
   "firman": "Yang ditaburkan adalah tubuh alamiah, yang dibangkitkan adalah tubuh rohaniah. Jika ada tubuh alamiah, maka ada pula tubuh rohaniah."
 },
 {
   "id": 28779,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 45,
   "firman": "Seperti ada tertulis: \"Manusia pertama, Adam menjadi makhluk yang hidup\", tetapi Adam yang akhir menjadi roh yang menghidupkan."
 },
 {
   "id": 28780,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 46,
   "firman": "Tetapi yang mula-mula datang bukanlah yang rohaniah, tetapi yang alamiah; kemudian barulah datang yang rohaniah."
 },
 {
   "id": 28781,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 47,
   "firman": "Manusia pertama berasal dari debu tanah dan bersifat jasmani, manusia kedua berasal dari sorga."
 },
 {
   "id": 28782,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 48,
   "firman": "Makhluk-makhluk alamiah sama dengan dia yang berasal dari debu tanah dan makhluk-makhluk sorgawi sama dengan Dia yang berasal dari sorga."
 },
 {
   "id": 28783,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 49,
   "firman": "Sama seperti kita telah memakai rupa dari yang alamiah, demikian pula kita akan memakai rupa dari yang sorgawi."
 },
 {
   "id": 28784,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 50,
   "firman": "Saudara-saudara, inilah yang hendak kukatakan kepadamu, yaitu bahwa daging dan darah tidak mendapat bagian dalam Kerajaan Allah dan bahwa yang binasa tidak mendapat bagian dalam apa yang tidak binasa."
 },
 {
   "id": 28785,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 51,
   "firman": "Sesungguhnya aku menyatakan kepadamu suatu rahasia: kita tidak akan mati semuanya, tetapi kita semuanya akan diubah,"
 },
 {
   "id": 28786,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 52,
   "firman": "dalam sekejap mata, pada waktu bunyi nafiri yang terakhir. Sebab nafiri akan berbunyi dan orang-orang mati akan dibangkitkan dalam keadaan yang tidak dapat binasa dan kita semua akan diubah."
 },
 {
   "id": 28787,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 53,
   "firman": "Karena yang dapat binasa ini harus mengenakan yang tidak dapat binasa, dan yang dapat mati ini harus mengenakan yang tidak dapat mati."
 },
 {
   "id": 28788,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 54,
   "firman": "Dan sesudah yang dapat binasa ini mengenakan yang tidak dapat binasa dan yang dapat mati ini mengenakan yang tidak dapat mati, maka akan genaplah firman Tuhan yang tertulis: \"Maut telah ditelan dalam kemenangan."
 },
 {
   "id": 28789,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 55,
   "firman": "Hai maut di manakah kemenanganmu? Hai maut, di manakah sengatmu?\""
 },
 {
   "id": 28790,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 56,
   "firman": "Sengat maut ialah dosa dan kuasa dosa ialah hukum Taurat."
 },
 {
   "id": 28791,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 57,
   "firman": "Tetapi syukur kepada Allah, yang telah memberikan kepada kita kemenangan oleh Yesus Kristus, Tuhan kita."
 },
 {
   "id": 28792,
   "kitab": "1Ko",
   "pasal": 15,
   "ayat": 58,
   "firman": "Karena itu, saudara-saudaraku yang kekasih, berdirilah teguh, jangan goyah, dan giatlah selalu dalam pekerjaan Tuhan! Sebab kamu tahu, bahwa dalam persekutuan dengan Tuhan jerih payahmu tidak sia-sia."
 },
 {
   "id": 28793,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 1,
   "firman": "Tentang pengumpulan uang bagi orang-orang kudus, hendaklah kamu berbuat sesuai dengan petunjuk-petunjuk yang kuberikan kepada Jemaat-jemaat di Galatia."
 },
 {
   "id": 28794,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 2,
   "firman": "Pada hari pertama dari tiap-tiap minggu hendaklah kamu masing-masing--sesuai dengan apa yang kamu peroleh--menyisihkan sesuatu dan menyimpannya di rumah, supaya jangan pengumpulan itu baru diadakan, kalau aku datang."
 },
 {
   "id": 28795,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 3,
   "firman": "Sesudah aku tiba, aku akan mengutus orang-orang, yang kamu anggap layak, dengan surat ke Yerusalem untuk menyampaikan pemberianmu."
 },
 {
   "id": 28796,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 4,
   "firman": "Kalau ternyata penting, bahwa aku juga pergi, maka mereka akan pergi bersama-sama dengan aku."
 },
 {
   "id": 28797,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 5,
   "firman": "Aku akan datang kepadamu, sesudah aku melintasi Makedonia, sebab aku akan melintasi Makedonia."
 },
 {
   "id": 28798,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 6,
   "firman": "Dan di Korintus mungkin aku akan tinggal beberapa lamanya dengan kamu atau mungkin aku akan tinggal selama musim dingin, sehingga kamu dapat menolong aku untuk melanjutkan perjalananku."
 },
 {
   "id": 28799,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 7,
   "firman": "Sebab sekarang aku tidak mau melihat kamu hanya sepintas lalu saja. Aku harap dapat tinggal agak lama dengan kamu, jika diperkenankan Tuhan."
 },
 {
   "id": 28800,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 8,
   "firman": "Tetapi aku akan tinggal di Efesus sampai hari raya Pentakosta,"
 },
 {
   "id": 28801,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 9,
   "firman": "sebab di sini banyak kesempatan bagiku untuk mengerjakan pekerjaan yang besar dan penting, sekalipun ada banyak penentang."
 },
 {
   "id": 28802,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 10,
   "firman": "Jika Timotius datang kepadamu, usahakanlah supaya ia berada di tengah-tengah kamu tanpa takut, sebab ia mengerjakan pekerjaan Tuhan, sama seperti aku."
 },
 {
   "id": 28803,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 11,
   "firman": "Jadi, janganlah ada orang yang menganggapnya rendah! Tetapi tolonglah dia, supaya ia melanjutkan perjalanannya dengan selamat, agar ia datang kembali kepadaku, sebab aku di sini menunggu kedatangannya bersama-sama dengan saudara-saudara yang lain."
 },
 {
   "id": 28804,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 12,
   "firman": "Tentang saudara Apolos: telah berulang-ulang aku mendesaknya untuk bersama-sama dengan saudara-saudara lain mengunjungi kamu, tetapi ia sama sekali tidak mau datang sekarang. Kalau ada kesempatan baik nanti, ia akan datang."
 },
 {
   "id": 28805,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 13,
   "firman": "Berjaga-jagalah! Berdirilah dengan teguh dalam iman! Bersikaplah sebagai laki-laki! Dan tetap kuat!"
 },
 {
   "id": 28806,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 14,
   "firman": "Lakukanlah segala pekerjaanmu dalam kasih!"
 },
 {
   "id": 28807,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 15,
   "firman": "Ada suatu permintaan lagi kepadamu, saudara-saudara. Kamu tahu, bahwa Stefanus dan keluarganya adalah orang-orang yang pertama-tama bertobat di Akhaya, dan bahwa mereka telah mengabdikan diri kepada pelayanan orang-orang kudus."
 },
 {
   "id": 28808,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 16,
   "firman": "Karena itu taatilah orang-orang yang demikian dan setiap orang yang turut bekerja dan berjerih payah."
 },
 {
   "id": 28809,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 17,
   "firman": "Aku bergembira atas kedatangan Stefanus, Fortunatus dan Akhaikus, karena mereka melengkapi apa yang masih kurang padamu;"
 },
 {
   "id": 28810,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 18,
   "firman": "karena mereka menyegarkan rohku dan roh kamu. Hargailah orang-orang yang demikian!"
 },
 {
   "id": 28811,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 19,
   "firman": "Salam kepadamu dari Jemaat-jemaat di Asia Kecil. Akwila, Priskila dan Jemaat di rumah mereka menyampaikan berlimpah-limpah salam kepadamu."
 },
 {
   "id": 28812,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 20,
   "firman": "Salam kepadamu dari saudara-saudara semuanya. Sampaikanlah salam seorang kepada yang lain dengan cium kudus."
 },
 {
   "id": 28813,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 21,
   "firman": "Dengan tanganku sendiri aku menulis ini: Salam dari Paulus."
 },
 {
   "id": 28814,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 22,
   "firman": "Siapa yang tidak mengasihi Tuhan, terkutuklah ia. Maranata!"
 },
 {
   "id": 28815,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 23,
   "firman": "Kasih karunia Tuhan Yesus menyertai kamu."
 },
 {
   "id": 28816,
   "kitab": "1Ko",
   "pasal": 16,
   "ayat": 24,
   "firman": "Kasihku menyertai kamu sekalian dalam Kristus Yesus."
 },
 {
   "id": 28817,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, yang oleh kehendak Allah menjadi rasul Kristus Yesus, dan dari Timotius saudara kita, kepada jemaat Allah di Korintus dengan semua orang kudus di seluruh Akhaya."
 },
 {
   "id": 28818,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 28819,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 3,
   "firman": "Terpujilah Allah, Bapa Tuhan kita Yesus Kristus, Bapa yang penuh belas kasihan dan Allah sumber segala penghiburan,"
 },
 {
   "id": 28820,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 4,
   "firman": "yang menghibur kami dalam segala penderitaan kami, sehingga kami sanggup menghibur mereka, yang berada dalam bermacam-macam penderitaan dengan penghiburan yang kami terima sendiri dari Allah."
 },
 {
   "id": 28821,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab sama seperti kami mendapat bagian berlimpah-limpah dalam kesengsaraan Kristus, demikian pula oleh Kristus kami menerima penghiburan berlimpah-limpah."
 },
 {
   "id": 28822,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 6,
   "firman": "Jika kami menderita, hal itu menjadi penghiburan dan keselamatan kamu; jika kami dihibur, maka hal itu adalah untuk penghiburan kamu, sehingga kamu beroleh kekuatan untuk dengan sabar menderita kesengsaraan yang sama seperti yang kami derita juga."
 },
 {
   "id": 28823,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 7,
   "firman": "Dan pengharapan kami akan kamu adalah teguh, karena kami tahu, bahwa sama seperti kamu turut mengambil bagian dalam kesengsaraan kami, kamu juga turut mengambil bagian dalam penghiburan kami."
 },
 {
   "id": 28824,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sebab kami mau, saudara-saudara, supaya kamu tahu akan penderitaan yang kami alami di Asia Kecil. Beban yang ditanggungkan atas kami adalah begitu besar dan begitu berat, sehingga kami telah putus asa juga akan hidup kami."
 },
 {
   "id": 28825,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 9,
   "firman": "Bahkan kami merasa, seolah-olah kami telah dijatuhi hukuman mati. Tetapi hal itu terjadi, supaya kami jangan menaruh kepercayaan pada diri kami sendiri, tetapi hanya kepada Allah yang membangkitkan orang-orang mati."
 },
 {
   "id": 28826,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 10,
   "firman": "Dari kematian yang begitu ngeri Ia telah dan akan menyelamatkan kami: kepada-Nya kami menaruh pengharapan kami, bahwa Ia akan menyelamatkan kami lagi,"
 },
 {
   "id": 28827,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 11,
   "firman": "karena kamu juga turut membantu mendoakan kami, supaya banyak orang mengucap syukur atas karunia yang kami peroleh berkat banyaknya doa mereka untuk kami."
 },
 {
   "id": 28828,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 12,
   "firman": "Inilah yang kami megahkan, yaitu bahwa suara hati kami memberi kesaksian kepada kami, bahwa hidup kami di dunia ini, khususnya dalam hubungan kami dengan kamu, dikuasai oleh ketulusan dan kemurnian dari Allah bukan oleh hikmat duniawi, tetapi oleh kekuatan kasih karunia Allah."
 },
 {
   "id": 28829,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 13,
   "firman": "Sebab kami hanya menuliskan kepada kamu apa yang dapat kamu baca dan pahamkan. Dan aku harap, mudah-mudahan kamu akan memahaminya sepenuhnya,"
 },
 {
   "id": 28830,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 14,
   "firman": "seperti yang telah kamu pahamkan sebagiannya dari kami, yaitu bahwa pada hari Tuhan Yesus kamu akan bermegah atas kami seperti kami juga akan bermegah atas kamu."
 },
 {
   "id": 28831,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 15,
   "firman": "Berdasarkan keyakinan ini aku pernah merencanakan untuk mengunjungi kamu dahulu, supaya kamu boleh menerima kasih karunia untuk kedua kalinya."
 },
 {
   "id": 28832,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 16,
   "firman": "Kemudian aku mau meneruskan perjalananku ke Makedonia, lalu dari Makedonia kembali lagi kepada kamu, supaya kamu menolong aku dalam perjalananku ke Yudea."
 },
 {
   "id": 28833,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 17,
   "firman": "Jadi, adakah aku bertindak serampangan dalam merencanakan hal ini? Atau adakah aku membuat rencanaku itu menurut keinginanku sendiri, sehingga padaku serentak terdapat \"ya\" dan \"tidak\"?"
 },
 {
   "id": 28834,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 18,
   "firman": "Demi Allah yang setia, janji kami kepada kamu bukanlah serentak \"ya\" dan \"tidak\"."
 },
 {
   "id": 28835,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena Yesus Kristus, Anak Allah, yang telah kami beritakan di tengah-tengah kamu, yaitu olehku dan oleh Silwanus dan Timotius, bukanlah \"ya\" dan \"tidak\", tetapi sebaliknya di dalam Dia hanya ada \"ya\"."
 },
 {
   "id": 28836,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 20,
   "firman": "Sebab Kristus adalah \"ya\" bagi semua janji Allah. Itulah sebabnya oleh Dia kita mengatakan \"Amin\" untuk memuliakan Allah."
 },
 {
   "id": 28837,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 21,
   "firman": "Sebab Dia yang telah meneguhkan kami bersama-sama dengan kamu di dalam Kristus, adalah Allah yang telah mengurapi,"
 },
 {
   "id": 28838,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 22,
   "firman": "memeteraikan tanda milik-Nya atas kita dan yang memberikan Roh Kudus di dalam hati kita sebagai jaminan dari semua yang telah disediakan untuk kita."
 },
 {
   "id": 28839,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 23,
   "firman": "Tetapi aku memanggil Allah sebagai saksiku--Ia mengenal aku--,bahwa sebabnya aku tidak datang ke Korintus ialah untuk menyayangkan kamu."
 },
 {
   "id": 28840,
   "kitab": "2Ko",
   "pasal": 1,
   "ayat": 24,
   "firman": "Bukan karena kami mau memerintahkan apa yang harus kamu percayai, karena kamu berdiri teguh dalam imanmu. Sebaliknya, kami mau turut bekerja untuk sukacitamu."
 },
 {
   "id": 28841,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 1,
   "firman": "Aku telah mengambil keputusan di dalam hatiku, bahwa aku tidak akan datang lagi kepadamu dalam dukacita."
 },
 {
   "id": 28842,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sebab, jika aku mendukakan hatimu, siapa lagi yang dapat membuat aku menjadi gembira selain dia yang berdukacita karena aku."
 },
 {
   "id": 28843,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan justru itulah maksud suratku ini, yaitu supaya jika aku datang, jangan aku berdukacita oleh mereka, yang harus membuat aku menjadi gembira. Sebab aku yakin tentang kamu semua, bahwa sukacitaku adalah juga sukacitamu."
 },
 {
   "id": 28844,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 4,
   "firman": "Aku menulis kepada kamu dengan hati yang sangat cemas dan sesak dan dengan mencucurkan banyak air mata, bukan supaya kamu bersedih hati, tetapi supaya kamu tahu betapa besarnya kasihku kepada kamu semua."
 },
 {
   "id": 28845,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi jika ada orang yang menyebabkan kesedihan, maka bukan hatiku yang disedihkannya, melainkan hati kamu sekalian, atau sekurang-kurangnya--supaya jangan aku melebih-lebihkan--,hati beberapa orang di antara kamu."
 },
 {
   "id": 28846,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 6,
   "firman": "Bagi orang yang demikian sudahlah cukup tegoran dari sebagian besar dari kamu,"
 },
 {
   "id": 28847,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 7,
   "firman": "sehingga kamu sebaliknya harus mengampuni dan menghibur dia, supaya ia jangan binasa oleh kesedihan yang terlampau berat."
 },
 {
   "id": 28848,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 8,
   "firman": "Sebab itu aku menasihatkan kamu, supaya kamu sungguh-sungguh mengasihi dia."
 },
 {
   "id": 28849,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sebab justru itulah maksudnya aku menulis surat kepada kamu, yaitu untuk menguji kamu, apakah kamu taat dalam segala sesuatu."
 },
 {
   "id": 28850,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 10,
   "firman": "Sebab barangsiapa yang kamu ampuni kesalahannya, aku mengampuninya juga. Sebab jika aku mengampuni, --seandainya ada yang harus kuampuni--,maka hal itu kubuat oleh karena kamu di hadapan Kristus,"
 },
 {
   "id": 28851,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 11,
   "firman": "supaya Iblis jangan beroleh keuntungan atas kita, sebab kita tahu apa maksudnya."
 },
 {
   "id": 28852,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 12,
   "firman": "Ketika aku tiba di Troas untuk memberitakan Injil Kristus, aku dapati, bahwa Tuhan telah membuka jalan untuk pekerjaan di sana."
 },
 {
   "id": 28853,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 13,
   "firman": "Tetapi hatiku tidak merasa tenang, karena aku tidak menjumpai saudaraku Titus. Sebab itu aku minta diri dan berangkat ke Makedonia."
 },
 {
   "id": 28854,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 14,
   "firman": "Tetapi syukur bagi Allah, yang dalam Kristus selalu membawa kami di jalan kemenangan-Nya. Dengan perantaraan kami Ia menyebarkan keharuman pengenalan akan Dia di mana-mana."
 },
 {
   "id": 28855,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 15,
   "firman": "Sebab bagi Allah kami adalah bau yang harum dari Kristus di tengah-tengah mereka yang diselamatkan dan di antara mereka yang binasa."
 },
 {
   "id": 28856,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 16,
   "firman": "Bagi yang terakhir kami adalah bau kematian yang mematikan dan bagi yang pertama bau kehidupan yang menghidupkan. Tetapi siapakah yang sanggup menunaikan tugas yang demikian?"
 },
 {
   "id": 28857,
   "kitab": "2Ko",
   "pasal": 2,
   "ayat": 17,
   "firman": "Sebab kami tidak sama dengan banyak orang lain yang mencari keuntungan dari firman Allah. Sebaliknya dalam Kristus kami berbicara sebagaimana mestinya dengan maksud-maksud murni atas perintah Allah dan di hadapan-Nya."
 },
 {
   "id": 28858,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 1,
   "firman": "Adakah kami mulai lagi memujikan diri kami? Atau perlukah kami seperti orang-orang lain menunjukkan surat pujian kepada kamu atau dari kamu?"
 },
 {
   "id": 28859,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 2,
   "firman": "Kamu adalah surat pujian kami yang tertulis dalam hati kami dan yang dikenal dan yang dapat dibaca oleh semua orang."
 },
 {
   "id": 28860,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 3,
   "firman": "Karena telah ternyata, bahwa kamu adalah surat Kristus, yang ditulis oleh pelayanan kami, ditulis bukan dengan tinta, tetapi dengan Roh dari Allah yang hidup, bukan pada loh-loh batu, melainkan pada loh-loh daging, yaitu di dalam hati manusia."
 },
 {
   "id": 28861,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 4,
   "firman": "Demikianlah besarnya keyakinan kami kepada Allah oleh Kristus."
 },
 {
   "id": 28862,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 5,
   "firman": "Dengan diri kami sendiri kami tidak sanggup untuk memperhitungkan sesuatu seolah-olah pekerjaan kami sendiri; tidak, kesanggupan kami adalah pekerjaan Allah."
 },
 {
   "id": 28863,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 6,
   "firman": "Ialah membuat kami juga sanggup menjadi pelayan-pelayan dari suatu perjanjian baru, yang tidak terdiri dari hukum yang tertulis, tetapi dari Roh, sebab hukum yang tertulis mematikan, tetapi Roh menghidupkan."
 },
 {
   "id": 28864,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 7,
   "firman": "Pelayanan yang memimpin kepada kematian terukir dengan huruf pada loh-loh batu. Namun demikian kemuliaan Allah menyertainya waktu ia diberikan. Sebab sekalipun pudar juga, cahaya muka Musa begitu cemerlang, sehingga mata orang-orang Israel tidak tahan menatapnya. Jika pelayanan itu datang dengan kemuliaan yang demikian"
 },
 {
   "id": 28865,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 8,
   "firman": "betapa lebih besarnya lagi kemuliaan yang menyertai pelayanan Roh!"
 },
 {
   "id": 28866,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 9,
   "firman": "Sebab, jika pelayanan yang memimpin kepada penghukuman itu mulia, betapa lebih mulianya lagi pelayanan yang memimpin kepada pembenaran."
 },
 {
   "id": 28867,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 10,
   "firman": "Sebenarnya apa yang dahulu dianggap mulia, jika dibandingkan dengan kemuliaan yang mengatasi segala sesuatu ini, sama sekali tidak mempunyai arti."
 },
 {
   "id": 28868,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 11,
   "firman": "Sebab, jika yang pudar itu disertai dengan kemuliaan, betapa lebihnya lagi yang tidak pudar itu disertai kemuliaan."
 },
 {
   "id": 28869,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 12,
   "firman": "Karena kami mempunyai pengharapan yang demikian, maka kami bertindak dengan penuh keberanian,"
 },
 {
   "id": 28870,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 13,
   "firman": "tidak seperti Musa, yang menyelubungi mukanya, supaya mata orang-orang Israel jangan melihat hilangnya cahaya yang sementara itu."
 },
 {
   "id": 28871,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 14,
   "firman": "Tetapi pikiran mereka telah menjadi tumpul, sebab sampai pada hari ini selubung itu masih tetap menyelubungi mereka, jika mereka membaca perjanjian lama itu tanpa disingkapkan, karena hanya Kristus saja yang dapat menyingkapkannya."
 },
 {
   "id": 28872,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 15,
   "firman": "Bahkan sampai pada hari ini, setiap kali mereka membaca kitab Musa, ada selubung yang menutupi hati mereka."
 },
 {
   "id": 28873,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 16,
   "firman": "Tetapi apabila hati seorang berbalik kepada Tuhan, maka selubung itu diambil dari padanya."
 },
 {
   "id": 28874,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sebab Tuhan adalah Roh; dan di mana ada Roh Allah, di situ ada kemerdekaan."
 },
 {
   "id": 28875,
   "kitab": "2Ko",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan kita semua mencerminkan kemuliaan Tuhan dengan muka yang tidak berselubung. Dan karena kemuliaan itu datangnya dari Tuhan yang adalah Roh, maka kita diubah menjadi serupa dengan gambar-Nya, dalam kemuliaan yang semakin besar."
 },
 {
   "id": 28876,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 1,
   "firman": "Oleh kemurahan Allah kami telah menerima pelayanan ini. Karena itu kami tidak tawar hati."
 },
 {
   "id": 28877,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 2,
   "firman": "Tetapi kami menolak segala perbuatan tersembunyi yang memalukan; kami tidak berlaku licik dan tidak memalsukan firman Allah. Sebaliknya kami menyatakan kebenaran dan dengan demikian kami menyerahkan diri kami untuk dipertimbangkan oleh semua orang di hadapan Allah."
 },
 {
   "id": 28878,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 3,
   "firman": "Jika Injil yang kami beritakan masih tertutup juga, maka ia tertutup untuk mereka, yang akan binasa,"
 },
 {
   "id": 28879,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 4,
   "firman": "yaitu orang-orang yang tidak percaya, yang pikirannya telah dibutakan oleh ilah zaman ini, sehingga mereka tidak melihat cahaya Injil tentang kemuliaan Kristus, yang adalah gambaran Allah."
 },
 {
   "id": 28880,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 5,
   "firman": "Sebab bukan diri kami yang kami beritakan, tetapi Yesus Kristus sebagai Tuhan, dan diri kami sebagai hambamu karena kehendak Yesus."
 },
 {
   "id": 28881,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 6,
   "firman": "Sebab Allah yang telah berfirman: \"Dari dalam gelap akan terbit terang!\", Ia juga yang membuat terang-Nya bercahaya di dalam hati kita, supaya kita beroleh terang dari pengetahuan tentang kemuliaan Allah yang nampak pada wajah Kristus."
 },
 {
   "id": 28882,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 7,
   "firman": "Tetapi harta ini kami punyai dalam bejana tanah liat, supaya nyata, bahwa kekuatan yang melimpah-limpah itu berasal dari Allah, bukan dari diri kami."
 },
 {
   "id": 28883,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dalam segala hal kami ditindas, namun tidak terjepit; kami habis akal, namun tidak putus asa;"
 },
 {
   "id": 28884,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 9,
   "firman": "kami dianiaya, namun tidak ditinggalkan sendirian, kami dihempaskan, namun tidak binasa."
 },
 {
   "id": 28885,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 10,
   "firman": "Kami senantiasa membawa kematian Yesus di dalam tubuh kami, supaya kehidupan Yesus juga menjadi nyata di dalam tubuh kami."
 },
 {
   "id": 28886,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 11,
   "firman": "Sebab kami, yang masih hidup ini, terus-menerus diserahkan kepada maut karena Yesus, supaya juga hidup Yesus menjadi nyata di dalam tubuh kami yang fana ini."
 },
 {
   "id": 28887,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 12,
   "firman": "Maka demikianlah maut giat di dalam diri kami dan hidup giat di dalam kamu."
 },
 {
   "id": 28888,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 13,
   "firman": "Namun karena kami memiliki roh iman yang sama, seperti ada tertulis: \"Aku percaya, sebab itu aku berkata-kata\", maka kami juga percaya dan sebab itu kami juga berkata-kata."
 },
 {
   "id": 28889,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 14,
   "firman": "Karena kami tahu, bahwa Ia, yang telah membangkitkan Tuhan Yesus, akan membangkitkan kami juga bersama-sama dengan Yesus. Dan Ia akan menghadapkan kami bersama-sama dengan kamu kepada diri-Nya."
 },
 {
   "id": 28890,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sebab semuanya itu terjadi oleh karena kamu, supaya kasih karunia, yang semakin besar berhubung dengan semakin banyaknya orang yang menjadi percaya, menyebabkan semakin melimpahnya ucapan syukur bagi kemuliaan Allah."
 },
 {
   "id": 28891,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sebab itu kami tidak tawar hati, tetapi meskipun manusia lahiriah kami semakin merosot, namun manusia batiniah kami dibaharui dari sehari ke sehari."
 },
 {
   "id": 28892,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 17,
   "firman": "Sebab penderitaan ringan yang sekarang ini, mengerjakan bagi kami kemuliaan kekal yang melebihi segala-galanya, jauh lebih besar dari pada penderitaan kami."
 },
 {
   "id": 28893,
   "kitab": "2Ko",
   "pasal": 4,
   "ayat": 18,
   "firman": "Sebab kami tidak memperhatikan yang kelihatan, melainkan yang tak kelihatan, karena yang kelihatan adalah sementara, sedangkan yang tak kelihatan adalah kekal."
 },
 {
   "id": 28894,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 1,
   "firman": "Karena kami tahu, bahwa jika kemah tempat kediaman kita di bumi ini dibongkar, Allah telah menyediakan suatu tempat kediaman di sorga bagi kita, suatu tempat kediaman yang kekal, yang tidak dibuat oleh tangan manusia."
 },
 {
   "id": 28895,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 2,
   "firman": "Selama kita di dalam kemah ini, kita mengeluh, karena kita rindu mengenakan tempat kediaman sorgawi di atas tempat kediaman kita yang sekarang ini,"
 },
 {
   "id": 28896,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 3,
   "firman": "sebab dengan demikian kita berpakaian dan tidak kedapatan telanjang."
 },
 {
   "id": 28897,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 4,
   "firman": "Sebab selama masih diam di dalam kemah ini, kita mengeluh oleh beratnya tekanan, karena kita mau mengenakan pakaian yang baru itu tanpa menanggalkan yang lama, supaya yang fana itu ditelan oleh hidup."
 },
 {
   "id": 28898,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 5,
   "firman": "Tetapi Allahlah yang justru mempersiapkan kita untuk hal itu dan yang mengaruniakan Roh, kepada kita sebagai jaminan segala sesuatu yang telah disediakan bagi kita."
 },
 {
   "id": 28899,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 6,
   "firman": "Maka oleh karena itu hati kami senantiasa tabah, meskipun kami sadar, bahwa selama kami mendiami tubuh ini, kami masih jauh dari Tuhan,"
 },
 {
   "id": 28900,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 7,
   "firman": "--sebab hidup kami ini adalah hidup karena percaya, bukan karena melihat--"
 },
 {
   "id": 28901,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 8,
   "firman": "tetapi hati kami tabah, dan terlebih suka kami beralih dari tubuh ini untuk menetap pada Tuhan."
 },
 {
   "id": 28902,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 9,
   "firman": "Sebab itu juga kami berusaha, baik kami diam di dalam tubuh ini, maupun kami diam di luarnya, supaya kami berkenan kepada-Nya."
 },
 {
   "id": 28903,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sebab kita semua harus menghadap takhta pengadilan Kristus, supaya setiap orang memperoleh apa yang patut diterimanya, sesuai dengan yang dilakukannya dalam hidupnya ini, baik ataupun jahat."
 },
 {
   "id": 28904,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 11,
   "firman": "Kami tahu apa artinya takut akan Tuhan, karena itu kami berusaha meyakinkan orang. Bagi Allah hati kami nyata dengan terang dan aku harap hati kami nyata juga demikian bagi pertimbangan kamu."
 },
 {
   "id": 28905,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 12,
   "firman": "Dengan ini kami tidak berusaha memuji-muji diri kami sekali lagi kepada kamu, tetapi kami mau memberi kesempatan kepada kamu untuk memegahkan kami, supaya kamu dapat menghadapi orang-orang yang bermegah karena hal-hal lahiriah dan bukan batiniah."
 },
 {
   "id": 28906,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 13,
   "firman": "Sebab jika kami tidak menguasai diri, hal itu adalah dalam pelayanan Allah, dan jika kami menguasai diri, hal itu adalah untuk kepentingan kamu."
 },
 {
   "id": 28907,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sebab kasih Kristus yang menguasai kami, karena kami telah mengerti, bahwa jika satu orang sudah mati untuk semua orang, maka mereka semua sudah mati."
 },
 {
   "id": 28908,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 15,
   "firman": "Dan Kristus telah mati untuk semua orang, supaya mereka yang hidup, tidak lagi hidup untuk dirinya sendiri, tetapi untuk Dia, yang telah mati dan telah dibangkitkan untuk mereka."
 },
 {
   "id": 28909,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 16,
   "firman": "Sebab itu kami tidak lagi menilai seorang jugapun menurut ukuran manusia. Dan jika kami pernah menilai Kristus menurut ukuran manusia, sekarang kami tidak lagi menilai-Nya demikian."
 },
 {
   "id": 28910,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 17,
   "firman": "Jadi siapa yang ada di dalam Kristus, ia adalah ciptaan baru: yang lama sudah berlalu, sesungguhnya yang baru sudah datang."
 },
 {
   "id": 28911,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 18,
   "firman": "Dan semuanya ini dari Allah, yang dengan perantaraan Kristus telah mendamaikan kita dengan diri-Nya dan yang telah mempercayakan pelayanan pendamaian itu kepada kami."
 },
 {
   "id": 28912,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 19,
   "firman": "Sebab Allah mendamaikan dunia dengan diri-Nya oleh Kristus dengan tidak memperhitungkan pelanggaran mereka. Ia telah mempercayakan berita pendamaian itu kepada kami."
 },
 {
   "id": 28913,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 20,
   "firman": "Jadi kami ini adalah utusan-utusan Kristus, seakan-akan Allah menasihati kamu dengan perantaraan kami; dalam nama Kristus kami meminta kepadamu: berilah dirimu didamaikan dengan Allah."
 },
 {
   "id": 28914,
   "kitab": "2Ko",
   "pasal": 5,
   "ayat": 21,
   "firman": "Dia yang tidak mengenal dosa telah dibuat-Nya menjadi dosa karena kita, supaya dalam Dia kita dibenarkan oleh Allah."
 },
 {
   "id": 28915,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 1,
   "firman": "Sebagai teman-teman sekerja, kami menasihatkan kamu, supaya kamu jangan membuat menjadi sia-sia kasih karunia Allah, yang telah kamu terima."
 },
 {
   "id": 28916,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 2,
   "firman": "Sebab Allah berfirman: \"Pada waktu Aku berkenan, Aku akan mendengarkan engkau, dan pada hari Aku menyelamatkan, Aku akan menolong engkau.\" Sesungguhnya, waktu ini adalah waktu perkenanan itu; sesungguhnya, hari ini adalah hari penyelamatan itu."
 },
 {
   "id": 28917,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 3,
   "firman": "Dalam hal apapun kami tidak memberi sebab orang tersandung, supaya pelayanan kami jangan sampai dicela."
 },
 {
   "id": 28918,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sebaliknya, dalam segala hal kami menunjukkan, bahwa kami adalah pelayan Allah, yaitu: dalam menahan dengan penuh kesabaran dalam penderitaan, kesesakan dan kesukaran,"
 },
 {
   "id": 28919,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 5,
   "firman": "dalam menanggung dera, dalam penjara dan kerusuhan, dalam berjerih payah, dalam berjaga-jaga dan berpuasa;"
 },
 {
   "id": 28920,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 6,
   "firman": "dalam kemurnian hati, pengetahuan, kesabaran, dan kemurahan hati; dalam Roh Kudus dan kasih yang tidak munafik;"
 },
 {
   "id": 28921,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 7,
   "firman": "dalam pemberitaan kebenaran dan kekuasaan Allah; dengan menggunakan senjata-senjata keadilan untuk menyerang ataupun untuk membela"
 },
 {
   "id": 28922,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 8,
   "firman": "ketika dihormati dan ketika dihina; ketika diumpat atau ketika dipuji; ketika dianggap sebagai penipu, namun dipercayai,"
 },
 {
   "id": 28923,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 9,
   "firman": "sebagai orang yang tidak dikenal, namun terkenal; sebagai orang yang nyaris mati, dan sungguh kami hidup; sebagai orang yang dihajar, namun tidak mati;"
 },
 {
   "id": 28924,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 10,
   "firman": "sebagai orang berdukacita, namun senantiasa bersukacita; sebagai orang miskin, namun memperkaya banyak orang; sebagai orang tak bermilik, sekalipun kami memiliki segala sesuatu."
 },
 {
   "id": 28925,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 11,
   "firman": "Hai orang Korintus! Kami telah berbicara terus terang kepada kamu, hati kami terbuka lebar-lebar bagi kamu."
 },
 {
   "id": 28926,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 12,
   "firman": "Dan bagi kamu ada tempat yang luas dalam hati kami, tetapi bagi kami hanya tersedia tempat yang sempit di dalam hati kamu."
 },
 {
   "id": 28927,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 13,
   "firman": "Maka sekarang, supaya timbal balik--aku berkata seperti kepada anak-anakku--:Bukalah hati kamu selebar-lebarnya!"
 },
 {
   "id": 28928,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 14,
   "firman": "Janganlah kamu merupakan pasangan yang tidak seimbang dengan orang-orang yang tak percaya. Sebab persamaan apakah terdapat antara kebenaran dan kedurhakaan? Atau bagaimanakah terang dapat bersatu dengan gelap?"
 },
 {
   "id": 28929,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 15,
   "firman": "Persamaan apakah yang terdapat antara Kristus dan Belial? Apakah bagian bersama orang-orang percaya dengan orang-orang tak percaya?"
 },
 {
   "id": 28930,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 16,
   "firman": "Apakah hubungan bait Allah dengan berhala? Karena kita adalah bait dari Allah yang hidup menurut firman Allah ini: \"Aku akan diam bersama-sama dengan mereka dan hidup di tengah-tengah mereka, dan Aku akan menjadi Allah mereka, dan mereka akan menjadi umat-Ku."
 },
 {
   "id": 28931,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 17,
   "firman": "Sebab itu: Keluarlah kamu dari antara mereka, dan pisahkanlah dirimu dari mereka, firman Tuhan, dan janganlah menjamah apa yang najis, maka Aku akan menerima kamu."
 },
 {
   "id": 28932,
   "kitab": "2Ko",
   "pasal": 6,
   "ayat": 18,
   "firman": "Dan Aku akan menjadi Bapamu, dan kamu akan menjadi anak-anak-Ku laki-laki dan anak-anak-Ku perempuan demikianlah firman Tuhan, Yang Mahakuasa.\""
 },
 {
   "id": 28933,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 1,
   "firman": "Saudara-saudaraku yang kekasih, karena kita sekarang memiliki janji-janji itu, marilah kita menyucikan diri kita dari semua pencemaran jasmani dan rohani, dan dengan demikian menyempurnakan kekudusan kita dalam takut akan Allah."
 },
 {
   "id": 28934,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 2,
   "firman": "Berilah tempat bagi kami di dalam hati kamu! Kami tidak pernah berbuat salah terhadap seorangpun, tidak seorangpun yang kami rugikan, dan tidak dari seorangpun kami cari untung."
 },
 {
   "id": 28935,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 3,
   "firman": "Aku berkata demikian, bukan untuk menjatuhkan hukuman atas kamu, sebab tadi telah aku katakan, bahwa kamu telah beroleh tempat di dalam hati kami, sehingga kita sehidup semati."
 },
 {
   "id": 28936,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 4,
   "firman": "Aku sangat berterus terang terhadap kamu; tetapi aku juga sangat memegahkan kamu. Dalam segala penderitaan kami aku sangat terhibur dan sukacitaku melimpah-limpah."
 },
 {
   "id": 28937,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 5,
   "firman": "Bahkan ketika kami tiba di Makedonia, kami tidak beroleh ketenangan bagi tubuh kami. Di mana-mana kami mengalami kesusahan: dari luar pertengkaran dan dari dalam ketakutan."
 },
 {
   "id": 28938,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 6,
   "firman": "Tetapi Allah, yang menghiburkan orang yang rendah hati, telah menghiburkan kami dengan kedatangan Titus."
 },
 {
   "id": 28939,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 7,
   "firman": "Bukan hanya oleh kedatangannya saja, tetapi juga oleh penghiburan yang dinikmatinya di tengah-tengah kamu. Karena ia telah memberitahukan kepada kami tentang kerinduanmu, keluhanmu, kesungguhanmu untuk membela aku, sehingga makin bertambahlah sukacitaku."
 },
 {
   "id": 28940,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 8,
   "firman": "Jadi meskipun aku telah menyedihkan hatimu dengan suratku itu, namun aku tidak menyesalkannya. Memang pernah aku menyesalkannya, karena aku lihat, bahwa surat itu menyedihkan hatimu--kendatipun untuk seketika saja lamanya--,"
 },
 {
   "id": 28941,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 9,
   "firman": "namun sekarang aku bersukacita, bukan karena kamu telah berdukacita, melainkan karena dukacitamu membuat kamu bertobat. Sebab dukacitamu itu adalah menurut kehendak Allah, sehingga kamu sedikitpun tidak dirugikan oleh karena kami."
 },
 {
   "id": 28942,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 10,
   "firman": "Sebab dukacita menurut kehendak Allah menghasilkan pertobatan yang membawa keselamatan dan yang tidak akan disesalkan, tetapi dukacita yang dari dunia ini menghasilkan kematian."
 },
 {
   "id": 28943,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 11,
   "firman": "Sebab perhatikanlah betapa justru dukacita yang menurut kehendak Allah itu mengerjakan pada kamu kesungguhan yang besar, bahkan pembelaan diri, kejengkelan, ketakutan, kerinduan, kegiatan, penghukuman! Di dalam semuanya itu kamu telah membuktikan, bahwa kamu tidak bersalah di dalam perkara itu."
 },
 {
   "id": 28944,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 12,
   "firman": "Sebab itu, jika aku telah menulis surat kepada kamu, maka bukanlah oleh karena orang yang berbuat salah, atau oleh karena orang yang menderita perbuatan salah, melainkan supaya kerelaanmu terhadap kami menjadi nyata bagi kamu di hadapan Allah."
 },
 {
   "id": 28945,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 13,
   "firman": "Sebab itulah kami menjadi terhibur. Dan selain penghiburan yang kami peroleh itu, kami lebih lagi bersukacita oleh karena sukacita Titus, sebab kamu semua menyegarkan hatinya."
 },
 {
   "id": 28946,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 14,
   "firman": "Aku memegahkan kamu kepadanya, dan kamu tidak mengecewakan aku. Kami senantiasa mengatakan apa yang benar kepada kamu, demikian juga kemegahan kami di hadapan Titus sudah ternyata benar."
 },
 {
   "id": 28947,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 15,
   "firman": "Dan kasihnya bertambah besar terhadap kamu, apabila ia mengingat ketaatan kamu semua, bagaimana kamu menyambut kedatangannya dengan takut dan gentar."
 },
 {
   "id": 28948,
   "kitab": "2Ko",
   "pasal": 7,
   "ayat": 16,
   "firman": "Aku bersukacita, sebab aku dapat menaruh kepercayaan kepada kamu dalam segala hal."
 },
 {
   "id": 28949,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 1,
   "firman": "Saudara-saudara, kami hendak memberitahukan kepada kamu tentang kasih karunia yang dianugerahkan kepada jemaat-jemaat di Makedonia."
 },
 {
   "id": 28950,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 2,
   "firman": "Selagi dicobai dengan berat dalam pelbagai penderitaan, sukacita mereka meluap dan meskipun mereka sangat miskin, namun mereka kaya dalam kemurahan."
 },
 {
   "id": 28951,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 3,
   "firman": "Aku bersaksi, bahwa mereka telah memberikan menurut kemampuan mereka, bahkan melampaui kemampuan mereka."
 },
 {
   "id": 28952,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 4,
   "firman": "Dengan kerelaan sendiri mereka meminta dan mendesak kepada kami, supaya mereka juga beroleh kasih karunia untuk mengambil bagian dalam pelayanan kepada orang-orang kudus."
 },
 {
   "id": 28953,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 5,
   "firman": "Mereka memberikan lebih banyak dari pada yang kami harapkan. Mereka memberikan diri mereka, pertama-tama kepada Allah, kemudian oleh karena kehendak Allah juga kepada kami."
 },
 {
   "id": 28954,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 6,
   "firman": "Sebab itu kami mendesak kepada Titus, supaya ia mengunjungi kamu dan menyelesaikan pelayanan kasih itu sebagaimana ia telah memulainya."
 },
 {
   "id": 28955,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 7,
   "firman": "Maka sekarang, sama seperti kamu kaya dalam segala sesuatu, --dalam iman, dalam perkataan, dalam pengetahuan, dalam kesungguhan untuk membantu, dan dalam kasihmu terhadap kami--demikianlah juga hendaknya kamu kaya dalam pelayanan kasih ini."
 },
 {
   "id": 28956,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 8,
   "firman": "Aku mengatakan hal itu bukan sebagai perintah, melainkan, dengan menunjukkan usaha orang-orang lain untuk membantu, aku mau menguji keikhlasan kasih kamu."
 },
 {
   "id": 28957,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 9,
   "firman": "Karena kamu telah mengenal kasih karunia Tuhan kita Yesus Kristus, bahwa Ia, yang oleh karena kamu menjadi miskin, sekalipun Ia kaya, supaya kamu menjadi kaya oleh karena kemiskinan-Nya."
 },
 {
   "id": 28958,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 10,
   "firman": "Inilah pendapatku tentang hal itu, yang mungkin berfaedah bagimu. Memang sudah sejak tahun yang lalu kamu mulai melaksanakannya dan mengambil keputusan untuk menyelesaikannya juga."
 },
 {
   "id": 28959,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 11,
   "firman": "Maka sekarang, selesaikan jugalah pelaksanaannya itu! Hendaklah pelaksanaannya sepadan dengan kerelaanmu, dan lakukanlah itu dengan apa yang ada padamu."
 },
 {
   "id": 28960,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 12,
   "firman": "Sebab jika kamu rela untuk memberi, maka pemberianmu akan diterima, kalau pemberianmu itu berdasarkan apa yang ada padamu, bukan berdasarkan apa yang tidak ada padamu."
 },
 {
   "id": 28961,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 13,
   "firman": "Sebab kamu dibebani bukanlah supaya orang-orang lain mendapat keringanan, tetapi supaya ada keseimbangan."
 },
 {
   "id": 28962,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 14,
   "firman": "Maka hendaklah sekarang ini kelebihan kamu mencukupkan kekurangan mereka, agar kelebihan mereka kemudian mencukupkan kekurangan kamu, supaya ada keseimbangan."
 },
 {
   "id": 28963,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 15,
   "firman": "Seperti ada tertulis: \"Orang yang mengumpulkan banyak, tidak kelebihan dan orang yang mengumpulkan sedikit, tidak kekurangan.\""
 },
 {
   "id": 28964,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 16,
   "firman": "Syukur kepada Allah, yang oleh karena kamu mengaruniakan kesungguhan yang demikian juga dalam hati Titus untuk membantu kamu."
 },
 {
   "id": 28965,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 17,
   "firman": "Memang ia menyambut anjuran kami, tetapi dalam kesungguhannya yang besar itu ia dengan sukarela pergi kepada kamu."
 },
 {
   "id": 28966,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 18,
   "firman": "Bersama-sama dengan dia kami mengutus saudara kita, yang terpuji di semua jemaat karena pekerjaannya dalam pemberitaan Injil."
 },
 {
   "id": 28967,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 19,
   "firman": "Dan bukan itu saja! Ia juga telah ditunjuk oleh jemaat-jemaat untuk menemani kami dalam pelayanan kasih ini, yang kami lakukan untuk kemuliaan Tuhan dan sebagai bukti kerelaan kami."
 },
 {
   "id": 28968,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 20,
   "firman": "Sebab kami hendak menghindarkan hal ini: bahwa ada orang yang dapat mencela kami dalam hal pelayanan kasih yang kami lakukan dan yang hasilnya sebesar ini."
 },
 {
   "id": 28969,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 21,
   "firman": "Karena kami memikirkan yang baik, bukan hanya di hadapan Tuhan, tetapi juga di hadapan manusia."
 },
 {
   "id": 28970,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 22,
   "firman": "Bersama-sama dengan mereka kami utus seorang lain lagi, yakni saudara kita, yang telah beberapa kali kami uji dan ternyata selalu berusaha untuk membantu. Dan sekarang ia makin berusaha karena besarnya kepercayaannya kepada kamu."
 },
 {
   "id": 28971,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 23,
   "firman": "Titus adalah temanku yang bekerja bersama-sama dengan aku untuk kamu; saudara-saudara kami yang lain itu adalah utusan jemaat-jemaat dan suatu kemuliaan bagi Kristus."
 },
 {
   "id": 28972,
   "kitab": "2Ko",
   "pasal": 8,
   "ayat": 24,
   "firman": "Karena itu tunjukkanlah kepada mereka di hadapan jemaat-jemaat bukti kasihmu dan bukti kemegahanku atas kamu."
 },
 {
   "id": 28973,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 1,
   "firman": "Tentang pelayanan kepada orang-orang kudus tidak perlu lagi aku menuliskannya kepada kamu."
 },
 {
   "id": 28974,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 2,
   "firman": "Aku telah tahu kerelaan hatimu tentang mana aku megahkan kamu kepada orang-orang Makedonia. Kataku: \"Akhaya sudah siap sedia sejak tahun yang lampau.\" Dan kegiatanmu telah menjadi perangsang bagi banyak orang."
 },
 {
   "id": 28975,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 3,
   "firman": "Aku mengutus saudara-saudara itu, agar kemegahan kami dalam hal ini atas kamu jangan ternyata menjadi sia-sia, tetapi supaya kamu benar-benar siap sedia seperti yang telah kukatakan,"
 },
 {
   "id": 28976,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 4,
   "firman": "supaya, apabila orang-orang Makedonia datang bersama-sama dengan aku, jangan mereka mendapati kamu belum siap sedia, sehingga kami--untuk tidak mengatakan kamu--merasa malu atas keyakinan kami itu."
 },
 {
   "id": 28977,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 5,
   "firman": "Sebab itu aku merasa perlu mendorong saudara-saudara itu untuk berangkat mendahului aku, supaya mereka lebih dahulu mengurus pemberian yang telah kamu janjikan sebelumnya, agar nanti tersedia sebagai bukti kemurahan hati kamu dan bukan sebagai pemberian yang dipaksakan."
 },
 {
   "id": 28978,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 6,
   "firman": "Camkanlah ini: Orang yang menabur sedikit, akan menuai sedikit juga, dan orang yang menabur banyak, akan menuai banyak juga."
 },
 {
   "id": 28979,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 7,
   "firman": "Hendaklah masing-masing memberikan menurut kerelaan hatinya, jangan dengan sedih hati atau karena paksaan, sebab Allah mengasihi orang yang memberi dengan sukacita."
 },
 {
   "id": 28980,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dan Allah sanggup melimpahkan segala kasih karunia kepada kamu, supaya kamu senantiasa berkecukupan di dalam segala sesuatu dan malah berkelebihan di dalam pelbagai kebajikan."
 },
 {
   "id": 28981,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 9,
   "firman": "Seperti ada tertulis: \"Ia membagi-bagikan, Ia memberikan kepada orang miskin, kebenaran-Nya tetap untuk selamanya.\""
 },
 {
   "id": 28982,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 10,
   "firman": "Ia yang menyediakan benih bagi penabur, dan roti untuk dimakan, Ia juga yang akan menyediakan benih bagi kamu dan melipatgandakannya dan menumbuhkan buah-buah kebenaranmu;"
 },
 {
   "id": 28983,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 11,
   "firman": "kamu akan diperkaya dalam segala macam kemurahan hati, yang membangkitkan syukur kepada Allah oleh karena kami."
 },
 {
   "id": 28984,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 12,
   "firman": "Sebab pelayanan kasih yang berisi pemberian ini bukan hanya mencukupkan keperluan-keperluan orang-orang kudus, tetapi juga melimpahkan ucapan syukur kepada Allah."
 },
 {
   "id": 28985,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 13,
   "firman": "Dan oleh sebab kamu telah tahan uji dalam pelayanan itu, mereka memuliakan Allah karena ketaatan kamu dalam pengakuan akan Injil Kristus dan karena kemurahan hatimu dalam membagikan segala sesuatu dengan mereka dan dengan semua orang,"
 },
 {
   "id": 28986,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 14,
   "firman": "sedangkan di dalam doa mereka, mereka juga merindukan kamu oleh karena kasih karunia Allah yang melimpah di atas kamu."
 },
 {
   "id": 28987,
   "kitab": "2Ko",
   "pasal": 9,
   "ayat": 15,
   "firman": "Syukur kepada Allah karena karunia-Nya yang tak terkatakan itu!"
 },
 {
   "id": 28988,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 1,
   "firman": "Aku, Paulus, seorang yang tidak berani bila berhadapan muka dengan kamu, tetapi berani terhadap kamu bila berjauhan, aku memperingatkan kamu demi Kristus yang lemah lembut dan ramah."
 },
 {
   "id": 28989,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 2,
   "firman": "Aku meminta kepada kamu: jangan kamu memaksa aku untuk menunjukkan keberanianku dari dekat, sebagaimana aku berniat bertindak keras terhadap orang-orang tertentu yang menyangka, bahwa kami hidup secara duniawi."
 },
 {
   "id": 28990,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 3,
   "firman": "Memang kami masih hidup di dunia, tetapi kami tidak berjuang secara duniawi,"
 },
 {
   "id": 28991,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 4,
   "firman": "karena senjata kami dalam perjuangan bukanlah senjata duniawi, melainkan senjata yang diperlengkapi dengan kuasa Allah, yang sanggup untuk meruntuhkan benteng-benteng."
 },
 {
   "id": 28992,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 5,
   "firman": "Kami mematahkan setiap siasat orang dan merubuhkan setiap kubu yang dibangun oleh keangkuhan manusia untuk menentang pengenalan akan Allah. Kami menawan segala pikiran dan menaklukkannya kepada Kristus,"
 },
 {
   "id": 28993,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 6,
   "firman": "dan kami siap sedia juga untuk menghukum setiap kedurhakaan, bila ketaatan kamu telah menjadi sempurna."
 },
 {
   "id": 28994,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 7,
   "firman": "Tengoklah yang nyata di depan mata kamu! Kalau ada seorang benar-benar yakin, bahwa ia adalah milik Kristus, hendaklah ia berpikir di dalam hatinya, bahwa kami juga adalah milik Kristus sama seperti dia."
 },
 {
   "id": 28995,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 8,
   "firman": "Bahkan, jikalau aku agak berlebih-lebihan bermegah atas kuasa, yang dikaruniakan Tuhan kepada kami untuk membangun dan bukan untuk meruntuhkan kamu, maka dalam hal itu aku tidak akan mendapat malu."
 },
 {
   "id": 28996,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 9,
   "firman": "Tetapi aku tidak mau kelihatan seolah-olah aku menakut-nakuti kamu dengan surat-suratku."
 },
 {
   "id": 28997,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 10,
   "firman": "Sebab, kata orang, surat-suratnya memang tegas dan keras, tetapi bila berhadapan muka sikapnya lemah dan perkataan-perkataannya tidak berarti."
 },
 {
   "id": 28998,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 11,
   "firman": "Tetapi hendaklah orang-orang yang berkata demikian menginsafi, bahwa tindakan kami, bila berhadapan muka, sama seperti perkataan kami dalam surat-surat kami, bila tidak berhadapan muka."
 },
 {
   "id": 28999,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 12,
   "firman": "Memang kami tidak berani menggolongkan diri kepada atau membandingkan diri dengan orang-orang tertentu yang memujikan diri sendiri. Mereka mengukur dirinya dengan ukuran mereka sendiri dan membandingkan dirinya dengan diri mereka sendiri. Alangkah bodohnya mereka!"
 },
 {
   "id": 29000,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 13,
   "firman": "Sebaliknya kami tidak mau bermegah melampaui batas, melainkan tetap di dalam batas-batas daerah kerja yang dipatok Allah bagi kami, yang meluas sampai kepada kamu juga."
 },
 {
   "id": 29001,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 14,
   "firman": "Sebab dalam memberitakan Injil Kristus kami telah sampai kepada kamu, sehingga kami tidak melewati batas daerah kerja kami, seolah-olah kami belum sampai kepada kamu."
 },
 {
   "id": 29002,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kami tidak bermegah atas pekerjaan yang dilakukan oleh orang lain di daerah kerja yang tidak dipatok untuk kami. Tetapi kami berharap, bahwa apabila imanmu makin bertumbuh, kami akan mendapat penghormatan lebih besar lagi di antara kamu, jika dibandingkan dengan daerah kerja yang dipatok untuk kami."
 },
 {
   "id": 29003,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 16,
   "firman": "Ya, kami hidup, supaya kami dapat memberitakan Injil di daerah-daerah yang lebih jauh dari pada daerah kamu dan tidak bermegah atas hasil-hasil yang dicapai orang lain di daerah kerja yang dipatok untuk mereka."
 },
 {
   "id": 29004,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 17,
   "firman": "\"Tetapi barangsiapa bermegah, hendaklah ia bermegah di dalam Tuhan.\""
 },
 {
   "id": 29005,
   "kitab": "2Ko",
   "pasal": 10,
   "ayat": 18,
   "firman": "Sebab bukan orang yang memuji diri yang tahan uji, melainkan orang yang dipuji Tuhan."
 },
 {
   "id": 29006,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 1,
   "firman": "Alangkah baiknya, jika kamu sabar terhadap kebodohanku yang kecil itu. Memang kamu sabar terhadap aku!"
 },
 {
   "id": 29007,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 2,
   "firman": "Sebab aku cemburu kepada kamu dengan cemburu ilahi. Karena aku telah mempertunangkan kamu kepada satu laki-laki untuk membawa kamu sebagai perawan suci kepada Kristus."
 },
 {
   "id": 29008,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 3,
   "firman": "Tetapi aku takut, kalau-kalau pikiran kamu disesatkan dari kesetiaan kamu yang sejati kepada Kristus, sama seperti Hawa diperdayakan oleh ular itu dengan kelicikannya."
 },
 {
   "id": 29009,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 4,
   "firman": "Sebab kamu sabar saja, jika ada seorang datang memberitakan Yesus yang lain dari pada yang telah kami beritakan, atau memberikan kepada kamu roh yang lain dari pada yang telah kamu terima atau Injil yang lain dari pada yang telah kamu terima."
 },
 {
   "id": 29010,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 5,
   "firman": "Tetapi menurut pendapatku sedikitpun aku tidak kurang dari pada rasul-rasul yang tak ada taranya itu."
 },
 {
   "id": 29011,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 6,
   "firman": "Jikalau aku kurang paham dalam hal berkata-kata, tidaklah demikian dalam hal pengetahuan; sebab kami telah menyatakannya kepada kamu pada segala waktu dan di dalam segala hal."
 },
 {
   "id": 29012,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 7,
   "firman": "Apakah aku berbuat salah, jika aku merendahkan diri untuk meninggikan kamu, karena aku memberitakan Injil Allah kepada kamu dengan cuma-cuma?"
 },
 {
   "id": 29013,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 8,
   "firman": "Jemaat-jemaat lain telah kurampok dengan menerima tunjangan dari mereka, supaya aku dapat melayani kamu!"
 },
 {
   "id": 29014,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dan ketika aku dalam kekurangan di tengah-tengah kamu, aku tidak menyusahkan seorangpun, sebab apa yang kurang padaku, dicukupkan oleh saudara-saudara yang datang dari Makedonia. Dalam segala hal aku menjaga diriku, supaya jangan menjadi beban bagi kamu, dan aku akan tetap berbuat demikian."
 },
 {
   "id": 29015,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 10,
   "firman": "Demi kebenaran Kristus di dalam diriku, aku tegaskan, bahwa kemegahanku itu tidak akan dirintangi oleh siapapun di daerah-daerah Akhaya."
 },
 {
   "id": 29016,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 11,
   "firman": "Mengapa tidak? Apakah karena aku tidak mengasihi kamu? Allah mengetahuinya."
 },
 {
   "id": 29017,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 12,
   "firman": "Tetapi apa yang kulakukan, akan tetap kulakukan untuk mencegah mereka yang mencari kesempatan guna menyatakan, bahwa mereka sama dengan kami dalam hal yang dapat dimegahkan."
 },
 {
   "id": 29018,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 13,
   "firman": "Sebab orang-orang itu adalah rasul-rasul palsu, pekerja-pekerja curang, yang menyamar sebagai rasul-rasul Kristus."
 },
 {
   "id": 29019,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 14,
   "firman": "Hal itu tidak usah mengherankan, sebab Iblispun menyamar sebagai malaikat Terang."
 },
 {
   "id": 29020,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 15,
   "firman": "Jadi bukanlah suatu hal yang ganjil, jika pelayan-pelayannya menyamar sebagai pelayan-pelayan kebenaran. Kesudahan mereka akan setimpal dengan perbuatan mereka."
 },
 {
   "id": 29021,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 16,
   "firman": "Kuulangi lagi: jangan hendaknya ada orang yang menganggap aku bodoh. Dan jika kamu juga menganggap demikian, terimalah aku sebagai orang bodoh supaya akupun boleh bermegah sedikit."
 },
 {
   "id": 29022,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 17,
   "firman": "Apa yang aku katakan, aku mengatakannya bukan sebagai seorang yang berkata menurut firman Tuhan, melainkan sebagai seorang bodoh yang berkeyakinan, bahwa ia boleh bermegah."
 },
 {
   "id": 29023,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 18,
   "firman": "Karena banyak orang yang bermegah secara duniawi, aku mau bermegah juga."
 },
 {
   "id": 29024,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 19,
   "firman": "Sebab kamu suka sabar terhadap orang bodoh, karena kamu begitu bijaksana:"
 },
 {
   "id": 29025,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 20,
   "firman": "karena kamu sabar, jika orang memperhambakan kamu, jika orang menghisap kamu, jika orang menguasai kamu, jika orang berlaku angkuh terhadap kamu, jika orang menampar kamu."
 },
 {
   "id": 29026,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 21,
   "firman": "Dengan sangat malu aku harus mengakui, bahwa dalam hal semacam itu kami terlalu lemah. Tetapi jika orang-orang lain berani membanggakan sesuatu, maka akupun--aku berkata dalam kebodohan--berani juga!"
 },
 {
   "id": 29027,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 22,
   "firman": "Apakah mereka orang Ibrani? Aku juga orang Ibrani! Apakah mereka orang Israel? Aku juga orang Israel. Apakah mereka keturunan Abraham? Aku juga keturunan Abraham!"
 },
 {
   "id": 29028,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 23,
   "firman": "Apakah mereka pelayan Kristus? --aku berkata seperti orang gila--aku lebih lagi! Aku lebih banyak berjerih lelah; lebih sering di dalam penjara; didera di luar batas; kerap kali dalam bahaya maut."
 },
 {
   "id": 29029,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 24,
   "firman": "Lima kali aku disesah orang Yahudi, setiap kali empat puluh kurang satu pukulan,"
 },
 {
   "id": 29030,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 25,
   "firman": "tiga kali aku didera, satu kali aku dilempari dengan batu, tiga kali mengalami karam kapal, sehari semalam aku terkatung-katung di tengah laut."
 },
 {
   "id": 29031,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 26,
   "firman": "Dalam perjalananku aku sering diancam bahaya banjir dan bahaya penyamun, bahaya dari pihak orang-orang Yahudi dan dari pihak orang-orang bukan Yahudi; bahaya di kota, bahaya di padang gurun, bahaya di tengah laut, dan bahaya dari pihak saudara-saudara palsu."
 },
 {
   "id": 29032,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 27,
   "firman": "Aku banyak berjerih lelah dan bekerja berat; kerap kali aku tidak tidur; aku lapar dan dahaga; kerap kali aku berpuasa, kedinginan dan tanpa pakaian,"
 },
 {
   "id": 29033,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 28,
   "firman": "dan, dengan tidak menyebut banyak hal lain lagi, urusanku sehari-hari, yaitu untuk memelihara semua jemaat-jemaat."
 },
 {
   "id": 29034,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 29,
   "firman": "Jika ada orang merasa lemah, tidakkah aku turut merasa lemah? Jika ada orang tersandung, tidakkah hatiku hancur oleh dukacita?"
 },
 {
   "id": 29035,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 30,
   "firman": "Jika aku harus bermegah, maka aku akan bermegah atas kelemahanku."
 },
 {
   "id": 29036,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 31,
   "firman": "Allah, yaitu Bapa dari Yesus, Tuhan kita, yang terpuji sampai selama-lamanya, tahu, bahwa aku tidak berdusta."
 },
 {
   "id": 29037,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 32,
   "firman": "Di Damsyik wali negeri raja Aretas menyuruh mengawal kota orang-orang Damsyik untuk menangkap aku."
 },
 {
   "id": 29038,
   "kitab": "2Ko",
   "pasal": 11,
   "ayat": 33,
   "firman": "Tetapi dalam sebuah keranjang aku diturunkan dari sebuah tingkap ke luar tembok kota dan dengan demikian aku terluput dari tangannya."
 },
 {
   "id": 29039,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 1,
   "firman": "Aku harus bermegah, sekalipun memang hal itu tidak ada faedahnya, namun demikian aku hendak memberitakan penglihatan-penglihatan dan penyataan-penyataan yang kuterima dari Tuhan."
 },
 {
   "id": 29040,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 2,
   "firman": "Aku tahu tentang seorang Kristen; empat belas tahun yang lampau--entah di dalam tubuh, aku tidak tahu, entah di luar tubuh, aku tidak tahu, Allah yang mengetahuinya--orang itu tiba-tiba diangkat ke tingkat yang ketiga dari sorga."
 },
 {
   "id": 29041,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 3,
   "firman": "Aku juga tahu tentang orang itu, --entah di dalam tubuh entah di luar tubuh, aku tidak tahu, Allah yang mengetahuinya--"
 },
 {
   "id": 29042,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 4,
   "firman": "ia tiba-tiba diangkat ke Firdaus dan ia mendengar kata-kata yang tak terkatakan, yang tidak boleh diucapkan manusia."
 },
 {
   "id": 29043,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 5,
   "firman": "Atas orang itu aku hendak bermegah, tetapi atas diriku sendiri aku tidak akan bermegah, selain atas kelemahan-kelemahanku."
 },
 {
   "id": 29044,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 6,
   "firman": "Sebab sekiranya aku hendak bermegah juga, aku bukan orang bodoh lagi, karena aku mengatakan kebenaran. Tetapi aku menahan diriku, supaya jangan ada orang yang menghitungkan kepadaku lebih dari pada yang mereka lihat padaku atau yang mereka dengar dari padaku."
 },
 {
   "id": 29045,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 7,
   "firman": "Dan supaya aku jangan meninggikan diri karena penyataan-penyataan yang luar biasa itu, maka aku diberi suatu duri di dalam dagingku, yaitu seorang utusan Iblis untuk menggocoh aku, supaya aku jangan meninggikan diri."
 },
 {
   "id": 29046,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 8,
   "firman": "Tentang hal itu aku sudah tiga kali berseru kepada Tuhan, supaya utusan Iblis itu mundur dari padaku."
 },
 {
   "id": 29047,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 9,
   "firman": "Tetapi jawab Tuhan kepadaku: \"Cukuplah kasih karunia-Ku bagimu, sebab justru dalam kelemahanlah kuasa-Ku menjadi sempurna.\" Sebab itu terlebih suka aku bermegah atas kelemahanku, supaya kuasa Kristus turun menaungi aku."
 },
 {
   "id": 29048,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 10,
   "firman": "Karena itu aku senang dan rela di dalam kelemahan, di dalam siksaan, di dalam kesukaran, di dalam penganiayaan dan kesesakan oleh karena Kristus. Sebab jika aku lemah, maka aku kuat."
 },
 {
   "id": 29049,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 11,
   "firman": "Sungguh aku telah menjadi bodoh; tetapi kamu yang memaksa aku. Sebenarnya aku harus kamu puji. Karena meskipun aku tidak berarti sedikitpun, namun di dalam segala hal aku tidak kalah terhadap rasul-rasul yang luar biasa itu."
 },
 {
   "id": 29050,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 12,
   "firman": "Segala sesuatu yang membuktikan, bahwa aku adalah seorang rasul, telah dilakukan di tengah-tengah kamu dengan segala kesabaran oleh tanda-tanda, mujizat-mujizat dan kuasa-kuasa."
 },
 {
   "id": 29051,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 13,
   "firman": "Sebab dalam hal manakah kamu dikebelakangkan dibandingkan dengan jemaat-jemaat lain, selain dari pada dalam hal ini, yaitu bahwa aku sendiri tidak menjadi suatu beban kepada kamu? Maafkanlah ketidakadilanku ini!"
 },
 {
   "id": 29052,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 14,
   "firman": "Sesungguhnya sekarang sudah untuk ketiga kalinya aku siap untuk mengunjungi kamu, dan aku tidak akan merupakan suatu beban bagi kamu. Sebab bukan hartamu yang kucari, melainkan kamu sendiri. Karena bukan anak-anak yang harus mengumpulkan harta untuk orang tuanya, melainkan orang tualah untuk anak-anaknya."
 },
 {
   "id": 29053,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 15,
   "firman": "Karena itu aku suka mengorbankan milikku, bahkan mengorbankan diriku untuk kamu. Jadi jika aku sangat mengasihi kamu, masakan aku semakin kurang dikasihi?"
 },
 {
   "id": 29054,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 16,
   "firman": "Baiklah, aku sendiri tidak merupakan suatu beban bagi kamu, tetapi--kamu katakan--dalam kelicikanku aku telah menjerat kamu dengan tipu daya."
 },
 {
   "id": 29055,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 17,
   "firman": "Jadi pernahkah aku mengambil untung dari pada kamu oleh seorang dari antara mereka, yang kuutus kepada kamu?"
 },
 {
   "id": 29056,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 18,
   "firman": "Memang aku telah meminta Titus untuk pergi dan bersama-sama dengan dia aku mengutus saudara yang lain itu. Adakah Titus mengambil untung dari pada kamu? Tidakkah kami berdua hidup menurut roh yang sama dan tidakkah kami berlaku menurut cara yang sama?"
 },
 {
   "id": 29057,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 19,
   "firman": "Sudah lama agaknya kamu menyangka, bahwa kami hendak membela diri di depan kamu. Di hadapan Allah dan demi Kristus kami berkata: semua ini, saudara-saudaraku yang kekasih, terjadi untuk membangun iman kamu."
 },
 {
   "id": 29058,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 20,
   "firman": "Sebab aku kuatir, bahwa apabila aku datang aku mendapati kamu tidak seperti yang kuinginkan dan kamu mendapati aku tidak seperti yang kamu inginkan. Aku kuatir akan adanya perselisihan, iri hati, amarah, kepentingan diri sendiri, fitnah, bisik-bisikan, keangkuhan, dan kerusuhan."
 },
 {
   "id": 29059,
   "kitab": "2Ko",
   "pasal": 12,
   "ayat": 21,
   "firman": "Aku kuatir, bahwa apabila aku datang lagi, Allahku akan merendahkan aku di depan kamu, dan bahwa aku akan berdukacita terhadap banyak orang yang di masa yang lampau berbuat dosa dan belum lagi bertobat dari kecemaran, percabulan dan ketidaksopanan yang mereka lakukan."
 },
 {
   "id": 29060,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 1,
   "firman": "Ini adalah untuk ketiga kalinya aku datang kepada kamu: Baru dengan keterangan dua atau tiga orang saksi suatu perkara sah."
 },
 {
   "id": 29061,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 2,
   "firman": "Kepada mereka, yang di masa yang lampau berbuat dosa, dan kepada semua orang lain, telah kukatakan terlebih dahulu dan aku akan mengatakannya sekali lagi--sekarang pada waktu aku berjauhan dengan kamu tepat seperti pada waktu kedatanganku kedua kalinya--bahwa aku tidak akan menyayangkan mereka pada waktu aku datang lagi."
 },
 {
   "id": 29062,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 3,
   "firman": "Karena kamu ingin suatu bukti, bahwa Kristus berkata-kata dengan perantaraan aku, dan Ia tidak lemah terhadap kamu, melainkan berkuasa di tengah-tengah kamu."
 },
 {
   "id": 29063,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 4,
   "firman": "Karena sekalipun Ia telah disalibkan oleh karena kelemahan, namun Ia hidup karena kuasa Allah. Memang kami adalah lemah di dalam Dia, tetapi kami akan hidup bersama-sama dengan Dia untuk kamu karena kuasa Allah."
 },
 {
   "id": 29064,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 5,
   "firman": "Ujilah dirimu sendiri, apakah kamu tetap tegak di dalam iman. Selidikilah dirimu! Apakah kamu tidak yakin akan dirimu, bahwa Kristus Yesus ada di dalam diri kamu? Sebab jika tidak demikian, kamu tidak tahan uji."
 },
 {
   "id": 29065,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 6,
   "firman": "Tetapi aku harap, bahwa kamu tahu, bahwa bukan kami yang tidak tahan uji."
 },
 {
   "id": 29066,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 7,
   "firman": "Kami berdoa kepada Allah, agar kamu jangan berbuat jahat bukan supaya kami ternyata tahan uji, melainkan supaya kamu ini boleh berbuat apa yang baik, sekalipun kami sendiri tampaknya tidak tahan uji."
 },
 {
   "id": 29067,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 8,
   "firman": "Karena kami tidak dapat berbuat apa-apa melawan kebenaran; yang dapat kami perbuat ialah untuk kebenaran."
 },
 {
   "id": 29068,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 9,
   "firman": "Sebab kami bersukacita, apabila kami lemah dan kamu kuat. Dan inilah yang kami doakan, yaitu supaya kamu menjadi sempurna."
 },
 {
   "id": 29069,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 10,
   "firman": "Itulah sebabnya sekali ini aku menulis kepada kamu ketika aku berjauhan dengan kamu, supaya bila aku berada di tengah-tengah kamu, aku tidak terpaksa bertindak keras menurut kuasa yang dianugerahkan Tuhan kepadaku untuk membangun dan bukan untuk meruntuhkan."
 },
 {
   "id": 29070,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 11,
   "firman": "Akhirnya, saudara-saudaraku, bersukacitalah, usahakanlah dirimu supaya sempurna. Terimalah segala nasihatku! Sehati sepikirlah kamu, dan hiduplah dalam damai sejahtera; maka Allah, sumber kasih dan damai sejahtera akan menyertai kamu!"
 },
 {
   "id": 29071,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 12,
   "firman": "Berilah salam seorang kepada yang lain dengan cium yang kudus."
 },
 {
   "id": 29072,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 13,
   "firman": "(13-12b) Salam dari semua orang kudus kepada kamu."
 },
 {
   "id": 29073,
   "kitab": "2Ko",
   "pasal": 13,
   "ayat": 14,
   "firman": "(13-13) Kasih karunia Tuhan Yesus Kristus, dan kasih Allah, dan persekutuan Roh Kudus menyertai kamu sekalian."
 },
 {
   "id": 29074,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, seorang rasul, bukan karena manusia, juga bukan oleh seorang manusia, melainkan oleh Yesus Kristus dan Allah, Bapa, yang telah membangkitkan Dia dari antara orang mati,"
 },
 {
   "id": 29075,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 2,
   "firman": "dan dari semua saudara yang ada bersama-sama dengan aku, kepada jemaat-jemaat di Galatia:"
 },
 {
   "id": 29076,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 3,
   "firman": "kasih karunia menyertai kamu dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus,"
 },
 {
   "id": 29077,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 4,
   "firman": "yang telah menyerahkan diri-Nya karena dosa-dosa kita, untuk melepaskan kita dari dunia jahat yang sekarang ini, menurut kehendak Allah dan Bapa kita."
 },
 {
   "id": 29078,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 5,
   "firman": "Bagi-Nyalah kemuliaan selama-lamanya! Amin."
 },
 {
   "id": 29079,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 6,
   "firman": "Aku heran, bahwa kamu begitu lekas berbalik dari pada Dia, yang oleh kasih karunia Kristus telah memanggil kamu, dan mengikuti suatu injil lain,"
 },
 {
   "id": 29080,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 7,
   "firman": "yang sebenarnya bukan Injil. Hanya ada orang yang mengacaukan kamu dan yang bermaksud untuk memutarbalikkan Injil Kristus."
 },
 {
   "id": 29081,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 8,
   "firman": "Tetapi sekalipun kami atau seorang malaikat dari sorga yang memberitakan kepada kamu suatu injil yang berbeda dengan Injil yang telah kami beritakan kepadamu, terkutuklah dia."
 },
 {
   "id": 29082,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 9,
   "firman": "Seperti yang telah kami katakan dahulu, sekarang kukatakan sekali lagi: jikalau ada orang yang memberitakan kepadamu suatu injil, yang berbeda dengan apa yang telah kamu terima, terkutuklah dia."
 },
 {
   "id": 29083,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 10,
   "firman": "Jadi bagaimana sekarang: adakah kucari kesukaan manusia atau kesukaan Allah? Adakah kucoba berkenan kepada manusia? Sekiranya aku masih mau mencoba berkenan kepada manusia, maka aku bukanlah hamba Kristus."
 },
 {
   "id": 29084,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab aku menegaskan kepadamu, saudara-saudaraku, bahwa Injil yang kuberitakan itu bukanlah injil manusia."
 },
 {
   "id": 29085,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 12,
   "firman": "Karena aku bukan menerimanya dari manusia, dan bukan manusia yang mengajarkannya kepadaku, tetapi aku menerimanya oleh penyataan Yesus Kristus."
 },
 {
   "id": 29086,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 13,
   "firman": "Sebab kamu telah mendengar tentang hidupku dahulu dalam agama Yahudi: tanpa batas aku menganiaya jemaat Allah dan berusaha membinasakannya."
 },
 {
   "id": 29087,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 14,
   "firman": "Dan di dalam agama Yahudi aku jauh lebih maju dari banyak teman yang sebaya dengan aku di antara bangsaku, sebagai orang yang sangat rajin memelihara adat istiadat nenek moyangku."
 },
 {
   "id": 29088,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 15,
   "firman": "Tetapi waktu Ia, yang telah memilih aku sejak kandungan ibuku dan memanggil aku oleh kasih karunia-Nya,"
 },
 {
   "id": 29089,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 16,
   "firman": "berkenan menyatakan Anak-Nya di dalam aku, supaya aku memberitakan Dia di antara bangsa-bangsa bukan Yahudi, maka sesaatpun aku tidak minta pertimbangan kepada manusia;"
 },
 {
   "id": 29090,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 17,
   "firman": "juga aku tidak pergi ke Yerusalem mendapatkan mereka yang telah menjadi rasul sebelum aku, tetapi aku berangkat ke tanah Arab dan dari situ kembali lagi ke Damsyik."
 },
 {
   "id": 29091,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 18,
   "firman": "Lalu, tiga tahun kemudian, aku pergi ke Yerusalem untuk mengunjungi Kefas, dan aku menumpang lima belas hari di rumahnya."
 },
 {
   "id": 29092,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 19,
   "firman": "Tetapi aku tidak melihat seorangpun dari rasul-rasul yang lain, kecuali Yakobus, saudara Tuhan Yesus."
 },
 {
   "id": 29093,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 20,
   "firman": "Di hadapan Allah kutegaskan: apa yang kutuliskan kepadamu ini benar, aku tidak berdusta."
 },
 {
   "id": 29094,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 21,
   "firman": "Kemudian aku pergi ke daerah-daerah Siria dan Kilikia."
 },
 {
   "id": 29095,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tetapi rupaku tetap tidak dikenal oleh jemaat-jemaat Kristus di Yudea."
 },
 {
   "id": 29096,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 23,
   "firman": "Mereka hanya mendengar, bahwa ia yang dahulu menganiaya mereka, sekarang memberitakan iman, yang pernah hendak dibinasakannya."
 },
 {
   "id": 29097,
   "kitab": "Gal",
   "pasal": 1,
   "ayat": 24,
   "firman": "Dan mereka memuliakan Allah karena aku."
 },
 {
   "id": 29098,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 1,
   "firman": "Kemudian setelah lewat empat belas tahun, aku pergi pula ke Yerusalem dengan Barnabas dan Tituspun kubawa juga."
 },
 {
   "id": 29099,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 2,
   "firman": "Aku pergi berdasarkan suatu penyataan. Dan kepada mereka kubentangkan Injil yang kuberitakan di antara bangsa-bangsa bukan Yahudi--dalam percakapan tersendiri kepada mereka yang terpandang--,supaya jangan dengan percuma aku berusaha atau telah berusaha."
 },
 {
   "id": 29100,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 3,
   "firman": "Tetapi kendatipun Titus, yang bersama-sama dengan aku, adalah seorang Yunani, namun ia tidak dipaksa untuk menyunatkan dirinya."
 },
 {
   "id": 29101,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 4,
   "firman": "Memang ada desakan dari saudara-saudara palsu yang menyusup masuk, yaitu mereka yang menyelundup ke dalam untuk menghadang kebebasan kita yang kita miliki di dalam Kristus Yesus, supaya dengan jalan itu mereka dapat memperhambakan kita."
 },
 {
   "id": 29102,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi sesaatpun kami tidak mau mundur dan tunduk kepada mereka, agar kebenaran Injil dapat tinggal tetap pada kamu."
 },
 {
   "id": 29103,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 6,
   "firman": "Dan mengenai mereka yang dianggap terpandang itu--bagaimana kedudukan mereka dahulu, itu tidak penting bagiku, sebab Allah tidak memandang muka--bagaimanapun juga, mereka yang terpandang itu tidak memaksakan sesuatu yang lain kepadaku."
 },
 {
   "id": 29104,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tetapi sebaliknya, setelah mereka melihat bahwa kepadaku telah dipercayakan pemberitaan Injil untuk orang-orang tak bersunat, sama seperti kepada Petrus untuk orang-orang bersunat"
 },
 {
   "id": 29105,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 8,
   "firman": "--karena Ia yang telah memberikan kekuatan kepada Petrus untuk menjadi rasul bagi orang-orang bersunat, Ia juga yang telah memberikan kekuatan kepadaku untuk orang-orang yang tidak bersunat."
 },
 {
   "id": 29106,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 9,
   "firman": "Dan setelah melihat kasih karunia yang dianugerahkan kepadaku, maka Yakobus, Kefas dan Yohanes, yang dipandang sebagai sokoguru jemaat, berjabat tangan dengan aku dan dengan Barnabas sebagai tanda persekutuan, supaya kami pergi kepada orang-orang yang tidak bersunat dan mereka kepada orang-orang yang bersunat;"
 },
 {
   "id": 29107,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 10,
   "firman": "hanya kami harus tetap mengingat orang-orang miskin dan memang itulah yang sungguh-sungguh kuusahakan melakukannya."
 },
 {
   "id": 29108,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 11,
   "firman": "Tetapi waktu Kefas datang ke Antiokhia, aku berterang-terang menentangnya, sebab ia salah."
 },
 {
   "id": 29109,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 12,
   "firman": "Karena sebelum beberapa orang dari kalangan Yakobus datang, ia makan sehidangan dengan saudara-saudara yang tidak bersunat, tetapi setelah mereka datang, ia mengundurkan diri dan menjauhi mereka karena takut akan saudara-saudara yang bersunat."
 },
 {
   "id": 29110,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan orang-orang Yahudi yang lainpun turut berlaku munafik dengan dia, sehingga Barnabas sendiri turut terseret oleh kemunafikan mereka."
 },
 {
   "id": 29111,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 14,
   "firman": "Tetapi waktu kulihat, bahwa kelakuan mereka itu tidak sesuai dengan kebenaran Injil, aku berkata kepada Kefas di hadapan mereka semua: \"Jika engkau, seorang Yahudi, hidup secara kafir dan bukan secara Yahudi, bagaimanakah engkau dapat memaksa saudara-saudara yang tidak bersunat untuk hidup secara Yahudi?\""
 },
 {
   "id": 29112,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 15,
   "firman": "Menurut kelahiran kami adalah orang Yahudi dan bukan orang berdosa dari bangsa-bangsa lain."
 },
 {
   "id": 29113,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 16,
   "firman": "Kamu tahu, bahwa tidak seorangpun yang dibenarkan oleh karena melakukan hukum Taurat, tetapi hanya oleh karena iman dalam Kristus Yesus. Sebab itu kamipun telah percaya kepada Kristus Yesus, supaya kami dibenarkan oleh karena iman dalam Kristus dan bukan oleh karena melakukan hukum Taurat. Sebab: \"tidak ada seorangpun yang dibenarkan\" oleh karena melakukan hukum Taurat."
 },
 {
   "id": 29114,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi jika kami sendiri, sementara kami berusaha untuk dibenarkan dalam Kristus ternyata adalah orang-orang berdosa, apakah hal itu berarti, bahwa Kristus adalah pelayan dosa? Sekali-kali tidak."
 },
 {
   "id": 29115,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 18,
   "firman": "Karena, jikalau aku membangun kembali apa yang telah kurombak, aku menyatakan diriku sebagai pelanggar hukum Taurat."
 },
 {
   "id": 29116,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 19,
   "firman": "Sebab aku telah mati oleh hukum Taurat untuk hukum Taurat, supaya aku hidup untuk Allah. Aku telah disalibkan dengan Kristus;"
 },
 {
   "id": 29117,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 20,
   "firman": "namun aku hidup, tetapi bukan lagi aku sendiri yang hidup, melainkan Kristus yang hidup di dalam aku. Dan hidupku yang kuhidupi sekarang di dalam daging, adalah hidup oleh iman dalam Anak Allah yang telah mengasihi aku dan menyerahkan diri-Nya untuk aku."
 },
 {
   "id": 29118,
   "kitab": "Gal",
   "pasal": 2,
   "ayat": 21,
   "firman": "Aku tidak menolak kasih karunia Allah. Sebab sekiranya ada kebenaran oleh hukum Taurat, maka sia-sialah kematian Kristus."
 },
 {
   "id": 29119,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 1,
   "firman": "Hai orang-orang Galatia yang bodoh, siapakah yang telah mempesona kamu? Bukankah Yesus Kristus yang disalibkan itu telah dilukiskan dengan terang di depanmu?"
 },
 {
   "id": 29120,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 2,
   "firman": "Hanya ini yang hendak kuketahui dari pada kamu: Adakah kamu telah menerima Roh karena melakukan hukum Taurat atau karena percaya kepada pemberitaan Injil?"
 },
 {
   "id": 29121,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 3,
   "firman": "Adakah kamu sebodoh itu? Kamu telah mulai dengan Roh, maukah kamu sekarang mengakhirinya di dalam daging?"
 },
 {
   "id": 29122,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sia-siakah semua yang telah kamu alami sebanyak itu? Masakan sia-sia!"
 },
 {
   "id": 29123,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 5,
   "firman": "Jadi bagaimana sekarang, apakah Ia yang menganugerahkan Roh kepada kamu dengan berlimpah-limpah dan yang melakukan mujizat di antara kamu, berbuat demikian karena kamu melakukan hukum Taurat atau karena kamu percaya kepada pemberitaan Injil?"
 },
 {
   "id": 29124,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 6,
   "firman": "Secara itu jugalah Abraham percaya kepada Allah, maka Allah memperhitungkan hal itu kepadanya sebagai kebenaran."
 },
 {
   "id": 29125,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 7,
   "firman": "Jadi kamu lihat, bahwa mereka yang hidup dari iman, mereka itulah anak-anak Abraham."
 },
 {
   "id": 29126,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 8,
   "firman": "Dan Kitab Suci, yang sebelumnya mengetahui, bahwa Allah membenarkan orang-orang bukan Yahudi oleh karena iman, telah terlebih dahulu memberitakan Injil kepada Abraham: \"Olehmu segala bangsa akan diberkati.\""
 },
 {
   "id": 29127,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 9,
   "firman": "Jadi mereka yang hidup dari iman, merekalah yang diberkati bersama-sama dengan Abraham yang beriman itu."
 },
 {
   "id": 29128,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 10,
   "firman": "Karena semua orang, yang hidup dari pekerjaan hukum Taurat, berada di bawah kutuk. Sebab ada tertulis: \"Terkutuklah orang yang tidak setia melakukan segala sesuatu yang tertulis dalam kitab hukum Taurat.\""
 },
 {
   "id": 29129,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 11,
   "firman": "Dan bahwa tidak ada orang yang dibenarkan di hadapan Allah karena melakukan hukum Taurat adalah jelas, karena: \"Orang yang benar akan hidup oleh iman.\""
 },
 {
   "id": 29130,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 12,
   "firman": "Tetapi dasar hukum Taurat bukanlah iman, melainkan siapa yang melakukannya, akan hidup karenanya."
 },
 {
   "id": 29131,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 13,
   "firman": "Kristus telah menebus kita dari kutuk hukum Taurat dengan jalan menjadi kutuk karena kita, sebab ada tertulis: \"Terkutuklah orang yang digantung pada kayu salib!\""
 },
 {
   "id": 29132,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 14,
   "firman": "Yesus Kristus telah membuat ini, supaya di dalam Dia berkat Abraham sampai kepada bangsa-bangsa lain, sehingga oleh iman kita menerima Roh yang telah dijanjikan itu."
 },
 {
   "id": 29133,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 15,
   "firman": "Saudara-saudara, baiklah kupergunakan suatu contoh dari hidup sehari-hari. Suatu wasiat yang telah disahkan, sekalipun ia dari manusia, tidak dapat dibatalkan atau ditambahi oleh seorangpun."
 },
 {
   "id": 29134,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 16,
   "firman": "Adapun kepada Abraham diucapkan segala janji itu dan kepada keturunannya. Tidak dikatakan \"kepada keturunan-keturunannya\" seolah-olah dimaksud banyak orang, tetapi hanya satu orang: \"dan kepada keturunanmu\", yaitu Kristus."
 },
 {
   "id": 29135,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 17,
   "firman": "Maksudku ialah: Janji yang sebelumnya telah disahkan Allah, tidak dapat dibatalkan oleh hukum Taurat, yang baru terbit empat ratus tiga puluh tahun kemudian, sehingga janji itu hilang kekuatannya."
 },
 {
   "id": 29136,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 18,
   "firman": "Sebab, jikalau apa yang ditentukan Allah berasal dari hukum Taurat, ia tidak berasal dari janji; tetapi justru oleh janjilah Allah telah menganugerahkan kasih karunia-Nya kepada Abraham."
 },
 {
   "id": 29137,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 19,
   "firman": "Kalau demikian, apakah maksudnya hukum Taurat? Ia ditambahkan oleh karena pelanggaran-pelanggaran--sampai datang keturunan yang dimaksud oleh janji itu--dan ia disampaikan dengan perantaraan malaikat-malaikat ke dalam tangan seorang pengantara."
 },
 {
   "id": 29138,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 20,
   "firman": "Seorang pengantara bukan hanya mewakili satu orang saja, sedangkan Allah adalah satu."
 },
 {
   "id": 29139,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 21,
   "firman": "Kalau demikian, bertentangankah hukum Taurat dengan janji-janji Allah? Sekali-kali tidak. Sebab andaikata hukum Taurat diberikan sebagai sesuatu yang dapat menghidupkan, maka memang kebenaran berasal dari hukum Taurat."
 },
 {
   "id": 29140,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 22,
   "firman": "Tetapi Kitab Suci telah mengurung segala sesuatu di bawah kekuasaan dosa, supaya oleh karena iman dalam Yesus Kristus janji itu diberikan kepada mereka yang percaya."
 },
 {
   "id": 29141,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 23,
   "firman": "Sebelum iman itu datang kita berada di bawah pengawalan hukum Taurat, dan dikurung sampai iman itu telah dinyatakan."
 },
 {
   "id": 29142,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 24,
   "firman": "Jadi hukum Taurat adalah penuntun bagi kita sampai Kristus datang, supaya kita dibenarkan karena iman."
 },
 {
   "id": 29143,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 25,
   "firman": "Sekarang iman itu telah datang, karena itu kita tidak berada lagi di bawah pengawasan penuntun."
 },
 {
   "id": 29144,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 26,
   "firman": "Sebab kamu semua adalah anak-anak Allah karena iman di dalam Yesus Kristus."
 },
 {
   "id": 29145,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 27,
   "firman": "Karena kamu semua, yang dibaptis dalam Kristus, telah mengenakan Kristus."
 },
 {
   "id": 29146,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 28,
   "firman": "Dalam hal ini tidak ada orang Yahudi atau orang Yunani, tidak ada hamba atau orang merdeka, tidak ada laki-laki atau perempuan, karena kamu semua adalah satu di dalam Kristus Yesus."
 },
 {
   "id": 29147,
   "kitab": "Gal",
   "pasal": 3,
   "ayat": 29,
   "firman": "Dan jikalau kamu adalah milik Kristus, maka kamu juga adalah keturunan Abraham dan berhak menerima janji Allah."
 },
 {
   "id": 29148,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 1,
   "firman": "Yang dimaksud ialah: selama seorang ahli waris belum akil balig, sedikitpun ia tidak berbeda dengan seorang hamba, sungguhpun ia adalah tuan dari segala sesuatu;"
 },
 {
   "id": 29149,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 2,
   "firman": "tetapi ia berada di bawah perwalian dan pengawasan sampai pada saat yang telah ditentukan oleh bapanya."
 },
 {
   "id": 29150,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 3,
   "firman": "Demikian pula kita: selama kita belum akil balig, kita takluk juga kepada roh-roh dunia."
 },
 {
   "id": 29151,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi setelah genap waktunya, maka Allah mengutus Anak-Nya, yang lahir dari seorang perempuan dan takluk kepada hukum Taurat."
 },
 {
   "id": 29152,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 5,
   "firman": "Ia diutus untuk menebus mereka, yang takluk kepada hukum Taurat, supaya kita diterima menjadi anak."
 },
 {
   "id": 29153,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 6,
   "firman": "Dan karena kamu adalah anak, maka Allah telah menyuruh Roh Anak-Nya ke dalam hati kita, yang berseru: \"ya Abba, ya Bapa!\""
 },
 {
   "id": 29154,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 7,
   "firman": "Jadi kamu bukan lagi hamba, melainkan anak; jikalau kamu anak, maka kamu juga adalah ahli-ahli waris, oleh Allah."
 },
 {
   "id": 29155,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dahulu, ketika kamu tidak mengenal Allah, kamu memperhambakan diri kepada allah-allah yang pada hakekatnya bukan Allah."
 },
 {
   "id": 29156,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tetapi sekarang sesudah kamu mengenal Allah, atau lebih baik, sesudah kamu dikenal Allah, bagaimanakah kamu berbalik lagi kepada roh-roh dunia yang lemah dan miskin dan mau mulai memperhambakan diri lagi kepadanya?"
 },
 {
   "id": 29157,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 10,
   "firman": "Kamu dengan teliti memelihara hari-hari tertentu, bulan-bulan, masa-masa yang tetap dan tahun-tahun."
 },
 {
   "id": 29158,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 11,
   "firman": "Aku kuatir kalau-kalau susah payahku untuk kamu telah sia-sia."
 },
 {
   "id": 29159,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 12,
   "firman": "Aku minta kepadamu, saudara-saudara, jadilah sama seperti aku, sebab akupun telah menjadi sama seperti kamu. Belum pernah kualami sesuatu yang tidak baik dari padamu."
 },
 {
   "id": 29160,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 13,
   "firman": "Kamu tahu, bahwa aku pertama kali telah memberitakan Injil kepadamu oleh karena aku sakit pada tubuhku."
 },
 {
   "id": 29161,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 14,
   "firman": "Sungguhpun demikian keadaan tubuhku itu, yang merupakan pencobaan bagi kamu, namun kamu tidak menganggapnya sebagai sesuatu yang hina dan yang menjijikkan, tetapi kamu telah menyambut aku, sama seperti menyambut seorang malaikat Allah, malahan sama seperti menyambut Kristus Yesus sendiri."
 },
 {
   "id": 29162,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 15,
   "firman": "Betapa bahagianya kamu pada waktu itu! Dan sekarang, di manakah bahagiamu itu? Karena aku dapat bersaksi tentang kamu, bahwa jika mungkin, kamu telah mencungkil matamu dan memberikannya kepadaku."
 },
 {
   "id": 29163,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 16,
   "firman": "Apakah dengan mengatakan kebenaran kepadamu aku telah menjadi musuhmu?"
 },
 {
   "id": 29164,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 17,
   "firman": "Mereka dengan giat berusaha untuk menarik kamu, tetapi tidak dengan tulus hati, karena mereka mau mengucilkan kamu, supaya kamu dengan giat mengikuti mereka."
 },
 {
   "id": 29165,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 18,
   "firman": "Memang baik kalau orang dengan giat berusaha menarik orang lain dalam perkara-perkara yang baik, asal pada setiap waktu dan bukan hanya bila aku ada di antaramu."
 },
 {
   "id": 29166,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 19,
   "firman": "Hai anak-anakku, karena kamu aku menderita sakit bersalin lagi, sampai rupa Kristus menjadi nyata di dalam kamu."
 },
 {
   "id": 29167,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 20,
   "firman": "Betapa rinduku untuk berada di antara kamu pada saat ini dan dapat berbicara dengan suara yang lain, karena aku telah habis akal menghadapi kamu."
 },
 {
   "id": 29168,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 21,
   "firman": "Katakanlah kepadaku, hai kamu yang mau hidup di bawah hukum Taurat, tidakkah kamu mendengarkan hukum Taurat?"
 },
 {
   "id": 29169,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 22,
   "firman": "Bukankah ada tertulis, bahwa Abraham mempunyai dua anak, seorang dari perempuan yang menjadi hambanya dan seorang dari perempuan yang merdeka?"
 },
 {
   "id": 29170,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 23,
   "firman": "Tetapi anak dari perempuan yang menjadi hambanya itu diperanakkan menurut daging dan anak dari perempuan yang merdeka itu oleh karena janji."
 },
 {
   "id": 29171,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 24,
   "firman": "Ini adalah suatu kiasan. Sebab kedua perempuan itu adalah dua ketentuan Allah: yang satu berasal dari gunung Sinai dan melahirkan anak-anak perhambaan, itulah Hagar--"
 },
 {
   "id": 29172,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 25,
   "firman": "Hagar ialah gunung Sinai di tanah Arab--dan ia sama dengan Yerusalem yang sekarang, karena ia hidup dalam perhambaan dengan anak-anaknya."
 },
 {
   "id": 29173,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 26,
   "firman": "Tetapi Yerusalem sorgawi adalah perempuan yang merdeka, dan ialah ibu kita."
 },
 {
   "id": 29174,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 27,
   "firman": "Karena ada tertulis: \"Bersukacitalah, hai si mandul yang tidak pernah melahirkan! Bergembira dan bersorak-sorailah, hai engkau yang tidak pernah menderita sakit bersalin! Sebab yang ditinggalkan suaminya akan mempunyai lebih banyak anak dari pada yang bersuami.\""
 },
 {
   "id": 29175,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 28,
   "firman": "Dan kamu, saudara-saudara, kamu sama seperti Ishak adalah anak-anak janji."
 },
 {
   "id": 29176,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 29,
   "firman": "Tetapi seperti dahulu, dia, yang diperanakkan menurut daging, menganiaya yang diperanakkan menurut Roh, demikian juga sekarang ini."
 },
 {
   "id": 29177,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 30,
   "firman": "Tetapi apa kata nas Kitab Suci? \"Usirlah hamba perempuan itu beserta anaknya, sebab anak hamba perempuan itu tidak akan menjadi ahli waris bersama-sama dengan anak perempuan merdeka itu.\""
 },
 {
   "id": 29178,
   "kitab": "Gal",
   "pasal": 4,
   "ayat": 31,
   "firman": "Karena itu, saudara-saudara, kita bukanlah anak-anak hamba perempuan, melainkan anak-anak perempuan merdeka."
 },
 {
   "id": 29179,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 1,
   "firman": "Supaya kita sungguh-sungguh merdeka, Kristus telah memerdekakan kita. Karena itu berdirilah teguh dan jangan mau lagi dikenakan kuk perhambaan."
 },
 {
   "id": 29180,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 2,
   "firman": "Sesungguhnya, aku, Paulus, berkata kepadamu: jikalau kamu menyunatkan dirimu, Kristus sama sekali tidak akan berguna bagimu."
 },
 {
   "id": 29181,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 3,
   "firman": "Sekali lagi aku katakan kepada setiap orang yang menyunatkan dirinya, bahwa ia wajib melakukan seluruh hukum Taurat."
 },
 {
   "id": 29182,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 4,
   "firman": "Kamu lepas dari Kristus, jikalau kamu mengharapkan kebenaran oleh hukum Taurat; kamu hidup di luar kasih karunia."
 },
 {
   "id": 29183,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 5,
   "firman": "Sebab oleh Roh, dan karena iman, kita menantikan kebenaran yang kita harapkan."
 },
 {
   "id": 29184,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 6,
   "firman": "Sebab bagi orang-orang yang ada di dalam Kristus Yesus hal bersunat atau tidak bersunat tidak mempunyai sesuatu arti, hanya iman yang bekerja oleh kasih."
 },
 {
   "id": 29185,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 7,
   "firman": "Dahulu kamu berlomba dengan baik. Siapakah yang menghalang-halangi kamu, sehingga kamu tidak menuruti kebenaran lagi?"
 },
 {
   "id": 29186,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 8,
   "firman": "Ajakan untuk tidak menurutinya lagi bukan datang dari Dia, yang memanggil kamu."
 },
 {
   "id": 29187,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 9,
   "firman": "Sedikit ragi sudah mengkhamirkan seluruh adonan."
 },
 {
   "id": 29188,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 10,
   "firman": "Dalam Tuhan aku yakin tentang kamu, bahwa kamu tidak mempunyai pendirian lain dari pada pendirian ini. Tetapi barangsiapa yang mengacaukan kamu, ia akan menanggung hukumannya, siapapun juga dia."
 },
 {
   "id": 29189,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 11,
   "firman": "Dan lagi aku ini, saudara-saudara, jikalau aku masih memberitakan sunat, mengapakah aku masih dianiaya juga? Sebab kalau demikian, salib bukan batu sandungan lagi."
 },
 {
   "id": 29190,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 12,
   "firman": "Baiklah mereka yang menghasut kamu itu mengebirikan saja dirinya!"
 },
 {
   "id": 29191,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 13,
   "firman": "Saudara-saudara, memang kamu telah dipanggil untuk merdeka. Tetapi janganlah kamu mempergunakan kemerdekaan itu sebagai kesempatan untuk kehidupan dalam dosa, melainkan layanilah seorang akan yang lain oleh kasih."
 },
 {
   "id": 29192,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 14,
   "firman": "Sebab seluruh hukum Taurat tercakup dalam satu firman ini, yaitu: \"Kasihilah sesamamu manusia seperti dirimu sendiri!\""
 },
 {
   "id": 29193,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 15,
   "firman": "Tetapi jikalau kamu saling menggigit dan saling menelan, awaslah, supaya jangan kamu saling membinasakan."
 },
 {
   "id": 29194,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 16,
   "firman": "Maksudku ialah: hiduplah oleh Roh, maka kamu tidak akan menuruti keinginan daging."
 },
 {
   "id": 29195,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 17,
   "firman": "Sebab keinginan daging berlawanan dengan keinginan Roh dan keinginan Roh berlawanan dengan keinginan daging--karena keduanya bertentangan--sehingga kamu setiap kali tidak melakukan apa yang kamu kehendaki."
 },
 {
   "id": 29196,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 18,
   "firman": "Akan tetapi jikalau kamu memberi dirimu dipimpin oleh Roh, maka kamu tidak hidup di bawah hukum Taurat."
 },
 {
   "id": 29197,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 19,
   "firman": "Perbuatan daging telah nyata, yaitu: percabulan, kecemaran, hawa nafsu,"
 },
 {
   "id": 29198,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 20,
   "firman": "penyembahan berhala, sihir, perseteruan, perselisihan, iri hati, amarah, kepentingan diri sendiri, percideraan, roh pemecah,"
 },
 {
   "id": 29199,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 21,
   "firman": "kedengkian, kemabukan, pesta pora dan sebagainya. Terhadap semuanya itu kuperingatkan kamu--seperti yang telah kubuat dahulu--bahwa barangsiapa melakukan hal-hal yang demikian, ia tidak akan mendapat bagian dalam Kerajaan Allah."
 },
 {
   "id": 29200,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 22,
   "firman": "Tetapi buah Roh ialah: kasih, sukacita, damai sejahtera, kesabaran, kemurahan, kebaikan, kesetiaan,"
 },
 {
   "id": 29201,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 23,
   "firman": "kelemahlembutan, penguasaan diri. Tidak ada hukum yang menentang hal-hal itu."
 },
 {
   "id": 29202,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 24,
   "firman": "Barangsiapa menjadi milik Kristus Yesus, ia telah menyalibkan daging dengan segala hawa nafsu dan keinginannya."
 },
 {
   "id": 29203,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 25,
   "firman": "Jikalau kita hidup oleh Roh, baiklah hidup kita juga dipimpin oleh Roh,"
 },
 {
   "id": 29204,
   "kitab": "Gal",
   "pasal": 5,
   "ayat": 26,
   "firman": "dan janganlah kita gila hormat, janganlah kita saling menantang dan saling mendengki."
 },
 {
   "id": 29205,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 1,
   "firman": "Saudara-saudara, kalaupun seorang kedapatan melakukan suatu pelanggaran, maka kamu yang rohani, harus memimpin orang itu ke jalan yang benar dalam roh lemah lembut, sambil menjaga dirimu sendiri, supaya kamu juga jangan kena pencobaan."
 },
 {
   "id": 29206,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 2,
   "firman": "Bertolong-tolonganlah menanggung bebanmu! Demikianlah kamu memenuhi hukum Kristus."
 },
 {
   "id": 29207,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 3,
   "firman": "Sebab kalau seorang menyangka, bahwa ia berarti, padahal ia sama sekali tidak berarti, ia menipu dirinya sendiri."
 },
 {
   "id": 29208,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 4,
   "firman": "Baiklah tiap-tiap orang menguji pekerjaannya sendiri; maka ia boleh bermegah melihat keadaannya sendiri dan bukan melihat keadaan orang lain."
 },
 {
   "id": 29209,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 5,
   "firman": "Sebab tiap-tiap orang akan memikul tanggungannya sendiri."
 },
 {
   "id": 29210,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 6,
   "firman": "Dan baiklah dia, yang menerima pengajaran dalam Firman, membagi segala sesuatu yang ada padanya dengan orang yang memberikan pengajaran itu."
 },
 {
   "id": 29211,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 7,
   "firman": "Jangan sesat! Allah tidak membiarkan diri-Nya dipermainkan. Karena apa yang ditabur orang, itu juga yang akan dituainya."
 },
 {
   "id": 29212,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 8,
   "firman": "Sebab barangsiapa menabur dalam dagingnya, ia akan menuai kebinasaan dari dagingnya, tetapi barangsiapa menabur dalam Roh, ia akan menuai hidup yang kekal dari Roh itu."
 },
 {
   "id": 29213,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 9,
   "firman": "Janganlah kita jemu-jemu berbuat baik, karena apabila sudah datang waktunya, kita akan menuai, jika kita tidak menjadi lemah."
 },
 {
   "id": 29214,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 10,
   "firman": "Karena itu, selama masih ada kesempatan bagi kita, marilah kita berbuat baik kepada semua orang, tetapi terutama kepada kawan-kawan kita seiman."
 },
 {
   "id": 29215,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 11,
   "firman": "Lihatlah, bagaimana besarnya huruf-huruf yang kutulis kepadamu dengan tanganku sendiri."
 },
 {
   "id": 29216,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 12,
   "firman": "Mereka yang secara lahiriah suka menonjolkan diri, merekalah yang berusaha memaksa kamu untuk bersunat, hanya dengan maksud, supaya mereka tidak dianiaya karena salib Kristus."
 },
 {
   "id": 29217,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 13,
   "firman": "Sebab mereka yang menyunatkan dirinyapun, tidak memelihara hukum Taurat. Tetapi mereka menghendaki, supaya kamu menyunatkan diri, agar mereka dapat bermegah atas keadaanmu yang lahiriah."
 },
 {
   "id": 29218,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 14,
   "firman": "Tetapi aku sekali-kali tidak mau bermegah, selain dalam salib Tuhan kita Yesus Kristus, sebab olehnya dunia telah disalibkan bagiku dan aku bagi dunia."
 },
 {
   "id": 29219,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 15,
   "firman": "Sebab bersunat atau tidak bersunat tidak ada artinya, tetapi menjadi ciptaan baru, itulah yang ada artinya."
 },
 {
   "id": 29220,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 16,
   "firman": "Dan semua orang, yang memberi dirinya dipimpin oleh patokan ini, turunlah kiranya damai sejahtera dan rahmat atas mereka dan atas Israel milik Allah."
 },
 {
   "id": 29221,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 17,
   "firman": "Selanjutnya janganlah ada orang yang menyusahkan aku, karena pada tubuhku ada tanda-tanda milik Yesus."
 },
 {
   "id": 29222,
   "kitab": "Gal",
   "pasal": 6,
   "ayat": 18,
   "firman": "Kasih karunia Tuhan kita Yesus Kristus menyertai roh kamu, saudara-saudara! Amin."
 },
 {
   "id": 29223,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, rasul Kristus Yesus oleh kehendak Allah, kepada orang-orang kudus di Efesus, orang-orang percaya dalam Kristus Yesus."
 },
 {
   "id": 29224,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 29225,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 3,
   "firman": "Terpujilah Allah dan Bapa Tuhan kita Yesus Kristus yang dalam Kristus telah mengaruniakan kepada kita segala berkat rohani di dalam sorga."
 },
 {
   "id": 29226,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 4,
   "firman": "Sebab di dalam Dia Allah telah memilih kita sebelum dunia dijadikan, supaya kita kudus dan tak bercacat di hadapan-Nya."
 },
 {
   "id": 29227,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dalam kasih Ia telah menentukan kita dari semula oleh Yesus Kristus untuk menjadi anak-anak-Nya, sesuai dengan kerelaan kehendak-Nya,"
 },
 {
   "id": 29228,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 6,
   "firman": "supaya terpujilah kasih karunia-Nya yang mulia, yang dikaruniakan-Nya kepada kita di dalam Dia, yang dikasihi-Nya."
 },
 {
   "id": 29229,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sebab di dalam Dia dan oleh darah-Nya kita beroleh penebusan, yaitu pengampunan dosa, menurut kekayaan kasih karunia-Nya,"
 },
 {
   "id": 29230,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 8,
   "firman": "yang dilimpahkan-Nya kepada kita dalam segala hikmat dan pengertian."
 },
 {
   "id": 29231,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sebab Ia telah menyatakan rahasia kehendak-Nya kepada kita, sesuai dengan rencana kerelaan-Nya, yaitu rencana kerelaan yang dari semula telah ditetapkan-Nya di dalam Kristus"
 },
 {
   "id": 29232,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 10,
   "firman": "sebagai persiapan kegenapan waktu untuk mempersatukan di dalam Kristus sebagai Kepala segala sesuatu, baik yang di sorga maupun yang di bumi."
 },
 {
   "id": 29233,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 11,
   "firman": "Aku katakan \"di dalam Kristus\", karena di dalam Dialah kami mendapat bagian yang dijanjikan--kami yang dari semula ditentukan untuk menerima bagian itu sesuai dengan maksud Allah, yang di dalam segala sesuatu bekerja menurut keputusan kehendak-Nya--"
 },
 {
   "id": 29234,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 12,
   "firman": "supaya kami, yang sebelumnya telah menaruh harapan pada Kristus, boleh menjadi puji-pujian bagi kemuliaan-Nya."
 },
 {
   "id": 29235,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 13,
   "firman": "Di dalam Dia kamu juga--karena kamu telah mendengar firman kebenaran, yaitu Injil keselamatanmu--di dalam Dia kamu juga, ketika kamu percaya, dimeteraikan dengan Roh Kudus, yang dijanjikan-Nya itu."
 },
 {
   "id": 29236,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 14,
   "firman": "Dan Roh Kudus itu adalah jaminan bagian kita sampai kita memperoleh seluruhnya, yaitu penebusan yang menjadikan kita milik Allah, untuk memuji kemuliaan-Nya."
 },
 {
   "id": 29237,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 15,
   "firman": "Karena itu, setelah aku mendengar tentang imanmu dalam Tuhan Yesus dan tentang kasihmu terhadap semua orang kudus,"
 },
 {
   "id": 29238,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 16,
   "firman": "akupun tidak berhenti mengucap syukur karena kamu. Dan aku selalu mengingat kamu dalam doaku,"
 },
 {
   "id": 29239,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 17,
   "firman": "dan meminta kepada Allah Tuhan kita Yesus Kristus, yaitu Bapa yang mulia itu, supaya Ia memberikan kepadamu Roh hikmat dan wahyu untuk mengenal Dia dengan benar."
 },
 {
   "id": 29240,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 18,
   "firman": "Dan supaya Ia menjadikan mata hatimu terang, agar kamu mengerti pengharapan apakah yang terkandung dalam panggilan-Nya: betapa kayanya kemuliaan bagian yang ditentukan-Nya bagi orang-orang kudus,"
 },
 {
   "id": 29241,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 19,
   "firman": "dan betapa hebat kuasa-Nya bagi kita yang percaya, sesuai dengan kekuatan kuasa-Nya,"
 },
 {
   "id": 29242,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 20,
   "firman": "yang dikerjakan-Nya di dalam Kristus dengan membangkitkan Dia dari antara orang mati dan mendudukkan Dia di sebelah kanan-Nya di sorga,"
 },
 {
   "id": 29243,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 21,
   "firman": "jauh lebih tinggi dari segala pemerintah dan penguasa dan kekuasaan dan kerajaan dan tiap-tiap nama yang dapat disebut, bukan hanya di dunia ini saja, melainkan juga di dunia yang akan datang."
 },
 {
   "id": 29244,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 22,
   "firman": "Dan segala sesuatu telah diletakkan-Nya di bawah kaki Kristus dan Dia telah diberikan-Nya kepada jemaat sebagai Kepala dari segala yang ada."
 },
 {
   "id": 29245,
   "kitab": "Efe",
   "pasal": 1,
   "ayat": 23,
   "firman": "Jemaat yang adalah tubuh-Nya, yaitu kepenuhan Dia, yang memenuhi semua dan segala sesuatu."
 },
 {
   "id": 29246,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 1,
   "firman": "Kamu dahulu sudah mati karena pelanggaran-pelanggaran dan dosa-dosamu."
 },
 {
   "id": 29247,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 2,
   "firman": "Kamu hidup di dalamnya, karena kamu mengikuti jalan dunia ini, karena kamu mentaati penguasa kerajaan angkasa, yaitu roh yang sekarang sedang bekerja di antara orang-orang durhaka."
 },
 {
   "id": 29248,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 3,
   "firman": "Sebenarnya dahulu kami semua juga terhitung di antara mereka, ketika kami hidup di dalam hawa nafsu daging dan menuruti kehendak daging dan pikiran kami yang jahat. Pada dasarnya kami adalah orang-orang yang harus dimurkai, sama seperti mereka yang lain."
 },
 {
   "id": 29249,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 4,
   "firman": "Tetapi Allah yang kaya dengan rahmat, oleh karena kasih-Nya yang besar, yang dilimpahkan-Nya kepada kita,"
 },
 {
   "id": 29250,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 5,
   "firman": "telah menghidupkan kita bersama-sama dengan Kristus, sekalipun kita telah mati oleh kesalahan-kesalahan kita--oleh kasih karunia kamu diselamatkan--"
 },
 {
   "id": 29251,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 6,
   "firman": "dan di dalam Kristus Yesus Ia telah membangkitkan kita juga dan memberikan tempat bersama-sama dengan Dia di sorga,"
 },
 {
   "id": 29252,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 7,
   "firman": "supaya pada masa yang akan datang Ia menunjukkan kepada kita kekayaan kasih karunia-Nya yang melimpah-limpah sesuai dengan kebaikan-Nya terhadap kita dalam Kristus Yesus."
 },
 {
   "id": 29253,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 8,
   "firman": "Sebab karena kasih karunia kamu diselamatkan oleh iman; itu bukan hasil usahamu, tetapi pemberian Allah,"
 },
 {
   "id": 29254,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 9,
   "firman": "itu bukan hasil pekerjaanmu: jangan ada orang yang memegahkan diri."
 },
 {
   "id": 29255,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 10,
   "firman": "Karena kita ini buatan Allah, diciptakan dalam Kristus Yesus untuk melakukan pekerjaan baik, yang dipersiapkan Allah sebelumnya. Ia mau, supaya kita hidup di dalamnya."
 },
 {
   "id": 29256,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 11,
   "firman": "Karena itu ingatlah, bahwa dahulu kamu--sebagai orang-orang bukan Yahudi menurut daging, yang disebut orang-orang tak bersunat oleh mereka yang menamakan dirinya \"sunat\", yaitu sunat lahiriah yang dikerjakan oleh tangan manusia, --"
 },
 {
   "id": 29257,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 12,
   "firman": "bahwa waktu itu kamu tanpa Kristus, tidak termasuk kewargaan Israel dan tidak mendapat bagian dalam ketentuan-ketentuan yang dijanjikan, tanpa pengharapan dan tanpa Allah di dalam dunia."
 },
 {
   "id": 29258,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 13,
   "firman": "Tetapi sekarang di dalam Kristus Yesus kamu, yang dahulu \"jauh\", sudah menjadi \"dekat\" oleh darah Kristus."
 },
 {
   "id": 29259,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 14,
   "firman": "Karena Dialah damai sejahtera kita, yang telah mempersatukan kedua pihak dan yang telah merubuhkan tembok pemisah, yaitu perseteruan,"
 },
 {
   "id": 29260,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 15,
   "firman": "sebab dengan mati-Nya sebagai manusia Ia telah membatalkan hukum Taurat dengan segala perintah dan ketentuannya, untuk menciptakan keduanya menjadi satu manusia baru di dalam diri-Nya, dan dengan itu mengadakan damai sejahtera,"
 },
 {
   "id": 29261,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 16,
   "firman": "dan untuk memperdamaikan keduanya, di dalam satu tubuh, dengan Allah oleh salib, dengan melenyapkan perseteruan pada salib itu."
 },
 {
   "id": 29262,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 17,
   "firman": "Ia datang dan memberitakan damai sejahtera kepada kamu yang \"jauh\" dan damai sejahtera kepada mereka yang \"dekat\","
 },
 {
   "id": 29263,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 18,
   "firman": "karena oleh Dia kita kedua pihak dalam satu Roh beroleh jalan masuk kepada Bapa."
 },
 {
   "id": 29264,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 19,
   "firman": "Demikianlah kamu bukan lagi orang asing dan pendatang, melainkan kawan sewarga dari orang-orang kudus dan anggota-anggota keluarga Allah,"
 },
 {
   "id": 29265,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 20,
   "firman": "yang dibangun di atas dasar para rasul dan para nabi, dengan Kristus Yesus sebagai batu penjuru."
 },
 {
   "id": 29266,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 21,
   "firman": "Di dalam Dia tumbuh seluruh bangunan, rapih tersusun, menjadi bait Allah yang kudus, di dalam Tuhan."
 },
 {
   "id": 29267,
   "kitab": "Efe",
   "pasal": 2,
   "ayat": 22,
   "firman": "Di dalam Dia kamu juga turut dibangunkan menjadi tempat kediaman Allah, di dalam Roh."
 },
 {
   "id": 29268,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 1,
   "firman": "Itulah sebabnya aku ini, Paulus, orang yang dipenjarakan karena Kristus Yesus untuk kamu orang-orang yang tidak mengenal Allah"
 },
 {
   "id": 29269,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 2,
   "firman": "--memang kamu telah mendengar tentang tugas penyelenggaraan kasih karunia Allah, yang dipercayakan kepadaku karena kamu,"
 },
 {
   "id": 29270,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 3,
   "firman": "yaitu bagaimana rahasianya dinyatakan kepadaku dengan wahyu, seperti yang telah kutulis di atas dengan singkat."
 },
 {
   "id": 29271,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 4,
   "firman": "Apabila kamu membacanya, kamu dapat mengetahui dari padanya pengertianku akan rahasia Kristus,"
 },
 {
   "id": 29272,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 5,
   "firman": "yang pada zaman angkatan-angkatan dahulu tidak diberitakan kepada anak-anak manusia, tetapi yang sekarang dinyatakan di dalam Roh kepada rasul-rasul dan nabi-nabi-Nya yang kudus,"
 },
 {
   "id": 29273,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 6,
   "firman": "yaitu bahwa orang-orang bukan Yahudi, karena Berita Injil, turut menjadi ahli-ahli waris dan anggota-anggota tubuh dan peserta dalam janji yang diberikan dalam Kristus Yesus."
 },
 {
   "id": 29274,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 7,
   "firman": "Dari Injil itu aku telah menjadi pelayannya menurut pemberian kasih karunia Allah, yang dianugerahkan kepadaku sesuai dengan pengerjaan kuasa-Nya."
 },
 {
   "id": 29275,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 8,
   "firman": "Kepadaku, yang paling hina di antara segala orang kudus, telah dianugerahkan kasih karunia ini, untuk memberitakan kepada orang-orang bukan Yahudi kekayaan Kristus, yang tidak terduga itu,"
 },
 {
   "id": 29276,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 9,
   "firman": "dan untuk menyatakan apa isinya tugas penyelenggaraan rahasia yang telah berabad-abad tersembunyi dalam Allah, yang menciptakan segala sesuatu,"
 },
 {
   "id": 29277,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 10,
   "firman": "supaya sekarang oleh jemaat diberitahukan pelbagai ragam hikmat Allah kepada pemerintah-pemerintah dan penguasa-penguasa di sorga,"
 },
 {
   "id": 29278,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 11,
   "firman": "sesuai dengan maksud abadi, yang telah dilaksanakan-Nya dalam Kristus Yesus, Tuhan kita."
 },
 {
   "id": 29279,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 12,
   "firman": "Di dalam Dia kita beroleh keberanian dan jalan masuk kepada Allah dengan penuh kepercayaan oleh iman kita kepada-Nya."
 },
 {
   "id": 29280,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 13,
   "firman": "Sebab itu aku minta kepadamu, supaya kamu jangan tawar hati melihat kesesakanku karena kamu, karena kesesakanku itu adalah kemuliaanmu."
 },
 {
   "id": 29281,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 14,
   "firman": "Itulah sebabnya aku sujud kepada Bapa,"
 },
 {
   "id": 29282,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 15,
   "firman": "yang dari pada-Nya semua turunan yang di dalam sorga dan di atas bumi menerima namanya."
 },
 {
   "id": 29283,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 16,
   "firman": "Aku berdoa supaya Ia, menurut kekayaan kemuliaan-Nya, menguatkan dan meneguhkan kamu oleh Roh-Nya di dalam batinmu,"
 },
 {
   "id": 29284,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 17,
   "firman": "sehingga oleh imanmu Kristus diam di dalam hatimu dan kamu berakar serta berdasar di dalam kasih."
 },
 {
   "id": 29285,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 18,
   "firman": "Aku berdoa, supaya kamu bersama-sama dengan segala orang kudus dapat memahami, betapa lebarnya dan panjangnya dan tingginya dan dalamnya kasih Kristus,"
 },
 {
   "id": 29286,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 19,
   "firman": "dan dapat mengenal kasih itu, sekalipun ia melampaui segala pengetahuan. Aku berdoa, supaya kamu dipenuhi di dalam seluruh kepenuhan Allah."
 },
 {
   "id": 29287,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 20,
   "firman": "Bagi Dialah, yang dapat melakukan jauh lebih banyak dari pada yang kita doakan atau pikirkan, seperti yang ternyata dari kuasa yang bekerja di dalam kita,"
 },
 {
   "id": 29288,
   "kitab": "Efe",
   "pasal": 3,
   "ayat": 21,
   "firman": "bagi Dialah kemuliaan di dalam jemaat dan di dalam Kristus Yesus turun-temurun sampai selama-lamanya. Amin."
 },
 {
   "id": 29289,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 1,
   "firman": "Sebab itu aku menasihatkan kamu, aku, orang yang dipenjarakan karena Tuhan, supaya hidupmu sebagai orang-orang yang telah dipanggil berpadanan dengan panggilan itu."
 },
 {
   "id": 29290,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 2,
   "firman": "Hendaklah kamu selalu rendah hati, lemah lembut, dan sabar. Tunjukkanlah kasihmu dalam hal saling membantu."
 },
 {
   "id": 29291,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 3,
   "firman": "Dan berusahalah memelihara kesatuan Roh oleh ikatan damai sejahtera:"
 },
 {
   "id": 29292,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 4,
   "firman": "satu tubuh, dan satu Roh, sebagaimana kamu telah dipanggil kepada satu pengharapan yang terkandung dalam panggilanmu,"
 },
 {
   "id": 29293,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 5,
   "firman": "satu Tuhan, satu iman, satu baptisan,"
 },
 {
   "id": 29294,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 6,
   "firman": "satu Allah dan Bapa dari semua, Allah yang di atas semua dan oleh semua dan di dalam semua."
 },
 {
   "id": 29295,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 7,
   "firman": "Tetapi kepada kita masing-masing telah dianugerahkan kasih karunia menurut ukuran pemberian Kristus."
 },
 {
   "id": 29296,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 8,
   "firman": "Itulah sebabnya kata nas: \"Tatkala Ia naik ke tempat tinggi, Ia membawa tawanan-tawanan; Ia memberikan pemberian-pemberian kepada manusia.\""
 },
 {
   "id": 29297,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 9,
   "firman": "Bukankah \"Ia telah naik\" berarti, bahwa Ia juga telah turun ke bagian bumi yang paling bawah?"
 },
 {
   "id": 29298,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 10,
   "firman": "Ia yang telah turun, Ia juga yang telah naik jauh lebih tinggi dari pada semua langit, untuk memenuhkan segala sesuatu."
 },
 {
   "id": 29299,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 11,
   "firman": "Dan Ialah yang memberikan baik rasul-rasul maupun nabi-nabi, baik pemberita-pemberita Injil maupun gembala-gembala dan pengajar-pengajar,"
 },
 {
   "id": 29300,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 12,
   "firman": "untuk memperlengkapi orang-orang kudus bagi pekerjaan pelayanan, bagi pembangunan tubuh Kristus,"
 },
 {
   "id": 29301,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 13,
   "firman": "sampai kita semua telah mencapai kesatuan iman dan pengetahuan yang benar tentang Anak Allah, kedewasaan penuh, dan tingkat pertumbuhan yang sesuai dengan kepenuhan Kristus,"
 },
 {
   "id": 29302,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 14,
   "firman": "sehingga kita bukan lagi anak-anak, yang diombang-ambingkan oleh rupa-rupa angin pengajaran, oleh permainan palsu manusia dalam kelicikan mereka yang menyesatkan,"
 },
 {
   "id": 29303,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 15,
   "firman": "tetapi dengan teguh berpegang kepada kebenaran di dalam kasih kita bertumbuh di dalam segala hal ke arah Dia, Kristus, yang adalah Kepala."
 },
 {
   "id": 29304,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 16,
   "firman": "Dari pada-Nyalah seluruh tubuh, --yang rapih tersusun dan diikat menjadi satu oleh pelayanan semua bagiannya, sesuai dengan kadar pekerjaan tiap-tiap anggota--menerima pertumbuhannya dan membangun dirinya dalam kasih."
 },
 {
   "id": 29305,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 17,
   "firman": "Sebab itu kukatakan dan kutegaskan ini kepadamu di dalam Tuhan: Jangan hidup lagi sama seperti orang-orang yang tidak mengenal Allah dengan pikirannya yang sia-sia"
 },
 {
   "id": 29306,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 18,
   "firman": "dan pengertiannya yang gelap, jauh dari hidup persekutuan dengan Allah, karena kebodohan yang ada di dalam mereka dan karena kedegilan hati mereka."
 },
 {
   "id": 29307,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 19,
   "firman": "Perasaan mereka telah tumpul, sehingga mereka menyerahkan diri kepada hawa nafsu dan mengerjakan dengan serakah segala macam kecemaran."
 },
 {
   "id": 29308,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 20,
   "firman": "Tetapi kamu bukan demikian. Kamu telah belajar mengenal Kristus."
 },
 {
   "id": 29309,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 21,
   "firman": "Karena kamu telah mendengar tentang Dia dan menerima pengajaran di dalam Dia menurut kebenaran yang nyata dalam Yesus,"
 },
 {
   "id": 29310,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 22,
   "firman": "yaitu bahwa kamu, berhubung dengan kehidupan kamu yang dahulu, harus menanggalkan manusia lama, yang menemui kebinasaannya oleh nafsunya yang menyesatkan,"
 },
 {
   "id": 29311,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 23,
   "firman": "supaya kamu dibaharui di dalam roh dan pikiranmu,"
 },
 {
   "id": 29312,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 24,
   "firman": "dan mengenakan manusia baru, yang telah diciptakan menurut kehendak Allah di dalam kebenaran dan kekudusan yang sesungguhnya."
 },
 {
   "id": 29313,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 25,
   "firman": "Karena itu buanglah dusta dan berkatalah benar seorang kepada yang lain, karena kita adalah sesama anggota."
 },
 {
   "id": 29314,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 26,
   "firman": "Apabila kamu menjadi marah, janganlah kamu berbuat dosa: janganlah matahari terbenam, sebelum padam amarahmu"
 },
 {
   "id": 29315,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 27,
   "firman": "dan janganlah beri kesempatan kepada Iblis."
 },
 {
   "id": 29316,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 28,
   "firman": "Orang yang mencuri, janganlah ia mencuri lagi, tetapi baiklah ia bekerja keras dan melakukan pekerjaan yang baik dengan tangannya sendiri, supaya ia dapat membagikan sesuatu kepada orang yang berkekurangan."
 },
 {
   "id": 29317,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 29,
   "firman": "Janganlah ada perkataan kotor keluar dari mulutmu, tetapi pakailah perkataan yang baik untuk membangun, di mana perlu, supaya mereka yang mendengarnya, beroleh kasih karunia."
 },
 {
   "id": 29318,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 30,
   "firman": "Dan janganlah kamu mendukakan Roh Kudus Allah, yang telah memeteraikan kamu menjelang hari penyelamatan."
 },
 {
   "id": 29319,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 31,
   "firman": "Segala kepahitan, kegeraman, kemarahan, pertikaian dan fitnah hendaklah dibuang dari antara kamu, demikian pula segala kejahatan."
 },
 {
   "id": 29320,
   "kitab": "Efe",
   "pasal": 4,
   "ayat": 32,
   "firman": "Tetapi hendaklah kamu ramah seorang terhadap yang lain, penuh kasih mesra dan saling mengampuni, sebagaimana Allah di dalam Kristus telah mengampuni kamu."
 },
 {
   "id": 29321,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 1,
   "firman": "Sebab itu jadilah penurut-penurut Allah, seperti anak-anak yang kekasih"
 },
 {
   "id": 29322,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 2,
   "firman": "dan hiduplah di dalam kasih, sebagaimana Kristus Yesus juga telah mengasihi kamu dan telah menyerahkan diri-Nya untuk kita sebagai persembahan dan korban yang harum bagi Allah."
 },
 {
   "id": 29323,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 3,
   "firman": "Tetapi percabulan dan rupa-rupa kecemaran atau keserakahan disebut sajapun jangan di antara kamu, sebagaimana sepatutnya bagi orang-orang kudus."
 },
 {
   "id": 29324,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 4,
   "firman": "Demikian juga perkataan yang kotor, yang kosong atau yang sembrono--karena hal-hal ini tidak pantas--tetapi sebaliknya ucapkanlah syukur."
 },
 {
   "id": 29325,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 5,
   "firman": "Karena ingatlah ini baik-baik: tidak ada orang sundal, orang cemar atau orang serakah, artinya penyembah berhala, yang mendapat bagian di dalam Kerajaan Kristus dan Allah."
 },
 {
   "id": 29326,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 6,
   "firman": "Janganlah kamu disesatkan orang dengan kata-kata yang hampa, karena hal-hal yang demikian mendatangkan murka Allah atas orang-orang durhaka."
 },
 {
   "id": 29327,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab itu janganlah kamu berkawan dengan mereka."
 },
 {
   "id": 29328,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 8,
   "firman": "Memang dahulu kamu adalah kegelapan, tetapi sekarang kamu adalah terang di dalam Tuhan. Sebab itu hiduplah sebagai anak-anak terang,"
 },
 {
   "id": 29329,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 9,
   "firman": "karena terang hanya berbuahkan kebaikan dan keadilan dan kebenaran,"
 },
 {
   "id": 29330,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 10,
   "firman": "dan ujilah apa yang berkenan kepada Tuhan."
 },
 {
   "id": 29331,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 11,
   "firman": "Janganlah turut mengambil bagian dalam perbuatan-perbuatan kegelapan yang tidak berbuahkan apa-apa, tetapi sebaliknya telanjangilah perbuatan-perbuatan itu."
 },
 {
   "id": 29332,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab menyebutkan sajapun apa yang dibuat oleh mereka di tempat-tempat yang tersembunyi telah memalukan."
 },
 {
   "id": 29333,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 13,
   "firman": "Tetapi segala sesuatu yang sudah ditelanjangi oleh terang itu menjadi nampak, sebab semua yang nampak adalah terang."
 },
 {
   "id": 29334,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 14,
   "firman": "Itulah sebabnya dikatakan: \"Bangunlah, hai kamu yang tidur dan bangkitlah dari antara orang mati dan Kristus akan bercahaya atas kamu.\""
 },
 {
   "id": 29335,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 15,
   "firman": "Karena itu, perhatikanlah dengan saksama, bagaimana kamu hidup, janganlah seperti orang bebal, tetapi seperti orang arif,"
 },
 {
   "id": 29336,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 16,
   "firman": "dan pergunakanlah waktu yang ada, karena hari-hari ini adalah jahat."
 },
 {
   "id": 29337,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 17,
   "firman": "Sebab itu janganlah kamu bodoh, tetapi usahakanlah supaya kamu mengerti kehendak Tuhan."
 },
 {
   "id": 29338,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 18,
   "firman": "Dan janganlah kamu mabuk oleh anggur, karena anggur menimbulkan hawa nafsu, tetapi hendaklah kamu penuh dengan Roh,"
 },
 {
   "id": 29339,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 19,
   "firman": "dan berkata-katalah seorang kepada yang lain dalam mazmur, kidung puji-pujian dan nyanyian rohani. Bernyanyi dan bersoraklah bagi Tuhan dengan segenap hati."
 },
 {
   "id": 29340,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 20,
   "firman": "Ucaplah syukur senantiasa atas segala sesuatu dalam nama Tuhan kita Yesus Kristus kepada Allah dan Bapa kita"
 },
 {
   "id": 29341,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 21,
   "firman": "dan rendahkanlah dirimu seorang kepada yang lain di dalam takut akan Kristus."
 },
 {
   "id": 29342,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 22,
   "firman": "Hai isteri, tunduklah kepada suamimu seperti kepada Tuhan,"
 },
 {
   "id": 29343,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 23,
   "firman": "karena suami adalah kepala isteri sama seperti Kristus adalah kepala jemaat. Dialah yang menyelamatkan tubuh."
 },
 {
   "id": 29344,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 24,
   "firman": "Karena itu sebagaimana jemaat tunduk kepada Kristus, demikian jugalah isteri kepada suami dalam segala sesuatu."
 },
 {
   "id": 29345,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 25,
   "firman": "Hai suami, kasihilah isterimu sebagaimana Kristus telah mengasihi jemaat dan telah menyerahkan diri-Nya baginya"
 },
 {
   "id": 29346,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 26,
   "firman": "untuk menguduskannya, sesudah Ia menyucikannya dengan memandikannya dengan air dan firman,"
 },
 {
   "id": 29347,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 27,
   "firman": "supaya dengan demikian Ia menempatkan jemaat di hadapan diri-Nya dengan cemerlang tanpa cacat atau kerut atau yang serupa itu, tetapi supaya jemaat kudus dan tidak bercela."
 },
 {
   "id": 29348,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 28,
   "firman": "Demikian juga suami harus mengasihi isterinya sama seperti tubuhnya sendiri: Siapa yang mengasihi isterinya mengasihi dirinya sendiri."
 },
 {
   "id": 29349,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 29,
   "firman": "Sebab tidak pernah orang membenci tubuhnya sendiri, tetapi mengasuhnya dan merawatinya, sama seperti Kristus terhadap jemaat,"
 },
 {
   "id": 29350,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 30,
   "firman": "karena kita adalah anggota tubuh-Nya."
 },
 {
   "id": 29351,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 31,
   "firman": "Sebab itu laki-laki akan meninggalkan ayahnya dan ibunya dan bersatu dengan isterinya, sehingga keduanya itu menjadi satu daging."
 },
 {
   "id": 29352,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 32,
   "firman": "Rahasia ini besar, tetapi yang aku maksudkan ialah hubungan Kristus dan jemaat."
 },
 {
   "id": 29353,
   "kitab": "Efe",
   "pasal": 5,
   "ayat": 33,
   "firman": "Bagaimanapun juga, bagi kamu masing-masing berlaku: kasihilah isterimu seperti dirimu sendiri dan isteri hendaklah menghormati suaminya."
 },
 {
   "id": 29354,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 1,
   "firman": "Hai anak-anak, taatilah orang tuamu di dalam Tuhan, karena haruslah demikian."
 },
 {
   "id": 29355,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 2,
   "firman": "Hormatilah ayahmu dan ibumu--ini adalah suatu perintah yang penting, seperti yang nyata dari janji ini:"
 },
 {
   "id": 29356,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 3,
   "firman": "supaya kamu berbahagia dan panjang umurmu di bumi."
 },
 {
   "id": 29357,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dan kamu, bapa-bapa, janganlah bangkitkan amarah di dalam hati anak-anakmu, tetapi didiklah mereka di dalam ajaran dan nasihat Tuhan."
 },
 {
   "id": 29358,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 5,
   "firman": "Hai hamba-hamba, taatilah tuanmu yang di dunia dengan takut dan gentar, dan dengan tulus hati, sama seperti kamu taat kepada Kristus,"
 },
 {
   "id": 29359,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 6,
   "firman": "jangan hanya di hadapan mereka saja untuk menyenangkan hati orang, tetapi sebagai hamba-hamba Kristus yang dengan segenap hati melakukan kehendak Allah,"
 },
 {
   "id": 29360,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 7,
   "firman": "dan yang dengan rela menjalankan pelayanannya seperti orang-orang yang melayani Tuhan dan bukan manusia."
 },
 {
   "id": 29361,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 8,
   "firman": "Kamu tahu, bahwa setiap orang, baik hamba, maupun orang merdeka, kalau ia telah berbuat sesuatu yang baik, ia akan menerima balasannya dari Tuhan."
 },
 {
   "id": 29362,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dan kamu tuan-tuan, perbuatlah demikian juga terhadap mereka dan jauhkanlah ancaman. Ingatlah, bahwa Tuhan mereka dan Tuhan kamu ada di sorga dan Ia tidak memandang muka."
 },
 {
   "id": 29363,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 10,
   "firman": "Akhirnya, hendaklah kamu kuat di dalam Tuhan, di dalam kekuatan kuasa-Nya."
 },
 {
   "id": 29364,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 11,
   "firman": "Kenakanlah seluruh perlengkapan senjata Allah, supaya kamu dapat bertahan melawan tipu muslihat Iblis;"
 },
 {
   "id": 29365,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 12,
   "firman": "karena perjuangan kita bukanlah melawan darah dan daging, tetapi melawan pemerintah-pemerintah, melawan penguasa-penguasa, melawan penghulu-penghulu dunia yang gelap ini, melawan roh-roh jahat di udara."
 },
 {
   "id": 29366,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 13,
   "firman": "Sebab itu ambillah seluruh perlengkapan senjata Allah, supaya kamu dapat mengadakan perlawanan pada hari yang jahat itu dan tetap berdiri, sesudah kamu menyelesaikan segala sesuatu."
 },
 {
   "id": 29367,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 14,
   "firman": "Jadi berdirilah tegap, berikatpinggangkan kebenaran dan berbajuzirahkan keadilan,"
 },
 {
   "id": 29368,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 15,
   "firman": "kakimu berkasutkan kerelaan untuk memberitakan Injil damai sejahtera;"
 },
 {
   "id": 29369,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 16,
   "firman": "dalam segala keadaan pergunakanlah perisai iman, sebab dengan perisai itu kamu akan dapat memadamkan semua panah api dari si jahat,"
 },
 {
   "id": 29370,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 17,
   "firman": "dan terimalah ketopong keselamatan dan pedang Roh, yaitu firman Allah,"
 },
 {
   "id": 29371,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 18,
   "firman": "dalam segala doa dan permohonan. Berdoalah setiap waktu di dalam Roh dan berjaga-jagalah di dalam doamu itu dengan permohonan yang tak putus-putusnya untuk segala orang Kudus,"
 },
 {
   "id": 29372,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 19,
   "firman": "juga untuk aku, supaya kepadaku, jika aku membuka mulutku, dikaruniakan perkataan yang benar, agar dengan keberanian aku memberitakan rahasia Injil,"
 },
 {
   "id": 29373,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 20,
   "firman": "yang kulayani sebagai utusan yang dipenjarakan. Berdoalah supaya dengan keberanian aku menyatakannya, sebagaimana seharusnya aku berbicara."
 },
 {
   "id": 29374,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 21,
   "firman": "Supaya kamu juga mengetahui keadaan dan hal ihwalku, maka Tikhikus, saudara kita yang kekasih dan pelayan yang setia di dalam Tuhan, akan memberitahukan semuanya kepada kamu."
 },
 {
   "id": 29375,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 22,
   "firman": "Dengan maksud inilah ia kusuruh kepadamu, yaitu supaya kamu tahu hal ihwal kami dan supaya ia menghibur hatimu."
 },
 {
   "id": 29376,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 23,
   "firman": "Damai sejahtera dan kasih dengan iman dari Allah, Bapa dan dari Tuhan Yesus Kristus menyertai sekalian saudara."
 },
 {
   "id": 29377,
   "kitab": "Efe",
   "pasal": 6,
   "ayat": 24,
   "firman": "Kasih karunia menyertai semua orang, yang mengasihi Tuhan kita Yesus Kristus dengan kasih yang tidak binasa."
 },
 {
   "id": 29378,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus dan Timotius, hamba-hamba Kristus Yesus, kepada semua orang kudus dalam Kristus Yesus di Filipi, dengan para penilik jemaat dan diaken."
 },
 {
   "id": 29379,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 29380,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 3,
   "firman": "Aku mengucap syukur kepada Allahku setiap kali aku mengingat kamu."
 },
 {
   "id": 29381,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan setiap kali aku berdoa untuk kamu semua, aku selalu berdoa dengan sukacita."
 },
 {
   "id": 29382,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 5,
   "firman": "Aku mengucap syukur kepada Allahku karena persekutuanmu dalam Berita Injil mulai dari hari pertama sampai sekarang ini."
 },
 {
   "id": 29383,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 6,
   "firman": "Akan hal ini aku yakin sepenuhnya, yaitu Ia, yang memulai pekerjaan yang baik di antara kamu, akan meneruskannya sampai pada akhirnya pada hari Kristus Yesus."
 },
 {
   "id": 29384,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 7,
   "firman": "Memang sudahlah sepatutnya aku berpikir demikian akan kamu semua, sebab kamu ada di dalam hatiku, oleh karena kamu semua turut mendapat bagian dalam kasih karunia yang diberikan kepadaku, baik pada waktu aku dipenjarakan, maupun pada waktu aku membela dan meneguhkan Berita Injil."
 },
 {
   "id": 29385,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sebab Allah adalah saksiku betapa aku dengan kasih mesra Kristus Yesus merindukan kamu sekalian."
 },
 {
   "id": 29386,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 9,
   "firman": "Dan inilah doaku, semoga kasihmu makin melimpah dalam pengetahuan yang benar dan dalam segala macam pengertian,"
 },
 {
   "id": 29387,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 10,
   "firman": "sehingga kamu dapat memilih apa yang baik, supaya kamu suci dan tak bercacat menjelang hari Kristus,"
 },
 {
   "id": 29388,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 11,
   "firman": "penuh dengan buah kebenaran yang dikerjakan oleh Yesus Kristus untuk memuliakan dan memuji Allah."
 },
 {
   "id": 29389,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 12,
   "firman": "Aku menghendaki, saudara-saudara, supaya kamu tahu, bahwa apa yang terjadi atasku ini justru telah menyebabkan kemajuan Injil,"
 },
 {
   "id": 29390,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 13,
   "firman": "sehingga telah jelas bagi seluruh istana dan semua orang lain, bahwa aku dipenjarakan karena Kristus."
 },
 {
   "id": 29391,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 14,
   "firman": "Dan kebanyakan saudara dalam Tuhan telah beroleh kepercayaan karena pemenjaraanku untuk bertambah berani berkata-kata tentang firman Allah dengan tidak takut."
 },
 {
   "id": 29392,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 15,
   "firman": "Ada orang yang memberitakan Kristus karena dengki dan perselisihan, tetapi ada pula yang memberitakan-Nya dengan maksud baik."
 },
 {
   "id": 29393,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 16,
   "firman": "Mereka ini memberitakan Kristus karena kasih, sebab mereka tahu, bahwa aku ada di sini untuk membela Injil,"
 },
 {
   "id": 29394,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 17,
   "firman": "tetapi yang lain karena kepentingan sendiri dan dengan maksud yang tidak ikhlas, sangkanya dengan demikian mereka memperberat bebanku dalam penjara."
 },
 {
   "id": 29395,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 18,
   "firman": "Tetapi tidak mengapa, sebab bagaimanapun juga, Kristus diberitakan, baik dengan maksud palsu maupun dengan jujur. Tentang hal itu aku bersukacita. Dan aku akan tetap bersukacita,"
 },
 {
   "id": 29396,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 19,
   "firman": "karena aku tahu, bahwa kesudahan semuanya ini ialah keselamatanku oleh doamu dan pertolongan Roh Yesus Kristus."
 },
 {
   "id": 29397,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 20,
   "firman": "Sebab yang sangat kurindukan dan kuharapkan ialah bahwa aku dalam segala hal tidak akan beroleh malu, melainkan seperti sediakala, demikianpun sekarang, Kristus dengan nyata dimuliakan di dalam tubuhku, baik oleh hidupku, maupun oleh matiku."
 },
 {
   "id": 29398,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 21,
   "firman": "Karena bagiku hidup adalah Kristus dan mati adalah keuntungan."
 },
 {
   "id": 29399,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tetapi jika aku harus hidup di dunia ini, itu berarti bagiku bekerja memberi buah. Jadi mana yang harus kupilih, aku tidak tahu."
 },
 {
   "id": 29400,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 23,
   "firman": "Aku didesak dari dua pihak: aku ingin pergi dan diam bersama-sama dengan Kristus--itu memang jauh lebih baik;"
 },
 {
   "id": 29401,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 24,
   "firman": "tetapi lebih perlu untuk tinggal di dunia ini karena kamu."
 },
 {
   "id": 29402,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 25,
   "firman": "Dan dalam keyakinan ini tahulah aku: aku akan tinggal dan akan bersama-sama lagi dengan kamu sekalian supaya kamu makin maju dan bersukacita dalam iman,"
 },
 {
   "id": 29403,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 26,
   "firman": "sehingga kemegahanmu dalam Kristus Yesus makin bertambah karena aku, apabila aku kembali kepada kamu."
 },
 {
   "id": 29404,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 27,
   "firman": "Hanya, hendaklah hidupmu berpadanan dengan Injil Kristus, supaya, apabila aku datang aku melihat, dan apabila aku tidak datang aku mendengar, bahwa kamu teguh berdiri dalam satu roh, dan sehati sejiwa berjuang untuk iman yang timbul dari Berita Injil,"
 },
 {
   "id": 29405,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 28,
   "firman": "dengan tiada digentarkan sedikitpun oleh lawanmu. Bagi mereka semuanya itu adalah tanda kebinasaan, tetapi bagi kamu tanda keselamatan, dan itu datangnya dari Allah."
 },
 {
   "id": 29406,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 29,
   "firman": "Sebab kepada kamu dikaruniakan bukan saja untuk percaya kepada Kristus, melainkan juga untuk menderita untuk Dia,"
 },
 {
   "id": 29407,
   "kitab": "Flp",
   "pasal": 1,
   "ayat": 30,
   "firman": "dalam pergumulan yang sama seperti yang dahulu kamu lihat padaku, dan yang sekarang kamu dengar tentang aku."
 },
 {
   "id": 29408,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 1,
   "firman": "Jadi karena dalam Kristus ada nasihat, ada penghiburan kasih, ada persekutuan Roh, ada kasih mesra dan belas kasihan,"
 },
 {
   "id": 29409,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 2,
   "firman": "karena itu sempurnakanlah sukacitaku dengan ini: hendaklah kamu sehati sepikir, dalam satu kasih, satu jiwa, satu tujuan,"
 },
 {
   "id": 29410,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 3,
   "firman": "dengan tidak mencari kepentingan sendiri atau puji-pujian yang sia-sia. Sebaliknya hendaklah dengan rendah hati yang seorang menganggap yang lain lebih utama dari pada dirinya sendiri;"
 },
 {
   "id": 29411,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 4,
   "firman": "dan janganlah tiap-tiap orang hanya memperhatikan kepentingannya sendiri, tetapi kepentingan orang lain juga."
 },
 {
   "id": 29412,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 5,
   "firman": "Hendaklah kamu dalam hidupmu bersama, menaruh pikiran dan perasaan yang terdapat juga dalam Kristus Yesus,"
 },
 {
   "id": 29413,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 6,
   "firman": "yang walaupun dalam rupa Allah, tidak menganggap kesetaraan dengan Allah itu sebagai milik yang harus dipertahankan,"
 },
 {
   "id": 29414,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 7,
   "firman": "melainkan telah mengosongkan diri-Nya sendiri, dan mengambil rupa seorang hamba, dan menjadi sama dengan manusia."
 },
 {
   "id": 29415,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 8,
   "firman": "Dan dalam keadaan sebagai manusia, Ia telah merendahkan diri-Nya dan taat sampai mati, bahkan sampai mati di kayu salib."
 },
 {
   "id": 29416,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 9,
   "firman": "Itulah sebabnya Allah sangat meninggikan Dia dan mengaruniakan kepada-Nya nama di atas segala nama,"
 },
 {
   "id": 29417,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 10,
   "firman": "supaya dalam nama Yesus bertekuk lutut segala yang ada di langit dan yang ada di atas bumi dan yang ada di bawah bumi,"
 },
 {
   "id": 29418,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 11,
   "firman": "dan segala lidah mengaku: \"Yesus Kristus adalah Tuhan,\" bagi kemuliaan Allah, Bapa!"
 },
 {
   "id": 29419,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 12,
   "firman": "Hai saudara-saudaraku yang kekasih, kamu senantiasa taat; karena itu tetaplah kerjakan keselamatanmu dengan takut dan gentar, bukan saja seperti waktu aku masih hadir, tetapi terlebih pula sekarang waktu aku tidak hadir,"
 },
 {
   "id": 29420,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 13,
   "firman": "karena Allahlah yang mengerjakan di dalam kamu baik kemauan maupun pekerjaan menurut kerelaan-Nya."
 },
 {
   "id": 29421,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lakukanlah segala sesuatu dengan tidak bersungut-sungut dan berbantah-bantahan,"
 },
 {
   "id": 29422,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 15,
   "firman": "supaya kamu tiada beraib dan tiada bernoda, sebagai anak-anak Allah yang tidak bercela di tengah-tengah angkatan yang bengkok hatinya dan yang sesat ini, sehingga kamu bercahaya di antara mereka seperti bintang-bintang di dunia,"
 },
 {
   "id": 29423,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 16,
   "firman": "sambil berpegang pada firman kehidupan, agar aku dapat bermegah pada hari Kristus, bahwa aku tidak percuma berlomba dan tidak percuma bersusah-susah."
 },
 {
   "id": 29424,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi sekalipun darahku dicurahkan pada korban dan ibadah imanmu, aku bersukacita dan aku bersukacita dengan kamu sekalian."
 },
 {
   "id": 29425,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 18,
   "firman": "Dan kamu juga harus bersukacita demikian dan bersukacitalah dengan aku."
 },
 {
   "id": 29426,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 19,
   "firman": "Tetapi dalam Tuhan Yesus kuharap segera mengirimkan Timotius kepadamu, supaya tenang juga hatiku oleh kabar tentang hal ihwalmu."
 },
 {
   "id": 29427,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 20,
   "firman": "Karena tak ada seorang padaku, yang sehati dan sepikir dengan dia dan yang begitu bersungguh-sungguh memperhatikan kepentinganmu;"
 },
 {
   "id": 29428,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 21,
   "firman": "sebab semuanya mencari kepentingannya sendiri, bukan kepentingan Kristus Yesus."
 },
 {
   "id": 29429,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 22,
   "firman": "Kamu tahu bahwa kesetiaannya telah teruji dan bahwa ia telah menolong aku dalam pelayanan Injil sama seperti seorang anak menolong bapanya."
 },
 {
   "id": 29430,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 23,
   "firman": "Dialah yang kuharap untuk kukirimkan dengan segera, sesudah jelas bagiku bagaimana jalannya perkaraku;"
 },
 {
   "id": 29431,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 24,
   "firman": "tetapi dalam Tuhan aku percaya, bahwa aku sendiripun akan segera datang."
 },
 {
   "id": 29432,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 25,
   "firman": "Sementara itu kuanggap perlu mengirimkan Epafroditus kepadamu, yaitu saudaraku dan teman sekerja serta teman seperjuanganku, yang kamu utus untuk melayani aku dalam keperluanku."
 },
 {
   "id": 29433,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 26,
   "firman": "Karena ia sangat rindu kepada kamu sekalian dan susah juga hatinya, sebab kamu mendengar bahwa ia sakit."
 },
 {
   "id": 29434,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 27,
   "firman": "Memang benar ia sakit dan nyaris mati, tetapi Allah mengasihani dia, dan bukan hanya dia saja, melainkan aku juga, supaya dukacitaku jangan bertambah-tambah."
 },
 {
   "id": 29435,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 28,
   "firman": "Itulah sebabnya aku lebih cepat mengirimkan dia, supaya bila kamu melihat dia, kamu dapat bersukacita pula dan berkurang dukacitaku."
 },
 {
   "id": 29436,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 29,
   "firman": "Jadi sambutlah dia dalam Tuhan dengan segala sukacita dan hormatilah orang-orang seperti dia."
 },
 {
   "id": 29437,
   "kitab": "Flp",
   "pasal": 2,
   "ayat": 30,
   "firman": "Sebab oleh karena pekerjaan Kristus ia nyaris mati dan ia mempertaruhkan jiwanya untuk memenuhi apa yang masih kurang dalam pelayananmu kepadaku."
 },
 {
   "id": 29438,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 1,
   "firman": "Akhirnya, saudara-saudaraku, bersukacitalah dalam Tuhan."
 },
 {
   "id": 29440,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 2,
   "firman": "Hati-hatilah terhadap anjing-anjing, hati-hatilah terhadap pekerja-pekerja yang jahat, hati-hatilah terhadap penyunat-penyunat yang palsu,"
 },
 {
   "id": 29441,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 3,
   "firman": "karena kitalah orang-orang bersunat, yang beribadah oleh Roh Allah, dan bermegah dalam Kristus Yesus dan tidak menaruh percaya pada hal-hal lahiriah."
 },
 {
   "id": 29442,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sekalipun aku juga ada alasan untuk menaruh percaya pada hal-hal lahiriah. Jika ada orang lain menyangka dapat menaruh percaya pada hal-hal lahiriah, aku lebih lagi:"
 },
 {
   "id": 29443,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 5,
   "firman": "disunat pada hari kedelapan, dari bangsa Israel, dari suku Benyamin, orang Ibrani asli, tentang pendirian terhadap hukum Taurat aku orang Farisi,"
 },
 {
   "id": 29444,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 6,
   "firman": "tentang kegiatan aku penganiaya jemaat, tentang kebenaran dalam mentaati hukum Taurat aku tidak bercacat."
 },
 {
   "id": 29445,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 7,
   "firman": "Tetapi apa yang dahulu merupakan keuntungan bagiku, sekarang kuanggap rugi karena Kristus."
 },
 {
   "id": 29446,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 8,
   "firman": "Malahan segala sesuatu kuanggap rugi, karena pengenalan akan Kristus Yesus, Tuhanku, lebih mulia dari pada semuanya. Oleh karena Dialah aku telah melepaskan semuanya itu dan menganggapnya sampah, supaya aku memperoleh Kristus,"
 },
 {
   "id": 29447,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 9,
   "firman": "dan berada dalam Dia bukan dengan kebenaranku sendiri karena mentaati hukum Taurat, melainkan dengan kebenaran karena kepercayaan kepada Kristus, yaitu kebenaran yang Allah anugerahkan berdasarkan kepercayaan."
 },
 {
   "id": 29448,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 10,
   "firman": "Yang kukehendaki ialah mengenal Dia dan kuasa kebangkitan-Nya dan persekutuan dalam penderitaan-Nya, di mana aku menjadi serupa dengan Dia dalam kematian-Nya,"
 },
 {
   "id": 29449,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 11,
   "firman": "supaya aku akhirnya beroleh kebangkitan dari antara orang mati."
 },
 {
   "id": 29450,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 12,
   "firman": "Bukan seolah-olah aku telah memperoleh hal ini atau telah sempurna, melainkan aku mengejarnya, kalau-kalau aku dapat juga menangkapnya, karena akupun telah ditangkap oleh Kristus Yesus."
 },
 {
   "id": 29451,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 13,
   "firman": "Saudara-saudara, aku sendiri tidak menganggap, bahwa aku telah menangkapnya, tetapi ini yang kulakukan: aku melupakan apa yang telah di belakangku dan mengarahkan diri kepada apa yang di hadapanku,"
 },
 {
   "id": 29452,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 14,
   "firman": "dan berlari-lari kepada tujuan untuk memperoleh hadiah, yaitu panggilan sorgawi dari Allah dalam Kristus Yesus."
 },
 {
   "id": 29453,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 15,
   "firman": "Karena itu marilah kita, yang sempurna, berpikir demikian. Dan jikalau lain pikiranmu tentang salah satu hal, hal itu akan dinyatakan Allah juga kepadamu."
 },
 {
   "id": 29454,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 16,
   "firman": "Tetapi baiklah tingkat pengertian yang telah kita capai kita lanjutkan menurut jalan yang telah kita tempuh."
 },
 {
   "id": 29455,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 17,
   "firman": "Saudara-saudara, ikutilah teladanku dan perhatikanlah mereka, yang hidup sama seperti kami yang menjadi teladanmu."
 },
 {
   "id": 29456,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 18,
   "firman": "Karena, seperti yang telah kerap kali kukatakan kepadamu, dan yang kunyatakan pula sekarang sambil menangis, banyak orang yang hidup sebagai seteru salib Kristus."
 },
 {
   "id": 29457,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 19,
   "firman": "Kesudahan mereka ialah kebinasaan, Tuhan mereka ialah perut mereka, kemuliaan mereka ialah aib mereka, pikiran mereka semata-mata tertuju kepada perkara duniawi."
 },
 {
   "id": 29458,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 20,
   "firman": "Karena kewargaan kita adalah di dalam sorga, dan dari situ juga kita menantikan Tuhan Yesus Kristus sebagai Juruselamat,"
 },
 {
   "id": 29459,
   "kitab": "Flp",
   "pasal": 3,
   "ayat": 21,
   "firman": "yang akan mengubah tubuh kita yang hina ini, sehingga serupa dengan tubuh-Nya yang mulia, menurut kuasa-Nya yang dapat menaklukkan segala sesuatu kepada diri-Nya."
 },
 {
   "id": 29460,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 1,
   "firman": "Karena itu, saudara-saudara yang kukasihi dan yang kurindukan, sukacitaku dan mahkotaku, berdirilah juga dengan teguh dalam Tuhan, hai saudara-saudaraku yang kekasih!"
 },
 {
   "id": 29461,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 2,
   "firman": "Euodia kunasihati dan Sintikhe kunasihati, supaya sehati sepikir dalam Tuhan."
 },
 {
   "id": 29462,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 3,
   "firman": "Bahkan, kuminta kepadamu juga, Sunsugos, temanku yang setia: tolonglah mereka. Karena mereka telah berjuang dengan aku dalam pekabaran Injil, bersama-sama dengan Klemens dan kawan-kawanku sekerja yang lain, yang nama-namanya tercantum dalam kitab kehidupan."
 },
 {
   "id": 29463,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 4,
   "firman": "Bersukacitalah senantiasa dalam Tuhan! Sekali lagi kukatakan: Bersukacitalah!"
 },
 {
   "id": 29464,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 5,
   "firman": "Hendaklah kebaikan hatimu diketahui semua orang. Tuhan sudah dekat!"
 },
 {
   "id": 29465,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 6,
   "firman": "Janganlah hendaknya kamu kuatir tentang apapun juga, tetapi nyatakanlah dalam segala hal keinginanmu kepada Allah dalam doa dan permohonan dengan ucapan syukur."
 },
 {
   "id": 29466,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 7,
   "firman": "Damai sejahtera Allah, yang melampaui segala akal, akan memelihara hati dan pikiranmu dalam Kristus Yesus."
 },
 {
   "id": 29467,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 8,
   "firman": "Jadi akhirnya, saudara-saudara, semua yang benar, semua yang mulia, semua yang adil, semua yang suci, semua yang manis, semua yang sedap didengar, semua yang disebut kebajikan dan patut dipuji, pikirkanlah semuanya itu."
 },
 {
   "id": 29468,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 9,
   "firman": "Dan apa yang telah kamu pelajari dan apa yang telah kamu terima, dan apa yang telah kamu dengar dan apa yang telah kamu lihat padaku, lakukanlah itu. Maka Allah sumber damai sejahtera akan menyertai kamu."
 },
 {
   "id": 29469,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 10,
   "firman": "Aku sangat bersukacita dalam Tuhan, bahwa akhirnya pikiranmu dan perasaanmu bertumbuh kembali untuk aku. Memang selalu ada perhatianmu, tetapi tidak ada kesempatan bagimu."
 },
 {
   "id": 29470,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 11,
   "firman": "Kukatakan ini bukanlah karena kekurangan, sebab aku telah belajar mencukupkan diri dalam segala keadaan."
 },
 {
   "id": 29471,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 12,
   "firman": "Aku tahu apa itu kekurangan dan aku tahu apa itu kelimpahan. Dalam segala hal dan dalam segala perkara tidak ada sesuatu yang merupakan rahasia bagiku; baik dalam hal kenyang, maupun dalam hal kelaparan, baik dalam hal kelimpahan maupun dalam hal kekurangan."
 },
 {
   "id": 29472,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 13,
   "firman": "Segala perkara dapat kutanggung di dalam Dia yang memberi kekuatan kepadaku."
 },
 {
   "id": 29473,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 14,
   "firman": "Namun baik juga perbuatanmu, bahwa kamu telah mengambil bagian dalam kesusahanku."
 },
 {
   "id": 29474,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 15,
   "firman": "Kamu sendiri tahu juga, hai orang-orang Filipi; pada waktu aku baru mulai mengabarkan Injil, ketika aku berangkat dari Makedonia, tidak ada satu jemaatpun yang mengadakan perhitungan hutang dan piutang dengan aku selain dari pada kamu."
 },
 {
   "id": 29475,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 16,
   "firman": "Karena di Tesalonikapun kamu telah satu dua kali mengirimkan bantuan kepadaku."
 },
 {
   "id": 29476,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 17,
   "firman": "Tetapi yang kuutamakan bukanlah pemberian itu, melainkan buahnya, yang makin memperbesar keuntunganmu."
 },
 {
   "id": 29477,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 18,
   "firman": "Kini aku telah menerima semua yang perlu dari padamu, malahan lebih dari pada itu. Aku berkelimpahan, karena aku telah menerima kirimanmu dari Epafroditus, suatu persembahan yang harum, suatu korban yang disukai dan yang berkenan kepada Allah."
 },
 {
   "id": 29478,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 19,
   "firman": "Allahku akan memenuhi segala keperluanmu menurut kekayaan dan kemuliaan-Nya dalam Kristus Yesus."
 },
 {
   "id": 29479,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 20,
   "firman": "Dimuliakanlah Allah dan Bapa kita selama-lamanya! Amin."
 },
 {
   "id": 29480,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 21,
   "firman": "Sampaikanlah salamku kepada tiap-tiap orang kudus dalam Kristus Yesus. Salam kepadamu dari saudara-saudara, yang bersama-sama dengan aku."
 },
 {
   "id": 29481,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 22,
   "firman": "Salam kepadamu dari segala orang kudus, khususnya dari mereka yang di istana Kaisar."
 },
 {
   "id": 29482,
   "kitab": "Flp",
   "pasal": 4,
   "ayat": 23,
   "firman": "Kasih karunia Tuhan Yesus Kristus menyertai rohmu!"
 },
 {
   "id": 29483,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, rasul Kristus Yesus, oleh kehendak Allah, dan Timotius saudara kita,"
 },
 {
   "id": 29484,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 2,
   "firman": "kepada saudara-saudara yang kudus dan yang percaya dalam Kristus di Kolose. Kasih karunia dan damai sejahtera dari Allah, Bapa kita, menyertai kamu."
 },
 {
   "id": 29485,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kami selalu mengucap syukur kepada Allah, Bapa Tuhan kita Yesus Kristus, setiap kali kami berdoa untuk kamu,"
 },
 {
   "id": 29486,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 4,
   "firman": "karena kami telah mendengar tentang imanmu dalam Kristus Yesus dan tentang kasihmu terhadap semua orang kudus,"
 },
 {
   "id": 29487,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 5,
   "firman": "oleh karena pengharapan, yang disediakan bagi kamu di sorga. Tentang pengharapan itu telah lebih dahulu kamu dengar dalam firman kebenaran, yaitu Injil,"
 },
 {
   "id": 29488,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 6,
   "firman": "yang sudah sampai kepada kamu. Injil itu berbuah dan berkembang di seluruh dunia, demikian juga di antara kamu sejak waktu kamu mendengarnya dan mengenal kasih karunia Allah dengan sebenarnya."
 },
 {
   "id": 29489,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 7,
   "firman": "Semuanya itu telah kamu ketahui dari Epafras, kawan pelayan yang kami kasihi, yang bagi kamu adalah pelayan Kristus yang setia."
 },
 {
   "id": 29490,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 8,
   "firman": "Dialah juga yang telah menyatakan kepada kami kasihmu dalam Roh."
 },
 {
   "id": 29491,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sebab itu sejak waktu kami mendengarnya, kami tiada berhenti-henti berdoa untuk kamu. Kami meminta, supaya kamu menerima segala hikmat dan pengertian yang benar, untuk mengetahui kehendak Tuhan dengan sempurna,"
 },
 {
   "id": 29492,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 10,
   "firman": "sehingga hidupmu layak di hadapan-Nya serta berkenan kepada-Nya dalam segala hal, dan kamu memberi buah dalam segala pekerjaan yang baik dan bertumbuh dalam pengetahuan yang benar tentang Allah,"
 },
 {
   "id": 29493,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 11,
   "firman": "dan dikuatkan dengan segala kekuatan oleh kuasa kemuliaan-Nya untuk menanggung segala sesuatu dengan tekun dan sabar,"
 },
 {
   "id": 29494,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 12,
   "firman": "dan mengucap syukur dengan sukacita kepada Bapa, yang melayakkan kamu untuk mendapat bagian dalam apa yang ditentukan untuk orang-orang kudus di dalam kerajaan terang."
 },
 {
   "id": 29495,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 13,
   "firman": "Ia telah melepaskan kita dari kuasa kegelapan dan memindahkan kita ke dalam Kerajaan Anak-Nya yang kekasih;"
 },
 {
   "id": 29496,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 14,
   "firman": "di dalam Dia kita memiliki penebusan kita, yaitu pengampunan dosa."
 },
 {
   "id": 29497,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 15,
   "firman": "Ia adalah gambar Allah yang tidak kelihatan, yang sulung, lebih utama dari segala yang diciptakan,"
 },
 {
   "id": 29498,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 16,
   "firman": "karena di dalam Dialah telah diciptakan segala sesuatu, yang ada di sorga dan yang ada di bumi, yang kelihatan dan yang tidak kelihatan, baik singgasana, maupun kerajaan, baik pemerintah, maupun penguasa; segala sesuatu diciptakan oleh Dia dan untuk Dia."
 },
 {
   "id": 29499,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 17,
   "firman": "Ia ada terlebih dahulu dari segala sesuatu dan segala sesuatu ada di dalam Dia."
 },
 {
   "id": 29500,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 18,
   "firman": "Ialah kepala tubuh, yaitu jemaat. Ialah yang sulung, yang pertama bangkit dari antara orang mati, sehingga Ia yang lebih utama dalam segala sesuatu."
 },
 {
   "id": 29501,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena seluruh kepenuhan Allah berkenan diam di dalam Dia,"
 },
 {
   "id": 29502,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 20,
   "firman": "dan oleh Dialah Ia memperdamaikan segala sesuatu dengan diri-Nya, baik yang ada di bumi, maupun yang ada di sorga, sesudah Ia mengadakan pendamaian oleh darah salib Kristus."
 },
 {
   "id": 29503,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 21,
   "firman": "Juga kamu yang dahulu hidup jauh dari Allah dan yang memusuhi-Nya dalam hati dan pikiran seperti yang nyata dari perbuatanmu yang jahat,"
 },
 {
   "id": 29504,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 22,
   "firman": "sekarang diperdamaikan-Nya, di dalam tubuh jasmani Kristus oleh kematian-Nya, untuk menempatkan kamu kudus dan tak bercela dan tak bercacat di hadapan-Nya."
 },
 {
   "id": 29505,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 23,
   "firman": "Sebab itu kamu harus bertekun dalam iman, tetap teguh dan tidak bergoncang, dan jangan mau digeser dari pengharapan Injil, yang telah kamu dengar dan yang telah dikabarkan di seluruh alam di bawah langit, dan yang aku ini, Paulus, telah menjadi pelayannya."
 },
 {
   "id": 29506,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 24,
   "firman": "Sekarang aku bersukacita bahwa aku boleh menderita karena kamu, dan menggenapkan dalam dagingku apa yang kurang pada penderitaan Kristus, untuk tubuh-Nya, yaitu jemaat."
 },
 {
   "id": 29507,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 25,
   "firman": "Aku telah menjadi pelayan jemaat itu sesuai dengan tugas yang dipercayakan Allah kepadaku untuk meneruskan firman-Nya dengan sepenuhnya kepada kamu,"
 },
 {
   "id": 29508,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 26,
   "firman": "yaitu rahasia yang tersembunyi dari abad ke abad dan dari turunan ke turunan, tetapi yang sekarang dinyatakan kepada orang-orang kudus-Nya."
 },
 {
   "id": 29509,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 27,
   "firman": "Kepada mereka Allah mau memberitahukan, betapa kaya dan mulianya rahasia itu di antara bangsa-bangsa lain, yaitu: Kristus ada di tengah-tengah kamu, Kristus yang adalah pengharapan akan kemuliaan!"
 },
 {
   "id": 29510,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 28,
   "firman": "Dialah yang kami beritakan, apabila tiap-tiap orang kami nasihati dan tiap-tiap orang kami ajari dalam segala hikmat, untuk memimpin tiap-tiap orang kepada kesempurnaan dalam Kristus."
 },
 {
   "id": 29511,
   "kitab": "Kol",
   "pasal": 1,
   "ayat": 29,
   "firman": "Itulah yang kuusahakan dan kupergumulkan dengan segala tenaga sesuai dengan kuasa-Nya, yang bekerja dengan kuat di dalam aku."
 },
 {
   "id": 29512,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 1,
   "firman": "Karena aku mau, supaya kamu tahu, betapa beratnya perjuangan yang kulakukan untuk kamu, dan untuk mereka yang di Laodikia dan untuk semuanya, yang belum mengenal aku pribadi,"
 },
 {
   "id": 29513,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 2,
   "firman": "supaya hati mereka terhibur dan mereka bersatu dalam kasih, sehingga mereka memperoleh segala kekayaan dan keyakinan pengertian, dan mengenal rahasia Allah, yaitu Kristus,"
 },
 {
   "id": 29514,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 3,
   "firman": "sebab di dalam Dialah tersembunyi segala harta hikmat dan pengetahuan."
 },
 {
   "id": 29515,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 4,
   "firman": "Hal ini kukatakan, supaya jangan ada yang memperdayakan kamu dengan kata-kata yang indah."
 },
 {
   "id": 29516,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 5,
   "firman": "Sebab meskipun aku sendiri tidak ada di antara kamu, tetapi dalam roh aku bersama-sama dengan kamu dan aku melihat dengan sukacita tertib hidupmu dan keteguhan imanmu dalam Kristus."
 },
 {
   "id": 29517,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 6,
   "firman": "Kamu telah menerima Kristus Yesus, Tuhan kita. Karena itu hendaklah hidupmu tetap di dalam Dia."
 },
 {
   "id": 29518,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 7,
   "firman": "Hendaklah kamu berakar di dalam Dia dan dibangun di atas Dia, hendaklah kamu bertambah teguh dalam iman yang telah diajarkan kepadamu, dan hendaklah hatimu melimpah dengan syukur."
 },
 {
   "id": 29519,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 8,
   "firman": "Hati-hatilah, supaya jangan ada yang menawan kamu dengan filsafatnya yang kosong dan palsu menurut ajaran turun-temurun dan roh-roh dunia, tetapi tidak menurut Kristus."
 },
 {
   "id": 29520,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sebab dalam Dialah berdiam secara jasmaniah seluruh kepenuhan ke-Allahan,"
 },
 {
   "id": 29521,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 10,
   "firman": "dan kamu telah dipenuhi di dalam Dia. Dialah kepala semua pemerintah dan penguasa."
 },
 {
   "id": 29522,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dalam Dia kamu telah disunat, bukan dengan sunat yang dilakukan oleh manusia, tetapi dengan sunat Kristus, yang terdiri dari penanggalan akan tubuh yang berdosa,"
 },
 {
   "id": 29523,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 12,
   "firman": "karena dengan Dia kamu dikuburkan dalam baptisan, dan di dalam Dia kamu turut dibangkitkan juga oleh kepercayaanmu kepada kerja kuasa Allah, yang telah membangkitkan Dia dari orang mati."
 },
 {
   "id": 29524,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 13,
   "firman": "Kamu juga, meskipun dahulu mati oleh pelanggaranmu dan oleh karena tidak disunat secara lahiriah, telah dihidupkan Allah bersama-sama dengan Dia, sesudah Ia mengampuni segala pelanggaran kita,"
 },
 {
   "id": 29525,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 14,
   "firman": "dengan menghapuskan surat hutang, yang oleh ketentuan-ketentuan hukum mendakwa dan mengancam kita. Dan itu ditiadakan-Nya dengan memakukannya pada kayu salib:"
 },
 {
   "id": 29526,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ia telah melucuti pemerintah-pemerintah dan penguasa-penguasa dan menjadikan mereka tontonan umum dalam kemenangan-Nya atas mereka."
 },
 {
   "id": 29527,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 16,
   "firman": "Karena itu janganlah kamu biarkan orang menghukum kamu mengenai makanan dan minuman atau mengenai hari raya, bulan baru ataupun hari Sabat;"
 },
 {
   "id": 29528,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 17,
   "firman": "semuanya ini hanyalah bayangan dari apa yang harus datang, sedang wujudnya ialah Kristus."
 },
 {
   "id": 29529,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 18,
   "firman": "Janganlah kamu biarkan kemenanganmu digagalkan oleh orang yang pura-pura merendahkan diri dan beribadah kepada malaikat, serta berkanjang pada penglihatan-penglihatan dan tanpa alasan membesar-besarkan diri oleh pikirannya yang duniawi,"
 },
 {
   "id": 29530,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 19,
   "firman": "sedang ia tidak berpegang teguh kepada Kepala, dari mana seluruh tubuh, yang ditunjang dan diikat menjadi satu oleh urat-urat dan sendi-sendi, menerima pertumbuhan ilahinya."
 },
 {
   "id": 29531,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 20,
   "firman": "Apabila kamu telah mati bersama-sama dengan Kristus dan bebas dari roh-roh dunia, mengapakah kamu menaklukkan dirimu pada rupa-rupa peraturan, seolah-olah kamu masih hidup di dunia:"
 },
 {
   "id": 29532,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 21,
   "firman": "jangan jamah ini, jangan kecap itu, jangan sentuh ini;"
 },
 {
   "id": 29533,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 22,
   "firman": "semuanya itu hanya mengenai barang yang binasa oleh pemakaian dan hanya menurut perintah-perintah dan ajaran-ajaran manusia."
 },
 {
   "id": 29534,
   "kitab": "Kol",
   "pasal": 2,
   "ayat": 23,
   "firman": "Peraturan-peraturan ini, walaupun nampaknya penuh hikmat dengan ibadah buatan sendiri, seperti merendahkan diri, menyiksa diri, tidak ada gunanya selain untuk memuaskan hidup duniawi."
 },
 {
   "id": 29535,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 1,
   "firman": "Karena itu, kalau kamu dibangkitkan bersama dengan Kristus, carilah perkara yang di atas, di mana Kristus ada, duduk di sebelah kanan Allah."
 },
 {
   "id": 29536,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 2,
   "firman": "Pikirkanlah perkara yang di atas, bukan yang di bumi."
 },
 {
   "id": 29537,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 3,
   "firman": "Sebab kamu telah mati dan hidupmu tersembunyi bersama dengan Kristus di dalam Allah."
 },
 {
   "id": 29538,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 4,
   "firman": "Apabila Kristus, yang adalah hidup kita, menyatakan diri kelak, kamupun akan menyatakan diri bersama dengan Dia dalam kemuliaan."
 },
 {
   "id": 29539,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 5,
   "firman": "Karena itu matikanlah dalam dirimu segala sesuatu yang duniawi, yaitu percabulan, kenajisan, hawa nafsu, nafsu jahat dan juga keserakahan, yang sama dengan penyembahan berhala,"
 },
 {
   "id": 29540,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 6,
   "firman": "semuanya itu mendatangkan murka Allah (atas orang-orang durhaka)."
 },
 {
   "id": 29541,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 7,
   "firman": "Dahulu kamu juga melakukan hal-hal itu ketika kamu hidup di dalamnya."
 },
 {
   "id": 29542,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 8,
   "firman": "Tetapi sekarang, buanglah semuanya ini, yaitu marah, geram, kejahatan, fitnah dan kata-kata kotor yang keluar dari mulutmu."
 },
 {
   "id": 29543,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 9,
   "firman": "Jangan lagi kamu saling mendustai, karena kamu telah menanggalkan manusia lama serta kelakuannya,"
 },
 {
   "id": 29544,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 10,
   "firman": "dan telah mengenakan manusia baru yang terus-menerus diperbaharui untuk memperoleh pengetahuan yang benar menurut gambar Khaliknya;"
 },
 {
   "id": 29545,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 11,
   "firman": "dalam hal ini tiada lagi orang Yunani atau orang Yahudi, orang bersunat atau orang tak bersunat, orang Barbar atau orang Skit, budak atau orang merdeka, tetapi Kristus adalah semua dan di dalam segala sesuatu."
 },
 {
   "id": 29546,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 12,
   "firman": "Karena itu, sebagai orang-orang pilihan Allah yang dikuduskan dan dikasihi-Nya, kenakanlah belas kasihan, kemurahan, kerendahan hati, kelemahlembutan dan kesabaran."
 },
 {
   "id": 29547,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 13,
   "firman": "Sabarlah kamu seorang terhadap yang lain, dan ampunilah seorang akan yang lain apabila yang seorang menaruh dendam terhadap yang lain, sama seperti Tuhan telah mengampuni kamu, kamu perbuat jugalah demikian."
 },
 {
   "id": 29548,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan di atas semuanya itu: kenakanlah kasih, sebagai pengikat yang mempersatukan dan menyempurnakan."
 },
 {
   "id": 29549,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 15,
   "firman": "Hendaklah damai sejahtera Kristus memerintah dalam hatimu, karena untuk itulah kamu telah dipanggil menjadi satu tubuh. Dan bersyukurlah."
 },
 {
   "id": 29550,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 16,
   "firman": "Hendaklah perkataan Kristus diam dengan segala kekayaannya di antara kamu, sehingga kamu dengan segala hikmat mengajar dan menegur seorang akan yang lain dan sambil menyanyikan mazmur, dan puji-pujian dan nyanyian rohani, kamu mengucap syukur kepada Allah di dalam hatimu."
 },
 {
   "id": 29551,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 17,
   "firman": "Dan segala sesuatu yang kamu lakukan dengan perkataan atau perbuatan, lakukanlah semuanya itu dalam nama Tuhan Yesus, sambil mengucap syukur oleh Dia kepada Allah, Bapa kita."
 },
 {
   "id": 29552,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 18,
   "firman": "Hai isteri-isteri, tunduklah kepada suamimu, sebagaimana seharusnya di dalam Tuhan."
 },
 {
   "id": 29553,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 19,
   "firman": "Hai suami-suami, kasihilah isterimu dan janganlah berlaku kasar terhadap dia."
 },
 {
   "id": 29554,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 20,
   "firman": "Hai anak-anak, taatilah orang tuamu dalam segala hal, karena itulah yang indah di dalam Tuhan."
 },
 {
   "id": 29555,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 21,
   "firman": "Hai bapa-bapa, janganlah sakiti hati anakmu, supaya jangan tawar hatinya."
 },
 {
   "id": 29556,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 22,
   "firman": "Hai hamba-hamba, taatilah tuanmu yang di dunia ini dalam segala hal, jangan hanya di hadapan mereka saja untuk menyenangkan mereka, melainkan dengan tulus hati karena takut akan Tuhan."
 },
 {
   "id": 29557,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 23,
   "firman": "Apapun juga yang kamu perbuat, perbuatlah dengan segenap hatimu seperti untuk Tuhan dan bukan untuk manusia."
 },
 {
   "id": 29558,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 24,
   "firman": "Kamu tahu, bahwa dari Tuhanlah kamu akan menerima bagian yang ditentukan bagimu sebagai upah. Kristus adalah tuan dan kamu hamba-Nya."
 },
 {
   "id": 29559,
   "kitab": "Kol",
   "pasal": 3,
   "ayat": 25,
   "firman": "Barangsiapa berbuat kesalahan, ia akan menanggung kesalahannya itu, karena Tuhan tidak memandang orang."
 },
 {
   "id": 29560,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 1,
   "firman": "Hai tuan-tuan, berlakulah adil dan jujur terhadap hambamu; ingatlah, kamu juga mempunyai tuan di sorga."
 },
 {
   "id": 29561,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 2,
   "firman": "Bertekunlah dalam doa dan dalam pada itu berjaga-jagalah sambil mengucap syukur."
 },
 {
   "id": 29562,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 3,
   "firman": "Berdoa jugalah untuk kami, supaya Allah membuka pintu untuk pemberitaan kami, sehingga kami dapat berbicara tentang rahasia Kristus, yang karenanya aku dipenjarakan."
 },
 {
   "id": 29563,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 4,
   "firman": "Dengan demikian aku dapat menyatakannya, sebagaimana seharusnya."
 },
 {
   "id": 29564,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 5,
   "firman": "Hiduplah dengan penuh hikmat terhadap orang-orang luar, pergunakanlah waktu yang ada."
 },
 {
   "id": 29565,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 6,
   "firman": "Hendaklah kata-katamu senantiasa penuh kasih, jangan hambar, sehingga kamu tahu, bagaimana kamu harus memberi jawab kepada setiap orang."
 },
 {
   "id": 29566,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 7,
   "firman": "Semua hal ihwalku akan diberitahukan kepada kamu oleh Tikhikus, saudara kita yang kekasih, hamba yang setia dan kawan pelayan dalam Tuhan."
 },
 {
   "id": 29567,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 8,
   "firman": "Ia kusuruh kepadamu dengan maksud, supaya kamu tahu akan hal ihwal kami dan supaya ia menghibur hatimu."
 },
 {
   "id": 29568,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 9,
   "firman": "Ia kusuruh bersama-sama dengan Onesimus, saudara kita yang setia dan yang kekasih, seorang dari antaramu. Mereka akan memberitahukan kepadamu segala sesuatu yang terjadi di sini."
 },
 {
   "id": 29569,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 10,
   "firman": "Salam kepada kamu dari Aristarkhus, temanku sepenjara dan dari Markus, kemenakan Barnabas--tentang dia kamu telah menerima pesan; terimalah dia, apabila dia datang kepadamu--"
 },
 {
   "id": 29570,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 11,
   "firman": "dan dari Yesus, yang dinamai Yustus. Hanya ketiga orang ini dari antara mereka yang bersunat yang menjadi temanku sekerja untuk Kerajaan Allah; mereka itu telah menjadi penghibur bagiku."
 },
 {
   "id": 29571,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 12,
   "firman": "Salam dari Epafras kepada kamu; ia seorang dari antaramu, hamba Kristus Yesus, yang selalu bergumul dalam doanya untuk kamu, supaya kamu berdiri teguh, sebagai orang-orang yang dewasa dan yang berkeyakinan penuh dengan segala hal yang dikehendaki Allah."
 },
 {
   "id": 29572,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sebab aku dapat memberi kesaksian tentang dia, bahwa ia sangat bersusah payah untuk kamu dan untuk mereka yang di Laodikia dan Hierapolis."
 },
 {
   "id": 29573,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 14,
   "firman": "Salam kepadamu dari tabib Lukas yang kekasih dan dari Demas."
 },
 {
   "id": 29574,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sampaikan salam kami kepada saudara-saudara di Laodikia; juga kepada Nimfa dan jemaat yang ada di rumahnya."
 },
 {
   "id": 29575,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 16,
   "firman": "Dan bilamana surat ini telah dibacakan di antara kamu, usahakanlah, supaya dibacakan juga di jemaat Laodikia dan supaya surat yang untuk Laodikia dibacakan juga kepadamu."
 },
 {
   "id": 29576,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 17,
   "firman": "Dan sampaikanlah kepada Arkhipus: Perhatikanlah, supaya pelayanan yang kauterima dalam Tuhan kaujalankan sepenuhnya."
 },
 {
   "id": 29577,
   "kitab": "Kol",
   "pasal": 4,
   "ayat": 18,
   "firman": "Salam dari padaku, Paulus. Salam ini kutulis dengan tanganku sendiri. Ingatlah akan belengguku. Kasih karunia menyertai kamu."
 },
 {
   "id": 29578,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, Silwanus dan Timotius kepada jemaat orang-orang Tesalonika yang di dalam Allah Bapa dan di dalam Tuhan Yesus Kristus. Kasih karunia dan damai sejahtera menyertai kamu."
 },
 {
   "id": 29579,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kami selalu mengucap syukur kepada Allah karena kamu semua dan menyebut kamu dalam doa kami."
 },
 {
   "id": 29580,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 3,
   "firman": "Sebab kami selalu mengingat pekerjaan imanmu, usaha kasihmu dan ketekunan pengharapanmu kepada Tuhan kita Yesus Kristus di hadapan Allah dan Bapa kita."
 },
 {
   "id": 29581,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan kami tahu, hai saudara-saudara yang dikasihi Allah, bahwa Ia telah memilih kamu."
 },
 {
   "id": 29582,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab Injil yang kami beritakan bukan disampaikan kepada kamu dengan kata-kata saja, tetapi juga dengan kekuatan oleh Roh Kudus dan dengan suatu kepastian yang kokoh. Memang kamu tahu, bagaimana kami bekerja di antara kamu oleh karena kamu."
 },
 {
   "id": 29583,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan kamu telah menjadi penurut kami dan penurut Tuhan; dalam penindasan yang berat kamu telah menerima firman itu dengan sukacita yang dikerjakan oleh Roh Kudus,"
 },
 {
   "id": 29584,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 7,
   "firman": "sehingga kamu telah menjadi teladan untuk semua orang yang percaya di wilayah Makedonia dan Akhaya."
 },
 {
   "id": 29585,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 8,
   "firman": "Karena dari antara kamu firman Tuhan bergema bukan hanya di Makedonia dan Akhaya saja, tetapi di semua tempat telah tersiar kabar tentang imanmu kepada Allah, sehingga kami tidak usah mengatakan apa-apa tentang hal itu."
 },
 {
   "id": 29586,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 9,
   "firman": "Sebab mereka sendiri berceritera tentang kami, bagaimana kami kamu sambut dan bagaimana kamu berbalik dari berhala-berhala kepada Allah untuk melayani Allah yang hidup dan yang benar,"
 },
 {
   "id": 29587,
   "kitab": "1Te",
   "pasal": 1,
   "ayat": 10,
   "firman": "dan untuk menantikan kedatangan Anak-Nya dari sorga, yang telah dibangkitkan-Nya dari antara orang mati, yaitu Yesus, yang menyelamatkan kita dari murka yang akan datang."
 },
 {
   "id": 29588,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 1,
   "firman": "Kamu sendiripun memang tahu, saudara-saudara, bahwa kedatangan kami di antaramu tidaklah sia-sia."
 },
 {
   "id": 29589,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 2,
   "firman": "Tetapi sungguhpun kami sebelumnya, seperti kamu tahu, telah dianiaya dan dihina di Filipi, namun dengan pertolongan Allah kita, kami beroleh keberanian untuk memberitakan Injil Allah kepada kamu dalam perjuangan yang berat."
 },
 {
   "id": 29590,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 3,
   "firman": "Sebab nasihat kami tidak lahir dari kesesatan atau dari maksud yang tidak murni dan juga tidak disertai tipu daya."
 },
 {
   "id": 29591,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 4,
   "firman": "Sebaliknya, karena Allah telah menganggap kami layak untuk mempercayakan Injil kepada kami, karena itulah kami berbicara, bukan untuk menyukakan manusia, melainkan untuk menyukakan Allah yang menguji hati kita."
 },
 {
   "id": 29592,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 5,
   "firman": "Karena kami tidak pernah bermulut manis--hal itu kamu ketahui--dan tidak pernah mempunyai maksud loba yang tersembunyi--Allah adalah saksi--"
 },
 {
   "id": 29593,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 6,
   "firman": "juga tidak pernah kami mencari pujian dari manusia, baik dari kamu, maupun dari orang-orang lain, sekalipun kami dapat berbuat demikian sebagai rasul-rasul Kristus."
 },
 {
   "id": 29594,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 7,
   "firman": "Tetapi kami berlaku ramah di antara kamu, sama seperti seorang ibu mengasuh dan merawati anaknya."
 },
 {
   "id": 29595,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 8,
   "firman": "Demikianlah kami, dalam kasih sayang yang besar akan kamu, bukan saja rela membagi Injil Allah dengan kamu, tetapi juga hidup kami sendiri dengan kamu, karena kamu telah kami kasihi."
 },
 {
   "id": 29596,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 9,
   "firman": "Sebab kamu masih ingat, saudara-saudara, akan usaha dan jerih lelah kami. Sementara kami bekerja siang malam, supaya jangan menjadi beban bagi siapapun juga di antara kamu, kami memberitakan Injil Allah kepada kamu."
 },
 {
   "id": 29597,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 10,
   "firman": "Kamu adalah saksi, demikian juga Allah, betapa saleh, adil dan tak bercacatnya kami berlaku di antara kamu, yang percaya."
 },
 {
   "id": 29598,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 11,
   "firman": "Kamu tahu, betapa kami, seperti bapa terhadap anak-anaknya, telah menasihati kamu dan menguatkan hatimu seorang demi seorang,"
 },
 {
   "id": 29599,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 12,
   "firman": "dan meminta dengan sangat, supaya kamu hidup sesuai dengan kehendak Allah, yang memanggil kamu ke dalam Kerajaan dan kemuliaan-Nya."
 },
 {
   "id": 29600,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan karena itulah kami tidak putus-putusnya mengucap syukur juga kepada Allah, sebab kamu telah menerima firman Allah yang kami beritakan itu, bukan sebagai perkataan manusia, tetapi--dan memang sungguh-sungguh demikian--sebagai firman Allah, yang bekerja juga di dalam kamu yang percaya."
 },
 {
   "id": 29601,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 14,
   "firman": "Sebab kamu, saudara-saudara, telah menjadi penurut jemaat-jemaat Allah di Yudea, jemaat-jemaat di dalam Kristus Yesus, karena kamu juga telah menderita dari teman-teman sebangsamu segala sesuatu yang mereka derita dari orang-orang Yahudi."
 },
 {
   "id": 29602,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 15,
   "firman": "Bahkan orang-orang Yahudi itu telah membunuh Tuhan Yesus dan para nabi dan telah menganiaya kami. Apa yang berkenan kepada Allah tidak mereka pedulikan dan semua manusia mereka musuhi,"
 },
 {
   "id": 29603,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 16,
   "firman": "karena mereka mau menghalang-halangi kami memberitakan firman kepada bangsa-bangsa lain untuk keselamatan mereka. Demikianlah mereka terus-menerus menambah dosa mereka sampai genap jumlahnya dan sekarang murka telah menimpa mereka sepenuh-penuhnya."
 },
 {
   "id": 29604,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 17,
   "firman": "Tetapi kami, saudara-saudara, yang seketika terpisah dari kamu, jauh di mata, tetapi tidak jauh di hati, sungguh-sungguh, dengan rindu yang besar, telah berusaha untuk datang menjenguk kamu."
 },
 {
   "id": 29605,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 18,
   "firman": "Sebab kami telah berniat untuk datang kepada kamu--aku, Paulus, malahan lebih dari sekali--,tetapi Iblis telah mencegah kami."
 },
 {
   "id": 29606,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 19,
   "firman": "Sebab siapakah pengharapan kami atau sukacita kami atau mahkota kemegahan kami di hadapan Yesus, Tuhan kita, pada waktu kedatangan-Nya, kalau bukan kamu?"
 },
 {
   "id": 29607,
   "kitab": "1Te",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sungguh, kamulah kemuliaan kami dan sukacita kami."
 },
 {
   "id": 29608,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 1,
   "firman": "Kami tidak dapat tahan lagi, karena itu kami mengambil keputusan untuk tinggal seorang diri di Atena."
 },
 {
   "id": 29609,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu kami mengirim Timotius, saudara yang bekerja dengan kami untuk Allah dalam pemberitaan Injil Kristus, untuk menguatkan hatimu dan menasihatkan kamu tentang imanmu,"
 },
 {
   "id": 29610,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 3,
   "firman": "supaya jangan ada orang yang goyang imannya karena kesusahan-kesusahan ini. Kamu sendiri tahu, bahwa kita ditentukan untuk itu."
 },
 {
   "id": 29611,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sebab, juga waktu kami bersama-sama dengan kamu, telah kami katakan kepada kamu, bahwa kita akan mengalami kesusahan. Dan hal itu, seperti kamu tahu, telah terjadi."
 },
 {
   "id": 29612,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 5,
   "firman": "Itulah sebabnya, maka aku, karena tidak dapat tahan lagi, telah mengirim dia, supaya aku tahu tentang imanmu, karena aku kuatir kalau-kalau kamu telah dicobai oleh si penggoda dan kalau-kalau usaha kami menjadi sia-sia."
 },
 {
   "id": 29613,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 6,
   "firman": "Tetapi sekarang, setelah Timotius datang kembali dari kamu dan membawa kabar yang menggembirakan tentang imanmu dan kasihmu, dan bahwa kamu selalu menaruh kenang-kenangan yang baik akan kami dan ingin untuk berjumpa dengan kami, seperti kami juga ingin untuk berjumpa dengan kamu,"
 },
 {
   "id": 29614,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 7,
   "firman": "maka kami juga, saudara-saudara, dalam segala kesesakan dan kesukaran kami menjadi terhibur oleh kamu dan oleh imanmu."
 },
 {
   "id": 29615,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 8,
   "firman": "Sekarang kami hidup kembali, asal saja kamu teguh berdiri di dalam Tuhan."
 },
 {
   "id": 29616,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 9,
   "firman": "Sebab ucapan syukur apakah yang dapat kami persembahkan kepada Allah atas segala sukacita, yang kami peroleh karena kamu, di hadapan Allah kita?"
 },
 {
   "id": 29617,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 10,
   "firman": "Siang malam kami berdoa sungguh-sungguh, supaya kita bertemu muka dengan muka dan menambahkan apa yang masih kurang pada imanmu."
 },
 {
   "id": 29618,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 11,
   "firman": "Kiranya Dia, Allah dan Bapa kita, dan Yesus, Tuhan kita, membukakan kami jalan kepadamu."
 },
 {
   "id": 29619,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 12,
   "firman": "Dan kiranya Tuhan menjadikan kamu bertambah-tambah dan berkelimpahan dalam kasih seorang terhadap yang lain dan terhadap semua orang, sama seperti kami juga mengasihi kamu."
 },
 {
   "id": 29620,
   "kitab": "1Te",
   "pasal": 3,
   "ayat": 13,
   "firman": "Kiranya Dia menguatkan hatimu, supaya tak bercacat dan kudus, di hadapan Allah dan Bapa kita pada waktu kedatangan Yesus, Tuhan kita, dengan semua orang kudus-Nya."
 },
 {
   "id": 29621,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 1,
   "firman": "Akhirnya, saudara-saudara, kami minta dan nasihatkan kamu dalam Tuhan Yesus: Kamu telah mendengar dari kami bagaimana kamu harus hidup supaya berkenan kepada Allah. Hal itu memang telah kamu turuti, tetapi baiklah kamu melakukannya lebih bersungguh-sungguh lagi."
 },
 {
   "id": 29622,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 2,
   "firman": "Kamu tahu juga petunjuk-petunjuk mana yang telah kami berikan kepadamu atas nama Tuhan Yesus."
 },
 {
   "id": 29623,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 3,
   "firman": "Karena inilah kehendak Allah: pengudusanmu, yaitu supaya kamu menjauhi percabulan,"
 },
 {
   "id": 29624,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 4,
   "firman": "supaya kamu masing-masing mengambil seorang perempuan menjadi isterimu sendiri dan hidup di dalam pengudusan dan penghormatan,"
 },
 {
   "id": 29625,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 5,
   "firman": "bukan di dalam keinginan hawa nafsu, seperti yang dibuat oleh orang-orang yang tidak mengenal Allah,"
 },
 {
   "id": 29626,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 6,
   "firman": "dan supaya dalam hal-hal ini orang jangan memperlakukan saudaranya dengan tidak baik atau memperdayakannya. Karena Tuhan adalah pembalas dari semuanya ini, seperti yang telah kami katakan dan tegaskan dahulu kepadamu."
 },
 {
   "id": 29627,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 7,
   "firman": "Allah memanggil kita bukan untuk melakukan apa yang cemar, melainkan apa yang kudus."
 },
 {
   "id": 29628,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 8,
   "firman": "Karena itu siapa yang menolak ini bukanlah menolak manusia, melainkan menolak Allah yang telah memberikan juga Roh-Nya yang kudus kepada kamu."
 },
 {
   "id": 29629,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 9,
   "firman": "Tentang kasih persaudaraan tidak perlu dituliskan kepadamu, karena kamu sendiri telah belajar kasih mengasihi dari Allah."
 },
 {
   "id": 29630,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 10,
   "firman": "Hal itu kamu lakukan juga terhadap semua saudara di seluruh wilayah Makedonia. Tetapi kami menasihati kamu, saudara-saudara, supaya kamu lebih bersungguh-sungguh lagi melakukannya."
 },
 {
   "id": 29631,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 11,
   "firman": "Dan anggaplah sebagai suatu kehormatan untuk hidup tenang, untuk mengurus persoalan-persoalan sendiri dan bekerja dengan tangan, seperti yang telah kami pesankan kepadamu,"
 },
 {
   "id": 29632,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 12,
   "firman": "sehingga kamu hidup sebagai orang-orang yang sopan di mata orang luar dan tidak bergantung pada mereka."
 },
 {
   "id": 29633,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 13,
   "firman": "Selanjutnya kami tidak mau, saudara-saudara, bahwa kamu tidak mengetahui tentang mereka yang meninggal, supaya kamu jangan berdukacita seperti orang-orang lain yang tidak mempunyai pengharapan."
 },
 {
   "id": 29634,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 14,
   "firman": "Karena jikalau kita percaya, bahwa Yesus telah mati dan telah bangkit, maka kita percaya juga bahwa mereka yang telah meninggal dalam Yesus akan dikumpulkan Allah bersama-sama dengan Dia."
 },
 {
   "id": 29635,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 15,
   "firman": "Ini kami katakan kepadamu dengan firman Tuhan: kita yang hidup, yang masih tinggal sampai kedatangan Tuhan, sekali-kali tidak akan mendahului mereka yang telah meninggal."
 },
 {
   "id": 29636,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sebab pada waktu tanda diberi, yaitu pada waktu penghulu malaikat berseru dan sangkakala Allah berbunyi, maka Tuhan sendiri akan turun dari sorga dan mereka yang mati dalam Kristus akan lebih dahulu bangkit;"
 },
 {
   "id": 29637,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 17,
   "firman": "sesudah itu, kita yang hidup, yang masih tinggal, akan diangkat bersama-sama dengan mereka dalam awan menyongsong Tuhan di angkasa. Demikianlah kita akan selama-lamanya bersama-sama dengan Tuhan."
 },
 {
   "id": 29638,
   "kitab": "1Te",
   "pasal": 4,
   "ayat": 18,
   "firman": "Karena itu hiburkanlah seorang akan yang lain dengan perkataan-perkataan ini."
 },
 {
   "id": 29639,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 1,
   "firman": "Tetapi tentang zaman dan masa, saudara-saudara, tidak perlu dituliskan kepadamu,"
 },
 {
   "id": 29640,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 2,
   "firman": "karena kamu sendiri tahu benar-benar, bahwa hari Tuhan datang seperti pencuri pada malam."
 },
 {
   "id": 29641,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 3,
   "firman": "Apabila mereka mengatakan: Semuanya damai dan aman--maka tiba-tiba mereka ditimpa oleh kebinasaan, seperti seorang perempuan yang hamil ditimpa oleh sakit bersalin--mereka pasti tidak akan luput."
 },
 {
   "id": 29642,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 4,
   "firman": "Tetapi kamu, saudara-saudara, kamu tidak hidup di dalam kegelapan, sehingga hari itu tiba-tiba mendatangi kamu seperti pencuri,"
 },
 {
   "id": 29643,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 5,
   "firman": "karena kamu semua adalah anak-anak terang dan anak-anak siang. Kita bukanlah orang-orang malam atau orang-orang kegelapan."
 },
 {
   "id": 29644,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 6,
   "firman": "Sebab itu baiklah jangan kita tidur seperti orang-orang lain, tetapi berjaga-jaga dan sadar."
 },
 {
   "id": 29645,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab mereka yang tidur, tidur waktu malam dan mereka yang mabuk, mabuk waktu malam."
 },
 {
   "id": 29646,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tetapi kita, yang adalah orang-orang siang, baiklah kita sadar, berbajuzirahkan iman dan kasih, dan berketopongkan pengharapan keselamatan."
 },
 {
   "id": 29647,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 9,
   "firman": "Karena Allah tidak menetapkan kita untuk ditimpa murka, tetapi untuk beroleh keselamatan oleh Yesus Kristus, Tuhan kita,"
 },
 {
   "id": 29648,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 10,
   "firman": "yang sudah mati untuk kita, supaya entah kita berjaga-jaga, entah kita tidur, kita hidup bersama-sama dengan Dia."
 },
 {
   "id": 29649,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 11,
   "firman": "Karena itu nasihatilah seorang akan yang lain dan saling membangunlah kamu seperti yang memang kamu lakukan."
 },
 {
   "id": 29650,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 12,
   "firman": "Kami minta kepadamu, saudara-saudara, supaya kamu menghormati mereka yang bekerja keras di antara kamu, yang memimpin kamu dalam Tuhan dan yang menegor kamu;"
 },
 {
   "id": 29651,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 13,
   "firman": "dan supaya kamu sungguh-sungguh menjunjung mereka dalam kasih karena pekerjaan mereka. Hiduplah selalu dalam damai seorang dengan yang lain."
 },
 {
   "id": 29652,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 14,
   "firman": "Kami juga menasihati kamu, saudara-saudara, tegorlah mereka yang hidup dengan tidak tertib, hiburlah mereka yang tawar hati, belalah mereka yang lemah, sabarlah terhadap semua orang."
 },
 {
   "id": 29653,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 15,
   "firman": "Perhatikanlah, supaya jangan ada orang yang membalas jahat dengan jahat, tetapi usahakanlah senantiasa yang baik, terhadap kamu masing-masing dan terhadap semua orang."
 },
 {
   "id": 29654,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 16,
   "firman": "Bersukacitalah senantiasa."
 },
 {
   "id": 29655,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 17,
   "firman": "Tetaplah berdoa."
 },
 {
   "id": 29656,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 18,
   "firman": "Mengucap syukurlah dalam segala hal, sebab itulah yang dikehendaki Allah di dalam Kristus Yesus bagi kamu."
 },
 {
   "id": 29657,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 19,
   "firman": "Janganlah padamkan Roh,"
 },
 {
   "id": 29658,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 20,
   "firman": "dan janganlah anggap rendah nubuat-nubuat."
 },
 {
   "id": 29659,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 21,
   "firman": "Ujilah segala sesuatu dan peganglah yang baik."
 },
 {
   "id": 29660,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 22,
   "firman": "Jauhkanlah dirimu dari segala jenis kejahatan."
 },
 {
   "id": 29661,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 23,
   "firman": "Semoga Allah damai sejahtera menguduskan kamu seluruhnya dan semoga roh, jiwa dan tubuhmu terpelihara sempurna dengan tak bercacat pada kedatangan Yesus Kristus, Tuhan kita."
 },
 {
   "id": 29662,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 24,
   "firman": "Ia yang memanggil kamu adalah setia, Ia juga akan menggenapinya."
 },
 {
   "id": 29663,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 25,
   "firman": "Saudara-saudara, doakanlah kami."
 },
 {
   "id": 29664,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 26,
   "firman": "Sampaikanlah salam kami kepada semua saudara dengan cium yang kudus."
 },
 {
   "id": 29665,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 27,
   "firman": "Demi nama Tuhan aku minta dengan sangat kepadamu, supaya surat ini dibacakan kepada semua saudara."
 },
 {
   "id": 29666,
   "kitab": "1Te",
   "pasal": 5,
   "ayat": 28,
   "firman": "Kasih karunia Yesus Kristus, Tuhan kita, menyertai kamu!"
 },
 {
   "id": 29667,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, Silwanus dan Timotius, kepada jemaat orang-orang Tesalonika di dalam Allah Bapa kita dan di dalam Tuhan Yesus Kristus."
 },
 {
   "id": 29668,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita, dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 29669,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kami wajib selalu mengucap syukur kepada Allah karena kamu, saudara-saudara. Dan memang patutlah demikian, karena imanmu makin bertambah dan kasihmu seorang akan yang lain makin kuat di antara kamu,"
 },
 {
   "id": 29670,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 4,
   "firman": "sehingga dalam jemaat-jemaat Allah kami sendiri bermegah tentang kamu karena ketabahanmu dan imanmu dalam segala penganiayaan dan penindasan yang kamu derita:"
 },
 {
   "id": 29671,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 5,
   "firman": "suatu bukti tentang adilnya penghakiman Allah, yang menyatakan bahwa kamu layak menjadi warga Kerajaan Allah, kamu yang sekarang menderita karena Kerajaan itu."
 },
 {
   "id": 29672,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 6,
   "firman": "Sebab memang adil bagi Allah untuk membalaskan penindasan kepada mereka yang menindas kamu"
 },
 {
   "id": 29673,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 7,
   "firman": "dan untuk memberikan kelegaan kepada kamu yang ditindas, dan juga kepada kami, pada waktu Tuhan Yesus dari dalam sorga menyatakan diri-Nya bersama-sama dengan malaikat-malaikat-Nya, dalam kuasa-Nya, di dalam api yang bernyala-nyala,"
 },
 {
   "id": 29674,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 8,
   "firman": "dan mengadakan pembalasan terhadap mereka yang tidak mau mengenal Allah dan tidak mentaati Injil Yesus, Tuhan kita."
 },
 {
   "id": 29675,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 9,
   "firman": "Mereka ini akan menjalani hukuman kebinasaan selama-lamanya, dijauhkan dari hadirat Tuhan dan dari kemuliaan kekuatan-Nya,"
 },
 {
   "id": 29676,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 10,
   "firman": "apabila Ia datang pada hari itu untuk dimuliakan di antara orang-orang kudus-Nya dan untuk dikagumi oleh semua orang yang percaya, sebab kesaksian yang kami bawa kepadamu telah kamu percayai."
 },
 {
   "id": 29677,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 11,
   "firman": "Karena itu kami senantiasa berdoa juga untuk kamu, supaya Allah kita menganggap kamu layak bagi panggilan-Nya dan dengan kekuatan-Nya menyempurnakan kehendakmu untuk berbuat baik dan menyempurnakan segala pekerjaan imanmu,"
 },
 {
   "id": 29678,
   "kitab": "2Te",
   "pasal": 1,
   "ayat": 12,
   "firman": "sehingga nama Yesus, Tuhan kita, dimuliakan di dalam kamu dan kamu di dalam Dia, menurut kasih karunia Allah kita dan Tuhan Yesus Kristus."
 },
 {
   "id": 29679,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 1,
   "firman": "Tentang kedatangan Tuhan kita Yesus Kristus dan terhimpunnya kita dengan Dia kami minta kepadamu, saudara-saudara,"
 },
 {
   "id": 29680,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 2,
   "firman": "supaya kamu jangan lekas bingung dan gelisah, baik oleh ilham roh, maupun oleh pemberitaan atau surat yang dikatakan dari kami, seolah-olah hari Tuhan telah tiba."
 },
 {
   "id": 29681,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 3,
   "firman": "Janganlah kamu memberi dirimu disesatkan orang dengan cara yang bagaimanapun juga! Sebab sebelum Hari itu haruslah datang dahulu murtad dan haruslah dinyatakan dahulu manusia durhaka, yang harus binasa,"
 },
 {
   "id": 29682,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 4,
   "firman": "yaitu lawan yang meninggikan diri di atas segala yang disebut atau yang disembah sebagai Allah. Bahkan ia duduk di Bait Allah dan mau menyatakan diri sebagai Allah."
 },
 {
   "id": 29683,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tidakkah kamu ingat, bahwa hal itu telah kerapkali kukatakan kepadamu, ketika aku masih bersama-sama dengan kamu?"
 },
 {
   "id": 29684,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 6,
   "firman": "Dan sekarang kamu tahu apa yang menahan dia, sehingga ia baru akan menyatakan diri pada waktu yang telah ditentukan baginya."
 },
 {
   "id": 29685,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 7,
   "firman": "Karena secara rahasia kedurhakaan telah mulai bekerja, tetapi sekarang masih ada yang menahan. Kalau yang menahannya itu telah disingkirkan,"
 },
 {
   "id": 29686,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 8,
   "firman": "pada waktu itulah si pendurhaka baru akan menyatakan dirinya, tetapi Tuhan Yesus akan membunuhnya dengan nafas mulut-Nya dan akan memusnahkannya, kalau Ia datang kembali."
 },
 {
   "id": 29687,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 9,
   "firman": "Kedatangan si pendurhaka itu adalah pekerjaan Iblis, dan akan disertai rupa-rupa perbuatan ajaib, tanda-tanda dan mujizat-mujizat palsu,"
 },
 {
   "id": 29688,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 10,
   "firman": "dengan rupa-rupa tipu daya jahat terhadap orang-orang yang harus binasa karena mereka tidak menerima dan mengasihi kebenaran yang dapat menyelamatkan mereka."
 },
 {
   "id": 29689,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 11,
   "firman": "Dan itulah sebabnya Allah mendatangkan kesesatan atas mereka, yang menyebabkan mereka percaya akan dusta,"
 },
 {
   "id": 29690,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 12,
   "firman": "supaya dihukum semua orang yang tidak percaya akan kebenaran dan yang suka kejahatan."
 },
 {
   "id": 29691,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 13,
   "firman": "Akan tetapi kami harus selalu mengucap syukur kepada Allah karena kamu, saudara-saudara, yang dikasihi Tuhan, sebab Allah dari mulanya telah memilih kamu untuk diselamatkan dalam Roh yang menguduskan kamu dan dalam kebenaran yang kamu percayai."
 },
 {
   "id": 29692,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 14,
   "firman": "Untuk itulah Ia telah memanggil kamu oleh Injil yang kami beritakan, sehingga kamu boleh memperoleh kemuliaan Yesus Kristus, Tuhan kita."
 },
 {
   "id": 29693,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 15,
   "firman": "Sebab itu, berdirilah teguh dan berpeganglah pada ajaran-ajaran yang kamu terima dari kami, baik secara lisan, maupun secara tertulis."
 },
 {
   "id": 29694,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 16,
   "firman": "Dan Ia, Tuhan kita Yesus Kristus, dan Allah, Bapa kita, yang dalam kasih karunia-Nya telah mengasihi kita dan yang telah menganugerahkan penghiburan abadi dan pengharapan baik kepada kita,"
 },
 {
   "id": 29695,
   "kitab": "2Te",
   "pasal": 2,
   "ayat": 17,
   "firman": "kiranya menghibur dan menguatkan hatimu dalam pekerjaan dan perkataan yang baik."
 },
 {
   "id": 29696,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 1,
   "firman": "Selanjutnya, saudara-saudara, berdoalah untuk kami, supaya firman Tuhan beroleh kemajuan dan dimuliakan, sama seperti yang telah terjadi di antara kamu,"
 },
 {
   "id": 29697,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 2,
   "firman": "dan supaya kami terlepas dari para pengacau dan orang-orang jahat, sebab bukan semua orang beroleh iman."
 },
 {
   "id": 29698,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 3,
   "firman": "Tetapi Tuhan adalah setia. Ia akan menguatkan hatimu dan memelihara kamu terhadap yang jahat."
 },
 {
   "id": 29699,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 4,
   "firman": "Dan kami percaya dalam Tuhan, bahwa apa yang kami pesankan kepadamu, kamu lakukan dan akan kamu lakukan."
 },
 {
   "id": 29700,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 5,
   "firman": "Kiranya Tuhan tetap menujukan hatimu kepada kasih Allah dan kepada ketabahan Kristus."
 },
 {
   "id": 29701,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 6,
   "firman": "Tetapi kami berpesan kepadamu, saudara-saudara, dalam nama Tuhan Yesus Kristus, supaya kamu menjauhkan diri dari setiap saudara yang tidak melakukan pekerjaannya dan yang tidak menurut ajaran yang telah kamu terima dari kami."
 },
 {
   "id": 29702,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sebab kamu sendiri tahu, bagaimana kamu harus mengikuti teladan kami, karena kami tidak lalai bekerja di antara kamu,"
 },
 {
   "id": 29703,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 8,
   "firman": "dan tidak makan roti orang dengan percuma, tetapi kami berusaha dan berjerih payah siang malam, supaya jangan menjadi beban bagi siapapun di antara kamu."
 },
 {
   "id": 29704,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 9,
   "firman": "Bukan karena kami tidak berhak untuk itu, melainkan karena kami mau menjadikan diri kami teladan bagi kamu, supaya kamu ikuti."
 },
 {
   "id": 29705,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 10,
   "firman": "Sebab, juga waktu kami berada di antara kamu, kami memberi peringatan ini kepada kamu: jika seorang tidak mau bekerja, janganlah ia makan."
 },
 {
   "id": 29706,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 11,
   "firman": "Kami katakan ini karena kami dengar, bahwa ada orang yang tidak tertib hidupnya dan tidak bekerja, melainkan sibuk dengan hal-hal yang tidak berguna."
 },
 {
   "id": 29707,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 12,
   "firman": "Orang-orang yang demikian kami peringati dan nasihati dalam Tuhan Yesus Kristus, supaya mereka tetap tenang melakukan pekerjaannya dan dengan demikian makan makanannya sendiri."
 },
 {
   "id": 29708,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 13,
   "firman": "Dan kamu, saudara-saudara, janganlah jemu-jemu berbuat apa yang baik."
 },
 {
   "id": 29709,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 14,
   "firman": "Jika ada orang yang tidak mau mendengarkan apa yang kami katakan dalam surat ini, tandailah dia dan jangan bergaul dengan dia, supaya ia menjadi malu,"
 },
 {
   "id": 29710,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 15,
   "firman": "tetapi janganlah anggap dia sebagai musuh, tetapi tegorlah dia sebagai seorang saudara."
 },
 {
   "id": 29711,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 16,
   "firman": "Dan Ia, Tuhan damai sejahtera, kiranya mengaruniakan damai sejahtera-Nya terus-menerus, dalam segala hal, kepada kamu. Tuhan menyertai kamu sekalian."
 },
 {
   "id": 29712,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 17,
   "firman": "Salam dari padaku, Paulus. Salam ini kutulis dengan tanganku sendiri. Inilah tanda dalam setiap surat: beginilah tulisanku."
 },
 {
   "id": 29713,
   "kitab": "2Te",
   "pasal": 3,
   "ayat": 18,
   "firman": "Kasih karunia Yesus Kristus, Tuhan kita, menyertai kamu sekalian!"
 },
 {
   "id": 29714,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, rasul Kristus Yesus menurut perintah Allah, Juruselamat kita, dan Kristus Yesus, dasar pengharapan kita,"
 },
 {
   "id": 29715,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 2,
   "firman": "kepada Timotius, anakku yang sah di dalam iman: kasih karunia, rahmat dan damai sejahtera dari Allah Bapa dan Kristus Yesus, Tuhan kita, menyertai engkau."
 },
 {
   "id": 29716,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 3,
   "firman": "Ketika aku hendak meneruskan perjalananku ke wilayah Makedonia, aku telah mendesak engkau supaya engkau tinggal di Efesus dan menasihatkan orang-orang tertentu, agar mereka jangan mengajarkan ajaran lain"
 },
 {
   "id": 29717,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 4,
   "firman": "ataupun sibuk dengan dongeng dan silsilah yang tiada putus-putusnya, yang hanya menghasilkan persoalan belaka, dan bukan tertib hidup keselamatan yang diberikan Allah dalam iman."
 },
 {
   "id": 29718,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 5,
   "firman": "Tujuan nasihat itu ialah kasih yang timbul dari hati yang suci, dari hati nurani yang murni dan dari iman yang tulus ikhlas."
 },
 {
   "id": 29719,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 6,
   "firman": "Tetapi ada orang yang tidak sampai pada tujuan itu dan yang sesat dalam omongan yang sia-sia."
 },
 {
   "id": 29720,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 7,
   "firman": "Mereka itu hendak menjadi pengajar hukum Taurat tanpa mengerti perkataan mereka sendiri dan pokok-pokok yang secara mutlak mereka kemukakan."
 },
 {
   "id": 29721,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 8,
   "firman": "Kita tahu bahwa hukum Taurat itu baik kalau tepat digunakan,"
 },
 {
   "id": 29722,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 9,
   "firman": "yakni dengan keinsafan bahwa hukum Taurat itu bukanlah bagi orang yang benar, melainkan bagi orang durhaka dan orang lalim, bagi orang fasik dan orang berdosa, bagi orang duniawi dan yang tak beragama, bagi pembunuh bapa dan pembunuh ibu, bagi pembunuh pada umumnya,"
 },
 {
   "id": 29723,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 10,
   "firman": "bagi orang cabul dan pemburit, bagi penculik, bagi pendusta, bagi orang makan sumpah dan seterusnya segala sesuatu yang bertentangan dengan ajaran sehat"
 },
 {
   "id": 29724,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 11,
   "firman": "yang berdasarkan Injil dari Allah yang mulia dan maha bahagia, seperti yang telah dipercayakan kepadaku."
 },
 {
   "id": 29725,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 12,
   "firman": "Aku bersyukur kepada Dia, yang menguatkan aku, yaitu Kristus Yesus, Tuhan kita, karena Ia menganggap aku setia dan mempercayakan pelayanan ini kepadaku--"
 },
 {
   "id": 29726,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 13,
   "firman": "aku yang tadinya seorang penghujat dan seorang penganiaya dan seorang ganas, tetapi aku telah dikasihani-Nya, karena semuanya itu telah kulakukan tanpa pengetahuan yaitu di luar iman."
 },
 {
   "id": 29727,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 14,
   "firman": "Malah kasih karunia Tuhan kita itu telah dikaruniakan dengan limpahnya kepadaku dengan iman dan kasih dalam Kristus Yesus."
 },
 {
   "id": 29728,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 15,
   "firman": "Perkataan ini benar dan patut diterima sepenuhnya: \"Kristus Yesus datang ke dunia untuk menyelamatkan orang berdosa,\" dan di antara mereka akulah yang paling berdosa."
 },
 {
   "id": 29729,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 16,
   "firman": "Tetapi justru karena itu aku dikasihani, agar dalam diriku ini, sebagai orang yang paling berdosa, Yesus Kristus menunjukkan seluruh kesabaran-Nya. Dengan demikian aku menjadi contoh bagi mereka yang kemudian percaya kepada-Nya dan mendapat hidup yang kekal."
 },
 {
   "id": 29730,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 17,
   "firman": "Hormat dan kemuliaan sampai selama-lamanya bagi Raja segala zaman, Allah yang kekal, yang tak nampak, yang esa! Amin."
 },
 {
   "id": 29731,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 18,
   "firman": "Tugas ini kuberikan kepadamu, Timotius anakku, sesuai dengan apa yang telah dinubuatkan tentang dirimu, supaya dikuatkan oleh nubuat itu engkau memperjuangkan perjuangan yang baik dengan iman dan hati nurani yang murni."
 },
 {
   "id": 29732,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 19,
   "firman": "Beberapa orang telah menolak hati nuraninya yang murni itu, dan karena itu kandaslah iman mereka,"
 },
 {
   "id": 29733,
   "kitab": "1Ti",
   "pasal": 1,
   "ayat": 20,
   "firman": "di antaranya Himeneus dan Aleksander, yang telah kuserahkan kepada Iblis, supaya jera mereka menghujat."
 },
 {
   "id": 29734,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 1,
   "firman": "Pertama-tama aku menasihatkan: Naikkanlah permohonan, doa syafaat dan ucapan syukur untuk semua orang,"
 },
 {
   "id": 29735,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 2,
   "firman": "untuk raja-raja dan untuk semua pembesar, agar kita dapat hidup tenang dan tenteram dalam segala kesalehan dan kehormatan."
 },
 {
   "id": 29736,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 3,
   "firman": "Itulah yang baik dan yang berkenan kepada Allah, Juruselamat kita,"
 },
 {
   "id": 29737,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 4,
   "firman": "yang menghendaki supaya semua orang diselamatkan dan memperoleh pengetahuan akan kebenaran."
 },
 {
   "id": 29738,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 5,
   "firman": "Karena Allah itu esa dan esa pula Dia yang menjadi pengantara antara Allah dan manusia, yaitu manusia Kristus Yesus,"
 },
 {
   "id": 29739,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 6,
   "firman": "yang telah menyerahkan diri-Nya sebagai tebusan bagi semua manusia: itu kesaksian pada waktu yang ditentukan."
 },
 {
   "id": 29740,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 7,
   "firman": "Untuk kesaksian itulah aku telah ditetapkan sebagai pemberita dan rasul--yang kukatakan ini benar, aku tidak berdusta--dan sebagai pengajar orang-orang bukan Yahudi, dalam iman dan kebenaran."
 },
 {
   "id": 29741,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 8,
   "firman": "Oleh karena itu aku ingin, supaya di mana-mana orang laki-laki berdoa dengan menadahkan tangan yang suci, tanpa marah dan tanpa perselisihan."
 },
 {
   "id": 29742,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 9,
   "firman": "Demikian juga hendaknya perempuan. Hendaklah ia berdandan dengan pantas, dengan sopan dan sederhana, rambutnya jangan berkepang-kepang, jangan memakai emas atau mutiara ataupun pakaian yang mahal-mahal,"
 },
 {
   "id": 29743,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 10,
   "firman": "tetapi hendaklah ia berdandan dengan perbuatan baik, seperti yang layak bagi perempuan yang beribadah."
 },
 {
   "id": 29744,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 11,
   "firman": "Seharusnyalah perempuan berdiam diri dan menerima ajaran dengan patuh."
 },
 {
   "id": 29745,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 12,
   "firman": "Aku tidak mengizinkan perempuan mengajar dan juga tidak mengizinkannya memerintah laki-laki; hendaklah ia berdiam diri."
 },
 {
   "id": 29746,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 13,
   "firman": "Karena Adam yang pertama dijadikan, kemudian barulah Hawa."
 },
 {
   "id": 29747,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 14,
   "firman": "Lagipula bukan Adam yang tergoda, melainkan perempuan itulah yang tergoda dan jatuh ke dalam dosa."
 },
 {
   "id": 29748,
   "kitab": "1Ti",
   "pasal": 2,
   "ayat": 15,
   "firman": "Tetapi perempuan akan diselamatkan karena melahirkan anak, asal ia bertekun dalam iman dan kasih dan pengudusan dengan segala kesederhanaan."
 },
 {
   "id": 29749,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 1,
   "firman": "Benarlah perkataan ini: \"Orang yang menghendaki jabatan penilik jemaat menginginkan pekerjaan yang indah.\""
 },
 {
   "id": 29750,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 2,
   "firman": "Karena itu penilik jemaat haruslah seorang yang tak bercacat, suami dari satu isteri, dapat menahan diri, bijaksana, sopan, suka memberi tumpangan, cakap mengajar orang,"
 },
 {
   "id": 29751,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 3,
   "firman": "bukan peminum, bukan pemarah melainkan peramah, pendamai, bukan hamba uang,"
 },
 {
   "id": 29752,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 4,
   "firman": "seorang kepala keluarga yang baik, disegani dan dihormati oleh anak-anaknya."
 },
 {
   "id": 29753,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 5,
   "firman": "Jikalau seorang tidak tahu mengepalai keluarganya sendiri, bagaimanakah ia dapat mengurus Jemaat Allah?"
 },
 {
   "id": 29754,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 6,
   "firman": "Janganlah ia seorang yang baru bertobat, agar jangan ia menjadi sombong dan kena hukuman Iblis."
 },
 {
   "id": 29755,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 7,
   "firman": "Hendaklah ia juga mempunyai nama baik di luar jemaat, agar jangan ia digugat orang dan jatuh ke dalam jerat Iblis."
 },
 {
   "id": 29756,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 8,
   "firman": "Demikian juga diaken-diaken haruslah orang terhormat, jangan bercabang lidah, jangan penggemar anggur, jangan serakah,"
 },
 {
   "id": 29757,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 9,
   "firman": "melainkan orang yang memelihara rahasia iman dalam hati nurani yang suci."
 },
 {
   "id": 29758,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 10,
   "firman": "Mereka juga harus diuji dahulu, baru ditetapkan dalam pelayanan itu setelah ternyata mereka tak bercacat."
 },
 {
   "id": 29759,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 11,
   "firman": "Demikian pula isteri-isteri hendaklah orang terhormat, jangan pemfitnah, hendaklah dapat menahan diri dan dapat dipercayai dalam segala hal."
 },
 {
   "id": 29760,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 12,
   "firman": "Diaken haruslah suami dari satu isteri dan mengurus anak-anaknya dan keluarganya dengan baik."
 },
 {
   "id": 29761,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 13,
   "firman": "Karena mereka yang melayani dengan baik beroleh kedudukan yang baik sehingga dalam iman kepada Kristus Yesus mereka dapat bersaksi dengan leluasa."
 },
 {
   "id": 29762,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 14,
   "firman": "Semuanya itu kutuliskan kepadamu, walaupun kuharap segera dapat mengunjungi engkau."
 },
 {
   "id": 29763,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 15,
   "firman": "Jadi jika aku terlambat, sudahlah engkau tahu bagaimana orang harus hidup sebagai keluarga Allah, yakni jemaat dari Allah yang hidup, tiang penopang dan dasar kebenaran."
 },
 {
   "id": 29764,
   "kitab": "1Ti",
   "pasal": 3,
   "ayat": 16,
   "firman": "Dan sesungguhnya agunglah rahasia ibadah kita: \"Dia, yang telah menyatakan diri-Nya dalam rupa manusia, dibenarkan dalam Roh; yang menampakkan diri-Nya kepada malaikat-malaikat, diberitakan di antara bangsa-bangsa yang tidak mengenal Allah; yang dipercayai di dalam dunia, diangkat dalam kemuliaan.\""
 },
 {
   "id": 29765,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 1,
   "firman": "Tetapi Roh dengan tegas mengatakan bahwa di waktu-waktu kemudian, ada orang yang akan murtad lalu mengikuti roh-roh penyesat dan ajaran setan-setan"
 },
 {
   "id": 29766,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 2,
   "firman": "oleh tipu daya pendusta-pendusta yang hati nuraninya memakai cap mereka."
 },
 {
   "id": 29767,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 3,
   "firman": "Mereka itu melarang orang kawin, melarang orang makan makanan yang diciptakan Allah supaya dengan pengucapan syukur dimakan oleh orang yang percaya dan yang telah mengenal kebenaran."
 },
 {
   "id": 29768,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 4,
   "firman": "Karena semua yang diciptakan Allah itu baik dan suatupun tidak ada yang haram, jika diterima dengan ucapan syukur,"
 },
 {
   "id": 29769,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 5,
   "firman": "sebab semuanya itu dikuduskan oleh firman Allah dan oleh doa."
 },
 {
   "id": 29770,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 6,
   "firman": "Dengan selalu mengingatkan hal-hal itu kepada saudara-saudara kita, engkau akan menjadi seorang pelayan Kristus Yesus yang baik, terdidik dalam soal-soal pokok iman kita dan dalam ajaran sehat yang telah kauikuti selama ini."
 },
 {
   "id": 29771,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 7,
   "firman": "Tetapi jauhilah takhayul dan dongeng nenek-nenek tua. Latihlah dirimu beribadah."
 },
 {
   "id": 29772,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 8,
   "firman": "Latihan badani terbatas gunanya, tetapi ibadah itu berguna dalam segala hal, karena mengandung janji, baik untuk hidup ini maupun untuk hidup yang akan datang."
 },
 {
   "id": 29773,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 9,
   "firman": "Perkataan ini benar dan patut diterima sepenuhnya."
 },
 {
   "id": 29774,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 10,
   "firman": "Itulah sebabnya kita berjerih payah dan berjuang, karena kita menaruh pengharapan kita kepada Allah yang hidup, Juruselamat semua manusia, terutama mereka yang percaya."
 },
 {
   "id": 29775,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 11,
   "firman": "Beritakanlah dan ajarkanlah semuanya itu."
 },
 {
   "id": 29776,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 12,
   "firman": "Jangan seorangpun menganggap engkau rendah karena engkau muda. Jadilah teladan bagi orang-orang percaya, dalam perkataanmu, dalam tingkah lakumu, dalam kasihmu, dalam kesetiaanmu dan dalam kesucianmu."
 },
 {
   "id": 29777,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sementara itu, sampai aku datang bertekunlah dalam membaca Kitab-kitab Suci, dalam membangun dan dalam mengajar."
 },
 {
   "id": 29778,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 14,
   "firman": "Jangan lalai dalam mempergunakan karunia yang ada padamu, yang telah diberikan kepadamu oleh nubuat dan dengan penumpangan tangan sidang penatua."
 },
 {
   "id": 29779,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 15,
   "firman": "Perhatikanlah semuanya itu, hiduplah di dalamnya supaya kemajuanmu nyata kepada semua orang."
 },
 {
   "id": 29780,
   "kitab": "1Ti",
   "pasal": 4,
   "ayat": 16,
   "firman": "Awasilah dirimu sendiri dan awasilah ajaranmu. Bertekunlah dalam semuanya itu, karena dengan berbuat demikian engkau akan menyelamatkan dirimu dan semua orang yang mendengar engkau."
 },
 {
   "id": 29781,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 1,
   "firman": "Janganlah engkau keras terhadap orang yang tua, melainkan tegorlah dia sebagai bapa. Tegorlah orang-orang muda sebagai saudaramu,"
 },
 {
   "id": 29782,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 2,
   "firman": "perempuan-perempuan tua sebagai ibu dan perempuan-perempuan muda sebagai adikmu dengan penuh kemurnian."
 },
 {
   "id": 29783,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 3,
   "firman": "Hormatilah janda-janda yang benar-benar janda."
 },
 {
   "id": 29784,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 4,
   "firman": "Tetapi jikalau seorang janda mempunyai anak atau cucu, hendaknya mereka itu pertama-tama belajar berbakti kepada kaum keluarganya sendiri dan membalas budi orang tua dan nenek mereka, karena itulah yang berkenan kepada Allah."
 },
 {
   "id": 29785,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 5,
   "firman": "Sedangkan seorang janda yang benar-benar janda, yang ditinggalkan seorang diri, menaruh harapannya kepada Allah dan bertekun dalam permohonan dan doa siang malam."
 },
 {
   "id": 29786,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 6,
   "firman": "Tetapi seorang janda yang hidup mewah dan berlebih-lebihan, ia sudah mati selagi hidup."
 },
 {
   "id": 29787,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 7,
   "firman": "Peringatkanlah hal-hal ini juga kepada janda-janda itu agar mereka hidup dengan tidak bercela."
 },
 {
   "id": 29788,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tetapi jika ada seorang yang tidak memeliharakan sanak saudaranya, apalagi seisi rumahnya, orang itu murtad dan lebih buruk dari orang yang tidak beriman."
 },
 {
   "id": 29789,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 9,
   "firman": "Yang didaftarkan sebagai janda, hanyalah mereka yang tidak kurang dari enam puluh tahun, yang hanya satu kali bersuami"
 },
 {
   "id": 29790,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 10,
   "firman": "dan yang terbukti telah melakukan pekerjaan yang baik, seperti mengasuh anak, memberi tumpangan, membasuh kaki saudara-saudara seiman, menolong orang yang hidup dalam kesesakan--pendeknya mereka yang telah menggunakan segala kesempatan untuk berbuat baik."
 },
 {
   "id": 29791,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 11,
   "firman": "Tolaklah pendaftaran janda-janda yang lebih muda. Karena apabila mereka sekali digairahkan oleh keberahian yang menceraikan mereka dari Kristus, mereka itu ingin kawin"
 },
 {
   "id": 29792,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 12,
   "firman": "dan dengan memungkiri kesetiaan mereka yang semula kepada-Nya, mereka mendatangkan hukuman atas dirinya."
 },
 {
   "id": 29793,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 13,
   "firman": "Lagipula dengan keluar masuk rumah orang, mereka membiasakan diri bermalas-malas dan bukan hanya bermalas-malas saja, tetapi juga meleter dan mencampuri soal orang lain dan mengatakan hal-hal yang tidak pantas."
 },
 {
   "id": 29794,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 14,
   "firman": "Karena itu aku mau supaya janda-janda yang muda kawin lagi, beroleh anak, memimpin rumah tangganya dan jangan memberi alasan kepada lawan untuk memburuk-burukkan nama kita."
 },
 {
   "id": 29795,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 15,
   "firman": "Karena beberapa janda telah tersesat mengikut Iblis."
 },
 {
   "id": 29796,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 16,
   "firman": "Jika seorang laki-laki atau perempuan yang percaya mempunyai anggota keluarga yang janda, hendaklah ia membantu mereka sehingga mereka jangan menjadi beban bagi jemaat. Dengan demikian jemaat dapat membantu mereka yang benar-benar janda."
 },
 {
   "id": 29797,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 17,
   "firman": "Penatua-penatua yang baik pimpinannya patut dihormati dua kali lipat, terutama mereka yang dengan jerih payah berkhotbah dan mengajar."
 },
 {
   "id": 29798,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 18,
   "firman": "Bukankah Kitab Suci berkata: \"Janganlah engkau memberangus mulut lembu yang sedang mengirik,\" dan lagi \"seorang pekerja patut mendapat upahnya.\""
 },
 {
   "id": 29799,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 19,
   "firman": "Janganlah engkau menerima tuduhan atas seorang penatua kecuali kalau didukung dua atau tiga orang saksi."
 },
 {
   "id": 29800,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 20,
   "firman": "Mereka yang berbuat dosa hendaklah kautegor di depan semua orang agar yang lain itupun takut."
 },
 {
   "id": 29801,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 21,
   "firman": "Di hadapan Allah dan Kristus Yesus dan malaikat-malaikat pilihan-Nya kupesankan dengan sungguh kepadamu: camkanlah petunjuk ini tanpa prasangka dan bertindaklah dalam segala sesuatu tanpa memihak."
 },
 {
   "id": 29802,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 22,
   "firman": "Janganlah engkau terburu-buru menumpangkan tangan atas seseorang dan janganlah terbawa-bawa ke dalam dosa orang lain. Jagalah kemurnian dirimu."
 },
 {
   "id": 29803,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 23,
   "firman": "Janganlah lagi minum air saja, melainkan tambahkanlah anggur sedikit, berhubung pencernaanmu terganggu dan tubuhmu sering lemah."
 },
 {
   "id": 29804,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 24,
   "firman": "Dosa beberapa orang menyolok, seakan-akan mendahului mereka ke pengadilan, tetapi dosa beberapa orang lagi baru menjadi nyata kemudian."
 },
 {
   "id": 29805,
   "kitab": "1Ti",
   "pasal": 5,
   "ayat": 25,
   "firman": "Demikianpun perbuatan baik itu segera nyata dan kalau tidak demikian, ia tidak dapat terus tinggal tersembunyi."
 },
 {
   "id": 29806,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 1,
   "firman": "Semua orang yang menanggung beban perbudakan hendaknya menganggap tuan mereka layak mendapat segala penghormatan, agar nama Allah dan ajaran kita jangan dihujat orang."
 },
 {
   "id": 29807,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 2,
   "firman": "Jika tuan mereka seorang percaya, janganlah ia kurang disegani karena bersaudara dalam Kristus, melainkan hendaklah ia dilayani mereka dengan lebih baik lagi, karena tuan yang menerima berkat pelayanan mereka ialah saudara yang percaya dan yang kekasih."
 },
 {
   "id": 29809,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 3,
   "firman": "Jika seorang mengajarkan ajaran lain dan tidak menurut perkataan sehat--yakni perkataan Tuhan kita Yesus Kristus--dan tidak menurut ajaran yang sesuai dengan ibadah kita,"
 },
 {
   "id": 29810,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 4,
   "firman": "ia adalah seorang yang berlagak tahu padahal tidak tahu apa-apa. Penyakitnya ialah mencari-cari soal dan bersilat kata, yang menyebabkan dengki, cidera, fitnah, curiga,"
 },
 {
   "id": 29811,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 5,
   "firman": "percekcokan antara orang-orang yang tidak lagi berpikiran sehat dan yang kehilangan kebenaran, yang mengira ibadah itu adalah suatu sumber keuntungan."
 },
 {
   "id": 29812,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 6,
   "firman": "Memang ibadah itu kalau disertai rasa cukup, memberi keuntungan besar."
 },
 {
   "id": 29813,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 7,
   "firman": "Sebab kita tidak membawa sesuatu apa ke dalam dunia dan kitapun tidak dapat membawa apa-apa ke luar."
 },
 {
   "id": 29814,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 8,
   "firman": "Asal ada makanan dan pakaian, cukuplah."
 },
 {
   "id": 29815,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi mereka yang ingin kaya terjatuh ke dalam pencobaan, ke dalam jerat dan ke dalam berbagai-bagai nafsu yang hampa dan yang mencelakakan, yang menenggelamkan manusia ke dalam keruntuhan dan kebinasaan."
 },
 {
   "id": 29816,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 10,
   "firman": "Karena akar segala kejahatan ialah cinta uang. Sebab oleh memburu uanglah beberapa orang telah menyimpang dari iman dan menyiksa dirinya dengan berbagai-bagai duka."
 },
 {
   "id": 29817,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 11,
   "firman": "Tetapi engkau hai manusia Allah, jauhilah semuanya itu, kejarlah keadilan, ibadah, kesetiaan, kasih, kesabaran dan kelembutan."
 },
 {
   "id": 29818,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 12,
   "firman": "Bertandinglah dalam pertandingan iman yang benar dan rebutlah hidup yang kekal. Untuk itulah engkau telah dipanggil dan telah engkau ikrarkan ikrar yang benar di depan banyak saksi."
 },
 {
   "id": 29819,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 13,
   "firman": "Di hadapan Allah yang memberikan hidup kepada segala sesuatu dan di hadapan Kristus Yesus yang telah mengikrarkan ikrar yang benar itu juga di muka Pontius Pilatus, kuserukan kepadamu:"
 },
 {
   "id": 29820,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 14,
   "firman": "Turutilah perintah ini, dengan tidak bercacat dan tidak bercela, hingga pada saat Tuhan kita Yesus Kristus menyatakan diri-Nya,"
 },
 {
   "id": 29821,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 15,
   "firman": "yaitu saat yang akan ditentukan oleh Penguasa yang satu-satunya dan yang penuh bahagia, Raja di atas segala raja dan Tuan di atas segala tuan."
 },
 {
   "id": 29822,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 16,
   "firman": "Dialah satu-satunya yang tidak takluk kepada maut, bersemayam dalam terang yang tak terhampiri. Seorangpun tak pernah melihat Dia dan memang manusia tidak dapat melihat Dia. Bagi-Nyalah hormat dan kuasa yang kekal! Amin."
 },
 {
   "id": 29823,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 17,
   "firman": "Peringatkanlah kepada orang-orang kaya di dunia ini agar mereka jangan tinggi hati dan jangan berharap pada sesuatu yang tak tentu seperti kekayaan, melainkan pada Allah yang dalam kekayaan-Nya memberikan kepada kita segala sesuatu untuk dinikmati."
 },
 {
   "id": 29824,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 18,
   "firman": "Peringatkanlah agar mereka itu berbuat baik, menjadi kaya dalam kebajikan, suka memberi dan membagi"
 },
 {
   "id": 29825,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 19,
   "firman": "dan dengan demikian mengumpulkan suatu harta sebagai dasar yang baik bagi dirinya di waktu yang akan datang untuk mencapai hidup yang sebenarnya."
 },
 {
   "id": 29826,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 20,
   "firman": "Hai Timotius, peliharalah apa yang telah dipercayakan kepadamu. Hindarilah omongan yang kosong dan yang tidak suci dan pertentangan-pertentangan yang berasal dari apa yang disebut pengetahuan,"
 },
 {
   "id": 29827,
   "kitab": "1Ti",
   "pasal": 6,
   "ayat": 21,
   "firman": "karena ada beberapa orang yang mengajarkannya dan dengan demikian telah menyimpang dari iman. Kasih karunia menyertai kamu!"
 },
 {
   "id": 29828,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, rasul Kristus Yesus oleh kehendak Allah untuk memberitakan janji tentang hidup dalam Kristus Yesus,"
 },
 {
   "id": 29829,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 2,
   "firman": "kepada Timotius, anakku yang kekasih: kasih karunia, rahmat dan damai sejahtera dari Allah Bapa dan Kristus Yesus, Tuhan kita, menyertai engkau."
 },
 {
   "id": 29830,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 3,
   "firman": "Aku mengucap syukur kepada Allah, yang kulayani dengan hati nurani yang murni seperti yang dilakukan nenek moyangku. Dan selalu aku mengingat engkau dalam permohonanku, baik siang maupun malam."
 },
 {
   "id": 29831,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan apabila aku terkenang akan air matamu yang kaucurahkan, aku ingin melihat engkau kembali supaya penuhlah kesukaanku."
 },
 {
   "id": 29832,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 5,
   "firman": "Sebab aku teringat akan imanmu yang tulus ikhlas, yaitu iman yang pertama-tama hidup di dalam nenekmu Lois dan di dalam ibumu Eunike dan yang aku yakin hidup juga di dalam dirimu."
 },
 {
   "id": 29833,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 6,
   "firman": "Karena itulah kuperingatkan engkau untuk mengobarkan karunia Allah yang ada padamu oleh penumpangan tanganku atasmu."
 },
 {
   "id": 29834,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sebab Allah memberikan kepada kita bukan roh ketakutan, melainkan roh yang membangkitkan kekuatan, kasih dan ketertiban."
 },
 {
   "id": 29835,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 8,
   "firman": "Jadi janganlah malu bersaksi tentang Tuhan kita dan janganlah malu karena aku, seorang hukuman karena Dia, melainkan ikutlah menderita bagi Injil-Nya oleh kekuatan Allah."
 },
 {
   "id": 29836,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 9,
   "firman": "Dialah yang menyelamatkan kita dan memanggil kita dengan panggilan kudus, bukan berdasarkan perbuatan kita, melainkan berdasarkan maksud dan kasih karunia-Nya sendiri, yang telah dikaruniakan kepada kita dalam Kristus Yesus sebelum permulaan zaman"
 },
 {
   "id": 29837,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 10,
   "firman": "dan yang sekarang dinyatakan oleh kedatangan Juruselamat kita Yesus Kristus, yang oleh Injil telah mematahkan kuasa maut dan mendatangkan hidup yang tidak dapat binasa."
 },
 {
   "id": 29838,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 11,
   "firman": "Untuk Injil inilah aku telah ditetapkan sebagai pemberita, sebagai rasul dan sebagai guru."
 },
 {
   "id": 29839,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 12,
   "firman": "Itulah sebabnya aku menderita semuanya ini, tetapi aku tidak malu; karena aku tahu kepada siapa aku percaya dan aku yakin bahwa Dia berkuasa memeliharakan apa yang telah dipercayakan-Nya kepadaku hingga pada hari Tuhan."
 },
 {
   "id": 29840,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 13,
   "firman": "Peganglah segala sesuatu yang telah engkau dengar dari padaku sebagai contoh ajaran yang sehat dan lakukanlah itu dalam iman dan kasih dalam Kristus Yesus."
 },
 {
   "id": 29841,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 14,
   "firman": "Peliharalah harta yang indah, yang telah dipercayakan-Nya kepada kita, oleh Roh Kudus yang diam di dalam kita."
 },
 {
   "id": 29842,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 15,
   "firman": "Engkau tahu bahwa semua mereka yang di daerah Asia Kecil berpaling dari padaku; termasuk Figelus dan Hermogenes."
 },
 {
   "id": 29843,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 16,
   "firman": "Tuhan kiranya mengaruniakan rahmat-Nya kepada keluarga Onesiforus yang telah berulang-ulang menyegarkan hatiku. Ia tidak malu menjumpai aku di dalam penjara."
 },
 {
   "id": 29844,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 17,
   "firman": "Ketika di Roma, ia berusaha mencari aku dan sudah juga menemui aku."
 },
 {
   "id": 29845,
   "kitab": "2Ti",
   "pasal": 1,
   "ayat": 18,
   "firman": "Kiranya Tuhan menunjukkan rahmat-Nya kepadanya pada hari-Nya. Betapa banyaknya pelayanan yang ia lakukan di Efesus engkau lebih mengetahuinya dari padaku."
 },
 {
   "id": 29846,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 1,
   "firman": "Sebab itu, hai anakku, jadilah kuat oleh kasih karunia dalam Kristus Yesus."
 },
 {
   "id": 29847,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 2,
   "firman": "Apa yang telah engkau dengar dari padaku di depan banyak saksi, percayakanlah itu kepada orang-orang yang dapat dipercayai, yang juga cakap mengajar orang lain."
 },
 {
   "id": 29848,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 3,
   "firman": "Ikutlah menderita sebagai seorang prajurit yang baik dari Kristus Yesus."
 },
 {
   "id": 29849,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 4,
   "firman": "Seorang prajurit yang sedang berjuang tidak memusingkan dirinya dengan soal-soal penghidupannya, supaya dengan demikian ia berkenan kepada komandannya."
 },
 {
   "id": 29850,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 5,
   "firman": "Seorang olahragawan hanya dapat memperoleh mahkota sebagai juara, apabila ia bertanding menurut peraturan-peraturan olahraga."
 },
 {
   "id": 29851,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 6,
   "firman": "Seorang petani yang bekerja keras haruslah yang pertama menikmati hasil usahanya."
 },
 {
   "id": 29852,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 7,
   "firman": "Perhatikanlah apa yang kukatakan; Tuhan akan memberi kepadamu pengertian dalam segala sesuatu."
 },
 {
   "id": 29853,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 8,
   "firman": "Ingatlah ini: Yesus Kristus, yang telah bangkit dari antara orang mati, yang telah dilahirkan sebagai keturunan Daud, itulah yang kuberitakan dalam Injilku."
 },
 {
   "id": 29854,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 9,
   "firman": "Karena pemberitaan Injil inilah aku menderita, malah dibelenggu seperti seorang penjahat, tetapi firman Allah tidak terbelenggu."
 },
 {
   "id": 29855,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 10,
   "firman": "Karena itu aku sabar menanggung semuanya itu bagi orang-orang pilihan Allah, supaya mereka juga mendapat keselamatan dalam Kristus Yesus dengan kemuliaan yang kekal."
 },
 {
   "id": 29856,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 11,
   "firman": "Benarlah perkataan ini: \"Jika kita mati dengan Dia, kitapun akan hidup dengan Dia;"
 },
 {
   "id": 29857,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 12,
   "firman": "jika kita bertekun, kitapun akan ikut memerintah dengan Dia; jika kita menyangkal Dia, Diapun akan menyangkal kita;"
 },
 {
   "id": 29858,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 13,
   "firman": "jika kita tidak setia, Dia tetap setia, karena Dia tidak dapat menyangkal diri-Nya.\""
 },
 {
   "id": 29859,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 14,
   "firman": "Ingatkanlah dan pesankanlah semuanya itu dengan sungguh-sungguh kepada mereka di hadapan Allah, agar jangan mereka bersilat kata, karena hal itu sama sekali tidak berguna, malah mengacaukan orang yang mendengarnya."
 },
 {
   "id": 29860,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 15,
   "firman": "Usahakanlah supaya engkau layak di hadapan Allah sebagai seorang pekerja yang tidak usah malu, yang berterus terang memberitakan perkataan kebenaran itu."
 },
 {
   "id": 29861,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 16,
   "firman": "Tetapi hindarilah omongan yang kosong dan yang tak suci yang hanya menambah kefasikan."
 },
 {
   "id": 29862,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 17,
   "firman": "Perkataan mereka menjalar seperti penyakit kanker. Di antara mereka termasuk Himeneus dan Filetus,"
 },
 {
   "id": 29863,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 18,
   "firman": "yang telah menyimpang dari kebenaran dengan mengajarkan bahwa kebangkitan kita telah berlangsung dan dengan demikian merusak iman sebagian orang."
 },
 {
   "id": 29864,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 19,
   "firman": "Tetapi dasar yang diletakkan Allah itu teguh dan meterainya ialah: \"Tuhan mengenal siapa kepunyaan-Nya\" dan \"Setiap orang yang menyebut nama Tuhan hendaklah meninggalkan kejahatan.\""
 },
 {
   "id": 29865,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 20,
   "firman": "Dalam rumah yang besar bukan hanya terdapat perabot dari emas dan perak, melainkan juga dari kayu dan tanah; yang pertama dipakai untuk maksud yang mulia dan yang terakhir untuk maksud yang kurang mulia."
 },
 {
   "id": 29866,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 21,
   "firman": "Jika seorang menyucikan dirinya dari hal-hal yang jahat, ia akan menjadi perabot rumah untuk maksud yang mulia, ia dikuduskan, dipandang layak untuk dipakai tuannya dan disediakan untuk setiap pekerjaan yang mulia."
 },
 {
   "id": 29867,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 22,
   "firman": "Sebab itu jauhilah nafsu orang muda, kejarlah keadilan, kesetiaan, kasih dan damai bersama-sama dengan mereka yang berseru kepada Tuhan dengan hati yang murni."
 },
 {
   "id": 29868,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 23,
   "firman": "Hindarilah soal-soal yang dicari-cari, yang bodoh dan tidak layak. Engkau tahu bahwa soal-soal itu menimbulkan pertengkaran,"
 },
 {
   "id": 29869,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 24,
   "firman": "sedangkan seorang hamba Tuhan tidak boleh bertengkar, tetapi harus ramah terhadap semua orang. Ia harus cakap mengajar, sabar"
 },
 {
   "id": 29870,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 25,
   "firman": "dan dengan lemah lembut dapat menuntun orang yang suka melawan, sebab mungkin Tuhan memberikan kesempatan kepada mereka untuk bertobat dan memimpin mereka sehingga mereka mengenal kebenaran,"
 },
 {
   "id": 29871,
   "kitab": "2Ti",
   "pasal": 2,
   "ayat": 26,
   "firman": "dan dengan demikian mereka menjadi sadar kembali, karena terlepas dari jerat Iblis yang telah mengikat mereka pada kehendaknya."
 },
 {
   "id": 29872,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 1,
   "firman": "Ketahuilah bahwa pada hari-hari terakhir akan datang masa yang sukar."
 },
 {
   "id": 29873,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 2,
   "firman": "Manusia akan mencintai dirinya sendiri dan menjadi hamba uang. Mereka akan membual dan menyombongkan diri, mereka akan menjadi pemfitnah, mereka akan berontak terhadap orang tua dan tidak tahu berterima kasih, tidak mempedulikan agama,"
 },
 {
   "id": 29874,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 3,
   "firman": "tidak tahu mengasihi, tidak mau berdamai, suka menjelekkan orang, tidak dapat mengekang diri, garang, tidak suka yang baik,"
 },
 {
   "id": 29875,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 4,
   "firman": "suka mengkhianat, tidak berpikir panjang, berlagak tahu, lebih menuruti hawa nafsu dari pada menuruti Allah."
 },
 {
   "id": 29876,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 5,
   "firman": "Secara lahiriah mereka menjalankan ibadah mereka, tetapi pada hakekatnya mereka memungkiri kekuatannya. Jauhilah mereka itu!"
 },
 {
   "id": 29877,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 6,
   "firman": "Sebab di antara mereka terdapat orang-orang yang menyelundup ke rumah orang lain dan menjerat perempuan-perempuan lemah yang sarat dengan dosa dan dikuasai oleh berbagai-bagai nafsu,"
 },
 {
   "id": 29878,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 7,
   "firman": "yang walaupun selalu ingin diajar, namun tidak pernah dapat mengenal kebenaran."
 },
 {
   "id": 29879,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 8,
   "firman": "Sama seperti Yanes dan Yambres menentang Musa, demikian juga mereka menentang kebenaran. Akal mereka bobrok dan iman mereka tidak tahan uji."
 },
 {
   "id": 29880,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 9,
   "firman": "Tetapi sudah pasti mereka tidak akan lebih maju, karena seperti dalam hal Yanes dan Yambres, kebodohan merekapun akan nyata bagi semua orang."
 },
 {
   "id": 29881,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tetapi engkau telah mengikuti ajaranku, cara hidupku, pendirianku, imanku, kesabaranku, kasihku dan ketekunanku."
 },
 {
   "id": 29882,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 11,
   "firman": "Engkau telah ikut menderita penganiayaan dan sengsara seperti yang telah kuderita di Antiokhia dan di Ikonium dan di Listra. Semua penganiayaan itu kuderita dan Tuhan telah melepaskan aku dari padanya."
 },
 {
   "id": 29883,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 12,
   "firman": "Memang setiap orang yang mau hidup beribadah di dalam Kristus Yesus akan menderita aniaya,"
 },
 {
   "id": 29884,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 13,
   "firman": "sedangkan orang jahat dan penipu akan bertambah jahat, mereka menyesatkan dan disesatkan."
 },
 {
   "id": 29885,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 14,
   "firman": "Tetapi hendaklah engkau tetap berpegang pada kebenaran yang telah engkau terima dan engkau yakini, dengan selalu mengingat orang yang telah mengajarkannya kepadamu."
 },
 {
   "id": 29886,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 15,
   "firman": "Ingatlah juga bahwa dari kecil engkau sudah mengenal Kitab Suci yang dapat memberi hikmat kepadamu dan menuntun engkau kepada keselamatan oleh iman kepada Kristus Yesus."
 },
 {
   "id": 29887,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 16,
   "firman": "Segala tulisan yang diilhamkan Allah memang bermanfaat untuk mengajar, untuk menyatakan kesalahan, untuk memperbaiki kelakuan dan untuk mendidik orang dalam kebenaran."
 },
 {
   "id": 29888,
   "kitab": "2Ti",
   "pasal": 3,
   "ayat": 17,
   "firman": "Dengan demikian tiap-tiap manusia kepunyaan Allah diperlengkapi untuk setiap perbuatan baik."
 },
 {
   "id": 29889,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 1,
   "firman": "Di hadapan Allah dan Kristus Yesus yang akan menghakimi orang yang hidup dan yang mati, aku berpesan dengan sungguh-sungguh kepadamu demi penyataan-Nya dan demi Kerajaan-Nya:"
 },
 {
   "id": 29890,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 2,
   "firman": "Beritakanlah firman, siap sedialah baik atau tidak baik waktunya, nyatakanlah apa yang salah, tegorlah dan nasihatilah dengan segala kesabaran dan pengajaran."
 },
 {
   "id": 29891,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 3,
   "firman": "Karena akan datang waktunya, orang tidak dapat lagi menerima ajaran sehat, tetapi mereka akan mengumpulkan guru-guru menurut kehendaknya untuk memuaskan keinginan telinganya."
 },
 {
   "id": 29892,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 4,
   "firman": "Mereka akan memalingkan telinganya dari kebenaran dan membukanya bagi dongeng."
 },
 {
   "id": 29893,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 5,
   "firman": "Tetapi kuasailah dirimu dalam segala hal, sabarlah menderita, lakukanlah pekerjaan pemberita Injil dan tunaikanlah tugas pelayananmu!"
 },
 {
   "id": 29894,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 6,
   "firman": "Mengenai diriku, darahku sudah mulai dicurahkan sebagai persembahan dan saat kematianku sudah dekat."
 },
 {
   "id": 29895,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 7,
   "firman": "Aku telah mengakhiri pertandingan yang baik, aku telah mencapai garis akhir dan aku telah memelihara iman."
 },
 {
   "id": 29896,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 8,
   "firman": "Sekarang telah tersedia bagiku mahkota kebenaran yang akan dikaruniakan kepadaku oleh Tuhan, Hakim yang adil, pada hari-Nya; tetapi bukan hanya kepadaku, melainkan juga kepada semua orang yang merindukan kedatangan-Nya."
 },
 {
   "id": 29897,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 9,
   "firman": "Berusahalah supaya segera datang kepadaku,"
 },
 {
   "id": 29898,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 10,
   "firman": "karena Demas telah mencintai dunia ini dan meninggalkan aku. Ia telah berangkat ke Tesalonika. Kreskes telah pergi ke Galatia dan Titus ke Dalmatia."
 },
 {
   "id": 29899,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 11,
   "firman": "Hanya Lukas yang tinggal dengan aku. Jemputlah Markus dan bawalah ia ke mari, karena pelayanannya penting bagiku."
 },
 {
   "id": 29900,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 12,
   "firman": "Tikhikus telah kukirim ke Efesus."
 },
 {
   "id": 29901,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 13,
   "firman": "Jika engkau ke mari bawa juga jubah yang kutinggalkan di Troas di rumah Karpus dan juga kitab-kitabku, terutama perkamen itu."
 },
 {
   "id": 29902,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 14,
   "firman": "Aleksander, tukang tembaga itu, telah banyak berbuat kejahatan terhadap aku. Tuhan akan membalasnya menurut perbuatannya."
 },
 {
   "id": 29903,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 15,
   "firman": "Hendaklah engkau juga waspada terhadap dia, karena dia sangat menentang ajaran kita."
 },
 {
   "id": 29904,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 16,
   "firman": "Pada waktu pembelaanku yang pertama tidak seorangpun yang membantu aku, semuanya meninggalkan aku--kiranya hal itu jangan ditanggungkan atas mereka--,"
 },
 {
   "id": 29905,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 17,
   "firman": "tetapi Tuhan telah mendampingi aku dan menguatkan aku, supaya dengan perantaraanku Injil diberitakan dengan sepenuhnya dan semua orang bukan Yahudi mendengarkannya. Dengan demikian aku lepas dari mulut singa."
 },
 {
   "id": 29906,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 18,
   "firman": "Dan Tuhan akan melepaskan aku dari setiap usaha yang jahat. Dia akan menyelamatkan aku, sehingga aku masuk ke dalam Kerajaan-Nya di sorga. Bagi-Nyalah kemuliaan selama-lamanya! Amin."
 },
 {
   "id": 29907,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 19,
   "firman": "Salam kepada Priska dan Akwila dan kepada keluarga Onesiforus."
 },
 {
   "id": 29908,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 20,
   "firman": "Erastus tinggal di Korintus dan Trofimus kutinggalkan dalam keadaan sakit di Miletus."
 },
 {
   "id": 29909,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 21,
   "firman": "Berusahalah ke mari sebelum musim dingin. Salam dari Ebulus dan Pudes dan Linus dan Klaudia dan dari semua saudara."
 },
 {
   "id": 29910,
   "kitab": "2Ti",
   "pasal": 4,
   "ayat": 22,
   "firman": "Tuhan menyertai rohmu. Kasih karunia-Nya menyertai kamu!"
 },
 {
   "id": 29911,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, hamba Allah dan rasul Yesus Kristus untuk memelihara iman orang-orang pilihan Allah dan pengetahuan akan kebenaran seperti yang nampak dalam ibadah kita,"
 },
 {
   "id": 29912,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 2,
   "firman": "dan berdasarkan pengharapan akan hidup yang kekal yang sebelum permulaan zaman sudah dijanjikan oleh Allah yang tidak berdusta,"
 },
 {
   "id": 29913,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 3,
   "firman": "dan yang pada waktu yang dikehendaki-Nya telah menyatakan firman-Nya dalam pemberitaan Injil yang telah dipercayakan kepadaku sesuai dengan perintah Allah, Juruselamat kita."
 },
 {
   "id": 29914,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 4,
   "firman": "Kepada Titus, anakku yang sah menurut iman kita bersama: kasih karunia dan damai sejahtera dari Allah Bapa dan Kristus Yesus, Juruselamat kita, menyertai engkau."
 },
 {
   "id": 29915,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 5,
   "firman": "Aku telah meninggalkan engkau di Kreta dengan maksud ini, supaya engkau mengatur apa yang masih perlu diatur dan supaya engkau menetapkan penatua-penatua di setiap kota, seperti yang telah kupesankan kepadamu,"
 },
 {
   "id": 29916,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 6,
   "firman": "yakni orang-orang yang tak bercacat, yang mempunyai hanya satu isteri, yang anak-anaknya hidup beriman dan tidak dapat dituduh karena hidup tidak senonoh atau hidup tidak tertib."
 },
 {
   "id": 29917,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sebab sebagai pengatur rumah Allah seorang penilik jemaat harus tidak bercacat, tidak angkuh, bukan pemberang, bukan peminum, bukan pemarah, tidak serakah,"
 },
 {
   "id": 29918,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 8,
   "firman": "melainkan suka memberi tumpangan, suka akan yang baik, bijaksana, adil, saleh, dapat menguasai diri"
 },
 {
   "id": 29919,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 9,
   "firman": "dan berpegang kepada perkataan yang benar, yang sesuai dengan ajaran yang sehat, supaya ia sanggup menasihati orang berdasarkan ajaran itu dan sanggup meyakinkan penentang-penentangnya."
 },
 {
   "id": 29920,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 10,
   "firman": "Karena sudah banyak orang hidup tidak tertib, terutama di antara mereka yang berpegang pada hukum sunat. Dengan omongan yang sia-sia mereka menyesatkan pikiran."
 },
 {
   "id": 29921,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 11,
   "firman": "Orang-orang semacam itu harus ditutup mulutnya, karena mereka mengacau banyak keluarga dengan mengajarkan yang tidak-tidak untuk mendapat untung yang memalukan."
 },
 {
   "id": 29922,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 12,
   "firman": "Seorang dari kalangan mereka, nabi mereka sendiri, pernah berkata: \"Dasar orang Kreta pembohong, binatang buas, pelahap yang malas.\""
 },
 {
   "id": 29923,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 13,
   "firman": "Kesaksian itu benar. Karena itu tegorlah mereka dengan tegas supaya mereka menjadi sehat dalam iman,"
 },
 {
   "id": 29924,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 14,
   "firman": "dan tidak lagi mengindahkan dongeng-dongeng Yahudi dan hukum-hukum manusia yang berpaling dari kebenaran."
 },
 {
   "id": 29925,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 15,
   "firman": "Bagi orang suci semuanya suci; tetapi bagi orang najis dan bagi orang tidak beriman suatupun tidak ada yang suci, karena baik akal maupun suara hati mereka najis."
 },
 {
   "id": 29926,
   "kitab": "Tit",
   "pasal": 1,
   "ayat": 16,
   "firman": "Mereka mengaku mengenal Allah, tetapi dengan perbuatan mereka, mereka menyangkal Dia. Mereka keji dan durhaka dan tidak sanggup berbuat sesuatu yang baik."
 },
 {
   "id": 29927,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 1,
   "firman": "Tetapi engkau, beritakanlah apa yang sesuai dengan ajaran yang sehat:"
 },
 {
   "id": 29928,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 2,
   "firman": "Laki-laki yang tua hendaklah hidup sederhana, terhormat, bijaksana, sehat dalam iman, dalam kasih dan dalam ketekunan."
 },
 {
   "id": 29929,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 3,
   "firman": "Demikian juga perempuan-perempuan yang tua, hendaklah mereka hidup sebagai orang-orang beribadah, jangan memfitnah, jangan menjadi hamba anggur, tetapi cakap mengajarkan hal-hal yang baik"
 },
 {
   "id": 29930,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 4,
   "firman": "dan dengan demikian mendidik perempuan-perempuan muda mengasihi suami dan anak-anaknya,"
 },
 {
   "id": 29931,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 5,
   "firman": "hidup bijaksana dan suci, rajin mengatur rumah tangganya, baik hati dan taat kepada suaminya, agar Firman Allah jangan dihujat orang."
 },
 {
   "id": 29932,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 6,
   "firman": "Demikian juga orang-orang muda; nasihatilah mereka supaya mereka menguasai diri dalam segala hal"
 },
 {
   "id": 29933,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 7,
   "firman": "dan jadikanlah dirimu sendiri suatu teladan dalam berbuat baik. Hendaklah engkau jujur dan bersungguh-sungguh dalam pengajaranmu,"
 },
 {
   "id": 29934,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 8,
   "firman": "sehat dan tidak bercela dalam pemberitaanmu sehingga lawan menjadi malu, karena tidak ada hal-hal buruk yang dapat mereka sebarkan tentang kita."
 },
 {
   "id": 29935,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 9,
   "firman": "Hamba-hamba hendaklah taat kepada tuannya dalam segala hal dan berkenan kepada mereka, jangan membantah,"
 },
 {
   "id": 29936,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 10,
   "firman": "jangan curang, tetapi hendaklah selalu tulus dan setia, supaya dengan demikian mereka dalam segala hal memuliakan ajaran Allah, Juruselamat kita."
 },
 {
   "id": 29937,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 11,
   "firman": "Karena kasih karunia Allah yang menyelamatkan semua manusia sudah nyata."
 },
 {
   "id": 29938,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 12,
   "firman": "Ia mendidik kita supaya kita meninggalkan kefasikan dan keinginan-keinginan duniawi dan supaya kita hidup bijaksana, adil dan beribadah di dalam dunia sekarang ini"
 },
 {
   "id": 29939,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 13,
   "firman": "dengan menantikan penggenapan pengharapan kita yang penuh bahagia dan penyataan kemuliaan Allah yang Mahabesar dan Juruselamat kita Yesus Kristus,"
 },
 {
   "id": 29940,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 14,
   "firman": "yang telah menyerahkan diri-Nya bagi kita untuk membebaskan kita dari segala kejahatan dan untuk menguduskan bagi diri-Nya suatu umat, kepunyaan-Nya sendiri, yang rajin berbuat baik."
 },
 {
   "id": 29941,
   "kitab": "Tit",
   "pasal": 2,
   "ayat": 15,
   "firman": "Beritakanlah semuanya itu, nasihatilah dan yakinkanlah orang dengan segala kewibawaanmu. Janganlah ada orang yang menganggap engkau rendah."
 },
 {
   "id": 29942,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 1,
   "firman": "Ingatkanlah mereka supaya mereka tunduk pada pemerintah dan orang-orang yang berkuasa, taat dan siap untuk melakukan setiap pekerjaan yang baik."
 },
 {
   "id": 29943,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 2,
   "firman": "Janganlah mereka memfitnah, janganlah mereka bertengkar, hendaklah mereka selalu ramah dan bersikap lemah lembut terhadap semua orang."
 },
 {
   "id": 29944,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 3,
   "firman": "Karena dahulu kita juga hidup dalam kejahilan: tidak taat, sesat, menjadi hamba berbagai-bagai nafsu dan keinginan, hidup dalam kejahatan dan kedengkian, keji, saling membenci."
 },
 {
   "id": 29945,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 4,
   "firman": "Tetapi ketika nyata kemurahan Allah, Juruselamat kita, dan kasih-Nya kepada manusia,"
 },
 {
   "id": 29946,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 5,
   "firman": "pada waktu itu Dia telah menyelamatkan kita, bukan karena perbuatan baik yang telah kita lakukan, tetapi karena rahmat-Nya oleh permandian kelahiran kembali dan oleh pembaharuan yang dikerjakan oleh Roh Kudus,"
 },
 {
   "id": 29947,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 6,
   "firman": "yang sudah dilimpahkan-Nya kepada kita oleh Yesus Kristus, Juruselamat kita,"
 },
 {
   "id": 29948,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 7,
   "firman": "supaya kita, sebagai orang yang dibenarkan oleh kasih karunia-Nya, berhak menerima hidup yang kekal, sesuai dengan pengharapan kita."
 },
 {
   "id": 29949,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 8,
   "firman": "Perkataan ini benar dan aku mau supaya engkau dengan yakin menguatkannya, agar mereka yang sudah percaya kepada Allah sungguh-sungguh berusaha melakukan pekerjaan yang baik. Itulah yang baik dan berguna bagi manusia."
 },
 {
   "id": 29950,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 9,
   "firman": "Tetapi hindarilah persoalan yang dicari-cari dan yang bodoh, persoalan silsilah, percekcokan dan pertengkaran mengenai hukum Taurat, karena semua itu tidak berguna dan sia-sia belaka."
 },
 {
   "id": 29951,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 10,
   "firman": "Seorang bidat yang sudah satu dua kali kaunasihati, hendaklah engkau jauhi."
 },
 {
   "id": 29952,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 11,
   "firman": "Engkau tahu bahwa orang yang semacam itu benar-benar sesat dan dengan dosanya menghukum dirinya sendiri."
 },
 {
   "id": 29953,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 12,
   "firman": "Segera sesudah kukirim Artemas atau Tikhikus kepadamu, berusahalah datang kepadaku di Nikopolis, karena sudah kuputuskan untuk tinggal di tempat itu selama musim dingin ini."
 },
 {
   "id": 29954,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tolonglah sebaik-baiknya Zenas, ahli Taurat itu, dan Apolos, dalam perjalanan mereka, agar mereka jangan kekurangan sesuatu apa."
 },
 {
   "id": 29955,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 14,
   "firman": "Dan biarlah orang-orang kita juga belajar melakukan pekerjaan yang baik untuk dapat memenuhi keperluan hidup yang pokok, supaya hidup mereka jangan tidak berbuah."
 },
 {
   "id": 29956,
   "kitab": "Tit",
   "pasal": 3,
   "ayat": 15,
   "firman": "Salam dari semua orang yang bersama aku di sini dan sampaikanlah salamku kepada mereka yang mengasihi kami di dalam iman. Kasih karunia menyertai kamu sekalian!"
 },
 {
   "id": 29957,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Paulus, seorang hukuman karena Kristus Yesus dan dari Timotius saudara kita, kepada Filemon yang kekasih, teman sekerja kami"
 },
 {
   "id": 29958,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 2,
   "firman": "dan kepada Apfia saudara perempuan kita dan kepada Arkhipus, teman seperjuangan kita dan kepada jemaat di rumahmu:"
 },
 {
   "id": 29959,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kasih karunia dan damai sejahtera dari Allah, Bapa kita dan dari Tuhan Yesus Kristus menyertai kamu."
 },
 {
   "id": 29960,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 4,
   "firman": "Aku mengucap syukur kepada Allahku, setiap kali aku mengingat engkau dalam doaku,"
 },
 {
   "id": 29961,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 5,
   "firman": "karena aku mendengar tentang kasihmu kepada semua orang kudus dan tentang imanmu kepada Tuhan Yesus."
 },
 {
   "id": 29962,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan aku berdoa, agar persekutuanmu di dalam iman turut mengerjakan pengetahuan akan yang baik di antara kita untuk Kristus."
 },
 {
   "id": 29963,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 7,
   "firman": "Dari kasihmu sudah kuperoleh kegembiraan besar dan kekuatan, sebab hati orang-orang kudus telah kauhiburkan, saudaraku."
 },
 {
   "id": 29964,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 8,
   "firman": "Karena itu, sekalipun di dalam Kristus aku mempunyai kebebasan penuh untuk memerintahkan kepadamu apa yang harus engkau lakukan,"
 },
 {
   "id": 29965,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 9,
   "firman": "tetapi mengingat kasihmu itu, lebih baik aku memintanya dari padamu. Aku, Paulus, yang sudah menjadi tua, lagipula sekarang dipenjarakan karena Kristus Yesus,"
 },
 {
   "id": 29966,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 10,
   "firman": "mengajukan permintaan kepadamu mengenai anakku yang kudapat selagi aku dalam penjara, yakni Onesimus"
 },
 {
   "id": 29967,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 11,
   "firman": "--dahulu memang dia tidak berguna bagimu, tetapi sekarang sangat berguna baik bagimu maupun bagiku."
 },
 {
   "id": 29968,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 12,
   "firman": "Dia kusuruh kembali kepadamu--dia, yaitu buah hatiku--."
 },
 {
   "id": 29969,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 13,
   "firman": "Sebenarnya aku mau menahan dia di sini sebagai gantimu untuk melayani aku selama aku dipenjarakan karena Injil,"
 },
 {
   "id": 29970,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 14,
   "firman": "tetapi tanpa persetujuanmu, aku tidak mau berbuat sesuatu, supaya yang baik itu jangan engkau lakukan seolah-olah dengan paksa, melainkan dengan sukarela."
 },
 {
   "id": 29971,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 15,
   "firman": "Sebab mungkin karena itulah dia dipisahkan sejenak dari padamu, supaya engkau dapat menerimanya untuk selama-lamanya,"
 },
 {
   "id": 29972,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 16,
   "firman": "bukan lagi sebagai hamba, melainkan lebih dari pada hamba, yaitu sebagai saudara yang kekasih, bagiku sudah demikian, apalagi bagimu, baik secara manusia maupun di dalam Tuhan."
 },
 {
   "id": 29973,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 17,
   "firman": "Kalau engkau menganggap aku temanmu seiman, terimalah dia seperti aku sendiri."
 },
 {
   "id": 29974,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 18,
   "firman": "Dan kalau dia sudah merugikan engkau ataupun berhutang padamu, tanggungkanlah semuanya itu kepadaku--"
 },
 {
   "id": 29975,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 19,
   "firman": "aku, Paulus, menjaminnya dengan tulisan tanganku sendiri: Aku akan membayarnya--agar jangan kukatakan: \"Tanggungkanlah semuanya itu kepadamu!\" --karena engkau berhutang padaku, yaitu dirimu sendiri."
 },
 {
   "id": 29976,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ya saudaraku, semoga engkau berguna bagiku di dalam Tuhan: Hiburkanlah hatiku di dalam Kristus!"
 },
 {
   "id": 29977,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 21,
   "firman": "Dengan percaya kepada ketaatanmu, kutuliskan ini kepadamu. Aku tahu, lebih dari pada permintaanku ini akan kaulakukan."
 },
 {
   "id": 29978,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 22,
   "firman": "Dalam pada itu bersedialah juga memberi tumpangan kepadaku, karena aku harap oleh doamu aku akan dikembalikan kepadamu."
 },
 {
   "id": 29979,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 23,
   "firman": "Salam kepadamu dari Epafras, temanku sepenjara karena Kristus Yesus,"
 },
 {
   "id": 29980,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 24,
   "firman": "dan dari Markus, Aristarkhus, Demas dan Lukas, teman-teman sekerjaku."
 },
 {
   "id": 29981,
   "kitab": "Flm",
   "pasal": 1,
   "ayat": 25,
   "firman": "Kasih karunia Tuhan Yesus Kristus menyertai roh kamu!"
 },
 {
   "id": 29982,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 1,
   "firman": "Setelah pada zaman dahulu Allah berulang kali dan dalam pelbagai cara berbicara kepada nenek moyang kita dengan perantaraan nabi-nabi,"
 },
 {
   "id": 29983,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 2,
   "firman": "maka pada zaman akhir ini Ia telah berbicara kepada kita dengan perantaraan Anak-Nya, yang telah Ia tetapkan sebagai yang berhak menerima segala yang ada. Oleh Dia Allah telah menjadikan alam semesta."
 },
 {
   "id": 29984,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 3,
   "firman": "Ia adalah cahaya kemuliaan Allah dan gambar wujud Allah dan menopang segala yang ada dengan firman-Nya yang penuh kekuasaan. Dan setelah Ia selesai mengadakan penyucian dosa, Ia duduk di sebelah kanan Yang Mahabesar, di tempat yang tinggi,"
 },
 {
   "id": 29985,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 4,
   "firman": "jauh lebih tinggi dari pada malaikat-malaikat, sama seperti nama yang dikaruniakan kepada-Nya jauh lebih indah dari pada nama mereka."
 },
 {
   "id": 29986,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 5,
   "firman": "Karena kepada siapakah di antara malaikat-malaikat itu pernah Ia katakan: \"Anak-Ku Engkau! Engkau telah Kuperanakkan pada hari ini?\" dan \"Aku akan menjadi Bapa-Nya, dan Ia akan menjadi Anak-Ku?\""
 },
 {
   "id": 29987,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan ketika Ia membawa pula Anak-Nya yang sulung ke dunia, Ia berkata: \"Semua malaikat Allah harus menyembah Dia.\""
 },
 {
   "id": 29988,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 7,
   "firman": "Dan tentang malaikat-malaikat Ia berkata: \"Yang membuat malaikat-malaikat-Nya menjadi badai dan pelayan-pelayan-Nya menjadi nyala api.\""
 },
 {
   "id": 29989,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 8,
   "firman": "Tetapi tentang Anak Ia berkata: \"Takhta-Mu, ya Allah, tetap untuk seterusnya dan selamanya, dan tongkat kerajaan-Mu adalah tongkat kebenaran."
 },
 {
   "id": 29990,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 9,
   "firman": "Engkau mencintai keadilan dan membenci kefasikan; sebab itu Allah, Allah-Mu telah mengurapi Engkau dengan minyak sebagai tanda kesukaan, melebihi teman-teman sekutu-Mu.\""
 },
 {
   "id": 29991,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 10,
   "firman": "Dan: \"Pada mulanya, ya Tuhan, Engkau telah meletakkan dasar bumi, dan langit adalah buatan tangan-Mu."
 },
 {
   "id": 29992,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 11,
   "firman": "Semuanya itu akan binasa, tetapi Engkau tetap ada, dan semuanya itu akan menjadi usang seperti pakaian;"
 },
 {
   "id": 29993,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 12,
   "firman": "seperti jubah akan Engkau gulungkan mereka, dan seperti persalinan mereka akan diubah, tetapi Engkau tetap sama, dan tahun-tahun-Mu tidak berkesudahan.\""
 },
 {
   "id": 29994,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 13,
   "firman": "Dan kepada siapakah di antara malaikat itu pernah Ia berkata: \"Duduklah di sebelah kanan-Ku, sampai Kubuat musuh-musuh-Mu menjadi tumpuan kaki-Mu?\""
 },
 {
   "id": 29995,
   "kitab": "Ibr",
   "pasal": 1,
   "ayat": 14,
   "firman": "Bukankah mereka semua adalah roh-roh yang melayani, yang diutus untuk melayani mereka yang harus memperoleh keselamatan?"
 },
 {
   "id": 29996,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 1,
   "firman": "Karena itu harus lebih teliti kita memperhatikan apa yang telah kita dengar, supaya kita jangan hanyut dibawa arus."
 },
 {
   "id": 29997,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sebab kalau firman yang dikatakan dengan perantaraan malaikat-malaikat tetap berlaku, dan setiap pelanggaran dan ketidaktaatan mendapat balasan yang setimpal,"
 },
 {
   "id": 29998,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 3,
   "firman": "bagaimanakah kita akan luput, jikalau kita menyia-nyiakan keselamatan yang sebesar itu, yang mula-mula diberitakan oleh Tuhan dan oleh mereka yang telah mendengarnya, kepada kita dengan cara yang dapat dipercayai, sedangkan"
 },
 {
   "id": 29999,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 4,
   "firman": "Allah meneguhkan kesaksian mereka oleh tanda-tanda dan mujizat-mujizat dan oleh berbagai-bagai penyataan kekuasaan dan karena Roh Kudus, yang dibagi-bagikan-Nya menurut kehendak-Nya."
 },
 {
   "id": 30000,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 5,
   "firman": "Sebab bukan kepada malaikat-malaikat telah Ia taklukkan dunia yang akan datang, yang kita bicarakan ini."
 },
 {
   "id": 30001,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ada orang yang pernah memberi kesaksian di dalam suatu nas, katanya: \"Apakah manusia, sehingga Engkau mengingatnya, atau anak manusia, sehingga Engkau mengindahkannya?"
 },
 {
   "id": 30002,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 7,
   "firman": "Namun Engkau telah membuatnya untuk waktu yang singkat sedikit lebih rendah dari pada malaikat-malaikat, dan telah memahkotainya dengan kemuliaan dan hormat,"
 },
 {
   "id": 30003,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 8,
   "firman": "segala sesuatu telah Engkau taklukkan di bawah kaki-Nya.\" Sebab dalam menaklukkan segala sesuatu kepada-Nya, tidak ada suatupun yang Ia kecualikan, yang tidak takluk kepada-Nya. Tetapi sekarang ini belum kita lihat, bahwa segala sesuatu telah ditaklukkan kepada-Nya."
 },
 {
   "id": 30004,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tetapi Dia, yang untuk waktu yang singkat dibuat sedikit lebih rendah dari pada malaikat-malaikat, yaitu Yesus, kita lihat, yang oleh karena penderitaan maut, dimahkotai dengan kemuliaan dan hormat, supaya oleh kasih karunia Allah Ia mengalami maut bagi semua manusia."
 },
 {
   "id": 30005,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 10,
   "firman": "Sebab memang sesuai dengan keadaan Allah--yang bagi-Nya dan oleh-Nya segala sesuatu dijadikan--,yaitu Allah yang membawa banyak orang kepada kemuliaan, juga menyempurnakan Yesus, yang memimpin mereka kepada keselamatan, dengan penderitaan."
 },
 {
   "id": 30006,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 11,
   "firman": "Sebab Ia yang menguduskan dan mereka yang dikuduskan, mereka semua berasal dari Satu; itulah sebabnya Ia tidak malu menyebut mereka saudara,"
 },
 {
   "id": 30007,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 12,
   "firman": "kata-Nya: \"Aku akan memberitakan nama-Mu kepada saudara-saudara-Ku, dan memuji-muji Engkau di tengah-tengah jemaat,\""
 },
 {
   "id": 30008,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 13,
   "firman": "dan lagi: \"Aku akan menaruh kepercayaan kepada-Nya,\" dan lagi: \"Sesungguhnya, inilah Aku dan anak-anak yang telah diberikan Allah kepada-Ku.\""
 },
 {
   "id": 30009,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 14,
   "firman": "Karena anak-anak itu adalah anak-anak dari darah dan daging, maka Ia juga menjadi sama dengan mereka dan mendapat bagian dalam keadaan mereka, supaya oleh kematian-Nya Ia memusnahkan dia, yaitu Iblis, yang berkuasa atas maut;"
 },
 {
   "id": 30010,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 15,
   "firman": "dan supaya dengan jalan demikian Ia membebaskan mereka yang seumur hidupnya berada dalam perhambaan oleh karena takutnya kepada maut."
 },
 {
   "id": 30011,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 16,
   "firman": "Sebab sesungguhnya, bukan malaikat-malaikat yang Ia kasihani, tetapi keturunan Abraham yang Ia kasihani."
 },
 {
   "id": 30012,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 17,
   "firman": "Itulah sebabnya, maka dalam segala hal Ia harus disamakan dengan saudara-saudara-Nya, supaya Ia menjadi Imam Besar yang menaruh belas kasihan dan yang setia kepada Allah untuk mendamaikan dosa seluruh bangsa."
 },
 {
   "id": 30013,
   "kitab": "Ibr",
   "pasal": 2,
   "ayat": 18,
   "firman": "Sebab oleh karena Ia sendiri telah menderita karena pencobaan, maka Ia dapat menolong mereka yang dicobai."
 },
 {
   "id": 30014,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 1,
   "firman": "Sebab itu, hai saudara-saudara yang kudus, yang mendapat bagian dalam panggilan sorgawi, pandanglah kepada Rasul dan Imam Besar yang kita akui, yaitu Yesus,"
 },
 {
   "id": 30015,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 2,
   "firman": "yang setia kepada Dia yang telah menetapkan-Nya, sebagaimana Musapun setia dalam segenap rumah-Nya."
 },
 {
   "id": 30016,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 3,
   "firman": "Sebab Ia dipandang layak mendapat kemuliaan lebih besar dari pada Musa, sama seperti ahli bangunan lebih dihormati dari pada rumah yang dibangunnya."
 },
 {
   "id": 30017,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 4,
   "firman": "Sebab setiap rumah dibangun oleh seorang ahli bangunan, tetapi ahli bangunan segala sesuatu ialah Allah."
 },
 {
   "id": 30018,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 5,
   "firman": "Dan Musa memang setia dalam segenap rumah Allah sebagai pelayan untuk memberi kesaksian tentang apa yang akan diberitakan kemudian,"
 },
 {
   "id": 30019,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 6,
   "firman": "tetapi Kristus setia sebagai Anak yang mengepalai rumah-Nya; dan rumah-Nya ialah kita, jika kita sampai kepada akhirnya teguh berpegang pada kepercayaan dan pengharapan yang kita megahkan."
 },
 {
   "id": 30020,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 7,
   "firman": "Sebab itu, seperti yang dikatakan Roh Kudus: \"Pada hari ini, jika kamu mendengar suara-Nya,"
 },
 {
   "id": 30021,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 8,
   "firman": "janganlah keraskan hatimu seperti dalam kegeraman pada waktu pencobaan di padang gurun,"
 },
 {
   "id": 30022,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 9,
   "firman": "di mana nenek moyangmu mencobai Aku dengan jalan menguji Aku, sekalipun mereka melihat perbuatan-perbuatan-Ku, empat puluh tahun lamanya."
 },
 {
   "id": 30023,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 10,
   "firman": "Itulah sebabnya Aku murka kepada angkatan itu, dan berkata: Selalu mereka sesat hati, dan mereka tidak mengenal jalan-Ku,"
 },
 {
   "id": 30024,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 11,
   "firman": "sehingga Aku bersumpah dalam murka-Ku: Mereka takkan masuk ke tempat perhentian-Ku.\""
 },
 {
   "id": 30025,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 12,
   "firman": "Waspadalah, hai saudara-saudara, supaya di antara kamu jangan terdapat seorang yang hatinya jahat dan yang tidak percaya oleh karena ia murtad dari Allah yang hidup."
 },
 {
   "id": 30026,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tetapi nasihatilah seorang akan yang lain setiap hari, selama masih dapat dikatakan \"hari ini\", supaya jangan ada di antara kamu yang menjadi tegar hatinya karena tipu daya dosa."
 },
 {
   "id": 30027,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 14,
   "firman": "Karena kita telah beroleh bagian di dalam Kristus, asal saja kita teguh berpegang sampai kepada akhirnya pada keyakinan iman kita yang semula."
 },
 {
   "id": 30028,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 15,
   "firman": "Tetapi apabila pernah dikatakan: \"Pada hari ini, jika kamu mendengar suara-Nya, janganlah keraskan hatimu seperti dalam kegeraman\","
 },
 {
   "id": 30029,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 16,
   "firman": "siapakah mereka yang membangkitkan amarah Allah, sekalipun mereka mendengar suara-Nya? Bukankah mereka semua yang keluar dari Mesir di bawah pimpinan Musa?"
 },
 {
   "id": 30030,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 17,
   "firman": "Dan siapakah yang Ia murkai empat puluh tahun lamanya? Bukankah mereka yang berbuat dosa dan yang mayatnya bergelimpangan di padang gurun?"
 },
 {
   "id": 30031,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan siapakah yang telah Ia sumpahi, bahwa mereka takkan masuk ke tempat perhentian-Nya? Bukankah mereka yang tidak taat?"
 },
 {
   "id": 30032,
   "kitab": "Ibr",
   "pasal": 3,
   "ayat": 19,
   "firman": "Demikianlah kita lihat, bahwa mereka tidak dapat masuk oleh karena ketidakpercayaan mereka."
 },
 {
   "id": 30033,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 1,
   "firman": "Sebab itu, baiklah kita waspada, supaya jangan ada seorang di antara kamu yang dianggap ketinggalan, sekalipun janji akan masuk ke dalam perhentian-Nya masih berlaku."
 },
 {
   "id": 30034,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 2,
   "firman": "Karena kepada kita diberitakan juga kabar kesukaan sama seperti kepada mereka, tetapi firman pemberitaan itu tidak berguna bagi mereka, karena tidak bertumbuh bersama-sama oleh iman dengan mereka yang mendengarnya."
 },
 {
   "id": 30035,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sebab kita yang beriman, akan masuk ke tempat perhentian seperti yang Ia katakan: \"Sehingga Aku bersumpah dalam murka-Ku: Mereka takkan masuk ke tempat perhentian-Ku,\" sekalipun pekerjaan-Nya sudah selesai sejak dunia dijadikan."
 },
 {
   "id": 30036,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 4,
   "firman": "Sebab tentang hari ketujuh pernah dikatakan di dalam suatu nas: \"Dan Allah berhenti pada hari ketujuh dari segala pekerjaan-Nya.\""
 },
 {
   "id": 30037,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 5,
   "firman": "Dan dalam nas itu kita baca: \"Mereka takkan masuk ke tempat perhentian-Ku.\""
 },
 {
   "id": 30038,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 6,
   "firman": "Jadi sudah jelas, bahwa ada sejumlah orang akan masuk ke tempat perhentian itu, sedangkan mereka yang kepadanya lebih dahulu diberitakan kabar kesukaan itu, tidak masuk karena ketidaktaatan mereka."
 },
 {
   "id": 30039,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 7,
   "firman": "Sebab itu Ia menetapkan pula suatu hari, yaitu \"hari ini\", ketika Ia setelah sekian lama berfirman dengan perantaraan Daud seperti dikatakan di atas: \"Pada hari ini, jika kamu mendengar suara-Nya, janganlah keraskan hatimu!\""
 },
 {
   "id": 30040,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 8,
   "firman": "Sebab, andaikata Yosua telah membawa mereka masuk ke tempat perhentian, pasti Allah tidak akan berkata-kata kemudian tentang suatu hari lain."
 },
 {
   "id": 30041,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 9,
   "firman": "Jadi masih tersedia suatu hari perhentian, hari ketujuh, bagi umat Allah."
 },
 {
   "id": 30042,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 10,
   "firman": "Sebab barangsiapa telah masuk ke tempat perhentian-Nya, ia sendiri telah berhenti dari segala pekerjaannya, sama seperti Allah berhenti dari pekerjaan-Nya."
 },
 {
   "id": 30043,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 11,
   "firman": "Karena itu baiklah kita berusaha untuk masuk ke dalam perhentian itu, supaya jangan seorangpun jatuh karena mengikuti contoh ketidaktaatan itu juga."
 },
 {
   "id": 30044,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 12,
   "firman": "Sebab firman Allah hidup dan kuat dan lebih tajam dari pada pedang bermata dua manapun; ia menusuk amat dalam sampai memisahkan jiwa dan roh, sendi-sendi dan sumsum; ia sanggup membedakan pertimbangan dan pikiran hati kita."
 },
 {
   "id": 30045,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 13,
   "firman": "Dan tidak ada suatu makhlukpun yang tersembunyi di hadapan-Nya, sebab segala sesuatu telanjang dan terbuka di depan mata Dia, yang kepada-Nya kita harus memberikan pertanggungan jawab."
 },
 {
   "id": 30046,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 14,
   "firman": "Karena kita sekarang mempunyai Imam Besar Agung, yang telah melintasi semua langit, yaitu Yesus, Anak Allah, baiklah kita teguh berpegang pada pengakuan iman kita."
 },
 {
   "id": 30047,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sebab Imam Besar yang kita punya, bukanlah imam besar yang tidak dapat turut merasakan kelemahan-kelemahan kita, sebaliknya sama dengan kita, Ia telah dicobai, hanya tidak berbuat dosa."
 },
 {
   "id": 30048,
   "kitab": "Ibr",
   "pasal": 4,
   "ayat": 16,
   "firman": "Sebab itu marilah kita dengan penuh keberanian menghampiri takhta kasih karunia, supaya kita menerima rahmat dan menemukan kasih karunia untuk mendapat pertolongan kita pada waktunya."
 },
 {
   "id": 30049,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 1,
   "firman": "Sebab setiap imam besar, yang dipilih dari antara manusia, ditetapkan bagi manusia dalam hubungan mereka dengan Allah, supaya ia mempersembahkan persembahan dan korban karena dosa."
 },
 {
   "id": 30050,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 2,
   "firman": "Ia harus dapat mengerti orang-orang yang jahil dan orang-orang yang sesat, karena ia sendiri penuh dengan kelemahan,"
 },
 {
   "id": 30051,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 3,
   "firman": "yang mengharuskannya untuk mempersembahkan korban karena dosa, bukan saja bagi umat, tetapi juga bagi dirinya sendiri."
 },
 {
   "id": 30052,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 4,
   "firman": "Dan tidak seorangpun yang mengambil kehormatan itu bagi dirinya sendiri, tetapi dipanggil untuk itu oleh Allah, seperti yang telah terjadi dengan Harun."
 },
 {
   "id": 30053,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 5,
   "firman": "Demikian pula Kristus tidak memuliakan diri-Nya sendiri dengan menjadi Imam Besar, tetapi dimuliakan oleh Dia yang berfirman kepada-Nya: \"Anak-Ku Engkau! Engkau telah Kuperanakkan pada hari ini\","
 },
 {
   "id": 30054,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 6,
   "firman": "sebagaimana firman-Nya dalam suatu nas lain: \"Engkau adalah Imam untuk selama-lamanya, menurut peraturan Melkisedek.\""
 },
 {
   "id": 30055,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 7,
   "firman": "Dalam hidup-Nya sebagai manusia, Ia telah mempersembahkan doa dan permohonan dengan ratap tangis dan keluhan kepada Dia, yang sanggup menyelamatkan-Nya dari maut, dan karena kesalehan-Nya Ia telah didengarkan."
 },
 {
   "id": 30056,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 8,
   "firman": "Dan sekalipun Ia adalah Anak, Ia telah belajar menjadi taat dari apa yang telah diderita-Nya,"
 },
 {
   "id": 30057,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 9,
   "firman": "dan sesudah Ia mencapai kesempurnaan-Nya, Ia menjadi pokok keselamatan yang abadi bagi semua orang yang taat kepada-Nya,"
 },
 {
   "id": 30058,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 10,
   "firman": "dan Ia dipanggil menjadi Imam Besar oleh Allah, menurut peraturan Melkisedek."
 },
 {
   "id": 30059,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 11,
   "firman": "Tentang hal itu banyak yang harus kami katakan, tetapi yang sukar untuk dijelaskan, karena kamu telah lamban dalam hal mendengarkan."
 },
 {
   "id": 30060,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 12,
   "firman": "Sebab sekalipun kamu, ditinjau dari sudut waktu, sudah seharusnya menjadi pengajar, kamu masih perlu lagi diajarkan asas-asas pokok dari penyataan Allah, dan kamu masih memerlukan susu, bukan makanan keras."
 },
 {
   "id": 30061,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 13,
   "firman": "Sebab barangsiapa masih memerlukan susu ia tidak memahami ajaran tentang kebenaran, sebab ia adalah anak kecil."
 },
 {
   "id": 30062,
   "kitab": "Ibr",
   "pasal": 5,
   "ayat": 14,
   "firman": "Tetapi makanan keras adalah untuk orang-orang dewasa, yang karena mempunyai pancaindera yang terlatih untuk membedakan yang baik dari pada yang jahat."
 },
 {
   "id": 30063,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 1,
   "firman": "Sebab itu marilah kita tinggalkan asas-asas pertama dari ajaran tentang Kristus dan beralih kepada perkembangannya yang penuh. Janganlah kita meletakkan lagi dasar pertobatan dari perbuatan-perbuatan yang sia-sia, dan dasar kepercayaan kepada Allah,"
 },
 {
   "id": 30064,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 2,
   "firman": "yaitu ajaran tentang pelbagai pembaptisan, penumpangan tangan, kebangkitan orang-orang mati dan hukuman kekal."
 },
 {
   "id": 30065,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 3,
   "firman": "Dan itulah yang akan kita perbuat, jika Allah mengizinkannya."
 },
 {
   "id": 30066,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 4,
   "firman": "Sebab mereka yang pernah diterangi hatinya, yang pernah mengecap karunia sorgawi, dan yang pernah mendapat bagian dalam Roh Kudus,"
 },
 {
   "id": 30067,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 5,
   "firman": "dan yang mengecap firman yang baik dari Allah dan karunia-karunia dunia yang akan datang,"
 },
 {
   "id": 30068,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 6,
   "firman": "namun yang murtad lagi, tidak mungkin dibaharui sekali lagi sedemikian, hingga mereka bertobat, sebab mereka menyalibkan lagi Anak Allah bagi diri mereka dan menghina-Nya di muka umum."
 },
 {
   "id": 30069,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 7,
   "firman": "Sebab tanah yang menghisap air hujan yang sering turun ke atasnya, dan yang menghasilkan tumbuh-tumbuhan yang berguna bagi mereka yang mengerjakannya, menerima berkat dari Allah;"
 },
 {
   "id": 30070,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 8,
   "firman": "tetapi jikalau tanah itu menghasilkan semak duri dan rumput duri, tidaklah ia berguna dan sudah dekat pada kutuk, yang berakhir dengan pembakaran."
 },
 {
   "id": 30071,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi, hai saudara-saudaraku yang kekasih, sekalipun kami berkata demikian tentang kamu, kami yakin, bahwa kamu memiliki sesuatu yang lebih baik, yang mengandung keselamatan."
 },
 {
   "id": 30072,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 10,
   "firman": "Sebab Allah bukan tidak adil, sehingga Ia lupa akan pekerjaanmu dan kasihmu yang kamu tunjukkan terhadap nama-Nya oleh pelayanan kamu kepada orang-orang kudus, yang masih kamu lakukan sampai sekarang."
 },
 {
   "id": 30073,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 11,
   "firman": "Tetapi kami ingin, supaya kamu masing-masing menunjukkan kesungguhan yang sama untuk menjadikan pengharapanmu suatu milik yang pasti, sampai pada akhirnya,"
 },
 {
   "id": 30074,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 12,
   "firman": "agar kamu jangan menjadi lamban, tetapi menjadi penurut-penurut mereka yang oleh iman dan kesabaran mendapat bagian dalam apa yang dijanjikan Allah."
 },
 {
   "id": 30075,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 13,
   "firman": "Sebab ketika Allah memberikan janji-Nya kepada Abraham, Ia bersumpah demi diri-Nya sendiri, karena tidak ada orang yang lebih tinggi dari pada-Nya,"
 },
 {
   "id": 30076,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 14,
   "firman": "kata-Nya: \"Sesungguhnya Aku akan memberkati engkau berlimpah-limpah dan akan membuat engkau sangat banyak.\""
 },
 {
   "id": 30077,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 15,
   "firman": "Abraham menanti dengan sabar dan dengan demikian ia memperoleh apa yang dijanjikan kepadanya."
 },
 {
   "id": 30078,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 16,
   "firman": "Sebab manusia bersumpah demi orang yang lebih tinggi, dan sumpah itu menjadi suatu pengokohan baginya, yang mengakhiri segala bantahan."
 },
 {
   "id": 30079,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 17,
   "firman": "Karena itu, untuk lebih meyakinkan mereka yang berhak menerima janji itu akan kepastian putusan-Nya, Allah telah mengikat diri-Nya dengan sumpah,"
 },
 {
   "id": 30080,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 18,
   "firman": "supaya oleh dua kenyataan yang tidak berubah-ubah, tentang mana Allah tidak mungkin berdusta, kita yang mencari perlindungan, beroleh dorongan yang kuat untuk menjangkau pengharapan yang terletak di depan kita."
 },
 {
   "id": 30081,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 19,
   "firman": "Pengharapan itu adalah sauh yang kuat dan aman bagi jiwa kita, yang telah dilabuhkan sampai ke belakang tabir,"
 },
 {
   "id": 30082,
   "kitab": "Ibr",
   "pasal": 6,
   "ayat": 20,
   "firman": "di mana Yesus telah masuk sebagai Perintis bagi kita, ketika Ia, menurut peraturan Melkisedek, menjadi Imam Besar sampai selama-lamanya."
 },
 {
   "id": 30083,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 1,
   "firman": "Sebab Melkisedek adalah raja Salem dan imam Allah Yang Mahatinggi; ia pergi menyongsong Abraham ketika Abraham kembali dari mengalahkan raja-raja, dan memberkati dia."
 },
 {
   "id": 30084,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 2,
   "firman": "Kepadanyapun Abraham memberikan sepersepuluh dari semuanya. Menurut arti namanya Melkisedek adalah pertama-tama raja kebenaran, dan juga raja Salem, yaitu raja damai sejahtera."
 },
 {
   "id": 30085,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 3,
   "firman": "Ia tidak berbapa, tidak beribu, tidak bersilsilah, harinya tidak berawal dan hidupnya tidak berkesudahan, dan karena ia dijadikan sama dengan Anak Allah, ia tetap menjadi imam sampai selama-lamanya."
 },
 {
   "id": 30086,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 4,
   "firman": "Camkanlah betapa besarnya orang itu, yang kepadanya Abraham, bapa leluhur kita, memberikan sepersepuluh dari segala rampasan yang paling baik."
 },
 {
   "id": 30087,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 5,
   "firman": "Dan mereka dari anak-anak Lewi, yang menerima jabatan imam, mendapat tugas, menurut hukum Taurat, untuk memungut persepuluhan dari umat Israel, yaitu dari saudara-saudara mereka, sekalipun mereka ini juga adalah keturunan Abraham."
 },
 {
   "id": 30088,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 6,
   "firman": "Tetapi Melkisedek, yang bukan keturunan mereka, memungut persepuluhan dari Abraham dan memberkati dia, walaupun ia adalah pemilik janji."
 },
 {
   "id": 30089,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 7,
   "firman": "Memang tidak dapat disangkal, bahwa yang lebih rendah diberkati oleh yang lebih tinggi."
 },
 {
   "id": 30090,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dan di sini manusia-manusia fana menerima persepuluhan, dan di sana Ia, yang tentang Dia diberi kesaksian, bahwa Ia hidup."
 },
 {
   "id": 30091,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 9,
   "firman": "Maka dapatlah dikatakan, bahwa dengan perantaraan Abraham dipungut juga persepuluhan dari Lewi, yang berhak menerima persepuluhan,"
 },
 {
   "id": 30092,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 10,
   "firman": "sebab ia masih berada dalam tubuh bapa leluhurnya, ketika Melkisedek menyongsong bapa leluhurnya itu."
 },
 {
   "id": 30093,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 11,
   "firman": "Karena itu, andaikata oleh imamat Lewi telah tercapai kesempurnaan--sebab karena imamat itu umat Israel telah menerima Taurat--apakah sebabnya masih perlu seorang lain ditetapkan menjadi imam besar menurut peraturan Melkisedek dan yang tentang dia tidak dikatakan menurut peraturan Harun?"
 },
 {
   "id": 30094,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 12,
   "firman": "Sebab, jikalau imamat berubah, dengan sendirinya akan berubah pula hukum Taurat itu."
 },
 {
   "id": 30095,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 13,
   "firman": "Sebab Ia, yang dimaksudkan di sini, termasuk suku lain; dari suku ini tidak ada seorangpun yang pernah melayani di mezbah."
 },
 {
   "id": 30096,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 14,
   "firman": "Sebab telah diketahui semua orang, bahwa Tuhan kita berasal dari suku Yehuda dan mengenai suku itu Musa tidak pernah mengatakan suatu apapun tentang imam-imam."
 },
 {
   "id": 30097,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 15,
   "firman": "Dan hal itu jauh lebih nyata lagi, jikalau ditetapkan seorang imam lain menurut cara Melkisedek,"
 },
 {
   "id": 30098,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 16,
   "firman": "yang menjadi imam bukan berdasarkan peraturan-peraturan manusia, tetapi berdasarkan hidup yang tidak dapat binasa."
 },
 {
   "id": 30099,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 17,
   "firman": "Sebab tentang Dia diberi kesaksian: \"Engkau adalah Imam untuk selama-lamanya, menurut peraturan Melkisedek.\""
 },
 {
   "id": 30100,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 18,
   "firman": "Memang suatu hukum yang dikeluarkan dahulu dibatalkan, kalau hukum itu tidak mempunyai kekuatan dan karena itu tidak berguna,"
 },
 {
   "id": 30101,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 19,
   "firman": "--sebab hukum Taurat sama sekali tidak membawa kesempurnaan--tetapi sekarang ditimbulkan pengharapan yang lebih baik, yang mendekatkan kita kepada Allah."
 },
 {
   "id": 30102,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 20,
   "firman": "Dan sama seperti hal ini tidak terjadi tanpa sumpah--memang mereka telah menjadi imam tanpa sumpah,"
 },
 {
   "id": 30103,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 21,
   "firman": "tetapi Ia dengan sumpah, diucapkan oleh Dia yang berfirman kepada-Nya: \"Tuhan telah bersumpah dan Ia tidak akan menyesal: Engkau adalah Imam untuk selama-lamanya\" --"
 },
 {
   "id": 30104,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 22,
   "firman": "demikian pula Yesus adalah jaminan dari suatu perjanjian yang lebih kuat."
 },
 {
   "id": 30105,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 23,
   "firman": "Dan dalam jumlah yang besar mereka telah menjadi imam, karena mereka dicegah oleh maut untuk tetap menjabat imam."
 },
 {
   "id": 30106,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 24,
   "firman": "Tetapi, karena Ia tetap selama-lamanya, imamat-Nya tidak dapat beralih kepada orang lain."
 },
 {
   "id": 30107,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 25,
   "firman": "Karena itu Ia sanggup juga menyelamatkan dengan sempurna semua orang yang oleh Dia datang kepada Allah. Sebab Ia hidup senantiasa untuk menjadi Pengantara mereka."
 },
 {
   "id": 30108,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 26,
   "firman": "Sebab Imam Besar yang demikianlah yang kita perlukan: yaitu yang saleh, tanpa salah, tanpa noda, yang terpisah dari orang-orang berdosa dan lebih tinggi dari pada tingkat-tingkat sorga,"
 },
 {
   "id": 30109,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 27,
   "firman": "yang tidak seperti imam-imam besar lain, yang setiap hari harus mempersembahkan korban untuk dosanya sendiri dan sesudah itu barulah untuk dosa umatnya, sebab hal itu telah dilakukan-Nya satu kali untuk selama-lamanya, ketika Ia mempersembahkan diri-Nya sendiri sebagai korban."
 },
 {
   "id": 30110,
   "kitab": "Ibr",
   "pasal": 7,
   "ayat": 28,
   "firman": "Sebab hukum Taurat menetapkan orang-orang yang diliputi kelemahan menjadi Imam Besar, tetapi sumpah, yang diucapkan kemudian dari pada hukum Taurat, menetapkan Anak, yang telah menjadi sempurna sampai selama-lamanya."
 },
 {
   "id": 30111,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 1,
   "firman": "Inti segala yang kita bicarakan itu ialah: kita mempunyai Imam Besar yang demikian, yang duduk di sebelah kanan takhta Yang Mahabesar di sorga,"
 },
 {
   "id": 30112,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 2,
   "firman": "dan yang melayani ibadah di tempat kudus, yaitu di dalam kemah sejati, yang didirikan oleh Tuhan dan bukan oleh manusia."
 },
 {
   "id": 30113,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 3,
   "firman": "Sebab setiap Imam Besar ditetapkan untuk mempersembahkan korban dan persembahan dan karena itu Yesus perlu mempunyai sesuatu untuk dipersembahkan."
 },
 {
   "id": 30114,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 4,
   "firman": "Sekiranya Ia di bumi ini, Ia sama sekali tidak akan menjadi imam, karena di sini telah ada orang-orang yang mempersembahkan persembahan menurut hukum Taurat."
 },
 {
   "id": 30115,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 5,
   "firman": "Pelayanan mereka adalah gambaran dan bayangan dari apa yang ada di sorga, sama seperti yang diberitahukan kepada Musa, ketika ia hendak mendirikan kemah: \"Ingatlah,\" demikian firman-Nya, \"bahwa engkau membuat semuanya itu menurut contoh yang telah ditunjukkan kepadamu di atas gunung itu.\""
 },
 {
   "id": 30116,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 6,
   "firman": "Tetapi sekarang Ia telah mendapat suatu pelayanan yang jauh lebih agung, karena Ia menjadi Pengantara dari perjanjian yang lebih mulia, yang didasarkan atas janji yang lebih tinggi."
 },
 {
   "id": 30117,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sebab, sekiranya perjanjian yang pertama itu tidak bercacat, tidak akan dicari lagi tempat untuk yang kedua."
 },
 {
   "id": 30118,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 8,
   "firman": "Sebab Ia menegor mereka ketika Ia berkata: \"Sesungguhnya, akan datang waktunya,\" demikianlah firman Tuhan, \"Aku akan mengadakan perjanjian baru dengan kaum Israel dan dengan kaum Yehuda,"
 },
 {
   "id": 30119,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 9,
   "firman": "bukan seperti perjanjian yang telah Kuadakan dengan nenek moyang mereka, pada waktu Aku memegang tangan mereka untuk membawa mereka keluar dari tanah Mesir. Sebab mereka tidak setia kepada perjanjian-Ku, dan Aku menolak mereka,\" demikian firman Tuhan."
 },
 {
   "id": 30120,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 10,
   "firman": "\"Maka inilah perjanjian yang Kuadakan dengan kaum Israel sesudah waktu itu,\" demikianlah firman Tuhan. \"Aku akan menaruh hukum-Ku dalam akal budi mereka dan menuliskannya dalam hati mereka, maka Aku akan menjadi Allah mereka dan mereka akan menjadi umat-Ku."
 },
 {
   "id": 30121,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dan mereka tidak akan mengajar lagi sesama warganya, atau sesama saudaranya dengan mengatakan: Kenallah Tuhan! Sebab mereka semua, besar kecil, akan mengenal Aku."
 },
 {
   "id": 30122,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 12,
   "firman": "Sebab Aku akan menaruh belas kasihan terhadap kesalahan mereka dan tidak lagi mengingat dosa-dosa mereka.\""
 },
 {
   "id": 30123,
   "kitab": "Ibr",
   "pasal": 8,
   "ayat": 13,
   "firman": "Oleh karena Ia berkata-kata tentang perjanjian yang baru, Ia menyatakan yang pertama sebagai perjanjian yang telah menjadi tua. Dan apa yang telah menjadi tua dan usang, telah dekat kepada kemusnahannya."
 },
 {
   "id": 30124,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 1,
   "firman": "Memang perjanjian yang pertama juga mempunyai peraturan-peraturan untuk ibadah dan untuk tempat kudus buatan tangan manusia."
 },
 {
   "id": 30125,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 2,
   "firman": "Sebab ada dipersiapkan suatu kemah, yaitu bagian yang paling depan dan di situ terdapat kaki dian dan meja dengan roti sajian. Bagian ini disebut tempat yang kudus."
 },
 {
   "id": 30126,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 3,
   "firman": "Di belakang tirai yang kedua terdapat suatu kemah lagi yang disebut tempat yang maha kudus."
 },
 {
   "id": 30127,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 4,
   "firman": "Di situ terdapat mezbah pembakaran ukupan dari emas, dan tabut perjanjian, yang seluruhnya disalut dengan emas; di dalam tabut perjanjian itu tersimpan buli-buli emas berisi manna, tongkat Harun yang pernah bertunas dan loh-loh batu yang bertuliskan perjanjian,"
 },
 {
   "id": 30128,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 5,
   "firman": "dan di atasnya kedua kerub kemuliaan yang menaungi tutup pendamaian. Tetapi hal ini tidak dapat kita bicarakan sekarang secara terperinci."
 },
 {
   "id": 30129,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 6,
   "firman": "Demikianlah caranya tempat yang kudus itu diatur. Maka imam-imam senantiasa masuk ke dalam kemah yang paling depan itu untuk melakukan ibadah mereka,"
 },
 {
   "id": 30130,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 7,
   "firman": "tetapi ke dalam kemah yang kedua hanya Imam Besar saja yang masuk sekali setahun, dan harus dengan darah yang ia persembahkan karena dirinya sendiri dan karena pelanggaran-pelanggaran, yang dibuat oleh umatnya dengan tidak sadar."
 },
 {
   "id": 30131,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 8,
   "firman": "Dengan ini Roh Kudus menyatakan, bahwa jalan ke tempat yang kudus itu belum terbuka, selama kemah yang pertama itu masih ada."
 },
 {
   "id": 30132,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 9,
   "firman": "Itu adalah kiasan masa sekarang. Sesuai dengan itu dipersembahkan korban dan persembahan yang tidak dapat menyempurnakan mereka yang mempersembahkannya menurut hati nurani mereka,"
 },
 {
   "id": 30133,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 10,
   "firman": "karena semuanya itu, di samping makanan minuman dan pelbagai macam pembasuhan, hanyalah peraturan-peraturan untuk hidup insani, yang hanya berlaku sampai tibanya waktu pembaharuan."
 },
 {
   "id": 30134,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 11,
   "firman": "Tetapi Kristus telah datang sebagai Imam Besar untuk hal-hal yang baik yang akan datang: Ia telah melintasi kemah yang lebih besar dan yang lebih sempurna, yang bukan dibuat oleh tangan manusia, --artinya yang tidak termasuk ciptaan ini, --"
 },
 {
   "id": 30135,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 12,
   "firman": "dan Ia telah masuk satu kali untuk selama-lamanya ke dalam tempat yang kudus bukan dengan membawa darah domba jantan dan darah anak lembu, tetapi dengan membawa darah-Nya sendiri. Dan dengan itu Ia telah mendapat kelepasan yang kekal."
 },
 {
   "id": 30136,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 13,
   "firman": "Sebab, jika darah domba jantan dan darah lembu jantan dan percikan abu lembu muda menguduskan mereka yang najis, sehingga mereka disucikan secara lahiriah,"
 },
 {
   "id": 30137,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 14,
   "firman": "betapa lebihnya darah Kristus, yang oleh Roh yang kekal telah mempersembahkan diri-Nya sendiri kepada Allah sebagai persembahan yang tak bercacat, akan menyucikan hati nurani kita dari perbuatan-perbuatan yang sia-sia, supaya kita dapat beribadah kepada Allah yang hidup."
 },
 {
   "id": 30138,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 15,
   "firman": "Karena itu Ia adalah Pengantara dari suatu perjanjian yang baru, supaya mereka yang telah terpanggil dapat menerima bagian kekal yang dijanjikan, sebab Ia telah mati untuk menebus pelanggaran-pelanggaran yang telah dilakukan selama perjanjian yang pertama."
 },
 {
   "id": 30139,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 16,
   "firman": "Sebab di mana ada wasiat, di situ harus diberitahukan tentang kematian pembuat wasiat itu."
 },
 {
   "id": 30140,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 17,
   "firman": "Karena suatu wasiat barulah sah, kalau pembuat wasiat itu telah mati, sebab ia tidak berlaku, selama pembuat wasiat itu masih hidup."
 },
 {
   "id": 30141,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 18,
   "firman": "Itulah sebabnya, maka perjanjian yang pertama tidak disahkan tanpa darah."
 },
 {
   "id": 30142,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sebab sesudah Musa memberitahukan semua perintah hukum Taurat kepada seluruh umat, ia mengambil darah anak lembu dan darah domba jantan serta air, dan bulu merah dan hisop, lalu memerciki kitab itu sendiri dan seluruh umat,"
 },
 {
   "id": 30143,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 20,
   "firman": "sambil berkata: \"Inilah darah perjanjian yang ditetapkan Allah bagi kamu.\""
 },
 {
   "id": 30144,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 21,
   "firman": "Dan juga kemah dan semua alat untuk ibadah dipercikinya secara demikian dengan darah."
 },
 {
   "id": 30145,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 22,
   "firman": "Dan hampir segala sesuatu disucikan menurut hukum Taurat dengan darah, dan tanpa penumpahan darah tidak ada pengampunan."
 },
 {
   "id": 30146,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 23,
   "firman": "Jadi segala sesuatu yang melambangkan apa yang ada di sorga haruslah ditahirkan secara demikian, tetapi benda-benda sorgawi sendiri oleh persembahan-persembahan yang lebih baik dari pada itu."
 },
 {
   "id": 30147,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 24,
   "firman": "Sebab Kristus bukan masuk ke dalam tempat kudus buatan tangan manusia yang hanya merupakan gambaran saja dari yang sebenarnya, tetapi ke dalam sorga sendiri untuk menghadap hadirat Allah guna kepentingan kita."
 },
 {
   "id": 30148,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 25,
   "firman": "Dan Ia bukan masuk untuk berulang-ulang mempersembahkan diri-Nya sendiri, sebagaimana Imam Besar setiap tahun masuk ke dalam tempat kudus dengan darah yang bukan darahnya sendiri."
 },
 {
   "id": 30149,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 26,
   "firman": "Sebab jika demikian Ia harus berulang-ulang menderita sejak dunia ini dijadikan. Tetapi sekarang Ia hanya satu kali saja menyatakan diri-Nya, pada zaman akhir untuk menghapuskan dosa oleh korban-Nya."
 },
 {
   "id": 30150,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 27,
   "firman": "Dan sama seperti manusia ditetapkan untuk mati hanya satu kali saja, dan sesudah itu dihakimi,"
 },
 {
   "id": 30151,
   "kitab": "Ibr",
   "pasal": 9,
   "ayat": 28,
   "firman": "demikian pula Kristus hanya satu kali saja mengorbankan diri-Nya untuk menanggung dosa banyak orang. Sesudah itu Ia akan menyatakan diri-Nya sekali lagi tanpa menanggung dosa untuk menganugerahkan keselamatan kepada mereka, yang menantikan Dia."
 },
 {
   "id": 30152,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 1,
   "firman": "Di dalam hukum Taurat hanya terdapat bayangan saja dari keselamatan yang akan datang, dan bukan hakekat dari keselamatan itu sendiri. Karena itu dengan korban yang sama, yang setiap tahun terus-menerus dipersembahkan, hukum Taurat tidak mungkin menyempurnakan mereka yang datang mengambil bagian di dalamnya."
 },
 {
   "id": 30153,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 2,
   "firman": "Sebab jika hal itu mungkin, pasti orang tidak mempersembahkan korban lagi, sebab mereka yang melakukan ibadah itu tidak sadar lagi akan dosa setelah disucikan sekali untuk selama-lamanya."
 },
 {
   "id": 30154,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 3,
   "firman": "Tetapi justru oleh korban-korban itu setiap tahun orang diperingatkan akan adanya dosa."
 },
 {
   "id": 30155,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 4,
   "firman": "Sebab tidak mungkin darah lembu jantan atau darah domba jantan menghapuskan dosa."
 },
 {
   "id": 30156,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 5,
   "firman": "Karena itu ketika Ia masuk ke dunia, Ia berkata: \"Korban dan persembahan tidak Engkau kehendaki--tetapi Engkau telah menyediakan tubuh bagiku--."
 },
 {
   "id": 30157,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 6,
   "firman": "Kepada korban bakaran dan korban penghapus dosa Engkau tidak berkenan."
 },
 {
   "id": 30158,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 7,
   "firman": "Lalu Aku berkata: Sungguh, Aku datang; dalam gulungan kitab ada tertulis tentang Aku untuk melakukan kehendak-Mu, ya Allah-Ku.\""
 },
 {
   "id": 30159,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 8,
   "firman": "Di atas Ia berkata: \"Korban dan persembahan, korban bakaran dan korban penghapus dosa tidak Engkau kehendaki dan Engkau tidak berkenan kepadanya\" --meskipun dipersembahkan menurut hukum Taurat--."
 },
 {
   "id": 30160,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 9,
   "firman": "Dan kemudian kata-Nya: \"Sungguh, Aku datang untuk melakukan kehendak-Mu.\" Yang pertama Ia hapuskan, supaya menegakkan yang kedua."
 },
 {
   "id": 30161,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 10,
   "firman": "Dan karena kehendak-Nya inilah kita telah dikuduskan satu kali untuk selama-lamanya oleh persembahan tubuh Yesus Kristus."
 },
 {
   "id": 30162,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 11,
   "firman": "Selanjutnya setiap imam melakukan tiap-tiap hari pelayanannya dan berulang-ulang mempersembahkan korban yang sama, yang sama sekali tidak dapat menghapuskan dosa."
 },
 {
   "id": 30163,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 12,
   "firman": "Tetapi Ia, setelah mempersembahkan hanya satu korban saja karena dosa, Ia duduk untuk selama-lamanya di sebelah kanan Allah,"
 },
 {
   "id": 30164,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 13,
   "firman": "dan sekarang Ia hanya menantikan saatnya, di mana musuh-musuh-Nya akan dijadikan tumpuan kaki-Nya."
 },
 {
   "id": 30165,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 14,
   "firman": "Sebab oleh satu korban saja Ia telah menyempurnakan untuk selama-lamanya mereka yang Ia kuduskan."
 },
 {
   "id": 30166,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 15,
   "firman": "Dan tentang hal itu Roh Kudus juga memberi kesaksian kepada kita,"
 },
 {
   "id": 30167,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 16,
   "firman": "sebab setelah Ia berfirman: \"Inilah perjanjian yang akan Kuadakan dengan mereka sesudah waktu itu,\" Ia berfirman pula: \"Aku akan menaruh hukum-Ku di dalam hati mereka dan menuliskannya dalam akal budi mereka,"
 },
 {
   "id": 30168,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 17,
   "firman": "dan Aku tidak lagi mengingat dosa-dosa dan kesalahan mereka.\""
 },
 {
   "id": 30169,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 18,
   "firman": "Jadi apabila untuk semuanya itu ada pengampunan, tidak perlu lagi dipersembahkan korban karena dosa."
 },
 {
   "id": 30170,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 19,
   "firman": "Jadi, saudara-saudara, oleh darah Yesus kita sekarang penuh keberanian dapat masuk ke dalam tempat kudus,"
 },
 {
   "id": 30171,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 20,
   "firman": "karena Ia telah membuka jalan yang baru dan yang hidup bagi kita melalui tabir, yaitu diri-Nya sendiri,"
 },
 {
   "id": 30172,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 21,
   "firman": "dan kita mempunyai seorang Imam Besar sebagai kepala Rumah Allah."
 },
 {
   "id": 30173,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 22,
   "firman": "Karena itu marilah kita menghadap Allah dengan hati yang tulus ikhlas dan keyakinan iman yang teguh, oleh karena hati kita telah dibersihkan dari hati nurani yang jahat dan tubuh kita telah dibasuh dengan air yang murni."
 },
 {
   "id": 30174,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 23,
   "firman": "Marilah kita teguh berpegang pada pengakuan tentang pengharapan kita, sebab Ia, yang menjanjikannya, setia."
 },
 {
   "id": 30175,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 24,
   "firman": "Dan marilah kita saling memperhatikan supaya kita saling mendorong dalam kasih dan dalam pekerjaan baik."
 },
 {
   "id": 30176,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 25,
   "firman": "Janganlah kita menjauhkan diri dari pertemuan-pertemuan ibadah kita, seperti dibiasakan oleh beberapa orang, tetapi marilah kita saling menasihati, dan semakin giat melakukannya menjelang hari Tuhan yang mendekat."
 },
 {
   "id": 30177,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 26,
   "firman": "Sebab jika kita sengaja berbuat dosa, sesudah memperoleh pengetahuan tentang kebenaran, maka tidak ada lagi korban untuk menghapus dosa itu."
 },
 {
   "id": 30178,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 27,
   "firman": "Tetapi yang ada ialah kematian yang mengerikan akan penghakiman dan api yang dahsyat yang akan menghanguskan semua orang durhaka."
 },
 {
   "id": 30179,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 28,
   "firman": "Jika ada orang yang menolak hukum Musa, ia dihukum mati tanpa belas kasihan atas keterangan dua atau tiga orang saksi."
 },
 {
   "id": 30180,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 29,
   "firman": "Betapa lebih beratnya hukuman yang harus dijatuhkan atas dia, yang menginjak-injak Anak Allah, yang menganggap najis darah perjanjian yang menguduskannya, dan yang menghina Roh kasih karunia?"
 },
 {
   "id": 30181,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 30,
   "firman": "Sebab kita mengenal Dia yang berkata: \"Pembalasan adalah hak-Ku. Akulah yang akan menuntut pembalasan.\" Dan lagi: \"Tuhan akan menghakimi umat-Nya.\""
 },
 {
   "id": 30182,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 31,
   "firman": "Ngeri benar, kalau jatuh ke dalam tangan Allah yang hidup."
 },
 {
   "id": 30183,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 32,
   "firman": "Ingatlah akan masa yang lalu. Sesudah kamu menerima terang, kamu banyak menderita oleh karena kamu bertahan dalam perjuangan yang berat,"
 },
 {
   "id": 30184,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 33,
   "firman": "baik waktu kamu dijadikan tontonan oleh cercaan dan penderitaan, maupun waktu kamu mengambil bagian dalam penderitaan mereka yang diperlakukan sedemikian."
 },
 {
   "id": 30185,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 34,
   "firman": "Memang kamu telah turut mengambil bagian dalam penderitaan orang-orang hukuman dan ketika harta kamu dirampas, kamu menerima hal itu dengan sukacita, sebab kamu tahu, bahwa kamu memiliki harta yang lebih baik dan yang lebih menetap sifatnya."
 },
 {
   "id": 30186,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 35,
   "firman": "Sebab itu janganlah kamu melepaskan kepercayaanmu, karena besar upah yang menantinya."
 },
 {
   "id": 30187,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 36,
   "firman": "Sebab kamu memerlukan ketekunan, supaya sesudah kamu melakukan kehendak Allah, kamu memperoleh apa yang dijanjikan itu."
 },
 {
   "id": 30188,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 37,
   "firman": "\"Sebab sedikit, bahkan sangat sedikit waktu lagi, dan Ia yang akan datang, sudah akan ada, tanpa menangguhkan kedatangan-Nya."
 },
 {
   "id": 30189,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 38,
   "firman": "Tetapi orang-Ku yang benar akan hidup oleh iman, dan apabila ia mengundurkan diri, maka Aku tidak berkenan kepadanya.\""
 },
 {
   "id": 30190,
   "kitab": "Ibr",
   "pasal": 10,
   "ayat": 39,
   "firman": "Tetapi kita bukanlah orang-orang yang mengundurkan diri dan binasa, tetapi orang-orang yang percaya dan yang beroleh hidup."
 },
 {
   "id": 30191,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 1,
   "firman": "Iman adalah dasar dari segala sesuatu yang kita harapkan dan bukti dari segala sesuatu yang tidak kita lihat."
 },
 {
   "id": 30192,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 2,
   "firman": "Sebab oleh imanlah telah diberikan kesaksian kepada nenek moyang kita."
 },
 {
   "id": 30193,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 3,
   "firman": "Karena iman kita mengerti, bahwa alam semesta telah dijadikan oleh firman Allah, sehingga apa yang kita lihat telah terjadi dari apa yang tidak dapat kita lihat."
 },
 {
   "id": 30194,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 4,
   "firman": "Karena iman Habel telah mempersembahkan kepada Allah korban yang lebih baik dari pada korban Kain. Dengan jalan itu ia memperoleh kesaksian kepadanya, bahwa ia benar, karena Allah berkenan akan persembahannya itu dan karena iman ia masih berbicara, sesudah ia mati."
 },
 {
   "id": 30195,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 5,
   "firman": "Karena iman Henokh terangkat, supaya ia tidak mengalami kematian, dan ia tidak ditemukan, karena Allah telah mengangkatnya. Sebab sebelum ia terangkat, ia memperoleh kesaksian, bahwa ia berkenan kepada Allah."
 },
 {
   "id": 30196,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 6,
   "firman": "Tetapi tanpa iman tidak mungkin orang berkenan kepada Allah. Sebab barangsiapa berpaling kepada Allah, ia harus percaya bahwa Allah ada, dan bahwa Allah memberi upah kepada orang yang sungguh-sungguh mencari Dia."
 },
 {
   "id": 30197,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 7,
   "firman": "Karena iman, maka Nuh--dengan petunjuk Allah tentang sesuatu yang belum kelihatan--dengan taat mempersiapkan bahtera untuk menyelamatkan keluarganya; dan karena iman itu ia menghukum dunia, dan ia ditentukan untuk menerima kebenaran, sesuai dengan imannya."
 },
 {
   "id": 30198,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 8,
   "firman": "Karena iman Abraham taat, ketika ia dipanggil untuk berangkat ke negeri yang akan diterimanya menjadi milik pusakanya, lalu ia berangkat dengan tidak mengetahui tempat yang ia tujui."
 },
 {
   "id": 30199,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 9,
   "firman": "Karena iman ia diam di tanah yang dijanjikan itu seolah-olah di suatu tanah asing dan di situ ia tinggal di kemah dengan Ishak dan Yakub, yang turut menjadi ahli waris janji yang satu itu."
 },
 {
   "id": 30200,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 10,
   "firman": "Sebab ia menanti-nantikan kota yang mempunyai dasar, yang direncanakan dan dibangun oleh Allah."
 },
 {
   "id": 30201,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 11,
   "firman": "Karena iman ia juga dan Sara beroleh kekuatan untuk menurunkan anak cucu, walaupun usianya sudah lewat, karena ia menganggap Dia, yang memberikan janji itu setia."
 },
 {
   "id": 30202,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 12,
   "firman": "Itulah sebabnya, maka dari satu orang, malahan orang yang telah mati pucuk, terpancar keturunan besar, seperti bintang di langit dan seperti pasir di tepi laut, yang tidak terhitung banyaknya."
 },
 {
   "id": 30203,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 13,
   "firman": "Dalam iman mereka semua ini telah mati sebagai orang-orang yang tidak memperoleh apa yang dijanjikan itu, tetapi yang hanya dari jauh melihatnya dan melambai-lambai kepadanya dan yang mengakui, bahwa mereka adalah orang asing dan pendatang di bumi ini."
 },
 {
   "id": 30204,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 14,
   "firman": "Sebab mereka yang berkata demikian menyatakan, bahwa mereka dengan rindu mencari suatu tanah air."
 },
 {
   "id": 30205,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 15,
   "firman": "Dan kalau sekiranya dalam hal itu mereka ingat akan tanah asal, yang telah mereka tinggalkan, maka mereka cukup mempunyai kesempatan untuk pulang ke situ."
 },
 {
   "id": 30206,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 16,
   "firman": "Tetapi sekarang mereka merindukan tanah air yang lebih baik yaitu satu tanah air sorgawi. Sebab itu Allah tidak malu disebut Allah mereka, karena Ia telah mempersiapkan sebuah kota bagi mereka."
 },
 {
   "id": 30207,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 17,
   "firman": "Karena iman maka Abraham, tatkala ia dicobai, mempersembahkan Ishak. Ia, yang telah menerima janji itu, rela mempersembahkan anaknya yang tunggal,"
 },
 {
   "id": 30208,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 18,
   "firman": "walaupun kepadanya telah dikatakan: \"Keturunan yang berasal dari Ishaklah yang akan disebut keturunanmu.\""
 },
 {
   "id": 30209,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 19,
   "firman": "Karena ia berpikir, bahwa Allah berkuasa membangkitkan orang-orang sekalipun dari antara orang mati. Dan dari sana ia seakan-akan telah menerimanya kembali."
 },
 {
   "id": 30210,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 20,
   "firman": "Karena iman maka Ishak, sambil memandang jauh ke depan, memberikan berkatnya kepada Yakub dan Esau."
 },
 {
   "id": 30211,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 21,
   "firman": "Karena iman maka Yakub, ketika hampir waktunya akan mati, memberkati kedua anak Yusuf, lalu menyembah sambil bersandar pada kepala tongkatnya."
 },
 {
   "id": 30212,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 22,
   "firman": "Karena iman maka Yusuf menjelang matinya memberitakan tentang keluarnya orang-orang Israel dan memberi pesan tentang tulang-belulangnya."
 },
 {
   "id": 30213,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 23,
   "firman": "Karena iman maka Musa, setelah ia lahir, disembunyikan selama tiga bulan oleh orang tuanya, karena mereka melihat, bahwa anak itu elok rupanya dan mereka tidak takut akan perintah raja."
 },
 {
   "id": 30214,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 24,
   "firman": "Karena iman maka Musa, setelah dewasa, menolak disebut anak puteri Firaun,"
 },
 {
   "id": 30215,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 25,
   "firman": "karena ia lebih suka menderita sengsara dengan umat Allah dari pada untuk sementara menikmati kesenangan dari dosa."
 },
 {
   "id": 30216,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 26,
   "firman": "Ia menganggap penghinaan karena Kristus sebagai kekayaan yang lebih besar dari pada semua harta Mesir, sebab pandangannya ia arahkan kepada upah."
 },
 {
   "id": 30217,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 27,
   "firman": "Karena iman maka ia telah meninggalkan Mesir dengan tidak takut akan murka raja. Ia bertahan sama seperti ia melihat apa yang tidak kelihatan."
 },
 {
   "id": 30218,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 28,
   "firman": "Karena iman maka ia mengadakan Paskah dan pemercikan darah, supaya pembinasa anak-anak sulung jangan menyentuh mereka."
 },
 {
   "id": 30219,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 29,
   "firman": "Karena iman maka mereka telah melintasi Laut Merah sama seperti melintasi tanah kering, sedangkan orang-orang Mesir tenggelam, ketika mereka mencobanya juga."
 },
 {
   "id": 30220,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 30,
   "firman": "Karena iman maka runtuhlah tembok-tembok Yerikho, setelah kota itu dikelilingi tujuh hari lamanya."
 },
 {
   "id": 30221,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 31,
   "firman": "Karena iman maka Rahab, perempuan sundal itu, tidak turut binasa bersama-sama dengan orang-orang durhaka, karena ia telah menyambut pengintai-pengintai itu dengan baik."
 },
 {
   "id": 30222,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 32,
   "firman": "Dan apakah lagi yang harus aku sebut? Sebab aku akan kekurangan waktu, apabila aku hendak menceriterakan tentang Gideon, Barak, Simson, Yefta, Daud dan Samuel dan para nabi,"
 },
 {
   "id": 30223,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 33,
   "firman": "yang karena iman telah menaklukkan kerajaan-kerajaan, mengamalkan kebenaran, memperoleh apa yang dijanjikan, menutup mulut singa-singa,"
 },
 {
   "id": 30224,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 34,
   "firman": "memadamkan api yang dahsyat. Mereka telah luput dari mata pedang, telah beroleh kekuatan dalam kelemahan, telah menjadi kuat dalam peperangan dan telah memukul mundur pasukan-pasukan tentara asing."
 },
 {
   "id": 30225,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 35,
   "firman": "Ibu-ibu telah menerima kembali orang-orangnya yang telah mati, sebab dibangkitkan. Tetapi orang-orang lain membiarkan dirinya disiksa dan tidak mau menerima pembebasan, supaya mereka beroleh kebangkitan yang lebih baik."
 },
 {
   "id": 30226,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 36,
   "firman": "Ada pula yang diejek dan didera, bahkan yang dibelenggu dan dipenjarakan."
 },
 {
   "id": 30227,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 37,
   "firman": "Mereka dilempari, digergaji, dibunuh dengan pedang; mereka mengembara dengan berpakaian kulit domba dan kulit kambing sambil menderita kekurangan, kesesakan dan siksaan."
 },
 {
   "id": 30228,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 38,
   "firman": "Dunia ini tidak layak bagi mereka. Mereka mengembara di padang gurun dan di pegunungan, dalam gua-gua dan celah-celah gunung."
 },
 {
   "id": 30229,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 39,
   "firman": "Dan mereka semua tidak memperoleh apa yang dijanjikan itu, sekalipun iman mereka telah memberikan kepada mereka suatu kesaksian yang baik."
 },
 {
   "id": 30230,
   "kitab": "Ibr",
   "pasal": 11,
   "ayat": 40,
   "firman": "Sebab Allah telah menyediakan sesuatu yang lebih baik bagi kita; tanpa kita mereka tidak dapat sampai kepada kesempurnaan."
 },
 {
   "id": 30231,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 1,
   "firman": "Karena kita mempunyai banyak saksi, bagaikan awan yang mengelilingi kita, marilah kita menanggalkan semua beban dan dosa yang begitu merintangi kita, dan berlomba dengan tekun dalam perlombaan yang diwajibkan bagi kita."
 },
 {
   "id": 30232,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 2,
   "firman": "Marilah kita melakukannya dengan mata yang tertuju kepada Yesus, yang memimpin kita dalam iman, dan yang membawa iman kita itu kepada kesempurnaan, yang dengan mengabaikan kehinaan tekun memikul salib ganti sukacita yang disediakan bagi Dia, yang sekarang duduk di sebelah kanan takhta Allah."
 },
 {
   "id": 30233,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 3,
   "firman": "Ingatlah selalu akan Dia, yang tekun menanggung bantahan yang sehebat itu terhadap diri-Nya dari pihak orang-orang berdosa, supaya jangan kamu menjadi lemah dan putus asa."
 },
 {
   "id": 30234,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 4,
   "firman": "Dalam pergumulan kamu melawan dosa kamu belum sampai mencucurkan darah."
 },
 {
   "id": 30235,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 5,
   "firman": "Dan sudah lupakah kamu akan nasihat yang berbicara kepada kamu seperti kepada anak-anak: \"Hai anakku, janganlah anggap enteng didikan Tuhan, dan janganlah putus asa apabila engkau diperingatkan-Nya;"
 },
 {
   "id": 30236,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 6,
   "firman": "karena Tuhan menghajar orang yang dikasihi-Nya, dan Ia menyesah orang yang diakui-Nya sebagai anak.\""
 },
 {
   "id": 30237,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 7,
   "firman": "Jika kamu harus menanggung ganjaran; Allah memperlakukan kamu seperti anak. Di manakah terdapat anak yang tidak dihajar oleh ayahnya?"
 },
 {
   "id": 30238,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 8,
   "firman": "Tetapi, jikalau kamu bebas dari ganjaran, yang harus diderita setiap orang, maka kamu bukanlah anak, tetapi anak-anak gampang."
 },
 {
   "id": 30239,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 9,
   "firman": "Selanjutnya: dari ayah kita yang sebenarnya kita beroleh ganjaran, dan mereka kita hormati; kalau demikian bukankah kita harus lebih taat kepada Bapa segala roh, supaya kita boleh hidup?"
 },
 {
   "id": 30240,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 10,
   "firman": "Sebab mereka mendidik kita dalam waktu yang pendek sesuai dengan apa yang mereka anggap baik, tetapi Dia menghajar kita untuk kebaikan kita, supaya kita beroleh bagian dalam kekudusan-Nya."
 },
 {
   "id": 30241,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 11,
   "firman": "Memang tiap-tiap ganjaran pada waktu ia diberikan tidak mendatangkan sukacita, tetapi dukacita. Tetapi kemudian ia menghasilkan buah kebenaran yang memberikan damai kepada mereka yang dilatih olehnya."
 },
 {
   "id": 30242,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 12,
   "firman": "Sebab itu kuatkanlah tangan yang lemah dan lutut yang goyah;"
 },
 {
   "id": 30243,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 13,
   "firman": "dan luruskanlah jalan bagi kakimu, sehingga yang pincang jangan terpelecok, tetapi menjadi sembuh."
 },
 {
   "id": 30244,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 14,
   "firman": "Berusahalah hidup damai dengan semua orang dan kejarlah kekudusan, sebab tanpa kekudusan tidak seorangpun akan melihat Tuhan."
 },
 {
   "id": 30245,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 15,
   "firman": "Jagalah supaya jangan ada seorangpun menjauhkan diri dari kasih karunia Allah, agar jangan tumbuh akar yang pahit yang menimbulkan kerusuhan dan yang mencemarkan banyak orang."
 },
 {
   "id": 30246,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 16,
   "firman": "Janganlah ada orang yang menjadi cabul atau yang mempunyai nafsu yang rendah seperti Esau, yang menjual hak kesulungannya untuk sepiring makanan."
 },
 {
   "id": 30247,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 17,
   "firman": "Sebab kamu tahu, bahwa kemudian, ketika ia hendak menerima berkat itu, ia ditolak, sebab ia tidak beroleh kesempatan untuk memperbaiki kesalahannya, sekalipun ia mencarinya dengan mencucurkan air mata."
 },
 {
   "id": 30248,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 18,
   "firman": "Sebab kamu tidak datang kepada gunung yang dapat disentuh dan api yang menyala-nyala, kepada kekelaman, kegelapan dan angin badai,"
 },
 {
   "id": 30249,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 19,
   "firman": "kepada bunyi sangkakala dan bunyi suara yang membuat mereka yang mendengarnya memohon, supaya jangan lagi berbicara kepada mereka,"
 },
 {
   "id": 30250,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 20,
   "firman": "sebab mereka tidak tahan mendengar perintah ini: \"Bahkan jika binatangpun yang menyentuh gunung, ia harus dilempari dengan batu.\""
 },
 {
   "id": 30251,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 21,
   "firman": "Dan sangat mengerikan pemandangan itu, sehingga Musa berkata: \"Aku sangat ketakutan dan sangat gemetar.\""
 },
 {
   "id": 30252,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 22,
   "firman": "Tetapi kamu sudah datang ke Bukit Sion, ke kota Allah yang hidup, Yerusalem sorgawi dan kepada beribu-ribu malaikat, suatu kumpulan yang meriah,"
 },
 {
   "id": 30253,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 23,
   "firman": "dan kepada jemaat anak-anak sulung, yang namanya terdaftar di sorga, dan kepada Allah, yang menghakimi semua orang, dan kepada roh-roh orang-orang benar yang telah menjadi sempurna,"
 },
 {
   "id": 30254,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 24,
   "firman": "dan kepada Yesus, Pengantara perjanjian baru, dan kepada darah pemercikan, yang berbicara lebih kuat dari pada darah Habel."
 },
 {
   "id": 30255,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 25,
   "firman": "Jagalah supaya kamu jangan menolak Dia, yang berfirman. Sebab jikalau mereka, yang menolak Dia yang menyampaikan firman Allah di bumi, tidak luput, apa lagi kita, jika kita berpaling dari Dia yang berbicara dari sorga?"
 },
 {
   "id": 30256,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 26,
   "firman": "Waktu itu suara-Nya menggoncangkan bumi, tetapi sekarang Ia memberikan janji: \"Satu kali lagi Aku akan menggoncangkan bukan hanya bumi saja, melainkan langit juga.\""
 },
 {
   "id": 30257,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 27,
   "firman": "Ungkapan \"Satu kali lagi\" menunjuk kepada perubahan pada apa yang dapat digoncangkan, karena ia dijadikan supaya tinggal tetap apa yang tidak tergoncangkan."
 },
 {
   "id": 30258,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 28,
   "firman": "Jadi, karena kita menerima kerajaan yang tidak tergoncangkan, marilah kita mengucap syukur dan beribadah kepada Allah menurut cara yang berkenan kepada-Nya, dengan hormat dan takut."
 },
 {
   "id": 30259,
   "kitab": "Ibr",
   "pasal": 12,
   "ayat": 29,
   "firman": "Sebab Allah kita adalah api yang menghanguskan."
 },
 {
   "id": 30260,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 1,
   "firman": "Peliharalah kasih persaudaraan!"
 },
 {
   "id": 30261,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 2,
   "firman": "Jangan kamu lupa memberi tumpangan kepada orang, sebab dengan berbuat demikian beberapa orang dengan tidak diketahuinya telah menjamu malaikat-malaikat."
 },
 {
   "id": 30262,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 3,
   "firman": "Ingatlah akan orang-orang hukuman, karena kamu sendiri juga adalah orang-orang hukuman. Dan ingatlah akan orang-orang yang diperlakukan sewenang-wenang, karena kamu sendiri juga masih hidup di dunia ini."
 },
 {
   "id": 30263,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 4,
   "firman": "Hendaklah kamu semua penuh hormat terhadap perkawinan dan janganlah kamu mencemarkan tempat tidur, sebab orang-orang sundal dan pezinah akan dihakimi Allah."
 },
 {
   "id": 30264,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 5,
   "firman": "Janganlah kamu menjadi hamba uang dan cukupkanlah dirimu dengan apa yang ada padamu. Karena Allah telah berfirman: \"Aku sekali-kali tidak akan membiarkan engkau dan Aku sekali-kali tidak akan meninggalkan engkau.\""
 },
 {
   "id": 30265,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 6,
   "firman": "Sebab itu dengan yakin kita dapat berkata: \"Tuhan adalah Penolongku. Aku tidak akan takut. Apakah yang dapat dilakukan manusia terhadap aku?\""
 },
 {
   "id": 30266,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 7,
   "firman": "Ingatlah akan pemimpin-pemimpin kamu, yang telah menyampaikan firman Allah kepadamu. Perhatikanlah akhir hidup mereka dan contohlah iman mereka."
 },
 {
   "id": 30267,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 8,
   "firman": "Yesus Kristus tetap sama, baik kemarin maupun hari ini dan sampai selama-lamanya."
 },
 {
   "id": 30268,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 9,
   "firman": "Janganlah kamu disesatkan oleh berbagai-bagai ajaran asing. Sebab yang baik ialah, bahwa hati kamu diperkuat dengan kasih karunia dan bukan dengan pelbagai makanan yang tidak memberi faedah kepada mereka yang menuruti aturan-aturan makanan macam itu."
 },
 {
   "id": 30269,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kita mempunyai suatu mezbah dan orang-orang yang melayani kemah tidak boleh makan dari apa yang di dalamnya."
 },
 {
   "id": 30270,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 11,
   "firman": "Karena tubuh binatang-binatang yang darahnya dibawa masuk ke tempat kudus oleh Imam Besar sebagai korban penghapus dosa, dibakar di luar perkemahan."
 },
 {
   "id": 30271,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 12,
   "firman": "Itu jugalah sebabnya Yesus telah menderita di luar pintu gerbang untuk menguduskan umat-Nya dengan darah-Nya sendiri."
 },
 {
   "id": 30272,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 13,
   "firman": "Karena itu marilah kita pergi kepada-Nya di luar perkemahan dan menanggung kehinaan-Nya."
 },
 {
   "id": 30273,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 14,
   "firman": "Sebab di sini kita tidak mempunyai tempat tinggal yang tetap; kita mencari kota yang akan datang."
 },
 {
   "id": 30274,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 15,
   "firman": "Sebab itu marilah kita, oleh Dia, senantiasa mempersembahkan korban syukur kepada Allah, yaitu ucapan bibir yang memuliakan nama-Nya."
 },
 {
   "id": 30275,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 16,
   "firman": "Dan janganlah kamu lupa berbuat baik dan memberi bantuan, sebab korban-korban yang demikianlah yang berkenan kepada Allah."
 },
 {
   "id": 30276,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 17,
   "firman": "Taatilah pemimpin-pemimpinmu dan tunduklah kepada mereka, sebab mereka berjaga-jaga atas jiwamu, sebagai orang-orang yang harus bertanggung jawab atasnya. Dengan jalan itu mereka akan melakukannya dengan gembira, bukan dengan keluh kesah, sebab hal itu tidak akan membawa keuntungan bagimu."
 },
 {
   "id": 30277,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 18,
   "firman": "Berdoalah terus untuk kami; sebab kami yakin, bahwa hati nurani kami adalah baik, karena di dalam segala hal kami menginginkan suatu hidup yang baik."
 },
 {
   "id": 30278,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 19,
   "firman": "Dan secara khusus aku menasihatkan kamu, agar kamu melakukannya, supaya aku lebih lekas dikembalikan kepada kamu."
 },
 {
   "id": 30279,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 20,
   "firman": "Maka Allah damai sejahtera, yang oleh darah perjanjian yang kekal telah membawa kembali dari antara orang mati Gembala Agung segala domba, yaitu Yesus, Tuhan kita,"
 },
 {
   "id": 30280,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 21,
   "firman": "kiranya memperlengkapi kamu dengan segala yang baik untuk melakukan kehendak-Nya, dan mengerjakan di dalam kita apa yang berkenan kepada-Nya, oleh Yesus Kristus. Bagi Dialah kemuliaan sampai selama-lamanya! Amin."
 },
 {
   "id": 30281,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 22,
   "firman": "Dan aku menasihatkan kamu, saudara-saudara, supaya kata-kata nasihat ini kamu sambut dengan rela hati, sekalipun pendek saja suratku ini kepada kamu."
 },
 {
   "id": 30282,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 23,
   "firman": "Ketahuilah, bahwa Timotius, saudara kita, telah berangkat. Segera sesudah ia datang, aku akan mengunjungi kamu bersama-sama dengan dia."
 },
 {
   "id": 30283,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 24,
   "firman": "Sampaikanlah salam kepada semua pemimpin kamu dan semua orang kudus. Terimalah salam dari saudara-saudara di Italia."
 },
 {
   "id": 30284,
   "kitab": "Ibr",
   "pasal": 13,
   "ayat": 25,
   "firman": "Kasih karunia menyertai kamu sekalian."
 },
 {
   "id": 30285,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 1,
   "firman": "Salam dari Yakobus, hamba Allah dan Tuhan Yesus Kristus, kepada kedua belas suku di perantauan."
 },
 {
   "id": 30286,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 2,
   "firman": "Saudara-saudaraku, anggaplah sebagai suatu kebahagiaan, apabila kamu jatuh ke dalam berbagai-bagai pencobaan,"
 },
 {
   "id": 30287,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 3,
   "firman": "sebab kamu tahu, bahwa ujian terhadap imanmu itu menghasilkan ketekunan."
 },
 {
   "id": 30288,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan biarkanlah ketekunan itu memperoleh buah yang matang, supaya kamu menjadi sempurna dan utuh dan tak kekurangan suatu apapun."
 },
 {
   "id": 30289,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 5,
   "firman": "Tetapi apabila di antara kamu ada yang kekurangan hikmat, hendaklah ia memintakannya kepada Allah, --yang memberikan kepada semua orang dengan murah hati dan dengan tidak membangkit-bangkit--,maka hal itu akan diberikan kepadanya."
 },
 {
   "id": 30290,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 6,
   "firman": "Hendaklah ia memintanya dalam iman, dan sama sekali jangan bimbang, sebab orang yang bimbang sama dengan gelombang laut, yang diombang-ambingkan kian ke mari oleh angin."
 },
 {
   "id": 30291,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 7,
   "firman": "Orang yang demikian janganlah mengira, bahwa ia akan menerima sesuatu dari Tuhan."
 },
 {
   "id": 30292,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sebab orang yang mendua hati tidak akan tenang dalam hidupnya."
 },
 {
   "id": 30293,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 9,
   "firman": "Baiklah saudara yang berada dalam keadaan yang rendah bermegah karena kedudukannya yang tinggi,"
 },
 {
   "id": 30294,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 10,
   "firman": "dan orang kaya karena kedudukannya yang rendah sebab ia akan lenyap seperti bunga rumput."
 },
 {
   "id": 30295,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 11,
   "firman": "Karena matahari terbit dengan panasnya yang terik dan melayukan rumput itu, sehingga gugurlah bunganya dan hilanglah semaraknya. Demikian jugalah halnya dengan orang kaya; di tengah-tengah segala usahanya ia akan lenyap."
 },
 {
   "id": 30296,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 12,
   "firman": "Berbahagialah orang yang bertahan dalam pencobaan, sebab apabila ia sudah tahan uji, ia akan menerima mahkota kehidupan yang dijanjikan Allah kepada barangsiapa yang mengasihi Dia."
 },
 {
   "id": 30297,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 13,
   "firman": "Apabila seorang dicobai, janganlah ia berkata: \"Pencobaan ini datang dari Allah!\" Sebab Allah tidak dapat dicobai oleh yang jahat, dan Ia sendiri tidak mencobai siapapun."
 },
 {
   "id": 30298,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 14,
   "firman": "Tetapi tiap-tiap orang dicobai oleh keinginannya sendiri, karena ia diseret dan dipikat olehnya."
 },
 {
   "id": 30299,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 15,
   "firman": "Dan apabila keinginan itu telah dibuahi, ia melahirkan dosa; dan apabila dosa itu sudah matang, ia melahirkan maut."
 },
 {
   "id": 30300,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 16,
   "firman": "Saudara-saudara yang kukasihi, janganlah sesat!"
 },
 {
   "id": 30301,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 17,
   "firman": "Setiap pemberian yang baik dan setiap anugerah yang sempurna, datangnya dari atas, diturunkan dari Bapa segala terang; pada-Nya tidak ada perubahan atau bayangan karena pertukaran."
 },
 {
   "id": 30302,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 18,
   "firman": "Atas kehendak-Nya sendiri Ia telah menjadikan kita oleh firman kebenaran, supaya kita pada tingkat yang tertentu menjadi anak sulung di antara semua ciptaan-Nya."
 },
 {
   "id": 30303,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 19,
   "firman": "Hai saudara-saudara yang kukasihi, ingatlah hal ini: setiap orang hendaklah cepat untuk mendengar, tetapi lambat untuk berkata-kata, dan juga lambat untuk marah;"
 },
 {
   "id": 30304,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 20,
   "firman": "sebab amarah manusia tidak mengerjakan kebenaran di hadapan Allah."
 },
 {
   "id": 30305,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 21,
   "firman": "Sebab itu buanglah segala sesuatu yang kotor dan kejahatan yang begitu banyak itu dan terimalah dengan lemah lembut firman yang tertanam di dalam hatimu, yang berkuasa menyelamatkan jiwamu."
 },
 {
   "id": 30306,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tetapi hendaklah kamu menjadi pelaku firman dan bukan hanya pendengar saja; sebab jika tidak demikian kamu menipu diri sendiri."
 },
 {
   "id": 30307,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 23,
   "firman": "Sebab jika seorang hanya mendengar firman saja dan tidak melakukannya, ia adalah seumpama seorang yang sedang mengamat-amati mukanya yang sebenarnya di depan cermin."
 },
 {
   "id": 30308,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 24,
   "firman": "Baru saja ia memandang dirinya, ia sudah pergi atau ia segera lupa bagaimana rupanya."
 },
 {
   "id": 30309,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 25,
   "firman": "Tetapi barangsiapa meneliti hukum yang sempurna, yaitu hukum yang memerdekakan orang, dan ia bertekun di dalamnya, jadi bukan hanya mendengar untuk melupakannya, tetapi sungguh-sungguh melakukannya, ia akan berbahagia oleh perbuatannya."
 },
 {
   "id": 30310,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 26,
   "firman": "Jikalau ada seorang menganggap dirinya beribadah, tetapi tidak mengekang lidahnya, ia menipu dirinya sendiri, maka sia-sialah ibadahnya."
 },
 {
   "id": 30311,
   "kitab": "Yak",
   "pasal": 1,
   "ayat": 27,
   "firman": "Ibadah yang murni dan yang tak bercacat di hadapan Allah, Bapa kita, ialah mengunjungi yatim piatu dan janda-janda dalam kesusahan mereka, dan menjaga supaya dirinya sendiri tidak dicemarkan oleh dunia."
 },
 {
   "id": 30312,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 1,
   "firman": "Saudara-saudaraku, sebagai orang yang beriman kepada Yesus Kristus, Tuhan kita yang mulia, janganlah iman itu kamu amalkan dengan memandang muka."
 },
 {
   "id": 30313,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 2,
   "firman": "Sebab, jika ada seorang masuk ke dalam kumpulanmu dengan memakai cincin emas dan pakaian indah dan datang juga seorang miskin ke situ dengan memakai pakaian buruk,"
 },
 {
   "id": 30314,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 3,
   "firman": "dan kamu menghormati orang yang berpakaian indah itu dan berkata kepadanya: \"Silakan tuan duduk di tempat yang baik ini!\", sedang kepada orang yang miskin itu kamu berkata: \"Berdirilah di sana!\" atau: \"Duduklah di lantai ini dekat tumpuan kakiku!\","
 },
 {
   "id": 30315,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 4,
   "firman": "bukankah kamu telah membuat pembedaan di dalam hatimu dan bertindak sebagai hakim dengan pikiran yang jahat?"
 },
 {
   "id": 30316,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dengarkanlah, hai saudara-saudara yang kukasihi! Bukankah Allah memilih orang-orang yang dianggap miskin oleh dunia ini untuk menjadi kaya dalam iman dan menjadi ahli waris Kerajaan yang telah dijanjikan-Nya kepada barangsiapa yang mengasihi Dia?"
 },
 {
   "id": 30317,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tetapi kamu telah menghinakan orang-orang miskin. Bukankah justru orang-orang kaya yang menindas kamu dan yang menyeret kamu ke pengadilan?"
 },
 {
   "id": 30318,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 7,
   "firman": "Bukankah mereka yang menghujat Nama yang mulia, yang oleh-Nya kamu menjadi milik Allah?"
 },
 {
   "id": 30319,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 8,
   "firman": "Akan tetapi, jikalau kamu menjalankan hukum utama yang tertulis dalam Kitab Suci: \"Kasihilah sesamamu manusia seperti dirimu sendiri\", kamu berbuat baik."
 },
 {
   "id": 30320,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tetapi, jikalau kamu memandang muka, kamu berbuat dosa, dan oleh hukum itu menjadi nyata, bahwa kamu melakukan pelanggaran."
 },
 {
   "id": 30321,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 10,
   "firman": "Sebab barangsiapa menuruti seluruh hukum itu, tetapi mengabaikan satu bagian dari padanya, ia bersalah terhadap seluruhnya."
 },
 {
   "id": 30322,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 11,
   "firman": "Sebab Ia yang mengatakan: \"Jangan berzinah\", Ia mengatakan juga: \"Jangan membunuh\". Jadi jika kamu tidak berzinah tetapi membunuh, maka kamu menjadi pelanggar hukum juga."
 },
 {
   "id": 30323,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 12,
   "firman": "Berkatalah dan berlakulah seperti orang-orang yang akan dihakimi oleh hukum yang memerdekakan orang."
 },
 {
   "id": 30324,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 13,
   "firman": "Sebab penghakiman yang tak berbelas kasihan akan berlaku atas orang yang tidak berbelas kasihan. Tetapi belas kasihan akan menang atas penghakiman."
 },
 {
   "id": 30325,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 14,
   "firman": "Apakah gunanya, saudara-saudaraku, jika seorang mengatakan, bahwa ia mempunyai iman, padahal ia tidak mempunyai perbuatan? Dapatkah iman itu menyelamatkan dia?"
 },
 {
   "id": 30326,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 15,
   "firman": "Jika seorang saudara atau saudari tidak mempunyai pakaian dan kekurangan makanan sehari-hari,"
 },
 {
   "id": 30327,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 16,
   "firman": "dan seorang dari antara kamu berkata: \"Selamat jalan, kenakanlah kain panas dan makanlah sampai kenyang!\", tetapi ia tidak memberikan kepadanya apa yang perlu bagi tubuhnya, apakah gunanya itu?"
 },
 {
   "id": 30328,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 17,
   "firman": "Demikian juga halnya dengan iman: Jika iman itu tidak disertai perbuatan, maka iman itu pada hakekatnya adalah mati."
 },
 {
   "id": 30329,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 18,
   "firman": "Tetapi mungkin ada orang berkata: \"Padamu ada iman dan padaku ada perbuatan\", aku akan menjawab dia: \"Tunjukkanlah kepadaku imanmu itu tanpa perbuatan, dan aku akan menunjukkan kepadamu imanku dari perbuatan-perbuatanku.\""
 },
 {
   "id": 30330,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 19,
   "firman": "Engkau percaya, bahwa hanya ada satu Allah saja? Itu baik! Tetapi setan-setanpun juga percaya akan hal itu dan mereka gemetar."
 },
 {
   "id": 30331,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 20,
   "firman": "Hai manusia yang bebal, maukah engkau mengakui sekarang, bahwa iman tanpa perbuatan adalah iman yang kosong?"
 },
 {
   "id": 30332,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 21,
   "firman": "Bukankah Abraham, bapa kita, dibenarkan karena perbuatan-perbuatannya, ketika ia mempersembahkan Ishak, anaknya, di atas mezbah?"
 },
 {
   "id": 30333,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 22,
   "firman": "Kamu lihat, bahwa iman bekerjasama dengan perbuatan-perbuatan dan oleh perbuatan-perbuatan itu iman menjadi sempurna."
 },
 {
   "id": 30334,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 23,
   "firman": "Dengan jalan demikian genaplah nas yang mengatakan: \"Lalu percayalah Abraham kepada Allah, maka Allah memperhitungkan hal itu kepadanya sebagai kebenaran.\" Karena itu Abraham disebut: \"Sahabat Allah.\""
 },
 {
   "id": 30335,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 24,
   "firman": "Jadi kamu lihat, bahwa manusia dibenarkan karena perbuatan-perbuatannya dan bukan hanya karena iman."
 },
 {
   "id": 30336,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 25,
   "firman": "Dan bukankah demikian juga Rahab, pelacur itu, dibenarkan karena perbuatan-perbuatannya, ketika ia menyembunyikan orang-orang yang disuruh itu di dalam rumahnya, lalu menolong mereka lolos melalui jalan yang lain?"
 },
 {
   "id": 30337,
   "kitab": "Yak",
   "pasal": 2,
   "ayat": 26,
   "firman": "Sebab seperti tubuh tanpa roh adalah mati, demikian jugalah iman tanpa perbuatan-perbuatan adalah mati."
 },
 {
   "id": 30338,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 1,
   "firman": "Saudara-saudaraku, janganlah banyak orang di antara kamu mau menjadi guru; sebab kita tahu, bahwa sebagai guru kita akan dihakimi menurut ukuran yang lebih berat."
 },
 {
   "id": 30339,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 2,
   "firman": "Sebab kita semua bersalah dalam banyak hal; barangsiapa tidak bersalah dalam perkataannya, ia adalah orang sempurna, yang dapat juga mengendalikan seluruh tubuhnya."
 },
 {
   "id": 30340,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 3,
   "firman": "Kita mengenakan kekang pada mulut kuda, sehingga ia menuruti kehendak kita, dengan jalan demikian kita dapat juga mengendalikan seluruh tubuhnya."
 },
 {
   "id": 30341,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 4,
   "firman": "Dan lihat saja kapal-kapal, walaupun amat besar dan digerakkan oleh angin keras, namun dapat dikendalikan oleh kemudi yang amat kecil menurut kehendak jurumudi."
 },
 {
   "id": 30342,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 5,
   "firman": "Demikian juga lidah, walaupun suatu anggota kecil dari tubuh, namun dapat memegahkan perkara-perkara yang besar. Lihatlah, betapapun kecilnya api, ia dapat membakar hutan yang besar."
 },
 {
   "id": 30343,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lidahpun adalah api; ia merupakan suatu dunia kejahatan dan mengambil tempat di antara anggota-anggota tubuh kita sebagai sesuatu yang dapat menodai seluruh tubuh dan menyalakan roda kehidupan kita, sedang ia sendiri dinyalakan oleh api neraka."
 },
 {
   "id": 30344,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 7,
   "firman": "Semua jenis binatang liar, burung-burung, serta binatang-binatang menjalar dan binatang-binatang laut dapat dijinakkan dan telah dijinakkan oleh sifat manusia,"
 },
 {
   "id": 30345,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 8,
   "firman": "tetapi tidak seorangpun yang berkuasa menjinakkan lidah; ia adalah sesuatu yang buas, yang tak terkuasai, dan penuh racun yang mematikan."
 },
 {
   "id": 30346,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 9,
   "firman": "Dengan lidah kita memuji Tuhan, Bapa kita; dan dengan lidah kita mengutuk manusia yang diciptakan menurut rupa Allah,"
 },
 {
   "id": 30347,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 10,
   "firman": "dari mulut yang satu keluar berkat dan kutuk. Hal ini, saudara-saudaraku, tidak boleh demikian terjadi."
 },
 {
   "id": 30348,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 11,
   "firman": "Adakah sumber memancarkan air tawar dan air pahit dari mata air yang sama?"
 },
 {
   "id": 30349,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 12,
   "firman": "Saudara-saudaraku, adakah pohon ara dapat menghasilkan buah zaitun dan adakah pokok anggur dapat menghasilkan buah ara? Demikian juga mata air asin tidak dapat mengeluarkan air tawar."
 },
 {
   "id": 30350,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 13,
   "firman": "Siapakah di antara kamu yang bijak dan berbudi? Baiklah ia dengan cara hidup yang baik menyatakan perbuatannya oleh hikmat yang lahir dari kelemahlembutan."
 },
 {
   "id": 30351,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 14,
   "firman": "Jika kamu menaruh perasaan iri hati dan kamu mementingkan diri sendiri, janganlah kamu memegahkan diri dan janganlah berdusta melawan kebenaran!"
 },
 {
   "id": 30352,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 15,
   "firman": "Itu bukanlah hikmat yang datang dari atas, tetapi dari dunia, dari nafsu manusia, dari setan-setan."
 },
 {
   "id": 30353,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 16,
   "firman": "Sebab di mana ada iri hati dan mementingkan diri sendiri di situ ada kekacauan dan segala macam perbuatan jahat."
 },
 {
   "id": 30354,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 17,
   "firman": "Tetapi hikmat yang dari atas adalah pertama-tama murni, selanjutnya pendamai, peramah, penurut, penuh belas kasihan dan buah-buah yang baik, tidak memihak dan tidak munafik."
 },
 {
   "id": 30355,
   "kitab": "Yak",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan buah yang terdiri dari kebenaran ditaburkan dalam damai untuk mereka yang mengadakan damai."
 },
 {
   "id": 30356,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 1,
   "firman": "Dari manakah datangnya sengketa dan pertengkaran di antara kamu? Bukankah datangnya dari hawa nafsumu yang saling berjuang di dalam tubuhmu?"
 },
 {
   "id": 30357,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 2,
   "firman": "Kamu mengingini sesuatu, tetapi kamu tidak memperolehnya, lalu kamu membunuh; kamu iri hati, tetapi kamu tidak mencapai tujuanmu, lalu kamu bertengkar dan kamu berkelahi. Kamu tidak memperoleh apa-apa, karena kamu tidak berdoa."
 },
 {
   "id": 30358,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 3,
   "firman": "Atau kamu berdoa juga, tetapi kamu tidak menerima apa-apa, karena kamu salah berdoa, sebab yang kamu minta itu hendak kamu habiskan untuk memuaskan hawa nafsumu."
 },
 {
   "id": 30359,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 4,
   "firman": "Hai kamu, orang-orang yang tidak setia! Tidakkah kamu tahu, bahwa persahabatan dengan dunia adalah permusuhan dengan Allah? Jadi barangsiapa hendak menjadi sahabat dunia ini, ia menjadikan dirinya musuh Allah."
 },
 {
   "id": 30360,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 5,
   "firman": "Janganlah kamu menyangka, bahwa Kitab Suci tanpa alasan berkata: \"Roh yang ditempatkan Allah di dalam diri kita, diingini-Nya dengan cemburu!\""
 },
 {
   "id": 30361,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 6,
   "firman": "Tetapi kasih karunia, yang dianugerahkan-Nya kepada kita, lebih besar dari pada itu. Karena itu Ia katakan: \"Allah menentang orang yang congkak, tetapi mengasihani orang yang rendah hati.\""
 },
 {
   "id": 30362,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 7,
   "firman": "Karena itu tunduklah kepada Allah, dan lawanlah Iblis, maka ia akan lari dari padamu!"
 },
 {
   "id": 30363,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 8,
   "firman": "Mendekatlah kepada Allah, dan Ia akan mendekat kepadamu. Tahirkanlah tanganmu, hai kamu orang-orang berdosa! dan sucikanlah hatimu, hai kamu yang mendua hati!"
 },
 {
   "id": 30364,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 9,
   "firman": "Sadarilah kemalanganmu, berdukacita dan merataplah; hendaklah tertawamu kamu ganti dengan ratap dan sukacitamu dengan dukacita."
 },
 {
   "id": 30365,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 10,
   "firman": "Rendahkanlah dirimu di hadapan Tuhan, dan Ia akan meninggikan kamu."
 },
 {
   "id": 30366,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 11,
   "firman": "Saudara-saudaraku, janganlah kamu saling memfitnah! Barangsiapa memfitnah saudaranya atau menghakiminya, ia mencela hukum dan menghakiminya; dan jika engkau menghakimi hukum, maka engkau bukanlah penurut hukum, tetapi hakimnya."
 },
 {
   "id": 30367,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 12,
   "firman": "Hanya ada satu Pembuat hukum dan Hakim, yaitu Dia yang berkuasa menyelamatkan dan membinasakan. Tetapi siapakah engkau, sehingga engkau mau menghakimi sesamamu manusia?"
 },
 {
   "id": 30368,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 13,
   "firman": "Jadi sekarang, hai kamu yang berkata: \"Hari ini atau besok kami berangkat ke kota anu, dan di sana kami akan tinggal setahun dan berdagang serta mendapat untung\","
 },
 {
   "id": 30369,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 14,
   "firman": "sedang kamu tidak tahu apa yang akan terjadi besok. Apakah arti hidupmu? Hidupmu itu sama seperti uap yang sebentar saja kelihatan lalu lenyap."
 },
 {
   "id": 30370,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 15,
   "firman": "Sebenarnya kamu harus berkata: \"Jika Tuhan menghendakinya, kami akan hidup dan berbuat ini dan itu.\""
 },
 {
   "id": 30371,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 16,
   "firman": "Tetapi sekarang kamu memegahkan diri dalam congkakmu, dan semua kemegahan yang demikian adalah salah."
 },
 {
   "id": 30372,
   "kitab": "Yak",
   "pasal": 4,
   "ayat": 17,
   "firman": "Jadi jika seorang tahu bagaimana ia harus berbuat baik, tetapi ia tidak melakukannya, ia berdosa."
 },
 {
   "id": 30373,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 1,
   "firman": "Jadi sekarang hai kamu orang-orang kaya, menangislah dan merataplah atas sengsara yang akan menimpa kamu!"
 },
 {
   "id": 30374,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 2,
   "firman": "Kekayaanmu sudah busuk, dan pakaianmu telah dimakan ngengat!"
 },
 {
   "id": 30375,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 3,
   "firman": "Emas dan perakmu sudah berkarat, dan karatnya akan menjadi kesaksian terhadap kamu dan akan memakan dagingmu seperti api. Kamu telah mengumpulkan harta pada hari-hari yang sedang berakhir."
 },
 {
   "id": 30376,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 4,
   "firman": "Sesungguhnya telah terdengar teriakan besar, karena upah yang kamu tahan dari buruh yang telah menuai hasil ladangmu, dan telah sampai ke telinga Tuhan semesta alam keluhan mereka yang menyabit panenmu."
 },
 {
   "id": 30377,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 5,
   "firman": "Dalam kemewahan kamu telah hidup dan berfoya-foya di bumi, kamu telah memuaskan hatimu sama seperti pada hari penyembelihan."
 },
 {
   "id": 30378,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 6,
   "firman": "Kamu telah menghukum, bahkan membunuh orang yang benar dan ia tidak dapat melawan kamu."
 },
 {
   "id": 30379,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 7,
   "firman": "Karena itu, saudara-saudara, bersabarlah sampai kepada kedatangan Tuhan! Sesungguhnya petani menantikan hasil yang berharga dari tanahnya dan ia sabar sampai telah turun hujan musim gugur dan hujan musim semi."
 },
 {
   "id": 30380,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 8,
   "firman": "Kamu juga harus bersabar dan harus meneguhkan hatimu, karena kedatangan Tuhan sudah dekat!"
 },
 {
   "id": 30381,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 9,
   "firman": "Saudara-saudara, janganlah kamu bersungut-sungut dan saling mempersalahkan, supaya kamu jangan dihukum. Sesungguhnya Hakim telah berdiri di ambang pintu."
 },
 {
   "id": 30382,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 10,
   "firman": "Saudara-saudara, turutilah teladan penderitaan dan kesabaran para nabi yang telah berbicara demi nama Tuhan."
 },
 {
   "id": 30383,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 11,
   "firman": "Sesungguhnya kami menyebut mereka berbahagia, yaitu mereka yang telah bertekun; kamu telah mendengar tentang ketekunan Ayub dan kamu telah tahu apa yang pada akhirnya disediakan Tuhan baginya, karena Tuhan maha penyayang dan penuh belas kasihan."
 },
 {
   "id": 30384,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 12,
   "firman": "Tetapi yang terutama, saudara-saudara, janganlah kamu bersumpah demi sorga maupun demi bumi atau demi sesuatu yang lain. Jika ya, hendaklah kamu katakan ya, jika tidak hendaklah kamu katakan tidak, supaya kamu jangan kena hukuman."
 },
 {
   "id": 30385,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 13,
   "firman": "Kalau ada seorang di antara kamu yang menderita, baiklah ia berdoa! Kalau ada seorang yang bergembira baiklah ia menyanyi!"
 },
 {
   "id": 30386,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 14,
   "firman": "Kalau ada seorang di antara kamu yang sakit, baiklah ia memanggil para penatua jemaat, supaya mereka mendoakan dia serta mengolesnya dengan minyak dalam nama Tuhan."
 },
 {
   "id": 30387,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 15,
   "firman": "Dan doa yang lahir dari iman akan menyelamatkan orang sakit itu dan Tuhan akan membangunkan dia; dan jika ia telah berbuat dosa, maka dosanya itu akan diampuni."
 },
 {
   "id": 30388,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 16,
   "firman": "Karena itu hendaklah kamu saling mengaku dosamu dan saling mendoakan, supaya kamu sembuh. Doa orang yang benar, bila dengan yakin didoakan, sangat besar kuasanya."
 },
 {
   "id": 30389,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 17,
   "firman": "Elia adalah manusia biasa sama seperti kita, dan ia telah bersungguh-sungguh berdoa, supaya hujan jangan turun, dan hujanpun tidak turun di bumi selama tiga tahun dan enam bulan."
 },
 {
   "id": 30390,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 18,
   "firman": "Lalu ia berdoa pula dan langit menurunkan hujan dan bumipun mengeluarkan buahnya."
 },
 {
   "id": 30391,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 19,
   "firman": "Saudara-saudaraku, jika ada di antara kamu yang menyimpang dari kebenaran dan ada seorang yang membuat dia berbalik,"
 },
 {
   "id": 30392,
   "kitab": "Yak",
   "pasal": 5,
   "ayat": 20,
   "firman": "ketahuilah, bahwa barangsiapa membuat orang berdosa berbalik dari jalannya yang sesat, ia akan menyelamatkan jiwa orang itu dari maut dan menutupi banyak dosa."
 },
 {
   "id": 30393,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Petrus, rasul Yesus Kristus, kepada orang-orang pendatang, yang tersebar di Pontus, Galatia, Kapadokia, Asia Kecil dan Bitinia,"
 },
 {
   "id": 30394,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 2,
   "firman": "yaitu orang-orang yang dipilih, sesuai dengan rencana Allah, Bapa kita, dan yang dikuduskan oleh Roh, supaya taat kepada Yesus Kristus dan menerima percikan darah-Nya. Kiranya kasih karunia dan damai sejahtera makin melimpah atas kamu."
 },
 {
   "id": 30395,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 3,
   "firman": "Terpujilah Allah dan Bapa Tuhan kita Yesus Kristus, yang karena rahmat-Nya yang besar telah melahirkan kita kembali oleh kebangkitan Yesus Kristus dari antara orang mati, kepada suatu hidup yang penuh pengharapan,"
 },
 {
   "id": 30396,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 4,
   "firman": "untuk menerima suatu bagian yang tidak dapat binasa, yang tidak dapat cemar dan yang tidak dapat layu, yang tersimpan di sorga bagi kamu."
 },
 {
   "id": 30397,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 5,
   "firman": "Yaitu kamu, yang dipelihara dalam kekuatan Allah karena imanmu sementara kamu menantikan keselamatan yang telah tersedia untuk dinyatakan pada zaman akhir."
 },
 {
   "id": 30398,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 6,
   "firman": "Bergembiralah akan hal itu, sekalipun sekarang ini kamu seketika harus berdukacita oleh berbagai-bagai pencobaan."
 },
 {
   "id": 30399,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 7,
   "firman": "Maksud semuanya itu ialah untuk membuktikan kemurnian imanmu--yang jauh lebih tinggi nilainya dari pada emas yang fana, yang diuji kemurniannya dengan api--sehingga kamu memperoleh puji-pujian dan kemuliaan dan kehormatan pada hari Yesus Kristus menyatakan diri-Nya."
 },
 {
   "id": 30400,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sekalipun kamu belum pernah melihat Dia, namun kamu mengasihi-Nya. Kamu percaya kepada Dia, sekalipun kamu sekarang tidak melihat-Nya. Kamu bergembira karena sukacita yang mulia dan yang tidak terkatakan,"
 },
 {
   "id": 30401,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 9,
   "firman": "karena kamu telah mencapai tujuan imanmu, yaitu keselamatan jiwamu."
 },
 {
   "id": 30402,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 10,
   "firman": "Keselamatan itulah yang diselidiki dan diteliti oleh nabi-nabi, yang telah bernubuat tentang kasih karunia yang diuntukkan bagimu."
 },
 {
   "id": 30403,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 11,
   "firman": "Dan mereka meneliti saat yang mana dan yang bagaimana yang dimaksudkan oleh Roh Kristus, yang ada di dalam mereka, yaitu Roh yang sebelumnya memberi kesaksian tentang segala penderitaan yang akan menimpa Kristus dan tentang segala kemuliaan yang menyusul sesudah itu."
 },
 {
   "id": 30404,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 12,
   "firman": "Kepada mereka telah dinyatakan, bahwa mereka bukan melayani diri mereka sendiri, tetapi melayani kamu dengan segala sesuatu yang telah diberitakan sekarang kepada kamu dengan perantaraan mereka, yang oleh Roh Kudus, yang diutus dari sorga, menyampaikan berita Injil kepada kamu, yaitu hal-hal yang ingin diketahui oleh malaikat-malaikat."
 },
 {
   "id": 30405,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 13,
   "firman": "Sebab itu siapkanlah akal budimu, waspadalah dan letakkanlah pengharapanmu seluruhnya atas kasih karunia yang dianugerahkan kepadamu pada waktu penyataan Yesus Kristus."
 },
 {
   "id": 30406,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 14,
   "firman": "Hiduplah sebagai anak-anak yang taat dan jangan turuti hawa nafsu yang menguasai kamu pada waktu kebodohanmu,"
 },
 {
   "id": 30407,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 15,
   "firman": "tetapi hendaklah kamu menjadi kudus di dalam seluruh hidupmu sama seperti Dia yang kudus, yang telah memanggil kamu,"
 },
 {
   "id": 30408,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 16,
   "firman": "sebab ada tertulis: Kuduslah kamu, sebab Aku kudus."
 },
 {
   "id": 30409,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 17,
   "firman": "Dan jika kamu menyebut-Nya Bapa, yaitu Dia yang tanpa memandang muka menghakimi semua orang menurut perbuatannya, maka hendaklah kamu hidup dalam ketakutan selama kamu menumpang di dunia ini."
 },
 {
   "id": 30410,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sebab kamu tahu, bahwa kamu telah ditebus dari cara hidupmu yang sia-sia yang kamu warisi dari nenek moyangmu itu bukan dengan barang yang fana, bukan pula dengan perak atau emas,"
 },
 {
   "id": 30411,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 19,
   "firman": "melainkan dengan darah yang mahal, yaitu darah Kristus yang sama seperti darah anak domba yang tak bernoda dan tak bercacat."
 },
 {
   "id": 30412,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ia telah dipilih sebelum dunia dijadikan, tetapi karena kamu baru menyatakan diri-Nya pada zaman akhir."
 },
 {
   "id": 30413,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 21,
   "firman": "Oleh Dialah kamu percaya kepada Allah, yang telah membangkitkan Dia dari antara orang mati dan yang telah memuliakan-Nya, sehingga imanmu dan pengharapanmu tertuju kepada Allah."
 },
 {
   "id": 30414,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 22,
   "firman": "Karena kamu telah menyucikan dirimu oleh ketaatan kepada kebenaran, sehingga kamu dapat mengamalkan kasih persaudaraan yang tulus ikhlas, hendaklah kamu bersungguh-sungguh saling mengasihi dengan segenap hatimu."
 },
 {
   "id": 30415,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 23,
   "firman": "Karena kamu telah dilahirkan kembali bukan dari benih yang fana, tetapi dari benih yang tidak fana, oleh firman Allah, yang hidup dan yang kekal."
 },
 {
   "id": 30416,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 24,
   "firman": "Sebab: \"Semua yang hidup adalah seperti rumput dan segala kemuliaannya seperti bunga rumput, rumput menjadi kering, dan bunga gugur,"
 },
 {
   "id": 30417,
   "kitab": "1Pt",
   "pasal": 1,
   "ayat": 25,
   "firman": "tetapi firman Tuhan tetap untuk selama-lamanya.\" Inilah firman yang disampaikan Injil kepada kamu."
 },
 {
   "id": 30418,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 1,
   "firman": "Karena itu buanglah segala kejahatan, segala tipu muslihat dan segala macam kemunafikan, kedengkian dan fitnah."
 },
 {
   "id": 30419,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 2,
   "firman": "Dan jadilah sama seperti bayi yang baru lahir, yang selalu ingin akan air susu yang murni dan yang rohani, supaya olehnya kamu bertumbuh dan beroleh keselamatan,"
 },
 {
   "id": 30420,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 3,
   "firman": "jika kamu benar-benar telah mengecap kebaikan Tuhan."
 },
 {
   "id": 30421,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 4,
   "firman": "Dan datanglah kepada-Nya, batu yang hidup itu, yang memang dibuang oleh manusia, tetapi yang dipilih dan dihormat di hadirat Allah."
 },
 {
   "id": 30422,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 5,
   "firman": "Dan biarlah kamu juga dipergunakan sebagai batu hidup untuk pembangunan suatu rumah rohani, bagi suatu imamat kudus, untuk mempersembahkan persembahan rohani yang karena Yesus Kristus berkenan kepada Allah."
 },
 {
   "id": 30423,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 6,
   "firman": "Sebab ada tertulis dalam Kitab Suci: \"Sesungguhnya, Aku meletakkan di Sion sebuah batu yang terpilih, sebuah batu penjuru yang mahal, dan siapa yang percaya kepada-Nya, tidak akan dipermalukan.\""
 },
 {
   "id": 30424,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 7,
   "firman": "Karena itu bagi kamu, yang percaya, ia mahal, tetapi bagi mereka yang tidak percaya: \"Batu yang telah dibuang oleh tukang-tukang bangunan, telah menjadi batu penjuru, juga telah menjadi batu sentuhan dan suatu batu sandungan.\""
 },
 {
   "id": 30425,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 8,
   "firman": "Mereka tersandung padanya, karena mereka tidak taat kepada Firman Allah; dan untuk itu mereka juga telah disediakan."
 },
 {
   "id": 30426,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 9,
   "firman": "Tetapi kamulah bangsa yang terpilih, imamat yang rajani, bangsa yang kudus, umat kepunyaan Allah sendiri, supaya kamu memberitakan perbuatan-perbuatan yang besar dari Dia, yang telah memanggil kamu keluar dari kegelapan kepada terang-Nya yang ajaib:"
 },
 {
   "id": 30427,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 10,
   "firman": "kamu, yang dahulu bukan umat Allah, tetapi yang sekarang telah menjadi umat-Nya, yang dahulu tidak dikasihani tetapi yang sekarang telah beroleh belas kasihan."
 },
 {
   "id": 30428,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 11,
   "firman": "Saudara-saudaraku yang kekasih, aku menasihati kamu, supaya sebagai pendatang dan perantau, kamu menjauhkan diri dari keinginan-keinginan daging yang berjuang melawan jiwa."
 },
 {
   "id": 30429,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 12,
   "firman": "Milikilah cara hidup yang baik di tengah-tengah bangsa-bangsa bukan Yahudi, supaya apabila mereka memfitnah kamu sebagai orang durjana, mereka dapat melihatnya dari perbuatan-perbuatanmu yang baik dan memuliakan Allah pada hari Ia melawat mereka."
 },
 {
   "id": 30430,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 13,
   "firman": "Tunduklah, karena Allah, kepada semua lembaga manusia, baik kepada raja sebagai pemegang kekuasaan yang tertinggi,"
 },
 {
   "id": 30431,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 14,
   "firman": "maupun kepada wali-wali yang diutusnya untuk menghukum orang-orang yang berbuat jahat dan menghormati orang-orang yang berbuat baik."
 },
 {
   "id": 30432,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 15,
   "firman": "Sebab inilah kehendak Allah, yaitu supaya dengan berbuat baik kamu membungkamkan kepicikan orang-orang yang bodoh."
 },
 {
   "id": 30433,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 16,
   "firman": "Hiduplah sebagai orang merdeka dan bukan seperti mereka yang menyalahgunakan kemerdekaan itu untuk menyelubungi kejahatan-kejahatan mereka, tetapi hiduplah sebagai hamba Allah."
 },
 {
   "id": 30434,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 17,
   "firman": "Hormatilah semua orang, kasihilah saudara-saudaramu, takutlah akan Allah, hormatilah raja!"
 },
 {
   "id": 30435,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 18,
   "firman": "Hai kamu, hamba-hamba, tunduklah dengan penuh ketakutan kepada tuanmu, bukan saja kepada yang baik dan peramah, tetapi juga kepada yang bengis."
 },
 {
   "id": 30436,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 19,
   "firman": "Sebab adalah kasih karunia, jika seorang karena sadar akan kehendak Allah menanggung penderitaan yang tidak harus ia tanggung."
 },
 {
   "id": 30437,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sebab dapatkah disebut pujian, jika kamu menderita pukulan karena kamu berbuat dosa? Tetapi jika kamu berbuat baik dan karena itu kamu harus menderita, maka itu adalah kasih karunia pada Allah."
 },
 {
   "id": 30438,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 21,
   "firman": "Sebab untuk itulah kamu dipanggil, karena Kristuspun telah menderita untuk kamu dan telah meninggalkan teladan bagimu, supaya kamu mengikuti jejak-Nya."
 },
 {
   "id": 30439,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 22,
   "firman": "Ia tidak berbuat dosa, dan tipu tidak ada dalam mulut-Nya."
 },
 {
   "id": 30440,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 23,
   "firman": "Ketika Ia dicaci maki, Ia tidak membalas dengan mencaci maki; ketika Ia menderita, Ia tidak mengancam, tetapi Ia menyerahkannya kepada Dia, yang menghakimi dengan adil."
 },
 {
   "id": 30441,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 24,
   "firman": "Ia sendiri telah memikul dosa kita di dalam tubuh-Nya di kayu salib, supaya kita, yang telah mati terhadap dosa, hidup untuk kebenaran. Oleh bilur-bilur-Nya kamu telah sembuh."
 },
 {
   "id": 30442,
   "kitab": "1Pt",
   "pasal": 2,
   "ayat": 25,
   "firman": "Sebab dahulu kamu sesat seperti domba, tetapi sekarang kamu telah kembali kepada gembala dan pemelihara jiwamu."
 },
 {
   "id": 30443,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 1,
   "firman": "Demikian juga kamu, hai isteri-isteri, tunduklah kepada suamimu, supaya jika ada di antara mereka yang tidak taat kepada Firman, mereka juga tanpa perkataan dimenangkan oleh kelakuan isterinya,"
 },
 {
   "id": 30444,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 2,
   "firman": "jika mereka melihat, bagaimana murni dan salehnya hidup isteri mereka itu."
 },
 {
   "id": 30445,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 3,
   "firman": "Perhiasanmu janganlah secara lahiriah, yaitu dengan mengepang-ngepang rambut, memakai perhiasan emas atau dengan mengenakan pakaian yang indah-indah,"
 },
 {
   "id": 30446,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 4,
   "firman": "tetapi perhiasanmu ialah manusia batiniah yang tersembunyi dengan perhiasan yang tidak binasa yang berasal dari roh yang lemah lembut dan tenteram, yang sangat berharga di mata Allah."
 },
 {
   "id": 30447,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 5,
   "firman": "Sebab demikianlah caranya perempuan-perempuan kudus dahulu berdandan, yaitu perempuan-perempuan yang menaruh pengharapannya kepada Allah; mereka tunduk kepada suaminya,"
 },
 {
   "id": 30448,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 6,
   "firman": "sama seperti Sara taat kepada Abraham dan menamai dia tuannya. Dan kamu adalah anak-anaknya, jika kamu berbuat baik dan tidak takut akan ancaman."
 },
 {
   "id": 30449,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 7,
   "firman": "Demikian juga kamu, hai suami-suami, hiduplah bijaksana dengan isterimu, sebagai kaum yang lebih lemah! Hormatilah mereka sebagai teman pewaris dari kasih karunia, yaitu kehidupan, supaya doamu jangan terhalang."
 },
 {
   "id": 30450,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 8,
   "firman": "Dan akhirnya, hendaklah kamu semua seia sekata, seperasaan, mengasihi saudara-saudara, penyayang dan rendah hati,"
 },
 {
   "id": 30451,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 9,
   "firman": "dan janganlah membalas kejahatan dengan kejahatan, atau caci maki dengan caci maki, tetapi sebaliknya, hendaklah kamu memberkati, karena untuk itulah kamu dipanggil, yaitu untuk memperoleh berkat. Sebab:"
 },
 {
   "id": 30452,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 10,
   "firman": "\"Siapa yang mau mencintai hidup dan mau melihat hari-hari baik, ia harus menjaga lidahnya terhadap yang jahat dan bibirnya terhadap ucapan-ucapan yang menipu."
 },
 {
   "id": 30453,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 11,
   "firman": "Ia harus menjauhi yang jahat dan melakukan yang baik, ia harus mencari perdamaian dan berusaha mendapatkannya."
 },
 {
   "id": 30454,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 12,
   "firman": "Sebab mata Tuhan tertuju kepada orang-orang benar, dan telinga-Nya kepada permohonan mereka yang minta tolong, tetapi wajah Tuhan menentang orang-orang yang berbuat jahat.\""
 },
 {
   "id": 30455,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 13,
   "firman": "Dan siapakah yang akan berbuat jahat terhadap kamu, jika kamu rajin berbuat baik?"
 },
 {
   "id": 30456,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 14,
   "firman": "Tetapi sekalipun kamu harus menderita juga karena kebenaran, kamu akan berbahagia. Sebab itu janganlah kamu takuti apa yang mereka takuti dan janganlah gentar."
 },
 {
   "id": 30457,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 15,
   "firman": "Tetapi kuduskanlah Kristus di dalam hatimu sebagai Tuhan! Dan siap sedialah pada segala waktu untuk memberi pertanggungan jawab kepada tiap-tiap orang yang meminta pertanggungan jawab dari kamu tentang pengharapan yang ada padamu, tetapi haruslah dengan lemah lembut dan hormat,"
 },
 {
   "id": 30458,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 16,
   "firman": "dan dengan hati nurani yang murni, supaya mereka, yang memfitnah kamu karena hidupmu yang saleh dalam Kristus, menjadi malu karena fitnahan mereka itu."
 },
 {
   "id": 30459,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 17,
   "firman": "Sebab lebih baik menderita karena berbuat baik, jika hal itu dikehendaki Allah, dari pada menderita karena berbuat jahat."
 },
 {
   "id": 30460,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 18,
   "firman": "Sebab juga Kristus telah mati sekali untuk segala dosa kita, Ia yang benar untuk orang-orang yang tidak benar, supaya Ia membawa kita kepada Allah; Ia, yang telah dibunuh dalam keadaan-Nya sebagai manusia, tetapi yang telah dibangkitkan menurut Roh,"
 },
 {
   "id": 30461,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 19,
   "firman": "dan di dalam Roh itu juga Ia pergi memberitakan Injil kepada roh-roh yang di dalam penjara,"
 },
 {
   "id": 30462,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 20,
   "firman": "yaitu kepada roh-roh mereka yang dahulu pada waktu Nuh tidak taat kepada Allah, ketika Allah tetap menanti dengan sabar waktu Nuh sedang mempersiapkan bahteranya, di mana hanya sedikit, yaitu delapan orang, yang diselamatkan oleh air bah itu."
 },
 {
   "id": 30463,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 21,
   "firman": "Juga kamu sekarang diselamatkan oleh kiasannya, yaitu baptisan--maksudnya bukan untuk membersihkan kenajisan jasmani, melainkan untuk memohonkan hati nurani yang baik kepada Allah--oleh kebangkitan Yesus Kristus,"
 },
 {
   "id": 30464,
   "kitab": "1Pt",
   "pasal": 3,
   "ayat": 22,
   "firman": "yang duduk di sebelah kanan Allah, setelah Ia naik ke sorga sesudah segala malaikat, kuasa dan kekuatan ditaklukkan kepada-Nya."
 },
 {
   "id": 30465,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 1,
   "firman": "Jadi, karena Kristus telah menderita penderitaan badani, kamupun harus juga mempersenjatai dirimu dengan pikiran yang demikian, --karena barangsiapa telah menderita penderitaan badani, ia telah berhenti berbuat dosa--,"
 },
 {
   "id": 30466,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 2,
   "firman": "supaya waktu yang sisa jangan kamu pergunakan menurut keinginan manusia, tetapi menurut kehendak Allah."
 },
 {
   "id": 30467,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 3,
   "firman": "Sebab telah cukup banyak waktu kamu pergunakan untuk melakukan kehendak orang-orang yang tidak mengenal Allah. Kamu telah hidup dalam rupa-rupa hawa nafsu, keinginan, kemabukan, pesta pora, perjamuan minum dan penyembahan berhala yang terlarang."
 },
 {
   "id": 30468,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 4,
   "firman": "Sebab itu mereka heran, bahwa kamu tidak turut mencemplungkan diri bersama-sama mereka di dalam kubangan ketidaksenonohan yang sama, dan mereka memfitnah kamu."
 },
 {
   "id": 30469,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 5,
   "firman": "Tetapi mereka harus memberi pertanggungan jawab kepada Dia, yang telah siap sedia menghakimi orang yang hidup dan yang mati."
 },
 {
   "id": 30470,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 6,
   "firman": "Itulah sebabnya maka Injil telah diberitakan juga kepada orang-orang mati, supaya mereka, sama seperti semua manusia, dihakimi secara badani; tetapi oleh roh dapat hidup menurut kehendak Allah."
 },
 {
   "id": 30471,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 7,
   "firman": "Kesudahan segala sesuatu sudah dekat. Karena itu kuasailah dirimu dan jadilah tenang, supaya kamu dapat berdoa."
 },
 {
   "id": 30472,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 8,
   "firman": "Tetapi yang terutama: kasihilah sungguh-sungguh seorang akan yang lain, sebab kasih menutupi banyak sekali dosa."
 },
 {
   "id": 30473,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 9,
   "firman": "Berilah tumpangan seorang akan yang lain dengan tidak bersungut-sungut."
 },
 {
   "id": 30474,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 10,
   "firman": "Layanilah seorang akan yang lain, sesuai dengan karunia yang telah diperoleh tiap-tiap orang sebagai pengurus yang baik dari kasih karunia Allah."
 },
 {
   "id": 30475,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 11,
   "firman": "Jika ada orang yang berbicara, baiklah ia berbicara sebagai orang yang menyampaikan firman Allah; jika ada orang yang melayani, baiklah ia melakukannya dengan kekuatan yang dianugerahkan Allah, supaya Allah dimuliakan dalam segala sesuatu karena Yesus Kristus. Ialah yang empunya kemuliaan dan kuasa sampai selama-lamanya! Amin."
 },
 {
   "id": 30476,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 12,
   "firman": "Saudara-saudara yang kekasih, janganlah kamu heran akan nyala api siksaan yang datang kepadamu sebagai ujian, seolah-olah ada sesuatu yang luar biasa terjadi atas kamu."
 },
 {
   "id": 30477,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 13,
   "firman": "Sebaliknya, bersukacitalah, sesuai dengan bagian yang kamu dapat dalam penderitaan Kristus, supaya kamu juga boleh bergembira dan bersukacita pada waktu Ia menyatakan kemuliaan-Nya."
 },
 {
   "id": 30478,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 14,
   "firman": "Berbahagialah kamu, jika kamu dinista karena nama Kristus, sebab Roh kemuliaan, yaitu Roh Allah ada padamu."
 },
 {
   "id": 30479,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 15,
   "firman": "Janganlah ada di antara kamu yang harus menderita sebagai pembunuh atau pencuri atau penjahat, atau pengacau."
 },
 {
   "id": 30480,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 16,
   "firman": "Tetapi, jika ia menderita sebagai orang Kristen, maka janganlah ia malu, melainkan hendaklah ia memuliakan Allah dalam nama Kristus itu."
 },
 {
   "id": 30481,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 17,
   "firman": "Karena sekarang telah tiba saatnya penghakiman dimulai, dan pada rumah Allah sendiri yang harus pertama-tama dihakimi. Dan jika penghakiman itu dimulai pada kita, bagaimanakah kesudahannya dengan mereka yang tidak percaya pada Injil Allah?"
 },
 {
   "id": 30482,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 18,
   "firman": "Dan jika orang benar hampir-hampir tidak diselamatkan, apakah yang akan terjadi dengan orang fasik dan orang berdosa?"
 },
 {
   "id": 30483,
   "kitab": "1Pt",
   "pasal": 4,
   "ayat": 19,
   "firman": "Karena itu baiklah juga mereka yang harus menderita karena kehendak Allah, menyerahkan jiwanya, dengan selalu berbuat baik, kepada Pencipta yang setia."
 },
 {
   "id": 30484,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 1,
   "firman": "Aku menasihatkan para penatua di antara kamu, aku sebagai teman penatua dan saksi penderitaan Kristus, yang juga akan mendapat bagian dalam kemuliaan yang akan dinyatakan kelak."
 },
 {
   "id": 30485,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 2,
   "firman": "Gembalakanlah kawanan domba Allah yang ada padamu, jangan dengan paksa, tetapi dengan sukarela sesuai dengan kehendak Allah, dan jangan karena mau mencari keuntungan, tetapi dengan pengabdian diri."
 },
 {
   "id": 30486,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 3,
   "firman": "Janganlah kamu berbuat seolah-olah kamu mau memerintah atas mereka yang dipercayakan kepadamu, tetapi hendaklah kamu menjadi teladan bagi kawanan domba itu."
 },
 {
   "id": 30487,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 4,
   "firman": "Maka kamu, apabila Gembala Agung datang, kamu akan menerima mahkota kemuliaan yang tidak dapat layu."
 },
 {
   "id": 30488,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 5,
   "firman": "Demikian jugalah kamu, hai orang-orang muda, tunduklah kepada orang-orang yang tua. Dan kamu semua, rendahkanlah dirimu seorang terhadap yang lain, sebab: \"Allah menentang orang yang congkak, tetapi mengasihani orang yang rendah hati.\""
 },
 {
   "id": 30489,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 6,
   "firman": "Karena itu rendahkanlah dirimu di bawah tangan Tuhan yang kuat, supaya kamu ditinggikan-Nya pada waktunya."
 },
 {
   "id": 30490,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 7,
   "firman": "Serahkanlah segala kekuatiranmu kepada-Nya, sebab Ia yang memelihara kamu."
 },
 {
   "id": 30491,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 8,
   "firman": "Sadarlah dan berjaga-jagalah! Lawanmu, si Iblis, berjalan keliling sama seperti singa yang mengaum-aum dan mencari orang yang dapat ditelannya."
 },
 {
   "id": 30492,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 9,
   "firman": "Lawanlah dia dengan iman yang teguh, sebab kamu tahu, bahwa semua saudaramu di seluruh dunia menanggung penderitaan yang sama."
 },
 {
   "id": 30493,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 10,
   "firman": "Dan Allah, sumber segala kasih karunia, yang telah memanggil kamu dalam Kristus kepada kemuliaan-Nya yang kekal, akan melengkapi, meneguhkan, menguatkan dan mengokohkan kamu, sesudah kamu menderita seketika lamanya."
 },
 {
   "id": 30494,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 11,
   "firman": "Ialah yang empunya kuasa sampai selama-lamanya! Amin."
 },
 {
   "id": 30495,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 12,
   "firman": "Dengan perantaraan Silwanus, yang kuanggap sebagai seorang saudara yang dapat dipercayai, aku menulis dengan singkat kepada kamu untuk menasihati dan meyakinkan kamu, bahwa ini adalah kasih karunia yang benar-benar dari Allah. Berdirilah dengan teguh di dalamnya!"
 },
 {
   "id": 30496,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 13,
   "firman": "Salam kepada kamu sekalian dari kawanmu yang terpilih yang di Babilon, dan juga dari Markus, anakku."
 },
 {
   "id": 30497,
   "kitab": "1Pt",
   "pasal": 5,
   "ayat": 14,
   "firman": "Berilah salam seorang kepada yang lain dengan cium yang kudus. Damai sejahtera menyertai kamu sekalian yang berada dalam Kristus. Amin."
 },
 {
   "id": 30498,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Simon Petrus, hamba dan rasul Yesus Kristus, kepada mereka yang bersama-sama dengan kami memperoleh iman oleh karena keadilan Allah dan Juruselamat kita, Yesus Kristus."
 },
 {
   "id": 30499,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 2,
   "firman": "Kasih karunia dan damai sejahtera melimpahi kamu oleh pengenalan akan Allah dan akan Yesus, Tuhan kita."
 },
 {
   "id": 30500,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 3,
   "firman": "Karena kuasa ilahi-Nya telah menganugerahkan kepada kita segala sesuatu yang berguna untuk hidup yang saleh oleh pengenalan kita akan Dia, yang telah memanggil kita oleh kuasa-Nya yang mulia dan ajaib."
 },
 {
   "id": 30501,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dengan jalan itu Ia telah menganugerahkan kepada kita janji-janji yang berharga dan yang sangat besar, supaya olehnya kamu boleh mengambil bagian dalam kodrat ilahi, dan luput dari hawa nafsu duniawi yang membinasakan dunia."
 },
 {
   "id": 30502,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 5,
   "firman": "Justru karena itu kamu harus dengan sungguh-sungguh berusaha untuk menambahkan kepada imanmu kebajikan, dan kepada kebajikan pengetahuan,"
 },
 {
   "id": 30503,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 6,
   "firman": "dan kepada pengetahuan penguasaan diri, kepada penguasaan diri ketekunan, dan kepada ketekunan kesalehan,"
 },
 {
   "id": 30504,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 7,
   "firman": "dan kepada kesalehan kasih akan saudara-saudara, dan kepada kasih akan saudara-saudara kasih akan semua orang."
 },
 {
   "id": 30505,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 8,
   "firman": "Sebab apabila semuanya itu ada padamu dengan berlimpah-limpah, kamu akan dibuatnya menjadi giat dan berhasil dalam pengenalanmu akan Yesus Kristus, Tuhan kita."
 },
 {
   "id": 30506,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 9,
   "firman": "Tetapi barangsiapa tidak memiliki semuanya itu, ia menjadi buta dan picik, karena ia lupa, bahwa dosa-dosanya yang dahulu telah dihapuskan."
 },
 {
   "id": 30507,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 10,
   "firman": "Karena itu, saudara-saudaraku, berusahalah sungguh-sungguh, supaya panggilan dan pilihanmu makin teguh. Sebab jikalau kamu melakukannya, kamu tidak akan pernah tersandung."
 },
 {
   "id": 30508,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 11,
   "firman": "Dengan demikian kepada kamu akan dikaruniakan hak penuh untuk memasuki Kerajaan kekal, yaitu Kerajaan Tuhan dan Juruselamat kita, Yesus Kristus."
 },
 {
   "id": 30509,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 12,
   "firman": "Karena itu aku senantiasa bermaksud mengingatkan kamu akan semuanya itu, sekalipun kamu telah mengetahuinya dan telah teguh dalam kebenaran yang telah kamu terima."
 },
 {
   "id": 30510,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 13,
   "firman": "Aku menganggap sebagai kewajibanku untuk tetap mengingatkan kamu akan semuanya itu selama aku belum menanggalkan kemah tubuhku ini."
 },
 {
   "id": 30511,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 14,
   "firman": "Sebab aku tahu, bahwa aku akan segera menanggalkan kemah tubuhku ini, sebagaimana yang telah diberitahukan kepadaku oleh Yesus Kristus, Tuhan kita."
 },
 {
   "id": 30512,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 15,
   "firman": "Tetapi aku akan berusaha, supaya juga sesudah kepergianku itu kamu selalu mengingat semuanya itu."
 },
 {
   "id": 30513,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 16,
   "firman": "Sebab kami tidak mengikuti dongeng-dongeng isapan jempol manusia, ketika kami memberitahukan kepadamu kuasa dan kedatangan Tuhan kita, Yesus Kristus sebagai raja, tetapi kami adalah saksi mata dari kebesaran-Nya."
 },
 {
   "id": 30514,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 17,
   "firman": "Kami menyaksikan, bagaimana Ia menerima kehormatan dan kemuliaan dari Allah Bapa, ketika datang kepada-Nya suara dari Yang Mahamulia, yang mengatakan: \"Inilah Anak yang Kukasihi, kepada-Nyalah Aku berkenan.\""
 },
 {
   "id": 30515,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 18,
   "firman": "Suara itu kami dengar datang dari sorga, ketika kami bersama-sama dengan Dia di atas gunung yang kudus."
 },
 {
   "id": 30516,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 19,
   "firman": "Dengan demikian kami makin diteguhkan oleh firman yang telah disampaikan oleh para nabi. Alangkah baiknya kalau kamu memperhatikannya sama seperti memperhatikan pelita yang bercahaya di tempat yang gelap sampai fajar menyingsing dan bintang timur terbit bersinar di dalam hatimu."
 },
 {
   "id": 30517,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 20,
   "firman": "Yang terutama harus kamu ketahui, ialah bahwa nubuat-nubuat dalam Kitab Suci tidak boleh ditafsirkan menurut kehendak sendiri,"
 },
 {
   "id": 30518,
   "kitab": "2Pt",
   "pasal": 1,
   "ayat": 21,
   "firman": "sebab tidak pernah nubuat dihasilkan oleh kehendak manusia, tetapi oleh dorongan Roh Kudus orang-orang berbicara atas nama Allah."
 },
 {
   "id": 30519,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 1,
   "firman": "Sebagaimana nabi-nabi palsu dahulu tampil di tengah-tengah umat Allah, demikian pula di antara kamu akan ada guru-guru palsu. Mereka akan memasukkan pengajaran-pengajaran sesat yang membinasakan, bahkan mereka akan menyangkal Penguasa yang telah menebus mereka dan dengan jalan demikian segera mendatangkan kebinasaan atas diri mereka."
 },
 {
   "id": 30520,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 2,
   "firman": "Banyak orang akan mengikuti cara hidup mereka yang dikuasai hawa nafsu, dan karena mereka Jalan Kebenaran akan dihujat."
 },
 {
   "id": 30521,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan karena serakahnya guru-guru palsu itu akan berusaha mencari untung dari kamu dengan ceritera-ceritera isapan jempol mereka. Tetapi untuk perbuatan mereka itu hukuman telah lama tersedia dan kebinasaan tidak akan tertunda."
 },
 {
   "id": 30522,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 4,
   "firman": "Sebab jikalau Allah tidak menyayangkan malaikat-malaikat yang berbuat dosa tetapi melemparkan mereka ke dalam neraka dan dengan demikian menyerahkannya ke dalam gua-gua yang gelap untuk menyimpan mereka sampai hari penghakiman;"
 },
 {
   "id": 30523,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 5,
   "firman": "dan jikalau Allah tidak menyayangkan dunia purba, tetapi hanya menyelamatkan Nuh, pemberita kebenaran itu, dengan tujuh orang lain, ketika Ia mendatangkan air bah atas dunia orang-orang yang fasik;"
 },
 {
   "id": 30524,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 6,
   "firman": "dan jikalau Allah membinasakan kota Sodom dan Gomora dengan api, dan dengan demikian memusnahkannya dan menjadikannya suatu peringatan untuk mereka yang hidup fasik di masa-masa kemudian,"
 },
 {
   "id": 30525,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 7,
   "firman": "tetapi Ia menyelamatkan Lot, orang yang benar, yang terus-menerus menderita oleh cara hidup orang-orang yang tak mengenal hukum dan yang hanya mengikuti hawa nafsu mereka saja, --"
 },
 {
   "id": 30526,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 8,
   "firman": "sebab orang benar ini tinggal di tengah-tengah mereka dan setiap hari melihat dan mendengar perbuatan-perbuatan mereka yang jahat itu, sehingga jiwanya yang benar itu tersiksa--"
 },
 {
   "id": 30527,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 9,
   "firman": "maka nyata, bahwa Tuhan tahu menyelamatkan orang-orang saleh dari pencobaan dan tahu menyimpan orang-orang jahat untuk disiksa pada hari penghakiman,"
 },
 {
   "id": 30528,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 10,
   "firman": "terutama mereka yang menuruti hawa nafsunya karena ingin mencemarkan diri dan yang menghina pemerintahan Allah. Mereka begitu berani dan angkuh, sehingga tidak segan-segan menghujat kemuliaan,"
 },
 {
   "id": 30529,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 11,
   "firman": "padahal malaikat-malaikat sendiri, yang sekalipun lebih kuat dan lebih berkuasa dari pada mereka, tidak memakai kata-kata hujat, kalau malaikat-malaikat menuntut hukuman atas mereka di hadapan Allah."
 },
 {
   "id": 30530,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 12,
   "firman": "Tetapi mereka itu sama dengan hewan yang tidak berakal, sama dengan binatang yang hanya dilahirkan untuk ditangkap dan dimusnahkan. Mereka menghujat apa yang tidak mereka ketahui, sehingga oleh perbuatan mereka yang jahat mereka sendiri akan binasa seperti binatang liar,"
 },
 {
   "id": 30531,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 13,
   "firman": "dan akan mengalami nasib yang buruk sebagai upah kejahatan mereka. Berfoya-foya pada siang hari, mereka anggap kenikmatan. Mereka adalah kotoran dan noda, yang mabuk dalam hawa nafsu mereka kalau mereka duduk makan minum bersama-sama dengan kamu."
 },
 {
   "id": 30532,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 14,
   "firman": "Mata mereka penuh nafsu zinah dan mereka tidak pernah jemu berbuat dosa. Mereka memikat orang-orang yang lemah. Hati mereka telah terlatih dalam keserakahan. Mereka adalah orang-orang yang terkutuk!"
 },
 {
   "id": 30533,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 15,
   "firman": "Oleh karena mereka telah meninggalkan jalan yang benar, maka tersesatlah mereka, lalu mengikuti jalan Bileam, anak Beor, yang suka menerima upah untuk perbuatan-perbuatan yang jahat."
 },
 {
   "id": 30534,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 16,
   "firman": "Tetapi Bileam beroleh peringatan keras untuk kejahatannya, sebab keledai beban yang bisu berbicara dengan suara manusia dan mencegah kebebalan nabi itu."
 },
 {
   "id": 30535,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 17,
   "firman": "Guru-guru palsu itu adalah seperti mata air yang kering, seperti kabut yang dihalaukan taufan; bagi mereka telah tersedia tempat dalam kegelapan yang paling dahsyat."
 },
 {
   "id": 30536,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 18,
   "firman": "Sebab mereka mengucapkan kata-kata yang congkak dan hampa dan mempergunakan hawa nafsu cabul untuk memikat orang-orang yang baru saja melepaskan diri dari mereka yang hidup dalam kesesatan."
 },
 {
   "id": 30537,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 19,
   "firman": "Mereka menjanjikan kemerdekaan kepada orang lain, padahal mereka sendiri adalah hamba-hamba kebinasaan, karena siapa yang dikalahkan orang, ia adalah hamba orang itu."
 },
 {
   "id": 30538,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 20,
   "firman": "Sebab jika mereka, oleh pengenalan mereka akan Tuhan dan Juruselamat kita, Yesus Kristus, telah melepaskan diri dari kecemaran-kecemaran dunia, tetapi terlibat lagi di dalamnya, maka akhirnya keadaan mereka lebih buruk dari pada yang semula."
 },
 {
   "id": 30539,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 21,
   "firman": "Karena itu bagi mereka adalah lebih baik, jika mereka tidak pernah mengenal Jalan Kebenaran dari pada mengenalnya, tetapi kemudian berbalik dari perintah kudus yang disampaikan kepada mereka."
 },
 {
   "id": 30540,
   "kitab": "2Pt",
   "pasal": 2,
   "ayat": 22,
   "firman": "Bagi mereka cocok apa yang dikatakan peribahasa yang benar ini: \"Anjing kembali lagi ke muntahnya, dan babi yang mandi kembali lagi ke kubangannya.\""
 },
 {
   "id": 30541,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 1,
   "firman": "Saudara-saudara yang kekasih, ini sudah surat yang kedua, yang kutulis kepadamu. Di dalam kedua surat itu aku berusaha menghidupkan pengertian yang murni oleh peringatan-peringatan,"
 },
 {
   "id": 30542,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 2,
   "firman": "supaya kamu mengingat akan perkataan yang dahulu telah diucapkan oleh nabi-nabi kudus dan mengingat akan perintah Tuhan dan Juruselamat yang telah disampaikan oleh rasul-rasulmu kepadamu."
 },
 {
   "id": 30543,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 3,
   "firman": "Yang terutama harus kamu ketahui ialah, bahwa pada hari-hari zaman akhir akan tampil pengejek-pengejek dengan ejekan-ejekannya, yaitu orang-orang yang hidup menuruti hawa nafsunya."
 },
 {
   "id": 30544,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 4,
   "firman": "Kata mereka: \"Di manakah janji tentang kedatangan-Nya itu? Sebab sejak bapa-bapa leluhur kita meninggal, segala sesuatu tetap seperti semula, pada waktu dunia diciptakan.\""
 },
 {
   "id": 30545,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 5,
   "firman": "Mereka sengaja tidak mau tahu, bahwa oleh firman Allah langit telah ada sejak dahulu, dan juga bumi yang berasal dari air dan oleh air,"
 },
 {
   "id": 30546,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 6,
   "firman": "dan bahwa oleh air itu, bumi yang dahulu telah binasa, dimusnahkan oleh air bah."
 },
 {
   "id": 30547,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 7,
   "firman": "Tetapi oleh firman itu juga langit dan bumi yang sekarang terpelihara dari api dan disimpan untuk hari penghakiman dan kebinasaan orang-orang fasik."
 },
 {
   "id": 30548,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 8,
   "firman": "Akan tetapi, saudara-saudaraku yang kekasih, yang satu ini tidak boleh kamu lupakan, yaitu, bahwa di hadapan Tuhan satu hari sama seperti seribu tahun dan seribu tahun sama seperti satu hari."
 },
 {
   "id": 30549,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 9,
   "firman": "Tuhan tidak lalai menepati janji-Nya, sekalipun ada orang yang menganggapnya sebagai kelalaian, tetapi Ia sabar terhadap kamu, karena Ia menghendaki supaya jangan ada yang binasa, melainkan supaya semua orang berbalik dan bertobat."
 },
 {
   "id": 30550,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tetapi hari Tuhan akan tiba seperti pencuri. Pada hari itu langit akan lenyap dengan gemuruh yang dahsyat dan unsur-unsur dunia akan hangus dalam nyala api, dan bumi dan segala yang ada di atasnya akan hilang lenyap."
 },
 {
   "id": 30551,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 11,
   "firman": "Jadi, jika segala sesuatu ini akan hancur secara demikian, betapa suci dan salehnya kamu harus hidup"
 },
 {
   "id": 30552,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 12,
   "firman": "yaitu kamu yang menantikan dan mempercepat kedatangan hari Allah. Pada hari itu langit akan binasa dalam api dan unsur-unsur dunia akan hancur karena nyalanya."
 },
 {
   "id": 30553,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 13,
   "firman": "Tetapi sesuai dengan janji-Nya, kita menantikan langit yang baru dan bumi yang baru, di mana terdapat kebenaran."
 },
 {
   "id": 30554,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 14,
   "firman": "Sebab itu, saudara-saudaraku yang kekasih, sambil menantikan semuanya ini, kamu harus berusaha, supaya kamu kedapatan tak bercacat dan tak bernoda di hadapan-Nya, dalam perdamaian dengan Dia."
 },
 {
   "id": 30555,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 15,
   "firman": "Anggaplah kesabaran Tuhan kita sebagai kesempatan bagimu untuk beroleh selamat, seperti juga Paulus, saudara kita yang kekasih, telah menulis kepadamu menurut hikmat yang dikaruniakan kepadanya."
 },
 {
   "id": 30556,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 16,
   "firman": "Hal itu dibuatnya dalam semua suratnya, apabila ia berbicara tentang perkara-perkara ini. Dalam surat-suratnya itu ada hal-hal yang sukar difahami, sehingga orang-orang yang tidak memahaminya dan yang tidak teguh imannya, memutarbalikkannya menjadi kebinasaan mereka sendiri, sama seperti yang juga mereka buat dengan tulisan-tulisan yang lain."
 },
 {
   "id": 30557,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 17,
   "firman": "Tetapi kamu, saudara-saudaraku yang kekasih, kamu telah mengetahui hal ini sebelumnya. Karena itu waspadalah, supaya kamu jangan terseret ke dalam kesesatan orang-orang yang tak mengenal hukum, dan jangan kehilangan peganganmu yang teguh."
 },
 {
   "id": 30558,
   "kitab": "2Pt",
   "pasal": 3,
   "ayat": 18,
   "firman": "Tetapi bertumbuhlah dalam kasih karunia dan dalam pengenalan akan Tuhan dan Juruselamat kita, Yesus Kristus. Bagi-Nya kemuliaan, sekarang dan sampai selama-lamanya."
 },
 {
   "id": 30559,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 1,
   "firman": "Apa yang telah ada sejak semula, yang telah kami dengar, yang telah kami lihat dengan mata kami, yang telah kami saksikan dan yang telah kami raba dengan tangan kami tentang Firman hidup--itulah yang kami tuliskan kepada kamu."
 },
 {
   "id": 30560,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 2,
   "firman": "Hidup itu telah dinyatakan, dan kami telah melihatnya dan sekarang kami bersaksi dan memberitakan kepada kamu tentang hidup kekal, yang ada bersama-sama dengan Bapa dan yang telah dinyatakan kepada kami."
 },
 {
   "id": 30561,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 3,
   "firman": "Apa yang telah kami lihat dan yang telah kami dengar itu, kami beritakan kepada kamu juga, supaya kamupun beroleh persekutuan dengan kami. Dan persekutuan kami adalah persekutuan dengan Bapa dan dengan Anak-Nya, Yesus Kristus."
 },
 {
   "id": 30562,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan semuanya ini kami tuliskan kepada kamu, supaya sukacita kami menjadi sempurna."
 },
 {
   "id": 30563,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan inilah berita, yang telah kami dengar dari Dia, dan yang kami sampaikan kepada kamu: Allah adalah terang dan di dalam Dia sama sekali tidak ada kegelapan."
 },
 {
   "id": 30564,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 6,
   "firman": "Jika kita katakan, bahwa kita beroleh persekutuan dengan Dia, namun kita hidup di dalam kegelapan, kita berdusta dan kita tidak melakukan kebenaran."
 },
 {
   "id": 30565,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 7,
   "firman": "Tetapi jika kita hidup di dalam terang sama seperti Dia ada di dalam terang, maka kita beroleh persekutuan seorang dengan yang lain, dan darah Yesus, Anak-Nya itu, menyucikan kita dari pada segala dosa."
 },
 {
   "id": 30566,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 8,
   "firman": "Jika kita berkata, bahwa kita tidak berdosa, maka kita menipu diri kita sendiri dan kebenaran tidak ada di dalam kita."
 },
 {
   "id": 30567,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 9,
   "firman": "Jika kita mengaku dosa kita, maka Ia adalah setia dan adil, sehingga Ia akan mengampuni segala dosa kita dan menyucikan kita dari segala kejahatan."
 },
 {
   "id": 30568,
   "kitab": "1Yo",
   "pasal": 1,
   "ayat": 10,
   "firman": "Jika kita berkata, bahwa kita tidak ada berbuat dosa, maka kita membuat Dia menjadi pendusta dan firman-Nya tidak ada di dalam kita."
 },
 {
   "id": 30569,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 1,
   "firman": "Anak-anakku, hal-hal ini kutuliskan kepada kamu, supaya kamu jangan berbuat dosa, namun jika seorang berbuat dosa, kita mempunyai seorang pengantara pada Bapa, yaitu Yesus Kristus, yang adil."
 },
 {
   "id": 30570,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 2,
   "firman": "Dan Ia adalah pendamaian untuk segala dosa kita, dan bukan untuk dosa kita saja, tetapi juga untuk dosa seluruh dunia."
 },
 {
   "id": 30571,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan inilah tandanya, bahwa kita mengenal Allah, yaitu jikalau kita menuruti perintah-perintah-Nya."
 },
 {
   "id": 30572,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 4,
   "firman": "Barangsiapa berkata: Aku mengenal Dia, tetapi ia tidak menuruti perintah-Nya, ia adalah seorang pendusta dan di dalamnya tidak ada kebenaran."
 },
 {
   "id": 30573,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 5,
   "firman": "Tetapi barangsiapa menuruti firman-Nya, di dalam orang itu sungguh sudah sempurna kasih Allah; dengan itulah kita ketahui, bahwa kita ada di dalam Dia."
 },
 {
   "id": 30574,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 6,
   "firman": "Barangsiapa mengatakan, bahwa ia ada di dalam Dia, ia wajib hidup sama seperti Kristus telah hidup."
 },
 {
   "id": 30575,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 7,
   "firman": "Saudara-saudara yang kekasih, bukan perintah baru yang kutuliskan kepada kamu, melainkan perintah lama yang telah ada padamu dari mulanya. Perintah lama itu ialah firman yang telah kamu dengar."
 },
 {
   "id": 30576,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 8,
   "firman": "Namun perintah baru juga yang kutuliskan kepada kamu, telah ternyata benar di dalam Dia dan di dalam kamu; sebab kegelapan sedang lenyap dan terang yang benar telah bercahaya."
 },
 {
   "id": 30577,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 9,
   "firman": "Barangsiapa berkata, bahwa ia berada di dalam terang, tetapi ia membenci saudaranya, ia berada di dalam kegelapan sampai sekarang."
 },
 {
   "id": 30578,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 10,
   "firman": "Barangsiapa mengasihi saudaranya, ia tetap berada di dalam terang, dan di dalam dia tidak ada penyesatan."
 },
 {
   "id": 30579,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 11,
   "firman": "Tetapi barangsiapa membenci saudaranya, ia berada di dalam kegelapan dan hidup di dalam kegelapan. Ia tidak tahu ke mana ia pergi, karena kegelapan itu telah membutakan matanya."
 },
 {
   "id": 30580,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 12,
   "firman": "Aku menulis kepada kamu, hai anak-anak, sebab dosamu telah diampuni oleh karena nama-Nya."
 },
 {
   "id": 30581,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 13,
   "firman": "Aku menulis kepada kamu, hai bapa-bapa, karena kamu telah mengenal Dia, yang ada dari mulanya. Aku menulis kepada kamu, hai orang-orang muda, karena kamu telah mengalahkan yang jahat."
 },
 {
   "id": 30582,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 14,
   "firman": "Aku menulis kepada kamu, hai anak-anak, karena kamu mengenal Bapa. Aku menulis kepada kamu, hai bapa-bapa, karena kamu mengenal Dia, yang ada dari mulanya. Aku menulis kepada kamu, hai orang-orang muda, karena kamu kuat dan firman Allah diam di dalam kamu dan kamu telah mengalahkan yang jahat."
 },
 {
   "id": 30583,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 15,
   "firman": "Janganlah kamu mengasihi dunia dan apa yang ada di dalamnya. Jikalau orang mengasihi dunia, maka kasih akan Bapa tidak ada di dalam orang itu."
 },
 {
   "id": 30584,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 16,
   "firman": "Sebab semua yang ada di dalam dunia, yaitu keinginan daging dan keinginan mata serta keangkuhan hidup, bukanlah berasal dari Bapa, melainkan dari dunia."
 },
 {
   "id": 30585,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 17,
   "firman": "Dan dunia ini sedang lenyap dengan keinginannya, tetapi orang yang melakukan kehendak Allah tetap hidup selama-lamanya."
 },
 {
   "id": 30586,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 18,
   "firman": "Anak-anakku, waktu ini adalah waktu yang terakhir, dan seperti yang telah kamu dengar, seorang antikristus akan datang, sekarang telah bangkit banyak antikristus. Itulah tandanya, bahwa waktu ini benar-benar adalah waktu yang terakhir."
 },
 {
   "id": 30587,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 19,
   "firman": "Memang mereka berasal dari antara kita, tetapi mereka tidak sungguh-sungguh termasuk pada kita; sebab jika mereka sungguh-sungguh termasuk pada kita, niscaya mereka tetap bersama-sama dengan kita. Tetapi hal itu terjadi, supaya menjadi nyata, bahwa tidak semua mereka sungguh-sungguh termasuk pada kita."
 },
 {
   "id": 30588,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 20,
   "firman": "Tetapi kamu telah beroleh pengurapan dari Yang Kudus, dan dengan demikian kamu semua mengetahuinya."
 },
 {
   "id": 30589,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 21,
   "firman": "Aku menulis kepadamu, bukan karena kamu tidak mengetahui kebenaran, tetapi justru karena kamu mengetahuinya dan karena kamu juga mengetahui, bahwa tidak ada dusta yang berasal dari kebenaran."
 },
 {
   "id": 30590,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 22,
   "firman": "Siapakah pendusta itu? Bukankah dia yang menyangkal bahwa Yesus adalah Kristus? Dia itu adalah antikristus, yaitu dia yang menyangkal baik Bapa maupun Anak."
 },
 {
   "id": 30591,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 23,
   "firman": "Sebab barangsiapa menyangkal Anak, ia juga tidak memiliki Bapa. Barangsiapa mengaku Anak, ia juga memiliki Bapa."
 },
 {
   "id": 30592,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 24,
   "firman": "Dan kamu, apa yang telah kamu dengar dari mulanya, itu harus tetap tinggal di dalam kamu. Jika apa yang telah kamu dengar dari mulanya itu tetap tinggal di dalam kamu, maka kamu akan tetap tinggal di dalam Anak dan di dalam Bapa."
 },
 {
   "id": 30593,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 25,
   "firman": "Dan inilah janji yang telah dijanjikan-Nya sendiri kepada kita, yaitu hidup yang kekal."
 },
 {
   "id": 30594,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 26,
   "firman": "Semua itu kutulis kepadamu, yaitu mengenai orang-orang yang berusaha menyesatkan kamu."
 },
 {
   "id": 30595,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 27,
   "firman": "Sebab di dalam diri kamu tetap ada pengurapan yang telah kamu terima dari pada-Nya. Karena itu tidak perlu kamu diajar oleh orang lain. Tetapi sebagaimana pengurapan-Nya mengajar kamu tentang segala sesuatu--dan pengajaran-Nya itu benar, tidak dusta--dan sebagaimana Ia dahulu telah mengajar kamu, demikianlah hendaknya kamu tetap tinggal di dalam Dia."
 },
 {
   "id": 30596,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 28,
   "firman": "Maka sekarang, anak-anakku, tinggallah di dalam Kristus, supaya apabila Ia menyatakan diri-Nya, kita beroleh keberanian percaya dan tidak usah malu terhadap Dia pada hari kedatangan-Nya."
 },
 {
   "id": 30597,
   "kitab": "1Yo",
   "pasal": 2,
   "ayat": 29,
   "firman": "Jikalau kamu tahu, bahwa Ia adalah benar, kamu harus tahu juga, bahwa setiap orang, yang berbuat kebenaran, lahir dari pada-Nya."
 },
 {
   "id": 30598,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 1,
   "firman": "Lihatlah, betapa besarnya kasih yang dikaruniakan Bapa kepada kita, sehingga kita disebut anak-anak Allah, dan memang kita adalah anak-anak Allah. Karena itu dunia tidak mengenal kita, sebab dunia tidak mengenal Dia."
 },
 {
   "id": 30599,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 2,
   "firman": "Saudara-saudaraku yang kekasih, sekarang kita adalah anak-anak Allah, tetapi belum nyata apa keadaan kita kelak; akan tetapi kita tahu, bahwa apabila Kristus menyatakan diri-Nya, kita akan menjadi sama seperti Dia, sebab kita akan melihat Dia dalam keadaan-Nya yang sebenarnya."
 },
 {
   "id": 30600,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 3,
   "firman": "Setiap orang yang menaruh pengharapan itu kepada-Nya, menyucikan diri sama seperti Dia yang adalah suci."
 },
 {
   "id": 30601,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 4,
   "firman": "Setiap orang yang berbuat dosa, melanggar juga hukum Allah, sebab dosa ialah pelanggaran hukum Allah."
 },
 {
   "id": 30602,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 5,
   "firman": "Dan kamu tahu, bahwa Ia telah menyatakan diri-Nya, supaya Ia menghapus segala dosa, dan di dalam Dia tidak ada dosa."
 },
 {
   "id": 30603,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 6,
   "firman": "Karena itu setiap orang yang tetap berada di dalam Dia, tidak berbuat dosa lagi; setiap orang yang tetap berbuat dosa, tidak melihat dan tidak mengenal Dia."
 },
 {
   "id": 30604,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 7,
   "firman": "Anak-anakku, janganlah membiarkan seorangpun menyesatkan kamu. Barangsiapa yang berbuat kebenaran adalah benar, sama seperti Kristus adalah benar;"
 },
 {
   "id": 30605,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 8,
   "firman": "barangsiapa yang tetap berbuat dosa, berasal dari Iblis, sebab Iblis berbuat dosa dari mulanya. Untuk inilah Anak Allah menyatakan diri-Nya, yaitu supaya Ia membinasakan perbuatan-perbuatan Iblis itu."
 },
 {
   "id": 30606,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 9,
   "firman": "Setiap orang yang lahir dari Allah, tidak berbuat dosa lagi; sebab benih ilahi tetap ada di dalam dia dan ia tidak dapat berbuat dosa, karena ia lahir dari Allah."
 },
 {
   "id": 30607,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 10,
   "firman": "Inilah tandanya anak-anak Allah dan anak-anak Iblis: setiap orang yang tidak berbuat kebenaran, tidak berasal dari Allah, demikian juga barangsiapa yang tidak mengasihi saudaranya."
 },
 {
   "id": 30608,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 11,
   "firman": "Sebab inilah berita yang telah kamu dengar dari mulanya, yaitu bahwa kita harus saling mengasihi;"
 },
 {
   "id": 30609,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 12,
   "firman": "bukan seperti Kain, yang berasal dari si jahat dan yang membunuh adiknya. Dan apakah sebabnya ia membunuhnya? Sebab segala perbuatannya jahat dan perbuatan adiknya benar."
 },
 {
   "id": 30610,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 13,
   "firman": "Janganlah kamu heran, saudara-saudara, apabila dunia membenci kamu."
 },
 {
   "id": 30611,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 14,
   "firman": "Kita tahu, bahwa kita sudah berpindah dari dalam maut ke dalam hidup, yaitu karena kita mengasihi saudara kita. Barangsiapa tidak mengasihi, ia tetap di dalam maut."
 },
 {
   "id": 30612,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 15,
   "firman": "Setiap orang yang membenci saudaranya, adalah seorang pembunuh manusia. Dan kamu tahu, bahwa tidak ada seorang pembunuh yang tetap memiliki hidup yang kekal di dalam dirinya."
 },
 {
   "id": 30613,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 16,
   "firman": "Demikianlah kita ketahui kasih Kristus, yaitu bahwa Ia telah menyerahkan nyawa-Nya untuk kita; jadi kitapun wajib menyerahkan nyawa kita untuk saudara-saudara kita."
 },
 {
   "id": 30614,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 17,
   "firman": "Barangsiapa mempunyai harta duniawi dan melihat saudaranya menderita kekurangan tetapi menutup pintu hatinya terhadap saudaranya itu, bagaimanakah kasih Allah dapat tetap di dalam dirinya?"
 },
 {
   "id": 30615,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 18,
   "firman": "Anak-anakku, marilah kita mengasihi bukan dengan perkataan atau dengan lidah, tetapi dengan perbuatan dan dalam kebenaran."
 },
 {
   "id": 30616,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 19,
   "firman": "Demikianlah kita ketahui, bahwa kita berasal dari kebenaran. Demikian pula kita boleh menenangkan hati kita di hadapan Allah,"
 },
 {
   "id": 30617,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 20,
   "firman": "sebab jika kita dituduh olehnya, Allah adalah lebih besar dari pada hati kita serta mengetahui segala sesuatu."
 },
 {
   "id": 30618,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 21,
   "firman": "Saudara-saudaraku yang kekasih, jikalau hati kita tidak menuduh kita, maka kita mempunyai keberanian percaya untuk mendekati Allah,"
 },
 {
   "id": 30619,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 22,
   "firman": "dan apa saja yang kita minta, kita memperolehnya dari pada-Nya, karena kita menuruti segala perintah-Nya dan berbuat apa yang berkenan kepada-Nya."
 },
 {
   "id": 30620,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 23,
   "firman": "Dan inilah perintah-Nya itu: supaya kita percaya akan nama Yesus Kristus, Anak-Nya, dan supaya kita saling mengasihi sesuai dengan perintah yang diberikan Kristus kepada kita."
 },
 {
   "id": 30621,
   "kitab": "1Yo",
   "pasal": 3,
   "ayat": 24,
   "firman": "Barangsiapa menuruti segala perintah-Nya, ia diam di dalam Allah dan Allah di dalam dia. Dan demikianlah kita ketahui, bahwa Allah ada di dalam kita, yaitu Roh yang telah Ia karuniakan kepada kita."
 },
 {
   "id": 30622,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 1,
   "firman": "Saudara-saudaraku yang kekasih, janganlah percaya akan setiap roh, tetapi ujilah roh-roh itu, apakah mereka berasal dari Allah; sebab banyak nabi-nabi palsu yang telah muncul dan pergi ke seluruh dunia."
 },
 {
   "id": 30623,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 2,
   "firman": "Demikianlah kita mengenal Roh Allah: setiap roh yang mengaku, bahwa Yesus Kristus telah datang sebagai manusia, berasal dari Allah,"
 },
 {
   "id": 30624,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 3,
   "firman": "dan setiap roh, yang tidak mengaku Yesus, tidak berasal dari Allah. Roh itu adalah roh antikristus dan tentang dia telah kamu dengar, bahwa ia akan datang dan sekarang ini ia sudah ada di dalam dunia."
 },
 {
   "id": 30625,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 4,
   "firman": "Kamu berasal dari Allah, anak-anakku, dan kamu telah mengalahkan nabi-nabi palsu itu; sebab Roh yang ada di dalam kamu, lebih besar dari pada roh yang ada di dalam dunia."
 },
 {
   "id": 30626,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 5,
   "firman": "Mereka berasal dari dunia; sebab itu mereka berbicara tentang hal-hal duniawi dan dunia mendengarkan mereka."
 },
 {
   "id": 30627,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 6,
   "firman": "Kami berasal dari Allah: barangsiapa mengenal Allah, ia mendengarkan kami; barangsiapa tidak berasal dari Allah, ia tidak mendengarkan kami. Itulah tandanya Roh kebenaran dan roh yang menyesatkan."
 },
 {
   "id": 30628,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 7,
   "firman": "Saudara-saudaraku yang kekasih, marilah kita saling mengasihi, sebab kasih itu berasal dari Allah; dan setiap orang yang mengasihi, lahir dari Allah dan mengenal Allah."
 },
 {
   "id": 30629,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 8,
   "firman": "Barangsiapa tidak mengasihi, ia tidak mengenal Allah, sebab Allah adalah kasih."
 },
 {
   "id": 30630,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 9,
   "firman": "Dalam hal inilah kasih Allah dinyatakan di tengah-tengah kita, yaitu bahwa Allah telah mengutus Anak-Nya yang tunggal ke dalam dunia, supaya kita hidup oleh-Nya."
 },
 {
   "id": 30631,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 10,
   "firman": "Inilah kasih itu: Bukan kita yang telah mengasihi Allah, tetapi Allah yang telah mengasihi kita dan yang telah mengutus Anak-Nya sebagai pendamaian bagi dosa-dosa kita."
 },
 {
   "id": 30632,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 11,
   "firman": "Saudara-saudaraku yang kekasih, jikalau Allah sedemikian mengasihi kita, maka haruslah kita juga saling mengasihi."
 },
 {
   "id": 30633,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 12,
   "firman": "Tidak ada seorangpun yang pernah melihat Allah. Jika kita saling mengasihi, Allah tetap di dalam kita, dan kasih-Nya sempurna di dalam kita."
 },
 {
   "id": 30634,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 13,
   "firman": "Demikianlah kita ketahui, bahwa kita tetap berada di dalam Allah dan Dia di dalam kita: Ia telah mengaruniakan kita mendapat bagian dalam Roh-Nya."
 },
 {
   "id": 30635,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 14,
   "firman": "Dan kami telah melihat dan bersaksi, bahwa Bapa telah mengutus Anak-Nya menjadi Juruselamat dunia."
 },
 {
   "id": 30636,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 15,
   "firman": "Barangsiapa mengaku, bahwa Yesus adalah Anak Allah, Allah tetap berada di dalam dia dan dia di dalam Allah."
 },
 {
   "id": 30637,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 16,
   "firman": "Kita telah mengenal dan telah percaya akan kasih Allah kepada kita. Allah adalah kasih, dan barangsiapa tetap berada di dalam kasih, ia tetap berada di dalam Allah dan Allah di dalam dia."
 },
 {
   "id": 30638,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 17,
   "firman": "Dalam hal inilah kasih Allah sempurna di dalam kita, yaitu kalau kita mempunyai keberanian percaya pada hari penghakiman, karena sama seperti Dia, kita juga ada di dalam dunia ini."
 },
 {
   "id": 30639,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 18,
   "firman": "Di dalam kasih tidak ada ketakutan: kasih yang sempurna melenyapkan ketakutan; sebab ketakutan mengandung hukuman dan barangsiapa takut, ia tidak sempurna di dalam kasih."
 },
 {
   "id": 30640,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 19,
   "firman": "Kita mengasihi, karena Allah lebih dahulu mengasihi kita."
 },
 {
   "id": 30641,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 20,
   "firman": "Jikalau seorang berkata: \"Aku mengasihi Allah,\" dan ia membenci saudaranya, maka ia adalah pendusta, karena barangsiapa tidak mengasihi saudaranya yang dilihatnya, tidak mungkin mengasihi Allah, yang tidak dilihatnya."
 },
 {
   "id": 30642,
   "kitab": "1Yo",
   "pasal": 4,
   "ayat": 21,
   "firman": "Dan perintah ini kita terima dari Dia: Barangsiapa mengasihi Allah, ia harus juga mengasihi saudaranya."
 },
 {
   "id": 30643,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 1,
   "firman": "Setiap orang yang percaya, bahwa Yesus adalah Kristus, lahir dari Allah; dan setiap orang yang mengasihi Dia yang melahirkan, mengasihi juga Dia yang lahir dari pada-Nya."
 },
 {
   "id": 30644,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 2,
   "firman": "Inilah tandanya, bahwa kita mengasihi anak-anak Allah, yaitu apabila kita mengasihi Allah serta melakukan perintah-perintah-Nya."
 },
 {
   "id": 30645,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 3,
   "firman": "Sebab inilah kasih kepada Allah, yaitu, bahwa kita menuruti perintah-perintah-Nya. Perintah-perintah-Nya itu tidak berat,"
 },
 {
   "id": 30646,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 4,
   "firman": "sebab semua yang lahir dari Allah, mengalahkan dunia. Dan inilah kemenangan yang mengalahkan dunia: iman kita."
 },
 {
   "id": 30647,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 5,
   "firman": "Siapakah yang mengalahkan dunia, selain dari pada dia yang percaya, bahwa Yesus adalah Anak Allah?"
 },
 {
   "id": 30648,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 6,
   "firman": "Inilah Dia yang telah datang dengan air dan darah, yaitu Yesus Kristus, bukan saja dengan air, tetapi dengan air dan dengan darah. Dan Rohlah yang memberi kesaksian, karena Roh adalah kebenaran."
 },
 {
   "id": 30649,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 7,
   "firman": "Sebab ada tiga yang memberi kesaksian (di dalam sorga: Bapa, Firman dan Roh Kudus; dan ketiganya adalah satu."
 },
 {
   "id": 30650,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 8,
   "firman": "Dan ada tiga yang memberi kesaksian di bumi): Roh dan air dan darah dan ketiganya adalah satu."
 },
 {
   "id": 30651,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 9,
   "firman": "Kita menerima kesaksian manusia, tetapi kesaksian Allah lebih kuat. Sebab demikianlah kesaksian yang diberikan Allah tentang Anak-Nya."
 },
 {
   "id": 30652,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 10,
   "firman": "Barangsiapa percaya kepada Anak Allah, ia mempunyai kesaksian itu di dalam dirinya; barangsiapa tidak percaya kepada Allah, ia membuat Dia menjadi pendusta, karena ia tidak percaya akan kesaksian yang diberikan Allah tentang Anak-Nya."
 },
 {
   "id": 30653,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 11,
   "firman": "Dan inilah kesaksian itu: Allah telah mengaruniakan hidup yang kekal kepada kita dan hidup itu ada di dalam Anak-Nya."
 },
 {
   "id": 30654,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 12,
   "firman": "Barangsiapa memiliki Anak, ia memiliki hidup; barangsiapa tidak memiliki Anak, ia tidak memiliki hidup."
 },
 {
   "id": 30655,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 13,
   "firman": "Semuanya itu kutuliskan kepada kamu, supaya kamu yang percaya kepada nama Anak Allah, tahu, bahwa kamu memiliki hidup yang kekal."
 },
 {
   "id": 30656,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 14,
   "firman": "Dan inilah keberanian percaya kita kepada-Nya, yaitu bahwa Ia mengabulkan doa kita, jikalau kita meminta sesuatu kepada-Nya menurut kehendak-Nya."
 },
 {
   "id": 30657,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 15,
   "firman": "Dan jikalau kita tahu, bahwa Ia mengabulkan apa saja yang kita minta, maka kita juga tahu, bahwa kita telah memperoleh segala sesuatu yang telah kita minta kepada-Nya."
 },
 {
   "id": 30658,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 16,
   "firman": "Kalau ada seorang melihat saudaranya berbuat dosa, yaitu dosa yang tidak mendatangkan maut, hendaklah ia berdoa kepada Allah dan Dia akan memberikan hidup kepadanya, yaitu mereka, yang berbuat dosa yang tidak mendatangkan maut. Ada dosa yang mendatangkan maut: tentang itu tidak kukatakan, bahwa ia harus berdoa."
 },
 {
   "id": 30659,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 17,
   "firman": "Semua kejahatan adalah dosa, tetapi ada dosa yang tidak mendatangkan maut."
 },
 {
   "id": 30660,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 18,
   "firman": "Kita tahu, bahwa setiap orang yang lahir dari Allah, tidak berbuat dosa; tetapi Dia yang lahir dari Allah melindunginya, dan si jahat tidak dapat menjamahnya."
 },
 {
   "id": 30661,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 19,
   "firman": "Kita tahu, bahwa kita berasal dari Allah dan seluruh dunia berada di bawah kuasa si jahat."
 },
 {
   "id": 30662,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 20,
   "firman": "Akan tetapi kita tahu, bahwa Anak Allah telah datang dan telah mengaruniakan pengertian kepada kita, supaya kita mengenal Yang Benar; dan kita ada di dalam Yang Benar, di dalam Anak-Nya Yesus Kristus. Dia adalah Allah yang benar dan hidup yang kekal."
 },
 {
   "id": 30663,
   "kitab": "1Yo",
   "pasal": 5,
   "ayat": 21,
   "firman": "Anak-anakku, waspadalah terhadap segala berhala."
 },
 {
   "id": 30664,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari penatua kepada Ibu yang terpilih dan anak-anaknya yang benar-benar aku kasihi. Bukan aku saja yang mengasihi kamu, tetapi juga semua orang yang telah mengenal kebenaran,"
 },
 {
   "id": 30665,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 2,
   "firman": "oleh karena kebenaran yang tetap di dalam kita dan yang akan menyertai kita sampai selama-lamanya."
 },
 {
   "id": 30666,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 3,
   "firman": "Kasih karunia, rahmat dan damai sejahtera dari Allah Bapa, dan dari Yesus Kristus, Anak Bapa, akan menyertai kita dalam kebenaran dan kasih."
 },
 {
   "id": 30667,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 4,
   "firman": "Aku sangat bersukacita, bahwa aku mendapati, bahwa separuh dari anak-anakmu hidup dalam kebenaran sesuai dengan perintah yang telah kita terima dari Bapa."
 },
 {
   "id": 30668,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan sekarang aku minta kepadamu, Ibu--bukan seolah-olah aku menuliskan perintah baru bagimu, tetapi menurut perintah yang sudah ada pada kita dari mulanya--supaya kita saling mengasihi."
 },
 {
   "id": 30669,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan inilah kasih itu, yaitu bahwa kita harus hidup menurut perintah-Nya. Dan inilah perintah itu, yaitu bahwa kamu harus hidup di dalam kasih, sebagaimana telah kamu dengar dari mulanya."
 },
 {
   "id": 30670,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sebab banyak penyesat telah muncul dan pergi ke seluruh dunia, yang tidak mengaku, bahwa Yesus Kristus telah datang sebagai manusia. Itu adalah si penyesat dan antikristus."
 },
 {
   "id": 30671,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 8,
   "firman": "Waspadalah, supaya kamu jangan kehilangan apa yang telah kami kerjakan itu, tetapi supaya kamu mendapat upahmu sepenuhnya."
 },
 {
   "id": 30672,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 9,
   "firman": "Setiap orang yang tidak tinggal di dalam ajaran Kristus, tetapi yang melangkah keluar dari situ, tidak memiliki Allah. Barangsiapa tinggal di dalam ajaran itu, ia memiliki Bapa maupun Anak."
 },
 {
   "id": 30673,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 10,
   "firman": "Jikalau seorang datang kepadamu dan ia tidak membawa ajaran ini, janganlah kamu menerima dia di dalam rumahmu dan janganlah memberi salam kepadanya."
 },
 {
   "id": 30674,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab barangsiapa memberi salam kepadanya, ia mendapat bagian dalam perbuatannya yang jahat."
 },
 {
   "id": 30675,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 12,
   "firman": "Sungguhpun banyak yang harus kutulis kepadamu, aku tidak mau melakukannya dengan kertas dan tinta, tetapi aku berharap datang sendiri kepadamu dan berbicara berhadapan muka dengan kamu, supaya sempurnalah sukacita kita."
 },
 {
   "id": 30676,
   "kitab": "2Yo",
   "pasal": 1,
   "ayat": 13,
   "firman": "Salam kepada kamu dari anak-anak saudaramu yang terpilih."
 },
 {
   "id": 30677,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari penatua kepada Gayus yang kekasih, yang kukasihi dalam kebenaran."
 },
 {
   "id": 30678,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 2,
   "firman": "Saudaraku yang kekasih, aku berdoa, semoga engkau baik-baik dan sehat-sehat saja dalam segala sesuatu, sama seperti jiwamu baik-baik saja."
 },
 {
   "id": 30679,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 3,
   "firman": "Sebab aku sangat bersukacita, ketika beberapa saudara datang dan memberi kesaksian tentang hidupmu dalam kebenaran, sebab memang engkau hidup dalam kebenaran."
 },
 {
   "id": 30680,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 4,
   "firman": "Bagiku tidak ada sukacita yang lebih besar dari pada mendengar, bahwa anak-anakku hidup dalam kebenaran."
 },
 {
   "id": 30681,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 5,
   "firman": "Saudaraku yang kekasih, engkau bertindak sebagai orang percaya, di mana engkau berbuat segala sesuatu untuk saudara-saudara, sekalipun mereka adalah orang-orang asing."
 },
 {
   "id": 30682,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 6,
   "firman": "Mereka telah memberi kesaksian di hadapan jemaat tentang kasihmu. Baik benar perbuatanmu, jikalau engkau menolong mereka dalam perjalanan mereka, dengan suatu cara yang berkenan kepada Allah."
 },
 {
   "id": 30683,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 7,
   "firman": "Sebab karena nama-Nya mereka telah berangkat dengan tidak menerima sesuatupun dari orang-orang yang tidak mengenal Allah."
 },
 {
   "id": 30684,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 8,
   "firman": "Kita wajib menerima orang-orang yang demikian, supaya kita boleh mengambil bagian dalam pekerjaan mereka untuk kebenaran."
 },
 {
   "id": 30685,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 9,
   "firman": "Aku telah menulis sedikit kepada jemaat, tetapi Diotrefes yang ingin menjadi orang terkemuka di antara mereka, tidak mau mengakui kami."
 },
 {
   "id": 30686,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 10,
   "firman": "Karena itu, apabila aku datang, aku akan meminta perhatian atas segala perbuatan yang telah dilakukannya, sebab ia meleter melontarkan kata-kata yang kasar terhadap kami; dan belum merasa puas dengan itu, ia sendiri bukan saja tidak mau menerima saudara-saudara yang datang, tetapi juga mencegah orang-orang, yang mau menerima mereka dan mengucilkan orang-orang itu dari jemaat."
 },
 {
   "id": 30687,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 11,
   "firman": "Saudaraku yang kekasih, janganlah meniru yang jahat, melainkan yang baik. Barangsiapa berbuat baik, ia berasal dari Allah, tetapi barangsiapa berbuat jahat, ia tidak pernah melihat Allah."
 },
 {
   "id": 30688,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tentang Demetrius semua orang memberi kesaksian yang baik, malah kebenaran sendiri memberi kesaksian yang demikian. Dan kami juga memberi kesaksian yang baik tentang dia, dan engkau tahu, bahwa kesaksian kami adalah benar."
 },
 {
   "id": 30689,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 13,
   "firman": "Banyak hal yang harus kutuliskan kepadamu, tetapi aku tidak mau menulis kepadamu dengan tinta dan pena."
 },
 {
   "id": 30690,
   "kitab": "3Yo",
   "pasal": 1,
   "ayat": 14,
   "firman": "Aku harap segera berjumpa dengan engkau dan berbicara berhadapan muka. (1-15) Damai sejahtera menyertai engkau! Salam dari sahabat-sahabatmu. Sampaikanlah salamku kepada sahabat-sahabat satu per satu."
 },
 {
   "id": 30691,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 1,
   "firman": "Dari Yudas, hamba Yesus Kristus dan saudara Yakobus, kepada mereka, yang terpanggil, yang dikasihi dalam Allah Bapa, dan yang dipelihara untuk Yesus Kristus."
 },
 {
   "id": 30692,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 2,
   "firman": "Rahmat, damai sejahtera dan kasih kiranya melimpahi kamu."
 },
 {
   "id": 30693,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 3,
   "firman": "Saudara-saudaraku yang kekasih, sementara aku bersungguh-sungguh berusaha menulis kepada kamu tentang keselamatan kita bersama, aku merasa terdorong untuk menulis ini kepada kamu dan menasihati kamu, supaya kamu tetap berjuang untuk mempertahankan iman yang telah disampaikan kepada orang-orang kudus."
 },
 {
   "id": 30694,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 4,
   "firman": "Sebab ternyata ada orang tertentu yang telah masuk menyelusup di tengah-tengah kamu, yaitu orang-orang yang telah lama ditentukan untuk dihukum. Mereka adalah orang-orang yang fasik, yang menyalahgunakan kasih karunia Allah kita untuk melampiaskan hawa nafsu mereka, dan yang menyangkal satu-satunya Penguasa dan Tuhan kita, Yesus Kristus."
 },
 {
   "id": 30695,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 5,
   "firman": "Tetapi, sekalipun kamu telah mengetahui semuanya itu dan tidak meragukannya lagi, aku ingin mengingatkan kamu bahwa memang Tuhan menyelamatkan umat-Nya dari tanah Mesir, namun sekali lagi membinasakan mereka yang tidak percaya."
 },
 {
   "id": 30696,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 6,
   "firman": "Dan bahwa Ia menahan malaikat-malaikat yang tidak taat pada batas-batas kekuasaan mereka, tetapi yang meninggalkan tempat kediaman mereka, dengan belenggu abadi di dalam dunia kekelaman sampai penghakiman pada hari besar,"
 },
 {
   "id": 30697,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 7,
   "firman": "sama seperti Sodom dan Gomora dan kota-kota sekitarnya, yang dengan cara yang sama melakukan percabulan dan mengejar kepuasan-kepuasan yang tak wajar, telah menanggung siksaan api kekal sebagai peringatan kepada semua orang."
 },
 {
   "id": 30698,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 8,
   "firman": "Namun demikian orang-orang yang bermimpi-mimpian ini juga mencemarkan tubuh mereka dan menghina kekuasaan Allah serta menghujat semua yang mulia di sorga."
 },
 {
   "id": 30699,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 9,
   "firman": "Tetapi penghulu malaikat, Mikhael, ketika dalam suatu perselisihan bertengkar dengan Iblis mengenai mayat Musa, tidak berani menghakimi Iblis itu dengan kata-kata hujatan, tetapi berkata: \"Kiranya Tuhan menghardik engkau!\""
 },
 {
   "id": 30700,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 10,
   "firman": "Akan tetapi mereka menghujat segala sesuatu yang tidak mereka ketahui dan justru apa yang mereka ketahui dengan nalurinya seperti binatang yang tidak berakal, itulah yang mengakibatkan kebinasaan mereka."
 },
 {
   "id": 30701,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 11,
   "firman": "Celakalah mereka, karena mereka mengikuti jalan yang ditempuh Kain dan karena mereka, oleh sebab upah, menceburkan diri ke dalam kesesatan Bileam, dan mereka binasa karena kedurhakaan seperti Korah."
 },
 {
   "id": 30702,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 12,
   "firman": "Mereka inilah noda dalam perjamuan kasihmu, di mana mereka tidak malu-malu melahap dan hanya mementingkan dirinya sendiri; mereka bagaikan awan yang tak berair, yang berlalu ditiup angin; mereka bagaikan pohon-pohon yang dalam musim gugur tidak menghasilkan buah, pohon-pohon yang terbantun dengan akar-akarnya dan yang mati sama sekali."
 },
 {
   "id": 30703,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 13,
   "firman": "Mereka bagaikan ombak laut yang ganas, yang membuihkan keaiban mereka sendiri; mereka bagaikan bintang-bintang yang baginya telah tersedia tempat di dunia kekelaman untuk selama-lamanya."
 },
 {
   "id": 30704,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 14,
   "firman": "Juga tentang mereka Henokh, keturunan ketujuh dari Adam, telah bernubuat, katanya: \"Sesungguhnya Tuhan datang dengan beribu-ribu orang kudus-Nya,"
 },
 {
   "id": 30705,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 15,
   "firman": "hendak menghakimi semua orang dan menjatuhkan hukuman atas orang-orang fasik karena semua perbuatan fasik, yang mereka lakukan dan karena semua kata-kata nista, yang diucapkan orang-orang berdosa yang fasik itu terhadap Tuhan.\""
 },
 {
   "id": 30706,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 16,
   "firman": "Mereka itu orang-orang yang menggerutu dan mengeluh tentang nasibnya, hidup menuruti hawa nafsunya, tetapi mulut mereka mengeluarkan perkataan-perkataan yang bukan-bukan dan mereka menjilat orang untuk mendapat keuntungan."
 },
 {
   "id": 30707,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 17,
   "firman": "Tetapi kamu, saudara-saudaraku yang kekasih, ingatlah akan apa yang dahulu telah dikatakan kepada kamu oleh rasul-rasul Tuhan kita, Yesus Kristus."
 },
 {
   "id": 30708,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 18,
   "firman": "Sebab mereka telah mengatakan kepada kamu: \"Menjelang akhir zaman akan tampil pengejek-pengejek yang akan hidup menuruti hawa nafsu kefasikan mereka.\""
 },
 {
   "id": 30709,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 19,
   "firman": "Mereka adalah pemecah belah yang dikuasai hanya oleh keinginan-keinginan dunia ini dan yang hidup tanpa Roh Kudus."
 },
 {
   "id": 30710,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 20,
   "firman": "Akan tetapi kamu, saudara-saudaraku yang kekasih, bangunlah dirimu sendiri di atas dasar imanmu yang paling suci dan berdoalah dalam Roh Kudus."
 },
 {
   "id": 30711,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 21,
   "firman": "Peliharalah dirimu demikian dalam kasih Allah sambil menantikan rahmat Tuhan kita, Yesus Kristus, untuk hidup yang kekal."
 },
 {
   "id": 30712,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 22,
   "firman": "Tunjukkanlah belas kasihan kepada mereka yang ragu-ragu,"
 },
 {
   "id": 30713,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 23,
   "firman": "selamatkanlah mereka dengan jalan merampas mereka dari api. Tetapi tunjukkanlah belas kasihan yang disertai ketakutan kepada orang-orang lain juga, dan bencilah pakaian mereka yang dicemarkan oleh keinginan-keinginan dosa."
 },
 {
   "id": 30714,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 24,
   "firman": "Bagi Dia, yang berkuasa menjaga supaya jangan kamu tersandung dan yang membawa kamu dengan tak bernoda dan penuh kegembiraan di hadapan kemuliaan-Nya,"
 },
 {
   "id": 30715,
   "kitab": "Yud",
   "pasal": 1,
   "ayat": 25,
   "firman": "Allah yang esa, Juruselamat kita oleh Yesus Kristus, Tuhan kita, bagi Dia adalah kemuliaan, kebesaran, kekuatan dan kuasa sebelum segala abad dan sekarang dan sampai selama-lamanya. Amin."
 },
 {
   "id": 30716,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah wahyu Yesus Kristus, yang dikaruniakan Allah kepada-Nya, supaya ditunjukkan-Nya kepada hamba-hamba-Nya apa yang harus segera terjadi. Dan oleh malaikat-Nya yang diutus-Nya, Ia telah menyatakannya kepada hamba-Nya Yohanes."
 },
 {
   "id": 30717,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 2,
   "firman": "Yohanes telah bersaksi tentang firman Allah dan tentang kesaksian yang diberikan oleh Yesus Kristus, yaitu segala sesuatu yang telah dilihatnya."
 },
 {
   "id": 30718,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 3,
   "firman": "Berbahagialah ia yang membacakan dan mereka yang mendengarkan kata-kata nubuat ini, dan yang menuruti apa yang ada tertulis di dalamnya, sebab waktunya sudah dekat."
 },
 {
   "id": 30719,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dari Yohanes kepada ketujuh jemaat yang di Asia Kecil: Kasih karunia dan damai sejahtera menyertai kamu, dari Dia, yang ada dan yang sudah ada dan yang akan datang, dan dari ketujuh roh yang ada di hadapan takhta-Nya,"
 },
 {
   "id": 30720,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 5,
   "firman": "dan dari Yesus Kristus, Saksi yang setia, yang pertama bangkit dari antara orang mati dan yang berkuasa atas raja-raja bumi ini. Bagi Dia, yang mengasihi kita dan yang telah melepaskan kita dari dosa kita oleh darah-Nya--"
 },
 {
   "id": 30721,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 6,
   "firman": "dan yang telah membuat kita menjadi suatu kerajaan, menjadi imam-imam bagi Allah, Bapa-Nya, --bagi Dialah kemuliaan dan kuasa sampai selama-lamanya. Amin."
 },
 {
   "id": 30722,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 7,
   "firman": "Lihatlah, Ia datang dengan awan-awan dan setiap mata akan melihat Dia, juga mereka yang telah menikam Dia. Dan semua bangsa di bumi akan meratapi Dia. Ya, amin."
 },
 {
   "id": 30723,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 8,
   "firman": "\"Aku adalah Alfa dan Omega, firman Tuhan Allah, yang ada dan yang sudah ada dan yang akan datang, Yang Mahakuasa.\""
 },
 {
   "id": 30724,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 9,
   "firman": "Aku, Yohanes, saudara dan sekutumu dalam kesusahan, dalam Kerajaan dan dalam ketekunan menantikan Yesus, berada di pulau yang bernama Patmos oleh karena firman Allah dan kesaksian yang diberikan oleh Yesus."
 },
 {
   "id": 30725,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 10,
   "firman": "Pada hari Tuhan aku dikuasai oleh Roh dan aku mendengar dari belakangku suatu suara yang nyaring, seperti bunyi sangkakala,"
 },
 {
   "id": 30726,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 11,
   "firman": "katanya: \"Apa yang engkau lihat, tuliskanlah di dalam sebuah kitab dan kirimkanlah kepada ketujuh jemaat ini: ke Efesus, ke Smirna, ke Pergamus, ke Tiatira, ke Sardis, ke Filadelfia dan ke Laodikia.\""
 },
 {
   "id": 30727,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 12,
   "firman": "Lalu aku berpaling untuk melihat suara yang berbicara kepadaku. Dan setelah aku berpaling, tampaklah kepadaku tujuh kaki dian dari emas."
 },
 {
   "id": 30728,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 13,
   "firman": "Dan di tengah-tengah kaki dian itu ada seorang serupa Anak Manusia, berpakaian jubah yang panjangnya sampai di kaki, dan dadanya berlilitkan ikat pinggang dari emas."
 },
 {
   "id": 30729,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 14,
   "firman": "Kepala dan rambut-Nya putih bagaikan bulu yang putih metah, dan mata-Nya bagaikan nyala api."
 },
 {
   "id": 30730,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 15,
   "firman": "Dan kaki-Nya mengkilap bagaikan tembaga membara di dalam perapian; suara-Nya bagaikan desau air bah."
 },
 {
   "id": 30731,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 16,
   "firman": "Dan di tangan kanan-Nya Ia memegang tujuh bintang dan dari mulut-Nya keluar sebilah pedang tajam bermata dua, dan wajah-Nya bersinar-sinar bagaikan matahari yang terik."
 },
 {
   "id": 30732,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 17,
   "firman": "Ketika aku melihat Dia, tersungkurlah aku di depan kaki-Nya sama seperti orang yang mati; tetapi Ia meletakkan tangan kanan-Nya di atasku, lalu berkata: \"Jangan takut! Aku adalah Yang Awal dan Yang Akhir,"
 },
 {
   "id": 30733,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 18,
   "firman": "dan Yang Hidup. Aku telah mati, namun lihatlah, Aku hidup, sampai selama-lamanya dan Aku memegang segala kunci maut dan kerajaan maut."
 },
 {
   "id": 30734,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 19,
   "firman": "Karena itu tuliskanlah apa yang telah kaulihat, baik yang terjadi sekarang maupun yang akan terjadi sesudah ini."
 },
 {
   "id": 30735,
   "kitab": "Why",
   "pasal": 1,
   "ayat": 20,
   "firman": "Dan rahasia ketujuh bintang yang telah kaulihat pada tangan kanan-Ku dan ketujuh kaki dian emas itu: ketujuh bintang itu ialah malaikat ketujuh jemaat dan ketujuh kaki dian itu ialah ketujuh jemaat.\""
 },
 {
   "id": 30736,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 1,
   "firman": "\"Tuliskanlah kepada malaikat jemaat di Efesus: Inilah firman dari Dia, yang memegang ketujuh bintang itu di tangan kanan-Nya dan berjalan di antara ketujuh kaki dian emas itu."
 },
 {
   "id": 30737,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 2,
   "firman": "Aku tahu segala pekerjaanmu: baik jerih payahmu maupun ketekunanmu. Aku tahu, bahwa engkau tidak dapat sabar terhadap orang-orang jahat, bahwa engkau telah mencobai mereka yang menyebut dirinya rasul, tetapi yang sebenarnya tidak demikian, bahwa engkau telah mendapati mereka pendusta."
 },
 {
   "id": 30738,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 3,
   "firman": "Dan engkau tetap sabar dan menderita oleh karena nama-Ku; dan engkau tidak mengenal lelah."
 },
 {
   "id": 30739,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 4,
   "firman": "Namun demikian Aku mencela engkau, karena engkau telah meninggalkan kasihmu yang semula."
 },
 {
   "id": 30740,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 5,
   "firman": "Sebab itu ingatlah betapa dalamnya engkau telah jatuh! Bertobatlah dan lakukanlah lagi apa yang semula engkau lakukan. Jika tidak demikian, Aku akan datang kepadamu dan Aku akan mengambil kaki dianmu dari tempatnya, jikalau engkau tidak bertobat."
 },
 {
   "id": 30741,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 6,
   "firman": "Tetapi ini yang ada padamu, yaitu engkau membenci segala perbuatan pengikut-pengikut Nikolaus, yang juga Kubenci."
 },
 {
   "id": 30742,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 7,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat: Barangsiapa menang, dia akan Kuberi makan dari pohon kehidupan yang ada di Taman Firdaus Allah.\""
 },
 {
   "id": 30743,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 8,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Smirna: Inilah firman dari Yang Awal dan Yang Akhir, yang telah mati dan hidup kembali:"
 },
 {
   "id": 30744,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 9,
   "firman": "Aku tahu kesusahanmu dan kemiskinanmu--namun engkau kaya--dan fitnah mereka, yang menyebut dirinya orang Yahudi, tetapi yang sebenarnya tidak demikian: sebaliknya mereka adalah jemaah Iblis."
 },
 {
   "id": 30745,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 10,
   "firman": "Jangan takut terhadap apa yang harus engkau derita! Sesungguhnya Iblis akan melemparkan beberapa orang dari antaramu ke dalam penjara supaya kamu dicobai dan kamu akan beroleh kesusahan selama sepuluh hari. Hendaklah engkau setia sampai mati, dan Aku akan mengaruniakan kepadamu mahkota kehidupan."
 },
 {
   "id": 30746,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 11,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat: Barangsiapa menang, ia tidak akan menderita apa-apa oleh kematian yang kedua.\""
 },
 {
   "id": 30747,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 12,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Pergamus: Inilah firman Dia, yang memakai pedang yang tajam dan bermata dua:"
 },
 {
   "id": 30748,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 13,
   "firman": "Aku tahu di mana engkau diam, yaitu di sana, di tempat takhta Iblis; dan engkau berpegang kepada nama-Ku, dan engkau tidak menyangkal imanmu kepada-Ku, juga tidak pada zaman Antipas, saksi-Ku, yang setia kepada-Ku, yang dibunuh di hadapan kamu, di mana Iblis diam."
 },
 {
   "id": 30749,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 14,
   "firman": "Tetapi Aku mempunyai beberapa keberatan terhadap engkau: di antaramu ada beberapa orang yang menganut ajaran Bileam, yang memberi nasihat kepada Balak untuk menyesatkan orang Israel, supaya mereka makan persembahan berhala dan berbuat zinah."
 },
 {
   "id": 30750,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 15,
   "firman": "Demikian juga ada padamu orang-orang yang berpegang kepada ajaran pengikut Nikolaus."
 },
 {
   "id": 30751,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 16,
   "firman": "Sebab itu bertobatlah! Jika tidak demikian, Aku akan segera datang kepadamu dan Aku akan memerangi mereka dengan pedang yang di mulut-Ku ini."
 },
 {
   "id": 30752,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 17,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat: Barangsiapa menang, kepadanya akan Kuberikan dari manna yang tersembunyi; dan Aku akan mengaruniakan kepadanya batu putih, yang di atasnya tertulis nama baru, yang tidak diketahui oleh siapapun, selain oleh yang menerimanya.\""
 },
 {
   "id": 30753,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 18,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Tiatira: Inilah firman Anak Allah, yang mata-Nya bagaikan nyala api dan kaki-Nya bagaikan tembaga:"
 },
 {
   "id": 30754,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 19,
   "firman": "Aku tahu segala pekerjaanmu: baik kasihmu maupun imanmu, baik pelayananmu maupun ketekunanmu. Aku tahu, bahwa pekerjaanmu yang terakhir lebih banyak dari pada yang pertama."
 },
 {
   "id": 30755,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 20,
   "firman": "Tetapi Aku mencela engkau, karena engkau membiarkan wanita Izebel, yang menyebut dirinya nabiah, mengajar dan menyesatkan hamba-hamba-Ku supaya berbuat zinah dan makan persembahan-persembahan berhala."
 },
 {
   "id": 30756,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 21,
   "firman": "Dan Aku telah memberikan dia waktu untuk bertobat, tetapi ia tidak mau bertobat dari zinahnya."
 },
 {
   "id": 30757,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 22,
   "firman": "Lihatlah, Aku akan melemparkan dia ke atas ranjang orang sakit dan mereka yang berbuat zinah dengan dia akan Kulemparkan ke dalam kesukaran besar, jika mereka tidak bertobat dari perbuatan-perbuatan perempuan itu."
 },
 {
   "id": 30758,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 23,
   "firman": "Dan anak-anaknya akan Kumatikan dan semua jemaat akan mengetahui, bahwa Akulah yang menguji batin dan hati orang, dan bahwa Aku akan membalaskan kepada kamu setiap orang menurut perbuatannya."
 },
 {
   "id": 30759,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 24,
   "firman": "Tetapi kepada kamu, yaitu orang-orang lain di Tiatira, yang tidak mengikuti ajaran itu dan yang tidak menyelidiki apa yang mereka sebut seluk-beluk Iblis, kepada kamu Aku berkata: Aku tidak mau menanggungkan beban lain kepadamu."
 },
 {
   "id": 30760,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 25,
   "firman": "Tetapi apa yang ada padamu, peganglah itu sampai Aku datang."
 },
 {
   "id": 30761,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 26,
   "firman": "Dan barangsiapa menang dan melakukan pekerjaan-Ku sampai kesudahannya, kepadanya akan Kukaruniakan kuasa atas bangsa-bangsa;"
 },
 {
   "id": 30762,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 27,
   "firman": "dan ia akan memerintah mereka dengan tongkat besi; mereka akan diremukkan seperti tembikar tukang periuk--sama seperti yang Kuterima dari Bapa-Ku--"
 },
 {
   "id": 30763,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 28,
   "firman": "dan kepadanya akan Kukaruniakan bintang timur."
 },
 {
   "id": 30764,
   "kitab": "Why",
   "pasal": 2,
   "ayat": 29,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat.\""
 },
 {
   "id": 30765,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 1,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Sardis: Inilah firman Dia, yang memiliki ketujuh Roh Allah dan ketujuh bintang itu: Aku tahu segala pekerjaanmu: engkau dikatakan hidup, padahal engkau mati!"
 },
 {
   "id": 30766,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 2,
   "firman": "Bangunlah, dan kuatkanlah apa yang masih tinggal yang sudah hampir mati, sebab tidak satupun dari pekerjaanmu Aku dapati sempurna di hadapan Allah-Ku."
 },
 {
   "id": 30767,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 3,
   "firman": "Karena itu ingatlah, bagaimana engkau telah menerima dan mendengarnya; turutilah itu dan bertobatlah! Karena jikalau engkau tidak berjaga-jaga, Aku akan datang seperti pencuri dan engkau tidak tahu pada waktu manakah Aku tiba-tiba datang kepadamu."
 },
 {
   "id": 30768,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 4,
   "firman": "Tetapi di Sardis ada beberapa orang yang tidak mencemarkan pakaiannya; mereka akan berjalan dengan Aku dalam pakaian putih, karena mereka adalah layak untuk itu."
 },
 {
   "id": 30769,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 5,
   "firman": "Barangsiapa menang, ia akan dikenakan pakaian putih yang demikian; Aku tidak akan menghapus namanya dari kitab kehidupan, melainkan Aku akan mengaku namanya di hadapan Bapa-Ku dan di hadapan para malaikat-Nya."
 },
 {
   "id": 30770,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 6,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat.\""
 },
 {
   "id": 30771,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 7,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Filadelfia: Inilah firman dari Yang Kudus, Yang Benar, yang memegang kunci Daud; apabila Ia membuka, tidak ada yang dapat menutup; apabila Ia menutup, tidak ada yang dapat membuka."
 },
 {
   "id": 30772,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 8,
   "firman": "Aku tahu segala pekerjaanmu: lihatlah, Aku telah membuka pintu bagimu, yang tidak dapat ditutup oleh seorangpun. Aku tahu bahwa kekuatanmu tidak seberapa, namun engkau menuruti firman-Ku dan engkau tidak menyangkal nama-Ku."
 },
 {
   "id": 30773,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 9,
   "firman": "Lihatlah, beberapa orang dari jemaah Iblis, yaitu mereka yang menyebut dirinya orang Yahudi, tetapi yang sebenarnya tidak demikian, melainkan berdusta, akan Kuserahkan kepadamu. Sesungguhnya Aku akan menyuruh mereka datang dan tersungkur di depan kakimu dan mengaku, bahwa Aku mengasihi engkau."
 },
 {
   "id": 30774,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 10,
   "firman": "Karena engkau menuruti firman-Ku, untuk tekun menantikan Aku, maka Akupun akan melindungi engkau dari hari pencobaan yang akan datang atas seluruh dunia untuk mencobai mereka yang diam di bumi."
 },
 {
   "id": 30775,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 11,
   "firman": "Aku datang segera. Peganglah apa yang ada padamu, supaya tidak seorangpun mengambil mahkotamu."
 },
 {
   "id": 30776,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 12,
   "firman": "Barangsiapa menang, ia akan Kujadikan sokoguru di dalam Bait Suci Allah-Ku, dan ia tidak akan keluar lagi dari situ; dan padanya akan Kutuliskan nama Allah-Ku, nama kota Allah-Ku, yaitu Yerusalem baru, yang turun dari sorga dari Allah-Ku, dan nama-Ku yang baru."
 },
 {
   "id": 30777,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 13,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat.\""
 },
 {
   "id": 30778,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 14,
   "firman": "\"Dan tuliskanlah kepada malaikat jemaat di Laodikia: Inilah firman dari Amin, Saksi yang setia dan benar, permulaan dari ciptaan Allah:"
 },
 {
   "id": 30779,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 15,
   "firman": "Aku tahu segala pekerjaanmu: engkau tidak dingin dan tidak panas. Alangkah baiknya jika engkau dingin atau panas!"
 },
 {
   "id": 30780,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 16,
   "firman": "Jadi karena engkau suam-suam kuku, dan tidak dingin atau panas, Aku akan memuntahkan engkau dari mulut-Ku."
 },
 {
   "id": 30781,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 17,
   "firman": "Karena engkau berkata: Aku kaya dan aku telah memperkayakan diriku dan aku tidak kekurangan apa-apa, dan karena engkau tidak tahu, bahwa engkau melarat, dan malang, miskin, buta dan telanjang,"
 },
 {
   "id": 30782,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 18,
   "firman": "maka Aku menasihatkan engkau, supaya engkau membeli dari pada-Ku emas yang telah dimurnikan dalam api, agar engkau menjadi kaya, dan juga pakaian putih, supaya engkau memakainya, agar jangan kelihatan ketelanjanganmu yang memalukan; dan lagi minyak untuk melumas matamu, supaya engkau dapat melihat."
 },
 {
   "id": 30783,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 19,
   "firman": "Barangsiapa Kukasihi, ia Kutegor dan Kuhajar; sebab itu relakanlah hatimu dan bertobatlah!"
 },
 {
   "id": 30784,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 20,
   "firman": "Lihat, Aku berdiri di muka pintu dan mengetok; jikalau ada orang yang mendengar suara-Ku dan membukakan pintu, Aku akan masuk mendapatkannya dan Aku makan bersama-sama dengan dia, dan ia bersama-sama dengan Aku."
 },
 {
   "id": 30785,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 21,
   "firman": "Barangsiapa menang, ia akan Kududukkan bersama-sama dengan Aku di atas takhta-Ku, sebagaimana Akupun telah menang dan duduk bersama-sama dengan Bapa-Ku di atas takhta-Nya."
 },
 {
   "id": 30786,
   "kitab": "Why",
   "pasal": 3,
   "ayat": 22,
   "firman": "Siapa bertelinga, hendaklah ia mendengarkan apa yang dikatakan Roh kepada jemaat-jemaat.\""
 },
 {
   "id": 30787,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 1,
   "firman": "Kemudian dari pada itu aku melihat: Sesungguhnya, sebuah pintu terbuka di sorga dan suara yang dahulu yang telah kudengar, berkata kepadaku seperti bunyi sangkakala, katanya: Naiklah ke mari dan Aku akan menunjukkan kepadamu apa yang harus terjadi sesudah ini."
 },
 {
   "id": 30788,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 2,
   "firman": "Segera aku dikuasai oleh Roh dan lihatlah, sebuah takhta terdiri di sorga, dan di takhta itu duduk Seorang."
 },
 {
   "id": 30789,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 3,
   "firman": "Dan Dia yang duduk di takhta itu nampaknya bagaikan permata yaspis dan permata sardis; dan suatu pelangi melingkungi takhta itu gilang-gemilang bagaikan zamrud rupanya."
 },
 {
   "id": 30790,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 4,
   "firman": "Dan sekeliling takhta itu ada dua puluh empat takhta, dan di takhta-takhta itu duduk dua puluh empat tua-tua, yang memakai pakaian putih dan mahkota emas di kepala mereka."
 },
 {
   "id": 30791,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 5,
   "firman": "Dan dari takhta itu keluar kilat dan bunyi guruh yang menderu, dan tujuh obor menyala-nyala di hadapan takhta itu: itulah ketujuh Roh Allah."
 },
 {
   "id": 30792,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 6,
   "firman": "Dan di hadapan takhta itu ada lautan kaca bagaikan kristal; di tengah-tengah takhta itu dan di sekelilingnya ada empat makhluk penuh dengan mata, di sebelah muka dan di sebelah belakang."
 },
 {
   "id": 30793,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 7,
   "firman": "Adapun makhluk yang pertama sama seperti singa, dan makhluk yang kedua sama seperti anak lembu, dan makhluk yang ketiga mempunyai muka seperti muka manusia, dan makhluk yang keempat sama seperti burung nasar yang sedang terbang."
 },
 {
   "id": 30794,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 8,
   "firman": "Dan keempat makhluk itu masing-masing bersayap enam, sekelilingnya dan di sebelah dalamnya penuh dengan mata, dan dengan tidak berhenti-hentinya mereka berseru siang dan malam: \"Kudus, kudus, kuduslah Tuhan Allah, Yang Mahakuasa, yang sudah ada dan yang ada dan yang akan datang.\""
 },
 {
   "id": 30795,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 9,
   "firman": "Dan setiap kali makhluk-makhluk itu mempersembahkan puji-pujian, dan hormat dan ucapan syukur kepada Dia, yang duduk di atas takhta itu dan yang hidup sampai selama-lamanya,"
 },
 {
   "id": 30796,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 10,
   "firman": "maka tersungkurlah kedua puluh empat tua-tua itu di hadapan Dia yang duduk di atas takhta itu, dan mereka menyembah Dia yang hidup sampai selama-lamanya. Dan mereka melemparkan mahkotanya di hadapan takhta itu, sambil berkata:"
 },
 {
   "id": 30797,
   "kitab": "Why",
   "pasal": 4,
   "ayat": 11,
   "firman": "\"Ya Tuhan dan Allah kami, Engkau layak menerima puji-pujian dan hormat dan kuasa; sebab Engkau telah menciptakan segala sesuatu; dan oleh karena kehendak-Mu semuanya itu ada dan diciptakan.\""
 },
 {
   "id": 30798,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 1,
   "firman": "Maka aku melihat di tangan kanan Dia yang duduk di atas takhta itu, sebuah gulungan kitab, yang ditulisi sebelah dalam dan sebelah luarnya dan dimeterai dengan tujuh meterai."
 },
 {
   "id": 30799,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 2,
   "firman": "Dan aku melihat seorang malaikat yang gagah, yang berseru dengan suara nyaring, katanya: \"Siapakah yang layak membuka gulungan kitab itu dan membuka meterai-meterainya?\""
 },
 {
   "id": 30800,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 3,
   "firman": "Tetapi tidak ada seorangpun yang di sorga atau yang di bumi atau yang di bawah bumi, yang dapat membuka gulungan kitab itu atau yang dapat melihat sebelah dalamnya."
 },
 {
   "id": 30801,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 4,
   "firman": "Maka menangislah aku dengan amat sedihnya, karena tidak ada seorangpun yang dianggap layak untuk membuka gulungan kitab itu ataupun melihat sebelah dalamnya."
 },
 {
   "id": 30802,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 5,
   "firman": "Lalu berkatalah seorang dari tua-tua itu kepadaku: \"Jangan engkau menangis! Sesungguhnya, singa dari suku Yehuda, yaitu tunas Daud, telah menang, sehingga Ia dapat membuka gulungan kitab itu dan membuka ketujuh meterainya.\""
 },
 {
   "id": 30803,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 6,
   "firman": "Maka aku melihat di tengah-tengah takhta dan keempat makhluk itu dan di tengah-tengah tua-tua itu berdiri seekor Anak Domba seperti telah disembelih, bertanduk tujuh dan bermata tujuh: itulah ketujuh Roh Allah yang diutus ke seluruh bumi."
 },
 {
   "id": 30804,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 7,
   "firman": "Lalu datanglah Anak Domba itu dan menerima gulungan kitab itu dari tangan Dia yang duduk di atas takhta itu."
 },
 {
   "id": 30805,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 8,
   "firman": "Ketika Ia mengambil gulungan kitab itu, tersungkurlah keempat makhluk dan kedua puluh empat tua-tua itu di hadapan Anak Domba itu, masing-masing memegang satu kecapi dan satu cawan emas, penuh dengan kemenyan: itulah doa orang-orang kudus."
 },
 {
   "id": 30806,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dan mereka menyanyikan suatu nyanyian baru katanya: \"Engkau layak menerima gulungan kitab itu dan membuka meterai-meterainya; karena Engkau telah disembelih dan dengan darah-Mu Engkau telah membeli mereka bagi Allah dari tiap-tiap suku dan bahasa dan kaum dan bangsa."
 },
 {
   "id": 30807,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 10,
   "firman": "Dan Engkau telah membuat mereka menjadi suatu kerajaan, dan menjadi imam-imam bagi Allah kita, dan mereka akan memerintah sebagai raja di bumi.\""
 },
 {
   "id": 30808,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 11,
   "firman": "Maka aku melihat dan mendengar suara banyak malaikat sekeliling takhta, makhluk-makhluk dan tua-tua itu; jumlah mereka berlaksa-laksa dan beribu-ribu laksa,"
 },
 {
   "id": 30809,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 12,
   "firman": "katanya dengan suara nyaring: \"Anak Domba yang disembelih itu layak untuk menerima kuasa, dan kekayaan, dan hikmat, dan kekuatan, dan hormat, dan kemuliaan, dan puji-pujian!\""
 },
 {
   "id": 30810,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 13,
   "firman": "Dan aku mendengar semua makhluk yang di sorga dan yang di bumi dan yang di bawah bumi dan yang di laut dan semua yang ada di dalamnya, berkata: \"Bagi Dia yang duduk di atas takhta dan bagi Anak Domba, adalah puji-pujian dan hormat dan kemuliaan dan kuasa sampai selama-lamanya!\""
 },
 {
   "id": 30811,
   "kitab": "Why",
   "pasal": 5,
   "ayat": 14,
   "firman": "Dan keempat makhluk itu berkata: \"Amin\". Dan tua-tua itu jatuh tersungkur dan menyembah."
 },
 {
   "id": 30812,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 1,
   "firman": "Maka aku melihat Anak Domba itu membuka yang pertama dari ketujuh meterai itu, dan aku mendengar yang pertama dari keempat makhluk itu berkata dengan suara bagaikan bunyi guruh: \"Mari!\""
 },
 {
   "id": 30813,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 2,
   "firman": "Dan aku melihat: sesungguhnya, ada seekor kuda putih dan orang yang menungganginya memegang sebuah panah dan kepadanya dikaruniakan sebuah mahkota. Lalu ia maju sebagai pemenang untuk merebut kemenangan."
 },
 {
   "id": 30814,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 3,
   "firman": "Dan ketika Anak Domba itu membuka meterai yang kedua, aku mendengar makhluk yang kedua berkata: \"Mari!\""
 },
 {
   "id": 30815,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 4,
   "firman": "Dan majulah seekor kuda lain, seekor kuda merah padam dan orang yang menungganginya dikaruniakan kuasa untuk mengambil damai sejahtera dari atas bumi, sehingga mereka saling membunuh, dan kepadanya dikaruniakan sebilah pedang yang besar."
 },
 {
   "id": 30816,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 5,
   "firman": "Dan ketika Anak Domba itu membuka meterai yang ketiga, aku mendengar makhluk yang ketiga berkata: \"Mari!\" Dan aku melihat: sesungguhnya, ada seekor kuda hitam dan orang yang menungganginya memegang sebuah timbangan di tangannya."
 },
 {
   "id": 30817,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 6,
   "firman": "Dan aku mendengar seperti ada suara di tengah-tengah keempat makhluk itu berkata: \"Secupak gandum sedinar, dan tiga cupak jelai sedinar. Tetapi janganlah rusakkan minyak dan anggur itu.\""
 },
 {
   "id": 30818,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 7,
   "firman": "Dan ketika Anak Domba itu membuka meterai yang keempat, aku mendengar suara makhluk yang keempat berkata: \"Mari!\""
 },
 {
   "id": 30819,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 8,
   "firman": "Dan aku melihat: sesungguhnya, ada seekor kuda hijau kuning dan orang yang menungganginya bernama Maut dan kerajaan maut mengikutinya. Dan kepada mereka diberikan kuasa atas seperempat dari bumi untuk membunuh dengan pedang, dan dengan kelaparan dan sampar, dan dengan binatang-binatang buas yang di bumi."
 },
 {
   "id": 30820,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 9,
   "firman": "Dan ketika Anak Domba itu membuka meterai yang kelima, aku melihat di bawah mezbah jiwa-jiwa mereka yang telah dibunuh oleh karena firman Allah dan oleh karena kesaksian yang mereka miliki."
 },
 {
   "id": 30821,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 10,
   "firman": "Dan mereka berseru dengan suara nyaring, katanya: \"Berapa lamakah lagi, ya Penguasa yang kudus dan benar, Engkau tidak menghakimi dan tidak membalaskan darah kami kepada mereka yang diam di bumi?\""
 },
 {
   "id": 30822,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 11,
   "firman": "Dan kepada mereka masing-masing diberikan sehelai jubah putih, dan kepada mereka dikatakan, bahwa mereka harus beristirahat sedikit waktu lagi hingga genap jumlah kawan-kawan pelayan dan saudara-saudara mereka, yang akan dibunuh sama seperti mereka."
 },
 {
   "id": 30823,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 12,
   "firman": "Maka aku melihat, ketika Anak Domba itu membuka meterai yang keenam, sesungguhnya terjadilah gempa bumi yang dahsyat dan matahari menjadi hitam bagaikan karung rambut dan bulan menjadi merah seluruhnya bagaikan darah."
 },
 {
   "id": 30824,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan bintang-bintang di langit berjatuhan ke atas bumi bagaikan pohon ara menggugurkan buah-buahnya yang mentah, apabila ia digoncang angin yang kencang."
 },
 {
   "id": 30825,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 14,
   "firman": "Maka menyusutlah langit bagaikan gulungan kitab yang digulung dan tergeserlah gunung-gunung dan pulau-pulau dari tempatnya."
 },
 {
   "id": 30826,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 15,
   "firman": "Dan raja-raja di bumi dan pembesar-pembesar serta perwira-perwira, dan orang-orang kaya serta orang-orang berkuasa, dan semua budak serta orang merdeka bersembunyi ke dalam gua-gua dan celah-celah batu karang di gunung."
 },
 {
   "id": 30827,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 16,
   "firman": "Dan mereka berkata kepada gunung-gunung dan kepada batu-batu karang itu: \"Runtuhlah menimpa kami dan sembunyikanlah kami terhadap Dia, yang duduk di atas takhta dan terhadap murka Anak Domba itu.\""
 },
 {
   "id": 30828,
   "kitab": "Why",
   "pasal": 6,
   "ayat": 17,
   "firman": "Sebab sudah tiba hari besar murka mereka dan siapakah yang dapat bertahan?"
 },
 {
   "id": 30829,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 1,
   "firman": "Kemudian dari pada itu aku melihat empat malaikat berdiri pada keempat penjuru bumi dan mereka menahan keempat angin bumi, supaya jangan ada angin bertiup di darat, atau di laut atau di pohon-pohon."
 },
 {
   "id": 30830,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 2,
   "firman": "Dan aku melihat seorang malaikat lain muncul dari tempat matahari terbit. Ia membawa meterai Allah yang hidup; dan ia berseru dengan suara nyaring kepada keempat malaikat yang ditugaskan untuk merusakkan bumi dan laut,"
 },
 {
   "id": 30831,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 3,
   "firman": "katanya: \"Janganlah merusakkan bumi atau laut atau pohon-pohon sebelum kami memeteraikan hamba-hamba Allah kami pada dahi mereka!\""
 },
 {
   "id": 30832,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 4,
   "firman": "Dan aku mendengar jumlah mereka yang dimeteraikan itu: seratus empat puluh empat ribu yang telah dimeteraikan dari semua suku keturunan Israel."
 },
 {
   "id": 30833,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 5,
   "firman": "Dari suku Yehuda dua belas ribu yang dimeteraikan, dari suku Ruben dua belas ribu, dari suku Gad dua belas ribu,"
 },
 {
   "id": 30834,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 6,
   "firman": "dari suku Asyer dua belas ribu, dari suku Naftali dua belas ribu, dari suku Manasye dua belas ribu,"
 },
 {
   "id": 30835,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 7,
   "firman": "dari suku Simeon dua belas ribu, dari suku Lewi dua belas ribu, dari suku Isakhar dua belas ribu,"
 },
 {
   "id": 30836,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 8,
   "firman": "dari suku Zebulon dua belas ribu, dari suku Yusuf dua belas ribu, dari suku Benyamin dua belas ribu."
 },
 {
   "id": 30837,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 9,
   "firman": "Kemudian dari pada itu aku melihat: sesungguhnya, suatu kumpulan besar orang banyak yang tidak dapat terhitung banyaknya, dari segala bangsa dan suku dan kaum dan bahasa, berdiri di hadapan takhta dan di hadapan Anak Domba, memakai jubah putih dan memegang daun-daun palem di tangan mereka."
 },
 {
   "id": 30838,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 10,
   "firman": "Dan dengan suara nyaring mereka berseru: \"Keselamatan bagi Allah kami yang duduk di atas takhta dan bagi Anak Domba!\""
 },
 {
   "id": 30839,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 11,
   "firman": "Dan semua malaikat berdiri mengelilingi takhta dan tua-tua dan keempat makhluk itu; mereka tersungkur di hadapan takhta itu dan menyembah Allah,"
 },
 {
   "id": 30840,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 12,
   "firman": "sambil berkata: \"Amin! puji-pujian dan kemuliaan, dan hikmat dan syukur, dan hormat dan kekuasaan dan kekuatan bagi Allah kita sampai selama-lamanya! Amin!\""
 },
 {
   "id": 30841,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 13,
   "firman": "Dan seorang dari antara tua-tua itu berkata kepadaku: \"Siapakah mereka yang memakai jubah putih itu dan dari manakah mereka datang?\""
 },
 {
   "id": 30842,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 14,
   "firman": "Maka kataku kepadanya: \"Tuanku, tuan mengetahuinya.\" Lalu ia berkata kepadaku: \"Mereka ini adalah orang-orang yang keluar dari kesusahan yang besar; dan mereka telah mencuci jubah mereka dan membuatnya putih di dalam darah Anak Domba."
 },
 {
   "id": 30843,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 15,
   "firman": "Karena itu mereka berdiri di hadapan takhta Allah dan melayani Dia siang malam di Bait Suci-Nya. Dan Ia yang duduk di atas takhta itu akan membentangkan kemah-Nya di atas mereka."
 },
 {
   "id": 30844,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 16,
   "firman": "Mereka tidak akan menderita lapar dan dahaga lagi, dan matahari atau panas terik tidak akan menimpa mereka lagi."
 },
 {
   "id": 30845,
   "kitab": "Why",
   "pasal": 7,
   "ayat": 17,
   "firman": "Sebab Anak Domba yang di tengah-tengah takhta itu, akan menggembalakan mereka dan akan menuntun mereka ke mata air kehidupan. Dan Allah akan menghapus segala air mata dari mata mereka.\""
 },
 {
   "id": 30846,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 1,
   "firman": "Dan ketika Anak Domba itu membuka meterai yang ketujuh, maka sunyi senyaplah di sorga, kira-kira setengah jam lamanya."
 },
 {
   "id": 30847,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 2,
   "firman": "Lalu aku melihat ketujuh malaikat, yang berdiri di hadapan Allah, dan kepada mereka diberikan tujuh sangkakala."
 },
 {
   "id": 30848,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 3,
   "firman": "Maka datanglah seorang malaikat lain, dan ia pergi berdiri dekat mezbah dengan sebuah pedupaan emas. Dan kepadanya diberikan banyak kemenyan untuk dipersembahkannya bersama-sama dengan doa semua orang kudus di atas mezbah emas di hadapan takhta itu."
 },
 {
   "id": 30849,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 4,
   "firman": "Maka naiklah asap kemenyan bersama-sama dengan doa orang-orang kudus itu dari tangan malaikat itu ke hadapan Allah."
 },
 {
   "id": 30850,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 5,
   "firman": "Lalu malaikat itu mengambil pedupaan itu, mengisinya dengan api dari mezbah, dan melemparkannya ke bumi. Maka meledaklah bunyi guruh, disertai halilintar dan gempa bumi."
 },
 {
   "id": 30851,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 6,
   "firman": "Dan ketujuh malaikat yang memegang ketujuh sangkakala itu bersiap-siap untuk meniup sangkakala."
 },
 {
   "id": 30852,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 7,
   "firman": "Lalu malaikat yang pertama meniup sangkakalanya dan terjadilah hujan es, dan api, bercampur darah; dan semuanya itu dilemparkan ke bumi; maka terbakarlah sepertiga dari bumi dan sepertiga dari pohon-pohon dan hanguslah seluruh rumput-rumputan hijau."
 },
 {
   "id": 30853,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 8,
   "firman": "Lalu malaikat yang kedua meniup sangkakalanya dan ada sesuatu seperti gunung besar, yang menyala-nyala oleh api, dilemparkan ke dalam laut. Dan sepertiga dari laut itu menjadi darah,"
 },
 {
   "id": 30854,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 9,
   "firman": "dan matilah sepertiga dari segala makhluk yang bernyawa di dalam laut dan binasalah sepertiga dari semua kapal."
 },
 {
   "id": 30855,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 10,
   "firman": "Lalu malaikat yang ketiga meniup sangkakalanya dan jatuhlah dari langit sebuah bintang besar, menyala-nyala seperti obor, dan ia menimpa sepertiga dari sungai-sungai dan mata-mata air."
 },
 {
   "id": 30856,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 11,
   "firman": "Nama bintang itu ialah Apsintus. Dan sepertiga dari semua air menjadi apsintus, dan banyak orang mati karena air itu, sebab sudah menjadi pahit."
 },
 {
   "id": 30857,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 12,
   "firman": "Lalu malaikat yang keempat meniup sangkakalanya dan terpukullah sepertiga dari matahari dan sepertiga dari bulan dan sepertiga dari bintang-bintang, sehingga sepertiga dari padanya menjadi gelap dan sepertiga dari siang hari tidak terang dan demikian juga malam hari."
 },
 {
   "id": 30858,
   "kitab": "Why",
   "pasal": 8,
   "ayat": 13,
   "firman": "Lalu aku melihat: aku mendengar seekor burung nasar terbang di tengah langit dan berkata dengan suara nyaring: \"Celaka, celaka, celakalah mereka yang diam di atas bumi oleh karena bunyi sangkakala ketiga malaikat lain, yang masih akan meniup sangkakalanya.\""
 },
 {
   "id": 30859,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 1,
   "firman": "Lalu malaikat yang kelima meniup sangkakalanya, dan aku melihat sebuah bintang yang jatuh dari langit ke atas bumi, dan kepadanya diberikan anak kunci lobang jurang maut."
 },
 {
   "id": 30860,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 2,
   "firman": "Maka dibukanyalah pintu lobang jurang maut itu, lalu naiklah asap dari lobang itu bagaikan asap tanur besar, dan matahari dan angkasa menjadi gelap oleh asap lobang itu."
 },
 {
   "id": 30861,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 3,
   "firman": "Dan dari asap itu berkeluaranlah belalang-belalang ke atas bumi dan kepada mereka diberikan kuasa sama seperti kuasa kalajengking-kalajengking di bumi."
 },
 {
   "id": 30862,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 4,
   "firman": "Dan kepada mereka dipesankan, supaya mereka jangan merusakkan rumput-rumput di bumi atau tumbuh-tumbuhan ataupun pohon-pohon, melainkan hanya manusia yang tidak memakai meterai Allah di dahinya."
 },
 {
   "id": 30863,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 5,
   "firman": "Dan mereka diperkenankan bukan untuk membunuh manusia, melainkan hanya untuk menyiksa mereka lima bulan lamanya, dan siksaan itu seperti siksaan kalajengking, apabila ia menyengat manusia."
 },
 {
   "id": 30864,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 6,
   "firman": "Dan pada masa itu orang-orang akan mencari maut, tetapi mereka tidak akan menemukannya, dan mereka akan ingin mati, tetapi maut lari dari mereka."
 },
 {
   "id": 30865,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 7,
   "firman": "Dan rupa belalang-belalang itu sama seperti kuda yang disiapkan untuk peperangan, dan di atas kepala mereka ada sesuatu yang menyerupai mahkota emas, dan muka mereka sama seperti muka manusia,"
 },
 {
   "id": 30866,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 8,
   "firman": "dan rambut mereka sama seperti rambut perempuan dan gigi mereka sama seperti gigi singa,"
 },
 {
   "id": 30867,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 9,
   "firman": "dan dada mereka sama seperti baju zirah, dan bunyi sayap mereka bagaikan bunyi kereta-kereta yang ditarik banyak kuda, yang sedang lari ke medan peperangan."
 },
 {
   "id": 30868,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 10,
   "firman": "Dan ekor mereka sama seperti kalajengking dan ada sengatnya, dan di dalam ekor mereka itu terdapat kuasa mereka untuk menyakiti manusia, lima bulan lamanya."
 },
 {
   "id": 30869,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 11,
   "firman": "Dan raja yang memerintah mereka ialah malaikat jurang maut; namanya dalam bahasa Ibrani ialah Abadon dan dalam bahasa Yunani ialah Apolion."
 },
 {
   "id": 30870,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 12,
   "firman": "Celaka yang pertama sudah lewat. Sekarang akan menyusul dua celaka lagi."
 },
 {
   "id": 30871,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 13,
   "firman": "Lalu malaikat yang keenam meniup sangkakalanya, dan aku mendengar suatu suara keluar dari keempat tanduk mezbah emas yang di hadapan Allah,"
 },
 {
   "id": 30872,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 14,
   "firman": "dan berkata kepada malaikat yang keenam yang memegang sangkakala itu: \"Lepaskanlah keempat malaikat yang terikat dekat sungai besar Efrat itu.\""
 },
 {
   "id": 30873,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 15,
   "firman": "Maka dilepaskanlah keempat malaikat yang telah disiapkan bagi jam dan hari, bulan dan tahun untuk membunuh sepertiga dari umat manusia."
 },
 {
   "id": 30874,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 16,
   "firman": "Dan jumlah tentara itu ialah dua puluh ribu laksa pasukan berkuda; aku mendengar jumlah mereka."
 },
 {
   "id": 30875,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 17,
   "firman": "Maka demikianlah aku melihat dalam penglihatan ini kuda-kuda dan orang-orang yang menungganginya; mereka memakai baju zirah, merah api dan biru dan kuning belerang warnanya; kepala kuda-kuda itu sama seperti kepala singa, dan dari mulutnya keluar api, dan asap dan belerang."
 },
 {
   "id": 30876,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 18,
   "firman": "Oleh ketiga malapetaka ini dibunuh sepertiga dari umat manusia, yaitu oleh api, dan asap dan belerang, yang keluar dari mulutnya."
 },
 {
   "id": 30877,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 19,
   "firman": "Sebab kuasa kuda-kuda itu terdapat di dalam mulutnya dan di dalam ekornya. Sebab ekornya sama seperti ular; mereka berkepala dan dengan kepala mereka itu mereka mendatangkan kerusakan."
 },
 {
   "id": 30878,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 20,
   "firman": "Tetapi manusia lain, yang tidak mati oleh malapetaka itu, tidak juga bertobat dari perbuatan tangan mereka: mereka tidak berhenti menyembah roh-roh jahat dan berhala-berhala dari emas dan perak, dari tembaga, batu dan kayu yang tidak dapat melihat atau mendengar atau berjalan,"
 },
 {
   "id": 30879,
   "kitab": "Why",
   "pasal": 9,
   "ayat": 21,
   "firman": "dan mereka tidak bertobat dari pada pembunuhan, sihir, percabulan dan pencurian."
 },
 {
   "id": 30880,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 1,
   "firman": "Dan aku melihat seorang malaikat lain yang kuat turun dari sorga, berselubungkan awan, dan pelangi ada di atas kepalanya dan mukanya sama seperti matahari, dan kakinya bagaikan tiang api."
 },
 {
   "id": 30881,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 2,
   "firman": "Dalam tangannya ia memegang sebuah gulungan kitab kecil yang terbuka. Ia menginjakkan kaki kanannya di atas laut dan kaki kirinya di atas bumi,"
 },
 {
   "id": 30882,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 3,
   "firman": "dan ia berseru dengan suara nyaring sama seperti singa yang mengaum. Dan sesudah ia berseru, ketujuh guruh itu memperdengarkan suaranya."
 },
 {
   "id": 30883,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 4,
   "firman": "Dan sesudah ketujuh guruh itu selesai berbicara, aku mau menuliskannya, tetapi aku mendengar suatu suara dari sorga berkata: \"Meteraikanlah apa yang dikatakan oleh ketujuh guruh itu dan janganlah engkau menuliskannya!\""
 },
 {
   "id": 30884,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 5,
   "firman": "Dan malaikat yang kulihat berdiri di atas laut dan di atas bumi, mengangkat tangan kanannya ke langit,"
 },
 {
   "id": 30885,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 6,
   "firman": "dan ia bersumpah demi Dia yang hidup sampai selama-lamanya, yang telah menciptakan langit dan segala isinya, dan bumi dan segala isinya, dan laut dan segala isinya, katanya: \"Tidak akan ada penundaan lagi!"
 },
 {
   "id": 30886,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 7,
   "firman": "Tetapi pada waktu bunyi sangkakala dari malaikat yang ketujuh, yaitu apabila ia meniup sangkakalanya, maka akan genaplah keputusan rahasia Allah, seperti yang telah Ia beritakan kepada hamba-hamba-Nya, yaitu para nabi.\""
 },
 {
   "id": 30887,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 8,
   "firman": "Dan suara yang telah kudengar dari langit itu, berkata pula kepadaku, katanya: \"Pergilah, ambillah gulungan kitab yang terbuka di tangan malaikat, yang berdiri di atas laut dan di atas bumi itu.\""
 },
 {
   "id": 30888,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 9,
   "firman": "Lalu aku pergi kepada malaikat itu dan meminta kepadanya, supaya ia memberikan gulungan kitab itu kepadaku. Katanya kepadaku: \"Ambillah dan makanlah dia; ia akan membuat perutmu terasa pahit, tetapi di dalam mulutmu ia akan terasa manis seperti madu.\""
 },
 {
   "id": 30889,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 10,
   "firman": "Lalu aku mengambil kitab itu dari tangan malaikat itu, dan memakannya: di dalam mulutku ia terasa manis seperti madu, tetapi sesudah aku memakannya, perutku menjadi pahit rasanya."
 },
 {
   "id": 30890,
   "kitab": "Why",
   "pasal": 10,
   "ayat": 11,
   "firman": "Maka ia berkata kepadaku: \"Engkau harus bernubuat lagi kepada banyak bangsa dan kaum dan bahasa dan raja.\""
 },
 {
   "id": 30891,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 1,
   "firman": "Kemudian diberikanlah kepadaku sebatang buluh, seperti tongkat pengukur rupanya, dengan kata-kata yang berikut: \"Bangunlah dan ukurlah Bait Suci Allah dan mezbah dan mereka yang beribadah di dalamnya."
 },
 {
   "id": 30892,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 2,
   "firman": "Tetapi kecualikan pelataran Bait Suci yang di sebelah luar, janganlah engkau mengukurnya, karena ia telah diberikan kepada bangsa-bangsa lain dan mereka akan menginjak-injak Kota Suci empat puluh dua bulan lamanya.\""
 },
 {
   "id": 30893,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 3,
   "firman": "Dan Aku akan memberi tugas kepada dua saksi-Ku, supaya mereka bernubuat sambil berkabung, seribu dua ratus enam puluh hari lamanya."
 },
 {
   "id": 30894,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 4,
   "firman": "Mereka adalah kedua pohon zaitun dan kedua kaki dian yang berdiri di hadapan Tuhan semesta alam."
 },
 {
   "id": 30895,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 5,
   "firman": "Dan jikalau ada orang yang hendak menyakiti mereka, keluarlah api dari mulut mereka menghanguskan semua musuh mereka. Dan jikalau ada orang yang hendak menyakiti mereka, maka orang itu harus mati secara itu."
 },
 {
   "id": 30896,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 6,
   "firman": "Mereka mempunyai kuasa menutup langit, supaya jangan turun hujan selama mereka bernubuat; dan mereka mempunyai kuasa atas segala air untuk mengubahnya menjadi darah, dan untuk memukul bumi dengan segala jenis malapetaka, setiap kali mereka menghendakinya."
 },
 {
   "id": 30897,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 7,
   "firman": "Dan apabila mereka telah menyelesaikan kesaksian mereka, maka binatang yang muncul dari jurang maut, akan memerangi mereka dan mengalahkan serta membunuh mereka."
 },
 {
   "id": 30898,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 8,
   "firman": "Dan mayat mereka akan terletak di atas jalan raya kota besar, yang secara rohani disebut Sodom dan Mesir, di mana juga Tuhan mereka disalibkan."
 },
 {
   "id": 30899,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 9,
   "firman": "Dan orang-orang dari segala bangsa dan suku dan bahasa dan kaum, melihat mayat mereka tiga setengah hari lamanya dan orang-orang itu tidak memperbolehkan mayat mereka dikuburkan."
 },
 {
   "id": 30900,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 10,
   "firman": "Dan mereka yang diam di atas bumi bergembira dan bersukacita atas mereka itu dan berpesta dan saling mengirim hadiah, karena kedua nabi itu telah merupakan siksaan bagi semua orang yang diam di atas bumi."
 },
 {
   "id": 30901,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 11,
   "firman": "Tiga setengah hari kemudian masuklah roh kehidupan dari Allah ke dalam mereka, sehingga mereka bangkit dan semua orang yang melihat mereka menjadi sangat takut."
 },
 {
   "id": 30902,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 12,
   "firman": "Dan orang-orang itu mendengar suatu suara yang nyaring dari sorga berkata kepada mereka: \"Naiklah ke mari!\" Lalu naiklah mereka ke langit, diselubungi awan, disaksikan oleh musuh-musuh mereka."
 },
 {
   "id": 30903,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 13,
   "firman": "Pada saat itu terjadilah gempa bumi yang dahsyat dan sepersepuluh bagian dari kota itu rubuh, dan tujuh ribu orang mati oleh gempa bumi itu dan orang-orang lain sangat ketakutan, lalu memuliakan Allah yang di sorga."
 },
 {
   "id": 30904,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 14,
   "firman": "Celaka yang kedua sudah lewat: lihatlah, celaka yang ketiga segera menyusul."
 },
 {
   "id": 30905,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 15,
   "firman": "Lalu malaikat yang ketujuh meniup sangkakalanya, dan terdengarlah suara-suara nyaring di dalam sorga, katanya: \"Pemerintahan atas dunia dipegang oleh Tuhan kita dan Dia yang diurapi-Nya, dan Ia akan memerintah sebagai raja sampai selama-lamanya.\""
 },
 {
   "id": 30906,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 16,
   "firman": "Dan kedua puluh empat tua-tua, yang duduk di hadapan Allah di atas takhta mereka, tersungkur dan menyembah Allah,"
 },
 {
   "id": 30907,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 17,
   "firman": "sambil berkata: \"Kami mengucap syukur kepada-Mu, ya Tuhan, Allah, Yang Mahakuasa, yang ada dan yang sudah ada, karena Engkau telah memangku kuasa-Mu yang besar dan telah mulai memerintah sebagai raja"
 },
 {
   "id": 30908,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 18,
   "firman": "dan semua bangsa telah marah, tetapi amarah-Mu telah datang dan saat bagi orang-orang mati untuk dihakimi dan untuk memberi upah kepada hamba-hamba-Mu, nabi-nabi dan orang-orang kudus dan kepada mereka yang takut akan nama-Mu, kepada orang-orang kecil dan orang-orang besar dan untuk membinasakan barangsiapa yang membinasakan bumi.\""
 },
 {
   "id": 30909,
   "kitab": "Why",
   "pasal": 11,
   "ayat": 19,
   "firman": "Maka terbukalah Bait Suci Allah yang di sorga, dan kelihatanlah tabut perjanjian-Nya di dalam Bait Suci itu dan terjadilah kilat dan deru guruh dan gempa bumi dan hujan es lebat."
 },
 {
   "id": 30910,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 1,
   "firman": "Maka tampaklah suatu tanda besar di langit: Seorang perempuan berselubungkan matahari, dengan bulan di bawah kakinya dan sebuah mahkota dari dua belas bintang di atas kepalanya."
 },
 {
   "id": 30911,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 2,
   "firman": "Ia sedang mengandung dan dalam keluhan dan penderitaannya hendak melahirkan ia berteriak kesakitan."
 },
 {
   "id": 30912,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 3,
   "firman": "Maka tampaklah suatu tanda yang lain di langit; dan lihatlah, seekor naga merah padam yang besar, berkepala tujuh dan bertanduk sepuluh, dan di atas kepalanya ada tujuh mahkota."
 },
 {
   "id": 30913,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 4,
   "firman": "Dan ekornya menyeret sepertiga dari bintang-bintang di langit dan melemparkannya ke atas bumi. Dan naga itu berdiri di hadapan perempuan yang hendak melahirkan itu, untuk menelan Anaknya, segera sesudah perempuan itu melahirkan-Nya."
 },
 {
   "id": 30914,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 5,
   "firman": "Maka ia melahirkan seorang Anak laki-laki, yang akan menggembalakan semua bangsa dengan gada besi; tiba-tiba Anaknya itu dirampas dan dibawa lari kepada Allah dan ke takhta-Nya."
 },
 {
   "id": 30915,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 6,
   "firman": "Perempuan itu lari ke padang gurun, di mana telah disediakan suatu tempat baginya oleh Allah, supaya ia dipelihara di situ seribu dua ratus enam puluh hari lamanya."
 },
 {
   "id": 30916,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 7,
   "firman": "Maka timbullah peperangan di sorga. Mikhael dan malaikat-malaikatnya berperang melawan naga itu, dan naga itu dibantu oleh malaikat-malaikatnya,"
 },
 {
   "id": 30917,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 8,
   "firman": "tetapi mereka tidak dapat bertahan; mereka tidak mendapat tempat lagi di sorga."
 },
 {
   "id": 30918,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 9,
   "firman": "Dan naga besar itu, si ular tua, yang disebut Iblis atau Satan, yang menyesatkan seluruh dunia, dilemparkan ke bawah; ia dilemparkan ke bumi, bersama-sama dengan malaikat-malaikatnya."
 },
 {
   "id": 30919,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 10,
   "firman": "Dan aku mendengar suara yang nyaring di sorga berkata: \"Sekarang telah tiba keselamatan dan kuasa dan pemerintahan Allah kita, dan kekuasaan Dia yang diurapi-Nya, karena telah dilemparkan ke bawah pendakwa saudara-saudara kita, yang mendakwa mereka siang dan malam di hadapan Allah kita."
 },
 {
   "id": 30920,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 11,
   "firman": "Dan mereka mengalahkan dia oleh darah Anak Domba, dan oleh perkataan kesaksian mereka. Karena mereka tidak mengasihi nyawa mereka sampai ke dalam maut."
 },
 {
   "id": 30921,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 12,
   "firman": "Karena itu bersukacitalah, hai sorga dan hai kamu sekalian yang diam di dalamnya, celakalah kamu, hai bumi dan laut! karena Iblis telah turun kepadamu, dalam geramnya yang dahsyat, karena ia tahu, bahwa waktunya sudah singkat.\""
 },
 {
   "id": 30922,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 13,
   "firman": "Dan ketika naga itu sadar, bahwa ia telah dilemparkan di atas bumi, ia memburu perempuan yang melahirkan Anak laki-laki itu."
 },
 {
   "id": 30923,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 14,
   "firman": "Kepada perempuan itu diberikan kedua sayap dari burung nasar yang besar, supaya ia terbang ke tempatnya di padang gurun, di mana ia dipelihara jauh dari tempat ular itu selama satu masa dan dua masa dan setengah masa."
 },
 {
   "id": 30924,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 15,
   "firman": "Lalu ular itu menyemburkan dari mulutnya air, sebesar sungai, ke arah perempuan itu, supaya ia dihanyutkan sungai itu."
 },
 {
   "id": 30925,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 16,
   "firman": "Tetapi bumi datang menolong perempuan itu. Ia membuka mulutnya, dan menelan sungai yang disemburkan naga itu dari mulutnya."
 },
 {
   "id": 30926,
   "kitab": "Why",
   "pasal": 12,
   "ayat": 17,
   "firman": "Maka marahlah naga itu kepada perempuan itu, lalu pergi memerangi keturunannya yang lain, yang menuruti hukum-hukum Allah dan memiliki kesaksian Yesus."
 },
 {
   "id": 30927,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 1,
   "firman": "(12-18) Dan ia tinggal berdiri di pantai laut. "
 },
 {
   "id": 30929,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 2,
   "firman": "Binatang yang kulihat itu serupa dengan macan tutul, dan kakinya seperti kaki beruang dan mulutnya seperti mulut singa. Dan naga itu memberikan kepadanya kekuatannya, dan takhtanya dan kekuasaannya yang besar."
 },
 {
   "id": 30930,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 3,
   "firman": "Maka tampaklah kepadaku satu dari kepala-kepalanya seperti kena luka yang membahayakan hidupnya, tetapi luka yang membahayakan hidupnya itu sembuh. Seluruh dunia heran, lalu mengikut binatang itu."
 },
 {
   "id": 30931,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 4,
   "firman": "Dan mereka menyembah naga itu, karena ia memberikan kekuasaan kepada binatang itu. Dan mereka menyembah binatang itu, sambil berkata: \"Siapakah yang sama seperti binatang ini? Dan siapakah yang dapat berperang melawan dia?\""
 },
 {
   "id": 30932,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 5,
   "firman": "Dan kepada binatang itu diberikan mulut, yang penuh kesombongan dan hujat; kepadanya diberikan juga kuasa untuk melakukannya empat puluh dua bulan lamanya."
 },
 {
   "id": 30933,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 6,
   "firman": "Lalu ia membuka mulutnya untuk menghujat Allah, menghujat nama-Nya dan kemah kediaman-Nya dan semua mereka yang diam di sorga."
 },
 {
   "id": 30934,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 7,
   "firman": "Dan ia diperkenankan untuk berperang melawan orang-orang kudus dan untuk mengalahkan mereka; dan kepadanya diberikan kuasa atas setiap suku dan umat dan bahasa dan bangsa."
 },
 {
   "id": 30935,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 8,
   "firman": "Dan semua orang yang diam di atas bumi akan menyembahnya, yaitu setiap orang yang namanya tidak tertulis sejak dunia dijadikan di dalam kitab kehidupan dari Anak Domba, yang telah disembelih."
 },
 {
   "id": 30936,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 9,
   "firman": "Barangsiapa bertelinga, hendaklah ia mendengar!"
 },
 {
   "id": 30937,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 10,
   "firman": "Barangsiapa ditentukan untuk ditawan, ia akan ditawan; barangsiapa ditentukan untuk dibunuh dengan pedang, ia harus dibunuh dengan pedang. Yang penting di sini ialah ketabahan dan iman orang-orang kudus."
 },
 {
   "id": 30938,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 11,
   "firman": "Dan aku melihat seekor binatang lain keluar dari dalam bumi dan bertanduk dua sama seperti anak domba dan ia berbicara seperti seekor naga."
 },
 {
   "id": 30939,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 12,
   "firman": "Dan seluruh kuasa binatang yang pertama itu dijalankannya di depan matanya. Ia menyebabkan seluruh bumi dan semua penghuninya menyembah binatang pertama, yang luka parahnya telah sembuh."
 },
 {
   "id": 30940,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 13,
   "firman": "Dan ia mengadakan tanda-tanda yang dahsyat, bahkan ia menurunkan api dari langit ke bumi di depan mata semua orang."
 },
 {
   "id": 30941,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 14,
   "firman": "Ia menyesatkan mereka yang diam di bumi dengan tanda-tanda, yang telah diberikan kepadanya untuk dilakukannya di depan mata binatang itu. Dan ia menyuruh mereka yang diam di bumi, supaya mereka mendirikan patung untuk menghormati binatang yang luka oleh pedang, namun yang tetap hidup itu."
 },
 {
   "id": 30942,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 15,
   "firman": "Dan kepadanya diberikan kuasa untuk memberikan nyawa kepada patung binatang itu, sehingga patung binatang itu berbicara juga, dan bertindak begitu rupa, sehingga semua orang, yang tidak menyembah patung binatang itu, dibunuh."
 },
 {
   "id": 30943,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 16,
   "firman": "Dan ia menyebabkan, sehingga kepada semua orang, kecil atau besar, kaya atau miskin, merdeka atau hamba, diberi tanda pada tangan kanannya atau pada dahinya,"
 },
 {
   "id": 30944,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 17,
   "firman": "dan tidak seorangpun yang dapat membeli atau menjual selain dari pada mereka yang memakai tanda itu, yaitu nama binatang itu atau bilangan namanya."
 },
 {
   "id": 30945,
   "kitab": "Why",
   "pasal": 13,
   "ayat": 18,
   "firman": "Yang penting di sini ialah hikmat: barangsiapa yang bijaksana, baiklah ia menghitung bilangan binatang itu, karena bilangan itu adalah bilangan seorang manusia, dan bilangannya ialah enam ratus enam puluh enam."
 },
 {
   "id": 30946,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 1,
   "firman": "Dan aku melihat: sesungguhnya, Anak Domba berdiri di bukit Sion dan bersama-sama dengan Dia seratus empat puluh empat ribu orang dan di dahi mereka tertulis nama-Nya dan nama Bapa-Nya."
 },
 {
   "id": 30947,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 2,
   "firman": "Dan aku mendengar suatu suara dari langit bagaikan desau air bah dan bagaikan deru guruh yang dahsyat. Dan suara yang kudengar itu seperti bunyi pemain-pemain kecapi yang memetik kecapinya."
 },
 {
   "id": 30948,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 3,
   "firman": "Mereka menyanyikan suatu nyanyian baru di hadapan takhta dan di depan keempat makhluk dan tua-tua itu, dan tidak seorangpun yang dapat mempelajari nyanyian itu selain dari pada seratus empat puluh empat ribu orang yang telah ditebus dari bumi itu."
 },
 {
   "id": 30949,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 4,
   "firman": "Mereka adalah orang-orang yang tidak mencemarkan dirinya dengan perempuan-perempuan, karena mereka murni sama seperti perawan. Mereka adalah orang-orang yang mengikuti Anak Domba itu ke mana saja Ia pergi. Mereka ditebus dari antara manusia sebagai korban-korban sulung bagi Allah dan bagi Anak Domba itu."
 },
 {
   "id": 30950,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 5,
   "firman": "Dan di dalam mulut mereka tidak terdapat dusta; mereka tidak bercela."
 },
 {
   "id": 30951,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 6,
   "firman": "Dan aku melihat seorang malaikat lain terbang di tengah-tengah langit dan padanya ada Injil yang kekal untuk diberitakannya kepada mereka yang diam di atas bumi dan kepada semua bangsa dan suku dan bahasa dan kaum,"
 },
 {
   "id": 30952,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 7,
   "firman": "dan ia berseru dengan suara nyaring: \"Takutlah akan Allah dan muliakanlah Dia, karena telah tiba saat penghakiman-Nya, dan sembahlah Dia yang telah menjadikan langit dan bumi dan laut dan semua mata air.\""
 },
 {
   "id": 30953,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 8,
   "firman": "Dan seorang malaikat lain, malaikat kedua, menyusul dia dan berkata: \"Sudah rubuh, sudah rubuh Babel, kota besar itu, yang telah memabukkan segala bangsa dengan anggur hawa nafsu cabulnya.\""
 },
 {
   "id": 30954,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 9,
   "firman": "Dan seorang malaikat lain, malaikat ketiga, menyusul mereka, dan berkata dengan suara nyaring: \"Jikalau seorang menyembah binatang dan patungnya itu, dan menerima tanda pada dahinya atau pada tangannya,"
 },
 {
   "id": 30955,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 10,
   "firman": "maka ia akan minum dari anggur murka Allah, yang disediakan tanpa campuran dalam cawan murka-Nya; dan ia akan disiksa dengan api dan belerang di depan mata malaikat-malaikat kudus dan di depan mata Anak Domba."
 },
 {
   "id": 30956,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 11,
   "firman": "Maka asap api yang menyiksa mereka itu naik ke atas sampai selama-lamanya, dan siang malam mereka tidak henti-hentinya disiksa, yaitu mereka yang menyembah binatang serta patungnya itu, dan barangsiapa yang telah menerima tanda namanya.\""
 },
 {
   "id": 30957,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 12,
   "firman": "Yang penting di sini ialah ketekunan orang-orang kudus, yang menuruti perintah Allah dan iman kepada Yesus."
 },
 {
   "id": 30958,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 13,
   "firman": "Dan aku mendengar suara dari sorga berkata: Tuliskan: \"Berbahagialah orang-orang mati yang mati dalam Tuhan, sejak sekarang ini.\" \"Sungguh,\" kata Roh, \"supaya mereka boleh beristirahat dari jerih lelah mereka, karena segala perbuatan mereka menyertai mereka.\""
 },
 {
   "id": 30959,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 14,
   "firman": "Dan aku melihat: sesungguhnya, ada suatu awan putih, dan di atas awan itu duduk seorang seperti Anak Manusia dengan sebuah mahkota emas di atas kepala-Nya dan sebilah sabit tajam di tangan-Nya."
 },
 {
   "id": 30960,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 15,
   "firman": "Maka keluarlah seorang malaikat lain dari Bait Suci; dan ia berseru dengan suara nyaring kepada Dia yang duduk di atas awan itu: \"Ayunkanlah sabit-Mu itu dan tuailah, karena sudah tiba saatnya untuk menuai; sebab tuaian di bumi sudah masak.\""
 },
 {
   "id": 30961,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dan Ia, yang duduk di atas awan itu, mengayunkan sabit-Nya ke atas bumi, dan bumipun dituailah."
 },
 {
   "id": 30962,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 17,
   "firman": "Dan seorang malaikat lain keluar dari Bait Suci yang di sorga; juga padanya ada sebilah sabit tajam."
 },
 {
   "id": 30963,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 18,
   "firman": "Dan seorang malaikat lain datang dari mezbah; ia berkuasa atas api dan ia berseru dengan suara nyaring kepada malaikat yang memegang sabit tajam itu, katanya: \"Ayunkanlah sabitmu yang tajam itu dan potonglah buah-buah pohon anggur di bumi, karena buahnya sudah masak.\""
 },
 {
   "id": 30964,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 19,
   "firman": "Lalu malaikat itu mengayunkan sabitnya ke atas bumi, dan memotong buah pohon anggur di bumi dan melemparkannya ke dalam kilangan besar, yaitu murka Allah."
 },
 {
   "id": 30965,
   "kitab": "Why",
   "pasal": 14,
   "ayat": 20,
   "firman": "Dan buah-buah anggur itu dikilang di luar kota dan dari kilangan itu mengalir darah, tingginya sampai ke kekang kuda dan jauhnya dua ratus mil."
 },
 {
   "id": 30966,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 1,
   "firman": "Dan aku melihat suatu tanda lain di langit, besar dan ajaib: tujuh malaikat dengan tujuh malapetaka terakhir, karena dengan itu berakhirlah murka Allah."
 },
 {
   "id": 30967,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 2,
   "firman": "Dan aku melihat sesuatu bagaikan lautan kaca bercampur api, dan di tepi lautan kaca itu berdiri orang-orang yang telah mengalahkan binatang itu dan patungnya dan bilangan namanya. Pada mereka ada kecapi Allah."
 },
 {
   "id": 30968,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 3,
   "firman": "Dan mereka menyanyikan nyanyian Musa, hamba Allah, dan nyanyian Anak Domba, bunyinya: \"Besar dan ajaib segala pekerjaan-Mu, ya Tuhan, Allah, Yang Mahakuasa! Adil dan benar segala jalan-Mu, ya Raja segala bangsa!"
 },
 {
   "id": 30969,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 4,
   "firman": "Siapakah yang tidak takut, ya Tuhan, dan yang tidak memuliakan nama-Mu? Sebab Engkau saja yang kudus; karena semua bangsa akan datang dan sujud menyembah Engkau, sebab telah nyata kebenaran segala penghakiman-Mu.\""
 },
 {
   "id": 30970,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 5,
   "firman": "Kemudian dari pada itu aku melihat orang membuka Bait Suci--kemah kesaksian--di sorga."
 },
 {
   "id": 30971,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 6,
   "firman": "Dan ketujuh malaikat dengan ketujuh malapetaka itu, keluar dari Bait Suci, berpakaian lenan yang putih bersih dan berkilau-kilauan dan dadanya berlilitkan ikat pinggang dari emas."
 },
 {
   "id": 30972,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 7,
   "firman": "Dan satu dari keempat makhluk itu memberikan kepada ketujuh malaikat itu tujuh cawan dari emas yang penuh berisi murka Allah, yaitu Allah yang hidup sampai selama-lamanya."
 },
 {
   "id": 30973,
   "kitab": "Why",
   "pasal": 15,
   "ayat": 8,
   "firman": "Dan Bait Suci itu dipenuhi asap karena kemuliaan Allah dan karena kuasa-Nya, dan seorangpun tidak dapat memasuki Bait Suci itu, sebelum berakhir ketujuh malapetaka dari ketujuh malaikat itu."
 },
 {
   "id": 30974,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 1,
   "firman": "Dan aku mendengar suara yang nyaring dari dalam Bait Suci berkata kepada ketujuh malaikat itu: \"Pergilah dan tumpahkanlah ketujuh cawan murka Allah itu ke atas bumi.\""
 },
 {
   "id": 30975,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 2,
   "firman": "Maka pergilah malaikat yang pertama dan ia menumpahkan cawannya ke atas bumi; maka timbullah bisul yang jahat dan yang berbahaya pada semua orang yang memakai tanda dari binatang itu dan yang menyembah patungnya."
 },
 {
   "id": 30976,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 3,
   "firman": "Dan malaikat yang kedua menumpahkan cawannya ke atas laut; maka airnya menjadi darah, seperti darah orang mati dan matilah segala yang bernyawa, yang hidup di dalam laut."
 },
 {
   "id": 30977,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 4,
   "firman": "Dan malaikat yang ketiga menumpahkan cawannya atas sungai-sungai dan mata-mata air, dan semuanya menjadi darah."
 },
 {
   "id": 30978,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 5,
   "firman": "Dan aku mendengar malaikat yang berkuasa atas air itu berkata: \"Adil Engkau, Engkau yang ada dan yang sudah ada, Engkau yang kudus, yang telah menjatuhkan hukuman ini."
 },
 {
   "id": 30979,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 6,
   "firman": "Karena mereka telah menumpahkan darah orang-orang kudus dan para nabi, Engkau juga telah memberi mereka minum darah; hal itu wajar bagi mereka!\""
 },
 {
   "id": 30980,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 7,
   "firman": "Dan aku mendengar mezbah itu berkata: \"Ya Tuhan, Allah, Yang Mahakuasa, benar dan adil segala penghakiman-Mu.\""
 },
 {
   "id": 30981,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 8,
   "firman": "Dan malaikat yang keempat menumpahkan cawannya ke atas matahari, dan kepadanya diberi kuasa untuk menghanguskan manusia dengan api."
 },
 {
   "id": 30982,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 9,
   "firman": "Dan manusia dihanguskan oleh panas api yang dahsyat, dan mereka menghujat nama Allah yang berkuasa atas malapetaka-malapetaka itu dan mereka tidak bertobat untuk memuliakan Dia."
 },
 {
   "id": 30983,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 10,
   "firman": "Dan malaikat yang kelima menumpahkan cawannya ke atas takhta binatang itu dan kerajaannya menjadi gelap, dan mereka menggigit lidah mereka karena kesakitan,"
 },
 {
   "id": 30984,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 11,
   "firman": "dan mereka menghujat Allah yang di sorga karena kesakitan dan karena bisul mereka, tetapi mereka tidak bertobat dari perbuatan-perbuatan mereka."
 },
 {
   "id": 30985,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 12,
   "firman": "Dan malaikat yang keenam menumpahkan cawannya ke atas sungai yang besar, sungai Efrat, lalu keringlah airnya, supaya siaplah jalan bagi raja-raja yang datang dari sebelah timur."
 },
 {
   "id": 30986,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 13,
   "firman": "Dan aku melihat dari mulut naga dan dari mulut binatang dan dari mulut nabi palsu itu keluar tiga roh najis yang menyerupai katak."
 },
 {
   "id": 30987,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 14,
   "firman": "Itulah roh-roh setan yang mengadakan perbuatan-perbuatan ajaib, dan mereka pergi mendapatkan raja-raja di seluruh dunia, untuk mengumpulkan mereka guna peperangan pada hari besar, yaitu hari Allah Yang Mahakuasa."
 },
 {
   "id": 30988,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 15,
   "firman": "\"Lihatlah, Aku datang seperti pencuri. Berbahagialah dia, yang berjaga-jaga dan yang memperhatikan pakaiannya, supaya ia jangan berjalan dengan telanjang dan jangan kelihatan kemaluannya.\""
 },
 {
   "id": 30989,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 16,
   "firman": "Lalu ia mengumpulkan mereka di tempat, yang dalam bahasa Ibrani disebut Harmagedon."
 },
 {
   "id": 30990,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 17,
   "firman": "Dan malaikat yang ketujuh menumpahkan cawannya ke angkasa. Dan dari dalam Bait Suci kedengaranlah suara yang nyaring dari takhta itu, katanya: \"Sudah terlaksana.\""
 },
 {
   "id": 30991,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 18,
   "firman": "Maka memancarlah kilat dan menderulah bunyi guruh, dan terjadilah gempa bumi yang dahsyat seperti belum pernah terjadi sejak manusia ada di atas bumi. Begitu hebatnya gempa bumi itu."
 },
 {
   "id": 30992,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 19,
   "firman": "Lalu terbelahlah kota besar itu menjadi tiga bagian dan runtuhlah kota-kota bangsa-bangsa yang tidak mengenal Allah. Maka teringatlah Allah akan Babel yang besar itu untuk memberikan kepadanya cawan yang penuh dengan anggur kegeraman murka-Nya."
 },
 {
   "id": 30993,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 20,
   "firman": "Dan semua pulau hilang lenyap, dan tidak ditemukan lagi gunung-gunung."
 },
 {
   "id": 30994,
   "kitab": "Why",
   "pasal": 16,
   "ayat": 21,
   "firman": "Dan hujan es besar, seberat seratus pon, jatuh dari langit menimpa manusia, dan manusia menghujat Allah karena malapetaka hujan es itu, sebab malapetaka itu sangat dahsyat."
 },
 {
   "id": 30995,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 1,
   "firman": "Lalu datanglah seorang dari ketujuh malaikat, yang membawa ketujuh cawan itu dan berkata kepadaku: \"Mari ke sini, aku akan menunjukkan kepadamu putusan atas pelacur besar, yang duduk di tempat yang banyak airnya."
 },
 {
   "id": 30996,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 2,
   "firman": "Dengan dia raja-raja di bumi telah berbuat cabul, dan penghuni-penghuni bumi telah mabuk oleh anggur percabulannya.\""
 },
 {
   "id": 30997,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 3,
   "firman": "Dalam roh aku dibawanya ke padang gurun. Dan aku melihat seorang perempuan duduk di atas seekor binatang yang merah ungu, yang penuh tertulis dengan nama-nama hujat. Binatang itu mempunyai tujuh kepala dan sepuluh tanduk."
 },
 {
   "id": 30998,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 4,
   "firman": "Dan perempuan itu memakai kain ungu dan kain kirmizi yang dihiasi dengan emas, permata dan mutiara, dan di tangannya ada suatu cawan emas penuh dengan segala kekejian dan kenajisan percabulannya."
 },
 {
   "id": 30999,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 5,
   "firman": "Dan pada dahinya tertulis suatu nama, suatu rahasia: \"Babel besar, ibu dari wanita-wanita pelacur dan dari kekejian bumi.\""
 },
 {
   "id": 31000,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 6,
   "firman": "Dan aku melihat perempuan itu mabuk oleh darah orang-orang kudus dan darah saksi-saksi Yesus. Dan ketika aku melihatnya, aku sangat heran."
 },
 {
   "id": 31001,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 7,
   "firman": "Lalu kata malaikat itu kepadaku: \"Mengapa engkau heran? Aku akan mengatakan kepadamu rahasia perempuan itu dan rahasia binatang yang memikulnya, binatang yang berkepala tujuh dan bertanduk sepuluh itu."
 },
 {
   "id": 31002,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 8,
   "firman": "Adapun binatang yang telah kaulihat itu, telah ada, namun tidak ada, ia akan muncul dari jurang maut, dan ia menuju kepada kebinasaan. Dan mereka yang diam di bumi, yaitu mereka yang tidak tertulis di dalam kitab kehidupan sejak dunia dijadikan, akan heran, apabila mereka melihat, bahwa binatang itu telah ada, namun tidak ada, dan akan muncul lagi."
 },
 {
   "id": 31003,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 9,
   "firman": "Yang penting di sini ialah akal yang mengandung hikmat: ketujuh kepala itu adalah tujuh gunung, yang di atasnya perempuan itu duduk,"
 },
 {
   "id": 31004,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 10,
   "firman": "ketujuhnya adalah juga tujuh raja: lima di antaranya sudah jatuh, yang satu ada dan yang lain belum datang, dan jika ia datang, ia akan tinggal seketika saja."
 },
 {
   "id": 31005,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dan binatang yang pernah ada dan yang sekarang tidak ada itu, ia sendiri adalah raja kedelapan dan namun demikian satu dari ketujuh itu dan ia menuju kepada kebinasaan."
 },
 {
   "id": 31006,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 12,
   "firman": "Dan kesepuluh tanduk yang telah kaulihat itu adalah sepuluh raja, yang belum mulai memerintah, tetapi satu jam lamanya mereka akan menerima kuasa sebagai raja, bersama-sama dengan binatang itu."
 },
 {
   "id": 31007,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 13,
   "firman": "Mereka seia sekata, kekuatan dan kekuasaan mereka mereka berikan kepada binatang itu."
 },
 {
   "id": 31008,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 14,
   "firman": "Mereka akan berperang melawan Anak Domba. Tetapi Anak Domba akan mengalahkan mereka, karena Ia adalah Tuan di atas segala tuan dan Raja di atas segala raja. Mereka bersama-sama dengan Dia juga akan menang, yaitu mereka yang terpanggil, yang telah dipilih dan yang setia.\""
 },
 {
   "id": 31009,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 15,
   "firman": "Lalu ia berkata kepadaku: \"Semua air yang telah kaulihat, di mana wanita pelacur itu duduk, adalah bangsa-bangsa dan rakyat banyak dan kaum dan bahasa."
 },
 {
   "id": 31010,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 16,
   "firman": "Dan kesepuluh tanduk yang telah kaulihat itu serta binatang itu akan membenci pelacur itu dan mereka akan membuat dia menjadi sunyi dan telanjang, dan mereka akan memakan dagingnya dan membakarnya dengan api."
 },
 {
   "id": 31011,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 17,
   "firman": "Sebab Allah telah menerangi hati mereka untuk melakukan kehendak-Nya dengan seia sekata dan untuk memberikan pemerintahan mereka kepada binatang itu, sampai segala firman Allah telah digenapi."
 },
 {
   "id": 31012,
   "kitab": "Why",
   "pasal": 17,
   "ayat": 18,
   "firman": "Dan perempuan yang telah kaulihat itu, adalah kota besar yang memerintah atas raja-raja di bumi.\""
 },
 {
   "id": 31013,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 1,
   "firman": "Kemudian dari pada itu aku melihat seorang malaikat lain turun dari sorga. Ia mempunyai kekuasaan besar dan bumi menjadi terang oleh kemuliaannya."
 },
 {
   "id": 31014,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 2,
   "firman": "Dan ia berseru dengan suara yang kuat, katanya: \"Sudah rubuh, sudah rubuh Babel, kota besar itu, dan ia telah menjadi tempat kediaman roh-roh jahat dan tempat bersembunyi semua roh najis dan tempat bersembunyi segala burung yang najis dan yang dibenci,"
 },
 {
   "id": 31015,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 3,
   "firman": "karena semua bangsa telah minum dari anggur hawa nafsu cabulnya dan raja-raja di bumi telah berbuat cabul dengan dia, dan pedagang-pedagang di bumi telah menjadi kaya oleh kelimpahan hawa nafsunya.\""
 },
 {
   "id": 31016,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 4,
   "firman": "Lalu aku mendengar suara lain dari sorga berkata: \"Pergilah kamu, hai umat-Ku, pergilah dari padanya supaya kamu jangan mengambil bagian dalam dosa-dosanya, dan supaya kamu jangan turut ditimpa malapetaka-malapetakanya."
 },
 {
   "id": 31017,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 5,
   "firman": "Sebab dosa-dosanya telah bertimbun-timbun sampai ke langit, dan Allah telah mengingat segala kejahatannya."
 },
 {
   "id": 31018,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 6,
   "firman": "Balaskanlah kepadanya, sama seperti dia juga membalaskan, dan berikanlah kepadanya dua kali lipat menurut pekerjaannya, campurkanlah baginya dua kali lipat di dalam cawan pencampurannya;"
 },
 {
   "id": 31019,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 7,
   "firman": "berikanlah kepadanya siksaan dan perkabungan, sebanyak kemuliaan dan kemewahan, yang telah ia nikmati. Sebab ia berkata di dalam hatinya: Aku bertakhta seperti ratu, aku bukan janda, dan aku tidak akan pernah berkabung."
 },
 {
   "id": 31020,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 8,
   "firman": "Sebab itu segala malapetakanya akan datang dalam satu hari, yaitu sampar dan perkabungan dan kelaparan; dan ia akan dibakar dengan api, karena Tuhan Allah, yang menghakimi dia, adalah kuat.\""
 },
 {
   "id": 31021,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 9,
   "firman": "Dan raja-raja di bumi, yang telah berbuat cabul dan hidup dalam kelimpahan dengan dia, akan menangisi dan meratapinya, apabila mereka melihat asap api yang membakarnya."
 },
 {
   "id": 31022,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 10,
   "firman": "Mereka akan berdiri jauh-jauh karena takut akan siksaannya dan mereka akan berkata: \"Celaka, celaka engkau, hai kota yang besar, Babel, hai kota yang kuat, sebab dalam satu jam saja sudah berlangsung penghakimanmu!\""
 },
 {
   "id": 31023,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 11,
   "firman": "Dan pedagang-pedagang di bumi menangis dan berkabung karena dia, sebab tidak ada orang lagi yang membeli barang-barang mereka,"
 },
 {
   "id": 31024,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 12,
   "firman": "yaitu barang-barang dagangan dari emas dan perak, permata dan mutiara, dari lenan halus dan kain ungu, dari sutera dan kain kirmizi, pelbagai jenis barang dari kayu yang harum baunya, pelbagai jenis barang dari gading, pelbagai jenis barang dari kayu yang mahal, dari tembaga, besi dan pualam,"
 },
 {
   "id": 31025,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 13,
   "firman": "kulit manis dan rempah-rempah, wangi-wangian, mur dan kemenyan, anggur, minyak, tepung halus dan gandum, lembu sapi, domba, kuda dan kereta, budak dan bahkan nyawa manusia."
 },
 {
   "id": 31026,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 14,
   "firman": "Dan mereka akan berkata: \"Sudah lenyap buah-buahan yang diingini hatimu, dan segala yang mewah dan indah telah hilang dari padamu, dan tidak akan ditemukan lagi.\""
 },
 {
   "id": 31027,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 15,
   "firman": "Mereka yang memperdagangkan barang-barang itu, yang telah menjadi kaya oleh dia, akan berdiri jauh-jauh karena takut akan siksaannya, dan sambil menangis dan meratap,"
 },
 {
   "id": 31028,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 16,
   "firman": "mereka berkata: \"Celaka, celaka, kota besar, yang berpakaian lenan halus, dan kain ungu dan kain kirmizi, dan yang dihiasi dengan emas, dan permata dan mutiara, sebab dalam satu jam saja kekayaan sebanyak itu sudah binasa.\""
 },
 {
   "id": 31029,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 17,
   "firman": "Dan setiap nakhoda dan pelayar dan anak-anak kapal dan semua orang yang mata pencahariannya di laut, berdiri jauh-jauh,"
 },
 {
   "id": 31030,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 18,
   "firman": "dan berseru, ketika mereka melihat asap api yang membakarnya, katanya: \"Kota manakah yang sama dengan kota besar ini?\""
 },
 {
   "id": 31031,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 19,
   "firman": "Dan mereka menghamburkan debu ke atas kepala mereka dan berseru, sambil menangis dan meratap, katanya: \"Celaka, celaka, kota besar, yang olehnya semua orang, yang mempunyai kapal di laut, telah menjadi kaya oleh barangnya yang mahal, sebab dalam satu jam saja ia sudah binasa."
 },
 {
   "id": 31032,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 20,
   "firman": "Bersukacitalah atas dia, hai sorga, dan kamu, hai orang-orang kudus, rasul-rasul dan nabi-nabi, karena Allah telah menjatuhkan hukuman atas dia karena kamu.\""
 },
 {
   "id": 31033,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 21,
   "firman": "Dan seorang malaikat yang kuat, mengangkat sebuah batu sebesar batu kilangan, lalu melemparkannya ke dalam laut, katanya: \"Demikianlah Babel, kota besar itu, akan dilemparkan dengan keras ke bawah, dan ia tidak akan ditemukan lagi."
 },
 {
   "id": 31034,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 22,
   "firman": "Dan suara pemain-pemain kecapi dan penyanyi-penyanyi, dan peniup-peniup seruling dan sangkakala, tidak akan kedengaran lagi di dalammu, dan seorang yang ahli dalam sesuatu kesenian tidak akan ditemukan lagi di dalammu, dan suara kilangan tidak akan kedengaran lagi di dalammu."
 },
 {
   "id": 31035,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 23,
   "firman": "Dan cahaya lampu tidak akan bersinar lagi di dalammu, dan suara mempelai laki-laki dan pengantin perempuan tidak akan kedengaran lagi di dalammu. Karena pedagang-pedagangmu adalah pembesar-pembesar di bumi, oleh ilmu sihirmu semua bangsa disesatkan.\""
 },
 {
   "id": 31036,
   "kitab": "Why",
   "pasal": 18,
   "ayat": 24,
   "firman": "Dan di dalamnya terdapat darah nabi-nabi dan orang-orang kudus dan darah semua orang, yang dibunuh di bumi."
 },
 {
   "id": 31037,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 1,
   "firman": "Kemudian dari pada itu aku mendengar seperti suara yang nyaring dari himpunan besar orang banyak di sorga, katanya: \"Haleluya! Keselamatan dan kemuliaan dan kekuasaan adalah pada Allah kita,"
 },
 {
   "id": 31038,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 2,
   "firman": "sebab benar dan adil segala penghakiman-Nya, karena Ialah yang telah menghakimi pelacur besar itu, yang merusakkan bumi dengan percabulannya; dan Ialah yang telah membalaskan darah hamba-hamba-Nya atas pelacur itu.\""
 },
 {
   "id": 31039,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 3,
   "firman": "Dan untuk kedua kalinya mereka berkata: \"Haleluya! Ya, asapnya naik sampai selama-lamanya.\""
 },
 {
   "id": 31040,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 4,
   "firman": "Dan kedua puluh empat tua-tua dan keempat makhluk itu tersungkur dan menyembah Allah yang duduk di atas takhta itu, dan mereka berkata: \"Amin, Haleluya.\""
 },
 {
   "id": 31041,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 5,
   "firman": "Maka kedengaranlah suatu suara dari takhta itu: \"Pujilah Allah kita, hai kamu semua hamba-Nya, kamu yang takut akan Dia, baik kecil maupun besar!\""
 },
 {
   "id": 31042,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 6,
   "firman": "Lalu aku mendengar seperti suara himpunan besar orang banyak, seperti desau air bah dan seperti deru guruh yang hebat, katanya: \"Haleluya! Karena Tuhan, Allah kita, Yang Mahakuasa, telah menjadi raja."
 },
 {
   "id": 31043,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 7,
   "firman": "Marilah kita bersukacita dan bersorak-sorai, dan memuliakan Dia! Karena hari perkawinan Anak Domba telah tiba, dan pengantin-Nya telah siap sedia."
 },
 {
   "id": 31044,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 8,
   "firman": "Dan kepadanya dikaruniakan supaya memakai kain lenan halus yang berkilau-kilauan dan yang putih bersih!\" (Lenan halus itu adalah perbuatan-perbuatan yang benar dari orang-orang kudus.)"
 },
 {
   "id": 31045,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 9,
   "firman": "Lalu ia berkata kepadaku: \"Tuliskanlah: Berbahagialah mereka yang diundang ke perjamuan kawin Anak Domba.\" Katanya lagi kepadaku: \"Perkataan ini adalah benar, perkataan-perkataan dari Allah.\""
 },
 {
   "id": 31046,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 10,
   "firman": "Maka tersungkurlah aku di depan kakinya untuk menyembah dia, tetapi ia berkata kepadaku: \"Janganlah berbuat demikian! Aku adalah hamba, sama dengan engkau dan saudara-saudaramu, yang memiliki kesaksian Yesus. Sembahlah Allah! Karena kesaksian Yesus adalah roh nubuat.\""
 },
 {
   "id": 31047,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 11,
   "firman": "Lalu aku melihat sorga terbuka: sesungguhnya, ada seekor kuda putih; dan Ia yang menungganginya bernama: \"Yang Setia dan Yang Benar\", Ia menghakimi dan berperang dengan adil."
 },
 {
   "id": 31048,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 12,
   "firman": "Dan mata-Nya bagaikan nyala api dan di atas kepala-Nya terdapat banyak mahkota dan pada-Nya ada tertulis suatu nama yang tidak diketahui seorangpun, kecuali Ia sendiri."
 },
 {
   "id": 31049,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 13,
   "firman": "Dan Ia memakai jubah yang telah dicelup dalam darah dan nama-Nya ialah: \"Firman Allah.\""
 },
 {
   "id": 31050,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 14,
   "firman": "Dan semua pasukan yang di sorga mengikuti Dia; mereka menunggang kuda putih dan memakai lenan halus yang putih bersih."
 },
 {
   "id": 31051,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 15,
   "firman": "Dan dari mulut-Nya keluarlah sebilah pedang tajam yang akan memukul segala bangsa. Dan Ia akan menggembalakan mereka dengan gada besi dan Ia akan memeras anggur dalam kilangan anggur, yaitu kegeraman murka Allah, Yang Mahakuasa."
 },
 {
   "id": 31052,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 16,
   "firman": "Dan pada jubah-Nya dan paha-Nya tertulis suatu nama, yaitu: \"Raja segala raja dan Tuan di atas segala tuan.\""
 },
 {
   "id": 31053,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 17,
   "firman": "Lalu aku melihat seorang malaikat berdiri di dalam matahari dan ia berseru dengan suara nyaring kepada semua burung yang terbang di tengah langit, katanya: \"Marilah ke sini dan berkumpullah untuk turut dalam perjamuan Allah, perjamuan yang besar,"
 },
 {
   "id": 31054,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 18,
   "firman": "supaya kamu makan daging semua raja dan daging semua panglima dan daging semua pahlawan dan daging semua kuda dan daging semua penunggangnya dan daging semua orang, baik yang merdeka maupun hamba, baik yang kecil maupun yang besar.\""
 },
 {
   "id": 31055,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 19,
   "firman": "Dan aku melihat binatang itu dan raja-raja di bumi serta tentara-tentara mereka telah berkumpul untuk melakukan peperangan melawan Penunggang kuda itu dan tentara-Nya."
 },
 {
   "id": 31056,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 20,
   "firman": "Maka tertangkaplah binatang itu dan bersama-sama dengan dia nabi palsu, yang telah mengadakan tanda-tanda di depan matanya, dan dengan demikian ia menyesatkan mereka yang telah menerima tanda dari binatang itu dan yang telah menyembah patungnya. Keduanya dilemparkan hidup-hidup ke dalam lautan api yang menyala-nyala oleh belerang."
 },
 {
   "id": 31057,
   "kitab": "Why",
   "pasal": 19,
   "ayat": 21,
   "firman": "Dan semua orang lain dibunuh dengan pedang, yang keluar dari mulut Penunggang kuda itu; dan semua burung kenyang oleh daging mereka."
 },
 {
   "id": 31058,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 1,
   "firman": "Lalu aku melihat seorang malaikat turun dari sorga memegang anak kunci jurang maut dan suatu rantai besar di tangannya;"
 },
 {
   "id": 31059,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 2,
   "firman": "ia menangkap naga, si ular tua itu, yaitu Iblis dan Satan. Dan ia mengikatnya seribu tahun lamanya,"
 },
 {
   "id": 31060,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 3,
   "firman": "lalu melemparkannya ke dalam jurang maut, dan menutup jurang maut itu dan memeteraikannya di atasnya, supaya ia jangan lagi menyesatkan bangsa-bangsa, sebelum berakhir masa seribu tahun itu; kemudian dari pada itu ia akan dilepaskan untuk sedikit waktu lamanya."
 },
 {
   "id": 31061,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 4,
   "firman": "Lalu aku melihat takhta-takhta dan orang-orang yang duduk di atasnya; kepada mereka diserahkan kuasa untuk menghakimi. Aku juga melihat jiwa-jiwa mereka, yang telah dipenggal kepalanya karena kesaksian tentang Yesus dan karena firman Allah; yang tidak menyembah binatang itu dan patungnya dan yang tidak juga menerima tandanya pada dahi dan tangan mereka; dan mereka hidup kembali dan memerintah sebagai raja bersama-sama dengan Kristus untuk masa seribu tahun."
 },
 {
   "id": 31062,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 5,
   "firman": "Tetapi orang-orang mati yang lain tidak bangkit sebelum berakhir masa yang seribu tahun itu. Inilah kebangkitan pertama."
 },
 {
   "id": 31063,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 6,
   "firman": "Berbahagia dan kuduslah ia, yang mendapat bagian dalam kebangkitan pertama itu. Kematian yang kedua tidak berkuasa lagi atas mereka, tetapi mereka akan menjadi imam-imam Allah dan Kristus, dan mereka akan memerintah sebagai raja bersama-sama dengan Dia, seribu tahun lamanya."
 },
 {
   "id": 31064,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 7,
   "firman": "Dan setelah masa seribu tahun itu berakhir, Iblis akan dilepaskan dari penjaranya,"
 },
 {
   "id": 31065,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 8,
   "firman": "dan ia akan pergi menyesatkan bangsa-bangsa pada keempat penjuru bumi, yaitu Gog dan Magog, dan mengumpulkan mereka untuk berperang dan jumlah mereka sama dengan banyaknya pasir di laut."
 },
 {
   "id": 31066,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 9,
   "firman": "Maka naiklah mereka ke seluruh dataran bumi, lalu mengepung perkemahan tentara orang-orang kudus dan kota yang dikasihi itu. Tetapi dari langit turunlah api menghanguskan mereka,"
 },
 {
   "id": 31067,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 10,
   "firman": "dan Iblis, yang menyesatkan mereka, dilemparkan ke dalam lautan api dan belerang, yaitu tempat binatang dan nabi palsu itu, dan mereka disiksa siang malam sampai selama-lamanya."
 },
 {
   "id": 31068,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 11,
   "firman": "Lalu aku melihat suatu takhta putih yang besar dan Dia, yang duduk di atasnya. Dari hadapan-Nya lenyaplah bumi dan langit dan tidak ditemukan lagi tempatnya."
 },
 {
   "id": 31069,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 12,
   "firman": "Dan aku melihat orang-orang mati, besar dan kecil, berdiri di depan takhta itu. Lalu dibuka semua kitab. Dan dibuka juga sebuah kitab lain, yaitu kitab kehidupan. Dan orang-orang mati dihakimi menurut perbuatan mereka, berdasarkan apa yang ada tertulis di dalam kitab-kitab itu."
 },
 {
   "id": 31070,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 13,
   "firman": "Maka laut menyerahkan orang-orang mati yang ada di dalamnya, dan maut dan kerajaan maut menyerahkan orang-orang mati yang ada di dalamnya, dan mereka dihakimi masing-masing menurut perbuatannya."
 },
 {
   "id": 31071,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 14,
   "firman": "Lalu maut dan kerajaan maut itu dilemparkanlah ke dalam lautan api. Itulah kematian yang kedua: lautan api."
 },
 {
   "id": 31072,
   "kitab": "Why",
   "pasal": 20,
   "ayat": 15,
   "firman": "Dan setiap orang yang tidak ditemukan namanya tertulis di dalam kitab kehidupan itu, ia dilemparkan ke dalam lautan api itu."
 },
 {
   "id": 31073,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 1,
   "firman": "Lalu aku melihat langit yang baru dan bumi yang baru, sebab langit yang pertama dan bumi yang pertama telah berlalu, dan lautpun tidak ada lagi."
 },
 {
   "id": 31074,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 2,
   "firman": "Dan aku melihat kota yang kudus, Yerusalem yang baru, turun dari sorga, dari Allah, yang berhias bagaikan pengantin perempuan yang berdandan untuk suaminya."
 },
 {
   "id": 31075,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 3,
   "firman": "Lalu aku mendengar suara yang nyaring dari takhta itu berkata: \"Lihatlah, kemah Allah ada di tengah-tengah manusia dan Ia akan diam bersama-sama dengan mereka. Mereka akan menjadi umat-Nya dan Ia akan menjadi Allah mereka."
 },
 {
   "id": 31076,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 4,
   "firman": "Dan Ia akan menghapus segala air mata dari mata mereka, dan maut tidak akan ada lagi; tidak akan ada lagi perkabungan, atau ratap tangis, atau dukacita, sebab segala sesuatu yang lama itu telah berlalu.\""
 },
 {
   "id": 31077,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 5,
   "firman": "Ia yang duduk di atas takhta itu berkata: \"Lihatlah, Aku menjadikan segala sesuatu baru!\" Dan firman-Nya: \"Tuliskanlah, karena segala perkataan ini adalah tepat dan benar.\""
 },
 {
   "id": 31078,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 6,
   "firman": "Firman-Nya lagi kepadaku: \"Semuanya telah terjadi. Aku adalah Alfa dan Omega, Yang Awal dan Yang Akhir. Orang yang haus akan Kuberi minum dengan cuma-cuma dari mata air kehidupan."
 },
 {
   "id": 31079,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 7,
   "firman": "Barangsiapa menang, ia akan memperoleh semuanya ini, dan Aku akan menjadi Allahnya dan ia akan menjadi anak-Ku."
 },
 {
   "id": 31080,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 8,
   "firman": "Tetapi orang-orang penakut, orang-orang yang tidak percaya, orang-orang keji, orang-orang pembunuh, orang-orang sundal, tukang-tukang sihir, penyembah-penyembah berhala dan semua pendusta, mereka akan mendapat bagian mereka di dalam lautan yang menyala-nyala oleh api dan belerang; inilah kematian yang kedua.\""
 },
 {
   "id": 31081,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 9,
   "firman": "Maka datanglah seorang dari ketujuh malaikat yang memegang ketujuh cawan, yang penuh dengan ketujuh malapetaka terakhir itu, lalu ia berkata kepadaku, katanya: \"Marilah ke sini, aku akan menunjukkan kepadamu pengantin perempuan, mempelai Anak Domba.\""
 },
 {
   "id": 31082,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 10,
   "firman": "Lalu, di dalam roh ia membawa aku ke atas sebuah gunung yang besar lagi tinggi dan ia menunjukkan kepadaku kota yang kudus itu, Yerusalem, turun dari sorga, dari Allah."
 },
 {
   "id": 31083,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 11,
   "firman": "Kota itu penuh dengan kemuliaan Allah dan cahayanya sama seperti permata yang paling indah, bagaikan permata yaspis, jernih seperti kristal."
 },
 {
   "id": 31084,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 12,
   "firman": "Dan temboknya besar lagi tinggi dan pintu gerbangnya dua belas buah; dan di atas pintu-pintu gerbang itu ada dua belas malaikat dan di atasnya tertulis nama kedua belas suku Israel."
 },
 {
   "id": 31085,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 13,
   "firman": "Di sebelah timur terdapat tiga pintu gerbang dan di sebelah utara tiga pintu gerbang dan di sebelah selatan tiga pintu gerbang dan di sebelah barat tiga pintu gerbang."
 },
 {
   "id": 31086,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 14,
   "firman": "Dan tembok kota itu mempunyai dua belas batu dasar dan di atasnya tertulis kedua belas nama kedua belas rasul Anak Domba itu."
 },
 {
   "id": 31087,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 15,
   "firman": "Dan ia, yang berkata-kata dengan aku, mempunyai suatu tongkat pengukur dari emas untuk mengukur kota itu serta pintu-pintu gerbangnya dan temboknya."
 },
 {
   "id": 31088,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 16,
   "firman": "Kota itu bentuknya empat persegi, panjangnya sama dengan lebarnya. Dan ia mengukur kota itu dengan tongkat itu: dua belas ribu stadia; panjangnya dan lebarnya dan tingginya sama."
 },
 {
   "id": 31089,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 17,
   "firman": "Lalu ia mengukur temboknya: seratus empat puluh empat hasta, menurut ukuran manusia, yang adalah juga ukuran malaikat."
 },
 {
   "id": 31090,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 18,
   "firman": "Tembok itu terbuat dari permata yaspis; dan kota itu sendiri dari emas tulen, bagaikan kaca murni."
 },
 {
   "id": 31091,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 19,
   "firman": "Dan dasar-dasar tembok kota itu dihiasi dengan segala jenis permata. Dasar yang pertama batu yaspis, dasar yang kedua batu nilam, dasar yang ketiga batu mirah, dasar yang keempat batu zamrud,"
 },
 {
   "id": 31092,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 20,
   "firman": "dasar yang kelima batu unam, dasar yang keenam batu sardis, dasar yang ketujuh batu ratna cempaka, yang kedelapan batu beril, yang kesembilan batu krisolit, yang kesepuluh batu krisopras, yang kesebelas batu lazuardi dan yang kedua belas batu kecubung."
 },
 {
   "id": 31093,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 21,
   "firman": "Dan kedua belas pintu gerbang itu adalah dua belas mutiara: setiap pintu gerbang terdiri dari satu mutiara dan jalan-jalan kota itu dari emas murni bagaikan kaca bening."
 },
 {
   "id": 31094,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 22,
   "firman": "Dan aku tidak melihat Bait Suci di dalamnya; sebab Allah, Tuhan Yang Mahakuasa, adalah Bait Sucinya, demikian juga Anak Domba itu."
 },
 {
   "id": 31095,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 23,
   "firman": "Dan kota itu tidak memerlukan matahari dan bulan untuk menyinarinya, sebab kemuliaan Allah meneranginya dan Anak Domba itu adalah lampunya."
 },
 {
   "id": 31096,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 24,
   "firman": "Dan bangsa-bangsa akan berjalan di dalam cahayanya dan raja-raja di bumi membawa kekayaan mereka kepadanya;"
 },
 {
   "id": 31097,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 25,
   "firman": "dan pintu-pintu gerbangnya tidak akan ditutup pada siang hari, sebab malam tidak akan ada lagi di sana;"
 },
 {
   "id": 31098,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 26,
   "firman": "dan kekayaan dan hormat bangsa-bangsa akan dibawa kepadanya."
 },
 {
   "id": 31099,
   "kitab": "Why",
   "pasal": 21,
   "ayat": 27,
   "firman": "Tetapi tidak akan masuk ke dalamnya sesuatu yang najis, atau orang yang melakukan kekejian atau dusta, tetapi hanya mereka yang namanya tertulis di dalam kitab kehidupan Anak Domba itu."
 },
 {
   "id": 31100,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 1,
   "firman": "Lalu ia menunjukkan kepadaku sungai air kehidupan, yang jernih bagaikan kristal, dan mengalir ke luar dari takhta Allah dan takhta Anak Domba itu."
 },
 {
   "id": 31101,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 2,
   "firman": "Di tengah-tengah jalan kota itu, yaitu di seberang-menyeberang sungai itu, ada pohon-pohon kehidupan yang berbuah dua belas kali, tiap-tiap bulan sekali; dan daun pohon-pohon itu dipakai untuk menyembuhkan bangsa-bangsa."
 },
 {
   "id": 31102,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 3,
   "firman": "Maka tidak akan ada lagi laknat. Takhta Allah dan takhta Anak Domba akan ada di dalamnya dan hamba-hamba-Nya akan beribadah kepada-Nya,"
 },
 {
   "id": 31103,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 4,
   "firman": "dan mereka akan melihat wajah-Nya, dan nama-Nya akan tertulis di dahi mereka."
 },
 {
   "id": 31104,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 5,
   "firman": "Dan malam tidak akan ada lagi di sana, dan mereka tidak memerlukan cahaya lampu dan cahaya matahari, sebab Tuhan Allah akan menerangi mereka, dan mereka akan memerintah sebagai raja sampai selama-lamanya."
 },
 {
   "id": 31105,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 6,
   "firman": "Lalu Ia berkata kepadaku: \"Perkataan-perkataan ini tepat dan benar, dan Tuhan, Allah yang memberi roh kepada para nabi, telah mengutus malaikat-Nya untuk menunjukkan kepada hamba-hamba-Nya apa yang harus segera terjadi.\""
 },
 {
   "id": 31106,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 7,
   "firman": "\"Sesungguhnya Aku datang segera. Berbahagialah orang yang menuruti perkataan-perkataan nubuat kitab ini!\""
 },
 {
   "id": 31107,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 8,
   "firman": "Dan aku, Yohanes, akulah yang telah mendengar dan melihat semuanya itu. Dan setelah aku mendengar dan melihatnya, aku tersungkur di depan kaki malaikat, yang telah menunjukkan semuanya itu kepadaku, untuk menyembahnya."
 },
 {
   "id": 31108,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 9,
   "firman": "Tetapi ia berkata kepadaku: \"Jangan berbuat demikian! Aku adalah hamba, sama seperti engkau dan saudara-saudaramu, para nabi dan semua mereka yang menuruti segala perkataan kitab ini. Sembahlah Allah!\""
 },
 {
   "id": 31109,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 10,
   "firman": "Lalu ia berkata kepadaku: \"Jangan memeteraikan perkataan-perkataan nubuat dari kitab ini, sebab waktunya sudah dekat."
 },
 {
   "id": 31110,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 11,
   "firman": "Barangsiapa yang berbuat jahat, biarlah ia terus berbuat jahat; barangsiapa yang cemar, biarlah ia terus cemar; dan barangsiapa yang benar, biarlah ia terus berbuat kebenaran; barangsiapa yang kudus, biarlah ia terus menguduskan dirinya!\""
 },
 {
   "id": 31111,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 12,
   "firman": "\"Sesungguhnya Aku datang segera dan Aku membawa upah-Ku untuk membalaskan kepada setiap orang menurut perbuatannya."
 },
 {
   "id": 31112,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 13,
   "firman": "Aku adalah Alfa dan Omega, Yang Pertama dan Yang Terkemudian, Yang Awal dan Yang Akhir.\""
 },
 {
   "id": 31113,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 14,
   "firman": "Berbahagialah mereka yang membasuh jubahnya. Mereka akan memperoleh hak atas pohon-pohon kehidupan dan masuk melalui pintu-pintu gerbang ke dalam kota itu."
 },
 {
   "id": 31114,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 15,
   "firman": "Tetapi anjing-anjing dan tukang-tukang sihir, orang-orang sundal, orang-orang pembunuh, penyembah-penyembah berhala dan setiap orang yang mencintai dusta dan yang melakukannya, tinggal di luar."
 },
 {
   "id": 31115,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 16,
   "firman": "\"Aku, Yesus, telah mengutus malaikat-Ku untuk memberi kesaksian tentang semuanya ini kepadamu bagi jemaat-jemaat. Aku adalah tunas, yaitu keturunan Daud, bintang timur yang gilang-gemilang.\""
 },
 {
   "id": 31116,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 17,
   "firman": "Roh dan pengantin perempuan itu berkata: \"Marilah!\" Dan barangsiapa yang mendengarnya, hendaklah ia berkata: \"Marilah!\" Dan barangsiapa yang haus, hendaklah ia datang, dan barangsiapa yang mau, hendaklah ia mengambil air kehidupan dengan cuma-cuma!"
 },
 {
   "id": 31117,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 18,
   "firman": "Aku bersaksi kepada setiap orang yang mendengar perkataan-perkataan nubuat dari kitab ini: \"Jika seorang menambahkan sesuatu kepada perkataan-perkataan ini, maka Allah akan menambahkan kepadanya malapetaka-malapetaka yang tertulis di dalam kitab ini."
 },
 {
   "id": 31118,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 19,
   "firman": "Dan jikalau seorang mengurangkan sesuatu dari perkataan-perkataan dari kitab nubuat ini, maka Allah akan mengambil bagiannya dari pohon kehidupan dan dari kota kudus, seperti yang tertulis di dalam kitab ini.\""
 },
 {
   "id": 31119,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 20,
   "firman": "Ia yang memberi kesaksian tentang semuanya ini, berfirman: \"Ya, Aku datang segera!\" Amin, datanglah, Tuhan Yesus!"
 },
 {
   "id": 31120,
   "kitab": "Why",
   "pasal": 22,
   "ayat": 21,
   "firman": "Kasih karunia Tuhan Yesus menyertai kamu sekalian! Amin."
 }
]