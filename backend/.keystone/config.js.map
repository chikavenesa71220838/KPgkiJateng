[
 {
   "id": 1,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 1,
   "firman": "Pada mulanya Allah menciptakan langit dan bumi."
 },
 {
   "id": 2,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 2,
   "firman": "Bumi belum berbentuk dan kosong; gelap gulita menutupi samudera raya, dan Roh Allah melayang-layang di atas permukaan air."
 },
 {
   "id": 3,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 3,
   "firman": "Berfirmanlah Allah: \"Jadilah terang.\" Lalu terang itu jadi."
 },
 {
   "id": 4,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 4,
   "firman": "Allah melihat bahwa terang itu baik, lalu dipisahkan-Nyalah terang itu dari gelap."
 },
 {
   "id": 5,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan Allah menamai terang itu siang, dan gelap itu malam. Jadilah petang dan jadilah pagi, itulah hari pertama."
 },
 {
   "id": 6,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 6,
   "firman": "Berfirmanlah Allah: \"Jadilah cakrawala di tengah segala air untuk memisahkan air dari air.\""
 },
 {
   "id": 7,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 7,
   "firman": "Maka Allah menjadikan cakrawala dan Ia memisahkan air yang ada di bawah cakrawala itu dari air yang ada di atasnya. Dan jadilah demikian."
 },
 {
   "id": 8,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 8,
   "firman": "Lalu Allah menamai cakrawala itu langit. Jadilah petang dan jadilah pagi, itulah hari kedua."
 },
 {
   "id": 9,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 9,
   "firman": "Berfirmanlah Allah: \"Hendaklah segala air yang di bawah langit berkumpul pada satu tempat, sehingga kelihatan yang kering.\" Dan jadilah demikian."
 },
 {
   "id": 10,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 10,
   "firman": "Lalu Allah menamai yang kering itu darat, dan kumpulan air itu dinamai-Nya laut. Allah melihat bahwa semuanya itu baik."
 },
 {
   "id": 11,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 11,
   "firman": "Berfirmanlah Allah: \"Hendaklah tanah menumbuhkan tunas-tunas muda, tumbuh-tumbuhan yang berbiji, segala jenis pohon buah-buahan yang menghasilkan buah yang berbiji, supaya ada tumbuh-tumbuhan di bumi.\" Dan jadilah demikian."
 },
 {
   "id": 12,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tanah itu menumbuhkan tunas-tunas muda, segala jenis tumbuh-tumbuhan yang berbiji dan segala jenis pohon-pohonan yang menghasilkan buah yang berbiji. Allah melihat bahwa semuanya itu baik."
 },
 {
   "id": 13,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 13,
   "firman": "Jadilah petang dan jadilah pagi, itulah hari ketiga."
 },
 {
   "id": 14,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 14,
   "firman": "Berfirmanlah Allah: \"Jadilah benda-benda penerang pada cakrawala untuk memisahkan siang dari malam. Biarlah benda-benda penerang itu menjadi tanda yang menunjukkan masa-masa yang tetap dan hari-hari dan tahun-tahun,"
 },
 {
   "id": 15,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 15,
   "firman": "dan sebagai penerang pada cakrawala biarlah benda-benda itu menerangi bumi.\" Dan jadilah demikian."
 },
 {
   "id": 16,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 16,
   "firman": "Maka Allah menjadikan kedua benda penerang yang besar itu, yakni yang lebih besar untuk menguasai siang dan yang lebih kecil untuk menguasai malam, dan menjadikan juga bintang-bintang."
 },
 {
   "id": 17,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 17,
   "firman": "Allah menaruh semuanya itu di cakrawala untuk menerangi bumi,"
 },
 {
   "id": 18,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 18,
   "firman": "dan untuk menguasai siang dan malam, dan untuk memisahkan terang dari gelap. Allah melihat bahwa semuanya itu baik."
 },
 {
   "id": 19,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 19,
   "firman": "Jadilah petang dan jadilah pagi, itulah hari keempat."
 },
 {
   "id": 20,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 20,
   "firman": "Berfirmanlah Allah: \"Hendaklah dalam air berkeriapan makhluk yang hidup, dan hendaklah burung beterbangan di atas bumi melintasi cakrawala.\""
 },
 {
   "id": 21,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 21,
   "firman": "Maka Allah menciptakan binatang-binatang laut yang besar dan segala jenis makhluk hidup yang bergerak, yang berkeriapan dalam air, dan segala jenis burung yang bersayap. Allah melihat bahwa semuanya itu baik."
 },
 {
   "id": 22,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 22,
   "firman": "Lalu Allah memberkati semuanya itu, firman-Nya: \"Berkembangbiaklah dan bertambah banyaklah serta penuhilah air dalam laut, dan hendaklah burung-burung di bumi bertambah banyak.\""
 },
 {
   "id": 23,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 23,
   "firman": "Jadilah petang dan jadilah pagi, itulah hari kelima."
 },
 {
   "id": 24,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 24,
   "firman": "Berfirmanlah Allah: \"Hendaklah bumi mengeluarkan segala jenis makhluk yang hidup, ternak dan binatang melata dan segala jenis binatang liar.\" Dan jadilah demikian."
 },
 {
   "id": 25,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 25,
   "firman": "Allah menjadikan segala jenis binatang liar dan segala jenis ternak dan segala jenis binatang melata di muka bumi. Allah melihat bahwa semuanya itu baik."
 },
 {
   "id": 26,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 26,
   "firman": "Berfirmanlah Allah: \"Baiklah Kita menjadikan manusia menurut gambar dan rupa Kita, supaya mereka berkuasa atas ikan-ikan di laut dan burung-burung di udara dan atas ternak dan atas seluruh bumi dan atas segala binatang melata yang merayap di bumi.\""
 },
 {
   "id": 27,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 27,
   "firman": "Maka Allah menciptakan manusia itu menurut gambar-Nya, menurut gambar Allah diciptakan-Nya dia; laki-laki dan perempuan diciptakan-Nya mereka."
 },
 {
   "id": 28,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 28,
   "firman": "Allah memberkati mereka, lalu Allah berfirman kepada mereka: \"Beranakcuculah dan bertambah banyak; penuhilah bumi dan taklukkanlah itu, berkuasalah atas ikan-ikan di laut dan burung-burung di udara dan atas segala binatang yang merayap di bumi.\""
 },
 {
   "id": 29,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 29,
   "firman": "Berfirmanlah Allah: \"Lihatlah, Aku memberikan kepadamu segala tumbuh-tumbuhan yang berbiji di seluruh bumi dan segala pohon-pohonan yang buahnya berbiji; itulah akan menjadi makananmu."
 },
 {
   "id": 30,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 30,
   "firman": "Tetapi kepada segala binatang di bumi dan segala burung di udara dan segala yang merayap di bumi, yang bernyawa, Kuberikan segala tumbuh-tumbuhan hijau menjadi makanannya.\" Dan jadilah demikian."
 },
 {
   "id": 31,
   "kitab": "Kej",
   "pasal": 1,
   "ayat": 31,
   "firman": "Maka Allah melihat segala yang dijadikan-Nya itu, sungguh amat baik. Jadilah petang dan jadilah pagi, itulah hari keenam."
 },
 {
   "id": 32,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 1,
   "firman": "Demikianlah diselesaikan langit dan bumi dan segala isinya."
 },
 {
   "id": 33,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 2,
   "firman": "Ketika Allah pada hari ketujuh telah menyelesaikan pekerjaan yang dibuat-Nya itu, berhentilah Ia pada hari ketujuh dari segala pekerjaan yang telah dibuat-Nya itu."
 },
 {
   "id": 34,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 3,
   "firman": "Lalu Allah memberkati hari ketujuh itu dan menguduskannya, karena pada hari itulah Ia berhenti dari segala pekerjaan penciptaan yang telah dibuat-Nya itu."
 },
 {
   "id": 35,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 4,
   "firman": "Demikianlah riwayat langit dan bumi pada waktu diciptakan. Ketika TUHAN Allah menjadikan bumi dan langit, --"
 },
 {
   "id": 36,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 5,
   "firman": "belum ada semak apapun di bumi, belum timbul tumbuh-tumbuhan apapun di padang, sebab TUHAN Allah belum menurunkan hujan ke bumi, dan belum ada orang untuk mengusahakan tanah itu;"
 },
 {
   "id": 37,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 6,
   "firman": "tetapi ada kabut naik ke atas dari bumi dan membasahi seluruh permukaan bumi itu--"
 },
 {
   "id": 38,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 7,
   "firman": "ketika itulah TUHAN Allah membentuk manusia itu dari debu tanah dan menghembuskan nafas hidup ke dalam hidungnya; demikianlah manusia itu menjadi makhluk yang hidup."
 },
 {
   "id": 39,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 8,
   "firman": "Selanjutnya TUHAN Allah membuat taman di Eden, di sebelah timur; disitulah ditempatkan-Nya manusia yang dibentuk-Nya itu."
 },
 {
   "id": 40,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 9,
   "firman": "Lalu TUHAN Allah menumbuhkan berbagai-bagai pohon dari bumi, yang menarik dan yang baik untuk dimakan buahnya; dan pohon kehidupan di tengah-tengah taman itu, serta pohon pengetahuan tentang yang baik dan yang jahat."
 },
 {
   "id": 41,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ada suatu sungai mengalir dari Eden untuk membasahi taman itu, dan dari situ sungai itu terbagi menjadi empat cabang."
 },
 {
   "id": 42,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 11,
   "firman": "Yang pertama, namanya Pison, yakni yang mengalir mengelilingi seluruh tanah Hawila, tempat emas ada."
 },
 {
   "id": 43,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 12,
   "firman": "Dan emas dari negeri itu baik; di sana ada damar bedolah dan batu krisopras."
 },
 {
   "id": 44,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 13,
   "firman": "Nama sungai yang kedua ialah Gihon, yakni yang mengalir mengelilingi seluruh tanah Kush."
 },
 {
   "id": 45,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 14,
   "firman": "Nama sungai yang ketiga ialah Tigris, yakni yang mengalir di sebelah timur Asyur. Dan sungai yang keempat ialah Efrat."
 },
 {
   "id": 46,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 15,
   "firman": "TUHAN Allah mengambil manusia itu dan menempatkannya dalam taman Eden untuk mengusahakan dan memelihara taman itu."
 },
 {
   "id": 47,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 16,
   "firman": "Lalu TUHAN Allah memberi perintah ini kepada manusia: \"Semua pohon dalam taman ini boleh kaumakan buahnya dengan bebas,"
 },
 {
   "id": 48,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 17,
   "firman": "tetapi pohon pengetahuan tentang yang baik dan yang jahat itu, janganlah kaumakan buahnya, sebab pada hari engkau memakannya, pastilah engkau mati.\""
 },
 {
   "id": 49,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 18,
   "firman": "TUHAN Allah berfirman: \"Tidak baik, kalau manusia itu seorang diri saja. Aku akan menjadikan penolong baginya, yang sepadan dengan dia.\""
 },
 {
   "id": 50,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 19,
   "firman": "Lalu TUHAN Allah membentuk dari tanah segala binatang hutan dan segala burung di udara. Dibawa-Nyalah semuanya kepada manusia itu untuk melihat, bagaimana ia menamainya; dan seperti nama yang diberikan manusia itu kepada tiap-tiap makhluk yang hidup, demikianlah nanti nama makhluk itu."
 },
 {
   "id": 51,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 20,
   "firman": "Manusia itu memberi nama kepada segala ternak, kepada burung-burung di udara dan kepada segala binatang hutan, tetapi baginya sendiri ia tidak menjumpai penolong yang sepadan dengan dia."
 },
 {
   "id": 52,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 21,
   "firman": "Lalu TUHAN Allah membuat manusia itu tidur nyenyak; ketika ia tidur, TUHAN Allah mengambil salah satu rusuk dari padanya, lalu menutup tempat itu dengan daging."
 },
 {
   "id": 53,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 22,
   "firman": "Dan dari rusuk yang diambil TUHAN Allah dari manusia itu, dibangun-Nyalah seorang perempuan, lalu dibawa-Nya kepada manusia itu."
 },
 {
   "id": 54,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 23,
   "firman": "Lalu berkatalah manusia itu: \"Inilah dia, tulang dari tulangku dan daging dari dagingku. Ia akan dinamai perempuan, sebab ia diambil dari laki-laki.\""
 },
 {
   "id": 55,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 24,
   "firman": "Sebab itu seorang laki-laki akan meninggalkan ayahnya dan ibunya dan bersatu dengan isterinya, sehingga keduanya menjadi satu daging."
 },
 {
   "id": 56,
   "kitab": "Kej",
   "pasal": 2,
   "ayat": 25,
   "firman": "Mereka keduanya telanjang, manusia dan isterinya itu, tetapi mereka tidak merasa malu."
 },
 {
   "id": 57,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 1,
   "firman": "Adapun ular ialah yang paling cerdik dari segala binatang di darat yang dijadikan oleh TUHAN Allah. Ular itu berkata kepada perempuan itu: \"Tentulah Allah berfirman: Semua pohon dalam taman ini jangan kamu makan buahnya, bukan?\""
 },
 {
   "id": 58,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu sahut perempuan itu kepada ular itu: \"Buah pohon-pohonan dalam taman ini boleh kami makan,"
 },
 {
   "id": 59,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 3,
   "firman": "tetapi tentang buah pohon yang ada di tengah-tengah taman, Allah berfirman: Jangan kamu makan ataupun raba buah itu, nanti kamu mati.\""
 },
 {
   "id": 60,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 4,
   "firman": "Tetapi ular itu berkata kepada perempuan itu: \"Sekali-kali kamu tidak akan mati,"
 },
 {
   "id": 61,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 5,
   "firman": "tetapi Allah mengetahui, bahwa pada waktu kamu memakannya matamu akan terbuka, dan kamu akan menjadi seperti Allah, tahu tentang yang baik dan yang jahat.\""
 },
 {
   "id": 62,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 6,
   "firman": "Perempuan itu melihat, bahwa buah pohon itu baik untuk dimakan dan sedap kelihatannya, lagipula pohon itu menarik hati karena memberi pengertian. Lalu ia mengambil dari buahnya dan dimakannya dan diberikannya juga kepada suaminya yang bersama-sama dengan dia, dan suaminyapun memakannya."
 },
 {
   "id": 63,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 7,
   "firman": "Maka terbukalah mata mereka berdua dan mereka tahu, bahwa mereka telanjang; lalu mereka menyemat daun pohon ara dan membuat cawat."
 },
 {
   "id": 64,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 8,
   "firman": "Ketika mereka mendengar bunyi langkah TUHAN Allah, yang berjalan-jalan dalam taman itu pada waktu hari sejuk, bersembunyilah manusia dan isterinya itu terhadap TUHAN Allah di antara pohon-pohonan dalam taman."
 },
 {
   "id": 65,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 9,
   "firman": "Tetapi TUHAN Allah memanggil manusia itu dan berfirman kepadanya: \"Di manakah engkau?\""
 },
 {
   "id": 66,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 10,
   "firman": "Ia menjawab: \"Ketika aku mendengar, bahwa Engkau ada dalam taman ini, aku menjadi takut, karena aku telanjang; sebab itu aku bersembunyi.\""
 },
 {
   "id": 67,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 11,
   "firman": "Firman-Nya: \"Siapakah yang memberitahukan kepadamu, bahwa engkau telanjang? Apakah engkau makan dari buah pohon, yang Kularang engkau makan itu?\""
 },
 {
   "id": 68,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 12,
   "firman": "Manusia itu menjawab: \"Perempuan yang Kautempatkan di sisiku, dialah yang memberi dari buah pohon itu kepadaku, maka kumakan.\""
 },
 {
   "id": 69,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 13,
   "firman": "Kemudian berfirmanlah TUHAN Allah kepada perempuan itu: \"Apakah yang telah kauperbuat ini?\" Jawab perempuan itu: \"Ular itu yang memperdayakan aku, maka kumakan.\""
 },
 {
   "id": 70,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 14,
   "firman": "Lalu berfirmanlah TUHAN Allah kepada ular itu: \"Karena engkau berbuat demikian, terkutuklah engkau di antara segala ternak dan di antara segala binatang hutan; dengan perutmulah engkau akan menjalar dan debu tanahlah akan kaumakan seumur hidupmu."
 },
 {
   "id": 71,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 15,
   "firman": "Aku akan mengadakan permusuhan antara engkau dan perempuan ini, antara keturunanmu dan keturunannya; keturunannya akan meremukkan kepalamu, dan engkau akan meremukkan tumitnya.\""
 },
 {
   "id": 72,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 16,
   "firman": "Firman-Nya kepada perempuan itu: \"Susah payahmu waktu mengandung akan Kubuat sangat banyak; dengan kesakitan engkau akan melahirkan anakmu; namun engkau akan berahi kepada suamimu dan ia akan berkuasa atasmu.\""
 },
 {
   "id": 73,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 17,
   "firman": "Lalu firman-Nya kepada manusia itu: \"Karena engkau mendengarkan perkataan isterimu dan memakan dari buah pohon, yang telah Kuperintahkan kepadamu: Jangan makan dari padanya, maka terkutuklah tanah karena engkau; dengan bersusah payah engkau akan mencari rezekimu dari tanah seumur hidupmu:"
 },
 {
   "id": 74,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 18,
   "firman": "semak duri dan rumput duri yang akan dihasilkannya bagimu, dan tumbuh-tumbuhan di padang akan menjadi makananmu;"
 },
 {
   "id": 75,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 19,
   "firman": "dengan berpeluh engkau akan mencari makananmu, sampai engkau kembali lagi menjadi tanah, karena dari situlah engkau diambil; sebab engkau debu dan engkau akan kembali menjadi debu.\""
 },
 {
   "id": 76,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 20,
   "firman": "Manusia itu memberi nama Hawa kepada isterinya, sebab dialah yang menjadi ibu semua yang hidup."
 },
 {
   "id": 77,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 21,
   "firman": "Dan TUHAN Allah membuat pakaian dari kulit binatang untuk manusia dan untuk isterinya itu, lalu mengenakannya kepada mereka."
 },
 {
   "id": 78,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 22,
   "firman": "Berfirmanlah TUHAN Allah: \"Sesungguhnya manusia itu telah menjadi seperti salah satu dari Kita, tahu tentang yang baik dan yang jahat; maka sekarang jangan sampai ia mengulurkan tangannya dan mengambil pula dari buah pohon kehidupan itu dan memakannya, sehingga ia hidup untuk selama-lamanya.\""
 },
 {
   "id": 79,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 23,
   "firman": "Lalu TUHAN Allah mengusir dia dari taman Eden supaya ia mengusahakan tanah dari mana ia diambil."
 },
 {
   "id": 80,
   "kitab": "Kej",
   "pasal": 3,
   "ayat": 24,
   "firman": "Ia menghalau manusia itu dan di sebelah timur taman Eden ditempatkan-Nyalah beberapa kerub dengan pedang yang bernyala-nyala dan menyambar-nyambar, untuk menjaga jalan ke pohon kehidupan."
 },
 {
   "id": 81,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 1,
   "firman": "Kemudian manusia itu bersetubuh dengan Hawa, isterinya, dan mengandunglah perempuan itu, lalu melahirkan Kain; maka kata perempuan itu: \"Aku telah mendapat seorang anak laki-laki dengan pertolongan TUHAN.\""
 },
 {
   "id": 82,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 2,
   "firman": "Selanjutnya dilahirkannyalah Habel, adik Kain; dan Habel menjadi gembala kambing domba, Kain menjadi petani."
 },
 {
   "id": 83,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 3,
   "firman": "Setelah beberapa waktu lamanya, maka Kain mempersembahkan sebagian dari hasil tanah itu kepada TUHAN sebagai korban persembahan;"
 },
 {
   "id": 84,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 4,
   "firman": "Habel juga mempersembahkan korban persembahan dari anak sulung kambing dombanya, yakni lemak-lemaknya; maka TUHAN mengindahkan Habel dan korban persembahannya itu,"
 },
 {
   "id": 85,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 5,
   "firman": "tetapi Kain dan korban persembahannya tidak diindahkan-Nya. Lalu hati Kain menjadi sangat panas, dan mukanya muram."
 },
 {
   "id": 86,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 6,
   "firman": "Firman TUHAN kepada Kain: \"Mengapa hatimu panas dan mukamu muram?"
 },
 {
   "id": 87,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 7,
   "firman": "Apakah mukamu tidak akan berseri, jika engkau berbuat baik? Tetapi jika engkau tidak berbuat baik, dosa sudah mengintip di depan pintu; ia sangat menggoda engkau, tetapi engkau harus berkuasa atasnya.\""
 },
 {
   "id": 88,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 8,
   "firman": "Kata Kain kepada Habel, adiknya: \"Marilah kita pergi ke padang.\" Ketika mereka ada di padang, tiba-tiba Kain memukul Habel, adiknya itu, lalu membunuh dia."
 },
 {
   "id": 89,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 9,
   "firman": "Firman TUHAN kepada Kain: \"Di mana Habel, adikmu itu?\" Jawabnya: \"Aku tidak tahu! Apakah aku penjaga adikku?\""
 },
 {
   "id": 90,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 10,
   "firman": "Firman-Nya: \"Apakah yang telah kauperbuat ini? Darah adikmu itu berteriak kepada-Ku dari tanah."
 },
 {
   "id": 91,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 11,
   "firman": "Maka sekarang, terkutuklah engkau, terbuang jauh dari tanah yang mengangakan mulutnya untuk menerima darah adikmu itu dari tanganmu."
 },
 {
   "id": 92,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 12,
   "firman": "Apabila engkau mengusahakan tanah itu, maka tanah itu tidak akan memberikan hasil sepenuhnya lagi kepadamu; engkau menjadi seorang pelarian dan pengembara di bumi.\""
 },
 {
   "id": 93,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 13,
   "firman": "Kata Kain kepada TUHAN: \"Hukumanku itu lebih besar dari pada yang dapat kutanggung."
 },
 {
   "id": 94,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 14,
   "firman": "Engkau menghalau aku sekarang dari tanah ini dan aku akan tersembunyi dari hadapan-Mu, seorang pelarian dan pengembara di bumi; maka barangsiapa yang akan bertemu dengan aku, tentulah akan membunuh aku.\""
 },
 {
   "id": 95,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 15,
   "firman": "Firman TUHAN kepadanya: \"Sekali-kali tidak! Barangsiapa yang membunuh Kain akan dibalaskan kepadanya tujuh kali lipat.\" Kemudian TUHAN menaruh tanda pada Kain, supaya ia jangan dibunuh oleh barangsiapapun yang bertemu dengan dia."
 },
 {
   "id": 96,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 16,
   "firman": "Lalu Kain pergi dari hadapan TUHAN dan ia menetap di tanah Nod, di sebelah timur Eden."
 },
 {
   "id": 97,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 17,
   "firman": "Kain bersetubuh dengan isterinya dan mengandunglah perempuan itu, lalu melahirkan Henokh; kemudian Kain mendirikan suatu kota dan dinamainya kota itu Henokh, menurut nama anaknya."
 },
 {
   "id": 98,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 18,
   "firman": "Bagi Henokh lahirlah Irad, dan Irad itu memperanakkan Mehuyael dan Mehuyael memperanakkan Metusael, dan Metusael memperanakkan Lamekh."
 },
 {
   "id": 99,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 19,
   "firman": "Lamekh mengambil isteri dua orang; yang satu namanya Ada, yang lain Zila."
 },
 {
   "id": 100,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 20,
   "firman": "Ada itu melahirkan Yabal; dialah yang menjadi bapa orang yang diam dalam kemah dan memelihara ternak."
 },
 {
   "id": 101,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 21,
   "firman": "Nama adiknya ialah Yubal; dialah yang menjadi bapa semua orang yang memainkan kecapi dan suling."
 },
 {
   "id": 102,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 22,
   "firman": "Zila juga melahirkan anak, yakni Tubal-Kain, bapa semua tukang tembaga dan tukang besi. Adik perempuan Tubal-Kain ialah Naama."
 },
 {
   "id": 103,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 23,
   "firman": "Berkatalah Lamekh kepada kedua isterinya itu: \"Ada dan Zila, dengarkanlah suaraku: hai isteri-isteri Lamekh, pasanglah telingamu kepada perkataanku ini: Aku telah membunuh seorang laki-laki karena ia melukai aku, membunuh seorang muda karena ia memukul aku sampai bengkak;"
 },
 {
   "id": 104,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 24,
   "firman": "sebab jika Kain harus dibalaskan tujuh kali lipat, maka Lamekh tujuh puluh tujuh kali lipat.\""
 },
 {
   "id": 105,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 25,
   "firman": "Adam bersetubuh pula dengan isterinya, lalu perempuan itu melahirkan seorang anak laki-laki dan menamainya Set, sebab katanya: \"Allah telah mengaruniakan kepadaku anak yang lain sebagai ganti Habel; sebab Kain telah membunuhnya.\""
 },
 {
   "id": 106,
   "kitab": "Kej",
   "pasal": 4,
   "ayat": 26,
   "firman": "Lahirlah seorang anak laki-laki bagi Set juga dan anak itu dinamainya Enos. Waktu itulah orang mulai memanggil nama TUHAN."
 },
 {
   "id": 107,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 1,
   "firman": "Inilah daftar keturunan Adam. Pada waktu manusia itu diciptakan oleh Allah, dibuat-Nyalah dia menurut rupa Allah;"
 },
 {
   "id": 108,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 2,
   "firman": "laki-laki dan perempuan diciptakan-Nya mereka. Ia memberkati mereka dan memberikan nama \"Manusia\" kepada mereka, pada waktu mereka diciptakan."
 },
 {
   "id": 109,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 3,
   "firman": "Setelah Adam hidup seratus tiga puluh tahun, ia memperanakkan seorang laki-laki menurut rupa dan gambarnya, lalu memberi nama Set kepadanya."
 },
 {
   "id": 110,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 4,
   "firman": "Umur Adam, setelah memperanakkan Set, delapan ratus tahun, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 111,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 5,
   "firman": "Jadi Adam mencapai umur sembilan ratus tiga puluh tahun, lalu ia mati."
 },
 {
   "id": 112,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 6,
   "firman": "Setelah Set hidup seratus lima tahun, ia memperanakkan Enos."
 },
 {
   "id": 113,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 7,
   "firman": "Dan Set masih hidup delapan ratus tujuh tahun, setelah ia memperanakkan Enos, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 114,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 8,
   "firman": "Jadi Set mencapai umur sembilan ratus dua belas tahun, lalu ia mati."
 },
 {
   "id": 115,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 9,
   "firman": "Setelah Enos hidup sembilan puluh tahun, ia memperanakkan Kenan."
 },
 {
   "id": 116,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 10,
   "firman": "Dan Enos masih hidup delapan ratus lima belas tahun, setelah ia memperanakkan Kenan, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 117,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 11,
   "firman": "Jadi Enos mencapai umur sembilan ratus lima tahun, lalu ia mati."
 },
 {
   "id": 118,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 12,
   "firman": "Setelah Kenan hidup tujuh puluh tahun, ia memperanakkan Mahalaleel."
 },
 {
   "id": 119,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 13,
   "firman": "Dan Kenan masih hidup delapan ratus empat puluh tahun, setelah ia memperanakkan Mahalaleel, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 120,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 14,
   "firman": "Jadi Kenan mencapai umur sembilan ratus sepuluh tahun, lalu ia mati."
 },
 {
   "id": 121,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 15,
   "firman": "Setelah Mahalaleel hidup enam puluh lima tahun, ia memperanakkan Yared."
 },
 {
   "id": 122,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 16,
   "firman": "Dan Mahalaleel masih hidup delapan ratus tiga puluh tahun, setelah ia memperanakkan Yared, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 123,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 17,
   "firman": "Jadi Mahalaleel mencapai umur delapan ratus sembilan puluh lima tahun, lalu ia mati."
 },
 {
   "id": 124,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 18,
   "firman": "Setelah Yared hidup seratus enam puluh dua tahun, ia memperanakkan Henokh."
 },
 {
   "id": 125,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 19,
   "firman": "Dan Yared masih hidup delapan ratus tahun, setelah ia memperanakkan Henokh, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 126,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 20,
   "firman": "Jadi Yared mencapai umur sembilan ratus enam puluh dua tahun, lalu ia mati."
 },
 {
   "id": 127,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 21,
   "firman": "Setelah Henokh hidup enam puluh lima tahun, ia memperanakkan Metusalah."
 },
 {
   "id": 128,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 22,
   "firman": "Dan Henokh hidup bergaul dengan Allah selama tiga ratus tahun lagi, setelah ia memperanakkan Metusalah, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 129,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 23,
   "firman": "Jadi Henokh mencapai umur tiga ratus enam puluh lima tahun."
 },
 {
   "id": 130,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 24,
   "firman": "Dan Henokh hidup bergaul dengan Allah, lalu ia tidak ada lagi, sebab ia telah diangkat oleh Allah."
 },
 {
   "id": 131,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 25,
   "firman": "Setelah Metusalah hidup seratus delapan puluh tujuh tahun, ia memperanakkan Lamekh."
 },
 {
   "id": 132,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 26,
   "firman": "Dan Metusalah masih hidup tujuh ratus delapan puluh dua tahun, setelah ia memperanakkan Lamekh, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 133,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 27,
   "firman": "Jadi Metusalah mencapai umur sembilan ratus enam puluh sembilan tahun, lalu ia mati."
 },
 {
   "id": 134,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 28,
   "firman": "Setelah Lamekh hidup seratus delapan puluh dua tahun, ia memperanakkan seorang anak laki-laki,"
 },
 {
   "id": 135,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 29,
   "firman": "dan memberi nama Nuh kepadanya, katanya: \"Anak ini akan memberi kepada kita penghiburan dalam pekerjaan kita yang penuh susah payah di tanah yang telah terkutuk oleh TUHAN.\""
 },
 {
   "id": 136,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 30,
   "firman": "Dan Lamekh masih hidup lima ratus sembilan puluh lima tahun, setelah ia memperanakkan Nuh, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 137,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 31,
   "firman": "Jadi Lamekh mencapai umur tujuh ratus tujuh puluh tujuh tahun, lalu ia mati."
 },
 {
   "id": 138,
   "kitab": "Kej",
   "pasal": 5,
   "ayat": 32,
   "firman": "Setelah Nuh berumur lima ratus tahun, ia memperanakkan Sem, Ham dan Yafet."
 },
 {
   "id": 139,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 1,
   "firman": "Ketika manusia itu mulai bertambah banyak jumlahnya di muka bumi, dan bagi mereka lahir anak-anak perempuan,"
 },
 {
   "id": 140,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 2,
   "firman": "maka anak-anak Allah melihat, bahwa anak-anak perempuan manusia itu cantik-cantik, lalu mereka mengambil isteri dari antara perempuan-perempuan itu, siapa saja yang disukai mereka."
 },
 {
   "id": 141,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 3,
   "firman": "Berfirmanlah TUHAN: \"Roh-Ku tidak akan selama-lamanya tinggal di dalam manusia, karena manusia itu adalah daging, tetapi umurnya akan seratus dua puluh tahun saja.\""
 },
 {
   "id": 142,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 4,
   "firman": "Pada waktu itu orang-orang raksasa ada di bumi, dan juga pada waktu sesudahnya, ketika anak-anak Allah menghampiri anak-anak perempuan manusia, dan perempuan-perempuan itu melahirkan anak bagi mereka; inilah orang-orang yang gagah perkasa di zaman purbakala, orang-orang yang kenamaan."
 },
 {
   "id": 143,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 5,
   "firman": "Ketika dilihat TUHAN, bahwa kejahatan manusia besar di bumi dan bahwa segala kecenderungan hatinya selalu membuahkan kejahatan semata-mata,"
 },
 {
   "id": 144,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 6,
   "firman": "maka menyesallah TUHAN, bahwa Ia telah menjadikan manusia di bumi, dan hal itu memilukan hati-Nya."
 },
 {
   "id": 145,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 7,
   "firman": "Berfirmanlah TUHAN: \"Aku akan menghapuskan manusia yang telah Kuciptakan itu dari muka bumi, baik manusia maupun hewan dan binatang-binatang melata dan burung-burung di udara, sebab Aku menyesal, bahwa Aku telah menjadikan mereka.\""
 },
 {
   "id": 146,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 8,
   "firman": "Tetapi Nuh mendapat kasih karunia di mata TUHAN."
 },
 {
   "id": 147,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 9,
   "firman": "Inilah riwayat Nuh: Nuh adalah seorang yang benar dan tidak bercela di antara orang-orang sezamannya; dan Nuh itu hidup bergaul dengan Allah."
 },
 {
   "id": 148,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 10,
   "firman": "Nuh memperanakkan tiga orang laki-laki: Sem, Ham dan Yafet."
 },
 {
   "id": 149,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 11,
   "firman": "Adapun bumi itu telah rusak di hadapan Allah dan penuh dengan kekerasan."
 },
 {
   "id": 150,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 12,
   "firman": "Allah menilik bumi itu dan sungguhlah rusak benar, sebab semua manusia menjalankan hidup yang rusak di bumi."
 },
 {
   "id": 151,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 13,
   "firman": "Berfirmanlah Allah kepada Nuh: \"Aku telah memutuskan untuk mengakhiri hidup segala makhluk, sebab bumi telah penuh dengan kekerasan oleh mereka, jadi Aku akan memusnahkan mereka bersama-sama dengan bumi."
 },
 {
   "id": 152,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 14,
   "firman": "Buatlah bagimu sebuah bahtera dari kayu gofir; bahtera itu harus kaubuat berpetak-petak dan harus kaututup dengan pakal dari luar dan dari dalam."
 },
 {
   "id": 153,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 15,
   "firman": "Beginilah engkau harus membuat bahtera itu: tiga ratus hasta panjangnya, lima puluh hasta lebarnya dan tiga puluh hasta tingginya."
 },
 {
   "id": 154,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 16,
   "firman": "Buatlah atap pada bahtera itu dan selesaikanlah bahtera itu sampai sehasta dari atas, dan pasanglah pintunya pada lambungnya; buatlah bahtera itu bertingkat bawah, tengah dan atas."
 },
 {
   "id": 155,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 17,
   "firman": "Sebab sesungguhnya Aku akan mendatangkan air bah meliputi bumi untuk memusnahkan segala yang hidup dan bernyawa di kolong langit; segala yang ada di bumi akan mati binasa."
 },
 {
   "id": 156,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 18,
   "firman": "Tetapi dengan engkau Aku akan mengadakan perjanjian-Ku, dan engkau akan masuk ke dalam bahtera itu: engkau bersama-sama dengan anak-anakmu dan isterimu dan isteri anak-anakmu."
 },
 {
   "id": 157,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 19,
   "firman": "Dan dari segala yang hidup, dari segala makhluk, dari semuanya haruslah engkau bawa satu pasang ke dalam bahtera itu, supaya terpelihara hidupnya bersama-sama dengan engkau; jantan dan betina harus kaubawa."
 },
 {
   "id": 158,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 20,
   "firman": "Dari segala jenis burung dan dari segala jenis hewan, dari segala jenis binatang melata di muka bumi, dari semuanya itu harus datang satu pasang kepadamu, supaya terpelihara hidupnya."
 },
 {
   "id": 159,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 21,
   "firman": "Dan engkau, bawalah bagimu segala apa yang dapat dimakan; kumpulkanlah itu padamu untuk menjadi makanan bagimu dan bagi mereka.\""
 },
 {
   "id": 160,
   "kitab": "Kej",
   "pasal": 6,
   "ayat": 22,
   "firman": "Lalu Nuh melakukan semuanya itu; tepat seperti yang diperintahkan Allah kepadanya, demikianlah dilakukannya."
 },
 {
   "id": 161,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 1,
   "firman": "Lalu berfirmanlah TUHAN kepada Nuh: \"Masuklah ke dalam bahtera itu, engkau dan seisi rumahmu, sebab engkaulah yang Kulihat benar di hadapan-Ku di antara orang zaman ini."
 },
 {
   "id": 162,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 2,
   "firman": "Dari segala binatang yang tidak haram haruslah kauambil tujuh pasang, jantan dan betinanya, tetapi dari binatang yang haram satu pasang, jantan dan betinanya;"
 },
 {
   "id": 163,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 3,
   "firman": "juga dari burung-burung di udara tujuh pasang, jantan dan betina, supaya terpelihara hidup keturunannya di seluruh bumi."
 },
 {
   "id": 164,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 4,
   "firman": "Sebab tujuh hari lagi Aku akan menurunkan hujan ke atas bumi empat puluh hari empat puluh malam lamanya, dan Aku akan menghapuskan dari muka bumi segala yang ada, yang Kujadikan itu.\""
 },
 {
   "id": 165,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 5,
   "firman": "Lalu Nuh melakukan segala yang diperintahkan TUHAN kepadanya."
 },
 {
   "id": 166,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 6,
   "firman": "Nuh berumur enam ratus tahun, ketika air bah datang meliputi bumi."
 },
 {
   "id": 167,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 7,
   "firman": "Masuklah Nuh ke dalam bahtera itu bersama-sama dengan anak-anaknya dan isterinya dan isteri anak-anaknya karena air bah itu."
 },
 {
   "id": 168,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dari binatang yang tidak haram dan yang haram, dari burung-burung dan dari segala yang merayap di muka bumi,"
 },
 {
   "id": 169,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 9,
   "firman": "datanglah sepasang mendapatkan Nuh ke dalam bahtera itu, jantan dan betina, seperti yang diperintahkan Allah kepada Nuh."
 },
 {
   "id": 170,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 10,
   "firman": "Setelah tujuh hari datanglah air bah meliputi bumi."
 },
 {
   "id": 171,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 11,
   "firman": "Pada waktu umur Nuh enam ratus tahun, pada bulan yang kedua, pada hari yang ketujuh belas bulan itu, pada hari itulah terbelah segala mata air samudera raya yang dahsyat dan terbukalah tingkap-tingkap di langit."
 },
 {
   "id": 172,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 12,
   "firman": "Dan turunlah hujan lebat meliputi bumi empat puluh hari empat puluh malam lamanya."
 },
 {
   "id": 173,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 13,
   "firman": "Pada hari itu juga masuklah Nuh serta Sem, Ham dan Yafet, anak-anak Nuh, dan isteri Nuh, dan ketiga isteri anak-anaknya bersama-sama dengan dia, ke dalam bahtera itu,"
 },
 {
   "id": 174,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 14,
   "firman": "mereka itu dan segala jenis binatang liar dan segala jenis ternak dan segala jenis binatang melata yang merayap di bumi dan segala jenis burung, yakni segala yang berbulu bersayap;"
 },
 {
   "id": 175,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 15,
   "firman": "dari segala yang hidup dan bernyawa datanglah sepasang mendapatkan Nuh ke dalam bahtera itu."
 },
 {
   "id": 176,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dan yang masuk itu adalah jantan dan betina dari segala yang hidup, seperti yang diperintahkan Allah kepada Nuh; lalu TUHAN menutup pintu bahtera itu di belakang Nuh."
 },
 {
   "id": 177,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 17,
   "firman": "Empat puluh hari lamanya air bah itu meliputi bumi; air itu naik dan mengangkat bahtera itu, sehingga melampung tinggi dari bumi."
 },
 {
   "id": 178,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 18,
   "firman": "Ketika air itu makin bertambah-tambah dan naik dengan hebatnya di atas bumi, terapung-apunglah bahtera itu di muka air."
 },
 {
   "id": 179,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 19,
   "firman": "Dan air itu sangat hebatnya bertambah-tambah meliputi bumi, dan ditutupinyalah segala gunung tinggi di seluruh kolong langit,"
 },
 {
   "id": 180,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 20,
   "firman": "sampai lima belas hasta di atasnya bertambah-tambah air itu, sehingga gunung-gunung ditutupinya."
 },
 {
   "id": 181,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 21,
   "firman": "Lalu mati binasalah segala yang hidup, yang bergerak di bumi, burung-burung, ternak dan binatang liar dan segala binatang merayap, yang berkeriapan di bumi, serta semua manusia."
 },
 {
   "id": 182,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 22,
   "firman": "Matilah segala yang ada nafas hidup dalam hidungnya, segala yang ada di darat."
 },
 {
   "id": 183,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 23,
   "firman": "Demikianlah dihapuskan Allah segala yang ada, segala yang di muka bumi, baik manusia maupun hewan dan binatang melata dan burung-burung di udara, sehingga semuanya itu dihapuskan dari atas bumi; hanya Nuh yang tinggal hidup dan semua yang bersama-sama dengan dia dalam bahtera itu."
 },
 {
   "id": 184,
   "kitab": "Kej",
   "pasal": 7,
   "ayat": 24,
   "firman": "Dan berkuasalah air itu di atas bumi seratus lima puluh hari lamanya."
 },
 {
   "id": 185,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 1,
   "firman": "Maka Allah mengingat Nuh dan segala binatang liar dan segala ternak, yang bersama-sama dengan dia dalam bahtera itu, dan Allah membuat angin menghembus melalui bumi, sehingga air itu turun."
 },
 {
   "id": 186,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 2,
   "firman": "Ditutuplah mata-mata air samudera raya serta tingkap-tingkap di langit dan berhentilah hujan lebat dari langit,"
 },
 {
   "id": 187,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 3,
   "firman": "dan makin surutlah air itu dari muka bumi. Demikianlah berkurang air itu sesudah seratus lima puluh hari."
 },
 {
   "id": 188,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 4,
   "firman": "Dalam bulan yang ketujuh, pada hari yang ketujuh belas bulan itu, terkandaslah bahtera itu pada pegunungan Ararat."
 },
 {
   "id": 189,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 5,
   "firman": "Sampai bulan yang kesepuluh makin berkuranglah air itu; dalam bulan yang kesepuluh, pada tanggal satu bulan itu, tampaklah puncak-puncak gunung."
 },
 {
   "id": 190,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 6,
   "firman": "Sesudah lewat empat puluh hari, maka Nuh membuka tingkap yang dibuatnya pada bahtera itu."
 },
 {
   "id": 191,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 7,
   "firman": "Lalu ia melepaskan seekor burung gagak; dan burung itu terbang pulang pergi, sampai air itu menjadi kering dari atas bumi."
 },
 {
   "id": 192,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 8,
   "firman": "Kemudian dilepaskannya seekor burung merpati untuk melihat, apakah air itu telah berkurang dari muka bumi."
 },
 {
   "id": 193,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 9,
   "firman": "Tetapi burung merpati itu tidak mendapat tempat tumpuan kakinya dan pulanglah ia kembali mendapatkan Nuh ke dalam bahtera itu, karena di seluruh bumi masih ada air; lalu Nuh mengulurkan tangannya, ditangkapnya burung itu dan dibawanya masuk ke dalam bahtera."
 },
 {
   "id": 194,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 10,
   "firman": "Ia menunggu tujuh hari lagi, kemudian dilepaskannya pula burung merpati itu dari bahtera;"
 },
 {
   "id": 195,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 11,
   "firman": "menjelang waktu senja pulanglah burung merpati itu mendapatkan Nuh, dan pada paruhnya dibawanya sehelai daun zaitun yang segar. Dari situlah diketahui Nuh, bahwa air itu telah berkurang dari atas bumi."
 },
 {
   "id": 196,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 12,
   "firman": "Selanjutnya ditunggunya pula tujuh hari lagi, kemudian dilepaskannya burung merpati itu, tetapi burung itu tidak kembali lagi kepadanya."
 },
 {
   "id": 197,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 13,
   "firman": "Dalam tahun keenam ratus satu, dalam bulan pertama, pada tanggal satu bulan itu, sudahlah kering air itu dari atas bumi; kemudian Nuh membuka tutup bahtera itu dan melihat-lihat; ternyatalah muka bumi sudah mulai kering."
 },
 {
   "id": 198,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 14,
   "firman": "Dalam bulan kedua, pada hari yang kedua puluh tujuh bulan itu, bumi telah kering."
 },
 {
   "id": 199,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 15,
   "firman": "Lalu berfirmanlah Allah kepada Nuh:"
 },
 {
   "id": 200,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 16,
   "firman": "\"Keluarlah dari bahtera itu, engkau bersama-sama dengan isterimu serta anak-anakmu dan isteri anak-anakmu;"
 },
 {
   "id": 201,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 17,
   "firman": "segala binatang yang bersama-sama dengan engkau, segala yang hidup: burung-burung, hewan dan segala binatang melata yang merayap di bumi, suruhlah keluar bersama-sama dengan engkau, supaya semuanya itu berkeriapan di bumi serta berkembang biak dan bertambah banyak di bumi.\""
 },
 {
   "id": 202,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 18,
   "firman": "Lalu keluarlah Nuh bersama-sama dengan anak-anaknya dan isterinya dan isteri anak-anaknya."
 },
 {
   "id": 203,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 19,
   "firman": "Segala binatang liar, segala binatang melata dan segala burung, semuanya yang bergerak di bumi, masing-masing menurut jenisnya, keluarlah juga dari bahtera itu."
 },
 {
   "id": 204,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 20,
   "firman": "Lalu Nuh mendirikan mezbah bagi TUHAN; dari segala binatang yang tidak haram dan dari segala burung yang tidak haram diambilnyalah beberapa ekor, lalu ia mempersembahkan korban bakaran di atas mezbah itu."
 },
 {
   "id": 205,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 21,
   "firman": "Ketika TUHAN mencium persembahan yang harum itu, berfirmanlah TUHAN dalam hati-Nya: \"Aku takkan mengutuk bumi ini lagi karena manusia, sekalipun yang ditimbulkan hatinya adalah jahat dari sejak kecilnya, dan Aku takkan membinasakan lagi segala yang hidup seperti yang telah Kulakukan."
 },
 {
   "id": 206,
   "kitab": "Kej",
   "pasal": 8,
   "ayat": 22,
   "firman": "Selama bumi masih ada, takkan berhenti-henti musim menabur dan menuai, dingin dan panas, kemarau dan hujan, siang dan malam.\""
 },
 {
   "id": 207,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 1,
   "firman": "Lalu Allah memberkati Nuh dan anak-anaknya serta berfirman kepada mereka: \"Beranakcuculah dan bertambah banyaklah serta penuhilah bumi."
 },
 {
   "id": 208,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 2,
   "firman": "Akan takut dan akan gentar kepadamu segala binatang di bumi dan segala burung di udara, segala yang bergerak di muka bumi dan segala ikan di laut; ke dalam tanganmulah semuanya itu diserahkan."
 },
 {
   "id": 209,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 3,
   "firman": "Segala yang bergerak, yang hidup, akan menjadi makananmu. Aku telah memberikan semuanya itu kepadamu seperti juga tumbuh-tumbuhan hijau."
 },
 {
   "id": 210,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 4,
   "firman": "Hanya daging yang masih ada nyawanya, yakni darahnya, janganlah kamu makan."
 },
 {
   "id": 211,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 5,
   "firman": "Tetapi mengenai darah kamu, yakni nyawa kamu, Aku akan menuntut balasnya; dari segala binatang Aku akan menuntutnya, dan dari setiap manusia Aku akan menuntut nyawa sesama manusia."
 },
 {
   "id": 212,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 6,
   "firman": "Siapa yang menumpahkan darah manusia, darahnya akan tertumpah oleh manusia, sebab Allah membuat manusia itu menurut gambar-Nya sendiri."
 },
 {
   "id": 213,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 7,
   "firman": "Dan kamu, beranakcuculah dan bertambah banyak, sehingga tak terbilang jumlahmu di atas bumi, ya, bertambah banyaklah di atasnya.\""
 },
 {
   "id": 214,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 8,
   "firman": "Berfirmanlah Allah kepada Nuh dan kepada anak-anaknya yang bersama-sama dengan dia:"
 },
 {
   "id": 215,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 9,
   "firman": "\"Sesungguhnya Aku mengadakan perjanjian-Ku dengan kamu dan dengan keturunanmu,"
 },
 {
   "id": 216,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 10,
   "firman": "dan dengan segala makhluk hidup yang bersama-sama dengan kamu: burung-burung, ternak dan binatang-binatang liar di bumi yang bersama-sama dengan kamu, segala yang keluar dari bahtera itu, segala binatang di bumi."
 },
 {
   "id": 217,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 11,
   "firman": "Maka Kuadakan perjanjian-Ku dengan kamu, bahwa sejak ini tidak ada yang hidup yang akan dilenyapkan oleh air bah lagi, dan tidak akan ada lagi air bah untuk memusnahkan bumi.\""
 },
 {
   "id": 218,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 12,
   "firman": "Dan Allah berfirman: \"Inilah tanda perjanjian yang Kuadakan antara Aku dan kamu serta segala makhluk yang hidup, yang bersama-sama dengan kamu, turun-temurun, untuk selama-lamanya:"
 },
 {
   "id": 219,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 13,
   "firman": "Busur-Ku Kutaruh di awan, supaya itu menjadi tanda perjanjian antara Aku dan bumi."
 },
 {
   "id": 220,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 14,
   "firman": "Apabila kemudian Kudatangkan awan di atas bumi dan busur itu tampak di awan,"
 },
 {
   "id": 221,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 15,
   "firman": "maka Aku akan mengingat perjanjian-Ku yang telah ada antara Aku dan kamu serta segala makhluk yang hidup, segala yang bernyawa, sehingga segenap air tidak lagi menjadi air bah untuk memusnahkan segala yang hidup."
 },
 {
   "id": 222,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 16,
   "firman": "Jika busur itu ada di awan, maka Aku akan melihatnya, sehingga Aku mengingat perjanjian-Ku yang kekal antara Allah dan segala makhluk yang hidup, segala makhluk yang ada di bumi.\""
 },
 {
   "id": 223,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 17,
   "firman": "Berfirmanlah Allah kepada Nuh: \"Inilah tanda perjanjian yang Kuadakan antara Aku dan segala makhluk yang ada di bumi.\""
 },
 {
   "id": 224,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 18,
   "firman": "Anak-anak Nuh yang keluar dari bahtera ialah Sem, Ham dan Yafet; Ham adalah bapa Kanaan."
 },
 {
   "id": 225,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 19,
   "firman": "Yang tiga inilah anak-anak Nuh, dan dari mereka inilah tersebar penduduk seluruh bumi."
 },
 {
   "id": 226,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 20,
   "firman": "Nuh menjadi petani; dialah yang mula-mula membuat kebun anggur."
 },
 {
   "id": 227,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 21,
   "firman": "Setelah ia minum anggur, mabuklah ia dan ia telanjang dalam kemahnya."
 },
 {
   "id": 228,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 22,
   "firman": "Maka Ham, bapa Kanaan itu, melihat aurat ayahnya, lalu diceritakannya kepada kedua saudaranya di luar."
 },
 {
   "id": 229,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 23,
   "firman": "Sesudah itu Sem dan Yafet mengambil sehelai kain dan membentangkannya pada bahu mereka berdua, lalu mereka berjalan mundur; mereka menutupi aurat ayahnya sambil berpaling muka, sehingga mereka tidak melihat aurat ayahnya."
 },
 {
   "id": 230,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 24,
   "firman": "Setelah Nuh sadar dari mabuknya dan mendengar apa yang dilakukan anak bungsunya kepadanya,"
 },
 {
   "id": 231,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 25,
   "firman": "berkatalah ia: \"Terkutuklah Kanaan, hendaklah ia menjadi hamba yang paling hina bagi saudara-saudaranya.\""
 },
 {
   "id": 232,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 26,
   "firman": "Lagi katanya: \"Terpujilah TUHAN, Allah Sem, tetapi hendaklah Kanaan menjadi hamba baginya."
 },
 {
   "id": 233,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 27,
   "firman": "Allah meluaskan kiranya tempat kediaman Yafet, dan hendaklah ia tinggal dalam kemah-kemah Sem, tetapi hendaklah Kanaan menjadi hamba baginya.\""
 },
 {
   "id": 234,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 28,
   "firman": "Nuh masih hidup tiga ratus lima puluh tahun sesudah air bah."
 },
 {
   "id": 235,
   "kitab": "Kej",
   "pasal": 9,
   "ayat": 29,
   "firman": "Jadi Nuh mencapai umur sembilan ratus lima puluh tahun, lalu ia mati."
 },
 {
   "id": 236,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 1,
   "firman": "Inilah keturunan Sem, Ham dan Yafet, anak-anak Nuh. Setelah air bah itu lahirlah anak-anak lelaki bagi mereka."
 },
 {
   "id": 237,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 2,
   "firman": "Keturunan Yafet ialah Gomer, Magog, Madai, Yawan, Tubal, Mesekh dan Tiras."
 },
 {
   "id": 238,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 3,
   "firman": "Keturunan Gomer ialah Askenas, Rifat dan Togarma."
 },
 {
   "id": 239,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 4,
   "firman": "Keturunan Yawan ialah Elisa, Tarsis, orang Kitim dan orang Dodanim."
 },
 {
   "id": 240,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 5,
   "firman": "Dari mereka inilah berpencar bangsa-bangsa daerah pesisir. Itulah keturunan Yafet, masing-masing di tanahnya, dengan bahasanya sendiri, menurut kaum dan bangsa mereka."
 },
 {
   "id": 241,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 6,
   "firman": "Keturunan Ham ialah Kush, Misraim, Put dan Kanaan."
 },
 {
   "id": 242,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 7,
   "firman": "Keturunan Kush ialah Seba, Hawila, Sabta, Raema dan Sabtekha; anak-anak Raema ialah Syeba dan Dedan."
 },
 {
   "id": 243,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 8,
   "firman": "Kush memperanakkan Nimrod; dialah yang mula-mula sekali orang yang berkuasa di bumi;"
 },
 {
   "id": 244,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 9,
   "firman": "ia seorang pemburu yang gagah perkasa di hadapan TUHAN, sebab itu dikatakan orang: \"Seperti Nimrod, seorang pemburu yang gagah perkasa di hadapan TUHAN.\""
 },
 {
   "id": 245,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 10,
   "firman": "Mula-mula kerajaannya terdiri dari Babel, Erekh, dan Akad, semuanya di tanah Sinear."
 },
 {
   "id": 246,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 11,
   "firman": "Dari negeri itu ia pergi ke Asyur, lalu mendirikan Niniwe, Rehobot-Ir, Kalah"
 },
 {
   "id": 247,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 12,
   "firman": "dan Resen di antara Niniwe dan Kalah; itulah kota besar itu."
 },
 {
   "id": 248,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 13,
   "firman": "Misraim memperanakkan orang Ludim, orang Anamim, orang Lehabim, orang Naftuhim,"
 },
 {
   "id": 249,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 14,
   "firman": "orang Patrusim, orang Kasluhim dan orang Kaftorim; dari mereka inilah berasal orang Filistin."
 },
 {
   "id": 250,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 15,
   "firman": "Kanaan memperanakkan Sidon, anak sulungnya, dan Het,"
 },
 {
   "id": 251,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 16,
   "firman": "serta orang Yebusi, orang Amori dan orang Girgasi;"
 },
 {
   "id": 252,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 17,
   "firman": "orang Hewi, orang Arki, orang Sini,"
 },
 {
   "id": 253,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 18,
   "firman": "orang Arwadi, orang Semari dan orang Hamati; kemudian berseraklah kaum-kaum orang Kanaan itu."
 },
 {
   "id": 254,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 19,
   "firman": "Daerah orang Kanaan adalah dari Sidon ke arah Gerar sampai ke Gaza, ke arah Sodom, Gomora, Adma dan Zeboim sampai ke Lasa."
 },
 {
   "id": 255,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 20,
   "firman": "Itulah keturunan Ham menurut kaum mereka, menurut bahasa mereka, menurut tanah mereka, menurut bangsa mereka."
 },
 {
   "id": 256,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 21,
   "firman": "Lahirlah juga anak-anak bagi Sem, bapa semua anak Eber serta abang Yafet."
 },
 {
   "id": 257,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 22,
   "firman": "Keturunan Sem ialah Elam, Asyur, Arpakhsad, Lud dan Aram."
 },
 {
   "id": 258,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 23,
   "firman": "Keturunan Aram ialah Us, Hul, Geter dan Mas."
 },
 {
   "id": 259,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 24,
   "firman": "Arpakhsad memperanakkan Selah, dan Selah memperanakkan Eber."
 },
 {
   "id": 260,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 25,
   "firman": "Bagi Eber lahir dua anak laki-laki; nama yang seorang ialah Peleg, sebab dalam zamannya bumi terbagi, dan nama adiknya ialah Yoktan."
 },
 {
   "id": 261,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 26,
   "firman": "Yoktan memperanakkan Almodad, Selef, Hazar-Mawet dan Yerah,"
 },
 {
   "id": 262,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 27,
   "firman": "Hadoram, Uzal dan Dikla,"
 },
 {
   "id": 263,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 28,
   "firman": "Obal, Abimael dan Syeba,"
 },
 {
   "id": 264,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 29,
   "firman": "Ofir, Hawila dan Yobab; itulah semuanya keturunan Yoktan."
 },
 {
   "id": 265,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 30,
   "firman": "Daerah kediaman mereka terbentang dari Mesa ke arah Sefar, yaitu pegunungan di sebelah timur."
 },
 {
   "id": 266,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 31,
   "firman": "Itulah keturunan Sem, menurut kaum mereka, menurut bahasa mereka, menurut tanah mereka, menurut bangsa mereka."
 },
 {
   "id": 267,
   "kitab": "Kej",
   "pasal": 10,
   "ayat": 32,
   "firman": "Itulah segala kaum anak-anak Nuh menurut keturunan mereka, menurut bangsa mereka. Dan dari mereka itulah berpencar bangsa-bangsa di bumi setelah air bah itu."
 },
 {
   "id": 268,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 1,
   "firman": "Adapun seluruh bumi, satu bahasanya dan satu logatnya."
 },
 {
   "id": 269,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 2,
   "firman": "Maka berangkatlah mereka ke sebelah timur dan menjumpai tanah datar di tanah Sinear, lalu menetaplah mereka di sana."
 },
 {
   "id": 270,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 3,
   "firman": "Mereka berkata seorang kepada yang lain: \"Marilah kita membuat batu bata dan membakarnya baik-baik.\" Lalu bata itulah dipakai mereka sebagai batu dan ter gala-gala sebagai tanah liat."
 },
 {
   "id": 271,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 4,
   "firman": "Juga kata mereka: \"Marilah kita dirikan bagi kita sebuah kota dengan sebuah menara yang puncaknya sampai ke langit, dan marilah kita cari nama, supaya kita jangan terserak ke seluruh bumi.\""
 },
 {
   "id": 272,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 5,
   "firman": "Lalu turunlah TUHAN untuk melihat kota dan menara yang didirikan oleh anak-anak manusia itu,"
 },
 {
   "id": 273,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 6,
   "firman": "dan Ia berfirman: \"Mereka ini satu bangsa dengan satu bahasa untuk semuanya. Ini barulah permulaan usaha mereka; mulai dari sekarang apapun juga yang mereka rencanakan, tidak ada yang tidak akan dapat terlaksana."
 },
 {
   "id": 274,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 7,
   "firman": "Baiklah Kita turun dan mengacaubalaukan di sana bahasa mereka, sehingga mereka tidak mengerti lagi bahasa masing-masing.\""
 },
 {
   "id": 275,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 8,
   "firman": "Demikianlah mereka diserakkan TUHAN dari situ ke seluruh bumi, dan mereka berhenti mendirikan kota itu."
 },
 {
   "id": 276,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 9,
   "firman": "Itulah sebabnya sampai sekarang nama kota itu disebut Babel, karena di situlah dikacaubalaukan TUHAN bahasa seluruh bumi dan dari situlah mereka diserakkan TUHAN ke seluruh bumi."
 },
 {
   "id": 277,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 10,
   "firman": "Inilah keturunan Sem. Setelah Sem berumur seratus tahun, ia memperanakkan Arpakhsad, dua tahun setelah air bah itu."
 },
 {
   "id": 278,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 11,
   "firman": "Sem masih hidup lima ratus tahun, setelah ia memperanakkan Arpakhsad, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 279,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 12,
   "firman": "Setelah Arpakhsad hidup tiga puluh lima tahun, ia memperanakkan Selah."
 },
 {
   "id": 280,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 13,
   "firman": "Arpakhsad masih hidup empat ratus tiga tahun, setelah ia memperanakkan Selah, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 281,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 14,
   "firman": "Setelah Selah hidup tiga puluh tahun, ia memperanakkan Eber."
 },
 {
   "id": 282,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 15,
   "firman": "Selah masih hidup empat ratus tiga tahun, setelah ia memperanakkan Eber, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 283,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 16,
   "firman": "Setelah Eber hidup tiga puluh empat tahun, ia memperanakkan Peleg."
 },
 {
   "id": 284,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 17,
   "firman": "Eber masih hidup empat ratus tiga puluh tahun, setelah ia memperanakkan Peleg, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 285,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 18,
   "firman": "Setelah Peleg hidup tiga puluh tahun, ia memperanakkan Rehu."
 },
 {
   "id": 286,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 19,
   "firman": "Peleg masih hidup dua ratus sembilan tahun, setelah ia memperanakkan Rehu, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 287,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 20,
   "firman": "Setelah Rehu hidup tiga puluh dua tahun, ia memperanakkan Serug."
 },
 {
   "id": 288,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 21,
   "firman": "Rehu masih hidup dua ratus tujuh tahun, setelah ia memperanakkan Serug, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 289,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 22,
   "firman": "Setelah Serug hidup tiga puluh tahun, ia memperanakkan Nahor."
 },
 {
   "id": 290,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 23,
   "firman": "Serug masih hidup dua ratus tahun, setelah ia memperanakkan Nahor, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 291,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 24,
   "firman": "Setelah Nahor hidup dua puluh sembilan tahun, ia memperanakkan Terah."
 },
 {
   "id": 292,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 25,
   "firman": "Nahor masih hidup seratus sembilan belas tahun, setelah ia memperanakkan Terah, dan ia memperanakkan anak-anak lelaki dan perempuan."
 },
 {
   "id": 293,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 26,
   "firman": "Setelah Terah hidup tujuh puluh tahun, ia memperanakkan Abram, Nahor dan Haran."
 },
 {
   "id": 294,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 27,
   "firman": "Inilah keturunan Terah. Terah memperanakkan Abram, Nahor dan Haran, dan Haran memperanakkan Lot."
 },
 {
   "id": 295,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 28,
   "firman": "Ketika Terah, ayahnya, masih hidup, matilah Haran di negeri kelahirannya, di Ur-Kasdim."
 },
 {
   "id": 296,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 29,
   "firman": "Abram dan Nahor kedua-duanya kawin; nama isteri Abram ialah Sarai, dan nama isteri Nahor ialah Milka, anak Haran ayah Milka dan Yiska."
 },
 {
   "id": 297,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 30,
   "firman": "Sarai itu mandul, tidak mempunyai anak."
 },
 {
   "id": 298,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 31,
   "firman": "Lalu Terah membawa Abram, anaknya, serta cucunya, Lot, yaitu anak Haran, dan Sarai, menantunya, isteri Abram, anaknya; ia berangkat bersama-sama dengan mereka dari Ur-Kasdim untuk pergi ke tanah Kanaan, lalu sampailah mereka ke Haran, dan menetap di sana."
 },
 {
   "id": 299,
   "kitab": "Kej",
   "pasal": 11,
   "ayat": 32,
   "firman": "Umur Terah ada dua ratus lima tahun; lalu ia mati di Haran."
 },
 {
   "id": 300,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Abram: \"Pergilah dari negerimu dan dari sanak saudaramu dan dari rumah bapamu ini ke negeri yang akan Kutunjukkan kepadamu;"
 },
 {
   "id": 301,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 2,
   "firman": "Aku akan membuat engkau menjadi bangsa yang besar, dan memberkati engkau serta membuat namamu masyhur; dan engkau akan menjadi berkat."
 },
 {
   "id": 302,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 3,
   "firman": "Aku akan memberkati orang-orang yang memberkati engkau, dan mengutuk orang-orang yang mengutuk engkau, dan olehmu semua kaum di muka bumi akan mendapat berkat.\""
 },
 {
   "id": 303,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 4,
   "firman": "Lalu pergilah Abram seperti yang difirmankan TUHAN kepadanya, dan Lotpun ikut bersama-sama dengan dia; Abram berumur tujuh puluh lima tahun, ketika ia berangkat dari Haran."
 },
 {
   "id": 304,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 5,
   "firman": "Abram membawa Sarai, isterinya, dan Lot, anak saudaranya, dan segala harta benda yang didapat mereka dan orang-orang yang diperoleh mereka di Haran; mereka berangkat ke tanah Kanaan, lalu sampai di situ."
 },
 {
   "id": 305,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 6,
   "firman": "Abram berjalan melalui negeri itu sampai ke suatu tempat dekat Sikhem, yakni pohon tarbantin di More. Waktu itu orang Kanaan diam di negeri itu."
 },
 {
   "id": 306,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 7,
   "firman": "Ketika itu TUHAN menampakkan diri kepada Abram dan berfirman: \"Aku akan memberikan negeri ini kepada keturunanmu.\" Maka didirikannya di situ mezbah bagi TUHAN yang telah menampakkan diri kepadanya."
 },
 {
   "id": 307,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 8,
   "firman": "Kemudian ia pindah dari situ ke pegunungan di sebelah timur Betel. Ia memasang kemahnya dengan Betel di sebelah barat dan Ai di sebelah timur, lalu ia mendirikan di situ mezbah bagi TUHAN dan memanggil nama TUHAN."
 },
 {
   "id": 308,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 9,
   "firman": "Sesudah itu Abram berangkat dan makin jauh ia berjalan ke Tanah Negeb."
 },
 {
   "id": 309,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 10,
   "firman": "Ketika kelaparan timbul di negeri itu, pergilah Abram ke Mesir untuk tinggal di situ sebagai orang asing, sebab hebat kelaparan di negeri itu."
 },
 {
   "id": 310,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 11,
   "firman": "Pada waktu ia akan masuk ke Mesir, berkatalah ia kepada Sarai, isterinya: \"Memang aku tahu, bahwa engkau adalah seorang perempuan yang cantik parasnya."
 },
 {
   "id": 311,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 12,
   "firman": "Apabila orang Mesir melihat engkau, mereka akan berkata: Itu isterinya. Jadi mereka akan membunuh aku dan membiarkan engkau hidup."
 },
 {
   "id": 312,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 13,
   "firman": "Katakanlah, bahwa engkau adikku, supaya aku diperlakukan mereka dengan baik karena engkau, dan aku dibiarkan hidup oleh sebab engkau.\""
 },
 {
   "id": 313,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 14,
   "firman": "Sesudah Abram masuk ke Mesir, orang Mesir itu melihat, bahwa perempuan itu sangat cantik,"
 },
 {
   "id": 314,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 15,
   "firman": "dan ketika punggawa-punggawa Firaun melihat Sarai, mereka memuji-mujinya di hadapan Firaun, sehingga perempuan itu dibawa ke istananya."
 },
 {
   "id": 315,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 16,
   "firman": "Firaun menyambut Abram dengan baik-baik, karena ia mengingini perempuan itu, dan Abram mendapat kambing domba, lembu sapi, keledai jantan, budak laki-laki dan perempuan, keledai betina dan unta."
 },
 {
   "id": 316,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 17,
   "firman": "Tetapi TUHAN menimpakan tulah yang hebat kepada Firaun, demikian juga kepada seisi istananya, karena Sarai, isteri Abram itu."
 },
 {
   "id": 317,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 18,
   "firman": "Lalu Firaun memanggil Abram serta berkata: \"Apakah yang kauperbuat ini terhadap aku? Mengapa tidak kauberitahukan, bahwa ia isterimu?"
 },
 {
   "id": 318,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 19,
   "firman": "Mengapa engkau katakan: dia adikku, sehingga aku mengambilnya menjadi isteriku? Sekarang, inilah isterimu, ambillah dan pergilah!\""
 },
 {
   "id": 319,
   "kitab": "Kej",
   "pasal": 12,
   "ayat": 20,
   "firman": "Lalu Firaun memerintahkan beberapa orang untuk mengantarkan Abram pergi, bersama-sama dengan isterinya dan segala kepunyaannya."
 },
 {
   "id": 320,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 1,
   "firman": "Maka pergilah Abram dari Mesir ke Tanah Negeb dengan isterinya dan segala kepunyaannya, dan Lotpun bersama-sama dengan dia."
 },
 {
   "id": 321,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 2,
   "firman": "Adapun Abram sangat kaya, banyak ternak, perak dan emasnya."
 },
 {
   "id": 322,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 3,
   "firman": "Ia berjalan dari tempat persinggahan ke tempat persinggahan, dari Tanah Negeb sampai dekat Betel, di mana kemahnya mula-mula berdiri, antara Betel dan Ai,"
 },
 {
   "id": 323,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 4,
   "firman": "ke tempat mezbah yang dibuatnya dahulu di sana; di situlah Abram memanggil nama TUHAN."
 },
 {
   "id": 324,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 5,
   "firman": "Juga Lot, yang ikut bersama-sama dengan Abram, mempunyai domba dan lembu dan kemah."
 },
 {
   "id": 325,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 6,
   "firman": "Tetapi negeri itu tidak cukup luas bagi mereka untuk diam bersama-sama, sebab harta milik mereka amat banyak, sehingga mereka tidak dapat diam bersama-sama."
 },
 {
   "id": 326,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 7,
   "firman": "Karena itu terjadilah perkelahian antara para gembala Abram dan para gembala Lot. Waktu itu orang Kanaan dan orang Feris diam di negeri itu."
 },
 {
   "id": 327,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 8,
   "firman": "Maka berkatalah Abram kepada Lot: \"Janganlah kiranya ada perkelahian antara aku dan engkau, dan antara para gembalaku dan para gembalamu, sebab kita ini kerabat."
 },
 {
   "id": 328,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 9,
   "firman": "Bukankah seluruh negeri ini terbuka untuk engkau? Baiklah pisahkan dirimu dari padaku; jika engkau ke kiri, maka aku ke kanan, jika engkau ke kanan, maka aku ke kiri.\""
 },
 {
   "id": 329,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 10,
   "firman": "Lalu Lot melayangkan pandangnya dan dilihatnyalah, bahwa seluruh Lembah Yordan banyak airnya, seperti taman TUHAN, seperti tanah Mesir, sampai ke Zoar. --Hal itu terjadi sebelum TUHAN memusnahkan Sodom dan Gomora. --"
 },
 {
   "id": 330,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 11,
   "firman": "Sebab itu Lot memilih baginya seluruh Lembah Yordan itu, lalu ia berangkat ke sebelah timur dan mereka berpisah."
 },
 {
   "id": 331,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 12,
   "firman": "Abram menetap di tanah Kanaan, tetapi Lot menetap di kota-kota Lembah Yordan dan berkemah di dekat Sodom."
 },
 {
   "id": 332,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 13,
   "firman": "Adapun orang Sodom sangat jahat dan berdosa terhadap TUHAN."
 },
 {
   "id": 333,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 14,
   "firman": "Setelah Lot berpisah dari pada Abram, berfirmanlah TUHAN kepada Abram: \"Pandanglah sekelilingmu dan lihatlah dari tempat engkau berdiri itu ke timur dan barat, utara dan selatan,"
 },
 {
   "id": 334,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 15,
   "firman": "sebab seluruh negeri yang kaulihat itu akan Kuberikan kepadamu dan kepada keturunanmu untuk selama-lamanya."
 },
 {
   "id": 335,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 16,
   "firman": "Dan Aku akan menjadikan keturunanmu seperti debu tanah banyaknya, sehingga, jika seandainya ada yang dapat menghitung debu tanah, keturunanmupun akan dapat dihitung juga."
 },
 {
   "id": 336,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 17,
   "firman": "Bersiaplah, jalanilah negeri itu menurut panjang dan lebarnya, sebab kepadamulah akan Kuberikan negeri itu.\""
 },
 {
   "id": 337,
   "kitab": "Kej",
   "pasal": 13,
   "ayat": 18,
   "firman": "Sesudah itu Abram memindahkan kemahnya dan menetap di dekat pohon-pohon tarbantin di Mamre, dekat Hebron, lalu didirikannyalah mezbah di situ bagi TUHAN."
 },
 {
   "id": 338,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 1,
   "firman": "Pada zaman Amrafel, raja Sinear, Ariokh, raja Elasar, Kedorlaomer, raja Elam, dan Tideal, raja Goyim, terjadilah,"
 },
 {
   "id": 339,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 2,
   "firman": "bahwa raja-raja ini berperang melawan Bera, raja Sodom, Birsya, raja Gomora, Syinab, raja Adma, Syemeber, raja Zeboim dan raja negeri Bela, yakni negeri Zoar."
 },
 {
   "id": 340,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 3,
   "firman": "Raja-raja yang disebut terakhir ini semuanya bersekutu dan datang ke lembah Sidim, yakni Laut Asin."
 },
 {
   "id": 341,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 4,
   "firman": "Dua belas tahun lamanya mereka takluk kepada Kedorlaomer, tetapi dalam tahun yang ketiga belas mereka memberontak."
 },
 {
   "id": 342,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 5,
   "firman": "Dalam tahun yang keempat belas datanglah Kedorlaomer serta raja-raja yang bersama-sama dengan dia, lalu mereka mengalahkan orang Refaim di Asyterot-Karnaim, orang Zuzim di Ham, orang Emim di Syawe-Kiryataim"
 },
 {
   "id": 343,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 6,
   "firman": "dan orang Hori di pegunungan mereka yang bernama Seir, sampai ke El-Paran di tepi padang gurun."
 },
 {
   "id": 344,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 7,
   "firman": "Sesudah itu baliklah mereka dan sampai ke En-Mispat, yakni Kadesh, dan mengalahkan seluruh daerah orang Amalek, dan juga orang Amori, yang diam di Hazezon-Tamar."
 },
 {
   "id": 345,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 8,
   "firman": "Lalu keluarlah raja negeri Sodom, raja negeri Gomora, raja negeri Adma, raja negeri Zeboim dan raja negeri Bela, yakni negeri Zoar, dan mengatur barisan perangnya melawan mereka di lembah Sidim,"
 },
 {
   "id": 346,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 9,
   "firman": "melawan Kedorlaomer, raja Elam, Tideal, raja Goyim, Amrafel, raja Sinear, dan Ariokh, raja Elasar, empat raja lawan lima."
 },
 {
   "id": 347,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 10,
   "firman": "Di lembah Sidim itu di mana-mana ada sumur aspal. Ketika raja Sodom dan raja Gomora melarikan diri, jatuhlah mereka ke dalamnya, dan orang-orang yang masih tinggal hidup melarikan diri ke pegunungan."
 },
 {
   "id": 348,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 11,
   "firman": "Segala harta benda Sodom dan Gomora beserta segala bahan makanan dirampas musuh, lalu mereka pergi."
 },
 {
   "id": 349,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 12,
   "firman": "Juga Lot, anak saudara Abram, beserta harta bendanya, dibawa musuh, lalu mereka pergi--sebab Lot itu diam di Sodom."
 },
 {
   "id": 350,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 13,
   "firman": "Kemudian datanglah seorang pelarian dan menceritakan hal ini kepada Abram, orang Ibrani itu, yang tinggal dekat pohon-pohon tarbantin kepunyaan Mamre, orang Amori itu, saudara Eskol dan Aner, yakni teman-teman sekutu Abram."
 },
 {
   "id": 351,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 14,
   "firman": "Ketika Abram mendengar, bahwa anak saudaranya tertawan, maka dikerahkannyalah orang-orangnya yang terlatih, yakni mereka yang lahir di rumahnya, tiga ratus delapan belas orang banyaknya, lalu mengejar musuh sampai ke Dan."
 },
 {
   "id": 352,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 15,
   "firman": "Dan pada waktu malam berbagilah mereka, ia dan hamba-hambanya itu, untuk melawan musuh; mereka mengalahkan dan mengejar musuh sampai ke Hoba di sebelah utara Damsyik."
 },
 {
   "id": 353,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dibawanyalah kembali segala harta benda itu; juga Lot, anak saudaranya itu, serta harta bendanya dibawanya kembali, demikian juga perempuan-perempuan dan orang-orangnya."
 },
 {
   "id": 354,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 17,
   "firman": "Setelah Abram kembali dari mengalahkan Kedorlaomer dan para raja yang bersama-sama dengan dia, maka keluarlah raja Sodom menyongsong dia ke lembah Syawe, yakni Lembah Raja."
 },
 {
   "id": 355,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 18,
   "firman": "Melkisedek, raja Salem, membawa roti dan anggur; ia seorang imam Allah Yang Mahatinggi."
 },
 {
   "id": 356,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 19,
   "firman": "Lalu ia memberkati Abram, katanya: \"Diberkatilah kiranya Abram oleh Allah Yang Mahatinggi, Pencipta langit dan bumi,"
 },
 {
   "id": 357,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 20,
   "firman": "dan terpujilah Allah Yang Mahatinggi, yang telah menyerahkan musuhmu ke tanganmu.\" Lalu Abram memberikan kepadanya sepersepuluh dari semuanya."
 },
 {
   "id": 358,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 21,
   "firman": "Berkatalah raja Sodom itu kepada Abram: \"Berikanlah kepadaku orang-orang itu, dan ambillah untukmu harta benda itu.\""
 },
 {
   "id": 359,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 22,
   "firman": "Tetapi kata Abram kepada raja negeri Sodom itu: \"Aku bersumpah demi TUHAN, Allah Yang Mahatinggi, Pencipta langit dan bumi:"
 },
 {
   "id": 360,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 23,
   "firman": "Aku tidak akan mengambil apa-apa dari kepunyaanmu itu, sepotong benang atau tali kasutpun tidak, supaya engkau jangan dapat berkata: Aku telah membuat Abram menjadi kaya."
 },
 {
   "id": 361,
   "kitab": "Kej",
   "pasal": 14,
   "ayat": 24,
   "firman": "Kalau aku, jangan sekali-kali! Hanya apa yang telah dimakan oleh bujang-bujang ini dan juga bagian orang-orang yang pergi bersama-sama dengan aku, yakni Aner, Eskol dan Mamre, biarlah mereka itu mengambil bagiannya masing-masing.\""
 },
 {
   "id": 362,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 1,
   "firman": "Kemudian datanglah firman TUHAN kepada Abram dalam suatu penglihatan: \"Janganlah takut, Abram, Akulah perisaimu; upahmu akan sangat besar.\""
 },
 {
   "id": 363,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 2,
   "firman": "Abram menjawab: \"Ya Tuhan ALLAH, apakah yang akan Engkau berikan kepadaku, karena aku akan meninggal dengan tidak mempunyai anak, dan yang akan mewarisi rumahku ialah Eliezer, orang Damsyik itu.\""
 },
 {
   "id": 364,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 3,
   "firman": "Lagi kata Abram: \"Engkau tidak memberikan kepadaku keturunan, sehingga seorang hambaku nanti menjadi ahli warisku.\""
 },
 {
   "id": 365,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 4,
   "firman": "Tetapi datanglah firman TUHAN kepadanya, demikian: \"Orang ini tidak akan menjadi ahli warismu, melainkan anak kandungmu, dialah yang akan menjadi ahli warismu.\""
 },
 {
   "id": 366,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 5,
   "firman": "Lalu TUHAN membawa Abram ke luar serta berfirman: \"Coba lihat ke langit, hitunglah bintang-bintang, jika engkau dapat menghitungnya.\" Maka firman-Nya kepadanya: \"Demikianlah banyaknya nanti keturunanmu.\""
 },
 {
   "id": 367,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 6,
   "firman": "Lalu percayalah Abram kepada TUHAN, maka TUHAN memperhitungkan hal itu kepadanya sebagai kebenaran."
 },
 {
   "id": 368,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 7,
   "firman": "Lagi firman TUHAN kepadanya: \"Akulah TUHAN, yang membawa engkau keluar dari Ur-Kasdim untuk memberikan negeri ini kepadamu menjadi milikmu.\""
 },
 {
   "id": 369,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 8,
   "firman": "Kata Abram: \"Ya Tuhan ALLAH, dari manakah aku tahu, bahwa aku akan memilikinya?\""
 },
 {
   "id": 370,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 9,
   "firman": "Firman TUHAN kepadanya: \"Ambillah bagi-Ku seekor lembu betina berumur tiga tahun, seekor kambing betina berumur tiga tahun, seekor domba jantan berumur tiga tahun, seekor burung tekukur dan seekor anak burung merpati.\""
 },
 {
   "id": 371,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 10,
   "firman": "Diambilnyalah semuanya itu bagi TUHAN, dipotong dua, lalu diletakkannya bagian-bagian itu yang satu di samping yang lain, tetapi burung-burung itu tidak dipotong dua."
 },
 {
   "id": 372,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 11,
   "firman": "Ketika burung-burung buas hinggap pada daging binatang-binatang itu, maka Abram mengusirnya."
 },
 {
   "id": 373,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 12,
   "firman": "Menjelang matahari terbenam, tertidurlah Abram dengan nyenyak. Lalu turunlah meliputinya gelap gulita yang mengerikan."
 },
 {
   "id": 374,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 13,
   "firman": "Firman TUHAN kepada Abram: \"Ketahuilah dengan sesungguhnya bahwa keturunanmu akan menjadi orang asing dalam suatu negeri, yang bukan kepunyaan mereka, dan bahwa mereka akan diperbudak dan dianiaya, empat ratus tahun lamanya."
 },
 {
   "id": 375,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 14,
   "firman": "Tetapi bangsa yang akan memperbudak mereka, akan Kuhukum, dan sesudah itu mereka akan keluar dengan membawa harta benda yang banyak."
 },
 {
   "id": 376,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 15,
   "firman": "Tetapi engkau akan pergi kepada nenek moyangmu dengan sejahtera; engkau akan dikuburkan pada waktu telah putih rambutmu."
 },
 {
   "id": 377,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 16,
   "firman": "Tetapi keturunan yang keempat akan kembali ke sini, sebab sebelum itu kedurjanaan orang Amori itu belum genap.\""
 },
 {
   "id": 378,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 17,
   "firman": "Ketika matahari telah terbenam, dan hari menjadi gelap, maka kelihatanlah perapian yang berasap beserta suluh yang berapi lewat di antara potongan-potongan daging itu."
 },
 {
   "id": 379,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 18,
   "firman": "Pada hari itulah TUHAN mengadakan perjanjian dengan Abram serta berfirman: \"Kepada keturunanmulah Kuberikan negeri ini, mulai dari sungai Mesir sampai ke sungai yang besar itu, sungai Efrat:"
 },
 {
   "id": 380,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 19,
   "firman": "yakni tanah orang Keni, orang Kenas, orang Kadmon,"
 },
 {
   "id": 381,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 20,
   "firman": "orang Het, orang Feris, orang Refaim,"
 },
 {
   "id": 382,
   "kitab": "Kej",
   "pasal": 15,
   "ayat": 21,
   "firman": "orang Amori, orang Kanaan, orang Girgasi dan orang Yebus itu.\""
 },
 {
   "id": 383,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 1,
   "firman": "Adapun Sarai, isteri Abram itu, tidak beranak. Ia mempunyai seorang hamba perempuan, orang Mesir, Hagar namanya."
 },
 {
   "id": 384,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 2,
   "firman": "Berkatalah Sarai kepada Abram: \"Engkau tahu, TUHAN tidak memberi aku melahirkan anak. Karena itu baiklah hampiri hambaku itu; mungkin oleh dialah aku dapat memperoleh seorang anak.\" Dan Abram mendengarkan perkataan Sarai."
 },
 {
   "id": 385,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 3,
   "firman": "Jadi Sarai, isteri Abram itu, mengambil Hagar, hambanya, orang Mesir itu, --yakni ketika Abram telah sepuluh tahun tinggal di tanah Kanaan--,lalu memberikannya kepada Abram, suaminya, untuk menjadi isterinya."
 },
 {
   "id": 386,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 4,
   "firman": "Abram menghampiri Hagar, lalu mengandunglah perempuan itu. Ketika Hagar tahu, bahwa ia mengandung, maka ia memandang rendah akan nyonyanya itu."
 },
 {
   "id": 387,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 5,
   "firman": "Lalu berkatalah Sarai kepada Abram: \"Penghinaan yang kuderita ini adalah tanggung jawabmu; akulah yang memberikan hambaku ke pangkuanmu, tetapi baru saja ia tahu, bahwa ia mengandung, ia memandang rendah akan aku; TUHAN kiranya yang menjadi Hakim antara aku dan engkau.\""
 },
 {
   "id": 388,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 6,
   "firman": "Kata Abram kepada Sarai: \"Hambamu itu di bawah kekuasaanmu; perbuatlah kepadanya apa yang kaupandang baik.\" Lalu Sarai menindas Hagar, sehingga ia lari meninggalkannya."
 },
 {
   "id": 389,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 7,
   "firman": "Lalu Malaikat TUHAN menjumpainya dekat suatu mata air di padang gurun, yakni dekat mata air di jalan ke Syur."
 },
 {
   "id": 390,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 8,
   "firman": "Katanya: \"Hagar, hamba Sarai, dari manakah datangmu dan ke manakah pergimu?\" Jawabnya: \"Aku lari meninggalkan Sarai, nyonyaku.\""
 },
 {
   "id": 391,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 9,
   "firman": "Lalu kata Malaikat TUHAN itu kepadanya: \"Kembalilah kepada nyonyamu, biarkanlah engkau ditindas di bawah kekuasaannya.\""
 },
 {
   "id": 392,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 10,
   "firman": "Lagi kata Malaikat TUHAN itu kepadanya: \"Aku akan membuat sangat banyak keturunanmu, sehingga tidak dapat dihitung karena banyaknya.\""
 },
 {
   "id": 393,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 11,
   "firman": "Selanjutnya kata Malaikat TUHAN itu kepadanya: \"Engkau mengandung dan akan melahirkan seorang anak laki-laki dan akan menamainya Ismael, sebab TUHAN telah mendengar tentang penindasan atasmu itu."
 },
 {
   "id": 394,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 12,
   "firman": "Seorang laki-laki yang lakunya seperti keledai liar, demikianlah nanti anak itu; tangannya akan melawan tiap-tiap orang dan tangan tiap-tiap orang akan melawan dia, dan di tempat kediamannya ia akan menentang semua saudaranya.\""
 },
 {
   "id": 395,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 13,
   "firman": "Kemudian Hagar menamakan TUHAN yang telah berfirman kepadanya itu dengan sebutan: \"Engkaulah El-Roi.\" Sebab katanya: \"Bukankah di sini kulihat Dia yang telah melihat aku?\""
 },
 {
   "id": 396,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 14,
   "firman": "Sebab itu sumur tadi disebutkan orang: sumur Lahai-Roi; letaknya antara Kadesh dan Bered."
 },
 {
   "id": 397,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu Hagar melahirkan seorang anak laki-laki bagi Abram dan Abram menamai anak yang dilahirkan Hagar itu Ismael."
 },
 {
   "id": 398,
   "kitab": "Kej",
   "pasal": 16,
   "ayat": 16,
   "firman": "Abram berumur delapan puluh enam tahun, ketika Hagar melahirkan Ismael baginya."
 },
 {
   "id": 399,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 1,
   "firman": "Ketika Abram berumur sembilan puluh sembilan tahun, maka TUHAN menampakkan diri kepada Abram dan berfirman kepadanya: \"Akulah Allah Yang Mahakuasa, hiduplah di hadapan-Ku dengan tidak bercela."
 },
 {
   "id": 400,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 2,
   "firman": "Aku akan mengadakan perjanjian antara Aku dan engkau, dan Aku akan membuat engkau sangat banyak.\""
 },
 {
   "id": 401,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 3,
   "firman": "Lalu sujudlah Abram, dan Allah berfirman kepadanya:"
 },
 {
   "id": 402,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 4,
   "firman": "\"Dari pihak-Ku, inilah perjanjian-Ku dengan engkau: Engkau akan menjadi bapa sejumlah besar bangsa."
 },
 {
   "id": 403,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 5,
   "firman": "Karena itu namamu bukan lagi Abram, melainkan Abraham, karena engkau telah Kutetapkan menjadi bapa sejumlah besar bangsa."
 },
 {
   "id": 404,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 6,
   "firman": "Aku akan membuat engkau beranak cucu sangat banyak; engkau akan Kubuat menjadi bangsa-bangsa, dan dari padamu akan berasal raja-raja."
 },
 {
   "id": 405,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 7,
   "firman": "Aku akan mengadakan perjanjian antara Aku dan engkau serta keturunanmu turun-temurun menjadi perjanjian yang kekal, supaya Aku menjadi Allahmu dan Allah keturunanmu."
 },
 {
   "id": 406,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 8,
   "firman": "Kepadamu dan kepada keturunanmu akan Kuberikan negeri ini yang kaudiami sebagai orang asing, yakni seluruh tanah Kanaan akan Kuberikan menjadi milikmu untuk selama-lamanya; dan Aku akan menjadi Allah mereka.\""
 },
 {
   "id": 407,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 9,
   "firman": "Lagi firman Allah kepada Abraham: \"Dari pihakmu, engkau harus memegang perjanjian-Ku, engkau dan keturunanmu turun-temurun."
 },
 {
   "id": 408,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 10,
   "firman": "Inilah perjanjian-Ku, yang harus kamu pegang, perjanjian antara Aku dan kamu serta keturunanmu, yaitu setiap laki-laki di antara kamu harus disunat;"
 },
 {
   "id": 409,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 11,
   "firman": "haruslah dikerat kulit khatanmu dan itulah akan menjadi tanda perjanjian antara Aku dan kamu."
 },
 {
   "id": 410,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 12,
   "firman": "Anak yang berumur delapan hari haruslah disunat, yakni setiap laki-laki di antara kamu, turun-temurun: baik yang lahir di rumahmu, maupun yang dibeli dengan uang dari salah seorang asing, tetapi tidak termasuk keturunanmu."
 },
 {
   "id": 411,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 13,
   "firman": "Orang yang lahir di rumahmu dan orang yang engkau beli dengan uang harus disunat; maka dalam dagingmulah perjanjian-Ku itu menjadi perjanjian yang kekal."
 },
 {
   "id": 412,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 14,
   "firman": "Dan orang yang tidak disunat, yakni laki-laki yang tidak dikerat kulit khatannya, maka orang itu harus dilenyapkan dari antara orang-orang sebangsanya: ia telah mengingkari perjanjian-Ku.\""
 },
 {
   "id": 413,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 15,
   "firman": "Selanjutnya Allah berfirman kepada Abraham: \"Tentang isterimu Sarai, janganlah engkau menyebut dia lagi Sarai, tetapi Sara, itulah namanya."
 },
 {
   "id": 414,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 16,
   "firman": "Aku akan memberkatinya, dan dari padanya juga Aku akan memberikan kepadamu seorang anak laki-laki, bahkan Aku akan memberkatinya, sehingga ia menjadi ibu bangsa-bangsa; raja-raja bangsa-bangsa akan lahir dari padanya.\""
 },
 {
   "id": 415,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 17,
   "firman": "Lalu tertunduklah Abraham dan tertawa serta berkata dalam hatinya: \"Mungkinkah bagi seorang yang berumur seratus tahun dilahirkan seorang anak dan mungkinkah Sara, yang telah berumur sembilan puluh tahun itu melahirkan seorang anak?\""
 },
 {
   "id": 416,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 18,
   "firman": "Dan Abraham berkata kepada Allah: \"Ah, sekiranya Ismael diperkenankan hidup di hadapan-Mu!\""
 },
 {
   "id": 417,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 19,
   "firman": "Tetapi Allah berfirman: \"Tidak, melainkan isterimu Saralah yang akan melahirkan anak laki-laki bagimu, dan engkau akan menamai dia Ishak, dan Aku akan mengadakan perjanjian-Ku dengan dia menjadi perjanjian yang kekal untuk keturunannya."
 },
 {
   "id": 418,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 20,
   "firman": "Tentang Ismael, Aku telah mendengarkan permintaanmu; ia akan Kuberkati, Kubuat beranak cucu dan sangat banyak; ia akan memperanakkan dua belas raja, dan Aku akan membuatnya menjadi bangsa yang besar."
 },
 {
   "id": 419,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 21,
   "firman": "Tetapi perjanjian-Ku akan Kuadakan dengan Ishak, yang akan dilahirkan Sara bagimu tahun yang akan datang pada waktu seperti ini juga.\""
 },
 {
   "id": 420,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 22,
   "firman": "Setelah selesai berfirman kepada Abraham, naiklah Allah meninggalkan Abraham."
 },
 {
   "id": 421,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 23,
   "firman": "Setelah itu Abraham memanggil Ismael, anaknya, dan semua orang yang lahir di rumahnya, juga semua orang yang dibelinya dengan uang, yakni setiap laki-laki dari isi rumahnya, lalu ia mengerat kulit khatan mereka pada hari itu juga, seperti yang telah difirmankan Allah kepadanya."
 },
 {
   "id": 422,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 24,
   "firman": "Abraham berumur sembilan puluh sembilan tahun ketika dikerat kulit khatannya."
 },
 {
   "id": 423,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 25,
   "firman": "Dan Ismael, anaknya, berumur tiga belas tahun ketika dikerat kulit khatannya."
 },
 {
   "id": 424,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 26,
   "firman": "Pada hari itu juga Abraham dan Ismael, anaknya, disunat."
 },
 {
   "id": 425,
   "kitab": "Kej",
   "pasal": 17,
   "ayat": 27,
   "firman": "Dan semua orang dari isi rumah Abraham, baik yang lahir di rumahnya, maupun yang dibeli dengan uang dari orang asing, disunat bersama-sama dengan dia."
 },
 {
   "id": 426,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 1,
   "firman": "Kemudian TUHAN menampakkan diri kepada Abraham dekat pohon tarbantin di Mamre, sedang ia duduk di pintu kemahnya waktu hari panas terik."
 },
 {
   "id": 427,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 2,
   "firman": "Ketika ia mengangkat mukanya, ia melihat tiga orang berdiri di depannya. Sesudah dilihatnya mereka, ia berlari dari pintu kemahnya menyongsong mereka, lalu sujudlah ia sampai ke tanah,"
 },
 {
   "id": 428,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 3,
   "firman": "serta berkata: \"Tuanku, jika aku telah mendapat kasih tuanku, janganlah kiranya lampaui hambamu ini."
 },
 {
   "id": 429,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 4,
   "firman": "Biarlah diambil air sedikit, basuhlah kakimu dan duduklah beristirahat di bawah pohon ini;"
 },
 {
   "id": 430,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 5,
   "firman": "biarlah kuambil sepotong roti, supaya tuan-tuan segar kembali; kemudian bolehlah tuan-tuan meneruskan perjalanannya; sebab tuan-tuan telah datang ke tempat hambamu ini.\" Jawab mereka: \"Perbuatlah seperti yang kaukatakan itu.\""
 },
 {
   "id": 431,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 6,
   "firman": "Lalu Abraham segera pergi ke kemah mendapatkan Sara serta berkata: \"Segeralah! Ambil tiga sukat tepung yang terbaik! Remaslah itu dan buatlah roti bundar!\""
 },
 {
   "id": 432,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 7,
   "firman": "Lalu berlarilah Abraham kepada lembu sapinya, ia mengambil seekor anak lembu yang empuk dan baik dagingnya dan memberikannya kepada seorang bujangnya, lalu orang ini segera mengolahnya."
 },
 {
   "id": 433,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 8,
   "firman": "Kemudian diambilnya dadih dan susu serta anak lembu yang telah diolah itu, lalu dihidangkannya di depan orang-orang itu; dan ia berdiri di dekat mereka di bawah pohon itu, sedang mereka makan."
 },
 {
   "id": 434,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 9,
   "firman": "Lalu kata mereka kepadanya: \"Di manakah Sara, isterimu?\" Jawabnya: \"Di sana, di dalam kemah.\""
 },
 {
   "id": 435,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 10,
   "firman": "Dan firman-Nya: \"Sesungguhnya Aku akan kembali tahun depan mendapatkan engkau, pada waktu itulah Sara, isterimu, akan mempunyai seorang anak laki-laki.\" Dan Sara mendengarkan pada pintu kemah yang di belakang-Nya."
 },
 {
   "id": 436,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 11,
   "firman": "Adapun Abraham dan Sara telah tua dan lanjut umurnya dan Sara telah mati haid."
 },
 {
   "id": 437,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 12,
   "firman": "Jadi tertawalah Sara dalam hatinya, katanya: \"Akan berahikah aku, setelah aku sudah layu, sedangkan tuanku sudah tua?\""
 },
 {
   "id": 438,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 13,
   "firman": "Lalu berfirmanlah TUHAN kepada Abraham: \"Mengapakah Sara tertawa dan berkata: Sungguhkah aku akan melahirkan anak, sedangkan aku telah tua?"
 },
 {
   "id": 439,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 14,
   "firman": "Adakah sesuatu apapun yang mustahil untuk TUHAN? Pada waktu yang telah ditetapkan itu, tahun depan, Aku akan kembali mendapatkan engkau, pada waktu itulah Sara mempunyai seorang anak laki-laki.\""
 },
 {
   "id": 440,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 15,
   "firman": "Lalu Sara menyangkal, katanya: \"Aku tidak tertawa,\" sebab ia takut; tetapi TUHAN berfirman: \"Tidak, memang engkau tertawa!\""
 },
 {
   "id": 441,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 16,
   "firman": "Lalu berangkatlah orang-orang itu dari situ dan memandang ke arah Sodom; dan Abraham berjalan bersama-sama dengan mereka untuk mengantarkan mereka."
 },
 {
   "id": 442,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 17,
   "firman": "Berpikirlah TUHAN: \"Apakah Aku akan menyembunyikan kepada Abraham apa yang hendak Kulakukan ini?"
 },
 {
   "id": 443,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 18,
   "firman": "Bukankah sesungguhnya Abraham akan menjadi bangsa yang besar serta berkuasa, dan oleh dia segala bangsa di atas bumi akan mendapat berkat?"
 },
 {
   "id": 444,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 19,
   "firman": "Sebab Aku telah memilih dia, supaya diperintahkannya kepada anak-anaknya dan kepada keturunannya supaya tetap hidup menurut jalan yang ditunjukkan TUHAN, dengan melakukan kebenaran dan keadilan, dan supaya TUHAN memenuhi kepada Abraham apa yang dijanjikan-Nya kepadanya.\""
 },
 {
   "id": 445,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 20,
   "firman": "Sesudah itu berfirmanlah TUHAN: \"Sesungguhnya banyak keluh kesah orang tentang Sodom dan Gomora dan sesungguhnya sangat berat dosanya."
 },
 {
   "id": 446,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 21,
   "firman": "Baiklah Aku turun untuk melihat, apakah benar-benar mereka telah berkelakuan seperti keluh kesah orang yang telah sampai kepada-Ku atau tidak; Aku hendak mengetahuinya.\""
 },
 {
   "id": 447,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 22,
   "firman": "Lalu berpalinglah orang-orang itu dari situ dan berjalan ke Sodom, tetapi Abraham masih tetap berdiri di hadapan TUHAN."
 },
 {
   "id": 448,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 23,
   "firman": "Abraham datang mendekat dan berkata: \"Apakah Engkau akan melenyapkan orang benar bersama-sama dengan orang fasik?"
 },
 {
   "id": 449,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 24,
   "firman": "Bagaimana sekiranya ada lima puluh orang benar dalam kota itu? Apakah Engkau akan melenyapkan tempat itu dan tidakkah Engkau mengampuninya karena kelima puluh orang benar yang ada di dalamnya itu?"
 },
 {
   "id": 450,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 25,
   "firman": "Jauhlah kiranya dari pada-Mu untuk berbuat demikian, membunuh orang benar bersama-sama dengan orang fasik, sehingga orang benar itu seolah-olah sama dengan orang fasik! Jauhlah kiranya yang demikian dari pada-Mu! Masakan Hakim segenap bumi tidak menghukum dengan adil?\""
 },
 {
   "id": 451,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 26,
   "firman": "TUHAN berfirman: \"Jika Kudapati lima puluh orang benar dalam kota Sodom, Aku akan mengampuni seluruh tempat itu karena mereka.\""
 },
 {
   "id": 452,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 27,
   "firman": "Abraham menyahut: \"Sesungguhnya aku telah memberanikan diri berkata kepada Tuhan, walaupun aku debu dan abu."
 },
 {
   "id": 453,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 28,
   "firman": "Sekiranya kurang lima orang dari kelima puluh orang benar itu, apakah Engkau akan memusnahkan seluruh kota itu karena yang lima itu?\" Firman-Nya: \"Aku tidak memusnahkannya, jika Kudapati empat puluh lima di sana.\""
 },
 {
   "id": 454,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 29,
   "firman": "Lagi Abraham melanjutkan perkataannya kepada-Nya: \"Sekiranya empat puluh didapati di sana?\" Firman-Nya: \"Aku tidak akan berbuat demikian karena yang empat puluh itu.\""
 },
 {
   "id": 455,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 30,
   "firman": "Katanya: \"Janganlah kiranya Tuhan murka, kalau aku berkata sekali lagi. Sekiranya tiga puluh didapati di sana?\" Firman-Nya: \"Aku tidak akan berbuat demikian, jika Kudapati tiga puluh di sana.\""
 },
 {
   "id": 456,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 31,
   "firman": "Katanya: \"Sesungguhnya aku telah memberanikan diri berkata kepada Tuhan. Sekiranya dua puluh didapati di sana?\" Firman-Nya: \"Aku tidak akan memusnahkannya karena yang dua puluh itu.\""
 },
 {
   "id": 457,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 32,
   "firman": "Katanya: \"Janganlah kiranya Tuhan murka, kalau aku berkata lagi sekali ini saja. Sekiranya sepuluh didapati di sana?\" Firman-Nya: \"Aku tidak akan memusnahkannya karena yang sepuluh itu.\""
 },
 {
   "id": 458,
   "kitab": "Kej",
   "pasal": 18,
   "ayat": 33,
   "firman": "Lalu pergilah TUHAN, setelah Ia selesai berfirman kepada Abraham; dan kembalilah Abraham ke tempat tinggalnya."
 },
 {
   "id": 459,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 1,
   "firman": "Kedua malaikat itu tiba di Sodom pada waktu petang. Lot sedang duduk di pintu gerbang Sodom dan ketika melihat mereka, bangunlah ia menyongsong mereka, lalu sujud dengan mukanya sampai ke tanah,"
 },
 {
   "id": 460,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 2,
   "firman": "serta berkata: \"Tuan-tuan, silakanlah singgah ke rumah hambamu ini, bermalamlah di sini dan basuhlah kakimu, maka besok pagi tuan-tuan boleh melanjutkan perjalanannya.\" Jawab mereka: \"Tidak, kami akan bermalam di tanah lapang.\""
 },
 {
   "id": 461,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 3,
   "firman": "Tetapi karena ia sangat mendesak mereka, singgahlah mereka dan masuk ke dalam rumahnya, kemudian ia menyediakan hidangan bagi mereka, ia membakar roti yang tidak beragi, lalu mereka makan."
 },
 {
   "id": 462,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 4,
   "firman": "Tetapi sebelum mereka tidur, orang-orang lelaki dari kota Sodom itu, dari yang muda sampai yang tua, bahkan seluruh kota, tidak ada yang terkecuali, datang mengepung rumah itu."
 },
 {
   "id": 463,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 5,
   "firman": "Mereka berseru kepada Lot: \"Di manakah orang-orang yang datang kepadamu malam ini? Bawalah mereka keluar kepada kami, supaya kami pakai mereka.\""
 },
 {
   "id": 464,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 6,
   "firman": "Lalu keluarlah Lot menemui mereka, ke depan pintu, tetapi pintu ditutupnya di belakangnya,"
 },
 {
   "id": 465,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 7,
   "firman": "dan ia berkata: \"Saudara-saudaraku, janganlah kiranya berbuat jahat."
 },
 {
   "id": 466,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 8,
   "firman": "Kamu tahu, aku mempunyai dua orang anak perempuan yang belum pernah dijamah laki-laki, baiklah mereka kubawa ke luar kepadamu; perbuatlah kepada mereka seperti yang kamu pandang baik; hanya jangan kamu apa-apakan orang-orang ini, sebab mereka memang datang untuk berlindung di dalam rumahku.\""
 },
 {
   "id": 467,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 9,
   "firman": "Tetapi mereka berkata: \"Enyahlah!\" Lagi kata mereka: \"Orang ini datang ke sini sebagai orang asing dan dia mau menjadi hakim atas kita! Sekarang kami akan menganiaya engkau lebih dari pada kedua orang itu!\" Lalu mereka mendesak orang itu, yaitu Lot, dengan keras, dan mereka mendekat untuk mendobrak pintu."
 },
 {
   "id": 468,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 10,
   "firman": "Tetapi kedua orang itu mengulurkan tangannya, menarik Lot masuk ke dalam rumah, lalu menutup pintu."
 },
 {
   "id": 469,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 11,
   "firman": "Dan mereka membutakan mata orang-orang yang di depan pintu rumah itu, dari yang kecil sampai yang besar, sehingga percumalah orang-orang itu mencari-cari pintu."
 },
 {
   "id": 470,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 12,
   "firman": "Lalu kedua orang itu berkata kepada Lot: \"Siapakah kaummu yang ada di sini lagi? Menantu atau anakmu laki-laki, anakmu perempuan, atau siapa saja kaummu di kota ini, bawalah mereka keluar dari tempat ini,"
 },
 {
   "id": 471,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 13,
   "firman": "sebab kami akan memusnahkan tempat ini, karena banyak keluh kesah orang tentang kota ini di hadapan TUHAN; sebab itulah TUHAN mengutus kami untuk memusnahkannya.\""
 },
 {
   "id": 472,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 14,
   "firman": "Keluarlah Lot, lalu berbicara dengan kedua bakal menantunya, yang akan kawin dengan kedua anaknya perempuan, katanya: \"Bangunlah, keluarlah dari tempat ini, sebab TUHAN akan memusnahkan kota ini.\" Tetapi ia dipandang oleh kedua bakal menantunya itu sebagai orang yang berolok-olok saja."
 },
 {
   "id": 473,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 15,
   "firman": "Ketika fajar telah menyingsing, kedua malaikat itu mendesak Lot, supaya bersegera, katanya: \"Bangunlah, bawalah isterimu dan kedua anakmu yang ada di sini, supaya engkau jangan mati lenyap karena kedurjanaan kota ini.\""
 },
 {
   "id": 474,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 16,
   "firman": "Ketika ia berlambat-lambat, maka tangannya, tangan isteri dan tangan kedua anaknya dipegang oleh kedua orang itu, sebab TUHAN hendak mengasihani dia; lalu kedua orang itu menuntunnya ke luar kota dan melepaskannya di sana."
 },
 {
   "id": 475,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 17,
   "firman": "Sesudah kedua orang itu menuntun mereka sampai ke luar, berkatalah seorang: \"Larilah, selamatkanlah nyawamu; janganlah menoleh ke belakang, dan janganlah berhenti di manapun juga di Lembah Yordan, larilah ke pegunungan, supaya engkau jangan mati lenyap.\""
 },
 {
   "id": 476,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 18,
   "firman": "Kata Lot kepada mereka: \"Janganlah kiranya demikian, tuanku."
 },
 {
   "id": 477,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 19,
   "firman": "Sungguhlah hambamu ini telah dikaruniai belas kasihan di hadapanmu, dan tuanku telah berbuat kemurahan besar kepadaku dengan memelihara hidupku, tetapi jika aku harus lari ke pegunungan, pastilah aku akan tersusul oleh bencana itu, sehingga matilah aku."
 },
 {
   "id": 478,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 20,
   "firman": "Sungguhlah kota yang di sana itu cukup dekat kiranya untuk lari ke sana; kota itu kecil; izinkanlah kiranya aku lari ke sana. Bukankah kota itu kecil? Jika demikian, nyawaku akan terpelihara.\""
 },
 {
   "id": 479,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 21,
   "firman": "Sahut malaikat itu kepadanya: \"Baiklah, dalam hal inipun permintaanmu akan kuterima dengan baik; yakni kota yang telah kau sebut itu tidak akan kutunggangbalikkan."
 },
 {
   "id": 480,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 22,
   "firman": "Cepatlah, larilah ke sana, sebab aku tidak dapat berbuat apa-apa, sebelum engkau sampai ke sana.\" Itulah sebabnya nama kota itu disebut Zoar."
 },
 {
   "id": 481,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 23,
   "firman": "Matahari telah terbit menyinari bumi, ketika Lot tiba di Zoar."
 },
 {
   "id": 482,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 24,
   "firman": "Kemudian TUHAN menurunkan hujan belerang dan api atas Sodom dan Gomora, berasal dari TUHAN, dari langit;"
 },
 {
   "id": 483,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 25,
   "firman": "dan ditunggangbalikkan-Nyalah kota-kota itu dan Lembah Yordan dan semua penduduk kota-kota serta tumbuh-tumbuhan di tanah."
 },
 {
   "id": 484,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 26,
   "firman": "Tetapi isteri Lot, yang berjalan mengikutnya, menoleh ke belakang, lalu menjadi tiang garam."
 },
 {
   "id": 485,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 27,
   "firman": "Ketika Abraham pagi-pagi pergi ke tempat ia berdiri di hadapan TUHAN itu,"
 },
 {
   "id": 486,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 28,
   "firman": "dan memandang ke arah Sodom dan Gomora serta ke seluruh tanah Lembah Yordan, maka dilihatnyalah asap dari bumi membubung ke atas sebagai asap dari dapur peleburan."
 },
 {
   "id": 487,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 29,
   "firman": "Demikianlah pada waktu Allah memusnahkan kota-kota di Lembah Yordan dan menunggangbalikkan kota-kota kediaman Lot, maka Allah ingat kepada Abraham, lalu dikeluarkan-Nyalah Lot dari tengah-tengah tempat yang ditunggangbalikkan itu."
 },
 {
   "id": 488,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 30,
   "firman": "Pergilah Lot dari Zoar dan ia menetap bersama-sama dengan kedua anaknya perempuan di pegunungan, sebab ia tidak berani tinggal di Zoar, maka diamlah ia dalam suatu gua beserta kedua anaknya."
 },
 {
   "id": 489,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 31,
   "firman": "Kata kakaknya kepada adiknya: \"Ayah kita telah tua, dan tidak ada laki-laki di negeri ini yang dapat menghampiri kita, seperti kebiasaan seluruh bumi."
 },
 {
   "id": 490,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 32,
   "firman": "Marilah kita beri ayah kita minum anggur, lalu kita tidur dengan dia, supaya kita menyambung keturunan dari ayah kita.\""
 },
 {
   "id": 491,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 33,
   "firman": "Pada malam itu mereka memberi ayah mereka minum anggur, lalu masuklah yang lebih tua untuk tidur dengan ayahnya; dan ayahnya itu tidak mengetahui ketika anaknya itu tidur dan ketika ia bangun."
 },
 {
   "id": 492,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 34,
   "firman": "Keesokan harinya berkatalah kakaknya kepada adiknya: \"Tadi malam aku telah tidur dengan ayah; baiklah malam ini juga kita beri dia minum anggur; masuklah engkau untuk tidur dengan dia, supaya kita menyambung keturunan dari ayah kita.\""
 },
 {
   "id": 493,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 35,
   "firman": "Demikianlah juga pada malam itu mereka memberi ayah mereka minum anggur, lalu bangunlah yang lebih muda untuk tidur dengan ayahnya; dan ayahnya itu tidak mengetahui ketika anaknya itu tidur dan ketika ia bangun."
 },
 {
   "id": 494,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 36,
   "firman": "Lalu mengandunglah kedua anak Lot itu dari ayah mereka."
 },
 {
   "id": 495,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 37,
   "firman": "Yang lebih tua melahirkan seorang anak laki-laki, dan menamainya Moab; dialah bapa orang Moab yang sekarang."
 },
 {
   "id": 496,
   "kitab": "Kej",
   "pasal": 19,
   "ayat": 38,
   "firman": "Yang lebih mudapun melahirkan seorang anak laki-laki, dan menamainya Ben-Ami; dialah bapa bani Amon yang sekarang."
 },
 {
   "id": 497,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 1,
   "firman": "Lalu Abraham berangkat dari situ ke Tanah Negeb dan ia menetap antara Kadesh dan Syur. Ia tinggal di Gerar sebagai orang asing."
 },
 {
   "id": 498,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 2,
   "firman": "Oleh karena Abraham telah mengatakan tentang Sara, isterinya: \"Dia saudaraku,\" maka Abimelekh, raja Gerar, menyuruh mengambil Sara."
 },
 {
   "id": 499,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 3,
   "firman": "Tetapi pada waktu malam Allah datang kepada Abimelekh dalam suatu mimpi serta berfirman kepadanya: \"Engkau harus mati oleh karena perempuan yang telah kauambil itu; sebab ia sudah bersuami.\""
 },
 {
   "id": 500,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 4,
   "firman": "Adapun Abimelekh belum menghampiri Sara. Berkatalah ia: \"Tuhan! Apakah Engkau membunuh bangsa yang tak bersalah?"
 },
 {
   "id": 501,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 5,
   "firman": "Bukankah orang itu sendiri mengatakan kepadaku: Dia saudaraku? Dan perempuan itu sendiri telah mengatakan: Ia saudaraku. Jadi hal ini kulakukan dengan hati yang tulus dan dengan tangan yang suci.\""
 },
 {
   "id": 502,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 6,
   "firman": "Lalu berfirmanlah Allah kepadanya dalam mimpi: \"Aku tahu juga, bahwa engkau telah melakukan hal itu dengan hati yang tulus, maka Akupun telah mencegah engkau untuk berbuat dosa terhadap Aku; sebab itu Aku tidak membiarkan engkau menjamah dia."
 },
 {
   "id": 503,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 7,
   "firman": "Jadi sekarang, kembalikanlah isteri orang itu, sebab dia seorang nabi; ia akan berdoa untuk engkau, maka engkau tetap hidup; tetapi jika engkau tidak mengembalikan dia, ketahuilah, engkau pasti mati, engkau dan semua orang yang bersama-sama dengan engkau.\""
 },
 {
   "id": 504,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 8,
   "firman": "Keesokan harinya pagi-pagi Abimelekh memanggil semua hambanya dan memberitahukan seluruh peristiwa itu kepada mereka, lalu sangat takutlah orang-orang itu."
 },
 {
   "id": 505,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 9,
   "firman": "Kemudian Abimelekh memanggil Abraham dan berkata kepadanya: \"Perbuatan apakah yang kaulakukan ini terhadap kami, dan kesalahan apakah yang kulakukan terhadap engkau, sehingga engkau mendatangkan dosa besar atas diriku dan kerajaanku? Engkau telah berbuat hal-hal yang tidak patut kepadaku.\""
 },
 {
   "id": 506,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 10,
   "firman": "Lagi kata Abimelekh kepada Abraham: \"Apakah maksudmu, maka engkau melakukan hal ini?\""
 },
 {
   "id": 507,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 11,
   "firman": "Lalu Abraham berkata: \"Aku berpikir: Takut akan Allah tidak ada di tempat ini; tentulah aku akan dibunuh karena isteriku."
 },
 {
   "id": 508,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 12,
   "firman": "Lagipula ia benar-benar saudaraku, anak ayahku, hanya bukan anak ibuku, tetapi kemudian ia menjadi isteriku."
 },
 {
   "id": 509,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 13,
   "firman": "Ketika Allah menyuruh aku mengembara keluar dari rumah ayahku, berkatalah aku kepada isteriku: Tunjukkanlah kasihmu kepadaku, yakni: katakanlah tentang aku di tiap-tiap tempat di mana kita tiba: Ia saudaraku.\""
 },
 {
   "id": 510,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 14,
   "firman": "Kemudian Abimelekh mengambil kambing domba dan lembu sapi, hamba laki-laki dan perempuan, lalu memberikan semuanya itu kepada Abraham; Sara, isteri Abraham, juga dikembalikannya kepadanya."
 },
 {
   "id": 511,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 15,
   "firman": "Dan Abimelekh berkata: \"Negeriku ini terbuka untuk engkau; menetaplah, di mana engkau suka.\""
 },
 {
   "id": 512,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 16,
   "firman": "Lalu katanya kepada Sara: \"Telah kuberikan kepada saudaramu seribu syikal perak, itulah bukti kesucianmu bagi semua orang yang bersama-sama dengan engkau. Maka dalam segala hal engkau dibenarkan.\""
 },
 {
   "id": 513,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 17,
   "firman": "Lalu Abraham berdoa kepada Allah, dan Allah menyembuhkan Abimelekh dan isterinya dan budak-budaknya perempuan, sehingga mereka melahirkan anak."
 },
 {
   "id": 514,
   "kitab": "Kej",
   "pasal": 20,
   "ayat": 18,
   "firman": "Sebab tadinya TUHAN telah menutup kandungan setiap perempuan di istana Abimelekh karena Sara, isteri Abraham itu."
 },
 {
   "id": 515,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 1,
   "firman": "TUHAN memperhatikan Sara, seperti yang difirmankan-Nya, dan TUHAN melakukan kepada Sara seperti yang dijanjikan-Nya."
 },
 {
   "id": 516,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 2,
   "firman": "Maka mengandunglah Sara, lalu ia melahirkan seorang anak laki-laki bagi Abraham dalam masa tuanya, pada waktu yang telah ditetapkan, sesuai dengan firman Allah kepadanya."
 },
 {
   "id": 517,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 3,
   "firman": "Abraham menamai anaknya yang baru lahir itu Ishak, yang dilahirkan Sara baginya."
 },
 {
   "id": 518,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 4,
   "firman": "Kemudian Abraham menyunat Ishak, anaknya itu, ketika berumur delapan hari, seperti yang diperintahkan Allah kepadanya."
 },
 {
   "id": 519,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 5,
   "firman": "Adapun Abraham berumur seratus tahun, ketika Ishak, anaknya, lahir baginya."
 },
 {
   "id": 520,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 6,
   "firman": "Berkatalah Sara: \"Allah telah membuat aku tertawa; setiap orang yang mendengarnya akan tertawa karena aku.\""
 },
 {
   "id": 521,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 7,
   "firman": "Lagi katanya: \"Siapakah tadinya yang dapat mengatakan kepada Abraham: Sara menyusui anak? Namun aku telah melahirkan seorang anak laki-laki baginya pada masa tuanya.\""
 },
 {
   "id": 522,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 8,
   "firman": "Bertambah besarlah anak itu dan ia disapih, lalu Abraham mengadakan perjamuan besar pada hari Ishak disapih itu."
 },
 {
   "id": 523,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 9,
   "firman": "Pada waktu itu Sara melihat, bahwa anak yang dilahirkan Hagar, perempuan Mesir itu bagi Abraham, sedang main dengan Ishak, anaknya sendiri."
 },
 {
   "id": 524,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 10,
   "firman": "Berkatalah Sara kepada Abraham: \"Usirlah hamba perempuan itu beserta anaknya, sebab anak hamba ini tidak akan menjadi ahli waris bersama-sama dengan anakku Ishak.\""
 },
 {
   "id": 525,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 11,
   "firman": "Hal ini sangat menyebalkan Abraham oleh karena anaknya itu."
 },
 {
   "id": 526,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 12,
   "firman": "Tetapi Allah berfirman kepada Abraham: \"Janganlah sebal hatimu karena hal anak dan budakmu itu; dalam segala yang dikatakan Sara kepadamu, haruslah engkau mendengarkannya, sebab yang akan disebut keturunanmu ialah yang berasal dari Ishak."
 },
 {
   "id": 527,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 13,
   "firman": "Tetapi keturunan dari hambamu itu juga akan Kubuat menjadi suatu bangsa, karena iapun anakmu.\""
 },
 {
   "id": 528,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 14,
   "firman": "Keesokan harinya pagi-pagi Abraham mengambil roti serta sekirbat air dan memberikannya kepada Hagar. Ia meletakkan itu beserta anaknya di atas bahu Hagar, kemudian disuruhnyalah perempuan itu pergi. Maka pergilah Hagar dan mengembara di padang gurun Bersyeba."
 },
 {
   "id": 529,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 15,
   "firman": "Ketika air yang dikirbat itu habis, dibuangnyalah anak itu ke bawah semak-semak,"
 },
 {
   "id": 530,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 16,
   "firman": "dan ia duduk agak jauh, kira-kira sepemanah jauhnya, sebab katanya: \"Tidak tahan aku melihat anak itu mati.\" Sedang ia duduk di situ, menangislah ia dengan suara nyaring."
 },
 {
   "id": 531,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 17,
   "firman": "Allah mendengar suara anak itu, lalu Malaikat Allah berseru dari langit kepada Hagar, kata-Nya kepadanya: \"Apakah yang engkau susahkan, Hagar? Janganlah takut, sebab Allah telah mendengar suara anak itu dari tempat ia terbaring."
 },
 {
   "id": 532,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 18,
   "firman": "Bangunlah, angkatlah anak itu, dan bimbinglah dia, sebab Aku akan membuat dia menjadi bangsa yang besar.\""
 },
 {
   "id": 533,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 19,
   "firman": "Lalu Allah membuka mata Hagar, sehingga ia melihat sebuah sumur; ia pergi mengisi kirbatnya dengan air, kemudian diberinya anak itu minum."
 },
 {
   "id": 534,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 20,
   "firman": "Allah menyertai anak itu, sehingga ia bertambah besar; ia menetap di padang gurun dan menjadi seorang pemanah."
 },
 {
   "id": 535,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 21,
   "firman": "Maka tinggallah ia di padang gurun Paran, dan ibunya mengambil seorang isteri baginya dari tanah Mesir."
 },
 {
   "id": 536,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 22,
   "firman": "Pada waktu itu Abimelekh, beserta Pikhol, panglima tentaranya, berkata kepada Abraham: \"Allah menyertai engkau dalam segala sesuatu yang engkau lakukan."
 },
 {
   "id": 537,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 23,
   "firman": "Oleh sebab itu, bersumpahlah kepadaku di sini demi Allah, bahwa engkau tidak akan berlaku curang kepadaku, atau kepada anak-anakku, atau kepada cucu cicitku; sesuai dengan persahabatan yang kulakukan kepadamu, demikianlah harus engkau berlaku kepadaku dan kepada negeri yang kautinggali sebagai orang asing.\""
 },
 {
   "id": 538,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 24,
   "firman": "Lalu kata Abraham: \"Aku bersumpah!\""
 },
 {
   "id": 539,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 25,
   "firman": "Tetapi Abraham menyesali Abimelekh tentang sebuah sumur yang telah dirampas oleh hamba-hamba Abimelekh."
 },
 {
   "id": 540,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 26,
   "firman": "Jawab Abimelekh: \"Aku tidak tahu, siapa yang melakukan hal itu; lagi tidak kauberitahukan kepadaku, dan sampai hari ini belum pula kudengar.\""
 },
 {
   "id": 541,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 27,
   "firman": "Lalu Abraham mengambil domba dan lembu dan memberikan semuanya itu kepada Abimelekh, kemudian kedua orang itu mengadakan perjanjian."
 },
 {
   "id": 542,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 28,
   "firman": "Tetapi Abraham memisahkan tujuh anak domba betina dari domba-domba itu."
 },
 {
   "id": 543,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 29,
   "firman": "Lalu kata Abimelekh kepada Abraham: \"Untuk apakah ketujuh anak domba yang kaupisahkan ini?\""
 },
 {
   "id": 544,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 30,
   "firman": "Jawabnya: \"Ketujuh anak domba ini harus kauterima dari tanganku untuk menjadi tanda bukti bagiku, bahwa akulah yang menggali sumur ini.\""
 },
 {
   "id": 545,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 31,
   "firman": "Sebab itu orang menyebutkan tempat itu Bersyeba, karena kedua orang itu telah bersumpah di sana."
 },
 {
   "id": 546,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 32,
   "firman": "Setelah mereka mengadakan perjanjian di Bersyeba, pulanglah Abimelekh beserta Pikhol, panglima tentaranya, ke negeri orang Filistin."
 },
 {
   "id": 547,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 33,
   "firman": "Lalu Abraham menanam sebatang pohon tamariska di Bersyeba, dan memanggil di sana nama TUHAN, Allah yang kekal."
 },
 {
   "id": 548,
   "kitab": "Kej",
   "pasal": 21,
   "ayat": 34,
   "firman": "Dan masih lama Abraham tinggal sebagai orang asing di negeri orang Filistin."
 },
 {
   "id": 549,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 1,
   "firman": "Setelah semuanya itu Allah mencoba Abraham. Ia berfirman kepadanya: \"Abraham,\" lalu sahutnya: \"Ya, Tuhan.\""
 },
 {
   "id": 550,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 2,
   "firman": "Firman-Nya: \"Ambillah anakmu yang tunggal itu, yang engkau kasihi, yakni Ishak, pergilah ke tanah Moria dan persembahkanlah dia di sana sebagai korban bakaran pada salah satu gunung yang akan Kukatakan kepadamu.\""
 },
 {
   "id": 551,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 3,
   "firman": "Keesokan harinya pagi-pagi bangunlah Abraham, ia memasang pelana keledainya dan memanggil dua orang bujangnya beserta Ishak, anaknya; ia membelah juga kayu untuk korban bakaran itu, lalu berangkatlah ia dan pergi ke tempat yang dikatakan Allah kepadanya."
 },
 {
   "id": 552,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 4,
   "firman": "Ketika pada hari ketiga Abraham melayangkan pandangnya, kelihatanlah kepadanya tempat itu dari jauh."
 },
 {
   "id": 553,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 5,
   "firman": "Kata Abraham kepada kedua bujangnya itu: \"Tinggallah kamu di sini dengan keledai ini; aku beserta anak ini akan pergi ke sana; kami akan sembahyang, sesudah itu kami kembali kepadamu.\""
 },
 {
   "id": 554,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 6,
   "firman": "Lalu Abraham mengambil kayu untuk korban bakaran itu dan memikulkannya ke atas bahu Ishak, anaknya, sedang di tangannya dibawanya api dan pisau. Demikianlah keduanya berjalan bersama-sama."
 },
 {
   "id": 555,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 7,
   "firman": "Lalu berkatalah Ishak kepada Abraham, ayahnya: \"Bapa.\" Sahut Abraham: \"Ya, anakku.\" Bertanyalah ia: \"Di sini sudah ada api dan kayu, tetapi di manakah anak domba untuk korban bakaran itu?\""
 },
 {
   "id": 556,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 8,
   "firman": "Sahut Abraham: \"Allah yang akan menyediakan anak domba untuk korban bakaran bagi-Nya, anakku.\" Demikianlah keduanya berjalan bersama-sama."
 },
 {
   "id": 557,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 9,
   "firman": "Sampailah mereka ke tempat yang dikatakan Allah kepadanya. Lalu Abraham mendirikan mezbah di situ, disusunnyalah kayu, diikatnya Ishak, anaknya itu, dan diletakkannya di mezbah itu, di atas kayu api."
 },
 {
   "id": 558,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 10,
   "firman": "Sesudah itu Abraham mengulurkan tangannya, lalu mengambil pisau untuk menyembelih anaknya."
 },
 {
   "id": 559,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 11,
   "firman": "Tetapi berserulah Malaikat TUHAN dari langit kepadanya: \"Abraham, Abraham.\" Sahutnya: \"Ya, Tuhan.\""
 },
 {
   "id": 560,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 12,
   "firman": "Lalu Ia berfirman: \"Jangan bunuh anak itu dan jangan kauapa-apakan dia, sebab telah Kuketahui sekarang, bahwa engkau takut akan Allah, dan engkau tidak segan-segan untuk menyerahkan anakmu yang tunggal kepada-Ku.\""
 },
 {
   "id": 561,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 13,
   "firman": "Lalu Abraham menoleh dan melihat seekor domba jantan di belakangnya, yang tanduknya tersangkut dalam belukar. Abraham mengambil domba itu, lalu mengorbankannya sebagai korban bakaran pengganti anaknya."
 },
 {
   "id": 562,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 14,
   "firman": "Dan Abraham menamai tempat itu: \"TUHAN menyediakan\"; sebab itu sampai sekarang dikatakan orang: \"Di atas gunung TUHAN, akan disediakan.\""
 },
 {
   "id": 563,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 15,
   "firman": "Untuk kedua kalinya berserulah Malaikat TUHAN dari langit kepada Abraham,"
 },
 {
   "id": 564,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 16,
   "firman": "kata-Nya: \"Aku bersumpah demi diri-Ku sendiri--demikianlah firman TUHAN--:Karena engkau telah berbuat demikian, dan engkau tidak segan-segan untuk menyerahkan anakmu yang tunggal kepada-Ku,"
 },
 {
   "id": 565,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 17,
   "firman": "maka Aku akan memberkati engkau berlimpah-limpah dan membuat keturunanmu sangat banyak seperti bintang di langit dan seperti pasir di tepi laut, dan keturunanmu itu akan menduduki kota-kota musuhnya."
 },
 {
   "id": 566,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 18,
   "firman": "Oleh keturunanmulah semua bangsa di bumi akan mendapat berkat, karena engkau mendengarkan firman-Ku.\""
 },
 {
   "id": 567,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 19,
   "firman": "Kemudian kembalilah Abraham kepada kedua bujangnya, dan mereka bersama-sama berangkat ke Bersyeba; dan Abraham tinggal di Bersyeba."
 },
 {
   "id": 568,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 20,
   "firman": "Sesudah itu Abraham mendapat kabar: \"Juga Milka telah melahirkan anak-anak lelaki bagi Nahor, saudaramu:"
 },
 {
   "id": 569,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 21,
   "firman": "Us, anak sulung, dan Bus, adiknya, dan Kemuel, ayah Aram,"
 },
 {
   "id": 570,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 22,
   "firman": "juga Kesed, Hazo, Pildash, Yidlaf dan Betuel.\""
 },
 {
   "id": 571,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 23,
   "firman": "Dan Betuel memperanakkan Ribka. Kedelapan orang inilah dilahirkan Milka bagi Nahor, saudara Abraham itu."
 },
 {
   "id": 572,
   "kitab": "Kej",
   "pasal": 22,
   "ayat": 24,
   "firman": "Dan gundik Nahor, yang namanya Reuma, melahirkan anak juga, yakni Tebah, Gaham, Tahash dan Maakha."
 },
 {
   "id": 573,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 1,
   "firman": "Sara hidup seratus dua puluh tujuh tahun lamanya; itulah umur Sara."
 },
 {
   "id": 574,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 2,
   "firman": "Kemudian matilah Sara di Kiryat-Arba, yaitu Hebron, di tanah Kanaan, lalu Abraham datang meratapi dan menangisinya."
 },
 {
   "id": 575,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 3,
   "firman": "Sesudah itu Abraham bangkit dan meninggalkan isterinya yang mati itu, lalu berkata kepada bani Het:"
 },
 {
   "id": 576,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 4,
   "firman": "\"Aku ini orang asing dan pendatang di antara kamu; berikanlah kiranya kuburan milik kepadaku di tanah kamu ini, supaya kiranya aku dapat mengantarkan dan menguburkan isteriku yang mati itu.\""
 },
 {
   "id": 577,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 5,
   "firman": "Bani Het menjawab Abraham:"
 },
 {
   "id": 578,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 6,
   "firman": "\"Dengarlah kepada kami, tuanku. Tuanku ini seorang raja agung di tengah-tengah kami; jadi kuburkanlah isterimu yang mati itu dalam kuburan kami yang terpilih, tidak akan ada seorangpun dari kami yang menolak menyediakan kuburannya bagimu untuk menguburkan isterimu yang mati itu.\""
 },
 {
   "id": 579,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 7,
   "firman": "Kemudian bangunlah Abraham lalu sujud kepada bani Het, penduduk negeri itu,"
 },
 {
   "id": 580,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 8,
   "firman": "serta berkata kepada mereka: \"Jika kamu setuju, bahwa aku mengantarkan dan menguburkan isteriku yang mati itu, maka dengarkanlah aku dan tolonglah mintakan dengan sangat kepada Efron bin Zohar,"
 },
 {
   "id": 581,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 9,
   "firman": "supaya ia memberikan kepadaku gua Makhpela miliknya itu, yang terletak di ujung ladangnya; baiklah itu diberikannya kepadaku dengan harga penuh untuk menjadi kuburan milikku di tengah-tengah kamu.\""
 },
 {
   "id": 582,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 10,
   "firman": "Pada waktu itu Efron hadir di tengah-tengah bani Het. Maka jawab Efron, orang Het itu, kepada Abraham dengan didengar oleh bani Het, oleh semua orang yang datang di pintu gerbang kota:"
 },
 {
   "id": 583,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 11,
   "firman": "\"Tidak, tuanku, dengarkanlah aku; ladang itu kuberikan kepadamu dan gua yang di sanapun kuberikan kepadamu; di depan mata orang-orang sebangsaku kuberikan itu kepadamu; kuburkanlah isterimu yang mati itu.\""
 },
 {
   "id": 584,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 12,
   "firman": "Lalu sujudlah Abraham di depan penduduk negeri itu"
 },
 {
   "id": 585,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 13,
   "firman": "serta berkata kepada Efron dengan didengar oleh mereka: \"Sesungguhnya, jika engkau suka, dengarkanlah aku: aku membayar harga ladang itu; terimalah itu dari padaku, supaya aku dapat menguburkan isteriku yang mati itu di sana.\""
 },
 {
   "id": 586,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 14,
   "firman": "Jawab Efron kepada Abraham:"
 },
 {
   "id": 587,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 15,
   "firman": "\"Tuanku, dengarkanlah aku: sebidang tanah dengan harga empat ratus syikal perak, apa artinya itu bagi kita? Kuburkan sajalah isterimu yang mati itu.\""
 },
 {
   "id": 588,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 16,
   "firman": "Lalu Abraham menerima usul Efron, maka ditimbangnyalah perak untuk Efron, sebanyak yang dimintanya dengan didengar oleh bani Het itu, empat ratus syikal perak, seperti yang berlaku di antara para saudagar."
 },
 {
   "id": 589,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 17,
   "firman": "Demikianlah ladang Efron, yang letaknya di Makhpela di sebelah timur Mamre, ladang dan gua yang di sana, serta segala pohon di ladang itu, bahkan di seluruh tanah itu sampai ke tepi-tepinya,"
 },
 {
   "id": 590,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 18,
   "firman": "diserahkan kepada Abraham menjadi tanah belian, di depan mata bani Het itu, di depan semua orang yang datang di pintu gerbang kota."
 },
 {
   "id": 591,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 19,
   "firman": "Sesudah itu Abraham menguburkan Sara, isterinya, di dalam gua ladang Makhpela itu, di sebelah timur Mamre, yaitu Hebron di tanah Kanaan."
 },
 {
   "id": 592,
   "kitab": "Kej",
   "pasal": 23,
   "ayat": 20,
   "firman": "Demikianlah dari pihak bani Het ladang dengan gua yang ada di sana diserahkan kepada Abraham menjadi kuburan miliknya."
 },
 {
   "id": 593,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 1,
   "firman": "Adapun Abraham telah tua dan lanjut umurnya, serta diberkati TUHAN dalam segala hal."
 },
 {
   "id": 594,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 2,
   "firman": "Berkatalah Abraham kepada hambanya yang paling tua dalam rumahnya, yang menjadi kuasa atas segala kepunyaannya, katanya: \"Baiklah letakkan tanganmu di bawah pangkal pahaku,"
 },
 {
   "id": 595,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 3,
   "firman": "supaya aku mengambil sumpahmu demi TUHAN, Allah yang empunya langit dan yang empunya bumi, bahwa engkau tidak akan mengambil untuk anakku seorang isteri dari antara perempuan Kanaan yang di antaranya aku diam."
 },
 {
   "id": 596,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 4,
   "firman": "Tetapi engkau harus pergi ke negeriku dan kepada sanak saudaraku untuk mengambil seorang isteri bagi Ishak, anakku.\""
 },
 {
   "id": 597,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 5,
   "firman": "Lalu berkatalah hambanya itu kepadanya: \"Mungkin perempuan itu tidak suka mengikuti aku ke negeri ini; haruskah aku membawa anakmu itu kembali ke negeri dari mana tuanku keluar?\""
 },
 {
   "id": 598,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 6,
   "firman": "Tetapi Abraham berkata kepadanya: \"Awas, jangan kaubawa anakku itu kembali ke sana."
 },
 {
   "id": 599,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 7,
   "firman": "TUHAN, Allah yang empunya langit, yang telah memanggil aku dari rumah ayahku serta dari negeri sanak saudaraku, dan yang telah berfirman kepadaku, serta yang bersumpah kepadaku, demikian: kepada keturunanmulah akan Kuberikan negeri ini--Dialah juga akan mengutus malaikat-Nya berjalan di depanmu, sehingga engkau dapat mengambil seorang isteri dari sana untuk anakku."
 },
 {
   "id": 600,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 8,
   "firman": "Tetapi jika perempuan itu tidak mau mengikuti engkau, maka lepaslah engkau dari sumpahmu kepadaku ini; hanya saja, janganlah anakku itu kaubawa kembali ke sana.\""
 },
 {
   "id": 601,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 9,
   "firman": "Lalu hamba itu meletakkan tangannya di bawah pangkal paha Abraham, tuannya, dan bersumpah kepadanya tentang hal itu."
 },
 {
   "id": 602,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 10,
   "firman": "Kemudian hamba itu mengambil sepuluh ekor dari unta tuannya dan pergi dengan membawa berbagai-bagai barang berharga kepunyaan tuannya; demikianlah ia berangkat menuju Aram-Mesopotamia ke kota Nahor."
 },
 {
   "id": 603,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 11,
   "firman": "Di sana disuruhnyalah unta itu berhenti di luar kota dekat suatu sumur, pada waktu petang hari, waktu perempuan-perempuan keluar untuk menimba air."
 },
 {
   "id": 604,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 12,
   "firman": "Lalu berkatalah ia: \"TUHAN, Allah tuanku Abraham, buatlah kiranya tercapai tujuanku pada hari ini, tunjukkanlah kasih setia-Mu kepada tuanku Abraham."
 },
 {
   "id": 605,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 13,
   "firman": "Di sini aku berdiri di dekat mata air, dan anak-anak perempuan penduduk kota ini datang keluar untuk menimba air."
 },
 {
   "id": 606,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 14,
   "firman": "Kiranya terjadilah begini: anak gadis, kepada siapa aku berkata: Tolong miringkan buyungmu itu, supaya aku minum, dan yang menjawab: Minumlah, dan unta-untamu juga akan kuberi minum--dialah kiranya yang Kautentukan bagi hamba-Mu, Ishak; maka dengan begitu akan kuketahui, bahwa Engkau telah menunjukkan kasih setia-Mu kepada tuanku itu.\""
 },
 {
   "id": 607,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 15,
   "firman": "Sebelum ia selesai berkata, maka datanglah Ribka, yang lahir bagi Betuel, anak laki-laki Milka, isteri Nahor, saudara Abraham; buyungnya dibawanya di atas bahunya."
 },
 {
   "id": 608,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 16,
   "firman": "Anak gadis itu sangat cantik parasnya, seorang perawan, belum pernah bersetubuh dengan laki-laki; ia turun ke mata air itu dan mengisi buyungnya, lalu kembali naik."
 },
 {
   "id": 609,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 17,
   "firman": "Kemudian berlarilah hamba itu mendapatkannya serta berkata: \"Tolong beri aku minum air sedikit dari buyungmu itu.\""
 },
 {
   "id": 610,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 18,
   "firman": "Jawabnya: \"Minumlah, tuan,\" maka segeralah diturunkannya buyungnya itu ke tangannya, serta diberinya dia minum."
 },
 {
   "id": 611,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 19,
   "firman": "Setelah ia selesai memberi hamba itu minum, berkatalah ia: \"Baiklah untuk unta-untamu juga kutimba air, sampai semuanya puas minum.\""
 },
 {
   "id": 612,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 20,
   "firman": "Kemudian segeralah dituangnya air yang di buyungnya itu ke dalam palungan, lalu berlarilah ia sekali lagi ke sumur untuk menimba air dan ditimbanyalah untuk semua unta orang itu."
 },
 {
   "id": 613,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 21,
   "firman": "Dan orang itu mengamat-amatinya dengan berdiam diri untuk mengetahui apakah TUHAN membuat perjalanannya berhasil atau tidak."
 },
 {
   "id": 614,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 22,
   "firman": "Setelah unta-unta itu puas minum, maka orang itu mengambil anting-anting emas yang setengah syikal beratnya, dan sepasang gelang tangan yang sepuluh syikal emas beratnya,"
 },
 {
   "id": 615,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 23,
   "firman": "serta berkata: \"Anak siapakah engkau? Baiklah katakan kepadaku! Adakah di rumah ayahmu tempat bermalam bagi kami?\""
 },
 {
   "id": 616,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 24,
   "firman": "Lalu jawabnya kepadanya: \"Ayahku Betuel, anak Milka, yang melahirkannya bagi Nahor.\""
 },
 {
   "id": 617,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 25,
   "firman": "Lagi kata gadis itu: \"Baik jerami, baik makanan unta banyak pada kami, tempat bermalampun ada.\""
 },
 {
   "id": 618,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 26,
   "firman": "Lalu berlututlah orang itu dan sujud menyembah TUHAN,"
 },
 {
   "id": 619,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 27,
   "firman": "serta berkata: \"Terpujilah TUHAN, Allah tuanku Abraham, yang tidak menarik kembali kasih-Nya dan setia-Nya dari tuanku itu; dan TUHAN telah menuntun aku di jalan ke rumah saudara-saudara tuanku ini!\""
 },
 {
   "id": 620,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 28,
   "firman": "Berlarilah gadis itu pergi menceritakan kejadian itu ke rumah ibunya."
 },
 {
   "id": 621,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 29,
   "firman": "Ribka mempunyai saudara laki-laki, namanya Laban. Laban berlari ke luar mendapatkan orang itu, ke mata air tadi,"
 },
 {
   "id": 622,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 30,
   "firman": "sesudah dilihatnya anting-anting itu dan gelang pada tangan saudaranya, dan sesudah didengarnya perkataan Ribka, saudaranya, yang bunyinya: \"Begitulah dikatakan orang itu kepadaku.\" Ia mendapatkan orang itu, yang masih berdiri di samping unta-untanya di dekat mata air itu,"
 },
 {
   "id": 623,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 31,
   "firman": "dan berkata: \"Marilah engkau yang diberkati TUHAN, mengapa engkau berdiri di luar, padahal telah kusediakan rumah bagimu, dan juga tempat untuk unta-untamu.\""
 },
 {
   "id": 624,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 32,
   "firman": "Masuklah orang itu ke dalam rumah. Ditanggalkanlah pelana unta-unta, diberikan jerami dan makanan kepada unta-unta itu, lalu dibawa air pembasuh kaki untuk orang itu dan orang-orang yang bersama-sama dengan dia."
 },
 {
   "id": 625,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 33,
   "firman": "Tetapi ketika dihidangkan makanan di depannya, berkatalah orang itu: \"Aku tidak akan makan sebelum kusampaikan pesan yang kubawa ini.\" Jawab Laban: \"Silakan!\""
 },
 {
   "id": 626,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 34,
   "firman": "Lalu berkatalah ia: \"Aku ini hamba Abraham."
 },
 {
   "id": 627,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 35,
   "firman": "TUHAN sangat memberkati tuanku itu, sehingga ia telah menjadi kaya; TUHAN telah memberikan kepadanya kambing domba dan lembu sapi, emas dan perak, budak laki-laki dan perempuan, unta dan keledai."
 },
 {
   "id": 628,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 36,
   "firman": "Dan Sara, isteri tuanku itu, sesudah tua, telah melahirkan anak laki-laki bagi tuanku itu; kepada anaknya itu telah diberikan tuanku segala harta miliknya."
 },
 {
   "id": 629,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 37,
   "firman": "Tuanku itu telah mengambil sumpahku: Engkau tidak akan mengambil untuk anakku seorang isteri dari antara perempuan Kanaan, yang negerinya kudiami ini,"
 },
 {
   "id": 630,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 38,
   "firman": "tetapi engkau harus pergi ke rumah ayahku dan kepada kaumku untuk mengambil seorang isteri bagi anakku."
 },
 {
   "id": 631,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 39,
   "firman": "Jawabku kepada tuanku itu: Mungkin perempuan itu tidak mau mengikut aku."
 },
 {
   "id": 632,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 40,
   "firman": "Tetapi katanya kepadaku: TUHAN, yang di hadapan-Nya aku hidup, akan mengutus malaikat-Nya menyertai engkau, dan akan membuat perjalananmu berhasil, sehingga engkau akan mengambil bagi anakku seorang isteri dari kaumku dan dari rumah ayahku."
 },
 {
   "id": 633,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 41,
   "firman": "Barulah engkau lepas dari sumpahmu kepadaku, jika engkau sampai kepada kaumku dan mereka tidak memberikan perempuan itu kepadamu; hanya dalam hal itulah engkau lepas dari sumpahmu kepadaku."
 },
 {
   "id": 634,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 42,
   "firman": "Dan hari ini aku sampai ke mata air tadi, lalu kataku: TUHAN, Allah tuanku Abraham, sudilah kiranya Engkau membuat berhasil perjalanan yang kutempuh ini."
 },
 {
   "id": 635,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 43,
   "firman": "Di sini aku berdiri di dekat mata air ini; kiranya terjadi begini: Apabila seorang gadis datang ke luar untuk menimba air dan aku berkata kepadanya: Tolong berikan aku minum air sedikit dari buyungmu itu,"
 },
 {
   "id": 636,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 44,
   "firman": "dan ia menjawab: Minumlah, dan untuk unta-untamu juga akan kutimba air, --dialah kiranya isteri, yang telah TUHAN tentukan bagi anak tuanku itu."
 },
 {
   "id": 637,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 45,
   "firman": "Belum lagi aku habis berkata dalam hatiku, Ribka telah datang membawa buyung di atas bahunya, dan turun ke mata air itu, lalu menimba air. Kataku kepadanya: Tolong berikan aku minum."
 },
 {
   "id": 638,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 46,
   "firman": "Segeralah ia menurunkan buyung itu dari atas bahunya serta berkata: Minumlah, dan unta-untamu juga akan kuberi minum. Lalu aku minum, dan unta-unta itu juga diberinya minum."
 },
 {
   "id": 639,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 47,
   "firman": "Sesudah itu aku bertanya kepadanya: Anak siapakah engkau? Jawabnya: Ayahku Betuel anak Nahor yang dilahirkan Milka. Lalu aku mengenakan anting-anting pada hidungnya dan gelang pada tangannya."
 },
 {
   "id": 640,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 48,
   "firman": "Kemudian berlututlah aku dan sujud menyembah TUHAN, serta memuji TUHAN, Allah tuanku Abraham, yang telah menuntun aku di jalan yang benar untuk mengambil anak perempuan saudara tuanku ini bagi anaknya."
 },
 {
   "id": 641,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 49,
   "firman": "Jadi sekarang, apabila kamu mau menunjukkan kasih dan setia kepada tuanku itu, beritahukanlah kepadaku; dan jika tidak, beritahukanlah juga kepadaku, supaya aku tahu entah berpaling ke kanan atau ke kiri.\""
 },
 {
   "id": 642,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 50,
   "firman": "Lalu Laban dan Betuel menjawab: \"Semuanya ini datangnya dari TUHAN; kami tidak dapat mengatakan kepadamu baiknya atau buruknya."
 },
 {
   "id": 643,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 51,
   "firman": "Lihat, Ribka ada di depanmu, bawalah dia dan pergilah, supaya ia menjadi isteri anak tuanmu, seperti yang difirmankan TUHAN.\""
 },
 {
   "id": 644,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 52,
   "firman": "Ketika hamba Abraham itu mendengar perkataan mereka, sujudlah ia sampai ke tanah menyembah TUHAN."
 },
 {
   "id": 645,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 53,
   "firman": "Kemudian hamba itu mengeluarkan perhiasan emas dan perak serta pakaian kebesaran, dan memberikan semua itu kepada Ribka; juga kepada saudaranya dan kepada ibunya diberikannya pemberian yang indah-indah."
 },
 {
   "id": 646,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 54,
   "firman": "Sesudah itu makan dan minumlah mereka, ia dan orang-orang yang bersama-sama dengan dia, dan mereka bermalam di situ. Paginya sesudah mereka bangun, berkatalah hamba itu: \"Lepaslah aku pulang kepada tuanku.\""
 },
 {
   "id": 647,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 55,
   "firman": "Tetapi saudara Ribka berkata, serta ibunya juga: \"Biarkanlah anak gadis itu tinggal pada kami barang sepuluh hari lagi, kemudian bolehlah engkau pergi.\""
 },
 {
   "id": 648,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 56,
   "firman": "Tetapi jawabnya kepada mereka: \"Janganlah tahan aku, sedang TUHAN telah membuat perjalananku berhasil; lepaslah aku, supaya aku pulang kepada tuanku.\""
 },
 {
   "id": 649,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 57,
   "firman": "Kata mereka: \"Baiklah kita panggil anak gadis itu dan menanyakan kepadanya sendiri.\""
 },
 {
   "id": 650,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 58,
   "firman": "Lalu mereka memanggil Ribka dan berkata kepadanya: \"Maukah engkau pergi beserta orang ini?\" Jawabnya: \"Mau.\""
 },
 {
   "id": 651,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 59,
   "firman": "Maka Ribka, saudara mereka itu, dan inang pengasuhnya beserta hamba Abraham dan orang-orangnya dibiarkan mereka pergi."
 },
 {
   "id": 652,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 60,
   "firman": "Dan mereka memberkati Ribka, kata mereka kepadanya: \"Saudara kami, moga-moga engkau menjadi beribu-ribu laksa, dan moga-moga keturunanmu menduduki kota-kota musuhnya.\""
 },
 {
   "id": 653,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 61,
   "firman": "Lalu berkemaslah Ribka beserta hamba-hambanya perempuan, dan mereka naik unta mengikuti orang itu. Demikianlah hamba itu membawa Ribka lalu berjalan pulang."
 },
 {
   "id": 654,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 62,
   "firman": "Adapun Ishak telah datang dari arah sumur Lahai-Roi; ia tinggal di Tanah Negeb."
 },
 {
   "id": 655,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 63,
   "firman": "Menjelang senja Ishak sedang keluar untuk berjalan-jalan di padang. Ia melayangkan pandangnya, maka dilihatnyalah ada unta-unta datang."
 },
 {
   "id": 656,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 64,
   "firman": "Ribka juga melayangkan pandangnya dan ketika dilihatnya Ishak, turunlah ia dari untanya."
 },
 {
   "id": 657,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 65,
   "firman": "Katanya kepada hamba itu: \"Siapakah laki-laki itu yang berjalan di padang ke arah kita?\" Jawab hamba itu: \"Dialah tuanku itu.\" Lalu Ribka mengambil telekungnya dan bertelekunglah ia."
 },
 {
   "id": 658,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 66,
   "firman": "Kemudian hamba itu menceritakan kepada Ishak segala yang dilakukannya."
 },
 {
   "id": 659,
   "kitab": "Kej",
   "pasal": 24,
   "ayat": 67,
   "firman": "Lalu Ishak membawa Ribka ke dalam kemah Sara, ibunya, dan mengambil dia menjadi isterinya. Ishak mencintainya dan demikian ia dihiburkan setelah ibunya meninggal."
 },
 {
   "id": 660,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 1,
   "firman": "Abraham mengambil pula seorang isteri, namanya Ketura."
 },
 {
   "id": 661,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 2,
   "firman": "Perempuan itu melahirkan baginya Zimran, Yoksan, Medan, Midian, Isybak dan Suah."
 },
 {
   "id": 662,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 3,
   "firman": "Yoksan memperanakkan Syeba dan Dedan. Keturunan Dedan ialah orang Asyur, orang Letush dan orang Leum."
 },
 {
   "id": 663,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 4,
   "firman": "Anak-anak Midian ialah Efa, Efer, Henokh, Abida dan Eldaa. Itulah semuanya keturunan Ketura."
 },
 {
   "id": 664,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 5,
   "firman": "Abraham memberikan segala harta miliknya kepada Ishak,"
 },
 {
   "id": 665,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 6,
   "firman": "tetapi kepada anak-anaknya yang diperolehnya dari gundik-gundiknya ia memberikan pemberian; kemudian ia menyuruh mereka--masih pada waktu ia hidup--meninggalkan Ishak, anaknya, dan pergi ke sebelah timur, ke Tanah Timur."
 },
 {
   "id": 666,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 7,
   "firman": "Abraham mencapai umur seratus tujuh puluh lima tahun,"
 },
 {
   "id": 667,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 8,
   "firman": "lalu ia meninggal. Ia mati pada waktu telah putih rambutnya, tua dan suntuk umur, maka ia dikumpulkan kepada kaum leluhurnya."
 },
 {
   "id": 668,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 9,
   "firman": "Dan anak-anaknya, Ishak dan Ismael, menguburkan dia dalam gua Makhpela, di padang Efron bin Zohar, orang Het itu, padang yang letaknya di sebelah timur Mamre,"
 },
 {
   "id": 669,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 10,
   "firman": "yang telah dibeli Abraham dari bani Het; di sanalah terkubur Abraham dan Sara isterinya."
 },
 {
   "id": 670,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 11,
   "firman": "Setelah Abraham mati, Allah memberkati Ishak, anaknya itu; dan Ishak diam dekat sumur Lahai-Roi."
 },
 {
   "id": 671,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 12,
   "firman": "Inilah keturunan Ismael, anak Abraham, yang telah dilahirkan baginya oleh Hagar, perempuan Mesir, hamba Sara itu."
 },
 {
   "id": 672,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 13,
   "firman": "Inilah nama anak-anak Ismael, disebutkan menurut urutan lahirnya: Nebayot, anak sulung Ismael, selanjutnya Kedar, Adbeel, Mibsam,"
 },
 {
   "id": 673,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 14,
   "firman": "Misyma, Duma, Masa,"
 },
 {
   "id": 674,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 15,
   "firman": "Hadad, Tema, Yetur, Nafish dan Kedma."
 },
 {
   "id": 675,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 16,
   "firman": "Itulah anak-anak Ismael, dan itulah nama-nama mereka, menurut kampung mereka dan menurut perkemahan mereka, dua belas orang raja, masing-masing dengan sukunya."
 },
 {
   "id": 676,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 17,
   "firman": "Umur Ismael ialah seratus tiga puluh tujuh tahun. Sesudah itu ia meninggal. Ia mati dan dikumpulkan kepada kaum leluhurnya."
 },
 {
   "id": 677,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 18,
   "firman": "Mereka itu mendiami daerah dari Hawila sampai Syur, yang letaknya di sebelah timur Mesir ke arah Asyur. Mereka menetap berhadapan dengan semua saudara mereka."
 },
 {
   "id": 678,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 19,
   "firman": "Inilah riwayat keturunan Ishak, anak Abraham. Abraham memperanakkan Ishak."
 },
 {
   "id": 679,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 20,
   "firman": "Dan Ishak berumur empat puluh tahun, ketika Ribka, anak Betuel, orang Aram dari Padan-Aram, saudara perempuan Laban orang Aram itu, diambilnya menjadi isterinya."
 },
 {
   "id": 680,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 21,
   "firman": "Berdoalah Ishak kepada TUHAN untuk isterinya, sebab isterinya itu mandul; TUHAN mengabulkan doanya, sehingga Ribka, isterinya itu, mengandung."
 },
 {
   "id": 681,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 22,
   "firman": "Tetapi anak-anaknya bertolak-tolakan di dalam rahimnya dan ia berkata: \"Jika demikian halnya, mengapa aku hidup?\" Dan ia pergi meminta petunjuk kepada TUHAN."
 },
 {
   "id": 682,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 23,
   "firman": "Firman TUHAN kepadanya: \"Dua bangsa ada dalam kandunganmu, dan dua suku bangsa akan berpencar dari dalam rahimmu; suku bangsa yang satu akan lebih kuat dari yang lain, dan anak yang tua akan menjadi hamba kepada anak yang muda.\""
 },
 {
   "id": 683,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 24,
   "firman": "Setelah genap harinya untuk bersalin, memang anak kembar yang di dalam kandungannya."
 },
 {
   "id": 684,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 25,
   "firman": "Keluarlah yang pertama, warnanya merah, seluruh tubuhnya seperti jubah berbulu; sebab itu ia dinamai Esau."
 },
 {
   "id": 685,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 26,
   "firman": "Sesudah itu keluarlah adiknya; tangannya memegang tumit Esau, sebab itu ia dinamai Yakub. Ishak berumur enam puluh tahun pada waktu mereka lahir."
 },
 {
   "id": 686,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 27,
   "firman": "Lalu bertambah besarlah kedua anak itu: Esau menjadi seorang yang pandai berburu, seorang yang suka tinggal di padang, tetapi Yakub adalah seorang yang tenang, yang suka tinggal di kemah."
 },
 {
   "id": 687,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 28,
   "firman": "Ishak sayang kepada Esau, sebab ia suka makan daging buruan, tetapi Ribka kasih kepada Yakub."
 },
 {
   "id": 688,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 29,
   "firman": "Pada suatu kali Yakub sedang memasak sesuatu, lalu datanglah Esau dengan lelah dari padang."
 },
 {
   "id": 689,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 30,
   "firman": "Kata Esau kepada Yakub: \"Berikanlah kiranya aku menghirup sedikit dari yang merah-merah itu, karena aku lelah.\" Itulah sebabnya namanya disebutkan Edom."
 },
 {
   "id": 690,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 31,
   "firman": "Tetapi kata Yakub: \"Juallah dahulu kepadaku hak kesulunganmu.\""
 },
 {
   "id": 691,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 32,
   "firman": "Sahut Esau: \"Sebentar lagi aku akan mati; apakah gunanya bagiku hak kesulungan itu?\""
 },
 {
   "id": 692,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 33,
   "firman": "Kata Yakub: \"Bersumpahlah dahulu kepadaku.\" Maka bersumpahlah ia kepada Yakub dan dijualnyalah hak kesulungannya kepadanya."
 },
 {
   "id": 693,
   "kitab": "Kej",
   "pasal": 25,
   "ayat": 34,
   "firman": "Lalu Yakub memberikan roti dan masakan kacang merah itu kepada Esau; ia makan dan minum, lalu berdiri dan pergi. Demikianlah Esau memandang ringan hak kesulungan itu."
 },
 {
   "id": 694,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 1,
   "firman": "Maka timbullah kelaparan di negeri itu. --Ini bukan kelaparan yang pertama, yang telah terjadi dalam zaman Abraham. Sebab itu Ishak pergi ke Gerar, kepada Abimelekh, raja orang Filistin."
 },
 {
   "id": 695,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 2,
   "firman": "Lalu TUHAN menampakkan diri kepadanya serta berfirman: \"Janganlah pergi ke Mesir, diamlah di negeri yang akan Kukatakan kepadamu."
 },
 {
   "id": 696,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 3,
   "firman": "Tinggallah di negeri ini sebagai orang asing, maka Aku akan menyertai engkau dan memberkati engkau, sebab kepadamulah dan kepada keturunanmu akan Kuberikan seluruh negeri ini, dan Aku akan menepati sumpah yang telah Kuikrarkan kepada Abraham, ayahmu."
 },
 {
   "id": 697,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 4,
   "firman": "Aku akan membuat banyak keturunanmu seperti bintang di langit; Aku akan memberikan kepada keturunanmu seluruh negeri ini, dan oleh keturunanmu semua bangsa di bumi akan mendapat berkat,"
 },
 {
   "id": 698,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 5,
   "firman": "karena Abraham telah mendengarkan firman-Ku dan memelihara kewajibannya kepada-Ku, yaitu segala perintah, ketetapan dan hukum-Ku.\""
 },
 {
   "id": 699,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 6,
   "firman": "Jadi tinggallah Ishak di Gerar."
 },
 {
   "id": 700,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 7,
   "firman": "Ketika orang-orang di tempat itu bertanya tentang isterinya, berkatalah ia: \"Dia saudaraku,\" sebab ia takut mengatakan: \"Ia isteriku,\" karena pikirnya: \"Jangan-jangan aku dibunuh oleh penduduk tempat ini karena Ribka, sebab elok parasnya.\""
 },
 {
   "id": 701,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 8,
   "firman": "Setelah beberapa lama ia ada di sana, pada suatu kali menjenguklah Abimelekh, raja orang Filistin itu dari jendela, maka dilihatnya Ishak sedang bercumbu-cumbuan dengan Ribka, isterinya."
 },
 {
   "id": 702,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 9,
   "firman": "Lalu Abimelekh memanggil Ishak dan berkata: \"Sesungguhnya dia isterimu, masakan engkau berkata: Dia saudaraku?\" Jawab Ishak kepadanya: \"Karena pikirku: Jangan-jangan aku mati karena dia.\""
 },
 {
   "id": 703,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 10,
   "firman": "Tetapi Abimelekh berkata: \"Apakah juga yang telah kauperbuat ini terhadap kami? Mudah sekali terjadi, salah seorang dari bangsa ini tidur dengan isterimu, sehingga dengan demikian engkau mendatangkan kesalahan atas kami.\""
 },
 {
   "id": 704,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 11,
   "firman": "Lalu Abimelekh memberi perintah kepada seluruh bangsa itu: \"Siapa yang mengganggu orang ini atau isterinya, pastilah ia akan dihukum mati.\""
 },
 {
   "id": 705,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 12,
   "firman": "Maka menaburlah Ishak di tanah itu dan dalam tahun itu juga ia mendapat hasil seratus kali lipat; sebab ia diberkati TUHAN."
 },
 {
   "id": 706,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 13,
   "firman": "Dan orang itu menjadi kaya, bahkan kian lama kian kaya, sehingga ia menjadi sangat kaya."
 },
 {
   "id": 707,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 14,
   "firman": "Ia mempunyai kumpulan kambing domba dan lembu sapi serta banyak anak buah, sehingga orang Filistin itu cemburu kepadanya."
 },
 {
   "id": 708,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 15,
   "firman": "Segala sumur, yang digali dalam zaman Abraham, ayahnya, oleh hamba-hamba ayahnya itu, telah ditutup oleh orang Filistin dan ditimbun dengan tanah."
 },
 {
   "id": 709,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 16,
   "firman": "Lalu kata Abimelekh kepada Ishak: \"Pergilah dari tengah-tengah kami sebab engkau telah menjadi jauh lebih berkuasa dari pada kami.\""
 },
 {
   "id": 710,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 17,
   "firman": "Jadi pergilah Ishak dari situ dan berkemahlah ia di lembah Gerar, dan ia menetap di situ."
 },
 {
   "id": 711,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 18,
   "firman": "Kemudian Ishak menggali kembali sumur-sumur yang digali dalam zaman Abraham, ayahnya, dan yang telah ditutup oleh orang Filistin sesudah Abraham mati; disebutkannyalah nama sumur-sumur itu menurut nama-nama yang telah diberikan oleh ayahnya."
 },
 {
   "id": 712,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 19,
   "firman": "Ketika hamba-hamba Ishak menggali di lembah itu, mereka mendapati di situ mata air yang berbual-bual airnya."
 },
 {
   "id": 713,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 20,
   "firman": "Lalu bertengkarlah para gembala Gerar dengan para gembala Ishak. Kata mereka: \"Air ini kepunyaan kami.\" Dan Ishak menamai sumur itu Esek, karena mereka bertengkar dengan dia di sana."
 },
 {
   "id": 714,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 21,
   "firman": "Kemudian mereka menggali sumur lain, dan mereka bertengkar juga tentang itu. Maka Ishak menamai sumur itu Sitna."
 },
 {
   "id": 715,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 22,
   "firman": "Ia pindah dari situ dan menggali sumur yang lain lagi, tetapi tentang sumur ini mereka tidak bertengkar. Sumur ini dinamainya Rehobot, dan ia berkata: \"Sekarang TUHAN telah memberikan kelonggaran kepada kita, sehingga kita dapat beranak cucu di negeri ini.\""
 },
 {
   "id": 716,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 23,
   "firman": "Dari situ ia pergi ke Bersyeba."
 },
 {
   "id": 717,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 24,
   "firman": "Lalu pada malam itu TUHAN menampakkan diri kepadanya serta berfirman: \"Akulah Allah ayahmu Abraham; janganlah takut, sebab Aku menyertai engkau; Aku akan memberkati engkau dan membuat banyak keturunanmu karena Abraham, hamba-Ku itu.\""
 },
 {
   "id": 718,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 25,
   "firman": "Sesudah itu Ishak mendirikan mezbah di situ dan memanggil nama TUHAN. Ia memasang kemahnya di situ, lalu hamba-hambanya menggali sumur di situ."
 },
 {
   "id": 719,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 26,
   "firman": "Datanglah Abimelekh dari Gerar mendapatkannya, bersama-sama dengan Ahuzat, sahabatnya, dan Pikhol, kepala pasukannya."
 },
 {
   "id": 720,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 27,
   "firman": "Tetapi kata Ishak kepada mereka: \"Mengapa kamu datang mendapatkan aku? Bukankah kamu benci kepadaku, dan telah menyuruh aku keluar dari tanahmu?\""
 },
 {
   "id": 721,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 28,
   "firman": "Jawab mereka: \"Kami telah melihat sendiri, bahwa TUHAN menyertai engkau; sebab itu kami berkata: baiklah kita mengadakan sumpah setia, antara kami dan engkau; dan baiklah kami mengikat perjanjian dengan engkau,"
 },
 {
   "id": 722,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 29,
   "firman": "bahwa engkau tidak akan berbuat jahat kepada kami, seperti kami tidak mengganggu engkau, dan seperti kami semata-mata berbuat baik kepadamu dan membiarkan engkau pergi dengan damai; bukankah engkau sekarang yang diberkati TUHAN.\""
 },
 {
   "id": 723,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 30,
   "firman": "Kemudian Ishak mengadakan perjamuan bagi mereka, lalu mereka makan dan minum."
 },
 {
   "id": 724,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 31,
   "firman": "Keesokan harinya pagi-pagi bersumpah-sumpahanlah mereka. Kemudian Ishak melepas mereka, dan mereka meninggalkan dia dengan damai."
 },
 {
   "id": 725,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 32,
   "firman": "Pada hari itu datanglah hamba-hamba Ishak memberitahukan kepadanya tentang sumur yang telah digali mereka, serta berkata kepadanya: \"Kami telah mendapat air.\""
 },
 {
   "id": 726,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 33,
   "firman": "Lalu dinamainyalah sumur itu Syeba. Sebab itu nama kota itu adalah Bersyeba, sampai sekarang."
 },
 {
   "id": 727,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 34,
   "firman": "Ketika Esau telah berumur empat puluh tahun, ia mengambil Yudit, anak Beeri orang Het, dan Basmat, anak Elon orang Het, menjadi isterinya."
 },
 {
   "id": 728,
   "kitab": "Kej",
   "pasal": 26,
   "ayat": 35,
   "firman": "Kedua perempuan itu menimbulkan kepedihan hati bagi Ishak dan bagi Ribka."
 },
 {
   "id": 729,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 1,
   "firman": "Ketika Ishak sudah tua, dan matanya telah kabur, sehingga ia tidak dapat melihat lagi, dipanggilnyalah Esau, anak sulungnya, serta berkata kepadanya: \"Anakku.\" Sahut Esau: \"Ya, bapa.\""
 },
 {
   "id": 730,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 2,
   "firman": "Berkatalah Ishak: \"Lihat, aku sudah tua, aku tidak tahu bila hari kematianku."
 },
 {
   "id": 731,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 3,
   "firman": "Maka sekarang, ambillah senjatamu, tabung panah dan busurmu, pergilah ke padang dan burulah bagiku seekor binatang;"
 },
 {
   "id": 732,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 4,
   "firman": "olahlah bagiku makanan yang enak, seperti yang kugemari, sesudah itu bawalah kepadaku, supaya kumakan, agar aku memberkati engkau, sebelum aku mati.\""
 },
 {
   "id": 733,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 5,
   "firman": "Tetapi Ribka mendengarkannya, ketika Ishak berkata kepada Esau, anaknya. Setelah Esau pergi ke padang memburu seekor binatang untuk dibawanya kepada ayahnya,"
 },
 {
   "id": 734,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 6,
   "firman": "berkatalah Ribka kepada Yakub, anaknya: \"Telah kudengar ayahmu berkata kepada Esau, kakakmu:"
 },
 {
   "id": 735,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 7,
   "firman": "Bawalah bagiku seekor binatang buruan dan olahlah bagiku makanan yang enak, supaya kumakan, dan supaya aku memberkati engkau di hadapan TUHAN, sebelum aku mati."
 },
 {
   "id": 736,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 8,
   "firman": "Maka sekarang, anakku, dengarkanlah perkataanku seperti yang kuperintahkan kepadamu."
 },
 {
   "id": 737,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 9,
   "firman": "Pergilah ke tempat kambing domba kita, ambillah dari sana dua anak kambing yang baik, maka aku akan mengolahnya menjadi makanan yang enak bagi ayahmu, seperti yang digemarinya."
 },
 {
   "id": 738,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 10,
   "firman": "Bawalah itu kepada ayahmu, supaya dimakannya, agar dia memberkati engkau, sebelum ia mati.\""
 },
 {
   "id": 739,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 11,
   "firman": "Lalu kata Yakub kepada Ribka, ibunya: \"Tetapi Esau, kakakku, adalah seorang yang berbulu badannya, sedang aku ini kulitku licin."
 },
 {
   "id": 740,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 12,
   "firman": "Mungkin ayahku akan meraba aku; maka nanti ia akan menyangka bahwa aku mau memperolok-olokkan dia; dengan demikian aku akan mendatangkan kutuk atas diriku dan bukan berkat.\""
 },
 {
   "id": 741,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 13,
   "firman": "Tetapi ibunya berkata kepadanya: \"Akulah yang menanggung kutuk itu, anakku; dengarkan saja perkataanku, pergilah ambil kambing-kambing itu.\""
 },
 {
   "id": 742,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 14,
   "firman": "Lalu ia pergi mengambil kambing-kambing itu dan membawanya kepada ibunya; sesudah itu ibunya mengolah makanan yang enak, seperti yang digemari ayahnya."
 },
 {
   "id": 743,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 15,
   "firman": "Kemudian Ribka mengambil pakaian yang indah kepunyaan Esau, anak sulungnya, pakaian yang disimpannya di rumah, lalu disuruhnyalah dikenakan oleh Yakub, anak bungsunya."
 },
 {
   "id": 744,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 16,
   "firman": "Dan kulit anak kambing itu dipalutkannya pada kedua tangan Yakub dan pada lehernya yang licin itu."
 },
 {
   "id": 745,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 17,
   "firman": "Lalu ia memberikan makanan yang enak dan roti yang telah diolahnya itu kepada Yakub, anaknya."
 },
 {
   "id": 746,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 18,
   "firman": "Demikianlah Yakub masuk ke tempat ayahnya serta berkata: \"Bapa!\" Sahut ayahnya: \"Ya, anakku; siapakah engkau?\""
 },
 {
   "id": 747,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 19,
   "firman": "Kata Yakub kepada ayahnya: \"Akulah Esau, anak sulungmu. Telah kulakukan, seperti yang bapa katakan kepadaku. Bangunlah, duduklah dan makanlah daging buruan masakanku ini, agar bapa memberkati aku.\""
 },
 {
   "id": 748,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 20,
   "firman": "Lalu Ishak berkata kepada anaknya itu: \"Lekas juga engkau mendapatnya, anakku!\" Jawabnya: \"Karena TUHAN, Allahmu, membuat aku mencapai tujuanku.\""
 },
 {
   "id": 749,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 21,
   "firman": "Lalu kata Ishak kepada Yakub: \"Datanglah mendekat, anakku, supaya aku meraba engkau, apakah engkau ini anakku Esau atau bukan.\""
 },
 {
   "id": 750,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 22,
   "firman": "Maka Yakub mendekati Ishak, ayahnya, dan ayahnya itu merabanya serta berkata: \"Kalau suara, suara Yakub; kalau tangan, tangan Esau.\""
 },
 {
   "id": 751,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 23,
   "firman": "Jadi Ishak tidak mengenal dia, karena tangannya berbulu seperti tangan Esau, kakaknya. Ishak hendak memberkati dia,"
 },
 {
   "id": 752,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 24,
   "firman": "tetapi ia masih bertanya: \"Benarkah engkau ini anakku Esau?\" Jawabnya: \"Ya!\""
 },
 {
   "id": 753,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 25,
   "firman": "Lalu berkatalah Ishak: \"Dekatkanlah makanan itu kepadaku, supaya kumakan daging buruan masakan anakku, agar aku memberkati engkau.\" Jadi didekatkannyalah makanan itu kepada ayahnya, lalu ia makan, dibawanya juga anggur kepadanya, lalu ia minum."
 },
 {
   "id": 754,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 26,
   "firman": "Berkatalah Ishak, ayahnya, kepadanya: \"Datanglah dekat-dekat dan ciumlah aku, anakku.\""
 },
 {
   "id": 755,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 27,
   "firman": "Lalu datanglah Yakub dekat-dekat dan diciumnyalah ayahnya. Ketika Ishak mencium bau pakaian Yakub, diberkatinyalah dia, katanya: \"Sesungguhnya bau anakku adalah sebagai bau padang yang diberkati TUHAN."
 },
 {
   "id": 756,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 28,
   "firman": "Allah akan memberikan kepadamu embun yang dari langit dan tanah-tanah gemuk di bumi dan gandum serta anggur berlimpah-limpah."
 },
 {
   "id": 757,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 29,
   "firman": "Bangsa-bangsa akan takluk kepadamu, dan suku-suku bangsa akan sujud kepadamu; jadilah tuan atas saudara-saudaramu, dan anak-anak ibumu akan sujud kepadamu. Siapa yang mengutuk engkau, terkutuklah ia, dan siapa yang memberkati engkau, diberkatilah ia.\""
 },
 {
   "id": 758,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 30,
   "firman": "Setelah Ishak selesai memberkati Yakub, dan baru saja Yakub keluar meninggalkan Ishak, ayahnya, pulanglah Esau, kakaknya, dari berburu."
 },
 {
   "id": 759,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 31,
   "firman": "Ia juga menyediakan makanan yang enak, lalu membawanya kepada ayahnya. Katanya kepada ayahnya: \"Bapa, bangunlah dan makan daging buruan masakan anakmu, agar engkau memberkati aku.\""
 },
 {
   "id": 760,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 32,
   "firman": "Tetapi kata Ishak, ayahnya, kepadanya: \"Siapakah engkau ini?\" Sahutnya: \"Akulah anakmu, anak sulungmu, Esau.\""
 },
 {
   "id": 761,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 33,
   "firman": "Lalu terkejutlah Ishak dengan sangat serta berkata: \"Siapakah gerangan dia, yang memburu binatang itu dan yang telah membawanya kepadaku? Aku telah memakan semuanya, sebelum engkau datang, dan telah memberkati dia; dan dia akan tetap orang yang diberkati.\""
 },
 {
   "id": 762,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 34,
   "firman": "Sesudah Esau mendengar perkataan ayahnya itu, meraung-raunglah ia dengan sangat keras dalam kepedihan hatinya serta berkata kepada ayahnya: \"Berkatilah aku ini juga, ya bapa!\""
 },
 {
   "id": 763,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 35,
   "firman": "Jawab ayahnya: \"Adikmu telah datang dengan tipu daya dan telah merampas berkat yang untukmu itu.\""
 },
 {
   "id": 764,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 36,
   "firman": "Kata Esau: \"Bukankah tepat namanya Yakub, karena ia telah dua kali menipu aku. Hak kesulunganku telah dirampasnya, dan sekarang dirampasnya pula berkat yang untukku.\" Lalu katanya: \"Apakah bapa tidak mempunyai berkat lain bagiku?\""
 },
 {
   "id": 765,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 37,
   "firman": "Lalu Ishak menjawab Esau, katanya: \"Sesungguhnya telah kuangkat dia menjadi tuan atas engkau, dan segala saudaranya telah kuberikan kepadanya menjadi hambanya, dan telah kubekali dia dengan gandum dan anggur; maka kepadamu, apa lagi yang dapat kuperbuat, ya anakku?\""
 },
 {
   "id": 766,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 38,
   "firman": "Kata Esau kepada ayahnya: \"Hanya berkat yang satu itukah ada padamu, ya bapa? Berkatilah aku ini juga, ya bapa!\" Dan dengan suara keras menangislah Esau."
 },
 {
   "id": 767,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 39,
   "firman": "Lalu Ishak, ayahnya, menjawabnya: \"Sesungguhnya tempat kediamanmu akan jauh dari tanah-tanah gemuk di bumi dan jauh dari embun dari langit di atas."
 },
 {
   "id": 768,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 40,
   "firman": "Engkau akan hidup dari pedangmu dan engkau akan menjadi hamba adikmu. Tetapi akan terjadi kelak, apabila engkau berusaha sungguh-sungguh, maka engkau akan melemparkan kuk itu dari tengkukmu.\""
 },
 {
   "id": 769,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 41,
   "firman": "Esau menaruh dendam kepada Yakub karena berkat yang telah diberikan oleh ayahnya kepadanya, lalu ia berkata kepada dirinya sendiri: \"Hari-hari berkabung karena kematian ayahku itu tidak akan lama lagi; pada waktu itulah Yakub, adikku, akan kubunuh.\""
 },
 {
   "id": 770,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 42,
   "firman": "Ketika diberitahukan perkataan Esau, anak sulungnya itu kepada Ribka, maka disuruhnyalah memanggil Yakub, anak bungsunya, lalu berkata kepadanya: \"Esau, kakakmu, bermaksud membalas dendam membunuh engkau."
 },
 {
   "id": 771,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 43,
   "firman": "Jadi sekarang, anakku, dengarkanlah perkataanku, bersiaplah engkau dan larilah kepada Laban, saudaraku, ke Haran,"
 },
 {
   "id": 772,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 44,
   "firman": "dan tinggallah padanya beberapa waktu lamanya, sampai kegeraman"
 },
 {
   "id": 773,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 45,
   "firman": "dan kemarahan kakakmu itu surut dari padamu, dan ia lupa apa yang telah engkau perbuat kepadanya; kemudian aku akan menyuruh orang menjemput engkau dari situ. Mengapa aku akan kehilangan kamu berdua pada satu hari juga?\""
 },
 {
   "id": 774,
   "kitab": "Kej",
   "pasal": 27,
   "ayat": 46,
   "firman": "Kemudian Ribka berkata kepada Ishak: \"Aku telah jemu hidup karena perempuan-perempuan Het itu; jikalau Yakub juga mengambil seorang isteri dari antara perempuan negeri ini, semacam perempuan Het itu, apa gunanya aku hidup lagi?\""
 },
 {
   "id": 775,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 1,
   "firman": "Kemudian Ishak memanggil Yakub, lalu memberkati dia serta memesankan kepadanya, katanya: \"Janganlah mengambil isteri dari perempuan Kanaan."
 },
 {
   "id": 776,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 2,
   "firman": "Bersiaplah, pergilah ke Padan-Aram, ke rumah Betuel, ayah ibumu, dan ambillah dari situ seorang isteri dari anak-anak Laban, saudara ibumu."
 },
 {
   "id": 777,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 3,
   "firman": "Moga-moga Allah Yang Mahakuasa memberkati engkau, membuat engkau beranak cucu dan membuat engkau menjadi banyak, sehingga engkau menjadi sekumpulan bangsa-bangsa."
 },
 {
   "id": 778,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 4,
   "firman": "Moga-moga Ia memberikan kepadamu berkat yang untuk Abraham, kepadamu serta kepada keturunanmu, sehingga engkau memiliki negeri ini yang kaudiami sebagai orang asing, yang telah diberikan Allah kepada Abraham.\""
 },
 {
   "id": 779,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 5,
   "firman": "Demikianlah Ishak melepas Yakub, lalu berangkatlah Yakub ke Padan-Aram, kepada Laban anak Betuel, orang Aram itu, saudara Ribka ibu Yakub dan Esau."
 },
 {
   "id": 780,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 6,
   "firman": "Ketika Esau melihat, bahwa Ishak telah memberkati Yakub dan melepasnya ke Padan-Aram untuk mengambil isteri dari situ--pada waktu ia memberkatinya ia telah memesankan kepada Yakub: \"Janganlah ambil isteri dari antara perempuan Kanaan\" --"
 },
 {
   "id": 781,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 7,
   "firman": "dan bahwa Yakub mendengarkan perkataan ayah dan ibunya, dan pergi ke Padan-Aram,"
 },
 {
   "id": 782,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 8,
   "firman": "maka Esaupun menyadari, bahwa perempuan Kanaan itu tidak disukai oleh Ishak, ayahnya."
 },
 {
   "id": 783,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 9,
   "firman": "Sebab itu ia pergi kepada Ismael dan mengambil Mahalat menjadi isterinya, di samping kedua isterinya yang telah ada. Mahalat adalah anak Ismael anak Abraham, adik Nebayot."
 },
 {
   "id": 784,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 10,
   "firman": "Maka Yakub berangkat dari Bersyeba dan pergi ke Haran."
 },
 {
   "id": 785,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 11,
   "firman": "Ia sampai di suatu tempat, dan bermalam di situ, karena matahari telah terbenam. Ia mengambil sebuah batu yang terletak di tempat itu dan dipakainya sebagai alas kepala, lalu membaringkan dirinya di tempat itu."
 },
 {
   "id": 786,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 12,
   "firman": "Maka bermimpilah ia, di bumi ada didirikan sebuah tangga yang ujungnya sampai di langit, dan tampaklah malaikat-malaikat Allah turun naik di tangga itu."
 },
 {
   "id": 787,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 13,
   "firman": "Berdirilah TUHAN di sampingnya dan berfirman: \"Akulah TUHAN, Allah Abraham, nenekmu, dan Allah Ishak; tanah tempat engkau berbaring ini akan Kuberikan kepadamu dan kepada keturunanmu."
 },
 {
   "id": 788,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 14,
   "firman": "Keturunanmu akan menjadi seperti debu tanah banyaknya, dan engkau akan mengembang ke sebelah timur, barat, utara dan selatan, dan olehmu serta keturunanmu semua kaum di muka bumi akan mendapat berkat."
 },
 {
   "id": 789,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 15,
   "firman": "Sesungguhnya Aku menyertai engkau dan Aku akan melindungi engkau, ke manapun engkau pergi, dan Aku akan membawa engkau kembali ke negeri ini, sebab Aku tidak akan meninggalkan engkau, melainkan tetap melakukan apa yang Kujanjikan kepadamu.\""
 },
 {
   "id": 790,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 16,
   "firman": "Ketika Yakub bangun dari tidurnya, berkatalah ia: \"Sesungguhnya TUHAN ada di tempat ini, dan aku tidak mengetahuinya.\""
 },
 {
   "id": 791,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 17,
   "firman": "Ia takut dan berkata: \"Alangkah dahsyatnya tempat ini. Ini tidak lain dari rumah Allah, ini pintu gerbang sorga.\""
 },
 {
   "id": 792,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 18,
   "firman": "Keesokan harinya pagi-pagi Yakub mengambil batu yang dipakainya sebagai alas kepala dan mendirikan itu menjadi tugu dan menuang minyak ke atasnya."
 },
 {
   "id": 793,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 19,
   "firman": "Ia menamai tempat itu Betel; dahulu nama kota itu Lus."
 },
 {
   "id": 794,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 20,
   "firman": "Lalu bernazarlah Yakub: \"Jika Allah akan menyertai dan akan melindungi aku di jalan yang kutempuh ini, memberikan kepadaku roti untuk dimakan dan pakaian untuk dipakai,"
 },
 {
   "id": 795,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 21,
   "firman": "sehingga aku selamat kembali ke rumah ayahku, maka TUHAN akan menjadi Allahku."
 },
 {
   "id": 796,
   "kitab": "Kej",
   "pasal": 28,
   "ayat": 22,
   "firman": "Dan batu yang kudirikan sebagai tugu ini akan menjadi rumah Allah. Dari segala sesuatu yang Engkau berikan kepadaku akan selalu kupersembahkan sepersepuluh kepada-Mu.\""
 },
 {
   "id": 797,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 1,
   "firman": "Kemudian berangkatlah Yakub dari situ dan pergi ke negeri Bani Timur."
 },
 {
   "id": 798,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 2,
   "firman": "Ketika ia memandang sekelilingnya, dilihatnya ada sebuah sumur di padang, dan ada tiga kumpulan kambing domba berbaring di dekatnya, sebab dari sumur itulah orang memberi minum kumpulan-kumpulan kambing domba itu. Adapun batu penutup sumur itu besar;"
 },
 {
   "id": 799,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 3,
   "firman": "dan apabila segala kumpulan kambing domba itu digiring berkumpul ke sana, maka gembala-gembala menggulingkan batu itu dari mulut sumur, lalu kambing domba itu diberi minum; kemudian dikembalikanlah batu itu lagi ke mulut sumur itu."
 },
 {
   "id": 800,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 4,
   "firman": "Bertanyalah Yakub kepada mereka: \"Saudara-saudara, dari manakah kamu ini?\" Jawab mereka: \"Kami ini dari Haran.\""
 },
 {
   "id": 801,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 5,
   "firman": "Lagi katanya kepada mereka: \"Kenalkah kamu Laban, cucu Nahor?\" Jawab mereka: \"Kami kenal.\""
 },
 {
   "id": 802,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 6,
   "firman": "Selanjutnya katanya kepada mereka: \"Selamatkah ia?\" Jawab mereka: \"Selamat! Tetapi lihat, itu datang anaknya perempuan, Rahel, dengan kambing dombanya.\""
 },
 {
   "id": 803,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 7,
   "firman": "Lalu kata Yakub: \"Hari masih siang, belum waktunya untuk mengumpulkan ternak; berilah minum kambing dombamu itu, kemudian pergilah menggembalakannya lagi.\""
 },
 {
   "id": 804,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 8,
   "firman": "Tetapi jawab mereka: \"Kami tidak dapat melakukan itu selama segala kumpulan binatang itu belum berkumpul; barulah batu itu digulingkan dari mulut sumur dan kami memberi minum kambing domba kami.\""
 },
 {
   "id": 805,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 9,
   "firman": "Selagi ia berkata-kata dengan mereka, datanglah Rahel dengan kambing domba ayahnya, sebab dialah yang menggembalakannya."
 },
 {
   "id": 806,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 10,
   "firman": "Ketika Yakub melihat Rahel, anak Laban saudara ibunya, serta kambing domba Laban, ia datang mendekat, lalu menggulingkan batu itu dari mulut sumur, dan memberi minum kambing domba itu."
 },
 {
   "id": 807,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 11,
   "firman": "Kemudian Yakub mencium Rahel serta menangis dengan suara keras."
 },
 {
   "id": 808,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 12,
   "firman": "Lalu Yakub menceritakan kepada Rahel, bahwa ia sanak saudara ayah Rahel, dan anak Ribka. Maka berlarilah Rahel menceritakannya kepada ayahnya."
 },
 {
   "id": 809,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 13,
   "firman": "Segera sesudah Laban mendengar kabar tentang Yakub, anak saudaranya itu, berlarilah ia menyongsong dia, lalu mendekap dan mencium dia, kemudian membawanya ke rumahnya. Maka Yakub menceritakan segala hal ihwalnya kepada Laban."
 },
 {
   "id": 810,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 14,
   "firman": "Kata Laban kepadanya: \"Sesungguhnya engkau sedarah sedaging dengan aku.\" Maka tinggallah Yakub padanya genap sebulan lamanya."
 },
 {
   "id": 811,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 15,
   "firman": "Kemudian berkatalah Laban kepada Yakub: \"Masakan karena engkau adalah sanak saudaraku, engkau bekerja padaku dengan cuma-cuma? Katakanlah kepadaku apa yang patut menjadi upahmu.\""
 },
 {
   "id": 812,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 16,
   "firman": "Laban mempunyai dua anak perempuan; yang lebih tua namanya Lea dan yang lebih muda namanya Rahel."
 },
 {
   "id": 813,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 17,
   "firman": "Lea tidak berseri matanya, tetapi Rahel itu elok sikapnya dan cantik parasnya."
 },
 {
   "id": 814,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 18,
   "firman": "Yakub cinta kepada Rahel, sebab itu ia berkata: \"Aku mau bekerja padamu tujuh tahun lamanya untuk mendapat Rahel, anakmu yang lebih muda itu.\""
 },
 {
   "id": 815,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 19,
   "firman": "Sahut Laban: \"Lebih baiklah ia kuberikan kepadamu dari pada kepada orang lain; maka tinggallah padaku.\""
 },
 {
   "id": 816,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 20,
   "firman": "Jadi bekerjalah Yakub tujuh tahun lamanya untuk mendapat Rahel itu, tetapi yang tujuh tahun itu dianggapnya seperti beberapa hari saja, karena cintanya kepada Rahel."
 },
 {
   "id": 817,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 21,
   "firman": "Sesudah itu berkatalah Yakub kepada Laban: \"Berikanlah kepadaku bakal isteriku itu, sebab jangka waktuku telah genap, supaya aku akan kawin dengan dia.\""
 },
 {
   "id": 818,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 22,
   "firman": "Lalu Laban mengundang semua orang di tempat itu, dan mengadakan perjamuan."
 },
 {
   "id": 819,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 23,
   "firman": "Tetapi pada waktu malam diambilnyalah Lea, anaknya, lalu dibawanya kepada Yakub. Maka Yakubpun menghampiri dia."
 },
 {
   "id": 820,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 24,
   "firman": "Lagipula Laban memberikan Zilpa, budaknya perempuan, kepada Lea, anaknya itu, menjadi budaknya."
 },
 {
   "id": 821,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 25,
   "firman": "Tetapi pada waktu pagi tampaklah bahwa itu Lea! Lalu berkatalah Yakub kepada Laban: \"Apakah yang kauperbuat terhadap aku ini? Bukankah untuk mendapat Rahel aku bekerja padamu? Mengapa engkau menipu aku?\""
 },
 {
   "id": 822,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 26,
   "firman": "Jawab Laban: \"Tidak biasa orang berbuat demikian di tempat kami ini, mengawinkan adiknya lebih dahulu dari pada kakaknya."
 },
 {
   "id": 823,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 27,
   "firman": "Genapilah dahulu tujuh hari perkawinanmu dengan anakku ini; kemudian anakku yang lainpun akan diberikan kepadamu sebagai upah, asal engkau bekerja pula padaku tujuh tahun lagi.\""
 },
 {
   "id": 824,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 28,
   "firman": "Maka Yakub berbuat demikian; ia menggenapi ketujuh hari perkawinannya dengan Lea, kemudian Laban memberikan kepadanya Rahel, anaknya itu, menjadi isterinya."
 },
 {
   "id": 825,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 29,
   "firman": "Lagipula Laban memberikan Bilha, budaknya perempuan, kepada Rahel, anaknya itu, menjadi budaknya."
 },
 {
   "id": 826,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 30,
   "firman": "Yakub menghampiri Rahel juga, malah ia lebih cinta kepada Rahel dari pada kepada Lea. Demikianlah ia bekerja pula pada Laban tujuh tahun lagi."
 },
 {
   "id": 827,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 31,
   "firman": "Ketika TUHAN melihat, bahwa Lea tidak dicintai, dibuka-Nyalah kandungannya, tetapi Rahel mandul."
 },
 {
   "id": 828,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 32,
   "firman": "Lea mengandung, lalu melahirkan seorang anak laki-laki, dan menamainya Ruben, sebab katanya: \"Sesungguhnya TUHAN telah memperhatikan kesengsaraanku; sekarang tentulah aku akan dicintai oleh suamiku.\""
 },
 {
   "id": 829,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 33,
   "firman": "Mengandung pulalah ia, lalu melahirkan seorang anak laki-laki, maka ia berkata: \"Sesungguhnya, TUHAN telah mendengar, bahwa aku tidak dicintai, lalu diberikan-Nya pula anak ini kepadaku.\" Maka ia menamai anak itu Simeon."
 },
 {
   "id": 830,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 34,
   "firman": "Mengandung pulalah ia, lalu melahirkan seorang anak laki-laki, maka ia berkata: \"Sekali ini suamiku akan lebih erat kepadaku, karena aku telah melahirkan tiga anak laki-laki baginya.\" Itulah sebabnya ia menamai anak itu Lewi."
 },
 {
   "id": 831,
   "kitab": "Kej",
   "pasal": 29,
   "ayat": 35,
   "firman": "Mengandung pulalah ia, lalu melahirkan seorang anak laki-laki, maka ia berkata: \"Sekali ini aku akan bersyukur kepada TUHAN.\" Itulah sebabnya ia menamai anak itu Yehuda. Sesudah itu ia tidak melahirkan lagi."
 },
 {
   "id": 832,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 1,
   "firman": "Ketika dilihat Rahel, bahwa ia tidak melahirkan anak bagi Yakub, cemburulah ia kepada kakaknya itu, lalu berkata kepada Yakub: \"Berikanlah kepadaku anak; kalau tidak, aku akan mati.\""
 },
 {
   "id": 833,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 2,
   "firman": "Maka bangkitlah amarah Yakub terhadap Rahel dan ia berkata: \"Akukah pengganti Allah, yang telah menghalangi engkau mengandung?\""
 },
 {
   "id": 834,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 3,
   "firman": "Kata Rahel: \"Ini Bilha, budakku perempuan, hampirilah dia, supaya ia melahirkan anak di pangkuanku, dan supaya oleh dia akupun mempunyai keturunan.\""
 },
 {
   "id": 835,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 4,
   "firman": "Maka diberikannyalah Bilha, budaknya itu, kepada Yakub menjadi isterinya dan Yakub menghampiri budak itu."
 },
 {
   "id": 836,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 5,
   "firman": "Bilha mengandung, lalu melahirkan seorang anak laki-laki bagi Yakub."
 },
 {
   "id": 837,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 6,
   "firman": "Berkatalah Rahel: \"Allah telah memberikan keadilan kepadaku, juga telah didengarkan-Nya permohonanku dan diberikan-Nya kepadaku seorang anak laki-laki.\" Itulah sebabnya ia menamai anak itu Dan."
 },
 {
   "id": 838,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 7,
   "firman": "Mengandung pulalah Bilha, budak perempuan Rahel, lalu melahirkan anak laki-laki yang kedua bagi Yakub."
 },
 {
   "id": 839,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 8,
   "firman": "Berkatalah Rahel: \"Aku telah sangat hebat bergulat dengan kakakku, dan akupun menang.\" Maka ia menamai anak itu Naftali."
 },
 {
   "id": 840,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 9,
   "firman": "Ketika dilihat Lea, bahwa ia tidak melahirkan lagi, diambilnyalah Zilpa, budaknya perempuan, dan diberikannya kepada Yakub menjadi isterinya."
 },
 {
   "id": 841,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 10,
   "firman": "Dan Zilpa, budak perempuan Lea, melahirkan seorang anak laki-laki bagi Yakub."
 },
 {
   "id": 842,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 11,
   "firman": "Berkatalah Lea: \"Mujur telah datang.\" Maka ia menamai anak itu Gad."
 },
 {
   "id": 843,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 12,
   "firman": "Dan Zilpa, budak perempuan Lea, melahirkan anak laki-laki yang kedua bagi Yakub."
 },
 {
   "id": 844,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 13,
   "firman": "Berkatalah Lea: \"Aku ini berbahagia! Tentulah perempuan-perempuan akan menyebutkan aku berbahagia.\" Maka ia menamai anak itu Asyer."
 },
 {
   "id": 845,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 14,
   "firman": "Ketika Ruben pada musim menuai gandum pergi berjalan-jalan, didapatinyalah di padang buah dudaim, lalu dibawanya kepada Lea, ibunya. Kata Rahel kepada Lea: \"Berilah aku beberapa buah dudaim yang didapat oleh anakmu itu.\""
 },
 {
   "id": 846,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 15,
   "firman": "Jawab Lea kepadanya: \"Apakah belum cukup bagimu mengambil suamiku? Sekarang pula mau mengambil lagi buah dudaim anakku?\" Kata Rahel: \"Kalau begitu biarlah ia tidur dengan engkau pada malam ini sebagai ganti buah dudaim anakmu itu.\""
 },
 {
   "id": 847,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 16,
   "firman": "Ketika Yakub pada waktu petang datang dari padang, pergilah Lea mendapatkannya, sambil berkata: \"Engkau harus singgah kepadaku malam ini, sebab memang engkau telah kusewa dengan buah dudaim anakku.\" Sebab itu tidurlah Yakub dengan Lea pada malam itu."
 },
 {
   "id": 848,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 17,
   "firman": "Lalu Allah mendengarkan permohonan Lea. Lea mengandung dan melahirkan anak laki-laki yang kelima bagi Yakub."
 },
 {
   "id": 849,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 18,
   "firman": "Lalu kata Lea: \"Allah telah memberi upahku, karena aku telah memberi budakku perempuan kepada suamiku.\" Maka ia menamai anak itu Isakhar."
 },
 {
   "id": 850,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 19,
   "firman": "Kemudian Lea mengandung pula dan melahirkan anak laki-laki yang keenam bagi Yakub."
 },
 {
   "id": 851,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 20,
   "firman": "Berkatalah Lea: \"Allah telah memberikan hadiah yang indah kepadaku; sekali ini suamiku akan tinggal bersama-sama dengan aku, karena aku telah melahirkan enam orang anak laki-laki baginya.\" Maka ia menamai anak itu Zebulon."
 },
 {
   "id": 852,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 21,
   "firman": "Sesudah itu ia melahirkan seorang anak perempuan dan menamai anak itu Dina."
 },
 {
   "id": 853,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 22,
   "firman": "Lalu ingatlah Allah akan Rahel; Allah mendengarkan permohonannya serta membuka kandungannya."
 },
 {
   "id": 854,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 23,
   "firman": "Maka mengandunglah Rahel dan melahirkan seorang anak laki-laki. Berkatalah ia: \"Allah telah menghapuskan aibku.\""
 },
 {
   "id": 855,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 24,
   "firman": "Maka ia menamai anak itu Yusuf, sambil berkata: \"Mudah-mudahan TUHAN menambah seorang anak laki-laki lagi bagiku.\""
 },
 {
   "id": 856,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 25,
   "firman": "Setelah Rahel melahirkan Yusuf, berkatalah Yakub kepada Laban: \"Izinkanlah aku pergi, supaya aku pulang ke tempat kelahiranku dan ke negeriku."
 },
 {
   "id": 857,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 26,
   "firman": "Berikanlah isteri-isteriku dan anak-anakku, yang menjadi upahku selama aku bekerja padamu, supaya aku pulang, sebab engkau tahu, betapa keras aku bekerja padamu.\""
 },
 {
   "id": 858,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 27,
   "firman": "Tetapi Laban berkata kepadanya: \"Sekiranya aku mendapat kasihmu! Telah nyata kepadaku, bahwa TUHAN memberkati aku karena engkau.\""
 },
 {
   "id": 859,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 28,
   "firman": "Lagi katanya: \"Tentukanlah upahmu yang harus kubayar, maka aku akan memberikannya.\""
 },
 {
   "id": 860,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 29,
   "firman": "Sahut Yakub kepadanya: \"Engkau sendiri tahu, bagaimana aku bekerja padamu, dan bagaimana keadaan ternakmu dalam penjagaanku,"
 },
 {
   "id": 861,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 30,
   "firman": "sebab harta milikmu tidak begitu banyak sebelum aku datang, tetapi sekarang telah berkembang dengan sangat, dan TUHAN telah memberkati engkau sejak aku berada di sini; jadi, bilakah dapat aku bekerja untuk rumah tanggaku sendiri?\""
 },
 {
   "id": 862,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 31,
   "firman": "Kata Laban: \"Apakah yang harus kuberikan kepadamu?\" Jawab Yakub: \"Tidak usah kauberikan apa-apa kepadaku; aku mau lagi menggembalakan kambing dombamu dan menjaganya, asal engkau mengizinkan hal ini kepadaku:"
 },
 {
   "id": 863,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 32,
   "firman": "Hari ini aku akan lewat dari tengah-tengah segala kambing dombamu dan akan mengasingkan dari situ setiap binatang yang berbintik-bintik dan berbelang-belang; segala domba yang hitam dan segala kambing yang berbelang-belang dan berbintik-bintik, itulah upahku."
 },
 {
   "id": 864,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 33,
   "firman": "Dan kejujuranku akan terbukti di kemudian hari, apabila engkau datang memeriksa upahku: Segala yang tidak berbintik-bintik atau berbelang-belang di antara kambing-kambing dan yang tidak hitam di antara domba-domba, anggaplah itu tercuri olehku.\""
 },
 {
   "id": 865,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 34,
   "firman": "Kemudian kata Laban: \"Baik, jadilah seperti perkataanmu itu.\""
 },
 {
   "id": 866,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 35,
   "firman": "Lalu diasingkannyalah pada hari itu kambing-kambing jantan yang bercoreng-coreng dan berbelang-belang dan segala kambing yang berbintik-bintik dan berbelang-belang, segala yang ada warna putih pada badannya, serta segala yang hitam di antara domba-domba, dan diserahkannyalah semuanya itu kepada anak-anaknya untuk dijaga."
 },
 {
   "id": 867,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 36,
   "firman": "Kemudian Laban menentukan jarak tiga hari perjalanan jauhnya antara dia dan Yakub, maka tetaplah Yakub menggembalakan kambing domba yang tinggal itu."
 },
 {
   "id": 868,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 37,
   "firman": "Lalu Yakub mengambil dahan hijau dari pohon hawar, pohon badam dan pohon berangan, dikupasnyalah dahan-dahan itu sehingga berbelang-belang, sampai yang putihnya kelihatan."
 },
 {
   "id": 869,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 38,
   "firman": "Ia meletakkan dahan-dahan yang dikupasnya itu dalam palungan, dalam tempat minum, ke mana kambing domba itu datang minum, sehingga tepat di depan kambing domba itu. Adapun kambing domba itu suka berkelamin pada waktu datang minum."
 },
 {
   "id": 870,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 39,
   "firman": "Jika kambing domba itu berkelamin dekat dahan-dahan itu, maka anaknya bercoreng-coreng, berbintik-bintik dan berbelang-belang."
 },
 {
   "id": 871,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 40,
   "firman": "Kemudian Yakub memisahkan domba-domba itu, dihadapkannya kepala-kepala kambing domba itu kepada yang bercoreng-coreng dan kepada segala yang hitam di antara kambing domba Laban. Demikianlah ia beroleh kumpulan-kumpulan hewan baginya sendiri, dan tidak ditempatkannya pada kambing domba Laban."
 },
 {
   "id": 872,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 41,
   "firman": "Dan setiap kali, apabila berkelamin kambing domba yang kuat, maka Yakub meletakkan dahan-dahan itu ke dalam palungan di depan mata kambing domba itu, supaya berkelamin dekat dahan-dahan itu."
 },
 {
   "id": 873,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 42,
   "firman": "Tetapi apabila datang kambing domba yang lemah, ia tidak meletakkan dahan-dahan itu ke dalamnya. Jadi hewan yang lemah untuk Laban dan yang kuat untuk Yakub."
 },
 {
   "id": 874,
   "kitab": "Kej",
   "pasal": 30,
   "ayat": 43,
   "firman": "Maka sangatlah bertambah-tambah harta Yakub, dan ia mempunyai banyak kambing domba, budak perempuan dan laki-laki, unta dan keledai."
 },
 {
   "id": 875,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 1,
   "firman": "Kedengaranlah kepada Yakub anak-anak Laban berkata demikian: \"Yakub telah mengambil segala harta milik ayah kita dan dari harta itulah ia membangun segala kekayaannya.\""
 },
 {
   "id": 876,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 2,
   "firman": "Lagi kelihatan kepada Yakub dari muka Laban, bahwa Laban tidak lagi seperti yang sudah-sudah kepadanya."
 },
 {
   "id": 877,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 3,
   "firman": "Lalu berfirmanlah TUHAN kepada Yakub: \"Pulanglah ke negeri nenek moyangmu dan kepada kaummu, dan Aku akan menyertai engkau.\""
 },
 {
   "id": 878,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 4,
   "firman": "Sesudah itu Yakub menyuruh memanggil Rahel dan Lea untuk datang ke padang, ke tempat kambing dombanya,"
 },
 {
   "id": 879,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 5,
   "firman": "lalu ia berkata kepada mereka: \"Telah kulihat dari muka ayahmu, bahwa ia tidak lagi seperti yang sudah-sudah kepadaku, tetapi Allah ayahku menyertai aku."
 },
 {
   "id": 880,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 6,
   "firman": "Juga kamu sendiri tahu, bahwa aku telah bekerja sekuat-kuatku pada ayahmu."
 },
 {
   "id": 881,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 7,
   "firman": "Tetapi ayahmu telah berlaku curang kepadaku dan telah sepuluh kali mengubah upahku, tetapi Allah tidak membiarkan dia berbuat jahat kepadaku."
 },
 {
   "id": 882,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 8,
   "firman": "Apabila ia berkata: yang berbintik-bintiklah akan menjadi upahmu, maka segala kambing domba itu beroleh anak yang berbintik-bintik; dan apabila ia berkata: yang bercoreng-corenglah akan menjadi upahmu, maka segala kambing domba itu beroleh anak yang bercoreng-coreng."
 },
 {
   "id": 883,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 9,
   "firman": "Demikianlah Allah mengambil ternak ayahmu dan memberikannya kepadaku."
 },
 {
   "id": 884,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 10,
   "firman": "Pada suatu kali pada masa kambing domba itu suka berkelamin, maka aku bermimpi dan melihat, bahwa jantan-jantan yang menjantani kambing domba itu bercoreng-coreng, berbintik-bintik dan berbelang-belang."
 },
 {
   "id": 885,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 11,
   "firman": "Dan Malaikat Allah berfirman kepadaku dalam mimpi itu: Yakub! Jawabku: Ya Tuhan!"
 },
 {
   "id": 886,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 12,
   "firman": "Lalu Ia berfirman: Angkatlah mukamu dan lihatlah, bahwa segala jantan yang menjantani kambing domba itu bercoreng-coreng, berbintik-bintik dan berbelang-belang, sebab telah Kulihat semua yang dilakukan oleh Laban itu kepadamu."
 },
 {
   "id": 887,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 13,
   "firman": "Akulah Allah yang di Betel itu, di mana engkau mengurapi tugu, dan di mana engkau bernazar kepada-Ku; maka sekarang, bersiaplah engkau, pergilah dari negeri ini dan pulanglah ke negeri sanak saudaramu.\""
 },
 {
   "id": 888,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 14,
   "firman": "Lalu Rahel dan Lea menjawab Yakub, katanya: \"Bukankah tidak ada lagi bagian atau warisan kami dalam rumah ayah kami?"
 },
 {
   "id": 889,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 15,
   "firman": "Bukankah kami ini dianggapnya sebagai orang asing, karena ia telah menjual kami? Juga bagian kami telah dihabiskannya sama sekali."
 },
 {
   "id": 890,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 16,
   "firman": "Tetapi segala kekayaan, yang telah diambil Allah dari ayah kami, adalah milik kami dan anak-anak kami; maka sekarang, perbuatlah segala yang difirmankan Allah kepadamu.\""
 },
 {
   "id": 891,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 17,
   "firman": "Lalu bersiaplah Yakub, dinaikkannya anak-anaknya dan isteri-isterinya ke atas unta,"
 },
 {
   "id": 892,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 18,
   "firman": "digiringnya seluruh ternaknya dan segala apa yang telah diperolehnya, yakni ternak kepunyaannya, yang telah diperolehnya di Padan-Aram, dengan maksud pergi kepada Ishak, ayahnya, ke tanah Kanaan."
 },
 {
   "id": 893,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 19,
   "firman": "Adapun Laban telah pergi menggunting bulu domba-dombanya. Ketika itulah Rahel mencuri terafim ayahnya."
 },
 {
   "id": 894,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 20,
   "firman": "Dan Yakub mengakali Laban, orang Aram itu, dengan tidak memberitahukan kepadanya, bahwa ia mau lari."
 },
 {
   "id": 895,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 21,
   "firman": "Demikianlah ia lari dengan segala harta miliknya. Ia berangkat, menyeberangi sungai Efrat dan berjalan menuju pegunungan Gilead."
 },
 {
   "id": 896,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 22,
   "firman": "Ketika pada hari ketiga dikabarkan kepada Laban, bahwa Yakub telah lari,"
 },
 {
   "id": 897,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 23,
   "firman": "dibawanyalah sanak saudaranya bersama-sama, dikejarnya Yakub tujuh hari perjalanan jauhnya, lalu ia dapat menyusulnya di pegunungan Gilead."
 },
 {
   "id": 898,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 24,
   "firman": "Pada waktu malam datanglah Allah dalam suatu mimpi kepada Laban, orang Aram itu, serta berfirman kepadanya: \"Jagalah baik-baik, supaya engkau jangan mengatai Yakub dengan sepatah katapun.\""
 },
 {
   "id": 899,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 25,
   "firman": "Ketika Laban sampai kepada Yakub, --Yakub telah memasang kemahnya di pegunungan, juga Laban dengan sanak saudaranya telah memasang kemahnya di pegunungan Gilead--"
 },
 {
   "id": 900,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 26,
   "firman": "berkatalah Laban kepada Yakub: \"Apakah yang kauperbuat ini, maka engkau mengakali aku dan mengangkut anak-anakku perempuan sebagai orang tawanan?"
 },
 {
   "id": 901,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 27,
   "firman": "Mengapa engkau lari diam-diam dan mengakali aku? Mengapa engkau tidak memberitahu kepadaku, supaya aku menghantarkan engkau dengan sukacita dan nyanyian dengan rebana dan kecapi?"
 },
 {
   "id": 902,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 28,
   "firman": "Lagipula engkau tidak memberikan aku kesempatan untuk mencium cucu-cucuku laki-laki dan anak-anakku perempuan. Memang bodoh perbuatanmu itu."
 },
 {
   "id": 903,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 29,
   "firman": "Aku ini berkuasa untuk berbuat jahat kepadamu, tetapi Allah ayahmu telah berfirman kepadaku tadi malam: Jagalah baik-baik, jangan engkau mengatai Yakub dengan sepatah katapun."
 },
 {
   "id": 904,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 30,
   "firman": "Maka sekarang, kalau memang engkau harus pergi, semata-mata karena sangat rindu ke rumah ayahmu, mengapa engkau mencuri dewa-dewaku?\""
 },
 {
   "id": 905,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 31,
   "firman": "Lalu Yakub menjawab Laban: \"Aku takut, karena pikirku, jangan-jangan engkau merampas anak-anakmu itu dari padaku."
 },
 {
   "id": 906,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 32,
   "firman": "Tetapi pada siapa engkau menemui dewa-dewamu itu, janganlah ia hidup lagi. Periksalah di depan saudara-saudara kita segala barang yang ada padaku dan ambillah barangmu.\" Sebab Yakub tidak tahu, bahwa Rahel yang mencuri terafim itu."
 },
 {
   "id": 907,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 33,
   "firman": "Lalu masuklah Laban ke dalam kemah Yakub dan ke dalam kemah Lea dan ke dalam kemah kedua budak perempuan itu, tetapi terafim itu tidak ditemuinya. Setelah keluar dari kemah Lea, ia masuk ke dalam kemah Rahel."
 },
 {
   "id": 908,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 34,
   "firman": "Tetapi Rahel telah mengambil terafim itu dan memasukkannya ke dalam pelana untanya, dan duduk di atasnya. Laban menggeledah seluruh kemah itu, tetapi terafim itu tidak ditemuinya."
 },
 {
   "id": 909,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 35,
   "firman": "Lalu kata Rahel kepada ayahnya: \"Janganlah bapa marah, karena aku tidak dapat bangun berdiri di depanmu, sebab aku sedang haid.\" Dan Laban mencari dengan teliti, tetapi ia tidak menemui terafim itu."
 },
 {
   "id": 910,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 36,
   "firman": "Lalu hati Yakub panas dan ia bertengkar dengan Laban. Ia berkata kepada Laban: \"Apakah kesalahanku, apakah dosaku, maka engkau memburu aku sehebat itu?"
 },
 {
   "id": 911,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 37,
   "firman": "Engkau telah menggeledah segala barangku, sekarang apakah yang kautemui dari segala barang rumahmu? Letakkanlah di sini di depan saudara-saudaraku dan saudara-saudaramu, supaya mereka mengadili antara kita berdua."
 },
 {
   "id": 912,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 38,
   "firman": "Selama dua puluh tahun ini aku bersama-sama dengan engkau; domba dan kambing betinamu tidak pernah keguguran dan jantan dari kambing dombamu tidak pernah kumakan."
 },
 {
   "id": 913,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 39,
   "firman": "Yang diterkam oleh binatang buas tidak pernah kubawa kepadamu, aku sendiri yang menggantinya; yang dicuri orang, baik waktu siang, baik waktu malam, selalu engkau tuntut dari padaku."
 },
 {
   "id": 914,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 40,
   "firman": "Aku dimakan panas hari waktu siang dan kedinginan waktu malam, dan mataku jauh dari pada tertidur."
 },
 {
   "id": 915,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 41,
   "firman": "Selama dua puluh tahun ini aku di rumahmu; aku telah bekerja padamu empat belas tahun lamanya untuk mendapat kedua anakmu dan enam tahun untuk mendapat ternakmu, dan engkau telah sepuluh kali mengubah upahku."
 },
 {
   "id": 916,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 42,
   "firman": "Seandainya Allah ayahku, Allah Abraham dan Yang Disegani oleh Ishak tidak menyertai aku, tentulah engkau sekarang membiarkan aku pergi dengan tangan hampa; tetapi kesengsaraanku dan jerih payahku telah diperhatikan Allah dan Ia telah menjatuhkan putusan tadi malam.\""
 },
 {
   "id": 917,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 43,
   "firman": "Lalu Laban menjawab Yakub: \"Perempuan-perempuan ini anakku dan anak-anak lelaki ini cucuku dan ternak ini ternakku, bahkan segala yang kaulihat di sini adalah milikku; jadi apakah yang dapat kuperbuat sekarang kepada anak-anakku ini atau kepada anak-anak yang dilahirkan mereka?"
 },
 {
   "id": 918,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 44,
   "firman": "Maka sekarang, marilah kita mengikat perjanjian, aku dan engkau, supaya itu menjadi kesaksian antara aku dan engkau.\""
 },
 {
   "id": 919,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 45,
   "firman": "Kemudian Yakub mengambil sebuah batu dan didirikannya menjadi tugu."
 },
 {
   "id": 920,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 46,
   "firman": "Selanjutnya berkatalah Yakub kepada sanak saudaranya: \"Kumpulkanlah batu.\" Maka mereka mengambil batu dan membuat timbunan, lalu makanlah mereka di sana di dekat timbunan itu."
 },
 {
   "id": 921,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 47,
   "firman": "Laban menamai timbunan batu itu Yegar-Sahaduta, tetapi Yakub menamainya Galed."
 },
 {
   "id": 922,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 48,
   "firman": "Lalu kata Laban: \"Timbunan batu inilah pada hari ini menjadi kesaksian antara aku dan engkau.\" Itulah sebabnya timbunan itu dinamainya Galed,"
 },
 {
   "id": 923,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 49,
   "firman": "dan juga Mizpa, sebab katanya: \"TUHAN kiranya berjaga-jaga antara aku dan engkau, apabila kita berjauhan."
 },
 {
   "id": 924,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 50,
   "firman": "Jika engkau mengaibkan anak-anakku, dan jika engkau mengambil isteri lain di samping anak-anakku itu, ingatlah, walaupun tidak ada orang dekat kita, Allah juga yang menjadi saksi antara aku dan engkau.\""
 },
 {
   "id": 925,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 51,
   "firman": "Selanjutnya kata Laban kepada Yakub: \"Inilah timbunan batu, dan inilah tugu yang kudirikan antara aku dan engkau--"
 },
 {
   "id": 926,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 52,
   "firman": "timbunan batu dan tugu inilah menjadi kesaksian, bahwa aku tidak akan melewati timbunan batu ini mendapatkan engkau, dan bahwa engkaupun tidak akan melewati timbunan batu dan tugu ini mendapatkan aku, dengan berniat jahat."
 },
 {
   "id": 927,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 53,
   "firman": "Allah Abraham dan Allah Nahor, Allah ayah mereka, kiranya menjadi hakim antara kita.\" Lalu Yakub bersumpah demi Yang Disegani oleh Ishak, ayahnya."
 },
 {
   "id": 928,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 54,
   "firman": "Dan Yakub mempersembahkan korban sembelihan di gunung itu. Ia mengundang makan sanak saudaranya, lalu mereka makan serta bermalam di gunung itu."
 },
 {
   "id": 929,
   "kitab": "Kej",
   "pasal": 31,
   "ayat": 55,
   "firman": "Keesokan harinya pagi-pagi Laban mencium cucu-cucunya dan anak-anaknya serta memberkati mereka, kemudian pulanglah Laban kembali ke tempat tinggalnya."
 },
 {
   "id": 930,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 1,
   "firman": "Yakub melanjutkan perjalanannya, lalu bertemulah malaikat-malaikat Allah dengan dia."
 },
 {
   "id": 931,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 2,
   "firman": "Ketika Yakub melihat mereka, berkatalah ia: \"Ini bala tentara Allah.\" Sebab itu dinamainyalah tempat itu Mahanaim."
 },
 {
   "id": 932,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 3,
   "firman": "Sesudah itu Yakub menyuruh utusannya berjalan lebih dahulu mendapatkan Esau, kakaknya, ke tanah Seir, daerah Edom."
 },
 {
   "id": 933,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 4,
   "firman": "Ia memerintahkan kepada mereka: \"Beginilah kamu katakan kepada tuanku, kepada Esau: Beginilah kata hambamu Yakub: Aku telah tinggal pada Laban sebagai orang asing dan diam di situ selama ini."
 },
 {
   "id": 934,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 5,
   "firman": "Aku telah mempunyai lembu sapi, keledai dan kambing domba, budak laki-laki dan perempuan, dan aku menyuruh memberitahukan hal ini kepada tuanku, supaya aku mendapat kasihmu.\""
 },
 {
   "id": 935,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 6,
   "firman": "Kemudian pulanglah para utusan itu kepada Yakub dan berkata: \"Kami telah sampai kepada kakakmu, kepada Esau, dan iapun sedang di jalan menemui engkau, diiringi oleh empat ratus orang.\""
 },
 {
   "id": 936,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 7,
   "firman": "Lalu sangat takutlah Yakub dan merasa sesak hati; maka dibaginyalah orang-orangnya yang bersama-sama dengan dia, kambing dombanya, lembu sapi dan untanya menjadi dua pasukan."
 },
 {
   "id": 937,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 8,
   "firman": "Sebab pikirnya: \"Jika Esau datang menyerang pasukan yang satu, sehingga terpukul kalah, maka pasukan yang tinggal akan terluput.\""
 },
 {
   "id": 938,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 9,
   "firman": "Kemudian berkatalah Yakub: \"Ya Allah nenekku Abraham dan Allah ayahku Ishak, ya TUHAN, yang telah berfirman kepadaku: Pulanglah ke negerimu serta kepada sanak saudaramu dan Aku akan berbuat baik kepadamu--"
 },
 {
   "id": 939,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 10,
   "firman": "sekali-kali aku tidak layak untuk menerima segala kasih dan kesetiaan yang Engkau tunjukkan kepada hamba-Mu ini, sebab aku membawa hanya tongkatku ini waktu aku menyeberangi sungai Yordan ini, tetapi sekarang telah menjadi dua pasukan."
 },
 {
   "id": 940,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 11,
   "firman": "Lepaskanlah kiranya aku dari tangan kakakku, dari tangan Esau, sebab aku takut kepadanya, jangan-jangan ia datang membunuh aku, juga ibu-ibu dengan anak-anaknya."
 },
 {
   "id": 941,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 12,
   "firman": "Bukankah Engkau telah berfirman: Tentu Aku akan berbuat baik kepadamu dan menjadikan keturunanmu sebagai pasir di laut, yang karena banyaknya tidak dapat dihitung.\""
 },
 {
   "id": 942,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 13,
   "firman": "Lalu bermalamlah ia di sana pada malam itu. Kemudian diambilnyalah dari apa yang ada padanya suatu persembahan untuk Esau, kakaknya,"
 },
 {
   "id": 943,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 14,
   "firman": "yaitu dua ratus kambing betina dan dua puluh kambing jantan, dua ratus domba betina dan dua puluh domba jantan,"
 },
 {
   "id": 944,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 15,
   "firman": "tiga puluh unta yang sedang menyusui beserta anak-anaknya, empat puluh lembu betina dan sepuluh lembu jantan, dua puluh keledai betina dan sepuluh keledai jantan."
 },
 {
   "id": 945,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 16,
   "firman": "Diserahkannyalah semuanya itu kepada budak-budaknya untuk dijaga, tiap-tiap kumpulan tersendiri, dan ia berkata kepada mereka: \"Berjalanlah kamu lebih dahulu dan jagalah supaya ada jarak antara kumpulan yang satu dengan kumpulan yang lain.\""
 },
 {
   "id": 946,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 17,
   "firman": "Diperintahkannyalah kepada yang paling di muka: \"Apabila Esau, kakakku, bertemu dengan engkau dan bertanya kepadamu: Siapakah tuanmu? dan ke manakah engkau pergi? dan milik siapakah ternak yang di depanmu itu? --"
 },
 {
   "id": 947,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 18,
   "firman": "jawablah: milik hambamu Yakub; inilah persembahan yang dikirim kepada tuanku Esau, dan Yakub sendiripun ada di belakang kami.\""
 },
 {
   "id": 948,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 19,
   "firman": "Begitulah diperintahkannya baik kepada yang kedua maupun kepada yang ketiga dan kepada sekalian orang yang berjalan menggiring kumpulan hewan itu, katanya: \"Seperti perkataanku tadilah kamu katakan kepada Esau, apabila kamu berjumpa dengan dia;"
 },
 {
   "id": 949,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 20,
   "firman": "dan kamu harus mengatakan juga: Hambamu Yakub sendiri ada di belakang kami.\" Sebab pikir Yakub: \"Baiklah aku mendamaikan hatinya dengan persembahan yang diantarkan lebih dahulu, kemudian barulah aku akan melihat mukanya; mungkin ia akan menerima aku dengan baik.\""
 },
 {
   "id": 950,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 21,
   "firman": "Jadi persembahan itu diantarkan lebih dahulu, tetapi ia sendiri bermalam pada malam itu di tempat perkemahannya."
 },
 {
   "id": 951,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 22,
   "firman": "Pada malam itu Yakub bangun dan ia membawa kedua isterinya, kedua budaknya perempuan dan kesebelas anaknya, dan menyeberang di tempat penyeberangan sungai Yabok."
 },
 {
   "id": 952,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 23,
   "firman": "Sesudah ia menyeberangkan mereka, ia menyeberangkan juga segala miliknya."
 },
 {
   "id": 953,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 24,
   "firman": "Lalu tinggallah Yakub seorang diri. Dan seorang laki-laki bergulat dengan dia sampai fajar menyingsing."
 },
 {
   "id": 954,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 25,
   "firman": "Ketika orang itu melihat, bahwa ia tidak dapat mengalahkannya, ia memukul sendi pangkal paha Yakub, sehingga sendi pangkal paha itu terpelecok, ketika ia bergulat dengan orang itu."
 },
 {
   "id": 955,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 26,
   "firman": "Lalu kata orang itu: \"Biarkanlah aku pergi, karena fajar telah menyingsing.\" Sahut Yakub: \"Aku tidak akan membiarkan engkau pergi, jika engkau tidak memberkati aku.\""
 },
 {
   "id": 956,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 27,
   "firman": "Bertanyalah orang itu kepadanya: \"Siapakah namamu?\" Sahutnya: \"Yakub.\""
 },
 {
   "id": 957,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 28,
   "firman": "Lalu kata orang itu: \"Namamu tidak akan disebutkan lagi Yakub, tetapi Israel, sebab engkau telah bergumul melawan Allah dan manusia, dan engkau menang.\""
 },
 {
   "id": 958,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 29,
   "firman": "Bertanyalah Yakub: \"Katakanlah juga namamu.\" Tetapi sahutnya: \"Mengapa engkau menanyakan namaku?\" Lalu diberkatinyalah Yakub di situ."
 },
 {
   "id": 959,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 30,
   "firman": "Yakub menamai tempat itu Pniel, sebab katanya: \"Aku telah melihat Allah berhadapan muka, tetapi nyawaku tertolong!\""
 },
 {
   "id": 960,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 31,
   "firman": "Lalu tampaklah kepadanya matahari terbit, ketika ia telah melewati Pniel; dan Yakub pincang karena pangkal pahanya."
 },
 {
   "id": 961,
   "kitab": "Kej",
   "pasal": 32,
   "ayat": 32,
   "firman": "Itulah sebabnya sampai sekarang orang Israel tidak memakan daging yang menutupi sendi pangkal paha, karena Dia telah memukul sendi pangkal paha Yakub, pada otot pangkal pahanya."
 },
 {
   "id": 962,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 1,
   "firman": "Yakubpun melayangkan pandangnya, lalu dilihatnyalah Esau datang dengan diiringi oleh empat ratus orang. Maka diserahkannyalah sebagian dari anak-anak itu kepada Lea dan sebagian kepada Rahel serta kepada kedua budak perempuan itu."
 },
 {
   "id": 963,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 2,
   "firman": "Ia menempatkan budak-budak perempuan itu beserta anak-anak mereka di muka, Lea beserta anak-anaknya di belakang mereka, dan Rahel beserta Yusuf di belakang sekali."
 },
 {
   "id": 964,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 3,
   "firman": "Dan ia sendiri berjalan di depan mereka dan ia sujud sampai ke tanah tujuh kali, hingga ia sampai ke dekat kakaknya itu."
 },
 {
   "id": 965,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 4,
   "firman": "Tetapi Esau berlari mendapatkan dia, didekapnya dia, dipeluk lehernya dan diciumnya dia, lalu bertangis-tangisanlah mereka."
 },
 {
   "id": 966,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 5,
   "firman": "Kemudian Esau melayangkan pandangnya, dilihatnyalah perempuan-perempuan dan anak-anak itu, lalu ia bertanya: \"Siapakah orang-orang yang beserta engkau itu?\" Jawab Yakub: \"Anak-anak yang telah dikaruniakan Allah kepada hambamu ini.\""
 },
 {
   "id": 967,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 6,
   "firman": "Sesudah itu mendekatlah budak-budak perempuan itu beserta anak-anaknya, lalu mereka sujud."
 },
 {
   "id": 968,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 7,
   "firman": "Mendekat jugalah Lea beserta anak-anaknya, dan merekapun sujud. Kemudian mendekatlah Yusuf beserta Rahel, dan mereka juga sujud."
 },
 {
   "id": 969,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 8,
   "firman": "Berkatalah Esau: \"Apakah maksudmu dengan seluruh pasukan, yang telah bertemu dengan aku tadi?\" Jawabnya: \"Untuk mendapat kasih tuanku.\""
 },
 {
   "id": 970,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 9,
   "firman": "Tetapi kata Esau: \"Aku mempunyai banyak, adikku; peganglah apa yang ada padamu.\""
 },
 {
   "id": 971,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 10,
   "firman": "Tetapi kata Yakub: \"Janganlah kiranya demikian; jikalau aku telah mendapat kasihmu, terimalah persembahanku ini dari tanganku, karena memang melihat mukamu adalah bagiku serasa melihat wajah Allah, dan engkaupun berkenan menyambut aku."
 },
 {
   "id": 972,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 11,
   "firman": "Terimalah kiranya pemberian tanda salamku ini, yang telah kubawa kepadamu, sebab Allah telah memberi karunia kepadaku dan akupun mempunyai segala-galanya.\" Lalu dibujuk-bujuknyalah Esau, sehingga diterimanya."
 },
 {
   "id": 973,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 12,
   "firman": "Kata Esau: \"Baiklah kita berangkat berjalan terus; aku akan menyertai engkau.\""
 },
 {
   "id": 974,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 13,
   "firman": "Tetapi Yakub berkata kepadanya: \"Tuanku maklum, bahwa anak-anak ini masih kurang kuat, dan bahwa beserta aku ada kambing domba dan lembu sapi yang masih menyusui, jika diburu-buru, satu hari saja, maka seluruh kumpulan binatang itu akan mati."
 },
 {
   "id": 975,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 14,
   "firman": "Biarlah kiranya tuanku berjalan lebih dahulu dari hambamu ini dan aku mau dengan hati-hati beringsut maju menurut langkah hewan, yang berjalan di depanku dan menurut langkah anak-anak, sampai aku tiba pada tuanku di Seir.\""
 },
 {
   "id": 976,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 15,
   "firman": "Lalu kata Esau: \"Kalau begitu, baiklah kutinggalkan padamu beberapa orang dari pengiringku.\" Tetapi Yakub berkata: \"Tidak usah demikian! Biarlah aku mendapat kasih tuanku saja.\""
 },
 {
   "id": 977,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 16,
   "firman": "Jadi pulanglah Esau pada hari itu berjalan ke Seir."
 },
 {
   "id": 978,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 17,
   "firman": "Tetapi Yakub berangkat ke Sukot, lalu mendirikan rumah, dan untuk ternaknya dibuatnya gubuk-gubuk. Itulah sebabnya tempat itu dinamai Sukot."
 },
 {
   "id": 979,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 18,
   "firman": "Dalam perjalanannya dari Padan-Aram sampailah Yakub dengan selamat ke Sikhem, di tanah Kanaan, lalu ia berkemah di sebelah timur kota itu."
 },
 {
   "id": 980,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 19,
   "firman": "Kemudian dibelinyalah dari anak-anak Hemor, bapa Sikhem, sebidang tanah, tempat ia memasang kemahnya, dengan harga seratus kesita."
 },
 {
   "id": 981,
   "kitab": "Kej",
   "pasal": 33,
   "ayat": 20,
   "firman": "Ia mendirikan mezbah di situ dan dinamainya itu: \"Allah Israel ialah Allah.\""
 },
 {
   "id": 982,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 1,
   "firman": "Pada suatu kali pergilah Dina, anak perempuan Lea yang dilahirkannya bagi Yakub, mengunjungi perempuan-perempuan di negeri itu."
 },
 {
   "id": 983,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 2,
   "firman": "Ketika itu terlihatlah ia oleh Sikhem, anak Hemor, orang Hewi, raja negeri itu, lalu Dina itu dilarikannya dan diperkosanya."
 },
 {
   "id": 984,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 3,
   "firman": "Tetapi terikatlah hatinya kepada Dina, anak Yakub; ia cinta kepada gadis itu, lalu menenangkan hati gadis itu."
 },
 {
   "id": 985,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 4,
   "firman": "Sebab itu berkatalah Sikhem kepada Hemor, ayahnya: \"Ambillah bagiku gadis ini untuk menjadi isteriku.\""
 },
 {
   "id": 986,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 5,
   "firman": "Kedengaranlah kepada Yakub, bahwa Sikhem mencemari Dina. Tetapi anak-anaknya ada di padang menjaga ternaknya, jadi Yakub mendiamkan soal itu sampai mereka pulang."
 },
 {
   "id": 987,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 6,
   "firman": "Lalu Hemor ayah Sikhem, pergi mendapatkan Yakub untuk berbicara dengan dia."
 },
 {
   "id": 988,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 7,
   "firman": "Sementara itu anak-anak Yakub pulang dari padang, dan sesudah mendengar peristiwa itu orang-orang ini sakit hati dan sangat marah karena Sikhem telah berbuat noda di antara orang Israel dengan memperkosa anak perempuan Yakub, sebab yang demikian itu tidak patut dilakukan."
 },
 {
   "id": 989,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 8,
   "firman": "Berbicaralah Hemor kepada mereka itu: \"Hati Sikhem anakku mengingini anakmu; kiranya kamu memberikan dia kepadanya menjadi isterinya"
 },
 {
   "id": 990,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 9,
   "firman": "dan biarlah kita ambil-mengambil: berikanlah gadis-gadis kamu kepada kami dan ambillah gadis-gadis kami."
 },
 {
   "id": 991,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 10,
   "firman": "Tinggallah pada kami: negeri ini terbuka untuk kamu; tinggallah di sini, jalanilah negeri ini dengan bebas, dan menetaplah di sini.\""
 },
 {
   "id": 992,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 11,
   "firman": "Lalu Sikhem berkata kepada ayah anak itu dan kepada kakak-kakaknya: \"Biarlah kiranya aku mendapat kasihmu, aku akan memberikan kepadamu apa yang kamu minta;"
 },
 {
   "id": 993,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 12,
   "firman": "walaupun kamu bebankan kepadaku uang jujuran dan uang mahar seberapa banyakpun, aku akan memberikan apa yang kamu minta; tetapi berilah gadis itu kepadaku menjadi isteriku.\""
 },
 {
   "id": 994,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 13,
   "firman": "Lalu anak-anak Yakub menjawab Sikhem dan Hemor, ayahnya, dengan tipu muslihat. Karena Sikhem telah mencemari Dina, adik mereka itu,"
 },
 {
   "id": 995,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 14,
   "firman": "berkatalah mereka kepada kedua orang itu: \"Kami tidak dapat berbuat demikian, memberikan adik kami kepada seorang laki-laki yang tidak bersunat, sebab hal itu aib bagi kami."
 },
 {
   "id": 996,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 15,
   "firman": "Hanyalah dengan syarat ini kami dapat menyetujui permintaanmu: kamu harus sama seperti kami, yaitu setiap laki-laki di antara kamu harus disunat,"
 },
 {
   "id": 997,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 16,
   "firman": "barulah kami akan memberikan gadis-gadis kami kepada kamu dan mengambil gadis-gadis kamu; maka kami akan tinggal padamu, dan kita akan menjadi satu bangsa."
 },
 {
   "id": 998,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 17,
   "firman": "Tetapi jika kamu tidak mendengarkan perkataan kami dan kamu tidak disunat, maka kami akan mengambil kembali anak itu, lalu pergi.\""
 },
 {
   "id": 999,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 18,
   "firman": "Lalu Hemor dan Sikhem, anak Hemor, menyetujui usul mereka."
 },
 {
   "id": 1000,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 19,
   "firman": "Dan orang muda itu tidak bertangguh melakukannya, sebab ia suka kepada anak Yakub, lagipula ia seorang yang paling dihormati di antara seluruh kaum keluarganya."
 },
 {
   "id": 1001,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 20,
   "firman": "Lalu pergilah Hemor dan Sikhem, anaknya itu, ke pintu gerbang kota mereka dan mereka berbicara kepada penduduk kota itu:"
 },
 {
   "id": 1002,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 21,
   "firman": "\"Orang-orang itu mau hidup damai dengan kita, biarlah mereka tinggal di negeri ini dan menjalaninya dengan bebas; bukankah negeri ini cukup luas untuk mereka? Maka kita dapat mengambil gadis-gadis mereka menjadi isteri kita dan kita dapat memberikan gadis-gadis kita kepada mereka."
 },
 {
   "id": 1003,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 22,
   "firman": "Namun hanya dengan syarat ini orang-orang itu setuju tinggal bersama-sama dengan kita, sehingga kita menjadi satu bangsa, yaitu setiap laki-laki di antara kita harus disunat seperti mereka bersunat."
 },
 {
   "id": 1004,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 23,
   "firman": "Ternak mereka, harta benda mereka dan segala hewan mereka, bukankah semuanya itu akan menjadi milik kita? Hanya biarlah kita menyetujui permintaan mereka, sehingga mereka tetap tinggal pada kita.\""
 },
 {
   "id": 1005,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 24,
   "firman": "Maka usul Hemor dan Sikhem, anaknya itu, didengarkan oleh semua orang yang datang berkumpul di pintu gerbang kota itu, lalu disunatlah setiap laki-laki, yakni setiap orang dewasa di kota itu."
 },
 {
   "id": 1006,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 25,
   "firman": "Pada hari ketiga, ketika mereka sedang menderita kesakitan, datanglah dua orang anak Yakub, yaitu Simeon dan Lewi, kakak-kakak Dina, setelah masing-masing mengambil pedangnya, menyerang kota itu dengan tidak takut-takut serta membunuh setiap laki-laki."
 },
 {
   "id": 1007,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 26,
   "firman": "Juga Hemor dan Sikhem, anaknya, dibunuh mereka dengan mata pedang, dan mereka mengambil Dina dari rumah Sikhem, lalu pergi."
 },
 {
   "id": 1008,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 27,
   "firman": "Kemudian datanglah anak-anak Yakub merampasi orang-orang yang terbunuh itu, lalu menjarah kota itu, karena adik mereka telah dicemari."
 },
 {
   "id": 1009,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 28,
   "firman": "Kambing dombanya dan lembu sapinya, keledainya dan segala yang di dalam dan di luar kota itu dibawa mereka;"
 },
 {
   "id": 1010,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 29,
   "firman": "segala kekayaannya, semua anaknya dan perempuannya ditawan dan dijarah mereka, juga seluruhnya yang ada di rumah-rumah."
 },
 {
   "id": 1011,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 30,
   "firman": "Yakub berkata kepada Simeon dan Lewi: \"Kamu telah mencelakakan aku dengan membusukkan namaku kepada penduduk negeri ini, kepada orang Kanaan dan orang Feris, padahal kita ini hanya sedikit jumlahnya; apabila mereka bersekutu melawan kita, tentulah mereka akan memukul kita kalah, dan kita akan dipunahkan, aku beserta seisi rumahku.\""
 },
 {
   "id": 1012,
   "kitab": "Kej",
   "pasal": 34,
   "ayat": 31,
   "firman": "Tetapi jawab mereka: \"Mengapa adik kita diperlakukannya sebagai seorang perempuan sundal!\""
 },
 {
   "id": 1013,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 1,
   "firman": "Allah berfirman kepada Yakub: \"Bersiaplah, pergilah ke Betel, tinggallah di situ, dan buatlah di situ mezbah bagi Allah, yang telah menampakkan diri kepadamu, ketika engkau lari dari Esau, kakakmu.\""
 },
 {
   "id": 1014,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 2,
   "firman": "Lalu berkatalah Yakub kepada seisi rumahnya dan kepada semua orang yang bersama-sama dengan dia: \"Jauhkanlah dewa-dewa asing yang ada di tengah-tengah kamu, tahirkanlah dirimu dan tukarlah pakaianmu."
 },
 {
   "id": 1015,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 3,
   "firman": "Marilah kita bersiap dan pergi ke Betel; aku akan membuat mezbah di situ bagi Allah, yang telah menjawab aku pada masa kesesakanku dan yang telah menyertai aku di jalan yang kutempuh.\""
 },
 {
   "id": 1016,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 4,
   "firman": "Mereka menyerahkan kepada Yakub segala dewa asing yang dipunyai mereka dan anting-anting yang ada pada telinga mereka, lalu Yakub menanamnya di bawah pohon besar yang dekat Sikhem."
 },
 {
   "id": 1017,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 5,
   "firman": "Sesudah itu berangkatlah mereka. Dan kedahsyatan yang dari Allah meliputi kota-kota sekeliling mereka, sehingga anak-anak Yakub tidak dikejar."
 },
 {
   "id": 1018,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 6,
   "firman": "Lalu sampailah Yakub ke Lus yang di tanah Kanaan--yaitu Betel--,ia dan semua orang yang bersama-sama dengan dia."
 },
 {
   "id": 1019,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 7,
   "firman": "Didirikannyalah mezbah di situ, dan dinamainyalah tempat itu El-Betel, karena Allah telah menyatakan diri kepadanya di situ, ketika ia lari terhadap kakaknya."
 },
 {
   "id": 1020,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 8,
   "firman": "Ketika Debora, inang pengasuh Ribka, mati, dikuburkanlah ia di sebelah hilir Betel di bawah pohon besar, yang dinamai orang: Pohon Besar Penangisan."
 },
 {
   "id": 1021,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 9,
   "firman": "Setelah Yakub datang dari Padan-Aram, maka Allah menampakkan diri pula kepadanya dan memberkati dia."
 },
 {
   "id": 1022,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 10,
   "firman": "Firman Allah kepadanya: \"Namamu Yakub; dari sekarang namamu bukan lagi Yakub, melainkan Israel, itulah yang akan menjadi namamu.\" Maka Allah menamai dia Israel."
 },
 {
   "id": 1023,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 11,
   "firman": "Lagi firman Allah kepadanya: \"Akulah Allah Yang Mahakuasa. Beranakcuculah dan bertambah banyak; satu bangsa, bahkan sekumpulan bangsa-bangsa, akan terjadi dari padamu dan raja-raja akan berasal dari padamu."
 },
 {
   "id": 1024,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 12,
   "firman": "Dan negeri ini yang telah Kuberikan kepada Abraham dan kepada Ishak, akan Kuberikan kepadamu dan juga kepada keturunanmu.\""
 },
 {
   "id": 1025,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 13,
   "firman": "Lalu naiklah Allah meninggalkan Yakub dari tempat Ia berfirman kepadanya."
 },
 {
   "id": 1026,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 14,
   "firman": "Kemudian Yakub mendirikan tugu di tempat itu, yakni tugu batu; ia mempersembahkan korban curahan dan menuangkan minyak di atasnya."
 },
 {
   "id": 1027,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 15,
   "firman": "Yakub menamai tempat di mana Allah telah berfirman kepadanya \"Betel\"."
 },
 {
   "id": 1028,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 16,
   "firman": "Sesudah itu berangkatlah mereka dari Betel. Ketika mereka tidak berapa jauh lagi dari Efrata, bersalinlah Rahel, dan bersalinnya itu sangat sukar."
 },
 {
   "id": 1029,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 17,
   "firman": "Sedang ia sangat sukar bersalin, berkatalah bidan kepadanya: \"Janganlah takut, sekali inipun anak laki-laki yang kaudapat.\""
 },
 {
   "id": 1030,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 18,
   "firman": "Dan ketika ia hendak menghembuskan nafas--sebab ia mati kemudian--diberikannyalah nama Ben-oni kepada anak itu, tetapi ayahnya menamainya Benyamin."
 },
 {
   "id": 1031,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 19,
   "firman": "Demikianlah Rahel mati, lalu ia dikuburkan di sisi jalan ke Efrata, yaitu Betlehem."
 },
 {
   "id": 1032,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 20,
   "firman": "Yakub mendirikan tugu di atas kuburnya; itulah tugu kubur Rahel sampai sekarang."
 },
 {
   "id": 1033,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 21,
   "firman": "Sesudah itu berangkatlah Israel, lalu ia memasang kemahnya di seberang Migdal-Eder."
 },
 {
   "id": 1034,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 22,
   "firman": "Ketika Israel diam di negeri ini, terjadilah bahwa Ruben sampai tidur dengan Bilha, gundik ayahnya, dan kedengaranlah hal itu kepada Israel."
 },
 {
   "id": 1036,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 23,
   "firman": "Anak-anak Lea ialah Ruben, anak sulung Yakub, kemudian Simeon, Lewi, Yehuda, Isakhar dan Zebulon."
 },
 {
   "id": 1037,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 24,
   "firman": "Anak-anak Rahel ialah Yusuf dan Benyamin."
 },
 {
   "id": 1038,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 25,
   "firman": "Dan anak-anak Bilha, budak perempuan Rahel ialah Dan serta Naftali."
 },
 {
   "id": 1039,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 26,
   "firman": "Dan anak-anak Zilpa, budak perempuan Lea ialah Gad dan Asyer. Itulah anak-anak lelaki Yakub, yang dilahirkan baginya di Padan-Aram."
 },
 {
   "id": 1040,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 27,
   "firman": "Lalu sampailah Yakub kepada Ishak, ayahnya, di Mamre dekat Kiryat-Arba--itulah Hebron--tempat Abraham dan Ishak tinggal sebagai orang asing."
 },
 {
   "id": 1041,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 28,
   "firman": "Adapun umur Ishak seratus delapan puluh tahun."
 },
 {
   "id": 1042,
   "kitab": "Kej",
   "pasal": 35,
   "ayat": 29,
   "firman": "Lalu meninggallah Ishak, ia mati dan dikumpulkan kepada kaum leluhurnya; ia tua dan suntuk umur, maka Esau dan Yakub, anak-anaknya itu, menguburkan dia."
 },
 {
   "id": 1043,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 1,
   "firman": "Inilah keturunan Esau, yaitu Edom."
 },
 {
   "id": 1044,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 2,
   "firman": "Esau mengambil perempuan-perempuan Kanaan menjadi isterinya, yakni Ada, anak Elon orang Het, dan Oholibama, anak Ana anak Zibeon orang Hewi,"
 },
 {
   "id": 1045,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 3,
   "firman": "dan Basmat, anak Ismael, adik Nebayot."
 },
 {
   "id": 1046,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 4,
   "firman": "Ada melahirkan Elifas bagi Esau, dan Basmat melahirkan Rehuel,"
 },
 {
   "id": 1047,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 5,
   "firman": "dan Oholibama melahirkan Yeush, Yaelam dan Korah. Itulah anak-anak Esau, yang lahir baginya di tanah Kanaan."
 },
 {
   "id": 1048,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 6,
   "firman": "Esau membawa isteri-isterinya, anak-anaknya lelaki dan perempuan dan semua orang yang ada di rumahnya, ternaknya, segala hewannya dan segala harta bendanya yang telah diperolehnya di tanah Kanaan, lalu pergilah ia ke negeri lain dan ia meninggalkan Yakub, adiknya itu."
 },
 {
   "id": 1049,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 7,
   "firman": "Sebab harta milik mereka terlalu banyak, sehingga mereka tidak dapat tinggal bersama-sama, dan negeri penumpangan mereka tidak dapat memuat mereka karena banyaknya ternak mereka itu."
 },
 {
   "id": 1050,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 8,
   "firman": "Maka menetaplah Esau di pegunungan Seir; Esau itulah Edom."
 },
 {
   "id": 1051,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 9,
   "firman": "Inilah keturunan Esau, bapa orang Edom, di pegunungan Seir."
 },
 {
   "id": 1052,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 10,
   "firman": "Nama anak-anaknya ialah: Elifas, anak Ada isteri Esau; Rehuel, anak Basmat isteri Esau."
 },
 {
   "id": 1053,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 11,
   "firman": "Anak-anak Elifas ialah Teman, Omar, Zefo, Gaetam dan Kenas."
 },
 {
   "id": 1054,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 12,
   "firman": "Timna adalah gundik Elifas anak Esau; ia melahirkan Amalek bagi Elifas. Itulah cucu-cucu Ada isteri Esau."
 },
 {
   "id": 1055,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 13,
   "firman": "Inilah anak-anak Rehuel: Nahat, Zerah, Syama dan Miza. Itulah cucu-cucu Basmat isteri Esau."
 },
 {
   "id": 1056,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 14,
   "firman": "Inilah anak-anak Oholibama, isteri Esau itu, anak Ana anak Zibeon; ia melahirkan bagi Esau: Yeush, Yaelam dan Korah."
 },
 {
   "id": 1057,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 15,
   "firman": "Inilah kepala-kepala kaum bani Esau: keturunan Elifas anak sulung Esau, ialah kepala kaum Teman, kepala kaum Omar, kepala kaum Zefo, kepala kaum Kenas,"
 },
 {
   "id": 1058,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 16,
   "firman": "kepala kaum Korah, kepala kaum Gaetam dan kepala kaum Amalek; itulah kepala-kepala kaum Elifas di tanah Edom; itulah keturunan Ada."
 },
 {
   "id": 1059,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 17,
   "firman": "Inilah keturunan Rehuel anak Esau: kepala kaum Nahat, kepala kaum Zerah, kepala kaum Syama dan kepala kaum Miza; itulah kepala-kepala kaum Rehuel di tanah Edom; itulah keturunan Basmat isteri Esau."
 },
 {
   "id": 1060,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 18,
   "firman": "Inilah keturunan Oholibama isteri Esau: kepala kaum Yeush, kepala kaum Yaelam, kepala kaum Korah; itulah kepala-kepala kaum Oholibama, isteri Esau, anak Ana."
 },
 {
   "id": 1061,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 19,
   "firman": "Itulah bani Esau, yakni Edom, dan itulah kepala-kepala kaum mereka."
 },
 {
   "id": 1062,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 20,
   "firman": "Inilah anak-anak Seir, orang Hori, penduduk negeri itu: Lotan, Syobal, Zibeon, Ana,"
 },
 {
   "id": 1063,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 21,
   "firman": "Disyon, Ezer, Disyan; itulah kepala-kepala kaum orang Hori, anak-anak Seir, di tanah Edom."
 },
 {
   "id": 1064,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 22,
   "firman": "Anak-anak Lotan ialah Hori dan Heman, dan saudara perempuan Lotan ialah Timna."
 },
 {
   "id": 1065,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 23,
   "firman": "Inilah anak-anak Syobal: Alwan, Manahat, Ebal, Syefo dan Onam."
 },
 {
   "id": 1066,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 24,
   "firman": "Inilah anak-anak Zibeon: Aya dan Ana; Ana inilah yang menemui mata-mata air panas di padang gurun, ketika ia sedang menggembalakan keledai Zibeon ayahnya itu."
 },
 {
   "id": 1067,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 25,
   "firman": "Inilah anak-anak Ana: Disyon dan Oholibama anak perempuan Ana."
 },
 {
   "id": 1068,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 26,
   "firman": "Inilah anak-anak Disyon: Hemdan, Esyban, Yitran dan Keran."
 },
 {
   "id": 1069,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 27,
   "firman": "Inilah anak-anak Ezer: Bilhan, Zaawan dan Akan."
 },
 {
   "id": 1070,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 28,
   "firman": "Inilah anak-anak Disyan: Us dan Aran."
 },
 {
   "id": 1071,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 29,
   "firman": "Itulah kepala-kepala kaum orang Hori: kepala kaum Lotan, kepala kaum Syobal, kepala kaum Zibeon, kepala kaum Ana,"
 },
 {
   "id": 1072,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 30,
   "firman": "kepala kaum Disyon, kepala kaum Ezer dan kepala kaum Disyan; itulah kepala-kepala kaum orang Hori, kaum demi kaum, di tanah Seir."
 },
 {
   "id": 1073,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 31,
   "firman": "Inilah raja-raja yang memerintah di tanah Edom, sebelum ada seorang raja memerintah atas orang Israel."
 },
 {
   "id": 1074,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 32,
   "firman": "Di Edom yang memerintah ialah Bela bin Beor dan kotanya bernama Dinhaba."
 },
 {
   "id": 1075,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 33,
   "firman": "Setelah Bela mati, Yobab bin Zerah dari Bozra menjadi raja menggantikan dia."
 },
 {
   "id": 1076,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 34,
   "firman": "Setelah Yobab mati, Husyam, dari negeri orang Teman, menjadi raja menggantikan dia."
 },
 {
   "id": 1077,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 35,
   "firman": "Setelah Husyam mati, Hadad bin Bedad menjadi raja menggantikan dia; dialah yang memukul kalah orang Midian di daerah Moab, dan kotanya bernama Awit."
 },
 {
   "id": 1078,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 36,
   "firman": "Setelah Hadad mati, Samla dari Masreka menjadi raja menggantikan dia."
 },
 {
   "id": 1079,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 37,
   "firman": "Setelah Samla mati, Saul, dari Rehobot yang di pinggir sungai, menjadi raja menggantikan dia."
 },
 {
   "id": 1080,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 38,
   "firman": "Setelah Saul mati, Baal-Hanan bin Akhbor menjadi raja menggantikan dia."
 },
 {
   "id": 1081,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 39,
   "firman": "Setelah Baal-Hanan bin Akhbor mati, Hadar menjadi raja menggantikan dia; kotanya bernama Pahu dan isterinya bernama Mehetabeel binti Matred binti Mezahab."
 },
 {
   "id": 1082,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 40,
   "firman": "Inilah nama kepala-kepala kaum Esau menurut kaum dan tempat mereka, dengan nama mereka masing-masing: kepala kaum Timna, kepala kaum Alwa, kepala kaum Yetet,"
 },
 {
   "id": 1083,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 41,
   "firman": "kepala kaum Oholibama, kepala kaum Ela, kepala kaum Pinon,"
 },
 {
   "id": 1084,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 42,
   "firman": "kepala kaum Kenas, kepala kaum Teman, kepala kaum Mibzar,"
 },
 {
   "id": 1085,
   "kitab": "Kej",
   "pasal": 36,
   "ayat": 43,
   "firman": "kepala kaum Magdiel dan kepala kaum Iram; itulah kepala-kepala kaum Edom, menurut tempat kediaman mereka di tanah milik mereka; Edom ialah Esau, bapa orang Edom."
 },
 {
   "id": 1086,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 1,
   "firman": "Adapun Yakub, ia diam di negeri penumpangan ayahnya, yakni di tanah Kanaan."
 },
 {
   "id": 1087,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 2,
   "firman": "Inilah riwayat keturunan Yakub. Yusuf, tatkala berumur tujuh belas tahun--jadi masih muda--biasa menggembalakan kambing domba, bersama-sama dengan saudara-saudaranya, anak-anak Bilha dan Zilpa, kedua isteri ayahnya. Dan Yusuf menyampaikan kepada ayahnya kabar tentang kejahatan saudara-saudaranya."
 },
 {
   "id": 1088,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 3,
   "firman": "Israel lebih mengasihi Yusuf dari semua anaknya yang lain, sebab Yusuf itulah anaknya yang lahir pada masa tuanya; dan ia menyuruh membuat jubah yang maha indah bagi dia."
 },
 {
   "id": 1089,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 4,
   "firman": "Setelah dilihat oleh saudara-saudaranya, bahwa ayahnya lebih mengasihi Yusuf dari semua saudaranya, maka bencilah mereka itu kepadanya dan tidak mau menyapanya dengan ramah."
 },
 {
   "id": 1090,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 5,
   "firman": "Pada suatu kali bermimpilah Yusuf, lalu mimpinya itu diceritakannya kepada saudara-saudaranya; sebab itulah mereka lebih benci lagi kepadanya."
 },
 {
   "id": 1091,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 6,
   "firman": "Karena katanya kepada mereka: \"Coba dengarkan mimpi yang kumimpikan ini:"
 },
 {
   "id": 1092,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 7,
   "firman": "Tampak kita sedang di ladang mengikat berkas-berkas gandum, lalu bangkitlah berkasku dan tegak berdiri; kemudian datanglah berkas-berkas kamu sekalian mengelilingi dan sujud menyembah kepada berkasku itu.\""
 },
 {
   "id": 1093,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 8,
   "firman": "Lalu saudara-saudaranya berkata kepadanya: \"Apakah engkau ingin menjadi raja atas kami? Apakah engkau ingin berkuasa atas kami?\" Jadi makin bencilah mereka kepadanya karena mimpinya dan karena perkataannya itu."
 },
 {
   "id": 1094,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 9,
   "firman": "Lalu ia memimpikan pula mimpi yang lain, yang diceritakannya kepada saudara-saudaranya. Katanya: \"Aku bermimpi pula: Tampak matahari, bulan dan sebelas bintang sujud menyembah kepadaku.\""
 },
 {
   "id": 1095,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 10,
   "firman": "Setelah hal ini diceritakannya kepada ayah dan saudara-saudaranya, maka ia ditegor oleh ayahnya: \"Mimpi apa mimpimu itu? Masakan aku dan ibumu serta saudara-saudaramu sujud menyembah kepadamu sampai ke tanah?\""
 },
 {
   "id": 1096,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 11,
   "firman": "Maka iri hatilah saudara-saudaranya kepadanya, tetapi ayahnya menyimpan hal itu dalam hatinya."
 },
 {
   "id": 1097,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 12,
   "firman": "Pada suatu kali pergilah saudara-saudaranya menggembalakan kambing domba ayahnya dekat Sikhem."
 },
 {
   "id": 1098,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 13,
   "firman": "Lalu Israel berkata kepada Yusuf: \"Bukankah saudara-saudaramu menggembalakan kambing domba dekat Sikhem? Marilah engkau kusuruh kepada mereka.\" Sahut Yusuf: \"Ya bapa.\""
 },
 {
   "id": 1099,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 14,
   "firman": "Kata Israel kepadanya: \"Pergilah engkau melihat apakah baik keadaan saudara-saudaramu dan keadaan kambing domba; dan bawalah kabar tentang itu kepadaku.\" Lalu Yakub menyuruh dia dari lembah Hebron, dan Yusufpun sampailah ke Sikhem."
 },
 {
   "id": 1100,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 15,
   "firman": "Ketika Yusuf berjalan ke sana ke mari di padang, bertemulah ia dengan seorang laki-laki, yang bertanya kepadanya: \"Apakah yang kaucari?\""
 },
 {
   "id": 1101,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 16,
   "firman": "Sahutnya: \"Aku mencari saudara-saudaraku. Tolonglah katakan kepadaku di mana mereka menggembalakan kambing domba?\""
 },
 {
   "id": 1102,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 17,
   "firman": "Lalu kata orang itu: \"Mereka telah berangkat dari sini, sebab telah kudengar mereka berkata: Marilah kita pergi ke Dotan.\" Maka Yusuf menyusul saudara-saudaranya itu dan didapatinyalah mereka di Dotan."
 },
 {
   "id": 1103,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 18,
   "firman": "Dari jauh ia telah kelihatan kepada mereka. Tetapi sebelum ia dekat pada mereka, mereka telah bermufakat mencari daya upaya untuk membunuhnya."
 },
 {
   "id": 1104,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 19,
   "firman": "Kata mereka seorang kepada yang lain: \"Lihat, tukang mimpi kita itu datang!"
 },
 {
   "id": 1105,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 20,
   "firman": "Sekarang, marilah kita bunuh dia dan kita lemparkan ke dalam salah satu sumur ini, lalu kita katakan: seekor binatang buas telah menerkamnya. Dan kita akan lihat nanti, bagaimana jadinya mimpinya itu!\""
 },
 {
   "id": 1106,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 21,
   "firman": "Ketika Ruben mendengar hal ini, ia ingin melepaskan Yusuf dari tangan mereka, sebab itu katanya: \"Janganlah kita bunuh dia!\""
 },
 {
   "id": 1107,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 22,
   "firman": "Lagi kata Ruben kepada mereka: \"Janganlah tumpahkan darah, lemparkanlah dia ke dalam sumur yang ada di padang gurun ini, tetapi janganlah apa-apakan dia\" --maksudnya hendak melepaskan Yusuf dari tangan mereka dan membawanya kembali kepada ayahnya."
 },
 {
   "id": 1108,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 23,
   "firman": "Baru saja Yusuf sampai kepada saudara-saudaranya, merekapun menanggalkan jubah Yusuf, jubah maha indah yang dipakainya itu."
 },
 {
   "id": 1109,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 24,
   "firman": "Dan mereka membawa dia dan melemparkan dia ke dalam sumur. Sumur itu kosong, tidak berair."
 },
 {
   "id": 1110,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 25,
   "firman": "Kemudian duduklah mereka untuk makan. Ketika mereka mengangkat muka, kelihatanlah kepada mereka suatu kafilah orang Ismael datang dari Gilead dengan untanya yang membawa damar, balsam dan damar ladan, dalam perjalanannya mengangkut barang-barang itu ke Mesir."
 },
 {
   "id": 1111,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 26,
   "firman": "Lalu kata Yehuda kepada saudara-saudaranya itu: \"Apakah untungnya kalau kita membunuh adik kita itu dan menyembunyikan darahnya?"
 },
 {
   "id": 1112,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 27,
   "firman": "Marilah kita jual dia kepada orang Ismael ini, tetapi janganlah kita apa-apakan dia, karena ia saudara kita, darah daging kita.\" Dan saudara-saudaranya mendengarkan perkataannya itu."
 },
 {
   "id": 1113,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 28,
   "firman": "Ketika ada saudagar-saudagar Midian lewat, Yusuf diangkat ke atas dari dalam sumur itu, kemudian dijual kepada orang Ismael itu dengan harga dua puluh syikal perak. Lalu Yusuf dibawa mereka ke Mesir."
 },
 {
   "id": 1114,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 29,
   "firman": "Ketika Ruben kembali ke sumur itu, ternyata Yusuf tidak ada lagi di dalamnya. Lalu dikoyakkannyalah bajunya,"
 },
 {
   "id": 1115,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 30,
   "firman": "dan kembalilah ia kepada saudara-saudaranya, katanya: \"Anak itu tidak ada lagi, ke manakah aku ini?\""
 },
 {
   "id": 1116,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 31,
   "firman": "Kemudian mereka mengambil jubah Yusuf, dan menyembelih seekor kambing, lalu mencelupkan jubah itu ke dalam darahnya."
 },
 {
   "id": 1117,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 32,
   "firman": "Jubah maha indah itu mereka suruh antarkan kepada ayah mereka dengan pesan: \"Ini kami dapati. Silakanlah bapa periksa apakah jubah ini milik anak bapa atau tidak?\""
 },
 {
   "id": 1118,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 33,
   "firman": "Ketika Yakub memeriksa jubah itu, ia berkata: \"Ini jubah anakku; binatang buas telah memakannya; tentulah Yusuf telah diterkam.\""
 },
 {
   "id": 1119,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 34,
   "firman": "Dan Yakub mengoyakkan jubahnya, lalu mengenakan kain kabung pada pinggangnya dan berkabunglah ia berhari-hari lamanya karena anaknya itu."
 },
 {
   "id": 1120,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 35,
   "firman": "Sekalian anaknya laki-laki dan perempuan berusaha menghiburkan dia, tetapi ia menolak dihiburkan, serta katanya: \"Tidak! Aku akan berkabung, sampai aku turun mendapatkan anakku, ke dalam dunia orang mati!\" Demikianlah Yusuf ditangisi oleh ayahnya."
 },
 {
   "id": 1121,
   "kitab": "Kej",
   "pasal": 37,
   "ayat": 36,
   "firman": "Adapun Yusuf, ia dijual oleh orang Midian itu ke Mesir, kepada Potifar, seorang pegawai istana Firaun, kepala pengawal raja."
 },
 {
   "id": 1122,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 1,
   "firman": "Pada waktu itu Yehuda meninggalkan saudara-saudaranya dan menumpang pada seorang Adulam, yang namanya Hira."
 },
 {
   "id": 1123,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 2,
   "firman": "Di situ Yehuda melihat anak perempuan seorang Kanaan; nama orang itu ialah Syua. Lalu Yehuda kawin dengan perempuan itu dan menghampirinya."
 },
 {
   "id": 1124,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 3,
   "firman": "Perempuan itu mengandung, lalu melahirkan seorang anak laki-laki dan menamai anak itu Er."
 },
 {
   "id": 1125,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 4,
   "firman": "Sesudah itu perempuan itu mengandung lagi, lalu melahirkan seorang anak laki-laki dan menamai anak itu Onan."
 },
 {
   "id": 1126,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 5,
   "firman": "Kemudian perempuan itu melahirkan seorang anak laki-laki sekali lagi, dan menamai anak itu Syela. Yehuda sedang berada di Kezib, ketika anak itu dilahirkan."
 },
 {
   "id": 1127,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 6,
   "firman": "Sesudah itu Yehuda mengambil bagi Er, anak sulungnya, seorang isteri, yang bernama Tamar."
 },
 {
   "id": 1128,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 7,
   "firman": "Tetapi Er, anak sulung Yehuda itu, adalah jahat di mata TUHAN, maka TUHAN membunuh dia."
 },
 {
   "id": 1129,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 8,
   "firman": "Lalu berkatalah Yehuda kepada Onan: \"Hampirilah isteri kakakmu itu, kawinlah dengan dia sebagai ganti kakakmu dan bangkitkanlah keturunan bagi kakakmu.\""
 },
 {
   "id": 1130,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 9,
   "firman": "Tetapi Onan tahu, bahwa bukan ia yang empunya keturunannya nanti, sebab itu setiap kali ia menghampiri isteri kakaknya itu, ia membiarkan maninya terbuang, supaya ia jangan memberi keturunan kepada kakaknya."
 },
 {
   "id": 1131,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 10,
   "firman": "Tetapi yang dilakukannya itu adalah jahat di mata TUHAN, maka TUHAN membunuh dia juga."
 },
 {
   "id": 1132,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 11,
   "firman": "Lalu berkatalah Yehuda kepada Tamar, menantunya itu: \"Tinggallah sebagai janda di rumah ayahmu, sampai anakku Syela itu besar,\" sebab pikirnya: \"Jangan-jangan ia mati seperti kedua kakaknya itu.\" Maka pergilah Tamar dan tinggal di rumah ayahnya."
 },
 {
   "id": 1133,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 12,
   "firman": "Setelah beberapa lama matilah anak Syua, isteri Yehuda. Habis berkabung pergilah Yehuda ke Timna, kepada orang-orang yang menggunting bulu domba-dombanya, bersama dengan Hira, sahabatnya, orang Adulam itu."
 },
 {
   "id": 1134,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 13,
   "firman": "Ketika dikabarkan kepada Tamar: \"Bapa mertuamu sedang di jalan ke Timna untuk menggunting bulu domba-dombanya,\""
 },
 {
   "id": 1135,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 14,
   "firman": "maka ditanggalkannyalah pakaian kejandaannya, ia bertelekung dan berselubung, lalu pergi duduk di pintu masuk ke Enaim yang di jalan ke Timna, karena dilihatnya, bahwa Syela telah menjadi besar, dan dia tidak diberikan juga kepada Syela itu untuk menjadi isterinya."
 },
 {
   "id": 1136,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 15,
   "firman": "Ketika Yehuda melihat dia, disangkanyalah dia seorang perempuan sundal, karena ia menutupi mukanya."
 },
 {
   "id": 1137,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 16,
   "firman": "Lalu berpalinglah Yehuda mendapatkan perempuan yang di pinggir jalan itu serta berkata: \"Marilah, aku mau menghampiri engkau,\" sebab ia tidak tahu, bahwa perempuan itu menantunya. Tanya perempuan itu: \"Apakah yang akan kauberikan kepadaku, jika engkau menghampiri aku?\""
 },
 {
   "id": 1138,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 17,
   "firman": "Jawabnya: \"Aku akan mengirimkan kepadamu seekor anak kambing dari kambing dombaku.\" Kata perempuan itu: \"Asal engkau memberikan tanggungannya, sampai engkau mengirimkannya kepadaku.\""
 },
 {
   "id": 1139,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 18,
   "firman": "Tanyanya: \"Apakah tanggungan yang harus kuberikan kepadamu?\" Jawab perempuan itu: \"Cap meteraimu serta kalungmu dan tongkat yang ada di tanganmu itu.\" Lalu diberikannyalah semuanya itu kepadanya, maka ia menghampirinya. Perempuan itu mengandung dari padanya."
 },
 {
   "id": 1140,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 19,
   "firman": "Bangunlah perempuan itu, lalu pergi, ditanggalkannya telekungnya dan dikenakannya pula pakaian kejandaannya."
 },
 {
   "id": 1141,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 20,
   "firman": "Adapun Yehuda, ia mengirimkan anak kambing itu dengan perantaraan sahabatnya, orang Adulam itu, untuk mengambil kembali tanggungannya dari tangan perempuan itu, tetapi perempuan itu tidak dijumpainya lagi."
 },
 {
   "id": 1142,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 21,
   "firman": "Ia bertanya-tanya di tempat tinggal perempuan itu: \"Di manakah perempuan jalang, yang duduk tadinya di pinggir jalan di Enaim itu?\" Jawab mereka: \"Tidak ada di sini perempuan jalang.\""
 },
 {
   "id": 1143,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 22,
   "firman": "Kembalilah ia kepada Yehuda dan berkata: \"Tidak ada kujumpai dia; dan juga orang-orang di tempat itu berkata: Tidak ada perempuan jalang di sini.\""
 },
 {
   "id": 1144,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 23,
   "firman": "Lalu berkatalah Yehuda: \"Biarlah barang-barang itu dipegangnya, supaya kita jangan menjadi buah olok-olok orang; sungguhlah anak kambing itu telah kukirimkan, tetapi engkau tidak menjumpai perempuan itu.\""
 },
 {
   "id": 1145,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 24,
   "firman": "Sesudah kira-kira tiga bulan dikabarkanlah kepada Yehuda: \"Tamar, menantumu, bersundal, bahkan telah mengandung dari persundalannya itu.\" Lalu kata Yehuda: \"Bawalah perempuan itu, supaya dibakar.\""
 },
 {
   "id": 1146,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 25,
   "firman": "Waktu dibawa, perempuan itu menyuruh orang kepada mertuanya mengatakan: \"Dari laki-laki yang empunya barang-barang inilah aku mengandung.\" Juga dikatakannya: \"Periksalah, siapa yang empunya cap meterai serta kalung dan tongkat ini?\""
 },
 {
   "id": 1147,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 26,
   "firman": "Yehuda memeriksa barang-barang itu, lalu berkata: \"Bukan aku, tetapi perempuan itulah yang benar, karena memang aku tidak memberikan dia kepada Syela, anakku.\" Dan ia tidak bersetubuh lagi dengan perempuan itu."
 },
 {
   "id": 1148,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 27,
   "firman": "Pada waktu perempuan itu hendak bersalin, nyatalah ada anak kembar dalam kandungannya."
 },
 {
   "id": 1149,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 28,
   "firman": "Dan ketika ia bersalin, seorang dari anak itu mengeluarkan tangannya, lalu dipegang oleh bidan, diikatnya dengan benang kirmizi serta berkata: \"Inilah yang lebih dahulu keluar.\""
 },
 {
   "id": 1150,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 29,
   "firman": "Ketika anak itu menarik tangannya kembali, keluarlah saudaranya laki-laki, dan bidan itu berkata: \"Alangkah kuatnya engkau menembus ke luar,\" maka anak itu dinamai Peres."
 },
 {
   "id": 1151,
   "kitab": "Kej",
   "pasal": 38,
   "ayat": 30,
   "firman": "Sesudah itu keluarlah saudaranya laki-laki yang tangannya telah berikat benang kirmizi itu, lalu kepadanya diberi nama Zerah."
 },
 {
   "id": 1152,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 1,
   "firman": "Adapun Yusuf telah dibawa ke Mesir; dan Potifar, seorang Mesir, pegawai istana Firaun, kepala pengawal raja, membeli dia dari tangan orang Ismael yang telah membawa dia ke situ."
 },
 {
   "id": 1153,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 2,
   "firman": "Tetapi TUHAN menyertai Yusuf, sehingga ia menjadi seorang yang selalu berhasil dalam pekerjaannya; maka tinggallah ia di rumah tuannya, orang Mesir itu."
 },
 {
   "id": 1154,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 3,
   "firman": "Setelah dilihat oleh tuannya, bahwa Yusuf disertai TUHAN dan bahwa TUHAN membuat berhasil segala sesuatu yang dikerjakannya,"
 },
 {
   "id": 1155,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 4,
   "firman": "maka Yusuf mendapat kasih tuannya, dan ia boleh melayani dia; kepada Yusuf diberikannya kuasa atas rumahnya dan segala miliknya diserahkannya pada kekuasaan Yusuf."
 },
 {
   "id": 1156,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 5,
   "firman": "Sejak ia memberikan kuasa dalam rumahnya dan atas segala miliknya kepada Yusuf, TUHAN memberkati rumah orang Mesir itu karena Yusuf, sehingga berkat TUHAN ada atas segala miliknya, baik yang di rumah maupun yang di ladang."
 },
 {
   "id": 1157,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 6,
   "firman": "Segala miliknya diserahkannya pada kekuasaan Yusuf, dan dengan bantuan Yusuf ia tidak usah lagi mengatur apa-apapun selain dari makanannya sendiri. Adapun Yusuf itu manis sikapnya dan elok parasnya."
 },
 {
   "id": 1158,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 7,
   "firman": "Selang beberapa waktu isteri tuannya memandang Yusuf dengan berahi, lalu katanya: \"Marilah tidur dengan aku.\""
 },
 {
   "id": 1159,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 8,
   "firman": "Tetapi Yusuf menolak dan berkata kepada isteri tuannya itu: \"Dengan bantuanku tuanku itu tidak lagi mengatur apa yang ada di rumah ini dan ia telah menyerahkan segala miliknya pada kekuasaanku,"
 },
 {
   "id": 1160,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 9,
   "firman": "bahkan di rumah ini ia tidak lebih besar kuasanya dari padaku, dan tiada yang tidak diserahkannya kepadaku selain dari pada engkau, sebab engkau isterinya. Bagaimanakah mungkin aku melakukan kejahatan yang besar ini dan berbuat dosa terhadap Allah?\""
 },
 {
   "id": 1161,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 10,
   "firman": "Walaupun dari hari ke hari perempuan itu membujuk Yusuf, Yusuf tidak mendengarkan bujukannya itu untuk tidur di sisinya dan bersetubuh dengan dia."
 },
 {
   "id": 1162,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 11,
   "firman": "Pada suatu hari masuklah Yusuf ke dalam rumah untuk melakukan pekerjaannya, sedang dari seisi rumah itu seorangpun tidak ada di rumah."
 },
 {
   "id": 1163,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 12,
   "firman": "Lalu perempuan itu memegang baju Yusuf sambil berkata: \"Marilah tidur dengan aku.\" Tetapi Yusuf meninggalkan bajunya di tangan perempuan itu dan lari ke luar."
 },
 {
   "id": 1164,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 13,
   "firman": "Ketika dilihat perempuan itu, bahwa Yusuf meninggalkan bajunya dalam tangannya dan telah lari ke luar,"
 },
 {
   "id": 1165,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 14,
   "firman": "dipanggilnyalah seisi rumah itu, lalu katanya kepada mereka: \"Lihat, dibawanya ke mari seorang Ibrani, supaya orang ini dapat mempermainkan kita. Orang ini mendekati aku untuk tidur dengan aku, tetapi aku berteriak-teriak dengan suara keras."
 },
 {
   "id": 1166,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 15,
   "firman": "Dan ketika didengarnya bahwa aku berteriak sekeras-kerasnya, ditinggalkannyalah bajunya padaku, lalu ia lari ke luar.\""
 },
 {
   "id": 1167,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 16,
   "firman": "Juga ditaruhnya baju Yusuf itu di sisinya, sampai tuan rumah pulang."
 },
 {
   "id": 1168,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 17,
   "firman": "Perkataan itu jugalah yang diceritakan perempuan itu kepada Potifar, katanya: \"Hamba orang Ibrani yang kaubawa ke mari itu datang kepadaku untuk mempermainkan aku."
 },
 {
   "id": 1169,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 18,
   "firman": "Tetapi ketika aku berteriak sekeras-kerasnya, ditinggalkannya bajunya padaku, lalu ia lari ke luar.\""
 },
 {
   "id": 1170,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 19,
   "firman": "Baru saja didengar oleh tuannya perkataan yang diceritakan isterinya kepadanya: begini begitulah aku diperlakukan oleh hambamu itu, maka bangkitlah amarahnya."
 },
 {
   "id": 1171,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 20,
   "firman": "Lalu Yusuf ditangkap oleh tuannya dan dimasukkan ke dalam penjara, tempat tahanan-tahanan raja dikurung. Demikianlah Yusuf dipenjarakan di sana."
 },
 {
   "id": 1172,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 21,
   "firman": "Tetapi TUHAN menyertai Yusuf dan melimpahkan kasih setia-Nya kepadanya, dan membuat Yusuf kesayangan bagi kepala penjara itu."
 },
 {
   "id": 1173,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 22,
   "firman": "Sebab itu kepala penjara mempercayakan semua tahanan dalam penjara itu kepada Yusuf, dan segala pekerjaan yang harus dilakukan di situ, dialah yang mengurusnya."
 },
 {
   "id": 1174,
   "kitab": "Kej",
   "pasal": 39,
   "ayat": 23,
   "firman": "Dan kepala penjara tidak mencampuri segala yang dipercayakannya kepada Yusuf, karena TUHAN menyertai dia dan apa yang dikerjakannya dibuat TUHAN berhasil."
 },
 {
   "id": 1175,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 1,
   "firman": "Sesudah semuanya itu terjadilah, bahwa juru minuman raja Mesir dan juru rotinya membuat kesalahan terhadap tuannya, raja Mesir itu,"
 },
 {
   "id": 1176,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 2,
   "firman": "maka murkalah Firaun kepada kedua pegawai istananya, kepala juru minuman dan kepala juru roti itu."
 },
 {
   "id": 1177,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 3,
   "firman": "Ia menahan mereka dalam rumah kepala pengawal raja, dalam penjara tempat Yusuf dikurung."
 },
 {
   "id": 1178,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 4,
   "firman": "Kepala pengawal raja menempatkan Yusuf bersama-sama dengan mereka untuk melayani mereka. Demikianlah mereka ditahan beberapa waktu lamanya."
 },
 {
   "id": 1179,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 5,
   "firman": "Pada suatu kali bermimpilah mereka keduanya--baik juru minuman maupun juru roti raja Mesir, yang ditahan dalam penjara itu--masing-masing ada mimpinya, pada satu malam juga, dan mimpi masing-masing itu ada artinya sendiri."
 },
 {
   "id": 1180,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 6,
   "firman": "Ketika pada waktu pagi Yusuf datang kepada mereka, segera dilihatnya, bahwa mereka bersusah hati."
 },
 {
   "id": 1181,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 7,
   "firman": "Lalu ia bertanya kepada pegawai-pegawai istana Firaun yang ditahan bersama-sama dengan dia dalam rumah tuannya itu: \"Mengapakah hari ini mukamu semuram itu?\""
 },
 {
   "id": 1182,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 8,
   "firman": "Jawab mereka kepadanya: \"Kami bermimpi, tetapi tidak ada orang yang dapat mengartikannya.\" Lalu kata Yusuf kepada mereka: \"Bukankah Allah yang menerangkan arti mimpi? Ceritakanlah kiranya mimpimu itu kepadaku.\""
 },
 {
   "id": 1183,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 9,
   "firman": "Kemudian juru minuman itu menceritakan mimpinya kepada Yusuf, katanya: \"Dalam mimpiku itu tampak ada pohon anggur di depanku."
 },
 {
   "id": 1184,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 10,
   "firman": "Pohon anggur itu ada tiga carangnya dan baru saja pohon itu bertunas, bunganya sudah keluar dan tandan-tandannya penuh buah anggur yang ranum."
 },
 {
   "id": 1185,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 11,
   "firman": "Dan di tanganku ada piala Firaun. Buah anggur itu kuambil, lalu kuperas ke dalam piala Firaun, kemudian kusampaikan piala itu ke tangan Firaun.\""
 },
 {
   "id": 1186,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 12,
   "firman": "Kata Yusuf kepadanya: \"Beginilah arti mimpi itu: ketiga carang itu artinya tiga hari;"
 },
 {
   "id": 1187,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 13,
   "firman": "dalam tiga hari ini Firaun akan meninggikan engkau dan mengembalikan engkau ke dalam pangkatmu yang dahulu dan engkau akan menyampaikan piala ke tangan Firaun seperti dahulu kala, ketika engkau jadi juru minumannya."
 },
 {
   "id": 1188,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 14,
   "firman": "Tetapi, ingatlah kepadaku, apabila keadaanmu telah baik nanti, tunjukkanlah terima kasihmu kepadaku dengan menceritakan hal ihwalku kepada Firaun dan tolonglah keluarkan aku dari rumah ini."
 },
 {
   "id": 1189,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 15,
   "firman": "Sebab aku dicuri diculik begitu saja dari negeri orang Ibrani dan di sinipun aku tidak pernah melakukan apa-apa yang menyebabkan aku layak dimasukkan ke dalam liang tutupan ini.\""
 },
 {
   "id": 1190,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 16,
   "firman": "Setelah dilihat oleh kepala juru roti, betapa baik arti mimpi itu, berkatalah ia kepadanya: \"Akupun bermimpi juga. Tampak aku menjunjung tiga bakul berisi penganan."
 },
 {
   "id": 1191,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 17,
   "firman": "Dalam bakul atas ada berbagai-bagai makanan untuk Firaun, buatan juru roti, tetapi burung-burung memakannya dari dalam bakul yang di atas kepalaku.\""
 },
 {
   "id": 1192,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 18,
   "firman": "Yusuf menjawab: \"Beginilah arti mimpi itu: ketiga bakul itu artinya tiga hari;"
 },
 {
   "id": 1193,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 19,
   "firman": "dalam tiga hari ini Firaun akan meninggikan engkau, tinggi ke atas, dan menggantung engkau pada sebuah tiang, dan burung-burung akan memakan dagingmu dari tubuhmu.\""
 },
 {
   "id": 1194,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 20,
   "firman": "Dan terjadilah pada hari ketiga, hari kelahiran Firaun, maka Firaun mengadakan perjamuan untuk semua pegawainya. Ia meninggikan kepala juru minuman dan kepala juru roti itu di tengah-tengah para pegawainya:"
 },
 {
   "id": 1195,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 21,
   "firman": "kepala juru minuman itu dikembalikannya ke dalam jabatannya, sehingga ia menyampaikan pula piala ke tangan Firaun;"
 },
 {
   "id": 1196,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 22,
   "firman": "tetapi kepala juru roti itu digantungnya, seperti yang ditakbirkan Yusuf kepada mereka."
 },
 {
   "id": 1197,
   "kitab": "Kej",
   "pasal": 40,
   "ayat": 23,
   "firman": "Tetapi Yusuf tidaklah diingat oleh kepala juru minuman itu, melainkan dilupakannya."
 },
 {
   "id": 1198,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 1,
   "firman": "Setelah lewat dua tahun lamanya, bermimpilah Firaun, bahwa ia berdiri di tepi sungai Nil."
 },
 {
   "id": 1199,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 2,
   "firman": "Tampaklah dari sungai Nil itu keluar tujuh ekor lembu yang indah bangunnya dan gemuk badannya; lalu memakan rumput yang di tepi sungai itu."
 },
 {
   "id": 1200,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 3,
   "firman": "Kemudian tampaklah juga tujuh ekor lembu yang lain, yang keluar dari dalam sungai Nil itu, buruk bangunnya dan kurus badannya, lalu berdiri di samping lembu-lembu yang tadi, di tepi sungai itu."
 },
 {
   "id": 1201,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 4,
   "firman": "Lembu-lembu yang buruk bangunnya dan kurus badannya itu memakan ketujuh ekor lembu yang indah bangunnya dan gemuk itu. Lalu terjagalah Firaun."
 },
 {
   "id": 1202,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 5,
   "firman": "Setelah itu tertidur pulalah ia dan bermimpi kedua kalinya: Tampak timbul dari satu tangkai tujuh bulir gandum yang bernas dan baik."
 },
 {
   "id": 1203,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 6,
   "firman": "Tetapi kemudian tampaklah juga tumbuh tujuh bulir gandum yang kurus dan layu oleh angin timur."
 },
 {
   "id": 1204,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 7,
   "firman": "Bulir yang kurus itu menelan ketujuh bulir yang bernas dan berisi tadi. Lalu terjagalah Firaun. Agaknya ia bermimpi!"
 },
 {
   "id": 1205,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 8,
   "firman": "Pada waktu pagi gelisahlah hatinya, lalu disuruhnyalah memanggil semua ahli dan semua orang berilmu di Mesir. Firaun menceritakan mimpinya kepada mereka, tetapi seorangpun tidak ada yang dapat mengartikannya kepadanya."
 },
 {
   "id": 1206,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 9,
   "firman": "Lalu berkatalah kepala juru minuman kepada Firaun: \"Hari ini aku merasa perlu menyebutkan kesalahanku yang dahulu."
 },
 {
   "id": 1207,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 10,
   "firman": "Waktu itu tuanku Firaun murka kepada pegawai-pegawainya, dan menahan aku dalam rumah pengawal istana, beserta dengan kepala juru roti."
 },
 {
   "id": 1208,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 11,
   "firman": "Pada satu malam juga kami bermimpi, aku dan kepala juru roti itu; masing-masing mempunyai mimpi dengan artinya sendiri."
 },
 {
   "id": 1209,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 12,
   "firman": "Bersama-sama dengan kami ada di sana seorang muda Ibrani, hamba kepala pengawal istana itu; kami menceritakan mimpi kami kepadanya, lalu diartikannya kepada kami mimpi kami masing-masing."
 },
 {
   "id": 1210,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 13,
   "firman": "Dan seperti yang diartikannya itu kepada kami, demikianlah pula terjadi: aku dikembalikan ke dalam pangkatku, dan kepala juru roti itu digantung.\""
 },
 {
   "id": 1211,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 14,
   "firman": "Kemudian Firaun menyuruh memanggil Yusuf. Segeralah ia dikeluarkan dari tutupan; ia bercukur dan berganti pakaian, lalu pergi menghadap Firaun."
 },
 {
   "id": 1212,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 15,
   "firman": "Berkatalah Firaun kepada Yusuf: \"Aku telah bermimpi, dan seorangpun tidak ada yang dapat mengartikannya, tetapi telah kudengar tentang engkau: hanya dengan mendengar mimpi saja engkau dapat mengartikannya.\""
 },
 {
   "id": 1213,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 16,
   "firman": "Yusuf menyahut Firaun: \"Bukan sekali-kali aku, melainkan Allah juga yang akan memberitakan kesejahteraan kepada tuanku Firaun.\""
 },
 {
   "id": 1214,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 17,
   "firman": "Lalu berkatalah Firaun kepada Yusuf: \"Dalam mimpiku itu, aku berdiri di tepi sungai Nil;"
 },
 {
   "id": 1215,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 18,
   "firman": "lalu tampaklah dari sungai Nil itu keluar tujuh ekor lembu yang gemuk badannya dan indah bentuknya, dan makan rumput yang di tepi sungai itu."
 },
 {
   "id": 1216,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 19,
   "firman": "Tetapi kemudian tampaklah juga keluar tujuh ekor lembu yang lain, kulit pemalut tulang, sangat buruk bangunnya dan kurus badannya; tidak pernah kulihat yang seburuk itu di seluruh tanah Mesir."
 },
 {
   "id": 1217,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 20,
   "firman": "Lembu yang kurus dan buruk itu memakan ketujuh ekor lembu gemuk yang mula-mula."
 },
 {
   "id": 1218,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 21,
   "firman": "Lembu-lembu ini masuk ke dalam perutnya, tetapi walaupun telah masuk ke dalam perutnya, tidaklah kelihatan sedikitpun tandanya: bangunnya tetap sama buruknya seperti semula. Lalu terjagalah aku."
 },
 {
   "id": 1219,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 22,
   "firman": "Selanjutnya dalam mimpiku itu kulihat timbul dari satu tangkai tujuh bulir gandum yang berisi dan baik."
 },
 {
   "id": 1220,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 23,
   "firman": "Tetapi kemudian tampaklah juga tumbuh tujuh bulir yang kering, kurus dan layu oleh angin timur."
 },
 {
   "id": 1221,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 24,
   "firman": "Bulir yang kurus itu memakan ketujuh bulir yang baik tadi. Telah kuceritakan hal ini kepada semua ahli, tetapi seorangpun tidak ada yang dapat menerangkannya kepadaku.\""
 },
 {
   "id": 1222,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 25,
   "firman": "Lalu kata Yusuf kepada Firaun: \"Kedua mimpi tuanku Firaun itu sama. Allah telah memberitahukan kepada tuanku Firaun apa yang hendak dilakukan-Nya."
 },
 {
   "id": 1223,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 26,
   "firman": "Ketujuh ekor lembu yang baik itu ialah tujuh tahun, dan ketujuh bulir gandum yang baik itu ialah tujuh tahun juga; kedua mimpi itu sama."
 },
 {
   "id": 1224,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 27,
   "firman": "Ketujuh ekor lembu yang kurus dan buruk, yang keluar kemudian, maksudnya tujuh tahun, demikian pula ketujuh bulir gandum yang hampa dan layu oleh angin timur itu; maksudnya akan ada tujuh tahun kelaparan."
 },
 {
   "id": 1225,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 28,
   "firman": "Inilah maksud perkataanku, ketika aku berkata kepada tuanku Firaun: Allah telah memperlihatkan kepada tuanku Firaun apa yang hendak dilakukan-Nya."
 },
 {
   "id": 1226,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 29,
   "firman": "Ketahuilah tuanku, akan datang tujuh tahun kelimpahan di seluruh tanah Mesir."
 },
 {
   "id": 1227,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 30,
   "firman": "Kemudian akan timbul tujuh tahun kelaparan; maka akan dilupakan segala kelimpahan itu di tanah Mesir, karena kelaparan itu menguruskeringkan negeri ini."
 },
 {
   "id": 1228,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 31,
   "firman": "Sesudah itu akan tidak kelihatan lagi bekas-bekas kelimpahan di negeri ini karena kelaparan itu, sebab sangat hebatnya kelaparan itu."
 },
 {
   "id": 1229,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 32,
   "firman": "Sampai dua kali mimpi itu diulangi bagi tuanku Firaun berarti: hal itu telah ditetapkan oleh Allah dan Allah akan segera melakukannya."
 },
 {
   "id": 1230,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 33,
   "firman": "Oleh sebab itu, baiklah tuanku Firaun mencari seorang yang berakal budi dan bijaksana, dan mengangkatnya menjadi kuasa atas tanah Mesir."
 },
 {
   "id": 1231,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 34,
   "firman": "Baiklah juga tuanku Firaun berbuat begini, yakni menempatkan penilik-penilik atas negeri ini dan dalam ketujuh tahun kelimpahan itu memungut seperlima dari hasil tanah Mesir."
 },
 {
   "id": 1232,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 35,
   "firman": "Mereka harus mengumpulkan segala bahan makanan dalam tahun-tahun baik yang akan datang ini dan, di bawah kuasa tuanku Firaun, menimbun gandum di kota-kota sebagai bahan makanan, serta menyimpannya."
 },
 {
   "id": 1233,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 36,
   "firman": "Demikianlah segala bahan makanan itu menjadi persediaan untuk negeri ini dalam ketujuh tahun kelaparan yang akan terjadi di tanah Mesir, supaya negeri ini jangan binasa karena kelaparan itu.\""
 },
 {
   "id": 1234,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 37,
   "firman": "Usul itu dipandang baik oleh Firaun dan oleh semua pegawainya."
 },
 {
   "id": 1235,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 38,
   "firman": "Lalu berkatalah Firaun kepada para pegawainya: \"Mungkinkah kita mendapat orang seperti ini, seorang yang penuh dengan Roh Allah?\""
 },
 {
   "id": 1236,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 39,
   "firman": "Kata Firaun kepada Yusuf: \"Oleh karena Allah telah memberitahukan semuanya ini kepadamu, tidaklah ada orang yang demikian berakal budi dan bijaksana seperti engkau."
 },
 {
   "id": 1237,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 40,
   "firman": "Engkaulah menjadi kuasa atas istanaku, dan kepada perintahmu seluruh rakyatku akan taat; hanya takhta inilah kelebihanku dari padamu.\""
 },
 {
   "id": 1238,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 41,
   "firman": "Selanjutnya Firaun berkata kepada Yusuf: \"Dengan ini aku melantik engkau menjadi kuasa atas seluruh tanah Mesir.\""
 },
 {
   "id": 1239,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 42,
   "firman": "Sesudah itu Firaun menanggalkan cincin meterainya dari jarinya dan mengenakannya pada jari Yusuf; dipakaikannyalah kepada Yusuf pakaian dari pada kain halus dan digantungkannya kalung emas pada lehernya."
 },
 {
   "id": 1240,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 43,
   "firman": "Lalu Firaun menyuruh menaikkan Yusuf dalam keretanya yang kedua, dan berserulah orang di hadapan Yusuf: \"Hormat!\" Demikianlah Yusuf dilantik oleh Firaun menjadi kuasa atas seluruh tanah Mesir."
 },
 {
   "id": 1241,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 44,
   "firman": "Berkatalah Firaun kepada Yusuf: \"Akulah Firaun, tetapi dengan tidak setahumu, seorangpun tidak boleh bergerak di seluruh tanah Mesir.\""
 },
 {
   "id": 1242,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 45,
   "firman": "Lalu Firaun menamai Yusuf: Zafnat-Paaneah, serta memberikan Asnat, anak Potifera, imam di On, kepadanya menjadi isterinya. Demikianlah Yusuf muncul sebagai kuasa atas seluruh tanah Mesir."
 },
 {
   "id": 1243,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 46,
   "firman": "Yusuf berumur tiga puluh tahun ketika ia menghadap Firaun, raja Mesir itu. Maka pergilah Yusuf dari depan Firaun, lalu dikelilinginya seluruh tanah Mesir."
 },
 {
   "id": 1244,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 47,
   "firman": "Tanah itu mengeluarkan hasil bertumpuk-tumpuk dalam ketujuh tahun kelimpahan itu,"
 },
 {
   "id": 1245,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 48,
   "firman": "maka Yusuf mengumpulkan segala bahan makanan ketujuh tahun kelimpahan yang ada di tanah Mesir, lalu disimpannya di kota-kota; hasil daerah sekitar tiap-tiap kota disimpan di dalam kota itu."
 },
 {
   "id": 1246,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 49,
   "firman": "Demikianlah Yusuf menimbun gandum seperti pasir di laut, sangat banyak, sehingga orang berhenti menghitungnya, karena memang tidak terhitung."
 },
 {
   "id": 1247,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 50,
   "firman": "Sebelum datang tahun kelaparan itu, lahirlah bagi Yusuf dua orang anak laki-laki, yang dilahirkan oleh Asnat, anak Potifera, imam di On."
 },
 {
   "id": 1248,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 51,
   "firman": "Yusuf memberi nama Manasye kepada anak sulungnya itu, sebab katanya: \"Allah telah membuat aku lupa sama sekali kepada kesukaranku dan kepada rumah bapaku.\""
 },
 {
   "id": 1249,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 52,
   "firman": "Dan kepada anaknya yang kedua diberinya nama Efraim, sebab katanya: \"Allah membuat aku mendapat anak dalam negeri kesengsaraanku.\""
 },
 {
   "id": 1250,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 53,
   "firman": "Setelah lewat ketujuh tahun kelimpahan yang ada di tanah Mesir itu,"
 },
 {
   "id": 1251,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 54,
   "firman": "mulailah datang tujuh tahun kelaparan, seperti yang telah dikatakan Yusuf; dalam segala negeri ada kelaparan, tetapi di seluruh negeri Mesir ada roti."
 },
 {
   "id": 1252,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 55,
   "firman": "Ketika seluruh negeri Mesir menderita kelaparan, dan rakyat berteriak meminta roti kepada Firaun, berkatalah Firaun kepada semua orang Mesir: \"Pergilah kepada Yusuf, perbuatlah apa yang akan dikatakannya kepadamu.\""
 },
 {
   "id": 1253,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 56,
   "firman": "Kelaparan itu merajalela di seluruh bumi. Maka Yusuf membuka segala lumbung dan menjual gandum kepada orang Mesir, sebab makin hebat kelaparan itu di tanah Mesir."
 },
 {
   "id": 1254,
   "kitab": "Kej",
   "pasal": 41,
   "ayat": 57,
   "firman": "Juga dari seluruh bumi datanglah orang ke Mesir untuk membeli gandum dari Yusuf, sebab hebat kelaparan itu di seluruh bumi."
 },
 {
   "id": 1255,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 1,
   "firman": "Setelah Yakub mendapat kabar, bahwa ada gandum di Mesir, berkatalah ia kepada anak-anaknya: \"Mengapa kamu berpandang-pandangan saja?\""
 },
 {
   "id": 1256,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 2,
   "firman": "Lagi katanya: \"Telah kudengar, bahwa ada gandum di Mesir; pergilah ke sana dan belilah gandum di sana untuk kita, supaya kita tetap hidup dan jangan mati.\""
 },
 {
   "id": 1257,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 3,
   "firman": "Lalu pergilah sepuluh orang saudara Yusuf untuk membeli gandum di Mesir."
 },
 {
   "id": 1258,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 4,
   "firman": "Tetapi Yakub tidak membiarkan Benyamin, adik Yusuf, pergi bersama-sama dengan saudara-saudaranya, sebab pikirnya: \"Jangan-jangan ia ditimpa kecelakaan nanti.\""
 },
 {
   "id": 1259,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 5,
   "firman": "Jadi di antara orang yang datang membeli gandum terdapatlah juga anak-anak Israel, sebab ada kelaparan di tanah Kanaan."
 },
 {
   "id": 1260,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 6,
   "firman": "Sementara itu Yusuf telah menjadi mangkubumi di negeri itu; dialah yang menjual gandum kepada seluruh rakyat negeri itu. Jadi ketika saudara-saudara Yusuf datang, kepadanyalah mereka menghadap dan sujud dengan mukanya sampai ke tanah."
 },
 {
   "id": 1261,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 7,
   "firman": "Ketika Yusuf melihat saudara-saudaranya, segeralah mereka dikenalnya, tetapi ia berlaku seolah-olah ia seorang asing kepada mereka; ia menegor mereka dengan membentak, katanya: \"Dari mana kamu?\" Jawab mereka: \"Dari tanah Kanaan untuk membeli bahan makanan.\""
 },
 {
   "id": 1262,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 8,
   "firman": "Memang Yusuf mengenal saudara-saudaranya itu, tetapi dia tidak dikenal mereka."
 },
 {
   "id": 1263,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 9,
   "firman": "Lalu teringatlah Yusuf akan mimpi-mimpinya tentang mereka. Berkatalah ia kepada mereka: \"Kamu ini pengintai, kamu datang untuk melihat-lihat di mana negeri ini tidak dijaga.\""
 },
 {
   "id": 1264,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 10,
   "firman": "Tetapi jawab mereka: \"Tidak tuanku! Hanyalah untuk membeli bahan makanan hamba-hambamu ini datang."
 },
 {
   "id": 1265,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 11,
   "firman": "Kami ini sekalian anak dari satu ayah; kami ini orang jujur; hamba-hambamu ini bukanlah pengintai.\""
 },
 {
   "id": 1266,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 12,
   "firman": "Tetapi ia berkata kepada mereka: \"Tidak! Kamu datang untuk melihat-lihat di mana negeri ini tidak dijaga.\""
 },
 {
   "id": 1267,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 13,
   "firman": "Lalu jawab mereka: \"Hamba-hambamu ini dua belas orang, kami bersaudara, anak dari satu ayah di tanah Kanaan, tetapi yang bungsu sekarang ada pada ayah kami, dan seorang sudah tidak ada lagi.\""
 },
 {
   "id": 1268,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 14,
   "firman": "Lalu kata Yusuf kepada mereka: \"Sudahlah! Seperti telah kukatakan kepadamu tadi: kamu ini pengintai."
 },
 {
   "id": 1269,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 15,
   "firman": "Dalam hal ini juga kamu harus diuji: demi hidup Firaun, kamu tidak akan pergi dari sini, jika saudaramu yang bungsu itu tidak datang ke mari."
 },
 {
   "id": 1270,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 16,
   "firman": "Suruhlah seorang dari padamu untuk menjemput adikmu itu, tetapi kamu ini harus tinggal terkurung di sini. Dengan demikian perkataanmu dapat diuji, apakah benar, dan jika tidak, demi hidup Firaun, sungguh-sungguhlah kamu ini pengintai.\""
 },
 {
   "id": 1271,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 17,
   "firman": "Dan dimasukkannyalah mereka bersama-sama ke dalam tahanan tiga hari lamanya."
 },
 {
   "id": 1272,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 18,
   "firman": "Pada hari yang ketiga berkatalah Yusuf kepada mereka: \"Buatlah begini, maka kamu akan tetap hidup, aku takut akan Allah."
 },
 {
   "id": 1273,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 19,
   "firman": "Jika kamu orang jujur, biarkanlah dari kamu bersaudara tinggal seorang terkurung dalam rumah tahanan, tetapi pergilah kamu, bawalah gandum untuk meredakan lapar seisi rumahmu."
 },
 {
   "id": 1274,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 20,
   "firman": "Tetapi saudaramu yang bungsu itu haruslah kamu bawa kepadaku, supaya perkataanmu itu ternyata benar dan kamu jangan mati.\" Demikianlah diperbuat mereka."
 },
 {
   "id": 1275,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 21,
   "firman": "Mereka berkata seorang kepada yang lain: \"Betul-betullah kita menanggung akibat dosa kita terhadap adik kita itu: bukankah kita melihat bagaimana sesak hatinya, ketika ia memohon belas kasihan kepada kita, tetapi kita tidak mendengarkan permohonannya. Itulah sebabnya kesesakan ini menimpa kita.\""
 },
 {
   "id": 1276,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 22,
   "firman": "Lalu Ruben menjawab mereka: \"Bukankah dahulu kukatakan kepadamu: Janganlah kamu berbuat dosa terhadap anak itu! Tetapi kamu tidak mendengarkan perkataanku. Sekarang darahnya dituntut dari pada kita.\""
 },
 {
   "id": 1277,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 23,
   "firman": "Tetapi mereka tidak tahu, bahwa Yusuf mengerti perkataan mereka, sebab mereka memakai seorang juru bahasa."
 },
 {
   "id": 1278,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 24,
   "firman": "Maka Yusuf mengundurkan diri dari mereka, lalu menangis. Kemudian ia kembali kepada mereka dan berkata-kata dengan mereka; ia mengambil Simeon dari antara mereka; lalu disuruh belenggu di depan mata mereka."
 },
 {
   "id": 1279,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 25,
   "firman": "Sesudah itu Yusuf memerintahkan, bahwa tempat gandum mereka akan diisi dengan gandum dan bahwa uang mereka masing-masing akan dikembalikan ke dalam karungnya, serta bekal mereka di jalan akan diberikan kepada mereka. Demikianlah dilakukan orang kepada mereka itu."
 },
 {
   "id": 1280,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 26,
   "firman": "Sesudah itu merekapun memuat gandum itu ke atas keledai mereka, lalu berangkat dari situ."
 },
 {
   "id": 1281,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 27,
   "firman": "Ketika seorang membuka karungnya untuk memberi makan keledainya di tempat bermalam, dilihatnyalah uangnya ada di dalam mulut karungnya."
 },
 {
   "id": 1282,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 28,
   "firman": "Katanya kepada saudara-saudaranya: \"Uangku dikembalikan; lihat, ada dalam karungku!\" Lalu hati mereka menjadi tawar dan mereka berpandang-pandangan dengan gemetar serta berkata: \"Apakah juga yang diperbuat Allah terhadap kita!\""
 },
 {
   "id": 1283,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 29,
   "firman": "Ketika mereka sampai kepada Yakub, ayah mereka, di tanah Kanaan, mereka menceritakan segala sesuatu yang dialaminya, katanya:"
 },
 {
   "id": 1284,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 30,
   "firman": "\"Orang itu, yakni yang menjadi tuan atas negeri itu, telah menegor kami dengan membentak dan memperlakukan kami sebagai pengintai negeri itu."
 },
 {
   "id": 1285,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 31,
   "firman": "Tetapi kata kami kepadanya: Kami orang jujur, kami bukan pengintai."
 },
 {
   "id": 1286,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 32,
   "firman": "Kami dua belas orang bersaudara, anak-anak ayah kami; seorang sudah tidak ada lagi, dan yang bungsu ada sekarang pada ayah kami, di tanah Kanaan."
 },
 {
   "id": 1287,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 33,
   "firman": "Lalu kata orang itu, yakni yang menjadi tuan atas negeri itu, kepada kami: Dari hal ini aku akan tahu, apakah kamu orang jujur: dari kamu bersaudara haruslah kamu tinggalkan seorang padaku; kemudian bawalah gandum untuk meredakan lapar seisi rumahmu dan pergilah;"
 },
 {
   "id": 1288,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 34,
   "firman": "lalu bawalah kepadaku saudaramu yang bungsu itu, maka aku akan tahu, bahwa kamu bukan pengintai, tetapi orang jujur; dan aku akan mengembalikan saudaramu itu kepadamu, dan bolehlah kamu menjalani negeri ini dengan bebas.\""
 },
 {
   "id": 1289,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 35,
   "firman": "Ketika mereka mengosongkan karungnya, tampaklah ada pundi-pundi uang masing-masing dalam karungnya; dan ketika mereka beserta ayah mereka melihat pundi-pundi uang itu, ketakutanlah mereka."
 },
 {
   "id": 1290,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 36,
   "firman": "Dan Yakub, ayah mereka, berkata kepadanya: \"Kamu membuat aku kehilangan anak-anakku: Yusuf tidak ada lagi, dan Simeon tidak ada lagi, sekarang Benyaminpun hendak kamu bawa juga. Aku inilah yang menanggung segala-galanya itu!\""
 },
 {
   "id": 1291,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 37,
   "firman": "Lalu berkatalah Ruben kepada ayahnya: \"Kedua anakku laki-laki boleh engkau bunuh, jika ia tidak kubawa kepadamu; serahkanlah dia ke dalam tanganku, maka dia akan kubawa kembali kepadamu.\""
 },
 {
   "id": 1292,
   "kitab": "Kej",
   "pasal": 42,
   "ayat": 38,
   "firman": "Tetapi jawabnya: \"Anakku itu tidak akan pergi ke sana bersama-sama dengan kamu, sebab kakaknya telah mati dan hanya dialah yang tinggal; jika dia ditimpa kecelakaan di jalan yang akan kamu tempuh, maka tentulah kamu akan menyebabkan aku yang ubanan ini turun ke dunia orang mati karena dukacita.\""
 },
 {
   "id": 1293,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 1,
   "firman": "Tetapi hebat sekali kelaparan di negeri itu."
 },
 {
   "id": 1294,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 2,
   "firman": "Dan setelah gandum yang dibawa mereka dari Mesir habis dimakan, berkatalah ayah mereka: \"Pergilah pula membeli sedikit bahan makanan untuk kita.\""
 },
 {
   "id": 1295,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 3,
   "firman": "Lalu Yehuda menjawabnya: \"Orang itu telah memperingatkan kami dengan sungguh-sungguh: Kamu tidak boleh melihat mukaku, jika adikmu itu tidak ada bersama-sama dengan kamu."
 },
 {
   "id": 1296,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 4,
   "firman": "Jika engkau mau membiarkan adik kami pergi bersama-sama dengan kami, maka kami mau pergi ke sana dan membeli bahan makanan bagimu."
 },
 {
   "id": 1297,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 5,
   "firman": "Tetapi jika engkau tidak mau membiarkan dia pergi, maka kami tidak akan pergi ke sana, sebab orang itu telah berkata kepada kami: Kamu tidak boleh melihat mukaku, jika adikmu itu tidak ada bersama-sama dengan kamu.\""
 },
 {
   "id": 1298,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 6,
   "firman": "Lalu berkatalah Israel: \"Mengapa kamu mendatangkan malapetaka kepadaku dengan memberitahukan kepada orang itu, bahwa masih ada adikmu seorang?\""
 },
 {
   "id": 1299,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 7,
   "firman": "Jawab mereka: \"Orang itu telah menanyai kami dengan seksama tentang kami sendiri dan tentang sanak saudara kita: Masih hidupkah ayahmu? Adakah adikmu lagi? Dan kami telah memberitahukan semuanya kepadanya seperti yang sebenarnya. Bagaimana kami dapat menduga bahwa ia akan berkata: Bawalah ke mari adikmu itu.\""
 },
 {
   "id": 1300,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 8,
   "firman": "Lalu berkatalah Yehuda kepada Israel, ayahnya: \"Biarkanlah anak itu pergi bersama-sama dengan aku; maka kami akan bersiap dan pergi, supaya kita tetap hidup dan jangan mati, baik kami maupun engkau dan anak-anak kami."
 },
 {
   "id": 1301,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 9,
   "firman": "Akulah yang menanggung dia; engkau boleh menuntut dia dari padaku; jika aku tidak membawa dia kepadamu dan menempatkan dia di depanmu, maka akulah yang berdosa terhadap engkau untuk selama-lamanya."
 },
 {
   "id": 1302,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 10,
   "firman": "Jika kita tidak berlambat-lambat, maka tentulah kami sekarang sudah dua kali pulang.\""
 },
 {
   "id": 1303,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 11,
   "firman": "Lalu Israel, ayah mereka, berkata kepadanya: \"Jika demikian, perbuatlah begini: Ambillah hasil yang terbaik dari negeri ini dalam tempat gandummu dan bawalah kepada orang itu sebagai persembahan: sedikit balsam dan sedikit madu, damar dan damar ladan, buah kemiri dan buah badam."
 },
 {
   "id": 1304,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 12,
   "firman": "Dan bawalah uang dua kali lipat banyaknya: uang yang telah dikembalikan ke dalam mulut karung-karungmu itu haruslah kamu bawa kembali; mungkin itu suatu kekhilafan."
 },
 {
   "id": 1305,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 13,
   "firman": "Bawalah juga adikmu itu, bersiaplah dan kembalilah pula kepada orang itu."
 },
 {
   "id": 1306,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 14,
   "firman": "Allah Yang Mahakuasa kiranya membuat orang itu menaruh belas kasihan kepadamu, supaya ia membiarkan saudaramu yang lain itu beserta Benyamin kembali. Mengenai aku ini, jika terpaksa aku kehilangan anak-anakku, biarlah juga kehilangan!\""
 },
 {
   "id": 1307,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 15,
   "firman": "Lalu orang-orang itu mengambil persembahan itu dan mengambil uang dua kali lipat banyaknya, beserta Benyamin juga; mereka bersiap dan pergi ke Mesir. Kemudian berdirilah mereka di depan Yusuf."
 },
 {
   "id": 1308,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 16,
   "firman": "Ketika Yusuf melihat Benyamin bersama-sama dengan mereka, berkatalah ia kepada kepala rumahnya: \"Bawalah orang-orang ini ke dalam rumah, sembelihlah seekor hewan dan siapkanlah itu, sebab orang-orang ini akan makan bersama-sama dengan aku pada tengah hari ini.\""
 },
 {
   "id": 1309,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 17,
   "firman": "Orang itu melakukan seperti yang dikatakan Yusuf dan dibawanyalah orang-orang itu ke dalam rumah Yusuf."
 },
 {
   "id": 1310,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 18,
   "firman": "Lalu ketakutanlah orang-orang itu, karena mereka dibawa ke dalam rumah Yusuf. Kata mereka: \"Yang menjadi sebab kita dibawa ke sini, ialah perkara uang yang dikembalikan ke dalam karung kita pada mulanya itu, supaya kita disergap dan ditangkap dan supaya kita dijadikan budak dan keledai kita diambil.\""
 },
 {
   "id": 1311,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 19,
   "firman": "Karena itu mereka mendekati kepala rumah Yusuf itu, dan berkata kepadanya di depan pintu rumah:"
 },
 {
   "id": 1312,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 20,
   "firman": "\"Mohon bicara tuan! Kami dahulu datang ke mari untuk membeli bahan makanan,"
 },
 {
   "id": 1313,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 21,
   "firman": "tetapi ketika kami sampai ke tempat bermalam dan membuka karung kami, tampaklah uang kami masing-masing dengan tidak kurang jumlahnya ada di dalam mulut karung. Tetapi sekarang kami membawanya kembali."
 },
 {
   "id": 1314,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 22,
   "firman": "Uang lain kami bawa juga ke mari untuk membeli bahan makanan; kami tidak tahu siapa yang menaruh uang kami itu ke dalam karung kami.\""
 },
 {
   "id": 1315,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 23,
   "firman": "Tetapi jawabnya: \"Tenang sajalah, jangan takut; Allahmu dan Allah bapamu telah memberikan kepadamu harta terpendam dalam karungmu; uangmu itu telah kuterima.\" Kemudian dikeluarkannyalah Simeon dan dibawanya kepada mereka."
 },
 {
   "id": 1316,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 24,
   "firman": "Setelah orang itu membawa mereka ke dalam rumah Yusuf, diberikannyalah air, supaya mereka membasuh kaki; juga keledai mereka diberinya makan."
 },
 {
   "id": 1317,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 25,
   "firman": "Sesudah itu mereka menyiapkan persembahannya menantikan Yusuf datang pada waktu tengah hari, sebab mereka telah mendengar, bahwa mereka akan makan di situ."
 },
 {
   "id": 1318,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 26,
   "firman": "Ketika Yusuf telah pulang, mereka membawa persembahan yang ada pada mereka itu kepada Yusuf di dalam rumah, lalu sujud kepadanya sampai ke tanah."
 },
 {
   "id": 1319,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 27,
   "firman": "Sesudah itu ia bertanya kepada mereka apakah mereka selamat; lagi katanya: \"Apakah ayahmu yang tua yang kamu sebutkan itu selamat? Masih hidupkah ia?\""
 },
 {
   "id": 1320,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 28,
   "firman": "Jawab mereka: \"Hambamu, ayah kami, ada selamat; ia masih hidup.\" Sesudah itu berlututlah mereka dan sujud."
 },
 {
   "id": 1321,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 29,
   "firman": "Ketika Yusuf memandang kepada mereka, dilihatnyalah Benyamin, adiknya, yang seibu dengan dia, lalu katanya: \"Inikah adikmu yang bungsu itu, yang telah kamu sebut-sebut kepadaku?\" Lagi katanya: \"Allah kiranya memberikan kasih karunia kepadamu, anakku!\""
 },
 {
   "id": 1322,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 30,
   "firman": "Lalu segeralah Yusuf pergi dari situ, sebab hatinya sangat terharu merindukan adiknya itu, dan dicarinyalah tempat untuk menangis; ia masuk ke dalam kamar, lalu menangis di situ."
 },
 {
   "id": 1323,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 31,
   "firman": "Sesudah itu dibasuhnyalah mukanya dan ia tampil ke luar. Ia menahan hatinya dan berkata: \"Hidangkanlah makanan.\""
 },
 {
   "id": 1324,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 32,
   "firman": "Lalu dihidangkanlah makanan, bagi Yusuf tersendiri, bagi saudara-saudaranya tersendiri dan bagi orang-orang Mesir yang bersama-sama makan dengan mereka itu tersendiri; sebab orang Mesir tidak boleh makan bersama-sama dengan orang Ibrani, karena hal itu suatu kekejian bagi orang Mesir."
 },
 {
   "id": 1325,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 33,
   "firman": "Saudara-saudaranya itu duduk di depan Yusuf, dari yang sulung sampai yang bungsu, sehingga mereka berpandang-pandangan dengan heran."
 },
 {
   "id": 1326,
   "kitab": "Kej",
   "pasal": 43,
   "ayat": 34,
   "firman": "Lalu disajikan kepada mereka hidangan dari meja Yusuf, tetapi yang diterima Benyamin adalah lima kali lebih banyak dari pada setiap orang yang lain. Lalu minumlah mereka dan bersukaria bersama-sama dengan dia."
 },
 {
   "id": 1327,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 1,
   "firman": "Sesudah itu diperintahkannyalah kepada kepala rumahnya: \"Isilah karung orang-orang itu dengan gandum, seberapa yang dapat dibawa mereka, dan letakkanlah uang masing-masing di dalam mulut karungnya."
 },
 {
   "id": 1328,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 2,
   "firman": "Dan pialaku, piala perak itu, taruhlah di dalam mulut karung anak yang bungsu serta uang pembayar gandumnya juga.\" Maka diperbuatnyalah seperti yang dikatakan Yusuf."
 },
 {
   "id": 1329,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 3,
   "firman": "Ketika paginya hari terang tanah, orang melepas mereka beserta keledai mereka."
 },
 {
   "id": 1330,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 4,
   "firman": "Tetapi baru saja mereka keluar dari kota itu, belum lagi jauh jaraknya, berkatalah Yusuf kepada kepala rumahnya: \"Bersiaplah, kejarlah orang-orang itu, dan apabila engkau sampai kepada mereka, katakanlah kepada mereka: Mengapa kamu membalas yang baik dengan yang jahat?"
 },
 {
   "id": 1331,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 5,
   "firman": "Bukankah ini piala yang dipakai tuanku untuk minum dan yang biasa dipakainya untuk menelaah? Kamu berbuat jahat dengan melakukan yang demikian.\""
 },
 {
   "id": 1332,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 6,
   "firman": "Ketika sampai kepada mereka, diberitakannyalah kepada mereka perkataan Yusuf itu."
 },
 {
   "id": 1333,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 7,
   "firman": "Jawab mereka kepadanya: \"Mengapa tuanku mengatakan perkataan yang demikian? Jauhlah dari pada hamba-hambamu ini untuk berbuat begitu!"
 },
 {
   "id": 1334,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 8,
   "firman": "Bukankah uang yang kami dapati di dalam mulut karung kami telah kami bawa kembali kepadamu dari tanah Kanaan? Masakan kami mencuri emas atau perak dari rumah tuanmu?"
 },
 {
   "id": 1335,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 9,
   "firman": "Pada siapa dari hamba-hambamu ini kedapatan piala itu, biarlah ia mati, juga kami ini akan menjadi budak tuanku.\""
 },
 {
   "id": 1336,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 10,
   "firman": "Sesudah itu berkatalah ia: \"Ya, usulmu itu baik; tetapi pada siapa kedapatan piala itu, hanya dialah yang akan menjadi budakku dan kamu yang lain itu akan bebas dari salah.\""
 },
 {
   "id": 1337,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 11,
   "firman": "Lalu segeralah mereka masing-masing menurunkan karungnya ke tanah dan masing-masing membuka karungnya."
 },
 {
   "id": 1338,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 12,
   "firman": "Dan kepala rumah itu memeriksanya dengan teliti; ia mulai dengan yang sulung sampai kepada yang bungsu; maka kedapatanlah piala itu dalam karung Benyamin."
 },
 {
   "id": 1339,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 13,
   "firman": "Lalu mereka mengoyakkan jubahnya dan masing-masing memuati keledainya, dan mereka kembali ke kota."
 },
 {
   "id": 1340,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 14,
   "firman": "Ketika Yehuda dan saudara-saudaranya sampai ke dalam rumah Yusuf, Yusuf masih ada di situ, sujudlah mereka sampai ke tanah di depannya."
 },
 {
   "id": 1341,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 15,
   "firman": "Berkatalah Yusuf kepada mereka: \"Perbuatan apakah yang kamu lakukan ini? Tidakkah kamu tahu, bahwa seorang yang seperti aku ini pasti dapat menelaah?\""
 },
 {
   "id": 1342,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 16,
   "firman": "Sesudah itu berkatalah Yehuda: \"Apakah yang akan kami katakan kepada tuanku, apakah yang akan kami jawab, dan dengan apakah kami akan membenarkan diri kami? Allah telah memperlihatkan kesalahan hamba-hambamu ini. Maka kami ini, budak tuankulah kami, baik kami maupun orang pada siapa kedapatan piala itu.\""
 },
 {
   "id": 1343,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 17,
   "firman": "Tetapi jawabnya: \"Jauhlah dari padaku untuk berbuat demikian! Pada siapa kedapatan piala itu, dialah yang akan menjadi budakku, tetapi kamu ini, pergilah kembali dengan selamat kepada ayahmu.\""
 },
 {
   "id": 1344,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 18,
   "firman": "Lalu tampillah Yehuda mendekatinya dan berkata: \"Mohon bicara tuanku, izinkanlah kiranya hambamu ini mengucapkan sepatah kata kepada tuanku dan janganlah kiranya bangkit amarahmu terhadap hambamu ini, sebab tuanku adalah seperti Firaun sendiri."
 },
 {
   "id": 1345,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 19,
   "firman": "Tuanku telah bertanya kepada hamba-hambanya ini: Masih adakah ayah atau saudara kamu?"
 },
 {
   "id": 1346,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 20,
   "firman": "Dan kami menjawab tuanku: Kami masih mempunyai ayah yang tua dan masih ada anaknya yang muda, yang lahir pada masa tuanya; kakaknya telah mati, hanya dia sendirilah yang tinggal dari mereka yang seibu, sebab itu ayahnya sangat mengasihi dia."
 },
 {
   "id": 1347,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 21,
   "firman": "Lalu tuanku berkata kepada hamba-hambamu ini: Bawalah dia ke mari kepadaku, supaya mataku memandang dia."
 },
 {
   "id": 1348,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 22,
   "firman": "Tetapi jawab kami kepada tuanku: Anak itu tidak dapat meninggalkan ayahnya, sebab jika ia meninggalkan ayahnya, tentulah ayah ini mati."
 },
 {
   "id": 1349,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 23,
   "firman": "Kemudian tuanku berkata kepada hamba-hambamu ini: Jika adikmu yang bungsu itu tidak datang ke mari bersama-sama dengan kamu, kamu tidak boleh melihat mukaku lagi."
 },
 {
   "id": 1350,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 24,
   "firman": "Setelah kami kembali kepada hambamu, ayahku, maka kami memberitahukan kepadanya perkataan tuanku itu."
 },
 {
   "id": 1351,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 25,
   "firman": "Kemudian ayah kami berkata: Kembalilah kamu membeli sedikit bahan makanan bagi kita."
 },
 {
   "id": 1352,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 26,
   "firman": "Tetapi jawab kami: Kami tidak dapat pergi ke sana. Jika adik kami yang bungsu bersama-sama dengan kami, barulah kami akan pergi ke sana, sebab kami tidak boleh melihat muka orang itu, apabila adik kami yang bungsu tidak bersama-sama dengan kami."
 },
 {
   "id": 1353,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 27,
   "firman": "Kemudian berkatalah hambamu, ayahku, kepada kami: Kamu tahu, bahwa isteriku telah melahirkan dua orang anak bagiku;"
 },
 {
   "id": 1354,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 28,
   "firman": "yang seorang telah pergi dari padaku, dan aku telah berkata: Tentulah ia diterkam oleh binatang buas, dan sampai sekarang aku tidak melihat dia kembali."
 },
 {
   "id": 1355,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 29,
   "firman": "Jika anak ini kamu ambil pula dari padaku, dan ia ditimpa kecelakaan, maka tentulah kamu akan menyebabkan aku yang ubanan ini turun ke dunia orang mati karena nasib celaka."
 },
 {
   "id": 1356,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 30,
   "firman": "Maka sekarang, apabila aku datang kepada hambamu, ayahku, dan tidak ada bersama-sama dengan kami anak itu, padahal ayahku tidak dapat hidup tanpa dia,"
 },
 {
   "id": 1357,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 31,
   "firman": "tentulah akan terjadi, apabila dilihatnya anak itu tidak ada, bahwa ia akan mati, dan hamba-hambamu ini akan menyebabkan hambamu, ayah kami yang ubanan itu, turun ke dunia orang mati karena dukacita."
 },
 {
   "id": 1358,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 32,
   "firman": "Tetapi hambamu ini telah menanggung anak itu terhadap ayahku dengan perkataan: Jika aku tidak membawanya kembali kepada bapa, maka akulah yang berdosa kepada bapa untuk selama-lamanya."
 },
 {
   "id": 1359,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 33,
   "firman": "Oleh sebab itu, baiklah hambamu ini tinggal menjadi budak tuanku menggantikan anak itu, dan biarlah anak itu pulang bersama-sama dengan saudara-saudaranya."
 },
 {
   "id": 1360,
   "kitab": "Kej",
   "pasal": 44,
   "ayat": 34,
   "firman": "Sebab masakan aku pulang kepada ayahku, apabila anak itu tidak bersama-sama dengan aku? Aku tidak akan sanggup melihat nasib celaka yang akan menimpa ayahku.\""
 },
 {
   "id": 1361,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 1,
   "firman": "Ketika itu Yusuf tidak dapat menahan hatinya lagi di depan semua orang yang berdiri di dekatnya, lalu berserulah ia: \"Suruhlah keluar semua orang dari sini.\" Maka tidak ada seorangpun yang tinggal di situ bersama-sama Yusuf, ketika ia memperkenalkan dirinya kepada saudara-saudaranya."
 },
 {
   "id": 1362,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 2,
   "firman": "Setelah itu menangislah ia keras-keras, sehingga kedengaran kepada orang Mesir dan kepada seisi istana Firaun."
 },
 {
   "id": 1363,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 3,
   "firman": "Dan Yusuf berkata kepada saudara-saudaranya: \"Akulah Yusuf! Masih hidupkah bapa?\" Tetapi saudara-saudaranya tidak dapat menjawabnya, sebab mereka takut dan gemetar menghadapi dia."
 },
 {
   "id": 1364,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 4,
   "firman": "Lalu kata Yusuf kepada saudara-saudaranya itu: \"Marilah dekat-dekat.\" Maka mendekatlah mereka. Katanya lagi: \"Akulah Yusuf, saudaramu, yang kamu jual ke Mesir."
 },
 {
   "id": 1365,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 5,
   "firman": "Tetapi sekarang, janganlah bersusah hati dan janganlah menyesali diri, karena kamu menjual aku ke sini, sebab untuk memelihara kehidupanlah Allah menyuruh aku mendahului kamu."
 },
 {
   "id": 1366,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 6,
   "firman": "Karena telah dua tahun ada kelaparan dalam negeri ini dan selama lima tahun lagi orang tidak akan membajak atau menuai."
 },
 {
   "id": 1367,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 7,
   "firman": "Maka Allah telah menyuruh aku mendahului kamu untuk menjamin kelanjutan keturunanmu di bumi ini dan untuk memelihara hidupmu, sehingga sebagian besar dari padamu tertolong."
 },
 {
   "id": 1368,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 8,
   "firman": "Jadi bukanlah kamu yang menyuruh aku ke sini, tetapi Allah; Dialah yang telah menempatkan aku sebagai bapa bagi Firaun dan tuan atas seluruh istananya dan sebagai kuasa atas seluruh tanah Mesir."
 },
 {
   "id": 1369,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 9,
   "firman": "Segeralah kamu kembali kepada bapa dan katakanlah kepadanya: Beginilah kata Yusuf, anakmu: Allah telah menempatkan aku sebagai tuan atas seluruh Mesir; datanglah mendapatkan aku, janganlah tunggu-tunggu."
 },
 {
   "id": 1370,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 10,
   "firman": "Engkau akan tinggal di tanah Gosyen dan akan dekat kepadaku, engkau serta anak dan cucumu, kambing domba dan lembu sapimu dan segala milikmu."
 },
 {
   "id": 1371,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 11,
   "firman": "Di sanalah aku memelihara engkau--sebab kelaparan ini masih ada lima tahun lagi--supaya engkau jangan jatuh miskin bersama seisi rumahmu dan semua orang yang ikut serta dengan engkau."
 },
 {
   "id": 1372,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 12,
   "firman": "Dan kamu telah melihat dengan mata sendiri, dan saudaraku Benyamin juga, bahwa mulutku sendiri mengatakannya kepadamu."
 },
 {
   "id": 1373,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 13,
   "firman": "Sebab itu ceritakanlah kepada bapa segala kemuliaanku di negeri Mesir ini, dan segala yang telah kamu lihat, kemudian segeralah bawa bapa ke mari.\""
 },
 {
   "id": 1374,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 14,
   "firman": "Lalu dipeluknyalah leher Benyamin, adiknya itu, dan menangislah ia, dan menangis pulalah Benyamin pada bahu Yusuf."
 },
 {
   "id": 1375,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 15,
   "firman": "Yusuf mencium semua saudaranya itu dengan mesra dan ia menangis sambil memeluk mereka. Sesudah itu barulah saudara-saudaranya bercakap-cakap dengan dia."
 },
 {
   "id": 1376,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 16,
   "firman": "Ketika dalam istana Firaun terdengar kabar, bahwa saudara-saudara Yusuf datang, hal itu diterima dengan baik oleh Firaun dan pegawai-pegawainya."
 },
 {
   "id": 1377,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 17,
   "firman": "Lalu berkatalah Firaun kepada Yusuf: \"Katakanlah kepada saudara-saudaramu Buatlah begini: muatilah binatang-binatangmu dan pergilah ke tanah Kanaan,"
 },
 {
   "id": 1378,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 18,
   "firman": "jemputlah ayahmu dan seisi rumahmu dan datanglah mendapatkan aku, maka aku akan memberikan kepadamu apa yang paling baik di tanah Mesir, sehingga kamu akan mengecap kesuburan tanah ini."
 },
 {
   "id": 1379,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 19,
   "firman": "Selanjutnya engkau mendapat perintah mengatakan kepada mereka: Buatlah begini: bawalah kereta dari tanah Mesir untuk anak-anakmu dan isteri-isterimu, jemputlah ayahmu dari sana dan datanglah ke mari."
 },
 {
   "id": 1380,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 20,
   "firman": "Janganlah kamu merasa sayang meninggalkan barang-barangmu, sebab apa yang paling baik di seluruh tanah Mesir ini adalah milikmu.\""
 },
 {
   "id": 1381,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 21,
   "firman": "Demikianlah dilakukan oleh anak-anak Israel itu. Yusuf memberikan kereta kepada mereka menurut perintah Firaun; juga diberikan kepada mereka bekal di jalan."
 },
 {
   "id": 1382,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 22,
   "firman": "Kepada mereka masing-masing diberikannya sepotong pesalin dan kepada Benyamin diberikannya tiga ratus uang perak dan lima potong pesalin."
 },
 {
   "id": 1383,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 23,
   "firman": "Di samping itu kepada ayahnya dikirimkannya sepuluh ekor keledai jantan, dimuati dengan apa yang paling baik di Mesir, lagipula sepuluh ekor keledai betina, dimuati dengan gandum dan roti dan makanan untuk ayahnya dalam perjalanan."
 },
 {
   "id": 1384,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 24,
   "firman": "Kemudian ia melepas saudara-saudaranya serta berkata kepada mereka: \"Janganlah berbantah-bantah di jalan.\""
 },
 {
   "id": 1385,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 25,
   "firman": "Demikianlah mereka pergi dari tanah Mesir dan sampai di tanah Kanaan, kepada Yakub, ayah mereka."
 },
 {
   "id": 1386,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 26,
   "firman": "Mereka menceritakan kepadanya: \"Yusuf masih hidup, bahkan dialah yang menjadi kuasa atas seluruh tanah Mesir.\" Tetapi hati Yakub tetap dingin, sebab ia tidak dapat mempercayai mereka."
 },
 {
   "id": 1387,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 27,
   "firman": "Tetapi ketika mereka menyampaikan kepadanya segala perkataan yang diucapkan Yusuf, dan ketika dilihatnya kereta yang dikirim oleh Yusuf untuk menjemputnya, maka bangkitlah kembali semangat Yakub, ayah mereka itu."
 },
 {
   "id": 1388,
   "kitab": "Kej",
   "pasal": 45,
   "ayat": 28,
   "firman": "Kata Yakub: \"Cukuplah itu; anakku Yusuf masih hidup; aku mau pergi melihatnya, sebelum aku mati.\""
 },
 {
   "id": 1389,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 1,
   "firman": "Jadi berangkatlah Israel dengan segala miliknya dan ia tiba di Bersyeba, lalu dipersembahkannya korban sembelihan kepada Allah Ishak ayahnya."
 },
 {
   "id": 1390,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 2,
   "firman": "Berfirmanlah Allah kepada Israel dalam penglihatan waktu malam: \"Yakub, Yakub!\" Sahutnya: \"Ya, Tuhan.\""
 },
 {
   "id": 1391,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 3,
   "firman": "Lalu firman-Nya: \"Akulah Allah, Allah ayahmu, janganlah takut pergi ke Mesir, sebab Aku akan membuat engkau menjadi bangsa yang besar di sana."
 },
 {
   "id": 1392,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 4,
   "firman": "Aku sendiri akan menyertai engkau pergi ke Mesir dan tentulah Aku juga akan membawa engkau kembali; dan tangan Yusuflah yang akan mengatupkan kelopak matamu nanti.\""
 },
 {
   "id": 1393,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 5,
   "firman": "Lalu berangkatlah Yakub dari Bersyeba, dan anak-anak Israel membawa Yakub, ayah mereka, beserta anak dan isteri mereka, dan mereka menaiki kereta yang dikirim Firaun untuk menjemputnya."
 },
 {
   "id": 1394,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 6,
   "firman": "Mereka membawa juga ternaknya dan harta bendanya, yang telah diperoleh mereka di tanah Kanaan, lalu tibalah mereka di Mesir, yakni Yakub dan seluruh keturunannya bersama-sama dengan dia."
 },
 {
   "id": 1395,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 7,
   "firman": "Anak-anak dan cucu-cucunya laki-laki dan perempuan, seluruh keturunannya dibawanyalah ke Mesir."
 },
 {
   "id": 1396,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 8,
   "firman": "Inilah nama-nama bani Israel yang datang ke Mesir, yakni Yakub beserta keturunannya. Anak sulung Yakub ialah Ruben."
 },
 {
   "id": 1397,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 9,
   "firman": "Anak-anak Ruben ialah Henokh, Palu, Hezron dan Karmi."
 },
 {
   "id": 1398,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 10,
   "firman": "Anak-anak Simeon ialah Yemuel, Yamin, Ohad, Yakhin dan Zohar serta Saul, anak seorang perempuan Kanaan."
 },
 {
   "id": 1399,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 11,
   "firman": "Anak-anak Lewi ialah Gerson, Kehat dan Merari."
 },
 {
   "id": 1400,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 12,
   "firman": "Anak-anak Yehuda ialah Er, Onan, Syela, Peres dan Zerah; tetapi Er dan Onan mati di tanah Kanaan; dan anak-anak Peres ialah Hezron dan Hamul."
 },
 {
   "id": 1401,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 13,
   "firman": "Anak-anak Isakhar ialah Tola, Pua, Ayub dan Simron."
 },
 {
   "id": 1402,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 14,
   "firman": "Anak-anak Zebulon ialah Sered, Elon dan Yahleel."
 },
 {
   "id": 1403,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 15,
   "firman": "Itulah keturunan Lea, yang melahirkan bagi Yakub di Padan-Aram anak-anak lelaki serta Dina juga, anaknya yang perempuan. Jadi seluruhnya, laki-laki dan perempuan, berjumlah tiga puluh tiga jiwa."
 },
 {
   "id": 1404,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 16,
   "firman": "Anak-anak Gad ialah Zifyon, Hagi, Syuni, Ezbon, Eri, Arodi dan Areli."
 },
 {
   "id": 1405,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 17,
   "firman": "Anak-anak Asyer ialah Yimna, Yiswa, Yiswi dan Beria; Serah ialah saudara perempuan mereka; dan anak-anak Beria ialah Heber dan Malkiel."
 },
 {
   "id": 1406,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 18,
   "firman": "Itulah keturunan Zilpa, yakni hamba perempuan yang telah diberikan Laban kepada Lea, anaknya perempuan, dan yang melahirkan anak-anak bagi Yakub; seluruhnya enam belas jiwa."
 },
 {
   "id": 1407,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 19,
   "firman": "Anak-anak Rahel, isteri Yakub, ialah Yusuf dan Benyamin."
 },
 {
   "id": 1408,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 20,
   "firman": "Bagi Yusuf lahir Manasye dan Efraim di tanah Mesir, yang dilahirkan baginya oleh Asnat, anak perempuan Potifera, imam di On."
 },
 {
   "id": 1409,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 21,
   "firman": "Anak-anak Benyamin ialah Bela, Bekher, Asybel, Gera, Naaman, Ehi, Rosh, Mupim, Hupim dan Ared."
 },
 {
   "id": 1410,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 22,
   "firman": "Itulah keturunan Rahel, yang telah lahir bagi Yakub, seluruhnya berjumlah empat belas jiwa."
 },
 {
   "id": 1411,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 23,
   "firman": "Anak Dan ialah Husim."
 },
 {
   "id": 1412,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 24,
   "firman": "Anak-anak Naftali ialah Yahzeel, Guni, Yezer dan Syilem."
 },
 {
   "id": 1413,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 25,
   "firman": "Itulah keturunan Bilha, yakni hamba perempuan yang diberikan Laban kepada Rahel, anaknya yang perempuan dan yang melahirkan anak-anak itu bagi Yakub--seluruhnya berjumlah tujuh jiwa."
 },
 {
   "id": 1414,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 26,
   "firman": "Semua orang yang tiba di Mesir bersama-sama dengan Yakub, yakni anak-anak kandungnya, dengan tidak terhitung isteri anak-anaknya, seluruhnya berjumlah enam puluh enam jiwa."
 },
 {
   "id": 1415,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 27,
   "firman": "Anak-anak Yusuf yang lahir baginya di Mesir ada dua orang. Jadi keluarga Yakub yang tiba di Mesir, seluruhnya berjumlah tujuh puluh jiwa."
 },
 {
   "id": 1416,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 28,
   "firman": "Yakub menyuruh Yehuda berjalan lebih dahulu mendapatkan Yusuf, supaya Yusuf datang ke Gosyen menemui ayahnya. Sementara itu sampailah mereka ke tanah Gosyen."
 },
 {
   "id": 1417,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 29,
   "firman": "Lalu Yusuf memasang keretanya dan pergi ke Gosyen, mendapatkan Israel, ayahnya. Ketika ia bertemu dengan dia, dipeluknyalah leher ayahnya dan lama menangis pada bahunya."
 },
 {
   "id": 1418,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 30,
   "firman": "Berkatalah Israel kepada Yusuf: \"Sekarang bolehlah aku mati, setelah aku melihat mukamu dan mengetahui bahwa engkau masih hidup.\""
 },
 {
   "id": 1419,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 31,
   "firman": "Kemudian berkatalah Yusuf kepada saudara-saudaranya dan kepada keluarga ayahnya itu: \"Aku mau menghadap Firaun dan memberitahukan kepadanya: Saudara-saudaraku dan keluarga ayahku, yang tinggal di tanah Kanaan, telah datang kepadaku;"
 },
 {
   "id": 1420,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 32,
   "firman": "orang-orang itu gembala kambing domba, sebab mereka itu pemelihara ternak, dan kambing dombanya, lembu sapinya dan segala miliknya telah dibawa mereka."
 },
 {
   "id": 1421,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 33,
   "firman": "Apabila Firaun memanggil kamu dan bertanya: Apakah pekerjaanmu?"
 },
 {
   "id": 1422,
   "kitab": "Kej",
   "pasal": 46,
   "ayat": 34,
   "firman": "maka jawablah: Hamba-hambamu ini pemelihara ternak, sejak dari kecil sampai sekarang, baik kami maupun nenek moyang kami--dengan maksud supaya kamu boleh diam di tanah Gosyen.\" --Sebab segala gembala kambing domba adalah suatu kekejian bagi orang Mesir."
 },
 {
   "id": 1423,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 1,
   "firman": "Kemudian pergilah Yusuf memberitahukan kepada Firaun: \"Ayahku dan saudara-saudaraku beserta kambing dombanya, lembu sapinya dan segala miliknya telah datang dari tanah Kanaan, dan sekarang mereka ada di tanah Gosyen.\""
 },
 {
   "id": 1424,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 2,
   "firman": "Dari antara saudara-saudaranya itu dibawanya lima orang menghadap Firaun."
 },
 {
   "id": 1425,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 3,
   "firman": "Firaun bertanya kepada saudara-saudara Yusuf itu: \"Apakah pekerjaanmu?\" Jawab mereka kepada Firaun: \"Hamba-hambamu ini gembala domba, baik kami maupun nenek moyang kami.\""
 },
 {
   "id": 1426,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 4,
   "firman": "Lagi kata mereka kepada Firaun: \"Kami datang untuk tinggal di negeri ini sebagai orang asing, sebab tidak ada lagi padang rumput untuk kumpulan ternak hamba-hambamu ini, karena hebat kelaparan itu di tanah Kanaan; maka sekarang, izinkanlah hamba-hambamu ini menetap di tanah Gosyen.\""
 },
 {
   "id": 1427,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 5,
   "firman": "Lalu berkatalah Firaun kepada Yusuf: \"Ayahmu dan saudara-saudaramu telah datang kepadamu."
 },
 {
   "id": 1428,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 6,
   "firman": "Tanah Mesir ini terbuka untukmu. Tunjukkanlah kepada ayahmu dan kepada saudara-saudaramu tempat menetap di tempat yang terbaik dari negeri ini, biarlah mereka diam di tanah Gosyen. Dan jika engkau tahu di antara mereka orang-orang yang tangkas, tempatkanlah mereka menjadi pengawas ternakku.\""
 },
 {
   "id": 1429,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 7,
   "firman": "Yusuf membawa juga Yakub, ayahnya, menghadap Firaun. Lalu Yakub memohonkan berkat bagi Firaun."
 },
 {
   "id": 1430,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 8,
   "firman": "Kemudian bertanyalah Firaun kepada Yakub: \"Sudah berapa tahun umurmu?\""
 },
 {
   "id": 1431,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 9,
   "firman": "Jawab Yakub kepada Firaun: \"Tahun-tahun pengembaraanku sebagai orang asing berjumlah seratus tiga puluh tahun. Tahun-tahun hidupku itu sedikit saja dan buruk adanya, tidak mencapai umur nenek moyangku, yakni jumlah tahun mereka mengembara sebagai orang asing.\""
 },
 {
   "id": 1432,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 10,
   "firman": "Lalu Yakub memohonkan berkat bagi Firaun, sesudah itu keluarlah ia dari depan Firaun."
 },
 {
   "id": 1433,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 11,
   "firman": "Yusuf menunjukkan kepada ayahnya dan saudara-saudaranya tempat untuk menetap dan memberikan kepada mereka tanah milik di tanah Mesir, di tempat yang terbaik di negeri itu, di tanah Rameses, seperti yang diperintahkan Firaun."
 },
 {
   "id": 1434,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 12,
   "firman": "Dan Yusuf memelihara ayahnya, saudara-saudaranya dan seisi rumah ayahnya dengan makanan, menurut jumlah anak-anak mereka."
 },
 {
   "id": 1435,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 13,
   "firman": "Di seluruh negeri itu tidak ada makanan, sebab kelaparan itu sangat hebat, sehingga seisi tanah Mesir dan tanah Kanaan lemah lesu karena kelaparan itu."
 },
 {
   "id": 1436,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 14,
   "firman": "Maka Yusuf mengumpulkan segala uang yang terdapat di tanah Mesir dan di tanah Kanaan, yakni uang pembayar gandum yang dibeli mereka; dan Yusuf membawa uang itu ke dalam istana Firaun."
 },
 {
   "id": 1437,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 15,
   "firman": "Setelah habis uang di tanah Mesir dan di tanah Kanaan, datanglah semua orang Mesir menghadap Yusuf serta berkata: \"Berilah makanan kepada kami! Mengapa kami harus mati di depanmu? Sebab tidak ada lagi uang.\""
 },
 {
   "id": 1438,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 16,
   "firman": "Jawab Yusuf: \"Jika tidak ada lagi uang, berilah ternakmu, maka aku akan memberi makanan kepadamu sebagai ganti ternakmu itu.\""
 },
 {
   "id": 1439,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 17,
   "firman": "Lalu mereka membawa ternaknya kepada Yusuf dan Yusuf memberi makanan kepada mereka ganti kuda, kumpulan kambing domba dan kumpulan lembu sapi dan keledainya, jadi disediakannyalah bagi mereka makanan ganti segala ternaknya pada tahun itu."
 },
 {
   "id": 1440,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 18,
   "firman": "Setelah lewat tahun itu, datanglah mereka kepadanya, pada tahun yang kedua, serta berkata kepadanya: \"Tidak usah kami sembunyikan kepada tuanku, bahwa setelah uang kami habis dan setelah kumpulan ternak kami menjadi milik tuanku, tidaklah ada lagi yang tinggal yang dapat kami serahkan kepada tuanku selain badan kami dan tanah kami."
 },
 {
   "id": 1441,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 19,
   "firman": "Mengapa kami harus mati di depan matamu, baik kami maupun tanah kami? Belilah kami dan tanah kami sebagai ganti makanan, maka kami dengan tanah kami akan menjadi hamba kepada Firaun. Berikanlah benih, supaya kami hidup dan jangan mati, dan supaya tanah itu jangan menjadi tandus.\""
 },
 {
   "id": 1442,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 20,
   "firman": "Lalu Yusuf membeli segala tanah orang Mesir untuk Firaun, sebab orang Mesir itu masing-masing menjual ladangnya, karena berat kelaparan itu menimpa mereka. Demikianlah negeri itu menjadi milik Firaun."
 },
 {
   "id": 1443,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 21,
   "firman": "Dan tentang rakyat itu, diperhambakannyalah mereka di daerah Mesir dari ujung yang satu sampai ujung yang lain."
 },
 {
   "id": 1444,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 22,
   "firman": "Hanya tanah para imam tidak dibelinya, sebab para imam mendapat tunjangan tetap dari Firaun, dan mereka hidup dari tunjangan itu; itulah sebabnya mereka tidak menjual tanahnya."
 },
 {
   "id": 1445,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 23,
   "firman": "Berkatalah Yusuf kepada rakyat itu: \"Pada hari ini aku telah membeli kamu dan tanahmu untuk Firaun; inilah benih bagimu, supaya kamu dapat menabur di tanah itu."
 },
 {
   "id": 1446,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 24,
   "firman": "Mengenai hasilnya, kamu harus berikan seperlima bagian kepada Firaun, dan yang empat bagian lagi, itulah menjadi benih untuk ladangmu dan menjadi makanan kamu dan mereka yang ada di rumahmu, dan menjadi makanan anak-anakmu.\""
 },
 {
   "id": 1447,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 25,
   "firman": "Lalu berkatalah mereka: \"Engkau telah memelihara hidup kami; asal kiranya kami mendapat kasih tuanku, biarlah kami menjadi hamba kepada Firaun.\""
 },
 {
   "id": 1448,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 26,
   "firman": "Yusuf membuat hal itu menjadi suatu ketetapan mengenai tanah di Mesir sampai sekarang, yakni bahwa seperlima dari hasilnya menjadi milik Firaun; hanya tanah para imam tidak menjadi milik Firaun."
 },
 {
   "id": 1449,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 27,
   "firman": "Maka diamlah Israel di tanah Mesir, di tanah Gosyen, dan mereka menjadi penduduk di situ. Mereka beranak cucu dan sangat bertambah banyak."
 },
 {
   "id": 1450,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 28,
   "firman": "Dan Yakub masih hidup tujuh belas tahun di tanah Mesir, maka umur Yakub, yakni tahun-tahun hidupnya, menjadi seratus empat puluh tujuh tahun."
 },
 {
   "id": 1451,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 29,
   "firman": "Ketika hampir waktunya bahwa Israel akan mati, dipanggilnyalah anaknya, Yusuf, dan berkata kepadanya: \"Jika aku mendapat kasihmu, letakkanlah kiranya tanganmu di bawah pangkal pahaku, dan bersumpahlah, bahwa engkau akan menunjukkan kasih dan setia kepadaku: Janganlah kiranya kuburkan aku di Mesir,"
 },
 {
   "id": 1452,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 30,
   "firman": "karena aku mau mendapat perhentian bersama-sama dengan nenek moyangku. Sebab itu angkutlah aku dari Mesir dan kuburkanlah aku dalam kubur mereka.\" Jawabnya: \"Aku akan berbuat seperti katamu itu.\""
 },
 {
   "id": 1453,
   "kitab": "Kej",
   "pasal": 47,
   "ayat": 31,
   "firman": "Kemudian kata Yakub: \"Bersumpahlah kepadaku.\" Maka Yusufpun bersumpah kepadanya. Lalu sujudlah Israel di sebelah kepala tempat tidurnya."
 },
 {
   "id": 1454,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 1,
   "firman": "Sesudah itu ada orang mengatakan kepada Yusuf: \"Ayahmu sakit!\" Lalu dibawanyalah kedua anaknya, Manasye dan Efraim."
 },
 {
   "id": 1455,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 2,
   "firman": "Ketika diberitahukan kepada Yakub: \"Telah datang anakmu Yusuf kepadamu,\" maka Israel mengumpulkan segenap kekuatannya dan duduklah ia di tempat tidurnya."
 },
 {
   "id": 1456,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 3,
   "firman": "Berkatalah Yakub kepada Yusuf: \"Allah, Yang Mahakuasa telah menampakkan diri kepadaku di Lus di tanah Kanaan dan memberkati aku"
 },
 {
   "id": 1457,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 4,
   "firman": "serta berfirman kepadaku: Akulah yang membuat engkau beranak cucu, dan Aku akan membuat engkau bertambah banyak dan menjadi sekumpulan bangsa-bangsa; Aku akan memberikan negeri ini kepada keturunanmu untuk menjadi miliknya sampai selama-lamanya."
 },
 {
   "id": 1458,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 5,
   "firman": "Maka sekarang kedua anakmu yang lahir bagimu di tanah Mesir, sebelum aku datang kepadamu ke Mesir, akulah yang empunya mereka; akulah yang akan empunya Efraim dan Manasye sama seperti Ruben dan Simeon."
 },
 {
   "id": 1459,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 6,
   "firman": "Dan keturunanmu yang kauperoleh sesudah mereka, engkaulah yang empunya, tetapi dalam pembagian warisan nama mereka akan disebutkan berdasarkan nama kedua saudaranya itu."
 },
 {
   "id": 1460,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 7,
   "firman": "Kalau aku, pada waktu perjalananku dari Padan, aku kematian Rahel di tanah Kanaan di jalan, ketika kami tidak berapa jauh lagi dari Efrata, dan aku menguburkannya di sana, di sisi jalan ke Efrata\" --yaitu Betlehem."
 },
 {
   "id": 1461,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 8,
   "firman": "Ketika Israel melihat anak-anak Yusuf itu, bertanyalah ia: \"Siapakah ini?\""
 },
 {
   "id": 1462,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 9,
   "firman": "Jawab Yusuf kepada ayahnya: \"Inilah anak-anakku yang telah diberikan Allah kepadaku di sini.\" Maka kata Yakub: \"Dekatkanlah mereka kepadaku, supaya kuberkati mereka.\""
 },
 {
   "id": 1463,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 10,
   "firman": "Adapun mata Israel telah kabur karena tuanya, jadi ia tidak dapat lagi melihat. Kemudian Yusuf mendekatkan mereka kepada ayahnya: dan mereka dicium serta didekap oleh ayahnya."
 },
 {
   "id": 1464,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 11,
   "firman": "Lalu berkatalah Israel kepada Yusuf: \"Tidak kusangka-sangka, bahwa aku akan melihat mukamu lagi, tetapi sekarang Allah bahkan memberi aku melihat keturunanmu.\""
 },
 {
   "id": 1465,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 12,
   "firman": "Lalu Yusuf menarik mereka dari antara lutut ayahnya, dan ia sujud dengan mukanya sampai ke tanah."
 },
 {
   "id": 1466,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 13,
   "firman": "Setelah itu Yusuf memegang mereka keduanya, dengan tangan kanan dipegangnya Efraim, yaitu di sebelah kiri Israel, dan dengan tangan kiri Manasye, yaitu di sebelah kanan Israel, lalu didekatkannyalah mereka kepadanya."
 },
 {
   "id": 1467,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 14,
   "firman": "Tetapi Israel mengulurkan tangan kanannya dan meletakkannya di atas kepala Efraim, walaupun ia yang bungsu, dan tangan kirinya di atas kepala Manasye--jadi tangannya bersilang, walaupun Manasye yang sulung."
 },
 {
   "id": 1468,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 15,
   "firman": "Sesudah itu diberkatinyalah Yusuf, katanya: \"Nenekku dan ayahku, Abraham dan Ishak, telah hidup di hadapan Allah; Allah itu, sebagai Allah yang telah menjadi gembalaku selama hidupku sampai sekarang,"
 },
 {
   "id": 1469,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 16,
   "firman": "dan sebagai Malaikat yang telah melepaskan aku dari segala bahaya, Dialah kiranya yang memberkati orang-orang muda ini, sehingga namaku serta nama nenek dan bapaku, Abraham dan Ishak, termasyhur oleh karena mereka dan sehingga mereka bertambah-tambah menjadi jumlah yang besar di bumi.\""
 },
 {
   "id": 1470,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 17,
   "firman": "Ketika Yusuf melihat bahwa ayahnya meletakkan tangan kanannya di atas kepala Efraim, hal itu dipandangnya tidak baik; lalu dipegangnya tangan ayahnya untuk memindahkannya dari atas kepala Efraim ke atas kepala Manasye."
 },
 {
   "id": 1471,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 18,
   "firman": "Katanya kepada ayahnya: \"Janganlah demikian, ayahku, sebab inilah yang sulung, letakkanlah tangan kananmu ke atas kepalanya.\""
 },
 {
   "id": 1472,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 19,
   "firman": "Tetapi ayahnya menolak, katanya: \"Aku tahu, anakku, aku tahu; ia juga akan menjadi suatu bangsa dan ia juga akan menjadi besar kuasanya; walaupun begitu, adiknya akan lebih besar kuasanya dari padanya, dan keturunan adiknya itu akan menjadi sejumlah besar bangsa-bangsa.\""
 },
 {
   "id": 1473,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 20,
   "firman": "Lalu diberkatinyalah mereka pada waktu itu, katanya: \"Dengan menyebutkan namamulah orang Israel akan memberkati, demikian: Allah kiranya membuat engkau seperti Efraim dan seperti Manasye.\" Demikianlah didahulukannya Efraim dari pada Manasye."
 },
 {
   "id": 1474,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 21,
   "firman": "Kemudian berkatalah Israel kepada Yusuf: \"Tidak lama lagi aku akan mati, tetapi Allah akan menyertai kamu dan membawa kamu kembali ke negeri nenek moyangmu."
 },
 {
   "id": 1475,
   "kitab": "Kej",
   "pasal": 48,
   "ayat": 22,
   "firman": "Dan sekarang aku memberikan kepadamu sebagai kelebihanmu dari pada saudara-saudaramu, suatu punggung gunung yang kurebut dengan pedang dan panahku dari tangan orang Amori.\""
 },
 {
   "id": 1476,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 1,
   "firman": "Kemudian Yakub memanggil anak-anaknya dan berkata: \"Datanglah berkumpul, supaya kuberitahukan kepadamu, apa yang akan kamu alami di kemudian hari."
 },
 {
   "id": 1477,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 2,
   "firman": "Berhimpunlah kamu dan dengarlah, ya anak-anak Yakub, dengarlah kepada Israel, ayahmu."
 },
 {
   "id": 1478,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 3,
   "firman": "Ruben, engkaulah anak sulungku, kekuatanku dan permulaan kegagahanku, engkaulah yang terutama dalam keluhuran, yang terutama dalam kesanggupan."
 },
 {
   "id": 1479,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 4,
   "firman": "Engkau yang membual sebagai air, tidak lagi engkau yang terutama, sebab engkau telah menaiki tempat tidur ayahmu; waktu itu engkau telah melanggar kesuciannya. Dia telah menaiki petiduranku!"
 },
 {
   "id": 1480,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 5,
   "firman": "Simeon dan Lewi bersaudara; senjata mereka ialah alat kekerasan."
 },
 {
   "id": 1481,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 6,
   "firman": "Janganlah kiranya jiwaku turut dalam permupakatan mereka, janganlah kiranya rohku bersatu dengan perkumpulan mereka, sebab dalam kemarahannya mereka telah membunuh orang dan dalam keangkaraannya mereka telah memotong urat keting lembu."
 },
 {
   "id": 1482,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 7,
   "firman": "Terkutuklah kemarahan mereka, sebab amarahnya keras, terkutuklah keberangan mereka, sebab berangnya bengis. Aku akan membagi-bagikan mereka di antara anak-anak Yakub dan menyerakkan mereka di antara anak-anak Israel."
 },
 {
   "id": 1483,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 8,
   "firman": "Yehuda, engkau akan dipuji oleh saudara-saudaramu, tanganmu akan menekan tengkuk musuhmu, kepadamu akan sujud anak-anak ayahmu."
 },
 {
   "id": 1484,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 9,
   "firman": "Yehuda adalah seperti anak singa: setelah menerkam, engkau naik ke suatu tempat yang tinggi, hai anakku; ia meniarap dan berbaring seperti singa jantan atau seperti singa betina; siapakah yang berani membangunkannya?"
 },
 {
   "id": 1485,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 10,
   "firman": "Tongkat kerajaan tidak akan beranjak dari Yehuda ataupun lambang pemerintahan dari antara kakinya, sampai dia datang yang berhak atasnya, maka kepadanya akan takluk bangsa-bangsa."
 },
 {
   "id": 1486,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 11,
   "firman": "Ia akan menambatkan keledainya pada pohon anggur dan anak keledainya pada pohon anggur pilihan; ia akan mencuci pakaiannya dengan anggur dan bajunya dengan darah buah anggur."
 },
 {
   "id": 1487,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 12,
   "firman": "Matanya akan merah karena anggur dan giginya akan putih karena susu."
 },
 {
   "id": 1488,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 13,
   "firman": "Zebulon akan diam di tepi pantai laut, ia akan menjadi pangkalan kapal, dan batasnya akan bersisi dengan Sidon."
 },
 {
   "id": 1489,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 14,
   "firman": "Isakhar adalah seperti keledai yang kuat tulangnya, yang meniarap diapit bebannya,"
 },
 {
   "id": 1490,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 15,
   "firman": "ketika dilihatnya, bahwa perhentian itu baik dan negeri itu permai, maka disendengkannyalah bahunya untuk memikul, lalu menjadi budak rodi."
 },
 {
   "id": 1491,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 16,
   "firman": "Adapun Dan, ia akan mengadili bangsanya sebagai salah satu suku Israel."
 },
 {
   "id": 1492,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 17,
   "firman": "Semoga Dan menjadi seperti ular di jalan, seperti ular beludak di denai yang memagut tumit kuda, sehingga penunggangnya jatuh ke belakang."
 },
 {
   "id": 1493,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 18,
   "firman": "Aku menanti-nantikan keselamatan yang dari pada-Mu, ya TUHAN."
 },
 {
   "id": 1494,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 19,
   "firman": "Gad, ia akan diserang oleh gerombolan, tetapi ia akan menyerang tumit mereka."
 },
 {
   "id": 1495,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 20,
   "firman": "Asyer, makanannya akan limpah mewah dan ia akan memberikan santapan raja-raja."
 },
 {
   "id": 1496,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 21,
   "firman": "Naftali adalah seperti rusa betina yang terlepas; ia akan melahirkan anak-anak indah."
 },
 {
   "id": 1497,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 22,
   "firman": "Yusuf adalah seperti pohon buah-buahan yang muda, pohon buah-buahan yang muda pada mata air. Dahan-dahannya naik mengatasi tembok."
 },
 {
   "id": 1498,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 23,
   "firman": "Walaupun pemanah-pemanah telah mengusiknya, memanahnya dan menyerbunya,"
 },
 {
   "id": 1499,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 24,
   "firman": "namun panahnya tetap kokoh dan lengan tangannya tinggal liat, oleh pertolongan Yang Mahakuat pelindung Yakub, oleh sebab gembalanya Gunung Batu Israel,"
 },
 {
   "id": 1500,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 25,
   "firman": "oleh Allah ayahmu yang akan menolong engkau, dan oleh Allah Yang Mahakuasa, yang akan memberkati engkau dengan berkat dari langit di atas, dengan berkat samudera raya yang letaknya di bawah, dengan berkat buah dada dan kandungan."
 },
 {
   "id": 1501,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 26,
   "firman": "Berkat ayahmu melebihi berkat gunung-gunung yang sejak dahulu, yakni yang paling sedap di bukit-bukit yang berabad-abad; semuanya itu akan turun ke atas kepala Yusuf, ke atas batu kepala orang yang teristimewa di antara saudara-saudaranya."
 },
 {
   "id": 1502,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 27,
   "firman": "Benyamin adalah seperti serigala yang menerkam; pada waktu pagi ia memakan mangsanya dan pada waktu petang ia membagi-bagi rampasannya.\""
 },
 {
   "id": 1503,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 28,
   "firman": "Itulah semuanya suku Israel, dua belas jumlahnya; dan itulah yang dikatakan ayahnya kepada mereka, ketika ia memberkati mereka; tiap-tiap orang diberkatinya dengan berkat yang diuntukkan kepada mereka masing-masing."
 },
 {
   "id": 1504,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 29,
   "firman": "Kemudian berpesanlah Yakub kepada mereka: \"Apabila aku nanti dikumpulkan kepada kaum leluhurku, kuburkanlah aku di sisi nenek moyangku dalam gua yang di ladang Efron, orang Het itu,"
 },
 {
   "id": 1505,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 30,
   "firman": "dalam gua yang di ladang Makhpela di sebelah timur Mamre di tanah Kanaan, ladang yang telah dibeli Abraham dari Efron, orang Het itu, untuk menjadi kuburan milik."
 },
 {
   "id": 1506,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 31,
   "firman": "Di situlah dikuburkan Abraham beserta Sara, isterinya; di situlah dikuburkan Ishak beserta Ribka, isterinya,"
 },
 {
   "id": 1507,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 32,
   "firman": "dan di situlah juga kukuburkan Lea; ladang dengan gua yang ada di sana telah dibeli dari orang Het.\""
 },
 {
   "id": 1508,
   "kitab": "Kej",
   "pasal": 49,
   "ayat": 33,
   "firman": "Setelah Yakub selesai berpesan kepada anak-anaknya, ditariknyalah kakinya ke atas tempat berbaring dan meninggallah ia, maka ia dikumpulkan kepada kaum leluhurnya."
 },
 {
   "id": 1509,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 1,
   "firman": "Lalu Yusuf merebahkan dirinya mendekap muka ayahnya serta menangisi dan mencium dia."
 },
 {
   "id": 1510,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 2,
   "firman": "Dan Yusuf memerintahkan kepada tabib-tabib, yaitu hamba-hambanya, untuk merempah-rempahi mayat ayahnya; maka tabib-tabib itu merempah-rempahi mayat Israel."
 },
 {
   "id": 1511,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 3,
   "firman": "Hal itu memerlukan empat puluh hari lamanya, sebab demikianlah lamanya waktu yang diperlukan untuk merempah-rempahi, dan orang Mesir menangisi dia tujuh puluh hari lamanya."
 },
 {
   "id": 1512,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 4,
   "firman": "Setelah lewat hari-hari penangisan itu, berkatalah Yusuf kepada seisi istana Firaun: \"Jika kiranya aku mendapat kasihmu, katakanlah kepada Firaun,"
 },
 {
   "id": 1513,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 5,
   "firman": "bahwa ayahku telah menyuruh aku bersumpah, katanya: Tidak lama lagi aku akan mati; dalam kuburku yang telah kugali di tanah Kanaan, di situlah kaukuburkan aku. Oleh sebab itu, izinkanlah aku pergi ke sana, supaya aku menguburkan ayahku; kemudian aku akan kembali.\""
 },
 {
   "id": 1514,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 6,
   "firman": "Lalu berkatalah Firaun: \"Pergilah ke sana dan kuburkanlah ayahmu itu, seperti yang telah disuruhnya engkau bersumpah.\""
 },
 {
   "id": 1515,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 7,
   "firman": "Lalu berjalanlah Yusuf ke sana untuk menguburkan ayahnya, dan bersama-sama dengan dia berjalanlah semua pegawai Firaun, para tua-tua dari istananya, dan semua tua-tua dari tanah Mesir,"
 },
 {
   "id": 1516,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 8,
   "firman": "serta seisi rumah Yusuf juga, saudara-saudaranya dan seisi rumah ayahnya; hanya anak-anaknya serta kambing domba dan lembu sapinya ditinggalkan mereka di tanah Gosyen."
 },
 {
   "id": 1517,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 9,
   "firman": "Baik kereta maupun orang-orang berkuda turut pergi ke sana bersama-sama dengan dia, sehingga iring-iringan itu sangat besar."
 },
 {
   "id": 1518,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 10,
   "firman": "Setelah mereka sampai ke Goren-Haatad, yang di seberang sungai Yordan, maka mereka mengadakan di situ ratapan yang sangat sedih dan riuh; dan Yusuf mengadakan perkabungan tujuh hari lamanya karena ayahnya itu."
 },
 {
   "id": 1519,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 11,
   "firman": "Ketika penduduk negeri itu, orang-orang Kanaan, melihat perkabungan di Goren-Haatad itu, berkatalah mereka: \"Inilah perkabungan orang Mesir yang amat riuh.\" Itulah sebabnya tempat itu dinamai Abel-Mizraim, yang letaknya di seberang Yordan."
 },
 {
   "id": 1520,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 12,
   "firman": "Anak-anak Yakub melakukan kepadanya, seperti yang dipesankannya kepada mereka."
 },
 {
   "id": 1521,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 13,
   "firman": "Anak-anaknya mengangkut dia ke tanah Kanaan, dan mereka menguburkan dia dalam gua di ladang Makhpela yang telah dibeli Abraham dari Efron, orang Het itu, untuk menjadi kuburan milik, yaitu ladang yang di sebelah timur Mamre."
 },
 {
   "id": 1522,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 14,
   "firman": "Setelah ayahnya dikuburkan, pulanglah Yusuf ke Mesir, dia dan saudara-saudaranya dan semua orang yang turut pergi ke sana bersama-sama dengan dia untuk menguburkan ayahnya itu."
 },
 {
   "id": 1523,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 15,
   "firman": "Ketika saudara-saudara Yusuf melihat, bahwa ayah mereka telah mati, berkatalah mereka: \"Boleh jadi Yusuf akan mendendam kita dan membalaskan sepenuhnya kepada kita segala kejahatan yang telah kita lakukan kepadanya.\""
 },
 {
   "id": 1524,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 16,
   "firman": "Sebab itu mereka menyuruh menyampaikan pesan ini kepada Yusuf: \"Sebelum ayahmu mati, ia telah berpesan:"
 },
 {
   "id": 1525,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 17,
   "firman": "Beginilah harus kamu katakan kepada Yusuf: Ampunilah kiranya kesalahan saudara-saudaramu dan dosa mereka, sebab mereka telah berbuat jahat kepadamu. Maka sekarang, ampunilah kiranya kesalahan yang dibuat hamba-hamba Allah ayahmu.\" Lalu menangislah Yusuf, ketika orang berkata demikian kepadanya."
 },
 {
   "id": 1526,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 18,
   "firman": "Juga saudara-saudaranya datang sendiri dan sujud di depannya serta berkata: \"Kami datang untuk menjadi budakmu.\""
 },
 {
   "id": 1527,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 19,
   "firman": "Tetapi Yusuf berkata kepada mereka: \"Janganlah takut, sebab aku inikah pengganti Allah?"
 },
 {
   "id": 1528,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 20,
   "firman": "Memang kamu telah mereka-rekakan yang jahat terhadap aku, tetapi Allah telah mereka-rekakannya untuk kebaikan, dengan maksud melakukan seperti yang terjadi sekarang ini, yakni memelihara hidup suatu bangsa yang besar."
 },
 {
   "id": 1529,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 21,
   "firman": "Jadi janganlah takut, aku akan menanggung makanmu dan makan anak-anakmu juga.\" Demikianlah ia menghiburkan mereka dan menenangkan hati mereka dengan perkataannya."
 },
 {
   "id": 1530,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 22,
   "firman": "Adapun Yusuf, ia tetap tinggal di Mesir beserta kaum keluarganya; dan Yusuf hidup seratus sepuluh tahun."
 },
 {
   "id": 1531,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 23,
   "firman": "Jadi Yusuf sempat melihat anak cucu Efraim sampai keturunan yang ketiga; juga anak-anak Makhir, anak Manasye, lahir di pangkuan Yusuf."
 },
 {
   "id": 1532,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 24,
   "firman": "Berkatalah Yusuf kepada saudara-saudaranya: \"Tidak lama lagi aku akan mati; tentu Allah akan memperhatikan kamu dan membawa kamu keluar dari negeri ini, ke negeri yang telah dijanjikan-Nya dengan sumpah kepada Abraham, Ishak dan Yakub.\""
 },
 {
   "id": 1533,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 25,
   "firman": "Lalu Yusuf menyuruh anak-anak Israel bersumpah, katanya: \"Tentu Allah akan memperhatikan kamu; pada waktu itu kamu harus membawa tulang-tulangku dari sini.\""
 },
 {
   "id": 1534,
   "kitab": "Kej",
   "pasal": 50,
   "ayat": 26,
   "firman": "Kemudian matilah Yusuf, berumur seratus sepuluh tahun. Mayatnya dirempah-rempahi, dan ditaruh dalam peti mati di Mesir."
 },
 {
   "id": 1535,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 1,
   "firman": "Inilah nama para anak Israel yang datang ke Mesir bersama-sama dengan Yakub; mereka datang dengan keluarganya masing-masing:"
 },
 {
   "id": 1536,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 2,
   "firman": "Ruben, Simeon, Lewi dan Yehuda;"
 },
 {
   "id": 1537,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 3,
   "firman": "Isakhar, Zebulon dan Benyamin;"
 },
 {
   "id": 1538,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dan serta Naftali, Gad dan Asyer."
 },
 {
   "id": 1539,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 5,
   "firman": "Seluruh keturunan yang diperoleh Yakub berjumlah tujuh puluh jiwa. Tetapi Yusuf telah ada di Mesir."
 },
 {
   "id": 1540,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kemudian matilah Yusuf, serta semua saudara-saudaranya dan semua orang yang seangkatan dengan dia."
 },
 {
   "id": 1541,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 7,
   "firman": "Orang-orang Israel beranak cucu dan tak terbilang jumlahnya; mereka bertambah banyak dan dengan dahsyat berlipat ganda, sehingga negeri itu dipenuhi mereka."
 },
 {
   "id": 1542,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 8,
   "firman": "Kemudian bangkitlah seorang raja baru memerintah tanah Mesir, yang tidak mengenal Yusuf."
 },
 {
   "id": 1543,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 9,
   "firman": "Berkatalah raja itu kepada rakyatnya: \"Bangsa Israel itu sangat banyak dan lebih besar jumlahnya dari pada kita."
 },
 {
   "id": 1544,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 10,
   "firman": "Marilah kita bertindak dengan bijaksana terhadap mereka, supaya mereka jangan bertambah banyak lagi dan--jika terjadi peperangan--jangan bersekutu nanti dengan musuh kita dan memerangi kita, lalu pergi dari negeri ini.\""
 },
 {
   "id": 1545,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 11,
   "firman": "Sebab itu pengawas-pengawas rodi ditempatkan atas mereka untuk menindas mereka dengan kerja paksa: mereka harus mendirikan bagi Firaun kota-kota perbekalan, yakni Pitom dan Raamses."
 },
 {
   "id": 1546,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 12,
   "firman": "Tetapi makin ditindas, makin bertambah banyak dan berkembang mereka, sehingga orang merasa takut kepada orang Israel itu."
 },
 {
   "id": 1547,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 13,
   "firman": "Lalu dengan kejam orang Mesir memaksa orang Israel bekerja,"
 },
 {
   "id": 1548,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 14,
   "firman": "dan memahitkan hidup mereka dengan pekerjaan yang berat, yaitu mengerjakan tanah liat dan batu bata, dan berbagai-bagai pekerjaan di padang, ya segala pekerjaan yang dengan kejam dipaksakan orang Mesir kepada mereka itu."
 },
 {
   "id": 1549,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 15,
   "firman": "Raja Mesir juga memerintahkan kepada bidan-bidan yang menolong perempuan Ibrani, seorang bernama Sifra dan yang lain bernama Pua, katanya:"
 },
 {
   "id": 1550,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 16,
   "firman": "\"Apabila kamu menolong perempuan Ibrani pada waktu bersalin, kamu harus memperhatikan waktu anak itu lahir: jika anak laki-laki, kamu harus membunuhnya, tetapi jika anak perempuan, bolehlah ia hidup.\""
 },
 {
   "id": 1551,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 17,
   "firman": "Tetapi bidan-bidan itu takut akan Allah dan tidak melakukan seperti yang dikatakan raja Mesir kepada mereka, dan membiarkan bayi-bayi itu hidup."
 },
 {
   "id": 1552,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 18,
   "firman": "Lalu raja Mesir memanggil bidan-bidan itu dan bertanya kepada mereka: \"Mengapakah kamu berbuat demikian membiarkan hidup bayi-bayi itu?\""
 },
 {
   "id": 1553,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 19,
   "firman": "Jawab bidan-bidan itu kepada Firaun: \"Sebab perempuan Ibrani tidak sama dengan perempuan Mesir; melainkan mereka kuat: sebelum bidan datang, mereka telah bersalin.\""
 },
 {
   "id": 1554,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 20,
   "firman": "Maka Allah berbuat baik kepada bidan-bidan itu; bertambah banyaklah bangsa itu dan sangat berlipat ganda."
 },
 {
   "id": 1555,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 21,
   "firman": "Dan karena bidan-bidan itu takut akan Allah, maka Ia membuat mereka berumah tangga."
 },
 {
   "id": 1556,
   "kitab": "Kel",
   "pasal": 1,
   "ayat": 22,
   "firman": "Lalu Firaun memberi perintah kepada seluruh rakyatnya: \"Lemparkanlah segala anak laki-laki yang lahir bagi orang Ibrani ke dalam sungai Nil; tetapi segala anak perempuan biarkanlah hidup.\""
 },
 {
   "id": 1557,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 1,
   "firman": "Seorang laki-laki dari keluarga Lewi kawin dengan seorang perempuan Lewi;"
 },
 {
   "id": 1558,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 2,
   "firman": "lalu mengandunglah ia dan melahirkan seorang anak laki-laki. Ketika dilihatnya, bahwa anak itu cantik, disembunyikannya tiga bulan lamanya."
 },
 {
   "id": 1559,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 3,
   "firman": "Tetapi ia tidak dapat menyembunyikannya lebih lama lagi, sebab itu diambilnya sebuah peti pandan, dipakalnya dengan gala-gala dan ter, diletakkannya bayi itu di dalamnya dan ditaruhnya peti itu di tengah-tengah teberau di tepi sungai Nil;"
 },
 {
   "id": 1560,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 4,
   "firman": "kakaknya perempuan berdiri di tempat yang agak jauh untuk melihat, apakah yang akan terjadi dengan dia."
 },
 {
   "id": 1561,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 5,
   "firman": "Maka datanglah puteri Firaun untuk mandi di sungai Nil, sedang dayang-dayangnya berjalan-jalan di tepi sungai Nil, lalu terlihatlah olehnya peti yang di tengah-tengah teberau itu, maka disuruhnya hambanya perempuan untuk mengambilnya."
 },
 {
   "id": 1562,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 6,
   "firman": "Ketika dibukanya, dilihatnya bayi itu, dan tampaklah anak itu menangis, sehingga belas kasihanlah ia kepadanya dan berkata: \"Tentulah ini bayi orang Ibrani.\""
 },
 {
   "id": 1563,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 7,
   "firman": "Lalu bertanyalah kakak anak itu kepada puteri Firaun: \"Akan kupanggilkah bagi tuan puteri seorang inang penyusu dari perempuan Ibrani untuk menyusukan bayi itu bagi tuan puteri?\""
 },
 {
   "id": 1564,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 8,
   "firman": "Sahut puteri Firaun kepadanya: \"Baiklah.\" Lalu pergilah gadis itu memanggil ibu bayi itu."
 },
 {
   "id": 1565,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 9,
   "firman": "Maka berkatalah puteri Firaun kepada ibu itu: \"Bawalah bayi ini dan susukanlah dia bagiku, maka aku akan memberi upah kepadamu.\" Kemudian perempuan itu mengambil bayi itu dan menyusuinya."
 },
 {
   "id": 1566,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 10,
   "firman": "Ketika anak itu telah besar, dibawanyalah kepada puteri Firaun, yang mengangkatnya menjadi anaknya, dan menamainya Musa, sebab katanya: \"Karena aku telah menariknya dari air.\""
 },
 {
   "id": 1567,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 11,
   "firman": "Pada waktu itu, ketika Musa telah dewasa, ia keluar mendapatkan saudara-saudaranya untuk melihat kerja paksa mereka; lalu dilihatnyalah seorang Mesir memukul seorang Ibrani, seorang dari saudara-saudaranya itu."
 },
 {
   "id": 1568,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 12,
   "firman": "Ia menoleh ke sana sini dan ketika dilihatnya tidak ada orang, dibunuhnya orang Mesir itu, dan disembunyikannya mayatnya dalam pasir."
 },
 {
   "id": 1569,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 13,
   "firman": "Ketika keesokan harinya ia keluar lagi, didapatinya dua orang Ibrani tengah berkelahi. Ia bertanya kepada yang bersalah itu: \"Mengapa engkau pukul temanmu?\""
 },
 {
   "id": 1570,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 14,
   "firman": "Tetapi jawabnya: \"Siapakah yang mengangkat engkau menjadi pemimpin dan hakim atas kami? Apakah engkau bermaksud membunuh aku, sama seperti engkau telah membunuh orang Mesir itu?\" Musa menjadi takut, sebab pikirnya: \"Tentulah perkara itu telah ketahuan.\""
 },
 {
   "id": 1571,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 15,
   "firman": "Ketika Firaun mendengar tentang perkara itu, dicarinya ikhtiar untuk membunuh Musa. Tetapi Musa melarikan diri dari hadapan Firaun dan tiba di tanah Midian, lalu ia duduk-duduk di tepi sebuah sumur."
 },
 {
   "id": 1572,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 16,
   "firman": "Adapun imam di Midian itu mempunyai tujuh anak perempuan. Mereka datang menimba air dan mengisi palungan-palungan untuk memberi minum kambing domba ayahnya."
 },
 {
   "id": 1573,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 17,
   "firman": "Maka datanglah gembala-gembala yang mengusir mereka, lalu Musa bangkit menolong mereka dan memberi minum kambing domba mereka."
 },
 {
   "id": 1574,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 18,
   "firman": "Ketika mereka sampai kepada Rehuel, ayah mereka, berkatalah ia: \"Mengapa selekas itu kamu pulang hari ini?\""
 },
 {
   "id": 1575,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 19,
   "firman": "Jawab mereka: \"Seorang Mesir menolong kami terhadap gembala-gembala, bahkan ia menimba air banyak-banyak untuk kami dan memberi minum kambing domba.\""
 },
 {
   "id": 1576,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 20,
   "firman": "Ia berkata kepada anak-anaknya: \"Di manakah ia? Mengapakah kamu tinggalkan orang itu? Panggillah dia makan.\""
 },
 {
   "id": 1577,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 21,
   "firman": "Musa bersedia tinggal di rumah itu, lalu diberikan Rehuellah Zipora, anaknya, kepada Musa."
 },
 {
   "id": 1578,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 22,
   "firman": "Perempuan itu melahirkan seorang anak laki-laki, maka Musa menamainya Gersom, sebab katanya: \"Aku telah menjadi seorang pendatang di negeri asing.\""
 },
 {
   "id": 1579,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 23,
   "firman": "Lama sesudah itu matilah raja Mesir. Tetapi orang Israel masih mengeluh karena perbudakan, dan mereka berseru-seru, sehingga teriak mereka minta tolong karena perbudakan itu sampai kepada Allah."
 },
 {
   "id": 1580,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 24,
   "firman": "Allah mendengar mereka mengerang, lalu Ia mengingat kepada perjanjian-Nya dengan Abraham, Ishak dan Yakub."
 },
 {
   "id": 1581,
   "kitab": "Kel",
   "pasal": 2,
   "ayat": 25,
   "firman": "Maka Allah melihat orang Israel itu, dan Allah memperhatikan mereka."
 },
 {
   "id": 1582,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 1,
   "firman": "Adapun Musa, ia biasa menggembalakan kambing domba Yitro, mertuanya, imam di Midian. Sekali, ketika ia menggiring kambing domba itu ke seberang padang gurun, sampailah ia ke gunung Allah, yakni gunung Horeb."
 },
 {
   "id": 1583,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu Malaikat TUHAN menampakkan diri kepadanya di dalam nyala api yang keluar dari semak duri. Lalu ia melihat, dan tampaklah: semak duri itu menyala, tetapi tidak dimakan api."
 },
 {
   "id": 1584,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 3,
   "firman": "Musa berkata: \"Baiklah aku menyimpang ke sana untuk memeriksa penglihatan yang hebat itu. Mengapakah tidak terbakar semak duri itu?\""
 },
 {
   "id": 1585,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 4,
   "firman": "Ketika dilihat TUHAN, bahwa Musa menyimpang untuk memeriksanya, berserulah Allah dari tengah-tengah semak duri itu kepadanya: \"Musa, Musa!\" dan ia menjawab: \"Ya, Allah.\""
 },
 {
   "id": 1586,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 5,
   "firman": "Lalu Ia berfirman: \"Janganlah datang dekat-dekat: tanggalkanlah kasutmu dari kakimu, sebab tempat, di mana engkau berdiri itu, adalah tanah yang kudus.\""
 },
 {
   "id": 1587,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 6,
   "firman": "Lagi Ia berfirman: \"Akulah Allah ayahmu, Allah Abraham, Allah Ishak dan Allah Yakub.\" Lalu Musa menutupi mukanya, sebab ia takut memandang Allah."
 },
 {
   "id": 1588,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 7,
   "firman": "Dan TUHAN berfirman: \"Aku telah memperhatikan dengan sungguh kesengsaraan umat-Ku di tanah Mesir, dan Aku telah mendengar seruan mereka yang disebabkan oleh pengerah-pengerah mereka, ya, Aku mengetahui penderitaan mereka."
 },
 {
   "id": 1589,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 8,
   "firman": "Sebab itu Aku telah turun untuk melepaskan mereka dari tangan orang Mesir dan menuntun mereka keluar dari negeri itu ke suatu negeri yang baik dan luas, suatu negeri yang berlimpah-limpah susu dan madunya, ke tempat orang Kanaan, orang Het, orang Amori, orang Feris, orang Hewi dan orang Yebus."
 },
 {
   "id": 1590,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 9,
   "firman": "Sekarang seruan orang Israel telah sampai kepada-Ku; juga telah Kulihat, betapa kerasnya orang Mesir menindas mereka."
 },
 {
   "id": 1591,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 10,
   "firman": "Jadi sekarang, pergilah, Aku mengutus engkau kepada Firaun untuk membawa umat-Ku, orang Israel, keluar dari Mesir.\""
 },
 {
   "id": 1592,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 11,
   "firman": "Tetapi Musa berkata kepada Allah: \"Siapakah aku ini, maka aku yang akan menghadap Firaun dan membawa orang Israel keluar dari Mesir?\""
 },
 {
   "id": 1593,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 12,
   "firman": "Lalu firman-Nya: \"Bukankah Aku akan menyertai engkau? Inilah tanda bagimu, bahwa Aku yang mengutus engkau: apabila engkau telah membawa bangsa itu keluar dari Mesir, maka kamu akan beribadah kepada Allah di gunung ini.\""
 },
 {
   "id": 1594,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 13,
   "firman": "Lalu Musa berkata kepada Allah: \"Tetapi apabila aku mendapatkan orang Israel dan berkata kepada mereka: Allah nenek moyangmu telah mengutus aku kepadamu, dan mereka bertanya kepadaku: bagaimana tentang nama-Nya? --apakah yang harus kujawab kepada mereka?\""
 },
 {
   "id": 1595,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 14,
   "firman": "Firman Allah kepada Musa: \"AKU ADALAH AKU.\" Lagi firman-Nya: \"Beginilah kaukatakan kepada orang Israel itu: AKULAH AKU telah mengutus aku kepadamu.\""
 },
 {
   "id": 1596,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 15,
   "firman": "Selanjutnya berfirmanlah Allah kepada Musa: \"Beginilah kaukatakan kepada orang Israel: TUHAN, Allah nenek moyangmu, Allah Abraham, Allah Ishak dan Allah Yakub, telah mengutus aku kepadamu: itulah nama-Ku untuk selama-lamanya dan itulah sebutan-Ku turun-temurun."
 },
 {
   "id": 1597,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 16,
   "firman": "Pergilah, kumpulkanlah para tua-tua Israel dan katakanlah kepada mereka: TUHAN, Allah nenek moyangmu, Allah Abraham, Ishak dan Yakub, telah menampakkan diri kepadaku, serta berfirman: Aku sudah mengindahkan kamu, juga apa yang dilakukan kepadamu di Mesir."
 },
 {
   "id": 1598,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 17,
   "firman": "Jadi Aku telah berfirman: Aku akan menuntun kamu keluar dari kesengsaraan di Mesir menuju ke negeri orang Kanaan, orang Het, orang Amori, orang Feris, orang Hewi dan orang Yebus, ke suatu negeri yang berlimpah-limpah susu dan madunya."
 },
 {
   "id": 1599,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 18,
   "firman": "Dan bilamana mereka mendengarkan perkataanmu, maka engkau harus beserta para tua-tua Israel pergi kepada raja Mesir, dan kamu harus berkata kepadanya: TUHAN, Allah orang Ibrani, telah menemui kami; oleh sebab itu, izinkanlah kiranya kami pergi ke padang gurun tiga hari perjalanan jauhnya untuk mempersembahkan korban kepada TUHAN, Allah kami."
 },
 {
   "id": 1600,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 19,
   "firman": "Tetapi Aku tahu, bahwa raja Mesir tidak akan membiarkan kamu pergi, kecuali dipaksa oleh tangan yang kuat."
 },
 {
   "id": 1601,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 20,
   "firman": "Tetapi Aku akan mengacungkan tangan-Ku dan memukul Mesir dengan segala perbuatan yang ajaib, yang akan Kulakukan di tengah-tengahnya; sesudah itu ia akan membiarkan kamu pergi."
 },
 {
   "id": 1602,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 21,
   "firman": "Dan Aku akan membuat orang Mesir bermurah hati terhadap bangsa ini, sehingga, apabila kamu pergi, kamu tidak pergi dengan tangan hampa,"
 },
 {
   "id": 1603,
   "kitab": "Kel",
   "pasal": 3,
   "ayat": 22,
   "firman": "tetapi tiap-tiap perempuan harus meminta dari tetangganya dan dari perempuan yang tinggal di rumahnya, barang-barang perak dan emas dan kain-kain, yang akan kamu kenakan kepada anak-anakmu lelaki dan perempuan; demikianlah kamu akan merampasi orang Mesir itu.\""
 },
 {
   "id": 1604,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 1,
   "firman": "Lalu sahut Musa: \"Bagaimana jika mereka tidak percaya kepadaku dan tidak mendengarkan perkataanku, melainkan berkata: TUHAN tidak menampakkan diri kepadamu?\""
 },
 {
   "id": 1605,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 2,
   "firman": "TUHAN berfirman kepadanya: \"Apakah yang di tanganmu itu?\" Jawab Musa: \"Tongkat.\""
 },
 {
   "id": 1606,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 3,
   "firman": "Firman TUHAN: \"Lemparkanlah itu ke tanah.\" Dan ketika dilemparkannya ke tanah, maka tongkat itu menjadi ular, sehingga Musa lari meninggalkannya."
 },
 {
   "id": 1607,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 4,
   "firman": "Tetapi firman TUHAN kepada Musa: \"Ulurkanlah tanganmu dan peganglah ekornya\" --Musa mengulurkan tangannya, ditangkapnya ular itu, lalu menjadi tongkat di tangannya"
 },
 {
   "id": 1608,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 5,
   "firman": "--\"supaya mereka percaya, bahwa TUHAN, Allah nenek moyang mereka, Allah Abraham, Allah Ishak dan Allah Yakub telah menampakkan diri kepadamu.\""
 },
 {
   "id": 1609,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 6,
   "firman": "Lagi firman TUHAN kepadanya: \"Masukkanlah tanganmu ke dalam bajumu.\" Dimasukkannya tangannya ke dalam bajunya, dan setelah ditariknya ke luar, maka tangannya kena kusta, putih seperti salju."
 },
 {
   "id": 1610,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 7,
   "firman": "Sesudah itu firman-Nya: \"Masukkanlah tanganmu kembali ke dalam bajumu.\" Musa memasukkan tangannya kembali ke dalam bajunya dan setelah ditariknya ke luar, maka tangan itu pulih kembali seperti seluruh badannya."
 },
 {
   "id": 1611,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 8,
   "firman": "\"Jika mereka tidak percaya kepadamu dan tidak mengindahkan tanda mujizat yang pertama, maka mereka akan percaya kepada tanda mujizat yang kedua."
 },
 {
   "id": 1612,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 9,
   "firman": "Dan jika mereka tidak juga percaya kepada kedua tanda mujizat ini dan tidak mendengarkan perkataanmu, maka engkau harus mengambil air dari sungai Nil dan harus kaucurahkan di tanah yang kering, lalu air yang kauambil itu akan menjadi darah di tanah yang kering itu.\""
 },
 {
   "id": 1613,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 10,
   "firman": "Lalu kata Musa kepada TUHAN: \"Ah, Tuhan, aku ini tidak pandai bicara, dahulupun tidak dan sejak Engkau berfirman kepada hamba-Mupun tidak, sebab aku berat mulut dan berat lidah.\""
 },
 {
   "id": 1614,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 11,
   "firman": "Tetapi TUHAN berfirman kepadanya: \"Siapakah yang membuat lidah manusia, siapakah yang membuat orang bisu atau tuli, membuat orang melihat atau buta; bukankah Aku, yakni TUHAN?"
 },
 {
   "id": 1615,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 12,
   "firman": "Oleh sebab itu, pergilah, Aku akan menyertai lidahmu dan mengajar engkau, apa yang harus kaukatakan.\""
 },
 {
   "id": 1616,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 13,
   "firman": "Tetapi Musa berkata: \"Ah, Tuhan, utuslah kiranya siapa saja yang patut Kauutus.\""
 },
 {
   "id": 1617,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 14,
   "firman": "Maka bangkitlah murka TUHAN terhadap Musa dan Ia berfirman: \"Bukankah di situ Harun, orang Lewi itu, kakakmu? Aku tahu, bahwa ia pandai bicara; lagipula ia telah berangkat menjumpai engkau, dan apabila ia melihat engkau, ia akan bersukacita dalam hatinya."
 },
 {
   "id": 1618,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 15,
   "firman": "Maka engkau harus berbicara kepadanya dan menaruh perkataan itu ke dalam mulutnya; Aku akan menyertai lidahmu dan lidahnya dan mengajarkan kepada kamu apa yang harus kamu lakukan."
 },
 {
   "id": 1619,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 16,
   "firman": "Ia harus berbicara bagimu kepada bangsa itu, dengan demikian ia akan menjadi penyambung lidahmu dan engkau akan menjadi seperti Allah baginya."
 },
 {
   "id": 1620,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 17,
   "firman": "Dan bawalah tongkat ini di tanganmu, yang harus kaupakai untuk membuat tanda-tanda mujizat.\""
 },
 {
   "id": 1621,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 18,
   "firman": "Lalu Musa kembali kepada mertuanya Yitro serta berkata kepadanya: \"Izinkanlah kiranya aku kembali kepada saudara-saudaraku, yang ada di Mesir, untuk melihat apakah mereka masih hidup.\" Yitro berkata kepada Musa: \"Pergilah dengan selamat.\""
 },
 {
   "id": 1622,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 19,
   "firman": "Adapun TUHAN sudah berfirman kepada Musa di Midian: \"Kembalilah ke Mesir, sebab semua orang yang ingin mencabut nyawamu telah mati.\""
 },
 {
   "id": 1623,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 20,
   "firman": "Kemudian Musa mengajak isteri dan anak-anaknya lelaki, lalu menaikkan mereka ke atas keledai dan ia kembali ke tanah Mesir; dan tongkat Allah itu dipegangnya di tangannya."
 },
 {
   "id": 1624,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 21,
   "firman": "Firman TUHAN kepada Musa: \"Pada waktu engkau hendak kembali ini ke Mesir, ingatlah, supaya segala mujizat yang telah Kuserahkan ke dalam tanganmu, kauperbuat di depan Firaun. Tetapi Aku akan mengeraskan hatinya, sehingga ia tidak membiarkan bangsa itu pergi."
 },
 {
   "id": 1625,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 22,
   "firman": "Maka engkau harus berkata kepada Firaun: Beginilah firman TUHAN: Israel ialah anak-Ku, anak-Ku yang sulung;"
 },
 {
   "id": 1626,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 23,
   "firman": "sebab itu Aku berfirman kepadamu: Biarkanlah anak-Ku itu pergi, supaya ia beribadah kepada-Ku; tetapi jika engkau menolak membiarkannya pergi, maka Aku akan membunuh anakmu, anakmu yang sulung.\""
 },
 {
   "id": 1627,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 24,
   "firman": "Tetapi di tengah jalan, di suatu tempat bermalam, TUHAN bertemu dengan Musa dan berikhtiar untuk membunuhnya."
 },
 {
   "id": 1628,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 25,
   "firman": "Lalu Zipora mengambil pisau batu, dipotongnya kulit khatan anaknya, kemudian disentuhnya dengan kulit itu kaki Musa sambil berkata: \"Sesungguhnya engkau pengantin darah bagiku.\""
 },
 {
   "id": 1629,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 26,
   "firman": "Lalu TUHAN membiarkan Musa. \"Pengantin darah,\" kata Zipora waktu itu, karena mengingat sunat itu."
 },
 {
   "id": 1630,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 27,
   "firman": "Berfirmanlah TUHAN kepada Harun: \"Pergilah ke padang gurun menjumpai Musa.\" Ia pergi dan bertemu dengan dia di gunung Allah, lalu menciumnya."
 },
 {
   "id": 1631,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 28,
   "firman": "Kemudian Musa memberitahukan kepada Harun segala firman TUHAN yang disuruhkan-Nya kepadanya untuk disampaikan dan segala tanda mujizat yang diperintahkan-Nya kepadanya untuk dibuat."
 },
 {
   "id": 1632,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 29,
   "firman": "Lalu pergilah Musa beserta Harun dan mereka mengumpulkan semua tua-tua Israel."
 },
 {
   "id": 1633,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 30,
   "firman": "Harun mengucapkan segala firman yang telah diucapkan TUHAN kepada Musa, serta membuat di depan bangsa itu tanda-tanda mujizat itu."
 },
 {
   "id": 1634,
   "kitab": "Kel",
   "pasal": 4,
   "ayat": 31,
   "firman": "Lalu percayalah bangsa itu, dan ketika mereka mendengar, bahwa TUHAN telah mengindahkan orang Israel dan telah melihat kesengsaraan mereka, maka berlututlah mereka dan sujud menyembah."
 },
 {
   "id": 1635,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 1,
   "firman": "Kemudian Musa dan Harun pergi menghadap Firaun, lalu berkata kepadanya: \"Beginilah firman TUHAN, Allah Israel: Biarkanlah umat-Ku pergi untuk mengadakan perayaan bagi-Ku di padang gurun.\""
 },
 {
   "id": 1636,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 2,
   "firman": "Tetapi Firaun berkata: \"Siapakah TUHAN itu yang harus kudengarkan firman-Nya untuk membiarkan orang Israel pergi? Tidak kenal aku TUHAN itu dan tidak juga aku akan membiarkan orang Israel pergi.\""
 },
 {
   "id": 1637,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 3,
   "firman": "Lalu kata mereka: \"Allah orang Ibrani telah menemui kami; izinkanlah kiranya kami pergi ke padang gurun tiga hari perjalanan jauhnya, untuk mempersembahkan korban kepada TUHAN, Allah kami, supaya jangan nanti mendatangkan kepada kami penyakit sampar atau pedang.\""
 },
 {
   "id": 1638,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 4,
   "firman": "Tetapi raja Mesir berkata kepada mereka: \"Musa dan Harun, mengapakah kamu bawa-bawa bangsa ini melalaikan pekerjaannya? Pergilah melakukan pekerjaanmu!\""
 },
 {
   "id": 1639,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 5,
   "firman": "Lagi kata Firaun: \"Lihat, sekarang telah terlalu banyak bangsamu di negeri ini, masakan kamu hendak menghentikan mereka dari kerja paksanya!\""
 },
 {
   "id": 1640,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 6,
   "firman": "Pada hari itu juga Firaun memerintahkan kepada pengerah-pengerah bangsa itu dan kepada mandur-mandur mereka sendiri:"
 },
 {
   "id": 1641,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 7,
   "firman": "\"Tidak boleh lagi kamu memberikan jerami kepada bangsa itu untuk membuat batu bata, seperti sampai sekarang; biarlah mereka sendiri yang pergi mengumpulkan jerami,"
 },
 {
   "id": 1642,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 8,
   "firman": "tetapi jumlah batu bata, yang harus dibuat mereka sampai sekarang, bebankanlah itu juga kepada mereka dan jangan menguranginya, karena mereka pemalas. Itulah sebabnya mereka berteriak-teriak: Izinkanlah kami pergi mempersembahkan korban kepada Allah kami."
 },
 {
   "id": 1643,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 9,
   "firman": "Pekerjaan orang-orang ini harus diperberat, sehingga mereka terikat kepada pekerjaannya dan jangan mempedulikan perkataan dusta.\""
 },
 {
   "id": 1644,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 10,
   "firman": "Maka para pengerah bangsa itu dan para mandurnya pergi dan berkata kepada mereka: \"Beginilah kata Firaun: Aku tidak memberi jerami lagi kepadamu."
 },
 {
   "id": 1645,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 11,
   "firman": "Pergilah kamu sendiri mengambil jerami, di mana saja kamu mendapatnya, tetapi pekerjaanmu sedikitpun tidak boleh kurang.\""
 },
 {
   "id": 1646,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 12,
   "firman": "Lalu berseraklah bangsa itu ke seluruh tanah Mesir untuk mengumpulkan tunggul gandum sebagai pengganti jerami."
 },
 {
   "id": 1647,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 13,
   "firman": "Dan pengerah-pengerah itu mendesak mereka dengan berkata: \"Selesaikan pekerjaanmu, yaitu tugas sehari, seperti pada waktu ada jerami.\""
 },
 {
   "id": 1648,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 14,
   "firman": "Lalu pengerah-pengerah Firaun memukul mandur-mandur Israel, yang mereka angkat, sambil bertanya: \"Mengapakah kamu pada hari ini tidak menyelesaikan jumlah batu bata yang harus kamu buat seperti kemarin?\""
 },
 {
   "id": 1649,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 15,
   "firman": "Sesudah itu pergilah para mandur Israel kepada Firaun dan mengadukan halnya kepadanya: \"Mengapakah tuanku berlaku seperti itu terhadap hamba-hambamu ini?"
 },
 {
   "id": 1650,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 16,
   "firman": "Jerami tidak diberikan lagi kepada hamba-hambamu ini tetapi walaupun begitu, kami diperintahkan: Buatlah batu bata. Dan dalam pada itu hamba-hambamu ini dipukuli, padahal rakyat tuankulah yang bersalah.\""
 },
 {
   "id": 1651,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 17,
   "firman": "Tetapi ia berkata: \"Pemalas kamu, pemalas! Itulah sebabnya kamu berkata: Izinkanlah kami pergi mempersembahkan korban kepada TUHAN!"
 },
 {
   "id": 1652,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 18,
   "firman": "Jadi sekarang, pergilah, bekerja! Jerami tidak akan diberikan lagi kepadamu, tetapi jumlah batu bata yang sama harus kamu serahkan.\""
 },
 {
   "id": 1653,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 19,
   "firman": "Maka mengertilah para mandur Israel, bahwa mereka ada dalam keadaan susah, karena dikatakan kepada mereka: \"Kamu tidak boleh mengurangi jumlah batu bata pada tiap-tiap hari.\""
 },
 {
   "id": 1654,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 20,
   "firman": "Waktu mereka meninggalkan Firaun berjumpalah mereka dengan Musa dan Harun, yang sedang menantikan mereka,"
 },
 {
   "id": 1655,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 21,
   "firman": "lalu mereka berkata kepada keduanya: \"Kiranya TUHAN memperhatikan perbuatanmu dan menghukumkan kamu, karena kamu telah membusukkan nama kami kepada Firaun dan hamba-hambanya dan dengan demikian kamu telah memberikan pisau kepada mereka untuk membunuh kami.\""
 },
 {
   "id": 1656,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 22,
   "firman": "Lalu Musa kembali menghadap TUHAN, katanya: \"Tuhan, mengapakah Kauperlakukan umat ini begitu bengis? Mengapa pula aku yang Kauutus?"
 },
 {
   "id": 1657,
   "kitab": "Kel",
   "pasal": 5,
   "ayat": 23,
   "firman": "Sebab sejak aku pergi menghadap Firaun untuk berbicara atas nama-Mu, dengan jahat diperlakukannya umat ini, dan Engkau tidak melepaskan umat-Mu sama sekali.\""
 },
 {
   "id": 1658,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 1,
   "firman": "(5-24) Tetapi TUHAN berfirman kepada Musa: \"Sekarang engkau akan melihat, apa yang akan Kulakukan kepada Firaun; sebab dipaksa oleh tangan yang kuat ia akan membiarkan mereka pergi, ya dipaksa oleh tangan yang kuat ia akan mengusir mereka dari negerinya.\""
 },
 {
   "id": 1659,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 2,
   "firman": "(6-1) Selanjutnya berfirmanlah Allah kepada Musa: \"Akulah TUHAN."
 },
 {
   "id": 1660,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 3,
   "firman": "(6-2) Aku telah menampakkan diri kepada Abraham, Ishak dan Yakub sebagai Allah Yang Mahakuasa, tetapi dengan nama-Ku TUHAN Aku belum menyatakan diri."
 },
 {
   "id": 1661,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 4,
   "firman": "(6-3) Bukan saja Aku telah mengadakan perjanjian-Ku dengan mereka untuk memberikan kepada mereka tanah Kanaan, tempat mereka tinggal sebagai orang asing,"
 },
 {
   "id": 1662,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 5,
   "firman": "(6-4) tetapi Aku sudah mendengar juga erang orang Israel yang telah diperbudak oleh orang Mesir, dan Aku ingat kepada perjanjian-Ku."
 },
 {
   "id": 1663,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 6,
   "firman": "(6-5) Sebab itu katakanlah kepada orang Israel: Akulah TUHAN, Aku akan membebaskan kamu dari kerja paksa orang Mesir, melepaskan kamu dari perbudakan mereka dan menebus kamu dengan tangan yang teracung dan dengan hukuman-hukuman yang berat."
 },
 {
   "id": 1664,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 7,
   "firman": "(6-6) Aku akan mengangkat kamu menjadi umat-Ku dan Aku akan menjadi Allahmu, supaya kamu mengetahui, bahwa Akulah, TUHAN, Allahmu, yang membebaskan kamu dari kerja paksa orang Mesir."
 },
 {
   "id": 1665,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 8,
   "firman": "(6-7) Dan Aku akan membawa kamu ke negeri yang dengan sumpah telah Kujanjikan memberikannya kepada Abraham, Ishak dan Yakub, dan Aku akan memberikannya kepadamu untuk menjadi milikmu; Akulah TUHAN.\""
 },
 {
   "id": 1666,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 9,
   "firman": "(6-8) Lalu Musa mengatakan demikian kepada orang Israel, tetapi mereka tidak mendengarkan Musa karena mereka putus asa dan karena perbudakan yang berat itu."
 },
 {
   "id": 1667,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 10,
   "firman": "(6-9) Kemudian TUHAN berfirman kepada Musa:"
 },
 {
   "id": 1668,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 11,
   "firman": "(6-10) \"Pergilah menghadap, katakanlah kepada Firaun, raja Mesir, bahwa ia harus membiarkan orang Israel pergi dari negerinya.\""
 },
 {
   "id": 1669,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 12,
   "firman": "(6-11) Tetapi Musa berkata di hadapan TUHAN: \"Orang Israel sendiri tidak mendengarkan aku, bagaimanakah mungkin Firaun akan mendengarkan aku, aku seorang yang tidak petah lidahnya!\""
 },
 {
   "id": 1670,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 13,
   "firman": "(6-12) Demikianlah TUHAN telah berfirman kepada Musa dan Harun, serta mengutus mereka kepada orang Israel dan kepada Firaun, raja Mesir, dengan membawa perintah supaya orang Israel dibawa keluar dari Mesir."
 },
 {
   "id": 1671,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 14,
   "firman": "(6-13) Inilah para kepala kaum keluarga mereka: Anak-anak Ruben anak sulung Israel: Henokh, Palu, Hezron dan Karmi; itulah kaum-kaum Ruben."
 },
 {
   "id": 1672,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 15,
   "firman": "(6-14) Anak-anak Simeon: Yemuel, Yamin, Ohad, Yakhin, Zohar, dan Saul, anak seorang perempuan Kanaan; itulah kaum-kaum Simeon."
 },
 {
   "id": 1673,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 16,
   "firman": "(6-15) Inilah nama anak-anak Lewi menurut urutan kelahirannya: Gerson, Kehat dan Merari. Umur Lewi seratus tiga puluh tujuh tahun."
 },
 {
   "id": 1674,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 17,
   "firman": "(6-16) Anak-anak Gerson: Libni dan Simei, menurut kaum mereka."
 },
 {
   "id": 1675,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 18,
   "firman": "(6-17) Anak-anak Kehat: Amram, Yizhar, Hebron dan Uziel. Umur Kehat seratus tiga puluh tiga tahun."
 },
 {
   "id": 1676,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 19,
   "firman": "(6-18) Anak-anak Merari: Mahli dan Musi. Itulah kaum-kaum Lewi menurut urutannya."
 },
 {
   "id": 1677,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 20,
   "firman": "(6-19) Dan Amram mengambil Yokhebed, saudara ayahnya, menjadi isterinya, dan perempuan ini melahirkan Harun dan Musa baginya. Umur Amram seratus tiga puluh tujuh tahun."
 },
 {
   "id": 1678,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 21,
   "firman": "(6-20) Anak-anak Yizhar: Korah, Nefeg dan Zikhri."
 },
 {
   "id": 1679,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 22,
   "firman": "(6-21) Anak-anak Uziel: Misael, Elsafan dan Sitri."
 },
 {
   "id": 1680,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 23,
   "firman": "(6-22) Dan Harun mengambil Eliseba, anak perempuan Aminadab, saudara perempuan Nahason, menjadi isterinya, dan perempuan ini melahirkan baginya Nadab, Abihu, Eleazar dan Itamar."
 },
 {
   "id": 1681,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 24,
   "firman": "(6-23) Anak-anak Korah: Asir, Elkana dan Abiasaf; itulah kaum-kaum orang Korah."
 },
 {
   "id": 1682,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 25,
   "firman": "(6-24) Eleazar, anak Harun, mengambil salah seorang anak perempuan Putiel menjadi isterinya dan perempuan ini melahirkan Pinehas baginya. Itulah para kepala kaum keluarga orang Lewi menurut kaum mereka."
 },
 {
   "id": 1683,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 26,
   "firman": "(6-25) Itulah Harun dan Musa, yang diperintahkan TUHAN: \"Bawalah orang Israel keluar dari tanah Mesir menurut pasukan mereka.\""
 },
 {
   "id": 1684,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 27,
   "firman": "(6-26) Merekalah yang berbicara kepada Firaun, raja Mesir, supaya mereka membawa orang Israel keluar dari Mesir. Itulah Musa dan Harun."
 },
 {
   "id": 1685,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 28,
   "firman": "(6-27) Pada waktu TUHAN berfirman kepada Musa di tanah Mesir,"
 },
 {
   "id": 1686,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 29,
   "firman": "(6-28) TUHAN berfirman kepadanya: \"Akulah TUHAN; katakanlah kepada Firaun, raja Mesir, segala yang Kufirmankan kepadamu.\""
 },
 {
   "id": 1687,
   "kitab": "Kel",
   "pasal": 6,
   "ayat": 30,
   "firman": "(6-29) Tetapi Musa berkata di hadapan TUHAN: \"Bukankah aku ini seorang yang tidak petah lidahnya, bagaimanakah mungkin Firaun akan mendengarkan aku?\""
 },
 {
   "id": 1688,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Lihat, Aku mengangkat engkau sebagai Allah bagi Firaun, dan Harun, abangmu, akan menjadi nabimu."
 },
 {
   "id": 1689,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 2,
   "firman": "Engkau harus mengatakan segala yang Kuperintahkan kepadamu, dan Harun, abangmu, harus berbicara kepada Firaun, supaya dibiarkannya orang Israel itu pergi dari negerinya."
 },
 {
   "id": 1690,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 3,
   "firman": "Tetapi Aku akan mengeraskan hati Firaun, dan Aku akan memperbanyak tanda-tanda dan mujizat-mujizat yang Kubuat di tanah Mesir."
 },
 {
   "id": 1691,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 4,
   "firman": "Bilamana Firaun tidak mendengarkan kamu, maka Aku akan mendatangkan tangan-Ku kepada Mesir dan mengeluarkan pasukan-Ku, umat-Ku, orang Israel, dari tanah Mesir dengan hukuman-hukuman yang berat."
 },
 {
   "id": 1692,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 5,
   "firman": "Dan orang Mesir itu akan mengetahui, bahwa Akulah TUHAN, apabila Aku mengacungkan tangan-Ku terhadap Mesir dan membawa orang Israel keluar dari tengah-tengah mereka.\""
 },
 {
   "id": 1693,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 6,
   "firman": "Demikianlah diperbuat Musa dan Harun; seperti yang diperintahkan TUHAN kepada mereka, demikianlah diperbuat mereka."
 },
 {
   "id": 1694,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 7,
   "firman": "Adapun Musa delapan puluh tahun umurnya dan Harun delapan puluh tiga tahun, ketika mereka berbicara kepada Firaun."
 },
 {
   "id": 1695,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 8,
   "firman": "Dan TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 1696,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 9,
   "firman": "\"Apabila Firaun berkata kepada kamu: Tunjukkanlah suatu mujizat, maka haruslah kaukatakan kepada Harun: Ambillah tongkatmu dan lemparkanlah itu di depan Firaun. Maka tongkat itu akan menjadi ular.\""
 },
 {
   "id": 1697,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 10,
   "firman": "Musa dan Harun pergi menghadap Firaun, lalu mereka berbuat seperti yang diperintahkan TUHAN; Harun melemparkan tongkatnya di depan Firaun dan para pegawainya, maka tongkat itu menjadi ular."
 },
 {
   "id": 1698,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 11,
   "firman": "Kemudian Firaunpun memanggil orang-orang berilmu dan ahli-ahli sihir; dan merekapun, ahli-ahli Mesir itu, membuat yang demikian juga dengan ilmu mantera mereka."
 },
 {
   "id": 1699,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 12,
   "firman": "Masing-masing mereka melemparkan tongkatnya, dan tongkat-tongkat itu menjadi ular; tetapi tongkat Harun menelan tongkat-tongkat mereka."
 },
 {
   "id": 1700,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 13,
   "firman": "Tetapi hati Firaun berkeras, sehingga tidak mau mendengarkan mereka keduanya--seperti yang telah difirmankan TUHAN."
 },
 {
   "id": 1701,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 14,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Firaun berkeras hati, ia menolak membiarkan bangsa itu pergi."
 },
 {
   "id": 1702,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 15,
   "firman": "Pergilah kepada Firaun pada waktu pagi, pada waktu biasanya ia keluar ke sungai; nantikanlah dia di tepi sungai Nil dengan memegang di tanganmu tongkat yang tadinya berubah menjadi ular."
 },
 {
   "id": 1703,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 16,
   "firman": "Dan katakanlah kepadanya: TUHAN, Allah orang Ibrani, telah mengutus aku kepadamu untuk mengatakan: Biarkanlah umat-Ku pergi, supaya mereka beribadah kepada-Ku di padang gurun; meskipun begitu sampai sekarang engkau tidak mau mendengarkan."
 },
 {
   "id": 1704,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 17,
   "firman": "Sebab itu beginilah firman TUHAN: Dari hal yang berikut akan kauketahui, bahwa Akulah TUHAN. Lihat, dengan tongkat yang di tanganku ini akan kupukul air yang di sungai Nil dan air itu akan berubah menjadi darah,"
 },
 {
   "id": 1705,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 18,
   "firman": "dan ikan yang dalam sungai Nil akan mati, sehingga sungai Nil akan berbau busuk; maka orang Mesir akan segan meminum air dari sungai Nil ini.\""
 },
 {
   "id": 1706,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 19,
   "firman": "TUHAN berfirman kepada Musa: \"Katakanlah kepada Harun: Ambillah tongkatmu, ulurkanlah tanganmu ke atas segala air orang Mesir, ke atas sungai, selokan, kolam dan ke atas segala kumpulan air yang ada pada mereka, supaya semuanya menjadi darah, dan akan ada darah di seluruh tanah Mesir, bahkan dalam wadah kayu dan wadah batu.\""
 },
 {
   "id": 1707,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 20,
   "firman": "Demikianlah Musa dan Harun berbuat seperti yang difirmankan TUHAN; diangkatnya tongkat itu dan dipukulkannya kepada air yang di sungai Nil, di depan mata Firaun dan pegawai-pegawainya, maka seluruh air yang di sungai Nil berubah menjadi darah;"
 },
 {
   "id": 1708,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 21,
   "firman": "matilah ikan di sungai Nil, sehingga sungai Nil itu berbau busuk dan orang Mesir tidak dapat meminum air dari sungai Nil; dan di seluruh tanah Mesir ada darah."
 },
 {
   "id": 1709,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 22,
   "firman": "Tetapi para ahli Mesir membuat yang demikian juga dengan ilmu-ilmu mantera mereka, sehingga hati Firaun berkeras dan ia tidak mau mendengarkan mereka keduanya seperti yang telah difirmankan TUHAN."
 },
 {
   "id": 1710,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 23,
   "firman": "Firaun berpaling, lalu masuk ke istananya dan tidak mau memperhatikan hal itu juga."
 },
 {
   "id": 1711,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 24,
   "firman": "Tetapi semua orang Mesir menggali-gali di sekitar sungai Nil mencari air untuk diminum, sebab mereka tidak dapat meminum air sungai Nil."
 },
 {
   "id": 1712,
   "kitab": "Kel",
   "pasal": 7,
   "ayat": 25,
   "firman": "Demikianlah genap tujuh hari berlalu setelah TUHAN menulahi sungai Nil."
 },
 {
   "id": 1713,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah menghadap Firaun dan katakan kepadanya: Beginilah firman TUHAN: Biarkanlah umat-Ku pergi, supaya mereka beribadah kepada-Ku;"
 },
 {
   "id": 1714,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 2,
   "firman": "jika engkau menolak membiarkannya pergi, maka Aku akan menulahi seluruh daerahmu dengan katak."
 },
 {
   "id": 1715,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 3,
   "firman": "Katak-katak akan mengeriap dalam sungai Nil, lalu naik dan masuk ke dalam istanamu dan kamar tidurmu, ya sampai ke dalam tempat tidurmu, ke dalam rumah pegawai-pegawaimu, dan rakyatmu, bahkan ke dalam pembakaran rotimu serta ke dalam tempat adonanmu."
 },
 {
   "id": 1716,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 4,
   "firman": "Katak-katak itu akan naik memanjati engkau, memanjati rakyatmu dan segala pegawaimu.\""
 },
 {
   "id": 1717,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 5,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Katakanlah kepada Harun: Ulurkanlah tanganmu dengan tongkatmu ke atas sungai, ke atas selokan dan ke atas kolam, dan buatlah katak-katak bermunculan meliputi tanah Mesir.\""
 },
 {
   "id": 1718,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 6,
   "firman": "Lalu Harun mengulurkan tangannya ke atas segala air di Mesir, maka bermunculanlah katak-katak, lalu menutupi tanah Mesir."
 },
 {
   "id": 1719,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 7,
   "firman": "Tetapi para ahli itupun membuat yang demikian juga dengan ilmu-ilmu mantera mereka, sehingga mereka membuat katak-katak bermunculan meliputi tanah Mesir."
 },
 {
   "id": 1720,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 8,
   "firman": "Kemudian Firaun memanggil Musa dan Harun serta berkata: \"Berdoalah kepada TUHAN, supaya dijauhkan-Nya katak-katak itu dari padaku dan dari pada rakyatku; maka aku akan membiarkan bangsa itu pergi, supaya mereka mempersembahkan korban kepada TUHAN.\""
 },
 {
   "id": 1721,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 9,
   "firman": "Kata Musa kepada Firaun: \"Silakanlah tuanku katakan kepadaku, bila aku akan berdoa untukmu, untuk pegawaimu dan rakyatmu, supaya katak-katak itu dilenyapkan dari padamu dan dari rumah-rumahmu, dan hanya tinggal di sungai Nil saja.\""
 },
 {
   "id": 1722,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 10,
   "firman": "Katanya: \"Besok.\" Lalu kata Musa: \"Jadilah seperti katamu itu, supaya tuanku mengetahui, bahwa tidak ada yang seperti TUHAN, Allah kami."
 },
 {
   "id": 1723,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 11,
   "firman": "Maka katak-katak itu akan dijauhkan dari padamu, dari rumah-rumahmu, dari pegawai-pegawaimu dan dari rakyatmu; dan hanya akan tinggal di sungai Nil saja.\""
 },
 {
   "id": 1724,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 12,
   "firman": "Lalu Musa dan Harun keluar meninggalkan Firaun, dan Musa berseru kepada TUHAN karena katak-katak, yang didatangkan-Nya kepada Firaun."
 },
 {
   "id": 1725,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 13,
   "firman": "Dan TUHAN melakukan seperti yang dikatakan Musa, sehingga katak-katak itu mati lenyap dari rumah, dari halaman dan dari ladang."
 },
 {
   "id": 1726,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 14,
   "firman": "Dikumpulkan oranglah bangkai-bangkainya bertumpuk-tumpuk, sehingga tanah itu berbau busuk."
 },
 {
   "id": 1727,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 15,
   "firman": "Tetapi ketika Firaun melihat, bahwa telah terasa kelegaan, ia tetap berkeras hati, dan tidak mau mendengarkan mereka keduanya--seperti yang telah difirmankan TUHAN."
 },
 {
   "id": 1728,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 16,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Katakanlah kepada Harun: Ulurkanlah tongkatmu dan pukulkanlah itu ke debu tanah, maka debu itu akan menjadi nyamuk di seluruh tanah Mesir.\""
 },
 {
   "id": 1729,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 17,
   "firman": "Lalu mereka berbuat demikian; Harun mengulurkan tangannya dengan tongkatnya dan memukulkannya ke debu tanah, maka nyamuk-nyamuk itu hinggap pada manusia dan pada binatang. Segala debu tanah menjadi nyamuk di seluruh tanah Mesir."
 },
 {
   "id": 1730,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 18,
   "firman": "Para ahli itupun membuat yang demikian juga dengan ilmu-ilmu manteranya untuk mengadakan nyamuk-nyamuk, tetapi mereka tidak dapat. Demikianlah nyamuk-nyamuk itu hinggap pada manusia dan pada binatang."
 },
 {
   "id": 1731,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 19,
   "firman": "Lalu berkatalah para ahli itu kepada Firaun: \"Inilah tangan Allah.\" Tetapi hati Firaun berkeras, dan ia tidak mau mendengarkan mereka--seperti yang telah difirmankan TUHAN."
 },
 {
   "id": 1732,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 20,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Bangunlah pagi-pagi dan berdirilah menantikan Firaun, pada waktu biasanya ia keluar ke sungai, dan katakanlah kepadanya: Beginilah firman TUHAN: Biarkanlah umat-Ku pergi, supaya mereka beribadah kepada-Ku;"
 },
 {
   "id": 1733,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 21,
   "firman": "sebab jika engkau tidak membiarkan umat-Ku itu pergi, maka Aku akan melepaskan pikat terhadap engkau, terhadap pegawai-pegawaimu, rakyatmu dan rumah-rumahmu, sehingga rumah-rumah orang Mesir, bahkan tanah, di mana mereka berdiri akan penuh dengan pikat."
 },
 {
   "id": 1734,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 22,
   "firman": "Tetapi pada hari itu Aku akan mengecualikan tanah Gosyen, di mana umat-Ku tinggal, sehingga di sana tidak ada terdapat pikat, supaya engkau mengetahui, bahwa Aku, TUHAN, ada di negeri ini."
 },
 {
   "id": 1735,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 23,
   "firman": "Sebab Aku akan mengadakan perbedaan antara umat-Ku dan bangsamu. Besok tanda mujizat ini akan terjadi.\""
 },
 {
   "id": 1736,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 24,
   "firman": "TUHAN berbuat demikian; maka datanglah banyak-banyak pikat ke dalam istana Firaun dan ke dalam rumah pegawai-pegawainya dan ke seluruh tanah Mesir; negeri itu menderita karena pikat itu."
 },
 {
   "id": 1737,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 25,
   "firman": "Lalu Firaun memanggil Musa dan Harun serta berkata: \"Pergilah, persembahkanlah korban kepada Allahmu di negeri ini.\""
 },
 {
   "id": 1738,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 26,
   "firman": "Tetapi Musa berkata: \"Tidak mungkin kami berbuat demikian, sebab korban yang akan kami persembahkan kepada TUHAN, Allah kami, adalah kekejian bagi orang Mesir. Apabila kami mempersembahkan korban yang menjadi kekejian bagi orang Mesir itu, di depan mata mereka, tidakkah mereka akan melempari kami dengan batu?"
 },
 {
   "id": 1739,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 27,
   "firman": "Kami harus pergi ke padang gurun tiga hari perjalanan jauhnya untuk mempersembahkan korban kepada TUHAN, Allah kami, seperti yang difirmankan-Nya kepada kami.\""
 },
 {
   "id": 1740,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 28,
   "firman": "Lalu kata Firaun: \"Baik, aku akan membiarkan kamu pergi untuk mempersembahkan korban kepada TUHAN, Allahmu, di padang gurun; hanya janganlah kamu pergi terlalu jauh. Berdoalah untuk aku.\""
 },
 {
   "id": 1741,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 29,
   "firman": "Lalu kata Musa: \"Sekarang aku keluar meninggalkan tuanku dan akan berdoa kepada TUHAN, maka pikat itu akan dijauhkan besok dari Firaun, dari pegawai-pegawainya dan rakyatnya; hanya janganlah Firaun berlaku curang lagi dengan tidak membiarkan bangsa itu pergi untuk mempersembahkan korban kepada TUHAN.\""
 },
 {
   "id": 1742,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 30,
   "firman": "Sesudah itu keluarlah Musa meninggalkan Firaun, lalu berdoa kepada TUHAN."
 },
 {
   "id": 1743,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 31,
   "firman": "Dan TUHAN membuat seperti yang dikatakan Musa: pikat itu dijauhkan-Nya dari Firaun, dari pegawai-pegawainya dan rakyatnya; seekorpun tidak ada yang tinggal."
 },
 {
   "id": 1744,
   "kitab": "Kel",
   "pasal": 8,
   "ayat": 32,
   "firman": "Tetapi sekali inipun Firaun tetap berkeras hati; ia tidak membiarkan bangsa itu pergi."
 },
 {
   "id": 1745,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah menghadap Firaun dan berbicaralah kepadanya: Beginilah firman TUHAN, Allah orang Ibrani: Biarkanlah umat-Ku pergi, supaya mereka beribadah kepada-Ku."
 },
 {
   "id": 1746,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 2,
   "firman": "Sebab jika engkau menolak membiarkan mereka pergi dan masih menahan mereka,"
 },
 {
   "id": 1747,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 3,
   "firman": "maka ternakmu, yang ada di padang, kuda, keledai, unta, lembu sapi dan kambing domba, akan kena tulah TUHAN, yakni kena penyakit sampar yang dahsyat."
 },
 {
   "id": 1748,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 4,
   "firman": "Dan TUHAN akan membuat perbedaan antara ternak orang Israel dan ternak orang Mesir, sehingga tidak ada yang akan mati seekorpun dari segala ternak orang Israel.\""
 },
 {
   "id": 1749,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 5,
   "firman": "Selanjutnya TUHAN menentukan waktunya, firman-Nya: \"Besoklah TUHAN akan melakukan hal itu di negeri ini.\""
 },
 {
   "id": 1750,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 6,
   "firman": "Dan TUHAN melakukan hal itu keesokan harinya; segala ternak orang Mesir itu mati, tetapi dari ternak orang Israel tidak ada seekorpun yang mati."
 },
 {
   "id": 1751,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 7,
   "firman": "Lalu Firaun menyuruh orang ke sana dan sesungguhnyalah dari ternak orang Israel tidak ada seekorpun yang mati. Tetapi Firaun tetap berkeras hati dan tidak mau membiarkan bangsa itu pergi."
 },
 {
   "id": 1752,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 8,
   "firman": "Berfirmanlah TUHAN kepada Musa dan Harun: \"Ambillah jelaga dari dapur peleburan serangkup penuh, dan Musa harus menghamburkannya ke udara di depan mata Firaun."
 },
 {
   "id": 1753,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 9,
   "firman": "Maka jelaga itu akan menjadi debu meliputi seluruh tanah Mesir, dan akan menjadikan barah yang memecah sebagai gelembung, pada manusia dan binatang di seluruh tanah Mesir.\""
 },
 {
   "id": 1754,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 10,
   "firman": "Lalu mereka mengambil jelaga dari dapur peleburan, dan berdiri di depan Firaun, kemudian Musa menghamburkannya ke udara, maka terjadilah barah, yang memecah sebagai gelembung pada manusia dan binatang,"
 },
 {
   "id": 1755,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 11,
   "firman": "sehingga ahli-ahli itu tidak dapat tetap berdiri di depan Musa, karena barah-barah itu; sebab ahli-ahli itupun juga kena barah sama seperti semua orang Mesir."
 },
 {
   "id": 1756,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 12,
   "firman": "Tetapi TUHAN mengeraskan hati Firaun, sehingga ia tidak mendengarkan mereka--seperti yang telah difirmankan TUHAN kepada Musa."
 },
 {
   "id": 1757,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 13,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Bangunlah pagi-pagi dan berdirilah menantikan Firaun dan katakan kepadanya: Beginilah firman TUHAN, Allah orang Ibrani: Biarkanlah umat-Ku pergi, supaya mereka beribadah kepada-Ku."
 },
 {
   "id": 1758,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 14,
   "firman": "Sebab sekali ini Aku akan melepaskan segala tulah-Ku terhadap engkau sendiri, terhadap pegawai-pegawaimu dan terhadap rakyatmu, dengan maksud supaya engkau mengetahui, bahwa tidak ada yang seperti Aku di seluruh bumi."
 },
 {
   "id": 1759,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 15,
   "firman": "Bukankah sudah lama Aku dapat mengacungkan tangan-Ku untuk membunuh engkau dan rakyatmu dengan penyakit sampar, sehingga engkau terhapus dari atas bumi;"
 },
 {
   "id": 1760,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 16,
   "firman": "akan tetapi inilah sebabnya Aku membiarkan engkau hidup, yakni supaya memperlihatkan kepadamu kekuatan-Ku, dan supaya nama-Ku dimasyhurkan di seluruh bumi."
 },
 {
   "id": 1761,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 17,
   "firman": "Engkau masih selalu mengalangi umat-Ku, sehingga engkau tidak membiarkan mereka pergi."
 },
 {
   "id": 1762,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 18,
   "firman": "Sesungguhnya besok kira-kira waktu ini Aku akan menurunkan hujan es yang sangat dahsyat, seperti yang belum pernah terjadi di Mesir sejak Mesir dijadikan sampai sekarang ini."
 },
 {
   "id": 1763,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 19,
   "firman": "Oleh sebab itu, ternakmu dan segala yang kaupunyai di padang, suruhlah dibawa ke tempat yang aman; semua orang dan segala hewan, yang ada di padang dan tidak pulang berkumpul ke rumah, akan ditimpa oleh hujan es itu, sehingga mati.\""
 },
 {
   "id": 1764,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 20,
   "firman": "Maka siapa di antara para pegawai Firaun yang takut kepada firman TUHAN, menyuruh hamba-hambanya serta ternaknya lari ke rumah,"
 },
 {
   "id": 1765,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 21,
   "firman": "tetapi siapa yang tidak mengindahkan firman TUHAN, meninggalkan hamba-hambanya serta ternaknya di padang."
 },
 {
   "id": 1766,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 22,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Ulurkanlah tanganmu ke langit, supaya hujan es turun di seluruh tanah Mesir, menimpa manusia dan binatang dan menimpa tumbuh-tumbuhan di padang di tanah Mesir.\""
 },
 {
   "id": 1767,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 23,
   "firman": "Lalu Musa mengulurkan tongkatnya ke langit, maka TUHAN mengadakan guruh dan hujan es, dan apipun menyambar ke bumi, dan TUHAN menurunkan hujan es meliputi tanah Mesir."
 },
 {
   "id": 1768,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 24,
   "firman": "Dan turunlah hujan es, beserta api yang berkilat-kilat di tengah-tengah hujan es itu, terlalu dahsyat, seperti yang belum pernah terjadi di seluruh negeri orang Mesir, sejak mereka menjadi suatu bangsa."
 },
 {
   "id": 1769,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 25,
   "firman": "Hujan es itu menimpa binasa segala sesuatu yang ada di padang, di seluruh tanah Mesir, dari manusia sampai binatang; juga segala tumbuh-tumbuhan di padang ditimpa binasa oleh hujan itu dan segala pohon di padang ditumbangkannya."
 },
 {
   "id": 1770,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 26,
   "firman": "Hanya di tanah Gosyen, tempat kediaman orang Israel, tidak ada turun hujan es."
 },
 {
   "id": 1771,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 27,
   "firman": "Lalu Firaun menyuruh memanggil Musa dan Harun serta berkata kepada mereka: \"Aku telah berdosa sekali ini, TUHAN itu yang benar, tetapi aku dan rakyatkulah yang bersalah."
 },
 {
   "id": 1772,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 28,
   "firman": "Berdoalah kepada TUHAN; guruh yang sangat dahsyat dan hujan es itu sudah cukup. Maka aku akan membiarkan kamu pergi, tidak usah kamu tinggal lebih lama lagi.\""
 },
 {
   "id": 1773,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 29,
   "firman": "Dan berkatalah Musa kepadanya: \"Sekeluar aku dari kota ini, aku akan mengembangkan tanganku kepada TUHAN; guruh akan berhenti dan hujan es tidak akan turun lagi, supaya engkau mengetahui, bahwa bumi adalah milik TUHAN."
 },
 {
   "id": 1774,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 30,
   "firman": "Tetapi tentang engkau dan para pegawaimu, aku tahu, bahwa kamu belum takut kepada TUHAN Allah.\""
 },
 {
   "id": 1775,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 31,
   "firman": "--Tanaman rami dan jelai telah tertimpa binasa, sebab jelai itu sedang berbulir dan rami itu sedang berbunga."
 },
 {
   "id": 1776,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 32,
   "firman": "Tetapi gandum dan sekoi tidak tertimpa binasa, sebab belum lagi musimnya. --"
 },
 {
   "id": 1777,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 33,
   "firman": "Lalu keluarlah Musa dari kota itu meninggalkan Firaun, dikembangkannyalah tangannya kepada TUHAN, maka berhentilah guruh dan hujan es dan hujan tidak tercurah lagi ke bumi."
 },
 {
   "id": 1778,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 34,
   "firman": "Tetapi ketika Firaun melihat, bahwa hujan, hujan es dan guruh telah berhenti, maka teruslah ia berbuat dosa; ia tetap berkeras hati, baik ia maupun para pegawainya."
 },
 {
   "id": 1779,
   "kitab": "Kel",
   "pasal": 9,
   "ayat": 35,
   "firman": "Berkeraslah hati Firaun, sehingga ia tidak membiarkan orang Israel pergi--seperti yang telah difirmankan TUHAN dengan perantaraan Musa."
 },
 {
   "id": 1780,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah menghadap Firaun, sebab Aku telah membuat hatinya dan hati para pegawainya berkeras, supaya Aku mengadakan tanda-tanda mujizat yang Kubuat ini di antara mereka,"
 },
 {
   "id": 1781,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 2,
   "firman": "dan supaya engkau dapat menceriterakan kepada anak cucumu, bagaimana Aku mempermain-mainkan orang Mesir dan tanda-tanda mujizat mana yang telah Kulakukan di antara mereka, supaya kamu mengetahui, bahwa Akulah TUHAN.\""
 },
 {
   "id": 1782,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 3,
   "firman": "Lalu Musa dan Harun pergi menghadap Firaun dan berkata kepadanya: \"Beginilah firman TUHAN, Allah orang Ibrani: Berapa lama lagi engkau menolak untuk merendahkan dirimu di hadapan-Ku? Biarkanlah umat-Ku pergi supaya mereka beribadah kepada-Ku."
 },
 {
   "id": 1783,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 4,
   "firman": "Sebab jika engkau menolak membiarkan umat-Ku pergi, maka besok Aku akan mendatangkan belalang-belalang ke dalam daerahmu;"
 },
 {
   "id": 1784,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 5,
   "firman": "belalang itu akan menutupi permukaan bumi, sehingga orang tidak dapat melihat tanah; belalang itu akan memakan habis sisa yang terluput, yang masih tinggal bagimu dari hujan es itu, bahkan akan memakan habis segala pohonmu yang tumbuh di padang."
 },
 {
   "id": 1785,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 6,
   "firman": "Belalang itu akan memenuhi rumahmu, rumah semua pegawaimu, rumah semua orang Mesir seperti yang belum pernah dilihat oleh bapamu dan nenek moyangmu, sejak mereka lahir ke bumi sampai hari ini.\" Lalu berpalinglah ia dan keluar meninggalkan Firaun."
 },
 {
   "id": 1786,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 7,
   "firman": "Sesudah itu berkatalah para pegawai Firaun kepadanya: \"Berapa lama lagi orang ini akan menjadi jerat kepada kita? Biarkanlah orang-orang itu pergi supaya mereka beribadah kepada TUHAN, Allah mereka. Belumkah tuanku insaf, bahwa Mesir pasti akan binasa?\""
 },
 {
   "id": 1787,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 8,
   "firman": "Lalu Musa dan Harun dibawalah kembali kepada Firaun dan berkatalah Firaun kepada mereka: \"Pergilah, beribadahlah kepada TUHAN, Allahmu. Siapa-siapa sebenarnya yang akan pergi itu?\""
 },
 {
   "id": 1788,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 9,
   "firman": "Jawab Musa: \"Kami hendak pergi dengan orang-orang yang muda dan yang tua; dengan anak-anak lelaki kami dan perempuan, dengan kambing domba kami dan lembu sapi kami, sebab kami harus mengadakan perayaan untuk TUHAN.\""
 },
 {
   "id": 1789,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 10,
   "firman": "Tetapi Firaun berkata kepada mereka: \"TUHAN boleh menyertai kamu, jika aku membiarkan kamu pergi dengan anak-anakmu! Lihat, jahatlah maksudmu!"
 },
 {
   "id": 1790,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 11,
   "firman": "Bukan demikian, kamu boleh pergi, tetapi hanya laki-laki, dan beribadahlah kepada TUHAN, sebab itulah yang kamu kehendaki.\" Lalu mereka diusir dari depan Firaun."
 },
 {
   "id": 1791,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 12,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Ulurkanlah tanganmu ke atas tanah Mesir mendatangkan belalang dan belalang akan datang meliputi tanah Mesir dan memakan habis segala tumbuh-tumbuhan di tanah, semuanya yang ditinggalkan oleh hujan es itu.\""
 },
 {
   "id": 1792,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 13,
   "firman": "Lalu Musa mengulurkan tongkatnya ke atas tanah Mesir, dan TUHAN mendatangkan angin timur melintasi negeri itu, sehari-harian dan semalam-malaman, dan setelah hari pagi, angin timur membawa belalang."
 },
 {
   "id": 1793,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 14,
   "firman": "Datanglah belalang meliputi seluruh tanah Mesir dan hinggap di seluruh daerah Mesir, sangat banyak; sebelum itu tidak pernah ada belalang yang demikian banyaknya dan sesudah itupun tidak akan terjadi lagi yang demikian."
 },
 {
   "id": 1794,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 15,
   "firman": "Belalang menutupi seluruh permukaan bumi, sehingga negeri itu menjadi gelap olehnya; belalang memakan habis segala tumbuh-tumbuhan di tanah dan segala buah-buahan pada pohon-pohon yang ditinggalkan oleh hujan es itu, sehingga tidak ada tinggal lagi yang hijau pada pohon atau tumbuh-tumbuhan di padang di seluruh tanah Mesir."
 },
 {
   "id": 1795,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 16,
   "firman": "Maka segeralah Firaun memanggil Musa dan Harun serta berkata: \"Aku telah berbuat dosa terhadap TUHAN, Allahmu, dan terhadap kamu."
 },
 {
   "id": 1796,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 17,
   "firman": "Oleh sebab itu, ampunilah kiranya dosaku untuk sekali ini saja dan berdoalah kepada TUHAN, Allahmu itu, supaya bahaya maut ini dijauhkan-Nya dari padaku.\""
 },
 {
   "id": 1797,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lalu keluarlah Musa meninggalkan Firaun dan berdoa kepada TUHAN."
 },
 {
   "id": 1798,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 19,
   "firman": "Maka TUHAN membuat angin bertiup dari jurusan sebaliknya, yakni angin barat yang sangat kencang, yang membawa belalang itu dan melemparkannya ke dalam Laut Teberau: tidak ada satu belalangpun yang tinggal di seluruh daerah Mesir."
 },
 {
   "id": 1799,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 20,
   "firman": "Tetapi TUHAN mengeraskan hati Firaun, sehingga tidak mau membiarkan orang Israel pergi."
 },
 {
   "id": 1800,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 21,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Ulurkanlah tanganmu ke langit, supaya datang gelap meliputi tanah Mesir, sehingga orang dapat meraba gelap itu.\""
 },
 {
   "id": 1801,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 22,
   "firman": "Lalu Musa mengulurkan tangannya ke langit dan datanglah gelap gulita di seluruh tanah Mesir selama tiga hari."
 },
 {
   "id": 1802,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 23,
   "firman": "Tidak ada orang yang dapat melihat temannya, juga tidak ada orang yang dapat bangun dari tempatnya selama tiga hari; tetapi pada semua orang Israel ada terang di tempat kediamannya."
 },
 {
   "id": 1803,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 24,
   "firman": "Lalu Firaun memanggil Musa serta berkata: \"Pergilah, beribadahlah kepada TUHAN, hanya kambing dombamu dan lembu sapimu harus ditinggalkan, juga anak-anakmu boleh turut beserta kamu.\""
 },
 {
   "id": 1804,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 25,
   "firman": "Tetapi Musa berkata: \"Bahkan korban sembelihan dan korban bakaran harus engkau berikan kepada kami, supaya kami menyediakannya untuk TUHAN, Allah kami."
 },
 {
   "id": 1805,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 26,
   "firman": "Dan juga ternak kami harus turut beserta kami dan satu kakipun tidak akan tinggal, sebab dari ternak itulah kami harus ambil untuk beribadah kepada TUHAN, Allah kami; dan kami tidak tahu, dengan apa kami harus beribadah kepada TUHAN, sebelum kami sampai di sana.\""
 },
 {
   "id": 1806,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 27,
   "firman": "Tetapi TUHAN mengeraskan hati Firaun, sehingga dia tidak mau membiarkan mereka pergi."
 },
 {
   "id": 1807,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 28,
   "firman": "Lalu Firaun berkata kepadanya: \"Pergilah dari padaku; awaslah engkau, jangan lihat mukaku lagi, sebab pada waktu engkau melihat mukaku, engkau akan mati.\""
 },
 {
   "id": 1808,
   "kitab": "Kel",
   "pasal": 10,
   "ayat": 29,
   "firman": "Kemudian Musa berkata: \"Tepat seperti ucapanmu itu! Aku takkan melihat mukamu lagi!\""
 },
 {
   "id": 1809,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Aku akan mendatangkan satu tulah lagi atas Firaun dan atas Mesir, sesudah itu ia akan membiarkan kamu pergi dari sini; apabila ia membiarkan kamu pergi, ia akan benar-benar mengusir kamu dari sini."
 },
 {
   "id": 1810,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 2,
   "firman": "Baiklah katakan kepada bangsa itu, supaya setiap laki-laki meminta barang-barang emas dan perak kepada tetangganya dan setiap perempuan kepada tetangganya pula.\""
 },
 {
   "id": 1811,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 3,
   "firman": "Lalu TUHAN membuat orang Mesir bermurah hati terhadap bangsa itu; lagipula Musa adalah seorang yang sangat terpandang di tanah Mesir, di mata pegawai-pegawai Firaun dan di mata rakyat."
 },
 {
   "id": 1812,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 4,
   "firman": "Berkatalah Musa: \"Beginilah firman TUHAN: Pada waktu tengah malam Aku akan berjalan dari tengah-tengah Mesir."
 },
 {
   "id": 1813,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 5,
   "firman": "Maka tiap-tiap anak sulung di tanah Mesir akan mati, dari anak sulung Firaun yang duduk di takhtanya sampai kepada anak sulung budak perempuan yang menghadapi batu kilangan, juga segala anak sulung hewan."
 },
 {
   "id": 1814,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 6,
   "firman": "Dan seruan yang hebat akan terjadi di seluruh tanah Mesir, seperti yang belum pernah terjadi dan seperti yang tidak akan ada lagi."
 },
 {
   "id": 1815,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 7,
   "firman": "Tetapi kepada siapa juga dari orang Israel, seekor anjingpun tidak akan berani menggonggong, baik kepada manusia maupun kepada binatang, supaya kamu mengetahui, bahwa TUHAN membuat perbedaan antara orang Mesir dan orang Israel."
 },
 {
   "id": 1816,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 8,
   "firman": "Dan semua pegawaimu ini akan datang kepadaku dan sujud kepadaku serta berkata: Keluarlah, engkau dan seluruh rakyat yang mengikut engkau; sesudah itu aku akan keluar.\" Lalu Musa meninggalkan Firaun dengan marah yang bernyala-nyala."
 },
 {
   "id": 1817,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 9,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Firaun tidak akan mendengarkan kamu, supaya mujizat-mujizat yang Kubuat bertambah banyak di tanah Mesir.\""
 },
 {
   "id": 1818,
   "kitab": "Kel",
   "pasal": 11,
   "ayat": 10,
   "firman": "Musa dan Harun telah melakukan segala mujizat ini di depan Firaun. Tetapi TUHAN mengeraskan hati Firaun, sehingga tidak membiarkan orang Israel pergi dari negerinya."
 },
 {
   "id": 1819,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa dan Harun di tanah Mesir:"
 },
 {
   "id": 1820,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 2,
   "firman": "\"Bulan inilah akan menjadi permulaan segala bulan bagimu; itu akan menjadi bulan pertama bagimu tiap-tiap tahun."
 },
 {
   "id": 1821,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 3,
   "firman": "Katakanlah kepada segenap jemaah Israel: Pada tanggal sepuluh bulan ini diambillah oleh masing-masing seekor anak domba, menurut kaum keluarga, seekor anak domba untuk tiap-tiap rumah tangga."
 },
 {
   "id": 1822,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 4,
   "firman": "Tetapi jika rumah tangga itu terlalu kecil jumlahnya untuk mengambil seekor anak domba, maka ia bersama-sama dengan tetangganya yang terdekat ke rumahnya haruslah mengambil seekor, menurut jumlah jiwa; tentang anak domba itu, kamu buatlah perkiraan menurut keperluan tiap-tiap orang."
 },
 {
   "id": 1823,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 5,
   "firman": "Anak dombamu itu harus jantan, tidak bercela, berumur setahun; kamu boleh ambil domba atau kambing."
 },
 {
   "id": 1824,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 6,
   "firman": "Kamu harus mengurungnya sampai hari yang keempat belas bulan ini; lalu seluruh jemaah Israel yang berkumpul, harus menyembelihnya pada waktu senja."
 },
 {
   "id": 1825,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 7,
   "firman": "Kemudian dari darahnya haruslah diambil sedikit dan dibubuhkan pada kedua tiang pintu dan pada ambang atas, pada rumah-rumah di mana orang memakannya."
 },
 {
   "id": 1826,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 8,
   "firman": "Dagingnya harus dimakan mereka pada malam itu juga; yang dipanggang mereka harus makan dengan roti yang tidak beragi beserta sayur pahit."
 },
 {
   "id": 1827,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 9,
   "firman": "Janganlah kamu memakannya mentah atau direbus dalam air; hanya dipanggang di api, lengkap dengan kepalanya dan betisnya dan isi perutnya."
 },
 {
   "id": 1828,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 10,
   "firman": "Janganlah kamu tinggalkan apa-apa dari daging itu sampai pagi; apa yang tinggal sampai pagi kamu bakarlah habis dengan api."
 },
 {
   "id": 1829,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 11,
   "firman": "Dan beginilah kamu memakannya: pinggangmu berikat, kasut pada kakimu dan tongkat di tanganmu; buru-burulah kamu memakannya; itulah Paskah bagi TUHAN."
 },
 {
   "id": 1830,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 12,
   "firman": "Sebab pada malam ini Aku akan menjalani tanah Mesir, dan semua anak sulung, dari anak manusia sampai anak binatang, akan Kubunuh, dan kepada semua allah di Mesir akan Kujatuhkan hukuman, Akulah, TUHAN."
 },
 {
   "id": 1831,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 13,
   "firman": "Dan darah itu menjadi tanda bagimu pada rumah-rumah di mana kamu tinggal: Apabila Aku melihat darah itu, maka Aku akan lewat dari pada kamu. Jadi tidak akan ada tulah kemusnahan di tengah-tengah kamu, apabila Aku menghukum tanah Mesir."
 },
 {
   "id": 1832,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 14,
   "firman": "Hari ini akan menjadi hari peringatan bagimu. Kamu harus merayakannya sebagai hari raya bagi TUHAN turun-temurun. Kamu harus merayakannya sebagai ketetapan untuk selamanya."
 },
 {
   "id": 1833,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 15,
   "firman": "Kamu makanlah roti yang tidak beragi tujuh hari lamanya; pada hari pertamapun kamu buanglah segala ragi dari rumahmu, sebab setiap orang yang makan sesuatu yang beragi, dari hari pertama sampai hari ketujuh, orang itu harus dilenyapkan dari antara Israel."
 },
 {
   "id": 1834,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 16,
   "firman": "Kamu adakanlah pertemuan yang kudus, baik pada hari yang pertama maupun pada hari yang ketujuh; pada hari-hari itu tidak boleh dilakukan pekerjaan apapun; hanya apa yang perlu dimakan setiap orang, itu sajalah yang boleh kamu sediakan."
 },
 {
   "id": 1835,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 17,
   "firman": "Jadi kamu harus tetap merayakan hari raya makan roti yang tidak beragi, sebab tepat pada hari ini juga Aku membawa pasukan-pasukanmu keluar dari tanah Mesir. Maka haruslah kamu rayakan hari ini turun-temurun; itulah suatu ketetapan untuk selamanya."
 },
 {
   "id": 1836,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 18,
   "firman": "Dalam bulan pertama, pada hari yang keempat belas bulan itu pada waktu petang, kamu makanlah roti yang tidak beragi, sampai kepada hari yang kedua puluh satu bulan itu, pada waktu petang."
 },
 {
   "id": 1837,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 19,
   "firman": "Tujuh hari lamanya tidak boleh ada ragi dalam rumahmu, sebab setiap orang yang makan sesuatu yang beragi, orang itu harus dilenyapkan dari antara jemaah Israel, baik ia orang asing, baik ia orang asli."
 },
 {
   "id": 1838,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 20,
   "firman": "Sesuatu apapun yang beragi tidak boleh kamu makan; kamu makanlah roti yang tidak beragi di segala tempat kediamanmu.\""
 },
 {
   "id": 1839,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 21,
   "firman": "Lalu Musa memanggil semua tua-tua Israel serta berkata kepada mereka: \"Pergilah, ambillah kambing domba untuk kaummu dan sembelihlah anak domba Paskah."
 },
 {
   "id": 1840,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 22,
   "firman": "Kemudian kamu harus mengambil seikat hisop dan mencelupkannya dalam darah yang ada dalam sebuah pasu, dan darah itu kamu harus sapukan pada ambang atas dan pada kedua tiang pintu; seorangpun dari kamu tidak boleh keluar pintu rumahnya sampai pagi."
 },
 {
   "id": 1841,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 23,
   "firman": "Dan TUHAN akan menjalani Mesir untuk menulahinya; apabila Ia melihat darah pada ambang atas dan pada kedua tiang pintu itu, maka TUHAN akan melewati pintu itu dan tidak membiarkan pemusnah masuk ke dalam rumahmu untuk menulahi."
 },
 {
   "id": 1842,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 24,
   "firman": "Kamu harus memegang ini sebagai ketetapan sampai selama-lamanya bagimu dan bagi anak-anakmu."
 },
 {
   "id": 1843,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 25,
   "firman": "Dan apabila kamu tiba di negeri yang akan diberikan TUHAN kepadamu, seperti yang difirmankan-Nya, maka kamu harus pelihara ibadah ini."
 },
 {
   "id": 1844,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 26,
   "firman": "Dan apabila anak-anakmu berkata kepadamu: Apakah artinya ibadahmu ini?"
 },
 {
   "id": 1845,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 27,
   "firman": "maka haruslah kamu berkata: Itulah korban Paskah bagi TUHAN yang melewati rumah-rumah orang Israel di Mesir, ketika Ia menulahi orang Mesir, tetapi menyelamatkan rumah-rumah kita.\" Lalu berlututlah bangsa itu dan sujud menyembah."
 },
 {
   "id": 1846,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 28,
   "firman": "Pergilah orang Israel, lalu berbuat demikian; seperti yang diperintahkan TUHAN kepada Musa dan Harun, demikianlah diperbuat mereka."
 },
 {
   "id": 1847,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 29,
   "firman": "Maka pada tengah malam TUHAN membunuh tiap-tiap anak sulung di tanah Mesir, dari anak sulung Firaun yang duduk di takhtanya sampai kepada anak sulung orang tawanan, yang ada dalam liang tutupan, beserta segala anak sulung hewan."
 },
 {
   "id": 1848,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 30,
   "firman": "Lalu bangunlah Firaun pada malam itu, bersama semua pegawainya dan semua orang Mesir; dan kedengaranlah seruan yang hebat di Mesir, sebab tidak ada rumah yang tidak kematian."
 },
 {
   "id": 1849,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 31,
   "firman": "Lalu pada malam itu dipanggilnyalah Musa dan Harun, katanya: \"Bangunlah, keluarlah dari tengah-tengah bangsaku, baik kamu maupun orang Israel; pergilah, beribadahlah kepada TUHAN, seperti katamu itu."
 },
 {
   "id": 1850,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 32,
   "firman": "Bawalah juga kambing dombamu dan lembu sapimu, seperti katamu itu, tetapi pergilah! Dan pohonkanlah juga berkat bagiku.\""
 },
 {
   "id": 1851,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 33,
   "firman": "Orang Mesir juga mendesak dengan keras kepada bangsa itu, menyuruh bangsa itu pergi dengan segera dari negeri itu, sebab kata mereka: \"Nanti kami mati semuanya.\""
 },
 {
   "id": 1852,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 34,
   "firman": "Lalu bangsa itu mengangkat adonannya, sebelum diragi, dengan tempat adonan mereka terbungkus dalam kainnya di atas bahunya."
 },
 {
   "id": 1853,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 35,
   "firman": "Orang Israel melakukan juga seperti kata Musa; mereka meminta dari orang Mesir barang-barang emas dan perak serta kain-kain."
 },
 {
   "id": 1854,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 36,
   "firman": "Dan TUHAN membuat orang Mesir bermurah hati terhadap bangsa itu, sehingga memenuhi permintaan mereka. Demikianlah mereka merampasi orang Mesir itu."
 },
 {
   "id": 1855,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 37,
   "firman": "Kemudian berangkatlah orang Israel dari Raamses ke Sukot, kira-kira enam ratus ribu orang laki-laki berjalan kaki, tidak termasuk anak-anak."
 },
 {
   "id": 1856,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 38,
   "firman": "Juga banyak orang dari berbagai-bagai bangsa turut dengan mereka; lagi sangat banyak ternak kambing domba dan lembu sapi."
 },
 {
   "id": 1857,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 39,
   "firman": "Adonan yang dibawa mereka dari Mesir dibakarlah menjadi roti bundar yang tidak beragi, sebab adonan itu tidak diragi, karena mereka diusir dari Mesir dan tidak dapat berlambat-lambat, dan mereka tidak pula menyediakan bekal baginya."
 },
 {
   "id": 1858,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 40,
   "firman": "Lamanya orang Israel diam di Mesir adalah empat ratus tiga puluh tahun."
 },
 {
   "id": 1859,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 41,
   "firman": "Sesudah lewat empat ratus tiga puluh tahun, tepat pada hari itu juga, keluarlah segala pasukan TUHAN dari tanah Mesir."
 },
 {
   "id": 1860,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 42,
   "firman": "Malam itulah malam berjaga-jaga bagi TUHAN, untuk membawa mereka keluar dari tanah Mesir. Dan itulah juga malam berjaga-jaga bagi semua orang Israel, turun-temurun, untuk kemuliaan TUHAN."
 },
 {
   "id": 1861,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 43,
   "firman": "Berfirmanlah TUHAN kepada Musa dan Harun: \"Inilah ketetapan mengenai Paskah: Tidak seorangpun dari bangsa asing boleh memakannya."
 },
 {
   "id": 1862,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 44,
   "firman": "Seorang budak belian barulah boleh memakannya, setelah engkau menyunat dia."
 },
 {
   "id": 1863,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 45,
   "firman": "Orang pendatang dan orang upahan tidak boleh memakannya."
 },
 {
   "id": 1864,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 46,
   "firman": "Paskah itu harus dimakan dalam satu rumah juga; tidak boleh kaubawa sedikitpun dari daging itu keluar rumah; satu tulangpun tidak boleh kamu patahkan."
 },
 {
   "id": 1865,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 47,
   "firman": "Segenap jemaah Israel haruslah merayakannya."
 },
 {
   "id": 1866,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 48,
   "firman": "Tetapi apabila seorang asing telah menetap padamu dan mau merayakan Paskah bagi TUHAN, maka setiap laki-laki yang bersama-sama dengan dia, wajiblah disunat; barulah ia boleh mendekat untuk merayakannya; ia akan dianggap sebagai orang asli. Tetapi tidak seorangpun yang tidak bersunat boleh memakannya."
 },
 {
   "id": 1867,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 49,
   "firman": "Satu hukum saja akan berlaku untuk orang asli dan untuk orang asing yang menetap di tengah-tengah kamu.\""
 },
 {
   "id": 1868,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 50,
   "firman": "Seluruh orang Israel berbuat demikian; seperti yang diperintahkan TUHAN kepada Musa dan Harun, demikianlah diperbuat mereka."
 },
 {
   "id": 1869,
   "kitab": "Kel",
   "pasal": 12,
   "ayat": 51,
   "firman": "Dan tepat pada hari itu juga TUHAN membawa orang Israel keluar dari tanah Mesir, menurut pasukan mereka."
 },
 {
   "id": 1870,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 1871,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 2,
   "firman": "\"Kuduskanlah bagi-Ku semua anak sulung, semua yang lahir terdahulu dari kandungan pada orang Israel, baik pada manusia maupun pada hewan; Akulah yang empunya mereka.\""
 },
 {
   "id": 1872,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 3,
   "firman": "Lalu berkatalah Musa kepada bangsa itu: \"Peringatilah hari ini, sebab pada hari ini kamu keluar dari Mesir, dari rumah perbudakan; karena dengan kekuatan tangan-Nya TUHAN telah membawa kamu keluar dari sana. Sebab itu tidak boleh dimakan sesuatupun yang beragi."
 },
 {
   "id": 1873,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 4,
   "firman": "Hari ini kamu keluar, dalam bulan Abib."
 },
 {
   "id": 1874,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 5,
   "firman": "Apabila TUHAN telah membawa engkau ke negeri orang Kanaan, orang Het, orang Amori, orang Hewi dan orang Yebus, negeri yang telah dijanjikan-Nya dengan sumpah kepada nenek moyangmu untuk memberikannya kepadamu, suatu negeri yang berlimpah-limpah susu dan madunya, maka engkau harus melakukan ibadah ini dalam bulan ini juga."
 },
 {
   "id": 1875,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 6,
   "firman": "Makanlah roti yang tidak beragi tujuh hari lamanya dan pada hari yang ketujuh akan diadakan hari raya bagi TUHAN."
 },
 {
   "id": 1876,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 7,
   "firman": "Roti yang tidak beragi haruslah dimakan selama tujuh hari itu; sesuatupun yang beragi tidak boleh dilihat padamu, bahkan ragi tidak boleh dilihat padamu di seluruh daerahmu."
 },
 {
   "id": 1877,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 8,
   "firman": "Pada hari itu harus kauberitahukan kepada anakmu laki-laki: Ibadah ini adalah karena mengingat apa yang dibuat TUHAN kepadaku pada waktu aku keluar dari Mesir."
 },
 {
   "id": 1878,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 9,
   "firman": "Hal itu bagimu harus menjadi tanda pada tanganmu dan menjadi peringatan di dahimu, supaya hukum TUHAN ada di bibirmu; sebab dengan tangan yang kuat TUHAN telah membawa engkau keluar dari Mesir."
 },
 {
   "id": 1879,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 10,
   "firman": "Haruslah kaupegang ketetapan ini pada waktunya yang sudah ditentukan, dari tahun ke tahun."
 },
 {
   "id": 1880,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 11,
   "firman": "Apabila engkau telah dibawa TUHAN ke negeri orang Kanaan, seperti yang telah dijanjikan-Nya dengan sumpah kepadamu dan kepada nenek moyangmu, dan negeri itu telah diberikan-Nya kepadamu,"
 },
 {
   "id": 1881,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 12,
   "firman": "maka haruslah kaupersembahkan bagi TUHAN segala yang lahir terdahulu dari kandungan; juga setiap kali ada hewan yang kaupunyai beranak pertama kali, anak jantan yang sulung adalah bagi TUHAN."
 },
 {
   "id": 1882,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 13,
   "firman": "Tetapi setiap anak keledai yang lahir terdahulu kautebuslah dengan seekor domba; atau, jika engkau tidak menebusnya, engkau harus mematahkan batang lehernya. Tetapi mengenai manusia, setiap anak sulung di antara anak-anakmu lelaki, haruslah kautebus."
 },
 {
   "id": 1883,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 14,
   "firman": "Dan apabila anakmu akan bertanya kepadamu di kemudian hari: Apakah artinya itu? maka haruslah engkau berkata kepadanya: Dengan kekuatan tangan-Nya TUHAN telah membawa kita keluar dari Mesir, dari rumah perbudakan."
 },
 {
   "id": 1884,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 15,
   "firman": "Sebab ketika Firaun dengan tegar menolak untuk membiarkan kita pergi, maka TUHAN membunuh semua anak sulung di tanah Mesir, dari anak sulung manusia sampai anak sulung hewan. Itulah sebabnya maka aku biasa mempersembahkan kepada TUHAN segala binatang jantan yang lahir terdahulu dari kandungan, sedang semua anak sulung di antara anak-anakku lelaki kutebus."
 },
 {
   "id": 1885,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 16,
   "firman": "Hal itu harus menjadi tanda pada tanganmu dan menjadi lambang di dahimu, sebab dengan kekuatan tangan-Nya TUHAN membawa kita keluar dari Mesir.\""
 },
 {
   "id": 1886,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 17,
   "firman": "Setelah Firaun membiarkan bangsa itu pergi, Allah tidak menuntun mereka melalui jalan ke negeri orang Filistin, walaupun jalan ini yang paling dekat; sebab firman Allah: \"Jangan-jangan bangsa itu menyesal, apabila mereka menghadapi peperangan, sehingga mereka kembali ke Mesir.\""
 },
 {
   "id": 1887,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 18,
   "firman": "Tetapi Allah menuntun bangsa itu berputar melalui jalan di padang gurun menuju ke Laut Teberau. Dengan siap sedia berperang berjalanlah orang Israel dari tanah Mesir."
 },
 {
   "id": 1888,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 19,
   "firman": "Musa membawa tulang-tulang Yusuf, sebab tadinya Yusuf telah menyuruh anak-anak Israel bersumpah dengan sungguh-sungguh: \"Allah tentu akan mengindahkan kamu, maka kamu harus membawa tulang-tulangku dari sini.\""
 },
 {
   "id": 1889,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 20,
   "firman": "Demikianlah mereka berangkat dari Sukot dan berkemah di Etam, di tepi padang gurun."
 },
 {
   "id": 1890,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 21,
   "firman": "TUHAN berjalan di depan mereka, pada siang hari dalam tiang awan untuk menuntun mereka di jalan, dan pada waktu malam dalam tiang api untuk menerangi mereka, sehingga mereka dapat berjalan siang dan malam."
 },
 {
   "id": 1891,
   "kitab": "Kel",
   "pasal": 13,
   "ayat": 22,
   "firman": "Dengan tidak beralih tiang awan itu tetap ada pada siang hari dan tiang api pada waktu malam di depan bangsa itu."
 },
 {
   "id": 1892,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa, demikian:"
 },
 {
   "id": 1893,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel, supaya mereka balik kembali dan berkemah di depan Pi-Hahirot, antara Migdol dan laut; tepat di depan Baal-Zefon berkemahlah kamu, di tepi laut."
 },
 {
   "id": 1894,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 3,
   "firman": "Maka Firaun akan berkata tentang orang Israel: Mereka telah sesat di negeri ini, padang gurun telah mengurung mereka."
 },
 {
   "id": 1895,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 4,
   "firman": "Aku akan mengeraskan hati Firaun, sehingga ia mengejar mereka. Dan terhadap Firaun dan seluruh pasukannya Aku akan menyatakan kemuliaan-Ku, sehingga orang Mesir mengetahui, bahwa Akulah TUHAN.\" Lalu mereka berbuat demikian."
 },
 {
   "id": 1896,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 5,
   "firman": "Ketika diberitahukan kepada raja Mesir, bahwa bangsa itu telah lari, maka berubahlah hati Firaun dan pegawai-pegawainya terhadap bangsa itu, dan berkatalah mereka: \"Apakah yang telah kita perbuat ini, bahwa kita membiarkan orang Israel pergi dari perbudakan kita?\""
 },
 {
   "id": 1897,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 6,
   "firman": "Kemudian ia memasang keretanya dan membawa rakyatnya serta."
 },
 {
   "id": 1898,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 7,
   "firman": "Ia membawa enam ratus kereta yang terpilih, ya, segala kereta Mesir, masing-masing lengkap dengan perwiranya."
 },
 {
   "id": 1899,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 8,
   "firman": "Demikianlah TUHAN mengeraskan hati Firaun, raja Mesir itu, sehingga ia mengejar orang Israel. Tetapi orang Israel berjalan terus dipimpin oleh tangan yang dinaikkan."
 },
 {
   "id": 1900,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 9,
   "firman": "Adapun orang Mesir, segala kuda dan kereta Firaun, orang-orang berkuda dan pasukannya, mengejar mereka dan mencapai mereka pada waktu mereka berkemah di tepi laut, dekat Pi-Hahirot di depan Baal-Zefon."
 },
 {
   "id": 1901,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 10,
   "firman": "Ketika Firaun telah dekat, orang Israel menoleh, maka tampaklah orang Mesir bergerak menyusul mereka. Lalu sangat ketakutanlah orang Israel dan mereka berseru-seru kepada TUHAN,"
 },
 {
   "id": 1902,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 11,
   "firman": "dan mereka berkata kepada Musa: \"Apakah karena tidak ada kuburan di Mesir, maka engkau membawa kami untuk mati di padang gurun ini? Apakah yang kauperbuat ini terhadap kami dengan membawa kami keluar dari Mesir?"
 },
 {
   "id": 1903,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 12,
   "firman": "Bukankah ini telah kami katakan kepadamu di Mesir: Janganlah mengganggu kami dan biarlah kami bekerja pada orang Mesir. Sebab lebih baik bagi kami untuk bekerja pada orang Mesir dari pada mati di padang gurun ini.\""
 },
 {
   "id": 1904,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 13,
   "firman": "Tetapi berkatalah Musa kepada bangsa itu: \"Janganlah takut, berdirilah tetap dan lihatlah keselamatan dari TUHAN, yang akan diberikan-Nya hari ini kepadamu; sebab orang Mesir yang kamu lihat hari ini, tidak akan kamu lihat lagi untuk selama-lamanya."
 },
 {
   "id": 1905,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 14,
   "firman": "TUHAN akan berperang untuk kamu, dan kamu akan diam saja.\""
 },
 {
   "id": 1906,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 15,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Mengapakah engkau berseru-seru demikian kepada-Ku? Katakanlah kepada orang Israel, supaya mereka berangkat."
 },
 {
   "id": 1907,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 16,
   "firman": "Dan engkau, angkatlah tongkatmu dan ulurkanlah tanganmu ke atas laut dan belahlah airnya, sehingga orang Israel akan berjalan dari tengah-tengah laut di tempat kering."
 },
 {
   "id": 1908,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 17,
   "firman": "Tetapi sungguh Aku akan mengeraskan hati orang Mesir, sehingga mereka menyusul orang Israel, dan terhadap Firaun dan seluruh pasukannya, keretanya dan orangnya yang berkuda, Aku akan menyatakan kemuliaan-Ku."
 },
 {
   "id": 1909,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 18,
   "firman": "Maka orang Mesir akan mengetahui, bahwa Akulah TUHAN, apabila Aku memperlihatkan kemuliaan-Ku terhadap Firaun, keretanya dan orangnya yang berkuda.\""
 },
 {
   "id": 1910,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 19,
   "firman": "Kemudian bergeraklah Malaikat Allah, yang tadinya berjalan di depan tentara Israel, lalu berjalan di belakang mereka; dan tiang awan itu bergerak dari depan mereka, lalu berdiri di belakang mereka."
 },
 {
   "id": 1911,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 20,
   "firman": "Demikianlah tiang itu berdiri di antara tentara orang Mesir dan tentara orang Israel; dan oleh karena awan itu menimbulkan kegelapan, maka malam itu lewat, sehingga yang satu tidak dapat mendekati yang lain, semalam-malaman itu."
 },
 {
   "id": 1912,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 21,
   "firman": "Lalu Musa mengulurkan tangannya ke atas laut, dan semalam-malaman itu TUHAN menguakkan air laut dengan perantaraan angin timur yang keras, membuat laut itu menjadi tanah kering; maka terbelahlah air itu."
 },
 {
   "id": 1913,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 22,
   "firman": "Demikianlah orang Israel berjalan dari tengah-tengah laut di tempat kering; sedang di kiri dan di kanan mereka air itu sebagai tembok bagi mereka."
 },
 {
   "id": 1914,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 23,
   "firman": "Orang Mesir mengejar dan menyusul mereka--segala kuda Firaun, keretanya dan orangnya yang berkuda--sampai ke tengah-tengah laut."
 },
 {
   "id": 1915,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 24,
   "firman": "Dan pada waktu jaga pagi, TUHAN yang di dalam tiang api dan awan itu memandang kepada tentara orang Mesir, lalu dikacaukan-Nya tentara orang Mesir itu."
 },
 {
   "id": 1916,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 25,
   "firman": "Ia membuat roda keretanya berjalan miring dan maju dengan berat, sehingga orang Mesir berkata: \"Marilah kita lari meninggalkan orang Israel, sebab Tuhanlah yang berperang untuk mereka melawan Mesir.\""
 },
 {
   "id": 1917,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 26,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Ulurkanlah tanganmu ke atas laut, supaya air berbalik meliputi orang Mesir, meliputi kereta mereka dan orang mereka yang berkuda.\""
 },
 {
   "id": 1918,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 27,
   "firman": "Musa mengulurkan tangannya ke atas laut, maka menjelang pagi berbaliklah air laut ke tempatnya, sedang orang Mesir lari menuju air itu; demikianlah TUHAN mencampakkan orang Mesir ke tengah-tengah laut."
 },
 {
   "id": 1919,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 28,
   "firman": "Berbaliklah segala air itu, lalu menutupi kereta dan orang berkuda dari seluruh pasukan Firaun, yang telah menyusul orang Israel itu ke laut; seorangpun tidak ada yang tinggal dari mereka."
 },
 {
   "id": 1920,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 29,
   "firman": "Tetapi orang Israel berjalan di tempat kering dari tengah-tengah laut, sedang di kiri dan di kanan mereka air itu sebagai tembok bagi mereka."
 },
 {
   "id": 1921,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 30,
   "firman": "Demikianlah pada hari itu TUHAN menyelamatkan orang Israel dari tangan orang Mesir. Dan orang Israel melihat orang Mesir mati terhantar di pantai laut."
 },
 {
   "id": 1922,
   "kitab": "Kel",
   "pasal": 14,
   "ayat": 31,
   "firman": "Ketika dilihat oleh orang Israel, betapa besarnya perbuatan yang dilakukan TUHAN terhadap orang Mesir, maka takutlah bangsa itu kepada TUHAN dan mereka percaya kepada TUHAN dan kepada Musa, hamba-Nya itu."
 },
 {
   "id": 1923,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 1,
   "firman": "Pada waktu itu Musa bersama-sama dengan orang Israel menyanyikan nyanyian ini bagi TUHAN yang berbunyi: \"Baiklah aku menyanyi bagi TUHAN, sebab Ia tinggi luhur, kuda dan penunggangnya dilemparkan-Nya ke dalam laut."
 },
 {
   "id": 1924,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 2,
   "firman": "TUHAN itu kekuatanku dan mazmurku, Ia telah menjadi keselamatanku. Ia Allahku, kupuji Dia, Ia Allah bapaku, kuluhurkan Dia."
 },
 {
   "id": 1925,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 3,
   "firman": "TUHAN itu pahlawan perang; TUHAN, itulah nama-Nya."
 },
 {
   "id": 1926,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 4,
   "firman": "Kereta Firaun dan pasukannya dibuang-Nya ke dalam laut; para perwiranya yang pilihan dibenamkan ke dalam Laut Teberau."
 },
 {
   "id": 1927,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 5,
   "firman": "Samudera raya menutupi mereka; ke air yang dalam mereka tenggelam seperti batu."
 },
 {
   "id": 1928,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 6,
   "firman": "Tangan kanan-Mu, TUHAN, mulia karena kekuasaan-Mu, tangan kanan-Mu, TUHAN, menghancurkan musuh."
 },
 {
   "id": 1929,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 7,
   "firman": "Dengan keluhuran-Mu yang besar Engkau meruntuhkan siapa yang bangkit menentang Engkau; Engkau melepaskan api murka-Mu, yang memakan mereka sebagai tunggul gandum."
 },
 {
   "id": 1930,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 8,
   "firman": "Karena nafas hidung-Mu segala air naik bertimbun-timbun; segala aliran berdiri tegak seperti bendungan; air bah membeku di tengah-tengah laut."
 },
 {
   "id": 1931,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 9,
   "firman": "Kata musuh: Aku akan mengejar, akan mencapai mereka, akan membagi-bagi jarahan; nafsuku akan kulampiaskan kepada mereka, akan kuhunus pedangku; tanganku akan melenyapkan mereka!"
 },
 {
   "id": 1932,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 10,
   "firman": "Engkau meniup dengan taufan-Mu, lautpun menutupi mereka; sebagai timah mereka tenggelam dalam air yang hebat."
 },
 {
   "id": 1933,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 11,
   "firman": "Siapakah yang seperti Engkau, di antara para allah, ya TUHAN; siapakah seperti Engkau, mulia karena kekudusan-Mu, menakutkan karena perbuatan-Mu yang masyhur, Engkau pembuat keajaiban?"
 },
 {
   "id": 1934,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 12,
   "firman": "Engkau mengulurkan tangan kanan-Mu; bumipun menelan mereka."
 },
 {
   "id": 1935,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 13,
   "firman": "Dengan kasih setia-Mu Engkau menuntun umat yang telah Kautebus; dengan kekuatan-Mu Engkau membimbingnya ke tempat kediaman-Mu yang kudus."
 },
 {
   "id": 1936,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 14,
   "firman": "Bangsa-bangsa mendengarnya, merekapun menggigil; kegentaran menghinggapi penduduk tanah Filistin."
 },
 {
   "id": 1937,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 15,
   "firman": "Pada waktu itu gemparlah para kepala kaum di Edom, kedahsyatan menghinggapi orang-orang berkuasa di Moab; semua penduduk tanah Kanaan gemetar."
 },
 {
   "id": 1938,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 16,
   "firman": "Ngeri dan takut menimpa mereka, karena kebesaran tangan-Mu mereka kaku seperti batu, sampai umat-Mu menyeberang, ya TUHAN, sampai umat yang Kauperoleh menyeberang."
 },
 {
   "id": 1939,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 17,
   "firman": "Engkau membawa mereka dan Kaucangkokkan mereka di atas gunung milik-Mu sendiri; di tempat yang telah Kaubuat kediaman-Mu, ya TUHAN; di tempat kudus, yang didirikan tangan-Mu, ya TUHAN."
 },
 {
   "id": 1940,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 18,
   "firman": "TUHAN memerintah kekal selama-lamanya.\""
 },
 {
   "id": 1941,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 19,
   "firman": "Ketika kuda Firaun dengan keretanya dan orangnya yang berkuda telah masuk ke laut, maka TUHAN membuat air laut berbalik meliputi mereka, tetapi orang Israel berjalan di tempat kering dari tengah-tengah laut."
 },
 {
   "id": 1942,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 20,
   "firman": "Lalu Miryam, nabiah itu, saudara perempuan Harun, mengambil rebana di tangannya, dan tampillah semua perempuan mengikutinya memukul rebana serta menari-nari."
 },
 {
   "id": 1943,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 21,
   "firman": "Dan menyanyilah Miryam memimpin mereka: \"Menyanyilah bagi TUHAN, sebab Ia tinggi luhur; kuda dan penunggangnya dilemparkan-Nya ke dalam laut.\""
 },
 {
   "id": 1944,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 22,
   "firman": "Musa menyuruh orang Israel berangkat dari Laut Teberau, lalu mereka pergi ke padang gurun Syur; tiga hari lamanya mereka berjalan di padang gurun itu dengan tidak mendapat air."
 },
 {
   "id": 1945,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 23,
   "firman": "Sampailah mereka ke Mara, tetapi mereka tidak dapat meminum air yang di Mara itu, karena pahit rasanya. Itulah sebabnya dinamai orang tempat itu Mara."
 },
 {
   "id": 1946,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 24,
   "firman": "Lalu bersungut-sungutlah bangsa itu kepada Musa, kata mereka: \"Apakah yang akan kami minum?\""
 },
 {
   "id": 1947,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 25,
   "firman": "Musa berseru-seru kepada TUHAN, dan TUHAN menunjukkan kepadanya sepotong kayu; Musa melemparkan kayu itu ke dalam air; lalu air itu menjadi manis. Di sanalah diberikan TUHAN ketetapan-ketetapan dan peraturan-peraturan kepada mereka dan di sanalah TUHAN mencoba mereka,"
 },
 {
   "id": 1948,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 26,
   "firman": "firman-Nya: \"Jika kamu sungguh-sungguh mendengarkan suara TUHAN, Allahmu, dan melakukan apa yang benar di mata-Nya, dan memasang telingamu kepada perintah-perintah-Nya dan tetap mengikuti segala ketetapan-Nya, maka Aku tidak akan menimpakan kepadamu penyakit manapun, yang telah Kutimpakan kepada orang Mesir; sebab Aku Tuhanlah yang menyembuhkan engkau.\""
 },
 {
   "id": 1949,
   "kitab": "Kel",
   "pasal": 15,
   "ayat": 27,
   "firman": "Sesudah itu sampailah mereka di Elim; di sana ada dua belas mata air dan tujuh puluh pohon korma, lalu berkemahlah mereka di sana di tepi air itu."
 },
 {
   "id": 1950,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 1,
   "firman": "Setelah mereka berangkat dari Elim, tibalah segenap jemaah Israel di padang gurun Sin, yang terletak di antara Elim dan gunung Sinai, pada hari yang kelima belas bulan yang kedua, sejak mereka keluar dari tanah Mesir."
 },
 {
   "id": 1951,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 2,
   "firman": "Di padang gurun itu bersungut-sungutlah segenap jemaah Israel kepada Musa dan Harun;"
 },
 {
   "id": 1952,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 3,
   "firman": "dan berkata kepada mereka: \"Ah, kalau kami mati tadinya di tanah Mesir oleh tangan TUHAN ketika kami duduk menghadapi kuali berisi daging dan makan roti sampai kenyang! Sebab kamu membawa kami keluar ke padang gurun ini untuk membunuh seluruh jemaah ini dengan kelaparan.\""
 },
 {
   "id": 1953,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 4,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa: \"Sesungguhnya Aku akan menurunkan dari langit hujan roti bagimu; maka bangsa itu akan keluar dan memungut tiap-tiap hari sebanyak yang perlu untuk sehari, supaya mereka Kucoba, apakah mereka hidup menurut hukum-Ku atau tidak."
 },
 {
   "id": 1954,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 5,
   "firman": "Dan pada hari yang keenam, apabila mereka memasak yang dibawa mereka pulang, maka yang dibawa itu akan terdapat dua kali lipat banyaknya dari apa yang dipungut mereka sehari-hari.\""
 },
 {
   "id": 1955,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 6,
   "firman": "Sesudah itu berkatalah Musa dan Harun kepada seluruh orang Israel: \"Petang ini kamu akan mengetahui bahwa Tuhanlah yang telah membawa kamu keluar dari tanah Mesir."
 },
 {
   "id": 1956,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 7,
   "firman": "Dan besok pagi kamu melihat kemuliaan TUHAN, karena Ia telah mendengar sungut-sungutmu kepada-Nya. Sebab, apalah kami ini maka kamu bersungut-sungut kepada kami?\""
 },
 {
   "id": 1957,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 8,
   "firman": "Lagi kata Musa: \"Jika memang TUHAN yang memberi kamu makan daging pada waktu petang dan makan roti sampai kenyang pada waktu pagi, karena TUHAN telah mendengar sungut-sungutmu yang kamu sungut-sungutkan kepada-Nya--apalah kami ini? Bukan kepada kami sungut-sungutmu itu, tetapi kepada TUHAN.\""
 },
 {
   "id": 1958,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 9,
   "firman": "Kata Musa kepada Harun: \"Katakanlah kepada segenap jemaah Israel: Marilah dekat ke hadapan TUHAN, sebab Ia telah mendengar sungut-sungutmu.\""
 },
 {
   "id": 1959,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 10,
   "firman": "Dan sedang Harun berbicara kepada segenap jemaah Israel, mereka memalingkan mukanya ke arah padang gurun--maka tampaklah kemuliaan TUHAN dalam awan."
 },
 {
   "id": 1960,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 11,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 1961,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 12,
   "firman": "\"Aku telah mendengar sungut-sungut orang Israel; katakanlah kepada mereka: Pada waktu senja kamu akan makan daging dan pada waktu pagi kamu akan kenyang makan roti; maka kamu akan mengetahui, bahwa Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 1962,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 13,
   "firman": "Pada waktu petang datanglah berduyun-duyun burung puyuh yang menutupi perkemahan itu; dan pada waktu pagi terletaklah embun sekeliling perkemahan itu."
 },
 {
   "id": 1963,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 14,
   "firman": "Ketika embun itu telah menguap, tampaklah pada permukaan padang gurun sesuatu yang halus, sesuatu yang seperti sisik, halus seperti embun beku di bumi."
 },
 {
   "id": 1964,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 15,
   "firman": "Ketika orang Israel melihatnya, berkatalah mereka seorang kepada yang lain: \"Apakah ini?\" Sebab mereka tidak tahu apa itu. Tetapi Musa berkata kepada mereka: \"Inilah roti yang diberikan TUHAN kepadamu menjadi makananmu."
 },
 {
   "id": 1965,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 16,
   "firman": "Beginilah perintah TUHAN: Pungutlah itu, tiap-tiap orang menurut keperluannya; masing-masing kamu boleh mengambil untuk seisi kemahnya, segomer seorang, menurut jumlah jiwa.\""
 },
 {
   "id": 1966,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 17,
   "firman": "Demikianlah diperbuat orang Israel; mereka mengumpulkan, ada yang banyak, ada yang sedikit."
 },
 {
   "id": 1967,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 18,
   "firman": "Ketika mereka menakarnya dengan gomer, maka orang yang mengumpulkan banyak, tidak kelebihan dan orang yang mengumpulkan sedikit, tidak kekurangan. Tiap-tiap orang mengumpulkan menurut keperluannya."
 },
 {
   "id": 1968,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 19,
   "firman": "Musa berkata kepada mereka: \"Seorangpun tidak boleh meninggalkan dari padanya sampai pagi.\""
 },
 {
   "id": 1969,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 20,
   "firman": "Tetapi ada yang tidak mendengarkan Musa dan meninggalkan dari padanya sampai pagi, lalu berulat dan berbau busuk. Maka Musa menjadi marah kepada mereka."
 },
 {
   "id": 1970,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 21,
   "firman": "Setiap pagi mereka memungutnya, tiap-tiap orang menurut keperluannya; tetapi ketika matahari panas, cairlah itu."
 },
 {
   "id": 1971,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 22,
   "firman": "Dan pada hari yang keenam mereka memungut roti itu dua kali lipat banyaknya, dua gomer untuk tiap-tiap orang; dan datanglah semua pemimpin jemaah memberitahukannya kepada Musa."
 },
 {
   "id": 1972,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 23,
   "firman": "Lalu berkatalah Musa kepada mereka: \"Inilah yang dimaksudkan TUHAN: Besok adalah hari perhentian penuh, sabat yang kudus bagi TUHAN; maka roti yang perlu kamu bakar, bakarlah, dan apa yang perlu kamu masak, masaklah; dan segala kelebihannya biarkanlah di tempatnya untuk disimpan sampai pagi.\""
 },
 {
   "id": 1973,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 24,
   "firman": "Mereka membiarkannya di tempatnya sampai keesokan harinya, seperti yang diperintahkan Musa; lalu tidaklah berbau busuk dan tidak ada ulat di dalamnya."
 },
 {
   "id": 1974,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 25,
   "firman": "Selanjutnya kata Musa: \"Makanlah itu pada hari ini, sebab hari ini adalah sabat untuk TUHAN, pada hari ini tidaklah kamu mendapatnya di padang."
 },
 {
   "id": 1975,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 26,
   "firman": "Enam hari lamanya kamu memungutnya, tetapi pada hari yang ketujuh ada sabat; maka roti itu tidak ada pada hari itu.\""
 },
 {
   "id": 1976,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 27,
   "firman": "Tetapi ketika pada hari ketujuh ada dari bangsa itu yang keluar memungutnya, tidaklah mereka mendapatnya."
 },
 {
   "id": 1977,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 28,
   "firman": "Sebab itu TUHAN berfirman kepada Musa: \"Berapa lama lagi kamu menolak mengikuti segala perintah-Ku dan hukum-Ku?"
 },
 {
   "id": 1978,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 29,
   "firman": "Perhatikanlah, TUHAN telah memberikan sabat itu kepadamu; itulah sebabnya pada hari keenam Ia memberikan kepadamu roti untuk dua hari. Tinggallah kamu di tempatmu masing-masing, seorangpun tidak boleh keluar dari tempatnya pada hari ketujuh itu.\""
 },
 {
   "id": 1979,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 30,
   "firman": "Lalu beristirahatlah bangsa itu pada hari ketujuh."
 },
 {
   "id": 1980,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 31,
   "firman": "Umat Israel menyebutkan namanya: manna; warnanya putih seperti ketumbar dan rasanya seperti rasa kue madu."
 },
 {
   "id": 1981,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 32,
   "firman": "Musa berkata: \"Beginilah perintah TUHAN: Ambillah segomer penuh untuk disimpan turun-temurun, supaya keturunan mereka melihat roti yang Kuberi kamu makan di padang gurun, ketika Aku membawa kamu keluar dari tanah Mesir.\""
 },
 {
   "id": 1982,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 33,
   "firman": "Sebab itu Musa berkata kepada Harun: \"Ambillah sebuah buli-buli, taruhlah manna di dalamnya segomer penuh, dan tempatkanlah itu di hadapan TUHAN untuk disimpan turun-temurun.\""
 },
 {
   "id": 1983,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 34,
   "firman": "Seperti yang diperintahkan TUHAN kepada Musa, demikianlah buli-buli itu ditempatkan Harun di hadapan tabut hukum Allah untuk disimpan."
 },
 {
   "id": 1984,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 35,
   "firman": "Orang Israel makan manna empat puluh tahun lamanya, sampai mereka tiba di tanah yang didiami orang; mereka makan manna sampai tiba di perbatasan tanah Kanaan."
 },
 {
   "id": 1985,
   "kitab": "Kel",
   "pasal": 16,
   "ayat": 36,
   "firman": "Adapun segomer ialah sepersepuluh efa."
 },
 {
   "id": 1986,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 1,
   "firman": "Kemudian berangkatlah segenap jemaah Israel dari padang gurun Sin, berjalan dari tempat persinggahan ke tempat persinggahan, sesuai dengan titah TUHAN, lalu berkemahlah mereka di Rafidim, tetapi di sana tidak ada air untuk diminum bangsa itu."
 },
 {
   "id": 1987,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 2,
   "firman": "Jadi mulailah mereka itu bertengkar dengan Musa, kata mereka: \"Berikanlah air kepada kami, supaya kami dapat minum.\" Tetapi Musa berkata kepada mereka: \"Mengapakah kamu bertengkar dengan aku? Mengapakah kamu mencobai TUHAN?\""
 },
 {
   "id": 1988,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 3,
   "firman": "Hauslah bangsa itu akan air di sana; bersungut-sungutlah bangsa itu kepada Musa dan berkata: \"Mengapa pula engkau memimpin kami keluar dari Mesir, untuk membunuh kami, anak-anak kami dan ternak kami dengan kehausan?\""
 },
 {
   "id": 1989,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 4,
   "firman": "Lalu berseru-serulah Musa kepada TUHAN, katanya: \"Apakah yang akan kulakukan kepada bangsa ini? Sebentar lagi mereka akan melempari aku dengan batu!\""
 },
 {
   "id": 1990,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 5,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Berjalanlah di depan bangsa itu dan bawalah beserta engkau beberapa orang dari antara para tua-tua Israel; bawalah juga di tanganmu tongkatmu yang kaupakai memukul sungai Nil dan pergilah."
 },
 {
   "id": 1991,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 6,
   "firman": "Maka Aku akan berdiri di sana di depanmu di atas gunung batu di Horeb; haruslah kaupukul gunung batu itu dan dari dalamnya akan keluar air, sehingga bangsa itu dapat minum.\" Demikianlah diperbuat Musa di depan mata tua-tua Israel."
 },
 {
   "id": 1992,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 7,
   "firman": "Dinamailah tempat itu Masa dan Meriba, oleh karena orang Israel telah bertengkar dan oleh karena mereka telah mencobai TUHAN dengan mengatakan: \"Adakah TUHAN di tengah-tengah kita atau tidak?\""
 },
 {
   "id": 1993,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 8,
   "firman": "Lalu datanglah orang Amalek dan berperang melawan orang Israel di Rafidim."
 },
 {
   "id": 1994,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 9,
   "firman": "Musa berkata kepada Yosua: \"Pilihlah orang-orang bagi kita, lalu keluarlah berperang melawan orang Amalek, besok aku akan berdiri di puncak bukit itu dengan memegang tongkat Allah di tanganku.\""
 },
 {
   "id": 1995,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 10,
   "firman": "Lalu Yosua melakukan seperti yang dikatakan Musa kepadanya dan berperang melawan orang Amalek; tetapi Musa, Harun dan Hur telah naik ke puncak bukit."
 },
 {
   "id": 1996,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 11,
   "firman": "Dan terjadilah, apabila Musa mengangkat tangannya, lebih kuatlah Israel, tetapi apabila ia menurunkan tangannya, lebih kuatlah Amalek."
 },
 {
   "id": 1997,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 12,
   "firman": "Maka penatlah tangan Musa, sebab itu mereka mengambil sebuah batu, diletakkanlah di bawahnya, supaya ia duduk di atasnya; Harun dan Hur menopang kedua belah tangannya, seorang di sisi yang satu, seorang di sisi yang lain, sehingga tangannya tidak bergerak sampai matahari terbenam."
 },
 {
   "id": 1998,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 13,
   "firman": "Demikianlah Yosua mengalahkan Amalek dan rakyatnya dengan mata pedang."
 },
 {
   "id": 1999,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 14,
   "firman": "Kemudian berfirmanlah TUHAN kepada Musa: \"Tuliskanlah semuanya ini dalam sebuah kitab sebagai tanda peringatan, dan ingatkanlah ke telinga Yosua, bahwa Aku akan menghapuskan sama sekali ingatan kepada Amalek dari kolong langit.\""
 },
 {
   "id": 2000,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 15,
   "firman": "Lalu Musa mendirikan sebuah mezbah dan menamainya: \"Tuhanlah panji-panjiku!\""
 },
 {
   "id": 2001,
   "kitab": "Kel",
   "pasal": 17,
   "ayat": 16,
   "firman": "Ia berkata: \"Tangan di atas panji-panji TUHAN! TUHAN berperang melawan Amalek turun-temurun.\""
 },
 {
   "id": 2002,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 1,
   "firman": "Kedengaranlah kepada Yitro, imam di Midian, mertua Musa, segala yang dilakukan Allah kepada Musa dan kepada Israel, umat-Nya, yakni bahwa TUHAN telah membawa orang Israel keluar dari Mesir."
 },
 {
   "id": 2003,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 2,
   "firman": "Lalu Yitro, mertua Musa, membawa serta Zipora, isteri Musa--yang dahulu disuruh Musa pulang--"
 },
 {
   "id": 2004,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 3,
   "firman": "dan kedua anak laki-laki Zipora; yang seorang bernama Gersom, sebab kata Musa: \"Aku telah menjadi seorang pendatang di negeri asing,\""
 },
 {
   "id": 2005,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 4,
   "firman": "dan yang seorang lagi bernama Eliezer, sebab katanya: \"Allah bapaku adalah penolongku dan telah menyelamatkan aku dari pedang Firaun.\""
 },
 {
   "id": 2006,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 5,
   "firman": "Ketika Yitro, mertua Musa, beserta anak-anak dan isteri Musa sampai kepadanya di padang gurun, tempat ia berkemah dekat gunung Allah,"
 },
 {
   "id": 2007,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 6,
   "firman": "disuruhnyalah mengatakan kepada Musa: \"Aku, mertuamu Yitro, datang kepadamu membawa isterimu beserta kedua anaknya.\""
 },
 {
   "id": 2008,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 7,
   "firman": "Lalu keluarlah Musa menyongsong mertuanya itu, sujudlah ia kepadanya dan menciumnya; mereka menanyakan keselamatan masing-masing, lalu masuk ke dalam kemah."
 },
 {
   "id": 2009,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 8,
   "firman": "Sesudah itu Musa menceritakan kepada mertuanya segala yang dilakukan TUHAN kepada Firaun dan kepada orang Mesir karena Israel dan segala kesusahan yang mereka alami di jalan dan bagaimana TUHAN menyelamatkan mereka."
 },
 {
   "id": 2010,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 9,
   "firman": "Bersukacitalah Yitro tentang segala kebaikan, yang dilakukan TUHAN kepada orang Israel, bahwa Ia telah menyelamatkan mereka dari tangan orang Mesir."
 },
 {
   "id": 2011,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 10,
   "firman": "Lalu kata Yitro: \"Terpujilah TUHAN, yang telah menyelamatkan kamu dari tangan orang Mesir dan dari tangan Firaun."
 },
 {
   "id": 2012,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 11,
   "firman": "Sekarang aku tahu, bahwa TUHAN lebih besar dari segala allah; sebab Ia telah menyelamatkan bangsa ini dari tangan orang Mesir, karena memang orang-orang ini telah bertindak angkuh terhadap mereka.\""
 },
 {
   "id": 2013,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 12,
   "firman": "Dan Yitro, mertua Musa, mempersembahkan korban bakaran dan beberapa korban sembelihan bagi Allah; lalu Harun dan semua tua-tua Israel datang untuk makan bersama-sama dengan mertua Musa di hadapan Allah."
 },
 {
   "id": 2014,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 13,
   "firman": "Keesokan harinya duduklah Musa mengadili di antara bangsa itu; dan bangsa itu berdiri di depan Musa, dari pagi sampai petang."
 },
 {
   "id": 2015,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 14,
   "firman": "Ketika mertua Musa melihat segala yang dilakukannya kepada bangsa itu, berkatalah ia: \"Apakah ini yang kaulakukan kepada bangsa itu? Mengapakah engkau seorang diri saja yang duduk, sedang seluruh bangsa itu berdiri di depanmu dari pagi sampai petang?\""
 },
 {
   "id": 2016,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 15,
   "firman": "Kata Musa kepada mertuanya itu: \"Sebab bangsa ini datang kepadaku untuk menanyakan petunjuk Allah."
 },
 {
   "id": 2017,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 16,
   "firman": "Apabila ada perkara di antara mereka, maka mereka datang kepadaku dan aku mengadili antara yang seorang dan yang lain; lagipula aku memberitahukan kepada mereka ketetapan-ketetapan dan keputusan-keputusan Allah.\""
 },
 {
   "id": 2018,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 17,
   "firman": "Tetapi mertua Musa menjawabnya: \"Tidak baik seperti yang kaulakukan itu."
 },
 {
   "id": 2019,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 18,
   "firman": "Engkau akan menjadi sangat lelah, baik engkau baik bangsa yang beserta engkau ini; sebab pekerjaan ini terlalu berat bagimu, takkan sanggup engkau melakukannya seorang diri saja."
 },
 {
   "id": 2020,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 19,
   "firman": "Jadi sekarang dengarkanlah perkataanku, aku akan memberi nasihat kepadamu dan Allah akan menyertai engkau. Adapun engkau, wakililah bangsa itu di hadapan Allah dan kauhadapkanlah perkara-perkara mereka kepada Allah."
 },
 {
   "id": 2021,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 20,
   "firman": "Kemudian haruslah engkau mengajarkan kepada mereka ketetapan-ketetapan dan keputusan-keputusan, dan memberitahukan kepada mereka jalan yang harus dijalani, dan pekerjaan yang harus dilakukan."
 },
 {
   "id": 2022,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 21,
   "firman": "Di samping itu kaucarilah dari seluruh bangsa itu orang-orang yang cakap dan takut akan Allah, orang-orang yang dapat dipercaya, dan yang benci kepada pengejaran suap; tempatkanlah mereka di antara bangsa itu menjadi pemimpin seribu orang, pemimpin seratus orang, pemimpin lima puluh orang dan pemimpin sepuluh orang."
 },
 {
   "id": 2023,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 22,
   "firman": "Dan sewaktu-waktu mereka harus mengadili di antara bangsa; maka segala perkara yang besar haruslah dihadapkan mereka kepadamu, tetapi segala perkara yang kecil diadili mereka sendiri; dengan demikian mereka meringankan pekerjaanmu, dan mereka bersama-sama dengan engkau turut menanggungnya."
 },
 {
   "id": 2024,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 23,
   "firman": "Jika engkau berbuat demikian dan Allah memerintahkan hal itu kepadamu, maka engkau akan sanggup menahannya, dan seluruh bangsa ini akan pulang dengan puas senang ke tempatnya.\""
 },
 {
   "id": 2025,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 24,
   "firman": "Musa mendengarkan perkataan mertuanya itu dan dilakukannyalah segala yang dikatakannya."
 },
 {
   "id": 2026,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 25,
   "firman": "Dari seluruh orang Israel Musa memilih orang-orang cakap dan mengangkat mereka menjadi kepala atas bangsa itu, menjadi pemimpin seribu orang, pemimpin seratus orang, pemimpin lima puluh orang dan pemimpin sepuluh orang."
 },
 {
   "id": 2027,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 26,
   "firman": "Mereka ini mengadili di antara bangsa itu sewaktu-waktu; perkara-perkara yang sukar dihadapkan mereka kepada Musa, tetapi perkara-perkara yang kecil diadili mereka sendiri."
 },
 {
   "id": 2028,
   "kitab": "Kel",
   "pasal": 18,
   "ayat": 27,
   "firman": "Kemudian Musa membiarkan mertuanya itu pergi dan ia pulang ke negerinya."
 },
 {
   "id": 2029,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 1,
   "firman": "Pada bulan ketiga setelah orang Israel keluar dari tanah Mesir, mereka tiba di padang gurun Sinai pada hari itu juga."
 },
 {
   "id": 2030,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 2,
   "firman": "Setelah mereka berangkat dari Rafidim, tibalah mereka di padang gurun Sinai, lalu mereka berkemah di padang gurun; orang Israel berkemah di sana di depan gunung itu."
 },
 {
   "id": 2031,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 3,
   "firman": "Lalu naiklah Musa menghadap Allah, dan TUHAN berseru dari gunung itu kepadanya: \"Beginilah kaukatakan kepada keturunan Yakub dan kauberitakan kepada orang Israel:"
 },
 {
   "id": 2032,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 4,
   "firman": "Kamu sendiri telah melihat apa yang Kulakukan kepada orang Mesir, dan bagaimana Aku telah mendukung kamu di atas sayap rajawali dan membawa kamu kepada-Ku."
 },
 {
   "id": 2033,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 5,
   "firman": "Jadi sekarang, jika kamu sungguh-sungguh mendengarkan firman-Ku dan berpegang pada perjanjian-Ku, maka kamu akan menjadi harta kesayangan-Ku sendiri dari antara segala bangsa, sebab Akulah yang empunya seluruh bumi."
 },
 {
   "id": 2034,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 6,
   "firman": "Kamu akan menjadi bagi-Ku kerajaan imam dan bangsa yang kudus. Inilah semuanya firman yang harus kaukatakan kepada orang Israel.\""
 },
 {
   "id": 2035,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 7,
   "firman": "Lalu datanglah Musa dan memanggil para tua-tua bangsa itu dan membawa ke depan mereka segala firman yang diperintahkan TUHAN kepadanya."
 },
 {
   "id": 2036,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 8,
   "firman": "Seluruh bangsa itu menjawab bersama-sama: \"Segala yang difirmankan TUHAN akan kami lakukan.\" Lalu Musapun menyampaikan jawab bangsa itu kepada TUHAN."
 },
 {
   "id": 2037,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 9,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Sesungguhnya Aku akan datang kepadamu dalam awan yang tebal, dengan maksud supaya dapat didengar oleh bangsa itu apabila Aku berbicara dengan engkau, dan juga supaya mereka senantiasa percaya kepadamu.\" Lalu Musa memberitahukan perkataan bangsa itu kepada TUHAN."
 },
 {
   "id": 2038,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 10,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah kepada bangsa itu; suruhlah mereka menguduskan diri pada hari ini dan besok, dan mereka harus mencuci pakaiannya."
 },
 {
   "id": 2039,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 11,
   "firman": "Menjelang hari ketiga mereka harus bersiap, sebab pada hari ketiga TUHAN akan turun di depan mata seluruh bangsa itu di gunung Sinai."
 },
 {
   "id": 2040,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 12,
   "firman": "Sebab itu haruslah engkau memasang batas bagi bangsa itu berkeliling sambil berkata: Jagalah baik-baik, jangan kamu mendaki gunung itu atau kena kepada kakinya, sebab siapapun yang kena kepada gunung itu, pastilah ia dihukum mati."
 },
 {
   "id": 2041,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 13,
   "firman": "Tangan seorangpun tidak boleh merabanya, sebab pastilah ia dilempari dengan batu atau dipanahi sampai mati; baik binatang baik manusia, ia tidak akan dibiarkan hidup. Hanya apabila sangkakala berbunyi panjang, barulah mereka boleh mendaki gunung itu.\""
 },
 {
   "id": 2042,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 14,
   "firman": "Lalu turunlah Musa dari gunung mendapatkan bangsa itu; disuruhnyalah bangsa itu menguduskan diri dan merekapun mencuci pakaiannya."
 },
 {
   "id": 2043,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 15,
   "firman": "Maka kata Musa kepada bangsa itu: \"Bersiaplah menjelang hari yang ketiga, dan janganlah kamu bersetubuh dengan perempuan.\""
 },
 {
   "id": 2044,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 16,
   "firman": "Dan terjadilah pada hari ketiga, pada waktu terbit fajar, ada guruh dan kilat dan awan padat di atas gunung dan bunyi sangkakala yang sangat keras, sehingga gemetarlah seluruh bangsa yang ada di perkemahan."
 },
 {
   "id": 2045,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 17,
   "firman": "Lalu Musa membawa bangsa itu keluar dari perkemahan untuk menjumpai Allah dan berdirilah mereka pada kaki gunung."
 },
 {
   "id": 2046,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 18,
   "firman": "Gunung Sinai ditutupi seluruhnya dengan asap, karena TUHAN turun ke atasnya dalam api; asapnya membubung seperti asap dari dapur, dan seluruh gunung itu gemetar sangat."
 },
 {
   "id": 2047,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 19,
   "firman": "Bunyi sangkakala kian lama kian keras. Berbicaralah Musa, lalu Allah menjawabnya dalam guruh."
 },
 {
   "id": 2048,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 20,
   "firman": "Lalu turunlah TUHAN ke atas gunung Sinai, ke atas puncak gunung itu, maka TUHAN memanggil Musa ke puncak gunung itu, dan naiklah Musa ke atas."
 },
 {
   "id": 2049,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 21,
   "firman": "Kemudian TUHAN berfirman kepada Musa: \"Turunlah, peringatkanlah kepada bangsa itu, supaya mereka jangan menembus mendapatkan TUHAN hendak melihat-lihat; sebab tentulah banyak dari mereka akan binasa."
 },
 {
   "id": 2050,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 22,
   "firman": "Juga para imam yang datang mendekat kepada TUHAN haruslah menguduskan dirinya, supaya TUHAN jangan melanda mereka.\""
 },
 {
   "id": 2051,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 23,
   "firman": "Lalu berkatalah Musa kepada TUHAN: \"Tidak akan mungkin bangsa itu mendaki gunung Sinai ini, sebab Engkau sendiri telah memperingatkan kepada kami, demikian: Pasanglah batas sekeliling gunung itu dan nyatakanlah itu kudus.\""
 },
 {
   "id": 2052,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 24,
   "firman": "Lalu TUHAN berfirman kepadanya: \"Pergilah, turunlah, kemudian naiklah pula, engkau beserta Harun; tetapi para imam dan rakyat tidak boleh menembus untuk mendaki menghadap TUHAN, supaya mereka jangan dilanda-Nya.\""
 },
 {
   "id": 2053,
   "kitab": "Kel",
   "pasal": 19,
   "ayat": 25,
   "firman": "Lalu turunlah Musa mendapatkan bangsa itu dan menyatakan hal itu kepada mereka."
 },
 {
   "id": 2054,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 1,
   "firman": "Lalu Allah mengucapkan segala firman ini:"
 },
 {
   "id": 2055,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 2,
   "firman": "\"Akulah TUHAN, Allahmu, yang membawa engkau keluar dari tanah Mesir, dari tempat perbudakan."
 },
 {
   "id": 2056,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 3,
   "firman": "Jangan ada padamu allah lain di hadapan-Ku."
 },
 {
   "id": 2057,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 4,
   "firman": "Jangan membuat bagimu patung yang menyerupai apapun yang ada di langit di atas, atau yang ada di bumi di bawah, atau yang ada di dalam air di bawah bumi."
 },
 {
   "id": 2058,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 5,
   "firman": "Jangan sujud menyembah kepadanya atau beribadah kepadanya, sebab Aku, TUHAN, Allahmu, adalah Allah yang cemburu, yang membalaskan kesalahan bapa kepada anak-anaknya, kepada keturunan yang ketiga dan keempat dari orang-orang yang membenci Aku,"
 },
 {
   "id": 2059,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 6,
   "firman": "tetapi Aku menunjukkan kasih setia kepada beribu-ribu orang, yaitu mereka yang mengasihi Aku dan yang berpegang pada perintah-perintah-Ku."
 },
 {
   "id": 2060,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 7,
   "firman": "Jangan menyebut nama TUHAN, Allahmu, dengan sembarangan, sebab TUHAN akan memandang bersalah orang yang menyebut nama-Nya dengan sembarangan."
 },
 {
   "id": 2061,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 8,
   "firman": "Ingatlah dan kuduskanlah hari Sabat:"
 },
 {
   "id": 2062,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 9,
   "firman": "enam hari lamanya engkau akan bekerja dan melakukan segala pekerjaanmu,"
 },
 {
   "id": 2063,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 10,
   "firman": "tetapi hari ketujuh adalah hari Sabat TUHAN, Allahmu; maka jangan melakukan sesuatu pekerjaan, engkau atau anakmu laki-laki, atau anakmu perempuan, atau hambamu laki-laki, atau hambamu perempuan, atau hewanmu atau orang asing yang di tempat kediamanmu."
 },
 {
   "id": 2064,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 11,
   "firman": "Sebab enam hari lamanya TUHAN menjadikan langit dan bumi, laut dan segala isinya, dan Ia berhenti pada hari ketujuh; itulah sebabnya TUHAN memberkati hari Sabat dan menguduskannya."
 },
 {
   "id": 2065,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 12,
   "firman": "Hormatilah ayahmu dan ibumu, supaya lanjut umurmu di tanah yang diberikan TUHAN, Allahmu, kepadamu."
 },
 {
   "id": 2066,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 13,
   "firman": "Jangan membunuh."
 },
 {
   "id": 2067,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 14,
   "firman": "Jangan berzinah."
 },
 {
   "id": 2068,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 15,
   "firman": "Jangan mencuri."
 },
 {
   "id": 2069,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 16,
   "firman": "Jangan mengucapkan saksi dusta tentang sesamamu."
 },
 {
   "id": 2070,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 17,
   "firman": "Jangan mengingini rumah sesamamu; jangan mengingini isterinya, atau hambanya laki-laki, atau hambanya perempuan, atau lembunya atau keledainya, atau apapun yang dipunyai sesamamu.\""
 },
 {
   "id": 2071,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 18,
   "firman": "Seluruh bangsa itu menyaksikan guruh mengguntur, kilat sabung-menyabung, sangkakala berbunyi dan gunung berasap. Maka bangsa itu takut dan gemetar dan mereka berdiri jauh-jauh."
 },
 {
   "id": 2072,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 19,
   "firman": "Mereka berkata kepada Musa: \"Engkaulah berbicara dengan kami, maka kami akan mendengarkan; tetapi janganlah Allah berbicara dengan kami, nanti kami mati.\""
 },
 {
   "id": 2073,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 20,
   "firman": "Tetapi Musa berkata kepada bangsa itu: \"Janganlah takut, sebab Allah telah datang dengan maksud untuk mencoba kamu dan dengan maksud supaya takut akan Dia ada padamu, agar kamu jangan berbuat dosa.\""
 },
 {
   "id": 2074,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 21,
   "firman": "Adapun bangsa itu berdiri jauh-jauh, tetapi Musa pergi mendekati embun yang kelam di mana Allah ada."
 },
 {
   "id": 2075,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 22,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa: \"Beginilah kaukatakan kepada orang Israel: Kamu sendiri telah menyaksikan, bahwa Aku berbicara dengan kamu dari langit."
 },
 {
   "id": 2076,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 23,
   "firman": "Janganlah kamu membuat di samping-Ku allah perak, juga allah emas janganlah kamu buat bagimu."
 },
 {
   "id": 2077,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 24,
   "firman": "Kaubuatlah bagi-Ku mezbah dari tanah dan persembahkanlah di atasnya korban bakaranmu dan korban keselamatanmu, kambing dombamu dan lembu sapimu. Pada setiap tempat yang Kutentukan menjadi tempat peringatan bagi nama-Ku, Aku akan datang kepadamu dan memberkati engkau."
 },
 {
   "id": 2078,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 25,
   "firman": "Tetapi jika engkau membuat bagi-Ku mezbah dari batu, maka jangan engkau mendirikannya dari batu pahat, sebab apabila engkau mengerjakannya dengan beliung, maka engkau melanggar kekudusannya."
 },
 {
   "id": 2079,
   "kitab": "Kel",
   "pasal": 20,
   "ayat": 26,
   "firman": "Juga jangan engkau naik tangga ke atas ke mezbah-Ku, supaya auratmu jangan kelihatan di atasnya.\""
 },
 {
   "id": 2080,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 1,
   "firman": "\"Inilah peraturan-peraturan yang harus kaubawa ke depan mereka."
 },
 {
   "id": 2081,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 2,
   "firman": "Apabila engkau membeli seorang budak Ibrani, maka haruslah ia bekerja padamu enam tahun lamanya, tetapi pada tahun yang ketujuh ia diizinkan keluar sebagai orang merdeka, dengan tidak membayar tebusan apa-apa."
 },
 {
   "id": 2082,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 3,
   "firman": "Jika ia datang seorang diri saja, maka keluarpun ia seorang diri; jika ia mempunyai isteri, maka isterinya itu diizinkan keluar bersama-sama dengan dia."
 },
 {
   "id": 2083,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 4,
   "firman": "Jika tuannya memberikan kepadanya seorang isteri dan perempuan itu melahirkan anak-anak lelaki atau perempuan, maka perempuan itu dengan anak-anaknya tetap menjadi kepunyaan tuannya, dan budak laki-laki itu harus keluar seorang diri."
 },
 {
   "id": 2084,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 5,
   "firman": "Tetapi jika budak itu dengan sungguh-sungguh berkata: Aku cinta kepada tuanku, kepada isteriku dan kepada anak-anakku, aku tidak mau keluar sebagai orang merdeka,"
 },
 {
   "id": 2085,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 6,
   "firman": "maka haruslah tuannya itu membawanya menghadap Allah, lalu membawanya ke pintu atau ke tiang pintu, dan tuannya itu menusuk telinganya dengan penusuk, dan budak itu bekerja pada tuannya untuk seumur hidup."
 },
 {
   "id": 2086,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 7,
   "firman": "Apabila ada seorang menjual anaknya yang perempuan sebagai budak, maka perempuan itu tidak boleh keluar seperti cara budak-budak lelaki keluar."
 },
 {
   "id": 2087,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 8,
   "firman": "Jika perempuan itu tidak disukai tuannya, yang telah menyediakannya bagi dirinya sendiri, maka haruslah tuannya itu mengizinkan ia ditebus; tuannya itu tidak berhak untuk menjualnya kepada bangsa asing, karena ia memungkiri janjinya kepada perempuan itu."
 },
 {
   "id": 2088,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 9,
   "firman": "Jika tuannya itu menyediakannya bagi anaknya laki-laki, maka haruslah tuannya itu memperlakukannya seperti anak-anak perempuan berhak diperlakukan."
 },
 {
   "id": 2089,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 10,
   "firman": "Jika tuannya itu mengambil perempuan lain, ia tidak boleh mengurangi makanan perempuan itu, pakaiannya dan persetubuhan dengan dia."
 },
 {
   "id": 2090,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 11,
   "firman": "Jika tuannya itu tidak melakukan ketiga hal itu kepadanya, maka perempuan itu harus diizinkan keluar, dengan tidak membayar uang tebusan apa-apa.\""
 },
 {
   "id": 2091,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 12,
   "firman": "\"Siapa yang memukul seseorang, sehingga mati, pastilah ia dihukum mati."
 },
 {
   "id": 2092,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 13,
   "firman": "Tetapi jika pembunuhan itu tidak disengaja, melainkan tangannya ditentukan Allah melakukan itu, maka Aku akan menunjukkan bagimu suatu tempat, ke mana ia dapat lari."
 },
 {
   "id": 2093,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 14,
   "firman": "Tetapi apabila seseorang berlaku angkara terhadap sesamanya, hingga ia membunuhnya dengan tipu daya, maka engkau harus mengambil orang itu dari mezbah-Ku, supaya ia mati dibunuh."
 },
 {
   "id": 2094,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 15,
   "firman": "Siapa yang memukul ayahnya atau ibunya, pastilah ia dihukum mati."
 },
 {
   "id": 2095,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 16,
   "firman": "Siapa yang menculik seorang manusia, baik ia telah menjualnya, baik orang itu masih terdapat padanya, ia pasti dihukum mati."
 },
 {
   "id": 2096,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 17,
   "firman": "Siapa yang mengutuki ayahnya atau ibunya, ia pasti dihukum mati."
 },
 {
   "id": 2097,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 18,
   "firman": "Apabila ada orang bertengkar dan yang seorang memukul yang lain dengan batu atau dengan tinjunya, sehingga yang lain itu memang tidak mati, tetapi terpaksa berbaring di tempat tidur,"
 },
 {
   "id": 2098,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 19,
   "firman": "maka orang yang memukul itu bebas dari hukuman, jika yang lain itu dapat bangkit lagi dan dapat berjalan di luar dengan memakai tongkat; hanya ia harus membayar kerugian orang yang lain itu, karena terpaksa menganggur, dan menanggung pengobatannya sampai sembuh."
 },
 {
   "id": 2099,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 20,
   "firman": "Apabila seseorang memukul budaknya laki-laki atau perempuan dengan tongkat, sehingga mati karena pukulan itu, pastilah budak itu dibalaskan."
 },
 {
   "id": 2100,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 21,
   "firman": "Hanya jika budak itu masih hidup sehari dua, maka janganlah dituntut belanya, sebab budak itu adalah miliknya sendiri."
 },
 {
   "id": 2101,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 22,
   "firman": "Apabila ada orang berkelahi dan seorang dari mereka tertumbuk kepada seorang perempuan yang sedang mengandung, sehingga keguguran kandungan, tetapi tidak mendapat kecelakaan yang membawa maut, maka pastilah ia didenda sebanyak yang dikenakan oleh suami perempuan itu kepadanya, dan ia harus membayarnya menurut putusan hakim."
 },
 {
   "id": 2102,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 23,
   "firman": "Tetapi jika perempuan itu mendapat kecelakaan yang membawa maut, maka engkau harus memberikan nyawa ganti nyawa,"
 },
 {
   "id": 2103,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 24,
   "firman": "mata ganti mata, gigi ganti gigi, tangan ganti tangan, kaki ganti kaki,"
 },
 {
   "id": 2104,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 25,
   "firman": "lecur ganti lecur, luka ganti luka, bengkak ganti bengkak."
 },
 {
   "id": 2105,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 26,
   "firman": "Apabila seseorang memukul mata budaknya laki-laki atau mata budaknya perempuan dan merusakkannya, maka ia harus melepaskan budak itu sebagai orang merdeka pengganti kerusakan matanya itu."
 },
 {
   "id": 2106,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 27,
   "firman": "Dan jika ia menumbuk sampai tanggal gigi budaknya laki-laki atau gigi budaknya perempuan, maka ia harus melepaskan budak itu sebagai orang merdeka pengganti kehilangan giginya itu."
 },
 {
   "id": 2107,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 28,
   "firman": "Apabila seekor lembu menanduk seorang laki-laki atau perempuan, sehingga mati, maka pastilah lembu itu dilempari mati dengan batu dan dagingnya tidak boleh dimakan, tetapi pemilik lembu itu bebas dari hukuman."
 },
 {
   "id": 2108,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 29,
   "firman": "Tetapi jika lembu itu sejak dahulu telah sering menanduk dan pemiliknya telah diperingatkan, tetapi tidak mau menjaganya, kemudian lembu itu menanduk mati seorang laki-laki atau perempuan, maka lembu itu harus dilempari mati dengan batu, tetapi pemiliknyapun harus dihukum mati."
 },
 {
   "id": 2109,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 30,
   "firman": "Jika dibebankan kepadanya uang pendamaian, maka haruslah dibayarnya segala yang dibebankan kepadanya itu sebagai tebusan nyawanya."
 },
 {
   "id": 2110,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 31,
   "firman": "Kalau ditanduknya seorang anak laki-laki atau perempuan, maka pemiliknya harus diperlakukan menurut peraturan itu juga."
 },
 {
   "id": 2111,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 32,
   "firman": "Tetapi jika lembu itu menanduk seorang budak laki-laki atau perempuan, maka pemiliknya harus membayar tiga puluh syikal perak kepada tuan budak itu, dan lembu itu harus dilempari mati dengan batu."
 },
 {
   "id": 2112,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 33,
   "firman": "Apabila seseorang membuka sumur, atau apabila seseorang menggali sumur, dengan tidak menutupnya, dan seekor lembu atau keledai jatuh ke dalamnya,"
 },
 {
   "id": 2113,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 34,
   "firman": "maka pemilik sumur itu harus membayar ganti kerugian: ia harus mengganti harga binatang itu dengan uang kepada pemiliknya, tetapi binatang yang mati itu menjadi kepunyaannya."
 },
 {
   "id": 2114,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 35,
   "firman": "Apabila lembu seseorang menanduk lembu orang lain, sehingga mati, maka lembu yang hidup itu harus dijual, uangnya dibagi dan binatang yang mati itupun harus dibagi juga."
 },
 {
   "id": 2115,
   "kitab": "Kel",
   "pasal": 21,
   "ayat": 36,
   "firman": "Tetapi jikalau lembu itu terkenal telah sering menanduk sejak dahulu, dan walaupun demikian pemiliknya tidak mau menjaganya, maka ia harus membayar ganti kerugian sepenuhnya: lembu ganti lembu, tetapi binatang yang mati itu menjadi kepunyaannya.\""
 },
 {
   "id": 2116,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 1,
   "firman": "\"Apabila seseorang mencuri seekor lembu atau seekor domba dan membantainya atau menjualnya, maka ia harus membayar gantinya, yakni lima ekor lembu ganti lembu itu dan empat ekor domba ganti domba itu."
 },
 {
   "id": 2117,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 2,
   "firman": "Jika seorang pencuri kedapatan waktu membongkar, dan ia dipukul orang sehingga mati, maka si pemukul tidak berhutang darah;"
 },
 {
   "id": 2118,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 3,
   "firman": "tetapi jika pembunuhan itu terjadi setelah matahari terbit, maka ia berhutang darah. Pencuri itu harus membayar ganti kerugian sepenuhnya; jika ia orang yang tak punya, ia harus dijual ganti apa yang dicurinya itu."
 },
 {
   "id": 2119,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 4,
   "firman": "Jika yang dicurinya itu masih terdapat padanya dalam keadaan hidup, baik lembu, keledai atau domba, maka ia harus membayar ganti kerugian dua kali lipat."
 },
 {
   "id": 2120,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 5,
   "firman": "Apabila seseorang menggembalakan ternaknya di ladangnya atau di kebun anggurnya dan ternak itu dibiarkannya berjalan lepas, sehingga makan habis ladang orang lain, maka ia harus memberikan hasil yang terbaik dari ladangnya sendiri atau hasil yang terbaik dari kebun anggurnya sebagai ganti kerugian."
 },
 {
   "id": 2121,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 6,
   "firman": "Apabila ada api dinyalakan dan api itu menjilat semak duri, tetapi tumpukan gandum atau gandum yang belum dituai atau seluruh ladang itu ikut juga dimakan api, maka orang yang menyebabkan kebakaran itu harus membayar ganti kerugian sepenuhnya."
 },
 {
   "id": 2122,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 7,
   "firman": "Apabila seseorang menitipkan kepada temannya uang atau barang, dan itu dicuri dari rumah orang itu, maka jika pencuri itu terdapat, ia harus membayar ganti kerugian dua kali lipat."
 },
 {
   "id": 2123,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 8,
   "firman": "Jika pencuri itu tidak terdapat, maka tuan rumah harus pergi menghadap Allah untuk bersumpah, bahwa ia tidak mengulurkan tangannya mengambil harta kepunyaan temannya."
 },
 {
   "id": 2124,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 9,
   "firman": "Dalam tiap-tiap perkara pertengkaran harta, baik tentang seekor lembu, tentang seekor keledai, tentang seekor domba, tentang sehelai pakaian, baik tentang barang apapun yang kehilangan, kalau seorang mengatakan: Inilah kepunyaanku--maka perkara kedua orang itu harus dibawa ke hadapan Allah. Siapa yang dipersalahkan oleh Allah haruslah membayar kepada temannya ganti kerugian dua kali lipat."
 },
 {
   "id": 2125,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 10,
   "firman": "Apabila seseorang menitipkan kepada temannya seekor keledai atau lembu atau seekor domba atau binatang apapun dan binatang itu mati, atau patah kakinya atau dihalau orang dengan kekerasan, dengan tidak ada orang yang melihatnya,"
 },
 {
   "id": 2126,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 11,
   "firman": "maka sumpah di hadapan TUHAN harus menentukan di antara kedua orang itu, apakah ia tidak mengulurkan tangannya mengambil harta kepunyaan temannya, dan pemilik harus menerima sumpah itu, dan yang lain itu tidak usah membayar ganti kerugian."
 },
 {
   "id": 2127,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 12,
   "firman": "Tetapi jika binatang itu benar-benar dicuri orang dari padanya, maka ia harus membayar ganti kerugian kepada pemilik."
 },
 {
   "id": 2128,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 13,
   "firman": "Jika binatang itu benar-benar diterkam oleh binatang buas, maka ia harus membawanya sebagai bukti. Tidak usah ia membayar ganti binatang yang diterkam itu."
 },
 {
   "id": 2129,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 14,
   "firman": "Apabila seseorang meminjam seekor binatang dari temannya, dan binatang itu patah kakinya atau mati, ketika pemiliknya tidak ada di situ, maka ia harus membayar ganti kerugian sepenuhnya."
 },
 {
   "id": 2130,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 15,
   "firman": "Tetapi jika pemiliknya ada di situ, maka tidak usahlah ia membayar ganti kerugian. Jika binatang itu disewa, maka kerugian itu telah termasuk dalam sewa."
 },
 {
   "id": 2131,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 16,
   "firman": "Apabila seseorang membujuk seorang anak perawan yang belum bertunangan, dan tidur dengan dia, maka haruslah ia mengambilnya menjadi isterinya dengan membayar mas kawin."
 },
 {
   "id": 2132,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 17,
   "firman": "Jika ayah perempuan itu sungguh-sungguh menolak memberikannya kepadanya, maka ia harus juga membayar perak itu sepenuhnya, sebanyak mas kawin anak perawan.\""
 },
 {
   "id": 2133,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 18,
   "firman": "\"Seorang ahli sihir perempuan janganlah engkau biarkan hidup."
 },
 {
   "id": 2134,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 19,
   "firman": "Siapapun yang tidur dengan seekor binatang, pastilah ia dihukum mati."
 },
 {
   "id": 2135,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 20,
   "firman": "Siapa yang mempersembahkan korban kepada allah kecuali kepada TUHAN sendiri, haruslah ia ditumpas.\""
 },
 {
   "id": 2136,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 21,
   "firman": "\"Janganlah kautindas atau kautekan seorang orang asing, sebab kamupun dahulu adalah orang asing di tanah Mesir."
 },
 {
   "id": 2137,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 22,
   "firman": "Seseorang janda atau anak yatim janganlah kamu tindas."
 },
 {
   "id": 2138,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 23,
   "firman": "Jika engkau memang menindas mereka ini, tentulah Aku akan mendengarkan seruan mereka, jika mereka berseru-seru kepada-Ku dengan nyaring."
 },
 {
   "id": 2139,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 24,
   "firman": "Maka murka-Ku akan bangkit dan Aku akan membunuh kamu dengan pedang, sehingga isteri-isterimu menjadi janda dan anak-anakmu menjadi yatim."
 },
 {
   "id": 2140,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 25,
   "firman": "Jika engkau meminjamkan uang kepada salah seorang dari umat-Ku, orang yang miskin di antaramu, maka janganlah engkau berlaku sebagai seorang penagih hutang terhadap dia: janganlah kamu bebankan bunga uang kepadanya."
 },
 {
   "id": 2141,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 26,
   "firman": "Jika engkau sampai mengambil jubah temanmu sebagai gadai, maka haruslah engkau mengembalikannya kepadanya sebelum matahari terbenam,"
 },
 {
   "id": 2142,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 27,
   "firman": "sebab hanya itu saja penutup tubuhnya, itulah pemalut kulitnya--pakai apakah ia pergi tidur? Maka apabila ia berseru-seru kepada-Ku, Aku akan mendengarkannya, sebab Aku ini pengasih.\""
 },
 {
   "id": 2143,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 28,
   "firman": "\"Janganlah engkau mengutuki Allah dan janganlah engkau menyumpahi seorang pemuka di tengah-tengah bangsamu."
 },
 {
   "id": 2144,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 29,
   "firman": "Janganlah lalai mempersembahkan hasil gandummu dan hasil anggurmu. Yang sulung dari anak-anakmu lelaki haruslah kaupersembahkan kepada-Ku."
 },
 {
   "id": 2145,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 30,
   "firman": "Demikian juga harus kauperbuat dengan lembu sapimu dan dengan kambing dombamu: tujuh hari lamanya anak-anak binatang itu harus tinggal pada induknya, tetapi pada hari yang kedelapan haruslah kaupersembahkan binatang-binatang itu kepada-Ku."
 },
 {
   "id": 2146,
   "kitab": "Kel",
   "pasal": 22,
   "ayat": 31,
   "firman": "Haruslah kamu menjadi orang-orang kudus bagi-Ku: daging ternak yang diterkam di padang oleh binatang buas, janganlah kamu makan, tetapi haruslah kamu lemparkan kepada anjing.\""
 },
 {
   "id": 2147,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 1,
   "firman": "\"Janganlah engkau menyebarkan kabar bohong; janganlah engkau membantu orang yang bersalah dengan menjadi saksi yang tidak benar."
 },
 {
   "id": 2148,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 2,
   "firman": "Janganlah engkau turut-turut kebanyakan orang melakukan kejahatan, dan dalam memberikan kesaksian mengenai sesuatu perkara janganlah engkau turut-turut kebanyakan orang membelokkan hukum."
 },
 {
   "id": 2149,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 3,
   "firman": "Juga janganlah memihak kepada orang miskin dalam perkaranya."
 },
 {
   "id": 2150,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 4,
   "firman": "Apabila engkau melihat lembu musuhmu atau keledainya yang sesat, maka segeralah kaukembalikan binatang itu."
 },
 {
   "id": 2151,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 5,
   "firman": "Apabila engkau melihat rebah keledai musuhmu karena berat bebannya, maka janganlah engkau enggan menolongnya. Haruslah engkau rela menolong dia dengan membongkar muatan keledainya."
 },
 {
   "id": 2152,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 6,
   "firman": "Janganlah engkau memperkosa hak orang miskin di antaramu dalam perkaranya."
 },
 {
   "id": 2153,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 7,
   "firman": "Haruslah kaujauhkan dirimu dari perkara dusta. Orang yang tidak bersalah dan orang yang benar tidak boleh kaubunuh, sebab Aku tidak akan membenarkan orang yang bersalah."
 },
 {
   "id": 2154,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 8,
   "firman": "Suap janganlah kauterima, sebab suap membuat buta mata orang-orang yang melihat dan memutarbalikkan perkara orang-orang yang benar."
 },
 {
   "id": 2155,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 9,
   "firman": "Orang asing janganlah kamu tekan, karena kamu sendiri telah mengenal keadaan jiwa orang asing, sebab kamupun dahulu adalah orang asing di tanah Mesir."
 },
 {
   "id": 2156,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 10,
   "firman": "Enam tahunlah lamanya engkau menabur di tanahmu dan mengumpulkan hasilnya,"
 },
 {
   "id": 2157,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 11,
   "firman": "tetapi pada tahun ketujuh haruslah engkau membiarkannya dan meninggalkannya begitu saja, supaya orang miskin di antara bangsamu dapat makan, dan apa yang ditinggalkan mereka haruslah dibiarkan dimakan binatang hutan. Demikian juga kaulakukan dengan kebun anggurmu dan kebun zaitunmu."
 },
 {
   "id": 2158,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 12,
   "firman": "Enam harilah lamanya engkau melakukan pekerjaanmu, tetapi pada hari ketujuh haruslah engkau berhenti, supaya lembu dan keledaimu tidak bekerja dan supaya anak budakmu perempuan dan orang asing melepaskan lelah."
 },
 {
   "id": 2159,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 13,
   "firman": "Dalam segala hal yang Kufirmankan kepadamu haruslah kamu berawas-awas; nama allah lain janganlah kamu panggil, janganlah nama itu kedengaran dari mulutmu.\""
 },
 {
   "id": 2160,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 14,
   "firman": "\"Tiga kali setahun haruslah engkau mengadakan perayaan bagi-Ku."
 },
 {
   "id": 2161,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 15,
   "firman": "Hari raya Roti Tidak Beragi haruslah kaupelihara; tujuh hari lamanya engkau harus makan roti yang tidak beragi, seperti yang telah Kuperintahkan kepadamu, pada waktu yang ditetapkan dalam bulan Abib, sebab dalam bulan itulah engkau keluar dari Mesir, tetapi janganlah orang menghadap ke hadirat-Ku dengan tangan hampa."
 },
 {
   "id": 2162,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 16,
   "firman": "Kaupeliharalah juga hari raya menuai, yakni menuai buah bungaran dari hasil usahamu menabur di ladang; demikian juga hari raya pengumpulan hasil pada akhir tahun, apabila engkau mengumpulkan hasil usahamu dari ladang."
 },
 {
   "id": 2163,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 17,
   "firman": "Tiga kali setahun semua orangmu yang laki-laki harus menghadap ke hadirat Tuhanmu TUHAN."
 },
 {
   "id": 2164,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 18,
   "firman": "Janganlah kaupersembahkan darah korban sembelihan yang kepada-Ku beserta sesuatu yang beragi, dan janganlah lemak korban hari raya-Ku bermalam sampai pagi."
 },
 {
   "id": 2165,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 19,
   "firman": "Yang terbaik dari buah bungaran hasil tanahmu haruslah kaubawa ke dalam rumah TUHAN, Allahmu. Janganlah kaumasak anak kambing dalam susu induknya.\""
 },
 {
   "id": 2166,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 20,
   "firman": "\"Sesungguhnya Aku mengutus seorang malaikat berjalan di depanmu, untuk melindungi engkau di jalan dan untuk membawa engkau ke tempat yang telah Kusediakan."
 },
 {
   "id": 2167,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 21,
   "firman": "Jagalah dirimu di hadapannya dan dengarkanlah perkataannya, janganlah engkau mendurhaka kepadanya, sebab pelanggaranmu tidak akan diampuninya, sebab nama-Ku ada di dalam dia."
 },
 {
   "id": 2168,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 22,
   "firman": "Tetapi jika engkau sungguh-sungguh mendengarkan perkataannya, dan melakukan segala yang Kufirmankan, maka Aku akan memusuhi musuhmu, dan melawan lawanmu."
 },
 {
   "id": 2169,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 23,
   "firman": "Sebab malaikat-Ku akan berjalan di depanmu dan membawa engkau kepada orang Amori, orang Het, orang Feris, orang Kanaan, orang Hewi dan orang Yebus, dan Aku akan melenyapkan mereka."
 },
 {
   "id": 2170,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 24,
   "firman": "Janganlah engkau sujud menyembah kepada allah mereka atau beribadah kepadanya, dan janganlah engkau meniru perbuatan mereka, tetapi haruslah engkau memusnahkan sama sekali patung-patung berhala buatan mereka, dan tugu-tugu berhala mereka haruslah kauremukkan sama sekali."
 },
 {
   "id": 2171,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 25,
   "firman": "Tetapi kamu harus beribadah kepada TUHAN, Allahmu; maka Ia akan memberkati roti makananmu dan air minumanmu dan Aku akan menjauhkan penyakit dari tengah-tengahmu."
 },
 {
   "id": 2172,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 26,
   "firman": "Tidak akan ada di negerimu perempuan yang keguguran atau mandul. Aku akan menggenapkan tahun umurmu."
 },
 {
   "id": 2173,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 27,
   "firman": "Kengerian terhadap Aku akan Kukirimkan mendahului engkau: Aku akan mengacaukan semua orang yang kaudatangi, dan Aku akan membuat semua musuhmu lari membelakangi engkau."
 },
 {
   "id": 2174,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 28,
   "firman": "Lagi Aku akan melepaskan tabuhan mendahului engkau, sehingga binatang-binatang itu menghalau orang Hewi, orang Kanaan dan orang Het itu dari depanmu."
 },
 {
   "id": 2175,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 29,
   "firman": "Aku tidak akan menghalau mereka dari depanmu dalam satu tahun, supaya negeri itu jangan menjadi sepi, dan segala binatang hutan jangan bertambah banyak melebihi engkau."
 },
 {
   "id": 2176,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 30,
   "firman": "Sedikit demi sedikit Aku akan menghalau mereka dari depanmu, sampai engkau beranak cucu sedemikian, hingga engkau dapat memiliki negeri itu."
 },
 {
   "id": 2177,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 31,
   "firman": "Aku akan menentukan batas daerahmu dari Laut Teberau sampai Laut Filistin dan dari padang gurun sampai sungai Efrat, sebab Aku akan menyerahkan penduduk negeri itu ke dalam tanganmu, sehingga engkau menghalau mereka dari depanmu."
 },
 {
   "id": 2178,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 32,
   "firman": "Janganlah mengadakan perjanjian dengan mereka ataupun dengan allah mereka."
 },
 {
   "id": 2179,
   "kitab": "Kel",
   "pasal": 23,
   "ayat": 33,
   "firman": "Mereka tidak akan tetap diam di negerimu, supaya mereka jangan membuat engkau berdosa kepada-Ku, dengan beribadah kepada allah mereka, sebab tentulah hal itu menjadi jerat bagimu.\""
 },
 {
   "id": 2180,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 1,
   "firman": "Berfirmanlah Ia kepada Musa: \"Naiklah menghadap TUHAN, engkau dan Harun, Nadab dan Abihu dan tujuh puluh orang dari para tua-tua Israel dan sujudlah kamu menyembah dari jauh."
 },
 {
   "id": 2181,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 2,
   "firman": "Hanya Musa sendirilah yang mendekat kepada TUHAN, tetapi mereka itu tidak boleh mendekat, dan bangsa itu tidak boleh naik bersama-sama dengan dia.\""
 },
 {
   "id": 2182,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 3,
   "firman": "Lalu datanglah Musa dan memberitahukan kepada bangsa itu segala firman TUHAN dan segala peraturan itu, maka seluruh bangsa itu menjawab serentak: \"Segala firman yang telah diucapkan TUHAN itu, akan kami lakukan.\""
 },
 {
   "id": 2183,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 4,
   "firman": "Lalu Musa menuliskan segala firman TUHAN itu. Keesokan harinya pagi-pagi didirikannyalah mezbah di kaki gunung itu, dengan dua belas tugu sesuai dengan kedua belas suku Israel."
 },
 {
   "id": 2184,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 5,
   "firman": "Kemudian disuruhnyalah orang-orang muda dari bangsa Israel, maka mereka mempersembahkan korban bakaran dan menyembelih lembu-lembu jantan sebagai korban keselamatan kepada TUHAN."
 },
 {
   "id": 2185,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 6,
   "firman": "Sesudah itu Musa mengambil sebagian dari darah itu, lalu ditaruhnya ke dalam pasu, sebagian lagi dari darah itu disiramkannya pada mezbah itu."
 },
 {
   "id": 2186,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 7,
   "firman": "Diambilnyalah kitab perjanjian itu, lalu dibacakannya dengan didengar oleh bangsa itu dan mereka berkata: \"Segala firman TUHAN akan kami lakukan dan akan kami dengarkan.\""
 },
 {
   "id": 2187,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 8,
   "firman": "Kemudian Musa mengambil darah itu dan menyiramkannya pada bangsa itu serta berkata: \"Inilah darah perjanjian yang diadakan TUHAN dengan kamu, berdasarkan segala firman ini.\""
 },
 {
   "id": 2188,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 9,
   "firman": "Dan naiklah Musa dengan Harun, Nadab dan Abihu dan tujuh puluh orang dari para tua-tua Israel."
 },
 {
   "id": 2189,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 10,
   "firman": "Lalu mereka melihat Allah Israel; kaki-Nya berjejak pada sesuatu yang buatannya seperti lantai dari batu nilam dan yang terangnya seperti langit yang cerah."
 },
 {
   "id": 2190,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 11,
   "firman": "Tetapi kepada pemuka-pemuka orang Israel itu tidaklah diulurkan-Nya tangan-Nya; mereka memandang Allah, lalu makan dan minum."
 },
 {
   "id": 2191,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 12,
   "firman": "TUHAN berfirman kepada Musa: \"Naiklah menghadap Aku, ke atas gunung, dan tinggallah di sana, maka Aku akan memberikan kepadamu loh batu, yakni hukum dan perintah, yang telah Kutuliskan untuk diajarkan kepada mereka.\""
 },
 {
   "id": 2192,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 13,
   "firman": "Lalu bangunlah Musa dengan Yosua, abdinya, maka naiklah Musa ke atas gunung Allah itu."
 },
 {
   "id": 2193,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 14,
   "firman": "Tetapi kepada para tua-tua itu ia berkata: \"Tinggallah di sini menunggu kami, sampai kami kembali lagi kepadamu; bukankah Harun dan Hur ada bersama-sama dengan kamu, siapa yang ada perkaranya datanglah kepada mereka.\""
 },
 {
   "id": 2194,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 15,
   "firman": "Maka Musa mendaki gunung dan awan itu menutupinya."
 },
 {
   "id": 2195,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 16,
   "firman": "Kemuliaan TUHAN diam di atas gunung Sinai, dan awan itu menutupinya enam hari lamanya; pada hari ketujuh dipanggil-Nyalah Musa dari tengah-tengah awan itu."
 },
 {
   "id": 2196,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 17,
   "firman": "Tampaknya kemuliaan TUHAN sebagai api yang menghanguskan di puncak gunung itu pada pemandangan orang Israel."
 },
 {
   "id": 2197,
   "kitab": "Kel",
   "pasal": 24,
   "ayat": 18,
   "firman": "Masuklah Musa ke tengah-tengah awan itu dengan mendaki gunung itu. Lalu tinggallah ia di atas gunung itu empat puluh hari dan empat puluh malam lamanya."
 },
 {
   "id": 2198,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2199,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel, supaya mereka memungut bagi-Ku persembahan khusus; dari setiap orang yang terdorong hatinya, haruslah kamu pungut persembahan khusus kepada-Ku itu."
 },
 {
   "id": 2200,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 3,
   "firman": "Inilah persembahan khusus yang harus kamu pungut dari mereka: emas, perak, tembaga;"
 },
 {
   "id": 2201,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 4,
   "firman": "kain ungu tua, kain ungu muda, kain kirmizi, lenan halus, bulu kambing;"
 },
 {
   "id": 2202,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 5,
   "firman": "kulit domba jantan yang diwarnai merah, kulit lumba-lumba dan kayu penaga;"
 },
 {
   "id": 2203,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 6,
   "firman": "minyak untuk lampu, rempah-rempah untuk minyak urapan dan untuk ukupan dari wangi-wangian,"
 },
 {
   "id": 2204,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 7,
   "firman": "permata krisopras dan permata tatahan untuk baju efod dan untuk tutup dada."
 },
 {
   "id": 2205,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 8,
   "firman": "Dan mereka harus membuat tempat kudus bagi-Ku, supaya Aku akan diam di tengah-tengah mereka."
 },
 {
   "id": 2206,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 9,
   "firman": "Menurut segala apa yang Kutunjukkan kepadamu sebagai contoh Kemah Suci dan sebagai contoh segala perabotannya, demikianlah harus kamu membuatnya.\""
 },
 {
   "id": 2207,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 10,
   "firman": "\"Haruslah mereka membuat tabut dari kayu penaga, dua setengah hasta panjangnya, satu setengah hasta lebarnya dan satu setengah hasta tingginya."
 },
 {
   "id": 2208,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 11,
   "firman": "Haruslah engkau menyalutnya dengan emas murni; dari dalam dan dari luar engkau harus menyalutnya dan di atasnya harus kaubuat bingkai emas sekelilingnya."
 },
 {
   "id": 2209,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 12,
   "firman": "Haruslah engkau menuang empat gelang emas untuk tabut itu dan pasanglah gelang itu pada keempat penjurunya, yaitu dua gelang pada rusuknya yang satu dan dua gelang pada rusuknya yang kedua."
 },
 {
   "id": 2210,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 13,
   "firman": "Engkau harus membuat kayu pengusung dari kayu penaga dan menyalutnya dengan emas."
 },
 {
   "id": 2211,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 14,
   "firman": "Haruslah engkau memasukkan kayu pengusung itu ke dalam gelang yang ada pada rusuk tabut itu, supaya dengan itu tabut dapat diangkut."
 },
 {
   "id": 2212,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 15,
   "firman": "Kayu pengusung itu haruslah tetap tinggal dalam gelang itu, tidak boleh dicabut dari dalamnya."
 },
 {
   "id": 2213,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 16,
   "firman": "Dalam tabut itu haruslah kautaruh loh hukum, yang akan Kuberikan kepadamu."
 },
 {
   "id": 2214,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 17,
   "firman": "Juga engkau harus membuat tutup pendamaian dari emas murni, dua setengah hasta panjangnya dan satu setengah hasta lebarnya."
 },
 {
   "id": 2215,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 18,
   "firman": "Dan haruslah kaubuat dua kerub dari emas, kaubuatlah itu dari emas tempaan, pada kedua ujung tutup pendamaian itu."
 },
 {
   "id": 2216,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 19,
   "firman": "Buatlah satu kerub pada ujung sebelah sini dan satu kerub pada ujung sebelah sana; seiras dengan tutup pendamaian itu kamu buatlah kerub itu di atas kedua ujungnya."
 },
 {
   "id": 2217,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 20,
   "firman": "Kerub-kerub itu harus mengembangkan kedua sayapnya ke atas, sedang sayap-sayapnya menudungi tutup pendamaian itu dan mukanya menghadap kepada masing-masing; kepada tutup pendamaian itulah harus menghadap muka kerub-kerub itu."
 },
 {
   "id": 2218,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 21,
   "firman": "Haruslah kauletakkan tutup pendamaian itu di atas tabut dan dalam tabut itu engkau harus menaruh loh hukum, yang akan Kuberikan kepadamu."
 },
 {
   "id": 2219,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 22,
   "firman": "Dan di sanalah Aku akan bertemu dengan engkau dan dari atas tutup pendamaian itu, dari antara kedua kerub yang di atas tabut hukum itu, Aku akan berbicara dengan engkau tentang segala sesuatu yang akan Kuperintahkan kepadamu untuk disampaikan kepada orang Israel.\""
 },
 {
   "id": 2220,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 23,
   "firman": "\"Lagi haruslah engkau membuat meja dari kayu penaga, dua hasta panjangnya, sehasta lebarnya dan satu setengah hasta tingginya."
 },
 {
   "id": 2221,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 24,
   "firman": "Haruslah engkau menyalutnya dengan emas murni dan membuat bingkai emas sekelilingnya."
 },
 {
   "id": 2222,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 25,
   "firman": "Haruslah engkau membuat sekelilingnya jalur pinggir yang setapak tangan lebarnya dan kaubuatlah bingkai emas sekeliling jalur pinggirnya itu."
 },
 {
   "id": 2223,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 26,
   "firman": "Haruslah engkau membuat untuk meja itu empat gelang emas dan kaupasanglah gelang-gelang itu di keempat penjurunya, pada keempat kakinya."
 },
 {
   "id": 2224,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 27,
   "firman": "Gelang itu haruslah dekat ke jalur pinggirnya sebagai tempat memasukkan kayu pengusung, supaya meja itu dapat diangkut."
 },
 {
   "id": 2225,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 28,
   "firman": "Haruslah engkau membuat kayu pengusung itu dari kayu penaga dan menyalutnya dengan emas, dan dengan itulah meja harus diangkut."
 },
 {
   "id": 2226,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 29,
   "firman": "Haruslah engkau membuat pinggannya, cawannya, kendinya dan pialanya, yang dipakai untuk persembahan curahan; haruslah engkau membuat semuanya itu dari emas murni."
 },
 {
   "id": 2227,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 30,
   "firman": "Dan haruslah engkau tetap meletakkan roti sajian di atas meja itu di hadapan-Ku.\""
 },
 {
   "id": 2228,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 31,
   "firman": "\"Haruslah engkau membuat kandil dari emas murni; dari emas tempaan harus kandil itu dibuat, baik kakinya baik batangnya; kelopaknya--dengan tombolnya dan kembangnya--haruslah seiras dengan kandil itu."
 },
 {
   "id": 2229,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 32,
   "firman": "Enam cabang harus timbul dari sisinya: tiga cabang kandil itu dari sisi yang satu dan tiga cabang dari sisi yang lain."
 },
 {
   "id": 2230,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 33,
   "firman": "Tiga kelopak yang berupa bunga badam pada cabang yang satu--dengan tombol dan kembangnya--dan tiga kelopak yang serupa pada cabang yang lain--dengan tombol dan kembangnya--;demikianlah juga kaubuat keenam cabang yang timbul dari kandil itu."
 },
 {
   "id": 2231,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 34,
   "firman": "Pada kandil itu sendiri harus ada empat kelopak berupa bunga badam--dengan tombolnya dan kembangnya."
 },
 {
   "id": 2232,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 35,
   "firman": "Juga harus ada satu tombol di bawah sepasang cabang yang pertama, yang timbul dari kandil itu, dan satu tombol di bawah yang kedua, dan satu tombol di bawah yang ketiga; demikianlah juga kaubuat keenam cabang yang timbul dari kandil itu."
 },
 {
   "id": 2233,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 36,
   "firman": "Tombol dan cabang itu harus timbul dari kandil itu, dan semuanya itu haruslah dibuat dari sepotong emas tempaan yang murni."
 },
 {
   "id": 2234,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 37,
   "firman": "Haruslah kaubuat pada kandil itu tujuh lampu dan lampu-lampu itu haruslah dipasang di atas kandil itu, sehingga diterangi yang di depannya."
 },
 {
   "id": 2235,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 38,
   "firman": "Sepitnya dan penadahnya haruslah dari emas murni."
 },
 {
   "id": 2236,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 39,
   "firman": "Dari satu talenta emas murni haruslah dibuat kandil itu dengan segala perkakasnya itu."
 },
 {
   "id": 2237,
   "kitab": "Kel",
   "pasal": 25,
   "ayat": 40,
   "firman": "Dan ingatlah, bahwa engkau membuat semuanya itu menurut contoh yang telah ditunjukkan kepadamu di atas gunung itu.\""
 },
 {
   "id": 2238,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 1,
   "firman": "\"Kemah Suci itu haruslah kaubuat dari sepuluh tenda dari lenan halus yang dipintal benangnya dan dari kain ungu tua, kain ungu muda dan kain kirmizi; dengan ada kerubnya, buatan ahli tenun, haruslah kaubuat semuanya itu."
 },
 {
   "id": 2239,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 2,
   "firman": "Panjang tiap-tiap tenda haruslah dua puluh delapan hasta dan lebar tiap-tiap tenda empat hasta: segala tenda itu harus sama ukurannya."
 },
 {
   "id": 2240,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 3,
   "firman": "Lima dari tenda itu haruslah dirangkap menjadi satu, dan yang lima lagi juga harus dirangkap menjadi satu."
 },
 {
   "id": 2241,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 4,
   "firman": "Pada rangkapan yang pertama, di tepi satu tenda yang di ujung, haruslah engkau membuat sosok-sosok kain ungu tua dan demikian juga di tepi satu tenda yang paling ujung pada rangkapan yang kedua."
 },
 {
   "id": 2242,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 5,
   "firman": "Lima puluh sosok harus kaubuat pada tenda yang satu dan lima puluh sosok pada tenda yang di ujung pada rangkapan yang kedua, sehingga sosok-sosok itu tepat berhadapan satu sama lain."
 },
 {
   "id": 2243,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 6,
   "firman": "Dan haruslah engkau membuat lima puluh kaitan emas dan menyambung tenda-tenda Kemah Suci yang satu dengan yang lain dengan memakai kaitan itu, sehingga menjadi satu."
 },
 {
   "id": 2244,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 7,
   "firman": "Juga haruslah engkau membuat tenda-tenda dari bulu kambing menjadi atap kemah yang menudungi Kemah Suci, sebelas tenda harus kaubuat."
 },
 {
   "id": 2245,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 8,
   "firman": "Panjang tiap-tiap tenda harus tiga puluh hasta dan lebar tiap-tiap tenda empat hasta: yang sebelas tenda itu harus sama ukurannya."
 },
 {
   "id": 2246,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 9,
   "firman": "Lima dari tenda itu haruslah kausambung dengan tersendiri, dan enam dari tenda itu dengan tersendiri, dan tenda yang keenam haruslah kaulipat dua, di sebelah depan kemah itu."
 },
 {
   "id": 2247,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 10,
   "firman": "Haruslah engkau membuat lima puluh sosok pada rangkapan yang pertama di tepi satu tenda yang di ujung dan lima puluh sosok di tepi satu tenda pada rangkapan yang kedua."
 },
 {
   "id": 2248,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 11,
   "firman": "Haruslah engkau membuat lima puluh kaitan tembaga dan memasukkan kaitan itu ke dalam sosok-sosok dan menyambung tenda-tenda kemah itu, supaya menjadi satu."
 },
 {
   "id": 2249,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 12,
   "firman": "Mengenai bagian yang berjuntai itu, yang berlebih pada tenda kemah itu, haruslah setengah dari tenda yang berlebih itu berjuntai di sebelah belakang Kemah Suci."
 },
 {
   "id": 2250,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 13,
   "firman": "Sehasta di sebelah sini dan sehasta di sebelah sana pada bagian yang berlebih pada panjang tenda-tenda kemah itu haruslah berjuntai pada sisi-sisi Kemah Suci, di sebelah sini dan di sebelah sana untuk menudunginya."
 },
 {
   "id": 2251,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 14,
   "firman": "Juga haruslah engkau membuat untuk kemah itu tudung dari kulit domba jantan yang diwarnai merah, dan tudung dari kulit lumba-lumba di atasnya lagi."
 },
 {
   "id": 2252,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 15,
   "firman": "Haruslah engkau membuat untuk Kemah Suci papan dari kayu penaga yang berdiri tegak,"
 },
 {
   "id": 2253,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 16,
   "firman": "sepuluh hasta panjangnya satu papan dan satu setengah hasta lebarnya tiap-tiap papan."
 },
 {
   "id": 2254,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 17,
   "firman": "Tiap-tiap papan harus ada dua pasaknya yang disengkang satu sama lain; demikianlah harus kauperbuat dengan segala papan Kemah Suci."
 },
 {
   "id": 2255,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 18,
   "firman": "Haruslah engkau membuat papan-papan untuk Kemah Suci, dua puluh papan pada sebelah selatan."
 },
 {
   "id": 2256,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 19,
   "firman": "Dan haruslah kaubuat empat puluh alas perak di bawah kedua puluh papan itu, dua alas di bawah satu papan untuk kedua pasaknya, dan seterusnya dua alas di bawah setiap papan untuk kedua pasaknya."
 },
 {
   "id": 2257,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 20,
   "firman": "Juga untuk sisi yang kedua dari Kemah Suci, pada sebelah utara, kaubuatlah dua puluh papan"
 },
 {
   "id": 2258,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 21,
   "firman": "dengan empat puluh alas peraknya: dua alas di bawah satu papan dan seterusnya dua alas di bawah setiap papan."
 },
 {
   "id": 2259,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 22,
   "firman": "Untuk sisi belakang Kemah Suci, pada sebelah barat, haruslah kaubuat enam papan."
 },
 {
   "id": 2260,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 23,
   "firman": "Dua papan haruslah kaubuat untuk sudut Kemah Suci, di sisi belakang."
 },
 {
   "id": 2261,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 24,
   "firman": "Kedua papan itu haruslah kembar pasaknya di sebelah bawah dan seperti itu juga kembar pasaknya di sebelah atas, di dekat gelang yang satu itu; demikianlah harus kedua papan itu; haruslah itu merupakan kedua sudutnya."
 },
 {
   "id": 2262,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 25,
   "firman": "Jadi harus ada delapan papan dengan alas peraknya: enam belas alas; dua alas di bawah satu papan dan seterusnya dua alas di bawah setiap papan."
 },
 {
   "id": 2263,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 26,
   "firman": "Juga haruslah kaubuat kayu lintang dari kayu penaga: lima untuk papan-papan pada sisi yang satu dari Kemah Suci,"
 },
 {
   "id": 2264,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 27,
   "firman": "lima kayu lintang untuk papan-papan pada sisi yang kedua dari Kemah Suci, dan lima kayu lintang untuk papan-papan pada sisi Kemah Suci yang merupakan sisi belakangnya, pada sebelah barat."
 },
 {
   "id": 2265,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 28,
   "firman": "Dan kayu lintang yang di tengah, di tengah-tengah papan-papan itu, haruslah melintang terus dari ujung ke ujung."
 },
 {
   "id": 2266,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 29,
   "firman": "Papan-papan itu haruslah kausalut dengan emas, gelang-gelang itu haruslah kaubuat dari emas sebagai tempat memasukkan kayu-kayu lintang itu, dan kayu-kayu lintang itu haruslah kausalut dengan emas."
 },
 {
   "id": 2267,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 30,
   "firman": "Kemudian haruslah kaudirikan Kemah Suci sesuai dengan rancangan yang telah ditunjukkan kepadamu di atas gunung itu."
 },
 {
   "id": 2268,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 31,
   "firman": "Haruslah kaubuat tabir dari kain ungu tua, dan kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya; haruslah dibuat dengan ada kerubnya, buatan ahli tenun."
 },
 {
   "id": 2269,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 32,
   "firman": "Haruslah engkau menggantungkannya pada empat tiang dari kayu penaga, yang disalut dengan emas, dengan ada kaitannya dari emas, berdasarkan empat alas perak."
 },
 {
   "id": 2270,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 33,
   "firman": "Haruslah tabir itu kaugantungkan pada kaitan penyambung tenda itu dan haruslah kaubawa tabut hukum ke sana, ke belakang tabir itu, sehingga tabir itu menjadi pemisah bagimu antara tempat kudus dan tempat maha kudus."
 },
 {
   "id": 2271,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 34,
   "firman": "Tutup pendamaian itu haruslah kauletakkan di atas tabut hukum di dalam tempat maha kudus."
 },
 {
   "id": 2272,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 35,
   "firman": "Meja itu haruslah kautaruh di depan tabir itu, dan kandil itu berhadapan dengan meja itu pada sisi selatan dari Kemah Suci, dan meja itu haruslah kautempatkan pada sisi utara."
 },
 {
   "id": 2273,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 36,
   "firman": "Juga haruslah kaubuat tirai untuk pintu kemah itu dari kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya: tenunan yang berwarna-warna."
 },
 {
   "id": 2274,
   "kitab": "Kel",
   "pasal": 26,
   "ayat": 37,
   "firman": "Haruslah kaubuat lima tiang dari kayu penaga untuk tirai itu dan kausalutlah itu dengan emas, dengan ada kaitannya dari emas, dan untuk itu haruslah kautuang lima alas dari tembaga.\""
 },
 {
   "id": 2275,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 1,
   "firman": "\"Haruslah engkau membuat mezbah dari kayu penaga, lima hasta panjangnya dan lima hasta lebarnya, sehingga mezbah itu empat persegi, tetapi tiga hasta tingginya."
 },
 {
   "id": 2276,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 2,
   "firman": "Haruslah engkau membuat tanduk-tanduknya pada keempat sudutnya; tanduk-tanduknya itu haruslah seiras dengan mezbah itu dan haruslah engkau menyalutnya dengan tembaga."
 },
 {
   "id": 2277,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 3,
   "firman": "Juga harus engkau membuat kuali-kualinya tempat menaruh abunya, dan sodok-sodoknya dan bokor-bokor penyiramannya, garpu-garpunya dan perbaraan-perbaraannya; semua perkakasnya itu harus kaubuat dari tembaga."
 },
 {
   "id": 2278,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 4,
   "firman": "Haruslah engkau membuat untuk itu kisi-kisi, yakni jala-jala tembaga, dan pada jala-jala itu haruslah kaubuat empat gelang tembaga pada keempat ujungnya."
 },
 {
   "id": 2279,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 5,
   "firman": "Haruslah engkau memasang jala-jala itu di bawah jalur mezbah itu; mulai dari sebelah bawah, sehingga jala-jala itu sampai setengah tinggi mezbah itu."
 },
 {
   "id": 2280,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 6,
   "firman": "Haruslah engkau membuat kayu-kayu pengusung untuk mezbah itu, kayu-kayu pengusung dari kayu penaga dan menyalutnya dengan tembaga."
 },
 {
   "id": 2281,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 7,
   "firman": "Kayu-kayu pengusungnya itu haruslah dimasukkan ke dalam gelang-gelang itu dan kayu-kayu pengusung itu haruslah ada pada kedua rusuk mezbah itu waktu mezbah itu diangkut."
 },
 {
   "id": 2282,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 8,
   "firman": "Mezbah itu harus kaubuat berongga dan dari papan, seperti yang ditunjukkan kepadamu di atas gunung itu, demikianlah harus dibuat mezbah itu.\""
 },
 {
   "id": 2283,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 9,
   "firman": "\"Haruslah engkau membuat pelataran Kemah Suci; untuk pelataran itu pada sebelah selatan harus dibuat layar dari lenan halus yang dipintal benangnya, seratus hasta panjangnya pada sisi yang satu itu."
 },
 {
   "id": 2284,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 10,
   "firman": "Tiang-tiangnya harus ada dua puluh, dan alas-alas tiang itu harus dua puluh, dari tembaga, tetapi kaitan-kaitan tiang itu dan penyambung-penyambungnya harus dari perak."
 },
 {
   "id": 2285,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 11,
   "firman": "Demikian juga pada sebelah utara, pada panjangnya, harus ada layar yang seratus hasta panjangnya, tiang-tiangnya harus ada dua puluh dan alas-alas tiang itu harus dua puluh, dari tembaga, tetapi kaitan-kaitan tiang itu dan penyambung-penyambungnya harus dari perak."
 },
 {
   "id": 2286,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 12,
   "firman": "Dan pada lebar pelataran itu pada sebelah barat harus ada layar yang lima puluh hasta, dengan sepuluh tiangnya dan sepuluh alas tiang itu."
 },
 {
   "id": 2287,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 13,
   "firman": "Lebar pelataran itu, yaitu bagian muka pada sebelah timur harus lima puluh hasta,"
 },
 {
   "id": 2288,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 14,
   "firman": "yakni lima belas hasta layar untuk sisi yang satu di samping pintu gerbang itu, dengan tiga tiangnya dan tiga alas tiang itu;"
 },
 {
   "id": 2289,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 15,
   "firman": "dan juga untuk sisi yang kedua di samping pintu gerbang itu lima belas hasta layar, dengan tiga tiangnya dan tiga alas tiang itu;"
 },
 {
   "id": 2290,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 16,
   "firman": "tetapi untuk pintu gerbang pelataran itu tirai dua puluh hasta dari kain ungu tua dan kain ungu muda, kain kirmizi dan dari lenan halus yang dipintal benangnya--tenunan yang berwarna-warna--dengan empat tiangnya dan empat alas tiang itu."
 },
 {
   "id": 2291,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 17,
   "firman": "Segala tiang yang mengelilingi pelataran itu haruslah dihubungkan dengan penyambung-penyambung perak, dan kaitan-kaitannya harus dari perak dan alas-alasnya dari tembaga."
 },
 {
   "id": 2292,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 18,
   "firman": "Panjang pelataran itu harus seratus hasta, lebarnya lima puluh hasta dan tingginya lima hasta, dari lenan halus yang dipintal benangnya, dan alas-alasnya harus dari tembaga."
 },
 {
   "id": 2293,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 19,
   "firman": "Adapun segala perabotan untuk seluruh perlengkapan Kemah Suci, dan juga segala patoknya dan segala patok pelataran: semuanya harus dari tembaga.\""
 },
 {
   "id": 2294,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 20,
   "firman": "\"Haruslah kauperintahkan kepada orang Israel, supaya mereka membawa kepadamu minyak zaitun tumbuk yang murni untuk lampu, supaya orang dapat memasang lampu agar tetap menyala."
 },
 {
   "id": 2295,
   "kitab": "Kel",
   "pasal": 27,
   "ayat": 21,
   "firman": "Di dalam Kemah Pertemuan di depan tabir yang menutupi tabut hukum, haruslah Harun dan anak-anaknya mengaturnya dari petang sampai pagi di hadapan TUHAN. Itulah suatu ketetapan yang berlaku untuk selama-lamanya bagi orang Israel turun-temurun.\""
 },
 {
   "id": 2296,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 1,
   "firman": "\"Engkau harus menyuruh abangmu Harun bersama-sama dengan anak-anaknya datang kepadamu, dari tengah-tengah orang Israel, untuk memegang jabatan imam bagi-Ku--Harun dan anak-anak Harun, yakni Nadab, Abihu, Eleazar dan Itamar."
 },
 {
   "id": 2297,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 2,
   "firman": "Haruslah engkau membuat pakaian kudus bagi Harun, abangmu, sebagai perhiasan kemuliaan."
 },
 {
   "id": 2298,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 3,
   "firman": "Haruslah engkau mengatakan kepada semua orang yang ahli, yang telah Kupenuhi dengan roh keahlian, membuat pakaian Harun, untuk menguduskan dia, supaya dipegangnya jabatan imam bagi-Ku."
 },
 {
   "id": 2299,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 4,
   "firman": "Inilah pakaian yang harus dibuat mereka: tutup dada, baju efod, gamis, kemeja yang ada raginya, serban dan ikat pinggang. Demikianlah mereka harus membuat pakaian kudus bagi Harun, abangmu, dan bagi anak-anaknya, supaya ia memegang jabatan imam bagi-Ku."
 },
 {
   "id": 2300,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 5,
   "firman": "Untuk itu haruslah mereka mengambil emas, kain ungu tua dan kain ungu muda, kain kirmizi dan lenan halus."
 },
 {
   "id": 2301,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 6,
   "firman": "Baju efod itu harus dibuat mereka dari emas, kain ungu tua dan kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya: buatan seorang ahli."
 },
 {
   "id": 2302,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 7,
   "firman": "Haruslah ada pada baju efod itu dua tutup bahu yang disambung kepadanya, pada kedua ujungnyalah harus baju efod itu disambung."
 },
 {
   "id": 2303,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 8,
   "firman": "Sabuk pengikat yang ada pada baju efod itu haruslah sama buatannya dan seiras dengan baju efod itu, yakni dari emas, kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya."
 },
 {
   "id": 2304,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 9,
   "firman": "Haruslah kauambil dua permata krisopras dan mengukirkan nama para anak Israel pada permata itu,"
 },
 {
   "id": 2305,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 10,
   "firman": "enam dari nama mereka itu pada permata yang pertama dan keenam nama lagi pada permata yang kedua, menurut urutan kelahirannya."
 },
 {
   "id": 2306,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 11,
   "firman": "Seperti buatan seorang pengasah permata, diukirkan seperti meterai, demikianlah harus kauukirkan pada kedua permata itu nama para anak Israel; dililit dengan ikat emas harus kaubuat permata itu."
 },
 {
   "id": 2307,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 12,
   "firman": "Kemudian haruslah kautaruh kedua permata itu pada kedua tutup bahu baju efod sebagai permata peringatan untuk mengingat orang Israel; maka ke hadapan TUHAN haruslah Harun membawa nama mereka di atas kedua tutup bahunya menjadi tanda peringatan."
 },
 {
   "id": 2308,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 13,
   "firman": "Haruslah kaubuat ikat emas"
 },
 {
   "id": 2309,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 14,
   "firman": "dan dua untai dari emas murni; sebagai utas haruslah kaubuat itu, yang buatannya sebagai tali berjalin dan haruslah kaupasang untai berjalin itu pada ikat itu."
 },
 {
   "id": 2310,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 15,
   "firman": "Haruslah engkau membuat tutup dada pernyataan keputusan: buatan seorang ahli. Buatannya sama dengan baju efod, demikianlah harus engkau membuatnya, yakni dari emas, kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya haruslah engkau membuatnya."
 },
 {
   "id": 2311,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 16,
   "firman": "Haruslah itu empat persegi, lipat dua, sejengkal panjangnya dan sejengkal lebarnya."
 },
 {
   "id": 2312,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 17,
   "firman": "Haruslah kautatah itu dengan permata tatahan, empat jajar permata: permata yaspis merah, krisolit, malakit, itulah jajar yang pertama;"
 },
 {
   "id": 2313,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 18,
   "firman": "jajar yang kedua: permata batu darah, lazurit, yaspis hijau;"
 },
 {
   "id": 2314,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 19,
   "firman": "jajar yang ketiga: permata ambar, akik, kecubung,"
 },
 {
   "id": 2315,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 20,
   "firman": "jajar yang keempat: permata pirus, krisopras dan nefrit. Dengan berikatkan emas, demikianlah permata-permata itu dalam tatahannya."
 },
 {
   "id": 2316,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 21,
   "firman": "Sesuai dengan nama para anak Israel, permata itu haruslah dua belas banyaknya; dan pada tiap-tiap permata haruslah ada, diukirkan seperti meterai, nama salah satu suku dari yang dua belas itu."
 },
 {
   "id": 2317,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 22,
   "firman": "Juga haruslah kaubuat untuk tutup dada itu untai berpilin, yang buatannya sebagai tali berjalin, dari emas murni."
 },
 {
   "id": 2318,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 23,
   "firman": "Juga haruslah kaubuat untuk tutup dada itu dua gelang emas dan kedua gelang itu harus kaupasang pada kedua ujung tutup dada."
 },
 {
   "id": 2319,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 24,
   "firman": "Haruslah kedua untai emas yang berjalin itu kaupasang pada kedua gelang itu, pada ujung tutup dada."
 },
 {
   "id": 2320,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 25,
   "firman": "Kedua ujung lain dari kedua untai berjalin itu haruslah kaupasang pada kedua ikat emas itu, demikianlah kaupasang pada tutup bahu baju efod, di sebelah depannya."
 },
 {
   "id": 2321,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 26,
   "firman": "Haruslah engkau membuat dua gelang emas dan membubuhnya pada kedua ujung tutup dada itu, pada pinggirnya yang sebelah dalam, yang berhadapan dengan baju efod."
 },
 {
   "id": 2322,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 27,
   "firman": "Juga haruslah engkau membuat dua gelang emas dan memasangnya pada kedua tutup bahu baju efod, di sebelah bawah pada bagian depan, dekat ke tempat persambungannya, di sebelah atas sabuk baju efod."
 },
 {
   "id": 2323,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 28,
   "firman": "Kemudian haruslah tutup dada itu dengan gelangnya diikatkan kepada gelang baju efod dengan memakai tali ungu tua, sehingga tetap di atas sabuk baju efod, dan tutup dada itu tidak dapat bergeser dari baju efod."
 },
 {
   "id": 2324,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 29,
   "firman": "Demikianlah di atas jantungnya harus dibawa Harun nama para anak Israel pada tutup dada pernyataan keputusan itu, apabila ia masuk ke dalam tempat kudus, supaya menjadi tanda peringatan yang tetap di hadapan TUHAN."
 },
 {
   "id": 2325,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 30,
   "firman": "Dan di dalam tutup dada pernyataan keputusan itu haruslah kautaruh Urim dan Tumim; haruslah itu di atas jantung Harun, apabila ia masuk menghadap TUHAN, dan Harun harus tetap membawa keputusan bagi orang Israel di atas jantungnya, di hadapan TUHAN."
 },
 {
   "id": 2326,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 31,
   "firman": "Haruslah kaubuat gamis baju efod dari kain ungu tua seluruhnya."
 },
 {
   "id": 2327,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 32,
   "firman": "Lehernya haruslah di tengah-tengahnya; lehernya itu harus mempunyai pinggir sekelilingnya, buatan tukang tenun, seperti leher baju zirah haruslah lehernya itu, supaya jangan koyak."
 },
 {
   "id": 2328,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 33,
   "firman": "Pada ujung gamis itu haruslah kaubuat buah delima dari kain ungu tua, kain ungu muda dan kain kirmizi, pada sekeliling ujung gamis itu, dan di antaranya berselang-seling giring-giring emas,"
 },
 {
   "id": 2329,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 34,
   "firman": "sehingga satu giring-giring emas dan satu buah delima selalu berselang-seling, pada ujung gamis itu."
 },
 {
   "id": 2330,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 35,
   "firman": "Haruslah gamis itu dipakai Harun, apabila ia menyelenggarakan kebaktian, dan bunyinya harus kedengaran, apabila ia masuk ke dalam tempat kudus di hadapan TUHAN dan apabila ia keluar pula, supaya ia jangan mati."
 },
 {
   "id": 2331,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 36,
   "firman": "Juga haruslah engkau membuat patam dari emas murni dan pada patam itu kauukirkanlah, diukirkan seperti meterai: Kudus bagi TUHAN."
 },
 {
   "id": 2332,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 37,
   "firman": "Haruslah patam itu engkau beri bertali ungu tua, dan haruslah itu dilekatkan pada serban, di sebelah depan serban itu."
 },
 {
   "id": 2333,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 38,
   "firman": "Patam itu haruslah ada pada dahi Harun, dan Harun harus menanggung akibat kesalahan terhadap segala yang dikuduskan oleh orang Israel, yakni terhadap segala persembahan kudusnya; maka haruslah patam itu tetap ada pada dahinya, sehingga TUHAN berkenan akan mereka."
 },
 {
   "id": 2334,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 39,
   "firman": "Haruslah engkau menenun kemeja dengan ada raginya, dari lenan halus, dan membuat serban dari lenan halus dan haruslah kaubuat ikat pinggang dari tenunan yang berwarna-warna."
 },
 {
   "id": 2335,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 40,
   "firman": "Juga bagi anak-anak Harun haruslah kaubuat kemeja-kemeja dan haruslah kaubuat ikat-ikat pinggang bagi mereka, dan destar-destar haruslah kaubuat bagi mereka untuk menjadi perhiasan kemuliaan."
 },
 {
   "id": 2336,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 41,
   "firman": "Maka semuanya itu haruslah kaukenakan kepada abangmu Harun bersama-sama dengan anak-anaknya, kemudian engkau harus mengurapi, mentahbiskan dan menguduskan mereka, sehingga mereka dapat memegang jabatan imam bagi-Ku."
 },
 {
   "id": 2337,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 42,
   "firman": "Buatlah celana-celana lenan bagi mereka untuk menutupi daging auratnya: celana itu haruslah dari pinggang sampai paha panjangnya."
 },
 {
   "id": 2338,
   "kitab": "Kel",
   "pasal": 28,
   "ayat": 43,
   "firman": "Harun dan anak-anaknya haruslah memakainya, apabila mereka masuk ke dalam Kemah Pertemuan atau apabila mereka datang ke mezbah untuk menyelenggarakan kebaktian di tempat kudus, supaya mereka jangan membawa kesalahan kepada dirinya, lalu mati. Itulah suatu ketetapan untuk selama-lamanya baginya dan bagi keturunannya.\""
 },
 {
   "id": 2339,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 1,
   "firman": "\"Inilah yang harus kaulakukan kepada mereka, untuk menguduskan mereka, supaya mereka memegang jabatan imam bagi-Ku: Ambillah seekor lembu jantan muda dan dua ekor domba jantan yang tidak bercela,"
 },
 {
   "id": 2340,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 2,
   "firman": "roti yang tidak beragi dan roti bundar yang tidak beragi, yang diolah dengan minyak, dan roti tipis yang tidak beragi, yang diolesi dengan minyak; dari tepung gandum yang terbaik haruslah kaubuat semuanya itu."
 },
 {
   "id": 2341,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 3,
   "firman": "Kautaruhlah semuanya dalam sebuah bakul dan kaupersembahkanlah semuanya dalam bakul itu, demikian juga lembu jantan dan kedua domba jantan itu."
 },
 {
   "id": 2342,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 4,
   "firman": "Lalu kausuruhlah Harun dan anak-anaknya datang ke pintu Kemah Pertemuan dan haruslah engkau membasuh mereka dengan air."
 },
 {
   "id": 2343,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 5,
   "firman": "Kemudian kauambillah pakaian itu, lalu kaukenakanlah kepada Harun kemeja, gamis baju efod, dan baju efod serta tutup dada; kaukebatkanlah sabuk baju efod kepadanya;"
 },
 {
   "id": 2344,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 6,
   "firman": "kautaruhlah serban di kepalanya dan jamang yang kudus kaububuh pada serban itu."
 },
 {
   "id": 2345,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 7,
   "firman": "Sesudah itu kauambillah minyak urapan dan kautuang ke atas kepalanya, dan kauurapilah dia."
 },
 {
   "id": 2346,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 8,
   "firman": "Kausuruhlah anak-anaknya mendekat dan kaukenakanlah kemeja-kemeja itu kepada mereka."
 },
 {
   "id": 2347,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 9,
   "firman": "Kauikatkanlah ikat pinggang kepada mereka, kepada Harun dan anak-anaknya, dan kaulilitkanlah destar itu kepada kepala mereka, maka merekalah yang akan memegang jabatan imam; itulah suatu ketetapan untuk selama-lamanya. Demikianlah engkau harus mentahbiskan Harun dan anak-anaknya."
 },
 {
   "id": 2348,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 10,
   "firman": "Kemudian haruslah kaubawa lembu jantan itu ke depan Kemah Pertemuan, lalu haruslah Harun dan anak-anaknya meletakkan tangannya ke atas kepala lembu jantan itu."
 },
 {
   "id": 2349,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 11,
   "firman": "Haruslah kausembelih lembu jantan itu di hadapan TUHAN di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2350,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 12,
   "firman": "Haruslah kauambil sedikit dari darah lembu jantan itu dan kaububuh dengan jarimu pada tanduk-tanduk mezbah, dan segala darah selebihnya haruslah kaucurahkan pada bagian bawah mezbah."
 },
 {
   "id": 2351,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 13,
   "firman": "Kemudian kauambillah segala lemak yang menutupi isi perut, umbai hati, kedua buah pinggang dan segala lemak yang melekat padanya, dan kaubakarlah di atas mezbah."
 },
 {
   "id": 2352,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 14,
   "firman": "Tetapi daging lembu jantan itu, kulitnya dan kotorannya haruslah kaubakar habis dengan api di luar perkemahan, itulah korban penghapus dosa."
 },
 {
   "id": 2353,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 15,
   "firman": "Kemudian haruslah kauambil domba jantan yang satu, lalu haruslah Harun dan anak-anaknya meletakkan tangannya ke atas kepala domba jantan itu."
 },
 {
   "id": 2354,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 16,
   "firman": "Haruslah kausembelih domba jantan itu dan kauambillah darahnya dan kausiramkan pada mezbah sekelilingnya."
 },
 {
   "id": 2355,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 17,
   "firman": "Haruslah kaupotong-potong domba jantan itu menurut bagian-bagian tertentu, kaubasuhlah isi perutnya dan betis-betisnya dan kautaruh itu di atas potongan-potongannya dan di atas kepalanya."
 },
 {
   "id": 2356,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 18,
   "firman": "Kemudian haruslah kaubakar seluruh domba jantan itu di atas mezbah; itulah korban bakaran, suatu persembahan yang harum bagi TUHAN, yakni suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 2357,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 19,
   "firman": "Kemudian haruslah kauambil domba jantan yang lain, lalu haruslah Harun dan anak-anaknya meletakkan tangannya ke atas kepala domba jantan itu."
 },
 {
   "id": 2358,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 20,
   "firman": "Haruslah kausembelih domba jantan itu, kauambillah sedikit dari darahnya dan kaububuh pada cuping telinga kanan Harun dan pada cuping telinga kanan anak-anaknya, pada ibu jari tangan kanan dan pada ibu jari kaki kanan mereka, dan darah selebihnya kausiramkanlah pada mezbah sekelilingnya."
 },
 {
   "id": 2359,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 21,
   "firman": "Haruslah kauambil sedikit dari darah yang ada di atas mezbah dan dari minyak urapan itu dan kaupercikkanlah kepada Harun dan kepada pakaiannya, dan juga kepada anak-anaknya dan pada pakaian anak-anaknya; maka ia akan kudus, ia dan pakaiannya, dan juga anak-anaknya dan pakaian anak-anaknya."
 },
 {
   "id": 2360,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 22,
   "firman": "Dari domba jantan itu haruslah kauambil lemaknya, ekornya yang berlemak, lemak yang menutupi isi perutnya, umbai hatinya, kedua buah pinggangnya, lemak yang melekat padanya, paha kanannya--sebab itulah domba jantan persembahan pentahbisan--"
 },
 {
   "id": 2361,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 23,
   "firman": "kauambillah juga satu keping roti, satu roti bundar yang berminyak dan satu roti tipis dari dalam bakul berisi roti yang tidak beragi, yang ada di hadapan TUHAN."
 },
 {
   "id": 2362,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 24,
   "firman": "Haruslah kautaruh seluruhnya ke atas telapak tangan Harun dan ke atas telapak tangan anak-anaknya dan haruslah kaupersembahkan semuanya sebagai persembahan unjukan di hadapan TUHAN."
 },
 {
   "id": 2363,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 25,
   "firman": "Kemudian haruslah kauambil semuanya dari tangan mereka dan kaubakar di atas mezbah, yaitu di atas korban bakaran, sebagai persembahan yang harum di hadapan TUHAN; itulah suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 2364,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 26,
   "firman": "Selanjutnya haruslah kauambil dada dari domba jantan yang adalah bagi pentahbisan Harun dan kaupersembahkan sebagai persembahan unjukan di hadapan TUHAN, dan itulah bagian untukmu."
 },
 {
   "id": 2365,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 27,
   "firman": "Demikianlah harus kaukuduskan dada persembahan unjukan dan paha persembahan khusus yang dipersembahkan dari domba jantan yang adalah bagi pentahbisan Harun dan anak-anaknya."
 },
 {
   "id": 2366,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 28,
   "firman": "Itulah yang menjadi bagian untuk Harun dan anak-anaknya menurut ketetapan yang berlaku untuk selama-lamanya bagi orang Israel, sebab inilah suatu persembahan khusus, maka haruslah itu menjadi persembahan khusus dari pihak orang Israel, yang diambil dari korban keselamatan mereka, dan menjadi persembahan khusus mereka bagi TUHAN."
 },
 {
   "id": 2367,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 29,
   "firman": "Pakaian kudus kepunyaan Harun itu haruslah turun kepada anak-anaknya yang kemudian, supaya mereka memakainya apabila mereka diurapi dan ditahbiskan."
 },
 {
   "id": 2368,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 30,
   "firman": "Tujuh hari lamanya haruslah pakaian itu dikenakan oleh imam penggantinya dari antara anak-anaknya, yang akan masuk ke dalam Kemah Pertemuan untuk menyelenggarakan kebaktian di tempat kudus."
 },
 {
   "id": 2369,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 31,
   "firman": "Domba jantan persembahan pentahbisan itu haruslah kauambil dan dagingnya kaumasak pada suatu tempat yang kudus."
 },
 {
   "id": 2370,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 32,
   "firman": "Haruslah Harun dan anak-anaknya memakan daging domba jantan itu serta roti yang ada di dalam bakul di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2371,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 33,
   "firman": "Haruslah mereka memakan semuanya itu yang dipakai untuk mengadakan pendamaian pada waktu mereka ditahbiskan dan dikuduskan, tetapi orang awam janganlah memakannya, sebab persembahan kudus semuanya itu."
 },
 {
   "id": 2372,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 34,
   "firman": "Jika ada yang tinggal dari daging persembahan pentahbisan dan dari roti itu sampai pagi, haruslah kaubakar habis yang tinggal itu dengan api, janganlah dimakan, sebab persembahan kudus semuanya itu."
 },
 {
   "id": 2373,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 35,
   "firman": "Maka haruslah kauperbuat demikian kepada Harun dan kepada anak-anaknya, tepat seperti yang Kuperintahkan kepadamu; selama tujuh hari haruslah kautahbiskan mereka."
 },
 {
   "id": 2374,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 36,
   "firman": "Tiap-tiap hari haruslah engkau mengolah seekor lembu jantan menjadi korban penghapus dosa untuk mengadakan pendamaian dan haruslah kausucikan mezbah itu, dengan mengadakan pendamaian baginya; haruslah engkau mengurapinya untuk menguduskannya."
 },
 {
   "id": 2375,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 37,
   "firman": "Tujuh hari lamanya haruslah engkau mengadakan pendamaian bagi mezbah itu; haruslah engkau menguduskannya, maka mezbah itu akan menjadi maha kudus; setiap orang yang kena kepada mezbah itu akan menjadi kudus.\""
 },
 {
   "id": 2376,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 38,
   "firman": "\"Inilah yang harus kauolah di atas mezbah itu: dua anak domba berumur setahun, tetap tiap-tiap hari."
 },
 {
   "id": 2377,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 39,
   "firman": "Domba yang satu haruslah kauolah pada waktu pagi dan domba yang lain kauolah pada waktu senja."
 },
 {
   "id": 2378,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 40,
   "firman": "Dan beserta domba yang satu kauolah sepersepuluh efa tepung yang terbaik dengan minyak tumbuk seperempat hin, dan korban curahan dari seperempat hin anggur."
 },
 {
   "id": 2379,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 41,
   "firman": "Domba yang lain haruslah kauolah pada waktu senja; sama seperti korban sajian dan korban curahannya pada waktu pagi harus engkau mengolahnya sebagai persembahan yang harum, suatu korban api-apian bagi TUHAN,"
 },
 {
   "id": 2380,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 42,
   "firman": "suatu korban bakaran yang tetap di antara kamu turun-temurun, di depan pintu Kemah Pertemuan di hadapan TUHAN. Sebab di sana Aku akan bertemu dengan kamu, untuk berfirman kepadamu."
 },
 {
   "id": 2381,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 43,
   "firman": "Di sanalah Aku akan bertemu dengan orang Israel, dan tempat itu akan dikuduskan oleh kemuliaan-Ku."
 },
 {
   "id": 2382,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 44,
   "firman": "Aku akan menguduskan Kemah Pertemuan dan mezbah itu, lalu Harun dan anak-anaknya akan Kukuduskan supaya mereka memegang jabatan imam bagi-Ku."
 },
 {
   "id": 2383,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 45,
   "firman": "Aku akan diam di tengah-tengah orang Israel dan Aku akan menjadi Allah mereka."
 },
 {
   "id": 2384,
   "kitab": "Kel",
   "pasal": 29,
   "ayat": 46,
   "firman": "Maka mereka akan mengetahui, bahwa Akulah, TUHAN, Allah mereka, yang telah membawa mereka keluar dari tanah Mesir, supaya Aku diam di tengah-tengah mereka; Akulah TUHAN, Allah mereka.\""
 },
 {
   "id": 2385,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 1,
   "firman": "\"Haruslah kaubuat mezbah, tempat pembakaran ukupan; haruslah kaubuat itu dari kayu penaga;"
 },
 {
   "id": 2386,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 2,
   "firman": "sehasta panjangnya dan sehasta lebarnya, sehingga menjadi empat persegi, tetapi haruslah dua hasta tingginya; tanduk-tanduknya haruslah seiras dengan mezbah itu."
 },
 {
   "id": 2387,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 3,
   "firman": "Haruslah kausalut itu dengan emas murni, bidang atasnya dan bidang-bidang sisinya sekelilingnya, serta tanduk-tanduknya. Haruslah kaubuat bingkai emas sekelilingnya."
 },
 {
   "id": 2388,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 4,
   "firman": "Haruslah kaubuat dua gelang emas untuk mezbah itu di bawah bingkainya; pada kedua rusuknya haruslah kaubuat gelang itu, pada kedua bidang sisinya, dan haruslah gelang itu menjadi tempat memasukkan kayu pengusung, supaya dengan itu mezbah dapat diangkut."
 },
 {
   "id": 2389,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 5,
   "firman": "Haruslah kaubuat kayu pengusung itu dari kayu penaga dan kausalutlah dengan emas."
 },
 {
   "id": 2390,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 6,
   "firman": "Haruslah kautaruh tempat pembakaran itu di depan tabir penutup tabut hukum, di depan tutup pendamaian yang di atas loh hukum, di mana Aku akan bertemu dengan engkau."
 },
 {
   "id": 2391,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 7,
   "firman": "Di atasnya haruslah Harun membakar ukupan dari wangi-wangian; tiap-tiap pagi, apabila ia membersihkan lampu-lampu, haruslah ia membakarnya."
 },
 {
   "id": 2392,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 8,
   "firman": "Juga apabila Harun memasang lampu-lampu itu pada waktu senja, haruslah ia membakarnya sebagai ukupan yang tetap di hadapan TUHAN di antara kamu turun-temurun."
 },
 {
   "id": 2393,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 9,
   "firman": "Di atas mezbah itu janganlah kamu persembahkan ukupan yang lain ataupun korban bakaran ataupun korban sajian, juga korban curahan janganlah kamu curahkan di atasnya."
 },
 {
   "id": 2394,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 10,
   "firman": "Sekali setahun haruslah Harun mengadakan pendamaian di atas tanduk-tanduknya; dengan darah korban penghapus dosa pembawa pendamaian haruslah ia sekali setahun mengadakan pendamaian bagi mezbah itu di antara kamu turun-temurun; itulah barang maha kudus bagi TUHAN.\""
 },
 {
   "id": 2395,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 11,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2396,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 12,
   "firman": "\"Apabila engkau menghitung jumlah orang Israel pada waktu mereka didaftarkan, maka haruslah mereka masing-masing mempersembahkan kepada TUHAN uang pendamaian karena nyawanya, pada waktu orang mendaftarkan mereka, supaya jangan ada tulah di antara mereka pada waktu pendaftarannya itu."
 },
 {
   "id": 2397,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 13,
   "firman": "Inilah yang harus dipersembahkan tiap-tiap orang yang akan termasuk orang-orang yang terdaftar itu: setengah syikal, ditimbang menurut syikal kudus--syikal ini dua puluh gera beratnya--;setengah syikal itulah persembahan khusus kepada TUHAN."
 },
 {
   "id": 2398,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 14,
   "firman": "Setiap orang yang akan termasuk orang-orang yang terdaftar itu, yang berumur dua puluh tahun ke atas, haruslah mempersembahkan persembahan khusus itu kepada TUHAN."
 },
 {
   "id": 2399,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 15,
   "firman": "Orang kaya janganlah mempersembahkan lebih dan orang miskin janganlah mempersembahkan kurang dari setengah syikal itu pada waktu dipersembahkan persembahan khusus itu kepada TUHAN untuk mengadakan pendamaian bagi nyawa kamu sekalian."
 },
 {
   "id": 2400,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 16,
   "firman": "Dan haruslah engkau memungut uang pendamaian itu dari orang Israel dan menggunakannya untuk ibadah dalam Kemah Pertemuan; supaya itu menjadi peringatan di hadapan TUHAN untuk mengingat kepada orang Israel dan untuk mengadakan pendamaian bagi nyawa kamu sekalian.\""
 },
 {
   "id": 2401,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 17,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2402,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 18,
   "firman": "\"Haruslah engkau membuat bejana dan juga alasnya dari tembaga, untuk pembasuhan, dan kautempatkanlah itu antara Kemah Pertemuan dan mezbah, dan kautaruhlah air ke dalamnya."
 },
 {
   "id": 2403,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 19,
   "firman": "Maka Harun dan anak-anaknya haruslah membasuh tangan dan kaki mereka dengan air dari dalamnya."
 },
 {
   "id": 2404,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 20,
   "firman": "Apabila mereka masuk ke dalam Kemah Pertemuan, haruslah mereka membasuh tangan dan kaki dengan air, supaya mereka jangan mati. Demikian juga apabila mereka datang ke mezbah itu untuk menyelenggarakan kebaktian dan untuk membakar korban api-apian bagi TUHAN,"
 },
 {
   "id": 2405,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 21,
   "firman": "haruslah mereka membasuh tangan dan kaki mereka, supaya mereka jangan mati. Itulah yang harus menjadi ketetapan bagi mereka untuk selama-lamanya, bagi dia dan bagi keturunannya turun-temurun.\""
 },
 {
   "id": 2406,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 22,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2407,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 23,
   "firman": "\"Ambillah rempah-rempah pilihan, mur tetesan lima ratus syikal, dan kayu manis yang harum setengah dari itu, yakni dua ratus lima puluh syikal, dan tebu yang baik dua ratus lima puluh syikal,"
 },
 {
   "id": 2408,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 24,
   "firman": "dan kayu teja lima ratus syikal, ditimbang menurut syikal kudus, dan minyak zaitun satu hin."
 },
 {
   "id": 2409,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 25,
   "firman": "Haruslah kaubuat semuanya itu menjadi minyak urapan yang kudus, suatu campuran rempah-rempah yang dicampur dengan cermat seperti buatan seorang tukang campur rempah-rempah; itulah yang harus menjadi minyak urapan yang kudus."
 },
 {
   "id": 2410,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 26,
   "firman": "Haruslah engkau mengurapi dengan itu Kemah Pertemuan dan tabut hukum,"
 },
 {
   "id": 2411,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 27,
   "firman": "meja dengan segala perkakasnya, kandil dengan perkakasnya, dan mezbah pembakaran ukupan;"
 },
 {
   "id": 2412,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 28,
   "firman": "mezbah korban bakaran dengan segala perkakasnya, bejana pembasuhan dengan alasnya."
 },
 {
   "id": 2413,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 29,
   "firman": "Haruslah kaukuduskan semuanya, sehingga menjadi maha kudus; setiap orang yang kena kepadanya akan menjadi kudus."
 },
 {
   "id": 2414,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 30,
   "firman": "Engkau harus juga mengurapi dan menguduskan Harun dan anak-anaknya supaya mereka memegang jabatan imam bagi-Ku."
 },
 {
   "id": 2415,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 31,
   "firman": "Dan kepada orang Israel haruslah kaukatakan demikian: Inilah yang harus menjadi minyak urapan yang kudus bagi-Ku di antara kamu turun-temurun."
 },
 {
   "id": 2416,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 32,
   "firman": "Kepada badan orang biasa janganlah minyak itu dicurahkan, dan janganlah kaubuat minyak yang semacam itu dengan memakai campuran itu juga: itulah minyak yang kudus, dan haruslah itu kudus bagimu."
 },
 {
   "id": 2417,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 33,
   "firman": "Orang yang mencampur rempah-rempah menjadi minyak yang semacam itu atau yang membubuhnya pada badan orang awam, haruslah dilenyapkan dari antara bangsanya.\""
 },
 {
   "id": 2418,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 34,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Ambillah wangi-wangian, yakni getah damar, kulit lokan dan getah rasamala, wangi-wangian itu serta kemenyan yang tulen, masing-masing sama banyaknya."
 },
 {
   "id": 2419,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 35,
   "firman": "Semuanya ini haruslah kaubuat menjadi ukupan, suatu campuran rempah-rempah, seperti buatan seorang tukang campur rempah-rempah, digarami, murni, kudus."
 },
 {
   "id": 2420,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 36,
   "firman": "Sebagian dari ukupan itu haruslah kaugiling sampai halus, dan sedikit dari padanya kauletakkanlah di hadapan tabut hukum di dalam Kemah Pertemuan, di mana Aku akan bertemu dengan engkau; haruslah itu maha kudus bagimu."
 },
 {
   "id": 2421,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 37,
   "firman": "Dan tentang ukupan yang harus kaubuat menurut campuran yang seperti itu juga janganlah kamu buat bagi kamu sendiri; itulah bagian untuk TUHAN, yang kudus bagimu."
 },
 {
   "id": 2422,
   "kitab": "Kel",
   "pasal": 30,
   "ayat": 38,
   "firman": "Orang yang akan membuat minyak yang semacam itu dengan maksud untuk menghirup baunya, haruslah dilenyapkan dari antara bangsanya.\""
 },
 {
   "id": 2423,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2424,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 2,
   "firman": "\"Lihat, telah Kutunjuk Bezaleel bin Uri bin Hur, dari suku Yehuda,"
 },
 {
   "id": 2425,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 3,
   "firman": "dan telah Kupenuhi dia dengan Roh Allah, dengan keahlian dan pengertian dan pengetahuan, dalam segala macam pekerjaan,"
 },
 {
   "id": 2426,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 4,
   "firman": "untuk membuat berbagai rancangan supaya dikerjakan dari emas, perak dan tembaga;"
 },
 {
   "id": 2427,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 5,
   "firman": "untuk mengasah batu permata supaya ditatah; untuk mengukir kayu dan untuk bekerja dalam segala macam pekerjaan."
 },
 {
   "id": 2428,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 6,
   "firman": "Juga Aku telah menetapkan di sampingnya Aholiab bin Ahisamakh, dari suku Dan; dalam hati setiap orang ahli telah Kuberikan keahlian. Haruslah mereka membuat segala apa yang telah Kuperintahkan kepadamu:"
 },
 {
   "id": 2429,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 7,
   "firman": "Kemah Pertemuan, tabut untuk hukum, tutup pendamaian yang terletak di atasnya, dan segala perabotan kemah itu,"
 },
 {
   "id": 2430,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 8,
   "firman": "yakni meja dengan perkakasnya, kandil dari emas murni dengan segala perkakasnya, mezbah pembakaran ukupan,"
 },
 {
   "id": 2431,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 9,
   "firman": "mezbah korban bakaran dengan segala perkakasnya, bejana pembasuhan dengan alasnya,"
 },
 {
   "id": 2432,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 10,
   "firman": "pakaian jabatan, baik pakaian kudus kepunyaan imam Harun, maupun pakaian anak-anaknya, untuk memegang jabatan imam,"
 },
 {
   "id": 2433,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 11,
   "firman": "minyak urapan dan ukupan dari wangi-wangian untuk tempat kudus; tepat seperti yang telah Kuperintahkan kepadamu haruslah mereka membuat semuanya.\""
 },
 {
   "id": 2434,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 12,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2435,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 13,
   "firman": "\"Katakanlah kepada orang Israel, demikian: Akan tetapi hari-hari Sabat-Ku harus kamu pelihara, sebab itulah peringatan antara Aku dan kamu, turun-temurun, sehingga kamu mengetahui, bahwa Akulah TUHAN, yang menguduskan kamu."
 },
 {
   "id": 2436,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 14,
   "firman": "Haruslah kamu pelihara hari Sabat, sebab itulah hari kudus bagimu; siapa yang melanggar kekudusan hari Sabat itu, pastilah ia dihukum mati, sebab setiap orang yang melakukan pekerjaan pada hari itu, orang itu harus dilenyapkan dari antara bangsanya."
 },
 {
   "id": 2437,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 15,
   "firman": "Enam hari lamanya boleh dilakukan pekerjaan, tetapi pada hari yang ketujuh haruslah ada sabat, hari perhentian penuh, hari kudus bagi TUHAN: setiap orang yang melakukan pekerjaan pada hari Sabat, pastilah ia dihukum mati."
 },
 {
   "id": 2438,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 16,
   "firman": "Maka haruslah orang Israel memelihara hari Sabat, dengan merayakan sabat, turun-temurun, menjadi perjanjian kekal."
 },
 {
   "id": 2439,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 17,
   "firman": "Antara Aku dan orang Israel maka inilah suatu peringatan untuk selama-lamanya, sebab enam hari lamanya TUHAN menjadikan langit dan bumi, dan pada hari yang ketujuh Ia berhenti bekerja untuk beristirahat.\""
 },
 {
   "id": 2440,
   "kitab": "Kel",
   "pasal": 31,
   "ayat": 18,
   "firman": "Dan TUHAN memberikan kepada Musa, setelah Ia selesai berbicara dengan dia di gunung Sinai, kedua loh hukum Allah, loh batu, yang ditulisi oleh jari Allah."
 },
 {
   "id": 2441,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 1,
   "firman": "Ketika bangsa itu melihat, bahwa Musa mengundur-undurkan turun dari gunung itu, maka berkumpullah mereka mengerumuni Harun dan berkata kepadanya: \"Mari, buatlah untuk kami allah, yang akan berjalan di depan kami sebab Musa ini, orang yang telah memimpin kami keluar dari tanah Mesir--kami tidak tahu apa yang telah terjadi dengan dia.\""
 },
 {
   "id": 2442,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 2,
   "firman": "Lalu berkatalah Harun kepada mereka: \"Tanggalkanlah anting-anting emas yang ada pada telinga isterimu, anakmu laki-laki dan perempuan, dan bawalah semuanya kepadaku.\""
 },
 {
   "id": 2443,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 3,
   "firman": "Lalu seluruh bangsa itu menanggalkan anting-anting emas yang ada pada telinga mereka dan membawanya kepada Harun."
 },
 {
   "id": 2444,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 4,
   "firman": "Diterimanyalah itu dari tangan mereka, dibentuknya dengan pahat, dan dibuatnyalah dari padanya anak lembu tuangan. Kemudian berkatalah mereka: \"Hai Israel, inilah Allahmu, yang telah menuntun engkau keluar dari tanah Mesir!\""
 },
 {
   "id": 2445,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 5,
   "firman": "Ketika Harun melihat itu, didirikannyalah mezbah di depan anak lembu itu. Berserulah Harun, katanya: \"Besok hari raya bagi TUHAN!\""
 },
 {
   "id": 2446,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 6,
   "firman": "Dan keesokan harinya pagi-pagi maka mereka mempersembahkan korban bakaran dan korban keselamatan, sesudah itu duduklah bangsa itu untuk makan dan minum; kemudian bangunlah mereka dan bersukaria."
 },
 {
   "id": 2447,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 7,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah, turunlah, sebab bangsamu yang kaupimpin keluar dari tanah Mesir telah rusak lakunya."
 },
 {
   "id": 2448,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 8,
   "firman": "Segera juga mereka menyimpang dari jalan yang Kuperintahkan kepada mereka; mereka telah membuat anak lembu tuangan, dan kepadanya mereka sujud menyembah dan mempersembahkan korban, sambil berkata: Hai Israel, inilah Allahmu yang telah menuntun engkau keluar dari tanah Mesir.\""
 },
 {
   "id": 2449,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 9,
   "firman": "Lagi firman TUHAN kepada Musa: \"Telah Kulihat bangsa ini dan sesungguhnya mereka adalah suatu bangsa yang tegar tengkuk."
 },
 {
   "id": 2450,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 10,
   "firman": "Oleh sebab itu biarkanlah Aku, supaya murka-Ku bangkit terhadap mereka dan Aku akan membinasakan mereka, tetapi engkau akan Kubuat menjadi bangsa yang besar.\""
 },
 {
   "id": 2451,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 11,
   "firman": "Lalu Musa mencoba melunakkan hati TUHAN, Allahnya, dengan berkata: \"Mengapakah, TUHAN, murka-Mu bangkit terhadap umat-Mu, yang telah Kaubawa keluar dari tanah Mesir dengan kekuatan yang besar dan dengan tangan yang kuat?"
 },
 {
   "id": 2452,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 12,
   "firman": "Mengapakah orang Mesir akan berkata: Dia membawa mereka keluar dengan maksud menimpakan malapetaka kepada mereka dan membunuh mereka di gunung dan membinasakannya dari muka bumi? Berbaliklah dari murka-Mu yang bernyala-nyala itu dan menyesallah karena malapetaka yang hendak Kaudatangkan kepada umat-Mu."
 },
 {
   "id": 2453,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 13,
   "firman": "Ingatlah kepada Abraham, Ishak dan Israel, hamba-hamba-Mu itu, sebab kepada mereka Engkau telah bersumpah demi diri-Mu sendiri dengan berfirman kepada mereka: Aku akan membuat keturunanmu sebanyak bintang di langit, dan seluruh negeri yang telah Kujanjikan ini akan Kuberikan kepada keturunanmu, supaya dimilikinya untuk selama-lamanya.\""
 },
 {
   "id": 2454,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 14,
   "firman": "Dan menyesallah TUHAN karena malapetaka yang dirancangkan-Nya atas umat-Nya."
 },
 {
   "id": 2455,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 15,
   "firman": "Setelah itu berpalinglah Musa, lalu turun dari gunung dengan kedua loh hukum Allah dalam tangannya, loh-loh yang bertulis pada kedua sisinya; bertulis sebelah-menyebelah."
 },
 {
   "id": 2456,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 16,
   "firman": "Kedua loh itu ialah pekerjaan Allah dan tulisan itu ialah tulisan Allah, ditukik pada loh-loh itu."
 },
 {
   "id": 2457,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 17,
   "firman": "Ketika Yosua mendengar suara bangsa itu bersorak, berkatalah ia kepada Musa: \"Ada bunyi sorak peperangan kedengaran di perkemahan.\""
 },
 {
   "id": 2458,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 18,
   "firman": "Tetapi jawab Musa: \"Bukan bunyi nyanyian kemenangan, bukan bunyi nyanyian kekalahan--bunyi orang menyanyi berbalas-balasan, itulah yang kudengar.\""
 },
 {
   "id": 2459,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 19,
   "firman": "Dan ketika ia dekat ke perkemahan itu dan melihat anak lembu dan melihat orang menari-nari, maka bangkitlah amarah Musa; dilemparkannyalah kedua loh itu dari tangannya dan dipecahkannya pada kaki gunung itu."
 },
 {
   "id": 2460,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 20,
   "firman": "Sesudah itu diambilnyalah anak lembu yang dibuat mereka itu, dibakarnya dengan api dan digilingnya sampai halus, kemudian ditaburkannya ke atas air dan disuruhnya diminum oleh orang Israel."
 },
 {
   "id": 2461,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 21,
   "firman": "Lalu berkatalah Musa kepada Harun: \"Apakah yang dilakukan bangsa ini kepadamu, sehingga engkau mendatangkan dosa yang sebesar itu kepada mereka?\""
 },
 {
   "id": 2462,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 22,
   "firman": "Tetapi jawab Harun: \"Janganlah bangkit amarah tuanku; engkau sendiri tahu, bahwa bangsa ini jahat semata-mata."
 },
 {
   "id": 2463,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 23,
   "firman": "Mereka berkata kepadaku: Buatlah untuk kami allah, yang akan berjalan di depan kami sebab Musa ini, orang yang telah memimpin kami keluar dari tanah Mesir--kami tidak tahu apa yang telah terjadi dengan dia."
 },
 {
   "id": 2464,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 24,
   "firman": "Lalu aku berkata kepada mereka: Siapa yang empunya emas haruslah menanggalkannya. Mereka memberikannya kepadaku dan aku melemparkannya ke dalam api, dan keluarlah anak lembu ini.\""
 },
 {
   "id": 2465,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 25,
   "firman": "Ketika Musa melihat, bahwa bangsa itu seperti kuda terlepas dari kandang--sebab Harun telah melepaskannya, sampai menjadi buah cemooh bagi lawan mereka--"
 },
 {
   "id": 2466,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 26,
   "firman": "maka berdirilah Musa di pintu gerbang perkemahan itu serta berkata: \"Siapa yang memihak kepada TUHAN datanglah kepadaku!\" Lalu berkumpullah kepadanya seluruh bani Lewi."
 },
 {
   "id": 2467,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 27,
   "firman": "Berkatalah ia kepada mereka: \"Beginilah firman TUHAN, Allah Israel: Baiklah kamu masing-masing mengikatkan pedangnya pada pinggangnya dan berjalanlah kian ke mari melalui perkemahan itu dari pintu gerbang ke pintu gerbang, dan biarlah masing-masing membunuh saudaranya dan temannya dan tetangganya.\""
 },
 {
   "id": 2468,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 28,
   "firman": "Bani Lewi melakukan seperti yang dikatakan Musa dan pada hari itu tewaslah kira-kira tiga ribu orang dari bangsa itu."
 },
 {
   "id": 2469,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 29,
   "firman": "Kemudian berkatalah Musa: \"Baktikanlah dirimu mulai hari ini kepada TUHAN, masing-masing dengan membayarkan jiwa anaknya laki-laki dan saudaranya--yakni supaya kamu diberi berkat pada hari ini.\""
 },
 {
   "id": 2470,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 30,
   "firman": "Keesokan harinya berkatalah Musa kepada bangsa itu: \"Kamu ini telah berbuat dosa besar, tetapi sekarang aku akan naik menghadap TUHAN, mungkin aku akan dapat mengadakan pendamaian karena dosamu itu.\""
 },
 {
   "id": 2471,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 31,
   "firman": "Lalu kembalilah Musa menghadap TUHAN dan berkata: \"Ah, bangsa ini telah berbuat dosa besar, sebab mereka telah membuat allah emas bagi mereka."
 },
 {
   "id": 2472,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 32,
   "firman": "Tetapi sekarang, kiranya Engkau mengampuni dosa mereka itu--dan jika tidak, hapuskanlah kiranya namaku dari dalam kitab yang telah Kautulis.\""
 },
 {
   "id": 2473,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 33,
   "firman": "Tetapi TUHAN berfirman kepada Musa: \"Siapa yang berdosa kepada-Ku, nama orang itulah yang akan Kuhapuskan dari dalam kitab-Ku."
 },
 {
   "id": 2474,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 34,
   "firman": "Tetapi pergilah sekarang, tuntunlah bangsa itu ke tempat yang telah Kusebutkan kepadamu; akan berjalan malaikat-Ku di depanmu, tetapi pada hari pembalasan-Ku itu Aku akan membalaskan dosa mereka kepada mereka.\""
 },
 {
   "id": 2475,
   "kitab": "Kel",
   "pasal": 32,
   "ayat": 35,
   "firman": "Demikianlah TUHAN menulahi bangsa itu, karena mereka telah menyuruh membuat anak lembu buatan Harun itu."
 },
 {
   "id": 2476,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pergilah, berjalanlah dari sini, engkau dan bangsa itu yang telah kaupimpin keluar dari tanah Mesir, ke negeri yang telah Kujanjikan dengan sumpah kepada Abraham, Ishak dan Yakub, demikian: Kepada keturunanmulah akan Kuberikan negeri itu--"
 },
 {
   "id": 2477,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 2,
   "firman": "Aku akan mengutus seorang malaikat berjalan di depanmu dan akan menghalau orang Kanaan, orang Amori, orang Het, orang Feris, orang Hewi dan orang Yebus--"
 },
 {
   "id": 2478,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 3,
   "firman": "yakni ke suatu negeri yang berlimpah-limpah susu dan madu. Sebab Aku tidak akan berjalan di tengah-tengahmu, karena engkau ini bangsa yang tegar tengkuk, supaya Aku jangan membinasakan engkau di jalan.\""
 },
 {
   "id": 2479,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 4,
   "firman": "Ketika bangsa itu mendengar ancaman yang mengerikan ini, berkabunglah mereka dan seorangpun tidak ada yang memakai perhiasannya."
 },
 {
   "id": 2480,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 5,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Katakanlah kepada orang Israel: Kamu ini bangsa yang tegar tengkuk. Jika Aku berjalan di tengah-tengahmu sesaatpun, tentulah Aku akan membinasakan kamu. Oleh sebab itu, tanggalkanlah perhiasanmu, maka Aku akan melihat, apa yang akan Kulakukan kepadamu.\""
 },
 {
   "id": 2481,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 6,
   "firman": "Demikianlah orang Israel tidak memakai perhiasan-perhiasan lagi sejak dari gunung Horeb."
 },
 {
   "id": 2482,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 7,
   "firman": "Sesudah itu Musa mengambil kemah dan membentangkannya di luar perkemahan, jauh dari perkemahan, dan menamainya Kemah Pertemuan. Setiap orang yang mencari TUHAN, keluarlah ia pergi ke Kemah Pertemuan yang di luar perkemahan."
 },
 {
   "id": 2483,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 8,
   "firman": "Apabila Musa keluar pergi ke kemah itu, bangunlah seluruh bangsa itu dan berdirilah mereka, masing-masing di pintu kemahnya, dan mereka mengikuti Musa dengan matanya, sampai ia masuk ke dalam kemah."
 },
 {
   "id": 2484,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 9,
   "firman": "Apabila Musa masuk ke dalam kemah itu, turunlah tiang awan dan berhenti di pintu kemah dan berbicaralah TUHAN dengan Musa di sana."
 },
 {
   "id": 2485,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 10,
   "firman": "Setelah seluruh bangsa itu melihat, bahwa tiang awan berhenti di pintu kemah, maka mereka bangun dan sujud menyembah, masing-masing di pintu kemahnya."
 },
 {
   "id": 2486,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 11,
   "firman": "Dan TUHAN berbicara kepada Musa dengan berhadapan muka seperti seorang berbicara kepada temannya; kemudian kembalilah ia ke perkemahan. Tetapi abdinya, Yosua bin Nun, seorang yang masih muda, tidaklah meninggalkan kemah itu."
 },
 {
   "id": 2487,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 12,
   "firman": "Lalu berkatalah Musa kepada TUHAN: \"Memang Engkau berfirman kepadaku: Suruhlah bangsa ini berangkat, tetapi Engkau tidak memberitahukan kepadaku, siapa yang akan Kauutus bersama-sama dengan aku. Namun demikian Engkau berfirman: Aku mengenal namamu dan juga engkau mendapat kasih karunia di hadapan-Ku."
 },
 {
   "id": 2488,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 13,
   "firman": "Maka sekarang, jika aku kiranya mendapat kasih karunia di hadapan-Mu, beritahukanlah kiranya jalan-Mu kepadaku, sehingga aku mengenal Engkau, supaya aku tetap mendapat kasih karunia di hadapan-Mu. Ingatlah, bahwa bangsa ini umat-Mu.\""
 },
 {
   "id": 2489,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 14,
   "firman": "Lalu Ia berfirman: \"Aku sendiri hendak membimbing engkau dan memberikan ketenteraman kepadamu.\""
 },
 {
   "id": 2490,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 15,
   "firman": "Berkatalah Musa kepada-Nya: \"Jika Engkau sendiri tidak membimbing kami, janganlah suruh kami berangkat dari sini."
 },
 {
   "id": 2491,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 16,
   "firman": "Dari manakah gerangan akan diketahui, bahwa aku telah mendapat kasih karunia di hadapan-Mu, yakni aku dengan umat-Mu ini? Bukankah karena Engkau berjalan bersama-sama dengan kami, sehingga kami, aku dengan umat-Mu ini, dibedakan dari segala bangsa yang ada di muka bumi ini?\""
 },
 {
   "id": 2492,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 17,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Juga hal yang telah kaukatakan ini akan Kulakukan, karena engkau telah mendapat kasih karunia di hadapan-Ku dan Aku mengenal engkau.\""
 },
 {
   "id": 2493,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 18,
   "firman": "Tetapi jawabnya: \"Perlihatkanlah kiranya kemuliaan-Mu kepadaku.\""
 },
 {
   "id": 2494,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 19,
   "firman": "Tetapi firman-Nya: \"Aku akan melewatkan segenap kegemilangan-Ku dari depanmu dan menyerukan nama TUHAN di depanmu: Aku akan memberi kasih karunia kepada siapa yang Kuberi kasih karunia dan mengasihani siapa yang Kukasihani.\""
 },
 {
   "id": 2495,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 20,
   "firman": "Lagi firman-Nya: \"Engkau tidak tahan memandang wajah-Ku, sebab tidak ada orang yang memandang Aku dapat hidup.\""
 },
 {
   "id": 2496,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 21,
   "firman": "Berfirmanlah TUHAN: \"Ada suatu tempat dekat-Ku, di mana engkau dapat berdiri di atas gunung batu;"
 },
 {
   "id": 2497,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 22,
   "firman": "apabila kemuliaan-Ku lewat, maka Aku akan menempatkan engkau dalam lekuk gunung itu dan Aku akan menudungi engkau dengan tangan-Ku, sampai Aku berjalan lewat."
 },
 {
   "id": 2498,
   "kitab": "Kel",
   "pasal": 33,
   "ayat": 23,
   "firman": "Kemudian Aku akan menarik tangan-Ku dan engkau akan melihat belakang-Ku, tetapi wajah-Ku tidak akan kelihatan.\""
 },
 {
   "id": 2499,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Pahatlah dua loh batu sama dengan yang mula-mula, maka Aku akan menulis pada loh itu segala firman yang ada pada loh yang mula-mula, yang telah kaupecahkan."
 },
 {
   "id": 2500,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 2,
   "firman": "Bersiaplah menjelang pagi dan naiklah pada waktu pagi ke atas gunung Sinai; berdirilah di sana menghadap Aku di puncak gunung itu."
 },
 {
   "id": 2501,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 3,
   "firman": "Tetapi janganlah ada seorangpun yang naik bersama-sama dengan engkau dan juga seorangpun tidak boleh kelihatan di seluruh gunung itu, bahkan kambing domba dan lembu sapipun tidak boleh makan rumput di sekitar gunung itu.\""
 },
 {
   "id": 2502,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 4,
   "firman": "Lalu Musa memahat dua loh batu sama dengan yang mula-mula; bangunlah ia pagi-pagi dan naiklah ia ke atas gunung Sinai, seperti yang diperintahkan TUHAN kepadanya, dan membawa kedua loh batu itu di tangannya."
 },
 {
   "id": 2503,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 5,
   "firman": "Turunlah TUHAN dalam awan, lalu berdiri di sana dekat Musa serta menyerukan nama TUHAN."
 },
 {
   "id": 2504,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 6,
   "firman": "Berjalanlah TUHAN lewat dari depannya dan berseru: \"TUHAN, TUHAN, Allah penyayang dan pengasih, panjang sabar, berlimpah kasih-Nya dan setia-Nya,"
 },
 {
   "id": 2505,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 7,
   "firman": "yang meneguhkan kasih setia-Nya kepada beribu-ribu orang, yang mengampuni kesalahan, pelanggaran dan dosa; tetapi tidaklah sekali-kali membebaskan orang yang bersalah dari hukuman, yang membalaskan kesalahan bapa kepada anak-anaknya dan cucunya, kepada keturunan yang ketiga dan keempat.\""
 },
 {
   "id": 2506,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 8,
   "firman": "Segeralah Musa berlutut ke tanah, lalu sujud menyembah"
 },
 {
   "id": 2507,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 9,
   "firman": "serta berkata: \"Jika aku telah mendapat kasih karunia di hadapan-Mu, ya Tuhan, berjalanlah kiranya Tuhan di tengah-tengah kami; sekalipun bangsa ini suatu bangsa yang tegar tengkuk, tetapi ampunilah kesalahan dan dosa kami; ambillah kami menjadi milik-Mu.\""
 },
 {
   "id": 2508,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 10,
   "firman": "Firman-Nya: \"Sungguh, Aku mengadakan suatu perjanjian. Di depan seluruh bangsamu ini akan Kulakukan perbuatan-perbuatan yang ajaib, seperti yang belum pernah dijadikan di seluruh bumi di antara segala bangsa; seluruh bangsa, yang di tengah-tengahnya engkau diam, akan melihat perbuatan TUHAN, sebab apa yang akan Kulakukan dengan engkau, sungguh-sungguh dahsyat."
 },
 {
   "id": 2509,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 11,
   "firman": "Tetapi engkau, berpeganglah pada yang Kuperintahkan kepadamu pada hari ini. Lihat, Aku akan menghalau dari depanmu orang Amori, orang Kanaan, orang Het, orang Feris, orang Hewi dan orang Yebus."
 },
 {
   "id": 2510,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 12,
   "firman": "Berawas-awaslah, janganlah kauadakan perjanjian dengan penduduk negeri yang kaudatangi itu, supaya jangan mereka menjadi jerat bagimu di tengah-tengahmu."
 },
 {
   "id": 2511,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 13,
   "firman": "Sebaliknya, mezbah-mezbah mereka haruslah kamu rubuhkan, tugu-tugu berhala mereka kamu remukkan, dan tiang-tiang berhala mereka kamu tebang."
 },
 {
   "id": 2512,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 14,
   "firman": "Sebab janganlah engkau sujud menyembah kepada allah lain, karena TUHAN, yang nama-Nya Cemburuan, adalah Allah yang cemburu."
 },
 {
   "id": 2513,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 15,
   "firman": "Janganlah engkau sampai mengadakan perjanjian dengan penduduk negeri itu; apabila mereka berzinah dengan mengikuti allah mereka dan mempersembahkan korban kepada allah mereka, maka mereka akan mengundang engkau dan engkau akan ikut makan korban sembelihan mereka."
 },
 {
   "id": 2514,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 16,
   "firman": "Apabila engkau mengambil anak-anak perempuan mereka menjadi isteri anak-anakmu dan anak-anak perempuan itu akan berzinah dengan mengikuti allah mereka, maka mereka akan membujuk juga anak-anakmu laki-laki untuk berzinah dengan mengikuti allah mereka."
 },
 {
   "id": 2515,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 17,
   "firman": "Janganlah kaubuat bagimu allah tuangan."
 },
 {
   "id": 2516,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 18,
   "firman": "Hari raya Roti Tidak Beragi haruslah kaupelihara; tujuh hari lamanya engkau harus makan roti yang tidak beragi, seperti yang Kuperintahkan kepadamu, pada waktu yang ditetapkan dalam bulan Abib, sebab dalam bulan Abib itulah engkau keluar dari Mesir."
 },
 {
   "id": 2517,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 19,
   "firman": "Segala apa yang lahir terdahulu dari kandungan, Akulah yang empunya, juga segala ternakmu yang jantan, anak yang lahir terdahulu dari lembu atau domba."
 },
 {
   "id": 2518,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 20,
   "firman": "Tetapi anak yang lahir terdahulu dari keledai haruslah kautebus dengan seekor domba; jika tidak kautebus, haruslah kaupatahkan batang lehernya. Setiap yang sulung dari antara anak-anakmu haruslah kautebus, dan janganlah orang menghadap ke hadirat-Ku dengan tangan hampa."
 },
 {
   "id": 2519,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 21,
   "firman": "Enam harilah lamanya engkau bekerja, tetapi pada hari yang ketujuh haruslah engkau berhenti, dan dalam musim membajak dan musim menuai haruslah engkau memelihara hari perhentian juga."
 },
 {
   "id": 2520,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 22,
   "firman": "Hari raya Tujuh Minggu, yakni hari raya buah bungaran dari penuaian gandum, haruslah kaurayakan, juga hari raya pengumpulan hasil pada pergantian tahun."
 },
 {
   "id": 2521,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 23,
   "firman": "Tiga kali setahun segala orangmu yang laki-laki harus menghadap ke hadirat Tuhanmu TUHAN, Allah Israel,"
 },
 {
   "id": 2522,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 24,
   "firman": "sebab Aku akan menghalau bangsa-bangsa dari depanmu dan meluaskan daerahmu; dan tiada seorangpun yang akan mengingini negerimu, apabila engkau pergi untuk menghadap ke hadirat TUHAN, Allahmu, tiga kali setahun."
 },
 {
   "id": 2523,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 25,
   "firman": "Janganlah darah korban sembelihan yang kepada-Ku kaupersembahkan beserta sesuatu yang beragi, dan janganlah ada dari korban sembelihan pada hari raya Paskah bermalam sampai pagi."
 },
 {
   "id": 2524,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 26,
   "firman": "Yang terbaik dari buah bungaran hasil tanahmu haruslah kaubawa ke dalam rumah TUHAN, Allahmu. Janganlah engkau masak anak kambing dalam susu induknya.\""
 },
 {
   "id": 2525,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 27,
   "firman": "Berfirmanlah TUHAN kepada Musa: \"Tuliskanlah segala firman ini, sebab berdasarkan firman ini telah Kuadakan perjanjian dengan engkau dan dengan Israel.\""
 },
 {
   "id": 2526,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 28,
   "firman": "Dan Musa ada di sana bersama-sama dengan TUHAN empat puluh hari empat puluh malam lamanya, tidak makan roti dan tidak minum air, dan ia menuliskan pada loh itu segala perkataan perjanjian, yakni Kesepuluh Firman."
 },
 {
   "id": 2527,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 29,
   "firman": "Ketika Musa turun dari gunung Sinai--kedua loh hukum Allah ada di tangan Musa ketika ia turun dari gunung itu--tidaklah ia tahu, bahwa kulit mukanya bercahaya oleh karena ia telah berbicara dengan TUHAN."
 },
 {
   "id": 2528,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 30,
   "firman": "Ketika Harun dan segala orang Israel melihat Musa, tampak kulit mukanya bercahaya, maka takutlah mereka mendekati dia."
 },
 {
   "id": 2529,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 31,
   "firman": "Tetapi Musa memanggil mereka, maka Harun dan segala pemimpin jemaah itu berbalik kepadanya dan Musa berbicara kepada mereka."
 },
 {
   "id": 2530,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 32,
   "firman": "Sesudah itu mendekatlah segala orang Israel, lalu disampaikannyalah kepada mereka segala perintah yang diucapkan TUHAN kepadanya di atas gunung Sinai."
 },
 {
   "id": 2531,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 33,
   "firman": "Setelah Musa selesai berbicara dengan mereka, diselubunginyalah mukanya."
 },
 {
   "id": 2532,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 34,
   "firman": "Tetapi apabila Musa masuk menghadap TUHAN untuk berbicara dengan Dia, ditanggalkannyalah selubung itu sampai ia keluar; dan apabila ia keluar dikatakannyalah kepada orang Israel apa yang diperintahkan kepadanya."
 },
 {
   "id": 2533,
   "kitab": "Kel",
   "pasal": 34,
   "ayat": 35,
   "firman": "Apabila orang Israel melihat muka Musa, bahwa kulit muka Musa bercahaya, maka Musa menyelubungi mukanya kembali sampai ia masuk menghadap untuk berbicara dengan TUHAN."
 },
 {
   "id": 2534,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 1,
   "firman": "Lalu Musa menyuruh berkumpul segenap jemaah Israel dan berkata kepada mereka: \"Inilah firman yang diperintahkan TUHAN untuk dilakukan."
 },
 {
   "id": 2535,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 2,
   "firman": "Enam hari lamanya boleh dilakukan pekerjaan, tetapi pada hari yang ketujuh haruslah ada perhentian kudus bagimu, yakni sabat, hari perhentian penuh bagi TUHAN; setiap orang yang melakukan pekerjaan pada hari itu, haruslah dihukum mati."
 },
 {
   "id": 2536,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 3,
   "firman": "Janganlah kamu memasang api di manapun dalam tempat kediamanmu pada hari Sabat.\""
 },
 {
   "id": 2537,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 4,
   "firman": "Berkatalah Musa kepada segenap jemaah Israel: \"Inilah firman yang diperintahkan TUHAN, bunyinya:"
 },
 {
   "id": 2538,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 5,
   "firman": "Ambillah bagi TUHAN persembahan khusus dari barang kepunyaanmu; setiap orang yang terdorong hatinya harus membawanya sebagai persembahan khusus kepada TUHAN: emas, perak, tembaga,"
 },
 {
   "id": 2539,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 6,
   "firman": "kain ungu tua, kain ungu muda, kain kirmizi, lenan halus, bulu kambing;"
 },
 {
   "id": 2540,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 7,
   "firman": "kulit domba jantan yang diwarnai merah, kulit-kulit lumba-lumba, kayu penaga,"
 },
 {
   "id": 2541,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 8,
   "firman": "minyak untuk penerangan, rempah-rempah untuk minyak urapan dan untuk ukupan dari wangi-wangian,"
 },
 {
   "id": 2542,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 9,
   "firman": "permata krisopras dan permata tatahan untuk baju efod dan untuk tutup dada."
 },
 {
   "id": 2543,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 10,
   "firman": "Segala orang yang ahli di antara kamu haruslah datang untuk membuat segala yang diperintahkan TUHAN,"
 },
 {
   "id": 2544,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 11,
   "firman": "yakni Kemah Suci, atap kemahnya dan tudungnya, kaitannya, dan papannya, kayu lintangnya, tiangnya dan alasnya;"
 },
 {
   "id": 2545,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 12,
   "firman": "tabut dengan kayu pengusungnya, tutup pendamaian dan tabir penudung;"
 },
 {
   "id": 2546,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 13,
   "firman": "meja dengan kayu pengusungnya, segala perkakasnya dan roti sajian;"
 },
 {
   "id": 2547,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 14,
   "firman": "kandil untuk penerangan dengan perkakasnya, lampunya dan minyak untuk penerangan;"
 },
 {
   "id": 2548,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 15,
   "firman": "mezbah pembakaran ukupan dengan kayu pengusungnya, minyak urapan dan ukupan dari wangi-wangian; tirai pintu untuk pintu Kemah Suci;"
 },
 {
   "id": 2549,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 16,
   "firman": "mezbah korban bakaran dengan kisi-kisi tembaganya, kayu pengusungnya dan segala perkakasnya, bejana pembasuhan dengan alasnya;"
 },
 {
   "id": 2550,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 17,
   "firman": "layar pelataran, tiangnya, alasnya dan tirai pintu gerbang pelataran itu;"
 },
 {
   "id": 2551,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 18,
   "firman": "patok Kemah Suci dan patok pelataran dan talinya;"
 },
 {
   "id": 2552,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 19,
   "firman": "pakaian jabatan untuk menyelenggarakan kebaktian di tempat kudus, dan pakaian kudus bagi imam Harun, dan pakaian anak-anaknya untuk memegang jabatan imam.\""
 },
 {
   "id": 2553,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 20,
   "firman": "Lalu pergilah segenap jemaah Israel dari depan Musa."
 },
 {
   "id": 2554,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 21,
   "firman": "Sesudah itu datanglah setiap orang yang tergerak hatinya, setiap orang yang terdorong jiwanya, membawa persembahan khusus kepada TUHAN untuk pekerjaan melengkapi Kemah Pertemuan dan untuk segala ibadah di dalamnya dan untuk pakaian kudus itu."
 },
 {
   "id": 2555,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 22,
   "firman": "Maka datanglah mereka, baik laki-laki maupun perempuan, setiap orang yang terdorong hatinya, dengan membawa anting-anting hidung, anting-anting telinga, cincin meterai dan kerongsang, segala macam barang emas; demikian juga setiap orang yang mempersembahkan persembahan unjukan dari emas bagi TUHAN."
 },
 {
   "id": 2556,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 23,
   "firman": "Juga setiap orang yang mempunyai kain ungu tua, kain ungu muda, kain kirmizi, lenan halus, bulu kambing, kulit domba jantan yang diwarnai merah dan kulit lumba-lumba, datang membawanya."
 },
 {
   "id": 2557,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 24,
   "firman": "Setiap orang yang hendak mempersembahkan persembahan khusus dari perak atau tembaga, membawa persembahan khusus yang kepada TUHAN itu, dan setiap orang yang mempunyai kayu penaga membawanya juga untuk segala pekerjaan mendirikan itu."
 },
 {
   "id": 2558,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 25,
   "firman": "Setiap perempuan yang ahli, memintal dengan tangannya sendiri dan membawa yang dipintalnya itu, yakni kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus."
 },
 {
   "id": 2559,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 26,
   "firman": "Semua perempuan yang tergerak hatinya oleh karena ia berkeahlian, memintal bulu kambing."
 },
 {
   "id": 2560,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 27,
   "firman": "Pemimpin-pemimpin membawa permata krisopras dan permata tatahan untuk baju efod dan untuk tutup dada,"
 },
 {
   "id": 2561,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 28,
   "firman": "rempah-rempah dan minyak untuk penerangan, untuk minyak urapan dan untuk ukupan dari wangi-wangian."
 },
 {
   "id": 2562,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 29,
   "firman": "Semua laki-laki dan perempuan, yang terdorong hatinya akan membawa sesuatu untuk segala pekerjaan yang diperintahkan TUHAN dengan perantaraan Musa untuk dilakukan--mereka itu, yakni orang Israel, membawanya sebagai pemberian sukarela bagi TUHAN."
 },
 {
   "id": 2563,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 30,
   "firman": "Berkatalah Musa kepada orang Israel: \"Lihatlah, TUHAN telah menunjuk Bezaleel bin Uri bin Hur, dari suku Yehuda,"
 },
 {
   "id": 2564,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 31,
   "firman": "dan telah memenuhinya dengan Roh Allah, dengan keahlian, pengertian dan pengetahuan, dalam segala macam pekerjaan,"
 },
 {
   "id": 2565,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 32,
   "firman": "yakni untuk membuat berbagai rancangan supaya dikerjakan dari emas, perak dan tembaga;"
 },
 {
   "id": 2566,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 33,
   "firman": "untuk mengasah batu permata supaya ditatah; untuk mengukir kayu dan untuk bekerja dalam segala macam pekerjaan yang dirancang itu."
 },
 {
   "id": 2567,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 34,
   "firman": "Dan TUHAN menanam dalam hatinya, dan dalam hati Aholiab bin Ahisamakh dari suku Dan, kepandaian untuk mengajar."
 },
 {
   "id": 2568,
   "kitab": "Kel",
   "pasal": 35,
   "ayat": 35,
   "firman": "Ia telah memenuhi mereka dengan keahlian, untuk membuat segala macam pekerjaan seorang tukang, pekerjaan seorang ahli, pekerjaan seorang yang membuat tenunan yang berwarna-warna dari kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus, dan pekerjaan seorang tukang tenun, yakni sebagai pelaksana segala macam pekerjaan dan perancang segala sesuatu."
 },
 {
   "id": 2569,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 1,
   "firman": "Demikianlah harus bekerja Bezaleel dan Aholiab, dan setiap orang yang ahli, yang telah dikaruniai TUHAN keahlian dan pengertian, sehingga ia tahu melakukan segala macam pekerjaan untuk mendirikan tempat kudus, tepat menurut yang diperintahkan TUHAN.\""
 },
 {
   "id": 2570,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 2,
   "firman": "Lalu Musa memanggil Bezaleel dan Aholiab dan setiap orang yang ahli, yang dalam hatinya telah ditanam TUHAN keahlian, setiap orang yang tergerak hatinya untuk datang melakukan pekerjaan itu."
 },
 {
   "id": 2571,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 3,
   "firman": "Mereka menerima dari pada Musa seluruh persembahan khusus, yang telah dibawa oleh orang Israel untuk melaksanakan pekerjaan mendirikan tempat kudus. Tetapi orang Israel itu masih terus membawa pemberian sukarela kepada Musa tiap-tiap pagi."
 },
 {
   "id": 2572,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 4,
   "firman": "Dan segala orang ahli yang melakukan seluruh pekerjaan untuk tempat kudus itu, datanglah masing-masing dari pekerjaan yang dilakukannya,"
 },
 {
   "id": 2573,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 5,
   "firman": "dan berkata kepada Musa: \"Rakyat membawa lebih banyak dari yang diperlukan untuk mengerjakan pekerjaan yang diperintahkan TUHAN untuk dilakukan.\""
 },
 {
   "id": 2574,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 6,
   "firman": "Lalu Musa memerintahkan, supaya dimaklumkan di mana-mana di perkemahan itu, demikian: \"Tidak usah lagi ada orang laki-laki atau perempuan yang membuat sesuatu menjadi persembahan khusus bagi tempat kudus.\" Demikianlah rakyat itu dicegah membawa persembahan lagi."
 },
 {
   "id": 2575,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 7,
   "firman": "Sebab bahan yang diperlukan mereka telah cukup untuk melakukan segala pekerjaan itu, bahkan berlebih."
 },
 {
   "id": 2576,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 8,
   "firman": "Lalu semua ahli di antara tukang-tukang itu membuat Kemah Suci dari sepuluh tenda dari lenan halus yang dipintal benangnya dan dari kain ungu tua, kain ungu muda dan kain kirmizi; dengan ada kerubnya, buatan ahli tenun, dibuat orang semuanya itu."
 },
 {
   "id": 2577,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 9,
   "firman": "Panjang tiap-tiap tenda dua puluh delapan hasta dan lebar tiap-tiap tenda empat hasta: semua tenda itu sama ukurannya."
 },
 {
   "id": 2578,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 10,
   "firman": "Lima dari tenda itu dirangkap menjadi satu, dan yang lima lagi juga dirangkap menjadi satu."
 },
 {
   "id": 2579,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 11,
   "firman": "Pada rangkapan yang pertama, di tepi satu tenda yang di ujung, dibuatlah sosok-sosok kain ungu tua dan demikian juga di tepi satu tenda yang paling ujung pada rangkapan yang kedua."
 },
 {
   "id": 2580,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 12,
   "firman": "Lima puluh sosok dibuat orang pada tenda yang pertama dan lima puluh sosok pada tenda yang di ujung pada rangkapan yang kedua, sehingga sosok-sosok itu tepat berhadapan satu sama lain."
 },
 {
   "id": 2581,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 13,
   "firman": "Dibuatlah lima puluh kaitan emas dan disambunglah tenda-tenda Kemah Suci, yang satu dengan yang lain, dengan memakai kaitan itu, sehingga menjadi satu."
 },
 {
   "id": 2582,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 14,
   "firman": "Dibuatlah tenda-tenda dari bulu kambing menjadi atap kemah yang menudungi Kemah Suci, sebelas tenda dibuat orang."
 },
 {
   "id": 2583,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 15,
   "firman": "Panjang tiap-tiap tenda tiga puluh hasta dan empat hasta lebarnya tiap-tiap tenda: yang sebelas tenda itu sama ukurannya."
 },
 {
   "id": 2584,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 16,
   "firman": "Disambunglah lima dari tenda itu dengan tersendiri dan enam dari tenda itu dengan tersendiri."
 },
 {
   "id": 2585,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 17,
   "firman": "Dibuatlah lima puluh sosok pada rangkapan yang pertama di tepi satu tenda yang di ujung, dan dibuat lima puluh sosok di tepi satu tenda pada rangkapan yang kedua."
 },
 {
   "id": 2586,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 18,
   "firman": "Dibuat oranglah lima puluh kaitan tembaga untuk menyambung tenda-tenda kemah itu, sehingga menjadi satu."
 },
 {
   "id": 2587,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 19,
   "firman": "Juga dibuatlah untuk kemah itu tudung dari kulit domba jantan yang diwarnai merah, dan tudung dari kulit lumba-lumba di atasnya lagi."
 },
 {
   "id": 2588,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 20,
   "firman": "Dibuat oranglah untuk Kemah Suci itu papan dari kayu penaga yang berdiri tegak,"
 },
 {
   "id": 2589,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 21,
   "firman": "sepuluh hasta panjangnya satu papan dan satu setengah hasta lebarnya tiap-tiap papan."
 },
 {
   "id": 2590,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 22,
   "firman": "Tiap-tiap papan ada dua pasaknya yang disengkang satu sama lain; demikianlah diperbuat dengan segala papan Kemah Suci."
 },
 {
   "id": 2591,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 23,
   "firman": "Dibuat oranglah papan-papan untuk Kemah Suci, dua puluh papan pada sebelah selatan."
 },
 {
   "id": 2592,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 24,
   "firman": "Dan empat puluh alas perak dibuat orang di bawah kedua puluh papan itu, dua alas di bawah satu papan untuk kedua pasaknya, dan seterusnya dua alas di bawah setiap papan untuk kedua pasaknya."
 },
 {
   "id": 2593,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 25,
   "firman": "Juga dibuat orang untuk sisi yang kedua dari Kemah Suci, pada sebelah utara, dua puluh papan"
 },
 {
   "id": 2594,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 26,
   "firman": "dengan empat puluh alas peraknya: dua alas di bawah satu papan dan seterusnya dua alas di bawah setiap papan."
 },
 {
   "id": 2595,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 27,
   "firman": "Untuk sisi belakang Kemah Suci, pada sebelah barat, dibuat oranglah enam papan."
 },
 {
   "id": 2596,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 28,
   "firman": "Dua papan dibuat orang untuk sudut Kemah Suci, di sisi belakang."
 },
 {
   "id": 2597,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 29,
   "firman": "Kedua papan itu kembar pasaknya di sebelah bawah dan seperti itu juga kembar pasaknya di sebelah atas, di dekat gelang yang satu itu, demikianlah dibuat orang dengan kedua papan yang untuk kedua sudutnya itu."
 },
 {
   "id": 2598,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 30,
   "firman": "Jadi ada delapan papan dengan alas peraknya: enam belas alas; dua-dua alas di bawah satu papan."
 },
 {
   "id": 2599,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 31,
   "firman": "Dibuatlah juga kayu lintang dari kayu penaga: lima untuk papan-papan pada sisi yang satu dari Kemah Suci,"
 },
 {
   "id": 2600,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 32,
   "firman": "lima kayu lintang untuk papan-papan pada sisi yang kedua dari Kemah Suci, dan lima kayu lintang untuk papan-papan Kemah Suci yang merupakan sisi belakangnya, pada sebelah barat."
 },
 {
   "id": 2601,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 33,
   "firman": "Dibuat oranglah kayu lintang yang di tengah menjadi melintang terus di tengah-tengah papan-papan itu dari ujung ke ujung."
 },
 {
   "id": 2602,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 34,
   "firman": "Papan-papan itu disalut dengan emas, gelang-gelang itu dibuat dari emas sebagai tempat memasukkan kayu-kayu lintang itu, dan kayu-kayu lintang itu disalut dengan emas."
 },
 {
   "id": 2603,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 35,
   "firman": "Dibuatlah tabir itu dari kain ungu tua, dan kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya; dibuat dengan ada kerubnya, buatan ahli tenun."
 },
 {
   "id": 2604,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 36,
   "firman": "Dibuat oranglah untuk itu empat tiang dari kayu penaga dan disalutlah itu dengan emas, dengan ada kaitannya dari emas, lagi dituanglah empat alas perak untuk tiang itu."
 },
 {
   "id": 2605,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 37,
   "firman": "Juga dibuat oranglah tirai untuk pintu kemah itu dari kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya: tenunan yang berwarna-warna;"
 },
 {
   "id": 2606,
   "kitab": "Kel",
   "pasal": 36,
   "ayat": 38,
   "firman": "dan kelima tiangnya dengan kaitan untuk tiang itu; disalutlah ujungnya dan penyambung-penyambungnya dengan emas, dan kelima alasnya itu adalah dari tembaga."
 },
 {
   "id": 2607,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 1,
   "firman": "Bezaleel membuat tabut itu dari kayu penaga, dua setengah hasta panjangnya, satu setengah hasta lebarnya, dan satu setengah hasta tingginya."
 },
 {
   "id": 2608,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 2,
   "firman": "Disalutnyalah itu dengan emas murni, dari dalam dan dari luar, dan dibuatnyalah bingkai emas sekelilingnya."
 },
 {
   "id": 2609,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 3,
   "firman": "Dituangnyalah empat gelang emas untuk tabut itu, pada keempat penjurunya, yaitu dua gelang pada rusuknya yang satu dan dua gelang pada rusuknya yang kedua."
 },
 {
   "id": 2610,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 4,
   "firman": "Dibuatnyalah kayu pengusung dari kayu penaga dan disalutnyalah itu dengan emas."
 },
 {
   "id": 2611,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 5,
   "firman": "Dan dimasukkannyalah kayu pengusung itu ke dalam gelang yang pada rusuk tabut itu, supaya tabut dapat diangkut."
 },
 {
   "id": 2612,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 6,
   "firman": "Dibuatnyalah tutup pendamaian dari emas murni, dua setengah hasta panjangnya dan satu setengah hasta lebarnya."
 },
 {
   "id": 2613,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 7,
   "firman": "Dibuatnyalah dua kerub dari emas, dari emas tempaan dibuatnya itu, pada kedua ujung tutup pendamaian itu,"
 },
 {
   "id": 2614,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 8,
   "firman": "satu kerub pada ujung sebelah sini dan satu kerub pada ujung sebelah sana; seiras dengan tutup pendamaian itu dibuatnya kerub itu pada kedua ujungnya."
 },
 {
   "id": 2615,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 9,
   "firman": "Kerub-kerub itu mengembangkan kedua sayapnya ke atas, sayap-sayapnya menudungi tutup pendamaian itu dan mukanya menghadap kepada masing-masing; kepada tutup pendamaian itulah menghadap muka kerub-kerub itu."
 },
 {
   "id": 2616,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 10,
   "firman": "Dibuatnyalah meja itu dari kayu penaga, dua hasta panjangnya, sehasta lebarnya dan satu setengah hasta tingginya."
 },
 {
   "id": 2617,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 11,
   "firman": "Disalutnyalah itu dengan emas murni dan dibuatnya bingkai emas sekelilingnya."
 },
 {
   "id": 2618,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 12,
   "firman": "Dibuatnyalah sekelilingnya jalur pinggir yang setapak tangan lebarnya dan dibuatnya bingkai emas sekeliling jalur pinggirnya itu."
 },
 {
   "id": 2619,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 13,
   "firman": "Dituangnyalah untuk meja itu empat gelang emas dan dipasangnyalah gelang-gelang itu di keempat penjurunya, pada keempat kakinya."
 },
 {
   "id": 2620,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 14,
   "firman": "Dekat ke jalur pinggirnyalah gelang itu, yakni tempat memasukkan kayu pengusung, supaya meja itu dapat diangkut."
 },
 {
   "id": 2621,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 15,
   "firman": "Dibuatnyalah kayu pengusung itu dari kayu penaga dan disalutnya dengan emas, yaitu supaya meja itu dapat diangkut."
 },
 {
   "id": 2622,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 16,
   "firman": "Dan dibuatnyalah perkakas yang di atas meja itu, yakni pinggannya, cawannya, piala dan kendinya, yang dipakai untuk persembahan curahan, semuanya dari emas murni."
 },
 {
   "id": 2623,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 17,
   "firman": "Dibuatnyalah kandil itu dari emas murni; dari emas tempaan dibuatnya kandil itu, baik kakinya baik batangnya; kelopaknya--dengan tombolnya dan kembangnya--dibuat seiras dengan kandil itu."
 },
 {
   "id": 2624,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 18,
   "firman": "Ada enam cabang timbul dari sisinya: tiga cabang kandil itu dari sisi yang satu dan tiga cabang dari sisi yang lain."
 },
 {
   "id": 2625,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 19,
   "firman": "Tiga kelopak yang berupa bunga badam pada cabang yang satu--dengan tombol dan kembangnya--dan tiga kelopak yang serupa pada cabang yang lain--dengan tombol dan kembangnya--;demikian juga dibuat keenam cabang yang timbul dari kandil itu."
 },
 {
   "id": 2626,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 20,
   "firman": "Pada kandil itu sendiri ada empat kelopak berupa bunga badam--dengan tombolnya dan kembangnya."
 },
 {
   "id": 2627,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 21,
   "firman": "Juga ada satu tombol di bawah sepasang cabang yang pertama yang timbul dari kandil itu, dan satu tombol di bawah yang kedua, dan satu tombol di bawah yang ketiga; demikianlah juga dibuat keenam cabang yang timbul dari situ."
 },
 {
   "id": 2628,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 22,
   "firman": "Tombol dan cabang itu timbul dari kandil itu, dan semuanya itu dibuat dari sepotong emas tempaan yang murni."
 },
 {
   "id": 2629,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 23,
   "firman": "Dibuatnyalah pada kandil itu tujuh lampu dengan sepitnya dan penadahnya dari emas murni."
 },
 {
   "id": 2630,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 24,
   "firman": "Dari satu talenta emas murni dibuatnyalah kandil itu dengan segala perkakasnya."
 },
 {
   "id": 2631,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 25,
   "firman": "Dibuatnyalah mezbah pembakaran ukupan itu dari kayu penaga, sehasta panjangnya dan sehasta lebarnya, empat persegi, tetapi dua hasta tingginya; tanduk-tanduknya seiras dengan mezbah itu."
 },
 {
   "id": 2632,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 26,
   "firman": "Disalutnyalah itu dengan emas murni, bidang atasnya dan bidang-bidang sisinya sekelilingnya, serta tanduk-tanduknya. Dibuatnyalah bingkai emas sekelilingnya."
 },
 {
   "id": 2633,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 27,
   "firman": "Dibuatnyalah dua gelang emas untuk mezbah itu di bawah bingkainya, pada kedua rusuknya, pada kedua bidang sisinya, sebagai tempat memasukkan kayu pengusung, supaya dengan itu mezbah dapat diangkut."
 },
 {
   "id": 2634,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 28,
   "firman": "Dan dibuatnyalah kayu pengusung itu dari kayu penaga dan disalutnya dengan emas."
 },
 {
   "id": 2635,
   "kitab": "Kel",
   "pasal": 37,
   "ayat": 29,
   "firman": "Dan dibuatnyalah minyak urapan yang kudus itu dan ukupan murni dari wangi-wangian, seperti buatan seorang tukang campur rempah-rempah."
 },
 {
   "id": 2636,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 1,
   "firman": "Dibuatnyalah mezbah korban bakaran itu dari kayu penaga, lima hasta panjangnya dan lima hasta lebarnya, empat persegi, tetapi tiga hasta tingginya."
 },
 {
   "id": 2637,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 2,
   "firman": "Dibuatnyalah tanduk-tanduknya pada keempat sudutnya; tanduk-tanduknya itu dibuat seiras dengan mezbah itu dan disalutnya dengan tembaga."
 },
 {
   "id": 2638,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 3,
   "firman": "Dibuatnyalah segala perkakas mezbah itu, yakni kuali-kuali, sodok-sodok, bokor-bokor penyiraman, garpu-garpu dan perbaraan-perbaraan, semua perkakasnya itu dibuatnya dari tembaga."
 },
 {
   "id": 2639,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 4,
   "firman": "Dibuatnyalah untuk mezbah itu kisi-kisi, yakni jala-jala tembaga, di bawah jalur, mulai dari sebelah bawah sampai setengah tingginya."
 },
 {
   "id": 2640,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 5,
   "firman": "Dituangnyalah empat gelang pada keempat ujung kisi-kisi tembaga itu, yakni tempat memasukkan kayu pengusung."
 },
 {
   "id": 2641,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 6,
   "firman": "Dibuatnyalah kayu-kayu pengusung itu dari kayu penaga dan disalutnya dengan tembaga."
 },
 {
   "id": 2642,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 7,
   "firman": "Dan dimasukkannyalah kayu-kayu pengusung itu ke dalam gelang-gelang yang pada rusuk mezbah itu, supaya dengan itu mezbah dapat diangkut. Mezbah itu dibuatnya berongga dan dari papan."
 },
 {
   "id": 2643,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 8,
   "firman": "Dibuatnyalah bejana pembasuhan dan juga alasnya dari tembaga, dari cermin-cermin para pelayan perempuan yang melayani di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2644,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 9,
   "firman": "Dibuatnyalah pelataran itu; pada sebelah selatan: layar pelataran itu dari lenan halus yang dipintal benangnya, seratus hasta panjangnya;"
 },
 {
   "id": 2645,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 10,
   "firman": "kedua puluh tiang layar itu dengan kedua puluh alas tiang itu dari tembaga, tetapi kaitan-kaitan tiang itu dan penyambung-penyambungnya dari perak."
 },
 {
   "id": 2646,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 11,
   "firman": "Pada sebelah utara: seratus hasta; kedua puluh tiang layar itu dengan kedua puluh alas tiang itu dari tembaga, tetapi kaitan-kaitan tiang itu dan penyambung-penyambungnya dari perak."
 },
 {
   "id": 2647,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 12,
   "firman": "Pada sebelah barat: layar lima puluh hasta; dengan sepuluh tiangnya dan sepuluh alas tiang itu, dan kaitan-kaitan tiang itu serta penyambung-penyambungnya dari perak."
 },
 {
   "id": 2648,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 13,
   "firman": "Dan pada sebelah timur: lima puluh hasta,"
 },
 {
   "id": 2649,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 14,
   "firman": "yakni layar lima belas hasta untuk sisi yang satu di samping pintu gerbang itu, dengan tiga tiangnya dan tiga alas tiang itu;"
 },
 {
   "id": 2650,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 15,
   "firman": "dan juga untuk sisi yang kedua di samping pintu gerbang itu--sebelah-menyebelah pintu gerbang pelataran itu ada layar--lima belas hasta, dengan tiga tiangnya dan tiga alas tiang itu."
 },
 {
   "id": 2651,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 16,
   "firman": "Segala layar yang mengelilingi pelataran, adalah dari lenan halus yang dipintal benangnya."
 },
 {
   "id": 2652,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 17,
   "firman": "Alas-alas untuk tiang-tiang itu adalah dari tembaga, tetapi kaitan-kaitan tiang itu dan penyambung-penyambungnya dari perak, juga salut kepalanya dari perak. Dihubungkanlah dengan penyambung-penyambung dari perak segala tiang-tiang pelataran itu."
 },
 {
   "id": 2653,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 18,
   "firman": "Tirai pintu gerbang pelataran itu tenunan yang berwarna-warna dari kain ungu tua, kain ungu muda, kain kirmizi dan dari lenan halus yang dipintal benangnya; dua puluh hasta panjangnya, tetapi tingginya--yang juga lebar kain itu--adalah lima hasta, sama dengan tinggi layar pelataran itu."
 },
 {
   "id": 2654,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 19,
   "firman": "Keempat tiangnya dan keempat alas tiang itu dari tembaga; tetapi kaitan-kaitannya dari perak, dan juga salut kepalanya, serta penyambung-penyambungnya dari perak."
 },
 {
   "id": 2655,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 20,
   "firman": "Segala patok untuk Kemah Suci dan untuk pelataran itu, sekelilingnya, adalah dari tembaga."
 },
 {
   "id": 2656,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 21,
   "firman": "Inilah daftar biaya untuk mendirikan Kemah Suci, yakni Kemah Suci, tempat hukum Allah, yang disusun atas perintah Musa, oleh orang Lewi di bawah pimpinan Itamar, anak imam Harun."
 },
 {
   "id": 2657,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 22,
   "firman": "Bezaleel bin Uri bin Hur, dari suku Yehuda, membuat segala yang diperintahkan TUHAN kepada Musa,"
 },
 {
   "id": 2658,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 23,
   "firman": "dan bersama-sama dengan dia turut Aholiab, anak Ahisamakh, dari suku Dan, seorang tukang dan ahli, seorang yang membuat tenunan yang berwarna-warna dari kain ungu tua, dari kain ungu muda, dari kain kirmizi dan dari lenan halus. --"
 },
 {
   "id": 2659,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 24,
   "firman": "Segala emas yang dipakai untuk segala pekerjaan mendirikan tempat kudus itu, yakni emas dari persembahan unjukan, ada dua puluh sembilan talenta dan tujuh ratus tiga puluh syikal, ditimbang menurut syikal kudus."
 },
 {
   "id": 2660,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 25,
   "firman": "Perak persembahan mereka yang didaftarkan dari antara jemaah itu ada seratus talenta dan seribu tujuh ratus tujuh puluh lima syikal, ditimbang menurut syikal kudus:"
 },
 {
   "id": 2661,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 26,
   "firman": "sebeka seorang, yaitu setengah syikal, ditimbang menurut syikal kudus, untuk setiap orang yang termasuk orang-orang yang terdaftar, yang berumur dua puluh tahun ke atas, sejumlah enam ratus tiga ribu lima ratus lima puluh orang."
 },
 {
   "id": 2662,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 27,
   "firman": "Seratus talenta perak dipakai untuk menuang alas-alas tempat kudus dan alas-alas tiang tabir itu, seratus alas sesuai dengan seratus talenta itu, jadi satu talenta untuk satu alas."
 },
 {
   "id": 2663,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 28,
   "firman": "Dari yang seribu tujuh ratus tujuh puluh lima syikal itu dibuatnyalah kaitan-kaitan untuk tiang-tiang itu, disalutnyalah kepala tiang itu dan dihubungkannya tiang-tiang itu dengan penyambung-penyambung."
 },
 {
   "id": 2664,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 29,
   "firman": "Tembaga dari persembahan unjukan itu ada tujuh puluh talenta dan dua ribu empat ratus syikal."
 },
 {
   "id": 2665,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 30,
   "firman": "Dari padanya dibuatnyalah alas-alas pintu Kemah Pertemuan, dan mezbah tembaga dengan kisi-kisi tembaganya, segala perkakas mezbah itu,"
 },
 {
   "id": 2666,
   "kitab": "Kel",
   "pasal": 38,
   "ayat": 31,
   "firman": "alas-alas pelataran sekelilingnya, alas-alas pintu gerbang pelataran itu, segala patok Kemah Suci dan segala patok pelataran sekelilingnya."
 },
 {
   "id": 2667,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 1,
   "firman": "Dari kain ungu tua, kain ungu muda dan kain kirmizi dibuat merekalah pakaian jabatan yang dipakai apabila diselenggarakan kebaktian di tempat kudus; juga dibuat mereka pakaian-pakaian kudus untuk Harun, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2668,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 2,
   "firman": "Dibuatnyalah baju efod dari emas, kain ungu tua dan kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya."
 },
 {
   "id": 2669,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 3,
   "firman": "Mereka menempa emas papan dan dipotong-potongnyalah itu menjadi benang emas, untuk dipakankan pada kain ungu tua, pada kain ungu muda, pada kain kirmizi dan pada lenan halus: buatan seorang ahli."
 },
 {
   "id": 2670,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 4,
   "firman": "Dibuat merekalah tutup bahu pada baju efod itu, yang disambung kepadanya, dikedua ujungnyalah baju efod itu disambung."
 },
 {
   "id": 2671,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 5,
   "firman": "Sabuk pengikat yang ada pada baju efod itu adalah seiras dan sama buatannya dengan baju efod itu, yakni dari emas, kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2672,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 6,
   "firman": "Dikerjakan merekalah permata krisopras, yakni dililit dengan ikat emas, diukirkan padanya nama para anak Israel, yang diukirkan seperti meterai."
 },
 {
   "id": 2673,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 7,
   "firman": "Ditaruhnyalah itu pada kedua tutup bahu baju efod sebagai permata peringatan untuk mengingat orang Israel, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2674,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 8,
   "firman": "Dibuatnyalah tutup dada, buatan seorang ahli. Buatannya sama dengan baju efod, yakni dari emas, kain ungu tua, kain ungu muda, kain kirmizi dan lenan halus yang dipintal benangnya."
 },
 {
   "id": 2675,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 9,
   "firman": "Empat persegi dibuatnya itu; lipat dua dibuat mereka tutup dada itu, sejengkal panjangnya dan sejengkal lebarnya."
 },
 {
   "id": 2676,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 10,
   "firman": "Ditatah merekalah itu dengan empat jajar permata: permata yaspis merah, krisolit, malakit, itulah jajar yang pertama;"
 },
 {
   "id": 2677,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 11,
   "firman": "jajar yang kedua: permata batu darah, lazurit, yaspis hijau;"
 },
 {
   "id": 2678,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 12,
   "firman": "jajar yang ketiga: permata ambar, akik, kecubung;"
 },
 {
   "id": 2679,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 13,
   "firman": "jajar yang keempat: permata pirus, krisopras dan nefrit. Dililit dengan ikat emas, demikianlah permata-permata itu dalam tatahannya."
 },
 {
   "id": 2680,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 14,
   "firman": "Sesuai dengan nama para anak Israel, permata itu adalah dua belas banyaknya; dan pada tiap-tiap permata ada diukirkan seperti meterai, nama salah satu suku dari yang dua belas itu."
 },
 {
   "id": 2681,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 15,
   "firman": "Juga dibuat merekalah untuk tutup dada itu untai berpilin, yang buatannya sebagai tali berjalin, dari emas murni."
 },
 {
   "id": 2682,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 16,
   "firman": "Dibuat merekalah dua ikat emas dan dua gelang emas dan kedua gelang itu dipasang pada kedua ujung tutup dada."
 },
 {
   "id": 2683,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 17,
   "firman": "Dipasang merekalah kedua untai emas yang berjalin itu pada kedua gelang itu di ujung tutup dada."
 },
 {
   "id": 2684,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 18,
   "firman": "Kedua ujung lain dari kedua untai berjalin itu dipasang merekalah pada kedua ikat emas itu, demikianlah dipasang pada tutup bahu baju efod, di sebelah depannya."
 },
 {
   "id": 2685,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 19,
   "firman": "Dibuat merekalah dua gelang emas dan dibubuh pada kedua ujung tutup dada itu, pada pinggirnya yang sebelah dalam, yang berhadapan dengan baju efod."
 },
 {
   "id": 2686,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 20,
   "firman": "Juga dibuat merekalah dua gelang emas dan dipasang pada kedua tutup bahu baju efod, di sebelah bawah pada bagian depan, dekat ke tempat persambungannya, di sebelah atas sabuk baju efod."
 },
 {
   "id": 2687,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 21,
   "firman": "Kemudian diikatkan merekalah tutup dada itu dengan gelangnya kepada gelang baju efod dengan memakai tali ungu tua, sehingga tetap di atas sabuk baju efod, dan tutup dada itu tidak dapat bergeser dari baju efod--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2688,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 22,
   "firman": "Dibuatnyalah gamis baju efod, buatan tukang tenun, dari kain ungu tua seluruhnya."
 },
 {
   "id": 2689,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 23,
   "firman": "Leher gamis itu di tengah-tengahnya seperti leher baju zirah, lehernya itu mempunyai pinggir sekelilingnya, supaya jangan koyak."
 },
 {
   "id": 2690,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 24,
   "firman": "Dibuat merekalah pada ujung gamis itu buah delima dari kain ungu tua, kain ungu muda dan kain kirmizi, yang dipintal benangnya."
 },
 {
   "id": 2691,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 25,
   "firman": "Dibuat merekalah giring-giring dari emas murni dan ditaruhlah giring-giring itu di antara buah delima, pada ujung gamis itu, berselang-seling di antara buah delima itu,"
 },
 {
   "id": 2692,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 26,
   "firman": "sehingga satu giring-giring dan satu buah delima selalu berselang-seling, pada sekeliling ujung gamis, yang dipakai apabila diselenggarakan kebaktian seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2693,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 27,
   "firman": "Dibuat merekalah kemeja dari lenan halus, buatan tukang tenun, untuk Harun dan anak-anaknya,"
 },
 {
   "id": 2694,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 28,
   "firman": "serban dari lenan halus, destar yang indah dari lenan halus, celana lenan dari lenan halus yang dipintal benangnya,"
 },
 {
   "id": 2695,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 29,
   "firman": "dan ikat pinggang dari lenan halus yang dipintal benangnya, kain ungu tua, kain ungu muda dan kain kirmizi, dari tenunan yang berwarna-warna--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2696,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 30,
   "firman": "Dibuat merekalah patam, jamang yang kudus dari emas murni, dan pada jamang itu dituliskan tulisan, diukirkan seperti meterai: Kudus bagi TUHAN."
 },
 {
   "id": 2697,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 31,
   "firman": "Dipasang merekalah pada patam itu tali ungu tua untuk mengikatkan patam itu pada serbannya, di sebelah atas--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2698,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 32,
   "firman": "Demikianlah diselesaikan segala pekerjaan melengkapi Kemah Suci, yakni Kemah Pertemuan itu. Orang Israel telah melakukannya tepat seperti yang diperintahkan TUHAN kepada Musa, demikianlah mereka melakukannya."
 },
 {
   "id": 2699,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 33,
   "firman": "Dibawa merekalah Kemah Suci itu kepada Musa, yakni kemah dengan segala perabotannya: kaitannya, papannya, kayu lintangnya, tiangnya dan alasnya,"
 },
 {
   "id": 2700,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 34,
   "firman": "tudung dari kulit domba jantan yang diwarnai merah, tudung dari kulit lumba-lumba, tabir penudung,"
 },
 {
   "id": 2701,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 35,
   "firman": "tabut hukum Allah dengan kayu-kayu pengusungnya dan tutup pendamaian,"
 },
 {
   "id": 2702,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 36,
   "firman": "meja, segala perkakasnya dan roti sajian,"
 },
 {
   "id": 2703,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 37,
   "firman": "kandil dari emas murni, lampu-lampunya--lampu yang harus teratur di atasnya--dan segala perkakasnya, minyak untuk penerangan,"
 },
 {
   "id": 2704,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 38,
   "firman": "mezbah dari emas, minyak urapan, ukupan dari wangi-wangian, tirai pintu kemah,"
 },
 {
   "id": 2705,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 39,
   "firman": "mezbah tembaga dengan kisi-kisi tembaganya, kayu-kayu pengusungnya dan segala perkakasnya, bejana pembasuhan dengan alasnya,"
 },
 {
   "id": 2706,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 40,
   "firman": "layar pelataran, tiangnya dan alasnya, dan tirai untuk pintu gerbang pelataran, talinya dan patoknya, segala perkakas untuk pekerjaan mendirikan Kemah Suci, yakni Kemah Pertemuan itu;"
 },
 {
   "id": 2707,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 41,
   "firman": "pakaian jabatan yang dipakai apabila diselenggarakan kebaktian di tempat kudus, pakaian kudus untuk imam Harun, dan pakaian anak-anaknya untuk memegang jabatan imam."
 },
 {
   "id": 2708,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 42,
   "firman": "Tepat seperti yang diperintahkan TUHAN kepada Musa, demikianlah dilakukan orang Israel segala pekerjaan melengkapi itu."
 },
 {
   "id": 2709,
   "kitab": "Kel",
   "pasal": 39,
   "ayat": 43,
   "firman": "Dan Musa melihat segala pekerjaan itu, dan sesungguhnyalah, mereka telah melakukannya seperti yang diperintahkan TUHAN, demikianlah mereka melakukannya. Lalu Musa memberkati mereka."
 },
 {
   "id": 2710,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 1,
   "firman": "Berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 2711,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 2,
   "firman": "\"Pada hari yang pertama dari bulan yang pertama haruslah engkau mendirikan Kemah Suci, yakni Kemah Pertemuan itu."
 },
 {
   "id": 2712,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 3,
   "firman": "Kautempatkanlah di dalamnya tabut hukum dan kaupasanglah tabir sebagai penudung di depan tabut itu."
 },
 {
   "id": 2713,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 4,
   "firman": "Kaubawalah ke dalamnya meja dan taruhlah di atasnya perkakas menurut susunannya; kaubawalah ke dalamnya kandil dan kaupasang lampu-lampunya di atasnya."
 },
 {
   "id": 2714,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 5,
   "firman": "Kautaruhlah mezbah emas untuk membakar ukupan di depan tabut hukum. Kaugantungkanlah tirai pintu Kemah Suci."
 },
 {
   "id": 2715,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 6,
   "firman": "Kautaruhlah mezbah korban bakaran di depan pintu Kemah Suci, yakni Kemah Pertemuan itu."
 },
 {
   "id": 2716,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 7,
   "firman": "Kautaruhlah bejana pembasuhan di antara Kemah Pertemuan dan mezbah itu, lalu kautaruhlah air ke dalamnya."
 },
 {
   "id": 2717,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 8,
   "firman": "Haruslah kaubuat pelataran keliling dan kaugantungkanlah tirai pintu gerbang pelataran itu."
 },
 {
   "id": 2718,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 9,
   "firman": "Kemudian kauambillah minyak urapan dan kauurapilah Kemah Suci dengan segala yang ada di dalamnya; demikianlah harus engkau menguduskannya, dengan segala perabotannya, sehingga menjadi kudus."
 },
 {
   "id": 2719,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 10,
   "firman": "Juga kauurapilah mezbah korban bakaran itu dengan segala perkakasnya; demikianlah engkau harus menguduskan mezbah itu, sehingga mezbah itu maha kudus."
 },
 {
   "id": 2720,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 11,
   "firman": "Juga kauurapilah bejana pembasuhan itu dengan alasnya, dan demikianlah engkau harus menguduskannya."
 },
 {
   "id": 2721,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 12,
   "firman": "Kemudian kausuruhlah Harun dan anak-anaknya datang ke pintu Kemah Pertemuan dan kaubasuhlah mereka dengan air."
 },
 {
   "id": 2722,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 13,
   "firman": "Kaukenakanlah pakaian yang kudus kepada Harun, kauurapi dan kaukuduskanlah dia supaya ia memegang jabatan imam bagi-Ku."
 },
 {
   "id": 2723,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 14,
   "firman": "Juga anak-anaknya kausuruhlah mendekat dan kaukenakanlah kemeja kepada mereka."
 },
 {
   "id": 2724,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 15,
   "firman": "Urapilah mereka, seperti engkau mengurapi ayah mereka, supaya mereka memegang jabatan imam bagi-Ku; dan ini terjadi, supaya berdasarkan pengurapan itu mereka memegang jabatan imam untuk selama-lamanya turun-temurun.\""
 },
 {
   "id": 2725,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 16,
   "firman": "Dan Musa melakukan semuanya itu tepat seperti yang diperintahkan TUHAN kepadanya, demikianlah dilakukannya."
 },
 {
   "id": 2726,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 17,
   "firman": "Dan terjadilah dalam bulan yang pertama tahun yang kedua, pada tanggal satu bulan itu, maka didirikanlah Kemah Suci."
 },
 {
   "id": 2727,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 18,
   "firman": "Musa mendirikan Kemah Suci itu, dipasangnyalah alas-alasnya, ditaruhnya papan-papannya, dipasangnya kayu-kayu lintangnya dan didirikannya tiang-tiangnya."
 },
 {
   "id": 2728,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 19,
   "firman": "Dikembangkannyalah atap kemah yang menudungi Kemah Suci dan diletakkannyalah tudung kemah di atasnya--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2729,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 20,
   "firman": "Diambilnyalah loh hukum Allah dan ditaruhnya ke dalam tabut, dikenakannyalah kayu pengusung pada tabut itu dan diletakkannya tutup pendamaian di atas tabut itu."
 },
 {
   "id": 2730,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 21,
   "firman": "Dibawanyalah tabut itu ke dalam Kemah Suci, digantungkannyalah tabir penudung dan dipasangnya sebagai penudung di depan tabut hukum Allah--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2731,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 22,
   "firman": "Ditaruhnyalah meja di dalam Kemah Pertemuan pada sisi Kemah Suci sebelah utara, di depan tabir itu."
 },
 {
   "id": 2732,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 23,
   "firman": "Diletakkannyalah di atasnya roti sajian menurut susunannya, di hadapan TUHAN--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2733,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 24,
   "firman": "Ditempatkannyalah kandil di dalam Kemah Pertemuan berhadapan dengan meja itu, pada sisi Kemah Suci sebelah selatan."
 },
 {
   "id": 2734,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 25,
   "firman": "Dipasangnyalah lampu-lampu di atasnya di hadapan TUHAN--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2735,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 26,
   "firman": "Ditempatkannyalah mezbah emas di dalam Kemah Pertemuan di depan tabir itu."
 },
 {
   "id": 2736,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 27,
   "firman": "Dibakarnyalah di atasnya ukupan dari wangi-wangian seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2737,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 28,
   "firman": "Digantungkannyalah tirai pintu Kemah Suci."
 },
 {
   "id": 2738,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 29,
   "firman": "Mezbah korban bakaran ditempatkannyalah di depan pintu Kemah Suci, yakni Kemah Pertemuan itu, dan dipersembahkannyalah di atasnya korban bakaran dan korban sajian--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2739,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 30,
   "firman": "Ditempatkannyalah bejana pembasuhan di antara Kemah Pertemuan dan mezbah itu, lalu ditaruhnyalah air ke dalamnya untuk pembasuhan."
 },
 {
   "id": 2740,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 31,
   "firman": "Musa dan Harun serta anak-anaknya membasuh tangan dan kaki mereka dengan air dari dalamnya."
 },
 {
   "id": 2741,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 32,
   "firman": "Apabila mereka masuk ke dalam Kemah Pertemuan dan apabila mereka datang mendekat kepada mezbah itu, maka mereka membasuh kaki dan tangan--seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2742,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 33,
   "firman": "Didirikannyalah tiang-tiang pelataran sekeliling Kemah Suci dan mezbah itu, dan digantungkannyalah tirai pintu gerbang pelataran itu. Demikianlah diselesaikan Musa pekerjaan itu."
 },
 {
   "id": 2743,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 34,
   "firman": "Lalu awan itu menutupi Kemah Pertemuan, dan kemuliaan TUHAN memenuhi Kemah Suci,"
 },
 {
   "id": 2744,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 35,
   "firman": "sehingga Musa tidak dapat memasuki Kemah Pertemuan, sebab awan itu hinggap di atas kemah itu, dan kemuliaan TUHAN memenuhi Kemah Suci."
 },
 {
   "id": 2745,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 36,
   "firman": "Apabila awan itu naik dari atas Kemah Suci, berangkatlah orang Israel dari setiap tempat mereka berkemah."
 },
 {
   "id": 2746,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 37,
   "firman": "Tetapi jika awan itu tidak naik, maka merekapun tidak berangkat sampai hari awan itu naik."
 },
 {
   "id": 2747,
   "kitab": "Kel",
   "pasal": 40,
   "ayat": 38,
   "firman": "Sebab awan TUHAN itu ada di atas Kemah Suci pada siang hari, dan pada malam hari ada api di dalamnya, di depan mata seluruh umat Israel pada setiap tempat mereka berkemah."
 },
 {
   "id": 2748,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 1,
   "firman": "TUHAN memanggil Musa dan berfirman kepadanya dari dalam Kemah Pertemuan:"
 },
 {
   "id": 2749,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Apabila seseorang di antaramu hendak mempersembahkan persembahan kepada TUHAN, haruslah persembahanmu yang kamu persembahkan itu dari ternak, yakni dari lembu sapi atau dari kambing domba."
 },
 {
   "id": 2750,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 3,
   "firman": "Jikalau persembahannya merupakan korban bakaran dari lembu, haruslah ia mempersembahkan seekor jantan yang tidak bercela. Ia harus membawanya ke pintu Kemah Pertemuan, supaya TUHAN berkenan akan dia."
 },
 {
   "id": 2751,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 4,
   "firman": "Lalu ia harus meletakkan tangannya ke atas kepala korban bakaran itu, sehingga baginya persembahan itu diperkenan untuk mengadakan pendamaian baginya."
 },
 {
   "id": 2752,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 5,
   "firman": "Kemudian haruslah ia menyembelih lembu itu di hadapan TUHAN, dan anak-anak Harun, imam-imam itu, harus mempersembahkan darah lembu itu dan menyiramkannya pada sekeliling mezbah yang di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2753,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 6,
   "firman": "Kemudian haruslah ia menguliti korban bakaran itu dan memotong-motongnya menurut bagian-bagian tertentu."
 },
 {
   "id": 2754,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 7,
   "firman": "Anak-anak imam Harun haruslah menaruh api di atas mezbah dan menyusun kayu di atas api itu."
 },
 {
   "id": 2755,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 8,
   "firman": "Dan mereka harus mengatur potongan-potongan korban itu dan kepala serta lemaknya di atas kayu yang sedang menyala di atas mezbah."
 },
 {
   "id": 2756,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 9,
   "firman": "Tetapi isi perutnya dan betisnya haruslah dibasuh dengan air dan seluruhnya itu harus dibakar oleh imam di atas mezbah sebagai korban bakaran, sebagai korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 2757,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 10,
   "firman": "Jikalau persembahannya untuk korban bakaran adalah dari kambing domba, baik dari domba, maupun dari kambing, haruslah ia mempersembahkan seekor jantan yang tidak bercela."
 },
 {
   "id": 2758,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 11,
   "firman": "Haruslah ia menyembelihnya pada sisi mezbah sebelah utara di hadapan TUHAN, lalu haruslah anak-anak Harun, imam-imam itu, menyiramkan darahnya pada mezbah sekelilingnya."
 },
 {
   "id": 2759,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 12,
   "firman": "Kemudian haruslah ia memotong-motongnya menurut bagian-bagian tertentu, dan bersama-sama kepalanya dan lemaknya diaturlah semuanya itu oleh imam di atas kayu yang sedang menyala di atas mezbah."
 },
 {
   "id": 2760,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 13,
   "firman": "Isi perut dan betisnya haruslah dibasuhnya dengan air, dan seluruhnya itu haruslah dipersembahkan oleh imam dan dibakar di atas mezbah: itulah korban bakaran, suatu korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 2761,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 14,
   "firman": "Jikalau persembahannya kepada TUHAN merupakan korban bakaran dari burung, haruslah ia mempersembahkan korbannya itu dari burung tekukur atau dari anak burung merpati."
 },
 {
   "id": 2762,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 15,
   "firman": "Imam harus membawanya ke mezbah, lalu memulas kepalanya dan membakarnya di atas mezbah. Darahnya harus ditekan ke luar pada dinding mezbah."
 },
 {
   "id": 2763,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 16,
   "firman": "Temboloknya serta dengan bulunya haruslah disisihkan dan dibuang ke samping mezbah sebelah timur, ke tempat abu."
 },
 {
   "id": 2764,
   "kitab": "Ima",
   "pasal": 1,
   "ayat": 17,
   "firman": "Dan ia harus mencabik burung itu pada pangkal sayapnya, tetapi tidak sampai terpisah; lalu imam harus membakarnya di atas mezbah, di atas kayu yang sedang terbakar; itulah korban bakaran, suatu korban api-apian yang baunya menyenangkan bagi TUHAN.\""
 },
 {
   "id": 2765,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 1,
   "firman": "\"Apabila seseorang hendak mempersembahkan persembahan berupa korban sajian kepada TUHAN, hendaklah persembahannya itu tepung yang terbaik dan ia harus menuangkan minyak serta membubuhkan kemenyan ke atasnya."
 },
 {
   "id": 2766,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 2,
   "firman": "Lalu korban itu harus dibawanya kepada anak-anak Harun, imam-imam itu. Setelah diambil dari korban itu tepung segenggam dengan minyak beserta seluruh kemenyannya, maka imam haruslah membakar semuanya itu di atas mezbah sebagai bagian ingat-ingatan korban itu, sebagai korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 2767,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 3,
   "firman": "Korban sajian selebihnya adalah teruntuk bagi Harun dan anak-anaknya, yakni bagian maha kudus dari segala korban api-apian TUHAN."
 },
 {
   "id": 2768,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 4,
   "firman": "Apabila engkau hendak mempersembahkan persembahan berupa korban sajian dari apa yang dibakar di dalam pembakaran roti, haruslah itu dari tepung yang terbaik, berupa roti bundar yang tidak beragi, yang diolah dengan minyak, atau roti tipis yang tidak beragi, yang diolesi dengan minyak."
 },
 {
   "id": 2769,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 5,
   "firman": "Jikalau persembahanmu merupakan korban sajian dari yang dipanggang di atas panggangan, haruslah itu dari tepung yang terbaik, diolah dengan minyak, berupa roti yang tidak beragi."
 },
 {
   "id": 2770,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 6,
   "firman": "Korban itu harus dipotong-potong, lalu kautuangkanlah minyak ke atasnya; itulah korban sajian."
 },
 {
   "id": 2771,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 7,
   "firman": "Jikalau persembahanmu merupakan korban sajian dari yang dimasak di dalam wajan, haruslah itu diolah dari tepung yang terbaik bersama-sama minyak."
 },
 {
   "id": 2772,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 8,
   "firman": "Maka korban sajian yang diolah menurut salah satu cara itu haruslah kaupersembahkan kepada TUHAN, yakni harus disampaikan kepada imam, yang membawanya ke mezbah."
 },
 {
   "id": 2773,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 9,
   "firman": "Kemudian imam harus mengkhususkan dari korban sajian itu bagian ingat-ingatannya lalu membakarnya di atas mezbah sebagai korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 2774,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 10,
   "firman": "Korban sajian selebihnya adalah bagian Harun dan anak-anaknya, yakni bagian maha kudus dari segala korban api-apian TUHAN!"
 },
 {
   "id": 2775,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 11,
   "firman": "Suatu korban sajian yang kamu persembahkan kepada TUHAN janganlah diolah beragi, karena dari ragi atau dari madu tidak boleh kamu membakar sesuatupun sebagai korban api-apian bagi TUHAN."
 },
 {
   "id": 2776,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 12,
   "firman": "Tetapi sebagai persembahan dari hasil pertama boleh kamu mempersembahkannya kepada TUHAN, hanya janganlah dibawa ke atas mezbah menjadi bau yang menyenangkan."
 },
 {
   "id": 2777,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 13,
   "firman": "Dan tiap-tiap persembahanmu yang berupa korban sajian haruslah kaububuhi garam, janganlah kaulalaikan garam perjanjian Allahmu dari korban sajianmu; beserta segala persembahanmu haruslah kaupersembahkan garam."
 },
 {
   "id": 2778,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 14,
   "firman": "Jikalau engkau hendak mempersembahkan korban sajian dari hulu hasil kepada TUHAN, haruslah engkau mempersembahkan bulir gandum yang dipanggang di atas api, emping gandum baru, sebagai korban sajian dari hulu hasil gandummu."
 },
 {
   "id": 2779,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 15,
   "firman": "Haruslah kaububuh minyak dan kautaruh kemenyan ke atasnya; itulah korban sajian."
 },
 {
   "id": 2780,
   "kitab": "Ima",
   "pasal": 2,
   "ayat": 16,
   "firman": "Haruslah imam membakar sebagai ingat-ingatannya, sebagian dari emping gandumnya dan minyaknya beserta seluruh kemenyannya sebagai korban api-apian bagi TUHAN.\""
 },
 {
   "id": 2781,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 1,
   "firman": "\"Jikalau persembahannya merupakan korban keselamatan, maka jikalau yang dipersembahkannya itu dari lembu, seekor jantan atau seekor betina, haruslah ia membawa yang tidak bercela ke hadapan TUHAN."
 },
 {
   "id": 2782,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 2,
   "firman": "Lalu ia harus meletakkan tangannya di atas kepala persembahannya itu, dan menyembelihnya di depan pintu Kemah Pertemuan, lalu anak-anak Harun, imam-imam itu haruslah menyiramkan darahnya pada mezbah sekelilingnya."
 },
 {
   "id": 2783,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 3,
   "firman": "Kemudian dari korban keselamatan itu ia harus mempersembahkan lemak yang menyelubungi isi perut, dan segala lemak yang melekat pada isi perut itu sebagai korban api-apian bagi TUHAN,"
 },
 {
   "id": 2784,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 4,
   "firman": "dan lagi kedua buah pinggang dan lemak yang melekat padanya, yang ada pada pinggang dan umbai hati yang harus dipisahkannya beserta buah pinggang itu."
 },
 {
   "id": 2785,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 5,
   "firman": "Anak-anak Harun harus membakarnya di atas mezbah, yakni di atas korban bakaran yang sedang dibakar di atas api, sebagai korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 2786,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 6,
   "firman": "Jikalau persembahannya untuk korban keselamatan bagi TUHAN adalah dari kambing domba, seekor jantan atau seekor betina, haruslah ia mempersembahkan yang tidak bercela."
 },
 {
   "id": 2787,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 7,
   "firman": "Jikalau ia mempersembahkan seekor domba sebagai persembahannya, ia harus membawanya ke hadapan TUHAN."
 },
 {
   "id": 2788,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 8,
   "firman": "Lalu ia harus meletakkan tangannya ke atas kepala persembahannya itu dan menyembelihnya di depan Kemah Pertemuan, lalu anak-anak Harun harus menyiramkan darahnya pada mezbah sekelilingnya."
 },
 {
   "id": 2789,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 9,
   "firman": "Kemudian dari korban keselamatan itu ia harus mempersembahkan lemaknya sebagai korban api-apian bagi TUHAN, yakni segenap ekornya yang berlemak yang harus dipotong dekat pada tulang belakang, dan lemak yang menyelubungi isi perut, dan segala lemak yang melekat pada isi perut itu,"
 },
 {
   "id": 2790,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 10,
   "firman": "dan lagi kedua buah pinggang dan lemak yang melekat padanya, yang ada pada pinggang, dan umbai hati yang harus dipisahkannya beserta buah pinggang itu."
 },
 {
   "id": 2791,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 11,
   "firman": "Imam harus membakarnya di atas mezbah sebagai santapan berupa korban api-apian bagi TUHAN."
 },
 {
   "id": 2792,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 12,
   "firman": "Jikalau persembahannya seekor kambing, ia harus membawanya ke hadapan TUHAN."
 },
 {
   "id": 2793,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 13,
   "firman": "Lalu ia harus meletakkan tangannya di atas kepala kambing itu dan menyembelihnya di depan Kemah Pertemuan, lalu anak-anak Harun harus menyiramkan darahnya pada mezbah sekelilingnya."
 },
 {
   "id": 2794,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 14,
   "firman": "Kemudian dari kambing itu ia harus mempersembahkan lemak yang menyelubungi isi perut, dan segala lemak yang melekat pada isi perut itu sebagai persembahannya berupa korban api-apian bagi TUHAN,"
 },
 {
   "id": 2795,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 15,
   "firman": "dan lagi kedua buah pinggang dan lemak yang melekat padanya, yang ada pada pinggang dan umbai hati yang harus dipisahkannya beserta buah pinggang itu."
 },
 {
   "id": 2796,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 16,
   "firman": "Imam harus membakar semuanya itu di atas mezbah sebagai santapan berupa korban api-apian menjadi bau yang menyenangkan. Segala lemak adalah kepunyaan TUHAN."
 },
 {
   "id": 2797,
   "kitab": "Ima",
   "pasal": 3,
   "ayat": 17,
   "firman": "Inilah suatu ketetapan untuk selamanya bagi kamu turun-temurun di segala tempat kediamanmu: janganlah sekali-kali kamu makan lemak dan darah.\""
 },
 {
   "id": 2798,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2799,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel: Apabila seseorang tidak dengan sengaja berbuat dosa dalam sesuatu hal yang dilarang TUHAN dan ia memang melakukan salah satu dari padanya,"
 },
 {
   "id": 2800,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 3,
   "firman": "maka jikalau yang berbuat dosa itu imam yang diurapi, sehingga bangsanya turut bersalah, haruslah ia mempersembahkan kepada TUHAN karena dosa yang telah diperbuatnya itu, seekor lembu jantan muda yang tidak bercela sebagai korban penghapus dosa."
 },
 {
   "id": 2801,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 4,
   "firman": "Ia harus membawa lembu itu ke pintu Kemah Pertemuan, ke hadapan TUHAN, lalu ia harus meletakkan tangannya ke atas kepala lembu itu, dan menyembelih lembu itu di hadapan TUHAN."
 },
 {
   "id": 2802,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 5,
   "firman": "Imam yang diurapi itu harus mengambil sebagian dari darah lembu itu, lalu membawanya ke dalam Kemah Pertemuan."
 },
 {
   "id": 2803,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 6,
   "firman": "Imam harus mencelupkan jarinya ke dalam darah itu, dan memercikkan sedikit dari darah itu, tujuh kali di hadapan TUHAN, di depan tabir penyekat tempat kudus."
 },
 {
   "id": 2804,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 7,
   "firman": "Kemudian imam itu harus membubuh sedikit dari darah itu pada tanduk-tanduk mezbah pembakaran ukupan dari wangi-wangian, yang ada di hadapan TUHAN di dalam Kemah Pertemuan, dan semua darah selebihnya harus dicurahkannya kepada bagian bawah mezbah korban bakaran yang di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2805,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 8,
   "firman": "Segala lemak lembu jantan korban penghapus dosa itu harus dikhususkannya dari lembu itu, yakni lemak yang menyelubungi isi perut dan segala lemak yang melekat pada isi perut itu,"
 },
 {
   "id": 2806,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 9,
   "firman": "dan lagi kedua buah pinggang dan lemak yang melekat padanya, yang ada pada pinggang, dan umbai hati yang harus dipisahkannya beserta buah pinggang itu,"
 },
 {
   "id": 2807,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 10,
   "firman": "sama seperti yang dikhususkan dari lembu korban keselamatan. Imam harus membakar semuanya di atas mezbah korban bakaran."
 },
 {
   "id": 2808,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 11,
   "firman": "Adapun kulit lembu jantan itu dan segala dagingnya, beserta kepala dan betisnya dan isi perutnya dan kotorannya,"
 },
 {
   "id": 2809,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 12,
   "firman": "jadi lembu jantan itu seluruhnya harus dibawanya ke luar perkemahan, ke suatu tempat yang tahir, ke tempat pembuangan abu, dan lembu itu harus dibakarnya sampai habis di atas kayu api di tempat pembuangan abu."
 },
 {
   "id": 2810,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 13,
   "firman": "Jikalau yang berbuat dosa dengan tak sengaja itu segenap umat Israel, dan jemaah tidak menyadarinya, sehingga mereka melakukan salah satu hal yang dilarang TUHAN, dan mereka bersalah,"
 },
 {
   "id": 2811,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 14,
   "firman": "maka apabila dosa yang diperbuat mereka itu ketahuan, haruslah jemaah itu mempersembahkan seekor lembu jantan yang muda sebagai korban penghapus dosa. Lembu itu harus dibawa mereka ke depan Kemah Pertemuan."
 },
 {
   "id": 2812,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 15,
   "firman": "Lalu para tua-tua umat itu harus meletakkan tangan mereka di atas kepala lembu jantan itu di hadapan TUHAN, dan lembu itu harus disembelih di hadapan TUHAN."
 },
 {
   "id": 2813,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 16,
   "firman": "Imam yang diurapi harus membawa sebagian dari darah lembu itu ke dalam Kemah Pertemuan."
 },
 {
   "id": 2814,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 17,
   "firman": "Imam harus mencelupkan jarinya ke dalam darah itu dan memercikkannya tujuh kali di hadapan TUHAN, di depan tabir."
 },
 {
   "id": 2815,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 18,
   "firman": "Kemudian dari darah itu harus dibubuhnya sedikit pada tanduk-tanduk mezbah yang di hadapan TUHAN di dalam Kemah Pertemuan, dan semua darah selebihnya harus dicurahkannya kepada bagian bawah mezbah korban bakaran yang di depan pintu Kemah Pertemuan."
 },
 {
   "id": 2816,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 19,
   "firman": "Segala lemak harus dikhususkannya dari lembu itu dan dibakarnya di atas mezbah."
 },
 {
   "id": 2817,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 20,
   "firman": "Beginilah harus diperbuatnya dengan lembu jantan itu: seperti yang diperbuatnya dengan lembu jantan korban penghapus dosa, demikianlah harus diperbuatnya dengan lembu itu. Dengan demikian imam itu mengadakan pendamaian bagi mereka, sehingga mereka menerima pengampunan."
 },
 {
   "id": 2818,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 21,
   "firman": "Dan haruslah ia membawa lembu jantan itu ke luar perkemahan, lalu membakarnya sampai habis seperti ia membakar habis lembu jantan yang pertama. Itulah korban penghapus dosa untuk jemaah."
 },
 {
   "id": 2819,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 22,
   "firman": "Jikalau yang berbuat dosa itu seorang pemuka yang tidak dengan sengaja melakukan salah satu hal yang dilarang TUHAN, Allahnya, sehingga ia bersalah,"
 },
 {
   "id": 2820,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 23,
   "firman": "maka jikalau dosa yang telah diperbuatnya itu diberitahukan kepadanya, haruslah ia membawa sebagai persembahannya seekor kambing jantan yang tidak bercela."
 },
 {
   "id": 2821,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 24,
   "firman": "Lalu haruslah ia meletakkan tangannya ke atas kepala kambing itu dan menyembelihnya di tempat yang biasa orang menyembelih korban bakaran di hadapan TUHAN; itulah korban penghapus dosa."
 },
 {
   "id": 2822,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 25,
   "firman": "Kemudian haruslah imam mengambil dengan jarinya sedikit dari darah korban penghapus dosa itu, lalu membubuhnya pada tanduk-tanduk mezbah korban bakaran. Darah selebihnya haruslah dicurahkannya kepada bagian bawah mezbah korban bakaran."
 },
 {
   "id": 2823,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 26,
   "firman": "Tetapi segala lemak harus dibakarnya di atas mezbah, seperti juga lemak korban keselamatan. Dengan demikian imam mengadakan pendamaian bagi orang itu karena dosanya, sehingga ia menerima pengampunan."
 },
 {
   "id": 2824,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 27,
   "firman": "Jikalau yang berbuat dosa dengan tak sengaja itu seorang dari rakyat jelata, dan ia melakukan salah satu hal yang dilarang TUHAN, sehingga ia bersalah,"
 },
 {
   "id": 2825,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 28,
   "firman": "maka jikalau dosa yang telah diperbuatnya itu diberitahukan kepadanya, haruslah ia membawa sebagai persembahannya karena dosa yang telah diperbuatnya itu seekor kambing betina yang tidak bercela."
 },
 {
   "id": 2826,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 29,
   "firman": "Lalu haruslah ia meletakkan tangannya ke atas kepala korban penghapus dosa dan menyembelih korban itu di tempat korban bakaran."
 },
 {
   "id": 2827,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 30,
   "firman": "Kemudian imam harus mengambil dengan jarinya sedikit dari darah korban itu, lalu membubuhnya pada tanduk-tanduk mezbah korban bakaran. Semua darah selebihnya haruslah dicurahkannya kepada bagian bawah mezbah."
 },
 {
   "id": 2828,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 31,
   "firman": "Tetapi segala lemak haruslah dipisahkannya, seperti juga lemak korban keselamatan dipisahkan, lalu haruslah dibakar oleh imam di atas mezbah menjadi bau yang menyenangkan bagi TUHAN. Dengan demikian imam mengadakan pendamaian bagi orang itu sehingga ia menerima pengampunan."
 },
 {
   "id": 2829,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 32,
   "firman": "Jika ia membawa seekor domba sebagai persembahannya menjadi korban penghapus dosa, haruslah ia membawa seekor betina yang tidak bercela."
 },
 {
   "id": 2830,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 33,
   "firman": "Lalu haruslah ia meletakkan tangannya ke atas kepala korban penghapus dosa itu, dan menyembelihnya menjadi korban penghapus dosa di tempat yang biasa orang menyembelih korban bakaran."
 },
 {
   "id": 2831,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 34,
   "firman": "Kemudian imam harus mengambil dengan jarinya sedikit dari darah korban penghapus dosa itu, lalu membubuhnya pada tanduk-tanduk mezbah korban bakaran. Semua darah selebihnya haruslah dicurahkannya kepada bagian bawah mezbah."
 },
 {
   "id": 2832,
   "kitab": "Ima",
   "pasal": 4,
   "ayat": 35,
   "firman": "Tetapi segala lemak haruslah dipisahkannya, seperti juga lemak domba korban keselamatan dipisahkan, lalu imam harus membakar semuanya itu di atas mezbah di atas segala korban api-apian TUHAN. Dengan demikian imam mengadakan pendamaian bagi orang itu karena dosa yang telah diperbuatnya, sehingga ia menerima pengampunan."
 },
 {
   "id": 2833,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 1,
   "firman": "Apabila seseorang berbuat dosa, yakni jika ia mendengar seorang mengutuki, dan ia dapat naik saksi karena ia melihat atau mengetahuinya, tetapi ia tidak mau memberi keterangan, maka ia harus menanggung kesalahannya sendiri."
 },
 {
   "id": 2834,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 2,
   "firman": "Atau bila seseorang kena kepada sesuatu yang najis, baik bangkai binatang liar yang najis, atau bangkai hewan yang najis, atau bangkai binatang yang mengeriap yang najis, tanpa menyadari hal itu, maka ia menjadi najis dan bersalah."
 },
 {
   "id": 2835,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 3,
   "firman": "Atau apabila ia kena kepada kenajisan berasal dari manusia, dengan kenajisan apapun juga ia menjadi najis, tanpa menyadari hal itu, tetapi kemudian ia mengetahuinya, maka ia bersalah."
 },
 {
   "id": 2836,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 4,
   "firman": "Atau apabila seseorang bersumpah teledor dengan bibirnya hendak berbuat yang buruk atau yang baik, sumpah apapun juga yang diucapkan orang dengan teledor, tanpa menyadari hal itu, tetapi kemudian ia mengetahuinya, maka ia bersalah dalam salah satu perkara itu."
 },
 {
   "id": 2837,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 5,
   "firman": "Jadi apabila ia bersalah dalam salah satu perkara itu, haruslah ia mengakui dosa yang telah diperbuatnya itu,"
 },
 {
   "id": 2838,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 6,
   "firman": "dan haruslah ia mempersembahkan kepada TUHAN sebagai tebusan salah karena dosa itu seekor betina dari domba atau kambing, menjadi korban penghapus dosa. Dengan demikian imam mengadakan pendamaian bagi orang itu karena dosanya."
 },
 {
   "id": 2839,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 7,
   "firman": "Tetapi jikalau ia tidak mampu untuk menyediakan kambing atau domba, maka sebagai tebusan salah karena dosa yang telah diperbuatnya itu, haruslah ia mempersembahkan kepada TUHAN dua ekor burung tekukur atau dua ekor anak burung merpati, yang seekor menjadi korban penghapus dosa dan yang seekor lagi menjadi korban bakaran."
 },
 {
   "id": 2840,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 8,
   "firman": "Haruslah ia membawanya kepada imam, dan imam itu haruslah lebih dahulu mempersembahkan burung untuk korban penghapus dosa itu. Dan haruslah ia memulas kepalanya pada pangkal tengkuknya, tetapi tidak sampai terpisah."
 },
 {
   "id": 2841,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 9,
   "firman": "Sedikit dari darah korban penghapus dosa itu haruslah dipercikkannya ke dinding mezbah, tetapi darah selebihnya haruslah ditekan ke luar pada bagian bawah mezbah; itulah korban penghapus dosa."
 },
 {
   "id": 2842,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 10,
   "firman": "Yang kedua haruslah diolahnya menjadi korban bakaran, sesuai dengan peraturan. Dengan demikian imam mengadakan pendamaian bagi orang itu karena dosa yang telah diperbuatnya, sehingga ia menerima pengampunan."
 },
 {
   "id": 2843,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 11,
   "firman": "Tetapi jikalau ia tidak mampu menyediakan dua ekor burung tekukur atau dua ekor anak burung merpati, maka haruslah ia membawa sebagai persembahannya karena dosanya itu sepersepuluh efa tepung yang terbaik menjadi korban penghapus dosa. Tidak boleh ditaruhnya minyak dan dibubuhnya kemenyan di atasnya, karena itulah korban penghapus dosa."
 },
 {
   "id": 2844,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 12,
   "firman": "Lalu haruslah itu dibawanya kepada imam dan imam itu haruslah mengambil dari padanya segenggam sebagai bagian ingat-ingatannya, lalu membakarnya di atas mezbah di atas segala korban."
 },
 {
   "id": 2845,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 13,
   "firman": "Dengan demikian imam mengadakan pendamaian bagi orang itu karena dosanya dalam salah satu perkara itu, sehingga ia menerima pengampunan. Selebihnya adalah bagian imam, sama seperti korban sajian.\""
 },
 {
   "id": 2846,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 14,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2847,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 15,
   "firman": "\"Apabila seseorang berubah setia dan tidak sengaja berbuat dosa dalam sesuatu hal kudus yang dipersembahkan kepada TUHAN, maka haruslah ia mempersembahkan kepada TUHAN sebagai tebusan salahnya seekor domba jantan yang tidak bercela dari kambing domba, dinilai menurut syikal perak, yakni menurut syikal kudus, menjadi korban penebus salah."
 },
 {
   "id": 2848,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 16,
   "firman": "Hal kudus yang menyebabkan orang itu berdosa, haruslah dibayar gantinya dengan menambah seperlima, lalu menyerahkannya kepada imam. Imam harus mengadakan pendamaian bagi orang itu dengan domba jantan korban penebus salah itu, sehingga ia menerima pengampunan."
 },
 {
   "id": 2849,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 17,
   "firman": "Jikalau seseorang berbuat dosa dengan melakukan salah satu hal yang dilarang TUHAN tanpa mengetahuinya, maka ia bersalah dan harus menanggung kesalahannya sendiri."
 },
 {
   "id": 2850,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 18,
   "firman": "Haruslah ia membawa kepada imam seekor domba jantan yang tidak bercela dari kambing domba, yang sudah dinilai, sebagai korban penebus salah. Imam itu haruslah mengadakan pendamaian bagi orang itu karena perbuatan yang tidak disengajanya dan yang tidak diketahuinya itu, sehingga ia menerima pengampunan."
 },
 {
   "id": 2851,
   "kitab": "Ima",
   "pasal": 5,
   "ayat": 19,
   "firman": "Itulah korban penebus salah; orang itu sungguh bersalah terhadap TUHAN.\""
 },
 {
   "id": 2852,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2853,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 2,
   "firman": "\"Apabila seseorang berbuat dosa dan berubah setia terhadap TUHAN, dan memungkiri terhadap sesamanya barang yang dipercayakan kepadanya, atau barang yang diserahkan kepadanya atau barang yang dirampasnya, atau apabila ia telah melakukan pemerasan atas sesamanya,"
 },
 {
   "id": 2854,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 3,
   "firman": "atau bila ia menemui barang hilang, dan memungkirinya, dan ia bersumpah dusta--dalam perkara apapun yang diperbuat seseorang, sehingga ia berdosa--"
 },
 {
   "id": 2855,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 4,
   "firman": "apabila dengan demikian ia berbuat dosa dan bersalah, maka haruslah ia memulangkan barang yang telah dirampasnya atau yang telah diperasnya atau yang telah dipercayakan kepadanya atau barang hilang yang ditemuinya itu,"
 },
 {
   "id": 2856,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 5,
   "firman": "atau segala sesuatu yang dimungkirinya dengan bersumpah dusta. Haruslah ia membayar gantinya sepenuhnya dengan menambah seperlima; haruslah ia menyerahkannya kepada pemiliknya pada hari ia mempersembahkan korban penebus salahnya."
 },
 {
   "id": 2857,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 6,
   "firman": "Sebagai korban penebus salahnya haruslah ia mempersembahkan kepada TUHAN seekor domba jantan yang tidak bercela dari kambing domba, yang sudah dinilai, menjadi korban penebus salah, dengan menyerahkannya kepada imam."
 },
 {
   "id": 2858,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 7,
   "firman": "Imam harus mengadakan pendamaian bagi orang itu di hadapan TUHAN, sehingga ia menerima pengampunan atas perkara apapun yang diperbuatnya sehingga ia bersalah.\""
 },
 {
   "id": 2859,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 8,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2860,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 9,
   "firman": "\"Perintahkanlah kepada Harun dan anak-anaknya: Inilah hukum tentang korban bakaran. Korban bakaran itu haruslah tinggal di atas perapian di atas mezbah semalam-malaman sampai pagi, dan api mezbah haruslah dipelihara menyala di atasnya."
 },
 {
   "id": 2861,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 10,
   "firman": "Imam haruslah mengenakan pakaian lenannya, dan mengenakan celana lenan untuk menutup auratnya. Lalu ia harus mengangkat abu yang ada di atas mezbah sesudah korban bakaran habis dimakan api, dan haruslah ia membuangnya di samping mezbah."
 },
 {
   "id": 2862,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 11,
   "firman": "Kemudian haruslah ia menanggalkan pakaiannya dan mengenakan pakaian lain, lalu membawa abu itu ke luar perkemahan ke suatu tempat yang tahir."
 },
 {
   "id": 2863,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 12,
   "firman": "Api yang di atas mezbah itu harus dijaga supaya terus menyala, jangan dibiarkan padam. Tiap-tiap pagi imam harus menaruh kayu di atas mezbah, mengatur korban bakaran di atasnya dan membakar segala lemak korban keselamatan di sana."
 },
 {
   "id": 2864,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 13,
   "firman": "Harus dijaga supaya api tetap menyala di atas mezbah, janganlah dibiarkan padam.\""
 },
 {
   "id": 2865,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 14,
   "firman": "\"Inilah hukum tentang korban sajian. Anak-anak Harun haruslah membawanya ke hadapan TUHAN ke depan mezbah."
 },
 {
   "id": 2866,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 15,
   "firman": "Setelah dikhususkan dari korban sajian itu segenggam tepung yang terbaik dengan minyak, serta seluruh kemenyan yang di atas korban sajian itu, maka haruslah semuanya dibakar di atas mezbah sehingga baunya menyenangkan sebagai bagian ingat-ingatannya bagi TUHAN."
 },
 {
   "id": 2867,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 16,
   "firman": "Selebihnya haruslah dimakan oleh Harun dan anak-anaknya; haruslah itu dimakan sebagai roti yang tidak beragi di suatu tempat yang kudus, haruslah mereka memakannya di pelataran Kemah Pertemuan."
 },
 {
   "id": 2868,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 17,
   "firman": "Janganlah itu dibakar beragi. Telah Kuberikan itu sebagai bagian mereka dari pada segala korban api-apian-Ku; itulah bagian maha kudus, sama seperti korban penghapus dosa dan korban penghapus salah."
 },
 {
   "id": 2869,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 18,
   "firman": "Setiap laki-laki di antara anak-anak Harun haruslah memakannya; itulah suatu ketetapan untuk selamanya bagi kamu turun-temurun; itulah bagianmu dari segala korban api-apian TUHAN. Setiap orang yang kena kepada korban-korban itu menjadi kudus.\""
 },
 {
   "id": 2870,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 19,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2871,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 20,
   "firman": "\"Inilah persembahan Harun dan anak-anaknya, yang harus dipersembahkan oleh mereka kepada TUHAN pada hari ia diurapi: sepersepuluh efa tepung yang terbaik sebagai korban sajian yang tetap, setengahnya pada waktu pagi dan setengahnya pada waktu petang."
 },
 {
   "id": 2872,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 21,
   "firman": "Haruslah itu diolah di atas panggangan bersama-sama minyak, setelah teraduk haruslah engkau membawanya dan mempersembahkannya sebagai korban sajian, sesudah dibakar dan berpotong-potong sebagai bau yang menyenangkan bagi TUHAN."
 },
 {
   "id": 2873,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 22,
   "firman": "Dan imam dari antara anak-anaknya yang diurapi sebagai penggantinya, haruslah mengolahnya; itulah suatu ketetapan untuk selamanya. Seluruhnya haruslah dibakar bagi TUHAN."
 },
 {
   "id": 2874,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 23,
   "firman": "Tiap-tiap korban sajian dari seorang imam itu haruslah menjadi korban yang terbakar seluruhnya, janganlah dimakan.\""
 },
 {
   "id": 2875,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 24,
   "firman": "TUHAN berfirman kepada Musa, demikian:"
 },
 {
   "id": 2876,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 25,
   "firman": "\"Katakanlah kepada Harun dan anak-anaknya: Inilah hukum tentang korban penghapus dosa. Di tempat korban bakaran disembelih, di situlah harus disembelih korban penghapus dosa di hadapan TUHAN. Itulah persembahan maha kudus."
 },
 {
   "id": 2877,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 26,
   "firman": "Imam yang mempersembahkan korban penghapus dosa itulah yang harus memakannya; haruslah itu dimakan di suatu tempat yang kudus, di pelataran Kemah Pertemuan."
 },
 {
   "id": 2878,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 27,
   "firman": "Setiap orang yang kena kepada daging korban itu menjadi kudus, dan bila darahnya ada yang tepercik kepada sesuatu pakaian, haruslah engkau mencuci pakaian itu di suatu tempat yang kudus."
 },
 {
   "id": 2879,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 28,
   "firman": "Dan belanga tanah, tempat korban itu dimasak, haruslah dipecahkan, dan jikalau dimasak di dalam belanga tembaga, haruslah belanga itu digosok dan dibasuh dengan air."
 },
 {
   "id": 2880,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 29,
   "firman": "Setiap laki-laki di antara para imam haruslah memakannya; itulah persembahan maha kudus."
 },
 {
   "id": 2881,
   "kitab": "Ima",
   "pasal": 6,
   "ayat": 30,
   "firman": "Tetapi setiap korban penghapus dosa, yang dari darahnya dibawa sebagian ke dalam Kemah Pertemuan untuk mengadakan pendamaian di dalam tempat kudus, janganlah dimakan, melainkan dibakar habis dengan api.\""
 },
 {
   "id": 2882,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 1,
   "firman": "\"Inilah hukum tentang korban penebus salah. Korban itu ialah persembahan maha kudus."
 },
 {
   "id": 2883,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 2,
   "firman": "Di tempat orang menyembelih korban bakaran, di situlah harus disembelih korban penebus salah, dan darahnya haruslah disiramkan pada mezbah itu sekelilingnya."
 },
 {
   "id": 2884,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 3,
   "firman": "Segala lemak dari korban itu haruslah dipersembahkan, yakni ekornya yang berlemak dan lemak yang menutupi isi perut,"
 },
 {
   "id": 2885,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 4,
   "firman": "dan lagi kedua buah pinggang dan lemak yang melekat padanya, yang ada pada pinggang, dan umbai hati yang harus dipisahkan beserta buah pinggang itu."
 },
 {
   "id": 2886,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 5,
   "firman": "Haruslah imam membakar semuanya itu di atas mezbah sebagai korban api-apian bagi TUHAN; itulah korban penebus salah."
 },
 {
   "id": 2887,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 6,
   "firman": "Setiap laki-laki di antara para imam haruslah memakannya; haruslah itu dimakan di suatu tempat yang kudus; itulah bagian maha kudus."
 },
 {
   "id": 2888,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 7,
   "firman": "Seperti halnya dengan korban penghapus dosa, demikian juga halnya dengan korban penebus salah; satu hukum berlaku atas keduanya: imam yang mengadakan pendamaian dengan korban itu, bagi dialah korban itu."
 },
 {
   "id": 2889,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 8,
   "firman": "Imam yang mempersembahkan korban bakaran seseorang, bagi dia juga kulit korban bakaran yang dipersembahkannya itu."
 },
 {
   "id": 2890,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 9,
   "firman": "Tiap-tiap korban sajian yang dibakar di dalam pembakaran roti, dan segala yang diolah di dalam wajan dan di atas panggangan adalah bagi imam yang mempersembahkannya."
 },
 {
   "id": 2891,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 10,
   "firman": "Tiap-tiap korban sajian yang diolah dengan minyak atau yang kering adalah bagi semua anak-anak Harun, semuanya dapat bagian.\""
 },
 {
   "id": 2892,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 11,
   "firman": "\"Inilah hukum tentang korban keselamatan, yang harus dipersembahkan orang kepada TUHAN."
 },
 {
   "id": 2893,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 12,
   "firman": "Jikalau ia mempersembahkannya untuk memberi syukur, haruslah beserta korban syukur itu dipersembahkannya roti bundar yang tidak beragi yang diolah dengan minyak, dan roti tipis yang tidak beragi yang diolesi dengan minyak, serta roti bundar dari tepung yang terbaik yang teraduk, yang diolah dengan minyak."
 },
 {
   "id": 2894,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 13,
   "firman": "Ia harus mempersembahkan persembahannya itu beserta dengan roti bundar yang beragi, di samping korban syukur yang menjadi korban keselamatannya."
 },
 {
   "id": 2895,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 14,
   "firman": "Dan dari padanya, yakni dari setiap bagian persembahan itu haruslah dipersembahkannya satu roti sebagai persembahan khusus bagi TUHAN. Persembahan itu adalah bagian imam yang menyiramkan darah korban keselamatan."
 },
 {
   "id": 2896,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 15,
   "firman": "Dan daging korban syukur yang menjadi korban keselamatannya itu haruslah dimakan pada hari dipersembahkannya itu. Sedikitpun dari padanya janganlah ditinggalkan sampai pagi."
 },
 {
   "id": 2897,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 16,
   "firman": "Jikalau korban sembelihan yang dipersembahkan itu merupakan korban nazar atau korban sukarela, haruslah itu dimakan pada hari mempersembahkannya dan yang selebihnya boleh juga dimakan pada keesokan harinya."
 },
 {
   "id": 2898,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 17,
   "firman": "Tetapi apa yang masih tinggal dari daging korban sembelihan itu sampai hari yang ketiga, haruslah dibakar habis dengan api."
 },
 {
   "id": 2899,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 18,
   "firman": "Karena jikalau pada hari yang ketiga masih dimakan dari daging korban keselamatan itu, maka TUHAN tidak berkenan akan orang yang mempersembahkannya dan korban itu dianggap batal baginya, bahkan menjadi sesuatu yang jijik, dan orang yang memakannya harus menanggung kesalahannya sendiri."
 },
 {
   "id": 2900,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 19,
   "firman": "Bila daging itu kena kepada sesuatu yang najis, janganlah dimakan, tetapi haruslah dibakar habis dengan api. Tiap-tiap orang yang tahir boleh memakan dari daging korban itu."
 },
 {
   "id": 2901,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 20,
   "firman": "Tetapi seseorang yang memakan daging dari korban keselamatan yang untuk TUHAN, sedang ia dalam keadaan najis, haruslah nyawa orang itu dilenyapkan dari antara bangsanya."
 },
 {
   "id": 2902,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 21,
   "firman": "Dan apabila seseorang kena kepada sesuatu yang najis, yakni kepada kenajisan berasal dari manusia, atau kepada hewan yang najis atau kepada setiap binatang yang merayap yang najis, lalu memakan dari pada daging korban keselamatan yang untuk TUHAN, maka haruslah nyawa orang itu dilenyapkan dari antara bangsanya.\""
 },
 {
   "id": 2903,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 22,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2904,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 23,
   "firman": "\"Katakanlah kepada orang Israel: Segala lemak dari lembu, domba ataupun kambing janganlah kamu makan."
 },
 {
   "id": 2905,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 24,
   "firman": "Lemak bangkai atau lemak binatang yang mati diterkam boleh dipergunakan untuk segala keperluan, tetapi jangan sekali-kali kamu memakannya."
 },
 {
   "id": 2906,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 25,
   "firman": "Karena setiap orang yang memakan lemak dari hewan yang dipergunakan untuk mempersembahkan korban api-apian bagi TUHAN, nyawa orang yang memakan itu, haruslah dilenyapkan dari antara bangsanya."
 },
 {
   "id": 2907,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 26,
   "firman": "Demikian juga janganlah kamu memakan darah apapun di segala tempat kediamanmu, baik darah burung-burung ataupun darah hewan."
 },
 {
   "id": 2908,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 27,
   "firman": "Setiap orang yang memakan darah apapun, nyawa orang itu haruslah dilenyapkan dari antara bangsanya.\""
 },
 {
   "id": 2909,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 28,
   "firman": "TUHAN berfirman kepada Musa, demikian:"
 },
 {
   "id": 2910,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 29,
   "firman": "\"Katakanlah kepada orang Israel: Orang yang mempersembahkan korban keselamatannya kepada TUHAN, haruslah membawa kepada TUHAN sebagian dari korban keselamatannya itu sebagai persembahannya."
 },
 {
   "id": 2911,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 30,
   "firman": "Dengan tangannya sendirilah harus ia membawa segala korban api-apian TUHAN; adapun lemaknya, haruslah dibawanya beserta dadanya, supaya dadanya itu diunjukkan sebagai persembahan unjukan di hadapan TUHAN."
 },
 {
   "id": 2912,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 31,
   "firman": "Lalu haruslah imam membakar lemaknya di atas mezbah, tetapi dadanya itu adalah bagian Harun dan anak-anaknya."
 },
 {
   "id": 2913,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 32,
   "firman": "Paha kanannya harus kamu serahkan kepada imam sebagai persembahan khusus dari segala korban keselamatanmu."
 },
 {
   "id": 2914,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 33,
   "firman": "Siapa dari antara anak-anak Harun yang mempersembahkan darah dan lemak korban keselamatan, maka dialah yang harus mendapat paha kanan itu sebagai bagiannya."
 },
 {
   "id": 2915,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 34,
   "firman": "Karena dada persembahan unjukan dan paha persembahan khusus telah Kuambil dari orang Israel dari segala korban keselamatan mereka dan telah Kuberikan kepada imam Harun, dan kepada anak-anaknya; itulah suatu ketetapan yang berlaku bagi orang Israel untuk selamanya.\""
 },
 {
   "id": 2916,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 35,
   "firman": "Itulah bagian Harun dan bagian anak-anaknya dari segala korban api-apian TUHAN pada hari mereka itu disuruh datang untuk memegang jabatan imam bagi TUHAN;"
 },
 {
   "id": 2917,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 36,
   "firman": "itulah yang harus diserahkan menurut perintah TUHAN dari pihak Israel kepada mereka pada hari mereka itu diurapi-Nya; itulah suatu ketetapan untuk selamanya bagi mereka turun-temurun."
 },
 {
   "id": 2918,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 37,
   "firman": "Itulah hukum tentang korban bakaran, korban sajian, korban penghapus dosa, korban penebus salah, persembahan pentahbisan dan korban keselamatan,"
 },
 {
   "id": 2919,
   "kitab": "Ima",
   "pasal": 7,
   "ayat": 38,
   "firman": "yang diperintahkan TUHAN kepada Musa di atas gunung Sinai pada hari TUHAN memerintahkan kepada orang Israel mempersembahkan persembahan mereka kepada TUHAN di padang gurun Sinai."
 },
 {
   "id": 2920,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 2921,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 2,
   "firman": "\"Panggillah Harun dan anak-anaknya bersama-sama dengan dia, dan ambillah pakaian-pakaian, minyak urapan, dan lembu jantan korban penghapus dosa, dua domba jantan dan bakul berisi roti yang tidak beragi,"
 },
 {
   "id": 2922,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 3,
   "firman": "lalu suruhlah berkumpul segenap umat ke depan pintu Kemah Pertemuan.\""
 },
 {
   "id": 2923,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 4,
   "firman": "Musa melakukan seperti yang diperintahkan TUHAN kepadanya, lalu berkumpullah umat itu di depan Kemah Pertemuan."
 },
 {
   "id": 2924,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 5,
   "firman": "Berkatalah Musa kepada umat itu: \"Inilah firman yang diperintahkan TUHAN untuk dilakukan.\""
 },
 {
   "id": 2925,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 6,
   "firman": "Lalu Musa menyuruh Harun dan anak-anaknya mendekat, dan dibasuhnyalah mereka dengan air."
 },
 {
   "id": 2926,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 7,
   "firman": "Sesudah itu dikenakannyalah kemeja kepadanya, diikatkannya ikat pinggang, dikenakannya gamis, dikenakannya baju efod, diikatkannya sabuk baju efod dan dikebatkannya sabuk itu kepadanya."
 },
 {
   "id": 2927,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 8,
   "firman": "Dikenakannyalah tutup dada kepadanya dan dibubuhnya di dalam tutup dada itu Urim dan Tumim."
 },
 {
   "id": 2928,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 9,
   "firman": "Kemudian ditaruhnyalah serban di kepalanya, dan di atas serban itu di sebelah depan ditaruhnyalah patam emas, yakni jamang yang kudus, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2929,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 10,
   "firman": "Musa mengambil minyak urapan, lalu diurapinyalah Kemah Suci serta segala yang ada di dalamnya dan dikuduskannya semuanya itu."
 },
 {
   "id": 2930,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 11,
   "firman": "Dipercikkannyalah sedikit dari minyak itu ke mezbah tujuh kali dan diurapinya mezbah itu serta segala perkakasnya, dan juga bejana pembasuhan serta alasnya untuk menguduskannya."
 },
 {
   "id": 2931,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 12,
   "firman": "Kemudian dituangkannya sedikit dari minyak urapan itu ke atas kepala Harun dan diurapinyalah dia untuk menguduskannya."
 },
 {
   "id": 2932,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 13,
   "firman": "Musa menyuruh anak-anak Harun mendekat, lalu dikenakannyalah kemeja kepada mereka, diikatkannya ikat pinggang dan dililitkannya destar, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2933,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 14,
   "firman": "Disuruhnyalah membawa lembu jantan korban penghapus dosa, lalu Harun dan anak-anaknya meletakkan tangannya ke atas kepala lembu jantan korban penghapus dosa itu."
 },
 {
   "id": 2934,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 15,
   "firman": "Lembu itu disembelih, lalu Musa mengambil darahnya, kemudian dengan jarinya dibubuhnyalah darah itu pada tanduk-tanduk mezbah sekelilingnya, dan dengan demikian disucikannyalah mezbah itu dari dosa; darah selebihnya dituangkannya pada bagian bawah mezbah. Dengan demikian dikuduskannya mezbah itu dan diadakannya pendamaian baginya."
 },
 {
   "id": 2935,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 16,
   "firman": "Diambillah segala lemak yang melekat pada isi perut, umbai hati, kedua buah pinggang serta lemaknya, lalu Musa membakarnya di atas mezbah."
 },
 {
   "id": 2936,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 17,
   "firman": "Tetapi lembu jantan itu dengan kulit, daging dan kotorannya dibakarnya habis di luar perkemahan, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2937,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 18,
   "firman": "Kemudian disuruhnya membawa domba jantan korban bakaran, lalu Harun dan anak-anaknya meletakkan tangannya ke atas kepala domba jantan itu."
 },
 {
   "id": 2938,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 19,
   "firman": "Domba itu disembelih, lalu Musa menyiramkan darahnya pada mezbah sekelilingnya."
 },
 {
   "id": 2939,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 20,
   "firman": "Domba itu dipotong-potong menurut bagian-bagian tertentu, lalu Musa membakar kepalanya dan bagian-bagiannya dan lemaknya."
 },
 {
   "id": 2940,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 21,
   "firman": "Tetapi isi perut dan betisnya dibasuh dengan air, lalu Musa membakar seluruh domba jantan itu di atas mezbah. Itulah korban bakaran, yang baunya menyenangkan; yakni suatu korban api-apian bagi TUHAN, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2941,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 22,
   "firman": "Kemudian disuruhnya membawa domba jantan yang lain, yakni domba persembahan pentahbisan, lalu Harun dan anak-anaknya meletakkan tangannya ke atas kepala domba jantan itu."
 },
 {
   "id": 2942,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 23,
   "firman": "Domba jantan itu disembelih, lalu Musa mengambil sedikit dari darahnya dan membubuhnya pada cuping telinga kanan Harun, pada ibu jari tangan kanan dan pada ibu jari kaki kanannya."
 },
 {
   "id": 2943,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 24,
   "firman": "Musa menyuruh anak-anak Harun mendekat, lalu membubuh sedikit dari darah itu pada cuping telinga kanan mereka, pada ibu jari tangan kanan dan pada ibu jari kaki kanan mereka, lalu Musa menyiramkan darah selebihnya pada mezbah sekelilingnya."
 },
 {
   "id": 2944,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 25,
   "firman": "Diambilnyalah lemaknya, ekornya yang berlemak, segala lemaknya yang melekat pada isi perut, umbai hatinya, kedua buah pinggang serta lemaknya dan paha kanannya."
 },
 {
   "id": 2945,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 26,
   "firman": "Dan dari dalam bakul berisi roti yang tidak beragi, yang ada di hadapan TUHAN, diambilnyalah satu roti bundar yang tidak beragi, satu roti bundar yang diolah dengan minyak dan satu roti tipis, lalu diletakkannya di atas segala lemak dan di atas paha kanan itu,"
 },
 {
   "id": 2946,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 27,
   "firman": "dan ditaruhnya seluruhnya di telapak tangan Harun dan di telapak tangan anak-anaknya, dan dipersembahkannya semuanya sebagai persembahan unjukan di hadapan TUHAN."
 },
 {
   "id": 2947,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 28,
   "firman": "Kemudian Musa mengambil semuanya dari telapak tangan mereka, lalu dibakarnya di atas mezbah, yaitu di atas korban bakaran. Itulah persembahan pentahbisan untuk menjadi bau yang menyenangkan; itulah suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 2948,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 29,
   "firman": "Musa mengambil dada domba itu, dan mempersembahkannya sebagai persembahan unjukan di hadapan TUHAN. Itulah yang didapat Musa sebagai bagiannya dari domba jantan persembahan pentahbisan itu, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2949,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 30,
   "firman": "Dan lagi Musa mengambil sedikit dari minyak urapan dan dari darah yang di atas mezbah itu, lalu dipercikkannya kepada Harun, ke pakaiannya, dan juga kepada anak-anaknya dan ke pakaian anak-anaknya. Dengan demikian ditahbiskannyalah Harun, pakaiannya, dan juga anak-anaknya dan pakaian anak-anaknya."
 },
 {
   "id": 2950,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 31,
   "firman": "Berkatalah Musa kepada Harun dan kepada anak-anaknya: \"Masaklah daging itu di depan pintu Kemah Pertemuan; di sanalah harus kamu memakannya dengan roti yang ada di dalam bakul untuk persembahan pentahbisan, seperti yang telah kuperintahkan dengan berkata: Harun dan anak-anaknya haruslah memakannya."
 },
 {
   "id": 2951,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 32,
   "firman": "Dan apa yang tinggal dari daging dan roti itu haruslah kamu bakar habis dengan api."
 },
 {
   "id": 2952,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 33,
   "firman": "Janganlah kamu pergi dari depan pintu Kemah Pertemuan selama tujuh hari, sampai kepada genapnya perayaan pentahbisan, karena perayaan pentahbisan akan berlangsung tujuh hari lamanya."
 },
 {
   "id": 2953,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 34,
   "firman": "Seperti yang diperbuat pada hari ini, demikian juga diperintahkan TUHAN kamu perbuat kelak untuk mengadakan pendamaian bagimu."
 },
 {
   "id": 2954,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 35,
   "firman": "Di depan pintu Kemah Pertemuan haruslah kamu tinggal siang malam tujuh hari lamanya, dan kamu harus lakukan kewajibanmu terhadap TUHAN dengan setia, supaya janganlah kamu mati, karena demikianlah diperintahkan kepadaku.\""
 },
 {
   "id": 2955,
   "kitab": "Ima",
   "pasal": 8,
   "ayat": 36,
   "firman": "Maka Harun dan anak-anaknya melakukan segala firman yang diperintahkan TUHAN dengan perantaraan Musa."
 },
 {
   "id": 2956,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 1,
   "firman": "Pada hari yang kedelapan Musa memanggil Harun serta anak-anaknya dan para tua-tua Israel,"
 },
 {
   "id": 2957,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 2,
   "firman": "lalu berkatalah ia kepada Harun: \"Ambillah bagimu sendiri seekor lembu muda, untuk korban penghapus dosa, dan seekor domba jantan untuk korban bakaran, kedua-duanya yang tidak bercela, kemudian persembahkanlah itu di hadapan TUHAN."
 },
 {
   "id": 2958,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 3,
   "firman": "Dan kepada orang Israel haruslah engkau berkata, begini: Ambillah seekor kambing jantan untuk korban penghapus dosa, dan seekor anak lembu dan seekor domba, masing-masing berumur setahun dan yang tidak bercela, untuk korban bakaran."
 },
 {
   "id": 2959,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 4,
   "firman": "Dan lagi seekor lembu dan seekor domba jantan untuk korban keselamatan, supaya dikorbankan di hadapan TUHAN, dan korban sajian yang diolah dengan minyak, karena pada hari ini TUHAN akan menampakkan diri kepadamu.\""
 },
 {
   "id": 2960,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 5,
   "firman": "Kemudian dibawa merekalah apa yang diperintahkan Musa ke Kemah Pertemuan, lalu mendekatlah segenap umat itu dan berdiri di hadapan TUHAN."
 },
 {
   "id": 2961,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 6,
   "firman": "Kata Musa: \"Inilah firman yang diperintahkan TUHAN kamu perbuat, agar kemuliaan TUHAN tampak kepadamu.\""
 },
 {
   "id": 2962,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 7,
   "firman": "Kata Musa kepada Harun: \"Datanglah mendekat kepada mezbah, olahlah korban penghapus dosa dan korban bakaranmu, dan adakanlah pendamaian bagimu sendiri dan bagi bangsa itu; sesudah itu olahlah persembahan bangsa itu dan adakanlah pendamaian bagi mereka, seperti yang diperintahkan TUHAN.\""
 },
 {
   "id": 2963,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 8,
   "firman": "Maka mendekatlah Harun kepada mezbah, dan disembelihnyalah anak lembu yang akan menjadi korban penghapus dosa baginya sendiri."
 },
 {
   "id": 2964,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 9,
   "firman": "Anak-anak Harun menyampaikan darah lembu itu kepadanya, dan Harun mencelupkan jarinya ke dalam darah itu dan membubuhnya pada tanduk-tanduk mezbah. Darah selebihnya dituangkannya pada bagian bawah mezbah."
 },
 {
   "id": 2965,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 10,
   "firman": "Lemak, buah pinggang dan umbai hati dari korban penghapus dosa itu dibakarnya di atas mezbah, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 2966,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 11,
   "firman": "Tetapi daging dan kulitnya dibakarnya habis di luar perkemahan."
 },
 {
   "id": 2967,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 12,
   "firman": "Kemudian ia menyembelih korban bakaran, lalu anak-anak Harun menyerahkan darah korban itu kepadanya, maka Harun menyiramkannya pada mezbah sekelilingnya."
 },
 {
   "id": 2968,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 13,
   "firman": "Juga diserahkan merekalah kepadanya korban bakaran itu menurut bagian-bagian tertentu beserta dengan kepalanya, lalu dibakarnya di atas mezbah."
 },
 {
   "id": 2969,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 14,
   "firman": "Isi perut dan betisnya dibasuhnya dan dibakarnya dengan korban bakaran di atas mezbah."
 },
 {
   "id": 2970,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 15,
   "firman": "Sesudah itu dibawanya persembahan bangsa ke mezbah; diambilnyalah kambing jantan yang akan menjadi korban penghapus dosa yang bagi bangsa itu, lalu disembelihnya dan dipersembahkannya sebagai korban penghapus dosa seperti yang pertama."
 },
 {
   "id": 2971,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 16,
   "firman": "Kemudian dibawanyalah korban bakaran ke mezbah, dan diolahnya sesuai dengan peraturan."
 },
 {
   "id": 2972,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 17,
   "firman": "Selanjutnya dibawanyalah korban sajian dan diambilnya segenggam dari padanya, lalu dibakarnya di atas mezbah, di samping korban bakaran pada waktu pagi."
 },
 {
   "id": 2973,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 18,
   "firman": "Ia menyembelih juga lembu dan domba jantan yang akan menjadi korban keselamatan bagi bangsa itu, lalu anak-anak Harun menyerahkan darah korban itu kepadanya, maka Harun menyiramkannya pada mezbah sekelilingnya."
 },
 {
   "id": 2974,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 19,
   "firman": "Tetapi segala lemak dari lembu dan dari domba jantan itu, yakni ekor yang berlemak, lemak yang menutupi isi perut, buah pinggang dan umbai hati,"
 },
 {
   "id": 2975,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 20,
   "firman": "segala lemak itu diletakkan mereka di atas dada kedua korban itu, lalu Harun membakar segala lemak itu di atas mezbah."
 },
 {
   "id": 2976,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 21,
   "firman": "Dada dan paha kanan itu dipersembahkan Harun sebagai persembahan unjukan di hadapan TUHAN, seperti yang diperintahkan Musa."
 },
 {
   "id": 2977,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 22,
   "firman": "Harun mengangkat kedua tangannya atas bangsa itu, lalu memberkati mereka, kemudian turunlah ia, setelah mempersembahkan korban penghapus dosa, korban bakaran dan korban keselamatan."
 },
 {
   "id": 2978,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 23,
   "firman": "Masuklah Musa dan Harun ke dalam Kemah Pertemuan. Setelah keluar, mereka memberkati bangsa itu, lalu tampaklah kemuliaan TUHAN kepada segenap bangsa itu."
 },
 {
   "id": 2979,
   "kitab": "Ima",
   "pasal": 9,
   "ayat": 24,
   "firman": "Dan keluarlah api dari hadapan TUHAN, lalu menghanguskan korban bakaran dan segala lemak di atas mezbah. Tatkala seluruh bangsa itu melihatnya, bersorak-sorailah mereka, lalu sujud menyembah."
 },
 {
   "id": 2980,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 1,
   "firman": "Kemudian anak-anak Harun, Nadab dan Abihu, masing-masing mengambil perbaraannya, membubuh api ke dalamnya serta menaruh ukupan di atas api itu. Dengan demikian mereka mempersembahkan ke hadapan TUHAN api yang asing yang tidak diperintahkan-Nya kepada mereka."
 },
 {
   "id": 2981,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 2,
   "firman": "Maka keluarlah api dari hadapan TUHAN, lalu menghanguskan keduanya, sehingga mati di hadapan TUHAN."
 },
 {
   "id": 2982,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 3,
   "firman": "Berkatalah Musa kepada Harun: \"Inilah yang difirmankan TUHAN: Kepada orang yang karib kepada-Ku Kunyatakan kekudusan-Ku, dan di muka seluruh bangsa itu akan Kuperlihatkan kemuliaan-Ku.\" Dan Harun berdiam diri."
 },
 {
   "id": 2983,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 4,
   "firman": "Kemudian Musa memanggil Misael dan Elsafan, anak-anak Uziel, paman Harun, lalu berkatalah ia kepada mereka: \"Datang ke mari, angkatlah saudara-saudaramu ini dari depan tempat kudus ke luar perkemahan.\""
 },
 {
   "id": 2984,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 5,
   "firman": "Mereka datang, dan mengangkat mayat keduanya, masih berpakaian kemeja, ke luar perkemahan, seperti yang dikatakan Musa."
 },
 {
   "id": 2985,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 6,
   "firman": "Kemudian berkatalah Musa kepada Harun dan kepada Eleazar dan Itamar, anak-anak Harun: \"Janganlah kamu berkabung dan janganlah kamu berdukacita, supaya jangan kamu mati dan jangan TUHAN memurkai segenap umat ini, tetapi saudara-saudaramu, yaitu seluruh bangsa Israel, merekalah yang harus menangis karena api yang dinyalakan TUHAN itu."
 },
 {
   "id": 2986,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 7,
   "firman": "Janganlah kamu pergi dari depan pintu Kemah Pertemuan, supaya jangan kamu mati, karena minyak urapan TUHAN ada di atasmu.\" Mereka melakukan sesuai dengan perkataan Musa."
 },
 {
   "id": 2987,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 8,
   "firman": "TUHAN berfirman kepada Harun:"
 },
 {
   "id": 2988,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 9,
   "firman": "\"Janganlah engkau minum anggur atau minuman keras, engkau serta anak-anakmu, bila kamu masuk ke dalam Kemah Pertemuan, supaya jangan kamu mati. Itulah suatu ketetapan untuk selamanya bagi kamu turun-temurun."
 },
 {
   "id": 2989,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 10,
   "firman": "Haruslah kamu dapat membedakan antara yang kudus dengan yang tidak kudus, antara yang najis dengan yang tidak najis,"
 },
 {
   "id": 2990,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 11,
   "firman": "dan haruslah kamu dapat mengajarkan kepada orang Israel segala ketetapan yang telah difirmankan TUHAN kepada mereka dengan perantaraan Musa.\""
 },
 {
   "id": 2991,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 12,
   "firman": "Kemudian berkatalah Musa kepada Harun dan kepada Eleazar dan Itamar, anak-anak Harun yang tinggal itu: \"Ambillah korban sajian yang tinggal dari segala korban api-apian TUHAN, dan makanlah itu sebagai roti yang tidak beragi di samping mezbah, karena itulah bagian maha kudus."
 },
 {
   "id": 2992,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 13,
   "firman": "Haruslah kamu memakannya di suatu tempat yang kudus, karena itulah ketetapan bagimu dan anak-anakmu dari segala korban api-apian TUHAN, sebab demikianlah diperintahkan kepadaku."
 },
 {
   "id": 2993,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 14,
   "firman": "Dada persembahan unjukan dan paha persembahan khusus itu haruslah kamu makan di suatu tempat yang tahir, engkau ini serta anak-anakmu laki-laki dan perempuan, karena semuanya diberikan sebagai ketetapan bagimu dan anak-anakmu dari segala korban keselamatan orang Israel."
 },
 {
   "id": 2994,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 15,
   "firman": "Paha persembahan khusus dan dada persembahan unjukan itu haruslah dibawa mereka ke tempat segala korban api-apian yang dari lemak itu, supaya dipersembahkan sebagai persembahan unjukan di hadapan TUHAN. Itulah suatu ketetapan untuk selamanya bagimu serta bagi anak-anakmu seperti yang diperintahkan TUHAN.\""
 },
 {
   "id": 2995,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 16,
   "firman": "Kemudian Musa mencari dengan teliti kambing jantan korban penghapus dosa itu, tetapi ternyata kambing itu sudah habis dibakar. Sebab itu dimarahinyalah Eleazar dan Itamar, anak-anak Harun yang tinggal itu, katanya:"
 },
 {
   "id": 2996,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 17,
   "firman": "\"Mengapa tidak kamu makan korban penghapus dosa itu di tempat yang kudus? Bukankah itu sesuatu bagian maha kudus dan TUHAN memberikannya kepadamu, supaya kamu mengangkut kesalahan umat itu dan mengadakan pendamaian bagi mereka di hadapan TUHAN?"
 },
 {
   "id": 2997,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 18,
   "firman": "Lihat, darahnya itu tidak dibawa masuk ke dalam tempat kudus; bukankah seharusnya kamu memakannya di tempat kudus, seperti yang telah kuperintahkan?\""
 },
 {
   "id": 2998,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 19,
   "firman": "Lalu berkatalah Harun kepada Musa: \"Memang benar, pada hari ini mereka telah mempersembahkan korban penghapus dosa dan korban bakaran mereka ke hadapan TUHAN, tetapi hal-hal seperti tadilah yang kualami. Jikalau pada hari ini aku memakan juga korban penghapus dosa, mungkinkah hal itu disetujui oleh TUHAN?\""
 },
 {
   "id": 2999,
   "kitab": "Ima",
   "pasal": 10,
   "ayat": 20,
   "firman": "Ketika Musa mendengar itu, ia menyetujuinya."
 },
 {
   "id": 3000,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 1,
   "firman": "Lalu TUHAN berfirman kepada Musa dan Harun, kata-Nya kepada mereka:"
 },
 {
   "id": 3001,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel, begini: Inilah binatang-binatang yang boleh kamu makan dari segala binatang berkaki empat yang ada di atas bumi:"
 },
 {
   "id": 3002,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 3,
   "firman": "setiap binatang yang berkuku belah, yaitu yang kukunya bersela panjang, dan yang memamah biak boleh kamu makan."
 },
 {
   "id": 3003,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 4,
   "firman": "Tetapi inilah yang tidak boleh kamu makan dari yang memamah biak atau dari yang berkuku belah: unta, karena memang memamah biak, tetapi tidak berkuku belah; haram itu bagimu."
 },
 {
   "id": 3004,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 5,
   "firman": "Juga pelanduk, karena memang memamah biak, tetapi tidak berkuku belah; haram itu bagimu."
 },
 {
   "id": 3005,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 6,
   "firman": "Juga kelinci, karena memang memamah biak, tetapi tidak berkuku belah, haram itu bagimu."
 },
 {
   "id": 3006,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 7,
   "firman": "Demikian juga babi hutan, karena memang berkuku belah, yaitu kukunya bersela panjang, tetapi tidak memamah biak; haram itu bagimu."
 },
 {
   "id": 3007,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 8,
   "firman": "Daging binatang-binatang itu janganlah kamu makan dan bangkainya janganlah kamu sentuh; haram semuanya itu bagimu."
 },
 {
   "id": 3008,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 9,
   "firman": "Inilah yang boleh kamu makan dari segala yang hidup di dalam air: segala yang bersirip dan bersisik di dalam air, di dalam lautan, dan di dalam sungai, itulah semuanya yang boleh kamu makan."
 },
 {
   "id": 3009,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 10,
   "firman": "Tetapi segala yang tidak bersirip atau bersisik di dalam lautan dan di dalam sungai, dari segala yang berkeriapan di dalam air dan dari segala makhluk hidup yang ada di dalam air, semuanya itu kejijikan bagimu."
 },
 {
   "id": 3010,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 11,
   "firman": "Sesungguhnya haruslah semuanya itu kejijikan bagimu; dagingnya janganlah kamu makan, dan bangkainya haruslah kamu jijikkan."
 },
 {
   "id": 3011,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 12,
   "firman": "Segala yang tidak bersirip dan tidak bersisik di dalam air, adalah kejijikan bagimu."
 },
 {
   "id": 3012,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 13,
   "firman": "Inilah yang harus kamu jijikkan dari burung-burung, janganlah dimakan, karena semuanya itu adalah kejijikan: burung rajawali, ering janggut dan elang laut;"
 },
 {
   "id": 3013,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 14,
   "firman": "elang merah dan elang hitam menurut jenisnya;"
 },
 {
   "id": 3014,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 15,
   "firman": "setiap burung gagak menurut jenisnya;"
 },
 {
   "id": 3015,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 16,
   "firman": "burung unta, burung hantu, camar dan elang sikap menurut jenisnya;"
 },
 {
   "id": 3016,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 17,
   "firman": "burung pungguk, burung dendang air dan burung hantu besar;"
 },
 {
   "id": 3017,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 18,
   "firman": "burung hantu putih, burung undan, burung ering;"
 },
 {
   "id": 3018,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 19,
   "firman": "burung ranggung, bangau menurut jenisnya, meragai dan kelelawar."
 },
 {
   "id": 3019,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 20,
   "firman": "Segala binatang yang merayap dan bersayap dan berjalan dengan keempat kakinya adalah kejijikan bagimu."
 },
 {
   "id": 3020,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 21,
   "firman": "Tetapi inilah yang boleh kamu makan dari segala binatang yang merayap dan bersayap dan yang berjalan dengan keempat kakinya, yaitu yang mempunyai paha di sebelah atas kakinya untuk melompat di atas tanah."
 },
 {
   "id": 3021,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 22,
   "firman": "Inilah yang boleh kamu makan dari antaranya: belalang-belalang menurut jenisnya, yaitu belalang-belalang gambar menurut jenisnya, belalang-belalang kunyit menurut jenisnya, dan belalang-belalang padi menurut jenisnya."
 },
 {
   "id": 3022,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 23,
   "firman": "Selainnya segala binatang yang merayap dan bersayap dan yang berkaki empat adalah kejijikan bagimu."
 },
 {
   "id": 3023,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 24,
   "firman": "Semua yang berikut akan menajiskan kamu--setiap orang yang kena kepada bangkainya, menjadi najis sampai matahari terbenam,"
 },
 {
   "id": 3024,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 25,
   "firman": "dan setiap orang yang ada membawa dari bangkainya haruslah mencuci pakaiannya, dan ia menjadi najis sampai matahari terbenam--,"
 },
 {
   "id": 3025,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 26,
   "firman": "yakni segala binatang yang berkuku belah, tetapi tidak bersela panjang, dan yang tidak memamah biak; haram semuanya itu bagimu dan setiap orang yang kena kepadanya, menjadi najis."
 },
 {
   "id": 3026,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 27,
   "firman": "Demikian juga segala yang berjalan dengan telapak kakinya di antara segala binatang yang berjalan dengan keempat kakinya, semuanya itu haram bagimu; setiap orang yang kena kepada bangkainya, menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3027,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 28,
   "firman": "Dan siapa yang membawa bangkainya, haruslah mencuci pakaiannya dan ia menjadi najis sampai matahari terbenam. Haram semuanya itu bagimu."
 },
 {
   "id": 3028,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 29,
   "firman": "Inilah yang haram bagimu di antara segala binatang yang merayap dan berkeriapan di atas bumi: tikus buta, tikus, dan katak menurut jenisnya"
 },
 {
   "id": 3029,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 30,
   "firman": "dan landak, biawak, dan bengkarung, siput dan bunglon."
 },
 {
   "id": 3030,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 31,
   "firman": "Itulah semuanya yang haram bagimu di antara segala binatang yang mengeriap. Setiap orang yang kena kepada binatang-binatang itu sesudah binatang-binatang itu mati, menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3031,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 32,
   "firman": "Dan segala sesuatu menjadi najis, kalau seekor yang mati dari binatang-binatang itu jatuh ke atasnya: perkakas kayu apa saja atau pakaian atau kulit atau karung, setiap barang yang dipergunakan untuk sesuatu apapun, haruslah dimasukkan ke dalam air dan menjadi najis sampai matahari terbenam, kemudian menjadi tahir pula."
 },
 {
   "id": 3032,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 33,
   "firman": "Kalau seekor dari binatang-binatang itu jatuh ke dalam sesuatu belanga tanah, maka segala yang ada di dalamnya menjadi najis dan belanga itu harus kamu pecahkan."
 },
 {
   "id": 3033,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 34,
   "firman": "Dalam hal itu segala makanan yang boleh dimakan, kalau kena air dari belanga itu, menjadi najis, dan segala minuman yang boleh diminum dalam belanga seperti itu, menjadi najis."
 },
 {
   "id": 3034,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 35,
   "firman": "Kalau bangkai seekor dari binatang-binatang itu jatuh ke atas sesuatu benda, itu menjadi najis; pembakaran roti dan anglo haruslah diremukkan, karena semuanya itu najis dan haruslah najis juga bagimu;"
 },
 {
   "id": 3035,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 36,
   "firman": "tetapi mata air atau sumur yang memuat air, tetap tahir, sedangkan siapa yang kena kepada bangkai binatang-binatang itu menjadi najis."
 },
 {
   "id": 3036,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 37,
   "firman": "Apabila bangkai seekor dari binatang-binatang itu jatuh ke atas benih apapun yang akan ditaburkan, maka benih itu tetap tahir."
 },
 {
   "id": 3037,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 38,
   "firman": "Tetapi apabila benih itu telah dibubuhi air, lalu ke atasnya jatuh bangkai seekor dari binatang-binatang itu, maka najislah benih itu bagimu."
 },
 {
   "id": 3038,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 39,
   "firman": "Apabila mati salah seekor binatang yang menjadi makanan bagimu, maka siapa yang kena kepada bangkainya menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3039,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 40,
   "firman": "Dan siapa yang makan dari bangkainya itu, haruslah mencuci pakaiannya, dan ia menjadi najis sampai matahari terbenam; demikian juga siapa yang membawa bangkainya haruslah mencuci pakaiannya, dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3040,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 41,
   "firman": "Segala binatang yang merayap dan berkeriapan di atas bumi, adalah kejijikan, janganlah dimakan."
 },
 {
   "id": 3041,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 42,
   "firman": "Segala yang merayap dengan perutnya dan segala yang berjalan dengan keempat kakinya, atau segala yang berkaki banyak, semua yang termasuk binatang yang merayap dan berkeriapan di atas bumi, janganlah kamu makan, karena semuanya itu adalah kejijikan."
 },
 {
   "id": 3042,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 43,
   "firman": "Janganlah kamu membuat dirimu jijik oleh setiap binatang yang merayap dan berkeriapan dan janganlah kamu menajiskan dirimu dengan semuanya itu, sehingga kamu menjadi najis karenanya."
 },
 {
   "id": 3043,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 44,
   "firman": "Sebab Akulah TUHAN, Allahmu, maka haruslah kamu menguduskan dirimu dan haruslah kamu kudus, sebab Aku ini kudus, dan janganlah kamu menajiskan dirimu dengan setiap binatang yang mengeriap dan merayap di atas bumi."
 },
 {
   "id": 3044,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 45,
   "firman": "Sebab Akulah TUHAN yang telah menuntun kamu keluar dari tanah Mesir, supaya menjadi Allahmu; jadilah kudus, sebab Aku ini kudus."
 },
 {
   "id": 3045,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 46,
   "firman": "Itulah hukum tentang binatang berkaki empat, burung-burung dan segala makhluk hidup yang bergerak di dalam air dan segala makhluk yang mengeriap di atas bumi,"
 },
 {
   "id": 3046,
   "kitab": "Ima",
   "pasal": 11,
   "ayat": 47,
   "firman": "yakni untuk membedakan antara yang najis dengan yang tahir, antara binatang yang boleh dimakan dengan binatang yang tidak boleh dimakan.\""
 },
 {
   "id": 3047,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa, demikian:"
 },
 {
   "id": 3048,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 2,
   "firman": "\"Katakanlah kepada orang Israel: Apabila seorang perempuan bersalin dan melahirkan anak laki-laki, maka najislah ia selama tujuh hari. Sama seperti pada hari-hari ia bercemar kain ia najis."
 },
 {
   "id": 3049,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 3,
   "firman": "Dan pada hari yang kedelapan haruslah dikerat daging kulit khatan anak itu."
 },
 {
   "id": 3050,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 4,
   "firman": "Selanjutnya tiga puluh tiga hari lamanya perempuan itu harus tinggal menantikan pentahiran dari darah nifas, tidak boleh ia kena kepada sesuatu apapun yang kudus dan tidak boleh ia masuk ke tempat kudus, sampai sudah genap hari-hari pentahirannya."
 },
 {
   "id": 3051,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 5,
   "firman": "Tetapi jikalau ia melahirkan anak perempuan, maka najislah ia selama dua minggu, sama seperti pada waktu ia bercemar kain; selanjutnya enam puluh enam hari lamanya ia harus tinggal menantikan pentahiran dari darah nifas."
 },
 {
   "id": 3052,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 6,
   "firman": "Bila sudah genap hari-hari pentahirannya, maka untuk anak laki-laki atau anak perempuan haruslah dibawanya seekor domba berumur setahun sebagai korban bakaran dan seekor anak burung merpati atau burung tekukur sebagai korban penghapus dosa ke pintu Kemah Pertemuan, dengan menyerahkannya kepada imam."
 },
 {
   "id": 3053,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 7,
   "firman": "Imam itu harus mempersembahkannya ke hadapan TUHAN dan mengadakan pendamaian bagi perempuan itu. Demikianlah perempuan itu ditahirkan dari leleran darahnya. Itulah hukum tentang perempuan yang melahirkan anak laki-laki atau anak perempuan."
 },
 {
   "id": 3054,
   "kitab": "Ima",
   "pasal": 12,
   "ayat": 8,
   "firman": "Tetapi jikalau ia tidak mampu untuk menyediakan seekor kambing atau domba, maka haruslah ia mengambil dua ekor burung tekukur atau dua ekor anak burung merpati, yang seekor sebagai korban bakaran dan yang seekor lagi sebagai korban penghapus dosa, dan imam itu harus mengadakan pendamaian bagi perempuan itu, maka tahirlah ia.\""
 },
 {
   "id": 3055,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3056,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 2,
   "firman": "\"Apabila pada kulit badan seseorang ada bengkak atau bintil-bintil atau panau, yang mungkin menjadi penyakit kusta pada kulitnya, ia harus dibawa kepada imam Harun, atau kepada salah seorang dari antara anak-anaknya, imam-imam itu."
 },
 {
   "id": 3057,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 3,
   "firman": "Imam haruslah memeriksa penyakit pada kulit itu, dan kalau bulu di tempat penyakit itu sudah berubah menjadi putih, dan penyakit itu kelihatan lebih dalam dari kulit, maka itu penyakit kusta; kalau imam melihat hal itu, haruslah ia menyatakan orang itu najis."
 },
 {
   "id": 3058,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 4,
   "firman": "Tetapi jikalau yang ada pada kulitnya itu hanya panau putih dan tidak kelihatan lebih dalam dari kulit, dan bulunya tidak berubah menjadi putih, imam harus mengurung orang itu tujuh hari lamanya."
 },
 {
   "id": 3059,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 5,
   "firman": "Pada hari yang ketujuh haruslah imam memeriksa dia; bila menurut penglihatannya penyakit itu masih tetap dan tidak meluas pada kulit, imam harus mengurung dia tujuh hari lagi untuk kedua kalinya."
 },
 {
   "id": 3060,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 6,
   "firman": "Kemudian pada hari yang ketujuh haruslah imam memeriksa dia untuk kedua kalinya; bila penyakit itu menjadi pudar dan tidak meluas pada kulit, imam harus menyatakan dia tahir; itu hanya bintil-bintil. Orang itu harus mencuci pakaiannya dan ia menjadi tahir."
 },
 {
   "id": 3061,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 7,
   "firman": "Tetapi jikalau bintil-bintil itu memang meluas pada kulit, sesudah ia minta diperiksa oleh imam untuk dinyatakan tahir, haruslah ia minta diperiksa untuk kedua kalinya."
 },
 {
   "id": 3062,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 8,
   "firman": "Kalau menurut pemeriksaan imam bintil-bintil itu meluas pada kulit, imam harus menyatakan dia najis; itu penyakit kusta."
 },
 {
   "id": 3063,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 9,
   "firman": "Apabila seseorang kena kusta, ia harus dibawa kepada imam."
 },
 {
   "id": 3064,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 10,
   "firman": "Kalau menurut pemeriksaan imam pada kulitnya ada bengkak yang putih, yang mengubah bulunya menjadi putih, dan ada daging liar timbul pada bengkak itu,"
 },
 {
   "id": 3065,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 11,
   "firman": "maka kusta idapanlah yang ada pada kulitnya. Imam harus menyatakan dia najis dengan tidak usah mengurung dia, karena orang itu memang sudah najis."
 },
 {
   "id": 3066,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 12,
   "firman": "Jikalau kusta itu timbul di mana-mana pada kulit, sehingga menutupi seluruh kulit orang sakit itu, dari kepala sampai kakinya, seberapa dapat dilihat oleh imam,"
 },
 {
   "id": 3067,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 13,
   "firman": "dan kalau menurut pemeriksaannya kusta itu menutupi seluruh tubuh orang itu, maka ia harus dinyatakan tahir oleh imam; ia seluruhnya telah berubah menjadi putih, jadi ia tahir."
 },
 {
   "id": 3068,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 14,
   "firman": "Tetapi pada waktu ada tampak daging liar padanya, najislah ia."
 },
 {
   "id": 3069,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 15,
   "firman": "Kalau daging liar itu dilihat oleh imam, ia harus menyatakan orang itu najis, karena daging liar itu najis, dan itu penyakit kusta."
 },
 {
   "id": 3070,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 16,
   "firman": "Atau apabila daging liar itu susut dan berubah menjadi putih, haruslah orang itu datang kepada imam."
 },
 {
   "id": 3071,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 17,
   "firman": "Kalau menurut pemeriksaannya penyakit itu telah berubah menjadi putih, haruslah imam menyatakan orang itu tahir; memang ia tahir."
 },
 {
   "id": 3072,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 18,
   "firman": "Apabila pada kulit seseorang ada barah yang telah sembuh,"
 },
 {
   "id": 3073,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 19,
   "firman": "tetapi di tempat barah itu timbul bengkak yang putih atau panau yang putih kemerah-merahan, haruslah orang itu minta diperiksa oleh imam."
 },
 {
   "id": 3074,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 20,
   "firman": "Kalau menurut pemeriksaannya panau itu kelihatan lebih dalam dari pada kulit dan bulunya telah berubah menjadi putih, maka imam harus menyatakan orang itu najis, karena penyakit kustalah yang timbul di dalam barah itu."
 },
 {
   "id": 3075,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 21,
   "firman": "Tetapi jikalau panau itu diperiksa oleh imam dan ternyata tidak ada bulu yang putih padanya, dan tidak lebih dalam dari pada kulit, malahan pudar, imam harus mengurung orang itu tujuh hari lamanya."
 },
 {
   "id": 3076,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 22,
   "firman": "Dan jikalau panau itu memang meluas pada kulit, imam harus menyatakan dia najis; itu penyakit kusta."
 },
 {
   "id": 3077,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 23,
   "firman": "Tetapi jikalau panau itu masih tetap dan tidak meluas, maka itu bekas barah, dan imam harus menyatakan orang itu tahir."
 },
 {
   "id": 3078,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 24,
   "firman": "Atau apabila pada kulit seseorang ada lecur karena api dan daging liar yang timbul pada lecur itu menjadi panau yang putih kemerah-merahan atau putih,"
 },
 {
   "id": 3079,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 25,
   "firman": "maka imam harus memeriksa panau itu; bila ternyata bulu pada panau itu berubah menjadi putih dan panau itu kelihatan lebih dalam dari kulit, maka yang timbul di dalam lecur itu adalah penyakit kusta, dan imam harus menyatakan orang itu najis; itu penyakit kusta."
 },
 {
   "id": 3080,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 26,
   "firman": "Tetapi jikalau menurut pemeriksaannya tidak ada pada panau itu bulu yang putih dan panau itu tidak lebih dalam dari pada kulit, malahan pudar, imam harus mengurung orang itu tujuh hari lamanya."
 },
 {
   "id": 3081,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 27,
   "firman": "Pada hari yang ketujuh imam harus memeriksa lagi dia; jikalau panau itu memang meluas pada kulit, maka haruslah imam menyatakan dia najis, itu penyakit kusta."
 },
 {
   "id": 3082,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 28,
   "firman": "Tetapi jikalau panau itu masih tetap dan tidak meluas pada kulit, malahan pudar, maka itu bengkak lecur dan imam harus menyatakan dia tahir, sebab itu bekas lecur."
 },
 {
   "id": 3083,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 29,
   "firman": "Apabila seorang laki-laki atau perempuan mendapat penyakit pada kepala atau pada janggut,"
 },
 {
   "id": 3084,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 30,
   "firman": "imam harus memeriksa penyakit itu; bila itu kelihatan lebih dalam dari kulit, dan ada padanya rambut halus yang kuning, maka imam harus menyatakan orang itu najis, karena itu kudis kepala, yakni kusta kepala atau kusta janggut."
 },
 {
   "id": 3085,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 31,
   "firman": "Dan apabila menurut pemeriksaannya penyakit kudis itu tidak kelihatan lebih dalam dari kulit dan tidak ada padanya rambut yang hitam, maka imam harus mengurung orang yang kena penyakit kudis itu tujuh hari lamanya."
 },
 {
   "id": 3086,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 32,
   "firman": "Pada hari yang ketujuh imam harus memeriksa penyakit itu; bila ternyata kudis itu tidak meluas dan tidak ada rambut yang kuning padanya, dan kudis itu tidak kelihatan lebih dalam dari kulit,"
 },
 {
   "id": 3087,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 33,
   "firman": "maka orang itu harus bercukur, hanya tempat kudis itu tidak boleh dicukurnya. Lalu imam harus mengurung orang yang kena kudis itu untuk kedua kalinya tujuh hari lagi."
 },
 {
   "id": 3088,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 34,
   "firman": "Kemudian pada hari yang ketujuh imam harus memeriksa lagi kudis itu; bila ternyata, kudis itu tidak meluas pada kulit, dan tidak kelihatan lebih dalam dari kulit, maka imam harus menyatakan orang itu tahir, dan ia harus mencuci pakaiannya dan ia menjadi tahir."
 },
 {
   "id": 3089,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 35,
   "firman": "Tetapi jikalau kudis itu memang meluas pada kulit, sesudah ia dinyatakan tahir,"
 },
 {
   "id": 3090,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 36,
   "firman": "dan menurut pemeriksaan imam kudis itu meluas pada kulit, maka imam tidak usah lagi mencari rambut yang kuning, memang orang itu najis."
 },
 {
   "id": 3091,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 37,
   "firman": "Tetapi jikalau menurut penglihatan imam kudis itu masih tetap, dan ada rambut hitam tumbuh pada kudis itu, maka kudis itu sudah sembuh, dan orang itu tahir, dan imam harus menyatakan dia tahir."
 },
 {
   "id": 3092,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 38,
   "firman": "Apabila pada kulit seorang laki-laki atau perempuan ada panau-panau, yakni panau-panau yang putih,"
 },
 {
   "id": 3093,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 39,
   "firman": "imam harus melakukan pemeriksaan; bila ternyata pada kulitnya ada panau-panau pudar dan putih, maka hanya kuraplah yang timbul pada kulitnya dan orang itu tahir."
 },
 {
   "id": 3094,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 40,
   "firman": "Apabila rambut kepala seorang laki-laki meluruh, dan ia hanya menjadi botak, ia tahir."
 },
 {
   "id": 3095,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 41,
   "firman": "Jikalau rambutnya meluruh pada sebelah mukanya, dan ia menjadi botak sebelah depan, ia tahir."
 },
 {
   "id": 3096,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 42,
   "firman": "Tetapi apabila pada kepala yang botak itu, sebelah atas atau sebelah depan, ada penyakit yang putih kemerah-merahan, maka penyakit kustalah yang timbul pada bagian kepala yang botak itu."
 },
 {
   "id": 3097,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 43,
   "firman": "Lalu imam harus memeriksa dia; bila ternyata bahwa bengkak pada bagian kepala yang botak itu putih kemerah-merahan, dan kelihatannya seperti kusta pada kulit,"
 },
 {
   "id": 3098,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 44,
   "firman": "maka orang itu sakit kusta, dan ia najis, dan imam harus menyatakan dia najis, karena penyakit yang di kepalanya itu."
 },
 {
   "id": 3099,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 45,
   "firman": "Orang yang sakit kusta harus berpakaian yang cabik-cabik, rambutnya terurai dan lagi ia harus menutupi mukanya sambil berseru-seru: Najis! Najis!"
 },
 {
   "id": 3100,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 46,
   "firman": "Selama ia kena penyakit itu, ia tetap najis; memang ia najis; ia harus tinggal terasing, di luar perkemahan itulah tempat kediamannya."
 },
 {
   "id": 3101,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 47,
   "firman": "Apabila pada pakaian ada tanda kusta, pada pakaian bulu domba atau pakaian lenan,"
 },
 {
   "id": 3102,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 48,
   "firman": "entah pada benang lungsin atau benang pakannya, entah pada kulit atau sesuatu barang kulit,"
 },
 {
   "id": 3103,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 49,
   "firman": "--kalau tanda pada barang-barang itu sudah kemerah-merahan warnanya, maka itu kusta--hal itu harus diperiksakan kepada imam."
 },
 {
   "id": 3104,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 50,
   "firman": "Kalau tanda itu telah diperiksa oleh imam, ia harus mengasingkan yang mempunyai tanda itu tujuh hari lamanya."
 },
 {
   "id": 3105,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 51,
   "firman": "Pada hari yang ketujuh ia harus memeriksa tanda itu lagi; apabila tanda itu meluas pada pakaian atau benang lungsin atau benang pakan atau pada kulit, entah untuk barang apapun kulit itu dipakai, maka itu adalah kusta yang jahat sekali, dan barang itu najis."
 },
 {
   "id": 3106,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 52,
   "firman": "Ia harus membakar barang-barang yang mempunyai tanda itu, karena itu kusta yang jahat sekali; barang-barang itu harus dibakar habis."
 },
 {
   "id": 3107,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 53,
   "firman": "Tetapi jikalau menurut pemeriksaan imam tanda itu tidak meluas pada barang-barang itu,"
 },
 {
   "id": 3108,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 54,
   "firman": "maka imam harus memerintahkan orang mencuci barang yang mempunyai tanda itu, lalu ia harus mengasingkannya tujuh hari lagi untuk kedua kalinya."
 },
 {
   "id": 3109,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 55,
   "firman": "Kemudian sesudah barang itu dicuci, imam harus memeriksa tanda itu lagi; bila ternyata rupa tanda itu tidak berubah, biarpun itu tidak meluas, maka barang itu najis, dan engkau harus membakarnya habis, karena tanda itu semakin mendalam pada sebelah belakang atau sebelah muka."
 },
 {
   "id": 3110,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 56,
   "firman": "Dan jikalau menurut pemeriksaan imam tanda itu menjadi pudar sesudah dicuci, maka ia harus mengoyakkannya dari barang-barang itu."
 },
 {
   "id": 3111,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 57,
   "firman": "Tetapi jikalau tanda itu tampak pula pada barang-barang itu, maka itu kusta yang sedang timbul; barang yang mempunyai tanda itu, haruslah kaubakar habis."
 },
 {
   "id": 3112,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 58,
   "firman": "Tetapi barang-barang yang telah kaucuci, sehingga tanda itu lenyap dari padanya, haruslah dicuci untuk kedua kalinya, barulah menjadi tahir."
 },
 {
   "id": 3113,
   "kitab": "Ima",
   "pasal": 13,
   "ayat": 59,
   "firman": "Itulah hukum tentang kusta yang ada pada pakaian bulu domba atau lenan atau pada benang lungsin atau pada benang pakan atau pada setiap barang kulit, untuk menyatakan tahir atau najisnya.\""
 },
 {
   "id": 3114,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3115,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 2,
   "firman": "\"Inilah yang harus menjadi hukum tentang orang yang sakit kusta pada hari pentahirannya: ia harus dibawa kepada imam,"
 },
 {
   "id": 3116,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 3,
   "firman": "dan imam harus pergi ke luar perkemahan; kalau menurut pemeriksaan imam penyakit kusta itu telah sembuh dari padanya,"
 },
 {
   "id": 3117,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 4,
   "firman": "maka imam harus memerintahkan, supaya bagi orang yang akan ditahirkan itu diambil dua ekor burung yang hidup dan yang tidak haram, juga kayu aras, kain kirmizi dan hisop."
 },
 {
   "id": 3118,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 5,
   "firman": "Imam harus memerintahkan supaya burung yang seekor disembelih di atas belanga tanah berisi air mengalir."
 },
 {
   "id": 3119,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 6,
   "firman": "Tetapi burung yang masih hidup haruslah diambilnya bersama-sama dengan kayu aras, kain kirmizi dan hisop, lalu bersama-sama dengan burung itu semuanya harus dicelupkannya ke dalam darah burung yang sudah disembelih di atas air mengalir itu."
 },
 {
   "id": 3120,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 7,
   "firman": "Kemudian ia harus memercik tujuh kali kepada orang yang akan ditahirkan dari kusta itu dan dengan demikian mentahirkan dia, lalu burung yang hidup itu haruslah dilepaskannya ke padang."
 },
 {
   "id": 3121,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 8,
   "firman": "Orang yang akan ditahirkan itu haruslah mencuci pakaiannya, mencukur seluruh rambutnya dan membasuh tubuhnya dengan air, maka ia menjadi tahir. Sesudah itu ia boleh masuk ke dalam perkemahan, tetapi harus tinggal di luar kemahnya sendiri tujuh hari lamanya."
 },
 {
   "id": 3122,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 9,
   "firman": "Maka pada hari yang ketujuh ia harus mencukur seluruh rambutnya: rambut kepala, janggut, alis, bahkan segala bulunya harus dicukur, pakaiannya dicuci, dan tubuhnya dibasuh dengan air; maka ia menjadi tahir."
 },
 {
   "id": 3123,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 10,
   "firman": "Pada hari yang kedelapan ia harus mengambil dua ekor domba jantan yang tidak bercela dan seekor domba betina berumur setahun yang tidak bercela dan tiga persepuluh efa tepung yang terbaik diolah dengan minyak sebagai korban sajian, serta satu log minyak."
 },
 {
   "id": 3124,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 11,
   "firman": "Imam yang melakukan pentahiran itu harus menempatkan orang yang akan ditahirkan bersama-sama dengan persembahannya di hadapan TUHAN di depan pintu Kemah Pertemuan."
 },
 {
   "id": 3125,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 12,
   "firman": "Dan ia harus mengambil domba jantan yang seekor dan mempersembahkannya sebagai tebusan salah bersama-sama dengan minyak yang satu log itu, dan ia harus mempersembahkannya sebagai persembahan unjukan di hadapan TUHAN."
 },
 {
   "id": 3126,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 13,
   "firman": "Domba jantan itu harus disembelihnya di tempat orang menyembelih korban penghapus dosa dan korban bakaran, di tempat kudus, karena korban penebus salah, begitu juga korban penghapus dosa, adalah bagian imam; itulah bagian maha kudus."
 },
 {
   "id": 3127,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 14,
   "firman": "Imam harus mengambil sedikit dari darah tebusan salah itu dan harus membubuhnya pada cuping telinga kanan dari orang yang akan ditahirkan dan pada ibu jari tangan kanan dan pada ibu jari kaki kanannya."
 },
 {
   "id": 3128,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 15,
   "firman": "Imam harus mengambil sedikit dari minyak yang satu log itu dan menuangnya ke telapak tangan kiri imam sendiri;"
 },
 {
   "id": 3129,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 16,
   "firman": "ia harus mencelupkan jari kanannya ke dalam minyak yang di telapak tangan kirinya itu dan sedikit dari minyak itu haruslah dipercikkannya dengan jarinya tujuh kali di hadapan TUHAN."
 },
 {
   "id": 3130,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 17,
   "firman": "Dari minyak selebihnya imam harus membubuh sedikit pada cuping telinga kanan orang itu, pada ibu jari tangan kanannya dan pada ibu jari kaki kanannya, di tempat mana darah tebusan salah dibubuhkan."
 },
 {
   "id": 3131,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 18,
   "firman": "Dan apa yang tinggal dari minyak itu haruslah dibubuhnya pada kepala orang yang akan ditahirkan. Dengan demikian imam mengadakan pendamaian bagi orang itu di hadapan TUHAN."
 },
 {
   "id": 3132,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 19,
   "firman": "Imam harus mempersembahkan korban penghapus dosa dan dengan demikian mengadakan pendamaian bagi orang yang akan ditahirkan dari kenajisannya, dan sesudah itu ia harus menyembelih korban bakaran."
 },
 {
   "id": 3133,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 20,
   "firman": "Kemudian imam harus mempersembahkan korban bakaran dan korban sajian di atas mezbah. Dengan demikian imam mengadakan pendamaian bagi orang itu, maka ia menjadi tahir."
 },
 {
   "id": 3134,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 21,
   "firman": "Tetapi jikalau orang itu miskin dan tidak mampu, ia harus mengambil domba jantan seekor saja sebagai tebusan salah untuk persembahan unjukan, supaya diadakan pendamaian bagi orang itu, juga sepersepuluh efa tepung yang terbaik diolah dengan minyak untuk korban sajian, dan satu log minyak."
 },
 {
   "id": 3135,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 22,
   "firman": "Dan lagi dua ekor burung tekukur atau dua ekor burung merpati sekadar kemampuannya, yang seekor harus menjadi korban penghapus dosa dan yang seekor lagi menjadi korban bakaran."
 },
 {
   "id": 3136,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 23,
   "firman": "Pada hari yang kedelapan ia harus membawa semuanya untuk pentahirannya kepada imam, ke depan pintu Kemah Pertemuan di hadapan TUHAN."
 },
 {
   "id": 3137,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 24,
   "firman": "Kemudian imam harus mengambil domba tebusan salah dan minyak yang satu log itu, lalu imam harus mempersembahkan semuanya sebagai persembahan unjukan di hadapan TUHAN."
 },
 {
   "id": 3138,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 25,
   "firman": "Ia harus menyembelih domba tebusan salah dan imam harus mengambil sedikit dari darah tebusan salah itu dan membubuhnya pada cuping telinga kanan orang itu dan pada ibu jari tangan kanan dan ibu jari kaki kanannya."
 },
 {
   "id": 3139,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 26,
   "firman": "Dan imam harus menuang sedikit dari minyak itu ke telapak tangan kirinya sendiri,"
 },
 {
   "id": 3140,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 27,
   "firman": "lalu sedikit dari minyak itu haruslah dipercikkan oleh imam dengan jari kanannya tujuh kali di hadapan TUHAN."
 },
 {
   "id": 3141,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 28,
   "firman": "Kemudian imam harus membubuh sedikit dari minyak itu pada cuping telinga kanan dari orang yang akan ditahirkan, pada ibu jari tangan kanannya dan pada ibu jari kaki kanannya, di tempat mana dibubuhi darah tebusan salah itu."
 },
 {
   "id": 3142,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 29,
   "firman": "Dan minyak selebihnya haruslah dibubuhnya pada kepala orang yang akan ditahirkan, supaya diadakan pendamaian bagi orang itu di hadapan TUHAN."
 },
 {
   "id": 3143,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 30,
   "firman": "Lalu ia harus mempersembahkan seekor dari kedua burung tekukur atau anak burung merpati, yang dibawa orang itu sekadar kemampuannya,"
 },
 {
   "id": 3144,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 31,
   "firman": "yang seekor sebagai korban penghapus dosa, dan yang seekor lagi sebagai korban bakaran, di samping korban sajian. Dengan demikian imam mengadakan pendamaian bagi orang yang akan ditahirkan di hadapan TUHAN."
 },
 {
   "id": 3145,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 32,
   "firman": "Itulah hukum tentang pentahiran seorang yang kena kusta yang tidak mampu.\""
 },
 {
   "id": 3146,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 33,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3147,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 34,
   "firman": "\"Apabila kamu masuk ke tanah Kanaan yang akan Kuberikan kepadamu menjadi milikmu dan Aku mendatangkan tanda kusta di sebuah rumah di negeri milikmu itu,"
 },
 {
   "id": 3148,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 35,
   "firman": "maka pemilik rumah itu harus datang memberitahukannya kepada imam: Ada kelihatan seperti tanda kusta di rumahku."
 },
 {
   "id": 3149,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 36,
   "firman": "Maka imam harus memerintahkan supaya rumah itu dikosongkan, sebelum ia datang memeriksa tanda kusta itu, supaya jangan menjadi najis segala yang ada di dalam rumah itu, dan sesudah itu barulah imam datang untuk memeriksanya."
 },
 {
   "id": 3150,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 37,
   "firman": "Kalau menurut pemeriksaannya tanda pada dinding rumah itu merupakan lekuk-lekuk yang kehijau-hijauan atau kemerah-merahan warnanya, yang kelihatan lebih dalam dari permukaan dinding itu,"
 },
 {
   "id": 3151,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 38,
   "firman": "imam harus keluar dari rumah itu, lalu berdiri di depan pintu rumah, dan menutup rumah itu tujuh hari lamanya."
 },
 {
   "id": 3152,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 39,
   "firman": "Pada hari yang ketujuh imam harus datang kembali; kalau menurut pemeriksaannya tanda kusta itu meluas pada dinding rumah,"
 },
 {
   "id": 3153,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 40,
   "firman": "maka imam harus memerintahkan supaya orang mengungkit batu-batu yang kena tanda itu dan membuangnya ke luar kota ke suatu tempat yang najis."
 },
 {
   "id": 3154,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 41,
   "firman": "Dan ia harus mengikis rumah itu sebelah dalam berkeliling, dan kikisan lepa itu haruslah ditumpahkan ke luar kota ke suatu tempat yang najis."
 },
 {
   "id": 3155,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 42,
   "firman": "Dan orang harus mengambil batu-batu lain, lalu memasangnya sebagai pengganti batu-batu tadi, dan harus mengambil lepa lain dan melepa rumah itu."
 },
 {
   "id": 3156,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 43,
   "firman": "Tetapi jikalau tanda itu timbul lagi di dalam rumah itu, sesudah batu-batunya diungkit dan sesudah rumah itu dikikis, bahkan sesudah dilepa lagi,"
 },
 {
   "id": 3157,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 44,
   "firman": "dan kalau imam datang dan menurut pemeriksaannya tanda itu meluas di dalam rumah, maka kusta ganaslah yang di dalam rumah itu, dan rumah itu najis."
 },
 {
   "id": 3158,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 45,
   "firman": "Rumah itu haruslah dirombak, yakni batunya, kayunya dan segala lepa rumah itu, lalu dibawa semuanya ke luar kota ke suatu tempat yang najis."
 },
 {
   "id": 3159,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 46,
   "firman": "Dan orang yang masuk ke dalam rumah itu selama rumah itu ditutup, menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3160,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 47,
   "firman": "Dan orang yang tidur di dalam rumah itu haruslah mencuci pakaiannya; demikian juga orang yang makan di dalam rumah itu haruslah mencuci pakaiannya."
 },
 {
   "id": 3161,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 48,
   "firman": "Tetapi jikalau imam datang dan menurut pemeriksaannya tanda itu tidak meluas di dalam rumah itu, sesudah dilepa, maka imam harus menyatakan rumah itu tahir, karena tanda itu telah hilang."
 },
 {
   "id": 3162,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 49,
   "firman": "Kemudian, untuk menyucikan rumah itu, haruslah ia mengambil dua ekor burung, kayu aras, kain kirmizi dan hisop."
 },
 {
   "id": 3163,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 50,
   "firman": "Burung yang seekor haruslah disembelihnya di atas belanga tanah berisi air mengalir."
 },
 {
   "id": 3164,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 51,
   "firman": "Lalu ia harus mengambil kayu aras dan hisop, kain kirmizi dan burung yang masih hidup itu, dan mencelupkan semuanya ke dalam darah burung yang sudah disembelih dan ke dalam air mengalir itu, kemudian ia harus memercik kepada rumah itu tujuh kali."
 },
 {
   "id": 3165,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 52,
   "firman": "Dengan demikian ia harus menyucikan rumah itu dengan darah burung, air mengalir, burung yang hidup, kayu aras, hisop, dan kain kirmizi."
 },
 {
   "id": 3166,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 53,
   "firman": "Dan burung yang hidup itu harus dilepaskannya ke luar kota ke padang. Dengan demikian ia mengadakan pendamaian bagi rumah itu, maka rumah itu menjadi tahir."
 },
 {
   "id": 3167,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 54,
   "firman": "Itulah hukum tentang setiap penyakit kusta, kudis kepala,"
 },
 {
   "id": 3168,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 55,
   "firman": "tentang kusta pada pakaian dan rumah,"
 },
 {
   "id": 3169,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 56,
   "firman": "tentang bengkak, bintil-bintil dan panau,"
 },
 {
   "id": 3170,
   "kitab": "Ima",
   "pasal": 14,
   "ayat": 57,
   "firman": "untuk memberi petunjuk dalam hal najis atau dalam hal tahir; itulah hukum tentang kusta.\""
 },
 {
   "id": 3171,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3172,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Apabila aurat seorang laki-laki mengeluarkan lelehan, maka najislah ia karena lelehannya itu."
 },
 {
   "id": 3173,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 3,
   "firman": "Beginilah kenajisannya berhubung dengan lelehannya itu: bila auratnya membiarkan lelehan itu mengalir, atau bila auratnya menahannya, sehingga tidak mengeluarkan lelehan, maka itulah kenajisannya."
 },
 {
   "id": 3174,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 4,
   "firman": "Setiap tempat tidur, yang ditiduri orang yang mengeluarkan lelehan itu menjadi najis, dan setiap barang yang didudukinya menjadi najis juga."
 },
 {
   "id": 3175,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 5,
   "firman": "Setiap orang yang kena kepada tempat tidurnya haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3176,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 6,
   "firman": "Siapa yang duduk di atas barang yang telah diduduki oleh orang yang demikian haruslah mencuci pakaiannya, membasuh tubuhnya dengan air, dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3177,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 7,
   "firman": "Siapa yang kena kepada tubuh orang yang demikian, haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3178,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 8,
   "firman": "Apabila orang yang demikian meludahi orang yang tahir, haruslah orang ini mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3179,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 9,
   "firman": "Dan setiap pelana yang diduduki orang yang demikian menjadi najis."
 },
 {
   "id": 3180,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 10,
   "firman": "Setiap orang yang kena kepada sesuatu bekas tempat orang tadi menjadi najis sampai matahari terbenam. Siapa yang mengangkatnya, haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3181,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 11,
   "firman": "Dan setiap orang yang kena pada orang yang demikian, sedang orang ini tidak mencuci tangan dahulu dengan air, haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3182,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 12,
   "firman": "Kalau orang itu kena pada belanga tanah, itu haruslah dipecahkan, dan setiap perkakas kayu haruslah dicuci dengan air."
 },
 {
   "id": 3183,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 13,
   "firman": "Apabila orang yang demikian sudah bersih dari lelehannya, ia harus menghitung tujuh hari lagi untuk dapat dinyatakan tahir, lalu mencuci pakaiannya, membasuh tubuhnya dengan air mengalir, maka ia menjadi tahir."
 },
 {
   "id": 3184,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 14,
   "firman": "Pada hari yang kedelapan ia harus mengambil dua ekor burung tekukur atau dua ekor anak burung merpati, dan datang ke hadapan TUHAN, ke pintu Kemah Pertemuan, dan menyerahkan burung-burung itu kepada imam."
 },
 {
   "id": 3185,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 15,
   "firman": "Lalu imam harus mempersembahkannya, yang seekor sebagai korban penghapus dosa dan yang seekor lagi sebagai korban bakaran. Dengan demikian imam mengadakan pendamaian bagi orang itu di hadapan TUHAN karena lelehannya."
 },
 {
   "id": 3186,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 16,
   "firman": "Apabila seorang laki-laki tertumpah maninya, ia harus membasuh seluruh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3187,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 17,
   "firman": "Setiap pakaian dan setiap kulit, yang kena tumpahan mani itu, haruslah dicuci dengan air dan menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3188,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 18,
   "firman": "Juga seorang perempuan, kalau seorang laki-laki tidur dengan dia dengan ada tumpahan mani, maka keduanya harus membasuh tubuhnya dengan air dan mereka menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3189,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 19,
   "firman": "Apabila seorang perempuan mengeluarkan lelehan, dan lelehannya itu adalah darah dari auratnya, ia harus tujuh hari lamanya dalam cemar kainnya, dan setiap orang yang kena kepadanya, menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3190,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 20,
   "firman": "Segala sesuatu yang ditidurinya selama ia cemar kain menjadi najis. Dan segala sesuatu yang didudukinya menjadi najis juga."
 },
 {
   "id": 3191,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 21,
   "firman": "Setiap orang yang kena kepada tempat tidur perempuan itu haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3192,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 22,
   "firman": "Setiap orang yang kena kepada sesuatu barang yang diduduki perempuan itu haruslah mencuci pakaiannya, membasuh diri dengan air dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3193,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 23,
   "firman": "Juga pada waktu ia kena kepada sesuatu yang ada di tempat tidur atau di atas barang yang diduduki perempuan itu, ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3194,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 24,
   "firman": "Jikalau seorang laki-laki tidur dengan perempuan itu, dan ia kena cemar kain perempuan itu, maka ia menjadi najis selama tujuh hari, dan setiap tempat tidur yang ditidurinya menjadi najis juga."
 },
 {
   "id": 3195,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 25,
   "firman": "Apabila seorang perempuan berhari-hari lamanya mengeluarkan lelehan, yakni lelehan darah yang bukan pada waktu cemar kainnya, atau apabila ia mengeluarkan lelehan lebih lama dari waktu cemar kainnya, maka selama lelehannya yang najis itu perempuan itu adalah seperti pada hari-hari cemar kainnya, yakni ia najis."
 },
 {
   "id": 3196,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 26,
   "firman": "Setiap tempat tidur yang ditidurinya, selama ia mengeluarkan lelehan, haruslah baginya seperti tempat tidur pada waktu cemar kainnya dan setiap barang yang didudukinya menjadi najis sama seperti kenajisan cemar kainnya."
 },
 {
   "id": 3197,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 27,
   "firman": "Setiap orang yang kena kepada barang-barang itu menjadi najis, dan ia harus mencuci pakaiannya, membasuh tubuhnya dengan air, dan ia menjadi najis sampai matahari terbenam."
 },
 {
   "id": 3198,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 28,
   "firman": "Tetapi jikalau perempuan itu sudah tahir dari lelehannya, ia harus menghitung tujuh hari lagi, sesudah itu barulah ia menjadi tahir."
 },
 {
   "id": 3199,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 29,
   "firman": "Pada hari yang kedelapan ia harus mengambil dua ekor burung tekukur atau dua ekor anak burung merpati dan membawanya kepada imam ke pintu Kemah Pertemuan."
 },
 {
   "id": 3200,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 30,
   "firman": "Imam harus mempersembahkan yang seekor sebagai korban penghapus dosa dan yang seekor lagi sebagai korban bakaran. Dengan demikian imam mengadakan pendamaian bagi orang itu di hadapan TUHAN, karena lelehannya yang najis itu."
 },
 {
   "id": 3201,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 31,
   "firman": "Begitulah kamu harus menghindarkan orang Israel dari kenajisannya, supaya mereka jangan mati di dalam kenajisannya, bila mereka menajiskan Kemah Suci-Ku yang ada di tengah-tengah mereka itu.\""
 },
 {
   "id": 3202,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 32,
   "firman": "Itulah hukum tentang seorang laki-laki yang mengeluarkan lelehan atau yang tertumpah maninya yang menyebabkan dia najis,"
 },
 {
   "id": 3203,
   "kitab": "Ima",
   "pasal": 15,
   "ayat": 33,
   "firman": "dan tentang seorang perempuan yang bercemar kain dan tentang seseorang, baik laki-laki maupun perempuan, yang mengeluarkan lelehan, dan tentang laki-laki yang tidur dengan perempuan yang najis."
 },
 {
   "id": 3204,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 1,
   "firman": "Sesudah kedua anak Harun mati, yang terjadi pada waktu mereka mendekat ke hadapan TUHAN, berfirmanlah TUHAN kepada Musa."
 },
 {
   "id": 3205,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 2,
   "firman": "Firman TUHAN kepadanya: \"Katakanlah kepada Harun, kakakmu, supaya ia jangan sembarang waktu masuk ke dalam tempat kudus di belakang tabir, ke depan tutup pendamaian yang di atas tabut supaya jangan ia mati; karena Aku menampakkan diri dalam awan di atas tutup pendamaian."
 },
 {
   "id": 3206,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 3,
   "firman": "Beginilah caranya Harun masuk ke dalam tempat kudus itu, yakni dengan membawa seekor lembu jantan muda untuk korban penghapus dosa dan seekor domba jantan untuk korban bakaran."
 },
 {
   "id": 3207,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 4,
   "firman": "Ia harus mengenakan kemeja lenan yang kudus dan ia harus menutupi auratnya dengan celana lenan dan ia harus memakai ikat pinggang lenan dan berlilitkan serban lenan; itulah pakaian kudus yang harus dikenakannya, sesudah ia membasuh tubuhnya dengan air."
 },
 {
   "id": 3208,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 5,
   "firman": "Dari umat Israel ia harus mengambil dua ekor kambing jantan untuk korban penghapus dosa dan seekor domba jantan untuk korban bakaran."
 },
 {
   "id": 3209,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 6,
   "firman": "Kemudian Harun harus mempersembahkan lembu jantan yang akan menjadi korban penghapus dosa baginya sendiri dan dengan demikian mengadakan pendamaian baginya dan bagi keluarganya."
 },
 {
   "id": 3210,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 7,
   "firman": "Ia harus mengambil kedua ekor kambing jantan itu dan menempatkannya di hadapan TUHAN di depan pintu Kemah Pertemuan,"
 },
 {
   "id": 3211,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 8,
   "firman": "dan harus membuang undi atas kedua kambing jantan itu, sebuah undi bagi TUHAN dan sebuah bagi Azazel."
 },
 {
   "id": 3212,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 9,
   "firman": "Lalu Harun harus mempersembahkan kambing jantan yang kena undi bagi TUHAN itu dan mengolahnya sebagai korban penghapus dosa."
 },
 {
   "id": 3213,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 10,
   "firman": "Tetapi kambing jantan yang kena undi bagi Azazel haruslah ditempatkan hidup-hidup di hadapan TUHAN untuk mengadakan pendamaian, lalu dilepaskan bagi Azazel ke padang gurun."
 },
 {
   "id": 3214,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 11,
   "firman": "Harun harus mempersembahkan lembu jantan yang akan menjadi korban penghapus dosa baginya sendiri dan mengadakan pendamaian baginya dan bagi keluarganya; ia harus menyembelih lembu jantan itu."
 },
 {
   "id": 3215,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 12,
   "firman": "Dan ia harus mengambil perbaraan berisi penuh bara api dari atas mezbah yang di hadapan TUHAN, serta serangkup penuh ukupan dari wangi-wangian yang digiling sampai halus, lalu membawanya masuk ke belakang tabir."
 },
 {
   "id": 3216,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 13,
   "firman": "Kemudian ia harus meletakkan ukupan itu di atas api yang di hadapan TUHAN, sehingga asap ukupan itu menutupi tutup pendamaian yang di atas hukum Allah, supaya ia jangan mati."
 },
 {
   "id": 3217,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 14,
   "firman": "Lalu ia harus mengambil sedikit dari darah lembu jantan itu dan memercikkannya dengan jarinya ke atas tutup pendamaian di bagian muka, dan ke depan tutup pendamaian itu ia harus memercikkan sedikit dari darah itu dengan jarinya tujuh kali."
 },
 {
   "id": 3218,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 15,
   "firman": "Lalu ia harus menyembelih domba jantan yang akan menjadi korban penghapus dosa bagi bangsa itu dan membawa darahnya masuk ke belakang tabir, kemudian haruslah diperbuatnya dengan darah itu seperti yang diperbuatnya dengan darah lembu jantan, yakni ia harus memercikkannya ke atas tutup pendamaian dan ke depan tutup pendamaian itu."
 },
 {
   "id": 3219,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 16,
   "firman": "Dengan demikian ia mengadakan pendamaian bagi tempat kudus itu karena segala kenajisan orang Israel dan karena segala pelanggaran mereka, apapun juga dosa mereka. Demikianlah harus diperbuatnya dengan Kemah Pertemuan yang tetap diam di antara mereka di tengah-tengah segala kenajisan mereka."
 },
 {
   "id": 3220,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 17,
   "firman": "Seorangpun tidak boleh hadir di dalam Kemah Pertemuan, bila Harun masuk untuk mengadakan pendamaian di tempat kudus, sampai ia keluar, setelah mengadakan pendamaian baginya sendiri, bagi keluarganya dan bagi seluruh jemaah orang Israel."
 },
 {
   "id": 3221,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 18,
   "firman": "Kemudian haruslah ia pergi ke luar ke mezbah yang ada di hadapan TUHAN, dan mengadakan pendamaian bagi mezbah itu. Ia harus mengambil sedikit dari darah lembu jantan dan dari darah domba jantan itu dan membubuhnya pada tanduk-tanduk mezbah sekelilingnya."
 },
 {
   "id": 3222,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 19,
   "firman": "Kemudian ia harus memercikkan sedikit dari darah itu ke mezbah itu dengan jarinya tujuh kali dan mentahirkan serta menguduskannya dari segala kenajisan orang Israel."
 },
 {
   "id": 3223,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 20,
   "firman": "Setelah selesai mengadakan pendamaian bagi tempat kudus dan Kemah Pertemuan serta mezbah, ia harus mempersembahkan kambing jantan yang masih hidup itu,"
 },
 {
   "id": 3224,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 21,
   "firman": "dan Harun harus meletakkan kedua tangannya ke atas kepala kambing jantan yang hidup itu dan mengakui di atas kepala kambing itu segala kesalahan orang Israel dan segala pelanggaran mereka, apapun juga dosa mereka; ia harus menanggungkan semuanya itu ke atas kepala kambing jantan itu dan kemudian melepaskannya ke padang gurun dengan perantaraan seseorang yang sudah siap sedia untuk itu."
 },
 {
   "id": 3225,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 22,
   "firman": "Demikianlah kambing jantan itu harus mengangkut segala kesalahan Israel ke tanah yang tandus, dan kambing itu harus dilepaskan di padang gurun."
 },
 {
   "id": 3226,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 23,
   "firman": "Sesudah itu Harun harus masuk ke dalam Kemah Pertemuan dan menanggalkan pakaian lenan, yang dikenakannya ketika ia masuk ke dalam tempat kudus dan harus meninggalkannya di sana."
 },
 {
   "id": 3227,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 24,
   "firman": "Ia harus membasuh tubuhnya dengan air di suatu tempat yang kudus dan mengenakan pakaiannya sendiri, lalu ia harus keluar dan mempersembahkan korban bakarannya sendiri dan korban bakaran bangsa itu; dengan demikian ia mengadakan pendamaian baginya sendiri dan bagi bangsa itu."
 },
 {
   "id": 3228,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 25,
   "firman": "Kemudian ia harus membakar lemak korban penghapus dosa di atas mezbah."
 },
 {
   "id": 3229,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 26,
   "firman": "Maka orang yang melepaskan kambing jantan bagi Azazel itu harus mencuci pakaiannya, membasuh tubuhnya dengan air dan sesudah itu barulah boleh masuk ke perkemahan."
 },
 {
   "id": 3230,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 27,
   "firman": "Lembu jantan dan kambing jantan korban penghapus dosa, yang darahnya telah dibawa masuk untuk mengadakan pendamaian di dalam tempat kudus, harus dibawa keluar dari perkemahan, dan kulitnya, dagingnya dan kotorannya harus dibakar habis."
 },
 {
   "id": 3231,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 28,
   "firman": "Siapa yang membakar semuanya itu, harus mencuci pakaiannya, membasuh tubuhnya dengan air dan sesudah itu barulah boleh masuk ke perkemahan."
 },
 {
   "id": 3232,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 29,
   "firman": "Inilah yang harus menjadi ketetapan untuk selama-lamanya bagi kamu, yakni pada bulan yang ketujuh, pada tanggal sepuluh bulan itu kamu harus merendahkan diri dengan berpuasa dan janganlah kamu melakukan sesuatu pekerjaan, baik orang Israel asli maupun orang asing yang tinggal di tengah-tengahmu."
 },
 {
   "id": 3233,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 30,
   "firman": "Karena pada hari itu harus diadakan pendamaian bagimu untuk mentahirkan kamu. Kamu akan ditahirkan dari segala dosamu di hadapan TUHAN."
 },
 {
   "id": 3234,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 31,
   "firman": "Hari itu harus menjadi sabat, hari perhentian penuh, bagimu dan kamu harus merendahkan diri dengan berpuasa. Itulah suatu ketetapan untuk selama-lamanya."
 },
 {
   "id": 3235,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 32,
   "firman": "Dan pendamaian harus diadakan oleh imam yang telah diurapi dan telah ditahbiskan untuk memegang jabatan imam menggantikan ayahnya; ia harus mengenakan pakaian lenan, yakni pakaian kudus."
 },
 {
   "id": 3236,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 33,
   "firman": "Ia harus mengadakan pendamaian bagi tempat maha kudus, bagi Kemah Pertemuan dan bagi mezbah, juga bagi para imam dan bagi seluruh bangsa itu, yakni jemaah itu."
 },
 {
   "id": 3237,
   "kitab": "Ima",
   "pasal": 16,
   "ayat": 34,
   "firman": "Itulah yang harus menjadi ketetapan untuk selama-lamanya bagimu, supaya sekali setahun diadakan pendamaian bagi orang Israel karena segala dosa mereka.\" Maka Harun melakukan seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3238,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3239,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada Harun dan kepada anak-anaknya dan kepada seluruh orang Israel, dan katakan kepada mereka: Inilah firman yang diperintahkan TUHAN:"
 },
 {
   "id": 3240,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 3,
   "firman": "Setiap orang dari kaum Israel yang menyembelih lembu atau domba atau kambing di dalam perkemahan atau di luarnya,"
 },
 {
   "id": 3241,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 4,
   "firman": "tetapi tidak membawanya ke pintu Kemah Pertemuan, untuk dipersembahkan sebagai persembahan kepada TUHAN di depan Kemah Suci TUHAN, hal itu harus dihitungkan kepada orang itu sebagai hutang darah, karena ia telah menumpahkan darah, dan orang itu haruslah dilenyapkan dari tengah-tengah bangsanya."
 },
 {
   "id": 3242,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 5,
   "firman": "Maksudnya supaya orang Israel membawa korban sembelihan mereka, yang biasa dipersembahkan mereka di padang, kepada TUHAN ke pintu Kemah Pertemuan dengan menyerahkannya kepada imam, untuk dipersembahkan kepada TUHAN sebagai korban keselamatan."
 },
 {
   "id": 3243,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 6,
   "firman": "Imam harus menyiramkan darahnya pada mezbah TUHAN di depan pintu Kemah Pertemuan dan membakar lemaknya menjadi bau yang menyenangkan bagi TUHAN."
 },
 {
   "id": 3244,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 7,
   "firman": "Janganlah mereka mempersembahkan lagi korban mereka kepada jin-jin, sebab menyembah jin-jin itu adalah zinah. Itulah yang harus menjadi ketetapan untuk selama-lamanya bagi mereka turun-temurun."
 },
 {
   "id": 3245,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 8,
   "firman": "Dan haruslah kaukatakan kepada mereka: Setiap orang dari kaum Israel atau dari orang asing yang tinggal di tengah-tengah mereka, yang mempersembahkan korban bakaran atau korban sembelihan,"
 },
 {
   "id": 3246,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 9,
   "firman": "tetapi tidak membawanya ke pintu Kemah Pertemuan supaya dipersembahkan kepada TUHAN, maka orang itu haruslah dilenyapkan dari antara orang-orang sebangsanya.\""
 },
 {
   "id": 3247,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 10,
   "firman": "\"Setiap orang dari bangsa Israel dan dari orang asing yang tinggal di tengah-tengah mereka, yang makan darah apapun juga Aku sendiri akan menentang dia dan melenyapkan dia dari tengah-tengah bangsanya."
 },
 {
   "id": 3248,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 11,
   "firman": "Karena nyawa makhluk ada di dalam darahnya dan Aku telah memberikan darah itu kepadamu di atas mezbah untuk mengadakan pendamaian bagi nyawamu, karena darah mengadakan pendamaian dengan perantaraan nyawa."
 },
 {
   "id": 3249,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 12,
   "firman": "Itulah sebabnya Aku berfirman kepada orang Israel: Seorangpun di antaramu janganlah makan darah. Demikian juga orang asing yang tinggal di tengah-tengahmu tidak boleh makan darah."
 },
 {
   "id": 3250,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 13,
   "firman": "Setiap orang dari orang Israel dan dari orang asing yang tinggal di tengah-tengahmu, yang menangkap dalam perburuan seekor binatang atau burung yang boleh dimakan, haruslah mencurahkan darahnya, lalu menimbunnya dengan tanah."
 },
 {
   "id": 3251,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 14,
   "firman": "Karena darah itulah nyawa segala makhluk. Sebab itu Aku telah berfirman kepada orang Israel: Darah makhluk apapun janganlah kamu makan, karena darah itulah nyawa segala makhluk: setiap orang yang memakannya haruslah dilenyapkan."
 },
 {
   "id": 3252,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 15,
   "firman": "Dan setiap orang yang makan bangkai atau sisa mangsa binatang buas, baik ia orang Israel asli maupun orang asing, haruslah mencuci pakaiannya, membasuh tubuhnya dengan air dan ia menjadi najis sampai matahari terbenam, barulah ia menjadi tahir."
 },
 {
   "id": 3253,
   "kitab": "Ima",
   "pasal": 17,
   "ayat": 16,
   "firman": "Tetapi jikalau ia tidak mencuci pakaiannya dan tidak membasuh tubuhnya, ia akan menanggung kesalahannya sendiri.\""
 },
 {
   "id": 3254,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3255,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Akulah TUHAN, Allahmu."
 },
 {
   "id": 3256,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 3,
   "firman": "Janganlah kamu berbuat seperti yang diperbuat orang di tanah Mesir, di mana kamu diam dahulu; juga janganlah kamu berbuat seperti yang diperbuat orang di tanah Kanaan, ke mana Aku membawa kamu; janganlah kamu hidup menurut kebiasaan mereka."
 },
 {
   "id": 3257,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 4,
   "firman": "Kamu harus lakukan peraturan-Ku dan harus berpegang pada ketetapan-Ku dengan hidup menurut semuanya itu; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3258,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 5,
   "firman": "Sesungguhnya kamu harus berpegang pada ketetapan-Ku dan peraturan-Ku. Orang yang melakukannya, akan hidup karenanya; Akulah TUHAN."
 },
 {
   "id": 3259,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 6,
   "firman": "Siapapun di antaramu janganlah menghampiri seorang kerabatnya yang terdekat untuk menyingkapkan auratnya; Akulah TUHAN."
 },
 {
   "id": 3260,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 7,
   "firman": "Janganlah kausingkapkan aurat isteri ayahmu, karena ia hak ayahmu; dia ibumu, jadi janganlah singkapkan auratnya."
 },
 {
   "id": 3261,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 8,
   "firman": "Janganlah kausingkapkan aurat seorang isteri ayahmu, karena ia hak ayahmu."
 },
 {
   "id": 3262,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 9,
   "firman": "Mengenai aurat saudaramu perempuan, anak ayahmu atau anak ibumu, baik yang lahir di rumah ayahmu maupun yang lahir di luar, janganlah kausingkapkan auratnya."
 },
 {
   "id": 3263,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 10,
   "firman": "Mengenai aurat anak perempuan dari anakmu laki-laki atau anakmu perempuan, janganlah kausingkapkan auratnya, karena dengan begitu engkau menodai keturunanmu."
 },
 {
   "id": 3264,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 11,
   "firman": "Mengenai aurat anak perempuan dari seorang isteri ayahmu, yang lahir pada ayahmu sendiri, janganlah kausingkapkan auratnya, karena ia saudaramu perempuan."
 },
 {
   "id": 3265,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 12,
   "firman": "Janganlah kausingkapkan aurat saudara perempuan ayahmu, karena ia kerabat ayahmu."
 },
 {
   "id": 3266,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 13,
   "firman": "Janganlah kausingkapkan aurat saudara perempuan ibumu, karena ia kerabat ibumu."
 },
 {
   "id": 3267,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 14,
   "firman": "Janganlah kausingkapkan aurat isteri saudara laki-laki ayahmu, janganlah kauhampiri isterinya, karena ia isteri saudara ayahmu."
 },
 {
   "id": 3268,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 15,
   "firman": "Janganlah kausingkapkan aurat menantumu perempuan, karena ia isteri anakmu laki-laki, maka janganlah kausingkapkan auratnya."
 },
 {
   "id": 3269,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 16,
   "firman": "Janganlah kausingkapkan aurat isteri saudaramu laki-laki, karena itu hak saudaramu laki-laki."
 },
 {
   "id": 3270,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 17,
   "firman": "Janganlah kausingkapkan aurat seorang perempuan dan anaknya perempuan. Janganlah kauambil anak perempuan dari anaknya laki-laki atau dari anaknya perempuan untuk menyingkapkan auratnya, karena mereka adalah kerabatmu; itulah perbuatan mesum."
 },
 {
   "id": 3271,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 18,
   "firman": "Janganlah kauambil seorang perempuan sebagai madu kakaknya untuk menyingkapkan auratnya di samping kakaknya selama kakaknya itu masih hidup."
 },
 {
   "id": 3272,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 19,
   "firman": "Janganlah kauhampiri seorang perempuan pada waktu cemar kainnya yang menajiskan untuk menyingkapkan auratnya."
 },
 {
   "id": 3273,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 20,
   "firman": "Dan janganlah engkau bersetubuh dengan isteri sesamamu, sehingga engkau menjadi najis dengan dia."
 },
 {
   "id": 3274,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 21,
   "firman": "Janganlah kauserahkan seorang dari anak-anakmu untuk dipersembahkan kepada Molokh, supaya jangan engkau melanggar kekudusan nama Allahmu; Akulah TUHAN."
 },
 {
   "id": 3275,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 22,
   "firman": "Janganlah engkau tidur dengan laki-laki secara orang bersetubuh dengan perempuan, karena itu suatu kekejian."
 },
 {
   "id": 3276,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 23,
   "firman": "Janganlah engkau berkelamin dengan binatang apapun, sehingga engkau menjadi najis dengan binatang itu. Seorang perempuan janganlah berdiri di depan seekor binatang untuk berkelamin, karena itu suatu perbuatan keji."
 },
 {
   "id": 3277,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 24,
   "firman": "Janganlah kamu menajiskan dirimu dengan semuanya itu, sebab dengan semuanya itu bangsa-bangsa yang akan Kuhalaukan dari depanmu telah menjadi najis."
 },
 {
   "id": 3278,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 25,
   "firman": "Negeri itu telah menjadi najis dan Aku telah membalaskan kesalahannya kepadanya, sehingga negeri itu memuntahkan penduduknya."
 },
 {
   "id": 3279,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 26,
   "firman": "Tetapi kamu ini haruslah tetap berpegang pada ketetapan-Ku dan peraturan-Ku dan jangan melakukan sesuatupun dari segala kekejian itu, baik orang Israel asli maupun orang asing yang tinggal di tengah-tengahmu,"
 },
 {
   "id": 3280,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 27,
   "firman": "--karena segala kekejian itu telah dilakukan oleh penghuni negeri yang sebelum kamu, sehingga negeri itu sudah menjadi najis--"
 },
 {
   "id": 3281,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 28,
   "firman": "supaya kamu jangan dimuntahkan oleh negeri itu, apabila kamu menajiskannya, seperti telah dimuntahkannya bangsa yang sebelum kamu."
 },
 {
   "id": 3282,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 29,
   "firman": "Karena setiap orang yang melakukan sesuatupun dari segala kekejian itu, orang itu harus dilenyapkan dari tengah-tengah bangsanya."
 },
 {
   "id": 3283,
   "kitab": "Ima",
   "pasal": 18,
   "ayat": 30,
   "firman": "Dengan demikian kamu harus tetap berpegang pada kewajibanmu terhadap Aku, dan jangan kamu melakukan sesuatu dari kebiasaan yang keji itu, yang dilakukan sebelum kamu, dan janganlah kamu menajiskan dirimu dengan semuanya itu; Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 3284,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3285,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada segenap jemaah Israel dan katakan kepada mereka: Kuduslah kamu, sebab Aku, TUHAN, Allahmu, kudus."
 },
 {
   "id": 3286,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 3,
   "firman": "Setiap orang di antara kamu haruslah menyegani ibunya dan ayahnya dan memelihara hari-hari sabat-Ku; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3287,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 4,
   "firman": "Janganlah kamu berpaling kepada berhala-berhala dan janganlah kamu membuat bagimu dewa tuangan; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3288,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 5,
   "firman": "Apabila kamu mempersembahkan korban keselamatan kepada TUHAN, kamu harus mempersembahkannya sedemikian, hingga TUHAN berkenan akan kamu."
 },
 {
   "id": 3289,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 6,
   "firman": "Dan haruslah itu dimakan pada hari mempersembahkannya atau boleh juga pada keesokan harinya, tetapi apa yang tinggal sampai hari yang ketiga haruslah dibakar habis."
 },
 {
   "id": 3290,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 7,
   "firman": "Jikalau dimakan juga pada hari yang ketiga, maka itu menjadi sesuatu yang jijik dan TUHAN tidak berkenan akan orang itu."
 },
 {
   "id": 3291,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 8,
   "firman": "Siapa yang memakannya, akan menanggung kesalahannya sendiri, karena ia telah melanggar kekudusan persembahan kudus yang kepada TUHAN. Nyawa orang itu haruslah dilenyapkan dari antara orang-orang sebangsanya."
 },
 {
   "id": 3292,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 9,
   "firman": "Pada waktu kamu menuai hasil tanahmu, janganlah kausabit ladangmu habis-habis sampai ke tepinya, dan janganlah kaupungut apa yang ketinggalan dari penuaianmu."
 },
 {
   "id": 3293,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 10,
   "firman": "Juga sisa-sisa buah anggurmu janganlah kaupetik untuk kedua kalinya dan buah yang berjatuhan di kebun anggurmu janganlah kaupungut, tetapi semuanya itu harus kautinggalkan bagi orang miskin dan bagi orang asing; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3294,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 11,
   "firman": "Janganlah kamu mencuri, janganlah kamu berbohong dan janganlah kamu berdusta seorang kepada sesamanya."
 },
 {
   "id": 3295,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 12,
   "firman": "Janganlah kamu bersumpah dusta demi nama-Ku, supaya engkau jangan melanggar kekudusan nama Allahmu; Akulah TUHAN."
 },
 {
   "id": 3296,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 13,
   "firman": "Janganlah engkau memeras sesamamu manusia dan janganlah engkau merampas; janganlah kautahan upah seorang pekerja harian sampai besok harinya."
 },
 {
   "id": 3297,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 14,
   "firman": "Janganlah kaukutuki orang tuli dan di depan orang buta janganlah kautaruh batu sandungan, tetapi engkau harus takut akan Allahmu; Akulah TUHAN."
 },
 {
   "id": 3298,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 15,
   "firman": "Janganlah kamu berbuat curang dalam peradilan; janganlah engkau membela orang kecil dengan tidak sewajarnya dan janganlah engkau terpengaruh oleh orang-orang besar, tetapi engkau harus mengadili orang sesamamu dengan kebenaran."
 },
 {
   "id": 3299,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 16,
   "firman": "Janganlah engkau pergi kian ke mari menyebarkan fitnah di antara orang-orang sebangsamu; janganlah engkau mengancam hidup sesamamu manusia; Akulah TUHAN."
 },
 {
   "id": 3300,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 17,
   "firman": "Janganlah engkau membenci saudaramu di dalam hatimu, tetapi engkau harus berterus terang menegor orang sesamamu dan janganlah engkau mendatangkan dosa kepada dirimu karena dia."
 },
 {
   "id": 3301,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 18,
   "firman": "Janganlah engkau menuntut balas, dan janganlah menaruh dendam terhadap orang-orang sebangsamu, melainkan kasihilah sesamamu manusia seperti dirimu sendiri; Akulah TUHAN."
 },
 {
   "id": 3302,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 19,
   "firman": "Kamu harus berpegang kepada ketetapan-Ku. Janganlah kawinkan dua jenis ternak dan janganlah taburi ladangmu dengan dua jenis benih, dan janganlah pakai pakaian yang dibuat dari pada dua jenis bahan."
 },
 {
   "id": 3303,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 20,
   "firman": "Apabila seorang laki-laki bersetubuh dengan seorang perempuan, yakni seorang budak perempuan yang ada di bawah kuasa laki-laki lain, tetapi yang tidak pernah ditebus dan tidak juga diberi surat tanda merdeka, maka perbuatan itu haruslah dihukum; tetapi janganlah keduanya dihukum mati, karena perempuan itu belum dimerdekakan."
 },
 {
   "id": 3304,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 21,
   "firman": "Laki-laki itu harus membawa tebusan salahnya kepada TUHAN ke pintu Kemah Pertemuan, yakni seekor domba jantan sebagai korban penebus salah."
 },
 {
   "id": 3305,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 22,
   "firman": "Imam harus mengadakan pendamaian bagi orang itu dengan domba jantan korban penebus salah di hadapan TUHAN, karena dosa yang telah diperbuatnya, sehingga ia beroleh pengampunan dari dosanya itu."
 },
 {
   "id": 3306,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 23,
   "firman": "Apabila kamu sudah masuk ke negeri itu dan menanam bermacam-macam pohon buah-buahan, janganlah kamu memetik buahnya selama tiga tahun dan jangan memakannya."
 },
 {
   "id": 3307,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 24,
   "firman": "Tetapi pada tahun yang keempat haruslah segala buahnya menjadi persembahan kudus sebagai puji-pujian bagi TUHAN."
 },
 {
   "id": 3308,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 25,
   "firman": "Barulah pada tahun yang kelima kamu boleh memakan buahnya, supaya hasilnya ditambah bagimu; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3309,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 26,
   "firman": "Janganlah kamu makan sesuatu yang darahnya masih ada. Janganlah kamu melakukan telaah atau ramalan."
 },
 {
   "id": 3310,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 27,
   "firman": "Janganlah kamu mencukur tepi rambut kepalamu berkeliling dan janganlah engkau merusakkan tepi janggutmu."
 },
 {
   "id": 3311,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 28,
   "firman": "Janganlah kamu menggoresi tubuhmu karena orang mati dan janganlah merajah tanda-tanda pada kulitmu; Akulah TUHAN."
 },
 {
   "id": 3312,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 29,
   "firman": "Janganlah engkau merusak kesucian anakmu perempuan dengan menjadikan dia perempuan sundal, supaya negeri itu jangan melakukan persundalan, sehingga negeri itu penuh dengan perbuatan mesum."
 },
 {
   "id": 3313,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 30,
   "firman": "Kamu harus memelihara hari-hari sabat-Ku dan menghormati tempat kudus-Ku; Akulah TUHAN."
 },
 {
   "id": 3314,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 31,
   "firman": "Janganlah kamu berpaling kepada arwah atau kepada roh-roh peramal; janganlah kamu mencari mereka dan dengan demikian menjadi najis karena mereka; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3315,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 32,
   "firman": "Engkau harus bangun berdiri di hadapan orang ubanan dan engkau harus menaruh hormat kepada orang yang tua dan engkau harus takut akan Allahmu; Akulah TUHAN."
 },
 {
   "id": 3316,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 33,
   "firman": "Apabila seorang asing tinggal padamu di negerimu, janganlah kamu menindas dia."
 },
 {
   "id": 3317,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 34,
   "firman": "Orang asing yang tinggal padamu harus sama bagimu seperti orang Israel asli dari antaramu, kasihilah dia seperti dirimu sendiri, karena kamu juga orang asing dahulu di tanah Mesir; Akulah TUHAN, Allahmu."
 },
 {
   "id": 3318,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 35,
   "firman": "Janganlah kamu berbuat curang dalam peradilan, mengenai ukuran, timbangan dan sukatan."
 },
 {
   "id": 3319,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 36,
   "firman": "Neraca yang betul, batu timbangan yang betul, efa yang betul dan hin yang betul haruslah kamu pakai; Akulah TUHAN, Allahmu yang membawa kamu keluar dari tanah Mesir."
 },
 {
   "id": 3320,
   "kitab": "Ima",
   "pasal": 19,
   "ayat": 37,
   "firman": "Demikianlah kamu harus berpegang pada segala ketetapan-Ku dan segala peraturan-Ku serta melakukan semuanya itu; Akulah TUHAN.\""
 },
 {
   "id": 3321,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3322,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 2,
   "firman": "\"Engkau harus berkata kepada orang Israel: Setiap orang, baik dari antara orang Israel maupun dari antara orang asing yang tinggal di tengah-tengah orang Israel, yang menyerahkan seorang dari anak-anaknya kepada Molokh, pastilah ia dihukum mati, yakni rakyat negeri harus melontari dia dengan batu."
 },
 {
   "id": 3323,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 3,
   "firman": "Aku sendiri akan menentang orang itu dan akan melenyapkan dia dari tengah-tengah bangsanya, karena ia menyerahkan seorang dari anak-anaknya kepada Molokh, dengan maksud menajiskan tempat kudus-Ku dan melanggar kekudusan nama-Ku yang kudus."
 },
 {
   "id": 3324,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 4,
   "firman": "Tetapi jikalau rakyat negeri menutup mata terhadap orang itu, ketika ia menyerahkan seorang dari anak-anaknya kepada Molokh, dan tidak menghukum dia mati,"
 },
 {
   "id": 3325,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 5,
   "firman": "maka Aku sendiri akan menentang orang itu serta kaumnya dan akan melenyapkan dia dari tengah-tengah bangsanya dan semua orang yang turut berzinah mengikuti dia, yakni berzinah dengan menyembah Molokh."
 },
 {
   "id": 3326,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 6,
   "firman": "Orang yang berpaling kepada arwah atau kepada roh-roh peramal, yakni yang berzinah dengan bertanya kepada mereka, Aku sendiri akan menentang orang itu dan melenyapkan dia dari tengah-tengah bangsanya."
 },
 {
   "id": 3327,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 7,
   "firman": "Maka kamu harus menguduskan dirimu, dan kuduslah kamu, sebab Akulah TUHAN, Allahmu."
 },
 {
   "id": 3328,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 8,
   "firman": "Demikianlah kamu harus berpegang pada ketetapan-Ku dan melakukannya; Akulah TUHAN yang menguduskan kamu."
 },
 {
   "id": 3329,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 9,
   "firman": "Apabila ada seseorang yang mengutuki ayahnya atau ibunya, pastilah ia dihukum mati; ia telah mengutuki ayahnya atau ibunya, maka darahnya tertimpa kepadanya sendiri."
 },
 {
   "id": 3330,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 10,
   "firman": "Bila seorang laki-laki berzinah dengan isteri orang lain, yakni berzinah dengan isteri sesamanya manusia, pastilah keduanya dihukum mati, baik laki-laki maupun perempuan yang berzinah itu."
 },
 {
   "id": 3331,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 11,
   "firman": "Bila seorang laki-laki tidur dengan seorang isteri ayahnya, jadi ia melanggar hak ayahnya, pastilah keduanya dihukum mati, dan darah mereka tertimpa kepada mereka sendiri."
 },
 {
   "id": 3332,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 12,
   "firman": "Bila seorang laki-laki tidur dengan menantunya perempuan, pastilah keduanya dihukum mati; mereka telah melakukan suatu perbuatan keji, maka darah mereka tertimpa kepada mereka sendiri."
 },
 {
   "id": 3333,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 13,
   "firman": "Bila seorang laki-laki tidur dengan laki-laki secara orang bersetubuh dengan perempuan, jadi keduanya melakukan suatu kekejian, pastilah mereka dihukum mati dan darah mereka tertimpa kepada mereka sendiri."
 },
 {
   "id": 3334,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 14,
   "firman": "Bila seorang laki-laki mengambil seorang perempuan dan ibunya, itu suatu perbuatan mesum; ia dan kedua perempuan itu harus dibakar, supaya jangan ada perbuatan mesum di tengah-tengah kamu."
 },
 {
   "id": 3335,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 15,
   "firman": "Bila seorang laki-laki berkelamin dengan seekor binatang, pastilah ia dihukum mati, dan binatang itupun harus kamu bunuh juga."
 },
 {
   "id": 3336,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 16,
   "firman": "Bila seorang perempuan menghampiri binatang apapun untuk berkelamin, haruslah kaubunuh perempuan dan binatang itu; mereka pasti dihukum mati dan darah mereka tertimpa kepada mereka sendiri."
 },
 {
   "id": 3337,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 17,
   "firman": "Bila seorang laki-laki mengambil saudaranya perempuan, anak ayahnya atau anak ibunya, dan mereka bersetubuh, maka itu suatu perbuatan sumbang, dan mereka harus dilenyapkan di depan orang-orang sebangsanya; orang itu telah menyingkapkan aurat saudaranya perempuan, maka ia harus menanggung kesalahannya sendiri."
 },
 {
   "id": 3338,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 18,
   "firman": "Bila seorang laki-laki tidur dengan seorang perempuan yang bercemar kain, jadi ia menyingkapkan aurat perempuan itu dan membuka tutup lelerannya sedang perempuan itupun membiarkan tutup leleran darahnya itu disingkapkan, keduanya harus dilenyapkan dari tengah-tengah bangsanya."
 },
 {
   "id": 3339,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 19,
   "firman": "Janganlah kausingkapkan aurat saudara perempuan ibumu atau saudara perempuan ayahmu, karena aurat seorang kerabatnya sendirilah yang dibuka, dan mereka harus menanggung kesalahannya sendiri."
 },
 {
   "id": 3340,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 20,
   "firman": "Bila seorang laki-laki tidur dengan isteri saudara ayahnya, jadi ia melanggar hak saudara ayahnya, mereka mendatangkan dosa kepada dirinya, dan mereka akan mati dengan tidak beranak."
 },
 {
   "id": 3341,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 21,
   "firman": "Bila seorang laki-laki mengambil isteri saudaranya, itu suatu kecemaran, karena ia melanggar hak saudaranya laki-laki, dan mereka akan tidak beranak."
 },
 {
   "id": 3342,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 22,
   "firman": "Demikianlah kamu harus berpegang pada segala ketetapan-Ku dan segala peraturan-Ku serta melakukan semuanya itu, supaya jangan kamu dimuntahkan oleh negeri ke mana Aku membawa kamu untuk diam di sana."
 },
 {
   "id": 3343,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 23,
   "firman": "Janganlah kamu hidup menurut kebiasaan bangsa yang akan Kuhalau dari depanmu: karena semuanya itu telah dilakukan mereka, sehingga Aku muak melihat mereka."
 },
 {
   "id": 3344,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 24,
   "firman": "Tetapi kepadamu Aku telah berfirman: Kamulah yang akan menduduki tanah mereka dan Akulah yang akan memberikannya kepadamu menjadi milikmu, suatu negeri yang berlimpah-limpah susu dan madunya; Akulah TUHAN, Allahmu, yang memisahkan kamu dari bangsa-bangsa lain."
 },
 {
   "id": 3345,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 25,
   "firman": "Kamu harus membedakan binatang yang tidak haram dari yang haram, dan burung-burung yang haram dari yang tidak haram, supaya kamu jangan membuat dirimu jijik oleh binatang berkaki empat dan burung-burung dan oleh segala yang merayap di muka bumi, yang telah Kupisahkan supaya kamu haramkan."
 },
 {
   "id": 3346,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 26,
   "firman": "Kuduslah kamu bagi-Ku, sebab Aku ini, TUHAN, kudus dan Aku telah memisahkan kamu dari bangsa-bangsa lain, supaya kamu menjadi milik-Ku."
 },
 {
   "id": 3347,
   "kitab": "Ima",
   "pasal": 20,
   "ayat": 27,
   "firman": "Apabila seorang laki-laki atau perempuan dirasuk arwah atau roh peramal, pastilah mereka dihukum mati, yakni mereka harus dilontari dengan batu dan darah mereka tertimpa kepada mereka sendiri.\""
 },
 {
   "id": 3348,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa: \"Berbicaralah kepada para imam, anak-anak Harun, dan katakan kepada mereka: Seorang imam janganlah menajiskan diri dengan orang mati di antara orang-orang sebangsanya,"
 },
 {
   "id": 3349,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 2,
   "firman": "kecuali kalau yang mati itu adalah kerabatnya yang terdekat, yakni: ibunya, ayahnya, anaknya laki-laki atau perempuan, saudaranya laki-laki,"
 },
 {
   "id": 3350,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 3,
   "firman": "saudaranya perempuan, yang masih perawan dan dekat kepadanya karena belum mempunyai suami, dengan mereka itu bolehlah ia menajiskan diri."
 },
 {
   "id": 3351,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 4,
   "firman": "Sebagai suami janganlah ia menajiskan diri di antara orang-orang sebangsanya dan dengan demikian melanggar kekudusannya."
 },
 {
   "id": 3352,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 5,
   "firman": "Janganlah mereka menggundul sebagian kepalanya, dan janganlah mereka mencukur tepi janggutnya, dan janganlah mereka menggoresi kulit tubuhnya."
 },
 {
   "id": 3353,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 6,
   "firman": "Mereka itu harus kudus bagi Allahnya dan janganlah mereka melanggar kekudusan nama Allahnya, karena merekalah yang mempersembahkan segala korban api-apian TUHAN, santapan Allah mereka, dan karena itu haruslah mereka kudus."
 },
 {
   "id": 3354,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 7,
   "firman": "Janganlah mereka mengambil seorang perempuan sundal atau perempuan yang sudah dirusak kesuciannya atau seorang perempuan yang telah diceraikan oleh suaminya, karena imam itu kudus bagi Allahnya."
 },
 {
   "id": 3355,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 8,
   "firman": "Dan kamu harus menganggap dia kudus, karena dialah yang mempersembahkan santapan Allahmu. Ia harus kudus bagimu, sebab Aku, TUHAN, yang menguduskan kamu adalah kudus."
 },
 {
   "id": 3356,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 9,
   "firman": "Apabila anak perempuan seorang imam membiarkan kehormatannya dilanggar dengan bersundal, maka ia melanggar kekudusan ayahnya, dan ia harus dibakar dengan api."
 },
 {
   "id": 3357,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 10,
   "firman": "Imam yang terbesar di antara saudara-saudaranya, yang sudah diurapi dengan menuangkan minyak urapan di atas kepalanya dan yang ditahbiskan dengan mengenakan kepadanya segala pakaian kudus, janganlah membiarkan rambutnya terurai dan janganlah ia mencabik pakaiannya."
 },
 {
   "id": 3358,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 11,
   "firman": "Janganlah ia dekat kepada semua mayat, bahkan janganlah ia menajiskan diri dengan mayat ayahnya atau ibunya."
 },
 {
   "id": 3359,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 12,
   "firman": "Janganlah ia keluar dari tempat kudus, supaya jangan dilanggarnya kekudusan tempat kudus Allahnya, karena minyak urapan Allahnya, yang menandakan bahwa ia telah dikhususkan, ada di atas kepalanya; Akulah TUHAN."
 },
 {
   "id": 3360,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 13,
   "firman": "Ia harus mengambil seorang perempuan yang masih perawan."
 },
 {
   "id": 3361,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 14,
   "firman": "Seorang janda atau perempuan yang telah diceraikan atau yang dirusak kesuciannya atau perempuan sundal, janganlah diambil, melainkan harus seorang perawan dari antara orang-orang sebangsanya,"
 },
 {
   "id": 3362,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 15,
   "firman": "supaya jangan ia melanggar kekudusan keturunannya di antara orang-orang sebangsanya, sebab Akulah TUHAN, yang menguduskan dia.\""
 },
 {
   "id": 3363,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 16,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3364,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 17,
   "firman": "\"Katakanlah kepada Harun, begini: Setiap orang dari antara keturunanmu turun-temurun yang bercacat badannya, janganlah datang mendekat untuk mempersembahkan santapan Allahnya,"
 },
 {
   "id": 3365,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 18,
   "firman": "karena setiap orang yang bercacat badannya tidak boleh datang mendekat: orang buta, orang timpang, orang yang bercacat mukanya, orang yang terlalu panjang anggotanya,"
 },
 {
   "id": 3366,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 19,
   "firman": "orang yang patah kakinya atau tangannya,"
 },
 {
   "id": 3367,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 20,
   "firman": "orang yang berbongkol atau yang kerdil badannya atau yang bular matanya, orang yang berkedal atau berkurap atau yang rusak buah pelirnya."
 },
 {
   "id": 3368,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 21,
   "firman": "Setiap orang dari keturunan imam Harun, yang bercacat badannya, janganlah datang untuk mempersembahkan segala korban api-apian TUHAN; karena badannya bercacat janganlah ia datang dekat untuk mempersembahkan santapan Allahnya."
 },
 {
   "id": 3369,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 22,
   "firman": "Mengenai santapan Allahnya, baik persembahan-persembahan maha kudus maupun persembahan-persembahan kudus boleh dimakannya."
 },
 {
   "id": 3370,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 23,
   "firman": "Hanya janganlah ia datang sampai ke tabir dan janganlah ia datang ke mezbah, karena badannya bercacat, supaya jangan dilanggarnya kekudusan seluruh tempat kudus-Ku, sebab Akulah TUHAN, yang menguduskan mereka.\""
 },
 {
   "id": 3371,
   "kitab": "Ima",
   "pasal": 21,
   "ayat": 24,
   "firman": "Demikianlah Musa menyampaikan firman itu kepada Harun serta anak-anaknya dan kepada semua orang Israel."
 },
 {
   "id": 3372,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3373,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 2,
   "firman": "\"Katakanlah kepada Harun dan anak-anaknya, supaya mereka berlaku hati-hati terhadap persembahan-persembahan kudus yang dikuduskan orang Israel bagi-Ku, agar jangan mereka melanggar kekudusan nama-Ku yang kudus; Akulah TUHAN."
 },
 {
   "id": 3374,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 3,
   "firman": "Katakanlah kepada mereka: Setiap orang di antara kamu turun-temurun, yakni dari antara segala keturunanmu yang datang mendekat kepada persembahan-persembahan kudus yang dikuduskan orang Israel bagi TUHAN, sedang ia dalam keadaan najis, maka orang itu akan dilenyapkan dari hadapan-Ku; Akulah TUHAN."
 },
 {
   "id": 3375,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 4,
   "firman": "Seseorang dari keturunan Harun yang sakit kusta atau yang mengeluarkan lelehan, janganlah memakan persembahan-persembahan kudus, sebelum ia menjadi tahir; dan orang yang kena kepada sesuatu yang najis karena orang mati atau orang yang tertumpah maninya"
 },
 {
   "id": 3376,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 5,
   "firman": "atau orang yang kena kepada seekor binatang yang merayap yang menajiskan dia atau kepada salah seorang manusia yang menajiskan dia, dengan kenajisan apapun ia menjadi najis,"
 },
 {
   "id": 3377,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 6,
   "firman": "orang yang kena kepada yang demikian itu menjadi najis sampai matahari terbenam dan janganlah ia makan dari persembahan-persembahan kudus, sebelum ia membasuh tubuhnya dengan air."
 },
 {
   "id": 3378,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 7,
   "firman": "Sesudah matahari terbenam, barulah ia menjadi tahir dan sesudah itu bolehlah ia makan dari persembahan-persembahan kudus itu, karena itulah yang menjadi makanannya."
 },
 {
   "id": 3379,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 8,
   "firman": "Janganlah ia makan bangkai atau sisa mangsa binatang buas, supaya jangan ia menjadi najis karenanya; Akulah TUHAN."
 },
 {
   "id": 3380,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 9,
   "firman": "Dan mereka harus tetap berpegang pada kewajibannya terhadap Aku, supaya dalam hal itu jangan mereka mendatangkan dosa kepada dirinya dan mati oleh karenanya, karena mereka telah melanggar kekudusan kewajiban itu; Akulah TUHAN, yang menguduskan mereka."
 },
 {
   "id": 3381,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 10,
   "firman": "Setiap orang awam janganlah memakan persembahan kudus; demikian juga pendatang yang tinggal pada imam ataupun orang upahan."
 },
 {
   "id": 3382,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 11,
   "firman": "Tetapi apabila seseorang telah dibeli oleh imam dengan uangnya menjadi budak beliannya, maka orang itu boleh turut memakannya, demikian juga mereka yang lahir di rumahnya."
 },
 {
   "id": 3383,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 12,
   "firman": "Apabila anak perempuan imam bersuamikan orang awam, janganlah ia makan persembahan khusus dari persembahan-persembahan kudus."
 },
 {
   "id": 3384,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 13,
   "firman": "Tetapi apabila perempuan itu menjadi janda atau diceraikan, dan ia tidak mempunyai anak, dan telah kembali ke rumah ayahnya seperti waktu ia masih gadis, maka ia boleh makan dari makanan ayahnya; tetapi setiap orang awam janganlah memakannya."
 },
 {
   "id": 3385,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 14,
   "firman": "Apabila seseorang dengan tidak sengaja memakan persembahan kudus, ia harus memberi gantinya kepada imam dengan menambah seperlima."
 },
 {
   "id": 3386,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 15,
   "firman": "Janganlah pada imam melanggar kekudusan persembahan-persembahan kudus orang Israel yang telah dikhususkan bagi TUHAN,"
 },
 {
   "id": 3387,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 16,
   "firman": "karena dengan demikian mereka mendatangkan kepada orang Israel kesalahan yang harus ditebus, apabila mereka memakan persembahan-persembahan kudus mereka, sebab Akulah TUHAN, yang menguduskan mereka.\""
 },
 {
   "id": 3388,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 17,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3389,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 18,
   "firman": "\"Berbicaralah kepada Harun serta anak-anaknya dan kepada semua orang Israel dan katakan kepada mereka: Siapapun dari umat Israel dan dari orang asing di antara orang Israel yang mempersembahkan persembahannya, baik berupa sesuatu persembahan nazar maupun berupa sesuatu persembahan sukarela, yang hendak dipersembahkan mereka kepada TUHAN sebagai korban bakaran,"
 },
 {
   "id": 3390,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 19,
   "firman": "maka supaya TUHAN berkenan akan kamu, haruslah persembahan itu tidak bercela dari lembu jantan, domba atau kambing."
 },
 {
   "id": 3391,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 20,
   "firman": "Segala yang bercacat badannya janganlah kamu persembahkan, karena dengan itu TUHAN tidak berkenan akan kamu."
 },
 {
   "id": 3392,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 21,
   "firman": "Juga apabila seseorang mempersembahkan kepada TUHAN korban keselamatan sebagai pembayar nazar khusus atau sebagai korban sukarela dari lembu atau kambing domba, maka korban itu haruslah yang tidak bercela, supaya TUHAN berkenan akan dia, janganlah badannya bercacat sedikitpun."
 },
 {
   "id": 3393,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 22,
   "firman": "Binatang yang buta atau yang patah tulang, yang luka atau yang berbisul, yang berkedal atau yang berkurap, semuanya itu janganlah kamu persembahkan kepada TUHAN dan binatang yang demikian janganlah kamu taruh sebagai korban api-apian bagi TUHAN ke atas mezbah."
 },
 {
   "id": 3394,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 23,
   "firman": "Tetapi seekor lembu atau domba yang terlalu panjang atau terlalu pendek anggotanya bolehlah kaupersembahkan sebagai korban sukarela, tetapi sebagai korban nazar TUHAN tidak akan berkenan akan binatang itu."
 },
 {
   "id": 3395,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 24,
   "firman": "Tetapi binatang yang buah pelirnya terjepit, ditumbuk, direnggut atau dikerat, janganlah kamu persembahkan kepada TUHAN; janganlah kamu berbuat demikian di negerimu."
 },
 {
   "id": 3396,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 25,
   "firman": "Juga dari tangan orang asing janganlah kamu persembahkan sesuatu dari semuanya itu sebagai santapan Allahmu, karena semuanya itu telah rusak dan bercacat badannya; TUHAN tidak akan berkenan akan kamu karena persembahan-persembahan itu.\""
 },
 {
   "id": 3397,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 26,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3398,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 27,
   "firman": "\"Apabila seekor anak lembu atau anak domba atau anak kambing dilahirkan, maka haruslah itu tinggal tujuh hari lamanya dengan induknya, tetapi sejak hari kedelapan dan seterusnya TUHAN berkenan akan binatang itu kalau dipersembahkan berupa korban api-apian bagi-Nya."
 },
 {
   "id": 3399,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 28,
   "firman": "Seekor lembu atau kambing atau domba janganlah kamu sembelih bersama dengan anaknya pada satu hari juga."
 },
 {
   "id": 3400,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 29,
   "firman": "Dan apabila kamu menyembelih korban syukur bagi TUHAN, kamu harus menyembelihnya sedemikian, hingga TUHAN berkenan akan kamu."
 },
 {
   "id": 3401,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 30,
   "firman": "Pada hari itu juga korban itu harus dimakan; janganlah kamu tinggalkan apa-apa dari padanya sampai pagi; Akulah TUHAN."
 },
 {
   "id": 3402,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 31,
   "firman": "Dengan demikian kamu harus berpegang pada perintah-Ku dan melakukannya; Akulah TUHAN."
 },
 {
   "id": 3403,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 32,
   "firman": "Janganlah melanggar kekudusan nama-Ku yang kudus, supaya Aku dikuduskan di tengah-tengah orang Israel, sebab Akulah TUHAN, yang menguduskan kamu,"
 },
 {
   "id": 3404,
   "kitab": "Ima",
   "pasal": 22,
   "ayat": 33,
   "firman": "yang membawa kamu keluar dari tanah Mesir, supaya Aku menjadi Allahmu; Akulah TUHAN.\""
 },
 {
   "id": 3405,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3406,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Hari-hari raya yang ditetapkan TUHAN yang harus kamu maklumkan sebagai waktu pertemuan kudus, waktu perayaan yang Kutetapkan, adalah yang berikut."
 },
 {
   "id": 3407,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 3,
   "firman": "Enam hari lamanya boleh dilakukan pekerjaan, tetapi pada hari yang ketujuh haruslah ada sabat, hari perhentian penuh, yakni hari pertemuan kudus; janganlah kamu melakukan sesuatu pekerjaan; itulah sabat bagi TUHAN di segala tempat kediamanmu."
 },
 {
   "id": 3408,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 4,
   "firman": "Inilah hari-hari raya yang ditetapkan TUHAN, hari-hari pertemuan kudus, yang harus kamu maklumkan masing-masing pada waktunya yang tetap."
 },
 {
   "id": 3409,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 5,
   "firman": "Dalam bulan yang pertama, pada tanggal empat belas bulan itu, pada waktu senja, ada Paskah bagi TUHAN."
 },
 {
   "id": 3410,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 6,
   "firman": "Dan pada hari yang kelima belas bulan itu ada hari raya Roti Tidak Beragi bagi TUHAN; tujuh hari lamanya kamu harus makan roti yang tidak beragi."
 },
 {
   "id": 3411,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 7,
   "firman": "Pada hari yang pertama kamu harus mengadakan pertemuan kudus, janganlah kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 3412,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 8,
   "firman": "Kamu harus mempersembahkan korban api-apian kepada TUHAN tujuh hari lamanya; pada hari yang ketujuh haruslah ada pertemuan kudus, janganlah kamu melakukan sesuatu pekerjaan berat.\""
 },
 {
   "id": 3413,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 9,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3414,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 10,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Apabila kamu sampai ke negeri yang akan Kuberikan kepadamu, dan kamu menuai hasilnya, maka kamu harus membawa seberkas hasil pertama dari penuaianmu kepada imam,"
 },
 {
   "id": 3415,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 11,
   "firman": "dan imam itu haruslah mengunjukkan berkas itu di hadapan TUHAN, supaya TUHAN berkenan akan kamu. Imam harus mengunjukkannya pada hari sesudah sabat itu."
 },
 {
   "id": 3416,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 12,
   "firman": "Pada hari kamu mengunjukkan berkas itu kamu harus mempersembahkan seekor domba berumur setahun yang tidak bercela, sebagai korban bakaran bagi TUHAN,"
 },
 {
   "id": 3417,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 13,
   "firman": "serta dengan korban sajiannya dari dua persepuluh efa tepung yang terbaik, diolah dengan minyak, sebagai korban api-apian bagi TUHAN yakni bau yang menyenangkan, serta dengan korban curahannya dari seperempat hin anggur."
 },
 {
   "id": 3418,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 14,
   "firman": "Sampai pada hari itu juga janganlah kamu makan roti, atau bertih gandum atau gandum baru, sampai kamu telah membawa persembahan Allahmu; itulah suatu ketetapan untuk selama-lamanya bagi kamu turun-temurun di segala tempat kediamanmu."
 },
 {
   "id": 3419,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 15,
   "firman": "Kemudian kamu harus menghitung, mulai dari hari sesudah sabat itu, yaitu waktu kamu membawa berkas persembahan unjukan, harus ada genap tujuh minggu;"
 },
 {
   "id": 3420,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 16,
   "firman": "sampai pada hari sesudah sabat yang ketujuh kamu harus hitung lima puluh hari; lalu kamu harus mempersembahkan korban sajian yang baru kepada TUHAN."
 },
 {
   "id": 3421,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 17,
   "firman": "Dari tempat kediamanmu kamu harus membawa dua buah roti unjukan yang harus dibuat dari dua persepuluh efa tepung yang terbaik dan yang dibakar sesudah dicampur dengan ragi sebagai hulu hasil bagi TUHAN."
 },
 {
   "id": 3422,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 18,
   "firman": "Beserta roti itu kamu harus mempersembahkan tujuh ekor domba berumur setahun yang tidak bercela dan seekor lembu jantan muda dan dua ekor domba jantan; semuanya itu haruslah menjadi korban bakaran bagi TUHAN, serta dengan korban sajiannya dan korban-korban curahannya, suatu korban api-apian yang baunya menyenangkan bagi TUHAN."
 },
 {
   "id": 3423,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 19,
   "firman": "Kemudian kamu harus mempersembahkan seekor kambing jantan sebagai korban penghapus dosa, dan dua ekor domba yang berumur setahun sebagai korban keselamatan."
 },
 {
   "id": 3424,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 20,
   "firman": "Imam harus mengunjukkan semuanya beserta roti hulu hasil itu sebagai persembahan unjukan di hadapan TUHAN, beserta kedua ekor domba itu. Semuanya itu haruslah menjadi persembahan kudus bagi TUHAN dan adalah bagian imam."
 },
 {
   "id": 3425,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 21,
   "firman": "Pada hari itu juga kamu harus mengumumkan hari raya dan kamu harus mengadakan pertemuan kudus, janganlah kamu melakukan sesuatu pekerjaan berat; itulah suatu ketetapan untuk selama-lamanya di segala tempat kediamanmu turun-temurun."
 },
 {
   "id": 3426,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 22,
   "firman": "Pada waktu kamu menuai hasil tanahmu, janganlah kausabit ladangmu habis-habis sampai ke tepinya dan janganlah kaupungut apa yang ketinggalan dari penuaianmu, semuanya itu harus kautinggalkan bagi orang miskin dan bagi orang asing; Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 3427,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 23,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3428,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 24,
   "firman": "\"Katakanlah kepada orang Israel, begini: Dalam bulan yang ketujuh, pada tanggal satu bulan itu, kamu harus mengadakan hari perhentian penuh yang diperingati dengan meniup serunai, yakni hari pertemuan kudus."
 },
 {
   "id": 3429,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 25,
   "firman": "Janganlah kamu melakukan sesuatu pekerjaan berat dan kamu harus mempersembahkan korban api-apian kepada TUHAN.\""
 },
 {
   "id": 3430,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 26,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3431,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 27,
   "firman": "\"Akan tetapi pada tanggal sepuluh bulan yang ketujuh itu ada hari Pendamaian; kamu harus mengadakan pertemuan kudus dan harus merendahkan diri dengan berpuasa dan mempersembahkan korban api-apian kepada TUHAN."
 },
 {
   "id": 3432,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 28,
   "firman": "Pada hari itu janganlah kamu melakukan sesuatu pekerjaan; itulah hari Pendamaian untuk mengadakan pendamaian bagimu di hadapan TUHAN, Allahmu."
 },
 {
   "id": 3433,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 29,
   "firman": "Karena setiap orang yang pada hari itu tidak merendahkan diri dengan berpuasa, haruslah dilenyapkan dari antara orang-orang sebangsanya."
 },
 {
   "id": 3434,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 30,
   "firman": "Setiap orang yang melakukan sesuatu pekerjaan pada hari itu, orang itu akan Kubinasakan dari tengah-tengah bangsanya."
 },
 {
   "id": 3435,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 31,
   "firman": "Janganlah kamu melakukan sesuatu pekerjaan; itulah suatu ketetapan untuk selama-lamanya bagimu turun-temurun di segala tempat kediamanmu."
 },
 {
   "id": 3436,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 32,
   "firman": "Itu harus menjadi suatu sabat, hari perhentian penuh bagimu, dan kamu harus merendahkan diri dengan berpuasa. Mulai pada malam tanggal sembilan bulan itu, dari matahari terbenam sampai matahari terbenam, kamu harus merayakan sabatmu.\""
 },
 {
   "id": 3437,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 33,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3438,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 34,
   "firman": "\"Katakanlah kepada orang Israel, begini: Pada hari yang kelima belas bulan yang ketujuh itu ada hari raya Pondok Daun bagi TUHAN tujuh hari lamanya."
 },
 {
   "id": 3439,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 35,
   "firman": "Pada hari yang pertama haruslah ada pertemuan kudus, janganlah kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 3440,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 36,
   "firman": "Tujuh hari lamanya kamu harus mempersembahkan korban api-apian kepada TUHAN, dan pada hari yang kedelapan kamu harus mengadakan pertemuan kudus dan mempersembahkan korban api-apian kepada TUHAN. Itulah hari raya perkumpulan, janganlah kamu melakukan sesuatu pekerjaan berat."
 },
 {
   "id": 3441,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 37,
   "firman": "Itulah hari-hari raya yang ditetapkan TUHAN, yang harus kamu maklumkan sebagai hari pertemuan kudus untuk mempersembahkan korban api-apian kepada TUHAN, yaitu korban bakaran dan korban sajian, korban sembelihan dan korban-korban curahan, setiap hari sebanyak yang ditetapkan untuk hari itu,"
 },
 {
   "id": 3442,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 38,
   "firman": "belum termasuk hari-hari Sabat TUHAN dan belum termasuk persembahan-persembahanmu atau segala korban nazarmu atau segala korban sukarelamu, yang kamu hendak persembahkan kepada TUHAN."
 },
 {
   "id": 3443,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 39,
   "firman": "Akan tetapi pada hari yang kelima belas bulan yang ketujuh itu pada waktu mengumpulkan hasil tanahmu, kamu harus mengadakan perayaan bagi TUHAN tujuh hari lamanya; pada hari yang pertama haruslah ada perhentian penuh dan juga pada hari yang kedelapan harus ada perhentian penuh."
 },
 {
   "id": 3444,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 40,
   "firman": "Pada hari yang pertama kamu harus mengambil buah-buah dari pohon-pohon yang elok, pelepah-pelepah pohon-pohon korma, ranting-ranting dari pohon-pohon yang rimbun dan dari pohon-pohon gandarusa dan kamu harus bersukaria di hadapan TUHAN, Allahmu, tujuh hari lamanya."
 },
 {
   "id": 3445,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 41,
   "firman": "Kamu harus merayakannya sebagai perayaan bagi TUHAN tujuh hari lamanya dalam setahun; itulah suatu ketetapan untuk selama-lamanya bagimu turun-temurun. Dalam bulan yang ketujuh kamu harus merayakannya."
 },
 {
   "id": 3446,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 42,
   "firman": "Di dalam pondok-pondok daun kamu harus tinggal tujuh hari lamanya, setiap orang asli di Israel haruslah tinggal di dalam pondok-pondok daun,"
 },
 {
   "id": 3447,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 43,
   "firman": "supaya diketahui oleh keturunanmu, bahwa Aku telah menyuruh orang Israel tinggal di dalam pondok-pondok selama Aku menuntun mereka sesudah keluar dari tanah Mesir, Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 3448,
   "kitab": "Ima",
   "pasal": 23,
   "ayat": 44,
   "firman": "Demikianlah Musa menyampaikan kepada orang Israel firman tentang hari-hari raya yang ditetapkan TUHAN."
 },
 {
   "id": 3449,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3450,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 2,
   "firman": "\"Perintahkanlah kepada orang Israel, supaya mereka membawa kepadamu minyak zaitun tumbuk yang tulen untuk lampu, supaya lampu dapat dipasang dan tetap menyala."
 },
 {
   "id": 3451,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 3,
   "firman": "Harun harus tetap mengatur lampu-lampu itu di depan tabir yang menutupi tabut hukum, di dalam Kemah Pertemuan, dari petang sampai pagi, di hadapan TUHAN. Itulah suatu ketetapan untuk selama-lamanya bagimu turun-temurun."
 },
 {
   "id": 3452,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 4,
   "firman": "Di atas kandil dari emas murni haruslah tetap diaturnya lampu-lampu itu di hadapan TUHAN.\""
 },
 {
   "id": 3453,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 5,
   "firman": "\"Engkau harus mengambil tepung yang terbaik dan membakar dua belas roti bundar dari padanya, setiap roti bundar harus dibuat dari dua persepuluh efa;"
 },
 {
   "id": 3454,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 6,
   "firman": "engkau harus mengaturnya menjadi dua susun, enam buah sesusun, di atas meja dari emas murni itu, di hadapan TUHAN."
 },
 {
   "id": 3455,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 7,
   "firman": "Engkau harus membubuh kemenyan tulen di atas tiap-tiap susun; kemenyan itulah yang harus menjadi bagian ingat-ingatan roti itu, yakni suatu korban api-apian bagi TUHAN."
 },
 {
   "id": 3456,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 8,
   "firman": "Setiap hari Sabat ia harus tetap mengaturnya di hadapan TUHAN; itulah dari pihak orang Israel suatu kewajiban perjanjian untuk selama-lamanya."
 },
 {
   "id": 3457,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 9,
   "firman": "Roti itu teruntuk bagi Harun serta anak-anaknya dan mereka harus memakannya di suatu tempat yang kudus; itulah bagian maha kudus baginya dari segala korban api-apian TUHAN; itulah suatu ketetapan untuk selama-lamanya.\""
 },
 {
   "id": 3458,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 10,
   "firman": "Pada suatu hari datanglah seorang laki-laki, ibunya seorang Israel sedang ayahnya seorang Mesir, di tengah-tengah perkemahan orang Israel; dan orang itu berkelahi dengan seorang Israel di perkemahan."
 },
 {
   "id": 3459,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 11,
   "firman": "Anak perempuan Israel itu menghujat nama TUHAN dengan mengutuk, lalu dibawalah ia kepada Musa. Nama ibunya ialah Selomit binti Dibri dari suku Dan."
 },
 {
   "id": 3460,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 12,
   "firman": "Ia dimasukkan dalam tahanan untuk menantikan keputusan sesuai dengan firman TUHAN."
 },
 {
   "id": 3461,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 13,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 3462,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 14,
   "firman": "\"Bawalah orang yang mengutuk itu ke luar perkemahan dan semua orang yang mendengar haruslah meletakkan tangannya ke atas kepala orang itu, sesudahnya haruslah seluruh jemaah itu melontari dia dengan batu."
 },
 {
   "id": 3463,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 15,
   "firman": "Engkau harus mengatakan kepada orang Israel, begini: Setiap orang yang mengutuki Allah harus menanggung kesalahannya sendiri."
 },
 {
   "id": 3464,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 16,
   "firman": "Siapa yang menghujat nama TUHAN, pastilah ia dihukum mati dan dilontari dengan batu oleh seluruh jemaah itu. Baik orang asing maupun orang Israel asli, bila ia menghujat nama TUHAN, haruslah dihukum mati."
 },
 {
   "id": 3465,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 17,
   "firman": "Juga apabila seseorang membunuh seorang manusia, pastilah ia dihukum mati."
 },
 {
   "id": 3466,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 18,
   "firman": "Tetapi siapa yang memukul mati seekor ternak, harus membayar gantinya, seekor ganti seekor."
 },
 {
   "id": 3467,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 19,
   "firman": "Apabila seseorang membuat orang sesamanya bercacat, maka seperti yang telah dilakukannya, begitulah harus dilakukan kepadanya:"
 },
 {
   "id": 3468,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 20,
   "firman": "patah ganti patah, mata ganti mata, gigi ganti gigi; seperti dibuatnya orang lain bercacat, begitulah harus dibuat kepadanya."
 },
 {
   "id": 3469,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 21,
   "firman": "Siapa yang memukul mati seekor ternak, ia harus membayar gantinya, tetapi siapa yang membunuh seorang manusia, ia harus dihukum mati."
 },
 {
   "id": 3470,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 22,
   "firman": "Satu hukum berlaku bagi kamu, baik bagi orang asing maupun bagi orang Israel asli, sebab Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 3471,
   "kitab": "Ima",
   "pasal": 24,
   "ayat": 23,
   "firman": "Demikianlah Musa menyampaikan firman itu kepada orang Israel, lalu dibawalah orang yang mengutuk itu ke luar perkemahan, dan dilontarilah dia dengan batu. Maka orang Israel melakukan seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3472,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa di gunung Sinai:"
 },
 {
   "id": 3473,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Apabila kamu telah masuk ke negeri yang akan Kuberikan kepadamu, maka tanah itu harus mendapat perhentian sebagai sabat bagi TUHAN."
 },
 {
   "id": 3474,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 3,
   "firman": "Enam tahun lamanya engkau harus menaburi ladangmu, dan enam tahun lamanya engkau harus merantingi kebun anggurmu dan mengumpulkan hasil tanah itu,"
 },
 {
   "id": 3475,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 4,
   "firman": "tetapi pada tahun yang ketujuh haruslah ada bagi tanah itu suatu sabat, masa perhentian penuh, suatu sabat bagi TUHAN. Ladangmu janganlah kautaburi dan kebun anggurmu janganlah kaurantingi."
 },
 {
   "id": 3476,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 5,
   "firman": "Dan apa yang tumbuh sendiri dari penuaianmu itu, janganlah kautuai dan buah anggur dari pokok anggurmu yang tidak dirantingi, janganlah kaupetik. Tahun itu harus menjadi tahun perhentian penuh bagi tanah itu."
 },
 {
   "id": 3477,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 6,
   "firman": "Hasil tanah selama sabat itu haruslah menjadi makanan bagimu, yakni bagimu sendiri, bagi budakmu laki-laki, bagi budakmu perempuan, bagi orang upahan dan bagi orang asing di antaramu, yang semuanya tinggal padamu."
 },
 {
   "id": 3478,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 7,
   "firman": "Juga bagi ternakmu, dan bagi binatang liar yang ada di tanahmu, segala hasil tanah itu menjadi makanannya."
 },
 {
   "id": 3479,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 8,
   "firman": "Selanjutnya engkau harus menghitung tujuh tahun sabat, yakni tujuh kali tujuh tahun; sehingga masa tujuh tahun sabat itu sama dengan empat puluh sembilan tahun."
 },
 {
   "id": 3480,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 9,
   "firman": "Lalu engkau harus memperdengarkan bunyi sangkakala di mana-mana dalam bulan yang ketujuh pada tanggal sepuluh bulan itu; pada hari raya Pendamaian kamu harus memperdengarkan bunyi sangkakala itu di mana-mana di seluruh negerimu."
 },
 {
   "id": 3481,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 10,
   "firman": "Kamu harus menguduskan tahun yang kelima puluh, dan memaklumkan kebebasan di negeri itu bagi segenap penduduknya. Itu harus menjadi tahun Yobel bagimu, dan kamu harus masing-masing pulang ke tanah miliknya dan kepada kaumnya."
 },
 {
   "id": 3482,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 11,
   "firman": "Tahun yang kelima puluh itu harus menjadi tahun Yobel bagimu, jangan kamu menabur, dan apa yang tumbuh sendiri dalam tahun itu jangan kamu tuai, dan pokok anggur yang tidak dirantingi jangan kamu petik buahnya."
 },
 {
   "id": 3483,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 12,
   "firman": "Karena tahun itu adalah tahun Yobel, haruslah itu kudus bagimu; hasil tahun itu yang hendak kamu makan harus diambil dari ladang."
 },
 {
   "id": 3484,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 13,
   "firman": "Dalam tahun Yobel itu kamu harus masing-masing pulang ke tanah miliknya."
 },
 {
   "id": 3485,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 14,
   "firman": "Apabila kamu menjual sesuatu kepada sesamamu atau membeli dari padanya, janganlah kamu merugikan satu sama lain."
 },
 {
   "id": 3486,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 15,
   "firman": "Apabila engkau membeli dari sesamamu haruslah menurut jumlah tahun sesudah tahun Yobel, dan apabila ia menjual kepadamu haruslah menurut jumlah tahun panen."
 },
 {
   "id": 3487,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 16,
   "firman": "Makin besar jumlah tahun itu, makin besarlah pembeliannya, dan makin kecil jumlah tahun itu, makin kecillah pembeliannya, karena jumlah panenlah yang dijualnya kepadamu."
 },
 {
   "id": 3488,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 17,
   "firman": "Janganlah kamu merugikan satu sama lain, tetapi engkau harus takut akan Allahmu, sebab Akulah TUHAN, Allahmu."
 },
 {
   "id": 3489,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 18,
   "firman": "Demikianlah kamu harus melakukan ketetapan-Ku dan tetap berpegang pada peraturan-Ku serta melakukannya, maka kamu akan diam di tanahmu dengan aman tenteram."
 },
 {
   "id": 3490,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 19,
   "firman": "Tanah itu akan memberi hasilnya, dan kamu akan makan sampai kenyang dan diam di sana dengan aman tenteram."
 },
 {
   "id": 3491,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 20,
   "firman": "Apabila kamu bertanya: Apakah yang akan kami makan dalam tahun yang ketujuh itu, bukankah kami tidak boleh menabur dan tidak boleh mengumpulkan hasil tanah kami?"
 },
 {
   "id": 3492,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 21,
   "firman": "Maka Aku akan memerintahkan berkat-Ku kepadamu dalam tahun yang keenam, supaya diberinya hasil untuk tiga tahun."
 },
 {
   "id": 3493,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 22,
   "firman": "Dalam tahun yang kedelapan kamu akan menabur, tetapi kamu akan makan dari hasil yang lama sampai kepada tahun yang kesembilan, sampai masuk hasilnya, kamu akan memakan yang lama.\""
 },
 {
   "id": 3494,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 23,
   "firman": "\"Tanah jangan dijual mutlak, karena Akulah pemilik tanah itu, sedang kamu adalah orang asing dan pendatang bagi-Ku."
 },
 {
   "id": 3495,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 24,
   "firman": "Di seluruh tanah milikmu haruslah kamu memberi hak menebus tanah."
 },
 {
   "id": 3496,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 25,
   "firman": "Apabila saudaramu jatuh miskin, sehingga harus menjual sebagian dari miliknya, maka seorang kaumnya yang berhak menebus, yakni kaumnya yang terdekat harus datang dan menebus yang telah dijual saudaranya itu."
 },
 {
   "id": 3497,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 26,
   "firman": "Apabila seseorang tidak mempunyai penebus, tetapi kemudian ia mampu, sehingga didapatnya yang perlu untuk menebus miliknya itu,"
 },
 {
   "id": 3498,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 27,
   "firman": "maka ia harus memasukkan tahun-tahun sesudah penjualannya itu dalam perhitungan, dan kelebihannya haruslah dikembalikannya kepada orang yang membeli dari padanya, supaya ia boleh pulang ke tanah miliknya."
 },
 {
   "id": 3499,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 28,
   "firman": "Tetapi jikalau ia tidak mampu untuk mengembalikannya kepadanya, maka yang telah dijualnya itu tetap di tangan orang yang membelinya sampai kepada tahun Yobel; dalam tahun Yobel tanah itu akan bebas, dan orang itu boleh pulang ke tanah miliknya.\""
 },
 {
   "id": 3500,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 29,
   "firman": "\"Apabila seseorang menjual rumah tempat tinggal di suatu kota yang berpagar tembok, maka hak menebus hanya berlaku selama setahun mulai dari hari penjualannya; hak menebus berlaku hanya satu tahun."
 },
 {
   "id": 3501,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 30,
   "firman": "Tetapi jikalau rumah itu tidak ditebus dalam jangka waktu setahun itu, rumah itu secara mutlak menjadi milik si pembeli turun temurun; dalam tahun Yobel rumah itu tidaklah bebas."
 },
 {
   "id": 3502,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 31,
   "firman": "Tetapi rumah-rumah di desa-desa yang tidak dikelilingi pagar tembok haruslah dianggap sama dengan ladang-ladang di negeri itu, atasnya harus ada hak menebus dan dalam tahun Yobel rumah itu harus bebas."
 },
 {
   "id": 3503,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 32,
   "firman": "Mengenai rumah-rumah di kota-kota orang Lewi, hak menebus rumah-rumah itu ada pada orang-orang Lewi untuk selama-lamanya."
 },
 {
   "id": 3504,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 33,
   "firman": "Sekalipun dari antara orang Lewi yang melakukan penebusan, tetapi rumah yang terjual di kota miliknya itu haruslah bebas dalam tahun Yobel, karena segala rumah di kota-kota orang Lewi adalah milik mereka masing-masing di tengah-tengah orang Israel."
 },
 {
   "id": 3505,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 34,
   "firman": "Dan padang penggembalaan sekitar kota-kota mereka janganlah dijual, karena itu milik mereka untuk selama-lamanya.\""
 },
 {
   "id": 3506,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 35,
   "firman": "\"Apabila saudaramu jatuh miskin, sehingga tidak sanggup bertahan di antaramu, maka engkau harus menyokong dia sebagai orang asing dan pendatang, supaya ia dapat hidup di antaramu."
 },
 {
   "id": 3507,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 36,
   "firman": "Janganlah engkau mengambil bunga uang atau riba dari padanya, melainkan engkau harus takut akan Allahmu, supaya saudaramu dapat hidup di antaramu."
 },
 {
   "id": 3508,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 37,
   "firman": "Janganlah engkau memberi uangmu kepadanya dengan meminta bunga, juga makananmu janganlah kauberikan dengan meminta riba."
 },
 {
   "id": 3509,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 38,
   "firman": "Akulah TUHAN, Allahmu, yang membawa kamu keluar dari tanah Mesir, untuk memberikan kepadamu tanah Kanaan, supaya Aku menjadi Allahmu."
 },
 {
   "id": 3510,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 39,
   "firman": "Apabila saudaramu jatuh miskin di antaramu, sehingga menyerahkan dirinya kepadamu, maka janganlah memperbudak dia."
 },
 {
   "id": 3511,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 40,
   "firman": "Sebagai orang upahan dan sebagai pendatang ia harus tinggal di antaramu; sampai kepada tahun Yobel ia harus bekerja padamu."
 },
 {
   "id": 3512,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 41,
   "firman": "Kemudian ia harus diizinkan keluar dari padamu, ia bersama-sama anak-anaknya, lalu pulang kembali kepada kaumnya dan ia boleh pulang ke tanah milik nenek moyangnya."
 },
 {
   "id": 3513,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 42,
   "firman": "Karena mereka itu hamba-hamba-Ku yang Kubawa keluar dari tanah Mesir, janganlah mereka itu dijual, secara orang menjual budak."
 },
 {
   "id": 3514,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 43,
   "firman": "Janganlah engkau memerintah dia dengan kejam, melainkan engkau harus takut akan Allahmu."
 },
 {
   "id": 3515,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 44,
   "firman": "Tetapi budakmu laki-laki atau perempuan yang boleh kaumiliki adalah dari antara bangsa-bangsa yang di sekelilingmu; hanya dari antara merekalah kamu boleh membeli budak laki-laki dan perempuan."
 },
 {
   "id": 3516,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 45,
   "firman": "Juga dari antara anak-anak pendatang yang tinggal di antaramu boleh kamu membelinya dan dari antara kaum mereka yang tinggal di antaramu, yang dilahirkan di negerimu. Orang-orang itu boleh menjadi milikmu."
 },
 {
   "id": 3517,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 46,
   "firman": "Kamu harus membagikan mereka sebagai milik pusaka kepada anak-anakmu yang kemudian, supaya diwarisi sebagai milik; kamu harus memperbudakkan mereka untuk selama-lamanya, tetapi atas saudara-saudaramu orang-orang Israel, janganlah memerintah dengan kejam yang satu sama yang lain."
 },
 {
   "id": 3518,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 47,
   "firman": "Apabila seorang asing atau seorang pendatang di antaramu telah menjadi mampu, sedangkan saudaramu yang tinggal padanya jatuh miskin, sehingga menyerahkan dirinya kepada orang asing atau pendatang yang di antaramu itu atau kepada seorang yang berasal dari kaum orang asing,"
 },
 {
   "id": 3519,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 48,
   "firman": "maka sesudah ia menyerahkan dirinya, ia berhak ditebus, yakni seorang dari antara saudara-saudaranya boleh menebus dia,"
 },
 {
   "id": 3520,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 49,
   "firman": "atau saudara ayahnya atau anak laki-laki saudara ayahnya atau seorang kerabatnya yang terdekat dari kaumnya atau kalau ia telah mampu, ia sendiri berhak menebus dirinya."
 },
 {
   "id": 3521,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 50,
   "firman": "Bersama-sama dengan si pembelinya ia harus membuat perhitungan, mulai dari tahun ia menyerahkan dirinya kepada orang itu sampai kepada tahun Yobel, dan harga penjualan dirinya haruslah ditentukan menurut jumlah tahun-tahun itu; masa ia tinggal pada orang itu haruslah dihitung seperti masa kerja orang upahan."
 },
 {
   "id": 3522,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 51,
   "firman": "Jikalau jumlah tahun itu masih besar, maka dari harga pembeliannya harus dikembalikan sebagai penebus dirinya menurut jumlah tahun itu."
 },
 {
   "id": 3523,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 52,
   "firman": "Jika waktu yang masih tinggal sampai kepada tahun Yobel sedikit lagi saja, maka ia harus membuat perhitungan dengan orang itu; menurut jumlah tahun itulah ia harus membayar uang tebusan dirinya."
 },
 {
   "id": 3524,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 53,
   "firman": "Demikianlah ia harus tinggal padanya sebagai orang upahan dari tahun ke tahun. Janganlah ia diperintah dengan kejam oleh orang itu di depan matamu."
 },
 {
   "id": 3525,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 54,
   "firman": "Tetapi jikalau ia tidak ditebus dengan cara demikian, maka ia harus diizinkan keluar dalam tahun Yobel, ia bersama-sama anak-anaknya."
 },
 {
   "id": 3526,
   "kitab": "Ima",
   "pasal": 25,
   "ayat": 55,
   "firman": "Karena pada-Kulah orang Israel menjadi hamba; mereka itu adalah hamba-hamba-Ku yang Kubawa keluar dari tanah Mesir; Akulah TUHAN, Allahmu.\""
 },
 {
   "id": 3527,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 1,
   "firman": "\"Janganlah kamu membuat berhala bagimu, dan patung atau tugu berhala janganlah kamu dirikan bagimu; juga batu berukir janganlah kamu tempatkan di negerimu untuk sujud menyembah kepadanya, sebab Akulah TUHAN, Allahmu."
 },
 {
   "id": 3528,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 2,
   "firman": "Kamu harus memelihara hari-hari Sabat-Ku dan menghormati tempat kudus-Ku, Akulah TUHAN."
 },
 {
   "id": 3529,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 3,
   "firman": "Jikalau kamu hidup menurut ketetapan-Ku dan tetap berpegang pada perintah-Ku serta melakukannya,"
 },
 {
   "id": 3530,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 4,
   "firman": "maka Aku akan memberi kamu hujan pada masanya, sehingga tanah itu memberi hasilnya dan pohon-pohonan di ladangmu akan memberi buahnya."
 },
 {
   "id": 3531,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 5,
   "firman": "Lamanya musim mengirik bagimu akan sampai kepada musim memetik buah anggur dan lamanya musim memetik buah anggur akan sampai kepada musim menabur. Kamu akan makan makananmu sampai kenyang dan diam di negerimu dengan aman tenteram."
 },
 {
   "id": 3532,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 6,
   "firman": "Dan Aku akan memberi damai sejahtera di dalam negeri itu, sehingga kamu akan berbaring dengan tidak dikejutkan oleh apapun; Aku akan melenyapkan binatang buas dari negeri itu, dan pedang tidak akan melintas di negerimu."
 },
 {
   "id": 3533,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 7,
   "firman": "Kamu akan mengejar musuhmu, dan mereka akan tewas di hadapanmu oleh pedang."
 },
 {
   "id": 3534,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 8,
   "firman": "Lima orang dari antaramu akan mengejar seratus, dan seratus orang dari antaramu akan mengejar selaksa dan semua musuhmu akan tewas di hadapanmu oleh pedang."
 },
 {
   "id": 3535,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 9,
   "firman": "Dan Aku akan berpaling kepadamu dan akan membuat kamu beranak cucu serta bertambah banyak dan Aku akan meneguhkan perjanjian-Ku dengan kamu."
 },
 {
   "id": 3536,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 10,
   "firman": "Kamu masih akan makan hasil lama dari panen yang lampau, dan hasil lama itu akan kamu keluarkan untuk menyimpan yang baru."
 },
 {
   "id": 3537,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 11,
   "firman": "Aku akan menempatkan Kemah Suci-Ku di tengah-tengahmu dan hati-Ku tidak akan muak melihat kamu."
 },
 {
   "id": 3538,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 12,
   "firman": "Tetapi Aku akan hadir di tengah-tengahmu dan Aku akan menjadi Allahmu dan kamu akan menjadi umat-Ku."
 },
 {
   "id": 3539,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 13,
   "firman": "Akulah TUHAN, Allahmu, yang membawa kamu keluar dari tanah Mesir, supaya kamu jangan lagi menjadi budak mereka. Aku telah mematahkan kayu kuk yang di atasmu dan membuat kamu berjalan tegak.\""
 },
 {
   "id": 3540,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 14,
   "firman": "\"Tetapi jikalau kamu tidak mendengarkan Daku, dan tidak melakukan segala perintah itu,"
 },
 {
   "id": 3541,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 15,
   "firman": "jikalau kamu menolak ketetapan-Ku dan hatimu muak mendengar peraturan-Ku, sehingga kamu tidak melakukan segala perintah-Ku dan kamu mengingkari perjanjian-Ku,"
 },
 {
   "id": 3542,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 16,
   "firman": "maka Akupun akan berbuat begini kepadamu, yakni Aku akan mendatangkan kekejutan atasmu, batuk kering serta demam, yang membuat mata rusak dan jiwa merana; kamu akan sia-sia menabur benihmu, karena hasilnya akan habis dimakan musuhmu."
 },
 {
   "id": 3543,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 17,
   "firman": "Aku sendiri akan menentang kamu, sehingga kamu akan dikalahkan oleh musuhmu, dan mereka yang membenci kamu akan menguasai kamu, dan kamu akan lari, sungguhpun tidak ada orang mengejar kamu."
 },
 {
   "id": 3544,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 18,
   "firman": "Dan jikalau kamu dalam keadaan yang demikianpun tidak mendengarkan Daku, maka Aku akan lebih keras menghajar kamu sampai tujuh kali lipat karena dosamu,"
 },
 {
   "id": 3545,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 19,
   "firman": "dan Aku akan mematahkan kekuasaanmu yang kaubanggakan dan akan membuat langit di atasmu sebagai besi dan tanahmu sebagai tembaga."
 },
 {
   "id": 3546,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 20,
   "firman": "Maka tenagamu akan habis dengan sia-sia, tanahmu tidak akan memberi hasilnya dan pohon-pohonan di tanah itu tidak akan memberi buahnya."
 },
 {
   "id": 3547,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 21,
   "firman": "Jikalau hidupmu tetap bertentangan dengan Daku dan kamu tidak mau mendengarkan Daku, maka Aku akan makin menambah hukuman atasmu sampai tujuh kali lipat setimpal dengan dosamu."
 },
 {
   "id": 3548,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 22,
   "firman": "Aku akan melepaskan kepadamu binatang liar yang akan memunahkan anak-anakmu dan yang akan melenyapkan ternakmu, serta membuat kamu menjadi sedikit, sehingga jalan-jalanmu menjadi sunyi."
 },
 {
   "id": 3549,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 23,
   "firman": "Jikalau kamu dalam keadaan yang demikianpun tidak mau Kuajar, dan hidupmu tetap bertentangan dengan Daku,"
 },
 {
   "id": 3550,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 24,
   "firman": "maka Akupun akan bertindak melawan kamu dan Aku sendiri akan menghukum kamu tujuh kali lipat karena dosamu,"
 },
 {
   "id": 3551,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 25,
   "firman": "dan Aku akan mendatangkan ke atasmu suatu pedang, yang akan melakukan pembalasan oleh karena perjanjian itu; bila kamu berkumpul kelak di kota-kotamu, maka Aku akan melepas penyakit sampar ke tengah-tengahmu dan kamu akan diserahkan ke dalam tangan musuh."
 },
 {
   "id": 3552,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 26,
   "firman": "Jika Aku memusnahkan persediaan makananmu, maka sepuluh perempuan akan membakar roti di dalam satu pembakaran. Mereka akan mengembalikan rotimu menurut timbangan tertentu, dan kamu akan makan, tetapi tidak menjadi kenyang."
 },
 {
   "id": 3553,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 27,
   "firman": "Dan jikalau kamu dalam keadaan yang demikianpun tidak mendengarkan Daku, dan hidupmu tetap bertentangan dengan Daku,"
 },
 {
   "id": 3554,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 28,
   "firman": "maka Akupun akan bertindak keras melawan kamu dan Aku sendiri akan menghajar kamu tujuh kali lipat karena dosamu,"
 },
 {
   "id": 3555,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 29,
   "firman": "dan kamu akan memakan daging anak-anakmu lelaki dan anak-anakmu perempuan."
 },
 {
   "id": 3556,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 30,
   "firman": "Dan bukit-bukit pengorbananmu akan Kupunahkan, dan segala pedupaanmu akan Kulenyapkan. Aku akan melemparkan bangkai-bangkaimu ke atas bangkai-bangkai berhalamu dan hati-Ku akan muak melihat kamu."
 },
 {
   "id": 3557,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 31,
   "firman": "Kota-kotamu akan Kubuat menjadi reruntuhan dan tempat-tempat kudusmu akan Kurusakkan dan Aku tidak mau lagi menghirup bau persembahanmu yang menyenangkan."
 },
 {
   "id": 3558,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 32,
   "firman": "Aku sendiri akan merusakkan negeri itu, sehingga musuhmu yang tinggal di situ akan tercengang karenanya."
 },
 {
   "id": 3559,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 33,
   "firman": "Tetapi kamu akan Kuserakkan di antara bangsa-bangsa lain dan Aku akan menghunus pedang di belakang kamu, dan tanahmu akan menjadi tempat tandus dan kota-kotamu akan menjadi reruntuhan."
 },
 {
   "id": 3560,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 34,
   "firman": "Pada waktu itulah tanah itu pulih dari dilalaikannya tahun-tahun sabatnya selama tanah itu tandus dan selama kamu tinggal di negeri musuh-musuhmu; pada waktu itulah tanah itu akan menjalani sabatnya dan dipulihkan tahun-tahun sabat yang belum didapatnya."
 },
 {
   "id": 3561,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 35,
   "firman": "Selama ketandusannya tanah itu akan menjalani sabat yang belum dijalaninya pada tiap-tiap tahun sabatmu, ketika kamu masih diam di situ."
 },
 {
   "id": 3562,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 36,
   "firman": "Dan mengenai mereka yang masih tinggal hidup dari antaramu, Aku akan mendatangkan kecemasan ke dalam hati mereka di dalam negeri-negeri musuh mereka, sehingga bunyi daun yang ditiupkan anginpun akan mengejar mereka, dan mereka akan lari seperti orang lari menjauhi pedang, dan mereka akan rebah, sungguhpun tidak ada orang yang mengejar."
 },
 {
   "id": 3563,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 37,
   "firman": "Dan mereka akan jatuh tersandung seorang kepada seorang seolah-olah hendak menjauhi pedang, sungguhpun yang mengejar tidak ada, dan kamu tidak akan dapat bertahan di hadapan musuh-musuhmu."
 },
 {
   "id": 3564,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 38,
   "firman": "Dan kamu akan binasa di antara bangsa-bangsa lain, dan negeri musuhmu akan memusnahkan kamu."
 },
 {
   "id": 3565,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 39,
   "firman": "Dan siapa yang masih tinggal hidup dari antaramu, mereka akan hancur lebur dalam hukumannya di negeri-negeri musuh mereka, dan karena kesalahan nenek moyang mereka juga mereka akan hancur lebur sama seperti nenek moyangnya."
 },
 {
   "id": 3566,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 40,
   "firman": "Tetapi bila mereka mengakui kesalahan mereka dan kesalahan nenek moyang mereka dalam hal berubah setia yang dilakukan mereka terhadap Aku dan mengakui juga bahwa hidup mereka bertentangan dengan Daku"
 },
 {
   "id": 3567,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 41,
   "firman": "--Akupun bertindak melawan mereka dan membawa mereka ke negeri musuh mereka--atau bila kemudian hati mereka yang tidak bersunat itu telah tunduk dan mereka telah membayar pulih kesalahan mereka,"
 },
 {
   "id": 3568,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 42,
   "firman": "maka Aku akan mengingat perjanjian-Ku dengan Yakub; juga perjanjian dengan Ishak dan perjanjian-Ku dengan Abrahampun akan Kuingat dan negeri itu akan Kuingat juga."
 },
 {
   "id": 3569,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 43,
   "firman": "Jadi tanah itu akan ditinggalkan mereka dan akan pulih dari akibat tahun-tahun sabat yang dilalaikan selama tanah itu tandus, oleh karena ditinggalkan mereka, dan mereka akan membayar pulih kesalahan mereka, tak lain dan tak bukan karena mereka menolak peraturan-Ku dan hati mereka muak mendengarkan ketetapan-Ku."
 },
 {
   "id": 3570,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 44,
   "firman": "Namun demikian, apabila mereka ada di negeri musuh mereka, Aku tidak akan menolak mereka dan tidak akan muak melihat mereka, sehingga Aku membinasakan mereka dan membatalkan perjanjian-Ku dengan mereka, sebab Akulah TUHAN, Allah mereka."
 },
 {
   "id": 3571,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 45,
   "firman": "Untuk keselamatan mereka Aku akan mengingat perjanjian dengan orang-orang dahulu yang Kubawa keluar dari tanah Mesir di depan mata bangsa-bangsa lain, supaya Aku menjadi Allah mereka; Akulah TUHAN.\""
 },
 {
   "id": 3572,
   "kitab": "Ima",
   "pasal": 26,
   "ayat": 46,
   "firman": "Itulah ketetapan-ketetapan dan peraturan-peraturan serta hukum-hukum yang diberikan TUHAN, berlaku di antara Dia dengan orang Israel, di gunung Sinai, dengan perantaraan Musa."
 },
 {
   "id": 3573,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3574,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakan kepada mereka: Apabila seorang mengucapkan nazar khusus kepada TUHAN mengenai orang menurut penilaian yang berlaku untuk itu,"
 },
 {
   "id": 3575,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 3,
   "firman": "maka tentang nilai bagi orang laki-laki dari yang berumur dua puluh tahun sampai yang berumur enam puluh tahun, nilai itu harus lima puluh syikal perak, ditimbang menurut syikal kudus."
 },
 {
   "id": 3576,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 4,
   "firman": "Tetapi jikalau itu seorang perempuan, maka nilai itu harus tiga puluh syikal."
 },
 {
   "id": 3577,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 5,
   "firman": "Jikalau itu mengenai seorang dari yang berumur lima tahun sampai yang berumur dua puluh tahun, maka bagi laki-laki nilai itu harus dua puluh syikal dan bagi perempuan sepuluh syikal."
 },
 {
   "id": 3578,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 6,
   "firman": "Jikalau itu mengenai seorang dari yang berumur satu bulan sampai yang berumur lima tahun, maka bagi laki-laki nilai itu harus lima syikal perak, dan bagi perempuan tiga syikal perak."
 },
 {
   "id": 3579,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 7,
   "firman": "Jikalau itu mengenai seorang yang berumur enam puluh tahun atau lebih, jikalau itu mengenai laki-laki, maka nilai itu harus lima belas syikal dan bagi perempuan sepuluh syikal."
 },
 {
   "id": 3580,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 8,
   "firman": "Tetapi jikalau orang itu terlalu miskin untuk membayar nilai itu, maka haruslah dihadapkannya orang yang dinazarkannya itu kepada imam, dan imam harus menilainya; sesuai dengan kemampuan orang yang bernazar itu imam harus menentukan nilainya."
 },
 {
   "id": 3581,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 9,
   "firman": "Jikalau itu termasuk hewan yang boleh dipersembahkan sebagai persembahan kepada TUHAN, maka apapun dari pada hewan itu yang dipersembahkan orang itu kepada TUHAN haruslah kudus."
 },
 {
   "id": 3582,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 10,
   "firman": "Janganlah ia menggantinya dan janganlah ia menukarnya, yang baik dengan yang buruk atau yang buruk dengan yang baik. Tetapi jikalau ia menukar juga seekor hewan dengan seekor hewan lain, maka baik hewan itu maupun tukarnya haruslah kudus."
 },
 {
   "id": 3583,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 11,
   "firman": "Jikalau itu barang seekor dari antara hewan haram yang tidak boleh dipersembahkan sebagai persembahan kepada TUHAN, maka hewan itu harus dihadapkannya kepada imam,"
 },
 {
   "id": 3584,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 12,
   "firman": "dan imam harus menetapkan nilainya menurut baik atau buruknya, dan seperti penilaian imam demikianlah jadinya."
 },
 {
   "id": 3585,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 13,
   "firman": "Dan jikalau orang itu mau menebusnya juga, ia harus menambahkan seperlima kepada nilai itu."
 },
 {
   "id": 3586,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 14,
   "firman": "Apabila seorang menguduskan rumahnya sebagai persembahan kudus bagi TUHAN, maka imam harus menetapkan nilainya menurut baik atau buruknya, dan seperti nilai yang ditetapkan imam demikianlah harus dipegang teguh."
 },
 {
   "id": 3587,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 15,
   "firman": "Tetapi jikalau orang yang menguduskan itu mau menebus rumahnya, maka ia harus menambah harganya dengan seperlima dari uang nilainya dan rumah itu menjadi kepunyaannya pula."
 },
 {
   "id": 3588,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 16,
   "firman": "Jikalau seseorang menguduskan sebagian dari ladang miliknya bagi TUHAN, maka nilainya haruslah sesuai dengan taburannya, yakni sehomer taburan benih jelai berharga lima puluh syikal perak."
 },
 {
   "id": 3589,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 17,
   "firman": "Jikalau ia menguduskan ladangnya mulai dari tahun Yobel, maka nilainya haruslah dipegang teguh."
 },
 {
   "id": 3590,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 18,
   "firman": "Tetapi jikalau ia menguduskan ladangnya sesudah tahun Yobel, maka imam harus menghitung harganya bagi orang itu sesuai dengan tahun-tahun yang masih tinggal sampai kepada tahun Yobel, dan harga itu harus dikurangkan dari nilainya."
 },
 {
   "id": 3591,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 19,
   "firman": "Dan jikalau orang yang menguduskannya benar-benar mau menebus ladang itu, maka ia harus menambah harganya dengan seperlima dari uang nilainya dan ladang itu tetap dimilikinya."
 },
 {
   "id": 3592,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 20,
   "firman": "Tetapi jikalau ia tidak menebus ladang itu, malahan ladang itu telah dijualnya kepada orang lain, maka tidak dapat ditebus lagi."
 },
 {
   "id": 3593,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 21,
   "firman": "Tetapi pada waktu bebas dalam tahun Yobel, ladang itu haruslah kudus bagi TUHAN, sama seperti ladang yang dikhususkan bagi TUHAN. Imamlah yang harus memilikinya."
 },
 {
   "id": 3594,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 22,
   "firman": "Dan jikalau ia menguduskan bagi TUHAN ladang yang telah dibelinya dan yang tidak termasuk ladang miliknya dahulu,"
 },
 {
   "id": 3595,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 23,
   "firman": "maka imam harus menghitung baginya harga nilainya sampai kepada tahun Yobel dan orang itu haruslah mempersembahkan nilai itu pada hari itu juga sebagai persembahan kudus bagi TUHAN."
 },
 {
   "id": 3596,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 24,
   "firman": "Dalam tahun Yobel ladang itu harus dipulangkan kepada orang yang menjualnya kepadanya, yakni kepada orang yang mula-mula memiliki tanah itu."
 },
 {
   "id": 3597,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 25,
   "firman": "Dan segala nilai harus menurut syikal kudus, syikal itu harus dua puluh gera beratnya."
 },
 {
   "id": 3598,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 26,
   "firman": "Akan tetapi anak sulung, yang sebagai anak sulung menjadi hak TUHAN dari antara hewan, tidak boleh dikuduskan oleh siapapun, baik seekor lembu maupun seekor kambing atau domba, itu milik TUHAN."
 },
 {
   "id": 3599,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 27,
   "firman": "Tetapi jikalau itu dari antara hewan yang haram, maka haruslah orang menebusnya menurut nilainya dengan menambah seperlima dan jikalau tidak ditebus, haruslah dijual menurut nilainya."
 },
 {
   "id": 3600,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 28,
   "firman": "Akan tetapi segala yang sudah dikhususkan oleh seseorang bagi TUHAN dari segala miliknya, baik manusia atau hewan, maupun ladang miliknya, tidak boleh dijual dan tidak boleh ditebus, karena segala yang dikhususkan adalah maha kudus bagi TUHAN."
 },
 {
   "id": 3601,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 29,
   "firman": "Setiap orang yang dikhususkan, yang harus ditumpas di antara manusia, tidak boleh ditebus, pastilah ia dihukum mati."
 },
 {
   "id": 3602,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 30,
   "firman": "Demikian juga segala persembahan persepuluhan dari tanah, baik dari hasil benih di tanah maupun dari buah pohon-pohonan, adalah milik TUHAN; itulah persembahan kudus bagi TUHAN."
 },
 {
   "id": 3603,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 31,
   "firman": "Tetapi jikalau seseorang mau menebus juga sebagian dari persembahan persepuluhannya itu, maka ia harus menambah seperlima."
 },
 {
   "id": 3604,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 32,
   "firman": "Mengenai segala persembahan persepuluhan dari lembu sapi atau kambing domba, maka dari segala yang lewat dari bawah tongkat gembala waktu dihitung, setiap yang kesepuluh harus menjadi persembahan kudus bagi TUHAN."
 },
 {
   "id": 3605,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 33,
   "firman": "Janganlah dipilih-pilih mana yang baik dan mana yang buruk, dan janganlah ditukar; jikalau orang menukarnya juga, maka baik hewan itu maupun tukarnya haruslah kudus dan tidak boleh ditebus.\""
 },
 {
   "id": 3606,
   "kitab": "Ima",
   "pasal": 27,
   "ayat": 34,
   "firman": "Itulah perintah-perintah yang diperintahkan TUHAN kepada Musa di gunung Sinai untuk disampaikan kepada orang Israel."
 },
 {
   "id": 3607,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa di padang gurun Sinai, dalam Kemah Pertemuan, pada tanggal satu bulan yang kedua dalam tahun yang kedua sesudah mereka keluar dari tanah Mesir:"
 },
 {
   "id": 3608,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 2,
   "firman": "\"Hitunglah jumlah segenap umat Israel menurut kaum-kaum yang ada dalam setiap suku mereka, dan catatlah nama semua laki-laki di Israel"
 },
 {
   "id": 3609,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 3,
   "firman": "yang berumur dua puluh tahun ke atas dan yang sanggup berperang, orang demi orang. Engkau ini beserta Harun harus mencatat mereka menurut pasukannya masing-masing."
 },
 {
   "id": 3610,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 4,
   "firman": "Dari tiap-tiap suku harus ada satu orang yang mendampingi kamu, yakni orang yang menjadi kepala dari suku yang diwakilinya itu."
 },
 {
   "id": 3611,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 5,
   "firman": "Dan inilah nama semua orang yang harus mendampingi kamu. Dari suku Ruben: Elizur bin Syedeur;"
 },
 {
   "id": 3612,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 6,
   "firman": "dari suku Simeon: Selumiel bin Zurisyadai;"
 },
 {
   "id": 3613,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 7,
   "firman": "dari suku Yehuda: Nahason bin Aminadab;"
 },
 {
   "id": 3614,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 8,
   "firman": "dari suku Isakhar: Netaneel bin Zuar;"
 },
 {
   "id": 3615,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 9,
   "firman": "dari suku Zebulon: Eliab bin Helon;"
 },
 {
   "id": 3616,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 10,
   "firman": "dari keturunan Yusuf: Elisama bin Amihud dari suku Efraim, dan Gamaliel bin Pedazur dari suku Manasye;"
 },
 {
   "id": 3617,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 11,
   "firman": "dari suku Benyamin: Abidan bin Gideoni;"
 },
 {
   "id": 3618,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 12,
   "firman": "dari suku Dan: Ahiezer bin Amisyadai;"
 },
 {
   "id": 3619,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 13,
   "firman": "dari suku Asyer: Pagiel bin Okhran;"
 },
 {
   "id": 3620,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 14,
   "firman": "dari suku Gad: Elyasaf bin Rehuel;"
 },
 {
   "id": 3621,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 15,
   "firman": "dari suku Naftali: Ahira bin Enan.\""
 },
 {
   "id": 3622,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 16,
   "firman": "Itulah orang-orang yang dipilih dari umat itu, masing-masing sebagai pemimpin dari suku bapa leluhurnya; mereka inilah kepala-kepala pasukan Israel."
 },
 {
   "id": 3623,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 17,
   "firman": "Lalu Musa dan Harun memanggil orang-orang yang tertunjuk namanya itu,"
 },
 {
   "id": 3624,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 18,
   "firman": "dan pada tanggal satu bulan yang kedua mereka menyuruh segenap umat berkumpul. Kemudian silsilah orang-orang Israel disusun menurut kaum-kaum yang ada dalam setiap suku mereka, sedang nama-nama mereka yang berumur dua puluh tahun ke atas dicatat orang demi orang,"
 },
 {
   "id": 3625,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 19,
   "firman": "seperti yang diperintahkan TUHAN kepada Musa. Demikianlah Musa mencatat mereka di padang gurun Sinai."
 },
 {
   "id": 3626,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 20,
   "firman": "Ketika silsilah bani Ruben, yaitu keturunan anak sulung Israel, disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama semua laki-laki yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang, orang demi orang."
 },
 {
   "id": 3627,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 21,
   "firman": "Jumlah yang dicatat dari suku Ruben ada empat puluh enam ribu lima ratus orang."
 },
 {
   "id": 3628,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 22,
   "firman": "Ketika silsilah bani Simeon disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama semua laki-laki yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang, orang demi orang."
 },
 {
   "id": 3629,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 23,
   "firman": "Jumlah yang dicatat dari suku Simeon ada lima puluh sembilan ribu tiga ratus orang."
 },
 {
   "id": 3630,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 24,
   "firman": "Ketika silsilah bani Gad disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3631,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 25,
   "firman": "Jumlah yang dicatat dari suku Gad ada empat puluh lima ribu enam ratus lima puluh orang."
 },
 {
   "id": 3632,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 26,
   "firman": "Ketika silsilah bani Yehuda disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3633,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 27,
   "firman": "Jumlah yang dicatat dari suku Yehuda ada tujuh puluh empat ribu enam ratus orang."
 },
 {
   "id": 3634,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 28,
   "firman": "Ketika silsilah bani Isakhar disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3635,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 29,
   "firman": "Jumlah yang dicatat dari suku Isakhar ada lima puluh empat ribu empat ratus orang."
 },
 {
   "id": 3636,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 30,
   "firman": "Ketika silsilah bani Zebulon disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3637,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 31,
   "firman": "Jumlah yang dicatat dari suku Zebulon ada lima puluh tujuh ribu empat ratus orang."
 },
 {
   "id": 3638,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 32,
   "firman": "Mengenai keturunan Yusuf: Ketika silsilah bani Efraim disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3639,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 33,
   "firman": "Jumlah yang dicatat dari suku Efraim ada empat puluh ribu lima ratus orang."
 },
 {
   "id": 3640,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 34,
   "firman": "Dan ketika silsilah bani Manasye disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3641,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 35,
   "firman": "Jumlah yang dicatat dari suku Manasye ada tiga puluh dua ribu dua ratus orang."
 },
 {
   "id": 3642,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 36,
   "firman": "Ketika silsilah bani Benyamin disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3643,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 37,
   "firman": "Jumlah yang dicatat dari suku Benyamin ada tiga puluh lima ribu empat ratus orang."
 },
 {
   "id": 3644,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 38,
   "firman": "Ketika silsilah bani Dan disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3645,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 39,
   "firman": "Jumlah yang dicatat dari suku Dan ada enam puluh dua ribu tujuh ratus orang."
 },
 {
   "id": 3646,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 40,
   "firman": "Ketika silsilah bani Asyer disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3647,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 41,
   "firman": "Jumlah yang dicatat dari suku Asyer ada empat puluh satu ribu lima ratus orang."
 },
 {
   "id": 3648,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 42,
   "firman": "Ketika silsilah bani Naftali disusun menurut kaum-kaum yang ada dalam suku mereka, maka dicatatlah nama orang-orang yang berumur dua puluh tahun ke atas, semua orang yang sanggup berperang."
 },
 {
   "id": 3649,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 43,
   "firman": "Jumlah yang dicatat dari suku Naftali ada lima puluh tiga ribu empat ratus orang."
 },
 {
   "id": 3650,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 44,
   "firman": "Itulah jumlah orang-orang yang dicatat oleh Musa dengan Harun dan dengan kedua belas pemimpin Israel yang masing-masing mewakili sukunya."
 },
 {
   "id": 3651,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 45,
   "firman": "Jadi semua orang Israel yang dicatat menurut suku-suku mereka, yaitu orang-orang yang berumur dua puluh tahun ke atas dan yang sanggup berperang di antara orang Israel,"
 },
 {
   "id": 3652,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 46,
   "firman": "berjumlah enam ratus tiga ribu lima ratus lima puluh orang."
 },
 {
   "id": 3653,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 47,
   "firman": "Tetapi mereka yang menurut suku bapa leluhurnya termasuk orang Lewi, tidak turut dicatat bersama-sama dengan mereka itu."
 },
 {
   "id": 3654,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 48,
   "firman": "Sebab TUHAN telah berfirman kepada Musa:"
 },
 {
   "id": 3655,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 49,
   "firman": "\"Hanya suku Lewi janganlah kaucatat dan janganlah kauhitung jumlahnya bersama-sama dengan orang Israel,"
 },
 {
   "id": 3656,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 50,
   "firman": "tetapi tugaskanlah mereka untuk mengawasi Kemah Suci, tempat hukum Allah dengan segala perabotan dan perlengkapannya; mereka harus mengangkat Kemah Suci dengan segala perabotannya; mereka harus mengurusnya dan harus berkemah di sekelilingnya."
 },
 {
   "id": 3657,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 51,
   "firman": "Apabila berangkat, Kemah Suci harus dibongkar oleh orang Lewi, dan apabila berkemah, Kemah Suci harus dipasang oleh mereka; sedang orang awam yang mendekat harus dihukum mati."
 },
 {
   "id": 3658,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 52,
   "firman": "Orang Israel haruslah berkemah masing-masing di tempat perkemahannya dan masing-masing dekat panji-panjinya, menurut pasukan mereka,"
 },
 {
   "id": 3659,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 53,
   "firman": "tetapi orang Lewi haruslah berkemah di sekeliling Kemah Suci, tempat hukum Allah supaya umat Israel jangan kena murka; orang Lewi haruslah memelihara Kemah Suci, tempat hukum itu.\""
 },
 {
   "id": 3660,
   "kitab": "Bil",
   "pasal": 1,
   "ayat": 54,
   "firman": "Maka orang Israel berbuat demikian; tepat seperti yang diperintahkan TUHAN kepada Musa, demikianlah diperbuat mereka."
 },
 {
   "id": 3661,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3662,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 2,
   "firman": "\"Orang Israel harus berkemah masing-masing dekat panji-panjinya, menurut lambang suku-sukunya. Mereka harus berkemah di sekeliling Kemah Pertemuan, agak jauh dari padanya."
 },
 {
   "id": 3663,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 3,
   "firman": "Yang berkemah di sebelah timur dekat panji-panjinya, ialah laskar Yehuda, menurut pasukan-pasukan mereka. Pemimpin bani Yehuda ialah Nahason bin Aminadab."
 },
 {
   "id": 3664,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 4,
   "firman": "Pasukannya terdiri dari tujuh puluh empat ribu enam ratus orang yang dicatat."
 },
 {
   "id": 3665,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 5,
   "firman": "Yang berkemah di dekatnya ialah suku Isakhar. Pemimpin bani Isakhar ialah Netaneel bin Zuar."
 },
 {
   "id": 3666,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 6,
   "firman": "Pasukannya terdiri dari lima puluh empat ribu empat ratus orang yang dicatat."
 },
 {
   "id": 3667,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 7,
   "firman": "Kemudian suku Zebulon. Pemimpin bani Zebulon ialah Eliab bin Helon."
 },
 {
   "id": 3668,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 8,
   "firman": "Pasukannya terdiri dari lima puluh tujuh ribu empat ratus orang yang dicatat."
 },
 {
   "id": 3669,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 9,
   "firman": "Jumlah orang yang dicatat dalam laskar Yehuda menurut pasukan-pasukan mereka ada seratus delapan puluh enam ribu empat ratus orang. Merekalah yang terdahulu berangkat."
 },
 {
   "id": 3670,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 10,
   "firman": "Panji-panji laskar Ruben adalah di sebelah selatan, menurut pasukan-pasukan mereka. Pemimpin bani Ruben ialah Elizur bin Syedeur."
 },
 {
   "id": 3671,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 11,
   "firman": "Pasukannya terdiri dari empat puluh enam ribu lima ratus orang yang dicatat."
 },
 {
   "id": 3672,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 12,
   "firman": "Yang berkemah di dekatnya ialah suku Simeon. Pemimpin bani Simeon ialah Selumiel bin Zurisyadai."
 },
 {
   "id": 3673,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 13,
   "firman": "Pasukannya terdiri dari lima puluh sembilan ribu tiga ratus orang yang dicatat."
 },
 {
   "id": 3674,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 14,
   "firman": "Kemudian suku Gad. Pemimpin bani Gad ialah Elyasaf bin Rehuel."
 },
 {
   "id": 3675,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 15,
   "firman": "Pasukannya terdiri dari empat puluh lima ribu enam ratus lima puluh orang yang dicatat."
 },
 {
   "id": 3676,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 16,
   "firman": "Jumlah orang yang dicatat dalam laskar Ruben menurut pasukan-pasukan mereka ada seratus lima puluh satu ribu empat ratus lima puluh orang. Merekalah yang nomor dua berangkat."
 },
 {
   "id": 3677,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 17,
   "firman": "Sesudah itu berangkatlah Kemah Pertemuan dengan laskar orang Lewi, di tengah-tengah laskar yang lain itu. Sama seperti mereka berkemah, demikianlah juga mereka berangkat, masing-masing di tempatnya menurut panji-panji mereka."
 },
 {
   "id": 3678,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 18,
   "firman": "Panji-panji laskar Efraim, menurut pasukan-pasukan mereka, adalah di sebelah barat. Pemimpin bani Efraim ialah Elisama bin Amihud."
 },
 {
   "id": 3679,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 19,
   "firman": "Pasukannya terdiri dari empat puluh ribu lima ratus orang yang dicatat."
 },
 {
   "id": 3680,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 20,
   "firman": "Di dekatnya ialah suku Manasye. Pemimpin bani Manasye ialah Gamaliel bin Pedazur."
 },
 {
   "id": 3681,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 21,
   "firman": "Pasukannya terdiri dari tiga puluh dua ribu dua ratus orang yang dicatat."
 },
 {
   "id": 3682,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 22,
   "firman": "Kemudian suku Benyamin. Pemimpin bani Benyamin ialah Abidan bin Gideoni."
 },
 {
   "id": 3683,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 23,
   "firman": "Pasukannya terdiri dari tiga puluh lima ribu empat ratus orang yang dicatat."
 },
 {
   "id": 3684,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 24,
   "firman": "Jumlah orang yang dicatat dalam laskar Efraim menurut pasukan-pasukan mereka ada seratus delapan ribu seratus orang. Merekalah yang nomor tiga berangkat."
 },
 {
   "id": 3685,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 25,
   "firman": "Panji-panji laskar Dan adalah di sebelah utara, menurut pasukan-pasukan mereka. Pemimpin bani Dan ialah Ahiezer bin Amisyadai."
 },
 {
   "id": 3686,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 26,
   "firman": "Pasukannya terdiri dari enam puluh dua ribu tujuh ratus orang yang dicatat."
 },
 {
   "id": 3687,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 27,
   "firman": "Yang berkemah di dekatnya ialah suku Asyer. Pemimpin bani Asyer ialah Pagiel bin Okhran."
 },
 {
   "id": 3688,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 28,
   "firman": "Pasukannya terdiri dari empat puluh satu ribu lima ratus orang yang dicatat."
 },
 {
   "id": 3689,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 29,
   "firman": "Kemudian suku Naftali. Pemimpin bani Naftali ialah Ahira bin Enan."
 },
 {
   "id": 3690,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 30,
   "firman": "Pasukannya terdiri dari lima puluh tiga ribu empat ratus orang yang dicatat."
 },
 {
   "id": 3691,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 31,
   "firman": "Jumlah orang yang dicatat dalam laskar Dan ada seratus lima puluh tujuh ribu enam ratus orang. Merekalah yang terkemudian berangkat, menurut panji-panji mereka.\""
 },
 {
   "id": 3692,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 32,
   "firman": "Itulah pencatatan orang Israel menurut suku-suku mereka. Jumlah orang yang dicatat dalam laskar-laskar dengan pasukan-pasukannya ada enam ratus tiga ribu lima ratus lima puluh orang."
 },
 {
   "id": 3693,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 33,
   "firman": "Tetapi orang Lewi tidak turut dicatat bersama-sama dengan orang Israel, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3694,
   "kitab": "Bil",
   "pasal": 2,
   "ayat": 34,
   "firman": "Maka orang Israel berbuat demikian; tepat seperti yang diperintahkan TUHAN kepada Musa, demikianlah mereka berkemah menurut panji-panji mereka, dan demikianlah mereka berangkat, masing-masing menurut kaumnya dan sukunya."
 },
 {
   "id": 3695,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 1,
   "firman": "Inilah keturunan Harun dan Musa pada waktu TUHAN berfirman kepada Musa di gunung Sinai."
 },
 {
   "id": 3696,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 2,
   "firman": "Nama anak-anak Harun, ialah: yang sulung Nadab, kemudian Abihu, Eleazar dan Itamar."
 },
 {
   "id": 3697,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 3,
   "firman": "Itulah nama anak-anak Harun, imam-imam yang diurapi, yang telah ditahbiskan untuk memegang jabatan imam."
 },
 {
   "id": 3698,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 4,
   "firman": "Tetapi Nadab dan Abihu sudah mati di hadapan TUHAN di padang gurun Sinai, ketika mereka mempersembahkan api yang asing ke hadapan TUHAN. Mereka tidak mempunyai anak. Jadi ketika Harun, ayah mereka, masih hidup, yang memegang jabatan imam ialah Eleazar dan Itamar."
 },
 {
   "id": 3699,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 5,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3700,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 6,
   "firman": "\"Suruhlah suku Lewi mendekat dan menghadap imam Harun, supaya mereka melayani dia."
 },
 {
   "id": 3701,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 7,
   "firman": "Mereka harus mengerjakan tugas-tugas bagi Harun dan bagi segenap umat Israel di depan Kemah Pertemuan dan dengan demikian melakukan pekerjaan jabatannya pada Kemah Suci."
 },
 {
   "id": 3702,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 8,
   "firman": "Mereka harus memelihara segala perabotan Kemah Pertemuan, dan mengerjakan tugas-tugas bagi orang Israel dan dengan demikian melakukan pekerjaan jabatannya pada Kemah Suci."
 },
 {
   "id": 3703,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 9,
   "firman": "Orang Lewi harus kauserahkan kepada Harun dan anak-anaknya; dari antara orang Israel haruslah orang-orang itu diserahkan kepadanya dengan sepenuhnya."
 },
 {
   "id": 3704,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 10,
   "firman": "Tetapi Harun dan anak-anaknya haruslah kautugaskan untuk memegang jabatannya sebagai imam, sedang orang awam yang mendekat harus dihukum mati.\""
 },
 {
   "id": 3705,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 11,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3706,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 12,
   "firman": "\"Sesungguhnya, Aku mengambil orang Lewi dari antara orang Israel ganti semua anak sulung mereka, yang terdahulu lahir dari kandungan, supaya orang Lewi menjadi kepunyaan-Ku,"
 },
 {
   "id": 3707,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 13,
   "firman": "sebab Akulah yang punya semua anak sulung. Pada waktu Aku membunuh semua anak sulung di tanah Mesir, maka Aku menguduskan bagi-Ku semua anak sulung yang ada pada orang Israel, baik dari manusia maupun dari hewan; semuanya itu kepunyaan-Ku; Akulah TUHAN.\""
 },
 {
   "id": 3708,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 14,
   "firman": "TUHAN berfirman kepada Musa di padang gurun Sinai:"
 },
 {
   "id": 3709,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 15,
   "firman": "\"Catatlah bani Lewi menurut puak-puak dan kaum-kaum mereka; semua laki-laki yang berumur satu bulan ke atas harus kaucatat.\""
 },
 {
   "id": 3710,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 16,
   "firman": "Lalu Musa mencatat mereka sesuai dengan titah TUHAN, seperti yang diperintahkan kepadanya."
 },
 {
   "id": 3711,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 17,
   "firman": "Inilah anak-anak Lewi dengan nama mereka: Gerson, Kehat dan Merari."
 },
 {
   "id": 3712,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 18,
   "firman": "Inilah nama anak-anak Gerson dan kaum-kaum mereka: Libni dan Simei."
 },
 {
   "id": 3713,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 19,
   "firman": "Anak-anak Kehat dan kaum-kaum mereka ialah Amram, Yizhar, Hebron dan Uziel."
 },
 {
   "id": 3714,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 20,
   "firman": "Anak-anak Merari dan kaum-kaum mereka ialah Mahli dan Musi. Inilah kaum-kaum orang Lewi yang ada dalam puak-puak mereka."
 },
 {
   "id": 3715,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 21,
   "firman": "Puak Gerson terdiri dari kaum Libni dan kaum Simei; itulah kaum-kaum Gerson."
 },
 {
   "id": 3716,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 22,
   "firman": "Jumlah pencatatan mereka ketika semua laki-laki yang berumur satu bulan ke atas dicatat ada tujuh ribu lima ratus orang."
 },
 {
   "id": 3717,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 23,
   "firman": "Kaum-kaum Gerson ini berkemah di belakang Kemah Suci di sebelah barat."
 },
 {
   "id": 3718,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 24,
   "firman": "Pemimpin puak Gerson ialah Elyasaf bin Lael."
 },
 {
   "id": 3719,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 25,
   "firman": "Yang harus dipelihara oleh bani Gerson dalam Kemah Pertemuan ialah Kemah Suci dan Kemah dengan tudungnya, tirai pintu Kemah Pertemuan,"
 },
 {
   "id": 3720,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 26,
   "firman": "layar pelataran dan tirai pintu pelataran yang ada sekeliling Kemah Suci dan mezbah, dan talinya, termasuk segala pekerjaan yang berhubungan dengan semuanya itu."
 },
 {
   "id": 3721,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 27,
   "firman": "Puak Kehat terdiri dari kaum Amram, kaum Yizhar, kaum Hebron dan kaum Uziel; itulah kaum-kaum Kehat."
 },
 {
   "id": 3722,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 28,
   "firman": "Jumlah pencatatan mereka ketika semua laki-laki yang berumur satu bulan ke atas dicatat ada delapan ribu enam ratus orang, yakni mereka yang memelihara barang-barang kudus."
 },
 {
   "id": 3723,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 29,
   "firman": "Kaum-kaum bani Kehat ini berkemah pada sisi Kemah Suci sebelah selatan."
 },
 {
   "id": 3724,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 30,
   "firman": "Pemimpin puak Kehat dan kaum-kaumnya ialah Elisafan bin Uziel."
 },
 {
   "id": 3725,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 31,
   "firman": "Yang harus dipelihara mereka ialah tabut, meja, kandil, mezbah-mezbah, perkakas tempat kudus yang dipakai untuk menyelenggarakan ibadah, juga tirai, termasuk segala pekerjaan yang berhubungan dengan semuanya itu."
 },
 {
   "id": 3726,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 32,
   "firman": "Adapun pemimpin tertinggi orang Lewi ialah Eleazar, anak imam Harun, yang mengawasi mereka yang memelihara barang-barang kudus."
 },
 {
   "id": 3727,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 33,
   "firman": "Puak Merari terdiri dari kaum Mahli dan kaum Musi; itulah kaum-kaum Merari."
 },
 {
   "id": 3728,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 34,
   "firman": "Jumlah pencatatan mereka ketika semua laki-laki yang berumur satu bulan ke atas dicatat ada enam ribu dua ratus orang."
 },
 {
   "id": 3729,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 35,
   "firman": "Pemimpin puak Merari dan kaum-kaumnya ialah Zuriel bin Abihail. Mereka berkemah pada sisi Kemah Suci sebelah utara."
 },
 {
   "id": 3730,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 36,
   "firman": "Yang ditugaskan kepada bani Merari untuk dipelihara ialah papan Kemah Suci, kayu lintangnya, tiang-tiangnya, alasnya, segala perabotannya, termasuk segala pekerjaan yang berhubungan dengan semuanya itu,"
 },
 {
   "id": 3731,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 37,
   "firman": "juga tiang pelataran sekelilingnya, alas, patok dan talinya."
 },
 {
   "id": 3732,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 38,
   "firman": "Yang berkemah di depan Kemah Suci di sebelah timur, di depan Kemah Pertemuan, ialah Musa, dan Harun serta anak-anaknya, yang mengerjakan tugas pemeliharaan tempat kudus bagi orang Israel; tetapi orang awam yang mendekat, haruslah dihukum mati."
 },
 {
   "id": 3733,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 39,
   "firman": "Jumlah orang Lewi yang sesuai dengan titah TUHAN dicatat oleh Musa dan Harun, menurut kaum-kaum mereka, yakni semua laki-laki yang berumur satu bulan ke atas, ada dua puluh dua ribu orang."
 },
 {
   "id": 3734,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 40,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa: \"Catatlah semua anak sulung laki-laki Israel yang berumur satu bulan ke atas, lalu hitunglah jumlah mereka,"
 },
 {
   "id": 3735,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 41,
   "firman": "dan ambillah orang-orang Lewi bagi-Ku--Akulah TUHAN--sebagai ganti semua anak sulung yang ada pada orang Israel, juga hewan orang Lewi ganti semua anak sulung di antara hewan orang Israel.\""
 },
 {
   "id": 3736,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 42,
   "firman": "Maka Musa mencatat semua anak sulung yang ada pada orang Israel, seperti yang diperintahkan TUHAN kepadanya."
 },
 {
   "id": 3737,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 43,
   "firman": "Semua anak sulung laki-laki yang dicatat namanya dalam pencatatan itu, yakni yang berumur satu bulan ke atas, ada dua puluh dua ribu dua ratus tujuh puluh tiga orang."
 },
 {
   "id": 3738,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 44,
   "firman": "Lalu berfirmanlah TUHAN kepada Musa:"
 },
 {
   "id": 3739,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 45,
   "firman": "\"Ambillah orang Lewi ganti semua anak sulung yang ada pada orang Israel, juga hewan orang Lewi ganti hewan mereka, supaya orang Lewi itu menjadi kepunyaan-Ku; Akulah TUHAN."
 },
 {
   "id": 3740,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 46,
   "firman": "Sebagai uang tebusan untuk kedua ratus tujuh puluh tiga anak sulung Israel yang melebihi jumlah orang Lewi itu,"
 },
 {
   "id": 3741,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 47,
   "firman": "haruslah engkau mengambil lima syikal seorang; engkau harus mengambilnya menurut syikal kudus--syikal ini dua puluh gera beratnya--."
 },
 {
   "id": 3742,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 48,
   "firman": "Berikanlah perak itu kepada Harun dan anak-anaknya sebagai uang tebusan untuk orang-orang yang kelebihan itu.\""
 },
 {
   "id": 3743,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 49,
   "firman": "Lalu Musa mengambil uang tebusan untuk orang-orang yang melebihi jumlah mereka yang telah ditebus oleh orang Lewi itu;"
 },
 {
   "id": 3744,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 50,
   "firman": "dari pada anak-anak sulung Israel diambilnya perak itu, seribu tiga ratus enam puluh lima syikal, ditimbang menurut syikal kudus,"
 },
 {
   "id": 3745,
   "kitab": "Bil",
   "pasal": 3,
   "ayat": 51,
   "firman": "maka Musa memberikan uang tebusan itu kepada Harun dan anak-anaknya sesuai dengan titah TUHAN, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3746,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3747,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 2,
   "firman": "\"Hitunglah jumlah bani Kehat sebagai suatu golongan tersendiri di antara bani Lewi, menurut kaum-kaum yang ada dalam puak mereka."
 },
 {
   "id": 3748,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 3,
   "firman": "Hitunglah yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, semua orang yang kena wajib tugas, supaya mereka melakukan pekerjaan di Kemah Pertemuan."
 },
 {
   "id": 3749,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 4,
   "firman": "Pekerjaan jabatan orang Kehat di Kemah Pertemuan ialah mengurus barang-barang yang maha kudus."
 },
 {
   "id": 3750,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 5,
   "firman": "Kalau perkemahan akan berangkat, haruslah Harun dan anak-anaknya masuk ke dalam untuk menurunkan tabir penudung, dan menudungkannya kepada tabut hukum."
 },
 {
   "id": 3751,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 6,
   "firman": "Di atasnya mereka harus meletakkan tutup dari kulit lumba-lumba, dan di atasnya lagi mereka harus membentangkan sehelai kain yang seluruhnya ungu tua, kemudian mereka harus memasang kayu-kayu pengusung tabut itu."
 },
 {
   "id": 3752,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 7,
   "firman": "Lagipula di atas meja roti sajian mereka harus membentangkan sehelai kain ungu tua, dan di atasnya mereka harus meletakkan pinggan, cawan, piala dan kendi korban curahan; juga roti sajian harus tetap ada di atasnya."
 },
 {
   "id": 3753,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 8,
   "firman": "Di atas semuanya itu mereka harus membentangkan sehelai kain kirmizi, lalu menudungnya dengan tudung dari kulit lumba-lumba, kemudian mereka harus memasang kayu-kayu pengusung meja itu."
 },
 {
   "id": 3754,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 9,
   "firman": "Lalu mereka harus mengambil sehelai kain ungu tua dan menudungkannya kepada kandil untuk penerangan dengan lampu-lampunya, sepit-sepit dan penadah-penadahnya, dan segala perkakas minyaknya yang dipakai untuk mengurus kandil itu."
 },
 {
   "id": 3755,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 10,
   "firman": "Dan mereka harus meletakkannya dengan segala perkakasnya ke atas tudung dengan dari kulit lumba-lumba dan meletakkannya di atas usungan."
 },
 {
   "id": 3756,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 11,
   "firman": "Di atas mezbah dari emas itu mereka harus membentangkan sehelai kain ungu tua dan menudunginya dengan tudung dari kulit lumba-lumba, kemudian mereka harus memasang kayu-kayu pengusung mezbah itu."
 },
 {
   "id": 3757,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 12,
   "firman": "Lalu mereka harus mengambil segala perkakas yang dipakai untuk menyelenggarakan kebaktian di tempat kudus, meletakkannya di atas sehelai kain ungu tua dan menudunginya dengan tudung dari kulit lumba-lumba, kemudian meletakkannya di atas usungan."
 },
 {
   "id": 3758,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 13,
   "firman": "Dan mereka harus membersihkan mezbah itu dari abu, lalu membentangkan sehelai kain ungu muda di atasnya,"
 },
 {
   "id": 3759,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 14,
   "firman": "sesudah itu meletakkan di atasnya segala perkakasnya yang dipakai untuk mengurusnya, yakni perbaraan, garpu, penyodok, bokor penyiraman, segala perkakas mezbah itu, dan di atasnya mereka harus membentangkan tutup dari kulit lumba-lumba, kemudian mereka harus memasang kayu-kayu pengusung mezbah itu."
 },
 {
   "id": 3760,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 15,
   "firman": "Setelah Harun dan anak-anaknya selesai menudungi barang-barang kudus dan segala perkakas tempat kudus, pada waktu perkemahan akan berangkat, barulah orang Kehat boleh masuk ke dalam untuk mengangkat barang-barang itu; tetapi janganlah mereka kena kepada barang-barang kudus itu, nanti mereka mati. Jadi itulah barang-barang di Kemah Pertemuan yang harus diangkat bani Kehat."
 },
 {
   "id": 3761,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 16,
   "firman": "Tetapi Eleazar, anak imam Harun, bertanggung jawab atas minyak untuk penerangan, ukupan dari wangi-wangian, korban sajian yang tetap dan minyak urapan; ia bertanggung jawab atas segenap Kemah Suci dan segala isinya, yakni barang-barang kudus dan perabotannya.\""
 },
 {
   "id": 3762,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 17,
   "firman": "TUHAN berfirman kepada Musa dan Harun:"
 },
 {
   "id": 3763,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 18,
   "firman": "\"Perhatikanlah supaya puak Kehat dan kaum-kaumnya jangan musnah binasa dari tengah-tengah orang Lewi."
 },
 {
   "id": 3764,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 19,
   "firman": "Inilah yang harus kamu lakukan bagi mereka, supaya mereka tinggal hidup dan jangan mati, apabila mereka mendekat ke barang-barang maha kudus: Harun dan anak-anaknya haruslah masuk ke dalam dan menempatkan mereka masing-masing di tempat tugasnya dekat barang yang harus diangkat."
 },
 {
   "id": 3765,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 20,
   "firman": "Tetapi janganlah orang Kehat masuk ke dalam untuk melihat barang-barang kudus itu walau sesaatpun, nanti mereka mati.\""
 },
 {
   "id": 3766,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 21,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3767,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 22,
   "firman": "\"Hitunglah juga jumlah bani Gerson menurut puak dan kaum-kaum mereka."
 },
 {
   "id": 3768,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 23,
   "firman": "Catatlah mereka yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, yakni setiap orang yang wajib tugas, supaya mereka melakukan pekerjaan jabatan di Kemah Pertemuan."
 },
 {
   "id": 3769,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 24,
   "firman": "Inilah tugas kaum-kaum Gerson dalam hal pekerjaan jabatan dan pengangkatan barang itu:"
 },
 {
   "id": 3770,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 25,
   "firman": "mereka harus mengangkat tenda-tenda Kemah Suci, dan Kemah Pertemuan tudungnya dan tudung dari kulit lumba-lumba yang ada di atasnya, tirai pintu Kemah Pertemuan,"
 },
 {
   "id": 3771,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 26,
   "firman": "layar-layar pelataran dan tirai pintu gerbang pelataran yang ada sekeliling Kemah Suci dan mezbah, dengan talinya dan segala perkakas untuk pekerjaan jabatan mereka; dan mereka harus melakukan segala tugas yang perlu berkenaan dengan semuanya itu."
 },
 {
   "id": 3772,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 27,
   "firman": "Seluruh pekerjaan jabatan bani Gerson harus dilakukan sesuai dengan perintah Harun dan anak-anaknya, yakni segala tugas pengangkatan barang dan pekerjaan jabatan itu; kamu harus membuat mereka penanggung jawab atas segala yang harus diangkat mereka."
 },
 {
   "id": 3773,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 28,
   "firman": "Itulah tugas kaum-kaum bani Gerson di Kemah Pertemuan. Mereka harus mengerjakan di bawah pimpinan Itamar, anak imam Harun itu."
 },
 {
   "id": 3774,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 29,
   "firman": "Orang Merari haruslah kaucatat menurut kaum-kaum yang ada dalam puak mereka."
 },
 {
   "id": 3775,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 30,
   "firman": "Catatlah mereka yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, yakni setiap orang yang kena wajib tugas, supaya mereka melakukan pekerjaan jabatan pada Kemah Pertemuan."
 },
 {
   "id": 3776,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 31,
   "firman": "Inilah yang wajib diangkat mereka berhubung dengan seluruh pekerjaan jabatan mereka di Kemah Pertemuan: papan-papan Kemah Suci, kayu-kayu lintangnya, tiang-tiangnya, alas-alasnya,"
 },
 {
   "id": 3777,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 32,
   "firman": "tiang-tiang pelataran sekelilingnya, alas-alasnya, patok-patok dan tali-talinya, serta segala perkakasnya; semuanya termasuk tugas mereka. Dengan terperinci haruslah kamu tunjuk perkakas yang wajib diangkat mereka itu."
 },
 {
   "id": 3778,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 33,
   "firman": "Itulah tugas kaum-kaum bani Merari, yakni seluruh pekerjaan jabatan mereka di Kemah Pertemuan, yang harus dilakukan di bawah pimpinan Itamar, anak imam Harun.\""
 },
 {
   "id": 3779,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 34,
   "firman": "Demikianlah Musa dan Harun dengan para pemimpin umat Israel mencatat bani Kehat menurut kaum-kaum yang ada dalam puak mereka,"
 },
 {
   "id": 3780,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 35,
   "firman": "yakni orang-orang yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, setiap orang yang kena wajib tugas berhubung dengan pekerjaan jabatan di Kemah Pertemuan."
 },
 {
   "id": 3781,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 36,
   "firman": "Maka jumlah pencatatan mereka menurut kaum-kaum mereka ada dua ribu tujuh ratus lima puluh orang."
 },
 {
   "id": 3782,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 37,
   "firman": "Itulah orang-orang yang dicatat dari kaum-kaum Kehat, semua orang yang melakukan pekerjaan jabatan di Kemah Pertemuan, yakni mereka yang dicatat oleh Musa dan Harun, sesuai dengan titah TUHAN dengan perantaraan Musa."
 },
 {
   "id": 3783,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 38,
   "firman": "Bani Gerson yang dicatat menurut kaum-kaum yang ada dalam puak mereka,"
 },
 {
   "id": 3784,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 39,
   "firman": "yaitu orang-orang yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, setiap orang yang kena wajib tugas berhubung dengan pekerjaan jabatan di Kemah Pertemuan,"
 },
 {
   "id": 3785,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 40,
   "firman": "jadi mereka yang dicatat menurut kaum-kaum yang ada dalam puak mereka, berjumlah dua ribu enam ratus tiga puluh orang."
 },
 {
   "id": 3786,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 41,
   "firman": "Itulah jumlah pencatatan kaum-kaum bani Gerson, semua orang yang melakukan pekerjaan jabatan di Kemah Pertemuan, yakni mereka yang dicatat oleh Musa dan Harun sesuai dengan titah TUHAN."
 },
 {
   "id": 3787,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 42,
   "firman": "Bani Merari yang dicatat menurut kaum-kaum yang ada dalam puak mereka,"
 },
 {
   "id": 3788,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 43,
   "firman": "yaitu orang-orang yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, setiap orang yang kena wajib tugas berhubung dengan pekerjaan jabatan di Kemah Pertemuan,"
 },
 {
   "id": 3789,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 44,
   "firman": "jadi mereka yang dicatat menurut kaum-kaum mereka, berjumlah tiga ribu dua ratus orang."
 },
 {
   "id": 3790,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 45,
   "firman": "Itulah jumlah pencatatan kaum-kaum bani Merari, yakni mereka yang dicatat oleh Musa dan Harun, sesuai dengan titah TUHAN dengan perantaraan Musa."
 },
 {
   "id": 3791,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 46,
   "firman": "Semua orang Lewi yang dicatat oleh Musa dan Harun dengan para pemimpin Israel menurut kaum-kaum yang ada dalam puak-puak mereka,"
 },
 {
   "id": 3792,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 47,
   "firman": "yakni orang-orang yang berumur tiga puluh tahun ke atas sampai yang berumur lima puluh tahun, setiap orang yang wajib melakukan pekerjaan jabatan di Kemah Pertemuan dan pekerjaan pengangkatan barang,"
 },
 {
   "id": 3793,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 48,
   "firman": "jadi mereka yang dicatat, berjumlah delapan ribu lima ratus delapan puluh orang."
 },
 {
   "id": 3794,
   "kitab": "Bil",
   "pasal": 4,
   "ayat": 49,
   "firman": "Sesuai dengan titah TUHAN dengan perantaraan Musa, maka mereka masing-masing dibuat penanggung jawab atas apa yang harus dikerjakan dan diangkatnya. Demikianlah mereka dicatat, seperti yang diperintahkan TUHAN kepada Musa."
 },
 {
   "id": 3795,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3796,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 2,
   "firman": "\"Perintahkanlah kepada orang Israel, supaya semua orang yang sakit kusta, semua orang yang mengeluarkan lelehan, dan semua orang yang najis oleh mayat disuruh meninggalkan tempat perkemahan;"
 },
 {
   "id": 3797,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 3,
   "firman": "baik laki-laki maupun perempuan haruslah kausuruh pergi; ke luar tempat perkemahan haruslah mereka kausuruh pergi, supaya mereka jangan menajiskan tempat perkemahan di mana Aku diam di tengah-tengah mereka.\""
 },
 {
   "id": 3798,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 4,
   "firman": "Maka orang Israel berbuat demikian, mereka menyuruh orang-orang itu meninggalkan tempat perkemahan; seperti yang difirmankan TUHAN kepada Musa, demikianlah diperbuat orang Israel."
 },
 {
   "id": 3799,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 5,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3800,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 6,
   "firman": "\"Berbicaralah kepada orang Israel: Apabila seseorang, laki-laki atau perempuan, melakukan sesuatu dosa terhadap sesamanya manusia, dan oleh karena itu berubah setia terhadap TUHAN, sehingga orang itu menjadi bersalah,"
 },
 {
   "id": 3801,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 7,
   "firman": "maka haruslah ia mengakui dosa yang telah dilakukannya itu; kemudian membayar tebusan sepenuhnya dengan menambah seperlima, lalu menyerahkannya kepada orang terhadap siapa ia bersalah."
 },
 {
   "id": 3802,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 8,
   "firman": "Tetapi apabila orang itu tidak ada kaumnya, kepada siapa dapat dibayar tebusan salah itu, maka tebusan salah yang harus dibayar itu menjadi kepunyaan TUHAN, dan adalah bagian imam, belum terhitung domba jantan pendamaian yang dipakai untuk mengadakan pendamaian bagi orang itu."
 },
 {
   "id": 3803,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 9,
   "firman": "Dari persembahan-persembahan kudus yang disampaikan orang Israel kepada imam, persembahan khususnya adalah bagian imam."
 },
 {
   "id": 3804,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 10,
   "firman": "Sedang persembahan-persembahan kudus yang dibawa oleh seseorang adalah bagian orang itu sendiri; hanya apa yang diserahkannya kepada seorang imam adalah bagian imam itu.\""
 },
 {
   "id": 3805,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 11,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3806,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 12,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila isteri seseorang berbuat serong dan tidak setia terhadap suaminya,"
 },
 {
   "id": 3807,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 13,
   "firman": "dan laki-laki lain tidur dan bersetubuh dengan perempuan itu, dengan tidak diketahui suaminya, karena tinggal rahasia bahwa perempuan itu mencemarkan dirinya, tidak ada saksi terhadap dia, dia tidak kedapatan,"
 },
 {
   "id": 3808,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 14,
   "firman": "dan apabila kemudian roh cemburu menguasai suami itu, sehingga ia menjadi cemburu terhadap isterinya, dan perempuan itu memang telah mencemarkan dirinya, atau apabila roh cemburu menguasai suami itu, sehingga ia menjadi cemburu terhadap isterinya, walaupun perempuan itu tidak mencemarkan dirinya,"
 },
 {
   "id": 3809,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 15,
   "firman": "maka haruslah orang itu membawa isterinya kepada imam. Dan orang itu harus membawa persembahan karena perempuan itu sebanyak sepersepuluh efa tepung jelai, yang ke atasnya tidak dituangkannya minyak dan yang tidak dibubuhinya kemenyan, karena korban itu ialah korban sajian cemburuan, suatu korban peringatan yang mengingatkan kepada kedurjanaan."
 },
 {
   "id": 3810,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 16,
   "firman": "Maka haruslah imam menyuruh perempuan itu mendekat dan menghadapkannya kepada TUHAN."
 },
 {
   "id": 3811,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 17,
   "firman": "Lalu imam harus membawa air kudus dalam suatu tempayan tanah, kemudian harus memungut debu yang ada di lantai Kemah Suci dan membubuhnya ke dalam air itu."
 },
 {
   "id": 3812,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 18,
   "firman": "Apabila imam sudah menghadapkan perempuan itu kepada TUHAN, haruslah ia menguraikan rambut perempuan itu, lalu meletakkan korban peringatan, yakni korban sajian cemburuan, ke atas telapak tangan perempuan itu, sedang di tangan imam haruslah ada air pahit yang mendatangkan kutuk."
 },
 {
   "id": 3813,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 19,
   "firman": "Maka haruslah imam menyumpah perempuan itu dengan berkata kepadanya: Jika tidak benar ada laki-laki yang tidur dengan engkau, dan jika tidak engkau berbuat serong kepada kecemaran, padahal engkau di bawah kuasa suamimu, maka luputlah engkau dari air pahit yang mendatangkan kutuk ini;"
 },
 {
   "id": 3814,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 20,
   "firman": "tetapi jika engkau, padahal engkau di bawah kuasa suamimu, berbuat serong dan mencemarkan dirimu, oleh karena orang lain dari suamimu sendiri bersetubuh dengan engkau--"
 },
 {
   "id": 3815,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 21,
   "firman": "dalam hal ini haruslah imam menyumpah perempuan itu dengan sumpah kutuk, dan haruslah imam berkata kepada perempuan itu--maka TUHAN kiranya membuat engkau menjadi sumpah kutuk di tengah-tengah bangsamu dengan mengempiskan pahamu dan mengembungkan perutmu,"
 },
 {
   "id": 3816,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 22,
   "firman": "sebab air yang mendatangkan kutuk ini akan masuk ke dalam tubuhmu untuk mengembungkan perutmu dan mengempiskan pahamu. Dan haruslah perempuan itu berkata: Amin, amin."
 },
 {
   "id": 3817,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 23,
   "firman": "Lalu imam harus menuliskan kutuk itu pada sehelai kertas dan menghapusnya dengan air pahit itu,"
 },
 {
   "id": 3818,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 24,
   "firman": "dan ia harus memberi perempuan itu minum air pahit yang mendatangkan kutuk itu, dan air itu akan masuk ke dalam badannya dan menyebabkan sakit yang pedih."
 },
 {
   "id": 3819,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 25,
   "firman": "Maka haruslah imam mengambil korban sajian cemburuan dari tangan perempuan itu lalu mengunjukkannya ke hadapan TUHAN, dan membawanya ke mezbah."
 },
 {
   "id": 3820,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 26,
   "firman": "Sesudah itu haruslah imam mengambil segenggam dari korban sajian itu sebagai bagian ingat-ingatannya dan membakarnya di atas mezbah, kemudian memberi perempuan itu minum air itu."
 },
 {
   "id": 3821,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 27,
   "firman": "Setelah terjadi demikian, apabila perempuan itu memang mencemarkan dirinya dan berubah setia terhadap suaminya, air yang mendatangkan sumpah serapah itu akan masuk ke badannya dan menyebabkan sakit yang pedih, sehingga perutnya mengembung dan pahanya mengempis, dan perempuan itu akan menjadi sumpah kutuk di antara bangsanya."
 },
 {
   "id": 3822,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 28,
   "firman": "Tetapi apabila perempuan itu tidak mencemarkan dirinya, melainkan ia suci, maka ia akan bebas dan akan dapat beranak.\""
 },
 {
   "id": 3823,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 29,
   "firman": "Itulah hukum tentang perkara cemburuan, kalau seorang perempuan telah berbuat serong dan mencemarkan dirinya, padahal ia di bawah kuasa suaminya,"
 },
 {
   "id": 3824,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 30,
   "firman": "atau kalau roh cemburu menguasai seorang laki-laki, sehingga ia cemburu terhadap isterinya; ia harus menghadapkan perempuan itu kepada TUHAN dan imam haruslah melaksanakan seluruh hukum ini kepada perempuan itu."
 },
 {
   "id": 3825,
   "kitab": "Bil",
   "pasal": 5,
   "ayat": 31,
   "firman": "Laki-laki itu akan bebas dari pada salah, tetapi perempuan itu haruslah menanggung akibat kesalahannya."
 },
 {
   "id": 3826,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 1,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3827,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 2,
   "firman": "\"Berbicaralah kepada orang Israel dan katakanlah kepada mereka: Apabila seseorang, laki-laki atau perempuan, mengucapkan nazar khusus, yakni nazar orang nazir, untuk mengkhususkan dirinya bagi TUHAN,"
 },
 {
   "id": 3828,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 3,
   "firman": "maka haruslah ia menjauhkan dirinya dari anggur dan minuman yang memabukkan, jangan meminum cuka anggur atau cuka minuman yang memabukkan dan jangan meminum sesuatu minuman yang dibuat dari buah anggur, dan jangan memakan buah anggur, baik yang segar maupun yang kering."
 },
 {
   "id": 3829,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 4,
   "firman": "Selama waktu kenazirannya janganlah ia makan sesuatu apapun yang berasal dari pohon anggur, dari bijinya sampai kepada pucuk rantingnya."
 },
 {
   "id": 3830,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 5,
   "firman": "Selama waktu nazarnya sebagai orang nazir janganlah pisau cukur lalu di kepalanya; sampai genap waktunya ia mengkhususkan dirinya bagi TUHAN, haruslah ia tetap kudus dan membiarkan rambutnya tumbuh panjang."
 },
 {
   "id": 3831,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 6,
   "firman": "Selama waktunya ia mengkhususkan dirinya bagi TUHAN, janganlah ia dekat kepada mayat orang;"
 },
 {
   "id": 3832,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 7,
   "firman": "bahkan apabila mati ayahnya ataupun ibunya, saudaranya laki-laki ataupun saudaranya perempuan, janganlah ia menajiskan dirinya kepada mereka, sebab tanda kenaziran bagi Allahnya ada di atas kepalanya."
 },
 {
   "id": 3833,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 8,
   "firman": "Selama waktu kenazirannya ia kudus bagi TUHAN."
 },
 {
   "id": 3834,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 9,
   "firman": "Tetapi apabila seseorang mati di dekatnya dengan sangat tiba-tiba, sehingga ia menajiskan rambut kenazirannya, maka haruslah ia mencukur rambutnya pada hari pentahirannya, yaitu pada hari yang ketujuh haruslah ia mencukurnya."
 },
 {
   "id": 3835,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 10,
   "firman": "Pada hari yang kedelapan haruslah ia membawa dua ekor burung tekukur atau dua ekor anak burung merpati kepada imam, ke pintu Kemah Pertemuan."
 },
 {
   "id": 3836,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 11,
   "firman": "Maka haruslah imam mengolah yang seekor menjadi korban penghapus dosa dan yang lain menjadi korban bakaran, dan mengadakan pendamaian bagi dia, oleh karena dia telah berdosa dengan berada dekat mayat. Pada hari itu juga ia harus menguduskan kepalanya"
 },
 {
   "id": 3837,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 12,
   "firman": "dan mengkhususkan waktu kenazirannya bagi TUHAN. Ia harus membawa seekor domba jantan berumur setahun menjadi korban penebus salah. Hari-hari yang sudah lewat dianggap batal, karena rambut kenazirannya telah menjadi najis."
 },
 {
   "id": 3838,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 13,
   "firman": "Dan inilah hukum tentang seorang nazir. Apabila waktu kenazirannya genap, ia harus dibawa ke pintu Kemah Pertemuan,"
 },
 {
   "id": 3839,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 14,
   "firman": "dan ia harus mempersembahkan sebagai persembahannya kepada TUHAN seekor domba jantan berumur setahun yang tidak bercela untuk korban bakaran dan seekor domba betina berumur setahun yang tidak bercela untuk korban penghapus dosa dan seekor domba jantan yang tidak bercela untuk korban keselamatan,"
 },
 {
   "id": 3840,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 15,
   "firman": "juga sebakul roti yang tidak beragi, yakni roti bundar dari tepung yang terbaik, yang diolah dengan minyak, dan roti tipis yang tidak beragi diolesi dengan minyak, serta dengan korban sajian dan korban-korban curahannya."
 },
 {
   "id": 3841,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 16,
   "firman": "Lalu haruslah imam membawa semuanya itu ke hadapan TUHAN dan mengolah korban penghapus dosa dan korban bakarannya;"
 },
 {
   "id": 3842,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 17,
   "firman": "domba jantan itu haruslah diolahnya sebagai korban keselamatan bagi TUHAN, beserta sebakul roti yang tidak beragi itu; juga haruslah imam mengolah korban sajian dan korban curahannya."
 },
 {
   "id": 3843,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 18,
   "firman": "Maka haruslah orang nazir itu mencukur rambut kenazirannya di depan pintu Kemah Pertemuan, lalu mengambil rambut kenazirannya itu dan melemparkannya ke dalam api yang di bawah korban keselamatan."
 },
 {
   "id": 3844,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 19,
   "firman": "Imam haruslah mengambil paha depan domba jantan itu, sesudah dimasak, dan satu roti bundar yang tidak beragi dari dalam bakul, dengan satu roti tipis yang tidak beragi, lalu meletakkannya ke atas telapak tangan orang nazir itu, setelah orang ini mencukur rambut kenazirannya;"
 },
 {
   "id": 3845,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 20,
   "firman": "kemudian haruslah imam mengunjukkan semuanya itu ke hadapan TUHAN sebagai persembahan unjukan; semuanya itu menjadi bagian kudus bagi imam, beserta dada persembahan unjukan dan beserta paha persembahan khusus. Sesudah itu barulah boleh orang nazir itu minum anggur.\""
 },
 {
   "id": 3846,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 21,
   "firman": "Itulah hukum tentang orang nazir yang menazarkan persembahannya kepada TUHAN berdasarkan kenazirannya, belum dihitung apa yang ia mampu mempersembahkan di samping itu. Sesuai dengan bunyi nazar yang diikrarkannya, demikianlah harus dilakukannya berdasarkan hukum tentang kenazirannya."
 },
 {
   "id": 3847,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 22,
   "firman": "TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3848,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 23,
   "firman": "\"Berbicaralah kepada Harun dan anak-anaknya: Beginilah harus kamu memberkati orang Israel, katakanlah kepada mereka:"
 },
 {
   "id": 3849,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 24,
   "firman": "TUHAN memberkati engkau dan melindungi engkau;"
 },
 {
   "id": 3850,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 25,
   "firman": "TUHAN menyinari engkau dengan wajah-Nya dan memberi engkau kasih karunia;"
 },
 {
   "id": 3851,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 26,
   "firman": "TUHAN menghadapkan wajah-Nya kepadamu dan memberi engkau damai sejahtera."
 },
 {
   "id": 3852,
   "kitab": "Bil",
   "pasal": 6,
   "ayat": 27,
   "firman": "Demikianlah harus mereka meletakkan nama-Ku atas orang Israel, maka Aku akan memberkati mereka.\""
 },
 {
   "id": 3853,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 1,
   "firman": "Pada waktu Musa selesai mendirikan Kemah Suci, diurapinya dan dikuduskannyalah itu dengan segala perabotannya, juga mezbah dengan segala perkakasnya; dan setelah diurapi dan dikuduskannya semuanya itu,"
 },
 {
   "id": 3854,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 2,
   "firman": "maka para pemimpin Israel, para kepala suku mereka, mempersembahkan persembahan. Mereka itu ialah para pemimpin suku yang bertanggung jawab atas pencatatan itu."
 },
 {
   "id": 3855,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 3,
   "firman": "Sebagai persembahan dibawa mereka ke hadapan TUHAN: enam kereta beratap dengan dua belas ekor lembu; satu kereta untuk dua orang pemimpin dan satu ekor lembu untuk satu orang pemimpin, lalu mereka membawa semuanya itu ke depan Kemah Suci."
 },
 {
   "id": 3856,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 4,
   "firman": "Kemudian TUHAN berfirman kepada Musa:"
 },
 {
   "id": 3857,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 5,
   "firman": "\"Terimalah semuanya itu dari mereka, supaya dipergunakan untuk pekerjaan pada Kemah Pertemuan; berikanlah semuanya itu kepada orang Lewi, sesuai dengan keperluan pekerjaan masing-masing.\""
 },
 {
   "id": 3858,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 6,
   "firman": "Lalu Musa menerima kereta-kereta dan lembu-lembu itu dan memberikannya kepada orang Lewi;"
 },
 {
   "id": 3859,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 7,
   "firman": "dua kereta dengan empat ekor lembu diberikannya kepada bani Gerson, sesuai dengan keperluan pekerjaan mereka,"
 },
 {
   "id": 3860,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 8,
   "firman": "dan empat kereta dengan delapan ekor lembu diberikannya kepada bani Merari, sesuai dengan keperluan pekerjaan mereka di bawah pimpinan Itamar, anak imam Harun itu."
 },
 {
   "id": 3861,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 9,
   "firman": "Tetapi kepada bani Kehat tidak diberikannya apa-apa, karena pekerjaan mereka ialah mengurus barang-barang kudus, yang harus diangkat di atas bahunya."
 },
 {
   "id": 3862,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 10,
   "firman": "Lagi para pemimpin mempersembahkan persembahan pentahbisan mezbah, pada hari mezbah itu diurapi; para pemimpin membawa persembahan mereka ke depan mezbah itu."
 },
 {
   "id": 3863,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 11,
   "firman": "TUHAN berfirman kepada Musa: \"Satu pemimpin setiap hari haruslah mempersembahkan persembahannya untuk mentahbiskan mezbah itu.\""
 },
 {
   "id": 3864,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 12,
   "firman": "Yang mempersembahkan persembahannya pada hari pertama ialah Nahason bin Aminadab, dari suku Yehuda."
 },
 {
   "id": 3865,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 13,
   "firman": "Persembahannya ialah satu pinggan perak, seratus tiga puluh syikal timbangannya, dan satu bokor penyiraman dari perak tujuh puluh syikal beratnya, ditimbang menurut syikal kudus, keduanya berisi tepung yang terbaik, diolah dengan minyak, untuk korban sajian;"
 },
 {
   "id": 3866,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 14,
   "firman": "satu cawan sepuluh syikal emas beratnya, berisi ukupan;"
 },
 {
   "id": 3867,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 15,
   "firman": "seekor lembu jantan muda, seekor domba jantan dan seekor domba berumur setahun, untuk korban bakaran;"
 },
 {
   "id": 3868,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 16,
   "firman": "seekor kambing jantan, untuk korban penghapus dosa;"
 },
 {
   "id": 3869,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 17,
   "firman": "dan untuk korban keselamatan dua ekor lembu, lima ekor domba jantan, lima ekor kambing jantan dan lima ekor domba berumur setahun. Itulah persembahan Nahason bin Aminadab."
 },
 {
   "id": 3870,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 18,
   "firman": "Pada hari kedua Netaneel bin Zuar, pemimpin suku Isakhar, mempersembahkan persembahan."
 },
 {
   "id": 3871,
   "kitab": "Bil",
   "pasal": 7,
   "ayat": 19,
   "firman": "Sebagai persembahannya dipersembahkannya satu pinggan perak, seratus tiga puluh syikal timbangannya, dan satu bokor penyiraman dari perak, tujuh puluh syikal beratnya, ditimbang menurut syikal kudus, keduanya berisi tepung yang terbaik, diolah dengan minyak, untuk korban sajian;"
 },
